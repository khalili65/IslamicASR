   "title": "## خواب؛ نمونهٔ کوچکِ برزخ",
   "start": 392.99,
   "end": 791.31
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.6,
   "end": 4.72,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.72,
   "end": 8.34,
   "text": "المستغاث بکه یا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.34,
   "end": 11.88,
   "text": "پرسیده شده که برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.88,
   "end": 15.26,
   "text": "جلوگیری یا پیشگیری از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.26,
   "end": 21.56,
   "text": "سختی هنگام جان کندن و حالت احتضار و همچنین فشار قبر و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.56,
   "end": 24.98,
   "text": "چه توصیه‌هایی شده در اسلام؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.98,
   "end": 28.56,
   "text": "بله بالاخره لحظات بسیار سختی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.56,
   "end": 31.42,
   "text": "از لحظه احتضار شروع میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.42,
   "end": 34.84,
   "text": "که در آیینه آیات و روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.84,
   "end": 42.26,
   "text": "از اون لحظه سخت به ناتوانی اطرافیان یاد شده که هیچکس نمی‌تونه کاری برای انسان بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.26,
   "end": 48.22,
   "text": "پیچش ساق‌های محتضر به هم که نشونه سختی جان کندنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.22,
   "end": 50.68,
   "text": "جانکاهی مرگ درد زیادی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.68,
   "end": 53.44,
   "text": "گردش چشم که انسان حیرت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.44,
   "end": 59.24,
   "text": "سکره و بیهوشی. تیره و تاریه-- تاریکی چشم هنگام بیرون آمدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.24,
   "end": 63.0,
   "text": "جون از بدنه که به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.0,
   "end": 68.28,
   "text": "لحظه خطرناک و سختی‌ست که چشم تار میشه، تیره میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.28,
   "end": 73.96,
   "text": "احاطه مرگ بر وجود انسانه که هیچ راه گریزی از اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.96,
   "end": 78.78,
   "text": "خاری اینها چیزهایی است که به اون لحظه تعبیر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.78,
   "end": 84.08,
   "text": "اظهار توبه، همه اون لحظه میخوان توبه کنن، پشیمون بشن اینا اما اثری نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.08,
   "end": 88.58,
   "text": "بی‌تابیه، غصه و اندوحه، تازیانه فرشتگان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.58,
   "end": 91.94,
   "text": "فزعه که یک ترس بزرگه، گلوگیری عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.94,
   "end": 95.84,
   "text": "به هر حال اینا هست بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.84,
   "end": 98.94,
   "text": "که لحظه‌ای است که همه ما قراره اون لحظه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.94,
   "end": 101.86,
   "text": "درک کنیم. اما برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.86,
   "end": 105.04,
   "text": "جلوگیری از سختی جان کندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.04,
   "end": 110.5,
   "text": "یکی از بهترین کارها که سفارش شده و مرحوم شیخ عباس قمی علیه الرحمه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.5,
   "end": 113.0,
   "text": "کتاب شریف مفاتیح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.0,
   "end": 115.68,
   "text": "الجنانشون آوردن دعای ادیله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.68,
   "end": 119.74,
   "text": "قبل از اینکه خود انسان از دنیا بره، این دعا رو حداقل یک بار بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.74,
   "end": 123.88,
   "text": "بهش میگن ادیله‌تون عند الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.88,
   "end": 131.74,
   "text": "و این دعا رو بخوانه و بسپاره به خدا و امام عصر و فرشته‌ها که اون لحظه بهش برگردونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.74,
   "end": 135.44,
   "text": "که به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.44,
   "end": 141.68,
   "text": "مخصوصاً اگر این دعا رو هدیه کنه به مولامون علی علیه الصلاة والسلام یا امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.68,
   "end": 145.78,
   "text": "که اونها میان لب احتضار فرمود میموت یرنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.78,
   "end": 150.78,
   "text": "چه کافر چه مؤمن مولامون علی یا امام عصر رو در زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.78,
   "end": 153.64,
   "text": "از دنیا رفتن می‌بینیم همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.64,
   "end": 158.3,
   "text": "و خب این وقتی این دعا هدیه داده بشه به حضرت، اونجا به انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.3,
   "end": 162.44,
   "text": "بهترین امانتدار هم اون‌هان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.44,
   "end": 171.16,
   "text": "خدا فرموده که [سوره نسا آیه 58] به اهلش بسپر برمی‌گردونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.16,
   "end": 175.6,
   "text": "و اگر تو حرم اهل بیت مثل حرم مولا علی اینها خونده بشه که چه بهتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.6,
   "end": 177.86,
   "text": "اونجا بسپری به مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.86,
   "end": 181.1,
   "text": "حضرت رو شهادت بگیری که اون لحظه به تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.1,
   "end": 186.3,
   "text": "برگردونه. یکی دیگه از کارهایی که در آیین روایات وارد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.3,
   "end": 189.72,
   "text": "صله رحمه که امام صادق صلوات الله علیه فرمود:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.72,
   "end": 192.18,
   "text": "اونایی که میخوان عذاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.18,
   "end": 195.6,
   "text": "جون دادن براشون آسون بشه صله رحم بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.6,
   "end": 199.3,
   "text": "خیلی درش برکات هست و عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.3,
   "end": 201.78,
   "text": "دیگر فرمودن نیکی به پدر مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.78,
   "end": 204.72,
   "text": "بسیار سفارش شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.72,
   "end": 210.14,
   "text": "خنک کردن دل پدر مادر با خیر و به خیر رسوندن و نیکی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.14,
   "end": 212.26,
   "text": "قرائت سوره‌هایی‌ست مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.26,
   "end": 216.2,
   "text": "یاسین، صافات که حضرت زهرا سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.2,
   "end": 223.5,
   "text": "لحظه شهادتشون به مولامون علی علیه الصلاة والسلام سفارش کردن یاسین و صافات برای من بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.5,
   "end": 227.66,
   "text": "سوره زلزال .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.66,
   "end": 230.56,
   "text": "اینا مداومت بر این سوره‌ها کار رو آسون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.56,
   "end": 235.84,
   "text": "روزه آخر ماه رجب حالا چه سری درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.84,
   "end": 239.42,
   "text": "آخ روزهای ماه رجب به خصوص اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.42,
   "end": 244.46,
   "text": "روزه روز آخر یا روزهای خاص ماه رجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.46,
   "end": 249.68,
   "text": "یا روزه آخر هر ماه اساساً در روایت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.68,
   "end": 252.56,
   "text": "نماز شب خیلی مؤثره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.56,
   "end": 255.52,
   "text": "و همچنین این ذکر شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.52,
   "end": 263.44,
   "text": "یا أسمع السامعين یا أبصر الناظرین یا أسرع الحاسبین یا أحکم الحاکمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.44,
   "end": 266.34,
   "text": "این چهار تا ذکر مداومت برش خیلی تأثیر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.34,
   "end": 269.28,
   "text": "البته عزیزانی که بخوان مشروح بدونن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.28,
   "end": 272.58,
   "text": "کتاب منازل الآخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.58,
   "end": 274.82,
   "text": "شیخ عباس قمی رو ملاحظه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.82,
   "end": 277.54,
   "text": "روایات این چنینی درش زیاد اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.54,
   "end": 283.3,
   "text": "اما در خصوص عرض شود فشار قبر و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.3,
   "end": 287.64,
   "text": "این هم بله خب، یه سری عوامل هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.64,
   "end": 292.76,
   "text": "همونطور که در کتاب‌های شریفی مثل ثواب الأعمال شیخ صدوق اومده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.76,
   "end": 295.36,
   "text": "ملایحضر خود شیخ صدوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.36,
   "end": 300.72,
   "text": "یا اصول کافی شیخ کلینی اعلا الله مقامه الشریف، بهار مرحوم مجلسی اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.72,
   "end": 303.84,
   "text": "روایات زیادی پیرامون این اومده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.84,
   "end": 306.42,
   "text": "اساساً چه چیزهایی باعث فشار قبر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.42,
   "end": 310.18,
   "text": "خب ترک اونا باعث میشه که فشار قبر برداشته بشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.18,
   "end": 317.08,
   "text": "یکیش فرمودن که عرض شود رسول خدا فرمودند صلی الله علیه و آله وسلم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 317.08,
   "end": 319.78,
   "text": "عذاب قبر به سزای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 319.78,
   "end": 321.98,
   "text": "سه چیزه. یکی سخن چینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.98,
   "end": 326.94,
   "text": "نمامی، یکی غیبت و دیگری دروغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.94,
   "end": 329.8,
   "text": "این‌ها البته مهماتشون اینهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.8,
   "end": 332.4,
   "text": "نه اینکه فقط این‌ها باشن. چون روایات دیگه‌ای داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.4,
   "end": 337.02,
   "text": "مثلاً امام باقر همچنین امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.02,
   "end": 340.8,
   "text": "علیهم الصلاة-- علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.8,
   "end": 343.66,
   "text": "به خصوص مثلاً بی‌مبالاتی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.66,
   "end": 346.52,
   "text": "نجاست مثل بل اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 346.52,
   "end": 351.22,
   "text": "فرمودن اگه کسی رعایت نکنه، نجسه پاکی رعایت نکنه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.22,
   "end": 357.64,
   "text": "این نجاست رو تو وجودش نگه داره، دیر بره برای تخلی حالا چه ارتباطی هست الله اعلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.64,
   "end": 360.6,
   "text": "باعث فشار قبر میشه یا بداخلاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.6,
   "end": 363.44,
   "text": "روایات زیادی داریم که بداخلاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.44,
   "end": 365.98,
   "text": "باعث فشار قبر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 365.98,
   "end": 371.73,
   "text": "مخصوصاً بداخلاقی کردن در منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.73,
   "end": 379.61,
   "text": "یا مثلا از امام صادق صلوات الله علیه روایتی داریم که ایشون از پدرانشون نقل کردند تا رسول خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.61,
   "end": 382.35,
   "text": "که پیامبر فرموده که فشار قبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.35,
   "end": 388.89,
   "text": "برای مؤمن هم هست منتها برای مؤمن کفاره نعمت‌هاییه که تباه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.89,
   "end": 392.99,
   "text": "از تباه کردن نعمت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 392.99,
   "end": 397.71,
   "text": "خودش فشار قبر میاره. اگرچه کفاره گناهان مؤمنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.71,
   "end": 401.87,
   "text": "که باعث میشه انسان پاک وارد محشر بشه، پاک وارد قیامت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.87,
   "end": 407.01,
   "text": "اما به هر حال تباهی نعمت‌ها خودش فشار قبر رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 407.01,
   "end": 409.47,
   "text": "اما اون کارهایی که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.47,
   "end": 413.65,
   "text": "در کنار این توصیه‌ها، اون کارهایی هم که باعث میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.65,
   "end": 416.07,
   "text": "فشار قبر برداشته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.07,
   "end": 419.65,
   "text": "یکی امام باقر صلوات الله علیه فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.65,
   "end": 425.49,
   "text": "کسی که بر تلاوت سوره ذوخرف مداومت نماید، خداوند در قیامت او را از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.49,
   "end": 428.37,
   "text": "حشرات و حیوانات سمی زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.37,
   "end": 431.19,
   "text": "و فشار قبر ایمن می‌نماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.19,
   "end": 434.65,
   "text": "تا زمانی که در پیشگاه خداوند حاضر شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.65,
   "end": 439.19,
   "text": "خب این هم مداومت بر سوره ذوخرف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.19,
   "end": 441.61,
   "text": "البته باید دید که در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.61,
   "end": 445.03,
   "text": "سوره‌ها چه چیزی هست، چه حقایقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.03,
   "end": 450.73,
   "text": "بیان شده که مداومت بر اون این حقایق رو در انسان پیاده می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.73,
   "end": 453.23,
   "text": "باعث میشه که ما به این سمت بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 453.23,
   "end": 458.23,
   "text": "نه اینکه صرف یک قرائت ظاهری باشه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 458.23,
   "end": 462.07,
   "text": "چون قرآن هم می‌فرماید \"انما انما\" هم حصر یعنی فقط و فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 462.07,
   "end": 466.55,
   "text": "\"انما یتقبل الله من المتقین\" خدا فقط از اهل تقوا می‌پذیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.55,
   "end": 469.67,
   "text": "این قرائت‌ها باید بر اساس تقوا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.67,
   "end": 472.19,
   "text": "تقوا هم یعنی رعایت حدود الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.19,
   "end": 478.17,
   "text": "حالا اگر کسی تقوا داشت، حالا یه لغزش‌هایی هم داشت به برکت داشتن تقوای ضمنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 478.17,
   "end": 481.27,
   "text": "اون لغزش‌ها برطرف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.27,
   "end": 485.75,
   "text": "و همچنین امام صادق صلوات الله علیه فرمودند که کسی که بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.75,
   "end": 489.49,
   "text": "ظهر پنجشنبه تا ظهر جمعه از دنیا بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 489.49,
   "end": 493.81,
   "text": "این هم یک عنایتی است که خدا فشار قبر رو از او برمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.81,
   "end": 501.05,
   "text": "مثل خدا رحمت کنه شهید بزرگوار حاج قاسم سلیمانی سردار دل‌ها که دقیقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 501.05,
   "end": 503.27,
   "text": "سحر شب جمعه از دنیا رفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 503.27,
   "end": 509.41,
   "text": "تو همین فرصت. که از آرزو بزرگان بوده تو این وقت از دنیا رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.41,
   "end": 515.31,
   "text": "یا مثلا مولامون علی علیه الصلاة والسلام باز در خصوص آیات قرآن یا سوره فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.31,
   "end": 519.55,
   "text": "کسی که در هر جمعه سوره نساء رو بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 519.55,
   "end": 524.71,
   "text": "از فشار قبر ایمنه. باز باید دید که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.71,
   "end": 527.79,
   "text": "محتوای سوره نساء چه چیزی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 527.79,
   "end": 531.43,
   "text": "یا پیامبر فرمودند که سه طایفه از زن‌ها هستند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 531.43,
   "end": 533.83,
   "text": "عذاب قبر از آن‌ها برداشته میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 533.83,
   "end": 538.19,
   "text": "و با جالب اینکه فرمودند با حضرت فاطمه سلام الله علیها دخترم محشور میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 538.19,
   "end": 541.47,
   "text": "عجب! این سه طایفه رو فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.47,
   "end": 544.63,
   "text": "اول زنی که به غیرت شوهرش صبر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 544.63,
   "end": 549.03,
   "text": "شوهرش خیلی غیرتمنده، خیلی اصلاً اجازه نمیده زن با کسی ارتباط داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.03,
   "end": 552.75,
   "text": "اینو میگه صبر کن در این حالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.75,
   "end": 556.15,
   "text": "دوم با شوهر بداخلاق بسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.15,
   "end": 560.09,
   "text": "اوه، اوه چقدر سخته ساختن با یک شوهر بداخلاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.09,
   "end": 563.95,
   "text": "بله باید هم جزش هم نشین با حضرت زهرا و برداشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.95,
   "end": 568.17,
   "text": "عذاب قبر باشه. سومیش هم زنیه که مهریه شو ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 568.17,
   "end": 572.23,
   "text": "خب خیلی بزرگواریه توی این دنیای وانفسا که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.23,
   "end": 576.13,
   "text": "به هر حال حب دنیا رأس کل خطیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 576.13,
   "end": 581.19,
   "text": "خب زنی که مهریه شو ببخشه کار کارستونی کرده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 581.19,
   "end": 590.85,
   "text": "نکته‌ی پایانی که بگم به نظرم توجه به این موضوع خیلی مهم‌تر از این مطالبی است که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 590.85,
   "end": 593.91,
   "text": "که معمولاً این‌ها جنبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 593.91,
   "end": 599.83,
   "text": "درمانی دارند اما جنبه پیشگیرانه و پیشگیری بهتر است از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 599.83,
   "end": 606.03,
   "text": "جنبه درمانی. اونم عالم توجه به عالم مشیت انسانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 606.03,
   "end": 612.63,
   "text": "که قبلاً تو بحث حکمت و فلسفه عرض شد محضر دوستان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 612.63,
   "end": 616.85,
   "text": "بر اساس البته آیات و روایات، حکما فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 616.85,
   "end": 622.65,
   "text": "هرچی که ما در این دنیا انجام بدیم مشیت الهی براش تحقق گرفته و ما بدون اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 622.65,
   "end": 626.21,
   "text": "بخواهیم بر اساس مشیت حضرت حق به دنیا آمدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 626.21,
   "end": 631.31,
   "text": "عالم تکوین سیر نطفه رو ادامه داده، ما رو به جنین کشونده و وارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 631.31,
   "end": 633.61,
   "text": "عالم طبیعت خودمونم نخواستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 633.61,
   "end": 635.65,
   "text": "عالم مشیت الهی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 635.65,
   "end": 639.07,
   "text": "البته بعد از اینکه مختار شدیم خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 639.07,
   "end": 641.73,
   "text": "در دیگه عوالم بعدی رو می‌سازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 641.73,
   "end": 645.61,
   "text": "در همین نشئه. لذا اینجا مزرعه است برای اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 645.61,
   "end": 651.25,
   "text": "سرا. بعد وقتی که انسان دیگه به حالت احتضار و پس از مرگ قرار می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 651.25,
   "end": 654.17,
   "text": "دیگه اونجا رو از تعلم حسن زاده فرمودند بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 654.17,
   "end": 657.77,
   "text": "عنوان عالم مشیت انسانی نام بردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 657.77,
   "end": 660.15,
   "text": "یعنی اونجا دیگه خواست، خواست انسان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 660.15,
   "end": 666.79,
   "text": "\"لهم ما یشاؤون فیها\" هرچی انشای نفست باشه، هرچی نفست انشا کنه و بخواد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 666.79,
   "end": 671.33,
   "text": "هرچی در حقیقت اشتها کنه نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 671.33,
   "end": 680.53,
   "text": "تو آیات قرآن هم اومده. خب این اشتهاء نفس به عبارتی میل نفس، به عبارتی انشائات نفس ناطقه در اون عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 680.53,
   "end": 682.53,
   "text": "بر اساس چی صورت می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 682.53,
   "end": 687.07,
   "text": "خب قطعاً فرمودند بر اساس ملکات نفسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 687.07,
   "end": 691.17,
   "text": "لذا فرمودند ملکات نفسانی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 691.17,
   "end": 694.13,
   "text": "مواد ثوب برزخی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 694.13,
   "end": 697.19,
   "text": "یعنی هرچی که تو این دنیا ملکه وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 697.19,
   "end": 700.27,
   "text": "تو شده یا به عبارتی مقام تو شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 700.27,
   "end": 704.15,
   "text": "جایگاه تو شده، صعه تو شده، همون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 704.15,
   "end": 710.35,
   "text": "اون سمت میشه چی؟ خواستگاه وجودی تو و انشائات نفس ناطقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 710.35,
   "end": 714.33,
   "text": "یعنی آنچه که از مار و عقرب و آتش و عذاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 714.33,
   "end": 718.89,
   "text": "اینا هرچی که هست در درون خودته و خواست نفس خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 718.89,
   "end": 723.55,
   "text": "مثل اینکه می‌خوابی. شما مثلاً خواب آتش و عذاب و سختی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 723.55,
   "end": 726.43,
   "text": "اینها می‌بینی. فشار و. خب این کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 726.43,
   "end": 729.21,
   "text": "وقتی بیدار میشی می‌بینی همین جایی تو همین بدنتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 729.21,
   "end": 732.13,
   "text": "خب پس در درون خودت اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 732.13,
   "end": 734.89,
   "text": "یا بالعکسش روح و ریحان می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 734.89,
   "end": 737.41,
   "text": "و نور و معنویت می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 737.41,
   "end": 741.37,
   "text": "رخا و در حقیقت رهایی می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 741.37,
   "end": 744.63,
   "text": "صراط مطلقه می‌بینی. بی‌قیدی می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 744.63,
   "end": 747.07,
   "text": "آزادی می‌بینی. این‌ها همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 747.07,
   "end": 749.41,
   "text": "خواستگاه نفست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 749.41,
   "end": 754.29,
   "text": "ملکات وجودیتند. پس برای بهترین راه برای پیشگیری از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 754.29,
   "end": 758.95,
   "text": "سختی جان کردن و عذاب قبر و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 758.95,
   "end": 764.75,
   "text": "من حيث المجموع عزیزان این هستش که انسان ملکات وجودیش رو رسیدگی کنه و مراقبت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 764.75,
   "end": 767.25,
   "text": "مراقبت، مراقبت، مراقبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 767.25,
   "end": 769.21,
   "text": "ملکات همون چیزیست که اصرار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 769.21,
   "end": 772.19,
   "text": "یعنی هر عملی وقتی اصرار شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 772.19,
   "end": 776.81,
   "text": "اصرار پشت اصرار، انجام پشت سر همه یک عمل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 776.81,
   "end": 782.69,
   "text": "اون دیگه ملکه وجودی انسان میشه و قوه خیال دائماً صورت‌گری می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 782.69,
   "end": 786.85,
   "text": "و به دنبال اون سوق میده انسان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 786.85,
   "end": 789.47,
   "text": "خدا عاقبت هممون رو انشاالله ختم بخیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 789.47,
   "end": 791.31,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}