 "chapters": [
  {
   "index": 0,
   "title": "## سؤال از تقویت اراده",
   "start": 0.8,
   "end": 157.82
  },
  {
   "index": 1,
   "title": "## عزم از روح برمی‌خیزد",
   "start": 157.82,
   "end": 215.2
  },
  {
   "index": 2,
   "title": "## زنجیرهٔ آلودگی از حس تا قلب",
   "start": 215.2,
   "end": 397.52
  },
  {
   "index": 3,
   "title": "## نور العلم نه هر علم فکری",
   "start": 397.52,
   "end": 575.1
  },
  {
   "index": 4,
   "title": "## سمع و حکمت؛ قرینهٔ دعا",
   "start": 575.1,
   "end": 661.7
  },
  {
   "index": 5,
   "title": "## دو کار سورهٔ جمعه؛ طهارت و تعلیم",
   "start": 661.7,
   "end": 802.42
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.8,
   "end": 4.84,
   "text": "بسم الله و بالله و علی ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.84,
   "end": 8.46,
   "text": "المستغاث بک یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.46,
   "end": 15.5,
   "text": "سؤال عزیز دیگری که به ما رسیده پرسیدن که چه کنیم ارادمون تقویت بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.5,
   "end": 19.8,
   "text": "مثلاً کم بخوریم، کم بخوابیم و از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.8,
   "end": 23.3,
   "text": "دست مسائل. ببینید عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.3,
   "end": 30.82,
   "text": "دعای بعد از زیارت آل یاسین رو که توسط معصوم به دست ما رسیده است و امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.82,
   "end": 36.6,
   "text": "صلوات الله علیه خودشون فرمودن هر وقت خواستید به ما توجه کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.6,
   "end": 38.96,
   "text": "با این زیارت متوجه ما باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.96,
   "end": 41.76,
   "text": "بعدش یه دعای شریفی دارد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.76,
   "end": 49.66,
   "text": "این چنین است: اللهم انی اسئلك ان تصلی علی محمد نبي رحمتك وكلمة نورك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.66,
   "end": 53.7,
   "text": "و ان تملأ قلبي نور اليقين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.7,
   "end": 60.14,
   "text": "وصدرى نور الايمان وفكري نور النيات وعزمي نور العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.14,
   "end": 68.58,
   "text": "وقوتي نور العقل ولساني نور الصدق وديني نور البصائر من عندك وبصري نور الرياء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.58,
   "end": 74.78,
   "text": "وسمعي نور الحكمة ومودتي نور الموالاة لمحمد و آله عليهم السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 74.78,
   "end": 81.28,
   "text": "همینطور تا آخر. اینجا خیلی زیبا در همین چند فراز اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 81.28,
   "end": 84.28,
   "text": "دعای بعد از زیارت آل یاسین داره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 84.28,
   "end": 87.94,
   "text": "لایه لایه بودن وجود ما اشاره میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.94,
   "end": 91.08,
   "text": "که یک جا میفرماید پر کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.08,
   "end": 93.24,
   "text": "قلب منو از نور یقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.24,
   "end": 95.58,
   "text": "یک جا میفرماید پر کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.58,
   "end": 98.86,
   "text": "سینه منو، صدری، از نور ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.86,
   "end": 104.24,
   "text": "یک جا میفرماید فکرم رو پر کن از نور نیت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.24,
   "end": 106.94,
   "text": "بعد اینجا میرسه به اینکه و عزمي نور العلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.94,
   "end": 112.28,
   "text": "عزم همون اراده است. سؤال شما هم این بود که چه کنیم عزم ما، اراده‌ی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.28,
   "end": 117.38,
   "text": "تقویت بشه. اینجا حضرت خودشون دارن کد میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.38,
   "end": 126.34,
   "text": "اصل رو بیان می‌کنند. میفرمایند که و عزمي نور العلم یعنی اراده‌ی من رو پر کن از نور علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.34,
   "end": 130.72,
   "text": "این چی رو میرسونه؟ میرسونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.72,
   "end": 134.16,
   "text": "یک، اراده به وسیله‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 134.16,
   "end": 139.02,
   "text": "نور علم توجه بفرمایید نور علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 139.02,
   "end": 144.62,
   "text": "تقویت میشه. اونم باید محیط اراده پر بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 144.62,
   "end": 148.62,
   "text": "ان تملأ. پر بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 148.62,
   "end": 151.68,
   "text": "محیط اراده از نور علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.68,
   "end": 155.36,
   "text": "حالا محیط اراده کجاست عزیزان دلم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 155.36,
   "end": 157.82,
   "text": "محیط اراده‌ی انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.82,
   "end": 160.62,
   "text": "حکما فرمودن عزم و اراده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.62,
   "end": 162.66,
   "text": "از روح برمی‌خیزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.66,
   "end": 165.62,
   "text": "روح انسان یعنی یک لایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.62,
   "end": 170.06,
   "text": "پنهان‌تر از قلب. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.06,
   "end": 174.92,
   "text": "در حقیقت تا لایه‌های پایین و مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.92,
   "end": 178.56,
   "text": "تصفیه نشن، تطهیر نشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.56,
   "end": 184.46,
   "text": "روح ما اولاً به اون طهارت لازم نمی‌رسه که بتونه اراده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.46,
   "end": 187.9,
   "text": "باید قلب پاک باشه. قلب چگونه پاک میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.9,
   "end": 190.4,
   "text": "باید مادونش که وهمه پاک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.4,
   "end": 194.54,
   "text": "وهم چگونه؟ مادون اون قوه خیال پاک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.54,
   "end": 198.24,
   "text": "قوه خیال چگونه؟ قوای باطنی و حس مشترک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.24,
   "end": 202.28,
   "text": "همون پنج حس ظاهری که ما داریم پنج تا هم همونطوری باطن داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.28,
   "end": 206.4,
   "text": "ما وقتی می‌خوابیم چشم بصر و ظاهر ما بسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.4,
   "end": 210.7,
   "text": "به ظاهر پنج حس ظاهری ما چشیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.7,
   "end": 213.28,
   "text": "لمس کردن، بوییدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.28,
   "end": 216.36,
   "text": "شنیدن و دیدن همه به ظاهر از کار افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.36,
   "end": 219.34,
   "text": "اما چگونه در خواب همه‌ی این‌ها رو داریم هنوز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.34,
   "end": 222.9,
   "text": "این‌ها همون قوا در باطن ما هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.9,
   "end": 227.62,
   "text": "در حقیقت این‌ها باید تطهیر بشن و طهارت این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.62,
   "end": 231.66,
   "text": "از طهارت همون حواس پنج گانه ظاهری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.66,
   "end": 236.62,
   "text": "تا حواس پنج گانه ظاهری طهارت نداشته باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.62,
   "end": 239.24,
   "text": "همون لایه به لایه باطن به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.24,
   "end": 242.46,
   "text": "این‌ها قبلاً بحثش در همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.46,
   "end": 247.66,
   "text": "کانال مرام گمنامی بیان شده در یک، در ذیل یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.66,
   "end": 251.02,
   "text": "قلوب، شرح یکی از قلوب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.02,
   "end": 255.1,
   "text": "قلب در قرآن. که چگونه قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.1,
   "end": 258.58,
   "text": "آلوده می‌شود. اگر اشتباه نکنم در قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.58,
   "end": 264.32,
   "text": "اغلف قلبی که در غلاف قرار گرفته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.32,
   "end": 268.66,
   "text": "در حقیقت دچار غفلت شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.66,
   "end": 273.34,
   "text": "اونجا بیان کردیم. وقتی حواس ظاهری آلوده شدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.34,
   "end": 277.68,
   "text": "و سست شدند، در وظایفشان کوتاهی کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.68,
   "end": 281.48,
   "text": "این‌ها می‌زنن حواس باطنی رو آلوده می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.48,
   "end": 284.4,
   "text": "حواس باطنی آلوده شد، قوه خیال آلوده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 284.4,
   "end": 288.02,
   "text": "قوه خیال آلوده شد، وهم آلوده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.02,
   "end": 291.18,
   "text": "همینطور عقل مشوبه به وهم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 291.18,
   "end": 298.32,
   "text": "قلب اون موقع دیگه دستوراتی که صادر میکنه چون مولامون فرمود یادتونه این حدیث رو در همون بحث‌های قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 298.32,
   "end": 300.36,
   "text": "در قرآن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 300.36,
   "end": 305.84,
   "text": "البصر برید العقل یا البصر برید القلب دوتاشم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.84,
   "end": 308.28,
   "text": "چشم جاسوس قلبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 308.28,
   "end": 313.14,
   "text": "جاسوس عقله. یعنی اینا هرچی بگن چشم به دنبال اون راه میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.14,
   "end": 317.76,
   "text": "اگر در حقیقت قلب کسی آلوده شد دیگه تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.76,
   "end": 321.74,
   "text": "همچنین قلب که آلوده شد میزنه دیگه به لایه‌های پنهان‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.74,
   "end": 325.24,
   "text": "که چگونه این رسوبات اتفاق میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.24,
   "end": 328.36,
   "text": "چگونه این انتشار آلودگی‌ها اتفاق میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 328.36,
   "end": 335.06,
   "text": "بر اثر، بر اثر اصرار بر گناه، سماجت بر گناه، تکرار بر گناه و صفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.06,
   "end": 337.68,
   "text": "آلوده. همونطور که به عکسش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.68,
   "end": 340.76,
   "text": "تکرار اعمال خوب و پسندیده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.76,
   "end": 344.02,
   "text": "نورانی هی نور على نور می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.02,
   "end": 347.36,
   "text": "نور بر نور می‌شود و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 347.36,
   "end": 351.16,
   "text": "در حقیقت لایه‌های وجود انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.16,
   "end": 353.22,
   "text": "نورانی‌تر و قوی‌تر می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 353.22,
   "end": 356.78,
   "text": "پس نتیجه اول اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 356.78,
   "end": 364.9,
   "text": "قلب انسان که در حقیقت عزم انسان، اراده انسان از روح برمی‌خیزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 364.9,
   "end": 368.6,
   "text": "برای اینکه بشود روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 368.6,
   "end": 373.08,
   "text": "تقویت بشود که اراده انسان قوی باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.08,
   "end": 377.2,
   "text": "راهش اولاً تطهیر قوای مادونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.2,
   "end": 382.04,
   "text": "حالا یک کتاب هست رساله این کتاب شریف طهارت نفس از تعلّمه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 382.04,
   "end": 383.84,
   "text": "شاگردان ایشون هم شرحش دادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.84,
   "end": 389.32,
   "text": "کتاب شریفیه. اونجا یک یک راه‌های طهارت این اعضا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.32,
   "end": 393.96,
   "text": "در حقیقت باطن و عوالم وجودی رو بیان می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.96,
   "end": 397.16,
   "text": "که باید اونجا رجوع کرد. عزیزی که سؤال کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 397.16,
   "end": 399.8,
   "text": "بعد نکته دوم این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 399.8,
   "end": 407.38,
   "text": "می‌فرماید این عزم من، اراده من پر بشود از نور علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.38,
   "end": 410.46,
   "text": "نه اینکه از خود علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 410.46,
   "end": 412.78,
   "text": "چون ببینید وقتی ما می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 412.78,
   "end": 416.16,
   "text": "کار فکری، کار فکری کردن هر نوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.16,
   "end": 419.56,
   "text": "علمی رو برداشتن زمین شناسی، هواشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 419.56,
   "end": 422.46,
   "text": "چون و فی الارض آیات للمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 422.46,
   "end": 425.88,
   "text": "به قول آقای جوادی آملی آیات خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.88,
   "end": 428.06,
   "text": "بر اساس قرآن در همین زمین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.06,
   "end": 431.14,
   "text": "پس زمین شناسی هم خودش علم الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.14,
   "end": 434.6,
   "text": "لکن اینجا می‌فرماید نور العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.6,
   "end": 438.28,
   "text": "اونم پر بشه روح انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.28,
   "end": 442.18,
   "text": "پر بشه محیط اراده انسان از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.18,
   "end": 445.24,
   "text": "نور علم. وقتی میگه نور علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.24,
   "end": 447.68,
   "text": "نور مربوط به ملکوت نظام هستی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.68,
   "end": 450.18,
   "text": "مربوط به باطن عالم هستی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.18,
   "end": 454.48,
   "text": "مربوط به ربوبیت نظام هستی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.48,
   "end": 458.4,
   "text": "یعنی در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.4,
   "end": 467.78,
   "text": "ااا اونجایی که حضرت فرمودند امام صادق صلی الله علیه آله علم نور آله علم نور یغرفهُ الله فی قلب من یشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 467.78,
   "end": 469.82,
   "text": "علم رو نور گرفتن، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.82,
   "end": 475.46,
   "text": "فهم باطنی و چشیدن و دارا شدن رو حضرت داره می‌فرماید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 475.46,
   "end": 481.12,
   "text": "نه این علم فکری. علم فکری علمه بله علمه اما نور علم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.12,
   "end": 485.58,
   "text": "علم فکری بسترسازی برای اینه که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.58,
   "end": 490.76,
   "text": "تابش نور علم الهی در وجود انسان صورت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 490.76,
   "end": 493.78,
   "text": "الان من دارم صحبت می‌کنم به شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.78,
   "end": 497.54,
   "text": "یک در حقیقت کم و کیف مسموع می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 497.54,
   "end": 500.32,
   "text": "یک صوت عارضیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 500.32,
   "end": 505.04,
   "text": "یک در حقیقت در عالم ماده است صوته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.04,
   "end": 508.14,
   "text": "کمه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 508.14,
   "end": 511.0,
   "text": "مجرد که نیست که. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 511.0,
   "end": 520.74,
   "text": "اونچه که این شنیده‌های شما رو به شما القا می‌کند یعنی بر جان شما فهم ایجاد می‌کند، چشیدن بهتره بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 520.74,
   "end": 525.52,
   "text": "اونچه که شما برداشت می‌کنی و متوجه می‌شی رو می‌چشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.52,
   "end": 530.46,
   "text": "اون می‌شه نور علم. که اون باید از حضرت حق طلب کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.46,
   "end": 533.22,
   "text": "و با از ظاهر شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 533.22,
   "end": 537.64,
   "text": "یعنی با حواس ظاهریه، با همین شریعت، شرع دین، رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 537.64,
   "end": 540.1,
   "text": "بزرگان. این‌ها رو کم نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.1,
   "end": 545.42,
   "text": "لذا این‌ها باعث می‌شه که انسان وقتی درست بندگی مسیر بندگی‌ش درست شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 545.42,
   "end": 550.58,
   "text": "اراده‌ش هم قوی می‌شه. نکته دیگر این که می‌فرماید و عزمی نور العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 550.58,
   "end": 553.88,
   "text": "دقت بفرمایید خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 553.88,
   "end": 556.52,
   "text": "این اراده به نور علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 556.52,
   "end": 559.2,
   "text": "تقویت می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 559.2,
   "end": 565.08,
   "text": "علم اینجا در حقیقت باز تـ-- با توجه به اینکه می‌فرمود نور العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 565.08,
   "end": 568.56,
   "text": "باید از این علم رو گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 568.56,
   "end": 570.54,
   "text": "همون حکمت و معرفت. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 570.54,
   "end": 573.54,
   "text": "به قرینه چند تا جمله بعدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 573.54,
   "end": 578.02,
   "text": "همینطور که میری جلو بعد می‌فرماید و سمعی نور الحکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 578.02,
   "end": 580.22,
   "text": "حالا قوای سامعه من میخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 580.22,
   "end": 581.86,
   "text": "من میخوام برم تحصیل علم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 581.86,
   "end": 584.94,
   "text": "قوای سامعه باید داشته باشم که بشنوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 584.94,
   "end": 587.12,
   "text": "خب این قوای سامعه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.12,
   "end": 592.34,
   "text": "باید با چی پر بشه؟ باز می‌فرماید نور الحکمه، حکمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 592.34,
   "end": 596.7,
   "text": "حکمت، عزیزان. حکمت همون به زبان قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 596.7,
   "end": 599.1,
   "text": "حکمت به زبان یونان فلسفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 599.1,
   "end": 602.8,
   "text": "ببینید ادعو الى سبيل ربك بالحکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 602.8,
   "end": 609.4,
   "text": "در حقیقت اون نور علم در نور حکمت خوابیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 609.4,
   "end": 611.86,
   "text": "حکمت هم که همون فلسفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 611.86,
   "end": 617.0,
   "text": "علم به اعیان، اعیان موجودات، عین موجوداته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 617.0,
   "end": 620.36,
   "text": "اونطور که هستند که بحثش قبلاً گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 620.36,
   "end": 625.44,
   "text": "باز برای در حقیقت عزیزانی که سؤال کردند خسته شون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 625.44,
   "end": 627.72,
   "text": "چگونه تقویت اراده صورت می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 627.72,
   "end": 633.16,
   "text": "عزیزان دلم بایستی که انسان علم و معرفتش خلاصه بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 633.16,
   "end": 635.02,
   "text": "علم و معرفتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 635.02,
   "end": 638.9,
   "text": "زیاد شود. هرچی علم و معرفت زیاد شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 638.9,
   "end": 644.42,
   "text": "حکمت و عرفان زیاد شد، شناخت زیاد شد، عزم و اراده قوی‌تر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 644.42,
   "end": 646.86,
   "text": "لکن اون علم فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.86,
   "end": 651.96,
   "text": "که در علم اخلاق از، ازش به هبل حجاب اکبر یاد شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 651.96,
   "end": 654.36,
   "text": "اون بستر‌سازی نه که اصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 654.36,
   "end": 659.08,
   "text": "اون نور علم نیست. عرض شد این‌ها باید انجام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 659.08,
   "end": 664.24,
   "text": "دو تا کار کنار هم بیاد این اتفاق رخ میده بر اساس دو سوره جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.24,
   "end": 671.4,
   "text": "که در حقیقت و یزکیهم و یعلمهم الكتاب و الحکمه که از تعلّمه همیشه هرکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 671.4,
   "end": 673.66,
   "text": "ازش سؤال کنه دفعةً که ما چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 673.66,
   "end": 676.8,
   "text": "می‌فرماید دو کار بکن. طهارت نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 676.8,
   "end": 678.92,
   "text": "تعلیم و تربیت یا ادب آموزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 678.92,
   "end": 681.62,
   "text": "طهارت، ادب. این دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 681.62,
   "end": 683.88,
   "text": "این دو تا باعث می‌شه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 683.88,
   "end": 686.12,
   "text": "اراده‌ش قوی بشه. البته خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 686.12,
   "end": 690.66,
   "text": "دستور العمل‌هایی هم عزیزان دادن، بزرگان دادن، اون‌ها هم خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 690.66,
   "end": 698.28,
   "text": "حالا مثلاً یادش بخیر ما شاید حدود بیست و پنج سال پیش بود که مظهر، محضر حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 698.28,
   "end": 701.5,
   "text": "مظاهری در اصفهان درس می‌خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 701.5,
   "end": 703.78,
   "text": "اونجا یادمه خب یه روزی رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 703.78,
   "end": 707.58,
   "text": "خمینی شهر محضر حضرت آیت الله شوشتری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 707.58,
   "end": 712.14,
   "text": "خب ایشون یکی همین سؤال رو از ایشون کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 712.14,
   "end": 716.18,
   "text": "آقا چه کنیم؟ حضرت آقای شوشتری ما چه کنیم اراده‌مون قوی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 716.18,
   "end": 718.8,
   "text": "ایشون فرمودن به یادگار از من داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 718.8,
   "end": 720.94,
   "text": "یه دستور العملی دادن. حالا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 720.94,
   "end": 727.68,
   "text": "سینه به سینه اینو به شما عرض می‌کنیم که یکی از راه‌های تقویت اراده این بود که فرمودند که چهارده ماه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 727.68,
   "end": 730.0,
   "text": "چهارده ختم قرآن کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 730.0,
   "end": 733.24,
   "text": "به نیت چهارده معصوم علیهم السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 733.24,
   "end": 738.36,
   "text": "ماه اول به نیت پیامبر، دوم امیرالمؤمنین، سوم حضرت زهرا همینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 738.36,
   "end": 742.46,
   "text": "تا امام عصر. چهارده ماه یعنی یک سال و دو ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 742.46,
   "end": 746.54,
   "text": "بعد هر روز یک جزء بخوانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 746.54,
   "end": 748.98,
   "text": "ماه‌هایی که بیست و نه روزه تموم می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 748.98,
   "end": 751.98,
   "text": "روز بیست و نهم دو جزء آخر رو با هم بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 751.98,
   "end": 754.14,
   "text": "یعنی جزء بیست و نه و سی رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 754.14,
   "end": 756.7,
   "text": "ماه‌هایی که سی و یک روز تموم می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 756.7,
   "end": 759.24,
   "text": "روز سی و یکم دوباره جزء سی رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 759.24,
   "end": 763.94,
   "text": "همینطور اگر یک روز ترکتون شد به هر دلیلی، روز بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 763.94,
   "end": 768.82,
   "text": "اون جزء ترک شده رو به علاوه جزء همون روز رو با هم بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 768.82,
   "end": 772.08,
   "text": "نذارید دوباره ترکتون بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 772.08,
   "end": 776.54,
   "text": "و این نیت کنید هدیه کنید به چهارده معصوم علیهم السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 776.54,
   "end": 783.44,
   "text": "همین تمرین و ممارست بر این قضیه باعث می‌شه که اراده انسان تقویت بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 783.44,
   "end": 786.16,
   "text": "و رفته رفته انسان می‌بیند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 786.16,
   "end": 788.5,
   "text": "اون نور در وجودش ایجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 788.5,
   "end": 794.02,
   "text": "اولیاء الله کمک حالش شدند و اراده‌ش قوی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 794.02,
   "end": 797.34,
   "text": "ان شاء الله که موفق باشیم همه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 797.34,
   "end": 800.48,
   "text": "و بنده حقیر را هم از دعای خودتون فراموش نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 800.48,
   "end": 802.42,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}