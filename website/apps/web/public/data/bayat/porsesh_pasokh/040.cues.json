 },
 "chapters": [
  {
   "index": 0,
   "title": "## نور توحید؛ علم حصولی و شهودی",
   "start": 7.54,
   "end": 50.54
  },
  {
   "index": 1,
   "title": "## آنچه پس از مرگ می‌ماند",
   "start": 50.54,
   "end": 108.78
  },
  {
   "index": 2,
   "title": "## قرآن و لعن تالی بدون نور",
   "start": 108.78,
   "end": 490.27
  },
  {
   "index": 3,
   "title": "## حجاب علم و دو کار واجب",
   "start": 490.27,
   "end": 575.77
  },
  {
   "index": 4,
   "title": "## سعی و تلطیف سر",
   "start": 575.77,
   "end": 724.51
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 7.54,
   "text": "بسم الله و بالله و على ملة رسول الله المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.54,
   "end": 17.7,
   "text": "پرسیده شده که برای رسیدن به نور توحید چه کنیم و آیا اصلاً خدا از ما این نور توحید رو میخواد یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 17.7,
   "end": 21.88,
   "text": "اصلاً اگر ما صرفاً بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 21.88,
   "end": 26.22,
   "text": "راهمون راه توحید است، توحید صرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 26.22,
   "end": 30.72,
   "text": "یعنی به معنای علم فکری منظورم و علم حصولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.72,
   "end": 33.76,
   "text": "خب این که کامل نیست ناقصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.76,
   "end": 41.46,
   "text": "در حقیقت همون معدات یا علت معده و کمک کننده‌اند که بارها عرض شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 41.46,
   "end": 48.98,
   "text": "و هرچه که علم فکری در مسیر توحید ما پیدا می‌کنیم که اصطلاحاً بهش میگن معرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 48.98,
   "end": 55.14,
   "text": "این دانسته ها تا وقتی که به شهود نرسیدند و به علم شهودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 55.14,
   "end": 59.16,
   "text": "تبدیل نشدند خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 59.16,
   "end": 65.56,
   "text": "در حقیقت دلخش کننده نیستند و البته لازمند اما کافی نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 65.56,
   "end": 68.7,
   "text": "یعنی این‌ها علت مدعند کمک می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 68.7,
   "end": 71.02,
   "text": "لذا سرتاسر قرآن ما رو تک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 71.02,
   "end": 74.16,
   "text": "همش دائماً نهیب می‌زنه که چرا فکر نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 74.16,
   "end": 85.08,
   "text": "چرا اهل تفکر نیستید؟ و این تفکر انسان رو به تأمل و تعقل وا می‌داره و از اونجا به قدس پل می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 85.08,
   "end": 87.22,
   "text": "که راه ارتباط و اتصال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 87.22,
   "end": 90.12,
   "text": "فکر ما با قدس و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 90.12,
   "end": 94.62,
   "text": "نظام اقدس از طریق عقله که با تفکر رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 94.62,
   "end": 105.5,
   "text": "منتها اون نور این راه در حقیقت نور توحید میشه همون علم شهودی میشه، همون الهامات به عبارتی القاءات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 105.5,
   "end": 108.28,
   "text": "که ما در پی اون باید باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 108.28,
   "end": 114.12,
   "text": "که در فلسفه بعثت انبیا صراحتاً می‌فرماید یتلو عليهم آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 114.12,
   "end": 117.22,
   "text": "این تلاوت آیات صورت می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 117.22,
   "end": 122.32,
   "text": "تا یزکیهم و يعلمهم الكتاب و الحكمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 122.32,
   "end": 126.1,
   "text": "تعلیم و همون ادب آموزی و طهارت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 126.1,
   "end": 133.02,
   "text": "این طهارت، طهارت نفس باعث می‌ش-- باعث می‌شه که ادب آموزی و تعلیم معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 133.02,
   "end": 135.42,
   "text": "به درستی شکل بگیره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 135.42,
   "end": 138.22,
   "text": "لا یمسه إلا المطهرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 138.22,
   "end": 143.16,
   "text": "انسان با قدس نظام هستی مرتبط بشه بر اساس طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 143.16,
   "end": 146.68,
   "text": "یعنی طهارت باعث می‌شه که اون آداب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 146.68,
   "end": 150.68,
   "text": "تعالیم رو انسان درک کنه، بچشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 150.68,
   "end": 157.36,
   "text": "بهش برسه و حتی از حق الیقین هم عبور کنه و برسه به برد الیقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 157.36,
   "end": 161.8,
   "text": "یعنی خنکای این حقایق رو در وجود خودش بچشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 161.8,
   "end": 165.76,
   "text": "راهش از تفکر و تأمل و تدبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 165.76,
   "end": 170.22,
   "text": "تحقق و تدقق و این‌ها می‌گذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 170.22,
   "end": 172.96,
   "text": "که پیاده بشن این‌ها در وجود انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 172.96,
   "end": 176.58,
   "text": "انسان با طهارت نفس به این آداب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 176.58,
   "end": 179.74,
   "text": "و تعالیم عمل کنه بره جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 179.74,
   "end": 182.8,
   "text": "دیگه بقیش با چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 182.8,
   "end": 184.9,
   "text": "با تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 184.9,
   "end": 188.9,
   "text": "نور توحید در وجود انسانه که دیگه اون کار ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 188.9,
   "end": 196.2,
   "text": "در حقیقت وقتی هم که ما از دنیا میریم ماحصل آنچه که از ما می‌ماند و از ما پرس و جو می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 196.2,
   "end": 198.68,
   "text": "تجلی نور توحید در وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 198.68,
   "end": 207.62,
   "text": "و الا خب همه اشهد ان لا اله الا الله و اشهد ان محمدا رسول الله صلی الله علیه و آله و سلم میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 207.62,
   "end": 209.9,
   "text": "اما آیا این‌ها به نور توحید رسیدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 209.9,
   "end": 213.5,
   "text": "نور توحید همون حقیقت ولایت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 213.5,
   "end": 215.92,
   "text": "ولایت هم از ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 215.92,
   "end": 220.3,
   "text": "گرفته می‌شه که در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.3,
   "end": 223.88,
   "text": "ولیه ای قرابه همون معنای قربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 223.88,
   "end": 226.5,
   "text": "ولایت که با علم حاصل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 226.5,
   "end": 234.04,
   "text": "العلم نور. يقذفه الله في قلب من يشاء یا يقذفه الله في قلب من اراد ان يهدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 234.04,
   "end": 238.02,
   "text": "نوره. این نور همون نور توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 238.02,
   "end": 241.14,
   "text": "چون علم افاضه ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 241.14,
   "end": 243.98,
   "text": "اون فهم مربوط به ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 243.98,
   "end": 247.62,
   "text": "اون چیزی که ما فکری یاد می‌گیریم علم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 247.62,
   "end": 251.92,
   "text": "یا به عبارتی اگر هم بپذیریم که علم داشته باشه پوسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 251.92,
   "end": 255.92,
   "text": "علمه. نور علم یا علم نوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 255.92,
   "end": 258.94,
   "text": "افاضه ملکوته. اون چشیدن باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 258.94,
   "end": 264.32,
   "text": "نور توحید تحقق در باطن وجود انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 264.32,
   "end": 266.38,
   "text": "لذا وقتی انسان می‌میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 266.38,
   "end": 271.52,
   "text": "به م-موت می‌افته و از ظاهر به باطن خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 271.52,
   "end": 274.92,
   "text": "اخراجش می‌کنند از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 274.92,
   "end": 278.88,
   "text": "اینجا اونچه که ظهور می‌کنه اونور باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 278.88,
   "end": 281.84,
   "text": "باطن اگر نور توحید داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.84,
   "end": 285.1,
   "text": "نور تجلی می‌کنه. اگر نداره ظلمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 285.1,
   "end": 290.28,
   "text": "ولو ظاهراً بر لسانش کلمات توحید جاری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 290.28,
   "end": 297.68,
   "text": "پس بله، اونچه که از ما می‌خوان نور توحیده و راه رسیدن به نور توحید هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 297.68,
   "end": 299.64,
   "text": "از طریق طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 299.64,
   "end": 307.16,
   "text": "و ادب آموزی یا طهارت و تزکیه در کنار تعلیم معالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 307.16,
   "end": 313.92,
   "text": "پشت سر امام معصوم حاصل می‌شه که به یک معنا می‌شه همون حقیقت ولایت کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 313.92,
   "end": 316.66,
   "text": "که ولایت همون علم محض است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 316.66,
   "end": 322.2,
   "text": "ولایت کلیه کل علم خداست که تجلی کرده در قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 322.2,
   "end": 327.16,
   "text": "که همه علم خدا در قرآن تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 327.16,
   "end": 331.78,
   "text": "که إنك لَتلقى القرآن عن ملة حكيم عليم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 331.78,
   "end": 339.16,
   "text": "اسم حکیم و علیم خدا به تمامه در قرآن تجلی کرده و تلقی حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 339.16,
   "end": 343.52,
   "text": "نبی اکرم از خدای منان همین قرآنه که همه علم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 343.52,
   "end": 347.24,
   "text": "علم ذاتیه. تلقی از ذات شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 347.24,
   "end": 349.46,
   "text": "بعد تنزل پیدا کرده اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 349.46,
   "end": 352.96,
   "text": "حالا به عالم عقل و بعد مثال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 352.96,
   "end": 356.42,
   "text": "اومده به در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 356.42,
   "end": 363.39,
   "text": "مشع ماده به صورت صوت و لفظ و جوهر و کتاب این شکلی دراومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 363.39,
   "end": 367.33,
   "text": "از این مسیر میشه به نور، نور توحید رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 367.33,
   "end": 370.75,
   "text": "و اونچه که از ما می‌ماند همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 370.75,
   "end": 373.69,
   "text": "خیلیا هستن که تالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 373.69,
   "end": 379.89,
   "text": "در حقیقت تلاوت کننده قرآن \"ربما تلا القرآن والقرآن یلعنه.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 379.89,
   "end": 385.87,
   "text": "چه بسا ااا تال-- تلاوت کننده قرآنی که قرآن لعنش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 385.87,
   "end": 392.13,
   "text": "چرا؟ مگه چه اشکالی رخ داده که قرآن تلاوت کننده خودش رو لعن کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 392.13,
   "end": 398.67,
   "text": "چون به نور نرسیده. جالبه که از تعالمه خیلی زیاد، تعالمه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 398.67,
   "end": 406.31,
   "text": "حفظه الله تعالی خیلی زیاد تاکید به تفکر در آیه \"الله نور السماوات والارض\" می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 406.31,
   "end": 410.61,
   "text": "حالا من خیلی با ترس و لرز میگم چون نمی‌دونم کیا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 410.61,
   "end": 413.45,
   "text": "صوت رو می‌شنوند. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 413.45,
   "end": 417.43,
   "text": "حضرت علامه من خودم از لسان مبارکشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 417.43,
   "end": 423.47,
   "text": "در یک صوتی شنیدم که می‌فرمودند \"الله نور السماوات والارض\" رو دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 423.47,
   "end": 426.95,
   "text": "که می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 426.95,
   "end": 430.87,
   "text": "الله نور آسمان‌ها و زمین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 430.87,
   "end": 434.59,
   "text": "بعد می‌فرمود همه چی نوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 434.59,
   "end": 440.79,
   "text": "و هم-- یعنی آسمان و زمین حتی شب، روز همه نورند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 440.79,
   "end": 444.95,
   "text": "و خدا هم که خودش رو نور معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 444.95,
   "end": 448.31,
   "text": "یعنی به صورت کلی حالا من عرض می‌کنم و رد میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 448.31,
   "end": 451.37,
   "text": "حالا بعد مثل می‌زنه نور خودشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 451.37,
   "end": 455.67,
   "text": "مثل نورش. \"مثل النوره کالمشکاة.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 455.67,
   "end": 459.87,
   "text": "مثل این نور همچون مشکاته، چراغدان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 459.87,
   "end": 465.27,
   "text": "که در تفاسیر فرمودن حضرت صدیقه طاهره صلوات الله علیه است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 465.27,
   "end": 469.73,
   "text": "عرض شود شده ظرف نوریه آل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 469.73,
   "end": 473.53,
   "text": "حالا اون در حقیقت مثل النورهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 473.53,
   "end": 476.79,
   "text": "و بعضیا اون نور رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 476.79,
   "end": 480.09,
   "text": "نور دوم رو. الله نور السماوات والارض اون نور اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 480.09,
   "end": 484.83,
   "text": "مثل النورهی این نور دوم رو پیغمبر گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 484.83,
   "end": 489.15,
   "text": "که تنزل پیدا کرده. نور اومده به این شکل در دسترس ما قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 489.15,
   "end": 491.47,
   "text": "پس خلاصه کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 491.47,
   "end": 496.59,
   "text": "اون هم اینکه ما باید به نور توحید برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 496.59,
   "end": 499.15,
   "text": "اما هیچ چاره‌ای از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 499.15,
   "end": 503.33,
   "text": "رفتن تو دل حجاب نداریم که \"العلم هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 503.33,
   "end": 507.43,
   "text": "الحجاب الاكبر.\" حتی اسماء الهی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 507.43,
   "end": 509.87,
   "text": "حجاب الهی‌اند. حجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 509.87,
   "end": 516.47,
   "text": "حجب نوری‌اند. لکن باید رفت سمت اینا تا خدا گشایش و انفتاح ایجاد کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 516.47,
   "end": 519.83,
   "text": "انشراح ایجاد کنه، اون نور در وجود بدمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 519.83,
   "end": 525.45,
   "text": "اون دیگه کار ملکوته. اه-- هدی نمی‌تونه بگه معلم من، استاد من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 525.45,
   "end": 528.17,
   "text": "نمی‌دونم این، اون برای من کم کاری کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 528.17,
   "end": 530.91,
   "text": "تو در وجود خودت دو تا کار انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 530.91,
   "end": 535.09,
   "text": "طهارت نفس، تزکیه. یزکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 535.09,
   "end": 539.27,
   "text": "تعلیم و ادب آموزی. \"يعلمهم الكتاب والحكمة.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 539.27,
   "end": 543.27,
   "text": "خصوصاً باب حکمت اینجا خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 543.27,
   "end": 548.23,
   "text": "که شیرینیش اینه که مباحث از تعالمه حسن زاده هم همه بر سه-- حکمت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 548.23,
   "end": 550.67,
   "text": "حتی اخلاق، اخلاقیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 550.67,
   "end": 553.29,
   "text": "مباحث ایشون هم بر مبنای حکمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 553.29,
   "end": 557.97,
   "text": "این دو تا کار رو که انجام دادید، اون موقع نور تجلی می‌کنه در وجود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 557.97,
   "end": 561.89,
   "text": "در وجود خودت. بعد به جایی می‌رسی که می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 561.89,
   "end": 564.41,
   "text": "اصلاً چیزی جز نور نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 564.41,
   "end": 567.31,
   "text": "و شما هم یک پرتوی از نور هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 567.31,
   "end": 572.51,
   "text": "اصلاً میگن شیعه، یه حدیث داریم چون شعاعی از پرتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 572.51,
   "end": 575.31,
   "text": "نور اون‌هاست بهش میگن شیعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 575.31,
   "end": 579.57,
   "text": "بعد جلوتر که میرید یه مقدار تعملتون بیشتر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 579.57,
   "end": 583.19,
   "text": "لطافت سر که پیدا می‌کنید بر اساس اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 583.19,
   "end": 588.55,
   "text": "قلب قرآن که قلب عبارتی قرآن البته که \"وليتلطف.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 588.55,
   "end": 591.57,
   "text": "تلطیف سر که صورت گرفت بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 591.57,
   "end": 594.27,
   "text": "مداومت بر تزکیه و طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 594.27,
   "end": 596.45,
   "text": "و تعلیم و ادب آموزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 596.45,
   "end": 604.23,
   "text": "مداومت بر این قصه و سعی و تلاش که \"أليس للإنسان إلا ما سعى.\" هیچی برای انسان نیست مگر اون سعی و تلاشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 604.23,
   "end": 607.87,
   "text": "این سعی و تلاش خدا هم که مشکوره دیگه شاکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 607.87,
   "end": 611.91,
   "text": "خدا در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 611.91,
   "end": 614.09,
   "text": "پاداش میده، جواب میده. چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 614.09,
   "end": 619.71,
   "text": "تجلی می‌کنه نسبت به سعی وجودی تو و فهمش و تو را چنان عمیق می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 619.71,
   "end": 621.99,
   "text": "که متصل میشی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 621.99,
   "end": 625.63,
   "text": "در حقیقت عالم مثال، عالم عقل، عالم اله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 625.63,
   "end": 627.59,
   "text": "می‌بینی اونچه که دیگران نمی‌بینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 627.59,
   "end": 632.19,
   "text": "\"غض أبصاركم ترون العجائب.\" چشم ظاهر توتو ببند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 632.19,
   "end": 634.75,
   "text": "ببین عجائب رو بی-- می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 634.75,
   "end": 637.79,
   "text": "و می‌بینی اصلاً همه چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 637.79,
   "end": 641.71,
   "text": "هرچی که می‌بینی، می‌بینی بوی خدا می‌بینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 641.71,
   "end": 644.37,
   "text": "میده و نور خدا درش تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 644.37,
   "end": 648.89,
   "text": "اصلاً هرچی که می‌بینی نه اینکه چیزی رو ببینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 648.89,
   "end": 651.39,
   "text": "که خدا در اون چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 651.39,
   "end": 656.51,
   "text": "تجلی کرد بلکه عین بودن آن، عین متن هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 656.51,
   "end": 662.27,
   "text": "چیزی رو در متن خارج، هر عینیتی رو عینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 662.27,
   "end": 667.33,
   "text": "مظهر خداست. یعنی ظهور خدا شد عینیت این شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 667.33,
   "end": 670.37,
   "text": "یعنی هر چیزی که خب یکی از اشیا هم ما هستیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 670.37,
   "end": 679.05,
   "text": "هر شیی که یکیش هم از این اشیا ما هستیم که \"وعلم آدم الأسماء كلها\" و اون اسما اشیا هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 679.05,
   "end": 681.27,
   "text": "عینا ظهور حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 681.27,
   "end": 684.45,
   "text": "منتها این رتبه بندی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 684.45,
   "end": 689.67,
   "text": "فضیلت و برتری‌شون بر یکدیگر به جهت شدت ظهوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 689.67,
   "end": 693.93,
   "text": "یه جا خدا شدیدتر ظهور کرده، رتبه بالاتره، یه جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 693.93,
   "end": 696.25,
   "text": "کمتر ظهور کرده، ضعیف‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 696.25,
   "end": 699.79,
   "text": "حالا به یک عبارتی رتبه پایین تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 699.79,
   "end": 702.19,
   "text": "اما همه چیز ظهور حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 702.19,
   "end": 708.69,
   "text": "این چنین اگر دیدی اصلاً جز نور توحید چیزی نمی‌بینی که \"الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 708.69,
   "end": 711.43,
   "text": "نور السماوات والأرض.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 711.43,
   "end": 719.89,
   "text": "ان‌شاءالله که خدا ما رو آگاه به این حقایق کنه و توفیق بده بچشیم که اگر پیاده بشه این‌ها در وجودمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 719.89,
   "end": 722.73,
   "text": "نه محقق بلکه متحقq خواهیم شد.",
