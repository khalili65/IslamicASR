 "chapters": [
  {
   "index": 0,
   "title": "## پرسش؛ سقوط پس از تفکر در ذات",
   "start": 0.98,
   "end": 178.06
  },
  {
   "index": 1,
   "title": "## راه معرفت از آثار؛ خرق حجاب نورانی",
   "start": 178.06,
   "end": 324.06
  },
  {
   "index": 2,
   "title": "## وسوسه؛ گواه صراط مستقیم",
   "start": 324.06,
   "end": 418.47
  },
  {
   "index": 3,
   "title": "## علاج وسوسه؛ استعاذه و ترک تکرار",
   "start": 418.47,
   "end": 621.27
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.98,
   "end": 5.94,
   "text": "بسم الله و بالله و على ملة رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.94,
   "end": 9.34,
   "text": "المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.34,
   "end": 12.42,
   "text": "عزیزی پرسیده که من چه کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.42,
   "end": 17.64,
   "text": "در یه ورطه‌ای افتادم. یه زمانی حالات خوشی داشتم و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.64,
   "end": 20.68,
   "text": "و نمازهای خیلی باحال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.68,
   "end": 24.08,
   "text": "با حضور قلب و این‌ها. بعد وقتی که افتادم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.08,
   "end": 27.84,
   "text": "تفکر در ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.84,
   "end": 31.1,
   "text": "ترسیدم و حالاتم عوض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.1,
   "end": 34.26,
   "text": "به وسوسه و افکار منفی دچار شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.26,
   "end": 37.24,
   "text": "دیگه حالا از ترس نمازامو سریع می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.24,
   "end": 41.0,
   "text": "همش کارم گریه شده، توسل به اهل بیت شده و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.0,
   "end": 48.18,
   "text": "ببینید عزیزان ما اصلاً اون ذات غیب الغیوب حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.18,
   "end": 53.54,
   "text": "که منظور نظر ایشون هست و به تفکر در اون افتاده ایشون و به این ورطه افتاده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.54,
   "end": 56.94,
   "text": "این اصلاً کلاً نه موضوع قرآن هست نه روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.94,
   "end": 59.22,
   "text": "هیچ کدوم از اولیاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.22,
   "end": 60.78,
   "text": "ما رو به اون دعوت نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.78,
   "end": 64.62,
   "text": "اون نفس حضرت حق چرا نفس رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.62,
   "end": 73.02,
   "text": "که حالا بعضیا اومدن از آیه \"و یحذرکم الله نفسه\" این تعبیر رو کردن و برداشت رو کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.02,
   "end": 75.66,
   "text": "این که خدا شما رو در قرآن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.66,
   "end": 79.46,
   "text": "نفس خودش برحذر داشته است پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.46,
   "end": 81.22,
   "text": "نفس خدا رو هم نباید شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.22,
   "end": 85.98,
   "text": "اگر این تعبیر درست باشد که پس چگونه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.98,
   "end": 90.14,
   "text": "دعاهای مخصوص آخرالزمان داریم در-- توسط نواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.14,
   "end": 94.86,
   "text": "四 اربعه حضرت صاحب الامر این دعا وارد شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.86,
   "end": 97.9,
   "text": "\"اللهم عرفنی نفسك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.9,
   "end": 101.4,
   "text": "فانك ان لم تعرفنی نفسك لم اعرف رسولک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.4,
   "end": 103.98,
   "text": "خدای خودت نفست رو به من بشناسون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 103.98,
   "end": 107.94,
   "text": "اولاً انقدر مرتبه نفس حضرت حق، نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.94,
   "end": 111.46,
   "text": "کلیه الهیه انقدر سنگینه که باید خدا به ما بشناسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.46,
   "end": 114.18,
   "text": "این یک. لذا جای خطره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.18,
   "end": 117.5,
   "text": "که \"یحذرکم الله نفسه\" یعنی خیلی بار سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.5,
   "end": 120.14,
   "text": "نه اینکه نیا. یعنی وقتی اومدی مجهز بیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 120.14,
   "end": 122.76,
   "text": "حواست باشه کجا داری میای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 122.76,
   "end": 127.18,
   "text": "پس اون نفس رو که حالا از-- اساساً از این جهت هم بهش میگن نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 127.18,
   "end": 129.5,
   "text": "چرا به ما میگن نفس ناطقه داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 129.5,
   "end": 133.4,
   "text": "به جهت این که نفس ما تعلق به جسم و بدن ما داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.4,
   "end": 135.42,
   "text": "هیچ‌وقت نفس ما بدون بدن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 135.42,
   "end": 141.18,
   "text": "بالا برزخ و قیامت و اینام بریم بدن برزخی و مثالی و قیامتی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 141.18,
   "end": 144.88,
   "text": "این‌ها داریم. از این جهت که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 144.88,
   "end": 150.54,
   "text": "باطن ما تعلق به ظاهر دارد که این بحث‌ها قبلاً گذشته است بهش میگن نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 150.54,
   "end": 155.58,
   "text": "خدا البته تعلق دارد اما تعلقش تعلق هبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 155.58,
   "end": 159.36,
   "text": "نه تعلق احتیاجی. تعلق نفس ما به بدن از رو احتیاجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 159.36,
   "end": 161.88,
   "text": "باید با بدن رشد کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 161.88,
   "end": 165.94,
   "text": "سیر کنه، از نقص به کمال بره، سیر استکمالی‌شو طی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 165.94,
   "end": 167.54,
   "text": "اما خدا از رو احتیاج نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.54,
   "end": 169.74,
   "text": "از رو عشق و حب به ذاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 169.74,
   "end": 175.32,
   "text": "خودش و به مخلوقاتش که اثر وجودی خودش هستند که \"لا مؤثر في الوجود إلا الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 175.32,
   "end": 180.0,
   "text": "در هر حال ما دستور گرفته‌ایم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 180.0,
   "end": 183.56,
   "text": "نفس حضرت حق رو تا نفس حضرت حق پیش بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 183.56,
   "end": 185.94,
   "text": "اما از ناحیه چی؟ آثار حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 185.94,
   "end": 188.3,
   "text": "یعنی آیات حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 188.3,
   "end": 191.04,
   "text": "که اثر وجودی حق رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 191.04,
   "end": 193.88,
   "text": "آیه وجودی حق رو، همون ز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 193.88,
   "end": 196.84,
   "text": "مظاهر حق که من و شما یکی از اون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 196.84,
   "end": 199.3,
   "text": "اسماء الله، صفات الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 199.3,
   "end": 205.4,
   "text": "این‌ها رو ببینیم لایه به لایه این حجاب‌های نورانی رو خرق کنیم بنا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 205.4,
   "end": 209.08,
   "text": "تعبیر حضرت امیرالمؤمنین صلوات الله علیه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 209.08,
   "end": 212.5,
   "text": "دعای شعبانیه، مناجات شعبانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 212.5,
   "end": 216.6,
   "text": "خرق حجاب نورانی صورت بگیره بریم به لایه پنهان‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 216.6,
   "end": 221.92,
   "text": "یعنی باطن نه اون ذات غیب الغیوب رو، بلکه پشت پرده ظاهر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 221.92,
   "end": 224.32,
   "text": "اساساً ما الان در دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 224.32,
   "end": 229.16,
   "text": "در نش-- در زیل در سایه اسم ظاهر خدا داریم نفس می‌کشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 229.16,
   "end": 232.76,
   "text": "لذا کسی از باطن دیگری خبر نداره عمدتاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 232.76,
   "end": 236.92,
   "text": "غالباً. مگر اوحدی از اولیاء الله که اونا دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 236.92,
   "end": 240.32,
   "text": "خدا این چنین صلاح دونسته برا به مصالحش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 240.32,
   "end": 249.6,
   "text": "وقتی که نفس ناطقه انصراف داد از بدن و مرگ اتفاق افتاد، ما وارد لایه پها-پنهان‌ترمون میشیم دیگه، باطنی‌ترمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.6,
   "end": 254.58,
   "text": "یعنی میریم از این جسمیت بدن، از این تفاله فارغ میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 254.58,
   "end": 261.12,
   "text": "این تفاله، این جسم برمی‌گرده به نشئه طبیعت، به چرخه طبیعت خاک میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 261.12,
   "end": 264.4,
   "text": "و نفس ناطقه ما میره مجرد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.4,
   "end": 268.08,
   "text": "عاری از ماده میشه. خب ببینید میره به باطن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 268.08,
   "end": 270.5,
   "text": "اگر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 270.5,
   "end": 275.14,
   "text": "محظور شده بودیم و برحذر داشته شده بودیم از اون لایه‌های پ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 275.14,
   "end": 279.94,
   "text": "باطنی‌تر مثل مجردات، مثل باطن عالم، مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.94,
   "end": 282.52,
   "text": "لایه‌های باطنی نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 282.52,
   "end": 287.94,
   "text": "چگونه وقتی که می‌میریم مجرد میشیم و میریم به همون لوایح باطنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 287.94,
   "end": 292.38,
   "text": "چگونه وقتی می‌خوابیم میریم به باطن وجود خودمون در عالم برزخ؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 292.38,
   "end": 299.82,
   "text": "نه، ما از حتی در خصوص خودمون هم از اون نقطه انتهایی اتصالمون به بی‌نهایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.82,
   "end": 304.2,
   "text": "عظمه هستی که نقطه الوهیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 304.2,
   "end": 308.2,
   "text": "دیگه حتی فوق الوهیت وجوده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.2,
   "end": 310.44,
   "text": "از اون نهی شدیم حتی در خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.44,
   "end": 315.36,
   "text": "و الا خب ما باید خیالمونو بشناسیم، وهممونو بشناسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.36,
   "end": 318.0,
   "text": "عقل و قلب و روح و سر و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 318.0,
   "end": 321.4,
   "text": "حالا اون سر و سل یا اخفا رو بله، اونو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 321.4,
   "end": 325.28,
   "text": "بی‌خبر هستیم و خواهیم موند. خب حالا این بلا سر ما اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.28,
   "end": 327.42,
   "text": "نه-- متوجه نشدیم چه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.42,
   "end": 330.28,
   "text": "اولاً این القاءات شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 330.28,
   "end": 333.96,
   "text": "حواسمون باشه و راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 333.96,
   "end": 338.14,
   "text": "این خودش یه نشونه‌ایه، یه آلارمیه از این که راه به حق بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.14,
   "end": 341.48,
   "text": "راهی که داشته می‌رفته عزیزمون به حق بوده و الا این چنین نمیشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.48,
   "end": 344.58,
   "text": "در آیه شونزده سوره اعراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 344.58,
   "end": 348.1,
   "text": "شیطان در محاجش با خدا بی‌ادبی می‌کنه میگه \"قال\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.1,
   "end": 352.38,
   "text": "گفت \"فبما اغویتنی\" خدایا حالا که منو اغوا کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 352.38,
   "end": 354.62,
   "text": "اینو دقت کنید خیلی نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 354.62,
   "end": 359.12,
   "text": "کلیدی‌ایه. می‌فرماید \"لأقعدن لهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 359.12,
   "end": 361.48,
   "text": "من به اینا کمین می‌زنم به بندگانت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 361.48,
   "end": 366.08,
   "text": "کی؟ \"صراطک المستقيم\" وقتی اینا در صراط مستقیم تو هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 366.08,
   "end": 369.43,
   "text": "\"صراطک المستقيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 369.43,
   "end": 374.55,
   "text": "بر خلاف این‌هایی که فکر می‌کنند وقتی تو راه خدا قرار گرفتن، آمدن هیئت، مسجد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 374.55,
   "end": 378.25,
   "text": "تو وادی دین و ولایت و این‌ها دیگه شیطان هیچ کاری با این‌ها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.25,
   "end": 382.01,
   "text": "اصلا اینطوری نیست. اتفاقا اصلا میاد سراغ امثال ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 382.01,
   "end": 388.53,
   "text": "و هرچه وجاهت معنوی و مذهبی و علمی ما بیشتر شد، بیشتر کمین می‌خوریم از شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 388.53,
   "end": 393.01,
   "text": "اینه که بین می‌بینید گروه‌های غیرمذهبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 393.01,
   "end": 397.69,
   "text": "اونوری‌ها حالا به قولی، اون‌ورآبی‌ها هرچی، می‌بینی کمتر مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 397.69,
   "end": 402.17,
   "text": "یه سری گناه‌ها دیده می‌شه. مثلاً غیبت کردن، دروغ گفتن چه می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 402.17,
   "end": 404.59,
   "text": "این‌ها به‌خاطر اینه که اصلا شیطان کاری با این‌ها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 404.59,
   "end": 407.37,
   "text": "این‌ها راهشون باطله اصلاً شیطان رهاشون کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 407.37,
   "end": 411.55,
   "text": "این اصل قرآنه. در سایه شون--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 411.55,
   "end": 415.87,
   "text": "در surه اعراف که عرض شد. پس حالا که شیطان اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 415.87,
   "end": 418.33,
   "text": "و ما رو دچار وسوسه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 418.33,
   "end": 420.91,
   "text": "خب وقت وسوسه چه باید کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 420.91,
   "end": 426.65,
   "text": "فرمودن که فاستعذ بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 426.65,
   "end": 430.03,
   "text": "پناه ببر به خدا من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 430.03,
   "end": 434.03,
   "text": "پناه بردن به خدا. پناه بردن به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 434.03,
   "end": 440.35,
   "text": "راهش اینه که اولاً اون اشتباهی که از قبل مرتکب شدیم رو دیگه تکرار نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 440.35,
   "end": 445.79,
   "text": "ثانیاً اینکه ما سعی کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 445.79,
   "end": 449.25,
   "text": "در حقیقت با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 449.25,
   "end": 456.41,
   "text": "عدم برگشت به اون حالت حالا هرچی بود مثل تم-- مثلاً توجه به ذات حضرت حق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 456.41,
   "end": 460.71,
   "text": "اینکه ما یک جزئیم و نمی‌تونیم هیچ‌وقت کل رو بفهمیم و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 460.71,
   "end": 465.19,
   "text": "بریم سراغ مشغول کردن نفسمون به خوبی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.19,
   "end": 467.61,
   "text": "اینو خوب دقت کن این نکته آخر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 467.61,
   "end": 470.41,
   "text": "که البته خودش یه بابی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 470.41,
   "end": 474.93,
   "text": "نفس رو اگر مشغول نکنی، نفس به شدت تو رو مشغول می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 474.93,
   "end": 477.89,
   "text": "اصلاً نفس نمی‌تونه بیکار بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 477.89,
   "end": 483.11,
   "text": "قوه خیال اگر تو مشغولش نکنی به حقایق، تو رو به بازیگری می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 483.11,
   "end": 486.41,
   "text": "به شدت تو رو مشغول می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 486.41,
   "end": 490.51,
   "text": "لذا تمام بزرگان بدون استثناء سفارش‌شون اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 490.51,
   "end": 494.09,
   "text": "تا می‌تونید نفستون رو مشغول کنید به حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 494.09,
   "end": 497.53,
   "text": "تا می‌تونید-- چرا اینقدر قرآن به سیر فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 497.53,
   "end": 502.63,
   "text": "توصیه می‌کنه؟ قضای عقلی برداشتن از سفره نظام هستی، از کلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.63,
   "end": 508.27,
   "text": "وجودی نظام هستی، توجه به آثار حق به آیات الهی در زمین و آسمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 508.27,
   "end": 515.33,
   "text": "اینقدر توصیه می‌کنه إن في خلق السماوات والأرض واختلاف الليل والنهار لآيات لأولي الألباب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.33,
   "end": 517.25,
   "text": "چرا؟ چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.25,
   "end": 519.55,
   "text": "فکر-- دائماً این سفره پهنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.55,
   "end": 527.47,
   "text": "هیچ‌وقت شما از تلقی این کلمات وجودی که آیات حضرت حق هستند نه ممنوع شدی، نه ازشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 527.47,
   "end": 530.19,
   "text": "دور هستی و بدون دسترسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.19,
   "end": 533.75,
   "text": "بغل خودتن. خودتن یکی از این کلمات وجودی هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 533.75,
   "end": 537.19,
   "text": "لذا دائما درگیر کار فکری رو این‌هایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.19,
   "end": 539.61,
   "text": "توجه و تعقل به این‌هایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 539.61,
   "end": 542.13,
   "text": "وقتی دائما مشغول سفره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 542.13,
   "end": 544.17,
   "text": "قضای عقلی برداشتن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.17,
   "end": 547.01,
   "text": "کلمات وجودی نظام هستی هستی در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 547.01,
   "end": 555.87,
   "text": "در اون سه کتاب، کتاب آفاقی، زمین و آسمان و موجودات نظام هستی و کف-کتاب انفسی، سیر معرفت نفس و شناخت خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.87,
   "end": 559.37,
   "text": "یا شناخت حجت الله که نفس کلی الهی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 559.37,
   "end": 562.09,
   "text": "و کتاب سوم همین کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 562.09,
   "end": 564.79,
   "text": "تدوینی نظام هستی یعنی قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.79,
   "end": 568.61,
   "text": "وقتی مشغول این‌ها شدی دیگه اصلاً فرصت نمی‌کنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 568.61,
   "end": 570.97,
   "text": "وقت به نفست بدی که تو رو مشغول کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 570.97,
   "end": 575.87,
   "text": "تو اون رو مشغول کردی. دائما برای خودت باید برنامه داشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 575.87,
   "end": 579.63,
   "text": "به اهل بیت علیهم الصلاة والسلام توسل کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 579.63,
   "end": 582.15,
   "text": "توجه کنی، به زیارتشون بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 582.15,
   "end": 584.53,
   "text": "بله البته باید دور و برتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 584.53,
   "end": 587.29,
   "text": "شلوغ کنی از این حقایق تا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 587.29,
   "end": 591.19,
   "text": "کتاب بخونی، اصلاً بیکار نباشی، تا می‌تونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 591.19,
   "end": 594.57,
   "text": "فکرتو معطوف کنی به سمت این حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 594.57,
   "end": 597.85,
   "text": "دوستان خوب داشته باشی، خوش فکر داشته باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 597.85,
   "end": 606.37,
   "text": "پای درس اساتید بری، اهل عبادت و بندگی و خلوت باشی تا انشاالله این حقیقت دوباره برگرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 606.37,
   "end": 611.11,
   "text": "و دوباره اونچه که گمش کردیم رو پیداش کنیم که ما گم شده‌مون خودمون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.11,
   "end": 619.41,
   "text": "باید خودمون رو پیدا کنیم. انشاالله که خدای منان ما را از شر شیاطین در امان بدارد در باطن و در ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 619.41,
   "end": 621.27,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}