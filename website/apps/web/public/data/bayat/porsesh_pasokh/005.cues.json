 "chapters": [
  {
   "index": 0,
   "title": "## پرسش از جمعِ آیاتِ ورود به جهنّم",
   "start": 0.92,
   "end": 75.82
  },
  {
   "index": 1,
   "title": "## عبورِ مؤمن و نزولِ کافر",
   "start": 75.82,
   "end": 165.78
  },
  {
   "index": 2,
   "title": "## اسماءِ جلالیّه در قوسِ صعود",
   "start": 165.78,
   "end": 251.3
  },
  {
   "index": 3,
   "title": "## وحدتِ باطنِ نار و نور؛ تمثیلِ آب",
   "start": 251.3,
   "end": 379.08
  },
  {
   "index": 4,
   "title": "## اصلِ عطایا بر قدرِ قابلیّات",
   "start": 379.08,
   "end": 445.94
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.92,
   "end": 4.08,
   "text": "بسم الله و بالله و علی ملت رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.08,
   "end": 8.68,
   "text": "المستغاث بکه یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.68,
   "end": 13.02,
   "text": "پرسیدن که با توجه به اینکه شما گفتید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.02,
   "end": 19.88,
   "text": "قرآن می‌فرماید من هم الله واردها هیچ کس نیست مگر اینکه وارد جهنم می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.88,
   "end": 23.96,
   "text": "خب این رو چگونه میشه با این دو تا آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.96,
   "end": 27.62,
   "text": "صد و صد و دو سوره کهف جمع کرد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.62,
   "end": 33.96,
   "text": "اونجا خدا می‌فرمود و عرب نا جهنم يوم اذن للكافرين عربا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.96,
   "end": 36.36,
   "text": "ما جهنم رو تو اون روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.36,
   "end": 38.8,
   "text": "عرضه میدیم، عرضه می‌کنیم بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.8,
   "end": 42.2,
   "text": "کافرین. چه عرضه شدنی!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.2,
   "end": 48.02,
   "text": "و همچنین آیه صد و دو که انا اعددنا جهنم للكافرين نزلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.02,
   "end": 51.94,
   "text": "اون جهنمی که ما آماده کردیم برای کافرین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.94,
   "end": 54.64,
   "text": "کافرین در اون نازل می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.64,
   "end": 57.2,
   "text": "خب این مثل این می‌مونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.2,
   "end": 62.6,
   "text": "وقتی می‌گذاریم کنار اون آیه ان منهم لواردها هیچ کس نیست مگر اینکه وارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.6,
   "end": 67.18,
   "text": "جهنم می‌شود. مثل این می‌مونه که بگیم چون که صد آیه نود هم پیش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.18,
   "end": 71.2,
   "text": "پیش ماست. وقتی همه قراره ورود به جهنم کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.2,
   "end": 73.6,
   "text": "مؤمن و کافر وارد میشن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.6,
   "end": 80.66,
   "text": "این یه نکته. نکته‌ی بعد این که مؤمن وارد به جهنم می‌شود اما عبور می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.66,
   "end": 84.16,
   "text": "در حقیقت احاطه به جهنم پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.16,
   "end": 88.64,
   "text": "یعنی محیط بر حقیقت جهنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.64,
   "end": 91.72,
   "text": "می‌شود و جهنم بر او محاط می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.72,
   "end": 94.64,
   "text": "جهنم بر مؤمن احاطه ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.64,
   "end": 98.68,
   "text": "اما کافر وقتی که وارد شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.68,
   "end": 101.6,
   "text": "چون جهنم بر او عرضه می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.6,
   "end": 104.46,
   "text": "او نازل در همین حقیقت می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.46,
   "end": 107.42,
   "text": "چرا نازل می‌شود؟ چرا عبور نمی‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.42,
   "end": 113.5,
   "text": "بلکه محاط بر جهنم می‌شود و جهنم محیط بر او؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.5,
   "end": 116.62,
   "text": "به جهت اینکه وجود خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.62,
   "end": 118.78,
   "text": "کافر خودش شده جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.78,
   "end": 125.58,
   "text": "همون بحث شیرینی که حضرت علامه در هزار و یک نکته دارن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.58,
   "end": 129.1,
   "text": "کافر یا جهنمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.1,
   "end": 134.46,
   "text": "خدا جهنمی رو به جهنم نمی‌بره بلکه جهنمی خودش جهنم می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.46,
   "end": 139.0,
   "text": "یا به عبارت دیگر مؤمن رو خدا به بهشت نمی‌بره بلکه مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.0,
   "end": 142.0,
   "text": "خودش بهشت می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.0,
   "end": 145.96,
   "text": "در حقیقت اون سیرورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.96,
   "end": 151.0,
   "text": "ساره. این سیرورت با صاد که شدن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.0,
   "end": 155.18,
   "text": "در همین نشئه، در همین نشئه طبیعت در قوس صعود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.18,
   "end": 160.86,
   "text": "خود شخص یا جهنم می‌شود یا بهشت می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.86,
   "end": 164.62,
   "text": "اگر جهنم بشود یعنی بس-- چون همه به سمت خدااند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.62,
   "end": 169.78,
   "text": "انا لله از قوس نزول از خدا اومدیم و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.78,
   "end": 171.98,
   "text": "قوس صعود هم به سمت خدا میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.98,
   "end": 174.46,
   "text": "چون این چنین است همه دارن به سمت خدا میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.46,
   "end": 178.32,
   "text": "خب جهنمی هم به سمت خدا می‌رود اما به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.32,
   "end": 181.34,
   "text": "اسماء جلالیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.34,
   "end": 183.64,
   "text": "فعلیه حضرت حق می‌رود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.64,
   "end": 186.58,
   "text": "یعنی شدید العقاب، ذو انتقام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 186.58,
   "end": 189.82,
   "text": "این‌ها اسماء ذاتی خدا نیستند که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.82,
   "end": 194.06,
   "text": "این‌ها اسماء فعلیه و جلالیه حضرت حق هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.06,
   "end": 198.08,
   "text": "در حقیقت این‌ها نسبت به اعمال ما ظهور می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.08,
   "end": 201.1,
   "text": "نه اینکه در ذات است. در ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.1,
   "end": 204.06,
   "text": "جز رأفت و مهربانی و عطوفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.06,
   "end": 206.96,
   "text": "الرحمن و الرحیم چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.96,
   "end": 210.5,
   "text": "خب پس خود طرف این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 210.5,
   "end": 216.0,
   "text": "در حقیقت آمادگی رو پیدا می‌کند در خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 216.0,
   "end": 219.06,
   "text": "که به سمت اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.06,
   "end": 221.8,
   "text": "فعلیه جلالیه حضرت حق برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 221.8,
   "end": 225.72,
   "text": "به سمت اسم قهاریت حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 225.72,
   "end": 230.7,
   "text": "ذو انتقام حضرت حق، شدید العقاب حضرت حق برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.7,
   "end": 233.66,
   "text": "و اونجا این اسماء بر او احاطه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.66,
   "end": 240.02,
   "text": "در جهنم در حقیقت اتحاد وجودی بین کافر و جهنم برقرار می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.02,
   "end": 244.24,
   "text": "اما مؤمن این چنین نیست. مؤمن رد می‌شود که ما قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.24,
   "end": 249.58,
   "text": "باز یه پله بالاتر عرض کردیم از کلام علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.58,
   "end": 254.52,
   "text": "که اساساً از جهت حقیقت بخواهید بحث کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.52,
   "end": 258.1,
   "text": "اون باطن این حقایق یک حقیقت بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.1,
   "end": 262.32,
   "text": "یعنی جهنم و بهشت یک حقیقت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.32,
   "end": 266.02,
   "text": "وقتی به اون کنه و باطن که پی می‌بری می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.02,
   "end": 268.5,
   "text": "نار و نور یک حقیقت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.5,
   "end": 271.54,
   "text": "مثل آب که یک حقیقت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.54,
   "end": 275.7,
   "text": "اما نسبت به قابلیت‌ها ظهور می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 275.7,
   "end": 278.54,
   "text": "ما عرض کردیم که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.54,
   "end": 281.92,
   "text": "آب رو وقتی زنبور عسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 281.92,
   "end": 286.62,
   "text": "نوش جان می‌کنه چون قابلیتش قابلیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.62,
   "end": 289.94,
   "text": "نوشیست می‌شود عسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.94,
   "end": 295.4,
   "text": "نوش می‌شود. همون آب در وجود زنبور عسل می‌شود نوش، عسل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.4,
   "end": 298.8,
   "text": "اما قابلیت زنبور وحشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 298.8,
   "end": 304.18,
   "text": "چون نیشیست همین آب چون قابلیت این زنبور این چنین است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.18,
   "end": 309.56,
   "text": "همین آب در وجود او که می‌رود می‌شود نیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.56,
   "end": 316.54,
   "text": "در حقیقت یک، یک باطن بود، یک حقیقت بود، یک چیز بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.54,
   "end": 319.08,
   "text": "اما در دو چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.08,
   "end": 322.46,
   "text": "نسبت به قابلیت‌هاشون این چنین بروز کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 322.46,
   "end": 328.1,
   "text": "پس نار و نور هم اگر حکما میگن یک حقیقت دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.1,
   "end": 331.6,
   "text": "همینه. نسبت به قابلیت‌ها بروز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.6,
   "end": 333.42,
   "text": "هر کسی وارد جهنم می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.42,
   "end": 340.5,
   "text": "بله آیه قرآنه. اما نسبت به قابلیتی که دارند اون جهنم براشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.5,
   "end": 345.1,
   "text": "در حقیقت نسبت به قابلیت‌شون عرضه می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.1,
   "end": 347.68,
   "text": "در حقیقت برای کافر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.68,
   "end": 353.72,
   "text": "جهنم، جهنم عرضه می‌شود لذا در اون نازل می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.72,
   "end": 363.1,
   "text": "اما نسبت به مؤمن اون حالا میخوای بگی جهنم، میخوای بگی نار، میخوای بگی نور، هرچی که هست، اون حقیقت کلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.1,
   "end": 367.66,
   "text": "برای مؤمن کسی که ولایت مولا را پذیرفته عزیزم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.66,
   "end": 370.02,
   "text": "اینجا به صورت نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 370.02,
   "end": 377.98,
   "text": "تجلی می‌کند. یعنی مطابق به این قابلیت که این اصل کلی شیرین و عالی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.98,
   "end": 381.82,
   "text": "عرض شده قبلاً که شیخ اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.82,
   "end": 385.68,
   "text": "در کتاب فصوص الحکم‌شون اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.68,
   "end": 388.7,
   "text": "در فش-- فصل شیسی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 388.7,
   "end": 391.82,
   "text": "شیصی هم بعضیا قرائت کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.82,
   "end": 395.56,
   "text": "فرزند حضرت آدم. اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.56,
   "end": 399.76,
   "text": "که بعد از شهادت حضرت حابیل از خدا به ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.76,
   "end": 402.56,
   "text": "اعطا شد این فرزند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.56,
   "end": 406.54,
   "text": "این فرزند عزیز به جهت سوز دل حضرت آدم در فراق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.54,
   "end": 409.04,
   "text": "حابیل اما بدون گلایه از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.04,
   "end": 413.14,
   "text": "این قابلیت در حضرت آدم ایجاد شد که این بزرگوار رو خدا بهش هبه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 413.14,
   "end": 417.32,
   "text": "لذا بهش هبه الله هم گفتن به حضرت شیس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.32,
   "end": 420.22,
   "text": "و اونجا این اصل رو القا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 420.22,
   "end": 427.42,
   "text": "محی-- حضرت محی الدین علیه رحمة که ان الاعطیات على قدر القابليات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 427.42,
   "end": 429.96,
   "text": "بعضی جاها هم گفتن ان الاعطیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.96,
   "end": 433.4,
   "text": "بقدر قابلیات. هر دوش یه معنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.4,
   "end": 438.86,
   "text": "در حقیقت اون عطایای الهی نسبت به قابلیت‌ها ظهور و بروز دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 438.86,
   "end": 441.56,
   "text": "می‌خوام عرض کنم که این‌ها با هم منافاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 441.56,
   "end": 444.02,
   "text": "ندارن. ان شا الله که موفق باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.02,
   "end": 445.94,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}