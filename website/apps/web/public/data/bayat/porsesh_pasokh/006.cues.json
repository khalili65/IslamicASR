 "chapters": [
  {
   "index": 0,
   "title": "## الناس نیام",
   "start": 46.06,
   "end": 136.76
  },
  {
   "index": 1,
   "title": "## درجات بهشت و ظهور علم",
   "start": 136.76,
   "end": 369.97
  },
  {
   "index": 2,
   "title": "## گسترش مطلب 006/2",
   "start": 369.97,
   "end": 733.73
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 4.08,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.08,
   "end": 8.7,
   "text": "المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.7,
   "end": 12.7,
   "text": "در ادامه سوالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.7,
   "end": 16.74,
   "text": "عزیزی پرسیده بودند در خصوص به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.74,
   "end": 23.28,
   "text": "هر حال این که انسان بعد از مرگ بیدار می‌شوند و اینها و اشاره کرده بودند که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.28,
   "end": 30.68,
   "text": "مشارکت کنیم در عزیزی که تجربیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.68,
   "end": 32.54,
   "text": "کسانی رو دارند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.54,
   "end": 40.3,
   "text": "مثلاً حالا یا در کما یا واقعاً وارد اون عالم برزخ شدند و برگشتند و تجربیاتشون خیلی مطابق با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.3,
   "end": 43.24,
   "text": "بحث‌های حکمی و عرفانی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.24,
   "end": 48.24,
   "text": "بله حدیث هم داریم حدیث نبوی که الناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.24,
   "end": 54.82,
   "text": "نیامون، الف و لام سر الناس که آمده یعنی تمام مردم خواب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.82,
   "end": 59.78,
   "text": "اذا ماتوا انتبهوا وقتی که می‌میرند تازه بیدار می‌شوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.78,
   "end": 64.98,
   "text": "و در حقیقت آنچه که در این نشئه طبیعت بهشون گذشته به منزله‌ی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.98,
   "end": 70.34,
   "text": "تعبیر خوابی است که بعد از بیدار شدنشون از مرگ به بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 70.34,
   "end": 76.12,
   "text": "این باید عبور کنند از همین خواب‌هایی که دیدند تا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.12,
   "end": 78.68,
   "text": "عبرت برسند تا به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.68,
   "end": 81.26,
   "text": "محل عبور واقعی برسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.26,
   "end": 90.36,
   "text": "یعنی آنچه که در بعد از مرگ برای انسان‌ها رخ می‌دهد تعبیر خواب این دنیوی‌شون است چون در این دنیا همه خواب‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 90.36,
   "end": 94.44,
   "text": "بیدار که می‌شوند لحظه‌ی مرگشون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.44,
   "end": 103.16,
   "text": "تعبیر آنچه که در خواب دیده‌اند یعنی در عالم طبیعت نشئه طبیعت براشون گذشته همون براشون اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 103.16,
   "end": 109.52,
   "text": "که حالا باید دید که این تعابیر در حقیقت این رویاها، این دیدن‌ها، اینا صادقه است یا کاذبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 109.52,
   "end": 111.94,
   "text": "یا شیطانی است یا رحمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 111.94,
   "end": 118.64,
   "text": "که حالا فرمودند که در تجربیاتشون داشتن خانمی رو که مثلاً وارد به اون عالم شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 118.64,
   "end": 121.48,
   "text": "به جهت حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 121.48,
   "end": 129.0,
   "text": "عنایت‌هایی که از طایفه عبدالله سلام الله عليه بهشون داشتند چیزهایی بهشون نشان داده بودند و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 129.0,
   "end": 131.5,
   "text": "از حیث حقایق و معارف عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 131.5,
   "end": 135.68,
   "text": "اما چون این خانم شناختی از این معارف نداشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 135.68,
   "end": 139.9,
   "text": "همش می‌گفته که دلم می‌خواد یه کسی باشه اینا رو برای من باز کنه و توضیح بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 139.9,
   "end": 144.1,
   "text": "بله این همون بحثی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 144.1,
   "end": 147.56,
   "text": "در حقیقت هم سید بحر العلوم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 147.56,
   "end": 152.42,
   "text": "رساله لب اللبابشون در سیر و سلوک آوردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 152.42,
   "end": 155.44,
   "text": "به یه نحو دیگه سید ابن طاووس آوردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 155.44,
   "end": 162.44,
   "text": "چگونه؟ این که در ذیل آیه \"عند ربهم يرزقون\" اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 162.44,
   "end": 164.84,
   "text": "می‌فرماید البته خب اینو صرفاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 164.84,
   "end": 169.7,
   "text": "شهدا نباید گرفت دیگه چون فعل مجهول قتل اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 169.7,
   "end": 174.26,
   "text": "می‌فرمود که \"ولا تحسبن الذين قتلوا.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 174.26,
   "end": 176.7,
   "text": "قتلوا فعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 176.7,
   "end": 181.86,
   "text": "مجهوله. یعنی نپندارید کسانی که کشته شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 181.86,
   "end": 189.38,
   "text": "خب اینا رو کی کشت؟ اگر بخواید برید تو وادی جبهه و جهاد و اینا بله این شهدای متعارف هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 189.38,
   "end": 191.04,
   "text": "که کشته شدند به دست دشمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 191.04,
   "end": 194.84,
   "text": "اما برید تو وادی عرفان موت قبلان تموتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 194.84,
   "end": 196.6,
   "text": "خودشون خودشان رو کشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 196.6,
   "end": 199.56,
   "text": "خودشون هواهای نفسشون رو کشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 199.56,
   "end": 202.18,
   "text": "به هر حال فعل مجهول اینجا خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 202.18,
   "end": 204.78,
   "text": "زیبا خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.78,
   "end": 209.14,
   "text": "که قتلوا \"ولا تحسبن الذين قتلوا في سبيل الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 209.14,
   "end": 213.44,
   "text": "البته در راه خدا اینها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 213.44,
   "end": 216.64,
   "text": "امواتا، مرده نپندارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 216.64,
   "end": 221.22,
   "text": "بل احیا بلک اینا زنده‌اند \"عند ربهم يرزقون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.22,
   "end": 226.44,
   "text": "دوباره يرزقون هم باز جالبه که چه شیرین که این هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 226.44,
   "end": 229.28,
   "text": "مجهول آمده است. روزی می‌خورند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 229.28,
   "end": 236.2,
   "text": "حالا پیش کی؟ نزدیک خب عندالله هست اما روزیشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 236.2,
   "end": 239.88,
   "text": "اینجا بر اساس روایاتی که وارد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 239.88,
   "end": 246.74,
   "text": "بزرگان مثل سید بحر العلوم و سید ابن طاووس فرمودند این رزق علم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 246.74,
   "end": 250.02,
   "text": "حکمت است. معارف الهیه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 250.02,
   "end": 253.28,
   "text": "که اساساً فلسفه بعثت انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 253.28,
   "end": 258.34,
   "text": "همینه دیگه. \"هو الذي بعث في الاميين رسولا منهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 258.34,
   "end": 262.16,
   "text": "برای چی این پیغمبر مبعوث شده از میان امییین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 262.16,
   "end": 266.46,
   "text": "\"يتلو عليهم آياته\" این آیات الهی رو تلاوت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 266.46,
   "end": 269.02,
   "text": "خب حالا این آیات رو تلاوت کنه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 269.02,
   "end": 272.14,
   "text": "که \"يزكيهم\". ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 272.14,
   "end": 276.84,
   "text": "\"يتلو عليهم آياته و يزكيهم\" همون طهارت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 276.84,
   "end": 279.88,
   "text": "\"ويعلمهم الكتاب والحكمة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 279.88,
   "end": 282.14,
   "text": "حكمة. کتاب و حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.14,
   "end": 286.86,
   "text": "می‌گه این‌ها رو تعلیم ببینند که همون فرمایش علامه است که دو تا کار شما دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.86,
   "end": 289.68,
   "text": "در حقیقت ادب و طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.68,
   "end": 293.18,
   "text": "ادب‌آموزی و طهارت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.18,
   "end": 295.3,
   "text": "که این دو انسان رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.3,
   "end": 297.56,
   "text": "تعالی می‌رسونه و رشد می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.56,
   "end": 301.84,
   "text": "حالا بحث اینجاست که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.84,
   "end": 304.38,
   "text": "رزق اگر معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.38,
   "end": 307.82,
   "text": "عالیه هست پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.82,
   "end": 314.96,
   "text": "تطبیق می‌کنه با اون حدیثی که یادمه در کتاب اصول کافی مرحوم کلینی اعلا مقامه الشریف دیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.96,
   "end": 319.32,
   "text": "امام صادق سلام الله عليه فرمود وقتی مؤمن از دنیا می‌رود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.32,
   "end": 325.24,
   "text": "ملکی یا ملائکه‌ای مأمور می‌شوند که نسبت به صعه وجودی او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.24,
   "end": 327.72,
   "text": "بهش تعلیم بدن حقایق عالم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.72,
   "end": 332.82,
   "text": "اساساً وقت مرگ تمام کار اون ور ما می‌‌شود تعلیم دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 332.82,
   "end": 335.8,
   "text": "و اگر بی‌طهارتي رخ داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 335.8,
   "end": 342.98,
   "text": "چون نظام عالم بر اساس طهارت محض است و هیچ بی‌طهارتي در کنع و تکوین نظام هستی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 342.98,
   "end": 345.06,
   "text": "اون سختی‌های برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 345.06,
   "end": 351.36,
   "text": "و پس از مرگ همه تعبی-- حالا تعبیر می‌شه به عذاب برزخی یا جهنمی هرچی که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.36,
   "end": 354.7,
   "text": "اون‌ها جهت برگرداندن وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 354.7,
   "end": 362.14,
   "text": "به طهارت است. مثل طلایی که در بوته می‌گذارند و داخل کوره می‌سوزانند تا ناخالصی‌هاش برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 362.14,
   "end": 364.32,
   "text": "باز هم برگشت به طهارت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 364.32,
   "end": 368.75,
   "text": "چون \"لا یمس fire النظره المتحرون.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.75,
   "end": 371.77,
   "text": "حالا اینجا دو تا نکته پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.77,
   "end": 378.51,
   "text": "یکی اینکه اگر کسی دنبال این حقایق و معارف نرفته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 378.51,
   "end": 386.09,
   "text": "مرحوم حاجی سبزواری علیه الرحمه که اگر اشتباه نکنم در کتاب اسرارالحکم‌شون این نکته رو می‌فرماین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 386.09,
   "end": 395.83,
   "text": "که کسی که کار عقلی نکرده با دیده عقل و عبرت و تأمل و تفکر و تدبر به آیات نظام هستی، به این کلمات وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 395.83,
   "end": 401.47,
   "text": "دقت نداشته، چنین کسی چون جانش ضعیفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 401.47,
   "end": 404.43,
   "text": "اون سمت اولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 404.43,
   "end": 407.65,
   "text": "حرکتش و رشدش کنده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 407.65,
   "end": 413.59,
   "text": "ثانیاً خیلی باید زحمت بکشه، خیلی باید معذب بشه، خیلی اذیت بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 413.59,
   "end": 416.67,
   "text": "تا بتونه مثلاً یه درجه اضافه کنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 416.67,
   "end": 420.27,
   "text": "درجات وجودیش و رتبه های وجودیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 420.27,
   "end": 428.45,
   "text": "و چقدر باید از پایه مثل کسی که هیچ سوادی نداره، چقدر سخته که بهش یاد بدی سواد رو مخصوصاً اگه سنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 428.45,
   "end": 434.55,
   "text": "ازش گذشته باشه. این چنینه نسبت به سعه وجودیش تعلیم صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 434.55,
   "end": 439.09,
   "text": "اما اگر کسی کار عقلی کرده یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 439.09,
   "end": 442.89,
   "text": "وارد به حوزه عقلش شده و دسترسی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 442.89,
   "end": 445.51,
   "text": "قلبش با عبور از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 445.51,
   "end": 451.05,
   "text": "عقل یا به وساطت عقل به قلب وجودیش که همون عرش الرحمن است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 451.05,
   "end": 454.09,
   "text": "قلب مؤمن، قلب المؤمن عرش الرحمن است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 454.09,
   "end": 460.89,
   "text": "دسترسی پیدا کرده. چنین کسی و در حقیقت با آیات نظام هستی توجه کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 460.89,
   "end": 465.91,
   "text": "و با سیر حکمی و عرفان نظری به عمل افتاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 465.91,
   "end": 468.43,
   "text": "و، و اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 468.43,
   "end": 473.45,
   "text": "پنهان در موجودات رو یافته که به همون بهش می‌گن فلسفه یا حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 473.45,
   "end": 476.71,
   "text": "یعنی علم به اعیان موجودات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 476.71,
   "end": 480.23,
   "text": "اون چون، اونطور که هستند، آنچنان که هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 480.23,
   "end": 483.51,
   "text": "اللهم ارنا الاشیاء کما هي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 483.51,
   "end": 487.57,
   "text": "این آنچه که هستند رو ببیند یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 487.57,
   "end": 490.53,
   "text": "عبور از عقل به قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 490.53,
   "end": 494.91,
   "text": "وساطت عقل برای رسیدن به قلب یعنی باطن ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 494.91,
   "end": 498.07,
   "text": "ظاهر رو می‌بیند که به باطنش پی ببرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 498.07,
   "end": 502.67,
   "text": "ببرد. این ظاهر عبور از ظاهر کار عقله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 502.67,
   "end": 509.99,
   "text": "که انسان رو عبور بدهد برساند به باطن که همون کار قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 509.99,
   "end": 519.71,
   "text": "حالا می‌خوایم عرض کنیم که خب اگر کسی جانش ضعیف بود نمی‌تونه به اون درجات عالیه بهشت برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 519.71,
   "end": 524.25,
   "text": "اما اگر چه، کسی جانش قوی بود یعنی کار عقلی کرده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 524.25,
   "end": 528.79,
   "text": "و اونطور که قرآن سفارش کرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 528.79,
   "end": 531.55,
   "text": "برداشتن لقمه‌های عقلی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 531.55,
   "end": 537.07,
   "text": "نظام وجود عمل کرده، چنین کسی به قول حاجی سبزواری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 537.07,
   "end": 539.65,
   "text": "می‌تونه چنان بالا بره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 539.65,
   "end": 543.85,
   "text": "دیگه به بهشت ذات برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 543.85,
   "end": 548.25,
   "text": "این بهشت من. حالا این بهشت ذات که می‌گیم بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 548.25,
   "end": 551.99,
   "text": "متعارف این‌هایی که خیلی کار عقلی نکردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 551.99,
   "end": 554.71,
   "text": "سریع میگن یعنی مثلاً استغفرالله بشه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 554.71,
   "end": 559.43,
   "text": "نه. بهشتی که خدا این بهشت رو به خودش منتسب کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 559.43,
   "end": 561.13,
   "text": "از این جهت می‌گیم بهشت ذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 561.13,
   "end": 570.63,
   "text": "خود خدا فرموده دیگه عبادی، بندگان من، جنتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 570.63,
   "end": 574.93,
   "text": "بهشت من. در جای دیگه می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 574.93,
   "end": 583.91,
   "text": "اون بهشتی که وعده داده شده به مثلاً اهل تقوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 583.91,
   "end": 594.47,
   "text": "این چنین است. مثلاً توش نهرها هست، انهار هست، قصور هست، حورالعین هست، سیب گلابی هست و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 594.47,
   "end": 604.91,
   "text": "مثل همون بهشتی که اول حضرت آدم و حضرت حوا تشریف داشتند که اونجا خدا بهشون فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 604.91,
   "end": 616.25,
   "text": "وقتی که ما به آدم گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 616.25,
   "end": 619.73,
   "text": "هرچی می‌خواید بخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 619.73,
   "end": 622.73,
   "text": "این بهشت، بهشت خوردن و خوابیدن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 622.73,
   "end": 626.21,
   "text": "خب این‌ها همه این در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 626.21,
   "end": 631.11,
   "text": "رتبه‌ها، این مرتبه‌ها بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 631.11,
   "end": 637.13,
   "text": "در حقیقت اون سیری‌ست که انسان کرده از نقص به کمال رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 637.13,
   "end": 640.79,
   "text": "و ارتقاء وجودی پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 640.79,
   "end": 646.89,
   "text": "و الا اینطوری نیستش که همه قرار باشه برن تو یه رتبه و یک منزلت که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 646.89,
   "end": 650.23,
   "text": "پس اینی که این سؤال کننده عزیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 650.23,
   "end": 654.07,
   "text": "گفتن که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 654.07,
   "end": 658.35,
   "text": "در تجربیات کسانی که از این دنیا رفتن این معارف وجود داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 658.35,
   "end": 664.55,
   "text": "همین معارفی که ما اسمشو می‌گذاریم حکمت، فلسفه، عرفان، همینا رو قراره بعد از مرگ همه بچشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 664.55,
   "end": 669.23,
   "text": "اساساً فلسفه ظهور امام عصر هم همونطور که قبلاً عرض شده عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 669.23,
   "end": 672.83,
   "text": "ظهور، در حقیقت ظهور علم حضرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 672.83,
   "end": 675.53,
   "text": "بروز علم حضرته. همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 675.53,
   "end": 683.05,
   "text": "معارف حق است که اساساً به قول علامه عالم، علم انباشته شده روی هم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 683.05,
   "end": 685.35,
   "text": "و به هر حال علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 685.35,
   "end": 687.43,
   "text": "صفت ذاتی حضرت حق بوده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 687.43,
   "end": 691.83,
   "text": "بدل به اسم شده که ما بتونیم بخوانیمش، شده علیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 691.83,
   "end": 697.35,
   "text": "یعنی خدا مگر صفات عین ذات حضرت حق نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 697.35,
   "end": 700.83,
   "text": "علم عین ذات حضرت حق है。",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 700.83,
   "end": 704.85,
   "text": "یعنی تمام عالم شئونات و بروز حضرت حقند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 704.85,
   "end": 708.67,
   "text": "چیزی جز این نیستند. همون وجود کلی و سمدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 708.67,
   "end": 711.43,
   "text": "توحید سمدی قرآنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 711.43,
   "end": 713.37,
   "text": "بله قراره این‌ها رو ما تجربه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 713.37,
   "end": 717.89,
   "text": "ولی چه خوش که کسی قبل از مرگ اینا رو تجربه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 717.89,
   "end": 720.45,
   "text": "هواهای نفسش رو بکشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 720.45,
   "end": 723.01,
   "text": "تا از همین دنیا عبور کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 723.01,
   "end": 726.45,
   "text": "به باطن عالم که همون برزخ است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 726.45,
   "end": 730.01,
   "text": "و عالم عقل و عالم الهه است برسد.",
   "kind": "speech",
