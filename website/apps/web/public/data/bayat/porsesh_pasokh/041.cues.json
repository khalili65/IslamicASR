 "chapters": [
  {
   "index": 0,
   "title": "## پرسش از ترس هنگام چشیدن معارف",
   "start": 6.0,
   "end": 43.04
  },
  {
   "index": 1,
   "title": "## وحشت؛ ترس مذموم از بی‌حقیقت",
   "start": 43.04,
   "end": 76.96
  },
  {
   "index": 2,
   "title": "## دهشت؛ ترس ممدوح از حقیقت",
   "start": 76.96,
   "end": 105.08
  },
  {
   "index": 3,
   "title": "## ترس ناخودآگاه و ضعف‌های مزاجی",
   "start": 105.08,
   "end": 232.68
  },
  {
   "index": 4,
   "title": "## راه برون‌رفت: جسم، اعتقاد و ذکر قلبی",
   "start": 232.68,
   "end": 469.7
  },
  {
   "index": 5,
   "title": "## اذکار تعقیب نماز صبح و چهار آیهٔ اطمینان",
   "start": 469.7,
   "end": 570.18
  },
  {
   "index": 6,
   "title": "چهار دعای خاص در این مزم واقع شده است:",
   "start": 570.18,
   "end": 724.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 4.3,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.3,
   "end": 7.04,
   "text": "المستغاث بکه یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.04,
   "end": 15.02,
   "text": "عزیزی پرسیدن که بسیار این معارف رو دوست دارم و با قلبم عجین هست و این‌ها به قریبه به همین مضمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.02,
   "end": 17.78,
   "text": "که حالا مشکلشون این هست که در عین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.78,
   "end": 24.98,
   "text": "رجوع به این حقایق و معارف و چشیدن این حقایق ترس‌های عجیبی براشون حادث میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.98,
   "end": 27.76,
   "text": "قلبشون در فشار قرار می‌گیره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.76,
   "end": 33.4,
   "text": "یه اضطراباتی، ترس‌هایی در وجودشون ایجاد میشه که نگرانشون کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.4,
   "end": 37.0,
   "text": "عزیزان توجه داشته باشن که ما دو نوع ترس داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.0,
   "end": 40.14,
   "text": "یکیش ممدوحه و یکیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.14,
   "end": 44.58,
   "text": "مذمومه. اون ترس مذموم بهش میگن وحشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.58,
   "end": 48.42,
   "text": "ترس ممدوح بهش میگن دهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.42,
   "end": 52.02,
   "text": "چه فرقی با هم دارن؟ ترسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.02,
   "end": 56.2,
   "text": "مذموم است مورد ذم و نکوهش قرار گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.2,
   "end": 61.3,
   "text": "که بهش میگن وحشت. وحشت کردن از چیزهایی‌ست که حقیقت ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.3,
   "end": 63.64,
   "text": "و قدرتی ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.64,
   "end": 65.78,
   "text": "و آسیبی به ما نمی‌تونن برسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.78,
   "end": 70.02,
   "text": "یا حاصل صور و اشکال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.02,
   "end": 74.26,
   "text": "قوه‌ی خیال یا توهمات قوه‌ی وهم‌ن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.26,
   "end": 76.84,
   "text": "و یا حقیقت بیرونی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.84,
   "end": 83.44,
   "text": "یا اگر دارند در اون حدی نیستن که ما بخواهیم از اون‌ها بترسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.44,
   "end": 88.44,
   "text": "در حقیقت ریشه در توهمات و تخیلات ما دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.44,
   "end": 91.7,
   "text": "یا اینکه انسان از مثلاً یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.7,
   "end": 98.54,
   "text": "پادشاهان بترسد، از قدرت‌های پوشالی که امروز اسمشونو گذاشتن ابرقدرت بترسند، در حالی که لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.54,
   "end": 101.2,
   "text": "حول و لا قوه الا بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.2,
   "end": 112.7,
   "text": "العلی العظیم. این به یک معنا، خب اگر این چنین است انسان از اینجور چیزها می‌ترسد که حقیقت خارجی ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.7,
   "end": 114.68,
   "text": "و این‌ها خب ضعف نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.68,
   "end": 120.92,
   "text": "این‌ها نشان‌دهنده‌ی ضعف اعتقادی‌ست که منتج به ضعف نفس شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.92,
   "end": 125.58,
   "text": "باید انسان یک دور اعتقادات ببیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.58,
   "end": 129.88,
   "text": "و تسویه اعتقادی در درونش اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.88,
   "end": 132.94,
   "text": "کتاب‌های اعتقادی رو بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.94,
   "end": 135.84,
   "text": "که دیگه حداقل این کتاب‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.84,
   "end": 138.82,
   "text": "کتاب راه بهشت که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.82,
   "end": 143.68,
   "text": "ترجمه‌ی الاعتقادات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.68,
   "end": 146.02,
   "text": "مرحوم علامه مجلسی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.02,
   "end": 150.6,
   "text": "دیگه حداقل این کتاب رو بخونه که خیلی هم کوتاه هست البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.6,
   "end": 159.38,
   "text": "و امثالهم. کتاب‌های مثلاً توحید، توحید شیخ صدوق دیگه خیلی مراتب عالیه داره در حیث اعتقادات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.38,
   "end": 165.08,
   "text": "و امثالهم. اما اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.08,
   "end": 171.42,
   "text": "ترس ممدوح باشد یعنی مورد مدح و ستایش قرار گرفته، این نوع ترس‌ها بهش میگن دهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.42,
   "end": 174.44,
   "text": "دهشت از حقایقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.44,
   "end": 177.26,
   "text": "مثلاً انسان از حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.26,
   "end": 179.26,
   "text": "بترسد. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.26,
   "end": 182.14,
   "text": "ترس حق است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.14,
   "end": 186.96,
   "text": "به جاست. در دل خشیت نگفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.96,
   "end": 189.4,
   "text": "از چی می‌ترسی؟ از جلالت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.4,
   "end": 191.08,
   "text": "میگن مگر خدا ترس داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.08,
   "end": 193.66,
   "text": "خدا که بسیار مهربانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.66,
   "end": 201.4,
   "text": "این همون نقص در نگرشه که ما صرفاً جمال خدا رو ببینیم و جلالش رو نبینیم که بحث‌هاش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.4,
   "end": 209.56,
   "text": "اگر چنانچه ما صرفاً جمال ببینیم، رئفت و ستاریت و غفاریت و بخاریت و این‌های خدا رو ببینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.56,
   "end": 211.94,
   "text": "دچار این اشتباه می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.94,
   "end": 214.58,
   "text": "و جسارت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.58,
   "end": 217.46,
   "text": "اون شأن حضرت حق رو نگه نمی‌داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.46,
   "end": 222.46,
   "text": "همچنین در خصوص ولی خدا، حجت خدا، دین خدا، قرآن خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.46,
   "end": 228.68,
   "text": "آیات الهی، روایات اهل بیت علیهم الصلاة والسلام، شأن علما، بزرگان این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.68,
   "end": 232.28,
   "text": "و این چنین موارد معنوی یا حتی صلاة و نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.28,
   "end": 237.38,
   "text": "اگر ما برای نماز صرفاً جمال قائل بشیم و صرفاً خوب کنیم و عادت کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 237.38,
   "end": 241.3,
   "text": "خوب نیست. جلالت باید در کنار جمال باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.3,
   "end": 245.16,
   "text": "جلال، عظمت. ذو الجلال والاکرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.16,
   "end": 248.7,
   "text": "دارای جلال است و اکرام که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.7,
   "end": 252.86,
   "text": "همون جمال است. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.86,
   "end": 255.9,
   "text": "اگر این چنین است این ترس خیلی هم خوب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.9,
   "end": 258.12,
   "text": "باعث میشه که انسان خود نگهدار بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.12,
   "end": 261.7,
   "text": "اگرچه در کنارش سوختن هست، فشارهای درونی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.7,
   "end": 264.76,
   "text": "اما این سوختن و فشارهای درونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.76,
   "end": 266.92,
   "text": "انسان رو به اضطرار می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.92,
   "end": 270.86,
   "text": "اضطرار خوب است. اضطراب بد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.86,
   "end": 273.04,
   "text": "اون ترس مذموم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.04,
   "end": 275.48,
   "text": "یا وحشت انسان رو به اضطراب می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.48,
   "end": 279.26,
   "text": "این بده. ریشه‌ی بسیاری از مشکلات روحی و روانی همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.26,
   "end": 281.8,
   "text": "اما ترس مد-- ممدوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.8,
   "end": 287.04,
   "text": "و مورد ستایش، اون در حقیقت دهشت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.04,
   "end": 290.2,
   "text": "از حقیقت خاف من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.2,
   "end": 296.24,
   "text": "مقام ربه. ترسیدن از مقام و عظمت حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.24,
   "end": 301.94,
   "text": "این خیلی هم خوبه. باعث خود نگهداری و رسیدن به، به قرب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.94,
   "end": 303.78,
   "text": "یعنی انسان رو به قرب می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.78,
   "end": 305.6,
   "text": "قرب هم همون مقام ولایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.6,
   "end": 308.82,
   "text": "هر مقدار قرب اخذ کنی یعنی علم اخذ کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.82,
   "end": 311.72,
   "text": "به معرفت حقیقت، حقیقت برسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.72,
   "end": 315.1,
   "text": "به همون میزان به ولایت قرب پیدا کردی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.1,
   "end": 317.66,
   "text": "به حقایق کلمات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.66,
   "end": 319.96,
   "text": "اسماء الهی رسیدی. این تا اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.96,
   "end": 326.92,
   "text": "اما اگر چنانچه ما ندونیم این ترس از کجا ناشی شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.92,
   "end": 331.2,
   "text": "منشأش از حقایقه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.2,
   "end": 335.94,
   "text": "غیر حقایق. اصلاً ندونیم ناخودآگاه در وجودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.94,
   "end": 338.84,
   "text": "ترسی ناخودآگاه ایجاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.84,
   "end": 341.66,
   "text": "منشأ این ترس مشخص نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.66,
   "end": 344.34,
   "text": "این‌ها هم بر می‌گرده به همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.34,
   "end": 353.34,
   "text": "در حقیقت ضعف‌های مزاجی انسان که به هر حال ضعف‌هایی که در بدن انسان که انزل مراتب نفس است ایجاد می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.34,
   "end": 355.16,
   "text": "به خیلی چیزا بستگی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.16,
   "end": 358.22,
   "text": "خیلی. مثنوی هفتاد من کاغذ شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.22,
   "end": 364.78,
   "text": "به قبل از خلقتش حتی اجدادش و حتی نطفه‌ش، پدرش، مادرش بعد از اینکه اون ه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.78,
   "end": 367.38,
   "text": "نه ماه که در رحم مادر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.38,
   "end": 371.52,
   "text": "انقلابات قلبی مادر، تخیلاتش، توهماتش، تعقلاتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.52,
   "end": 376.64,
   "text": "نفسش، خوردنش، خوابیدنش همه در بچه تاثیرگذار است و بعد از اون هم اثرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.64,
   "end": 380.98,
   "text": "محیطی، نفس‌ها، خوردن‌ها، چشیدن‌ها، دیدن‌ها، شنیدن‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.98,
   "end": 384.94,
   "text": "لمس کردن‌ها اینا همه موثرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.94,
   "end": 388.66,
   "text": "و در هر حال مطلقا گیج نکنیم عزیزان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.66,
   "end": 393.18,
   "text": "برای اینکه از این وضعیت بیرون برویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.18,
   "end": 395.12,
   "text": "ما باید هم به جسممون برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.12,
   "end": 403.44,
   "text": "اونچه که در دین مبین اسلام در طب الأئمه توصیه شده اون‌ها رو استفاده کنیم و اون‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.44,
   "end": 406.08,
   "text": "مورد مذمت قرار گرفتن، نهی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.08,
   "end": 411.42,
   "text": "این‌ها رو استفاده نکنیم. ساعات خوابمون، ساعات بیداریمون، ساعات خوردنمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.42,
   "end": 413.56,
   "text": "ساعات گرسنگیمون، ساعات مطالعه‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 413.56,
   "end": 418.64,
   "text": "یه سبک زندگی اسلامی به ر-- به قول رهبر عزیزمون در ما پیاده بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.64,
   "end": 421.18,
   "text": "در کنار حوزه اعتقادات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 421.18,
   "end": 424.28,
   "text": "اون در-- میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 424.28,
   "end": 429.3,
   "text": "تصحیحی که در حوزه اعتقادات صورت می‌گیره که منجر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.3,
   "end": 432.86,
   "text": "صاف شدن و زلال شدن قوه خیال می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.86,
   "end": 436.52,
   "text": "و در کنار اون‌ها هم استفاده از ذکر قلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.52,
   "end": 441.02,
   "text": "ذکر قلبی بهترین موقعش سحرهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 441.02,
   "end": 444.84,
   "text": "دل سحر یا خلوت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.84,
   "end": 450.22,
   "text": "\"صمت و جوع و سهر و خلوت و ذکر به دوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.22,
   "end": 454.42,
   "text": "ناتمامان جهان را کند این پنج تمام.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.42,
   "end": 457.64,
   "text": "که انسان بتونه خلوتی داشته باشه و ذکر بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.64,
   "end": 461.7,
   "text": "بهترین ذکر برای برون رفت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.7,
   "end": 464.28,
   "text": "این اضطرابات و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.28,
   "end": 469.22,
   "text": "و نجات از این فشارهای روحی و روانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 469.22,
   "end": 474.78,
   "text": "اونطور که بزرگان سفارش کردن البته به توصیه اهل بیت علیهم الصلاة و السلام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 474.78,
   "end": 477.78,
   "text": "یکی از بهترین اذکاری که در این مورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.78,
   "end": 481.2,
   "text": "وارد شده می‌تونید رجوع کنید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 481.2,
   "end": 489.8,
   "text": "اذکار یا تعقیبات بعد از نماز صبح که البته در مفاتیح شیخ عباس قمی علیه الرحمة آمده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 489.8,
   "end": 496.32,
   "text": "به رحمت کنید بهجت رو که به ما خیلی سفارش می‌کردن به همین مفاتیح و لاغیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.32,
   "end": 498.24,
   "text": "و البته این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.24,
   "end": 500.46,
   "text": "سه دسته دعاست که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 500.46,
   "end": 503.24,
   "text": "شرحش اونجا داده شده تو مفاتیح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 503.24,
   "end": 505.84,
   "text": "که در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.84,
   "end": 510.96,
   "text": "مرحوم ثقل Islam نوری نور الله مرقده در کتاب دار السلامش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.96,
   "end": 513.6,
   "text": "همینطور و شیخ عباس هم آورده این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.6,
   "end": 521.4,
   "text": "سه تا رو که البته توضیح میده یکیش رو که همون ابتدا بعد از نماز صبح حالا بعد از تسبیحات حضرت زهرا سلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 521.4,
   "end": 523.52,
   "text": "الله علیها دیگر دعا خونده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.52,
   "end": 525.96,
   "text": "ش- ابن فهد حلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 525.96,
   "end": 530.4,
   "text": "در عده الدعایش هم آورده شیخ ابن فهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.4,
   "end": 533.22,
   "text": "از امام رضا صلوات الله علیه نقل شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 533.22,
   "end": 536.1,
   "text": "به این صورت هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 536.1,
   "end": 543.32,
   "text": "\"بسم الله و صل الله علی محمد و آله و افوض امری الی الله ان الله بشیر بالعباد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 543.32,
   "end": 548.24,
   "text": "فوقاه الله سیئات ما مكروا لا اله الا انت\" همینطور تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.24,
   "end": 550.74,
   "text": "آخر یه نیم صفحه‌ای هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 550.74,
   "end": 555.98,
   "text": "خیلی مضامین عالی. چهار تا دعای خاص در این مزم واقع شده که یکیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 555.98,
   "end": 560.02,
   "text": "همون \"افوض امری الی الله\" هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 560.02,
   "end": 565.4,
   "text": "چون در این آیه می‌فرماید که \"فوقاه الله سیئات ما مكروا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.4,
   "end": 570.18,
   "text": "خدا او رو حفظ می‌کنه از بدی‌هایی که دیگران در موردش مکر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.18,
   "end": 573.76,
   "text": "امام صادق صلوات الله علیه فرمود: در تعجبم کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.76,
   "end": 580.6,
   "text": "از این آیه غافله و می‌ترسه از مکر دیگران، دل پریشانی‌هایی که از مکر دیگران حاصل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 580.6,
   "end": 588.6,
   "text": "و دیگرش \"لا اله الا انت سبحانک انی کنت من الظالمین\" که بعد امام صادق صلوات الله علیه می‌فرماید:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 588.6,
   "end": 592.38,
   "text": "تعجبم از کسی که دچار غم و هم و اینا می‌شه از این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 592.38,
   "end": 597.9,
   "text": "غافله. چون بعدش می‌فرماید \"فاستجبنا له منجیناه من الغم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 597.9,
   "end": 600.74,
   "text": "از غم این خدا اینا رو آزاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 600.74,
   "end": 604.38,
   "text": "و بعدیش \"حسبنا الله ونعم الوکیل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 604.38,
   "end": 609.04,
   "text": "که حضرت فرمود: در تعجبم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 609.04,
   "end": 614.34,
   "text": "کسی که دچار سوء شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 614.34,
   "end": 617.86,
   "text": "سوء و مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 617.86,
   "end": 621.56,
   "text": "مشکلات عدیده اینا او رو پریشان کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 621.56,
   "end": 625.0,
   "text": "مسش کرده در حالی که از این آیه غافله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 625.0,
   "end": 633.52,
   "text": "چون بعدش می‌فرماید \"حسبنا الله ونعم الوكيل فانقلبوا بنعمت من الله وفضل لم يمسسهم سوء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 633.52,
   "end": 636.4,
   "text": "و دیگرش آیه \"ما شاء الله لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 636.4,
   "end": 638.94,
   "text": "قوة الا بالله\" در قرآن اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 638.94,
   "end": 645.96,
   "text": "اما اینجا \"ما شاء الله لا حول و لا قوة الا بالله\" در این آیه اومده که بعد حضرت می‌فرماید:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 645.96,
   "end": 653.14,
   "text": "کسی که دنبال دنیا می‌گرده و می‌خواد انشاالله وضع مالیش خوب بشه اما از این آیه غافله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 653.14,
   "end": 658.64,
   "text": "و همچنین بعد از خوندن این آیه فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 658.64,
   "end": 664.12,
   "text": "شود یکی اینکه دست به سینه بگذاره هفتاد مرتبه بگه یا فاتح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 664.12,
   "end": 666.82,
   "text": "یا فاتح با توجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 666.82,
   "end": 669.52,
   "text": "و سپس این ذکر شریف رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 669.52,
   "end": 675.76,
   "text": "\"لا حول ولا قوة الا بالله توکلت على الحي الذي لا يموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 675.76,
   "end": 685.52,
   "text": "والحمد لله الذي لم يتخذ ولدا ولم يكن له شريك في الملك ولم يكن له ولي من الظلم وكبره تكبيرا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 685.52,
   "end": 689.46,
   "text": "عظمتی که این اذکار دارن یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 689.46,
   "end": 695.24,
   "text": "اطمینان و آرامش خاصی در انسان ایجاد می‌کنند و اون اضطرابات که عرض شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 695.24,
   "end": 703.2,
   "text": "انسان رو اذیت می‌کنند و مشکلات روحی، روانی ح-حتی افسردگی و اینا رو به مرور البته در مداومت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 703.2,
   "end": 705.66,
   "text": "خصوصا بعد از نماز صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 705.66,
   "end": 709.86,
   "text": "این‌ها برطرف می‌کنند. خیلی عالی‌ان این اذکار غافل نباشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 709.86,
   "end": 717.04,
   "text": "البته مداومت. حدیث داریم که حداقل چیزی که انسان در مستحبات براش مداومت می‌کنه تا اون تاثیر خاصش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 717.04,
   "end": 721.64,
   "text": "و شگفتاش رو ببینه حداقل یک سال باید باشه انسان مداومت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 721.64,
   "end": 724.76,
   "text": "موفق باشین انشاالله. والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}