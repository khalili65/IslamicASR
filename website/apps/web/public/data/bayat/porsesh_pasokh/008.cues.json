 "chapters": [
  {
   "index": 0,
   "title": "## ذکر یونسیه؛ عدد و بی‌عدد",
   "start": 0.4,
   "end": 84.28
  },
  {
   "index": 1,
   "title": "### ظلمات ثلاث یونس و دنیا",
   "start": 84.28,
   "end": 105.28
  },
  {
   "index": 2,
   "title": "### برنامه برای مبتدی و سالک",
   "start": 105.28,
   "end": 445.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 8.82,
   "text": "بسم الله و بالله و على ملة رسول الله المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.82,
   "end": 12.56,
   "text": "سؤال دیگری پرسیده شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.56,
   "end": 19.92,
   "text": "در خصوص اختلافات عدد ذکر یونسیه برای افراد معمولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.92,
   "end": 23.64,
   "text": "که چقدر در روز هست و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.64,
   "end": 29.46,
   "text": "البته میدونید که ذکر یونسیه یکی از بهترین اذکار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.46,
   "end": 35.38,
   "text": "در عباديات هست و برای تقرب به درگاه حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 35.38,
   "end": 40.96,
   "text": "که یا با عدد باید بگی یا بی‌عدد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.96,
   "end": 43.84,
   "text": "برای کسانی که تازه‌کارند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.84,
   "end": 46.38,
   "text": "خیلی در مسیر سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.38,
   "end": 57.56,
   "text": "پیش نرفته‌اند، برنامه مدون خاصی ندارند، اون‌ها بی‌عدد هر مقدار که سعه وجودیشون اقتضا میکنه بی‌عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 57.56,
   "end": 61.7,
   "text": "بعد از هر نمازی در حالت سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 61.7,
   "end": 65.8,
   "text": "و این ذکر رو بگن که لا اله الا انت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 65.8,
   "end": 68.62,
   "text": "سبحانك انی کنت من الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.62,
   "end": 72.64,
   "text": "یکی از بهترین اذکار برای برون رفت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.64,
   "end": 75.96,
   "text": "ظلمات هست. که البته میدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 75.96,
   "end": 78.82,
   "text": "ظلمات ثلاث در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.82,
   "end": 82.4,
   "text": "اخلاقیات و عرفان خیلی مطرح هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.4,
   "end": 89.7,
   "text": "همونطور که حضرت یونس علی نبي و آله و عليه الصلاة والسلام هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.7,
   "end": 93.68,
   "text": "در سه تا ظلمت واقع شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.68,
   "end": 100.74,
   "text": "وقتی افتاد در دل ماهی و نهنگ و ذي النون یعنی اون صاحب ماهی یا کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.74,
   "end": 102.32,
   "text": "در دل ماهی قرار گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.32,
   "end": 105.28,
   "text": "و ذي النون اذ ذهب مغاضبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.28,
   "end": 109.86,
   "text": "فظن ان لن نقدر عليه فنادى في الظلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 109.86,
   "end": 112.56,
   "text": "الله لا اله الا انت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.56,
   "end": 116.14,
   "text": "سبحانك انی کنت من الظالمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.14,
   "end": 122.32,
   "text": "فاستجبنا له ونجيناه من الغم وكذلك ننجي المؤمنین آیه قرآنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 122.32,
   "end": 126.38,
   "text": "اتفاقاً در رکعت اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.38,
   "end": 128.54,
   "text": "نماز شریف غفیله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.54,
   "end": 131.98,
   "text": "بین مغرب و عشا خوانده می‌شود این دعا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.98,
   "end": 135.86,
   "text": "در حقیقت آیه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.86,
   "end": 141.52,
   "text": "که همونطور که در آیه میفرماید فاستجبنا له ونجيناه من الغم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.52,
   "end": 146.28,
   "text": "هم استجابت برای حضرت یونس رخ داد در پس این ذکر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.28,
   "end": 149.74,
   "text": "ونجيناه من الغم از غم نجات پیداش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.74,
   "end": 154.16,
   "text": "پیدا کرد به عنایت الهی و همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.16,
   "end": 157.58,
   "text": "وكذلك ننجي المؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.58,
   "end": 161.16,
   "text": "این كذلك ننجي المؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.16,
   "end": 164.54,
   "text": "نشون میده که دائما خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.54,
   "end": 168.44,
   "text": "در حال اخراج اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.44,
   "end": 171.66,
   "text": "از غم و غصه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.66,
   "end": 174.04,
   "text": "به سمت نشاط و سرور و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.04,
   "end": 181.4,
   "text": "انبساط وجودی. به شرط این که البته مؤمن باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.4,
   "end": 186.62,
   "text": "و این ذکر در حقیقت این ذکر در وجودشون پیاده شده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.62,
   "end": 190.58,
   "text": "که البته استجابت هم بعدش قطعی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.58,
   "end": 192.96,
   "text": "خب حضرت یونس وقتی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.96,
   "end": 195.72,
   "text": "ظلمات ثلاث قرار گرفت که یکیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.72,
   "end": 200.1,
   "text": "دل دریا بود، یکیش دل شب بود، یکیش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.1,
   "end": 206.54,
   "text": "دل ماهی بود. این سه تا ظلمت به واسطه این ذکر که تکرار می‌کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.54,
   "end": 211.04,
   "text": "و تردد می‌کرد، ورود می‌کرد به این ذکر دائما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.04,
   "end": 215.0,
   "text": "دل ماهی خدا ایشون رو نجات داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.0,
   "end": 218.82,
   "text": "و از غم و غصه نجاتش داد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.82,
   "end": 221.06,
   "text": "استجابتش رخ داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.06,
   "end": 224.92,
   "text": "همین‌طور در ظلمات ثلاث دنیوی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.92,
   "end": 230.26,
   "text": "که جالبه که حضرت اباعبدالله سلام الله علیه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.26,
   "end": 232.5,
   "text": "دعای شریف عرفه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.5,
   "end": 234.94,
   "text": "اونجا اباعبدالله اشاره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.94,
   "end": 241.62,
   "text": "ظلمات ثلاث مادر وقتی بچه در رحمش قرار می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.62,
   "end": 246.2,
   "text": "اونجا اشاره می‌کنه که سه تا ظلمت رو بچه طی می‌کنه جنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 246.2,
   "end": 248.54,
   "text": "در دنیا هم ما دچار سه ظلمتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.54,
   "end": 252.32,
   "text": "یکی ظلمت تن، همین بدن خاکی این جسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.32,
   "end": 255.8,
   "text": "که تفاله بدن برزخی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.8,
   "end": 258.84,
   "text": "یک خود ظلمت دنیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.84,
   "end": 264.34,
   "text": "که منظور البته حب به دنیاست دیگه و الا خود دنیا که آیه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.34,
   "end": 267.48,
   "text": "حب الدنيا رأس كل خطيئة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.48,
   "end": 271.56,
   "text": "و ظلمت سوم هم هوی و خواهش نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.56,
   "end": 276.04,
   "text": "این که هرچی دل می‌خواد انسان به اون سمت بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 276.04,
   "end": 279.76,
   "text": "این ذکر از بهترین ذکر‌هاییست که ذکر یونسیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.76,
   "end": 281.96,
   "text": "که ما را از ظلمت‌ها نجات بدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.96,
   "end": 290.74,
   "text": "لکن برای عزیزانی که تازه‌کار هستند، تازه وارد هستند افراد به قول عزیز سؤال‌کنندمون معمولی هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.74,
   "end": 293.78,
   "text": "بهترین اینه که بدون عدد گفته بشه بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.78,
   "end": 301.36,
   "text": "حداقل یک بار در سجده بعد از هر نماز با توجه البته توجه عرفانی که معجزه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.36,
   "end": 305.94,
   "text": "ما قبلاً در خصوص معجزه گری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 305.94,
   "end": 310.52,
   "text": "توجه عرفانی صحبت‌ها کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.52,
   "end": 313.94,
   "text": "یکی از موهبت‌های الهی به انسان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.94,
   "end": 320.92,
   "text": "و حداقل یک بار می‌تونه سه بار بیشتر هفت بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.92,
   "end": 325.34,
   "text": "دیگه یا بدون عدد اصلاً تا مقداری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.34,
   "end": 327.74,
   "text": "حالش رو داره هر چند تا تونست بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.74,
   "end": 330.42,
   "text": "اما برای کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.42,
   "end": 335.8,
   "text": "خب برنامه مدونی دارن مشغول مراقبه‌اند، مشغول محاسبه‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 335.8,
   "end": 339.98,
   "text": "و سیر و سلوک‌شون برنامه داره، استاد دارن اینها خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 339.98,
   "end": 345.0,
   "text": "باید اولا از استاد نسبت به سعه وجودی اقتباس کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 345.0,
   "end": 350.86,
   "text": "لکن یعنی اقتباس کردن یعنی قبس قبس از وجود استاد نور گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 350.86,
   "end": 358.98,
   "text": "همونطور که حضرت موسی علی نبي و آله و عليه الصلاة والسلام در قرآن می‌فرماید رفت که اقتباس کنه قبس نوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 358.98,
   "end": 368.34,
   "text": "آتشی از اون دل شب وقتی آتش رو دید از دور رفت بگیره خدا به پیامبری مبعوثش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 368.34,
   "end": 373.66,
   "text": "در حقیقت دیگه خود استاد نسبت به ظرف وجودی طرف میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 373.66,
   "end": 378.08,
   "text": "لکن اونطور که بزرگان مثل خود حضرت علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 378.08,
   "end": 380.68,
   "text": "حفظه الله تعالی فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 380.68,
   "end": 386.52,
   "text": "برای کسانی که ابتدای راه سیر و سلوک هستند و البته ظرفیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 386.52,
   "end": 394.22,
   "text": "لازم و سعه وجودی کافی دارند حداقل چهارصد بار در دل شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 394.22,
   "end": 396.94,
   "text": "در حالت سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 396.94,
   "end": 400.7,
   "text": "ابتداش یعنی چهارصد بار وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 400.7,
   "end": 403.7,
   "text": "ولی برای کمال کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 403.7,
   "end": 408.24,
   "text": "کامل‌ترند و اینها تا چهار هزار تا هم هست که البته عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 408.24,
   "end": 413.02,
   "text": "برای ماه زوده و به نظرم برای ابتدا همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 413.02,
   "end": 420.16,
   "text": "تعدادی که به سعه وجودی باشه مخصوصاً در شروع کار بدون عدد، بدون عدد انسان هر مقدار ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 420.16,
   "end": 425.98,
   "text": "همون سعه وجودیش که نشاطش از بین نره با اکراه ذکر رو نگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 425.98,
   "end": 434.88,
   "text": "با سعه وجودی بگه همون مقدار کفایت می‌کنه تا انشاالله به قول معروف موتور دلش روشن بشه و یواش یواش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 434.88,
   "end": 437.3,
   "text": "بیشتر کردن ذکر لذت ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 437.3,
   "end": 442.12,
   "text": "نسبت به لذت وجودیش باید بره جلو نه با اکراه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 442.12,
   "end": 445.76,
   "text": "که زدگی ایجاد بشه. والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}