 "chapters": [
  {
   "index": 0,
   "title": "## پرسش از تبدیل ذکر یونسیه به صلوات",
   "start": 0.08,
   "end": 235.06
  },
  {
   "index": 1,
   "title": "## ترک یونسیه و پناه به صلوات بدون دستور",
   "start": 235.06,
   "end": 264.7
  },
  {
   "index": 2,
   "title": "## ذکر لعن قتله و نیابت از حضرت زهرا",
   "start": 264.7,
   "end": 563.16
  },
  {
   "index": 3,
   "title": "## انس با مفاتیح و کتب ادعیه",
   "start": 563.16,
   "end": 729.64
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 4.54,
   "text": "الله و بالله و على ملة رسول الله المستغاث بك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.54,
   "end": 10.24,
   "text": "يا حجة الله. عزیزی پرسیدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.24,
   "end": 15.54,
   "text": "آیا کسی که عادت کرده به ذکر شریف یونسیه یه مدتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.54,
   "end": 25.36,
   "text": "مستمر این رو می‌گفته بعد به دلش بیفته که این ذکر رو بدل کنه به ذکر صلوات، نشانه خوبی هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.36,
   "end": 27.68,
   "text": "یا اینکه پرسیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.68,
   "end": 30.02,
   "text": "همینطور به دلش بیفته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.02,
   "end": 37.64,
   "text": "ذکر اللهم العن قتلة امیر المؤمنین علیه السلام رو به نیابت از بی بی حضرت زهرا سلام الله علیها بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.64,
   "end": 41.28,
   "text": "به صورت کلی عرض کنم که اولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.28,
   "end": 45.72,
   "text": "ما باید تا اونجایی که امکان داره ذکر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.72,
   "end": 51.62,
   "text": "ذکر معثور بگیم یعنی ذکری رو که اهل بیت علیهم الصلاة و السلام فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.62,
   "end": 54.1,
   "text": "چون اون‌ها آگاه به سر القدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.1,
   "end": 61.36,
   "text": "بندگان هستند لذا از کاری رو که برای هر منظور و هر مقصود و هر مطلوبی بیان می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.36,
   "end": 66.96,
   "text": "کارساز است و انسان رو به اون مطلوب و مقصود و منظور می‌رسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.96,
   "end": 71.74,
   "text": "و خیلی خوبه مخصوصاً حالا از کار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.74,
   "end": 74.7,
   "text": "عرض شود اون ادعیه قرآنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.7,
   "end": 82.14,
   "text": "که اساساً توسط حضرت حق در قرآن ما بر سر این سفره و معاده آسمانی دعوت شدیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.14,
   "end": 86.7,
   "text": "به هر حال این هرچه انسان سعی کنه که اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 86.7,
   "end": 93.16,
   "text": "از این از کار بهره می‌گیره معثور باشه از سر اهل بیت علیهم الصلاة و السلام باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 93.16,
   "end": 97.44,
   "text": "یا در نهایت دیگه حالا خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.44,
   "end": 101.7,
   "text": "بگیم حالا انزل مراتب ممکن اینه که یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.7,
   "end": 107.12,
   "text": "تالی تل به معصوم مثلاً علما، مراجع، بزرگان، عرفا اینها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 107.12,
   "end": 109.98,
   "text": "اون‌ها در جدول وجودی‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.98,
   "end": 112.48,
   "text": "اخذ کرده باشن از حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.48,
   "end": 116.6,
   "text": "معصوم صلوات الله عليه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.6,
   "end": 122.32,
   "text": "ما مطمئن باشیم یک عالم مورد وثوقی این ذکر رو توصیه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.32,
   "end": 127.38,
   "text": "این یه نکته که اگر غیر از این باشه شاید در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 127.38,
   "end": 137.24,
   "text": "ابتدای تاثیراتی ما ببینیم تاثیراتی رو اخذ کنیم اما در ادامه مشکلاتی در وجود انسان ایجاد میشه در مسیر بندگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 137.24,
   "end": 140.36,
   "text": "تعادل وجودی انسان به هم می‌ریزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 140.36,
   "end": 143.22,
   "text": "و اصلاً اون ذکری رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 143.22,
   "end": 147.24,
   "text": "نه معصوم فرموده نه از اولیاء خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 147.24,
   "end": 151.24,
   "text": "تاکید شده انسان خودش نباید به هیچ عنوان ذکری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 151.24,
   "end": 155.46,
   "text": "خودش درست کنه، ترکیب کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 155.46,
   "end": 159.3,
   "text": "و یا ذکر رو ابداع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 159.3,
   "end": 164.42,
   "text": "خصوصاً در حد تکرار یعنی یه ذکر رو بخواد تکرار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 164.42,
   "end": 169.06,
   "text": "اما در این خصوصی که حالا موردی که سؤال پیش اومده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 169.06,
   "end": 173.36,
   "text": "اولا ذکر یوس-یونسیه یکی از شریف‌ترین از کاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 173.36,
   "end": 177.76,
   "text": "که انسان رو از ظلمات ثلاث بیرون می‌کشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 177.76,
   "end": 188.42,
   "text": "که این ذکر همونطور که حضرت یونس سلام الله عليه رو از ظلمات ثلاث شکم ماهی و دل دریا و دل شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 188.42,
   "end": 194.4,
   "text": "بیرون کشید کسی که بر این ذکر مداومت کنه خصوصاً سحرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 194.4,
   "end": 200.58,
   "text": "بتونه این‌ها رو این ذکر رو مداومت کنه رفته رفته از عالم طبیعت خارج میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 200.58,
   "end": 205.32,
   "text": "با مداومتش و akثار این ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 205.32,
   "end": 210.4,
   "text": "برای اون‌هایی که در مسیر سیر و سلوک هستند نه بقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 210.4,
   "end": 215.76,
   "text": "که حداقل چهارصد بار در سجده در دل شب گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 215.76,
   "end": 218.68,
   "text": "انسان رو به موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 218.68,
   "end": 221.86,
   "text": "طبیعی نزدیک می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 221.86,
   "end": 224.42,
   "text": "از ظلمات ثلاث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 224.42,
   "end": 228.24,
   "text": "که یکیش دنیاست، یکیش کالبد جسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 228.24,
   "end": 233.38,
   "text": "ماست و یکی هم نفس است خارج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 233.38,
   "end": 235.06,
   "text": "بسیار ذکر شریفی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 235.06,
   "end": 241.06,
   "text": "اما اینکه اولا انسان بیاد این ذکر رو ترک کنه و به صلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 241.06,
   "end": 244.5,
   "text": "پناه ببره این به نظرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 244.5,
   "end": 250.22,
   "text": "اولا اینکه به دل بیفته حالا من متوجه دقیق این سؤال نمیشم اما اگه منظورشون اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 250.22,
   "end": 253.2,
   "text": "به دلشون می‌افته یا خواب نما میشن نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 253.2,
   "end": 257.08,
   "text": "که مثلاً این ذکر رو رها کنن و به صلوات پناه ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 257.08,
   "end": 260.8,
   "text": "اولا این به چه اصلی، به چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 260.8,
   "end": 263.86,
   "text": "مؤیدی، به چه ملاکی مثلاً همینطور به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 263.86,
   "end": 270.94,
   "text": "دل بیفته این ذکر رها بشه یه ذکر جدید، اینطور که نباید باشه باید با دستورالعمل بزرگان پیش رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 270.94,
   "end": 274.92,
   "text": "اما این رو در حالا تغییر از کار توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 274.92,
   "end": 279.52,
   "text": "اولا از کار در مداومت اثر اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 279.52,
   "end": 284.48,
   "text": "فضیلت اصلی خودشون رو نشون میدن که در حدیث داریم حداقل یک سال باید مداومت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 284.48,
   "end": 289.04,
   "text": "این یک نکته. نکته بعد این که هر ذکری کاربرد خودش رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 289.04,
   "end": 294.2,
   "text": "این ذکر یونسیه یک کاربردی داره صلوات کاربرد دیگری دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 294.2,
   "end": 297.26,
   "text": "البته در میان از کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 297.26,
   "end": 304.1,
   "text": "دو تا سه- دو تا ذکر هستند که این‌ها مولتی ویتامین‌اند به قول عرفا و بزرگان یعنی همه کار ازشون برمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 304.1,
   "end": 309.16,
   "text": "یکیش ذکر شریف صلوات است و یکی هم ذکر شریف استغفار است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 309.16,
   "end": 312.4,
   "text": "و انحاءش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 312.4,
   "end": 317.92,
   "text": "اما اینکه ما بخواهیم ذکر یونسیه رو رها کنیم و به دل صلوات بریم اولا بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 317.92,
   "end": 322.78,
   "text": "اذن همینطوری قلباً این‌ها این اشتباه است به نظر بنده حقیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 322.78,
   "end": 328.64,
   "text": "و اینکه اصلاً یک ذکر رو رها کنیم به ذکر دیگری رو بدون دستور این هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 328.64,
   "end": 334.64,
   "text": "در حقیقت ما باید همه از کار رو به جاش و به موقعش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 334.64,
   "end": 340.92,
   "text": "در خصوص اون موضوعی که مترتب شده استفاده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 340.92,
   "end": 344.32,
   "text": "یعنی به موقعش صلوات را داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 344.32,
   "end": 347.88,
   "text": "هیچوقت از صلوات فارغ نشیم و به موقعش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 347.88,
   "end": 351.9,
   "text": "ذکر شریف یونسیه رو داشته باشیم و هیچوقت از او فارغ نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 351.9,
   "end": 356.54,
   "text": "حداقل این ذکر یونسیه رو در سجده‌ها یک بار حداقل داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 356.54,
   "end": 359.6,
   "text": "حالا یا در سجده آخر یا بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 359.6,
   "end": 362.2,
   "text": "نمازهامون یک بار در سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 362.2,
   "end": 369.4,
   "text": "حداقل اتصال و ارتباطمون رو با این ذکر داشته باشیم که با صاحبان این ذکر محشور بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 369.4,
   "end": 375.12,
   "text": "صلوات هم همچنین که البته صلوات اعظمه دیگه اجلله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 375.12,
   "end": 376.92,
   "text": "جایگاهش. خب اینم از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 376.92,
   "end": 380.48,
   "text": "اما اینکه باز فرمودن به دل بیفته مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 380.48,
   "end": 385.36,
   "text": "ذکری مثل اللهم العن قتلة أمیر المؤمنین سلام الله علیه و به نیابت بی بی زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 385.36,
   "end": 387.8,
   "text": "باز این اولا این ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 387.8,
   "end": 393.02,
   "text": "مربوطه به شب ضربت خوردن مولامون علی علیه الصلاة والسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 393.02,
   "end": 397.18,
   "text": "مربوط به ش-شب نوزدهم ماه مبارک رمضانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 397.18,
   "end": 400.64,
   "text": "اهل بیت دستور دادن اون موقع بگید صد بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 400.64,
   "end": 408.58,
   "text": "اینکه ما بیاییم از خودمون همینطوری به دلمون بیفته بعداً این رو مثلاً تکرار کنیم وقت‌های دیگه، خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 408.58,
   "end": 411.28,
   "text": "چه لزومی داره؟ ما باید را--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 411.28,
   "end": 413.82,
   "text": "پامونو جای پای اهل بیت بگذاریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 413.82,
   "end": 417.98,
   "text": "در همه موارد. این همه دستورات دیگه اهل بیت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 417.98,
   "end": 423.12,
   "text": "اگر کسی وقت داره، فراغت داره، حوصله داره، حال داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 423.12,
   "end": 426.5,
   "text": "و توفیق داره می‌خواد ذکر بگه، خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 426.5,
   "end": 429.76,
   "text": "از کار مثروه دیگه رو بهره بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 429.76,
   "end": 432.8,
   "text": "جامع کبیره رو بهره بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 432.8,
   "end": 435.66,
   "text": "نافله سحر رو بهره بگیره، زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 435.66,
   "end": 440.28,
   "text": "عاشورا رو بهره بگیره، زیارت آل یاسین رو بهره بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 440.28,
   "end": 444.24,
   "text": "کثر ذکر صلوات و استغفار رو بهره بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 444.24,
   "end": 446.38,
   "text": "ذکر یونسیه رو، این‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 446.38,
   "end": 451.12,
   "text": "خیلی سفارش شده که این‌ها بعضیاشون واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 451.12,
   "end": 453.22,
   "text": "ما دائماً به این‌ها نیاز داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 453.22,
   "end": 455.64,
   "text": "مثل یک نفسی‌اند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 455.64,
   "end": 458.86,
   "text": "ما دائماً ممد حیات ما هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 458.86,
   "end": 463.72,
   "text": "اما اون بخش انتهای سال که به نیابت از بی بی دو عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 463.72,
   "end": 466.06,
   "text": "چه اشکالی داره؟ خیلی هم خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 466.06,
   "end": 470.06,
   "text": "اتفاقاً خوبه که انسان کارهایی رو که می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 470.06,
   "end": 475.14,
   "text": "حالا اگر واجب بود واجبو که نمیشه در عین انجامش نیت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 475.14,
   "end": 477.98,
   "text": "شما مثلاً نماز واجبت رو به نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 477.98,
   "end": 480.8,
   "text": "مثلاً حضرت زهرا سلام الله علیها بخونی، نه نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 480.8,
   "end": 484.4,
   "text": "اما وقتی تموم شد نماز واجبت می‌تونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 484.4,
   "end": 486.86,
   "text": "ثواب نماز واجبت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 486.86,
   "end": 489.68,
   "text": "اهدا کنی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 489.68,
   "end": 491.62,
   "text": "مثلاً حضرت زهرا سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 491.62,
   "end": 495.28,
   "text": "اما مستحبات رو چرا مستحبات رو در حین انجام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 495.28,
   "end": 502.76,
   "text": "دو روش داره، یا انسان انجام بده ثوابشو هدیه کنه بالاتر از اینه که اصلاً به نیابت انجام بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 502.76,
   "end": 504.64,
   "text": "حتی از یک نفر تا بی‌نهایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 504.64,
   "end": 507.66,
   "text": "میشه همه انسان‌هایی که بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 507.66,
   "end": 510.86,
   "text": "هستند و خواهند آمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 510.86,
   "end": 519.84,
   "text": "از اهل ایمان میشه انسان هدیه کنه حتی این شکلی هم بعضی از بزرگان فرمودن میشه که مثلاً شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 519.84,
   "end": 525.6,
   "text": "بگی این صلوات رو، این ذکر رو، این نماز و اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 525.6,
   "end": 528.78,
   "text": "استغفار رو مثلاً هدیه می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 528.78,
   "end": 531.08,
   "text": "به همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 531.08,
   "end": 536.24,
   "text": "اهل ایمان از طرف حضرت زهرا سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 536.24,
   "end": 539.38,
   "text": "مثلاً این صلوات رو، این ذکر رو، این وردو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 539.38,
   "end": 542.08,
   "text": "این کار خیر رو هدیه می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 542.08,
   "end": 545.88,
   "text": "به امام زمان از طرف همه اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 545.88,
   "end": 547.96,
   "text": "یا به همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 547.96,
   "end": 552.48,
   "text": "اهل ایمان از طرف مثلاً شهید قاسم سلیمانی اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 552.48,
   "end": 554.54,
   "text": "این هم هست. باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 554.54,
   "end": 557.56,
   "text": "ثواب اینکه شما یعنی یک یک اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 557.56,
   "end": 563.16,
   "text": "به همه این‌ها این ثواب میرسه برای شما منظور میشه خیلی هم خوب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 563.16,
   "end": 570.06,
   "text": "پس نتیجه اینکه ما محشور-- مانوس باشیم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 570.06,
   "end": 575.92,
   "text": "ادعیه و از کار و عوراد مثروه خصوصاً کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 575.92,
   "end": 578.48,
   "text": "مفاتیح الجنان شیخ عباس قمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 578.48,
   "end": 581.36,
   "text": "یکی دریایی‌ست دیگه. دریای متلاطمی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 581.36,
   "end": 583.04,
   "text": "خدا رحمت کنه آقای برجست رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 583.04,
   "end": 585.78,
   "text": "ما خیلی سفارش به مفاتیح می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 585.78,
   "end": 590.64,
   "text": "فرمودن آنچه که در این مفاتیح هست به نیت امام عصر بخونید و هدیه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 590.64,
   "end": 595.08,
   "text": "هم محبت شما تو دل آقا زیاد میشه هم محبت آقا تو دل شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 595.08,
   "end": 599.8,
   "text": "البته اگر کسی سعی وقت دارد، حوصله دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 599.8,
   "end": 603.9,
   "text": "توفیقاتش بیشتر از این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 603.9,
   "end": 607.04,
   "text": "خواهشم این هستش که این خواهش البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 607.04,
   "end": 611.0,
   "text": "پشتوانه قوی از علما و بزرگان دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 611.0,
   "end": 616.3,
   "text": "یعنی اون‌ها این مطالبه رو داشتند از اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 616.3,
   "end": 622.98,
   "text": "که قطعاً اهل ایمان به هر کتابی رجوع نکنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 622.98,
   "end": 624.86,
   "text": "به هر مشربی رجوع نکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 624.86,
   "end": 627.27,
   "text": "اگر کسی حوصله بیشتری داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 627.27,
   "end": 630.44,
   "text": "بیشتر از مفاتیح الجنان خواست رجوع کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 630.44,
   "end": 634.36,
   "text": "می‌تونه کتاب شریف عُدَّة الداعی ابن فهد حلی رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 634.36,
   "end": 637.98,
   "text": "بسیار کتاب شریف، وزین، سنگین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 637.98,
   "end": 643.62,
   "text": "و عزیزانی که در سیر و سلوک قدم می‌گذارند این کتاب خیلی به درد بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 643.62,
   "end": 649.02,
   "text": "کتاب مفتاح الفلاح في عمل الیوم واللیلة من الواجبات و المستحبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 649.02,
   "end": 652.66,
   "text": "این کتاب، کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 652.66,
   "end": 656.5,
   "text": "البته عربی بوده اصلش اما ترجمه فارسی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 656.5,
   "end": 659.78,
   "text": "شیخ بها علیه الرحمة این کتاب رو نوشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 659.78,
   "end": 663.54,
   "text": "در همین موضوع، همین منظور و همین مقصود و مطلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 663.54,
   "end": 668.32,
   "text": "خیلی کتاب خوب به درد بخور که می‌تونه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 668.32,
   "end": 671.36,
   "text": "اعمال شب و روزش رو تقسیم کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 671.36,
   "end": 673.24,
   "text": "و بر اساس اون برنامه پیش بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 673.24,
   "end": 676.56,
   "text": "کتاب شریف فلاح السائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 676.56,
   "end": 681.94,
   "text": "و نجاح المسائل في عمل اليوم والليل سید ابن طاووس علیه الرحمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 681.94,
   "end": 685.76,
   "text": "اونم البته به عربی بوده ترجمه فارسی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 685.76,
   "end": 691.42,
   "text": "یا کتاب نامه‌ها بر نامه‌های حضرت آلامه که البته نامه‌هایی بهشون نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 691.42,
   "end": 693.72,
   "text": "ایشون جواب نامه‌هاشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 693.72,
   "end": 699.38,
   "text": "با نامه دادن. لذا شد نامه‌ها بر نامه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 699.38,
   "end": 703.86,
   "text": "و اونجا هم حضرت آلامه به ذکرای بسیار شریف و وزینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 703.86,
   "end": 708.28,
   "text": "سفارش فرمودن. خب نسبت به جدول وجودی هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 708.28,
   "end": 710.16,
   "text": "می‌تونه انسان انتخاب کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 710.16,
   "end": 712.82,
   "text": "با مداومت هم مهمه که این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 712.82,
   "end": 715.6,
   "text": "یکی تقوا خیلی مهمه. زیربنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 715.6,
   "end": 720.64,
   "text": "اینکه این از کار تاثیر خاص و ویژه خودش رو بگذاره تقواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 720.64,
   "end": 724.68,
   "text": "و مداومت. این دو. ان شا الله که ما رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 724.68,
   "end": 727.8,
   "text": "از دعای خیرتون بهره‌مند کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 727.8,
   "end": 729.64,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}