   "title": "## فوران سؤال پس از شنیدن؛ نشانهٔ پیشرفت",
   "start": 1.16,
   "end": 113.86
  },
  {
   "index": 1,
   "title": "## حریم پاسخ؛ بداهت معصوم",
   "start": 113.86,
   "end": 134.28
  },
  {
   "index": 2,
   "title": "## ازدواج حروف تا انفجار فجر",
   "start": 134.28,
   "end": 312.4
  },
  {
   "index": 3,
   "title": "## تأثیر متألهان؛ سبزواری و همدانی و قاضی",
   "start": 312.4,
   "end": 441.89
  },
  {
   "index": 4,
   "title": "## عمر تلاش؛ نوک‌زدن پرنده و چهل سال قاضی",
   "start": 441.89,
   "end": 610.71
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.16,
   "end": 5.5,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.5,
   "end": 10.38,
   "text": "المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.38,
   "end": 13.18,
   "text": "پرسیدن که اولا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.18,
   "end": 16.96,
   "text": "در پس شنیدن هر کدوم از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.96,
   "end": 20.36,
   "text": "حالا صحبت‌ها، وویس‌ها، این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.36,
   "end": 23.66,
   "text": "صحبت‌هایی که بعضاً سخنرانی‌هایی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.66,
   "end": 28.52,
   "text": "کانال دوستان بارگذاری می‌کنند چه در هئیت یا زهرا، چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.52,
   "end": 32.38,
   "text": "صدا و سیما یا هر جای دیگه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.38,
   "end": 37.0,
   "text": "سؤالات زیادی فوران می‌کنه تو ذهنمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.0,
   "end": 41.22,
   "text": "و این ضعف نیست. این رو دقت داشته باشن عزیزان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.22,
   "end": 44.16,
   "text": "اتفاقاً وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.16,
   "end": 47.08,
   "text": "درست داریم پیش میریم چه در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.08,
   "end": 49.18,
   "text": "شنیدن، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.18,
   "end": 51.62,
   "text": "در مسیر گویش؛ یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.62,
   "end": 56.12,
   "text": "چه اون کسی که داره بیان می‌کنه در مرحله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.12,
   "end": 61.84,
   "text": "در حقیقت سطح ابلاغ قرار گرفته که کار انبیا رو می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.84,
   "end": 67.84,
   "text": "چه اون در نوع کلمات و پیاده کردن مطالب و حقایق، چه کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.84,
   "end": 74.02,
   "text": "داره می‌شنوه که اگر هر دو درست عمل کنن قطعاً نتیجه‌ش باید بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.02,
   "end": 78.14,
   "text": "سؤالات متعدد. این باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.14,
   "end": 85.6,
   "text": "که البته از تعلم حسن‌زاده همیشه توصیه می‌کنند که در سؤال پرسیدن عجله نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.6,
   "end": 87.98,
   "text": "بذارید سؤال‌ها پخته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.98,
   "end": 92.2,
   "text": "چه بسا تو شنیده‌های فردا، پس فردا اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.2,
   "end": 94.84,
   "text": "در آینده این سؤال برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.84,
   "end": 97.88,
   "text": "و ضمن اینکه بعضی سؤالات اصلاً وسوسه شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.88,
   "end": 101.32,
   "text": "میاد که شما رو از اصل موضوع دور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.32,
   "end": 104.16,
   "text": "ذهنتونو مشغول این سؤال می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.16,
   "end": 106.52,
   "text": "لذا اون سؤالی سؤاله که پخته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.52,
   "end": 108.6,
   "text": "یعنی مدت‌ها تو وجودت بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.6,
   "end": 112.5,
   "text": "گاهی سؤالات می‌بینی چند سال تو وجودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.5,
   "end": 116.56,
   "text": "ضمن اینکه پاسخ گفتن به سؤالات هم حریم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.56,
   "end": 120.78,
   "text": "به قول حضرت علامة تا شنیدی پاسخ بدی این حریم سؤال حفظ نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.78,
   "end": 126.46,
   "text": "باید متمرکز بشی، متوجه بشی، تأمل کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 126.46,
   "end": 131.18,
   "text": "معمولاً در دعای بزرگان این نبوده که تا سؤال رو شنیدن جواب بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.18,
   "end": 133.42,
   "text": "مگر ائمه هدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.42,
   "end": 135.78,
   "text": "مثلاً دومی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.78,
   "end": 142.0,
   "text": "مولا も ん علی علیه صلوة الله سلام گفت شما چطور تا سؤال ازت می‌پرسن تأمل نمی‌کنی جواب میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.0,
   "end": 144.06,
   "text": "فرمود چند تا انگشت تو یه دستته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.06,
   "end": 147.0,
   "text": "گفت پنج تا. حضرت فرمود چرا تأمل نکردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 147.0,
   "end": 150.22,
   "text": "گفت این دیگه بدیهی بود. حضرت فرمود برای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.22,
   "end": 153.6,
   "text": "همه چی بدیهیه، از بدیهیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.6,
   "end": 162.78,
   "text": "این فقط اون‌ها بقیه باید حریم نگه دارن، تأمل کنن، توجه کنن، اهل تدقق باشن، نه فقط دقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.78,
   "end": 165.88,
   "text": "و ضمن اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.88,
   "end": 171.22,
   "text": "اتفاقاً ما بر اساس فرمایش بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.22,
   "end": 178.24,
   "text": "نوع مطالب و مباحث و مفاهیمی که داره منتقل میشه رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.24,
   "end": 182.84,
   "text": "این جهت، یعنی از این نگاه وقتی می‌بینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.84,
   "end": 185.52,
   "text": "وقتی این رو درست می‌بینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.52,
   "end": 191.08,
   "text": "این ازدواج حروف و تشکیل کلمات و ازدواج کلمات و تشکیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.08,
   "end": 196.88,
   "text": "جملات، ازدواج جملات و تشکیل مفاهیم و مضامین بی‌نهایت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.88,
   "end": 204.16,
   "text": "که سبحان الذي خلق الازواج کلها همه چی زوج زوجه و الا به نتیجه نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.16,
   "end": 208.04,
   "text": "لذا انسانی که مزدوج نیست مجرده ملعونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.04,
   "end": 210.14,
   "text": "یعنی از رحمت خدا به دوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.14,
   "end": 215.12,
   "text": "این وقتی درست چینش شدن مزدوج شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.12,
   "end": 218.66,
   "text": "که اتفاقاً با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.66,
   "end": 221.84,
   "text": "مستمع کاری رو بکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.84,
   "end": 225.32,
   "text": "که مستمع کاملاً پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.32,
   "end": 228.54,
   "text": "یعنی تخلیه کامل صورت بگیره و منفجر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.54,
   "end": 230.82,
   "text": "سلام هیه حتى مطلع الفجر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.82,
   "end": 234.56,
   "text": "این مطلع فجر از تعالمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.56,
   "end": 237.26,
   "text": "انفجار گرفتن، انفجار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.26,
   "end": 241.64,
   "text": "صبح ظهور انفجار صورت می‌گیره در دل‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.64,
   "end": 245.52,
   "text": "در حقیقت سخنرانی خوبه که انسان رو منفجر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.52,
   "end": 249.54,
   "text": "یا بشینه یه صحبتی بشنوه که کاملاً تکراری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.54,
   "end": 254.0,
   "text": "کاملاً مورد پسند سطح فکر و خیال و وهم تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.0,
   "end": 256.24,
   "text": "این که دیگه هنر نشد که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.24,
   "end": 260.94,
   "text": "خب بریم یه داستان گو اجیر کنیم همش برا ما داستان بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.94,
   "end": 265.5,
   "text": "اتفاقاً قصه‌های قرآنی هم که می‌فرماید واقصص القصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.5,
   "end": 268.52,
   "text": "قصه کن قصه‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.52,
   "end": 276.26,
   "text": "بعد می‌فرماید برای اینکه به فکر بیفته، یعنی فکر شما، فکر شما یعنی داستان‌ها و قصه‌های قرآنی به گونه‌ست که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.26,
   "end": 280.2,
   "text": "به گونه‌ایه که یک یک این‌ها شما رو به تأمل و تفکر وا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.2,
   "end": 284.96,
   "text": "یعنی داستان، قصه، حکایت اینا باید بیاد تم-تمثیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.96,
   "end": 288.5,
   "text": "به کمک مبانی عقلی و فکری برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 288.5,
   "end": 292.4,
   "text": "به کمک اونا بیاد. که اگر غیر از این باشه وقت تلف کنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.4,
   "end": 295.48,
   "text": "رمان خوندن خیلی موقع‌ها خیال انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.48,
   "end": 298.58,
   "text": "به تشویش می‌کشونه و دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.58,
   "end": 301.78,
   "text": "مفسده‌های خیالی می‌کنه انسان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.78,
   "end": 304.8,
   "text": "اتفاقاً در حالات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.8,
   "end": 311.88,
   "text": "عرض شود حاجی سبزواری علیه الرحمه میگن انقدر وقتی صحبت می‌کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.88,
   "end": 314.96,
   "text": "ایشون حاج ملا حسین قلی همدانی اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.96,
   "end": 318.92,
   "text": "در حالاتشون میگن وقتی صحبت می‌کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.92,
   "end": 326.38,
   "text": "مخصوصاً حاجی سبزواری، متأله سبزواری علیه الرحمه که حالا متأله که میگن چون ایشون فیلسوف بودن یا حکیم بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.38,
   "end": 330.6,
   "text": "متأله یعنی اینکه فیلسوفی که عارف هم هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.6,
   "end": 333.54,
   "text": "یعنی الهی بودن، فیلسوف الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.54,
   "end": 336.2,
   "text": "الهیات فلسفه. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.2,
   "end": 338.2,
   "text": "ایشون اصلاً یه جا نمیشست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.2,
   "end": 342.54,
   "text": "به گونه‌ای صحبت می‌کرد در خودش چنان تأثیر می‌گذاشت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.54,
   "end": 347.06,
   "text": "اون جلالت بحث خودش رو هم می‌گرفت یا بلند می‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 347.06,
   "end": 350.26,
   "text": "یا می‌رفت مثلاً یه مقدار اونورتر دوباره می‌نشست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.26,
   "end": 352.88,
   "text": "یه حالات عجیبی که حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.88,
   "end": 359.8,
   "text": "شش تا از شاگردان عجیب ایشون دیگه رفتن اصلاً زدن به بیابون‌ها و دیگه معلوم نشد تکلیفشون چی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.8,
   "end": 363.59,
   "text": "یا در حالات ایشون یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.59,
   "end": 368.27,
   "text": "ملا حسین‌قلی همدانی اینا که مثلا پنج شنبه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 368.27,
   "end": 372.55,
   "text": "قبل ظهر در حرم مولامون علی جلوی اون طلا مثلا درس و بحث داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 372.55,
   "end": 378.17,
   "text": "طلاب می‌اومدن مردم عادی که حالا آشنا بودن با همین مباحث می‌اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.17,
   "end": 382.21,
   "text": "مثلا درس اخلاق ایشون یا مباحث اعتقادی و حکمیشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.21,
   "end": 385.03,
   "text": "می‌گن اصلا وقتی درس ایشون تموم می‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.03,
   "end": 388.53,
   "text": "کسی وارد حرم مولا می‌شد، می‌دید یه حالت عجیبی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.53,
   "end": 390.47,
   "text": "اصلا هیچکس سر جای خودش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.47,
   "end": 395.49,
   "text": "همه یکی داره می‌خنده، یکی داره گریه می‌کنه، یکی سرش رو تکون میده، یکی داره قدم می‌زنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.49,
   "end": 398.01,
   "text": "یکی داره میدوه. اصلا یه وضعیتی تو حرم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.01,
   "end": 402.27,
   "text": "چه خبره؟ می‌گفتن مثلا درس ایشون تموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.27,
   "end": 408.05,
   "text": "به هر حال. و جالبه که خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 408.05,
   "end": 412.79,
   "text": "استاد، استاد حضرت آیت الله علامه‌ حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.79,
   "end": 417.21,
   "text": "بارها عرض کردیم که عرض شود خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.21,
   "end": 421.37,
   "text": "حضرت آشیخ نمتقی آملی ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 421.37,
   "end": 425.79,
   "text": "خودشون فرموده بودن که من وقتی رفتم به نجف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 425.79,
   "end": 433.13,
   "text": "خب می‌رفتم درس و بحث‌های علما اینا می‌شستم حرفای خوبی می‌زدن اما اونطور که منو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.13,
   "end": 436.29,
   "text": "یعنی پیاده کنه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.29,
   "end": 438.75,
   "text": "احساس حالا به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 438.75,
   "end": 441.39,
   "text": "سهولت فهم عرض کنم بی‌سوادی بهم دست بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 441.39,
   "end": 447.17,
   "text": "این‌ها، این حالت نبود. تا اینکه رفتم محضر یه عزیزی نشستم زانو زدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.17,
   "end": 450.27,
   "text": "ایشون اصلا یه کاری با ما کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.27,
   "end": 454.77,
   "text": "که ک-- اصلا چلوند ما رو به تعبیر ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.77,
   "end": 457.39,
   "text": "که حالا ایشون کی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.39,
   "end": 461.19,
   "text": "حضرت آقای قاضی، آستاد علی قاضی می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.19,
   "end": 464.31,
   "text": "آشیخ نمتقی آملی می‌فرمود که دیگه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.31,
   "end": 470.23,
   "text": "متوجه شدم که ایشون به درد من می‌خوره همین راه رو ادامه دادم و همین طریق رو با ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.23,
   "end": 475.23,
   "text": "اصلا راه اینه. غیر از این باشه اینا که از مباحث عقلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.23,
   "end": 477.91,
   "text": "عقل رو برای جاهاى دشوار گذاشتن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.91,
   "end": 481.31,
   "text": "مباحث عقلی، فکری، سخت، اینا دشوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 481.31,
   "end": 485.31,
   "text": "فرار می‌کنند. دارند از حقیقت وجودی خودشون فرار می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 485.31,
   "end": 489.15,
   "text": "پس این رو فراموش نکنیم. البته این رو هم عرض کنم در انتها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 489.15,
   "end": 492.61,
   "text": "این در حقیقت زحمت می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.61,
   "end": 499.79,
   "text": "کار یک عمره. می‌دونید عزیزان باید یک عمر زحمت کشید تلاش کرد تا آرامید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.79,
   "end": 502.69,
   "text": "تا آرامید. خدا رحمت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.69,
   "end": 505.09,
   "text": "ملا حسین‌قلی همدانی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.09,
   "end": 507.73,
   "text": "حدود بیست و سه چهار سالگیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 507.73,
   "end": 510.37,
   "text": "تونستن به طهارت محض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 510.37,
   "end": 514.35,
   "text": "وجودشون برسن و چشمشون باز بشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 514.35,
   "end": 518.23,
   "text": "بیست و چهار سال طول کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 518.23,
   "end": 522.15,
   "text": "بیست و چهار سال ایشون زحمت کشیدن تا به اون مدارج برسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 522.15,
   "end": 530.83,
   "text": "حالا داستانی داره که در حیاط خونه‌شون داشتن به مولا علی علیه‌السلام در نجف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.83,
   "end": 534.35,
   "text": "گلایه می‌کردن. یه دفعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 534.35,
   "end": 538.61,
   "text": "یه پرنده‌ای که حاطفی از غیب بود اومد تو گوشه حیاط ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.61,
   "end": 541.77,
   "text": "شروع کرد nok زدن به یه نون خشکی که گوشه افتاده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.77,
   "end": 543.95,
   "text": "هی رفت اومد دید خیلی سفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.95,
   "end": 545.69,
   "text": "دوباره برگشت رفت برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 545.69,
   "end": 547.67,
   "text": "اینقدر اومد nok زد تا خوردش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 547.67,
   "end": 550.49,
   "text": "مقداری خورد و رفت. ملهم شد ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 550.49,
   "end": 555.61,
   "text": "متوجه شد که منظور از این یعنی مولا داره بهش درس میده که باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 555.61,
   "end": 559.71,
   "text": "تلاش کنی زحمت بکشی تا به موقعش، تا به موقعش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.71,
   "end": 564.77,
   "text": "حتی آقای قاضی هم چهل سال می‌فرمایند من تسویه کردم خودم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 564.77,
   "end": 571.55,
   "text": "اما خبری نشد تا تو حرم حضرت عباس صلوات الله علیه توسل به آقا کردم و گفتم آقا چرا خبر نمیشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.55,
   "end": 578.69,
   "text": "دیگه داشتم ناامید می‌شدم تا پرده‌ها برام کنار رفت و ابا رو سر کشیدم دیدم می‌بینم چیزی رو که احدی نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 578.69,
   "end": 582.83,
   "text": "رفتم به منزل. بعد چهل سال تلاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.83,
   "end": 588.05,
   "text": "ملا حسین‌قلی همدانی بعد از بیست و چهار سال، نه بیست و چهار سالگی اشتباه نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 588.05,
   "end": 590.61,
   "text": "بعد از بیست و چهار سال تلاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 590.61,
   "end": 592.47,
   "text": "این زمان می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 592.47,
   "end": 595.95,
   "text": "تسویه قوای وجود خصوصا قوه خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.95,
   "end": 598.31,
   "text": "تلاش می‌خواد کار یک عمره عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 598.31,
   "end": 600.91,
   "text": "نباید خسته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 600.91,
   "end": 605.21,
   "text": "لا حول و لا قوه الا بالله العلی العظیم گفت و حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 605.21,
   "end": 607.81,
   "text": "از تو حرکت از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 607.81,
   "end": 610.71,
   "text": "برکت. والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}