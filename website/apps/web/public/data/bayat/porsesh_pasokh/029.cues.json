 "chapters": [
  {
   "index": 0,
   "title": "## پرسش از حقیقت استقامت",
   "start": 7.12,
   "end": 143.9
  },
  {
   "index": 1,
   "title": "## استقامت در تفسیر صافی و تبیان",
   "start": 143.9,
   "end": 219.96
  },
  {
   "index": 2,
   "title": "## استقامت در المیزان و مجمع البیان",
   "start": 219.96,
   "end": 289.1
  },
  {
   "index": 3,
   "title": "## عمل در الکاشف و نکات تفسیر نور",
   "start": 289.1,
   "end": 543.21
  },
  {
   "index": 4,
   "title": "## پایمردی در تفسیر نمونه",
   "start": 543.21,
   "end": 665.83
  },
  {
   "index": 5,
   "title": "## مقام امن در مخزن العرفان",
   "start": 665.83,
   "end": 880.72
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.68,
   "end": 7.12,
   "text": "بسم الله و بالله و على ملة رسول الله المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.12,
   "end": 10.12,
   "text": "عزیزی پرسیده که بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.12,
   "end": 17.44,
   "text": "اون بحثی که ذیل آیه \"واستقم كما أمرت يا الذين قالوا ربنا الله ثم استقاموا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.44,
   "end": 22.72,
   "text": "تتنزل عليهم الملائكة\" آیه سی سوره فصلت باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.72,
   "end": 25.9,
   "text": "شما اونجا مطرح کردید و یادم هست در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.9,
   "end": 32.42,
   "text": "بحث شریف و شیرین نامه‌ها بر نامه‌های حضرت استاد در دهه فاطمیه این بحثو ما داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.42,
   "end": 34.9,
   "text": "حالا پرسشی کردن که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.9,
   "end": 39.74,
   "text": "این چنینه اگه در پس استقامت ملائکه نازل می‌شوند و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.74,
   "end": 41.92,
   "text": "پرسیدن که منظور از استقامت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.92,
   "end": 46.64,
   "text": "و آیا ما در عقاید و نماز و روزه و این‌هامون که مستقیم هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.64,
   "end": 51.92,
   "text": "این همون استقامت حساب می‌شود یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.92,
   "end": 56.72,
   "text": "حالا عرض کنم که ببینید به هر میزانی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.72,
   "end": 67.42,
   "text": "در مسیر پیاده کردن الله که اسم جمع است با توجه به اون مباحث که اون شب عرض کردیم در حیاط یا زهرا شهر در فاطمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.42,
   "end": 69.84,
   "text": "چون می‌فرماید قالوا ربنا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.84,
   "end": 77.18,
   "text": "الله اسم جمع مستجمع جمع اسماء یعنی ما به هر میزان که متلبس به اسماء الله بشویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.18,
   "end": 79.96,
   "text": "به همون مقدار خب بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.96,
   "end": 83.76,
   "text": "استقامت ورزیدیم و ملائکه به همون میزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.76,
   "end": 88.78,
   "text": "بر ما نازل می‌شوند و صاع وجودی ما و رتبه ما درجه ما همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.78,
   "end": 91.8,
   "text": "هر مقدار که اسما در ما شدت بگیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.8,
   "end": 96.44,
   "text": "شدیدتر پیاده بشن که ما اجتهاد وجودی پیدا کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.44,
   "end": 99.68,
   "text": "و لب وجودمون گل بندازه به قول معروف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.68,
   "end": 101.68,
   "text": "حالا اینجا اگر بخواهیم این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.68,
   "end": 109.54,
   "text": "مثلا بازترش کنیم، همه فهم‌ترش کنیم این همین جمله که من گفتم تمامه دیگه، دیگه اصل مطلب رو عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 109.54,
   "end": 116.24,
   "text": "اما خب حالا بالاخره ما در عقایدمون هم که پافشاری داریم تخطی نمی‌کنیم یا در اقامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.24,
   "end": 119.74,
   "text": "واجبات و ترک نواهی الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 119.74,
   "end": 122.06,
   "text": "مستقیم هستیم اینا بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 122.06,
   "end": 123.94,
   "text": "مصداق این استقامت می‌شود یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.94,
   "end": 127.34,
   "text": "بله چرا نمی‌شود؟ منتها خب هرکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.34,
   "end": 131.04,
   "text": "به وزان صاع وجودی خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.04,
   "end": 133.84,
   "text": "حالا اصل این استقامت چگونه هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.84,
   "end": 141.38,
   "text": "آیا مثلا تعریفی به صورت جداگانه و جدی از سمت ناحیه اهل بیت علیهم الصلاة والسلام یا اولیاء خدا شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.38,
   "end": 143.54,
   "text": "بله چرا نشده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.54,
   "end": 149.6,
   "text": "مثلا در تفسیر صافی اونجا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.6,
   "end": 152.96,
   "text": "علی-- اونجا در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.96,
   "end": 157.46,
   "text": "موضوع یعنی اساسا این منظور از استقامت چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.46,
   "end": 162.24,
   "text": "می‌فرماید ولایت امیر المؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.24,
   "end": 168.62,
   "text": "که یعنی اونچه که در مسیر ولایت یعنی التزام عملیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.62,
   "end": 172.84,
   "text": "که حالا اینو تو سه قسم بعضی از علمای اخلاق باز کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.84,
   "end": 175.0,
   "text": "هم در عمل به ارکان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.0,
   "end": 179.12,
   "text": "هم در قلب یعنی دوست داشتن قلبی، هم در اقرار به لسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.12,
   "end": 182.46,
   "text": "در این سه وجه ارکان سه وجهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.46,
   "end": 188.92,
   "text": "به هر میزان که ما مقید باشیم، التزام عملی داشته باشیم به همان مقدار ما استقامت ورزیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.92,
   "end": 191.16,
   "text": "در تفسیر مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.16,
   "end": 195.38,
   "text": "الطبیان اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.38,
   "end": 198.46,
   "text": "فرمودن که کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.46,
   "end": 201.28,
   "text": "توحید رو به لسانش جاری کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.28,
   "end": 207.08,
   "text": "و انبیاء پیشین رو تصدیق کنه و بشناسه حق خدا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 207.08,
   "end": 211.14,
   "text": "که چنین کسی در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.14,
   "end": 213.46,
   "text": "استقامت قرار گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.46,
   "end": 217.74,
   "text": "و استقامتش به میزان اطاعت الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.74,
   "end": 221.04,
   "text": "اینم یک معنا. یا مثلا در تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.04,
   "end": 224.52,
   "text": "المیزان مرحوم علامه طباطبایی علیه رحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.52,
   "end": 229.7,
   "text": "اونجا فرمودن که کلمه استقامت در اصل در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.7,
   "end": 231.86,
   "text": "طریقی به کار می‌رفته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.86,
   "end": 239.48,
   "text": "به خط مستقیم کشیده شده باشد و در آیه \"اهدنا الصراط المستقيم\" حق را به چنین راهی تشبیه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.48,
   "end": 248.46,
   "text": "سپس می‌گوید و استقامت انسان به این معنی است که همواره ملازم طریقه مستقیم باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.46,
   "end": 255.6,
   "text": "که خدای تعالی درباره چنین انسان‌هایی فرموده است \"إن الذين قالوا ربنا الله ثم استقاموا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 255.6,
   "end": 258.22,
   "text": "که حالا منظورشون اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.22,
   "end": 260.7,
   "text": "در همون مسیر هدایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.7,
   "end": 263.5,
   "text": "و مسیر مستقیم یعنی یک راه بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 263.5,
   "end": 265.66,
   "text": "نمیشه که انسان گاهی این ور گاهی اون ور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.66,
   "end": 268.26,
   "text": "نه، یک راه بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.26,
   "end": 273.48,
   "text": "در همون مسیر توحید، وحدت، وحدت قرار بگیره که حالا بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.48,
   "end": 280.1,
   "text": "لسان سهاه مثلا اهل تسنن هم میاره که به معنای اعتدال میگیره این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.1,
   "end": 284.14,
   "text": "عرض شود استقامت رو به معنای اعتدال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.14,
   "end": 286.9,
   "text": "حالا معانی دیگه‌ای هم میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.9,
   "end": 288.54,
   "text": "ما فعلا با اون کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 288.54,
   "end": 294.02,
   "text": "یا مثلا در تفسیر عرض شود خدمتتون مجمع البیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.02,
   "end": 297.14,
   "text": "اونجا فرمودن که یعنی ادامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.14,
   "end": 300.34,
   "text": "دادن به این عقیده و اعتراف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 300.34,
   "end": 306.68,
   "text": "به کدوم عقیده و اعتراف؟ به این که پروردگارشان خدای یکتا و بی شریک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 306.68,
   "end": 312.66,
   "text": "یعنی تو مجاهدت زندگیشون، جهاد زندگیشون این عقیده رو ادامه دادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.66,
   "end": 315.94,
   "text": "نوسان نداشتن. یه روز با ایمان، یه روز با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.94,
   "end": 319.94,
   "text": "مثلا کـ-- با اهل ایمان، یکی با-- یه روز با اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.94,
   "end": 324.24,
   "text": "کفر و شرک و نفاق. اینچنین نبودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 324.24,
   "end": 328.8,
   "text": "همچنین فرمودن که در ادامه در همین تفسیر، تفسیر مجمع البیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.8,
   "end": 331.6,
   "text": "فرمودن که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.6,
   "end": 336.12,
   "text": "همچنین در اعمال، استقامت در اعمال یعنی در اعمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 336.12,
   "end": 342.72,
   "text": "انسان‌های مستقیمی باشند، مستقیمی باشند، محکم باشند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 342.72,
   "end": 346.78,
   "text": "و اعمال عبادیشون رو به نحو احسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 346.78,
   "end": 350.18,
   "text": "انجام بدن. و یک روایت شیرینی هم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 350.18,
   "end": 355.38,
   "text": "رسول خدا در ذیل این آیه آوردن که فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 355.38,
   "end": 361.48,
   "text": "کسانی گفتن که پروردگار ما خداست ولی بیشتر آنان بعدا کافر شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.48,
   "end": 366.43,
   "text": "یعنی بیشتر اینایی که گفتن، قالو گفتن اینو اما کافر شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.43,
   "end": 371.25,
   "text": "هر کس این اعتراف را تا دم مرگ داشته باشد از کسانی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 371.25,
   "end": 374.11,
   "text": "کا-- بر این عقیده استقامت نموده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 374.11,
   "end": 376.97,
   "text": "پس بر اساس این فرمایش پیغمبر باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.97,
   "end": 380.81,
   "text": "یعنی اون مصداق استقامت می‌شود تا لب مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 380.81,
   "end": 387.15,
   "text": "انسان تا لحظه‌ای که موت رو می‌چشه این رو با خودش، این حقیقت توحیدی رو، این التزام عملیه رو داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.15,
   "end": 390.15,
   "text": "یا از باز در همین تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.15,
   "end": 396.91,
   "text": "از آقامون امام رضا صلوات الله علیه شخصی به نام محمد فضیل پرسید در خصوص استقامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 396.91,
   "end": 399.49,
   "text": "امام الرؤوف فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 399.49,
   "end": 404.89,
   "text": "به خدا سوگند استقامت همین ولایتی‌ست که شما شیعیان دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 404.89,
   "end": 407.09,
   "text": "پس منظور از استقامت همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 407.09,
   "end": 409.59,
   "text": "شاکر باشیم و قدردانش باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.59,
   "end": 413.25,
   "text": "در مسیر ولایت بودن. در تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.25,
   "end": 417.69,
   "text": "چـ-- الکاشف چگونه بیان شده موضوع استقامت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 417.69,
   "end": 420.15,
   "text": "در تفسیر الکاشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 420.15,
   "end": 422.77,
   "text": "فرمودند که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 422.77,
   "end": 430.07,
   "text": "آیه «إن الذين قالوا ربنا الله ثم استقاموا» دلیل روشن و محکمی‌ست بر اینکه عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 430.07,
   "end": 434.59,
   "text": "تنها پدیده‌ایست که ایمان به خدا را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 434.59,
   "end": 438.17,
   "text": "در حقیقت و واقع منعکس می‌‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 438.17,
   "end": 441.75,
   "text": "و اینکه هر انسانی که بگوید من مؤمن هستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 441.75,
   "end": 446.07,
   "text": "اما ایمانش را به رفتار و عمل در ارتباطش با خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 446.07,
   "end": 451.39,
   "text": "در ارتباطش با خدای من و با خودش و با جامعه‌ش تبدیل نکند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 451.39,
   "end": 456.07,
   "text": "کذاب و دروغگوست. می‌فرماید سخن زایدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 456.07,
   "end": 459.27,
   "text": "یعنی می‌گه که این باید در عمل پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 459.27,
   "end": 464.77,
   "text": "و ادامه می‌ده که مقصود قرآن از عمل، عمل ارزشمند و مفید است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 464.77,
   "end": 468.33,
   "text": "و هر سخنی که پیامدش این عمل باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 468.33,
   "end": 471.03,
   "text": "اونم چی می‌شه؟ در حکم همان عمل خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 471.03,
   "end": 473.59,
   "text": "یعنی همون موضوع استقامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 473.59,
   "end": 478.93,
   "text": "پس در تفسیر الکاشف بیشتر حول موضوع عمل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 478.93,
   "end": 483.21,
   "text": "استقامت رو پیاده کرده. در تفسیر نور آقای قراتی چه طور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 483.21,
   "end": 489.59,
   "text": "فرمودند استقامت در کنار ایمان ارزش است وگرنه کفار نیز بر باطل خود استقامت دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 489.59,
   "end": 493.03,
   "text": "پس موضوع اینج-- استقامته در اینجا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 493.03,
   "end": 495.75,
   "text": "ایمانه، دلدادگیه به حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.75,
   "end": 504.67,
   "text": "نکته دوم گفتند خالق، خالق بودن خدا را بسیاری قبول دارند ولی در تدبیر امور پای دیگران را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 504.67,
   "end": 510.03,
   "text": "به میان می‌آورند. مهم آن است که انسان در ربوبیت خداوند مقاومت کند؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 510.03,
   "end": 514.97,
   "text": "یعنی هیچ قانون و برنامه‌ای را غیر از خدا نپذیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 514.97,
   "end": 520.43,
   "text": "و نکته سوم که آقای قراتی فرمودند استقامتی ارزشمند است که طولانی باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 520.43,
   "end": 522.27,
   "text": "یعنی همون چون می‌فرماید «ثمه».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 522.27,
   "end": 524.33,
   "text": "کلمه «ثمه» استدراجه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 524.33,
   "end": 527.31,
   "text": "زمان و فاصله دور رو مثلاً میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 527.31,
   "end": 531.55,
   "text": "یعنی منظور ایشون این القای این حقیقت است که انسان بکشونش تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 531.55,
   "end": 536.69,
   "text": "وضعیت، تا حالت موتش، تا مرگش استقامت رو داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 536.69,
   "end": 540.35,
   "text": "که اگر نداشته باشه این استقامت منظور این آیه نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 540.35,
   "end": 543.21,
   "text": "و تنزلی از سوی ملائکه رخ نمی‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 543.21,
   "end": 546.99,
   "text": "تفسیر نمونه چه فرمودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 546.99,
   "end": 549.57,
   "text": "در تفسیر نمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 549.57,
   "end": 557.93,
   "text": "فرمودند که بعد از اینکه این آیه رو قرائت می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 557.93,
   "end": 566.23,
   "text": "می‌فرمایند که شما گفتید پروردگار ما الله است، اکنون بر سر این سخن پایمردی کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 566.23,
   "end": 568.75,
   "text": "بر انجام دستورهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 568.75,
   "end": 572.31,
   "text": "کتاب او و در راهی که فرمان داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 572.31,
   "end": 574.87,
   "text": "دقت بفرمایید چی داره می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 574.87,
   "end": 579.27,
   "text": "داره می‌گه که حالا اشاره داره به یکی از خطبه‌های مولامون علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 579.27,
   "end": 581.97,
   "text": "علیه الصلاة والسلام که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 581.97,
   "end": 584.69,
   "text": "در ذیل همین آیه شریفه پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 584.69,
   "end": 588.45,
   "text": "فرموده شما که ادعا کردید پروردگار ما اللهه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 588.45,
   "end": 591.01,
   "text": "اکنون بر سر این سخن پایمردی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 591.01,
   "end": 593.47,
   "text": "حالا این حرفو که زدید گفتید الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 593.47,
   "end": 596.37,
   "text": "محکم سر این حرفتون باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 596.37,
   "end": 600.27,
   "text": "چگونه باشیم؟ بر انجام دستورهای کتاب او؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 600.27,
   "end": 602.45,
   "text": "یعنی التزام به قرآن داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 602.45,
   "end": 604.27,
   "text": "یعنی قرآن پیاده بشه تو زندگیتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 604.27,
   "end": 610.71,
   "text": "این معنای استقامت از نگاه مولامون علی علیه الصلاة والسلام هست در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 610.71,
   "end": 613.43,
   "text": "تفسیر نمونه بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 613.43,
   "end": 616.29,
   "text": "و البته باز ادامه داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 616.29,
   "end": 618.49,
   "text": "که همین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 618.49,
   "end": 626.09,
   "text": "همین مبحث رو ادامه داده که فرموده و در طریق پرستش شایسته او استقامت به خرج بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 626.09,
   "end": 633.87,
   "text": "یعنی پرستشتون شایسته مقام حضرت حق باشه و البته از دایره فرمانش خارج نشوید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 633.87,
   "end": 638.53,
   "text": "در آیین او بدعت نگذارید و هرگز با او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 638.53,
   "end": 642.19,
   "text": "مخالفت نکنید. بعد دوباره البته در همین حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 642.19,
   "end": 646.03,
   "text": "تفسیر نمونه، حدیثی رو از پیامبر عظیم الشأن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 646.03,
   "end": 649.51,
   "text": "اسلام آورده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 649.51,
   "end": 652.39,
   "text": "وقتی این آیه رو تلاوت کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 652.39,
   "end": 658.93,
   "text": "فرمودند که باز همون رو که گروهی این سخن رو گفتن اما بعداً به کفر کشیده شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 658.93,
   "end": 663.27,
   "text": "اما شما باید چی کار کنید؟ این رو ادامه بدید تا لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 663.27,
   "end": 665.21,
   "text": "فرا رسیدن مرگتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 665.21,
   "end": 669.35,
   "text": "و حالا تفاسیر دیگه‌ای هم مطالب دیگه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 669.35,
   "end": 674.21,
   "text": "فرمودن مثل مخزن العرفان، تفسیر مخزن العرفان تفسیر خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 674.21,
   "end": 676.63,
   "text": "شیرینیه. به اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 676.63,
   "end": 679.71,
   "text": "می‌فرماید بعد از اینکه حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 679.71,
   "end": 686.37,
   "text": "بیان تیره بختی و عذاب کفار و حالا اینی که و مترتب بر اعمال و افعال نکوده شون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 686.37,
   "end": 689.61,
   "text": "نکوهیده اون‌ها بوده مطرح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 689.61,
   "end": 694.43,
   "text": "می‌فرماید که میاد وارد مقام اوصاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 694.43,
   "end": 698.93,
   "text": "مؤمنین و اهل تقوا که می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 698.93,
   "end": 704.05,
   "text": "در مسیر ربوبیت حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 704.05,
   "end": 709.17,
   "text": "خدا رو مربی معرفی می‌کنه و استقامت رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 709.17,
   "end": 713.25,
   "text": "اینکه کسی استقامت به خرج بده در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 713.25,
   "end": 718.85,
   "text": "حضرت حق به همون وظایف ایمانیش و ثبات قدمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 718.85,
   "end": 721.09,
   "text": "در مسیر می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 721.09,
   "end": 726.05,
   "text": "که حالا بعد اشاره می‌کنه به آیه «إن المتقین في مقام امین».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 726.05,
   "end": 729.1,
   "text": "دقت بفرمایید «في مقام امین».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 729.1,
   "end": 733.24,
   "text": "در یک مقامی‌اند. یعنی قیام کرده این حقایق در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 733.24,
   "end": 735.84,
   "text": "وجود اون‌ها. این رو استقامت می‌شماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 735.84,
   "end": 739.66,
   "text": "یعنی حال نیست. حال میاد میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 739.66,
   "end": 745.38,
   "text": "حال رفتنی‌ست. حالا احتمال داره به قول حضرت استاد یه وقت عالم میتی رو ببینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 745.38,
   "end": 748.96,
   "text": "غسالخونه‌ای بره، یه مصیبتی بهش وارد بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 748.96,
   "end": 753.94,
   "text": "اتفاقی بیفته، یه مثلاً زیارتگاهی بره، هیئتی بره، یه حالی بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 753.94,
   "end": 762.06,
   "text": "اما حال از بین میره. وقتی رفت تو بازار، رفت تو دل کسب و کاسبی و چه می‌دونم این‌ها اجتماع این حال رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 762.06,
   "end": 764.78,
   "text": "اینجا در این تفسیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 764.78,
   "end": 768.48,
   "text": "در تفسیر مظهر العرفان نکته‌ی جالبی رو اشاره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 768.48,
   "end": 771.6,
   "text": "می‌فرماید اشاره به ان المتقین فی مقام امین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 771.6,
   "end": 774.86,
   "text": "می‌فرماید که در یک مقام امنی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 774.86,
   "end": 780.86,
   "text": "یعنی اون استقامت به جایی می‌انجامد که انسان به اون مقام یعنی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 780.86,
   "end": 783.78,
   "text": "قیام می‌کنه این حقایق در وجود انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 783.78,
   "end": 786.24,
   "text": "یعنی کسی من و شما رو دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 786.24,
   "end": 790.94,
   "text": "یاد خدا می‌کنه. می‌گه خدا رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 790.94,
   "end": 795.48,
   "text": "این چنین. یعنی متذکر می‌شه حضرت حق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 795.48,
   "end": 798.24,
   "text": "خب به همین مقدار بسنده می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 798.24,
   "end": 800.82,
   "text": "ما خودمون هم بهره بردیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 800.82,
   "end": 806.08,
   "text": "خوانش مجدد این روایات شیرین و حقایقی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 806.08,
   "end": 809.64,
   "text": "تفاسیر، تفاسیر خیلی خوب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 809.64,
   "end": 814.4,
   "text": "جامع ما از میان علمای شیعه وارد شده که واقعاً نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 814.4,
   "end": 817.02,
   "text": "اندر نورند. نوراً علی نورند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 817.02,
   "end": 823.08,
   "text": "و هر چقدر که ما از این تفاسیر فاصله می‌گیریم از حقیقت خودمون فاصله می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 823.08,
   "end": 826.76,
   "text": "و البته این‌ها باز همونطور که حضرت استاد علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 826.76,
   "end": 829.78,
   "text": "علیه الرحمه فرمودن این‌ها تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 829.78,
   "end": 833.6,
   "text": "آفاقی‌اند. چه‌خشک انسان وارد بشه بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 833.6,
   "end": 837.4,
   "text": "تفسیر انفسی و سیر انفسی کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 837.4,
   "end": 842.02,
   "text": "و به یک معنا از ظاهر به باطن سفر کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 842.02,
   "end": 845.1,
   "text": "و قرآن رو در خودش بیابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 845.1,
   "end": 848.06,
   "text": "عالم نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 848.06,
   "end": 850.42,
   "text": "ملک و ملکوت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 850.42,
   "end": 854.74,
   "text": "جبروت و لاهوت و این‌ها رو همه رو در خودش بیابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 854.74,
   "end": 857.94,
   "text": "و در اون کانال وجودی خودش این‌ها رو پیاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 857.94,
   "end": 861.62,
   "text": "اون موقع است که از درون می‌جوشه حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 861.62,
   "end": 864.28,
   "text": "حکمت از قلبش بر زبانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 864.28,
   "end": 868.42,
   "text": "جاری می‌شود که مقام اخلاص است و ان‌شاءالله در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 868.42,
   "end": 873.28,
   "text": "عرض شود خدمتتون رساله سیر و سلوک سید بحر العلوم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 873.28,
   "end": 876.96,
   "text": "غروب‌های جمعه یا زهرا قبل مشغول اون مباحث هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 876.96,
   "end": 878.88,
   "text": "ان‌شاءالله که موفق باشیم هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 878.88,
   "end": 880.72,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}