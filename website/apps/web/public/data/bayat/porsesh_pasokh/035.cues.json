 "chapters": [
  {
   "index": 0,
   "title": "## لا إله إلا الله و کلمهٔ اخلاص",
   "start": 9.28,
   "end": 52.3
  },
  {
   "index": 1,
   "title": "## قطب منفی و مثبت؛ وحید خراسانی",
   "start": 52.3,
   "end": 241.7
  },
  {
   "index": 2,
   "title": "## قل هو الله أحد و توحید صمدی",
   "start": 241.7,
   "end": 389.32
  },
  {
   "index": 3,
   "title": "فاصلهٔ رتبه‌ای توحید الوهی و وجودی چون آیهٔ حدید است:",
   "start": 389.32,
   "end": 480.52
  },
  {
   "index": 4,
   "title": "## آثار بدون استقلال",
   "start": 480.52,
   "end": 663.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.04,
   "end": 5.66,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.66,
   "end": 8.48,
   "text": "المستغاث بکی یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.48,
   "end": 11.98,
   "text": "پرسیدن که رابطه کلمه اخلاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.98,
   "end": 16.82,
   "text": "با کلمه لا اله الا الله در چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.82,
   "end": 19.88,
   "text": "به صورت کلی عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.88,
   "end": 23.14,
   "text": "کلمه شریف لا اله الا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.14,
   "end": 27.22,
   "text": "حکایت از توحید الوهی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.22,
   "end": 30.02,
   "text": "حالا توضیح میدم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.02,
   "end": 38.26,
   "text": "کلمه اخلاص که همون در حقیقت مظهرش دیگه بهترین وجهش سوره اخلاص هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.26,
   "end": 41.04,
   "text": "به همین خاطر هم نامش اخلاص شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.04,
   "end": 43.68,
   "text": "سوره توحید قل هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.68,
   "end": 47.6,
   "text": "اون توحید وجودی رو داره بیان میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.6,
   "end": 50.68,
   "text": "فرق اینا با هم چیه؟ ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.68,
   "end": 53.78,
   "text": "در کلمه لا اله الا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.78,
   "end": 57.18,
   "text": "اول نهی داره بعد اثبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.18,
   "end": 60.44,
   "text": "میگه لا اله. ال این اله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.44,
   "end": 65.72,
   "text": "که اینجا میگه در حقیقت هر گونه تعلقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.72,
   "end": 72.6,
   "text": "در الهیت وجود تو که مرتبه قلب و رتبه قلب وجود توست، عالم قلب توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.6,
   "end": 76.14,
   "text": "هر گونه تعلقی به غیر از خدا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.14,
   "end": 83.12,
   "text": "داره میگه نفی کن. یعنی یک در حقیقت نفیه دیگه نفیه لا اله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.12,
   "end": 87.44,
   "text": "نفی هر تعلقی در الهیت وجود خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.44,
   "end": 90.74,
   "text": "یعنی تعلق قلبی به هر کسی به غیر از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.74,
   "end": 94.46,
   "text": "اگر این نفی اومد بعد الا الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.46,
   "end": 98.14,
   "text": "الله اثبات میشه. اثبات میشه تو وجودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.14,
   "end": 101.92,
   "text": "این بهش میگن توحید الوهی که غالب آیات قرآن از همون بسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.92,
   "end": 107.88,
   "text": "الله الرحمن الرحیم از با همین توحید شروع شده چون با عموم مردم در، سر و کار داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.88,
   "end": 111.84,
   "text": "اما همونطور که روایت داریم بعضی از آیات قرآن مخصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.84,
   "end": 116.46,
   "text": "مخلصینه و به هر حال خواصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.46,
   "end": 120.7,
   "text": "مثل سوره خود همین اخلاص و شش آیه اول سوره حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.7,
   "end": 126.32,
   "text": "اینا حدیث داره. امام صادق صلوات الله علیه فرمود برای عقول آخرالزمان ذخیره شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.32,
   "end": 129.72,
   "text": "مگه چه در اینها است که مخصوص آخرالزمانه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.72,
   "end": 132.18,
   "text": "اینا بحث توحید وجودین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.18,
   "end": 135.4,
   "text": "به قول حضرت آیه الله وحید در کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.4,
   "end": 141.58,
   "text": "حلقه وصل رسالت و امامت‌شون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.58,
   "end": 146.68,
   "text": "اونجا در همین بحث لا اله الا الله اشاره به قطب مثبت و منفی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.68,
   "end": 152.46,
   "text": "میگن همینطور که چراغ می‌خواد روشن بشه باید دو قطب منفی و مثبت با هم باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.46,
   "end": 156.6,
   "text": "اینجا هم اگر می‌خوای تو وجودت به توحید روشن بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.6,
   "end": 161.6,
   "text": "اینجا اول نفی می‌کنی هر گونه تعلق غیر خدا رو لا اله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.6,
   "end": 164.38,
   "text": "بعد اثبات می‌کنی الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.38,
   "end": 168.74,
   "text": "اما رتبه بالا، بالاتر از توحید الوهی، توحید وجودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.74,
   "end": 174.54,
   "text": "یعنی اصلاً هیچ غیریتی نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.54,
   "end": 177.7,
   "text": "قائل به غیریتی نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.7,
   "end": 180.56,
   "text": "مثل سوره قل هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.56,
   "end": 186.56,
   "text": "اون توحید وجودیه که متأسفانه بعضیا اینو بد متوجه شدن از کلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.56,
   "end": 193.18,
   "text": "حکما در حکمت متعالیه مثل ملاصدراها و اینها متأسفانه نفهمیدن و اون‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.18,
   "end": 198.16,
   "text": "مثلاً لعن کردن و اینها که خدا هدایتشون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.16,
   "end": 204.1,
   "text": "در این آیه شریف در سوره اخلاص می‌خونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.1,
   "end": 207.54,
   "text": "قل هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.54,
   "end": 211.24,
   "text": "الله الصمد. ببینید به پیغمبر میگه بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.24,
   "end": 214.64,
   "text": "چی بگم؟ اولین چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.64,
   "end": 219.74,
   "text": "میگه بگو هوه. هوه اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.74,
   "end": 224.32,
   "text": "بر می‌گرده به همون ذات غیب، غیب الغیوب حضرت حق که هوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.32,
   "end": 227.72,
   "text": "که اگر قرار بود یعنی در حقیقت انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.72,
   "end": 233.24,
   "text": "نمی‌تونست برسه به-- یعنی سیرش به سمت ذات حضرت حق نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.24,
   "end": 237.86,
   "text": "چرا اینجا میگه بگو هوه؟ هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 237.86,
   "end": 239.52,
   "text": "قل هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.52,
   "end": 241.34,
   "text": "ببینید همش حرف خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.34,
   "end": 244.5,
   "text": "لذا سوره شناسنامه خدا نامیده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.5,
   "end": 247.7,
   "text": "هیچ حرفی از غیر از خدا درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.7,
   "end": 250.24,
   "text": "قل هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.24,
   "end": 252.7,
   "text": "خدای یکتا و بی‌همتا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.7,
   "end": 256.02,
   "text": "در حقیقت بدون کفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.02,
   "end": 257.8,
   "text": "که الله الصمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.8,
   "end": 260.88,
   "text": "حالا این الله بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.88,
   "end": 265.84,
   "text": "هوه که اومده، این الله اول قل هو الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.84,
   "end": 268.62,
   "text": "این اشاره به همون توحید وجودی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.62,
   "end": 271.8,
   "text": "بعد البته اون الله الصمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.8,
   "end": 274.26,
   "text": "دیگه می‌بره به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.26,
   "end": 276.86,
   "text": "در حقیقت توحید صفاتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.86,
   "end": 282.64,
   "text": "اما الصمد رو روش یه تمرکز داشته باشید که بارها عرض کردیم که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.64,
   "end": 286.18,
   "text": "تعبیر از تلمذ حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.18,
   "end": 289.82,
   "text": "این توحید صمدی قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.82,
   "end": 298.02,
   "text": "امام جواد صلوات الله علیه که عرض کردیم در رساله اسم اعظم از تلمذ این اومده می فرماید الصمد الذي لا جوف له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.02,
   "end": 299.84,
   "text": "صمد هیچ تو خالی نیست، پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.84,
   "end": 302.98,
   "text": "پره و هیچ کجا خالی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.98,
   "end": 307.58,
   "text": "خدا نیست که اگر جایی اپسیلون جایی رو ما پیدا کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.58,
   "end": 311.0,
   "text": "ذره‌ای رو پیدا کنیم که اونجا خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.0,
   "end": 316.26,
   "text": "مثلاً فرض کنیم یه چیزی هست بعد خدا در او تجلی کرده یا ظهور کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.26,
   "end": 319.2,
   "text": "اینم میشه شرک و اینم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.2,
   "end": 323.82,
   "text": "میشه یه جایی رو پیدا کردیم که خدا نبوده حالا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.82,
   "end": 329.72,
   "text": "به همین وزان ما میگیم اصلاً بودن هر چیزی عینیتش عین ظهور حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.72,
   "end": 334.5,
   "text": "نه اینکه مظهر حق بودن یعنی یه چیزیه که خدا در او ظهور کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.5,
   "end": 337.32,
   "text": "نه، اصلاً بودنش عین ظهور حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 337.32,
   "end": 341.08,
   "text": "هرچه بیشتر خدا رو ظاهر کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.08,
   "end": 344.02,
   "text": "ظهور حضرت حقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.02,
   "end": 349.34,
   "text": "شدت وجودیش بیشتره، اشتداد وجودیش بیشتره اصطلاحاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.34,
   "end": 354.28,
   "text": "و مظهر تام‌تری از خداست که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.28,
   "end": 356.74,
   "text": "بیشترین شدت رو در ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.74,
   "end": 362.98,
   "text": "حضرت حق داره. لذا در ذات و صفات و افعال به وزان حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 362.98,
   "end": 367.1,
   "text": "حالا بحث اینجا بود مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.1,
   "end": 375.48,
   "text": "یه مثال دیگه‌ای بزنم. فاصله بین لا اله الا الله اگرچه در طول هم‌ان از جهت رتبه‌ای عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.48,
   "end": 379.4,
   "text": "یعنی رتبه توحید الوهی با توحید وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.4,
   "end": 382.1,
   "text": "مثل رابطه‌ی حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.1,
   "end": 385.46,
   "text": "آیه شش، آیه سه سوره حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.46,
   "end": 388.8,
   "text": "می‌فرماید هو الاول والآخر والظاهر والباطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 388.8,
   "end": 391.36,
   "text": "این آیه هم با هو شروع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.36,
   "end": 393.78,
   "text": "اسماء خدا رو بیان کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.78,
   "end": 397.66,
   "text": "که ظاهر همون باطنه، اول همون آخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 397.66,
   "end": 400.64,
   "text": "اما آخرش می‌فرماید و هو بكل شيء عليم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.64,
   "end": 403.76,
   "text": "اینجام حرف از شيء زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.76,
   "end": 409.88,
   "text": "شيء به یک معنا اینجا همون اشیا رو اگه بگیریم، اشیا همون اسماءند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.88,
   "end": 414.08,
   "text": "وعلم آدم الأسماء كلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 414.08,
   "end": 418.8,
   "text": "خدا تعلیم کرده همه اسماء رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.8,
   "end": 426.28,
   "text": "به حضرت آدم. این اسماء رو از تعالم فرمودن بردارید اشیا به جاش بگذارید باز همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.28,
   "end": 428.64,
   "text": "یعنی وعلم آدم الأشياء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.64,
   "end": 431.02,
   "text": "هر شيءی اسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 431.02,
   "end": 436.34,
   "text": "حالا نسبت به اینکه چه اسمی یا چه اسمایی و به چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.34,
   "end": 442.9,
   "text": "میزانی از اون اسم رو چه شدت و حدتی رو ظهور داده رتبه پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.9,
   "end": 447.92,
   "text": "باز اینجا تو این آیه اگرچه با هو شروع کرده اما حرف از شيء زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.92,
   "end": 451.78,
   "text": "حرف از اشیا زده، حرف از خلائق زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.78,
   "end": 457.84,
   "text": "پس این می‌شه توحید الوهی که از الله که اسم جامعه بری برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.84,
   "end": 461.62,
   "text": "اما در سوره اخلاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.62,
   "end": 465.58,
   "text": "که حالا اینو معناشو شما حقیقت خلوص و اخلاص بگیرید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.58,
   "end": 468.74,
   "text": "نه لفظ ظاهری این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.74,
   "end": 474.78,
   "text": "و این آیات. سوره اخلاص مستقیماً اشاره به توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 474.78,
   "end": 479.32,
   "text": "وجودی داره. یعنی توحید صمدی به قول حضرت تعالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 479.32,
   "end": 486.02,
   "text": "که اصلاً وقتی اینطوری نگاه می‌کنی به قول امام حسین صلی الله علیه در به فرمایش ایشون در دعای عرفه که داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 486.02,
   "end": 489.22,
   "text": "متى غبت تو کی غائب بودی که بخوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.22,
   "end": 495.8,
   "text": "الان ظاهر بشی. متى بعدت تو کی دور بودی که الان بخوای نزدیک بشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 495.8,
   "end": 499.8,
   "text": "یا من به تو نزدیک بشم. اصلاً دویت رو وَر می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.8,
   "end": 504.68,
   "text": "وحدت کامل یعنی وحدت وجودی رو بیان می‌کنه کاملاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 504.68,
   "end": 511.28,
   "text": "و حتی آثار رو هم به معنای آثار نمی‌گیره که بگیم این اثر وجودی یه نفره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 511.28,
   "end": 519.72,
   "text": "یا یه شخصیه که من این رو مستقلاً ببینم به یاد مثلاً مؤثرش بیفتم که لا مؤثر فی الوجود الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 519.72,
   "end": 522.64,
   "text": "درست، اما نگاه رو تغییر می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 522.64,
   "end": 525.48,
   "text": "در اون دعای امام حسین صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 525.48,
   "end": 528.3,
   "text": "عرضه می‌داره که خدایا اجازه بده من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 528.3,
   "end": 531.42,
   "text": "الهی ترددی في الآثار یوجب بعد المزار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 531.42,
   "end": 535.36,
   "text": "نگاه کردن من، ترددم، رفت و آمدم به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 535.36,
   "end": 538.06,
   "text": "آثار تو، به آیات تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 538.06,
   "end": 541.32,
   "text": "به یک معنا به این اسماء تو، به خلائق تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.32,
   "end": 544.66,
   "text": "منو از مزار یعنی زیارت تو دور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 544.66,
   "end": 548.44,
   "text": "اما چه کنیم قرآن سرتاسر می‌فرماید نگاه کنید به آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 548.44,
   "end": 551.82,
   "text": "نز-- نگاه کنید، نظاره کنید به این آثار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 551.82,
   "end": 559.52,
   "text": "امام حسین می‌فرماید اجازه بده من این آثار رو با احترام، با ادب، اجازه بده این آثار رو مستقل نبینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 559.52,
   "end": 566.6,
   "text": "که این‌ها چیزی باشن در حالی که عین فقر به توهند، عین ربط به توهند، چیزی باشن که بخوان مظهر تو باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 566.6,
   "end": 569.42,
   "text": "نه، ای بلکه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 569.42,
   "end": 576.02,
   "text": "عیناً ظهور توهند. یعنی ببینید نگاه رو چگونه عوض می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 576.02,
   "end": 580.72,
   "text": "که اگر قرار باشه چیزی باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 580.72,
   "end": 586.9,
   "text": "که حالا خدا بیاد در این چیز ظهور کند دویت پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.9,
   "end": 592.06,
   "text": "اما نه، هرچه که هست شؤون خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 592.06,
   "end": 594.96,
   "text": "به قول بزرگان چقدر شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 594.96,
   "end": 596.64,
   "text": "اطوار وجودی حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 596.64,
   "end": 602.36,
   "text": "یعنی عالم اطوار و طورهای مختلف حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 602.36,
   "end": 607.3,
   "text": "این بهترین وجهیه که می‌شه رابطه‌ی اخلاص با لا اله الا الله رو سنجید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 607.3,
   "end": 610.7,
   "text": "البته با لا اله الا الله باید شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 610.7,
   "end": 615.02,
   "text": "مراتب محفوظ. با لا اله الا الله باید شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 615.02,
   "end": 617.76,
   "text": "تسویه باطن صورت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 617.76,
   "end": 620.36,
   "text": "اذرات و آلودگی‌ها و تعلق به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 620.36,
   "end": 628.0,
   "text": "غیر از بین بره. بعد یواش یواش به اتحاد وجودی ب-برسه انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 628.0,
   "end": 636.22,
   "text": "به جایی که دیگه اصلاً به صحرا بنگرم صحرات بینم، به دریا بنگرم دریات بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 636.22,
   "end": 639.22,
   "text": "دیگه چیزی جز حق نبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 639.22,
   "end": 643.08,
   "text": "که سنریهم فی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 643.08,
   "end": 651.42,
   "text": "سنریهم آیاتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 651.42,
   "end": 654.9,
   "text": "به جایی می‌رسه که می‌نه اصلاً همه چی حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 654.9,
   "end": 658.58,
   "text": "چیزی جز حق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 658.58,
   "end": 661.26,
   "text": "خدا هممون رو حفظ کنه و عاقبت بخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 661.26,
   "end": 663.18,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}