 },
 "chapters": [
  {
   "index": 0,
   "title": "## آغاز راه؛ عطش معرفت و دو بالِ بعثت",
   "start": 0.4,
   "end": 328.12
  },
  {
   "index": 1,
   "title": "## فهرست سیر نظری؛ از معرفت نفس تا اسفار",
   "start": 328.12,
   "end": 485.39
  },
  {
   "index": 2,
   "title": "## عرفان عملی؛ از دانایی به دارایی",
   "start": 485.39,
   "end": 511.67
  },
  {
   "index": 3,
   "title": "## مجامع روایی و خروجیِ شخصی",
   "start": 511.67,
   "end": 541.61
  },
  {
   "index": 4,
   "title": "## تفصیلِ عقل عملی و برنامهٔ روز",
   "start": 541.61,
   "end": 1033.57
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 7.7,
   "text": "بسم الله و بالله و على ملة رسول الله المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.7,
   "end": 13.68,
   "text": "بعضی از عزیزانی که حالا یا از طریق فضای مجازی عضو کانال میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.68,
   "end": 16.66,
   "text": "و آشنا میشن با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.66,
   "end": 19.88,
   "text": "حکمت و عرفان نظری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.88,
   "end": 23.24,
   "text": "یا دوست دارن سیر عملی داشته باشن و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.24,
   "end": 31.94,
   "text": "یا اینکه در مجالس حضوری شرکت می‌کنند و اینها دور بودن از این حقایق و معارف حقه و صحف نوریه عرفانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.94,
   "end": 34.18,
   "text": "خب اون حس وجودیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.18,
   "end": 37.16,
   "text": "گل می‌کنه و اون رب وجودیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.16,
   "end": 41.48,
   "text": "این عطش رو به اون‌ها القا می‌کنه که به سمت این حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.48,
   "end": 44.04,
   "text": "حرکت کنن منتها نمی‌دونن چه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.04,
   "end": 46.66,
   "text": "بعضا سوال می‌پرسن که ما از کجا شروع کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.66,
   "end": 51.18,
   "text": "حالا یا آدم‌هایی هستند که تحصیل کرده هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.18,
   "end": 54.22,
   "text": "یا در حوزه یا در دانشگاه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.22,
   "end": 56.32,
   "text": "نه عامه هستند و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.32,
   "end": 61.78,
   "text": "فرق نمی‌کنه. در هر حال یه سیری رو بنده حقیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.78,
   "end": 68.42,
   "text": "به استناد فرمایشات مشایخ‌مون و در مشرب از تعلمة حسن زاده علیه الرحمه عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.42,
   "end": 70.48,
   "text": "که خب ما در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.48,
   "end": 76.78,
   "text": "عرفان نظری یا حکمت نظری یا عقل نظری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.78,
   "end": 79.5,
   "text": "یه سری کارها رو باید انجام بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.5,
   "end": 83.56,
   "text": "و در بحث عرفان عملی یا حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.56,
   "end": 86.6,
   "text": "عملی یا عقل عملی هم یه سلسله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.6,
   "end": 90.18,
   "text": "کارهایی رو باید انجام بدیم و کتاب‌هایی رو باید بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.18,
   "end": 94.22,
   "text": "آنچه که مهم است بر اساس آیه دوم سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.22,
   "end": 103.78,
   "text": "جمعه که این اصلا فلسفه بعثت انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.78,
   "end": 108.42,
   "text": "که وحی تشریعی رو اخذ کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.42,
   "end": 112.52,
   "text": "و ملائکه بر اون‌ها نازل شدن و حقایق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.52,
   "end": 116.98,
   "text": "به صعه وجودی خودشون و امت‌شون براشون نازل کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.98,
   "end": 121.84,
   "text": "که تا این آیات رو تلاوت کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.84,
   "end": 126.26,
   "text": "دو تا کاره. یکی بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.26,
   "end": 129.26,
   "text": "هست. طهارت و تزکیه نفس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.26,
   "end": 134.18,
   "text": "و و دیگر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.18,
   "end": 140.58,
   "text": "تو همین آیه اومده. .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.58,
   "end": 147.54,
   "text": "پس ما در پس تلاوت آیات در مشرب انبیا و اولیا و اهل بیت علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.54,
   "end": 152.54,
   "text": "دو تا کار باید انجام بدیم. یکی ادب آموزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.54,
   "end": 155.32,
   "text": "و چه شیرین که کتاب و حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.32,
   "end": 159.72,
   "text": "اینجا مورد نظر هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.72,
   "end": 161.88,
   "text": "طهارت. طهارت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.88,
   "end": 164.34,
   "text": "پایه و بستری‌ست برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.34,
   "end": 172.0,
   "text": "اینکه انسان آمادگی پیدا کنه تا هر مقدار که طهارت پیدا کرده اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.0,
   "end": 176.06,
   "text": "خودش رو نشون بده. یعنی اون حقایق در انسان پیاده بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.06,
   "end": 177.98,
   "text": "که بدون طهارت نفس نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.98,
   "end": 181.14,
   "text": "پس در این مسیر باید قطعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.14,
   "end": 186.02,
   "text": "تقوا پیشه کرد بلکه ورع که شدت تقواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.02,
   "end": 192.3,
   "text": "و طهارت نفس تا بشود مس کرد که البته مس به قول علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.3,
   "end": 195.1,
   "text": "ابتداش می‌شه همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.1,
   "end": 199.16,
   "text": "برخورد ظاهر دو چیز با هم که هرچه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.16,
   "end": 202.58,
   "text": "طهارت بیشتر می‌شه با باطن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.58,
   "end": 204.8,
   "text": "ارتباط برقرار می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.8,
   "end": 213.5,
   "text": "تا جایی که دیگه نزول ملائکه رو انسان حس می‌کنه و اون تمثلات و چشیدن‌ها و رسیدن‌ها در سقی نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.5,
   "end": 216.94,
   "text": "حس می‌شه، دیده می‌شه که به نحو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.94,
   "end": 224.58,
   "text": "الهام برای اولیاء الله و به نحو تعلیم برای علما این اتفاق می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.58,
   "end": 226.4,
   "text": "که نبوت انبایی بهش میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.4,
   "end": 230.6,
   "text": "خب اونچه که ما باید انجام بدیم پس در پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.6,
   "end": 235.72,
   "text": "طهارت یعنی بعد از اینکه به شدت سعی کردیم طهارت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.72,
   "end": 241.32,
   "text": "پیشه کنیم، تمام قوامون، ظاهر و باطنمون، لباس ظاهری و باطنی‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.32,
   "end": 244.46,
   "text": "عرض شود این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.46,
   "end": 249.44,
   "text": "قوای وجودیمون، سر و سر و سرمون، روحمون، عقلمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.44,
   "end": 252.5,
   "text": "وهم و خیال و عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.5,
   "end": 257.14,
   "text": "همون حواس پنج گانه ظاهریمون که وارداتمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.14,
   "end": 260.22,
   "text": "تشکیل میده تا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.22,
   "end": 265.62,
   "text": "حس مشترک این‌ها رو به هم دوخت و دوز کنه بده به باطن و اون باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.62,
   "end": 269.1,
   "text": "کارخانه باطنی ما نفس ناطقه ما به گونه‌ای رو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.1,
   "end": 273.04,
   "text": "داده‌ها پردازش کنه که صادرات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.04,
   "end": 277.54,
   "text": "بسازه. همه این‌ها باید بر اساس طهارت نفس باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 277.54,
   "end": 282.52,
   "text": "بعد اون سیری که ما داریم در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 282.52,
   "end": 285.9,
   "text": "عرفان حالا به معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.9,
   "end": 291.68,
   "text": "نظری یا حکمت نظری یا به عبارتی عقل نظری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.68,
   "end": 295.3,
   "text": "آنچه که بنده حقیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.3,
   "end": 300.0,
   "text": "استیاب کردم از فرمایشات حضرت علامه علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.0,
   "end": 302.8,
   "text": "و مشایخ دیگرمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.8,
   "end": 306.8,
   "text": "و حالا تجربه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 306.8,
   "end": 310.54,
   "text": "می‌تونم بگم حدود سی ساله این حقیر هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.54,
   "end": 312.82,
   "text": "به نظرم گم شده همه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.82,
   "end": 315.12,
   "text": "سیر معرفت نفس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 315.12,
   "end": 319.34,
   "text": "و ابتدا و آخر سیر ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.34,
   "end": 326.82,
   "text": "سیر و سلوک ما باید بر مبنای معرفت نفس باشد که \"من عرف نفسه فقد عرف ربه\" البته من عرفه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.82,
   "end": 329.88,
   "text": "نه من افنا به قول حضرت علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.88,
   "end": 333.96,
   "text": "یعنی نه اینکه بزنه خودش رو نابود کنه بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.96,
   "end": 336.06,
   "text": "به مقام فنا برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.06,
   "end": 338.96,
   "text": "اونم فنای ذاتی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.96,
   "end": 344.04,
   "text": "عرض شود مرحله گام سوم که بهش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 344.04,
   "end": 352.62,
   "text": "محق که ذکرش بود لا هو یا هو یا مالله واللا هو یا خلاصه‌اش لا هو واللا هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.62,
   "end": 358.14,
   "text": "که وجود و ذات خودش رو سالک الی الله مستهلك و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.14,
   "end": 366.13,
   "text": "غرق و فانی در وجود حضرت حق می‌بیند و همه عوالم هستی و كائنات و ممكنات و من جمله خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.13,
   "end": 371.23,
   "text": "که یک کونی از اکوان است، یک شیی از اشیا است، یک اسمی از اسماء است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 371.23,
   "end": 374.95,
   "text": "همه رو شؤون و اطوار وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 374.95,
   "end": 379.45,
   "text": "حق می‌بیند که عالم اطوار وجودی حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 379.45,
   "end": 384.25,
   "text": "این سیر با اولین کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.25,
   "end": 391.69,
   "text": "که ابتدایی‌ست و سیر معرفت نفس حضرت علامه است شروع باید بشه به نظر حقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 391.69,
   "end": 393.95,
   "text": "عزیزان شروع کنند با کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 393.95,
   "end": 397.75,
   "text": "سه جلدی معرفت نفس ایشون که البته اخیراً در یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 397.75,
   "end": 401.09,
   "text": "مجلد چاپ شده. صد و پنجاه و سه درس درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 401.09,
   "end": 403.01,
   "text": "مباحث کاملاً عقلی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 403.01,
   "end": 408.19,
   "text": "یعنی شما حتی می‌تونید کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 408.19,
   "end": 412.89,
   "text": "خیلی مذهبی نیستند، می‌تونید با اون‌ها هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 412.89,
   "end": 416.61,
   "text": "این درس و بحث‌ها رو داشته باشید عقلشون می‌پذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 416.61,
   "end": 422.37,
   "text": "من تجربه میدanim این رو ثابت کرده که حتی کسایی که نماز نمی‌خوندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 422.37,
   "end": 424.63,
   "text": "حالا حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 424.63,
   "end": 430.69,
   "text": "مشکوک بودند به نزول قرآن، به حقایق، به اهل بیت، به امامت اهل بیت اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 430.69,
   "end": 435.09,
   "text": "اما با این مباحث عقلی علامه به خط شدند حتی به نماز افتادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 435.09,
   "end": 437.47,
   "text": "چون عقل رو ابتدا درگیر، درگیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 437.47,
   "end": 441.05,
   "text": "پس ابتدا کتاب معرفت نفس علامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 441.05,
   "end": 449.77,
   "text": "که البته این کتاب‌ها قطعاً باید همراه با معلم خوبی که زبان گویایی داشته باشه و بتونه متن رو شرح کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 449.77,
   "end": 454.21,
   "text": "و چه بهتر که حضوری باشه که نور on علا نور پیش بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 454.21,
   "end": 457.59,
   "text": "و کتاب معرفت نفس بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 457.59,
   "end": 462.11,
   "text": "انشاالله فارغ شدن صد کلمه در معرفت نفس رو پیش بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 462.11,
   "end": 464.31,
   "text": "یه کتاب جداگانه‌ایست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 464.31,
   "end": 469.57,
   "text": "بعض از عرض شود شاگردان حضرت استاد هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 469.57,
   "end": 473.49,
   "text": "شرحی هم براش نوشتن. کتاب گنجینه گوهر روان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 473.49,
   "end": 476.25,
   "text": "خیلی عالیست در سیر معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 476.25,
   "end": 478.87,
   "text": "بعد کتاب انسان در عرف عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 478.87,
   "end": 482.51,
   "text": "بسیار عالیست. بعد کتاب انسان در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 482.51,
   "end": 485.27,
   "text": "از دیدگاه نهج‌البلاغه است خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 485.27,
   "end": 488.17,
   "text": "به درد بخور. نکات بسیار عرشی خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 488.17,
   "end": 492.91,
   "text": "کتاب انسان در قرآن. این‌هایی که دارم میگم همینطور به ترتیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 492.91,
   "end": 495.21,
   "text": "باید این‌ها رو سیر کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.21,
   "end": 501.21,
   "text": "و البته سعی کرد این حقایق رو در خودمون پیاده کنیم دیگه در حیث عرفان عم-عملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 501.21,
   "end": 504.95,
   "text": "و همچنین کتاب وحدت از دیدگاه حکیم و عارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 504.95,
   "end": 508.99,
   "text": "بعد می‌رسید به یکی از سنگین‌ترین کتاب‌های این سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 508.99,
   "end": 514.99,
   "text": "به نام کتاب اتحاد عاقل به معقول علامه که البته شع-حالا شرح و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 514.99,
   "end": 517.91,
   "text": "تعلیقه اینها حاشیه چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 517.91,
   "end": 521.37,
   "text": "این چنینی بوده تقریباً بر کتاب عاقل به معقول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 521.37,
   "end": 527.41,
   "text": "اتحاد عاقل به معقول استاد عزیزشون حضرت علامه رفیع قزوینی که خود استاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 527.41,
   "end": 534.09,
   "text": "استاد علامه حسن زاده فرمودن که دیگه خودش یک رساله مستقلی شد و ما چاپش کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 534.09,
   "end": 539.67,
   "text": "بعد کتاب دیگه میشه گفت شاید تخصصی‌ترین کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 539.67,
   "end": 544.13,
   "text": "علامه باشه بر سیر معرفت نفس که سرح العيون فی شرح العيون است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 544.13,
   "end": 547.23,
   "text": "شش-شصت و شش اصل از اصول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 547.23,
   "end": 550.57,
   "text": "و عیون مسائل مهم نفس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 550.57,
   "end": 553.79,
   "text": "که قطعاً نیاز به شرح، شرح و بس دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 553.79,
   "end": 557.13,
   "text": "بعد کتاب نصوص بر فصوص فارابی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 557.13,
   "end": 560.57,
   "text": "همچنین ممد ممد الهمم ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 560.57,
   "end": 563.79,
   "text": "که حالا یک شرحی‌ست بر فصوص ابن عربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 563.79,
   "end": 568.63,
   "text": "این‌ها رو من حیث مجموع عزیزان پیش بگیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 568.63,
   "end": 574.83,
   "text": "و البته بدونید که معمولاً دیدید آثار علامه مثلاً هزار و یک نکته، هزار و یک کلمه اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 574.83,
   "end": 581.51,
   "text": "قرار بود سیر معرفت نفس ایشون هم به جای صد و پنجاه درس ابتدایی بره تا هزار و یک درس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 581.51,
   "end": 592.01,
   "text": "آن بلا به دلایلی تقطیعی حرکت کردن و هر بخشی رو در یک کتاب جداگانه به این شروحی که عرض کردیم به این عنوان‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 592.01,
   "end": 599.91,
   "text": "عناوینی که گفتیم عرض شود انجام شده که می‌تونید فیض ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 599.91,
   "end": 605.63,
   "text": "بعد حالا وقتی که به اینجا رسیدید دیگه می‌تونید راحت تجرید رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 605.63,
   "end": 611.23,
   "text": "کتاب شریف تجرید اعتقادات خواجه طوسی رو که خیلی مورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 611.23,
   "end": 615.11,
   "text": "تأکید حضرت استاد بود خوندن ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 615.11,
   "end": 618.41,
   "text": "خصوصاً با یک معلمی، استادی انسان این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 618.41,
   "end": 620.45,
   "text": "تعلیم بگیره که عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 620.45,
   "end": 623.79,
   "text": "که البته شرح این رساله تجرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 623.79,
   "end": 627.79,
   "text": "میشه همون کشف مر-کشف مراد علامه حلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 627.79,
   "end": 630.61,
   "text": "که بعد حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 630.61,
   "end": 633.39,
   "text": "علامه شعرانی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 633.39,
   "end": 635.83,
   "text": "باز همین کشف مراد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 635.83,
   "end": 639.63,
   "text": "توضیح دادن. یعنی میشه شرح در شرح ش- در شرح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 639.63,
   "end": 641.89,
   "text": "یعنی نور على نور على نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 641.89,
   "end": 644.63,
   "text": "بعد کتاب منظومه ملا هادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 644.63,
   "end": 647.95,
   "text": "سبزواری علیه رحمة عالیه در این سیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 647.95,
   "end": 651.75,
   "text": "اشارات و نفس شفای شیخ الرئیس خیلی خوبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 651.75,
   "end": 656.43,
   "text": "تمهید القواعد ابن ترک، مصباح العنس ابن فناری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 656.43,
   "end": 660.83,
   "text": "و اسفار حضرت ملا صدرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 660.83,
   "end": 665.19,
   "text": "آخوند شیرازی بزرگ که این‌ها مجموعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 665.19,
   "end": 670.03,
   "text": "مؤداتی‌ست که شما رو انشاالله در این مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 670.03,
   "end": 677.15,
   "text": "و در سیر استکمالی و تکاملی و تکمیلی شما رو انشاالله کمک کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 677.15,
   "end": 679.71,
   "text": "و اما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 679.71,
   "end": 685.65,
   "text": "عرفان عملی و حکمت عملی یا عقل عملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 685.65,
   "end": 688.35,
   "text": "توصیه می‌کنم که خب اونچه که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 688.35,
   "end": 692.35,
   "text": "اینجا کسب می‌کنیم به علم فکری‌ست و این‌ها مؤداتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 692.35,
   "end": 695.35,
   "text": "این‌ها جرقه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 695.35,
   "end": 700.17,
   "text": "این‌ها به، به منزله یک راهرویی‌اند که ما رو به اون حقیقت برسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 700.17,
   "end": 709.33,
   "text": "اصل اینه که اون‌ها، اون حقایق که شیرین است، عرشی‌ست بلکه فوق عرشی‌ست در وجود ما پیاده بشود و ما این‌ها رو بچشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 709.33,
   "end": 715.45,
   "text": "دانایی نباشد بلکه دارایی باشد که اصل فناء فی الله هم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 715.45,
   "end": 719.49,
   "text": "انسان برسد که اون لقاء الله هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 719.49,
   "end": 725.95,
   "text": "در حقیقت دیگه اوج لقاء الله پیاده شدن صفات و اسماء الهی در وجود سالک است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 725.95,
   "end": 728.81,
   "text": "دیگه لقاء الله یعنی همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 728.81,
   "end": 733.83,
   "text": "یعنی همون اصل تمس به یک معنا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 733.83,
   "end": 741.05,
   "text": "می‌شود سالک الی الله به مقام رؤیت می‌رسد که تمام صفات رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 741.05,
   "end": 746.31,
   "text": "ااا فانی در صفات حضرت حق می‌بیند که لا اله الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 746.31,
   "end": 749.57,
   "text": "الله که این مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 749.57,
   "end": 754.91,
   "text": "می‌شود گفت اتم دیگه لقاء الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 754.91,
   "end": 761.11,
   "text": "خب در این مسیر هم کتاب‌های خیلی شیرین و خوب و به دردبخوری هست از خود حضرت استاد مثلا کتاب نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 761.11,
   "end": 765.39,
   "text": "على نورشون در ذکر و ذاکر و مذکور بسیار خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 765.39,
   "end": 768.47,
   "text": "نامه‌ها، برگ نامه‌هاشون خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 768.47,
   "end": 771.51,
   "text": "البته در هزار و یک نکته و هزار و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 771.51,
   "end": 774.29,
   "text": "کلمه هم ایشون ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 774.29,
   "end": 779.29,
   "text": "در بسیاری از نکته‌ها سیر عملی دادن، دستورات دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 779.29,
   "end": 782.63,
   "text": "و چگونگی پیاده کردن این عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 782.63,
   "end": 785.01,
   "text": "نظری رو در حیث عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 785.01,
   "end": 790.03,
   "text": "بیان کردن و جاده رو صاف کردن در حقیقت برای سالک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 790.03,
   "end": 795.37,
   "text": "و عرض شود. همچنین حالا کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 795.37,
   "end": 801.13,
   "text": "لقاء الله ایشون خصوصا اون دستورات پانزده گانه حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 801.13,
   "end": 805.59,
   "text": "برای این سیر که همش عملیاتی‌ست، عملی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 805.59,
   "end": 807.85,
   "text": "اون‌ها رو انسان باید طی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 807.85,
   "end": 813.43,
   "text": "کتاب جام سحبا و یا به عبارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 813.43,
   "end": 815.95,
   "text": "سیر و سلوک عملیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 815.95,
   "end": 820.99,
   "text": "رساله سیر و سلوک عملیه علامه طباطبایی خیلی عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 820.99,
   "end": 824.91,
   "text": "کتاب سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 824.91,
   "end": 827.61,
   "text": "سید ابن طاووس و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 827.61,
   "end": 829.79,
   "text": "ببخشید سید بحر العلوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 829.79,
   "end": 832.63,
   "text": "که منسوب است به ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 832.63,
   "end": 838.57,
   "text": "که حضرت آیت الله پهلوانی شرح دادن که حالا ما غروبای جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 838.57,
   "end": 842.27,
   "text": "داشتیم به جهت متأسفانه کرونا تعطیل شد شرحش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 842.27,
   "end": 848.91,
   "text": "این‌ها کتاب‌هایی‌ست که در سیر عرفان نظری-- عملی به ما رو بسیار کمک می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 848.91,
   "end": 853.69,
   "text": "خصوصا اینکه برای برنامه‌ریزی عملی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 853.69,
   "end": 862.33,
   "text": "اینکه انسان آنات و ساعات عمرشو برنامه‌ریزی کنه و از ادعیه و سیر و سلوک عملی بهره بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 862.33,
   "end": 869.05,
   "text": "در حیث عمل. خود حضرت استاد خیلی تاکید داشتن به کتاب‌هایی مثل غوث القلوب ابوطالب مکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 869.05,
   "end": 871.95,
   "text": "عده الداعی علامه حلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 871.95,
   "end": 878.11,
   "text": "یا فلاح السائل سید ابن طاووس، مفتاح الفلاح شیخ بهایی و همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 878.11,
   "end": 881.09,
   "text": "صحیفه سجادیه و این‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 881.09,
   "end": 884.51,
   "text": "این‌ها در عمل بسیار انسان رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 884.51,
   "end": 887.71,
   "text": "عقل عملی کمک می‌کنه. در کنار این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 887.71,
   "end": 889.93,
   "text": "خیلی حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 889.93,
   "end": 892.61,
   "text": "عزیزانی که دوست دارن در مشرب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 892.61,
   "end": 895.79,
   "text": "انسان جامع الاسراف باشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 895.79,
   "end": 898.75,
   "text": "ااا خیلی تاکید داشتن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 898.75,
   "end": 901.85,
   "text": "خوانش کتاب‌های حدیثی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 901.85,
   "end": 906.77,
   "text": "مجامع روایی ما به خصوص اصول کافی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 906.77,
   "end": 909.53,
   "text": "یا وافی ملا محسن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 909.53,
   "end": 914.53,
   "text": "علم یقین، عین یقین، حق یقین ملا محسن فیضی نا کتاب‌های عالی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 914.53,
   "end": 917.61,
   "text": "توحید شیخ صدوق خیلی مورد تأکید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 917.61,
   "end": 921.79,
   "text": "حضرت استاد بودن که این‌ها البته همه‌شون شرح می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 921.79,
   "end": 925.79,
   "text": "و شروحی هم بر این‌ها الحمد لله نوشته شده و خاصه نهج البلاغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 925.79,
   "end": 929.83,
   "text": "این‌ها خیلی عالی‌اند و کتاب‌های حدیثی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 929.83,
   "end": 932.79,
   "text": "چون کتاب‌هایی که گفتیم غالبا این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 932.79,
   "end": 937.29,
   "text": "تفاسیر انفسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 937.29,
   "end": 939.99,
   "text": "نه افقی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 939.99,
   "end": 947.39,
   "text": "اون‌ها در حقیقت پیاده شدن، نحوه پیاده شدن آیات رو در وجود ما به ما می‌آموزند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 947.39,
   "end": 950.57,
   "text": "خب بعد علامه تاکید می‌کنند خصوصا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 950.57,
   "end": 954.25,
   "text": "که بسنده نکنیم به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 954.25,
   "end": 958.19,
   "text": "خب اون آیات و اون روایات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 958.19,
   "end": 961.87,
   "text": "حکما و عرفا در خودشون پیاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 961.87,
   "end": 966.39,
   "text": "خروجی‌ش شد کتاب‌های این‌ها در حکمت و عرفان نظری و عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 966.39,
   "end": 970.13,
   "text": "خود ما هم این احادیث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 970.13,
   "end": 973.11,
   "text": "البته با معلم و استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 973.11,
   "end": 977.35,
   "text": "بخوانیم و این‌ها رو در کانال وجودی خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 977.35,
   "end": 979.63,
   "text": "قرار بدیم، پیاده کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 979.63,
   "end": 985.77,
   "text": "بلکه از ما هم اون خروجی‌های متناسب با اون حس وجودی و اسم اعظم‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 985.77,
   "end": 988.93,
   "text": "و اون رب وجودی‌مون حاصل بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 988.93,
   "end": 993.05,
   "text": "ان شا الله که امیدوارم خدای منان هممون رو کمک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 993.05,
   "end": 997.25,
   "text": "و حالا برای مقدمه این مباحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 997.25,
   "end": 1000.47,
   "text": "اونچه که از این بنده حقیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1000.47,
   "end": 1004.85,
   "text": "در کانال گذاشته میشه خصوصا سیر قلب در قرآن یا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1004.85,
   "end": 1007.25,
   "text": "موضوع لقاء الله این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1007.25,
   "end": 1010.49,
   "text": "این‌ها هم کمک حال شما می‌تونه باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1010.49,
   "end": 1014.53,
   "text": "که امیدوارم که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1014.53,
   "end": 1019.15,
   "text": "از ما این پوشه هل رو و برگ گل رو به عبارتی که معطر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1019.15,
   "end": 1022.21,
   "text": "عطر و منور به نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1022.21,
   "end": 1025.13,
   "text": "آیات و روایات و گفتار بزرگان عصر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1025.13,
   "end": 1028.57,
   "text": "به کرمش بپذیره، به فضل و رحمتش قبول کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1028.57,
   "end": 1031.57,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1031.57,
   "end": 1033.57,
   "text": "از همه عزیزان التماس دعا دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}