 "chapters": [
  {
   "index": 0,
   "title": "## اصطلاحات عرفان و فلسفه از آیات و روایات",
   "start": 8.26,
   "end": 143.18
  },
  {
   "index": 1,
   "title": "## فلسفه همان حکمت قرآن",
   "start": 143.18,
   "end": 239.52
  },
  {
   "index": 2,
   "title": "## أرنی الأشیاء کما هی؛ علم آدم الأسماء",
   "start": 239.52,
   "end": 355.42
  },
  {
   "index": 3,
   "title": "## تأکید علامه بر کتب حکمت و عرفان نظری",
   "start": 355.42,
   "end": 455.66
  },
  {
   "index": 4,
   "title": "## وجه تمایز انسان؛ عقل و تحقق",
   "start": 455.66,
   "end": 618.74
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.8,
   "end": 4.9,
   "text": "بسم الله و بالله و علی ملة رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.9,
   "end": 8.26,
   "text": "المستغوث بک یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.26,
   "end": 13.36,
   "text": "در ادامه‌ی پاسخ به سؤال عزیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.36,
   "end": 18.2,
   "text": "در خصوص سیر حکمت و عرفان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.2,
   "end": 20.84,
   "text": "تلقی اشتباه بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.84,
   "end": 26.22,
   "text": "که این‌ها جدایی از روایات و آیات الهی هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.22,
   "end": 29.12,
   "text": "نکته‌ی دیگری رو هم عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.12,
   "end": 31.86,
   "text": "فرصت نشد در اون جلسه عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.86,
   "end": 39.54,
   "text": "اونم این که ببینید تمام اصطلاحات عرفانی و فلسفی همه از روایات و آیات گرفته شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.54,
   "end": 42.1,
   "text": "حتی اصطلاحاتشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.1,
   "end": 47.56,
   "text": "نامشون، عناوینشون، موضوعاتشون، مفاهیمشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.56,
   "end": 53.1,
   "text": "مبانیشون و استنباط یک عارف و یک فیلسوف کاملاً بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.1,
   "end": 58.12,
   "text": "زیرمبنای در حقیقت آیات و روایات هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.12,
   "end": 61.14,
   "text": "ببینید خود عرفان از معارف گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.14,
   "end": 63.7,
   "text": "معارف اهل بیت، معارف قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.7,
   "end": 70.92,
   "text": "علوم قرآنی که اون «و ما خلقت الجن والانس الا ليعبدون» اون عبادت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.92,
   "end": 73.72,
   "text": "اهل بیت علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.72,
   "end": 77.42,
   "text": "در حقیقت چی گرفتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.42,
   "end": 80.34,
   "text": "فرمودن «اي ليعرفون»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.34,
   "end": 84.32,
   "text": "که مفسرین شیعه همه این رو آوردن ذیل همین آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.32,
   "end": 87.8,
   "text": "«اي ليعرفون» یعنی اون عبادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.8,
   "end": 90.8,
   "text": "همون عرفان است، شناخت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.8,
   "end": 95.14,
   "text": "یا آقا امام صادق صلوات الله علیه در اون بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.14,
   "end": 99.12,
   "text": "بسیار سنگین و شریفشون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.12,
   "end": 102.12,
   "text": "العبودیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.12,
   "end": 105.38,
   "text": "جوهرتن کنه و هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.38,
   "end": 109.0,
   "text": "ربوبیه. عبادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.0,
   "end": 112.04,
   "text": "یک جوهره‌ای دارد که جوهرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.04,
   "end": 114.68,
   "text": "ربوبیت حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.68,
   "end": 117.74,
   "text": "یعنی اصلاً اون عبودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.74,
   "end": 123.4,
   "text": "به منهای ربوبیت اصلاً معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.4,
   "end": 128.76,
   "text": "و رب به نظام هستی‌ست که تو رو به عبادت می‌کشاند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.76,
   "end": 132.02,
   "text": "اون نقطه اتصال هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.02,
   "end": 134.94,
   "text": "به در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.94,
   "end": 138.24,
   "text": "حضرت حق است که او رو به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.24,
   "end": 142.68,
   "text": "بندگی و عبادت یا عرفان و معرفت می‌کشاند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.68,
   "end": 145.28,
   "text": "البته باید توجه داشت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.28,
   "end": 148.54,
   "text": "فلسفه به زبان یونانی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.54,
   "end": 152.58,
   "text": "و به زبان قرآن فلسفه می‌شود همان حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 152.58,
   "end": 157.54,
   "text": "چقدر ما در قرآن از حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.54,
   "end": 159.34,
   "text": "بیان داریم، آیه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.34,
   "end": 163.98,
   "text": "اصلاً یکی از اسامی زیبای حضرت حق حکیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.98,
   "end": 166.16,
   "text": "خود قرآن حکمت مطلق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 166.16,
   "end": 171.5,
   "text": "«یا سین والقرآن الحکیم».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.5,
   "end": 175.24,
   "text": "یعنی خود قرآن حکیم است، حکمت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 175.24,
   "end": 178.28,
   "text": "در آیه‌ی دو سوره جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.28,
   "end": 182.58,
   "text": "می‌خوانیم که «و يعلمهم الكتاب و الحکمة».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 182.58,
   "end": 186.22,
   "text": "فلسفه به دست انبیا رو وقتی بیان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.22,
   "end": 190.38,
   "text": "بعد از در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 190.38,
   "end": 194.36,
   "text": "تلاوت آیات «يَتْلُو عَلَيْهِمْ آيَاتِهِ»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.36,
   "end": 196.88,
   "text": "و طهارت «و يزكيهم»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 196.88,
   "end": 201.8,
   "text": "می‌فرمود که «و يعلمهم الكتاب و الحکمة».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.8,
   "end": 205.22,
   "text": "این حکمت همون بحث عرفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.22,
   "end": 207.74,
   "text": "که چیز عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 207.74,
   "end": 210.58,
   "text": "و جالبه که خود قرآن به پیغمبر می‌فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 210.58,
   "end": 215.26,
   "text": "اینا بحث‌ها گذشته قبلاً که «ادع الي سبيل ربک»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 215.26,
   "end": 219.42,
   "text": "سطح دعوت رو چنان بالا می‌بره که می‌فرمود به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 219.42,
   "end": 221.68,
   "text": "پروردگار خودت مردم رو دعوت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 221.68,
   "end": 224.08,
   "text": "با چی؟ اول می‌فرماید «بالحکمة».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 224.08,
   "end": 225.8,
   "text": "«بالحکمة».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 225.8,
   "end": 228.46,
   "text": "بعد «و الموعظة الحسنة».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 228.46,
   "end": 230.56,
   "text": "بعد «وجادلهم التي هي أحسن».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 230.56,
   "end": 233.46,
   "text": "این آیات قرآن بنده می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 233.46,
   "end": 237.58,
   "text": "یا جالبه که مگر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 237.58,
   "end": 245.24,
   "text": "معنای فلسفه یا حکمت حکما نفرمودن یکی از ترجمه‌هایی که از علامه دارند بر حقیقت حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 245.24,
   "end": 249.62,
   "text": "یا در حقیقت فلسفه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.62,
   "end": 252.1,
   "text": "فلسفه همون علم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 252.1,
   "end": 254.26,
   "text": "اعیان موجودات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 254.26,
   "end": 263.56,
   "text": "اون گونه که هستند. یعنی شما موجودات و همین اشیاء نظام هستی رو که اسم الله‌اند این‌ها رو اون گونه که هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 263.56,
   "end": 266.16,
   "text": "بشناسی و ببینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 266.16,
   "end": 268.78,
   "text": "از ظاهرشون به باطن‌شون پی ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 268.78,
   "end": 274.48,
   "text": "مگر پیغمبر عظیم الشأن اسلام در دعاشون عرض نکردند به خدای منّان که «اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 274.48,
   "end": 277.54,
   "text": "أرني الأشياء كما هي».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 277.54,
   "end": 281.02,
   "text": "خدایا به من نشون بده همه چیز رو اونطور که هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 281.02,
   "end": 288.26,
   "text": "خب آیا این به غیر از حکمت یعنی پیغمبر از خدا به غیر از حکمت یا فلسفه یا همون عرفان خواسته طلب کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 288.26,
   "end": 293.08,
   "text": "جالبه که در آیه «و علم آدم الأسماء كلها»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.08,
   "end": 297.6,
   "text": "همه اسماء رو خدا تعلیم کرده به دست آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 297.6,
   "end": 302.78,
   "text": "به اون آدم علی الاطلاق که اول وجود مقدّس حضرت پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.78,
   "end": 306.42,
   "text": "خاتم الانبیا صلی الله عليه وآله وسلم هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.42,
   "end": 311.22,
   "text": "اینو حضرت علامه می‌گیرن این الأسماء رو می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.22,
   "end": 313.88,
   "text": "بگید الأشياء. یعنی حقیقتش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.88,
   "end": 318.54,
   "text": "یعنی علّم «و علم آدم الأشياء كلها».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 318.54,
   "end": 322.54,
   "text": "منتها این اشیاء رو که همون اسماء الله هستند رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.54,
   "end": 324.72,
   "text": "دیگه كما هيه. كما هيه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 324.72,
   "end": 326.28,
   "text": "یعنی اونطور که هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 326.28,
   "end": 330.48,
   "text": "یعنی ظاهر و باطن رو، اون حقیقت کلیه‌شون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 330.48,
   "end": 332.88,
   "text": "به دست آدم تعلیم دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 332.88,
   "end": 337.02,
   "text": "خب حالا شما بفرمایید با این نگاه وقتی حکمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.02,
   "end": 343.12,
   "text": "فلسفه و عرفان و این‌ها رو می‌بینید اصلاً جرأت می‌کنید بگید که جدایی از قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 343.12,
   "end": 345.08,
   "text": "یک چیز العیاذ بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.08,
   "end": 350.16,
   "text": "مثلاً خیال و وهم حکما و این‌هاست یا عرفا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.16,
   "end": 354.98,
   "text": "و مضافاً به اینکه از علامه اینو خوب دقت کنن عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.98,
   "end": 358.9,
   "text": "حضرت علامه می‌فرمایند نه من بچه طلبه، این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.9,
   "end": 362.44,
   "text": "جامع الاطراف که در جمعی علوم روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 362.44,
   "end": 369.78,
   "text": "تخصص و تبحر دارن، کتاب دارن، حرف دارن، مطلب دارن، درس و بحث داشتن این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.78,
   "end": 373.04,
   "text": "می‌فرمایند که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.04,
   "end": 377.16,
   "text": "این کتاب‌های سیر حکمتی و عرفانی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.16,
   "end": 381.0,
   "text": "پی‌ش رو نگیره یعنی سیر حکمت عرفانی و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.0,
   "end": 383.32,
   "text": "و عرض شود حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.32,
   "end": 386.9,
   "text": "نظری و عرفان نظری رو نره تا به عملی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 386.9,
   "end": 390.72,
   "text": "یعنی کتاب‌هایی مثل اصلاً اسم می‌برم نشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 390.72,
   "end": 396.0,
   "text": "مثلاً کتاب اسفار ملاصدرا رو که ام‌الکتاب فلسفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 396.0,
   "end": 398.18,
   "text": "کتاب اشارات الشفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 398.18,
   "end": 402.6,
   "text": "مال شیخ الرئیس علیه الرحمه یا مثلاً کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 402.6,
   "end": 408.76,
   "text": "می‌فرماید فسوس الحکم ابن عربی رو یا شرح فسوس قیصری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 408.76,
   "end": 411.52,
   "text": "یا و همچنین تمهید القواعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 411.52,
   "end": 413.82,
   "text": "ابن ترکه رو، مصباح العنس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 413.82,
   "end": 419.04,
   "text": "ابن فناری رو. این‌ها کتاب‌هاییه که از تعالمه روشون تأکید دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 419.04,
   "end": 423.72,
   "text": "در هر حال می‌فرمایند این دست کتاب‌ها رو اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 423.72,
   "end": 427.36,
   "text": "نخواند و پی‌ش رو نگیره عزیز دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.36,
   "end": 430.78,
   "text": "علامه فرمودن به جانم سوگند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 430.78,
   "end": 436.1,
   "text": "که به باطن قرآن پی نخواهد برد که چنین کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.1,
   "end": 438.76,
   "text": "خب آیا ما نباید بترسیم و باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 438.76,
   "end": 445.14,
   "text": "به‌خاطر حرف چهار تا آدم که اصلاً نفهمیدند فلسفه و عرفان و حکمت چیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 445.14,
   "end": 447.96,
   "text": "دست از این حقایق نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.96,
   "end": 451.6,
   "text": "که آتش وجودی ما را برطرف می‌کند بکشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 451.6,
   "end": 454.78,
   "text": "و در جلسه‌ی پیش در پاسخ اول عرض شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.78,
   "end": 458.44,
   "text": "که اساساً وجه تمایز ما با موجودات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.44,
   "end": 461.46,
   "text": "به غیر از اینکه ما عقل داریم و اون‌ها ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 461.46,
   "end": 463.78,
   "text": "الان موضوعات اخلاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 463.78,
   "end": 467.2,
   "text": "جالبه که م-موازین اخلاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.2,
   "end": 471.66,
   "text": "یا در حقیقت کنش‌های بر اساس اخلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 471.66,
   "end": 474.24,
   "text": "تو حیوانات هم هست. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 474.24,
   "end": 477.64,
   "text": "این ثابت شده است. یعنی اون‌ها عقل ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.64,
   "end": 480.38,
   "text": "اما و ان الوهمه عقل ساقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.38,
   "end": 484.16,
   "text": "حضرت علامه فرمود وهم عقل ساقط شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 484.16,
   "end": 485.92,
   "text": "یعنی اون هم بویی از عقل برده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 485.92,
   "end": 489.1,
   "text": "لذا حیوانات اون عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.1,
   "end": 492.38,
   "text": "خالص رو ندارند. اما وهم که دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 492.38,
   "end": 497.04,
   "text": "بر اساس وهم‌شون اصول اخلاقی رو تشخیص میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 497.04,
   "end": 500.04,
   "text": "یعنی پرخوری نمی‌کنند. ح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 500.04,
   "end": 503.66,
   "text": "در حقیقت اه حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 503.66,
   "end": 508.94,
   "text": "اون می‌شه گفت از جهت خوی حیوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.94,
   "end": 513.12,
   "text": "شدید القوی‌ترین‌هاشون مثلاً پلنگ و شیر و این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.12,
   "end": 516.24,
   "text": "در حیات وحش دیده شده. من دیدم فیلم‌هاشو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 516.24,
   "end": 520.94,
   "text": "مثلاً شیر گرسنه حمله می‌کنه به آهویی، گوزنی که او رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 520.94,
   "end": 525.24,
   "text": "اه شکار کنه. وقتی متوجه می‌شه که این آهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 525.24,
   "end": 527.92,
   "text": "باردار هست رهاش می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 527.92,
   "end": 529.6,
   "text": "و گرسنگی رو تحمل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 529.6,
   "end": 532.08,
   "text": "این آیا اصول اخلاقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 532.08,
   "end": 535.52,
   "text": "به غیر از اینه؟ خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 535.52,
   "end": 538.44,
   "text": "در حقیقت می‌خوام عرض کنم که اینکه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 538.44,
   "end": 545.42,
   "text": "بدیهیات اخلاق رو رعایت کنه که خیلی هنر نیست که بعضیا میگن دین همینه و لاغیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 545.42,
   "end": 547.18,
   "text": "انسانیت همان دین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 547.18,
   "end": 549.84,
   "text": "بله این‌ها هم جزئی از دین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 549.84,
   "end": 552.72,
   "text": "اما مهم‌ترین وجه تمایز ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 552.72,
   "end": 555.42,
   "text": "سیر فکری‌ست، عقلی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 555.42,
   "end": 559.1,
   "text": "لبی‌ست، تعملی‌ست، تفکری‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 559.1,
   "end": 565.2,
   "text": "تدققی‌ست. یعنی انسان اهل تدقق باشد نه دقت تازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 565.2,
   "end": 567.44,
   "text": "اهل در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 567.44,
   "end": 572.14,
   "text": "اینکه محقق باشد خوبه اما متحقّق مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 572.14,
   "end": 575.28,
   "text": "اهل دقت باشد خوبه اما متدقق خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 575.28,
   "end": 577.4,
   "text": "یعنی این دقت درش پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.4,
   "end": 580.04,
   "text": "اون تحقیقاتش درش پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 580.04,
   "end": 582.78,
   "text": "این‌ها با سیر علمیه در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 582.78,
   "end": 586.24,
   "text": "در حقیقت حکمت و عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 586.24,
   "end": 590.18,
   "text": "ابتدا به صورت نظری و سپس به صورت عملی امکان‌پذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 590.18,
   "end": 595.5,
   "text": "در غیر این صورت نمی‌شه انسان در همون مراتب ابتدایی خواهد ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 595.5,
   "end": 597.48,
   "text": "خب به همین مقدار کفایت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 597.48,
   "end": 604.46,
   "text": "اما خب بیشتر از این اگر خواستید تو کتاب‌های خود حضرت علامه می‌تونید پی ببرید به این حقایق و جواب‌ها رو بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 604.46,
   "end": 611.94,
   "text": "باز هم توصیه می‌کنم به سیر معرفت نفس حضرت علامه حداقل به صورت ابتدایی اون صد و پنجاه و سه درس ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 611.94,
   "end": 615.3,
   "text": "در کتاب معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 615.3,
   "end": 616.88,
   "text": "انشاالله که موفق باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 616.88,
   "end": 618.74,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}