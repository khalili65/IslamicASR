 "chapters": [
  {
   "index": 0,
   "title": "## پرسش از ورود عارفان به عرصهٔ اجتماع",
   "start": 9.78,
   "end": 248.96
  },
  {
   "index": 1,
   "title": "کلمات وجودی نظام هستی بر اساس آیهٔ قرآن همه در نشئهٔ طبیعت تنزل یافته‌اند:",
   "start": 248.96,
   "end": 346.14
  },
  {
   "index": 2,
   "title": "## شیاطین بالعرض‌اند نه بالأصاله",
   "start": 346.14,
   "end": 586.53
  },
  {
   "index": 3,
   "title": "## عارف‌نمایان ذیل اسم مذل",
   "start": 586.53,
   "end": 656.79
  },
  {
   "index": 4,
   "title": "## عارفان حقیقی؛ قرآن و برهان و عرفان",
   "start": 656.79,
   "end": 701.61
  },
  {
   "index": 5,
   "title": "## نمونهٔ آیت‌الله بهجت و نظام",
   "start": 701.61,
   "end": 912.45
  },
  {
   "index": 6,
   "title": "## اهل باطن و سکوت؛ سعهٔ وجودی",
   "start": 912.45,
   "end": 1007.63
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.18,
   "end": 7.24,
   "text": "بسم الله و بالله و على ملة رسول الله المستغاث بك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.24,
   "end": 12.52,
   "text": "يا حجة الله. عزیزی پرسیده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.52,
   "end": 16.48,
   "text": "با وجود اینکه عرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.48,
   "end": 21.92,
   "text": "مثلا به قول شما از ظاهر به باطن سفر کردن چگونست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.92,
   "end": 30.42,
   "text": "خیلی از این‌ها در امور و مسائل اجتماعی و سیاسی وارد نمی‌شن با اینکه باید الگوی ما باشند و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.42,
   "end": 34.9,
   "text": "ببینید عزیزان عرفان مقوله‌ایست که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.9,
   "end": 37.18,
   "text": "اساساً بر اساس همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.18,
   "end": 40.04,
   "text": "اسمی که رو خودش گذاشته شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.04,
   "end": 45.06,
   "text": "نشان‌دهنده یک نوع شناخت و یک ارتباطی‌ست با باطن عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.06,
   "end": 48.4,
   "text": "با در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.4,
   "end": 54.22,
   "text": "عالم معنا. خودش یک نوع سفر از ظاهر به باطن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.22,
   "end": 56.78,
   "text": "لکن خب استعدادها مختلف‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.78,
   "end": 60.6,
   "text": "اولاً وجود انسان، نفس انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.6,
   "end": 64.0,
   "text": "مثلا یکی از دلایلی که اسمشون نفس گذاشتن همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.0,
   "end": 67.64,
   "text": "به قدری لطیفه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.64,
   "end": 74.64,
   "text": "اگر بر اساس قاعده لطف حضرت حق و اسم یا لطیف خدای منان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.64,
   "end": 79.64,
   "text": "به قدری لطیفه که با مختصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.64,
   "end": 81.7,
   "text": "در حقیقت قرار گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.7,
   "end": 84.68,
   "text": "در چارچوب سختی‌های عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.68,
   "end": 88.54,
   "text": "خصوصاً در عالم ماده و نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.54,
   "end": 95.24,
   "text": "که به بدن خودش اگر طرف سختی یعنی به اون انزل مراتب که ظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.24,
   "end": 99.44,
   "text": "به عالم ظاهر سختی وارد بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.44,
   "end": 104.52,
   "text": "در حقیقت این کسری و این نقصان در باطن جبران می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.52,
   "end": 109.5,
   "text": "باید این دو کفه به توازن برسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.5,
   "end": 115.76,
   "text": "لذا شما نمی‌بینید ولیی از اولیای خدا رو که نسبت به مقام و جایه مرتبه‌ای که او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.76,
   "end": 120.52,
   "text": "پیدا کرده به همون میزان سختی ندیده باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.52,
   "end": 124.2,
   "text": "يا أَيُّهَا الْإِنسَانُ إِنَّكَ كَادِحٌ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.2,
   "end": 129.32,
   "text": "کاده بارها عرض کردیم رونده همراه با سختی اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.32,
   "end": 133.74,
   "text": "الی ربك. چرا كَادِحٌ به جهت اینکه الی ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 133.74,
   "end": 139.4,
   "text": "به جهت اینکه قراره به سمت پروردگارت حرکت کنی كَادِحٌ اونم باز تأکیده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.4,
   "end": 141.14,
   "text": "قطعاً همراه با سختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.14,
   "end": 145.72,
   "text": "برای چی این همه سختی؟ فَمُلَاقِيهِ برای اینکه ملاقاتش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.72,
   "end": 148.88,
   "text": "حالا بحث چیز دیگه ای وارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.88,
   "end": 151.3,
   "text": "حاشیه نشیم. در هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.3,
   "end": 156.24,
   "text": "با مختصر سختی که انسان در این نشئه طبیعت می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.24,
   "end": 159.6,
   "text": "و آسیبی که بهش وارد می‌شه ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.6,
   "end": 163.46,
   "text": "باطنش تقویت می‌شه. این یک اصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.46,
   "end": 169.66,
   "text": "اگر اون آسیب رساندن‌های به ظاهرش بر اساس شرعیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.66,
   "end": 172.94,
   "text": "و دستورات دین مبین باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.94,
   "end": 177.16,
   "text": "آنچه که تقویت می‌شود از باطن‌اش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.16,
   "end": 180.46,
   "text": "اون تقویت شدن اصیل است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.46,
   "end": 185.38,
   "text": "اساسی‌ست. یعنی ریشه‌دار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.38,
   "end": 187.96,
   "text": "محکم است. أصلها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.96,
   "end": 191.54,
   "text": "ثابت. که اگر این اصیل باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.54,
   "end": 195.04,
   "text": "اصلش ثابت باشه، ریشه‌دار باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.04,
   "end": 198.26,
   "text": "یعنی بر اساس مبانی دینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.26,
   "end": 201.74,
   "text": "باشد. یعنی پشت شرع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.74,
   "end": 205.32,
   "text": "اون سختی‌ها، اون کارها، اون اعمال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.32,
   "end": 209.32,
   "text": "اون اتفاقاتی که در ظاهر می‌افتد اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.32,
   "end": 212.3,
   "text": "در حقیقت دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.3,
   "end": 218.22,
   "text": "حمایت و عنایت و رضایت حضرت حق بر این اعمال باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.22,
   "end": 221.64,
   "text": "و باطن‌اش هم ریشه‌دار می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.64,
   "end": 226.1,
   "text": "یعنی متصله به حقیقت عالم می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.1,
   "end": 231.04,
   "text": "این نکته رو خوب توجه داشته باشیم که بالاخره کلمات وجودی نظام هستی بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.04,
   "end": 235.58,
   "text": "آیه قرآن همه تنزل پیدا کردن در نشئه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.58,
   "end": 239.64,
   "text": "إن من شيء لعندنا خزائنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.64,
   "end": 242.06,
   "text": "وما ننزله إلا بقدر معلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.06,
   "end": 248.72,
   "text": "بارها عرض کردیم که پس این نشون می‌ده که تمام کلمات وجودی نظام هستی تنزل پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.72,
   "end": 252.52,
   "text": "خب شیطان هم یکی از همین کلمات وجودی نظام هستیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.52,
   "end": 254.34,
   "text": "پس ایشون هم تنزل پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.34,
   "end": 258.08,
   "text": "یه مرتبه ظاهر داره، یه مرتبه باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.08,
   "end": 260.56,
   "text": "خب وقتی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.56,
   "end": 263.16,
   "text": "در حقیقت اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 263.16,
   "end": 266.64,
   "text": "اتفاقاتی که در مرحله ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.64,
   "end": 271.84,
   "text": "رخ می‌ده، کارهایی که در مرحله ظاهر در این دنیا انجام می‌دیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.84,
   "end": 276.32,
   "text": "عملیاتی که در این دنیا ظاهراً انجام می‌دیم و باهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.32,
   "end": 281.98,
   "text": "برخورد می‌کنیم بر اساس ولایت شیطان باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.98,
   "end": 286.02,
   "text": "به-- که قرآن می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.02,
   "end": 288.52,
   "text": "أولياءهم الطاغوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.52,
   "end": 293.04,
   "text": "طاغوت در حقیقت ولایت این‌ها می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.04,
   "end": 297.14,
   "text": "که سرمنشأش خود شیطان است که أبا وسط کبرط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.14,
   "end": 299.9,
   "text": "طاغوت همون استکباره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.9,
   "end": 302.8,
   "text": "خب این وقتی در سطح ظاهر تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.8,
   "end": 305.26,
   "text": "شیطنت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.26,
   "end": 310.14,
   "text": "طاغوت و طواغیت دنیا و ظاهر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.14,
   "end": 316.9,
   "text": "صورت گرفت، چون اون‌ها هم دقت بفرمایید چون اون‌ها هم مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.9,
   "end": 322.02,
   "text": "باطنی‌تر دارند و تنزل پیدا کردند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.02,
   "end": 324.72,
   "text": "اگر هر مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 324.72,
   "end": 328.06,
   "text": "اون شخصی که اشتباه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.06,
   "end": 334.08,
   "text": "نه رحمانی بلکه شیطانی عمل کرده به س-- جسمش سختی داره مثل مو-- مرتضی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.08,
   "end": 338.32,
   "text": "مثل خیلی از عرفایی که راهشون درست نبوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.32,
   "end": 344.28,
   "text": "به هر مقدار که ظاهراً گمان می‌کنه به غیب عالم دسترسی پیدا کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.28,
   "end": 348.12,
   "text": "اون به باطن شیاطین دسترسی پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.12,
   "end": 350.98,
   "text": "به مراحل باطنی‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.98,
   "end": 357.4,
   "text": "اسمایی که در حقیقت ذیل اسم مدل حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.4,
   "end": 361.94,
   "text": "تعریف شدن دسترسی پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.94,
   "end": 366.46,
   "text": "چون خدا إن الله يهدي من يشاء ويضل من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 366.46,
   "end": 369.69,
   "text": "قاعده اضلال خلاصه خدا مذل هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 369.69,
   "end": 373.91,
   "text": "اسم خدا که نمی‌شه پیاده نشه و معطل بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.91,
   "end": 376.37,
   "text": "مجری دارد این اضلال الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 376.37,
   "end": 381.07,
   "text": "این گمراهی کردنی که نسبت به خدا داده شده که لا حول ولا قوه الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 381.07,
   "end": 385.53,
   "text": "درسته ابتدا از خواست خود طرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.53,
   "end": 390.55,
   "text": "یعنی اراده خود طرفه که می‌خواد گمراه بشه و خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.55,
   "end": 393.39,
   "text": "کلاً نمد هاؤلاء و هاؤلاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.39,
   "end": 399.25,
   "text": "چه اهل ولایت رحمانی، چه اهل ولایت شیطانی رو هر دو تا رو خدا نمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.25,
   "end": 401.53,
   "text": "مد، کشیدن، امداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 401.53,
   "end": 409.01,
   "text": "کمک می‌کنه. راه رو براشون باز می‌کنه، خط‌کشی می‌کنه و اینا رو می‌بره به اون سمت که می‌خوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 409.01,
   "end": 417.07,
   "text": "و چون شیاطین هم ذیل اسم مذل حضرت حق تعریف شدن و اون‌ها هم به نحوی باطن دارن، اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 417.07,
   "end": 418.89,
   "text": "این‌ها ذاتی نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 418.89,
   "end": 423.49,
   "text": "بالعرض‌اند. بالعصاله نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 423.49,
   "end": 428.29,
   "text": "یعنی مثل سایه‌اند. مثل پرنده‌ای که تو آسمون حرکت می‌کنه، سایه‌اش رو زمین می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.29,
   "end": 431.85,
   "text": "تو سایه رو می‌بینی. اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 431.85,
   "end": 434.17,
   "text": "این پرنده که این سایه نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.17,
   "end": 438.53,
   "text": "اون اصله. اون اصل، اون پرنده‌ای که توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.53,
   "end": 441.65,
   "text": "آسمون داره حرکت می‌کنه. این سایه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 441.65,
   "end": 445.07,
   "text": "شیاطین که کلمات وجودی نظام هستی هست-هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 445.07,
   "end": 449.05,
   "text": "این‌ها اساساً یعنی اصل وجودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 449.05,
   "end": 454.37,
   "text": "درسته و اون‌ها هم حتی به قاعده لطف الهی خلق شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 454.37,
   "end": 459.51,
   "text": "و خدا اینا رو ذاتاً بالعصاله شیطان خلق نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 459.51,
   "end": 465.11,
   "text": "خودشون خواستن، اراده کردن که شیطان بشوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 465.11,
   "end": 471.19,
   "text": "لذا شدن محل ظهور اسم مذل حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 471.19,
   "end": 477.51,
   "text": "چون خودشون اراده کردن خدا هم به اسم مذل خودش در اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 477.51,
   "end": 480.65,
   "text": "ظهور کرد در حقیقت. که باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 480.65,
   "end": 486.59,
   "text": "با این حساب لا حول ولا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 486.59,
   "end": 497.51,
   "text": "خب که البته اسنادن این رو اگر کسی حالا مثلاً دچار گناهی چیزی بشه، اینو دیگه اسناد به حضرت حق نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 497.51,
   "end": 501.35,
   "text": "به جهت اینکه این دیگه اوج تقوای عرفا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 501.35,
   "end": 503.55,
   "text": "که اگر هر ضعفی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 503.55,
   "end": 506.05,
   "text": "نظام هستی ببینن، این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 506.05,
   "end": 509.41,
   "text": "اطلاقاً به خدا نسبت نمی‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 509.41,
   "end": 512.75,
   "text": "اسناد نمی‌دن. اسنادن. به خودشون نسبت می‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 512.75,
   "end": 516.83,
   "text": "چون خودشون خواستن. لذا در طول اراده خدا نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 516.83,
   "end": 520.53,
   "text": "خواست خدا قرار گرفت. خدا یه خواست داره، یه اراده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 520.53,
   "end": 523.75,
   "text": "خواسته که ما بتوانیم گناه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.75,
   "end": 526.83,
   "text": "اما اراده نکرده که ما گناه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 526.83,
   "end": 531.31,
   "text": "اراده فإذا أراد شیئاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 531.31,
   "end": 533.01,
   "text": "أيقول له کن فيكون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 533.01,
   "end": 535.71,
   "text": "وقتی خدا چیزی رو اراده کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.71,
   "end": 538.03,
   "text": "فقط کافیه بگوید که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 538.03,
   "end": 539.93,
   "text": "باش. کن. باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 539.93,
   "end": 543.43,
   "text": "فيكون. پس درجامی باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 543.43,
   "end": 546.39,
   "text": "یعنی این اراده خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 546.39,
   "end": 549.79,
   "text": "اراده خدا بر این تحقق گرفته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 549.79,
   "end": 552.41,
   "text": "ما کار خیر بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 552.41,
   "end": 558.19,
   "text": "اما خب اگر نمی‌خواست که ما بتوانیم کار شر انجام بدیم، خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 558.19,
   "end": 562.31,
   "text": "باز ما در مرتبه ملائکه قرار می‌گرفتیم که اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 562.31,
   "end": 564.65,
   "text": "عقلًا نمی‌تونن گناه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 564.65,
   "end": 568.57,
   "text": "چون نفس ندارن. در حقیقت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 568.57,
   "end": 571.31,
   "text": "اماره ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 571.31,
   "end": 577.81,
   "text": "اما لطف خدا بر این تحقق گرفت که به ما اراده بدهد که بتوانیم گناه کنیم تا به مدارج برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 577.81,
   "end": 581.61,
   "text": "یعنی از مخالک فاصله بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 581.61,
   "end": 585.03,
   "text": "بر اساس معارج به مدارج برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 585.03,
   "end": 594.55,
   "text": "خب پس بسیاری از کسانی که گمانشون این هست یا دیگران گمان می‌کنند که این‌ها به باطن عالم راه پیدا کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 594.55,
   "end": 598.11,
   "text": "به لایه‌های سایه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 598.11,
   "end": 602.21,
   "text": "عالم یا که ار-عرضی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 602.21,
   "end": 605.39,
   "text": "ذاتی و اس-- بالعصاله نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 605.39,
   "end": 610.67,
   "text": "یعنی به در حقیقت محیط ولایی شیاطین راه پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 610.67,
   "end": 614.53,
   "text": "مثل مرتضی‌ها که با نگاهش قطار رو نگه می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 614.53,
   "end": 616.61,
   "text": "روزی یه دونه خرما فقط می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 616.61,
   "end": 619.91,
   "text": "اینا و و و. این‌ها تونستن به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 619.91,
   "end": 624.91,
   "text": "از طریق، از طریق غیر رحمانی یا غیر شرعی برسند به اون قدرت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 624.91,
   "end": 632.71,
   "text": "خب این‌ها دیگه فهمشون عمیق نیست، چشم باطن‌بین‌شون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 632.71,
   "end": 636.21,
   "text": "غیب‌بین‌شون دقیق نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 636.21,
   "end": 640.53,
   "text": "ظریف نیست. لذا متحقq هم نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 640.53,
   "end": 644.37,
   "text": "یعنی حق درشون پیاده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 644.37,
   "end": 650.53,
   "text": "خب این تا اینجا. پس بسیاری از اونایی که ما گمان می‌کنیم عارف به الله هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 650.53,
   "end": 654.09,
   "text": "نه خیر. عارف، عارف به الله نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 654.09,
   "end": 656.79,
   "text": "این‌ها ذیل اسم مذل حضرت حق تعریف می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 656.79,
   "end": 659.51,
   "text": "اما در میان اون دسته از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 659.51,
   "end": 663.03,
   "text": "کسانی که عارف به الله هستند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 663.03,
   "end": 669.45,
   "text": "در حقیقت ذیل قرآن حرکت کردن، ذیل روایات حرکت کردن، به قول از تعالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 669.45,
   "end": 674.85,
   "text": "بر اساس رساله شریف‌شون که قرآن و برهان و عرفان یک حقیقت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 674.85,
   "end": 682.05,
   "text": "با قرآن پیش رفتن، با برهان و ادله عقلی و فلسفه و حکمت پیش رفتن و به عرفان رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 682.05,
   "end": 692.31,
   "text": "این‌ها باز به نسبت به صعه وجودی‌شون ظاهر و باطن رو در هم تنیده دیدن و از البته ظاه-- ظواهر شرعیه به باطن رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 692.31,
   "end": 696.61,
   "text": "حالا اینجا دیگه بستگی به ما دارد که این‌ها را درست ببینیم یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 696.61,
   "end": 700.09,
   "text": "به ما هم خیلی، ما هم خیلی چشممون مهمه که این‌ها رو چگونه ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 700.09,
   "end": 703.75,
   "text": "مثلاً امثال آقای بهجت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 703.75,
   "end": 710.97,
   "text": "خیلی ایشون وقتی زنده بود، خب به هر حال ایشون برای همه مسجل بود که عارف به الله‌اند و از جزو کمالین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 710.97,
   "end": 717.55,
   "text": "ایشون خیلی، من حتی دانشگاه مدتی که درس می‌دادم اونجا اکثر دانشجوها به همین اعتراض داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 717.55,
   "end": 719.17,
   "text": "تازه آقای بهجت زنده بود اون موقع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 719.17,
   "end": 721.65,
   "text": "می‌فهم-- می‌گفتن که آقا ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 721.65,
   "end": 729.77,
   "text": "چه عارفیه که مثلاً چه چشم باطن‌بینی دارد که از نظام مقدس جمهوری اسلامی‌ش دفاعی نداره، از رهبر دفاعی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 729.77,
   "end": 732.11,
   "text": "در حالی که بنده خودم با ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 732.11,
   "end": 734.33,
   "text": "قم اون مدتی که در را-- حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 734.33,
   "end": 737.61,
   "text": "درس می‌خوندیم قم بعضاً خدمتشون می‌رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 737.61,
   "end": 741.61,
   "text": "بارها تأکیدات ایشون رو نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 741.61,
   "end": 745.93,
   "text": "نظام مقدس و رهبر عزیزمون می‌دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 745.93,
   "end": 751.73,
   "text": "اتفاقاً وقتی از دنیا رفت دفتر ایشون اعلام کرد من با رئیس دفتر ایشون مرتبط بودم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 751.73,
   "end": 755.67,
   "text": "مرتبط شدم یعنی. اعلام کرد که بیشترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 755.67,
   "end": 760.79,
   "text": "تأییدات و بیشترین خدمات و بیشترین اعانات رو دفتر ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 760.79,
   "end": 762.85,
   "text": "در میان مراجع به انقلاب داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 762.85,
   "end": 765.87,
   "text": "نسبت به رهبر عزیزمون ارادت داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 765.87,
   "end": 769.99,
   "text": "اتفاقاً اواخر عمرشون البته رهبر زیاد به دیدن ایشون می‌رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 769.99,
   "end": 772.13,
   "text": "رهبر، رهبر عزیزمون هم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 772.13,
   "end": 779.09,
   "text": "حتی اواخر عمرشون رهبر رفته بودند دیدن ایشون سی و پنج دقیقه این دو بزرگوار روبه‌رو هم نشسته بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 779.09,
   "end": 785.73,
   "text": "به نحو اشراق از درون هم سیر می‌کردند بدون اینکه یه کلمه حرف بزنند فقط همدیگه رو می‌دیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 785.73,
   "end": 793.07,
   "text": "گفت حالا این تو بحث صرح مطلقه یا صراط مطلقی و اشراقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 793.07,
   "end": 797.35,
   "text": "گرفتن حقایق موجودات، سیر کردن در درون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 797.35,
   "end": 799.89,
   "text": "کلمات وجودی نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 799.89,
   "end": 802.03,
   "text": "بحث شده در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 802.03,
   "end": 807.07,
   "text": "شاگردان افلاطون که عده‌ای‌شون اشراقی بودند، عده‌ای رواقی بودند می‌رفتند تو اتاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 807.07,
   "end": 809.81,
   "text": "عده‌ای مشایی بودند تو راه ازشون استفاده می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 809.81,
   "end": 812.19,
   "text": "عده‌ای هم اشراقی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 812.19,
   "end": 815.97,
   "text": "صه، شاگردان صحری و سکوتی صرح مطلقی ایشون بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 815.97,
   "end": 817.81,
   "text": "صرح با ص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 817.81,
   "end": 820.53,
   "text": "سینی و سیبی با خ جیمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 820.53,
   "end": 823.41,
   "text": "یعنی رهایی. قید نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 823.41,
   "end": 827.33,
   "text": "بند نداشتن. سیر می‌کردند در درون افلاطون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 827.33,
   "end": 829.81,
   "text": "از ایشون بهره می‌جفت، می‌جستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 829.81,
   "end": 836.61,
   "text": "خب این دو بزرگوار هم به هم رسیدن به نحو اشراق از درون هم سی، سیر و سفر کردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 836.61,
   "end": 839.41,
   "text": "و بهره جستند و در انتهای اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 839.41,
   "end": 843.73,
   "text": "جلسه آقای بهجت جمله‌ای گفته بود که صلاح نمی‌دونم اینجا عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 843.73,
   "end": 849.97,
   "text": "در هر حال بسیاری از این کسانی که ما گمان می‌کنیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 849.97,
   "end": 854.93,
   "text": "مثلاً جمهوری اسلامی بی‌تفاوت بودند، تو مسائل اجتماعی ورود نمی‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 854.93,
   "end": 856.79,
   "text": "ما نمی‌دیدیم. ما توجه نداشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 856.79,
   "end": 859.65,
   "text": "ما بی‌خبر بودیم. اتفاقاً خیلی هم توجه داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 859.65,
   "end": 861.69,
   "text": "خیلی مراقب مسائل اجتماع بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 861.69,
   "end": 864.95,
   "text": "خیلی حتی مسئولی می‌رفتند به دیدنشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 864.95,
   "end": 867.49,
   "text": "پنهانی اینا تذکرات لازم رو می‌دادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 867.49,
   "end": 869.35,
   "text": "پنهانی جلسه می‌گذاشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 869.35,
   "end": 872.73,
   "text": "پنهانی نامه می‌فرستادند، تذکر می‌دادند و، و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 872.73,
   "end": 874.25,
   "text": "و. این‌ها هست ماها بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 874.25,
   "end": 876.55,
   "text": "در خصوص رهبر عزیزمون چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 876.55,
   "end": 879.67,
   "text": "دیده می‌شه، شنیده می‌شه. خیلی‌ها می‌گن چرا ایشون تذکر نمی‌ده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 879.67,
   "end": 883.81,
   "text": "چرا گوش‌ها رو نمی‌پیچونه؟ چرا فلان به صورتیکه بارها و بارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 883.81,
   "end": 885.93,
   "text": "برادرزاده‌ی ایشون ما باهاشون رفیقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 885.93,
   "end": 892.13,
   "text": "بارها و می‌فرمودن که مسئولین رو ایشون می‌خوان جلسات خصوصی دارن گوش می‌پیچونن، تذکر میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 892.13,
   "end": 895.73,
   "text": "اما خب نرود میخواہن این در سنگ ما چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 895.73,
   "end": 898.45,
   "text": "در هر حال این رو توجه داشته باشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 898.45,
   "end": 904.73,
   "text": "اینطوری نیست. از خ، اصلاً خود، جالبه که یکی از دانشجوها به من می‌گفت آقای بهجت یه بار هم رای نداده مثلاً به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 904.73,
   "end": 908.19,
   "text": "تو انتخابات شرکت نکرده در حالی که فیلم‌های ایشون پخش می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 908.19,
   "end": 911.23,
   "text": "تا این حد مردم بی‌خبر بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 911.23,
   "end": 913.89,
   "text": "خیلی از این عرفا هم آقای وحید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 913.89,
   "end": 918.85,
   "text": "ما حضرت استاد حداد که پای ده حوزه با ایشون محشور بودیم و یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 918.85,
   "end": 925.85,
   "text": "اسوانه‌های حوزه است و انشاالله برجستگان آینده نظام حوزوی و علم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 925.85,
   "end": 931.55,
   "text": "عمل و عرفان هست. ایشون از شاگردان دو دوره درس خارج آقای وحید بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 931.55,
   "end": 936.57,
   "text": "ازشون پرسیدیم که این میگن مثلاً ایشون با نظام مخالفت داره، با رهبری و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 936.57,
   "end": 942.67,
   "text": "مد، فرمودند مطلقا اتفاقاً به شدت اراده، ارادت مندر رهبری‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 942.67,
   "end": 944.79,
   "text": "و بارها دیدیم دعا می‌کنه در خصوصش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 944.79,
   "end": 947.49,
   "text": "منتها مثل خیلی‌ها تو بوق و کرنا نمی‌کنند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 947.49,
   "end": 950.13,
   "text": "این‌ها اهل باطن‌اند، اهل سکوت‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 950.13,
   "end": 955.39,
   "text": "اهل رمز و رازند. چون اهل رمز و راز و سکوت و باطنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 955.39,
   "end": 958.97,
   "text": "قرار نیست که به همه رمز و رموزاتشون ما پی ببریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 958.97,
   "end": 963.37,
   "text": "و دلایل همه کارهاشون رو ما بدونیم که و الا عارف نمی‌شدن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 963.37,
   "end": 971.59,
   "text": "و ما جاهل نمی‌شدیم که. لذا باید بدانیم که اون‌ها به همان میزانی که صِعë وجودی پیدا کردند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 971.59,
   "end": 977.93,
   "text": "وارد عالم غیب شدند، به همان میزان هم تسلط نسبت به عالم شهود دارند بلکه بالاتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 977.93,
   "end": 981.45,
   "text": "و دخالت دارند و محت، مطلقا روحانیت ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 981.45,
   "end": 985.75,
   "text": "مگر آن دسته‌ای که بله فاصله می‌گیرند هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 985.75,
   "end": 990.07,
   "text": "ولی خب این‌ها همون تعریفی که بنده حقیر عرض کردم صه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 990.07,
   "end": 994.39,
   "text": "صِعë وجودی ندارن. این‌ها ذیق هستند از نظر ما بزرگ‌اند",
