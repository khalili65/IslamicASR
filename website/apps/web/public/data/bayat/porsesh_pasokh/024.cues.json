 "chapters": [
  {
   "index": 0,
   "title": "بسم الله و بالله و علی ملّة رسول الله. المستغفر بک یا حجّة الله.",
   "start": 0.78,
   "end": 85.52
  },
  {
   "index": 1,
   "title": "## مزاج و تأثیراتِ ثانوی",
   "start": 85.52,
   "end": 221.48
  },
  {
   "index": 2,
   "title": "## نمازِ تربیتِ فرزند",
   "start": 221.48,
   "end": 300.2
  },
  {
   "index": 3,
   "title": "چهار رکعت دو تا دو رکعتی: در رکعتِ اوّل پس از حمد سوره نمی‌خوانید؛ پس از حمد ده مرتبه آیهٔ صد و بیست و هشتِ بقره:",
   "start": 300.2,
   "end": 373.51
  },
  {
   "index": 4,
   "title": "سلام می‌دهید. دو رکعتِ دوم: رکعتِ اوّل پس از حمد ده مرتبه آیهٔ هفتاد و چهارِ فرقان:",
   "start": 373.51,
   "end": 498.95
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.78,
   "end": 5.26,
   "text": "بسم الله و بالله و على ملة رسول الله المستغفر بك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.26,
   "end": 11.6,
   "text": "يا حجة الله. عزیزی پرسیده البته سؤال خیلیا بوده پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.6,
   "end": 17.08,
   "text": "عدم التزام عملیه فرزندان در خصوص واجباتشون مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.08,
   "end": 23.52,
   "text": "نماز و روزه و مقید بودن‌شون با آداب یا حجاب‌شون دخترهای عزیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.52,
   "end": 28.42,
   "text": "این‌ها بعضا گلایه‌هایی می‌شه در این خصوص که معمولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.42,
   "end": 31.9,
   "text": "میخوان از طریق ذکر و وردی چیزی این‌ها رو برطرف کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.9,
   "end": 35.72,
   "text": "ببینید عزیزان بهترین شیوه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.72,
   "end": 40.58,
   "text": "می‌تواند بچه‌های ما رو ملتزم کند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.58,
   "end": 44.72,
   "text": "دستورالعمل‌ها و آداب اسلامی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.72,
   "end": 52.54,
   "text": "زمینه‌سازی و بنیانسازی سبک زندگی اسلامی و اون هرم زندگی و چهارچوب‌هایی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.54,
   "end": 55.16,
   "text": "در زندگی ریخته می‌شه، حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.16,
   "end": 57.44,
   "text": "و آدابی که ریخته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.44,
   "end": 61.42,
   "text": "البته وضعیت خود پدر و مادر از حیث کم و کیف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.42,
   "end": 63.84,
   "text": "عبادتی‌شون و معنویت‌شون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.84,
   "end": 67.5,
   "text": "صدق گفتارشون، رفتارشون، اخلاق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.5,
   "end": 70.5,
   "text": "عرض شود رفتارشون با بچه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.5,
   "end": 74.12,
   "text": "و عدم تعارض بین پدر و مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.12,
   "end": 78.98,
   "text": "و انجام واجبات توسط خود پدر و مادر به موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.98,
   "end": 81.68,
   "text": "و باور یقینی داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.68,
   "end": 85.52,
   "text": "پدر و مادر در این‌ها، این‌ها همه بسیار مهم‌اند در تاثیرگذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.52,
   "end": 89.32,
   "text": "اما حالا کسی همه این‌ها رو رها کنه، این‌ها رو رعایت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.32,
   "end": 92.5,
   "text": "اما باز گرفتار بشه. این‌ها برمی‌گرده به تاثیرات ثانوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.5,
   "end": 94.9,
   "text": "البته به مزاج بچه هم خیلی برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.9,
   "end": 98.22,
   "text": "من حالا اینجا اجمال، اجمالاً صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.22,
   "end": 100.28,
   "text": "این سؤالات رو جواب میدیم. جاش اینجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.28,
   "end": 102.24,
   "text": "الا اینکه خیلی جای بحث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.24,
   "end": 107.74,
   "text": "مزاج بچه خیلی همون‌طور که قبلاً در بحث مژا، مزاج‌شناسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.74,
   "end": 116.64,
   "text": "در بحث قلب منزل بود یادمه چند جلسه صحبت کردیم مستقیماً از تلمذ حسن زاده تصریح می‌کنند که مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.64,
   "end": 120.06,
   "text": "در تهذیب نفس و اخلاق و این‌ها تاثیرگذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.06,
   "end": 123.3,
   "text": "در عبادات و این‌ها بسیار مستقیماً تاثیرگذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.3,
   "end": 128.9,
   "text": "لذا مزاج خیلی مهمه. بسیاری از بد رفتاری‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.9,
   "end": 132.0,
   "text": "واکنش‌های بد بچه‌های ما به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.0,
   "end": 134.52,
   "text": "نداشتن مزاج معتدله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.52,
   "end": 138.04,
   "text": "سبک تغذیه و خواب بده و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.04,
   "end": 143.2,
   "text": "حالا بعد میریم سراغ تاثیرات محیطی مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.2,
   "end": 148.16,
   "text": "اولین تاثیرات عجیبی که بچه‌ها دارن الان تأثر دارن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.16,
   "end": 152.22,
   "text": "فضای مجازی، فیلم‌ها، این چیزهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.22,
   "end": 155.26,
   "text": "می‌بینن متأسفانه در فضای مجازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.26,
   "end": 157.88,
   "text": "یا حتی متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.88,
   "end": 162.14,
   "text": "مع الأسف این بعضی نمایش‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.14,
   "end": 164.26,
   "text": "فیلم‌ها یا سریال‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.26,
   "end": 166.86,
   "text": "در حالا یا تلویزیون یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.86,
   "end": 172.16,
   "text": "فیلم‌های سینمایی اینا پخش می‌شه که ما خودمون از اصحاب رسانه‌ایم و به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.16,
   "end": 175.36,
   "text": "اینجا داد می‌زنیم اما کسی حرف ما به کسی نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.36,
   "end": 183.82,
   "text": "این‌ها به شدت تاثیرات غلط بر بچه‌ها دارن و یک ولنگری و این‌های مثلاً بی‌خیالی پنهانی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.82,
   "end": 187.06,
   "text": "القا می‌کنند به بچه‌ها که بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.06,
   "end": 190.58,
   "text": "مجموعاً وقتی این‌ها مراقبت شد یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.58,
   "end": 194.92,
   "text": "تاثیرات محیطی، هم‌نشین، فضای مجازی، رسانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.92,
   "end": 201.04,
   "text": "رفیق، فامیل این‌ها هم همسایه این‌ها هم مدیریت شد به یک نحو صحیحی باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.04,
   "end": 203.72,
   "text": "جوابی نگرفتیم. اون موقع حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.72,
   "end": 206.12,
   "text": "در کنار این‌ها بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.12,
   "end": 213.52,
   "text": "قطعاً نماز، ادعیه، اذکار این‌ها توسلات خیلی مهمن تاثیرگذارن از جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.52,
   "end": 217.18,
   "text": "نماز هدایت فرزند که خیلی مؤثر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.18,
   "end": 221.48,
   "text": "که من خودم به شخصه هر وقت که توفیق شد خوندم تاثیراتش رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.48,
   "end": 225.36,
   "text": "خدا رحمت کنه آقای بهجت رو ایشون سفارش دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.36,
   "end": 230.4,
   "text": "که یادش بخیر بارها عرض کردیم محضر دوستان در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.4,
   "end": 236.6,
   "text": "خدمت فرزند ایشون که حاج علی آقا در حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.6,
   "end": 241.18,
   "text": "آقامون علی ابن موسی الرضا علیهم الصلاة و السلام که بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.18,
   "end": 244.82,
   "text": "اونجا ایشون رو زیارت کردیم ازشون خواستیم یه هدیه از پدرشون به ما بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.82,
   "end": 250.14,
   "text": "ایشون به همین نماز تربیت فرزند اشاره کردن که پدرشون خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.14,
   "end": 252.98,
   "text": "توصیه داشتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.98,
   "end": 255.22,
   "text": "حتی به من گفتن یه عزیزی تو قم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.22,
   "end": 257.86,
   "text": "بچه‌های زیادی داشت همه ماشاءالله خوب شده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.86,
   "end": 261.2,
   "text": "همه تحصیل کرده و با ادب و معنوی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.2,
   "end": 266.86,
   "text": "پرسیده بودیم شما چه کردی؟ گفته بود هر بلایی سر ما اومده و بچه‌هامون به خاطر پدر شما بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.86,
   "end": 270.9,
   "text": "بعد تو-- گفتن از جوونی پدر شما ما رو توصیه به این نماز کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.9,
   "end": 276.3,
   "text": "البته این نماز سندش در کتاب مكارم الأخلاق هست که امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.3,
   "end": 282.46,
   "text": "صادق صلوات الله عليه تا اونجا که یادم هست توصیه کردن به این نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.46,
   "end": 284.3,
   "text": "یعنی معثور به اهل بیت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.3,
   "end": 287.06,
   "text": "اثر اهل بیت علیهم الصلاة و السلام هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.06,
   "end": 289.16,
   "text": "ولی خب آقای بهجت هم خیلی توصیه داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.16,
   "end": 292.56,
   "text": "چهار رکعته که حالا باز آقای بهجت توصیه می‌کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.56,
   "end": 297.62,
   "text": "به جای چهار رکعت نماز شب هم می‌شه این رو خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.62,
   "end": 300.2,
   "text": "که چهار رکعت دو تا دو رکعتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.2,
   "end": 302.9,
   "text": "در رکعت اول بعد از حمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.9,
   "end": 307.14,
   "text": "دیگه سوره نمی‌خونید. بعد از حمد ده مرتبه آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.14,
   "end": 318.36,
   "text": "صد و بیست و هشت سوره بقره رو می‌خونید که ده بار “ربنا واجعلنا مسلمین لك ومن ذریتنا أمة مسلمة لك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.36,
   "end": 323.78,
   "text": "وأرنا مناسكنا وتب علينا إنك أنت التواب الرحيم”.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.78,
   "end": 326.8,
   "text": "بعد رکعت دوم تو همون دو رکعت اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.8,
   "end": 332.62,
   "text": "رکعت دوم بعد از حمد ده مرتبه آیه چهل و چهل و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.62,
   "end": 335.66,
   "text": "سوره اسرا-- ابراهیم سلام الله عليه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.66,
   "end": 342.86,
   "text": "قرائت می‌فرمایید. “رب اجعلني مقيم الصلاة ومن ذريتي ربنا وتقبل دعاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.86,
   "end": 347.7,
   "text": "ربنا اغفر لي ولوالدي وللمؤمنين يوم يقوم الحساب”.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 347.7,
   "end": 352.5,
   "text": "حالا اینجا دو رکعت و سلام میدید تموم می‌شه دو رکعت دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.5,
   "end": 356.92,
   "text": "که مجموعاً می‌شه چهار رکعت. در دو رکعت دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.92,
   "end": 360.59,
   "text": "رکعت اول بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.59,
   "end": 365.35,
   "text": "هم ده مرتبه آیه هفتاد و چهار سوره فرقان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.35,
   "end": 374.65,
   "text": "قرائت می‌کنیم. \"ربنا هب لنا من ازواجنا و ذریاتنا قرة اعین و اجعلنا للمتقین اماما\" که این دعای ثابت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.65,
   "end": 378.87,
   "text": "قنوت‌های مولامون علی علیه الصلاة والسلام بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 378.87,
   "end": 381.39,
   "text": "و در رکعت چهارم هم بعد از surah",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.39,
   "end": 386.49,
   "text": "حمد ده مرتبه آیه پانزده سوره احقاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 386.49,
   "end": 395.53,
   "text": "\"رب اوذعني ان اشکر نعمتک التي انعمت علي و على والدي و ان اعمل صالحا ترضاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 395.53,
   "end": 401.55,
   "text": "و اصلح لي في ذريتي اني تبت اليك و اني من المسلمين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 401.55,
   "end": 404.45,
   "text": "بعد که نماز و سلام دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 404.45,
   "end": 408.87,
   "text": "ده مرتبه بعد از اتمام نماز ده مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 408.87,
   "end": 413.85,
   "text": "این آیه هفتاد و چهار سوره فرقان رو دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.85,
   "end": 422.55,
   "text": "قرائت می‌کنیم که \"ربنا هب لنا من ازواجنا و ذریاتنا قرة اعین و اجعلنا للمتقین اماما\" ده بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 422.55,
   "end": 426.15,
   "text": "البته بعضی از جاها من دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 426.15,
   "end": 430.21,
   "text": "نوشتن بعد از هر دو رکعت یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 430.21,
   "end": 436.43,
   "text": "این دستور آخر که ده بار این آیه هفتاد و چهار سوره فرقان رو باید بخونی بعد از نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 436.43,
   "end": 441.45,
   "text": "بعضی جاها دیدم که بعد از هر اتمام هر دو رکعت ده بار این آیه خونده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 441.45,
   "end": 446.49,
   "text": "بعضی جاها مثل همین کتاب بهجت الدعاء آقای بهجت اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 446.49,
   "end": 449.89,
   "text": "یه همون اتمام چهار رکعت بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 449.89,
   "end": 452.55,
   "text": "یعنی یک بار ده مرتبه خونده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 452.55,
   "end": 458.29,
   "text": "من توصیه می‌کنم که به اگر انشاالله توفیق شد و این نماز رو خوندین توجه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 458.29,
   "end": 467.77,
   "text": "معانی آیات، ترجمه آیات بکنین همون که داریم می‌خونیم چون جنبه دعایی دارن و بسیار هم با عظمتن این ادعیه قرآنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 467.77,
   "end": 472.01,
   "text": "ترجمه‌ش رو قبلاً ببینیم هر هی که نماز داریم می‌خونیم با توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 472.01,
   "end": 482.23,
   "text": "به درخواستمون این ادعیه قرآنی رو بر لسان جاری کنیم که انشاالله اثر مضاعفی داشته باشه و اثر جدی ازش ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 482.23,
   "end": 485.17,
   "text": "و مخصوصاً پدر فرمودن اگر انجام بده بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 485.17,
   "end": 489.69,
   "text": "آره چون سریه فرمودن که دعای پدر در حق فرزند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 489.69,
   "end": 492.31,
   "text": "مثل دعای پیغمبر در حق امتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 492.31,
   "end": 497.09,
   "text": "پدران غافل نباشند. انشاالله که موفق باشیم همگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 497.09,
   "end": 498.95,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}