   "start": 0.64,
   "end": 93.36
  },
  {
   "index": 1,
   "title": "## درجات بر اساس اعمال",
   "start": 93.36,
   "end": 181.9
  },
  {
   "index": 2,
   "title": "## نفس الهی و بدن عوالم",
   "start": 181.9,
   "end": 310.44
  },
  {
   "index": 3,
   "title": "## تجلی در قوس نزول و صعود",
   "start": 310.44,
   "end": 366.03
  },
  {
   "index": 4,
   "title": "## جسمانیة الحدوث نه روحانیة الحدوث",
   "start": 366.03,
   "end": 801.58
  },
  {
   "index": 5,
   "title": "## شرط عبودیت برای رسیدن به امام عصر",
   "start": 801.58,
   "end": 857.62
  },
  {
   "index": 6,
   "title": "## امتحنک الله قبل أن یخلقک",
   "start": 857.62,
   "end": 880.56
  },
  {
   "index": 7,
   "title": "## امتحان پیش از خلق",
   "start": 880.56,
   "end": 947.1
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 7.96,
   "text": "بسم الله و بالله و على ملة رسول الله المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.96,
   "end": 11.36,
   "text": "سوالی پرسیدن که رابطه بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.36,
   "end": 15.76,
   "text": "ذات حضرت حق و ذات حضرت زهرا سلام الله علیها چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.76,
   "end": 21.4,
   "text": "چون ما بعضی از روایات داریم که مرحوم مجلسی علیه الرحمه آوردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.4,
   "end": 23.98,
   "text": "خداوند مثلاً تکلمی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.98,
   "end": 27.88,
   "text": "ااا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.88,
   "end": 29.98,
   "text": "از تکلمش روح رو خلق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.98,
   "end": 32.7,
   "text": "تکلم دیگری کرد، نور رو خلق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.7,
   "end": 35.98,
   "text": "از امتزاج نور و روح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.98,
   "end": 43.08,
   "text": "ااا حقیقت محمدیه صلی الله علیه و آله و سلم یا پیامبر عظیم الشأن اسلام به یک معنا خلق شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.08,
   "end": 46.34,
   "text": "از انشقاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.34,
   "end": 48.42,
   "text": "این نور، نور مولا خلق شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.42,
   "end": 51.14,
   "text": "اینجا دو دسته روایت میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.14,
   "end": 55.4,
   "text": "از انشقاق همین نور، نور حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.4,
   "end": 59.74,
   "text": "که از منشق شدن نور حضرت زهرا، امام حسن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.74,
   "end": 63.66,
   "text": "از منشق شدن نور مولا علی، امام حسین خلق شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.66,
   "end": 65.54,
   "text": "یه روایت دیگه می‌فرماید نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.54,
   "end": 73.16,
   "text": "نور مولا علی از انشقاق نور پیغمبر بعد مستقیم از ذات حضرت حق دو مرتبه نور فاطمه زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.16,
   "end": 78.16,
   "text": "تجلی کرد. این رو یه توضیحی من بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.16,
   "end": 81.74,
   "text": "که این‌ها قابل جمع هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.74,
   "end": 84.3,
   "text": "ببینید عزیزان در آیه صد و سی و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.3,
   "end": 89.46,
   "text": "سوره انعام داریم که \"و لکل درجات mm مما عملوا و مرب کر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.46,
   "end": 92.64,
   "text": "بغافلن عما يعملون.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.64,
   "end": 96.06,
   "text": "می‌فرماید آنچه که شما عمل می‌کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.06,
   "end": 99.24,
   "text": "همون اعمال شما درجات شما رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.24,
   "end": 104.3,
   "text": "خلاصه‌اش این چنینه. یعنی آنچه که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.3,
   "end": 107.52,
   "text": "ااا رتبه دارید، درجه دارید یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.52,
   "end": 115.06,
   "text": "مقام دارید، مقام همون رتبه انسان یا به جای یک انسان قیام کرده یا قیامتش به پا شده که همین الان هم قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.06,
   "end": 118.06,
   "text": "ما قیام کرده، ما بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.06,
   "end": 122.52,
   "text": "همون رتبه وجودی ماست که اونجا استقرار داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.52,
   "end": 125.36,
   "text": "اون بر اساس اعمال ماست که درجه ما رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.36,
   "end": 129.22,
   "text": "حالا درجه‌ها، درجه‌ها خب تو قوس صعود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.22,
   "end": 132.56,
   "text": "درجه تعریف میشه دیگه. رتبه بندیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.56,
   "end": 135.02,
   "text": "ااا درجه هم بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.02,
   "end": 138.06,
   "text": "عروجه. یعنی شما اولش چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.06,
   "end": 140.86,
   "text": "معراج میری ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.86,
   "end": 143.08,
   "text": "اوج می‌گیری، صعود می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.08,
   "end": 144.64,
   "text": "هی درجه‌ات میره بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 144.64,
   "end": 150.78,
   "text": "رتبه ات میره بالاتر. این یه مقدمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.78,
   "end": 154.42,
   "text": "ااا که حالا این عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 154.42,
   "end": 159.44,
   "text": "درجات که بر اساس معارج هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.44,
   "end": 163.14,
   "text": "معارج هم میشه گفت همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.14,
   "end": 166.8,
   "text": "بر اساس اسماء و صفات حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 166.8,
   "end": 169.42,
   "text": "که هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 169.42,
   "end": 176.8,
   "text": "به هر میزان از اسماء الهی متلبس شده یا متصف به اوصاف الهی شده، همون مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.8,
   "end": 178.98,
   "text": "به معراج رفته و درجه گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.98,
   "end": 180.56,
   "text": "این مقدمه اولو داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 180.56,
   "end": 183.4,
   "text": "مقدمه دوم که حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 183.4,
   "end": 185.76,
   "text": "همه خب می‌دانیم اینو باور داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 185.76,
   "end": 189.8,
   "text": "لایتناهی‌اند. در مدت، در عدت، اینا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 189.8,
   "end": 194.18,
   "text": "لایتناهی‌اند. به یک معنا لا یدرک و لا یوصف‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 194.18,
   "end": 197.24,
   "text": "نه درک میشه ذات حضرت حق اون لا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 197.24,
   "end": 201.22,
   "text": "ذات لایتناهیشون و غیب الغیوبشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 201.22,
   "end": 204.36,
   "text": "واجب الوجود، وجودشون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 204.36,
   "end": 207.22,
   "text": "ااا به یک معنا قابل وصف هم نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 207.22,
   "end": 211.58,
   "text": "حالا بعضیا میگن که نه، ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 211.58,
   "end": 213.98,
   "text": "درک میشن اما وصف نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 213.98,
   "end": 219.34,
   "text": "حالا اینو کاری نداریم. اما خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 219.34,
   "end": 225.02,
   "text": "ااا که لایتناهی‌ست و ذاتی دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 225.02,
   "end": 228.16,
   "text": "nefsi دارد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 228.16,
   "end": 233.08,
   "text": "همه عوالم هستی که اگر خدای منان نفس دارد ح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 233.08,
   "end": 235.32,
   "text": "در حقیقت بدن هم باید داشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 235.32,
   "end": 241.06,
   "text": "همه عوالم هستی یعنی خلائق به منزله بدن میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 241.06,
   "end": 243.16,
   "text": "توجه داشته باشید به کلمات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 243.16,
   "end": 246.46,
   "text": "مثل ما از این جهت میگیم نفس داریم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 246.46,
   "end": 250.38,
   "text": "ذات ما تعلق خاطر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 250.38,
   "end": 253.68,
   "text": "ااا بدن ما داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 253.68,
   "end": 256.7,
   "text": "چون می‌خواد بدن ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 256.7,
   "end": 261.56,
   "text": "ارتقا بده و بدن رو هم با خودش بالا بکشه، تعلق داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 261.56,
   "end": 263.12,
   "text": "تدبیر می‌کنه این بدن رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 263.12,
   "end": 269.86,
   "text": "بهش میگن نفس. خدا هم نفس داره چون تعلق به مادون داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 269.86,
   "end": 276.36,
   "text": "و البته تعلق خدا به مادون نه از رو احتیاجه بلکه از رو هبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.36,
   "end": 279.94,
   "text": "اما نفس ناطقه ما تعلقش به بدن از روی احتیاجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.94,
   "end": 288.82,
   "text": "خدا از رو هبه. این تعلقی که خدا داره به خلائق برای اینکه این‌ها رو بالا بکشونه، از این جهت میگن خدا نفس داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.82,
   "end": 293.7,
   "text": "وقتی نفس داره پس لاجرم باید بدن هم داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.7,
   "end": 301.24,
   "text": "لذا حکما میگن عوالم هستی که خودش باز لایتناهی‌ست به منزله بدن بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 301.24,
   "end": 305.56,
   "text": "به این شکل. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.56,
   "end": 309.08,
   "text": "پس اگر خدا لایتناهی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.08,
   "end": 312.14,
   "text": "بالاخره خدا باید تجلی داشته باشه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 312.14,
   "end": 315.66,
   "text": "ذات حضرت حق باید تجلی داشته باشه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.66,
   "end": 319.12,
   "text": "اگر خدا تجلی نداشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.12,
   "end": 326.2,
   "text": "یعنی به یک معنا میشه گفت ظهور نداشته باشه، یکی از اسماء خدا معطل میشه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.2,
   "end": 327.86,
   "text": "کدوم اسم؟ اسم ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 327.86,
   "end": 334.96,
   "text": "در حالی که آیه سه سوره حدید می‌فرماید \"هو الاول والآخر والظاهر والباطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.96,
   "end": 337.74,
   "text": "وهو بكل شيء عليم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.74,
   "end": 340.28,
   "text": "نمیشه ظاهر باشد باطن نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 340.28,
   "end": 343.74,
   "text": "نمیشه باطن باشد ظاهر نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.74,
   "end": 348.14,
   "text": "ظاهر همون باطن است، باطن همون ظاهر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.14,
   "end": 352.42,
   "text": "مثل اینکه اول همون آخر است و آخر همون اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.42,
   "end": 355.9,
   "text": "پس عزیزان متوجه میشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.9,
   "end": 358.7,
   "text": "وقتی خدا رو باطن بگیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.7,
   "end": 361.06,
   "text": "ذات لایتناهی بگیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 361.06,
   "end": 365.25,
   "text": "همون باطن باید تجلی کنه که ظاهر هم باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.25,
   "end": 369.35,
   "text": "که اگر غیر از این باشه نقص پیش میاد و اسم خدا معطل می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.35,
   "end": 373.13,
   "text": "پس خدا ظهور کرده به یک معنا تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.13,
   "end": 376.43,
   "text": "حالا تجلی خدا به دو گونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 376.43,
   "end": 380.91,
   "text": "این تا اینجا مقدمه دوم. مقدمه سوماً تجلی خدا به دو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.91,
   "end": 386.51,
   "text": "دو گونه‌ست رو داشته باشید. تجلی خدا یا در قوس نزوله یا صعود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.51,
   "end": 392.59,
   "text": "قوس نزول همه همه‌ هستی که همون اسماء و صفات الهیه‌اند تنزل پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.59,
   "end": 397.39,
   "text": "از صادر اول بگید تا بیست و هشت دسته خلائق که یکیش ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.39,
   "end": 400.33,
   "text": "هر چیزی که در حیطه‌ی خل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.33,
   "end": 404.63,
   "text": "خلق و خلائق قرار گرفته و سایه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.63,
   "end": 407.85,
   "text": "به جز البته صادر اول که اون دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 407.85,
   "end": 410.71,
   "text": "خلق حساب نمی‌شه و سایه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.71,
   "end": 414.75,
   "text": "صورت الرحمن است. در قوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.75,
   "end": 420.55,
   "text": "صعود ، دیگه حالا انا لله قوس نزول و انا الیه راجعون قوس صعود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.55,
   "end": 426.09,
   "text": "در قوس صعود هرکس به اراده خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 426.09,
   "end": 430.03,
   "text": "به هر میزانی که برمی‌گردیم این مقدمه الان ال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 430.03,
   "end": 432.55,
   "text": "سنجاق می‌شه به مقدمه اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.55,
   "end": 435.65,
   "text": "دیگه بحث براتون تسهیل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.65,
   "end": 445.45,
   "text": "در قوس صعود هرکس به هر میزانی که متلبس به اسماء الهی شد یعنی اسماء خدا رو در خودش پیاده کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 445.45,
   "end": 449.77,
   "text": "و متصف به صفات الهی شد به همون میزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.77,
   "end": 455.53,
   "text": "می‌شه مظهر. مظهر نه اینکه این آقا، این شخص، این انسان، این شیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.53,
   "end": 459.59,
   "text": "یه چیزی بوده از قبل که حالا خدا درش ظهور کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.59,
   "end": 464.71,
   "text": "نه. اصلاً عین بودنش، عینیتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.71,
   "end": 467.55,
   "text": "می‌شود عینا ظهور خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.55,
   "end": 470.73,
   "text": "یعنی خدا ظهور کرده شده این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.73,
   "end": 475.65,
   "text": "اینو حواسمون باشه. خب در قوس صعود انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.65,
   "end": 479.61,
   "text": "اراده داره. یکی از اسامی حضرت حق هم مریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 479.61,
   "end": 484.79,
   "text": "اراده. انسان هم اراده داره که اختیار داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.79,
   "end": 492.07,
   "text": "یا اسماء جلالیه خدا رو یا اسماء فعلیه خدا رو متلبس بشه یا اسماء ذاتیه خدا رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 492.07,
   "end": 498.49,
   "text": "اسماء جلا، جمالیه خدا رو که به یک معنا بهشتی بشه یا جهنمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.49,
   "end": 502.05,
   "text": "وقتی کسی تما-- به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 502.05,
   "end": 507.09,
   "text": "در حقیقت در قوس صعود به جایی رسید که توانست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 507.09,
   "end": 514.31,
   "text": "به اراده خودش تمام اسماء خدا رو به شدت و حدت یعنی به تام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.31,
   "end": 519.33,
   "text": "به نحو اتم و اکمل در خودش پیاده کنه، می‌شه مظهر تام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 519.33,
   "end": 524.99,
   "text": "در حقیقت خدا در چنین وجودی و موجودی تجلی تام کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.99,
   "end": 528.57,
   "text": "اصطلاحاً تجلی اعظم کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 528.57,
   "end": 531.75,
   "text": "خب در قوس صعود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 531.75,
   "end": 538.05,
   "text": "ما معتقدیم که حضرت صدیقه طاهره سلام الله علیها نه فقط خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 538.05,
   "end": 543.15,
   "text": "مظهر تام همه اسماء و صفات شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 543.15,
   "end": 547.43,
   "text": "، که به یک معنا بهشت شده تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 547.43,
   "end": 553.29,
   "text": "جمال ایشون و جهنم شده تجلی جلال ایشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 553.29,
   "end": 556.67,
   "text": "بلکه شده ظرف نوریه آل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 556.67,
   "end": 562.17,
   "text": "یعنی فرزندان ایشون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 562.17,
   "end": 569.39,
   "text": "در حقیقت مظروف‌شون، اون ظرفی که نور این‌ها درش قرار گرفته حضرت صدیقه طاهره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 569.39,
   "end": 576.69,
   "text": "در، تا جایی که در قرآن مشکات یعنی چراغدان رو ایشون یاد می‌کنه بر اساس تفاسیر آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 576.69,
   "end": 581.27,
   "text": "که مثل نوره کمشکات الله نور السماوات والارض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 581.27,
   "end": 584.73,
   "text": "مثل نوره کمشکات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 584.73,
   "end": 587.51,
   "text": "این چراغدان. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 587.51,
   "end": 590.91,
   "text": "ظرف نوریه بقیه هم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 590.91,
   "end": 594.95,
   "text": "این در حقیقت به نحوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 594.95,
   "end": 599.35,
   "text": "متجلی‌ست یعنی تجلی تام خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 599.35,
   "end": 603.67,
   "text": "که کأنّ ذات حضرت حق با تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 603.67,
   "end": 607.81,
   "text": "اسماء و صفاتش در ایشون تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 607.81,
   "end": 611.51,
   "text": "این رابطه‌ی ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 611.51,
   "end": 614.33,
   "text": "و ذات حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 614.33,
   "end": 618.65,
   "text": "که اگر به غیر از این کسی چیزی بگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 618.65,
   "end": 620.87,
   "text": "اون موقع میره در دایره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 620.87,
   "end": 624.83,
   "text": "روحانیت الحدوث بودن، نه جسمانیت الحدوث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 624.83,
   "end": 630.83,
   "text": "ما بر اساس نظرات علامه حسن زاده آملی که در طول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 630.83,
   "end": 636.07,
   "text": "، از اساتیدشون اجازه روایت که دارن در طول ملا صدرا هستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 636.07,
   "end": 639.83,
   "text": "ایشون هم قائل به جسمانیت الحدوث بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 639.83,
   "end": 641.63,
   "text": "ما این رو داریم بحث می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 641.63,
   "end": 647.61,
   "text": "و الا خب اون‌هایی که مثل اوایل نظرات شیخ الرئیس که بعداً نظر ایشون هم عوض می‌شه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 647.61,
   "end": 651.89,
   "text": "روحانیت الحدوث، جسمانیت الحدوث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 651.89,
   "end": 659.61,
   "text": "بیان می‌کنند. حالا اگر بپذیریم شیخ الرئیس ابتدا قائل به روحانیت الحدوث بودن، اون بحثش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 659.61,
   "end": 663.67,
   "text": "که یعنی اصلاً هیچکس نبوده و مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 663.67,
   "end": 666.99,
   "text": "حضرت زهرا سلام الله علیها بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 666.99,
   "end": 669.51,
   "text": "که یا پیغمبر، پیغمبر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 669.51,
   "end": 673.13,
   "text": "این‌ها در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 673.13,
   "end": 678.15,
   "text": "باید تأویل بشن. یعنی باید از این ظاهر عبارت عبور کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 678.15,
   "end": 686.07,
   "text": "مثل همین روایت که ما الان از ظاهرش عبور کردیم به باطنش رسیدیم تا حدی، در حد وسع خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 686.07,
   "end": 691.37,
   "text": "که اینکه حضرت زهرا سلام الله علیها از ذ، نور ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 691.37,
   "end": 693.35,
   "text": "خلق شده یعنی چی؟ یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 693.35,
   "end": 695.61,
   "text": "این هم توضیحی که دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 695.61,
   "end": 700.25,
   "text": "نه اینکه قبل از اینکه اصلاً عالمی خلق بشود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 700.25,
   "end": 705.39,
   "text": "نور حضرت زهرا سلام الله علیها یا نور پیغمبر یا اصلاً اون‌ها خلق شده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 705.39,
   "end": 711.81,
   "text": "اگر اینطوری باشد یعنی بگیم روحانیت الحدوث یعنی اول روح بوده بعد جسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 711.81,
   "end": 717.47,
   "text": "حادث شده. اینطوری باشه خب همه صداشون در میاد میگن خدا عادل نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 717.47,
   "end": 719.99,
   "text": "ایشون از اول پیغمبر خلق کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 719.99,
   "end": 725.25,
   "text": "حضرت زهرا رو از اول مادر امامان و ظرف نوریه قرار داده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 725.25,
   "end": 729.11,
   "text": "جعل کرده بود. چرا منو پیغمبر نیافرید و خلق نکرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 729.11,
   "end": 732.12,
   "text": "ببینید دیگه اینو میخوای چگونه شما جواب بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 732.12,
   "end": 736.22,
   "text": "در حالی که اینا از ظاهر عبارات باید عبور کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 736.22,
   "end": 741.12,
   "text": "و به نظر ملاصدرا که جسمانیة الحدوث یعنی نفس ناطقه در قوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 741.12,
   "end": 746.78,
   "text": "صعود در إنا الله راجعون در نشئ بعد همین طبیعت یعنی بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 746.78,
   "end": 749.64,
   "text": "تشکیل نطفه، در همین نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 749.64,
   "end": 751.86,
   "text": "با همین خاک و آب و گل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 751.86,
   "end": 758.6,
   "text": "اینها در همین طبیعت فعلی و دنیا همین جا صعود کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 758.6,
   "end": 762.24,
   "text": "و به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 762.24,
   "end": 765.62,
   "text": "صادر اول، عقل کلی و عقل اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 765.62,
   "end": 770.0,
   "text": "رسیدن. یا حقیقت محمدیه صلی الله علیه و سلم رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 770.0,
   "end": 772.46,
   "text": "که حالا حضرت زهرا به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 772.46,
   "end": 776.06,
   "text": "نفس کلیه الهیه میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 776.06,
   "end": 778.4,
   "text": "امیرالمؤمنین صلی الله علیه به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 778.4,
   "end": 781.4,
   "text": "عقل کل میرسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 781.4,
   "end": 786.04,
   "text": "اتحاد وجودی با صادر اول برقرار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 786.04,
   "end": 788.6,
   "text": "و این یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 788.6,
   "end": 792.24,
   "text": "در حقیقت شمای کلی از رابطه‌ی بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 792.24,
   "end": 794.68,
   "text": "ذات حضرت حق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 794.68,
   "end": 800.94,
   "text": "ذات حضرت صدیقه کبری سلام الله علیها که هرچی که هست رو توجه داشته باشیم در قوس صعود اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 800.94,
   "end": 804.22,
   "text": "خدا رحمت کنه به روح آیت الله العظمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 804.22,
   "end": 809.58,
   "text": "المأسس محمد حسین حسینی تهرانی که خیلی ما از برکات ایشون بهره بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 809.58,
   "end": 814.98,
   "text": "ایشون می‌فرمودند عده‌ای هستن که به دنبال امام عصرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 814.98,
   "end": 819.4,
   "text": "ایشون رو دوست دارن اما هرگز به حضرت نمی‌رسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 819.4,
   "end": 821.94,
   "text": "اه و عاقبت خوبی هم ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 821.94,
   "end": 827.92,
   "text": "مضمون صحبت ایشون اینه. بعد چرایی‌ش رو می‌فرمایند به جهت اینکه اینها گمان می‌کنند امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 827.92,
   "end": 830.8,
   "text": "از ابتدا امام عصر نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 830.8,
   "end": 832.96,
   "text": "عبودیت رو شرط نمی‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 832.96,
   "end": 836.28,
   "text": "نمیگن که با امام عصر تو همین نشأت طبیعت اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 836.28,
   "end": 840.18,
   "text": "با هم پدر داشتن پدر، مادر، خوردن آب و نان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 840.18,
   "end": 843.52,
   "text": "تو همین خاک و همین آب و همین جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 843.52,
   "end": 850.46,
   "text": "با همه‌ی مشکلات و مصائب و سختی‌ها تو قوس صعود، نه نزول، تو قوس صعود بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 850.46,
   "end": 853.3,
   "text": "شدت عبودیتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 853.3,
   "end": 857.42,
   "text": "به ولایت رسید که این راه به روی اهدی بسته نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 857.42,
   "end": 862.92,
   "text": "شما در تشهد هم میگید و اشهد ان محمدا عبده و رسوله از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 862.92,
   "end": 867.28,
   "text": "عبد به رسالت از عبودیت به رسالت رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 867.28,
   "end": 868.9,
   "text": "صلی الله علیه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 868.9,
   "end": 871.64,
   "text": "پس اینو حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 871.64,
   "end": 874.1,
   "text": "البته اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 874.1,
   "end": 876.0,
   "text": "شاید بعضیا بگن پس چطور در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 876.0,
   "end": 880.02,
   "text": "سلام به حضرت صدیقه طاهره سلام الله علیها داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 880.02,
   "end": 882.66,
   "text": "که مثلاً السلام علیک یا ممتحنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 882.66,
   "end": 884.78,
   "text": "ای کسی که امتحان پس دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 884.78,
   "end": 886.94,
   "text": "امتحنک الله الذي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 886.94,
   "end": 890.76,
   "text": "قبل ان يخلقک. اگه عبارتشو اشتباه نگفته باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 890.76,
   "end": 895.64,
   "text": "در مفاتیح هست رجوع کنید که قبل اینکه خلق بشی امتحان پس دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 895.64,
   "end": 900.54,
   "text": "این چگونه است؟ قبل خلقت امتحان پس دادن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 900.54,
   "end": 902.64,
   "text": "یعنی پس خانم قبلاً بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 902.64,
   "end": 907.1,
   "text": "یا حدیثی که میگه مثلاً چند هزار سال قبل خلقت هر چیزی اونها بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 907.1,
   "end": 909.48,
   "text": "میگیم در علم الهی بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 909.48,
   "end": 914.88,
   "text": "در علم الهی بوده که چه کسی در قوس صعود نمرش بیست میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 914.88,
   "end": 918.02,
   "text": "لذا در میان همه‌ی خلائق اینا رو خدا منتخب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 918.02,
   "end": 921.3,
   "text": "انتخاب کرد. خ-خدا خبر داشت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 921.3,
   "end": 923.98,
   "text": "خدا میدونست که کی نمرش بیسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 923.98,
   "end": 928.44,
   "text": "لذا از همون اول هوای این نمره بیست‌ها رو داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 928.44,
   "end": 929.96,
   "text": "خودش دیگه حواسش به اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 929.96,
   "end": 938.66,
   "text": "بود چون قراره اینها زعیم بشن، امام بشن، ولایتدار بشن، جلودار باشن، بقیه پشت سر اینا حرکت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 938.66,
   "end": 942.0,
   "text": "ان شا الله که خدای منّان ما رو آگاه به حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 942.0,
   "end": 947.1,
   "text": "و توفیق عمل خالصانه به اونها رو عطا کنه. والحمد لله رب العالمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}