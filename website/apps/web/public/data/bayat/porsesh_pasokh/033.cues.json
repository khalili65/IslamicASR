  {
   "index": 5,
   "title": "## عمل و فاصله از گناه",
   "start": 968.55,
   "end": 1020.05
  },
  {
   "index": 6,
   "title": "## جمع پاسخ به پرسش‌ها",
   "start": 1020.05,
   "end": 1069.59
  },
  {
   "index": 7,
   "title": "## ختم بحث پرسش و پاسخ",
   "start": 1069.59,
   "end": 1120.63
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.68,
   "end": 5.62,
   "text": "اما در رابطه با اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.62,
   "end": 11.98,
   "text": "سؤال کردن که ما نورهای متعددی رو بعضاً نور سبز، آبی، اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.98,
   "end": 15.26,
   "text": "سفید روی دیوار این‌ها رو می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.26,
   "end": 20.1,
   "text": "و با اون‌ها ارتباط می‌گیریم. بعضی موقع‌ها حرف ما رو گوش می‌دن این انواع این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.1,
   "end": 26.14,
   "text": "به چه شکل‌اند؟ به چه شکل-- آقا میشه این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.14,
   "end": 29.84,
   "text": "حق یا باطل دانست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.84,
   "end": 33.68,
   "text": "به چه صورت این‌ها میشه بهشون اطمینان کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.68,
   "end": 36.18,
   "text": "یا حق است اصلاً این دیدن‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.18,
   "end": 38.82,
   "text": "اصلاً این‌ها مکاشفه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.82,
   "end": 42.82,
   "text": "یا مثلاً اینکه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.82,
   "end": 45.26,
   "text": "عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.26,
   "end": 49.28,
   "text": "گفتن گاهی اوقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.28,
   "end": 53.46,
   "text": "روضه‌ها رو چنان تجسم می‌کنیم که از خود بی‌خود می‌شیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.46,
   "end": 56.88,
   "text": "دستمون خشک میشه، وجودمون خشک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.88,
   "end": 60.1,
   "text": "این حالات حقه؟ یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.1,
   "end": 67.54,
   "text": "پرسیدن که یکی دو بار شده که از منزل بیرون رفتیم کلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.54,
   "end": 72.62,
   "text": "از این دنیا فارغ شدیم، فراموش کردیم که کجا هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.62,
   "end": 75.36,
   "text": "یا یه سؤال کلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.36,
   "end": 78.68,
   "text": "موانع وجودیمون رو از کجا بشناسیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.68,
   "end": 83.26,
   "text": "برای رسیدن به انسان کامل موانع وجودی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.26,
   "end": 86.86,
   "text": "و گاهی اوقات یه کاری رو خوب می‌دونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.86,
   "end": 91.8,
   "text": "اما نمی‌دونیم واقعاً این خوب هست، بده، چی، به چه شکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.8,
   "end": 95.42,
   "text": "حالا راه تشخیص، تمیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.42,
   "end": 98.02,
   "text": "این چی هست؟ اولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.02,
   "end": 101.36,
   "text": "قرآن فرمود \"إن تتقوا الله يجعل لكم فرقان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.36,
   "end": 104.02,
   "text": "فرقان اینجا به معنای تمیز حق از باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.02,
   "end": 110.26,
   "text": "اگر تقوا پیشه کنید، می‌تونید تمیز بدید، تشخیص بدید راه حق از باطل رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.26,
   "end": 115.98,
   "text": "این یک نکته. نکته دیگه اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.98,
   "end": 120.18,
   "text": "ببینید ما به جهت اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.18,
   "end": 124.5,
   "text": "در درون خودمون اصلاً به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.5,
   "end": 127.52,
   "text": "حرکت هبی حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.52,
   "end": 130.56,
   "text": "ایجاد شدیم، ایجاد شدیم، إنشاء شدیم، حب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.56,
   "end": 132.8,
   "text": "و عشق حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.8,
   "end": 134.9,
   "text": "ذاتاً بر فطرت ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.9,
   "end": 138.32,
   "text": "\"فطرت الله التي فطر الناس عليها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.32,
   "end": 146.18,
   "text": "اون فطرت الهی چون ما از الوهیت نظام هستی \"امن شيء إلا عندنا خزائنه ومن أنزلته إلا بقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.18,
   "end": 149.0,
   "text": "معلوم\" تنزل پیدا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.0,
   "end": 156.3,
   "text": "لذا اصلاً از درون خودمون در مکمن غیبمون از اون سرّ السرّ مون ارتباط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.3,
   "end": 160.52,
   "text": "از جدول وجودیمون، از رب وجودیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.52,
   "end": 165.46,
   "text": "ارتباط داریم لاجرم با رب مطلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.46,
   "end": 169.28,
   "text": "و این همون در حقیقت هبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.28,
   "end": 172.34,
   "text": "اون حالیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.34,
   "end": 179.58,
   "text": "البته اکملش میشه احسن حال که حال صادر اول و پیغمبر عزیز عالمه که ما در این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.58,
   "end": 183.14,
   "text": "در این سیر قرار داریم که به اونجا برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.14,
   "end": 186.46,
   "text": "او رفته رسیده دست دراز کرده میگه دستتو به من بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.46,
   "end": 190.46,
   "text": "یلم الناصر یعنی این دستتو به من بده تا برسونمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.46,
   "end": 193.98,
   "text": "پس این حب و این عشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.98,
   "end": 197.18,
   "text": "در درون ما هست. حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.18,
   "end": 200.94,
   "text": "حب و عشق وقتی پایداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.94,
   "end": 204.4,
   "text": "و وقتی بوی الهی میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.4,
   "end": 208.24,
   "text": "و سرریز به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.24,
   "end": 211.16,
   "text": "دنیا نمیشه، یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.16,
   "end": 216.18,
   "text": "منتهی نمیشه به حب دنیوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.18,
   "end": 222.1,
   "text": "علاقه به مثلاً ثروت و قدرت و زن و بچه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.1,
   "end": 224.26,
   "text": "پست و مقام و این چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.26,
   "end": 227.3,
   "text": "یعنی منحرف نمیشه که همراه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.3,
   "end": 229.92,
   "text": "چی باشه؟ معرفت همراه با علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.92,
   "end": 233.48,
   "text": "قرآن می‌فرماید \"والذین أوتوا العلم درجات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.48,
   "end": 238.5,
   "text": "اصلاً اون‌هایی که بهشون علم عطا میشه، داده میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.5,
   "end": 242.86,
   "text": "درجات دارن. \"تلك الرسل فضلنا بعضهم على بعض\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.86,
   "end": 247.26,
   "text": "رسولان ما هم بر همدیگه برتری دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.26,
   "end": 249.94,
   "text": "همه یک درجه و یک مقام ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.94,
   "end": 253.14,
   "text": "اما به قول علامه سنزدی الله رحمته از همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.14,
   "end": 260.42,
   "text": "آیه \"والذین أوتوا العلم درجات\" میشه تشخیص داد که اصلاً درجات هم بر اساس علومه، علمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.42,
   "end": 265.88,
   "text": "بر پایه‌ی علمه، بر اساس معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.88,
   "end": 274.22,
   "text": "ببینید در سوره عصر آخرش میگیم \"وتواصوا بالصبر و تواصوا بالحق وتواصوا بالصبر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.22,
   "end": 277.06,
   "text": "اول تواصی به، توصیه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.06,
   "end": 282.0,
   "text": "حقه، بعد توصیه به صبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.0,
   "end": 284.06,
   "text": "توصیه به حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.06,
   "end": 289.16,
   "text": "میشه همون تواصی به علم و معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.16,
   "end": 292.96,
   "text": "توصیه به شناخت، به معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.96,
   "end": 302.1,
   "text": "که اون سیر هبی میاره یا حب رو پایدار می‌کنه، تقویت می‌کنه، نظام‌مند می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.1,
   "end": 308.12,
   "text": "بعد تواصوا بالصبر. صبر دیگه حوزه عمله، عملیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 308.12,
   "end": 311.54,
   "text": "که بندگی انسان بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 311.54,
   "end": 314.9,
   "text": "صبر باید پایدار باشه که باز بسترش میشه حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 314.9,
   "end": 316.8,
   "text": "یعنی حوزه نظر، حوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.8,
   "end": 319.22,
   "text": "فکر، حوزه اندیشه، حوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 319.22,
   "end": 322.48,
   "text": "ایمان به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 322.48,
   "end": 324.08,
   "text": "خب این‌ها رو عرض کردیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.08,
   "end": 328.7,
   "text": "یعنی بر اساس باز اون روایت شریفی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.7,
   "end": 331.78,
   "text": "معروف هست و امیر بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.78,
   "end": 337.04,
   "text": "حضرت امیر المؤمنین صلوات الله علیه فرمودن و مرحوم ملا محسن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.04,
   "end": 339.9,
   "text": "انتهای اون ک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.9,
   "end": 346.16,
   "text": "بحث اون کلمه‌ای که شب‌های جمعه پیرامون لقاء الله داریم عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.16,
   "end": 353.82,
   "text": "کلم-کلمات مکنونه، اون کلمه‌ای که پیرامون لقاء الله انتهاش می‌فرماید که البته هنوز بهش نرسیدیم، به این تیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 353.82,
   "end": 359.1,
   "text": "می‌فرماید \"المعرفة بذر المشاهده\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 359.1,
   "end": 361.6,
   "text": "بذر مشاهده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.6,
   "end": 364.84,
   "text": "معرفت یعنی اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.84,
   "end": 368.64,
   "text": "شهودی رخ میده باید بر اساس معرفت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.64,
   "end": 371.84,
   "text": "اگر بر اساس معرفت نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.84,
   "end": 375.62,
   "text": "شهود به اون معنا نیست؛ یعنی حق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.62,
   "end": 380.42,
   "text": "که اگر معرفت نباشه، اگر علم نباشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.42,
   "end": 383.64,
   "text": "درجه‌ای هم نیست، انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.64,
   "end": 386.42,
   "text": "به مرور از مسیر حب خارج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.42,
   "end": 389.4,
   "text": "حبش منحرف میشه به سمت دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.4,
   "end": 393.6,
   "text": "از حق به سمت باطل گرایش پیدا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.6,
   "end": 397.4,
   "text": "خب خلاصه اینکه یه جمع‌بندی بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 397.4,
   "end": 402.3,
   "text": "این دیدن انوار، این حالات عجیب و غریب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.3,
   "end": 405.22,
   "text": "این تمثلات، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.22,
   "end": 408.74,
   "text": "کشفیات، این ادراکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.74,
   "end": 412.66,
   "text": "از پیرامون در درون، این‌ها همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.66,
   "end": 417.42,
   "text": "و همه که حالا به یک معنا میشه شوق، حب، ذوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 417.42,
   "end": 423.24,
   "text": "این‌ها همه البته اگر ذوق رو به معنای ادناش بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.24,
   "end": 426.64,
   "text": "یعنی به مثلاً حب بگیریم و الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.64,
   "end": 429.66,
   "text": "صاحبان ذوق رو عرفا گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 429.66,
   "end": 432.6,
   "text": "یعنی عارف که صاحب ذوقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 432.6,
   "end": 435.64,
   "text": "چشیده، رسیده، واصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 435.64,
   "end": 437.76,
   "text": "اون هم باز میشه طریق معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 437.76,
   "end": 443.28,
   "text": "به هر حال اگر بر اساس معرفت بود، اگر بر اساس علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.28,
   "end": 446.76,
   "text": "و عقل بود این درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.76,
   "end": 451.38,
   "text": "این صحیحه. که از پوسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.38,
   "end": 456.82,
   "text": "ظاهری که ادنا مرتبه است و مرتبه ظاهره از شریعت شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.82,
   "end": 464.08,
   "text": "اوامر و نواهی. تا کشیده میشه به اون بالاترها که کشفیاته، تمثلاته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 464.08,
   "end": 466.66,
   "text": "تمثلات نوعیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.66,
   "end": 472.9,
   "text": "در بیداری حتی. حالا این‌ها همش بر اساس معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 472.9,
   "end": 477.12,
   "text": "معرفتی که حالا فرق علم و معرفت هم قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 477.12,
   "end": 480.16,
   "text": "علم مسبوق به سابقه نیست به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 480.16,
   "end": 488.08,
   "text": "ابتدا یاد می‌گیری. معرفت از پیش باز در وجود تو تعبیه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 488.08,
   "end": 492.28,
   "text": "در ليلة القدر عالم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 492.28,
   "end": 496.84,
   "text": "وجود تو یک رشحه ای و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.84,
   "end": 502.58,
   "text": "در حقیقت قсре‌ای از اون رو گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 502.58,
   "end": 505.1,
   "text": "نهادینه شده. در فسرت تو هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 505.1,
   "end": 511.12,
   "text": "بعد یادآوری میشه از اسامی قرآن هم که ذکره، یادآوری میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 511.12,
   "end": 514.46,
   "text": "خلاصه اینکه اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.46,
   "end": 518.26,
   "text": "در این مسیر باشه یعنی اون حب، اون چشیدن‌ها، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.26,
   "end": 521.44,
   "text": "دیدن‌ها، اون تمثلات، اون اکتشافات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.44,
   "end": 526.66,
   "text": "این حالات هنگام روضه شنیدن، اون انواری که رو دیوار دیده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 526.66,
   "end": 529.94,
   "text": "این‌ها که حالا بعضی به عنوان نمونه گفته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 529.94,
   "end": 533.98,
   "text": "این اگر در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 533.98,
   "end": 541.04,
   "text": "معرفت باشه با بذر معرفت و شناخت و آگاهی بوده باشه حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.04,
   "end": 544.64,
   "text": "و اگر نه به‌جز این باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 544.64,
   "end": 546.84,
   "text": "حق نیست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 546.84,
   "end": 549.62,
   "text": "مسیر انحرافه. حالا حداقلش دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 549.62,
   "end": 552.1,
   "text": "خیلی بخوایم ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 552.1,
   "end": 554.16,
   "text": "خودمون رو تعبیری بگیریم میگیم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 554.16,
   "end": 558.28,
   "text": "وهمه، این شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 558.28,
   "end": 562.3,
   "text": "و قوت قوه خیال و وهم ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 562.3,
   "end": 564.56,
   "text": "قوه خیال قوی‌ای داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 564.56,
   "end": 566.9,
   "text": "صورت‌گری این صور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 566.9,
   "end": 570.36,
   "text": "و اشكال رو، انشائات نفس ناطقه‌مون رو زیاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.36,
   "end": 572.7,
   "text": "دوربین عکس‌برداری نفس ناطقه است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.7,
   "end": 575.08,
   "text": "زیاد عکس نشون میده به ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 575.08,
   "end": 579.5,
   "text": "از حول و حوش ما. حالا این عکس‌ها باید تطبیق داده باشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 579.5,
   "end": 582.96,
   "text": "تطبیق داده بشه به اون ملاک اصلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.96,
   "end": 585.06,
   "text": "اون در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 585.06,
   "end": 588.48,
   "text": "محک اصلی که حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.48,
   "end": 591.28,
   "text": "تحت بحث خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.28,
   "end": 595.2,
   "text": "اون ملاک اصلی، محک اصلی قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.2,
   "end": 600.1,
   "text": "باید همه این‌ها به میزان که قرآن استناداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.1,
   "end": 605.14,
   "text": "تطبیق داده بشه. خب ما که اون قدرت رو نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 605.14,
   "end": 608.36,
   "text": "یا باید با یک عالم عارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 608.36,
   "end": 612.72,
   "text": "واصل بگیریم، نه صرفاً یه آدمی که عاشقه، محبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 612.72,
   "end": 617.54,
   "text": "چون کسی که عاشقه و محبه خب در مسیر حب حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 617.54,
   "end": 619.66,
   "text": "این نمی‌تونه چراغ راه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 619.66,
   "end": 625.16,
   "text": "باید عالم عاشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 625.16,
   "end": 628.2,
   "text": "واصل عارف وارسته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 628.2,
   "end": 633.22,
   "text": "یعنی کسی که علم نداره و صرفاً حب داره خب ذاتیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 633.22,
   "end": 637.0,
   "text": "این می‌تونه به انحراف بره و به انحراف بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.0,
   "end": 641.56,
   "text": "باید عالم عاشق باشه، عالم عارف باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 641.56,
   "end": 645.68,
   "text": "یعنی متعلِّق باشه. فیلسوف یا حکیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 645.68,
   "end": 648.52,
   "text": "متعلِّق یعنی عارف هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 648.52,
   "end": 651.84,
   "text": "پشت سرش حرکت کنیم. کسی که صرفاً از مسیر حب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.84,
   "end": 654.7,
   "text": "و عشق حرکت می‌کنه درست، اما این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 654.7,
   "end": 657.16,
   "text": "احتمال انحرافش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 657.16,
   "end": 659.6,
   "text": "و نمی‌تونه راه بلد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 659.6,
   "end": 663.1,
   "text": "نمی‌تونه چراغ دست بگیره دیگران رو بکشونه دنبال سر خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 663.1,
   "end": 667.28,
   "text": "الگو برای ما نیست. باید پشت سر عالم حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 667.28,
   "end": 670.16,
   "text": "حالا دست ما از عالم عارف کوتاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 670.16,
   "end": 676.28,
   "text": "چه کنیم؟ از کجا، از کجا تشخیص بدیم که این‌ها، این حالات به حق‌اند یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 676.28,
   "end": 684.46,
   "text": "این دیدن‌ها، این شنیدن‌ها، این چشیدن، چشیدن‌ها، این حالات عجیب و غریب، این انقلابات درونی به حق‌اند یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 684.46,
   "end": 687.82,
   "text": "یه محک خیلی قشنگ و زیبا و عالی، عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 687.82,
   "end": 692.9,
   "text": "خدا رحمت کنه حضرت استاد علامه سنزده علیه الرحمه دادند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 692.9,
   "end": 696.34,
   "text": "که خودش یه جلسه درس و بحث مفصل می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 696.34,
   "end": 704.8,
   "text": "نفس انسان و نفس. خدا در قرآن به نفس قسم یاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 704.8,
   "end": 707.92,
   "text": "این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 707.92,
   "end": 712.5,
   "text": "قسم به نفس، نفس چیز مقدسیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 712.5,
   "end": 714.54,
   "text": "متق-- عقل این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 714.54,
   "end": 717.58,
   "text": "خدا رو به خدا می‌گفتن عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 717.58,
   "end": 723.64,
   "text": "حالا بعد مثلاً ریاضی‌دان‌ها نسبت به فراخو هاره زبان حال خودشون گفتن واحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 723.64,
   "end": 725.52,
   "text": "همینطوری هرکی یه اسمی گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 725.52,
   "end": 731.97,
   "text": "عقل دمین خیلی کیس بودن گفتن عقل مقدس‌ترین چیزه دیگه عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 731.97,
   "end": 738.59,
   "text": "خطا نمی‌کنه. اون عقل مشوبه به وهم رو نمیگم، عقل خالص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 738.59,
   "end": 743.81,
   "text": "اون خطا نمی‌کنه. لذا با خدا می‌گفتن عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 743.81,
   "end": 747.11,
   "text": "دقت بفرمایید اینجا نتیجه بحث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 747.11,
   "end": 750.95,
   "text": "اگر چنانچه انسان نفسش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 750.95,
   "end": 754.81,
   "text": "نفسش رو، اون نفس خالص رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 754.81,
   "end": 757.35,
   "text": "که در هر کسی از ابتدا بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 757.35,
   "end": 759.45,
   "text": "اون رو مهک بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 759.45,
   "end": 762.65,
   "text": "در همه‌ی گردنه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 762.65,
   "end": 765.11,
   "text": "بهترین مهک رو همراه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 765.11,
   "end": 771.21,
   "text": "که حالا معرفت نفس اینجا خودش رو نشون میده که چقدر اهمیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 771.21,
   "end": 773.47,
   "text": "یعنی چی؟ یعنی آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 773.47,
   "end": 776.09,
   "text": "در مواجهه با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 776.09,
   "end": 780.45,
   "text": "اتفاق، در دیدن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 780.45,
   "end": 786.25,
   "text": "مثلاً کشفیات، این انوار، شنیدن این اصوات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 786.25,
   "end": 790.43,
   "text": "این حالات عجیب و غریبی که در من ایجاد میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 790.43,
   "end": 795.77,
   "text": "در خوردن‌ها، شنیدن‌ها، دیدن‌ها، بوییدن‌ها، لمس کردن‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 795.77,
   "end": 798.63,
   "text": "نشست و برخاست‌ها، مطالعات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 798.63,
   "end": 802.73,
   "text": "و، و، و، و همه‌ی این حالات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 802.73,
   "end": 807.79,
   "text": "اگر نفس من به قول حضرت استاد انبساط خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 807.79,
   "end": 811.85,
   "text": "و حالت خوش روحی پیدا می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 811.85,
   "end": 814.93,
   "text": "و آرامش می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 814.93,
   "end": 819.71,
   "text": "قوت می‌گیره از حالت اضطراب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 819.71,
   "end": 823.97,
   "text": "و تشویش و سردرگمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 823.97,
   "end": 830.23,
   "text": "و در حقیقت قبض بیرون میاد، اون به حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 830.23,
   "end": 836.27,
   "text": "یعنی آدم احساس می‌کنه یه قدم به خدا به حق نزدیک‌تر شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 836.27,
   "end": 838.69,
   "text": "منبسط شد، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 838.69,
   "end": 841.13,
   "text": "گناه منزجر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 841.13,
   "end": 845.39,
   "text": "اما نه اگر به عکس اینه حالش بد میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 845.39,
   "end": 848.49,
   "text": "راحت‌تر به سمت گناه میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 848.49,
   "end": 850.83,
   "text": "اخلاقش به هم می‌ریزه، بد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 850.83,
   "end": 854.19,
   "text": "خلق میشه، عصبی میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 854.19,
   "end": 858.81,
   "text": "عرض شود خدمتتون پرخاشگر میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 858.81,
   "end": 868.85,
   "text": "فحاش میشه، راحت به سمت گناه سر می‌خوره با دیدن و شنیدن و نشست و برخاست با این‌ها و اون‌ها و هرچی که هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 868.85,
   "end": 874.85,
   "text": "اون نفس داره مهکه دیگه داره بهت خبر میده Alarm میزنه که نه این حق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 874.85,
   "end": 878.33,
   "text": "مثلاً از خواب بیدار شدی می‌خوای یه مهک کلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 878.33,
   "end": 883.87,
   "text": "که ما بالای منبر یه روزه مهک کلی رو می‌خواستیم بگیم عزیزان یاری نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 883.87,
   "end": 887.63,
   "text": "الان سهم و روزی این عزیز شده که پرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 887.63,
   "end": 892.69,
   "text": "مهک کلی که حضرت استاد دست ما دادن به همه‌ی شماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 892.69,
   "end": 896.75,
   "text": "روح ایشون اشراق دارن دیگه به طریق اشراق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 896.75,
   "end": 900.77,
   "text": "اشراقيات الهیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 900.77,
   "end": 903.19,
   "text": "محبینشون و مریدانشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 903.19,
   "end": 906.33,
   "text": "بالاخره این‌ها واسطه‌های فیض انسان کامل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 906.33,
   "end": 908.73,
   "text": "حمایت می‌کنند، هدایت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 908.73,
   "end": 916.13,
   "text": "اینه عزیزان که اگه مثلاً خواب دیدی بیدار شدی می‌خوای ببینی این خواب، خواب حق بود یا باطل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 916.13,
   "end": 919.87,
   "text": "اون رگه‌ای از نور که تو خوابت بود چی بود بالاخره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 919.87,
   "end": 924.29,
   "text": "اگر چنانچه از خواب که بیدار شدی انبساط خاطر داشتی، احساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 924.29,
   "end": 927.19,
   "text": "خوشی بهت دست داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 927.19,
   "end": 933.99,
   "text": "انسان خودش متوجه میشه. میگه امروز نمی‌دونم چرا منشرحم، حالم خوشه، شرح صدر دارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 933.99,
   "end": 936.89,
   "text": "آرامش دارم، ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 936.89,
   "end": 942.41,
   "text": "دل کندم از هوس، دل کندم از خواهش دل، دل کندم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 942.41,
   "end": 945.95,
   "text": "پستی، از پلشتی، از زشتی، از آلودگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 945.95,
   "end": 947.83,
   "text": "اینا، اینا همش نشانه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 947.83,
   "end": 951.27,
   "text": "که اون خواب، خواب خوبی بوده، خواب خوشی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 951.27,
   "end": 953.89,
   "text": "تمام کشفیات این چنین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 953.89,
   "end": 957.99,
   "text": "همون مهک کلی که ببینید چقدر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 957.99,
   "end": 964.31,
   "text": "خاندان، واقعاً خاندان عصمت همه‌شون نحن امراء الكلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 964.31,
   "end": 966.89,
   "text": "ما امیران کلامیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 966.89,
   "end": 972.77,
   "text": "به حق که این فرمایش عرشی رو، حکمی رو، عرفانی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 972.77,
   "end": 976.25,
   "text": "چه عرض کنم این فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 976.25,
   "end": 979.79,
   "text": "اَشمَخ رو چگونه امام صادق سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 979.79,
   "end": 984.73,
   "text": "به گونه‌ای که سلام علیک حضرت الله همه فهم باشه بیان کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 984.73,
   "end": 988.35,
   "text": "که از حضرت سؤال کردن چگونه بفهمیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 988.35,
   "end": 991.01,
   "text": "مثلاً نمازمون قبول شده یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 991.01,
   "end": 997.95,
   "text": "عملمون قبول شده یا نه؟ حضرت فرمودن ببینید بعد از نماز بعد از این عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 997.95,
   "end": 1000.05,
   "text": "چقدر از گناه بدتون میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1000.05,
   "end": 1002.91,
   "text": "چقدر از گناه فاصله می‌گیرید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1002.91,
   "end": 1005.23,
   "text": "همون مقدار عملتون پذیرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1005.23,
   "end": 1009.83,
   "text": "این یعنی مهک نفسه. یعنی حال نفس چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1009.83,
   "end": 1013.83,
   "text": "این بزرگ‌ترین مهکه که میشه بهترین مهک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1013.83,
   "end": 1016.83,
   "text": "برای مایی که متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1016.83,
   "end": 1025.65,
   "text": "دستمون از قرآن و عترت و اولیاء الهی البته در حسب ظاهر کوتاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1025.65,
   "end": 1027.87,
   "text": "خدا این چنین در وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1027.87,
   "end": 1033.47,
   "text": "نفس رو تعبیه کرده که برزخ بین حق و باطله، رابطه، واسطه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1033.47,
   "end": 1037.79,
   "text": "وسیله فیضه، کانال فیضه که ما از ملک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1037.79,
   "end": 1041.15,
   "text": "به ملکوت ارتباط بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1041.15,
   "end": 1043.95,
   "text": "این بهترین راه برای تشخیصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1043.95,
   "end": 1048.83,
   "text": "پس المعرفة بذر المشاهده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1048.83,
   "end": 1051.61,
   "text": "با معرفت حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1051.61,
   "end": 1056.07,
   "text": "نفس رو خوش و خوب می‌کنیم تا به کشف و مشاهده بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1056.07,
   "end": 1061.39,
   "text": "هر مشاهده‌ای که هر کشفی، هر تمثلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1061.39,
   "end": 1065.83,
   "text": "هر شنیدن از خاطفی غیبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1065.83,
   "end": 1072.21,
   "text": "هرچه که حال نفس رو خوش و خوب و منبسط و منشرح نکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1072.21,
   "end": 1075.05,
   "text": "این از ناحیه شیاطینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1075.05,
   "end": 1079.11,
   "text": "و به حق نیست و ما رو از خدا دور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1079.11,
   "end": 1080.75,
   "text": "انشاالله که هممون موفق باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1080.75,
   "end": 1086.23,
   "text": "به این طریق میشه موانع وجودی رو هم برای ارتباط و رسیدن به انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1086.23,
   "end": 1089.99,
   "text": "متوجه شد. به همین طریق مهک نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1089.99,
   "end": 1093.95,
   "text": "لذا الان می‌فهمیم که چقدر معرفت نفس مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1093.95,
   "end": 1098.03,
   "text": "هرچی میریم جلوتر متوجه میشیم که اصلاً اول و آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1098.03,
   "end": 1101.91,
   "text": "وظیفه اصلی ما معرفت نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1101.91,
   "end": 1107.81,
   "text": "چون ما کاری مهم‌تر از تهذیب نفس و خودسازی نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1107.81,
   "end": 1112.31,
   "text": "که اون هم مبتنی است بر معرفت نفس که من عرف نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1112.31,
   "end": 1116.97,
   "text": "فقد عرف ربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1116.97,
   "end": 1120.63,
   "text": "و آخر دعوانا أن الحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}