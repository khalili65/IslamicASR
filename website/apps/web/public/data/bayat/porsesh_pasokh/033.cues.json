   "start": 98.02,
   "end": 266.28
  },
  {
   "index": 2,
   "title": "## تواصی به حق و صبر؛ معرفت بذر مشاهده",
   "start": 266.28,
   "end": 397.58
  },
  {
   "index": 3,
   "title": "## جمع‌بندی: ذوق و کشف بر مدار معرفت",
   "start": 397.58,
   "end": 660.42
  },
  {
   "index": 4,
   "title": "## محک نفس از علامه",
   "start": 660.42,
   "end": 968.55
