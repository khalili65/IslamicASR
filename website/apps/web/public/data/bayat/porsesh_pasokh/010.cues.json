   "title": "## پرسش؛ مراقبت هست و حال عبادت نیست",
   "start": 0.52,
   "end": 238.08
  },
  {
   "index": 1,
   "title": "## سه حالت: اقبال، ادبار و میان‌حال",
   "start": 238.08,
   "end": 299.92
  },
  {
   "index": 2,
   "title": "## عوامل انقباض؛ شکستن دل مؤمن",
   "start": 299.92,
   "end": 488.93
  },
  {
   "index": 3,
   "title": "## لقمه؛ حلال، طیب و مطابق مزاج",
   "start": 488.93,
   "end": 651.81
  },
  {
   "index": 4,
   "title": "## علوم و معارف؛ پیش از سیر عملی",
   "start": 651.81,
   "end": 672.91
  },
  {
   "index": 5,
   "title": "## پاسخ نهایی؛ زمان می‌طلبد و عجله مکن",
   "start": 672.91,
   "end": 854.77
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.52,
   "end": 4.08,
   "text": "بسم الله و بالله و علی ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.08,
   "end": 8.3,
   "text": "المستغاث بکی یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.3,
   "end": 13.54,
   "text": "پرسیدن که چرا با وجود این که ما مراقبت داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.54,
   "end": 17.48,
   "text": "و اصل مهم مراقبت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.48,
   "end": 23.86,
   "text": "رعایت می‌کنیم باز حال عبادتمون اونطور که شایسته باشد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.86,
   "end": 26.78,
   "text": "و همچنین برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.78,
   "end": 30.2,
   "text": "حال داشته باشیم خصوصاً در نماز و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.2,
   "end": 33.88,
   "text": "با وجود داشتن مراقبت آیا نیازه که زمان بگذره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.88,
   "end": 41.4,
   "text": "ببینید عزیزان من یه توضیح مختصری پیرامون این علل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.4,
   "end": 44.42,
   "text": "حالات انسان عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.42,
   "end": 47.66,
   "text": "ما چون ابتدای راه هستیم تر-- غالباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.66,
   "end": 51.22,
   "text": "خب هنوز اون در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.22,
   "end": 55.44,
   "text": "حالات وجودیمون به مقام تبدیل نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.44,
   "end": 57.94,
   "text": "در عرفان میگن مقام، در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.94,
   "end": 61.94,
   "text": "فلسفه یا حکمت میگن ملکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.94,
   "end": 65.32,
   "text": "که دیگه همیشه حالمون خوش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.32,
   "end": 68.98,
   "text": "اما چون ابتدای راه هستیم غالباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.98,
   "end": 71.34,
   "text": "حال داریم و این حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.34,
   "end": 74.44,
   "text": "به جهت انقلاب قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.44,
   "end": 79.3,
   "text": "که دائماً منقلب است از همین جهت هم اسمش رو گذاشتن قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.3,
   "end": 86.7,
   "text": "دائماً در حاله از حالی به حال دیگر رفتن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.7,
   "end": 90.94,
   "text": "حال ثابتی نداریم و این حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.94,
   "end": 93.3,
   "text": "ثابت نداشتن ما را اذیت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.3,
   "end": 96.14,
   "text": "این فقط مال ما نیست عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.14,
   "end": 99.04,
   "text": "غالبه یعنی قریب به اتفاق انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.04,
   "end": 102.68,
   "text": "مگر اوهدی از اولیاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.68,
   "end": 109.62,
   "text": "این حالت رو دارن بلکه اون‌ها هم به نحو خودشون باز حالت انبساط و انقباض رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.62,
   "end": 116.96,
   "text": "ما در صورت کلی یک حالتی داریم که اصطلاحاً بهش میگن انبساط یا اقبال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.96,
   "end": 122.92,
   "text": "یک حالتی دارن، داریم که بهش میگن انقباض یا ادبار و یک حالت بینابین این‌ها داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.92,
   "end": 126.98,
   "text": "اینو من توضیح بدم بدونیم همه ما این حالات رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.98,
   "end": 133.7,
   "text": "یکی کمتر یکی بیشتر. و اینکه چرا اینطور هستیم رو هم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.7,
   "end": 137.76,
   "text": "حالت انبساط و بسط وجودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.76,
   "end": 140.8,
   "text": "گسترش، گسترش وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.8,
   "end": 142.88,
   "text": "یا حالا ظرفیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.88,
   "end": 151.78,
   "text": "بالا داشتن یا به عبارتی همون اقبال حالتی‌ست که انسان نشاط عبادت داره، ذوق و شوق عبادت داره، حال داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.78,
   "end": 156.84,
   "text": "به عبارتی خوشش میاد ذکر بگه، نماز بخونه، قرآن بخونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.84,
   "end": 159.54,
   "text": "خلوت کنه و اینا. این حالت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.54,
   "end": 163.56,
   "text": "در این حالت اهل بیت علیهم الصلاة والسلام وظیفه ما رو مشخص کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.56,
   "end": 166.1,
   "text": "فرمودن تا اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.1,
   "end": 171.78,
   "text": "عطش داری عبادت کن. وقتی این حالت اقبال رو داری تا می‌تونی عبادت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.78,
   "end": 177.74,
   "text": "عبادت بکن تا وقتی که این حالت رو داری هر مقدار که میسر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.74,
   "end": 181.98,
   "text": "اما حالت اقب-- ادبار که پشت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.98,
   "end": 187.18,
   "text": "قلب به این لذت‌ها و این حقایق یا به عبارتی انقباض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.18,
   "end": 192.0,
   "text": "قبض وجودی. انسان به یک حالتی دچار می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.0,
   "end": 195.76,
   "text": "ظاهراً لذتی از این چیزها نمی‌بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.76,
   "end": 198.34,
   "text": "و دل پشت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.34,
   "end": 201.14,
   "text": "و خیلی رغبت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.14,
   "end": 204.56,
   "text": "رغبت نداره عبادت کنه و ذکر بگه و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.56,
   "end": 207.96,
   "text": "اینجا هم اهل بیت علیهم الصلاة والسلام وظیفه ما رو مشخص کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.96,
   "end": 211.7,
   "text": "فرمودن در این حالت که برای همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.7,
   "end": 214.26,
   "text": "قریب به اتفاق پیش میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.26,
   "end": 218.18,
   "text": "انسان باید اکتفا کنه به حداقل واجباتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.18,
   "end": 220.88,
   "text": "یعنی مثلاً اون واجبات و نمازشو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.88,
   "end": 225.98,
   "text": "حتی نمازشو کش و قوس هم نده بلکه زدگی ایجاد نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.98,
   "end": 229.0,
   "text": "حداقل ممکن واجباتشو بخونه تا این حالت رفع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.0,
   "end": 232.16,
   "text": "توسل کنه، توجه کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.16,
   "end": 235.18,
   "text": "تفکر کنه تا انشاالله از این حالت بیاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.18,
   "end": 237.44,
   "text": "حالتی که خطرناکه بین این دو تاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.44,
   "end": 239.9,
   "text": "یعنی حالتی که انسان نمی‌دونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.9,
   "end": 243.0,
   "text": "منبسطه یا منقبضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.0,
   "end": 245.74,
   "text": "حالت ادبار داره یا اقبال داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.74,
   "end": 250.64,
   "text": "مثل کسی که گرسنه است اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.64,
   "end": 253.8,
   "text": "احساس گرسنگی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.8,
   "end": 256.32,
   "text": "اینجا چه باید کرد؟ باید بهش سرم زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.32,
   "end": 260.48,
   "text": "باید بهش آمپول تقویتی تزریق کرد به زور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.48,
   "end": 266.76,
   "text": "و اینجا بهترین حالت برای کسی که نمی‌دونه والا چه حالتی داره و حیرانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.76,
   "end": 270.88,
   "text": "شرکت در جماعت اهل ایمان و هم‌نفس شدن با خوبان و پاکان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.88,
   "end": 278.64,
   "text": "و منبر بزرگان و علما و جلسات ذکر و درس و بحث و رفتن به زیارتگاه و اینجور جاهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.64,
   "end": 281.38,
   "text": "که بشینه فکر کنه. بشینه نگاه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.38,
   "end": 283.12,
   "text": "خودش هم درگیر نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.12,
   "end": 286.34,
   "text": "در اجتماع اهل ایمان حضور پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.34,
   "end": 290.6,
   "text": "یکی از معجزات اجتماعات اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.6,
   "end": 293.36,
   "text": "همین حضور صرف حضور در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.36,
   "end": 296.14,
   "text": "جلسات ذکر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.14,
   "end": 302.64,
   "text": "خب پس حالا بریم سراغ این که چرا این حالت به انسان دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.64,
   "end": 309.2,
   "text": "عوامل مختلفی هستند که انسان رو از حالت انبساط خاطر به انقباض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.2,
   "end": 311.36,
   "text": "یا از ادبا-- از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.36,
   "end": 315.1,
   "text": "اقبال به ادبار می‌رسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.1,
   "end": 319.14,
   "text": "این‌ها مهماتشو من عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.14,
   "end": 322.88,
   "text": "یا اینکه انسان دل یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.88,
   "end": 328.2,
   "text": "صاحب دلی رو شکسته که هرچه قدر این صاحب دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 328.2,
   "end": 332.88,
   "text": "پیش خدا عزیزتر باشه و مقام و ارج و قبر، قرب داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.88,
   "end": 335.66,
   "text": "حالت قبض برای انسان بیشتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.66,
   "end": 338.2,
   "text": "قلب المؤمن عرش الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.2,
   "end": 341.68,
   "text": "قلب مؤمن که بشکنه عرش خدا می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.68,
   "end": 349.48,
   "text": "خصوصاً اگر این مؤمن پدر مادر باشن که اساساً مؤمن هم نباشند که باز پدر مادر دلشون نباید بشکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.48,
   "end": 356.02,
   "text": "خیلی خطرناکه. دل یک مؤمن، دل یک مثلاً آدمی که پیش خدا آبرومنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.02,
   "end": 358.06,
   "text": "با یک تمسخر، با یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.06,
   "end": 360.02,
   "text": "حالا هرچی دلش رو شکستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.02,
   "end": 363.18,
   "text": "این‌ها انقباض خاطر میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.18,
   "end": 365.62,
   "text": "قبض میاره. حتی رزق رو کم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.62,
   "end": 369.47,
   "text": "اینا حالا مهماتش که من دارم عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 369.47,
   "end": 373.15,
   "text": "دیگریش هم‌نشین بده یا نفس ناپاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 373.15,
   "end": 378.85,
   "text": "شما یه آینه رو بگیرید جلو دهنتون، یه ها کنید، می‌دونید چه سریع تار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 378.85,
   "end": 381.29,
   "text": "نفس ناپاک انقدر سریع تاثیر می‌ذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.29,
   "end": 385.81,
   "text": "خدا رحمت کنه آیت‌الله مرندی رو محضرشون بودیم یه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.81,
   "end": 392.83,
   "text": "در مسجد قبا. خیلی سال‌های پیش ایشون فکر می‌کنم از تفسیر صافی بود حدیث رو از امام صادق صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.83,
   "end": 397.91,
   "text": "با یه حالی بیان کردن که شخصی اومد محضر امام صادق صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 397.91,
   "end": 400.41,
   "text": "عرض کرد آقا من دعام بالا نمی‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.41,
   "end": 402.59,
   "text": "حال خ-- خوشی ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.59,
   "end": 405.39,
   "text": "هرچی دعا می‌کنم انگار دعای من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.39,
   "end": 409.79,
   "text": "بالا نمی‌ره. خدا به من توجهی نداره از این قبیل صحبت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.79,
   "end": 413.83,
   "text": "حضرت فرمودن در همون سؤال اول فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.83,
   "end": 419.99,
   "text": "حالا یه چند تا موردو پشت سر هم من ااا عرض کنم که حضرت در به دفعات اینا رو فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.99,
   "end": 422.11,
   "text": "یه بار فرمودن حرام نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.11,
   "end": 425.55,
   "text": "یه بار فرمودن هرزگی نکن و زنا نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.55,
   "end": 427.47,
   "text": "یه بار فرمودن شراب نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.47,
   "end": 435.23,
   "text": "خلاصه هر بار این شخص به تعجبش اضافه شد و در آخر عرض کرد يا ابن رسول الله من هیچ کدوم از این کارا رو نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.23,
   "end": 437.47,
   "text": "حضرت فرمودن ببین عزیزم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 437.47,
   "end": 443.45,
   "text": "تو دیوار به دیوار کسی هستی که همه این کارها رو داره می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.45,
   "end": 447.85,
   "text": "و ملائکه از اون محل و اون مکان فراری‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.85,
   "end": 452.05,
   "text": "در-- یعنی به جهت وجود این انسان پست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.05,
   "end": 454.81,
   "text": "اثر گذاشته در زندگی و خانه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.81,
   "end": 458.85,
   "text": "ز-- کاشانه تو و اون هوای پست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.85,
   "end": 462.13,
   "text": "هوای زندگی تو رو هم آلوده کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.13,
   "end": 467.11,
   "text": "راهش هجرته. خیلی مهمه انسان در جانمایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.11,
   "end": 470.07,
   "text": "خونه‌ای که می‌خواد یا بخره یا اجاره کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.07,
   "end": 472.65,
   "text": "دقت کنه کدوم محل، کدوم همسایه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.65,
   "end": 476.45,
   "text": "محل کاری که میره، مدرسه‌ای که بچه‌ش رو ثبت‌نام می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 476.45,
   "end": 478.23,
   "text": "همسایگان، فامیل‌ها، نزدیکان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.23,
   "end": 483.57,
   "text": "اینا همه موثرن. نفس به شدت انسان رو می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.57,
   "end": 486.07,
   "text": "دچار قبض یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.07,
   "end": 488.93,
   "text": "برعکس بسط وجودی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.93,
   "end": 492.87,
   "text": "نکته دو-- سوم لقمه‌ست عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.87,
   "end": 495.91,
   "text": "لقمه. لقمه، لقمه خیلی خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.91,
   "end": 505.03,
   "text": "خیلی. لقمه حالا از جهت پاک بودن و حلال بودن و طیب بودنش که هر کدوم جای بحث خودش رو دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 505.03,
   "end": 509.15,
   "text": "یک موضوعه که یک ش-- لقمه شبه‌ناک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 509.15,
   "end": 512.21,
   "text": "یا غیر حلال خدایی نکرده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.21,
   "end": 515.27,
   "text": "این که ت-- حالا حلال هم باشه اما طیب نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 515.27,
   "end": 520.53,
   "text": "یعنی مثلاً با پول حلال بره از یه کاسبی چیزی رو بخره که اون کاسب آدم پستی‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 520.53,
   "end": 523.99,
   "text": "این می‌شه طیب نیست. حلال هست اما طیب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 523.99,
   "end": 527.83,
   "text": "که لقمه اولیای خدا طبق قرآن، انبیا، اولیا اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.83,
   "end": 530.27,
   "text": "لقمه طیبه، نه فقط حلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 530.27,
   "end": 532.85,
   "text": "اینا همه اثر می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.85,
   "end": 537.21,
   "text": "در حین این که حالا لقمه باید پاک باشه، حلال باشه، طیب باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 537.21,
   "end": 541.35,
   "text": "در عین حال باید مطابق با مزاج هم باشه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 541.35,
   "end": 543.43,
   "text": "لقمه باید مطابق با مزاج باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 543.43,
   "end": 546.25,
   "text": "مزاجت رو باید بشناسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 546.25,
   "end": 548.79,
   "text": "در طب اسلامی و طبق اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 548.79,
   "end": 552.07,
   "text": "مثلاً سردی‌جات حال معنوی انسان رو میاره پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 552.07,
   "end": 555.75,
   "text": "افت می‌کنه انسان. گرمی‌جات برعکسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.75,
   "end": 559.21,
   "text": "باز نسبت به مزاج‌ها و طبایع انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.21,
   "end": 563.95,
   "text": "فرق می‌کنه. باید تطبیق بین عالم و آدم رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.95,
   "end": 566.51,
   "text": "یکی از مهمات علومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 566.51,
   "end": 568.71,
   "text": "که متاسفانه به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 568.71,
   "end": 574.91,
   "text": "کوتاهی ما از بزرگان و کتاب‌هاشون که داره خاک می‌خوره ما غافلیم از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.91,
   "end": 582.09,
   "text": "حقایق. البته اینا به تجربه می‌شه انسان خودش متوجه بشه در سیر زندگی تکوین نظام عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 582.09,
   "end": 585.19,
   "text": "یعنی عالم به آدم درس می‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.19,
   "end": 591.73,
   "text": "که تو چی بخور، چی نخور. مشخص می‌شه وقتی معمولاً یه چیزی رو می‌خوری حالت خوب می‌شه، بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 591.73,
   "end": 595.17,
   "text": "چرا؟ یا بالعکسش. به جهت این‌که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 595.17,
   "end": 598.69,
   "text": "وقتی حالش خوشه که اعتدال مزاج داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 598.69,
   "end": 602.51,
   "text": "مزاجش معتدل باشه. لذا شیخ الرئیس علیه رحمة در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 602.51,
   "end": 604.89,
   "text": "نمت‌های ده گانه اشاراتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 604.89,
   "end": 607.77,
   "text": "یه بحث مبسوطی رو اونجا پیاده می‌کنه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 607.77,
   "end": 609.89,
   "text": "زشی-زیبا و شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 609.89,
   "end": 611.91,
   "text": "پیرامون همین مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 611.91,
   "end": 617.27,
   "text": "که اونجا می‌فرماید امام حجت خدا کسی‌ست که عدل امزجه رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 617.27,
   "end": 621.51,
   "text": "معتدل‌ترین مزاج رو. دیدی گاهی اوقات یه چیزی می‌نویسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 621.51,
   "end": 625.21,
   "text": "بهترین خط رو می‌نویسی، دیگه نمی‌تونی مثل اون موقع بنویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 625.21,
   "end": 629.91,
   "text": "یه وقت سخنرانی می‌کنی، یه وقت مدایی می‌کنی، یه وقت یه هنری از خودت به خرج میدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 629.91,
   "end": 632.55,
   "text": "دیگه نمی‌تونی مثل اون. چرا؟ اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 632.55,
   "end": 637.03,
   "text": "مزاجت معتدل بود. خیلی تاثیر داره مزاج معتدل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.03,
   "end": 642.63,
   "text": "در حالات انسان. که این هم بحث لقمه‌ست که خیلی انسان باید روش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 642.63,
   "end": 646.21,
   "text": "کار کنه دیگه. باید کار کنه، تلاش کنه، علمش رو به دست بیاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 646.21,
   "end": 648.49,
   "text": "با اهلش بنشینه و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 648.49,
   "end": 654.57,
   "text": "و نکته به عبارتی بسیار شاید مهم‌تر از همه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 654.57,
   "end": 656.41,
   "text": "بحث علوم و معارفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 656.41,
   "end": 661.11,
   "text": "کار فکری و عقلی کردنه که حتی علامه حسن زاده می‌فرمایند اگه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 661.11,
   "end": 666.25,
   "text": "سیر حکمت و عرفان نظری رو نره، یعنی علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.25,
   "end": 669.55,
   "text": "ااا در حقیقت حصولی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 669.55,
   "end": 672.91,
   "text": "طی نکنه، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 672.91,
   "end": 682.11,
   "text": "در حقیقت اهل مطالعه و تدبر و خوانش کلمات وجودی عالم هستی، اون سه کتابی که بارها عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 682.11,
   "end": 684.51,
   "text": "و زانوزن در محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 684.51,
   "end": 686.53,
   "text": "اهل علم نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 686.53,
   "end": 690.77,
   "text": "و سیر حکمت و عرفان رو به صورت نظری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 690.77,
   "end": 696.03,
   "text": "طی نکنه، این علم فکری رو پیش نگیره، بعد یک راست بره سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 696.03,
   "end": 698.39,
   "text": "حکمت و عرفان عملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 698.39,
   "end": 701.79,
   "text": "که معمولاً متاسفانه جوون‌های ما این شکلی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 701.79,
   "end": 708.69,
   "text": "یکباره میرن سراغ عرفان و حکمت و فلسفه و ع-- به صورت عملی، ذکر و ورد و سیر و سلوک و برنامه و و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 708.69,
   "end": 712.85,
   "text": "این‌ها غالباً یه روزی خارج می‌شن از این وضعیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 712.85,
   "end": 717.77,
   "text": "و دچار شک و تردید و حالات بد می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 717.77,
   "end": 724.19,
   "text": "و گرفتار می‌شن. خلاصه ب-به خاطر این که بدون پشتوانه فکری لازم رفتن جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 724.19,
   "end": 726.91,
   "text": "این‌ها بعداً به قولی چپه می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 726.91,
   "end": 730.85,
   "text": "یعنی از اون راه به در میرن و عده‌، یه عده‌ام پشت سر خودشون می‌کشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 730.85,
   "end": 739.59,
   "text": "خیلی هم خطرناک هست. این همه توضیحات رو دادیم برای اینکه یک سؤال رو جواب بدیم که گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 739.59,
   "end": 742.85,
   "text": "ااا با وجود اینکه مراقبت داریم باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 742.85,
   "end": 745.55,
   "text": "حال عبادت اونطوری که باید باشه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 745.55,
   "end": 747.81,
   "text": "چرا؟ خب این دلایلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 747.81,
   "end": 749.93,
   "text": "این‌ها باید همه رفع بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 749.93,
   "end": 752.33,
   "text": "تا انسان ثبات پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 752.33,
   "end": 754.99,
   "text": "البته، البته، البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 754.99,
   "end": 757.59,
   "text": "این زمان می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 757.59,
   "end": 759.93,
   "text": "چون پرسیدن که آیا زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 759.93,
   "end": 765.03,
   "text": "مثلاً برای اینکه انسان حال خوشی در نماز مخصوصاً داشته باشه زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 765.03,
   "end": 766.77,
   "text": "می‌طلبه با وجود مراقبت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 766.77,
   "end": 769.13,
   "text": "بله صد البته که زمان می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 769.13,
   "end": 773.29,
   "text": "مطلقاً انسان نباید عجله کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 773.29,
   "end": 775.83,
   "text": "عجله اصلاً تو این قصه خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 775.83,
   "end": 782.83,
   "text": "باید تا می‌تونه تلاش بکنه اما برای رسیدن به حالت مطلوب عجله نباید بکنه چون خراب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 782.83,
   "end": 787.19,
   "text": "نسبت به سعه‌ی وجودیش بره به جلو پله، پله، پله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 787.19,
   "end": 790.81,
   "text": "خدا رحمت کنه حاج ملا هادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 790.81,
   "end": 793.89,
   "text": "ااا عرض شود سبزواری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 793.89,
   "end": 795.93,
   "text": "که در این خصوص در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 795.93,
   "end": 798.27,
   "text": "اسرارالحکمش چه مطالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 798.27,
   "end": 803.23,
   "text": "زیبا و عرشی رو گفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 803.23,
   "end": 809.65,
   "text": "بسیاری از بزرگان خود حضرت علامه بسیار تو این قصه تاکید دارند که اصلاً عجله نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 809.65,
   "end": 813.17,
   "text": "پله پله. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 813.17,
   "end": 816.99,
   "text": "این همونطور که عرض کردم در اغلب انسان‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 816.99,
   "end": 819.53,
   "text": "این اینطور نیست که شما فکر کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 819.53,
   "end": 822.83,
   "text": "یک آدمی حتی از جهت معرفتی به شدت رشد کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 822.83,
   "end": 828.95,
   "text": "بعد این حالت رو نداشت. من در مطالعاتی که داشتم بسیاری از اهل معرفت که مجسمه تقوا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 828.95,
   "end": 832.61,
   "text": "علم و ایمان و عمل و خلوص و توحید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 832.61,
   "end": 838.85,
   "text": "توحید هستند رو باز در احوالاتشون دیدم که یک مدتی حتی طولانی دچار قبض شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 838.85,
   "end": 841.97,
   "text": "دچار ادبار شدن. این‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 841.97,
   "end": 844.47,
   "text": "قلب دیگه منقلب می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 844.47,
   "end": 848.77,
   "text": "که باید توجه عرفانی کرد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 848.77,
   "end": 852.85,
   "text": "یا مقلب القلوب والأبصار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 852.85,
   "end": 854.77,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}