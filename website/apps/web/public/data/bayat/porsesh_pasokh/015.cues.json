 ],
 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 6.3,
   "text": "بسم الله و بالله و علی ملت رسول الله المستغاث بک یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.3,
   "end": 12.36,
   "text": "پرسیدن که با وجود اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.36,
   "end": 15.02,
   "text": "محی الدین عربی مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.02,
   "end": 18.12,
   "text": "اه سنی مذهب بوده و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.12,
   "end": 20.76,
   "text": "و همچنین البته به زعم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.76,
   "end": 23.74,
   "text": "سؤال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.74,
   "end": 29.4,
   "text": "ته-- استنباط‌های خودش رو از آیات و روایات اهل بیت بیان کرده و تفسیر به رأی کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.4,
   "end": 32.24,
   "text": "چه بونه از طه امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.24,
   "end": 39.0,
   "text": "طبق صحبت‌های شما ااا اندیشمندان بزرگ شرق و غرب و عالم اسلام رو دعوت به آثار ایشون کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.0,
   "end": 42.88,
   "text": "اولاً باید گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.88,
   "end": 46.58,
   "text": "همین که یک شخصیت جامع الاطرافی که محی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.58,
   "end": 52.86,
   "text": "Islam در عصر معاصر بودن مثل از طه امام که یک فقیه، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.86,
   "end": 56.28,
   "text": "فقیه متفقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.28,
   "end": 58.86,
   "text": "مطلقه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.86,
   "end": 60.9,
   "text": "همچنین یک سیاسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.9,
   "end": 68.32,
   "text": "یک عارف به تمام معنا، یک فیلسوف، یک جامعه‌شناس یعنی واقعاً یک شخصیت جامع الاطراف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.32,
   "end": 73.26,
   "text": "یک مجاهد در راه خدا مثل از طه امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.26,
   "end": 79.54,
   "text": "به آثار ایشون دعوت می‌کنند و از ایشون به عظمت یاد می‌کنند پیداست که خبرهاست و ما بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.54,
   "end": 83.06,
   "text": "این خودش مطلبی‌ست. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.06,
   "end": 86.66,
   "text": "مختصراً عرض کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.66,
   "end": 93.82,
   "text": "خود حضرت ابن عربی که البته معروفاً به شیخ اکبر و محی الدین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.82,
   "end": 97.22,
   "text": "یعنی احیاگر دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.22,
   "end": 100.88,
   "text": "و شیخ اکبر و اینها که متولد آندلس بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.88,
   "end": 105.14,
   "text": "و این القاب رو به جهت عظمتشون گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.14,
   "end": 116.02,
   "text": "سال پونصد و شصت هجری قمری به دنیا اومدن، ششصد و سی‌هشت هجری قمری در دمشق وفات یافتن و همونجا هم دفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.02,
   "end": 119.2,
   "text": "حداقل هفتصد و پنجاه عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.2,
   "end": 123.14,
   "text": "کتاب، جلد کتاب به ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.14,
   "end": 129.44,
   "text": "منتسب هست که بعضیا تا هزار عنوان هم گفتن اما هفتصد و پنجاه تا دیگه یقینی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.44,
   "end": 133.06,
   "text": "که یکی از مهمات این تألیفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 133.06,
   "end": 137.1,
   "text": "فتوحات مکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.1,
   "end": 141.7,
   "text": "و مدنیه ایشونه که فتوحات مکی- مدنیه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.7,
   "end": 146.6,
   "text": "از مفقود شد و فتوحات مکیه‌شون موند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.6,
   "end": 149.4,
   "text": "و همچنین فصوص الحکم‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.4,
   "end": 154.16,
   "text": "رسالات البته زیادی دارن ایشون ولی مهماتشون این دو تا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.16,
   "end": 157.04,
   "text": "در حقیقت کشف و کراماتشون یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.04,
   "end": 160.4,
   "text": "القاءاتی که به ایشون به زعم خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.4,
   "end": 163.74,
   "text": "القاءات صبوحی که از حضرت نبی اکرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.74,
   "end": 166.12,
   "text": "به قلبشون جاری شده رو اینجا جمع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.12,
   "end": 168.78,
   "text": "در مکه میشه فتوحات مکیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.78,
   "end": 172.84,
   "text": "در مدنی- مدینه هم که فتوحات مدنیه بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.84,
   "end": 176.84,
   "text": "دست ما نرسیده. جالب اینجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.84,
   "end": 186.0,
   "text": "البته خود اهل تسنن ایشون رو معتقدن که ایشون مثلاً حنبلی مذهب بوده در حالی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.0,
   "end": 191.32,
   "text": "اسناد زیادی داریم که به زعم بزرگان اهل معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.32,
   "end": 197.54,
   "text": "مثل شیخ بهائی، شیخ بها که دیگه از عظمت ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.54,
   "end": 200.7,
   "text": "به هر حال کم گفته نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.7,
   "end": 208.24,
   "text": "که ایشون هم شخصیت جامع الاطراف و ذو فنون بودند که البته شاگرد ایشون یکی میشه مثل ملا صدرا علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.24,
   "end": 211.1,
   "text": "که انقلابی در، انقلابی در در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.1,
   "end": 214.02,
   "text": "حقیقت عرفان و فلسفه ایجاد می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.02,
   "end": 216.36,
   "text": "و اینها صاحب کتاب اسفار هستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.36,
   "end": 219.44,
   "text": "اسفار اربه. خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.44,
   "end": 221.62,
   "text": "شیخ بها معتقدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.62,
   "end": 227.8,
   "text": "اولاً ایشون در عصری زندگی می‌کنند، می‌کردند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.8,
   "end": 232.62,
   "text": "متعلق به یعنی والیان اون زمان از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.62,
   "end": 240.16,
   "text": "بنی امیه بودند و به شدت به شیعیان امیرالمؤمنین صلوات الله علیه سخت می‌گرفتند، آزار و اذیت و شکنجه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.16,
   "end": 241.86,
   "text": "زندانی و کشت و کشتار و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.86,
   "end": 246.12,
   "text": "لذا تمام شیعیان مولا اونجا تو، تو اون عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.12,
   "end": 249.98,
   "text": "اهل تقیه بودند و شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.98,
   "end": 258.56,
   "text": "بها معتقد هستش که ایشون هم تقیه کرده و اگر در آثارش اگر اه بپذیریم که اینها متعلق به ایشون بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.56,
   "end": 260.38,
   "text": "است و تحریفی در آثار ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.38,
   "end": 263.66,
   "text": "صورت نگرفته که البته اینجا ما حرف داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 263.66,
   "end": 269.58,
   "text": "اگر بپذیریم که تحریف صورت نگرفته، ایشون مجبور بوده بعض از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.58,
   "end": 273.08,
   "text": "مطالب رو در خصوص اه از شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.08,
   "end": 280.6,
   "text": "خلفا بیان کنند که بتونن در اون عصر نفس بکشن و القاءاتشون رو به شاگردانشون داشته باشن و آثارشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 280.6,
   "end": 283.62,
   "text": "تألیف کنن. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.62,
   "end": 286.1,
   "text": "وقتی شما آثار ایشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.1,
   "end": 289.78,
   "text": "دقت می‌کنید مثلاً در خود کتاب فتوحات‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.78,
   "end": 294.06,
   "text": "جمله خیلی شیرینی دارن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 294.06,
   "end": 296.8,
   "text": "بسیاری از بزرگان این جمله رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 296.8,
   "end": 301.04,
   "text": "استناد کردن به اینکه ایشون قطعاً شیعه اثنی عشری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.04,
   "end": 308.82,
   "text": "مثلاً در فتوحات می‌فرمایند که علی ابن ابی طالب نزدیک‌ترین افراد به رسول خدا و سر همه انبیا و اولیا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.82,
   "end": 311.46,
   "text": "خب اینو چه کسی می‌تونه بگه؟ چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.46,
   "end": 314.72,
   "text": "کلمات و الفاظی و حقایقی جز از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.72,
   "end": 318.34,
   "text": "دهان پاک و جز از وجودی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.34,
   "end": 323.82,
   "text": "ولایت کلیه اهل بیت علیهم الصلاة والسلام رو پذیرفته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 323.82,
   "end": 325.94,
   "text": "صادر نمیشه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.94,
   "end": 333.8,
   "text": "ج-جز از دهان پاک این حرف‌های عرشی خارج نمیشه که لا یمسه إلا المتهرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 333.8,
   "end": 338.26,
   "text": "اتفاقاً شیخ عبد الوهاب شعرانی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 338.26,
   "end": 340.44,
   "text": "حضرت علامه شعرانی استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.44,
   "end": 343.66,
   "text": "علامه حسن زاده رو عرض نمی‌کنم اشتباه نشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 343.66,
   "end": 348.54,
   "text": "ایشون متوفی سال نهصد و هفتاد و سه هجری قمریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 348.54,
   "end": 351.32,
   "text": "از فتوحات نقل می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.32,
   "end": 353.46,
   "text": "یک جمله‌ای رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.46,
   "end": 356.2,
   "text": "چند جمله‌ای رو از فتوحات میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 356.2,
   "end": 359.86,
   "text": "به نقل از شیخ اکبر که ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 359.86,
   "end": 362.68,
   "text": "مفصله البته عبارتش خلاصش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.68,
   "end": 369.74,
   "text": "بدانید که زمانی که دنیا پر از ظلم و جور شود امام مهدی صلوات الله علیه قیام می‌کند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 369.74,
   "end": 373.0,
   "text": "جهان را پر از عدل و داد می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 373.0,
   "end": 374.42,
   "text": "اگر از عمر دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.42,
   "end": 381.7,
   "text": "یه روز بیشتر باقی نمانده باشه خداوند اون روزو چنان طولانی میکنه تا امام مهدی صلوات الله علیه ظهور کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 381.7,
   "end": 387.5,
   "text": "امام کلمه امام میاره که حالا من دارم ترجمه اش رو عرض می‌کنم به عربی نوشته ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 387.5,
   "end": 390.86,
   "text": "او از فرزند رسول خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.86,
   "end": 394.8,
   "text": "که از حضرت زهرا سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 394.8,
   "end": 403.26,
   "text": "جده ایشون و پدرشون امام حسن عسکری همینطوری میرسونه تا امام علی ابن ابی طالب که جالبه همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 403.26,
   "end": 406.7,
   "text": "ائمه در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 406.7,
   "end": 410.36,
   "text": "اهل بیت علیهم الصلاة والسلام رو لفظ امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 410.36,
   "end": 414.82,
   "text": "با الامام معرفی میکنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 414.82,
   "end": 418.7,
   "text": "این نشون میده که ایشون شیعه اسماعیلیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 418.7,
   "end": 420.76,
   "text": "و خود شیخ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 420.76,
   "end": 425.22,
   "text": "شیخ شهرانی در یک کتابی دارن به نام علی غواقیط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 425.22,
   "end": 431.5,
   "text": "با قاف علی غواقیط. اونجا جمل خودشان میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 431.5,
   "end": 437.12,
   "text": "این جملاتی که در حقیقت در فتوحات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 437.12,
   "end": 447.14,
   "text": "ابن عربی آورده و دیده ایشون در چاپ‌های جدید فتوحات مکیه حذف شده و حتی نام ائمه اسماعیلی حذف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 447.14,
   "end": 449.98,
   "text": "چرا؟ چون خود ایشون میفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 449.98,
   "end": 455.82,
   "text": "شیخ شهرانی میفرماید که چون تاییدی بر مذهب شیعه بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 455.82,
   "end": 460.46,
   "text": "در حقیقت توسط سلفیون تن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 460.46,
   "end": 463.14,
   "text": "و وهابی اینا حذف شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 463.14,
   "end": 469.0,
   "text": "جالبه که خود حضرت استاد علامه حسن زاده حفظه الله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 469.0,
   "end": 471.7,
   "text": "ایشون هم معتقدند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 471.7,
   "end": 477.0,
   "text": "کتاب‌های ابن عربی تحریف شده، مصلح شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 477.0,
   "end": 481.64,
   "text": "و البته ایشون وقتی این باب رو باز می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 481.64,
   "end": 486.74,
   "text": "اشاره می‌کنند به کشکول شیخ بهائی به چاپ مصر و اینها میگن اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 486.74,
   "end": 490.76,
   "text": "یعنی بحث تحریف را از کشکول شیخ بهائی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 490.76,
   "end": 494.76,
   "text": "آغاز می‌کنند که میفرمایند مثلا مثال میارن که منقبت حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 494.76,
   "end": 497.7,
   "text": "صدیقه طاهره سلام الله علیها که در جوامع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 497.7,
   "end": 504.82,
   "text": "روایی عامه روایت شده بوده از کشکول شیخ بهائی بعدها تو چاپ‌های بعدیش که به چاپ مصر رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 504.82,
   "end": 507.46,
   "text": "حذف شد و آه میکشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 507.46,
   "end": 510.34,
   "text": "علامه میگن چقدر سیئه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 510.34,
   "end": 513.46,
   "text": "سیئه زشتیه این کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 513.46,
   "end": 516.28,
   "text": "که انسان اعتمادش رو نسبت به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 516.28,
   "end": 521.14,
   "text": "چاپگرها و اینها مخصوصا وقتی دیگه به صنعت چاپ رشد کرد از دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 521.14,
   "end": 527.82,
   "text": "بعد اشاره می‌کنند حضرت علامه به تاریخ ابوجعفر طبری که میگن ایشون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 527.82,
   "end": 536.68,
   "text": "در هنگام طبش تحریف شده کتاباش و استناد می‌کنند به سوابق ابن اثیر تو کتاب تاریخش که میگه برخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 536.68,
   "end": 539.86,
   "text": "آنچه که من از ابوجعفر طبری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 539.86,
   "end": 544.5,
   "text": "نقل دارم بیان می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 544.5,
   "end": 548.66,
   "text": "در حقیقت از کتاب ایشون میگم بعضی از مطالب رو نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 548.66,
   "end": 552.06,
   "text": "خودش صراحتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 552.06,
   "end": 560.44,
   "text": "ابن اثیر تو تاریخ کتاب تاریخیش میگه که من بعضی از مطالبی که ابوجعفر نقل میکنه رو نقل نمیکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 560.44,
   "end": 564.38,
   "text": "بعد ایشون حضرت علامه اشاره می‌کنند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 564.38,
   "end": 566.86,
   "text": "کتاب فتوحات حضرت محی الدین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 566.86,
   "end": 574.32,
   "text": "و جالبه که در نکته ششصد و دو هزار و یک نکته شون هم کتاب شریف هزار و یک نکته شون هم اونجا مفصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 574.32,
   "end": 576.3,
   "text": "علامه بحث کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 576.3,
   "end": 578.48,
   "text": "پیرامون همین قصه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 578.48,
   "end": 581.92,
   "text": "یکی ایشون می فرمایند یکی از نشانه‌های بارز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 581.92,
   "end": 585.18,
   "text": "کلمه بارز رو دقت کنید یعنی آشکار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 585.18,
   "end": 588.42,
   "text": "یکی از نشانه‌های بارز تحریف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 588.42,
   "end": 596.24,
   "text": "تحریف همین آثار حضرت محی الدین این است که باب سیصد و شصت و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 596.24,
   "end": 602.46,
   "text": "در که درباره حضرت قائم آل محمد صلی الله علیه و آله وسلم است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 602.46,
   "end": 604.94,
   "text": "جالبه که ابوالفضائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 604.94,
   "end": 610.86,
   "text": "شیخ بهائی در شرح حدیث سی و شش کتاب اربعینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 610.86,
   "end": 613.9,
   "text": "اونجا آورده این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 613.9,
   "end": 617.48,
   "text": "مطلب رو این مطالب رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 617.48,
   "end": 621.94,
   "text": "در حقیقت شیخ اکبر در فتوحاتش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 621.94,
   "end": 626.16,
   "text": "اما در چاپ‌های بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 626.16,
   "end": 632.2,
   "text": "اون وقتی اجداد امام عصر صلوات الله علیه رو میشمردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 632.2,
   "end": 635.76,
   "text": "بعضی جاها کلاً اجداد رو حذف می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 635.76,
   "end": 640.86,
   "text": "تو همون کتاب فتوحات و بعضی جاها هم اسناد میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 640.86,
   "end": 643.9,
   "text": "حضرت صاحب الأمر رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 643.9,
   "end": 645.98,
   "text": "پدرشون به نام حسن. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 645.98,
   "end": 649.26,
   "text": "حسین رو تحریف می‌کنند به حسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 649.26,
   "end": 653.62,
   "text": "اینو خود حضرت علامه اسناد میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 653.62,
   "end": 660.94,
   "text": "به این مسئله. بعد جالبه که باز به همین علی غواقیط و جواهر صفحه صد و چهل و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 660.94,
   "end": 666.6,
   "text": "شیخ عبدالوهاب شهرانی هم البته جلد دو علی غواقیط و جواهرش اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 666.6,
   "end": 669.66,
   "text": "باز علامه حسن زاده استناد به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 669.66,
   "end": 673.94,
   "text": "فرمایش شیخ عبدالوهاب هم می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 673.94,
   "end": 678.56,
   "text": "که می فرماید که عبارت شیخ رو آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 678.56,
   "end": 682.82,
   "text": "همون عبارتی که من براتون ترجمه کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 682.82,
   "end": 685.72,
   "text": "که بعد اجداد امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 685.72,
   "end": 691.64,
   "text": "عصر صلوات الله علیه رو میشمره تا میرسونه به امام علی ابن ابی طالب، امام، امام علی ابن ابی طالب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 691.64,
   "end": 696.68,
   "text": "می فرماید این بعد اجداد ایشون بعداً حذف شده که اینو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 696.68,
   "end": 700.96,
   "text": "یعنی حضرت علامه داره می فرماید که شیخ عبدالوهاب شهرانی در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 700.96,
   "end": 706.92,
   "text": "علی غواقیطش یعنی ایشون هم بهش اشاره می‌کنند به این نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 706.92,
   "end": 710.12,
   "text": "و عرض شود خدمت شما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 710.12,
   "end": 716.2,
   "text": "جالبه که باز حضرت علامه توصیه می‌کنند که توجه داشته باشید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 716.2,
   "end": 720.26,
   "text": "شیخ خود شیخ محی الدین، شیخ اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 720.26,
   "end": 726.14,
   "text": "در چند جای فتوحاتشون تصریح کردند یعنی صراحتاً بیان کردند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 726.14,
   "end": 731.86,
   "text": "ایشون چند بار خدمت حضرت امام قائم صلوات الله علیه رسیدن شرف یاب شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 731.86,
   "end": 734.24,
   "text": "باز کلمه امام رو میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 734.24,
   "end": 739.46,
   "text": "جالب اینجاست که باز یه رساله‌ای دارن خوبه شما اینو دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 739.46,
   "end": 747.34,
   "text": "رساله بسیار عجیب و سنگین و بنده حقیر ندیدم کمتر اندیشمندی رو دیدم چنین جملات سنگینی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 747.34,
   "end": 750.86,
   "text": "و با عظمتی رو پیرامون حضرت صاحب الامر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 750.86,
   "end": 754.36,
   "text": "بیان کنه. جالب که حضرت علامه حسن زاده هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 754.36,
   "end": 759.1,
   "text": "تشویق می‌کنن ما رو به توجه به همین رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 759.1,
   "end": 761.82,
   "text": "که در حقیقت میخوان ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 761.82,
   "end": 764.8,
   "text": "اثبات کنن که آثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 764.8,
   "end": 770.08,
   "text": "شیخ اکبر محی الدین عربی قطعاً تحریف شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 770.08,
   "end": 773.6,
   "text": "که اشاره می‌کنم به چی؟ رساله شق الجیب ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 773.6,
   "end": 775.72,
   "text": "شق الجیب یه رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 775.72,
   "end": 779.98,
   "text": "خیلی شیرین و عرشی و سنگین از شیخ اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 779.98,
   "end": 785.68,
   "text": "که در حقیقت پیرامون حضرت صاحب الامر نوشته شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 785.68,
   "end": 787.82,
   "text": "و حضرت رو معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 787.82,
   "end": 792.1,
   "text": "عرض کردم جملات بسیار عرشی زیبا خوب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 792.1,
   "end": 794.56,
   "text": "اصلاً محال ممکنه تا کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 794.56,
   "end": 800.38,
   "text": "پذیرش ولایت کلیه الهیه رو نکرده باشه بتونه این‌ها رو بیان کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 800.38,
   "end": 806.72,
   "text": "به هر حال کم نیستن آدم‌هایی مثل شیخ بهائی بزرگ که معتقد باشن با ادله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 806.72,
   "end": 809.7,
   "text": "قطعیه که امثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 809.7,
   "end": 813.76,
   "text": "شیخ امثال شیخ اکبرها و محی الدین‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 813.76,
   "end": 816.82,
   "text": "هم تقیه کردن و هم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 816.82,
   "end": 821.22,
   "text": "در حقیقت آثارشون به تحریف کشیده شده متأسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 821.22,
   "end": 825.02,
   "text": "حتی شیخ عبدالوهاب شهرانی اینم خوبه شما بدونید که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 825.02,
   "end": 829.96,
   "text": "خودشان می فرمایند که می‌نویسن که در صدد وقتی در صدد تلخیص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 829.96,
   "end": 835.06,
   "text": "فتوحات برآمدم میگه اونجا با عباراتی مواجه شدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 835.06,
   "end": 841.9,
   "text": "که به گمان من با عقاید مسلم کافه مسلمین تعارض داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 841.9,
   "end": 848.3,
   "text": "بعد میگه که من رفتم پیش شیخ شمس الدین که متوفی 955 بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 848.3,
   "end": 851.96,
   "text": "که ایشون ظاهراً نسخه‌هایی از فتوحات رو به دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 851.96,
   "end": 854.3,
   "text": "خط خودش نوشته بوده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 854.3,
   "end": 857.74,
   "text": "بعد با نسخه مؤلف در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 857.74,
   "end": 861.06,
   "text": "قونیه میگه مقابله کرده بود این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 861.06,
   "end": 864.48,
   "text": "یعنی نسخه به نسخه به نسخه این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 864.48,
   "end": 868.14,
   "text": "ااا متوجه شده بود و با هم تطابق داده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 868.14,
   "end": 871.94,
   "text": "در میان گذاشتم با شیخ شمس الدین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 871.94,
   "end": 874.24,
   "text": "این مطالبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 874.24,
   "end": 878.18,
   "text": "واقعاً با عقاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 878.18,
   "end": 881.06,
   "text": "مسلمونا به هیچ عنوان سازگاری نداشت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 881.06,
   "end": 886.06,
   "text": "بعد می فرماید که متوجه شدم دریافتم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 886.06,
   "end": 888.48,
   "text": "در حقیقت این‌ها هیچ کدومش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 888.48,
   "end": 893.16,
   "text": "تو اون نسخه‌های قبلی نبوده و بعداً اضافه شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 893.16,
   "end": 900.46,
   "text": "به فتوحات شیخ اکبر که البته فسوس الحکم ایشون هم متأسفانه دچار این مسائل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 900.46,
   "end": 909.42,
   "text": "و الحمد لله بزرگانی جامع الاطرافی مثل حضرت علامه خدا حفظشون کنه متوجه این قصه بودند و ما رو متوجه کردند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 909.42,
   "end": 913.64,
   "text": "متأسفانه این شکاف‌ها و این مسائلی که پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 913.64,
   "end": 916.44,
   "text": "خیلی ما را عقب انداخته. خیلی ما رو معطل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 916.44,
   "end": 921.0,
   "text": "جوامع علمی ما رو که باید بشینن سر سفره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 921.0,
   "end": 923.68,
   "text": "علمی و معرفتی این بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 923.68,
   "end": 930.26,
   "text": "اهل معرفت ما این‌ها رو متأسفانه از حقیقت باز نگه داشته و مشغول به این دعواها کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 930.26,
   "end": 932.8,
   "text": "والا نمیشه یعنی اساساً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 932.8,
   "end": 936.94,
   "text": "نمیشه تا کسی در مسیر ولایت نباشه نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 936.94,
   "end": 940.68,
   "text": "نمی‌تونه چنین چشیده‌هایی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 940.68,
   "end": 943.38,
   "text": "نمی‌تونه چنین، چنین در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 943.38,
   "end": 947.18,
   "text": "برداشت‌های عمیقی از معارف داشته باشه و بیان کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 947.18,
   "end": 950.74,
   "text": "نمیشه اصلاً محاله. قطعاً در مسیر ولایت بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 950.74,
   "end": 955.48,
   "text": "بسیاری از بزرگان که حرفی برای گفتن دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 955.48,
   "end": 957.56,
   "text": "و متأسفانه انگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 957.56,
   "end": 961.64,
   "text": "سنی بودن یا در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 961.64,
   "end": 967.72,
   "text": "حداقل مخالف با ائمه اثنی عشری بهشون زده میشه اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 967.72,
   "end": 972.44,
   "text": "دشمنی شده باهاشون تحریف صورت گرفته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 972.44,
   "end": 974.5,
   "text": "ما رو متأسفانه از حقیقت دور کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 974.5,
   "end": 978.8,
   "text": "ضمن اینکه عزیزانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 978.8,
   "end": 982.82,
   "text": "دوست دارن متوجه بشن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 982.82,
   "end": 986.24,
   "text": "مثلاً واقعاً این استنباط‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 986.24,
   "end": 991.22,
   "text": "درونی و القاءاتی که یا الهاماتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 991.22,
   "end": 994.68,
   "text": "یا انباء اون در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 994.68,
   "end": 998.8,
   "text": "نب يعني خبر دیگه. نابع یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 998.8,
   "end": 1000.78,
   "text": "خبردار. نبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1000.78,
   "end": 1003.94,
   "text": "صفت مشبهه به شدت یا اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1003.94,
   "end": 1008.28,
   "text": "خبر در ذات وجودش مستکن شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1008.28,
   "end": 1010.76,
   "text": "این‌ها، این‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1010.76,
   "end": 1018.24,
   "text": "در حقیقت این عرفای ما خبرهایی که میگیرن، الهاماتی که بهشون صورت میگیره، القائات اینا از عالم بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1018.24,
   "end": 1020.96,
   "text": "و مردد هستند که آیا این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1020.96,
   "end": 1025.08,
   "text": "واقعاً مطابق با واقع هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1025.08,
   "end": 1028.94,
   "text": "اولاً بزرگان اهل معرفت امثال حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1028.94,
   "end": 1031.8,
   "text": "در این خصوص مطالب بسیار شمندی رو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1031.8,
   "end": 1039.04,
   "text": "یعنی اگر توجه بشه به آثار این بزرگان جواب‌های بسیار مطمئن و محکمی گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1039.04,
   "end": 1043.18,
   "text": "انسان می‌آرمد و نمی‌هراسد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1043.18,
   "end": 1047.34,
   "text": "با خیال راحت از آثار این عزیزان استفاده میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1047.34,
   "end": 1053.4,
   "text": "که و ثانیاً هم یک صوتی قبلاً در همین سؤال در جواب پاسخ به این سؤال ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1053.4,
   "end": 1060.98,
   "text": "ارائه داده بودیم. عزیزان پرسیده بودند ضبط کردم گمان کنم در کانال بارگذاری کرده باشن دوستان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1060.98,
   "end": 1063.44,
   "text": "تمام آنچه که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1063.44,
   "end": 1066.32,
   "text": "حکمت متعالیه در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1066.32,
   "end": 1070.7,
   "text": "در عرفان و حکمت و فلسفه بیان شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1070.7,
   "end": 1073.8,
   "text": "از همون عبارات ابتدایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1073.8,
   "end": 1077.22,
   "text": "مبانی‌شون، عناوین‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1077.22,
   "end": 1083.7,
   "text": "حتی لفظهایی که به کار برده شده، تعاریف، مفاهیم اینا همه و همه بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1083.7,
   "end": 1088.14,
   "text": "آیات و روایات و فرمایشات معصومین علیهم الصلاة والسلام هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1088.14,
   "end": 1090.5,
   "text": "که این‌ها رو می‌تونید رجوع کنید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1090.5,
   "end": 1094.92,
   "text": "نترسید و انشاالله نسبت به سعی وجودیتون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1094.92,
   "end": 1098.8,
   "text": "حوض پر از آب گوارا و شراب طهورای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1098.8,
   "end": 1101.8,
   "text": "عرفان و برهان و قرآنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1101.8,
   "end": 1108.74,
   "text": "القا شده به وجود عرفا و بزرگانمون امثال شیخ الرئیس‌ها، ملاصدراها، محقق حلی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1108.74,
   "end": 1111.32,
   "text": "مجمرلآددی سبزواری‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1111.32,
   "end": 1114.64,
   "text": "الحمد لله در معاصر ما علامه حسن زاده‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1114.64,
   "end": 1118.08,
   "text": "سیراب بشید و خدا را شاکر باشیم هممون انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1118.08,
   "end": 1119.96,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}