 "chapters": [
  {
   "index": 0,
   "title": "### فقدان منبع معتبر",
   "start": 0.28,
   "end": 82.06
  },
  {
   "index": 1,
   "title": "### ادعیهٔ معتبر و آثارشان",
   "start": 82.06,
   "end": 155.12
  },
  {
   "index": 2,
   "title": "### تأکید آیت‌الله بهجت بر مفاتیح",
   "start": 155.12,
   "end": 189.74
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 4.74,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.74,
   "end": 7.82,
   "text": "المستغاث بک یا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.82,
   "end": 10.72,
   "text": "عزیزی پرسیدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.72,
   "end": 15.7,
   "text": "آیا دعای مثلا اکاشه یا بعضیا اوکاشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.7,
   "end": 18.6,
   "text": "تلفظ می‌کنند این‌ها درست هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.6,
   "end": 21.26,
   "text": "منبعی دارد؟ یا مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.26,
   "end": 24.04,
   "text": "هفت هیکل، چهل کلید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.04,
   "end": 31.74,
   "text": "حزب البحر، صنم قریش این‌ها که متأسفانه این‌ها تو فضای مجازی هم خیلی دیده میشه که پخش میشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.74,
   "end": 35.56,
   "text": "با چه آب و تابی. این‌ها رو خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.56,
   "end": 40.22,
   "text": "عزیزان باید بدونن مستحضر باشن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.22,
   "end": 43.86,
   "text": "ما در هیچ کدوم از منابع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.86,
   "end": 50.18,
   "text": "معصوره از اهل بیت علیهم الصلاة والسلام و جوامع روایی معتبرمون ندیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.18,
   "end": 59.24,
   "text": "حتی اکاشه رو می‌گفتن در زاد المعاد مرحوم مجلسی علیه الرحمة هست اما اونجا هم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.24,
   "end": 64.56,
   "text": "و این‌ها حتی من دیدم که از دفتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.56,
   "end": 68.58,
   "text": "مثلا آقای مکارم هم استفتار شده بود در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.58,
   "end": 70.96,
   "text": "بعضی از این دعاها مثل صنم قریش اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.96,
   "end": 74.12,
   "text": "ایشون هم فرموده بودند منبعی ندارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.12,
   "end": 80.72,
   "text": "و معصوره از اهل بیت علیهم الصلاة والسلام نیستن این دعاها و پس بهتره که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.72,
   "end": 83.24,
   "text": "نخونه این‌ها رو. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.24,
   "end": 88.14,
   "text": "دعاهایی مثل مثلا صیفی صغیر چرا در مفاتیح آشیخ عباس قمی آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.14,
   "end": 92.32,
   "text": "خیلی دعای شریف، سنگین وزین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.32,
   "end": 97.24,
   "text": "پیرامون ادای دین و قرض و عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.24,
   "end": 100.14,
   "text": "و امان در امان موندن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.14,
   "end": 102.92,
   "text": "کید دشمن و اینا خیلی آثار و برکات دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.92,
   "end": 107.46,
   "text": "یا حرز یمانی مثلا حرز یمانی دعای حرز یمانی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.46,
   "end": 111.64,
   "text": "هم بهار اومده هم با مختصری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.64,
   "end": 119.24,
   "text": "فرق در بعضی از کلمات و الفاظ در محج الدعوات سید ابن طاووس هم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.24,
   "end": 122.74,
   "text": "حالا اونای دیگه بعضیا پرسیدن نه نیومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.74,
   "end": 126.98,
   "text": "بهتر اینه که انسان رجوع کنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.98,
   "end": 130.24,
   "text": "کتاب‌های ادعیه معتبر و حتی در میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.24,
   "end": 138.38,
   "text": "کتاب‌های معتبر ادعیه هم بهتر هستش که انسان رجوع کنه به اون دعا‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.38,
   "end": 140.68,
   "text": "در صاع وجودی او می‌گنجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.68,
   "end": 147.2,
   "text": "یعنی بعضی از دعاها هست مثل مثلا دعای صباح امیرالمؤمنین صلوات الله علیه ما رو هر کسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.2,
   "end": 153.5,
   "text": "اگر کسی اینو مداومت کنه یه عوارضی براش پیش میاد که کما این که بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.5,
   "end": 157.06,
   "text": "حتی فضلا این کارو کردن و علما و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.06,
   "end": 159.42,
   "text": "عوارض عجیبی دیدن. بعضی از دعاها اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.42,
   "end": 165.24,
   "text": "حالا خدا رحمت کنه آقای بهجت رو بارها ما عرض کردیم که ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.24,
   "end": 167.66,
   "text": "به ما خیلی تأکید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.66,
   "end": 175.74,
   "text": "مفاتیح کردن. فرمودن که آنچه که در مفاتیح آشیخ عباس قمی علیه الرحمة هست رو اکتفا کنید و همون‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.74,
   "end": 181.46,
   "text": "بخوانید و به امام عصر صلوات الله علیه هدیه بدید و هم محبت شما تو دل آقا زیاد میشه هم محبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.46,
   "end": 184.76,
   "text": "آقا تو دل شما و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.76,
   "end": 188.0,
   "text": "انشاالله که بخوانیم و همدیگر رو دعا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.0,
   "end": 189.74,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}