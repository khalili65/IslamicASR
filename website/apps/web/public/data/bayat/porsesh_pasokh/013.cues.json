 "chapters": [
  {
   "index": 0,
   "title": "## چگونه توجه از خود به خدا معطوف شود",
   "start": 9.92,
   "end": 56.7
  },
  {
   "index": 1,
   "title": "## ذکر تهلیل و سورهٔ توحید",
   "start": 56.7,
   "end": 160.22
  },
  {
   "index": 2,
   "title": "## آیهٔ هفتاد و ششِ نساء",
   "start": 160.22,
   "end": 271.4
  },
  {
   "index": 3,
   "title": "## ذکر میان دو فکر؛ توحید صمدی",
   "start": 271.4,
   "end": 358.56
  },
  {
   "index": 4,
   "title": "## سیر معرفت نفس",
   "start": 358.56,
   "end": 396.13
  },
  {
   "index": 5,
   "title": "صرفاً در الفاظ گیر نباید کرد؛ فهمیدن، چشیدن، رسیدن و دارا شدن — نه داناییِ صرف. دارا شدن کار ملکوت و نور است:",
   "start": 396.13,
   "end": 489.03
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.66,
   "end": 4.78,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.78,
   "end": 9.92,
   "text": "المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.92,
   "end": 15.08,
   "text": "پرسیده شده که ما چگونه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.08,
   "end": 19.54,
   "text": "توجه به خودمون فارغ بشیم و به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.54,
   "end": 24.34,
   "text": "توجهمون معطوف بشه به گونه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.34,
   "end": 27.44,
   "text": "هر اتفاقی برای ما می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.44,
   "end": 30.3,
   "text": "ابتدا به خدا توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.3,
   "end": 36.9,
   "text": "و ما معمولاً اینطوری گفتن که معمولاً وقتی اتفاق خیری می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.9,
   "end": 42.9,
   "text": "و یه حسنه خوبی برای ما پیش میاد سریع متوجه خودمون میشیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.9,
   "end": 49.9,
   "text": "ظاهراً دیگران اینطوری نیستن وقتی خیری براشون پیش میاد مثل یک جاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.9,
   "end": 55.9,
   "text": "یک طرفه سریع متوجه خدا میشن اما ما نتونستیم پا رو دل خودمون بگذاریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.9,
   "end": 60.86,
   "text": "و خوبی‌ها رو از خودمون می‌بینیم و از این قبیل صحبت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.86,
   "end": 64.16,
   "text": "ببینید عزیزان برای رسیدن به یه همچین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.16,
   "end": 66.9,
   "text": "مقامی که محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.9,
   "end": 70.1,
   "text": "قیام و قائم بودن است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.1,
   "end": 73.94,
   "text": "یک محلی است که دائم انسان در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.94,
   "end": 77.96,
   "text": "ثبوت داشته باشه، تثبت به خرج بده در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.96,
   "end": 81.5,
   "text": "و ثابت مقام و ثابت قدم باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.5,
   "end": 84.22,
   "text": "نه یک حالی باشد که برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.22,
   "end": 87.7,
   "text": "باید زحمت کشید، زمان گذاشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.7,
   "end": 95.0,
   "text": "و تلاش کرد، توسل کرد، مطالعه کرد، تحقیق کرد، ذکر گفت، توجه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.0,
   "end": 97.54,
   "text": "و خیلی باید زحمت کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.54,
   "end": 103.92,
   "text": "این رسیدن به یه همچین مقامی کار یکی دو شب و یکی دو ماه و یکی دو سال نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.92,
   "end": 109.38,
   "text": "نکته اول اینکه از کاری که برای رسیدن به این قبیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.38,
   "end": 117.92,
   "text": "حقایق انسان به حقیقت لا حول و لا قوه الا بالله العلی العظیم برسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.92,
   "end": 125.52,
   "text": "بهترین ذکری که متأسفانه غالباً هم ما ازش غافل هستیم ذکر شریف تحلیل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.52,
   "end": 127.72,
   "text": "همون لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.72,
   "end": 130.96,
   "text": "بدون عدد خاصی تا میشه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.96,
   "end": 134.72,
   "text": "برای اینکه برسه به یه همچین مقامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.72,
   "end": 138.42,
   "text": "این ذکر رو لبش رو تر نگه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.42,
   "end": 141.82,
   "text": "و البته خواندن سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.82,
   "end": 145.56,
   "text": "توحید، اسمش رو خودشه دیگه توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.56,
   "end": 153.38,
   "text": "قل هو الله احد با توجه خاصه در سعی کنه در همه نمازهاش، نافله‌هاش، واجباتش این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.38,
   "end": 159.3,
   "text": "این سوره رو قرائت کنه تصفیه درون رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 159.3,
   "end": 165.5,
   "text": "و البته توجه به آیه هفتاد و شش سوره نساء خیلی مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 165.5,
   "end": 170.38,
   "text": "که خیلی ترجمه زیبایی هم داره ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 170.38,
   "end": 176.2,
   "text": "خداي منّان در این آیه می‌فرماید که ما اصابك من حسنه فمن الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 176.2,
   "end": 184.2,
   "text": "هیچ حسنه ای به تو اصابت نمی‌کنه مگر اینکه مطلقاً من الله از خداست، از الله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 184.2,
   "end": 186.96,
   "text": "و ما اصابك من سيئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 186.96,
   "end": 192.74,
   "text": "فمن نفسك. هر بدی که به تو می‌رسه اصلاً این بدی اصابت نمی‌کنه مگر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 192.74,
   "end": 200.22,
   "text": "از نفس خودته. اینکه این رو انسان توجه کنه این آیه رو هر روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 200.22,
   "end": 205.46,
   "text": "دقت کنه بهش مداومت کنه بخوانه قرائت کنه این‌ها بهش فکر کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 205.46,
   "end": 209.84,
   "text": "در خلوتش خیلی می‌تونه مؤثر واقع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 209.84,
   "end": 215.96,
   "text": "و این یک گیر بزرگیه که ماها معمولاً در مسیر سیر و سلوکمون پیش میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 215.96,
   "end": 221.46,
   "text": "غره میشیم به خودمون و گمان می‌کنیم که خیرات، توفیقات اینا از ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 221.46,
   "end": 227.26,
   "text": "در حالی که هندسه توفیقات از بالا به پایینه، نه از پایین به بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 227.26,
   "end": 231.44,
   "text": "اتفاقاً یکی از اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 231.44,
   "end": 238.72,
   "text": "شکنندگی‌های مصائب و مشکلات و سختی‌هایی که در مسیر اهل ایمان معمولاً و غالباً پیش میاد همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 238.72,
   "end": 247.52,
   "text": "برای اینکه انسان متوجه به مبدع بشود و توجهش از خویشتن خویش برداشته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 247.52,
   "end": 250.56,
   "text": "انا لله و انا الیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 250.56,
   "end": 253.1,
   "text": "این الیه بر می‌گرده به الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 253.1,
   "end": 257.46,
   "text": "راجعون. این اگر جا افتاد قص--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 257.46,
   "end": 263.48,
   "text": "یعنی کار تمامه و اگر کسی برسه به حقیقت لا حول و لا قوه الا بالله کار تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 263.48,
   "end": 267.0,
   "text": "این در بحث حالا ذکر و آیات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 267.0,
   "end": 268.92,
   "text": "توجه به معارف اینا ول--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 268.92,
   "end": 271.4,
   "text": "لکن به نظر می‌رسد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 271.4,
   "end": 276.36,
   "text": "با توجه به آیه صد و نود و صد و نود و یک آل عمران که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 276.36,
   "end": 281.8,
   "text": "ذکر رو بین دو فکر قرار می‌ده که قبلاً ما صحبت کردیم در رابطه باهاش و از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 281.8,
   "end": 285.16,
   "text": "علامه حسن زاده هم خیلی تأکید به این قصه دارن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 285.16,
   "end": 289.94,
   "text": "اول اهل فکر بشید ذکر در پی خودش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 289.94,
   "end": 293.66,
   "text": "تا اینکه بخواید بس بسی باشید هی تسبیح دستتون بگیرید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 293.66,
   "end": 296.1,
   "text": "ذکر با کلام و صوت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 296.1,
   "end": 299.14,
   "text": "تکان خوردن لب بگید و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 299.14,
   "end": 302.72,
   "text": "و گمان کنید که به حقیقت ذکر رسیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 302.72,
   "end": 308.78,
   "text": "نه، وقتی اهل تفکر باشید نه فقط به ذکر بلکه به ذکر می‌رسید یعنی به حقیقت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 308.78,
   "end": 315.06,
   "text": "به حق و حق ذکر. و همیشه میگه خوشا آنان که دائم در نمازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 315.06,
   "end": 317.4,
   "text": "دیگه دائمی میشه این قصه. باید تلاش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 317.4,
   "end": 320.78,
   "text": "برای همین به نظر می‌رسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 320.78,
   "end": 328.14,
   "text": "یکی در خصوص توحید صمدی قرآن که از ابتکارات از علامه حسن زاده هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 328.14,
   "end": 332.44,
   "text": "این استاد عظیم الشأن. در این مورد خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 332.44,
   "end": 337.48,
   "text": "تحقیق کنید، تفحص کنید، مطالعه کنید، حرف بشنوید، حرف‌های علامه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 337.48,
   "end": 339.48,
   "text": "که به جان انسان می‌شنوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 339.48,
   "end": 348.36,
   "text": "سرچ کنید پیدا کنید یا شاگردان مبرز ایشون رو که پیرامون توحید صمدی زیان-- زیاد سخن گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 348.36,
   "end": 352.76,
   "text": "و عرض شود خدمتتون که اگر توحید صمدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 352.76,
   "end": 358.46,
   "text": "جا بیفته باز همه این مطالبی که من عرض کردم در دلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 358.46,
   "end": 361.64,
   "text": "و نکته پایانی اینکه سیر معرفت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 361.64,
   "end": 364.43,
   "text": "تا کسی خودش رو نشناسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 364.43,
   "end": 369.61,
   "text": "به قول علامه خدا رو هم درست نشناخته، قیامت رو هم معاد رو هم درست نشناخته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 369.61,
   "end": 373.29,
   "text": "پیغمبر و رسالت و امامت و ولایت و این‌ها رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 373.29,
   "end": 378.89,
   "text": "درست نشناخته. با سیر معرفت نفس که همیشه مورد تأکید حقیر بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 378.89,
   "end": 382.61,
   "text": "اون کتاب سه جلدی حداقل سه جلدی علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 382.61,
   "end": 391.97,
   "text": "که صد و پنجاه و سه درس درش هست بر معرفت نفس و در یک مجلد اخیراً چاپ شده اونو بخونه تک به تک درس‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 391.97,
   "end": 401.27,
   "text": "و اگر شرح قابلی پیدا کرد البته بعضی از مطالب خیلی قامض و پیچیده است یا اگر سهل درون مایه عجیبی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 401.27,
   "end": 406.47,
   "text": "این‌ها رو بررسی کنه. یواش یواش این‌ها در جانش پیاده میشه این حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 406.47,
   "end": 408.35,
   "text": "اینا مال یک شب و دو شب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 408.35,
   "end": 412.39,
   "text": "باید تمرین کنه، بسوزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 412.39,
   "end": 414.11,
   "text": "سوز و گداز داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 414.11,
   "end": 419.99,
   "text": "این آتش درون رفته، رفته، رفته، او رو به جایی می‌رسونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 419.99,
   "end": 425.55,
   "text": "اصلاً چیزی جز حق و خدا نمی‌بینه که \"سنریهم آیاتنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 425.55,
   "end": 429.19,
   "text": "في الآفاق وفي أنفسهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 429.19,
   "end": 431.77,
   "text": "حتى يتبين لهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 431.77,
   "end": 434.53,
   "text": "أنه الحق\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 434.53,
   "end": 436.39,
   "text": "همه چیز رو حق می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 436.39,
   "end": 439.09,
   "text": "این هم آیه قرآن بود. انشاالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 439.09,
   "end": 441.61,
   "text": "خدای منان ما رو به این حقایق برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 441.61,
   "end": 444.43,
   "text": "صرفاً در الفاظ گیر نکنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 444.43,
   "end": 448.99,
   "text": "به حقیقتش به باطنش انشاالله خودش ما رو برسونه که فهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 448.99,
   "end": 453.73,
   "text": "فهمیدن، چشیدن، رسیدن و دارا شدن، نه دانایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 453.73,
   "end": 457.55,
   "text": "دارا شدن کار ملکوت نظام هستی، نوره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 457.55,
   "end": 460.15,
   "text": "\"الله نور السماوات والأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 460.15,
   "end": 463.69,
   "text": "\"العلم نور يلقفه الله في قلب من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 463.69,
   "end": 469.71,
   "text": "يشاء\". اینکه خدا بفهماند این رو توسل کنیم به امام عصر به عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 469.71,
   "end": 477.11,
   "text": "آل محمد صلى الله عليه وآله وسلم که آقامون علی بن موسی الرضا صلوات الله عليه هست توسل کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 477.11,
   "end": 479.49,
   "text": "که حضرت به ما بچشاند این حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 479.49,
   "end": 484.67,
   "text": "کی ضریح امام رضا رو بغل کردیم اشک ریختیم برای فهمیدن این حقایق و معارف؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 484.67,
   "end": 489.03,
   "text": "کی؟ والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}