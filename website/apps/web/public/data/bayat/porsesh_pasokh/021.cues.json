 },
 "chapters": [
  {
   "index": 0,
   "title": "## خضوع و خشوع در افقِ صحیفهٔ سجّادیّه",
   "start": 0.9,
   "end": 40.64
  },
  {
   "index": 1,
   "title": "## آیهٔ خشوعِ قلوب",
   "start": 40.64,
   "end": 141.34
  },
  {
   "index": 2,
   "title": "## ظاهر و باطن؛ اصلِ فلسفی",
   "start": 141.34,
   "end": 174.8
  },
  {
   "index": 3,
   "title": "## ادبِ ظاهر؛ یادِ حضرت زهرا",
   "start": 174.8,
   "end": 229.24
  },
  {
   "index": 4,
   "title": "## طهارت و ادب؛ رسالتِ انبیا",
   "start": 229.24,
   "end": 291.68
  },
  {
   "index": 5,
   "title": "## جداییِ خضوع و خشوع؛ افتادن از چشمِ خدا",
   "start": 291.68,
   "end": 398.4
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.9,
   "end": 9.52,
   "text": "اما در خصوص سؤال دیگری یاش بشه شاید گفت آخرین سوالی که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.52,
   "end": 17.06,
   "text": "تحقیق در صحیفه سجادیه قربونش بریم آقا امام سجاد صلوات الله علیه پرسیدن در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 17.06,
   "end": 21.7,
   "text": "خضوع و خشوع در برابر پروردگاره که اساساً معنای خضوع و خشوع چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 21.7,
   "end": 25.1,
   "text": "جایگاهش چیه و اینها نقششون در حل مشکلات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.1,
   "end": 30.86,
   "text": "ببینید عزیزان خضوع من به صورت کلی عرض کنم تحقیقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.86,
   "end": 35.08,
   "text": "که خضوع به مقام ظاهر برمی‌گرده به رتبه ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 35.08,
   "end": 38.54,
   "text": "خشوع به باطن. حالا معانه معانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.54,
   "end": 46.48,
   "text": "متعددی کردن اما ظاهراً این از همه کامل‌تره که مثلاً وقتی به نماز می‌ایستی همین که اعضای بدنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 46.48,
   "end": 50.66,
   "text": "مؤدب در برابر حضرت حق ایستادن به این می‌گن خضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.66,
   "end": 53.8,
   "text": "خضوع به مرتبه با-- ظاهر میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.8,
   "end": 56.2,
   "text": "خشوع مرتبه باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.2,
   "end": 58.7,
   "text": "یعنی باطنت هم متوجه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.7,
   "end": 62.28,
   "text": "آیه شونزده سوره حدید که می‌فرماید \"أَلَمْ يَأْنِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.28,
   "end": 69.68,
   "text": "لِلَّذِينَ آمَنُوا أَنْ تَخْشَعَ قُلُوبُهُمْ لَذِكْرِ اللَّهِ\" آیا وقت اون نرسیده اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.68,
   "end": 73.48,
   "text": "ایمان آوردن، ا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.48,
   "end": 75.94,
   "text": "قلبشون رو خاشع کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.94,
   "end": 79.92,
   "text": "با ذکر خدا؟ این نشون میده که ذکر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.92,
   "end": 83.28,
   "text": "قلب رو خواهش-- خاشع می‌کنه اولاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.28,
   "end": 86.76,
   "text": "ثانیاً \"أَنْ تَخْشَعَ قُلُوبُهُمْ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.76,
   "end": 89.7,
   "text": "قلوب. قلب. اون مقام باطنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.7,
   "end": 94.68,
   "text": "نفس ناطقه است. یعنی در حقیقت خشوع برمی‌گرده به باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.68,
   "end": 97.04,
   "text": "که اگر هر کجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.04,
   "end": 101.96,
   "text": "تعادل بین خضوع و خشوع نباشد، دوگانگی، دو شخصیتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.96,
   "end": 106.6,
   "text": "تضاد، نفاق مخصوصاً العیاذ بالله نفاق ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.6,
   "end": 111.44,
   "text": "یعنی کسی بگه آقا دلت پاک باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.44,
   "end": 115.98,
   "text": "میوه بخور منبر بسوزان مردم آزاری نکن نمی‌دونم از این حرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.98,
   "end": 118.76,
   "text": "یا دلت پاک باشه هرچه خواهی بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.76,
   "end": 122.42,
   "text": "این حرفا چیه؟ دلت پاک باشه بعد ظاهرت با،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.42,
   "end": 125.94,
   "text": "با باطنت همخوانی نداشته باشه این می‌شه نفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.94,
   "end": 129.46,
   "text": "یا بالعکس. ظاهرت خوب باشه باطنت ناپاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.46,
   "end": 132.38,
   "text": "اینم می‌شه نفاق. باید هر دو رو کار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.38,
   "end": 134.98,
   "text": "نمی‌شه یکی رو از دیگری فارغ کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.98,
   "end": 141.34,
   "text": "مثل این‌که اساساً در دو اسم \"هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.34,
   "end": 143.98,
   "text": "اسم ظاهر و باطن خدا رو بخوای از هم جدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.98,
   "end": 149.88,
   "text": "اصلاً امکان نداره. امکان نداره چون ظاهر ظهور باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.88,
   "end": 152.52,
   "text": "اصلاً نمی‌شه جدا بشه از باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.52,
   "end": 157.26,
   "text": "و اساساً نمی‌شه چیزی باطن باشد و ظهور نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.26,
   "end": 160.42,
   "text": "نمی‌شه. این یه اصل فلسفی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.42,
   "end": 166.8,
   "text": "این دو باید با هم باشن و همیشه گرفتاری‌های ما جاییه که خضوع داریم خشوع نداریم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.8,
   "end": 170.28,
   "text": "یعنی ظاهر و باطن رو از هم منفک کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.28,
   "end": 173.14,
   "text": "طرف عاشق امام حسینه ولی ظاهرش نشون نمی‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.14,
   "end": 181.4,
   "text": "خب چرا نشون نمی‌ده؟ چرا حضرت زهرا صدیقه کبرا در اون چند شبی که به اتفاق امیرالمؤمنین و حسنین رفتن در خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.4,
   "end": 183.6,
   "text": "اعوان و انصار و عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.6,
   "end": 186.26,
   "text": "انصار و مهاجرین رو زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.26,
   "end": 189.04,
   "text": "که فردا صبح بیایید محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.04,
   "end": 192.64,
   "text": "امیرالمؤمنین ایشون رو یاری بدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.64,
   "end": 195.3,
   "text": "در حقیقت غصب خلافت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.3,
   "end": 198.28,
   "text": "که ار-- اشتباهه بگیم خلافت، غصب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.28,
   "end": 202.84,
   "text": "ریاست شده بود. ریاست ظاهری دنیوی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.84,
   "end": 208.92,
   "text": "خب چرا حضرت زهرا صلوات الله علیه و به تأکید امیرالمؤمنین فرمودند صبح سر تراشیده بیایید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.92,
   "end": 215.62,
   "text": "چرا؟ یعنی یه نشونه‌ای باشه باید یه نشانه‌ای باشه تو ظاهر شما که شما ولایتی هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.62,
   "end": 222.42,
   "text": "این خودش اسراره. یعنی نمی‌شه اساساً ظاهر و باطن از هم منفک بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.42,
   "end": 224.44,
   "text": "و اگر خدای نکرده این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.44,
   "end": 226.84,
   "text": "انفکاک صورت گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.84,
   "end": 229.08,
   "text": "بعد نفاق ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.08,
   "end": 233.46,
   "text": "و از سر تا سر آیات و روایات می‌بینیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.46,
   "end": 242.4,
   "text": "خدای منّان اساساً عاد-- خلاصه بگم همه فهم عرض کنم، خدا آدم بی‌ادب رو خیلی دوست-- ا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.4,
   "end": 246.46,
   "text": "نه، اصلاً و ابداً دوست نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.46,
   "end": 250.82,
   "text": "برعکس آدم باادب رو خدا خیلی دوست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.82,
   "end": 253.8,
   "text": "باادب پیش خدا خیلی عزیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.8,
   "end": 259.2,
   "text": "جالبه که البته علامه هم می‌فرمایند اصلاً ما دو تا کار بیشتر نداریم که پس انبیا هم برای همین اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.2,
   "end": 262.62,
   "text": "یکی طهارت، پاکی، تزکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.62,
   "end": 265.48,
   "text": "و \"یُزَكِّيهِمْ\". دیگری هم ادبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.48,
   "end": 267.92,
   "text": "ادب آموزی. آداب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 267.92,
   "end": 272.5,
   "text": "\"لِیُعَلِّمَهُمُ الْكِتَابَ وَالْحِكْمَةَ\" همون بحث تعلیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.5,
   "end": 275.26,
   "text": "تأدیبه. ادب آموزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.26,
   "end": 280.44,
   "text": "جالبه که پیغمبر هم فرمودند که \"أَدَّبَنِي رَبِّي فَأَحْسَنَ تَأْدِيبِي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.44,
   "end": 285.12,
   "text": "خدا منو تأدیب کرد، ادبم کرد و چقدر زیبا و خوش تأد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.12,
   "end": 291.54,
   "text": "تأدیبم کرد. با ادب. این ادب آموزی یعنی همون ظاهر و باطن یکی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 291.54,
   "end": 295.26,
   "text": "که اگر نباشه بعد اون موقع مشکلات ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.26,
   "end": 297.54,
   "text": "خدا نکنه کسی از چشم خدا بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.54,
   "end": 301.38,
   "text": "از چشم خدا که بیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.38,
   "end": 304.5,
   "text": "در حقیقت مشکل پشت، پشت مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 304.5,
   "end": 306.74,
   "text": "یعنی از مسیر تقوا خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.74,
   "end": 310.48,
   "text": "وقتی از مسیر تقوا خارج شد، اون موقع تو بن‌بست‌ها گیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.48,
   "end": 312.76,
   "text": "خروج از بن‌بست رخ نمی‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.76,
   "end": 317.4,
   "text": "رزقش هر چقدر هم پول، دارایی‌ش اینا زیاد باشه باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.4,
   "end": 320.64,
   "text": "دچار زیقه، فشاره، دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.64,
   "end": 325.98,
   "text": "مشکلاته. میبینی خیلی هم وضع مالیش خوبه اما اصلاً آرامش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 325.98,
   "end": 332.8,
   "text": "این خضوع و خشوع چنان در هم تنیده‌اند که نمی‌تونی اصلاً اینا رو در حقیقت از هم جدا بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.8,
   "end": 335.32,
   "text": "شاید در اعتباریات چرا بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.32,
   "end": 338.0,
   "text": "اما در حقیقت مطلقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.0,
   "end": 343.98,
   "text": "مثلاً یه دکتری که در حقیقت می‌شه گفت ا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.98,
   "end": 346.58,
   "text": "رفته درس دکتری خونده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.58,
   "end": 350.1,
   "text": "ظاهراً لباس دکتری پوشیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 350.1,
   "end": 356.08,
   "text": "و می‌گه که آقا من پزشکم بدید نسخه براتون بنویسم اما می‌بینی خودش رعایت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 356.08,
   "end": 360.02,
   "text": "سیگار می‌کشه. اینا. خب این در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.02,
   "end": 363.64,
   "text": "باطناً اساساً پزشک نیست، طبیب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 363.64,
   "end": 365.96,
   "text": "اگرچه لباس و رخت پزشک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.96,
   "end": 373.0,
   "text": "کی تنش کرده. یا یک آخوندی رو، عالمی رو در نظر بگیرید که لباس پیغمبر تنش کرده، اصلاً عمل نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.0,
   "end": 375.9,
   "text": "اونچه که می‌گه. خب اینا در تضاده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.9,
   "end": 380.6,
   "text": "از چشم مردم هم می‌افتند چه برسه به چشم، از چشم خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.6,
   "end": 386.34,
   "text": "به هر حال خلاصه عرض کنیم که اگر خضوع و خشوع از هم جدا شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.34,
   "end": 390.64,
   "text": "انسان از چشم خدا می‌افته و مشکلات پشت مشکلات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.64,
   "end": 393.46,
   "text": "چه در دنیا و چه در آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.46,
   "end": 396.42,
   "text": "خدا هممون رو حفظ کنه انشاالله از نفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.42,
   "end": 398.4,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}