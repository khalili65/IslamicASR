 "chapters": [
  {
   "index": 0,
   "title": "## دیدن اموات در خواب؛ منابع و دستور سبک",
   "start": 1.0,
   "end": 123.04
  },
  {
   "index": 1,
   "title": "## دعای پس از سوره‌ها؛ ادب بسم الله",
   "start": 123.04,
   "end": 266.28
  },
  {
   "index": 2,
   "title": "## دستور فرج و مخرج؛ هفت شب",
   "start": 266.28,
   "end": 362.37
  },
  {
   "index": 3,
   "title": "## برزخ؛ استکمال نفوس ناقص",
   "start": 362.37,
   "end": 565.89
  },
  {
   "index": 4,
   "title": "## چرا اموات معمولاً به خواب نزدیکان نمی‌آیند",
   "start": 565.89,
   "end": 739.01
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.0,
   "end": 5.2,
   "text": "بسم الله و بالله و علی ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.2,
   "end": 8.66,
   "text": "المستغاث بکی یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.66,
   "end": 11.68,
   "text": "پرسیدن که آیا راهی وجود داره برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.68,
   "end": 17.66,
   "text": "اینکه ما امواتمون و گذشته‌گانمون این‌ها رو در خواب ببینیم، با اون‌ها ارتباط بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.66,
   "end": 21.5,
   "text": "اولا عرض کنم که بله در کتاب‌هایی مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.5,
   "end": 26.22,
   "text": "مصباح مرحوم کفعمی علیه الرحمه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.22,
   "end": 29.54,
   "text": "کتاب خلاصة الأفكار مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.54,
   "end": 35.22,
   "text": "محدث فیض این‌ها یا مثلاً کتاب آدام الحمیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.22,
   "end": 37.98,
   "text": "از محمد بن طبری این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.98,
   "end": 40.04,
   "text": "روایات این چنینی اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.04,
   "end": 43.12,
   "text": "خود شیخ عباس قمی علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.12,
   "end": 47.4,
   "text": "در انتهای مفاتیح الجنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.4,
   "end": 51.84,
   "text": "یه چند تا دستور آوردن که البته اون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.84,
   "end": 56.3,
   "text": "در حقیقت میشه گفت سبک‌تره و راحت‌تره برای عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.3,
   "end": 58.14,
   "text": "به این صورت هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.14,
   "end": 64.84,
   "text": "اول فرمودن که برای دیدن مطلق حالا یا پیامبران یا ائمه علیهم الصلاة والسلام یا والدین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.84,
   "end": 68.16,
   "text": "خودمونی به هر حال هر کدوم از رفتگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.16,
   "end": 70.52,
   "text": "این‌ها رو بخوایم در خواب ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.52,
   "end": 74.8,
   "text": "با طهارت، با وضو و البته بستر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.8,
   "end": 79.38,
   "text": "پاک هم خیلی مهمه. فراش و لحاف و بستر پاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.38,
   "end": 82.42,
   "text": "بعد شروع می‌کنی این سوره‌ها رو یک بار می‌خونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.42,
   "end": 84.76,
   "text": "سوره الشمس، لیل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.76,
   "end": 87.88,
   "text": "قدر، کافرون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.88,
   "end": 94.22,
   "text": "اخلاص و مؤوّدتین که همون ناس و فلق هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.22,
   "end": 98.6,
   "text": "خب بعد دو مرتبه بعد از که این‌ها رو یک بار خوندی صد بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.6,
   "end": 104.62,
   "text": "سوره اخلاص رو می‌خونی که یک بارم البته سوره اخلاص تو اون دستور اول بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.62,
   "end": 108.96,
   "text": "بعد اینجا که رسیدی صد بار سوره اخلاص \"قل هو الله احد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.96,
   "end": 113.9,
   "text": "بعد صد مرتبه صلوات بر پیغمبر و آلش علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.9,
   "end": 117.24,
   "text": "بعد به جانب راست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.24,
   "end": 120.76,
   "text": "در بستر می‌خوابی. ان شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.76,
   "end": 123.04,
   "text": "فرمودن که می‌بینی اونچه که مد نظره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.04,
   "end": 128.12,
   "text": "حالا بعضی از نسخ این دعا رو هم بعد از این آیات و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.12,
   "end": 131.46,
   "text": "سور بیان کردن. من آروم می‌خونم اگه کسی خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.46,
   "end": 134.24,
   "text": "بخونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.24,
   "end": 138.18,
   "text": "البته عرض کنم دعاها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.18,
   "end": 141.76,
   "text": "دقت بفرمایید. من ندیدم هیچ کدوم از دعاهای معثور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.76,
   "end": 146.64,
   "text": "از اهل بیت علیهم الصلاة والسلام رو با بسم الله الرحمن الرحیم شروع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.64,
   "end": 152.4,
   "text": "اینم ادب مع الله اوناست چون خدای منّان سوره‌های قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.4,
   "end": 156.26,
   "text": "با بسم الله الرحمن الرحیم شروع کرده، اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.26,
   "end": 159.94,
   "text": "ادب کردن و این‌ها دیگه بسم الله الرحمن الرحیم نیاوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.94,
   "end": 163.68,
   "text": "این البته یک علتشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.68,
   "end": 168.42,
   "text": "و البته رجعاً اشکال نداره ابتدای دعاهای مر-معثور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.42,
   "end": 171.8,
   "text": "بسم الله الرحمن الرحیم بگی اما به قصد ورود نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.8,
   "end": 174.62,
   "text": "یعنی اینکه دستور امام معصوم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 174.62,
   "end": 180.94,
   "text": "نه، اونطوری نمیشه. این هم ادب اون‌هاست که معمولاً دعاهاشون با اللهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.94,
   "end": 183.22,
   "text": "الهی، ربه این‌ها شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.22,
   "end": 185.44,
   "text": "اینجا هم با اللهم شروع شده به این صورت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.44,
   "end": 193.68,
   "text": "دعای بعد از این سوره‌ها. اللهم انت الحي الذي لا یُصَفُ والإيمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.68,
   "end": 199.54,
   "text": "یُعرف منك بدت الأشیاء وإلیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.54,
   "end": 206.4,
   "text": "تعود فما أقبل منها كنت ملجأه ومنجاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.4,
   "end": 211.68,
   "text": "و ما أدبر منها لم یکن له ملجأ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.68,
   "end": 216.08,
   "text": "ولا منجى منك إلا إلک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.08,
   "end": 219.72,
   "text": "فأسألک بلا إله إلا أنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.72,
   "end": 223.62,
   "text": "وأسألک ببسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.62,
   "end": 228.42,
   "text": "و بحق حبیبک محمد صلی الله عليه وآله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.42,
   "end": 231.74,
   "text": "سید النبيين و بحق علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.74,
   "end": 238.1,
   "text": "خیر الوصیین و بحق فاطمة سیدة نساء العالمين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.1,
   "end": 240.8,
   "text": "و بحق الحسن والحسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.8,
   "end": 250.04,
   "text": "الذين جعلتهما سیّدی شباب أهل الجنّة عليهم أجمعین السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.04,
   "end": 253.9,
   "text": "أن تصلی على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.9,
   "end": 261.3,
   "text": "و أن ترینی میتی في الحال التي هو فيها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.3,
   "end": 265.0,
   "text": "بعد فرمودن که می‌خوابی و بعد از این دعا ان شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.0,
   "end": 270.0,
   "text": "می‌بینی. البته اگر کسی بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.0,
   "end": 277.02,
   "text": "امری رو در خواب براش باز کنن، موضوعی رو در خواب بهش بگن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 277.02,
   "end": 285.42,
   "text": "اینجا یک روایت دیگه‌ای داره که برای همین منظور در یک همونطور که عرض شد طهارت داشته باشه در یک لحاف و بستر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.42,
   "end": 288.88,
   "text": "پاک بخوابه و بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.88,
   "end": 291.62,
   "text": "البته نباید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.62,
   "end": 294.18,
   "text": "کنار همسرش باشه. اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.18,
   "end": 296.62,
   "text": "تنها باشه ترجیحاً و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 296.62,
   "end": 301.86,
   "text": "هفت مرتبه سوره الشمس رو و هفت مرتبه سوره لیل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.86,
   "end": 304.3,
   "text": "بخونه. سپس بگه الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.3,
   "end": 308.04,
   "text": "مجعل لی من امری هذا فرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 308.04,
   "end": 317.42,
   "text": "و مخرجا. حالا این دستورالعمل‌های این شکلی چندین نمونه هست که معمولاً البته این رو هم عرض کنم، توصیه شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.42,
   "end": 323.2,
   "text": "که بعضی در بعضی از نسخه‌ها فرمودن هفت شب پشت سر هم انجام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 323.2,
   "end": 328.28,
   "text": "در بعضی از نسخه‌ها فرمودن نه یک بار انجام بدید اما تا هفت شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 328.28,
   "end": 333.9,
   "text": "صبر کنید. اگه شب اول نشد دوم، سوم تا هفت شب هفتم ان شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 333.9,
   "end": 339.18,
   "text": "می‌بینید. این‌ها مجرب است اما خب شروطش همون طهارتیه که قید شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 339.18,
   "end": 342.14,
   "text": "یه دستور البته خیلی سنگین‌تری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 342.14,
   "end": 348.6,
   "text": "برای دیدن پیامبران و امامان به خصوص هست که خیلی هم مجرب اما چون خیلی سنگین هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 348.6,
   "end": 354.24,
   "text": "حدود هزار بار باید یکی از سوره‌های قرآن خونده بشه تقریباً چهار ساعت طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 354.24,
   "end": 358.6,
   "text": "اون دیگه خیلی عجیب غریب و خیلی مجرب، خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.6,
   "end": 362.37,
   "text": "به هر حال عرض شود خدمتتون این نکته اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 362.37,
   "end": 366.69,
   "text": "نکته دوم این که ما برای چی می‌خوایم مرتبط بشیم با امواتمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 366.69,
   "end": 371.53,
   "text": "ببینید یه وقت می‌خوایم مرتبط بشیم با ارواح بزرگان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 371.53,
   "end": 376.53,
   "text": "اهل بیت ببینیم، امامان ببینیم، در خواب قرآن ببینیم، اولیاء الهی ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 376.53,
   "end": 379.85,
   "text": "این بحثی درش نیست. خیلی هم شیرین و خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 379.85,
   "end": 386.33,
   "text": "اما اموات رو چرا؟ هیچ‌وقت فکر کردید که اساساً برزخ یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 386.33,
   "end": 390.95,
   "text": "برزخ که حد فاصله بین دنیا و آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 390.95,
   "end": 396.25,
   "text": "اساساً چرا ما می‌گیم برزخ که حد فاصله یا چرا بعضیا حدیث داریم برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 396.25,
   "end": 400.23,
   "text": "طولانی‌تری دارن بعضیا کمتر و بعضیا اصلاً برزخ ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 400.23,
   "end": 403.01,
   "text": "چرا؟ مگر یک امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 403.01,
   "end": 405.57,
   "text": "کلی نیست؟ یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 405.57,
   "end": 407.15,
   "text": "حقیقت واقع نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 407.15,
   "end": 411.53,
   "text": "چرا بعضیا دارن بعضیا ندارن، بعضیا کمتر و بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 411.53,
   "end": 414.93,
   "text": "اساساً برزخ علتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 414.93,
   "end": 420.55,
   "text": "اینه که اون سیر تکامل بر-- تکامل یا استکمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 420.55,
   "end": 423.09,
   "text": "سیر استکمالی نفس ناطقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 423.09,
   "end": 425.67,
   "text": "این لطف خداست که بعد از مرگ هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 425.67,
   "end": 427.27,
   "text": "ادامه پیدا کنه. برای کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 427.27,
   "end": 429.77,
   "text": "برای اونایی که کامل نشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 429.77,
   "end": 437.59,
   "text": "اون نفوس مستعدی که استعداد رو از دنیا با خودشون بردن، با گناه پی‌در‌پی و اصرار بر معصیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 437.59,
   "end": 441.35,
   "text": "استعداد رو نکشتن رو از بین نبردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 441.35,
   "end": 443.29,
   "text": "اما کامل نبودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 443.29,
   "end": 446.83,
   "text": "سیر استکمالی‌شون در برزخ ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 446.83,
   "end": 454.27,
   "text": "هر مقدار که این در حقیقت نقص‌شون در دنیا بیشتر بوده، برزخ‌شون بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 454.27,
   "end": 458.75,
   "text": "هر مقدار نقص‌شون کمتره، برزخ‌شون کمتره که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 458.75,
   "end": 461.17,
   "text": "که از نقص به سمت کمال برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 461.17,
   "end": 464.87,
   "text": "به یک معنا از الغه ها بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 464.87,
   "end": 469.69,
   "text": "در بحث قلب معروف چندین جلسه ما بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 469.69,
   "end": 473.67,
   "text": "خروج از عادت. اساساً مرگ یعنی همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 473.67,
   "end": 476.17,
   "text": "یعنی تکامل. مرگ یعنی تکامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 476.17,
   "end": 478.49,
   "text": "اما همون خروج از عادت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 478.49,
   "end": 484.41,
   "text": "خروج از عادت چیه؟ چون ما تدریجاً عالم رو درک کردیم از بچگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 484.41,
   "end": 489.21,
   "text": "تا سیر جمادی و نباتی و حیوانی و انسانیت‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 489.21,
   "end": 492.47,
   "text": "این هم چون تدریجاً بوده خو کرده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 492.47,
   "end": 496.09,
   "text": "لذا اون نگاه دفعی رو به قول استاد تعلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 496.09,
   "end": 500.37,
   "text": "حسن زاده حفظه الله تعالی نداشتیم به نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 500.37,
   "end": 502.15,
   "text": "لذا جلال رو درک نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 502.15,
   "end": 505.77,
   "text": "بیشتر با جمال همه چی خو گرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 505.77,
   "end": 510.07,
   "text": "و این خطرناکه. این باعث شده که ما تعلق خاطر پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 510.07,
   "end": 516.33,
   "text": "از جسم‌مون گرفته تا همسر و فرزندان و پدر و مادر و خواهر و برادر و عاطفه یک چیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 516.33,
   "end": 519.01,
   "text": "عاطفه رو که نمیشه از انسان گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 519.01,
   "end": 521.67,
   "text": "اما دلبستگی چیز دیگه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 521.67,
   "end": 529.15,
   "text": "این دلبستن‌ها که مخالف با زهده یا به عبارتی زهد مقابل دلبستنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 529.15,
   "end": 532.79,
   "text": "اینا مشکله. برزخ اومده که چه-- چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 532.79,
   "end": 535.87,
   "text": "ما رو خروج از عادت بده. ما رو از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 535.87,
   "end": 540.57,
   "text": "در حقیقت تعلق‌ها بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 540.57,
   "end": 545.31,
   "text": "که به قول قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 545.31,
   "end": 549.35,
   "text": "و إنا له راجعون به نحو احسن رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 549.35,
   "end": 553.53,
   "text": "که هر مقدار این نقص به سمت کمال رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 553.53,
   "end": 558.19,
   "text": "و این سیر استکمالی سنگین‌تر باشه عذابش هم سنگین تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 558.19,
   "end": 561.01,
   "text": "اساساً این تعبیر شده، این سختیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 561.01,
   "end": 565.89,
   "text": "تعبیر شده به چی؟ به عذاب برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 565.89,
   "end": 570.77,
   "text": "حالا شما هیچ‌وقت دقت کردید که چرا عزیزانمون معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 570.77,
   "end": 574.01,
   "text": "وقتی میان خبری می‌خوان به ما بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 574.01,
   "end": 578.49,
   "text": "اطلاعی، پیامی برای ما چیزی دارن معمولاً به خواب خود ما نمیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 578.49,
   "end": 580.75,
   "text": "کمتر اتفاق می‌افته که بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 580.75,
   "end": 584.75,
   "text": "مگر از اولیاء خدا باشن، از بزرگان و کمالین باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 584.75,
   "end": 587.13,
   "text": "که سیر استکمالی‌شون رو طی کرده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 587.13,
   "end": 591.23,
   "text": "چرا؟ چرا اونایی که نفوس ضعیف‌ن نمیان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 591.23,
   "end": 594.79,
   "text": "چرا عزیزان ما معمولاً به خواب ما نمیان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 594.79,
   "end": 598.45,
   "text": "و اگرم اون اوایل از دنیا رفتنشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 598.45,
   "end": 601.23,
   "text": "هر از چندگاهی بیان بعد رفته، رفته دیگه نمیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 601.23,
   "end": 605.43,
   "text": "چرا؟ چون دیگه تعلق‌شون از این دنیا کنده میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 605.43,
   "end": 609.41,
   "text": "و اصلاً اگر بیان به خواب ما به ضررشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 609.41,
   "end": 611.59,
   "text": "یعنی دوباره تعلق‌ها زنده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 611.59,
   "end": 613.45,
   "text": "وقتی میان به خواب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 613.45,
   "end": 619.79,
   "text": "مثل این که شما یه مدتی از یه کسی دوری وقتی به محض این که دیدیش دوباره اون خاطره‌ها و اینا زنده میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 619.79,
   "end": 622.99,
   "text": "تعلقات کار دستت میده. دوباره می مونی تو تعلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 622.99,
   "end": 625.23,
   "text": "دوباره می-می مونی در عادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 625.23,
   "end": 629.67,
   "text": "مگر عرض کردم کمال باشن، کامل باشن، سیر رو طی کرده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 629.67,
   "end": 637.99,
   "text": "در غیر این صورت برای همین. سرش در یکی از اسرارش در اینه که بزرگان-- اموات ما معمولاً برای ما پیام دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 637.99,
   "end": 643.21,
   "text": "میان به خواب دیگران، فامیل‌ها، همسایه ها، اینایی که اون‌ها خیلی بهشون تعلقی نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 643.21,
   "end": 646.37,
   "text": "میگن به فلانی، به پسرم، به خواهرم، به مادرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 646.37,
   "end": 649.61,
   "text": "اینا این خبرو بده به همسرم اینو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 649.61,
   "end": 653.25,
   "text": "حتی خیلی از مادران شهدا وقتی شهدا خواستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 653.25,
   "end": 657.43,
   "text": "پیغامی رو بهشون برسونن توسط دوستانشون، دیگران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 657.43,
   "end": 661.29,
   "text": "همسایه‌ها، فامیل‌ها و حتی غریبه‌ها پیام به مادرشون رسوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 661.29,
   "end": 664.45,
   "text": "چرا؟ اینا سر داره دیگه عزیزان رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 664.45,
   "end": 670.95,
   "text": "در حقیقت ما نباید راضی باشیم که اونا دوباره گرفتار تعلق بشن و سیر برزخی‌شون ادامه پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 670.95,
   "end": 675.77,
   "text": "اگر می‌خوایم ارتباطی بگیریم، موضوعی برای ما حل بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 675.77,
   "end": 679.01,
   "text": "مثل اللهم اجعل لي من امري",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 679.01,
   "end": 683.15,
   "text": "هذا فرجا و مخرجا بفهمیم چگونه فرج و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 683.15,
   "end": 686.29,
   "text": "خروجی در مشکلات برای ما ایجاد بشه و اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 686.29,
   "end": 694.45,
   "text": "ما دستور العمل‌هایی رو انجام بدیم که مرتبط بشیم با اولیاء خدا خصوصاً به پیغمبر عظیم الشأن اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 694.45,
   "end": 699.99,
   "text": "چقدر شیرین بود اما می‌شناختیم کسایی که حتی تو نوجوانی و جوانی‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 699.99,
   "end": 705.15,
   "text": "اون دستورالعمل سنگین رو هزار مرتبه سوره رو انجام دادن و پیامبر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 705.15,
   "end": 707.57,
   "text": "چندین بار دیدن. میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 707.57,
   "end": 711.89,
   "text": "راهش هست در هر حال. و همین دستوری هم که شیخ عباس در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 711.89,
   "end": 718.99,
   "text": "مفاتیح آورده به بنده عرض کردم برای دیدن پیامبران و امامان هم وارد شده است و کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 718.99,
   "end": 727.33,
   "text": "خب این نکته‌ای بود که در دلش خواستم هم تذکری داده باشم که حواسمون جمع باشه به چه جهت می‌خوایم مرتبط بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 727.33,
   "end": 730.95,
   "text": "هم این که در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 730.95,
   "end": 734.17,
   "text": "لبیکی گفته باشیم به سؤال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 734.17,
   "end": 737.19,
   "text": "اعضای کانال که در این خصوص پرسیده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 737.19,
   "end": 739.01,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}