   "start": 952.27,
   "end": 1030.99
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 4.68,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.68,
   "end": 8.64,
   "text": "المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.64,
   "end": 14.66,
   "text": "عزیزی پرسیده که آیا کسی هست که در این دوره ارتباط با امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.66,
   "end": 17.66,
   "text": "سلام الله عليه داشته باشه یا حضرت رو ببینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.66,
   "end": 20.94,
   "text": "ثانیاً اینکه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.94,
   "end": 24.42,
   "text": "خودمون آیا امکان دیدن حضرت رو داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.42,
   "end": 27.44,
   "text": "در سؤال اول باید عرض کرد که چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.44,
   "end": 31.26,
   "text": "نیستند. هستند. قطعاً هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.26,
   "end": 37.92,
   "text": "و اساساً طبق صحبت‌هایی که جلسات پیش ما تو یک جلسه‌ای عرض کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.92,
   "end": 45.26,
   "text": "این دیگه یک امر ثابت شده است که حضرت کارگزارانی دارند و مرتبط هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.26,
   "end": 47.76,
   "text": "از طریق همونطور که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.76,
   "end": 49.92,
   "text": "غیبت صغراشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.92,
   "end": 55.08,
   "text": "از طریق نواب خاصه مرتبط بودند، در غیبت کبراشون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.08,
   "end": 59.58,
   "text": "از طریق نواب عامه مرتبط‌اند با مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.58,
   "end": 62.2,
   "text": "که این‌ها کارگ-کارگزاران حضرت هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.2,
   "end": 66.2,
   "text": "حلقه اول که چهار نفرند بهشون اوتاد لقب داده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.2,
   "end": 70.1,
   "text": "جمع وتد یعنی میخ. که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.1,
   "end": 74.8,
   "text": "پیکره‌ی اجتماع رو از تکانه‌ها به وساطت حضرت حجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.8,
   "end": 78.24,
   "text": "سلام الله عليه نگه می‌دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.24,
   "end": 81.32,
   "text": "و صیانت می‌کنند. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.32,
   "end": 84.5,
   "text": "حلقه ارتباط حضرت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.5,
   "end": 87.08,
   "text": "اجتماع هستند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.08,
   "end": 90.8,
   "text": "در هر زمانه‌ای چهار نفر هستند که هر کس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.8,
   "end": 95.3,
   "text": "از این چهار نفر از دنیا برود، از حلقه بعدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.3,
   "end": 98.8,
   "text": "صاحبان همت یا به عبارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.8,
   "end": 101.98,
   "text": "ابدال هستند به این‌ها ملحق می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.98,
   "end": 107.9,
   "text": "و حالا داستان‌های مبسوط مستندی هم در کتاب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.9,
   "end": 110.72,
   "text": "بزرگان ما در این حیث زیاد اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.72,
   "end": 113.58,
   "text": "مطالعه کنید هست. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.58,
   "end": 116.34,
   "text": "البته محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.34,
   "end": 119.96,
   "text": "بعضی از بزرگان رو بنده حقیر درک کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 119.96,
   "end": 126.6,
   "text": "پنهانی توصیه می‌کردند که یکی از این و اعتقادشون این بود که یکی از این اوتاد فلحال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 126.6,
   "end": 131.68,
   "text": "حضرت علامه حسن زاده هستند که البته اگر اینا-ایشون نباشند چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.68,
   "end": 136.62,
   "text": "کسی دیگه می‌تونه باشه؟ یا اگر قرار باشه رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.62,
   "end": 139.82,
   "text": "یا امام علیه الرحمه اینها جزو اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.82,
   "end": 145.16,
   "text": "عزیزانی نباشند که سر حلقه وصل به حضرته‌ند، چه کسانی می‌تونند باشند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.16,
   "end": 152.12,
   "text": "این‌هایی که الان در حقیقت جهان اسلام به تدبیر این‌ها بسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.12,
   "end": 154.86,
   "text": "قطعاً و عقلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.86,
   "end": 163.38,
   "text": "و نقلاً این‌ها مرتبط با حضرت حجت به عنوان کانال فیض الهی هستند واقعاً و بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.38,
   "end": 167.06,
   "text": "که اگر غیر از این باشه باید تعجب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.06,
   "end": 170.82,
   "text": "و حلقه دوم که عرض شد این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.82,
   "end": 174.6,
   "text": "ابدال هستند. از این جهت بهشون می‌گن ابدال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.6,
   "end": 179.28,
   "text": "که صاحبان همت‌اند که بحثش قبلاً گذشته البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.28,
   "end": 182.22,
   "text": "به چنان مقامی رسیدند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.22,
   "end": 185.26,
   "text": "می‌تونند دست تصرف در کائنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.26,
   "end": 194.16,
   "text": "دراز کنند و حتی از جسم خودشون، بدن خودشونم، این بدن طبیعیشون هم انشائات کنند، انشاء بدنی کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.16,
   "end": 198.02,
   "text": "و حتی صدها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.02,
   "end": 199.98,
   "text": "بدن از خودشون إنشاء کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.98,
   "end": 201.92,
   "text": "و این چیز عجیبی نیست. بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.92,
   "end": 206.18,
   "text": "خدا رحمت کنه از آقای سیب وی رو که ما محضرشون می‌رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.18,
   "end": 208.92,
   "text": "ایشون تو یک شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.92,
   "end": 214.64,
   "text": "چندین جا از تهران بعداً کاشف به عمل اومد که تو یک ساعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 214.64,
   "end": 217.06,
   "text": "چندین هیئت منبر رفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.06,
   "end": 225.22,
   "text": "این‌ها به قول بزرگان چیزهای در حقیقت پیش پا افتاده و نخود کیش میشه نسبت به مقامات عرفا و بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.22,
   "end": 232.66,
   "text": "اگرچه کسی که به این مقامات رسید نمیگه، دم نمی‌زنه مگر اینکه سرریز بشه وجودش یا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.66,
   "end": 238.4,
   "text": "اخص از شاگردانشون به جهت «و اما بنعمت ربک فحدث» به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.4,
   "end": 241.42,
   "text": "رسالتی که دارند، به امری که می‌گیرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.42,
   "end": 244.74,
   "text": "بیان کنند. به هر حال هستند بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.74,
   "end": 247.22,
   "text": "این‌ها إنشاء می‌کنند بدنشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.22,
   "end": 250.9,
   "text": "و کسایی رو که در راه موندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.9,
   "end": 252.88,
   "text": "گرفتارند، خدا رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.88,
   "end": 255.38,
   "text": "ذکر و نام یا هادی خوندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.38,
   "end": 258.14,
   "text": "مشکلات مالی پیدا کردند، مریض احوال‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.14,
   "end": 262.32,
   "text": "این‌ها حضرت به عنایت و تصرف این‌ها دستشون می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.32,
   "end": 267.94,
   "text": "دست این‌ها رو می‌گیره که البته عددی که دادند معمولاً حدود پنجاه و سه نفر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.94,
   "end": 272.48,
   "text": "در خصوص ابدال بیان کردند بزرگان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.48,
   "end": 275.68,
   "text": "دیگه یه پله پایین‌تر یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.68,
   "end": 280.46,
   "text": "در حقیقت حلقه بعدی رو که بعضیا سیصد نفر عنوان کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 280.46,
   "end": 283.12,
   "text": "حالا این اعداد ما خیلی در بنده این اعداد نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 283.12,
   "end": 286.0,
   "text": "منظور هستند و این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.0,
   "end": 288.56,
   "text": "نجبا همچنین بعد صلحا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 288.56,
   "end": 294.62,
   "text": "اهل ایمان، همچنین حلقه‌ها به هم مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.62,
   "end": 297.84,
   "text": "پس هستند بله هستند لکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.84,
   "end": 303.26,
   "text": "چون این موضوع و در حقیقت این مقام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.26,
   "end": 306.72,
   "text": "مقام اسم مستعفره حضرت حق است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 306.72,
   "end": 309.62,
   "text": "لذا کسی هم که به این مقام رسید به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.62,
   "end": 316.32,
   "text": "ظرفیتی دست پیدا کرده که دم فرو به بنده و نگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 316.32,
   "end": 320.26,
   "text": "مگر اینکه عرض شد به صلاح و استثنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.26,
   "end": 322.26,
   "text": "اونم امر خود مولا باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.26,
   "end": 328.66,
   "text": "مثل سید ابن طاووس که به شاگردشون فرموده بودند من هر وقت در امری می‌مونم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.66,
   "end": 331.5,
   "text": "چه-کی گفته که نمیشه امام عصر رو دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.5,
   "end": 338.46,
   "text": "من هر وقت گره علمی برام پیش میاد حضرت رو زیارت می‌کنم و از حضرت می‌پرسم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.46,
   "end": 340.84,
   "text": "گره علمیم باز میشه. بله این‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.84,
   "end": 345.48,
   "text": "اما سؤال دوم اینکه ما چگونه مرتبط بشویم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.48,
   "end": 348.86,
   "text": "اولاً من سوالم این هستش که ما برای چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.86,
   "end": 352.34,
   "text": "حضرت رو بخواهیم ببینیم؟ اون برای چی خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.34,
   "end": 355.04,
   "text": "چرا ما می‌خوایم حضرت رو زیارت کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.04,
   "end": 359.74,
   "text": "آیا ما حضرت رو زیارت کنیم جز توقعی که همین الان از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 359.74,
   "end": 366.03,
   "text": "سیر حکمت و عرفان نظری و بعد عملی از ما دارن چیز دیگه ای دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 366.03,
   "end": 371.87,
   "text": "آیا جز ترک گناه، خودسازی، معرفت نفس، انجام واجبات، ترک محرمات اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.87,
   "end": 374.25,
   "text": "حضرت تقاضای دیگه ای از ما دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.25,
   "end": 380.23,
   "text": "وقتی که ما این وظایفمون رو انجام دادیم به قول خودشون خود حضرت میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.23,
   "end": 383.17,
   "text": "خود حضرت تشریف میارن، عنایت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.17,
   "end": 387.49,
   "text": "حالا ابتدا از خواب شروع میشه بعد بین خواب و بیداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 387.49,
   "end": 391.03,
   "text": "در توجهات عرفانی و بعد هم در بیداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.03,
   "end": 396.31,
   "text": "و مهمتر از اون این که اساساً تقاضای ما از دیدار حضرت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.31,
   "end": 399.73,
   "text": "خب ما مثلاً به حضرت رسیدیم ان‌شاءالله یک روزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.73,
   "end": 404.55,
   "text": "چی میخوایم از حضرت؟ معمولاً الان خواسته های مردم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.55,
   "end": 406.81,
   "text": "بزرگان و اوتاد علما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 406.81,
   "end": 412.45,
   "text": "شما بفرمایین. غالباً اینطور که ما می‌بینیم یا استخاره میخوان یا تعبیر خواب میخوان یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 412.45,
   "end": 418.03,
   "text": "ذکری میخوان گره‌شون باز بشه، مشکل مالیشون برطرف بشه، مریضشون شفا بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.03,
   "end": 423.13,
   "text": "چه کسیه که بیاد زانو بزنه و خودش رو تحویل بده به حجت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.13,
   "end": 428.07,
   "text": "و واقعاً بگه من آمدم و به صدق آمدم به قول علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.07,
   "end": 431.09,
   "text": "خودش رو تحویل بده و هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 431.09,
   "end": 434.21,
   "text": "مثل میتی که بین دو دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 434.21,
   "end": 443.67,
   "text": "غسال خودش رو می سپره که هر طرف این ور اون ورش کنه تا او رو شستشو بده، واقعاً خودش رو تحویل بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 443.67,
   "end": 448.99,
   "text": "به هر حال یا وقتی هم که تحویل داد آیا ظرفیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 448.99,
   "end": 452.31,
   "text": "وجودی او اقتضا میکنه که از حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 452.31,
   "end": 456.39,
   "text": "اونچه که در مخزن وجودی حضرته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 456.39,
   "end": 459.95,
   "text": "به هر حال اینا سر الله هستند رو اخذ کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 459.95,
   "end": 470.57,
   "text": "مگر نه این است که در اصول کافی مرحوم کلینی اعلا الله مقامه شریف حدیث از امام صادق صلی الله علیه فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.57,
   "end": 474.79,
   "text": "بیست و هفت حرف علم را اگر شما در نظر بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 474.79,
   "end": 480.63,
   "text": "و در تا ظهور امام عصر از اول آدم تا ظهور امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 480.63,
   "end": 484.25,
   "text": "تنها به دو حرف از این بیست و هفت حرف علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 484.25,
   "end": 490.13,
   "text": "مردم با این همه اختراعات و اکتشافات و تولید علم دست پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 490.13,
   "end": 495.61,
   "text": "بیست و پنج حرف علم در سینه امام عصر خواهد موند و حضرت که تشریف آوردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.61,
   "end": 499.15,
   "text": "اساساً بالاترین برنامه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 499.15,
   "end": 503.31,
   "text": "توزیع و نشر معارف و حقایق علوم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 503.31,
   "end": 509.99,
   "text": "خب آیا ما به این ز-- آیا الان ما در خصوص علمامون، بزرگانمون، آثارشون، کتابشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 509.99,
   "end": 513.43,
   "text": "کتاب‌های اون‌ها، اقوالشون چه کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 513.43,
   "end": 520.05,
   "text": "در برابر کلمات این جملات این عزیزان ظرفیت و سعه وجودی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 520.05,
   "end": 527.01,
   "text": "که ما تحمل کنیم بار علمی و معرفتی و حکمی و عرفانی یه کسی مثل مثلا حضرت علامه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 527.01,
   "end": 530.31,
   "text": "آیا داریم که بعد مثلا توقع داریم امام عصر رو ببینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 530.31,
   "end": 535.55,
   "text": "اتفاقاً من یادم نمیره که هیچ وقت زمان جنگ بود توفیق شد بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 535.55,
   "end": 539.23,
   "text": "دست بوسی حضرت امام بین الطلوعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 539.23,
   "end": 542.09,
   "text": "تا لحظه حرکت بچه‌ها من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 542.09,
   "end": 548.13,
   "text": "گرفتار بودم توی این برزخ بودم که برم من وقت این عزیز عالم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 548.13,
   "end": 553.11,
   "text": "که الان رتق و فتق امور اسلام و مسلمانان جهان دستشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 553.11,
   "end": 555.61,
   "text": "من برم برای چی وقت ایشون رو بگیرم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 555.61,
   "end": 557.31,
   "text": "من چه عرضی برای ایشون دارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 557.31,
   "end": 561.83,
   "text": "البته زیارت یک تقاضای درونی و قلبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 561.83,
   "end": 565.27,
   "text": "بحث زیارت قصه‌ش، اما زیارت فقط از بدن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 565.27,
   "end": 569.09,
   "text": "اصل زیارت حضور ظاهر عند المظور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 569.09,
   "end": 572.41,
   "text": "اینکه قلب ما حاضر باشه محضر حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 572.41,
   "end": 576.81,
   "text": "اساساً اصل زیارت، زیارت درونی و قلبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 576.81,
   "end": 581.47,
   "text": "و الا بسیاری رفتن سنگ و چوب و ضریح و گنبد و بارگاه دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 581.47,
   "end": 583.15,
   "text": "اون هم زیباست و قشنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 583.15,
   "end": 588.87,
   "text": "اون‌ها ما نهی نمی‌کنیم. دل ما برای در و دیوار حرم اهل بیت هم تنگ می‌شه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 588.87,
   "end": 590.53,
   "text": "اما اصل چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 590.53,
   "end": 594.03,
   "text": "باید حواسمون جمع باشه. مثل اون زنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 594.03,
   "end": 597.25,
   "text": "امام عصر اومد به تشییعش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 597.25,
   "end": 602.45,
   "text": "و یکی از بزرگان حالا اسمشون از خاطرم رفته فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 602.45,
   "end": 605.31,
   "text": "دنبال حضرت می‌گشتم چندین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 605.31,
   "end": 610.39,
   "text": "ماه چله‌ها می‌گرفتم تا اینکه یک روزی نور حضرت رو در یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 610.39,
   "end": 612.87,
   "text": "بیتی دیدم. به اذن حضرت وارد شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 612.87,
   "end": 615.23,
   "text": "دیدم کنار یه تابوتی نشسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 615.23,
   "end": 618.47,
   "text": "تابوت یه زنی بود. حضرت فرمود هفت سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 618.47,
   "end": 623.53,
   "text": "در دوران خفقان کشف حجاب رضا خانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 623.53,
   "end": 629.23,
   "text": "این زن از منزل خارج نشد مبادا از سرش روسری بردارن و موهاش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 629.23,
   "end": 632.87,
   "text": "نامحرم ببینه. چادر از سرش بردارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 632.87,
   "end": 636.31,
   "text": "و اینطوری باشید خود ما میایم به دیدنتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 636.31,
   "end": 642.55,
   "text": "این کلام خود حضرت هست. به هر حال میخوام عرض کنم که بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 642.55,
   "end": 644.27,
   "text": "امکان دیدن حضرت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 644.27,
   "end": 649.85,
   "text": "راه‌هایی هم علما نسبت به سعه وجودی خودشون مطابق با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 649.85,
   "end": 655.19,
   "text": "در حقیقت ظرفیت وجودی خودشون به شاگردانشون دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 655.19,
   "end": 657.69,
   "text": "و جواب هم گرفتن بعضاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 657.69,
   "end": 661.03,
   "text": "مثلاً مرحوم آقای دولابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 661.03,
   "end": 666.93,
   "text": "روحشون شاد. ایشون معمولاً به شاگرداشون دستور میدادن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 666.93,
   "end": 669.73,
   "text": "چهل روز، روزی صد بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 669.73,
   "end": 672.13,
   "text": "به توجه عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 672.13,
   "end": 680.87,
   "text": "و بنشینن و این ذکر شریفه که از آیات قرآن گرفته شده که \"رب ادخلنی مدخل صدک واخرجنی مخرج صدق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 680.87,
   "end": 685.69,
   "text": "واجعل لی من لدنک سلطانا نصيرا.\" این ذکر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 685.69,
   "end": 689.41,
   "text": "در هر ح- در حقیقت روزی صد بار بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 689.41,
   "end": 692.55,
   "text": "در چهل روز بعد بعضی از شاگرداشون هم زیارت می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 692.55,
   "end": 697.39,
   "text": "بله. یا کسی که چهل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 697.39,
   "end": 702.15,
   "text": "چهل شب جمعه زیارت ابا عبدالله بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 702.15,
   "end": 705.03,
   "text": "شب چهلمش قطعاً آقا رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 705.03,
   "end": 707.87,
   "text": "یا مسجد سهل اینا وارد شده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 707.87,
   "end": 710.27,
   "text": "شب‌های جمعه حضرت رو در کربلا دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 710.27,
   "end": 715.87,
   "text": "بسیاری دیدن. البته قبلاً عرض کردیم بسیاری از این دیدارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 715.87,
   "end": 722.39,
   "text": "مربوط به اوتاد یا ابدال هست یا نجبا و صلحا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 722.39,
   "end": 727.15,
   "text": "که به اون عظمت نوری و ظرفیت وجودی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 727.15,
   "end": 732.43,
   "text": "اشخاص، این‌ها امر براشون مشتبه می‌شد گمان می‌کردند امام عصر رو دیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 732.43,
   "end": 735.21,
   "text": "به هر حال بله راه‌هایی هست اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 735.21,
   "end": 740.53,
   "text": "این رو، این نکته رو در انتها عرض کنم در پاسخ به این قبیل سؤال‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 740.53,
   "end": 745.89,
   "text": "ببینید عزیزان وقتی که از هفتاد و سه اسم اعظم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 745.89,
   "end": 753.51,
   "text": "خدای منان در میان انبیا و اولیایش پخش کرده، هر کدوم از انبیا چند تا اسم اعظم داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 753.51,
   "end": 755.95,
   "text": "این‌ها و تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 755.95,
   "end": 758.77,
   "text": "هفتاد و دو اسم اعظم رو به اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 758.77,
   "end": 764.17,
   "text": "عصمت و طهارت علیهم الصلاة و السلام خدا بخشیده و امام عصر ما دارای این اسم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 764.17,
   "end": 769.11,
   "text": "اون اسم هفتاد و سوم که اسم مستعفره حضرت حق است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 769.11,
   "end": 772.17,
   "text": "و لم خدایی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 772.17,
   "end": 774.49,
   "text": "که البته در خصوص اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 774.49,
   "end": 778.95,
   "text": "حرف زدن بزرگان که معتقدم بسیاری مثل حضرت علامه که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 778.95,
   "end": 782.47,
   "text": "اسم مستعفره هم خود حضرته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 782.47,
   "end": 785.07,
   "text": "خود حقیقت وجودی حضرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 785.07,
   "end": 790.41,
   "text": "وقتی این چنین قصه رو نگاه می‌کنیم می‌بینیم اصلاً این یک امر الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 790.41,
   "end": 792.55,
   "text": "یک در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 792.55,
   "end": 794.35,
   "text": "حریم حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 794.35,
   "end": 799.55,
   "text": "ستر حضرت حق است. ما به چه اجازه‌ای می‌خوایم این ستر رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 799.55,
   "end": 803.43,
   "text": "این پرده رو، این حجاب رو، این حریم رو بشکنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 803.43,
   "end": 807.57,
   "text": "به چه اجازه‌ای؟ و اگه در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 807.57,
   "end": 812.11,
   "text": "خدا این چنین خواسته، چرا می‌خوایم بر خلاف مشیت حضرت حق عمل کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 812.11,
   "end": 814.29,
   "text": "دلتنگی قضیه‌ش فرق می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 814.29,
   "end": 822.85,
   "text": "\"عزیزٌ علی أن أرى الخلق ولا تراك\" \"هل الیک ای ابن احمد سبيلٌ فتلقاتني\" نذبه می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 822.85,
   "end": 825.21,
   "text": "این‌ها درست که آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 825.21,
   "end": 828.71,
   "text": "پسر رسول خدا راهی هست من شما رو ملاقات کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 828.71,
   "end": 833.53,
   "text": "این‌ها درست. یا سخت شده \"عزیزٌ علی، عزيزٌ علی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 833.53,
   "end": 836.05,
   "text": "سخت شده بر من همه رو ببینم شما رو نبینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 836.05,
   "end": 840.57,
   "text": "این‌ها کارهای دل است. اما حواسمون جمع باشه عزیزان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 840.57,
   "end": 842.83,
   "text": "اون اسم مستعفره حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 842.83,
   "end": 845.43,
   "text": "ظهور در حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 845.43,
   "end": 850.61,
   "text": "در حقیقت، تاریخ ظهور حضرت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 850.61,
   "end": 852.91,
   "text": "جزو مستعفرات است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 852.91,
   "end": 856.57,
   "text": "اسرار علوم غیبی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 856.57,
   "end": 858.77,
   "text": "قلبی امام عصر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 858.77,
   "end": 864.53,
   "text": "که حالا البته این بحث هم پیش میاد بعضیا به ما خرده گرفته بودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 864.53,
   "end": 870.29,
   "text": "این قصه‌ای که حضرت علامه فرمودند ظهور اتفاق افتاده رو شما مثلاً در کانال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 870.29,
   "end": 872.89,
   "text": "بچه‌هاتون بارگذاری کردند و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 872.89,
   "end": 876.49,
   "text": "این یه وقت هست تاریخ مشخص می‌شه، این فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 876.49,
   "end": 881.33,
   "text": "اما یه عزیزی میاد با یک دید بسیار زیبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 881.33,
   "end": 885.27,
   "text": "و مبنا دار بر اساس اقوال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 885.27,
   "end": 890.37,
   "text": "به هر حال آیات و روایات و بزرگان ما میاد ثابت می‌کنه که ظهور اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 890.37,
   "end": 894.77,
   "text": "این البته نظر بسیاری از بزرگان و من از خیلی‌ها شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 894.77,
   "end": 899.11,
   "text": "همونطور که غیبت صغری و کبری داشت، ظهور هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 899.11,
   "end": 901.57,
   "text": "صغری و کبری داره. یعنی ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 901.57,
   "end": 906.19,
   "text": "به یکباره و ناگهانی هم حتی اگر اتفاق بیفته قبلش مقدماتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 906.19,
   "end": 910.57,
   "text": "اصطلاحاً چند وقتی ظهور مثل بین الطلوعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 910.57,
   "end": 912.73,
   "text": "تعبیری که از علامه دارن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 912.73,
   "end": 919.47,
   "text": "انقلاب اسلامی ایران می‌فرمایند انقلاب اسلامی ایران این چهل و چند ساله بین الطلوعین ظهور حضرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 919.47,
   "end": 923.95,
   "text": "یعنی ظهور از جهت صغری بودنش اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 923.95,
   "end": 926.35,
   "text": "به هر حال می‌خوام عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 926.35,
   "end": 930.87,
   "text": "به نظر بنده حقیر مهم‌ترین چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 930.87,
   "end": 934.11,
   "text": "در ارتباط با حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 934.11,
   "end": 938.93,
   "text": "این هستش که ما التزام عملی به دستورات حضرت داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 938.93,
   "end": 943.45,
   "text": "کارهایی که محبت ایشون رو دل ما زیاد می‌کنه انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 943.45,
   "end": 952.27,
   "text": "مطلقا، مطلقا به سمت گناه نریم و بهش فکر نکنیم که استعداد رو می‌سوزونه و انسان رو از چشم حضرت میندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 952.27,
   "end": 957.43,
   "text": "یادش بخیر در این انتهای سخن یادگاری عرض کنم محضر آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 957.43,
   "end": 960.85,
   "text": "آقای بهجت خیلی می‌رسیدیم ما مدتی که قم بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 960.85,
   "end": 964.17,
   "text": "یه روزی بعد از نماز صبح محضرشون بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 964.17,
   "end": 968.77,
   "text": "یه خلوت شد همه رفتند به تنهایی از ایشون یه سوالی پرسیدم در خصوص امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 968.77,
   "end": 975.53,
   "text": "گفتم ما یه جمعی هستیم شب‌های جمعه قروبای جمعه جمع می‌شیم روضه می‌خونیم مناجات می‌کنیم با حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 975.53,
   "end": 978.41,
   "text": "دلتنگ حضرت می‌شیم. چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 978.41,
   "end": 981.69,
   "text": "ایشون یه تعبیر خیلی-- حالا یه وقت ایشون مثلاً یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 981.69,
   "end": 984.51,
   "text": "شاعری، یه عاشقی، یه کسی بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 984.51,
   "end": 987.37,
   "text": "این حرفو بزنه. ولی آقای بهجت بگه خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 987.37,
   "end": 992.97,
   "text": "فرمودند بله عاشق مثل پروانه دور شمع معشوقش می‌گرده تا بال و پرش بسوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 992.97,
   "end": 995.55,
   "text": "خیلی زیبا بود تعبیر ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 995.55,
   "end": 998.83,
   "text": "و به بنده فرمودند همین راه رو ادامه بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 998.83,
   "end": 1003.39,
   "text": "آنچه که در مفاتیح شیخ عباس هست، دعاها، اذكار، اوراد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1003.39,
   "end": 1005.67,
   "text": "زیارات، سوره قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1005.67,
   "end": 1009.61,
   "text": "این‌ها رو به نیت حضرت بخوانید و به او هدیه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1009.61,
   "end": 1013.53,
   "text": "محبت آقا تو دل شما زیاد می‌شه و محبت شما تو دل آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1013.53,
   "end": 1016.77,
   "text": "دیگه بقیه رو بسپارید به خود حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1016.77,
   "end": 1020.39,
   "text": "انشاالله اگرچه در این مورد سخن بسیار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1020.39,
   "end": 1025.15,
   "text": "اما سخن کوتاه می‌کنیم که گفتم الف گفت گر گفتم هیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1025.15,
   "end": 1027.31,
   "text": "در خانه اگر کس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1027.31,
   "end": 1030.99,
   "text": "یک حرف بس است. والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}