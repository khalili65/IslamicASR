 },
 "chapters": [
  {
   "index": 0,
   "title": "## پرسش از معنای شفیع در صحیفهٔ سجادیه",
   "start": 1.02,
   "end": 63.9
  },
  {
   "index": 1,
   "title": "### شفاعت به مثابه حفظ استعداد",
   "start": 63.9,
   "end": 167.42
  },
  {
   "index": 2,
   "title": "### اصل الحاق و جبران مافات",
   "start": 167.42,
   "end": 317.68
  },
  {
   "index": 3,
   "title": "### توبهٔ آدم؛ ستون توبه و روضهٔ حسین",
   "start": 317.68,
   "end": 391.64
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 6.42,
   "text": "اما در ادامه‌ی تحقیق این عزیزمون در صحیفه سجادیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.42,
   "end": 8.82,
   "text": "سؤال دیگری رو پرسیدند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.82,
   "end": 11.3,
   "text": "در لزوم وجود شفیع برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.3,
   "end": 15.68,
   "text": "حل مشکلات یا مثلاً جایگاه شفیع در زندگی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.68,
   "end": 18.5,
   "text": "اساساً معنای شفیع. شفع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.5,
   "end": 21.18,
   "text": "در قرآن هم می‌فرماید و الشفع والوتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.18,
   "end": 27.58,
   "text": "اون دو رکعت نماز شفعی که قبل از وتر خونده می‌شه تو یازده رکعت نماز شب هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.58,
   "end": 29.98,
   "text": "هست دیگه نماز شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.98,
   "end": 33.86,
   "text": "از این جهت بهش می‌گن شفعی یعنی جفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.86,
   "end": 38.34,
   "text": "شفاعت، مقام شفاعت یعنی مقام جفت شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.34,
   "end": 41.94,
   "text": "تو با صاحب مقام عصمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.94,
   "end": 50.14,
   "text": "اگر آنچنان معنوس بشوی که جفت شوی قطعاً به شفاعت می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.14,
   "end": 53.28,
   "text": "که این باید از این دنیا برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.28,
   "end": 56.48,
   "text": "یکی از بزرگان می‌فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.48,
   "end": 60.96,
   "text": "شفاعت رو از خدا از ابا عبدالله در این دنیا طلب کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.96,
   "end": 63.9,
   "text": "اون‌ور خیلی سخته، کار دشواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.9,
   "end": 68.44,
   "text": "حالا به یک معنا در فلسفه و عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.44,
   "end": 72.76,
   "text": "همون مقام استعداد انسانی رو شفاعت گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.76,
   "end": 81.26,
   "text": "چرا؟ چون اگر این استعداد از بین برود بر اثر گناه خاصه اصرار بر گناه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.26,
   "end": 85.96,
   "text": "دیگه زمینه‌ی طهارت از بین رفته، بستر طهارت از بین رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.96,
   "end": 89.7,
   "text": "وقتی طهارت از بین رفت \"لا یمسه إلا المطهرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.7,
   "end": 94.74,
   "text": "اساساً چون کائنات همه‌ی نظامات هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.74,
   "end": 100.52,
   "text": "ذاتاً مطهرن و پاک و طهارت در ذات وجود اون‌ها مستکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.52,
   "end": 105.12,
   "text": "لذا با هر بی‌طهارتي برخورد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.12,
   "end": 107.72,
   "text": "با هر بی‌طهارتي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.72,
   "end": 112.46,
   "text": "در حقیقت تضاهم پیش میاد، عذاب ایجاد می‌شه، سختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.46,
   "end": 114.68,
   "text": "اصلاً نمی‌شه طهارت باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.68,
   "end": 119.54,
   "text": "اگر نباشد سختی هست، ضیق هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.54,
   "end": 124.72,
   "text": "فشار هست، تاریکی هست، ظلمت هست، عذاب هست، جهنم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.72,
   "end": 131.34,
   "text": "لذا این طهارت باعث می‌شه که تو بفهمی خروج از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.34,
   "end": 134.92,
   "text": "در حقیقت عادت کنی از ظاهر به باطن سفر کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.92,
   "end": 137.88,
   "text": "موت قبل ان تموت رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.88,
   "end": 142.0,
   "text": "در مسیر بعثت انبیا قرار بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.0,
   "end": 146.4,
   "text": "و در حقیقت اون استعداد وجودیت رو با خودت ببری به اون دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.4,
   "end": 148.8,
   "text": "وقتی استعداد رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.8,
   "end": 155.82,
   "text": "استعداد اگر با گناه از بین نرفت انشاالله با لب مرگ با خودمون بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.82,
   "end": 159.2,
   "text": "دیگه این منجر به مقام شفاعت اولیاء الله می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.2,
   "end": 163.78,
   "text": "یعنی شفعیت رو پیدا می‌کنی، جفت می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.78,
   "end": 167.42,
   "text": "و در حقیقت اصل از-- الحاق هم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.42,
   "end": 171.8,
   "text": "اصل الحاق بردن استعداد از همین دنیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.8,
   "end": 174.46,
   "text": "و شفیع میاد به داد انسان می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.46,
   "end": 177.44,
   "text": "جبران مافات می‌کنه به اصل الحاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.44,
   "end": 183.54,
   "text": "مثل این‌که مثلاً آقامون علی ابن موسی الرضا علیه ما صلوة الله السلام به ابن شبيب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.54,
   "end": 187.32,
   "text": "معمولاً ما اون تیکه اولش رو توجه می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.32,
   "end": 189.78,
   "text": "فَبْكِ لِلْحُسَيْنِ یعنی کُنْتَ بَاکِا لَلشَّهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.78,
   "end": 193.88,
   "text": "به هر چیزی خواستی مطلقاً گریه کنی فَبْكِ لِلْحُسَيْنِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.88,
   "end": 198.74,
   "text": "اون لام هم لام مالکی است. یعنی اصلاً برای فقط برای گریه حسین سلام الله علیه گریه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.74,
   "end": 202.6,
   "text": "اساساً گریه در تملك سید الشهداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.6,
   "end": 208.64,
   "text": "اشک مال این آقاست. لذا گریه کن آقا در تملك سید الشهداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.64,
   "end": 212.52,
   "text": "و مایملکی جز اشک ندارد اون نوکری خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.52,
   "end": 214.1,
   "text": "و همه کاراش اربابشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.1,
   "end": 216.9,
   "text": "حالا بعدش در این حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.9,
   "end": 225.82,
   "text": "مفصله. بعدش می‌فرماد که اگر ابن شبيب می‌خوای در غرفه های بهشتی با ما هم‌درجه و هم‌نشین بشوی، الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.82,
   "end": 229.58,
   "text": "اون باید تبیین بشه این حدیث که جاش اینجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.58,
   "end": 232.6,
   "text": "یه راه داره. فَبْكِ لِلْحُسَيْنِ دوباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.6,
   "end": 236.1,
   "text": "برای حسین. فقط برای این آقا گریه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.1,
   "end": 238.0,
   "text": "همه گریه هاتو معطوف کن به این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.0,
   "end": 243.36,
   "text": "حتی اگر غم و غصه ای دلتو گرفت، برای هر چیزی گریان شدی، وصلش کن به حسین ابن علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.36,
   "end": 246.38,
   "text": "یکی از اسراری که ما برای هر کی روضه می‌خونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.38,
   "end": 250.64,
   "text": "آخر جمعش می‌کنیم در محیط سید الشهدا همینه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.64,
   "end": 253.22,
   "text": "حالا این ببینید این مقام الحاقه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 253.22,
   "end": 259.12,
   "text": "جبرانه و الا ما کجا؟ اصلاً بی‌ادبیه که انسان مقام آل الله رو طلب کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.12,
   "end": 261.56,
   "text": "خارجه از ادب محلا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.56,
   "end": 264.82,
   "text": "رسول الله و عترت پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.82,
   "end": 269.38,
   "text": "اما خودشون فرمودن ما شما رو ملحق می‌کنیم نه که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.38,
   "end": 271.04,
   "text": "مقام اونا رو طلب کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.04,
   "end": 273.06,
   "text": "نه. ما هم‌نشینی طلب می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.06,
   "end": 277.0,
   "text": "اون‌ها به اصل الحاق به کرمشون به همین شفاعت ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.0,
   "end": 281.24,
   "text": "خب این چیز کمیه؟ توجه به وجود شفیع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.24,
   "end": 285.02,
   "text": "در حل مشکلات دنیوی و اخروی این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.02,
   "end": 289.36,
   "text": "حتی در مسائل دنیوی خودشون بارها و بارها فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.36,
   "end": 294.52,
   "text": "در مطلق مشکلات دنیوی تون به جواد ما توسل کنید که او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.52,
   "end": 296.46,
   "text": "پربرکت‌ترین مولود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.46,
   "end": 300.42,
   "text": "الله اکبر. خب این جایگاه چرا انسان توجه نکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.42,
   "end": 302.6,
   "text": "و چقدرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.6,
   "end": 308.3,
   "text": "متوجه شدن از ریز و درشت مشکلاتشون به جهت توجه به اون‌ها برطرف شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.3,
   "end": 313.86,
   "text": "که دیگه از تا حضرت آدم دیگه بالاتر پیغمبر خدا رانده شده از بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.86,
   "end": 315.96,
   "text": "که البته این رانده شدن باید معنا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.96,
   "end": 321.74,
   "text": "یعنی چی؟ معنای توبه اینجا یعنی چون ستون توبه در مسجد کوفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.74,
   "end": 325.68,
   "text": "ایشون انقدر دی-- حالا روایت هست دویست سال گریه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.68,
   "end": 330.82,
   "text": "بعد متوجه مقام شفاعت سید الشهداش کردن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.82,
   "end": 336.88,
   "text": "یا حمید به حق محمد یا علی به حق علی یا فاطر به حق فاطمه یا محسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.88,
   "end": 340.32,
   "text": "یا به حق حسن و یاد القدیم الاحسان به حق حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.32,
   "end": 345.78,
   "text": "تا اسم حسین سلام الله علیه رو شنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.78,
   "end": 347.86,
   "text": "دل شکست. همه شنیدید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.86,
   "end": 353.46,
   "text": "بعد جبرائیل، حضرت جبرائیل سلام الله علیه براشون روضه‌ی سید الشهدا خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 353.46,
   "end": 356.9,
   "text": "اشکی جاری شد، مقام توبه ایجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.9,
   "end": 359.18,
   "text": "ببینید این همون اصل الحاقه دو مرتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 359.18,
   "end": 361.14,
   "text": "به انسان کامل ملحقش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.14,
   "end": 365.14,
   "text": "از-- حتی حضرت آدم رو و جبران مافات براش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 365.14,
   "end": 369.48,
   "text": "این مقام شفاعته. یعنی انبیا هم حتی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.48,
   "end": 374.86,
   "text": "شفاعت از می‌شه گفت همون مقام شفاعت و شفع بی‌نیاز نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.86,
   "end": 379.7,
   "text": "اون‌ها رو هم باید آل الله پیغمبر و آلش شفاعت کنه که کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.7,
   "end": 384.08,
   "text": "ابا عبدالله تک تک رو شفاعت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.08,
   "end": 388.46,
   "text": "یعنی انسان به بالاترین مدارج نمی‌رسد مگر با مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 388.46,
   "end": 391.64,
   "text": "شفاعت. والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}