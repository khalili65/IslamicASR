 ],
 "cues": [
  {
   "i": 0,
   "start": 0.66,
   "end": 4.1,
   "text": "بسم الله و بالله و علی ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.1,
   "end": 8.46,
   "text": "المستغاث بک یا حجت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.46,
   "end": 12.04,
   "text": "سؤال عزیزی به حقیر رسیده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.04,
   "end": 14.22,
   "text": "خیلی علاقمند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.22,
   "end": 19.0,
   "text": "مطالعه کتب عرفان اسلامی هستند اما بعضیا ناه-- نهی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.0,
   "end": 23.68,
   "text": "این ناهیانی که میگن فلسفه و عرفان از انبیا به ما نرسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.68,
   "end": 27.46,
   "text": "و با احادیث قرآن تطابق نداره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.46,
   "end": 30.26,
   "text": "در عرفان اسلامی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.26,
   "end": 33.7,
   "text": "مسئله حق و خلق رو به دریا و مژگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.7,
   "end": 39.6,
   "text": "تعبیر می‌کنند. در حالی که ائمه با خالق و مخلوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.6,
   "end": 47.22,
   "text": "و مناظراتی رو که بین مخالفین و موافقین می‌بینن به نتیجه‌ای نمی‌رسند و از این دست صحبت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.22,
   "end": 49.54,
   "text": "البته دامنه بحث گسترده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.54,
   "end": 51.9,
   "text": "به قول خودتون در این حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.9,
   "end": 53.9,
   "text": "قلم هم زیاد زده شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.9,
   "end": 58.58,
   "text": "بحث زیاد شده. اجمالاً عرض می‌کنم که بالاخره وجه تمایز ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.58,
   "end": 60.68,
   "text": "با دیگر موجودات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.68,
   "end": 67.16,
   "text": "چی باعث شده که ما انسان باشیم و از تولد حیوانی با خروج از عادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.16,
   "end": 70.28,
   "text": "که بحثش در قلب مألوف گذشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.28,
   "end": 76.14,
   "text": "به تولد انسانی برسیم و با نگاه دفعی به عالم نگاه کنیم نه تدریجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.14,
   "end": 78.76,
   "text": "آیا چیزی جز عقل هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.76,
   "end": 81.24,
   "text": "عقلی که از عقال میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.24,
   "end": 84.5,
   "text": "این عقال جاییه که شترو بهش می‌بندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.5,
   "end": 89.98,
   "text": "یعنی انسان به یک مشربی، به یک چشمه‌ای، به یک پایبستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.98,
   "end": 94.52,
   "text": "بسته باشد. یعنی با فکر شروع کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.52,
   "end": 107.0,
   "text": "و توجه کنه به آثار عال-- به آثار حضرت حق در عالم که همون آیات حق هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.0,
   "end": 112.48,
   "text": "آیا نگاه نمی‌کنید؟ آیا این کتاب آفاقی و کتاب انفسی رو نمی‌خوانید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.48,
   "end": 116.7,
   "text": "خب فلاسفه یا به عبارتی حکما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.7,
   "end": 122.98,
   "text": "و عرفا جز این کار رو داشتن، جز اینکه با دیده عقل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.98,
   "end": 126.46,
   "text": "تفکر در کنح و باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.46,
   "end": 130.98,
   "text": "ظواهر نظام هستی سعی کردن به حقایق برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.98,
   "end": 134.16,
   "text": "اگر کسی سیر فکریش رو تعطیل کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.16,
   "end": 138.2,
   "text": "که این اصلاً مغایر با صریح آیات قرآنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.2,
   "end": 144.52,
   "text": "که بسیار اگر شما سرچ کنید تو همین اینترنت ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.52,
   "end": 147.84,
   "text": "اگر توانایی اینو نداشته باشید که با قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.84,
   "end": 150.86,
   "text": "بشینید از انتها تا، از ابتدا تا انتهاش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.86,
   "end": 154.56,
   "text": "مطالعه کنید و دقت کنید، یه سرچ کنید آیات تفکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.56,
   "end": 160.14,
   "text": "ببینید چند تا آیه در خصوص تفکر و تعقل میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.14,
   "end": 162.68,
   "text": "و اساساً کار فلسف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.68,
   "end": 165.1,
   "text": "میشه گفت فیلسوف و عارف همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.1,
   "end": 168.74,
   "text": "چیزی جز این نیست. فیلسوف میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.74,
   "end": 173.22,
   "text": "زیربناسازی می‌کنه برای شناخت که بهش میگن برهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.22,
   "end": 175.86,
   "text": "و برهان انسان رو سوق میده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.86,
   "end": 179.68,
   "text": "سمت شناخت، شناخت باطن که بهش میگن عرفان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.68,
   "end": 185.86,
   "text": "و آیا جز برهان و عرفان در قرآن چیزی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.86,
   "end": 191.18,
   "text": "ااا جالبه که از علامه خیلی سال‌های پیش از علامه حسن زاده خدا حفظشون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.18,
   "end": 194.96,
   "text": "سال-- خیلی سال‌های پیش وقتی این بحث‌ها به اوج رسیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.96,
   "end": 197.72,
   "text": "حالا الان که الحمد لله فروکش کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.72,
   "end": 201.62,
   "text": "اون موقعی که رهبر عزیزمون بیان‌گذار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.62,
   "end": 204.58,
   "text": "جمهوری اسلامی و بزرگ ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.58,
   "end": 211.22,
   "text": "هرچندار احیای مکتب عظیم اسلام در سرتاسر دنیا حضرت امام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.22,
   "end": 215.56,
   "text": "تو-- بزر-- ااا علما توبیخ می‌کردن، نامه می‌نوشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.56,
   "end": 218.1,
   "text": "تهدید می‌کردن که کفن‌پوش میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.1,
   "end": 223.3,
   "text": "میایم چرا شما اندیشمندان شرق و غرب عالم رو دعوت کردید به کتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.3,
   "end": 228.54,
   "text": "فلسفی و عرفانی محی الدین و شیخ الرئیس و ملا صدرا و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.54,
   "end": 231.32,
   "text": "اون موقع‌ها حضرت علامه کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.32,
   "end": 234.94,
   "text": "اینکه قرآن و برهان و عرفان از هم جدایی ندارن رو نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.94,
   "end": 237.24,
   "text": "توصیه می‌کنم اون کتاب رو بخونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.24,
   "end": 245.02,
   "text": "و سعی هم بکنیم که از آبشخور کسی آب بنوشیم که جامع الاطراف باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.02,
   "end": 247.84,
   "text": "حالا هر کسی برای خودش حرفی می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.84,
   "end": 251.52,
   "text": "اتفاقاً یکی از مضرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.52,
   "end": 260.56,
   "text": "متأسفانه در حقیقت کتاب‌های بازاری امروزی‌ها به عبارتی جدل‌های غیر احسن امروزی همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.56,
   "end": 266.8,
   "text": "آشفتگی قوه خیال و وهم که به تعقل هم کشیده نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 266.8,
   "end": 270.0,
   "text": "اینکه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.0,
   "end": 274.2,
   "text": "ااا هر کتابی رو بخونه، پای صحبت هر کسی بنشینه، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 274.2,
   "end": 278.3,
   "text": "یک آش شل قلمکاری در وجود خودش درست می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.3,
   "end": 281.92,
   "text": "خفه میشه در مفروضات ضد و نقیض خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.92,
   "end": 285.42,
   "text": "اتفاقاً چنین نیست که فلسفه و عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.42,
   "end": 290.26,
   "text": "با قرآن س-- و احادیث اهل بیت علیهم السلام سازگار نباشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.26,
   "end": 294.94,
   "text": "کجاش سازگاری نداره؟ بیان مصداق بدن تا بحث بشه سرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.94,
   "end": 301.54,
   "text": "اتفاقاً تمام، تمام تلقیات یک ع-عارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.54,
   "end": 309.5,
   "text": "و کسی که سیر حکمت رو درست رفته جلو در حقیقت حکمت و عرفان نظری رو درست رفته جلو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.5,
   "end": 314.76,
   "text": "و حالا بعد به حکمت و عرفان عملی رسیده، دقیقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.76,
   "end": 319.24,
   "text": "بر اساس آیات و رف-- و گفتار اهل بیت علیهم السلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 319.24,
   "end": 320.94,
   "text": "هیچ کجا مغایرتی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.94,
   "end": 323.56,
   "text": "حالا آیا ملا صدرا حدیث‌شناس نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.56,
   "end": 328.14,
   "text": "محدث نبود؟ آیا ملا صدرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.14,
   "end": 331.6,
   "text": "اولین کتاب اربعة شیعه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.6,
   "end": 334.1,
   "text": "مجمع روایات ماست، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.1,
   "end": 337.82,
   "text": "به قولی جامع روایاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.82,
   "end": 347.92,
   "text": "و روایات مستند اهل بیت علیهم السلام رو از میان چهارصد اصلی که از کتاب‌های با اصل و اساس و ریشه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 347.92,
   "end": 355.18,
   "text": "علما و شاگردانی که در زمان امام صادق صلوات الله علیه قلم زده بودند و رسیده بود به دست ایشون جمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 355.18,
   "end": 357.84,
   "text": "کرده بود در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 357.84,
   "end": 361.04,
   "text": "خودش مرحوم کلینی به نام اصول کافی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.04,
   "end": 366.58,
   "text": "آیا ملا صدرا این کتاب اصول کافی رو ندید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.58,
   "end": 370.56,
   "text": "اتفاقاً دید بلکه شرح اصول کافی داره ملاصدرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 370.56,
   "end": 375.48,
   "text": "ملاصدرا محدثه، حدیث شناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 375.48,
   "end": 378.5,
   "text": "این متأسفانه دشمنیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 378.5,
   "end": 382.08,
   "text": "یا حالا آگاهانه یا غیر آگاهانه داره بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 382.08,
   "end": 385.22,
   "text": "علیه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 385.22,
   "end": 393.3,
   "text": "علم اصیل و حالا بعضیا میگن علوم غریب یا غریبه به قول علامه غریبه آشنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 393.3,
   "end": 395.84,
   "text": "داره میشه. ما باید حواسمون جمع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 395.84,
   "end": 403.76,
   "text": "اتفاقاً کی گفته که فلسفه و عرفان، چه کسی گفته که حکمت و عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 403.76,
   "end": 408.52,
   "text": "حرفی از خالق و مخلوق ندارد و می‌گوید فقط خالق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 408.52,
   "end": 410.5,
   "text": "یا بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 410.5,
   "end": 415.04,
   "text": "دریا و موج رو مثلاً با این خلط بحث می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 415.04,
   "end": 419.22,
   "text": "اتفاقاً تمام حکما و تمام عرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 419.22,
   "end": 422.8,
   "text": "قائل به این هستند که خالقی هست و مخلوقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 422.8,
   "end": 425.56,
   "text": "لکن اون مخلوق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 425.56,
   "end": 429.96,
   "text": "شؤون و بروز حضرت حق می‌دانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 429.96,
   "end": 433.08,
   "text": "که ببینید بالاخره عرض کردم ما عقل داریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 433.08,
   "end": 441.56,
   "text": "با عقلمون وقتی آیات و روایات رو بررسی می‌کنیم می‌بینیم اگر از صمد وجود از صمد حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 441.56,
   "end": 444.14,
   "text": "به قول امام جواد صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 444.14,
   "end": 450.74,
   "text": "اگر اشتباه نکرده باشم تا اونجا که تو ذهنم هست امام جواد صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 450.74,
   "end": 452.96,
   "text": "حالا هر کدام از معصومین در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 452.96,
   "end": 456.28,
   "text": "رساله اسم اعظم از ته علمه هم اومده این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 456.28,
   "end": 460.08,
   "text": "حدیث که اگر از صمد این است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 460.08,
   "end": 463.58,
   "text": "اصلاً توخالی نیست پره پر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 463.58,
   "end": 467.42,
   "text": "و هیچ کجا خالی از او نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 467.42,
   "end": 472.6,
   "text": "که اگر شما کوچک‌ترین جایی رو پیدا کنید بگید این چیز این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 472.6,
   "end": 477.86,
   "text": "مثلاً مکان، این زمان، اینجا، این شی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 477.86,
   "end": 483.06,
   "text": "این زمین، این آسمان، این ملک، این انسان، این نبات، این جماد، این حیوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 483.06,
   "end": 486.04,
   "text": "اینها مثلاً یه چیزی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 486.04,
   "end": 488.7,
   "text": "حالا خدای اینها یک چیز دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 488.7,
   "end": 493.32,
   "text": "این شما عقلتون رو وقتی به کار بندازید می‌بینید که اصلاً نمیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 493.32,
   "end": 501.84,
   "text": "چیزی جز شؤون و بروز حضرت حق باشه که اگر باشد جایی رو پیدا کردی خالی از حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 501.84,
   "end": 508.56,
   "text": "در حالی که مولامون علی علیه الصلاة والسلام فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 508.56,
   "end": 515.86,
   "text": "هیچ چیزی رو ندیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 515.86,
   "end": 519.18,
   "text": "شما اینو بفرمایید ببینم چگونه تعبیر می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 519.18,
   "end": 532.88,
   "text": "آیا آنچه که حکما و فلاسفه و عرفا میگن به غیر از مبانی فکری که همین احادیث و روایات دارن به ما میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 532.88,
   "end": 544.08,
   "text": "آیه سه سوره حدید چی میگه؟ آیا عرفان آیا برهان به غیر از این آیاته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 544.08,
   "end": 550.78,
   "text": "که هو او، اون خدا همون هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 550.78,
   "end": 555.22,
   "text": "است. همون هو اول است و همان آخر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 555.22,
   "end": 558.1,
   "text": "و همان ظاهر است و همان باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 558.1,
   "end": 563.12,
   "text": "یعنی اول نظام، آخر نظام، ظاهر نظام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 563.12,
   "end": 566.22,
   "text": "باطن نظام جدایی از حق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 566.22,
   "end": 575.46,
   "text": "حق مطلق است. ضمن این که خدا یک جا خدا می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 575.46,
   "end": 586.08,
   "text": "یک جا دیگه می‌فرماید ما آیات خودمون رو نشونشون میدیم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 586.08,
   "end": 588.34,
   "text": "نظام آفاقی مون و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 588.34,
   "end": 596.24,
   "text": "نظام انفسی که چی بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 596.24,
   "end": 602.58,
   "text": "نه بلحق. خب پس آنچه که یک عارف و یک فیلسوف می‌گوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 602.58,
   "end": 605.48,
   "text": "از دل آیات و روایات بیرون آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 605.48,
   "end": 611.44,
   "text": "که شما سیر معرفت نفس از علامه طباطبایی اولین جمله ای که تو درس اول ایشون هست این است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 611.44,
   "end": 613.86,
   "text": "وجود است که مشهود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 613.86,
   "end": 617.4,
   "text": "پس هرچه که مشهود ماست وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 617.4,
   "end": 622.36,
   "text": "و اگر ما میگیم این کثرات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 622.36,
   "end": 625.7,
   "text": "شؤون و بروز حضرت حق می‌گیریم یعنی همون مخلوقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 625.7,
   "end": 628.76,
   "text": "کی دیگه، کی گفته که مخلوقی وجود نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 628.76,
   "end": 631.72,
   "text": "مخلوق هست اما شؤون حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 631.72,
   "end": 634.7,
   "text": "نمیشه جدایی از حضرت حق باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 634.7,
   "end": 638.38,
   "text": "بروز در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 638.38,
   "end": 642.28,
   "text": "ظهور اسم باطن حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 642.28,
   "end": 644.2,
   "text": "و الا ذات غیب الغیوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 644.2,
   "end": 652.72,
   "text": "و بی‌مثال حضرت حق رو که نه موضوع قرآن است و روایات ما و نه کسی درباره‌ش حرفی می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 652.72,
   "end": 658.76,
   "text": "و اینکه عرض شود خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 658.76,
   "end": 665.42,
   "text": "کتابو حالا چون ami عزیز پرسیده بودند کتاب، کلاس، استاد اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 665.42,
   "end": 667.32,
   "text": "من عرض کردم لا بلای صحبت‌هام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 667.32,
   "end": 669.58,
   "text": "کتابی خوبه که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 669.58,
   "end": 673.72,
   "text": "مؤلف جامع الاطراف نوشته شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 673.72,
   "end": 678.38,
   "text": "سخنرانی خوبه که کسی معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 678.38,
   "end": 684.28,
   "text": "این چنینی درش پیاده شده باشه حتی ضباط محض نباشه، فقط ضبط کنه بیاد بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 684.28,
   "end": 686.74,
   "text": "پیاده شده باشه تو وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 686.74,
   "end": 693.54,
   "text": "در حقیقت الحمد لله کم هم نبودند و نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 693.54,
   "end": 695.9,
   "text": "عزیزان می‌تونید مراجعه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 695.9,
   "end": 701.58,
   "text": "حالا حضرت استاد علامه حسن زاده حفظه الله تعالی ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 701.58,
   "end": 703.82,
   "text": "دعاشون کنید در بستر بیماری هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 703.82,
   "end": 705.94,
   "text": "خدا شفای عاجل و کامل رحمت بفرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 705.94,
   "end": 710.3,
   "text": "اما شاگردان خوب ایشون هستند الحمد لله در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 710.3,
   "end": 713.84,
   "text": "شهرهای مختلف. شما سرچ کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 713.84,
   "end": 716.72,
   "text": "تو سایت‌ها اینها می‌تونید باهاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 716.72,
   "end": 722.42,
   "text": "اشرو نش داشته باشید با آثارشون، با شروحی که بر آثار علامه دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 722.42,
   "end": 725.88,
   "text": "البته حرف عرض کردم خیلی بیش از این حرف‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 725.88,
   "end": 729.98,
   "text": "منتها تا یارkra خواهد و میلش به که باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 729.98,
   "end": 734.74,
   "text": "گفتم الف گفت دگر گفتم هیچ در خانه اگر کس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 734.74,
   "end": 740.1,
   "text": "یک حرف بس است. و الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 740.1,
   "end": 744.38,
   "text": "هیچکس قائل به این نیست که آسمان خداست، زمین خداست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 744.38,
   "end": 748.46,
   "text": "این مخلوقات همه اون حق مطلق‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 748.46,
   "end": 754.6,
   "text": "و بی قید و شرط. و این‌ها مثلاً استغفرالله الله هستند نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 754.6,
   "end": 756.26,
   "text": "این‌ها شؤون و بروز او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 756.26,
   "end": 758.68,
   "text": "در عین حال هر خلق هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 758.68,
   "end": 760.68,
   "text": "ملاصدرا این تکلیف رو روشن کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 760.68,
   "end": 764.74,
   "text": "مرحوم واجی سبزواری، شیخ طوسی روشن کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 764.74,
   "end": 770.84,
   "text": "علامه رفیع قزوینی، استاد علامه روشن کرد که فرمودند وجود یک وجود صمدی حضرت حق است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 770.84,
   "end": 774.94,
   "text": "و کثرات همه نمودار آن وجود هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 774.94,
   "end": 777.12,
   "text": "ان شاء الله که عاقبتمون به خیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 777.12,
   "end": 778.82,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}