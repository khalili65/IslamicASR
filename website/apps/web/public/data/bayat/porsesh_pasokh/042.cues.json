 "chapters": [
  {
   "index": 0,
   "title": "## استغاثه و پرسش از ذکر یونسیه",
   "start": 1.0,
   "end": 21.06
  },
  {
   "index": 1,
   "title": "ذکر تنفسی آن است که سالک بر دم و بازدم کار کند. اگر مقصود پرسش، ذکر یونسیه باشد، می‌تواند بر این ذکر تمرین تنفسی کند:",
   "start": 21.06,
   "end": 379.36
  },
  {
   "index": 2,
   "title": "## نقش مزاج در لذت عبادت",
   "start": 379.36,
   "end": 452.52
  },
  {
   "index": 3,
   "title": "## آثار اعمال؛ درون و بیرون",
   "start": 452.52,
   "end": 551.44
  },
  {
   "index": 4,
   "title": "## ظرفیت و سعهٔ وجودی؛ حضور نزد استاد",
   "start": 551.44,
   "end": 727.68
  },
  {
   "index": 5,
   "title": "## ضیق نطفه و توسل به صاحب مقام کن",
   "start": 727.68,
   "end": 764.25
  },
  {
   "index": 6,
   "title": "## مشکل عمومی و تجربهٔ حضور پیش از نماز",
   "start": 764.25,
   "end": 1035.25
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.0,
   "end": 7.08,
   "text": "بسم الله و بالله و على ملة رسول الله المستغاث بك يا حجة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.08,
   "end": 15.42,
   "text": "عزیزی پرسیده که در خصوص ذکر یونسیه که این ذکر رو چگونه باید گفت یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.42,
   "end": 19.96,
   "text": "در به چه صورت به صورت خفی یا علن و آشکار یا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.96,
   "end": 22.7,
   "text": "هر نفس به چه صورت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.7,
   "end": 26.52,
   "text": "حالا منظورشون از در هر نفس شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.52,
   "end": 29.56,
   "text": "ذکر تنفسی و این‌ها باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.56,
   "end": 34.06,
   "text": "یا همون ذکر خفی. ببینید عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.06,
   "end": 38.38,
   "text": "در خصوص ذکر ابتدا خب از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.38,
   "end": 45.76,
   "text": "بدن و لفظ و پیکره و ظاهر ذکر باید بهره گرفت تا به باطنش رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.76,
   "end": 56.4,
   "text": "همونطور که نفس ناطقه ما یک بدن دارد، یک ظاهر دارد و یک باطن و این دو در هم توأمان هستند و یک حقیقتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 56.4,
   "end": 60.54,
   "text": "اون‌ها هم نباید از ظاهرش غافل شد نه از باطنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 60.54,
   "end": 68.06,
   "text": "لکن خب از پیکره و ظاهر که ظاهر عنوان باطن هست استفاده میشه در ابتدای سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 68.06,
   "end": 72.64,
   "text": "و ذکر رو با توجه به ترجمه و معنی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 72.64,
   "end": 78.16,
   "text": "سالک پیش میگیره و تب با توجه، با توجه شروع میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 78.16,
   "end": 86.32,
   "text": "و پس از مدتی که حالا فرق میکنه نسبت به ظرفیت‌های هر کسی فرق میکنه یکی زودتر یکی دیرتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 86.32,
   "end": 90.18,
   "text": "بالاخره بعد از مدتی که این ذکر در وجود طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 90.18,
   "end": 93.08,
   "text": "و شخص پیاده شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 93.08,
   "end": 97.32,
   "text": "ملکه شد به یک معنا و راسخ شد و جا گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 97.32,
   "end": 101.64,
   "text": "دیگه خود طرف متوجه میشه وجودش عجین میشه با اون ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 101.64,
   "end": 107.32,
   "text": "یکی از راه‌های متوجه شدنش اینه که وقتی می‌ترسه از چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 107.32,
   "end": 111.6,
   "text": "یا شعف و نشاط خاصیه وقتی بهش دست میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 111.6,
   "end": 114.94,
   "text": "این‌ها ناخودآگاه اون ذکر رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 114.94,
   "end": 120.7,
   "text": "حالا اون، اون موقع وقتی‌ست که دیگه باید رفت سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 120.7,
   "end": 123.76,
   "text": "حالا به یک معنا ذکر خفی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 123.76,
   "end": 128.7,
   "text": "ذکر تنفسی. ذکر تنفسی به این صورته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 128.7,
   "end": 134.44,
   "text": "رو تنفسش کار میکنه در دم و بازدمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 134.44,
   "end": 139.46,
   "text": "اگر منظور ایشون در این سؤال ذکر یونسیه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 139.46,
   "end": 146.08,
   "text": "که لا اله الا انت سبحانک انی کنت من الظالمین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 146.08,
   "end": 149.78,
   "text": "به صورت تنفس میتونه روش کار کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 149.78,
   "end": 153.22,
   "text": "که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 153.22,
   "end": 156.98,
   "text": "لا اله الا انت سبحانک رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 156.98,
   "end": 161.2,
   "text": "در دمش بگه بعد بازدمش بگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 161.2,
   "end": 164.9,
   "text": "انی کنت من الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 164.9,
   "end": 168.22,
   "text": "میتونه تمرین کنه یا اگر نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 168.22,
   "end": 172.08,
   "text": "گنجایش این رو نداره تقطیعش کنه به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 172.08,
   "end": 175.74,
   "text": "سه بار چهار بار تقطیع کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 175.74,
   "end": 182.7,
   "text": "و مرتبه بعدی می‌شود این که این ذکر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 182.7,
   "end": 188.36,
   "text": "ذکر قلبی خودش قرار بده که دیگه از اون حالت تنفسی خارج میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 188.36,
   "end": 192.08,
   "text": "که البته کسی که رو ذکر تنفسی کار میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 192.08,
   "end": 194.04,
   "text": "رفته رفته این چنان ملکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 194.04,
   "end": 202.08,
   "text": "وجودیش می‌شود که همون می‌شود ذکر قلبی‌ش و ناخودآگاه ذکر تنفسی میگه و در هر دم و بازدمش ذکر رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 202.08,
   "end": 208.18,
   "text": "حالا اگر متوجه نباشه و در کنارش حضور قلب رو هم البته داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 208.18,
   "end": 211.74,
   "text": "پس ذکر یونسیه یا هر ذکر دیگه‌ای رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 211.74,
   "end": 216.74,
   "text": "باید انسـ-- انسان ابتدا به صورت جلی و آشکار از بدنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 216.74,
   "end": 224.62,
   "text": "از قرائت این‌ها استفاده کنه رفته رفته تنفسی و خفی و قلبی‌ش کنه و برسه به حقیقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 224.62,
   "end": 229.02,
   "text": "اما سؤال دیگه‌ای که پرسیدن این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 229.02,
   "end": 233.6,
   "text": "فرمودن من از عبادت یا نماز خوندن و این‌ها لذت نمی‌برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 233.6,
   "end": 237.12,
   "text": "چه کنم؟ سختم مثلاً نماز می‌خونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 237.12,
   "end": 239.78,
   "text": "و می‌خوام ترک کنم بلکه شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 239.78,
   "end": 242.44,
   "text": "برگردم به لذت و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 242.44,
   "end": 246.02,
   "text": "در این خصوص باید توجه داشته باشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 246.02,
   "end": 251.82,
   "text": "ما ابتدا برای چشیدن لذت عبادات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 251.82,
   "end": 255.82,
   "text": "و خصوصاً نماز که معراج مؤمن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 255.82,
   "end": 262.14,
   "text": "با حضور و مراقبت باید مواراداتمون رو کنترل کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 262.14,
   "end": 270.64,
   "text": "حالا که این واردات ابتدا از کانال حواس پنج گانه ظاهریه رخ میده، بعد میره به باطن و حس مشترک و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 270.64,
   "end": 274.78,
   "text": "و قوای حالا قوه خیال و وهم و عقل و همین‌چنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 274.78,
   "end": 280.34,
   "text": "از ابتدا باید از همین حواس پنج گانه واردات رو مراقبت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 280.34,
   "end": 284.64,
   "text": "این که لمسمون رو، بوییدنمون رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 284.64,
   "end": 286.98,
   "text": "از شنیدنمون رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 286.98,
   "end": 290.3,
   "text": "دیدنمون رو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 290.3,
   "end": 293.56,
   "text": "مخصوصاً چشیدنمون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 293.56,
   "end": 296.6,
   "text": "این‌ها رو باید مراقبت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 296.6,
   "end": 300.4,
   "text": "که در پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 300.4,
   "end": 305.14,
   "text": "واردات درست و خوب و مفید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 305.14,
   "end": 309.32,
   "text": "و شایسته صادرات شایسته‌ای خواهیم داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 309.32,
   "end": 315.14,
   "text": "پس هرچه حضور و مراقبت به قول بزرگان خصوصاً علامه‌ شدیدتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 315.14,
   "end": 318.68,
   "text": "واردات بهتر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 318.68,
   "end": 322.42,
   "text": "شایسته‌تر، در نتیجه صادرات عالی‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 322.42,
   "end": 327.58,
   "text": "حالا اگر چنانچه کسی در حضور و مراقبتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 327.58,
   "end": 329.94,
   "text": "به نحو احسن عمل کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 329.94,
   "end": 333.18,
   "text": "درست عمل کرد با علم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 333.18,
   "end": 336.12,
   "text": "اون آداب و شرایط لازم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 336.12,
   "end": 339.3,
   "text": "تحت تربیت اساتید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 339.3,
   "end": 347.48,
   "text": "اون راه متقن و درست بر اساس آموزه‌های قرآنی که إن هذا القرآن يهدي للتي هي أقوم به بهترین شکل رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 347.48,
   "end": 350.46,
   "text": "اما جواب درستی نگرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 350.46,
   "end": 352.04,
   "text": "حالا اینجا میشه دو شق دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 352.04,
   "end": 360.36,
   "text": "پس یه سری که خب می‌رسن به اون جواب و به لذت رو می‌چشن و هرچه بیشتر حضور و مراقبت دارن لذت بیشتری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 360.36,
   "end": 364.56,
   "text": "از عبادت و نماز دارن و هی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 364.56,
   "end": 368.9,
   "text": "از این نماز به اون نماز رشد می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 368.9,
   "end": 379.36,
   "text": "اما اگر کسی حضور و مراقبش رو درست انجام داد اما نتیجه نگرفت یا نتیجه خوبی نگرفت، اون مشکل در کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 379.36,
   "end": 387.04,
   "text": "در چنین وضعیتی یا مشکل برمی‌گرده به مزاج طرف که قبلاً عرض شد مزاج تأثیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 387.04,
   "end": 393.0,
   "text": "مستقیمی دارد در سیر و سلوک و تهذیب نفس و خلق و اخلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 393.0,
   "end": 394.84,
   "text": "و پیاده شدن اسماء در وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 394.84,
   "end": 397.06,
   "text": "اینا همه بحث‌هاش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 397.06,
   "end": 399.54,
   "text": "لذا یکی از مهم‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 399.54,
   "end": 408.7,
   "text": "وظایف سالک الی الله اینه که مزاجش رو خوب بشناسه و بر اساس، بر اساس آموزه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 408.7,
   "end": 411.32,
   "text": "در مسیر مزاج شناسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 411.32,
   "end": 414.02,
   "text": "مزاجش رو به سمت اعتدال برود، ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 414.02,
   "end": 421.14,
   "text": "هرچه более wird که از اعتدال مزاج خارج شد لذتش از عبادات همون مقدار کم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 421.14,
   "end": 426.44,
   "text": "یعنی می‌بینید گاهی اوقات ماها مشکل خاصی از حیث حضور و مراقبت نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 426.44,
   "end": 429.62,
   "text": "مزاجمون، فیزیک بدنمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 429.62,
   "end": 433.36,
   "text": "و این‌ها مسائل جسمیمون، خوراکمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 433.36,
   "end": 435.68,
   "text": "خوابیدنمون، پوشاکمون حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 435.68,
   "end": 440.24,
   "text": "اینا همه تأثیرگذارن که باید این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 440.24,
   "end": 444.08,
   "text": "با آموزه‌های لازم تعلیم داده بشه و جلوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 444.08,
   "end": 448.32,
   "text": "برطرف، جلوش گرفته بشه و به سمت اعتدال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 448.32,
   "end": 451.18,
   "text": "حرکت کرد. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 451.18,
   "end": 457.02,
   "text": "یا اگر این نبود، اگر مزاج نبود می‌تونه آثار اعمال باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 457.02,
   "end": 459.82,
   "text": "آثار اعمال یا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 459.82,
   "end": 467.54,
   "text": "خود ما اثری‌ست که ما با گناهان و معاصی این‌ها خصوصاً خوردن‌هامون در خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 467.54,
   "end": 471.14,
   "text": "ایجاد کردیم. مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 471.14,
   "end": 474.62,
   "text": "خوراک شبهناک یا خدایی نکرده حرام خوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 474.62,
   "end": 480.2,
   "text": "اینا خیلی تأثیر عجیب تخریب کننده‌ای در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 480.2,
   "end": 483.08,
   "text": "وجود و نفس و قوای اون دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 483.08,
   "end": 489.76,
   "text": "یا اینکه نه خارج از ماست. خارج از ما منظور ظلم به دیگرانه، دل شکستن از خلق الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 489.76,
   "end": 493.6,
   "text": "و رعایت نکردن حقوق دیگران به خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 493.6,
   "end": 498.68,
   "text": "والدین، پدر و مادر یا حتی همسر، فرزندان این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 498.68,
   "end": 501.8,
   "text": "دل شکستن از اولیاء خدا که دیگه نگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 501.8,
   "end": 506.26,
   "text": "این‌ها همه که در خارج از اینا آثار اعمال ما هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 506.26,
   "end": 508.72,
   "text": "احتمال داره ما یک سال پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 508.72,
   "end": 511.78,
   "text": "ظلمی از ما به کسی صادر شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 511.78,
   "end": 515.3,
   "text": "و آثارش همینطوری ادامه داره تا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 515.3,
   "end": 518.98,
   "text": "ظلم برطرف نشه، حق ادا نشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 518.98,
   "end": 520.72,
   "text": "این مشکل وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 520.72,
   "end": 523.34,
   "text": "این مانع در مسیر سیر و سلوک وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 523.34,
   "end": 525.88,
   "text": "پس آزار، آثار اعمال باید برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 525.88,
   "end": 529.04,
   "text": "هر کسی مال حرام یا شبهناک خورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 529.04,
   "end": 532.62,
   "text": "باید با روزه گرفتن اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 532.62,
   "end": 535.7,
   "text": "گوشت و پوست و این‌هایی که براش رویده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 535.7,
   "end": 540.1,
   "text": "آب کنه و به‌هرحال این طی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 540.1,
   "end": 543.38,
   "text": "زمان بکنه. بعضی‌ها می‌بینید چهل روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 543.38,
   "end": 547.4,
   "text": "و بیشتر کمتر طول می‌کشه تا اون حالت از انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 547.4,
   "end": 550.6,
   "text": "بر سر خوراک ناپاک از بین بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 550.6,
   "end": 557.84,
   "text": "و راه سوم اینکه اگر در حضور و مراقبت جواب نگرفتیم می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 557.84,
   "end": 561.4,
   "text": "در عدم ایجاد ظرفیت و قابلیت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 561.4,
   "end": 567.98,
   "text": "ظرفیت رو یعنی تر-- می‌بینید گاهی اوقات ما در حضور و مراقبت آدم‌های موفقی هستیم، خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 567.98,
   "end": 572.52,
   "text": "عمل می‌کنیم اما در اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 572.52,
   "end": 578.46,
   "text": "سعه وجودیمون رو ارتقا بدیم و ظرفیت و قابلیت بیشتری در خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 578.46,
   "end": 582.08,
   "text": "ایجاد کنیم ضعیف هستیم یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 582.08,
   "end": 586.4,
   "text": "حرکتی نداریم در این خصوصاً در باب معارف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 586.4,
   "end": 590.28,
   "text": "اخذ معارف و خاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 590.28,
   "end": 594.92,
   "text": "خوردن نفس اولیاء الله به ما خصوصاً جلسات حضوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 594.92,
   "end": 599.62,
   "text": "این‌ها خیلی خیلی، خیلی تأثیرگذارن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 599.62,
   "end": 602.14,
   "text": "عرض شود سعه وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 602.14,
   "end": 604.86,
   "text": "سعه وجودی دو چیز ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 604.86,
   "end": 607.2,
   "text": "یکی طهارت نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 607.2,
   "end": 611.6,
   "text": "یکی ادب آموزی. همیشه هم علامه به این دو تا تأسی-- توصیه داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 611.6,
   "end": 615.1,
   "text": "ادب آموزی، تعلیم. \"یا علمهمل کتاب و الحکمه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 615.1,
   "end": 621.74,
   "text": "این درس و بحث‌ها اینا که از همین ابتدا علم فکری و حرکت فکر این‌ها انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 621.74,
   "end": 626.04,
   "text": "شدت وجودی ببخشه تا جایی که به حدس برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 626.04,
   "end": 631.58,
   "text": "و همچنین در سیر و سلوک چنان عمل کنه که بره به جذبه برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 631.58,
   "end": 639.76,
   "text": "این‌ها بهترین حالت ممکنش در حضور استاد و کسی که راه رو طی کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 639.76,
   "end": 642.32,
   "text": "و این حقایق رو چشیده به شما القا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 642.32,
   "end": 645.52,
   "text": "متأسفانه خطری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 645.52,
   "end": 648.62,
   "text": "سالک الی الله رو مخصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 648.62,
   "end": 654.18,
   "text": "تو معاصر ما تهدید می‌کنه بسنده کردن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 654.18,
   "end": 657.24,
   "text": "جلسات عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 657.24,
   "end": 661.64,
   "text": "صوتی و صدا و از راه دور و اون‌ها هم خیلی خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 661.64,
   "end": 663.44,
   "text": "کسی نمیگه این‌ها بد هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 663.44,
   "end": 668.54,
   "text": "خیلی خوب اما مرتبه عالی‌تر و اثرگذارتر این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 668.54,
   "end": 671.12,
   "text": "که هیچ‌وقت این صوت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 671.12,
   "end": 673.84,
   "text": "به اون اثر نمی‌رسن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 673.84,
   "end": 679.94,
   "text": "حضوره. حضور پیدا کردن در جلسه معرفت و معارف و نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 679.94,
   "end": 681.86,
   "text": "القا کننده به انسان خوردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 681.86,
   "end": 684.98,
   "text": "این ظرفیت رو ارتقاء وجودی می‌بخشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 684.98,
   "end": 689.56,
   "text": "که پس گاهی اوقات ما در حضور و مراقبت درست عمل می‌کنیم اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 689.56,
   "end": 693.0,
   "text": "ظرفیتمون رو خصوصاً در باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 693.0,
   "end": 697.54,
   "text": "القا و کسب حقایق و معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 697.54,
   "end": 700.1,
   "text": "و در حقیقت سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 700.1,
   "end": 704.66,
   "text": "فکری و عقلی و قلبی و این‌ها درست عمل نکردیم در حوزه معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 704.66,
   "end": 710.98,
   "text": "یا ضعیف عمل کردیم. مثل یک گرسنه ای هستیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 710.98,
   "end": 713.08,
   "text": "متأسفانه انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 713.08,
   "end": 717.46,
   "text": "عادت کردیم معده رو کوچولو نگه داشتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 717.46,
   "end": 722.38,
   "text": "یه ذره از جهت ظاهری، یه ذره غذا می‌خوریم، سیر می‌شیم، اشباع می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 722.38,
   "end": 726.22,
   "text": "یا اصلاً حس گرسنگی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 726.22,
   "end": 729.44,
   "text": "و نکته آخر اینکه اگر کسی نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 729.44,
   "end": 735.62,
   "text": "باز در حضور و مراقبت احسنش جواب خوبی نگرفت در حالی که هیچ‌کدوم از این حیثیات هم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 735.62,
   "end": 739.8,
   "text": "نه بحث مزاجش مشکل داشت، نه آثار اعمالش بود و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 739.8,
   "end": 743.87,
   "text": "ظرفیتش مشکل داشت اینجا ق-قصه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 743.87,
   "end": 746.79,
   "text": "یعنی همه این راه‌ها رو رفته باز جواب نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 746.79,
   "end": 749.81,
   "text": "چنین کسی دیگه برمی‌گرده به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 749.81,
   "end": 756.03,
   "text": "ذیغ شدن اولین جایی که در قوس نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 756.03,
   "end": 758.59,
   "text": "نطفه رنگ می‌گیره، تعلق می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 758.59,
   "end": 762.49,
   "text": "اونم در رحم و صلب پدر و مادر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 762.49,
   "end": 765.69,
   "text": "در رحم مادر و صلب پدر این رنگ می‌گیره نطفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 765.69,
   "end": 770.01,
   "text": "دیگه اینا برمی‌گرده به مسائل خلقیشون نه خلقیشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 770.01,
   "end": 772.29,
   "text": "به بحث‌های نطفه و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 772.29,
   "end": 775.91,
   "text": "که دیگه این‌ها هیچ چاره‌ای براش نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 775.91,
   "end": 780.59,
   "text": "که هرچه سختی در این مسیر طرف بکشه اجرش مضاعف‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 780.59,
   "end": 788.75,
   "text": "کسی که با سختی \"أفضل الأعمال أحمزها\" هرچی سخت‌تره اجرش بیشتره، بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 788.75,
   "end": 793.07,
   "text": "اما یه نکته رو توجه داشته باشید که این هم یک راه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 793.07,
   "end": 795.63,
   "text": "اینطور نیست که مطلقا دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 795.63,
   "end": 800.43,
   "text": "در بسته شده باشه. کسی که در رحم پدر و مادر ذیغ شده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 800.43,
   "end": 805.73,
   "text": "حالا پدر و مادر اون آداب رو رعایت نکردن، مشکلاتی ایجاد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 805.73,
   "end": 808.25,
   "text": "با توسل به صاحب مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 808.25,
   "end": 811.05,
   "text": "کن در زمان این قابل رفعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 811.05,
   "end": 813.21,
   "text": "اینو توجه داشته باشید چی عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 813.21,
   "end": 816.25,
   "text": "عبارت حساب شده‌ست با توسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 816.25,
   "end": 819.97,
   "text": "به صاحب مقام کن در زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 819.97,
   "end": 823.89,
   "text": "اینکه به امام عصر عزیز ما میگن صاحب الزمان بی دلیل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 823.89,
   "end": 830.81,
   "text": "باید اون حجت خدایی باشد که در با بدن انثری در همین زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 830.81,
   "end": 834.93,
   "text": "حاضرند که اون صاحب مقام کن هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 834.93,
   "end": 837.97,
   "text": "و البته ایشون می‌تونند تصرف کنند در ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 837.97,
   "end": 843.15,
   "text": "ماده کائنات در تمام کائنات که یکیش من و شما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 843.15,
   "end": 846.05,
   "text": "ما ن-- ما هم یک کون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 846.05,
   "end": 850.19,
   "text": "ما هم یک شیء هستیم. می‌تونن ایشون تصرف کنن و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 850.19,
   "end": 853.35,
   "text": "بذارات و آلگی‌ها و موانع رو برطرف کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 853.35,
   "end": 856.95,
   "text": "منتها خب راهش سوختن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 856.95,
   "end": 861.25,
   "text": "و توسل شدید به حضرت حجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 861.25,
   "end": 865.65,
   "text": "انشاالله که خدای منان به هممون نظر کند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 865.65,
   "end": 867.97,
   "text": "رفته به رفته بهتر عبادت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 867.97,
   "end": 870.65,
   "text": "که البته این رو هم عرض کنم این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 870.65,
   "end": 877.81,
   "text": "اِممم مشکل توجه تام در نماز و لذت بردن از نماز و ต ล อ ด مشکل عمومیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 877.81,
   "end": 880.43,
   "text": "یعنی حتی کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 880.43,
   "end": 884.17,
   "text": "راه رو درست هم رفتن به اینجا می‌رسن که می‌بینن اونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 884.17,
   "end": 886.03,
   "text": "شایسته است نتونستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 886.03,
   "end": 891.11,
   "text": "ذیغ‌هایی وجود داره. بسته شده‌هایی وجود داره، موانعی وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 891.11,
   "end": 895.47,
   "text": "این کار می‌طلبه. صاحبان همت، تلاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 895.47,
   "end": 899.89,
   "text": "و خستگی ناپذیر انشاالله یک یک موانع رو برطرف می‌کنند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 899.89,
   "end": 904.01,
   "text": "نماز امروزشون از نماز دیروزشون بهتر می‌شه و به ارجع می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 904.01,
   "end": 907.85,
   "text": "یک تجربه شیرینی هم بنده حقیر دارم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 907.85,
   "end": 911.23,
   "text": "خدمت شما قرار بدم. اونم اینکه از بچگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 911.23,
   "end": 914.07,
   "text": "خیلی دوست داشتم مثل خوبان نماز بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 914.07,
   "end": 916.91,
   "text": "این‌ها خب تو جبهه که بودیم بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 916.91,
   "end": 920.33,
   "text": "دوستان ما که شهید هم شدند اکثراً اساتید ما بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 920.33,
   "end": 925.57,
   "text": "این‌ها با اشک دائماً نماز می‌خوندند و بنده به این شوق افتاده بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 925.57,
   "end": 932.37,
   "text": "که ما هم برسیم به این‌ها. به هر حال از یکیشون که معمولاً نمازهای خوشحالی داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 932.37,
   "end": 935.19,
   "text": "بسیار حالش خوب بود و خوش بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 935.19,
   "end": 938.47,
   "text": "پرسیدم. یه سرش رو ایشون اینچنین فاش کردن که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 938.47,
   "end": 941.11,
   "text": "قبل از اینکه نماز رو شروع کنم چند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 941.11,
   "end": 946.21,
   "text": "دقیقه قبل رو سجاده می‌شینم و فکر می‌کنم به اینکه با کی می‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 946.21,
   "end": 948.99,
   "text": "صحبت کنم. اینا خیلی تاثیرگذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 948.99,
   "end": 952.69,
   "text": "خصوصا اونچه که بنده در بنده حقیر خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 952.69,
   "end": 958.27,
   "text": "شیرین تاثیر داشت و انشاالله شما هم به تاثیرات و شگرفش برسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 958.27,
   "end": 960.87,
   "text": "بهره بردن از متونی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 960.87,
   "end": 963.69,
   "text": "که پیرامون اسرار نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 963.69,
   "end": 967.51,
   "text": "فاش سخن گفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 967.51,
   "end": 970.83,
   "text": "مثلاً کتاب جامع الاسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 970.83,
   "end": 975.33,
   "text": "معلوم مرحوم ملا حیدر خیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 975.33,
   "end": 978.91,
   "text": "خیلی کتاب عالیه. کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 978.91,
   "end": 984.39,
   "text": "اسرار الصلاة شهید ثانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 984.39,
   "end": 992.17,
   "text": "بسیار کتاب خوبیست. کتاب آداب الصلاة حضرت امام علیه الرحمه یا اسرار الصلاة امیر جواد آقا ملکی تبریزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 992.17,
   "end": 996.89,
   "text": "اینا کتاب‌هایی هستند که مجموعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 996.89,
   "end": 999.01,
   "text": "بسیار کتاب‌های تأثیرگذارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 999.01,
   "end": 1002.37,
   "text": "انسان قبل از اینکه ورود کنه به نمازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1002.37,
   "end": 1004.85,
   "text": "و نمازش رو شروع کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1004.85,
   "end": 1011.91,
   "text": "این‌ها رو یه چند صفحه بخونه و بهش توجه کنه و با این توجه ورود کنه به نماز خیلی تاثیرگذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1011.91,
   "end": 1018.59,
   "text": "ضمن اینکه روح مؤلفین و اون‌هایی که این کتاب‌ها رو قلم زدن حاکم است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1018.59,
   "end": 1020.51,
   "text": "قلمشون هنوز زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1020.51,
   "end": 1023.81,
   "text": "نفسشون در این کلمات پیاده شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1023.81,
   "end": 1028.69,
   "text": "انشاالله نفس اون‌ها هم به ما هم می‌خوره و هممون بهره می‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1028.69,
   "end": 1031.71,
