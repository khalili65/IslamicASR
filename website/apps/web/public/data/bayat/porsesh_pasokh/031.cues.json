 "chapters": [
  {
   "index": 0,
   "title": "## پرسش از طهارت نفس؛ شعور همه موجودات",
   "start": 0.82,
   "end": 24.24
  },
  {
   "index": 1,
   "title": "## تسبیح اشیا دلیل شعور",
   "start": 24.24,
   "end": 110.32
  },
  {
   "index": 2,
   "title": "## سلطان وجود و اساکر اسماء؛ مزاج عالم",
   "start": 110.32,
   "end": 257.66
  },
  {
   "index": 3,
   "title": "## توحید صمدی؛ کثرات شؤون یک وجود واحد",
   "start": 257.66,
   "end": 456.55
  },
  {
   "index": 4,
   "title": "## سعه و ضیق مظاهر؛ شدت و ضعف وجود",
   "start": 456.55,
   "end": 554.93
  },
  {
   "index": 5,
   "title": "## املاء و انشاء عالم؛ من عرف نفسه",
   "start": 554.93,
   "end": 684.91
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.82,
   "end": 8.22,
   "text": "بسم الله و بالله و على مله رسول الله المستغاث بك يا حجه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.22,
   "end": 15.84,
   "text": "پرسیدن که چگونه است که در کتاب طهارت نفس از تو استاد اومده که همه موجودات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.84,
   "end": 19.1,
   "text": "من جمله حیوانات شعور دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.1,
   "end": 21.08,
   "text": "و البته رابطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.08,
   "end": 24.24,
   "text": "شهودی هم با دیگر وجودات مثل انسان دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.24,
   "end": 27.62,
   "text": "این معنی‌ش البته سؤال، سؤال بسیار مهم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.62,
   "end": 30.72,
   "text": "خطیری است و عرض عریضی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.72,
   "end": 35.0,
   "text": "ابتداً عرض می‌کنیم در خصوص شعور داشتن همه موجودات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.0,
   "end": 38.66,
   "text": "همین آیه بس که أم من شيء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.66,
   "end": 45.76,
   "text": "إلا یسبح بحمده هیچ چیزی نیست مگر اینکه تسبیح به حمد حضرت حق می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.76,
   "end": 48.78,
   "text": "و آیاتی مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.78,
   "end": 57.62,
   "text": "یسبح لله ما في السماوات وما في الأرض آنچه که در آسمان‌ها و زمین است تسبیح حضرت حق می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.62,
   "end": 61.54,
   "text": "این‌ها نشان دهنده این هست که همه اشیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.54,
   "end": 65.3,
   "text": "و همه موجودات نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.3,
   "end": 68.64,
   "text": "شعور دارند که تسبیح می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.64,
   "end": 71.16,
   "text": "و إذ الوحوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.16,
   "end": 75.9,
   "text": "حشرت حتی حیوانات وحشی هم محشور می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.9,
   "end": 80.22,
   "text": "خب این‌ها نشان می‌دهد که همه عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.22,
   "end": 82.54,
   "text": "دارای شعورند. یا آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.54,
   "end": 84.94,
   "text": "حدیث شریفی که فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.94,
   "end": 90.76,
   "text": "ما با پیغمبر می‌رفتیم و ندیدیم چیزی رو مگر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.76,
   "end": 92.6,
   "text": "به پیغمبر سلام می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.6,
   "end": 99.04,
   "text": "هیچ شیئی، هیچ سنگی، هیچ شجری، هیچ نباتی رو ندیدیم مگر اینکه به پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.04,
   "end": 101.4,
   "text": "سلام می‌گفت. پس این نشان دهنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.4,
   "end": 106.28,
   "text": "شعور اشیا هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.28,
   "end": 110.32,
   "text": "برگرفته از همان اصلی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.32,
   "end": 115.54,
   "text": "خدا رحمت کند علامه رفیعی قزوینی علیه الرحمه استاد از علمای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.54,
   "end": 123.04,
   "text": "می‌فرمودند که هر کجا سلطان وجود قدم نهاد اساكر اسماء موجودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.04,
   "end": 129.66,
   "text": "یعنی همین که شیئی وجود پیدا کرد و در دایره وجودات قرار گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.66,
   "end": 133.88,
   "text": "همه اسماء الهی در آنجا حاضرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.88,
   "end": 137.84,
   "text": "اگرچه نسبت به سعه و ضیق آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.84,
   "end": 144.92,
   "text": "شیء، ااا میزان بروز و ظهور این اسماء متفاوت‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.92,
   "end": 150.2,
   "text": "و باز هم نسبت به اینکه مزاج اون شیء چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.2,
   "end": 153.26,
   "text": "همینطور که می‌دانید عالم هم مزاج دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.26,
   "end": 156.34,
   "text": "مزاج اون شیء چگونه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.34,
   "end": 159.4,
   "text": "به همان میزان یکی از اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.4,
   "end": 163.06,
   "text": "از این اساكر و سپاهیان و لشگریان اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.06,
   "end": 169.72,
   "text": "یکیشون سلطنت و دولتش بیشتر از اسماء دیگه ظهور می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.72,
   "end": 173.54,
   "text": "لذا به اون اسم بیشتر شناخته می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.54,
   "end": 178.3,
   "text": "اما در هر حال همین که اسماء حاضرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.3,
   "end": 181.18,
   "text": "و خب می‌دانید که تمام اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.18,
   "end": 184.44,
   "text": "به یک وجه برگشت می‌کنند به اون ائمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.44,
   "end": 187.88,
   "text": "سبعه اسماء که اولیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.88,
   "end": 195.66,
   "text": "الحي هست. الحي العلیم القدیر السميع البصير",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.66,
   "end": 198.7,
   "text": "المرید المتكلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.7,
   "end": 200.98,
   "text": "خب اولیش الحي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.98,
   "end": 204.68,
   "text": "که امام هفت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.68,
   "end": 207.88,
   "text": "پیشوای همه اسماء‌اند به یک وجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.88,
   "end": 210.16,
   "text": "خب الحي خب همه زنده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.16,
   "end": 214.32,
   "text": "خب وقتی همه زنده‌اند همه حیات دارند یک پارچه حیات‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.32,
   "end": 217.62,
   "text": "که حیات کل اینطوری بهتره بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.62,
   "end": 221.72,
   "text": "حالا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.72,
   "end": 224.7,
   "text": "دار الآخرة لهي الحيوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.7,
   "end": 227.16,
   "text": "فقط آخرت نیست که حیوان داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.16,
   "end": 230.44,
   "text": "حیوان هم به یک معنا از همین حي گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.44,
   "end": 233.76,
   "text": "دنیا، دنیا هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.76,
   "end": 236.48,
   "text": "حي داره. نشئ‌ طبیعت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.48,
   "end": 239.3,
   "text": "تمام موجودات همه و همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.3,
   "end": 242.52,
   "text": "از همین حس که وجود پیدا کردن و اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.52,
   "end": 244.98,
   "text": "در اون تحقق شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.98,
   "end": 248.26,
   "text": "شعور دارند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.26,
   "end": 249.82,
   "text": "حي هستند، زنده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.82,
   "end": 256.06,
   "text": "این از این نکته که هیچ چیزی نیست مگر اینکه تسبیح به حمد حضرت حق می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.06,
   "end": 260.4,
   "text": "اما در خصوص رابطه شهودیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.4,
   "end": 266.42,
   "text": "البته این جواب این سؤال هم در دل همین بحث خیلی اجمالی که عرض کردیم اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.42,
   "end": 269.22,
   "text": "همین که دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.22,
   "end": 271.52,
   "text": "ما اگر توحید رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.52,
   "end": 277.98,
   "text": "توحید اصمد قرآنی فرض کنیم که یک وجود واحد بسيط الحقیقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.98,
   "end": 281.34,
   "text": "باشد. ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.34,
   "end": 283.38,
   "text": "که تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.38,
   "end": 289.06,
   "text": "کثرات بشوند شؤونات اون حقیقت کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.06,
   "end": 292.86,
   "text": "وقتی یک وجود واحد گرفتی توحید رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.86,
   "end": 298.98,
   "text": "وجود یعنی وجود رو یک وجود واحد گرفتی و بقیه کثرات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.98,
   "end": 304.86,
   "text": "شؤونات و تجلیات او گرفتی، تشؤونات او گرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 304.86,
   "end": 307.9,
   "text": "این چنین می‌شود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.9,
   "end": 314.2,
   "text": "همه عالم بدون استثناء از جزء و کل با هم مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.2,
   "end": 317.88,
   "text": "اجزاء یک کل هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.88,
   "end": 320.4,
   "text": "این‌ها همه با هم مرتبط هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.4,
   "end": 324.08,
   "text": "یعنی این چنین نیست که هیچ کدوم از اجزاء عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.08,
   "end": 329.7,
   "text": "از دیگر اجزاء جدا نیستند، با هم مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.7,
   "end": 334.32,
   "text": "و مثل حالا از طریق معرفت نفس بخواهی پی بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.32,
   "end": 337.74,
   "text": "مثل وجود ما که یک وجود واحدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.74,
   "end": 341.92,
   "text": "می‌گیم دست من، پای من، چشم من، سر من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.92,
   "end": 344.68,
   "text": "معده من، عروق من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 344.68,
   "end": 348.74,
   "text": "خود من، باطن من، روح من، نفس من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.74,
   "end": 350.7,
   "text": "عقل من، خیال من و، و، و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 350.7,
   "end": 354.66,
   "text": "همه استناد پیدا می‌کنند به یک من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.66,
   "end": 357.96,
   "text": "یک حقیقت است با این همه کثرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.96,
   "end": 363.0,
   "text": "اما انزل مراتب این حقیقت واحده می‌شود بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.0,
   "end": 369.13,
   "text": "مرتبه اشمع و اعلاش می‌شود حالا اون سر و سل یا به عبارتی روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.13,
   "end": 371.31,
   "text": "که مربوط است یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.31,
   "end": 375.01,
   "text": "صورت اون مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 375.01,
   "end": 377.89,
   "text": "احدیت حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.89,
   "end": 384.89,
   "text": "و این کثرات از مرتبه قلب به پایین که باز می‌شود، اون حقیقت کلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.89,
   "end": 389.25,
   "text": "اون بسیط الحقیقت باز می‌شود، می‌شود مرتبه واحدیت وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.25,
   "end": 395.21,
   "text": "حالا این یک وجود واحد است اما با همه این کثرات اما همه با هم مرتبط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.21,
   "end": 397.31,
   "text": "اگر سر انگشت شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 397.31,
   "end": 400.09,
   "text": "نوک انگشتت سوزنی بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.09,
   "end": 403.21,
   "text": "دردش تمام وجودت رو میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.21,
   "end": 405.89,
   "text": "فقط اونجا نیست که اذیت میشه، همه وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 405.89,
   "end": 411.53,
   "text": "با هم مرتبط‌اند. اگر روح شما مکدر بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.53,
   "end": 415.69,
   "text": "روح شما آزرده خاطر بشه، تمام جسم رو درگیر میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.69,
   "end": 423.75,
   "text": "یک وجود واحدند و این ارتباطی که همه اجزاء عالم نسبت به هم دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.75,
   "end": 429.35,
   "text": "که نسبت به اینکه سعة و ضیق اون‌ها چگونه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 429.35,
   "end": 432.43,
   "text": "شدند در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.43,
   "end": 435.35,
   "text": "ت-- منشئات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.35,
   "end": 440.59,
   "text": "که به قول عالمه عالم خود حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.59,
   "end": 443.67,
   "text": "عرض شود یک وجود واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 443.67,
   "end": 451.47,
   "text": "زو مراتب است. این توحید رو وقتی این چنین فرض کنی عالم زو مراتب به سعة و ضیق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 451.47,
   "end": 455.97,
   "text": "به سعة و ضیق حالا مظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.97,
   "end": 463.63,
   "text": "حالا البته ملاصدرا اون در اون ابتدا می‌فرماید که خود وجود رو مرت-- مراتب وجود رو میگیره به شدت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 463.63,
   "end": 467.51,
   "text": "به شدت و ضعف. ما بعد از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 467.51,
   "end": 473.05,
   "text": "استاد می‌فرمایند که نخیر این درست‌تره که بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 473.05,
   "end": 481.97,
   "text": "عالم به عرض شود سعة و ضیق مظاهر تفاوتش از این حیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 481.97,
   "end": 484.97,
   "text": "که نسبت به اینکه حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 484.97,
   "end": 490.19,
   "text": "در چه وجودی چه میزان ظهور کرده است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 490.19,
   "end": 493.65,
   "text": "دولت چه اسمی ظهور کرده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 493.65,
   "end": 499.27,
   "text": "و اون اسم به چه میزان به چه شدت و حدتی در این وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 499.27,
   "end": 501.63,
   "text": "ظهور کرده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 501.63,
   "end": 503.99,
   "text": "سعة و ضیق پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 503.99,
   "end": 510.71,
   "text": "حالا اگر مراتب خود وجود رو بگیریم شدت و ضعف یک معناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 510.71,
   "end": 513.83,
   "text": "مراتب مظاهر رو بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 513.83,
   "end": 516.71,
   "text": "سعة و ضیق خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 516.71,
   "end": 518.49,
   "text": "کثرات رو یک معناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 518.49,
   "end": 521.39,
   "text": "اما در حقیقت حالا هر کدوم رو بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 521.39,
   "end": 523.65,
   "text": "بحث اینجا بود که این‌ها همه با هم چی هستند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 523.65,
   "end": 528.57,
   "text": "مرتبط‌اند. کاملا با هم ارتباط دارند، ارتباط وجودی دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 528.57,
   "end": 533.99,
   "text": "و از این حیث که همه این کثرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 533.99,
   "end": 537.75,
   "text": "زنده‌اند و محل پیاده شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 537.75,
   "end": 541.19,
   "text": "اسماء الهی هستند و اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.19,
   "end": 547.73,
   "text": "برمی‌گردند به در-- به یک معنا ملکات وجودی حضرت حق هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 547.73,
   "end": 553.57,
   "text": "مثل اینکه شما وقتی چیزی رو پیاده می‌کنی، انشاء می‌نویسی، انشاء می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 553.57,
   "end": 557.51,
   "text": "املاء می‌کنی که همه عالم انشاء حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 557.51,
   "end": 560.31,
   "text": "است. املاء حضرت حق. شما وقتی روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 560.31,
   "end": 563.53,
   "text": "کتابی چیزی رو املاء و انشاء می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 563.53,
   "end": 567.05,
   "text": "حقیقت این مکتوب در ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 567.05,
   "end": 571.81,
   "text": "اون مکنون وجود شما هست حقیقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 571.81,
   "end": 578.55,
   "text": "یک حقیقت کلی که الان بروز پیدا کرد این همه کلمات و جملات و مفاهیم رو کتاب ریخته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 578.55,
   "end": 581.17,
   "text": "این‌ها بی‌ارتباط با هم نیستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 581.17,
   "end": 587.45,
   "text": "که اون همون ملکات وجودی شما که در ثغ اظهار تو هستند همون اسماء‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 587.45,
   "end": 589.31,
   "text": "در حضرت حق همین چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 589.31,
   "end": 592.69,
   "text": "حالا بخوای باز از مزی-- زیر معرفت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 592.69,
   "end": 597.11,
   "text": "که من عرف نفسه فقط عرف ربّ این رو بفهمی این مثال رو زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 597.11,
   "end": 599.59,
   "text": "حضرت حق هم یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 599.59,
   "end": 603.61,
   "text": "ذاته. حالا اگر بخوای بگیری ذات بی‌مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 603.61,
   "end": 606.71,
   "text": "بعد مرتبه بعدی می‌شود اسماء و صفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 606.71,
   "end": 610.63,
   "text": "که می‌شود همان اسماء و صفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 610.63,
   "end": 613.29,
   "text": "در حقیقت ملکات وجودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 613.29,
   "end": 615.95,
   "text": "وجودی حق که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 615.95,
   "end": 618.99,
   "text": "محل صدور افعال‌اند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 618.99,
   "end": 623.65,
   "text": "میشه گفت مرتبه بعد از ذات قرار دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 623.65,
   "end": 628.61,
   "text": "که همه این کثرات برگشت می‌کنند به اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 628.61,
   "end": 632.03,
   "text": "و چون این یک حقیقت کلیه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 632.03,
   "end": 636.51,
   "text": "حالا شما هر کدوم از این مظاهر و خلاق رو که بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 636.51,
   "end": 640.23,
   "text": "یک جزء‌اند، یک شأن‌اند، یک طور‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 640.23,
   "end": 643.19,
   "text": "خب عالم اطوار وجودی حق بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 643.19,
   "end": 645.73,
   "text": "یک طور از حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 645.73,
   "end": 648.55,
   "text": "یک مجلان محل تجلی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 648.55,
   "end": 654.95,
   "text": "یک ظلن یعنی حدی از ازلال‌اند، سایه‌ای از اون اصل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 654.95,
   "end": 657.19,
   "text": "یک شرحی از اون متن‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 657.19,
   "end": 659.77,
   "text": "یک قدری به اندازه‌ای از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 659.77,
   "end": 662.69,
   "text": "قضا و کلی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 662.69,
   "end": 665.81,
   "text": "از این حیث که با هم مرتبط‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 665.81,
   "end": 668.25,
   "text": "لذا شهود هم دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 668.25,
   "end": 671.85,
   "text": "شاهدند بر هم. چون یک حقیقت کلیه‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 671.85,
   "end": 675.23,
   "text": "یک وجود واحدند. ان‌شاءالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 675.23,
   "end": 679.03,
   "text": "خدای منّان عاقبت هممون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 679.03,
   "end": 683.01,
   "text": "سر این سفره معارف با عمل خالصانه به خیر کند.",
