 "chapters": [
  {
   "index": 0,
   "title": "## فشارِ بی‌سعه در عبادت و فروپاشیِ حال",
   "start": 1.1,
   "end": 155.18
  },
  {
   "index": 1,
   "title": "## زیربنای نظری پیش از عمل",
   "start": 155.18,
   "end": 175.22
  },
  {
   "index": 2,
   "title": "پیامبر همهٔ این آیات را از علمِ لدنیِ خدای حکیمِ علیم تلقی کرده و همه بر اساس حکمت است. لذا می‌فرماید:",
   "start": 175.22,
   "end": 320.44
  },
  {
   "index": 3,
   "title": "## خطرِ میانِ اقبال و ادبار و سه کتابِ تجلی",
   "start": 320.44,
   "end": 375.92
  },
  {
   "index": 4,
   "title": "برای برطرف شدنِ احساس پوچی قطعاً باید همان حکمت را پیش گرفت که گمشدهٔ مؤمن است:",
   "start": 375.92,
   "end": 505.02
  },
  {
   "index": 5,
   "title": "## برنامه‌ریزی بر مدارِ سعه و آدابِ روز و شب",
   "start": 505.02,
   "end": 885.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.1,
   "end": 5.92,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.92,
   "end": 8.88,
   "text": "المستغاث بك يا حضرة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.88,
   "end": 12.4,
   "text": "در پاسخ به سؤال عزیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.4,
   "end": 16.6,
   "text": "فرمودن: یک مدتی در حفظ قرآن تلاش می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.6,
   "end": 18.8,
   "text": "به خودشون خیلی فشار میاوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.8,
   "end": 21.64,
   "text": "بعد حالشون به هم می‌ریزه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.64,
   "end": 25.02,
   "text": "در حقیقت اون حال خوشی که داشتن از بین میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.02,
   "end": 33.54,
   "text": "و اظهار کردند که دیگه تو امور معنوی نماز خوندن و این عبادیات متعارف حال معنوی خوشی ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.54,
   "end": 38.56,
   "text": "یا حال روحیم خوب نیست، احساس پوچی می‌کنم و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.56,
   "end": 42.38,
   "text": "و البته علاقه به کتب معنوی و اخلاقی دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.38,
   "end": 49.56,
   "text": "فرمودن که صحبت‌های روان آقای قرائتی رو دوست دارم چون ساده‌ست و کاربردی و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.56,
   "end": 53.78,
   "text": "زمان‌بندی روزانه خواستن برای خواب، مطالعه و غیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.78,
   "end": 55.72,
   "text": "ببینید عزیزم چند تا نکته رو عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.72,
   "end": 59.06,
   "text": "عزیزی که این سؤال رو پرسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.06,
   "end": 62.14,
   "text": "امیدوارم جواب بهشون برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.14,
   "end": 67.82,
   "text": "این که اولا انسان نباید در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.82,
   "end": 72.98,
   "text": "عبادیات خارج از سعه وجودیش کاری بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.98,
   "end": 76.98,
   "text": "نتیجه‌ش می‌شه همین. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.98,
   "end": 80.66,
   "text": "ما یک حالت اقبال داریم، یک ادبار داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.66,
   "end": 83.96,
   "text": "یکی هم بینابین این دوست که همه هم براشون پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.96,
   "end": 89.96,
   "text": "این‌که انسان قلب دارد، قلب دائما در انقلاب است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.96,
   "end": 93.06,
   "text": "منقلب است و خداست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.06,
   "end": 96.22,
   "text": "مقلب القلوب والأبصار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.22,
   "end": 100.62,
   "text": "باید به خدا پناه ببرد. وقتی حالت اقبال داره انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.62,
   "end": 104.76,
   "text": "یعنی روی آورده، در دلش باز شده، حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.76,
   "end": 110.36,
   "text": "انفتاح داره، فتح داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.36,
   "end": 113.02,
   "text": "چنین کسی خب بست وجودی پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.02,
   "end": 117.38,
   "text": "خب اهل بیت علیهم الصلاة والسلام هم فرمودن رو کنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.38,
   "end": 119.98,
   "text": "عبادات تا اونجایی که دوست داره می‌چشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.98,
   "end": 124.44,
   "text": "این‌ها انجام بده. ولی وقتی حالت ادبار داره، پشت کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.44,
   "end": 129.12,
   "text": "و این‌ها فرمودن صرفا به انجام واج-- واجباتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.12,
   "end": 132.22,
   "text": "کفایت کنه که زدگی براش ایجاد نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.22,
   "end": 136.38,
   "text": "همچنین در، در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.38,
   "end": 140.4,
   "text": "کارهای مستحبی مثل حفظ قرآن، مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.4,
   "end": 142.34,
   "text": "حتی خواندن کتاب‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.34,
   "end": 145.54,
   "text": "این‌ها باید انسان به سعه وجودیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.54,
   "end": 152.22,
   "text": "توجه کنه که به حالت ذیق نیفته و الا جواب عکس می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.22,
   "end": 154.82,
   "text": "یکی از اشتباهاتی که ما داریم همیشه همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.82,
   "end": 161.54,
   "text": "البته این‌ها غالبا برمی‌گرده به این‌که ما از ابتدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.54,
   "end": 166.58,
   "text": "بر اثر نداشتن یک معلم، یک استاد، یک مرشد خوب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.58,
   "end": 171.7,
   "text": "سیر حکمت نظری و عرفان نظری رو اونطور که باید پیش نگرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.7,
   "end": 173.68,
   "text": "یعنی با عقل جلو نرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.68,
   "end": 179.58,
   "text": "صرفا با قوه خیال و وهم رفتیم جلو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.58,
   "end": 184.06,
   "text": "تنها به عبادیات و اخلاقیات توجه کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.06,
   "end": 188.12,
   "text": "زیربنای فکری‌مون محکم نبوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.12,
   "end": 190.46,
   "text": "لذا این مشکلات برامون پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.46,
   "end": 192.94,
   "text": "غالب کسانی که بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.94,
   "end": 197.48,
   "text": "تحصیل و بدون چشیدن حقایق پنهانی عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.48,
   "end": 200.92,
   "text": "میرن سراغ در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.92,
   "end": 210.2,
   "text": "حکمت و عرفان عملی بدون این که نظری رو پیش بگیرن، بدون این که زانو بزنن پای درس یک استادی، کتاب خوبی، جامعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.2,
   "end": 214.4,
   "text": "این‌ها، این گرفتاری‌ها براشون پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.4,
   "end": 220.52,
   "text": "بخصوص جوان‌ها که به هر حال پرده زود براشون کنار میره، انکشافاتی رخ میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.52,
   "end": 223.48,
   "text": "چیزهایی از عالم براشون مشهود می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.48,
   "end": 225.98,
   "text": "بعد این‌ها نمی‌تونن اینو هضم کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.98,
   "end": 228.64,
   "text": "زیربنای فکری‌شون درست نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.64,
   "end": 231.28,
   "text": "بعد دچار انحرافات می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.28,
   "end": 233.44,
   "text": "باید انسان سعه وجودیش رو دربیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.44,
   "end": 236.76,
   "text": "لذا قرآن با یک حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.76,
   "end": 239.72,
   "text": "خاصی بر اساس حکمت چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.72,
   "end": 246.06,
   "text": "حکیم علی الاطلاق اینو فرموده این آیات رو که \"إنك لَتلقى القرآن من لدن حكيم عليم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.06,
   "end": 251.96,
   "text": "حکیم علیم. پیغمبر تو تلقی کردی همه این آیات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.96,
   "end": 256.34,
   "text": "از علم لدنی حکیم علیم، خدایی که حکیم علیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.34,
   "end": 261.64,
   "text": "همه بر اساس حکمت است. لذا می‌فرماید: \"لا يكلف الله نفسا إلا وسعها.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.64,
   "end": 265.34,
   "text": "نه فرموده إلا بطاقتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.34,
   "end": 269.74,
   "text": "نه فرموده به میزان طاقت‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.74,
   "end": 271.58,
   "text": "إلا وسعها نه طاقتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.58,
   "end": 276.0,
   "text": "یه وقت هست ما می‌تونیم از اینجا مثلا تا پنج کیلومتر اونور رو بدوییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.0,
   "end": 280.32,
   "text": "با سرعت بدوییم. طاقتشو داریم بریم برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 280.32,
   "end": 286.98,
   "text": "اما چون سعه وجودیش رو نداریم وقتی رسیدیم اونجا می‌افتیم حالمون بد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.98,
   "end": 290.22,
   "text": "سعه کمتر از طاقت है.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.22,
   "end": 292.46,
   "text": "لذا قرآن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.46,
   "end": 296.1,
   "text": "در حقیقت خدا در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.1,
   "end": 301.28,
   "text": "به بنده‌ش کمک کرده گفته به میزان سعه حرکت کن نه طاقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.28,
   "end": 306.0,
   "text": "شاید تو طاقت بیاری حتی کل قرآن رو هم حفظ کنی، طاقت بیاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.0,
   "end": 310.86,
   "text": "به قولی دندون رو جیگر بذاری شب تا صبح عبادت کنی این دعا، اون دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.86,
   "end": 312.54,
   "text": "اما آخرش زدگی ایجاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.54,
   "end": 316.26,
   "text": "این فایده‌ای نداره چون مخالف سعه وجودی تو بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 316.26,
   "end": 319.94,
   "text": "هر کاری می‌کنیم باید با نشاط باشد عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.94,
   "end": 322.28,
   "text": "البته خطر بین این دو تاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.28,
   "end": 326.94,
   "text": "بین حالت اقبال و ادبار که آدم نمی‌دونه چه حالتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.94,
   "end": 329.64,
   "text": "نمی‌دونه اقبال داره یا ادبار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.64,
   "end": 331.96,
   "text": "این خیلی خطرناکه. مثل کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.96,
   "end": 335.42,
   "text": "مریضه، اشتهاش از بین رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.42,
   "end": 339.12,
   "text": "و ذائقه‌ش کار نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.12,
   "end": 341.92,
   "text": "گرسنه است اما نمی‌دونه که گرسنه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.92,
   "end": 343.52,
   "text": "حالت گرسنگی براش ایجاد نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.52,
   "end": 346.0,
   "text": "خیلی خطرناکه. باید چی کار کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.0,
   "end": 349.22,
   "text": "باید بهش، بهش سرم بزنن به زور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.22,
   "end": 355.44,
   "text": "و در حقیقت بزرگان فرمودن کسی که اینطوریه بیشتر در اجتماعات اهل ایمان حاضر بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.44,
   "end": 358.8,
   "text": "تا رفته رفته این حالت ازش برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.8,
   "end": 362.9,
   "text": "برای برطرف شدن حالت احساس پوچی قطعا باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.9,
   "end": 371.7,
   "text": "انسان همین حکمت رو که گم شده مؤمن هست رو پیش بگیره که ادعوا الی سبيل ربک بالحکمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.7,
   "end": 375.78,
   "text": "بعد والمقوله الحسنه وجادلهم بالتی هي احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 375.78,
   "end": 378.08,
   "text": "این حکمت باعث می‌شه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 378.08,
   "end": 381.7,
   "text": "باطن موجودات رو، باطن عالم رو، باطن خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.7,
   "end": 388.36,
   "text": "در کتابخانه عالم در اون سه تا کتابی که تجلی اعظم حضرت حق است قرآن انفسى و جانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.36,
   "end": 391.56,
   "text": "کتاب وجودی خودت ورق ورق بخوانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.56,
   "end": 394.88,
   "text": "قرآن آفاقی و هستی که این دو هر دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.88,
   "end": 397.66,
   "text": "قرآن تکوینی نظام هستی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.66,
   "end": 401.04,
   "text": "آسمان و زمین و آنچه ما بین این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.04,
   "end": 404.5,
   "text": "این کلمات وجودی رو، این کتاب آفاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 404.5,
   "end": 408.54,
   "text": "حق رو، این قرآن آفاقی رو بخواند، قرائت کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.54,
   "end": 414.76,
   "text": "و قرآن کتبی و تدوینى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 414.76,
   "end": 420.96,
   "text": "که این انا انزلناه في ليلة القدر آنچه که بر قلب و جان پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 420.96,
   "end": 426.58,
   "text": "نازل شده است تنزل پیدا کرده به انزل مراتب که همین لفظ است در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.58,
   "end": 432.82,
   "text": "قرآن انسان از این شروع کند نسبت به صعه وجودیش در کتابخانه این سه تا کتابی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 432.82,
   "end": 439.56,
   "text": "از حضرت حق تجلی کرده بخواند و بالا برود تا انشاالله احساس پوچیش برطرف بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.56,
   "end": 445.84,
   "text": "به غیر از این یعنی انسان فقط صرفاً کتاب تدوینى یعنی قرآن لفظی رو بخواند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.84,
   "end": 448.9,
   "text": "اما سراغ کتاب آفاقی و هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.9,
   "end": 455.1,
   "text": "یا کتاب انفسى و جان خودش نرود، سیر معرفت نفس رو پیش نگیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.1,
   "end": 460.2,
   "text": "قطعاً باز دچار پوچی می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.2,
   "end": 463.86,
   "text": "و البته خوبه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 463.86,
   "end": 469.94,
   "text": "توجه بکنه به صحبت‌هایی که به قول عزیزمون کاربردی است مثل صحبت‌های آقای قرائتی و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 469.94,
   "end": 471.66,
   "text": "اما نباید به همین بسنده کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 471.66,
   "end": 475.76,
   "text": "این‌ها باید به منزله‌ی پلی یا پله‌ای باشد برای ارتقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.76,
   "end": 479.1,
   "text": "قرآن تماماً ارتقای وجودی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 479.1,
   "end": 483.06,
   "text": "تعال، ندای تعالایی می‌دهد و آخر هم انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 483.06,
   "end": 487.54,
   "text": "وقتی از این دنیا میریم میگن اقرأ ورقب بخوان و بالا برو دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 487.54,
   "end": 491.42,
   "text": "لذا این باید مقدمه باشه نه اینکه دیگه همین جا بمونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 491.42,
   "end": 494.32,
   "text": "هی پله به پله بالا بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 494.32,
   "end": 502.3,
   "text": "و انشاالله قامزات علوم رو هم به امید خدا کشف کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 502.3,
   "end": 505.02,
   "text": "و عرض شود خدمتتون که رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 505.02,
   "end": 508.78,
   "text": "زمان‌بندی و این‌ها هم که عزیزمون فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.78,
   "end": 514.62,
   "text": "زمان‌بندی باز باید بر اساس صعه وجودی خود شخص پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.62,
   "end": 519.38,
   "text": "ببینید انسان چه صعه وجودیش، چه ذیق وجودیش همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 519.38,
   "end": 523.52,
   "text": "با توجه به نطفه از نطفه شروع می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 523.52,
   "end": 528.08,
   "text": "تشکیل النطفه دیگه حالات مادر، پدر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 528.08,
   "end": 531.56,
   "text": "نفس‌هایی که بهش می‌خوره. اولین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 531.56,
   "end": 537.12,
   "text": "تحریکی که قوای اون حواس ظاهریش براش اتفاق می‌افته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 537.12,
   "end": 540.62,
   "text": "تحریکات این قوا، در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 540.62,
   "end": 543.58,
   "text": "اولین باری که قوه چشاییش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 543.58,
   "end": 546.52,
   "text": "می‌چشه، قوه بویاییش می‌بوئه، قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 546.52,
   "end": 551.9,
   "text": "لامسه‌ش لمس می‌کنه، قوه سامعه‌ش می‌شنود و قوه باصرش می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 551.9,
   "end": 554.6,
   "text": "اولین ادراکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 554.6,
   "end": 557.32,
   "text": "حواس پنجگانه‌ش به قول علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 557.32,
   "end": 562.2,
   "text": "تا ابد الدهر تمام تمثلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 562.2,
   "end": 565.7,
   "text": "و در حقیقت حتی خواب‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 565.7,
   "end": 570.06,
   "text": "و کم و کیف برزخش رو، انشائات نفس ناطقه‌ش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 570.06,
   "end": 573.94,
   "text": "می‌سازه. خیلی اینا می‌شه خمیرمایه بعد او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 573.94,
   "end": 575.86,
   "text": "لذا اینا می‌خوام عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 575.86,
   "end": 578.34,
   "text": "اهمیت این‌ها چقدر مهمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 578.34,
   "end": 581.56,
   "text": "که این‌ها همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 581.56,
   "end": 586.8,
   "text": "در این که انسان ذیق وجودی پیدا کنه یا صعه وجودی مؤثره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 586.8,
   "end": 592.38,
   "text": "بعد دیگه حالا غذایی که پدر مادر لقمه‌ای که بر دهانش می‌گذارن، حالات خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 592.38,
   "end": 595.36,
   "text": "جایی که زندگی می‌کنه، محیط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 595.36,
   "end": 597.88,
   "text": "عرض شود، اِاِاِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 597.88,
   "end": 600.36,
   "text": "کسانی که دور و برش هستند، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 600.36,
   "end": 606.78,
   "text": "مکتبی که درش درس می‌گیره، معلمش، این‌ها همه تأثیرگذار هستند تا ابد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 606.78,
   "end": 610.86,
   "text": "بر او که این‌ها یا ذیق در او ایجاد می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 610.86,
   "end": 615.42,
   "text": "یا صعه. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 615.42,
   "end": 622.72,
   "text": "باید هر کسی کـ، اِاِاِ این کتاب وجودی خودش رو بخواند و برای خودش برنامه‌ریزی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 622.72,
   "end": 628.96,
   "text": "به وقت کسی هست یه دیس غذا می‌خوره اما صعه وجود-- این بدنش نیاز داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 628.96,
   "end": 635.06,
   "text": "پرخوری هم نکرده. اما یه کسی شاید یه پیاله بخوره نسبت به نیاز بدنش پرخوری هم کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 635.06,
   "end": 638.42,
   "text": "شاید کسی مثلاً ده ساعت بخوابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 638.42,
   "end": 640.74,
   "text": "به اندازه خوابیده باشه اما کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 640.74,
   "end": 643.56,
   "text": "شش ساعت بخوابه زیاد خوابیده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 643.56,
   "end": 649.02,
   "text": "این‌ها آلارم‌هایی رو که در نظام تکوین خدا قرار داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 649.02,
   "end": 652.66,
   "text": "بهترین کمک کننده است برای برنامه‌ریزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 652.66,
   "end": 654.96,
   "text": "انسان. اینکه مثلاً آقا گرسنت شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 654.96,
   "end": 661.16,
   "text": "خب غذا بخور. قبل از اینکه سیر بشی دست از غذا بکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 661.16,
   "end": 666.28,
   "text": "تشنه‌ات شد آب بخور. قبل از اینکه سیراب بشی دست از آب بکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 666.28,
   "end": 668.58,
   "text": "اینا دستورات پیغمبر اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 668.58,
   "end": 671.76,
   "text": "نسبت به خودت باید پیاده کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 671.76,
   "end": 674.0,
   "text": "یا عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 674.0,
   "end": 678.32,
   "text": "خواب همینطور. آقا هروقت خوابت گرفت خب بخواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 678.32,
   "end": 681.28,
   "text": "مهممون برطرف شدن زهر خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 681.28,
   "end": 686.12,
   "text": "مثلاً شما اول که خوابت میره پنج دقیقه، ده دقیقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 686.12,
   "end": 690.2,
   "text": "یه چرتی بر تو عارض می‌شه که بین این ور و اون ور هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 690.2,
   "end": 694.1,
   "text": "اون زهر خوابه. وقتی گرفته شد بلند شدی می‌بینی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 694.1,
   "end": 697.62,
   "text": "نشاط داری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 697.62,
   "end": 701.58,
   "text": "وقتی که خوابیدی هر زمان احساس کردی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 701.58,
   "end": 707.3,
   "text": "سیراب شدی از خواب یعنی دیگه نیاز جسمیت برطرف شد، بسم الله پاشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 707.3,
   "end": 712.5,
   "text": "و البته میگم این‌ها رو باید نسبت به صعه وجودیمون خودمون بسنجیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 712.5,
   "end": 716.6,
   "text": "اما خیلی چیزا هم هست که در این‌ها تأثیرگذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 716.6,
   "end": 727.68,
   "text": "مثلاً در خواب انسان اگر کسی غذا خورد تا حداقل دو تا سه ساعت بعدش نباید بخوابه که اگر بخوابه قوه خیال به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 727.68,
   "end": 733.66,
   "text": "بازیگری‌شو شروع میکنه چون تمام قوا به جای استراحت باید بپردازن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 733.66,
   "end": 742.76,
   "text": "هضم غذا و به جای اینکه نفس تعلق خاطرش رو به حداقل برسونه به بدن که بتونه به اون، با اون ور مرتبط بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 742.76,
   "end": 745.84,
   "text": "مجبوره ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 745.84,
   "end": 749.48,
   "text": "هنوز تعلق خاطرش رو نسبت به بدن داشته باشه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 749.48,
   "end": 754.32,
   "text": "فعل و انفعالات هضم و جف-- جذب و دفن و این‌ها-- دف و این‌ها داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 754.32,
   "end": 756.36,
   "text": "لذا نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 756.36,
   "end": 758.72,
   "text": "آزاد بشه. نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 758.72,
   "end": 764.78,
   "text": "ارتقا پیدا کنه. بعد انسان هرچی می‌خوابه می‌بینه بدتر، آشفته‌تر، خسته‌تر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 764.78,
   "end": 767.2,
   "text": "کدرتره. اینا آثار--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 767.2,
   "end": 770.5,
   "text": "اینا رو می‌خوام عرض کنم که یه سری آداب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 770.5,
   "end": 778.56,
   "text": "این‌ها رو باید آدابش رو در صحيفه المتقين مرحوم مجلسی علیه الرحمه بررسی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 778.56,
   "end": 781.9,
   "text": "و عم-- کتاب‌های این چنینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 781.9,
   "end": 786.64,
   "text": "به هر حال یکی از بهترین کتاب‌هایی که از تعلمه‌ام خیلی توصیه دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 786.64,
   "end": 793.82,
   "text": "مفتاح الفلاح شیخ بهائیه \"فی عمل اليوم واللیلة من الواجبات و المستحبات\" و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 793.82,
   "end": 797.8,
   "text": "این کتاب بسیار خوبیست برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 797.8,
   "end": 802.14,
   "text": "اینکه انسان شروع کنه روز و شبش رو چگونه بگذرونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 802.14,
   "end": 804.0,
   "text": "برای برنامه خواستن عزیزان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 804.0,
   "end": 812.0,
   "text": "اینا خیلی خوبه. فلاح السائل و نجاة المسائل فی عمل اليوم واللیلة مال سید ابن طاووس خیلی عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 812.0,
   "end": 816.16,
   "text": "عُدَّة الداعی و نجاة الساعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 816.16,
   "end": 818.0,
   "text": "که معروفه به عُدَّة الداعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 818.0,
   "end": 822.42,
   "text": "مال ابن فهد هلی. بغل خیمه گاه امام حسین کربلا دفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 822.42,
   "end": 826.44,
   "text": "خیلی عالم جلیل القدر و عجیبی بودن ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 826.44,
   "end": 831.26,
   "text": "در موضوع ادعیه و اخلاق و آداب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 831.26,
   "end": 835.08,
   "text": "این کتاب خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 835.08,
   "end": 838.12,
   "text": "اقبال سید ابن، سید ابن طاووس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 838.12,
   "end": 841.58,
   "text": "در ادعیه اینا خیلی خوبه. اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 841.58,
   "end": 846.42,
   "text": "در حقیقت برنامه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 846.42,
   "end": 851.4,
   "text": "شاید بشه گفت جمع و جور تری در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 851.4,
   "end": 856.72,
   "text": "حالا در یک برنامه، در یک تک برنامه بخوان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 856.72,
   "end": 863.46,
   "text": "می‌تونن رجوع کنن به کتاب نامه و برنامه‌های از تعلمه‌ه حسن زاده که هر کدوم یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 863.46,
   "end": 866.84,
   "text": "نامه‌ایست به عزیزی از عزیزانشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 866.84,
   "end": 869.86,
   "text": "یا کتاب حامل اسرار ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 869.86,
   "end": 877.36,
   "text": "درش برنامه‌های خیلی جالب و خوبی دارن که مجموعاً میشه انسان به این‌ها رو مراقبت کنه، توجه کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 877.36,
   "end": 883.2,
   "text": "عمل کنه. انشاالله که خدای منّان هممون رو یاری برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 883.2,
   "end": 885.9,
   "text": "موفق باشیم. والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}