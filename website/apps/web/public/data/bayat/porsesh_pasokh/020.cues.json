 },
 "chapters": [
  {
   "index": 0,
   "title": "## قضا و قدر؛ متن و شرح",
   "start": 0.94,
   "end": 262.94
  },
  {
   "index": 1,
   "title": "## علمِ امیر و آیهٔ محو",
   "start": 262.94,
   "end": 298.52
  },
  {
   "index": 2,
   "title": "## اثرِ توجّه به قضا؛ رضایت",
   "start": 298.52,
   "end": 445.7
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.94,
   "end": 3.82,
   "text": "اما سؤال بعدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.82,
   "end": 7.84,
   "text": "محقق عزیزمون پیرامون صحیفه داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.84,
   "end": 12.14,
   "text": "در خصوص نقش قضای الهی در زندگی انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.14,
   "end": 16.08,
   "text": "یا مثلاً معرفی قضای الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.08,
   "end": 20.28,
   "text": "اهمیت حالا قضای الهی در زندگی انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.28,
   "end": 26.0,
   "text": "قضا و قدر یک بحث بسیار پیچیده‌ایست که بزرگان رو به خودش چنان مشغول کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.0,
   "end": 30.48,
   "text": "چنان کتاب‌ها نوشتند و درس و بحث‌ها که خدا میدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.48,
   "end": 34.94,
   "text": "اساساً من خیلی اجمالاً عرض کنم که قضا اون متنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.94,
   "end": 38.74,
   "text": "قضا با واو، صاد، زاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.74,
   "end": 42.44,
   "text": "قضا متنه و اصله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.44,
   "end": 46.44,
   "text": "که قدر می‌شه شرحش، می‌شه فرع قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.44,
   "end": 52.52,
   "text": "یا در حقیقت ظهورمون. قضا حتمیه اما قدر غیر حتمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.52,
   "end": 56.32,
   "text": "قضا من مثال عرض می‌کنم برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.32,
   "end": 60.98,
   "text": "متوجه اهمیت و اصل اساساً معنای قضا بشویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.98,
   "end": 64.14,
   "text": "مثلاً خدای منّان مرگ رو حتمی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.14,
   "end": 68.24,
   "text": "قضای الهی مرگه. که همه قراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.24,
   "end": 71.5,
   "text": "بمیرن. \"کل نفس ذائقه الموت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.5,
   "end": 73.42,
   "text": "همه قراره بچشن این مرگ رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.42,
   "end": 80.52,
   "text": "خب؟ اما یه کسی میاد با گناه کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.52,
   "end": 83.44,
   "text": "عمر اصطلاحاً می‌گیم عمر خودش رو کم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.44,
   "end": 85.08,
   "text": "زودتر مرگ میاد سراغش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.08,
   "end": 91.0,
   "text": "این‌که مرگ زودتر اومد سراغش، این زودتر اومدنه دیگه قضا نیست، این قدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.0,
   "end": 94.08,
   "text": "چرا؟ وجود خودش رو ضعیف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.08,
   "end": 95.94,
   "text": "به ضعیف وجودی گرفتار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.94,
   "end": 99.34,
   "text": "خدا هم سریع بردش. بردنشم باز به رحمت خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.34,
   "end": 101.98,
   "text": "\"يا من سبقت رحمته غضبه.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.98,
   "end": 108.5,
   "text": "غضب خدا هم که جهنم اگر معنو کنیم باز \"سبقت رحمته غضبه\" رحمتش سبقت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.5,
   "end": 110.96,
   "text": "یعنی اونم رحمت خداست باز جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.96,
   "end": 115.86,
   "text": "یا می‌کشش سریع می‌بردش در تأدیب‌نامه، تأدیب‌خانه خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.86,
   "end": 120.86,
   "text": "مؤدبش کنه، آدابش بالاخره ادبش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.86,
   "end": 124.94,
   "text": "یا حالا اسمشو می‌ذاریم عذاب. مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.94,
   "end": 128.62,
   "text": "طلایی که تو بوته می‌ذارن و آتشش می‌زنن تا ناخالص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.62,
   "end": 133.34,
   "text": "ناخالصی‌هاش جدا بشه. پس یا نه برعکس طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.34,
   "end": 139.38,
   "text": "اهل عبادت و تقوا و معرفت و معنویت رو می‌بینی عمرشو خدا بیشتر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.38,
   "end": 141.1,
   "text": "اگرچه قراره بالاخره بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.1,
   "end": 143.52,
   "text": "قضا اینه که قطعاً بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.52,
   "end": 147.44,
   "text": "اهدی زنده نمی‌مونه. اما چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.44,
   "end": 150.76,
   "text": "این با گناه ضعیف شد، زود بردنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.76,
   "end": 153.02,
   "text": "اون با ثواب چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.02,
   "end": 158.96,
   "text": "سهش پیدا کرد. سه وجودی پیدا کرد، نگهش داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.96,
   "end": 163.46,
   "text": "لذا معمولاً آدم‌هایی که با تقوا هستن معنوی، شما ببینید بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.46,
   "end": 167.52,
   "text": "مراجع، علما، بزرگان، کمالین، اینا، عرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.52,
   "end": 169.2,
   "text": "همه ریش سفید می‌شن غالباً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.2,
   "end": 174.2,
   "text": "ببینیم اگرچه استثنائاتی پیش بیاد یا مثلاً شهیدش کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 174.2,
   "end": 175.92,
   "text": "واللا. به هر حال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 175.92,
   "end": 183.16,
   "text": "پس این چیزی که حالا در شب‌های قدر هم میگن اتفاق می‌افته عزیزان، اون مربوطه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.16,
   "end": 185.34,
   "text": "در حقیقت قدر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.34,
   "end": 187.46,
   "text": "لوح محو اثبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.46,
   "end": 190.48,
   "text": "نسبت به قدر شخص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 190.48,
   "end": 194.28,
   "text": "ثبت می‌شه. قضا نیست، قضا حتمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.28,
   "end": 200.72,
   "text": "حالا برای نسبت به اعمال سال طرف و مخصوصاً اون شب قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.72,
   "end": 206.1,
   "text": "حالا خیراتی یا برعکسشو خدا براش چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 206.1,
   "end": 212.2,
   "text": "ثبت می‌کنه. اصطلاحاً به سر القدرش نگاه می‌کنه و مقدراتشو براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.2,
   "end": 218.48,
   "text": "مشخص می‌کنه که همون بر اساس آیه \"یمحل ما یشاء و یثبت\" تغییر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 218.48,
   "end": 220.3,
   "text": "خدا محو می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.3,
   "end": 222.94,
   "text": "و اثبات می‌کند. محو اثبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.94,
   "end": 226.12,
   "text": "مثل این‌که الان آب اثباته، آبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.12,
   "end": 229.84,
   "text": "اثباته دیگه، ثبوته. اما این آب بخار که شد چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.84,
   "end": 232.06,
   "text": "آب دیگه بخار شد. آب دیگه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.06,
   "end": 235.06,
   "text": "دیگه از ثبوت خارج شد، محو شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.06,
   "end": 237.88,
   "text": "بخار ثابت شد. این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.88,
   "end": 243.7,
   "text": "یعنی نسبت به اون فعل و انفعالات و کردار و اعمال و رفتارش و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.7,
   "end": 245.98,
   "text": "تمام آنچه که می‌خورد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 245.98,
   "end": 250.26,
   "text": "می‌شنود، می‌چشد، لمس می‌کند، می‌بیند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.26,
   "end": 253.0,
   "text": "تخیلاتش، توهماتش، تعقلاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.0,
   "end": 255.96,
   "text": "همه و همه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.96,
   "end": 262.6,
   "text": "لوح محو اثباتش تأثیر داره که چی براش محو بشود و چی اثبات بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.6,
   "end": 265.56,
   "text": "لذا امیرالمؤمنین صلوات الله علیه فرمودند که من تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.56,
   "end": 271.62,
   "text": "قیام قیامت رو می‌تونم برای شما بگم چه اتفاقاتی می‌افته بر اساس علم الهی که به ما داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.62,
   "end": 274.32,
   "text": "اما یه آیه دست و پا ما رو بسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.32,
   "end": 276.3,
   "text": "اشاره به همین آیه کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 276.3,
   "end": 280.24,
   "text": "چون کارهای مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.24,
   "end": 282.52,
   "text": "خط می‌کشه روی اون‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 282.52,
   "end": 284.82,
   "text": "روی اون مقدرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.82,
   "end": 287.2,
   "text": "محو می‌شه و چیز دیگه‌ای اثبات می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 287.2,
   "end": 290.14,
   "text": "پس آنچه که، آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.14,
   "end": 294.54,
   "text": "مطلق و تغییر نمی‌کنه و قطعی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 294.54,
   "end": 297.66,
   "text": "اون بهش می‌گن قضا، قضای الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 297.66,
   "end": 300.4,
   "text": "که حالا اثر توجه به قضا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.4,
   "end": 304.76,
   "text": "اهمیت توجه به قضای الهی در زندگی انسان چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 304.76,
   "end": 308.06,
   "text": "اینه که وقتی تو مطمئن شدی که آقا قراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.06,
   "end": 314.96,
   "text": "همه مثلاً بمیرن یا همه قراره در زندگیشون بالاخره مریض بشوند، فقیر بشوند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.96,
   "end": 317.36,
   "text": "ضعیف بشوند. اصلاً این مال همه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.36,
   "end": 319.86,
   "text": "هیچ‌کس نیست که همیشه خوش باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.86,
   "end": 321.86,
   "text": "یه روز ناخوش است، یه روز خوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 321.86,
   "end": 326.64,
   "text": "مولامون فرمود که \"الدهر يومان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 326.64,
   "end": 328.9,
   "text": "این عمر تو، این دنیا دو روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 328.9,
   "end": 332.76,
   "text": "\"يوم لك ويوم عليك\" \"يوم لك ويوم عليك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 332.76,
   "end": 335.94,
   "text": "یه روزش برای تو به خوشی توئه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 335.94,
   "end": 338.8,
   "text": "به کام توئه، یه روز علیه توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 338.8,
   "end": 342.28,
   "text": "بعد فرمودند اون روز که علیه توئه صبور باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 342.28,
   "end": 346.2,
   "text": "از کوره در نرو به قول ما. اون روزی که برای توئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 346.2,
   "end": 350.18,
   "text": "پررو نشو، متکبر نشو، عُجب نگیردت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 350.18,
   "end": 353.64,
   "text": "توجه کردید؟ از دایره عبودیت خارج نشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 353.64,
   "end": 358.28,
   "text": "ببینید توجه به این قصه انقدر تأثیرگذاره در زندگی انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 358.28,
   "end": 363.64,
   "text": "توجه به قضا و قدر و این‌که انسان به آرامش می‌رسه و به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 363.64,
   "end": 372.52,
   "text": "رضایت حضرت حق می‌رسه که رضای حضرت حق \"يا أيتها النفس المطمئنة ارجعي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.52,
   "end": 378.02,
   "text": "إلى، يا أيتها النفس المطمئنة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 378.02,
   "end": 380.9,
   "text": "ارجعي.\" بله. \"ارجعي إلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 380.9,
   "end": 385.06,
   "text": "ربك راضية مرضية.\" اینو می‌خواستم عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 385.06,
   "end": 387.34,
   "text": "\"راضية مرضية.\" این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 387.34,
   "end": 390.08,
   "text": "انقدر مقام بالاست که می‌گه:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 390.08,
   "end": 392.86,
   "text": "\"برگرد به سمت پروردگار خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 392.86,
   "end": 397.02,
   "text": "ای کسی که تو از من راضی، منم از تو راضی.\" الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.02,
   "end": 399.44,
   "text": "بعد می‌فرماید: \"فادخلي عبادي،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 399.44,
   "end": 401.6,
   "text": "فادخلي جنتي، فادخلي.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 401.6,
   "end": 407.28,
   "text": "امام علیه الرحمه خدا رحمتشون کنه اینجا این اضافه رو به ذات می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 407.28,
   "end": 415.08,
   "text": "\"فادخلي عبادي، فادخلي جنتي.\" این یه جنتی و عبادی رو به ذات حضرت حق، یعنی بندگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 415.08,
   "end": 417.14,
   "text": "ذاتی من. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 417.14,
   "end": 419.22,
   "text": "که تمام حجاب‌ها رو پاره کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 419.22,
   "end": 422.26,
   "text": "بهشت ذاتی من. از کجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 422.26,
   "end": 425.94,
   "text": "انسان به اونجا می‌رسه، به اون رضا، به از مقام رضایت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 425.94,
   "end": 430.3,
   "text": "\"راضية مرضية.\" چی انسان رو به رضایت می‌رسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 430.3,
   "end": 433.5,
   "text": "توجه درست به قضا و قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 433.5,
   "end": 436.42,
   "text": "انگار انسان نگاهش به این قصه درست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 436.42,
   "end": 440.5,
   "text": "این‌ها رموزات و کنوزات احادیث و روایات و آیاتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 440.5,
   "end": 443.82,
   "text": "ان‌شاءالله که خدا ما رو اهل عمل کنه بعد از فهمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 443.82,
   "end": 445.7,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}