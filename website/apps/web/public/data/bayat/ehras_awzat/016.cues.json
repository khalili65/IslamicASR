  {
   "index": 1,
   "title": "## نفی «ای کاش» و فنای در حضرت حق",
   "start": 33.18,
   "end": 120.8
  },
  {
   "index": 2,
   "title": "## هندسهٔ اخلاص و هندسهٔ توفیق",
   "start": 120.8,
   "end": 170.58
  },
  {
   "index": 3,
   "title": "## مصافحه و معانقه",
   "start": 170.58,
   "end": 190.78
  },
  {
   "index": 4,
   "title": "## سال اراده‌ها و پرسش از هدیه‌ای برای ازدیاد اراده",
   "start": 190.78,
   "end": 411.21
  },
  {
   "index": 5,
   "title": "## بی‌ارادگی و بستن چشم از حرام",
   "start": 411.21,
   "end": 497.65
  },
  {
   "index": 6,
   "title": "## ماه بهار قرآن و ادامهٔ پرسش‌ها",
   "start": 497.65,
   "end": 534.01
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.24,
   "end": 6.88,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.88,
   "end": 10.2,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.2,
   "end": 12.58,
   "text": "تبریک میگم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.58,
   "end": 19.5,
   "text": "سال نو رو انشاالله که دل‌هامون نو شده باشه و بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.5,
   "end": 29.66,
   "text": "و ماه بندگی خدا رو انشاالله که بیش از پیش رحمات حضرت حق بر سر هممون نازل بشه و میشه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.66,
   "end": 33.18,
   "text": "ظرفمون اگر بزرگ بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.18,
   "end": 39.0,
   "text": "خدا بخیل نیست. یک وجود بیش نیست، اون هم وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.0,
   "end": 41.82,
   "text": "سمدی حضرت حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.82,
   "end": 45.64,
   "text": "که اگر واوش رو برداری میشه جود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.64,
   "end": 50.56,
   "text": "وجود حضرت حق سرتاسر جود مطلقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.56,
   "end": 54.82,
   "text": "دائم وجود سرمدیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.82,
   "end": 57.74,
   "text": "دائم در حال ریزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.74,
   "end": 60.06,
   "text": "فیض خودش بر سر مخلوقاتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.06,
   "end": 64.18,
   "text": "حالا تا ظرف‌ها چقدر باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.18,
   "end": 67.52,
   "text": "باید ظرف‌ها رو بزرگ کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.52,
   "end": 70.42,
   "text": "انشاالله که پر از خیر و برکت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.42,
   "end": 75.08,
   "text": "حالا شاید بعضی‌هامون بگیم ای کاش مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.08,
   "end": 79.98,
   "text": "امسال اینطوری باشه، ای کاش اینطوری نبود سال گذشته و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.98,
   "end": 84.26,
   "text": "هیچ‌وقت یادم نمیره حضرت علامه حسن زاده علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.26,
   "end": 91.64,
   "text": "فرمودن احدی از پیغمبر عزیز اسلام ای کاش نشنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.64,
   "end": 98.48,
   "text": "اینچنین خودش رو محو حضرت حق کرده بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.48,
   "end": 102.52,
   "text": "ذوب و فانی در ذات حضرت حق شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.52,
   "end": 105.82,
   "text": "هرچه از او رسد نیکوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.82,
   "end": 107.66,
   "text": "اصلا ای کاش معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.66,
   "end": 116.18,
   "text": "اینکه وقتی کسی خودشو بسپره به خدا \"ولا حول ولا قوه الا بالله العلی العظیم\" به حقیقت این برسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.18,
   "end": 118.54,
   "text": "دیگه ای کاش و این‌ها معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.54,
   "end": 124.96,
   "text": "خودش رو بس خدا می سپره و قول حضرت صدیقه طاهره سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.96,
   "end": 128.02,
   "text": "اگر کسی، اگر بنده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.02,
   "end": 137.06,
   "text": "خلوصش رو بهترین اخلاص‌ها رو به سمت خدا روانه کنه، هندسه اخلاص قبلا گفتیم پایین به بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 137.06,
   "end": 141.5,
   "text": "خدا هم توف-- بهترین توفیقاتش رو وا-- از بالا نازل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.5,
   "end": 145.18,
   "text": "هندسه توفیق هم که از بالا به پایین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.18,
   "end": 152.48,
   "text": "دیگه ناراحتی نداره. انشاالله که شاد باشید همیشه دلتون پر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 152.48,
   "end": 159.58,
   "text": "انبساط خاطر باشه و شرح صدر داشته باشید که بهترین دعاست در حق هم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 159.58,
   "end": 163.06,
   "text": "خدا به هممون شرح صدر بده انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 163.06,
   "end": 166.22,
   "text": "دل‌هامون رو بزرگ کنه امسال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 166.22,
   "end": 170.58,
   "text": "همون‌طور که طبیعت نو شده انشاالله ما هم نو بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 170.58,
   "end": 172.44,
   "text": "رسم و رسوم قشنگی هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 172.44,
   "end": 175.74,
   "text": "این مصافحه‌ها هم خیلی زیباست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.74,
   "end": 180.26,
   "text": "که ما اهل ایمان به هم می‌رسن معانقه می‌کنن، عنق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 180.26,
   "end": 183.16,
   "text": "گردن‌ها رو به هم می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 183.16,
   "end": 191.77,
   "text": "حالا بوسیدن صورت در اسلام خیلی وارد نشده مگر مثلا بوسیدن دست پدر، مادر و معلم و یا پدر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 191.77,
   "end": 195.24,
   "text": "مادر به صورت فرزندش اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 195.24,
   "end": 197.8,
   "text": "ولی بوسه به اون معنا خیلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 197.8,
   "end": 203.16,
   "text": "عنقه، معانقه، گردن به گردن همدیگه رو در آغوش می‌کشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 203.16,
   "end": 206.28,
   "text": "و مصافحه دست به هم دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 206.28,
   "end": 215.2,
   "text": "که روایت داریم تا وقتی که دست دو تا مؤمن تو دست همه همینطوری گناهاشون در حال ریزشه مثل برگ پایزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 215.2,
   "end": 220.7,
   "text": "یعنی اگر انسان با اعتقاد این کارا رو بکنه همه اینا س-- رمز و رموزی درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.7,
   "end": 224.86,
   "text": "انشاالله سال اراده‌ها باشه، اراده‌هامون قوی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 224.86,
   "end": 228.68,
   "text": "از همین فرصت استفاده می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 228.68,
   "end": 231.38,
   "text": "سؤال یکی از دوستان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 231.38,
   "end": 236.22,
   "text": "جواب بدم که به مدیر کانال فرستاده بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 236.22,
   "end": 240.06,
   "text": "حاج آقا بگید که در این همه ذکر و ورد و چی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 240.06,
   "end": 243.52,
   "text": "هدایایی از اساتیدشون گفته بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 243.52,
   "end": 246.46,
   "text": "آیا هدیه‌ای هم از اساتیدشون پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 246.46,
   "end": 248.86,
   "text": "ازدیاد اراده داشتن یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 248.86,
   "end": 251.58,
   "text": "بله، تقدیم می‌کنم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 251.58,
   "end": 255.96,
   "text": "البته همین‌طور به صورت خصوصی به بعضی از دوستان گفته بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 255.96,
   "end": 260.8,
   "text": "یه روز محضر حضرت آیت الله شوشتری بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.8,
   "end": 263.64,
   "text": "ایشون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 263.64,
   "end": 270.74,
   "text": "اگر کسی، اینو عموما هم نگفتن، یه جمع قلیلی بودیم خصوصی خدمتشون بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 270.74,
   "end": 277.3,
   "text": "همان آقای شوشتری بزرگ که شاگرد آقای حافظیان و ایشون هم شاگرد آقای نخودکی بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 277.3,
   "end": 280.53,
   "text": "قبلا براش، برای شما عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 280.53,
   "end": 288.68,
   "text": "این هدیه امروز ما باشه که فرمودن اگر کسی می‌خواد اراده‌ش قوی بشه نیت کنه چهارده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 288.68,
   "end": 294.64,
   "text": "ماه پشت سر هم چهارده ختم قرآن کنه، هدیه کنه به چهارده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 294.64,
   "end": 303.12,
   "text": "معصوم به این شکل. ماه اول هدیه به رسول خدا، ماه دوم امیرالمؤمنین، ماه سوم حضرت زهرا همینطور تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 303.12,
   "end": 306.54,
   "text": "ماه چهاردهم هدیه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 306.54,
   "end": 309.78,
   "text": "چهاردهمین معصوم یعنی امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 309.78,
   "end": 313.62,
   "text": "بعد روزی یک جزء می‌خواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 313.62,
   "end": 320.0,
   "text": "ختمش از اول ماه شروع می‌کنه روزی یک جزء ماه اول هدیه به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 320.0,
   "end": 325.08,
   "text": "هر روز یه جزء می‌خونه. اون ماه‌هایی که بیست و نه روزه تموم می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 325.08,
   "end": 327.36,
   "text": "روز بیست و نهم باید دو جزء بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 327.36,
   "end": 330.18,
   "text": "بیست و نه و سی رو با هم بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 330.18,
   "end": 335.24,
   "text": "ماه‌هایی که سی روزه که هیچی اگر حالا شمسی رو گرفت مشکلی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 335.24,
   "end": 339.62,
   "text": "خواست با شمسی بره جلو ماه شمسی سی و یک روزه ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 339.62,
   "end": 344.02,
   "text": "روز سی و یکم باید جزء سی رو دوباره تکرار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 344.02,
   "end": 352.12,
   "text": "ایشون فرمودن اگر یک روز سعی کنید که اصلا ترک نشه، این اصلا خودش برای ازدیاد اراده‌ست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 352.12,
   "end": 356.66,
   "text": "اراده رو قوی می‌خواد بکنه باید با اراده کنی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 356.66,
   "end": 358.16,
   "text": "به هر حال ایشون فرمودن حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 358.16,
   "end": 367.04,
   "text": "یه روز استثنائا اگر مشکلی پیش اومد به هر دلیلی نشد، وقت نشد یا فراموشت شد جزعتو بخونی، تعطیلش نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 367.04,
   "end": 370.91,
   "text": "برعکس جواب میده اصلاً میزنه اراده رو ضعیف می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 370.91,
   "end": 373.63,
   "text": "چیکار باید بکنی؟ روز بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 373.63,
   "end": 376.89,
   "text": "اون جزء روز قبل رو هم بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 376.89,
   "end": 379.91,
   "text": "یعنی روز بعدش دو ج-- دو جزء بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 379.91,
   "end": 384.71,
   "text": "این حالا ما به صورت خصوصی به چند تا از دوستانمون که ضعیف الادا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 384.71,
   "end": 389.99,
   "text": "اراده بودن این رو قبلاً گفتیم بعد که انجام داده بودن اومدن گفتن حاج آقا خیلی خوب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 389.99,
   "end": 392.49,
   "text": "ما خیلی تاثیر گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 392.49,
   "end": 400.27,
   "text": "بالاخره نفس بزرگان وقتی یه هدیه‌ای رو تقدیم می‌کنن یه اساسی داره، همینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 400.27,
   "end": 402.93,
   "text": "مثل ما نیست همینطوری دلخوشی یه چیزی بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 402.93,
   "end": 406.01,
   "text": "همش بر اساس یه رمز و رموزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 406.01,
   "end": 409.67,
   "text": "این کنوز و کنزها و گنج‌ها رو تقدیم می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 409.67,
   "end": 414.73,
   "text": "تق-- بالاخره انجام بدیم ما اگر اراده نداشته باشیم بیچاره‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 414.73,
   "end": 419.77,
   "text": "همین چشممون رو الان خدای منان میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 419.77,
   "end": 422.57,
   "text": "ببند چشمت رو در برابر حرام‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 422.57,
   "end": 426.13,
   "text": "همین بستن پلک اراده می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 426.13,
   "end": 430.39,
   "text": "بعضیا اراده‌ی بستن پلکش رو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 430.39,
   "end": 433.37,
   "text": "پلکش رو نمی‌تونه در برابر نامحرم ببنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 433.37,
   "end": 434.93,
   "text": "انقدر ضعیف الاراده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 434.93,
   "end": 437.74,
   "text": "باید واسش کار کرد، باید حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 437.74,
   "end": 439.29,
   "text": "بالاخره کمک گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 439.29,
   "end": 444.91,
   "text": "و چه کمکی بالاتر از استعانت گرفتن از قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 444.91,
   "end": 449.61,
   "text": "قرآن که نک لتلقى القرآن من لدن حکیم علیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 449.61,
   "end": 454.87,
   "text": "علم ذاتی حضرت حق است که تنزل پیدا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 454.87,
   "end": 459.33,
   "text": "از ذات حضرت حق این علم تنزل پیدا کرده ریخته تو این کتاب همینطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 459.33,
   "end": 465.85,
   "text": "کشیده شده تنزل پیدا کرده اومده، اومده، اومده تا انزل مراتبش که شده این جوهری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 465.85,
   "end": 468.75,
   "text": "کتبه، قرآن کتبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 468.75,
   "end": 476.57,
   "text": "دست من و شماست که به قول ملاصدرا این هم همون نور همون لمعات جمال الهی رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 476.57,
   "end": 479.87,
   "text": "چشم می‌خواد که ببینی همین، همین جوهری که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 479.87,
   "end": 483.83,
   "text": "کتاب هست این هم نور جمال رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 483.83,
   "end": 486.0,
   "text": "اگر کسی چشم داشته باشه ببینه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 486.0,
   "end": 488.47,
   "text": "یعنی کشیده شده جدا هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 488.47,
   "end": 490.27,
   "text": "از ذات حضرت حق کشیده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 490.27,
   "end": 496.43,
   "text": "یعنی تو به قرآن که چنگ می‌ندازی تمسک می‌جویی کأنّ دستت به دامن خدا رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 496.43,
   "end": 498.87,
   "text": "چیز کمی نیست. این ماه هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 498.87,
   "end": 500.99,
   "text": "ماه بهار قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 500.99,
   "end": 505.75,
   "text": "همین هدیه رو انشاالله گفتیم تقدیم کنیم به چند تا دیگه دوستان سؤالاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 505.75,
   "end": 513.59,
   "text": "پرسیده بودن پیرامون حالا ما مباحث عقلی‌ت رو که می‌گفتیم خیلی سؤالی نبود تا یه دفعه افتادیم به دور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 513.59,
   "end": 516.77,
   "text": "ذکر و ورد و احراز و اعوذات و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 516.77,
   "end": 521.63,
   "text": "سؤال پشت سؤال. حالا یه سریش رو که گفتیم قبلاً یه چند تاش هم انشاالله روزای بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 521.63,
   "end": 528.31,
   "text": "توفیق بود جواب میدیم. انشاالله که عاقبت از محضر به خیر باشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 528.31,
   "end": 534.01,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}