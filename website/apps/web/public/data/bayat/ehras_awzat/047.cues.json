   "title": "## عدد هو و الله و حروف سورهٔ اخلاص",
   "start": 554.99,
   "end": 638.21
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.42,
   "end": 5.14,
   "text": "هدیه‌ای که به فضل الهی تقدیم می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.14,
   "end": 15.4,
   "text": "هدیه گرانسنگی‌ست. قبلاً هم در صد کلمه در معرفت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.4,
   "end": 17.84,
   "text": "، وقتی موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.84,
   "end": 21.42,
   "text": "خیال مشوش مطرح بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.42,
   "end": 25.66,
   "text": "اونجا عرض کردیم از قول حضرت استاد علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.66,
   "end": 29.14,
   "text": "حسن زاده علیه رحمة، ایشون هم به نقل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.14,
   "end": 33.1,
   "text": "شیخ‌شون علامه طباطبایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.1,
   "end": 42.8,
   "text": "که نام شریف و بی بدیل الله رو این اسم جامع رو که همه اسماء به اون برمی‌گرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.8,
   "end": 46.24,
   "text": "و شرط پذیرش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.24,
   "end": 53.5,
   "text": "در حقیقت بالا رفتن و معراج نماز ما اینه که قرب به سمت اون پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.5,
   "end": 58.4,
   "text": "نه به الرحمن، نه به الرحیم، نه به الکریم، نه به ال-- فقط به الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.4,
   "end": 60.5,
   "text": "قربتاً الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.5,
   "end": 64.5,
   "text": "اگر ما بگیم قربتاً الی الرحمن باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.5,
   "end": 69.78,
   "text": "این اسم جامع و اساساً عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.78,
   "end": 72.28,
   "text": "قرب یعنی ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.28,
   "end": 76.1,
   "text": "ولایت یعنی تلبس به اسماء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.1,
   "end": 80.38,
   "text": "همه اسماء در الله جمع‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.38,
   "end": 83.62,
   "text": "و حقیقتش می‌شه علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.62,
   "end": 88.22,
   "text": "علم هم در مرتبه عالی‌ش خود حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.22,
   "end": 92.0,
   "text": "عالم علم انباشته شده روی همه است یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.0,
   "end": 96.88,
   "text": "خب معکم أينما كنتم زیرکیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.88,
   "end": 99.16,
   "text": "زیرکی استفاده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.16,
   "end": 101.72,
   "text": "ذکر شریف الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.72,
   "end": 106.62,
   "text": "که حضرت استاد تأکید دارن بدون حرف ندا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.62,
   "end": 113.64,
   "text": "بدون يا. اون یک کارکردی داره، خود الله کارکردی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.64,
   "end": 118.98,
   "text": "عددش هم فرمودن شصت و شش .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.98,
   "end": 122.51,
   "text": "بله بدون حرف ندا یعنی الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.51,
   "end": 129.33,
   "text": "الله با توجه بگید ببینید چه بلایی سرتون میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.33,
   "end": 133.66,
   "text": ". بارها بنده حقیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 133.66,
   "end": 137.72,
   "text": "البته تجربه شخصیم این قسمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.72,
   "end": 142.74,
   "text": "زیر بارون خصوصاً وقتی بارون می‌گرفت‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.74,
   "end": 145.8,
   "text": "بارها این کار رو انجام دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.8,
   "end": 150.02,
   "text": "عجیب ثمراتی داشت و داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.02,
   "end": 153.34,
   "text": "حالا حضرت استاد فرمودن که ثمرش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.34,
   "end": 156.04,
   "text": "یکی از ثمرات مهمه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.04,
   "end": 159.74,
   "text": "شصت و شش بار گفتن الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.74,
   "end": 165.12,
   "text": "رفع اضطراب و نگرانی و تشویش خاطره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.12,
   "end": 170.56,
   "text": "پاک‌سازی قوه خیاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.56,
   "end": 173.14,
   "text": "جالب اینجاست که بدونید حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.14,
   "end": 177.92,
   "text": "از منفعت‌های این ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.92,
   "end": 182.74,
   "text": "بردن مزاج به سمت اعتداله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.74,
   "end": 185.9,
   "text": "کلاس ما درس معرفته، درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.9,
   "end": 189.38,
   "text": "یعنی حرکته از سمت علم به سوی معرفته؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.38,
   "end": 193.54,
   "text": "یعنی حکمت که باطن علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.54,
   "end": 199.3,
   "text": "وقتی مزاج معتدل شد یادگیری انسان قوی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.3,
   "end": 202.28,
   "text": "اینو شیخ الرئیس در نمت‌های اشارات فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.28,
   "end": 205.66,
   "text": "نمت سوم، انتهای نمت سوم به بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 205.66,
   "end": 208.9,
   "text": "می‌تونید ملاحظه کنید .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.9,
   "end": 216.86,
   "text": "که اصلاً ایشون می‌فرماید امام عصر، اصلاً انسان کامل از این جهت فراگیری‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.86,
   "end": 222.34,
   "text": "مافوق همه است و به یک باره قلبش به قدری وسعت گرفته که همای-همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.34,
   "end": 226.78,
   "text": "حقایق رو به یک معنا همه اسماء رو به یک معنا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 226.78,
   "end": 231.22,
   "text": "علم امکانی رو از ذات غیبی و از مصدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.22,
   "end": 234.26,
   "text": "فیض علی الاطلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.26,
   "end": 237.86,
   "text": "می‌گیره به جهت اینه که مزاج‌شون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.86,
   "end": 241.88,
   "text": "أعدل امزجه است؛ یعنی معتدل‌ترین مزاج است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.88,
   "end": 245.7,
   "text": "خب در خصوص مزاج ما حرف قبلاً تو بحث‌هامون زیاد داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.7,
   "end": 252.44,
   "text": "حرفی نمی‌زنم. داشتیم در منفعت و آثار و خواص ذکر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.44,
   "end": 259.89,
   "text": "عرض می‌کردیم که حتماً شما هم بهره ببرید، استفاده کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 259.89,
   "end": 267.24,
   "text": ". که بسیاری از حتی مریضی‌های روحی روانی رو از بین می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 267.24,
   "end": 271.1,
   "text": "یه پژوهشگری در کشور هلند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 271.1,
   "end": 275.62,
   "text": "در دانشگاه آمستردام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.62,
   "end": 279.14,
   "text": "ظاهراً پژوهش‌شون رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 279.14,
   "end": 281.78,
   "text": "در دسترس همه قرار داده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.78,
   "end": 290.08,
   "text": "جالبه بدونید که مسلمان‌هایی رو که قرآن می‌خوندن و از اذکار استفاده می‌کردند و منتها مریضی‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 290.08,
   "end": 292.36,
   "text": "جسمی، روحی، روانی داشتن رو این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.36,
   "end": 295.92,
   "text": "ایشون جمع کرد یه مدتی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 295.92,
   "end": 301.22,
   "text": "رو بهشون همین دستورالعمل ذکر الله رو داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 301.22,
   "end": 303.81,
   "text": "همین، همین دستورالعمل علامه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 303.81,
   "end": 307.02,
   "text": "الله بگن ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 307.02,
   "end": 308.6,
   "text": "بدون حرف منادى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.6,
   "end": 311.42,
   "text": "حالا اینجا ما حرف زیاد داریم که خب چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.42,
   "end": 313.75,
   "text": "مگه حرف منادى چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.75,
   "end": 324.12,
   "text": "این قبلاً یه چیزکی گفتیم ولی اجازه بدید این‌ها رو در بحث اسماء الحسنی بگیم که هنوز ورود نکردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 324.12,
   "end": 330.42,
   "text": ". اگر چنانچه دقت کنید اون ادعه بعد از نماز شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 330.42,
   "end": 336.56,
   "text": "جعفر طیار گفت بلافاصله دستتو بالا ببری، امام فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 336.56,
   "end": 339.52,
   "text": "بگی اول چی بگی؟ بگی يا رب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 339.52,
   "end": 342.9,
   "text": "این، این يا رب یعنی ای پروردگار من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 342.9,
   "end": 346.22,
   "text": "کسره زیر ب یعنی ربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.22,
   "end": 349.92,
   "text": "بعد، بعد با حرف منادى يا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 349.92,
   "end": 355.76,
   "text": "يا رب. بعد میگی يا رباه میری تو بغل و آغوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 355.76,
   "end": 358.28,
   "text": "بعد اون رباه تبدیل می‌شه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.28,
   "end": 362.06,
   "text": "رب. رب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 362.06,
   "end": 364.47,
   "text": "دیگه يا برداشته می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 364.47,
   "end": 367.75,
   "text": "یا رب، یا رباه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 367.75,
   "end": 370.41,
   "text": "رب. یا برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 370.41,
   "end": 375.81,
   "text": "سه مرحله باید حرکت کنی به علاوه نماز میشه سه مرحله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 375.81,
   "end": 381.17,
   "text": "خود نماز، مرحله بعد ذکر شریف یا رب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 381.17,
   "end": 384.53,
   "text": "مرحله سوم ذکر شریف یا رباه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.53,
   "end": 387.99,
   "text": "بعد که تو آغوش رفتی و چشیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.99,
   "end": 393.61,
   "text": "دیگه از اهل منزل شدی، اهل شدی، اهل بیت النبوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 393.61,
   "end": 396.43,
   "text": "اهل شدی دیگه یا برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 396.43,
   "end": 400.85,
   "text": "ای مال راه دوره. ای مال راه دوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 400.85,
   "end": 403.35,
   "text": "آی فریاد. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 403.35,
   "end": 405.35,
   "text": "رب دیگه می‌چشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 405.35,
   "end": 413.45,
   "text": "مرحله چشیدنه. خب من و شما نباید به خودمون بچشونیم این از کار رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 413.45,
   "end": 421.57,
   "text": "هر وقت حس-- نمی‌خواستم عرض کنم حالا نکته‌ای عرض می‌کنم چون وقتش الان نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 421.57,
   "end": 424.47,
   "text": "مقدمات می‌خواد. هر وقت احساس قر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 424.47,
   "end": 428.21,
   "text": "بعد از حضرت حق کردید با حرف منادى استفاده کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 428.21,
   "end": 434.41,
   "text": "هر وقت احساس نشاط، اقبال، نه ادبار، اقبال کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 434.41,
   "end": 439.45,
   "text": "و نشاط عبادت داشتید، احساس قرب کردید بدون حرف منادى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 439.45,
   "end": 443.05,
   "text": "حالا این اثرش در چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 443.05,
   "end": 449.45,
   "text": "برداشتن اضطراب. این شخص هلندی، این پژوهشگر میگه من همه اینا رو استفاده کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 449.45,
   "end": 456.77,
   "text": "یعنی تجربه کردم مریض‌ها رو آوردم اینایی که بهشون تعلیم دادم الله بگن بعد از یه مدتی دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.77,
   "end": 463.79,
   "text": "بدون استثنا اولاً ضربات، این ضربان قلبشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 463.79,
   "end": 466.41,
   "text": "ضربان قلبشون به سمت اصلاح رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 466.41,
   "end": 470.29,
   "text": "بعد تنفسشون خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 470.29,
   "end": 474.83,
   "text": "از اون حالت بی‌نظمی دراومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 474.83,
   "end": 483.57,
   "text": "تنفسشون خیلی دیدم چه تأثیر عجیبی در تنفس و شریانات و قلب و این‌ها و خون و عروق و این‌ها داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 483.57,
   "end": 488.37,
   "text": "بعد رفته، رفته دیدم اون مشکلات روحی روانی‌شون برطرف شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 488.37,
   "end": 490.61,
   "text": "چرا یه آدم اونوری باید اینطوری برسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 490.61,
   "end": 494.61,
   "text": "تازه غیر مسلمون هم هستا، مسلمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 494.61,
   "end": 497.39,
   "text": "اصلاً معنیم نمیده. الله، الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 497.39,
   "end": 506.31,
   "text": "بعد ماها بهره نبریم؟ حالا خود الله می‌دونید اولین اسمی‌ست که بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 506.31,
   "end": 510.37,
   "text": "نفس الهی \"اللهم عرفنی نفسك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 510.37,
   "end": 514.69,
   "text": "یا به یک معنا برای سهولت فهم عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 514.69,
   "end": 523.43,
   "text": "ذات غیبی. بعد از ذات غیبی که هو اشاره به او داره اولین اسمی‌ست که منتشر شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 523.43,
   "end": 527.11,
   "text": "الله. قبلش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 527.11,
   "end": 529.35,
   "text": "هو. برای همین قل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 529.35,
   "end": 531.83,
   "text": "هو الله احد انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 531.83,
   "end": 535.35,
   "text": "عظمت پیدا کرده این سوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 535.35,
   "end": 539.21,
   "text": "از ذات گرفته شده اومده تا مرحله ظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 539.21,
   "end": 542.55,
   "text": "قل هو الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 542.55,
   "end": 544.93,
   "text": "کدوم الله؟ احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 544.93,
   "end": 549.39,
   "text": "مرتبه احدیت که همه حقایق اونجا مندمج‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 549.39,
   "end": 553.43,
   "text": "پایین کثرت و واحدیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 553.43,
   "end": 556.63,
   "text": ". حالا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 556.63,
   "end": 560.83,
   "text": "عدد هو رو، عدد هو چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 560.83,
   "end": 567.19,
   "text": "عددش یازده. حالا شما خود حروف خود--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 567.19,
   "end": 569.11,
   "text": "ببخشید انشاالله امام اسما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 569.11,
   "end": 572.03,
   "text": "اینا رو من اصلاً قصد ورود الان‌ها ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 572.03,
   "end": 574.53,
   "text": "الان یه مقدار زوده برای ورود به اینجور مسائل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 574.53,
   "end": 579.91,
   "text": "حالا تبرکاً یه چیزکی چشمای شما یه کاری با ما می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 579.91,
   "end": 584.17,
   "text": "می‌کشه بیرون یه سری چیزها رو از دل ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 584.17,
   "end": 586.03,
   "text": "این یازده رو شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 586.03,
   "end": 592.17,
   "text": "وقتی اعداد رو با هم جمع کنید یک و دو و سه و چه هم تا، تا یازده رو با هم جمع کنید میشه چند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 592.17,
   "end": 596.43,
   "text": "شصت و شش. عدد الله چنده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 596.43,
   "end": 600.09,
   "text": "شصت و شش. عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 600.09,
   "end": 603.03,
   "text": "حروف سوره اخلاص هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 603.03,
   "end": 608.49,
   "text": "قل هو الله احد. شصت و شش .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 608.49,
   "end": 612.97,
   "text": "که این‌ها همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 612.97,
   "end": 617.41,
   "text": "کاری که با آدم می‌کنند همون کاریه که مرسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 617.41,
   "end": 621.73,
   "text": "می‌کنه. کسی که ارسال می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 621.73,
   "end": 624.43,
   "text": "یا ریح یا هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 624.43,
   "end": 628.73,
   "text": "الله اینا همشون در یک کارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 628.73,
   "end": 634.71,
   "text": "حالا این هر کدوم از این کلمات که من الان استفاده کردم یه جلسه می‌خواد که درباره‌ش حرف زده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 634.71,
   "end": 638.21,
   "text": "فعلاً سربسته عرض کردم رفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}