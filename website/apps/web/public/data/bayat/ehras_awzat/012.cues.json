 ],
 "cues": [
  {
   "i": 0,
   "start": 20.28,
   "end": 23.28,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 23.28,
   "end": 28.92,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 28.92,
   "end": 31.66,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 31.66,
   "end": 38.4,
   "text": "در ادامه‌ی بحث ادعیه و اذکار و عوضات و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 38.4,
   "end": 40.44,
   "text": "یه مقدار از قرآن غافل شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 40.44,
   "end": 45.2,
   "text": "می‌خواستیم دیگه بحث رو جمع کنیم و ورود کنیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 45.2,
   "end": 51.6,
   "text": "ادامه‌ی روایات اما دیدم از قرآن غافل شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 51.6,
   "end": 55.88,
   "text": "در حالی که کتاب‌ها نوشتن در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 55.88,
   "end": 62.72,
   "text": "آثار سَوَر و خواص آیات قرآن این‌ها بسیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 62.72,
   "end": 70.92,
   "text": "حالا من چند تا نمونه عرض کنم اونچه که به ذهنم رسید حداقل اونایی که خودم بهش عمل کردم و می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 70.92,
   "end": 76.54,
   "text": "اگر توفیق شد که امروز همشو بگیم اگه نشد تا فردا دیگه جمعش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 76.54,
   "end": 79.42,
   "text": "مثلا در خصوص سوره‌ی قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 79.42,
   "end": 84.46,
   "text": "یه حدیث خیلی عجیب براتون بخونم از امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 84.46,
   "end": 88.3,
   "text": "ببینید چه عظمتی این سوره داره، سوره‌ی قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 88.3,
   "end": 94.44,
   "text": "حضرت فرمودن هر چیزی میوه‌ای دارد، میوه‌ی قرآن سوره‌ی قدر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 94.44,
   "end": 98.88,
   "text": "هر چیزی گنجی دارد و گنج قرآن سوره‌ی قدر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 98.88,
   "end": 102.02,
   "text": "هر چیزی یاریگری دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 102.02,
   "end": 108.32,
   "text": "یه معینی داره، ناصری داره و یاریگر ضعیفان سوره‌ی قدر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 108.32,
   "end": 115.1,
   "text": "و هر چیز راه آسانی دارد و راه آسان برای درماندگان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 115.1,
   "end": 116.72,
   "text": "کی درمانده است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 116.72,
   "end": 121.7,
   "text": "سوره‌ی قدر. بهترین چیزه براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 121.7,
   "end": 125.56,
   "text": "و هر چیز عصمتی دارد و عصمت مؤمنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 125.56,
   "end": 131.32,
   "text": "سوره‌ی قدر است. همین کسایی که تو مسیر سیر و سلوک و ترک گناه مشکل دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 131.32,
   "end": 135.3,
   "text": "بسم الله مولا داره می‌فرماید حرف من نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 135.3,
   "end": 140.56,
   "text": "و هر چیز هدایتی دارد و هدایت صالحان سوره‌ی قدر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 140.56,
   "end": 145.52,
   "text": "و هر چیز سروری دارد و سرور قرآن سوره‌ی قدر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 145.52,
   "end": 151.04,
   "text": "و هر چ-- هر چیزی زینتی دارد و زینت قرآن سوره‌ی قدر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 151.04,
   "end": 154.6,
   "text": "کنو لنا زینا ولا تکونو علینا شینا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 154.6,
   "end": 161.8,
   "text": "امام صادق علیه السلام فرمود: \"زینت ما بشین.\" بسم الله این سوره انسان رو زینت می‌کنه، می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 161.8,
   "end": 166.98,
   "text": "هر چیز خیمه‌ای دارد و خیمه‌ی متعبدان سوره‌ی قدر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 166.98,
   "end": 178.66,
   "text": "و هر چیز بشارتی دارد و بشارت مردم سوره‌ی قدر است و برای هر چیز حجتی است و حجت بعد از پیامبر سوره‌ی قدر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 178.66,
   "end": 181.72,
   "text": "پس به آن ایمان بیاورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 181.72,
   "end": 185.74,
   "text": "یعنی دل بدید به این سوره همینطوری ازش رد نشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 185.74,
   "end": 188.44,
   "text": "خیلی در خواص این سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 188.44,
   "end": 190.76,
   "text": "متعدد حتی کتاب‌ها نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 190.76,
   "end": 193.02,
   "text": "خیلی. سوره‌ی عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 193.02,
   "end": 194.66,
   "text": "می‌دونید سوره‌ی ولایته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 194.66,
   "end": 196.46,
   "text": "سوره‌ی قدر سوره‌ی ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 196.46,
   "end": 200.2,
   "text": "لذا می‌فرماید بعد از پیغمبر حجته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 200.2,
   "end": 207.52,
   "text": "مثلاً یه روایت داریم که اگر کسی بعد از نماز صبحش ده بار این سوره رو بخونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 207.52,
   "end": 212.8,
   "text": "سوره‌ی قدر رو بعد از نماز صبحش بخونه فرمود قدرت خدا رو مشاهده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 212.8,
   "end": 218.08,
   "text": "چه خبره؟ الله اکبر. برای حاجت روایی فرمودن سیصد و شصت مرتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 218.08,
   "end": 221.56,
   "text": "اینا روایته خدمتتون عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 221.56,
   "end": 225.28,
   "text": "فرمودن اگه کسی شوق داره، دوست داره بهشت رو ببینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 225.28,
   "end": 228.28,
   "text": "همه دوست داریم تو خواب ببینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 228.28,
   "end": 234.5,
   "text": "تمثلات بهشت گونه ببینه، صد بار قبل خواب بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 234.5,
   "end": 236.74,
   "text": "خیلی سوره‌ی عجیبیه سوره‌ی قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 236.74,
   "end": 241.16,
   "text": "حتی داریم در آشپزخونه چقدر خوبه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 241.16,
   "end": 248.86,
   "text": "به خانم خونه، هوای منزلت تعلیم بده که غذا می‌خواد بپزه سوره‌ی قدر و کوثر رو با هم بخونه بدمه به غذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 248.86,
   "end": 252.32,
   "text": "برکت میاره. فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 252.32,
   "end": 254.96,
   "text": "به آب بخونی بخوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 254.96,
   "end": 263.14,
   "text": "نور چشم میاره. اصلا انقدر در عظمت این سوره گفتن و گفتن و گفتن که آدم واقعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 263.14,
   "end": 269.96,
   "text": "می‌مونه چی بگه حتی برای خوشمزه شدن غذا و اینا که حالا دیگه اجازه بدید چیزای دیگه بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 269.96,
   "end": 277.22,
   "text": "از این بگذریم. یکی دیگه از دستورالعمل‌هایی که معروف هم هست حضرت علامه حسن زاده برای دفع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 277.22,
   "end": 280.32,
   "text": "آتش همه‌ی آفات، بلاها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 280.32,
   "end": 282.7,
   "text": "و امراض و این‌ها فرمودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 282.7,
   "end": 287.16,
   "text": "گفتن صبح، صبح وضو بگیر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 287.16,
   "end": 292.74,
   "text": "نوزده بار بسم الله الرحمن الرحیم رو به عدد خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 292.74,
   "end": 296.6,
   "text": "حروف بسم الله، بسم الله الرحمن الرحیم نوزده حرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 296.6,
   "end": 302.02,
   "text": "نوزده بار این سوره، این آیه رو تلاوت کن به نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 302.02,
   "end": 304.7,
   "text": "بسم الله الرحمن الرحیم سوره‌ی حمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 304.7,
   "end": 309.2,
   "text": "چون حدیث داریم همه‌ی قرآن جمع در اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 309.2,
   "end": 315.02,
   "text": "بعد علامه می‌فرماید این آتش بلاها، آفات جهنمی و این‌ها از دنیا رو از تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 315.02,
   "end": 318.24,
   "text": "دفع می‌کنه و تو رو در امان می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 318.24,
   "end": 325.81,
   "text": "در خصوص آیت‌الکرسی، ناس، فلق قبلاً مطالبی عرض کردیم مخصوصاً آقای کشمیری خیلی سفارش داشتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 325.81,
   "end": 331.26,
   "text": "برای دفع بلاها و آقای بهجت که می‌فرمودن ما آیت‌الکرسی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 331.26,
   "end": 333.6,
   "text": "دیگه چه تعویذی، چه حرز می‌خوایم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 333.6,
   "end": 340.74,
   "text": "آیت‌الکرسی. عرض شود خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 340.74,
   "end": 343.1,
   "text": "مثلاً فرمودن که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 343.1,
   "end": 346.5,
   "text": "خصوص سوره‌ی دهر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 346.5,
   "end": 348.16,
   "text": "سوره‌ی انسان هم بهش می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 348.16,
   "end": 356.46,
   "text": "حل أطع هم می‌گن. پیغمبر فرمود هر کس بر قرائت سوره‌ی انسان مداومت ورزد، روحش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 356.46,
   "end": 358.94,
   "text": "اگر ضعیف باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 358.94,
   "end": 361.52,
   "text": "دارای قدرت روحی می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 361.52,
   "end": 365.9,
   "text": "مداومت دقت بفرمایید مداومت بر سوره‌ی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 365.9,
   "end": 372.46,
   "text": "قدرت روحی. اینا که از تاریکی می‌ترسن، از تنهایی می‌ترسن، از جن می‌ترسن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 372.46,
   "end": 374.16,
   "text": "توهم زیاد می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 374.16,
   "end": 377.98,
   "text": "بسم الله. مداومت بر این سوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 377.98,
   "end": 380.56,
   "text": "یا اگه بچه‌های آدم ترسوئن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 380.56,
   "end": 385.36,
   "text": "عرض شود اضطراب دارن این‌ها تو خونه هر روز اینا رو مداومت کنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 385.36,
   "end": 393.88,
   "text": "باز امام صادق علیه السلام فرمود: \"سوره انسان موجب تقویت و نیرومندی روح و قوی شدن اعصاب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 393.88,
   "end": 399.7,
   "text": "قابل توجه اونایی که قرص‌های روان‌گردان چه می‌دونم روان و چی و اینا می‌خورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 399.7,
   "end": 402.8,
   "text": "اعصاب و همه چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 402.8,
   "end": 406.38,
   "text": "اهل بیت فرمودن همه چی. ولا رتب ولا یابن الله فی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 406.38,
   "end": 411.5,
   "text": "کتاب مبین. ما از کتاب خدا غافلیم که گرفتار این چیزا شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 411.5,
   "end": 416.9,
   "text": "فرمود قوی شدن اعصاب و آرامش یافتن اضطراب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 416.9,
   "end": 419.34,
   "text": "در همین سوره است. سوره چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 419.34,
   "end": 421.68,
   "text": "دهر. امام صادق فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 421.68,
   "end": 430.68,
   "text": "باز پیغمبر ضمانت داده فرمود: \"من ضامنم برای هر یک، هر یک از شیعیانم که در نماز صبح روز پنجشنبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 430.68,
   "end": 435.06,
   "text": "نماز صبح روز پنجشنبه، سوره انسان را بخواند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 435.06,
   "end": 437.74,
   "text": "و اگر در آن شب یا روز بمیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 437.74,
   "end": 443.68,
   "text": "با امنیت و بدون حساب از گناهانی که انجام داده وارد بهشت می‌شود و دیوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 443.68,
   "end": 446.62,
   "text": "حسابرسی بر او باز نمی‌شود.\" یعنی حساب کتابش نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 446.62,
   "end": 451.88,
   "text": "اینا توفیق می‌خواد. نگید خب اگه چرا همه بخونن پس چرا هیچکس نمی‌خونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 451.88,
   "end": 454.86,
   "text": "لیاقت می‌خواد. خیلی‌ها که نمی‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 454.86,
   "end": 459.66,
   "text": "اونام که می‌دونن توفیق خوندنشو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 459.66,
   "end": 463.34,
   "text": "و فرمود در قبر از او پرسش نخواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 463.34,
   "end": 465.14,
   "text": "حالا اگه زنده موند چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 465.14,
   "end": 469.9,
   "text": "نمرد. فرمود در حفظ و امان الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 469.9,
   "end": 472.4,
   "text": "حفظ و امان و آ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 472.4,
   "end": 481.02,
   "text": "و آفات دنیا از او برداشته می‌شود و چیزی از جنبنده‌های زمینی تا پنجشنبه‌ی بعد به او آسیبی نمی‌رساند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 481.02,
   "end": 486.64,
   "text": "یعنی در امان الهیه. کی امان الهی رو می‌خواد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 486.64,
   "end": 490.4,
   "text": "سوره مزمل. آره زیاده من اینا کتاباشو چون من دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 490.4,
   "end": 493.2,
   "text": "هر کدوم یه گلچینی یه چیزی براتون دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 493.2,
   "end": 499.4,
   "text": "سوره مزمل. پیغمبر فرمود سختی‌های دنیا و آخرت رو دفع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 499.4,
   "end": 501.54,
   "text": "مداومت بر اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 501.54,
   "end": 504.36,
   "text": "باعث می‌شه که انسان بتونه به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 504.36,
   "end": 506.48,
   "text": "لیاقت برسه که خواب پیغمبر رو ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 506.48,
   "end": 510.08,
   "text": "یعنی مداومت کنی هر روز سوره مزمل خواب پیغمبر رو می‌دی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 510.08,
   "end": 515.62,
   "text": "بعد فرمود که خود پیغمبر فرمود اجازه پیدا می‌کنی تو خواب از آقا تقاضا کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 515.62,
   "end": 518.62,
   "text": "چیزی از حضرت بخوای. این اجازه رو بهت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 518.62,
   "end": 522.68,
   "text": "خب چقدر خوبه. چرا آدم نکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 522.68,
   "end": 531.1,
   "text": "عرض شود سوره فرمودن که سوره ذاریات که قبلاً البته ما گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 531.1,
   "end": 534.36,
   "text": "اگر کسی یادتوننگه دیگه گفتیم سوره قاف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 534.36,
   "end": 537.36,
   "text": "ذاریات، واقعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 537.36,
   "end": 539.96,
   "text": "لیل و مزمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 539.96,
   "end": 544.52,
   "text": "این پنج تا رو اگر کسی با همدیگه بخونه تمومه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 544.52,
   "end": 550.64,
   "text": "از حیث رزق و روزیش، عزتش، سر بلندیش، نجات از آفات، بلاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 550.64,
   "end": 553.54,
   "text": "حالا چند تا من تقدیم کنم. مثلا سوره ذاریات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 553.54,
   "end": 557.24,
   "text": "پیغمبر فرمود خداوند امور معیشتی او رو اصلاح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 557.24,
   "end": 562.72,
   "text": "کسی که مداومت می‌کنه و روزی فراوان بهش می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 562.72,
   "end": 568.44,
   "text": "آیه چهل و نه سوره ذاریات رو گفتن ها چون تو دل سوره ذاریات هستیم اینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 568.44,
   "end": 574.04,
   "text": "جالب بود. یکی دو تا سؤال کردن من دارم میگم و الا من اصلاً این عادتو اصلاً ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 574.04,
   "end": 577.54,
   "text": "در خصوص ازدواج کردن دختری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 577.54,
   "end": 583.44,
   "text": "مثلا کسی سراغش نمیاد و مشکل تو ازدواجش پیش میاد یا کسی که بچه دار نمی‌شه اینا یکی دو تا اگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 583.44,
   "end": 585.3,
   "text": "وقت شد امروز عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 585.3,
   "end": 589.52,
   "text": "آیه چهل و نه سوره ذاریات رو فرمودن به دخترو پیغمبر فرمود به گردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 589.52,
   "end": 596.98,
   "text": "د-- بنویسید به د-گردن دختری که شوهری‌ها براش نمیاد یا اگه میاد همش به هم می‌خوره بزارید به زودی ازدواج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 596.98,
   "end": 599.9,
   "text": "اینا اسراری داره که بزرگان می‌دونن ما بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 599.9,
   "end": 602.58,
   "text": "تعبداً قبول داریم. بگذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 602.58,
   "end": 609.36,
   "text": "سوره قاف. فرمود دولت، عزت، سعادت، کرامت برای صاحب خونه میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 609.36,
   "end": 613.62,
   "text": "تو خونه‌ت سعی کن مخصوصاً دستور هست که تو خونه سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 613.62,
   "end": 617.78,
   "text": "قاف رو بخونی. هم رزقت وسیع می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 617.78,
   "end": 625.98,
   "text": "هم کتاب اعمالتو به دست راستت میدن قیامت هم عزت مند می‌شی تو و خانواده از ذلت نجات پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 625.98,
   "end": 628.2,
   "text": "بریم جلوتر. سوره لیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 628.2,
   "end": 635.94,
   "text": "پیغمبر فرمود اگر کسی مداومت کنه، خداوند به اندازه‌ای به او نعمت عطا می‌کنه تا راضی بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 635.94,
   "end": 640.94,
   "text": "و او را از سختی و تنگی عافیت بخشیده و کارها را بر او آسان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 640.94,
   "end": 644.56,
   "text": "این، این‌هایی که دارم میگم در کتاب‌های معتبره ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 644.56,
   "end": 653.06,
   "text": "فکر نکنین از این کتاب‌های بازاری و نسخه‌ نمیدونم چیه مثل داروخانه م-معنوی معلومه از کجا آوردنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 653.06,
   "end": 658.08,
   "text": "مثلا از جمع البیان شیخ طبرسی یا طبرسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 658.08,
   "end": 662.36,
   "text": "اونجا جلده یک صفحه سیصد و هفتاد و دو می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 662.36,
   "end": 665.1,
   "text": "در خصوص یاسین. به به، به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 665.1,
   "end": 667.92,
   "text": "در کتاب مسواح فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 667.92,
   "end": 671.06,
   "text": "هر کس اینو بنویسه، ما بحث جن رو داشتیم میگفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 671.06,
   "end": 673.3,
   "text": "بنویسه نزد خودش نگه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 673.3,
   "end": 681.56,
   "text": "خداوند او را از شر جن و چشم زخم در امان نگه می‌داره و خواب‌های خوش می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 681.56,
   "end": 683.7,
   "text": "و ازدیاد محبت میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 683.7,
   "end": 688.14,
   "text": "سوره یاسین. به شدت اینا حتی آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 688.14,
   "end": 690.26,
   "text": "حالا اینا رو من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 690.26,
   "end": 694.14,
   "text": "نباید بگم اما چون سؤال شده چند تاشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 694.14,
   "end": 697.54,
   "text": "مجبورم دارم میگم و الا یک عمره من اصلاً این حرفو نزدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 697.54,
   "end": 700.54,
   "text": "بعد بعضی‌هایی که یه عمره ما رو می‌شناسن می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 700.54,
   "end": 704.56,
   "text": "آیه هفتاد و دو این سوره رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 704.56,
   "end": 707.06,
   "text": "فرمودن هشتاد و سه بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 707.06,
   "end": 710.9,
   "text": "بخونی جلب محبت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 710.9,
   "end": 714.34,
   "text": "حالا اونایی که اینا رو نباید سوء استفاده ازش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 714.34,
   "end": 716.5,
   "text": "باید البته بخوانی، بدهی به شیرینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 716.5,
   "end": 719.46,
   "text": "مثل مثلاً خرما، کشمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 719.46,
   "end": 722.0,
   "text": "اینا باید بدی به همسرت بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 722.0,
   "end": 727.34,
   "text": "اینایی که بین خودش و همسرشون هر کاری می‌کنن می‌بینن یه مشکلاتی هست محبت کم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 727.34,
   "end": 731.82,
   "text": "اینا بسم الله خدا رای‌شون رو گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 731.82,
   "end": 735.54,
   "text": "حالا هی برو پیش روان‌پزشک و روانشناس و چه و چه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 735.54,
   "end": 739.82,
   "text": "ببندت به داروهای روان‌گردان آنچنانی بدبختت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 739.82,
   "end": 745.54,
   "text": "یه مشکلتو می‌خواد حل کنه ده تا دیگه رو درست می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 745.54,
   "end": 751.04,
   "text": "از مكارم الاخلاق یکی از کتاب‌های خیلی خوب آقای بهجت خیلی تأکید روی این کتاب داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 751.04,
   "end": 754.98,
   "text": "صفحه دویست و بیست و پنج می‌تونید این روایت رو ببینید که یکی اومد پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 754.98,
   "end": 758.38,
   "text": "پیغمبر اینم چون یکی از دوستان سؤال کرد دارم میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 758.38,
   "end": 763.4,
   "text": "گفت آقا من نسلم منقرض شده و فرزند ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 763.4,
   "end": 769.28,
   "text": "بعضیا بچه نمیارن. حضرت فرمود از خدا بخواه این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 769.28,
   "end": 772.44,
   "text": "و در سجده بگو این دو تا آیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 772.44,
   "end": 775.74,
   "text": "برو تو سجده این دو تا آیه رو تو سجده بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 775.74,
   "end": 779.57,
   "text": "اولیش آیه سی و هشت سوره‌آ-- سوره آل عمرانه که از اینجا شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 779.57,
   "end": 785.3,
   "text": "\"رب هب لي من لدنك ذرية طيبة إنك سميع الدعاء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 785.3,
   "end": 792.52,
   "text": "بلافاصله بعدش آیه هشتاد و نه انبیا \"رب لا تذرني فردا وأنت خير الوارثين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 792.52,
   "end": 797.76,
   "text": "یه رفیقی داشتیم اصلا نمی‌خواست بچه‌دار بشه ناقلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 797.76,
   "end": 801.58,
   "text": "هرچی ما نصیحتش کردیم نمی‌خواست بعد هی بچه‌دار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 801.58,
   "end": 803.94,
   "text": "اومد گفت من نمی‌خوام بشم می‌شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 803.94,
   "end": 807.02,
   "text": "چیه جریان؟ گفتم تو دعای قنوتت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 807.02,
   "end": 809.6,
   "text": "دیدیم همین\"رب لا تذرني فردا وأنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 809.6,
   "end": 819.16,
   "text": "خير الوارثين\" رو داره هر روز تو قنوت می‌خونه بدون اینکه خبر داشته باشه تپ تپ تپ بچه‌دار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 819.16,
   "end": 821.44,
   "text": "قربونت برم اینو خب حضرت فرموده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 821.44,
   "end": 827.56,
   "text": "امام صادق فرموده صفحه دویست و بیست و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 827.56,
   "end": 829.94,
   "text": "توصیه‌های بهجت رو براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 829.94,
   "end": 832.24,
   "text": "مو-- توی بهجت و دعا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 832.24,
   "end": 836.62,
   "text": "می‌تونید ببینید. مو-- هرکی می‌اومد پیش آقای بهجت اینو می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 836.62,
   "end": 839.66,
   "text": "در ارتباط چی؟ بچه‌دار شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 839.66,
   "end": 842.54,
   "text": "تو کتاب مستدرک الوسائل باب نکاح هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 842.54,
   "end": 844.86,
   "text": "آقای بهجت از خودش در نیاورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 844.86,
   "end": 848.78,
   "text": "هرمشام یه دربانی داشت که ثروتمند بود اما بچه‌دار نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 848.78,
   "end": 854.0,
   "text": "اومد پیش حضرت و از حضرت خواست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 854.0,
   "end": 857.54,
   "text": "یه راهی بهش یاد بده. امام باقر صلی الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 857.54,
   "end": 861.32,
   "text": "حضرت فرمودن که هر صبح و عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 861.32,
   "end": 863.48,
   "text": "هفتاد بار سبحان الله بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 863.48,
   "end": 866.88,
   "text": "چقدر آسون. ده بار استغفرالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 866.88,
   "end": 869.5,
   "text": "دوباره ده بار سبحان الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 869.5,
   "end": 873.92,
   "text": "بعد بگو این آیات رو، همون آیاتی که قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 873.92,
   "end": 878.94,
   "text": "ده تا دوازده سوره نور رو که به شدت بارش رحمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 878.94,
   "end": 881.74,
   "text": "نعمت و این‌ها بر سر ایران-- انسان می‌باره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 881.74,
   "end": 890.04,
   "text": "همون \"استغفر ربكم انه كان غفارا ليجعل لكم انهارا\" آیه ده تا دوازده سوره نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 890.04,
   "end": 896.6,
   "text": "این برای فرزنددار شدن. یکی دو تا از من پرسیدن گفتم چشم من بهتون میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 896.6,
   "end": 901.1,
   "text": "یه دستور دیگه هم عرض کنم خدمتتون برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 901.1,
   "end": 904.26,
   "text": "اون‌هایی که می‌خوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 904.26,
   "end": 907.24,
   "text": "همیشه در توانگری باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 907.24,
   "end": 912.12,
   "text": "هیچوقت انشاالله دچار فقر و گرفتاری مالی نشن و حیات قلب هم داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 912.12,
   "end": 915.1,
   "text": "این دستور حضرت علامه حسن زاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 915.1,
   "end": 922.8,
   "text": "روحش شاد. ایشون فرمودن که اگه حالا کسی تو قبض روح بوده میاد ظاهرا قبض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 922.8,
   "end": 926.88,
   "text": "قبض وجودی داشته، نه بسط، انبساط نداشته، انقباض داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 926.88,
   "end": 929.88,
   "text": "میاد می‌گه آقا من گرفتارم خیلی حالم بده اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 929.88,
   "end": 931.78,
   "text": "فقیر هم بوده ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 931.78,
   "end": 933.78,
   "text": "از علامه اینو تقاضا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 933.78,
   "end": 942.4,
   "text": "ولی بنده خودم در شرح فصوص بدون این توضیحات از علامه اینو شنیدم که فرمود هرکی دنبال حیات قلب و عقله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 942.4,
   "end": 945.0,
   "text": "می‌خواد قوت قلب و عقل پیدا کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 945.0,
   "end": 952.04,
   "text": "مداومت کنه حداقل یک اربعین بر این ذکر \"يا حي يا قيوم يا مال الله الا الله انت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 952.04,
   "end": 960.58,
   "text": "بعد اونایی هم که مشکلات مالی، اقتصادی، کاری، شغلی هرچی اینا دارن فرمود مداومت کنن بر سوره واقع که سوره غناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 960.58,
   "end": 964.14,
   "text": "غنی هم بهش می‌گن. علامه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 964.14,
   "end": 966.3,
   "text": "سوره غنا یا غنی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 966.3,
   "end": 973.3,
   "text": "بخوانید یعنی واقع تا غنی در عالم، در علم، در علم غنی بشید و چیزهای دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 973.3,
   "end": 975.64,
   "text": "یعنی اونام به دنبالش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 975.64,
   "end": 983.7,
   "text": "بعد اشاره می‌کنه به روایت ابن مسعود از پیغمبر که هرکس سوره واقع را هر شب بخونه هیچگاه محتاج نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 983.7,
   "end": 987.22,
   "text": "اینو پیغمبر فرموده. ابن مسعود هم راوی قصه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 987.22,
   "end": 992.16,
   "text": "به خدا این‌ها دعوای درد ما همش تو قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 992.16,
   "end": 994.88,
   "text": "اگر جای دیگه رجوع کنیم ضرر کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 994.88,
   "end": 1001.44,
   "text": "برای اونایی هم که هوای منزلشون دستپختش خیلی خوب نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1001.44,
   "end": 1007.68,
   "text": "یه چیزی عرض کنیم. سور-- آیه‌ی نور رو حالا این‌ها به یه لطائف الهی‌علی اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1007.68,
   "end": 1012.18,
   "text": "ولی شما انجام بدی نور میاد تو زندگیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1012.18,
   "end": 1020.02,
   "text": "آیه‌ی نور رو، آیه‌ی سی و پنج سوره نور رو بدمی به غذا، غذا خوش طبع می‌شه، خوش طعم می‌شه، خوشمزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1020.02,
   "end": 1023.66,
   "text": "شاید یه کس دیگه بخونه که-- بخوره که اینو نخونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1023.66,
   "end": 1028.12,
   "text": "شاید براش اینطوری نشه ولی برای شما و خونواده می‌شه و خانمتون یاد بدید بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1028.12,
   "end": 1030.4,
   "text": "بعد در کنارش روایت داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1030.4,
   "end": 1033.18,
   "text": "اونایی که می‌خورن بطنشون نورانی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1033.18,
   "end": 1035.86,
   "text": "بعد محبت تو خونواده زیاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1035.86,
   "end": 1041.82,
   "text": "اصلاً دستورالعمل داریم برای خانم وقتی میره تو آشپزخونه چه کارهایی انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1041.82,
   "end": 1048.68,
   "text": "حالا دیگه بماند انشاالله اگر توفیق شد که اونچه که موند رو فردا می‌گیم اگر نه که دیگه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1048.68,
   "end": 1051.14,
   "text": "شرح کتاب الموت رو ادامه میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1051.14,
   "end": 1056.98,
   "text": "انشاالله عاقبت بخیر بشیم به برکت صلوات بر محمد و آل محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}