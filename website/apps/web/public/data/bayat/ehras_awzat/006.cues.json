 },
 "chapters": [
  {
   "index": 0,
   "title": "و به او استعانت می‌جوییم.",
   "start": 25.1,
   "end": 135.12
  },
  {
   "index": 1,
   "title": "## بازگشت به احراز و عوذات؛ هدایای آیت‌الله بهجت",
   "start": 135.12,
   "end": 184.26
  },
  {
   "index": 2,
   "title": "### حرز امام جواد علیه‌السلام بر بازو",
   "start": 184.26,
   "end": 212.46
  },
  {
   "index": 3,
   "title": "### ختم سورهٔ واقعه",
   "start": 212.46,
   "end": 240.42
  },
  {
   "index": 4,
   "title": "### نماز روز پنج‌شنبه",
   "start": 240.42,
   "end": 334.14
  },
  {
   "index": 5,
   "title": "## شش کارِ توأمان برای حلّ مطلق مشکلات",
   "start": 334.14,
   "end": 549.08
  },
  {
   "index": 6,
   "title": "## کیمیای ذکر استغنا",
   "start": 549.08,
   "end": 836.4
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 5.26,
   "text": "محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.26,
   "end": 12.9,
   "text": "اللهُم صل علی محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.9,
   "end": 16.18,
   "text": "بسم الله الرحمن الرحیم و بهیم استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.18,
   "end": 21.66,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.66,
   "end": 24.02,
   "text": "سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.02,
   "end": 29.88,
   "text": "تبریک عرض می‌کنم این روز بسیار با عظمت و بی‌نظیر رو محضر شما خوبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.88,
   "end": 34.2,
   "text": "و دلشدگان این خاندان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.2,
   "end": 36.3,
   "text": "خاصه به عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.3,
   "end": 40.3,
   "text": "پاسدار و به خاصة جانبازان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.3,
   "end": 45.52,
   "text": "عزیز جنگ و دفاع تبریک ویژه عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.52,
   "end": 53.98,
   "text": "انشاالله که تحت عنایت‌های خاص و ویژه‌ی علمدار کربلا همگیمون قرار بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.98,
   "end": 58.62,
   "text": "یه دستورالعملی بسیاری از بزرگان من دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.62,
   "end": 62.9,
   "text": "داشتن. حالا چه حضوری ازشون اخذ کردیم، چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.9,
   "end": 65.06,
   "text": "آثارشون دیدیم. خوبه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.06,
   "end": 68.5,
   "text": "البته هر روز میشه این کارو کرد ولی امروز دیگه خیلی بهتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.5,
   "end": 70.06,
   "text": "نور على نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.06,
   "end": 73.9,
   "text": "یه توسلی به حضرت اباالفضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.9,
   "end": 77.62,
   "text": "به این شکل که فرمودن دو رکعت نماز می‌خونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.62,
   "end": 80.0,
   "text": "نماز حاجت هدیه می‌کنی به آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.0,
   "end": 83.46,
   "text": "حضرت اباالفضل بابی الحوائج دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.46,
   "end": 87.76,
   "text": "بعد تسبیح حضرت زهرا رو هدیه می‌کنی به آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.76,
   "end": 93.12,
   "text": "بعد به عدد ابجد اسم عباس که صد و سی و سه مرتبه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.12,
   "end": 98.58,
   "text": "همین ذکر شریف یا کاشف الكرب عن وجه الحسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.58,
   "end": 103.28,
   "text": "اکشف کربی بحق اخیک الحسین علیه السلام اینو میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.28,
   "end": 109.2,
   "text": "حالا چه شیرین که اسم اباصالح هم هر-- اون حروف ابجدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.2,
   "end": 111.18,
   "text": "عدد ابجدش صد و سی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.18,
   "end": 115.94,
   "text": "سه هست که به قول حضرت استاد این اعداد روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.94,
   "end": 120.76,
   "text": "روح اون الفاظن. جالبه که بدونید لفظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.76,
   "end": 125.2,
   "text": "یا کاشف الكرب این لفظه، این به منزله بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.2,
   "end": 129.4,
   "text": "روحش عددشه. یعنی بهش روح میده این عددها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.4,
   "end": 134.9,
   "text": "خیلی اینا مهمه. حالا امروز کسی تونست به هر حاجتی، هر مشکلی که داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.9,
   "end": 137.88,
   "text": "چون بحث ما پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.88,
   "end": 141.9,
   "text": "احراز و عوضات و ادعیه و این‌ها بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.9,
   "end": 144.86,
   "text": "و در هدایایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.86,
   "end": 155.0,
   "text": "حضرت آقای بهجت علیه الرحمه به دوستانشون، نزدیکانشون هدیه کرده بودند یا به حقیر بودیم و بحث کارمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.0,
   "end": 160.28,
   "text": "در خصوص دو سه موضوع نسبت به وقتی که داریم دو مرتبه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.28,
   "end": 162.86,
   "text": "به شما تقدیم می‌کنم چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.86,
   "end": 172.06,
   "text": "هدیه ایشون رو. بحث ما چون بیشتر پیرامون اجنه و طلسم و جادو و باطل کردن این‌ها بود، اولین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.06,
   "end": 177.44,
   "text": "تاکید ایشون رو پیرامون باطل کردن طلسم خدمت شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 177.44,
   "end": 181.72,
   "text": "سه تا کار ایشون فرمودن م-- با هم توأمان نه یه دونه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.72,
   "end": 184.26,
   "text": "سه تا کار رو با هم انجام بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.26,
   "end": 186.96,
   "text": "یک فرمودن که حرز امام جواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.96,
   "end": 191.8,
   "text": "رو به بازو ببندید. تاکید داشتن به بازو نه که همراه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.8,
   "end": 198.68,
   "text": "خودشون می‌فرمودن که یه مدتی به بازو بسته بودن خود آقای بهجت بعد بازوشون درد گرفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.68,
   "end": 202.06,
   "text": "بعد انداخته بودن گردنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 202.06,
   "end": 208.34,
   "text": "می‌فرمودن خودشون یعنی به تجربه رسیده بودن به اینکه نه اثرش تو بازو بستنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.34,
   "end": 212.46,
   "text": "خیلی حالا چه سری هست الله اعلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 212.46,
   "end": 218.86,
   "text": "در کنار این ختم سوره واقعه که هر وقت دوشنبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 218.86,
   "end": 222.16,
   "text": "روز دوشنبه شد اول ماه قمری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 222.16,
   "end": 223.92,
   "text": "دیگه بلدید ختمشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.92,
   "end": 227.94,
   "text": "چهارده روز ختم واقعه دارید که روز اول یک بار، روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.94,
   "end": 233.0,
   "text": "دوم دو بار همینطوری تا روز چهاردهم که چهارده بار سوره واقعه رو می‌خونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 233.0,
   "end": 235.8,
   "text": "بعد که تموم میشه یه دعایی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 235.8,
   "end": 240.42,
   "text": "اون دعا حتماً تاکید داشتن که همراه اون دعا این ختم رو انجام بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.42,
   "end": 243.56,
   "text": "در کنار این نماز روز پنج شنبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.56,
   "end": 247.14,
   "text": "اوه، اوه، اوه. چی بگم از این نماز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.14,
   "end": 250.56,
   "text": "خاصه برای عزیزانی که منبر میرن، روضه می‌خونن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.56,
   "end": 253.58,
   "text": "جلسات ذکر و این‌ها دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.58,
   "end": 255.56,
   "text": "عرض می‌کنم چه خصوصیتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 255.56,
   "end": 262.08,
   "text": "این نماز من دیدم پیغمبر عزیز عالم فرمودند که یعنی امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.08,
   "end": 264.44,
   "text": "به نقل از جدشون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.44,
   "end": 269.22,
   "text": "کوه رو اگر بخوای جابجا کنی با این نماز می‌تونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.22,
   "end": 275.58,
   "text": "خیلی نماز عجیبیه. حالا آقای بهجت می‌فرماید این در کنار اون دو تا طلسم و هر طلسمی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.58,
   "end": 279.02,
   "text": "هر چقدر هم سنگین باشه باطل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.02,
   "end": 285.72,
   "text": "دیگه دنبال چی هستی؟ هی این ور اون ور رمالی و جادوگری و پول بدی خرج کنی که طرف یه دعا برات بنویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.72,
   "end": 288.94,
   "text": "بسم الله. نماز روز پنج شنبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.94,
   "end": 295.24,
   "text": "خب شما می‌خوای بری ذکر-- روضه بخونی، عزیز دلان دعا کمال بخونی، منبر بری هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.24,
   "end": 303.73,
   "text": "بی-- بی-- بدون تعارف واقعاً جسارت نکنم بدون تعارف هم رو دوش خودمون بار سنگین کوهی از گناهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 303.73,
   "end": 306.6,
   "text": "همونایی که میان. هیچکس که معصوم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 306.6,
   "end": 315.68,
   "text": "شما می‌خوای چگونه بخونی که بار اون کوه گناه رو از رو دوش خودت و شرکت‌کنندگان در جلسه ذکر جابجا کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 315.68,
   "end": 323.2,
   "text": "این نماز می‌تونه. هر طلسمی رو می‌تونه باطل کنه، هر سحری رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 323.2,
   "end": 329.28,
   "text": "چهار رکعت به دو سلام در روز پنج شنبه هر ساعتی که تونستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 329.28,
   "end": 333.6,
   "text": "در رکعت اول بعد از حمد یازده بار قل هوالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 333.6,
   "end": 336.74,
   "text": "رکعت دوم بعد از حمد بیست و یک بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 336.74,
   "end": 341.52,
   "text": "قل هوالله. رکعت سوم بعد از حمد سی و یک بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 341.52,
   "end": 343.58,
   "text": "هی ده تا ده تا اضافه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 343.58,
   "end": 347.2,
   "text": "رکعت چهارم بعد از حمد چهل و یک بار قل هوالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 347.2,
   "end": 350.96,
   "text": "دو رکعت، دو تا دو رکعت تموم شد سلام دادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 350.96,
   "end": 354.26,
   "text": "پنجاه و یک بار قل هوالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 354.26,
   "end": 356.72,
   "text": "پنجاه و یک صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 356.72,
   "end": 358.98,
   "text": "بعد میری به سجده ده--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.98,
   "end": 362.78,
   "text": "صد بار در سجده صد بار میگی یا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 362.78,
   "end": 367.38,
   "text": "بعد دعاهاتو می‌کنی چقدر تاکید داشت آقای بهجت به این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 367.38,
   "end": 370.24,
   "text": "اتفاقا اون کتاب قشنگ بهجت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 370.24,
   "end": 376.86,
   "text": "دعا رو اگر بگیرید دستورالعمل همین چیزی که من حالا امروز به شما گفتم اون تو اومده از آقای بهجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 376.86,
   "end": 380.44,
   "text": "البته روایت اهل بیت رو هم آقای بهجت تصریح داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 380.44,
   "end": 383.24,
   "text": "این یه د-- یه دستور العمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 383.24,
   "end": 386.82,
   "text": "برای باطل کردن سحره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 386.82,
   "end": 390.26,
   "text": "دومیش فرمودن برای حل مشکل، مطلق مشکلات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 390.26,
   "end": 396.6,
   "text": "مشکلاتی که دارید، مطلقا هر مشکلی دارید، کوچیک، درشت، هرچی که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 396.6,
   "end": 399.48,
   "text": "فرمودن این شش تا کار رو با هم انجام بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 399.48,
   "end": 406.44,
   "text": "بعضی جاها من دیدم که نوشته آقای بهجت شش تا توصیه داشته برای رفع مشکلات بعد جدا جدا گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 406.44,
   "end": 411.66,
   "text": "این، این غلطه. حواستون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 411.66,
   "end": 413.72,
   "text": "باید با هم انجام بدی شش تاشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 413.72,
   "end": 416.08,
   "text": "اول فرمودن که یه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 416.08,
   "end": 421.6,
   "text": "کوچیک جیبی همراهت باشه همیشه و لو نمی‌خونیش و لو ریزه نمی‌تونی بخونیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 421.6,
   "end": 426.88,
   "text": "یه قرآن جیبی. بعد جالبه که یه روزی من دیدم به یه حافظ قرآن این توصیه رو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 426.88,
   "end": 432.5,
   "text": "پس فقط این نیست که طرف حفظ قرآن داره دیگه کفایت کنه و قرآن همراهش نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 432.5,
   "end": 434.92,
   "text": "نه. حالا چه سریه اون‌ها می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 434.92,
   "end": 438.02,
   "text": "یه قرآن کوچیک جیبی همیشه همراهت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 438.02,
   "end": 441.28,
   "text": "در کنارش معوذتين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 441.28,
   "end": 444.0,
   "text": "ناس و فلق رو تکرار کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 444.0,
   "end": 447.4,
   "text": "نه یکی دو بار. تو روز هر وقت یادت اومد بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 447.4,
   "end": 453.84,
   "text": "در کنار این سومیش آیه الکرسی رو هم بخوانی هر روز هم نصب کنی تو منزلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 453.84,
   "end": 456.6,
   "text": "اونم با دست خط خودت بنویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 456.6,
   "end": 461.42,
   "text": "نه اینکه بری حالا توی جاهایی که من تو کتاب‌ها این‌ها و حتی زمزمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 461.42,
   "end": 466.04,
   "text": "عارفان که آقای ری شهری از بیانات ایشون جمع کرده دیدم اینو تا اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 466.04,
   "end": 469.16,
   "text": "تذکر نداده که بعضیا نمی‌دونن میرن می‌خرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 469.16,
   "end": 472.08,
   "text": "آیه الکرسی چاپی می‌خرن. نه این اون اثر رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 472.08,
   "end": 476.14,
   "text": "خودت با دست خط خودت می‌نویسی میذاری تو خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 476.14,
   "end": 478.7,
   "text": "چهارم. چهار قل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 478.7,
   "end": 481.74,
   "text": "که قل يا ايها الكافرون، قل هو الله احد، ناس و فلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 481.74,
   "end": 485.3,
   "text": "البته ما پنج تا قل داریم. ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 485.3,
   "end": 487.36,
   "text": "سوره جن هم با قل شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 487.36,
   "end": 489.8,
   "text": "اما این چهار تا قل که گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 489.8,
   "end": 494.39,
   "text": "این‌ها رو به تکرار مخصوصا قبل خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 494.39,
   "end": 497.2,
   "text": "هم تکرار می‌کنی در روز هم قبل خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 497.2,
   "end": 501.0,
   "text": "پنجم. اذان رو هر وقت که اذان وقت اذان شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 501.0,
   "end": 506.36,
   "text": "هر جا بودی به صدای نسبتا بلند اذان بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 506.36,
   "end": 509.96,
   "text": "حالا چه تأثیری درش هست الله اعلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 509.96,
   "end": 515.24,
   "text": "حالا یه من دیدم بعضی از بزرگان حتی و من این توصیه رو خودم به بعضیا کردم دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 515.24,
   "end": 519.32,
   "text": "چه جالب نتیجه‌شو اومدن گفتن اصلا مشکل حل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 519.32,
   "end": 521.68,
   "text": "اینا که بچه‌هاشون بیش فعاله اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 521.68,
   "end": 527.62,
   "text": "بزرگان گفتن برای آروم کردن بچه اذان تو دو تا گوشش بگید هر روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 527.62,
   "end": 531.24,
   "text": "حالا چه سری در این‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 531.24,
   "end": 537.78,
   "text": "ششم و آخریش هم فرمودن روزی پنجاه تا آیه رو بخونید با صدای نسبتا بلند، نه آروم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 537.78,
   "end": 542.42,
   "text": "با صدای نسبتا بلند نه که داد بزنی، نه که آروم بخونی نسبتا بلند پنجاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 542.42,
   "end": 547.06,
   "text": "این شش تا کار هر مشکلی رو آقای بهجت می‌گه چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 547.06,
   "end": 553.76,
   "text": "از طرف می‌کنه و آخرین هدیه هم که تقدیم کنیم زیاد هست حالا عنایاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 553.76,
   "end": 556.42,
   "text": "اون‌ها داشتن به دوستانشون این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 556.42,
   "end": 560.3,
   "text": "اون چند وقتی هم که ما ریزه خور سفره‌شون بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 560.3,
   "end": 570.94,
   "text": "این رو هم خواهش می‌کنم اگر انجام ندادید خودتون به اهدی سفارشش رو نکنید و اصلا خودتون هم فراموشش کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 570.94,
   "end": 575.62,
   "text": "و البته نیازی هم نبود من بگم خدا از ذهنتون می‌بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 575.62,
   "end": 581.38,
   "text": "اگر به درد شما نخوره. آقای بهجت می‌فرمودن این کیمیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 581.38,
   "end": 588.22,
   "text": "یکی از همون هدایاییه که بهتون گفتم یه روزی بهتون میگم شاید تو کتاب‌ها دیده باشید توجه نداشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 588.22,
   "end": 591.74,
   "text": "می‌فرمودن کیمیاست. چی دنبال کیمیائه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 591.74,
   "end": 594.86,
   "text": "مثلا با مس، مس رو ورداری طلا کنی این کیمیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 594.86,
   "end": 601.96,
   "text": "الان به هرکی این علم رو داشته باشه چه به قول ما نونش تو روغنه یا پدربزرگ‌ها، مادربزرگ‌ها می‌گفتن پسرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 601.96,
   "end": 605.26,
   "text": "دخترم دست به خاک می‌بری انشاالله طلا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 605.26,
   "end": 608.82,
   "text": "یعنی همین کیمیا. این یعنی کیمیا داشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 608.82,
   "end": 614.1,
   "text": "خب این چیه؟ آقای بهجت می‌فرماید با اعتقاد بگو اگه نداری نگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 614.1,
   "end": 621.0,
   "text": "مخصوصا تو این ذکر. اللهم اغننی بحلالک عن حرامک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 621.0,
   "end": 623.5,
   "text": "و بفضلک عن من سواک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 623.5,
   "end": 625.88,
   "text": "الله اکبر از این ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 625.88,
   "end": 629.3,
   "text": "من تجربه شخصیم هم به شما بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 629.3,
   "end": 633.74,
   "text": "حداقل بعد از هر نمازی یه بار اینو تو سجده بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 633.74,
   "end": 638.2,
   "text": "آقای بهجت فرمودن به خود بنده یکی از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 638.2,
   "end": 641.76,
   "text": "هدایایی که به بنده به-- خودشون نوشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 641.76,
   "end": 644.16,
   "text": "و به من دادن همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 644.16,
   "end": 647.88,
   "text": "بعد از نماز صبح همین ذکر رو صد و ده بار گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 647.88,
   "end": 650.5,
   "text": "که تمومه کار یعنی تموم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 650.5,
   "end": 660.7,
   "text": "تمومه دیگه. من اگه برای شما بشینم بگم چگونه تو زندگی پنجاه سالم من حيث لا احتسب خدا چی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 660.7,
   "end": 664.74,
   "text": "چگونه تو مسائل مختلف هوامو داشته، شما می‌گید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 664.74,
   "end": 667.22,
   "text": "حاج آقا بی‌خیال، بی‌خیال ما شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 667.22,
   "end": 671.7,
   "text": "این حرفو افسانه نگو. واقعا دعامون بسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 671.7,
   "end": 676.38,
   "text": "یک اثرش همین نفس اون اولیا در این کیمیاهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 676.38,
   "end": 680.74,
   "text": "که حالا یه استادی هم داشتیم برجسته‌ترین شاگرد آقای بهجت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 680.74,
   "end": 684.16,
   "text": "من در محضر ایشون عرفان و فلسفه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 684.16,
   "end": 687.52,
   "text": "درس گرفتم. غول عرفان و فلسفه آقای حداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 687.52,
   "end": 689.48,
   "text": "معروف به طائف الحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 689.48,
   "end": 696.62,
   "text": "تمام روضه‌های آقای بهجت رو ایشون می‌خوند در محضر آقای بهجت کسی جگر نداشت پیش ایشون روضه بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 696.62,
   "end": 701.32,
   "text": "الحمدالله هنوزم هستن و متأسفانه از تهران رفتن مشهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 701.32,
   "end": 707.34,
   "text": "رفتن جای خالی اون استوانه مشهد رو که از دنیا رفتن رو ایشون پر کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 707.34,
   "end": 712.5,
   "text": "ایشون حالا چیزهایی یادگار ما از ایشون داریم یکیش همین ذکر رو به من گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 712.5,
   "end": 715.4,
   "text": "اگر که حالا نمی‌تونی مثلا صد و ده بار بگی بعد از نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 715.4,
   "end": 719.96,
   "text": "صبح هفت بار بعد از نماز صبح بگو برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 719.96,
   "end": 726.94,
   "text": "اینکه دین و بدهکاری قرض از رو دوشت برداشته بشه و برکت رزق پیدا کنی خیلی مؤثره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 726.94,
   "end": 728.6,
   "text": "حالا آقای بهجت که گفت کیمیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 728.6,
   "end": 731.7,
   "text": "یعنی شما می‌تونی با این هر کاری بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 731.7,
   "end": 735.2,
   "text": "الله اکبر. اینا رو من خواهش می‌کنم جدی بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 735.2,
   "end": 738.76,
   "text": "بعد هی می‌گیم هشتمون گره، نونمون همش گرفتاریم چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 738.76,
   "end": 741.9,
   "text": "خب غافلیم. اینو این همه هدیه، هدیه ریختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 741.9,
   "end": 748.77,
   "text": "بسم الله بردار یکیشو، دو تاشو، همشو به نسبت سعه وجودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 748.77,
   "end": 753.68,
   "text": ". انشاالله که خدای مهربان ما رو قدرشناس اولیای خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 753.68,
   "end": 756.54,
   "text": "سینه های سوخته‌شون قرار بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 756.54,
   "end": 760.42,
   "text": "و در این روز عزیز باب الهوائج نزد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 760.42,
   "end": 770.28,
   "text": "حضرت ام البنین واسطه فیض همه ما بشه که فرمودن نذر گمشده کسی گمشده داره نذر ام البنین کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 770.28,
   "end": 777.56,
   "text": "ام البنین. خودتو گم کردی به-- حضرت عابد الفضل بگو امروز شمائه سفارش ما رو به مادرت بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 777.56,
   "end": 781.08,
   "text": "تو حرم حضرت عبدالعظیم بودیم سلام الله عليه پری شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 781.08,
   "end": 784.06,
   "text": "یکی مستأصل شده بود از رفیقامون مداح اهل بیت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 784.06,
   "end": 787.6,
   "text": "یه بچه ای رو یازده ساله گم کرده بود تو حرم پیداش نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 787.6,
   "end": 790.62,
   "text": "گفتم خندیدم گفتم بی‌خیال با-- تو دیگه چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 790.62,
   "end": 795.44,
   "text": "همین الان شروع کن صلوات و استغفار هدیه به حضرت ام البنین ببین چجوری پیدا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 795.44,
   "end": 799.2,
   "text": "خدا شاهده می‌گیرم دو بار ماشین خود منو از جلوی خونه دزدیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 799.2,
   "end": 802.82,
   "text": "البته مال برادرخانه‌ام هم بود زیر پای من بود، امانت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 802.82,
   "end": 806.0,
   "text": "عین دوبارش که دزدیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 806.0,
   "end": 813.48,
   "text": "شروع کردم هدیه به حضرت ام البنین تسبیح به دست می‌گفتم عین دوبارش به ساعت نکشید پیدا شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 813.48,
   "end": 817.16,
   "text": ". باورتون شاید نشه. اینا دیگه حقایق عالمو داریم می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 817.16,
   "end": 819.1,
   "text": "امام عصر ما گم شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 819.1,
   "end": 823.64,
   "text": "امام که گم نشده. برای اینکه ما برگشت، برگشت کنیم به اماممون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 823.64,
   "end": 827.94,
   "text": "نذر حضرت ام البنین کنید. گمشده‌هامون پیدا می‌شه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 827.94,
   "end": 832.88,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 832.88,
   "end": 836.4,
   "text": "اللهumma صلي على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}