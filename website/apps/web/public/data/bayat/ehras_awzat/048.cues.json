 "chapters": [
  {
   "index": 0,
   "title": "## هدیه از نکتهٔ نهصد و سیزده",
   "start": 0.54,
   "end": 27.32
  },
  {
   "index": 1,
   "title": "## تأکید علامه در همهٔ درس‌ها",
   "start": 27.32,
   "end": 86.72
  },
  {
   "index": 2,
   "title": "یعنی تأثیرش در کثرت است؛ در اکثار؛ در زیاد گفتن. نه آنکه چند بار بر زبان آورد و بس. ذکری است بسیار عالی، بسیار شریف:",
   "start": 86.72,
   "end": 106.9
  },
  {
   "index": 3,
   "title": "## حیات عقل و دوری از آلودگی",
   "start": 106.9,
   "end": 153.6
  },
  {
   "index": 4,
   "title": "## همت در استقامت، نه حال",
   "start": 153.6,
   "end": 203.2
  },
  {
   "index": 5,
   "title": "## اربعین؛ حداقل اثر بارز",
   "start": 203.2,
   "end": 246.68
  },
  {
   "index": 6,
   "title": "## عمل تا یک سال و ادراک لیلة القدر",
   "start": 246.68,
   "end": 288.06
  },
  {
   "index": 7,
   "title": "## قرب ذکر به اسم اعظم",
   "start": 288.06,
   "end": 398.1
  },
  {
   "index": 8,
   "title": "و همین صیغه چندین بار در قرآن آمده است.",
   "start": 398.1,
   "end": 464.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.54,
   "end": 5.14,
   "text": "هدیه‌ای که امروز تقدیم می‌کنم خدمتتون می‌تونید در نکته نهصد و سیزده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.14,
   "end": 7.06,
   "text": "کتاب هزار و یک نکته حضرت استاد ببینیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.06,
   "end": 11.12,
   "text": "این کتابی که الآن دست بنده است هزار و یک نکته حضرت استاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.12,
   "end": 13.26,
   "text": "ایشون در نکته نهصد و سیزده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.26,
   "end": 17.36,
   "text": "می‌فرمایند عارف عبد الرضا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.36,
   "end": 22.3,
   "text": "مولی عبد الرضا در شرح منازل الصائرین فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.3,
   "end": 25.56,
   "text": "در شرح منازل الصائرین خواجه عبدالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.56,
   "end": 29.3,
   "text": "ایشون می‌فرماید که البته عزیزانی که اصوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.3,
   "end": 34.18,
   "text": "چه شرح اشارات حضرت استاد رو، چه شرح فسوس رو، چه شرح اسفار رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.18,
   "end": 36.88,
   "text": "چه تمهید القواعد رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.88,
   "end": 39.0,
   "text": "چه منازل الصائرین و چه عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.0,
   "end": 41.18,
   "text": "نصف العنس حضرت استاد اینا رو شنیده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.18,
   "end": 46.96,
   "text": "تو همه‌ی این‌ها ما شنیدیم که حضرت استاد تأکید کردن بر این ذکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.96,
   "end": 54.56,
   "text": "بر این ذکر شریف. پس پیداست که چون تو همه‌ی درس و بحث‌هاشون ایشون تأکید کردن پیداست که ذکر مبارکی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.56,
   "end": 57.46,
   "text": "که سندش رو هم اینجا تو این نکته می‌فرماین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.46,
   "end": 60.66,
   "text": "ذکر اینه البته می‌فرما قجره القوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.66,
   "end": 64.86,
   "text": "ان الاکثار من ذکر یعنی تأثیرش در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.86,
   "end": 67.04,
   "text": "کثرت اکثار زیاد گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.04,
   "end": 71.78,
   "text": "نه همینجوری یه چند بار بگی. ذکرم بسیار عالی، بسیار شریف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.78,
   "end": 76.58,
   "text": "یا حی یا قیوم، یا حی یا قیوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.58,
   "end": 80.84,
   "text": "یا من، یا من لا اله الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.84,
   "end": 84.26,
   "text": "انت. همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.26,
   "end": 89.26,
   "text": "یا حی یا قیوم، یا من لا اله الا انت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.26,
   "end": 91.48,
   "text": "یا حالا اگر ادغام می‌شه اون نون در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.48,
   "end": 93.32,
   "text": "جسارتا در لام دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 93.32,
   "end": 98.74,
   "text": "دیگه یا من نمیگی. میگی یا من لا اله الا انت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 98.74,
   "end": 102.8,
   "text": "بعد اینجا مرحوم عبد الرضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.8,
   "end": 104.72,
   "text": "می‌فرماید یوجب حیات العقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.72,
   "end": 108.82,
   "text": "تأثیر این ذکر در چیه؟ حیات عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 108.82,
   "end": 111.38,
   "text": "نمی‌ذاره عقل انسان بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 111.38,
   "end": 117.44,
   "text": "وقتی اهمیت تأثیر این ذکر رو متوجه می‌شیم که اهمیت عقل رو بفهمیم و حیات عقل رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.44,
   "end": 119.58,
   "text": "اساساً آلودگی ما بارها عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.58,
   "end": 124.2,
   "text": "بر اساس آیه‌ی صد و سه یونس که یجعل الرجس على الذين لا يعقلون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 124.2,
   "end": 128.3,
   "text": "از اونجا این ناشی می‌شه آلودگی‌های ما که عقل تعطیل می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 128.3,
   "end": 135.5,
   "text": "عقل می‌میره. خب پس اگر کسی این ذکر رو اکثار داشته باشه قطعاً حیات عقلش باعث می‌شه که از آلودگی فاصله بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.5,
   "end": 139.16,
   "text": "به همین راحتی. اگه کسی از آلودگی رنج می‌بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.16,
   "end": 142.14,
   "text": "هر آلودگی، هر آلودگی مطلقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.14,
   "end": 150.3,
   "text": "چه در قوای ظاهری‌ش، حواس پنجگانه‌ش، چه قوای باطنی‌ش، قوه خیالش و این‌ها یا وهمش اذیت در عذیت این ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.3,
   "end": 151.88,
   "text": "شریف رو اکثار داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.88,
   "end": 156.36,
   "text": "البته حوصله بکنید من چند خط از همین نکته رو بخونم به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.36,
   "end": 161.34,
   "text": "حضرت استاد ادامه میدن که کلمه اکثار را در حصول نتیجه دخلی تمام است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.34,
   "end": 166.52,
   "text": "که همت در استقامت باید نه حال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.52,
   "end": 169.56,
   "text": "یعنی نه فقط به حال اکتفا کنی که حالا یه حالی دست داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.56,
   "end": 176.44,
   "text": "نه همت باید باشه که کثرت استف-استفاده و استعمال این ذکر انسان رو برسونه به اون سرمنزل مقصود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.44,
   "end": 177.88,
   "text": "نه حال فقط که اصحاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.88,
   "end": 187.94,
   "text": "حال ممکن است اهل قیل و قال شوند اما شهود طلعت سعادت و اطلاع به جنت قرب و مکاشفات انسانی الهم اهل همت راست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.94,
   "end": 194.96,
   "text": "اهل همت موقعی که میگیم اکثار حضرت استاد دارن می‌فرمایند وقتی میگیم اکثار واقعاً کثرت داشته باشه ذکرشما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.96,
   "end": 200.58,
   "text": "نه اینکه حالا ده تا دونه، صد تا دونه بگن و رها کنن بعد توقع داشته باشن حضرت جل جلاله الان نازل بشه براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.58,
   "end": 204.82,
   "text": "نه اینا به جایی نمی‌رسه. و ادامه فرمایش حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.82,
   "end": 208.76,
   "text": "و هر عمل و ذکری که کمتر از اینها نکته‌ست و خیلی مهمه اینا برای من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.76,
   "end": 213.9,
   "text": "هر عمل و ذکری که کمتر از اربعین باشد چندان اثر بارزی ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.9,
   "end": 216.56,
   "text": "قابل توجه اینا که دائماً می‌پرسن آقا این ذکر رو چند بار بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.56,
   "end": 218.3,
   "text": "چقدر بگیم؟ چند وقت بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.3,
   "end": 220.34,
   "text": "حضرت استاد می‌فرماید اقلش اربعینه، چهل روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.34,
   "end": 226.84,
   "text": "کمتر از چهل شبانه روز بگه تأثیر آن‌چنانی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.84,
   "end": 230.12,
   "text": "و خاصیت اربعین در ظهور فعلیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.12,
   "end": 233.92,
   "text": "و بروز استعداد، دیگه بروز استعداد خودش فعالیته دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.92,
   "end": 240.17,
   "text": "و قوه و حصول ملکه امری مسرّح به در آیات و اخبار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.17,
   "end": 243.14,
   "text": "و در ادامه حالا این برای تنبلا بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.14,
   "end": 246.68,
   "text": "جسارتا. برای اونایی که دنبال چیل صوفه بودن اینا، اینا تا اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.68,
   "end": 249.6,
   "text": "حالا برای اونایی که می‌خوان رشد بیشتری کنن، ارتقای وجودی پیدا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.6,
   "end": 256.44,
   "text": "و در ادامه عمل به یک سال تا ادراک ليلة القدر شود هم در مجامع روایی از اهل بیت عصمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.44,
   "end": 259.36,
   "text": "و وه-- علیهم السلام روایت شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.36,
   "end": 263.9,
   "text": "بعد شروع می‌کنه چند تا روایت از همین باب میاره که چقدر اهل بیت تصریح داشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.9,
   "end": 265.3,
   "text": "اصرار داشتن بر اینکه یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.3,
   "end": 270.08,
   "text": "عملی رو دست گرفتی یا دست نگیر یا دست گرفتی تا یک سال ادامه بده تا آثار و برکاتشو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.08,
   "end": 273.1,
   "text": "تا ليلة-- اقلش دیگه، اقلش اینه که تا ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.1,
   "end": 277.8,
   "text": "حالا بعضیا شاید زیرک و زرنگ باشن به خیال خودشون بگن خب الان مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.8,
   "end": 281.96,
   "text": "چهار روز، سه روز، دو روز، یه روز مونده به ليلة القدر ما دست می‌گیریم دیگه روایتم می‌گه تا ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.96,
   "end": 285.48,
   "text": "نه دیگه این اشتباهات، این مداعبات نفسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.48,
   "end": 287.52,
   "text": "بازیگوشی‌های خُلق خیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.52,
   "end": 291.22,
   "text": "که حالا در خصوص عظمت و عظمت این ذکر من زبانم قاصر است چی بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.22,
   "end": 296.48,
   "text": "در یکی از جلساتی که حضرت استاد در شرح نصف العنس مرحوم ابن فناری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.48,
   "end": 300.36,
   "text": "که می‌دونید قوی‌ترین و سنگین‌ترین کتاب در حوزه عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.36,
   "end": 306.56,
   "text": "نظری‌ست داشتن، اونجا اشاره داشتن به این ذکر یا حی یا قیوم که فرمودن غریبه به اسم اعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 306.56,
   "end": 310.02,
   "text": "مضمون سخنرانی‌شون این بود. بعد البته مفصل صحبت کردن ایشون که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.02,
   "end": 312.6,
   "text": "هر کجا که در میان آیات یا روایات رد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.6,
   "end": 316.8,
   "text": "پایی رو در میان اهل بیت علیهم-- در گفتار اهل بیت می‌یابید که می‌فرمایند این آ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.8,
   "end": 324.42,
   "text": "اینجا تو این آیه، تو این سوره، توی این دعا اسم اعظم اومده می‌بینید غالباً اسم الحي و القيوم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.42,
   "end": 326.76,
   "text": "این سخن حضرت استاده من به شما عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.76,
   "end": 330.02,
   "text": "که اشاره دارن که کأنّه این خودش اسم اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.02,
   "end": 333.12,
   "text": "خود یا حی یا قیوم که همه به او حیات دارن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.12,
   "end": 337.58,
   "text": "حیات همه به اوست و همه قائم به او هستند و او قیوم همه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 337.58,
   "end": 340.82,
   "text": "خیلی ذکر عالی‌ایه. خیلی قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.82,
   "end": 345.72,
   "text": "دیگه اون يا ملًّا إله إلا أنت که دیگه میاد عالی‌ترش می‌کنه که حالا إله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.72,
   "end": 348.88,
   "text": "خود إله رو اگر کسی در بحث اسماء الحسنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.88,
   "end": 354.03,
   "text": "کار کرده باشه مثلا اسماء الحسنی مرحوم حاج آقا صدر‌الذین علیه الرحمة عالیه به قول حضرت استاد رساله ناقلاییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.03,
   "end": 356.8,
   "text": "ایشون می‌فرمودن. در خصوص إله برید ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.8,
   "end": 361.62,
   "text": "یا مثلا مفردات خود قرآن، کتاب مفردات قرآن آورده بودم چند هفته پیش اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.62,
   "end": 367.2,
   "text": "که مثلا می‌فرمود صد و چهل و هفت جای قرآن اسم إله اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.2,
   "end": 369.18,
   "text": "که به جز سی‌وسه مرتبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.18,
   "end": 373.16,
   "text": "یعنی سی‌وسه رو از صد و چهل و هفت کم کنید بقیه‌ش دیگه همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.16,
   "end": 377.68,
   "text": "پیرامون توحید، پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.68,
   "end": 381.6,
   "text": "از کار توحیدی وارد شده لفظ جلالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 381.6,
   "end": 385.96,
   "text": "إله. مثل اینکه لا اله الا الله مثلاً تو قرآنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.96,
   "end": 388.74,
   "text": "لا اله الا هو. لا اله الا انت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.74,
   "end": 391.32,
   "text": "همین که الان تو این ذکر وارد شده. لا اله الا انا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.32,
   "end": 393.14,
   "text": "لا اله الا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.14,
   "end": 398.1,
   "text": "اینا دائماً لا اله الا هو که چندین بار اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.1,
   "end": 405.64,
   "text": "خود إله از حیث لغوی اگر بخواهیم بحث کنیم غالب مفسرین به معنای معبود گرفتنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 405.64,
   "end": 411.56,
   "text": "معبود. از حیث اصطلاحی اگر بخواهیم بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.56,
   "end": 414.68,
   "text": "دو تا نظر هست. گفتن یا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 414.68,
   "end": 417.3,
   "text": "این اشاره داره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.3,
   "end": 421.16,
   "text": "یعنی خود اسم إله اشاره داره به ذات غیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 421.16,
   "end": 429.1,
   "text": "اگر اینچنین بگیم یعنی ذات رو بگیریم بدون توجه به صفات و اسماء، ذات غیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 429.1,
   "end": 436.54,
   "text": "که اصلاً همه عقول بدون استثنا حیرانن در خصوص او حتی عقول اولیاء الهی که بهش می‌گن دیگه اینجا إله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.54,
   "end": 438.36,
   "text": "إله رو می‌گیرن ذاتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.36,
   "end": 442.24,
   "text": "بدون در نظر گرفتن صفات اولیا و اسماء الحسنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.24,
   "end": 443.92,
   "text": "اگه اینطوری باشه از ریشه ولَه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.92,
   "end": 446.66,
   "text": "ولَه یعنی به معنای حیرت، حیران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.66,
   "end": 449.14,
   "text": "همه حیرانن از درک او. عاجزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.14,
   "end": 456.3,
   "text": "اگر بگیریم با در نظر گرفتن ذات رو بگیریم با در نظر به علاوه اسماء و صفات یعنی بگیریم اسم ذاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.3,
   "end": 459.52,
   "text": "إله رو. اون موقع از ریشه آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.52,
   "end": 461.74,
   "text": "آله که همون معنای چی رو میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.74,
   "end": 464.26,
   "text": "معبود رو معنای عبادت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}