 "cues": [
  {
   "i": 0,
   "start": 3.92,
   "end": 6.9,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.9,
   "end": 11.44,
   "text": "السلام علیک ای داعی الله و ربانی ای ایاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.44,
   "end": 15.62,
   "text": "سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.62,
   "end": 19.44,
   "text": "اولا تبریک عرض می‌کنم خدمت همه‌ی شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.44,
   "end": 22.72,
   "text": "این ایام فرخنده و پر از نور رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.72,
   "end": 26.4,
   "text": "واقعا تبریک عرض می‌کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.4,
   "end": 32.04,
   "text": "نمی‌دانیم واقعا چه حق بزرگی این انقلاب گردن ما دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.04,
   "end": 37.56,
   "text": "و می‌طلبد که در این ایام ما چه‌ها بکنیم و نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.56,
   "end": 40.4,
   "text": "بماند. یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.4,
   "end": 43.92,
   "text": "بدترین دشمنی‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.92,
   "end": 46.72,
   "text": "شد تا ما این روزها رو نبینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.72,
   "end": 49.94,
   "text": "از همون ابتدای جنگ شما بگیرید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.94,
   "end": 53.74,
   "text": "از ضرب‌الاجلی که صدام اعلام کرد گفت من دو هفته‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.74,
   "end": 57.48,
   "text": "کار ایران رو یکسره می‌کنم، تمومش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.48,
   "end": 61.92,
   "text": "تا بیا جلوتر منافقین در مرصاد مثلاً گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.92,
   "end": 66.8,
   "text": "نهایتا یک ماهه کار فاتحه‌ی ایران رو می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.8,
   "end": 74.42,
   "text": "بیا جلو همین‌طوری ضرب‌الاجلی که از داخل و خارج هی اعلام کردن گفتن تا همین اواخر که حتی توی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.42,
   "end": 80.1,
   "text": "سه ماه اخیر دیدید که گفتن آره برف رو به خودش دیگه انقلاب نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.1,
   "end": 83.1,
   "text": "برف رو. بیست و دو بهمن رو به خودش نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.1,
   "end": 85.74,
   "text": "همین دشمنای داخلی خارجی این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.74,
   "end": 89.72,
   "text": "با تمام قوا بر علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.72,
   "end": 97.12,
   "text": "نظام ما، ارزش‌های ما، دین ما، مملکت ما دست به دست هم دادن، متفق‌القول شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.12,
   "end": 101.12,
   "text": "اما به فضل الهی نتوانستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.12,
   "end": 107.92,
   "text": "من با توجه به اینکه چون سیر بحث ما کتاب الموت مرحوم مجلسی بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.92,
   "end": 114.78,
   "text": "می‌خوام استفاده کنم اگر یادتون باشه ارتباطش با ملائکه این بود که ملائکه قوای عالم بودند و گفتیم اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.78,
   "end": 117.7,
   "text": "کمک‌کننده‌اند، مددرساند از سمت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.7,
   "end": 121.1,
   "text": "چرا انسان بترسه؟ چرا کم بیاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.1,
   "end": 124.58,
   "text": "این‌ها تا دسته‌های نوزده‌گانه ملائکه رو گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.58,
   "end": 131.04,
   "text": "آخرین ملائک که معرفی کردیم هجدهم و نوزدهم اگر یادتون باشه هاروت و ماروت بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.04,
   "end": 138.34,
   "text": "این‌ها دستور باطل کردن سحر و جادو رو و در امان ماندن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.34,
   "end": 144.28,
   "text": "شر اشرار از جن و انس رو که سحر و جادو می‌کردند رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.28,
   "end": 147.99,
   "text": "مسلمون‌ها به اهل ایمان تعلیم می‌دادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.99,
   "end": 152.66,
   "text": "از این فرصت می‌خوام استفاده کنم، اینجا یه پرانتز باز کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.66,
   "end": 158.42,
   "text": "اینطور که قاطع و یقین متوجه شدیم و می‌شویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.42,
   "end": 161.6,
   "text": "حتی دشمنان جنی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.6,
   "end": 165.1,
   "text": "در براندازی انقلاب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.1,
   "end": 170.72,
   "text": "دست داشتند. اجازه بدید که برای تأیید همین موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.72,
   "end": 173.62,
   "text": "اشاره کنم به صحبت‌های رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.62,
   "end": 176.58,
   "text": "سال گذشته که البته چندین بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.58,
   "end": 185.62,
   "text": "رهبر عزیزمون به بحث اجنه و دخالت‌شون در مواجهه با انقلاب سخن گفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 185.62,
   "end": 191.42,
   "text": "یکیش وقتی بود که اشاره به آیه‌ی صد و دوازده سوره انعام کردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 191.42,
   "end": 195.6,
   "text": "و فرمودند که دشمنان جنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 195.6,
   "end": 201.54,
   "text": "ایشون فرمودند دشمنان جنی و هم دشمنان انسی وجود دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 201.54,
   "end": 206.24,
   "text": "هم جنی هم انسی و این‌ها به هم کمک می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 206.24,
   "end": 210.4,
   "text": "هر دو به هم کمک می‌کنند. نه اینکه جنی‌ها جدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 210.4,
   "end": 214.0,
   "text": "انسان‌ها جدا، نه این‌ها به هم کمک می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 214.0,
   "end": 219.16,
   "text": "سیستم‌های اطلاعاتی خیلی از کشورها علیه ما با هم همکاری می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 219.16,
   "end": 222.82,
   "text": "این صراحتا. بعد این آیه رو حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 222.82,
   "end": 229.96,
   "text": "رهبر عزیز قضا-- قرائت کردند که آیه‌ی صد و دوازده انعام \"و کذلک جعلنا لكل نبي عدوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 229.96,
   "end": 233.58,
   "text": "شياطين الانس والجن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 233.58,
   "end": 238.38,
   "text": "این اصلاً رسم خدا، سنت الهی که برای همه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 238.38,
   "end": 240.9,
   "text": "امم و انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 240.9,
   "end": 246.44,
   "text": "شیاطینی به عنوان دشمن قرار داده از جنس انسان و جن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 246.44,
   "end": 250.98,
   "text": "\"يوحي بعضهم الى بعض زخرف القول غرورا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 250.98,
   "end": 254.88,
   "text": "این‌ها حرف‌های خیلی دلنشین و قشنگ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 254.88,
   "end": 257.64,
   "text": "زرق و برق شده و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 257.64,
   "end": 261.46,
   "text": "میگن که مردم رو با این حرف‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 261.46,
   "end": 264.92,
   "text": "اغوا کنند. می‌تونه یه وجهش رسانه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 264.92,
   "end": 268.5,
   "text": "چقدر بزک کردن تبلیغاتشون چقدر بزک می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 268.5,
   "end": 272.54,
   "text": "همین رسانه چقدر ظاهرش جذابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 272.54,
   "end": 276.78,
   "text": "می‌فرماید \"زخرف القول\" با قول‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 276.78,
   "end": 279.06,
   "text": "پرزیور، زینت آ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 279.06,
   "end": 288.55,
   "text": "زینت‌دار که آدم خوشش میاد این تبلیغاتو می‌بینه اصلاً تو نوع جذابیت‌های بصری‌ش آدم می‌مونه چه برسه به محتواییش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 288.55,
   "end": 291.78,
   "text": "\"ولو شاء ربک ما فعلوها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 291.78,
   "end": 293.88,
   "text": "و اگه خدا می‌خواست این‌طوری نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 293.88,
   "end": 298.78,
   "text": "یعنی این خدا خواسته که این‌ เ ช่ น شما در معرض امتحان دشمنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 298.78,
   "end": 303.44,
   "text": "با اعدا قرار بگیرید و لو حتی از جنس جن‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 303.44,
   "end": 308.06,
   "text": "بعد می‌فرماید \"فذرهم\". رهاشون کن این‌ها رو \"وما يفترون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 308.06,
   "end": 311.16,
   "text": "و اونچه که دروغ می‌بندن و میگن ولشون کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 311.16,
   "end": 316.82,
   "text": "یعنی کار این‌ها با ماست. یه فتنه‌ایه، یه امتحانیه برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 316.82,
   "end": 320.92,
   "text": "اتفاقا داشتم یه برشی از فیلم جوخه انتحار رو می‌دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 320.92,
   "end": 327.56,
   "text": "محصول سال دو هزار و شونزده هالیوود که اونجا نمی‌دونم دیدید یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 327.56,
   "end": 331.92,
   "text": "خیلی جالب بود که افسران ارشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 331.92,
   "end": 336.38,
   "text": "آمریکا، فرمانده‌های ارشد نظامی آمریکا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 336.38,
   "end": 338.96,
   "text": "کسی رو پیدا می‌کنند به نام دکتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 338.96,
   "end": 341.82,
   "text": "مون و با ایشون صحبت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 341.82,
   "end": 344.7,
   "text": "ایشون یه جنی موکلش بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 344.7,
   "end": 352.0,
   "text": "در تحت تصرفش بوده. تو صریحاً اونجا تو فیلم بهش میگن که شما که این جن در اختیارته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 352.0,
   "end": 354.12,
   "text": "باهاش صحبت کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 354.12,
   "end": 356.48,
   "text": "تسخیرش کن، بفرستش ایران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 356.48,
   "end": 358.88,
   "text": "جالبه توی این فیلم. چه سالی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.88,
   "end": 365.98,
   "text": "دو هزار و شونزده. بره از وزارت دفاع ایران اسناد مثلاً محرمانه نظامی‌شون رو برای ما بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 365.98,
   "end": 368.08,
   "text": "صریح هم تو فیلماشون اعلام کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 368.08,
   "end": 371.02,
   "text": "یا مثلا اگه خواستید بیشتر ببینید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 371.02,
   "end": 376.16,
   "text": "شما یه زمانی اِاِاِ ارزیاب برنامه و فیلم و سریال و این‌ها بودین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 376.16,
   "end": 380.92,
   "text": "حقیقتا دارم به شما میگم نه که تقریبا اینا برید می‌بینید مثلا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 380.92,
   "end": 383.92,
   "text": "فیلم هشت قسمتی پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 383.92,
   "end": 386.78,
   "text": "که آمریکا ساخته در رابطه با جنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 386.78,
   "end": 389.68,
   "text": "یا دوباره فیلم یا سریال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 389.68,
   "end": 392.06,
   "text": "فکر می‌کنم هفت هشت قسمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.06,
   "end": 394.68,
   "text": "1899 حالا 1899.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 394.68,
   "end": 399.0,
   "text": "اینم باز آمریکا خب در خصوص جنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 399.0,
   "end": 403.6,
   "text": "یا مثلا فیلمی که ترکیه ای‌ها ساختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 403.6,
   "end": 409.22,
   "text": "به نام علیمت قیامت منظور قیامته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 409.22,
   "end": 413.18,
   "text": "اونجا پیرامون جن چقدر واضح و روشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 413.18,
   "end": 418.62,
   "text": "یا خود کره ای‌ها با اون فیلم وقتی آن روز فرا می‌رسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 418.62,
   "end": 426.2,
   "text": "تمام وقایعی که این سه چهار ماه اخیر تو ایران رخ داد و قبل از این وقایع تو این فیلم آوردن کره ای‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 426.2,
   "end": 428.8,
   "text": "و دخالت جن و اینا رو توش آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 428.8,
   "end": 432.6,
   "text": "یعنی دیگه صریح‌تر از این دشمنان ما خودشون دارن چیکار می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 432.6,
   "end": 434.82,
   "text": "اقرار می‌کنند. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 434.82,
   "end": 439.02,
   "text": "به صراحت قرآن، به صراحت روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 439.02,
   "end": 444.94,
   "text": "و به تصریح رهبر عزیزمون ما الان مواجه با دشمنان جن هم هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 444.94,
   "end": 446.68,
   "text": "حالا تو اون روایات گفتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 446.68,
   "end": 453.64,
   "text": "هاروت و ماروت ملائکه اللهی بودند که می‌آمدند دستور می‌دادند چگونه اهل ایمان از شر اینا در امان باشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 453.64,
   "end": 457.78,
   "text": "پس الان هم ما باید با هاروت‌ها و ماروت‌ها ارتباط بگیریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 457.78,
   "end": 460.96,
   "text": "اتصال بگیریم، ارتباط بگیریم چون اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 460.96,
   "end": 463.18,
   "text": "کانال مجری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 463.18,
   "end": 467.14,
   "text": "طرح براندازی نقشه‌های اجنه‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 467.14,
   "end": 469.0,
   "text": "و بطلان سحر و جادو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 469.0,
   "end": 472.38,
   "text": "حالا راه حاشیه امروز فرصت نمی‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 472.38,
   "end": 475.78,
   "text": "خدمت شما عرض کنیم ولی انشالله به مرور عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 475.78,
   "end": 478.22,
   "text": "البته خوبه اینو ما بدونیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 478.22,
   "end": 484.54,
   "text": "طبق روایتی که از مفضل دیدم از امام صادق صلوات الله علیه نقل می‌کرد خیلی جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 484.54,
   "end": 489.04,
   "text": "ایشون می‌فرمایند سؤال می‌کنه از امام صادق که آیا روزی می‌رسه که بشر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 489.04,
   "end": 490.96,
   "text": "ملائکه و جن رو ببینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 490.96,
   "end": 496.06,
   "text": "حضرت می‌فرمایند چگونه اینطور نیست که یک روزی خواهد رسید که همینطور که با قوم و خویش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 496.06,
   "end": 502.46,
   "text": "خانواده‌تون دارید زندگی می‌کنید و می‌بینیدشون با ملائکه و اجنه زندگی می‌کنید و می‌بینیدشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 502.46,
   "end": 505.96,
   "text": "همینطوری می‌بینیدشون. پس این روز خواهد رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 505.96,
   "end": 508.72,
   "text": "رفته رفته این پرده رقیق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 508.72,
   "end": 511.54,
   "text": "پرده‌ای که بین ما و اجنه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 511.54,
   "end": 514.22,
   "text": "یک طرفه‌ست. اونا ما رو می‌بینن، ما نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 514.22,
   "end": 516.74,
   "text": "دلایلی هم دارم بر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 516.74,
   "end": 520.56,
   "text": "مطلب که وقتش نیست حوصله شما هم نمی‌کشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 520.56,
   "end": 529.92,
   "text": "اون‌ها ببینید اصلا اجنه در روزگار قدیم پیش از این شهرنشینی و این‌ها بیشتر تو بیابان‌ها، کوه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 529.92,
   "end": 535.1,
   "text": "یا زیرزمین‌ها و در دل آب‌ها و اوج هوا و این‌ها زندگی می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 535.1,
   "end": 537.44,
   "text": "اصلا قاطی مردم نمی‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 537.44,
   "end": 540.66,
   "text": "نمی‌اومدن توی جاهایی که مردم انسان‌ها هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 540.66,
   "end": 548.38,
   "text": "فراری بودند. رفته رفته وقتی که انسان دخالت کرد در همه جا در بیابون، در کوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 548.38,
   "end": 554.98,
   "text": "در دریاها و همه این‌ها زندگی اون‌ها رو مختل کرد انسان و شهرنشینی اوج گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 554.98,
   "end": 561.3,
   "text": "و اینچنین مثلا تهران رو ببینید از یه ورش می‌خوای بری از شرقش به غرب می‌خوای بری آنزوی مسافرت طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 561.3,
   "end": 565.7,
   "text": "این‌ها باعث شد که رفته رفته محل اقلیم اونا دست بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 565.7,
   "end": 569.86,
   "text": "عصبانی شدند از انسان‌ها شاکی شدند به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 569.86,
   "end": 576.32,
   "text": "بعد مخصوصا با معماری غلطی که ما داریم آپارتمان نشینی اصلا می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 576.32,
   "end": 580.3,
   "text": "جن خلق جان من مار جن من نار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 580.3,
   "end": 583.3,
   "text": "قرآن می‌فرماید نطفه جن از چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 583.3,
   "end": 587.08,
   "text": "نار از آتش. لذا اونا آتش رو، گرما رو دوست دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 587.08,
   "end": 589.76,
   "text": "هر جا گرما زیاد باشه میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 589.76,
   "end": 593.88,
   "text": "اون‌ها خونه‌هایی که گرمن، داغن اینا میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 593.88,
   "end": 597.3,
   "text": "و آپارتمان نشینی چون هوا گرما میره به بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 597.3,
   "end": 601.2,
   "text": "هرچی که آپارتمان مثلا برج بشه اینا میره به بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 601.2,
   "end": 604.72,
   "text": "اینا بیشتر دوست دارن. اصلا خوششون میاد از آپارتمان نشینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 604.72,
   "end": 608.18,
   "text": "حتی جاهایی هم که هستن سعی می‌کنند دو سه متر از زمین فاصله بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 608.18,
   "end": 610.7,
   "text": "اینا رو من حقیقتا به شما میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 610.7,
   "end": 616.88,
   "text": "لذا اصلا آپارتمانی بلایی شده برای اینکه مردم دچار جن زدگی شده و می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 616.88,
   "end": 622.02,
   "text": "بسیاری از مشکلات که ما داریم از این حیثه حالا ما تا حالا بنا به دلایلی ورود نمی‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 622.02,
   "end": 623.94,
   "text": "انقدر دیگه به ما مراجعه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 623.94,
   "end": 627.34,
   "text": "می‌گن، می‌گن، می‌گن دیگه ما یه چیزکی داریم عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 627.34,
   "end": 634.3,
   "text": "البته حقیقتا. آ مخصوصا استفاده از بعضی چیزا در س-- معماری ما مثل آهن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 634.3,
   "end": 636.64,
   "text": "قدیم‌ها با چوب بود. چوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 636.64,
   "end": 641.26,
   "text": "الان آهنه. آهن رو خیلی دوست دارن اجنه خوبه بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 641.26,
   "end": 646.96,
   "text": "همونطور که از نقره خیلی خوششون نمیاد از آهن، آهن برای اونا مثل طلا برای ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 646.96,
   "end": 650.54,
   "text": "انقدر آهن رو دوست دارن. دلایلی هم باز براش داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 650.54,
   "end": 656.36,
   "text": "حدید آهن گرما رو در خودش نگه می‌داره و اون نقطه ذوبش خیلی بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 656.36,
   "end": 660.66,
   "text": "خیلی باید دما بگیره. در حالی که آتیشه اما هنوز ذوب نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 660.66,
   "end": 662.96,
   "text": "دلایلی داره. اونم چون جنسشون از آتیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 662.96,
   "end": 668.18,
   "text": "در هر حال آهن رو دوست دارن. حالا شما ببینید تو کل معماری ما آهن هست لذا جذب شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 668.18,
   "end": 672.78,
   "text": "بالاخره میان نزدیک می‌شن به ما خودشون رو نشون می‌دن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 672.78,
   "end": 675.98,
   "text": "و رفته رفته این پرده میفته تا روزی که ما بتونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 675.98,
   "end": 679.18,
   "text": "به هر حال باهاشون ارتباط بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 679.18,
   "end": 681.56,
   "text": "از چی؟ نقره نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 681.56,
   "end": 685.24,
   "text": "از-- برای چی میگن انگشتری که می‌ندازی حواست جمع باشه نقره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 685.24,
   "end": 687.0,
   "text": "اون رکابش نقره باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 687.0,
   "end": 691.12,
   "text": "یه دلیلش اینه. نقره اصل البته نه نقره الکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 691.12,
   "end": 695.88,
   "text": "حالا یه خیلی وقت پیش هم براتون روایتی رو گفته بودم در همین زمینه که کسی اومد پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 695.88,
   "end": 699.18,
   "text": "امام صادق صلوات الله علیه گفت آقا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 699.18,
   "end": 702.18,
   "text": "اِمم خیلی تو خونه‌م چیزای عجیب غریب اتفاق میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 702.18,
   "end": 704.72,
   "text": "چیزی گم می‌شه، سر و صدا میاد اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 704.72,
   "end": 709.06,
   "text": "حضرت فرمود که خونه‌ش پنج متر بود ارتفاع منزل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 709.06,
   "end": 711.32,
   "text": "پنج با اینکه ویلایی بود اما ار--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 711.32,
   "end": 713.54,
   "text": "سقف و بالا بلند گرفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 713.54,
   "end": 719.3,
   "text": "حضرت فرمود اون یه متر انتهای دیوار رو دور سقفتو پنجره بزن باز بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 719.3,
   "end": 722.6,
   "text": "این کارو کرد. مشکل حل شد. اومد گفت آقا سرش در چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 722.6,
   "end": 724.86,
   "text": "فرمود که این هوای گرم داغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 724.86,
   "end": 730.12,
   "text": "می‌رفت زیر سقف خونه‌ت جمع می‌شد محل تجمع اجنه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 730.12,
   "end": 735.89,
   "text": "این پنجره‌ها رو که زدی باد گرم که میره دیگه اینا خوششون نمیاد جای خنک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 735.89,
   "end": 740.21,
   "text": "این یک سری رو تو اون روایت حضرت بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 740.21,
   "end": 743.39,
   "text": "دیگه از نقاط ضعفی که در ما هست مثلاً تنها نشینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 743.39,
   "end": 748.45,
   "text": "الان چقدر متاسفانه مجردی زیاد شده لذا جن زدگی هم زیاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 748.45,
   "end": 755.37,
   "text": "عزب بودن این‌ها. حتی توی خانواده که طرف زن و بچه هم داره اما میره توی اتاق تنها ساعت‌ها شب تا صبح تنها میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 755.37,
   "end": 760.13,
   "text": "مخصوصاً مردها. این‌ها در دسترس اجنه خودشونو قرار میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 760.13,
   "end": 764.45,
   "text": "کارهایی هستش که این‌ها رو ماها رو در معرض اجنه قرار می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 764.45,
   "end": 767.01,
   "text": "من یه چند تاشو سریع براتون میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 767.01,
   "end": 769.0,
   "text": "که اینا هر کدومش توضیح می‌خوادها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 769.0,
   "end": 771.75,
   "text": "من فقط می‌خوام ذهنتون باز باشه و ازش رد می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 771.75,
   "end": 775.59,
   "text": "بعد انشاالله جلسه بعد راه برون رفتن از این‌ها رو به صورت کلی بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 775.59,
   "end": 778.87,
   "text": "ایستاده نوشیدن آب در شب، مایعات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 778.87,
   "end": 781.01,
   "text": "عجب. بر پس بر-- چی میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 781.01,
   "end": 783.55,
   "text": "مکروهه. یه وجهش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 783.55,
   "end": 785.23,
   "text": "حالا دلایلشو حالا بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 785.23,
   "end": 789.13,
   "text": "همبستر شدن در شب اول، وسط و آخر ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 789.13,
   "end": 793.07,
   "text": "کامل لخت شدن. دستشویی در قبرستون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 793.07,
   "end": 796.35,
   "text": "الان تو همه قبرستون‌ها سرویس بهداشتی زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 796.35,
   "end": 799.13,
   "text": "از آنجا که به شدت منع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 799.13,
   "end": 801.35,
   "text": "با سر باز دستشویی رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 801.35,
   "end": 803.19,
   "text": "ایستاده ادرار کردن. تو بعضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 803.19,
   "end": 805.33,
   "text": "سرویس‌های عمومی متاسفانه من دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 805.33,
   "end": 811.25,
   "text": "جاهایی رو تعبیه کردن آدما که معذرت می‌خوام جسارتاً می‌خوان ایستاده ادرار کنن و برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 811.25,
   "end": 813.89,
   "text": "تو همین شهر خودمون. عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 813.89,
   "end": 818.13,
   "text": "اینا باعث می‌شه جن بیاد دیگه و جن متمایل بشه و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 818.13,
   "end": 820.13,
   "text": "خوابیدن با دهن و دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 820.13,
   "end": 823.53,
   "text": "نشسته و این‌ها مخصوصاً بعد غذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 823.53,
   "end": 826.61,
   "text": "خوردن غذای داغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 826.61,
   "end": 830.17,
   "text": "و لیسیدن و خوردن استخوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 830.17,
   "end": 832.75,
   "text": "تا جایی که هیچ گوشتی درش نمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 832.75,
   "end": 836.21,
   "text": "حالا اینا زیادن. بخوایم بگیم وقتمون می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 836.21,
   "end": 838.13,
   "text": "چه ربطی اینا داره به جن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 838.13,
   "end": 840.11,
   "text": "طلبتون. دوست داشتید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 840.11,
   "end": 844.59,
   "text": "می‌شینیم شخصاً اینا رو از جهت براهین عقلی با هم بحث می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 844.59,
   "end": 847.35,
   "text": "حداقل اون داغیشو که بهتون گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 847.35,
   "end": 851.27,
   "text": "این‌ها همه مجموعاً باعث می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 851.27,
   "end": 854.37,
   "text": "جن به ما حمله کنه و بیاد و ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 854.37,
   "end": 860.41,
   "text": "اذیت کنه. البته در کلمه خوبه بدونید در کلمه سیصد و سی و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 860.41,
   "end": 864.61,
   "text": "هزار و یک کلمه حضرت علامه حسن زاده علیه الرحمه اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 864.61,
   "end": 872.49,
   "text": "ایشون اشاره می‌کنند بعضی از آیات و روایت و به نقل از استادشون حضرت علامه طباطبایی صاحب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 872.49,
   "end": 881.65,
   "text": "تفسیر گران سنگ المیزان نقل می‌کنند که استاد ما از حضرت آقای قاضی نقل کردن که آقای قاضی فرمودن کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 881.65,
   "end": 884.55,
   "text": "جن را دید و از او سؤال کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 884.55,
   "end": 886.75,
   "text": "ایشون می‌فرمودن که خودش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 886.75,
   "end": 894.89,
   "text": "خود آقای قاضی بوده و از او سؤال کرد که آیا شما مثل ما انسان‌ها ادیان متعدد دارید اینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 894.89,
   "end": 897.11,
   "text": "گفتن بله بجز سنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 897.11,
   "end": 901.03,
   "text": "ما سنی نداریم. یعنی اونا مجوسی دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 901.03,
   "end": 906.95,
   "text": "کافر دارن، مشرک عرض شود، یهودی، مسیحی اینا همه رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 906.95,
   "end": 910.13,
   "text": "مسلمان اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 910.13,
   "end": 912.73,
   "text": "سنی اهل تسنن نه همشون شیعه‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 912.73,
   "end": 917.91,
   "text": "اگه هستن شیعه‌ان. بعد دلیلشو اون جن به ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 917.91,
   "end": 924.05,
   "text": "به آقای قاضی می‌فرماید اینه که هنوز بزرگانی که در عید غدیر بودن هنوز زنده‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 924.05,
   "end": 930.57,
   "text": "این شاید برای بعضیا که علمشو ندارن تعجب‌آور باشه چون اجنه یه وجه تمایزی که با انسان‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 930.57,
   "end": 933.47,
   "text": "دارن البته بعد از پیغمبر ما این اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 933.47,
   "end": 935.27,
   "text": "قبلش ما هم هزار ساله بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 935.27,
   "end": 942.37,
   "text": "هزار سال عمر می‌کرد انسان. دلیلش هم اینه که امت مرحومه‌ای ما خدا رحم کرد به امت پیغمبر آخرالزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 942.37,
   "end": 946.17,
   "text": "پیغمبر سؤال کرد خدا چرا به من که رسید عمرها زیر صد شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 946.17,
   "end": 948.19,
   "text": "فرمود من اینا امت مرحومه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 948.19,
   "end": 949.85,
   "text": "می‌خوام به اینا به خاطر تو رحم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 949.85,
   "end": 954.97,
   "text": "چرا تو این دنیا انقدر اذیت شن؟ بذار راحت شن سریع برن پیغمبرم رضایت داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 954.97,
   "end": 958.13,
   "text": "علت‌هایی داره مثل این. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 958.13,
   "end": 961.41,
   "text": "اجنه هزار سال بیش از هزار سال عمر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 961.41,
   "end": 964.55,
   "text": "یعنی اون‌هایی که غدیر رو درک کردن هنوز هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 964.55,
   "end": 967.53,
   "text": "احسن ظفر جنی. ایشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 967.53,
   "end": 970.61,
   "text": "حضرت آقای بروجردی براش مجلس ختم گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 970.61,
   "end": 973.43,
   "text": "یعنی تازه اون موقع از دنیا رفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 973.43,
   "end": 975.97,
   "text": "هزار و چند صد سال گذشته بود از عاشورا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 975.97,
   "end": 979.7,
   "text": "ظفر جنی تو عاشورا حضور داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 979.7,
   "end": 982.35,
   "text": "به اتفاق به یک مع-- به یک روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 982.35,
   "end": 984.59,
   "text": "سه هزار، یکی میگه چهار هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 984.59,
   "end": 988.35,
   "text": "اجنه اومدن کمک امام حسین بکنن حضرت اجازه نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 988.35,
   "end": 989.99,
   "text": "بعضی روایت میگن دیر رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 989.99,
   "end": 994.33,
   "text": "حالا برا موندن اونجا مویه کنان، گریه کنان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 994.33,
   "end": 997.51,
   "text": "چون رفته بود کمک حضرت نشون دهنده از شیعیان بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 997.51,
   "end": 1003.37,
   "text": "مرحوم آقای بروجردی برای ایشون مجلس ختم گرفت و اونایی که اشکال می‌کنند که آقای قا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1003.37,
   "end": 1007.03,
   "text": "حضرت علامه به چه استنادی میگه جن رو اصلاً جن رو کی دیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1007.03,
   "end": 1009.83,
   "text": "یا بچه‌هاش می‌بینن چه برسه به بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1009.83,
   "end": 1011.49,
   "text": "دیگه کاری نداره ارتباط با جن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1011.49,
   "end": 1015.31,
   "text": "الان این چهار-- چند تا موضوعی که ما گفتیم شما انجام بده ببین چه راحت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1015.31,
   "end": 1019.67,
   "text": "راحت نزدیکت می‌شن و یه راه‌های دیگه‌ای داره راحت بتونی ببینی اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1019.67,
   "end": 1023.95,
   "text": "کاری نداره ارتباط با جن. اینا که چون علمشون نمی‌رسه، زبان نفهمند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1023.95,
   "end": 1026.49,
   "text": "زبان قوم نمی‌دونن سریع انکار می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1026.49,
   "end": 1029.93,
   "text": "که مثلاً به چه استنادی علامه این حرفو زده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1029.93,
   "end": 1038.27,
   "text": "کجای مثلاً آیه قرآن میارن بر رد علامه که مثلاً چه حرفی ایشون در این کلمه زده و از این قبیل موارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1038.27,
   "end": 1040.7,
   "text": "بله چون بودند و غدیر رو دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1040.7,
   "end": 1043.25,
   "text": "الان کسی بین ما نیست که دیده باشه غدیر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1043.25,
   "end": 1046.63,
   "text": "همه نقله. نقل. ولی اون‌ها هستن کسایی که بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1046.63,
   "end": 1055.31,
   "text": "پس ختم کلام خلاصه اینکه اجنه هستند و سوره ای به نام جن داریم می‌دانید و ما دائماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1055.31,
   "end": 1057.75,
   "text": "گوش بدید چی عرض می‌کنم این ختم کلام رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1057.75,
   "end": 1061.17,
   "text": "دائماً در معرض اون‌ها هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1061.17,
   "end": 1062.93,
   "text": "خوباشون کمکمون می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1062.93,
   "end": 1065.13,
   "text": "بدیا، بداشون اذیتمون می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1065.13,
   "end": 1067.33,
   "text": "باید گاردمون رو ببندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1067.33,
   "end": 1076.34,
   "text": "و بریم در حصر و پناه احراز، احراز و هرزها و این‌ها تعویذهایی که اهل بیت دادن خصوصاً در آخرالزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1076.34,
   "end": 1079.07,
   "text": "اصلاً مال ماست اینا. اون موقع خیلی نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1079.07,
   "end": 1082.65,
   "text": "اصلاً مال ماست. چند تاشو انشاالله جلسه بعد ذکر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1082.65,
   "end": 1086.69,
   "text": "اونایی که بزرگان مثل سید ابن طاووس تاکید داشتند روش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1086.69,
   "end": 1088.43,
   "text": "انشاالله هممون پناه ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1088.43,
   "end": 1090.85,
   "text": "انشاالله عاقبتمون ختم به خیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1090.85,
   "end": 1093.61,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1093.61,
   "end": 1096.91,
   "text": "اللهم صلي على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1096.91,
   "end": 1099.73,
   "text": "محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}