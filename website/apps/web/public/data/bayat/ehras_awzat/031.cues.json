   "start": 1.62,
   "end": 72.98
  },
  {
   "index": 1,
   "title": "## واسأله من فضله",
   "start": 72.98,
   "end": 92.98
  },
  {
   "index": 2,
   "title": "بر اساس قرآن:",
   "start": 92.98,
   "end": 113.12
  },
  {
   "index": 3,
   "title": "آیهٔ بیست‌ویک سورهٔ نور را دقت کنید؛ رمزگشایی کرده است، بسیار شیرین:",
   "start": 113.12,
   "end": 145.52
  },
  {
   "index": 4,
   "title": "## فضل کنار رحمت؛ الواحد کنار القهار",
   "start": 145.52,
   "end": 198.06
  },
  {
   "index": 5,
   "title": "کجا در قرآن آمده‌اند؟ اخیراً گفته‌ایم. فرموده‌اند:",
   "start": 198.06,
   "end": 241.1
  },
  {
   "index": 6,
   "title": "## پیوند با علم و دانش",
   "start": 241.1,
   "end": 261.28
  },
  {
   "index": 7,
   "title": "## اسم الفاضل و چشیدن حکمت",
   "start": 261.28,
   "end": 310.6
  },
  {
   "index": 8,
   "title": "## رموز و کنوز",
   "start": 310.6,
   "end": 362.37
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.62,
   "end": 7.64,
   "text": "در کتاب شریف مصباح المتجد و سلاح المتعبد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.64,
   "end": 10.62,
   "text": "جلد یک صفحه صد و نود و نه دعایی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.62,
   "end": 13.1,
   "text": "ذکر فرموده از امام معصوم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.1,
   "end": 19.68,
   "text": "توصیه کردن در سجده نماز واجب این دعا رو مخصوصا، حالا هر وقتی میشه خوند اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.68,
   "end": 21.82,
   "text": "توصیه شده در سجده نماز واجب این دعا رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.82,
   "end": 27.8,
   "text": "حالا علت اینکه ما امروز ابتدای کلاس این رو هدیه کردیم بهتون عرض می‌کنم سری درش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.8,
   "end": 30.84,
   "text": "که خیلی دعای شریفی‌ست خیلی پربرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.84,
   "end": 35.86,
   "text": "عزیزانی که پی حکمت و عرفان و دانش و معرفت هستن حتما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.86,
   "end": 39.48,
   "text": "این دعا رو قدر بدونن و ازش بهره ببرن در سجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.48,
   "end": 42.04,
   "text": "دعا این هست که \"یا خیر المسؤولین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.04,
   "end": 44.46,
   "text": "و یا خیر المعطین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.46,
   "end": 49.2,
   "text": "از عطا میاد. \"یا خیر المسؤولین و یا خیر المعطین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.2,
   "end": 54.04,
   "text": "ارزقنی وارزق عیالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.04,
   "end": 59.36,
   "text": "من فضلك\". صبر کن \"من فضلك فضله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.36,
   "end": 63.18,
   "text": "فإنك ذو الفضل العظیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.18,
   "end": 71.62,
   "text": "پس شد \"یا خیر المسؤولین و یا خیر المعطین ارزقنی وارزق عیالی من فضلك فإنك ذو الفضل العظیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.62,
   "end": 75.58,
   "text": "خیلی دعای شریفی‌ست. اگر دقت کردید ما ابتدای جلسه همیشه میگیم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.58,
   "end": 77.64,
   "text": "واسأله من فضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.64,
   "end": 79.98,
   "text": "از فضل حضرت حق درخواست می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.98,
   "end": 83.3,
   "text": "آیاتی که پیرامون فضل الهی‌ست رو برید دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.3,
   "end": 89.78,
   "text": "من یه بررسی کردم خیلی برام شیرین اومد و خیلی نکات جالب و عالی رو به فضل الهی متوجه شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.78,
   "end": 92.98,
   "text": "حالا ربطش با دانش و فضل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.98,
   "end": 98.8,
   "text": "یه ربطش اینه که از خود آیه استفاده کنیم و یک ربطش رو از روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.8,
   "end": 101.3,
   "text": "خب بر اساس قرآن \"لا یمسه إلا المتحرّمون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.3,
   "end": 106.94,
   "text": "نمیشه مس کرد ملکوت عالم رو و ملکوت خودت رو حتی و ملکوت علم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.94,
   "end": 109.46,
   "text": "ملکوت علم چی بود؟ حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.46,
   "end": 115.64,
   "text": "نمیشه ملکوت علم رو که حکمت رو درک کرد یعنی باطن علم رو نمیشه درک کرد مگر با طهارت، با پاکیزگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.64,
   "end": 120.37,
   "text": "حالا آیه بیست و یک نور رو دقت کنید رمزگشایی کرده خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.37,
   "end": 124.26,
   "text": "\"ولولا فضل الله عليكم ورحمته\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.26,
   "end": 127.98,
   "text": "اگه فضل الهی و رحمتش بر شما نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.98,
   "end": 132.72,
   "text": "چه اتفاقی می‌افتاد به نظر شما؟ اگه فضل و رحمت خدا شامل حال ما نمیشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.72,
   "end": 134.4,
   "text": "خیلی عجیبه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.4,
   "end": 138.18,
   "text": "می‌فرماید \"ما زکی منکم من أحدا أبدا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.18,
   "end": 140.24,
   "text": "یه دونه از شما ابدا پاک نمی‌شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.24,
   "end": 145.52,
   "text": "عجب! پس چه جایگاهی داره فضل الهی و ما ازش بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.52,
   "end": 148.98,
   "text": "فضل و رحمت که حالا خدا لطف کنه تو بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.98,
   "end": 155.14,
   "text": "اسماء الهی با هم بر اساس کتاب شریف شرح اسماء حاج آقا صدر‌الدین علیه الرحمه که به قول علامه کتاب ناقولایبه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.14,
   "end": 157.56,
   "text": "کوچیکه اما خیلی قوت‌ها درش هست ورود کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.56,
   "end": 160.34,
   "text": "اون وقت متوجه می‌شیم که وقتی فضل کنار رحمت میاد چی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.34,
   "end": 166.14,
   "text": "مثل اسم الواحد که کنار القهار بیاد الواحد مرتبه واحدیت، کثرات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.14,
   "end": 169.86,
   "text": "ذیل مرتبه روحه. از قلب به پایین میشه کثرات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.86,
   "end": 171.98,
   "text": "کثرت از وحدت تک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.98,
   "end": 176.38,
   "text": "اون تأکدی که بر توحد داره خارج میشه میاد به کثرت و ضعف می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.38,
   "end": 181.64,
   "text": "الواحد، واحدیت، مرتبه واحدیت، کثر-- مرتبه موافقش می‌شد احدیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.64,
   "end": 186.02,
   "text": "حضرت استاد فرمودن وقتی این دو اسم کنار هم قرار می‌گیرن بوی احدیت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.02,
   "end": 188.18,
   "text": "کدوم دو اسم؟ الواحد و القهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.18,
   "end": 191.62,
   "text": "کجا اومده؟ کجا اومده این دو اسم تو قرآن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.62,
   "end": 195.72,
   "text": "فرمودن که اخیرا گفتیم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.72,
   "end": 198.96,
   "text": "فرمودن \"لمن الملك\". ملک امروز مال کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.96,
   "end": 201.12,
   "text": "پادشاهی، فرمانروایی، مالکیت مال کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.12,
   "end": 203.16,
   "text": "اليوم، يوم هم که ظرف ظهوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.16,
   "end": 210.06,
   "text": "حالا که الله ظهور کرد روز قیامت ظهور الله دیگه و بُعد و قرب ما نسبت به حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.06,
   "end": 215.84,
   "text": "جل اسمه. بُعد و قرب ما نسبت به او بر اساس بُعد و قرب‌مون به الله تعریف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.84,
   "end": 220.28,
   "text": "لذا خود خدا جواب میده \"لله الواحد القهار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.28,
   "end": 223.3,
   "text": "اینجاییه که این دو تا با هم اومدن. برده سطح رو به اون بالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.3,
   "end": 226.34,
   "text": "مرتبه-- بالاترین مراتب و عالی‌ترین مراتب که مرتبه احدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.34,
   "end": 229.62,
   "text": "عرض کردیم در ما کدوم جزء، کدوم رتبه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.62,
   "end": 232.98,
   "text": "اون رتبه‌ها، حالا بیرون از ما میگیم عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.98,
   "end": 236.08,
   "text": "درون خودمون میگیم رتبه. کدوم رتبه در وجود ما بوی احدیت میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 236.08,
   "end": 239.42,
   "text": "جنسش از احدیته؟ جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.42,
   "end": 241.94,
   "text": "نه روح. پس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.94,
   "end": 243.8,
   "text": "چه ربطی داشت حالا به بحث علم و دانش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.8,
   "end": 248.62,
   "text": "کاملا مشخص شد دیگه. تا انسان پاک نشه \"لا یمسه إلا المتحرّمون\" به ملکوت پی نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.62,
   "end": 250.92,
   "text": "ملکوت علم هم که حکمت شما هم که انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.92,
   "end": 255.1,
   "text": "پی حکمت و عرفان می‌گردید، طلب وجودیتون انشاالله اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 255.1,
   "end": 258.24,
   "text": "و در ماه مبارک رمضان قرآن می‌خوانید که \"یا سین والقرآن الحکیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.24,
   "end": 261.28,
   "text": "قرآن هم حکیمه، یک پارچه حکمت محض است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.28,
   "end": 263.88,
   "text": "یعنی باطن علم در قرآنه. خب راهش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.88,
   "end": 266.32,
   "text": "پاکیه. \"لا یمسه إلا المتحرّمون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.32,
   "end": 271.26,
   "text": "خب اون رو از کجا اخذ کنم؟ به واسطه چه اسمی از حضرت حق این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 271.26,
   "end": 275.4,
   "text": "پاکی رو اخذ کنم و از خدا بگیرم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 275.4,
   "end": 277.48,
   "text": "به اسم الفاضل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.48,
   "end": 282.16,
   "text": "تو همین دعایی که دیدم خیلی از مراجع هم توصیه کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 282.16,
   "end": 284.44,
   "text": "دیگه مشخصه دیگه. وارزق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.44,
   "end": 288.04,
   "text": "ارزقنی وارزق عیالی من فضلك،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 288.04,
   "end": 292.06,
   "text": "من فضلك. حالا خدا بخواد به ما فضنش رو بده اول باید چیکار کنه ما رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 292.06,
   "end": 298.72,
   "text": "باید پاک کنه. چون آیه بیست و یک نور می‌فرمود اگه فضل و رحمت نبود شما ابدا هیچ‌کدومتون پاک نمی‌شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 298.72,
   "end": 304.42,
   "text": "پس فضله که فضل و رحمت انسان رو پاک می‌کنه و این پاکی موجب میشه که ما باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 304.42,
   "end": 308.12,
   "text": "علم رو که حکمته انشاالله بچشیم صرفا علم فکری نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.12,
   "end": 310.4,
   "text": "توجه کردید؟ اینا رموزه دارم از خدمتتون عرض می‌کنما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.4,
   "end": 313.6,
   "text": "یعنی این‌ها رو من خدایی نکرده العیاذ بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.6,
   "end": 315.4,
   "text": "خدا ببخشه، رحم کنه به بنده اگه سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.4,
   "end": 319.82,
   "text": "سوزنی یه وقت اظهار فضلی بخوام بکنم چون اینا از ما نیست که از بنده بیچاره نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 319.82,
   "end": 323.12,
   "text": "ارزش و اهمیت حرف رو بخوام به شما بفهمونم اینجوری میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 323.12,
   "end": 326.54,
   "text": "اینا رموزن. اینا کنوزن به قول حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 326.54,
   "end": 329.58,
   "text": "گنجن. این حرف‌ها رو هر جایی شما نمی‌تونید پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 329.58,
   "end": 332.88,
   "text": "قدر بدونید و به همین راحتی از این گوش بگیری و از اون گوش در کنی چوب می‌خوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 332.88,
   "end": 337.68,
   "text": "یا نیا یا اگر اومدی انشاالله نیت کن این‌ها رو ارزش بدی بهش و بهش عمل کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.68,
   "end": 343.92,
   "text": "اینم پس قصه اینکه چرا ما امروز توصیه کردیم خودم و شما رو به این دعا در سجده البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 343.92,
   "end": 346.77,
   "text": "و شیرینیش هم اینه که برای همسرت هم می‌خوای تک خور نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 346.77,
   "end": 352.22,
   "text": "\"وارزق عیالی\". حالا عیالی اینجا صرفا نمیشه گفت عیالی یعنی زن منه و اون زن متعارف که میگیم، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 352.22,
   "end": 356.3,
   "text": "عیالی یعنی کسی که تحت سرپرستی منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 356.3,
   "end": 361.22,
   "text": "مثلا یه مدیر یه اداره، پدر یه خانواده همه بچه‌هاش، معلم همه بچه‌های کلاسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 361.22,
   "end": 362.37,
   "text": "اینا همه اینا رو شامل میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}