   "start": 602.3,
   "end": 610.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 2.96,
   "text": "بانچه و چه و این‌ها باشه همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.96,
   "end": 7.64,
   "text": "وحشی‌ده می‌شه. بسیار این سه شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.64,
   "end": 9.72,
   "text": "پرنوره. اسمش هم رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.72,
   "end": 13.98,
   "text": "سفیده، نور داره این سه شب رو قدر بدونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.98,
   "end": 18.24,
   "text": "که ان‌ ね آمادگی برای درک لیلة القدره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.24,
   "end": 21.16,
   "text": "و این نور می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.16,
   "end": 26.9,
   "text": "در چهره‌ی اهل ایمان تاثیر خودش رو داره در این سه شب ایام البیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.9,
   "end": 29.64,
   "text": "عرض کردم بعد از ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.64,
   "end": 35.12,
   "text": "هم این سه شب رو ما باید قدر بدونیم طبق این روایت که امام صادق صلوات الله علیه فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.12,
   "end": 43.46,
   "text": "یعنی یه خصوصیتی درش هست که فرمود به احدی این سه شب داده نشده جز به این امت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.46,
   "end": 45.34,
   "text": "این خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.34,
   "end": 47.78,
   "text": "حالا چه خبره در این سه شب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.78,
   "end": 52.86,
   "text": "باید درکش کرد. باید مثل عسل چشیدش، خوردش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.86,
   "end": 56.92,
   "text": "این نورانیت رو باید قدر دونست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.92,
   "end": 60.58,
   "text": "در ادامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.58,
   "end": 65.9,
   "text": "معرفی عوضات و احراز و ادعیه و اذكار و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.9,
   "end": 68.18,
   "text": "امروز نکته‌ای که می‌خوام بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.18,
   "end": 72.86,
   "text": "یه مقدار بیشتر با درون‌مایه‌ی اون اذكار و این‌ها مربوطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.86,
   "end": 81.3,
   "text": "ببینید ما این همه دستورالعمل از اهل بیت علیهم الصلاة والسلام به سفارش بزرگانمون گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.3,
   "end": 90.48,
   "text": "یه بار بشینیم با تأمل این‌ها رو نگاه کنیم چرا این خصوصیت‌ها در این اذكار و این اوراد هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.48,
   "end": 96.84,
   "text": "چرا مثلاً کسی سوره‌ی الرحمن رو بخونه چهره‌ش، وجهش نیکو می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.84,
   "end": 105.72,
   "text": "و چرا سوره‌ی واقعه رو بخونه جزو محبین مولا محسوب می‌شه و از فقر نجات پیدا می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.72,
   "end": 107.9,
   "text": "چرا؟ این‌ها علتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.9,
   "end": 110.32,
   "text": "مثلاً چرا سوره‌ی قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.32,
   "end": 113.1,
   "text": "ریزش رحمت الهی میاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.1,
   "end": 121.42,
   "text": "باید دید درون اون سوره چه خبره، درون اون آیه، درون اون ذکر، اون ورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.42,
   "end": 127.12,
   "text": "من توصیه می‌کنم چون خودم به فضل الهی یه م-- اختصارا حالا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.12,
   "end": 130.72,
   "text": "توصیه بزرگانمون رفتیم و یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.72,
   "end": 134.3,
   "text": "دیدیم خیلی شیرین بود به شما هم توصیه می‌کنم این کارو بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.3,
   "end": 143.3,
   "text": "همونطور که حضرت آقا فرمودن یه ذکر رو سلطان وجودتون قرار بدید اینقدر باهاش خوب بگیرید تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 143.3,
   "end": 150.8,
   "text": "دولت وجودتون رو دست بگیره و رفته رفته حقیقت اون اسم و اون ذکر بشه رب وجودیتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 150.8,
   "end": 153.48,
   "text": "از سور آیات اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 153.48,
   "end": 155.6,
   "text": "قرآن هم یه سوره رو انتخاب کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 155.6,
   "end": 159.56,
   "text": "ببینید بیشتر با چه سوره خو گرفتید و اون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 159.56,
   "end": 166.8,
   "text": "تکرار کنید. مثلاً امیرالمؤمنین علیه الصلاة والسلام در میان صد و چهارده سوره‌ی قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 166.8,
   "end": 169.32,
   "text": "سوره‌ی قل هوالله رو اختیار کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 169.32,
   "end": 171.16,
   "text": "دائماً لبش تر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.16,
   "end": 178.28,
   "text": "حدیث داریم امیرالمؤمنین به این ذکر مخصوصاً وقتی می‌جنگید دائماً قل هوالله می‌خوند، راه می‌رفت، می‌شست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 178.28,
   "end": 181.9,
   "text": "می‌گن امیرالمؤمنین اصلاً انتخابش از سوره‌های قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 181.9,
   "end": 184.46,
   "text": "حالا شما می‌بینید که اتفاقاً یه روایت خیلی...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.46,
   "end": 187.04,
   "text": "این خودش یه دستورالعمله الان دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 187.04,
   "end": 191.94,
   "text": "منتها با توجه به چی؟ با این نگاه، با نگاه به اون درون‌مایه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 191.94,
   "end": 198.64,
   "text": "چه خبره درون او که امیرالمؤمنین این سوره رو انتخاب کرده یا این تاثیرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 198.64,
   "end": 206.38,
   "text": "مولامون علی علیه الصلاة والسلام این روایت که می‌خونم در ثواب الأعمال و عقاب الأعمال صفحه دویست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 206.38,
   "end": 208.52,
   "text": "و هفتاد و هفت می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 208.52,
   "end": 217.2,
   "text": "فرمودن هر کس بعد از نماز صبح یازده مرتبه سوره‌ی توحید را قبل از طلوع آفتاب بخواند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 217.2,
   "end": 225.62,
   "text": "مولا فرمود آن روز مرتکب گناه نمی‌شود حتی اگر شیطان به سوی او طمع کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 225.62,
   "end": 229.4,
   "text": "عجب! چه خبره در درون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 229.4,
   "end": 231.64,
   "text": "سوره؟ اسمش رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 231.64,
   "end": 234.12,
   "text": "بهش می‌گن شناسنامه‌ی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 234.12,
   "end": 239.24,
   "text": "تنها surه ای است که از احدی جز خدا درش سخن گفته نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 239.24,
   "end": 244.94,
   "text": "و سر این سوره بیشتر در همون هواللهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 244.94,
   "end": 247.12,
   "text": "قل هوالله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 247.12,
   "end": 253.36,
   "text": "هوالله احد. شما ببینید یه بررسی بکنید مع-- خود معنای توحید داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 253.36,
   "end": 257.32,
   "text": "توش شیرینی و یه توحید وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 257.32,
   "end": 265.74,
   "text": "دقت کنید اون سوره و آیات و ادعیه‌ای که خیلی بهش تذکر دادن و خیلی عظمت پیدا کرده معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 265.74,
   "end": 268.78,
   "text": "درش هوالله هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 268.78,
   "end": 273.58,
   "text": "یا لا اله الا هو هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 273.58,
   "end": 278.86,
   "text": "شما ببینید امیرالمؤمنین علیه الصلاة والسلام به فرمایش پیغمبر توک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 278.86,
   "end": 285.92,
   "text": "خیلی تأکید داشتن رو شش آیه اول سوره‌ی حدید و چهار آیه آخر سوره هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 285.92,
   "end": 291.3,
   "text": "برید ببینید تو اون آیه سوم سوره‌ی حدید می‌گه هو الله الذي لا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 291.3,
   "end": 293.78,
   "text": "هو الأول، هو الأول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 293.78,
   "end": 296.26,
   "text": "والآخر والظاهر. هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 296.26,
   "end": 300.38,
   "text": "دوباره سوره‌ی اون چهار آیه آخر سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 300.38,
   "end": 304.22,
   "text": "هشت که از لو انزلنا شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 304.22,
   "end": 308.08,
   "text": "اون سه تا آیه‌ی آخر باز با هوالله شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 308.08,
   "end": 312.34,
   "text": "عجب! هو الله الذي لا اله الا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 312.34,
   "end": 316.42,
   "text": "دو تاش اینطوریه. آیه آخر که هوالله هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 316.42,
   "end": 319.04,
   "text": "هو الله الذي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 319.04,
   "end": 322.52,
   "text": "این هرچی هست سرش در اون هو است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 322.52,
   "end": 327.9,
   "text": "هو. که آیا یه بار عرض کردم آیاتی که درش هو است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 327.9,
   "end": 334.56,
   "text": "دیگه مستقیم زده به ذات خود حضرت حق که انسان رو به فنای ذاتی می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 334.56,
   "end": 337.52,
   "text": "که وحده، وحده، وحده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 337.52,
   "end": 341.5,
   "text": "اون سه مرحله فنا که قبلاً توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 341.5,
   "end": 345.06,
   "text": "فنای یا توحید افعالی، توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 345.06,
   "end": 349.54,
   "text": "صفاتی و توحید ذاتی که البته اینجا وحده، وحده، وحده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 349.54,
   "end": 351.92,
   "text": "بالعکسه. یعنی اولیش توحیده--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 351.92,
   "end": 353.64,
   "text": "اشاره به توحید ذاتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 353.64,
   "end": 356.1,
   "text": "وسطیش صفاتی و آخریش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 356.1,
   "end": 361.24,
   "text": "توحید افعالیه. که اینا رو چون سخن گفتیم صرف‌نظر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 361.24,
   "end": 363.24,
   "text": "سوره، خود سوره‌ی قل هوالله رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 363.24,
   "end": 366.06,
   "text": "قل هوالله احد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 366.06,
   "end": 372.96,
   "text": "هو. خیلی توجه داشته باشیم به این وقتی داریم این سوره رو می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 372.96,
   "end": 378.72,
   "text": "یعنی می‌خوام بگم وقتی میگه آقا یازده تا سوره قل هوالله بخون بعد از نماز صبح قبل از طلوع آفتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 378.72,
   "end": 381.94,
   "text": "خدا از شر شیطان و هر گناهی حفظت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 381.94,
   "end": 385.96,
   "text": "همراه با توجهه. باید توجه داشته همینطوری نه دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 385.96,
   "end": 390.04,
   "text": "تسبیح دستت داری تلویزیون می‌بینی یا توتی‌وار همینطوری می‌گیره از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 390.04,
   "end": 398.26,
   "text": "لغلغه زبان. البته اونم به قول حضرت علامه بالاخره یه اثری داره بی‌اثر نیست اما اصلش در اینه، به این توجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 398.26,
   "end": 401.98,
   "text": "شما دقت کنید حتی در امروز هم توی خودم داشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 401.98,
   "end": 409.28,
   "text": "نگاه می‌کردم خیلی جالب بود برام که خب یه عمره ما داریم اینا رو می‌خونیم اما توجهی اینی نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 409.28,
   "end": 411.46,
   "text": "تو دعای سریع الاجابه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 411.46,
   "end": 417.8,
   "text": "دعای سریع الاجابه که توی مفاتیح الان این کتاب جلوی من مفاتیح شیخ عباس آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 417.8,
   "end": 424.2,
   "text": "یه دعایی هست خیلی شیرین از امام کاظم به نام دعای سریع الاجابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 424.2,
   "end": 428.78,
   "text": "یعنی کسی به سرعت یه حاجتی داره که می‌خواد خدا سریع حاجتشو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 428.78,
   "end": 433.2,
   "text": "اینه. حضرت امام صادق علیه السلام، جعفر هم فرمودن این روایت رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 433.2,
   "end": 436.3,
   "text": "در بلد الامین مرحوم کفامی آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 436.3,
   "end": 438.36,
   "text": "اولین عبارت این دعا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 438.36,
   "end": 442.88,
   "text": "اللهم انی اطعتک فی احب الاشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 442.88,
   "end": 447.78,
   "text": "خدایا من تو رو اطاعت کردم در محبوب‌ترین چیزها که اون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 447.78,
   "end": 453.04,
   "text": "می‌فرماید احب الاشیا الیک وهو التوحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 453.04,
   "end": 455.24,
   "text": "توحید. توحید ناب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 455.24,
   "end": 458.74,
   "text": "همون هو. قل هوالله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 458.74,
   "end": 464.02,
   "text": "تو رو بکشونه به اونجا. غافل از حضرت، از ذات حضرت حق نباشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 464.02,
   "end": 467.74,
   "text": "بعد ولم اعصک فی ابغض الاشیا الیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 467.74,
   "end": 472.86,
   "text": "و من هیچ‌وقت تو رو معصیت نکردم در اون مبغوض‌ترین چیزی که پیش توئه، اون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 472.86,
   "end": 476.58,
   "text": "هو الكفر. بعد میگه حالا بین این دو تا رو ببخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 476.58,
   "end": 479.34,
   "text": "چقدر شیرینه این دعا. اشاره می‌کنه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 479.34,
   "end": 482.32,
   "text": "به شیرینی ایمان، به شیرینی ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 482.32,
   "end": 486.56,
   "text": "یا در دعای معروف این رو هم عرض کنم برای امروز کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 486.56,
   "end": 490.88,
   "text": "دعای معروف رو همون دعایی‌ست که اسمش هم رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 490.88,
   "end": 493.3,
   "text": "دعای معروف دیگه اصلاً معروف هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 493.3,
   "end": 496.34,
   "text": "که جریانش اینطوریه که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 496.34,
   "end": 499.42,
   "text": "ابوذر داشت رد میشد، پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 499.42,
   "end": 501.9,
   "text": "با حضرت جبرائیل داشت سخن می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 501.9,
   "end": 504.74,
   "text": "می‌دونید غالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 504.74,
   "end": 513.56,
   "text": "اوقات حضرت جبرائیل به صورت دهیه کلبیه یه جوان بس-بسیار خوش سیما و خوش چهره بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 513.56,
   "end": 515.62,
   "text": "جوون بود، خیلی خوش سیما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 515.62,
   "end": 521.06,
   "text": "حضرت جبرائیل شبیه اون نازل میشد، متمثل میشد به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 521.06,
   "end": 523.3,
   "text": "ابوذر داشت رد میشد دید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 523.3,
   "end": 527.18,
   "text": "دهیه کلبیه فک-- متوجه نشد که جبرائیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 527.18,
   "end": 534.94,
   "text": "بعد همین رد شد. جبرائیل به پیغمبر گفتش که عرض کرد یا رسول الله چرا ابوذر به ما توجه نکرد، سلام نکرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 534.94,
   "end": 536.96,
   "text": "اگه سلام می‌کرد ما جوابشو می‌دادیم اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 536.96,
   "end": 540.22,
   "text": "پیغمبر بعداً ابوذر رو خواست فرمود شناختی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 540.22,
   "end": 542.56,
   "text": "گفت نه، گفت ایشون جبرائیل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 542.56,
   "end": 548.06,
   "text": "ابوذر غمگین شد. عرض کرد یا رسول الله من نخواستم مزاحم شما نشم، کلامتون رو قطع کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 548.06,
   "end": 551.22,
   "text": "گفتم خلوت کردید با ایشون. در هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 551.22,
   "end": 552.84,
   "text": "جبرائیل اینو می‌خوام بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 552.84,
   "end": 559.34,
   "text": "جبرائیل اونجا به حضرت پیغمبر فرمود یه دعایی ابوذر داره این معروفه در آسمان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 559.34,
   "end": 561.8,
   "text": "این دعا معروفه در آسمان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 561.8,
   "end": 564.74,
   "text": "برای همین اصلاً معروف شد به دعای معروف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 564.74,
   "end": 566.7,
   "text": "حالا شما عبارت دعا رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 566.7,
   "end": 570.22,
   "text": "اللهم انی اسئلک الایمان بک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 570.22,
   "end": 575.42,
   "text": "ایمان، ایمان. این حقیقت ایمان، توحید، ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 575.42,
   "end": 579.34,
   "text": "چقدر مهمه این حقیقت ایمان و توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 579.34,
   "end": 586.36,
   "text": "که تو همین دعای معروف ابوذر که ملائکه رو مات و مبهوت خودش کرده، تو اولین عبارتش اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 586.36,
   "end": 589.14,
   "text": "حالا دو سه جمله‌ست بخونم براتون شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 589.14,
   "end": 600.82,
   "text": "اللهم انی اسئلک الایمان بک و التصدیق بنبيك و العافیه من جميع البلا و الشکر علی العافیه و الغنی عن شرار الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 600.82,
   "end": 607.4,
   "text": "همش توحید نابه. ان‌شاءالله که عاقبتمون ختم به خیر بشه و به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 607.4,
   "end": 610.78,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}