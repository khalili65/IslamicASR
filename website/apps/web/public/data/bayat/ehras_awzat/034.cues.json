 "chapters": [
  {
   "index": 0,
   "title": "## چهار کار اکید برای همهٔ مردم",
   "start": 0.14,
   "end": 21.42
  },
  {
   "index": 1,
   "title": "سوم، تا می‌توانند صدقه بدهند.",
   "start": 21.42,
   "end": 90.32
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 2.08,
   "text": "اون چهار تا کار رو به همه مردم بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.08,
   "end": 5.0,
   "text": "یک به شدت دعا کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.0,
   "end": 10.8,
   "text": "برای حضرت آقا. دو، به شدت توسل کنن خاصه به ذیل عنایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.8,
   "end": 14.64,
   "text": "حضرت صدیقه شهیده حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.64,
   "end": 17.68,
   "text": "به ایشون توسل کنن. سه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.68,
   "end": 21.42,
   "text": "تا می تونن صدقه بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.42,
   "end": 27.82,
   "text": "اگه نمیشناسید که الان می شناسید قطعا نمیشناسید ما خیریه‌ای داریم در همین مجموعه‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.82,
   "end": 31.04,
   "text": "چقدر یتیم، چقدر گرفتار، چندین خانواده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.04,
   "end": 36.14,
   "text": "تحت پوشش، مشکلات عجیب و غریب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.14,
   "end": 40.5,
   "text": "بدید ما به دست خودمون به اونا میدیم از طرف شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.5,
   "end": 45.66,
   "text": "گره‌ها باز شه. س-- چهارمی هم قربانی، قربانی زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.66,
   "end": 50.3,
   "text": "اینو بدونید اینو الان یه فرصتی است من اصلش رو برای شما باز کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.3,
   "end": 52.12,
   "text": "اینو بدونید یه جمله عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.12,
   "end": 54.84,
   "text": "هر خونی که اون‌ها میریزن از ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.84,
   "end": 61.2,
   "text": "چه در غزه، چه در لبنان، چه در ایران، هر خونی که میریزن یک قربانی ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.2,
   "end": 65.06,
   "text": "برمی‌داره یعنی خنثی می‌کنه اصطلاحا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.06,
   "end": 67.4,
   "text": "ما خیلی باید قربانی برای آقا بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.4,
   "end": 69.98,
   "text": "حالا گرون شده زورمون نمیرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.98,
   "end": 73.66,
   "text": "ده نفر، بیست نفر، صد نفر با هم بشینیم قربانی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.66,
   "end": 76.32,
   "text": "این هم باز تو خیریه ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.32,
   "end": 83.74,
   "text": "یه طرحی هست ماهیانه می‌ریزن برای قربانی به حد نصاب گوسفند که رسید ما می‌کشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.74,
   "end": 88.38,
   "text": "اصلا اونجا نوشتیم به نیت سلامتی آقا جانمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.38,
   "end": 90.32,
   "text": "اینم از این موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}