 "chapters": [
  {
   "index": 0,
   "title": "## نکته‌ای فقهی در نماز جماعت",
   "start": 21.44,
   "end": 60.72
  },
  {
   "index": 1,
   "title": "## آیات سُخره؛ تأکید دوباره",
   "start": 60.72,
   "end": 80.86
  },
  {
   "index": 2,
   "title": "## نکتهٔ نهصدوهفتادوهشتِ هزارویک‌نکته",
   "start": 80.86,
   "end": 174.98
  },
  {
   "index": 3,
   "title": "چگونه؟ حضرت علامه می‌فرمایند به عدد سبعین مرّه؛ یعنی هفتاد بار.",
   "start": 174.98,
   "end": 197.4
  },
  {
   "index": 4,
   "title": "## از نخودکی تا حافظیان و شیخ ابوالقائم",
   "start": 197.4,
   "end": 235.66
  },
  {
   "index": 5,
   "title": "## زمزمهٔ عارفان و یادگارهای آقای بهجت",
   "start": 235.66,
   "end": 489.98
  },
  {
   "index": 6,
   "title": "## آویزانِ آقای بهجت؛ کیمیا و باور قلبی",
   "start": 489.98,
   "end": 667.32
  },
  {
   "index": 7,
   "title": "گفت نه؛ تو ادامه بده، ببین چه می‌شود.",
   "start": 667.32,
   "end": 736.3
  },
  {
   "index": 8,
   "title": "## اکثار ذکر لا إله إلا الله",
   "start": 736.3,
   "end": 814.44
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.95,
   "end": 3.78,
   "text": "محمد اعجب الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.78,
   "end": 8.14,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.14,
   "end": 11.32,
   "text": "و آله محمد واجعل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.32,
   "end": 14.1,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.1,
   "end": 19.16,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.16,
   "end": 21.44,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.44,
   "end": 24.42,
   "text": "اگر کسی در نماز جماعت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.42,
   "end": 27.96,
   "text": "دو تا رکن امام نرسید به هر دلیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.96,
   "end": 30.62,
   "text": "ابتدا کرده عقب افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.62,
   "end": 35.32,
   "text": "به دو تا رکن پشت سر هم اگر نرسید دیگه نمازش فرادا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.32,
   "end": 41.08,
   "text": "اما اگر به یک رکن نرسید مثلا رکوع امام تا قبل از اینکه امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.08,
   "end": 46.5,
   "text": "مثلا سر در هم و می‌خواد برداره می‌خواست بره رکوع دید امام سرش رو برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.5,
   "end": 50.76,
   "text": "ایشون رفت رکوع. باید ادامه بده نمازش رو ادامه بده به همون جماعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.76,
   "end": 54.7,
   "text": "چون یک رکن عقب افتاده خودشو به سجده امام برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.7,
   "end": 57.84,
   "text": "اما دو تا رکن عقب افتاد دیگه باید نیت فرادا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.84,
   "end": 62.24,
   "text": "اینو حواستون باشه. ادا-- اجازه بدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.24,
   "end": 68.48,
   "text": "به فضل الهی یک تأکید دیگری بکنم به آیات صخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.48,
   "end": 71.24,
   "text": "که آیات پنجاه و چهار تا پنجاه و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.24,
   "end": 80.86,
   "text": "سوره اعراف معروف به آیات صخره از إن ربكم الله الذي شروع میشه تا قريب و من المحسنين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.86,
   "end": 89.78,
   "text": "نکته نهصد و هفتاد و هشت هزار و یک نکته حضرت استاد علامه حسن زاده علیه الرحمه رو اگر ملاحظه فرموده باشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.78,
   "end": 93.76,
   "text": "تأکید ویژه ای ایشون داره به همین آیات صخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.76,
   "end": 95.52,
   "text": "من تأکید ایشون رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.52,
   "end": 100.56,
   "text": "می فرمایند آیه صخره به همین عنوان در السنه خواص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.56,
   "end": 103.4,
   "text": "خواص صحابه یعنی بر روی زبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.4,
   "end": 108.38,
   "text": "خواص صحابه بلکه غیر خواص نیز دائر بوده است و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.38,
   "end": 112.86,
   "text": "جوامع روایی چون کوکب دری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.86,
   "end": 114.42,
   "text": "در درخشان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.42,
   "end": 117.56,
   "text": "ببین علامه بگه این در درخشان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.56,
   "end": 119.54,
   "text": "و همه بهش تأکید داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.54,
   "end": 124.44,
   "text": "تو اصول کافی هم میتونید اصلاً روایت مفصلش رو از مولا ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.44,
   "end": 127.92,
   "text": "بعد ادامه میدن که و دستور العمل سائر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.92,
   "end": 132.06,
   "text": "یعنی ساریه در برنامه سالکان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.06,
   "end": 134.6,
   "text": "یه کسی که اینو تو برنامه‌ش نداره اصلاً سالک نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.6,
   "end": 138.3,
   "text": "اینطوری میشه برداشت کرد. و تأثیر آن در چیه حالا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.3,
   "end": 141.34,
   "text": "علامه می فرمایند در صفای قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.34,
   "end": 144.58,
   "text": "اطمینان نفس، گیرایه که ما داریما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.58,
   "end": 152.1,
   "text": "نفی خواتر. اونایی که گرفتار خواتر باطل و تخری-- متخیلات فاسده و اینان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.1,
   "end": 156.4,
   "text": "افکار پلید و اینان. ازاله شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.4,
   "end": 158.24,
   "text": "و وسواس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.24,
   "end": 160.96,
   "text": "آقا این وسواس پدر ما رو درآورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.96,
   "end": 167.14,
   "text": "وسوسه‌های شیاطین جن انس اینا در نفس پلید دیگران، همنشینی با بدان اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.14,
   "end": 169.7,
   "text": "همه اینا تأثیر داره. چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.7,
   "end": 174.98,
   "text": "حضرت علامه می‌فرمایند به عدد سبعين مره یعنی هفتاد بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.98,
   "end": 180.38,
   "text": "نفوس مستعده، مستعده را در مرتبت ایقان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.38,
   "end": 183.88,
   "text": "یعنی اونایی که استعداد دارن به یقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.88,
   "end": 186.16,
   "text": "رسیدن در این موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.16,
   "end": 188.62,
   "text": "یعنی یقین دارن به این موضوع و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.62,
   "end": 193.32,
   "text": "دستور آن از حضرت وصی عین برهان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.32,
   "end": 197.4,
   "text": "که دستورش رو حضرت امیرالمؤمنین داده به-- از اصحابشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.4,
   "end": 201.14,
   "text": "در حالات نمی‌دونم حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.14,
   "end": 207.22,
   "text": "مطالعه داشتید پیرامون حضرت آقای حافظیان، علامه حافظیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.22,
   "end": 209.9,
   "text": "علامه سید ابوالحسن حافظیان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.9,
   "end": 215.54,
   "text": "شاگرد بلا فصل مرحوم نخودکی اصفهانی بزرگ بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.54,
   "end": 221.9,
   "text": "هرچه مرحوم آقا نخودکی داشت داد به آقای حافظیان، علامه حافظیان، سید ابوالحسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.9,
   "end": 227.72,
   "text": "آقای حافظیان هم هرچی داد تعلیم داد به شیخ ابوالقائم شوشتری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.72,
   "end": 234.2,
   "text": "ما اصفهان که درس می‌خوندیم بعداً می‌رفتیم بعضی موقع‌ها توفیق داشتیم می‌رفتیم محضر ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.2,
   "end": 238.36,
   "text": "یادگارهایی داریم اگر خدا لطف کرد بعضیاشو قبلاً گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.36,
   "end": 240.0,
   "text": "بعداً خدمتتون عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.0,
   "end": 242.6,
   "text": "مخصوصاً در خصوص تقویت اراده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.6,
   "end": 247.4,
   "text": "یادگار خوبی از ایشون داریم یا همین بطلان سحر و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.4,
   "end": 254.56,
   "text": "اینها هم تأکید می‌کنند مثلاً علامه حافظیان می‌فرمود برای ابطال سحر بهترین دستورات آیات صخره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.56,
   "end": 257.14,
   "text": "همینطور که امیرالمؤمنین فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 257.14,
   "end": 259.62,
   "text": "آشیخ ابوالقائم شوشتری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.62,
   "end": 261.82,
   "text": "ایشون ترتیبش رو اینطوری بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.82,
   "end": 265.62,
   "text": "می‌فرمود برای امان بودن از اجنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.62,
   "end": 271.08,
   "text": "آیات صخره را روز اول هفتاد مرتبه بخواند و بعد روزی یک مرتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.08,
   "end": 275.38,
   "text": "همچنین برای بطلان سحر، بطلان طلسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.38,
   "end": 278.0,
   "text": "فرق نمی‌کنه سحر و جادو و طلسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.0,
   "end": 280.78,
   "text": "روز اول هفتاد بار همینطوری رو بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.78,
   "end": 284.88,
   "text": "روزی یک بار تکرار کنید تا انشالله این شر برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.88,
   "end": 288.04,
   "text": "اینا یکی از مهمات دستورات بزرگواران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 288.04,
   "end": 291.37,
   "text": "دیگه هی بریم به این در اون در بزنیم و پول بدیم به یه کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.37,
   "end": 293.86,
   "text": "جالبه که بعضی از همکارا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.86,
   "end": 300.14,
   "text": "حتی بعضی از عزیزانی که تو کانال هستن خب چند هزار نفر هستن اینا رو گوش میدن، پیغام و چی به ادمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.14,
   "end": 305.22,
   "text": "کانال یا عزیزان لطف دارن به ما که حتی تا چند میلیون حاضر شده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.22,
   "end": 308.38,
   "text": "بعضی اوقات هر چقدر حاج آقا بگه ما حاضریم بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.38,
   "end": 311.56,
   "text": "تو همین همکارا حتی که مثلاً حاج آقا برا ما بنویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.56,
   "end": 313.76,
   "text": "خودت با دست خودت بنویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.76,
   "end": 317.28,
   "text": "چرا تنبلیم ما یه ذره؟ همش دوست داریم دیگران بنویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.28,
   "end": 320.18,
   "text": "بعد ما کی از این کارا کردیم که پول بگیریم دعا بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.18,
   "end": 323.78,
   "text": "مگه ما دعانویسیم اصلاً؟ اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.78,
   "end": 326.8,
   "text": "حالا حسن ظن شماست. ما هم احترام میذاریم به حسن ظن تون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.8,
   "end": 329.34,
   "text": "یه مقدار به کار بیفتیم، به راه بیفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.34,
   "end": 334.22,
   "text": "برای این مسائل. بعد هی گیر و گور تو زندگیمون میفته، تو مسائل مالیمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.22,
   "end": 339.42,
   "text": "بیماری‌های خونوادگیمون، گرفتاری‌هامون، بسته شدن‌ها همه هم کار اهریمن‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.42,
   "end": 342.78,
   "text": "شیاطین جنی و انسی و نفس پلید اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.78,
   "end": 345.32,
   "text": "ما این وسط موندیم چه کنیم؟ بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.32,
   "end": 347.96,
   "text": "از همینجا شروع کن. چیز عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.96,
   "end": 351.52,
   "text": "حالا از خدا رحمت کنه حضرت آقای بهجت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.52,
   "end": 358.7,
   "text": "که من بخوام یادگارهایی که خدا به ما لطف داد اون مدتی که قم بودیم و بعضاً محضرشون می‌رسیدیم به شما بگیم زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.7,
   "end": 363.28,
   "text": "بعضیاش رو حالا ارجاع هم میدم که نگید حاج آقا از خودش میگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.28,
   "end": 367.8,
   "text": "در کتاب زمزمه عارفان توصیه می‌کنم این کتاب رو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.8,
   "end": 369.98,
   "text": "مرحوم آقای ری‌شهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.98,
   "end": 372.68,
   "text": "از سال هفتاد تا هشتاد و هفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 372.68,
   "end": 377.86,
   "text": "سرپرست حجاج بود، تو همون کتابم نوشته میگه من قبل از-- چقدر زرنگ بوده ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.86,
   "end": 380.6,
   "text": "قبل از اینکه برم مه-- اِاِاِ حج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.6,
   "end": 383.98,
   "text": "اول میرفتن محضر آقای بهجت و ازشون دستورالعمل می‌گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.98,
   "end": 386.72,
   "text": "این‌ها رو مجموعاً جمع کرده تو این کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.72,
   "end": 388.96,
   "text": "البته مطالب دیگه‌ای هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 388.96,
   "end": 392.5,
   "text": "مسائل مختلفی، بیان مسائل اعتقادی، اخلاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.5,
   "end": 400.9,
   "text": "اگر عرض شود فقهی حتی مکاشفات و رؤیاهای صادقه آقای بهجت مثلاً با امام، با آقای قاضی اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.9,
   "end": 403.3,
   "text": "خیلی شیرین، جالبه. اون رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 403.3,
   "end": 406.1,
   "text": "خیلی جالبه که اونجا خود آقای ری‌شهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.1,
   "end": 408.32,
   "text": "خب چقدر رهبر به عظمت از ایشون یاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 408.32,
   "end": 410.58,
   "text": "اون نامه‌ای که برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 410.58,
   "end": 417.08,
   "text": "مت-توفای ایشون، وفات ایشون نوشت خیلی با عظمت ازشون رهبر یاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 417.08,
   "end": 420.66,
   "text": "متولی سیدالکریم تهران خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.66,
   "end": 424.16,
   "text": "ایشون مثلاً تو همون کتاب میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.16,
   "end": 426.48,
   "text": "خودم از آقای بهجت پرسیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 426.48,
   "end": 428.68,
   "text": "مثلاً آیا آقای قاضی رو دیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 428.68,
   "end": 432.14,
   "text": "در خواب؟ فرمودن بله. شهری فرمودن بله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 432.14,
   "end": 434.96,
   "text": "حالا میگم یه دسته مکاشفات ایشون هم آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 434.96,
   "end": 441.48,
   "text": "خیلی شیرین و موثق هم هست دیگه که مثلاً گفته بود آقای قاضی به من در رؤیاهای صادقه فرمودند که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.48,
   "end": 446.38,
   "text": "امر مشتبه شد بین اینکه اِاِاِ مثلاً نماز اول وقت یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.38,
   "end": 451.42,
   "text": "نماز جماعت یا درس مشغول ت-درسم درس‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 451.42,
   "end": 457.18,
   "text": "حالا یه وقت مدیرا سوء استفاده نکنن بگن خب جلسه‌ی مدیریتی ما هم یه نوع درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.18,
   "end": 459.18,
   "text": "احکام اجتماعی و این توجیهات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.18,
   "end": 464.3,
   "text": "نه درس، عرفان، حکمت، معرفت، درس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 464.3,
   "end": 467.24,
   "text": "علم و بحث علم مطرح باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.24,
   "end": 473.02,
   "text": "بعد اگر مثلاً نماز اول وقت شده یا امام نماز جماعت چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 473.02,
   "end": 476.48,
   "text": "آقای بهجت فرموده بودند که استاد ما آقای قاضی در رؤیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 476.48,
   "end": 482.0,
   "text": "صادقه به ما فرمود که درس مقدمه چون این واجبه، اونا مستحبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.0,
   "end": 487.22,
   "text": "حالا از اینجور مسائل داره خیلی خط و خطوط سیر و سلوک ما رو می‌تونه مشخص کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.22,
   "end": 489.98,
   "text": "کسی که البته دل بده دیگه یعنی یقین داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.98,
   "end": 496.9,
   "text": "خود آقای بهجت می‌فرمودند آقا یه یادگاری خیلی سنگین و خوبی که من بیچاره شدم تا اینو از آقای بهجت گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.9,
   "end": 502.88,
   "text": "انقدر آویزون ایشون بودم، انقدر فحش شنیدم از دور و بری‌هاشون تا گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.88,
   "end": 508.8,
   "text": "ایشون می‌فرمود کسی که باور داره یعنی باور داری بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.8,
   "end": 511.5,
   "text": "یه سری رو بیان می‌کنه به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 511.5,
   "end": 516.18,
   "text": "کیمیا که با دستخط خودشون ایشون برای من نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.18,
   "end": 520.06,
   "text": "یادگار یه عمر اذیت کردن ما به ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 520.06,
   "end": 523.6,
   "text": "گفتم من قیامت جلو شما رو می‌گیرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 523.6,
   "end": 526.28,
   "text": "که جوونیمون از دست رفت. شما مثلاً ما رو ول کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.28,
   "end": 529.04,
   "text": "خیلی من می‌رفتم شب‌ها تا صبح در خونه‌شون می‌نشستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.04,
   "end": 534.12,
   "text": "می‌دونستم ایشون می‌دونه بالاخره آگاه به اسرار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 534.12,
   "end": 539.74,
   "text": "نهان دیگران هست. مکاشفاتی که به هر حال اون مقاماتی که ایشون داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.74,
   "end": 543.68,
   "text": "، متأسفانه برای خیلی‌ها آشکار نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 543.68,
   "end": 547.74,
   "text": "حالا زیاد، یادگاری زیادی داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 547.74,
   "end": 551.34,
   "text": "یادم میاد. حالا اینم براتون خوبه لا بلای بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 551.34,
   "end": 555.68,
   "text": "بحثم اگه موند. حالا روزای بعدو که ما نگرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 555.68,
   "end": 559.02,
   "text": "یه روز، روزای آخر خیلی دیگه من به ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.02,
   "end": 562.84,
   "text": "به قول دور و بری‌هاشون می‌گفتن آویزون آقای بهجت به بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 562.84,
   "end": 564.88,
   "text": "فشار آوردم و هر روز می‌گفت آقا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 564.88,
   "end": 569.36,
   "text": "وقت می‌خوام از شما. من قیامت جلو شما رو می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.36,
   "end": 572.02,
   "text": "هر روز می‌گفت باشه شما دعا کنین حال من بهتر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 572.02,
   "end": 576.82,
   "text": "چشم. گفتم نه من می‌خوام خود شما رو شخصاً خصوصی ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.82,
   "end": 579.22,
   "text": "درد و دلمو بگم. شما به من بگید چی کار کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 579.22,
   "end": 584.18,
   "text": "خیلی جوون کله شق بالاخره تازه هم طلبه شده بودیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 584.18,
   "end": 589.74,
   "text": "این‌ها. بعد یه روزی دوباره اومدم گفتم جماعت زیادی هم دور ایشون بود از فضلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 589.74,
   "end": 591.6,
   "text": "شهرها و کشورهای مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 591.6,
   "end": 595.7,
   "text": "ما با پررویی تمام دوباره اومدیم دستشو بوسیدیم گفتیم آقا وقت می‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 595.7,
   "end": 599.32,
   "text": "داد زد سر من ایشون گفت آقا ولم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 599.32,
   "end": 601.64,
   "text": "چرا انقدر منو اذیت می‌کنی شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 601.64,
   "end": 606.26,
   "text": "من میگم حالم خوب نیست. آقا ما رو رنگمون پرید و همه فحش و لعن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 606.26,
   "end": 610.7,
   "text": "نفرین و هر کی یه چیزی به ما می‌گفت دیگه این دور و بریا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 610.7,
   "end": 615.54,
   "text": "ما یخ زدیم اونجا وایسادیم و ایشون رفت و همه هم لعن کردن ما رو رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 615.54,
   "end": 621.0,
   "text": "چرا آقا رو اذیت می‌کنی؟ فضلا بالاخره دور و برم یه بچه طلبه و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 621.0,
   "end": 625.6,
   "text": "یه آقای سید باصفای نورانی عرب از فضلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 625.6,
   "end": 634.2,
   "text": "من بحرین بود کجا بود با زبان و اون لحن عربیش به من اومد منو ماچ کرد پیشونی ماچ کرد زد رو دوشم گفت آفرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 634.2,
   "end": 638.42,
   "text": "احسن خوشا به حالت. گفتم بابا پدر ما رو که درآورد آقای بهجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 638.42,
   "end": 639.9,
   "text": "چی خوشا به حالت. گفت نه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 639.9,
   "end": 644.9,
   "text": "سریه بزرگان اینو مخصوصاً میگم شما بدونید اگر انشاالله با بزرگی طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 644.9,
   "end": 654.22,
   "text": "حساب شدید، بزرگان یکی رو که تایید می‌کنند می‌خوان یعنی قبولش می‌کنن باشه یعنی قبولش کردن می‌زنن تو پرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 654.22,
   "end": 656.34,
   "text": "می‌زنن تو پرش باهاش برخورد می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 656.34,
   "end": 659.76,
   "text": "ببینن ظرفیتشو داره ادامه بده یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 659.76,
   "end": 662.62,
   "text": "گفتم بابا ولمون کن. شما زد و اصلاً آبروی ما رو برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 662.62,
   "end": 667.32,
   "text": "دیدی چطوری همه لعن کردن؟ گفت نه تو ادامه بده ببین چی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 667.32,
   "end": 670.36,
   "text": "ما هم شب رفتیم کوه حضرت خضر و تا صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 670.36,
   "end": 677.0,
   "text": "توسل و فلان. صبح اول صبح برای نماز دوباره قبل نماز اومدیم رفتیم پشت در خونه‌ی آقای بهجت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 677.0,
   "end": 681.18,
   "text": "با ایشون اومدیم مسجد و تا اومد بیرون سلامم نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 681.18,
   "end": 684.12,
   "text": "گفت ما وقت می‌خوایم از شما دوباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 684.12,
   "end": 687.38,
   "text": "فرداش. خیلی جالب بود برام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 687.38,
   "end": 690.58,
   "text": "صد و هشتاد درجه برعکس شد اصلاً قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 690.58,
   "end": 695.0,
   "text": "خیلی گرم. چشم عزیزم وقتم به شما میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 695.0,
   "end": 698.2,
   "text": "فلان. دیدم چه جالب آقا درست می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 698.2,
   "end": 700.82,
   "text": "خلاصه اینو میگم. اون یادگاری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 700.82,
   "end": 703.82,
   "text": "در نهایت ایشون نوشت به ما داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 703.82,
   "end": 708.22,
   "text": "که الان معذورم به شما بگم ولی انشاالله به، به وقتش میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 708.22,
   "end": 715.44,
   "text": "غصه نخورید به وقتش. خیلی چیز جالبی بود به برادرمون تو عمرمون خورد و الان نگهش داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 715.44,
   "end": 718.78,
   "text": "ایشون این جمله‌شون برای من خیلی کارساز بود و هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 718.78,
   "end": 722.2,
   "text": "برای شما هم هست که با باور قلبی بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 722.2,
   "end": 724.64,
   "text": "اگه باور نداری ول کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 724.64,
   "end": 726.48,
   "text": "بعد انجام میدی تاثیر نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 726.48,
   "end": 732.32,
   "text": "میگی استغفرالله اینا دکون-- عکس دستک بود و استغفرالله العظیم بالاخره برعکس می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 732.32,
   "end": 736.06,
   "text": "جواب برعکس می‌شه. باور نداری نگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 736.06,
   "end": 742.16,
   "text": "حالا از آقای بهجت می‌خواستم توصیه‌هایی رو عرض کنم که دیگه بحثمون با اون خاطره گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 742.16,
   "end": 747.0,
   "text": "یه دونه‌شو بگم. انشاالله جلسه بعد یه چند تا یادگاری از ایشون تقدیم می‌کنم برای همین خصوص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 747.0,
   "end": 751.54,
   "text": "یه دونه‌ش. اونهایی که گرفتار خواطر باط-باطل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 751.54,
   "end": 754.38,
   "text": "زیاد افکار زشت، فکر زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 754.38,
   "end": 757.08,
   "text": "اینام همش تاثیر چیه؟ گفتم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 757.08,
   "end": 761.14,
   "text": "نفس پلید شیاطین جنی و انسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 761.14,
   "end": 764.86,
   "text": "می‌شینی کنار یه آدم معذرت می‌خوام پست فطرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 764.86,
   "end": 767.82,
   "text": "با دارای سوءظن به همه سوءظن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 767.82,
   "end": 771.2,
   "text": "نفسش بهتون تموم شد. اینا رو چگونه دفع کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 771.2,
   "end": 773.06,
   "text": "آقای بهجت فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 773.06,
   "end": 775.92,
   "text": "اکسار ذکر لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 775.92,
   "end": 778.54,
   "text": "بدون عدد. عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 778.54,
   "end": 788.4,
   "text": "مطالبی در پی خودش داره و اکسار لب-- حداقل اینو من اضافه می‌کنم با تجربه شخصی خودم و در روایات دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 788.4,
   "end": 791.4,
   "text": "منظور از این اکسار قطعاً یک ساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 791.4,
   "end": 797.36,
   "text": "چون روایت داریم یک کاری رو انجام ندید مگر اینکه یک سال ادامه‌ش بدید تا برکتشو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 797.36,
   "end": 801.54,
   "text": "یک سال لب تر باشه به لا اله الا الله ببینید نتیجه‌شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 801.54,
   "end": 806.42,
   "text": "انشاالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 806.42,
   "end": 814.44,
   "text": "اللهم صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}