 ],
 "cues": [
  {
   "i": 0,
   "start": 3.2,
   "end": 6.42,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.42,
   "end": 9.12,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.12,
   "end": 13.66,
   "text": "محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.66,
   "end": 17.68,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.68,
   "end": 22.82,
   "text": "السلام علیک ای داعی الله و ربانی ایه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.82,
   "end": 25.62,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.62,
   "end": 30.6,
   "text": "در ادامه بحث احراز و ادعیه و اوذات و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.6,
   "end": 37.24,
   "text": "یه نکته‌ای رو قبل از اینکه یک دستورالعملی که بزرگان خیلی سفارش کردن رو پیرامون مطلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.24,
   "end": 40.08,
   "text": "حاجات و گرفتاری‌ها مخصوصا حاجات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.08,
   "end": 44.16,
   "text": "سنگین عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.16,
   "end": 48.42,
   "text": "این نکته رو به صورت مقدمه از یکی از آیات براتون بیان کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.42,
   "end": 51.8,
   "text": "آیه صد و بیست و چهار سوره طه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.8,
   "end": 61.42,
   "text": "ملاحظه فرمودید که می‌فرماید \"و من أعرض عن ذکری\" هر کسی که اعراض کنه، پشت کنه به ذکر من \"فإن قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.42,
   "end": 64.02,
   "text": "له معيشة ضنكا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.02,
   "end": 68.31,
   "text": "بارها این آیه رو مورد توجه قرار دادیم تو بحث‌هامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.31,
   "end": 71.74,
   "text": "\"ونحشره يوم القيامة أعمى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.74,
   "end": 78.08,
   "text": "کسی که فراموش کنه خدا رو، ذکر و یاد خدا رو این قطعاً زنک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.08,
   "end": 81.86,
   "text": "معیشتی پیدا می‌کنه. در یک تنگنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.86,
   "end": 85.68,
   "text": "زندگی قرار می‌گیره و قیامت هم چگونه محشور می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.68,
   "end": 92.36,
   "text": "کور، نابینا. در تفسیر اهل بیت علیهم الصلاة والسلام که یک تفسیر روایی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.36,
   "end": 96.08,
   "text": "جلد نه، صفحه دویست و شش، سیصد و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.08,
   "end": 102.42,
   "text": "البته در بهار جلد هفتاد و پنج صفحه سیصد و هفتاد و چهار هم می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.42,
   "end": 106.16,
   "text": "تحف العقول صفحه چهارصد و هشتاد و چهار هم می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.16,
   "end": 113.08,
   "text": "کتاب‌های متعددی این روایت رو ذیل این آیه آوردن که امام عسکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.08,
   "end": 118.12,
   "text": "صلوات الله علیه یه نامه‌ای نوشتن به اسحاق بن اسماعیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 118.12,
   "end": 124.9,
   "text": "نامه مبسوته. یک بخشی از این نامه حضرت می‌فرمایند که فاعلم یقیناً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.9,
   "end": 130.12,
   "text": "قطعاً یقیناً بدان یا اسحاق أنه من خرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.12,
   "end": 132.54,
   "text": "داره ذیل این آیه میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.54,
   "end": 135.16,
   "text": "اون آیه رو که قرائت کرده حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.16,
   "end": 137.94,
   "text": "داره ذیل این آیه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.94,
   "end": 144.88,
   "text": "ایشون نکته‌ای رو می‌فرماید که \"أنه من خرج من هذه الدنيا أعمى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.88,
   "end": 151.98,
   "text": "هر کسی که نابینا از این دنیا خارج بشه \"فهو في الآخرة أعمى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.98,
   "end": 153.52,
   "text": "اون قیامت هم نابیناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.52,
   "end": 156.5,
   "text": "حالا این نابینایی، نابینای ظاهری نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.5,
   "end": 162.44,
   "text": "باطنیه و اول سبیل و دیگه بدترین شکل گمراهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.44,
   "end": 166.82,
   "text": "يا اسحاق ليست عمال Abصار و لکن تعمل قلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.82,
   "end": 170.76,
   "text": "این منظور حضرت می‌فرماید حواست باشه اسحاق که منظور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.76,
   "end": 174.96,
   "text": "نابینای ظاهری نیست، نابینایی قلبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 174.96,
   "end": 182.78,
   "text": "التي في الصدور که تو سینه‌ها اتفاق می‌افته و ذلك قول الله في محكم كتابه حکایت آن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.78,
   "end": 187.82,
   "text": "بعد از این حکایت این آیه دو مرتبه برمی‌گردونه حضرت به این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 187.82,
   "end": 192.02,
   "text": "می‌زنش به این آیه که عن ظالم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 192.02,
   "end": 198.42,
   "text": "رفتاری که خدا با ظالم می‌کنه اذ يقول وقتی اونجا می‌بینه وضعیتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 198.42,
   "end": 205.66,
   "text": "در قیامت، اونجا ظالم میگه که رب لم حشرتني أعمى؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 205.66,
   "end": 208.88,
   "text": "خدایا چرا منو کور محشور کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.88,
   "end": 211.26,
   "text": "فقط کنت بصيرا من چشم داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 211.26,
   "end": 213.48,
   "text": "قالک ذلك أتتک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 213.48,
   "end": 217.04,
   "text": "آيات. حالا حضرت داره اشاره به اینجا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.04,
   "end": 220.78,
   "text": "بعد از اینکه اون ذکر اونجا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 220.78,
   "end": 227.0,
   "text": "می‌فرماید که اون حالا در خصوصش صحبت می‌کنه که اون ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 227.0,
   "end": 231.94,
   "text": "سبب کوری می‌شه، پشت کردن به ذکر خدا سبب کوری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 231.94,
   "end": 237.36,
   "text": "حالا می‌خواد با توجه به یه آیه دیگه این آیه رو توضیح بده و چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 237.36,
   "end": 241.08,
   "text": "زیبا حضرت توجه ما رو جلب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 241.08,
   "end": 247.36,
   "text": "می‌فرماید که قالک ذلك این آدم ظالم میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 247.36,
   "end": 251.28,
   "text": "أتتک بهش میگن أتتک آياتنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 251.28,
   "end": 254.43,
   "text": "فنسيتها آیات ما اومد به سوی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 254.43,
   "end": 257.74,
   "text": "أتتک آياتنا. آیات ما به سوی تو آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 257.74,
   "end": 260.32,
   "text": "فنسيتها تو فراموششون کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 260.32,
   "end": 262.48,
   "text": "و كذلك اليوم تنسى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 262.48,
   "end": 268.02,
   "text": "همچون روزی هم چون اونجا فراموش کردی وقتی آیات ما اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 268.02,
   "end": 272.24,
   "text": "لذا همینطور اینجا ما تو رو فراموش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 272.24,
   "end": 275.82,
   "text": "و أيو اینجا حضرت داره تعبیرش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.82,
   "end": 278.94,
   "text": "تأویل این آیه رو بیان می‌کنه در حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 278.94,
   "end": 284.84,
   "text": "که دو تا آیه رو به یک معنا تأویل کردن و أيو آية چه آیه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 284.84,
   "end": 292.76,
   "text": "أعظم من حجة الله على خلقه وأمينه في بلاده وشهيده على عباده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 292.76,
   "end": 295.92,
   "text": "چه آیه‌ای با عظمت‌تر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 295.92,
   "end": 298.88,
   "text": "آیه، از حجت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 298.88,
   "end": 301.62,
   "text": "اونجا داره میگه آیه ها رو فراموش کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 301.62,
   "end": 304.7,
   "text": "این بلا سرتون اومد. نا، نابینا شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 304.7,
   "end": 308.72,
   "text": "حضرت می‌فرماید بفرما ببینم چه آیه‌ای بالاتر از حجت خداست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 308.72,
   "end": 311.62,
   "text": "که بعد می‌فرماید حالا این حجت‌ها کیان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 311.62,
   "end": 318.76,
   "text": "من سلف من آبائه الأولین النبیین و آلهم و آبائه الآخرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 318.76,
   "end": 323.76,
   "text": "الوثیقین عليهم أجمعین السلام ورحمة الله وبركاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 323.76,
   "end": 326.72,
   "text": "معرفی می‌کنه که همه ائمه چی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 326.72,
   "end": 331.5,
   "text": "اون حجه، حجة الله‌اند و آية الله العظمى اونان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 331.5,
   "end": 335.02,
   "text": "ما قبلاً گفتیم خب بر اساس همین آیه هم اصلاً همه چی آیه الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 335.02,
   "end": 338.72,
   "text": "شما هم آیه الله تشریف دارید. زمین و آسمان هم آیه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 338.72,
   "end": 345.92,
   "text": "اما آیه الله العظمى که امیرالمؤمنین علیه الصلاة والسلام فرمود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 345.92,
   "end": 349.66,
   "text": "لله آیه أعظم مني.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 349.66,
   "end": 356.2,
   "text": "آیه‌ای برای خدا بزرگ‌تر یا اکبر مني، بزرگ‌تر از من نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 356.2,
   "end": 357.84,
   "text": "اون بزرگ‌ترین آیه خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 357.84,
   "end": 359.9,
   "text": "حالا به چه نتیجه‌ای می‌رسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 359.9,
   "end": 363.44,
   "text": "اون من أعرض عن ذکری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 363.44,
   "end": 371.2,
   "text": "با توجه به این روایت و چندین روایت متعدد دیگه که دیگه من صرف نظر می‌کنم تو همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 371.2,
   "end": 381.38,
   "text": "سندی که ارائه دادم تو تفاسیر روایی فرمودن منظور پشت کردن به ولایت اهل بیته، یاد نکردن از امام زمانته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 381.38,
   "end": 386.86,
   "text": "غافل بودن و یاد نکردن از امام زمانته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 386.86,
   "end": 389.36,
   "text": "البته در یک روایتی از پیغمبر عزیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 389.36,
   "end": 396.48,
   "text": "اسلام هم داریم اینم بدونید که باز تو همون تفسیر اهل بیت تعابیر متعددی پیرامون معیشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 396.48,
   "end": 400.0,
   "text": "زنگ کردن که این تو این دنیاست یا اون دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 400.0,
   "end": 409.08,
   "text": "اینجام هست اما اصلش تو برزخ اتفاق می‌افته چون پیغمبر فرمود \"فإن له معیشةً ونکا قال عذاب القبر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 409.08,
   "end": 415.28,
   "text": "این عذاب قبره. این تنگی زندگی اونجا آغاز می‌شه اما اینجام رشه‌هاش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 415.28,
   "end": 418.4,
   "text": "هرچی پول در میاره می‌بینی بدبخت بیچاره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 418.4,
   "end": 423.16,
   "text": "میلیاردره، تریلیاردره، داره، حسابی هم داره اما همش بیچاره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 423.16,
   "end": 424.96,
   "text": "همه آرامش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 424.96,
   "end": 428.58,
   "text": "گرفتاره، بدبخته. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 428.58,
   "end": 431.86,
   "text": "آرا-- تنگی زندگی چرا اومده تو وجودش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 431.86,
   "end": 435.92,
   "text": "غافل از امام عصرشه. حالا ما هم تو وادی خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 435.92,
   "end": 442.86,
   "text": "ما وقتی که بررسی می‌کنیم می‌بینیم که حتی تو توسلاتمون هم غافلیم از امام عصرمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 442.86,
   "end": 447.24,
   "text": "چندتامون خداوکیلی توسل به امام عصرمون داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 447.24,
   "end": 452.78,
   "text": "دقت بفرمایید چی عرض می‌کنم. ما این همه ذکر و ختم و ورد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 452.78,
   "end": 457.48,
   "text": "عرض شود عبادات و احراز و این‌ها گفتیم و گفتیم و گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 457.48,
   "end": 459.36,
   "text": "خب ادعه همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 459.36,
   "end": 464.12,
   "text": "رو چشم ما اما کدوممون استغاثه به امام عصرمون کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 464.12,
   "end": 472.26,
   "text": "چندتامون؟ امام عصرمون رو حالا من یه از کتاب آداب المراقبین که آورده‌م می‌خواستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 472.26,
   "end": 478.52,
   "text": "برای شما نکته‌ای رو عرض کنم که دیگه فرصت نمی‌شه فردا بگم و انشاالله اگر زنده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 478.52,
   "end": 483.82,
   "text": "این کتابی هم که جلوی منه کتاب هزار و یک نکته از علامه‌ست علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 483.82,
   "end": 486.28,
   "text": "نکته ششصد و نودش رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 486.28,
   "end": 496.42,
   "text": "یه روایت شیرینی از سعید بن تابوس میاره ایشون که در کتاب المجتنا من دعاء المجتبی میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 496.42,
   "end": 502.4,
   "text": "البته اینجا علامه فرموده از کتاب المجتنا هم کاملشو گفتم خواستید پیدا کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 502.4,
   "end": 507.36,
   "text": "من دعاء المجتبی. اونجا می‌فرماید که این دعا از امام رضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 507.36,
   "end": 510.44,
   "text": "دعا چیه؟ می‌فرماید یا بدیع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 510.44,
   "end": 514.66,
   "text": "با همزه اینجاست. یا بدیع بعدش با عینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 514.66,
   "end": 521.52,
   "text": "یا قوی یا منیع یا علی یا رفیع صلي على صلوات بفرست بر کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 521.52,
   "end": 525.24,
   "text": "من شرفت الصلاة بالصلاة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 525.24,
   "end": 529.6,
   "text": "کسی که صلا-صلاة رو نماز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 529.6,
   "end": 536.56,
   "text": "به او س-- شرافت بخشیدی به صلوات بر او به نماز شرافت بخشیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 536.56,
   "end": 542.32,
   "text": "اصلاً شرافت نماز به جهت صلواتی‌ست که به حجت خدا می‌فرستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 542.32,
   "end": 548.78,
   "text": "بعد یه روایت دیگه‌ای علامه میاره که پیغمبر یه شخصی به نام سعید مشغول نماز بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 548.78,
   "end": 550.74,
   "text": "پیغمبر صداش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 550.74,
   "end": 555.52,
   "text": "جواب نداد. بعد که نماز تموم شد اومد عذرخواهی کرد گفت یا رسول الله در نماز بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 555.52,
   "end": 557.98,
   "text": "فرمود نماز باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 557.98,
   "end": 568.92,
   "text": "مگه توجه به این آیه نکردی که خدا فرموده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 568.92,
   "end": 572.22,
   "text": "وقتی شما رو می‌خونن اجابت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 572.22,
   "end": 576.42,
   "text": "یعنی کأن علامه می‌فرماید کأن این فرمایش علامه‌ست تو این نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 576.42,
   "end": 580.22,
   "text": "ششصد و نود. می‌فرماید کأن پیغمبر فرمود من نماز منم اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 580.22,
   "end": 584.74,
   "text": "نماز تو رو صدا زده، تو صدا تو جواب ندادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 584.74,
   "end": 586.9,
   "text": "جایگاه اهل بیت اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 586.9,
   "end": 590.82,
   "text": "خوب جایگاه حجت خدا خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 590.82,
   "end": 594.98,
   "text": "تبیین بشه، هر گیر و گوری تو زندگی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 594.98,
   "end": 606.0,
   "text": "پیدا شد اول متوجه او می‌شیم و حتی هر ذکری، وردی، چیزی هم اگر داریم هدیه به او می‌کنیم چون او واسطه خیر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 606.0,
   "end": 609.4,
   "text": "به همین مناسبت در انتهای بحثمون من یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 609.4,
   "end": 615.52,
   "text": "دستورالعمل معرفی کنم. البته شنیدید یکیشو مطمئنم شنیدید چون آشیخ عباس هم آورده تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 615.52,
   "end": 618.74,
   "text": "مفاتیحش و خیلی هم معروفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 618.74,
   "end": 621.94,
   "text": "من خودم بارها ازش بهره گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 621.94,
   "end": 626.62,
   "text": "یه بار تو همین ادارجات اینجا به شدت یه گره کوری برای ما خورده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 626.62,
   "end": 633.52,
   "text": "همین جا تو همین بیرون این نمازخونه زیر آسمون این نماز استغاثه به نما-- امام عصر عجل الله تعالی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 633.52,
   "end": 635.2,
   "text": "خوندم و رفتم گره باز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 635.2,
   "end": 638.04,
   "text": "یعنی اون روز خودم یه معجزه دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 638.04,
   "end": 647.88,
   "text": "که البته این نماز استغاثه رو می‌تونید عا-عادی بخونید مثل نماز صبح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 647.88,
   "end": 653.18,
   "text": "اما بهتر اینه که در رکعت اول بعد از حمد سوره فتح بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 653.18,
   "end": 656.84,
   "text": "رکعت دوم بعد از حمد سوره نصر رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 656.84,
   "end": 659.26,
   "text": "زیر آسمون هم باشه اینا بهتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 659.26,
   "end": 667.9,
   "text": "یعنی جواب بهتری می‌گیرید. بعد از دعا وقت بعد از نماز یه دعای خیلی شیرینی داره که معروفه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 667.9,
   "end": 669.94,
   "text": "سلام الله الكامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 669.94,
   "end": 673.86,
   "text": "اگر رفتید دیدید انتهای دعا رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 673.86,
   "end": 681.76,
   "text": "یه تیکه‌ش هست خیلی من هر وقت می‌خونم به این تیکه می‌ش-- می‌رسم موقع دعاش اشک تو چشمام ناخودآگاه جمع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 681.76,
   "end": 690.06,
   "text": "به امام عصر عرض می‌کنی سل الله تعالی في نجه طلبتي و اجابه دعوتي و كشف كربتي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 690.06,
   "end": 692.88,
   "text": "آقا شما سؤال کن از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 692.88,
   "end": 697.26,
   "text": "برای رفع گرفتاری و کشف کر-- این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 697.26,
   "end": 700.14,
   "text": "غم و اندوهم و حاجت رواییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 700.14,
   "end": 703.08,
   "text": "سل الله تعالی شما سؤال کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 703.08,
   "end": 705.98,
   "text": "به امام عصر به حجت خدا میگی شما سؤال کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 705.98,
   "end": 709.2,
   "text": "اون حجت، اون اسم اعظم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 709.2,
   "end": 714.3,
   "text": "می‌شه او از خدا در رابطه تو سؤالی بکنه و اجابت نشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 714.3,
   "end": 716.8,
   "text": "محاله. ما غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 716.8,
   "end": 721.68,
   "text": "خداوکیلی چندتامون تو خونه وقتی حتی گره‌های کور به کارمون افتاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 721.68,
   "end": 726.08,
   "text": "این نماز استغاثه به آقا رو خوندیم، طلب کردیم از حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 726.08,
   "end": 728.86,
   "text": "و چندتامون خوندیم نتیجه نگرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 728.86,
   "end": 730.64,
   "text": "یه روش دیگه‌ای هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 730.64,
   "end": 737.22,
   "text": "حالا اینی که الان من برای شما گفتم که آشیخ عباس هم آورده تو کتاب دارالسلام علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 737.22,
   "end": 742.16,
   "text": "شیخ محمود عراقی هم آورده و این روش جدید دیگه‌ای هم حالا اگه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 742.16,
   "end": 745.24,
   "text": "خواست اینو بخونه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 745.24,
   "end": 749.14,
   "text": "عبارت خونی عربیش خوب نبود چون اون یه دعا داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 749.14,
   "end": 754.44,
   "text": "س-- عرض شود سلام الله الكامل و تام و شامل العام والـ اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 754.44,
   "end": 759.84,
   "text": "حالا اونو نخواد بخونه این دستور رو انجام بده که این دستور آخری که عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 759.84,
   "end": 766.24,
   "text": "صدر الاسلام همدانی در کتاب تکالیف الانام فی غیبت الامام آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 766.24,
   "end": 771.8,
   "text": "فرمود برای استغاثه به امام زمان زیر آسمون بالای پشت بوم ترجیحاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 771.8,
   "end": 775.98,
   "text": "سر برهنه برید دو رکعت نماز بخونید معمولی مثل نماز صبح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 775.98,
   "end": 778.48,
   "text": "این دیگه دو-- سوره فتح و نصر نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 778.48,
   "end": 781.7,
   "text": "دو رکعت نماز بخونید تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 781.7,
   "end": 784.92,
   "text": "همون زیر آسمون به عدد ابجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 784.92,
   "end": 788.24,
   "text": "اسم امام زمان که می‌شه پونصد و نود و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 788.24,
   "end": 793.24,
   "text": "به عدد پونصد و نود و پنج بگید یا حجت القائم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 793.24,
   "end": 797.26,
   "text": "پونصد و نود و پنج بار یا حجت القائم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 797.26,
   "end": 799.58,
   "text": "بعد طلب کنید از حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 799.58,
   "end": 802.88,
   "text": "همین دلگویه داشته باشید گره‌تون رو به حضرت ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 802.88,
   "end": 805.68,
   "text": "ببینید چه جوری گره باز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 805.68,
   "end": 810.56,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 810.56,
   "end": 816.54,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}