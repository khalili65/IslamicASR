 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 7.14,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.14,
   "end": 13.84,
   "text": "صل علی محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.84,
   "end": 17.42,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.42,
   "end": 20.96,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.96,
   "end": 27.32,
   "text": "و ربانیة آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.32,
   "end": 33.78,
   "text": "ضمن عرض تسلیت و تعزیت به جهت این مصیبت بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.78,
   "end": 40.4,
   "text": "که واقعاً جمران ناپذیر هست این مصیبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.4,
   "end": 47.8,
   "text": "خدمت و محضر مقدس آقامون امام عصر و همه محبین امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.8,
   "end": 51.78,
   "text": "اجازه می خوام که در این فرصت کوتاه چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 51.78,
   "end": 58.62,
   "text": "توصیه از بزرگان پیرامون شب قدر رو تقدیم کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 58.62,
   "end": 63.2,
   "text": ". یکی از حالا به صورت مقدمه عرض کنم یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 63.2,
   "end": 68.28,
   "text": "بهترین کارهایی که ما شب قدر می تونیم انجام بدیم گفت و گوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 68.28,
   "end": 75.02,
   "text": "خودمانی، دلگویه با خدا و مخصوصاً امام عصر هر طور بلدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 75.02,
   "end": 80.22,
   "text": "فارغ از اون ادعیه و این‌ها که مفورن و حق هم هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 80.22,
   "end": 85.32,
   "text": "یه دلگویه ای با خدات با امام زمانت ارتباط برقرار کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 85.32,
   "end": 88.44,
   "text": "وقتی آدم میشینه خودشو زمین میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 88.44,
   "end": 92.8,
   "text": "اصلاً به دستور آقای کشمیری یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 92.8,
   "end": 96.68,
   "text": "توصیه های اکید آقای کشمیری برای شب‌های قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 96.68,
   "end": 100.98,
   "text": "این بود که می فرمودن به کیفیت بپردازید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 100.98,
   "end": 103.92,
   "text": "یعنی کیفیت براتون مهم باشه نه کمیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 103.92,
   "end": 108.92,
   "text": "با این دعا، اون دعا، این سوره، اون نماز اینطوری بعدش هم آخر خستگی برات بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 108.92,
   "end": 114.72,
   "text": "نه. تا مقداری که لذت ببری و مخصوصاً عرض می‌کنم بشکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 114.72,
   "end": 118.98,
   "text": "هر کاری که از دستت بر میاد تا بشکنه دلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 118.98,
   "end": 121.44,
   "text": "سوز دل پیدا کنی، اشکت جاری بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 121.44,
   "end": 124.72,
   "text": "این شکستن موضوعیت داره امشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 124.72,
   "end": 129.78,
   "text": "یکی از راه‌هاش گفت‌وگو با خدا، صحبت کنی با امام عصرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 129.78,
   "end": 132.34,
   "text": "مثلاً چگونه گفت‌وگو کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 132.34,
   "end": 136.62,
   "text": "آقا مشتهی تهرانی خدا رحمتشون کنه یه دستوری داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 136.62,
   "end": 143.04,
   "text": "می فرمودن که خودشون می فرمودن من همیشه میخوام با خدا صحبت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 143.04,
   "end": 144.64,
   "text": "همیشه، نه فقط شب قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 144.64,
   "end": 147.4,
   "text": "ولی شب قدر هم توصیه می‌کردن این چنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 147.4,
   "end": 152.18,
   "text": "می فرمودن قبل از اینکه از خدا طلب مغفرت کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 152.18,
   "end": 159.42,
   "text": "تأمل می‌کردم و می‌گفتم خدایا تو شاهد باش هر کسی که به من بد کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 159.42,
   "end": 165.34,
   "text": "پشت سر من غیبت کرده، آبرومون رو برده، بهم بدهکاری داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 165.34,
   "end": 172.66,
   "text": "هر کاری در حق من کرده، ظلمی ستمی به من کرده، من از ته دل از بخشیدمش و هیچ توقعی هم ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 172.66,
   "end": 178.28,
   "text": "تمام. بخشیدم. و به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 178.28,
   "end": 184.44,
   "text": "رو کن این آقا مشتهی تهرانی میگه من اینطوری بودم و توصیه میکنه شما هم اینطوری باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 184.44,
   "end": 192.5,
   "text": "می فرمود به خدا بگو که خدایا اگر تو هم گناهان و معصیت‌های من و اشتباهات منو نبخشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 192.5,
   "end": 195.14,
   "text": "پس من از تو بخشنده ترم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 195.14,
   "end": 198.62,
   "text": "چون هر کسی که بهم بد کرده بودو بخشیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 198.62,
   "end": 202.36,
   "text": "اگه تو نبخشی من از تو بخشنده ترم و این محاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 202.36,
   "end": 205.68,
   "text": "پس یقیناً تو منو بخشیدی و می بخشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 205.68,
   "end": 207.58,
   "text": "بعد می فرمود که این جمله ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 207.58,
   "end": 211.12,
   "text": "فرمود این کارو بکن با-- اینطوری با خدا صحبت کنی ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 211.12,
   "end": 214.62,
   "text": "چگونه حالتون قشنگ می‌شه، عوض می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 214.62,
   "end": 217.38,
   "text": "این اثر دلگویه هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 217.38,
   "end": 222.64,
   "text": "خصوصاً تاکید می‌کنم امشب با امام عصر چون صاحب امشبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 222.64,
   "end": 226.4,
   "text": "و امشب به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 226.4,
   "end": 230.84,
   "text": "شب نوزدهم نوشته شده تقدیرات امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 230.84,
   "end": 234.06,
   "text": "محکم می‌شه، لیلة التحکیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 234.06,
   "end": 236.6,
   "text": "شب بیست و سوم هم که لیلة الإملا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 236.6,
   "end": 239.32,
   "text": "کی امضا می‌کنه؟ امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 239.32,
   "end": 242.5,
   "text": "با آقا صحبت کنید .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 242.5,
   "end": 249.28,
   "text": "و باز برای دل بری کردن از امام عصر در شب‌های قدر رمزش مادرش فاطمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 249.28,
   "end": 256.72,
   "text": "اینو همه فرمودن. هر طور بلدی از امام عصر این شب‌های قدر با مادرش فاطمه دل بری کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 256.72,
   "end": 258.56,
   "text": "بخوای توسط دعای حضرت زهرا بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 258.56,
   "end": 262.56,
   "text": "بخوای نماز استغاثه به مادرش فاطمه زهرا سلام الله علیها بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 262.56,
   "end": 266.3,
   "text": "خیلی آقا خوشش میاد خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 266.3,
   "end": 271.0,
   "text": ". شاید من با این دک پوزم همه شما فکر کنید شب تا صبح میشینم ختم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 271.0,
   "end": 274.5,
   "text": "مفاتیح می‌کنم. نه، من شب‌های قدر باور کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 274.5,
   "end": 280.3,
   "text": "از وقتی خودمو شناختم کار ثابتم نماز استغاثه به حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 280.3,
   "end": 285.46,
   "text": "بعد تو سجده که یا مولات یا فاطمه عقیلینی میگم با یه دستم مُ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 285.46,
   "end": 288.32,
   "text": "با یه دستم تسبیح رو میشکنم با یه دستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 288.32,
   "end": 290.48,
   "text": "مشت، مشت می‌کوبم رو زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 290.48,
   "end": 296.5,
   "text": "واقعاً تصور می‌کنم پشت در خونه حضرت زهرا رو خاک‌ها افتادن دارن در می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 296.5,
   "end": 299.62,
   "text": "نمی‌دونید چه حالی ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 299.62,
   "end": 304.32,
   "text": "نشد به هر حال به امام عصر بگو به مادرت، به فاطنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 304.32,
   "end": 307.58,
   "text": "به ف-به فاطمة، به فاطمة، به فاطمة، به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 307.58,
   "end": 313.02,
   "text": "مگه می‌شه جواب-- آقای بعجت فرمود اگه حرم رفتی راه ندادن دیگه جمله معروفه همه می‌دونین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 313.02,
   "end": 314.68,
   "text": "راه ندادن ول نکن برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 314.68,
   "end": 318.36,
   "text": "دیدید اشکت جاری نمی‌شه؟ چون اذن دخول می‌خواد حرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 318.36,
   "end": 320.48,
   "text": "انکسار و خشوع می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 320.48,
   "end": 323.08,
   "text": "سرتو بذار رو س-- دیوار حرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 323.08,
   "end": 326.42,
   "text": "هی بگو یابن الزهرا، یابن الزهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 326.42,
   "end": 329.38,
   "text": "خوشش میاد از این حرفا بالاخره یه نگاهی بهت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.38,
   "end": 332.1,
   "text": "و اینا رمز و رازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 332.1,
   "end": 334.24,
   "text": "این‌ها خیلی این شب‌ها مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 334.24,
   "end": 336.32,
   "text": "مخصوصاً این روضه خون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 336.32,
   "end": 342.9,
   "text": "زرنگ باشن شده ولو یه اشاره‌ای به روضه حضرت زهرا به کوچه بنی هاشم حضرت زهرا بالاخره داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 342.9,
   "end": 344.6,
   "text": "دیگه تمامه. کار تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 344.6,
   "end": 348.97,
   "text": "من به شما قول میدم کار تمامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 348.97,
   "end": 353.8,
   "text": ". یکی دیگه از توصیه ها از مثلا آقای فاطمیون‌ها براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.8,
   "end": 359.94,
   "text": "ایشون البته یه دستور العملی داریم فارغ از این دستور آقای فاطمیون‌ها، دستور العملی داریم که شب‌های قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 359.94,
   "end": 361.52,
   "text": "اگه کسی حج می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.52,
   "end": 363.76,
   "text": "قطعاً می‌خواد امسال بره حج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 363.76,
   "end": 366.38,
   "text": "این کارو بکنه. دو رکعت نماز بخواند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 366.38,
   "end": 370.96,
   "text": "مثل نماز صبح معمولی بعد تموم شد سر به سجده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.96,
   "end": 375.54,
   "text": "نماز تموم شد سر به سجده هزار بار بگه ماشاالله، ماشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 375.54,
   "end": 378.0,
   "text": "یعنی هرچی خدا بخواد ماشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 378.0,
   "end": 382.18,
   "text": "بعد پاشه دوباره بره به سجده هزار بار بگه ان شا الله، ان شا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 382.18,
   "end": 383.74,
   "text": "یعنی اگر خدا بخواهد اگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.74,
   "end": 389.38,
   "text": "خیلی قشنگه. آقای فاطمی‌نیا می‌فرمودن که اینو دستور صد تایی داده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.38,
   "end": 391.9,
   "text": "اون برای چیه؟ کس که حج می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 391.9,
   "end": 395.26,
   "text": "البته کس که حج می‌خواد یه راه دیگه‌ای هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 395.26,
   "end": 398.12,
   "text": "سوره نبع رو هر رو، هر روز بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.12,
   "end": 400.5,
   "text": "روایت داریم خدا رحمت کنه عمو اعطیتونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 400.5,
   "end": 403.62,
   "text": "خدا مادر ما رو هم ببخشه بیامرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 403.62,
   "end": 407.6,
   "text": "مادر ما خیلی عاشق حج بود تا این روایت رو دید شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 407.6,
   "end": 411.1,
   "text": "باور ن-- باور کنید سال تموم نشده رفت حج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 411.1,
   "end": 414.48,
   "text": "حج واجب. سوره نبع رو خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.48,
   "end": 418.86,
   "text": "سوره نبع روایت داریم تو هر روز بخونی مشرف میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.86,
   "end": 422.0,
   "text": "حالا اینم یه روایته. اگه حج میخوای هزار بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 422.0,
   "end": 427.76,
   "text": "اما آقای فاطمی‌نیا فرمودن اگر آثار عجیب فواید کثیره می‌خوای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 427.76,
   "end": 436.45,
   "text": "شب قدرها، شب قدر، شب‌های قدر مثل امشب صد بار دورکعبت نماز بخون بعد در سجده صد بار بگو ماشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.45,
   "end": 438.8,
   "text": "اینکه دیگه کاری نداره که. خیلی هم طول نمیکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 438.8,
   "end": 442.56,
   "text": "ماشاالله یعنی هرچی خدا بخواد، هرچی خدا بخواد، هرچی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 442.56,
   "end": 446.99,
   "text": "چقدر قشنگه. بعد پاشو برو سجده بگو ان شا الله، ان شا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.99,
   "end": 449.98,
   "text": "یعنی ه-- اگر خدا بخواهد، اگر خدا بخواهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.98,
   "end": 455.06,
   "text": "خیلی قشنگه. آدم عشق بازی کنه با خداش اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 455.06,
   "end": 458.98,
   "text": "یه دستوری هم از آقای فاطمی‌نیا من دیدم تو فضای مجازی پیچیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 458.98,
   "end": 461.08,
   "text": "ما اینو از خود ایشون شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.08,
   "end": 464.9,
   "text": "بعد دیدیم پیچیده. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 464.9,
   "end": 466.54,
   "text": "دستور رو من یه توضیحی بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.54,
   "end": 468.56,
   "text": "فرمودن که خیلی هم با آبه‌تاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.56,
   "end": 473.66,
   "text": "یادتونه آقای فاطمی‌نیا خیلی هر چیزی رو هر جایی هم نمیگفت، هر وقتی هم نمیگفت، به راحتی هم نمیگفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 473.66,
   "end": 476.98,
   "text": "میگفت انجام میدی یا نه؟ بگم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 476.98,
   "end": 480.66,
   "text": "من قسم می‌خورد می‌گفت یه سری در این هست که میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 480.66,
   "end": 483.08,
   "text": "یعنی بر، به راحتی خرج نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 483.08,
   "end": 491.74,
   "text": "بعد فرمود که آقا شب قدر سوره واقعه رو بخون بعد قل هوالله رو بخون بعد هفت بار بگو یا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 491.74,
   "end": 495.44,
   "text": "تمام. حالا من تعبیر خودمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 495.44,
   "end": 500.6,
   "text": "چون یه روایتی داریم اگر کسی صد بار صد تا آیه قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 500.6,
   "end": 502.86,
   "text": "صد تا آیه قرآن بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 502.86,
   "end": 507.14,
   "text": "بعد هفت بار بگه یا الله، هفت بار بگه یا الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 507.14,
   "end": 511.13,
   "text": "بگه و قدرت خدا رو مشاهده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.13,
   "end": 518.02,
   "text": "صد بار. صد تا س-- ببخشید صد بار نه صد تا آیه بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.02,
   "end": 522.07,
   "text": "بعد هفت بار بگه یا الله قدرت الله رو مشاهده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.07,
   "end": 527.26,
   "text": "این حدیثه. احتمال میدم آقای فاطمی‌نیا این منظورش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 527.26,
   "end": 529.96,
   "text": "این روایت بوده. جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 529.96,
   "end": 533.34,
   "text": "بعدش بله بعدش که یا الله گفت حاجتشو بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 533.34,
   "end": 535.64,
   "text": "که این خب اا چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 535.64,
   "end": 541.08,
   "text": "اگر بسم اللهشو در نظر نگیریم نود و شش تا آیه داره واقعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 541.08,
   "end": 545.02,
   "text": "اگر بسم الله قل هوالله رو هم در نظر نگیریم اونم چهار تا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 545.02,
   "end": 547.6,
   "text": "میشه صد تا. همون روایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 547.6,
   "end": 549.26,
   "text": "منتها حالا چرا واقعه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.26,
   "end": 554.98,
   "text": "چرا قل هوالله؟ باید از خ-- از خود آقای فاطمی‌نیا ایشالله ا-ارتباط بگیری از روحش بپرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 554.98,
   "end": 560.02,
   "text": "اما خب این که رو-- سوره توحید قل هوالله اینم که سوره ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 560.02,
   "end": 562.08,
   "text": "توحید و ولایتت کامل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 562.08,
   "end": 566.26,
   "text": "دو، سوره واقعه رو هرکس بخونه جزو غافلین نخواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 566.26,
   "end": 568.54,
   "text": "یعنی شب قدر شما جزو غافلین نخواهی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 568.54,
   "end": 571.2,
   "text": "خیلی خوبه. سه، رزقت زیاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 571.2,
   "end": 574.98,
   "text": "شب ارزاقه. سؤال کرده بودن شب قدر روزیا تقسیم میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 574.98,
   "end": 578.3,
   "text": "بله، همین امشب تقسیم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 578.3,
   "end": 582.46,
   "text": "چ-- بعد نکته‌ی بعد اینکه جزو محبین امیرالمؤمنین محشور میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 582.46,
   "end": 586.04,
   "text": "چیز کمیه واقعه رو بخونی. پس این‌ها رو داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 586.04,
   "end": 588.74,
   "text": "حالا این استنباط خودمو هم در این خصوص عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 588.74,
   "end": 590.74,
   "text": "البته یه روایتی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 590.74,
   "end": 594.62,
   "text": "یا الله، یا الله گفتن. اِمم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 594.62,
   "end": 598.14,
   "text": "شش آیه اول سوره حدید رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 598.14,
   "end": 600.96,
   "text": "چهار آیه آخر سوره حشر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.96,
   "end": 605.84,
   "text": "امیرالمؤمنین علیه الصلاة والسلام فرمود اسم اعظم در این آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 605.84,
   "end": 610.92,
   "text": "اگر کسی حاجت خاصی خواست اینا رو بخونه آخر سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 610.92,
   "end": 614.68,
   "text": "ده بار بگه یا الله. اونجا دیگه ده باره هفت بار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 614.68,
   "end": 621.4,
   "text": "اینم حواستون باشه. من معمولا شب‌هایی که بار خیلی برام سنگینه این دستورالعمل رو انجام میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 621.4,
   "end": 626.86,
   "text": "همین که الان عرض کردم. شش آیه اول سوره حدید به علاوه چهار آیه آخر سوره حشر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 626.86,
   "end": 629.0,
   "text": "لو انزلناه على القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 629.0,
   "end": 631.58,
   "text": "این آ-- تا آخرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 631.58,
   "end": 637.32,
   "text": "بعد ده بار میگم یا الله و میرم بالا منبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 637.32,
   "end": 642.02,
   "text": "و دستورالعمل آقای علامه تهرانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 642.02,
   "end": 648.34,
   "text": "البته توصیه ایشون. علامه تهرانی می‌فرمودن اینکه ليلة القدر خير من الف شهر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 648.34,
   "end": 651.28,
   "text": "یک واقعیت است. یعنی حقیقت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 651.28,
   "end": 654.08,
   "text": "حقیقتا برتر از هزار ماهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 654.08,
   "end": 658.28,
   "text": "نه که اعتبار شده باشه. مبالغه و اغراق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 658.28,
   "end": 663.56,
   "text": "عقبات را از سر راه سالک بر میدارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 663.56,
   "end": 672.1,
   "text": "ال-علامه تهرانی می‌فرمود شب قدر از منت‌های الهی بر امت پیغمبر است تا با عمل کم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 672.1,
   "end": 676.72,
   "text": "سیری سریع و رشدی عالی داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 676.72,
   "end": 682.34,
   "text": "یعنی این نکته شما گفتید می‌خواید دستورالعمل بدید، می‌خوام عرض کنم این خودشه دستوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 682.34,
   "end": 687.92,
   "text": "داره میگه آقا باورت بشه که امشب یعنی با این باور بری تو جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 687.92,
   "end": 695.72,
   "text": "که امشب اصن تو خونه‌تم که هستی نفس نفست اندازه‌ هزار ماهه یعنی یک عمر هشتاد و سه سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 695.72,
   "end": 697.26,
   "text": "شوخیه مگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 697.26,
   "end": 699.76,
   "text": "این باور و داشته باشی با این باور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 699.76,
   "end": 703.1,
   "text": "اگه با شک و شبهه-- یه عزیزی اومد مثلا عمو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 703.1,
   "end": 706.86,
   "text": "همون دستورالعمل فروش ملک رو خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 706.86,
   "end": 709.82,
   "text": "گفت واقعا انجام میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 709.82,
   "end": 714.58,
   "text": "گفتم انجام میده شما. یه کسی که شک داره اصن انجام نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 714.58,
   "end": 717.16,
   "text": "گفت یقین باید-- مگه میشه دروغ به ما بگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 717.16,
   "end": 720.8,
   "text": "استغفرالله خدا صادق الوعده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 720.8,
   "end": 727.32,
   "text": "علامه طباطبایی به حضرت علامه حسن زاده توصیه کرده بودن که از دعای سحر غافل نشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 727.32,
   "end": 731.27,
   "text": "کوتاه هم هست دعای سفر بعد توصیه کرده بودند گفته بودند چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 731.27,
   "end": 733.47,
   "text": "به جهت اینکه علامه طباطبایی به کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 733.47,
   "end": 741.35,
   "text": "علامه حسن زاده فرموده بودند که این توش همش جمال و جلال و نور و علم و عظمت و رحمت و علم الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 741.35,
   "end": 744.81,
   "text": "اصلا از حور و غلمان حرفی نزده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 744.81,
   "end": 747.49,
   "text": "بهشت بهتره یا بهشت آفرین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 747.49,
   "end": 752.07,
   "text": "قطعا بهشت آفرین. برای همین از دعای سفر چون همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 752.07,
   "end": 755.11,
   "text": "نور و رحمت و جمال و جلال الهیه غافل نشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 755.11,
   "end": 759.19,
   "text": "اینم دستورالعمل حضرت علامه طباطبایی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 759.19,
   "end": 763.17,
   "text": "عرض کنم خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 763.17,
   "end": 769.57,
   "text": "یه نکته دیگه هم عرض کنم آقای ملکی تبریزی این رو به عنوان نهیب عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 769.57,
   "end": 776.51,
   "text": "آقای ملکی تبریزی فرموده بودند که البته عذرخواهی می‌کنم شما انشاالله اینطوری نیستید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 776.51,
   "end": 781.69,
   "text": "این محکه. فرموده بودند اگر کسی شب قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 781.69,
   "end": 784.15,
   "text": "حال عبادت نداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 784.15,
   "end": 789.99,
   "text": "یقین کنه که در ایمانش مشکلی ایجاد شده و مریض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 789.99,
   "end": 796.53,
   "text": "مریضی داره. یعنی اگر امشب خدای نکرده زبونم لال میشه مثلا حال عبادت نداریم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 796.53,
   "end": 798.49,
   "text": "نشانه مریضی دله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 798.49,
   "end": 801.13,
   "text": "خب مریض چیکار می‌کنه؟ ختم کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 801.13,
   "end": 805.19,
   "text": "مریض چیکار می‌کنه؟ یه عزیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 805.19,
   "end": 810.57,
   "text": "از شاگردان حضرت علامه رفت تشریف برده بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 810.57,
   "end": 815.39,
   "text": "حرم، علامه طباطبایی. بیرون نمی‌رفتند داخل حرم امام رضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 815.39,
   "end": 819.35,
   "text": "بعد حضرت استاد رو دیده بودند گفته بودند چرا نمیری داخل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 819.35,
   "end": 821.23,
   "text": "فرموده بود من کجا؟ امام معصوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 821.23,
   "end": 823.19,
   "text": "من گرفتارم. مریضَم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 823.19,
   "end": 825.83,
   "text": "من با این دل مریضَم برم محضر آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 825.83,
   "end": 831.97,
   "text": "خیلی جمله جالبیه. ایشون به یادگار از آقای قاضی فرموده بودند مریض پیش کی میره رجوع می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 831.97,
   "end": 836.23,
   "text": "گفته بود پیش طبیب. فرموده بود خب امام رضا هم طبیبه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 836.23,
   "end": 839.13,
   "text": "تو هم که مریضی بفرمایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 839.13,
   "end": 842.95,
   "text": "یعنی چی این کارا؟ اگر تو مریضی او طبیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 842.95,
   "end": 845.63,
   "text": "پس اگر کسی-- اینو میخوام بگم ختم کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 845.63,
   "end": 854.05,
   "text": "اگر کسی خدای نکرده زبونم لال یه همچین شبی احساس کرد حال عبادت نداره یعنی قلبش مریضه باید رجوع کنه به طبیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 854.05,
   "end": 860.49,
   "text": "آقا بشینه خودشو بشکنه مثل یه بچه یتیم بکوبه زمین شروع کنه با امام عصرش حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 860.49,
   "end": 862.97,
   "text": "طبیب هم اونه. غافل از امام عصر نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 862.97,
   "end": 868.03,
   "text": "شده تا صبح با امام زمان حرف بزنه تا انشاالله در باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 868.03,
   "end": 869.83,
   "text": "انشاالله عاقبت-- یاد مام باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 869.83,
   "end": 873.33,
   "text": "ما هم تو رو خدا این شب‌ها دعا کنید بار ما خیلی سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 873.33,
   "end": 876.37,
   "text": "شما می‌شین عشق و حالتون رو می‌کنید ما باید بریم بالا منبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 876.37,
   "end": 882.67,
   "text": "مثلا همه هم با یه امیدی میان و خیلی بار سنگینه باید اونو باورتون نمی‌شه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 882.67,
   "end": 886.45,
   "text": "به خدا این شبای قدر میام خدایا خودت صحبت کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 886.45,
   "end": 892.79,
   "text": "خودت روضه بخون، خودت مناجات کن، خودت گریه کن، خودت ناله کن، خودت زمزمه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 892.79,
   "end": 898.45,
   "text": "اینا رو به خدا میگم. یعنی انقدر بار سنگینه میگم خودت می‌دونی دیگه ما بلد-- ما این کارا نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 898.45,
   "end": 900.91,
   "text": "بعد ببین چه می‌کنه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 900.91,
   "end": 909.53,
   "text": "چه می‌کنه. انشاالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد. اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}