 "chapters": [
  {
   "index": 0,
   "title": "## هدیه‌ای از استادی بنام",
   "start": 31.64,
   "end": 51.82
  },
  {
   "index": 1,
   "title": "## خواهش بیست‌سالگی: علمی که خدا به زور عطا کند",
   "start": 51.82,
   "end": 72.63
  },
  {
   "index": 2,
   "title": "## دستورالعمل: آیة‌الکرسی پس از تسبیحات حضرت زهرا",
   "start": 72.63,
   "end": 289.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.66,
   "end": 7.74,
   "text": "محضر یک انسان الهی، دهن یک انسان الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.74,
   "end": 12.38,
   "text": "و یک آدم کامل متصرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.38,
   "end": 14.64,
   "text": "این‌ها خیلی کار میدسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.64,
   "end": 19.66,
   "text": "بعضی از نفوس که مستعد باشند، زحمت کشیده باشند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.66,
   "end": 27.14,
   "text": "تشنه و طالب باشند به معیار و ملاکی را که اولیا در دست دارند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.14,
   "end": 31.64,
   "text": "این‌ها را به تصرفی دگرگون می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.64,
   "end": 39.52,
   "text": "یکی از اساتید خیلی به نام و بزرگی که ما درکشون کردیم یه هدیه‌ای به ما تقدیم کردن که ایشون ارتباط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.52,
   "end": 43.8,
   "text": "با امام عصر هم داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.8,
   "end": 46.96,
   "text": "و نوزده سال هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.96,
   "end": 55.5,
   "text": "پیش امام جماعت حرم حضرت ابالفضل صلوات الله عليه بودن، قریبه به بیست سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 55.5,
   "end": 57.58,
   "text": "خیلی ما از ایشون بهره بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.58,
   "end": 60.7,
   "text": "من حدوداً بیست سالم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.7,
   "end": 72.63,
   "text": "از ایشون، خودم بودم و ایشون از ایشون خواهش کردم که یه راهی به بنده یاد بدید خدا به زور به من علم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 72.63,
   "end": 75.08,
   "text": "شما دوست دارید، نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 75.08,
   "end": 78.8,
   "text": "دوست دارید، نه واقعاً؟ به زور خدا بهت علم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 78.8,
   "end": 82.36,
   "text": "یعنی خودت یهو به خودت ببینی اِاِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.36,
   "end": 89.4,
   "text": "اصلاً شاید خودتم استنکاف می‌کردی اما خدا داره تزریق می‌کنه بهت از در و دیوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 89.4,
   "end": 93.6,
   "text": "این دستورالعمل رو از حدود سی سال پیش بنده انجام دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 93.6,
   "end": 97.98,
   "text": "خیلی هم آسونه و همه هم شاید دارید انجام میدید ولی بی‌خبرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.98,
   "end": 101.14,
   "text": "شاید یک سر از این جلسه همون باشه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.14,
   "end": 108.44,
   "text": "شما دارید انجام میدید این جلسه رو گذاشتن که به شما تزریق علم کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 108.44,
   "end": 115.42,
   "text": "ما انجام دادیم و خودم تجربه در تجربه شخصی خودم دیدم این رو واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 115.42,
   "end": 121.62,
   "text": "چشیدم، بهش رسیدم. لذا چیزی که خودم چشیدم چرا از شما دریغ کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 121.62,
   "end": 126.14,
   "text": "فرمودن که بعد از هر نماز واجب‌تون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 126.14,
   "end": 131.12,
   "text": "بعد از تسبیحات حضرت صدیقه شهیده سلام الله علیها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 131.12,
   "end": 134.36,
   "text": "آیه الکرسی رو قرائت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 134.36,
   "end": 140.86,
   "text": "به همین راحتی. کسی که این کار رو مداومت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 140.86,
   "end": 144.06,
   "text": "خدا ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 144.06,
   "end": 147.78,
   "text": "کفیل او میشه از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 147.78,
   "end": 154.38,
   "text": "تعلیم علم. یه خاطره کوچولو بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 154.38,
   "end": 163.22,
   "text": "که نیمه نیمچه این خاطره رو فعلاً نصفش طلبتون که انشاالله با هم رفیق‌تر شدیم کاملش رو براتون میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 163.22,
   "end": 165.2,
   "text": "محضر علامه بودیم یه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 165.2,
   "end": 167.32,
   "text": "در اتاق شخصیشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 167.32,
   "end": 172.54,
   "text": "اون اتاقی که شاید نمی‌دونم رفتید یا نه، دور تا دورش خ-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 172.54,
   "end": 176.68,
   "text": "کتاب‌های دست‌نویس دست‌نویس خودشان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 176.68,
   "end": 180.86,
   "text": "با سه چهار تا طلبه و دانشجو منتها رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 180.86,
   "end": 184.9,
   "text": "همه حرف می‌زدن. همه سؤال می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 184.9,
   "end": 188.96,
   "text": "همه مزاحم علامه بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 188.96,
   "end": 191.86,
   "text": "تنها کسی که ساکت بود بنده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 191.86,
   "end": 193.9,
   "text": "من فقط ایشون رو نگاه می‌کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 193.9,
   "end": 198.38,
   "text": "و لذت می‌بردم. هیچی، هیچی فقط اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 198.38,
   "end": 200.68,
   "text": "از من ظهور می‌کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 200.68,
   "end": 202.58,
   "text": "عطش وجودی بود. با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 202.58,
   "end": 205.66,
   "text": "تشنگی علامه رو نگاه می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 205.66,
   "end": 211.34,
   "text": "سر تا پای علامه رو مثل یه آدم تشنه‌ای که به آب رسیده نگاه می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 211.34,
   "end": 214.56,
   "text": "شاید ایشون اینو درک کرد. نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 214.56,
   "end": 217.54,
   "text": "دست منو ایشون گرفت گفت یه کاری باهات می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.54,
   "end": 220.12,
   "text": "نری کسی رو ورداری بیاری بگی این کارو باهاش بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 220.12,
   "end": 222.96,
   "text": "گفتم چشم. رنگم هم پرید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 222.96,
   "end": 226.74,
   "text": "خلاصه یه کاری با ما کرد ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 226.74,
   "end": 228.78,
   "text": "اون کارا بماند فعلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.78,
   "end": 232.24,
   "text": "هدیه شما باشه فعلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.24,
   "end": 237.84,
   "text": "اون در-- اون کاری که علامه کرد و بعد از اون لطف ایشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.84,
   "end": 245.4,
   "text": "من یه چیزکی دیدم دارم می‌فهمم از همین مباحث سنگین و پیچیده حکمت و عرفان رو و شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 245.4,
   "end": 252.28,
   "text": "یه وجه اینکه بعضیا به من میگن شما اون مسائل خیلی سنگین و عرشی رو که ما از هر کی می‌شنویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 252.28,
   "end": 257.72,
   "text": "گیج می‌شیم و به زبان ساده بیان می‌کنی و اون لطف علامه بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 257.72,
   "end": 260.44,
   "text": "اون در ادامه همین بود، همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 260.44,
   "end": 263.62,
   "text": "همین دستورالعملی که الان به شما عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 263.62,
   "end": 267.14,
   "text": "یعنی برکت این بود. نترسید همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 267.14,
   "end": 270.94,
   "text": "شما این کارو انجام بده بعد ببین خدا باهات چه کار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 270.94,
   "end": 273.62,
   "text": "یه علامه‌ای رو پیدا می‌کنه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 273.62,
   "end": 279.84,
   "text": "که دستتو بگیره همون بلا رو سرت بیاره که سر ما آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 279.84,
   "end": 282.04,
   "text": "ها؟ این هدیه خیلی هدیه قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 282.04,
   "end": 284.84,
   "text": "کم نگیرید اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.84,
   "end": 289.17,
   "text": "یه صلوات هدیه کنید. اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}