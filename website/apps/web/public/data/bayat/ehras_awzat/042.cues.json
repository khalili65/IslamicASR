   "start": 0.84,
   "end": 20.86
  },
  {
   "index": 1,
   "title": "## ازدیاد فهم",
   "start": 20.86,
   "end": 40.94
  },
  {
   "index": 2,
   "title": "## ازدیاد الهامات از عالم قدس",
   "start": 40.94,
   "end": 85.04
  },
  {
   "index": 3,
   "title": "## سفارش در کتاب تهذیب",
   "start": 85.04,
   "end": 127.88
  },
  {
   "index": 4,
   "title": "آغاز دعا درخواست روزی است: خدایا روزی من کن.",
   "start": 127.88,
   "end": 182.46
  },
  {
   "index": 5,
   "title": "## زمان و محل قرائت",
   "start": 182.46,
   "end": 217.1
  },
  {
   "index": 6,
   "title": "## تهذیب در کتب اربعه",
   "start": 217.1,
   "end": 247.64
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.84,
   "end": 5.12,
   "text": "یکی از ادعیه‌ای که مورد سفارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.12,
   "end": 8.02,
   "text": "شیخ بهایی علیه الرحمه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.02,
   "end": 12.02,
   "text": "برای سه تا کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.02,
   "end": 15.42,
   "text": "یکی ازدیاد فهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.42,
   "end": 20.08,
   "text": "بالاخره شما که در جلسات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.08,
   "end": 25.8,
   "text": "معرفتی شرکت می‌کنید نیاز به ازدیاد فهم دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.8,
   "end": 35.26,
   "text": "دومیش حفظ زیاته یعنی آدم بتونه فراموشیش کم بشه و حفظ زیاتش زیاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.26,
   "end": 39.5,
   "text": "اونچه که در خزانه عقلش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.5,
   "end": 43.58,
   "text": "اصطلاحا بهش میگیم قوه حافظه داره این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.58,
   "end": 46.12,
   "text": "داشته باشه از دست نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.12,
   "end": 50.5,
   "text": "سومیش هم ازدیاد الهاماته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.5,
   "end": 52.98,
   "text": "الهامات از عالم قدس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.98,
   "end": 58.78,
   "text": "از عالم عقول، از سمت و ناحیه وسائط فیض که ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.78,
   "end": 63.26,
   "text": "مقرب‌اند. قبلاً هم یه چیزکی پیرامون الهام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.26,
   "end": 65.88,
   "text": "و فرقش با اعلام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.88,
   "end": 69.04,
   "text": "القا و ایحاء عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.04,
   "end": 74.62,
   "text": "الهام خیلی مهمه. پس این سه تا پیامد رو این دعا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.62,
   "end": 78.16,
   "text": "هرچند زمان خاصی هم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.16,
   "end": 84.26,
   "text": "هر وقت دوست دارید و هر مقدار تعدادی که براتون میسر بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.26,
   "end": 90.0,
   "text": "به سفارش شیخ بهایی این دعا رو قرائت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.0,
   "end": 95.85,
   "text": "بله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.85,
   "end": 100.34,
   "text": "هنوز دعا رو نخوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.34,
   "end": 109.36,
   "text": "شیخ بهایی فرمودن در کتاب تهذیب اگر خواستید نگاه کنید، کتاب تهذیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 109.36,
   "end": 112.16,
   "text": "سفارش ایشون وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.16,
   "end": 117.6,
   "text": "عرض کردیم سه تا پیامد داره. اصلاً تو خود متن دعا هست اجازه بدید من متن دعا رو بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.6,
   "end": 120.92,
   "text": "متوجه میشید که پیامدهای این دعا چی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.92,
   "end": 127.68,
   "text": "برای شما خیلی مهمن. \"اللهم مرزقنی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.68,
   "end": 131.58,
   "text": "یعنی خدایا روزی من کن. \"اللهم مرزقنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.58,
   "end": 138.22,
   "text": "فهم النبیین\" فهم انبیا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.22,
   "end": 142.6,
   "text": "\"وحفظ المرسلین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 142.6,
   "end": 145.84,
   "text": "اون حفظ ماندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.84,
   "end": 149.94,
   "text": "علوم که برای مرسلین اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 149.94,
   "end": 154.06,
   "text": "یه رتبه بالاتر از انبیا هستن اون رو هم به من عطا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 154.06,
   "end": 157.22,
   "text": "کن \"وحفظ المرسلین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.22,
   "end": 159.12,
   "text": "و سومیش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.12,
   "end": 166.32,
   "text": "الهام بود دیگه \"والهام الملائکت المقربین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.32,
   "end": 168.98,
   "text": "اونم نه هر ملکی، ملائکه مقرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.98,
   "end": 177.7,
   "text": "از اونجا از عالم قدس به من الهام بشه \"والهام الملائکت المقربین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 177.7,
   "end": 179.86,
   "text": "آمین یا رب العالمین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 179.86,
   "end": 182.46,
   "text": "چقدر کوتاه، پرمغز، عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.46,
   "end": 188.4,
   "text": "هر وقت حالش داشتید، حال خوشی بهتون دست داد، حرم می‌رفتید بعد از نمازاتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.4,
   "end": 192.78,
   "text": "این دعا رو داشته باشید حتی قبل از شروع جلسات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.78,
   "end": 194.9,
   "text": "درس و بحث می‌تونید این رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.9,
   "end": 199.94,
   "text": "من الان بعد از نماز خودم ده بار خوندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.94,
   "end": 205.64,
   "text": ". انشاالله که آثار و برکاتش وجود همه ما رو پر کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.64,
   "end": 214.84,
   "text": "به فضل الهی بتونیم بهره‌مند بشیم از این سه پیامد این دعای گران سنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 214.84,
   "end": 219.18,
   "text": "جان؟ جان؟ کتاب تهذیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 219.18,
   "end": 224.46,
   "text": "تهذیب. جزو كتب اربعه شیعه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 224.46,
   "end": 228.38,
   "text": "تهذیب ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 228.38,
   "end": 232.16,
   "text": "استبصار، من لا یهضره الفقیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 232.16,
   "end": 237.06,
   "text": "کافی. اینا كتب اربعه شیعه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 237.06,
   "end": 241.48,
   "text": "تهذیب مال کیه؟ التهذیب شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 241.48,
   "end": 244.8,
   "text": "آفرین طوسی علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 244.8,
   "end": 247.64,
   "text": "یکی از بهترین کتاب‌های ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}