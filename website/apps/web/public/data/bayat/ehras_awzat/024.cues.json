  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.04,
   "end": 8.62,
   "text": "یا رب اعوذ بهک من همزات الشیاطین و من شر نفسي و من شر خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.62,
   "end": 10.78,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.78,
   "end": 15.98,
   "text": "لا حول ولا قوة الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.98,
   "end": 21.64,
   "text": "اللهم ایاک نعبد وایاک نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.64,
   "end": 27.58,
   "text": "الحمد لله على کل نعمه واسأل الله من فضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.58,
   "end": 32.02,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.02,
   "end": 37.9,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.9,
   "end": 49.06,
   "text": "در محضر پنج شهید خوشنام هستیم روحشون شاد باشه و همه ما رو انشاالله دعا کنن صلواتی ختم بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 49.06,
   "end": 54.22,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 54.22,
   "end": 56.84,
   "text": "خب اجازه بدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 56.84,
   "end": 60.82,
   "text": "ابتدا هدیه‌مون رو تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 60.82,
   "end": 63.68,
   "text": "دو جلسه پیش ما پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.68,
   "end": 66.6,
   "text": "اهمیت آیه الکرسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.6,
   "end": 74.88,
   "text": "دو تا نکته گفتیم که خیلی حائز اهمیت بود و به درد شما درس‌آموزان و حکمت‌آموزان می‌خوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 74.88,
   "end": 79.9,
   "text": "می‌خورد. امروز تکمیلش کنیم با یک روایت عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 79.9,
   "end": 84.54,
   "text": "این روایت رو عزیزانی هم که داخل کلاس نیستن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 84.54,
   "end": 89.08,
   "text": "نماز تموم شده و دارن تعقیبات می‌خونن و می‌خوان تشریف ببرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 89.08,
   "end": 91.28,
   "text": "این روایت رو گوش بدن بعد تشریف ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.28,
   "end": 98.3,
   "text": "خیلی روایت عجیبیه. اگر چنانچه خاطرتون باشه ما در خصوص ثواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 98.3,
   "end": 105.06,
   "text": "گفتیم اینکه میگه فلان کار رو انجام بده این ثواب رو داره یعنی تأثیری که نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 105.06,
   "end": 114.64,
   "text": "می‌گیره از اون عمل، نه اینکه یه گوشه‌ای از پرونده‌ای یه چیزی برای شما بیرون از وجود شما بنویسن، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 114.64,
   "end": 118.86,
   "text": "ن-- با توجه به این موضوع حالا روایت رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 118.86,
   "end": 122.0,
   "text": "یک عملی هست که البته شما می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 122.0,
   "end": 129.02,
   "text": "آنچه که بنده در قالب هدایا به شما تقدیم می‌کنم هدایایی‌ست که به یادگار از بزرگان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 129.02,
   "end": 131.04,
   "text": "بزرگان اهل معرفت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 131.04,
   "end": 133.18,
   "text": "استوانه‌های توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 133.18,
   "end": 137.62,
   "text": "مثل علامه حسن زاده، مثل آقای بهجت ها و امثالهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 137.62,
   "end": 143.16,
   "text": "تقدیم می‌کنم. البته سند داره، منبع داره، ماخذ داره، عرض می‌کنم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 143.16,
   "end": 146.38,
   "text": "چاشنیش هم اینه که خود بنده تجربه‌ش کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 146.38,
   "end": 150.1,
   "text": "چیزی رو تجربه نکرده باشم خدمت شما عرض نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 150.1,
   "end": 153.0,
   "text": "اینم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 153.0,
   "end": 161.52,
   "text": "در حقیقت، اه، دستورات بزرگانمون و اساتیدمون بوده تا چیزی رو خودت نچشیدی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 161.52,
   "end": 171.82,
   "text": "عمل نکردی نگو. این روایت رو مرحوم مجلسی در بهار جلد هشتاد و هفت صفحه سیصد و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 171.82,
   "end": 173.58,
   "text": "آوردن خواستید مراجعه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 173.58,
   "end": 177.02,
   "text": "شیخ صدوق هم این رو بیان فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 177.02,
   "end": 179.7,
   "text": "پیامبر عظیم الشأن اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 179.7,
   "end": 182.62,
   "text": "صلی الله علیه و آله و سلم-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 182.62,
   "end": 185.48,
   "text": "صلی الله علیه و سلم، صلی الله علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 185.48,
   "end": 187.18,
   "text": "و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 187.18,
   "end": 189.4,
   "text": "یک دستور العمل رو دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 189.4,
   "end": 195.06,
   "text": "که دوازده اثر بر این دستور رو پیغمبر فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 195.06,
   "end": 202.36,
   "text": "توجه داشته باشید باز نسبت به سیر بحث‌هایی که قبلاً گذشت عرض کردیم این یعنی آثاری که در نفس داره یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 202.36,
   "end": 206.0,
   "text": "دو به قدر عقول بشری این رو بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 206.0,
   "end": 208.9,
   "text": "یعنی این نیست که حدش همین میزان باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.9,
   "end": 213.44,
   "text": "قطعاً تاثیرات شگفت و بیشتری از این داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 213.44,
   "end": 218.88,
   "text": "مردمی که حالا چه اون موقع می‌شنیدن، چه بعدها مثل الان ما به ما می‌رسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 218.88,
   "end": 225.36,
   "text": "عقلمون بیشتر از این گنجایش نداشت که پیغمبر بیشتر از این پرده‌برداری کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 225.36,
   "end": 230.56,
   "text": "اینم نکته دوم. نکته سوم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 230.56,
   "end": 233.24,
   "text": "به عظمت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 233.24,
   "end": 235.98,
   "text": "مکان مقدس یعنی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 235.98,
   "end": 248.66,
   "text": "عظمت این مکان مقدس رو شاهد می‌گیرم که هر بندی که پیغمبر از اثر این عمل گفته یک منبر می‌خواد که یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 248.66,
   "end": 254.95,
   "text": "شما که می‌دونید بنده هم اصلا اهل معرکه گیری و غزاف گویی و اغراق نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 254.95,
   "end": 263.48,
   "text": "واقعا اینطوری هست. البته یه بی‌سوادی مثل من یک منبر، یه باسواد سی منبر با هر بخشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 263.48,
   "end": 270.76,
   "text": "حالا چون جلسه ما این نیست که جلسه ما معرفت نفسه سریع ازش رد می‌شیم، توضیح هم نمی‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 270.76,
   "end": 277.7,
   "text": "آنچه که بنده تجربه کردم رو با اجازه از پیغمبر عزیز عالم به شما عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 277.7,
   "end": 283.22,
   "text": "قابل توجه عزیزانی که صاحب تریبون و منبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 283.22,
   "end": 290.22,
   "text": "درس و تعلیم و تربیت و شاگرد و بالاخره این‌ها هستند، سخنرانند و مداح‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 290.22,
   "end": 296.54,
   "text": "یا یه مدیر یه بخش‌اند. این‌ها بالاخره می‌خوان تأثیر داشته باشه کلامشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 296.54,
   "end": 305.14,
   "text": "چیزی که بنده در کنار همه این فرمایشات پیغمبر دیدم از اثر مداومت بر این دستور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 305.14,
   "end": 307.5,
   "text": "همین بود. اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 307.5,
   "end": 310.98,
   "text": "کلام، تأثیر کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 310.98,
   "end": 318.7,
   "text": "من به دوستان خیلی نزدیکم که برام خیلی عزیز بودن این اولین باره من دارم عموما این رو بیان می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 318.7,
   "end": 321.08,
   "text": "البته عمومی که نیست چون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 321.08,
   "end": 329.66,
   "text": "صوت‌ها بیرون قرار نیست بره و خود شما هم فعلا بنا نداریم بدیم چه برسه بیرون و به هر حال اولین باره به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 329.66,
   "end": 333.54,
   "text": "می‌دادم به دوستانی که مثلا طرف روضه خون بود می‌گفت می‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 333.54,
   "end": 336.92,
   "text": "روضه می‌خونم اثر کنه. این کار رو انجام داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 336.92,
   "end": 340.18,
   "text": "حالا اون آثاری که پیغمبر گفتن تندتند من بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 340.18,
   "end": 343.84,
   "text": "دیگه توضیح ندم. اول فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 343.84,
   "end": 348.46,
   "text": "هنوز از جاش برنخیزیده، یعنی بلند نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 348.46,
   "end": 352.92,
   "text": "از جایش برنمی‌خیزد الا اینکه خدا او را می‌آمرزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 352.92,
   "end": 357.48,
   "text": "چیز کمیه؟ خدا آدمو ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 357.48,
   "end": 360.5,
   "text": "دو: ثواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 360.5,
   "end": 365.15,
   "text": "حالا ثواب رو توجه داشته باشید که چی گفتیم، معنای ثواب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 365.15,
   "end": 367.69,
   "text": "در سیر حکمت چی گفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 367.69,
   "end": 369.95,
   "text": "ثواب شهدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 369.95,
   "end": 373.71,
   "text": "امت مرا تا روز قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 373.71,
   "end": 376.35,
   "text": "برای او قرار می‌دهد. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 376.35,
   "end": 379.75,
   "text": "این همه شهید تا روز قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 379.75,
   "end": 382.21,
   "text": "یکیش حاج قاسم سلیمانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 382.21,
   "end": 384.57,
   "text": "ثواب همه اینا. عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 384.57,
   "end": 394.45,
   "text": "دو. سه. فرمود برای او ثواب صد حجر و صد عمره قرار می‌دهد خدای ممنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 394.45,
   "end": 396.13,
   "text": "صد حجر صد عمره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 396.13,
   "end": 398.83,
   "text": "بعد رفت آثار حجر رو بررسی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 398.83,
   "end": 402.27,
   "text": "الله اکبر. چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 402.27,
   "end": 405.25,
   "text": "به اندازه سوره‌های قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 405.25,
   "end": 410.47,
   "text": "در بهشت به او شهر عطا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 410.47,
   "end": 416.73,
   "text": "شهر نه قصر. صد و چهارده شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 416.73,
   "end": 420.01,
   "text": "عجب! شاید یکی بگه آقا به چه درد ما می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 420.01,
   "end": 422.75,
   "text": "یه ق-- یه شهر نه یه قصر بس ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 422.75,
   "end": 426.31,
   "text": "میگیم آقا تو بعد-- رحم مادر که بودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 426.31,
   "end": 431.81,
   "text": "بهت می‌گفتن بیا یه همچین دنیای با عظمتی، می‌گفتی ولم کن آقا همینجا جام خوبه، خوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 431.81,
   "end": 434.91,
   "text": "اصلاً نمی‌تونستی تصور کنی این عالم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 434.91,
   "end": 439.05,
   "text": "حالا که اومدی تو این دنیا کره مریخ هم بهت بدن کمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 439.05,
   "end": 443.23,
   "text": "اونجا هم اینطوریه. سر خودمون رو کلا نذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 443.23,
   "end": 446.41,
   "text": "پس صد و چهارده شهر در بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 446.41,
   "end": 452.97,
   "text": "پنج. هزار فرشته را مأمور می‌کند خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 452.97,
   "end": 458.87,
   "text": "مأموریتشون چیه؟ تا روز قیامت برای او حسنات می‌نویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 458.87,
   "end": 463.19,
   "text": "یعنی همینطوری شروع می‌کنند هزار فرشته د بنویس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 463.19,
   "end": 465.91,
   "text": "تا روز قیامت. حسنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 465.91,
   "end": 468.87,
   "text": "حالا این حسنات باز نسبت به نفس طرفه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 468.87,
   "end": 470.95,
   "text": "اینم جای بحث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 470.95,
   "end": 475.15,
   "text": "شش. از دنیا خارج نمی‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 475.15,
   "end": 479.25,
   "text": "مگر اینکه جایگاه خود را در بهشت ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 479.25,
   "end": 481.77,
   "text": "این یعنی میفته به شهود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 481.77,
   "end": 487.01,
   "text": "بالاتر از کشف. هفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 487.01,
   "end": 492.05,
   "text": "مانند آن است، این مانند آن است کار ما رو آسون کرده پیغمبر فرمود مانند آن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 492.05,
   "end": 499.51,
   "text": "یعنی همون اثری که در نفس میذاره مثل این می‌مونه که صد بار دور خانه خدا طواف کرده باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 499.51,
   "end": 504.39,
   "text": "چه اثری در نفس داره؟ ببین چه اثری می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 504.39,
   "end": 510.53,
   "text": "هشت. مانند آن است که صد بنده را آزاد کرده باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 510.53,
   "end": 514.13,
   "text": "نه. حالا دارید می‌نویسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 514.13,
   "end": 517.63,
   "text": "من با تأمل ب-بخونم که اذیتم نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 517.63,
   "end": 524.81,
   "text": "نه. از جاش برنمی‌خیزه چنین کسی الا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 524.81,
   "end": 527.33,
   "text": "خیلی شیرینه این قسمت خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 527.33,
   "end": 534.41,
   "text": "کیف کردم و جالبه که شما بدونید من قبل از اینکه روایتو ببینم این عمل رو چندین سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 534.41,
   "end": 539.07,
   "text": "از یکی از اساتیدمون بیادگار داشتم در گوشی هم به ما گفته بود انجام می‌دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 539.07,
   "end": 543.41,
   "text": "بعد اخیراً این روایتو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 543.41,
   "end": 547.01,
   "text": "برام خیلی جالب‌تر بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 547.01,
   "end": 555.69,
   "text": "فرمود از جاش برنخیزد الا اینکه خداوند هزااار رحمت را به سویش می‌فرستد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 555.69,
   "end": 557.97,
   "text": "رحمت. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 557.97,
   "end": 563.03,
   "text": "حالا اینکه ان فی ایام ده-- ان فی ایام دهرکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 563.03,
   "end": 576.05,
   "text": "نفحات. حضرت فرمود ان لله فی ایام در دهرکم از الله این رحمت اسم بوی الله داره یعنی جامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 576.05,
   "end": 583.07,
   "text": "فتعرضوا لها. بوی جامع میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 583.07,
   "end": 588.51,
   "text": "خب ده. از جاش برنمی‌خیزد الا اینکه دعایش مستجاب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 588.51,
   "end": 591.43,
   "text": "چقدر ما هی میگیم آقا حاج آقا برا ما دعا کن دعا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 591.43,
   "end": 596.15,
   "text": "دعای خودت مستجاب میشه. حالا یه سری چیزا هست دعای ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 596.15,
   "end": 601.13,
   "text": "یه سری چیزا هست طلب وجود ماست، خواستگاه ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 601.13,
   "end": 604.91,
   "text": "تبدیل به دعا نشده. یعنی ما به زبان نیاوردیم ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 604.91,
   "end": 608.27,
   "text": "دلمون اینو می‌خواد. به اون میگن خواسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 608.27,
   "end": 611.09,
   "text": "فرق بین دعا و خواسته رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 611.09,
   "end": 614.63,
   "text": "چون قسمت بعدی پیغمبر می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 614.63,
   "end": 621.27,
   "text": "باز از جاش برنمی‌خیزه الا اینکه خواسته‌ش برآورده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 621.27,
   "end": 625.05,
   "text": "یعنی طلبش رو خدا بهش میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 625.05,
   "end": 630.03,
   "text": "و آخریش و دوازدهمیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 630.03,
   "end": 634.37,
   "text": "ده دعاش مستجاب، یازده خواسته‌ش برآورده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 634.37,
   "end": 637.39,
   "text": "دوازدهمیش ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 637.39,
   "end": 644.53,
   "text": "فرمود بر هر سجده‌ای که انجام داده است به هر سجده‌ای به خاطر هر سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 644.53,
   "end": 647.95,
   "text": "خداوند ثواب، چقدر بهش بده خوبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 647.95,
   "end": 653.99,
   "text": "برای هر سجده. همون ثوابی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 653.99,
   "end": 656.73,
   "text": "تسویه حضرت زهرا رو میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 656.73,
   "end": 659.05,
   "text": "هزار رکعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 659.05,
   "end": 663.09,
   "text": "نماز مستحبی برای هر اون سجده‌ای که انجام داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 663.09,
   "end": 666.25,
   "text": "الله اکبر. عجب خدایی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 666.25,
   "end": 668.63,
   "text": "ببین این چه عملیه که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 668.63,
   "end": 672.65,
   "text": "این چه عملیه؟ بگم یا نگم به نظرتون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 672.65,
   "end": 675.79,
   "text": "یا تو خماری بذارمتون رد شم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 675.79,
   "end": 682.35,
   "text": "چون همکارمون من عادت دارم قبل اینکه مسائل مهمو بگم یه ذره مزه مزه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 682.35,
   "end": 684.81,
   "text": "به همکارمون تو اتاق گفتیم امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 684.81,
   "end": 688.93,
   "text": "که مزه مزه کنیم بعد ایشون خیلی برافروخته و خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 688.93,
   "end": 690.71,
   "text": "مترصد بود که این چه عملیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 690.71,
   "end": 697.17,
   "text": "گفتم باشه طلبه بنده خدا هم تو خماری مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 697.17,
   "end": 701.41,
   "text": "حالا شما رو اذیت نکنیم چون شاید تا جلسه بعد ما زنده باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 701.41,
   "end": 706.15,
   "text": "جان؟ بعد از نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 706.15,
   "end": 709.58,
   "text": "چطور؟ دو تا سجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 709.58,
   "end": 714.49,
   "text": "دو تا سجده توش داره بله. حالا خدمتتون عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 714.49,
   "end": 719.99,
   "text": "بعد از، این دستور اول مخصوصه بعد از نماز وتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 719.99,
   "end": 722.59,
   "text": "نماز وتر رو که خوندید انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 722.59,
   "end": 726.21,
   "text": "اینم نباشه که بگید حالا ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 726.21,
   "end": 730.57,
   "text": "دائم نمی‌تونیم بخونیم چون از چهره‌های بعضیاشون می‌خونم من این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 730.57,
   "end": 733.69,
   "text": "حرف رو، این زبان حال رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 733.69,
   "end": 739.05,
   "text": "که آقا ما که مثلا تا گفتم وتر یهو یه سری وا رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 739.05,
   "end": 746.67,
   "text": "نه اگر حالش شده ماهی یه بارم اگر شده این کارو انجام بدید و الا اذان رو هم داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 746.67,
   "end": 751.57,
   "text": "باز انجام بدید. چون بعضیا فکر میکنن اذان داد دیگه نمازها رو باید ول کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 751.57,
   "end": 757.25,
   "text": "نه، اگر دو تا دو رکعتی رو قبل از اذان صبح خونده باشی دیگه بقیش اداست قضا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 757.25,
   "end": 761.43,
   "text": "یعنی شما میتونی بقیه رو بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 761.43,
   "end": 766.49,
   "text": "بعد از نماز وتر تسبیحات حضرت زهرا سلام الله علیها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 766.49,
   "end": 771.33,
   "text": "انجام میدی. بعد میری به سجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 771.33,
   "end": 773.51,
   "text": "پنج مرتبه این ذکر رو میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 773.51,
   "end": 776.89,
   "text": "سبوح قدوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 776.89,
   "end": 782.43,
   "text": "رب الملائكة والروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 782.43,
   "end": 785.21,
   "text": "سبوح قدوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 785.21,
   "end": 787.53,
   "text": "رب الملائكة والروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 787.53,
   "end": 790.09,
   "text": "حالا درون مایه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 790.09,
   "end": 796.61,
   "text": "ذکر چه خبره تو روایات و آیات اصلاً آدم میمونه تو عظمت این ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 796.61,
   "end": 801.59,
   "text": "پنج بار. پا میشی میشینی آیه الکرسی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 801.59,
   "end": 804.41,
   "text": "یعنی سه جم-سومین جلسه‌ست که ما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 804.41,
   "end": 812.67,
   "text": "آیه الکرسی داریم حرف میزنیم. آیه الکرسی رو میخونی دو مرتبه میری به سجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 812.67,
   "end": 821.49,
   "text": "اون دستور اول اللهم احفظ حدقتیه بحق حدقتی علی بن ابی طالب اینم میتونی بهش چاشنی اضافه بش اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 821.49,
   "end": 828.67,
   "text": "دیگه خود اهل بیت فرمودن. آیه الکرسی رو خوندی دو مرتبه میری به سجده پنج بار دوباره همون ذکر رو میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 828.67,
   "end": 832.33,
   "text": "سبوح قدوس رب الملائكة والروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 832.33,
   "end": 840.65,
   "text": "توجه داشته باشید که در بعضی از منابع یه دستور دیگه‌ای بعد از نماز وتر هست، طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 840.65,
   "end": 844.01,
   "text": "این ذکر به این شکل اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 844.01,
   "end": 849.85,
   "text": "پنج بارم سبوح قدوس ربنا ورب الملائكة با اون قاطی نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 849.85,
   "end": 854.07,
   "text": "اون یه دستور دیگه‌ست با آثار دیگه طولانی‌تر هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 854.07,
   "end": 858.85,
   "text": "این یه دستور دیگه. خب یه صلوات تقدیم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 858.85,
   "end": 863.29,
   "text": "اللهم صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}