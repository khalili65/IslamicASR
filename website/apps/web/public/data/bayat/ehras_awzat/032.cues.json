   "start": 2.76,
   "end": 41.95
  },
  {
   "index": 1,
   "title": "## رجوع به اهل علم و زیارت عالم آل محمد",
   "start": 41.95,
   "end": 77.24
  },
  {
   "index": 2,
   "title": "## قرب به مضجع شریف",
   "start": 77.24,
   "end": 104.9
  },
  {
   "index": 3,
   "title": "## دو اسم: العلیم و الحکیم",
   "start": 104.9,
   "end": 179.56
  },
  {
   "index": 4,
   "title": "## عدد ابجد؛ روح الفاظ",
   "start": 179.56,
   "end": 237.54
  },
  {
   "index": 5,
   "title": "## کشیدنِ اسم و سرّ حال",
   "start": 237.54,
   "end": 257.8
  },
  {
   "index": 6,
   "title": "## انسان کامل؛ واسطهٔ فیض نه فقط رفع حاجت",
   "start": 257.8,
   "end": 321.14
  },
  {
   "index": 7,
   "title": "## قوس نزول و قوس صعود",
   "start": 321.14,
   "end": 515.73
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.76,
   "end": 4.72,
   "text": "یکی از مهمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.72,
   "end": 9.94,
   "text": "شما عزیزان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.94,
   "end": 18.86,
   "text": "در مسیر کسب علم و معرفت و دانش و حکمت هستید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.86,
   "end": 26.46,
   "text": "اینه که خودتون به داد خودتون برسید و سهل الوصول کنید حقایق عالم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 26.46,
   "end": 32.46,
   "text": "میون بر بزنید، از رموز و کنوز استفاده کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 32.46,
   "end": 34.66,
   "text": "یکی از رموز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.66,
   "end": 40.54,
   "text": "رجوع کردن به اهل علم و اهل حکمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.54,
   "end": 48.16,
   "text": "خب ما که دستمون به ظاهر البته به نجف نمی‌رسه که منبع حکمت‌اند ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 48.16,
   "end": 57.94,
   "text": "اما الحمدلله والمنه عالم آل محمد صلی الله علیه و آله و سلم در کشور ما هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 57.94,
   "end": 61.54,
   "text": "لذا حتما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 61.54,
   "end": 66.14,
   "text": "ولو شده یک بار، یک بار هم که شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 66.14,
   "end": 70.54,
   "text": "صرفا به نیت اخذ علم و حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 70.54,
   "end": 77.24,
   "text": "برید مشهد الرضا و زانو بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 77.24,
   "end": 81.64,
   "text": "تا اونجایی که میشه به مضجع شریف نزدیک بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 81.64,
   "end": 89.06,
   "text": "آقای بهجت دعבשون این بود که حتما خودشون رو به ضریح برسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 89.06,
   "end": 93.28,
   "text": "خب اونجا فیض، فیضان فیض خیلی بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 93.28,
   "end": 96.48,
   "text": "هرچی نزدیک میشی بیشتر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 96.48,
   "end": 98.68,
   "text": "نه اینکه اسباب اذیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 98.68,
   "end": 101.0,
   "text": "زائرها رو فراهم کنی، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 101.0,
   "end": 104.9,
   "text": "تو سعی کنی حتی ظاهری هم قرب پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 104.9,
   "end": 112.26,
   "text": "حتما برید و از دو تا اسم بهره بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 112.26,
   "end": 114.86,
   "text": "یکی اسم العلیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 114.86,
   "end": 120.02,
   "text": "یکی الحکیم. ضریح رو بگیرید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 120.02,
   "end": 127.02,
   "text": "بغل کنید. به جای گفتن حرف‌هایی که زشته در محضر امام گفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 127.02,
   "end": 133.64,
   "text": "چیپس و پفک خواستن، العلیم رو بگید، الحکیم رو بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 133.64,
   "end": 139.44,
   "text": "اگر به عددش بگید خب تاثیرش خیلی بهتر و بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 139.44,
   "end": 142.14,
   "text": "عدد ابجد العلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 142.14,
   "end": 144.98,
   "text": "می‌دونید صد و هشتاد و یکه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 144.98,
   "end": 148.72,
   "text": "بدون الف و لام صد و پنجاه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 148.72,
   "end": 152.08,
   "text": "لام سیه، الف هم که یکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 152.08,
   "end": 158.22,
   "text": "سی و یک بله صد و پنجاه میشه صد و هشتاد و یک عدد ابجد العلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 158.22,
   "end": 164.96,
   "text": "که وقتی با الف و لام میگی تاثیرش شگرفه به قول استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 164.96,
   "end": 169.76,
   "text": "بدون الف و لام هم میشه گفت مثلا با یا مناده بگی یا علیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 169.76,
   "end": 174.18,
   "text": "اما تاثیر العلیم بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 174.18,
   "end": 179.56,
   "text": "الحکیم عددش هست صد و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 179.56,
   "end": 186.46,
   "text": "چرا عدد؟ عرض کردیم که حضرت استاد فرمودن که اعداد روح الفاظ‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 186.46,
   "end": 191.28,
   "text": "روح پیکره این اسماء هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 191.28,
   "end": 194.78,
   "text": "وقتی شما با عدد میگی یعنی روح میدی به کارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 194.78,
   "end": 200.62,
   "text": "میخوای صدقه بدی، میخوای به کسی کمک کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 200.62,
   "end": 204.84,
   "text": "میخوای اصلا فطریت رو بدی، فطریت عدد ابجدی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 204.84,
   "end": 208.22,
   "text": "چه اشکالی داره؟ بهش اضافه کن ابجدش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 208.22,
   "end": 212.26,
   "text": "تاثیرش بیشتره. میخوای بری سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 212.26,
   "end": 216.78,
   "text": "مزار یه شهید مثلا شهید محسن حججی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 216.78,
   "end": 220.94,
   "text": "اسم محسن رو ابجدش رو پیدا کن به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 220.94,
   "end": 223.22,
   "text": "عدد اسم محسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 223.22,
   "end": 226.66,
   "text": "هدیه بده به شهید. حالا هر ذکری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 226.66,
   "end": 229.24,
   "text": "اینا رموز عالم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 229.24,
   "end": 234.9,
   "text": "به قول حضرت استاد آقای رنجبر که امروز بین دو نماز فرمودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 234.9,
   "end": 241.66,
   "text": "همه چیز رو که ما نمی‌دونیم. یه روزی در شرح مصباح العنس مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 241.66,
   "end": 249.96,
   "text": "ابن فناری که عرض کردیم از سنگین‌ترین بلکه سنگین‌ترین کتاب عرفان نظری‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 249.96,
   "end": 252.96,
   "text": "حضرت استاد، حضرت استاد در شرح این کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 252.96,
   "end": 259.06,
   "text": "فرمودن که مشایخ ما به گو، به ما گفتن که وقتی می‌خواید اسم العلیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 259.06,
   "end": 261.7,
   "text": "بگید، بکشید این اسمو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 261.7,
   "end": 265.44,
   "text": "بگید العلییییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 265.44,
   "end": 270.2,
   "text": "الحکیم نه، الحکییییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 270.2,
   "end": 275.12,
   "text": "حالا شما امتحان کنید یا کریییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 275.12,
   "end": 276.9,
   "text": "اصلاً یعنی بیشتر بهت حال میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 276.9,
   "end": 279.16,
   "text": "گذشته از اون رموزی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 279.16,
   "end": 282.78,
   "text": "یه روزی خب برای خود من مکشوف نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 282.78,
   "end": 285.84,
   "text": "فکر می‌کردم به اینکه چرا باید بکشیم العلیم رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 285.84,
   "end": 288.5,
   "text": "مثلا مشایخ حضرت استاد چرا گفتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 288.5,
   "end": 294.08,
   "text": "جالبه که خدا خیلی عملاً یه روز به خود من فهموند چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 294.08,
   "end": 299.84,
   "text": "دخترم صدام زد، بابا من مشغول کاری بودم جوابشو ندادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 299.84,
   "end": 303.98,
   "text": "گفتم حالا مشغلم متوجه بشه که الان نباید صدام کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 303.98,
   "end": 306.18,
   "text": "باز گفت بابا جواب ندادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 306.18,
   "end": 307.84,
   "text": "گفت بابا جواب ندادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 307.84,
   "end": 309.48,
   "text": "گفت بابااا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 309.48,
   "end": 313.02,
   "text": "گفتم جان بابا. تا اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 313.02,
   "end": 323.26,
   "text": "باباشو کشید... بالاخره وقتی خدای منان انسان رو از سه حیثیت، از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 323.26,
   "end": 328.66,
   "text": "ذات و صفات و افعال به وزانه خودش آفریده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 328.66,
   "end": 332.04,
   "text": "از خیلی حالات اون می‌تونیم به حالات خدا پی ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 332.04,
   "end": 336.46,
   "text": "مگه خدا حال داره؟ حال داره یا نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 336.46,
   "end": 340.34,
   "text": "اللهم غیر سوء حالنا بحسن حالک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 340.34,
   "end": 345.06,
   "text": "پس خدا هم حال داره. حال خدا حال پیغمبره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 345.06,
   "end": 351.04,
   "text": "حال انسان کامله. این از این نکته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 351.04,
   "end": 353.96,
   "text": "هدیه امروز ما به شما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 353.96,
   "end": 359.74,
   "text": "من که این رو به شما عرض می‌کنم، خودم الحمدلله انجام دادم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 359.74,
   "end": 363.64,
   "text": "ثمرش رو دیدم، دوست دارم شما هم بچشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 363.64,
   "end": 365.94,
   "text": "بعد می‌بینی امام رعوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 365.94,
   "end": 369.54,
   "text": "توبره تو پر می‌کنه از حقایقی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 369.54,
   "end": 375.56,
   "text": "به کمتر کسی داده. اینطوری نیست که همینطوری بری سلام آقا جون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 375.56,
   "end": 381.8,
   "text": "مثلا این مشکلاتو دارم، کمرم درد می‌کنه، پام درد می‌کنه، شکمم برگشت خورده، مشکل مستاجری دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 381.8,
   "end": 386.72,
   "text": "خب اینا هم درست. اما انسان کامل رو گذاشتن برای این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 386.72,
   "end": 393.4,
   "text": "برای این اینکه یه شهید هم شهید گمنام بغل مسجد بلال هم می‌تونه این رتق و فتق این مسائل ما رو بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 393.4,
   "end": 395.5,
   "text": "ما و خدا انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 395.5,
   "end": 399.42,
   "text": "برید انجام بدین نتیجه بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 399.42,
   "end": 403.32,
   "text": "اون انسان کامله، اون واسطه‌ی فیضه، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 403.32,
   "end": 405.44,
   "text": "مدی-مدیر و مدبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 405.44,
   "end": 411.4,
   "text": "جهانه. \"یدبر الأمر من السماء إلى الأرض قوس صعود\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 411.4,
   "end": 415.22,
   "text": "\"من السماء إلى الأرض قوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 415.22,
   "end": 421.04,
   "text": "نزول\" ببخشید. \"یدبر الأمر من السماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 421.04,
   "end": 423.64,
   "text": "إلى الأرض قوس نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 423.64,
   "end": 431.08,
   "text": "ثم يعرج إليه\". سپس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 431.08,
   "end": 435.72,
   "text": "معراج می‌کنه، عروج می‌کنه \"إليه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 435.72,
   "end": 439.26,
   "text": "به سوی او. می‌شه قوس صعود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 439.26,
   "end": 443.52,
   "text": "هر دو قوس رو انسان کامل زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 443.52,
   "end": 446.54,
   "text": "اصلاً نمیشه به جز انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 446.54,
   "end": 451.79,
   "text": "به معراج رفت. همونطور که انسان کامل ما رو پیاده کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 451.79,
   "end": 455.24,
   "text": "\"بکن فتح الله و بکن يختم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 455.24,
   "end": 457.8,
   "text": "انسان کامل هم ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 457.8,
   "end": 460.82,
   "text": "به معراج می‌بره. ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 460.82,
   "end": 463.8,
   "text": "سعیمون تو دنیا باید چی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 463.8,
   "end": 467.16,
   "text": "هم جنسی و هم سنخی با اونا باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 467.16,
   "end": 469.2,
   "text": "این سعی ما باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 469.2,
   "end": 473.76,
   "text": "ما هم شکلشون بشیم، هم سنخ، هم جنسشون بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 473.76,
   "end": 477.52,
   "text": "مسانخ با اون‌ها باشیم که بهش می‌گن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 477.52,
   "end": 482.94,
   "text": "مقام شفاعت. اصلاً مقام شفاعت یعنی جفت شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 482.94,
   "end": 486.14,
   "text": "شفع جفت شدن با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 486.14,
   "end": 490.86,
   "text": "صاحب شفاعت. نه یعنی پارتی بازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 490.86,
   "end": 493.76,
   "text": "هر مقدار که من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 493.76,
   "end": 498.96,
   "text": "بوی اون‌ها رو گرفتیم، هم جنس اون‌ها شدیم، هم سنخ اون‌ها شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 498.96,
   "end": 505.78,
   "text": "کسی ما رو دید گفت این شبیه امام زمانه، این شبیه امام سجاده، این شبیه امیرالمؤمنین، شبیه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 505.78,
   "end": 511.32,
   "text": "زهراست، این شبیه حضرت زینبه، این شبیه حضرت ابوالفضل مرامش شبیه اوناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 511.32,
   "end": 514.36,
   "text": "همون مقدار ما به مقام شفاعت می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 514.36,
   "end": 515.73,
   "text": "اصلاً شفاعت رو که باید از هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}