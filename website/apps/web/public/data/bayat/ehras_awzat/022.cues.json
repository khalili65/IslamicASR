 "chapters": [
  {
   "index": 0,
   "title": "## مکان شریف و شب اول ماه رجب",
   "start": 0.04,
   "end": 20.22
  },
  {
   "index": 1,
   "title": "## رمز هدیه در جلسه",
   "start": 20.22,
   "end": 41.24
  },
  {
   "index": 2,
   "title": "## هدیهٔ نخست: ذکر علامه حسن‌زاده علیه‌الرحمه",
   "start": 41.24,
   "end": 141.06
  },
  {
   "index": 3,
   "title": "## هدیهٔ دوم از امام صادق علیه‌السلام",
   "start": 141.06,
   "end": 163.16
  },
  {
   "index": 4,
   "title": "## سه اثر کوزهٔ آب نادیده",
   "start": 163.16,
   "end": 196.04
  },
  {
   "index": 5,
   "title": "## دستور عمل در شب اول رجب",
   "start": 196.04,
   "end": 313.28
  },
  {
   "index": 6,
   "title": "این‌ها را خودشان اضافه کرده‌اند. این کارها را نکنید.",
   "start": 313.28,
   "end": 356.34
  },
  {
   "index": 7,
   "title": "## شمای سلوک ماه‌های رجب و شعبان و رمضان",
   "start": 356.34,
   "end": 376.4
  },
  {
   "index": 8,
   "title": "## لیلةالقدر و درک انسان کامل",
   "start": 376.4,
   "end": 551.05
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.04,
   "end": 1.68,
   "text": "به بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 1.68,
   "end": 7.44,
   "text": "چون مکان، مکان شریفی‌ست و در محضر پنج شهید خوشنام هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.44,
   "end": 15.36,
   "text": "شب اول ماه خدا، ماه رجب هم هست یا به یک معنا ماه ولایت و امیرالمؤمنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.36,
   "end": 17.24,
   "text": "یک هدیه ابتدا تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.24,
   "end": 20.22,
   "text": "دو تا، دو تا هدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.22,
   "end": 25.46,
   "text": "این هدایایی که هر وقت من تو جلسه به شما گفتم یادتون باشه دیگه یه رمزی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.46,
   "end": 29.64,
   "text": "بین من و شما. گفتم یک هدیه براتون دارم یعنی سینه به سینه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.64,
   "end": 31.96,
   "text": "شاید تو کتاب‌ها ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.96,
   "end": 35.56,
   "text": "اما ما این رو سینه به سینه از اساتیدمون اخذ کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.56,
   "end": 37.94,
   "text": "از حضرت علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.94,
   "end": 41.24,
   "text": "علیه الرحمه یه هدیه‌ای ما داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.24,
   "end": 44.3,
   "text": "همین جلسه اول تقدیم حضور شما به خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.3,
   "end": 49.04,
   "text": "به عنوان خوش آمدگویه به شما تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.04,
   "end": 53.38,
   "text": "ایشون خیلی تاکید داشتن که در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.38,
   "end": 56.98,
   "text": "ذکر اسم اعظم واقع شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.98,
   "end": 59.88,
   "text": "و صفای باطن میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.88,
   "end": 62.42,
   "text": "قوت قلب میده به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.42,
   "end": 69.56,
   "text": "این جلسه باید منجر بشه به صفای باطن و قوت قلب که اگر این دو تا نباشه جلسه رو باید تعطیل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.56,
   "end": 73.58,
   "text": "خب، یه کمکی فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.58,
   "end": 80.36,
   "text": "این ذکر رو اکثارش زیاد یعنی قلبمون زیادتر باشه بهش هر چقدر که می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.36,
   "end": 84.64,
   "text": "صفای باطن و قوت قلب میاره که یا که البته فرمودن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.64,
   "end": 90.48,
   "text": "اسم اعظم هم درشه. یا حی یا قيوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.48,
   "end": 94.04,
   "text": "یا من لا اله الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.04,
   "end": 99.66,
   "text": "انت. یه بار دیگه می‌نوی-- میگم از اینا که بخوان بنویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.66,
   "end": 104.4,
   "text": "حتماً هم انشاالله از جلسه بعد دفتر و قلم با خودتون داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.4,
   "end": 109.96,
   "text": "جسارت می‌کنم ولی چون جلسه درس و بحثه مقدار من سخت می‌گیرم دیگه منبر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.96,
   "end": 117.98,
   "text": "باید همه حتماً کاغذ قلم داشته باشن و یه وقتی من جزوات‌تون رو می‌گیرم می‌برم منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.98,
   "end": 121.14,
   "text": "نگاه می‌کنم نمره میدیم انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.14,
   "end": 124.74,
   "text": "بررسی می‌کنیم بلدگیری می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.74,
   "end": 129.38,
   "text": "یک بار دیگه بخونم یا حی یا قيوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.38,
   "end": 134.86,
   "text": "یا من لا اله الا انت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.86,
   "end": 138.38,
   "text": "جان؟ نه اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.38,
   "end": 141.06,
   "text": "پس این یک هدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.06,
   "end": 144.38,
   "text": "هدیه دوم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.38,
   "end": 148.54,
   "text": "امام صادق صلی الله علیه فرمودن این هدیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.54,
   "end": 155.36,
   "text": "منتها ما از اساتیدمون اخذ کردیم بعداً در کد- کتاب‌ها دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.36,
   "end": 163.16,
   "text": "اون هم اینه که بهترین وقتش هم امشبه به همین خاطر الان عرض می‌کنم بهترین وقتش شب اول ماه رجب این کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.16,
   "end": 167.36,
   "text": "اگر کسی می‌خواد از همه بلاها محفوظ باشه یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.36,
   "end": 173.86,
   "text": "از چشم نظر و حسود و چشم بخیل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.86,
   "end": 181.0,
   "text": "نمی‌دونم جادوگری و طلسمات و این‌ها در امان باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.0,
   "end": 184.84,
   "text": "و سوم این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.84,
   "end": 188.92,
   "text": "اگر کسی دوست داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.92,
   "end": 193.02,
   "text": "انشاالله خوش روزی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.02,
   "end": 196.04,
   "text": "برکت بیاد تو زندگیش این کار رو انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.04,
   "end": 199.62,
   "text": "امشب که شب اول ماه رجبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.62,
   "end": 204.2,
   "text": "سعی کنه یک کوزه آب ندیده تهیه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.2,
   "end": 208.0,
   "text": "البته شاه عبدالعظیم اونجا بازارچه‌ش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.0,
   "end": 212.4,
   "text": "اگر نتونستید تهیه کنید فعلاً تو یه ظرف دیگه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.4,
   "end": 215.3,
   "text": "ترجیحاً ظرفی باشه که تا حالا استفاده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.3,
   "end": 220.0,
   "text": "پارچی چیزی که تا-- بهتر اینه که امام صادق فرمود چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 220.0,
   "end": 224.48,
   "text": "کوزه آب ندیده. کوزه سفالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.48,
   "end": 228.28,
   "text": "اینو برمی‌دارید درش آب می‌ریزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.28,
   "end": 230.58,
   "text": "سی مرتبه امشب وضو می‌گیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.58,
   "end": 237.3,
   "text": "بعد سی مرتبه surه قدر رو می‌خونید، می‌دمید در این کوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.3,
   "end": 240.46,
   "text": "آبی که داخلشه. ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.46,
   "end": 246.92,
   "text": "وضو می‌گی-- اول ازش می‌خورید یه مقدار خودتون، زن و بچه‌تون، خونواده‌تون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.92,
   "end": 251.66,
   "text": "اگرچه وضو دارید‌ها اما باز از آب اون وضو می‌گیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.66,
   "end": 255.14,
   "text": "همه‌تون، شما و اهل خونواده‌تون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.14,
   "end": 262.32,
   "text": "دیگه هر آبی تو منزلتون برای خوردن و شرب و وضو و اینا خواستید استفاده کنید از این آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.32,
   "end": 264.76,
   "text": "هرچی که دیدید داره تموم می‌شه هی آب بریزید روش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.76,
   "end": 267.06,
   "text": "هی آب بریزید همون تاثیر رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.06,
   "end": 272.16,
   "text": "اون تاثیراتی که اول گفتم رو امام صادق صلی الله علیه فرمود با خودش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.16,
   "end": 278.42,
   "text": "دیگه اینو بذارید تو خونه‌تون باشه. انشاالله ما هم نیت کردیم امشب این کار رو انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.42,
   "end": 282.48,
   "text": "و عرض شود خدمتتون که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.48,
   "end": 286.04,
   "text": "بعضیا من دیدم متاسفانه آدم‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.04,
   "end": 288.9,
   "text": "خوب و مطرحی هم هستن، چهره‌ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.9,
   "end": 294.04,
   "text": "حتی بعضا رسانه‌ای‌ان، یه اشتباهی اینجا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 294.04,
   "end": 301.34,
   "text": "دیدم که گفتن این آب، آب زمزم باشه یا آب سقاخونه حرم امام رضا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.34,
   "end": 304.32,
   "text": "یا آب تربت کربلا باشه و این آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.32,
   "end": 308.84,
   "text": "فرات باشه. بعد به اندازه یه عدس تربت امام حسین هم بندازید تو این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.84,
   "end": 310.64,
   "text": "اینا رو خودشون اضافه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.64,
   "end": 318.5,
   "text": "این کارا رو شما نکنید. اصلا اگر تربت بندازی تو این آب شما بیشتر از یه قاشق نمی‌تونی بخوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 318.5,
   "end": 322.36,
   "text": "و اصلا نمی‌تونی از اون آب وضو بگیری چون می‌ریزه زمین، می‌ریزه تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 322.36,
   "end": 328.68,
   "text": "اصلا جسارت می‌شه. نمی‌تونی از اون آب برای مثلاً برنج دم کردن و غذا تو خونه استفاده کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 328.68,
   "end": 333.22,
   "text": "مثل اون آب تربتی که مادر شهید معماریان آورد اینجا تقدیم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 333.22,
   "end": 334.84,
   "text": "اصلا این کارا رو نمیشه باهاش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 334.84,
   "end": 339.22,
   "text": "حرمت پیدا می‌کنه. پس اینایی که این کارا رو می‌کنن و این حرفا رو می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 339.22,
   "end": 346.22,
   "text": "متاسفانه چون علمش رو ندارن یا به یک معنا شاید بشه گفت استاد ندیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.22,
   "end": 350.64,
   "text": "این اشتباهات رو انجام میدن مردم رو متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 350.64,
   "end": 353.56,
   "text": "به ضرر می‌ندازن. پس آنچه که عرض کردیم این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 353.56,
   "end": 358.52,
   "text": "اینم هدیه دوممون. و نکته آخر پیرامون امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.52,
   "end": 365.14,
   "text": "برای آمادگی این رو خوب گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 365.14,
   "end": 369.84,
   "text": "این هم برگرفته از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 369.84,
   "end": 372.4,
   "text": "صدها جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 372.4,
   "end": 382.42,
   "text": "درسی از بزرگان اهل معرفت بوده که بنده خوشه‌چین بودم و خوشه‌چین خرمنشون و زانوان زدم به شما تقدیم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 382.42,
   "end": 385.06,
   "text": "می‌خوام یک شمای کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 385.06,
   "end": 388.32,
   "text": "از کم و کیف ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 388.32,
   "end": 391.68,
   "text": "رجب، شعبان و رمضان رو به شما بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 391.68,
   "end": 396.66,
   "text": "به صورت کلی. که شروع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 396.66,
   "end": 403.64,
   "text": "جریان سلوک هر بنده‌ای از امشب آغاز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 403.64,
   "end": 406.62,
   "text": "ورود به ماه رجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 406.62,
   "end": 410.48,
   "text": "مثل ورود به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 410.48,
   "end": 416.02,
   "text": "شهری‌ست که حرم امام معصوم درش هست مثل مشهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 416.02,
   "end": 418.5,
   "text": "پس امشب-- دقت بفرمایید دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 418.5,
   "end": 423.3,
   "text": "مقایسه می‌کنم شما متوجه بشید چه اتفاقی داره می‌افته و چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 423.3,
   "end": 432.44,
   "text": "سیری رو باید بریم. امشب کأنّ من و شما وارد می‌شیم به شهری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 432.44,
   "end": 436.22,
   "text": "انسان کامل در اونجاست مثل مشهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 436.22,
   "end": 438.44,
   "text": "ورود ما به شهر مشهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 438.44,
   "end": 441.64,
   "text": "محل شهوده. ماه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 441.64,
   "end": 443.88,
   "text": "کلاً ماه رجب این شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 443.88,
   "end": 448.72,
   "text": "وارد شهر می‌شیم. ماه شعبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 448.72,
   "end": 452.3,
   "text": "در قیاس با شعب-- با رجب چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 452.3,
   "end": 456.28,
   "text": "مثل اینکه شما وارد بشید در حرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.28,
   "end": 458.42,
   "text": "وارد حریم حرم بشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 458.42,
   "end": 462.88,
   "text": "یعنی نزدیک‌تر می‌شیم. ماه شعبان کارکردش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 462.88,
   "end": 466.5,
   "text": "خب شما می‌خوای وارد حرم بشی مقدماتی لازم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 466.5,
   "end": 470.62,
   "text": "باید اذن دخول بخونی همین‌طوری نباید بری و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 470.62,
   "end": 477.88,
   "text": "دیگه این‌ها رو من دارم می‌گم که خودتون ذهنتونو می‌شورم که بتونید قشنگ متوجه بشید یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 477.88,
   "end": 481.4,
   "text": "ماه رمضان در قیاس با این دو ماه چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 481.4,
   "end": 486.42,
   "text": "مثل اینکه شما وارد روضه مقدسه می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 486.42,
   "end": 494.86,
   "text": "ببینید اون ماه شعبان مثل اینکه وارد صحن‌های حرم شدی ولی هنوز داخل تو روضه نرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 494.86,
   "end": 497.66,
   "text": "ماه رمضان وارد روضه مقدسه می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 497.66,
   "end": 500.16,
   "text": "خب اونجا دیگه خیلی آدابش سنگین‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 500.16,
   "end": 502.22,
   "text": "دیگه قرب محض است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 502.22,
   "end": 507.6,
   "text": "ل-لیلة القدر چی که در ماه مبارک رمضان واقع شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 507.6,
   "end": 516.06,
   "text": "لیلة القدر دیگه می‌شه مژجع شریف، قبر مقدس، جایی که امام حاضره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 516.06,
   "end": 520.32,
   "text": "این یه چینشی بود، یه بافتی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 520.32,
   "end": 525.06,
   "text": "برای سهولت فهم جایگاه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 525.06,
   "end": 530.9,
   "text": "سه ماه و به خصوص لیلة القدر و که ما از کجا باید شروع کنیم به کجا بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 530.9,
   "end": 533.98,
   "text": "پس اگر سیر ما از امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 533.98,
   "end": 538.1,
   "text": "که امشب خیلی مهمه، مخصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 538.1,
   "end": 543.32,
   "text": "شب اول ماه رجب از شب‌هاییه که احیا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 543.32,
   "end": 547.02,
   "text": "اگر درست از امشب سیرمون رو شروع کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 547.02,
   "end": 551.05,
   "text": "ما در نهایت انشاالله شب قدر درک می‌کنیم انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}