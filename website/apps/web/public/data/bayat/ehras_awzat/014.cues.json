   "start": 21.32,
   "end": 64.2
  },
  {
   "index": 1,
   "title": "## روایت امام رضا علیه‌السلام در مکارم الأخلاق",
   "start": 64.2,
   "end": 448.66
  },
  {
   "index": 2,
   "title": "## برکت رزق در چهار گوشهٔ خانه",
   "start": 448.66,
   "end": 513.6
  },
  {
   "index": 3,
   "title": "## وقتی علت را تشخیص نمی‌دهیم: آیهٔ سی‌وسهٔ الرحمن",
   "start": 513.6,
   "end": 533.62
  },
  {
   "index": 4,
   "title": "آیهٔ سی‌وسهٔ سورهٔ الرحمن را — نخست سورهٔ جن بر زبان آمد و اصلاح شد: سورهٔ الرحمن. این آیه را بسیار دوست دارم:",
   "start": 533.62,
   "end": 643.72
  },
  {
   "index": 5,
   "title": "## صدقه و قربانی؛ توصیهٔ آیت‌الله بهجت",
   "start": 643.72,
   "end": 664.18
  },
  {
   "index": 6,
   "title": "## جداول أوفاق و جدول امیرالمؤمنین",
   "start": 664.18,
   "end": 684.52
  },
  {
   "index": 7,
   "title": "## ختم جلسه",
   "start": 684.52,
   "end": 900.83
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.38,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.38,
   "end": 8.44,
   "text": "محمد و آل محمد و عجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.44,
   "end": 12.06,
   "text": "بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.06,
   "end": 17.46,
   "text": "السلام علیک يا داعی الله و رباني آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.46,
   "end": 21.32,
   "text": "سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.32,
   "end": 25.12,
   "text": "با توجه به سوالی که عزیزی پرسید باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.12,
   "end": 29.92,
   "text": "مجبورم که امروز هم در بحث ادعیه چند تا نکته عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.92,
   "end": 34.58,
   "text": "یه عزیزی سؤال کرد آقا یک آن، یک آن همون لحظه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.58,
   "end": 38.16,
   "text": "احساس می‌کنیم که یه کسی چشم زد ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.16,
   "end": 45.04,
   "text": "یا مثلا یک در یک معرضی قرار می‌گیریم احساس می‌کنیم همون لحظه کسی ما رو سحر و جادو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.04,
   "end": 53.32,
   "text": "اون لحظه ما چه کنیم؟ دستور اولیه‌ای که شما گفتیدا اینا مال مثلا بعدا تو خونه می‌خوای بشینی از راه دور و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.32,
   "end": 57.78,
   "text": "نه، اون لحظه. همون لحظه‌ها یه راهی هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.78,
   "end": 62.54,
   "text": "دور بشه چشم زخم و چشم حسود، چشم بد از انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.54,
   "end": 65.36,
   "text": "یا سحر و جادو. بله در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.36,
   "end": 68.56,
   "text": "شریف مكارم الاخلاق صفحه سیصد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.56,
   "end": 71.04,
   "text": "صفحه چهارصد و سیزده می‌تونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.04,
   "end": 75.72,
   "text": "این روایت رو ببینید که شخصی به نام محمد بن عیسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.72,
   "end": 82.86,
   "text": "از حضرت رضا صلوات الله علیه در ارتباط سحر و جادو و اینها پرسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.86,
   "end": 87.18,
   "text": "و حضرت فرمودند که سحر واقعیت دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.18,
   "end": 93.38,
   "text": "امام رضا فرمودند سحر واقعیت دارد و به اذن خدا اثر می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.38,
   "end": 96.9,
   "text": "هرگاه تو را سحر کردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.9,
   "end": 100.58,
   "text": "دستت را مقابل صورتت بالا ببر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.58,
   "end": 103.94,
   "text": "و این دعا را بخوان به دستت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.94,
   "end": 112.68,
   "text": "بسم الله العظیم. بسم الله العظیم رب العرش العظیم الا ذهبت و انغرابت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.68,
   "end": 120.08,
   "text": "بعد انشاالله اون سحر دفع می‌شه و از تو یعنی در تو اثری نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.08,
   "end": 126.58,
   "text": "بعد پرسید که آقا از امام رضا صلوات الله علیه میگه پرسیدم که آقا زخم، چشم زخم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.58,
   "end": 130.33,
   "text": "اینم واقعیت داره؟ بعضیا میگن نه نیست و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.33,
   "end": 134.02,
   "text": "اتفاقا امام رضا صلوات الله علیه فرمودند آری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 134.02,
   "end": 136.26,
   "text": "یعنی حقیقت داره چشم زخم هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.26,
   "end": 141.76,
   "text": "هرگاه تو رو چشم زدن کف دستت رو مقابل صورتت قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.76,
   "end": 144.96,
   "text": "دیگه اینو همه راحت تشخیص میدید دیگه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.96,
   "end": 148.54,
   "text": "دیگه مثل اون آیه سخت نیست آسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.54,
   "end": 150.7,
   "text": "کف دستو میاری جلو صورتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.7,
   "end": 156.64,
   "text": "سوره حمد و قل هو الله و ناس و فلق که معروفاً به معوذتين ناس و فلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.64,
   "end": 159.38,
   "text": "حمد و قل هو الله و ناس و فلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.38,
   "end": 161.72,
   "text": "می‌خونی بعد می‌کشی به صورتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.72,
   "end": 167.9,
   "text": "امام رضا صلوات الله علیه فرمود که اون چشم زخم از تو دفع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.9,
   "end": 173.1,
   "text": "قبلیه رو حضرت فرمود که همین‌طور دستتو میاری جلو صورتت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.1,
   "end": 175.22,
   "text": "و این دعا رو می‌خونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.22,
   "end": 183.96,
   "text": "بسم الله العظیم. بسم الله العظیم رب العرش العظیم الا ذهبت و انغرابت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 183.96,
   "end": 186.34,
   "text": "این دعا رو که خوندی به دستت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.34,
   "end": 189.14,
   "text": "جان؟ معnishو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 189.14,
   "end": 191.24,
   "text": "آره. معnishو میگی یا چی میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.24,
   "end": 193.26,
   "text": "بله مشخصه دیگه. بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.26,
   "end": 197.52,
   "text": "بسم الله العظیم که عظیم که از اسامی خداست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.52,
   "end": 200.78,
   "text": "پرورد-- که می‌فرماید به نام خدای عظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.78,
   "end": 203.36,
   "text": "دو بار هم تکرار شده. من تکرار نکردما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.36,
   "end": 206.48,
   "text": "بسم الله العظیم دو بار تکرار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.48,
   "end": 208.38,
   "text": "به نام خدای عظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.38,
   "end": 211.38,
   "text": "کدوم خدا؟ رب العرش العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.38,
   "end": 218.92,
   "text": "پروردگار عرش عظیم که حالا این عرش باید تعویل بشه در روایات و این‌ها بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.92,
   "end": 224.64,
   "text": "به علم خدا زدن بعضی از روایات، بعضیا به قدرت خدا و و و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.64,
   "end": 226.84,
   "text": "الا ذهبت و انغرابت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.84,
   "end": 230.38,
   "text": "مگر اینکه این سهری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.38,
   "end": 233.14,
   "text": "به من شد رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.14,
   "end": 236.88,
   "text": "و انغرابت، منقضی شد، از بین رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.88,
   "end": 240.5,
   "text": "به برکت چی؟ خدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.5,
   "end": 242.98,
   "text": "عظیم و پروردگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.98,
   "end": 248.56,
   "text": "رب عرش عظیم. یعنی انقدر که این اسم عظمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.56,
   "end": 252.68,
   "text": "بسم الله العظیم. بسم الله العظیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.68,
   "end": 254.68,
   "text": "رب العرش العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.68,
   "end": 258.0,
   "text": "حالا اون دومی همش که بیشتر اتفاقاً اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.0,
   "end": 260.44,
   "text": "قسمت دومو بیشتر ما در معرضش هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 260.44,
   "end": 262.64,
   "text": "چشم زخم و چشم حسود و چشم بد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.64,
   "end": 265.68,
   "text": "آقا میگه ماشین خوب می‌خره طرف، خونه می‌خره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.68,
   "end": 271.68,
   "text": "یه تیپی می‌زنه مثل ما شاید خوشگل مشگل باشه، یهو بره یه جا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.68,
   "end": 275.22,
   "text": "چه می‌د-- این مداح‌های آقا مجتبی که اون ته می‌شینن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.22,
   "end": 277.8,
   "text": "اینا مداحی‌ها خوشگل می‌خونن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.8,
   "end": 280.68,
   "text": "منبری خیلی زیبا صحبت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.68,
   "end": 283.56,
   "text": "ها؟ اینا همه هست یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.56,
   "end": 286.64,
   "text": "بالاخره تو چشم بیفته. حتی خوبان انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.64,
   "end": 289.2,
   "text": "حدیث داریم پدر و مادر حتی بچه رو چشم می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.2,
   "end": 292.1,
   "text": "یهو تو چشم پدر و مادر بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.1,
   "end": 297.5,
   "text": "شیرین زبونی می‌کنه. اونجا فرمودن سریع، سریع این کارو انجام بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 297.5,
   "end": 299.74,
   "text": "اینا حقایقی‌ست که در عالم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 299.74,
   "end": 302.02,
   "text": "نمی‌شه اینا رو انکار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.02,
   "end": 306.82,
   "text": "یعنی چشم حسد و چشم زخم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 306.82,
   "end": 309.36,
   "text": "این‌ها هست، وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.36,
   "end": 314.54,
   "text": "حالا چشم حسد مال، چشم حسود مال اینه که بدبینه طرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.54,
   "end": 320.9,
   "text": "تنگ نظره. در صور-- چشم زخم نه، چشم زخم پدر و مادر هم می‌تونن بزنن، رفیقت می‌تونه بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.9,
   "end": 325.42,
   "text": "یهو خوشش میاد ازت چشمش می‌گیرتت اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.42,
   "end": 329.36,
   "text": "قدرت چشما. لا یضلونك بأبصارهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.36,
   "end": 331.96,
   "text": "قرآن میگه تو رو با چشماشون زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.96,
   "end": 334.46,
   "text": "این‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.46,
   "end": 337.8,
   "text": "یه دستور اولی هم چون یه عزیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.8,
   "end": 341.6,
   "text": "پیام داده بود به مدیر کانال که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.6,
   "end": 346.24,
   "text": "البته وویس داده بود که من اینو گوش دادم خیلی متأثر شدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.24,
   "end": 348.9,
   "text": "نمی‌دونم پسرش کی به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.9,
   "end": 355.02,
   "text": "جن زده شده. یه سحر سنگینی افتاده بهش که پیش هر کی بردن خوب نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.02,
   "end": 360.28,
   "text": "این دستوری که میگم مال اینه، مال اونی که خیلی دیگه سنگین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.28,
   "end": 363.66,
   "text": "جن ورود کرده یا طلسم سنگین، سحر سنگین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.66,
   "end": 368.88,
   "text": "طوری که طرف خودشو می‌زنه داد می‌زنه اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.88,
   "end": 371.76,
   "text": "اینم حضرت فرمودن که از راه دوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.76,
   "end": 374.28,
   "text": "یه دستورالعمل قرآنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.28,
   "end": 379.34,
   "text": "فرمودن که نام شخص و مادرش رو بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.34,
   "end": 385.24,
   "text": "نام شخص و مادرش. بعد هفت مرتبه سوره مزمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.24,
   "end": 389.38,
   "text": "و چهل و یک مرتبه سوره یاسین رو می‌خونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.38,
   "end": 394.76,
   "text": "در ادامه بیست و یک مرتبه آیه ابطال سحر رو می‌خونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.76,
   "end": 399.62,
   "text": "آیه ابطال سحر، آیه هشتاد و یک سوره یونس از این قسمتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.62,
   "end": 404.64,
   "text": "\"قال موسی، قال موسی ماجئتم به السحر إن الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.64,
   "end": 410.24,
   "text": "سیبطلہ إن الله لا یصلح عمل المفسدین\" تا اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 410.24,
   "end": 415.22,
   "text": "این رو بعدش تکرار می‌کنی بیست و یک مرتبه این آیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.22,
   "end": 418.32,
   "text": "در انتها این جمله رو می‌گید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.32,
   "end": 424.06,
   "text": "من شماره شماره میگم عزیزانی که از تو کانال می‌شنون و می‌خوان پیاده کنن داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 424.06,
   "end": 431.78,
   "text": "\"توکلوا يا خودا محاذل الآيات والأسماء بابطال سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.78,
   "end": 436.32,
   "text": "فلان\" به جای فلان اسم شخص رو و مادرش رو دوباره می‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.32,
   "end": 441.96,
   "text": "\"من الساعة من الساعة\". حضرت فرمودن هر چقدر این سنس، این سحر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.96,
   "end": 446.4,
   "text": "این طلسم و جادو سنگین باشه این باطلش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 446.4,
   "end": 448.66,
   "text": "اینم هدیه ما به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.66,
   "end": 455.2,
   "text": "حالا که امروز هم ما مزاحم شما شدیم از این حیث یه دو تا دیگه تقدیم کنیم حیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.2,
   "end": 461.06,
   "text": "یکی از اساتید ما اینو به ما گفت و، و قصدم نداشتم بگم حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.06,
   "end": 465.74,
   "text": "البته هیچ کدوم از این ده دوازده جلسه رو حقیقتا ما نمی‌خواستیم بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 465.74,
   "end": 468.68,
   "text": "کشیده شدیم مثل امروز دوباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 468.68,
   "end": 471.18,
   "text": "اگه کسی می‌خواد انشاالله رزقش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 471.18,
   "end": 475.68,
   "text": "رزقش زیاد بشه، برکت تو زندگیش زیاد بشه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.68,
   "end": 478.6,
   "text": "مخصوصا صبح بعد از نماز صبح بهترین وقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.6,
   "end": 483.5,
   "text": "بهترین وقتش اون موقع‌ست. چهار گوشه‌ی خونه‌ش بره وایسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 483.5,
   "end": 487.98,
   "text": "هر چهار قسمت کنه خونه رو چهار گوشه‌ی خونه‌ش وایسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 487.98,
   "end": 493.54,
   "text": "صد بار بگه یا رزاق چهارده بار بگه یا وهاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.54,
   "end": 496.2,
   "text": "برکت میاد تو زندگیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.2,
   "end": 504.82,
   "text": "خیلی هم اثر داده. من خودم که از اساتیدمون این دستورالعمل رو گرفتم انجام دادم و خیلی هم تاثیر گرفتم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 504.82,
   "end": 507.7,
   "text": "دیگر اینکه احتمال داره ما تشخیص ندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 507.7,
   "end": 511.62,
   "text": "اینم مهمه اینی که به شما میگم یه یادگار از اساتیدمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 511.62,
   "end": 515.82,
   "text": "و البته دیدم در بعضی از کتب ادعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 515.82,
   "end": 524.94,
   "text": "احتمال داره ما تشخیص ندیم آقا این مشکلات که تو زندگی ما هست از جنه، از سهره، از مثلا چشم نظره، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 524.94,
   "end": 528.42,
   "text": "نفس پلیده مهمونیه اومده تو خونه‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 528.42,
   "end": 531.08,
   "text": "چه می‌دونیم؟ یا آب طلسم و از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 531.08,
   "end": 541.46,
   "text": "آب سحر ریختن جلوی در خونه‌مون و کارهای مختلف چیزای حالا یا مثلا بلاییه که نفس پلید همسایه به ما زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 541.46,
   "end": 544.24,
   "text": "اینا داستان‌های مختلف داره که همش هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 544.24,
   "end": 546.26,
   "text": "بالاخره چه کنیم؟ نمی‌دونیم چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 546.26,
   "end": 549.56,
   "text": "این کارو بکنید. آیه سی و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 549.56,
   "end": 551.9,
   "text": "سوره جن رو یا معش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 551.9,
   "end": 556.1,
   "text": "ببخشید سوره الرحمن رو \"یا معشر الجن والإنس إن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 556.1,
   "end": 563.26,
   "text": "استطعتم أن تنفذوا من ابطار السماوات والأرض فانفذوا لا تنفذون إلا بسلطان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 563.26,
   "end": 565.82,
   "text": "من خیلی این آیه رو دوست دارم خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 565.82,
   "end": 568.18,
   "text": "آیه سی و سه سوره الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 568.18,
   "end": 572.86,
   "text": "البته خود سوره الرحمنو امام صادق علیه السلام فرمود اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 572.86,
   "end": 579.22,
   "text": "مداومت کنه هر روز بخونه چهره‌ی زیبا و وجه درخشانی پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 579.22,
   "end": 586.04,
   "text": "خود سوره سی و آیه سی و سه این سوره رو فرمودن هفتاد بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.04,
   "end": 589.56,
   "text": "دقت بفرمایید چی عرض می‌کنم اشتباه نشه عددها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 589.56,
   "end": 593.48,
   "text": "هفتاد بار چهل روز پشت سر هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 593.48,
   "end": 597.68,
   "text": "هر بار هفتاد بار می‌خونی به یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 597.68,
   "end": 605.0,
   "text": "مثلا ظرف آب. بعد هر روز که دمیدنت تموم شد، اون هفتاد بار آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 605.0,
   "end": 612.42,
   "text": "سی و سه رو الرحمن خوندی و به این آب دمیدی در چهار گوشه خونه‌ت می‌پاشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 612.42,
   "end": 616.78,
   "text": "چهل روز، روزی هفتاد بار آیه سی و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 616.78,
   "end": 622.4,
   "text": "سوره الرحمن رو می‌خونی، می‌دمی به این آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 622.4,
   "end": 626.14,
   "text": "بعد تموم شد می‌ریزی چهار گوشه خونه‌ت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 626.14,
   "end": 628.98,
   "text": "حالا اگر رفتی سفر چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 628.98,
   "end": 633.24,
   "text": "تو سفر هم یه ظرف آبی برمی‌داری مثل یه بطری مثلا آب معدنی اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 633.24,
   "end": 636.06,
   "text": "بهش اونجا می‌خونی ولی دیگه نگهش می‌داری آبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 636.06,
   "end": 640.26,
   "text": "هر روز بهش می‌خونی برگشتی تهران مثلا منزلت می‌پاشی چهار گوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 640.26,
   "end": 645.38,
   "text": "مشکلی نداره. این هم از این و نکته آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 645.38,
   "end": 652.52,
   "text": "توی کتاب زمزمه عرفان که آقای ریشهری نوشته، اونجا اینو می‌تونید ببینید که آقای به، آقای بهجت یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 652.52,
   "end": 656.36,
   "text": "توصیه‌ای هم داره که ما تو هیچ کدوم از این توصیه‌هامون اینو نگفته بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 656.36,
   "end": 659.1,
   "text": "اینم خوبه بدونید به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 659.1,
   "end": 663.36,
   "text": "که آقای بهجت خودشون به آقای ریش، ریشهری گفته بودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 663.36,
   "end": 669.1,
   "text": "من قبل از این فتنه ها امام علیه الرحمه رو دیدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 669.1,
   "end": 677.18,
   "text": "بنیانگذار انقلاب رو. دیدم که جلوم تشریف دارن ولی خیلی قیافه رنجور و زشت کشیده‌ای دارن امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 677.18,
   "end": 679.98,
   "text": "بعد سکته کردن و مردن جلوی من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 679.98,
   "end": 684.52,
   "text": "کی؟ آقای بهجت میگه این مکاشفه برای من رخ داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 684.52,
   "end": 688.92,
   "text": "متوجه شدم که بلایی سر انقلاب میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 688.92,
   "end": 691.1,
   "text": "فتنه هایی به پا می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 691.1,
   "end": 695.66,
   "text": "که خیلی خطرناکه برای از بین رفتن انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 695.66,
   "end": 700.9,
   "text": "توجه کردید؟ بعد باید یه کارهایی کرد که ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 700.9,
   "end": 703.86,
   "text": "پیک می‌ده می‌فرسته به سمت رهبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 703.86,
   "end": 706.4,
   "text": "به آ-- رهبر عزیزمون می‌فرمود که من یه کارهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 706.4,
   "end": 714.26,
   "text": "خودم دارم می‌کنم اما نیاز هست که شما هم یه کارایی بکنی که بعد از طریق آقای حجازی روح 神 این‌ها رو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 714.26,
   "end": 718.08,
   "text": "کارهایی که رهبر باید انجام بده رو آقای بهجت به رهبر توصیه می‌کنند انجام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 718.08,
   "end": 720.22,
   "text": "میدن. حالا مطلوب اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 720.22,
   "end": 723.04,
   "text": "این من بیشتر به این خاطر گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 723.04,
   "end": 727.02,
   "text": "که به آقای ریشهری آقای بهجت می‌گه شما هم باید یه کاری بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 727.02,
   "end": 731.06,
   "text": "آقای ریشهری میگه ما چکار کنیم به جز دعا چه کاری از دستمون بر میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 731.06,
   "end": 733.87,
   "text": "می‌فرمود صدقه و قربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 733.87,
   "end": 736.99,
   "text": "صدقه و قربانی اصلا حدیث داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 736.99,
   "end": 739.63,
   "text": "تمام بلاها رو دفع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 739.63,
   "end": 744.03,
   "text": "صدقه و قرب-- خیلی. مرحوم آیه الله بعیدینی که می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 744.03,
   "end": 748.81,
   "text": "اگه می‌تونید ماهی یه بار قربانی کنید هر بلایی از زندگی‌تون دفع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 748.81,
   "end": 754.27,
   "text": "خب حالا با این سنگینی و گرونی گوشت و گوسفند کسی، کسی تا-- توانشو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 754.27,
   "end": 758.61,
   "text": "چند نفر بشید. تو فامیل‌تون، دوستاتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 758.61,
   "end": 762.15,
   "text": "اداره‌تون اینا با هم. ما تو هیئت‌مون این سنتو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 762.15,
   "end": 763.65,
   "text": "یا هر چه ده هزار تومن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 763.65,
   "end": 767.17,
   "text": "می‌تونی ماهانه بریزی که پنجاه هزار تومن هر چقدر می‌تونی بریزید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 767.17,
   "end": 770.87,
   "text": "این پولو جمع کنید با همدیگه یه قربانی انجام بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 770.87,
   "end": 773.7,
   "text": "ما یکی از طرح‌های خیریه‌مون اینه اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 773.7,
   "end": 779.25,
   "text": "بچه‌ها پول می‌ریزن ماهانه قربانی می‌کنیم ثوابش به همه می‌رسه بعد این تقسیم می‌شه رو همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 779.25,
   "end": 783.87,
   "text": "این حالا یه بحثی هم ما اینم تو لای پرانتز یه دقیقه به من وقت بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 783.87,
   "end": 787.35,
   "text": "می‌دونم فرصت گذشته‌م و اینا خیلی خوبه که بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 787.35,
   "end": 793.23,
   "text": "یه بحثی هم تو جداول أوفاقی داریم این خیلی بحث مطلوبی-- من الان ورود نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 793.23,
   "end": 800.09,
   "text": "که توصیه هم یه بار دیگه هم گفتم عزیزانی که میرن سراغ جداول أوفاقی جمع وفقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 800.09,
   "end": 803.65,
   "text": "نه آفاق که جمعش افقه، نه أوفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 803.65,
   "end": 808.75,
   "text": "این جدول‌ها حروفی که تو این جدول‌ها چیده می‌شه باید بینش وفق برقرار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 808.75,
   "end": 811.17,
   "text": "یعنی چیش بماند طلبتون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 811.17,
   "end": 813.73,
   "text": "تا می‌تونید سراغ این‌ها نرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 813.73,
   "end": 816.03,
   "text": "اگر می‌رید کسی باشه که علمشو داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 816.03,
   "end": 817.79,
   "text": "این جداول خیلی مهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 817.79,
   "end": 819.73,
   "text": "یهو برعکس عمل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 819.73,
   "end": 823.69,
   "text": "اون ادعیه‌ای که جدولی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 823.69,
   "end": 828.69,
   "text": "که می‌دونید بزرگ‌ترین جدول رو امیرالمؤمنین نوشت صد درصد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 828.69,
   "end": 832.25,
   "text": "صد درصد خانه داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 832.25,
   "end": 841.09,
   "text": "و تمام حروف آیات قرآن رو درش جا داد حضرت امیرالمؤمنین به عنوان حصن و پناه اهل اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 841.09,
   "end": 844.67,
   "text": "تنها کسی که بعد از-- خوبه که بدونید حالا بحث به اینجا کشیده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 844.67,
   "end": 850.37,
   "text": "بعد از امیرالمؤمنین تنها کسی که به این علم دست پیدا کرد علامه حسن زاده بود و برای اولین بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 850.37,
   "end": 855.59,
   "text": "بعد از امیرالمؤمنین این جدول رو دو مرتبه حضرت علامه حسن زاده نوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 855.59,
   "end": 858.43,
   "text": "خیلی سال پیش من اون موقع قم درس می‌خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 858.43,
   "end": 866.03,
   "text": "شاید حدود بیست، بیست و پنج سال پیش این حدودا علامه حسن زاده این جدول رو هدیه کرد به رهبر عزیزمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 866.03,
   "end": 870.81,
   "text": "اثرش چیه؟ مطلقا دشمن نمی‌تونه در تو تاثیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 870.81,
   "end": 875.25,
   "text": "یعنی هر کید و خدعه‌ای داشته باشه دشمن باطل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 875.25,
   "end": 879.41,
   "text": "این رو به عنوان حصن و پناه انقلاب در علم غریبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 879.41,
   "end": 881.3,
   "text": "علامه حسن زاده تقدیم رهبر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 881.3,
   "end": 886.41,
   "text": "اگه می‌بینید این همه ما دشمنامون زور می‌زنن نمی‌تونن نظام رو تکون بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 886.41,
   "end": 889.09,
   "text": "یه علتش اینه البته. یه علتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 889.09,
   "end": 893.99,
   "text": "انشاالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 893.99,
   "end": 900.83,
   "text": "اللهم صل على محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}