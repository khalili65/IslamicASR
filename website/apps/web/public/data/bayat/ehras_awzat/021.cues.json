 ],
 "cues": [
  {
   "i": 0,
   "start": 0.84,
   "end": 4.58,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.58,
   "end": 8.44,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.44,
   "end": 12.16,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.16,
   "end": 20.86,
   "text": "در ادامه بحث احراز و ادعیه و اواذات یه چند تا نکته دیگه به فضل الهی امروز تقدیم کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.86,
   "end": 25.34,
   "text": "هدیه شما باشه از حضرت‌های بهجت علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.34,
   "end": 32.1,
   "text": "که البته غالبش رو در کتاب بهجت و دعا می‌تونید ملاحظه کنید و ببینید اونجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.1,
   "end": 40.6,
   "text": "و انشاالله به امید خدا رد شیم و اگه بشه دیگه بریم به سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.6,
   "end": 47.12,
   "text": "شرح ادامه کتاب الموت مرحوم مجلسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.12,
   "end": 49.36,
   "text": "بعضیا سؤال کردن در خصوص گم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 49.36,
   "end": 51.66,
   "text": "آیا مثلاً ذکری هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.66,
   "end": 53.94,
   "text": "بله. برای پیدا شدن گم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.94,
   "end": 63.08,
   "text": "خود آقای بهجت می‌فرمودند که برای یافتن گم شده با اعتقاد کامل این ذکر رو زیاد تکرار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.08,
   "end": 69.04,
   "text": "اصبحت فی امان الله امسیت فی جوار الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 69.04,
   "end": 76.64,
   "text": "اینو زیاد بگید. یا یه دستورالعمل دیگه داشتن می‌فرمودند که دویست و دو بار آیه هفتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 76.64,
   "end": 80.64,
   "text": "سوره حجر رو برای پیدا شدن گم شده بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 80.64,
   "end": 85.62,
   "text": "این آیه که الم تعلم ان الله يعلم ما في السماء،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 85.62,
   "end": 90.34,
   "text": "يعلم ما في السماء والارض ان ذلک في کتاب ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 90.34,
   "end": 92.42,
   "text": "ذلک على الله يسیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 92.42,
   "end": 95.46,
   "text": "این آیه رو، آیه هفتاد سوره حجر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 95.46,
   "end": 99.54,
   "text": "دویست و دو بار قرائت کنید برای پیدا شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.54,
   "end": 103.52,
   "text": "گم شده. البته نذر حضرت ام البنین سلام الله عليه هم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.52,
   "end": 108.74,
   "text": "سلام الله عليهام که قبلاً من خدمتتون عرض کرده بودم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.74,
   "end": 113.54,
   "text": "مجرب هست و خود من چندین بار تجربه‌ش رو کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.54,
   "end": 118.46,
   "text": "اما برای بچه دار شدن بعضیا پرسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.46,
   "end": 125.98,
   "text": "بله آقای بهجت دستورالعملی که برای بچه دار شدن البته دارند، اشاره به همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 125.98,
   "end": 129.12,
   "text": "روایت شریفی می‌کردن همیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 129.12,
   "end": 135.68,
   "text": "که یه مرد شصت ساله‌ای از کمی فرزندانش به امام باقر سلام الله عليه شکایت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 135.68,
   "end": 138.4,
   "text": "که من صاحب فرزند نمی‌شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 138.4,
   "end": 143.44,
   "text": "بعد حضرت فرمودند که به مدت سه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 143.44,
   "end": 147.38,
   "text": "پس از نماز عشا و پس از نماز صبحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 147.38,
   "end": 154.54,
   "text": "هفتاد مرتبه بگو سبحان الله و هفتاد مرتبه بگو استغفرالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 154.54,
   "end": 159.18,
   "text": "بعد این آیات رو تکرار کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 159.18,
   "end": 163.36,
   "text": "استغفروا ربکم انه کان غفارا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 163.36,
   "end": 167.0,
   "text": "يرسل السماء عليكم مدرارا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 167.0,
   "end": 174.82,
   "text": "ويمددکم باموال وبنين ويجعل لکم جنات ويجعل لکم انهارا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 174.82,
   "end": 179.32,
   "text": "اگه خاطرتون باشه آیات ده تا دوازده سوره حضرت نوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 179.32,
   "end": 184.28,
   "text": "سلام الله عليه بود. بعد فرمودند که خب سه شب این کارو می‌کنین دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 184.28,
   "end": 190.56,
   "text": "فرمودند شب سوم با همسرت مجامعت کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 190.56,
   "end": 198.02,
   "text": "حضرت باقر. و انشاالله خدا بهت پسر سالمی عطا می‌کنه که راوی میگه این کارو انجام دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 198.02,
   "end": 202.36,
   "text": "یک سال نگذاشته بود که خدا به من فرزندی رو عنایت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 202.36,
   "end": 206.98,
   "text": "البته این روایت هم در بهجت و دعا هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 206.98,
   "end": 209.24,
   "text": "از قول آقای بهجت. هم اینکه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 209.24,
   "end": 214.14,
   "text": "مستدرک الوسائل هم جلد پونزده صفحه صد و بیست می‌تونید ببینید روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 214.14,
   "end": 217.68,
   "text": "رو. روایت دیگه‌ای هم هست البته در این موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 217.68,
   "end": 225.18,
   "text": "و یکی دیگه از توصیه‌های حضرت آقای بهجت در مورد بچه دار شدن این بود که فرمودند هم همس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 225.18,
   "end": 232.4,
   "text": "خانم هم شوهرشون هر دو انگشتر فیروزه‌ای رو به دست کنن که روش این آیه حک شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 232.4,
   "end": 237.22,
   "text": "رب لا تذرنی فردا وانت خیر الوارثین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 237.22,
   "end": 243.56,
   "text": "که آیه هشتاد و نه سوره انبیا باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 243.56,
   "end": 246.98,
   "text": "و اما عرض شود خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 246.98,
   "end": 249.88,
   "text": "در خصوص شفای بیمار هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 249.88,
   "end": 254.02,
   "text": "باز بعضیا توصیه داشتن با اینکه ما چند تا دستورالعمل دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 254.02,
   "end": 257.44,
   "text": "اما باز یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 257.44,
   "end": 260.72,
   "text": "دستور دیگه از آقای بهجت خدمتتون عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 260.72,
   "end": 271.24,
   "text": "در خصوص آب زمزم و تربت سید الشهدا فرمودند این دو تا رو با هم مخلوط کنید و هر روز مقدار اندکی به نیت شفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 271.24,
   "end": 277.14,
   "text": "منظم یعنی هر روز میل کنید تا اینکه انشاالله بهبودی حاصل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 277.14,
   "end": 283.02,
   "text": "همچنین در کنار این کار فرمودند که به نیت صدقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 283.02,
   "end": 285.34,
   "text": "هر مقدار که ولو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 285.34,
   "end": 293.56,
   "text": "حالا کم هم که باشه اگرچه کم باشه، زیاد باشه که چه بهتر اما توان ندارید اگرچه کم باشه اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 293.56,
   "end": 298.1,
   "text": "به افراد مختلف متعدد صدقه بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 298.1,
   "end": 300.72,
   "text": "همچنین باز فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 300.72,
   "end": 303.5,
   "text": "هفتاد بار سوره حمد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 303.5,
   "end": 307.22,
   "text": "به مخلوط آب زمزم و تربت بخونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 307.22,
   "end": 315.44,
   "text": "بدید مریض بخوره. و این رو البته این کار رو فرمودند به صورت مرتب هر روز بدید بخوره تا انشاالله شفا حاصل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 315.44,
   "end": 318.54,
   "text": "می‌فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 318.54,
   "end": 322.78,
   "text": "به نیت شفا هر روز هفت بار سوره حمد رو قرائت کنید هر روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 322.78,
   "end": 325.06,
   "text": "اونایی که مریض‌اند یا مریض دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 325.06,
   "end": 332.14,
   "text": "حتی فرمودند که وقتی به عیادت یه مریض می‌رید به نیت شفا سوره حمد رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 332.14,
   "end": 337.92,
   "text": "نمی‌شینید خوش و بش و اینا و اونا، می‌شینید سوره حمد رو به نیت شفا بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 337.92,
   "end": 344.2,
   "text": "باز ایشون فرمودند که برای شفا فرمودند پس از نماز صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 344.2,
   "end": 349.12,
   "text": "دورک از، نه خود مریض، دورک از نماز حاجت بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 349.12,
   "end": 355.68,
   "text": "بعد سه مرتبه این دعا رو بخونه که اللهم مشفنی بشفاعک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 355.68,
   "end": 361.32,
   "text": "و داونی بدواءک و عافنی بعافیتک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 361.32,
   "end": 367.48,
   "text": "من بلائک فاني عبدک وابن عبدک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 367.48,
   "end": 374.36,
   "text": "و تموم شد بگه به حرمت الامام کاظم علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 374.36,
   "end": 378.48,
   "text": "این هم یه دستور ایشون بود بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 378.48,
   "end": 381.64,
   "text": "شفای مریضی ها و اینها. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 381.64,
   "end": 383.66,
   "text": "یه دستور العمل دیگه هم خیلی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 383.66,
   "end": 386.02,
   "text": "جالبه این دستور رو من در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 386.02,
   "end": 394.74,
   "text": "عرض شود خدمتتون در مقاتل دیدم که وقتی حضرت امام سجاد صلی الله علیه وارد مجلس اون ملعون خبیث شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 394.74,
   "end": 398.56,
   "text": "در شام اون خبیث بهش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 398.56,
   "end": 402.94,
   "text": "یزید علیه اللعنه به حضرت عرض کرد این چیه دستت گرفتی و بیخود میچرخونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 402.94,
   "end": 409.5,
   "text": "حضرت یه تسبیح دستش بود و حضرت ماجراشو تعریف میکنه که البته در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 409.5,
   "end": 412.74,
   "text": "شریف دعوات راوندی صفحه شصت و یک هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 412.74,
   "end": 416.6,
   "text": "این روایت هست. در کتاب بحجت دو هم اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 416.6,
   "end": 419.78,
   "text": "که خود آقای بحجت مکرر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 419.78,
   "end": 423.62,
   "text": "می فرمودن شاگردهای ایشون از نزدیک باهاشون حشر و نشر داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 423.62,
   "end": 426.94,
   "text": "فرمودن مکرر این رو می فرموده آقای بحجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 426.94,
   "end": 439.12,
   "text": "که ذکری رو از امام سجاد صلی الله علیه هست که اگه گفته بشه و تسبیح رو بدون ذکر بچرخونی ثواب گفتن ذکر بهت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 439.12,
   "end": 444.94,
   "text": "و می فرمودن که این برای این شخص مایه فرج و گشایشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 444.94,
   "end": 449.54,
   "text": "این کار. حالا به این صورت که البته امام سجاد صلی الله علیه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 449.54,
   "end": 456.12,
   "text": "به نقل از رسول از پدرانشون تا رسول خدا نقل کردن این موضوع رو که فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 456.12,
   "end": 461.98,
   "text": "نماز صبح رو که تموم شد و خوندید با کسی سخن نگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 461.98,
   "end": 467.2,
   "text": "تسبیح خودتون رو به دست بگیرید و بگید اللهم انی اصبحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 467.2,
   "end": 471.0,
   "text": "اصبحت اصبحك و احمدك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 471.0,
   "end": 481.56,
   "text": "و احللک و اكبرك و امجدك بعدد ما ادیر بهی صبحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 481.56,
   "end": 486.72,
   "text": "یعنی خدایا همانا من صبح میکنم در حالی که تو رو تسبیح میگم، تنزیه میکنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 486.72,
   "end": 495.22,
   "text": "ستایش میکنم، تحلیل میگم یعنی لا اله الا الله به عدد آنچه ت-- میچرخونم تسبیحم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 495.22,
   "end": 499.9,
   "text": "بعد حالا تسبیح دستش میگیره همونطوری که دستشو میچرخونه همونطوری ثواب ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 499.9,
   "end": 504.04,
   "text": "رو بهش میگن. بعد البته ایشون می فرمودن که امام سجاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 504.04,
   "end": 513.12,
   "text": "علیه السلام تا شب همچنین بودند تا وقتی که به رخت خواب میرفتن دوباره اون ذکر رو تکرار میکردن و تسبیح رو زیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 513.12,
   "end": 515.18,
   "text": "سرشون میذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 515.18,
   "end": 521.52,
   "text": "اما یکی از ذکر هایی که خیلی خیلی خیلی آقای بحجت به شدت بهش اصرار داشتن صلوات بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 521.52,
   "end": 526.04,
   "text": "صلوات این ذکر این چیزی که حالا قبلاً هم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 526.04,
   "end": 534.12,
   "text": "مطالبی رو در همین خصوص عرض کردیم که مثلاً روایت ش-شریفی که در مستدرک الوسائل هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 534.12,
   "end": 540.2,
   "text": "بحار هست، جامع الاخبار هست اینها که من صلي علي مرتاً لبی-- لم يبق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 540.2,
   "end": 542.3,
   "text": "له من ذنوبه ذرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 542.3,
   "end": 546.36,
   "text": "خدا فرموده که هر کسی یه بار اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 546.36,
   "end": 551.6,
   "text": "عرض شود-- پیغمبر عزیز عالم فرمودن هر کس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 551.6,
   "end": 555.64,
   "text": "یه بار به من صلوات بفرسته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 555.64,
   "end": 557.38,
   "text": "من صلي علي مرتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 557.38,
   "end": 560.1,
   "text": "یه بار به من صلوات بفرسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 560.1,
   "end": 563.79,
   "text": "یک ذره از گناه هاش باقی نمیمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 563.79,
   "end": 566.46,
   "text": "البته با اعتقاد، با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 566.46,
   "end": 571.12,
   "text": "عرض شود با عشق، با توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 571.12,
   "end": 574.52,
   "text": "باید با محبت، محبت زیاد باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 574.52,
   "end": 577.72,
   "text": "به شرط عقیده دیگه انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 577.72,
   "end": 585.14,
   "text": "همچنین در موارد خیلی زیادی آقای بحجت توصیه به اکثار زیاد صلوات فرستادن داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 585.14,
   "end": 589.39,
   "text": "مثلاً در قبیل تحصیل حلم و بدباری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 589.39,
   "end": 592.94,
   "text": "اونایی که صبرشون کمه زود عصبانی میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 592.94,
   "end": 596.14,
   "text": "فرمودن برای نفی خواطر اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 596.14,
   "end": 601.26,
   "text": "خاطرات و یا افکار خیلی زشت و پلید تو ذهنشون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 601.26,
   "end": 604.16,
   "text": "اکثار صلوات. درمان عصبانیت فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 604.16,
   "end": 606.76,
   "text": "ایجاد مهر و محبت میان زن و شوهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 606.76,
   "end": 609.1,
   "text": "اونایی که بعضیا سؤال کرده بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 609.1,
   "end": 618.9,
   "text": "ارائه‌ش اینه. برطرف شدن مشکلات زندگی حتی جالبه که در کتاب بحجت دو من دو مرتبه رجوع کردم چون بعضیا سؤال پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 618.9,
   "end": 620.72,
   "text": "راه درمان اعتیاد داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 620.72,
   "end": 623.62,
   "text": "دیدم آقای بحجت جالبه که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 623.62,
   "end": 627.9,
   "text": "رهایی از اعتیاد سفارش به اکثار بر صلوات داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 627.9,
   "end": 630.42,
   "text": "که کارها رو آسون میکنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 630.42,
   "end": 636.38,
   "text": "حتی ایشون فرموده بودند که یه بار تو ایام زیارتی به کربلا رفته بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 636.38,
   "end": 642.08,
   "text": "حرم حضرت ابالفضل علیه السلام خیلی شلوغ بوده ظاهراً که به هیچ وجه نمیشده نزدیک ضریح بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 642.08,
   "end": 649.6,
   "text": "ایشون چند تا صلوات می فرستن بعد میگن که من جلو رفتم دیدم چسبیدم به ضریح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 649.6,
   "end": 655.7,
   "text": "اینا دیگه فرمایش خودشونه و امیدوارم که ما اینها رو جدی بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 655.7,
   "end": 660.08,
   "text": "باز برای درمان وسواس خیلیا سؤال داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 660.08,
   "end": 661.94,
   "text": "وسوسه، وسواس. وسواس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 661.94,
   "end": 670.54,
   "text": "اونایی که دچار وسواس و استرس و وسوسه های اعتقادی و کنترل خیال و وهم و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 670.54,
   "end": 672.4,
   "text": "اکثار ذکر لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 672.4,
   "end": 674.44,
   "text": "تحلیل بدون عدد تا میتونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 674.44,
   "end": 677.06,
   "text": "آقای بحجت خیلی سفارش داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 677.06,
   "end": 683.32,
   "text": "یا برای درمان غرور بعضیا گفتن ما چه کنیم از تکبر و غرور یا حتی ریا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 683.32,
   "end": 686.08,
   "text": "نجات پیدا کنیم. آقای بحجت خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 686.08,
   "end": 688.5,
   "text": "به ذکر شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 688.5,
   "end": 690.14,
   "text": "هغله اصرار داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 690.14,
   "end": 693.28,
   "text": "همون لا حول ولا قوه الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 693.28,
   "end": 696.7,
   "text": "تأکید به این ذکر داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 696.7,
   "end": 699.46,
   "text": "و البته زیاد هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 699.46,
   "end": 706.3,
   "text": "از کاری که دستور العمل هایی که ایشون گفتن که حالا به همین مقدار اکتفا میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 706.3,
   "end": 711.68,
   "text": "من خواهشم از دوستان اینه که چون بعضیا سؤال میپرسن یا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 711.68,
   "end": 715.36,
   "text": "مدیر کانال پیام میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 715.36,
   "end": 719.22,
   "text": "در خصوص مشکلاتشون، میبینم دقیقاً همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 719.22,
   "end": 728.96,
   "text": "مشکلی که دارن، مسئله ای که مد نظرشونه ما راهکارشو تو این چند جلسه گفتیم و برام عجیبه که مثلاً گوش نمیدن مگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 728.96,
   "end": 735.52,
   "text": "به هر حال غالب اون چیزهایی که عزیزان پیش بودن و دنبالش بودند رو ما عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 735.52,
   "end": 741.18,
   "text": "فقط یک موضوع موند ان شا الله به وقتش بحث ذکر عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 741.18,
   "end": 745.9,
   "text": "ذکر عملیی که حالا اون هم ان شا الله یه جلسه ای باید درباره‌ش صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 745.9,
   "end": 751.9,
   "text": "به غیر از فارغ از این اذکار و اوراد، ورد که بر زبان جاری میشه، اعمال عملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 751.9,
   "end": 756.3,
   "text": "که حالا خیلی اجمالاً عرض کنم رد شم مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 756.3,
   "end": 760.64,
   "text": "اینکه شما در عملیات بندگی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 760.64,
   "end": 766.98,
   "text": "زندگی، در عرض شود خورد و خوراک، پوشاک، اونایی که البته قبلاً هم عرض کرده بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 766.98,
   "end": 771.04,
   "text": "به گونه ای عمل کنی که مزاجت به سمت اعتدال بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 771.04,
   "end": 773.08,
   "text": "اینا خودش یه ذکر عملیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 773.08,
   "end": 779.92,
   "text": "یا عسل. عسل درمانی که قرآن دو چیز رو شفا ذکر فرموده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 779.92,
   "end": 782.8,
   "text": "یکی خود قرآنه، یکی هم عسله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 782.8,
   "end": 786.42,
   "text": "حالا یه جلسه ای شاید در خصوص عسل ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 786.42,
   "end": 791.6,
   "text": "و عرض شود اثر شفا بخشیش صحبت کردیم که فرمایش خداست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 791.6,
   "end": 793.46,
   "text": "اینا رو باید جدی بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 793.46,
   "end": 795.56,
   "text": "ان شا الله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 795.56,
   "end": 797.61,
   "text": "به برکت صلوات بر محمد و آل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}