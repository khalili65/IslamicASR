  },
  {
   "index": 1,
   "title": "## بازگشت بحث به اجنه و آثار ضربهٔ آنان",
   "start": 74.38,
   "end": 165.94
  },
  {
   "index": 2,
   "title": "## روایت چهار پناهگاه از امام صادق علیه‌السلام",
   "start": 165.94,
   "end": 222.88
  },
  {
   "index": 3,
   "title": "## پناه از ترس: حسبنا الله و نعم الوکیل",
   "start": 222.88,
   "end": 247.14
  },
  {
   "index": 4,
   "title": "سپس حضرت به ادامهٔ همین آیهٔ قرآن اشاره می‌کنند:",
   "start": 247.14,
   "end": 310.94
  },
  {
   "index": 5,
   "title": "راه نجاتش را حضرت فرمود: چگونه کسی گرفتار غم است و پناه نمی‌برد به این ذکر:",
   "start": 310.94,
   "end": 343.12
  },
  {
   "index": 6,
   "title": "## دستور بزرگان در ذکر یونسیه",
   "start": 343.12,
   "end": 477.42
  },
  {
   "index": 7,
   "title": "## پناه از مکر و حیله",
   "start": 477.42,
   "end": 521.78
  },
  {
   "index": 8,
   "title": "حضرت باز به دنبالهٔ آیه اشاره کردند. فرمودند نمی‌بینید بقیه‌اش آمده:",
   "start": 521.78,
   "end": 668.3
  },
  {
   "index": 9,
   "title": "## تعویذ چشم و ضعف باصره",
   "start": 668.3,
   "end": 689.2
  },
  {
   "index": 10,
   "title": "## حکایت سقوط از کوه در دهلران",
   "start": 689.2,
   "end": 710.26
  },
  {
   "index": 11,
   "title": "## ختم جلسه",
   "start": 710.26,
   "end": 795.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.5,
   "end": 11.84,
   "text": "الله الله الله الله الله الله الله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.84,
   "end": 14.9,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.9,
   "end": 20.2,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.2,
   "end": 22.8,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.8,
   "end": 25.32,
   "text": "امروز روز به رحمت حق رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.32,
   "end": 28.84,
   "text": "حاج فرج الله صلاح شور هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.84,
   "end": 32.44,
   "text": "این انسان انقلابی و مثمرثمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.44,
   "end": 35.24,
   "text": "که هشتم اسفند به رحمت خدا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.24,
   "end": 38.12,
   "text": "یه جمله‌ی رهبر عزیزمون دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.12,
   "end": 46.3,
   "text": "می‌فرمایند که باید کار انقلابی را ترویج کرد و نیروهای انقلابی را گرامی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.3,
   "end": 53.46,
   "text": "مانند کارهایی که شاهدان هسته‌ای کردند، کارهایی که شهید تهرانی مقدم در موشکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.46,
   "end": 57.24,
   "text": "مرحوم کاظمی در سلول‌های بنیادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.24,
   "end": 64.18,
   "text": "و شهید آوینی و مرحوم صلح شور در امور فرهنگی پیشاهنگ آن بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.18,
   "end": 69.32,
   "text": "یعنی رهبری هم از ایشون به عظمت یاد کردند که پیشاهنگ بودند در امور فرهنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.32,
   "end": 72.76,
   "text": "یعنی می‌شه گفت یک شخصیت تراز داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.76,
   "end": 74.38,
   "text": "روحشون شاد باشه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.38,
   "end": 77.66,
   "text": "بحث ما پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.66,
   "end": 81.26,
   "text": "حالا شرح کتاب الموت مرحوم مجلسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.26,
   "end": 84.1,
   "text": "کشیده شد به موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.1,
   "end": 87.8,
   "text": "ارتباط با اجنه و ورود اون‌ها به زندگی‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.8,
   "end": 92.16,
   "text": "اتفاقاتی که در زندگی رخ می‌ده و نحوه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.16,
   "end": 95.46,
   "text": "دفع اون‌ها، باطل کردن سحر و جادوشون و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.46,
   "end": 98.4,
   "text": "وقتی که جن یا اجنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.4,
   "end": 102.78,
   "text": "ضربه‌ای به ما می‌زنن، خب به انواع مختلف این ضربه‌ها وارد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.78,
   "end": 106.56,
   "text": "گاهی اوقات با طلسم و سحر و موکل‌هایی که دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.56,
   "end": 110.34,
   "text": "مثلاً آدم‌های شیطانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.34,
   "end": 116.82,
   "text": "می‌بندن به اصطلاحاً می‌گن بسته می‌کنند، می‌بندن، بسته می‌شه روزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.82,
   "end": 118.72,
   "text": "رزق آدم بسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.72,
   "end": 121.62,
   "text": "نه اینکه رزق نداری، بسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.62,
   "end": 123.3,
   "text": "یا با چشم، با چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.3,
   "end": 134.0,
   "text": "جن می‌شه انسان چشم درد بگیره، نور چشمش کم شه، می‌شه انسان بترسه یا مغموم و مهموم بشه، غم‌زده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.0,
   "end": 137.0,
   "text": "به هر حال مکر و حیله‌ی دیگران به انسان برخورد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.0,
   "end": 141.88,
   "text": "همه‌ی این‌ها رو اهل بیت علیهم السلام براش دستورات دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.88,
   "end": 144.32,
   "text": "یه چند تاش رو ما برای مطلقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.32,
   "end": 149.2,
   "text": "بطلان سحر و عرض شود طلسم و جادو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.2,
   "end": 152.04,
   "text": "اجنه و این‌ها عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.04,
   "end": 157.06,
   "text": "و منتها خب اگر آثار اون هنوز باقی مونده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.06,
   "end": 162.06,
   "text": "به عنوان نمونه یکی از روایت‌های، روایت‌های بسیار عالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.06,
   "end": 164.98,
   "text": "از امام صادق صلی الله علیه داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.98,
   "end": 170.34,
   "text": "تقدیم می‌کنم. قطعاً توجه داشتید این در مفاتیح وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.34,
   "end": 178.96,
   "text": "شیخ عباس علیه الرحمه آورده البته در کتاب ملا یهزرالفقیه جلد چهار صفحه سیصد و نود و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.96,
   "end": 181.76,
   "text": "همچنین خصال شیخ صدوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.76,
   "end": 186.3,
   "text": "جلد دو صفحه دویست و هجده هم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.3,
   "end": 189.46,
   "text": "روایت مستند معتبر بسیار عالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.46,
   "end": 193.66,
   "text": "که امام صادق صلی الله علیه فرمود در شگفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.66,
   "end": 196.86,
   "text": "امام ما، شما از چی در شگفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.86,
   "end": 201.52,
   "text": "فرمود برای کسی که از چهار چیز بیم دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.52,
   "end": 206.42,
   "text": "چهار تا گرفتاریه که خیلی‌ها الان گرفتار این چهار تا هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.42,
   "end": 209.68,
   "text": "حداقل یه دونه‌شو غالباً گرفتارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.68,
   "end": 211.8,
   "text": "چگونه که گرفتار این چیزا می‌شن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.8,
   "end": 216.08,
   "text": "بیم دارند حضرت می‌فرماید اما به چهار چیز پناه نمی‌برند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.08,
   "end": 222.88,
   "text": "این پیدا، پیداست که چهار تا درمان رو این چهار تا درد رو چهار تا درمان براش حضرت بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.88,
   "end": 232.6,
   "text": "فرمود در شگفتم از کسی که ترس بر او غلبه کرده، می‌ترسه و چگونه به ذکر حسبنا الله ونعم الوکیل پناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.6,
   "end": 237.4,
   "text": "نمی‌برد. بعد حضرت اشاره می‌کنند به ادامه‌ی این آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.4,
   "end": 245.96,
   "text": "ادامه، ادامه‌ش حسبنا الله ونعم الوکیل ادامه‌ش فانقلبوا بنعمت من الله وفضل لم یمسسهم سوء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.96,
   "end": 255.24,
   "text": "که این‌ها چون حضرت اشاره می‌کنه که اصلاً وعده‌ی الهیه که بعد از این تو همین آیه اومده که خداوند این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 255.24,
   "end": 260.1,
   "text": "دگرگون می‌کنه، نعمتی بهشون می‌بخشه از فضلش به گونه‌ای که دیگه هیچ بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 260.1,
   "end": 264.36,
   "text": "به این‌ها نمی‌رسه. یعنی از ترس نجاتشون می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 264.36,
   "end": 267.88,
   "text": "خب حضرت می‌فرماید این نشون می‌ده که راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 267.88,
   "end": 270.12,
   "text": "نجات از تخویف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 270.12,
   "end": 274.52,
   "text": "شیاطینه. اینکه از شیاطین بترسند این‌ها، این راهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 274.52,
   "end": 278.7,
   "text": "بعد فرمود در شگفتم از کسی که اندوهگینه، غم‌زده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 278.7,
   "end": 281.38,
   "text": "گاهی آقا دوزاد روزی غصه سنگین می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.38,
   "end": 284.34,
   "text": "قبض می‌گیرش، بسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.34,
   "end": 286.32,
   "text": "اصلاً غمی وجودش رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.32,
   "end": 289.24,
   "text": "حزن خوبه، غم بده، غصه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.24,
   "end": 291.24,
   "text": "حزن، حزن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.24,
   "end": 293.38,
   "text": "همیشه مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.38,
   "end": 297.08,
   "text": "حزن همراهشه. حتی تو شوخی‌ها، خنده‌هاش حزن رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.08,
   "end": 299.44,
   "text": "یعنی یه وقاری داره. اما غم خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 299.44,
   "end": 303.04,
   "text": "غصه خوب نیست. راه نجاتش حضرت فرمود چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.04,
   "end": 310.94,
   "text": "کسی گرفتار غمه و پناه نمی‌بره به این ذکر لا اله الا انت سبحانک انی کنت من الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.94,
   "end": 313.62,
   "text": "این ذکر یونسیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.62,
   "end": 321.88,
   "text": "حضرت اشاره می‌کنند که ندیدید که بعد از همین عبارت تو قرآن می‌فرماید فاستجبنا له ونجیناه من الغم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 321.88,
   "end": 328.0,
   "text": "پس ما استجابت کردیم وقتی که یونس این ذکر رو گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 328.0,
   "end": 333.86,
   "text": "و نجاتش دادیم از غم وکذالک ننجی المؤمنین و همین چنین هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 333.86,
   "end": 336.16,
   "text": "سنت ما برای همه‌ی اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 336.16,
   "end": 341.9,
   "text": "یعنی هر کسی که این ذکر رو اکثارش مخصوصاً این‌ها بگه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 341.9,
   "end": 346.36,
   "text": "تاثیر داره که حالا من در عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 346.36,
   "end": 355.08,
   "text": "فرمایشات بزرگان دقت می‌کردم خیلی برام جالب بود که دیدم آقای کشمیری می‌فرمود بهترین کار برای سالک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 355.08,
   "end": 360.26,
   "text": "سجده است و بهترین ذکر در سجده ذکر یونس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 360.26,
   "end": 364.58,
   "text": "همین لا اله الا انت سبحانک انی کنت من الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 364.58,
   "end": 368.12,
   "text": "مرحوم انصاری همدانی این عارف به الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 368.12,
   "end": 371.18,
   "text": "فرمودند که ذکر یونسیه چه تعبیر قشنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 371.18,
   "end": 373.66,
   "text": "برای سالک مثل سوخت برای ماشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 373.66,
   "end": 377.16,
   "text": "یعنی کسی که اینو نداره اصلا نمی‌تونه حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 377.16,
   "end": 381.12,
   "text": "مرحوم آقای عرض شود خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 381.12,
   "end": 382.98,
   "text": "کشمیری یه دستورالعملی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 382.98,
   "end": 387.04,
   "text": "می‌فرماید بعد از هر نماز در سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.04,
   "end": 391.54,
   "text": "یه اربعین بگیر. بعد از هر نمازت در سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 391.54,
   "end": 398.18,
   "text": "چهل بار بگو لا اله الا انت سبحانک انی کنت من الظالمین قطعاً قضای حاجت رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 398.18,
   "end": 406.2,
   "text": "یعنی حاجتت روا می‌شه و ایشون تاکید می‌کنه مجربه و هر حاجتی که داری مطلقه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 406.2,
   "end": 411.42,
   "text": "یا پیامبر عزیز عالم فرمودند که ذکر یونسیه اسم اعظم خداوند است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 411.42,
   "end": 416.16,
   "text": "که اگر خدا را با آن بخوانند اجابت قطعی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 416.16,
   "end": 418.64,
   "text": "این ذکر یونسیه که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 418.64,
   "end": 421.84,
   "text": "آقای قاضی در بسیاری از شاگردان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 421.84,
   "end": 430.32,
   "text": "آقا قاضی مخصوصاً آقای بهجت می‌فرمودند اولین دستورالعملی که آقای قاضی به شاگردانش می‌داد همین ذکر یونسیه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 430.32,
   "end": 435.56,
   "text": "برای اونا که سالکن برنامه دارن میخوان به سمت حضرت حق در حرکت باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 435.56,
   "end": 440.18,
   "text": "یله و رها نیستن فقط دنیاشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 440.18,
   "end": 442.44,
   "text": "به فکر باشن و دنیاشون رو آباد کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 442.44,
   "end": 445.16,
   "text": "نه، دنبال اصلا دنیا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 445.16,
   "end": 447.7,
   "text": "پولی قرار دادن برای آبادانی آخرتشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 447.7,
   "end": 449.93,
   "text": "یعنی برنامه دارن. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 449.93,
   "end": 458.3,
   "text": "این‌ها که اصلا فرمودن دیگه حداقلش چهارصد بار گفتن این ذکر در دل سح-سحر در سجده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 458.3,
   "end": 467.74,
   "text": "حالا حداقلش برای آدمای ضعیفی مثل من حداقلش یک بار بعد از هر نمازی در سجده گفته بشه خیلی برکات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 467.74,
   "end": 469.3,
   "text": "پس غم رو برطرف می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 469.3,
   "end": 475.44,
   "text": "اگر این غم اثر تصرف اجنه باشه و سحر و جادو و طلسماتشونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 475.44,
   "end": 479.44,
   "text": "ذکر برطرف می‌کنه. و دیگر فرمودند که حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 479.44,
   "end": 484.48,
   "text": "حضرت صادق صلوات الله علیه فرمود در شگفتم برای کسی که مورد مکر و حیله واقع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 484.48,
   "end": 490.22,
   "text": "خیلیا الان دچار مکر و حیله می‌شن متاسفانه حتی تو وادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 490.22,
   "end": 497.02,
   "text": "ادارجات خیلی ما می‌بینیم کسایی که میان مدعی‌اند که آقا مثلا ما رو زدن زیر پای ما رو خالی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 497.02,
   "end": 498.84,
   "text": "اصطلاحا میگن زیر آبمونو زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 498.84,
   "end": 501.06,
   "text": "چرا؟ اینا مکر و حیله‌ست دیگه. خود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 501.06,
   "end": 510.4,
   "text": "نیرنگ. اینجا فرمود چگونه پناه نمی‌برن به ذکر افوض امری الى الله ان الله بصير بالعباد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 510.4,
   "end": 515.64,
   "text": "به به به. که حضرت اشاره کردن باز به دنبال بقیه این آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 515.64,
   "end": 521.78,
   "text": "فرمودند نمی‌بینید بقیه‌ش اومده فوقاه الله سیئات ما مکروا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 521.78,
   "end": 525.5,
   "text": "یعنی خدای منان فوقاه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 525.5,
   "end": 530.36,
   "text": "الله او رو حفظ می‌کنه از بدی اون‌هایی که بهش مکر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 530.36,
   "end": 532.9,
   "text": "در خصوص حضرت موسی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 532.9,
   "end": 537.1,
   "text": "وقتی گرفتار فرعونیان شد، خدا او را از بدی‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 537.1,
   "end": 544.52,
   "text": "فرعون حفظ کرد و چهارمیش فرمود در شگفتم برای کسی که اینو میگم غالبا الان مخصوصا توی فشارهای اقتصادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 544.52,
   "end": 547.4,
   "text": "خب بسم الله. آقا تعویذ امام صادقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 547.4,
   "end": 550.44,
   "text": "دستور حضرته. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 550.44,
   "end": 552.7,
   "text": "به یک معنا می‌شه گفت هرزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 552.7,
   "end": 555.5,
   "text": "یا دستور ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 555.5,
   "end": 558.21,
   "text": "نجات از بحران اقتصادی امام صادقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 558.21,
   "end": 562.38,
   "text": "خب انجام بدید اگر اثرشو ندیدید اون موقع نق بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 562.38,
   "end": 567.08,
   "text": "بنده به شخصه هر وقت تو کل عمرم هر وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 567.08,
   "end": 574.32,
   "text": "فشار به حد ریخت شد از جهت اقتصادی که واقعا دیگه مستاصل شدم، پناه به این آیه بردم و سریع نتیجه دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 574.32,
   "end": 583.14,
   "text": "بنده حقیر اینو خودم تجربه کردم و حضرت فرمود که در شگفتم از کسی که دنبال طالب دنیا و زیبایی‌های دنیاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 583.14,
   "end": 586.42,
   "text": "چگونه پناه نمی‌بره به این ذکر که آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 586.42,
   "end": 590.84,
   "text": "ما شاء الله لا قوة الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 590.84,
   "end": 593.02,
   "text": "لا حوله نداره. این آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 593.02,
   "end": 597.66,
   "text": "ما شاء الله لا قوة الا بالله به همین راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 597.66,
   "end": 603.86,
   "text": "که حالا بعد اشاره می‌کنه به اینکه نمی‌بینید بعد از این قسمت تو خود قرآن چی اومده که ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 603.86,
   "end": 607.9,
   "text": "ترنه اون دو تا ثروتمند و فقیر به هم رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 607.9,
   "end": 613.34,
   "text": "فقیره به اون ثروتمنده گفت \"ان ترنی انا اقل منك مالا و ولدا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 613.34,
   "end": 618.42,
   "text": "که تو من اگرچه از جهت مال و فرزند از تو کمترم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 618.42,
   "end": 622.2,
   "text": "اما \"فعسى ربی ان يؤتینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 622.2,
   "end": 625.8,
   "text": "خيرا من جنتک\" حالا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 625.8,
   "end": 628.74,
   "text": "امید دارم که انشاالله خدا بهتر از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 628.74,
   "end": 631.72,
   "text": "حالا باغی که تو د-داری رو به من بده این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 631.72,
   "end": 639.64,
   "text": "که حضرت تصریح می‌کنه که بیان این ذکر انسان رو به جایی می‌رسونه که حالا شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 639.64,
   "end": 646.32,
   "text": "نباید بگم اما برای کسایی که حوصله‌شون بیشتره و انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 646.32,
   "end": 651.94,
   "text": "می‌تونن بیشتر وقت بذارن یا به یک معنا گرفتاری اقتصادیشون بیشتره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 651.94,
   "end": 656.76,
   "text": "عدد ابجدی که طوفانی عمل می‌کنه در این ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 656.76,
   "end": 659.68,
   "text": "هزار و چهل و شش مرتبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 659.68,
   "end": 663.5,
   "text": "یعنی کسی هزار و چهل و شش مرتبه هر روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 663.5,
   "end": 668.3,
   "text": "ما شاء الله لا قوة الا بالله رو بگه اثرش رو ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 668.3,
   "end": 675.66,
   "text": "در خصوص چشم هم یه تعویذی عرض کنم و السلام که این رو هم باز در روایات داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 675.66,
   "end": 679.22,
   "text": "یه وقت بالاخره چشم جن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 679.22,
   "end": 681.62,
   "text": "به انسان بخوره بزنه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 681.62,
   "end": 683.7,
   "text": "مشکلی برای چشم انسان ایجاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 683.7,
   "end": 687.2,
   "text": "فرمودن برای ضعف باصره این نافعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 687.2,
   "end": 690.33,
   "text": "دست به چشم بگذار این دعا رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 690.33,
   "end": 697.0,
   "text": "\"اعوذ نور بصری بنور الله الذي لا یطفأ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 697.0,
   "end": 701.16,
   "text": "وقتی اینو گفتی آیت‌الکرسی رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 701.16,
   "end": 703.42,
   "text": "اعوذ حالا عزیزان تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 703.42,
   "end": 705.64,
   "text": "کانال گذاشتن اونجا پیاده کنید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 705.64,
   "end": 711.28,
   "text": "اعوذ می‌تونید تو قسمت اوذات مفاتيح ببینید اونجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 711.28,
   "end": 717.24,
   "text": "اوذات. اعوذ نور بصری بنور الله الذي لا یطفأ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 717.24,
   "end": 721.42,
   "text": "بعد آیت‌الکرسی رو بخون که انگشت‌هات رو گذاشتی رو چشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 721.42,
   "end": 729.1,
   "text": "یه در کنار این از بزرگان از اساتیدمون یه هدیه دیگه تقدیم کنم که بعد از اینکه تا آیت‌الکرسی رو خوندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 729.1,
   "end": 739.1,
   "text": "میگی الله همونطور که هستی رو چشمت الله محفظ حدقتي بحق حدقة امیر المؤمنین علی ابن ابی طالب علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 739.1,
   "end": 744.22,
   "text": "خدا چشم منو حفظ کن به حق حدقه چشم امیر المؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 744.22,
   "end": 747.72,
   "text": "من به شما این رو بگم معجزه‌ای که دیدم من توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 747.72,
   "end": 750.32,
   "text": "دهلران از بیست متر کوه افتادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 750.32,
   "end": 756.32,
   "text": "توی دهلران جنگ از بیست متر از کوه‌های جنگی افتادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 756.32,
   "end": 759.2,
   "text": "بعد سه تا مهره گردنم شکست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 759.2,
   "end": 762.98,
   "text": "دکترها جوابم کردن گفتن این شش ماه بیشتر زنده نمی‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 762.98,
   "end": 767.62,
   "text": "چشمام یه لحظه شطرنجی شد یعنی شطرنجی می‌دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 767.62,
   "end": 770.8,
   "text": "خدای این حسینه رو شاهد می‌گیرم که همین یادم اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 770.8,
   "end": 775.54,
   "text": "انگشتامو گذاشتم رو چشم و همین آیت‌الکرسی رو به همین و این دعا رو خوندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 775.54,
   "end": 781.24,
   "text": "تا دستمو ورداشتم دیدم رفته این شطرنجی و دیگه این اتفاق برای چشمام نیفتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 781.24,
   "end": 784.78,
   "text": "این معجزه می‌گفتم باید عمل شه معلوم نیست خوب شه نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 784.78,
   "end": 786.62,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 786.62,
   "end": 789.9,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 789.9,
   "end": 795.46,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}