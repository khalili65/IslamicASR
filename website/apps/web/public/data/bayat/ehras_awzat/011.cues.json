 "chapters": [
  {
   "index": 0,
   "title": "## بازگشت به بحث صلوات و حضرت زهرا سلام‌الله‌علیها",
   "start": 29.62,
   "end": 64.36
  },
  {
   "index": 1,
   "title": "## رؤیای صادقهٔ سید بحر العلوم",
   "start": 64.36,
   "end": 97.06
  },
  {
   "index": 2,
   "title": "رفتم دست پیامبر را بوسیدم. حضرت فرمودند:",
   "start": 97.06,
   "end": 228.0
  },
  {
   "index": 3,
   "title": "چون بحث ما در اذکار و ادعیه و عوذات به صلوات رسیده بود، صلوات خانم را گفتیم که از متن احادیث آمده است:",
   "start": 228.0,
   "end": 261.98
  },
  {
   "index": 4,
   "title": "## ابراهیم خلیل‌الرحمان و دوام صلوات",
   "start": 261.98,
   "end": 297.2
  },
  {
   "index": 5,
   "title": "## صلوات ضرّاب اصفهانی",
   "start": 297.2,
   "end": 336.2
  },
  {
   "index": 6,
   "title": "## صلوات رمزی پس از نماز امیرالمؤمنین علیه‌السلام",
   "start": 336.2,
   "end": 515.16
  },
  {
   "index": 7,
   "title": "## صلوات مأثور؛ بهترین ذکر برای دفع اجنه و ازدیاد رزق",
   "start": 515.16,
   "end": 595.32
  },
  {
   "index": 8,
   "title": "نکتهٔ آخر، برای آدم‌های تنبل مثل خودم؛ و برای امروز کفایت می‌کند.",
   "start": 595.32,
   "end": 615.54
  },
  {
   "index": 9,
   "title": "کل، کل، کل، کل.",
   "start": 615.54,
   "end": 690.51
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 2.46,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.46,
   "end": 4.88,
   "text": "صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 4.88,
   "end": 8.9,
   "text": "وآل محمد وعجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.9,
   "end": 14.88,
   "text": "اللهم صل على محمد وآل محمد وعجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.88,
   "end": 20.62,
   "text": "فرجهم. بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.62,
   "end": 26.74,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.74,
   "end": 29.62,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.62,
   "end": 32.68,
   "text": "بحث صلوات ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.68,
   "end": 36.3,
   "text": "به حضرت زهرا سلام الله علیها بود به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.3,
   "end": 41.82,
   "text": "یه اخص از کار و تاثیرات خاص این صلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.82,
   "end": 46.38,
   "text": "و کلاً مطلق صلوات به عنوان بهترین ذکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.38,
   "end": 51.38,
   "text": "بهترین پناه، بهترین امان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.38,
   "end": 55.66,
   "text": ". و یاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.66,
   "end": 58.26,
   "text": "فرمایش سید بحر العلوم افتادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.26,
   "end": 61.84,
   "text": "دیروز دیگه فرصت نشد که ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.84,
   "end": 68.26,
   "text": "امروز عرض کنم که ایشون خودشون سید بحر العلوم که جزو کمالین بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.26,
   "end": 72.34,
   "text": "می‌فرمایند که در رؤیای صادقه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.34,
   "end": 75.54,
   "text": "پیغمبر عزیز عالم رو مشاهده کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.54,
   "end": 80.26,
   "text": "و دیدم کنار پیغمبر امیرالمؤمنین ایستاده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.26,
   "end": 86.54,
   "text": "حسنین نشستن و حضرت زهرا سلام الله علیها هم یه گوشه‌ی حجرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.54,
   "end": 90.82,
   "text": "رفتم دست پیغمبر رو بوسیدم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.82,
   "end": 97.06,
   "text": "حضرت فرمودند که مرحباً بولدی یعنی آفرین به پسرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.06,
   "end": 100.34,
   "text": "عرض کردم یا رسول الله من سؤالاتی دارم از شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.34,
   "end": 105.74,
   "text": "پیغمبر فرمود سؤالاتت رو از پسرم مهدی بپرس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.74,
   "end": 107.78,
   "text": "اون لحظه امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.78,
   "end": 111.52,
   "text": "تشریف آوردند و من هرچه سؤال داشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.52,
   "end": 115.14,
   "text": "از امام عصر پرسیدم، جواب گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.14,
   "end": 120.28,
   "text": "بعد حضرت منو آورد نزدیک مادرشون حضرت زهرا سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.28,
   "end": 124.18,
   "text": "و عرض کرد که مادر پسرت رو تحویل بگیر؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.18,
   "end": 126.92,
   "text": "یعنی سید بحر العلوم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.92,
   "end": 134.32,
   "text": "حضرت زهرا سلام الله علیها دست من رو گرفت و من خانم رو بدون پوشش و بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.32,
   "end": 138.08,
   "text": "مثلاً مقنعه و روسری و این‌ها دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.08,
   "end": 140.24,
   "text": "از من حجاب نکرد خانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.24,
   "end": 142.82,
   "text": "یقین کرد که سیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.82,
   "end": 149.64,
   "text": "و خانم منو با دست منو گرفت برد تو حجره خودش یه آشی برای من گذاشت که بخورم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.64,
   "end": 152.64,
   "text": "این آش درش پر از حبوبات بود انواع و اقسام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.64,
   "end": 157.98,
   "text": "حبوبات بود و این‌ها و من این آش رو خوردم که میگه بعداً از مادر خودم پرسیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.98,
   "end": 161.34,
   "text": "آیا آشی داریم که همه حبوبات درش باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.34,
   "end": 165.28,
   "text": "گفت بله ایرانی‌ها یه آشی دارن به نام بیبی زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.28,
   "end": 171.9,
   "text": "حبوبات همه توش هست. همون آش رو تو رؤیای صادقه خانم به من داد خوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.9,
   "end": 180.24,
   "text": "خودش میگه سید میگه بعد از خوردن این آش یه شرح صدر عجیبی به من دست داد و هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.24,
   "end": 185.18,
   "text": "چیزی رو که می‌خوندم یک بار بس بود برای همیشه تو ذهنم می‌موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.18,
   "end": 188.8,
   "text": "یه گره‌ای از ذهنم باز شد و یک شرح صدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.8,
   "end": 193.12,
   "text": "عجیبی. ببینید ارتباط یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.12,
   "end": 200.36,
   "text": "آشی که یه آش یعنی یه آش یه نفر تو رؤیای صادقه با حضرت زهرا خورده میشه سید بحر العلوم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.36,
   "end": 204.18,
   "text": "سینه به سینه امام عصر میره جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.18,
   "end": 208.44,
   "text": "توسل به حضرت زهرا سلام الله علیها دیگه رو دستش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.44,
   "end": 213.42,
   "text": "حالا کسی صلواتش رو فرستاد چون بحث ما در ازکار و ادعیه و عوضات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.42,
   "end": 216.66,
   "text": "رسیده بود به صلوات، صلوات خانم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.66,
   "end": 219.96,
   "text": "عرض کردیم که از متن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.96,
   "end": 228.0,
   "text": "احادیث اومده که اللهم صل على فاطمة وأبيها و بعلها و بنیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.0,
   "end": 232.14,
   "text": "در خصوص صلوات چند تا نکته دیگه عرض کنم و اهمیتش پی ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.14,
   "end": 240.24,
   "text": "مرحوم دولابی علیه الرحمه می‌فرمودند که کس که زیاد صلوات می‌فرسته خدا اونو با پنبه سرشو می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 240.24,
   "end": 241.8,
   "text": "منظور موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.8,
   "end": 245.66,
   "text": "یعنی بالاخره همه ما رو سرمونو موقع موت می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.66,
   "end": 249.34,
   "text": "دیگه وقت مرگ تموم می‌شه اینجا دنیامون تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 249.34,
   "end": 251.7,
   "text": "اصطلاحاً یعنی سرمونو می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.7,
   "end": 256.92,
   "text": "کسی که زیاد صلوات می‌فرسته مرحوم دولابی می‌فرمود که خدا با پنبه سرشو می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.92,
   "end": 261.22,
   "text": "اصلاً هیچی حس نمی‌کنه. یعنی یه مرگ خیلی راحتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 261.22,
   "end": 266.64,
   "text": "اتفاقاً از امام صادق صلوات الله علیه پرسیدن که حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.64,
   "end": 268.82,
   "text": "خلیل الرحمن شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 268.82,
   "end": 275.62,
   "text": "و قرآن می‌فرماید تو رو امام قرار دادیم به مقام امامت رسید به چه جهت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 275.62,
   "end": 281.68,
   "text": "ایشون اختصاصاً. امام صادق صلوات الله علیه فرمود به جهت کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.68,
   "end": 285.96,
   "text": "صلواتی که می‌فرستاده. البته ابراهیم خلیل الرحمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 285.96,
   "end": 292.76,
   "text": "دائم الصلوات بود. این اثر صلوات ببینید تا کجا پیش می‌بره انسان رو که به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.76,
   "end": 296.72,
   "text": "خلیل رحمانی می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 296.72,
   "end": 299.22,
   "text": "و یه صلوات دیگه‌ای رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 299.22,
   "end": 301.1,
   "text": "خدمت شما خوبان تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.1,
   "end": 303.1,
   "text": "کتابش اینجا هست اگه کسی خواست ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 303.1,
   "end": 305.48,
   "text": "این کتاب ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.48,
   "end": 307.82,
   "text": "مجموعه‌ای از ادعیه دوران غیبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.82,
   "end": 312.34,
   "text": "چاپ شده. کتاب خوبیه. این صلوات معروفه به صلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.34,
   "end": 315.06,
   "text": "ورّاق اصفهانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.06,
   "end": 317.0,
   "text": "یکی از مخلصین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 317.0,
   "end": 320.8,
   "text": "درگاه اهل بیت بود که مکه زندگی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.8,
   "end": 323.44,
   "text": "اگر حکایتشو خواستید بدونید هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.44,
   "end": 327.82,
   "text": "شیخ طوسی در مصباح المتجدش آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 327.82,
   "end": 330.78,
   "text": "هم سید ابن طاووس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.78,
   "end": 334.7,
   "text": "که ایشون هم هم‌پای سید بحر العلوم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.7,
   "end": 337.6,
   "text": "به عظمت از این صلوات یاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.6,
   "end": 339.42,
   "text": "سید ابن طاووس که فرموده اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.42,
   "end": 348.52,
   "text": "جمعه نتونستید اعمال روز جمعه رو انجام بدید، هیچ کدومشو این صلوات رو ترک نکنید خصوصاً عصر جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 348.52,
   "end": 351.02,
   "text": "صلوات بسیار عجیبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 351.02,
   "end": 363.38,
   "text": "شیخ عباس قمی هم که در مفاتیح آورده یعنی سند‌های زیادی براش هست که فرمودن امام عصر این رو به ابوالحسن ورّاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.38,
   "end": 366.44,
   "text": "تعلیم داد مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.44,
   "end": 372.92,
   "text": "سلامون علی آل یاسین معروف زیارت آل یاسین که امام حسن فرمود که هر وقت هر کی می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 372.92,
   "end": 376.74,
   "text": "یا متوجه به من بشه از طریق این زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.74,
   "end": 380.92,
   "text": "اینم در حقیقت امام حسن تعلیم کرده به ابوالحسن برّاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 380.92,
   "end": 383.21,
   "text": "یک متن بسیار عجیبی هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 383.21,
   "end": 387.8,
   "text": "خیلی عجیب. مشخصه که از ناحیه مقدس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 387.8,
   "end": 394.7,
   "text": "اینم برای گره گشایی، برای قضای حاجت، برای دفع بلا مطلقاً اینا خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 394.7,
   "end": 403.76,
   "text": "یه صلوات دیگه هم به صورت رمزی من به شما بگم چون من خیلی سالیان سال ازش برکات عجیبی خودم دیدم در زندگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 403.76,
   "end": 407.26,
   "text": "یه صلوات خیلی کوچولویی هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 407.26,
   "end": 411.06,
   "text": "خیلی سری و رمزی گفتن و رد شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 411.06,
   "end": 413.76,
   "text": "بعد از نماز امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 413.76,
   "end": 417.48,
   "text": "نماز امیرالمؤمنین هم که می‌دونید در مفاتیح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 417.48,
   "end": 421.88,
   "text": "البته در جمال الأسبوع سید بن طاووس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 421.88,
   "end": 424.6,
   "text": "نمازهای اهل بیت رو که جمع می‌کنه اینم میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 424.6,
   "end": 432.04,
   "text": "در بعضی از نسخ به نام نماز توبه معروفه اما اصلش نماز امیرالمؤمنینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 432.04,
   "end": 438.76,
   "text": "که چهار رکعت دو تا دو رکعت در هر رکعت بعد از حمد پنجاه تا قل هوالله می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 438.76,
   "end": 448.28,
   "text": "روایت داره که هر کسی این نمازو خوند بعد تسبیح امیرالمؤمنین رو که یکی از با عظمت‌ترین تسبیحات هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 448.28,
   "end": 453.22,
   "text": "بعد از نماز بگه مثل بچه‌ای که از مادر متولد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 453.22,
   "end": 457.08,
   "text": "پاک پاک می‌شه و حاجتش رواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 457.08,
   "end": 459.9,
   "text": "بعد اونجا این سر بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 459.9,
   "end": 463.52,
   "text": "انتهاش تموم که می‌شه تا شاه عباس هم آورده تو مفاتیح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 463.52,
   "end": 468.2,
   "text": "فرمود اگر کسی بعد از نماز امیرالمؤمنین این جمله رو گفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 468.2,
   "end": 470.2,
   "text": "یه صلوات کوچولوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 470.2,
   "end": 474.7,
   "text": "اللهم صل علی النبي العربي و آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 474.7,
   "end": 478.96,
   "text": "بعد از نماز امیرالمؤمنین اون تسبیحات عجیب و عظیم رو گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 478.96,
   "end": 481.18,
   "text": "بعدم این تیکه رو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 481.18,
   "end": 483.98,
   "text": "اینجا حضرت فرمود که گناهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 483.98,
   "end": 486.94,
   "text": "هم گذشته‌ش هم آینده‌ش بخشیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 486.94,
   "end": 489.08,
   "text": "حالا اینم رمزی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 489.08,
   "end": 491.78,
   "text": "یعنی چی گناههای آینده‌ش بخشیده می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 491.78,
   "end": 494.06,
   "text": "بعضیا گفتن یعنی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 494.06,
   "end": 497.7,
   "text": "چنان دستشو می‌گیره که اصلا دیگه گناه نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 497.7,
   "end": 502.34,
   "text": "بعضیا اینجوری تعبیر کردن. حالا در هر حال بالاخره اهل نجات می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 502.34,
   "end": 509.38,
   "text": "گناههای قبل و بعدش بخشیده می‌شه که انّ دوازده بار ختم قرآن کرده و از گرسنگی و تشنگی روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 509.38,
   "end": 511.56,
   "text": "قیامت در امان حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 511.56,
   "end": 513.86,
   "text": "اینم یه اثر از یک صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 513.86,
   "end": 516.3,
   "text": "می‌خوام به شما عرض کنم که حالا صلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 516.3,
   "end": 527.96,
   "text": "به تعدد هست. منتها عرض شد دیروز که معسورشو استفاده کنید و برای دفع اجنه و ازدیاد رزق و روزی و طهارت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 527.96,
   "end": 531.72,
   "text": "بهترین ذکره. یعنی ما بالاتر از این دیگه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 531.72,
   "end": 540.76,
   "text": "می‌تونید رجوع کنید به مصادر و منابع و مؤاخذی که صلوات‌هایی که معسور از اهل بیته درشون اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 540.76,
   "end": 546.5,
   "text": "یه دستور العمل دیگه هم تقدیم کنم هدیه از حضرت استاد علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 546.5,
   "end": 549.24,
   "text": "که ایشون اثرش رو اول بهتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 549.24,
   "end": 554.24,
   "text": "حضرت علامه می‌فرمودن که کسی که این کارو بکنه از جمیع آفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 554.24,
   "end": 556.78,
   "text": "و بلیات در امان خدا قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 556.78,
   "end": 560.66,
   "text": "چیکار کنه؟ بعد از نماز مغربش و صبحش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 560.66,
   "end": 565.64,
   "text": "بعد از نماز صبح و مغربش هفت مرتبه بگه بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 565.64,
   "end": 569.0,
   "text": "لا حول و لا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 569.0,
   "end": 571.6,
   "text": "واو دیگه نداره و لا حولا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 571.6,
   "end": 574.26,
   "text": "لا حول ولا. بسم الله هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 574.26,
   "end": 578.22,
   "text": "اینو هفت بار می‌گه. بعد سی مرتبه هم تسبیحات اربعه رو می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 578.22,
   "end": 582.22,
   "text": "سبحان الله و الحمد لله ولا اله الا الله والله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 582.22,
   "end": 587.5,
   "text": "کسی که اینو ترک نکنه علامه می‌فرمودن از جمیع آفات و بلیات در امانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 587.5,
   "end": 591.16,
   "text": "نکته آخر برای آدمای تنبلی مثل خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 591.16,
   "end": 595.32,
   "text": "اینم یه چیزی رو عرض کنیم تقدیم کنیم و برای امروز کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 595.32,
   "end": 598.74,
   "text": "در بحار جلد نود و یک صفحه دویست و چهل و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 598.74,
   "end": 603.14,
   "text": "حاج آقا این همه ذکر و دعا و اینا گفتی آقا ما وقت نداریم، حوصله نداریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 603.14,
   "end": 605.46,
   "text": "کشششو نداریم به هر دلیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 605.46,
   "end": 611.9,
   "text": "یه چیزی بگو که کپسول باشه در عین حال مولتی ویتامین باشه کار همه رو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 611.9,
   "end": 614.92,
   "text": "امیرالمؤمنین همچین کاری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 614.92,
   "end": 617.84,
   "text": "دستورش رو داده. یه شخصی از مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 617.84,
   "end": 621.76,
   "text": "عرض کرد، سؤال کرد آقا من به جهت مشغله زیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 621.76,
   "end": 625.04,
   "text": "وقت نمی‌کنم این ادعیه‌ای که شما می‌فرمایید رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 625.04,
   "end": 633.84,
   "text": "الان فکر کنم امروز دهمین جلسه بود که ما انواع و اقسام اذکار و ادعیه اینا مخصوصاً در باطل کردن سحر و جادو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 633.84,
   "end": 637.58,
   "text": "دفع اجنه و ازدیاد رزق و روزی بیان کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 637.58,
   "end": 641.91,
   "text": "خب یکی شاید بگه آقا من فرصت ندارم مشغله‌م زیاده مثل همین آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 641.91,
   "end": 643.54,
   "text": "به امیرالمؤمنین گفت آقا من چیکار کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 643.54,
   "end": 654.02,
   "text": "حضرت خیلی زرنگی کردن و فرمودن که یه چیزی بهت یاد میدم که هر صبح بخونی که انّ تمام ادعیه و اذکار رو گفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 654.02,
   "end": 656.8,
   "text": "چهار تا جمله است خیلی کوتاه، خیلی هم شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 656.8,
   "end": 661.48,
   "text": "فرمود بگو الحمد لله على كل نعمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 661.48,
   "end": 670.56,
   "text": "و اسأل الله من كل خير و استغفر الله من كل ذنب و اعوذ بالله من كل شر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 670.56,
   "end": 672.72,
   "text": "کل، کل، کل، کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 672.72,
   "end": 677.82,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 677.82,
   "end": 680.92,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 680.92,
   "end": 682.86,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 682.86,
   "end": 688.92,
   "text": "محمد. کتاب اینجا هست اگر کسی خواست متن صلوات رو ببینه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 688.92,
   "end": 690.51,
   "text": "اینجا هست. ممنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}