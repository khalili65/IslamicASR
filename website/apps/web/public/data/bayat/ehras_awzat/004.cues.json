 "chapters": [
  {
   "index": 0,
   "title": "## ادامهٔ عوذات و احراز؛ هدیه‌ای دیگر",
   "start": 19.22,
   "end": 101.44
  },
  {
   "index": 1,
   "title": "مقصود از «قُلْ أُوحِيَ إِلَيَّ» آغاز سورهٔ جن است.",
   "start": 101.44,
   "end": 179.6
  },
  {
   "index": 2,
   "title": "## مفاتیحِ شیخ عباس و سفارش آیت‌الله بهجت",
   "start": 179.6,
   "end": 228.02
  },
  {
   "index": 3,
   "title": "## معوّذتین و آیهٔ الکرسی",
   "start": 228.02,
   "end": 429.4
  },
  {
   "index": 4,
   "title": "## روایت شیبة هذلی؛ ترس از خَرَف‌شدن",
   "start": 429.4,
   "end": 589.46
  },
  {
   "index": 5,
   "title": "پیامبر فرمود این کارها را بکن. چه کار؟ فرمود بعد از هر نماز صبح ده مرتبه این ذکر را بگو:",
   "start": 589.46,
   "end": 614.82
  },
  {
   "index": 6,
   "title": "## چهار جمله پس از هر نماز برای آخرت",
   "start": 614.82,
   "end": 635.02
  },
  {
   "index": 7,
   "title": "پیامبر فرمود بعد از هر نمازت بگو. آن ده بار پس از نماز صبح بود. این را فرمود بعد از هر نمازت این چهار جمله را بگو:",
   "start": 635.02,
   "end": 676.78
  },
  {
   "index": 8,
   "title": "## توصیهٔ پایانی: با اعتقاد انجام دهید",
   "start": 676.78,
   "end": 723.06
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 3.76,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.76,
   "end": 7.04,
   "text": "و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.04,
   "end": 11.36,
   "text": "فرجهم. بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.36,
   "end": 14.78,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.78,
   "end": 19.22,
   "text": "و ربانی آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.22,
   "end": 26.44,
   "text": "در ادامه عوضات و احراز و ادعیه و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.44,
   "end": 29.66,
   "text": "، امروز یه چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.66,
   "end": 33.06,
   "text": "دو مرتبه در همین باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.06,
   "end": 38.52,
   "text": "هدایا تقدیم کنم. اولیش در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.52,
   "end": 42.98,
   "text": "حالا این که اثرش، یه اول عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.98,
   "end": 48.86,
   "text": "امام صادق صلوات الله علیه فرمود کسی که این کارو انجام بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.86,
   "end": 53.1,
   "text": "فرمودند که اولین اثرش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.1,
   "end": 55.2,
   "text": "در زندگی از شر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.2,
   "end": 58.18,
   "text": "چشم اجنه، سحر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.18,
   "end": 63.9,
   "text": "جادو، مکر و حیله‌ی اون‌ها در امانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.9,
   "end": 68.56,
   "text": "این خیلی مهمه. بعد ببینید که چقدرم آسونه انجام دادنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.56,
   "end": 71.5,
   "text": "حالا بعد ما میریم راه میفتیم میریم دنبال این رمال‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.5,
   "end": 77.8,
   "text": "فارگی‌ها و چه و اینا که مراجع هم اصلا حرام میدونن رجوع به اون‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.8,
   "end": 82.94,
   "text": "و باز بدونید که چند تا سند مهم داره مثل تفسیر اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.94,
   "end": 85.54,
   "text": "ج１۷، صفحه ۷۸.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.54,
   "end": 88.08,
   "text": "ثواب الأعمال، صفحه ۱۲۰.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.08,
   "end": 93.2,
   "text": "در تفسیر نور الثقلین دیدم هست، در تفسیر برهان هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.2,
   "end": 101.44,
   "text": "امام صادق صلوات الله علیه فرمود من اكثر قراءة قل اوحي إلي، قل اوحي إلي ابتدای سوره جن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.44,
   "end": 105.42,
   "text": "هر کس که زیاد بخواند سوره جن را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.42,
   "end": 109.64,
   "text": "فرمود لم يسبه في الحياة الدنيا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.64,
   "end": 112.78,
   "text": "بهش اصابت نمیکنه در دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.78,
   "end": 115.64,
   "text": "شيء من أعين الجن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.64,
   "end": 119.82,
   "text": "ولا نفسهم ولا سحرهم ولا من كيدهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.82,
   "end": 123.38,
   "text": "همین چشم جن، کیدش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.38,
   "end": 128.46,
   "text": "سحرش، جادوش اینا حیله‌ش اثری نمیکنه در شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.46,
   "end": 135.54,
   "text": "و كان مع محمد صلى الله عليه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.54,
   "end": 140.06,
   "text": "و این همراه پیغمبر خواهد بود در مقام معیت با پیغمبر، عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.06,
   "end": 143.18,
   "text": "و يقول يا رب چنان اونجا پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.18,
   "end": 151.26,
   "text": "پیغمبر که هست کیف میکنه که میگه يا رب لا أريد به بدلا اصلا نمیخوام بدل این مقام من بدل بشه به چیز دیگه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.26,
   "end": 157.68,
   "text": "ولا أريد أن أبغي عنه حذلا اصلا نمیخوام دور بشم از این مرتبه و مقامی که هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.68,
   "end": 161.7,
   "text": "ببینید در اكثار خوندن یک سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.7,
   "end": 168.7,
   "text": "چقدر تاثیرات هست. حالا اینایی که دنبال راه‌های عجیب و غریب هستن که حالا مثلا اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.7,
   "end": 176.76,
   "text": "مثلا بگیم جن وارد زندگیش شده یا سحر و جادو و طلسم و اینا به همه راحتی اهل بیت دستور دادن و انجام شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 176.76,
   "end": 182.5,
   "text": "زیاد بودن آدم‌هایی که به ما رجوع کردن و حرف گوش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.5,
   "end": 186.88,
   "text": "توجه بفرمایید ما ارجاع دادیم به همین مفاتیح شیخ عباس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 186.88,
   "end": 189.46,
   "text": "فهرستشو نگاه کنید چقدر ادعیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.46,
   "end": 196.22,
   "text": "اذکار و عوضات و تعویذ و دستور اهل بیت داره برای دفع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 196.22,
   "end": 199.54,
   "text": "سحر و جن و نمی‌دونم باطل کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 199.54,
   "end": 201.74,
   "text": "جادو و طلسم و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.74,
   "end": 207.06,
   "text": "باور کنید انجام دادن با اعتقاد و ت-- و نتیجه گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 207.06,
   "end": 211.5,
   "text": "من خدا رحم-- همیشه بهتون گفتم خدا رحمت کنه آقای بهجت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 211.5,
   "end": 214.1,
   "text": "خود ایشون یه روزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 214.1,
   "end": 217.44,
   "text": "ما محضرشون که بودیم تاکید کردن رو مفاتیح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 217.44,
   "end": 219.06,
   "text": "فرمودن از این غافل نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 219.06,
   "end": 221.5,
   "text": "هرچی که تو اینه برای شما بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.5,
   "end": 223.54,
   "text": "همین، همین کتاب مفاتیح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.54,
   "end": 228.02,
   "text": "اینایی که ما میگیم بسیاریش از مفاتیح هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.02,
   "end": 230.02,
   "text": "مثلا سوره ناس و فلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.02,
   "end": 233.2,
   "text": "انقدر روایات داریم در عظمت این دو تا سوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.2,
   "end": 240.52,
   "text": "معوذتین‌ان دیگه. پناه میبری به خدا توی این دو تا سوره از هر شری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.52,
   "end": 245.66,
   "text": "چرا ما غافلیم از اینا؟ صبح از خونه میای بیرون بخونی، برمی‌گردی بخونی، لبت تر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.66,
   "end": 247.8,
   "text": "اصلا نمی‌تونه دیگه این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.8,
   "end": 249.58,
   "text": "صریح قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.58,
   "end": 252.32,
   "text": "نمی‌تونه دشمن به تو ما-- به شما آسیب برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.32,
   "end": 253.88,
   "text": "مگر اینکه غافل باشی، نخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.88,
   "end": 257.64,
   "text": "یا مثلا آیه الکرسی چقدر در عظمتش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.64,
   "end": 260.38,
   "text": "اصلا حصر و پناه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.38,
   "end": 266.02,
   "text": "یا اینایی که در کار مثلا اِاِاِ از شود طب اسلامی و اینا میرن شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.02,
   "end": 270.7,
   "text": "قطعا تو طب الأئمه دیدید این روایتو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.7,
   "end": 273.28,
   "text": "خدا به صورت طبیعی بعضی چیزا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.28,
   "end": 276.58,
   "text": "مایه دفع بلاها و حتی اهریمن‌ها قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.58,
   "end": 285.04,
   "text": "مثل اسفند. اسفند خود دانه‌ش، ریشه‌ش، شاخه‌هاش هر کدومش حدیث داری موکل دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.04,
   "end": 291.66,
   "text": "یه ملکی موکلشه. بعد هر کجا اینا باشن دفع می‌کنن اجنه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 291.66,
   "end": 293.72,
   "text": "مثل پرزدن کبوتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.72,
   "end": 300.12,
   "text": "کبوتر چرا روایت داریم اهل بیتی تو خونه‌تون کبوتر نگه دارید نه کفترباز باشیدها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 300.12,
   "end": 304.74,
   "text": "کبوتر نگه دارید. این بال که میزنه حدیث داریم شیاطین رو دفع میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.74,
   "end": 308.3,
   "text": "یا مرغ و خروس. حدی-حديث داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 308.3,
   "end": 312.9,
   "text": "که حالا الان ما تو حیاط خونه هم انداختیم همسایه ها گفتن مگه اینجا دهاته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.9,
   "end": 315.44,
   "text": "به ما می‌گفتن. متاسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 315.44,
   "end": 319.14,
   "text": "اونایی که گول مدرنیته رو خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.14,
   "end": 322.5,
   "text": "یه دستور دیگه‌ای هست این رو دوست داشتید انجام بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.5,
   "end": 328.06,
   "text": "اِمم خیلیا نتیجه گرفتن و مژده به ما دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 328.06,
   "end": 330.9,
   "text": "خیلی هم آسونه. یه کوزه بخرید، کوزه نو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.9,
   "end": 333.48,
   "text": "نه اینکه کهنه تو خونه‌تون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.48,
   "end": 339.5,
   "text": "یه کوزه گلی برید بخرید و این رو توش آب بریزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 339.5,
   "end": 347.16,
   "text": "سی مرتبه رو به قبله با وضو سی مرتبه سوره قدر رو در این کوزه آب بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 347.16,
   "end": 352.36,
   "text": "بعد این فرمایش امام صادق صلوات الله علیه از ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.36,
   "end": 357.2,
   "text": "در طب الأئمه صفحه ۱۲۳ یعنی صد و بیست و سه اینطوری ما حفظ کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.2,
   "end": 362.38,
   "text": "می‌تونید ببینیدش. سی تا سوره قدر رو بهش بدمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.38,
   "end": 365.08,
   "text": "بعد مقداری ازش بخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.08,
   "end": 370.6,
   "text": "یه وضو باهاش بگیرید. کف دستتون رو تر کنید بزنید به سرتون و صورتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 370.6,
   "end": 373.24,
   "text": "حالا اینا هم رمز و komuzi داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 373.24,
   "end": 377.74,
   "text": "این کنز گنج‌هایی است که از نظر ما مخفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 377.74,
   "end": 380.96,
   "text": "رموزی دارد، اسراری دارد بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 380.96,
   "end": 387.74,
   "text": "بعد دیگه هر وقت آب شور می‌خوای آب بخوری نه که حموم و اینا نه یا ظرف شوری نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 387.74,
   "end": 392.06,
   "text": "می‌خوای آب بخوری یا حتی می‌تونی بار وضو گرفتنت از این کوزه آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 392.06,
   "end": 395.12,
   "text": "داخل این کوزه استفاده کنی. منتها هی شارژش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 395.12,
   "end": 398.12,
   "text": "دیگه نمی‌خواد سوره بخونی همون سی تا کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 398.12,
   "end": 405.04,
   "text": "شارژش کن قبل از اینکه آبش تموم شه دوباره آب هر روز بریز توش و از اون کوزه آب بخور از اون وضو بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 405.04,
   "end": 413.54,
   "text": "اینا بعد می‌بینید حضرت وعده دادن که به سرعت همه مریضی‌ها و بلاها از زندگی دفن می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 413.54,
   "end": 419.76,
   "text": "به همین راحتی. دیگه حالا چون بحث ما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 419.76,
   "end": 422.32,
   "text": "یادتون باشه تو شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 422.32,
   "end": 428.42,
   "text": "کتاب الموت بودیم دیگه یه مقدار هم فاصله گرفتیم به جهت اینکه بحث ما خورد به ملائکه هاروت و ماروت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 428.42,
   "end": 432.04,
   "text": "که یاد می‌دادن چگونه سحر اجنه رو باطل کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 432.04,
   "end": 436.92,
   "text": "بعد کشیده شد به همین طوری اجنه و بعد احراز و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 436.92,
   "end": 440.92,
   "text": "یه روایت خیلی شیرینی هستش برای کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 440.92,
   "end": 443.68,
   "text": "می‌ترسن از خرف شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 443.68,
   "end": 448.84,
   "text": "چون مرتبط با ارزال العمر رو یادتون باشه تو بحث کتاب الموت گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 448.84,
   "end": 454.62,
   "text": "خرف شدن همون ارزال العمره که انسان دیگه از پنجاه شصت سالگی به بالا دیگه میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 454.62,
   "end": 459.7,
   "text": "کسی می‌خواد از این در مص-- مصون و حصر الهی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 459.7,
   "end": 465.42,
   "text": "این باز در م-- می‌تونید در مفاتیح الجنان تعقیبات مشترکه این دستور رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 465.42,
   "end": 469.74,
   "text": "البته کلینی و ابن بابویه هم این روایت رو آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 469.74,
   "end": 472.5,
   "text": "به سندهای معتبر آوردن از امام باقر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 472.5,
   "end": 475.42,
   "text": "معروفه به شيبة هزلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 475.42,
   "end": 481.18,
   "text": "این شخص که میاد پیش پیغمبر می‌گه یا رسول الله من پیر شدم از پا افتادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 481.18,
   "end": 484.3,
   "text": "یه تعلیم به من بده که مثلاً جبران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 484.3,
   "end": 489.42,
   "text": "اینکه دیگه جوون بودم روزه، نماز، حج، جهاد الان نمی‌تونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 489.42,
   "end": 491.86,
   "text": "جبران اونو برام بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 491.86,
   "end": 494.32,
   "text": "و به نفع-- ببخشه آسون هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 494.32,
   "end": 496.42,
   "text": "پیغمبر فرمود دوباره بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 496.42,
   "end": 501.96,
   "text": "اینجا حالا یه سری درش هست که به وقتش باید اینو برای شما بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 501.96,
   "end": 506.22,
   "text": "دوباره گفت. پیغمبر فرمود بار دیگه تکرار کن درخواستتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 506.22,
   "end": 510.5,
   "text": "دوباره گفت. سه بار به درخواست پیغمبر اینو تکرار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 510.5,
   "end": 514.32,
   "text": "بعد خیلی جالبه پیغمبر فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 514.32,
   "end": 520.84,
   "text": "نمان بر دور تو درختی و کلوخی مگر اینکه گریست بر تو برای ترحم بر تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 520.84,
   "end": 525.78,
   "text": "اصلاً سری که پیغمبر فرمود دوباره بگو بگو خیلی این نکته‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 525.78,
   "end": 530.78,
   "text": "چرا شما قبلاً گفتیم نه سلام آخر نمازتو که میدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 530.78,
   "end": 535.68,
   "text": "سلام رو به همه از امام عصر بگیر تا انبیا بگیر تا حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 535.68,
   "end": 538.9,
   "text": "نباتات و همه کائنات سلام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 538.9,
   "end": 543.54,
   "text": "اسم سلام الهی اینا دست به دست هم میدن تو رو به سلامت بدارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 543.54,
   "end": 551.0,
   "text": "یه معنای ترحم این کلوخ و درخت پیغمبر اینجا داره می‌گه همینه که اون‌ها به تو ترحم کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 551.0,
   "end": 555.2,
   "text": "گریستن یعنی رحم اینا شدن کانال فیض تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 555.2,
   "end": 560.42,
   "text": "حالا الان حوصله شرح نباشه بازش نمی‌کنم تا همین مقدار بسنده می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 560.42,
   "end": 565.54,
   "text": "سری هست در این. اصلاً می‌گه بگو قل قولوا بگید بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 565.54,
   "end": 570.04,
   "text": "این گفتن اسراری داره که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 570.04,
   "end": 572.06,
   "text": "کائنات به کمک تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 572.06,
   "end": 575.58,
   "text": "بلند می‌شن. پیغمبر فرمود که این کارا رو بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 575.58,
   "end": 582.62,
   "text": "چیکار کن؟ فرمود بعد از هر نماز صبح ده مرتبه این ذکر رو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 582.62,
   "end": 585.52,
   "text": "سبحان الله العظیم و بحمده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 585.52,
   "end": 589.46,
   "text": "ولا حول ولا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 589.46,
   "end": 593.46,
   "text": "دیدم ابتدای نامه سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 593.46,
   "end": 598.98,
   "text": "حضرت علامه حسن زاده تو کتاب نامه‌ها و برنامه‌ها هم تأکید علامه بود بر این دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 598.98,
   "end": 604.26,
   "text": "فرمود پیغمبر فرمود تا خدا عافیت دهد به برکت این دعا تو را از چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 604.26,
   "end": 606.54,
   "text": "از کوری، دیوانگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 606.54,
   "end": 610.48,
   "text": "خوره، پیری، پریشانی که غوغا می‌کنه الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 610.48,
   "end": 614.28,
   "text": "خرف شدن. همون ارزال العمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 614.28,
   "end": 618.18,
   "text": "بعد چقدر آدم ااا زرنگی بوده این شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 618.18,
   "end": 621.62,
   "text": "گفت یا رسول الله می‌خوام-- این که برای دنیای منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 621.62,
   "end": 623.9,
   "text": "حالا ما بودیم می‌گفتیم تموم شد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 623.9,
   "end": 625.94,
   "text": "دیگه آخرت چیه؟ ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 625.94,
   "end": 628.86,
   "text": "نقد رو بچسب. گفت این که برای دنیای منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 628.86,
   "end": 631.24,
   "text": "برای آخرتم یه چیزی بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 631.24,
   "end": 635.3,
   "text": "چقدر زرنگ بوده. پیغمبر فرمود بعد از هر نمازت بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 635.3,
   "end": 637.8,
   "text": "اون ده بار بعد از نماز صبح بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 637.8,
   "end": 641.76,
   "text": "اینو فرمود بعد از هر نمازت بگو این چهار جمله رو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 641.76,
   "end": 650.16,
   "text": "اللهم مهدنی من عندك و افض علي من فضلك و انشر علي من رحمتک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 650.16,
   "end": 654.02,
   "text": "و انزل علي من برکاتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 654.02,
   "end": 657.96,
   "text": "بعد پیغمبر فرمود اگر مواظبت کنی بر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 657.96,
   "end": 660.66,
   "text": "و عمداً ترکش نکنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 660.66,
   "end": 666.74,
   "text": "تا وقت مردنت وقتی محشور شدی هشت در بهشت بر-- باز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 666.74,
   "end": 670.1,
   "text": "می‌گن از هر دری دوست داری برو وارد شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 670.1,
   "end": 676.13,
   "text": "ببینید اینا چقدر عظمت در این ادعیه نهفته و ما غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 676.13,
   "end": 681.26,
   "text": "به هر حال من توصیه می‌کنم که اینا رو با اعتقاد جدی بگیریم و انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 681.26,
   "end": 684.78,
   "text": "حالا بعضیا سؤال کردن کدومشو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 684.78,
   "end": 688.0,
   "text": "همشو بده. همشو می‌تونی انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 688.0,
   "end": 690.3,
   "text": "ظرفیتت هست همه رو انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 690.3,
   "end": 694.88,
   "text": "همه اینایی که حتی ارز عبود و جان رقعت الجب توضین همه رو انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 694.88,
   "end": 697.46,
   "text": "چه اشکالی داره؟ هر کدوم یه خاصیتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 697.46,
   "end": 700.94,
   "text": "نمی‌خوای؟ یه دونه‌شو حداقل انجام بده برو جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 700.94,
   "end": 703.3,
   "text": "حالا ادعیه دیگه‌ای هم بود دیگه بسه همین مقدار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 703.3,
   "end": 706.08,
   "text": "تا یار که خواهد و میلش به که باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 706.08,
   "end": 709.96,
   "text": "دوست داشتید دیگه ما سند مأخذها رو هم گفتیم برید رجوع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 709.96,
   "end": 714.7,
   "text": "ان شا الله که عاقبت از ما خیر بشه به برکت صلوات بر محمد آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 714.7,
   "end": 718.32,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 718.32,
   "end": 720.6,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 720.6,
   "end": 723.06,
   "text": "محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}