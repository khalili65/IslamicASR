   "start": 1.48,
   "end": 39.5
  },
  {
   "index": 1,
   "title": "## کلمهٔ بیست‌وچهار و کلمهٔ چهارصدوپنجاه‌وشش",
   "start": 39.5,
   "end": 97.48
  },
  {
   "index": 2,
   "title": "## اگر شفا نگرفت؛ رضا به قضای الهی",
   "start": 97.48,
   "end": 127.78
  },
  {
   "index": 3,
   "title": "یکی: تربت سیدالشهدا اصل است.",
   "start": 127.78,
   "end": 190.1
  },
  {
   "index": 4,
   "title": "## اگر حرز تربت در دسترس نبود",
   "start": 190.1,
   "end": 245.46
  },
  {
   "index": 5,
   "title": "## دو: کلمهٔ تزکیهٔ دست",
   "start": 245.46,
   "end": 273.36
  },
  {
   "index": 6,
   "title": "## سه: شستن قاف",
   "start": 273.36,
   "end": 285.74
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.48,
   "end": 4.9,
   "text": "یکی کلمه بیست و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.9,
   "end": 9.74,
   "text": "هزار و یک کلمه حضرت استاد رو ببینید اون رو انجام بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.74,
   "end": 13.66,
   "text": "دستور العمل خاصی بنده به یکی از دوستانمون دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.66,
   "end": 20.39,
   "text": "که همسرشون درد استخون و پهلو و مشکلاتی داشت که هرچی درمان می‌کردن خوب نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.39,
   "end": 22.68,
   "text": "ایشون خودش این دستور رو انجام داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.68,
   "end": 28.2,
   "text": "دستشونو کشیدن به اندامی که درد داشت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.2,
   "end": 32.68,
   "text": "عیالشون. الحمدالله خوب شدن دیگه بدون دوا و درمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.68,
   "end": 41.76,
   "text": "موارد مشابه زیاد پیش اومده که خود حضرت استاد هم در اون نکته تاکید می‌کنند که در این دستور دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.76,
   "end": 45.08,
   "text": "تزکیه می‌شه و قدرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.08,
   "end": 48.38,
   "text": "شفا به خودش می‌گیره. به فضل قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.38,
   "end": 53.42,
   "text": "به کرم قرآن، به نورانیت قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.42,
   "end": 60.3,
   "text": "و این دستور مس قرآن دیگه چهارشنبه و پنجشنبه و جمعه بین الطلوعین یه دستور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.3,
   "end": 66.02,
   "text": "خاصی داره که مس قرآن می‌کنند و یه ذکری رو میگن که حالا اونجا رجوع کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.02,
   "end": 69.06,
   "text": "این کار حالا یا اگه خودشون بتونن انجام بدن که بهتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.06,
   "end": 77.44,
   "text": "نشد کسی دیگه انجام بده دست بکشه به اون اندام‌هایی که خودشون میگن انشاالله خدا شفا حاصل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.44,
   "end": 84.28,
   "text": "فرمودن این به یکی از بهترین کارها برای درمان مریضی‌های صعبالعلاجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 84.28,
   "end": 87.3,
   "text": "این و یه کلمه اون رو هم بنویسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.3,
   "end": 90.06,
   "text": "کلمه بیست و چهار هزار و یک کلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 90.06,
   "end": 93.24,
   "text": "این چند بود؟ چهارصد و پنجاه و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.24,
   "end": 97.48,
   "text": "کلمه بیست و چهار تو جلد یکه این تو جلد پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.48,
   "end": 99.72,
   "text": "اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.72,
   "end": 105.92,
   "text": "این سه تا کار رو انجام داد مریضش شفا نگرفت، دیگه راضی باشه به رضای خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.92,
   "end": 107.74,
   "text": "دو-- جای دیگه نرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.74,
   "end": 113.94,
   "text": "تمام. یا دیگه بدون قضای الهی برای این تحقق گرفته که این آقا، این خانم اینطوری باشه تو هم راضی باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.94,
   "end": 119.44,
   "text": "قرار نیست که ملائکه عالم بلا به قربانگو ما باشن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 119.44,
   "end": 123.74,
   "text": "یه خیری هست، یه صلاحی هست، خداست و خدایی می‌کنه ما هم بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.74,
   "end": 127.78,
   "text": "یکی تربت سید الشهدا اصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.78,
   "end": 130.86,
   "text": "چند شب پیش من یه عزیز بزرگوار رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.86,
   "end": 134.46,
   "text": "اجازه ندارم عرض کنم زیارت کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.46,
   "end": 140.62,
   "text": "که یک پارچه نور بود ایشون با بعضی از دوستان که الان اینجا هستن با هم رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.62,
   "end": 144.08,
   "text": "بعد حالا یه چند ساعتی تنها بودیم با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.08,
   "end": 151.58,
   "text": "حرف‌هایی رو زدیم، مطالبی رو ار-ارائه دادیم که خب ایشون توی سطح بالایی‌ان بتونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.58,
   "end": 155.84,
   "text": "انشاالله دافع باشن یه سری مسائل رو از کشور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 155.84,
   "end": 158.72,
   "text": "ایشون در جزای این حرفای من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.72,
   "end": 161.3,
   "text": "انقدر لذت برد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.3,
   "end": 165.34,
   "text": "یه کلوخ از داخل قبر امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.34,
   "end": 167.68,
   "text": "گفت اینو ما-- که من زدم زیر گریه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.68,
   "end": 170.54,
   "text": "اصلا دیگه حالم منقلب شد و یه وضعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.54,
   "end": 173.96,
   "text": "همون گفت اینو من به شما هدیه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.96,
   "end": 178.68,
   "text": "بتونید تربت‌های اینطوری حالا امروز نریزید سرم من همراهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.68,
   "end": 183.16,
   "text": "آرتی که پاره نکنید اینجا. تربت اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.16,
   "end": 185.92,
   "text": "بعد حرز هم داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.92,
   "end": 190.1,
   "text": "تو مخفاتی هست. شیخ عباس حرز تربت رو مطرح کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.1,
   "end": 193.22,
   "text": "اگر کسی دسترسی به حرز تربت نداشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.22,
   "end": 196.86,
   "text": "وقتی در حرز رو باز می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.86,
   "end": 199.96,
   "text": "یه سوره قدر بخونه بدمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.96,
   "end": 201.62,
   "text": "شیاطین نمی‌تونن تصرف کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.62,
   "end": 203.54,
   "text": "این الان حرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.54,
   "end": 205.32,
   "text": "چیز ببخشید تربته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.32,
   "end": 208.3,
   "text": "همین امروز یه عزیز دیگه‌ای ما حالی به حالی‌ش کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.3,
   "end": 212.52,
   "text": "اینو به ما هدیه داد. یادم رفته گذاشتم رو قلبم امروز با شما صحبت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.52,
   "end": 219.18,
   "text": "تربت رو قلبم باشه. اینو وقت باز می‌کنی بخوای بخوری ناس بخون بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.18,
   "end": 220.96,
   "text": "بخور. دوباره میخوای ببندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.96,
   "end": 223.78,
   "text": "ببخشید فلق. عذر می‌خوام قدر، سوره قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.78,
   "end": 228.3,
   "text": "دوباره میخوای ببندی قبل از اینکه ببندی قدر رو بخون بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.3,
   "end": 231.48,
   "text": "این می‌شه چی؟ حرز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.48,
   "end": 233.62,
   "text": "حرزی که دیگه شی-شیطان نمی‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.62,
   "end": 236.92,
   "text": "حالا چه سریه که اون سوره رو می‌خونی می‌دمی نمی‌تونه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.92,
   "end": 239.98,
   "text": "تصرف کنه؟ اجازه بدید یه وقتی براتون بگیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.98,
   "end": 244.04,
   "text": "اون اسراری داره. اون رو بخوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.04,
   "end": 251.42,
   "text": "بخورونی به مریضت. دو، کلمه تزکیه دست حضرت استاد رو که خیلی هم سنگینه، خیلی هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.42,
   "end": 256.98,
   "text": "حضرت ع-- توضیح داده اون کلمه بیست و چهار که می‌فرماید دست من تا چند روز ورم می‌کرد، درد می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.98,
   "end": 259.16,
   "text": "خود حضرت استاد نوشتن اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.16,
   "end": 262.9,
   "text": "اونم رموزی داره. عکسش هم می‌گیریم نگران نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.9,
   "end": 265.88,
   "text": "تو کانال می‌ذاریم. اونم انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.88,
   "end": 269.06,
   "text": "تزکیه دست که کرد دست بکشه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.06,
   "end": 271.14,
   "text": "موضع درد یا مریض یا هرکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.14,
   "end": 274.62,
   "text": "چندین نفر از رفیقای نزدیک خودم این کار رو کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.62,
   "end": 277.68,
   "text": "شفا. تازه اینو انجام نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.68,
   "end": 282.28,
   "text": "اینم سومیش. شستن قاف اثر دیگریش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.28,
   "end": 285.74,
   "text": "چی؟ شفای مریض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}