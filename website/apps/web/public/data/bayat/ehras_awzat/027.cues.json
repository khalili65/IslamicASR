 "chapters": [
  {
   "index": 0,
   "title": "## از کار فکری تا واردات قلبی",
   "start": 1.2,
   "end": 59.1
  },
  {
   "index": 1,
   "title": "## دستور صبحگاهی: ده بار سورهٔ قدر",
   "start": 59.1,
   "end": 132.06
  },
  {
   "index": 2,
   "title": "## سرّ بیان امام معصوم",
   "start": 132.06,
   "end": 171.34
  },
  {
   "index": 3,
   "title": "## فیض جز با وساطت وسائط نمی‌رسد",
   "start": 171.34,
   "end": 221.34
  },
  {
   "index": 4,
   "title": "## مثال صدا زدن از آن سوی عالم",
   "start": 221.34,
   "end": 313.14
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.2,
   "end": 3.44,
   "text": "از ملزومات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.44,
   "end": 7.28,
   "text": "کار شماست در مسیر سیر و سلوک برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.28,
   "end": 9.92,
   "text": "انشاالله در ثقل نفس شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.92,
   "end": 17.0,
   "text": "در اون مکمن غیبی‌تون حقایق بنشینه صرفاً کار فکری نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.0,
   "end": 25.32,
   "text": "عرفان نظری بسیار خوب، حکمت نظری بسیار خوب، عقل نظری بسیار خوب و تواصوا بالحق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.32,
   "end": 28.66,
   "text": "بسیار خوب اما تواصوا بالصبر بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.66,
   "end": 32.54,
   "text": "بشه عقل عملی، عرفان و حکمت عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.54,
   "end": 40.28,
   "text": "برای اینکه این تبدیل بشه و واردات قلبی برای شما ایجاد بشه و انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.28,
   "end": 47.84,
   "text": "مورد تفضلات وسائط فیض الهی قرار بگیرید بر شما وسائط فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.84,
   "end": 59.1,
   "text": "به عنایت آیه تنزل الملائکه والروح صورت بگیره که اینا رو همه رو انشاالله آینده‌ها با هم بررسی می‌کنیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 59.1,
   "end": 66.5,
   "text": "شما یک کار رو حتما باید هر روز صبح بعد از نماز صبح‌تون انجام بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 66.5,
   "end": 69.04,
   "text": "اونم حالا یک سرش رو خدمتتون عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 69.04,
   "end": 77.04,
   "text": "این کاری که عرض می‌کنم خدمتتون مورد تأکید حضرت استاد بود و البته روایت داریم براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 77.04,
   "end": 81.32,
   "text": "مرحوم شیخ عباس در مفاتیح آورده اما مورد تأکید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 81.32,
   "end": 84.06,
   "text": "علامه حسن زاده علیه الرحمه بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 84.06,
   "end": 89.0,
   "text": "این کار و می‌فرمودند که به فرمایش معصوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 89.0,
   "end": 93.78,
   "text": "شما این کار رو بکنید قدرت خدا رو در رزق بخشیش ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 93.78,
   "end": 101.22,
   "text": "منتها شما که دانش‌آموز و حکمت‌آموز انشاالله و عرفان‌آموز هستید یا هستین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 101.22,
   "end": 105.68,
   "text": "رزقتون میشه رزق حکمت و عرفان انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 105.68,
   "end": 108.58,
   "text": "اونم خیلی آسونه، خیلی ساده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 108.58,
   "end": 114.02,
   "text": "یعنی کسی بگه من اینو دیگه نمی‌تونم انجام بدم دیگه من شرمنده‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 114.02,
   "end": 121.62,
   "text": "اونم بعد از نماز صبح حالا تعقیباتتون تموم شد، کارهاتون تموم شد، هرچی می‌خواید انجام بدید تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 121.62,
   "end": 124.3,
   "text": "حتی خواستید باز یه چرتی بزنید یا نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 124.3,
   "end": 127.74,
   "text": "بیدار بمونید حتماً، حتماً ده بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 127.74,
   "end": 132.06,
   "text": "سوره قدر رو قرائت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 132.06,
   "end": 136.32,
   "text": "این وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 136.32,
   "end": 138.66,
   "text": "بیان امام معصوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 138.66,
   "end": 142.98,
   "text": "به کجا برمی‌گرده؟ سرش کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 142.98,
   "end": 145.76,
   "text": "چه ربطی داره به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 145.76,
   "end": 151.56,
   "text": "من و شما ده بار سوره قدر رو بعد از نماز صبح قرائت کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 151.56,
   "end": 154.78,
   "text": "قدرت خدا رو در رزق بخشیش ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 154.78,
   "end": 160.86,
   "text": "عجیبه. حالا یکی دنبال دنیاشه اشکال نداره اونم می‌تونه استفاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 160.86,
   "end": 165.76,
   "text": "اون هم می‌تونه بهره ببره و برای شما اهل معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 165.76,
   "end": 171.34,
   "text": "سرش کجاست؟ تو همون تنزل الملائکه والروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 171.34,
   "end": 174.5,
   "text": "اصلاً و ابداً رزقی، حالا بگیم فیض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 174.5,
   "end": 177.32,
   "text": "فیضی به من و شما از هر حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 177.32,
   "end": 181.24,
   "text": "چه فیض علم و حکمت باشد، چه فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 181.24,
   "end": 190.44,
   "text": "مال و املاک باشد، هرچه باشد نمی‌رسد مگر با وساطت وسائط فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 190.44,
   "end": 195.36,
   "text": "لوازم فیض که ولن تجد لسنة الله تبدیلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 195.36,
   "end": 197.82,
   "text": "أو تحويلا. خب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 197.82,
   "end": 200.48,
   "text": "وسائط فیض کیا هستند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 200.48,
   "end": 205.88,
   "text": "ملائکه‌اند. کیا ملائکه رو با هم، همراه خودشون میارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 205.88,
   "end": 212.7,
   "text": "روحه، روح اعظمه. که میان یک به‌روزرسانی در وجود ما ایجاد می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 212.7,
   "end": 220.38,
   "text": "مخصوصاً توسط روح، روح اعظم که شب قدر هم بر امام معصوم نازل می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 220.38,
   "end": 224.42,
   "text": "حالا شما تصور کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 224.42,
   "end": 229.14,
   "text": "صدای یه کسی اون ور عالم هم باشه گمان کنید الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 229.14,
   "end": 235.92,
   "text": "شاید قدیم‌ها می‌گفتن کسی باور نمی‌کرد اما الان باورش سخت نیست که شما از اینجا صدات برسه به اون ور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 235.92,
   "end": 238.52,
   "text": "عالم با این بعد مسافت به وسیله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 238.52,
   "end": 242.14,
   "text": "یک مثلا گوشی همراه یا هرچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 242.14,
   "end": 245.4,
   "text": "یه کسی رو هی صدا بزن. یه بار، دو بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 245.4,
   "end": 249.52,
   "text": "علی آقا، علی آقا، علی آقا اصلاً بگو علی، علی، علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 249.52,
   "end": 254.96,
   "text": "اون کسی که هم‌نام علیه متوجه تو می‌شه یا نمی‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 254.96,
   "end": 258.38,
   "text": "اگر با یا منادى صدا بزنی که قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 258.38,
   "end": 261.86,
   "text": "همون بار اول بله، نه هم چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 261.86,
   "end": 264.92,
   "text": "اما اگر با بدون یا اینا، اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 264.92,
   "end": 268.58,
   "text": "حرف داریم درش‌ها. اینا من بی‌خود نمیگم با یا، بی یا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 268.58,
   "end": 270.78,
   "text": "اینو بعداً عرض می‌کنیم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 270.78,
   "end": 276.64,
   "text": "اگر با بدون یا مخاطب باشه اسم شماره یکی فقط صدا بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 276.64,
   "end": 283.5,
   "text": "بگه حسین، حسین، حسین بالاخره شما متوجه‌ش می‌شی یا نمی‌شی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 283.5,
   "end": 285.66,
   "text": "اگه صدا به گوشت برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 285.66,
   "end": 289.94,
   "text": "حالا شما یه بگی تنزل الملائکه والروح، تنزل الملائکه والروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 289.94,
   "end": 292.34,
   "text": "ده بار بگی تنزل الملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 292.34,
   "end": 294.58,
   "text": "اونم الملائکه، همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 294.58,
   "end": 298.74,
   "text": "اونا به اتفاق روح، الروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 298.74,
   "end": 304.98,
   "text": "اونا متوجه شما می‌شن. قطعاً به شما رو می‌کنند میگن چی می‌خواید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 304.98,
   "end": 313.14,
   "text": "چی میگی؟ یعنی دیگه خیلی خودمونی چه مثالی من بزنم همه بفهمین. توجه وسائط فیض به ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}