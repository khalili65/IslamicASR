  {
   "index": 1,
   "title": "## دعای حجاب برای امان از اندیشه‌های بد",
   "start": 61.98,
   "end": 96.4
  },
  {
   "index": 2,
   "title": "تقریباً شش خط دعا است که با بسم الله الرحمن الرحیم و با این آیه آغاز می‌شود:",
   "start": 96.4,
   "end": 117.22
  },
  {
   "index": 3,
   "title": "## دو دعای احتجاب؛ اشتباه نگیرید",
   "start": 117.22,
   "end": 181.38
  },
  {
   "index": 4,
   "title": "### احتجاب امیرالمؤمنین برای دفع خطر",
   "start": 181.38,
   "end": 247.42
  },
  {
   "index": 5,
   "title": "شیاطین جنّی را با این ذکر دفع کنید:",
   "start": 247.42,
   "end": 271.98
  },
  {
   "index": 6,
   "title": "## آیهٔ صخره برای دفع سحر و شیاطین",
   "start": 271.98,
   "end": 303.7
  },
  {
   "index": 7,
   "title": "## احساس تکلیف در بیان نمونه‌های موثّق",
   "start": 303.7,
   "end": 328.1
  },
  {
   "index": 8,
   "title": "## دعا پس از نماز واجب برای بیماری و تنگدستی",
   "start": 328.1,
   "end": 381.13
  },
  {
   "index": 9,
   "title": "## دستور گشایش گره‌های بسته",
   "start": 381.13,
   "end": 536.93
  },
  {
   "index": 10,
   "title": "## تعویذ بطلان سحر از امیرالمؤمنین",
   "start": 536.93,
   "end": 624.63
  },
  {
   "index": 11,
   "title": "## وعدهٔ ادامه",
   "start": 624.63,
   "end": 640.15
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 13.96,
   "end": 17.32,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 17.32,
   "end": 22.68,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 22.68,
   "end": 25.14,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 25.14,
   "end": 28.1,
   "text": "در ادامه‌ی احرازی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 28.1,
   "end": 30.86,
   "text": "وعده داده بودیم بعد از اینکه پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.86,
   "end": 36.96,
   "text": "ورود اجنه در دنیای فعلیمون چه در اجتماع و چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 36.96,
   "end": 40.02,
   "text": "زندگی فردیمون سخن گفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.02,
   "end": 46.16,
   "text": "حرز عبی دجانة و رقه‌الجب رو به عنوان نمونه عرض کردیم بحث ادامه داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 46.16,
   "end": 50.5,
   "text": "یه چند تا حرز و دعا و تعویذ هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.5,
   "end": 54.52,
   "text": "از دستورات اهل بیت علیهم الصلاة والسلام میگم اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.52,
   "end": 61.2,
   "text": "امروز تموم شد همه رو تونستم بگم مهماتش رو که انشاالله تموم و اگر نشد ادامه‌ش فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 61.2,
   "end": 63.9,
   "text": "که یکی از بهترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.9,
   "end": 68.56,
   "text": "دعاها برای محفوظ بودن از اندیشه‌های بد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.56,
   "end": 75.78,
   "text": "مردم پلیده. که حضرت علامه حسن‌زاده این دعا رو در این کتابی که دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 75.78,
   "end": 80.04,
   "text": "منه نامه‌ها و برنامه‌های حضرت استاد، ابتدای نامه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 80.04,
   "end": 84.62,
   "text": "سوم میارن به نام دعای حجاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 84.62,
   "end": 92.48,
   "text": "توصیه می‌کنند که اگر می‌خواید از اندیشه‌های بد مردم در امان باشید، نظر سوء مردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 92.48,
   "end": 96.4,
   "text": "اون فکر پلید مردم در امان باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 96.4,
   "end": 100.26,
   "text": "این دعا رو بخونید که امام صادق صلوات الله عليه فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 100.26,
   "end": 102.64,
   "text": "حالا تقریباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 102.64,
   "end": 106.76,
   "text": "شش خط دعا که بسم الله الرحمن الرحیم و با این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.76,
   "end": 112.7,
   "text": "شروع می‌شه که \"و اذَا قَرَأْتَ الْقُرْآنَ جَعَلْنَا بَيْنَكَ وَبَيْنَ الَّذِينَ لَا يُؤْمِنُونَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 112.7,
   "end": 116.46,
   "text": "بِالْآخِرَةِ حِجَابًا مَسْتُورًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 116.46,
   "end": 122.62,
   "text": "این یه دعائه. البته ما دعا به نام احتجاب دو تا دیگه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 122.62,
   "end": 129.02,
   "text": "این که تا این دعایی که الان عرض کردیم دعای حجابه برای محفوظ بودن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 129.02,
   "end": 131.3,
   "text": "تفکرات سوء زن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 131.3,
   "end": 133.89,
   "text": "پندار زشت این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 133.89,
   "end": 139.12,
   "text": "اما اون احتجاب که دو گونه است یکیشو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 139.12,
   "end": 146.76,
   "text": "از آقای قاضی نقل کردن که سید هاشم حداد نسبت داده البته به آقای قاضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 146.76,
   "end": 149.9,
   "text": "که فرمودن برای نورانیت قلب خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 149.9,
   "end": 153.54,
   "text": "یه مقدار به اون کیفیتی که سید هاشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 153.54,
   "end": 161.46,
   "text": "میاره در کتابش، یه مقدار با تفاوت اندکی تو کتاب مهج الدعوات سید ابن طاووس هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 161.46,
   "end": 167.9,
   "text": "همین دعایی که برای چیه؟ نورانیت قلبه به نام احتجاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 167.9,
   "end": 173.08,
   "text": "حالا اگر خواستید نشونی داشته باشید اون که از آقای قاضیه اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 173.08,
   "end": 179.7,
   "text": "\"اللهم إني أسألك يا من احتجب بشعاع نوره عن نوادر خلق\" ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 179.7,
   "end": 181.38,
   "text": "این برای نورانیت قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 181.38,
   "end": 184.4,
   "text": "اما اون دعای احتجابی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 184.4,
   "end": 192.22,
   "text": "از مولامون امیرالمؤمنین علیه الصلاة والسلام هست و مرحوم مجلسی نقل کرده برای دفع خطر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 192.22,
   "end": 197.34,
   "text": "هر خطری، مطلق خطرات و پناه بردن به خدا یعنی یک تعویذه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 197.34,
   "end": 199.56,
   "text": "اعوذ و پناه می‌برم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 199.56,
   "end": 203.22,
   "text": "به خدا. اون دعا اونم اسمش احتجابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 203.22,
   "end": 212.86,
   "text": "اینو یه وقت اشتباه نکنید. این از مولا علیه \"بسم الله الرحمن الرحیم احتجبت بنور وجه القدیم الكامل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 212.86,
   "end": 218.08,
   "text": "ادامه‌ش. این هم یک دعا که خیلی برای تعویذ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 218.08,
   "end": 221.62,
   "text": "عالیه. یعنی که انسان رو حفظ کنه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 221.62,
   "end": 224.1,
   "text": "بلاها و مشکلات فعلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 224.1,
   "end": 228.5,
   "text": "حالا یه روایت خیلی شیرین از پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 228.5,
   "end": 232.96,
   "text": "دیدم که پیغمبر فرمود شیاطین دو گونه‌اند:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 232.96,
   "end": 237.04,
   "text": "جنی و انسی. بعد فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 237.04,
   "end": 240.46,
   "text": "شیاطین جنی رو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 240.46,
   "end": 245.66,
   "text": "\"لا حول ولا قوة إلا بالله العلی العظیم\" دفع کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 245.66,
   "end": 250.94,
   "text": "شیاطین جنی رو. یعنی محال شما تو خونه‌ت، تو محل کارت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 250.94,
   "end": 254.44,
   "text": "داری از خونه میای بیرون، یه جا میری یهو می‌ترسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 254.44,
   "end": 259.24,
   "text": "هر جا این ذکر رو بگی شیاطین جنی فاصله نگیرن ازت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 259.24,
   "end": 264.34,
   "text": "این مجربه. انسی‌ها رو یعنی شیاطین انسان رو چگونه دفع کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 264.34,
   "end": 267.46,
   "text": "فرمود با ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 267.46,
   "end": 270.8,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 270.8,
   "end": 273.22,
   "text": "محمد. یکی دیگه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 273.22,
   "end": 276.88,
   "text": "تعویذها که فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 276.88,
   "end": 283.57,
   "text": "پیغمبر فرمودن تعلیم کردن به مولا برای دفع شیاطین و جادوگران و جادوی جادوگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 283.57,
   "end": 288.84,
   "text": "اونایی که حس می‌کنند آقا ما رو جادو کردن، آقا ما رو طلسم کردن و این قبیل موارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 288.84,
   "end": 292.5,
   "text": "پیغمبر فرمود این آیه‌ی صخره رو زیاد بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 292.5,
   "end": 294.11,
   "text": "آیه‌ی صخره هم که معروفه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 294.11,
   "end": 301.34,
   "text": "\"إن ربكم الله الذي خلق السماوات والأرض في ستة أيام\" تا ادامه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 301.34,
   "end": 306.54,
   "text": "این هم یه نمونه که عرض کردیم عزیزانی که حالا ما می‌دونید خیلی عادت نداشتیم هیچ‌وقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 306.54,
   "end": 312.58,
   "text": "الان چند ساله محضر شما هستیم معمولاً براهین عقلی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 312.58,
   "end": 315.38,
   "text": "پیاده می‌کنیم بحث‌های عقلی و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 315.38,
   "end": 322.38,
   "text": "ولی خب انقدر به ما رجوع کردن، انقدر گفتن، گفتن دیگه احساس تکلیف کردیم یه چند تایی نمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 322.38,
   "end": 326.14,
   "text": "عرض کنیم خدمتتون که همش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 326.14,
   "end": 328.1,
   "text": "منبع داره و موثق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 328.1,
   "end": 332.68,
   "text": "یکی دیگه از دعا‌هایی که خیلی عالیه خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 332.68,
   "end": 341.6,
   "text": "پیغمبر عظیم الشأن اسلام از ایشون روایت شده که یه شخصی اومد پیش پیغمبر شکایت کرد از بیماری و تنگدستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 341.6,
   "end": 344.26,
   "text": "اونایی که زیاد مریض می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 344.26,
   "end": 348.3,
   "text": "و فشار اقتصادی روشون زیاده این کارو انجام بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 348.3,
   "end": 351.28,
   "text": "پیغمبر فرمودن بعد از هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 351.28,
   "end": 362.61,
   "text": "نماز واجب بگو \"لا حول ولا قوة إلا بالله توکلت على الحي الذي لا يموت والحمد لله الذي لم يتخذ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 362.61,
   "end": 370.73,
   "text": "صاحبة ولا ولدا ولم یکن له شریک في الملك ولم یکن له ولی من الذل وكبره تکبیرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 370.73,
   "end": 373.93,
   "text": "نگران نشید تو تعقیبات مشترک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 373.93,
   "end": 376.85,
   "text": "مفاتی شیخ عباس این رو آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 376.85,
   "end": 381.13,
   "text": "دو جورم آورده. یه دونه بدون لا حول ولا و یه دونه با لا حول ولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 381.13,
   "end": 387.87,
   "text": "اینکه حالا تأکید بسیاری از بزرگان من اینو دیدم که داشتن بعضیا هم گفتن مثلاً ده مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 387.87,
   "end": 396.05,
   "text": "بعضیا گفتن نه همون یک بار کفایت می‌کنه که در یک روایتی دیدم که فرمود هیچ شدتی پیغمبر آ، پیغمبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 396.05,
   "end": 399.09,
   "text": "هیچ شدتی به من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 399.09,
   "end": 403.11,
   "text": "راه پیدا نکرد یعنی سختی، شدت، گرفتاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 403.11,
   "end": 410.03,
   "text": "مگر اینکه جبرائیل برای من متمثل شد و گفت این دعا رو بخون و در احادیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 410.03,
   "end": 413.79,
   "text": "مکرر داریم که برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 413.79,
   "end": 423.37,
   "text": "وسوسه‌هایی که تو سینه ایجاد می‌شه یا تو سینه خودت یا دیگری نفس می‌زنه، نفس پلید دیگری و قرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 423.37,
   "end": 426.73,
   "text": "و پریشانی و بیماری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 426.73,
   "end": 428.67,
   "text": "اونم بیماری مکرر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 428.67,
   "end": 430.53,
   "text": "گفتن این دعا رو زیاد بخونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 430.53,
   "end": 433.77,
   "text": "که حالا عرض کردم سندش هم گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 433.77,
   "end": 437.13,
   "text": "من هر وقت خودم این دعا رو می‌خونم واقعاً تنم می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 437.13,
   "end": 441.13,
   "text": "خیلی دعای عجیبیه همین که الان قرائت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 441.13,
   "end": 445.47,
   "text": "اما اونایی که بعضیا میان می‌گن آقا ما اصلا انگار بسته شده همه چی به روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 445.47,
   "end": 449.09,
   "text": "ما مثلاً یه گره‌ای افتاده، زندگیمون بسته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 449.09,
   "end": 455.41,
   "text": "از این چیزا می‌شنویم. اتفاقاً یه دستوری رو در عوذات معفوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 455.41,
   "end": 460.41,
   "text": "شیخ عباس باز آورده. می‌تونید ببینید اونجا بخش عوذات معفوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 460.41,
   "end": 464.81,
   "text": "تعویض‌ها. صفحه هزار و سیصد و هفت هست از امام صادق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 464.81,
   "end": 467.37,
   "text": "یه دستورالعملیه. حالا من اشاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 467.37,
   "end": 473.49,
   "text": "کنم بعد می‌رید پیداش می‌کنید که حضرت فرمودن کس که فکر می‌کنه بسته شده همه چی به روش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 473.49,
   "end": 475.25,
   "text": "درا به روش بسته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 475.25,
   "end": 479.21,
   "text": "فرمود اول سوره انا فتحنا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 479.21,
   "end": 482.27,
   "text": "تا اونجایی که می‌گه مستقیما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 482.27,
   "end": 486.51,
   "text": "بنویسه. بعد سوره نصر رو ادامه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 486.51,
   "end": 489.23,
   "text": "بنویسه و اون رو همراه خودش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 489.23,
   "end": 493.15,
   "text": "یا اینکه مثلاً یه گردنبند کنه به گردنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 493.15,
   "end": 498.01,
   "text": "داشته باشه که و من آیاته ان خلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 498.01,
   "end": 501.71,
   "text": "لكم من انفسكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 501.71,
   "end": 505.39,
   "text": "ازواجا لتسكنوا الیهن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 505.39,
   "end": 507.41,
   "text": "این آیات رو هم اضافه کنه بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 507.41,
   "end": 510.97,
   "text": "پس شد از، از ابتدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 510.97,
   "end": 516.91,
   "text": "سوره فتح تا مستقیما به علاوه سوره نصر اذا جاء نصر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 516.91,
   "end": 524.97,
   "text": "به علاوه این دسته آیات و من آیاته ان خلق لكم من انفسكم ازواجا لتسكنوا الیهن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 524.97,
   "end": 527.39,
   "text": "حضرت صادق فرمود اینا رو بنویسه همراه خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 527.39,
   "end": 531.85,
   "text": "دیگه، دیگه نباید بگه آقا گره بسته همه چی به رو من نه باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 531.85,
   "end": 535.05,
   "text": "اگر بسته شدی این باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 535.05,
   "end": 537.57,
   "text": "دیگه بعد عرض شود از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 537.57,
   "end": 539.67,
   "text": "عوذات معفوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 539.67,
   "end": 545.97,
   "text": "برای خدمتتون عرض کنم که حرز برای بطلان سحر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 545.97,
   "end": 550.05,
   "text": "اینم بگم حالا چند تا دیگه مونده فرصت نیست ان‌شاءالله فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 550.05,
   "end": 552.87,
   "text": "از امیرالمؤمنین قربونش بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 552.87,
   "end": 562.64,
   "text": "یه سری اومدن گلایه کردن آقا سحر می‌کنن، جادو می‌کنن اینا بعضیا الان اینجوری گمان می‌کنند زندگیشون مثلاً سحر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 562.64,
   "end": 564.69,
   "text": "مثلاً طلسمی چیزی براشون نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 564.69,
   "end": 567.47,
   "text": "زیاد میان به ما میگن. خب بسم الله اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 567.47,
   "end": 573.55,
   "text": "امیرالمؤمنین علیه الصلاة والسلام این تعویذ رو فرمودن بر پوست آهو بنویس همراه خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 573.55,
   "end": 577.29,
   "text": "داشته باش که این تعویذ رو خیلی شیرینه خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 577.29,
   "end": 579.97,
   "text": "اصلاً خود متن تعویذ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 579.97,
   "end": 582.56,
   "text": "بذارید چون دیگه آخریشه اینو بخونم کوتاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 582.56,
   "end": 584.99,
   "text": "بسم الله و بالله. ببینید چقدر عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 584.99,
   "end": 587.99,
   "text": "چقدر شیرین. بسم الله و بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 587.99,
   "end": 589.61,
   "text": "بسم الله و ما شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 589.61,
   "end": 592.73,
   "text": "بسم الله و لا حول و لا قوة الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 592.73,
   "end": 596.17,
   "text": "قال موسی جئتم به السحر ان الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 596.17,
   "end": 600.05,
   "text": "سیبطلہ. ان الله لا يصلح عمل المفسدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 600.05,
   "end": 603.67,
   "text": "فوقع الحق و بطل ما کانوا يعملون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 603.67,
   "end": 606.97,
   "text": "فقلبوا هنالك و انقلبوا صاغرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 606.97,
   "end": 610.41,
   "text": "این رو هم اگه خواستید پیدا کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 610.41,
   "end": 613.11,
   "text": "تو مفاتی قسمت تعویذ اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 613.11,
   "end": 616.11,
   "text": "فهرستش اینطوری خورده. تعویذ بطلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 616.11,
   "end": 618.65,
   "text": "سحر و جادو. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 618.65,
   "end": 621.65,
   "text": "در همون مفاتی عوذات معفوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 621.65,
   "end": 624.47,
   "text": "مرحوم شیخ عباس آورده از امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 624.47,
   "end": 629.05,
   "text": "یه چند تا دیگه هم هست که اونا هم خیلی شیرینن، خوبن و خیلی مجرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 629.05,
   "end": 635.43,
   "text": "ان‌شاءالله فردا تقدیم می‌کنیم. ان‌شاءالله که عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 635.43,
   "end": 640.15,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}