 },
 "chapters": [
  {
   "index": 0,
   "title": "## هدیه‌ای به شکرانهٔ برکت امروز",
   "start": 0.76,
   "end": 23.82
  },
  {
   "index": 1,
   "title": "## آیات أسرع در خروج از ظلمت به نور",
   "start": 23.82,
   "end": 54.68
  },
  {
   "index": 2,
   "title": "یکی از مهم‌ترین آیات برای اخراج از ظلمت به نور، آیه‌ای است که خودِ متن آیه بر همین معنا دلالت می‌کند:",
   "start": 54.68,
   "end": 91.7
  },
  {
   "index": 3,
   "title": "## تردّد شصت‌وشش و قرائت پیش از خواب",
   "start": 91.7,
   "end": 130.68
  },
  {
   "index": 4,
   "title": "## توصیه به هر که امروز شنید",
   "start": 130.68,
   "end": 197.14
  },
  {
   "index": 5,
   "title": "خدا نور اوست. علم نیز نور است.",
   "start": 197.14,
   "end": 246.12
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.76,
   "end": 7.48,
   "text": "می‌خوام یه هدیه‌ای به شما بدم که این هدیه رو پوست منو می‌کندید به شما نمی‌دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.48,
   "end": 12.56,
   "text": "به برکتی که امروز به بنده رسید به شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.56,
   "end": 14.86,
   "text": "شکرانه می‌خوام تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.86,
   "end": 20.5,
   "text": "این هدیه از یکی از آیات و اولیاء الهی بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.5,
   "end": 23.6,
   "text": "به بنده، به شما عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.6,
   "end": 30.04,
   "text": "خب بعضی از آیات خاصیت‌شون برای خروج از ظلمت به نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.04,
   "end": 38.62,
   "text": "أسرع یعنی سریع‌تره مثل ولکن سفینه الحسین صلوات الله عليه أسرع وأوسع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.62,
   "end": 47.54,
   "text": "یکی از مهم‌ترین آیات برای اخراج از ظلمت به نور که اصلاً خود متن آیه داره دلالت می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.54,
   "end": 51.96,
   "text": "آیه الله ولی الذین آمنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 51.96,
   "end": 54.68,
   "text": "یخرجهم من الظلمات إلى النور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.68,
   "end": 59.88,
   "text": "در تفسیر روایی آیات که اگر شما کتاب تفسیر روایی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 59.88,
   "end": 64.66,
   "text": "دیده باشید، اونجا روایت میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 64.66,
   "end": 67.8,
   "text": "از امام معصوم که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.8,
   "end": 72.8,
   "text": "این نور من الظلمات إلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.8,
   "end": 76.48,
   "text": "النور، این نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.48,
   "end": 79.02,
   "text": "خود نور ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.02,
   "end": 82.82,
   "text": "یعنی تو بگیر این النور رو بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.82,
   "end": 86.34,
   "text": "حضرت بقیت الله الاعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.34,
   "end": 91.7,
   "text": "که تو رو این آیه، همین یه آیه بله یه همچین ظرفیتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.7,
   "end": 99.44,
   "text": "همین یک آیه البته به اصل تردد دیگه قبلاً توضیح دادیم تردد یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.44,
   "end": 103.42,
   "text": "وردت بشه حالا عددشم حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.42,
   "end": 107.62,
   "text": "دوست داشتید عیب نداره بنویسید عددشم شصت و شش‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 107.62,
   "end": 111.94,
   "text": "بهترین تاثیرش در شصت و شش‌ه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 111.94,
   "end": 114.76,
   "text": "قرائت این آیه. بهترین وقتش کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 114.76,
   "end": 120.88,
   "text": "قبل از خوابه. که می‌خواید سیر کنی به ملکوت عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.88,
   "end": 126.4,
   "text": "بری به ملکوت و استیضاح کنی، سید کنی حقایق عالم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.4,
   "end": 130.48,
   "text": "این شما رو از ظلمت‌ها به سرعت خارج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.48,
   "end": 139.26,
   "text": "من توصیه می‌کنم به هر کسی که امروز اینجا بود و شنید حتی عزیزانی که تو کلاس هم نیستن و الان می‌خوان پاشن برن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 139.26,
   "end": 144.84,
   "text": "اینو هدیه الهی به خودشون بدونن و حداقل شب یک بار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 144.84,
   "end": 149.4,
   "text": "یک بار بله، یک بار قبل خوابشون بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 149.4,
   "end": 159.62,
   "text": "بنده دیشب چندین بار گفتم و اثرش رو دیدم و انشاالله شما رو خارج می‌کنه از ظلمت‌ها به سمت نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 159.62,
   "end": 162.72,
   "text": "قبلاً گفتیم یکی از معانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 162.72,
   "end": 165.38,
   "text": "دقیق ولایت خود علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 165.38,
   "end": 169.74,
   "text": "گفتیم در نشئه طبیعت حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 169.74,
   "end": 172.92,
   "text": "اسمش هست علیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 172.92,
   "end": 176.66,
   "text": "در نشئه ملکوت اسمش هست أعلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 176.66,
   "end": 181.06,
   "text": "بالاتر از اون چی؟ جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 181.06,
   "end": 185.58,
   "text": "خود علمه. خود علم خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 185.58,
   "end": 188.8,
   "text": "الله نور السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 188.8,
   "end": 194.34,
   "text": "الله نوره دیگه. حالا العلم آفرین، نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 194.34,
   "end": 197.14,
   "text": "يغرفها الله في قلب من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 197.14,
   "end": 201.72,
   "text": "پس اصلاً، اساساً ولایت نوره، نور ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 201.72,
   "end": 204.66,
   "text": "هرچه خدا تجلی داره به نور تجلی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 204.66,
   "end": 208.04,
   "text": "ظهور حضرت حق از باطن به نوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.04,
   "end": 210.8,
   "text": "و جز علم نمی‌شه به اونجا رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 210.8,
   "end": 215.18,
   "text": "نقطه مقابلش هم جهله. اگر کسی الان این کلاس، کلاس چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 215.18,
   "end": 216.94,
   "text": "چرا این حرف‌ها رو ما داریم می‌زنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 216.94,
   "end": 225.74,
   "text": "اونچه که ما هدیه ابتدای جلسه‌تون داریم میدیم همش داره شما رو کمک می‌کنه که هلتون بده به سمت نور علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 225.74,
   "end": 229.96,
   "text": "و الله خب الا ماشاالله دستور العمل هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 229.96,
   "end": 235.1,
   "text": "این تا اینجا یه هدیه، یه هدیه جانانه که اگر قدرش رو بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 235.1,
   "end": 240.64,
   "text": "انشاالله شما رو می‌رسونه به شهود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 240.64,
   "end": 242.52,
   "text": "از کشف هم ردتون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 242.52,
   "end": 246.12,
   "text": "البته باید مداومت کرد و طهارت نفس داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}