 "chapters": [
  {
   "index": 0,
   "title": "## هدیه‌ای از استادی بنام",
   "start": 0.24,
   "end": 20.42
  },
  {
   "index": 1,
   "title": "## خواهش بیست‌سالگی: علمی که خدا به زور عطا کند",
   "start": 20.42,
   "end": 41.18
  },
  {
   "index": 2,
   "title": "## دستورالعمل: آیة‌الکرسی پس از تسبیحات حضرت زهرا",
   "start": 41.18,
   "end": 124.26
  },
  {
   "index": 3,
   "title": "## «و علّم آدم الأسماء کلها»",
   "start": 124.26,
   "end": 220.74
  },
  {
   "index": 4,
   "title": "قرآن می‌گوید هیچ چیزی نیست؛ هیچ‌کس را فروگذار نکرده است:",
   "start": 220.74,
   "end": 246.4
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 7.12,
   "text": "یکی از اساتید خیلی بنام و بزرگی که ما درکشون کردیم یه هدیه‌ای به ما تقدیم کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.12,
   "end": 12.38,
   "text": "که ایشون ارتباط با امام عصر هم داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.38,
   "end": 15.58,
   "text": "و نوزده سال هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.58,
   "end": 24.1,
   "text": "پیشنهاد امام جماعت حرم حضرت ابالفضل صلوات الله عليه بودن، قریبه به بیست سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.1,
   "end": 26.16,
   "text": "خیلی ما از ایشون بهره بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.16,
   "end": 29.3,
   "text": "من حدودا بیست سالم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.3,
   "end": 41.18,
   "text": "از ایشون، خودم بودم و ایشون، از ایشون خواهش کردم که یه راهی به بنده یاد بدید خدا به زور به من علم بده .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 41.18,
   "end": 47.36,
   "text": "شما دوست دارید یا نه؟ دوست دارید یا نه واقعا به زور خدا بهت علم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.36,
   "end": 50.92,
   "text": "یعنی خودت یهو به خودت بیای ببینی اِاِاِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.92,
   "end": 53.84,
   "text": "اصن شاید خودتم استنکاف می‌کردی اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.84,
   "end": 57.96,
   "text": "خدا داره تزریق می‌کنه بهت از در و دیوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.96,
   "end": 62.18,
   "text": "این دستورالعمل رو از حدود سی سال پیش بنده انجام دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 62.18,
   "end": 66.56,
   "text": "خیلی هم آسونه و همه هم شاید دارید انجام میدید ولی بی‌خبرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.56,
   "end": 69.7,
   "text": "شاید یک سر از این جلسه همون باشه اصن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.7,
   "end": 77.02,
   "text": "شما دارید انجام میدید این جلسه رو گذاشتن که به شما تزریق علم کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.02,
   "end": 80.26,
   "text": "ما انجام دادیم و خودم تجربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.26,
   "end": 85.34,
   "text": "در تجربه شخصی خودم دیدم این رو واقعا چشیدم، بهش رسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.34,
   "end": 90.22,
   "text": "لذا چیزی که خودم چشیدم چرا از شما دریغ کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 90.22,
   "end": 94.74,
   "text": "فرمودن که بعد از هر نماز واجب‌تون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.74,
   "end": 99.62,
   "text": "بعد از تسبیحات حضرت صدیقه شهیده سلام الله علیها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.62,
   "end": 102.94,
   "text": "آیه الکرسی رو قرائت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.94,
   "end": 109.44,
   "text": "به همین راحتی . کسی که این کار رو مداومت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.44,
   "end": 112.66,
   "text": "خدا ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.66,
   "end": 116.36,
   "text": "کفیل او می‌شه از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.36,
   "end": 120.4,
   "text": "تعلیم علم. علّم و علّم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.4,
   "end": 122.88,
   "text": "آدم الاسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 122.88,
   "end": 126.54,
   "text": "كلها. این علّم کی علّم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.54,
   "end": 130.34,
   "text": "کی تعلیم کرده به آدم الاسماء رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.34,
   "end": 135.94,
   "text": "همه رو همه كلها که علّم فرمودن روحشون شاد حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.94,
   "end": 140.36,
   "text": "میگم حضرت استاد بدونید منظور حضرت علامه حسن زاده علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.36,
   "end": 147.12,
   "text": "فرمودن که به جای الاسماء می‌تونید بگذارید الأشیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 147.12,
   "end": 150.54,
   "text": ". چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 150.54,
   "end": 158.29,
   "text": "جلسه پیش عرض کردیم اگه یکی یه جلسه جا بمونه دیگه گیرپاچ می‌کنه به قولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 158.29,
   "end": 161.3,
   "text": "، در جا می‌زنه. برای همین توصیه می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 161.3,
   "end": 171.38,
   "text": "غائب نشید چون ما فعلاً بلا نداریم این صوت‌هایی که ضبط می‌شه رو حتی به خود شماها بدیم، چه برسه تو کانال بذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 171.38,
   "end": 176.98,
   "text": "دوست دارم تو خود جلسه بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 176.98,
   "end": 180.8,
   "text": "عرض کردیم که همه اشیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 180.8,
   "end": 183.62,
   "text": "تجلیات الهین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 183.62,
   "end": 187.36,
   "text": "ظهور حقن. لذا یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 187.36,
   "end": 191.72,
   "text": "ظهور اسما الحسنی و صفات اولیا الهین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 191.72,
   "end": 196.18,
   "text": "لذا کسی که، ممنونم آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 196.18,
   "end": 200.08,
   "text": "کسی که می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 200.08,
   "end": 203.36,
   "text": "اسما رو درک کنه باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 203.36,
   "end": 205.8,
   "text": "اشیا رو درک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 205.8,
   "end": 209.42,
   "text": "یکی از این اشیا خود حضرت عالی هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 209.42,
   "end": 211.9,
   "text": "این که قرآن میگه \"ام من شيء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 211.9,
   "end": 220.74,
   "text": "هیچ چیزی نیست، همه رو فروگ-- هیچکس رو فروگذار نکرد دیگه \"الا مثلا یسبح بحمده\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.74,
   "end": 223.6,
   "text": "پس خود شما هم یکی از اون اشیا هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 223.6,
   "end": 225.9,
   "text": "بعد می‌بینید که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 225.9,
   "end": 229.9,
   "text": "معلمت می‌شه. حالا دیگه اینو باید بچشید دیگه امتحان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 229.9,
   "end": 236.8,
   "text": "امتحان کردن امثال منی که ضعیفیم برای ما اشکال نداره خدا رو امتحان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 236.8,
   "end": 242.16,
   "text": "آدم‌هایی که بزرگ می‌شن این رو گناه می‌دونن اصلاً امتحان کردن خدا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 242.16,
   "end": 246.4,
   "text": "حالا انشاالله که داشتید این رو ولی از اینجا به بعد شروع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}