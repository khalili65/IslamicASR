 "cues": [
  {
   "i": 0,
   "start": 4.46,
   "end": 8.14,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.14,
   "end": 11.5,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.5,
   "end": 13.62,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.62,
   "end": 17.34,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.34,
   "end": 21.8,
   "text": "تبریک عرض می‌کنم میلاد بسیار با عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.8,
   "end": 29.9,
   "text": "امام چهارم حضرت علی ابن الحسین زین العابدین و زينت عبادت کنندگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.9,
   "end": 35.6,
   "text": "سید و آقای سجده کنندگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.6,
   "end": 41.02,
   "text": "الله اکبر از عظمت ایشون که خیلی عجیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.02,
   "end": 45.96,
   "text": "که فرمودن در بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.96,
   "end": 51.44,
   "text": "کسی که منبری اهل بهشته از اون طبقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.44,
   "end": 58.22,
   "text": "اعلی‌ا بگیر تا انزل مراتب بهشت، اون کسی که منبر میره و معارف رو انتقال میده ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.22,
   "end": 60.84,
   "text": "خیلی عجیب. حالا چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.84,
   "end": 67.9,
   "text": "دیگه سرش در چیه؟ چون بر اساس آیه \"وَعِدَ رَبِّهِمْ يُرْزُقُونَه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.9,
   "end": 74.32,
   "text": "که مرحوم سید بحر العلوم تو رساله سیر و سلوکش میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 74.32,
   "end": 77.32,
   "text": "اونچه که اونجا رزق هست دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.32,
   "end": 81.28,
   "text": "به قول حالا متعارف میگن سیب و گلابی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.28,
   "end": 84.66,
   "text": "به این شکل نیست. اونجا رزق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.66,
   "end": 87.48,
   "text": "رزق عقلی‌ست، معارف است، علم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.48,
   "end": 90.34,
   "text": "حالا اون کسی که به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.34,
   "end": 97.3,
   "text": "رزاق اهل بهشته که منبر میره و معارف رو انتقال میده ایشونه، امام سجاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.3,
   "end": 100.5,
   "text": "چه عظمتی داشته و داره ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.5,
   "end": 104.16,
   "text": "که حالا میشه به یک معنا هم گفت سرش در همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.16,
   "end": 108.52,
   "text": "سید الساجدين بودنش है، سجده، سجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.52,
   "end": 112.3,
   "text": "که خدای منان به حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.3,
   "end": 121.62,
   "text": "علی نبی و آله و علیه الصلاة والسلام فرمود که میدونی چرا تو رو اختیار کردم به کلیم الله بودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 121.62,
   "end": 130.4,
   "text": "به جهت اینکه دیدم در میان خلایقم تو بیشتر از همه بعد از فرائضت می‌شینی سجده می‌کنی با من گفت‌وگو می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 130.4,
   "end": 132.42,
   "text": "بعضیا رو دیدی تا نمازشون در میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 132.42,
   "end": 135.38,
   "text": "تموم می‌شه دِ فرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.38,
   "end": 138.52,
   "text": "سریع. یه تسبیحاتم به زور میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.52,
   "end": 141.2,
   "text": "اما نه بعضیا دلشون نمیاد به سرعت برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.2,
   "end": 143.86,
   "text": "می‌شینن تعقیبات عقب نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 143.86,
   "end": 147.64,
   "text": "عقبه داره نمازشون. می‌شینن دعا می‌کنن، ذکر میگن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.64,
   "end": 151.7,
   "text": "سجده خصوصاً سجده‌های طولانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.7,
   "end": 158.9,
   "text": "اتفاقاً بحث ما چون احراز و اوضات و ادعیه و این‌ها به صورت خاص بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.9,
   "end": 161.18,
   "text": "به هر حال صاحبش هم امروزه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.18,
   "end": 166.92,
   "text": "زينتش امروزه. که تا جایی که اون صحیفه ایشون رو زبور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.92,
   "end": 172.7,
   "text": "اهل بیت فرمودن. یادمه ما بچه که بودیم خدا رحمت کنه هم واتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 172.7,
   "end": 178.3,
   "text": "مادرم رو خدا بیامرزد می‌گفت پسرم قرآن یه خواهر برادر هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 178.3,
   "end": 184.36,
   "text": "می‌فرمود که خواهر قرآن صحیفه سجادیه است برادرش نهج‌البلاغه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 184.36,
   "end": 188.54,
   "text": "و واقعاً هم چنین هست. چه عظمتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 188.54,
   "end": 190.04,
   "text": "در صحیفه هست. به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 190.04,
   "end": 195.26,
   "text": "حضرت استاد علامه حسن زاده علیه الرحمه که می‌فرمودند در روایات و احادیث اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 195.26,
   "end": 200.66,
   "text": "بیت نسبت به صعه‌ی وجودی مخاطبشون و مستمعشون حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 200.66,
   "end": 204.04,
   "text": "یعنی مخاطب رو در نظر گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 204.04,
   "end": 213.46,
   "text": "اون حقایق عرشی رو ریختن روی کلمات، الفاظی که هر کسی متوجه نمی‌شه و مت-- نمی‌تونست یعنی ظرفیتشو نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 213.46,
   "end": 218.32,
   "text": "اما مقامات انشایی‌شون در ادعیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 218.32,
   "end": 221.44,
   "text": "یعنی در ادعیه امام سجاد صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 221.44,
   "end": 229.84,
   "text": "غوغا کرده. یعنی دقیق‌ترین، لطیف‌ترین و شریف‌ترین معارف رو شما می‌تونی در میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 229.84,
   "end": 235.4,
   "text": "ادعیه پیدا کنی. همین دعاها، همین احراز، اوضات، تعویذ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 235.4,
   "end": 237.1,
   "text": "حرز، دعاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 237.1,
   "end": 240.38,
   "text": "اینا همینان. اینا مقامات انشایی اونان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 240.38,
   "end": 246.36,
   "text": "که با اه-- با خدای منان به سخن افتادن دیگه ربطی به مستمع نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 246.36,
   "end": 249.66,
   "text": "با خدا داره صحبت می‌کنه لذا مقامات انشایی‌شونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 249.66,
   "end": 251.42,
   "text": "ظهور وجودی‌شونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 251.42,
   "end": 259.68,
   "text": "اینا خیلی عظمت داره. به عنوان نمونه حالا برای اینکه الصاق کنیم، سنجاق کنیم بحث رو به مباحث هر روزمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 259.68,
   "end": 265.16,
   "text": "یکی دیگه از دعاهایی که خیلی تأکید شده روش دعای مکنونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 265.16,
   "end": 269.48,
   "text": "البته تو مفاتیح هست. تو قسمت تعقیبات مشترکه می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 269.48,
   "end": 273.84,
   "text": "ابن بابویه و شیخ طوسی و غیره زیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 273.84,
   "end": 282.26,
   "text": "این رو نقل کردن به سندهای معتبری از امیرالمؤمنین علیه الصلاة والسلام که هر که بخواهد حالا اثرش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 282.26,
   "end": 292.2,
   "text": "هر که بخواهد که بیرون رود از دنیا و حال آنکه پاک شده باشد از گناهان چنانکه پاک می‌شود طلا از غش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 292.2,
   "end": 298.58,
   "text": "کی دوست داره به گونه‌ای از دنیا بره که از همه گناها پاک شده باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 298.58,
   "end": 306.34,
   "text": "و از او اینجاش خیلی شیرینه و از او عهدی بازخواست مظلمه ننماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 306.34,
   "end": 310.92,
   "text": "این مظالم عباد. اون چیزی که گردنش هست یعنی حق الناس حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 310.92,
   "end": 316.2,
   "text": "حالا چه ارتباطی هست بین این دعا و برداشته شدن حق الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 316.2,
   "end": 320.24,
   "text": "حالا توی روایت دیگه اونو بخوایم به این الصاق کنیم حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 320.24,
   "end": 326.06,
   "text": "ابا عبدالله الحسین صلوات الله علیه فرمودند که ما در این مقام میایم به شفاعت دوستانمون حتی حقوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 326.06,
   "end": 330.52,
   "text": "مالیشون رو هم ما از جیب خودمون می‌پردازیم و صاحبان حق رو راضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 330.52,
   "end": 332.98,
   "text": "می‌کنیم. این البته به گوش هرکسی نباید برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 332.98,
   "end": 336.88,
   "text": "بعد ادعا می‌کنند هیتیا خب دیگه کلا اعوذ بالله حالا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 336.88,
   "end": 343.5,
   "text": "هرکی بدهکاریم و این‌ها دیگه ولش کن دیگه امام حسین هست مثل اون هیت که ما می‌رفتیم ماشاالله چه جوونای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 343.5,
   "end": 346.06,
   "text": "گریه‌کن و خودشونو می‌کشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 346.06,
   "end": 351.5,
   "text": "لطم‌زنان، مویه کنان با سر تو دیوار رفتنان روضه که ما می‌خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 351.5,
   "end": 357.26,
   "text": "بعد مداح اونه یاد که رفیقمونه گفت هفتاد درصد این بچه‌ها رو-- نماز نمی‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 357.26,
   "end": 361.1,
   "text": "باهاشون که صحبت کردیم می‌گفتن نماز ما رو امام حسین تو کربلا خونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 361.1,
   "end": 363.68,
   "text": "حالا این حدیثم بشنون دیگه هیچی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 363.68,
   "end": 366.44,
   "text": "بگیم آقا کلاه اینو اونم ورداریم و دیگه ارباب داریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 366.44,
   "end": 368.47,
   "text": "نه اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 368.47,
   "end": 372.69,
   "text": "یه سری دارد که حالا به بختش دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 372.69,
   "end": 377.57,
   "text": "که امروز روزیه نفوس شما شده اون هم نه هر کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 377.57,
   "end": 384.11,
   "text": "پس فرمود که در قیامت این چنین وارد می‌شه در حالی که مظلمه‌ای به گردنش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 384.11,
   "end": 387.95,
   "text": "حالا می‌شه تو همین دنیا اهل بیت کمک کنن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 387.95,
   "end": 389.97,
   "text": "مظالم عبادشو بتونه بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 389.97,
   "end": 395.25,
   "text": "بدهکاری‌هاشو بده، حق الناس رو رضایت بگیره اینا یا خب اون ور حالا اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 395.25,
   "end": 399.41,
   "text": "بالاخره دست به کار می‌شن. خب چه کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 399.41,
   "end": 403.05,
   "text": "چیز کمی نیست این‌ها. چه کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 403.05,
   "end": 407.67,
   "text": "فرمود که بخواند بعد از نمازهای پنج گانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 407.67,
   "end": 409.85,
   "text": "نسبت پروردگارا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 409.85,
   "end": 415.39,
   "text": "بدونید توی کتاب‌ها هر کجا فرمود نسبت پروردگارو بخون سوره قل هوالله احده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 415.39,
   "end": 422.55,
   "text": "این شناسنامه خداست. تنها surه ای است که درش از هیچ کسی جز خدا سخن نگفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 422.55,
   "end": 425.57,
   "text": "حتی آیه سه سوره حدید هو الاول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 425.57,
   "end": 427.69,
   "text": "اون هو قل هوالله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 427.69,
   "end": 432.71,
   "text": "حالا اینجا هو الاول والاخر والظاهر والباطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 432.71,
   "end": 434.79,
   "text": "باز درسته همش هو است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 434.79,
   "end": 437.63,
   "text": "اول آخر ظاهر باطن همه هواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 437.63,
   "end": 442.55,
   "text": "اما و هو بكل شيء عليم باز شی توش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 442.55,
   "end": 446.37,
   "text": "به غیر از حق توش اومده. حق اون ذات غیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 446.37,
   "end": 448.25,
   "text": "توش باز شی اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 448.25,
   "end": 451.69,
   "text": "اون surه ای که هیچ چیزی جز حق توش نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 451.69,
   "end": 453.71,
   "text": "ذات غیبی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 453.71,
   "end": 455.59,
   "text": "surه قل هوالله. بهش می‌گن نسبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 455.59,
   "end": 460.55,
   "text": "خب این رو فرمودن دوازده مرتبه بعد از نمازهای پنج گانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 460.55,
   "end": 464.77,
   "text": "بخونه بعد دستش رو به دعا بلند کنه بیاره بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 464.77,
   "end": 471.31,
   "text": "که این دعا از راز-- امیرالمؤمنین داره می‌فرمادا رازهای مکنون است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 471.31,
   "end": 473.69,
   "text": "که رسول خدا مکنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 473.69,
   "end": 477.69,
   "text": "ااا بر وزن مفعول از کن میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 477.69,
   "end": 481.55,
   "text": "فی کتاب مکنون. تو surه واقع می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 481.55,
   "end": 486.03,
   "text": "کن، کن یعنی توی پرده‌ایه، پوشیده شده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 486.03,
   "end": 490.11,
   "text": "هر کسی به سرش هست، هر کسی دسترسی به این دعا پیدا نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 490.11,
   "end": 495.17,
   "text": "الان بعضی جاها ما اینا رو می‌گیم طرف ریشاش سفید شده اولین باره داره این دعا رو می‌شنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 495.17,
   "end": 499.39,
   "text": "اع یه همچین دعایی هم هست؟ رزق باید باشه، باید توفیق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 499.39,
   "end": 501.21,
   "text": "اینطوری نیست هر کسی بهش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 501.21,
   "end": 504.53,
   "text": "تازه بهش هم برسی به سرش هر کسی نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 504.53,
   "end": 511.45,
   "text": "فرمود پیغمبر من رو تعلیم کرد که من این دعا رو باز به من تاکید کرد به حسنین هم تعلیم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 511.45,
   "end": 516.43,
   "text": "یعنی جزو دعاهاییه که دست‌به‌دست شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 516.43,
   "end": 520.97,
   "text": "که حضرت امام فرمود مناجات شعبانیه رو من ندیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 520.97,
   "end": 526.34,
   "text": "جان؟ surه قل هوالله رو دوازده بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 526.34,
   "end": 530.43,
   "text": "بله دوازده بار surه قل هوالله رو می‌خونی بعد این دعا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 530.43,
   "end": 535.11,
   "text": "دستم بلند می‌کنی. حالا اونجا حضرت امام فرمودن در خصوص مناج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 535.11,
   "end": 538.45,
   "text": "مناجات شعبانیه فرمودن که من ندیدم حضرت امام عین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 538.45,
   "end": 545.21,
   "text": "صحبتشون فرمودن من ندیدم دعایی که همه اهل بیت خونده باشن جز مناجات شعبانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 545.21,
   "end": 555.03,
   "text": "چیزی که بنده حقیر متوجه شدم اینم ظاهراً همه اهل بیت داشتن و خوندن چون مکنونه و دست‌به‌دست شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 555.03,
   "end": 563.53,
   "text": "خب این رو وقتی که دستو بلند کردی اینو حالا اگه کسی عبارت عربیشو خب حالا نمی‌تونید حس کنید که پنج شش خطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 563.53,
   "end": 565.85,
   "text": "توی مفاتیح عرض کردم تعقیبات مشترکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 565.85,
   "end": 568.71,
   "text": "ببینید دعای مکنون از امیرالمؤمنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 568.71,
   "end": 573.93,
   "text": "عبارتش جهت حالا تبرکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 573.93,
   "end": 576.25,
   "text": "نور لفظ هم برخوردار بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 576.25,
   "end": 582.77,
   "text": "\"اللهم إنی أسألك باسمك المکنون المخزون الطاهر الطهر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 582.77,
   "end": 587.95,
   "text": "به به مبارک. اون اسمی که مکنونه، مخزونه، طاهره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 587.95,
   "end": 589.94,
   "text": "متهره، مبارکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 589.94,
   "end": 592.73,
   "text": "\"وأسألك باسمك العظيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 592.73,
   "end": 598.51,
   "text": "پیداست که اسم عظیم، اسم اعظم حق تو این دعا هست \"وسلطانك القديم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 598.51,
   "end": 602.47,
   "text": "يا واهب العطايا\". اینجا پای حضرت شیس در کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 602.47,
   "end": 606.33,
   "text": "همه منح و عطایای الهی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 606.33,
   "end": 609.7,
   "text": "وساطت حضرت شیس می‌باره سر بندگانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 609.7,
   "end": 618.71,
   "text": "\"وأسألك باسمك العظيم، وسلطانك القديم، يا واهب العطايا، يا مطلق العصارة، يا فكاك الرقاب من النار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 618.71,
   "end": 624.51,
   "text": "صل على محمد وآل محمد وفك رقبتي من النار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 624.51,
   "end": 630.29,
   "text": "وأخرجني من الدنيا آمنا، وأدخلني الجنة سالما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 630.29,
   "end": 636.81,
   "text": "واجعل دعائي أوله فلاحا، وأوسطه نجاحا، وآخره صلاحا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 636.81,
   "end": 642.73,
   "text": "إنك أنت علام الغيوب\" که دیدم سید ابن طاووس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 642.73,
   "end": 647.35,
   "text": "فرموده در خصوص قل هوالله که تو اینجا ده، دوازده بار اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 647.35,
   "end": 651.51,
   "text": "خوبه اینم بدونید که از رسول خدا روایت آورده سید ابن طاووس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 651.51,
   "end": 657.81,
   "text": "هر کس یه بار فقط حالا اینجا که دوازده بار، یه بار surه قل هوالله رو بعد از نمازش بخونه رحمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 657.81,
   "end": 660.97,
   "text": "از آسمان پیغمبر فرمود به سرش می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 660.97,
   "end": 662.67,
   "text": "سکینه بر او نازل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 662.67,
   "end": 666.39,
   "text": "آرامش. خدا نظر رحمت بهش می‌افکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 666.39,
   "end": 674.71,
   "text": "گناهاش رو می‌بخشه و هر حاجتی که در پی قل هوالله احد سؤال کنه برآورده‌ست و در امان خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 674.71,
   "end": 680.21,
   "text": "الله اکبر. اینه که بعضی از بزرگان من دیدم فرمودن بعد از نمازهای واجب‌تون یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 680.21,
   "end": 685.61,
   "text": "surه قل هوالله هدیه کنید به مادر امام زمان حضرت نرگس خاتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 685.61,
   "end": 688.8,
