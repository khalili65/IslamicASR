 ],
 "cues": [
  {
   "i": 0,
   "start": 0.48,
   "end": 3.68,
   "text": "خب توقع دارم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.68,
   "end": 7.22,
   "text": "مثل دیشب خیلی الحمد لله خوب و وزین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.22,
   "end": 13.0,
   "text": "بچه‌ها خادما همه بیان جلو دیگه بقیه هر جا عشق داشتن باشن کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.0,
   "end": 15.56,
   "text": "خادمایی که ثبت‌نام داشتن بیان جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.56,
   "end": 20.74,
   "text": "تو خانوما هم همون مثل دیشب به وزان دیشب خیلی خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.74,
   "end": 24.86,
   "text": "همه نشستن سلام علیک‌هاشون رو بشن آخر جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.86,
   "end": 29.62,
   "text": "کسی هم وارد شد سلام علیک هم حتی نکنه بشینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.62,
   "end": 34.76,
   "text": "همه رو بذارید انتهای جلسه. بچه‌ها رو هم دیگه هرکی آروم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.76,
   "end": 39.18,
   "text": "انشاالله یه نیم ساعتی در خدمت شما خوبان باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.18,
   "end": 41.74,
   "text": "جانتون رو در اختیار این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.74,
   "end": 45.3,
   "text": "آیات و روایات و نورانیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.3,
   "end": 48.14,
   "text": "بحث قرار بدید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.14,
   "end": 51.0,
   "text": "قبل از اینکه شروع به بحث کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.0,
   "end": 53.8,
   "text": "دوستان تذکر عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.8,
   "end": 59.78,
   "text": "یکی اینکه سعی کنیم انشاالله اهل سحر باشید، اهل تعارض باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.78,
   "end": 63.2,
   "text": "هر چقدر که شما عزم‌تون جدی‌تر باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.2,
   "end": 66.86,
   "text": "سحر مخصوصاً از سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.86,
   "end": 69.48,
   "text": "کمک و مدد بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.48,
   "end": 71.82,
   "text": "برای فهم این حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.82,
   "end": 74.84,
   "text": "کمک‌حالتونه. چقدر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.84,
   "end": 81.06,
   "text": "در خونه اهل بیت خدا گریه کردیم، سوختیم، داد زدیم که اینو میخوام، اونو میخوام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.06,
   "end": 84.12,
   "text": "این مریضی رو بگیر، اونو بهم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.12,
   "end": 91.88,
   "text": "یک بار شد که در خونه اهل بیت داد بزنیم، بسوزیم، اشک بریزیم که ما چرا نمی‌فهمیم حقایق رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.88,
   "end": 94.72,
   "text": "چرا بعضی معارف رو تو کله‌ی ما نمیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.72,
   "end": 98.9,
   "text": "چرا عقل ما ورزیده نیست؟ خب چرا ما نسوختیم برای این؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.9,
   "end": 103.6,
   "text": "چرا؟ خب بیایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.6,
   "end": 108.96,
   "text": "شیوه مون رو عوض کنیم. اصلاً یه بار بریم حرم امام رضا، ده بار بریم حرم امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.96,
   "end": 111.36,
   "text": "هیچی نخوایم جز فهم معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.36,
   "end": 114.04,
   "text": "مگر حقیقت همین نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.04,
   "end": 117.3,
   "text": "ولاغیر. بقیه بازی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.3,
   "end": 122.38,
   "text": "خب بسوزیم، گریه کنیم، خواهش کنیم، سحر پاشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.38,
   "end": 127.62,
   "text": "احترام قائل بشیم، ارزش قائل بشیم برای این حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.62,
   "end": 130.58,
   "text": "اینکه بزرگان مثل علامه حسن زاده میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.58,
   "end": 135.62,
   "text": "هیچکس حق نداره جز دو زانو تو جلسه درس معارف بشینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.62,
   "end": 142.2,
   "text": "این ماها که نمیگیم اون بزرگان میگن به جهت وزانت اون معارفه، اون حقایقه، عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.2,
   "end": 145.3,
   "text": "کلاس درسه، کلاس بحثه، کلاس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.3,
   "end": 151.7,
   "text": "عرض شود دنیا که نیست کلاس معارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.7,
   "end": 156.22,
   "text": "حالا منظور از دو زانو، نمیخواد الان یه دفعه همه دو زانو بشید یعنی با ادب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.22,
   "end": 160.04,
   "text": "این یک مثال مصداقیه که با ادب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.04,
   "end": 162.94,
   "text": "ولو نباشید، تکیه ندی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.94,
   "end": 165.64,
   "text": "ارزش قائل بشی برای معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.64,
   "end": 167.96,
   "text": "و کسی که میخواد استفاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.96,
   "end": 171.06,
   "text": "کسی که نمیخواد ما کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.06,
   "end": 175.62,
   "text": "این یه نکته. پس از سحر انشاالله استفاده بگیرید با تعارض بیایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.62,
   "end": 180.54,
   "text": "میشه یه دوره تسبیح استغفار کنید بیایید اون ذکرها رو بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.54,
   "end": 182.62,
   "text": "با ماشین که با خونواده دارید میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.62,
   "end": 188.12,
   "text": "همه خونواده با همون نوزده تا بسم الله رو بگید، اون چهارده تا یا واسعه رو بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.12,
   "end": 192.68,
   "text": "ببینید تاثیرش رو، برکتش رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.68,
   "end": 195.64,
   "text": "این یه نکته. نکته‌ی بعد این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.64,
   "end": 198.02,
   "text": "شما هر طور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.02,
   "end": 200.16,
   "text": "اینجا حاضر باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.16,
   "end": 207.66,
   "text": "در انشراح قلبی گوینده‌تون و به ظاهر معلم‌تون تاثیر گذارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.66,
   "end": 212.54,
   "text": "یعنی هرچی شما تشنه‌تر باشید، جان وجود شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.54,
   "end": 216.96,
   "text": "تشنه‌تر باشه و عطش داشته باشه چون اون حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.96,
   "end": 220.26,
   "text": "علم از ملکوت نازل میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.26,
   "end": 224.2,
   "text": "و تنزل پیدا می‌کنه میاد در سرشت و جان شما می‌نشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.2,
   "end": 227.08,
   "text": "ما یک وسیله‌ایم. خود منم همینطور هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.08,
   "end": 235.76,
   "text": "جان هممون داره تغذیه می‌کنه و اون علم هم که قبلاً گفتیم نور است و مسترش ذات خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.76,
   "end": 242.18,
   "text": "لذا هرچی شما آماده‌تر باشید می‌بینید زبان گوینده‌ت بدون لکنت‌تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.18,
   "end": 244.36,
   "text": "شرح صدرش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.36,
   "end": 251.0,
   "text": "بعد می‌بینی گوینده‌اش در جان تو نگاه می‌کنه، طلب تو رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.0,
   "end": 255.86,
   "text": "توجه کردی عزیزم؟ ت-- بعد اون موقع می‌بینی اصلاً گوینده خودتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.86,
   "end": 262.06,
   "text": "تو داری طلب می‌کنی، گوینده در جان وجود تو می‌بینه طلب‌ت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.06,
   "end": 269.02,
   "text": "خدا تو وجود او-- خدا به او القا می‌کنه طلب تو رو و او بیان می‌کنه برای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.02,
   "end": 273.74,
   "text": "باز می‌بینی گوینده تویی، شنونده تویی، همه چی تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.74,
   "end": 276.22,
   "text": "همه چی جانه، همه چی نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.22,
   "end": 279.9,
   "text": "اینا جز حقایق کلاس‌های درسی و معارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.9,
   "end": 282.72,
   "text": "کلاس اونطور که دانشگاه هست و اینها که نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.72,
   "end": 287.78,
   "text": "سرشت ما میگیم آقا نمره میدیم، امتحان می‌گیریم، اون برای اهمیت کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.78,
   "end": 291.82,
   "text": "اینم یه نکته. نکته‌ی سوم این که پس نزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.82,
   "end": 298.06,
   "text": "می‌دونم بعضی از مواردی که ما داریم میگیم البته من همه رو مزه مزه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.06,
   "end": 301.68,
   "text": "خدا الحمد لله لطف کرده یه مقداری اینو نرم‌ترش می‌کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.68,
   "end": 307.28,
   "text": "رقیق‌ترش می‌کنم از اون غلظت و پیچیدگی و سختی تو کام شما میذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 307.28,
   "end": 311.74,
   "text": "اگر بعضیاش پیچیده‌ست بعداً این گره‌ها وا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 311.74,
   "end": 317.32,
   "text": "صبور باشید. الان اگر می‌شنوی این اشتباه به ما برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.32,
   "end": 321.0,
   "text": "این مشکل تو وجود ماست که چرا این حرفا رو نشنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.0,
   "end": 324.1,
   "text": "عده‌ای میگن آقا الان این حرفا به چه درد ما می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 324.1,
   "end": 328.2,
   "text": "الان بیایید مثلاً مبحث گناه شناسی بذارید ما تو گناه گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 328.2,
   "end": 331.24,
   "text": "یعنی انقدر انسان لول خودشو بیاره پایین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.24,
   "end": 333.44,
   "text": "گناهی که یه چیز فطریه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.44,
   "end": 338.18,
   "text": "کدوم یکی از ما فطرتاً نمی‌دونیم دروغ بده، نمی‌دونیم غیبت بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.18,
   "end": 340.9,
   "text": "علمشو نداریم. هممون عالمیم تو این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 340.9,
   "end": 343.16,
   "text": "هممون می‌دونیم گناه چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.16,
   "end": 346.06,
   "text": "هممونم دیدیم، شنیدیم، خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.06,
   "end": 352.88,
   "text": "اون چیزی که ما نشنیدیم، ندیدیم، به ذهنمون برخورد نکرده، این حقایق و حکمت‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 352.88,
   "end": 355.5,
   "text": "این به قول یونانی‌ها فلسفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.5,
   "end": 358.34,
   "text": "به قول ما بچه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 358.34,
   "end": 360.62,
   "text": "مکتبی و مذهبی حکمته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.62,
   "end": 362.34,
   "text": "عرفانه. اینو ما نشنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 362.34,
   "end": 364.66,
   "text": "این به ذهن ما برخورد نکرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.66,
   "end": 368.38,
   "text": "عقل ما ورزیده نیست لذا پس میزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 368.38,
   "end": 374.82,
   "text": "اون کاری نداره گناه شناسی یه کتاب اخلاق علامه شبستری رو وردار بخون بفهم چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.82,
   "end": 379.3,
   "text": "گناه شناسی، نمیدونم گناهان کبیره شهید دستغیب رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.3,
   "end": 382.9,
   "text": "چهل تا گناه رو بررسی کرده قشنگ مبسوط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.9,
   "end": 386.9,
   "text": "نمیدونم معراج السعاده مرحوم نراقی رو بخون قشنگ توضیح داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.9,
   "end": 389.15,
   "text": "همه فهم هم هستن اون کتاب‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 389.15,
   "end": 391.72,
   "text": "اون سیر مطالعاتی رو خودت داشته باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.72,
   "end": 396.66,
   "text": "اگرچه ما تو دل بحث به یه جایی بر می‌خوریم که اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.66,
   "end": 402.92,
   "text": "لاجرم ناگزیریم اونجا برنامه سیر مطالعاتی بدیم و الا نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.92,
   "end": 408.48,
   "text": "نمیشه ما گیر می‌کنیم. یکیش همین مطالعه در خصوص موانع رشد و سیر و سلوک خوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.48,
   "end": 412.82,
   "text": "خودمونه که همون مثلاً که، مثلاً این کتاب گناه شناسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.82,
   "end": 415.02,
   "text": "اما تا ما نفسمون رو نشناسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.02,
   "end": 421.0,
   "text": "تا جانمون رو نشناسیم، این سیر مطالعاتی هم به دردمون نمی‌خوره، خستمون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 421.0,
   "end": 424.66,
   "text": "بگذارید یه ذره یه چیزکی از خودمون حالیمون بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 424.66,
   "end": 429.1,
   "text": "از درون خودمون خبر بگیریم، این دفینه‌های وجودمون رو بریزیم بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 429.1,
   "end": 434.28,
   "text": "ببینیم عجب چه گنجینه‌ای در درون ما نهفته بوده و ما بی‌خبر بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.28,
   "end": 438.3,
   "text": "اون موقع متوجه می‌شیم از کجا باید شروع کنیم و به کجا ختم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.3,
   "end": 442.52,
   "text": "یکی از دوستام خوبم که الان اینجا نشسته سوار ماشینش بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.52,
   "end": 445.64,
   "text": "یه بحث خیلی خوبی، یه کارشناسی داشت ارائه می‌داد قرآنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.64,
   "end": 451.26,
   "text": "خوب بود، بحث قشنگی بود. بعضی مطالبی که می‌گفت من خودم توجه نداشتم پیش از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.26,
   "end": 457.18,
   "text": "گفتم ایشون کیه؟ بعد راهنمایی کرد مثلاً معرفی کرد بعد گفت ببر حاجی ببرم بخوای گوش بده دوست داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.18,
   "end": 462.36,
   "text": "گفتم نه، نه. این که من خوشم اومد دلیل نداره من الان برم اینو گوش بدم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 462.36,
   "end": 465.8,
   "text": "الان گذری از م-- ماشین شما شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.8,
   "end": 468.94,
   "text": "اما من سیر مطالعاتی برای خودم الان دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.94,
   "end": 473.38,
   "text": "اینو اگه بردارم بخونم اون سیر خراب میشه، پاره میشه رشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 473.38,
   "end": 476.62,
   "text": "اصلاً ذهن من مشوش میشه، مشوب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 476.62,
   "end": 479.14,
   "text": "اونو ولش کن. الان اون به درد من نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 479.14,
   "end": 481.32,
   "text": "سیر رو باید درست بری جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.32,
   "end": 485.9,
   "text": "هی بخواه قطع و وصلی از این کتاب به اون کتاب، از این استاد به اون استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.9,
   "end": 490.48,
   "text": "کاری که من یه زمانی خودم غلط کاری کردم و اشتباه کردم رو شما نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 490.48,
   "end": 493.7,
   "text": "یه ذره تحمل کنید، یه ذره که البته بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.7,
   "end": 496.6,
   "text": "البته من مطمئنم ریزش خواهیم داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 496.6,
   "end": 500.6,
   "text": "بعضیا به بهانه خادمی فرم فقط پر کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 500.6,
   "end": 505.2,
   "text": "حالا کلاس درس و بحث هم نرفتیم، نرفتیم دیگه حاج آقا مهربونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 505.2,
   "end": 507.62,
   "text": "نخیر این حرفا نیست، این خبرا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 507.62,
   "end": 510.94,
   "text": "لذا ما اینو کلاسو گذاشتیم هرکی دوست داره بیاد استفاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.94,
   "end": 514.14,
   "text": "به بهانه این نخواد بیاد تو شاکله خادمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.14,
   "end": 516.12,
   "text": "هرکی بخواد استفاده بکنه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 516.12,
   "end": 523.08,
   "text": "اما اون که خادمه باید اینجا جوابگو باشه، پاسخگو باشه و باید ببینیم تو هم، تو آینه وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.08,
   "end": 526.24,
   "text": "هم اثر این بحث‌ها رو داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 526.24,
   "end": 530.16,
   "text": "من به شما عرض کنم خودم ملتزمم هرچی میگم لحاظ کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.16,
   "end": 532.86,
   "text": "گفتم با همسرانتون مباحثه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.86,
   "end": 536.22,
   "text": "من با خانم خودم شروع کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 536.22,
   "end": 540.2,
   "text": "و جالبه وقتی با هم گفتگو می‌کنید می‌بینید اِه!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 540.2,
   "end": 542.08,
   "text": "حاجی که می‌گفت نفهمیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 542.08,
   "end": 544.96,
   "text": "الان که با هم مباحثه می‌کنیم دارم می‌فهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 544.96,
   "end": 552.84,
   "text": "یه بار، دو بار، سه بار. باورتون نمیشه امروز یک درس استاد رو من گوش می‌دادم شاید بار شاید مثلاً دهم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 552.84,
   "end": 554.82,
   "text": "نمی‌دونم. خیلی گوش دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 554.82,
   "end": 558.08,
   "text": "خیلی. فکر می‌کنم امروز دهام، پونزدهم اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 558.08,
   "end": 562.92,
   "text": "امروز اصلاً انگار یه چیزایی که نشنیده بودم تو کی، تو صحبت‌های استاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 562.92,
   "end": 565.66,
   "text": "عجب! گره‌ها اونجا باز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 565.66,
   "end": 569.94,
   "text": "به این، اصلاً اینا به گوشم انگار نخورده بود دفعه قبل که گوش می‌دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 569.94,
   "end": 572.22,
   "text": "باید بارها گوش بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 572.22,
   "end": 575.76,
   "text": "این مباحث کلیدی‌ان، علمی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 575.76,
   "end": 579.04,
   "text": "اینم یه نکته دیگه. بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 579.04,
   "end": 582.58,
   "text": "دلسوزن. خب بالاخره دوست دارن ما رو ما هم شما رو دوست داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 582.58,
   "end": 587.9,
   "text": "گفت حاج‌آقا ما می‌ترسیم این حرف‌هایی که داری می‌زنی برات حرف درست شه، تهمت بخوری و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 587.9,
   "end": 590.9,
   "text": "اولاً ما هرچی داریم می‌گیم با سند و مدرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 590.9,
   "end": 593.36,
   "text": "یعنی هر، حالا شما تأمل کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 593.36,
   "end": 596.08,
   "text": "تأمل کنید. نمی‌خواستم الان بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 596.08,
   "end": 598.12,
   "text": "می‌خواستم آخر بحث بگم شیرین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 598.12,
   "end": 600.2,
   "text": "کتابو رو کنی بگین اِه! ما اینو داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 600.2,
   "end": 601.84,
   "text": "سیر این کتاب رو می‌رفتیم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 601.84,
   "end": 604.5,
   "text": "چه قشنگ. حاجی کتاب سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 604.5,
   "end": 606.7,
   "text": "شما می‌گیری دسته خیلی سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.7,
   "end": 608.24,
   "text": "متوجه این کلمات نمی‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 608.24,
   "end": 610.78,
   "text": "ما داریم این کلماتو با شما کار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 610.78,
   "end": 613.8,
   "text": "بعد کتابو باز کردی میگی اِه! داری سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 613.8,
   "end": 621.9,
   "text": "دروس معرفت مثلاً نهج‌البلغه علامه حسن زاده آملی رو داری دستت گرفتی و داری می‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 621.9,
   "end": 625.68,
   "text": "مباحثی که این مثلاً دو سه شب شروع کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 625.68,
   "end": 628.41,
   "text": "همون شرح نهج‌البلغه علامه حسن زاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 628.41,
   "end": 632.44,
   "text": "البته من نباید اینو الان به شما می‌گفتم از نظر اصول درسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 632.44,
   "end": 635.9,
   "text": "اون مال مرحله دوم بود که گفتم ما سه تا سیر داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 635.9,
   "end": 639.26,
   "text": "اول فقط کار می‌کنیم یه ذره عقلمون ورزیده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 639.26,
   "end": 645.64,
   "text": "مرحله دوم کتابو می‌گیریم دست همه میدیم از رو کتاب شروع می‌کنیم یاد کردن، کلمات پیچیده رو می‌خونیم، میریم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 645.64,
   "end": 649.82,
   "text": "مرحله سوم تخاص، تخصصی‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 649.82,
   "end": 654.02,
   "text": "که حالا شما کمک کنید به من متوقف نشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 654.02,
   "end": 658.72,
   "text": "پشت هم باشید. انشاالله با اخلاق خوب و خوش شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 658.72,
   "end": 667.28,
   "text": "من مطمئنم ریزش داریم اما بذارید شده پنج نفر آخر بارها گفتم بمونین ولی بدونین که این سیر رو رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 667.28,
   "end": 670.74,
   "text": "بعد آثار و برکاتش رو خودتون متوجه می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 670.74,
   "end": 675.48,
   "text": "زحمت باید براش بکشید. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 675.48,
   "end": 677.44,
   "text": "جانم. نه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 677.44,
   "end": 687.05,
   "text": "یه صلوات بفرستین. اللهم صل على محمد و آل محمد و عجل فرجهم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}