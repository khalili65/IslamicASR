 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 3.66,
   "text": "اللهم صل علی محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.66,
   "end": 5.64,
   "text": "آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.64,
   "end": 11.26,
   "text": "فرجهم. اللهم صل علی محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.26,
   "end": 14.26,
   "text": "فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.26,
   "end": 17.34,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.34,
   "end": 25.36,
   "text": "السلام علیک یا داعی الله و ربانی آیاته سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.36,
   "end": 32.72,
   "text": "یکی دیگه از، از کارهایی که خیلی خیلی خیلی توصیه شده و در روایت داریم امت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.72,
   "end": 36.48,
   "text": "اسلام دو امان بیش نداشته و ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.48,
   "end": 40.0,
   "text": "یکی پیغمبر عزیز عالم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.0,
   "end": 41.64,
   "text": "و یکی هم استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.64,
   "end": 44.18,
   "text": "استغفار امان امته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.18,
   "end": 47.76,
   "text": "و در بحث اجنه و ورود اهریمن‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.76,
   "end": 53.31,
   "text": "اون جادوها و سحر و طلسم و این‌ها که می‌تونه روزی انسانو ببنده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.31,
   "end": 57.84,
   "text": "انسان رو مریض کنه، مشکلاتی ایجاد کنه که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.84,
   "end": 61.62,
   "text": "یکی از بهترین از کارهایی که دفع می‌کنه این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.62,
   "end": 67.86,
   "text": "و نعمت رو سر انسان می‌باره مثل بارش باران، استغفاره، کثرت استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.86,
   "end": 70.14,
   "text": "اتفاقاً در سوره هود آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.14,
   "end": 75.96,
   "text": "سه حضرت هود امت‌ش رو تشویق می‌کنه به استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.96,
   "end": 82.38,
   "text": "و ان استغفروا ربکم ثم توبوا الیه یمتعکم متاعاً حسنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.38,
   "end": 85.9,
   "text": "می‌فرماید استغفار کنید، پروردگارتونو عذرخواهی کنید ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.9,
   "end": 89.68,
   "text": "ثم توبوا. بعد توبه کنید، برگشت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.68,
   "end": 92.7,
   "text": "چه اتفاقی می‌افته؟ آیه قرآن دارم می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.7,
   "end": 96.3,
   "text": "یمتعکم متاعاً حسنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.3,
   "end": 99.0,
   "text": "متاع نیکویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.0,
   "end": 101.26,
   "text": "متمتع می‌شید ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.26,
   "end": 104.56,
   "text": "الی اجل مسمى. یعنی تو همین دنیا تا وقت مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.56,
   "end": 107.64,
   "text": "و يؤتی كل ذي فضل فضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.64,
   "end": 112.0,
   "text": "اسم فاضل خدا هم که بیش از استحقاق بخشیدنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.0,
   "end": 114.88,
   "text": "یعنی غرق در نعمت می‌شید با استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.88,
   "end": 123.44,
   "text": "اتفاقا خب قوم عاد که زمان حضرت هود بود می‌دونید آدمای قد بلند و درشت هیکل و قوی و یا آدمای سرسخت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.44,
   "end": 127.78,
   "text": "این‌هایی بودند خیلی غرق در برکات و نعمت‌های الهی هم بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.78,
   "end": 136.08,
   "text": "قدای بلند. جالبه که بدونید در آیه هشت سوره فجر می‌فرماید لم يخلق مثلها في البلاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.08,
   "end": 139.3,
   "text": "اصلاً تو هیچ زمانی مثل این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.3,
   "end": 141.98,
   "text": "قوم عاد خلق نکرده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.98,
   "end": 145.84,
   "text": "یه آدمای عجیبی، درشت هیکل و قوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.84,
   "end": 150.72,
   "text": "و خیلی هم این‌ها از جهت مالی متمول، خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.72,
   "end": 153.58,
   "text": "مرفه، وضع خوب، غرق در نعمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.58,
   "end": 156.54,
   "text": "بعد این‌ها رفته رفته به عصیان افتادن، به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.54,
   "end": 161.38,
   "text": "بت‌پرستی و این‌ها افتادن و متأسفانه به پیغمبرشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.38,
   "end": 171.26,
   "text": "تهمت دیوانگی زدن این‌ها که حالا آیه یک سوره رعد هم می‌فرمود إن الله لا یغیر ما بقوم حتی یغیروا ما بأنفسهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.26,
   "end": 173.66,
   "text": "خدا حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.66,
   "end": 180.6,
   "text": "هیچ امتی رو تغییر نمی‌ده تا وقتی که خودشون، خودشون که تغییر می‌کنند اوضاع عوض می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.6,
   "end": 183.16,
   "text": "این‌ها تغییر کردند خدا نعمت رو سلب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.16,
   "end": 186.88,
   "text": "تا هفت سال قحطی شد، باران نمی‌اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.88,
   "end": 188.54,
   "text": "آسمان بر این‌ها دریغ کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.54,
   "end": 193.42,
   "text": "مریضی اومد، فقر، خشکسالی، ضعف، ناتوانی به شدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.42,
   "end": 198.36,
   "text": "بعد حضرت هود این‌ها رو، درمان این‌ها رو استغفار بیان کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.36,
   "end": 199.94,
   "text": "استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.94,
   "end": 205.92,
   "text": "اتفاقاً در آیه ده و دواز-- تا دوازده سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.92,
   "end": 210.54,
   "text": "نوح هم خیلی زیبا می‌فرماید فقل تستغفروا ربکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.54,
   "end": 212.22,
   "text": "انه کان غفارا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.22,
   "end": 216.86,
   "text": "استغفار کنید از پروردگارتون قطعاً او بخشنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.86,
   "end": 220.0,
   "text": "بعد که وقتی شما استغفار کنید چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.0,
   "end": 222.74,
   "text": "پیامد استغفار چیه بر اساس این آیات؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.74,
   "end": 225.76,
   "text": "یرسل السماء عليكم مدرارا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.76,
   "end": 228.5,
   "text": "به شدت بارون سرتون بارش می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.5,
   "end": 230.72,
   "text": "و یمددکم بأموال و بنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.72,
   "end": 235.36,
   "text": "شما-- خدا شما رو مدد می‌رسونه با مال‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.36,
   "end": 237.0,
   "text": "و فرزندان پسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.0,
   "end": 239.18,
   "text": "بنین. ام البنین که می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.18,
   "end": 242.24,
   "text": "بنین. و یجعل لكم جنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.24,
   "end": 244.1,
   "text": "براتون باغ‌هایی قرار می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.1,
   "end": 247.32,
   "text": "و یجعل لكم انهارا. نهرها جاری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.32,
   "end": 249.34,
   "text": "در پس چی؟ استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 249.34,
   "end": 250.89,
   "text": "انقدر که توصیه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 250.89,
   "end": 256.86,
   "text": "اتفاقا یه روایتی دیدم خیلی جالب بود برام در ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 256.86,
   "end": 264.42,
   "text": "جمع الغای بیان تفسیر همین آیات ده تا دوازده مرحوم طبرسی میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.42,
   "end": 270.44,
   "text": "امام رضا قربونش برم نشسته بود عده‌ای می‌اومدن از ایشون خب بالاخره حاجتشون بیان می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.44,
   "end": 273.76,
   "text": "یکی اومد نالید از خشکسالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 273.76,
   "end": 277.06,
   "text": "یکی اومد از فقر ناله کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 277.06,
   "end": 279.98,
   "text": "یکی هم اومد گفت آقا من فرزند پسر می‌خوام، ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.98,
   "end": 282.8,
   "text": "حضرت همه‌شونو توصیه به استغفار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.8,
   "end": 286.54,
   "text": "زیاد استغفار کنید. این‌ها که رفتن یا هر سه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.54,
   "end": 290.98,
   "text": "این‌هایی که دور و بر حضرت بودند تعجب کردند آقا این‌ها مشکلاتشون مختلف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.98,
   "end": 293.96,
   "text": "شما همه رو با یک دارو تجویز کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.96,
   "end": 299.32,
   "text": "اشاره کرد به همین آیات. خدا تو همین آیات فرموده شما استغفار کنید بارون میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.32,
   "end": 301.75,
   "text": "بهشت جنات تجری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 301.75,
   "end": 305.32,
   "text": "اینا جنات، اون انهار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.32,
   "end": 307.4,
   "text": "یمددکم بأموال، بنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.4,
   "end": 311.5,
   "text": "اینا همه رو آیه قرآن داره میگه. من از قرآن دارم به شما میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.5,
   "end": 314.88,
   "text": "شما از استغفار غافلین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 314.88,
   "end": 323.12,
   "text": "باز در آیه هفده آل عمران المستغفرین بالاسحار نشون میده بهترین وقت استغفار سحره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.12,
   "end": 326.8,
   "text": "یا آیه هجده ذاریات و بالاسحار هم یستغفرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.8,
   "end": 333.04,
   "text": "این‌ها سحرها اهل استغفارند که در نور الثقلین تفسیر روایی بسیار عالیه این تفسیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.04,
   "end": 335.3,
   "text": "جلد پنج، صفحه صد و بیست و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.3,
   "end": 341.7,
   "text": "امام صادق صلوات الله علیه فرمود هر کس وقت سحر هفتاد بار استغفار کنه مشمول همین آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.7,
   "end": 346.0,
   "text": "هفتاد بار. اونایی که نماز وترشونو با هفتاد تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.0,
   "end": 351.66,
   "text": "استغفار می‌خونن دیگه مشمول این آیه می‌شن و بالاسحار هم یستغفرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.66,
   "end": 355.74,
   "text": "یه نمازی هم داریم اصلاً مخصوصاً اسمش نماز استغفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.74,
   "end": 359.96,
   "text": "نماز عفو داریم، نماز توبه داریم، نماز استغفار داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.96,
   "end": 362.26,
   "text": "نماز توبه که عجیب برکاتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.26,
   "end": 365.0,
   "text": "همون نماز یکشنبه‌های سوره ز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.0,
   "end": 370.05,
   "text": "ماه ذی القعده که پیغمبر عظیم الشأن اسلام فرمود من معراج که رفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.05,
   "end": 376.27,
   "text": "اونجا این رو هدیه گرفتم، هبه گرفتم و هر وقتم بخونید همون خاصیت رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 376.27,
   "end": 379.57,
   "text": "ن-ن-ne که فقط یکشنبه ماه ذی القعده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.57,
   "end": 384.21,
   "text": "دیگه تو مفاتیح می‌دونید آثار و برکات عجیبی مترتب بر اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 384.21,
   "end": 387.89,
   "text": "بارش رحمت و برکات الهی این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.89,
   "end": 390.25,
   "text": "می‌رید رجوع می‌کنید اما نماز خب اونو می‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.25,
   "end": 393.57,
   "text": "نماز استغفار و عفو خیلی شاید براتون بیان نشده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 393.57,
   "end": 396.27,
   "text": "شبیه نماز جعفر طیاره البته دو رکعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 396.27,
   "end": 400.63,
   "text": "نماز جعفر طیار چهار رکعته، این دو رکعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.63,
   "end": 403.61,
   "text": "نماز استغفار دو رکعته، نماز عفو هم دو رکعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 403.61,
   "end": 413.55,
   "text": "چگونه؟ حمد یک مر-- مثل نماز صبح اما حمدو که خوندید بعد از حمد قدر رو می‌خونید انزلنا بعد ده بار اگه نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.55,
   "end": 417.93,
   "text": "عفو می‌خونی ده بار میگی پونزده بار، پونزده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 417.93,
   "end": 420.75,
   "text": "بار میگی ربه عفوک عفوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 420.75,
   "end": 424.21,
   "text": "پونزده بار. بعد میری رکوع ده بار میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.21,
   "end": 430.63,
   "text": "بعد از surه قدر پونزده بار رفتی رکوع ده بار، پا شدی ده بار، رفتی سجده ده بار، پا شدی ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 430.63,
   "end": 433.01,
   "text": "بار، سجده ده بار، پا شدی ده بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 433.01,
   "end": 436.09,
   "text": "مثل نماز جعفر طیار تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 436.09,
   "end": 443.17,
   "text": "اما اگر استغفار بود بعد از قدر پونزده بار میگی استغفرالله استغفرالله استغفرالله به همین راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.17,
   "end": 446.75,
   "text": "تو رکوع ده بار بلند شدی ده بار همینطور تا آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.75,
   "end": 450.29,
   "text": "آثار و برکات عجیبی رو بر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 450.29,
   "end": 456.49,
   "text": "نمازها ذکر کردن که حالا من از بیان آثار و برکاتش صرف نظر می‌کنم چون وقت گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 456.49,
   "end": 462.33,
   "text": "یه هدیه دیگه هم تقدیم کنم حالا که تا اینجا اومدیم، اومدیم جلو تا اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.33,
   "end": 466.03,
   "text": "این چیزی که الان تقدیم می‌کنم خدمتتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.03,
   "end": 470.33,
   "text": "خب عرض کردم یکی از اساتیدی که ما محضرشون می‌رسیدیم اصفهان حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.33,
   "end": 477.03,
   "text": "شیخ عبدالقائم شوشتری بود که ایشون شاگرد به فصل آقای حافظیان و ایشون هم شاگرد به فصل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 477.03,
   "end": 479.33,
   "text": "فصل آقای نخودکی اصفهانی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 479.33,
   "end": 484.27,
   "text": "یعنی هرچه آقای نخودکی داشت رسیده بود با واسطه به آقای شوشتری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 484.27,
   "end": 487.85,
   "text": "ایشون یه هدیه‌ای دارن که من اینو تقدیم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 487.85,
   "end": 496.79,
   "text": "البته سند داره هم در از صحيفة العلوية الجامعة صفحه صد و شصت و چهار هست هم مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.79,
   "end": 499.39,
   "text": "کفعمی علیه الرحمه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 499.39,
   "end": 501.69,
   "text": "بلد الامینش میاره. قصه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 501.69,
   "end": 508.97,
   "text": "روایته. این روایتو من سریع بگم خیلی کتابش هم آوردم خواستید از رو کسی بعد از نماز خواست ملاحظه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 508.97,
   "end": 514.21,
   "text": "یه نفر میاد حالا راوی امام حسین است صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.21,
   "end": 515.87,
   "text": "عده‌ای دور امیرالمؤمنین نشستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 515.87,
   "end": 518.63,
   "text": "یه نفر میاد میناله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 518.63,
   "end": 521.19,
   "text": "م-یه حالا عرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 521.19,
   "end": 523.41,
   "text": "بادیه نشین اعرابی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.41,
   "end": 527.45,
   "text": "محضر مولا میگه که آقا من مرد ایال‌مند و فقیری‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.45,
   "end": 530.85,
   "text": "مالی که زندگیم رو کفایت کنه ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.85,
   "end": 534.87,
   "text": "حضرت می‌فرماید چرا استغفار نمی‌کنی حالت نی-نیکو بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 534.87,
   "end": 538.37,
   "text": "ایشون میگه آقا من استغفار خیلی می‌کنم اما فایده‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.37,
   "end": 541.63,
   "text": "حالا اینا قابل توجه اونایی که میگن آقا ما اینا رو میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.63,
   "end": 543.27,
   "text": "مثلا استغفار می‌کنیم زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.27,
   "end": 547.39,
   "text": "به بعضیا ما میگیم این دقیقا همونه ولی فایده‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.39,
   "end": 554.35,
   "text": "حضرت می‌فرماید ای برادر عرب این آیه ده سوره نوح رو که الان براتون خوندم و قرائت می‌کنه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 554.35,
   "end": 562.27,
   "text": "و می‌فرماید که شما چون به گناه بودن بعضی از اعمالت آگاه نیستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.27,
   "end": 564.53,
   "text": "استغفار تو ناقص است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 564.53,
   "end": 567.47,
   "text": "نمی‌دونی این استغفار به چه گناهی از تو می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 567.47,
   "end": 571.77,
   "text": "اینم خیلی نکته‌ست. خیلی گناه هم می‌کنیم نمی‌دونیم این گناهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 571.77,
   "end": 581.23,
   "text": "لذا حضرت می‌فرماید اینک به تو استغفاری می‌آموزم که اگر آن را هنگام خواب بخوانی، خدا به تو وسعت رزق عطا فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 581.23,
   "end": 583.51,
   "text": "دعا رو می‌نویسه به اعرابی می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 583.51,
   "end": 585.79,
   "text": "ایشون میره قبل از خواب انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 585.79,
   "end": 590.91,
   "text": "سال که تموم می‌شه میاد اینجا امام حسین صلوات الله علیه می‌فرماید همون مرد برگشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 590.91,
   "end": 596.39,
   "text": "به امیرالمؤمنین عرض کرد که آقا انقدر نعمت‌ها زیاد شده، شتران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 596.39,
   "end": 599.13,
   "text": "گوسفندا اینا من نمی‌دونم اینا رو کجا جا بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 599.13,
   "end": 604.07,
   "text": "انقدر بر من زیاد شده. بعد مولا قربونش بریم می‌فرماید که قسم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 604.07,
   "end": 606.97,
   "text": "نبوت پیغمبر می‌خورم که فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 606.97,
   "end": 613.47,
   "text": "بنده‌ای نیست-- امیرالمؤمنین می‌فرماید بنده‌ای نیست که با این دعا به درگاه خدا استغفار کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 613.47,
   "end": 619.95,
   "text": "مگر اینکه خدای منان به برکت آن گناهانش را آمرزیده، حوائجش را برآورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 619.95,
   "end": 624.65,
   "text": "و به مال و اولادش فراوانی و برکت عطا فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 624.65,
   "end": 633.23,
   "text": "هفتاد بنده. طولانی‌ترین استغفاری که من تو روایات دیدم کلاً تو کتاب‌های ادعیه همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 633.23,
   "end": 637.03,
   "text": "خب آقای شوشتری می‌گفت نمی‌رسید هفتاد بندشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 637.03,
   "end": 641.83,
   "text": "خب تقسیم کنید شبی ده بندشو بخونید هفت شب هفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 641.83,
   "end": 644.47,
   "text": "ایشون فرمودن، از خودم نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 644.47,
   "end": 654.45,
   "text": "من خودم که اولین بار که اینو خوندم انقده حالم به هم ریخت، انقدر اشک مجرام رو گرفته بود تا آخرش نتونستم برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 654.45,
   "end": 658.33,
   "text": "اصلاً نمی‌دونید مت-- چه متن عجیبی داره این استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 658.33,
   "end": 661.05,
   "text": "توصیه می‌کنم اینم یه توصیه هدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 661.05,
   "end": 665.09,
   "text": "ما این چند روز هدیه‌های خیلی یعنی خیلی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 665.09,
   "end": 671.55,
   "text": "توبره رو باز کردیم و هدایای اساتید بزرگوارو نمی‌دونم چه می‌شده این چند روز همینجوری داریم خرج می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 671.55,
   "end": 674.03,
   "text": "انشاالله ، انشاالله شما قدر بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 674.03,
   "end": 679.83,
   "text": "من تو هیئت سی ساله خودم خدا رو شاهد می‌دونم که اونا هم بعد این میره تو کانال اونا هم می‌شنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 679.83,
   "end": 682.57,
   "text": "اینطوری بذرفشانی از اساتیدمون نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 682.57,
   "end": 686.03,
   "text": "من نه سر شما نمی‌ذاریم و چه، چه خبره نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 686.03,
   "end": 688.55,
   "text": "اصلاً هم دیدید من اصلاً اهل این حرفا نبودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 688.55,
   "end": 691.01,
   "text": "ذکر و وردو اصلاً مطلقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 691.01,
   "end": 696.59,
   "text": "بحث ما یهو برخورد کرد به اجنده و بعد بچه‌ها ریختن همکارا آقا مشکل ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 696.59,
   "end": 700.29,
   "text": "یه عمره این مشکلاتو داریم از ریش سفید و جوونتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 700.29,
   "end": 706.01,
   "text": "یه ذره شاخک‌های ما هم تیز شده گفتیم بذارید چند تا هدیه تقدیم کنیم بدونید راه بیرون رفت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 706.01,
   "end": 710.99,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 710.99,
   "end": 719.1,
   "text": "اللهم صل علی محمد و آل محمد. اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}