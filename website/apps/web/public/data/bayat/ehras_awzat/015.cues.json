 "chapters": [
  {
   "index": 0,
   "title": "## آغاز جلسه و سلام بر امام زمان",
   "start": 1.74,
   "end": 21.78
  },
  {
   "index": 1,
   "title": "## چشم‌زدن و دستور امام صادق علیه‌السلام",
   "start": 21.78,
   "end": 144.98
  },
  {
   "index": 2,
   "title": "## یادگاری از آیت‌الله بهجت در حرم امام رضا",
   "start": 144.98,
   "end": 169.74
  },
  {
   "index": 3,
   "title": "## داستان مردی در قم و ثمر نماز هدایت فرزند",
   "start": 169.74,
   "end": 267.99
  },
  {
   "index": 4,
   "title": "## کیفیت نماز چهاررکعتی هدایت فرزند",
   "start": 267.99,
   "end": 391.68
  },
  {
   "index": 5,
   "title": "و در رکعت چهارم، پس از حمد، ده بار آیهٔ پانزده سورهٔ احقاف را تکرار می‌کنید؛ از «ربّ أوزعنی» تا انتها:",
   "start": 391.68,
   "end": 431.24
  },
  {
   "index": 6,
   "title": "## نماز جعفر طیّار و گره‌های کور",
   "start": 431.24,
   "end": 527.94
  },
  {
   "index": 7,
   "title": "## دعای حافظه و حکایت درس آقای سراج",
   "start": 527.94,
   "end": 663.72
  },
  {
   "index": 8,
   "title": "## چهارده بار آیهٔ نور هدیه به امام حسن",
   "start": 663.72,
   "end": 775.56
  },
  {
   "index": 9,
   "title": "## یا مقیل العثرات پیش از نماز",
   "start": 775.56,
   "end": 801.74
  },
  {
   "index": 10,
   "title": "پیش از نمازهایتان. اگر دقت کرده باشید من همیشه می‌گویم؛ برکت خاصی دارد. آقای فاطمی‌نیا فرمود پیش از نمازهایتان بگویید:",
   "start": 801.74,
   "end": 851.3
  },
  {
   "index": 11,
   "title": "سپس برکاتش را بنگرید.",
   "start": 851.3,
   "end": 886.62
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.74,
   "end": 9.4,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.4,
   "end": 15.52,
   "text": "و عجل فرجهم. بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.52,
   "end": 19.62,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.62,
   "end": 24.62,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.62,
   "end": 32.68,
   "text": "یه دوستی از عزیزان سؤال داشت که حالا ما رو ول نمی‌کنن که دیگه دوستان ما ورود کردیم به این قصه و ادعیه و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 32.68,
   "end": 37.4,
   "text": "هرچی می‌خوایم فرار کنیم دیگه میگن آتیش زدن به مالم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 37.4,
   "end": 44.3,
   "text": "هی عزیزان سؤال می‌پرسن ما مجبور می‌شیم جواب بدیم هی کش پیدا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 44.3,
   "end": 48.84,
   "text": "گفتن خب حالا ما خودمون اگر در معرض چشم زدن قرار گرفتیم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 48.84,
   "end": 51.5,
   "text": "نه چشم خوردن ها، چشم زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 51.5,
   "end": 55.94,
   "text": "ما احساس کردیم الان مثلاً بچه‌مونو چشم می‌زنن، تو چشم ما افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 55.94,
   "end": 59.78,
   "text": "شیرین زبونی کرد. دستوری هست اونجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 59.78,
   "end": 66.88,
   "text": "بله. در مصباح کف امی صفحه دویست و بیست از امام صادق صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 66.88,
   "end": 69.86,
   "text": "روایت شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 69.86,
   "end": 74.48,
   "text": "چه کسی بترسه از چشم خوردن، چه چشم زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 74.48,
   "end": 77.3,
   "text": "هر دو موردش این کاربرد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.3,
   "end": 81.16,
   "text": "فرمودن سه مرتبه همون آن بگه ما شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.16,
   "end": 84.46,
   "text": "لا قوة الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.46,
   "end": 87.34,
   "text": "اینجا العلی العظیم هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.34,
   "end": 92.82,
   "text": "یا اینکه دستشو بیاره بالا و به کف دستش اینو بگه سه بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.82,
   "end": 95.92,
   "text": "ما شاء الله لا قوة الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.92,
   "end": 99.06,
   "text": "این که کف دستشو بیاره بالا دیگه العلی العظیم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.06,
   "end": 105.62,
   "text": "حالا چه اسراری در این‌ها هست و امام صادق که فرمودن می‌دونن ماها بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.62,
   "end": 109.18,
   "text": "یه عزیز دیگه‌ای هم خیلی اصرار داشت در خصوص هدایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 109.18,
   "end": 117.4,
   "text": "فرزند هم آیا دستور العملی هست که کمک حال باشه در حین حالا کارهای تربیت که ما می‌کنیم آیا دستوری هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 117.4,
   "end": 120.9,
   "text": "بله. یکیش دعای بیست و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.9,
   "end": 124.28,
   "text": "صحیفه است که خیلی دعای عظیم الشأنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.28,
   "end": 127.86,
   "text": "اصلاً عنوان دعا، دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.86,
   "end": 130.3,
   "text": "پدر و مادر در حق فرزنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.3,
   "end": 139.04,
   "text": "همونطور که آ اون دعای قبلیش بیست و چهار صحیفه دعای فرزندان برای پدر و مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 139.04,
   "end": 143.3,
   "text": "دعای بیست و پنج، دعای پدر و مادر برای فرزنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 143.3,
   "end": 149.23,
   "text": "خیلی دعای شیرینیه. در کنار اون هم یه هدیه‌ای تقدیم کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 149.23,
   "end": 154.64,
   "text": "که یه بارم یادمه توی یه بحث دیگه‌ای دوستان پرسیدن، اونجا هم گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 154.64,
   "end": 158.24,
   "text": "یه روز ما محضر آقا امام رئوف بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 158.24,
   "end": 164.48,
   "text": "ان‌شاءالله سال نو هم داره میاد توفیق شه همه مشرف شیم زیارت این عزیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 164.48,
   "end": 167.72,
   "text": "و تو رو به روی ضریح نشسته بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 167.72,
   "end": 169.3,
   "text": "و حال خوشی هم دست داده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 169.3,
   "end": 172.9,
   "text": "دیدم پسر آقای بهجت کنار دست ما هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 172.9,
   "end": 177.26,
   "text": "سلام علیک کردیم و اینا گفتیم ما خیلی پدر شما رو اذیت کردیم اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 177.26,
   "end": 182.94,
   "text": "گفت‌وگو کردیم. گفتم یه یادگاری حالا که ما اینجا هم گرد آمدیم یه یادگاری از پدرتون برای ما بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.94,
   "end": 186.28,
   "text": "ایشون تعملی کرد و همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 186.28,
   "end": 191.96,
   "text": "دعای هدایت فرزند رو که بهتره پدر بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 191.96,
   "end": 197.3,
   "text": "در کتاب بهجت و دعا اومده خود سفارش آقای بهجته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 197.3,
   "end": 199.2,
   "text": "کتاب مکارم الاخلاق هم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 199.2,
   "end": 202.0,
   "text": "حدیث امام صادقه صلی الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 202.0,
   "end": 206.82,
   "text": "ایشون به من گفتش که پسر آقای بهجت فرمودن یه آقایی بود تو قم زندگی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 206.82,
   "end": 210.38,
   "text": "این چند تا بچه داشت، دختر و پسر زیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 210.38,
   "end": 212.8,
   "text": "و همه‌شون خیلی خوب بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 212.8,
   "end": 215.62,
   "text": "خیلی با ادب، تحصیل کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.62,
   "end": 218.58,
   "text": "اهل هدایت، این‌ها، اهل خیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 218.58,
   "end": 224.8,
   "text": "برای همه عجیب بود که همه‌ی بچه‌های این آقا خیلی خوبن، سر به راه و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 224.8,
   "end": 230.36,
   "text": "بعد از پدر ایشون سؤال کردیم که شما چجوری این همه رسیدی بچه‌ها رو اینقدر خوب تربیت کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 230.36,
   "end": 233.62,
   "text": "فرمود هرچی هست بابای شما کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 233.62,
   "end": 236.1,
   "text": "یعنی آقای بهجت. گفتیم چطور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.1,
   "end": 241.14,
   "text": "گفت رمزش تو اینه که من همون اوایل که بچه دار شده بودم محضر پدر شما رسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.14,
   "end": 245.22,
   "text": "دستور اول خواستم توصیه به نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.22,
   "end": 246.94,
   "text": "هدایت فرزند کردن به من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.94,
   "end": 255.82,
   "text": "که البته آقای بهجت می‌فرمودن که مادر هم می‌تونه این نماز رو بخونه برای شفای مریضی بچه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 255.82,
   "end": 261.48,
   "text": "دقت بفرمایید. یعنی برای شفای مریضی بچه می‌خوای مادر بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 261.48,
   "end": 264.22,
   "text": "برای هدایت فرزند می‌خوای پدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 264.22,
   "end": 266.74,
   "text": "بعد آقای بهجت فرموده بودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.74,
   "end": 270.92,
   "text": "می‌تونی چهار رکعت دو تا دو رکعتی به یک سلام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.92,
   "end": 278.54,
   "text": "هر دو رکعت به یک سلام. این چهار رکعت رو می‌تونی به جای چهار رکعت نماز شبت هم بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 278.54,
   "end": 285.26,
   "text": "بعد ایشون می‌گفت ما انجام دادیم مداومت بر این نماز در سحرها به جای نماز شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 285.26,
   "end": 288.3,
   "text": "شده ثمره‌ش این وضعیت بچه‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 288.3,
   "end": 294.38,
   "text": "دو تا دو رکعتی که بعد از من شماره آیات رو میگم رجوع کنید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 294.38,
   "end": 300.2,
   "text": "در هر رکعت بعد از حمد ده بار آیاتی رو باید تلاوت کنید، ده بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 300.2,
   "end": 316.38,
   "text": "در رکعت اول بعد از حمد آیه صد و بیست و هشت سوره بقره ربنا هبلنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 316.38,
   "end": 336.38,
   "text": "من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 341.78,
   "end": 346.46,
   "text": "ازواجنا وذریاتنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 346.46,
   "end": 352.26,
   "text": "همینطور تا آخر. آیه اش هم خواستید ببینید هفتاد و چهار سوره فرقانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 352.26,
   "end": 362.76,
   "text": "ده بار اینو تکرار. بعد دوباره پا میشی رکعت سوم یعنی دو رکعت دیگه شروع می‌کنی بعد از حمد در رکعت اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 362.76,
   "end": 367.25,
   "text": "همین آیه‌ی هفتاد و چهار سوره فرقان رو دوباره ده بار می‌خونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 367.25,
   "end": 375.04,
   "text": "\"ربنا هب لنا من ازواجنا و ذریاتنا قرة اعیان واجعلنا للمتقین اماما\" خیلی آیه شیرینیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 375.04,
   "end": 380.1,
   "text": "خیلی قشنگه. و در رکعت چهارم بعد از هم ده بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 380.1,
   "end": 383.76,
   "text": "سوره احقاف، آیه پونزده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 383.76,
   "end": 390.28,
   "text": "تکرار می‌کنی که \"رب اعوذ بعثی ان اشکر نعمتک التي انعمت علي\" حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 390.28,
   "end": 392.62,
   "text": "تا انتها. این رو ده بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 392.62,
   "end": 395.46,
   "text": "دوباره وقتی تموم شد رکعت چهارم یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 395.46,
   "end": 400.86,
   "text": "دو رکعت دوم هم سلام دادید دوباره اون آیه هفتاد و چهار فرقان رو ده بار میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 400.86,
   "end": 402.73,
   "text": "اتمام نماز. چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 402.73,
   "end": 406.38,
   "text": "\"ربنا هب لنا من ازواجنا و ذریاتنا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 406.38,
   "end": 413.76,
   "text": "حالا اگه کسی الان وقت نکرد بنویسه یا جا موند اینو از تو کانال میتونه صوتش هست دیگه پیاده کنید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 413.76,
   "end": 417.86,
   "text": "تو کتابش هم که مرجعش رو عرض کردم میتونید ببینید اونجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 417.86,
   "end": 423.1,
   "text": "خیلی که، خیلی نماز عجیبیه، خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 423.1,
   "end": 428.38,
   "text": "یه دعای دیگه‌ای هم هستش که آقای بهجت خیلی به این دعا سفارش می‌کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 428.38,
   "end": 434.76,
   "text": "که فرمودن مقدمه این دعا یه صلوات بفرستید آخرش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 434.76,
   "end": 439.04,
   "text": "یه صلوات. یعنی این دعا رو سه بار بخونید بین دو صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 439.04,
   "end": 442.94,
   "text": "این دعا معروفه به درع کل حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 442.94,
   "end": 445.38,
   "text": "فرمودن که اگر صبح و شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 445.38,
   "end": 448.74,
   "text": "این رو بخونید از هر بلایی محفوظید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 448.74,
   "end": 451.0,
   "text": "در امان الهی هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 451.0,
   "end": 464.02,
   "text": "صبح و شب آ این صلوات رو می‌فرستی بعد این دعاش \"اللهم اجعلنی فی درعک الحسینه التي تجعل فیها من تريد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 464.02,
   "end": 467.18,
   "text": "به همین کوتاهی سه بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 467.18,
   "end": 471.82,
   "text": "و یه بار ما محضر عزیز بودیم آقای بهجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 471.82,
   "end": 476.28,
   "text": "خیلیا این سفا میومدن بالاخره مشکلاتشون رو می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 476.28,
   "end": 481.52,
   "text": "دیدم که آقای بهجت مشکلات پیچیده رو اینو ما چندین بار دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 481.52,
   "end": 483.46,
   "text": "مشکلات خیلی پیچیده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 483.46,
   "end": 489.76,
   "text": "اصلاً ایشون صراحتاً می‌فرمود مشکلات پیچیده و سخت و دشوار، گره‌های کور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 489.76,
   "end": 491.94,
   "text": "اینا رو نماز جعفر طیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 491.94,
   "end": 494.78,
   "text": "گره‌شو باز می‌کنه. ایشون فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 494.78,
   "end": 496.49,
   "text": "مخصوصاً برای ازدواج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 496.49,
   "end": 499.46,
   "text": "ایشون تأکید می‌کردن به نماز جعفر طیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 499.46,
   "end": 503.06,
   "text": "اگر کسی بتونه هدیه کنه به امام هست که دیگه نور on نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 503.06,
   "end": 506.96,
   "text": "حالا هر چقدر می‌تونه. می‌تونه هر روز بخونه نور on نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 506.96,
   "end": 510.0,
   "text": "نه هفته‌ای یه بار. دیگه دیره دیرش ماهی یه بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 510.0,
   "end": 513.08,
   "text": "که البته روایت داریم وسعت رزق هم میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 513.08,
   "end": 519.64,
   "text": "می‌دونید نماز جعفر طیار رو امام رضا به جای چهار رکعت نماز شبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 519.64,
   "end": 526.02,
   "text": "چهار رکعت اولش نماز جعفر طیار می‌خونده چون چهار رکعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 526.02,
   "end": 533.14,
   "text": "و عرض شود خدمتتون یه دو سه تا دیگه هدیه تقدیم کنم که اینام خیلی شیرینن به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 533.14,
   "end": 537.86,
   "text": "دعای حافظه. میان بعضی دوستان می‌پرسن که چیکار کنیم مثلاً حافظمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 537.86,
   "end": 541.36,
   "text": "خدا رحمت کنه آقای سراج رو ما محضرشون که می‌رفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 541.36,
   "end": 545.9,
   "text": "پای منبرشون این استاد بزرگوار رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 545.9,
   "end": 550.82,
   "text": "جالب بود که خب زیاد بودم در کلاس درس ایشون من می‌شستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 550.82,
   "end": 554.22,
   "text": "اول البته می‌نوشتم، بی‌تفاوت نبودم، می‌نوشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 554.22,
   "end": 557.84,
   "text": "بعد هر جلسه که می‌اومدیم می‌پرسید ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 557.84,
   "end": 560.82,
   "text": "می‌پرسید آقا شما ببین جلسه پیش من چی گفتم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 560.82,
   "end": 564.02,
   "text": "شما بگو. یه روز هیچکس نتونست بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 564.02,
   "end": 568.66,
   "text": "به من گفت شما بگو. از سیر تا پیاز اونچه که آقای سراج گفته بود رو گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 568.66,
   "end": 577.1,
   "text": "انقدر ایشون لذت برد گفت از-- می‌خواستم کلاسو تعطیل کنم از ناراحتی اما به خاطر ایشون من این کلاسو ادامه میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 577.1,
   "end": 580.6,
   "text": "شما همیشه باش خلاصه درس پیشو اول بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 580.6,
   "end": 582.88,
   "text": "من اینو به شما بگم برکتش رو از چی داشتم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 582.88,
   "end": 586.2,
   "text": "همین دعای حافظه. در تعقیبات مشترک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 586.2,
   "end": 589.52,
   "text": "مفاتیح هست. آخه خب واسه آورده نترسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 589.52,
   "end": 591.72,
   "text": "بگید اخ، اخ، اخ کجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 591.72,
   "end": 595.62,
   "text": "این دعا رو پیغمبر به امیرالمؤمنین تعلیم داد بعد از هر نمازت بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 595.62,
   "end": 602.33,
   "text": "مولا فرمود من نشد که این دعا رو که خوندم هر چیزی رو یه بار فقط بخونم دیگه تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 602.33,
   "end": 605.68,
   "text": "نشد که از یادم بره. یه بار می‌خوندم دیگه از ذهنم نمی‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 605.68,
   "end": 611.18,
   "text": "همون دعای معروف \"سبحان من لا يعتدي على اهل مملكته\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 611.18,
   "end": 613.78,
   "text": "اینم از این. در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 613.78,
   "end": 618.68,
   "text": "آیه نور. اینم قبلاً اون ماهی که ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 618.68,
   "end": 625.46,
   "text": "قمری که اول ماه جمعه شده بود بهتون گفتم از بزرگانمون این رو ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 625.46,
   "end": 632.24,
   "text": "ماه قمری که اولش جمعه باشه اون ماه سراسر به نور مهدی فاطمه صلوات الله علیهما روشنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 632.24,
   "end": 640.66,
   "text": "و اگر کسی می‌خواد به نور مهدی فاطمه منور بشه، اون ماه که سرتاسرش به نور آقاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 640.66,
   "end": 643.84,
   "text": "دویست و پنجاه و شش به عدد ابجد نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 643.84,
   "end": 646.2,
   "text": "دویست و پنجاه و شش بار آیه نور رو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 646.2,
   "end": 648.98,
   "text": "آیه سی و پنج سوره نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 648.98,
   "end": 653.5,
   "text": "و حالا یه همچین ماهی رو ما ندیدیم یا حواسمون نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 653.5,
   "end": 656.44,
   "text": "یکی از اساتید ما، من خودم این کارو کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 656.44,
   "end": 658.34,
   "text": "نمی‌دونید چه برکاتی ازش دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 658.34,
   "end": 663.72,
   "text": "به هرکی هم گفتم اومد گفت حاج آقا دستت درد نکنه اصلاً زندگی ما نور on نور شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 663.72,
   "end": 666.92,
   "text": "هر شب قبل خواب چهارده بار سوره یا آیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 666.92,
   "end": 672.2,
   "text": "آیه نور رو که آیه سی و پنج سوره نوره چهارده بار بخونی هدیه کنی به امام حسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 672.2,
   "end": 675.86,
   "text": "اصلاً عجیبه. خیلی تاثیرات عجیبی درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 675.86,
   "end": 678.88,
   "text": "اگه کسی جی-- حالشو داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 678.88,
   "end": 680.98,
   "text": "و خیلی دوست داشت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 680.98,
   "end": 688.44,
   "text": "یه هدیه اساسی انشاالله شب عید بریم ما هم دعا کنید به امام رضا بده بعد آقا تحویلش بگیره حسابی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 688.44,
   "end": 693.0,
   "text": "در حرم امام رضا چهارصد بار در یک مجلس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 693.0,
   "end": 696.26,
   "text": "چهارصد بار آیه نور رو بخونه هدیه کنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 696.26,
   "end": 701.62,
   "text": "امام رضا. من یه بار یه روز که انجام دادم حدود چهار ساعت طول کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 701.62,
   "end": 706.94,
   "text": "خب ولی اگر دیدید نمی‌تونید خسته نکن خودتو مثلاً هر بار میری زیارت چند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 706.94,
   "end": 711.58,
   "text": "تاشو بخون تا در نهایت مثلاً اون چند روزی که محضر آقا هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 711.58,
   "end": 715.9,
   "text": "چهارصد بار تموم بشه. اما بهتره توی یه مجلس باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 715.9,
   "end": 719.66,
   "text": "دیگه حوصله تون هم سر رفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 719.66,
   "end": 722.98,
   "text": "حیفه بذارید اینم بگم. هی مرزه مرزه می‌کنم بگم یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 722.98,
   "end": 725.44,
   "text": "محضر آقای شوشتری بودیم یه روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 725.44,
   "end": 729.28,
   "text": "شاگرد آقای حافظیان که شاگرد بلا فصل آقای نخودکی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 729.28,
   "end": 731.86,
   "text": "ازشون ذکر اعظم خواستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 731.86,
   "end": 735.76,
   "text": "من خودم خیلی باز برک-برکات عجیبی از این ذکر دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 735.76,
   "end": 739.6,
   "text": "دیگه میگن آتیش زدیم به مالمون دیگه تمومش کنیم بره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 739.6,
   "end": 741.66,
   "text": "ایشون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 741.66,
   "end": 743.52,
   "text": "برای هر کاری که میخوای کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 743.52,
   "end": 750.8,
   "text": "سنگین، من همیشه قبل منبرم سه بار میگم کار سنگینی میخوای بکنی سه بار بگو المستغاث بکَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 750.8,
   "end": 753.52,
   "text": "یا صاحب الزمان. همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 753.52,
   "end": 762.02,
   "text": "که آقای ناصری یه روز محضرشون بودیم ایشون به این شکل فرمودن این ذکر اعظمه آقای ناصری روحش شاد، آیت‌الله ناصری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 762.02,
   "end": 771.88,
   "text": "می‌رفتیم محضرشون کلاس‌های اخلاقشون اصفهان که بودیم فرمود بگید یا صاحب الزمان اغثنی یا صاحب الزمان ادرکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 771.88,
   "end": 775.44,
   "text": "از این دو تا ذکر من خودم به شخصه خیلی برکات دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 775.44,
   "end": 777.82,
   "text": "یه یادگاری هم از آقای فاطمی‌نیا بهتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 777.82,
   "end": 781.42,
   "text": "آقای فاطمی‌نیا محضرشون که می‌رفتیم یه روز دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 781.42,
   "end": 786.0,
   "text": "شما یادتونه خیلی به سر و سری می‌گفت عمل می‌کنی یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 786.0,
   "end": 790.14,
   "text": "من نمی‌دونم بگم یا نه اینطوری داغت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 790.14,
   "end": 795.66,
   "text": "قبل از نمازاتون فرمود اگه دقت کرده باشید من همیشه میگم برکت خاصی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 795.66,
   "end": 801.74,
   "text": "فرمود آقای فاطمی‌نیا فرمود قبل از نمازاتون بگید یا مقیل الآثرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 801.74,
   "end": 804.82,
   "text": "یعنی ای برطرف کننده زشتی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 804.82,
   "end": 808.8,
   "text": "یه بار آقای فاطمی‌نیا فرمود یک بار سختم نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 808.8,
   "end": 812.38,
   "text": "و آخرین هدیه رو هم از یکی از اساتید بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 812.38,
   "end": 820.96,
   "text": "وزین و با عظمتمون که غول عرفان و فلسفه است ایشون و بهترین شاگرد علامه و عظمت‌های بهجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 820.96,
   "end": 824.18,
   "text": "ما خیلی ازشون بهره بردیم اینم خدمت شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 824.18,
   "end": 833.1,
   "text": "فرمودن که امام رو در هر مقامی سلام بدی آقا همون لحظه در اون مقام به تو توجه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 833.1,
   "end": 837.4,
   "text": "مثلاً شما بخوای بری در نماز دیدید من خودم همین کار رو انجام میدم همیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 837.4,
   "end": 841.96,
   "text": "می‌خوای نماز بخونی آقا تو امام زمان رو در نماز مص--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 841.96,
   "end": 844.42,
   "text": "در مقام مصلی سلام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 844.42,
   "end": 847.8,
   "text": "در زیارت آل یاسین هست. السلام علیک حین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 847.8,
   "end": 851.3,
   "text": "تسلی و تقنوت. بعد برکاتشو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 851.3,
   "end": 855.1,
   "text": "یا منبری‌ها میخوان منبر برن پرورش آیات بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 855.1,
   "end": 858.18,
   "text": "بیان حقایق و دعوت الی الله بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 858.18,
   "end": 863.5,
   "text": "بگن قبل از شروع بگن السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 863.5,
   "end": 865.4,
   "text": "الآیات همون که همیشه ما میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 865.4,
   "end": 867.48,
   "text": "اینم یه هدیه از طرف ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 867.48,
   "end": 873.26,
   "text": "دیگه حالا زیاده. منتها اینا نمی‌دونم چی شده هی سرریز داره می‌شه بعد از سی سال ما هی داریم میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 873.26,
   "end": 875.58,
   "text": "سوالات و اصرار بعضی دوستام باعث شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 875.58,
   "end": 878.16,
   "text": "امیدوارم بتونیم این سفره رو جمع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 878.16,
   "end": 881.7,
   "text": "صلوات بفرستید. اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 881.7,
   "end": 886.62,
   "text": "علی محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}