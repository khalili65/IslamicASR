 ],
 "cues": [
  {
   "i": 0,
   "start": 1.88,
   "end": 9.32,
   "text": "یا رب اعوذبک من همزات الشیاطین و من شر نفسي و من شر خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.32,
   "end": 16.24,
   "text": "بسم الله الرحمن الرحیم لا حول و لا قوة الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 16.24,
   "end": 21.32,
   "text": "اللهم ایاک نعبد و ایاک نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 21.32,
   "end": 28.28,
   "text": "الحمد لله على کل نعمه و اسال الله من فضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 28.28,
   "end": 33.04,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 33.04,
   "end": 39.28,
   "text": "ایاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 39.28,
   "end": 42.88,
   "text": "در محضر پنج شهید خوشنام هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 42.88,
   "end": 46.88,
   "text": "ان شاء الله که روح بلند این شهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 46.88,
   "end": 51.02,
   "text": "همه ما رو دعا کنن و ما رو بلند کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 51.02,
   "end": 53.76,
   "text": "از زمین به آسمون برسونند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.76,
   "end": 56.64,
   "text": "ارتباط و اتصال بین ما و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.64,
   "end": 61.84,
   "text": "عالم بالا رو این‌ها واسطه بشن و برقرار کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.84,
   "end": 68.34,
   "text": "ضمن تبریک این ایام بسیار پرنور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.34,
   "end": 71.26,
   "text": "چه ایام گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.26,
   "end": 76.78,
   "text": "عید ماه رجب و چه ایام شعبانیه پیش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.78,
   "end": 84.08,
   "text": "امیدوارم که امام عزیزمون، امام زمان عزیزتر از جانمون هر کجا تشریف دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 84.08,
   "end": 87.98,
   "text": "حالشون خوب باشه و از صaire همه ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.98,
   "end": 91.84,
   "text": "مورد عنایت و دعاهای خاص خودشون قرار بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.84,
   "end": 93.98,
   "text": "صلواتی هدیه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.98,
   "end": 97.38,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.38,
   "end": 103.7,
   "text": "و آل محمد و عجل فرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.7,
   "end": 107.1,
   "text": "ابتدا هدیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 107.1,
   "end": 110.38,
   "text": "هر جلسه‌مون رو تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.38,
   "end": 115.3,
   "text": "خب همه شما ان شاء الله میخواید بیفتید تو دور درس و بحث و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 115.3,
   "end": 119.06,
   "text": "مباحثه و فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 119.06,
   "end": 121.72,
   "text": "حقایق عرشی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.72,
   "end": 124.9,
   "text": "خوانش و فهم کتاب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.9,
   "end": 130.4,
   "text": "سنگین و صحف و کتب نوریه عرفانیه و حکمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.4,
   "end": 134.52,
   "text": "این می‌طلبه که کمک بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.52,
   "end": 140.76,
   "text": "یکی از بهترین کمک‌هایی که از عالم قدس می‌گیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.76,
   "end": 144.54,
   "text": "این هدیه‌ست که تقدیم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.54,
   "end": 148.62,
   "text": "بنده از همون جوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.62,
   "end": 153.06,
   "text": "خودم رو عادت دادم به این هدیه آسمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.06,
   "end": 156.08,
   "text": "آثار و برکاتش رو هم دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.08,
   "end": 162.54,
   "text": "شما هم ان شاء الله ببینید. سندش هم در مفاتیح الجنانه، جای دوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.54,
   "end": 165.58,
   "text": "خدا رحمت کنه از آقای بهجت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.58,
   "end": 169.74,
   "text": "به بنده اجازه دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.74,
   "end": 174.12,
   "text": "که آنچه که در مفاتیح هست رو انجام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 174.12,
   "end": 177.56,
   "text": "الان نگاه نکنید که هرکی به هرکسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 177.56,
   "end": 185.08,
   "text": "توصیه‌ای می‌کنه ماشاالله گاهی اوقات که ماشاالله هم نداره ما شاء الشيطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 185.08,
   "end": 192.32,
   "text": "تا دلت بخواد تو فضای مجازی پره آقا این ذکر رو بگو این اثرشه این کارو انجام بده یه ختمو این وردو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 192.32,
   "end": 199.06,
   "text": "در صورتی که اینا آداب داره اولین ادبش اذن یک بزرگیست یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 199.06,
   "end": 203.34,
   "text": "راه بلد و کار بلد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 203.34,
   "end": 208.72,
   "text": "یک استاد کلی‌ست یک کمالی‌ست که راه رو پیموده باشه به شما اجازه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.72,
   "end": 211.98,
   "text": "خیلی از از کار رو ما اصلاً حق نداریم بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 211.98,
   "end": 216.06,
   "text": "مثال بزنم؟ جسارت می‌کنم این مثال رو می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 216.06,
   "end": 219.04,
   "text": "ما وقتی میریم وارد بیت الخلاء می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 219.04,
   "end": 222.16,
   "text": "هر کاری اونجا مکروهه، هر حرفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 222.16,
   "end": 224.16,
   "text": "اونجا مکروهه جز ذکر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 224.16,
   "end": 228.86,
   "text": "عجب در مستراح هم ذکر خدا باید بله اونجا هم باید گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.86,
   "end": 236.32,
   "text": "خب حالا که باید گفت پس من مطلقاً هر ذکری بگم در اون محله که محل دفع خبیثاته بگم یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 236.32,
   "end": 244.48,
   "text": "کاشف یا بگم مثلا یا سميع بگم یا بصیر اجازه دارم این از کار رو اونجا استفاده کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 244.48,
   "end": 246.54,
   "text": "حق ندارم این بی‌ادبیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 246.54,
   "end": 251.26,
   "text": "این بی‌ادبیه. بگو تا برات گناه بنویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 251.26,
   "end": 253.94,
   "text": "چی باید گفت؟ اونچه که مولا فرمودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 253.94,
   "end": 257.5,
   "text": "فرمودن وارد میشی بگو يا ستّار العيوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 257.5,
   "end": 261.34,
   "text": "هر ذکری جایi داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 261.34,
   "end": 267.94,
   "text": "حالا اذیتتون نکنیم بحث ما عرفان عملی نیست فعلاً، فعلاً حرف بحثمون عرفان نظری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 267.94,
   "end": 275.4,
   "text": "رد شیم. این هدیه رو امیرالمؤمنین علیه الصلاة والسلام از پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 275.4,
   "end": 280.68,
   "text": "خاتم الانبیا محمد مصطفی صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 280.68,
   "end": 286.3,
   "text": "دریافت کردن. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 286.3,
   "end": 293.94,
   "text": "مولا فرمودن که از وقتی من این کار رو مداومت کردم دیگه هیچ چیزی فراموشم نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 293.94,
   "end": 298.2,
   "text": "حالا بنده چیزی که در خصوص خودم تجربه کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 298.2,
   "end": 300.2,
   "text": "چیزهای خوب فراموشم نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 300.2,
   "end": 306.1,
   "text": "مثلاً همین درس و بحث‌ها. ولی خب چیزای بد الحمد لله فراموشم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 306.1,
   "end": 310.68,
   "text": "خدا رحمت کنه استاد سراج رو که این خاطره‌ای که میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 310.68,
   "end": 315.7,
   "text": "شما باید اینطوری بشینید. این‌ها اظهار فضل نیست، تجربه بنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 315.7,
   "end": 318.32,
   "text": "جلسات خصوصی‌ای داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 318.32,
   "end": 320.58,
   "text": "ما خدمتشون میرسیدیم جلوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 320.58,
   "end": 326.88,
   "text": "منبر ایشون می‌نشستم من جلوی جلو مثل شما چجوری‌ین کاغذ قلم دستتون همینطور دو زانو می‌نشستم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 326.88,
   "end": 332.48,
   "text": "منتظر بودم که از لب مبارک ایشون چیزی خارج شه بنویسم، می‌نوشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 332.48,
   "end": 337.06,
   "text": "بعد می‌رفتم خونه برای خانواده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 337.06,
   "end": 340.78,
   "text": "برای رفیقام این‌ها می‌گفتم آثار و برکاتشو می‌دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 340.78,
   "end": 343.5,
   "text": "اولین جلسه‌ای که حضور پیدا کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 343.5,
   "end": 345.96,
   "text": "خب من سنم از همه کمتر بود تو جلسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 345.96,
   "end": 349.62,
   "text": "جلسه بعد یعنی جلسه دوم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 349.62,
   "end": 353.82,
   "text": "ایشون گفت جلسه قبل رو کی می‌تونه خلاصه بگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 353.82,
   "end": 357.94,
   "text": "همه ساکت بودن. خب منم تازه وارد بودم روم نمیشد که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 357.94,
   "end": 363.08,
   "text": "بلد بودم، حاضر جواب بودم، پررو بودم تو این مباحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 363.08,
   "end": 367.98,
   "text": "لا حیا على الدين. اگرچه الحیا اصل الدين اما لا حیا على الدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 367.98,
   "end": 372.06,
   "text": "اینا رو چجوری با هم جمع کنیم؟ حیا اصل و ریشه دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 372.06,
   "end": 373.7,
   "text": "بعد میگه در دین حیا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 373.7,
   "end": 380.34,
   "text": "یعنی چی؟ در کارهای بد، در گناه و معصیت حیا اصل دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 380.34,
   "end": 383.52,
   "text": "اما در عمل خیر حیا وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 383.52,
   "end": 388.32,
   "text": "برای چی خجالت می‌کشی؟ خجالت نداره سوالی رو بلد نیستی بپرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 388.32,
   "end": 391.6,
   "text": "خجالت نداره اذان بگی خجالت نداره بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 391.6,
   "end": 396.22,
   "text": "خب من اونجا نشسته بودم بعد هیچ‌کس جواب نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 396.22,
   "end": 399.72,
   "text": "حتی ایشون اسم برد از مثلا نابغه‌های جلسه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 399.72,
   "end": 402.16,
   "text": "آقا شما چی گفتم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 402.16,
   "end": 404.46,
   "text": "استاد شرمنده یادم رفت آقا شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 404.46,
   "end": 412.66,
   "text": "اصلا ایشون وا رفت. گفت خواهشا دیگه از جلسه بعد هیچ‌کس تشریف نیاره منم دیگه نمیام جلسه تعطیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 412.66,
   "end": 415.48,
   "text": "خیلی ریخت به همه‌شون. یک نفر هیچی نگفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 415.48,
   "end": 420.4,
   "text": "من دیدم اینطوری شد دیگه پررو شدم گفتم استاد میشه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 420.4,
   "end": 423.44,
   "text": "یه چیزی بگم؟ گفت شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 423.44,
   "end": 426.56,
   "text": "جلسه دومم بود، بچه هم بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 426.56,
   "end": 429.7,
   "text": "گفت بفرما گفت بفرما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 429.7,
   "end": 432.6,
   "text": "شروع کردم حدود بیست دقیقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 432.6,
   "end": 436.58,
   "text": "یک ساعت صحبت‌های ایشون رو گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 436.58,
   "end": 442.8,
   "text": "خدا رو شاهد می‌گیرم ایشون چنان هاج و واج گوش می‌داد بعد که تموم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 442.8,
   "end": 449.04,
   "text": "گفت از جلسه بعد به برکت این جوون من جلسه رو هستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 449.04,
   "end": 451.18,
   "text": "و هیچ‌کسم نیاد من ادامه میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 451.18,
   "end": 456.56,
   "text": "من اینطوری آدم می‌خوام. حالا اینو من به شما مثال زدم از خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 456.56,
   "end": 459.02,
   "text": "چرا راه دور بریم؟ این اظهار فضیلت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 459.02,
   "end": 461.52,
   "text": "این آثار و برکات اون عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 461.52,
   "end": 464.1,
   "text": "مثل جلسه پیش اون هدیه‌ای که می‌خواستم بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 464.1,
   "end": 468.32,
   "text": "کلی تهییج کردم، ترغیب کردم شما رو بعد گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 468.32,
   "end": 470.82,
   "text": "حالا می‌خوام در خدمت شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 470.82,
   "end": 473.12,
   "text": "شاید هم خیلی‌هاتون دارید انجامش میدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 473.12,
   "end": 481.52,
   "text": "نمی‌دونم. حتما این کار رو انجام بدید بعد از هر نماز واجب‌تون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 481.52,
   "end": 486.32,
   "text": "پیغمبر به امیرالمؤمنین توصیه کرد، ایشون هم به شیعیانشون که این دعا رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 486.32,
   "end": 492.5,
   "text": "سبحان من لا يعتدي على اهل مملكته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 492.5,
   "end": 499.48,
   "text": "سبحان من لا يأخذ أهل الأرض بألوان العذاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 499.48,
   "end": 503.2,
   "text": "سبحان الرؤوف الرحيم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 503.2,
   "end": 509.72,
   "text": "اللهم اجعل لي في قلبي نورا وبصرا وفهما وعلما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 509.72,
   "end": 512.2,
   "text": "إنك على كل شيء قدير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 512.2,
   "end": 518.38,
   "text": "حالا چهار تا جمله‌شم کلمه‌شم بنویسید جستجو کنید تو گی-- گوگل میاد بالا اصن می‌تونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 518.38,
   "end": 525.52,
   "text": "ببینید متن‌ش. اینو مداومت کنید بعد می‌بینید که چقدر برکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}