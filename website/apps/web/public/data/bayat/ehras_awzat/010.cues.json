   "start": 67.22,
   "end": 90.22
  },
  {
   "index": 2,
   "title": "## فیض دائم و ظرف وجودی",
   "start": 90.22,
   "end": 131.8
  },
  {
   "index": 3,
   "title": "طهارت موضوعی بسیار مهم است. روایت شیرین و زیبایی داریم:",
   "start": 131.8,
   "end": 152.76
  },
  {
   "index": 4,
   "title": "## طهارت ظاهر و باطن؛ وضو و غسل",
   "start": 152.76,
   "end": 194.06
  },
  {
   "index": 5,
   "title": "## جنابت؛ فاصله گرفتن از خدا",
   "start": 194.06,
   "end": 223.78
  },
  {
   "index": 6,
   "title": "## نجس و پاکی، خانه و لباس، و استیلای اجنّه",
   "start": 223.78,
   "end": 259.58
  },
  {
   "index": 7,
   "title": "## داستان حسینیه و فضلهٔ موش",
   "start": 259.58,
   "end": 321.86
  },
  {
   "index": 8,
   "title": "حضرت فرمود:",
   "start": 321.86,
   "end": 409.26
  },
  {
   "index": 9,
   "title": "یکی از آثار صلوات، که طهارت نفس است، در جامعهٔ کبیره آمده؛ در آن قسمت که به اهل‌بیت عرض می‌کنیم:",
   "start": 409.26,
   "end": 436.76
  },
  {
   "index": 10,
   "title": "## طیب خلقت؛ ناپاکی هنگام انعقاد نطفه",
   "start": 436.76,
   "end": 496.82
  },
  {
   "index": 11,
   "title": "## صلوات مطلقه؛ و شرط مأثور بودن",
   "start": 496.82,
   "end": 545.78
  },
  {
   "index": 12,
   "title": "## صلوات مخصوصهٔ حضرت زهرا سلام‌الله‌علیها",
   "start": 545.78,
   "end": 625.22
  },
  {
   "index": 13,
   "title": "بحار، جلد ۴۳، صفحهٔ ۵۸. چه قدر زیباست. پیامبر فرمود:",
   "start": 625.22,
   "end": 734.6
  },
  {
   "index": 14,
   "title": "## ختم جلسه",
   "start": 734.6,
   "end": 749.69
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.44,
   "end": 8.56,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.56,
   "end": 12.8,
   "text": "محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.8,
   "end": 17.56,
   "text": "فرجه. بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.56,
   "end": 22.66,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.66,
   "end": 26.08,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.08,
   "end": 31.8,
   "text": "در ادامه‌ی ادعیه و اذکار و عوضاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.8,
   "end": 34.6,
   "text": "مرتبط با بحث جن و ورود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.6,
   "end": 44.24,
   "text": "اون‌ها به زندگی ما بود که معمولاً دو تا آسیب جدی وارد می‌کنه، یکی به جسم انسان و روح و روان انسان، یکی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 44.24,
   "end": 50.88,
   "text": "رزق رو می‌بنده. یکی از مهم‌ترین این اذکار رو امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.88,
   "end": 53.8,
   "text": "عرض می‌کنم. برای عرض این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.8,
   "end": 57.74,
   "text": "ذکر بسیار مهم بلکه مهم‌ترین ذکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.74,
   "end": 60.98,
   "text": "یه مقدمه نیاز هست. اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.98,
   "end": 67.22,
   "text": "طهارت هست. طهارت که قرآن می‌فرماید \"لا یمسه إلا المتحرون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.22,
   "end": 73.84,
   "text": "جز با طهارت نمی‌شه مس کرد لایه‌های عوالم وجودی رو حتی خودت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.84,
   "end": 78.2,
   "text": "این طهارت هرچه بیشتر باشه رزق انسان بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 78.2,
   "end": 80.22,
   "text": "مدد الهی به انسان بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.22,
   "end": 83.54,
   "text": "اصلاً حکما و عرفا فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.54,
   "end": 89.18,
   "text": "فیض علی الدوام از طرف حضرت حق علی الاطلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.18,
   "end": 94.0,
   "text": "در حال ریزش است بر سر همه‌ی کائنات و خلائق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.0,
   "end": 98.92,
   "text": "ظرف وجودی انسان‌ها که چقدر باشه از اون فیض همون میزان برداشت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 98.92,
   "end": 104.08,
   "text": "ظرف وجودی هر کسی یعنی سعه وجودیش نسبت به طهارتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 104.08,
   "end": 108.38,
   "text": "یعنی این‌چنین می‌شه گفت که حتی اون فیضی که به سر پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.38,
   "end": 113.4,
   "text": "در حال ریزش بود و الان سر امام عصر ما، سر ما هم داره می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.4,
   "end": 116.94,
   "text": "منتها ما ظرفمون کوچیکه، کم برداشت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.94,
   "end": 119.18,
   "text": "این ظرف بر اساس چی تعریف می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 119.18,
   "end": 121.74,
   "text": "طهارت، طهارت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.74,
   "end": 125.68,
   "text": "طهارت موضوع بسیار مهمیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.68,
   "end": 131.8,
   "text": "اتفاقاً کسی که روایت داریم \"دوم على الطهاره\" چه روایت شیرین و قشنگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.8,
   "end": 133.84,
   "text": "مداومت کن بر طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 133.84,
   "end": 137.94,
   "text": "بعد چه اتفاقی می‌افته؟ \"یوسع عليك رزقك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.94,
   "end": 139.96,
   "text": "رزقت زیاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.96,
   "end": 143.2,
   "text": "کسی که طهارتش زیاده رزقش هم زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.2,
   "end": 150.26,
   "text": "امتحان کنید. چله طهارت نفس بگیرید ببینید چجوری خدا ریزش رحمتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.26,
   "end": 154.7,
   "text": "آغاز می‌شه. خب طهارت از ظاهر و باطن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.7,
   "end": 157.1,
   "text": "ظاهر با وضو و غسل و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.1,
   "end": 159.88,
   "text": "این‌که انسان دائم الوضو باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.88,
   "end": 162.28,
   "text": "خب ما تقریباً اگر بخواهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.28,
   "end": 166.12,
   "text": "منصفانه بگیم، ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.12,
   "end": 170.74,
   "text": "یک سوم بلکه بیشتر از ساعت شبانه روزمون رو در خوابیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.74,
   "end": 173.7,
   "text": "بعضیا هم نصفی از سوان-- شبانه روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.7,
   "end": 180.34,
   "text": "جسمشون بیشتر نیاز داره. بالاخره می‌گه قبل از خواب وضو بگیر کل خوابت عبادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.34,
   "end": 184.04,
   "text": "خب چرا ما این معامله رو نکنیم؟ یا کل س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.04,
   "end": 189.6,
   "text": "هر وقت که نیاز به قضای حاجت پیدا کردیم بلافاصله بعدش وضو بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.6,
   "end": 193.66,
   "text": "این طهارت باعث می‌شه که رزق زیاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.66,
   "end": 197.94,
   "text": "یا اگر انسان جنب شد به هر دلیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.94,
   "end": 202.52,
   "text": "در حالت جنابت جنب کنار یعنی بذاریدش کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.52,
   "end": 211.38,
   "text": "این از خدا فاصله گرفته. اصلاً جنب از جنب میاد یعنی کنار 후에، بره کنار فاصله بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.38,
   "end": 213.2,
   "text": "طهارت نداره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.2,
   "end": 215.88,
   "text": "می‌گه سریع طهارت. سریع برو غسل کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.88,
   "end": 218.72,
   "text": "نمون در حالت جنابت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.72,
   "end": 223.78,
   "text": "نمون که این خودش باعث می‌شه جلوی رزق گرفته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.78,
   "end": 230.12,
   "text": "یکی از عوالم، قبلاً هم گفتیم دلایلی که اجنه به ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.12,
   "end": 233.52,
   "text": "مستولی می‌شن عدم رعایت نجس و پاکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.52,
   "end": 240.36,
   "text": "که حالا قبلاً بحث کردیم. این‌ها رو رعایت کنه انسان هم رزقش درست می‌شه هم اجنه ازش فاصله می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.36,
   "end": 243.98,
   "text": "خونه‌ای که کَرو کثیفه، نظافتش رعایت نمی‌شه خصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.98,
   "end": 247.46,
   "text": "نجس و پاکی رعایت نمی‌شه، اونجا تنزل ملائک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.46,
   "end": 249.74,
   "text": "خیلی به ندرت کمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.74,
   "end": 256.88,
   "text": "و اجنه زیادن. پیغمبر فرمود لباسی که کثیفه تازه نه نجسه، کثیفه نمی‌تونه ذکر بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.88,
   "end": 259.44,
   "text": "اینا اسراری‌ست. ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 259.44,
   "end": 264.84,
   "text": "یه مدتی تو حسینیه خودمون می‌خوندیم زور می‌زدیم با توسلات و چه و اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.84,
   "end": 269.84,
   "text": "می‌دیدیم به سختی انگار مجلس خفسه، به سختی ارتباط برقرار می‌شه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.84,
   "end": 271.9,
   "text": "اخیراً که افتادیم به نظافت دیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.9,
   "end": 276.14,
   "text": "موش تو حسینه بوده دور تا دور دور پرده پر از فضله موش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.14,
   "end": 280.54,
   "text": "نجسه دیگه. جلوگیری می‌کنه از تنزل ملائک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.54,
   "end": 283.22,
   "text": "پس طهارت. حالا چه چیزی باعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.22,
   "end": 288.28,
   "text": "رفع قذارات، آلودگی‌ها و این نجاسات و این‌ها می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.28,
   "end": 290.6,
   "text": "بالاخره انسان می‌خواد طهارت نفس پیشه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 290.6,
   "end": 293.34,
   "text": "الان اراده کردم من پاک باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.34,
   "end": 298.54,
   "text": "دیگه توبه کنم، استغفار رو پیشه بگیرم و دیگه راه درست رو پیش برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.54,
   "end": 300.34,
   "text": "آثار گناه تو وجودم مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 300.34,
   "end": 304.28,
   "text": "این آثار رو چه کنم؟ از بهترین اذکار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.28,
   "end": 308.88,
   "text": "اذک نه، اصلاً فرمودن بهترین ذکری که طهارت نفس میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 308.88,
   "end": 312.48,
   "text": "اجازه بدید با فرمایش امام رضا قربونش بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.48,
   "end": 316.78,
   "text": "از عیون أخبار الرضا جلد یک صفحه دویست و نود و چهار آغاز کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.78,
   "end": 321.86,
   "text": "حضرت فرمود \"من لم يقدر على ما يكفر به ذنوبه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.86,
   "end": 328.0,
   "text": "اگر کسی هست که قادر نیست تکفیر کنه ذنوبش رو یعنی کفاره گناهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.0,
   "end": 333.92,
   "text": "رو نمی‌تونه بده، انقدر گناهاش سنگین بوده آثارش هم مترتب شده همینطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 333.92,
   "end": 338.06,
   "text": "زِيق معیشتی، زنگ معیشتی پیدا کرده و چه و اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 338.06,
   "end": 341.62,
   "text": "چه راهی داره؟ حضرت فرمودن \"فليكثر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.62,
   "end": 344.18,
   "text": "پس بسیار این کار رو انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 344.18,
   "end": 349.64,
   "text": "چی؟ \"من الصلاة یا الصلوات على محمد و آله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.64,
   "end": 352.48,
   "text": "زیاد صلوات بفرسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.48,
   "end": 355.34,
   "text": "دقت به eksarش داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 355.34,
   "end": 358.92,
   "text": "کثرت صلوه که ماه شعبان هم که اصلاً ماه صلواته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 358.92,
   "end": 362.6,
   "text": "خب چه اتفاقی می‌افته؟ حضرت فرمود \"فإنها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.6,
   "end": 365.14,
   "text": "این یه تاکید \"تحطم الذنوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 365.14,
   "end": 369.2,
   "text": "حدما\". دو مرتبه \"حدما\" تاکید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 369.2,
   "end": 374.2,
   "text": "قطعاً، قطعاً حد می‌شه، منهدم می‌شه گناهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.2,
   "end": 376.04,
   "text": "با کثرت صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.04,
   "end": 379.4,
   "text": "این بهترین ذکره برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 379.4,
   "end": 382.92,
   "text": "در حقیقت برون رفت از آثار گناه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 382.92,
   "end": 387.12,
   "text": "زشتی‌ها. که خوبه انسان این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.12,
   "end": 390.46,
   "text": "به هر حال خصوصاً در این ماه پیشه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.46,
   "end": 396.92,
   "text": "یکی از آثار اصلاً از آثار صلوات که می‌دونید طهارت نفس هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.92,
   "end": 399.0,
   "text": "در جامعه کبیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.0,
   "end": 406.16,
   "text": "اون قسمتی که عرض می‌کنیم به اهل بیت که \"وجعل صلاتنا علیکُم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 406.16,
   "end": 409.26,
   "text": "و مخصّنا بهیم ولایتکُم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 409.26,
   "end": 413.23,
   "text": "این صلواتی که ما به شما می‌فرستیم چهار تا پیامد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.23,
   "end": 420.32,
   "text": "\"طيب الخلقنا و طهاره لأنفسنا و تزکیه لنا و کفاره لذنوبنا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 420.32,
   "end": 424.98,
   "text": "چهارتاش بحث تزکیه و طهارت و طیب شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 424.98,
   "end": 428.28,
   "text": "ببینید طيبن، طهارten،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.28,
   "end": 430.78,
   "text": "تزکیهten، کفارهten.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.78,
   "end": 433.3,
   "text": "همش در پی چیه؟ پیامدهای صلواته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.3,
   "end": 435.5,
   "text": "یعنی صلوات باعث می‌شه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 435.5,
   "end": 441.62,
   "text": "ظاهر و باطنش حالا این \"طيب الخلقنا\" بعضی منابع گفتن خلقنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 441.62,
   "end": 443.62,
   "text": "چه اخلاق، چه خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 443.62,
   "end": 446.04,
   "text": "یعنی در خلقت ما هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.04,
   "end": 448.66,
   "text": "اگر ناپاکی‌ای وجود داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 448.66,
   "end": 451.3,
   "text": "مثلاً پدر و مادر وضو نگرفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 451.3,
   "end": 453.46,
   "text": "نزدیکی کردن شیطان اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.46,
   "end": 458.18,
   "text": "دخالت کرده. بسم الله الرحمن الرحیم نگفتن موقع مجامعت شیطان اومده دخالت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.18,
   "end": 463.58,
   "text": "یه ناپاکی در بدن انسان، در جسم انسان ایجاد می‌شه که اون با،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 463.58,
   "end": 466.76,
   "text": "با چی؟ با فشار غدد باید برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.76,
   "end": 469.04,
   "text": "این می‌گه با کثرت صلوات هم باید اینجور بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.04,
   "end": 473.34,
   "text": "صلوات چی؟ \"طيب الخلق، خلقنا\" خلقت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 473.34,
   "end": 482.68,
   "text": "طهارت این صلوات براش ایجاد می‌کنه و باعث می‌شه اون کدورت‌ها، اون قذارات، اون آلودگی‌ها از بین بره و در پی‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.68,
   "end": 485.6,
   "text": "این موانع برطرف بشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.6,
   "end": 489.1,
   "text": "چی بشه؟ ز-- عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.1,
   "end": 494.7,
   "text": "وسعت رزق ایجاد بشه. حالا رزق از هر نحوش که می‌خواد بشه و اجنه دفع بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 494.7,
   "end": 496.82,
   "text": "اجنه دفع می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.82,
   "end": 501.22,
   "text": "یکی از بهترین حالا صلوات مطلقه کلاً مطلقاً صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 501.22,
   "end": 505.62,
   "text": "یکی از بهترین صلوات‌ها هم تقدیم کنم در میان صلوات‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 505.62,
   "end": 508.38,
   "text": "من البته خواهش کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.38,
   "end": 513.92,
   "text": "خوب شد یادم افتاد. خیلی مراقب باشید که صلوات‌ها کلاً اسکا اینا معثور باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 513.92,
   "end": 515.8,
   "text": "یعنی اثر اهل بیت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.8,
   "end": 518.92,
   "text": "همینطوری این گفت، اون گفت نه. دیگه فوق نهایت‌ش دیگه مثلاً یه، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.92,
   "end": 524.88,
   "text": "حکیم، یه عارف، یه بزرگی مثل آقای بهجت، مثل آقای حسن زاده اینا تاکید کرده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.88,
   "end": 526.48,
   "text": "اگر هم ما در روایات ندیدیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 526.48,
   "end": 530.84,
   "text": "یعنی اونا بهش رسیده باشن استیاد کرده باشن از آدم، از عالم قدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 530.84,
   "end": 534.52,
   "text": "همینطوری از خودمون چیزی نسازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 534.52,
   "end": 537.68,
   "text": "مثلاً صلوات ناریه من دیدم بعضیا پخش می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 537.68,
   "end": 542.04,
   "text": "ما اصلاً نداریم در مصادرمون صلواتی به نام صلوات آتشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 542.04,
   "end": 544.08,
   "text": "نداریم. از خودشون ساختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 544.08,
   "end": 547.74,
   "text": "زیاده متأسفانه اینطوری. یکی از صلوات‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 547.74,
   "end": 553.96,
   "text": "متن صلوات از مصادر اهل بیت نیست، معصوره نیست اما بزرگان خیلی سفارش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 553.96,
   "end": 557.94,
   "text": "صلوات مخصوصه حضرت زهرا سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 557.94,
   "end": 571.3,
   "text": "البته این از روایاتی از این دست مثل این دست روایات گرفته شده که مثلاً پیغمبر عزیز عالم فرمودن که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 571.3,
   "end": 575.58,
   "text": "حالا متن عربیشو اگر تو نوشته‌هاتم بله پیداش کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 575.58,
   "end": 579.48,
   "text": "در کتاب کشف الغمه فی معرفت الأئمه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 579.48,
   "end": 581.41,
   "text": "اینو کی فرموده؟ پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 581.41,
   "end": 584.68,
   "text": "\"یا فاطمة\" فاطمه‌جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 584.68,
   "end": 590.7,
   "text": "\"من صلی علیه\" هرکس به تو صلوات بفرسته \"غفرالله له\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 590.7,
   "end": 593.28,
   "text": "خدا می‌بخشش و \"الحقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 593.28,
   "end": 599.04,
   "text": "بی\" ملحقش می‌کنه به من \"حيث كنت من الجنة\" هر کجای بهشت که باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 599.04,
   "end": 601.34,
   "text": "این نشون می‌ده که منهدم کننده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 601.34,
   "end": 605.16,
   "text": "یعنی همه‌ی آلودگی‌ها رو می‌بره که ملحق می‌شه به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 605.16,
   "end": 608.46,
   "text": "و مخصوصاً از این روایت از این حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 608.46,
   "end": 611.82,
   "text": "گرفته شده، اون صلوات خاصه گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 611.82,
   "end": 616.22,
   "text": "عین متن معصوره نیست اما حکما از این استفاده کردن عرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 616.22,
   "end": 618.42,
   "text": "بحار جله چهل و سه، صفحه پنجاه و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 618.42,
   "end": 625.22,
   "text": "چقدر قشنگه. پیغمبر فرمود \"إن الله قد وكل بها رعيل من الملائكة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 625.22,
   "end": 631.35,
   "text": "خدای عده گروه کثیری از ملائکه رو موکل کرده بر حضرت زهرا، دخترم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 631.35,
   "end": 639.24,
   "text": "\"يحفظونها من بين يديها ومن خلفها وعن يمينها وعن شمالها وهم معها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 639.24,
   "end": 648.56,
   "text": "اینا از پشت و رو به رو و چپ و راست و دائماً همراه حضرتن، معیت او می‌کنند و محافظت از حضرت زهرا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 648.56,
   "end": 653.52,
   "text": "کی؟ \"في حياتها عند قبرها بعد موتها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 653.52,
   "end": 655.96,
   "text": "در زمان حیاتش، نزد قبرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 655.96,
   "end": 659.08,
   "text": "بعد از شهادت ایشون. بعد کارشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 659.08,
   "end": 664.4,
   "text": "بعد از این محافظت خانم \"يكثرون الصلاة عليها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 664.4,
   "end": 668.74,
   "text": "اینجاست ببینید عین روایتی که بعد عرفا ازش استیاد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 668.74,
   "end": 671.56,
   "text": "اینا کارشون اینه \"يكثرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 671.56,
   "end": 678.14,
   "text": "الصلاة عليها\" صلوات زیاد بر او می‌فرستند و \"على أبيها وبعلها وبنيها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 678.14,
   "end": 681.76,
   "text": "لذا اینا عرفا اومدن می‌خوای صلوات بفرستی اینطوری بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 681.76,
   "end": 689.38,
   "text": "این از اینجا استیاد شده. \"اللهم صل على فاطمة وأبيها وبعلها وبنيها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 689.38,
   "end": 691.42,
   "text": "بعد حالا بعضیا اومدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 691.42,
   "end": 699.02,
   "text": "سر و \"سر المستودعه فيها\" رو هم بهش اضافه کردن که بعضیا گفتن منظور حضرت محسن از عرفا گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 699.02,
   "end": 703.0,
   "text": "بعضیا گفتن امام عصره. \"بعدد ما حاط به المک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 703.0,
   "end": 707.46,
   "text": "این مخصوصاً دو تیکه آخرش رو عرفا، بزرگان اهل معرفت اضافه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 707.46,
   "end": 710.08,
   "text": "تو روایات نیست دقت داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 710.08,
   "end": 715.86,
   "text": "و مثلاً بعضی از بزرگان هم گفتن چون عدد فاطمه پونصد و سیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 715.86,
   "end": 719.26,
   "text": "خیلی در قضای حاجت، گرفتن حاجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 719.26,
   "end": 722.03,
   "text": "مجربه پونصد و سی بار این صلوات رو بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 722.03,
   "end": 727.7,
   "text": "\"اللهم صل على فاطمة وأبيها وبعلها وبنيها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 727.7,
   "end": 734.6,
   "text": "تا همین نقطه. حالا دوست داشتید اون عبارت که هم اضافه شده بزرگان گفتن، خیلی هم گفتن اضافه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 734.6,
   "end": 742.06,
   "text": "ان‌شاءالله که به برکت صلوات این ماه، ماه صلوات هست عاقبت هممون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 742.06,
   "end": 749.69,
   "text": "صلوات بفرستید. اللهم صل على محمد و آل محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}