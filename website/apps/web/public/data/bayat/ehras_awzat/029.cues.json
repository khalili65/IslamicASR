   "start": 598.17,
   "end": 703.81
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.18,
   "end": 5.7,
   "text": "ما هیچ چاره‌ای نداریم دوستان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.7,
   "end": 7.62,
   "text": "الا اینکه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.62,
   "end": 11.3,
   "text": "سه ظلمت خلاص بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.3,
   "end": 19.26,
   "text": "که الان هممون بدون استثنا در معرض این سه ظلمت هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.26,
   "end": 26.88,
   "text": "یه توضیح مقدماتی بدم که هم مرتبط با بحث معرفت نفسمون و مقدماتش البته هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.88,
   "end": 31.12,
   "text": "هم توصیه‌ای که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.12,
   "end": 34.9,
   "text": "اون هدایا هست رو تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.9,
   "end": 42.58,
   "text": "این سه ظلمت یکیش ظلمت بدن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.58,
   "end": 47.14,
   "text": "این بدن ما مانع ارتباط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.14,
   "end": 50.86,
   "text": "قطعی ما با عالم قدسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.86,
   "end": 58.8,
   "text": "مانع ارتباط اتمه. حتی چنانچه خاطر شریفتون باشه عزیزانی که در سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.8,
   "end": 65.1,
   "text": "رساله سیر و سلوک سید بحر العلوم رحمت الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 65.1,
   "end": 70.72,
   "text": "پیگیر بودن مباحث رو، تو یکی از اون جلساتی که دریا زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 70.72,
   "end": 77.1,
   "text": "غرب تهران غروبای جمعه عرض کردیم تو کانال هست عزیزانی که گوش دادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 77.1,
   "end": 85.32,
   "text": "اونجا ثابت کردیم از قول علامه حسین-- سید حسین حسینی تهرانی که حتی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 85.32,
   "end": 91.34,
   "text": "کامل هم به جهت داشتن بدن عنصری مثل الان امام عصر ما تنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 91.34,
   "end": 97.6,
   "text": "انسان کاملی‌ست که با بدن عنصری در نشئه طبیعت حضور دارن، بقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 97.6,
   "end": 101.6,
   "text": "دیگه بدون بدن عنصری هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 101.6,
   "end": 105.18,
   "text": "به خاطر داشتن همین بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 105.18,
   "end": 112.9,
   "text": "نحو اتصال و ارتباطشون یا به یک معنا میشه گفت اون عروجشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 112.9,
   "end": 117.0,
   "text": "کامل و اکمل و اتم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 117.0,
   "end": 118.94,
   "text": "به جهت داشتن بدن چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 118.94,
   "end": 126.52,
   "text": "چون نفس باید تعلق به بدن داشته باشه تا رتق و فتق امور بدن رو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 126.52,
   "end": 128.3,
   "text": "اونجا بحثش رو داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 128.3,
   "end": 130.5,
   "text": "چون میدونم برای عده‌ای این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 130.5,
   "end": 140.72,
   "text": "سؤال برانگیزه، گفتم که اون مباحث رو اونجا گوش بدن براشون جا میفته چرا در خصوص انسان کامل همین چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 140.72,
   "end": 147.92,
   "text": "که علامه دهدار چنانچه خاطر شریفتون باشه که رساله قضا و قدرش رو آوردیم اینجا از روش سخن گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 147.92,
   "end": 151.34,
   "text": "علامه خیلی تاکید دارن و تصحیح و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 151.34,
   "end": 155.82,
   "text": "تصحیح کردن این رساله رو و تعلیقه براش نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 155.82,
   "end": 158.56,
   "text": "عرض کردیم که ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 158.56,
   "end": 161.64,
   "text": "فرمودن که تعلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 161.64,
   "end": 164.4,
   "text": "انسان پس از مرگش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 164.4,
   "end": 167.36,
   "text": "به عین ثابتش پونصد سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 167.36,
   "end": 170.72,
   "text": "باقی میمونه. که اونجا اینو صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 170.72,
   "end": 173.8,
   "text": "این تعلق پونصد سال باقی میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 173.8,
   "end": 178.08,
   "text": "اونجا اگه کسی خواست این رو باز کردیم اونجا یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 178.08,
   "end": 185.78,
   "text": "حالا پس بدن یکی از ظلمت‌هاییست که ما الان گرفتارشیم که عرض کردیم فلسفه شهادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 185.78,
   "end": 191.72,
   "text": "اینه که شهید به مقام شهود میرسه و تنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 191.72,
   "end": 198.66,
   "text": "مانع اتصال کاملش رو بلکه اکملش رو به حضرت حق این بدن می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 198.66,
   "end": 201.54,
   "text": "معامله می‌کنه. میگه اینم ورش دار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 201.54,
   "end": 204.74,
   "text": "این می‌شه شهادت. بچه بازی نیست شهادت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 204.74,
   "end": 208.6,
   "text": "مقام شهوده. این یه نف-- یک ظلمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 208.6,
   "end": 213.36,
   "text": "ظلمت بعدی نفس ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 213.36,
   "end": 219.88,
   "text": "خود نفس که البته الان شما باید حاضر جواب باشید بگید کدوم نفس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 219.88,
   "end": 225.2,
   "text": "آفرین. چرا عمار است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 225.2,
   "end": 230.18,
   "text": "تعلق به بدن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 230.18,
   "end": 233.2,
   "text": "تعلق به بدن داره بیش از حد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 233.2,
   "end": 237.0,
   "text": "یعنی بدن بیچاره کرده نفس رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 237.0,
   "end": 240.74,
   "text": "خواهش‌های بدن بیش از حد متعارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 240.74,
   "end": 242.78,
   "text": "جلوی سیر نفس رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 242.78,
   "end": 244.32,
   "text": "این می‌شه نفس اماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 244.32,
   "end": 247.84,
   "text": "که اگر این تعلق کم بشه، کم بشه به حداقل و انزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 247.84,
   "end": 255.76,
   "text": "مراتب دیگه جایی که دیگه فقط بدن بتونه حیاتش رو ادامه بده برسه از اون طرف به همون میزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 255.76,
   "end": 259.86,
   "text": "نفس می‌تونه ارتباط بگیره با عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 259.86,
   "end": 262.7,
   "text": "قدس و بشه نفس مطمئنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 262.7,
   "end": 267.72,
   "text": "پس یکی دیگه هم نفس بیچاره‌ایه که بیچاره بدن شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 267.72,
   "end": 272.9,
   "text": "که جسارت می‌کنم غالباً ما هممون این بیچارگی رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 272.9,
   "end": 280.48,
   "text": "و اصلاً این سیر معرفت نفس رو انشاالله می‌خوایم بریم که این بیچارگی رو برداریم از خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 280.48,
   "end": 284.16,
   "text": "و سومین ظلمتی هم که گرفتارشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 284.16,
   "end": 288.04,
   "text": "ظلمت خود دنیاست، عالم طبع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 288.04,
   "end": 293.0,
   "text": "طبیعت. که اینجا عرض کردیم بارها در سیر بحث‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 293.0,
   "end": 296.32,
   "text": "نور و ظلمت مشوبن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 296.32,
   "end": 299.66,
   "text": "حق و باطل مشوبن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 299.66,
   "end": 306.68,
   "text": "عقل و وهم مشوبن، شب و روز مشوبن، یعنی گرگ و میشه اصطلاحاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 306.68,
   "end": 309.26,
   "text": "شر و خیر با هم قاطیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 309.26,
   "end": 311.74,
   "text": "هرکس نمی‌تونه تشخیص بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 311.74,
   "end": 314.82,
   "text": "این ظلمتی‌ست که ایجاد شده فقط هم اینجا اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 314.82,
   "end": 317.92,
   "text": "دیگه ما فوق عالم طبع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 317.92,
   "end": 323.72,
   "text": "هیچ شری وجود نداره، هیچ ظلمتی نیست، هیچ باطلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 323.72,
   "end": 326.72,
   "text": "خب ما هیچ چاره‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 326.72,
   "end": 331.62,
   "text": "جز خارج شدن از این ظل-- سه ظلمت نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 331.62,
   "end": 336.14,
   "text": "تا بتونیم ارتباط بگیریم با ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 336.14,
   "end": 341.36,
   "text": "وجود خودمون از طریق ملکوت وجود خودمون به ملکوت عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 341.36,
   "end": 344.98,
   "text": "که \"وفی السماء رزقکم وما توعدون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 344.98,
   "end": 347.46,
   "text": "که همه مطلق ارزاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 347.46,
   "end": 357.24,
   "text": "یکیش رزق علم و دانش و معرفت و حکمت و عرفانه که شما زانو زدید سر این سفره، ما با هم زانو زدیم سر این سفره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 357.24,
   "end": 366.69,
   "text": "تا از این سه ظلمت خارج نشیم خبری عزیز دلم از علم و معرفت و حکمت و عرفان نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 366.69,
   "end": 369.93,
   "text": "حاج آقا شما که ما رو بیچاره‌تر کردی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 369.93,
   "end": 373.75,
   "text": "اصلاً ما اینجاییم که شما رو بیچاره کنیم، بیچاره‌تر کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 373.75,
   "end": 379.11,
   "text": "خودمون رو هم همین‌طور. تا یک فکری به حال بیچارگی‌مون بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 379.11,
   "end": 383.29,
   "text": "حالا، چه ذکری هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 383.29,
   "end": 387.89,
   "text": "با آدابش البته اگر گفته بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 387.89,
   "end": 390.83,
   "text": "خیلی سریع‌السیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 390.83,
   "end": 395.83,
   "text": "مثل این قطار‌های سریع‌السیر اومده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 395.83,
   "end": 403.51,
   "text": "یه مسیر مثلاً دوازده ساعته رو یک ساعته میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 403.51,
   "end": 409.49,
   "text": "سریع‌السیر ما رو در آن واحد از این سه تا ظلمت خارج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 409.49,
   "end": 415.85,
   "text": "هرکی گفت اون چه ذکریه؟ از سه ظلمت این که ما عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 415.85,
   "end": 419.01,
   "text": "سریعاً خارج می‌کنه. بله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 419.01,
   "end": 427.31,
   "text": "بلند بگین. لا اله الا الله نه، از یک ظلمت ما رو خارج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 427.31,
   "end": 433.11,
   "text": "بله؟ احسنت به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 433.11,
   "end": 439.95,
   "text": "باز هم خواهرها. برای سلامتی خواهری که گفتن یه صلوات بفرستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 439.95,
   "end": 446.61,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 446.61,
   "end": 448.85,
   "text": "خب بله ذکر یونوسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 448.85,
   "end": 453.91,
   "text": "ما حالا اول بگم چه ربطی داره به خروج از سه ظلمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 453.91,
   "end": 464.07,
   "text": "حضرت یونس علی نبينا و آله و عليه الصلاة والسلام هم از سه ظلمت به محض گفتن این ذکر خارج شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 464.07,
   "end": 469.05,
   "text": "حالا بعضیا گفتن که چهارصد بار گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 469.05,
   "end": 473.39,
   "text": "بعضیا گفتن نه چهار هزار بار این ذکر رو گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 473.39,
   "end": 476.75,
   "text": "لذا بین عرفا حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 476.75,
   "end": 485.47,
   "text": "زده شده از این حیث که مثلاً یه کسی که می‌خواد کمال بشه، از کاملین بشه و این‌ها حداقل چهارصد بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 485.47,
   "end": 489.29,
   "text": "برسونش تا چهار هزار بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 489.29,
   "end": 493.29,
   "text": "این ذکر. بله حتما در سجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 493.29,
   "end": 498.79,
   "text": "حالا سر اینکه در سجده هست، یه سرش در اینه که خود حضرت یونس اینو در سجده گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 498.79,
   "end": 507.59,
   "text": "تو دل اون حالا و ذی النون اذ ذهب مغاضباً تو دل اون نهنگ حالا یا ماهی هرچی که بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 507.59,
   "end": 510.07,
   "text": "سر دیگرش که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 510.07,
   "end": 514.97,
   "text": "فرصتش نیست انشاالله در آثار سجده یه وقتی با هم بررسی می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 514.97,
   "end": 517.95,
   "text": "که در جامع الاسرار ملا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 517.95,
   "end": 520.55,
   "text": "سید حیدر آملی اومده البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 520.55,
   "end": 524.33,
   "text": "اونجا می‌تونید ببینید. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 524.33,
   "end": 527.73,
   "text": "سه تا ظلمتی که حضرت یونس بلافاصله ازش خارج شد چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 527.73,
   "end": 535.27,
   "text": "که بعضیا گفتن نخیر، همون اولین بار که گفت این نهنگ عطسه کرد، ایشون پر-پرید بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 535.27,
   "end": 542.01,
   "text": "پرت شد بیرون و به شکرانه چهارصد یا چهار هزار بار گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 542.01,
   "end": 545.73,
   "text": "حالا درش اختلاف هست کاری هم نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 545.73,
   "end": 548.93,
   "text": "اون سه ظلمت چی بود؟ یکیش دل نهنگ بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 548.93,
   "end": 551.91,
   "text": "اون تاریک بود، ظلمت دل نهنگ بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 551.91,
   "end": 554.03,
   "text": "یکیش دل دریا بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 554.03,
   "end": 559.13,
   "text": "یکیشم دل شب بود. تو شب گرفتار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 559.13,
   "end": 561.21,
   "text": "این سه تا ظلمت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 561.21,
   "end": 562.97,
   "text": "پشت سر گذاشت و نجات پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 562.97,
   "end": 570.93,
   "text": "لذا عرفا از همین جا برداشت کردن، استفاده کردن که برای خروج از این سه ظلمت این ذکر باید گفته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 570.93,
   "end": 574.55,
   "text": "این ذکر از ذکر‌هایی‌ست که آنی جواب میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 574.55,
   "end": 577.71,
   "text": "در خروج از نور به-- از ظلمت به نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 577.71,
   "end": 584.19,
   "text": "الله ولي الذين آمنوا يخرجهم من الظلمات إلى النور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 584.19,
   "end": 589.01,
   "text": "ما نداریم ذکری که به این سرعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 589.01,
   "end": 595.87,
   "text": "به این جامعیت از هر سه ظلمت انسان رو خلاص کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 595.87,
   "end": 598.05,
   "text": "البته در سجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 598.05,
   "end": 605.17,
   "text": "ما جلسه پیش در سوالی که یکی از خواهرها داشت در خصوص ذکر یونسی دست و پا شکسته البته جواب دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 605.17,
   "end": 606.53,
   "text": "عرض کردیم که اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 606.53,
   "end": 613.27,
   "text": "برنامه دارن طبق برنامه‌شون فعلاً برن جلو تا بعدها ببینیم چه میشه کرد، برنامه میشه داد یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 613.27,
   "end": 619.81,
   "text": "اونایی که ندارن حداقل یک بار بعد از هر نماز یا در سجده آخر نمازشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 619.81,
   "end": 623.89,
   "text": "یا در سجده آخر نمازشون یا بعد از نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 623.89,
   "end": 627.25,
   "text": "الحمد لله رو که میگن لا اله الا انت میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 627.25,
   "end": 630.67,
   "text": "ذکر یونوسیه. اما این برای کیاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 630.67,
   "end": 634.45,
   "text": "این برای حد اقلی‌هاست، نه شماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 634.45,
   "end": 638.41,
   "text": "الان دیگه رسیدیم نقطه سر خط به شماها، به ما، به خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 638.41,
   "end": 641.69,
   "text": "ماها زشته یک بار بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 641.69,
   "end": 649.97,
   "text": "من و شما باید حد اقلش یعنی من دیگه کف، کف، کف خودم رو دیگه نگاه می‌کنم سطح رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 649.97,
   "end": 653.01,
   "text": "کف سطح جلسه رو که خودم رو نگاه کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 653.01,
   "end": 655.71,
   "text": "حد اقلش باید سه بار بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 655.71,
   "end": 658.49,
   "text": "چون سه بار میشه ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 658.49,
   "end": 663.45,
   "text": "کثیر. ذکر ک-کمتر از سه بار دیگه ذکر کثیر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 663.45,
   "end": 665.89,
   "text": "این اینکه سر اینکه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 665.89,
   "end": 669.45,
   "text": "ان الله و ملائکته يصلون رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 669.45,
   "end": 675.19,
   "text": "اون رو که میگیم بعد سه بار چون تو آیه که نیومده سه بار صلوات بفرستین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 675.19,
   "end": 678.11,
   "text": "سه بار صلوات فرستادن علتش اینه که ذکر کثیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 678.11,
   "end": 684.43,
   "text": "پس اینو یادمون باشه دیگه برای من و شماها تنبل‌ترین‌تون که منم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 684.43,
   "end": 690.05,
   "text": "واقعاً میگم نه بازار گرم کنی باشه واقعاً من خودم رو از همه شما تنبل‌تر می‌بینم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 690.05,
   "end": 695.19,
   "text": "می‌بینم نه اینکه بدونم. حالا می‌خوای باور کن می‌خوای نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 695.19,
   "end": 696.95,
   "text": "سه بار دیگه حد اقلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 696.95,
   "end": 700.35,
   "text": "کسی که می‌تونه هفت بار، می‌تونی ده بار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 700.35,
   "end": 703.81,
   "text": "می‌تونی چهل بار. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}