   "start": 8.54,
   "end": 190.12
  },
  {
   "index": 1,
   "title": "## شبههٔ بی‌نیازی از حرز؛ سنت الهی در آیهٔ صدودوازده انعام",
   "start": 190.12,
   "end": 491.44
  },
  {
   "index": 2,
   "title": "## رجوع به اهل و حرمت رمال و فالگیر",
   "start": 491.44,
   "end": 511.64
  },
  {
   "index": 3,
   "title": "## رقعة الجیب، حرز امام رضا علیه‌السلام",
   "start": 511.64,
   "end": 572.72
  },
  {
   "index": 4,
   "title": "### روایت حمید بن قحطبه",
   "start": 572.72,
   "end": 631.82
  },
  {
   "index": 5,
   "title": "### توصیهٔ آیت‌الله بهجت دربارهٔ مفاتیح",
   "start": 631.82,
   "end": 652.08
  },
  {
   "index": 6,
   "title": "### روایت ابوالصلت هروی و اثر حرز",
   "start": 652.08,
   "end": 702.04
  },
  {
   "index": 7,
   "title": "## توصیهٔ پایانی",
   "start": 702.04,
   "end": 729.28
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.9,
   "end": 4.7,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.7,
   "end": 8.54,
   "text": "ایات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.54,
   "end": 12.32,
   "text": "وعده داده بودیم که یه چند تا تعویذ رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.32,
   "end": 16.08,
   "text": "معرفی کنیم که پناه ببریم به اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.08,
   "end": 20.0,
   "text": "بحث ما کتاب الموت مرحوم مجلسی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.0,
   "end": 24.2,
   "text": "و ما داریم حتی روایت داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.2,
   "end": 29.9,
   "text": "مثلاً پیغمبر از قبرستانی عبور می‌کرد فرمود بسیاری از این‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.9,
   "end": 34.26,
   "text": "در این قبرها خوابیده‌اند از چشم بد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.26,
   "end": 42.42,
   "text": "خوابیده‌اند. روایت داریم امام صادق صلوات الله علیه فرمود شتر رو در دیگ می‌کنه چشم بد، چشم حسود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.42,
   "end": 46.26,
   "text": "خیلی خطرناکه. حالا بحث اجنه هم که داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.26,
   "end": 52.96,
   "text": "اون هم به یک معنا توطئه دشمن‌ها، بلاهای روزگار، مرگ مفاجات و و و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.96,
   "end": 55.9,
   "text": "اینا همه می‌طلبه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.9,
   "end": 61.74,
   "text": "تعویذ داشته باشه. اجازه بفرمایید حالا چند تا تعویذ هست همه ش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.74,
   "end": 64.9,
   "text": "فرصت نمیشه امروز تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.9,
   "end": 67.92,
   "text": "یکی دو تاشو امروز بگیم. اولیش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.92,
   "end": 70.96,
   "text": "به نام حرز عَبیدجانه‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.96,
   "end": 73.78,
   "text": "که البته اسم اصلیشون سماک بن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.78,
   "end": 76.42,
   "text": "خرشه هستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.42,
   "end": 80.14,
   "text": "ایشون معروف بود به عَبیدجانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.14,
   "end": 85.84,
   "text": "این روایتی که عرض می‌کنم ببینید چقدر محکمه که در کتاب‌هایی مثل سفینة البحار جلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.84,
   "end": 87.48,
   "text": "سه صفحه بیست و سه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.48,
   "end": 91.0,
   "text": "بحار هم جلد نود و یک آورده هم جلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.0,
   "end": 94.86,
   "text": "شصت. مصباح کف‌امی صفحه دویست و بیست و نه آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.86,
   "end": 99.84,
   "text": "کافی مرحوم کلینی علیه الله مقامع الشریف جلد هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.84,
   "end": 101.64,
   "text": "صفحه سیصد و هجده آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.64,
   "end": 104.88,
   "text": "بسیاری از بزرگان خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.88,
   "end": 107.96,
   "text": "بنده حقیر دیدم که سفارش داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.96,
   "end": 112.2,
   "text": "حالا جریان این حرز چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.2,
   "end": 115.52,
   "text": "این شخص یکی از اصحاب خاص پیغمبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.52,
   "end": 120.78,
   "text": "خوبه بدونید که انقدر مقامش بالا بود جزء اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.78,
   "end": 122.94,
   "text": "معدود افرادی بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.94,
   "end": 128.72,
   "text": "هیچ‌وقت پیغمبر رو ول نکرد حتی در جنگ احد که همه فرار کردن ایشون فرار نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.72,
   "end": 134.8,
   "text": "در بعض از کتب رجالی ایشون رو کنار سلمان و مالک و این‌ها ازش یاد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.8,
   "end": 138.76,
   "text": "بعض از کتب مثل، مثل اون موقعی که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.76,
   "end": 146.42,
   "text": "اِمم ما در اصفهان درس می‌خوندیم، خیلی سال‌های پیش طلبهگی می‌خوندیم حوزه صدر اصفهان این کتاب جرم داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.42,
   "end": 153.52,
   "text": "زندانی داشت به جهت اینکه سیصد و سیزده اسم یاران آقا به رمز توش اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.52,
   "end": 156.7,
   "text": "اون موقع ما این کتاب رو خوندیم اسم ایشون توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.7,
   "end": 162.32,
   "text": "اسم عَبیدجانه که لقبشه البته کنیه‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.32,
   "end": 164.64,
   "text": "و حالا جریان چیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.64,
   "end": 170.0,
   "text": "که حالا میگن که جزء رجعت کنندگان با امام عصر صلوات الله علیه خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.0,
   "end": 173.74,
   "text": "ایشون شب‌ها صدای سوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.74,
   "end": 178.18,
   "text": "صدای مثلاً طاس انداختن توی ظرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.18,
   "end": 180.24,
   "text": "صداهای عجیب غریب تو خونه‌ش می‌شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.24,
   "end": 182.48,
   "text": "یا مثلاً می‌دید یه دفعه یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.48,
   "end": 187.58,
   "text": "نوری یه دفعه جهش می‌کرد خاموش می‌شد یا یک سایه بلندی می‌دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.58,
   "end": 190.12,
   "text": "اتفاقات عجیب و غریب تو خونه‌ش می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.12,
   "end": 193.1,
   "text": "بعضی از شما اومدید به من اخیراً درد و دل کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.1,
   "end": 199.26,
   "text": "همین اتفاقات در منزل بعضی از شما رخ داده که این‌ها قطعاً کار اجنه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.26,
   "end": 203.44,
   "text": "با بحثی که ما در خصوص جن جلسه پیش داشتیم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.44,
   "end": 206.88,
   "text": "باید برهن باشه قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.88,
   "end": 214.7,
   "text": "پیش پیغمبر اومد. پیغمبر عزیز عالم بلافاصله فرمودن این‌ها اجنه هستند که در منزل تو رو اذیت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.7,
   "end": 217.86,
   "text": "بعد سف-- به امیرالمؤمنین صلوات الله علیه فرمودن بنویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.86,
   "end": 220.68,
   "text": "اینجا کاتب مولا بود. براش بنویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.68,
   "end": 224.54,
   "text": "این حرز رو نوشت که هم یک صغیر دارد هم یک کبیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.54,
   "end": 226.78,
   "text": "حتی کبیرش هم خیلی طولانی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.78,
   "end": 230.58,
   "text": "می‌تونید بنویسید. البته توصیه شده من دیدم بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.58,
   "end": 238.62,
   "text": "بعضی سفارش کردن برای تاثیر بیشترش با گلاب و زعفران بنویسید، رو به قبله باشید، لباس و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.62,
   "end": 242.24,
   "text": "بدنتون وقتی که دارید می‌نویسید پاک باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.24,
   "end": 246.14,
   "text": "و حتما وضو داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.14,
   "end": 249.86,
   "text": "ترجیحاً با قلم طبیعی بنویسید مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.86,
   "end": 252.58,
   "text": "مثلاً فرمودن شاخه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.58,
   "end": 256.18,
   "text": "درخت انجیر خشک شده سرشو بتراشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.18,
   "end": 260.86,
   "text": "بزنید تو گلاب و زعفران بنویسید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 260.86,
   "end": 266.24,
   "text": "دیگه فرمودن که سعی کنید یه آدم باتقوا هرچی-- طرف که می‌نویسه باتقواتر باشه بهتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.24,
   "end": 271.03,
   "text": "از کجا اینو درآوردن؟ اینکه پیغمبر به امیرالمؤمنین فرمود بنویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.03,
   "end": 274.3,
   "text": "اینه که هرچی-- یه کسی که خیلی قبولش دارید بنویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.3,
   "end": 279.3,
   "text": "اگر نه که خودتون رو به هر حال این شرایط رو حفظ کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.3,
   "end": 287.7,
   "text": "که عرض کردم و رو کاغذی هم بنویسید که طبیعی باشه و به دست مسلمان این کاغذ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.7,
   "end": 290.82,
   "text": "ساخته شده باشه. ترجیحاً پوست آهو باشه بهتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.82,
   "end": 292.7,
   "text": "حالا اینم ترجیحاتش بود که گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.7,
   "end": 295.72,
   "text": "هیچ‌کدوم از اینام نبود باز شما بنویسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.72,
   "end": 299.64,
   "text": "تاثیرش رو داره اما این‌ها باعث می‌شه که تاثیرش بیشتر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.64,
   "end": 306.24,
   "text": "به هر حال پیغمبر اینو به امیرالمؤمنین فرمود که بنویسید دادن به عَبیدجانه توی بسته‌ای گذاشت زیر سرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.24,
   "end": 310.52,
   "text": "شب که خوابید اون شب برای اولین بار تا صبح راحت خوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 310.52,
   "end": 313.26,
   "text": "فقط صبح صدای جیغ و فریاد و ناله و این‌ها از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 313.26,
   "end": 317.3,
   "text": "تو خونه‌ش شنید که دارن میگن تو رو خدا اینو بنداز از خونه‌ت بیرون ما دیگه نمی‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 317.3,
   "end": 321.8,
   "text": "بالاخره مردم اومدن سکنا گزیده بودند در منزل ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 321.8,
   "end": 325.44,
   "text": "اِمم به هر حال خونه و زندگی تشکیل داده بودند اجنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.44,
   "end": 329.4,
   "text": "دلایلش هم قبلاً جلسه پیش عرض کردیم چی می‌شه که میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.4,
   "end": 332.76,
   "text": "خب بعد از چندین سال می‌خواست از خونه اینا رو بیرون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.76,
   "end": 335.64,
   "text": "سختشون بود. گفت من باید از پیغمبر اجازه بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.64,
   "end": 338.0,
   "text": "اومد پیغمبر فرمود دیگه کاری به کارشون نداشته باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.0,
   "end": 343.88,
   "text": "این‌ها در رنج و عذابند به واسطه همین ذکر همین حرز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.88,
   "end": 347.28,
   "text": "حالا کسایی که گمان می‌کنند حالا اِمم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.28,
   "end": 355.82,
   "text": "از این مسائل دارن که من الان بخشیش رو از تو خود متن حرز درآوردم آثارشو براتون می‌خونم استفاده کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.82,
   "end": 362.06,
   "text": "این که دارم عرض می‌کنم خدمتتون خودم از تو متن حرز یعنی متن حرزو که دیدم، دیدم عجب همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 362.06,
   "end": 365.68,
   "text": "این‌ها تو اون متن عربیش هست آثارش مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.68,
   "end": 369.0,
   "text": "دفع اجنه دفع سحر و طلسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 369.0,
   "end": 371.82,
   "text": "باز شدن درب خیر به سوی شخص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 371.82,
   "end": 374.64,
   "text": "حل شدن اختلافات و جدایی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 374.64,
   "end": 380.4,
   "text": "قرار گرفتن در پناه خدا، محافظت از چیزهای بد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.4,
   "end": 383.22,
   "text": "محافظت از بدی و خطای دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.22,
   "end": 387.18,
   "text": "دیگران خطا می‌کنند، دامنش رو شما می‌گیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 387.18,
   "end": 394.76,
   "text": "دفع گره‌ها، رفع گره‌های زندگی مثل چشم زخم، حیله و مکر دیگران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 394.76,
   "end": 399.25,
   "text": "دفع آزار‌های ماوراءالطبیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.25,
   "end": 404.06,
   "text": "که خودش یه بحث مفصلیه الان حوصله شما ندارید انشاالله بعدها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 404.06,
   "end": 408.54,
   "text": "حالا مثلا آزار شیاطین، اجنه و غیره یا ساحران و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.54,
   "end": 412.14,
   "text": "دفع چشم بد، چشم حسود، چشم زخم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.14,
   "end": 415.6,
   "text": "دفع شر متجاوزان و ستمگران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.6,
   "end": 418.18,
   "text": "دفع شر بادهای بد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 418.18,
   "end": 423.58,
   "text": "بادها. پارسال یه باد تندی اومد تو تهران چند تا درخت افتاد اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.58,
   "end": 427.7,
   "text": "تو خونه خود ما یه درخت کاج بلند بود افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 427.7,
   "end": 434.52,
   "text": "بادهای بد. دفع شر غریبه‌ها و افراد چه در خواب و چه در بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.52,
   "end": 437.66,
   "text": "اینم خیلی نکته‌ست. هم در خواب هم در بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 437.66,
   "end": 443.8,
   "text": "پناهندگی از جميع شرور، پناهندگی از امراض و بیماری‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 443.8,
   "end": 451.22,
   "text": "این آثاریه که بنده حقیر از تو خود متن هرز متن عربیش دیدم درآوردم و براتون بخشیش رو ذکر کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 451.22,
   "end": 455.04,
   "text": "خلاصه یک هرز همه جانبه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 455.04,
   "end": 460.5,
   "text": "استفاده کنیم. حالا بعضیا میگن آقا خدا هست تا امام زمان داریم هرز می‌خوایم چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 460.5,
   "end": 465.16,
   "text": "چطور خود اهل بیت استفاده می‌کردن تو خودت از انسان کامل بالاتری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 465.16,
   "end": 468.52,
   "text": "اساس عالم بر این قر-- برقرار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 468.52,
   "end": 470.88,
   "text": "آیه‌ی صد و دوازده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.88,
   "end": 475.92,
   "text": "سوره انعام را اگه یادتون باشه با هم خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 475.92,
   "end": 484.16,
   "text": "چی بود؟ همین بود که خدا این چنین سنتش برقرار شده که اجنه بیان دشمنی باشه با انبیا، با پیروان انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 484.16,
   "end": 487.2,
   "text": "منتها تعویذ می‌خواد. حصن و پناه می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 487.2,
   "end": 488.78,
   "text": "اینها هم دستور خود اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 488.78,
   "end": 493.74,
   "text": "ما از خودمون که نمی‌سازیم که. البته باید به اهلش مراجعه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 493.74,
   "end": 501.94,
   "text": "مطلقا به این رمال‌ها، کتاب نمی‌دونم دعانويس‌ها، کتاب بین‌ها، فالگیرها اینا مطلقا حرام هستند به اینا رجوع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 501.94,
   "end": 505.26,
   "text": "به این‌ها رجوع نکنید. همین چیزی که بزرگانمون دارن میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 505.26,
   "end": 511.64,
   "text": "الان همین که در کتاب کافی مرحوم کلینی حدود هزار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 511.64,
   "end": 514.52,
   "text": "تقریبا دویست سال پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 514.52,
   "end": 520.46,
   "text": "اولین کتابی‌ست که معنون شده در کتب روایی اهل بیت اونجا آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 520.46,
   "end": 526.48,
   "text": "محدث کلینی ثقل Islam بسه دیگه همین یه دونه، همین یه دونه سند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 526.48,
   "end": 531.06,
   "text": "یه دونه دیگه هم معرفی کنم که اینم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 531.06,
   "end": 534.24,
   "text": "هرز به دردبخور و عالی و جالبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 534.24,
   "end": 537.52,
   "text": "جان؟ هرزش عبی دوجانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 537.52,
   "end": 540.36,
   "text": "اسمش هرز عبی دوجانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 540.36,
   "end": 543.22,
   "text": "سندهاشم خدمتتون عرض کردم کجا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 543.22,
   "end": 547.56,
   "text": "حالا اگه خواستید من نوشته‌ش رو دارم بعد از نماز بیاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 547.56,
   "end": 553.86,
   "text": "این دومی که میگم هم شیخ عباس قمی در مفاتیح آورده هم مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 553.86,
   "end": 559.5,
   "text": "کفامی در المسواکش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 559.5,
   "end": 562.04,
   "text": "به نام رقعت الجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 562.04,
   "end": 565.56,
   "text": "رقعت الجیب از امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 565.56,
   "end": 570.56,
   "text": "صلوات الله علیه که حالا جریانش دو تا روایت من دیدم در این زمینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 570.56,
   "end": 576.36,
   "text": "سندش هم که عرض کردم خدمتتون مثلاً حمید بن حطبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 576.36,
   "end": 582.52,
   "text": "یا حمید بعضی جاها دیدم نوشتن حمید بن حطبه میگه با امام رضا بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 582.52,
   "end": 584.68,
   "text": "بعد وارد منزل ما شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 584.68,
   "end": 587.68,
   "text": "حضرت لباس‌هاشو درآورد. من دادم شستشو کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 587.68,
   "end": 596.44,
   "text": "کنیز ما برگشت از تو یقه، جیب، رقعت الجیب، یقه از یقه حضرت یه بسته‌ای درآورد به من داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 596.44,
   "end": 600.66,
   "text": "به حضرت نشون دادم. آقا این تو لباس شما یقه لباس مبارک شما بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 600.66,
   "end": 603.8,
   "text": "فرمود بله، این یادگار جد ما پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 603.8,
   "end": 606.54,
   "text": "قابل توجه اونایی که میگن این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 606.54,
   "end": 609.74,
   "text": "اعتقاد ندارند. امام رضا هم داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 609.74,
   "end": 613.36,
   "text": "و فرمود این حفظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 613.36,
   "end": 616.4,
   "text": "و صیانت از همه بلاها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 616.4,
   "end": 618.98,
   "text": "شر همه شیاطین و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 618.98,
   "end": 621.68,
   "text": "تعویذ است بر هر چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 621.68,
   "end": 627.9,
   "text": "امام رضا فرمود که پیغمبر به ما مأموریت دادند اینو حالا همراه داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 627.9,
   "end": 631.82,
   "text": "اینا خیلی طولانی نیست. سندش هم که گفتیم الحمدلله تو همین مفاتیح هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 631.82,
   "end": 636.4,
   "text": "خدا رحمت کنه آقای بهجت رو و یه مدت زیادی با مهج الدعوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 636.4,
   "end": 640.62,
   "text": "سید بن طاووس محشور بودم و آقای بهجت به بنده گفتن از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 640.62,
   "end": 646.88,
   "text": "مفاتیح غافل نباش. یه نماز صبحی بود محضرشون بودیم باهاشون گفت‌وگو کردیم گفت این مفاتیح و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 646.88,
   "end": 650.82,
   "text": "هرچی که تو این مفاتیح هست مورد تأییده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 650.82,
   "end": 654.5,
   "text": "که حالا بعد یه روایت دیگه هم داره عباس از تأثیرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 654.5,
   "end": 660.16,
   "text": "عباس بن طهروی میگه هارون امام رضا رو خوند که تمام کنه کارو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 660.16,
   "end": 661.74,
   "text": "به شدت غضب کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 661.74,
   "end": 664.0,
   "text": "من نگران حال امام رضا شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 664.0,
   "end": 666.08,
   "text": "حضرت فرمود برو کنار نگران نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 666.08,
   "end": 671.04,
   "text": "وارد که می‌شد یه چیزی زب-- بر زبانش حضرت رضا صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 671.04,
   "end": 673.7,
   "text": "زمزمه می‌کرد. وارد شدیم دیدیم بالعکس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 673.7,
   "end": 677.56,
   "text": "هارون آروم شد. تازه صد هزار درهم به حضرت پول داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 677.56,
   "end": 680.86,
   "text": "فرمود هرچی می‌خوای حاجت داری برای ما بنویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 680.86,
   "end": 682.66,
   "text": "اصلاً از این زیر رو به اون رو شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 682.66,
   "end": 686.74,
   "text": "وقتی برگشتیم گفتم آقا نه به اون وضعیت غضبش، نه به این حالت چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 686.74,
   "end": 690.72,
   "text": "فرمود من همین رقعت الجیب، همین دعایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 690.72,
   "end": 694.2,
   "text": "را-- داریم عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 694.2,
   "end": 702.04,
   "text": "به یادگار از جدمون رسول خدا همین رو بر لسان جاری کردم و این تعویذ است بر هر چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 702.04,
   "end": 707.0,
   "text": "این دو تا رو فعلاً داشته باشید. حالا انشاالله روزهای بعد چند تا دیگه مستند براتون تقدیم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 707.0,
   "end": 712.52,
   "text": "هی به این و اون و پول بدید به این فالگیر و به اون رمال و به این کتاب دعانويس و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 712.52,
   "end": 715.64,
   "text": "که رجوعش هم حرامه. نرید رجوع نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 715.64,
   "end": 718.24,
   "text": "همینا بسنده کنید انشاالله گره‌ها باز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 718.24,
   "end": 720.14,
   "text": "انشاالله که عاقبت ما ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 720.14,
   "end": 723.28,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 723.28,
   "end": 726.04,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 726.04,
   "end": 729.28,
   "text": "محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}