  "driftFraction": 0.0
 },
 "chapters": [],
 "cues": [
  {
   "i": 0,
   "start": 1.66,
   "end": 5.46,
   "text": "‫ أعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.46,
   "end": 10.58,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.58,
   "end": 13.22,
   "text": "وإلهكم إله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.22,
   "end": 16.62,
   "text": "واحد لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.62,
   "end": 22.82,
   "text": "إله إلا هو الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.82,
   "end": 29.5,
   "text": "الله لا إله إلا هو الحي القيوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.5,
   "end": 32.02,
   "text": "لا تأخذه سنة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.02,
   "end": 37.9,
   "text": "ولا نوم له ما في السماوات وما في الأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.9,
   "end": 42.12,
   "text": "من ذا الذي يشفع عنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.12,
   "end": 50.6,
   "text": "إلا بإذنه يعلم ما بين أيديهم وما خلفهم ولا يحيطون بشيء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.6,
   "end": 55.36,
   "text": "من علمه إلا بما شاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.36,
   "end": 65.94,
   "text": "وسع كرسيه السماوات والأرض ولا يؤوده حفظهما وهو العلي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 65.94,
   "end": 72.96,
   "text": "الم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 72.96,
   "end": 80.22,
   "text": "الله لا إله إلا هو الحي القيوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 80.22,
   "end": 84.86,
   "text": "إن الله لا يخفى عليه شيء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 84.86,
   "end": 89.08,
   "text": "في الأرض ولا في السماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 89.08,
   "end": 94.76,
   "text": "هو الذي يصوركم في الأرحام كيف يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 94.76,
   "end": 100.74,
   "text": "لا إله إلا هو العزيز الحكيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 100.74,
   "end": 111.72,
   "text": "شهد الله أنه لا إله إلا هو والملائكة وأولو العلم قائمًا بالقسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 111.72,
   "end": 118.14,
   "text": "لا إله إلا هو العزيز الحكيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 118.14,
   "end": 123.69,
   "text": "إن الدين عند الله الإسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 123.69,
   "end": 133.52,
   "text": "وما اختلف الذين أوتوا الكتاب إلا من بعد ما جاءهم العلم بغيا بينهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 133.52,
   "end": 141.38,
   "text": "ومن يكفر بآيات الله فإن الله سريع الحساب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 141.38,
   "end": 148.52,
   "text": "إن هذا لهو القصص الحق وما من إله إلا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 148.52,
   "end": 153.18,
   "text": "وإن الله لهو العزيز الحكيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 153.18,
   "end": 157.1,
   "text": "وإذا حييتم بتحية",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 157.1,
   "end": 162.36,
   "text": "فحيوا بأحسن منها أو ردوها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 162.36,
   "end": 168.88,
   "text": "إن الله كان على كل شيء حسيبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 168.88,
   "end": 179.52,
   "text": "الله لا إله إلا هو ليجمعنكم إلى يوم القيامة لا ريب فيه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 179.52,
   "end": 184.16,
   "text": "ومن أصدق من الله حديثا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 184.16,
   "end": 191.44,
   "text": "لقد كفر الذين قالوا إن الله ثالث ثلاثة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 191.44,
   "end": 194.88,
   "text": "وما من إله إلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 194.88,
   "end": 197.22,
   "text": "إله واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 197.22,
   "end": 206.94,
   "text": "وإن لم ينتهوا عما يقولون ليمسن الذين كفروا منهم عذاب أليم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 206.94,
   "end": 216.62,
   "text": "ذلكم الله ربكم لا إله إلا هو خالق كل شيء فاعبدوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 216.62,
   "end": 219.26,
   "text": "وهو على كل شيء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 219.26,
   "end": 226.82,
   "text": "وكيل. اتبع ما أوحي إليك من ربك لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 226.82,
   "end": 231.78,
   "text": "إله إلا هو وأعرض عن المشركين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 231.78,
   "end": 243.52,
   "text": "قل يا أيها الناس إني رسول الله إليكم جميعا الذي له ملك السماوات والأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 243.52,
   "end": 256.2,
   "text": "لا إله إلا هو يحيي ويميت فآمنوا بالله ورسوله النبي الأمي الذي يؤمن بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 256.2,
   "end": 264.92,
   "text": "الذي يؤمن بالله وكلماته واتبعوه لعلكم تهتدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 264.92,
   "end": 270.28,
   "text": "اتخذوا أحبارهم ورهبانهم أربابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 270.28,
   "end": 274.6,
   "text": "من دون الله والمسيح ابن مريم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 274.6,
   "end": 284.82,
   "text": "وما أمروا إلا ليعبدوا إلهًا واحدًا لا إله إلا هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 284.82,
   "end": 290.12,
   "text": "سبحانه عما يشركون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 290.12,
   "end": 298.6,
   "text": "فإن تولوا فقل حسبي الله لا إله إلا هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 298.6,
   "end": 306.72,
   "text": "عليه توكلت وهو رب العرش العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 306.72,
   "end": 314.42,
   "text": "وجاوزنا ببني إسرائيل البحر فأتبعهم فرعون وجنوده بغيا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 314.42,
   "end": 318.26,
   "text": "وعدوا حتى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 318.26,
   "end": 331.16,
   "text": "إذا أدركه الغرق قال آمنت أنه لا إله إلا الذي آمنت به بنو إسرائيل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 331.16,
   "end": 345.18,
   "text": "قال آمنت أنه لا إله إلا الذي آمنت به بنو إسرائيل وأنا من المسلمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 345.18,
   "end": 349.76,
   "text": "فإن لم يستجيبوا لكم فاعلموا أنما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 349.76,
   "end": 358.98,
   "text": "أنزل بعلم الله وأن لا إله إلا هو فهل أنتم مسلمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 358.98,
   "end": 362.9,
   "text": "كذلك أرسلناك في أمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 362.9,
   "end": 372.5,
   "text": "أمة قد خلت من قبلها أمم لتتلو عليهم الذي أوحينا إليك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 372.5,
   "end": 376.78,
   "text": "وهم يكفرون بالرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 376.78,
   "end": 386.42,
   "text": "قل هو ربي لا إله إلا هو عليه توكلت وإليه متاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 386.42,
   "end": 395.72,
   "text": "ينزل الملائكة بالروح من أمره على من يشاء من عباده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 395.72,
   "end": 404.02,
   "text": "أن أنذروا أنه لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 404.02,
   "end": 409.3,
   "text": "إله إلا أنا فاتقون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 409.3,
   "end": 417.38,
   "text": "وإن تجهر بالقول فإنه يعلم السر وأخفى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 417.38,
   "end": 420.24,
   "text": "الله لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 420.24,
   "end": 426.66,
   "text": "إله إلا هو له الأسماء الحسنى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 426.66,
   "end": 436.44,
   "text": "إني أنا ربك فاخلع نعليك إنك بالواد المقدس طوى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 436.44,
   "end": 440.94,
   "text": "وأنا اخترتك فاستمع لما يوحى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 440.94,
   "end": 452.7,
   "text": "إنني أنا الله لا إله إلا أنا فاعبدني وأقم الصلاة لذكري.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 452.7,
   "end": 462.28,
   "text": "إن الساعة آتية أكاد أخفيها لتجزى كل نفس بما تسعى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 462.28,
   "end": 464.58,
   "text": "إنما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 464.58,
   "end": 471.04,
   "text": "إلهكم الله الذي لا إله إلا هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 471.04,
   "end": 475.1,
   "text": "وسع كل شيء علما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 475.1,
   "end": 477.46,
   "text": "وما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 477.46,
   "end": 486.04,
   "text": "أرسلنا من قبلك من رسول إلا نوحي إليه أنه لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 486.04,
   "end": 490.48,
   "text": "إله إلا أنا فاعبدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 490.48,
   "end": 494.76,
   "text": "وذا النون إذ ذهب مغاضبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 494.76,
   "end": 499.88,
   "text": "فظن أن لن نقدر عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 499.88,
   "end": 512.12,
   "text": "فنادى في الظلمات أن لا إله إلا أنت سبحانك إني كنت من الظالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 512.12,
   "end": 521.02,
   "text": "فتعالى الله الملك الحق لا إله إلا هو رب العرش الكريم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 521.02,
   "end": 532.32,
   "text": "ألا يسجدوا لله الذي يخرج الخبء في السماوات والأرض ويعلم ما تخفون وما تعلنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 532.32,
   "end": 539.88,
   "text": "الله لا إله إلا هو رب العرش العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 539.88,
   "end": 548.1,
   "text": "وهو الله لا إله إلا هو له الحمد في الأولى والآخرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 548.1,
   "end": 554.42,
   "text": "وله الحكم وإليه ترجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 554.42,
   "end": 557.62,
   "text": "ولا تدع مع الله إلها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 557.62,
   "end": 560.78,
   "text": "آخر لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 560.78,
   "end": 563.8,
   "text": "إله إلا هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 563.8,
   "end": 568.5,
   "text": "كل شيء هالك إلا وجهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 568.5,
   "end": 575.38,
   "text": "له الحكم وإليه ترجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 575.38,
   "end": 582.94,
   "text": "يا أيها الناس اذكروا نعمة الله عليكم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 582.94,
   "end": 590.32,
   "text": "هل من خالق غير الله يرزقكم من السماء والأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 590.32,
   "end": 597.6,
   "text": "لا إله إلا هو فأنى تؤفكون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 597.6,
   "end": 602.72,
   "text": "إنا كذلك نفعل بالمجرمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 602.72,
   "end": 613.7,
   "text": "إنهم كانوا إذا قيل لهم لا إله إلا الله يستكبرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 613.7,
   "end": 620.26,
   "text": "ويقولون أئنا لتاركوا آلهتنا لشاعر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 620.26,
   "end": 627.9,
   "text": "مجنون. بل جاء بالحق وصدق المرسلين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 627.9,
   "end": 632.04,
   "text": "قل إنما أنا منذر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 632.04,
   "end": 638.98,
   "text": "وما من إله إلا الله الواحد القهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 638.98,
   "end": 642.2,
   "text": "خلقكم من نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 642.2,
   "end": 653.64,
   "text": "واحدة ثم جعل منها زوجها وأنزل لكم من الأنعام ثمانية أزواج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 653.64,
   "end": 658.7,
   "text": "يخلقكم في بطون أمهاتكم خلقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 658.7,
   "end": 660.86,
   "text": "من بعد خلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 660.86,
   "end": 664.54,
   "text": "في ظلمات ثلاث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 664.54,
   "end": 675.04,
   "text": "ذلكم الله ربكم له الملك لا إله إلا هو فأنى تصرفون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 675.04,
   "end": 686.12,
   "text": "غافر الذنب وقابل التوب شديد العقاب ذي الطول لا إله إلا هو إليه المصير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 686.12,
   "end": 690.2,
   "text": "ذلكم الله ربكم خالق كل شيء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 690.2,
   "end": 696.66,
   "text": "لا إله إلا هو فأنى تؤفكون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 696.66,
   "end": 705.06,
   "text": "هو الحي لا إله إلا هو فادعوه مخلصين له الدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 705.06,
   "end": 710.18,
   "text": "الحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 710.18,
   "end": 718.12,
   "text": "رب السماوات والأرض وما بينهما إن كنتم موقنين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 718.12,
   "end": 728.31,
   "text": "لا إله إلا هو يحيي ويميت ربكم ورب آبائكم الأولين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 728.31,
   "end": 735.35,
   "text": "فهل ينظرون إلا الساعة أن تأتيهم بغتة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 735.35,
   "end": 739.23,
   "text": "فقد جاء أشراطها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 739.23,
   "end": 745.51,
   "text": "فأنى لهم إذا جاءتهم ذكراهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 745.51,
   "end": 748.89,
   "text": "فاعلم أنه لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 748.89,
   "end": 761.51,
   "text": "إله إلا الله واستغفر لذنبك وللمؤمنين والمؤمنات والله يعلم متقلبكم ومثواكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 761.51,
   "end": 768.67,
   "text": "لو أنزلنا هذا القرآن على جبل لرأيته خاشعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 768.67,
   "end": 773.03,
   "text": "متصدعا من خشية الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 773.03,
   "end": 780.59,
   "text": "وتلك الأمثال نضربها للناس لعلهم يتفكرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 780.59,
   "end": 790.69,
   "text": "هو الله الذي لا إله إلا هو عالم الغيب والشهادة هو الرحمن الرحيم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 790.69,
   "end": 793.47,
   "text": "هو الله الذي لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 793.47,
   "end": 803.11,
   "text": "إله إلا هو الملك القدوس السلام المؤمن المهيمن العزيز الجبار المتكبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 803.11,
   "end": 816.79,
   "text": "سبحان الله عما يشركون هو الله الخالق البارئ المصور له الأسماء الحسنى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 816.79,
   "end": 826.99,
   "text": "يسبح له ما في السماوات والأرض وهو العزيز الحكيم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 826.99,
   "end": 832.07,
   "text": "وأطيعوا الله وأطيعوا الرسول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 832.07,
   "end": 840.35,
   "text": "فإن توليتم فإنما على رسولنا البلاغ المبين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 840.35,
   "end": 844.79,
   "text": "الله لا إله إلا هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 844.79,
   "end": 849.61,
   "text": "وعلى الله فليتوكل المؤمنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 849.61,
   "end": 856.79,
   "text": "رب المشرق والمغرب لا إله إلا هو فاتخذه وكيلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}