 ],
 "cues": [
  {
   "i": 0,
   "start": 0.16,
   "end": 9.02,
   "text": "اونچه که ما از بزرگان هدیه می‌کنیم ابتدای جلسه مرتبط با بحث تحصیل علم و معرفت و دانشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.02,
   "end": 14.34,
   "text": "که به درد شما می‌خوره. یکی از دستوراتی که مربوط به امروز هم هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.34,
   "end": 18.84,
   "text": "مال چهارشنبه هر هفته. من خودم امروز انجام دادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.84,
   "end": 21.22,
   "text": "فکر می‌کنم هفت دقیقه طول کشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.22,
   "end": 25.52,
   "text": "خیلی زمان نمی‌بره. البته سندش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.52,
   "end": 30.64,
   "text": "کتاب گوهر شب چراغ، جلده یک، صفحه صد و پنجاه، اونجا می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.64,
   "end": 35.42,
   "text": "اما خب به صرف این که تو یه کتابی اومده من هیچ‌وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.42,
   "end": 41.8,
   "text": "اکتفا نکردم و یکی از بزرگان جام و اطراف وقتی توصیه می‌کنه بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.8,
   "end": 46.8,
   "text": "چه خودم بخوام انجام بدم چه به دیگری مخصوصاً آقای بهجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.8,
   "end": 51.4,
   "text": "روحش شاد یه روزی به ما سفارشاتی داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.4,
   "end": 58.26,
   "text": "در خصوص مفاتیح و بعضی از ادعیه به بنده اجازه دادن که به دیگران سفارش و توصیه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.26,
   "end": 66.02,
   "text": "اتفاقاً آقای بهجت هم به یک جوون بیست و هفت ساله‌ای که ازشون پرسید \"من حافظه‌ام خوبه اما راه علم برام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 66.02,
   "end": 68.54,
   "text": "گشاده نیست. دارم اذیت میشم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.54,
   "end": 72.6,
   "text": "عاشق علمم، تشنه معرفتم\" مثل خیلی از شماها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.6,
   "end": 76.48,
   "text": "لکن راه انگار بسته است به روی ما این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.48,
   "end": 82.04,
   "text": "چه کنیم؟ آقای بهجت توصیه‌هایی کردن، آخرین توصیه کردن همین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.04,
   "end": 92.52,
   "text": "که فرمودن اونجا تو اون کتاب گوهر شب چراغ هم اومده که آثار این ذکر این‌هاست من اول براتون بگم بعد خود ذکر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 92.52,
   "end": 96.18,
   "text": "اول فرمودن بر اهالی علم و قلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 96.18,
   "end": 102.62,
   "text": "فائق آید. البته این رو دقت داشته باشید، این به این معنا نیست که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 102.62,
   "end": 106.08,
   "text": "بگیم مثلاً دنبال این هستیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 106.08,
   "end": 109.86,
   "text": "مثلاً برتری‌جویی بر اهل علم و قلم، نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 109.86,
   "end": 113.82,
   "text": "اشتباه نشه. یعنی این که یه کاری باید بکنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 113.82,
   "end": 121.72,
   "text": "که بتونی حتی به اهل علم و اهل قلم که اصطلاحاً بهشون می‌گن فضلا هم تو خیر برسونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 121.72,
   "end": 124.24,
   "text": "یعنی خیر تو به اون‌ها هم برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 124.24,
   "end": 126.2,
   "text": "چرا فقط به بی‌سوادها و کم‌سوادها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 126.2,
   "end": 127.88,
   "text": "نه، به اهل علم هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 127.88,
   "end": 132.74,
   "text": "این یکی از... یعنی یک علمی رو خدا به تو میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 132.74,
   "end": 140.6,
   "text": "که از فهم وای این روایت اینطوری برمی‌آد که همون حکمت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 140.6,
   "end": 145.5,
   "text": "چون خیلی‌ها علم دارن اما به باطن علم پی نبردن لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 145.5,
   "end": 149.62,
   "text": "حاضرن بیان زانو بزنن پیش یه کسی که ظاهراً از جهت درجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 149.62,
   "end": 155.2,
   "text": "علمی شاید از اونا کمتر باشه اما به حکمت رسیده که باطن علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 155.2,
   "end": 157.66,
   "text": "توجه کردی؟ و ازش بهره بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 157.66,
   "end": 167.04,
   "text": "این میشه حتی تو وجود یک بچه پونزده ساله، چهارده ساله هم بیفته که در زمان جنگ ما اینو زیاد دیدیم از بچه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 167.04,
   "end": 170.76,
   "text": "حالا یه وقتی ما خاطرات جنگ رو برای شما بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 170.76,
   "end": 172.98,
   "text": "البته اهلش باید بگن ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 172.98,
   "end": 174.94,
   "text": "زشته امثال ما بخواهیم چیزی بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 174.94,
   "end": 181.64,
   "text": "اما یکی از دوست-- اساتید ما که در هدایت ما خیلی سهیم بود روحش شاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 181.64,
   "end": 185.8,
   "text": "که در شلمچه تیر خورد تو صورتش و عجیب بود خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 185.8,
   "end": 194.8,
   "text": "وقتی که داشت می‌رفت من خوابیدم رو پوتینش، صورتم رو پوتینش گذاشتم، انقدر گریه کردم که خیس شد پوتینه ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 194.8,
   "end": 196.54,
   "text": "و منو بلند کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 196.54,
   "end": 201.06,
   "text": "منو علی صدا می‌کرد. گفت \"علی پاشو غصه نخور من خواب دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 201.06,
   "end": 205.06,
   "text": "حضرت زهرا سلام الله علیها رو دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 205.06,
   "end": 207.44,
   "text": "و به من گفته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 207.44,
   "end": 212.92,
   "text": "قبرمو نشون داده و حتی کسایی که قبل از من، بعد از من شهید میشن.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 212.92,
   "end": 214.98,
   "text": "اینای صحبت‌هایی با ما کرد و رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 214.98,
   "end": 220.16,
   "text": "ایشون دو سال از من بزرگ‌تر بود اما صاحب کرامات بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 220.16,
   "end": 224.68,
   "text": "یعنی من پونزده سالم بود رفتم جنگ، ایشون هفده سالش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 224.68,
   "end": 228.66,
   "text": "کرامات عجیبی از ایشون ما دیدیم که واقعاً عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 228.66,
   "end": 237.06,
   "text": "به، یعنی اغراق نمی‌کنم واقعاً و حقیقتاً عرض می‌کنم گنجایش بیانش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 237.06,
   "end": 241.08,
   "text": "چیزایی که ما از ایشون دیدیم، خارق عادت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 241.08,
   "end": 245.22,
   "text": "عادات و چه و این‌ها. هفده ساله، بچه هفده ساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 245.22,
   "end": 250.28,
   "text": "عجیب! تو تمام نمازهاش بدون استثناء اشک داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 250.28,
   "end": 255.8,
   "text": "یعنی من ندیدم ایشون نمازی می‌خوند بدون اشک، عجیب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 255.8,
   "end": 261.46,
   "text": "و سر و رمزی هم به ما گفت در این خصوص ما هم اون موقع سعی می‌کردیم که این بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 261.46,
   "end": 263.66,
   "text": "حالا اون موقع به واسطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 263.66,
   "end": 271.66,
   "text": "به هر حال بچه‌تر بودیم، یه ذره پاک‌تر بودیم اینا، اتفاقاتی می‌افتاد، اشکی جاری میشد اما الان هی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 271.66,
   "end": 273.26,
   "text": "دل زمخت شده، زمخت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 273.26,
   "end": 275.9,
   "text": "خدا به فریاد هممون برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 275.9,
   "end": 284.46,
   "text": "پس یکیش افاقه بر اهل علم و این‌هاست که و اهل قلم که نشون میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 284.46,
   "end": 289.28,
   "text": "به درد شما اهل علم‌آموزان و حکمت‌آموزان می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 289.28,
   "end": 294.64,
   "text": "دومیش فتوحاته. فتوحات بهش دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 294.64,
   "end": 299.64,
   "text": "اگر کسی فتوحات ابن عربی رو خونده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 299.64,
   "end": 306.24,
   "text": "چون ایشون دو تا روحشون شاد، شیخ اکبر، عارف عربی دو تا کتاب داشتن به نام فتوحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 306.24,
   "end": 309.68,
   "text": "فتوحات مکیه، فتوحات مدنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 309.68,
   "end": 315.64,
   "text": "مدنیه مفقود شد. حالا یا ظرفیت کسی اقتضا نمی‌کرد، ایشون خودش گمش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 315.64,
   "end": 318.42,
   "text": "هرچی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 318.42,
   "end": 327.18,
   "text": "مثل کتاب الفین علامه حلی توصیه می‌کنم این کتابو بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 327.18,
   "end": 334.3,
   "text": "خیلی سال‌های پیش ابتدای هر منبری که می‌خواستم شروع کنم یه دونه از اون اصول هزار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 334.3,
   "end": 337.26,
   "text": "سی و هشت گانه این کتاب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 337.26,
   "end": 342.48,
   "text": "در اثبات ولایت امیرالمؤمنین و رد شبهات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 342.48,
   "end": 347.6,
   "text": "و اباطیلی که مخالفین حضرت گفتن بیان می‌کردم و خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 347.6,
   "end": 350.98,
   "text": "قشنگ اون موقع می‌چشیدم از زهرا خوشحاله از بیان این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 350.98,
   "end": 357.24,
   "text": "چرا؟ اصلاً ایشون رو وقتی در عالم رؤیا دیدن، کیو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 357.24,
   "end": 360.92,
   "text": "بحث رو گم نکنید ها، علامه حلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 360.92,
   "end": 363.42,
   "text": "ایشون رو وقتی در عالم رویا دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 363.42,
   "end": 365.7,
   "text": "گفتن از اون دنیا چه خبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 365.7,
   "end": 370.88,
   "text": "فرمود که اگر دو چیز رو نداشتم به خاطر فتواهام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 370.88,
   "end": 373.56,
   "text": "و قضاوت هام هلاک شده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 373.56,
   "end": 378.94,
   "text": "یکیش الفین، دیگرش زیارت علی حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 378.94,
   "end": 381.02,
   "text": "الفین اسمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 381.02,
   "end": 385.52,
   "text": "هست. الفین یعنی چی؟ به عربی یعنی دو هزار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 385.52,
   "end": 387.92,
   "text": "ولی شما کتاب رو می‌خونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 387.92,
   "end": 395.46,
   "text": "اصلاً خود علامه وقتی که تموم می‌کنه کتاب رو اگه ملاحظه فرموده باشید می‌نویسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 395.46,
   "end": 399.12,
   "text": "این آخرین عصر رو، هزار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 399.12,
   "end": 404.26,
   "text": "سی و هشتمین عصر رو دیگه کفایت می‌کنیم و تمام می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 404.26,
   "end": 409.92,
   "text": "بسیار اصول دیگری در اثبات ولایت اهل بیت هست اما همین مقدار بسنده می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 409.92,
   "end": 413.12,
   "text": "ولی کتاب هست دو هزار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 413.12,
   "end": 422.84,
   "text": "لذا بعضی، من از بعضی بزرگان شنیدم که ایشون بقیه رو دید در ظرف مردم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 422.84,
   "end": 425.74,
   "text": "این شد که یاد این کتاب افتادم، در ظرف مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 425.74,
   "end": 428.08,
   "text": "بعضیا هم گفتن نه کتابشون فخر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 428.08,
   "end": 436.82,
   "text": "فرزندشون دو جلد کتاب بود تو این زمینه، جلد دومش یعنی از هزار و سی و شش تا دو هزار عصر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 436.82,
   "end": 440.72,
   "text": "دیگه فرزندشون فخر المحققین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 440.72,
   "end": 442.88,
   "text": "ایشون نداد بیرون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 442.88,
   "end": 445.44,
   "text": "نگه داشت. بعضیا هم اینطوری گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 445.44,
   "end": 450.44,
   "text": "در هر حال اون کتاب خیلی خوبیه که علامه حلی اونور نجات داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 450.44,
   "end": 453.14,
   "text": "بخونید بعد با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 453.14,
   "end": 459.64,
   "text": "عرض شود از حیث عقلی و نقلی اثبات ولایت مولا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 459.64,
   "end": 463.24,
   "text": "حالا بحث چی بود که به اون سمت رفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 463.24,
   "end": 465.32,
   "text": "این فتوحات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 465.32,
   "end": 469.26,
   "text": "فتوحات ابن عربی‌اند، فتوحات مدنیه‌شون غیب شده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 469.26,
   "end": 473.92,
   "text": "فتوحات مکیه‌شون هست. اگه کسی اون کتاب فتوحات رو دیده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 473.92,
   "end": 477.38,
   "text": "متوجه می‌شه فتوحات یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 477.38,
   "end": 480.04,
   "text": "فتح و گشایش قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 480.04,
   "end": 482.8,
   "text": "یعنی قلب باز می‌شه به روی حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 482.8,
   "end": 490.52,
   "text": "آقا این چیز کمی نیست. خیلی نعمت بزرگه که نتیجه‌ش می‌شه شرح صدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 490.52,
   "end": 493.36,
   "text": "کیا از نزدیک حضرت استاد رو دیده بودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 493.36,
   "end": 500.04,
   "text": "یه دعای ثابتی که ایشون داشت که خیلی دوست داشت، می‌گفت خدا به شما شرح صدر عطا کنه آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 500.04,
   "end": 505.42,
   "text": "این شرح صدر نتیجه‌ی فتح قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 505.42,
   "end": 511.64,
   "text": "اینا خیلی مهمه. این یکی از آثارها، بخوایم اینطوری حرف بزنیم که کل کلاس می‌ره به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 511.64,
   "end": 516.04,
   "text": "روایت، رد شیم. دیگرش حوائج‌ش برآورده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 516.04,
   "end": 518.6,
   "text": "یعنی خدا خوشش میاد می‌گه بهش بدید آقا این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 518.6,
   "end": 520.64,
   "text": "بهش تفضل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 520.64,
   "end": 524.86,
   "text": "دیگرش فرمود غنی و مکرم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 524.86,
   "end": 530.7,
   "text": "یعنی بی‌نیاز می‌شه از مردم، از دنیا بی‌نیاز می‌شه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 530.7,
   "end": 533.1,
   "text": "با آبرو می‌شه، وجیه می‌شه اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 533.1,
   "end": 537.32,
   "text": "حالا اون چیه؟ به به، به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 537.32,
   "end": 542.32,
   "text": "از سفارشات اکید امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 542.32,
   "end": 545.86,
   "text": "و تمام بزرگان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 545.86,
   "end": 548.96,
   "text": "هیچ کدوم از بزرگان، کمالین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 548.96,
   "end": 555.76,
   "text": "عرفا اینها نبودن که سفارش به سه آیه آخر سوره حشر نکرده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 555.76,
   "end": 563.22,
   "text": "مثلاً مولا، امام صادق صلوات الله علیه فرمود که اسم اعظم، امیرالمؤمنین فرمود اسم اعظم تو این سه آیه آخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 563.22,
   "end": 572.66,
   "text": "حضرت امام هم خیلی سفارش به فرزندشون استاد احمد داشتن در خوانش سوره حشر خاصه آیات آخر، مخصوصاً چهار آیه آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 572.66,
   "end": 580.62,
   "text": "\"لو أنزلناها على جبل لرأيته خاشعا متصدعا من خشية الله\" از اونجا به بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 580.62,
   "end": 584.52,
   "text": "این ذکری که Allame هم توصیفش رو کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 584.52,
   "end": 590.08,
   "text": "فقط مربوط می‌شه به آیه بیست و دو سوره حشر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 590.08,
   "end": 594.51,
   "text": "این آیه بیست و دو سوره حشر که من خیلی باهاش کیف می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 594.51,
   "end": 598.88,
   "text": "\"هو الله الذي لا إله إلا هو\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 598.88,
   "end": 606.72,
   "text": "به به، به به \"عالم الغيب والشهادة هو الرحمن الرحيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 606.72,
   "end": 613.26,
   "text": "همینه. اینو فرمودن که هفتاد بار روز چهارشنبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 613.26,
   "end": 617.72,
   "text": "روزهای چهارشنبه، کارتون رو آسون کردن، نبودن هر روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 617.72,
   "end": 621.88,
   "text": "همین الان، همین امروز انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 621.88,
   "end": 624.72,
   "text": "زودم البته با حضور قلب انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 624.72,
   "end": 627.94,
   "text": "بسیار عالی، خوب و انشاالله که گوشه‌هایش حاصل شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 627.94,
   "end": 635.96,
   "text": "در تفسیر روایت، روایة اهل بیت علیهم الصلاة والسلام می‌دیدم از امام صادق زیل این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 635.96,
   "end": 642.96,
   "text": "که آیه قرائتی تو تفسیر نورش هم همینو آورده که از امام صادق در خصوص این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 642.96,
   "end": 648.42,
   "text": "غیب و شهاده پرسیدن یعنی چی خدا، صبر کن عالم الغیب والشهاده‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 648.42,
   "end": 652.22,
   "text": "حضرت فرمودن که الغیب ما لم یکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 652.22,
   "end": 654.82,
   "text": "والشهادة ما قد کان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 654.82,
   "end": 662.82,
   "text": "یعنی خدا عالم به غیبه یعنی اون چیزی که هنوز نمود نکرده، ظهور نکرده، اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 662.82,
   "end": 668.26,
   "text": "ظاهراً نیست، موجود نشده و عالم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 668.26,
   "end": 673.4,
   "text": "شهاده‌ست یعنی ما قد کان، یعنی اون چیزی که موجود شده و هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}