 },
 "chapters": [
  {
   "index": 0,
   "title": "## روز علی‌اکبر؛ شبیه‌ترین به رسول خدا",
   "start": 7.46,
   "end": 84.54
  },
  {
   "index": 1,
   "title": "## کلمۀ سیام؛ علم امام عمل و بذر روح",
   "start": 84.54,
   "end": 258.5
  },
  {
   "index": 2,
   "title": "## علم مشخص روح؛ عمل مشخص بدن",
   "start": 258.5,
   "end": 525.55
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 3.2,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.2,
   "end": 5.14,
   "text": "و ربانی ایاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.14,
   "end": 7.46,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 7.46,
   "end": 12.58,
   "text": "تبریک عرض می‌کنم این روز بسیار با عظمت رو محضر همه شما خوبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.58,
   "end": 17.4,
   "text": "روز بسیار فرخنده و با عظمت و پرنور و سروری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.4,
   "end": 22.36,
   "text": "روز کسی‌ست که به زعم آقای بهجت فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.36,
   "end": 26.92,
   "text": "ذیل اون فرمایش خود ابا عبدالله که فرمود أشبه الناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.92,
   "end": 30.66,
   "text": "علی اکبر شبیه‌ترین مردم به رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.66,
   "end": 33.24,
   "text": "خلقاً خلقاً و منطقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.24,
   "end": 36.1,
   "text": "پس اگر خاتم نداشت ان--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.1,
   "end": 39.56,
   "text": "نبوت، نبوت تشریعی البته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.56,
   "end": 42.06,
   "text": "تمام نمی‌شد، خاتمیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 42.06,
   "end": 45.56,
   "text": "نداشت حضرت علی اکبر پیغمبر می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 45.56,
   "end": 48.24,
   "text": "این کلام آقای بهجت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 48.24,
   "end": 51.54,
   "text": "خدا روحشون شاد کنه. یادش بخیر قم که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 51.54,
   "end": 56.36,
   "text": "محضرشون زیاد می‌رسیدیم اسراری می‌گفتند و به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 56.36,
   "end": 63.44,
   "text": "و این‌ها خاک نخوره تو دل شما عشاق باشه مقام بسیار رفیع از علی اکبر دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.44,
   "end": 67.8,
   "text": "که حالا چون بحث ما بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.8,
   "end": 75.98,
   "text": "صد کلمه در معرفت نفس علامه است بحث رو نمی‌خوام منقطع بشه به همین میزان اکتفا می‌کنم اگرچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.98,
   "end": 80.76,
   "text": "چیزی که ما الان عرض کردیم بزرگان باید ذیلش سخن بگن، کتاب بنویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.76,
   "end": 84.54,
   "text": "پیرامون عظمت حضرت علی اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.54,
   "end": 89.58,
   "text": "کلمه سیام. آن که در علم و عمل دقیق شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.58,
   "end": 94.1,
   "text": "علم را امام عمل و قائم بر آن می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.1,
   "end": 97.3,
   "text": "خب اون کلمات پیشین حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.3,
   "end": 100.54,
   "text": "فرمودن که چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.54,
   "end": 107.02,
   "text": "علم و عمل در سازندگی ما موثر و اصلاً علم و عمل جوهرند و انسان‌ساز و ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.02,
   "end": 111.0,
   "text": "اتحاد وجودی برقرار می‌کنیم با علم و عملمون و همون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.0,
   "end": 112.58,
   "text": "ما همون هستیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.58,
   "end": 121.8,
   "text": "علم و عملمون هستیم. اینجا در این کلمه سیام علامه می‌خوان اهمیت و عظمت و جایگاه علم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.8,
   "end": 126.86,
   "text": "بر عمل مشخص کنن در این کلمه که یعنی علم برتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.86,
   "end": 130.06,
   "text": "می‌فرماید علم نر باشد و عمل ماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.06,
   "end": 132.9,
   "text": "دین و دنیا بدین دو آماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.9,
   "end": 135.78,
   "text": "انسان مرد و زمین زن در خرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.78,
   "end": 138.08,
   "text": "هرچه آن انداخت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.08,
   "end": 143.78,
   "text": "می‌پرورد. آیه قرآن هم هست که نساءکم حرث لكم زنان شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.78,
   "end": 149.34,
   "text": "زمین کشاورز شما. شما دانه و بذر رو به اون میدی، اون می‌پرورانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.34,
   "end": 154.02,
   "text": "لذا در کتاب شریف فس الاسماء حضرت استاد اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.02,
   "end": 157.28,
   "text": "مفصل بحث شده قبلاً هم ما گفتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.28,
   "end": 166.06,
   "text": "مقام زن وقتی دیگه به اون اوج اوجش برسد بشود حضرت صدیقه طاهره سلام الله علیها می‌شود مقام نفس کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.06,
   "end": 168.88,
   "text": "مرد به اون اوج برسد که مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.88,
   "end": 172.68,
   "text": "امیرالمؤمنین سلام الله علیه هست می‌شود عقل کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.68,
   "end": 176.1,
   "text": "که عقل بر نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.1,
   "end": 179.32,
   "text": "قیویمت دارد. لذا الرجال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.32,
   "end": 182.02,
   "text": "قوامون على النساء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.02,
   "end": 186.98,
   "text": "عقل بر-- حالا نفس مقام پرورش است لذا مادر تو دامن‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.98,
   "end": 189.68,
   "text": "می‌پروراند. اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.68,
   "end": 193.64,
   "text": "علامه می‌فرماید که علم جایگاهش جایگاه عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.64,
   "end": 196.3,
   "text": "جایگاه در نظام هستی عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.3,
   "end": 200.04,
   "text": "علم اینجا مشخص می‌شه. قو-قوامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.04,
   "end": 204.88,
   "text": "و قیویمت داره بر نفس که پرورشه اگرچه پرورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.88,
   "end": 207.06,
   "text": "همون علم رو می‌پرورانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.06,
   "end": 210.0,
   "text": "یعنی بذر علم در زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.0,
   "end": 216.38,
   "text": "وجود نفس وجود شما کاشته می‌شه و او پرورش داده می‌شه با عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.38,
   "end": 220.04,
   "text": "اما اصل علمه. اصل اون بذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.04,
   "end": 222.18,
   "text": "اینجا مقام پدر معلوم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.18,
   "end": 224.98,
   "text": "اصل اون بذر رو پدر می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.98,
   "end": 230.54,
   "text": "اگرچه مقام مادر هم کم نیست در پرورش اما بذر اون اصلی، بذر اصلی اون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.54,
   "end": 233.06,
   "text": "پدر می‌ده. اگه بذر پوک باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.06,
   "end": 234.7,
   "text": "خب بچه معلومه что میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.7,
   "end": 242.4,
   "text": "اما اگر بذر یه بذر مرغوب و خوبی باشه بچه لذا فرمود الولد حدیثه الولد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.4,
   "end": 244.8,
   "text": "سر ابیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.8,
   "end": 249.06,
   "text": "نعمة. یعنی بچه سر پدرش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.06,
   "end": 251.32,
   "text": "میگن بچه رو می‌خوای ببینی؟ پدرش رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.32,
   "end": 256.08,
   "text": "حالا اینا بحث‌های تربیتی‌ایه که باید به موقعش گفته شه اگرچه چند جلسه یادمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.08,
   "end": 258.5,
   "text": "یکی دو سال پیش این‌ها رو بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.5,
   "end": 260.3,
   "text": "ادامه کلام هنوز تموم نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.3,
   "end": 266.5,
   "text": "کلمه سیام علامه. بعدیشون ادامه میدن و مانند منی رجل که قوه مولده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.5,
   "end": 269.1,
   "text": "و رطوبت مرأة یعنی زن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.1,
   "end": 275.52,
   "text": "که متولده است چه آن آسمان است و این زمین الرجال قوامون على النساء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 275.52,
   "end": 280.84,
   "text": "و از این دقت آگاه گردد که علم مشخص روح است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.84,
   "end": 284.14,
   "text": "علم مشخص روح است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.14,
   "end": 287.36,
   "text": "یعنی چی؟ یعنی علم روح ما رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.36,
   "end": 293.36,
   "text": "قبلاً عرض کردیم در کتاب انسان در عرفان علامه این یک اصل بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.36,
   "end": 298.12,
   "text": "رسین و عتیق است که من تو یه جایی حالا اهل علم بودن اینو گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.12,
   "end": 299.96,
   "text": "یه نفر اومد گفت این کجا بوده تا حالا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 299.96,
   "end": 302.84,
   "text": "این حرفو ما هیچ جا نشنیدیم. گفتم بفرمایید کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.84,
   "end": 308.24,
   "text": "گفت واقعاً اینو علامه گفتن؟ بفرمایید کتاب انسان در عرفان فلان اصلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.24,
   "end": 310.46,
   "text": "خیلی برای این‌ها جالب بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.46,
   "end": 319.2,
   "text": "می‌گه علم جان ما رو در بس-- پس از این نشئه طبیعت در برازخ بعدی اینا همه جان ما به شکل علممونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.2,
   "end": 323.44,
   "text": "چه شکلیه جان ما، نفس ما چه شکلی داره به شکل علممونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.44,
   "end": 326.8,
   "text": "و همچنین فرمود عمل مشخص بدنه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.8,
   "end": 330.76,
   "text": "یعنی عمل ما قیافه و شکل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.76,
   "end": 334.24,
   "text": "اون وضعیت و هیئت و کثفت بدن ما رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.24,
   "end": 338.16,
   "text": "اعمال ما یعنی بدن برزخی ما به شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.16,
   "end": 339.94,
   "text": "اعمال ماست که اینا بحث‌هاش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.94,
   "end": 345.84,
   "text": "بعد ادامه میدن علامه که نه روح بی‌بدن است و نه بدن بی‌روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.84,
   "end": 348.24,
   "text": "این قائم به آن است و آن قائم بر این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.24,
   "end": 350.56,
   "text": "این‌ها یک حقیقت کلی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.56,
   "end": 355.12,
   "text": "بدن نفس می‌شد گفت که انزل مراتب نفس ناطقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.12,
   "end": 357.72,
   "text": "دور از هم و جدای از هم نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.72,
   "end": 363.76,
   "text": "و یه نکته خیلی مهمی رو اینجا ذیل همین قصه برای شما بگم اگرچه هی کاش امروز بیشتر وقت داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.76,
   "end": 367.54,
   "text": "این بحث خیلی شیرینه و دامنه بحث عرض عریضی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.54,
   "end": 369.38,
   "text": "حالا اهلش واگذار می‌کنیم به اهلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.38,
   "end": 373.39,
   "text": "برید ببینید چه مکات- مطالب شیرین و عرشی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.39,
   "end": 377.01,
   "text": "اینجا علامه پیاده کرده. یه نکته دیگه عرض کنم خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.01,
   "end": 383.11,
   "text": "خب آیه شصت و دو سوره واقعه می‌فرماید \" ولقد علمتم النشأة الأولى فَلَا تُذَكِّرُونَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.11,
   "end": 386.79,
   "text": "این نشئه اولا کیه؟ قبل از این نشئه طبیعیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 386.79,
   "end": 389.27,
   "text": "میگه ما اونجا به شما این علم و آگاهی رو دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.27,
   "end": 392.09,
   "text": "چرا تذکر ندارید؟ چرا توجه ندارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.09,
   "end": 395.77,
   "text": "یعنی علم در ثغء ذات وجود شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.77,
   "end": 399.63,
   "text": "یعنی در وجود شما علم کاشته شده از قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 399.63,
   "end": 404.31,
   "text": "از قبل این بوده \" ولقد علمتم\" شما رو آگاهی دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.31,
   "end": 407.55,
   "text": "کجا؟ \"نشأت الأولى\" اون نشئه‌های قبلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 407.55,
   "end": 415.33,
   "text": "الان شما فقط باید اون جدول وجودیتون رو رای‌روبی کنید که وصل به دریای عمیق نواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.33,
   "end": 418.69,
   "text": "وجود است تا به اون حقایق دسترسی پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.69,
   "end": 421.31,
   "text": "بعد اینجا علامه توی کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.31,
   "end": 424.45,
   "text": "هزار و یک نکته‌شون این اصل رو پیاده می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.45,
   "end": 430.61,
   "text": "اینم گوش بدید و السلام. نفس انسانی مستعد قبول علم از جواهر عقول است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 430.61,
   "end": 434.37,
   "text": "یعنی همون عالم مفارقات. عقول، ملائکه، اسماء الله، ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.37,
   "end": 438.03,
   "text": "یعنی نفس ما به گونه‌ای است که مستعده که از ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.03,
   "end": 440.03,
   "text": "مستقیماً اخذ علم کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.03,
   "end": 442.15,
   "text": "و هیچ حجابی از جانب آنان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.15,
   "end": 443.87,
   "text": "حجاب از جانب آنان نیست یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 443.87,
   "end": 445.95,
   "text": "یعنی ملائکه حجاب نیستند که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 445.95,
   "end": 447.95,
   "text": "اونا دائماً در افاضه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.95,
   "end": 450.63,
   "text": "حجاب کجا ایجاد شده؟ حجاب از قابل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.63,
   "end": 454.17,
   "text": "ما قابلیت این رو باید داشته باشیم که اخذ علم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.17,
   "end": 459.15,
   "text": "یعنی غبار گناه رو نفس ما نشسته نمی‌ذاره این ارتباط برقرار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 459.15,
   "end": 463.75,
   "text": "چون حجاب مرتفع شود و نفس به صفت تخلیه متصف شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 463.75,
   "end": 467.43,
   "text": "یعنی تخلیه کنه اون زشتی‌ها و قضارات وجودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 467.43,
   "end": 474.95,
   "text": "مقام تهلیه که متحلی شدن به حقایق و انوار ملکوتی است برای او حتم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 474.95,
   "end": 479.95,
   "text": "یعنی قطعاً، قطعاً اگر کسی تخلیه کرد به تهلیه بعدم تجلیه می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 479.95,
   "end": 485.47,
   "text": "تخلیه کرد یعنی چی؟ یعنی وجودش رو از قضارات، آلودگی‌ها، کثافات، خباث، خبائث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.47,
   "end": 487.79,
   "text": "زشتی‌ها حفظ کنه. تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 487.79,
   "end": 494.75,
   "text": "چنین کسی متصل می‌شه به انوار ملکوت حتی در ادامه بعد علامه حالا حدیثی میگن دیگه فرصت نیست بین دو نماز هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 494.75,
   "end": 499.27,
   "text": "خیلی شیرین که اصلاً چنین کسی دیگه نیاز نداره تو خواب اخذ علم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.27,
   "end": 508.21,
   "text": "در بحر برزخ یا م-- اون عالم مثال متصلش که در خودشه علم رو اخذ کنه، بیرون اخذ می‌کنه، بیرون از خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.21,
   "end": 513.61,
   "text": "و اصلاً یکی از صفات مردان روزگار اینه که خواب دیدنشون کم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 513.61,
   "end": 515.87,
   "text": "حالا اینم راه‌هایی داره انشاالله به موقعش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 515.87,
   "end": 518.29,
   "text": "انشاالله که عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 518.29,
   "end": 523.09,
   "text": "به برکت محبت به آقا حضرت علی اکبر صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 523.09,
   "end": 525.55,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}