 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ دوم؛ صحیفهٔ خود و بهره‌مندی از کتاب‌ها",
   "start": 7.0,
   "end": 109.94
  },
  {
   "index": 1,
   "title": "### دعای معرفت و سلسلهٔ شناخت",
   "start": 109.94,
   "end": 183.56
  },
  {
   "index": 2,
   "title": "### حدیث صورت انسانیه در تفسیر صافی",
   "start": 183.56,
   "end": 350.82
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 4.24,
   "text": "سلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.24,
   "end": 7.0,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.0,
   "end": 11.18,
   "text": "کلمه دوم از صد کلمه معرفت نفس از تلنامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.18,
   "end": 16.54,
   "text": "می‌فرمایند که آن که از صحیفه خود آگاهی ندارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.54,
   "end": 20.18,
   "text": "از کدام کتاب و رساله ترفی می‌بندد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.18,
   "end": 24.76,
   "text": "کسی که از صحیفه و کتاب وجودی خودش معرفت نفس نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.76,
   "end": 32.48,
   "text": "نمی‌شناسه خودش رو، دیگه از خواندش و خواندن و کـ-- عرض شود خوانش چه کتابی بره- بهره می‌بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.48,
   "end": 36.4,
   "text": "ترفی می‌بنده. خب ببینید یه وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.4,
   "end": 40.02,
   "text": "ما میایم اینجا اثر دیگران رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.02,
   "end": 42.92,
   "text": "خب خیلیا شرح دادن این جمله رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.92,
   "end": 44.94,
   "text": "نگاه می‌کنیم تقلیدی عمل می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.94,
   "end": 47.82,
   "text": "میایم مثلاً از نظرات دیگه همونو بیان می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.82,
   "end": 51.8,
   "text": "این یک کاره. ولی خب این سر سفره دیگران نشستن و تقلیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.8,
   "end": 57.12,
   "text": "بهترینه که خودمون ببینیم از این حدیث چی برداشت، از این جمله چی برداشت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.12,
   "end": 59.38,
   "text": "ما این رو چون از لسان یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.38,
   "end": 64.4,
   "text": "انسان جامع الاطرافی دراومده اصل می‌گیریم ثابت شده، خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.4,
   "end": 67.76,
   "text": "این رو فرض می‌گیریم ثابت شده و درباره‌ش فکر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.76,
   "end": 74.02,
   "text": "شما فکر کنید. می‌فرماید کسی که کتاب خودش رو نخونده چگونه از کتاب‌های دیگران بهره بگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.02,
   "end": 76.4,
   "text": "یعنی چی؟ فکرتونو به کار بندازید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.4,
   "end": 78.88,
   "text": "من خودم وقتی هرچی نشستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.88,
   "end": 82.14,
   "text": "یک ساعت حدوداً درباره‌ش فکر کردم به این نتیجه رسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.14,
   "end": 85.3,
   "text": "پس این کتاب وجود ما اصله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.3,
   "end": 89.26,
   "text": "کتاب‌های بیرون از ما فرع‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.26,
   "end": 94.18,
   "text": "درست شد؟ که میگه اگه اینو نخوندی از خوندن اونا چی حاصل می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.18,
   "end": 97.08,
   "text": "پس کتاب وجود ما اصله، اونا فرع‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.08,
   "end": 101.24,
   "text": "به یک معنا این کتاب وجود ما متنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.24,
   "end": 106.62,
   "text": "اونا شرح‌اند. این حکمه، قضاست، اونا قدرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.62,
   "end": 109.94,
   "text": "حالا می‌شه آدم بره سراغ فرع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.94,
   "end": 112.56,
   "text": "در حالی که از اصل بی‌خبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.56,
   "end": 115.78,
   "text": "می‌شه به شما بیان شرحو بدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.78,
   "end": 119.18,
   "text": "شرح چی در حالی که متن رو نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 119.18,
   "end": 122.26,
   "text": "اندازه رو بدن در حالی که حکم و قضا رو نداری، یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.26,
   "end": 124.1,
   "text": "هاج و واج می‌مونی. توجه کردید چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 124.1,
   "end": 127.66,
   "text": "به همین راحتی متوجه اهمیت می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 127.66,
   "end": 130.68,
   "text": "یا من خودم داشتم فکر می‌کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 130.68,
   "end": 132.54,
   "text": "خدا بالاخره القا می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 132.54,
   "end": 136.2,
   "text": "یادم افتاد از اون دعای مخصوص این ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 136.2,
   "end": 137.88,
   "text": "مخصوص ایام آخر زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 137.88,
   "end": 144.42,
   "text": "\"الله معرفنی نفسك فانک ان لم تعرفنی نفسك لم اعرف رسولک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 144.42,
   "end": 148.42,
   "text": "تا آخر. ببینید اینا چگونه به هم متصل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 148.42,
   "end": 154.06,
   "text": "خدایا اگه نفس خودت رو به من شناسایی دادی، من پیغمبرتو می‌شناسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 154.06,
   "end": 159.04,
   "text": "پیغمبرتو شناسایی دادی، حجتت رو و اگر حجتت رو نشناختم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 159.04,
   "end": 161.74,
   "text": "ولت و اندینی. اینا در طول هم‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 161.74,
   "end": 165.92,
   "text": "شناخت خدا می‌شه شناخت رسول، می‌شه شناخت حجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 165.92,
   "end": 168.94,
   "text": "این از این. از این طرف داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 168.94,
   "end": 172.94,
   "text": "\"من عرف نفسه فقد عرف ربه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 172.94,
   "end": 175.16,
   "text": "کسی که نفسش رو شناخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 175.16,
   "end": 181.84,
   "text": "پروردگارش رو شناخته. خب پروردگارو کسی شناخت می‌شد شناخت پیغمبر و شناخت امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 181.84,
   "end": 185.24,
   "text": "حالا کسی که نفسش رو شناخت، پروردگارو شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 185.24,
   "end": 187.42,
   "text": "اینو بذار کنار اون می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 187.42,
   "end": 194.9,
   "text": "اگر کسی نفسش رو شناخت، در نتیجه پروردگارش رو شناخته، در نتیجه رسول رو شناخته، در نتیجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 194.9,
   "end": 197.66,
   "text": "امام رو شناخته. حالا نقیضش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 197.66,
   "end": 202.82,
   "text": "اگر کسی معرفت نفس پیدا نکرد، کتاب وجودی خودشو نخوند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 202.82,
   "end": 205.9,
   "text": "نه خدا رو می‌شناسه، نه پیغمبرو، نه امامو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 205.9,
   "end": 208.32,
   "text": "الله اکبر. ببینید چی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 208.32,
   "end": 211.18,
   "text": "به همین راحتی وقتی شما دقت می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 211.18,
   "end": 213.66,
   "text": "اجتهاد می‌کنی با ذهنت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 213.66,
   "end": 215.9,
   "text": "می‌بینی عجب به چه نتایجی رسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 215.9,
   "end": 218.1,
   "text": "البته یه حدیث بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 218.1,
   "end": 222.0,
   "text": "وزینی که واقعاً ده جلسه می‌خواد روش کار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 222.0,
   "end": 225.28,
   "text": "مرحوم ملا محسن فیض از تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 225.28,
   "end": 229.42,
   "text": "صافی خدمتتون عرض می‌کنم. ذیل آیه دو سوره بقره، جلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 229.42,
   "end": 232.78,
   "text": "یک، صفحه نود و دو می‌تونید رُجوع بکنید در تفسیر صافی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 232.78,
   "end": 234.94,
   "text": "اینو گوش بدید تن‌تون بلرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 234.94,
   "end": 238.52,
   "text": "در خصوص این صورت انسانیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 238.52,
   "end": 242.28,
   "text": "نه صورت انسان. صورت انسان یعنی ظاهرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 242.28,
   "end": 245.02,
   "text": "صورت انسانیه، ببین امیرالمؤمنین چی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 245.02,
   "end": 247.96,
   "text": "یعنی اون نفست، یعنی سیرتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 247.96,
   "end": 252.28,
   "text": "\"الصورة الانسانیه هي اكبر حجج الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 252.28,
   "end": 254.54,
   "text": "بزرگ‌ترین حجت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 254.54,
   "end": 259.36,
   "text": "\"على خلقه\". یعنی شما حجت خدا بر همه خلقشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 259.36,
   "end": 263.12,
   "text": "\"هي الكتاب\". این اصلا نفس تو یه کتابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 263.12,
   "end": 266.44,
   "text": "\"هي الكتاب الذي كتبه بيده\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 266.44,
   "end": 270.98,
   "text": "بعضیا ترجمه کردن خدا به دست خودش کتاب نفس ما و شما رو نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 270.98,
   "end": 275.56,
   "text": "می‌شه اینطوری هم ترجمه کرد که ما به دست خودمون داریم کتاب خودمون رو می‌نویسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 275.56,
   "end": 279.4,
   "text": "\"وهي الهيكل الذي بناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 279.4,
   "end": 281.16,
   "text": "بحكمته\". الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 281.16,
   "end": 284.42,
   "text": "آخه من چی بگم؟ فرمایش مولامون علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 284.42,
   "end": 287.68,
   "text": "که این رو خدا بنا کرده به حکمتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 287.68,
   "end": 291.62,
   "text": "سر تا سر وجود تو از ظاهر و باطنت حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 291.62,
   "end": 294.84,
   "text": "\"وهي مجموع\". اینجا رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 294.84,
   "end": 297.62,
   "text": "یک مجموعه‌ای هستیم ما از چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 297.62,
   "end": 300.12,
   "text": "\"صور العالمين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 300.12,
   "end": 305.24,
   "text": "تمام صورت‌های عالم در وجود ما متنقشه، مندرجه، مندم-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 305.24,
   "end": 307.14,
   "text": "مندمجه. یعنی در ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 307.14,
   "end": 310.24,
   "text": "لذا خودت رو بشناسی، همه چی رو شناختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 310.24,
   "end": 312.48,
   "text": "\"وهي المختصر\". الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 312.48,
   "end": 316.3,
   "text": "اینجا قسمت آخرش. باور کنید من تنم می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 316.3,
   "end": 321.54,
   "text": "شماها نمی‌دونم. \"وهي المختصر من العلم في اللوح المحفوظ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 321.54,
   "end": 323.68,
   "text": "حالا لوح محفوظ خدا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 323.68,
   "end": 330.64,
   "text": "اگر متوجه باشیم بدونیم چیه، چه عظمتی داره و چه کسی اجازه داره به اونجا نگاه کنه، توجه کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 330.64,
   "end": 335.02,
   "text": "می‌فهمیم که ما یک اختصاری هستیم، مختصری هستیم از اون چکیده‌ای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 335.02,
   "end": 338.72,
   "text": "MP3 فشرده شده‌ای هستیم از لوح محفوظ خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 338.72,
   "end": 342.26,
   "text": "حالا نمی‌خوای خودمون رو بشناسیم؟ صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 342.26,
   "end": 345.88,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 345.88,
   "end": 350.82,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}