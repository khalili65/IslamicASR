   "start": 14.88,
   "end": 153.62
  },
  {
   "index": 1,
   "title": "## کلمهٔ پنجاه‌وهشتم؛ ایجاب نفس و اعداد بدن",
   "start": 153.62,
   "end": 305.52
  },
  {
   "index": 2,
   "title": "## رغبت به بدن زنده و اشمئزاز از جسد",
   "start": 305.52,
   "end": 426.17
  },
  {
   "index": 3,
   "title": "## النوم أخو الموت؛ حرکت نفس در خواب",
   "start": 426.17,
   "end": 461.43
  },
  {
   "index": 4,
   "title": "## من عرف نفسه فقد عرف ربه؛ رب و ارباب",
   "start": 461.43,
   "end": 573.01
  },
  {
   "index": 5,
   "title": "## مثال کشتی؛ حرکت بالذات و بالعَرَض",
   "start": 573.01,
   "end": 758.89
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.96,
   "end": 5.66,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.66,
   "end": 9.9,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.9,
   "end": 14.88,
   "text": "آياته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.88,
   "end": 18.94,
   "text": "شب بسیار با عظمتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.94,
   "end": 22.52,
   "text": "بزرگان یک سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.52,
   "end": 30.36,
   "text": "تلاش کردن، زحمت کشیدند تا یه همچین شبی رو درک کنن و نقشه راه بریزند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.36,
   "end": 34.18,
   "text": "از حضرت حق به نیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.18,
   "end": 36.84,
   "text": "پاک و خوبشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.84,
   "end": 43.14,
   "text": "قدریه بگیرن. قدر و اندازه‌ی هر کسی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.14,
   "end": 46.5,
   "text": "وضعیت و سعه نیتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.5,
   "end": 49.96,
   "text": "اصلاً نیت المؤمن خير من عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.96,
   "end": 53.92,
   "text": "به قول رهبر عزیزمون بسیاری نیت‌هایی که ما می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.92,
   "end": 55.94,
   "text": "در عمل نمی‌تونیم پیادش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.94,
   "end": 59.02,
   "text": "همیشه اینطوری هست که نیت مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.02,
   "end": 67.32,
   "text": "بالاتر از عملشه. یه وجهش هم اینه که اصلاً بستر عمل‌سازی نیته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.32,
   "end": 71.68,
   "text": "و قدر و اندازه‌ی هر کسی به شکل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.68,
   "end": 74.26,
   "text": "به شاکله‌ی نیتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.26,
   "end": 78.2,
   "text": "لذا امشب نیت‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.2,
   "end": 80.1,
   "text": "نیت‌ها بستر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.1,
   "end": 84.86,
   "text": "تقدیراته. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.86,
   "end": 91.04,
   "text": "اون‌هایی که امشب تقدیر من و شما رو رقم می‌زنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.04,
   "end": 93.9,
   "text": "نیت‌های من و شما رو می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.9,
   "end": 97.5,
   "text": "این خیلی مهمه که نیت ما چی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.5,
   "end": 102.6,
   "text": "انقدر امشب مهمه که حضرت صدیقه طاهره سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.6,
   "end": 106.4,
   "text": "بچه‌ها رو آب می‌زد به صورتشون که نخوابن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.4,
   "end": 112.86,
   "text": "حتی بچه‌ها رو. چون احیاش اصلاً موضوعیت داره، بیدار بودنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.86,
   "end": 116.98,
   "text": "اما در خصوص اون دو شب قبل نوزدهم و بیست و یکم این روایت وارد نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.98,
   "end": 119.82,
   "text": "بیست و سوم این روایت وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.82,
   "end": 124.36,
   "text": "خب یکی از-- اینکه اشتباهه است بگیم یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.36,
   "end": 130.9,
   "text": "بلکه فرمودن بهترین کار در شب قدر پیغمبر عزیز عالم به امر مولی فرمودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.9,
   "end": 138.1,
   "text": "فرمودن چیه؟ کسب معرفت و علم و دانش و مباحثه علمی و تفکر و تعقل و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.1,
   "end": 145.7,
   "text": "بهترین کار امشب اینه که در انسان حرکت ایجاد کنه، حرکت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.7,
   "end": 152.32,
   "text": "برای همین هم انشاالله سر سفره‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.32,
   "end": 161.08,
   "text": "صد کلمه در معرفت علامه یه چیزکی به معرفتمون اضافه بشه کلمه پنجاه و هشت رو با هم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 161.08,
   "end": 163.18,
   "text": "آن که در کار نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 163.18,
   "end": 168.48,
   "text": "و بدن درست اندیشه کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 168.48,
   "end": 174.66,
   "text": "یعنی تو نگاه کنی، دقت کنی به کار نفس و بدن، به این دو تا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 174.66,
   "end": 178.18,
   "text": "آن دو را در ایجاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 178.18,
   "end": 185.56,
   "text": "اعداد متعاکس یابد، عکس هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 185.56,
   "end": 189.48,
   "text": "که از آن سوی ایجاب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 189.48,
   "end": 195.68,
   "text": "و از این سوی اعداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 195.68,
   "end": 198.04,
   "text": "یعنی این دامنه اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 198.04,
   "end": 200.74,
   "text": "اگرچه کثرت داره بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 200.74,
   "end": 203.04,
   "text": "حالا این رو من یه توضیح کوچولویی بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 203.04,
   "end": 207.52,
   "text": "یعنی چی نفس ایجاب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 207.52,
   "end": 212.02,
   "text": "و بدن کارش اعداده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 212.02,
   "end": 217.0,
   "text": "یعنی اینکه همه کاره مملکت بدن ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.0,
   "end": 221.22,
   "text": "همین وجود ما، حالا بدن نه، وجود ما، اعم از ظاهر و باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 221.22,
   "end": 227.76,
   "text": "همه کارش نفسه. این که میگه ایجاب از نفسه یعنی همه کاره نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 227.76,
   "end": 236.08,
   "text": "بدن مرتبه اعدادیه، علت معده‌ست، حامله نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 236.08,
   "end": 241.02,
   "text": "به نظر شما چشم داره می‌بینه یا نفس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 241.02,
   "end": 243.4,
   "text": "پا داره حرکت می‌کنه یا نفس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 243.4,
   "end": 245.76,
   "text": "اراده نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 245.76,
   "end": 249.4,
   "text": "یا پا خودش به خودیا خودش داره راه میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 249.4,
   "end": 252.84,
   "text": "قطعاً همه میگید نفسه، نفس اراده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 252.84,
   "end": 256.56,
   "text": "nefsi که می‌بینه، می‌شنوه، می‌چشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 256.56,
   "end": 258.72,
   "text": "اگر نفس رو برداری چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 258.72,
   "end": 265.58,
   "text": "همونطور که حجت رو برداری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 265.58,
   "end": 271.56,
   "text": "یعنی حجت رو برداری از رو زمین لساخت الأرض بأهلها لول الحجة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 271.56,
   "end": 275.68,
   "text": "زمین ارزش همه اه-اهل ارض رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 275.68,
   "end": 282.14,
   "text": "می‌بلعه. همین‌طور نفس ناطقه رو اگه شما برداری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 282.14,
   "end": 286.12,
   "text": "مملکت وجود می‌پاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 286.12,
   "end": 292.32,
   "text": "می‌شه چی؟ می‌شه میته. یه آدمی که میته دیگه، دیگه اسم هم روش نمی‌ذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 292.32,
   "end": 296.28,
   "text": "نه میگن فلانی رو آوردن، میگن جسد و بدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 296.28,
   "end": 299.58,
   "text": "جسم و جسد و جسد رو بردارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 299.58,
   "end": 302.4,
   "text": "اسم دیگه بهش نمیگن که. تموم شد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 302.4,
   "end": 304.72,
   "text": "این جسد پاچید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 304.72,
   "end": 308.26,
   "text": "ببین وقتی که تا وقتی که روح یا همون نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 308.26,
   "end": 312.94,
   "text": "نفس مرتبه تعلق روح به بدنه بهش میگن نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 312.94,
   "end": 319.04,
   "text": "اون روح تو بدن هست یا اون نفس در بدن هست این نفس ببین چقدر زیباست این بدن، این بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 319.04,
   "end": 323.5,
   "text": "چقدر دیدنیه. خودت به بدن خودت رغبت داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 323.5,
   "end": 327.84,
   "text": "دوست داری اصلاً تو آینه کیف می‌کنی خودت رو می‌بینی، موهات رو شونه می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 327.84,
   "end": 331.22,
   "text": "لباس قشنگ می‌پوشی، ژست می‌گیری، تیپ می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 331.22,
   "end": 339.1,
   "text": "درسته؟ این بدن رو. به محض اینکه این نفس ناطقه اعلام انصراف از بدن میده یعنی مرگ حاصل می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 339.1,
   "end": 343.26,
   "text": "بدن رها می‌شه، خودت هم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 343.26,
   "end": 350.22,
   "text": "حالت اشمئزاز پیدا می‌کنی بخوای به بدن متلاشی شده خودت در قبر نگاه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 350.22,
   "end": 357.68,
   "text": "چه برسه دیگران. دیگران هم میگن زود زودش، زودش سریع ت-دفنش کنید چند مترم خاک بکنون ته ته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 357.68,
   "end": 360.88,
   "text": "اصلاً این بو گند این بدن داره حال منو به هم میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 360.88,
   "end": 368.11,
   "text": "اتفاقاً عجیبه که در بین همه موجودات بدترین بو تعفن رو بدن انسان داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 368.11,
   "end": 372.05,
   "text": "حالا چگونه این مزاج تشکیل شده عناصر اربعه چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 372.05,
   "end": 376.21,
   "text": "اون اخلاط اربع رو تشکیل دادند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 376.21,
   "end": 381.47,
   "text": "منتج شده به مطیه اولای بدن که روح بخاریه و نفس از طریق اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 381.47,
   "end": 384.89,
   "text": "احکامش رو در بدن ایجاد میکنه که البته اون روح نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 384.89,
   "end": 387.95,
   "text": "روح بخاری الطف اجسام خودش جسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 387.95,
   "end": 392.95,
   "text": "اونم حالا به یک معنا روحه، عروقه، همون خون انسانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 392.95,
   "end": 397.57,
   "text": "که نفس از طریق این خون گرما رو به بدن انتقال میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 397.57,
   "end": 400.83,
   "text": "یعنی حیات و زندگی رو، حرکت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 400.83,
   "end": 404.11,
   "text": "که اگر گرما نباشه اصلا حرکت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 404.11,
   "end": 408.47,
   "text": "همون انرژیه. این وقتی گرفته میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 408.47,
   "end": 411.25,
   "text": "چقدر حالت زشتی به انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 411.25,
   "end": 414.37,
   "text": "شما حساب کن یکی چشمش ترکیده ریخته تو صورتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 414.37,
   "end": 418.27,
   "text": "اصلا میتونی نگاش کنی؟ تو قبر همین حالت پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 418.27,
   "end": 424.37,
   "text": "و قراره پیش بیاد. این نشون میده که همه کارا نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 424.37,
   "end": 429.07,
   "text": "اصلا نه، وقتی ما می‌خوابیم \"ان النوم اخو الموت\" وقتی می‌خوابیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 429.07,
   "end": 433.25,
   "text": "خب این بدن اینجا افتاده. چند کیلو بدن اینجا افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 433.25,
   "end": 438.85,
   "text": "شما مسافت‌ها طی کردی رفتی از این شهر به اون شهر رفتی انشاالله زیارت برگشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 438.85,
   "end": 441.71,
   "text": "خب این بدن که اینجاست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 441.71,
   "end": 445.19,
   "text": "با چی رفتی؟ نفس داره حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 445.19,
   "end": 447.25,
   "text": "این نفسه که حرکت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 447.25,
   "end": 449.23,
   "text": "اما خب اونجا با بدن برزخی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 449.23,
   "end": 452.39,
   "text": "دیگه کاری به این بدن نداره. این بدن اینجا افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 452.39,
   "end": 455.51,
   "text": "خود شما هر شب اینو دارید تجربه می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 455.51,
   "end": 460.89,
   "text": "پس این که اینجا داره می‌فرماید علت ایجاب یعنی همه کار نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 460.89,
   "end": 466.03,
   "text": "حالا من بر اساس حدیث \"من عرف، من عرف نفسه فقط عرف ربه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 466.03,
   "end": 469.33,
   "text": "نفستو دیدی پاییدی؟ حالا بفرمایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 469.33,
   "end": 472.11,
   "text": "فقط عرف ربه. رب همچنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 472.11,
   "end": 475.47,
   "text": "ما ارباب داریم. رب‌های متنوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 475.47,
   "end": 478.55,
   "text": "رب النوع. ارباب انواع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 478.55,
   "end": 480.45,
   "text": "افلاطون بهش میگه چی؟ مثل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 480.45,
   "end": 485.09,
   "text": "رساله مثل هست. یعنی همین ملائکت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 485.09,
   "end": 488.69,
   "text": "ملائکه رب مثلا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 488.69,
   "end": 491.83,
   "text": "آنچه که وجود دارد رب دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 491.83,
   "end": 495.67,
   "text": "البته رب العالمين رب همه اوناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 495.67,
   "end": 498.05,
   "text": "الحمدلله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 498.05,
   "end": 501.01,
   "text": "او رب همه است. پرورش دهنده اربابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 501.01,
   "end": 503.29,
   "text": "اما من و شما هر کدوممون یه رب داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 503.29,
   "end": 507.11,
   "text": "یه پرورش دهنده داریم. یه ملکی موکل ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 507.11,
   "end": 512.07,
   "text": "همونطور که دریا موکل داره، جنگل موکل داره، زمین داره، آسمان داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 512.07,
   "end": 519.07,
   "text": "اصلا خود جسم کل همین زمین رو، کل هیکل زمین رو گفتن خودش یه حیوانه اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 519.07,
   "end": 522.93,
   "text": "و \"ان الدار الآخرة لهی الحيوان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 522.93,
   "end": 524.93,
   "text": "یعنی اصلا حی- حیات اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 524.93,
   "end": 528.25,
   "text": "ولی اینجا هم یه رشده‌ای، یه آیه‌ای از اون حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 528.25,
   "end": 532.47,
   "text": "چقدر رستنی در همین زمین رشد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 532.47,
   "end": 537.11,
   "text": "چقدر نباتات. اصلا \"نساکم حرف لكم\" یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 537.11,
   "end": 539.29,
   "text": "زنان شما، زمین کشاورز شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 539.29,
   "end": 543.15,
   "text": "اصلا این زمین کشاورز، این زمینه، زمین کشاورزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 543.15,
   "end": 545.11,
   "text": "چقدر نباتات ازش بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 545.11,
   "end": 550.35,
   "text": "اصلا خود انسان که ابتدا جسمانیة حدوثه از آب و نانی که پدر و مادر خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 550.35,
   "end": 553.57,
   "text": "نطفه انسان جمادیه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 553.57,
   "end": 556.11,
   "text": "خاکه. اصلا خود ما خاک بودیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 556.11,
   "end": 560.45,
   "text": "همه همینطور. پس خلاصه مطلب اینکه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 560.45,
   "end": 563.45,
   "text": "حتی زمین هم رب دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 563.45,
   "end": 566.45,
   "text": "یه ملک موکلی داره که پرورشش می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 566.45,
   "end": 570.91,
   "text": "اما همه اینا علت تامه و اصلی نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 570.91,
   "end": 573.01,
   "text": "علت ایجابی نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 573.01,
   "end": 577.55,
   "text": "اینا معدات‌اند. علت اصلی حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 577.55,
   "end": 580.19,
   "text": "میگه \"من عرف نفسه فقط عرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 580.19,
   "end": 585.77,
   "text": "ربه\". همونطور که نفس خودت رو دقت کردی دیدی همه کاره نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 585.77,
   "end": 588.99,
   "text": "بدن که ظاهر وجود شماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 588.99,
   "end": 592.91,
   "text": "یک مرکبه که بتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 592.91,
   "end": 598.21,
   "text": "نفس ما رو به سمت سعادت و تعالی و کمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 598.21,
   "end": 600.59,
   "text": "سوق بده. که اتفاقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 600.59,
   "end": 604.51,
   "text": "از جمله مقربات همین انصراف و انقضاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 604.51,
   "end": 608.13,
   "text": "قطعات زمانه. که بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 608.13,
   "end": 611.59,
   "text": "نفس رو می‌بره به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 611.59,
   "end": 613.49,
   "text": "اون چیزی که به کمال می‌رسونتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 613.49,
   "end": 615.59,
   "text": "به سمت فاعلیت عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 615.59,
   "end": 618.77,
   "text": "که مقرب میشه بدن نفس رو میبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 618.77,
   "end": 621.15,
   "text": "حالا این بدن رو بگیر. همیشه بدن داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 621.15,
   "end": 625.11,
   "text": "بدن برزخی. بعد از عالم برزخ باز بدن داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 625.11,
   "end": 627.59,
   "text": "همینجوری بدن هست پشت بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 627.59,
   "end": 629.75,
   "text": "چون اون‌ها نفس رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 629.75,
   "end": 633.15,
   "text": "مطیه‌اند. مثل شتر راهواری‌اند که نفس رو می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 633.15,
   "end": 637.13,
   "text": "خلاصه یه مثال بزنم برای بهتر فهمیدن این موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 637.13,
   "end": 639.33,
   "text": "آدم‌هایی که سوار کشتی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 639.33,
   "end": 646.39,
   "text": "کشتی داره حرکت می‌کنه. آدم‌هام داخل کشتی بلاعرض دارن حرکت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 646.39,
   "end": 649.69,
   "text": "الان به نظر شما حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 649.69,
   "end": 651.99,
   "text": "مخصوص کشتیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 651.99,
   "end": 658.17,
   "text": "یعنی تعلق به کشتی پیدا می‌کنه حرکت اینجا یا به آدم‌هایی که توشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 658.17,
   "end": 663.13,
   "text": "کشتی داره حرکت می‌کنه. میشه گفت آدم‌ها هم حرکت نمی‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 663.13,
   "end": 664.95,
   "text": "چرا اونام دارن حرکت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 664.95,
   "end": 667.87,
   "text": "اما اصل حرکت به کدوم برمی‌گرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 667.87,
   "end": 670.27,
   "text": "یعنی ایجاب حرکت به کدومه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 670.27,
   "end": 672.69,
   "text": "به کشتیه، به سفینه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 672.69,
   "end": 678.53,
   "text": "اونایی که سوارش‌اند اون‌ها ایجابی نیستن، اعدادی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 678.53,
   "end": 683.29,
   "text": "اونا، اونا هم به یک معنا دارن حرکت می‌کنن اما بلاعرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 683.29,
   "end": 688.61,
   "text": "الان متوجه میشیم. اونجا سفینه و کشتی ذاتا در حرکته، اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 688.61,
   "end": 692.01,
   "text": "همینطور تو عالم وجود ما این شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 692.01,
   "end": 697.65,
   "text": "خلاصه این کلمه علامه داره این رو به ما یاد میده که بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 697.65,
   "end": 701.21,
   "text": "علت تو مملکت وجودمون، علت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 701.21,
   "end": 707.99,
   "text": "اصلی و ایجابی که حرکت میده همه کاره وجود ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 707.99,
   "end": 711.09,
   "text": "نفس ماست، روح ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 711.09,
   "end": 714.23,
   "text": "بدن علت اعدادیه یعنی معده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 714.23,
   "end": 716.55,
   "text": "علت معده است. علت تامه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 716.55,
   "end": 719.87,
   "text": "متاسفانه، متاسفانه، متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 719.87,
   "end": 723.25,
   "text": "غالب ما مردم به این بدنه داریم می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 723.25,
   "end": 726.31,
   "text": "به ظاهر. به این پوسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 726.31,
   "end": 731.49,
   "text": "و غافل از اون باطنیم. کارهایی هم که می‌کنیم غالبا میخواد به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 731.49,
   "end": 734.89,
   "text": "ظاهره برسه. اصلا از باطن غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 734.89,
   "end": 738.07,
   "text": "امشب شب ارتباط ظاهر با باطن عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 738.07,
   "end": 741.09,
   "text": "حضرت روح که \"تنزل الملائکه والروح\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 741.09,
   "end": 746.19,
   "text": "تشریف میارن برای به روز رساندن آدم‌ها که ظاهر رو به باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 746.19,
   "end": 749.59,
   "text": "برسونن. انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 749.59,
   "end": 752.59,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 752.59,
   "end": 758.89,
   "text": "الله. اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}