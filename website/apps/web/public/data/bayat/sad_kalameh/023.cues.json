 "chapters": [
  {
   "index": 0,
   "title": "## حرمت ایام؛ انقلاب انفجار نور",
   "start": 9.72,
   "end": 78.34
  },
  {
   "index": 1,
   "title": "## کلمهٔ بیست‌ودو؛ اطوار خلقت",
   "start": 78.34,
   "end": 259.52
  },
  {
   "index": 2,
   "title": "## قرآن؛ وقد خلقکم أطواراً",
   "start": 259.52,
   "end": 291.84
  },
  {
   "index": 3,
   "title": "## استهزاء از معارف؛ وحشت از خویش",
   "start": 291.84,
   "end": 412.11
  },
  {
   "index": 4,
   "title": "## مرور کلمهٔ بیست‌ودو",
   "start": 412.11,
   "end": 602.15
  },
  {
   "index": 5,
   "title": "## شرک خوف از روزی",
   "start": 602.15,
   "end": 743.69
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.48,
   "end": 3.2,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.2,
   "end": 7.38,
   "text": "السلام علیک یا داعی الله و ربانی ایه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.38,
   "end": 9.72,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.72,
   "end": 13.0,
   "text": "به جهت عظمت این ایام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.0,
   "end": 17.34,
   "text": "مشرف بودن به سالگرد پیروزی این نهضت عظیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.34,
   "end": 23.16,
   "text": "من ایستاده صحبت می‌کنم به حرمت امام و شهدا و اونایی که گردن ما در احیای این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.16,
   "end": 25.28,
   "text": "حقایق حق داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.28,
   "end": 30.34,
   "text": "بله امام-- خب این بزرگان همه چیشون رو روی حساب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.34,
   "end": 36.12,
   "text": "مطرح می‌کنند. کلمه به کلمه مثل ما نیستن اینطوری جسارتا دهان باز کنن و هرچی اومد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.12,
   "end": 40.52,
   "text": "نه. ازدواج حروف و کلمات رو همه رو حساب دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.52,
   "end": 43.92,
   "text": "زوج کریمه. این ا-حروف با هم ازدواج می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.92,
   "end": 46.86,
   "text": "در لسان این‌ها زوج کریمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.86,
   "end": 49.28,
   "text": "که در قرآن ازش یاد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.28,
   "end": 51.98,
   "text": "و نوره. لذا حضرت امام وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.98,
   "end": 55.34,
   "text": "انقلاب رو می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.34,
   "end": 59.0,
   "text": "انفجار نور، اینا همه رو حسابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.0,
   "end": 62.78,
   "text": "انفجار نور. نور رو وقتی شما تو خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.78,
   "end": 66.92,
   "text": "درس و بحث‌های خود امام وقتی میری نگاه می‌کنی بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.92,
   "end": 72.24,
   "text": "نظرات، نقطه نظرات حکما و عرفا می‌بینی نور عین وجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.24,
   "end": 74.66,
   "text": "عین وجود. وجود هم که یک اصمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.66,
   "end": 81.48,
   "text": "دارم یه دوره‌ای هم می‌کنم از اونچه که این چند وقته با هم درس و بحث گرفتیم از مشرب از تعلم عليه رحمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.48,
   "end": 84.2,
   "text": "نور هم که عین وجوده. وجود هم که اصمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.2,
   "end": 87.28,
   "text": "یک وجود بیش نیست. بقیه اتوار اون وجودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.28,
   "end": 90.24,
   "text": "یعنی طورهای مختلف اون وجودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 90.24,
   "end": 92.54,
   "text": "یک وجود بیش نیست. اون هم اصمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 92.54,
   "end": 94.58,
   "text": "الله صمد. تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 94.58,
   "end": 100.06,
   "text": "من و شما یک طوری. حالا خود همین اتوار وجودی حق که همه عالم‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 100.06,
   "end": 103.14,
   "text": "هر کدومشون هم طورهای مختلفی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.14,
   "end": 108.4,
   "text": "طورهای مختلف. حالا امام می‌فرمود که این انقلاب انفجار نور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 108.4,
   "end": 112.52,
   "text": "یعنی چی؟ یعنی یک طور از اتوار وجودی حق بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 112.52,
   "end": 117.78,
   "text": "خدا تجلی کرد. کل یوم هو فی شأن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.78,
   "end": 121.82,
   "text": "آن و فآن خدا در تجلی خاصی هو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 121.82,
   "end": 128.04,
   "text": "در تجلی خاصه یک تجلی بسیار با عظمت خدا و نوریه خدا هم همین انقلاب بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.04,
   "end": 132.14,
   "text": "اتفاقا بحث ما برخورد می‌کنه به ادامه موضوع صد کلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.14,
   "end": 135.34,
   "text": "کلمه بیست و دو رسیده بودیم ببینید چه زیبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.34,
   "end": 138.94,
   "text": "علامه می‌فرماید آنکه در اتوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.94,
   "end": 143.0,
   "text": "جمع طوره. آنکه از اتوار خلقتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.0,
   "end": 146.38,
   "text": "آنکه در اتوار خلقتش نمی‌اندیشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.38,
   "end": 149.4,
   "text": "سودای او سراسر زیان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.4,
   "end": 155.1,
   "text": "یعنی ما نیاز داریم که به اتوار یعنی طورهای مختلف خلقتمون بیندیشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.1,
   "end": 160.2,
   "text": "ما یه طورمون الان همین طور دنیایی ماست که خودش طور در طوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.2,
   "end": 162.34,
   "text": "یه طورمون وقتی بود که در جنین بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.34,
   "end": 167.74,
   "text": "اومدیم طورمون عوض شد. وقتی می‌میریم موت اصلا یعنی عوض شدن طور وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 167.74,
   "end": 170.52,
   "text": "میریم به عالم برزخ و طور برزخی پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 170.52,
   "end": 176.86,
   "text": "بعد طورهایی الا ما شاء الله پشت که مرحوم علامه طباطبایی در تفسیر کبیر الکفایه شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.86,
   "end": 178.96,
   "text": "می‌فرماید این اتوار در طول هم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.96,
   "end": 183.9,
   "text": "یعنی چی در طول هم‌اند؟ یعنی همین الان هم شما طور برزخی داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.9,
   "end": 186.9,
   "text": "ازش بی‌خبری. یعنی چی طور برزخی داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.9,
   "end": 189.42,
   "text": "مگه بدن برزخی نداری؟ بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 189.42,
   "end": 193.54,
   "text": "کجا؟ تو خواب. به همین راحتی قابل فهم و درکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 193.54,
   "end": 198.82,
   "text": "یعنی ما تو خواب با یک بدن دیگه‌ای، این بدن که اینجا افتاده خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.82,
   "end": 200.58,
   "text": "هیچ حرکتی نداره. با کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 200.58,
   "end": 204.86,
   "text": "با چی ما میریم اینور اونور تو خواب در عالم خیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 204.86,
   "end": 211.12,
   "text": "حالا مثال منفصل یا متصل هر کجا که زورمون برسه برسیم حداقل متصل که در درون خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.12,
   "end": 215.32,
   "text": "اون بدن برزخی ماست که الان هم با ماست منتها کمرنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.32,
   "end": 219.24,
   "text": "چون عنایت نفس الان به این بدنه، این بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.24,
   "end": 221.8,
   "text": "خودش رو داره نشون میده. بعد تو خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 221.8,
   "end": 227.14,
   "text": "توجه نفس از این بدن برداشته می‌شه به اون بدن مثالی لذا اون حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.14,
   "end": 233.4,
   "text": "اینکه ابدال و بزرگان به قول علامه بدن در بدن انشا می‌کنند نه اینکه الان نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.4,
   "end": 235.72,
   "text": "هیچ اصلا نبوده و الان انشا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.72,
   "end": 238.72,
   "text": "این هم یک معناشه اما انشا در طول انشائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.72,
   "end": 241.8,
   "text": "یعنی مثل اینکه الان بدن مثالی شما هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.8,
   "end": 246.78,
   "text": "توجه نفس بهش نیست و یک طور وجودی ما بدن مثالی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 246.78,
   "end": 251.46,
   "text": "همینطور شما هر وقت بخواهی می‌تونی بدن انشا کنی همان که بزرگان کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 251.46,
   "end": 257.36,
   "text": "این طور وجودی ماست. اتفاقا چه جالب که در آیه قرآن، آیه سیزده و چهارده سوره نوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.36,
   "end": 259.52,
   "text": "همین موضوع اومده. قرآن داریم می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.52,
   "end": 262.74,
   "text": "حکما و عرفا بی‌توجه به قرآن حرف نمی‌زنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.74,
   "end": 266.54,
   "text": "دقت کنید. \"مالکم لا ترجون لله وقارا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.54,
   "end": 270.26,
   "text": "یعنی چرا شما برای خود امید به ثبات در ربوبیتش ندارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.26,
   "end": 273.24,
   "text": "چتونه شما؟ مالکم. چتون شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.24,
   "end": 277.0,
   "text": "بعد می‌فرماید \"و قد خلقکم اتوارا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.0,
   "end": 280.4,
   "text": "خدا شما رو به طورهای مختلف خلق کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.4,
   "end": 284.56,
   "text": "که این طورها رو وقتی ازش حرف می‌زنی، اوه، اوه این آقا چی داره-- این حاج آقا چی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 284.56,
   "end": 287.42,
   "text": "این مثلا علامه حسن زاده این حرفا رو از کجا در آورده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 287.42,
   "end": 291.48,
   "text": "تو قرآنه. اینا یه موقع. اتوار و طورهای مختلف شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.48,
   "end": 293.98,
   "text": "حالا چرا ما از این حرفا می‌ترسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.98,
   "end": 297.28,
   "text": "چرا؟ علتش چیه؟ استهزاءش داریم به قول علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 297.28,
   "end": 302.2,
   "text": "من همین امروز چندین بار البته این صوت علامه رو گوش دادم، کیف کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.2,
   "end": 308.54,
   "text": "امروز دیدم چه جالب مربوط، مرتبط با بحث است از رو خود کلام علامه رو پیاده کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.54,
   "end": 310.66,
   "text": "نوشتم ببینید چی داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.66,
   "end": 315.04,
   "text": "علامه حسن زاده این انسانه و عالم جامع الاطراف داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.04,
   "end": 317.14,
   "text": "یه بچه طلبه‌ای مثل من نمیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.14,
   "end": 323.82,
   "text": "اگر خواستید رجوع کنید به تفصیل بحث درس هفتاد و هشت شرح فصوص الحکم ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.82,
   "end": 328.06,
   "text": "اینجا هم اوائل دقیقه ده به بعد شروع می‌کنه علامه اینطور می‌فرماید:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.06,
   "end": 331.04,
   "text": "مردم استهزایی که دارن یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 331.04,
   "end": 334.28,
   "text": "می‌ترسن از این حقایق، از این معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 334.28,
   "end": 337.06,
   "text": "می‌ترسن. از این حرف‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.06,
   "end": 339.8,
   "text": "خوب صبر و تقسیم بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.8,
   "end": 342.74,
   "text": "این استهزاءش که از این حرفا دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.74,
   "end": 345.6,
   "text": "می‌بینید آقا وحشتشون از خودشان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.6,
   "end": 348.74,
   "text": "عین کلام علامه رو نوشتم. وحشتشون از کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.74,
   "end": 351.88,
   "text": "از خودشان است. از ضعف خودشان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 351.88,
   "end": 354.3,
   "text": "خودشان ضعیف‌اند. قوی نشدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 354.3,
   "end": 356.84,
   "text": "به راه نیفتادند. استاد ندیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 356.84,
   "end": 360.04,
   "text": "ریاضت نکشیدند. شکم‌باره هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 360.04,
   "end": 365.61,
   "text": "قدر شب و روز و عمر را ندانستند و این کارخانه بزرگ الهی را به هم زدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 365.61,
   "end": 368.01,
   "text": "و به صفات حیوانی خو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 368.01,
   "end": 369.93,
   "text": "اسیر اصطبل و علف شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 369.93,
   "end": 372.69,
   "text": "یعنی فقط همشون شد شکمشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 372.69,
   "end": 379.23,
   "text": "بعد ادامه میدن یک شکمبه‌ای را پر کنند و خالی کنند و اینجور چیزها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 379.23,
   "end": 386.27,
   "text": "این است که وقتی، وقتی به مقامات و کرامات انسان‌های بزرگ می‌رسند می‌بینی وحشت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 386.27,
   "end": 389.25,
   "text": "مگه میشه اینطور، اینطور باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 389.25,
   "end": 392.61,
   "text": "این وحشت از خودش است. بعد اشاره کرد ایشون به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 392.61,
   "end": 398.45,
   "text": "شیخ الرئیس که ایشون فرمودند که اگر می‌بینید مردم می‌ترسند، این ترس از وجود خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 398.45,
   "end": 405.71,
   "text": "چون بی‌خبرند، بی‌خردند، عقلشون رو تعطیل کردند و معذرت می‌خوام از شما فرهیخته‌اید اینجا رسانه ملیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 405.71,
   "end": 408.47,
   "text": "و توجه به اون عقلانیت وجودشون نکردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 408.47,
   "end": 412.11,
   "text": "صرفا حیوانی زندگی کردند، می‌ترسند از این حرف‌ها فرار می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 412.11,
   "end": 416.65,
   "text": "در صورتی که حالا ادامه دارد صحبت علامه که می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 416.65,
   "end": 418.81,
   "text": "و الا حالا چرا می‌ترسند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 418.81,
   "end": 422.81,
   "text": "و الا دم حال-- تا حالا دم به دم مرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 422.81,
   "end": 426.85,
   "text": "و زنده شدند. چطور از این مردن‌ها وحشت ندارند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 426.85,
   "end": 430.81,
   "text": "از این مردن‌ها. یعنی الان تو دم به دم داری می‌میری زنده میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 430.81,
   "end": 433.87,
   "text": "یا تو عالم جنین که بودی یه طور بودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 433.87,
   "end": 436.55,
   "text": "طورت عوض شد اومدی به دنیا همه خوشحالی کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 436.55,
   "end": 438.63,
   "text": "چطور وقت مرگ ناراحتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 438.63,
   "end": 443.51,
   "text": "چرا می‌ترسی تو؟ حرف از دم از مرگ زده میشه می‌ترسی رنگ و رود عوض میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 443.51,
   "end": 450.93,
   "text": "چون از خودت می‌ترسی. چون قراره با خودت محشور بشی و اشاره می‌کنم به حدیث شریفِ \"انما تنتقلون من دارٍ الى دار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 450.93,
   "end": 453.79,
   "text": "پیغمبر. پیغمبر فرمود اصلاً همینه و الا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 453.79,
   "end": 457.15,
   "text": "غیر. شما منتقل می‌شید از داری به دار دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 457.15,
   "end": 461.29,
   "text": "اشاره می‌کنم اینجا چون ایشون می‌فرما ترس از خوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 461.29,
   "end": 463.79,
   "text": "بزرگان اگر نمی‌ترسند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 463.79,
   "end": 466.41,
   "text": "چون خودشونو پیدا کردند. من یادم افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 466.41,
   "end": 469.23,
   "text": "اینم تقدیم کنم هدیه بالاخره ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 469.23,
   "end": 472.95,
   "text": "دهه فجرم هست. یه جمله امام داره علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 472.95,
   "end": 476.09,
   "text": "حضرت آقای بهائ‌الدینی فرمودند این معجزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 476.09,
   "end": 478.69,
   "text": "این جمله امام معجزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 478.69,
   "end": 484.33,
   "text": "با یه حالت عجیبی علامه بهائ‌الدینی که همه بزرگان جلوش زانو زدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 484.33,
   "end": 488.45,
   "text": "یه طور وجودی آقا یک شان وجودی شد شهید صیاد شیرازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 488.45,
   "end": 495.35,
   "text": "چون ایشون شاگرد علامه بود. آقای بهائ‌الدینی می‌فرمودند این جمله امام معجزه است که فرمود \"والله قسم\" یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.35,
   "end": 499.43,
   "text": "عالم جلیل القدر لفظ جلاله الله قسم بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 499.43,
   "end": 505.15,
   "text": "ببخشید یه چهار پنج دقیقه بیشتر امروز صحبت می‌کنم به عظمت دهه فجر منو تحمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 505.15,
   "end": 511.51,
   "text": "فرمود یک عالم اینچنین قسم لفظ جلاله الله بخوره که کفاره داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 511.51,
   "end": 517.19,
   "text": "اگه اشتباه باشه. فرمود \"والله قسم در طول عمرم از عهدی نترسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 517.19,
   "end": 521.15,
   "text": "از چیزی نترسیدم. اصلاً من نترسیدم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.15,
   "end": 526.29,
   "text": "ترس برای چی؟ ببینید اینا رو وقتی آدم نگاه می‌کنه توجه بهش می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 526.29,
   "end": 530.97,
   "text": "می‌فهمه که خب بله، یه همچین انقلاب با عظمتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 530.97,
   "end": 536.29,
   "text": "میشه گفت یکی از اتوار وجودی حق چون ان-انقلابه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 536.29,
   "end": 539.87,
   "text": "انفجار نوره باید به دست همچین کسی هم پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 539.87,
   "end": 545.65,
   "text": "یا می‌فرمود من همیشه یک دست غیبی رو در مسیر نهضت پشت سر خودم دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.65,
   "end": 547.47,
   "text": "من نبودم که حرکت می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.47,
   "end": 549.55,
   "text": "یه دست غیبی منو حرکت می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 549.55,
   "end": 553.09,
   "text": "این یعنی چی؟ یعنی خودشو پیدا کرده سپرده به حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 553.09,
   "end": 557.71,
   "text": "الان من یه مثال بزنم برای پیدا کردن ضعف درون خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 557.71,
   "end": 563.43,
   "text": "جانم. حضرت امام فرمودند من با دلی آرام و قلبی مطمئن- احسن به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.43,
   "end": 565.51,
   "text": "احسن به شما. آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 565.51,
   "end": 572.41,
   "text": "چه 好 به موقع بود. همین که وصیت نامه‌شون که \"من با دلی آرام، قلبی مطمئن\" اینو واقعاً اینا شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.41,
   "end": 575.57,
   "text": "داری میری به یه عالم دیگه با قلبی آرام، مطمئن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 575.57,
   "end": 578.17,
   "text": "اینو ضمیری شاد و امیدوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 578.17,
   "end": 580.31,
   "text": "من چند وقت پیش بود توی یه جایی اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.31,
   "end": 587.07,
   "text": "حالا خاطره تلخی اما می‌خوام ضعف وجودی خودمون رو بگم که بعد اینو مقایسه کنیم با پدر پیرمون امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 587.07,
   "end": 590.69,
   "text": "ما چقدر فاصله از این نگاه ناب داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 590.69,
   "end": 593.23,
   "text": "توی جلسه‌ای بودیم با بعضی از مدیران سازمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 593.23,
   "end": 598.15,
   "text": "متاسفانه این مدیرها می‌خواستند اون فرمایشات رهبری پیرامون چهار چیز فساد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 598.15,
   "end": 601.01,
   "text": "طلاق، حاشیه‌نشینی و اعتیاد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 601.01,
   "end": 603.19,
   "text": "مثلاً با سازمان‌های دیگه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 603.19,
   "end": 611.25,
   "text": "نوا شده بودند اینو یه طرحی بدن که مثلاً رهبری تایید کنه بیان از این چهار تا مشکل به طور جدی جلوگیری کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 611.25,
   "end": 615.79,
   "text": "یه پاورپوینت گذاشتند ما به عنوان کارشناس یه عده اونجا بودیم که اینو تحلیل کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 615.79,
   "end": 620.49,
   "text": "باور کنید از اول تا آخر راهکارهایی که برای جلوگیری از این چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 620.49,
   "end": 627.77,
   "text": "اِاِاِ مشکل اجتماعی وجود داشت بیان می‌کردند نه بویی از اسلام توش بود، نه انقلاب، نه آیات، نه حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.77,
   "end": 630.15,
   "text": "همش ب-- یعنی سکولار خالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 630.15,
   "end": 632.51,
   "text": "اصلاً کاملاً خالی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 632.51,
   "end": 634.71,
   "text": "معنویت و دین. صدای من در اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 634.71,
   "end": 640.23,
   "text": "گفتم آخه این چیه؟ اون مدیری که متولی اون بود از مدیرکل‌های سازمان بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 640.23,
   "end": 644.73,
   "text": "با من بحث کرد. \"شما آقا خونده‌ها فکر می‌کنید\" حالا جلوی همه \"شما آقا خونده‌ها فکر می‌کنید فقط شما می‌فهمید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 644.73,
   "end": 650.59,
   "text": "من نمی‌دونم اِاِ پایان‌نامه دکترامو علوم قرآنی بوده.\" گفتم خب فعلاً که خروجی‌تون اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 650.59,
   "end": 653.25,
   "text": "هیچ بویی از اسلام و انقلاب تو این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 653.25,
   "end": 656.41,
   "text": "شما بعد میگی من مثلاً پایان‌نامه‌ام دکترای فلان بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 656.41,
   "end": 659.31,
   "text": "بحثمون شد. گفت \"نه شماها مشکل دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 659.31,
   "end": 663.37,
   "text": "ما مدی-\" گفتم آقا اصلاً ما انقلاب کردیم دستمون به مدیرامون برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 663.37,
   "end": 665.47,
   "text": "شما کی هستی شلوغش کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 665.47,
   "end": 669.07,
   "text": "الحمد لله همه تازه نفس، همه اهل کار و تلاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 669.07,
   "end": 671.01,
   "text": "شما مدیرایید که اینا رو خسته کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 671.01,
   "end": 674.91,
   "text": "این بچه‌های زیر دست خودتون رو خسته کردید با این نگاه بالا به پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 674.91,
   "end": 676.87,
   "text": "آقا ما از جلسه اومدیم بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 676.87,
   "end": 682.15,
   "text": "اینایی که اونجا بودند ریختن سرمون \"دمت گرم حاجی حرف دل ما رو زدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 682.15,
   "end": 685.65,
   "text": "خیلی خدا بهت خیر...\" گفتم چرا اونجا حرف نزدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 685.65,
   "end": 689.49,
   "text": "همه رو گفتم به اینجا برسیم. این جواب این سؤال منو چگونه جواب دادند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 689.49,
   "end": 693.23,
   "text": "بچه مذهبی‌ها، انقلابی‌ها، هیئتی‌های اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 693.23,
   "end": 697.05,
   "text": "چرا اونجا حرف نزدید؟ فقط من خراب شدم ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 697.05,
   "end": 700.97,
   "text": "باور کنید به عین همه‌شون گفتند ما می‌ترسیم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 700.97,
   "end": 704.93,
   "text": "مال-- رزق ما زیر قلم ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 704.93,
   "end": 708.69,
   "text": "می‌ترسیم فردا یه گزارش یه چیزی ملغامون کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 708.69,
   "end": 711.33,
   "text": "فلان بعد مثلاً من جواب زن و بچه‌امو چی بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 711.33,
   "end": 713.55,
   "text": "این شرکه. این شرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 713.55,
   "end": 716.47,
   "text": "ترسه از قلم یه مدیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 716.47,
   "end": 721.19,
   "text": "این شجاعت رو از ما گرفته. بعد امام میگه \"من والله از عهدی نترسیدم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 721.19,
   "end": 724.85,
   "text": "جلوی بزرگ‌ترین قدرت‌های شرق و غرب ایستاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 724.85,
   "end": 727.57,
   "text": "این شوخیه؟ من از یه مدیر هم می‌ترسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 727.57,
   "end": 729.59,
   "text": "بعد اون جلوی عالم وایستاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 729.59,
   "end": 734.01,
   "text": "ما کی می‌خوایم در طول اراده حضرت امام حرکت کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 734.01,
   "end": 735.99,
   "text": "انشاالله که عاقبت بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 735.99,
   "end": 739.05,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 739.05,
   "end": 743.69,
   "text": "اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}