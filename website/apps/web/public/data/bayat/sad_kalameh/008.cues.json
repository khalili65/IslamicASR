 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ هفتم؛ خود را برای همیشه درست ساختن",
   "start": 9.5,
   "end": 29.84
  },
  {
   "index": 1,
   "title": "## نکتهٔ اول و دوم؛ ابد و درست ساختن",
   "start": 29.84,
   "end": 58.34
  },
  {
   "index": 2,
   "title": "## طوبی در مجمع البیان؛ مآب",
   "start": 58.34,
   "end": 386.32
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 6.46,
   "text": "استعین. السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.46,
   "end": 9.5,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.5,
   "end": 12.82,
   "text": "می‌رسیم به کلمه‌ی هفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.82,
   "end": 15.98,
   "text": "در یکصد کلمه از تلنامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.98,
   "end": 18.04,
   "text": "می‌فرمایند آن که خود را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.04,
   "end": 22.04,
   "text": "برای همیشه درست نساخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.04,
   "end": 24.82,
   "text": "پس به چه کاری پرداخت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.82,
   "end": 29.84,
   "text": "آن که خود را برای همیشه درست نساخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.84,
   "end": 32.58,
   "text": "پس به چه کاری پرداخت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.58,
   "end": 35.64,
   "text": "سه تا نکته از اینجا من تأمل کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.64,
   "end": 43.18,
   "text": "خب می‌دونید کلمات بزرگان مثل ایشون جامع الاطراف مثل امثال من نیست اینطوری چیزی بگن و بنویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.18,
   "end": 46.92,
   "text": "هرچی میگن حساب شده‌ست. سه تا نکته رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.92,
   "end": 51.08,
   "text": "دقت کنید متوجه می‌شید. یکی اینکه فرموده برای همیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.08,
   "end": 53.1,
   "text": "اینکه خودش رو برای همیشه بسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.1,
   "end": 57.04,
   "text": "یعنی چی؟ یعنی توجه داشته باشه که ابد در پیش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.04,
   "end": 61.62,
   "text": "ما ابد در پیش داریم. اگر توجه به ابدیه‌ست داشته باشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.62,
   "end": 66.34,
   "text": "اون موقع حواسمون جمعه. نکته‌ی بعد اینکه می‌فرما درست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.34,
   "end": 69.6,
   "text": "نساخت. اون کسی که خودش رو درست نساخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.6,
   "end": 73.58,
   "text": "همه‌ی ما ادعای ساز-سازندگی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.58,
   "end": 81.02,
   "text": "این‌ها داریم. اما یکی رو می‌بینی دست‌پا شکسته خودشو می‌سازه، یکی نه از درسته درمون خودشو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.02,
   "end": 84.0,
   "text": "یعنی دیگه مو لا در قضیه نره به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.0,
   "end": 87.36,
   "text": "قدیمیا. به نحو احسن خودش رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.36,
   "end": 90.1,
   "text": "کسی که می‌داند که ابدیت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.1,
   "end": 94.58,
   "text": "با تمام قوا. نه اینکه حالا یه روز خوبه، یه روز بده، یه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.58,
   "end": 96.6,
   "text": "صبح می‌بینی مومنه، شب کافره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.6,
   "end": 99.08,
   "text": "حدیث هم داریم آخر زمان مردم اینطوری‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.08,
   "end": 102.32,
   "text": "صبح مومنن شب کافرند. شب مومنن صبح کافرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.32,
   "end": 105.02,
   "text": "حدیث داریم. این‌ها فایده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 105.02,
   "end": 109.3,
   "text": "دهه‌ی فاطمیه کارش درسته تموم شد دوباره همون آش و همون کاسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 109.3,
   "end": 111.92,
   "text": "لَقَدْ أُدْنِيَ لَهُمْ صِرَاطَكَ الْمُسْتَقِيمَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 111.92,
   "end": 116.98,
   "text": "میاد شیطان وقتی تو صراط مستقیم قرار گرفتی میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.98,
   "end": 121.04,
   "text": "و نکته‌ی بعد اینکه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 121.04,
   "end": 122.98,
   "text": "چه کاری، به چه کاری پرداخت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 122.98,
   "end": 125.64,
   "text": "یعنی اینکه اصلاً نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 125.64,
   "end": 129.78,
   "text": "هیچ کاری مهم‌تر از خودسازی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 129.78,
   "end": 133.86,
   "text": "حالا ما داریم چیکار می‌کنیم؟ آیا ما این خودسازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.86,
   "end": 135.9,
   "text": "جزو برنامه زندگی ما هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 135.9,
   "end": 139.56,
   "text": "اصلاً مهم‌تر از خودسازی ما کار دیگه‌ای نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 139.56,
   "end": 147.42,
   "text": "حالا شما آیه آیه آیه‌ی قرآن رو هرچی که دقت می‌کنی از اون آی-آیات سوره ولعصر بگیر که ما آخرالزمانه به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 147.42,
   "end": 150.32,
   "text": "ولعصر إن الإنسان لفي خسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 150.32,
   "end": 154.34,
   "text": "همه در خسرانند إلا الذين آمنوا وعملوا الصالحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 154.34,
   "end": 158.0,
   "text": "تا اون آیه اگر باشد مثلا بیست و نه سوره رعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 158.0,
   "end": 161.1,
   "text": "الذين آمنوا وعملوا الصالحات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 161.1,
   "end": 163.76,
   "text": "طوبى لهم وحسن مآب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 163.76,
   "end": 166.24,
   "text": "این مقام طوبى وحسن مآب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 166.24,
   "end": 168.9,
   "text": "این‌ها همه در گرو چی‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 168.9,
   "end": 172.12,
   "text": "همه در گرو ایمان و عمل صالح‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 172.12,
   "end": 175.92,
   "text": "اصلاً نمیشه به جز خودسازی نمیشه به جز این دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 175.92,
   "end": 178.94,
   "text": "انسان حسن مآب داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 178.94,
   "end": 183.14,
   "text": "خوش به حالش بشه به عبارتی طوبى لهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 183.14,
   "end": 187.36,
   "text": "حالا مجمع البيان رو اگر دقت بفرمایید این طوبى رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 187.36,
   "end": 190.18,
   "text": "فرمودن که تعنیف أطيب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 190.18,
   "end": 194.88,
   "text": "أطيب بر وزن افعل یعنی پاکیزه‌ترین، پاکیزه‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 194.88,
   "end": 199.82,
   "text": "که یعنی یک زندگی که خ-- پاکیزه‌ترین زندگی رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 199.82,
   "end": 203.38,
   "text": "این‌هایی که کی طوبى لهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 203.38,
   "end": 205.24,
   "text": "طوبى لهم. اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 205.24,
   "end": 210.28,
   "text": "طوبى تعنیف اگه بگیری از تعنیف أطيب یعنی پاکیزه‌ترین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 210.28,
   "end": 214.8,
   "text": "یعنی وقتی می‌خوای مثل بزنی یک زندگی پاک رو به اینا مثال می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 214.8,
   "end": 217.52,
   "text": "از همه پاک‌تر زندگی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 217.52,
   "end": 220.98,
   "text": "و بالاخره اصحاب آخر زمانی سید الشهدا‌ند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 220.98,
   "end": 223.54,
   "text": "باید از همه پاک‌تر زندگی بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 223.54,
   "end": 225.64,
   "text": "و مآب رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 225.64,
   "end": 229.8,
   "text": "مجمع البيان شیخ طبرسی فرمود مصدر میمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 229.8,
   "end": 231.96,
   "text": "اگه بگیری بازگشتنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 231.96,
   "end": 233.7,
   "text": "اسم مکان بگیری بازگشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 233.7,
   "end": 237.08,
   "text": "به هر حال بازگشته. بازگشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 237.08,
   "end": 238.84,
   "text": "یعنی إِنَّا إِلَيْهِ رَاجِعُونَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 238.84,
   "end": 242.78,
   "text": "قراره بریم به اونجا به اون مبدأ که اومدیم حالا دو مرتبه برگردیم به همون جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 242.78,
   "end": 244.42,
   "text": "به جز خودسازی نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 244.42,
   "end": 247.6,
   "text": "با آلودگی کسی رو تو بهشت راه نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 247.6,
   "end": 256.72,
   "text": "به قول آیه الله قاضی توی تفسیر نورش می‌فرمود مردم چهار دسته‌اند یا ایمان در مومنن که هم ایمان دارن هم عمل صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 256.72,
   "end": 260.6,
   "text": "یا کافرند که نه ایمان دارن نه عمل صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 260.6,
   "end": 264.72,
   "text": "یا منافق‌اند که ایمان ندارن، عمل صالح دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 264.72,
   "end": 268.68,
   "text": "یا فاسق‌اند که ایمان دارن، عمل صالح ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 268.68,
   "end": 270.94,
   "text": "ما از بین این چهار دسته باید اون اولی باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 270.94,
   "end": 273.9,
   "text": "مومن باشیم. هم ایمان هم عمل صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 273.9,
   "end": 277.04,
   "text": "طرف می‌بینی باهاش دو- دو، دو دقیقه نمی‌تونی بشینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 277.04,
   "end": 280.16,
   "text": "همین بچه هیئتیه، سینه زنه، نماز شب خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 280.16,
   "end": 285.72,
   "text": "دو دقیقه نمی‌تونی بشینی. حالا نماز شب رو باید فاکتور گرفت چون نماز شب توفیق هر کسی نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 285.72,
   "end": 289.14,
   "text": "نه اون رو نمی‌شه گفت. ولی بالاخره بچه مسجدی، هیئتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 289.14,
   "end": 293.14,
   "text": "می‌بینی دو دقیقه یا غیبت می‌کنه یا حرف زشت و کریه می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 293.14,
   "end": 295.48,
   "text": "اینا نمیشه به جایی نمی‌رسن این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 295.48,
   "end": 300.6,
   "text": "واقعاً به جایی نمی‌رسن. اینکه پیغمبر فرمود من رفتم در معراج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 300.6,
   "end": 303.0,
   "text": "ها چرا اینقدر به حضرت زهرا شما احترام می‌گذارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 303.0,
   "end": 308.96,
   "text": "فرمود در معراج که رفتم از درخت طوبى، میوه درخت طوبى، اینجا میگه طوبى لهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 308.96,
   "end": 310.98,
   "text": "از درخت طوبى خوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 310.98,
   "end": 313.34,
   "text": "هر وقت دلم برای بهشت تنگ می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 313.34,
   "end": 315.52,
   "text": "حضرت زهرا سلام الله علیها رو بو می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 315.52,
   "end": 318.56,
   "text": "اینا حسودیشون شده بود. چه می‌فهمند این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 318.56,
   "end": 320.54,
   "text": "این درخت طوبى چرا حدیث داریم?",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 320.54,
   "end": 323.32,
   "text": "اصلها ثابت و فرعها في السماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 323.32,
   "end": 328.18,
   "text": "تو بهشته، تو خونه‌ی پیغمبر، یه روایت میگه تو خونه امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 328.18,
   "end": 332.3,
   "text": "و تو خونه‌ی هر کدوم از بهشتی‌ها یه شاخه‌ش رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 332.3,
   "end": 334.96,
   "text": "ها؟ تمثیله دیگه. یعنی همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 334.96,
   "end": 337.6,
   "text": "عبارتی که توی اگر باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 337.6,
   "end": 340.7,
   "text": "زیارت جامعه کبیره داره. إن كنتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 340.7,
   "end": 348.16,
   "text": "إذ ذكر الخير، إذ ذكر الخير وقتی حرف خیر می‌شه كنتم أوله وأصله وفرعه ومعدنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 348.16,
   "end": 352.44,
   "text": "ومنتهى ومأواه. همه‌ی خیرات پیش شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 352.44,
   "end": 360.84,
   "text": "یعنی اگر کسی می‌خواد به بهترین وجه ممکن خودش رو بسازه و طوبى لهم حسن مآب بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 360.84,
   "end": 366.36,
   "text": "هیچ چاره‌ای نیست مگر اینکه بره تحت سایه‌ی درخت طوبى، شجر طوبى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 366.36,
   "end": 369.28,
   "text": "که اصلش ریشه‌ش تو خونه امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 369.28,
   "end": 372.4,
   "text": "باید با ولایت زندگی کرد. غیر از این بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 372.4,
   "end": 374.96,
   "text": "سرمون به سنگ می‌خوره. اما دیر می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 374.96,
   "end": 378.12,
   "text": "سر به سنگ می‌خوره میگه بخواب که جای تو همین جاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 378.12,
   "end": 383.0,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 383.0,
   "end": 386.32,
   "text": "صلى الله على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}