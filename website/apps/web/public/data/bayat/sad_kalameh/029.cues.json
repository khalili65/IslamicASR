 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ بیست‌وهشتم؛ سه آیه در باب عمل",
   "start": 10.56,
   "end": 32.36
  },
  {
   "index": 1,
   "title": "آیهٔ دوم، سی سورهٔ آل‌عمران:",
   "start": 32.36,
   "end": 93.56
  },
  {
   "index": 2,
   "title": "سومین آیه، چهل‌ونُه کهف:",
   "start": 93.56,
   "end": 137.38
  },
  {
   "index": 3,
   "title": "## سازندهٔ خویش؛ اتحاد وجودی",
   "start": 137.38,
   "end": 217.92
  },
  {
   "index": 4,
   "title": "## ثنای خلق و محشور شدن با خود",
   "start": 217.92,
   "end": 308.96
  },
  {
   "index": 5,
   "title": "## انگشت به دیگران؛ قطع رابطه با ملکوت",
   "start": 308.96,
   "end": 517.63
  },
  {
   "index": 6,
   "title": "## تناسخ مقبول؛ بدن برزخی ساختهٔ اعمال",
   "start": 517.63,
   "end": 593.33
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 5.92,
   "text": "و به نستعین. السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.92,
   "end": 10.56,
   "text": "و ربانی ایات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.56,
   "end": 16.24,
   "text": "کلمه بیست و هشت. سه تا آیه رو اینجا هست که استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.24,
   "end": 18.66,
   "text": "توجه کردن شما هم توجه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.66,
   "end": 25.22,
   "text": "یکی آیه چهل و شش سوره هود یه بخشیش رو آوردن که \"انه عمل غیر صالح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.22,
   "end": 28.82,
   "text": "اشاره است به اونجا که به حضرت نوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.82,
   "end": 32.36,
   "text": "سلام الله عليه در خصوص فرزندشون قرآن میگه \"انه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.36,
   "end": 35.54,
   "text": "عمل غیر صالح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.54,
   "end": 41.96,
   "text": "نمی‌فرماید که فرزند تو اینکه بعد از اینکه می‌فرماید \"لیس من اهلك\" از اهل تو نیست، نمی‌فرماید که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.96,
   "end": 46.16,
   "text": "شخصی‌ست که عمل صالح ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.16,
   "end": 51.1,
   "text": "یعنی شخص غیر صالح، بلکه می‌فرماید این آیه صریح آیه قرآنه \"انه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.1,
   "end": 53.28,
   "text": "عمل، عمل غیر صالح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.28,
   "end": 57.32,
   "text": "اصلاً فرزند تو عمل غیر صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.32,
   "end": 60.14,
   "text": "این یک دلیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.14,
   "end": 65.08,
   "text": "آیه بعدی س-- آیه سی سوره آل عمران \"یوم تجد کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.08,
   "end": 70.88,
   "text": "نفس ما عملت من خير محضر و ما عملت من سوء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.88,
   "end": 74.2,
   "text": "عملت چه سوء باشه چه خیر باشه حاضره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.2,
   "end": 80.96,
   "text": "اون دنیا همه می‌بینن که محضر حاضر شده عملشون چه خوب باشه چه بد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.96,
   "end": 82.68,
   "text": "عین عمل حاضر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.68,
   "end": 84.78,
   "text": "دقت بفرمایید. اینم نکته‌ی بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.78,
   "end": 86.78,
   "text": "عین عمل آخرت حاضر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.78,
   "end": 90.82,
   "text": "اینکه می‌گیم جزای نفس عمله از همین آیات بلند می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.82,
   "end": 94.46,
   "text": "و سومین آیه. مال هذا این آیه چهل و نه سوره کهف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.46,
   "end": 98.04,
   "text": "\"مال هذا الكتاب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.04,
   "end": 103.56,
   "text": "این چه کتابیه؟ \"لا يقادر صغيرا ولا كبيرا الا احصاها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.56,
   "end": 109.86,
   "text": "هرچی کوچک و بزرگ و هرچی من عمل کردمو همه رو درش \"احصاها\" شمارش شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.86,
   "end": 112.7,
   "text": "و \"وجدوا\" می‌بی-- می یابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.7,
   "end": 116.3,
   "text": "شخص می یابه. \"ما عمل حاضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.3,
   "end": 121.38,
   "text": "هاورا\". هرچی که عمل کرده مطلقاً حاضر می‌بینه اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.38,
   "end": 123.56,
   "text": "عملش رو حاضر می‌بینه. نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.56,
   "end": 127.04,
   "text": "بگیم حالا بیان یه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.04,
   "end": 134.16,
   "text": "جواب و در مثلاً جزا یا عقاب عملش یه چیز خوب یا بد بهش بدن یا بهشت یا جهنم رو بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.16,
   "end": 137.08,
   "text": "نه. عملش رو حاضر می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.08,
   "end": 145.42,
   "text": "اینجا علامه می‌فرماید که اگر کسی توی این آیات و اشباح آن یعنی شبیه به این آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.42,
   "end": 147.7,
   "text": "نظر صحیح اندازد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.7,
   "end": 153.44,
   "text": "دریابد که انسان شب و روز در مطلق اعمال و احوال خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.44,
   "end": 157.18,
   "text": "حتی حالات رو علامه میگه نه فقط اعمال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.18,
   "end": 164.4,
   "text": "سازنده‌ی خود است و هر گونه که خود را ساخت همان‌گونه از این سرا به سرای دیگر رخ می‌بندد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.4,
   "end": 169.7,
   "text": "هر طور که خودش رو ساخته با اعمال، احوال، عقاید، افکار اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.7,
   "end": 172.32,
   "text": "با همون مرخص می‌شه از دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.32,
   "end": 174.84,
   "text": "یعنی با خودش. عزیزان دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.84,
   "end": 180.5,
   "text": "چقدر علامه به این نکته تاکید می‌کنه با خودش از این عالم مرخص می‌شه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.5,
   "end": 185.82,
   "text": "اتحاد وجودی بین اعمالش و خودش و افکار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.82,
   "end": 191.16,
   "text": "اون علوم و معارف و باورها و اعتقاداتی که پیدا کرده اتحاد وجودی برقرار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.16,
   "end": 193.62,
   "text": "لذا خودش با خودش منتقل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.62,
   "end": 196.3,
   "text": "\"انما تنتقلون من دارا الى دار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.3,
   "end": 199.6,
   "text": "ما با چی میریم؟ با پولمون، با شهرتمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.6,
   "end": 205.9,
   "text": "با مثلاً زن و بچمون، با مدرک تحصیلیمون، با مشهوریت و مر-- با مدیریتمون، با پستمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.9,
   "end": 210.64,
   "text": "نخیر با خودمون، با خودمون، خودمون با خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.64,
   "end": 212.9,
   "text": "چون اتحاد وجودی برقرار شده بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.9,
   "end": 215.7,
   "text": "باورهای ما و اعمال ما، حالات ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.7,
   "end": 217.92,
   "text": "ما همیناییم چیزی جز اینا نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.92,
   "end": 221.28,
   "text": "بیخود به تعریف و تمجید دیگران هم دقت نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.28,
   "end": 223.64,
   "text": "\"كم من ثناء الجميل لست أهله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.64,
   "end": 229.38,
   "text": "نشرته\". چه بسیار ثناگویایی که تو کمال مولا می‌فرماید که \"لست أهله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.38,
   "end": 232.86,
   "text": "من اصلاً اهلش نبودم. \"نشرته\" تو نشرش دادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.86,
   "end": 237.02,
   "text": "که من برم به سمت خیرات اما \"لست أهله\" مثلاً اهلش نبودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.02,
   "end": 243.76,
   "text": "به این تعاریف و تماجید اینایی که دیگران می‌گن و بوق و کرنا و خیلی‌شم انتصابیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.76,
   "end": 246.54,
   "text": "اعتباریه و آقا، آقای مدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.54,
   "end": 248.22,
   "text": "تو دی مو آر افه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.22,
   "end": 251.38,
   "text": "خیلی از اینا از روی یا جهله یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.38,
   "end": 253.82,
   "text": "عرض شود بادمجون داره قاب چینه اینجور حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.82,
   "end": 257.12,
   "text": "اینا بریز بیرون. توجه خودت با خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.12,
   "end": 260.8,
   "text": "محشور می‌شی نه با تعریف و تمجید و نظر دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.8,
   "end": 263.36,
   "text": "با حق با دیگران چگونه بودی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.36,
   "end": 266.2,
   "text": "با خودت همینطوری. مثلاً اون مدیری که در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.2,
   "end": 270.76,
   "text": "در اتاقش بسته است. هیچکس جرات نداره باهاش یه ملاقاتی بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.76,
   "end": 276.62,
   "text": "اوووه راه ساعت‌ها، روزها، ماه‌ها طول می‌کشه تا یه بیچاره‌ای یه گره‌ای ازش باز شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.62,
   "end": 278.22,
   "text": "پشت در اتاق این آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.22,
   "end": 281.14,
   "text": "همینطوری مت-- نگرش می‌دارن پشت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.14,
   "end": 289.96,
   "text": "اتاق حجت خدا و بلکه در پشت در اتاق خودش بلا تکلیف چنان در برزخ می‌جزوننش و انتظار نگرش می‌دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.96,
   "end": 292.32,
   "text": "منتظر می‌مونه بیچاره می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.32,
   "end": 296.62,
   "text": "این بیچاره‌گی هرچی که هست با عمل خودت محشور می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.62,
   "end": 302.32,
   "text": "اون مدیری که نگاه بالا به پایین داره چنان اون دنیا با نگاه بالا به پایین ببیننش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.32,
   "end": 309.76,
   "text": "صبر کن. حالا میگیم مدیر نه که فقط صرفاً اینایی که یه مدیریتی دارن هرکس در هر جایگاهی که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.76,
   "end": 312.74,
   "text": "گاهی اوقات می‌بینی من هیچ کاره‌م و نگاه بالا به پایین دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.74,
   "end": 317.32,
   "text": "این که دیگه بدتر. یا مثلاً شما با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.32,
   "end": 322.36,
   "text": "ااا عرض شود اسماء جلالی، جلالی حضرت حق و قهر حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 322.36,
   "end": 324.52,
   "text": "با مستضعفان، با پر-- با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.52,
   "end": 326.66,
   "text": "پا برهنه ها، با ضعفا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.66,
   "end": 330.64,
   "text": "با گرفتار‌ها، اینا زمین خورده‌ها رفتار کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.64,
   "end": 334.06,
   "text": "در حالی که أشد على الكفار باید باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.06,
   "end": 338.88,
   "text": "میره جلوی بدا-- مثلاً زورگوها، قلدرها سرش پایینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 338.88,
   "end": 341.0,
   "text": "میاد جلوی آدمای ضعیف و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.0,
   "end": 343.24,
   "text": "چنان قلدر مآبانه رفتار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.24,
   "end": 349.96,
   "text": "اگر جگر داری برو جلوی اونا. تو هم وقتی رفتی از این دنیا میری به سمت اسماء جلالی و قهر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.96,
   "end": 352.1,
   "text": "تو رو می‌برن به س-- تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.1,
   "end": 354.16,
   "text": "اسم جلال خدا، تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 354.16,
   "end": 358.62,
   "text": "جلالت اهل بیت چیزی نیست جز جهنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.62,
   "end": 360.5,
   "text": "و تو میری به سمت خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.5,
   "end": 363.4,
   "text": "خودت جهنم شدی از درون زیغی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.4,
   "end": 366.86,
   "text": "اصلاً سع نداری. خودت از دست خودت فراری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.86,
   "end": 369.01,
   "text": "خودت از دست خودت خسته‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.01,
   "end": 373.97,
   "text": "خودت از دست خودت ناراحتی، درزیغ و نگرانی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.97,
   "end": 378.51,
   "text": "حال نداری با خودت دو کل، دو کلمه حرف بزنی عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 378.51,
   "end": 384.59,
   "text": "خلوت کنی با خودت. اصلا حسن خیال چنان متخیلات فاسده بیچارت کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 384.59,
   "end": 387.53,
   "text": "از هرچی میری تو تاریکی دل شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.53,
   "end": 393.23,
   "text": "رو به عرض شود قبله عبا می‌ندازی، برق‌ها رو خاموش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.23,
   "end": 396.41,
   "text": "بعد چهار ساعت قرار می‌خوام با خدا خلوت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.41,
   "end": 398.89,
   "text": "تمام صوت‌ها را از بین می‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.89,
   "end": 400.89,
   "text": "آرامش مطلق. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.89,
   "end": 404.93,
   "text": "می‌بینی مطلقا نمی‌تونی به خدای خودت توجه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.93,
   "end": 409.07,
   "text": "چرا؟ این متخیلات فاسده از درون بیچارت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.07,
   "end": 416.05,
   "text": "این کثرات خارجی اومده تبدیل شده به کثرات انفسیه به قول علامه طباطبایی در رساله سیر و سلوکش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.05,
   "end": 422.15,
   "text": "که چه رساله بسیار عظیم الشأنی‌ست و غذای روحی امروز من و شماست و ازش غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.15,
   "end": 427.45,
   "text": "بیچاره کردیم خودمون رو. بعد مثلا هی اینو می‌بریم زیر سؤال اونو هرچی هست تو خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.45,
   "end": 432.11,
   "text": "هرچی هست. بلد نیست برا امام حسین گریه کنه انگشو به مداحه می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.11,
   "end": 440.09,
   "text": "بلد نیست بشینه فکر کنه طهارت نفس پیشه کنه که عمق معارف رو بچشه بفهمه که لا یمسسه إلا المتهرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 440.09,
   "end": 444.19,
   "text": "انگشو به آخوندا و سخنران‌ها و معلمش و استادش می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 444.19,
   "end": 446.65,
   "text": "تو بلد نبودی. آقا جون فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.65,
   "end": 448.99,
   "text": "نشستن حقایق، پیاده شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.99,
   "end": 453.05,
   "text": "حقایق در جان وجود انسان مربوط به ملکوت عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.05,
   "end": 457.15,
   "text": "اینکه استاد می‌شینه حرف می‌زنه این علت مؤدّه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.15,
   "end": 460.83,
   "text": "علت تام نیست. تعداده، کمکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.83,
   "end": 463.01,
   "text": "تو خودت اون ملکوت کمک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 463.01,
   "end": 467.03,
   "text": "اون چیزی که تو می‌فهمی از ملکوت نازل می‌شه به وجود تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.03,
   "end": 469.69,
   "text": "تو رابطه خودتو با ملکوت قطع کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 469.69,
   "end": 471.77,
   "text": "هرچی استاد زور بزنه نمی‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 471.77,
   "end": 474.05,
   "text": "ارتباط برقرار نمی‌شه. آقا جون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 474.05,
   "end": 476.11,
   "text": "هرچی که هست خودتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 476.11,
   "end": 477.77,
   "text": "خودت با خودت محشور می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.77,
   "end": 484.41,
   "text": "خوش به حال کسی که به سمت اسماء جمال خدا، لطف خدا حرکت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 484.41,
   "end": 490.29,
   "text": "و مثلا می‌ره زیارت امام الرؤوف، رئوفتشو در وجود خودش پیاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.29,
   "end": 494.61,
   "text": "با زن و بچه و رفیقاش و همسفری‌هاشو دیگران و مردم اینا رئوف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 494.61,
   "end": 497.73,
   "text": "بعد می‌بینی بله امام رضا هم جلوه و وجهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 497.73,
   "end": 504.29,
   "text": "رئوفتش رو بهش نشون می‌ده. اما می‌ره اونجام تو حرم دعوا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.29,
   "end": 506.71,
   "text": "ضارب می‌خوامونه پای مثلا گوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 506.71,
   "end": 509.45,
   "text": "خادم امام رضا تو دیدما این چیزا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 509.45,
   "end": 514.77,
   "text": "اصلا آدم تعجب می‌کنه تو حرم دو تا ضارب فحاشی، داد و فریاد و چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.77,
   "end": 516.37,
   "text": "این با خودش محشور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.37,
   "end": 519.39,
   "text": "بعد می‌بینی قبرش، اون قبر فقهی نه ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.39,
   "end": 523.23,
   "text": "قبر حقیقی‌ش که اون بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 523.23,
   "end": 527.71,
   "text": "بدن برزخی‌شه که با اعمالش الان داره اونا رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.71,
   "end": 530.99,
   "text": "از اینجا تناسخی که اسلام قبول داره یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 530.99,
   "end": 538.45,
   "text": "این روح وقتی اعلام انصراف کرد از این بدن خاکی در میاد می‌ره تو اون بدنی که خودت داری الان با اعمالت می‌سازیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.45,
   "end": 540.33,
   "text": "بعد می‌ری تو اون. می‌گن تناسخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 540.33,
   "end": 543.89,
   "text": "این روح نفس ناطقه رفت تو بدن برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 543.89,
   "end": 546.15,
   "text": "حالا اون بدن رو چه شکلی ساختی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 546.15,
   "end": 549.99,
   "text": "اگر عقربه، ماره، رتیله دائما داره نیشت می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 549.99,
   "end": 552.25,
   "text": "خودت داری خودت رو نیش می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 552.25,
   "end": 557.93,
   "text": "اگر گاو و اشتر پلنگ به قول علامه انواع و اقسام حیوانات تو رو در بر گرفتن بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.93,
   "end": 561.31,
   "text": "یه مشت حیوان وحشتناک خودت رو محصور کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.31,
   "end": 564.39,
   "text": "اما اگر روح و ریحان بهشتیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 564.39,
   "end": 567.65,
   "text": "تو وارد در بهشت می‌شی، خودت به خودت وارد می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.65,
   "end": 569.41,
   "text": "اصلا خودت با خودت محشور می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 569.41,
   "end": 572.41,
   "text": "ختم کلام. رفقا توجه به این جمله بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.41,
   "end": 574.69,
   "text": "بارها گفتیم. علامه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 574.69,
   "end": 577.69,
   "text": "جهنمی را خدا به جهنم نمی‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 577.69,
   "end": 580.03,
   "text": "جهنمی خود جهنم می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.03,
   "end": 582.53,
   "text": "بهشتی را خدا به بهشت نمی‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 582.53,
   "end": 585.79,
   "text": "بهشتی خود بهشت می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 585.79,
   "end": 587.79,
   "text": "خودمون با خودمون محشور می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 587.79,
   "end": 590.75,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر بشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 590.75,
   "end": 593.33,
   "text": "صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}