 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ سیزدهم؛ آنکه از مرگ می‌ترسد از خودش می‌ترسد",
   "start": 9.44,
   "end": 29.7
  },
  {
   "index": 1,
   "title": "مرحوم حاجی سبزواری علیه‌الرحمه در شرح خود پیرامون آیه سخن گفته‌اند:",
   "start": 29.7,
   "end": 50.04
  },
  {
   "index": 2,
   "title": "### یوم تبلی السرائر",
   "start": 50.04,
   "end": 252.66
  },
  {
   "index": 3,
   "title": "### اتحاد با علم و عمل؛ چراغ و فتیله",
   "start": 252.66,
   "end": 447.64
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 5.48,
   "text": "و بهین استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.48,
   "end": 9.44,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.44,
   "end": 14.26,
   "text": "کلمه سیزدهم. آن که از مرگ می‌ترسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.26,
   "end": 19.62,
   "text": "از خودش می‌ترسد. دقت بفرمایید رو جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.62,
   "end": 23.48,
   "text": "آن که از مرگ می‌ترسد از خودش می‌ترسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.48,
   "end": 26.44,
   "text": "چرا از تعالم این رو فرمودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.44,
   "end": 29.7,
   "text": "پیداست که ما موتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.7,
   "end": 34.76,
   "text": "حقیقت موتمون ر، یعنی رسیدن خودمون به خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.76,
   "end": 40.14,
   "text": "به یک معنا یعنی عبور از ظاهر خودمون به باطن خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.14,
   "end": 44.68,
   "text": "اونجا که مرحوم حاجی سبزواری عليه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.68,
   "end": 52.04,
   "text": "در کتاب قررشون پیرامون آیه \"یوم تبدل الأرض بغير الأرض\" سخن گفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.04,
   "end": 54.18,
   "text": "اون روزی که زمین، ارز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.18,
   "end": 58.94,
   "text": "این زمین رو بگیر همین ارز اول رو بگیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.94,
   "end": 60.62,
   "text": "وجود ظاهر وجود خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.62,
   "end": 63.14,
   "text": "\"یوم تبدل الأرض بغير الأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.14,
   "end": 69.32,
   "text": "وقتی این زمین وجودت تبدیل می‌شه به یک زمین دیگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.32,
   "end": 72.82,
   "text": "ایشون فرمودن یعنی همین که تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.82,
   "end": 79.56,
   "text": "جسم رو این خ، اِاِاِ میشه گفت تفاله بدنت رو، این جسمیت رو میذاری زمین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.56,
   "end": 83.26,
   "text": "نفس حرکت می‌کنه به سمت فعلیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.26,
   "end": 89.78,
   "text": "که مرحوم ملا صدرا در اون کتاب شریف شواهد ربوبیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.78,
   "end": 93.66,
   "text": "اونجا اثبات می‌کنند که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.66,
   "end": 95.76,
   "text": "حقیقت موت اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.76,
   "end": 99.78,
   "text": "نفس ناطقه انسان به فعلیت تام می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.78,
   "end": 102.84,
   "text": "احتیاجش از این جسمیت و خ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.84,
   "end": 105.56,
   "text": "بدن خاکی برداشته می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.56,
   "end": 109.24,
   "text": "و یعنی از اون حالت قوه خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.24,
   "end": 113.58,
   "text": "اعلام استقلال و بی‌نیازی به این جسمیت بدن می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.58,
   "end": 115.8,
   "text": "نفس و می‌ره به فعلیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.8,
   "end": 117.9,
   "text": "حالا این فعلیت به دو وجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.9,
   "end": 121.16,
   "text": "یا می‌ره به سمت اسماء جلالیه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.16,
   "end": 125.66,
   "text": "مثل شدید العقاب، مثل قهاریت، مثل ذو انتقام اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.66,
   "end": 131.52,
   "text": "یا می‌ره به سمت اسماء جمالیه خدا مثل غفاریت، وح aviet و چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.52,
   "end": 138.26,
   "text": "در هر حال فعلیت نفس اونجا معلوم می‌شه یعنی آشکار می‌شه یعنی باطنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.26,
   "end": 142.04,
   "text": "ظهور می‌کنه و ما اونجا خودمون رو زیارت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.04,
   "end": 145.6,
   "text": "اصلاً حقیقت مه، موت یا مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.6,
   "end": 150.76,
   "text": "زیارت خودمون به خودمونه یا به یک معنا لقاء خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.76,
   "end": 154.56,
   "text": "بحث لقاء الله رو اگر پیگیر باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.56,
   "end": 159.78,
   "text": "متوجه می‌شیم که اصلاً یعنی لقاء هر کسی به ملاقات خودش می‌رسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.78,
   "end": 168.56,
   "text": "خودش رو پیدا می‌کنه که اصلاً موت یعنی اینکه از این سرزمین ظاهرت به باطن سفر کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.56,
   "end": 171.56,
   "text": "که حالا به هر حال یه اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.56,
   "end": 177.58,
   "text": "الان ما ذیل اسم از ظاهر خدا هستیم نفس می‌کشیم از باطن بی‌خبریم بعد می‌ریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.58,
   "end": 180.76,
   "text": "سفر می‌کنیم به اسم الباطن خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.76,
   "end": 183.5,
   "text": "اون یوم عرض شد که ظهوره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.5,
   "end": 186.48,
   "text": "به قول علامه یوم یعنی ظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.48,
   "end": 188.6,
   "text": "ظرف ظهور اشیاست. \"یوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.6,
   "end": 191.26,
   "text": "تبد، یوم تبلى السرائر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.26,
   "end": 194.38,
   "text": "\"یوم تبلى السرائر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.38,
   "end": 197.12,
   "text": "اون وقت که آشکار می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.12,
   "end": 199.18,
   "text": "سرائر یعنی باطن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.18,
   "end": 202.08,
   "text": "باطن‌ها آشکار می‌شه چı، یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.08,
   "end": 204.86,
   "text": "یعنی اصلاً نفست از ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.86,
   "end": 209.1,
   "text": "علاقه‌ش برداشته می‌شه، اعلام انصراف می‌کنه تو می‌رسی به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.1,
   "end": 211.68,
   "text": "به باطن چی می‌رسی؟ به باطن خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.68,
   "end": 218.54,
   "text": "پس اگر کسی، حالا برگردیم به جمله علامه اگر می‌فرمود \"آن که از مرگ می‌ترسد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 218.54,
   "end": 220.72,
   "text": "خودش می‌ترسد.\" چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.72,
   "end": 223.7,
   "text": "چون به هرچی می‌خواد برسه خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.7,
   "end": 227.34,
   "text": "انسان وقت موت به حقیقت خودش می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.34,
   "end": 232.24,
   "text": "و چون ما هم یکی از وجه الله هستیم، یکی از معانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.24,
   "end": 239.42,
   "text": "لقاء الله یا نِ، می‌شه گفت نظر انداختن به وجه الله می‌شه نظر انداختن به باطن خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.42,
   "end": 242.8,
   "text": "ما یکی از کلمات وجودی نظام اصلی هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.8,
   "end": 246.38,
   "text": "لذا نگاه می‌کنی به خودت و اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.38,
   "end": 249.66,
   "text": "اونچه که از خودت می‌بینی به هر حال ما اتحاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.66,
   "end": 252.54,
   "text": "کامل برقرار می‌کنیم با علم و عملمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.54,
   "end": 256.28,
   "text": "که علم و عمل جوهرند و انسان ساز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.28,
   "end": 257.98,
   "text": "اتحاد کامل پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.98,
   "end": 262.54,
   "text": "اگر این حقیقت وجودیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.54,
   "end": 265.42,
   "text": "نور رحمته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 265.42,
   "end": 268.02,
   "text": "می‌شه اشکال و صور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.02,
   "end": 270.64,
   "text": "ملذذه، لذت آور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.64,
   "end": 273.94,
   "text": "اشجار و انهار و حوری‌ها و چه می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.94,
   "end": 279.7,
   "text": "اما اگر این وجودمون به سمت زشتیا رفته می‌شه اشکال و صور مدهشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.7,
   "end": 283.26,
   "text": "مثل کجدم و سگ و عقرب و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.26,
   "end": 285.4,
   "text": "بعد با همونا معنوسی در قبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.4,
   "end": 288.36,
   "text": "یعنی ما با خودمون محشور می‌شیم به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.36,
   "end": 291.02,
   "text": "این چنینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.02,
   "end": 293.42,
   "text": "حقیقت موت و نمی‌دونم اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.42,
   "end": 299.26,
   "text": "حالا خوبی یا خوشی یا ناخوشی قبر همش بر می‌گرده به حالات خودمون عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.26,
   "end": 304.4,
   "text": "که حالا خدا رحمت کنه حضرت علامه شهرانی استاد از تعالم حسن زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 304.4,
   "end": 308.78,
   "text": "ایشون مثال می‌زدن که حالا اتحاد وجودی ما برقرار می‌کنیم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.78,
   "end": 310.62,
   "text": "علم و عملمون یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.62,
   "end": 318.8,
   "text": "مثال چراغ رو می‌زدن و می‌گفتن این فیتیله وقتی شما فیتیله چراغ رو هی درشت‌ترش می‌کنی، قوی‌ترش می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.8,
   "end": 321.12,
   "text": "درجه‌شو بیشتر می‌کنی، نور چراغ بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.12,
   "end": 325.34,
   "text": "چراغ یک چراغه. اون وجود تو رو بگیر چراغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.34,
   "end": 330.72,
   "text": "حالا اون فیتیله رو بگیر علم، بگیر عمل وقتی بیشتر می‌شه، هی نور چراغ بیشتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.72,
   "end": 335.02,
   "text": "یا اصلاً وقتی کبریت نزدی چراغ خاموشه یعنی تو علمی اخذ نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.02,
   "end": 337.18,
   "text": "به سمت علم و معرفت نرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.18,
   "end": 340.12,
   "text": "\"إلا الذين آمنوا وعملوا الصالحات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 340.12,
   "end": 342.66,
   "text": "عمل در کنار آمنوا. آمنوا چی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 342.66,
   "end": 345.58,
   "text": "چی ایمان میاره؟ چی دلدادگی میاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.58,
   "end": 347.54,
   "text": "علم، معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.54,
   "end": 350.28,
   "text": "حالا شما علم و معرفت رو بگیر، علم رو هم بردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.28,
   "end": 352.36,
   "text": "چی می‌مونه؟ مثل یه چراغ خاموش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 352.36,
   "end": 354.36,
   "text": "چراغ خاموش یعنی خودت خاموشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 354.36,
   "end": 355.96,
   "text": "یعنی میری به سمت ظلمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 355.96,
   "end": 359.2,
   "text": "\"ولياهم الطاغوت\" چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 359.2,
   "end": 362.28,
   "text": "\"يخرجونهم، يخرجهم من الظلمات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 362.28,
   "end": 365.34,
   "text": "ويخرجونهم من النور إلى الظلمات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 365.34,
   "end": 367.28,
   "text": "یعنی همین. یعنی میری به سمت ظلمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 367.28,
   "end": 369.76,
   "text": "یعنی خودت رو می‌بینی تاریک تاریکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 369.76,
   "end": 377.48,
   "text": "اصلاً معنای تاریکی قبر و شب اول قبر و زیغ و سختی و چ، کجدم و مار و عقرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.48,
   "end": 379.7,
   "text": "همیناییه که تو وجود خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 379.7,
   "end": 382.94,
   "text": "ختم کلام. اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 382.94,
   "end": 388.64,
   "text": "حالا اینو اگر خس، کسی خواست مبسوط ببینه بره رساله انه الحق علامه رو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 388.64,
   "end": 391.22,
   "text": "این جمله برداشت شده از رساله ال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 391.22,
   "end": 394.44,
   "text": "انه الحق علامه‌ست. اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 394.44,
   "end": 398.42,
   "text": "می‌خواد ببینه که وضعیتش چگونه‌ست ببینه به چه کارهایی داره اصرار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 398.42,
   "end": 403.38,
   "text": "این جمله آخر منو خوب توجه کنید که البته یکی از جملات و کلمات بعداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 403.38,
   "end": 405.76,
   "text": "چند تا کلمه دیگه بهش می‌رسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 405.76,
   "end": 411.34,
   "text": "که اونچه که ما از صور و اشکال در بعد از موتمون می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 411.34,
   "end": 413.86,
   "text": "برگرفته از ملکات وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 413.86,
   "end": 418.26,
   "text": "ملکات هم یعنی اون کارهایی که بهش اصرار داریم، اون ملکات وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 418.26,
   "end": 423.94,
   "text": "اگر این ملکات خوبن صور و اشکالی که ما می‌بینیم خوبن بعداً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 423.94,
   "end": 428.82,
   "text": "یعنی اینا ملاط اون صور و اشکالیه که بعداً باهاشون مواجه می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 428.82,
   "end": 433.12,
   "text": "اگر این ملکات بد هستن خدا نکنه زشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 433.12,
   "end": 439.16,
   "text": "اونچه که ما می‌بینیم بعد از موت همش دهش، وحشتناک و زشت و خبیث و این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 439.16,
   "end": 441.9,
   "text": "پناه می‌بریم از خودمون به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 441.9,
   "end": 447.64,
   "text": "ان شاءالله عاقبتمون ختم به خیر باشه به برکت صلوات بر محمد و آل محمد. اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}