 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ دهم؛ تن آراستن و روان آلودن",
   "start": 8.96,
   "end": 34.3
  },
  {
   "index": 1,
   "title": "## تمثیلِ پرنده و سایه؛ در انسان در عرفِ عرفان",
   "start": 34.3,
   "end": 115.28
  },
  {
   "index": 2,
   "title": "## ظل در قرآن و در عرفان",
   "start": 115.28,
   "end": 203.24
  },
  {
   "index": 3,
   "title": "مولا در نهج‌البلاغه فرمود:",
   "start": 203.24,
   "end": 223.28
  },
  {
   "index": 4,
   "title": "## لباسِ چرکین و ذکر؛ لباس التقوی",
   "start": 223.28,
   "end": 401.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 5.42,
   "text": "به نستعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.42,
   "end": 8.96,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.96,
   "end": 13.38,
   "text": "کلمه دهم. حضرت استاد می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.38,
   "end": 16.58,
   "text": "آن که تن آراست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.58,
   "end": 19.5,
   "text": "و روان آلاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.5,
   "end": 26.7,
   "text": "به چه ارج و بهاست؟ اشاره دارد به اصل بودن باطن به ظاهر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.7,
   "end": 29.68,
   "text": "به نفس. یعنی نفس اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.68,
   "end": 32.46,
   "text": "و بدن متفرع بر اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.46,
   "end": 34.3,
   "text": "بدن سایه نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.3,
   "end": 40.78,
   "text": "در یکی از اصول معرفت نفس در کتاب شریف انسان در عرف عرفانش هست علامه اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.78,
   "end": 47.4,
   "text": "اصلی رو پیاده می‌کنند که مثل پرنده‌ای که در آسمون پرواز می‌کنه سایه‌اش رو زمین دیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.4,
   "end": 51.42,
   "text": "شما از این سایه پی به وجود پرنده در آسمان می‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.42,
   "end": 55.02,
   "text": "دیگه متوجه این سایه نمی‌شی که به اون پرنده د-- قصد می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.02,
   "end": 58.28,
   "text": "اما ما این اشکال رو، اشتباه رو انجام دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.28,
   "end": 61.62,
   "text": "که صرفاً به این سایه که بدنمونه می‌پردازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.62,
   "end": 66.36,
   "text": "به اون اصل که بدنمونه، اون نفسمونه توجه نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.36,
   "end": 68.84,
   "text": "و اونجا یه اصلی رو القا می‌کنند خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.84,
   "end": 71.88,
   "text": "جای بحث مفصلی داره ش-- جاش اینجا نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.88,
   "end": 76.38,
   "text": "که همونطور که این سایه این پرنده شبیه خودشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.38,
   "end": 84.46,
   "text": "هر بدنی هم شبیه نفسشه و از بدن می‌شه تشخیص داد درون چه خبره که مولا فرمود من نگاه می‌کنم می‌فهمم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.46,
   "end": 86.52,
   "text": "طرف اول و آخرش چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.52,
   "end": 90.36,
   "text": "یه معناش اینه از اون شکل بدن می‌شه به شکل ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.36,
   "end": 94.3,
   "text": "نفس پی برد که و کلن يعمل علی شاکلته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.3,
   "end": 98.34,
   "text": "قرآن می‌فرماید هر کسی بر اساس شاکله و شکلش عمل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.34,
   "end": 102.44,
   "text": "حالا اینجا داره اشاره می‌کنه به اینکه بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.44,
   "end": 105.32,
   "text": "بدن سایه نفس است و اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.32,
   "end": 109.2,
   "text": "نفس است. به عبارتی بدن ظل النفس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.2,
   "end": 113.1,
   "text": "که و حالا متأسفانه ما خیلی توجه به این نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.1,
   "end": 114.88,
   "text": "و چقدر عبارت شیرینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.88,
   "end": 120.12,
   "text": "اینم که حکما و عرفا ول اینا اضلال، سایه اینا میارن از قرآن گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.12,
   "end": 122.34,
   "text": "ألم تر إلى ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.34,
   "end": 124.52,
   "text": "كيف مد الظل آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.52,
   "end": 129.58,
   "text": "نگاه نمی‌کنی به پروردگارت نگاه نکردی که چگونه می‌کشد سایه را؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.58,
   "end": 134.48,
   "text": "حالا اون ظل رو گرفتن، اون وجود منبسط اول یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.48,
   "end": 139.88,
   "text": "ثقل ذات حضرت حق به مرتبه احدیتش که همه این کثرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.88,
   "end": 141.76,
   "text": "مستهلک در اون هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.76,
   "end": 147.0,
   "text": "بعد اون مد رو که ظل رو می‌کشه بهش میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.0,
   "end": 151.74,
   "text": "بهش میگن صادر اول که همه ما از اون نفس به وجود اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.74,
   "end": 157.2,
   "text": "نفس الرحمن. که حالا بالاخره همونطور که لباس کثیف می‌شه، باطن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.2,
   "end": 159.86,
   "text": "کثیف می‌شه، بدن کثیف می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.86,
   "end": 162.52,
   "text": "باطن هم کثیف می‌شه که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.52,
   "end": 167.04,
   "text": "مخصوصاً اینجا این رو استفاده می‌کنم که اگر بعضی‌ها به خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.04,
   "end": 173.56,
   "text": "بی‌حرمتی نمی‌کردن، به خودشون اهانت به خودشون اهانت نمی‌کردن که آقا این حرفامو نمی‌فهمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.56,
   "end": 176.84,
   "text": "بالاخره وقتی یک حرف ثقیله، سنگینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.84,
   "end": 180.8,
   "text": "و پربهاست در ابتدا به ساکن بله آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.8,
   "end": 184.0,
   "text": "متوجه‌اش شاید نشه اما باید تکرار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.0,
   "end": 190.2,
   "text": "الكلمة حرف و تکرار ألف مولا فرمودن یک بار حرف رو بشنو صد، هزار بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.2,
   "end": 192.76,
   "text": "تکرار کن تا یاد بگیره آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.76,
   "end": 196.48,
   "text": "این فرمایشو دقت بفرمایید از مولامون علی از من نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.48,
   "end": 203.24,
   "text": "سند نهج‌البلاغه. ان هاذه القلوب تمل على مثل الأبدان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.24,
   "end": 205.42,
   "text": "دل‌ها مثل بدن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.42,
   "end": 209.3,
   "text": "چرک می‌گیرن، گرفتار می‌شن، مشکلات پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.3,
   "end": 212.34,
   "text": "فابتغوا لها طرائف الحكمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.34,
   "end": 216.8,
   "text": "شما این‌ها رو این گرفتگی‌ها، این قبض، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.8,
   "end": 220.12,
   "text": "آلودگی، این حالا ظلمت چی بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.12,
   "end": 223.28,
   "text": "اینا رو برطرف کنید از دلتون با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.28,
   "end": 228.42,
   "text": "طرائف الحكمة. با اون سخنان لسیف حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.42,
   "end": 231.84,
   "text": "حکمت همین چیزیست که ما در مشرب علامه داریم سخن می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.84,
   "end": 234.18,
   "text": "حکمت نظری، عرفان نظری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.18,
   "end": 237.78,
   "text": "که انشاالله منتهی بشود به حکمت و عرفان عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.78,
   "end": 244.9,
   "text": "خب این را ببینید با حکمت با شنیدن به قول علامه فرمودند که انسان با حرف شنیدن مؤدب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.9,
   "end": 247.24,
   "text": "با پس زدن این حرف‌ها به هیچ جا نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.24,
   "end": 252.54,
   "text": "صرف اینکه به بدن روایات و به بدن آیات یعنی به ظاهر اونو توجه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.54,
   "end": 255.62,
   "text": "از باطن‌شون بی‌خبر باشیم به هیچ جا نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.62,
   "end": 260.42,
   "text": "باید پل زد، عمیق شد، شخم زد روایات و آیات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.42,
   "end": 263.22,
   "text": "البته با عینک طهارت نفس و رفت به اون باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.22,
   "end": 266.62,
   "text": "یه روز یه شخصی لباسش چرکین بود تو مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.62,
   "end": 270.24,
   "text": "پیغمبر بهش تذکر دادین چه وضعشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.24,
   "end": 273.66,
   "text": "چرا لباستو نمی‌شوری؟ بعضی‌هات خب دیر به دیر لباسشونو می‌شورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 273.66,
   "end": 279.98,
   "text": "حموم اینا دیر میرن. پیغمبر فرمود این لباس تو هم می‌خواد ذکر بگه، ذکر خدا رو بگه نمی‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.98,
   "end": 283.72,
   "text": "این کثافتی که به لباس توئه مانعه، نمی‌ذاره ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.72,
   "end": 285.84,
   "text": "ب-- همینطور حالا برو به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.84,
   "end": 287.92,
   "text": "باطن نفس انسان هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.92,
   "end": 290.4,
   "text": "این چنینه. وقتی آلوده شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.4,
   "end": 293.42,
   "text": "نمی‌تونه، نمی‌تونه ذکر خدا بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.42,
   "end": 296.36,
   "text": "متوقف می‌شه. اینه که علامه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 296.36,
   "end": 302.58,
   "text": "به این تو-تاکید می‌کنه که آن که تن آراست به تنش پرداخت، به ظاهرش پرداخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.58,
   "end": 306.12,
   "text": "و روان آلاست روانشو باطنشو آلوده کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.12,
   "end": 311.16,
   "text": "به چه ارج و بهاییه؟ این چه آخه چه ارج و بهایی داره چنین چیزی، چنین کسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.16,
   "end": 316.88,
   "text": "حالا حدیث هم داریم از مولامون که ثوب الطقى أشرف الملابس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 316.88,
   "end": 319.78,
   "text": "که لباسه اگر بخوایم قیاس بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.78,
   "end": 322.44,
   "text": "لباسه، خب ما یه لباس ظاهری داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 322.44,
   "end": 324.94,
   "text": "همین لباس که الان تن حضرت عالی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.94,
   "end": 327.62,
   "text": "که اینم یک نعمتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.62,
   "end": 330.66,
   "text": "جالبه که در حالا ما می‌گفتیم همه چی نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.66,
   "end": 333.06,
   "text": "بعضیا متعجب می‌شدن. اینم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 333.06,
   "end": 335.74,
   "text": "آیه از قرآن. قرآن آقا جون حرف من که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.74,
   "end": 340.84,
   "text": "آیه بیست و شش اعراف. یا بنی آدم قد أنزلنا عليكم لباسا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.84,
   "end": 344.12,
   "text": "ما حتی این لباس رو هم بر شما نازل کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.12,
   "end": 346.96,
   "text": "که چی بشه؟ یواری سوءاتکم و ریشا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 346.96,
   "end": 349.04,
   "text": "هم زشتی‌های شما رو بپوشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.04,
   "end": 353.94,
   "text": "سوءاتک و سو میاد هم ریشا یعنی اینکه زینت شما باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.94,
   "end": 356.86,
   "text": "و لباس التقوی ذلک خیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 356.86,
   "end": 360.36,
   "text": "لباس تقوی چیه؟ این بهتره، مال باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.36,
   "end": 364.14,
   "text": "اونجا هم فرمودند که لباس تقوی أشرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 364.14,
   "end": 368.62,
   "text": "ملابسه. مولا فرمود بالاترین لباس‌ها لباس تقواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 368.62,
   "end": 370.2,
   "text": "اگر کسی باطن‌ش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 370.2,
   "end": 378.44,
   "text": "عریان بذاره بعد ظاهرش رو پوشونده با بهترین و شیک‌ترین لباس‌های مد روز اما ظاهرش عریان، باطن‌ش عریانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 378.44,
   "end": 382.94,
   "text": "عریان محشور می‌شه. حالا کسی هم که چشم دل داره بابا رو چجوری می‌بینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 382.94,
   "end": 387.0,
   "text": "عریان می‌بینه. اعوذالله. انشاالله عاقبت ما всех بخير بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.0,
   "end": 389.82,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 389.82,
   "end": 395.56,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.56,
   "end": 401.04,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}