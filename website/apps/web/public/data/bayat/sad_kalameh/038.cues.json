 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ سی‌وهفتم: حیوانات، تمثلات ملکات انسان",
   "start": 10.74,
   "end": 30.84
  },
  {
   "index": 1,
   "title": "## خواب، عالم مثال متصل، و انشاء نفس",
   "start": 30.84,
   "end": 214.56
  },
  {
   "index": 2,
   "title": "## حکایت عالم و سگ روی تابوت",
   "start": 214.56,
   "end": 305.42
  },
  {
   "index": 3,
   "title": "## آیات غفلت و تشبیه به انعام",
   "start": 305.42,
   "end": 699.72
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 2.86,
   "text": "رحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.86,
   "end": 6.74,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.74,
   "end": 10.74,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.74,
   "end": 13.78,
   "text": "روز بسیار مبارکی‌ست، روزی‌ست که حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.78,
   "end": 17.64,
   "text": "قدرت نمایی کرد و خرمشهر رو به قول امام آزاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.64,
   "end": 20.12,
   "text": "تبریک میگم این روز رو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.12,
   "end": 27.68,
   "text": "خواهش می‌کنم که در این لحظات و آنات عرفانی یاد کنیم از همه شهدامون که مدیونشون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.68,
   "end": 31.66,
   "text": "ثار روح بلند امام و شهدای صلوات هدیه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.66,
   "end": 35.02,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.02,
   "end": 37.4,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.4,
   "end": 39.42,
   "text": "محمد و عجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.42,
   "end": 42.64,
   "text": "اونچه که امروز عرض می‌کنیم هدیه می‌کنیم به روح بلند اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 42.64,
   "end": 46.54,
   "text": "ان شاء الله در اند رب بهم یرزقون ما رو دعا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.54,
   "end": 54.12,
   "text": "کلمه سی و هفت: \"آنکه در آثار صفات و اخلاق انسان‌ها و در احوال و اح-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.12,
   "end": 56.94,
   "text": "افعال حیوان‌ها دقیق شود\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.94,
   "end": 59.98,
   "text": "یعنی آثار و صفات انسان‌ها رو بررسی کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.98,
   "end": 62.06,
   "text": "بعدم احوال و افعال حیوانات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.06,
   "end": 65.52,
   "text": "این دو تا رو بررسی کنه. \"حیوان‌ها را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 65.52,
   "end": 68.02,
   "text": "تمثلات\" یعنی مثال‌هایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 68.02,
   "end": 72.12,
   "text": "\"تمثلات ملکات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 72.12,
   "end": 76.64,
   "text": "یعنی اون چیزهایی که راسخ شده تو نفس‌شون، محکم شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 76.64,
   "end": 80.44,
   "text": "جا افتاده. \"حیوان‌ها را تمثلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 80.44,
   "end": 83.9,
   "text": "ملکات انسان‌ها می‌یابد.\" قبلاً گفته بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 83.9,
   "end": 86.4,
   "text": "آنچه که ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 86.4,
   "end": 92.34,
   "text": "عالم خواب که مثال عالم مثال منف-- متصل ماست در درون ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 92.34,
   "end": 94.36,
   "text": "می‌بینیم در سقع نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 94.36,
   "end": 98.1,
   "text": "خودمونه. در اون باطن کمون ذات خودمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 98.1,
   "end": 100.78,
   "text": "که اونچه که می‌بینیم انشائات نفس ناطقه مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 100.78,
   "end": 104.24,
   "text": "اونچه تو خواب می‌بینیم نفس اینا رو ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 104.24,
   "end": 108.4,
   "text": "آنچه که تمثلات، اون مثال‌هایی که ما در خواب می‌بینیم کار خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 108.4,
   "end": 111.8,
   "text": "اونا بر اساس چیه؟ این ملکات نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 111.8,
   "end": 116.94,
   "text": "هر چیزی که در نفس رسوخ کرده، جا انداخته، ریشه دوانده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 116.94,
   "end": 121.48,
   "text": "قیامت همچنینه که حضرت استاد می‌فرمود حتی قیامت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 121.48,
   "end": 127.52,
   "text": "به محض اینکه ما مردیم آنچه که ما اونجا صور و اشکال می‌بینیم حتی در برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 127.52,
   "end": 130.16,
   "text": "منفصل بیرون از خودمون، اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 130.16,
   "end": 133.7,
   "text": "ما یه عالم هرچی بیرون داریم تو خودمون هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.7,
   "end": 138.12,
   "text": "اگر بیرون عالم عقول و ملائکه و مجردات طامه داریم تو خودمونم عقل داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 138.12,
   "end": 142.0,
   "text": "اگه بیرون مثال مت-- منفصل، بی فصل، جداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 142.0,
   "end": 145.28,
   "text": "جدا داریم یا برزخ که مردم مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 145.28,
   "end": 149.5,
   "text": "ارواح امم از اموات الان اونجان، تو خودمونم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 149.5,
   "end": 152.28,
   "text": "چیز عجیبی نیست اینا رو ازش فرار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 152.28,
   "end": 154.38,
   "text": "هرچی کوه بیرون هست تو خود--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 154.38,
   "end": 158.78,
   "text": "کوه نماد عظمت و س-ستوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 158.78,
   "end": 162.18,
   "text": "عاد انسانه. ننه نماد اقتداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 162.18,
   "end": 166.2,
   "text": "دریا نماد وسعت و زلال بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 166.2,
   "end": 170.06,
   "text": "وجود ماست. اینا همه در خودمون یه نمادی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 170.06,
   "end": 171.72,
   "text": "ملک بدن داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 171.72,
   "end": 173.9,
   "text": "ملک هم که بدن عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 173.9,
   "end": 183.6,
   "text": "حالا در به هر حال اونجام که وقتی ما می‌ریم عزیزان آنچه که ما صور و اشکال در برزخ اونجا می‌میریم‌ها می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 183.6,
   "end": 186.28,
   "text": "بر اساس ملکات نفسمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 186.28,
   "end": 189.7,
   "text": "ملکات اون چیزیه که رسوخ شده تو نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 189.7,
   "end": 192.26,
   "text": "چگونه راسخ می‌شه؟ ملکه می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 192.26,
   "end": 196.6,
   "text": "قبلاً گفتیم بر اساس تکرار و اصرار هر عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 196.6,
   "end": 198.66,
   "text": "وقتی یه عملی چه خوب چه بد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 198.66,
   "end": 202.32,
   "text": "اصرار شد، تکرار شد، می‌شه ملکه نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 202.32,
   "end": 205.26,
   "text": "و اونچه که ما صور و اشکال می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 205.26,
   "end": 210.16,
   "text": "یا خودمون، خودمون به اون صور و اشکال در میایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 210.16,
   "end": 213.56,
   "text": "بعد از مرگ بر اساس ملکات نفسمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 213.56,
   "end": 218.14,
   "text": "پس این. بعد حالا حضرت استاد می‌فرماید وقتی شما حیوانات رو نگاه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 218.14,
   "end": 221.48,
   "text": "می‌بینی که این‌ها احوالات‌شون، افعال‌شون، این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 221.48,
   "end": 223.56,
   "text": "می‌بینی تمثلات همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 223.56,
   "end": 230.64,
   "text": "ملکات نفسن. بر اساس این هم ما آیات زیاد داریم، حکایت زیاد داریم، روایت زیاد داریم تا دلت بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 230.64,
   "end": 234.96,
   "text": "مثلا همون عالم، عالمی که حالا اسمشون یادم نیست از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 234.96,
   "end": 239.14,
   "text": "بزرگان بودن. دم حرم دیدن که یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 239.14,
   "end": 241.36,
   "text": "سگ، یه جنازه‌ای رو دارن می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 241.36,
   "end": 244.46,
   "text": "معروفه زیاد شنیدید. یه سگی روی جنازه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 244.46,
   "end": 248.18,
   "text": "به بغل دستی‌ش زد که می‌بینی روی تابوت این آقا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 248.18,
   "end": 250.48,
   "text": "گفت نه من چیزی نمی‌بینم. فهمید که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 250.48,
   "end": 253.58,
   "text": "از تمثلات خودشه، کشفیات خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 253.58,
   "end": 255.48,
   "text": "فهمید هر کسی نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 255.48,
   "end": 261.6,
   "text": "بعد تا رسید به حرم می‌خواست جنازه رو دیدی می‌برن مثلا حرم امامزاده تعارف می‌کنن یا امامزاده‌ها سگه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 261.6,
   "end": 264.28,
   "text": "سگه همونجا پرید پایین. پرید پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 264.28,
   "end": 267.18,
   "text": "نشد. نتونست. لا یمست ول المتحرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 267.18,
   "end": 269.56,
   "text": "راه نمیدن تو. حرامه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 269.56,
   "end": 271.72,
   "text": "اون تو راه. پرید پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 271.72,
   "end": 278.22,
   "text": "بعد وقتی دوباره بدن رو برگردوند عالم دید که سگ دوباره جهید روی تابوت رفت داخل قبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 278.22,
   "end": 279.92,
   "text": "چرا؟ این تمثلاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 279.92,
   "end": 283.46,
   "text": "تمثلات اعمالشه تا قیامت، قیامتم باهاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 283.46,
   "end": 287.32,
   "text": "یعنی خودشه اصلاً. ما این حکایت‌های اینطوری زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 287.32,
   "end": 291.28,
   "text": "آیات قرآن چگونه؟ مثلاً آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 291.28,
   "end": 293.64,
   "text": "صد و هفتاد و نه اعراف. زیاد شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 293.64,
   "end": 298.46,
   "text": "زیاد هم ما اینجا خوندیم. و لقد ذرأنا لجهنم كثيرا من الجن والانس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 298.46,
   "end": 301.98,
   "text": "بسیاری از این‌ها رو مثلا برای آتیش خلق کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 301.98,
   "end": 305.42,
   "text": "لهم قل-- چرا؟ لهم قلوب لا يفقهون بها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 305.42,
   "end": 308.94,
   "text": "دل دارن. اصلا اهل تفقه و عمیق شدن نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 308.94,
   "end": 313.62,
   "text": "ولهم اعین لا یبصرون بها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 313.62,
   "end": 315.6,
   "text": "چشم دارن نمی‌بینن حقایقو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 315.6,
   "end": 317.92,
   "text": "ولهم اذان لا يسمعون بها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 317.92,
   "end": 320.04,
   "text": "گوش دارن، اهل شنیدن نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 320.04,
   "end": 323.58,
   "text": "دل و جان، گوش جان نمی‌سپارن به حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 323.58,
   "end": 326.68,
   "text": "برای همین آیه قرآن دارم می‌خونم برا خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 326.68,
   "end": 330.9,
   "text": "اولئک کل An'am اینا مثل حیواناتن بل هم اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 330.9,
   "end": 333.9,
   "text": "اولئک هم الغافلون. به جهت غفلت‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 333.9,
   "end": 336.68,
   "text": "مثل حیوانات بلکه پست‌تر از حیواناتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 336.68,
   "end": 341.12,
   "text": "پیغمبر در اون سفر معراجیه‌شون که کشف تام کردن رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 341.12,
   "end": 342.66,
   "text": "دیدن دیگه صور و اشکال رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 342.66,
   "end": 345.96,
   "text": "می‌گفتن ده قسط شده بودن امت من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 345.96,
   "end": 348.04,
   "text": "و چقدر دردناکه اون حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 348.04,
   "end": 353.04,
   "text": "صور-- صورت‌هایی که اونجا می-می‌بینن پیغمبر و نقل می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 353.04,
   "end": 355.76,
   "text": "حالا یه آیه دیگه مثلا آیه چهل و چهار فرقان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 355.76,
   "end": 358.92,
   "text": "الان اینجا موقع نماز دیدم سریع نوشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 358.92,
   "end": 363.6,
   "text": "ان تحسبن ان اکثرهم يسمعون او يعقلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 363.6,
   "end": 368.78,
   "text": "تو اینا رو گمان می‌کنی اکثرشون مثلا اهل تعقل و شنیدن و اینا هستن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 368.78,
   "end": 371.1,
   "text": "اما نه ان هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 371.1,
   "end": 374.54,
   "text": "الا كالأنعام بل هم أول سبیلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 374.54,
   "end": 377.54,
   "text": "مثل حیوونن بلکه پست‌تر از ایناست راهشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 377.54,
   "end": 379.34,
   "text": "اینو آقا قرآن داره میگه ما نمیگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 379.34,
   "end": 386.82,
   "text": "روایات مثلا در مجمع البيان طبرسی علیه الرحمه از پیامبر روایتی آورده که گروه‌هایی از امت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 386.82,
   "end": 389.56,
   "text": "به صورت‌های مختلفی محشور می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 389.56,
   "end": 391.76,
   "text": "توجه بفرمایید میگه امت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 391.76,
   "end": 395.96,
   "text": "من یعنی امتی مسلمانن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 395.96,
   "end": 400.98,
   "text": "محشور میشن برخی به صورت میمون، برخی به صورت خوک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 400.98,
   "end": 403.3,
   "text": "چرا؟ به جهت تمثلات دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 403.3,
   "end": 405.96,
   "text": "تمثلات ملکات نفسشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 405.96,
   "end": 409.98,
   "text": "مثلا پی-- خود حضرت اس-- خود حضرت امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 409.98,
   "end": 414.38,
   "text": "فرمود کسی که عادت کرده به صبوعیت یعنی وحشی‌گری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 414.38,
   "end": 416.66,
   "text": "خب چه بعید که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 416.66,
   "end": 419.72,
   "text": "بعید هم نیست که مثلا به شکل کلب، سگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 419.72,
   "end": 422.42,
   "text": "محشور بشه. سگ صفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 422.42,
   "end": 427.26,
   "text": "روی روایت دیگه‌ای در تنزیه الخواطر و نزهت النواظر، نواظر دیده‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 427.26,
   "end": 431.0,
   "text": "حالا این همون مجموعه بررام، معروف به مجموعه بررامه این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 431.0,
   "end": 437.9,
   "text": "اونجا روایت هست که پیغمبر فرمود آدمای زورگو و متکبر و این‌ها روز قیامت مثل مورچه‌های ریز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 437.9,
   "end": 443.42,
   "text": "پراکندن و اینا به جهت پستی که پیش خدا دارن اینا مردم لگدمالشون می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 443.42,
   "end": 445.74,
   "text": "و اینا که لگدکوب میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 445.74,
   "end": 448.54,
   "text": "حالا بعضی از عرفا گفتن چرا به مورچه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 448.54,
   "end": 452.18,
   "text": "چون اینجا متکبر بودن، پست فطرت بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 452.18,
   "end": 457.1,
   "text": "اونجا هم لا-- ظاهرا تمثل نفس خوارشونه، نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 457.1,
   "end": 459.46,
   "text": "پستشونه، ضعیف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 459.46,
   "end": 461.82,
   "text": "اونجا هم همینطور مثل مورچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 461.82,
   "end": 464.98,
   "text": "ببین تمام. حالا یه روایت خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 464.98,
   "end": 468.6,
   "text": "عجیب که خیلی این روایت عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 468.6,
   "end": 475.08,
   "text": "من جرات نمی‌کردم این روایت رو بگم تا اینکه یعنی بازش کنم تا اینکه دیدم یکی از بزرگان علمای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 475.08,
   "end": 480.78,
   "text": "از اساتید ما گفته دیگه ما هم جرات کردیم بگیم که اینو حتما شنیدید اما ببینید درون مایه اش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 480.78,
   "end": 483.82,
   "text": "حالا یه وجهش رو من باز کنم و ربطش با بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 483.82,
   "end": 487.02,
   "text": "امام صادق صلوات الله علیه فرمود اما اینو خوب گوش بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 487.02,
   "end": 490.3,
   "text": "چون مرتبطه با هممونه به نوعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 490.3,
   "end": 494.5,
   "text": "درک کردیم تو روزگارمون. فرمود شب عاشورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 494.5,
   "end": 498.66,
   "text": "حیوانات اهلی و احشی و وحشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 498.66,
   "end": 503.16,
   "text": "، اذل بهوش و هوشرت، حیوانات اهلی و وحشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 503.16,
   "end": 505.8,
   "text": "گرد هم جمع میشن. متفقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 505.8,
   "end": 509.48,
   "text": "برای جد ما حسین عزاداری می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 509.48,
   "end": 514.48,
   "text": "ما کی تا حالا دیدیم مثلا گرگ و آهو شب عاشورا بیان کنار هم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 514.48,
   "end": 520.1,
   "text": "کی حالا تازه شب عاشورا که می‌بینیم چقدر این حیوانات اهلی رو ما می‌کشیم و سر می‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 520.1,
   "end": 524.78,
   "text": "کی ما حالا، حالا می‌بینیم یک، یک عالم با ذره‌بین طهارت نفس اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 524.78,
   "end": 527.78,
   "text": "نگاه می‌کنه، یه وجهش رو برای ما باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 527.78,
   "end": 532.36,
   "text": "فرمود منظور همون تمثلات و ملکات انسان‌هان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 532.36,
   "end": 534.92,
   "text": "حیوانات اهلی و وحشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 534.92,
   "end": 536.48,
   "text": "یعنی آدمایی که‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 536.48,
   "end": 540.42,
   "text": "آدمایی که اهلی‌اند، آدمایی که وحشی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 540.42,
   "end": 545.16,
   "text": "آدما، نه حیوانات. این که میگه حیوانات اهلی و وحشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 545.16,
   "end": 546.9,
   "text": "یعنی همه آدم‌های ماهاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 546.9,
   "end": 549.86,
   "text": "جسارت می‌کنم امثال من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 549.86,
   "end": 553.68,
   "text": "که حالا شب عاشورا میاد تو هیئتا چه دعواهایی هم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 553.68,
   "end": 555.68,
   "text": "چه بکش و بکش تو بعضی هیئتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 555.68,
   "end": 562.16,
   "text": "چه داد و فریاد سر علم‌کشی و سر این و اون و این دو طرفدار مرید اونه، اون مرید اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 562.16,
   "end": 564.92,
   "text": "اینا حیوانان اما خب کاری به هم ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 564.92,
   "end": 568.46,
   "text": "وحشی و اهلی قاطی. هم تو شراب خوره هم دهنشو می‌شوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 568.46,
   "end": 571.9,
   "text": "میاد تو هیئت امام حسین. امام صادق فرموده اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 571.9,
   "end": 578.16,
   "text": "ببینید این که قرآن می‌فرماید جزاء وفقا، جزای اینا موافق اعمالشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 578.16,
   "end": 582.16,
   "text": "از اون طرف می‌فرماید فمن يعمل مثقال ذرة خيرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 582.16,
   "end": 585.46,
   "text": "خیرا يره. این ضمیر به کجا برمی‌گرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 585.46,
   "end": 589.22,
   "text": "يره چی رو می‌بینه؟ اون خیر رو می‌بینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 589.22,
   "end": 594.54,
   "text": "شر و خیر رو می‌بینه. يره یعنی عین عمل رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 594.54,
   "end": 598.04,
   "text": "چگونه می‌بینه؟ به تمثلات ملکات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 598.04,
   "end": 602.08,
   "text": "از این بترسیم. و حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 602.08,
   "end": 603.94,
   "text": "بعضیا میگن آقا مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 603.94,
   "end": 606.46,
   "text": "شما حرفات یه مقدار عجیب غریبه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 606.46,
   "end": 609.44,
   "text": "نه اینا ما ازش دوریم. اینا عجیب غریب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 609.44,
   "end": 611.72,
   "text": "مثل این که بگه آقا شما چرا سالمی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 611.72,
   "end": 614.98,
   "text": "شما چ-- ببخشید شما چرا-- اه آره همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 614.98,
   "end": 617.48,
   "text": "چرا سالمی؟ چرا شما همه سالمید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 617.48,
   "end": 619.94,
   "text": "ما میگیم آقا اصل بر اینه که همه سالم باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 619.94,
   "end": 623.26,
   "text": "اسم از سلام خدا داره پیاده میشه در عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 623.26,
   "end": 629.1,
   "text": "انقدر همه مریضن ما یکی که سالمه میگیم عجب آدم سالمه!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 629.1,
   "end": 632.02,
   "text": "این آقا سردرد نداره، این آقا مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 632.02,
   "end": 634.28,
   "text": "خب بابا اصل بر این بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 634.28,
   "end": 637.42,
   "text": "نفس ناطقه ما مجرده یا ماده‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 637.42,
   "end": 640.42,
   "text": "همه میگید مجرده یعنی مربوط به عالم ماده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 640.42,
   "end": 644.58,
   "text": "پس اصل بر اینه که ما ارتباط داشته باشیم با عالم مجردات و عقول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 644.58,
   "end": 649.26,
   "text": "عقل داریم دیگه و مرتبط باشیم با عالم عقول بیرون، با مجردات، با ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 649.26,
   "end": 652.8,
   "text": "شب قدر از الان ملائک و الروح اینا میان که این کارو آسون کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 652.8,
   "end": 654.68,
   "text": "اما ما یه نفر، یه خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 654.68,
   "end": 662.1,
   "text": "خوب، یه کشف تام خوب، یه چه می‌دونم تمثل قشنگ اینا تو همین جزئیاتش تازه جرات نمی‌کنه به دیگری بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 662.1,
   "end": 665.14,
   "text": "انقدر که حرف در میاد. او آقا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 665.14,
   "end": 667.64,
   "text": "خواب دیده، آقا ک-- تمثلی براش رخ داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 667.64,
   "end": 670.68,
   "text": "این چرت و پرت‌ها چیه میگی فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 670.68,
   "end": 675.08,
   "text": "توجه کردید؟ اینا خیلی بده. یعنی ما انقدر اکثرمون مریض شدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 675.08,
   "end": 679.62,
   "text": "حقایقی که مثل مثلا یکی از علما حسن زاده میاد راحت تو کتاب انفاق و ارسا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 679.62,
   "end": 682.76,
   "text": "انسان در عرف عرفانش تمثلاتشو میگه، می‌خندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 682.76,
   "end": 684.9,
   "text": "بعد این کتابو هدیه میکنه به رهبرمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 684.9,
   "end": 687.02,
   "text": "همین کتابی که تمثلاتش توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 687.02,
   "end": 693.98,
   "text": "چون اون می‌فهمه. خب انشالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 693.98,
   "end": 697.54,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 697.54,
   "end": 699.72,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}