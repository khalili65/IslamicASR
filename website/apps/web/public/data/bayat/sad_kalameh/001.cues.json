 },
 "chapters": [
  {
   "index": 0,
   "title": "## درآمد بر سیرِ معرفتِ نفس",
   "start": 0.76,
   "end": 96.34
  },
  {
   "index": 1,
   "title": "علامه سند می‌آورد از قولِ او سبحانه در سورهٔ شمس:",
   "start": 96.34,
   "end": 235.64
  },
  {
   "index": 2,
   "title": "## سخنِ ملاصدرا؛ مفتاحُ العلومِ قیامت",
   "start": 235.64,
   "end": 356.16
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.76,
   "end": 4.52,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.52,
   "end": 7.68,
   "text": "آیاته سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.68,
   "end": 15.66,
   "text": "قبل از این که تسبیحات رو بفرستید نصاح حضرت علامه حسن زاده علیه الرحمه صلوات از قلبتون بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.66,
   "end": 21.16,
   "text": "اللهُم صَلّ عَلَى مُحَمَّد وَآلِ مُحَمَّد وَعَجِّل فَرَجَهُم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.16,
   "end": 23.54,
   "text": "به فضل الهی مقدمه‌ای رو بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.54,
   "end": 26.66,
   "text": "سیر معرفت نفس تو پنج دقیقه می‌ریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.66,
   "end": 31.62,
   "text": "دقت بفرمایید این کتابی که دست بنده است کتاب گنجینه گوهر روان حضرت علامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.62,
   "end": 37.24,
   "text": "کتاب بسیار گرانسنگی‌ست و جای تدریس در دانشگاه‌ها و حوزه و اینا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.24,
   "end": 45.78,
   "text": "که البته در مقدمه‌ی این کتاب استثنااً صد کلمه در معرفت نفس ایشون هم خودشون اضافه کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.78,
   "end": 48.36,
   "text": "که من ابتداش رو براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.36,
   "end": 50.96,
   "text": "در ایشون می‌فرماید در اصول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.96,
   "end": 54.9,
   "text": "در علوم اصیل عقلی و اصول معارف حقیقی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.9,
   "end": 57.3,
   "text": "پس از معرفت حق سبحانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.3,
   "end": 62.86,
   "text": "هیچ موضوعی برای انسان به پایه‌ی اهمیت معرفت نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.86,
   "end": 64.8,
   "text": "اعنی روانشناسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.8,
   "end": 67.92,
   "text": "اون روانشناسی غربی و اینا رو ن-نگاه نکنید چی می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.92,
   "end": 72.16,
   "text": "روانشناسی اصلی اینه. همون شناخت معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.16,
   "end": 76.18,
   "text": "زیرا که اساس دینداری-- چرا این از همه معرفت اِ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.18,
   "end": 78.16,
   "text": "عرض شود عظمتش بالاتره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.16,
   "end": 83.28,
   "text": "چرا؟ می‌فرماید زیرا که اساس دینداری و رستگاری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.28,
   "end": 85.24,
   "text": "بر اساس چی اینو علامه می‌فرماید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.24,
   "end": 91.06,
   "text": "سند میاره. قول او سبحانه از سوره شمس از علامه اینو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.06,
   "end": 93.24,
   "text": "دقت بفرمایید. می‌گه دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.24,
   "end": 97.9,
   "text": "ببینید خود قرآن فرموده \"ونفس وما سواها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.9,
   "end": 102.56,
   "text": "سواها این یعنی همون حالت اعتدال، معتدل، نیکوترین وجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.56,
   "end": 105.66,
   "text": "nefsi که ما به بهترین وجه ممکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.66,
   "end": 111.24,
   "text": "به حالت اعتدال او رو ایجادش کردیم، انشاش کردیم که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.24,
   "end": 113.34,
   "text": "اگر پیگیر باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.34,
   "end": 118.38,
   "text": "آیه بیست و نه سوره حجر البته اینجا علامه نیاورده من اضافه می‌کنم ذیلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.38,
   "end": 122.54,
   "text": "اونجا خدای معنان فرمود \"فَإِذَا سَوَّيْتُهُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.54,
   "end": 127.7,
   "text": "وقتی من اینو \"سَوَّيْتُهُ\" اینجا می‌فرماید که \"ونفس وما سواها\" اونجا می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.7,
   "end": 132.16,
   "text": "\"فَإِذَا سَوَّيْتُهُ\" وقتی من به نحو احسن به اعتدال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.16,
   "end": 135.22,
   "text": "و به بهترین وجه و نیکوترین وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.22,
   "end": 140.22,
   "text": "خلقش کردم، این نفس ناطقه من و شما رو \"ونفخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.22,
   "end": 142.06,
   "text": "فيه من روحي\" وقتی از روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.06,
   "end": 148.9,
   "text": "خودم در او دمیدم \"فَقَعُوا لَهُ سَاجِدِينَ\" حالا به سجده به جهت عظمتش به سجده بیفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.9,
   "end": 151.68,
   "text": "انقدر که این نفس محترم است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.68,
   "end": 153.36,
   "text": "انقدر که حرمت دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.36,
   "end": 155.86,
   "text": "حالا ما بی‌حرمتی به خودمون می‌کنیم بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.86,
   "end": 157.96,
   "text": "گناه یعنی بی‌حرمتی به خود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.96,
   "end": 161.66,
   "text": "یعنی بدون وضو دست زدن به کتاب وجود خودت که قرآنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.66,
   "end": 166.7,
   "text": "تو قرآنی. اجازه نداری دست به قرآن بزنی بدون وضو، بدون طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.7,
   "end": 168.74,
   "text": "وقت گناه بدون طهارت داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.74,
   "end": 171.66,
   "text": "سطح، سطح کتاب وجودی خودت رو چیکار می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.66,
   "end": 174.24,
   "text": "دست می‌زنی و حرمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 174.24,
   "end": 177.24,
   "text": "حالا ادامه‌ش \"ونفس وما سواها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 177.24,
   "end": 179.54,
   "text": "فألهمها فجورها وتقواها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.54,
   "end": 181.86,
   "text": "خیلی خدا حال داده به بنده‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 181.86,
   "end": 187.14,
   "text": "اونچه که خوبی و خیراته و اونچه که زشتی و پلیدی‌ست \"فألهمها\" الهام کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 187.14,
   "end": 191.32,
   "text": "لذا هرچی، تو به هرچی می‌رسی از درون خودت می‌جوشه عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 191.32,
   "end": 193.36,
   "text": "بله. تمام. فصل الخطاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 193.36,
   "end": 195.26,
   "text": "\"قد أفلح من زكاها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 195.26,
   "end": 197.94,
   "text": "می‌خوای رستگار بشی؟ سعادتمند بشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 197.94,
   "end": 200.16,
   "text": "\"من زکاها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 200.16,
   "end": 202.96,
   "text": "این \"ها\" ضمیر بر می‌گرده به اون نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 202.96,
   "end": 205.52,
   "text": "هرکی نفسش رو پاکیزه نگه داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 205.52,
   "end": 208.06,
   "text": "\"زکاها\" رستگاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 208.06,
   "end": 210.3,
   "text": "\"زکاها\" پاکیزه‌اش کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 210.3,
   "end": 212.86,
   "text": "و این رو حذف کرد از همه زشتی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 212.86,
   "end": 218.4,
   "text": "و \"وقد خاب من\" می‌خوای بهتون بگم به تحقیق چه کسی خسران زده و بیچاره‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 218.4,
   "end": 220.08,
   "text": "\"من دساها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 220.08,
   "end": 224.56,
   "text": "هرکسی که این نفس رو پلیدش کنه، با گناه آلوده‌اش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 224.56,
   "end": 230.06,
   "text": "پس از اینجا می‌فهمیم اصلاً سعادت ما، شقاوت ما، همه چی در گرو نفس ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 230.06,
   "end": 232.94,
   "text": "که رفتار ما با این نفس چگونه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 232.94,
   "end": 235.64,
   "text": "قرآن داره می‌فرماید. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 235.64,
   "end": 240.78,
   "text": "ملاصدرا در همین خصوص از جهت تشریف و تعظیم اهمیت نفس ببینید چی می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 240.78,
   "end": 243.4,
   "text": "غوغا کرده ملاصدرا تو این جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 243.4,
   "end": 245.6,
   "text": "در کتاب نفس اسفارش اگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 245.6,
   "end": 248.5,
   "text": "ملاحظه فرموده باشید این جمله رو براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 248.5,
   "end": 253.44,
   "text": "طولانیه، یه بخشش رو. \"مفتاح العلوم بيوم القيامة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 253.44,
   "end": 259.48,
   "text": "دنبال کلیدی؟ ار-- باارزش‌ترین چیزها در نظام هستی علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 259.48,
   "end": 263.04,
   "text": "که اصلاً حکما می‌گن عین علم، عین خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 263.04,
   "end": 265.66,
   "text": "اصلاً خود علم یعنی حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 265.66,
   "end": 267.28,
   "text": "درست شد؟ علم یعنی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 267.28,
   "end": 270.44,
   "text": "که علامه می‌فرماید عالم علم انباشته شده روی هم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 270.44,
   "end": 275.46,
   "text": "حالا می‌فرماید قیامت که تو کلید می‌خوای بعد امیرالمؤمنین فرمود \"العلم سلطان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 275.46,
   "end": 277.58,
   "text": "اصلاً سلطنت بر اساس علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 277.58,
   "end": 281.66,
   "text": "علم داشته باشی به نسبت علمت س-سلطنت پیدا می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 281.66,
   "end": 285.34,
   "text": "و سلطه بر نفوس دیگه بهت می‌دن که معنای ولایت دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 285.34,
   "end": 290.14,
   "text": "هرکی هرچی عمومی‌تر شد، ولایت کلیه‌تر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 290.14,
   "end": 292.0,
   "text": "اینجا می‌فرماید، کی؟ ملاصدرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 292.0,
   "end": 299.92,
   "text": "\"مفتاح العلوم\". اون کلید همه‌ی این علوم \"بيوم القيامة\" تازه اونجا که دیگه قیامت‌ها قیام می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 299.92,
   "end": 304.16,
   "text": "باطن‌ها ظاهر می‌شود \"ومعاد الخلائق\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 304.16,
   "end": 307.6,
   "text": "اون که عود می‌کنند همه خلائق بر می‌گردن چیه اونجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 307.6,
   "end": 310.78,
   "text": "مفتاح همه علوم. \"هو معرفة النفس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 310.78,
   "end": 313.3,
   "text": "الله اکبر. \"هو معرفة النفس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 313.3,
   "end": 316.18,
   "text": "تمام. این \"هو\" هم میاره خیلی تأکید می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 316.18,
   "end": 318.44,
   "text": "\"هو معرفة النفس\". تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 318.44,
   "end": 320.62,
   "text": "یه جمله دیگه هم بگم که تمام کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 320.62,
   "end": 324.74,
   "text": "فکر کنم پنج دقیقه شد. شرح هدایه ابن عسیر هم یه جمله رو براتون بیارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 324.74,
   "end": 327.94,
   "text": "اینم طولانیه البته. \"علم النفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 327.94,
   "end": 331.84,
   "text": "هي أم الحكمة وأصل الفضائل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 331.84,
   "end": 335.92,
   "text": "اصل یعنی ریشه به عربی. ریشه‌ی همه‌ی فضیلت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 335.92,
   "end": 341.48,
   "text": "و عرض شود خدمتتون مادر حکمت‌ها چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 341.48,
   "end": 345.44,
   "text": "معرفت نفس. حالا باید بری اِاِاِ حکمت رو ترجمه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 345.44,
   "end": 347.44,
   "text": "چیه که مادرش شده معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 347.44,
   "end": 354.34,
   "text": "انشاالله جلسات بعدی عاقبتون به خ-- حتمن به خیر بشود به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 354.34,
   "end": 356.16,
   "text": "اللهُم صَلّ عَلَى مُحَمَّد وَآلِ مُحَمَّد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}