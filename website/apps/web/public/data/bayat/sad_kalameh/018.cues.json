 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ هفده؛ جدولِ دریای بیکران هستی",
   "start": 10.92,
   "end": 86.08
  },
  {
   "index": 1,
   "title": "## بابا افضل کاشی در ممد الهمم",
   "start": 86.08,
   "end": 106.3
  },
  {
   "index": 2,
   "title": "### تنزیل از عزیز رحیم؛ فهم از ملکوت",
   "start": 106.3,
   "end": 246.62
  },
  {
   "index": 3,
   "title": "## موج و دریا؛ الهی‌نامه",
   "start": 246.62,
   "end": 350.02
  },
  {
   "index": 4,
   "title": "## حدیث سنگینِ امام صادق از صاحب عوارف",
   "start": 350.02,
   "end": 450.74
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 2.68,
   "text": "رحیم و به He nastعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.68,
   "end": 6.58,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.58,
   "end": 10.92,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.92,
   "end": 19.76,
   "text": "کلمه هفده. آن که خود را جدولی از دریای بیکران هستی نیافته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.76,
   "end": 23.9,
   "text": "در تحصیل معارف و ارتقایش چه می‌اندیشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.9,
   "end": 28.8,
   "text": "اینجا حضرت علامه توجه ما را جلب می‌کنند به درون خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.8,
   "end": 30.48,
   "text": "همون درس دیروزشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.48,
   "end": 34.46,
   "text": "ولی تلطف. تلطیف سر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.46,
   "end": 37.72,
   "text": "پیدا کردن گم شده‌ها در درون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.72,
   "end": 42.72,
   "text": "که سال‌ها دل طلب جام جم از ما می‌کرد آنچه خود داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.72,
   "end": 48.52,
   "text": "ز بیگانه‌ تمنا می‌کرد. اونچه که در حصه وجودی ماست، در درون ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.52,
   "end": 51.08,
   "text": "هرچی که هست اونه. سر وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.08,
   "end": 56.1,
   "text": "به یک معنا بنا به تعبیر بعضی روایات اسم اعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.1,
   "end": 61.28,
   "text": "همون ذات وجود ما که متصل است به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.28,
   "end": 65.28,
   "text": "از طریق رب، رب وجودی‌مون متصل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.28,
   "end": 67.66,
   "text": "به الهیت نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.66,
   "end": 72.9,
   "text": "و مرتبه الهیت هم که قلب عالم بود و پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.9,
   "end": 78.5,
   "text": "یعنی ما از طریق اون جدول وجودی‌مون متصل می‌شیم به رب پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.5,
   "end": 83.8,
   "text": "و دیگه متصل می‌شیم به اون دریای لایتناهی حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.8,
   "end": 91.16,
   "text": "کلیه. حالا اگر ممد الهمم رو توجه کرده باشید، اونجا حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.16,
   "end": 97.62,
   "text": "تو همین رابطه اشاره می‌کنه به حرف، حرف صحبت بسیار شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.62,
   "end": 103.98,
   "text": "بابا افضل کاشی که اونجا ایشون یه رساله‌ای داره بعد حضرت علامه تو ممد الهمم اشاره می‌کنه به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.98,
   "end": 106.3,
   "text": "جمله از رساله ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.3,
   "end": 107.84,
   "text": "این عین کلام علامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.84,
   "end": 111.44,
   "text": "می‌فرمایند درون را نگاه کن که از بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.44,
   "end": 115.12,
   "text": "افضل کاشی داره میگه. درون را نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.12,
   "end": 117.24,
   "text": "بیرون را نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.24,
   "end": 123.1,
   "text": "نمی‌دانی خودت دروازه‌ای هستی برای همه عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.1,
   "end": 128.12,
   "text": ". یعنی به هر کجا می‌خوای برسی از دروازه وجود خودت، از خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.12,
   "end": 132.9,
   "text": "بعد ادامه میده. حرف اینها رسیدن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.9,
   "end": 138.16,
   "text": "یعنی باید برسی. تمثلات باید در خودت پیاده شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.16,
   "end": 141.9,
   "text": "بعد اشاره می‌کنم به آیه تنزيل العزيز الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.9,
   "end": 145.4,
   "text": "تنزيل از سمت و ناحیه العزيز الرحيم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.4,
   "end": 148.48,
   "text": "تنزل پیدا می‌کنه حقایق میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.48,
   "end": 153.46,
   "text": "پله پله خاطرات و واردات و الهامات پیش می‌آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.46,
   "end": 156.14,
   "text": "این صحبت بابا افضل کاشیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.14,
   "end": 159.4,
   "text": "میگه توجه داشته باش که حقایق از عالم بالا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.4,
   "end": 162.58,
   "text": "از سمت العزيز الرحيم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.58,
   "end": 167.74,
   "text": "اینکه استاد، کتاب، صوت، اینا همه مربوط به عالم ماده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.74,
   "end": 173.28,
   "text": "داری می‌شنوی. یه چیزی متوجه میشی در عالم ماده یه صوتی بهت می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.28,
   "end": 175.84,
   "text": "یه نوشته‌ای، یه جوهری رو کاغذ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.84,
   "end": 178.06,
   "text": "بفرما ببینم اینی که شما خوندی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.06,
   "end": 182.96,
   "text": "فهم این، درک این، چشیدن این حقیقت از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.96,
   "end": 185.24,
   "text": "اون مربوط به ملکوت عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.24,
   "end": 191.82,
   "text": "یعنی از ملکوت حقیقت تنزل پیدا می‌کنه در وجود من و شما که ما می‌فهمیم حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.82,
   "end": 195.48,
   "text": "به عبارتی می‌چشیم. علم فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.48,
   "end": 200.36,
   "text": "اونه که فقط یه صوتی رو می‌شنوی، یه جوهری رو کاغذ می‌بینی، حس می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.36,
   "end": 208.12,
   "text": "اما وقتی این رو متوجه میشی به قول علامه جدول وجودیت رو که وصل به دریای بیکران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.12,
   "end": 213.68,
   "text": "حقیقت، اون جدول ول-وجودیت رو لای روبی می‌کنی از چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.68,
   "end": 216.04,
   "text": "از گناهان، از قذارات، از آلودگی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.04,
   "end": 219.18,
   "text": "چه اتفاقی میفته؟ وصل میشی به دریا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.18,
   "end": 222.36,
   "text": "وصل میشی که به دریا دیگه وصل به کر شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.36,
   "end": 225.16,
   "text": "بعد حقایق از اونجا بر تو نازل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.16,
   "end": 228.7,
   "text": "فهم مال اونجاست. لذا هیچ شاگردی بارها عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.7,
   "end": 233.88,
   "text": "نمی‌تونه اهانت کنه به شا-استادش، معلمش بگه تو در حق من کم گذاشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.88,
   "end": 237.88,
   "text": "تو به من نفهموندی. نخیر. جدول وجودی شما ضعیف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.88,
   "end": 243.86,
   "text": "بفرمایید لای روبی کن به ف-به فرمایش حضرت علامه ببین حقایق چه جوری در درون خودت می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.86,
   "end": 250.44,
   "text": "اصلا کاری به بیرون نداری. بعد ایشون حضرت علامه باز اینجا می‌فرمایند در الهی نامه گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.44,
   "end": 256.02,
   "text": "الهی موج از دریا خیزد مثال دریا و موج رو می‌زنه نسبت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.02,
   "end": 264.06,
   "text": "با حضرت حق. دری-- الهی موج از دریا خیزد و با وی آمیزد و در وی گریزد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.06,
   "end": 267.86,
   "text": "و از وی ناگزیر است. انا لله و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.86,
   "end": 273.72,
   "text": "هیچ موجودی از حق انفصال یعنی ارسال به تمام حقیقت، حقیقت ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.72,
   "end": 276.12,
   "text": "أَن مَن شَاءَ اللَّهُ إِنَّا لَنَا خَزائِنُ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.12,
   "end": 278.26,
   "text": "همه از سمت حضرت حق اومدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 278.26,
   "end": 280.76,
   "text": "نازل شدن و اتصال برقراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 280.76,
   "end": 284.02,
   "text": "جدا نشدن. بل حقیقت به تمامه نازل نشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.02,
   "end": 287.18,
   "text": "که همه قائم به اوی‌اند و حق قيوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.18,
   "end": 290.48,
   "text": "اون حقی که من-- حالا اون دریا می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.48,
   "end": 294.76,
   "text": "تمثلاً میگه اون قيوم همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.76,
   "end": 296.64,
   "text": "لذا اینجا نتیجه رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 296.64,
   "end": 300.58,
   "text": "لذا همه القاءات آنسویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 300.58,
   "end": 304.22,
   "text": "از اون سوی عالم ملکوت می‌شه ها می‌خواد القایی بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 304.22,
   "end": 305.86,
   "text": "ندایی، تمثلی، هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.86,
   "end": 315.78,
   "text": "می‌فرماید از نداها، خطابات، تعلیمات، الهامات، منامات، تجلیات، مکاشفات، مراتب وحی حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 315.78,
   "end": 318.94,
   "text": ". و همچنین نداها و دعاهای اینسویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.94,
   "end": 322.5,
   "text": "از همین سو. میگه هرچی که هست علامه داره می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.5,
   "end": 326.7,
   "text": "همه از این جدول و حصه وجودی انسان صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.7,
   "end": 330.56,
   "text": "هرچی هست مطلقا در وجود خود انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.56,
   "end": 333.68,
   "text": "یعنی اینایی که به هر جا رسیدن از درون رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.68,
   "end": 336.6,
   "text": "اینایی هم که نرسیدن ، خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.6,
   "end": 338.44,
   "text": "جدول وجودی‌شونو مسدود کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.44,
   "end": 344.54,
   "text": "لای روبی نکردن. پر شد از آلودگی‌ها و اون سنگلاخ‌ها و مسدود شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.54,
   "end": 346.52,
   "text": "به روی حقایق. چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.52,
   "end": 350.02,
   "text": "دنبال درد و درمان تو خودمون باید بگردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.02,
   "end": 356.06,
   "text": "اتفاقاً حضرت علامه به اینجا که می‌رسن از صاحب عوارفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.06,
   "end": 359.7,
   "text": "حدیث بسیار عجیبی از امام صادق صلوات الله عليه نقل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 359.7,
   "end": 361.7,
   "text": "اینو بگم و امروز برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.7,
   "end": 364.02,
   "text": "این حدیث خیلی سنگینه، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.02,
   "end": 366.36,
   "text": "امام صادق داره می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 366.36,
   "end": 370.62,
   "text": "حق تعالی مرا از ذات خود آفرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.62,
   "end": 375.86,
   "text": "و حال اینکه من از او جدا نیستم زیرا که نور خورشید از او جدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.86,
   "end": 381.94,
   "text": "نیست. مثالی که عرفا می‌زنند نسبت ما با خدا مثل شو-خورشید است و شعاع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 381.94,
   "end": 384.7,
   "text": "نورش. امام صادق داره می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 384.7,
   "end": 388.5,
   "text": "و حال اینکه من از او جدا نیستم زیرا که نور خورشید از او جدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.5,
   "end": 391.7,
   "text": "سپس مرا به من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.7,
   "end": 393.88,
   "text": "مرا به من. این مرا به من یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.88,
   "end": 398.4,
   "text": "از همون جدول وجودی. یعنی اون حصه وجودی، اون اسم اعظم وجودی خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.4,
   "end": 400.84,
   "text": "مرا به من ندا فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.84,
   "end": 404.98,
   "text": "و از من یعنی از همون جدول وجودی من خطاب کرد و پس گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.98,
   "end": 409.56,
   "text": "من از تو کیستم؟ خدا، خدا میگه تو بگو من کیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.56,
   "end": 412.46,
   "text": "من کی هستم؟ پس به لطافتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.46,
   "end": 415.34,
   "text": "امام صادق می‌فرمود آخر حدیث رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.34,
   "end": 420.04,
   "text": "پس به لطافتم یعنی با اون لطاف-لطیفه روحانیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.04,
   "end": 425.92,
   "text": "نورanim جواب دادم که تو کل من و اصل منی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 425.92,
   "end": 431.4,
   "text": "از تو من ظاهر شدم و در من اشراق کرده‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.4,
   "end": 436.14,
   "text": "اصلاً هرچی در من رخ می‌ده از حقایق اشراق توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.14,
   "end": 438.8,
   "text": "هرچی هست از درون خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.8,
   "end": 441.26,
   "text": "هرچی می‌جوشه تو خود-خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.26,
   "end": 445.06,
   "text": "چه خرابی، چه خوبی. همه رو باید در درون خودت بگردی پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.06,
   "end": 447.32,
   "text": "ان شا الله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.32,
   "end": 450.28,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.28,
   "end": 450.74,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}