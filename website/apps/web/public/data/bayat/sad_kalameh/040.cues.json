   "start": 232.94,
   "end": 278.24
  },
  {
   "index": 5,
   "title": "## فصوص ابن‌عربی و علاقهٔ مستجن در نفس",
   "start": 278.24,
   "end": 559.92
  },
  {
   "index": 6,
   "title": "## وضع الکتاب؛ آیهٔ چهل‌ونه کهف",
   "start": 559.92,
   "end": 636.6
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.26,
   "end": 6.92,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.92,
   "end": 11.0,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.0,
   "end": 13.94,
   "text": "کلمه سی و نه. هدیه می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.94,
   "end": 17.08,
   "text": "ثواب این کلمات نورانی رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.08,
   "end": 19.88,
   "text": "رفتگان حادثه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.88,
   "end": 22.24,
   "text": "تأسف‌بار مترو پل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.24,
   "end": 25.28,
   "text": "آبادان. ان شا الله که روحشون شاد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.28,
   "end": 31.62,
   "text": "علامه علیه الرحمه در کلمه سی و نه می‌فرمایند \"آن که خود را ابدی شناخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.62,
   "end": 35.02,
   "text": "فکر ابدی کند.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.02,
   "end": 37.44,
   "text": "فکر ابد می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.44,
   "end": 42.46,
   "text": "کسی که واقعاً می‌دونه ابدیه، فکرش هم ابدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.46,
   "end": 47.9,
   "text": "کسی تو این دنیا به گونه‌ای رفتار می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.9,
   "end": 54.52,
   "text": "که هرچی می‌خوره و جمع می‌کنه سیر مونی نداره که گمان می‌کنه تا ابد تو دنیا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.52,
   "end": 60.74,
   "text": "قطعاً اینطوریه. شاید در علم نظری ازش بپرسی بگه نه آقا ما هم روزی می‌میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.74,
   "end": 65.56,
   "text": "ولی در عمل می‌بینی نه داره همینجوری اندوخته می‌کنه انگار تا ابد اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.56,
   "end": 69.04,
   "text": "یعنی باور نداره. کسی هم که اون ورا واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.04,
   "end": 76.64,
   "text": "باور داره که اون ور ابده و این آقایی که داره میره به جهت داشتن دست ناتقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.64,
   "end": 81.58,
   "text": "که بحثش قبلاً گذشت تو جزء مجرداته و حد یقف نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.58,
   "end": 84.74,
   "text": "و لا یتناحیه و الی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.74,
   "end": 90.6,
   "text": "و ان الی ربک منتهی و ان الی ربک رجعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.6,
   "end": 95.68,
   "text": "همه به سمت پروردگارتون رجعت می‌کنند و منتهی پروردگار تو sia.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.68,
   "end": 103.32,
   "text": "یا رسول الله و این رجعت که انا لله و در قوس نزول اومدیم و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.32,
   "end": 105.66,
   "text": "به سمت کی راجعون؟ الیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.66,
   "end": 110.98,
   "text": "انا لالله الیه، به سمت الله رجعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.98,
   "end": 114.38,
   "text": "خب الله هم که ابدیه. پس رجعت هم ابدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.38,
   "end": 116.92,
   "text": "حرکت لا یقفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.92,
   "end": 119.78,
   "text": "حرکت لا یقفیه. الی ماشاءالله برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.78,
   "end": 122.08,
   "text": "حالا یه عالمش اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.08,
   "end": 124.58,
   "text": "یه عالمش اینجاست تموم می‌شه میره عالم بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.58,
   "end": 128.76,
   "text": "تموم می‌شه میره عالم... همینطوری عوالم پشت هم قراره طی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.76,
   "end": 131.32,
   "text": "عالم رحم مگه تموم نشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.32,
   "end": 133.04,
   "text": "عالم صلح مگه تموم نشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.04,
   "end": 136.98,
   "text": "این‌ها عوالم بودند. عالم دنیا هم در حال تمام و زواله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.98,
   "end": 139.22,
   "text": "دوباره برزخ. اون هم تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.22,
   "end": 141.72,
   "text": "بعد عالم عقول تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.72,
   "end": 143.48,
   "text": "عالم الله تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.48,
   "end": 145.4,
   "text": "برو همینطوری الی ماشاءالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.4,
   "end": 149.16,
   "text": "مگه خدا تمامی داره که ما تموم شیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.16,
   "end": 153.84,
   "text": "اگر کسی این رو متوجه بشه دیگه علامه می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.84,
   "end": 156.5,
   "text": "به گونه‌ای رفتار می‌کنه که به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.5,
   "end": 159.38,
   "text": "برای ابدش، فکر ابدش رو می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.38,
   "end": 163.94,
   "text": "آیه هجده سوره هشت اتفاقاً که خدا رحمت کنه امام خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.94,
   "end": 170.16,
   "text": "پسرشون استاد احمد می‌گفتن خیلی امام به ما بچه‌هاش توصیه می‌کرد به آیات آخر سوره هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 170.16,
   "end": 176.16,
   "text": "مخصوصاً این آیه هجده‌ش که یا ایها الذين آمنوا اتقوا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.16,
   "end": 179.78,
   "text": "تقوای الهی پیشه کنید. حدود الهی رو رعایت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.78,
   "end": 182.3,
   "text": "ولتنظر نگاه کنید نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.3,
   "end": 184.02,
   "text": "ما قدمت لقد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.02,
   "end": 186.78,
   "text": "این نفستون چی آماده کرده برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.78,
   "end": 191.36,
   "text": "لقد، برای فردا. دو مرتبه باز می‌فرماید واتقوا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.36,
   "end": 193.9,
   "text": "بین دو تا اتقوا الله دو تا امر اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 193.9,
   "end": 197.08,
   "text": "چی؟ نگاه کن ببین نفست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.08,
   "end": 199.72,
   "text": "چی برای فرداش آماده کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 199.72,
   "end": 201.54,
   "text": "ان الله خبیر بما تعملون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 201.54,
   "end": 204.84,
   "text": "این آیه داره نشون میده که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 204.84,
   "end": 210.16,
   "text": "حدود الهی رو رعایت کردن به جهت رعایت حدود نفسه، رعایت حال نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 210.16,
   "end": 213.54,
   "text": "اللهم غير سوء حالنا بحسن حالک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.54,
   "end": 219.04,
   "text": "رعایت حدود الهی کن ببین نفست چجوری باحال می‌شه و سیرش چجوری سرعت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 219.04,
   "end": 225.54,
   "text": "و اونچه که قراره ما ببینیم، ببینید عزیزان این جمله‌ای که به شما عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 225.54,
   "end": 228.18,
   "text": "خیلی جمله مهمیه. یعنی شما ماحصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 228.18,
   "end": 234.42,
   "text": "تمام این کتابای حکمی، عرفانی اینا رو شاید بتونید تو این جمله جمع کنید که آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.42,
   "end": 239.98,
   "text": "در ثغر نفس نترسید از این کلمات چون کتاب‌ها رو می‌خونی اینا هست میگم آشنا بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.98,
   "end": 241.8,
   "text": "نترسید بعداً کتابو خوندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.8,
   "end": 244.92,
   "text": "ثغر یعنی باطن، اون ذات، کمون ذاتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.92,
   "end": 250.66,
   "text": "در ثغر نفست هرچه که مستکن، حالا میگم یعنی چی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.66,
   "end": 253.24,
   "text": "و مستجن شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.24,
   "end": 256.46,
   "text": "مستکن و مستجن یعنی دیگه جا افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 256.46,
   "end": 260.64,
   "text": "مستکن یعنی مس-- میگن من مستکینم یعنی زمین خوردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.64,
   "end": 264.94,
   "text": "زمین نشستم. یعنی تو زمین وجودت جا افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 264.94,
   "end": 268.64,
   "text": "مستجنی یعنی چی؟ اصلاً چرا میگن جن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 268.64,
   "end": 272.9,
   "text": "چرا میگن جنین؟ ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.9,
   "end": 276.58,
   "text": "جن، جنین اینا از پوشش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 276.58,
   "end": 280.38,
   "text": "یعنی دیده نمی‌شه. جنین در رحم مادره دیده نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.38,
   "end": 283.64,
   "text": "جن چون دیده نمی‌شه بهش میگن جن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.64,
   "end": 289.54,
   "text": "توجه کردید چی عرض می‌کنم؟ اینجا میگه مستجن در نفسنا در ثغرنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.54,
   "end": 294.76,
   "text": "باطنته. یعنی تو نمی‌بینیش، دیگران نمی‌بیننش، در باطنته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.76,
   "end": 297.2,
   "text": "اونچه که در باطنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.2,
   "end": 299.78,
   "text": "مستکن و مستجن شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.78,
   "end": 301.96,
   "text": "الی يوم القيامة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 301.96,
   "end": 304.44,
   "text": "الی یعنی ابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.44,
   "end": 308.94,
   "text": "چی رو می‌سازه؟ تمثلاتت، مناماتت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.94,
   "end": 313.32,
   "text": "و اون ارواح و اشباهی که در بیداری می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.32,
   "end": 318.26,
   "text": "همه اینا رو اونچه که در نفس ناطقه‌ات مستکن و مستجن شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 318.26,
   "end": 321.5,
   "text": "چه در بیداری، در تمثلاتت، در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 321.5,
   "end": 326.18,
   "text": "خوابت، مناماتت، اینا هرچی می‌بینی بر اساس اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 326.18,
   "end": 329.24,
   "text": "که جالبه در این خصوص در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 329.24,
   "end": 333.1,
   "text": "درس، ابتدای درس صد و بیست و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 333.1,
   "end": 335.96,
   "text": "شرح فصوص حضرت علامه می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.96,
   "end": 339.64,
   "text": "علامه ق-- علامه حسن زاده بر شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.64,
   "end": 343.86,
   "text": "علامه قیسری. می‌فرمود که اینو توجه کنید خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 343.86,
   "end": 347.76,
   "text": "می‌فرمود شاید بتوان گفت، عین کلام علامه رو براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.76,
   "end": 357.36,
   "text": "انقدر گوش دادم دیگه حفظ شدم. شاید بتوان گفت که اینکه ابن عربی وقتی از پیغمبر در اون القاء صبویی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.36,
   "end": 363.16,
   "text": "اون کتاب فصوص الحکم رو اخذ می‌کنه و پیغمبر بهش می‌فرماید خذ الكتاب بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.16,
   "end": 366.46,
   "text": "یا هاذ الكتاب این کتابو بگیر و برو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.46,
   "end": 369.56,
   "text": "اخرج إلى الناس برو به سمت مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.56,
   "end": 372.32,
   "text": "که مردم از این کتاب انتفاع ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 372.32,
   "end": 374.38,
   "text": "فصوص الحکم ابن عربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.38,
   "end": 376.72,
   "text": "که علامه داره شرحش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 376.72,
   "end": 380.62,
   "text": "میگه شاید این که در اون القاء صبویی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.62,
   "end": 385.54,
   "text": "این کتاب خب حقایق و معانی این کتاب نه عین لفظی که توش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.54,
   "end": 390.86,
   "text": "معانی-- چون قرآن لفظش هم به پیغمبر وحی شده اما فصوص ابن عربی نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 390.86,
   "end": 393.82,
   "text": "معانیش عنایت شده، القا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 393.82,
   "end": 396.78,
   "text": "ایشون به قلم خودش نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 396.78,
   "end": 400.72,
   "text": "میگه علامه حسن زاده می‌فرمایند شاید این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.72,
   "end": 405.5,
   "text": "اسمش هم پیغمبر تو خواب بهش گفته این فصوص الحکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 405.5,
   "end": 407.44,
   "text": "به جهت این باشد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.44,
   "end": 413.74,
   "text": "ابن عربی خیلی در نفسش علاقه داشته به کتاب فصوص الحکم فارابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 413.74,
   "end": 415.42,
   "text": "که ما قبل از ابن عربیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.42,
   "end": 417.4,
   "text": "فصوص الحکم فارابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.4,
   "end": 422.74,
   "text": "یه کتاب خیلی شریفیه که علامه اونم شرح داده به نام نسوس الحکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.74,
   "end": 427.96,
   "text": "میگه شاید یعنی می‌توان گفت علامه میگه می‌توان گفت تو سقع نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.96,
   "end": 432.72,
   "text": "ابن عربی علاقه‌ای که داشته به کتاب فصوص الحکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 432.72,
   "end": 439.48,
   "text": "فارابی تو خواب اون تمثلی که می‌بینه لخت میده پیغمبر میگه این کتاب فصوص الحکم رو ببر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 439.48,
   "end": 441.7,
   "text": "از این جهت. ببین چقدر مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.7,
   "end": 445.46,
   "text": "بعد حتی می‌فرمایند این که پیغمبر رفت لیلة الاسری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 445.46,
   "end": 447.54,
   "text": "هرچی شنید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.54,
   "end": 450.3,
   "text": "صوت علی صلوات الله علیه شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.3,
   "end": 452.78,
   "text": "هرچی دید نام علی دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 452.78,
   "end": 455.4,
   "text": "نقوش بهشت رو با نام علی دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 455.4,
   "end": 459.0,
   "text": "اصلاً این که مؤمن میره هرچی در بهشت می‌بینه نام علی می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 459.0,
   "end": 462.72,
   "text": "کلید در بهشتو تکون میده حدیث داریم علی، علی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.72,
   "end": 464.32,
   "text": "نقوش بهشت همه علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 464.32,
   "end": 466.98,
   "text": "اینا یعنی چی؟ اینا در سقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 466.98,
   "end": 470.72,
   "text": "نفس ناطقه محب امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 470.72,
   "end": 480.04,
   "text": "مستکن و مستجن شده لذا بر اساس این که در درونش اینجا افتاده تا ابد این هرچی می‌بینه علی می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 480.04,
   "end": 484.46,
   "text": "حتی علامه مثال میزد. می‌فرمود که یه آده-- یه زندانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 484.46,
   "end": 487.86,
   "text": "رفته بود برای علامه تعریف کرده بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.86,
   "end": 489.98,
   "text": "حالا چه مشکلی داشت نگفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 489.98,
   "end": 494.26,
   "text": "فرمود رفته بود یه مدت تو زندان و خب زندان نمیدونم کی چشیده اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 494.26,
   "end": 496.98,
   "text": "من چشیدم و کشیدم که بهتون میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 496.98,
   "end": 501.18,
   "text": "زندان چجوریه. آدم واقعاً قطع علاقه از همه جا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 501.18,
   "end": 503.98,
   "text": "میگه چون اونجا قطع علاقه، تعلقات‌ها رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 503.98,
   "end": 507.14,
   "text": "بحث چهلم کلمه چهلم فرداست انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 507.14,
   "end": 509.58,
   "text": "قطع علاقه که می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 509.58,
   "end": 516.42,
   "text": "می‌فرمود تمام عمرم انگار قیامت هم به پا شده، تمام عمرم جلو چشمام رژه می‌رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 516.42,
   "end": 520.5,
   "text": "تمام عمرم. این یک حقیقتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 520.5,
   "end": 522.24,
   "text": "یعنی اتفاق میفته. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 522.24,
   "end": 525.64,
   "text": "چون در نفس ما همه اعمال ما، علم ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 525.64,
   "end": 531.34,
   "text": "چشیدن‌ها، شنیدن‌ها، نوشتن‌ها، گفتن‌ها، نفس به نفس ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 531.34,
   "end": 535.18,
   "text": "همه چی میشه؟ ثبت میشه در نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 535.18,
   "end": 537.44,
   "text": "و اونجا ما اینو می‌بینیم. اتفاقاً آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 537.44,
   "end": 540.6,
   "text": "چهل و نه اینم بگم و امروز دیگه بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.6,
   "end": 543.94,
   "text": "آیه چهل و نه سوره کف همین رو داره می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 543.94,
   "end": 546.32,
   "text": "\"ووضع الكتاب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 546.32,
   "end": 551.9,
   "text": "وقتی اومد این کتاب وضع شد \"فترى\" می‌بیننش کیا \"المجرمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 551.9,
   "end": 554.86,
   "text": "مشفقین\" می‌ترسن از این کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 554.86,
   "end": 559.7,
   "text": "چرا؟ \"مما فيه\" از اون چیزی که تو کتاب خودشون ثبت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 559.7,
   "end": 562.98,
   "text": "این کتاب، کتاب وجود خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 562.98,
   "end": 566.94,
   "text": "\"ويقولون\" اینا میگن \"يا ويلتنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 566.94,
   "end": 571.34,
   "text": "وای بر ما \"مال هذا الكتاب\" عجب کتابیه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 571.34,
   "end": 574.56,
   "text": "\"لا يقادر صغيرا ولا كبيرا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 574.56,
   "end": 576.74,
   "text": "کوچک و بزرگ رو دریغ نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 576.74,
   "end": 580.22,
   "text": "\"لا يقادر\" همه رو آورده \"الا احصاها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 580.22,
   "end": 586.96,
   "text": "همه رو شمرده \"ووجدوا\" اینجا رو آخر آیه رو دقت کنید \"ووجدوا ما عملوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 586.96,
   "end": 591.86,
   "text": "حاضرا\" می‌بینن اونچه که عمل کردن حاضره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.86,
   "end": 596.58,
   "text": "عملشون حاضره. نه توی کتاب جوهری نوشتن تقدیمش کنن، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 596.58,
   "end": 600.38,
   "text": "\"ولا يظلم ربک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 600.38,
   "end": 602.38,
   "text": "احدا\" به احدی خدا ظلم نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 602.38,
   "end": 608.24,
   "text": "خودت با خودت محشور میشی. کتاب وجود خودت رو می‌خونی ورق ورق می‌زنی تا قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 608.24,
   "end": 614.5,
   "text": "قی تا، تا ابد، تا ابد خودت با کتاب وجود خودت محشوری و اونو می‌خونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 614.5,
   "end": 618.14,
   "text": "و کسی که اینطوری نگاه پیدا کرد نگاهش ابدی میشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
