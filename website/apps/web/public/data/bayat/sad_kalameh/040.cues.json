   "start": 13.94,
   "end": 35.02
  },
  {
   "index": 1,
   "title": "## تجرد رونده و رجعت به‌سوی رب",
   "start": 35.02,
   "end": 128.76
  },
  {
   "index": 2,
   "title": "## سلسلهٔ عوالم و رفتار برای ابد",
   "start": 128.76,
   "end": 149.16
  },
  {
   "index": 3,
   "title": "## تقوا و نگاه به فردا؛ آیهٔ هجده حشر",
   "start": 149.16,
   "end": 232.94
  },
  {
   "index": 4,
