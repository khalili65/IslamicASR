 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ سی‌وهشتم؛ کتب مصنفان دلیل تجرد وعاء علم",
   "start": 12.0,
   "end": 144.46
  },
  {
   "index": 1,
   "title": "## بیش از بیست دلیل حکما بر تجرد نفس",
   "start": 144.46,
   "end": 470.71
  },
  {
   "index": 2,
   "title": "## خواب؛ آشناترین دلیل",
   "start": 470.71,
   "end": 542.77
  },
  {
   "index": 3,
   "title": "## رؤیای علامه حسن‌زاده و تعبیر نابلسی",
   "start": 542.77,
   "end": 712.97
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.22,
   "end": 8.04,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.04,
   "end": 12.0,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.0,
   "end": 15.48,
   "text": "کلمه سی و هشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.48,
   "end": 20.4,
   "text": "آن که در کتب مصنفان و مؤلفان فکر کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.4,
   "end": 24.7,
   "text": "آنها را دلیل بر تجرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.7,
   "end": 26.98,
   "text": "تجرد یعنی ماورای ماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.98,
   "end": 32.62,
   "text": "دلیل بر تجرد وعای علم یعنی ظرف علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.62,
   "end": 37.4,
   "text": "أعم از واهب و متهم که نفس است می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.4,
   "end": 43.5,
   "text": "میگه وقتی دقت کنی به این کتاب‌ها، اونا رو درست بخونی متوجه میشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.5,
   "end": 48.08,
   "text": "ظرف این علوم که این همه علوم متنقش شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.08,
   "end": 52.22,
   "text": "در همین کتب مصنفان و مؤلفان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.22,
   "end": 54.16,
   "text": "می‌بینی که ظرف این علوم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.16,
   "end": 58.6,
   "text": "نفس ناطق است. میگه تو وقتی به اینا دقت می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.6,
   "end": 61.9,
   "text": "متوجه میشی که بله نفس تو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.9,
   "end": 64.78,
   "text": "اون که وعای این علومه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.78,
   "end": 67.4,
   "text": "نفس تو هم مجرده، ماده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.4,
   "end": 71.02,
   "text": "چرا نگاه ما صرفاً شده مادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.02,
   "end": 75.52,
   "text": "چرا ما فقط به پوسته و ظاهر و بدن دنیا توجه داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.52,
   "end": 79.38,
   "text": "چرا فقط به رصد و فصد و امور بدن خودمون داریم می‌رسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.38,
   "end": 82.54,
   "text": "به بدن خودمون. خب چرا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.54,
   "end": 85.64,
   "text": "اون حدود دیگر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.64,
   "end": 93.18,
   "text": "حدود دیگر وجوه دیگر، شؤون دیگر، اتوار دیگر وجود و نفس خودمون نمیپردازیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.18,
   "end": 95.44,
   "text": "که اتفاقاً اون‌ها مهم‌ترند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.44,
   "end": 101.22,
   "text": "چرا؟ خب این‌ها ما هی می‌زنیم تو سر این‌هایی که میگن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.22,
   "end": 105.06,
   "text": "اصلاً کی گفته جهانی بعد از این دنیا هست، تموم میشه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.06,
   "end": 110.78,
   "text": "هی می‌زنیم تو سر اون‌ها. ماده گراها، ماتری-- ماتریالیست‌ها چه، چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.78,
   "end": 113.42,
   "text": "اما خودمون می‌بینیم در عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.42,
   "end": 121.04,
   "text": "اصلاً توجه به زندگی ابدی‌مون نداریم که کلمه سی و نه که فردا انشاالله می‌خونیم بحث همینه، ابدی بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.04,
   "end": 124.48,
   "text": "توجه به این‌ها، همین صرفاً به ظاهر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.48,
   "end": 130.16,
   "text": "به بدن خودمون. حالا این شکمه معذب می‌خواد به قول حضرت استاد پر بشه و بعدش هم خالی شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.16,
   "end": 132.72,
   "text": "هی پر شه خالی شه، پر شه خالی شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.72,
   "end": 139.64,
   "text": "همین. واقعاً وقتی شؤونات خودمون رو وقتی بررسی می‌کنیم، ما کاملاً غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.64,
   "end": 144.46,
   "text": "اصلاً کسی جرات نداره حالا بماند به درد و دل نیفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.46,
   "end": 147.76,
   "text": "در تجرد نفس ناطقه حکماى ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.76,
   "end": 155.06,
   "text": "بیش از بیست دلیل آوردن یعنی بیست و دو سه دلیل رو شما بررسی کنید در کتب عقليه آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.06,
   "end": 161.3,
   "text": "الا چند تاش که مقدار قابل فهم‌تره که بعداً چوب این رو هم نخوریم که حرفای سنگین می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.3,
   "end": 166.2,
   "text": "اونایی که مقدار قابل فهم‌تره رو چند تاشو براتون ع-- بیان می‌کنم ببینید چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.2,
   "end": 168.6,
   "text": "ما هم خوب اینو هممون می‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.6,
   "end": 171.1,
   "text": "آقا دلایل اینکه بله نفس ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.1,
   "end": 176.06,
   "text": "مجرده، ماده نیست بلکه فوق تجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.06,
   "end": 181.06,
   "text": "اولیش رو مثلا یکی از دلایل خوب فرمودن نفس به علم حضوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.06,
   "end": 185.26,
   "text": "بدون دخالت این بدن و جسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.26,
   "end": 189.68,
   "text": "به علم حضوری به خودش ادراک داره، درک می‌کنه خودش رو نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.68,
   "end": 193.16,
   "text": "الان به شما بگن آقا خودت، خودت رو درک می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.16,
   "end": 196.3,
   "text": "میگی بله چرا نه می‌کنم. من از خودم درک دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.3,
   "end": 199.26,
   "text": "این یک. دلیل دیگه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.26,
   "end": 203.92,
   "text": "درک امور و اعداد نامتناهی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.92,
   "end": 207.84,
   "text": "اینکه شما درک کنی لایتناهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.84,
   "end": 213.38,
   "text": "به شما میگن اعداد الی بینهایت، درک می‌کنی بینهایت یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.38,
   "end": 215.5,
   "text": "خب این دلالت بر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.5,
   "end": 217.78,
   "text": "مجرد بودن نفس‌ته. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.78,
   "end": 220.56,
   "text": "ماده نیست. نفس ما جسم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.56,
   "end": 223.96,
   "text": "صرفاً خلاصه نشدیم ما در این بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.96,
   "end": 227.64,
   "text": "دلیل دیگه. ممکنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.64,
   "end": 234.48,
   "text": "بدن و اعضا از درک و تصور نفس قاعد بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.48,
   "end": 238.06,
   "text": "یعنی اینکه ما گاهی اوقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.06,
   "end": 241.8,
   "text": "حواسمون اینطوری بگیم، نفسمون غافل بشه از بدنمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.8,
   "end": 247.96,
   "text": "از اعضامون. اما از خودمون هیچوقت غافل نمی‌شیم، از اون من خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.96,
   "end": 254.36,
   "text": "هیچوقت نفس در هیچ شأنی و در هیچ مقامی حتی در بیهوشی، حتی در کما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.36,
   "end": 258.42,
   "text": "ح-- تنویر مغناطیسی هرچی که باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.42,
   "end": 263.36,
   "text": "هیپنوتیزم اینا هیچ-- در هیچ حالتی نفس از خودش غافل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.36,
   "end": 267.96,
   "text": "ممکنه یادش بره یه چیزایی رو اما از خودش اون لحظات غافل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.96,
   "end": 273.28,
   "text": "دلیل دیگه. اگر حالا بگیم آقا نفس جسم بود خب این جسم بود بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.28,
   "end": 276.5,
   "text": "کجا بود؟ تو یکی از اعضا و جوارح ما بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.5,
   "end": 282.4,
   "text": "حالا مثلا بگیم اگر در دماغ بود، در مغز بود یا در قلب بود یا در جگر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 282.4,
   "end": 287.8,
   "text": "اگر این چنین بود و جسم هم بود یا باید دائماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 287.8,
   "end": 293.92,
   "text": "توجه به این جایگاه خودش داشت یا نه دائماً از اون غافل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.92,
   "end": 299.16,
   "text": "اما می‌بینیم که نفس ما گاهی اوقات توجه داره به اعضای بدنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 299.16,
   "end": 301.22,
   "text": "گاهی اوقات توجه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.22,
   "end": 303.54,
   "text": "این خودش نشون میده که مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 303.54,
   "end": 309.1,
   "text": "یا دلیل دیگه اینکه بازگشت صورت‌های فراموش شده رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.1,
   "end": 312.74,
   "text": "یه چیزی شما صورت یه شکلی، یه خاطره‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.74,
   "end": 317.26,
   "text": "یادت رفته یه دفعه به یادت میاد به یکباره به خاطر میاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.26,
   "end": 319.02,
   "text": "این پیداست که جسم نیستی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.02,
   "end": 322.16,
   "text": "تو نفس ناطق، نفس ناطقت مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 322.16,
   "end": 328.34,
   "text": "دلیل دیگر. می‌تونه نفس اون اجسام قاعده رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.34,
   "end": 332.52,
   "text": "اون اجسامی که الان اینجا غائب‌اند، نیستن، تصور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 332.52,
   "end": 338.84,
   "text": "الان شما می‌تونی چیزی که اینجا نیست رو تصور کنی که پدر مادرت الان اینجا نیستن، تصور ازشون می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 338.84,
   "end": 341.98,
   "text": "شکلش رو الان می‌بینی حاضر شد. داری می‌بینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.98,
   "end": 348.46,
   "text": "خب این پیداست که شما جسم نیستی عزیز دلم و حقایق رو این چنین می‌تونی شما احضار کنی اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 348.46,
   "end": 351.78,
   "text": "یکی از معانی احضار روح هم اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.78,
   "end": 359.16,
   "text": "نکته‌ی دیگه. در یک لحظه نفس می‌تونه متقابلات و متضادات رو، این چیزایی که با هم تضاد دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 359.16,
   "end": 363.08,
   "text": "متقابلات و متضادات رو درک کنه یک لحظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 363.08,
   "end": 367.71,
   "text": "مثلاً شما می‌تونی در آن واحد درک بین نور و ظلمت کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 367.71,
   "end": 370.07,
   "text": "شب و روز کنی. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 370.07,
   "end": 371.63,
   "text": "نرمی و خشنی کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.63,
   "end": 376.61,
   "text": "این‌ها دو تا حقیقت‌اند که متضادند، متقابل‌اند اما شما درک می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.61,
   "end": 378.53,
   "text": "اگه جس بودی نمی‌تونستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 378.53,
   "end": 382.91,
   "text": "دلیل دیگه. شما چطوره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 382.91,
   "end": 386.01,
   "text": "وقتی که از چهل سال می‌گذره سنت به کهولت میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 386.01,
   "end": 393.37,
   "text": "بدنت افت دیگه میفته به قول معروف میگن بدن خالی می‌کنه دیگه هی درد و بیچارگی و زمین‌گیری اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.37,
   "end": 397.31,
   "text": "نفست چی؟ اتفاقا نفس قوی‌تر میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 397.31,
   "end": 402.01,
   "text": "نفس قوت می‌گیره، شدت بهش میگن اشتداد وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 402.01,
   "end": 404.47,
   "text": "یا دلیل دیگه در خصوص فکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 404.47,
   "end": 408.69,
   "text": "ببین بدن رو هرچی شما بیشتر ازش استفاده کنی مستهلک‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 408.69,
   "end": 411.05,
   "text": "هی داغون‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 411.05,
   "end": 413.45,
   "text": "اما با-- وقتی شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 413.45,
   "end": 418.63,
   "text": "از روحت از نفست هرچی بیشتر کار بکشی بیشتر فکر می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.63,
   "end": 422.89,
   "text": "قوی‌تر میشی، فکور میشی، مبالغه است فکور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 422.89,
   "end": 426.47,
   "text": "فکرت قوی‌تر میشه. اینم یه دلیل دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 426.47,
   "end": 429.03,
   "text": "دلیل دیگر احضار روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 429.03,
   "end": 432.21,
   "text": "چگونه است که ارواح رو مثلا مرحوم آ Q الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 432.21,
   "end": 436.41,
   "text": "طباطبایی برادر علامه طباطبایی ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 436.41,
   "end": 441.05,
   "text": "خب ارواح، ارواح علما رو حاضر می‌کرد و باهاشون مباحثه علمی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 441.05,
   "end": 443.07,
   "text": "عجب! چه جالب، چه شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 443.07,
   "end": 446.11,
   "text": "آقای قاضی هم تو وادی السلام رفتید دیگه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 446.11,
   "end": 448.61,
   "text": "کنار قبرشون یه اتاقکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 448.61,
   "end": 451.17,
   "text": "همونجا شب‌ها بیتوته می‌کردن و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 451.17,
   "end": 459.75,
   "text": "و احضار می‌کرد علما رو مباحثات علمی ما تو شب خوابیدیم شب تا صبح خر و پف اون داره مباحثه علمی می‌کنه با بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 459.75,
   "end": 464.51,
   "text": "خب اون بدن اون آقا که تو قبر خاک شده و پوسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 464.51,
   "end": 466.97,
   "text": "این روح چیه الان اینجا داره مباحثه علمی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 466.97,
   "end": 469.03,
   "text": "اینم یه دلیل بر تجرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 469.03,
   "end": 472.67,
   "text": "دلیل دیگه که همه فهم‌تر از همه این دلائله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 472.67,
   "end": 476.93,
   "text": "آقا همین خواب ما. چگونه است که ما اصلا خواب می‌بینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 476.93,
   "end": 480.65,
   "text": "الان بدن ما اینجا آرمیده از کار افتاده ظاهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 480.65,
   "end": 484.23,
   "text": "این همه مشاهدات در خواب اینا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 484.23,
   "end": 489.45,
   "text": "ببین نشون میده که یه عالمی هست، یه حقیقتی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 489.45,
   "end": 491.95,
   "text": "که ماورای این بدن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.95,
   "end": 494.63,
   "text": "ماورای این نشئه طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 494.63,
   "end": 498.49,
   "text": "باید این‌ها دلایل دیگه باید انسان توجه کنه به اون ور دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 498.49,
   "end": 503.21,
   "text": "که حالا اونچه که در خواب می‌بینی خودش پیاده شدن حقایقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.21,
   "end": 510.59,
   "text": "حالا که پیغمبر صبح می‌اومد مسجد همه شنیدید \"حلم مبشرات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 510.59,
   "end": 515.71,
   "text": "آیا کسی هست به ما بشارتی بده از مبشرات، اون مبشرات صادقه، رویاهای صادقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 515.71,
   "end": 518.17,
   "text": "چی دیدید تو خواب؟ انقدر مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 518.17,
   "end": 521.65,
   "text": "الان آدم روی همین حرفو بزنه میگیم حاج آقا خواب آلود شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 521.65,
   "end": 523.75,
   "text": "نمی‌دونم این حرفا چیه دنبال حقایق باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 523.75,
   "end": 529.31,
   "text": "پیغمبر عالم میگه آقا یه کسی از اون مبشرات صادقه‌ش یه حرفی بزنه ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 529.31,
   "end": 534.87,
   "text": "پیداست اونچه که حقیقتی که آ از عالم داره متنزل تا نازل میشه میاد پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 534.87,
   "end": 536.95,
   "text": "شما در برزخ وجودی عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 536.95,
   "end": 541.91,
   "text": "مثال متصلت که در درون خودته می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.91,
   "end": 546.33,
   "text": "و چه شیرین که در درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 546.33,
   "end": 549.43,
   "text": "صد و بیست و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 549.43,
   "end": 556.87,
   "text": "شرح اسفار، ببخشید شرح فسوس ابن عربی، حضرت علامه حسن زاده یه آهی کشیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 556.87,
   "end": 565.47,
   "text": "روحشون شاد فرمودن که من یه مد-مدتی بود خیلی کشیک نفس می‌دادم و به شدت مراقب خودم بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 565.47,
   "end": 571.47,
   "text": "که به هر حال از خواب میشه-- ایشون می‌فرمود از خوابات می‌تونی خودتو بشناسی، نفست در چه حالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 571.47,
   "end": 577.87,
   "text": "بعد می-- ایشون می‌فرمود که یه مبشره صادقه‌ای رویای قشنگی رخ داد تو عالم خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 577.87,
   "end": 585.75,
   "text": "یه برق جمعه‌ای اومد و من تمام قرآن رو در سوره فاتحه کتاب که حدیث داریم جمعه اینو دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 585.75,
   "end": 590.67,
   "text": "تو عالم خواب علامه میگه. ولی وقتی بیدار شدم دیدم خالی خالی‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 590.67,
   "end": 596.75,
   "text": "یعنی هیچ چیزی یه واقعا یه مبشره بسیار عالی و پرمعنایی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 596.75,
   "end": 599.37,
   "text": "اما وقتی بیدار شدم دیدم هیچی یادم نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 599.37,
   "end": 601.49,
   "text": "یعنی چیزی برام نمونده تو وجودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 601.49,
   "end": 604.09,
   "text": "یه درک قشنگی بود که غصم گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 604.09,
   "end": 606.63,
   "text": "بعد رسیدم به اون کتاب حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 606.63,
   "end": 609.83,
   "text": "تعبیر الانام فی تعبیر المنام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 609.83,
   "end": 614.93,
   "text": "مال مرحوم عبدالغنی ابن اسماعیل نابلسیه که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 614.93,
   "end": 616.87,
   "text": "دمشق درست بشه، نه دمشق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 616.87,
   "end": 619.29,
   "text": "دمشق صالحه. دمشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 619.29,
   "end": 622.27,
   "text": "سی-- تقریبا سیصد سال پیش اونجا از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 622.27,
   "end": 624.53,
   "text": "این کتاب مال اونه. کتاب عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 624.53,
   "end": 630.97,
   "text": "تا خودش حنفی مذهب بود به روایت سید عبدالرزاق گیلانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 630.97,
   "end": 634.13,
   "text": "رفت جزو طایفه نقش بندی و قادری‌ها و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 634.13,
   "end": 636.69,
   "text": "ولی کتابش خیلی کتاب جالبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 636.69,
   "end": 638.47,
   "text": "در خصوص چی؟ تعبیر خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 638.47,
   "end": 642.23,
   "text": "اینو بگیرید بخونید هی نرید وقت آخوندا رو بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 642.23,
   "end": 647.21,
   "text": "اونجا ایشون یه جمله جالبی داره عبدالغنی نابلسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 647.21,
   "end": 655.01,
   "text": "میگه که اگر تو در خواب حقیقتی برات نازل شد و خواب خوبی دیدی، بیدار شدی یادت رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 655.01,
   "end": 658.75,
   "text": "بدون که گناهی کردی. یه خطایی ازت سر زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 658.75,
   "end": 663.11,
   "text": "این داره چیو میگه؟ داره غیرمستقیم همینی که ما این بحث امروز ما رو داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 663.11,
   "end": 666.45,
   "text": "یعنی یه حقیقتی نازل شده از عالم بر تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 666.45,
   "end": 669.61,
   "text": "چون تو ظرفیتشو نداشتی نازل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 669.61,
   "end": 671.55,
   "text": "در عالم خواب هم تو اخذش کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 671.55,
   "end": 675.85,
   "text": "چون اومدی دوباره تو این نشئه طبیعت و آلوده بودی رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 675.85,
   "end": 678.73,
   "text": "حالا علامه اونجا خودشکستگی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 678.73,
   "end": 681.31,
   "text": "و حالا خودشو می‌شکونه اینها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 681.31,
   "end": 686.19,
   "text": "اینو به ما بفهمونه که میگه منم بیدار شدم هیچی یادم نیومد غصه خوردم که آدم خطایی کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 686.19,
   "end": 688.81,
   "text": "اما خطای اونا کجا ما کجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 688.81,
   "end": 693.11,
   "text": "به هر حال اینا یه حقیقتیه که چرا حالا ما خودمون رو نشناسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 693.11,
   "end": 695.27,
   "text": "چرا سراغ این حقایق و معارف نریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 695.27,
   "end": 698.11,
   "text": "بی‌خبر از خودمون از این دنیا بریم زشت نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 698.11,
   "end": 700.97,
   "text": "از خود بی‌خبر از دنیا بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 700.97,
   "end": 703.31,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 703.31,
   "end": 706.23,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 706.23,
   "end": 709.23,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 709.23,
   "end": 712.97,
   "text": "محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}