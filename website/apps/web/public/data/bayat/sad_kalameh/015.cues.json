 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ چهاردهم؛ منکر خدا منکر وجود خود است",
   "start": 6.18,
   "end": 60.72
  },
  {
   "index": 1,
   "title": "## فراموشی خدا؛ فراموشی خود",
   "start": 60.72,
   "end": 110.58
  },
  {
   "index": 2,
   "title": "و در سورهٔ ص:",
   "start": 110.58,
   "end": 164.56
  },
  {
   "index": 3,
   "title": "## عالم ذر و ألست بربکم",
   "start": 164.56,
   "end": 266.4
  },
  {
   "index": 4,
   "title": "## شجرة الکون؛ چرا ألست بربکم نه أولستم بعبادی",
   "start": 266.4,
   "end": 287.34
  },
  {
   "index": 5,
   "title": "## وحدت صنع و احسن الخالقین",
   "start": 287.34,
   "end": 502.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 6.18,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.18,
   "end": 9.16,
   "text": "کلمه چهاردهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.16,
   "end": 11.8,
   "text": "آن که خدایی را انکار دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.8,
   "end": 14.48,
   "text": "منکر وجود خود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.48,
   "end": 20.3,
   "text": "حضرت استاد علامه حسن زاده علیه الرحمه در اینجا اشاره دارند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.3,
   "end": 24.66,
   "text": "اینکه کسی که منکر خدا شد یا حالا به یه وجهی بشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.66,
   "end": 27.12,
   "text": "خدا رو فراموش کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.12,
   "end": 33.78,
   "text": "قطعاً دیگه اون طور وجودی خدا رو هم فراموش می‌کنه که بر اساس آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.78,
   "end": 38.14,
   "text": "چهارده سوره نوح که \"و قد خلقکم اتوارا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.14,
   "end": 42.04,
   "text": "خدا فرمود ما شما را به طورهای مختلف خلق کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.04,
   "end": 48.3,
   "text": "و اصلاً به-- بنا به فرمایش عرفا عالم اتوار وجودی حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.3,
   "end": 51.24,
   "text": "و اون طور اعظمش می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.24,
   "end": 53.92,
   "text": "انسان. و وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.92,
   "end": 58.02,
   "text": "خدا رو برداری خب خود رو هم برداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.02,
   "end": 60.72,
   "text": "خدا را، خود، نفس خودت رو هم برداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.72,
   "end": 66.88,
   "text": "در آیه نوزده سوره حشر خیلی از طعم ال-- علیه الرحمه تاکید به فرزندشون داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.88,
   "end": 70.08,
   "text": "به این آیات انتهایی سوره حشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.08,
   "end": 76.14,
   "text": "که می‌فرماید \"ولا تكونوا كالذین نسوا الله فأنساهم أنفسهم أولئک هم الفاسقون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.14,
   "end": 80.54,
   "text": "نباشید مثل کسایی که نسوا الله، خدا رو فراموش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.54,
   "end": 83.02,
   "text": "نتیجه فراموشی الله می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.02,
   "end": 86.7,
   "text": "فأنساهم أنفسهم. خودشون رو فراموش می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.7,
   "end": 89.28,
   "text": "پس اگر خدا رو برداری خودت رو برداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.28,
   "end": 91.66,
   "text": "خدا رو فراموش کنی خودت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.66,
   "end": 95.36,
   "text": "فراموش کردی. یا به یه وجهی بر اساس آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.36,
   "end": 97.74,
   "text": "هشتاد و پنج سوره اسرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.74,
   "end": 100.08,
   "text": "\"ويسألونك عن الروح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 100.08,
   "end": 102.88,
   "text": "قل الروح من أمر ربي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.88,
   "end": 110.58,
   "text": "این روح امر پروردگاره که در آیه هفتاد و یک سوره ص هم می‌فرمود \"ونفخت فيهم روحي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.58,
   "end": 115.4,
   "text": "خدا از خودش از روح خودش در ما دمیده و امر پروردگار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.4,
   "end": 118.3,
   "text": "پس اگر خدا رو برداری روحش رو هم برداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.3,
   "end": 123.16,
   "text": "کاملاً با توجه به روایات و آیات مشخص و مبرهنه قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.16,
   "end": 129.3,
   "text": "و اصلاً اینکه در وجود ما، در فطرت ما، ذات ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.3,
   "end": 134.36,
   "text": "اون الوهیت وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.36,
   "end": 138.84,
   "text": "می‌شود گفت جستجو و تفحص و خواستگاه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.84,
   "end": 142.88,
   "text": "اون به سمت حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.88,
   "end": 149.4,
   "text": "نوک پیکان باطن ما به سمت حضرت حق نشانه گرفته شده و به اون سمت معطوف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.4,
   "end": 153.74,
   "text": "یعنی اینکه ما فطرتاً \"فطرت الله التي فطر الناس عليها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.74,
   "end": 158.12,
   "text": "فطرت الله، فطرت الله، الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.12,
   "end": 160.78,
   "text": "اصلاً از درون به سمت حضرت حقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.78,
   "end": 163.64,
   "text": "اگه خدا رو برداری خودت رو هم برداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.64,
   "end": 168.62,
   "text": "و جالبه که در همون آیه صد و هفتاد و دو سوره اعراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.62,
   "end": 172.68,
   "text": "قطعاً ملاحظه فرمودید که اشاره به عالم زر دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.68,
   "end": 175.16,
   "text": "\"و إذ أخذ ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.16,
   "end": 179.3,
   "text": "من بني آدم من ظهورهم ذريتهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.3,
   "end": 185.24,
   "text": "از پشت آدم ذریت‌شون، ذریه‌ش رو، فرزندانش رو میگه اونجا گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.24,
   "end": 187.78,
   "text": "به سخن گرفتیم، شهادت گرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.78,
   "end": 190.4,
   "text": "\"وأشهدهم على أنفسهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.4,
   "end": 195.74,
   "text": "اون‌ها رو به نفس خودشون شهادت گرفتیم که \"ألست بربكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.74,
   "end": 197.38,
   "text": "آیا من پروردگار شما هستم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.38,
   "end": 201.22,
   "text": "\"قالوا بلى\". یعنی در درون خودمون این اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.22,
   "end": 206.38,
   "text": "حالا عالم زر رو باید توصیف کرد که قبلاً هم چند تا نمونه از توصیفات بزرگان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.38,
   "end": 209.4,
   "text": "در سایر بعض از بحث‌ها عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.4,
   "end": 215.84,
   "text": "پس ما در درون خودمون این شهادت و شهود بوده از الست، از عهد الست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.84,
   "end": 219.7,
   "text": "از ازل به یک معنا. در درون خودمون خدا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.7,
   "end": 222.82,
   "text": "اگر خدا رو برداری دیگه چیزی از ما نمی‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.82,
   "end": 227.24,
   "text": "صبغة الله رو برداری، رنگ خدا رو برداری از خدا چی می‌مونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.24,
   "end": 230.34,
   "text": "از بن-- از رنگ خدا چی می‌مونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.34,
   "end": 236.04,
   "text": "اگر خدا رو برداری صبگه‌ش، صبغه او یعنی رنگ او رو هم برداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.04,
   "end": 239.42,
   "text": "آیه شریفه صد و سی و هشت بقره چقدر شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.42,
   "end": 242.96,
   "text": "تفاسیر ذیل این آیه رو ببینید خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.96,
   "end": 246.62,
   "text": "حتماً برید ببینید \"صبغة الله ومن أحسن من الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.62,
   "end": 248.94,
   "text": "صبغة ونحن له عابدون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.94,
   "end": 251.98,
   "text": "این رنگ توحیدی ذات و سرشت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.98,
   "end": 254.5,
   "text": "میگه بهترین رنگ، رنگ خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.5,
   "end": 258.54,
   "text": "که در درون ماست. شما خدا رو برداری رنگش رو هم برداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.54,
   "end": 260.88,
   "text": "الله رو بردار صبگه‌ش هم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.88,
   "end": 264.08,
   "text": "صبغه او رو هم برداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.08,
   "end": 266.4,
   "text": "و چه شیرین که حالا من داشتم بررسی می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.4,
   "end": 270.42,
   "text": "کتاب شجرة الكون حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.42,
   "end": 276.44,
   "text": "شیخ اکبر محی الدین رو به نام درخت هستی دانلود کنید هست تو فضای مجازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.44,
   "end": 278.78,
   "text": "شیرینه، خیلی کتاب جالب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.78,
   "end": 285.2,
   "text": "که اونجا ایشون اشاره به همین آیه می‌کنه و می‌فرماید که چرا خدا اینجا فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.2,
   "end": 287.34,
   "text": "\"ألست بربكم؟\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.34,
   "end": 289.04,
   "text": "آیا من پروردگار شما نیستم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.04,
   "end": 292.34,
   "text": "چرا نفرموده \"أولستم بعبادي؟\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 292.34,
   "end": 294.34,
   "text": "آیا شما بندگان من نیستید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 294.34,
   "end": 295.96,
   "text": "بعد یه بحثی رو اونجا مطرح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 295.96,
   "end": 299.68,
   "text": "خیلی جالب که اساس عبودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.68,
   "end": 302.36,
   "text": "بر شدت و ضعف و نقصان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 302.36,
   "end": 305.26,
   "text": "کاستی و ایناست. یعنی ما در عبودیت‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 305.26,
   "end": 308.02,
   "text": "خیلی کم و کاستی داریم، نقص داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.02,
   "end": 313.02,
   "text": "ام-- اگر خدا می‌فرمود \"أولستم بعبادي؟\" آیا شما بندگان من هستید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 313.02,
   "end": 316.1,
   "text": "انگار که اساس خلقت بر اساس یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.1,
   "end": 319.48,
   "text": "ضعفی بنا شده و اون استحکام رو نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.48,
   "end": 322.6,
   "text": "اما ربوبیت حضرت حق بی‌نقصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 322.6,
   "end": 325.02,
   "text": "لذا می‌فرماید اولست و ببین چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.02,
   "end": 331.32,
   "text": "ذره‌بین‌هایی گذاشتن و چه نکاتی رو استخراج کردن از آیات که اصلاً به مخیله ما نمی‌گنجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 331.32,
   "end": 334.98,
   "text": "محی الدین علیه الرحمه که رهب-- آقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 334.98,
   "end": 338.94,
   "text": "امام عزیزمون خیلی با عظمت از ایشون یاد می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 338.94,
   "end": 342.3,
   "text": "ایشون می‌فرماید که گفته \"ألست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 342.3,
   "end": 350.54,
   "text": "بربكم\" که نشون بده اصلاً اساس و پایه خلقت بر اساس استواری، استحکام و حکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.54,
   "end": 353.24,
   "text": "حکیمه دیگه. محکمه همه چیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.24,
   "end": 355.98,
   "text": "\"ولا يمكن الفرا من حكمتك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 355.98,
   "end": 359.44,
   "text": "و وقتی نگاه می‌کنی به انسان که یکپارچه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 359.44,
   "end": 362.02,
   "text": "بزرگ‌ترین صنعه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 362.02,
   "end": 369.78,
   "text": "از وحدت صنع به خدا پی می‌بری و وقتی خودت رو نگاه می‌کنی می‌بینی بزرگ‌ترین صنعه الهی هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 369.78,
   "end": 375.8,
   "text": "چگونه خدا به سنت استدراجش ثمه، ثمه از نطفه برده، بردت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 375.8,
   "end": 379.08,
   "text": "مزغه و علقه و عظام و لحم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.08,
   "end": 384.14,
   "text": "جنین و همینطور غذا از اون موقعی که نطفه بودی آب و نان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.14,
   "end": 391.16,
   "text": "مادر غذات شد شدی نطفه بعد اومد همینجوری غذا پشت غذا آنچه که نیاز داشتی خدا برات تامین کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.16,
   "end": 394.74,
   "text": "نگاه می‌کنی می‌بینی خب چگونه‌ست که آخه چگونه می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.74,
   "end": 398.88,
   "text": "خدا رو اینجا دست غیبی خدا اون \"ید الله فوق أیدیهم\" رو ورداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.88,
   "end": 401.78,
   "text": "اصلا می‌شه؟ یعنی خودت رو ورداشتی اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.78,
   "end": 403.5,
   "text": "کدوم دست به جز \"ید الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.5,
   "end": 409.76,
   "text": "فوق أیدیهم\" می‌تونه تو رو خلق کنه که بعد به خودش بارک الله بگه \"فتبارک الله احسن الخالقین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 409.76,
   "end": 412.94,
   "text": "کدوم دست؟ که حضرت علامه خیلی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.94,
   "end": 414.78,
   "text": "شرح فس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 414.78,
   "end": 418.4,
   "text": "فسوس ابن عربی اون قسمت حالا درس پنج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.4,
   "end": 421.74,
   "text": "شصت و پنجم بود اگر اشتباه نکنم خیلی شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 421.74,
   "end": 428.4,
   "text": "می‌فرمود که ببین بچه حتی به دنیا میاد غذاش وقتی تو رحمه نسبت به مزاجش غذا آماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 428.4,
   "end": 430.62,
   "text": "به دنیا میاد نسبت به مزاجش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 430.62,
   "end": 436.2,
   "text": "خیلی جالب از سینه مادر ایشون به دو مشک تعبیر می‌کنه که بالا سر بچه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.2,
   "end": 443.62,
   "text": "دو تا مشک آماده هر وقت بخواد از این دو مشک می‌نوشه و خیلی جالب که اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 443.62,
   "end": 450.26,
   "text": "یه در خ، اون سینه مادر یه ترشحاتی در کنار شیر هست از اون سوراخ‌های سینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.26,
   "end": 456.66,
   "text": "در کنار شیر یه ترشحاتی بیرون میاد که اصلا اونه که باعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 456.66,
   "end": 460.66,
   "text": "اعتدال مزاج بچه می‌شه و هضم شیر رو آسان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 460.66,
   "end": 462.54,
   "text": "خدا تا کجاشو فکر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.54,
   "end": 467.64,
   "text": "لذا امام صادق صلی الله علیه فرمود هیچ غذایی برای بچه مثل شیر مادرش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.64,
   "end": 469.24,
   "text": "اینا رو کی تامین کرده؟ کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 469.24,
   "end": 471.96,
   "text": "به هرچی میری بالاتر غذای متناسب با خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 471.96,
   "end": 477.48,
   "text": "حالا این غذای جسمت. غذای روح هم تا دلت بخواد \"اقرأ وارق\" بخوام بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.48,
   "end": 485.26,
   "text": "همه‌چی رو خدا مهیا کرده و جز خدا کی می‌تونسته همچین کارخانه با عظمتی مثل من و شما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.26,
   "end": 489.34,
   "text": "خلق کنه؟ پس اگر خدا رو برداشتی یعنی خودت رو برداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 489.34,
   "end": 493.38,
   "text": "چون کسی جز خدا نمی‌تونه یه همچین صنعی بیافرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.38,
   "end": 495.36,
   "text": "از وح، وحدت صنع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.36,
   "end": 502.18,
   "text": "می‌شه به صانع رسید. ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}