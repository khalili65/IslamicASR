  {
   "index": 1,
   "title": "## کلمهٔ پنجاهم؛ تأمل در ظاهر و باطن",
   "start": 80.2,
   "end": 227.78
  },
  {
   "index": 2,
   "title": "و در نساء:",
   "start": 227.78,
   "end": 394.74
  },
  {
   "index": 3,
   "title": "## مظهر لا تأخذه سنة ولا نوم",
   "start": 394.74,
   "end": 477.86
  },
  {
   "index": 4,
   "title": "چگونه است که یسبح لله ما فی السماوات وما فی الأرض؟ چگونه است که:",
   "start": 477.86,
   "end": 527.2
  },
  {
   "index": 5,
   "title": "## ظاهر غافل از باطن از اشتغال به غیر",
   "start": 527.2,
   "end": 619.98
  },
  {
   "index": 6,
   "title": "## سیرهٔ کشمیری و قاضی؛ اتحاد ظاهر و باطن",
   "start": 619.98,
   "end": 672.5
  },
  {
   "index": 7,
   "title": "## جمع‌بندی؛ یک حقیقت ظاهر و باطن",
   "start": 672.5,
   "end": 813.74
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 7.98,
   "end": 11.22,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.22,
   "end": 13.96,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.96,
   "end": 16.84,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.84,
   "end": 19.8,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.8,
   "end": 22.54,
   "text": "آیا کسی که بهش اقتدا می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.54,
   "end": 25.48,
   "text": "باید رضایت قلبی داشته باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.48,
   "end": 29.34,
   "text": "یعنی ملاک در اقتدای ما رضایت امام؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.34,
   "end": 34.72,
   "text": "مثلا شما یه نفر رو قبول دارید هم عادل می‌دونیدش هم تلفظش رو صحیح می‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.72,
   "end": 44.44,
   "text": "یه گوشه‌ای داره نماز، نماز فرادا می‌خونه و شما مطمئنی که البته نمازش واجبه، مستحبی باشه که نمی‌تونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.44,
   "end": 48.02,
   "text": "آیا ملاکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.02,
   "end": 51.42,
   "text": "که حتما راضی باشه؟ چون بعضیا اصلاً میگن آقا به من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.42,
   "end": 54.4,
   "text": "من راضی نیستم به من اقتدا نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.4,
   "end": 57.3,
   "text": "میگن بعضیا پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.3,
   "end": 61.26,
   "text": "چه کنیم؟ مثلا یکی اعلام کرد گفت آقا من راضی نیستم به من اقتدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.26,
   "end": 65.44,
   "text": "میشه بهش اقتدا کرد یا نه؟ به فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.44,
   "end": 68.94,
   "text": "رهبر عزیزمون جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.94,
   "end": 76.58,
   "text": "ملاک نیست بله. میشه اقتدا کرد هر چقدر داد فریاد آقا من راضی نیستم نمازتونو از نو بخونید فلان، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.58,
   "end": 79.96,
   "text": "اقتدا می‌کنیم هیچ ایرادی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.96,
   "end": 85.9,
   "text": "اما در خصوص صد کلمه در معرفت نفس حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.9,
   "end": 89.12,
   "text": "به فضل الهی می‌رسیم سراغ کلمه‌ی پنجاهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.12,
   "end": 94.24,
   "text": "خیلی شیرینه این کلمه معرفت و شناختش البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.24,
   "end": 101.54,
   "text": "آنکه در باطن و ظاهر خود تأمل کند، تأمل کنیم در تأمل اینجا با ع نیستا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.54,
   "end": 104.5,
   "text": "با ا. دقت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.5,
   "end": 107.66,
   "text": "در چی؟ ظاهر و باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.66,
   "end": 109.76,
   "text": "بدین حقیقت می‌رسد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.76,
   "end": 114.82,
   "text": "هیچ‌گاه باطن از ظاهر غافل نمی‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.82,
   "end": 118.12,
   "text": "حتی نائم در نوم خود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.12,
   "end": 125.96,
   "text": "یعنی وقتی انسان خوابه در خواب خودشم باطنش از ظاهرش غافل نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.96,
   "end": 130.4,
   "text": "و سکران در سکر خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.4,
   "end": 134.8,
   "text": "یعنی کسی که مست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.8,
   "end": 138.56,
   "text": "مست دایی عقل اصطلاحا میگن اونم در اون حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.56,
   "end": 142.24,
   "text": "مستونگیش باز غافل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.24,
   "end": 148.62,
   "text": "ظاهرش نیست. لذا به اصابت کمترین أذی یعنی اذیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.62,
   "end": 153.84,
   "text": "و الم درد بدان‌ها آگاه می‌گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.84,
   "end": 156.34,
   "text": "یعنی چه خواب باشه چه مست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.34,
   "end": 161.4,
   "text": "یه سوزن به بدنش بزنی، یه داد سرش بزنی، یه لگد بهش بزنی اینا رو همه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.4,
   "end": 168.76,
   "text": "متوجه می‌شه. خیلی موقع‌ها ما کسی بغلمون شلوغ می‌کنه تو خواب سر و صدای اونا رو می‌شنویم و لو بیدار نشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.76,
   "end": 171.34,
   "text": "اما می‌شنویم. یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.34,
   "end": 176.52,
   "text": "یکی مثلا لگدی به ما بزنه اگرچه خوابیم متوجه می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.52,
   "end": 178.88,
   "text": "اینا دلالت بر این داره که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.88,
   "end": 183.7,
   "text": "انسان وقتی خوابیده حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.7,
   "end": 186.34,
   "text": "باز از ظاهرش غافل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.34,
   "end": 194.06,
   "text": "نفسه که نفس خواب نمی‌ره که بدن خوابیده، بدن خوابه ولی نفس بیداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.06,
   "end": 197.76,
   "text": "حتی در حالت چی؟ اینجا می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.76,
   "end": 201.56,
   "text": "سکران که حالا این ماده‌ی سکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.56,
   "end": 207.88,
   "text": "اگه به وزن غفل بگیریم مثلا سکر که ما خوندیم یعنی همون مستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.88,
   "end": 210.08,
   "text": "سکر یعنی خمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.08,
   "end": 213.96,
   "text": "اون ماده‌ای که نوشیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.96,
   "end": 217.76,
   "text": "سکرت یعنی غفلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.76,
   "end": 221.78,
   "text": "سکران که اینجا حضرت استاد فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.78,
   "end": 224.72,
   "text": "به خود شخص مست میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.72,
   "end": 230.8,
   "text": "که مست کرده و جمعش می‌شه سکارا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.8,
   "end": 233.1,
   "text": "سکر یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.1,
   "end": 237.86,
   "text": "سکرت. سکرت یعنی بسته شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.86,
   "end": 241.46,
   "text": "مثلا چشم انسان که بسته می‌شه به این حالتش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.46,
   "end": 248.44,
   "text": "بسته شدن. زال-- یا مثلا عرض شود خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.44,
   "end": 251.2,
   "text": "حالا رد پای اینا رو من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.2,
   "end": 254.42,
   "text": "برای شما عرض کنم در چند تا آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.42,
   "end": 259.84,
   "text": "که مقصودی دارم ازش مثلا آیه قا-- آیه نوزده سوره قاف \"و جاءت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 259.84,
   "end": 264.54,
   "text": "سکرة الموت\". وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.54,
   "end": 274.18,
   "text": "اون حالت بیهوشی و مستی هنگام موت بیاد بالحق که اینم به حق برای هممون اتفاق می‌افته \"ذلك ما كنتم منه تحيدون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 274.18,
   "end": 277.34,
   "text": "اون همان چیزیست که ازش فرار می‌کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.34,
   "end": 281.16,
   "text": "همون حالت بیهوشی و مستی هنگام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.16,
   "end": 287.52,
   "text": "موت. یا مثلا در آیه پونزده هجر \"لقالوا\" اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 287.52,
   "end": 293.0,
   "text": "دوباره میگن که، می‌گفتن که \"انما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 293.0,
   "end": 295.6,
   "text": "سكرت سكرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 295.6,
   "end": 299.22,
   "text": "ابصارنا\" یعنی ما چشم‌بندی شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 299.22,
   "end": 301.96,
   "text": "چشمامونو بستن. یعنی پیغمبر چشم‌بندی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.96,
   "end": 309.9,
   "text": "می‌شنویم چشم‌بندی. خب \"بل نحن قوم مسحورون\" بلکه ما سحر شدیم توسط پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 309.9,
   "end": 312.42,
   "text": "همون چشم‌بندی منظورشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 312.42,
   "end": 320.56,
   "text": "و مثلا در آیه شصت و هفت سوره نحل \"ومن ثمرات النخيل والاعناب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 320.56,
   "end": 327.6,
   "text": "از میوه‌های درختان خرما و انگور \"تتخذون منه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 327.6,
   "end": 339.1,
   "text": "سكرا\" سكرن یعنی مسکرات از اینا می‌گیرن \"ورزقا حسنا\" و روزی خوب و پاکیزه می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 339.1,
   "end": 342.64,
   "text": "منظور اینجا مسکرات پاکه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 342.64,
   "end": 349.28,
   "text": "یا مثلا آیه چهل و سه سوره نساء \"لا تقربوا الصلاة\" میگه نزدیک نماز نشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 349.28,
   "end": 352.2,
   "text": "چجوری؟ \"وانتم سكاري\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 352.2,
   "end": 355.78,
   "text": "سکارى وقتی که گفتیم اون جمع چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 355.78,
   "end": 358.2,
   "text": "سکارى جمع سکران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 358.2,
   "end": 362.7,
   "text": "یعنی مست. وقتی مستید نزدیک نماز نشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 362.7,
   "end": 364.7,
   "text": "و منهما حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 364.7,
   "end": 368.08,
   "text": "جماعت همه این زیاده آیات که این چنین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 368.08,
   "end": 371.38,
   "text": "این‌ها همه دلالت بر این داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 371.38,
   "end": 375.48,
   "text": "وقتی انسان در حالت مستی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 375.48,
   "end": 380.94,
   "text": "یا در حالت خواب هست یا در حالت حتی هیپنوتیزم هست یا حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 380.94,
   "end": 385.22,
   "text": "در کما، در کما جای دیگه حضرت استاد می‌فرمود در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 385.22,
   "end": 387.78,
   "text": "خواب مغناطیسی، در کما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 387.78,
   "end": 392.8,
   "text": "در هیچ حالتی نفس غافل از ظاهرش نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 392.8,
   "end": 395.64,
   "text": "حالا بالعکسش چی؟ آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 395.64,
   "end": 398.26,
   "text": "ظاهر غافل از باطن می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 398.26,
   "end": 402.28,
   "text": "یعنی حواسش از باطن پرت بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 402.28,
   "end": 410.48,
   "text": "ادامه کلمه رو بخونیم. \"پس نفس را مظهر لا تأخذهُ سیَنَةٌ ولا نوم می‌یابد.\" نفس دیگه مظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 410.48,
   "end": 414.06,
   "text": "لا تأخذهُ سیَنَةٌ تو آیات الکرسیه دیگه که خدا رو نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 414.06,
   "end": 417.32,
   "text": "خواب می‌گیره نه چرت. می‌گه نفس همین طوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 417.32,
   "end": 419.62,
   "text": "نفس اصلاً خواب و چرت نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 419.62,
   "end": 422.78,
   "text": "نفس چون مظهر ربه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 422.78,
   "end": 424.6,
   "text": "نفس داره می‌پرورونه ما رو دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 424.6,
   "end": 426.7,
   "text": "بدن رو نفس می‌پرورانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 426.7,
   "end": 430.88,
   "text": "رب ما به یک معنا رب نفس ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 430.88,
   "end": 433.74,
   "text": "که واسطه‌ی فیضه. برزخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 433.74,
   "end": 436.38,
   "text": "برزخ طولی البته نه عرضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 436.38,
   "end": 445.86,
   "text": "این داره در حقیقت ربوبیت حق رو پیاده می‌کنه و چون مظهر حقه اینم نه چرت می‌گیره نه خوابش می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 445.86,
   "end": 452.0,
   "text": "\"و از اینجا زیادت بصیرت حاصل کند که باطن عالم عین حیات و علم و آگاهی‌ست.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 452.0,
   "end": 456.14,
   "text": "باطن عالم غافل نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.14,
   "end": 461.84,
   "text": "خواب نیست، باطن خواب نیست، باطن غافل نیست، عین حیات و علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 461.84,
   "end": 466.6,
   "text": "چگونه‌ست که یسبح لله ما في السماوات وما في الأرض؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 466.6,
   "end": 469.22,
   "text": "چگونه‌ست که إن من شيء إلا یسبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 469.22,
   "end": 472.6,
   "text": "بحمده ولکن لا تفقهون تسبيحهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 472.6,
   "end": 477.22,
   "text": "شما نمی‌شنوید، نمی‌فهمید تسبیحشو ولی همه چی داره تسبیح می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 477.22,
   "end": 482.62,
   "text": "چگونه‌ست که عرفا به جایی می‌رسند که تسبیح اعضا و جوارح خودشون رو می‌شنوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 482.62,
   "end": 485.86,
   "text": "حتی صداهای قلبشون رو می‌شنوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 485.86,
   "end": 490.62,
   "text": "حضرت استاد در شرح مسأله انسشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 490.62,
   "end": 494.52,
   "text": "البته متآبه می‌کردن اما عین حق بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 494.52,
   "end": 498.44,
   "text": "می‌فرمودند که چگونه‌ست که آدمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 498.44,
   "end": 501.16,
   "text": "عبد البطن، بنده شکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 501.16,
   "end": 504.92,
   "text": "صدای قار و قر شکمشو می‌شنوه ما اینو قبول می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 504.92,
   "end": 508.06,
   "text": "بعد یه عبد القدوس، عبدالله صدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 508.06,
   "end": 511.6,
   "text": "ذکر اعضا و جوارحش رو نشنوه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 511.6,
   "end": 514.08,
   "text": "می‌شنوه. به جایی می‌رسه که می‌شنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 514.08,
   "end": 521.18,
   "text": "اصلاً ذکر اعضا و جوارحش می‌ره او رو برای نماز شب بیدار می‌کنه، سحر بیدار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 521.18,
   "end": 524.94,
   "text": "و ادامه می‌دن که \"هیچگاه از ظاهر غافل نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 524.94,
   "end": 527.2,
   "text": "اما ظاهر\" این جواب سوال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 527.2,
   "end": 532.62,
   "text": "\"اما ظاهر بر اثر اشتغال به غیرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 532.62,
   "end": 535.14,
   "text": "از باطن غافل می‌کرده است.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 535.14,
   "end": 538.94,
   "text": "یعنی ظاهر ما، بدن ما بی‌اطلاع از باطن می‌تونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 538.94,
   "end": 541.02,
   "text": "یا الان این نشئ طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 541.02,
   "end": 543.38,
   "text": "ظاهر عالمه دیگه. ظهوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 543.38,
   "end": 547.4,
   "text": "مرتبه ظهوره. این غافل می‌شه از باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 547.4,
   "end": 554.1,
   "text": "یعنی از عالم بالاتر، از عالم مثال، عقول، ملائکه، ارواح، عالم اله اینو-- این غافل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 554.1,
   "end": 557.54,
   "text": "چرا؟ چون اشتغال به غیره. اینجا القاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 557.54,
   "end": 561.14,
   "text": "عالم تعلقاته، دلبستنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 561.14,
   "end": 564.82,
   "text": "تضاهامات خیر و شر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 564.82,
   "end": 569.3,
   "text": "حق و باطل، نور و ظلمت اینجا مشوبن، قاطین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 569.3,
   "end": 572.54,
   "text": "هرکسی نمی‌تونه تشخیص بده. اصلاً اومدیم برای همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 572.54,
   "end": 574.84,
   "text": "که پل بزنیم از ظلمت به نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 574.84,
   "end": 578.2,
   "text": "یخرجهم من الظلمات إلى النور اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 578.2,
   "end": 581.02,
   "text": "که این‌ها هم به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 581.02,
   "end": 586.68,
   "text": "می‌طلبه یک جهاد پیگیر رو که انسان متوجه باشه که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 586.68,
   "end": 589.44,
   "text": "متوجه باشه که یه باطنی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 589.44,
   "end": 591.12,
   "text": "توجه داشته باشه به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 591.12,
   "end": 592.76,
   "text": "الان نمازو داره می‌خونه، بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 592.76,
   "end": 595.06,
   "text": "نگاش می‌کنی خیلی خوب، عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 595.06,
   "end": 600.2,
   "text": "خزوش برقراره. خزو یعنی مرتبه ظاهرش خیلی خوب داره نمازو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 600.2,
   "end": 602.26,
   "text": "قشنگ می‌خونه. کمیتش درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 602.26,
   "end": 605.54,
   "text": "شرعاً نمازش درسته. اما خشوع چگونه‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 605.54,
   "end": 611.16,
   "text": "یعنی ارتباطی بین ظاهر و باطن برقرار شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 611.16,
   "end": 614.1,
   "text": "صلاتش معراج بشه؟ هر چیزی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 614.1,
   "end": 616.84,
   "text": "نه صلات حالا یه نمونه‌ست، هر چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 616.84,
   "end": 619.98,
   "text": "اصلاً نفس کشیدن آن فآن نفس ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 619.98,
   "end": 623.66,
   "text": "خدا رحمت کنه حضرت آقای کشمیری رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 623.66,
   "end": 632.02,
   "text": "ایشون اگه کسی نزدیکش می‌شست قشنگ متوجه می‌شد که در هر نفسش داره ذکر می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 632.02,
   "end": 634.9,
   "text": "در هر نفسش. مثلاً یه مدتی ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 634.9,
   "end": 639.44,
   "text": "می‌گفت وقتی می‌خواست نفس بکشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 639.44,
   "end": 643.38,
   "text": "لا اله الا الله با این نفس می‌کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 643.38,
   "end": 645.7,
   "text": "لا اله. الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 645.7,
   "end": 647.62,
   "text": "لا اله. الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 647.62,
   "end": 650.58,
   "text": "آخرای عمرش لاhu.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 650.58,
   "end": 652.64,
   "text": "الا hu. لاhu.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 652.64,
   "end": 655.46,
   "text": "الا hu. لاhu.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 655.46,
   "end": 660.94,
   "text": "الا hu. ذکر شریف توحید ذاتی رو لا hu الا hu، لا hu و الا hu",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 660.94,
   "end": 663.98,
   "text": "یا باز شدش یا ملا hu",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 663.98,
   "end": 668.56,
   "text": "الا hu. اینا اصلاً نمی‌تونست دیگه دست خودش نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 668.56,
   "end": 670.84,
   "text": "انقدر تمرین و مبارزت داشت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 670.84,
   "end": 673.94,
   "text": "تهذیب نفسش. اصل ظاهر و باطن یکی شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 673.94,
   "end": 677.9,
   "text": "اصلاً نمی‌تونست نگہ. مثل حضرت آقای قاضی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 677.9,
   "end": 684.5,
   "text": "یا مثلاً در حالات آمیز جواد آقا داریم، در حالات آقای کشمیری داریم، در حالات آقای قاضی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 684.5,
   "end": 686.98,
   "text": "این کتابا چقدر خوبه این‌ها رو ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 686.98,
   "end": 689.88,
   "text": "بخونیم. ما نوجوون که بودیم حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 689.88,
   "end": 694.76,
   "text": "بیست سالمون بود یه جماعتی بودیم با هم کتاب‌های بزرگانو می‌خوندیم، همینطور زندگی نامه‌هاشون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 694.76,
   "end": 697.4,
   "text": "خیلی باعث تشریف انسان می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 697.4,
   "end": 703.36,
   "text": "که خیلی‌ش اینو می‌بینیم در حالاتشون هست که مثلاً مواجه با حرام که می‌شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 703.36,
   "end": 705.38,
   "text": "مثلاً یه نامحرمی اومده فلان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 705.38,
   "end": 709.26,
   "text": "مواجه که می‌شدن می‌گفتن ناخودآگاه چشمامون بسته می‌شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 709.26,
   "end": 712.46,
   "text": "اصلاً بی‌اختیار. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 712.46,
   "end": 718.58,
   "text": "انقدر ظاهر و باطن با هم عجین شدن، ظاهر تحت‌الامر باطن قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 718.58,
   "end": 721.4,
   "text": "انقدر باطن استیلا پیدا کرده بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 721.4,
   "end": 725.1,
   "text": "ظاهرش، اصلاً خودبه‌خود پلکش بسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 725.1,
   "end": 727.12,
   "text": "حالا یکی مثل من همین‌جوری شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 727.12,
   "end": 731.96,
   "text": "برعکس باشه دیگه. دیگه باطن داد می‌زنه که آقا، آقا کجا داری میری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 731.96,
   "end": 735.22,
   "text": "چشم می‌دوه و همینطوری. اینا در اثر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 735.22,
   "end": 738.42,
   "text": "نداشتن تمرین، مبارزت و متأسفانه غفلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 738.42,
   "end": 741.78,
   "text": "غفلت ها جان. غفلت ما رو بیچاره کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 741.78,
   "end": 745.82,
   "text": "سکرت رو فرمودن غفلته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 745.82,
   "end": 748.8,
   "text": "غفلت. لذا اون لحظه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 748.8,
   "end": 751.56,
   "text": "فکشفنا عنک غطاءک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 751.56,
   "end": 753.62,
   "text": "فبصرک اليوم حدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 753.62,
   "end": 760.98,
   "text": "پرده که می‌افته، این وقتی متوجه می‌شه چه غفلتی کرد، چقدر غافل بوده در دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 760.98,
   "end": 764.1,
   "text": "چشمش تیز می‌شه، بینا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 764.1,
   "end": 769.82,
   "text": "این خیلی مهمه. یه جمع‌بندی کنم که ما بدانیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 769.82,
   "end": 771.92,
   "text": "ظاهر و باطن با هم عجین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 771.92,
   "end": 773.66,
   "text": "ما یک حقیقتی‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 773.66,
   "end": 779.12,
   "text": "نه، نه اینکه ظاهرمون یه چیزه باطنمون یه چیز دیگه‌ست، یک حقیقتی‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 779.12,
   "end": 782.06,
   "text": "چگونه‌ست که اگر کسی به این بدنش نرسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 782.06,
   "end": 785.32,
   "text": "این بدنش آب می‌شه، ذوب می‌شه، از بین می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 785.32,
   "end": 787.84,
   "text": "ولی قبول نداریم که به ظاهرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 787.84,
   "end": 790.34,
   "text": "داره می‌رسه، این چنین فربه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 790.34,
   "end": 796.72,
   "text": "ترگل مرگله. اگه به باطنش نرسه باطنش آب می‌شه، ذوب می‌شه، از بین می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 796.72,
   "end": 801.48,
   "text": "ما یک حقیقتی‌م دیگه. این رو قبول کردیم ولی اون رو قبول نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 801.48,
   "end": 806.54,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 806.54,
   "end": 810.94,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 810.94,
   "end": 813.74,
   "text": "محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}