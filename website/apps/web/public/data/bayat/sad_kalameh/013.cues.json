 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ دوازده؛ ارزش انسان همان آرمان اوست",
   "start": 7.5,
   "end": 133.7
  },
  {
   "index": 1,
   "title": "## دعا آینهٔ آرمان",
   "start": 133.7,
   "end": 208.72
  },
  {
   "index": 2,
   "title": "## فاطمه و طلبِ نظر در وجه",
   "start": 208.72,
   "end": 393.86
  },
  {
   "index": 3,
   "title": "آنچه در درون می‌گذرد نوشته شده؛ کتابی است. و:",
   "start": 393.86,
   "end": 417.8
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 4.84,
   "text": "سلام علیک یا داعی الله و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.84,
   "end": 7.5,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.5,
   "end": 12.38,
   "text": "کلمه دوازده از صد کلمه در معرفت حضرت علامه عسگرزاده علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.38,
   "end": 15.84,
   "text": "می‌فرمود که آن که به هر آرمانه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.84,
   "end": 21.52,
   "text": "ارزش او همان است. اشاره دارد به همان حکمت هشتاد و یک نهج که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.52,
   "end": 28.22,
   "text": "یه روزی در خصوصش فکر می‌کنم در اولین جلسه قلب منغمر بود، قلب بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.22,
   "end": 33.84,
   "text": "اونجا بحث کردیم که قیل-- قیمت و کل امرئ ما يحسنه و این متن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.84,
   "end": 38.5,
   "text": "فرمایش مولامون علی علیه الصلاة والسلام بود که اونجا به یک معنای دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.5,
   "end": 40.4,
   "text": "به یک برداشت دیگه‌ای حول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.4,
   "end": 44.32,
   "text": "حوش این فرمایش شریف حرف زدیم که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.32,
   "end": 49.42,
   "text": "اینجا می‌فرمود ارزش هر انسانی به همان است که آن را نیکو می‌شمارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.42,
   "end": 52.1,
   "text": "اونجا گفتیم نیکو انجام می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.1,
   "end": 55.58,
   "text": "اینجا حالا بزرگان تعابیر مختلفی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.58,
   "end": 60.18,
   "text": "بله میشه وقتی که یک حرف از قرآن هفتاد هزار معنا دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.18,
   "end": 62.72,
   "text": "حدیث اهل بیت هم همچنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.72,
   "end": 64.84,
   "text": "هرکی به ظرف وجودیش برداشتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.84,
   "end": 69.68,
   "text": "مثلا علامه جعفری علیه الرحمه اینطوری برداشت کردن از این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.68,
   "end": 75.5,
   "text": "فرمودن ارزش هر انسانی ناشی از آن امتیاز نیکوست که در اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.5,
   "end": 79.04,
   "text": "یعنی اون امتیاز نیکویی که در خودشه ارزشش همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.04,
   "end": 81.52,
   "text": "یعنی به چی امتیاز میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.52,
   "end": 85.12,
   "text": "مثلا قیامت میگه و امتاز الیوم ایها المجرمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.12,
   "end": 87.92,
   "text": "اینجا امتیازی که من به شما اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.92,
   "end": 93.5,
   "text": "جرم و فسق و فجور و اینا میدم اینه که بفرمایید اینجا بفرمایید اینور شما جدا بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.5,
   "end": 96.2,
   "text": "جداشون میکنه. این جداسازی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.2,
   "end": 100.4,
   "text": "در، درون، درون کتاب وجودی ما مرقوم شده، نوشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.4,
   "end": 103.42,
   "text": "تا جایی که یعنی اینکه ما بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.42,
   "end": 106.08,
   "text": "آرمانمون چیه؟ اون چیزی که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.08,
   "end": 109.2,
   "text": "خیلی خلاصه بگیم خودمونی عرض کنیم همه فهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.2,
   "end": 112.84,
   "text": "دلم چی میخواد؟ دل من دنبال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.84,
   "end": 115.36,
   "text": "اونچه که در کتاب وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.36,
   "end": 119.58,
   "text": "رقم خورده، مرقوم شده، نوشته شده، چه خوبان، چه بدان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 119.58,
   "end": 122.62,
   "text": "همون خطورات قلبی و افکار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.62,
   "end": 125.44,
   "text": "اون چیزی هواها و اون چیزایی که دنبالشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 125.44,
   "end": 128.1,
   "text": "دنبال چیه؟ قیمتش همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 128.1,
   "end": 132.44,
   "text": "یعنی اون چیزی که بهش امتیاز داده دنبال همونم میره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 132.44,
   "end": 134.9,
   "text": "به یه وجهی این‌ها رو میشه از دعاها فهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 134.9,
   "end": 139.5,
   "text": "مثلا آقای قراتی یه روز می‌فرمود که از دعاهای خودت، خودت رو بشناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 139.5,
   "end": 143.3,
   "text": "جمله خوبی بود. جمله قشنگی ایشون فرمودن مبنایی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 143.3,
   "end": 150.86,
   "text": "واقعاً آدم چی می‌خواد؟ مثلا قرآن به ما میگه بگه آقا ربنا آتنا فی الدنيا حسنة و فی الآخرة حسنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.86,
   "end": 153.48,
   "text": "هیچ، هیچ کدومو به خاطر اون یکی ول نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.48,
   "end": 155.18,
   "text": "دوتاشو و قنا عذاب النار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 155.18,
   "end": 161.28,
   "text": "که البته این حسنه به یک تعبیری فرمودن محبت فاطمه زهرا سلام الله علیهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 161.28,
   "end": 163.76,
   "text": "تو دو دنیا ما اینو طلب می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 163.76,
   "end": 168.5,
   "text": "خب این از دعا معلوم میشه که طلب وجودی طرف چیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.5,
   "end": 175.32,
   "text": "یا اونجا که عرض می‌کنیم تو دعا ربنا ما خلقت هذا باطلا سبحانک فقنا عذاب النار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 175.32,
   "end": 177.6,
   "text": "این نشأت طبیعت رو باطل ن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 177.6,
   "end": 181.58,
   "text": "نمی‌دونی. یعنی یه عبث و بیهوده نمی‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.58,
   "end": 185.84,
   "text": "یعنی براش یه منظوری از سمت تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 185.84,
   "end": 190.28,
   "text": "مشخص شده. اینها نشون میده که نگاه تو به این دنیا چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 190.28,
   "end": 195.52,
   "text": "یا حتی مثلا اینا دعاهای قرآنی یا در دعاهایی که خود اهل بیت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 195.52,
   "end": 200.68,
   "text": "الهی هب لي مناج، مناجات شعبانیه کمال الانقطاع الیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.68,
   "end": 203.9,
   "text": "کمال انقطاع به سمت خدا رو وقتی می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.9,
   "end": 205.96,
   "text": "یعنی هیچ چیزی به اندازه حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.96,
   "end": 207.98,
   "text": "حضرت حق براش ارزشمند نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 207.98,
   "end": 210.12,
   "text": "وقتی که خدا به ح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 210.12,
   "end": 216.26,
   "text": "پیغمبرش فرمود به فاطمه بگو از من چیزی بخواه، عجیبه واقعاً حضرت فاطمه زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.26,
   "end": 220.34,
   "text": "سلام الله علیها عرض کرد یا بابا من هیچی نمی‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.34,
   "end": 222.68,
   "text": "خدایی به این خوبی دارم دیگه چی می‌خوام؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 222.68,
   "end": 228.72,
   "text": "الله اکبر. بعد خدا فرمود نمیشه احمد جان باید فاطمه از من چیزی بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 228.72,
   "end": 230.86,
   "text": "بایدیه. یعنی الزامیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 230.86,
   "end": 237.8,
   "text": "حکم الزامیه. و حضرت فاطمه به نظر شما چی خواسته در اجبار خواستن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.8,
   "end": 240.56,
   "text": "حالا من بودم می‌گفتم همه دنیا رو به من بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.56,
   "end": 243.58,
   "text": "حضرت زهرا فرمود انظر في وجهک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.58,
   "end": 245.32,
   "text": "دوست دارم وجهت رو ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 245.32,
   "end": 248.12,
   "text": "یعنی می‌بینه اما می‌خواد عمیق‌تر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 248.12,
   "end": 252.48,
   "text": "تا جایی که باباش رسول الله می‌فرماید لي مع الله وقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 252.48,
   "end": 255.5,
   "text": "برای من یه حالا یه وقت‌هایی هست وقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 255.5,
   "end": 258.26,
   "text": "همیشه البته نیست. وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 258.26,
   "end": 260.36,
   "text": "لي مع الله. مع الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 260.36,
   "end": 262.72,
   "text": "یه وقت‌هایی هست که لا يسعني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 262.72,
   "end": 264.68,
   "text": "فيه ملك مقرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 264.68,
   "end": 266.96,
   "text": "أو نبي مرسل. یعنی نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 266.96,
   "end": 273.4,
   "text": "هیچ ن-- هیچ نبی مرسلی و هیچ ملکی اونجا همراه من، منم و خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 273.4,
   "end": 280.54,
   "text": "و اونجا به قول حکما و عرفا میگن اونجا دیگه خودش هم حتی ورمیداره چون خودش هم نبیه، خودش هم مرسله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 280.54,
   "end": 282.2,
   "text": "ولا نبي مرسل یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 282.2,
   "end": 285.52,
   "text": "یعنی خودمم نیستم. دیگه هرچی هست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 285.52,
   "end": 287.94,
   "text": "ببین به کجا میره. شما آرمان رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 287.94,
   "end": 291.04,
   "text": "آرمان هرکسی مشخصه که چیکاره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 291.04,
   "end": 294.76,
   "text": "اگر آرمانش حیوانیه، معذرت میخوام شهواته، دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 294.76,
   "end": 297.66,
   "text": "مثلا همش به دائم به این چیزا فکر میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 297.66,
   "end": 301.2,
   "text": "همش میخواد پشت میز بشینه دستور بده، تکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 301.2,
   "end": 303.58,
   "text": "و این چیه؟ مشخصه چه جور آدمیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 303.58,
   "end": 305.72,
   "text": "خودش راحت خودش رو میشناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 305.72,
   "end": 308.98,
   "text": "قرآن هم میفرماید بل الإنسان على نفسه بصيرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 308.98,
   "end": 313.24,
   "text": "بصيرة. از همه به خودت آگاه‌تری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 313.24,
   "end": 319.06,
   "text": "اما نه یه کسی هست دنبال اینه که خدمت کنه، به معرفت برسه، زیارت کنه، به شهادت برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 319.06,
   "end": 324.0,
   "text": "خب اینا ارزش و آرمان هرکسی با اون چیزیه که پیشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 324.0,
   "end": 329.4,
   "text": "از آرمان‌های خودش، از اون آرزوهای خودش، از دعاهای خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 329.4,
   "end": 332.12,
   "text": "از اون آه‌هایی که تو دلش می‌کشه معلومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 332.12,
   "end": 336.88,
   "text": "یکی ماشین شاسی بلند و یه مثلا کاخ خوش فلان می‌بینه آه می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 336.88,
   "end": 339.16,
   "text": "یکی هم مثلا از اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 339.16,
   "end": 343.32,
   "text": "عزيز علي أن أرى الخلق ولا ترى آه می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 343.32,
   "end": 347.56,
   "text": "هل إليك يا ابن أحمد سبيل فتلقى آه می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 347.56,
   "end": 350.18,
   "text": "اینا فرق می‌کنند کاملا. حالا قرآن هم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 350.18,
   "end": 351.9,
   "text": "فرق رو کاملا مشخص کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 351.9,
   "end": 354.18,
   "text": "در آیات هجده به بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 354.18,
   "end": 358.36,
   "text": "سوره متفfin فرمود كلا إن الأبرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 358.36,
   "end": 360.86,
   "text": "لفي عليین. و ما أدراک ما عليین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 360.86,
   "end": 363.88,
   "text": "کتاب مرقوم. ببین کتاب مرقوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 363.88,
   "end": 366.96,
   "text": "اونچه که در درون ما می‌گذره نوشته شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 366.96,
   "end": 369.98,
   "text": "یه کتابیست. يشهدہ المقربون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 369.98,
   "end": 373.38,
   "text": "اینو کاملا شاهدن براش اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 373.38,
   "end": 375.34,
   "text": "نزدیک، اونایی که خیلی نزدیک شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 375.34,
   "end": 379.9,
   "text": "این یه کتابیه که إن الأبرار لفي نعیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 379.9,
   "end": 382.0,
   "text": "همین الان تو نعمتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 382.0,
   "end": 389.02,
   "text": "بعد دوباره آیات بالایش می‌فرماید إن الفجار لفي سجين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 389.02,
   "end": 393.86,
   "text": "یا ان-- كلا إن كتاب الفجار لفي سجين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 393.86,
   "end": 397.3,
   "text": "کتاب فجار. کتاب فجار چرا میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 397.3,
   "end": 399.36,
   "text": "یعنی همون اعمال و آرزوها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 399.36,
   "end": 402.16,
   "text": "یعنی همونچه که خطورات قلبیشه، اون آه‌های دلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 402.16,
   "end": 404.54,
   "text": "اینا همه نوشته شده اما در کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 404.54,
   "end": 408.5,
   "text": "در سجين. پس امروز، الان، همین الان مهک بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 408.5,
   "end": 410.32,
   "text": "آرمان و آرزوی من چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 410.32,
   "end": 412.28,
   "text": "من همونم. والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 412.28,
   "end": 414.54,
   "text": "ان شا الله عاقبت ما ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 414.54,
   "end": 417.8,
   "text": "به برکت صلوات بر محمد و آل محمد. الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}