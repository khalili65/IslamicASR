 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ چهل‌ودو؛ کشیک نفس",
   "start": 13.12,
   "end": 97.48
  },
  {
   "index": 1,
   "title": "## غرر الحکم آمدی؛ کلمات قصار علی",
   "start": 97.48,
   "end": 310.56
  },
  {
   "index": 2,
   "title": "## میرزا جواد ملکی؛ مراقبه روز و صافی شب",
   "start": 310.56,
   "end": 388.79
  },
  {
   "index": 3,
   "title": "## علامه؛ تقلب قلب و تجلی بدون تکرار",
   "start": 388.79,
   "end": 602.21
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.7,
   "end": 5.66,
   "text": "بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.66,
   "end": 9.46,
   "text": "السلام علیک يا داعي الله و رباني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.46,
   "end": 13.12,
   "text": "آياته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.12,
   "end": 23.74,
   "text": "کلمه چهل و دو. آن که چند روزی کشیک نفس خود بکشد و صادرات و واردات آن را مواظب باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.74,
   "end": 28.5,
   "text": "به درد خود می‌رسد و چاره درمانش می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.5,
   "end": 35.9,
   "text": "بله الان غالب مردم گرفتار دردها و بیچارگی‌هایی هستند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 35.9,
   "end": 40.82,
   "text": "اینجا حضرت استاد به شیوایی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.82,
   "end": 43.02,
   "text": "خیلی همه فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.02,
   "end": 48.82,
   "text": "چاره درد رو و این درمان رو بیان می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.82,
   "end": 50.92,
   "text": "کشیک نفس دادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.92,
   "end": 53.6,
   "text": "نفس خودت رو، اونم نه دیگران رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.6,
   "end": 55.84,
   "text": "و مراقبت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.84,
   "end": 59.2,
   "text": "صادرات و واردات که البته اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.2,
   "end": 61.84,
   "text": "صادر می‌شود بر اساس واردات هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.84,
   "end": 65.5,
   "text": "اونچه که انسان ازش صادر میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.5,
   "end": 67.6,
   "text": "نسبت به اون چیزیست که وارد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.6,
   "end": 71.44,
   "text": "مثلا اونچه که ما می‌بینیم، می‌شنویم، می‌چشیم، می‌بویم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.44,
   "end": 77.96,
   "text": "لمس می‌کنیم، اِاِاِ متخیلاتمون، این‌ها همه واردات‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.96,
   "end": 80.56,
   "text": "و اونچه که در پس این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.56,
   "end": 85.18,
   "text": "از ما عمل صادر میشه یا نیت می‌کنیم میشه صادرات ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.18,
   "end": 88.94,
   "text": "هرچی اون واردات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.94,
   "end": 93.88,
   "text": "مغوب‌تر، بهتر، پاک‌تر، صادرات بهتر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.88,
   "end": 96.42,
   "text": "به قول امروزی‌ها برندتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.42,
   "end": 101.86,
   "text": "یه اتفاقاً کتاب شریفی است به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.86,
   "end": 104.18,
   "text": "غرر الحکم و درر الكلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.18,
   "end": 108.36,
   "text": "این کتاب مال مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.36,
   "end": 115.32,
   "text": "عامدی‌ست که البته اسم کاملشون قاضی ناصح الدین ابوالفتح عبد الواحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.32,
   "end": 119.1,
   "text": "ابن محمد تمیمی عامدی متوفی سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.1,
   "end": 122.4,
   "text": "پونصد و ده هجری قمریه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.4,
   "end": 127.42,
   "text": "بعد از شریف رضی که جامع نهج البلاغه است، ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.42,
   "end": 131.32,
   "text": "اِاِاِ حدوداً یک قرن بعد از شریف رضی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.32,
   "end": 133.94,
   "text": "ایشون اِاِاِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.94,
   "end": 143.64,
   "text": "قریب به یازده هزار و پنجاه کلمه از کلمات قصار امیرالمؤمنین صلی الله علیه رو جمع‌آوری کردن و در این کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.64,
   "end": 147.66,
   "text": "به روش خاصی به ترتیب حروف تهجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.66,
   "end": 150.02,
   "text": "گردآوری کردن. کتاب بسیار شریفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.02,
   "end": 153.64,
   "text": "اونجا به عنوان نمونه عرض می‌کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.64,
   "end": 158.46,
   "text": "روایتی رو همین از کلمات قصار مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.46,
   "end": 161.22,
   "text": "میارن. مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.22,
   "end": 164.44,
   "text": "که حضرت می‌فرماید \"من لم یعذب نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.44,
   "end": 167.22,
   "text": "فظحه سوء العاده\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.22,
   "end": 173.06,
   "text": "هرکسی که خودش رو معذب نکنه، عادت‌های زشت اون رو رسوا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.06,
   "end": 177.2,
   "text": "این رسوایی‌هایی که پیش میاد این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.2,
   "end": 182.16,
   "text": "چه خودم پیش خودم رسوا بشم، چه پیش دیگران غالباً به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.16,
   "end": 188.26,
   "text": "معذب نساختن نفسه، تهذیب نفس نداشتنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.26,
   "end": 191.88,
   "text": "و درمان نکردن دردها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.88,
   "end": 195.7,
   "text": "پیدا نکردن چاره بیچارگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.7,
   "end": 205.04,
   "text": "یا باز در همون کتاب شریف از مولامون علی علیه الصلاة والسلام نقل می‌کنه که \"من لم یعذب نفسه لم ينتفع بالعقل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 205.04,
   "end": 207.88,
   "text": "خیلی خطرناکه نهی به این حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.88,
   "end": 211.44,
   "text": "که هر که خودش رو تزکیه نکنه از عقلش بهره نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.44,
   "end": 215.7,
   "text": "خب وقتی هم که از عقلش بهره نگرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.7,
   "end": 220.56,
   "text": "طبق همون آیه صد سوره نساء که بارها عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.56,
   "end": 226.08,
   "text": "اِاِاِ \"ويجعل و یجعل الذين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.08,
   "end": 229.98,
   "text": "اِاِاِ و یجعل الرجس على الذين لا يعقلون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.98,
   "end": 233.32,
   "text": "انتهای آیه اینطوری تموم میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.32,
   "end": 238.84,
   "text": "بر اون کسایی که اهل تعقل نیستن آلودگی قرار داده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.84,
   "end": 244.28,
   "text": "این نشون میده که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.28,
   "end": 249.04,
   "text": "تهذیب نفس نکند، نکنه، اهل تهذیب نفس نباشه، قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.04,
   "end": 251.8,
   "text": "دچار بی‌عقلی میشه و بهره‌ای از عقل نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.8,
   "end": 256.24,
   "text": "کسی هم که بهره‌ای از عقلش نبرد، آلودگی میاد سراغش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.24,
   "end": 265.4,
   "text": "یا باز از امام علی در همان کتاب داریم \"العاقل يتقاضى نفسه بما يجب عليه ولا يتقاضى لنفسه بما يجب له\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.4,
   "end": 268.18,
   "text": "خیلی هم شیرین که اینجا حضرت می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 268.18,
   "end": 271.32,
   "text": "یه آدم عاقل، آدم خردمند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.32,
   "end": 277.12,
   "text": "در قبال وظایفی که داره از نفس خودش بازخواست می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 277.12,
   "end": 280.96,
   "text": "از نفس خودش البته بازخواست می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.96,
   "end": 289.0,
   "text": "و بر-- همچنین حضرت ادامه میدن که برای اون وظیفه‌ای که دیگران در، در قبال او دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 289.0,
   "end": 291.12,
   "text": "از مردم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.12,
   "end": 293.76,
   "text": "قبال نفس خودش بازخواست نمی‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.76,
   "end": 298.96,
   "text": "بلکه گذشت می‌کنه. در حالی که ما متاسفانه خیلی‌هامون برعکسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.96,
   "end": 302.12,
   "text": "از دیگران بازخواست می‌کنیم، نفس دیگران رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.12,
   "end": 310.56,
   "text": "کشیک می‌کشیم و مراقبیم که مثلاً وظایفشون نسبت به ما درست انجام بدن اما از نفس خودمون غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 310.56,
   "end": 315.8,
   "text": "و این بلای بزرگیست که متاسفانه همه ما رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 315.8,
   "end": 320.66,
   "text": "باز در همان کتاب مولا فرمودن \"الاشتقال بتهذیب النفس أصلح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 320.66,
   "end": 323.78,
   "text": "اشتغال به تهذیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 323.78,
   "end": 328.12,
   "text": "نفس از هر کاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 328.12,
   "end": 335.4,
   "text": "اصلح‌تره، اصلحه. یعنی صالح‌ترین کار، بهترین کار اشتغال مشغول بودن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 335.4,
   "end": 338.64,
   "text": "اینکه انسان نفسش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 338.64,
   "end": 341.34,
   "text": "عقاب کنه، معاقب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 341.34,
   "end": 344.98,
   "text": "و این عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 344.98,
   "end": 349.18,
   "text": "در همین خصوص از مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 349.18,
   "end": 354.56,
   "text": "آمیر زواد آقای ملکی تبریزی هم نقل شده که ایشون می‌فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 354.56,
   "end": 361.05,
   "text": "هر وقت که من روز مراقبت بیشتری داشتم، شب‌ها تمسلات و مکاشفات صافی‌تری داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 361.05,
   "end": 366.71,
   "text": "و از این قبیل موارد از بزرگان اهل معرفت بسیار بیان شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 366.71,
   "end": 368.33,
   "text": "چقدر تاثیر داره مراقبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 368.33,
   "end": 374.77,
   "text": "بسیاری از ما که بعد از دهه‌ها، دهه‌های جلسات اهل بیت و عزاداری‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 374.77,
   "end": 377.23,
   "text": "جل-- زیارت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 377.23,
   "end": 380.01,
   "text": "چقدر زحمت می‌کشیم بعضی‌هامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 380.01,
   "end": 381.95,
   "text": "در مسیر کارهای خیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 381.95,
   "end": 388.79,
   "text": "این‌ها. اما چیزی آخرش برامون نمی‌مونه به جهت اینکه نداشتن مراقبه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 388.79,
   "end": 393.27,
   "text": "که حضرت استاد اتفاقا علامه در کتاب عن نهض الحق‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 393.27,
   "end": 397.93,
   "text": "تصریح می‌کنند که نفس در مقام قلب و تقلب و تطور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 397.93,
   "end": 401.51,
   "text": "هی طورش تغییر می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 401.51,
   "end": 403.75,
   "text": "و متقلبه. هی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 403.75,
   "end": 405.41,
   "text": "انقلاب درش ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 405.41,
   "end": 415.41,
   "text": "از این رو به اون رو می‌شه. بعد می‌فرمایند که هر دم تجلیات الهیه بدون تکرار در تجلی بر او فائز می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 415.41,
   "end": 418.31,
   "text": "تجلی حضرت حق میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 418.31,
   "end": 423.27,
   "text": "بدون تکرار آنفًا آن همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 423.27,
   "end": 425.77,
   "text": "عرض کردیم قبلاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 425.77,
   "end": 431.83,
   "text": "بحث از شبات خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 431.83,
   "end": 440.97,
   "text": "در بله لقاء الله بحث لقاء الله یادمه گفتیم در شب جمعه هیئت یا زهرا شرق تهران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 440.97,
   "end": 447.55,
   "text": "اونجا مثالی که بزرگان می‌زدن در بحث تجلی این که عکس ماه یا خودمون که می‌افته روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 447.55,
   "end": 453.35,
   "text": "رودخانه آبی و این آب داره با سرعت حرکت می‌کنه، ما عکس رو ثابت می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 453.35,
   "end": 456.89,
   "text": "اینجا می‌فرماید تجلیات الهیه بدون تکرار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 456.89,
   "end": 459.97,
   "text": "بدون تکرار در تجلی بر او فائز می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 459.97,
   "end": 463.79,
   "text": "ما فکر می‌کنیم که این عکس روی آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 463.79,
   "end": 467.65,
   "text": "ثابته. تکرار شدنه، پشت تکراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 467.65,
   "end": 474.95,
   "text": "اما در حقیقت اون آب آنفًا آن در حال حرکته است و تجلی جدید است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 474.95,
   "end": 478.63,
   "text": "خداوند متعال هم همینطور تجلی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 478.63,
   "end": 484.79,
   "text": "و ح-حضرت استاد ادامه میدن که این قلب عارف به الله است که کشیک نفس می‌کشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 484.79,
   "end": 487.33,
   "text": "و پاسبان حرم دل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 487.33,
   "end": 489.39,
   "text": "و در مقام قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 489.39,
   "end": 493.39,
   "text": "کسی که عارف به الله خدا رو درست شناخته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 493.39,
   "end": 498.93,
   "text": "الله رو درست معرفت پیدا کرده، اهل کشیک نفسه، مراقب خودشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 498.93,
   "end": 502.65,
   "text": "و خودش پاسبان حرم دلشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 502.65,
   "end": 509.59,
   "text": "و در مقام قلبه و برای اینکه برسه به مقام قلب همونطور که قبلاً عرض شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 509.59,
   "end": 513.93,
   "text": "در بحث قلب در قرآن بسیار عرض کردیم مراتب محفوظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 513.93,
   "end": 518.21,
   "text": "باید از طریق و کانال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 518.21,
   "end": 521.99,
   "text": "و جاده عقل حرکت کرد و به قلب رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 521.99,
   "end": 523.61,
   "text": "غیر از این هم راهی ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 523.61,
   "end": 527.73,
   "text": "کسی که از طریق غیر عقلش حرکت کنه به قلب نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 527.73,
   "end": 529.35,
   "text": "قلب هم که مقام حضور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 529.35,
   "end": 532.97,
   "text": "اگر ما حضور قلب نداریم، حاضر نیستیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 532.97,
   "end": 535.57,
   "text": "خودمون رو در محضر حضرت حق نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 535.57,
   "end": 540.75,
   "text": "لذا ذکرمون دوام نداره، نمازمون اعراج نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 540.75,
   "end": 543.55,
   "text": "ذکرمون حال نداره و و و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 543.55,
   "end": 546.31,
   "text": "این‌ها به جهت نداشتن حضور قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 546.31,
   "end": 552.11,
   "text": "در نتیجه کار عقلی نکردنه که از طریق تعقل و عقل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 552.11,
   "end": 556.71,
   "text": "عرض شود قوهایی که خدا در ما تعبیه کرده نرسیدیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 556.71,
   "end": 568.81,
   "text": "قلب و مقام قلب. لذا روز به روز می‌بینیم متاسفانه بدتر از دیروز همچنین رها هستیم و خودمون به درد خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 568.81,
   "end": 573.23,
   "text": "نمی‌رسیم. یه سال‌ها دل طلب جام جم از ما می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 573.23,
   "end": 576.45,
   "text": "آن که خود داشت ز بیگانه تمنا می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 576.45,
   "end": 578.69,
   "text": "عزیزم درد و درمان تو خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 578.69,
   "end": 584.03,
   "text": "باید تو خودمون فرو بریم. سر در گریبان خودمون فرو ببریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 584.03,
   "end": 586.41,
   "text": "قلب عبارتیه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 586.41,
   "end": 592.11,
   "text": "که اگر کسی سر در گریبان خودش ببره و تلطیف سر کنه کار تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 592.11,
   "end": 594.95,
   "text": "می‌بینی قرآن نازل می‌شه بر قلبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 594.95,
   "end": 598.39,
   "text": "به نسبت بصره وجودیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 598.39,
   "end": 600.67,
   "text": "خب ان شا الله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 600.67,
   "end": 602.21,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}