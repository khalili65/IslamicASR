 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ بیست‌وسوم؛ زرع و زارع و مزرعه",
   "start": 11.56,
   "end": 39.08
  },
  {
   "index": 1,
   "title": "## تناسخِ حقیقیِ اسلامی",
   "start": 39.08,
   "end": 255.6
  },
  {
   "index": 2,
   "title": "## هرچه هست خودیم",
   "start": 255.6,
   "end": 395.16
  },
  {
   "index": 3,
   "title": "## غفلت نورزیم",
   "start": 395.16,
   "end": 431.48
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.4,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.4,
   "end": 7.2,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.2,
   "end": 11.56,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.56,
   "end": 17.16,
   "text": "کلمه بیست و سه. آنکه خود را زرع و زارع و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.16,
   "end": 20.02,
   "text": "مزرعه خویش نداند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.02,
   "end": 24.92,
   "text": "از سعادت جاودانی بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.92,
   "end": 27.6,
   "text": "خب نهی بیست اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.6,
   "end": 32.2,
   "text": "حضرت علامه دارن از خطر غفلت از این حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.2,
   "end": 35.12,
   "text": "چه حقیقتی؟ که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.12,
   "end": 37.8,
   "text": "همین اتحاد زرع و زارع و مزروع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.8,
   "end": 40.74,
   "text": "می‌فرماید اگر کسی به این حقیقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.74,
   "end": 44.02,
   "text": "از این حقیقت غافل باشه قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.02,
   "end": 46.84,
   "text": "از سعادت همیشگی باز می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.84,
   "end": 50.18,
   "text": "یعنی پیداست که حقیقت مهمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.18,
   "end": 53.48,
   "text": "و این موضوع رو خود حضرت علامه در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.48,
   "end": 57.36,
   "text": "رس- اون رساله عن نحو الحق‌شون اینطوری بیان کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 57.36,
   "end": 60.64,
   "text": "هرکس در تحصیل علم و عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.64,
   "end": 65.12,
   "text": "زرع و زارع و مزرعه و بذر خودست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 65.12,
   "end": 68.36,
   "text": "پس اتحاد همه اینا خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 68.36,
   "end": 72.5,
   "text": "خودش زارعه، اون زمین کشتش خودشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 72.5,
   "end": 75.34,
   "text": "دانه‌ای که می‌کاره خودشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.34,
   "end": 78.06,
   "text": "محصولی هم که میده خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 78.06,
   "end": 83.06,
   "text": "چه عجیب! حالا یه کتاب به چه عظمتی حضرت علامه عسگرزاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 83.06,
   "end": 85.0,
   "text": "در البته شرحی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 85.0,
   "end": 87.68,
   "text": "که خودش یه کتاب جداگانه‌ای شد بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 87.68,
   "end": 92.8,
   "text": "کتاب اتحاد عاقل به معقول استادشون حضرت علامه رفیع قزوینی نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 92.8,
   "end": 96.4,
   "text": "بس تو همین موضوع یه کتاب به چه عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 96.4,
   "end": 98.92,
   "text": "که چه دیدی به انسان میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 98.92,
   "end": 105.12,
   "text": "و در ادامه علامه تو همین رساله عن نحو الحق می‌فرمایند که و صورت هر انسانی اینو دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 105.12,
   "end": 109.1,
   "text": "که قراره همه ما اینو درک کنیم به همین جا برسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 109.1,
   "end": 112.2,
   "text": "و صورت هر انسان در آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 112.2,
   "end": 116.5,
   "text": "نتیجه‌ی عمل و غایت فعل او در دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 116.5,
   "end": 120.46,
   "text": "که بعد اشاره می‌کنم به این حدیث شریف که \"الدنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 120.46,
   "end": 125.34,
   "text": "مزرعه الآخره\". میگه اگه این غافل باشی دیگه از سعادت افتادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 125.34,
   "end": 128.0,
   "text": "الان داری خودتو می‌سازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 128.0,
   "end": 134.26,
   "text": "همون که عرض کردیم در کتاب رساله شریف انسان در عرش عرفان که از اون اصول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 134.26,
   "end": 136.6,
   "text": "چهل و هفت گانه تقریباً اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 136.6,
   "end": 138.72,
   "text": "می‌فرماید که عمل ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 138.72,
   "end": 142.36,
   "text": "صورت برزخی ما رو می‌سازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 142.36,
   "end": 146.2,
   "text": "و علوم و معارفی که اخذ می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 146.2,
   "end": 151.74,
   "text": "نفس برزخی‌مون رو. یعنی جسم ما به شکل اعمال ما در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 151.74,
   "end": 154.96,
   "text": "همون تناسخ حقیقی. چون تناسخ رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 154.96,
   "end": 157.32,
   "text": "خب می‌دونید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 157.32,
   "end": 162.32,
   "text": "متاسفانه حالا در شرق و غرب اینطوری مطرحه و حالا فلسفه فـ-- اونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 162.32,
   "end": 164.78,
   "text": "تو بعضی کتاب‌ها می‌نویسن که فلاسفه گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 164.78,
   "end": 168.6,
   "text": "فلاسفه نیستن اینا که. حالا این که مثل، مثلا دکتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 168.6,
   "end": 170.72,
   "text": "میگه دکترها گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 170.72,
   "end": 174.2,
   "text": "کدوم دکتر؟ مثلا دکتر به لحظه فرانسوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 174.2,
   "end": 176.5,
   "text": "همین طبیبه یا پزشک ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 176.5,
   "end": 179.1,
   "text": "خب کدوم دکتر؟ هر دکتری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 179.1,
   "end": 184.28,
   "text": "حالا هر فلس- هر کسی که چهار تا کلمه فلسفه خونده که فیلسوف نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 184.28,
   "end": 187.88,
   "text": "تو بعضی کتابا گفتن فلاسفه گفتن تناسخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 187.88,
   "end": 190.06,
   "text": "وجود دارد و قائل به تناسخ شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 190.06,
   "end": 196.94,
   "text": "اون تناسخی که فلاسفه اسلامی پذیرفتن اینه که ما الان داریم میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 196.94,
   "end": 200.12,
   "text": "که ما الان داریم مشغول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 200.12,
   "end": 202.76,
   "text": "ساختن بدن برزخی‌مون هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 202.76,
   "end": 206.1,
   "text": "با اعمالمون و نفس برزخی‌مون را هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 206.1,
   "end": 209.52,
   "text": "با علوم و معارفی که اخذ می‌کنیم داریم می‌سازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 209.52,
   "end": 212.12,
   "text": "بعد این روح ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 212.12,
   "end": 218.3,
   "text": "نفس ناطقه ما، جان ما هنگام مرگ اعلام انصراف از این بدن طبیعی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 218.3,
   "end": 220.28,
   "text": "این برمی‌گرده تو چرخه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 220.28,
   "end": 225.64,
   "text": "میره تو اون قبر فقهی. میره خاک و عاقبت خاک گل کوزه گران خواهیم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 225.64,
   "end": 227.7,
   "text": "بعد این جان کجا میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 227.7,
   "end": 230.8,
   "text": "به این میگن تناسخ حقیقی و اسلامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 230.8,
   "end": 235.4,
   "text": "میره توی اون کالبدی که خودت با اعمال ساختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 235.4,
   "end": 237.74,
   "text": "بهش میگن بدن برزخی. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 237.74,
   "end": 242.9,
   "text": "این تناسخ درسته. اون تناسخ شرقی غربی که الان میگن اون غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 242.9,
   "end": 248.6,
   "text": "مثلا ما قبول نداریم اونو. که ما روحمون بر- در بیاد بره تو بدن یه کس دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 248.6,
   "end": 252.46,
   "text": "مثلا توی یه حیوان حلول کنه مثلا توی یه درخت نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 252.46,
   "end": 255.6,
   "text": "اینا رو ما نمی‌پذیریم. در هر حال بحث چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 255.6,
   "end": 258.8,
   "text": "بحث این بود که هرچه هست خودمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 258.8,
   "end": 260.74,
   "text": "ما در حال ساختن خودمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 260.74,
   "end": 265.1,
   "text": "بذر رو در وجود خودمون می‌کاریم و خودمون هستیم که داریم می‌کاریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 265.1,
   "end": 267.7,
   "text": "و خودمون خودمون رو داریم می‌سازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 267.7,
   "end": 272.74,
   "text": "اتفاقاً حضرت امام علیه الرحمه در شرح دعای سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 272.74,
   "end": 275.16,
   "text": "اگه خواستید رجوع کنید، مبسوطش رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 275.16,
   "end": 278.26,
   "text": "صفحه هشتاد و یک و هشت- هشتاد و هشتاد و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 278.26,
   "end": 281.9,
   "text": "شرح دعای سحر امام رو برید ببینید خیلی زیبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 281.9,
   "end": 287.52,
   "text": "ذیل اون قسمت \"یا رحمان الدنيا والآخرة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 287.52,
   "end": 291.04,
   "text": "که یکی از شریف‌ترین ادعیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 291.04,
   "end": 294.5,
   "text": "بسیاری از بزرگان رو من دیدم سفارش به این ذکر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 294.5,
   "end": 298.42,
   "text": "\"یا رحمان الدنيا والآخرة ورحیمهما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 298.42,
   "end": 302.46,
   "text": "بعد حضرت امام من اجمالا عرض کنم ذیل این تیکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 302.46,
   "end": 308.24,
   "text": "میاد می‌فرماید که اینو شرح میده که رحمان دنیا و آخرت کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 308.24,
   "end": 310.5,
   "text": "کسی‌ست که هر کسی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 310.5,
   "end": 315.0,
   "text": "در درون وجود خودش میل به کمالش رو قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 315.0,
   "end": 317.54,
   "text": "تو دوست نداری به سمت کمال بری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 317.54,
   "end": 323.24,
   "text": "حتی آدمی هم که به سمت پول میره، شهوت میره، ثروت میره، قدرت میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 323.24,
   "end": 326.34,
   "text": "اینام گمانش اینه که اون مطلوبشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 326.34,
   "end": 329.46,
   "text": "یعنی باز فکر می‌کنن دارن به سمت کمال میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 329.46,
   "end": 332.1,
   "text": "این رو خدا در درون هر کسی قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 332.1,
   "end": 338.12,
   "text": "منتها خب یه سری در مصداق یعنی اکثرا در مصداق اون کمال به اشتباه میفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 338.12,
   "end": 342.2,
   "text": "بعد امام اونجا می‌فرماید فرقی نمی‌کنه همشون به سمت کمال میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 342.2,
   "end": 347.52,
   "text": "حتی اون که میره به سمت عقرب و مار و کژدم و عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 347.52,
   "end": 349.36,
   "text": "حالا اون آتش و دوزخ و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 349.36,
   "end": 352.28,
   "text": "اونم داره به سمت کمال مطلوب خودش اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 352.28,
   "end": 358.96,
   "text": "انتخاب کرده داره میره. اما میره به سمت اسماء قهریه و جلالیه حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 358.96,
   "end": 361.1,
   "text": "بازم داره میره به سمت حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 361.1,
   "end": 362.82,
   "text": "اما به اون سمت با اون اسماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 362.82,
   "end": 367.7,
   "text": "اونم به نوعی کماله. ولی نسبت به کسی که میره به سمت بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 367.7,
   "end": 369.78,
   "text": "رو حری هان و نعمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 369.78,
   "end": 373.78,
   "text": "نه، اون نه. اون ناقصه. اما کسی که میره به ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 373.78,
   "end": 378.2,
   "text": "پر از نور، این داره به سمت کمال حقیقی‌ش حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 378.2,
   "end": 383.06,
   "text": "اما در هر حال همه در درون خودشون به سمت کمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 383.06,
   "end": 386.04,
   "text": "سخ پیدا می‌کنه. یکی از درون داره اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 386.04,
   "end": 389.98,
   "text": "می‌کشونه به سمت-- میگه حرکت کن، حرکت کن که حالا اصطلاحا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 389.98,
   "end": 395.16,
   "text": "حکمت بهش میگن حرکت ایجادیه از نظام ملکوت که ملائکه اونو تشویق می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 395.16,
   "end": 400.94,
   "text": "پس غافل نشیم از اینکه خودمون با هیچکس هم دعوا و جر و بحثی ما نداریم آقا جان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 400.94,
   "end": 403.92,
   "text": "خودمون داریم خودمون رو یا بهشت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 403.92,
   "end": 405.64,
   "text": "یا جهنم. والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 405.64,
   "end": 407.72,
   "text": "علامه میگه از این غافل نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 407.72,
   "end": 413.66,
   "text": "یه عزیزی از دوستان بسیار خوب ما زحمتکشی که خیلی برای ما عزیزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 413.66,
   "end": 418.16,
   "text": "با اشک چشم گفتن مادرشون رفته همین ساعت تو کما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 418.16,
   "end": 424.06,
   "text": "و حالشون خیلی بده. لطف کنید برای استشفاء ایشون و همه مریض‌ها بخونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 424.06,
   "end": 431.48,
   "text": "یک حمد همراه صلوات بر محمد و آل محمد. الله، صلوة على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}