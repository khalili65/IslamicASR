 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ شصت‌ویک؛ آن که نفس را بسیط شناخت",
   "start": 14.64,
   "end": 119.08
  },
  {
   "index": 1,
   "title": "## تعریف بصائر جز به لوازم",
   "start": 119.08,
   "end": 256.54
  },
  {
   "index": 2,
   "title": "## معرفت شهودی؛ ارباب انواع و ملائکه",
   "start": 256.54,
   "end": 572.65
  },
  {
   "index": 3,
   "title": "## غذای نفس از سنخ مجردات",
   "start": 572.65,
   "end": 608.63
  },
  {
   "index": 4,
   "title": "## علم حضوری و شهودی",
   "start": 608.63,
   "end": 628.71
  },
  {
   "index": 5,
   "title": "## مثال روضه و گودال قتلگاه",
   "start": 628.71,
   "end": 965.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 5.02,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.02,
   "end": 8.14,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.14,
   "end": 11.62,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.62,
   "end": 14.64,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.64,
   "end": 19.04,
   "text": "کلمه شصت و یک از صد کلمه در معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.04,
   "end": 22.68,
   "text": "آن که نفس را بسیط شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.68,
   "end": 25.68,
   "text": "قبلا بحث کردیم دیگه. بسیط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.68,
   "end": 29.38,
   "text": "یعنی مجرد. یعنی مرکب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.38,
   "end": 33.04,
   "text": "الان ما در عالم عناصر هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.04,
   "end": 37.76,
   "text": "عالم مرکباته. هر چیزی ترکیبه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.76,
   "end": 41.6,
   "text": "زوج زوجه. خلق الازواج کلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.6,
   "end": 44.06,
   "text": "لذا عالم کنو فساده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.06,
   "end": 49.38,
   "text": "یعنی همه چی فاسد میشه. همه چی به هم می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.38,
   "end": 55.76,
   "text": "همینطور که میره جلو هی می‌بینی یه ماده‌ای که یه جا هست می‌بینی خراب میشه حتی یه جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.76,
   "end": 62.84,
   "text": "می‌بینی که یه مدت زیادی تردد نکردی توش میای می‌بینی یه غباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.84,
   "end": 66.48,
   "text": "از خاک روی اون مثلا محل رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.48,
   "end": 69.5,
   "text": "به این شکله. اصلا همه چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.5,
   "end": 72.56,
   "text": "به سمت خرابی میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.56,
   "end": 77.88,
   "text": "لِلموت یک معناش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.88,
   "end": 81.08,
   "text": "که این، این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.08,
   "end": 85.06,
   "text": "به اینجا توجه نکن. تو متولد شدی برای موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.06,
   "end": 87.96,
   "text": "اینجا به سمت عالم کنو فساده، خراب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.96,
   "end": 91.66,
   "text": "تو باید بری. به اون سمت برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.66,
   "end": 95.12,
   "text": "حالا اینجا می‌فرماید آن که نفس را بسیط شناخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.12,
   "end": 97.62,
   "text": "فهمید که نفسش مرکب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.62,
   "end": 101.74,
   "text": "یعنی خراب نمیشه نفس. مثل بدن نیست که متلاشی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.74,
   "end": 105.38,
   "text": "بدن خراب میشه، متلاشی میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.38,
   "end": 109.0,
   "text": "خسته میشه، خوابش می‌گیره، مریض میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.0,
   "end": 112.08,
   "text": "اما نفس اینطوری نیست که. نفس بسیطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.08,
   "end": 114.36,
   "text": "بسیطه، مرکب نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.36,
   "end": 118.34,
   "text": "مال عالم بالاست، مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.34,
   "end": 120.86,
   "text": "حالا می‌فرماید کسی که به این رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 120.86,
   "end": 123.82,
   "text": "می‌داند که تعريف البصائر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 123.82,
   "end": 127.46,
   "text": "لا یکون الا بلوازمها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 127.46,
   "end": 133.56,
   "text": "میدونه که نمیشه فهمید، تعریف نمیشه کرد بصائر رو، مجردات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 133.56,
   "end": 135.36,
   "text": "اون‌ها یه حالت کلی دارن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 135.36,
   "end": 139.12,
   "text": "ماده که نیستن. اون رو نمیشه فهمید، نمیشه تعریفش کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 139.12,
   "end": 143.64,
   "text": "مگر با لوازمش. با لوازمش باید اون رو بسنجیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 143.64,
   "end": 148.68,
   "text": "لذا معرفت فکری به بصائر را نشاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 148.68,
   "end": 151.28,
   "text": "نمیشه اونا چون بسیط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 151.28,
   "end": 155.92,
   "text": "اون‌ها از عالم، عالم ماده نیستن که حسشون کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 155.92,
   "end": 158.6,
   "text": "لمسشون کنی، بو کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 158.6,
   "end": 164.4,
   "text": "با چشم بصر و همین ظاهر ببینی، با این گوش ظاهر بشنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.4,
   "end": 167.74,
   "text": "اینطوری نیستن. چشیدنی با این قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 167.74,
   "end": 169.56,
   "text": "ذائقه ظاهریه نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 169.56,
   "end": 173.98,
   "text": "بصائتن. مال اونجان، مجرداتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 173.98,
   "end": 177.3,
   "text": "با این لوازم نمیشه اونا رو درک کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 177.3,
   "end": 182.9,
   "text": "لذا می‌فرماید با معرفت فکری هم نمیشه اون‌ها رو بشنا-- معرفت فکری مال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 182.9,
   "end": 185.48,
   "text": "همین معدات وجودی ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 185.48,
   "end": 188.74,
   "text": "همین حرکت نفس از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 188.74,
   "end": 191.2,
   "text": "معلوم به مجهول که بهش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 191.2,
   "end": 194.02,
   "text": "نفس، حرکت نفس یا فکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 194.02,
   "end": 196.72,
   "text": "بهش میگن حرکت نفس یا فکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 196.72,
   "end": 200.2,
   "text": "این هم باز با علم فکری صورت می‌گیره ابتدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 200.2,
   "end": 203.34,
   "text": "هنوز به مرحله حدس نرسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 203.34,
   "end": 207.94,
   "text": "حدس دفعتنه. به یکباره یه چیزی بهت القا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 207.94,
   "end": 211.12,
   "text": "این کارش تدریجیه. اصلا عالم، عالم تدریجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 211.12,
   "end": 214.98,
   "text": "عالم مادون یعنی ماده اینجا الان عالم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 214.98,
   "end": 222.56,
   "text": "تدریجه. همه چی به-- الان ببین چقدر گذشته تا به الان به این سن رسیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 222.56,
   "end": 226.18,
   "text": "موهات سفید شده، بدنت به این شکل دراومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 226.18,
   "end": 227.86,
   "text": "یه جنین بودی، یه نطفه بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 227.86,
   "end": 231.52,
   "text": "حالا این عالم، عالم چیه؟ تدریجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 231.52,
   "end": 234.52,
   "text": "میگه این رو نمیشه با معرفت فکری رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 234.52,
   "end": 237.94,
   "text": "کار فکری نیست که با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 237.94,
   "end": 240.14,
   "text": "اسباب قلم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 240.14,
   "end": 246.16,
   "text": "جوهر مرکب کتاب و صوت معلم و استاد بهش برسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.16,
   "end": 249.38,
   "text": "به اون حقایق مج-- این‌ها علت معده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 249.38,
   "end": 254.02,
   "text": "این‌ها شخ میزنن به وجودت و کمک می‌کنند که تو اون اتفاق بیفتد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 254.02,
   "end": 255.8,
   "text": "حالا اون رو راهش چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 255.8,
   "end": 259.3,
   "text": "اینجا می‌فرماید اما معرفت شهودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 259.3,
   "end": 262.86,
   "text": "که فوق معرفت فکری‌ست میسر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 262.86,
   "end": 265.92,
   "text": "میشه راه، می‌فرماید که راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 265.92,
   "end": 268.44,
   "text": "رسیدن و چشیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 268.44,
   "end": 273.62,
   "text": "اون، رسیدن به مجردات، به مفارقات، مرسلات، حالا ارواح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 273.62,
   "end": 276.48,
   "text": "رب، رب الانواع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 276.48,
   "end": 280.04,
   "text": "رب النوع که قبلا بحث کردیم، ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 280.04,
   "end": 284.36,
   "text": "که این‌ها پرورش‌دهنده مادون خودشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 284.36,
   "end": 286.78,
   "text": "یعنی الان بدن شما یه رب داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 286.78,
   "end": 288.8,
   "text": "یه پرورش‌دهنده داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 288.8,
   "end": 291.84,
   "text": "به یک معنا نفست. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 291.84,
   "end": 294.86,
   "text": "خود نفس هم رب داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 294.86,
   "end": 298.36,
   "text": "حالا بگید روح. خود روح رب داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 298.36,
   "end": 301.48,
   "text": "همینطوری سلسله مراتب این‌ها پرورش‌دهنده دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 301.48,
   "end": 304.38,
   "text": "الحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 304.38,
   "end": 308.04,
   "text": "بله، یه رب کلی و مطلقه داریم که پرورش‌دهنده همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 308.04,
   "end": 312.5,
   "text": "در طول اونم مثل الله يتوفى الأنفُس حين موتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 312.5,
   "end": 316.0,
   "text": "موقع موت الله توفی می‌کنه جانها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 316.0,
   "end": 320.16,
   "text": "پس قابض الارواح چه کاره‌ست؟ اونم یک نوع ربه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 320.16,
   "end": 323.76,
   "text": "منتها رب جزئیه. اون رب النوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 323.76,
   "end": 326.88,
   "text": "حالا اینجا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 326.88,
   "end": 329.68,
   "text": "با معرفت شهودی میشه به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 329.68,
   "end": 332.16,
   "text": "حقیقت مجردات رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 332.16,
   "end": 335.12,
   "text": "اونجا که پیغمبر عزیز عالم فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 335.12,
   "end": 338.7,
   "text": "اللهم ارنا الأشیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 338.7,
   "end": 342.56,
   "text": "كما هي. به من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 342.56,
   "end": 347.58,
   "text": "ارنا یا ارنی نشان بده، ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 347.58,
   "end": 349.34,
   "text": "توجه کردین؟ این فکری نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 349.34,
   "end": 353.84,
   "text": "شهودیه. دیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 353.84,
   "end": 356.22,
   "text": "ارنی. ارنا. به ما نشان بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 356.22,
   "end": 360.28,
   "text": "چی رو؟ الأشیا. اونجا فرمود و علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 360.28,
   "end": 363.34,
   "text": "آدم الأسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 363.34,
   "end": 368.04,
   "text": "كلها. حضرت تعالم فرمودن به جاش بذار الأشیا كلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 368.04,
   "end": 371.87,
   "text": "اینا ظهور اسم الله‌اند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 371.87,
   "end": 374.29,
   "text": "وهرت الموجودات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 374.29,
   "end": 376.33,
   "text": "عن بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 376.33,
   "end": 378.43,
   "text": "خب حالا اگه اینطوره پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 378.43,
   "end": 382.87,
   "text": "حالا ارى اللهم ارنی الاشیاء کما هى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 382.87,
   "end": 385.93,
   "text": "یعنی الاسماء کما. یعنی همه اسماء رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 385.93,
   "end": 390.73,
   "text": "به من نشون بده که ظهور حقیقت اسماء شده این اشیاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 390.73,
   "end": 393.43,
   "text": "درست شد؟ اینو میگه حقیقتشو به من نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 393.43,
   "end": 402.71,
   "text": "دقت بفرمایید چی میگم. نه این مرکبات ظاهریه‌ی جسم و ماده و بدن و زمین و آسمان و همین بدنه حضرت عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 402.71,
   "end": 407.57,
   "text": "این نه. اینکه تو عل-- با علم فکری تو علم طب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 407.57,
   "end": 411.29,
   "text": "تو علم تشریح داره چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 411.29,
   "end": 413.33,
   "text": "تشریح می‌کنه. این کلیه‌ست، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 413.33,
   "end": 415.39,
   "text": "معده‌ست، این دسته، این پایه، این چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 415.39,
   "end": 421.07,
   "text": "هر کدوم یه تخصصی دارن. متخصص می‌شه اینا رو تشریح می‌کنه، بررسی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 421.07,
   "end": 423.69,
   "text": "درست شد؟ اما نه، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 423.69,
   "end": 425.81,
   "text": "میگه حقیقت این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 425.81,
   "end": 429.31,
   "text": "حقیقت این انسان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 429.31,
   "end": 433.49,
   "text": "تو خودت فقط این نفس، فقط این بدن نیستی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 433.49,
   "end": 438.21,
   "text": "تو اگه فقط این بدن بودی، بله قصه فقط این نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 438.21,
   "end": 440.55,
   "text": "تو یه nefsi هم داری در باطن خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 440.55,
   "end": 442.95,
   "text": "یه باطنی داری اینطوری بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 442.95,
   "end": 446.11,
   "text": "حالا بگو روح. یه باطنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 446.11,
   "end": 448.91,
   "text": "دیدنی نیست با این چشم بصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 448.91,
   "end": 451.25,
   "text": "خب اون رو چجوری ما بفهمیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 451.25,
   "end": 455.87,
   "text": "همون باطن خودت رو اصن. حالا مجردات پیشکش، خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 455.87,
   "end": 460.49,
   "text": "باطن خودت که نفسته و اون هم مجرده چگونه بفهمیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 460.49,
   "end": 462.75,
   "text": "اصلاً نفس مجرد هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 462.75,
   "end": 465.51,
   "text": "ماده نیست که. خالی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 465.51,
   "end": 470.07,
   "text": "لوازم ماده‌ست، از خصوصیات ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 470.07,
   "end": 472.17,
   "text": "مثلاً البته من خواستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 472.17,
   "end": 473.79,
   "text": "براتون آماده کرده بودم بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 473.79,
   "end": 476.19,
   "text": "یه بخشی از رساله‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 476.19,
   "end": 479.05,
   "text": "خیلی شیرین کلید بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 479.05,
   "end": 482.83,
   "text": "مرحوم قاضی سعید قمی رو، این حکیم بزرگوار در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 482.83,
   "end": 485.67,
   "text": "فصل سیزدهم در شناخت نفس و لوازمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 485.67,
   "end": 487.93,
   "text": "خیلی دلایل شیرینی میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 487.93,
   "end": 490.29,
   "text": "اثبات می‌کنه که نفس مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 490.29,
   "end": 495.65,
   "text": "اونجا یه دلیلش رو اینطوری میاره. میگه اگر نفس مادی بود این نفس باطن من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 495.65,
   "end": 499.61,
   "text": "اگه مادی بود، یه آدمی که نفسش خیلی قویه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 499.61,
   "end": 502.73,
   "text": "خیلی بزرگه، عقل کله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 502.73,
   "end": 507.15,
   "text": "خب این کجا جا بشه؟ شما میگی آقا کلی آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 507.15,
   "end": 509.97,
   "text": "خب یه دریا جا می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 509.97,
   "end": 511.71,
   "text": "نه؟ یه استخر جا می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 511.71,
   "end": 514.61,
   "text": "کلی آبه. آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 514.61,
   "end": 517.65,
   "text": "خصوصیت مادی‌شو در نظر بگیری خاصیت ماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 517.65,
   "end": 524.83,
   "text": "یه آتشه. این یه جای، یه مکانی می‌خواد که هر چقدر شدتش بیشتره مکانش هم بزرگ‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 524.83,
   "end": 530.77,
   "text": "قبول دارید دیگه؟ حضرت ابراهیم رو خواستن تو آتش بندازن چرا با منجنیق انداختن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 530.77,
   "end": 533.63,
   "text": "آتش به شدت فوران داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 533.63,
   "end": 537.39,
   "text": "خب این یعنی جای بزرگی هم اشغال کرده که انقدر آتش فوران داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 537.39,
   "end": 539.43,
   "text": "چرا؟ چون خصوصیات مادی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 539.43,
   "end": 544.71,
   "text": "حالا در انسان چگونه است؟ مثلا حضرت امام خمینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 544.71,
   "end": 549.27,
   "text": "اگر قرار بود نفسش مجرد نباشه، علیه الرحمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 549.27,
   "end": 553.17,
   "text": "ایشون باید بدنش اندازه کره زمینی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 553.17,
   "end": 555.75,
   "text": "عقلش چه عقلی بود. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 555.75,
   "end": 561.01,
   "text": "این یه راه. حالا اون عرض کردم خواستم از رساله بخونم دیگه نمی‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 561.01,
   "end": 564.51,
   "text": "اذیتتون نمی‌کنم. از حوصله شما خارجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 564.51,
   "end": 566.71,
   "text": "برید ببینید خیلی شیرینه این بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 566.71,
   "end": 572.65,
   "text": "این که الان مرحوم قاضی سعید آورده آدم ثابت میشه براش که بله نفس مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 572.65,
   "end": 577.77,
   "text": "حالا نفس که بخواد غذا بگیره همینطور که بدن شما غذا می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 577.77,
   "end": 579.91,
   "text": "بدن شما غذا می‌گیره، غذای مادی می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 579.91,
   "end": 582.85,
   "text": "نفست غذاش چیه؟ همین مادیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 582.85,
   "end": 585.95,
   "text": "نه به طبع خودش مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 585.95,
   "end": 589.05,
   "text": "غذا و مقتضی باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 589.05,
   "end": 592.81,
   "text": "مناسب هم باشن. از یک سنخ باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 592.81,
   "end": 595.83,
   "text": "مجانس هم باشن. از یک جنس باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 595.83,
   "end": 599.97,
   "text": "حالا غذای نفس شما می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 599.97,
   "end": 603.53,
   "text": "می‌شه مجردات. چقدر ارتباط با مجردات داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 603.53,
   "end": 606.89,
   "text": "یعنی با روح عالم، با ارواح، با ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 606.89,
   "end": 614.07,
   "text": "چجوری بگیم؟ چقدر ارتباط داری؟ اگر ارتباط داری به همون میزانی که از ملکوت بهره داری، چاق و چله‌ست نفست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 614.07,
   "end": 615.99,
   "text": "می‌خواید حقیقت باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 615.99,
   "end": 618.77,
   "text": "قیامت صغری خودتو بفهمی الان چقدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 618.77,
   "end": 623.11,
   "text": "یه قیامت صغری‌ای رخ بده. حالا قیامت پیشکش، قیامت کبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 623.11,
   "end": 624.97,
   "text": "آقا الان نفس من اندازه‌ش چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 624.97,
   "end": 629.61,
   "text": "بزرگی من چقدره؟ چرا میگن که بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 629.61,
   "end": 632.53,
   "text": "شهدا وقتی تلألؤ نوریشون اونور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 632.53,
   "end": 635.25,
   "text": "اتفاق میفته عالم رو می‌گیره نورشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 635.25,
   "end": 637.83,
   "text": "این یعنی چی عالم رو می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 637.83,
   "end": 641.41,
   "text": "منظور عالم مادی نیست که. خیلی تجلی‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 641.41,
   "end": 648.27,
   "text": "زیاده. من و شما نفسمون چاق و چله‌ست یا لاغر و ضعیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 648.27,
   "end": 650.99,
   "text": "ببین چقدر غذا می‌گیره. غذای نفس چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 650.99,
   "end": 655.39,
   "text": "مجرداته. این الان حرفی که من دارم می‌زنم، این جوهری که رو خا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 655.39,
   "end": 657.43,
   "text": "کاغذ نوشته من از روش دارم می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 657.43,
   "end": 659.49,
   "text": "اینا که مجرد نیست، اینا ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 659.49,
   "end": 662.49,
   "text": "این نیست. حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 662.49,
   "end": 665.79,
   "text": "باطن این چیزاست که اون غذای نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 665.79,
   "end": 669.97,
   "text": "چقدر ارتباط با عالم ارواح و ملائکه داریم ما، با ملکوت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 669.97,
   "end": 673.63,
   "text": "اون غذای ماست. چه بهره‌ای از نماز داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 673.63,
   "end": 675.95,
   "text": "چه اثری نماز در نفس من داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 675.95,
   "end": 680.29,
   "text": "یعنی نفس من از این نمازی که الان خونده-- خوندم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 680.29,
   "end": 682.75,
   "text": "قرائت کردم، اقامه‌اش بماند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 682.75,
   "end": 684.99,
   "text": "چقدر خورد؟ چقدرشو خورد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 684.99,
   "end": 688.05,
   "text": "غذای نفسم شد اصن این نماز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 688.05,
   "end": 690.75,
   "text": "اگه غذای نفسم شده نفسم قوی شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 690.75,
   "end": 693.29,
   "text": "چاق و چله شده. دیگه در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 693.29,
   "end": 696.75,
   "text": "محرمات ابا می‌کنه، صورت برمی‌گردونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 696.75,
   "end": 700.27,
   "text": "اما نه اگه نفس لاغره و اصن غذایی از این نماز نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 700.27,
   "end": 702.95,
   "text": "حالا من کلمه رو تموم کنم وقت شما رو هم نگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 702.95,
   "end": 706.11,
   "text": "اگه بخوایم اینطوری صحبت کنیم باید تا صبح بشینیم، تا فردا صبح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 706.11,
   "end": 710.39,
   "text": "اما معرفت شهودی که فوق معرفت فکریست میسر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 710.39,
   "end": 713.79,
   "text": "میسر است آقا جان. و الا پیغمبر نمی‌فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 713.79,
   "end": 716.13,
   "text": "اللهم ارنا الاشیاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 716.13,
   "end": 719.01,
   "text": "کما هى. باطن اشیاء رو به من به چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 719.01,
   "end": 723.13,
   "text": "برسون. نشون بده. یکی از اشیاء خود ما هستیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 723.13,
   "end": 725.35,
   "text": "و اینطوری تموم می‌کنه حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 725.35,
   "end": 728.59,
   "text": "چنانکه در حکمت متعالیه محقق است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 728.59,
   "end": 732.15,
   "text": "که حقیقت الوجود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 732.15,
   "end": 736.7,
   "text": "حقیقت وجود چیه؟ اون مجرد کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 736.7,
   "end": 741.38,
   "text": "حقیقت وجود \"هِيَ عَيْنُ الْهُوِيَّةِ الشَّخْصِيَّةِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 741.38,
   "end": 749.8,
   "text": "لا يُمْكِنُ تَصَوُّرُهَا\" نمیشه تصورش کرد \"وَ لا يُمْكِنُ الْعِلْمَ بِهَا\" نمیشه بهش علم پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 749.8,
   "end": 752.42,
   "text": "\"إلا\" اصلاً هیچ راهی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 752.42,
   "end": 754.98,
   "text": "یه \"إلا\" داره. now گوش بده و برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 754.98,
   "end": 758.68,
   "text": "\"إلا بنحو الشهود الحضوري\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 758.68,
   "end": 762.38,
   "text": "با علم حضوری میشه. علم حضوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 762.38,
   "end": 764.42,
   "text": "الان شما میری محضر امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 764.42,
   "end": 768.04,
   "text": "حضرت رو زیارت می‌کنی. حضور ظاهر عند المظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 768.04,
   "end": 771.46,
   "text": "محضر امام. امام رضا ملقب به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 771.46,
   "end": 775.82,
   "text": "عالم آل محمد صلی الله علیه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 775.82,
   "end": 780.48,
   "text": ". خب یکی میره محضر آقا رو حقیقتا درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 780.48,
   "end": 784.54,
   "text": "چند تا کتاب باید بنویسه از اون درکی که از حضرت کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 784.54,
   "end": 787.86,
   "text": "چند تا کتاب میشه نوشت؟ شاید هزار تا کتابم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 787.86,
   "end": 792.16,
   "text": "کم باشه برای یک درک یک قضای روحی و نفسی که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 792.16,
   "end": 796.86,
   "text": "حقیقت امام رضا دریافت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 796.86,
   "end": 800.18,
   "text": "این میشه معرفت حضوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 800.18,
   "end": 805.24,
   "text": "شهودی. حضرت رو در سقع نفسش در باطنش مشاهده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 805.24,
   "end": 806.9,
   "text": "یه مثال بزنم و ختم کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 806.9,
   "end": 809.58,
   "text": "چگونه‌ست که من و شما کربلا نبودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 809.58,
   "end": 814.64,
   "text": "اما وقتی یک روضه‌خون شروع می‌کنه صحنه گود قتلگاه رو برای ما باز می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 814.64,
   "end": 818.34,
   "text": "اصلاً انگار همونجا بغل سید الشهدا وایسادی و داری می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 818.34,
   "end": 821.12,
   "text": "یه حادثه نبوده تموم شه بره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 821.12,
   "end": 823.74,
   "text": "درست شد؟ در متن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 823.74,
   "end": 827.68,
   "text": "تاریخ جریان داره. یعنی همین الان من کنار سید الشهداام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 827.68,
   "end": 832.14,
   "text": "همین الان آقا داره میگه اَلْـمُـنْصُرِ یَنْصُرِ و الان من باید چیکار بکنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 832.14,
   "end": 833.84,
   "text": "این حقیقت حضوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 833.84,
   "end": 837.98,
   "text": "این چشیدنه. علم حضوری دارم زور میزنم یه ذره بفهمم خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 837.98,
   "end": 839.94,
   "text": "علم حضوری یعنی چی؟ یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 839.94,
   "end": 845.34,
   "text": "یعنی در محضر سید الشهدا در کربلا حاضر باش و کربلا رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 845.34,
   "end": 852.5,
   "text": "و الا علم فکری که برو دویست تا کتاب مفتاح الی بخون از اول تا آخرش چه به دردت می‌خوره اگه هیچ علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 852.5,
   "end": 855.64,
   "text": "بهره‌ای از حیث شهود نداشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 855.64,
   "end": 859.08,
   "text": "اصل رو شهوده است. حالا فصل الخطاب تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 859.08,
   "end": 861.38,
   "text": "إنا لله وإنا إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 861.38,
   "end": 865.6,
   "text": "بفرمایید. ناگهان بانگ برآمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 865.6,
   "end": 869.82,
   "text": "خواجه مرد. خب بفرما ببینم بهره-- تموم شد دیگه عالم ماده تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 869.82,
   "end": 874.08,
   "text": "بفرمایید در عالم بالا که باطن عالم مجرداته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 874.08,
   "end": 877.18,
   "text": "ارواح اونجا هستن. عالم دیگه مجرداته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 877.18,
   "end": 879.84,
   "text": "بفرمایید ببینم شما بد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 879.84,
   "end": 883.36,
   "text": "فارغ از بدن، این بدنی که میذاری همینجا میری دیگه تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 883.36,
   "end": 886.7,
   "text": "رفت تو چرخه طبیعت. چی با خودت می‌بری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 886.7,
   "end": 891.74,
   "text": "قضاهای نفس تو. چه بهره‌ای از حضور در عالم داشتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 891.74,
   "end": 894.84,
   "text": "بفرمایید. که حضور رو همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 894.84,
   "end": 896.8,
   "text": "وحدت گرفتن عرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 896.8,
   "end": 900.3,
   "text": "گفتن حضور یعنی وحدت. چقدر به وحدت رسیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 900.3,
   "end": 902.7,
   "text": "چقدر به باطن عالم ارتباط پیدا کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 902.7,
   "end": 904.7,
   "text": "چند بار مردی؟ مرد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 904.7,
   "end": 907.72,
   "text": "مردن یعنی سفر از ظاهر به باطن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 907.72,
   "end": 909.56,
   "text": "چند بار مردی؟ اون بهره‌ته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 909.56,
   "end": 913.24,
   "text": "تو اندازت همونه. چاق و چله‌ای یا لاغریت بر اساس اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 913.24,
   "end": 915.88,
   "text": "چه بهره‌ای از باطن عالم بردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 915.88,
   "end": 919.12,
   "text": "پرونده عملت همونه. اصلاً شما خودت همونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 919.12,
   "end": 921.64,
   "text": "کتابی که قراره بخونی خودتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 921.64,
   "end": 924.0,
   "text": "چاق و چله‌ای یا لاغری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 924.0,
   "end": 929.84,
   "text": "چی ساختی از خودت؟ از ارتباطت با باطن این عالم، این چرخه ماده که تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 929.84,
   "end": 935.38,
   "text": "ببخشید دومی علیه اللعنه رو هم بغل پیغمبر عزیز عالم دفن کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 935.38,
   "end": 938.38,
   "text": "هر دو یه قبر دارن. هر دو یه بدن داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 938.38,
   "end": 940.52,
   "text": "توی قبر تموم شده رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 940.52,
   "end": 942.26,
   "text": "خب حالا تموم شد رفت دیگه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 942.26,
   "end": 948.88,
   "text": "این دیگه تموم شد. حالا اون ور، اون ور ببین بهره این دو چقدر از عالم ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 948.88,
   "end": 951.2,
   "text": "این، این اصل کار اینه که برای ما می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 951.2,
   "end": 956.28,
   "text": "اینجا داره اینو زور میزنه علم ما متوجه کنه که اصل اون علم شهودیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 956.28,
   "end": 960.9,
   "text": "نه فکری. ان‌شاءالله عاقبتمون ختم بخیر باشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 960.9,
   "end": 963.36,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 963.36,
   "end": 965.78,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}