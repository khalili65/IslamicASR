 "chapters": [
  {
   "index": 0,
   "title": "## وظیفهٔ خواص در شناساندن فرد اصلح",
   "start": 3.28,
   "end": 116.72
  },
  {
   "index": 1,
   "title": "## شهادت موسی بن جعفر و اتاق شخصی امام",
   "start": 116.72,
   "end": 143.06
  },
  {
   "index": 2,
   "title": "## شمشیر: نماد انتظار جهاد",
   "start": 143.06,
   "end": 163.32
  },
  {
   "index": 3,
   "title": "## لباس خشن: نماد زهد",
   "start": 163.32,
   "end": 336.6
  },
  {
   "index": 4,
   "title": "سومین چیز در اتاق شخصی حضرت، قرآن است. قرآن همه چیز در آن است. ابن مسعود، صحابی پیامبر، از دستورات پیامبر نقل کرده است:",
   "start": 336.6,
   "end": 363.39
  },
  {
   "index": 5,
   "title": "## کلمهٔ پنجاه‌وسه: نصاب استکمال",
   "start": 363.39,
   "end": 549.11
  },
  {
   "index": 6,
   "title": "## استکمال ما و تکمیل عالم بالا",
   "start": 549.11,
   "end": 569.53
  },
  {
   "index": 7,
   "title": "## عمل مشخص بدن برزخی؛ علم مشخص نفس برزخی",
   "start": 569.53,
   "end": 606.37
  },
  {
   "index": 8,
   "title": "## موت ارادی کمال جوهر حی ناطق",
   "start": 606.37,
   "end": 806.89
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.28,
   "end": 6.9,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.9,
   "end": 10.88,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.88,
   "end": 16.16,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.16,
   "end": 21.74,
   "text": "استفتایی شده از رهبر عزیزمون در خصوص انتخابات که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.74,
   "end": 27.5,
   "text": "سؤال اینه وظیفه روحانیون و خواص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.5,
   "end": 32.88,
   "text": "در قبال شناساندن فرد اصلح چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.88,
   "end": 37.54,
   "text": "یعنی نظر بنده را بخواهید این جماعت در این مرکز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.54,
   "end": 41.24,
   "text": "باید زبده سازمان باشن از هر لحاظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.24,
   "end": 47.7,
   "text": "عصاره و چکیده فضائل سازمان اینجا باید جمع باشه، باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.7,
   "end": 56.0,
   "text": "یعنی شما همه خواصید. حالا آیا از لحاظ شرعی تکلیفی بر عهده آنها می باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 56.0,
   "end": 57.9,
   "text": "بر عهده خواص که چیکار کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.9,
   "end": 62.02,
   "text": "فرد اصلح رو شناسایی بدن به مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 62.02,
   "end": 65.46,
   "text": "رهبر فرمودن که همگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.46,
   "end": 70.02,
   "text": "به ویژه خواص و علما یعنی همه وظیفه دارن اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 70.02,
   "end": 73.56,
   "text": "علما و خواص و اینا وظیفه شون ویژه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.56,
   "end": 80.3,
   "text": "به ویژه خواص و علما وظیفه دارن با حداکثر دقت، نباید بی‌دقتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.3,
   "end": 84.12,
   "text": "افراد اصلح را با حجت شرعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.12,
   "end": 88.1,
   "text": "شناسایی کرده و به مردم معرفی کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.1,
   "end": 91.52,
   "text": "و مردم را در انتخاب درست یاری دهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.52,
   "end": 94.9,
   "text": "عدم دخالت خطرناک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.9,
   "end": 98.9,
   "text": "کسی بگه آقا به من چه هرکی بره خودش انتخاب کنه، خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.9,
   "end": 102.78,
   "text": "پیدا کنه. میگن حضرت فرمودین خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.78,
   "end": 105.9,
   "text": "البته باز تاکید دارن که دخالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.9,
   "end": 109.62,
   "text": "بدون بصیرت و حجت هم خطرناک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.62,
   "end": 113.08,
   "text": "اگه کسی حجت نداره، بصیرت هم نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.08,
   "end": 116.72,
   "text": "بیاد دخالت کنه اینم خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.72,
   "end": 121.82,
   "text": "تسلیت عرض می‌کنم به نوبه خودمون این روز پر از حزن و اندوه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.82,
   "end": 126.98,
   "text": "روز شهادت عجیب و غریب جد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.98,
   "end": 130.98,
   "text": "آقا امام زمان حضرت موسى بن جعفر علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.98,
   "end": 135.02,
   "text": "در فرمایشات رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.02,
   "end": 141.12,
   "text": "یه جمله خیلی پرمعنایی دارن در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.12,
   "end": 145.24,
   "text": "اتاق شخصی آقا موسى بن جعفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.24,
   "end": 148.8,
   "text": "الان مثلا ما تو اتاق شخصیمون چیا داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.8,
   "end": 155.7,
   "text": "چه چیزایی داریم؟ تو اتاق شخصی حضرت موسى بن جعفر چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.7,
   "end": 159.24,
   "text": "چه چیزایی بوده؟ رهبر فرمودن سه چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.24,
   "end": 164.74,
   "text": "سه تا چیز تو اتاق شخصی مال خود حضرت موسى بن جعفر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.74,
   "end": 169.6,
   "text": "یک، شمشیر که نماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.6,
   "end": 171.92,
   "text": "انتظاره برای جهاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.92,
   "end": 176.32,
   "text": "چون اون زمان که جهاد به اون معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.32,
   "end": 178.88,
   "text": "چیز که نبود که جهاد ابتدایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.88,
   "end": 183.92,
   "text": "همشون دستور صبر داشتن از باباشون امیرالمؤمنین بگیر تا...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.92,
   "end": 188.28,
   "text": "این انتظار برای چیه؟ جهاد در رکاب امام عصر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.28,
   "end": 191.9,
   "text": "بعد ما، ما منتظر نباشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.9,
   "end": 194.42,
   "text": "همونطور که امام صادق صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.42,
   "end": 197.34,
   "text": "فرمودن که \"لو أدرکته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.34,
   "end": 200.02,
   "text": "اگه من \"في أيام عمري\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.02,
   "end": 203.4,
   "text": "اگه من درک می‌کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.4,
   "end": 207.92,
   "text": "او رو یعنی امام عصر رو، امام زمان ما رو \"لخدمته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.92,
   "end": 210.38,
   "text": "قطعاً خادمش می‌شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.38,
   "end": 213.1,
   "text": "الله اکبر. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.1,
   "end": 219.54,
   "text": "شمشیر که در اتاق حضرت بوده نماد انتظار برای جهاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.54,
   "end": 224.36,
   "text": "یعنی ما صبح و شبمون باید این حالتو داشته باشیم، حالت انتظار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.36,
   "end": 227.08,
   "text": "حالت تجافي دیدی بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.08,
   "end": 230.66,
   "text": "نشستن و پا شدن. می‌شینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.66,
   "end": 233.28,
   "text": "به این حالت باشی، منتظر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.28,
   "end": 236.9,
   "text": "دو، فرمودن لباس خشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.9,
   "end": 239.54,
   "text": "لباس خشن نماد چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.54,
   "end": 243.42,
   "text": "حالا این تحلیلش رو، توضیحش رو رهبر نمی‌فرمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.42,
   "end": 245.5,
   "text": "رهبر تو-- همون سه تا رو میگن میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.5,
   "end": 249.3,
   "text": "بنده دارم برای شما عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.3,
   "end": 252.2,
   "text": "نماد زهد در دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.2,
   "end": 255.1,
   "text": "یعنی بی‌رغبتی به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.1,
   "end": 262.4,
   "text": "لباس خشن مثل اینکه امام صادق صلوات الله علیه لباس خیلی گلبلبل و خوشگل و اینا تنش بود ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.4,
   "end": 266.2,
   "text": "به قول امروز ما شیک و مجلسی و خوش تیپ کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.2,
   "end": 268.98,
   "text": "بعد یکی تیکه انداخت به حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.98,
   "end": 274.04,
   "text": "حضرت اینطوری لب پیراهن و این یقه ش رو به قول ما آورد پایین، اون زیر رو نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.04,
   "end": 278.12,
   "text": "مثل گونی شکل خشن. لباس زیریش خشن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.12,
   "end": 281.78,
   "text": "به قول ما نامرغوب بود. حضرت فرمود این رویه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.78,
   "end": 287.22,
   "text": "برای امثال شماها پوشیدم اون، اون زیریه رو برای خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.22,
   "end": 290.08,
   "text": "که دلم به دنیا خوش نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.08,
   "end": 292.26,
   "text": "اون خش-خشونت‌ش به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.26,
   "end": 298.76,
   "text": "خودم اصابت کنه. واقعاً ما بی‌رغبت هستیم به دنیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.76,
   "end": 303.28,
   "text": "این رغبت به دنیا که حب الدنيا رأس كل خطیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.28,
   "end": 307.22,
   "text": "حالا چون من خودم گرفتارم اجازه بدید ادامه ندم اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 307.22,
   "end": 310.14,
   "text": "و سومین چیزی که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.14,
   "end": 312.16,
   "text": "در ک-- اتاق شخصی حضرت بوده قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.16,
   "end": 316.28,
   "text": "به به! به به، به قرآن .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 316.28,
   "end": 321.94,
   "text": "قرآن که همه چی درشه. به قول ابن مسعود اون صحابی پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.94,
   "end": 325.4,
   "text": "، از دستورات پیغمبر این رو فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 325.4,
   "end": 330.6,
   "text": "یعنی زیربنای این فرمایشش دستورات پیغمبر که \"من أراد علم الأولين والآخرين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 330.6,
   "end": 335.86,
   "text": "فليصور القرآن\". هر کس علم اول و آخر را اراده کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.86,
   "end": 338.3,
   "text": "شخ بزنه، زیر و رو کنه آیات قرآن رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.3,
   "end": 341.64,
   "text": "که مال بعضیا فقط برائت ظاهری می‌کنیم رد میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.64,
   "end": 344.34,
   "text": "زیر و رو کردن به ما неприتلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 344.34,
   "end": 350.82,
   "text": "این کلمه پنجاه و سه رو هم عرض کنم و که از درس و بحث اونجا نمونده باشیم روزهای سه شنبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 350.82,
   "end": 352.88,
   "text": "آن که گوهر نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.88,
   "end": 358.82,
   "text": "ناطقه‌اش، حالا هر کدوم این کلمات توضیح داره اجازه بدید رد شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 358.82,
   "end": 362.97,
   "text": "شما ب saidتون حوصله‌ش بعید میدونم ندارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 362.97,
   "end": 370.85,
   "text": "آن که گوهر نفس ناطقه‌اش به نصاب استکمال و ترقی خود رسید، نصاب یعنی حد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.85,
   "end": 375.63,
   "text": "اندازه. مثلا اینکه نصاب طلا، نصاب شتر، مثلا در زکات میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 375.63,
   "end": 378.49,
   "text": "یعنی به یه حدی رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 378.49,
   "end": 387.09,
   "text": "آن که گوهر نفس ناطقه‌اش به نصاب استکمال و ترقی خود رسید یعنی به اونجا که باید می‌رسید رسیده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.09,
   "end": 392.61,
   "text": "همان‌طور که اجداف را با ث سه نقطه، اجداف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.61,
   "end": 395.69,
   "text": "جمع جد، س جدست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 395.69,
   "end": 399.57,
   "text": "یعنی قبر، گور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.57,
   "end": 403.65,
   "text": "همان‌طور که اجداث را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 403.65,
   "end": 406.69,
   "text": "قبور اجساد می‌بیند؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 406.69,
   "end": 410.69,
   "text": "یعنی اون گورستانو، اون قبرستانو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 410.69,
   "end": 412.71,
   "text": "محل دفن این جسدها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 412.71,
   "end": 418.33,
   "text": "می‌بینه. همونطور که این رو محل دفن جسدها می‌بینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 418.33,
   "end": 420.97,
   "text": "اجساد را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 420.97,
   "end": 424.29,
   "text": "که ما گفتیم ما بدن داریم پشت بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.29,
   "end": 427.77,
   "text": "این بدن الان بدن ظاهری که دفن می‌شه بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 427.77,
   "end": 431.25,
   "text": "بدن برزخی که باش تو خواب اینور اونوریم بدن مثالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 431.25,
   "end": 434.61,
   "text": "بدن برزخی بعد بغل بدن‌ها داریم تو در طول هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 434.61,
   "end": 437.51,
   "text": "تفاوتشون هم به نقص و کمالشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.51,
   "end": 441.15,
   "text": "منظور از این اجساد دوم اون بدن‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.15,
   "end": 445.91,
   "text": "اون بدن‌های برزخی و عقلی و همینطور بروید تا بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.91,
   "end": 449.47,
   "text": "اجساد را نیز اجداف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.47,
   "end": 452.13,
   "text": "نفوس می‌یابد. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.13,
   "end": 455.07,
   "text": "یعنی اینکه اون بدن برزخیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 455.07,
   "end": 457.37,
   "text": "می‌شه قبر نفسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.37,
   "end": 463.35,
   "text": "این فشار قبر، این تنگی و ظلمت قبر، این تنهایی قبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 463.35,
   "end": 466.07,
   "text": "که فرمود پیغمبر که هر روز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.07,
   "end": 469.07,
   "text": "هر روز قبر صدا می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.07,
   "end": 471.69,
   "text": "زمین، زمین منظور اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.69,
   "end": 475.27,
   "text": "زمین وجود خودته. خاک قضیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.27,
   "end": 479.81,
   "text": "اینم حقه البته که این زمین هم چون بدن ما می‌شه بدن ظاهری‌مون اینجا دفن می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 479.81,
   "end": 483.67,
   "text": "اما اصل اون قبری که منظور نظر روایاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 483.67,
   "end": 486.33,
   "text": "که فشار قبر بر اون مترتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 486.33,
   "end": 488.31,
   "text": "تنگی و ظلمت بر اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 488.31,
   "end": 491.93,
   "text": "اون له می‌کنه به عبارتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.93,
   "end": 495.87,
   "text": "ذیق یا صع مال اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.87,
   "end": 498.31,
   "text": "حفرة من حفر نيران اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 498.31,
   "end": 500.23,
   "text": "روضة من رياض الجنة اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 500.23,
   "end": 503.67,
   "text": "اون بدن برزخیه. اون اجساد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.67,
   "end": 506.71,
   "text": "در طول این بدن ظاهری اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 506.71,
   "end": 512.35,
   "text": "اون می‌شه قبر. دیدی گاهی اوقات فشار، بدنت سالم سالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.35,
   "end": 516.71,
   "text": "لپت هم گل انداخته، لباس شیک، یهو یه خبر ناگوار بهت می‌رسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.71,
   "end": 523.95,
   "text": "رنگت می‌پره، اصلا حالت بد می‌شه، چنان تحت فشار قرار می‌گیری میگی برید، برید حوصله ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 523.95,
   "end": 527.75,
   "text": "تحت فشار عجیب. گاهی اوقات خواب هستی، خوابیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 527.75,
   "end": 532.49,
   "text": "چنان فشار بهت میدن انگار لهت که اصلا یه تریلی میاد از رو رد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.49,
   "end": 534.89,
   "text": "یه تانک از رو رد می‌شه تو خواب می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 534.89,
   "end": 539.59,
   "text": "چه احساسی داری؟ چه ترس و رعب و وحشت و ذیق و فشاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 539.59,
   "end": 542.19,
   "text": "در صورتی که بدنت سالم سالم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 542.19,
   "end": 546.11,
   "text": "این به کجا فشار اومد؟ اون، اون بدن برزخی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.11,
   "end": 548.77,
   "text": "اون فشار مترتب بر اون می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 548.77,
   "end": 551.95,
   "text": "حضرت علامه اینجا می‌فرماید که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 551.95,
   "end": 555.55,
   "text": "نفس ناطقه‌شو به اون حد و نصاب استکمال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 555.55,
   "end": 559.15,
   "text": "استکمال یعنی سیری که ما طلب کمال می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.15,
   "end": 562.79,
   "text": "بعد از عالم بالا که حرکت ایجادی می‌کنند؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 562.79,
   "end": 566.57,
   "text": "یعنی ارواح، عقول، مفارقات، مرسلات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 566.57,
   "end": 569.53,
   "text": "ملائکه حالا. اون‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.53,
   "end": 572.01,
   "text": "اون‌ها حرکت ایجادی دارن بر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 572.01,
   "end": 575.17,
   "text": "اون‌ها ما رو به تک-- می‌خوان ما تکمیل بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 575.17,
   "end": 577.57,
   "text": "اون‌ها حرکت‌شون تکمیلیه، ما استکمالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 577.57,
   "end": 580.81,
   "text": "ما طلب کمال می‌کنیم، اون‌ها افاضه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 580.81,
   "end": 585.31,
   "text": "اون‌ها به ما کمال رو می‌رسونند. میگه اگر کسی به اینجا رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.31,
   "end": 591.93,
   "text": "به این حد رسید که سیر استکمالیش به یه حد خوبی حالا اصطلاحا رسید، ترقی کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 591.93,
   "end": 595.83,
   "text": "این بدن برزخی و اون ابدان بقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 595.83,
   "end": 601.93,
   "text": "که همین‌طور تو طول هم هستن اون‌ها رو قبر اصلی نفس خودش می‌بینه و مراقب می‌مون--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 601.93,
   "end": 605.99,
   "text": "می‌شه که اون‌ها رو درست، قبرش رو درست کن، چراغ برای قبرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 605.99,
   "end": 608.25,
   "text": "بساز، چنان‌که به فکر قبرت باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 608.25,
   "end": 611.63,
   "text": "یعنی اون بدن‌ها رو تو الان داری می‌سازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 611.63,
   "end": 613.83,
   "text": "الان داری بهشت می‌سازی یا جهنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 613.83,
   "end": 617.69,
   "text": "همین الان داری می‌سازی. اون بدن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 617.69,
   "end": 623.71,
   "text": "قبلاً عرض کردیم بر اساس اصل یکی از اصول کتاب شریف انسان در عرفان حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 623.71,
   "end": 627.21,
   "text": "از اون چهل و هفت کنه اصول یکیش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 627.21,
   "end": 630.23,
   "text": "فرمودن که عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 630.23,
   "end": 636.67,
   "text": "مشخص بدن برزخی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 636.67,
   "end": 640.03,
   "text": "علم مشخص چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 640.03,
   "end": 647.69,
   "text": "نفس برزخی ما. یعنی باطن ما رو، باور‌هامون شکل می‌ده باطن بعد از مرگ‌مون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 647.69,
   "end": 653.41,
   "text": "ظاهرمون یعنی بدن برزخیمون که قبر نفسمون قرار بشه رو چی داره می‌سازه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 653.41,
   "end": 657.09,
   "text": "عملمون. یعنی ما با اعمالمون داریم قبرمون رو شکل می‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 657.09,
   "end": 659.97,
   "text": "اگه عملمون بهشتیه قبر بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 659.97,
   "end": 663.05,
   "text": "اگه عمل جهنمیه قبر جهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 663.05,
   "end": 666.33,
   "text": "بعد البته ادامه داره دیگه تا به همین قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 666.33,
   "end": 670.07,
   "text": "من توضیح هم اون بسنده کنم فقط برای اینکه کلمه کامل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 670.07,
   "end": 672.53,
   "text": "\"و ما انت\" اشاره می‌کنه ایشون به این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 672.53,
   "end": 675.73,
   "text": "\"و ما انت بمسمع من فی القبور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 675.73,
   "end": 679.07,
   "text": "انتهای آیه بیست و دو fatr این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 679.07,
   "end": 682.43,
   "text": "خدا به پیغمبر می‌فرماید که تو نمی‌تونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 682.43,
   "end": 684.99,
   "text": "اینایی که تو گورستان فرو رفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 684.99,
   "end": 688.67,
   "text": "هرگز شنوایی بهشون که اینا بشنون، بفهمن تو چی میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 688.67,
   "end": 693.03,
   "text": "نمی‌فهمن آقا ولشون کن. منظور اینایی که تو گروس‌ گورستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 693.03,
   "end": 696.39,
   "text": "اون ابدان برزخیشون دفن شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 696.39,
   "end": 700.87,
   "text": "یعنی یه بدن‌هایی برای خودشون درست کردن بعد از اینکه اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 700.87,
   "end": 704.27,
   "text": "دیگه اونجا جهنمه دیگه. اصلا این آقا جهنم شده ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 704.27,
   "end": 706.37,
   "text": "این حرف حق تو گوشش نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 706.37,
   "end": 713.79,
   "text": "منظور اینه. چنان که موت ارادی را کمال جوهر حیه ناطق، عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 713.79,
   "end": 717.77,
   "text": "اوه کمال جوهر حیه ناطق، جوهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 717.77,
   "end": 720.49,
   "text": "حیه نا این وجود تو، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 720.49,
   "end": 724.85,
   "text": "ک-- وجود تو، نفس ناطقه تو که قراره به کمال برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 724.85,
   "end": 728.49,
   "text": "که حیه، حیات داره و ناطقه، نطق داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 728.49,
   "end": 730.55,
   "text": "این کمالش کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 730.55,
   "end": 734.83,
   "text": "میگه موت ارادی. بفرما بمیر ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 734.83,
   "end": 738.91,
   "text": "آقا این حرف‌ها چیه؟ کمالی نداری که نمی‌تونی بمیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 738.91,
   "end": 742.81,
   "text": "موت قبلاً تموت. این موت رو نداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 742.81,
   "end": 748.25,
   "text": "و موت طبیعی اونی که ما منتظرشیم، اون که بحث‌های چهارشنبه ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 748.25,
   "end": 751.43,
   "text": "کتاب الموت مرحوم مجلسی، اون موت طبیعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 751.43,
   "end": 753.51,
   "text": "اون رو حضرت علامه می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 753.51,
   "end": 756.97,
   "text": "و موت طبیعی را متمم این کمال می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 756.97,
   "end": 759.59,
   "text": "\"من مات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 759.59,
   "end": 763.01,
   "text": "فقط قامت قيامته\". هرکی مرد قیامتش به پا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 763.01,
   "end": 766.11,
   "text": "این قیامت صغراست. این موت منظور اون موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 766.11,
   "end": 769.97,
   "text": "طبیعی است که ما همون رو فقط موت می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 769.97,
   "end": 774.29,
   "text": "میگه این موت طبیعی که منتظرشیم متمم اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 774.29,
   "end": 775.97,
   "text": "اون تازه متمم می‌زنی به این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 775.97,
   "end": 779.15,
   "text": "تو هنوز این رو انجام ندادی که بری سراغ اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 779.15,
   "end": 781.71,
   "text": "ذیل مقدمه رو نداری. میگه که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 781.71,
   "end": 789.13,
   "text": "الان خودتو به موت ارادی برسون که حالا این موت ارادی رو قبلاً ما چندین بار درباره‌ش حرف زدیم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 789.13,
   "end": 791.11,
   "text": "انشاالله که عاقبت به ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 791.11,
   "end": 794.41,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 794.41,
   "end": 806.89,
   "text": "اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}