 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ بیست‌ونهم؛ ظاهر و باطنِ فعل",
   "start": 10.0,
   "end": 31.22
  },
  {
   "index": 1,
   "title": "## اتحادِ وجودی با علم و عمل",
   "start": 31.22,
   "end": 172.12
  },
  {
   "index": 2,
   "title": "## چرا اسلام این‌همه به علم و عمل سفارش کرده است",
   "start": 172.12,
   "end": 310.74
  },
  {
   "index": 3,
   "title": "## دو گوهرِ انسان‌ساز؛ از هزار و یک نکته",
   "start": 310.74,
   "end": 358.92
  },
  {
   "index": 4,
   "title": "## فصل‌الخطاب؛ انسان‌تر کیست",
   "start": 358.92,
   "end": 417.84
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 2.78,
   "text": "رحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.78,
   "end": 10.0,
   "text": "السلام علیک یا داعی الله و ربانی ایاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.0,
   "end": 18.0,
   "text": "کلمه بیست و نه. آن که در کسب علم و حرفه و صنعت خود تأمل کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.0,
   "end": 22.48,
   "text": "درمی یابد که فعل او را ظاهری و باطنی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.48,
   "end": 28.84,
   "text": "ظاهر او که بشر است با زمان متصرم است و ناپایدار؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.84,
   "end": 34.94,
   "text": "ظاهرش. و باطن او که لب است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.94,
   "end": 40.3,
   "text": "ملکه او گردد و متحقق و برقراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.3,
   "end": 48.92,
   "text": "و بدین ملکه ملک و سلطان و اقتدار بر تصرف در ماده و اعمال اعمال خود کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 48.92,
   "end": 54.46,
   "text": "پس آنگاه آگاه شود که علم و عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 54.46,
   "end": 57.16,
   "text": "جوهره و انسان سازند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 57.16,
   "end": 63.64,
   "text": "ما گمان می‌کنیم که یک وجودی هستیم جدای از علوم‌مون، جدای از اعمال‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 63.64,
   "end": 66.18,
   "text": "در حالی که این اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 66.18,
   "end": 73.42,
   "text": "حضرت علامه علیه الرحمه دارن القا می‌کنند البته بنا به آیات و روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 73.42,
   "end": 80.26,
   "text": "این اصل رو در ما القا می‌کنند که ما همونی هستیم که عمل می‌کنیم و علم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 80.26,
   "end": 86.06,
   "text": "علم-- علم اخذ می‌کنیم یعنی جدایی از علم و عمل‌مون نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 86.06,
   "end": 90.5,
   "text": "لذا در آیه بیست و نه سوره رعد هم صراحتا خدا می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 90.5,
   "end": 94.04,
   "text": "\"الذین آمنوا وعملوا الصالحات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 94.04,
   "end": 97.06,
   "text": "عمل که خب عمل صالحات مشخصه بحث عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 97.06,
   "end": 99.94,
   "text": "آمنوا هم ایمان آوردن یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 99.94,
   "end": 102.24,
   "text": "بحث قلبه، دل دادگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 102.24,
   "end": 105.68,
   "text": "یعنی همون علوم و معارفه، باورهاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 105.68,
   "end": 111.64,
   "text": "اعتقادهاست. اگر این دو تا با هم جمع شد \"طوبى لهم وحسن مآب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 111.64,
   "end": 116.3,
   "text": "طوبى لهم. حالا ظاهرا این طوبى لهم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 116.3,
   "end": 120.88,
   "text": "آیات مثلا قرآن شما ت-توجه کنین زده مثلا خوشا بحالشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 120.88,
   "end": 126.9,
   "text": "در صورتی که طوبى لهم این یه تأویلش برمی‌گرده به خانه امیرالمؤمنین در بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 126.9,
   "end": 130.4,
   "text": "یه درختی درشه که فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 130.4,
   "end": 133.38,
   "text": "در هر خانه‌ای از اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 133.38,
   "end": 135.94,
   "text": "در بهشت یه شاخه از این درخت رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.94,
   "end": 143.2,
   "text": "منظور همون ولایت کلیه الهیه است که جاری شده، ساری شده در همه رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 143.2,
   "end": 146.34,
   "text": "محبت مولا، ولایت مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 146.34,
   "end": 151.1,
   "text": "که می‌فرماید یه همچین لطفی بهش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 151.1,
   "end": 153.7,
   "text": "یعنی اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 153.7,
   "end": 160.7,
   "text": "حواسش جمع باشه نسبت به علم و عملش چون اتحاد وجودی برقرار می‌کنه با این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 160.7,
   "end": 166.58,
   "text": "اگر علم و عملش در مسیر رضایت حضرت حق بود، این رسیده به، به ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 166.58,
   "end": 171.62,
   "text": "می‌رسه به ولایت. متصل می‌شه به شجره طیبه ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 171.62,
   "end": 176.44,
   "text": "و علت اینم که در اسلام این همه به علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 176.44,
   "end": 179.84,
   "text": "و عمل توصیه شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 179.84,
   "end": 187.18,
   "text": "آقا جون علم چقدر ارزش داره، عمل کردن چقدر ارزش داره به جهت همین اتحاد وجودی برقرار شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 187.18,
   "end": 190.74,
   "text": "که حضرت علامه می‌فرماید که این جو عرض نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 190.74,
   "end": 193.8,
   "text": "علم عرض نیست، عمل عرض نیست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 193.8,
   "end": 199.1,
   "text": "بلکه اتحاد برقرار می‌کنی با او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 199.1,
   "end": 201.72,
   "text": "و در حقیقت ذاتی تو می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 201.72,
   "end": 206.08,
   "text": "یه روایتی از آقامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 206.08,
   "end": 208.9,
   "text": "حضرت علی ابن موس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.9,
   "end": 211.58,
   "text": "موسی الرضا صلوات الله علیه و آله هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 211.58,
   "end": 217.24,
   "text": "خیلی شیرین. \"محادثة العالم على المزابل\" مزابل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 217.24,
   "end": 220.14,
   "text": "یعنی مزبله. جایی که مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.14,
   "end": 222.66,
   "text": "آشغال می‌ریزن، خاک رو به می‌ریزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 222.66,
   "end": 225.6,
   "text": "فرمود \"محادثة العالم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 225.6,
   "end": 230.0,
   "text": "یعنی گفت‌وگوی با عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 230.0,
   "end": 232.3,
   "text": "حتی اگر در مزبله باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 232.3,
   "end": 237.8,
   "text": "عجب! \"خير من محادثة الجاهل على الزرابي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 237.8,
   "end": 244.8,
   "text": "بهتره از گفت‌وگوی با یه آدم نادون جاهل ولو رو جای مثلا زربفت و تشک و این‌ها باشه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 244.8,
   "end": 250.66,
   "text": "جاهای خیلی خوب. میگه شده حتی تو مزبله با عالم بشین گفت‌وگو کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 250.66,
   "end": 254.4,
   "text": "اون خیلی بهتره تا با جاهل جای خیلی خوبی باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 254.4,
   "end": 260.98,
   "text": "تا مثلا از حضرت عیسی علیه النبي و آله و عليه الصلاة والسلام پرسیدن آقا ما با کی رفت و آمد کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 260.98,
   "end": 265.18,
   "text": "همه از ما بپرسن آقا شما با کی رفت و آمد می‌کنین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 265.18,
   "end": 270.1,
   "text": "ملاکت کیه؟ با حضرت عیسی قربونش بریم اون موقع ملاک رو دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 270.1,
   "end": 274.48,
   "text": "فرمودن کسی که نگاش می‌کنی یاد خدا بیفتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 274.48,
   "end": 283.12,
   "text": "سخنش بر دانش تو بیفزاید، علمتو زیاد کنه و کردارش تو رو یاد آخرت بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 283.12,
   "end": 284.9,
   "text": "اصلا چیزی جز این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 284.9,
   "end": 291.04,
   "text": "یا اونجایی که امام صادق صلوات الله علیه فرمود \"إذا أراد الله بعبد خيرا فقهه في الدين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 291.04,
   "end": 294.66,
   "text": "هرکس که خدا اراده خیر درباره‌ش کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 294.66,
   "end": 296.98,
   "text": "فهم عمیق دینی بهش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 296.98,
   "end": 303.16,
   "text": "چرا؟ به جهت اینکه انسان اتحاد وجودی برقرار می‌کنه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 303.16,
   "end": 304.72,
   "text": "علومش، با عملش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 304.72,
   "end": 309.44,
   "text": "اتفاقا اجازه بدید از رو براتون بخونم یک جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 309.44,
   "end": 313.4,
   "text": "چند جمله شیرین از حضرت علامه رو در هزار و یک-- تو پیراهن همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 313.4,
   "end": 318.16,
   "text": "کتاب شریف هزار و یک نکته علامه رو بگیرید بخونید بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 318.16,
   "end": 325.18,
   "text": "می‌فرمود به بیان واضح‌تر گویم علم و عمل عرض نیستند بلکه دو گوهر انسان سازند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 325.18,
   "end": 331.74,
   "text": "چنانکه در علم، علم ادب هر دو از یک باب و از یک ماده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 331.74,
   "end": 338.5,
   "text": "نفس انسانی به پذیرفتن علم و عمل توسع و اشتداد وجودی می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 338.5,
   "end": 341.62,
   "text": "اشتداد یعنی شدت وجودی پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 341.62,
   "end": 345.62,
   "text": "شدید می‌شه. وجود میاد رو وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 345.62,
   "end": 347.54,
   "text": "و گوهر نورانی می‌گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 347.54,
   "end": 351.46,
   "text": "هر نیکبختی که بهره او از آن‌ها بیشتر است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 351.46,
   "end": 356.42,
   "text": "به حسب وجود انسان‌تر است و وزن انسانی او فزون‌تر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 356.42,
   "end": 358.92,
   "text": "والسلام. اینجا داره چی رو می‌فرماید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 358.92,
   "end": 361.14,
   "text": "فصل‌الخطاب علامه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 361.14,
   "end": 363.1,
   "text": "چه انسانی انسان‌تره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 363.1,
   "end": 365.26,
   "text": "کدوم انسان شریف‌تره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 365.26,
   "end": 368.32,
   "text": "وزن کدوم انسان سنگین‌تره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 368.32,
   "end": 370.66,
   "text": "وزین‌تره؟ کدوم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 370.66,
   "end": 373.24,
   "text": "اینجا علامه فرمودن کد رو دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 373.24,
   "end": 378.4,
   "text": "فرمودن هر نیکبختی که بهره او از آن‌ها بیشتر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 378.4,
   "end": 380.56,
   "text": "آن‌ها چی بودند؟ علم و عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 380.56,
   "end": 384.06,
   "text": "تمام شد. هرکس که علم و عملش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 384.06,
   "end": 386.16,
   "text": "بهتر و بیشتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 386.16,
   "end": 389.96,
   "text": "انسان‌تر-- انسان‌ها رو از اینجا می‌شه شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 389.96,
   "end": 394.64,
   "text": "نه از پول و منصب و مدرک و اینجور چیزا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 394.64,
   "end": 398.76,
   "text": "چون انسان اتحاد وجودی برقرار می‌کنه با علم و عملش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 398.76,
   "end": 402.54,
   "text": "پس باید خیلی مراقب علم و عمل خودمون باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 402.54,
   "end": 405.56,
   "text": "هر اتفاقی هم می‌افته خودمون با خودمون می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 405.56,
   "end": 407.96,
   "text": "بهشتی می‌شیم خودمون خودمون رو بهشتی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 407.96,
   "end": 414.18,
   "text": "جهنمی هم می‌شیم خودمون. انشاالله که عاقبتمون ختم به خیر باشه به برکت صلوات بر محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 414.18,
   "end": 417.84,
   "text": "و آل محمد. الله- الله الله على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}