 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ سی‌وچهار؛ اعتلای نفس از قوه به فعل",
   "start": 12.28,
   "end": 107.26
  },
  {
   "index": 1,
   "title": "## توقف در بدیهیات؛ حرکت از مجهول به معلوم",
   "start": 107.26,
   "end": 211.34
  },
  {
   "index": 2,
   "title": "## تسخیر آسمان و زمین برای انسان",
   "start": 211.34,
   "end": 239.84
  },
  {
   "index": 3,
   "title": "## مثال جنین و شیر؛ سیر جسمی و عقلی",
   "start": 239.84,
   "end": 428.68
  },
  {
   "index": 4,
   "title": "## صلوات و رحمت خاص؛ غفران یا علوم یقینی",
   "start": 428.68,
   "end": 744.54
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 4.08,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.08,
   "end": 7.92,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.92,
   "end": 12.28,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.28,
   "end": 15.66,
   "text": "کلمه سی و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.66,
   "end": 20.7,
   "text": "آنکه در اعتلاى نفس از قوه به فعل بیندیشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.7,
   "end": 23.4,
   "text": "که اون قوای وجودیش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.4,
   "end": 26.42,
   "text": "استعداداتش رو شکوفا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.42,
   "end": 33.18,
   "text": "که هرچه داناتر می‌شود برای اخذ معارف قوی‌تر آماده‌تر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.18,
   "end": 40.34,
   "text": "هرچی که داناییش بیشتر می‌شه آماده می‌شه برای گرفتن معارف قوی‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.34,
   "end": 46.64,
   "text": "پی می‌برد که کسی که این کار رو کرد، پی می‌برد که نفس را رتبت فوق تجرد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.64,
   "end": 50.16,
   "text": "همون بحثی که داشتیم فوق تجرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.16,
   "end": 53.94,
   "text": "یعنی علاوه بر مجرد بودنش حد یقف نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.94,
   "end": 58.04,
   "text": "اصلاً انتها نداره. یک لحظه اگر ایستا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.04,
   "end": 65.0,
   "text": "باشه و بایسته گرفتار شده و اون مریضی بولیموس اومده سراغش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.0,
   "end": 68.34,
   "text": "و به سر اثر گرامیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.34,
   "end": 74.2,
   "text": "\"یا ملا تزیده کثرة العطا الا جود و کرم\" آگاه می‌گردد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.2,
   "end": 77.86,
   "text": "که یکی از اسماء خدا در جوشن کبیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.86,
   "end": 82.12,
   "text": "که \"یا ملا تزیده کثرة العطا\" ای کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.12,
   "end": 89.12,
   "text": "زیاد نمی‌کند از زیادی بخشیدنش، کثرت بخشیدنش \"الا جود و کرم\" مگر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.12,
   "end": 90.92,
   "text": "باز چیکار می‌کنه؟ می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.92,
   "end": 94.94,
   "text": "\"جود و کرم\" اهل کرم و بخشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.94,
   "end": 97.6,
   "text": "دیگه به این می‌رسه، به سر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.6,
   "end": 101.82,
   "text": "ذکر. از چی؟ از اینکه هرچی میره جلوتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.82,
   "end": 107.26,
   "text": "می‌بینه که آمادگیش برای اخذ حقایق عرشی و فوق عرشی بیشتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.26,
   "end": 112.66,
   "text": "آدم وقتی توقف می‌کنه در اون ابتداییات و بدیهیات و اولیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.66,
   "end": 116.14,
   "text": "چیزهای متعارف و این‌هایی که بین مردم هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.14,
   "end": 120.86,
   "text": "دو دو تا چهار تا خب. این که معلومه این که ابتدایی‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.86,
   "end": 124.38,
   "text": "مسائل علمیه. همین جا که توقف می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.38,
   "end": 127.4,
   "text": "دیگه نفسش به اون قوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.4,
   "end": 129.54,
   "text": "نمی‌رسه. باید حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.54,
   "end": 132.98,
   "text": "حرکت نفس از مجهول به معلوم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.98,
   "end": 138.18,
   "text": "که حالا آیاتی هم بر این زمینه داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.18,
   "end": 140.84,
   "text": "خدای ممنون همه چی رو برا ما خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.84,
   "end": 142.76,
   "text": "یعنی چه همه چی رو برا ما خلق کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.76,
   "end": 146.46,
   "text": "یعنی همه کثرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.46,
   "end": 151.68,
   "text": "اعم از این آسمان و زمین و اینا همه می‌تونن معلوم نفس ناطقه ما باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.68,
   "end": 154.1,
   "text": "یعنی ما علم به اون‌ها پیدا کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.1,
   "end": 156.0,
   "text": "معرفت به اون‌ها پیدا کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.0,
   "end": 158.34,
   "text": "یعنی ما احاطه به اون‌ها پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.34,
   "end": 168.02,
   "text": "یعنی از اون عقل هیولایی که اول داشتیم، اون نفس هیولایی که ابتدایی‌ترین حالت نفس ناطقه ما بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.02,
   "end": 170.98,
   "text": "بیاییم بریم به عقل بالملکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.98,
   "end": 175.06,
   "text": "به، به عقل بالفعال بریم همینطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.06,
   "end": 177.38,
   "text": "تعالی و بریم بالا، بالا تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.38,
   "end": 182.8,
   "text": "دیگه بزرگان رفتن اهل بد و رفتن به عقل بالمصطفى یا عقل بسيط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.8,
   "end": 184.7,
   "text": "که همه علم اونجاست رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.7,
   "end": 187.94,
   "text": "خب چرا ما نرسیم؟ چرا ما پشت سر اونا حرکت نکنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.94,
   "end": 191.64,
   "text": "مگر او کسی که فرمود \"سَلُونِي قَبْلَ أَنْ تَفْقَدُونِي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.64,
   "end": 198.46,
   "text": "از من بپرسید قبل اینکه منو از دست بدید از آس-- راه‌های آسمان از من بپرسید مگه امام ما نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.46,
   "end": 200.96,
   "text": "مگه پیشوای ما نیست؟ پس ما می‌تونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.96,
   "end": 206.56,
   "text": "چرا نتونیم؟ اگه اون امام ماست می‌تونیم پشت سر اونا حرکت کنیم به تأسی اونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.56,
   "end": 209.98,
   "text": "منتها ضعیف، متأسفانه خودمون رو ضعیف و نحیف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.98,
   "end": 215.06,
   "text": "نگه داشتیم. در حالی که قرآن آیه دوازده سوره نحل رو براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.06,
   "end": 217.38,
   "text": "\"سخر لکم الليل والنهار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.38,
   "end": 220.2,
   "text": "سخر چی؟ لکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.2,
   "end": 222.14,
   "text": "برای شما تسخیر کرده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.14,
   "end": 226.56,
   "text": "مسخر کرده چی رو؟ \"الليل والنهار والشمس والقمر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.56,
   "end": 229.08,
   "text": "همینطوری برو هرچی خلق کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.08,
   "end": 231.84,
   "text": "مسخر دست شماست. اصلاً برای شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.84,
   "end": 239.84,
   "text": "آیه سیزده جاسیه \"وسخر لكم ما في السماوات وما في الأرض جميعا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.84,
   "end": 241.72,
   "text": "اصلاً همه چی برا شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.72,
   "end": 243.86,
   "text": "اینا همه می‌تونن معلوم وجود تو بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.86,
   "end": 247.44,
   "text": "معلوم-- تو بهش علم پیدا کنی، احاطه وجودی پیدا کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.44,
   "end": 250.38,
   "text": "بشه معلوم وجودی تو، بشه شأنی از وجود تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.38,
   "end": 258.3,
   "text": "همه این عوالم هستی. می‌شه انسان بزرگ‌تر از زمین و آسمان‌ها بشه، اون بشه معلوم تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.3,
   "end": 261.84,
   "text": "قرآن داره میگه دیگه. از خودم که نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.84,
   "end": 269.5,
   "text": "چطور می‌شه که انسان هی میره جلوتر بزرگ می‌شه، هی صعه وجودی پیدا می‌کنه، آماده‌تر می‌شه برای اون ق-- حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.5,
   "end": 276.26,
   "text": "عرشی‌تر؟ به جهت اینکه خب هی غذا، غذا می‌خوره هی قوی می‌شه دیگه روحش همینطوریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.26,
   "end": 278.68,
   "text": "و در حقیقت هی رشد می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.68,
   "end": 284.04,
   "text": "و اصلاً ببین مثالی که حضرت استاد علامه علیه الرحمه دارن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.04,
   "end": 287.64,
   "text": "جلسه صد و هفته شرح فصوصشون دارید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.64,
   "end": 290.14,
   "text": "اونجا می‌فرمایند که مثال می‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.14,
   "end": 292.58,
   "text": "میگن وقتی بچه در رحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.58,
   "end": 298.16,
   "text": "از اون خون حیض و حالا بند ناف مادر اینها خون می‌خوره، غذاش اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.16,
   "end": 302.64,
   "text": "درسته؟ غذا اون خونه. الان تو بریزین جلوت می‌خوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.64,
   "end": 305.58,
   "text": "حالت به هم می‌خوره ولی اون موقع غذات بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.58,
   "end": 310.0,
   "text": "ولی وقتی به دنیا میای بهترین یعنی غذای نسبت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.0,
   "end": 314.14,
   "text": "غذا نسبت به مقتضیه دیگه متناسب با مقتضیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.14,
   "end": 316.38,
   "text": "شما الان که به دنیا اومدی چی می‌خوای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.38,
   "end": 321.2,
   "text": "دو تا مشک به قول علامه دو تا مشک خدا قرار داده در سینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.2,
   "end": 326.82,
   "text": "مادر به بهترین وجه ممکن غذای تو رو آماده کرده خدا از قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.82,
   "end": 331.14,
   "text": "چی شد غذا اگه اون غذا رو تو رحم مادر به بچه می‌دادی می‌مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.14,
   "end": 332.82,
   "text": "حالا اومد قوی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.82,
   "end": 335.54,
   "text": "این حالا این تازه سیر جسمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.54,
   "end": 339.42,
   "text": "بعد، بعد از دو سالگی دیگه اون شیره باز براش ضرر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.42,
   "end": 344.94,
   "text": "دیگه دوباره غذاهای بهتر از اون هی بزرگ می‌شه، بزرگ می‌شه، دندون پیدا می‌کنه، معدش قوی می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.94,
   "end": 348.52,
   "text": "هی غذاهای کامل‌تر، بهتر، مقوی‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.52,
   "end": 356.54,
   "text": "این تازه سیر جسمیشه. علامه می‌فرماید حتی اشاره می‌کنه به کتاب شریف اسرار الحکم ملا هادی سبزواری علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.54,
   "end": 361.06,
   "text": "که اونجا ملا هادی می‌فرماید در سیر روحی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.06,
   "end": 363.76,
   "text": "ج-- عرض شود علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.76,
   "end": 366.78,
   "text": "و نفسانی‌ام بلکه عین همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 366.78,
   "end": 372.24,
   "text": "اونم چط-- چگونه‌ست که بچه در رحم خون میخوره بعد شیر میخوره بعد برنج و گوشت میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.24,
   "end": 377.3,
   "text": "در سیر عقلی و سیر و سلوک و این‌ها کارهای عقلی هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.3,
   "end": 382.8,
   "text": "از همین بدیهیات، همین ابتداییات، اولیات که فطریات ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.8,
   "end": 388.3,
   "text": "که رأس المال ماست. شروع می‌کنی هی قوی‌تر میشی رأس المال‌ت بیشتر میشه مثل کسی که اِ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.3,
   "end": 391.58,
   "text": "دارایی‌ش بیشتره، دارایی‌ش بیشتره، سرمایه‌ش بیشتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.58,
   "end": 395.74,
   "text": "لذا سودش بیشتره. هی میره جلو صعده وجودی پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.74,
   "end": 400.72,
   "text": "اینطوری نیست که حالا ما مسائل عقلی و عرشی و مثلاً سنگین و تا بیایم بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 400.72,
   "end": 403.16,
   "text": "همون ابتدا آدم بفهمه باید زحمت بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.16,
   "end": 405.68,
   "text": "\"ليس للإنسان إلا ما سعي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.68,
   "end": 408.62,
   "text": "خودشو ول کرده نه مطالعه‌ای داره، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.62,
   "end": 411.68,
   "text": "حال و حوصله‌ی کار عقلی و تفکر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.68,
   "end": 414.26,
   "text": "فشار آوردن به وجود خودش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 414.26,
   "end": 416.34,
   "text": "سلول‌های خاکستری‌شو به-- نمی‌جنبونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 416.34,
   "end": 419.68,
   "text": "بعد تا می‌شینه این حرفا رو می‌زنه می‌گه این حرفا به چه درد ما می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.68,
   "end": 422.52,
   "text": "اینا سنگینه. خب تو خودت حرکت نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.52,
   "end": 427.28,
   "text": "\"اقرأ وارتق تعال\". بیا بالا ببین چقدر غذاها برای ما آماده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.28,
   "end": 429.96,
   "text": "ما کوبیدیم تو سر خودمون. متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.96,
   "end": 435.26,
   "text": "رحمت خدا هم که بخواد شامل حال ما بشه باید غفران خدا شامل حال ما بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.26,
   "end": 439.32,
   "text": "می‌دونید چی دارم عرض می‌کنم؟ یعنی خدا می‌خواد به ما رحم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.32,
   "end": 443.64,
   "text": "خب به یکی خدا رحم می‌کنه، می‌رسونش به مرحله عقل بسیط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.64,
   "end": 445.86,
   "text": "احاطه پیدا می‌کنه بر علوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 445.86,
   "end": 450.24,
   "text": "یکی هم خدا بهش رحم می‌کنه مثل من رحمت خدا شامل حال میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 450.24,
   "end": 454.66,
   "text": "گناهمون می‌بخشه. اتفاقاً این یه اصلیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.66,
   "end": 458.96,
   "text": "چند بار من این اصلو هم خوندم هم از شرح علامه گوش دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.96,
   "end": 463.48,
   "text": "خیلی برام شیرین بود. بذارید اصلاً از رو براتون بخونم این انتهای بحث خیلی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 463.48,
   "end": 471.8,
   "text": "تو اون آیه شریفه \"إن الله الله إن الله وملائكته يصلون دائماً صلاة سأل النبي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.8,
   "end": 475.44,
   "text": "يا أيها الذين آمنوا\" شما هم صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.44,
   "end": 477.52,
   "text": "این صلوات وقتی از سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.52,
   "end": 481.64,
   "text": "خداست \"يصلون إن الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 481.64,
   "end": 484.56,
   "text": "صلوات خدا رحمتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.56,
   "end": 486.88,
   "text": "رحمت خاص و ویژشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 486.88,
   "end": 492.6,
   "text": "رحمت عام نیست. مثل این هوا نیست که کافر و مؤمن ازش استفاده می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.6,
   "end": 495.78,
   "text": "خاصه مثل علمه، مثل اندیشه‌ست حالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.78,
   "end": 499.14,
   "text": "رحمت خاص. رحیمیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 499.14,
   "end": 501.52,
   "text": "صلوات ملائکه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.52,
   "end": 504.1,
   "text": "دو-- صلوات ملائکه استغفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.1,
   "end": 507.04,
   "text": "صلوات انسان‌ها، شما هم صلوات بفرستید برای پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.04,
   "end": 514.78,
   "text": "اون چیه؟ دعاست. خب حالا بعد اینجا علامه قیسری میاد اینجا این جمله، این دو جملات رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 514.78,
   "end": 518.28,
   "text": "اینو بگم خوب توجه کنید و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 518.28,
   "end": 521.68,
   "text": "ی-- می‌فرماید \"قيل الصلاة من الله الرحمة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.68,
   "end": 526.68,
   "text": "همونطور که گفت این صلا-صلوات \"من الله الرحمة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.68,
   "end": 530.14,
   "text": "صلوات خدا بخواد شامل حال هرکی بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 530.14,
   "end": 534.14,
   "text": "مثلاً ما حدیث داریم تو یه بار صلوات به پیغمبر بفرستی، خدا در میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 534.14,
   "end": 538.92,
   "text": "افواجی از ملائکه به تو صلوات می‌فرسته، بلکه هفتاد برابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 538.92,
   "end": 541.94,
   "text": "این صلوات خدا که به ما می‌رسه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 541.94,
   "end": 543.96,
   "text": "اینجا علامه قیسری داره شرحش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 543.96,
   "end": 551.18,
   "text": "می‌فرماید \"يتعلق بكل شيء بحسب استعداد ذلك الشيء بطلب إياها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.18,
   "end": 557.98,
   "text": "یعنی هر چقدر طلب وجودی توئه، وجود تو، اون نفس ناطقه تو طلبش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.98,
   "end": 561.66,
   "text": "اون عین ثابت تو چی می‌خواد از خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 561.66,
   "end": 566.52,
   "text": "طلب تو چیه از خدا؟ منشرح کنی، باز کنی وجود هرکسیو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 566.52,
   "end": 570.76,
   "text": "هرکی یه زبان حالی داره. زبان حال تو از خدا چی می‌خواد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 570.76,
   "end": 577.08,
   "text": "همون رحمت خدا رو وقتی به تو نازل میشه نسبت به زبان حال تو ازش بهره می‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.08,
   "end": 581.0,
   "text": "حالا بعد بازش می‌کنه. می‌فرماید \"من حضرة الله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 581.0,
   "end": 584.68,
   "text": "فالرحمة\". اول هم می‌زنه به گناهکارا مثل من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 584.68,
   "end": 590.94,
   "text": "\"falرحمة على العاصين المذنبين الغفران والعفو عنهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 590.94,
   "end": 593.86,
   "text": "رحمت خدا، همون رحمت خاص خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 593.86,
   "end": 597.72,
   "text": "وقتی بیاد بزنه به گنهکار، عفو خدا، غفران خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 597.72,
   "end": 600.36,
   "text": "چیکار کنه بدبخت مثل من گناه کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 600.36,
   "end": 603.86,
   "text": "باید عفو خدا شه. رحمت خاصو اینطوری دریافت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 603.86,
   "end": 607.04,
   "text": "یعنی خودش رو پیدا نکرده می‌زنه داغون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 607.04,
   "end": 613.16,
   "text": "متأسفانه. \"ثم ما يبتني على المغفرة من الجنة وغيرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 613.16,
   "end": 615.28,
   "text": "على المطيعين الصالحين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 615.28,
   "end": 617.68,
   "text": "آدمای مطیع، صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 617.68,
   "end": 619.58,
   "text": "اینا چگونه رحمتو دریافت می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 619.58,
   "end": 623.8,
   "text": "\"الجنة والرضا ولقاء الحق تعالی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 623.8,
   "end": 625.58,
   "text": "همینجا به لقای خدا می‌رسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 625.58,
   "end": 628.86,
   "text": "به بهشت می‌رسن. \"وغير ذلك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 628.86,
   "end": 632.4,
   "text": "چگونه به، به چه بهشت‌هایی؟ \"من ما لا عين رأت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 632.4,
   "end": 635.56,
   "text": "که چشم‌ها ندیده \"ولا أذن سمعت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 635.56,
   "end": 638.44,
   "text": "گوش‌ها نشنیده \"ولا خطر على قلب بشر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 638.44,
   "end": 642.16,
   "text": "قل-قلب بشری خطور نکرده به این‌ها می‌رسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 642.16,
   "end": 645.78,
   "text": "\"مطيعین و صالحین\". رحمت خدا رو اینطوری اخذ می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 645.78,
   "end": 648.9,
   "text": "\"اما و على العارفين الموحدين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 648.9,
   "end": 651.34,
   "text": "اونایی که عارف‌اند. به عرفان رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 651.34,
   "end": 659.56,
   "text": "به معارف الهیه رسیدن. \"ما ذلك افادة العلوم اليقينية والمعارف الحقيقية\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 659.56,
   "end": 663.32,
   "text": "می‌رسن به علوم یقینی، معارف حقیقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 663.32,
   "end": 668.88,
   "text": "همون رحمت واسعه‌ست به گنهکار می‌خوره، عفو گناه بدبخت بیچاره مثل من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 668.88,
   "end": 670.88,
   "text": "الک زده. خودشو باخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 670.88,
   "end": 674.3,
   "text": "تو مسیر رشد و ارتقای نفس ناطقه‌ش حرکت نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 674.3,
   "end": 681.06,
   "text": "هی گناه کرده. حالا رحمت خدا به جهت صلوات که بر پیغمبر فرستادی به تو نازل میشه اما گناهت بخشیده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 681.06,
   "end": 686.16,
   "text": "اما برای عارف چی؟ علم پشت علم، حقیقت کشف میشه براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 686.16,
   "end": 689.98,
   "text": "بعد می‌زنه حالا \"وعلى المحققين الكاملين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 689.98,
   "end": 697.74,
   "text": "المكملين من الأنبياء والأولياء عليهم السلام от تجليات الذاتية والأسماء والصفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 697.74,
   "end": 702.98,
   "text": "وأعلى مراتب الجنان بالجنات الأعمال والصفات والذات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 702.98,
   "end": 706.12,
   "text": "اوه، اوه، اوه همینطوری میره جلو تا ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 706.12,
   "end": 709.72,
   "text": "اینا مال اوناست من اصلاً در-- از-- حرفی در بارش ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 709.72,
   "end": 711.38,
   "text": "ببین چقدر ما خودمون رو باختیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 711.38,
   "end": 713.44,
   "text": "یه کاری کردیم ختم کلام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 713.44,
   "end": 718.46,
   "text": "یه کاری کردیم که رحمت خاص خدا هم که به ما می‌خواد بریزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 718.46,
   "end": 723.8,
   "text": "به جهت صلوات که به پیغمبر فرستادیم، محبت که به اهل بیت داریم باید بزنه گناهان ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 723.8,
   "end": 726.72,
   "text": "جمع کنه، جارو کنه. ولی یکی نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 726.72,
   "end": 731.76,
   "text": "حقایق عینیه و یقینیه براش نازل میشه و هی رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 731.76,
   "end": 734.38,
   "text": "کمال خودش میره. این کجا اون کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 734.38,
   "end": 736.14,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 736.14,
   "end": 744.54,
   "text": "به برکت صلوات بر محمد و آل محمد. سلام بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}