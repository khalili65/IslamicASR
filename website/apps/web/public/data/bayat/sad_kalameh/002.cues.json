 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ اول؛ آن که خود را نشناخت چگونه دیگری را شناخت",
   "start": 1.32,
   "end": 122.5
  },
  {
   "index": 1,
   "title": "### طب و شناخت نفس",
   "start": 122.5,
   "end": 142.96
  },
  {
   "index": 2,
   "title": "## آخرین منزل عارف؛ همه در درون بوده",
   "start": 142.96,
   "end": 253.82
  },
  {
   "index": 3,
   "title": "## احادیث غرر؛ جهل به نفس و عقل",
   "start": 253.82,
   "end": 470.82
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.0,
   "end": 2.8,
   "text": "حالا اگه خدا لطف کنه نیت کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.8,
   "end": 5.42,
   "text": "تو صد جلسه پنج دقیقه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.42,
   "end": 8.24,
   "text": "هر جلسه یه کلمه رو بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.24,
   "end": 14.08,
   "text": "که به اغراق نمیگم به واقع اگر درون مایه هر کلمه رو بریزی بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.08,
   "end": 16.64,
   "text": "هر کلمه صد جلسه می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.64,
   "end": 19.32,
   "text": "حالا ما صد جلسه میذاریم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.32,
   "end": 23.32,
   "text": "صد کلمه. کلمه اول رو دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.32,
   "end": 27.76,
   "text": "علامه می‌فرمایند که مقا-- کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.76,
   "end": 33.32,
   "text": "صد کلمه‌شون. می‌فرمود که آن که خود را نشناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.32,
   "end": 36.18,
   "text": "چگونه دیگری را شناخت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.18,
   "end": 40.96,
   "text": "تحمل کنید روش. آن که خود را نشناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.96,
   "end": 47.22,
   "text": "چگونه دیگری را شناخت؟ معمولا ما متاسفانه مخصوصا این تحلیلگرها اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.22,
   "end": 51.1,
   "text": "هنوز خودشونو نشناخته‌اند به تحلیل دیگران می‌پردازند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.1,
   "end": 53.68,
   "text": "در رابطه با خودشون هیچ گمانی نکردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.68,
   "end": 57.66,
   "text": "همش دائما به دیگران گمان و زن می‌برند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.66,
   "end": 63.04,
   "text": "روانشناسا اصلا روان خودش نمی‌دونه چیه به روان این و اون می‌پردازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.04,
   "end": 69.54,
   "text": "اینا، همه‌ی این‌ها هیچ کدوم راه به جایی نمی‌برن تا اول از خودش شروع نکنه طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.54,
   "end": 72.56,
   "text": "مثل اینکه شما این مثال رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.56,
   "end": 76.32,
   "text": "مثل اینکه شما اصل شیء رو ندیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.32,
   "end": 79.58,
   "text": "دقت کنید. قشنگ جا میفته با این مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.58,
   "end": 83.18,
   "text": "اصل شیء رو ندیدی. حالا میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.18,
   "end": 86.7,
   "text": "عکس اون شیء رو جلوم تو آینه به شما نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.7,
   "end": 91.24,
   "text": "از طریق مرآت یا آینه عکس شیء رو به شما نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.24,
   "end": 93.46,
   "text": "شما چجوری تشخیص میدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.46,
   "end": 98.02,
   "text": "این چیه؟ اصلا بی‌خبری از اصل شیء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.02,
   "end": 101.2,
   "text": "حالا عکسشو یا تو آینه مثلا به شما دارن نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.2,
   "end": 105.04,
   "text": "مخصوصا کلمه مرآت رو استفاده می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.04,
   "end": 108.16,
   "text": "چون همه‌ی عوالم هستی مرآتی‌اند به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.16,
   "end": 110.26,
   "text": "دارن تو رو به خودت نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.26,
   "end": 115.08,
   "text": "تو وقتی که خودت از خودت بی‌خبری، اصل شیء رو ندیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.08,
   "end": 119.9,
   "text": "چگونه می‌خوای تو مرآت، تو آینه شیء رو ببینی و بشناسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 119.9,
   "end": 122.5,
   "text": "اصلا امکان نیست. امکانش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.5,
   "end": 125.9,
   "text": "حتی اطباء، اطبایی که به منزله‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 125.9,
   "end": 130.44,
   "text": "یعنی به انزل مراتب نفس که بدنه کار می‌کنند طبیعت بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 130.44,
   "end": 132.38,
   "text": "انزل-- ولی انزل مراتب نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 132.38,
   "end": 133.92,
   "text": "بدن جدایی از نفس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.92,
   "end": 138.84,
   "text": "این غلطه که میگن نفس سواره یا روح سوار بر مرکب بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 138.84,
   "end": 142.96,
   "text": "این غلطه. اتفاقا بدن در روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 142.96,
   "end": 145.44,
   "text": "بدن در روحه. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 145.44,
   "end": 148.98,
   "text": "اصلا بدن یکی از منز- منازله، یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 148.98,
   "end": 151.74,
   "text": "شئون نفسه. نفس ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 151.74,
   "end": 157.52,
   "text": "تا کسی نفس خودش رو نشناخته، اصلا مراتب نفس رو نمی‌دونه چگونه می‌خواد طب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 157.52,
   "end": 160.32,
   "text": "بره تو طب کار کنه. طب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 160.32,
   "end": 164.66,
   "text": "یک بر ذیل اسم طبيب خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 164.66,
   "end": 169.42,
   "text": "خدا هم نفس داره. اللهم عرفنی نفسک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 169.42,
   "end": 176.48,
   "text": "تا خودت رو که به وزان حضرت حق در ذات و صفات و افعال آفریده شدی نشناسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 176.48,
   "end": 179.2,
   "text": "چجوری می‌خوای بری نفوس رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.2,
   "end": 182.82,
   "text": "که عرض کردم اگه بگی طب ذیل اسم طبيب خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 182.82,
   "end": 190.14,
   "text": "خدا هم که نفس داره یعنی یک، یکی از اشیایی رو که شئون حضرت حق‌اند بشناسی، دیگران رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 190.14,
   "end": 194.78,
   "text": "طبابت هم بکنی. مگه می‌شه همچین چیزی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.78,
   "end": 200.02,
   "text": "لذا غالبا هم می‌بینی دستورالعمل‌هاشون خیلی جواب شاید نده یا مقطعی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.02,
   "end": 203.4,
   "text": "طبيب کسی که نفس رو شناخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.4,
   "end": 209.1,
   "text": "حکیم کسی که مراتب نفس رو هم شناخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.1,
   "end": 217.8,
   "text": "خیلی جالب بود که داشتم همین امروز درس چهل و چهار شرح فصوص از تلهمه رو می‌خوندم، گوش می‌دادم به کلام شیواشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.8,
   "end": 222.82,
   "text": "ایشون یه جمله‌ای چجوری انگار اصلا این جلسه رو انگار برای امروز ما فرموده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.82,
   "end": 225.58,
   "text": "ایشون فرمودند که آخرین منزل عارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.58,
   "end": 228.06,
   "text": "که شان شناخت پیدا می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.06,
   "end": 236.68,
   "text": "مرحله و منزل آخر به اینجا می‌رسه که عجب هرچی در بیرون از خودش جستجو می‌کرد در درون خودش بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.68,
   "end": 240.94,
   "text": "ولی این غافل بوده که تا انسان نفسش رو نشناسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.94,
   "end": 246.62,
   "text": "هیچ چیزی رو نمی‌تونه بشناسه. حتی خداشناسی مگه نمیگه اللهم عرفنی نفسک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.62,
   "end": 249.14,
   "text": "اون نفس کل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.14,
   "end": 253.82,
   "text": "چگونه می‌خوای بشناسی در حالی که جزئش رو نشناختی که نفس خودته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.82,
   "end": 258.42,
   "text": "وقتی این به وزان اونه، این رو بشناسی، اون رو شناختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.42,
   "end": 262.88,
   "text": "لذا قطب قاطبه‌ست معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.88,
   "end": 267.14,
   "text": "امام علی علیه السلام این حدیث رو ببینید در غرر الحکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.14,
   "end": 269.84,
   "text": "می‌فرمود من جهل نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.84,
   "end": 272.94,
   "text": "کامتون شیرین بشه به کلام مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.94,
   "end": 276.46,
   "text": "من جهل نفسه کسی که به نفس خودش جاهله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.46,
   "end": 279.66,
   "text": "نفسه، به نفس خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.66,
   "end": 282.36,
   "text": "کان بغیر نفسهi اجهل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.36,
   "end": 287.06,
   "text": "چنین کسی به نفوس دیگران اجهل بر وزن افعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.06,
   "end": 290.92,
   "text": "یعنی غافلتر. وقتی خودش رو نشناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.92,
   "end": 292.66,
   "text": "چگونه می‌خواد دیگران رو بشناسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.66,
   "end": 298.82,
   "text": "اجهله. اصلا نمی‌شه در مخصوصا در مرحله‌ی تبلیغ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.82,
   "end": 301.4,
   "text": "ابلاغ، بیان، تبلیغ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.4,
   "end": 306.5,
   "text": "طبابت، رسالت فرهنگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.5,
   "end": 310.24,
   "text": "تا هندسه نفس رو نشناسی، ابعادش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.24,
   "end": 314.28,
   "text": "مراتبش رو چگونه می‌خوای بعد دشمن راحت بهت کمین می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.28,
   "end": 319.54,
   "text": "بهت حمله می‌کنه. یه حدیث دیگه براتون بخونم باهاش کیف کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.54,
   "end": 321.82,
   "text": "این هم از مولا در غرر الحکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.82,
   "end": 324.34,
   "text": "العقل معرفة الانسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.34,
   "end": 327.34,
   "text": "عقل معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.34,
   "end": 330.32,
   "text": "انسان به چی؟ نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.32,
   "end": 336.44,
   "text": "می‌خوای بدونی عقل چیه که اگر عقلت رو تعطیل کنی به ماوراء ملکوت دسترسی پیدا نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 336.44,
   "end": 340.32,
   "text": "به یک معنا ملکوت وجود تو عقل وجود توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.32,
   "end": 345.6,
   "text": "می‌گه العقل معرفة الانسان نفسه معرفت نفس همون عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.6,
   "end": 349.04,
   "text": "و اگر، اگر کسی معرفت نفس نداره، عقل نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.04,
   "end": 353.72,
   "text": "به همین راحتی. فمن عرف نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.72,
   "end": 358.38,
   "text": "عقل. اگر کسی نفسش رو شناخت رسیده به عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.38,
   "end": 360.76,
   "text": "و من جهلها ول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.76,
   "end": 363.6,
   "text": "چه-چگونه تو نماز میگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.6,
   "end": 366.8,
   "text": "یا غیر مغضوب عليهم ولا ضالین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.8,
   "end": 370.36,
   "text": "اون راهی نری، ممنوع-- ممنوع المری به اون راهیه که ولا ضالین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.36,
   "end": 374.34,
   "text": "گمراهان. می‌گه و ول. کسی نفسش رو نشناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.34,
   "end": 376.82,
   "text": "جز به ضالین. ول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 376.82,
   "end": 378.56,
   "text": "گمراه می‌شه. انقدر خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.56,
   "end": 380.5,
   "text": "خیلی مهمه معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.5,
   "end": 383.86,
   "text": "حتی از دشمن شناسی اینم بگم و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.86,
   "end": 386.02,
   "text": "آیه شش سوره فاطر رو برید بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 386.02,
   "end": 390.26,
   "text": "صراحتا قرآن می‌گه ان الشيطان لکم عدو فاتخذوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 390.26,
   "end": 393.24,
   "text": "عدوا. اگر فقط می‌گفت دشمنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 393.24,
   "end": 395.12,
   "text": "بو-- خیلی جدی نمی‌گرفتیم. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.12,
   "end": 397.74,
   "text": "دستور می‌ده fat takzoho",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 397.74,
   "end": 400.46,
   "text": "adowa اونو دشمن بگیرید اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 400.46,
   "end": 402.94,
   "text": "خب این دشمن چجوری به ما حمله می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 402.94,
   "end": 408.44,
   "text": "از چه جهاتی؟ آیه شونزده و هفده اعراف می‌فرماید لاغودن لهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 408.44,
   "end": 414.5,
   "text": "صراطک المستقيم. وقتی میاد به تو کمین می‌زنه که تو صراط مستقیمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 414.5,
   "end": 418.54,
   "text": "تو راه صراط مستقیم قرار گرفت میگی آخی راحت شدم تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.54,
   "end": 421.74,
   "text": "بلاها رفت، کیدها خنثی شد، نقشه‌ها بر آب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 421.74,
   "end": 424.06,
   "text": "نه خیر. تازه شیطان میاد سراغت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 424.06,
   "end": 426.0,
   "text": "چگونه میاد؟ آیه رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 426.0,
   "end": 428.7,
   "text": "لآتینهم من بین ایدیهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 428.7,
   "end": 432.62,
   "text": "و من خلفهم و عن أيمانهم و عن شما ئلهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 432.62,
   "end": 434.84,
   "text": "و لتوجد اکثرهم شاکرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 434.84,
   "end": 436.56,
   "text": "از چهار طرف حمله می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 436.56,
   "end": 440.76,
   "text": "سؤال. حمله شیطان فیزیکیه یا متافیزیکیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 440.76,
   "end": 444.9,
   "text": "به نفست حمله می‌کنه. یعنی چی به نفست حمله می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 444.9,
   "end": 449.36,
   "text": "این از چهار جهت چرا از بالا و پایین نمی‌تونه حمله کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 449.36,
   "end": 453.86,
   "text": "چرا این چرای‌هاش در معرفت نفس خوابیده که ما اینجا فرصت نداریم بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 453.86,
   "end": 456.54,
   "text": "اگر نفست رو بشناسی می‌تونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 456.54,
   "end": 462.4,
   "text": "شیطان رو بشناسی چگونه می‌خواد به تو حمله کنه که اگر نشناسی اون دائما داره به تو حمله می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 462.4,
   "end": 464.74,
   "text": "از چهار طرف بهت حمله کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 464.74,
   "end": 470.82,
   "text": "خدا ما رو در امان بدارد. انشاالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد. سلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}