   "start": 9.66,
   "end": 38.98
  },
  {
   "index": 1,
   "title": "## فوق تجرد و مراتب وجود",
   "start": 38.98,
   "end": 209.62
  },
  {
   "index": 2,
   "title": "## انزال دفعی در لیلهٔ مبارکهٔ بنیهٔ محمدیه",
   "start": 209.62,
   "end": 267.06
  },
  {
   "index": 3,
   "title": "## قوس نزول و قوس صعود؛ لیله و نهار",
   "start": 267.06,
   "end": 379.44
  },
  {
   "index": 4,
   "title": "## تنزل ملائکه بر اهل بیت و معراج امام عصر",
   "start": 379.44,
   "end": 399.6
  },
  {
   "index": 5,
   "title": "## ماه مهدوی و آیهٔ نور",
   "start": 399.6,
   "end": 584.96
  },
  {
   "index": 6,
   "title": "## مراقبت شب جمعه و آیهٔ نور",
   "start": 584.96,
   "end": 653.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 5.64,
   "text": "و بهین الساعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.64,
   "end": 9.66,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.66,
   "end": 12.38,
   "text": "کلمه سی و یکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.38,
   "end": 15.18,
   "text": "آنکه به سر سوره قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.18,
   "end": 18.14,
   "text": "که این سوره قدر بسیار اسرار دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.14,
   "end": 20.72,
   "text": "خیلی سوره عجیبی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.72,
   "end": 24.14,
   "text": "که وصل بین عالم وحدت و کثرت ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.14,
   "end": 29.58,
   "text": "کسایی که می‌خوان خوابشون تصفیه بشه، خواب خوب ببینن، اینا سوره قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.58,
   "end": 31.6,
   "text": "رزق‌شون زیاد بشه سوره قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 31.6,
   "end": 35.04,
   "text": "ات-ارتباط ملک با ملکوت سوره قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.04,
   "end": 42.8,
   "text": "خیلی عجیبه این سوره. حضرت علامه در این کلمه می‌فرماید، «آنکه به سر سوره قدر کشف تام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.8,
   "end": 48.64,
   "text": "محمدی برسد» صلی الله علیه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.64,
   "end": 53.36,
   "text": "خب این کشف تام محمدی منظور قرآن است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.36,
   "end": 64.46,
   "text": "در تام‌ترین یا اون کشف اتم پیغمبر تونست از ملکوت عالم به قلب مقدسش این قرآن رو، این کتاب رو اونم القرآن رو همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.46,
   "end": 72.0,
   "text": "علم امکانی حضرت حق که به جز اسماء مستعصره‌شون نازل شدن در این عالم هستی رو به قلب مقدسشون بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.0,
   "end": 77.76,
   "text": "منظور همون قرآنه. اگر در کتب و صحف نوریه عرفانی و حکمیه دیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.76,
   "end": 81.38,
   "text": "تا کشف تام محمدی منظور همون قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.38,
   "end": 83.6,
   "text": "انسان را صاحب مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.6,
   "end": 86.78,
   "text": "فوق تجرد شناسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.78,
   "end": 90.38,
   "text": "کی؟ کسی که به سوره قدر توجه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.38,
   "end": 94.26,
   "text": "یعنی چی انسان رو دارای مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.26,
   "end": 95.96,
   "text": "فوق تجرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.96,
   "end": 101.44,
   "text": "تجرد خب اینکه انسان مجرد باشد از عالم ماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.44,
   "end": 104.28,
   "text": "وقتی میره به برزخ، تجرد برزخی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.28,
   "end": 110.14,
   "text": "یعنی بخشی از خصوصیات ماده و طبیعت رو تو عالم برزخ با خودش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.14,
   "end": 114.72,
   "text": "چون برزخ حد فاصل بین دنیا و آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.72,
   "end": 118.12,
   "text": "بعد احکام مافوق خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.12,
   "end": 122.98,
   "text": "که می‌شه عالم آخرت و قیامت و عقول و اینا اونجا رو هم داره عالم برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.98,
   "end": 125.54,
   "text": "لذا تجردش تام نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.54,
   "end": 129.64,
   "text": "یعنی صورت هم داره، رنگ و شکل هم داره که طبیعت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.64,
   "end": 135.88,
   "text": "اما مثل عالم عقول نیست که یک پارچه حقیقت کلیه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.88,
   "end": 137.94,
   "text": "یعنی بخشیش مادیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.94,
   "end": 140.48,
   "text": "صورت ماده داره بخشیش نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.48,
   "end": 142.24,
   "text": "تجرد اون چنینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.24,
   "end": 144.44,
   "text": "یعنی بینابین برزخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.44,
   "end": 148.38,
   "text": "وقتی که از عالم برزخ که رفتی بالاتر عالم عقول و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.38,
   "end": 155.94,
   "text": "این‌ها بعد به عالم قلب مخصوصاً اونجا دیگه و این‌هاییم که دارم میگم هم بیرون از ما خارج از مرتبه وجود ما که همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.94,
   "end": 158.34,
   "text": "عوالم هستی‌ست اینا وجود دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.34,
   "end": 161.64,
   "text": "هم در وجود ما این‌ها وجود-- هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.64,
   "end": 164.4,
   "text": "باید شناسایی بشن در سر معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.4,
   "end": 169.36,
   "text": "اونجا دیگه مثلاً تجرد تام در عالم عقول رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.36,
   "end": 174.12,
   "text": "اصلاً تجرد تام اونجا عالم عقول، ارواح، مفارقات اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.12,
   "end": 176.2,
   "text": "بعد فوق اون هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.2,
   "end": 180.68,
   "text": "فوق عالم تجرد که یک طور وجود ماست دیگه مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.68,
   "end": 186.68,
   "text": "قلب و سر و روح ماست که اتصال داره به مرتبه احدیت و ذات حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.68,
   "end": 190.68,
   "text": "که این بحث‌ها قبلاً چون گذشته دیگه من دو مرتبه تکرار نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.68,
   "end": 198.42,
   "text": "یعنی انقدر وجود ما اشمخه که اگر کسی این ارتباط رو بتونه بگیره، بگیره میره، میره تا می‌رسه به حضرت حق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.42,
   "end": 201.58,
   "text": "بحث لقاء و این‌ها که بحث‌هاش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.58,
   "end": 206.44,
   "text": "از اینجا علامه می‌فرماید که از سوره قدر می‌تونید به این حقیقت برسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.44,
   "end": 209.12,
   "text": "یا سر رو داره بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.12,
   "end": 211.5,
   "text": "چه اینکه قرآن مجید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.5,
   "end": 217.38,
   "text": "بی‌کران در لیله، این قرآن مجیدی که کران ندارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.38,
   "end": 222.42,
   "text": "یعنی انتها ندارد. علم لایتناهی حضرت حق درشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.42,
   "end": 228.14,
   "text": "بر کجا وارد شده؟ در لیله اینو این جمله رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.14,
   "end": 234.92,
   "text": "ساعت‌ها حضرت علامه در شرح fusos پیرامون همین کلمه که الان می‌خوام بگم حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.92,
   "end": 237.36,
   "text": "در لیله مبارکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.36,
   "end": 242.96,
   "text": "بنیه محمدیه از غایت فسحت قلب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.96,
   "end": 247.42,
   "text": "نهایت شرح صدرش به انزال دفعی فرود آمده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.42,
   "end": 251.82,
   "text": "این، اینجا می‌فرماید اولاً انزال دفعی بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.82,
   "end": 255.44,
   "text": "در لیله القدر. یعنی به یکباره اون حقیقت نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.44,
   "end": 260.04,
   "text": "ببینین قلب مقدس پیغمبر چه سع و گنجایشی داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.04,
   "end": 264.9,
   "text": "نکته بعد اینکه تعبیر می‌کنه از لیلة القدر به بنیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.9,
   "end": 267.06,
   "text": "بنیه محمدیه. این حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.06,
   "end": 271.64,
   "text": "چرا لیلة القدر؟ یا می‌فرماید لیله مبارک بنیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.64,
   "end": 273.68,
   "text": "محمدیه. چرا لیله میاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.68,
   "end": 276.56,
   "text": "اینم چون بحثش گذشته باید دیگه با گوش شما آشنا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.56,
   "end": 279.72,
   "text": "خیلی شیرین. ما یه قوس نزول داریم، یه قوس صعود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.72,
   "end": 282.3,
   "text": "در همه حقایق همیشه این هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.3,
   "end": 284.32,
   "text": "همین الان که ما اینجا نشستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.32,
   "end": 286.46,
   "text": "شما قوس نزول دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.46,
   "end": 289.66,
   "text": "دارید از اون عالم سر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.66,
   "end": 292.1,
   "text": "روحتون آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.1,
   "end": 295.34,
   "text": "در ظاهر من دارم صوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.34,
   "end": 298.86,
   "text": "انجام میدم، صوت ایجاد می‌کنم، می‌شنوی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.86,
   "end": 301.74,
   "text": "سرت، ملکوت وجودت داره اون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.74,
   "end": 305.48,
   "text": "حقیقتش رو از عالم بالا عکس می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.48,
   "end": 308.98,
   "text": "چون گفتیم فهم چشیدن مربوط به ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.98,
   "end": 312.08,
   "text": "ربطی به اینجا نداره. اینجا کمک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.08,
   "end": 314.66,
   "text": "سر شما داره از ملکوت، از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.66,
   "end": 318.42,
   "text": "از اون جان وجودت، از اون ارتباطت با حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.42,
   "end": 320.64,
   "text": "این چیزی که می‌شنوی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 320.64,
   "end": 323.04,
   "text": "می‌چشه، می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.04,
   "end": 326.18,
   "text": "از اونجا میاد پایین. به این میگن قوس چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.18,
   "end": 328.92,
   "text": "نزول شما. نزول شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.92,
   "end": 334.06,
   "text": "یه نزول کلی هم داریم که انا لله از سمت خدا هم ابتدا اومدیم نطفه تشکیل شده و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.06,
   "end": 336.36,
   "text": "اصلاً دائماً این در جریانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 336.36,
   "end": 338.68,
   "text": "قوس صعود هم داریم. چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 338.68,
   "end": 344.62,
   "text": "شما می‌خوای این مثلاً حرفی که شنیدی رو همین الان می‌خوای حرفی که شنیدی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 344.62,
   "end": 347.5,
   "text": "ببری براش صورت ایجاد کنی که بدیش به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 347.5,
   "end": 355.06,
   "text": "قوه وهمت براش حقایق اصلاً جزئی فهمیش کنی، بدی به قل-- عقلت کلی فهمیش کنی بدی به عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.06,
   "end": 359.74,
   "text": "قلبت اینو سان بده حاضر کنه توجه کنی به این حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.74,
   "end": 362.78,
   "text": "خب این حرفی که الان داری می‌شنوی رو چطور می‌خوای ببریش بالا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.78,
   "end": 365.28,
   "text": "از قوه سامعیت داری می‌شنوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.28,
   "end": 367.66,
   "text": "حواس ظاهریه در نشئه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.66,
   "end": 371.36,
   "text": "این می‌شه چی؟ از قوه سامعه میره به حس مشترک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.36,
   "end": 374.58,
   "text": "و میره به قوه خیال، میره به قوه عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.58,
   "end": 376.32,
   "text": "می‌بینی دست منو هی داره میره بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 376.32,
   "end": 379.38,
   "text": "قوه قلب همینطوری تا سر و روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.38,
   "end": 381.36,
   "text": "و پس قوس می‌شه صعود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 381.36,
   "end": 387.82,
   "text": "این هست. حالا در قوس النزول هر وقت قوس النزول رخ می‌ده بهش می‌گن لیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.82,
   "end": 391.36,
   "text": "چرا؟ چون همیشه مافوق نسبت به مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 391.36,
   "end": 395.84,
   "text": "شدت نوریه داره. عالم طبیعت و دنیا نوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.84,
   "end": 399.04,
   "text": "اما نسبت به برزخ ظلمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 399.04,
   "end": 403.08,
   "text": "عالم برزخ هم یکپارچه نوره اما نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.08,
   "end": 405.32,
   "text": "عالم عقول ظلمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 405.32,
   "end": 411.12,
   "text": "پس وقتی از پایین میری به بالا داری ز-از ظلمت میری به سمت نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 411.12,
   "end": 413.56,
   "text": "بهش می‌گن چی؟ قوس صعود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 413.56,
   "end": 417.48,
   "text": "این می‌شه به سمت نهار داری میری به سمت روز داری میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.48,
   "end": 425.1,
   "text": "درست شد؟ اما وقتی از بالا نزول پیدا می‌کنه حقایق میاد پایین چون از مافوق که شدت نوریش بیشتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 425.1,
   "end": 430.22,
   "text": "میاد به پایین که شدت نوریش کمتره یا به عبارتی ظلمته؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 430.22,
   "end": 433.32,
   "text": "چون داره میاد به سمت تاریکی میگن لیله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.32,
   "end": 440.18,
   "text": "و چون نزول به قلب پیغمبر از عالم بالا از ذات حضرت حق \"إنك\" آیه قرآن \"إنك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 440.18,
   "end": 442.4,
   "text": "لتلقى القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.4,
   "end": 444.56,
   "text": "من لدن حكيم عليم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 444.56,
   "end": 450.7,
   "text": "قرآن علم لدنی حضرت حق است که بر قلب پیغمبر از ذات حضرت حق نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.7,
   "end": 456.36,
   "text": "اومده هی پایین اومده پایین. همینطوری تا به لسان مبارک پیغمبر می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.36,
   "end": 458.5,
   "text": "می‌شه قوس النزول. پس لیله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 458.5,
   "end": 461.1,
   "text": "پس چون داره میره به سمت عالم ظلمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.1,
   "end": 464.94,
   "text": "این الان سر‌هاییه که علامه اوو چندین جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.94,
   "end": 468.9,
   "text": "تو شر-شرح fususشون به فضل الهی ما بهره بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 468.9,
   "end": 472.56,
   "text": "این‌ها رو توضیح دادن که من دیگه MP3 رو سریع برای شما گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 472.56,
   "end": 477.94,
   "text": "حالا اینجا داره می‌فرماید که این از غایت فسحت قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 477.94,
   "end": 480.3,
   "text": "و نهایت شرح صدرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 480.3,
   "end": 486.12,
   "text": "چی؟ پیغمبر. یعنی اگر این شرح سدرو پیغمبر نداشت دست ما از قرآن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.12,
   "end": 491.96,
   "text": "اون عالم، اون حقایق عالم بالا و اون ملکوت نظام هستی و ذات حضرت حق کوتاه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.96,
   "end": 493.88,
   "text": "ما هممون مدیون پیغمبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.88,
   "end": 498.74,
   "text": "اما بعد از پیغمبر سیزده نفر تونستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 498.74,
   "end": 500.78,
   "text": "این نکته آخر رو خوب توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 500.78,
   "end": 502.96,
   "text": "همه این‌ها رو مقدمه کردم برای این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.96,
   "end": 512.74,
   "text": "سیزده تا عزیز تونستن در قوس صعود یعنی در صعود اع-عروجیشون تو همین عرشه نظام طبیعت در همین عرصه نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 512.74,
   "end": 520.36,
   "text": "از اینجا برن برسن به اون مقام و مرتبه، اتحاد وجودی پیدا کنن با حالا اون صادر نخستین که قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 520.36,
   "end": 522.34,
   "text": "اون‌هام تنز-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.34,
   "end": 524.02,
   "text": "تنزل الملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 524.02,
   "end": 526.02,
   "text": "این دیگه چیه؟ قوس چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.02,
   "end": 528.2,
   "text": "نزوله اما سیر تدریجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 528.2,
   "end": 531.58,
   "text": "برای پیغمبر انزال دفعی به یک باره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 531.58,
   "end": 537.22,
   "text": "برای اهل بیت بعد از پیغمبر تنزل الملائکه بازم تو سوره قدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.22,
   "end": 541.26,
   "text": "الملائكة والروح فيها بأذن ربهم من كل أمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 541.26,
   "end": 542.96,
   "text": "اینجا چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 542.96,
   "end": 548.54,
   "text": "بر قلب مقدس پیغمبر دوباره همون بر قلب، قلب مقدس امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 548.54,
   "end": 553.16,
   "text": "همون حقایقی که بر قلب پیغمبر نازل شد تدریجاً داره میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 553.16,
   "end": 558.02,
   "text": "لذا علامه احمد همدانی علیه الرحمه در کتاب شریف‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 558.02,
   "end": 560.22,
   "text": "خیلی حرف سنگینی رو پیاده می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 560.22,
   "end": 564.36,
   "text": "می‌فرمایند امام عصر ما هر شب جمعه معراج داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 564.36,
   "end": 568.62,
   "text": "هر شب جمعه معراج داره. میره اونجا عالم بالا اخذ علم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 568.62,
   "end": 571.22,
   "text": "حقایق تنزل می‌کنه به قلبش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 571.22,
   "end": 576.28,
   "text": "چه زیبا و شیرین که دقیقاً شب معراج امام عصر امسال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.28,
   "end": 579.08,
   "text": "خورده به شب نیمه شعبان و میلاد خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.08,
   "end": 581.14,
   "text": "بسیار شب سنگینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 581.14,
   "end": 586.66,
   "text": "اونایی که دنبال اخذ علم‌اند، می‌خوان تنزل حقایق از عالم بالا به قلبشون رخ بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 586.66,
   "end": 592.4,
   "text": "حواسشون جمع باشه که شب جمعه، این شب جمعه شب خاصیه و توسل به حضرت حجت داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 592.4,
   "end": 595.16,
   "text": "قبلاً هم گفتم حیفم میاد این‌ها رو نگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 595.16,
   "end": 597.56,
   "text": "حالا نگاه پرعطش شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 597.56,
   "end": 600.24,
   "text": "می‌خوام دوباره بگم. ماهی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 600.24,
   "end": 603.94,
   "text": "روز اولش با روز جمعه بی-شروع بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 603.94,
   "end": 607.84,
   "text": "عرفا، بزرگان مثل علامه حسن زاده نه آدمای کم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 607.84,
   "end": 610.22,
   "text": "این‌ها فرمودن اون ماه، ماه مهدوی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 610.22,
   "end": 614.26,
   "text": "تمام آنات و ساعت‌ش بو امام عصر، رو امام عصر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 614.26,
   "end": 617.48,
   "text": "لذا تو کل این ماهی که مهدوی‌ست مثل امسال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 617.48,
   "end": 620.28,
   "text": "امسال که نیمه شعبانه، خب شعبان هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 620.28,
   "end": 624.44,
   "text": "متعلق به حضرته. اول این ماه هم با روز جمعه شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.44,
   "end": 631.14,
   "text": "متعلق به امام عصره. لذا فرمودن تو کل این ماه دویست و پنجاه و شش بار آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 631.14,
   "end": 635.18,
   "text": "نور رو بخونی ربط وجودی با امام عصرت پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 635.18,
   "end": 637.36,
   "text": "حالا روزی هر چند تا می‌تونی هر روز بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 637.36,
   "end": 640.08,
   "text": "تو کل ماه دویست پنجاه و شش بار آیه نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 640.08,
   "end": 642.26,
   "text": "می‌شه آیه سی و پنج سوره نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 642.26,
   "end": 647.1,
   "text": "که بعضیا گفتن شبی چهارده بار قبل خواب بخونی که دیگه نور على نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 647.1,
   "end": 653.5,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}