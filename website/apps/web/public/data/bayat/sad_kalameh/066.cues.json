 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ شصت و پنج؛ آلام و لذات میانِ انفعال و فعل",
   "start": 46.48,
   "end": 135.7
  },
  {
   "index": 1,
   "title": "## در آخرت لذت و درد از فعلِ نفس است",
   "start": 135.7,
   "end": 156.12
  },
  {
   "index": 2,
   "title": "## انصراف در همین نشئه؛ خواب برادرِ مرگ",
   "start": 156.12,
   "end": 303.36
  },
  {
   "index": 3,
   "title": "## خلاصهٔ کلمه",
   "start": 303.36,
   "end": 923.32
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.2,
   "end": 7.24,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.24,
   "end": 11.22,
   "text": "السلام علیک ای داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.22,
   "end": 16.9,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.9,
   "end": 20.58,
   "text": "از آقای مرادی عزیز تشکر می‌کنم که چهارشنبه‌ها بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.58,
   "end": 23.56,
   "text": "نماز اینجا رو به دوش می‌کشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.56,
   "end": 28.32,
   "text": "البته امروز ما مثل اجل معلق سر شما خراب شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.32,
   "end": 31.34,
   "text": "چهارشنبه‌ها مسجد بلال میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.34,
   "end": 35.38,
   "text": "دیگه امروز چون حالم خوب نبود به مسجد بلال گفتم نمیاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.38,
   "end": 41.14,
   "text": "توفیق بود که در خدمت شما باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.14,
   "end": 45.06,
   "text": "از همین فرصت استفاده کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.06,
   "end": 49.8,
   "text": "کلمه‌ی دیگری رو از صد کلمه در معرفت نفس حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.8,
   "end": 53.16,
   "text": "بررسی کنیم. کلمه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.16,
   "end": 59.12,
   "text": "شصت و پنج. آنکه در آلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.12,
   "end": 62.8,
   "text": "جمع علم، درد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.8,
   "end": 73.92,
   "text": "و لذات. آنکه در آلام و لذات دنیوی که از خارج بدو اصابت می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.92,
   "end": 78.54,
   "text": "و از انفعالات نفسند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.54,
   "end": 82.06,
   "text": "و نیز در آلات و لذات اخروی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.06,
   "end": 84.2,
   "text": "اون دنیوی‌ش حالا این اخروی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.2,
   "end": 87.64,
   "text": "اون آلات و لذات، آلام و لذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.64,
   "end": 91.02,
   "text": "دنیوی، حالا این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.02,
   "end": 93.48,
   "text": "و نیز در آلام و لذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.48,
   "end": 101.48,
   "text": "اخروی که از تمسلات و ادراکات در حال انصراف از این نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.48,
   "end": 107.46,
   "text": "در نوم یا بیداری به انشاء نفس و واردات داخلی می‌چشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.46,
   "end": 110.28,
   "text": "که از افعال نفسند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.28,
   "end": 114.18,
   "text": "نظر کند، بدین حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.18,
   "end": 119.0,
   "text": "اذعان کند که لذات و آلام نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.0,
   "end": 121.98,
   "text": "در این نشئه یعنی در دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.98,
   "end": 125.62,
   "text": "از مقوله‌ی انفعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.62,
   "end": 130.14,
   "text": "و از و در آن نشئه یعنی در آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.14,
   "end": 132.42,
   "text": "از مقوله‌ی فعل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.42,
   "end": 135.7,
   "text": "اینجا انفعال‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.7,
   "end": 139.04,
   "text": "اونجا فعل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.04,
   "end": 142.84,
   "text": "اینو من یه توضیح اجمالی عرض کنم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.84,
   "end": 147.1,
   "text": "و نتیجه بگیریم. خب این یه بحث مبثوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.1,
   "end": 151.86,
   "text": "فلسفی می‌طلبه. خب شاید در حوصله‌ی شماها نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.86,
   "end": 154.5,
   "text": "ولی با یه مثال فقط نتیجه‌گیری کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.5,
   "end": 158.94,
   "text": "ببینیم بالاخره نتیجه‌ی این کلمه پنجاه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.94,
   "end": 165.36,
   "text": "یا شصت و پنج چی می‌شه. اولاً یه جمله دو تا جمله براتون بخونم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.36,
   "end": 167.34,
   "text": "کتاب آموزش فلسفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.34,
   "end": 170.66,
   "text": "خدا رحمت کنه حضرت آقای مصباح رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.66,
   "end": 174.6,
   "text": "ایشون در خصوص همین بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.6,
   "end": 177.56,
   "text": "فعل که منشاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.56,
   "end": 180.26,
   "text": "عمل به هر حال این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.26,
   "end": 185.0,
   "text": "فعله یا انفعاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.0,
   "end": 190.04,
   "text": "در خصوص فعل می‌فرماید حالت به وجود آمده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.04,
   "end": 195.28,
   "text": "دقت بفرمایید، حالت به وجود آمده برای شیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.28,
   "end": 200.0,
   "text": "که از تاثیر تدریجی فاعل مادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.0,
   "end": 206.82,
   "text": "در ماده، در ماده‌ی منفعل حاصل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.82,
   "end": 210.42,
   "text": "یعنی چی؟ اولاً تدریجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.42,
   "end": 212.88,
   "text": "تدریج مال عالم ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.88,
   "end": 218.44,
   "text": "می‌گه اون حالتی که حالت فعلی نه انفعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.44,
   "end": 222.42,
   "text": "داریم مقایسه می‌کنیم بین فعل و انفعال رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.42,
   "end": 226.48,
   "text": "چون علامه می‌فرما دردها و لذت‌های دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.48,
   "end": 229.32,
   "text": "از مقوله‌ی انفعاله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.32,
   "end": 231.24,
   "text": "آخرت از مقوله‌ی فعله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.24,
   "end": 234.52,
   "text": "حالا می‌خوایم ببینیم اصلا اینا فرقشون در چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.52,
   "end": 236.74,
   "text": "آقای مصباح در کتاب آموزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.74,
   "end": 239.9,
   "text": "فلسفه‌شون می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.9,
   "end": 244.02,
   "text": "مقام فعل یا مقوله‌ی فعلی بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.02,
   "end": 247.88,
   "text": "تاثیرگذاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.88,
   "end": 254.08,
   "text": "مثل آفتاب مثالی که علامه طباطبایی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.08,
   "end": 257.46,
   "text": "بیدایت‌ال-- نهایت الحکمه می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 257.46,
   "end": 260.94,
   "text": "می‌فرما تاثیر آفتاب در آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 260.94,
   "end": 264.86,
   "text": "به تدریج و رفته رفته آب رو گرم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.86,
   "end": 269.22,
   "text": "چی؟ تاثیر چی در آب، آب رو گرم کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.22,
   "end": 273.34,
   "text": "آفتاب. این می‌شه حالت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.34,
   "end": 276.12,
   "text": "اثرگذاری آفتاب در آب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.12,
   "end": 282.8,
   "text": "آبی که گرم شد. فعل آفتاب می‌شه گرم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.8,
   "end": 284.74,
   "text": "در کجا تاثیر گذاشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.74,
   "end": 287.68,
   "text": "در آب. آب گرم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.68,
   "end": 290.52,
   "text": "خورشید، آفتاب اینجا در مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.52,
   "end": 292.46,
   "text": "اثرگذاری‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.46,
   "end": 296.0,
   "text": "نه تأثر. مقامش اثره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.0,
   "end": 300.7,
   "text": "نه تاثیر گرفتن. یعنی آفتاب تاثیر می‌کنه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.7,
   "end": 302.74,
   "text": "آب، آب رو گرم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.74,
   "end": 306.32,
   "text": "به این می‌گن چی؟ از مقوله‌ی فعله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.32,
   "end": 308.62,
   "text": "یا ای فعل بهش می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.62,
   "end": 311.36,
   "text": "مقوله‌ی فعله، اثرگذاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.36,
   "end": 313.72,
   "text": "علامه می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.72,
   "end": 317.24,
   "text": "تو دنیا اینجوری نیست. لذت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.24,
   "end": 319.08,
   "text": "و دردها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.08,
   "end": 322.3,
   "text": "از مقوله‌ی انفعاله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 322.3,
   "end": 325.34,
   "text": "نه فعله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.34,
   "end": 327.5,
   "text": "فعل مقام اثره. انفعال چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.5,
   "end": 330.46,
   "text": "بالعکسش. اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.46,
   "end": 335.22,
   "text": "حالتی که در آب ایجاد می‌شه، تاثیر می‌گیره از آفتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.22,
   "end": 338.4,
   "text": "و گرم می‌شه به اون می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 338.4,
   "end": 340.98,
   "text": "انفعال. چیز عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.98,
   "end": 343.48,
   "text": "ظاهر عبارت یه مقدار چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 343.48,
   "end": 350.56,
   "text": "فلسفی حکمیه یه مقدار پیچیده به نظر می‌رسه آدم گیج می‌شه اما با یه مثال قصه حل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 350.56,
   "end": 353.98,
   "text": "پس آفتاب وقتی تاثیر می‌کنه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 353.98,
   "end": 357.74,
   "text": "آب و آب رو گرم می‌کنه، اینجا آفتاب مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 357.74,
   "end": 361.26,
   "text": "اثردهی یا مقام فعلی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 361.26,
   "end": 370.24,
   "text": "آب مقام تأثر، تأثیر گرفتن و مقام انفعالی داره در از، در مقوله‌ی انفعاله اینجا آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.24,
   "end": 374.42,
   "text": "مشخص شد دیگه. حالا در خصوص همین بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 374.42,
   "end": 381.42,
   "text": "انفعال هم باز حضرت علامه مصباح علیه الرحمه می‌فرما-- تع-تعریف مقوله‌ی انفعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 381.42,
   "end": 384.7,
   "text": "این شکلیه. انفعال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 384.7,
   "end": 388.0,
   "text": "حالت به وجود آمده برای شییی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.0,
   "end": 395.66,
   "text": "که از تأثر تدریجی ماده‌ی منفعل در برابر فاعل مادی حاصل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.66,
   "end": 399.26,
   "text": "اولاً ماده‌ست، ثانیاً تدریجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.26,
   "end": 402.56,
   "text": "اصلاً دار دار تدریجه، دار دار ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.56,
   "end": 405.28,
   "text": "به تدریج این اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.28,
   "end": 409.1,
   "text": "در مقام چی؟ تأثیر و تأثر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.1,
   "end": 413.52,
   "text": "حالا اما در آخرت علامه در این کلمه داره اینو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.52,
   "end": 416.38,
   "text": "در آخرت این چنین نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.38,
   "end": 418.68,
   "text": "که مقوله‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.68,
   "end": 428.12,
   "text": "چه لذت‌ها، چه درد و علم‌ها در آخرت از مقوله‌ی انفعال نیست ها حواست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 428.12,
   "end": 431.66,
   "text": "اونجا از مقوله‌ی فعله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.66,
   "end": 437.26,
   "text": "یعنی فعل نفس‌ته. می‌دونید یعنی چی این؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 437.26,
   "end": 441.44,
   "text": "یعنی اینکه هرچه آدم در آخرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.44,
   "end": 447.82,
   "text": "درد بچشه، درد ببینه، عذاب ببینه، عقوبت‌ش کنن یا به عکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.82,
   "end": 453.62,
   "text": "انشاالله لذت ببره، غرق در نعمت و لذت باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.62,
   "end": 456.66,
   "text": "هرچه که اونجا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 456.66,
   "end": 459.2,
   "text": "نفس داره کیف می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.2,
   "end": 463.24,
   "text": "یا اذیت می‌شه، همش از مقوله‌ی فعله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 463.24,
   "end": 473.78,
   "text": "فعل نفس خودشه، نه از بیرون از او یه آتشی بسوزونتش که این حالت تأثر پیدا کنه بشه مقام یا مقوله‌ی انفعال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 473.78,
   "end": 476.82,
   "text": "توجه کردی چی شد؟ نتیجه‌ش چقدر قشنگ می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.82,
   "end": 480.92,
   "text": "فهمش خیلی خوبه. یه بار دیگه عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 480.92,
   "end": 485.08,
   "text": "یعنی تو بهشت آقا، تو بهشت کسی اصلاً بگیم رفت بهشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.08,
   "end": 488.6,
   "text": "تو بهشت اونچه ش، اونچه که می‌چشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.6,
   "end": 490.22,
   "text": "در مقام انفعال نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.22,
   "end": 493.44,
   "text": "یعنی از بیرون از او لذتی به او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 493.44,
   "end": 499.6,
   "text": "ارائه نمی‌شه. لذتی از بیرون نیست که این تأثر پیدا کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.6,
   "end": 503.32,
   "text": "بلکه خودش در مقام فعلیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 503.32,
   "end": 508.04,
   "text": "در مقام اثره. خودش در خودش اثر می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 508.04,
   "end": 515.58,
   "text": "خودش یعنی در حقیقت این، اون جمله‌ای که بارها گفتیم یعنی خودش شده بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 515.58,
   "end": 517.72,
   "text": "لذت‌های دنیا چ-چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 517.72,
   "end": 524.5,
   "text": "اولاً تدریجیه. به تدریج آدم حالش خوش می‌شه، به تدریج حالش بد می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 524.5,
   "end": 529.1,
   "text": "به تدریج درد هی شدت می‌گیره یا افت پیدا می‌کنه و به عکس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 529.1,
   "end": 532.38,
   "text": "اونجا اینطوری نیست. اونا اونجا آنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 532.38,
   "end": 534.86,
   "text": "اونا، اونجا اصلاً تدریج معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.86,
   "end": 537.04,
   "text": "تدریج دار دار ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 537.04,
   "end": 540.34,
   "text": "اونجا مجرده. تدریجی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.34,
   "end": 543.36,
   "text": "آنیه. یک آن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 543.36,
   "end": 545.18,
   "text": "\"وما أمرنا إلا واحدة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 545.18,
   "end": 547.8,
   "text": "امر الهی به وحده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.8,
   "end": 550.28,
   "text": "اصلاً همه چی وحدته اونجا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.28,
   "end": 555.74,
   "text": "تحت تدبیر متفرد به جبروت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 555.74,
   "end": 558.44,
   "text": "آننه. تدریجی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 558.44,
   "end": 564.24,
   "text": "که حالا یکی تو بهشت هی رفته، رفته، هی حالش خوب شه، حالش خوش شه، هی لذت بیشتر، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 564.24,
   "end": 567.44,
   "text": "آنن می‌چشه. اصلاً تدریج معنا نداره اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 567.44,
   "end": 570.52,
   "text": "هرچی که هست از مقوله‌ی فعله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 570.52,
   "end": 573.22,
   "text": "آنن بعد این فعلم در درون خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 573.22,
   "end": 578.0,
   "text": "خودشه. یعنی همون چیزی که بارها عرض کردیم علامه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 578.0,
   "end": 581.6,
   "text": "که بهشتی خودش بهشت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 581.6,
   "end": 584.66,
   "text": "جهنمی خودش جهنم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 584.66,
   "end": 587.82,
   "text": "آتش فعل نفس خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 587.82,
   "end": 591.98,
   "text": "حرارت، نیران، فعل نفس خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 591.98,
   "end": 600.98,
   "text": "اون عذاب، عقوبت، اون فشار، اون ظلمت، اون تنگی، اون نیش عقرب و مار و افعی و کجدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.98,
   "end": 605.8,
   "text": "فعل نفس خودشه. اثر خودش به خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 605.8,
   "end": 609.88,
   "text": "بیرون از خودش کجدم و مار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 609.88,
   "end": 615.98,
   "text": "اینکه بعضی از بزرگان دست شاگرداشون رو گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 615.98,
   "end": 618.34,
   "text": "گفتن بریم این همه می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 618.34,
   "end": 622.82,
   "text": "قبرستان تو قبر پر می‌شه از مار و کجدم بریم ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 622.82,
   "end": 626.08,
   "text": "رفتن نگاه کردن داخل قبر دیدن هیچی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 626.08,
   "end": 630.26,
   "text": "گفت که اینجا که خبری از مار و کجدم و افعی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 630.26,
   "end": 633.88,
   "text": "خاکه. می‌خواست به اونا چی رو برسونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 633.88,
   "end": 638.48,
   "text": "که اونجا اینطوری نیست که از بیرون یه مار بیاد نیشت بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 638.48,
   "end": 642.62,
   "text": "نه، از درون خودت به خودت نیش می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 642.62,
   "end": 647.94,
   "text": "اصلاً خودت می‌شی بهشت. اینجا لذت‌های دنیایی چجوریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.94,
   "end": 653.28,
   "text": "ما در مقام انفعالیم. از بیرون یه چیزی ما رو به ما یا لذت می‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 653.28,
   "end": 656.24,
   "text": "یا معذب‌مون می‌کنه، عذاب‌مون می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 656.24,
   "end": 659.26,
   "text": "اونجا اینطوری نیست. دیگه هرچی هست خودمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 659.26,
   "end": 664.0,
   "text": "حالا اگر کسی تو این نشئه، دقت بفرمایید اینا نکته مهمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.0,
   "end": 666.52,
   "text": "اینو دیگه توضیح نمی‌دم چون فرصت گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 666.52,
   "end": 672.7,
   "text": "تو این نشئه از تعلق کنده شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 672.7,
   "end": 676.9,
   "text": "و منتقل شد به اون رتبه‌های اخروی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 676.9,
   "end": 678.86,
   "text": "به عالم مثال، به عالم عقول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 678.86,
   "end": 681.72,
   "text": "یعنی همین جا مثلاً خوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 681.72,
   "end": 685.14,
   "text": "یکی از معانی فرمود \"ان النوم اخو الموت\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 685.14,
   "end": 689.72,
   "text": "وقتی خوابید یا انصراف از نشئه طبیعت براش ایجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 689.72,
   "end": 692.62,
   "text": "مثلاً کشفی براش اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 692.62,
   "end": 694.68,
   "text": "تو همین جاست، تو دنیاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 694.68,
   "end": 697.42,
   "text": "تو عالم ماده‌ست. اما بهشت رو دید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 697.42,
   "end": 700.7,
   "text": "جهنم رو دید، بهشت رو چشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 700.7,
   "end": 703.46,
   "text": "جهنم رو چشید. این چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 703.46,
   "end": 705.44,
   "text": "اینم از همون مقام فعله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 705.44,
   "end": 710.58,
   "text": "فعل نفس خودشه. چگونه است که شما اینطور خواب می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 710.58,
   "end": 714.66,
   "text": "یه کس دیگه‌ای خوابید. آقا شما الان از اینجا خوابید پا شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 714.66,
   "end": 716.78,
   "text": "یه کس دیگه بیاد همین جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 716.78,
   "end": 719.3,
   "text": "و همون ساعتی که شما خواب بودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 719.3,
   "end": 723.08,
   "text": "همین جا بخوابه. چرا یه خواب دیگه‌ای دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 723.08,
   "end": 725.34,
   "text": "اصلاً همین الان همه بخوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 725.34,
   "end": 727.92,
   "text": "چرا همه مختلف خواب می‌بینن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 727.92,
   "end": 731.08,
   "text": "چون فعل نفس خودشونه. انشاء نفس خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 731.08,
   "end": 734.46,
   "text": "مطلقاً ها هرچی که می‌بینن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 734.46,
   "end": 736.68,
   "text": "انشاء نفس خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 736.68,
   "end": 740.52,
   "text": "اون منشأات، اون صورت و شکل‌ها در درون خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 740.52,
   "end": 745.42,
   "text": "بیرون از خودشون نیست که. بیرون از شما نیست اون چیزی که تو خواب داری می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 745.42,
   "end": 747.86,
   "text": "پس می‌شه توی ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 747.86,
   "end": 755.88,
   "text": "در کالبد جسم بود، در عالم ماده بود اما منصرف شد از عالم ماده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 755.88,
   "end": 758.44,
   "text": "و اون احکام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 758.44,
   "end": 760.9,
   "text": "فعلیت رو نه انفعال رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 760.9,
   "end": 763.58,
   "text": "چشید، رسید آناً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 763.58,
   "end": 765.78,
   "text": "یا می‌بینی طرف یک آن چشش رفت رو هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 765.78,
   "end": 770.34,
   "text": "برای شما پیش نیومده؟ یه آن از شدت خستگی یه دفعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 770.34,
   "end": 772.58,
   "text": "چشت میره رو هم میخوای بیفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 772.58,
   "end": 775.78,
   "text": "یه دفعه می‌بینی اندازه یک ساعت مطلب دیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 775.78,
   "end": 778.5,
   "text": "اندازه یک روز بلکه یک سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 778.5,
   "end": 780.62,
   "text": "بعضیا می‌بینی مطلب می‌بینن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 780.62,
   "end": 784.94,
   "text": "موضوع بهشون ارائه می‌شه، القا می‌شه بهشون، حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 784.94,
   "end": 789.5,
   "text": "مثلاً پیغمبر رحمة العراج اومد به نظر شما چقدر طول کشید از جهت تدریجی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 789.5,
   "end": 797.16,
   "text": "تدریج، زمان، ماده؟ خودشون فرمودن که وقتی برگشتن خب داشتن تشریف می‌بردن این رداشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 797.16,
   "end": 801.56,
   "text": "عبای مبارکشون گیر کرد به اون ابریق حالا پارچ هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 801.56,
   "end": 812.86,
   "text": "که توش آب بود. این برگشت حضرت رفت اون همه عوالم رو طی کرد برگشت هنوز آب این ابریق داشت می‌ریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 812.86,
   "end": 816.82,
   "text": "مثلاً آنی رفت این همه عالمو برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 816.82,
   "end": 819.2,
   "text": "اونجا که دیگه زمان نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 819.2,
   "end": 821.68,
   "text": "اون دیگه فعل نفس خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 821.68,
   "end": 826.72,
   "text": "چرا پیغمبر وقتی منصرف می‌شه از این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 826.72,
   "end": 829.58,
   "text": "همه عوالم هستی در محضرشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 829.58,
   "end": 832.34,
   "text": "ولی من که منصرف بشم از این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 832.34,
   "end": 835.4,
   "text": "\"فکشف عن که قطاع که\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 835.4,
   "end": 837.38,
   "text": "اون پرده‌ای که قطاع که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 837.38,
   "end": 841.2,
   "text": "تو خودت ایجاد کردی برش داشتیم \"فبصر کل یوم حدید\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 841.2,
   "end": 844.88,
   "text": "چشمت تیز می‌شه، لال می‌شی، لال مونی می‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 844.88,
   "end": 848.3,
   "text": "می‌گه در سرازیری قبر علی به فردا برسه نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 848.3,
   "end": 850.46,
   "text": "لال نمیري بلند فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 850.46,
   "end": 854.04,
   "text": "این چیه؟ چرا لال می‌شم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 854.04,
   "end": 857.58,
   "text": "به جهت اینکه اینجا منصرف شدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 857.58,
   "end": 861.3,
   "text": "اما نفسم طاقت و کشش اون رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 861.3,
   "end": 863.8,
   "text": "فعل نفسمه، نفسم ضعیفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 863.8,
   "end": 869.8,
   "text": "نمی‌تونه. و وقتی که مرتبط می‌شه با حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 869.8,
   "end": 875.76,
   "text": "می‌بینی که حقایق بر مخ-- بر خلاف میل منه اون چیزی که داره برای من کشف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 875.76,
   "end": 878.22,
   "text": "آقا خلاصه، خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 878.22,
   "end": 880.12,
   "text": "درس چند بود؟ شصت و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 880.12,
   "end": 883.2,
   "text": "خلاصه اینکه آقا، اونور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 883.2,
   "end": 887.68,
   "text": "حتی اینجا اگه ما منصرف بشیم چه بخوابیم چه حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 887.68,
   "end": 890.22,
   "text": "هر حالت کشفی برامون حاصل بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 890.22,
   "end": 894.42,
   "text": "مطلقاً هرچی هست از نفس خودمونه از بیرون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 894.42,
   "end": 896.74,
   "text": "پس بهشت خودمونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 896.74,
   "end": 899.2,
   "text": "حشر و نشر خودمونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 899.2,
   "end": 905.54,
   "text": "عذاب قبر خودمونیم، نکیر و منکر خودمونیم، اصلاً قبر خودمونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 905.54,
   "end": 907.52,
   "text": "بهشت و جهنم هم خودمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 907.52,
   "end": 912.12,
   "text": "همین. چقدر قشنگ علامه تو این جمله این مطلب رو جمع کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 912.12,
   "end": 916.3,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 916.3,
   "end": 923.32,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}