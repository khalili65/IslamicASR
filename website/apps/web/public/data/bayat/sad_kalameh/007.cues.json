 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ ششم؛ تمثلاتِ ملکی و اشباحِ خیالی",
   "start": 11.3,
   "end": 76.54
  },
  {
   "index": 1,
   "title": "## نفسِ ناطقه؛ مجرّد و موطنِ باطن",
   "start": 76.54,
   "end": 137.48
  },
  {
   "index": 2,
   "title": "## نور و سایه؛ مدّ الظل و کل یوم هو فی شأن",
   "start": 137.48,
   "end": 228.92
  },
  {
   "index": 3,
   "title": "## روایات؛ ضیف و عاریه",
   "start": 228.92,
   "end": 251.38
  },
  {
   "index": 4,
   "title": "## کفی الظلال؛ امام سجاد و امیرالمؤمنین",
   "start": 251.38,
   "end": 362.8
  },
  {
   "index": 5,
   "title": "## بازگشت به کلمهٔ ششم",
   "start": 362.8,
   "end": 394.48
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 2.22,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.22,
   "end": 7.74,
   "text": "神 استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.74,
   "end": 11.3,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.3,
   "end": 16.06,
   "text": "کلمه ششم علامه می‌فرمایند که آن که در صغری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.06,
   "end": 22.08,
   "text": "ذات خود با تمثلات ملکی همدم و هم‌سخن نباشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.08,
   "end": 26.02,
   "text": "باید با چه اشباح و خیالات هم‌ذهن باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.02,
   "end": 28.98,
   "text": "اشباح و خیالات مرتبه مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.98,
   "end": 34.56,
   "text": "مرتبه خیال کسی که خیالاتی زندگی می‌کنه و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.56,
   "end": 37.0,
   "text": "تمثلات ملکی شکل نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.0,
   "end": 39.06,
   "text": "ملکی عالم عقوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.06,
   "end": 42.08,
   "text": "مرتبه مافوق وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.08,
   "end": 44.92,
   "text": "در حقیقت علامه داره میگه اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.92,
   "end": 48.74,
   "text": "از ظاهر خودش به باطن خودش سفر نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.74,
   "end": 54.66,
   "text": "و دستش به عقل وجود خودش نرسیده و داره صرفا خیالی زندگی می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.66,
   "end": 58.58,
   "text": "این اشباح و خیالاتی که می‌بینه این‌ها به چه دردش می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.58,
   "end": 61.18,
   "text": "آیا اینا براش کار می، می‌رسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.18,
   "end": 67.78,
   "text": "در حالی که باید به گونه‌ای عمل کنه که اون هم در صغری ذات خودش، در درون خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.78,
   "end": 72.32,
   "text": "به تمثلات ملکی برسه و همدم و هم‌سخن باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.32,
   "end": 75.1,
   "text": "یعنی با عقل وجود خودش هم‌نشین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.1,
   "end": 78.46,
   "text": "سخن با عقل بگه. نفس ناطقه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.46,
   "end": 80.18,
   "text": "جنسش مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.18,
   "end": 83.3,
   "text": "سنخش مجرده، مربوط به نشئه طبیعت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.3,
   "end": 87.28,
   "text": "لذا اینجا هم نفس ناطقه در موطن خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.28,
   "end": 90.34,
   "text": "اگرچه در حسب ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 90.34,
   "end": 93.74,
   "text": "بدن که انزل مراتب نفس ناطقه است در دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 93.74,
   "end": 97.82,
   "text": "اما نفس ناطقه در باطن عالم سیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 97.82,
   "end": 101.18,
   "text": "یعنی جایگاه نفس ناطقه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 101.18,
   "end": 104.2,
   "text": "یا حالا بگیم همون عقل در باطن عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.2,
   "end": 106.44,
   "text": "لذا وقتی که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 106.44,
   "end": 109.2,
   "text": "این به، به نحو تمام یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 109.2,
   "end": 112.86,
   "text": "به هر حال بگیم اتم از این نشئه سفر کرد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 112.86,
   "end": 114.96,
   "text": "یعنی موت اتفاق افتاد. چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 114.96,
   "end": 118.42,
   "text": "چی می‌شه؟ سفر می‌کنه از ظاهر به باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 118.42,
   "end": 121.94,
   "text": "و میره اونجا نفس ناطقه خودش، خودش، خودش رو زیارت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 121.94,
   "end": 125.04,
   "text": "اونجا می‌شه يوم. يوم یعنی محل ظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 125.04,
   "end": 127.88,
   "text": "يوم ظهوره دیگه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 127.88,
   "end": 130.36,
   "text": "يوم ظرف ظهور اشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 130.36,
   "end": 132.78,
   "text": "يوم تبلی سرائر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 132.78,
   "end": 137.48,
   "text": "باطن‌ها آشکار می‌شه. اونجا دیگه اون باطن‌ها ظاهر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 137.48,
   "end": 140.72,
   "text": "چون موطن اصلی نفس ناطقه ما موطن اصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 140.72,
   "end": 142.9,
   "text": "قلب ما، عقل ما اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 142.9,
   "end": 145.52,
   "text": "اونجا دیگه اونا خودشونو نشون میدن، اینجا نشون نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 145.52,
   "end": 148.6,
   "text": "اینجا بدن داره چون نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 148.6,
   "end": 150.7,
   "text": "ازلال‌اند، سایه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 150.7,
   "end": 154.4,
   "text": "این سایه رو ما داریم می‌بینیم گمان می‌کنیم که اصل اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 154.4,
   "end": 158.98,
   "text": "در صورتی که خودمونم مشغول به این سایه کردیم متاسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 158.98,
   "end": 163.02,
   "text": "وقتی خورشید بالا میاد، حالا این خورشید وقتی بالا پایین می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 163.02,
   "end": 166.48,
   "text": "سایه هم کم و زیاد می‌شه. هرچی نور بیشتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 166.48,
   "end": 169.52,
   "text": "دقت کنید چی دارم عرض می‌کنم این خودش خیلی جای بحث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 169.52,
   "end": 173.28,
   "text": "هرچی نور بیشتر، سایه پررنگ‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 173.28,
   "end": 176.62,
   "text": "وقتی که نور کم و زیاد می‌شه، سایه کم و زیاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 176.62,
   "end": 179.98,
   "text": "تا جایی که یه دفعه می‌بینی اصلاً دیگه سایه محو شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 179.98,
   "end": 184.46,
   "text": "اون سایه اصله یا اون شاخصه که نور بهش ت-- می‌خوره و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 184.46,
   "end": 187.2,
   "text": "سایه رو ایجاد می‌کنه. سایه فرعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 187.2,
   "end": 191.32,
   "text": "سایه اصلاً وجود نداره. اصل اون شاخصه است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 191.32,
   "end": 195.56,
   "text": "نور خورشید بهش می‌خوره. یعنی شما اگر بگی ملام-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 195.56,
   "end": 201.38,
   "text": "عوالم مافوق رو، ملکوت رو بگیرید نور حضرت حق وقتی می‌خوره به اون عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 201.38,
   "end": 204.18,
   "text": "اون عالم سایه‌اش شده این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 204.18,
   "end": 207.24,
   "text": "بعد هی این سایه در حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 207.24,
   "end": 210.58,
   "text": "ألم تر إلى ربك كيف مد الدو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 210.58,
   "end": 212.86,
   "text": "یه معناش اینه معنای ظاهریش البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 212.86,
   "end": 219.2,
   "text": "این سایه دائماً در حال حرکته چون نور تجلیاتش آن به آن هود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 219.2,
   "end": 222.48,
   "text": "كل يوم كل يوم در هر ظهوری هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 222.48,
   "end": 225.44,
   "text": "في شأن. در یک شأن خاصیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 225.44,
   "end": 227.12,
   "text": "ما متاسفانه سایه رو گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 227.12,
   "end": 235.36,
   "text": "این حدیث رو دقت کنید از بحار جلد هفتاد، صفحه صد و هشتاد و هفت پیغمبر فرمودند أياها الناس به ما داره میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 235.36,
   "end": 237.4,
   "text": "إن من في الدنيا ضيف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 237.4,
   "end": 240.24,
   "text": "هرکس که تو این دنیاست مهمانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 240.24,
   "end": 245.6,
   "text": "و ما في أيديهم عارية اونچه که تو دستشونه عاریه‌ست، امانته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 245.6,
   "end": 248.18,
   "text": "یه چند صباحی اینجا مهمونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 248.18,
   "end": 251.38,
   "text": "و اینم عاریه‌ست دستشون. خودشون هم دست خودشون عاریه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 251.38,
   "end": 254.1,
   "text": "امام سجاد علیه السلام فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 254.1,
   "end": 257.06,
   "text": "خیلی عجیبه فرمایش حضرت که إن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 257.06,
   "end": 263.56,
   "text": "جميع ما طلعت عليه الشمس في مشارق الأرض و مغاربها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 263.56,
   "end": 269.44,
   "text": "بحرها وبرها وسهلها وجبلها تو دعای عهد می‌خونید اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 269.44,
   "end": 273.46,
   "text": "عند ولي من أولياء الله و أهل المعرفة بحق الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 273.46,
   "end": 278.28,
   "text": "می‌خوای به شما بگم هرچی که در این نشئه طبیعت شما دارید می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 278.28,
   "end": 279.96,
   "text": "چیه؟ به منزله چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 279.96,
   "end": 285.32,
   "text": "امام سجاد علیه السلام در کتاب توحف العقول صفحه سیصد و نود و یک می‌تونید آه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 285.32,
   "end": 288.2,
   "text": "حدیث رو ببینید. فرمود كفى الظلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 288.2,
   "end": 291.72,
   "text": "مثل یه سایه است. یعنی اصل چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 291.72,
   "end": 293.84,
   "text": "بعد شما خودتون رو مشغول این سایه کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 293.84,
   "end": 296.3,
   "text": "این یه شبحیه. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 296.3,
   "end": 299.38,
   "text": "سا-- این سایه یه شبحیه از اون اصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 299.38,
   "end": 305.82,
   "text": "بعد به جای اینکه شما متوجه اون عقل نظام هستی و عقل خودتون باشید، گرفتار این سایه شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 305.82,
   "end": 308.76,
   "text": "باز حالا مثلاً یه روایت دیگه بگم و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 308.76,
   "end": 314.92,
   "text": "مولامون علی علیه الصلاة والسلام باز در همون کتاب بحار جلد هفتاد، صفحه صد و هشتاد و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 314.92,
   "end": 318.28,
   "text": "می‌فرمود إنها عند ذوي العقول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 318.28,
   "end": 324.02,
   "text": "ذوي چی؟ عقول. اونایی که عقلشون رو پیدا کردن، دسترسی به عقلشون پیدا کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 324.02,
   "end": 326.2,
   "text": "كفى الظل بين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 326.2,
   "end": 330.52,
   "text": "تراه سابقاً حتى غلس و زائد حتى نقص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 330.52,
   "end": 333.1,
   "text": "می‌فرمود که نزد صاحبان عقول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 333.1,
   "end": 336.22,
   "text": "هرچی که شما دارید می‌بینید مثل یه سایه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 336.22,
   "end": 338.9,
   "text": "وقتی بهش نگاه می‌کنی سایه غلیظ می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 338.9,
   "end": 342.64,
   "text": "یه دفعه نگاه می‌کنی کمرنگ می‌شه، یه دفعه از-- ناپدید می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 342.64,
   "end": 345.2,
   "text": "همین حرکت و تردد دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 345.2,
   "end": 347.54,
   "text": "اینا همه کم و زیاد شدن سایه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 347.54,
   "end": 352.1,
   "text": "مولامون علی علیه الصلاة والسلام داره میگه از این سایه پی ببر به اون شاخصه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 352.1,
   "end": 356.06,
   "text": "به اون اصل و اون ملکوت. نور حضرت حق زده به اون ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 356.06,
   "end": 359.06,
   "text": "این شده سایه‌ش. بعد متوجه این سایه شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 359.06,
   "end": 360.66,
   "text": "چرا توجه به ملکوت نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 360.66,
   "end": 362.8,
   "text": "چرا توجه به عقلت نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 362.8,
   "end": 366.5,
   "text": "علامه در این کلمه شش می‌فرماید، یه بار دیگه کلمه رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 366.5,
   "end": 370.7,
   "text": "آن که در صغری ذات خود یعنی اون عالم عقل، ملکوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 370.7,
   "end": 373.68,
   "text": "این جبروت، لاهوت همه تو وجود خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 373.68,
   "end": 381.08,
   "text": "آن که در صغری ذات خود با تمثلات ملکی همدم و هم‌سخن نباشد، یعنی تمثلات عقلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 381.08,
   "end": 384.22,
   "text": "باید با چه اشباح و خیالات هم‌ذهن باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 384.22,
   "end": 387.86,
   "text": "خیالاتی زندگی می‌کنه. ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 387.86,
   "end": 390.9,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 390.9,
   "end": 394.48,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}