   "index": 0,
   "title": "## کلمهٔ سی‌وپنجم؛ سفرهٔ خطاب محمدی",
   "start": 12.42,
   "end": 131.32
  },
  {
   "index": 1,
   "title": "## حروف و تأویل امام رضا",
   "start": 131.32,
   "end": 370.28
  },
  {
   "index": 2,
   "title": "## قرآن حکیم؛ استحکام ترکیبات",
   "start": 370.28,
   "end": 486.72
  },
  {
   "index": 3,
   "title": "## علیکم بحسن الخط؛ ظاهر و باطن",
   "start": 486.72,
   "end": 572.86
  },
  {
   "index": 4,
   "title": "## ظاهر خط و باطن خزائن",
   "start": 572.86,
   "end": 604.18
  },
  {
   "index": 5,
   "title": "## باطن قرآن و کوتاهی دست",
   "start": 604.18,
   "end": 720.58
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.72,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.72,
   "end": 6.62,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.62,
   "end": 8.7,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.7,
   "end": 12.42,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.42,
   "end": 15.58,
   "text": "کلمه سی و پنجم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.58,
   "end": 21.98,
   "text": "آنکه خطاب محمدی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.98,
   "end": 26.48,
   "text": "که منظور قرآن است، منظور از این خطاب قرآن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.48,
   "end": 34.64,
   "text": "درست فهم کند که انسان‌ها برای اقتضای از این سفره الهی دعوت شده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.64,
   "end": 37.62,
   "text": "یعنی غذای انسان‌ها در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.62,
   "end": 44.22,
   "text": "قرآن جمع شده است. اگر کسی اینو دقت کنه قدر و مرتبت خود را شناسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.22,
   "end": 52.54,
   "text": "تازه می‌فهمه چه قدر و منزلتی دارد و در راه استکمالش پویا و جویا گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.54,
   "end": 57.42,
   "text": "اگر ما در مسیر استکمال نفس ناطقمون و سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.42,
   "end": 64.86,
   "text": "استکمالی‌مون حرکتی، جهشی، جنبشی، تلاشی نداریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.86,
   "end": 67.34,
   "text": "اون سعی و تلاش رو نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.34,
   "end": 78.1,
   "text": "به جهت اینکه بی‌خبریم از اینکه مقتضای ما اون غذاییه که خدا برای ما سر سفره‌ش گذاشته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 78.1,
   "end": 87.12,
   "text": "اون سفره هم قرآنه. قرآن که برای حیوانات نازل نشده، برای جمادات و نباتات و این‌ها حتی ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 87.12,
   "end": 91.08,
   "text": "نه. قرآن فقط برای انسان اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 91.08,
   "end": 94.92,
   "text": "انسان این ظرفیت رو داره که به قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 94.92,
   "end": 97.48,
   "text": "توجه کنه و از قرآن بهره بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.48,
   "end": 104.08,
   "text": "چرا؟ چون تمام حکما من جمله این استاد عزیز می‌فرمود غذای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 104.08,
   "end": 106.28,
   "text": "جان ما در قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.28,
   "end": 111.7,
   "text": "همونطور که ما فمی، دهانی داریم که غذای بدن ازش برمی‌داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 111.7,
   "end": 116.84,
   "text": "نان و آب می‌خوریم، دهان روح ما هم قبلاً عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 116.84,
   "end": 119.76,
   "text": "و اون کتاب شریف دهان روح رو هم توصیه کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 119.76,
   "end": 123.1,
   "text": "الحمدالله بعضی دوستان گرفتن خیلی به دردشون خورده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 123.1,
   "end": 125.7,
   "text": "خیلی جالب بود براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.7,
   "end": 129.42,
   "text": "میگه دهان روح گوشه، گوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 129.42,
   "end": 132.88,
   "text": "گوش بدی، گوش جان بدی به آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.88,
   "end": 136.4,
   "text": "و ما چون ندادیم، گوش جان ندادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.4,
   "end": 141.36,
   "text": "برای همین اینا رو خیلی شاید توجه و درک نکنیم که این قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.36,
   "end": 144.9,
   "text": "چگونه است. ببینید عالم، عالم ترکیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.9,
   "end": 148.94,
   "text": "یه مثال من بزنم. اصلاً نظام هستی، نظام ترکیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.94,
   "end": 153.96,
   "text": "قرآن می‌فرماید .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.96,
   "end": 161.3,
   "text": "همه چی رو خدا زوج زوج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 161.3,
   "end": 165.38,
   "text": "خلق کرده یا شما رو هم زوج زوج آفریدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 165.38,
   "end": 167.84,
   "text": "همه چی تزویرجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 167.84,
   "end": 171.02,
   "text": "ممزوجه، مزاج داره عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.02,
   "end": 173.04,
   "text": "همه چی ترکیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.04,
   "end": 176.04,
   "text": "منظور از این مزاج نه یعنی زن و شوهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.04,
   "end": 179.3,
   "text": "منظور ترکیبه. همه عالم ترکیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.3,
   "end": 182.02,
   "text": "خدا این چنین خواسته. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.02,
   "end": 185.08,
   "text": "بهترین ترکیب‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.08,
   "end": 192.06,
   "text": "صاحب این ترکیب‌ها خلق کرده یعنی به بهترین نوع این ازدواج رو، مزاج رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.06,
   "end": 199.42,
   "text": "انسان هم وقتی به قول شیخ الرئیس در نمت اشاراتش و وقتی که شما مزاجت به سمت اعتدال میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.42,
   "end": 201.14,
   "text": "کیفت کوک میشه به قول ماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.14,
   "end": 204.62,
   "text": "می‌بینی همه چی درسته، تنظیمه، حالت خوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.62,
   "end": 208.92,
   "text": "چرا؟ ترکیباتت درست به هم مرکب شدن، ترکیب شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.92,
   "end": 212.62,
   "text": "حتی ساعات عمرت، انا آنات عمرت داره با هم ترکیب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.62,
   "end": 217.96,
   "text": "داره با تو ترکیب میشه. حالا بحث مبثوثیه الان حوصله شما شاید نداشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.96,
   "end": 220.34,
   "text": "اما خیلی بحث شیرینیه البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 220.34,
   "end": 225.46,
   "text": "همه چی مرکبه. الان همه آی-- همین آیات قرآن برگرفته شده از چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.46,
   "end": 228.14,
   "text": "حروف. ما یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.14,
   "end": 232.2,
   "text": "حدیثی داریم اگر اشتباه نکنم در باب بیست و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.2,
   "end": 239.84,
   "text": "کتاب شریف توحید شیخ صدوق که شب‌های جمعه در بحث لقاء الله در هیئت یا زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.84,
   "end": 242.6,
   "text": "شرق تهران مبحثش رو باز کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.6,
   "end": 247.16,
   "text": "که اونجا امام رضا از قول جدشون امیرالمؤمنین شروع می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.16,
   "end": 251.92,
   "text": "این باطن و تأویل و خاصیت حروف رو بیان می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.92,
   "end": 254.32,
   "text": "مثلاً شأن نزول الف چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.32,
   "end": 257.62,
   "text": "شأن نزول به چیه؟ اصلاً به برای چی اومده تو این عالم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.62,
   "end": 260.0,
   "text": "حرف به. ف برای چی اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.0,
   "end": 265.62,
   "text": "تا برای چی؟ بعد خیلی شیرین، خیلی جالب که بعد می‌فهمیم که چرا بزرگان به حروف هم احترام می‌ذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.62,
   "end": 268.72,
   "text": "هیچوقت مثلاً روزنامه نمی‌انداختن زیرشون نماز بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.72,
   "end": 275.12,
   "text": "حرمت قائل بودند. که همین آیات قرآن از تزویرج همین حروف به وجود اومده دیگه از ترکیب این حروف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.12,
   "end": 279.38,
   "text": "یعنی مزاج قرآن از ترکیب این حروفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.38,
   "end": 282.86,
   "text": "اما به بهترین وجه ممکن، به بهترین شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 282.86,
   "end": 286.78,
   "text": "انسان هم از، از ترکیب عناصر چهارتاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.78,
   "end": 289.68,
   "text": "یه عالم آب و خاک و هوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.68,
   "end": 292.54,
   "text": "و گرمای آفتاب. این چهار تا با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 292.54,
   "end": 297.82,
   "text": "ترکیب شده. هرکی به بهترین وجه ترکیب شده یعنی برمی‌گرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.82,
   "end": 302.08,
   "text": "بعد از غص نزول ان لله که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.08,
   "end": 304.8,
   "text": "، همه مفتورن به فسرת الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.8,
   "end": 307.38,
   "text": "که همه یک شکلن، یک قسمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.38,
   "end": 314.22,
   "text": "اما اونجا دیگه برمی‌گردن مثل آبی که از آسمون اومد نازل شد برخورد می‌کنه به این هوای مابین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.22,
   "end": 316.0,
   "text": "به خودش رنگ و بو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.0,
   "end": 321.46,
   "text": "از رحم و سول به پدرها و مادرها و اجدادمون این رنگ و بو شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.46,
   "end": 325.1,
   "text": "یعنی ترکیبات دقت بفرمایید ترکیبات اونجا شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.1,
   "end": 331.26,
   "text": "چگونه ترکیب شد؟ چرا یکی سریع قرآن رو کلشو احص می‌کنه، یکی سختشه، یکی زود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.26,
   "end": 332.98,
   "text": "وصل میشه، یکی دیر وصل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 332.98,
   "end": 334.58,
   "text": "اینا همه برمی‌گرده به ترکیبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.58,
   "end": 339.02,
   "text": "même مزاج انسان که حیات مزاجی رو قبلاً فکر می‌کنم هشت جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 339.02,
   "end": 341.54,
   "text": "درباره‌ش حرف زدیم. تو کانال هست هنوزم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.54,
   "end": 345.26,
   "text": "از سرویس سرور اینتا پاک نشده اگر دوستان رجوع کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 345.26,
   "end": 352.28,
   "text": "خیلی بحث مهمیه حتی در سیر و سلوک و تهذیب نفس همین‌ها تأثیرگذارن که چون بحثش رو گفتیم دیگه من ورود نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 352.28,
   "end": 354.82,
   "text": "همین حروف و آیات قرآن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 354.82,
   "end": 357.78,
   "text": "از تزویرج و مزاج این حروف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.78,
   "end": 364.12,
   "text": "این حروف به همدیگه شده آیات قرآن، شده کلمات، جملات، آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 364.12,
   "end": 368.16,
   "text": "اما به بهترین وجه ممکن طوری که قرآن میگه محکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.16,
   "end": 370.28,
   "text": "یٰس والقرآن الحکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.28,
   "end": 372.4,
   "text": "از حکم و استحکام میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 372.4,
   "end": 377.18,
   "text": "حکیمه، محکمه. اهکم از آیات و کاملاً استحکام داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.18,
   "end": 381.56,
   "text": "محکم محکمه. بنا کاملاً استحکام داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 381.56,
   "end": 385.0,
   "text": "مولای درزش به قول ماها نمیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.0,
   "end": 388.46,
   "text": "و همه چی به تفصیل درش بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 388.46,
   "end": 390.78,
   "text": "چه در نشئہ طبيعت که کل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.78,
   "end": 398.18,
   "text": "کل شیء احصیناه فی امام مبین ای فی کتاب مبین یا ولا رتب ولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.18,
   "end": 400.48,
   "text": "یا بسن الله فی کتاب مبین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 400.48,
   "end": 404.62,
   "text": "چه در نشئہ طبیعت، چه اون بالا بالاها، لوح محفوظ، کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.62,
   "end": 408.78,
   "text": "کریم، کتاب مکنون، فی کتاب مکنون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 408.78,
   "end": 412.72,
   "text": "چه در ثغاء ذات حضرت حق که این علم از او گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 412.72,
   "end": 418.12,
   "text": "همه، همه و همه به بهترین وجه ممکن ترکیب شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 418.12,
   "end": 423.0,
   "text": "اومدن دست من و شما. شما الان غذایی که میخوای بخوری ترکیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.0,
   "end": 428.66,
   "text": "این ترکیبیه از چند تا مثلاً برنج و روغن و ادویه و چی و اینا رو میزنی به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 428.66,
   "end": 435.02,
   "text": "ببین اینم ترکیبه. غذای روح ما هم که تو قرآنه ترکیبه اما به بهترین وجه ممکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 435.02,
   "end": 442.62,
   "text": "لذا اونجا که امیرالمؤمنین علیه الصلاة والسلام فرمود «علیکم بحسن الخط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 442.62,
   "end": 447.2,
   "text": "علیکم بحسن الخط» بر شما باد به زیبایی خط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 447.2,
   "end": 454.26,
   "text": "حالا اتفاقاً از تعالمه هم این حدیث رو در آثارشون شرح دادن که من مفاتیح الرزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 454.26,
   "end": 458.18,
   "text": "این حسن خط از مفاتیح الرزقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 458.18,
   "end": 462.3,
   "text": "حضرت عالمهم اتفاقاً خیلی زیبا می فرمایند دو تا وجه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 462.3,
   "end": 472.78,
   "text": "یکی وجه ظاهرشه که مثال میزنن از، از استادشون حضرت فاضل تونی علیه الرحمة می فرماد که ایشون از شرح حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 472.78,
   "end": 475.14,
   "text": "میر عماد حسنی که یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 475.14,
   "end": 477.7,
   "text": "فقیر بودن، مشکلات داشتن نقل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 477.7,
   "end": 480.76,
   "text": "کی؟ استاد ما مثلاً مرحوم فاضل تونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 480.76,
   "end": 483.96,
   "text": "میگفت ایشون افتاد به خط نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 483.96,
   "end": 486.44,
   "text": "افتاد به خط نوشتن، خط زیبا نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 486.44,
   "end": 492.68,
   "text": "اینجا امیرالمؤمنین فرمود «علیکم بحسن الخط فإنّه من مفاتیح الرزق».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 492.68,
   "end": 495.48,
   "text": "خط رو زیبا بر شما باد و به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.48,
   "end": 500.06,
   "text": "به زیبایی خط که این از کلیدهای رزقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 500.06,
   "end": 503.04,
   "text": "ایشون فقیر بود. اومد دو تا نون نوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 503.04,
   "end": 508.46,
   "text": "دو تا نون حالا با خط. برد پیش مادرش گفت مادر کدوم یکی از اینا به نظرت خوشگل تره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 508.46,
   "end": 512.6,
   "text": "مادر داد زد سرش گفت ولمون کن بابا حالا به قول ما تو هم گیر آوردی ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 512.6,
   "end": 516.86,
   "text": "نه این نون نان میشه برا ما، نه این نون نان میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 516.86,
   "end": 519.24,
   "text": "برو دنبال نون، نان باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 519.24,
   "end": 521.86,
   "text": "این نونا چیه؟ خلاصه داد زد سرشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 521.86,
   "end": 524.86,
   "text": "اما علامه فرمود به مرور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 524.86,
   "end": 527.66,
   "text": "نون و سرش هم خیلی عجیبه حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 527.66,
   "end": 530.18,
   "text": "انشاالله فرصت های بعدی. نون والقلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 530.18,
   "end": 532.24,
   "text": "اینجا خدا نون رو آورده کنار چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 532.24,
   "end": 535.7,
   "text": "قلم. تو قرآن. نون والقلم وما یسترون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 535.7,
   "end": 538.7,
   "text": "اون صد صدری که نوشته میشه رزق تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 538.7,
   "end": 541.12,
   "text": "وقتیه که نون میاد کنار قلم قرار میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.12,
   "end": 544.12,
   "text": "اینا حالا اسراره که. خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 544.12,
   "end": 547.68,
   "text": "نون حالا اینطوری بگم آب و نون اهل قلم رو تضمین کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 547.68,
   "end": 550.92,
   "text": "اونم وما یسترون. صد صد نوشته از قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 550.92,
   "end": 554.84,
   "text": "ایشون میگه به همون وجه ادامه داد و خطش رو زیبا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 554.84,
   "end": 559.12,
   "text": "و از تعالمی فرمود به برکت مفتاح سر رو اینجا بیان کنه علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 559.12,
   "end": 567.16,
   "text": "به برکت مفتاح و ما یسترون که خدا صد صد مینویسه رزق و وقتی نون میاد کنار قلم اینا با هم میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 567.16,
   "end": 571.64,
   "text": "رزقشو زیاد کرد. بعد علامه فرمود این وجه باطنشو توجه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 571.64,
   "end": 576.28,
   "text": "وجه باطنش حسن الخط رو یعنی بهترین خط رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 576.28,
   "end": 578.28,
   "text": "بهترین ترکیب رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 578.28,
   "end": 580.94,
   "text": "نه ظاهرشو، باطنش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 580.94,
   "end": 584.44,
   "text": "همه چی هر چیزی در این عالم هست، خود حضرت علی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 584.44,
   "end": 586.5,
   "text": "یه ظاهر داره یه باطن. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 586.5,
   "end": 590.44,
   "text": "چون هو الاول والآخر والظاهر والباطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 590.44,
   "end": 594.5,
   "text": "چون او ظاهر و باطن دارد، همه چی کل شی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 594.5,
   "end": 596.12,
   "text": "همه چی ظاهر و باطن دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 596.12,
   "end": 598.48,
   "text": "یه پشه هم ظاهر باطن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 598.48,
   "end": 603.2,
   "text": "خطی هم که مینویسی این جوهر مرکب رو کاغذ اینم ظاهر و باطن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 603.2,
   "end": 609.76,
   "text": "ان من شیء ان دیگه فص الخطاب هیچ چیزی نیست الا عندنا خزائنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 609.76,
   "end": 612.4,
   "text": "بارها این آیه رو تلاوت کردیم قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 612.4,
   "end": 616.3,
   "text": "خزانه‌اش نزد ماست و ما نازله الا بقدر معلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 616.3,
   "end": 620.88,
   "text": "ما نازل نکردیم مگر به قدر به اندازه های معلومی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 620.88,
   "end": 623.1,
   "text": "که اون صعه وجودی تون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 623.1,
   "end": 626.88,
   "text": "این خط‌های قرآن هم، آیه های قرآن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 626.88,
   "end": 631.98,
   "text": "عزیزان دلم اینها هم اون ترکیباتشون یه باطنی رو مشخص کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 631.98,
   "end": 641.7,
   "text": "ما متاسفانه دستمون چون از باطن قرآن که ولی الله الاعظم اون اصل و سرچشمه و منبع این قرآن صورت کتبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 641.7,
   "end": 644.56,
   "text": "اونه، عالم آفاقی صورت عینی اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 644.56,
   "end": 648.24,
   "text": "چون دستمون از او کوتاهه است، متوجه این باطن نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 648.24,
   "end": 652.98,
   "text": "و الا این اصلاً حقیقت و باطن قرآن همون غذای ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 652.98,
   "end": 656.7,
   "text": "منتها چون دست ما کوتاهه است از همین ظاهر باید شروع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 656.7,
   "end": 662.2,
   "text": "خستتون نکنم ملاصدرا در کتاب مفاتیح الغیبش می فرمود توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 662.2,
   "end": 669.16,
   "text": "درسته که باید بریم از ظاهر عبور کنیم به باطن قرآن برسیم و غذای اصلی جان و روح ما در باطن قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 669.16,
   "end": 676.58,
   "text": "اما حواستون باشه همون نور لمعات و جمال الهی که در ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 676.58,
   "end": 681.64,
   "text": "ثغاء ذات کمون ذات حضرت حق است کشیده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 681.64,
   "end": 683.9,
   "text": "و ما نازله دیگه قرآن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 683.9,
   "end": 687.82,
   "text": "تا نازل شده است دیگه. انا انزلناه فی لیلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 687.82,
   "end": 694.12,
   "text": "اینم نازل شده. میگه همون نور، همون لمعات جمال کشیده شده اومده، اومده، اومده تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 694.12,
   "end": 697.3,
   "text": "همین خط قرآن که ظاهراً میبینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 697.3,
   "end": 703.84,
   "text": "یکی مثل حاج سید احمد کربلایی میبی-- میدید نور قرآن رو میگفت این قرآن، این قرآن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 703.84,
   "end": 706.6,
   "text": "چون طهارت نفس داشت که لا یمسّه الا المتهرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 706.6,
   "end": 708.94,
   "text": "یه کم مثل من نداره خستتون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 708.94,
   "end": 715.78,
   "text": "پس باید دیگه هرچی غذای واقعی برای وجودمون هست از قرآن اخذ کنیم والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 715.78,
   "end": 717.6,
   "text": "انشاالله که با قرآن مأنوس شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 717.6,
   "end": 720.58,
   "text": "صلوات بفرستیم. سلام بر محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}