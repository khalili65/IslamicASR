 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ هشتم؛ از سیرِ انفسی به سیرِ آفاقی",
   "start": 4.64,
   "end": 43.84
  },
  {
   "index": 1,
   "title": "## سه قرآن؛ برگرفته از خودِ کتاب",
   "start": 43.84,
   "end": 63.86
  },
  {
   "index": 2,
   "title": "## چشیدن؛ معرفتِ شهودی",
   "start": 63.86,
   "end": 148.22
  },
  {
   "index": 3,
   "title": "روایتِ مشهور است: من عرف نفسه فقد عرف ربّه. روایتِ دیگر: من عرف نفسه فقد عرف الأشیاء کلّها. چرا کلّها؟ زیرا قرآن فرمود:",
   "start": 148.22,
   "end": 258.0
  },
  {
   "index": 4,
   "title": "## عوالمِ چهارگانه در وجودِ انسان",
   "start": 258.0,
   "end": 362.54
  },
  {
   "index": 5,
   "title": "## شرطِ سیرِ آفاقی",
   "start": 362.54,
   "end": 389.02
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 4.64,
   "text": "ربانی آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.64,
   "end": 6.84,
   "text": "کلمه هشتم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.84,
   "end": 10.66,
   "text": "صد کلمه در معرفت نفس علامه رو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.66,
   "end": 13.82,
   "text": "فرمودن آنکه از سیر انفسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.82,
   "end": 16.92,
   "text": "به سیر آفاقی نرسیده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.92,
   "end": 20.3,
   "text": "چه چشیده و چه دیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.3,
   "end": 26.72,
   "text": "خب دو تا نکته اول اینکه متوجه می‌شیم باید از سیر انفسی یعنی شناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.72,
   "end": 31.3,
   "text": "خود و معرفت نفس برسیم به سیر آفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.3,
   "end": 39.34,
   "text": "از این آیت عظمای الهی که نفس ناطقه انسانه از شناخت این برسیم به اون آیات الهی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.34,
   "end": 42.6,
   "text": "در آفاق‌اند. این کلمات وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.6,
   "end": 48.66,
   "text": "حالا اینم که حکما و عرفا اینا میان مثلاً میگن سیر انفسیا اینم کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.66,
   "end": 50.78,
   "text": "قرآن آفاقی، قرآن انفسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.78,
   "end": 53.62,
   "text": "اینا بر گرفته از خود قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.62,
   "end": 58.96,
   "text": "از خودشون حرف نمی‌ذارن. کردیم که سنریهم آیاتنا آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.96,
   "end": 61.6,
   "text": "سنریهم چی؟ آیاتنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.6,
   "end": 63.16,
   "text": "ما می‌خوایم به اینا نشون بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.16,
   "end": 68.26,
   "text": "نشون خواهیم داد آیات خودمون رو به کج-- در کجا خدایا می‌خوای نشون بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.26,
   "end": 73.88,
   "text": "\"في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.88,
   "end": 78.9,
   "text": "پس این که میگن مثلاً ما سه تا قرآن داریم، قرآن آفاقی یا هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.9,
   "end": 84.64,
   "text": "قرآن انفسی یا جان انسان کامل و این قرآن کتب شده از همین آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.64,
   "end": 88.2,
   "text": "قرآن برداشت شده و حکما و عرفا از خودشون که نمیگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.2,
   "end": 91.12,
   "text": "که حالا اون جان انسان کامل اصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.12,
   "end": 94.0,
   "text": "این‌ها شرح، این‌ها فرع بر اون‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.0,
   "end": 96.62,
   "text": "اون متنه، این‌ها شرح اون‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.62,
   "end": 99.02,
   "text": "اون لفه، به هم پیچیده شده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.02,
   "end": 102.92,
   "text": "این‌ها منشره شده، باز شده‌ی اون هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.92,
   "end": 105.58,
   "text": "اصل اون جان انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.58,
   "end": 107.34,
   "text": "که حالا ما جزئی از اون کل هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.34,
   "end": 110.12,
   "text": "با شناخت خودمون می‌تونیم به اونجا برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.12,
   "end": 113.92,
   "text": "این نکته اول. نکته بعد فرموده باید چشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 113.92,
   "end": 117.62,
   "text": "چشید. چشیدن برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.62,
   "end": 121.8,
   "text": "رسیدنه. این‌که آدم یه جایی رو برسه به یه جایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 121.8,
   "end": 123.56,
   "text": "اما چشیدن فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 123.56,
   "end": 128.04,
   "text": "بداند، بداند با دارا شدن فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 128.04,
   "end": 130.48,
   "text": "چشیدن معرفت شهودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 130.48,
   "end": 132.36,
   "text": "یعنی تو شاهد بشی بر خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 132.36,
   "end": 137.58,
   "text": "این‌که شهید سلیمانی فرمود تا شهید نباشی شهید نمی‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 137.58,
   "end": 140.56,
   "text": "کسی شهید می‌شه که شهید بوده باشه یعنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 140.56,
   "end": 144.5,
   "text": "یعنی به شهود رسیده حداقل به خودش، خودش رو شناخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 144.5,
   "end": 147.62,
   "text": "و حالا جالب اینجاست که اینجا می‌فرماید خیلی نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 147.62,
   "end": 151.68,
   "text": "ظریفی رو علامه در این یه جمله اشاره کردن که آنکه از سیر انفقى--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 151.68,
   "end": 157.04,
   "text": "انفسی به سیر آفاقی نرسیده است، چه چشیده و چه دیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 157.04,
   "end": 160.92,
   "text": "این پیداست که سیر انفسی اصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 160.92,
   "end": 165.64,
   "text": "سیر انفسی متنه و اون بقیه شرحشن، جزئشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 165.64,
   "end": 169.66,
   "text": "و اگر کسی این رو نشناخت بقیه رو هم نشناخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 169.66,
   "end": 172.64,
   "text": "چی رو؟ نفس خودش رو. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 172.64,
   "end": 177.7,
   "text": "اصلا داریم من عرف نفسه همه اینو حفظید فقط عرف ربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 177.7,
   "end": 179.86,
   "text": "یکی دیگه هم داریم من عرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 179.86,
   "end": 182.94,
   "text": "نفسه فقط عرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 182.94,
   "end": 185.12,
   "text": "الأشیا كلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 185.12,
   "end": 187.96,
   "text": "عجب! چرا كلها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 187.96,
   "end": 191.92,
   "text": "چرا کسی خودش رو شناخت کل اشیا رو شناخته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 191.92,
   "end": 196.82,
   "text": "به جهت اینکه قرآن فرمود و علم آدم الأسماء كلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 196.82,
   "end": 199.94,
   "text": "علامه حسن زاده در دروس معرفت نفسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 199.94,
   "end": 205.96,
   "text": "می‌فرماید این اسماء رو وردار اشیا بذار به جهت تسهیل در فهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 205.96,
   "end": 208.66,
   "text": "می‌فرماید اسماء همین اشیااند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 208.66,
   "end": 214.02,
   "text": "همین ممکنات‌اند. بگو و علم آدم الأشیا كلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 214.02,
   "end": 218.3,
   "text": "یعنی تعلیم داد خدا به آدم همه اشیا رو تعلیم داد یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 218.3,
   "end": 224.44,
   "text": "یعنی علم فکری؟ یعنی بهش حفظ کرد مثلا حضرت آدم که چه اشیايي در عالمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 224.44,
   "end": 227.3,
   "text": "نه این بحث تحقق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 227.3,
   "end": 232.54,
   "text": "اشیاعه. یعنی تمام این اسم الله، اسماء الله که اشیااند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 232.54,
   "end": 234.16,
   "text": "همه تحقق شده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 234.16,
   "end": 237.48,
   "text": "تحقق، پیاده شدن در وجود انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 237.48,
   "end": 245.58,
   "text": "پس متوجه می‌شیم که نفس ناطقه انسانی چنان ظرفیتی دارد، ما متاسفانه از این ظرفیت بهره نگرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 245.58,
   "end": 250.7,
   "text": "چنان ظرفیتی دارد که تمام این عوالم هستی در اون مندمج‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 250.7,
   "end": 253.98,
   "text": "اگر کسی نفسش رو شناخت همه چیز رو شناخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 253.98,
   "end": 259.76,
   "text": "شما یه سیر معمولی تو وجود خودت می‌کنی می‌بینی عجب این مراتب خلقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 259.76,
   "end": 264.72,
   "text": "حالا می‌خوای مراتب رو به صورت کلی چهارگانه بگیر بگو عالم طبیعت، عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 264.72,
   "end": 268.0,
   "text": "ملکوت یا خیال یا مثال هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 268.0,
   "end": 270.64,
   "text": "عالم مثلاً جبروت یا عقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.64,
   "end": 274.68,
   "text": "ملائکه، ارواح، عالم قلب یا لاهوت، الهیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.68,
   "end": 276.96,
   "text": "این چهار تا عالم تو خود ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.96,
   "end": 278.76,
   "text": "ما هم یه طبیعت داریم، بدنمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 278.76,
   "end": 280.88,
   "text": "بعد قوه مثال، خیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 280.88,
   "end": 282.52,
   "text": "بعد قوه عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 282.52,
   "end": 284.16,
   "text": "بعد قل-قوه قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 284.16,
   "end": 285.88,
   "text": "همه اینا رو داریم. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 285.88,
   "end": 292.28,
   "text": "عوالمی که در بیرون هست در ما هم هست و تا ما اینا رو نشناسیم نمی‌تونیم با بیرون ارتباط بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 292.28,
   "end": 295.9,
   "text": "یا حتی مراتب خلقت خود از جهت خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 295.9,
   "end": 304.04,
   "text": "اشیا، جماد و نبات و حیوان و انسان و ملک و شیطان و همه اینا در ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 304.04,
   "end": 306.74,
   "text": "یعنی ما از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 306.74,
   "end": 308.48,
   "text": "نطفمون جمادی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 308.48,
   "end": 313.08,
   "text": "لذا این بدنمون که أنزلنا برته بنفس ناطقه است برمی‌گرده به چرخه طبیعت بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 313.08,
   "end": 317.04,
   "text": "بارها اینو عرض کردیم. یعنی ما جماد داریم در خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 317.04,
   "end": 320.06,
   "text": "ما نفس نباتی داریم، در رشдим.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 320.06,
   "end": 322.82,
   "text": "داریم رشد می‌کنیم. نفس حیوانی داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 322.82,
   "end": 326.56,
   "text": "نفس حیوانی داریم همین وهم ما حیوانیت وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 326.56,
   "end": 330.44,
   "text": "نفس انسانی داریم، عقل داریم، روح داریم، قلب داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 330.44,
   "end": 333.46,
   "text": "ملکی داریم، نفس ملکی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 333.46,
   "end": 335.82,
   "text": "و حتی شیطانی هم داریم. نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 335.82,
   "end": 338.72,
   "text": "اماره. إن نفس الامارة بسوء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 338.72,
   "end": 341.16,
   "text": "همه این‌ها در ما مندمجن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 341.16,
   "end": 343.4,
   "text": "در خودمون بهشت و جهنم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 343.4,
   "end": 345.26,
   "text": "در خودمون یزید و حسین داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 345.26,
   "end": 347.2,
   "text": "هر دو در با هم درگیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 347.2,
   "end": 350.84,
   "text": "باید مراقب باشیم حسین وجود ما به دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 350.84,
   "end": 354.04,
   "text": "یزید نفسمون به مسلخ نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 354.04,
   "end": 356.1,
   "text": "این حکمتشه که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 356.1,
   "end": 359.22,
   "text": "از اینجا متوجه می‌شیم که همه چی در درون ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 359.22,
   "end": 360.82,
   "text": "اگر خودمون رو شناختیم بیرون هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 360.82,
   "end": 367.24,
   "text": "یه جمله هم بگم والسلام. تمام عرفا فرمودن اینکه کسی خودش رو شناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 367.24,
   "end": 371.96,
   "text": "جایزش می‌شه سیر آفاقی یعنی از بیرون از خودش باخبر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 371.96,
   "end": 377.42,
   "text": "اگر کسی سیر انفسی نکرد یعنی خودش رو نشناخت از بیرون هم بی‌خبر خواهد ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 377.42,
   "end": 380.38,
   "text": "ان شاء الله عاقبتمون خیر بشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 380.38,
   "end": 382.54,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 382.54,
   "end": 385.54,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 385.54,
   "end": 389.02,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}