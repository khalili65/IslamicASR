 "chapters": [
  {
   "index": 0,
   "title": "## اقتدا در رکعت سوم و چهارم",
   "start": 29.08,
   "end": 132.54
  },
  {
   "index": 1,
   "title": "## کلمهٔ چهل‌وهشتم؛ سعادت نفس",
   "start": 132.54,
   "end": 283.98
  },
  {
   "index": 2,
   "title": "## ابدال و تصرف در ماده",
   "start": 283.98,
   "end": 373.24
  },
  {
   "index": 3,
   "title": "## انقیاد حیوانات؛ باغ وحش متوکل",
   "start": 373.24,
   "end": 400.7
  },
  {
   "index": 4,
   "title": "## خیال؛ آزمایشگاه ایجاد",
   "start": 400.7,
   "end": 828.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 7.86,
   "text": "لا حول ولا قوه الا بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.86,
   "end": 11.54,
   "text": "العلی العظیم. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.54,
   "end": 14.44,
   "text": "صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.44,
   "end": 20.72,
   "text": "اللهم صل علی محمد و آل محمد بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.72,
   "end": 25.86,
   "text": "السلام علیک ای داعی الله و ربانی ایه آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.86,
   "end": 28.9,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.9,
   "end": 32.84,
   "text": "ما در رکعت سوم و چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.84,
   "end": 39.26,
   "text": "امام در صورتی می‌تونیم قبل از رکوع امام بهش اقتدا کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.26,
   "end": 44.72,
   "text": "که مطمئن باشیم می‌رسیم سوره حمد رو حداقل بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.72,
   "end": 51.46,
   "text": "اگر کسی میدونه الان اگر اقتدا کنه رکعت سوم و چهارم امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.46,
   "end": 56.9,
   "text": "الان اگه اقتدا کنه نمی‌رسه سوره حمد رو بخونه به امام، به رکوع امام ملحق بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.9,
   "end": 59.4,
   "text": "نباید بخونه. باید چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.4,
   "end": 61.92,
   "text": "نباید اقتدا کنه. باید وایسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.92,
   "end": 64.74,
   "text": "تا امام بره در رکوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.74,
   "end": 68.04,
   "text": "به محض اینکه به رکوع رسید اقتدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.04,
   "end": 70.48,
   "text": "حالا سؤال اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.48,
   "end": 78.66,
   "text": "گمان کرد می‌رسه و الله اکبرو گفت شروع کرد سوره حمد رو خوندن دید امام رفت رکوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.66,
   "end": 81.88,
   "text": "چیکار باید بکنه؟ وظیفه اش اینه که حمد رو تموم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.88,
   "end": 86.16,
   "text": "نمی‌تونه وسط حمد رها کنه بره به رکوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.16,
   "end": 89.06,
   "text": "باید حمد رو تموم کنه. خب حالا سؤال بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.06,
   "end": 92.36,
   "text": "اومد این حمد رو تموم کنه امام از رکوع پا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.36,
   "end": 99.7,
   "text": "ایشون باید ادامه بده. باید حمد رو بخونه رکوعشو بخونه انجام بده بره به سجده امام برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.7,
   "end": 107.48,
   "text": "اگر به دو تا سجده امام نرسید چون دو تا رکع پشت سر هم از امام عقب افتاد دیگه نمازش فرادا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.48,
   "end": 110.54,
   "text": "دیگه باید به همون نیت فرادا خودش ادامه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.54,
   "end": 117.6,
   "text": "اما اگر به سجده امام و لو به یک سجده دوم و آخرین سجده امام رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.6,
   "end": 119.96,
   "text": "چون دو سجده با هم رکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.96,
   "end": 124.96,
   "text": "انشاالله دیگه جماعتش صحیحه و همونو با امام ادامه میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.96,
   "end": 130.56,
   "text": "چه- کلمه چهل و هشتم رو به فضل الهی امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.56,
   "end": 132.28,
   "text": "عرض می‌کنیم خدمت دوستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.28,
   "end": 138.82,
   "text": "دیگه فرصت انقدر کوتاهه که ما فقط در حد طرح بحثه دیگه ما بخونیم کلمه چی هست در معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.82,
   "end": 142.7,
   "text": "صد کلمه در معرفت نفس از علامه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.7,
   "end": 146.18,
   "text": "تا کلمه چهل و هفتش رو عرض کرده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.18,
   "end": 150.08,
   "text": "کلمه چهل و هشت. می‌فرماید \"آنکه در معنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.08,
   "end": 154.4,
   "text": "سعادت انسان درست نظر کند\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.4,
   "end": 157.32,
   "text": "دقت بفرمایید می‌خواد بگه سعادت انسان در چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.32,
   "end": 160.66,
   "text": "به نظر شما سعادت ما در چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.66,
   "end": 162.78,
   "text": "حالا علامه داره میگه در چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.78,
   "end": 166.46,
   "text": "اگه درست نگاه کنیم می‌فرماید که \"پیمی‌برد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.46,
   "end": 169.72,
   "text": "سعادت نفس انسانی این است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.72,
   "end": 177.02,
   "text": "از کمال وجودی خود در حد جواهر مفارق از ماده قرار گیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.02,
   "end": 182.92,
   "text": "تا در صدور افعالش مانند قوام ذاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.92,
   "end": 187.06,
   "text": "از ماده طبیعی بی‌نیاز گردد.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.06,
   "end": 192.36,
   "text": "الان توضیح میدم. می‌دونم یه ذره سنگین و ثقیل هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.36,
   "end": 196.84,
   "text": "بعد ایشون به عنوان نمونه فرمایش مولا علی رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.84,
   "end": 199.52,
   "text": "صلوات الله علیه. اون در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.52,
   "end": 202.02,
   "text": "قلعه خیبر رو حضرت کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.02,
   "end": 204.26,
   "text": "اینجا میاره اون رو فرمایش مولا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.26,
   "end": 207.7,
   "text": "اشاره به این موضوع می‌کنه که حضرت چگونه کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.7,
   "end": 212.66,
   "text": "در صورتی که هفتاد و پنج مرد جنگی فقط می‌تونستن این درو باز و بسته کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.66,
   "end": 217.8,
   "text": "بعد فرمایش خود حضرت رو میاره که حضرت می‌فرماید که قدتو بقوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.8,
   "end": 227.74,
   "text": "ملکوتیه. یعنی من مؤید بودم به قوه ملکوتی یعنی به قوه ربانی، ملکوتی، به نور نفس که از حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.74,
   "end": 229.32,
   "text": "این استظهار کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.32,
   "end": 231.72,
   "text": "این نور رو گرفته بود به نور رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.72,
   "end": 238.0,
   "text": "kendم این درو. نه به قوت جسمانی و غذایی و این بدنی، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 238.0,
   "end": 240.94,
   "text": "حضرت، حضرت علامه اینو داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.94,
   "end": 245.2,
   "text": "دلیل قرار میده بر اینکه پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.2,
   "end": 247.28,
   "text": "ربطی نداره به ماده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.28,
   "end": 252.86,
   "text": "سعادت انسان. سعادت انسان وقتی مشخص میشه که انسان سعادتمند شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.86,
   "end": 257.0,
   "text": "که مثل مولاش علی از دایره ماده خارج بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.0,
   "end": 260.78,
   "text": "یعنی بتونه کاری بکنه که نیازی به ماده نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.78,
   "end": 263.48,
   "text": "ماده اینجا چی بود؟ حضرت دستش بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.48,
   "end": 266.0,
   "text": "دست حضرت دیگه این کارو نکرده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 266.0,
   "end": 274.56,
   "text": "نور رب این درو کنده. می‌خواد بگه که سعادت انسان وقتیه که ما چنان فارغ بشیم از تعلقات مادی‌مون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.56,
   "end": 276.94,
   "text": "چنان از ظاهر پل بزنیم به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.94,
   "end": 278.5,
   "text": "موت قبل ان تموتو دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.5,
   "end": 280.66,
   "text": "سفر از ظاهر به باطن میشه موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 280.66,
   "end": 283.98,
   "text": "همینجا بمیریم یعنی همینجا بچشیم موت یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 283.98,
   "end": 288.02,
   "text": "چنان با ملکوط ارتباط برقرار کنیم که ملکوط کارهای ما رو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.02,
   "end": 294.24,
   "text": "ملکوط عالم. این یه مقدار برای انسان‌های مثل من که همش تو ماده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.24,
   "end": 296.86,
   "text": "لول، لولیدمو تو ماده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 296.86,
   "end": 300.52,
   "text": "کار کردم و اصلا فکرم خارج از ماده نشده سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 300.52,
   "end": 304.74,
   "text": "اما این رو حواسمون باشه که اینو خدا در وجود ما تعبیه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 304.74,
   "end": 307.46,
   "text": "اون مثال موبایل همراه، گوشی همراهی که زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 307.46,
   "end": 310.52,
   "text": "تو ما این توانمندی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 310.52,
   "end": 315.18,
   "text": "داره این کلمه اشاره به این توانمندی درون ما می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.18,
   "end": 319.08,
   "text": "یعنی تعجب نکنیم یه مرتضی مثلا یهو جلو قطار رو نگه می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.08,
   "end": 326.06,
   "text": "این چیزی نیست اصلا. این که نخود کیش میشه در برابر قدرتی که خدا در انسان قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.06,
   "end": 327.76,
   "text": "منتها باید انسان ظرفیت داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.76,
   "end": 330.16,
   "text": "شیپور دستش نگیره به جایی رسیده تو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.16,
   "end": 333.2,
   "text": "قرنا بکنه. یه مقدار، یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.2,
   "end": 340.4,
   "text": "مخالفت با نفس خیلی راحت با همین ریاضت شرعیه که کلمه بعد همین رو توضیح میده که چجوری میشه بهش رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.4,
   "end": 343.7,
   "text": "راحت میشه. اصلا من یه سؤال از شما بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 343.7,
   "end": 350.32,
   "text": "آقای مثلا میگن آقا از ماده کائنات بتونید تصرف کنید در ماده کائنات اصلا بیرون از محیط وجود خودت مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 350.32,
   "end": 353.12,
   "text": "صورت و شکل ایجاد کنی مثل ابدال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.12,
   "end": 357.14,
   "text": "اون گروه حلقه دومی که گرد حضرت هستن پنجاه و سه نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.14,
   "end": 362.5,
   "text": "ابدال، بدل انشایی از بدنشون ایجاد می‌کنند، ایجاد می‌کنند و میرن سر تا سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 362.5,
   "end": 365.22,
   "text": "دنیا هرجا کمک می‌کنند گرفتاران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.22,
   "end": 366.86,
   "text": "بعد طرف فکر می‌کنه امام عصر رو دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.86,
   "end": 370.6,
   "text": "نه یاران حضرتن. حضرت که سر و سر نظام هستیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.6,
   "end": 373.08,
   "text": "بیاد برای مثلا یکی مثل من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.08,
   "end": 376.98,
   "text": "هیچ طوری نیست که اون یاران از ابdal بدن انشایی می‌کنند به این مقام برسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.98,
   "end": 380.22,
   "text": "قدرت تصرف در ماده کائنات پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.22,
   "end": 383.56,
   "text": "من اگر سؤال کسی بیاد اینو رد کنه من به شو-- بهش اینو عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.56,
   "end": 387.18,
   "text": "اتفاقا این جمله رو همین چیزی که الان می‌خوام من عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 387.18,
   "end": 393.8,
   "text": "اگر خواستید ببینید مثلا حضرت آیت‌الله آشتیانی در شکاوه‌اش شاهد اول از مشهد چهارم آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.8,
   "end": 395.84,
   "text": "مفصل توضیح داده. چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.84,
   "end": 402.22,
   "text": "اینکه الان عرض می‌کنم. الان شما تو قوه خیالت که یکی از رتبه‌های وجودیت که دیروز عرض کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 402.22,
   "end": 407.9,
   "text": "در قوه خیال نمی‌تونی صورت و شکل الا ماشاالله هرچی که دوست داری ایجاد کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 407.9,
   "end": 412.82,
   "text": "خلق کنی، هر شکلی هر حتی چیزایی که موهوم‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 412.82,
   "end": 414.82,
   "text": "و اصلا وجود خارجی ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.82,
   "end": 417.02,
   "text": "مثلا صورت یه دیو رو تصور کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.02,
   "end": 420.22,
   "text": "می‌تونی این کارو بکنی یا نه؟ خب شما داری ایجاد می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.22,
   "end": 425.48,
   "text": "آنچه که در قوه خیالت و صورت می‌گیره، شکل می‌گیره، ایجاد نفس ناطقه خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.48,
   "end": 427.8,
   "text": "از بیرون که نیست که. کی اینو ایجاد کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 427.8,
   "end": 430.76,
   "text": "کی این صورت رو ایجاد کرد در وجود تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.76,
   "end": 432.6,
   "text": "در خودت همه اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 432.6,
   "end": 434.7,
   "text": "این قدرت نفس من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 434.7,
   "end": 441.38,
   "text": "چطور اینو باور داریم حالا بیرون از وجود خودمون رو باور نداریم بتونم صورت ایجاد کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.38,
   "end": 445.36,
   "text": "آره ممکنه. اونجایی که قرآن می‌فرماید \"لهم ما یشاءون فیها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.36,
   "end": 448.46,
   "text": "یعنی چی؟ تو بهشت براشون مهیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 448.46,
   "end": 451.5,
   "text": "یه جا می‌فرماید آنچه که \"ما یشتهون\" اشتها کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.5,
   "end": 455.28,
   "text": "یه جا می‌فرماید \"ما یشاءون\". هرچی که اراده کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 455.28,
   "end": 458.4,
   "text": "ایجاد می‌کنند. هرچی بخوان تو بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.4,
   "end": 460.58,
   "text": "این طور بعد حالا یکی اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.58,
   "end": 462.8,
   "text": "گفته که مثلا مثل یه عصا مثال زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.8,
   "end": 466.62,
   "text": "مثل یه عصایی که برداری رو زمین یه خط بکشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 466.62,
   "end": 473.36,
   "text": "با یه عصایی رو زمین یه خط بکشی مثلا این خطی که کشیدی بدل می‌شه مثلا به یه تیکه چوب یا چیزی که دوست داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 473.36,
   "end": 476.54,
   "text": "الان به طبع طبعای علیه الرحمه فرمودن همچین چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 476.54,
   "end": 478.82,
   "text": "اصلا نیازی نداره تو چیزی بکشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.82,
   "end": 481.96,
   "text": "ایجاد یعنی آنی که اراده کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.96,
   "end": 484.72,
   "text": "تمام. کن. میگی باش مقام عارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.72,
   "end": 489.24,
   "text": "فیکون پس می‌باشد. این قدرت خدا در وجود ما تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.24,
   "end": 492.6,
   "text": "ما ازش بی‌خبریم. پس می‌شه این کارو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 492.6,
   "end": 496.8,
   "text": "چرا ما از این‌ها دوریم؟ انقدر که تعلق به ماده پیدا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.8,
   "end": 499.56,
   "text": "چطور مولامون تونست؟ چطور پیغمبر تونست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.56,
   "end": 503.06,
   "text": "ش-- حالا اینا می‌گن حالا شما باید بگی آقا انسان کامل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.06,
   "end": 505.64,
   "text": "بابا می‌گم این‌ها، این‌ها نخود کیش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.64,
   "end": 512.36,
   "text": "یعنی بزرگان اهل معرفت ما شاگرداشون مثل شا-- اون سیصد تا شاگرد حاج ملا حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.36,
   "end": 514.74,
   "text": "حسین‌قلی احمدانی این کارا می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.74,
   "end": 516.92,
   "text": "آمیز جوقان علکی تبریزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.92,
   "end": 522.1,
   "text": "مت به اذن الله به اون معره گفت که می‌خواست طلبه‌ رو روش بزنه، مرد به اذن الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 522.1,
   "end": 524.24,
   "text": "تصرف کرد در ماده کائنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.24,
   "end": 527.7,
   "text": "اینا قدرت انسانه. ما ازش بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.7,
   "end": 531.88,
   "text": "ما متوجه نبودیم. یا اون جریان مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 531.88,
   "end": 535.56,
   "text": "چون یه بابی داره مرحو-مرحوم ابن شهرآشوب خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 535.56,
   "end": 538.16,
   "text": "شیرین این باب رو برید ملاحظه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.16,
   "end": 540.76,
   "text": "\"فی انقیاد الحيوانات له\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 540.76,
   "end": 547.58,
   "text": "در رابطه با اینکه حیوانات منقادند در برابر حجت خدا، انسان کامل و حتی انسان‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 547.58,
   "end": 550.46,
   "text": "مثل اهل بیت تام--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.46,
   "end": 555.34,
   "text": "اتم نیستند. یعنی چیز این تکمیل شدنشون اتم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 555.34,
   "end": 560.08,
   "text": "تمام هست اتم نیست. یعنی از همه بالاتر نیستند اما کامل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 560.08,
   "end": 564.52,
   "text": "مثل خیلی اولیای ما. میگه این‌ها هم حتی حیوانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 564.52,
   "end": 566.2,
   "text": "منقاد بر، بر، بر اینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 566.2,
   "end": 569.48,
   "text": "میان زانو می‌زنن. حیوانات وحشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.48,
   "end": 572.9,
   "text": "حتی. بعد اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 572.9,
   "end": 575.02,
   "text": "جریان چیز رو به عنوان نمونه میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 575.02,
   "end": 579.06,
   "text": "جریان تاریخیه که حالا در درس نود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 579.06,
   "end": 581.46,
   "text": "نسبه الامس ابن فناری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 581.46,
   "end": 584.74,
   "text": "حضرت علامه که می‌خواست شرحش بده اونجا میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 584.74,
   "end": 588.12,
   "text": "می‌گه حضرت علامه می‌فرماید \"دکت و صبا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 588.12,
   "end": 592.52,
   "text": "تو روایت تاریخ که من هم که سند که عرض کردم نگاه کردم نوشته برکت صبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 592.52,
   "end": 594.54,
   "text": "حالا دوتاش هم می‌شه می‌تونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 594.54,
   "end": 596.58,
   "text": "حالا به عنوان امروزی می‌گیم باغ وحش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 596.58,
   "end": 598.96,
   "text": "متوکل یه باغ وحشی داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 598.96,
   "end": 605.06,
   "text": "نردبان بود. می‌رفت با یه چاله خیلی بزرگ مثل دره طوری داشت توش پر حیوانات وحشی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 605.06,
   "end": 607.96,
   "text": "کسیو می‌خواست تنبیه کنه مینداخت اون تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 607.96,
   "end": 611.66,
   "text": "می‌گفت آقا شیر، آقا پلنگ، آقا گرگه اینا بخورنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.66,
   "end": 616.24,
   "text": "چی؟ اینا رو مینداخت. بعد حالا یه خانمی-- جریانش مفصله قطعا هم شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 616.24,
   "end": 619.64,
   "text": "یه خانمی ادعا کرد که برای اینکه پول بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 619.64,
   "end": 622.56,
   "text": "گفت من زینبم دختر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 622.56,
   "end": 624.96,
   "text": "امیرالمؤمنین، دختر حضرت زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.96,
   "end": 626.7,
   "text": "بعد متوکل خواستش گفت چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 626.7,
   "end": 628.64,
   "text": "چه جوری می‌تونی ادعاتو ثابت کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 628.64,
   "end": 634.78,
   "text": "گفت من پیغمبر برام دعا کرد هر چهل سال یه بار جوون شم و حرفای این چنینی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.78,
   "end": 638.44,
   "text": "بعد فقیر هم بود بدبخت این بهانه‌شو می‌خواست برای اینکه پول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 638.44,
   "end": 642.36,
   "text": "گیر، گیرش بیاد. بعد موندن چجوری ادعا-- بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 642.36,
   "end": 645.0,
   "text": "بالاخره پناه آورد به ایشون و گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 645.0,
   "end": 647.76,
   "text": "بالاخره من ذریه حضرت زهرا، ساداتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 647.76,
   "end": 650.06,
   "text": "بن العباس هم اول به بهانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 650.06,
   "end": 654.14,
   "text": "حمایت از سید الشهدا و ذریه پیغمبر بلند شدن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 654.14,
   "end": 656.6,
   "text": "قسم یاد کرد که تو در حمایت منی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 656.6,
   "end": 661.04,
   "text": "به این زنه گفت متوکل. بهش تو گوش متوکل گفتن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 661.04,
   "end": 663.62,
   "text": "حضرت امام هادی که هست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 663.62,
   "end": 666.96,
   "text": "ایشون که دیگه قطعا ذریه حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 666.96,
   "end": 669.24,
   "text": "ایشون رو دعوت کنید ببینید نظر ایشون چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 669.24,
   "end": 671.78,
   "text": "گفتن اومد ایشون و بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 671.78,
   "end": 674.36,
   "text": "حضرت فرمود که من یه راه حل دارم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 674.36,
   "end": 676.2,
   "text": "مشخص بشه ایشون-- البته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 676.2,
   "end": 679.0,
   "text": "داره دروغ میگه. گفتن چگونه ثابت کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 679.0,
   "end": 681.76,
   "text": "فرمود من یه راه حل دارم. اون هم اینکه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 681.76,
   "end": 684.92,
   "text": "دکت صبا یا برکت صبا که داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 684.92,
   "end": 689.42,
   "text": "حیوانات وحشی‌اند. خوردن گوشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 689.42,
   "end": 692.16,
   "text": "فرزندان فاطمه بر درندگان حرام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 692.16,
   "end": 696.48,
   "text": "بفرمایید خانمی که ادعا می‌کنید زینبید برید داخل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 696.48,
   "end": 701.68,
   "text": "بعد گفتن که اون ملعون گفتش که خب شما که دیگه ذریه حضرت زهرا هستی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 701.68,
   "end": 704.96,
   "text": "شما بفرمایید اول. بعد اون هدفش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 704.96,
   "end": 707.82,
   "text": "ضایع کردن امام بود. چون ف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 707.82,
   "end": 709.98,
   "text": "قبول نداشتن، باور نداشتن این چیزا رو که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 709.98,
   "end": 711.8,
   "text": "فکر کردن حالا حضرت یه چیزی گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 711.8,
   "end": 714.62,
   "text": "گفتن حالا شما خودتون بفرمایید. حضرت از نردبمون رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 714.62,
   "end": 716.56,
   "text": "بعد تمام مردم هم گفتن بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 716.56,
   "end": 720.74,
   "text": "مثلا ملعون متوکل فکر می‌کرد الان حضرت ضایع می‌شه عیزه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 720.74,
   "end": 723.12,
   "text": "جمع شدن‌ها. مفصله دیگه. حضرت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 723.12,
   "end": 725.46,
   "text": "نردبمون رفت پایین. بعد دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 725.46,
   "end": 727.26,
   "text": "چند تا شیر وحشی حمله کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 727.26,
   "end": 730.8,
   "text": "همه گفتن به به. دیگه الان کار حضرت رو می‌سازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 730.8,
   "end": 734.82,
   "text": "اومدن زانو زدن جلو حضرت دم تکون دادن، تبسبس کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 734.82,
   "end": 737.38,
   "text": "چونه‌شونو به خاک پای حضرت مالیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 737.38,
   "end": 740.5,
   "text": "بعد حضرت باهاشون صحبت کرد. رو کرد به شیرای دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 740.5,
   "end": 743.46,
   "text": "اشاره کرد. سریع کشیدنش بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 743.46,
   "end": 746.98,
   "text": "گفتن آقا شما دید آبروش داره میره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 746.98,
   "end": 751.14,
   "text": "بعد به اون زنه حالا گفتن اون افتاد به التماس و من غلط کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 751.14,
   "end": 753.32,
   "text": "فقر باعث شد من این کارو بکنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 753.32,
   "end": 755.84,
   "text": "هیچی. بعضیا می‌گن انداختنش همونجا شیرها خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 755.84,
   "end": 758.56,
   "text": "بعضیا می‌گن چون گفتن من در حم-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 758.56,
   "end": 760.12,
   "text": "در حمایت منی آزادش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 760.12,
   "end": 762.3,
   "text": "کاری نداریم. بعد از حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 762.3,
   "end": 768.84,
   "text": "یاران حضرت، شیعیان که بعدا حضرت بهشون گفت شما اونجا اشاراتی به این حیواناتون کردید، چی فرمودید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 768.84,
   "end": 773.36,
   "text": "گفت این شیر اول که اومد دندوناش دیگه داغون شده بود و ریخته بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 773.36,
   "end": 777.98,
   "text": "شیر پیر بود. به من التماس کرد که يا حجة بن رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 777.98,
   "end": 780.24,
   "text": "این شی-- آره غذا نه دعا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 780.24,
   "end": 783.6,
   "text": "این غذاهایی که می‌ریزن اینجا شیرها بخورین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 783.6,
   "end": 788.0,
   "text": "به من امان نمیدن. جوونن همه می‌ریزن زود می‌خورن به من پیرمرد نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 788.0,
   "end": 790.54,
   "text": "به اینای مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 790.54,
   "end": 792.7,
   "text": "آره یه سفارشی بکن هوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 792.7,
   "end": 798.48,
   "text": "پیرمردو داشته باشن. حضرت می‌فرمود که من داشتم به اونا سفارش می‌کردم که هوای این پیرو داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 798.48,
   "end": 802.68,
   "text": "بذارید اول این بخوره بعد. این چیز عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 802.68,
   "end": 807.44,
   "text": "این البته اصلا جزو مقامات انشایی اهل بیت هم به اون معنا خیلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 807.44,
   "end": 810.8,
   "text": "چون می‌گم کوچولو، کوچولوهاش به این‌ها می‌رسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 810.8,
   "end": 816.78,
   "text": "این‌ها چیزاییه که تصرفات در ماده کائنات در ما هست، ما ازش بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 816.78,
   "end": 820.8,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه و ما هم به این سعادت‌ها برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 820.8,
   "end": 828.18,
   "text": "صلوات ختم کنیم. الله- اللهumma صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}