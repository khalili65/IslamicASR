 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ شصت‌ودو؛ صاحب همت و انصراف از نشئه",
   "start": 13.48,
   "end": 145.56
  },
  {
   "index": 1,
   "title": "## نوم اخ الموت؛ سفر به لایه‌های وجود",
   "start": 145.56,
   "end": 207.64
  },
  {
   "index": 2,
   "title": "## تمثلات و حقایق بی‌تمثل",
   "start": 207.64,
   "end": 342.66
  },
  {
   "index": 3,
   "title": "## موضوعیت با خواب و غشوه و خوف نیست",
   "start": 342.66,
   "end": 362.92
  },
  {
   "index": 4,
   "title": "## حکایت چهل منزل زینب در بیداری",
   "start": 362.92,
   "end": 813.58
  },
  {
   "index": 5,
   "title": "## شیخ عباس تربتی و شهید همت",
   "start": 813.58,
   "end": 937.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 5.12,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.12,
   "end": 8.82,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.82,
   "end": 13.48,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.48,
   "end": 17.82,
   "text": "کلمه شصت و دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.82,
   "end": 20.98,
   "text": "آن که صاحب همت باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.98,
   "end": 26.92,
   "text": "و نفس را از اشتغال بدین نشئه انصراف دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.92,
   "end": 28.84,
   "text": "نشون میده که انصراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.84,
   "end": 33.12,
   "text": "نفس از این نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.12,
   "end": 35.44,
   "text": "که یکی از معانی موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.44,
   "end": 41.34,
   "text": "اصلاً موت یعنی نفس اعلام انصراف میکنه از نشئه مادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.34,
   "end": 43.7,
   "text": "و منتقل میشه به دار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.7,
   "end": 47.42,
   "text": "بعدی که انما تنتقلون من دارین الی دار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.42,
   "end": 50.06,
   "text": "پیغمبر عزیز عالم فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.06,
   "end": 51.8,
   "text": "اصلاً معنای موت یعنی همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.8,
   "end": 54.48,
   "text": "شما رو از داری به دار دیگه منتقل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.48,
   "end": 58.56,
   "text": "یه انتقاله، انتقاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 58.56,
   "end": 63.26,
   "text": "حالا اینجا حضرت علامه می فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.26,
   "end": 66.38,
   "text": "باید صاحب همت بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.38,
   "end": 70.06,
   "text": "تا قبل از اینکه بمیرانند تو را بمیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.06,
   "end": 76.5,
   "text": "معناش اینه. خودت اعلام انصراف بدی، منصرف بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.5,
   "end": 80.66,
   "text": "ولی باید اهل همت بود، اهل همت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.66,
   "end": 82.94,
   "text": "اهل همتم که میتونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.94,
   "end": 87.34,
   "text": "اما آدمی که نه سرسری گرفته، جدی نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.34,
   "end": 89.74,
   "text": "بارها اینو من عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.74,
   "end": 95.06,
   "text": "بخوایم تمام آنچه که ما این چند ساله بوده ده سال ما در خدمت شماییم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.06,
   "end": 98.98,
   "text": "حدوداً. همه رو بخواهیم توی جمله جمع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 98.98,
   "end": 105.44,
   "text": "میشه؟ توی جمله چند بار هم عرض کردم خدمت شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.44,
   "end": 110.72,
   "text": "که آقا جان اصلاً وجه اختلاف ما با اولیاء خدا اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.72,
   "end": 114.04,
   "text": "چرا اونا ولی خدا شدن ما نشدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.04,
   "end": 118.82,
   "text": "علتش اینه اونا جدی گرفتن حرف حق رو حضرت حق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.82,
   "end": 122.96,
   "text": "قبول کردن. ما نه، ما جدی نگرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.96,
   "end": 128.28,
   "text": "ما باور نکردیم. شک و تردید داشتیم و داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.28,
   "end": 132.16,
   "text": "لذا آدمی که همتش بلنده همینجا اعلام انصراف میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.16,
   "end": 137.7,
   "text": "موت قبل ان تموتو. سفر میکنه از ظاهر عالم به آخرت به باطن عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.7,
   "end": 141.42,
   "text": "از ظاهر خودش به باطن خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.42,
   "end": 145.56,
   "text": "مثل این که النوم اخ الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.56,
   "end": 147.64,
   "text": "خواب برادر موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.64,
   "end": 152.7,
   "text": "چرا برادر موت شده؟ یه وجه تشابهی بینش هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.7,
   "end": 156.44,
   "text": "وجهش اینه که وقتی میخوابی میری به لایه، یه لایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.44,
   "end": 158.34,
   "text": "پنهانی تر از وجود خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.34,
   "end": 161.58,
   "text": "میری به عالم مثال متصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.58,
   "end": 165.02,
   "text": "ببخشید در خودته. منفصل بیرون از خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.02,
   "end": 167.66,
   "text": "اونجایی که ارواح الان رفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 167.66,
   "end": 171.48,
   "text": "اونجا هستن. در خود ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.48,
   "end": 173.94,
   "text": "درسته؟ این یه سفره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 173.94,
   "end": 176.72,
   "text": "اصلاً موت یعنی همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 176.72,
   "end": 179.56,
   "text": "خواب رو تعالی بده ببرش بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.56,
   "end": 183.2,
   "text": "میشه همون. لذا فرمود اخ الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 183.2,
   "end": 191.4,
   "text": "این حضرت علامه توی این ابتدای جمله اینو میخواد تایید کنه که آقا اگه اهل همت باشی میتونی اینطوری بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.4,
   "end": 194.36,
   "text": "آدمی که جدی نگرفته به جایی نمیرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.36,
   "end": 200.32,
   "text": "لذا تأکید داره ایشون. آن که صاحب همت باشد، همینطوری رد نشو از جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.32,
   "end": 207.4,
   "text": "آن که صاحب همت باشد و نفس را از اشتغال بدین نشئه انصراف دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.4,
   "end": 215.04,
   "text": "حالا چه اتفاقی میفته؟ گاهی تمثلاتی در لوح نفس خود مشاهده کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.04,
   "end": 219.9,
   "text": "و گاهی حقایقی بی تمثل دریابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.9,
   "end": 224.6,
   "text": "یعنی مثالی براش نیست. بی تمثل حقایقی رو کشف میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.6,
   "end": 226.68,
   "text": "حقایقی رو استیضاح میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.68,
   "end": 228.94,
   "text": "اصطلاحاً میگیم میچشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.94,
   "end": 232.74,
   "text": "میرسه به یه حقیقتی. من یه چیزی رو الان به شما میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.74,
   "end": 235.54,
   "text": "تو کنون غیبت ذاتت تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.54,
   "end": 239.48,
   "text": "سقع نفست، تو باطنی‌ترین حالتت میگی آها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.48,
   "end": 242.22,
   "text": "حالا فهمیدم روشن شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.22,
   "end": 246.5,
   "text": "این یعنی چی آقا؟ یعنی در درون شما یه اتفاقی افتاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.5,
   "end": 250.6,
   "text": "یعنی از ملکوت یه چیزی رو گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.6,
   "end": 252.9,
   "text": "این یعنی میگه و گاهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.9,
   "end": 256.04,
   "text": "حقایقی بی تمثل دریابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.04,
   "end": 259.14,
   "text": "گاهی حقایق با تمثل مثل خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.14,
   "end": 264.38,
   "text": "صور و اشکال میبینی. یه چیزی رو، یه پیامی رو اخذ میکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.38,
   "end": 267.5,
   "text": "یه وقتم بی تمثله. اصلاً صور و شکل نمینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.5,
   "end": 273.42,
   "text": "در اون حقیقت غیبی خودت در مکمن غیبت یه چیزی رو میچشی، میفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 273.42,
   "end": 276.72,
   "text": "اصلاً چگونه است که تو امام حسین رو میچشی میتونی گریه کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.72,
   "end": 278.84,
   "text": "هزار و چهارصد سال گذشت تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.84,
   "end": 281.38,
   "text": "چگونه است که کئمعه همه الان کربلایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 281.38,
   "end": 285.22,
   "text": "یعنی همین. حالا گاهی اوقات با تمثله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.22,
   "end": 288.26,
   "text": "با صور و اشکاله، تو قوه خیالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.26,
   "end": 290.98,
   "text": "البته اینم مال آدمای کمی نیست ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.98,
   "end": 295.18,
   "text": "قوه خیال خیلی باید از متخیلات فاسده بری باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 295.18,
   "end": 299.38,
   "text": "خیلی باید متعالی باشه که بتونه صور و اشکال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.38,
   "end": 303.24,
   "text": "درست از کربلا به تو نشون بده و تو ت-- درک کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.24,
   "end": 306.6,
   "text": "بگیری قصه رو. کئمعه الان تو کربلایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.6,
   "end": 310.06,
   "text": "قوه خیال باید خیلی پاک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.06,
   "end": 314.08,
   "text": "آدمی که نمیتونه سیمش وصل بشه به کربلا قوه خیالش آلوده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 314.08,
   "end": 319.56,
   "text": "حالا بالاتر از اینم داریم. اصلاً بدون تمثل اصلاً نیاز به صور و شکل نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 319.56,
   "end": 322.12,
   "text": "اصلاً اون باطنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.12,
   "end": 325.12,
   "text": "مستقیم تو گودال قتلگاه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.12,
   "end": 327.42,
   "text": "میچشه حقیقت رو. اصلاً این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.42,
   "end": 332.72,
   "text": "کئمعه، این تیغ‌ها، این تیرها، این نیزه‌ها اینا به خود وجود اون داره میشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.72,
   "end": 335.1,
   "text": "حالا بماند. ادامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.1,
   "end": 345.86,
   "text": "کلمه رو بریم. خب پس گاهی تمثلات با مثال، گاهی بی مثال و از این حالت آگاهی یابد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 345.86,
   "end": 349.96,
   "text": "آنچه به آدمی در حالات نوم یعنی خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 349.96,
   "end": 354.94,
   "text": "و تنویم یعنی همون خواب مغناطیسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.94,
   "end": 362.92,
   "text": "و غشوه، یکی غش غش میکنه از خود بیخود میشه و خوف وقتی میترسه میریزه به هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.92,
   "end": 367.34,
   "text": "و احتضار حالت احتضار محتضر چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.34,
   "end": 371.16,
   "text": "که یه چشمش به این دنیاست یه چشمش به اون دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.16,
   "end": 379.32,
   "text": "\"و نظائر آنها روی می‌آورد.\" میگه اونچه که تو این حالات، توی این حالات به تو روی میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.32,
   "end": 385.56,
   "text": "هیچ یک خیلی مهمه این نکته‌ای که علامه داره القا می‌کنه به ما تو اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.56,
   "end": 392.86,
   "text": "هیچ یک موضوعیت در روی آوردن تمثلات و ادراکات دیگر ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.86,
   "end": 395.9,
   "text": "چی پس موضوعیت داره؟ میگه اصلا موضوعیت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.9,
   "end": 398.08,
   "text": "تو در حالت خا-خوابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.08,
   "end": 401.2,
   "text": "یا ترسیدی یا محتظری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.2,
   "end": 403.52,
   "text": "یا مثلاً قشف به دست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.52,
   "end": 405.78,
   "text": "اصلا اینا این حالات مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.78,
   "end": 408.86,
   "text": "اینا موضوعیت نداره. موضوعیت چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.86,
   "end": 414.46,
   "text": "می‌فرماید آنچه که موضوعیت دارد انصراف از نشئه عنصری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 414.46,
   "end": 417.28,
   "text": "نشئه عنصری یعنی این ماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 417.28,
   "end": 422.76,
   "text": "انصراف از اینجا. بی‌توجه، بی‌توجهی به عالم دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.76,
   "end": 427.96,
   "text": "و نشئه و اعراض از تعلقات این سویست آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.96,
   "end": 430.98,
   "text": "آقا هرچی ما می‌کشیم از این تعلقاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 430.98,
   "end": 432.64,
   "text": "یه بار دیگه این قص-قصه رو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.64,
   "end": 434.96,
   "text": "پس موضوعیت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.96,
   "end": 442.96,
   "text": "می‌فرماید آنچه که موضوعیت دارد انصراف از نشئه عنصری، انصراف از نشئه عنصری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.96,
   "end": 446.84,
   "text": "گفتیم موت یعنی منصرف شدن نفس از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.84,
   "end": 453.06,
   "text": "نشئه ماده. اونجا به اجبار با موت اضطراری و اجباری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.06,
   "end": 455.16,
   "text": "به اجبار این کارو باید انجام بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.16,
   "end": 459.78,
   "text": "میگه آقا موت قبل انتم تو قبل از اینکه به اجبار ببرنت بسم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.78,
   "end": 463.1,
   "text": "خودت منصرف شو از عالم ماده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 463.1,
   "end": 474.34,
   "text": "با ریاضات شرعیه. دوباره آنچه که موضوعیت دارد انصراف از نشئه عنصری و اعراض از تعلقات این سویست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 474.34,
   "end": 479.14,
   "text": "و چون انصراف در بیداری هم روی آورد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 479.14,
   "end": 482.54,
   "text": "تو بیداری آدم منصرف بشه از عالم ماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.54,
   "end": 485.24,
   "text": "اصلا اصلش اینه. نه تو خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.24,
   "end": 487.92,
   "text": "خواب که همه منصرف شدن رفتن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 487.92,
   "end": 490.92,
   "text": "عالم مثال متصل خودشون، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.92,
   "end": 496.18,
   "text": "برزخ وجودیشون. اون که همه میرن، کافرش هم می‌خوابه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 496.18,
   "end": 498.98,
   "text": "میگه وقتی چون تو بیداری روی آورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.98,
   "end": 502.52,
   "text": "نتیجه هزاران خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.52,
   "end": 505.72,
   "text": "و احتضار را می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.72,
   "end": 508.48,
   "text": "یعنی اگر هنر داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 508.48,
   "end": 510.96,
   "text": "در بیداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 510.96,
   "end": 514.68,
   "text": "حقایق رو ببین، اخذ کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 514.68,
   "end": 517.78,
   "text": "بچش. مثلاً کربلا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 517.78,
   "end": 521.12,
   "text": "تو خواب دیدی خیلی خوب. اونم عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.12,
   "end": 525.36,
   "text": "اون هم نتیجه پاکی قوه خیاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.36,
   "end": 528.38,
   "text": "تو خواب می‌بینی هرکسی نمی‌تونه ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 528.38,
   "end": 532.28,
   "text": "اما آیا هنر داری در بیداری کربلا رو ببینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 532.28,
   "end": 535.26,
   "text": "من محضر یکی از بزرگان رفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.26,
   "end": 539.58,
   "text": "شنیده بودم خب دیگه یه زمانی که بچه‌تر از الان که بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.58,
   "end": 543.88,
   "text": "سر و گوشمون می‌جنبید. هی رو خرمند داشته‌های این و اون می‌نشستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 543.88,
   "end": 546.12,
   "text": "می‌خواستیم پز بدیم پوزیشن اینو داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 546.12,
   "end": 549.9,
   "text": "آقا محضر فلان عالم رو درک کردیم اینو گفت اینو از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 549.9,
   "end": 552.8,
   "text": "بازی‌ها. اینم خودش یه بازی بود، هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 552.8,
   "end": 558.72,
   "text": "برای ما متاسفانه. خب شنیدیم تهران یه بزرگی هست که معذورم از بردن اسمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 558.72,
   "end": 563.08,
   "text": "هنوزم هستن ایشون. دیگه الان خیلی سنشون بالاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.08,
   "end": 565.8,
   "text": "که منصرفه از عالم ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.8,
   "end": 569.02,
   "text": "هر آن اراده کنه. ما به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.02,
   "end": 571.04,
   "text": "جون کندیم تا محضر ایشون برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 571.04,
   "end": 574.3,
   "text": "بعد وقت ملاقات و با همدیگه رو در رو شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 574.3,
   "end": 581.88,
   "text": "کل چهل منزل حضرت زینب سلام الله علیها از کربلا تا کوفه و شام رو ایشون برای ما بازگو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 581.88,
   "end": 586.2,
   "text": "درسته؟ بعد خلاصه بهش نشون داده بودن انصراف از نشئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 586.2,
   "end": 588.52,
   "text": "تو همین حالت بیداریه نه اینکه بره خواب ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 588.52,
   "end": 592.06,
   "text": "اونم قشنگه خوب. اما اصلی تو حالت بیداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 592.06,
   "end": 595.92,
   "text": "چهل منزل رو بهش نشون داده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 595.92,
   "end": 602.08,
   "text": "که البته محک داشت، ملاک داشت به هر این ادعا که منم الان می‌تونم بذارم تو ادعا بکنم آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.08,
   "end": 604.46,
   "text": "دستتو بده به من چشمتو ببند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 604.46,
   "end": 606.64,
   "text": "بود آخه یه بنده خدایی این کارو با ما کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 606.64,
   "end": 609.16,
   "text": "می‌خوام ببرمت با طی ارض کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 609.16,
   "end": 612.0,
   "text": "بعد دست ما رو گرفت گفت چشمتو ببند شروع کرد یه چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 612.0,
   "end": 614.22,
   "text": "حرفایی زدن فوت کرد تو صورت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 614.22,
   "end": 618.86,
   "text": "خب ما هم بالاخره بچه بودم خیلی، خیلی سال سی سی و چند سال پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 618.86,
   "end": 623.06,
   "text": "من تازه نوجوان بودم. خب اون موقع عاشق امام حسین اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.06,
   "end": 625.8,
   "text": "زمانه فکر می‌کنم جنگ هم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 625.8,
   "end": 628.68,
   "text": "درسته؟ شروع کرد حسین، حسین یه حرفایی زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 628.68,
   "end": 632.7,
   "text": "خب خیال آدمه دیگه میره سمت کربلا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 632.7,
   "end": 636.86,
   "text": "ما تو اون حالتی که چشمامون بسته بود کربلا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 636.86,
   "end": 640.38,
   "text": "متجسم و متجسد و متمثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 640.38,
   "end": 643.56,
   "text": "تنزیها دیدیم. خب تو قوه خیال خودم دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 643.56,
   "end": 645.94,
   "text": "تو کاری نبودی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 645.94,
   "end": 649.14,
   "text": "خب ما علمش رو نداشتیم فکر می‌کردیم آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 649.14,
   "end": 651.8,
   "text": "یه کشفی، کرامتی ازش رخ داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 651.8,
   "end": 654.2,
   "text": "در نتیجه بچه بازی‌هایی که خیلی الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 654.2,
   "end": 657.16,
   "text": "راحت من می‌تونم با قوه خیال شما بازی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 657.16,
   "end": 660.86,
   "text": "همین الان هرجا اراده کنی ببینی خودت رو کاری نداره اینا که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 660.86,
   "end": 666.08,
   "text": "اینا که طی ارض نیست که. کاری نداره با ادعا آدم خیلی کارا می‌تونه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 666.08,
   "end": 669.98,
   "text": "نه ملاک داشت. ملاکشم برای ما رو کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 669.98,
   "end": 673.64,
   "text": "و به هر حال ما مطمئن شدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 673.64,
   "end": 677.28,
   "text": "نه راه درسته و حرف حقه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 677.28,
   "end": 679.44,
   "text": "چرا؟ خب من، من هیچ تن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 679.44,
   "end": 684.48,
   "text": "هیچ ارتباطی نمی‌تونم بگیرم با حضرت زینب در اون ای-- مثلا چهل منزل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 684.48,
   "end": 686.72,
   "text": "هست الان ایشون در حسابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 686.72,
   "end": 689.54,
   "text": "هستن. ظاهراً در این دنیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 689.54,
   "end": 696.04,
   "text": "اما اونور سیر می‌کنند. علامه داره این دستورالعمل رو توی این کلمه شصت و دو به من و شما میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 696.04,
   "end": 699.7,
   "text": "آقا این حرفا رو نگیم این حرفا خرافات اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 699.7,
   "end": 702.26,
   "text": "این حرفا چیه؟ این حرفا سنگینه آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 702.26,
   "end": 705.18,
   "text": "پس من و شما انسان هستیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 705.18,
   "end": 710.86,
   "text": "چرا آدمای مثل من و شما، مگه من و شما چی کم داریم از انسان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 710.86,
   "end": 713.38,
   "text": "هرچی که یک انسان داره من و شما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 713.38,
   "end": 716.66,
   "text": "چرا آدمای دیگه دارن میرن می‌رسن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 716.66,
   "end": 719.72,
   "text": "کذا اینا چیزی نیست. اینا بارها من عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 719.72,
   "end": 723.1,
   "text": "من حالا اینو میگم بعضیا فکر می‌کنن حاجی تا تهش رفته و اینو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 723.1,
   "end": 730.86,
   "text": "نه از اساتیدمون یاد گرفتیم و شنیدیم که این‌ها اینجور مقامات که ما له له‌ش رو می‌زنیم و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 730.86,
   "end": 732.48,
   "text": "نخود کیش میش این راهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 732.48,
   "end": 737.2,
   "text": "اصلاً اینا چیزی نیست. ولی راهش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 737.2,
   "end": 741.24,
   "text": "راهش چیه؟ بفرمایید شما الان نتیجه این کلام شصت و دو چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 741.24,
   "end": 744.52,
   "text": "آقا انصراف از نشئه عنصری و مادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 744.52,
   "end": 748.64,
   "text": "انصراف، منصرف شو آقا چشمتو بند به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 748.64,
   "end": 751.32,
   "text": "اون آیه شریفه هست حالا الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 751.32,
   "end": 757.0,
   "text": "اهل قرآن هستید الان تو ذهنم دقیق عبارتش не یادمه \"ولا تمدن عينيك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 757.0,
   "end": 763.5,
   "text": "إلى ما متعنا به زهرة، زهرة الحياة الدنيا\" حالا اگه عبارت عربیشو اشتباه نخوانده باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 763.5,
   "end": 767.26,
   "text": "به پیغمبر میگه این چشمتو نکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 767.26,
   "end": 769.7,
   "text": "ادامه نده. داری نگاه می‌کنی ادامه نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 769.7,
   "end": 775.06,
   "text": "یه شترای سرخ پوست که حالا بهش میگن تserie.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 775.06,
   "end": 778.6,
   "text": "سرخ مو ببخشید سرخ پوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 778.6,
   "end": 782.92,
   "text": "سرخ مو مثل بنز آخرین سیستم الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 782.92,
   "end": 785.4,
   "text": "یه گله بودن یه جا رد میشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 785.4,
   "end": 790.06,
   "text": "صحابه گفتن یا رسول الله شتر تserie، شتر تserie",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 790.06,
   "end": 795.04,
   "text": "خیلی قیمت داشت. الان مثلاً یه بنز آخرین سیستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 795.04,
   "end": 797.56,
   "text": "سی میلیارد چقدر حدودا پولشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 797.56,
   "end": 800.88,
   "text": "فکر کنید اون موقع یه شتر، یه گله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 800.88,
   "end": 804.46,
   "text": "بعد پیغمبر نگاه نکرد. فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 804.46,
   "end": 806.98,
   "text": "برو سریع برو، رد شو برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 806.98,
   "end": 810.0,
   "text": "آقا نگاه کن این پیغمبر چی فرموده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 810.0,
   "end": 813.58,
   "text": "پیغمبر خدا فرموده می‌ترسم نگاه کنم دلم بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 813.58,
   "end": 816.4,
   "text": "خدا رحمت کنه شیخ عباس تورباتی برید سر قبرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 816.4,
   "end": 819.4,
   "text": "امیدوارم از من یاددایی داشته باشید و برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 819.4,
   "end": 822.42,
   "text": "تو صحن آزادی امام رضا علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 822.42,
   "end": 826.5,
   "text": "که برید رو به ایوان طلا که رسیدید دست راستتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 826.5,
   "end": 829.06,
   "text": "دست راستتون الان محدوده خانوماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 829.06,
   "end": 831.14,
   "text": "ولی تا دم درش می‌تونید برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 831.14,
   "end": 836.3,
   "text": "یه سنگ قبر معمولی مردم هم نمی‌دونم نمیشه اصلاً اونجا رو به رو لم دادن اون قبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 836.3,
   "end": 838.5,
   "text": "از اولیاء خدا بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 838.5,
   "end": 844.92,
   "text": "که یه هفته قبل مرگش به پسرش گفت که من چه ساعتی، چه روزی رفت غسل کرد لباس تمیز پوشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 844.92,
   "end": 853.18,
   "text": "و پسرش گفت که لحظه احتضارش چه کسایی رو دید با از پیغمبر بگیر تا حضرت زینب گفتگو کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 853.18,
   "end": 855.06,
   "text": "حتی با حضرت زینب گفتگو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 855.06,
   "end": 863.5,
   "text": "پسرش میگه یهو دیدم چشاش چهار تا شد گوشه حجره رو کرد گفت صلي الله عليه يا بنت امیر المؤمنین یا زینب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 863.5,
   "end": 866.42,
   "text": "شما برای چی اینقدر رنج کردی تشریف آوردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 866.42,
   "end": 871.58,
   "text": "لحظه احتضارش. آها دیدی من یه عمر برای امام حسین گریه کردم اومدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 871.58,
   "end": 873.98,
   "text": "شروع کرد خودش گریه کردن. اینا چی بودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 873.98,
   "end": 879.52,
   "text": "اینا چی بودن؟ می‌دونید همش سرش پایین بود حتی اون تیغه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 879.52,
   "end": 882.72,
   "text": "استخوان گردنش دیگه اواخر عمر خشک شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 882.72,
   "end": 884.3,
   "text": "سرش نمی‌تونست خیلی بیاد بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 884.3,
   "end": 886.82,
   "text": "انقدر که شهید همت هم میگن اینطوری بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 886.82,
   "end": 892.1,
   "text": "همش سرش پایین. برعکس ما که سر همش می‌جنبه سر گوشمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 892.1,
   "end": 894.0,
   "text": "بعد از بازار تهران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 894.0,
   "end": 896.86,
   "text": "میگه رد میشدیم دیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 896.86,
   "end": 901.04,
   "text": "این میگه شخص میگه که دیدم عجب چه ویترینی چیده این مغازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 901.04,
   "end": 903.82,
   "text": "بهش گفتم نگاه کنید. نگاه مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 903.82,
   "end": 907.02,
   "text": "پیغمبر دست تکون داد گفت نه رد شو برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 907.02,
   "end": 910.74,
   "text": "آقا اینا با یه امیدی ویترینشون رو پر کردن برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 910.74,
   "end": 915.86,
   "text": "چی فرموده باشه خوبه؟ همون حرف پیغمبر فرمود می‌ترسم ببینم دلم بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 915.86,
   "end": 920.98,
   "text": "این یعنی انصراف از نشئه عنصری از این جاها شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 920.98,
   "end": 926.36,
   "text": "حالا ما چقدر چشم دوختیم به پست و مقام و ماشین شاسی بلند و خونه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 926.36,
   "end": 930.22,
   "text": "پوزیشن علم و نمیدونم چیه این و اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 930.22,
   "end": 935.38,
   "text": "انشاالله که علقتون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 935.38,
   "end": 937.5,
