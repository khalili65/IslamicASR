 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ سوم؛ تباه کردن گوهر ذات",
   "start": 0.26,
   "end": 107.28
  },
  {
   "index": 1,
   "title": "### نفس خدا و نفس ما؛ هبه و احتیاج",
   "start": 107.28,
   "end": 146.16
  },
  {
   "index": 2,
   "title": "### آمده‌ایم برای معرفت از ناحیهٔ آیات",
   "start": 146.16,
   "end": 166.26
  },
  {
   "index": 3,
   "title": "### دو وجه نفس؛ سخنِ متألّه سبزواری",
   "start": 166.26,
   "end": 422.56
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.92,
   "text": "علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.92,
   "end": 7.14,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.14,
   "end": 12.82,
   "text": "سال سردار دلهarz قاسم عزیزمون که روز شهادتشونه صلواتی هدیه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.82,
   "end": 16.12,
   "text": "الله- صلى الله علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.12,
   "end": 19.08,
   "text": "و آل محمد و عجل فرجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.08,
   "end": 27.78,
   "text": "کلمه سوم از صد کلمه در معرفت نفس علامه می‌فرماید \"آنکه گوهر ذات خود را تباه کرده است\"،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.78,
   "end": 30.26,
   "text": "عبارتو دقت کنید \"آنکه گوهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.26,
   "end": 33.08,
   "text": "ذات خود را تباه کرده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.08,
   "end": 36.7,
   "text": "چه بهره‌ای از زندگی برده است؟\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.7,
   "end": 40.1,
   "text": "خب اینجا چون میگه ذات خب حکما مثل ما نیستن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.1,
   "end": 42.7,
   "text": "اونم حکمای متأله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.7,
   "end": 46.66,
   "text": "که یعنی الهین. یعنی هم حکیمن هم عارفن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.66,
   "end": 48.64,
   "text": "و جامع الاطرافی مثل علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.64,
   "end": 51.64,
   "text": "اینا کلمه به کلمه‌ای که قلم می‌زنن رو حسابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.64,
   "end": 54.42,
   "text": "میگه ذات خودش رو تباه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.42,
   "end": 61.2,
   "text": "خب ما یک حقیقت، یک حقیقت واحده بسيط الحقیقه ایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.2,
   "end": 65.64,
   "text": "با ذات شعون، ذات اطوار، ذات مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.64,
   "end": 68.4,
   "text": "که شعون داریم، اطوار داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.4,
   "end": 71.0,
   "text": "که یک حقیقت کلیه‌ایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.0,
   "end": 73.04,
   "text": "که این حقیقت کلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 73.04,
   "end": 75.82,
   "text": "وقتی که، حالا شاید بهش میگن نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.82,
   "end": 81.02,
   "text": "وقتی که به جهت تعلقش به مادون که بدنه، بدن انزل مراتب نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 81.02,
   "end": 85.5,
   "text": "ما قبلاً گفتیم بدن از اجزاء نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 85.5,
   "end": 89.46,
   "text": "البته جزء هم یک عبارت خاکیه ما رو شاید دور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.46,
   "end": 91.52,
   "text": "بهتره بگیم شعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 91.52,
   "end": 95.52,
   "text": "یعنی نه-- بدن جدایی از نفس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 95.52,
   "end": 97.7,
   "text": "اما متأنزل مراتب نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 97.7,
   "end": 107.28,
   "text": "وقتی که اون حقیقت کلیه می‌خواد مادون خودش رو که بدن باشه رو پرورش بده از جهت تعلقش به مادون بهش میگن نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.28,
   "end": 111.26,
   "text": "خدا هم چون تعلق به مادون از حیث هبی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.26,
   "end": 115.74,
   "text": "نفس ما تعلقش به مادون یعنی بدن می‌خواد پرورش بده از حیث احتیاجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.74,
   "end": 119.06,
   "text": "محتاج بدنه. هیچ کجا نفس ما بدون بدن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 119.06,
   "end": 122.72,
   "text": "اما خدا به جهت هبی که داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.72,
   "end": 126.16,
   "text": "تعلق به مادون داره خدا میگن از این جهت نفس داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.16,
   "end": 128.92,
   "text": "اللهم عرفنی نفسک. اما هبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 128.92,
   "end": 131.94,
   "text": "چون فرمود کنت کنزا مخفیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 131.94,
   "end": 134.7,
   "text": "من گنج پنهانی بودم. فاحببت ان اعرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 134.7,
   "end": 138.5,
   "text": "دوست داشتم شناخته بشم. خب خدایا چه کردی که شناخته بشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 138.5,
   "end": 142.88,
   "text": "فخلقت الخلق. فخلقت الخلق لکی اعرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 142.88,
   "end": 145.32,
   "text": "برای اینکه شناخته بشم. پس فلسفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 145.32,
   "end": 147.54,
   "text": "اصلاً خلقت ما شناخت حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 147.54,
   "end": 154.1,
   "text": "معرفته. حالا از این جهت نفس ما که به مادون تعلق داره بهش میگن نفس، همون حقیقت کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 154.1,
   "end": 158.74,
   "text": "از این حیث که توجه به مافوق داره و به ملکوت بهش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 158.74,
   "end": 163.18,
   "text": "عقل. حالا از حیثیات ما از این جهت که کلیات رو می‌فهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 163.18,
   "end": 167.6,
   "text": "باز بهش میگن عقل. از این جهت که یک حقیقت کلیه بسیطه میگن روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 167.6,
   "end": 170.26,
   "text": "از این جهت که جزئیات رو می‌فهمه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 170.26,
   "end": 172.52,
   "text": "صور و اشكال ایجاد می‌کنه خیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 172.52,
   "end": 175.0,
   "text": "حالا هرچی. ولی یک حقیقت کلیه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 175.0,
   "end": 176.78,
   "text": "اما ما اومدیم تو این دنیا برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 176.78,
   "end": 180.24,
   "text": "شناخت و معرفت. معرفت از چه ناحیه‌ای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 180.24,
   "end": 182.64,
   "text": "از چه ناحیه‌ای خدا رو بشناسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 182.64,
   "end": 186.16,
   "text": "از ناحیه همین آیات، مجالی، اجلال، کلمات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 186.16,
   "end": 190.82,
   "text": "اطوار حضرت حق که همه عالم به قول علامه اطوار وجودی حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 190.82,
   "end": 194.78,
   "text": "و خلقکم اطوارا. شما رو به طورهای مختلف خلق کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 194.78,
   "end": 196.44,
   "text": "که اطوار خدا رو بیابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 196.44,
   "end": 199.42,
   "text": "خدا هم طورهای مختلف داره، چیز عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 199.42,
   "end": 204.42,
   "text": "شعون مختلف داره و در بین این شعون و اطوار خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 204.42,
   "end": 212.64,
   "text": "اون که، اون کسی، اون حقیقتی که، اون جلوه‌ای که، اون آینه‌ای که، اون کلمه‌ای که، اون آیه‌ای که، اون شأنی از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 212.64,
   "end": 216.58,
   "text": "که بر همه شرف داره و حجت الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 216.58,
   "end": 218.72,
   "text": "حج-- قبلاً گفتیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 218.72,
   "end": 221.34,
   "text": "هیه-- هیه اکبر حجاج الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 221.34,
   "end": 224.0,
   "text": "حجت الله یا آیه الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 224.0,
   "end": 226.74,
   "text": "عظماء به یک معنا انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 226.74,
   "end": 229.52,
   "text": "نفس ناطقه، ناطقه انسانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 229.52,
   "end": 232.02,
   "text": "خب حالا باز برمی‌گردیم به همون حرف کلمه دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 232.02,
   "end": 234.3,
   "text": "تا وقتی کل رو نشناسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 234.3,
   "end": 238.48,
   "text": "اون حجت اکبر رو نشناسی، چگونه می‌شه که از بیرون بهره ببری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 238.48,
   "end": 240.54,
   "text": "تا داخل رو نشناسی چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 240.54,
   "end": 242.94,
   "text": "به خارج مرتبط بشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 242.94,
   "end": 246.14,
   "text": "امکانش نیست. لذا از زندگی هم که این آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 246.14,
   "end": 248.94,
   "text": "خارج از تو هستن و تو اکبر از اونایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 248.94,
   "end": 251.02,
   "text": "از اینا هم بی‌بهره‌ای، بی‌خبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 251.02,
   "end": 255.34,
   "text": "لذا فرمود قد و قد خواب من دثها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 255.34,
   "end": 257.32,
   "text": "اون قف-- قد أفلح من زکاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 257.32,
   "end": 261.48,
   "text": "از مقابل اون زکاها می‌شه فهمید که این دثها مقابل زکاهاست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 261.48,
   "end": 268.54,
   "text": "چون این آیه بعد از اون اومده. یعنی اینکه کسی نفسشو بزنه داغون کنه، تخریب کنه، خراب کنه، پلیدش کنه با گناه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 268.54,
   "end": 270.52,
   "text": "دیگه زکاها صورت نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 270.52,
   "end": 276.28,
   "text": "این دیگه گرفتار چی می‌شه؟ گرفتار نشئ مادون می‌شه و از ملکوت بی‌خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 276.28,
   "end": 281.04,
   "text": "گیر می‌کنه تو ملک که حالا متأله سبزواری متأله چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 281.04,
   "end": 284.14,
   "text": "حکیم و عارف. از این جهت بهش میگن متأله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 284.14,
   "end": 287.84,
   "text": "مرحوم متأله سبزواری اونجا که میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 287.84,
   "end": 291.1,
   "text": "بحث جنود شیطان و حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 291.1,
   "end": 297.12,
   "text": "عرض شود ابلیسه و ملائکه و اینا رو مطرح می‌کنه، یه جمله خیلی شیرین البته مفصولی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 297.12,
   "end": 298.94,
   "text": "اولشو من برای شما بخونم و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 298.94,
   "end": 301.66,
   "text": "إن النفس الإنسانية",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 301.66,
   "end": 303.22,
   "text": "ذات وجهین. به به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 303.22,
   "end": 305.56,
   "text": "دو تا وجه داریم ما تو نفسمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 305.56,
   "end": 311.9,
   "text": "وجهاً إلى الجنبة العالية والناحية المقدسة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 311.9,
   "end": 316.46,
   "text": "همون وجه جن-- نفس ماست که توجه به عالم عالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 316.46,
   "end": 319.16,
   "text": "و اعلی و ملکوت دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 319.16,
   "end": 322.94,
   "text": "وهو بابه الداخلي إلى عالم الملكوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 322.94,
   "end": 325.98,
   "text": "از اون حیث می‌تونی به ملکوت دسترسی پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 325.98,
   "end": 331.34,
   "text": "و وجهاً إلى الجنبة السافلة وهو بابه الخارجي إلى عالم الملك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 331.34,
   "end": 334.34,
   "text": "که یک وجهی هم داره که نازله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 334.34,
   "end": 337.66,
   "text": "با اون می‌تونی با خارج از خودت ارتباط بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 337.66,
   "end": 343.58,
   "text": "که و کل من الملكوت والملك من ما يوصف النفس آثاره المختصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 343.58,
   "end": 347.08,
   "text": "که از هر کدوم از اینا تو نفس ما یک آثاری وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 347.08,
   "end": 350.28,
   "text": "می‌شه از اون اثر پی به مؤثر برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 350.28,
   "end": 356.62,
   "text": "اگر کسی صرفاً گرفتار این وجه اسفل خودش یعنی مادون خودش شد، یعنی تو دنیا سیر کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 356.62,
   "end": 361.48,
   "text": "و به قولی میگه شیطانی زندگی کرد، هیچ بهره‌ای از ملکوت نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 361.48,
   "end": 363.56,
   "text": "اما اگر کسی توجه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 363.56,
   "end": 366.1,
   "text": "ملکوت کرد، توجه به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 366.1,
   "end": 371.04,
   "text": "مقام اعلی خودش کرد، یعنی نفسش رو در اون اعلی مرتبه پیدا کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 371.04,
   "end": 374.3,
   "text": "اون موقع تا-- اینجا رو دیدین خطبه مصاب دقت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 374.3,
   "end": 377.6,
   "text": "تمام مادون به خدمت مافوق میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 377.6,
   "end": 381.94,
   "text": "همه دنیا میاد به خوم-- به کمکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 381.94,
   "end": 384.62,
   "text": "هرکس که برای خدا شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 384.62,
   "end": 387.48,
   "text": "کان الله له. خدا برای اون می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 387.48,
   "end": 389.14,
   "text": "الله اکبر. مثل قاسم سلیمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 389.14,
   "end": 392.8,
   "text": "یه وجهش، یه مصداقش. بعد چه وسیع می‌دید همه چی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 392.8,
   "end": 395.78,
   "text": "اینطور نیست؟ همه چی رو أوسع می‌دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 395.78,
   "end": 398.42,
   "text": "اصلاً می‌گفت آقا این مثلاً اینایی که بد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 398.42,
   "end": 403.96,
   "text": "چهره‌ان، قیافه و لباسای بد می‌پوشن، این دخترهایی که مثلاً بد حجابن، اینا رو چرا از خودمون جدا می‌دونیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 403.96,
   "end": 407.58,
   "text": "اینام خواهرهای ما، برادرهای ما، مال مملکت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 407.58,
   "end": 409.68,
   "text": "ببین ما چیکار کردیم اینا اینطوری شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 409.68,
   "end": 411.46,
   "text": "ما یک حقیقت کلیه‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 411.46,
   "end": 415.14,
   "text": "ببین نگاه رو to قرآن. ان شا الله عاقبتمون خطبه به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 415.14,
   "end": 417.76,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 417.76,
   "end": 422.56,
   "text": "الله- الله صلی على محمد آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}