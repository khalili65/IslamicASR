 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ هجدهم؛ تدبیر متفرد به جبروت",
   "start": 12.28,
   "end": 141.14
  },
  {
   "index": 1,
   "title": "بهترین ذکر برای راه یافتن به این حقیقت همان ذکر مشهور است:",
   "start": 141.14,
   "end": 346.48
  },
  {
   "index": 2,
   "title": "## دعای عرفه و قوس نزول و صعود",
   "start": 346.48,
   "end": 381.74
  },
  {
   "index": 3,
   "title": "## برف و باران و آب‌های بدن؛ وحدت صنع",
   "start": 381.74,
   "end": 575.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.8,
   "end": 4.86,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.86,
   "end": 12.28,
   "text": "السلام علیک یا داعی الله و ربانی آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.28,
   "end": 17.42,
   "text": "کلمه هجدهم. آن که خود را متسخر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.42,
   "end": 20.7,
   "text": "تحت تدبیر متفرد به جبروت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.7,
   "end": 23.66,
   "text": "نمی‌یابد در وحدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.66,
   "end": 27.86,
   "text": "صنع صورت شگفتش چه می‌گوید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.86,
   "end": 35.32,
   "text": "دو تا نکته عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.32,
   "end": 37.62,
   "text": "اولا اشاره می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.62,
   "end": 40.48,
   "text": "حضرت علامه علیه الرحمه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.48,
   "end": 44.22,
   "text": "تدبیر متفرد به جبروت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.22,
   "end": 50.88,
   "text": "این یعنی همون خب اسمش همونطور که قبلا عرض کردیم جبروت بر وزن فعلوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.88,
   "end": 57.64,
   "text": "شدت جبر و یعنی همه چی تحت تدبیر و صنع حضرت حق اون صانع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.64,
   "end": 59.88,
   "text": "و اون مدبر عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.88,
   "end": 65.24,
   "text": "که همه چی تحت تدبیر اوست به شدت در اون عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.24,
   "end": 71.44,
   "text": "که ذیل عالم جبروت که می‌شود ملکوت یا عالم مثال بعد می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.44,
   "end": 74.56,
   "text": "ملک یا ناسوت همین دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.56,
   "end": 80.16,
   "text": "بعد از عالم جبروت شکل و صورت به خودش می‌گیره حقایق عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.16,
   "end": 85.24,
   "text": "یعنی اولین جایی که صورت به خودش گرفت، شکل هندسی به خودش گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.24,
   "end": 91.2,
   "text": "طول و بعد و حجم و شکل و اندازه و رنگ و عطر این چیزا گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.2,
   "end": 95.42,
   "text": "در عالم مثال بود مطابق با عالم مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.42,
   "end": 100.24,
   "text": "یعنی برزخ یا برزخ و مثال منفصل بیرون از ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.24,
   "end": 102.72,
   "text": "بعد نشئه طبیعت بود که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.72,
   "end": 107.98,
   "text": "شهود مطلقه است. مثال شهود مضافه، شهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.98,
   "end": 114.38,
   "text": "مقیده به یک معنا. ولی در عالم جبروت که مافوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 114.38,
   "end": 116.64,
   "text": "مثال و این طبیعته، اونجا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.64,
   "end": 118.9,
   "text": "جبر محضه. اسمش رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.9,
   "end": 123.92,
   "text": "جبروت یعنی همه تحت یکپارچه تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.92,
   "end": 126.22,
   "text": "مدیریت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.22,
   "end": 129.52,
   "text": "حالا علامه می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.52,
   "end": 133.86,
   "text": "باید به اون توجه کنی که تحت تسخیر اون عالمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.86,
   "end": 140.16,
   "text": "که اتفاقا این بهترین ذکر برای اینکه انسان به این حقیقت راه پیدا کنه همین ذکر مشهوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.16,
   "end": 143.54,
   "text": "لا حول و لا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.54,
   "end": 146.6,
   "text": "چه ذکر سنگین و عالی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.6,
   "end": 151.04,
   "text": "که البته جمع بسته شده از دو تا ذکر دیگه می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.04,
   "end": 155.48,
   "text": "که لا قوة لنا على الطاعة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.48,
   "end": 158.46,
   "text": "إلا بالله العلي العظيم و لا حول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.46,
   "end": 164.1,
   "text": "بيننا و بين المعصية إلا بالله العلي العظيم جمع بسته شده شده اون لا حول و لا قوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.1,
   "end": 166.82,
   "text": "اتفاقا وقتی تو نماز پا میشی چی میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.82,
   "end": 169.6,
   "text": "به حول الله و قوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.6,
   "end": 172.04,
   "text": "به حول و قوه الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.04,
   "end": 174.32,
   "text": "اقوم و اقعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.32,
   "end": 178.62,
   "text": "ظاهرا من پا میشم می‌شینم اما به حول و قوه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.62,
   "end": 188.46,
   "text": "ذکر شریفی‌ست. خب این بعد علامه می‌فرمایند اگر این رو متوجه نمی‌شی چگونه است که در وحدت صنع صورت شگفتت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.46,
   "end": 193.08,
   "text": "خودت می‌خوای چی بگی اینجا؟ وقتی اون وحدت صنع رو نگاه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.08,
   "end": 197.6,
   "text": "در عظمت خلقت الهی در وجود خودت اینو می‌خوای چی بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.6,
   "end": 202.36,
   "text": "اگر نمی‌خوای قبول کنی تحت تدبیر متفرد جبروتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.36,
   "end": 206.38,
   "text": "چگونه نمی‌خوای قبول کنی که این وحدت صنع الهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.38,
   "end": 210.64,
   "text": "چرا نمی‌خوای قبول کنی؟ اتفاقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.64,
   "end": 217.82,
   "text": "خدا حفظ کنه حضرت عرض شود خدا رحمت کنه حضرت استاد رو در الهی نامه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.82,
   "end": 219.72,
   "text": "یه جمله‌ای دارن خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.72,
   "end": 224.74,
   "text": "در بحث وحدت صنع اشاره می‌کنند به اون قوس موس بودن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.74,
   "end": 226.92,
   "text": "می‌فرمود الهی تو الهی نامه‌شونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.92,
   "end": 230.66,
   "text": "الهی همه الفاظ یونانیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.66,
   "end": 232.88,
   "text": "یکسوی و اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.88,
   "end": 236.92,
   "text": "عالم به لفظ قوس موس یکسوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.92,
   "end": 243.12,
   "text": "که حالا این قوس موس به یک معنا اشاره به زیبایی عالم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.12,
   "end": 249.64,
   "text": "که خیلی جالبه که بدونید در یه کتابی که قبلا ما اینجا برای بچه‌ها می‌گفتیم به نام توحید مفضل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.64,
   "end": 254.28,
   "text": "من توصیه می‌کنم این کتاب رو بگیرید به حتی اگرم خوندین دوباره بخونین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.28,
   "end": 259.84,
   "text": "بسیار کتاب شیرینیه که امام صادق سلام الله علیه به شخصی به نام مفضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 259.84,
   "end": 264.58,
   "text": "از عظمت جهان آفرینش بیان می‌کنه و وحدت صنع رو اونجا میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.58,
   "end": 267.9,
   "text": "جالبه که بدونید علامه شعرانی در شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.9,
   "end": 273.96,
   "text": "فا-- در کشف المرادش که مال علامه حلی بر شرح تجرید الاعتقاد شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.96,
   "end": 276.6,
   "text": "طوسی‌ست یا خواجه طوسی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.6,
   "end": 280.36,
   "text": "اونجا در البته در ترجمه‌ش صفحه صد و چهل و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.36,
   "end": 284.06,
   "text": "همین مطلب رو از توحید مفضل امام صادق میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.06,
   "end": 287.22,
   "text": "این فرمایش امام صادق رو گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 287.22,
   "end": 291.94,
   "text": "اسم معروف و حالا شما فکر می‌کنید علمایی از خودشون یه چیزی العیاذ بالله می‌بافن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.94,
   "end": 295.74,
   "text": "حکما و عرفا و... نه همش بر اساس روایات و آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.74,
   "end": 302.4,
   "text": "امام صادق فرمودن اسم معروف و متداول این جهان در زبان یونانی قوس موس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.4,
   "end": 305.46,
   "text": "کی داره میگه اینو؟ امام صادق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.46,
   "end": 310.56,
   "text": "و معنی قوس موس زینت است و فیلسوفان و مدعیان حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.56,
   "end": 317.38,
   "text": "آن را به همین نام می‌خواندند چون در آن نظام و تدبیر در اون، در اون قوس موس نظام هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 317.38,
   "end": 321.32,
   "text": "نظام و تدبیر دیدند و اکتفا به آن نکردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 321.32,
   "end": 324.84,
   "text": "که آن را تقدیر و نظام نام نهند و بس و سلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 324.84,
   "end": 332.1,
   "text": "بلکه پای فراتر نهاده و آن را زینت نامیدند تا مردم را آگاه کنند که جهان با همه درستی و حکمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 332.1,
   "end": 337.78,
   "text": "استادانه که خلق شده در غایت زیبایی و آراستگی نیز هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 337.78,
   "end": 343.64,
   "text": "اتفاقا امروز داشتم مطالعه در همین زمینه می‌کردم، ذهنم رفت تو دعا عرفه امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 343.64,
   "end": 346.48,
   "text": "عرفه خونا یاهاشون هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.48,
   "end": 349.56,
   "text": "ابتدای دعای عرفه امام حسین به همین نکته اشاره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 349.56,
   "end": 358.42,
   "text": "الحمد لله الذي ليس لقواءه دافع ولا لعطائه مانع ولا كصنعه صنع صانع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 358.42,
   "end": 362.14,
   "text": "خب ما عرفه خونا امام حسینیا نباید توجه به این چیزا داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 362.14,
   "end": 366.36,
   "text": "این زیبایی نظام هستی که الان در بافت و چینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 366.36,
   "end": 369.08,
   "text": "وضعیت همین ظاهری خود من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 369.08,
   "end": 373.38,
   "text": "هر کدوم از این بافت ما یعنی اعضا و جوارح ما رو بخوان جاشون رو با هم عوض کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 373.38,
   "end": 376.32,
   "text": "از این تزویجی که رخ داده \"سبحان الذي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 376.32,
   "end": 381.44,
   "text": "خلق الأزواج كلها\" بیرونش بیارن یا از این حالت قوسی شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 381.44,
   "end": 383.64,
   "text": "یعنی ما اگر مکعبی بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 383.64,
   "end": 386.28,
   "text": "انسان مکعبی شکل بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 386.28,
   "end": 390.96,
   "text": "قوسی نبود. شما ببین سرت قوسه، دستت قوسه، کمرت، پات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 390.96,
   "end": 395.26,
   "text": "همه اعضا و جوارح، ابروهات، چشمات، بینی‌ت همه قوسی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 395.26,
   "end": 396.88,
   "text": "قوس موص زیبا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 396.88,
   "end": 402.16,
   "text": "زیبایی درشه. حتی رفت و ب-- اومد و رفت ما \"إنا لله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 402.16,
   "end": 405.58,
   "text": "از سمت خدا اومدیم و \"إنا له راجعون\" به سمت او برمی‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 405.58,
   "end": 411.06,
   "text": "قوسه. \"یدبر الأمر من السماء إلى الأرض\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 411.06,
   "end": 414.44,
   "text": "این قوس نزول. آیه قرآن دارم می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 414.44,
   "end": 416.72,
   "text": "\"ثم يعرج إليه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 416.72,
   "end": 418.86,
   "text": "دوباره برگشت می‌کنند به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 418.86,
   "end": 421.44,
   "text": "خدا امور. یعنی دوباره قوس برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 421.44,
   "end": 425.3,
   "text": "می‌شه قوس. همش قوسه یعنی زیبایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 425.3,
   "end": 427.52,
   "text": "چگونه است که الان می‌گه شما به این توجه نمی‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 427.52,
   "end": 432.36,
   "text": "نمی‌خوای توجه کنی که خدا چ-- به چه زیبای‌ترین شکل ممکن تو رو خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 432.36,
   "end": 436.84,
   "text": "الان واقعاً یکی از-- من امروز داشتم بررسی می‌کردم در خصوص اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 436.84,
   "end": 440.28,
   "text": "آیات قرآن و اعجاز علمی قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 440.28,
   "end": 444.68,
   "text": "واقعاً اومدم بیرون یه چند قدم زدم اشک ریختم زیر این برف قشنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 444.68,
   "end": 446.12,
   "text": "پیش خودم فکر می‌کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 446.12,
   "end": 453.02,
   "text": "ای کاش همه خلائق متوجه این حقایق می‌شدند که ما سر سفره الله الحمدالله چیزهایی داریم با همدیگه می‌چشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 453.02,
   "end": 458.84,
   "text": "همین برف که الان داره می‌باره. شما دقت کنید اگر این‌ها گوله گوله می‌اومد اینطوری نمی‌اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 458.84,
   "end": 461.48,
   "text": "مثل شهاب سنگ می‌اومد می‌زد در رو داغون می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 461.48,
   "end": 463.62,
   "text": "یا باران مثل آبشار می‌ریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 463.62,
   "end": 465.76,
   "text": "بعد از همه آبی که از بیرون به این شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 465.76,
   "end": 470.84,
   "text": "زیبایی داره میاد در درون ما مطابق با هر کدوم از بافت‌های ما داره به زیبایی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.84,
   "end": 476.38,
   "text": "هر کدوم به یک طعم و یک مزه و یک وضعیت و املاح خاصی که درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 476.38,
   "end": 478.6,
   "text": "همه آبن. آب چشمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 478.6,
   "end": 482.6,
   "text": "تازه و جالبه که وقتی آدم می‌خنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 482.6,
   "end": 484.84,
   "text": "یه اشکی از چشمش میاد گریه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 484.84,
   "end": 487.34,
   "text": "یه اشک میاد ذوق می‌کنه. یه اشک می‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 487.34,
   "end": 491.08,
   "text": "یه اشک. همه این‌ها مزه‌شون با هم فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 491.08,
   "end": 496.4,
   "text": "آبی که از بینی میاد، از دهان میاد، از گوش، در معده، در عروق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 496.4,
   "end": 498.5,
   "text": "این‌ها همه با هم فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 498.5,
   "end": 501.9,
   "text": "آبی که در شیر مادره جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 501.9,
   "end": 503.94,
   "text": "عرض شود مزاج و هاضمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.94,
   "end": 506.6,
   "text": "آبی که مثلا در دهان ماست شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 506.6,
   "end": 508.94,
   "text": "آبی که مثلا در گوش تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.94,
   "end": 510.62,
   "text": "آبی که در چشم شوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 510.62,
   "end": 512.58,
   "text": "اینا مگه از یک زمین نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.58,
   "end": 515.88,
   "text": "از یک بدن نیست؟ زی-- به زیبایی تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 515.88,
   "end": 518.46,
   "text": "حالا مثلا اگر این آب دهان تلخ بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 518.46,
   "end": 521.32,
   "text": "ترش بود، چیکار می‌ش-- شور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 521.32,
   "end": 525.32,
   "text": "آب دهان شیرینه و جالبه اینکه میگه سه هرت آب بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 525.32,
   "end": 531.16,
   "text": "الان ثابت کردن که باعث می‌شه اون آبی که تو دهانه قاطی بشه با غذای آب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.16,
   "end": 534.7,
   "text": "اون سبب هضم بهتر این غذای آب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.7,
   "end": 538.48,
   "text": "که اگر یه دفعه بخوری بری بالا تند و تند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 538.48,
   "end": 541.28,
   "text": "انگار غذا رو کال خوردی، نپخته خوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 541.28,
   "end": 544.96,
   "text": "این آب دهان بزاق دهان کمک نمی‌کنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 544.96,
   "end": 550.24,
   "text": "هضمش. الله اکبر از صنع صانع و این وحدت آفرینش هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.24,
   "end": 552.26,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 552.26,
   "end": 555.92,
   "text": "امروز روز ورود حضرت امام کسیه که یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 555.92,
   "end": 559.36,
   "text": "هرچی ما داریم از معارف الهیه، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 559.36,
   "end": 562.82,
   "text": "حیات قلبمون، حیات انقلابمون، حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 562.82,
   "end": 566.56,
   "text": "زندگیمون از حیث دنیوی و اخروی همه مدیونمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 566.56,
   "end": 568.84,
   "text": "بار سر سفره امام شهدا هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 568.84,
   "end": 571.58,
   "text": "روحشون شاد. نصابشون صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.58,
   "end": 575.76,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}