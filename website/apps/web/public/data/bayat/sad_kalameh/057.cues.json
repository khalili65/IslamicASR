 ],
 "cues": [
  {
   "i": 0,
   "start": 0.74,
   "end": 5.26,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.26,
   "end": 9.4,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.4,
   "end": 14.44,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.44,
   "end": 16.74,
   "text": "خواهرها در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.74,
   "end": 20.52,
   "text": "نماز جماعت اگر از پشت سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.52,
   "end": 25.16,
   "text": "اقتدا کنند به آقایون نیاز به بودن پرده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.16,
   "end": 30.7,
   "text": "اما اگر از بغل خواهرها از کنار آقایون بخوان متصل بشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.7,
   "end": 33.76,
   "text": "به جهت اینکه کراهت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.76,
   "end": 39.54,
   "text": "در نماز زن و مرد نامحرم کنار هم بایستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.54,
   "end": 42.06,
   "text": "کراهت داره البته حرام نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.06,
   "end": 46.96,
   "text": "چون کراهت داره برای برداشته شدن این کراهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.96,
   "end": 52.12,
   "text": "بهتره که پرده زده بشه اگر از کنار اتصال بخواد برقرار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.12,
   "end": 55.48,
   "text": "بعد رهبر عزیزمون در این حکمشون می فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.48,
   "end": 58.68,
   "text": "اینکه هوچی‌گری می‌کنند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.68,
   "end": 60.88,
   "text": "به این مضمون که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.88,
   "end": 65.6,
   "text": "زدن پرده بین خواهرها و برادرها تو مساجد و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.6,
   "end": 71.28,
   "text": "شکستن حرمت مثلاً خانم‌هاست، بی‌حرمتی به اون‌هاست اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.28,
   "end": 73.78,
   "text": "رهبر می‌فرمایند این یه وهمه، یه خیاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.78,
   "end": 77.98,
   "text": "بیخوده این صحبتی که می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.98,
   "end": 81.04,
   "text": "کلمه پنجاه و شش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.04,
   "end": 83.82,
   "text": "صد کلمه در معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.82,
   "end": 89.86,
   "text": "آن که معرفت نفس را مرقات معرفت رب گرفته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.86,
   "end": 92.84,
   "text": "نسبت قوا را به نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.84,
   "end": 96.08,
   "text": "مانند نسبت ملائکه به رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.08,
   "end": 103.8,
   "text": "می‌یابد. اولاً مرقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.8,
   "end": 109.5,
   "text": "کتاب‌هایی که پیرامون لغت و لغت‌شناسی قلم زدن گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.5,
   "end": 115.8,
   "text": "هم به معنای نردبان استفاده می‌شه هم به معنای زینت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.8,
   "end": 123.36,
   "text": "خب اینجا که می‌فرمود آنکه معرفت نفس را مرقات معرفت رب گرفته است بر اساس همون حدیث من عرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.36,
   "end": 126.56,
   "text": "مشخصه که این همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.56,
   "end": 132.48,
   "text": "نردبانه. یعنی از معرفت نفس انسان به معرفت رب می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.48,
   "end": 135.82,
   "text": "نردبانشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.82,
   "end": 137.9,
   "text": "انسان در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.9,
   "end": 142.9,
   "text": "از شناخت خودش رب خودش رو می‌شناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.9,
   "end": 149.94,
   "text": "اینم حالا درش سر-- اسراری بلکه هست که بزرگان بعضیشو فاش کردن که رب خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.94,
   "end": 152.24,
   "text": "من عرف نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.24,
   "end": 156.6,
   "text": "فقط عرف ربه، رب خودش رو می‌شناسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.6,
   "end": 160.06,
   "text": "که حرف‌هایی قبلاً اینجا ما زدیم پیرامون این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.06,
   "end": 164.7,
   "text": "می‌فرمود کسی که این چنین دید نسبت قوا را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.7,
   "end": 168.46,
   "text": "به نفس چون بحث معرفت نفسه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.46,
   "end": 172.92,
   "text": "قوای نفس رو نسبتش رو با خود نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.92,
   "end": 177.14,
   "text": "نسبت ملائکه به رب می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.14,
   "end": 180.02,
   "text": "می‌خوای بدونی که قوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.02,
   "end": 185.78,
   "text": "نفس ما نسبتش با نفس ما چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.78,
   "end": 189.86,
   "text": "این همه قوایی که ما داریم و ما حالا بخشی الان عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.86,
   "end": 193.78,
   "text": "همون نسبتی که ملائکه به رب دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.78,
   "end": 199.68,
   "text": "ملائکه شئون ربند، جدایی از رب نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.68,
   "end": 202.8,
   "text": "مگر قابض الارواح نیست که قبض روح می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.8,
   "end": 205.26,
   "text": "اسمش رو خودشه، قابض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.26,
   "end": 211.96,
   "text": "پیاده، پیاده شدن اسم القابض حضرت حق در ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.96,
   "end": 217.66,
   "text": "و ایشون دست به کار می‌شه. در هر کجا که می‌خواد اسم القابض پیاده بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.66,
   "end": 219.78,
   "text": "روحی قبض بشه کار، کار ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.78,
   "end": 223.42,
   "text": "اما خود قرآن صراحتاً می‌فرماید الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.42,
   "end": 227.5,
   "text": "یتوفی الانفس حين موتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.5,
   "end": 230.5,
   "text": "الله اگر یتوفی الانفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.5,
   "end": 233.0,
   "text": "دیگه این قابض الارواح چی کار است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.0,
   "end": 236.08,
   "text": "اون ملائکه‌ای که در مراحل شش گانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.08,
   "end": 241.86,
   "text": "مرگ عرض کردیم میان صدنه و خدمه قابض الارواح‌اند تا قبل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.86,
   "end": 245.66,
   "text": "اون کشیدن روح از بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.66,
   "end": 251.62,
   "text": "اون‌ها دست به کارند. دیگه از بینی کشیدن که مرحله ششمه دیگه خود قابض الارواح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.62,
   "end": 253.32,
   "text": "قبلش اینا چی کارن پس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.32,
   "end": 256.5,
   "text": "اینا صدنن، خدمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.5,
   "end": 260.48,
   "text": "این‌ها در حقیقت شئونن، آیات الهین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.48,
   "end": 263.3,
   "text": "میگه از اینجا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 263.3,
   "end": 265.74,
   "text": "این‌هام به یک معنا ربند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.74,
   "end": 269.7,
   "text": "اما در طول رب مطلقه که الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.7,
   "end": 272.12,
   "text": "رب العالمين. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.12,
   "end": 274.18,
   "text": "اون رب انواع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 274.18,
   "end": 276.4,
   "text": "یا رب النوع رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.4,
   "end": 282.02,
   "text": "که اولین کسی که این عبارت رو به کار برد مرحوم سحروردی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.02,
   "end": 286.08,
   "text": "حالا بعضیا سحر وردی گفتن درست بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.08,
   "end": 290.58,
   "text": "خب همون مثل قاعده مثل افلاطونیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.58,
   "end": 292.78,
   "text": "مثل در حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.78,
   "end": 296.88,
   "text": "در عرفان بهش می‌گن اسماء یا ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.88,
   "end": 300.76,
   "text": "به همین راحتی. مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.76,
   "end": 303.22,
   "text": "یا رب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.22,
   "end": 305.68,
   "text": "رب النوع، رب ال--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.68,
   "end": 310.68,
   "text": "رب انواع، ارباب انواع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.68,
   "end": 313.18,
   "text": "در عرفان همون ملائکه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.18,
   "end": 316.68,
   "text": "اسماء عینی حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.68,
   "end": 319.22,
   "text": "یعنی چی؟ یعنی این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.22,
   "end": 320.76,
   "text": "شئون حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 320.76,
   "end": 325.72,
   "text": "مثل اینکه قوه باصره شما یک شأنی از نفس شماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.72,
   "end": 329.2,
   "text": "اما همه نفس شما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.2,
   "end": 331.56,
   "text": "یعنی نفس شما یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.56,
   "end": 334.84,
   "text": "شأنش بصره، یک شأنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.84,
   "end": 338.38,
   "text": "سمع، یک شأنش لمسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.38,
   "end": 340.82,
   "text": "یک شأنش شمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 340.82,
   "end": 343.32,
   "text": "یک شأنش ذوقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 343.32,
   "end": 346.48,
   "text": "اینا قوای حیوانی و ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 346.48,
   "end": 349.1,
   "text": "اینا شئون نفس‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 349.1,
   "end": 354.32,
   "text": "همه نفس تعلق نگرفته به دیدن، به شنیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 354.32,
   "end": 356.74,
   "text": "اما به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 356.74,
   "end": 364.24,
   "text": "مرحوم حاجی ملا آدی سبزواری ان النفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.24,
   "end": 368.06,
   "text": "في وحدة ها کل القوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.06,
   "end": 371.16,
   "text": "یک حقیقت واحد اما همه قواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.16,
   "end": 374.46,
   "text": "یعنی این چشم پی تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.46,
   "end": 376.46,
   "text": "عرض شود گودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 376.46,
   "end": 379.84,
   "text": "این جمجمه نیست که می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.84,
   "end": 385.32,
   "text": "نفس داره می‌بینه. مثل این که الان شما خوابی چشت بسته است می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.32,
   "end": 387.34,
   "text": "وقتی می-- از این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.34,
   "end": 392.6,
   "text": "مفارقت می‌کنی، یه سفر، سفر می‌کنی این پی می‌پوسه، فاسد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.6,
   "end": 394.9,
   "text": "اینجا دار، دار مرکباته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 394.9,
   "end": 397.5,
   "text": "مزاج داره. این مزاج به هم می‌پاشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 397.5,
   "end": 400.12,
   "text": "از هم می‌پاشه از بین میره. ولی باز شما می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 400.12,
   "end": 402.78,
   "text": "کسی که از دنیا رفته باز می‌بینه. با چی می‌بینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 402.78,
   "end": 405.96,
   "text": "نفسش می‌بینه. منتها نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 405.96,
   "end": 409.66,
   "text": "قوا دارد. یک حقیقت واحد است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 409.66,
   "end": 412.42,
   "text": "در شؤون مختلف. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 412.42,
   "end": 415.06,
   "text": "نفس داره می‌بینه اما واسطه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 415.06,
   "end": 418.02,
   "text": "واسطه خورده. وساطت فیض که می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 418.02,
   "end": 424.56,
   "text": "ولن تجد لسنة الله تبدیلا ولن تجد لسنة- لسنة الله تحویلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 424.56,
   "end": 429.42,
   "text": "نه بدل برمی‌داره، نه تحویل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 429.42,
   "end": 433.58,
   "text": "منقلب می‌شه مثلا عوض بدل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 433.58,
   "end": 437.76,
   "text": "یعنی این. سنت الهیه، وساطت فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 437.76,
   "end": 441.28,
   "text": "دقیقا همین حالته. برای همین اصلا گفتن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 441.28,
   "end": 446.9,
   "text": "سخت نگیرید. ملائکه همین قوای وجودی ما ملائکه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 446.9,
   "end": 451.48,
   "text": "حالا این چشم ما به منزله ملک وجودی منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 451.48,
   "end": 456.96,
   "text": "همونطور بیرون از ما هم عالم قوایی دارد که ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 456.96,
   "end": 460.46,
   "text": "و سنده و سدنه و خدمه حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 460.46,
   "end": 462.52,
   "text": "اونا هم ارباب‌اند. اونا هم رب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.52,
   "end": 467.9,
   "text": "اونا هم پرورش میدن. الان حضرت قابض الارواح جان می‌گیره یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.9,
   "end": 470.76,
   "text": "یعنی می‌کشه طرفو از بین می‌بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 470.76,
   "end": 473.58,
   "text": "این یعنی مثلا اون موت نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 473.58,
   "end": 480.8,
   "text": "وفات. یعنی تمام جانشو از این حیث مادی قرض می‌کنه می‌بره به بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 480.8,
   "end": 484.42,
   "text": "می‌بره یه رتبه بالاتر. سفره، ارتقای وجودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 484.42,
   "end": 487.42,
   "text": "این باز پرورشه. می‌خواد پرورش بده انسان‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.42,
   "end": 490.46,
   "text": "می‌خواد رتبه‌شون رو ببره بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.46,
   "end": 492.4,
   "text": "اینم چیه؟ ملکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 492.4,
   "end": 495.56,
   "text": "ملائکه که می‌گن فرشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.56,
   "end": 498.5,
   "text": "چیز عجیب و غریبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.5,
   "end": 501.62,
   "text": "قوای وجودی ما هم همه اومدن همین کارو با ما بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 501.62,
   "end": 504.98,
   "text": "اونا هم می‌خوان ما رو پرورش بدن، ارتقای وجودی بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 504.98,
   "end": 508.0,
   "text": "تو همون حالا روایتی که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.0,
   "end": 513.1,
   "text": "معروفه به روایت کمیل از مولا علی علیه الصلاة و السلام که پرسیده آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.1,
   "end": 515.58,
   "text": "می‌خوام نفسم رو بشناسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 515.58,
   "end": 517.9,
   "text": "می‌شه به من بشناسونی نفسم رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 517.9,
   "end": 521.08,
   "text": "حضرت مولا فرمودن که ای کمیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 521.08,
   "end": 523.44,
   "text": "کدوم نفست رو می‌خوای بشناسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.44,
   "end": 526.8,
   "text": "عجب! کمیل می‌گه پرسیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 526.8,
   "end": 531.4,
   "text": "مولای من مگه غیر از یک نفس هم ما داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 531.4,
   "end": 534.76,
   "text": "یک نفس. بیشتر از این داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 534.76,
   "end": 537.18,
   "text": "حضرت فرمودن ای کمیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 537.18,
   "end": 542.64,
   "text": "چهار گونه نفس داریم. این فرمایش مولاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 542.64,
   "end": 547.74,
   "text": "نامی نباتی، عین کلام حضرت، حسی حیوانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 547.74,
   "end": 552.28,
   "text": "ناطقی قدسی، کلی الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 552.28,
   "end": 558.94,
   "text": "بعد حضرت اینا رو توضیح می‌ده. اینا قوای نفس-- اینا انواع نفسن که هر کدوم قوا دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 558.94,
   "end": 564.02,
   "text": "یعنی باز به یک معنا می‌شه گفت این نفوس ارواح‌مان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 564.02,
   "end": 567.88,
   "text": "که ما قبلا گفتیم ما چهار تا ارواح، چهار تا روح داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 567.88,
   "end": 569.5,
   "text": "که اهل بیت پنج تا دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.5,
   "end": 573.58,
   "text": "ما چهار تا روح داریم. این نفوس به یک معنا ارواحن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 573.58,
   "end": 576.8,
   "text": "حالا هر کدوم از اینا قوا دارن که امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 576.8,
   "end": 583.3,
   "text": "اون حدیث مفصله. من خیلی جزئی عرض کنم چون وقت می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.3,
   "end": 585.6,
   "text": "مثلا قوای نفس نامیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 585.6,
   "end": 587.34,
   "text": "قوای نفس نامیه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.34,
   "end": 590.52,
   "text": "یعنی همون ملائکه نفس نامیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 590.52,
   "end": 594.64,
   "text": "که نمو داره مثل درخت که رشد و نمو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 594.64,
   "end": 598.26,
   "text": "از این جهت می‌گن نامیه، نباتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 598.26,
   "end": 604.74,
   "text": "این قواش چی‌ان؟ جاذبه، ماسکه، حازمه، دافعه، مربیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 604.74,
   "end": 609.38,
   "text": "اینا قوای اینن. یعنی ملائکه‌ای‌ان که تحت الامر این نفسن، این روحن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 609.38,
   "end": 611.5,
   "text": "حالا البته تو روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 611.5,
   "end": 617.42,
   "text": "از نفس به روح مطلق یعنی بدون قید تعبیر شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 617.42,
   "end": 620.98,
   "text": "عرض شود مثلا مشترک بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 620.98,
   "end": 625.44,
   "text": "انسان و حیوان، روح حیات، نفس و روح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 625.44,
   "end": 629.74,
   "text": "نفس حسی حیوانی، روح مدرج، روح بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 629.74,
   "end": 634.7,
   "text": "اینا در روای- روایات ببینید منظور همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 634.7,
   "end": 637.44,
   "text": "متکلم و فیلسوف‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 637.44,
   "end": 640.36,
   "text": "مثلا ازش به روح حیوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 640.36,
   "end": 646.42,
   "text": "استفاده کردن، حرف زدن، به روح بخاری هم حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 646.42,
   "end": 648.96,
   "text": "که حالا هر جا یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 648.96,
   "end": 652.08,
   "text": "لفظی داره اما منظورشون یک حقیقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 652.08,
   "end": 654.12,
   "text": "خب این نفس نامیه نباتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 654.12,
   "end": 658.02,
   "text": "بعدیش نفس حسیه حیوانی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 658.02,
   "end": 661.7,
   "text": "قواش چی‌ان؟ همین الان گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 661.7,
   "end": 665.46,
   "text": "سمع و بصر و شم و لمس و ذوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 665.46,
   "end": 667.4,
   "text": "اینا ملائکه وجودی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 667.4,
   "end": 669.14,
   "text": "اینا در کارن. اینا رب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 669.14,
   "end": 674.14,
   "text": "دارن پرورش میدن ما رو. قوای نفس ناطقه قدسیه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 674.14,
   "end": 676.3,
   "text": "فکر و ذکر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 676.3,
   "end": 678.76,
   "text": "علم و حلم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 678.76,
   "end": 685.48,
   "text": "نباهه. تنبه، بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 685.48,
   "end": 688.44,
   "text": "نفس کلیه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 688.44,
   "end": 692.56,
   "text": "اینا ملائکه‌شون چی‌ان؟ ارباب‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 692.56,
   "end": 695.3,
   "text": "بقا در فنا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 695.3,
   "end": 697.64,
   "text": "نعیم در شقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 697.64,
   "end": 701.08,
   "text": "عز در ذل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 701.08,
   "end": 703.24,
   "text": "غنا در فقر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 703.24,
   "end": 705.9,
   "text": "صبر در بلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 705.9,
   "end": 709.74,
   "text": "که البته تمام این افراد تحت اطاعت نفسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 709.74,
   "end": 714.14,
   "text": "اینا قوای نفسن. اینا ملائکه نفسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 714.14,
   "end": 718.08,
   "text": "اون یه بار دیگه الان این توضیحات که من اجمالا دادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 718.08,
   "end": 720.96,
   "text": "اگه موافقید یه بار دیگه کلمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 720.96,
   "end": 724.56,
   "text": "پنجاه و شش رو بخونیم. الان ببینیم چی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 724.56,
   "end": 733.88,
   "text": "حضرت استاد می‌فرمایند که آن که معرفت نفس را مرقات یعنی نردبان معرفت رب گرفته است، یعنی از معرفت خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 733.88,
   "end": 737.0,
   "text": "به معرفت پروردگارش می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 737.0,
   "end": 740.14,
   "text": "همین‌طور نسبت قوا را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 740.14,
   "end": 743.54,
   "text": "قوا را به نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 743.54,
   "end": 747.08,
   "text": "مانند نسبت ملائکه به رب می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 747.08,
   "end": 750.12,
   "text": "ملائکه چگونه در طول رب مطلق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 750.12,
   "end": 752.96,
   "text": "اون‌ها هم ارباب‌اند، پرورش‌دهنده‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 752.96,
   "end": 755.52,
   "text": "موجودات‌اند، وجودات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 755.52,
   "end": 760.6,
   "text": "همچنین قوای نفس هم ملائکه وجود ما‌اند و دارن پرورش می‌دن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 760.6,
   "end": 763.2,
   "text": "ما رو که ما به ارتقای وجودی پیدا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 763.2,
   "end": 765.78,
   "text": "حالا متأسفانه ما میاییم چی کار می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 765.78,
   "end": 770.32,
   "text": "جلوی پرورش نفس رو از طریق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 770.32,
   "end": 776.44,
   "text": "به غیر کانالی که خدا برای همون منظور کرده این قوا رو خرجش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 776.44,
   "end": 778.68,
   "text": "خدا گفته اینجا رو نگاه نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 778.68,
   "end": 782.36,
   "text": "میگم دوست دارم ببینم، عشقمو ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 782.36,
   "end": 788.28,
   "text": "اینجا من منحرف می‌کنم قوا ملایکه وجودم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 788.28,
   "end": 791.58,
   "text": "منحرف می‌کنم. باز اون داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 791.58,
   "end": 794.74,
   "text": "اون داره کار می‌کنه. اون در طول حضرت حق دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 794.74,
   "end": 798.9,
   "text": "اما این جلوه‌ش می‌شه جلوه‌ی اسم ج-جلال الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 798.9,
   "end": 804.54,
   "text": "اسماء جلال که یک رشه‌هایی از جهنم‌اند که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 804.54,
   "end": 808.42,
   "text": "تجلی عینی‌ش می‌شه جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 808.42,
   "end": 814.5,
   "text": "اما اگر درست چشمم رو به اون جایی که خدا گفته بندازم این بروزش می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 814.5,
   "end": 817.66,
   "text": "اسم جمال، می‌شه رشه‌ای از بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 817.66,
   "end": 819.7,
   "text": "می‌بینی نگاهش هم زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 819.7,
   "end": 822.24,
   "text": "نگاهش هم پرورش‌دهنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 822.24,
   "end": 825.5,
   "text": "نگاهتم تو رو بالا می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 825.5,
   "end": 828.0,
   "text": "به سمت بهشت هدایت می‌کنه و ثُغن میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 828.0,
   "end": 831.28,
   "text": "نگاهتم بهشتی می‌شه. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 831.28,
   "end": 837.78,
   "text": "کسی که نه، نگاهش به سمت حرام می‌ره، جایی که خط قرمز الهیه، اون داره چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 837.78,
   "end": 842.06,
   "text": "خودش رو می‌کنه، می‌کنه جلوه‌ای از خود جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 842.06,
   "end": 845.02,
   "text": "رشه‌ای از نار جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 845.02,
   "end": 853.04,
   "text": "حالا الان فرصت نیست که اثبات کنیم که اصلاً خود آتش جهنم حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 853.04,
   "end": 856.74,
   "text": "و إن دار الآخرة لهی الحيوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 856.74,
   "end": 859.88,
   "text": "اصلاً اون طرف هرچی هست حیات محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 859.88,
   "end": 871.28,
   "text": "آتشش حیاته. فرشتگان غلاظ و شدادش حی-حی-حیاتن، حین، موجودن، همین الان هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 871.28,
   "end": 873.9,
   "text": "آتشش هم حیه، حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 873.9,
   "end": 880.82,
   "text": "عذابش هم حیه. همون‌طور که بهشت سیب و گلابی و نهر و قصور و انهارش همین الان همه هم هستن، حیات دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 880.82,
   "end": 888.38,
   "text": "وجود دارن، موجودن. انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 888.38,
   "end": 892.24,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}