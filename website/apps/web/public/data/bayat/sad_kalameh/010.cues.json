 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ نهم؛ برتری انسان در عوالم امکان",
   "start": 6.34,
   "end": 67.16
  },
  {
   "index": 1,
   "title": "### مشک‌زنی خلقت و خلاصه شدن در انسان",
   "start": 67.16,
   "end": 102.78
  },
  {
   "index": 2,
   "title": "### نفس انسانی در شرح قیصری",
   "start": 102.78,
   "end": 217.34
  },
  {
   "index": 3,
   "title": "### پرسش از امام صادق و پاسخ عقل و شهوت",
   "start": 217.34,
   "end": 300.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.58,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.58,
   "end": 8.68,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.68,
   "end": 11.38,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.38,
   "end": 20.72,
   "text": "کلمه ی نهم. استاد فرمودند که آن که می‌انگارند در عوالم امکان موجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.72,
   "end": 23.76,
   "text": "برتر از انسان است کدام است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.76,
   "end": 29.26,
   "text": "یه تأمله. هر کی ادعا داره بالاتر و برتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.26,
   "end": 32.3,
   "text": "انسان در عوالم امکانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.3,
   "end": 34.88,
   "text": "هر موجودی هست بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.88,
   "end": 42.16,
   "text": "کیه؟ کجا است؟ حالا اشاره است به فرمایش مولا علی علیه السلام که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.16,
   "end": 45.76,
   "text": "فرمودند \"وفی کن قبل عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.76,
   "end": 47.92,
   "text": "اکبر\" در حالی که عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.92,
   "end": 52.68,
   "text": "اکبر اون بزرگترین عالم در وجود تو نهفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.68,
   "end": 57.62,
   "text": "از اینجا انسان متوجه می‌شه که اون عالم بزرگ خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.62,
   "end": 61.1,
   "text": "نه عالم کبیر بلکه عالم اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.1,
   "end": 67.16,
   "text": "که عرض شد دیگه تمام موجودات نظام هستی در انسان خلاصه شده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.16,
   "end": 72.16,
   "text": "به قول حضرت علامه شاید بشه گفت خلاصه یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.16,
   "end": 74.8,
   "text": "فصول کتاب فس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.8,
   "end": 78.02,
   "text": "اسمتیه‌شون همینه که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.02,
   "end": 83.38,
   "text": "فرض بگیریم همه عالم رو مشک‌زنی کرد خدا با حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.38,
   "end": 90.22,
   "text": "وجودیه در نشئه طبیعت و حرکت ایجادی در نشئه ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.22,
   "end": 94.06,
   "text": "مثل مشکی که می‌زنن اون خانه روش سرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.06,
   "end": 96.16,
   "text": "جمع می‌شه، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.16,
   "end": 100.72,
   "text": "زبده و چکیده و خلاصه خلقت شده انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.72,
   "end": 106.54,
   "text": "انقدر که عظیم است. اتفاقاً علامه قیسری در شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.54,
   "end": 112.34,
   "text": "fususu'l-hikam ابن عربی اگر دقت فرموده باشید در فس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.34,
   "end": 114.8,
   "text": "نوحیه‌شون اونجا در فس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.8,
   "end": 118.24,
   "text": "حکمت سبوحیه فی کلمة نوحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.24,
   "end": 126.14,
   "text": "اونجا می‌فرماید النفس الإنسانية مشتملة على جميع المراتب الكونية والإلهية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.14,
   "end": 129.16,
   "text": "می‌گه نفس انسان مشتمله بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.16,
   "end": 133.26,
   "text": "جمیع مراتب کونیه و الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.26,
   "end": 135.48,
   "text": "الهیه که مع- مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.48,
   "end": 138.18,
   "text": "کونیه در فلسفه به کون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.18,
   "end": 142.32,
   "text": "می‌گن مادون فلک قمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.32,
   "end": 148.1,
   "text": "هر چیزی که مادون فلک قمره یعنی در عالم کون و فساده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.1,
   "end": 150.84,
   "text": "شب و روز داره. موت و حیات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.84,
   "end": 158.18,
   "text": "اینو می‌گن چی؟ کون. اما در عرفان ه-- اصلاً ماسي والله رو می‌گن کون یا اکوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.18,
   "end": 160.08,
   "text": "لذا صادر اول رو می‌گن ام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.08,
   "end": 163.84,
   "text": "اکوان. مادر همه این هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.84,
   "end": 169.3,
   "text": "حالا در میان این اک-- می‌فرمود که این نفس انسان به گونه‌ایه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.3,
   "end": 176.5,
   "text": "هم خصوصیت‌های، جمیع خصوصیت‌ها و مراتب کونیه رو داره یعنی ماسي والله رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.5,
   "end": 180.5,
   "text": "هم الهیه رو. یعنی اختصاصات الهیه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.5,
   "end": 183.62,
   "text": "الله اکبر. اینه که حضرت علامه می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.62,
   "end": 190.44,
   "text": "انسان رو خدا به وزان خودش آفریده از حیث ذات و صفات و افعال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.44,
   "end": 198.0,
   "text": "کدوم یک از این موجودات نظام هستی تونستن اثر و آثار انسان رو در این نظام داشته باشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.0,
   "end": 201.1,
   "text": "کدوم موجودی مثلاً کتاب نوشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.1,
   "end": 206.66,
   "text": "کدوم موجودی به جز انسان تونسته مثلاً این ماهواره‌ها رو اختراع کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 206.66,
   "end": 209.08,
   "text": "این همه کشفیات کدوم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.08,
   "end": 213.64,
   "text": "یه دونه مثال بزنید. یه موجودی مثال بزنید این همه تأثیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.64,
   "end": 217.12,
   "text": "داشته باشه در نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.12,
   "end": 220.32,
   "text": "حالا از امام صادق صلوات الله علیه پرسیدن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 220.32,
   "end": 223.8,
   "text": "بالاخره ما نفهمیدیم ملائکه بالاترن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.8,
   "end": 228.1,
   "text": "یا انسان بالاتره؟ بالاخره موجود برتر کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.1,
   "end": 236.5,
   "text": "البته اگر دقت کنن خود قرآن کجا به خودش خدا تبارک گفته تبریک گفته \"فتبارک الله احسن الخالقین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.5,
   "end": 239.58,
   "text": "پس از خلقت انسان گفته دیگه مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.58,
   "end": 243.74,
   "text": "حالا اینو سؤال می‌کنم خدا خیرشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.74,
   "end": 245.48,
   "text": "امام صادق چگونه جواب دادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.48,
   "end": 249.04,
   "text": "فرمودند که خدا ملک رو آفرید عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.04,
   "end": 254.68,
   "text": "بدون شهوت. حیوان را آفرید شهوت محض بدون عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.68,
   "end": 258.14,
   "text": "انسان را آفرید دارای هم عقل، هم شهوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 258.14,
   "end": 261.68,
   "text": "به همین راحتی. بعد حضرت فرمودند این کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.68,
   "end": 266.68,
   "text": "امیرالمؤمنین یعنی امام صادق به نقل از مولامون علی فرمودند صلوات الله علیه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.68,
   "end": 272.68,
   "text": "فرمود اگر عقلش پیروز بشه، غالب بشه این از ملک بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.68,
   "end": 277.92,
   "text": "و اگر خدای نکرده شهوتش پیروز بشه از حیوان پست‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 277.92,
   "end": 284.4,
   "text": "به همین راحتی. بعد در هر حال اگر عقل، عقل انسان حاکم بر وجود شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.4,
   "end": 287.78,
   "text": "انسان برترین موجود نظام هستی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 287.78,
   "end": 290.72,
   "text": "و رو دستشم دیگه چیز دیگه‌ای نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 290.72,
   "end": 295.42,
   "text": "ان شاء الله عاقبتمون ختم بخیر باشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.42,
   "end": 300.3,
   "text": "الله- اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}