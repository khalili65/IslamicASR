   "start": 12.16,
   "end": 35.4
  },
  {
   "index": 1,
   "title": "## کلمهٔ پنجاه و دو؛ دقت در معرفت نفس",
   "start": 35.4,
   "end": 105.1
  },
  {
   "index": 2,
   "title": "## نیروی بینش و نیروی کنش",
   "start": 105.1,
   "end": 169.74
  },
  {
   "index": 3,
   "title": "## تا جنت اللقا و جنت ذات",
   "start": 169.74,
   "end": 230.58
  },
  {
   "index": 4,
   "title": "## رئیس کمالات معتبر در قوهٔ نظری",
   "start": 230.58,
   "end": 304.4
  },
  {
   "index": 5,
   "title": "## رئیس قوهٔ عملی و فعلیت دو بال",
   "start": 304.4,
   "end": 865.51
  },
  {
   "index": 6,
   "title": "نکته‌ای خیلی شیرین در دل این آیه نهفته است، آیهٔ شریفه:",
   "start": 865.51,
   "end": 945.21
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.88,
   "end": 4.5,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.5,
   "end": 7.76,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.76,
   "end": 10.2,
   "text": "و ربانیة آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.2,
   "end": 12.16,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.16,
   "end": 17.76,
   "text": "علیرغم این که بعضی‌ها شبهه می‌ندازن در خصوص حضور زن‌ها در مسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.76,
   "end": 21.1,
   "text": "و میگن که نظر پیغمبر به این بوده که زن‌ها داخل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.1,
   "end": 27.74,
   "text": "خونه باید نمازشونو بخونن و این‌ها یا کراهت داره حضورشون، رهبر عزیزمون این فرمود بی‌اشکال است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.74,
   "end": 34.8,
   "text": "حضور خانم‌ها و بانوان در مسجد و اتفاقا به ثواب جماعت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.8,
   "end": 43.72,
   "text": "می‌رسن. می‌رسیم سراغ کلمه پنجاه و دو از صد کلمه در معرفت نفس حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.72,
   "end": 46.72,
   "text": "این کلمه به حق حداقل یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.72,
   "end": 49.9,
   "text": "دهه می‌طلبه که درون مایش باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.9,
   "end": 54.0,
   "text": "خیلی پر مغز و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.0,
   "end": 61.82,
   "text": "کثیر الفروع مطالب عالی رو حضرت استاد با یک زیرکی خاصی بیان کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.82,
   "end": 63.92,
   "text": "که امیدوارم حوصله‌ش رو داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.92,
   "end": 67.46,
   "text": "اگرچه ما سعی می‌کنیم رقیقش کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.46,
   "end": 70.34,
   "text": "و خیلی سنگین بیان نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.34,
   "end": 80.08,
   "text": "دیگه توکل به خدا. ایشون می‌فرماید که آن که در معرفت نفس دقیق شود، ببینید دقت لازمه در سیر معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.08,
   "end": 82.96,
   "text": "اون هم می‌فرماید وقتی دقیق شد چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.96,
   "end": 85.52,
   "text": "می‌بیند نه که بداند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.52,
   "end": 89.4,
   "text": "می‌بیند که او را دو قوه نظری و عملیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.4,
   "end": 92.52,
   "text": "قبلاً هم عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.52,
   "end": 100.8,
   "text": "مثلاً در بحث حکمت، حکمت نظری، حکمت عملی یا حتی عرفان ع-- نظری، عرفان عملی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.8,
   "end": 103.58,
   "text": "عقل نظری، عقل عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.58,
   "end": 108.64,
   "text": "اینا رو قبلاً صحبت کردیم. حالا اینجا حضرت استاد می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.64,
   "end": 110.82,
   "text": "دو تا قوه داریم، نظری و عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.82,
   "end": 117.68,
   "text": "حالا بخوان توضیح بدن. قوه نظری را قوه علامه از علم میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.68,
   "end": 120.4,
   "text": "و نیروی بینش گویند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.4,
   "end": 123.24,
   "text": "حالا اسمی که حضرت استاد می‌گذارند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.24,
   "end": 126.36,
   "text": "نیروی بینش، همون قوه علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.36,
   "end": 130.46,
   "text": "و عملی را یعنی قوه عملی را قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.46,
   "end": 134.86,
   "text": "عماله با عین. عماله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.86,
   "end": 138.42,
   "text": "از عمل میاد و نیروی کنش گویند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.42,
   "end": 141.12,
   "text": "پس اون نیروی بینش، این نیروی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.12,
   "end": 145.94,
   "text": "کنش، اون قلو-- قوه علامه، این قوه عماله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.94,
   "end": 155.56,
   "text": "اون نظری، این عملی. این دو قوه به منزلت دو بال نفس‌اند که بدان‌ها به اوج حقایق طیران می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.56,
   "end": 158.86,
   "text": "پس نفس انسان اگر بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.86,
   "end": 165.14,
   "text": "طیران کنه، پرواز کنه، اونم به اوج حقایق بخواد برسه، قطعاً این دو بال رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.14,
   "end": 168.04,
   "text": "نیاز داره که با یک بال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.04,
   "end": 172.16,
   "text": "محال پرواز. خب تا به کجا میخواد پرواز کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.16,
   "end": 174.0,
   "text": "تا به جنت اللقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.0,
   "end": 176.96,
   "text": "به به، به به. تو بحث لقاء الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.96,
   "end": 179.78,
   "text": "لقاء الهی، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.78,
   "end": 183.86,
   "text": "جایی که ملاقات صورت می‌گیره اصلاً بهش میگن جنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.86,
   "end": 189.78,
   "text": "حالا می‌فرماید که این اوج طیران تا جایی میره که به جنت اللقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.78,
   "end": 192.18,
   "text": "اصلاً بهشتش بهشت لقائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.18,
   "end": 195.74,
   "text": "نه سیب و گلابی و قصور و حور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.74,
   "end": 200.12,
   "text": "تا به جنت اللقا و جنت ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.12,
   "end": 205.2,
   "text": "که همون حالا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.2,
   "end": 207.4,
   "text": "که از ته امام علیه الرحمه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.4,
   "end": 209.4,
   "text": "یا آخر رو فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.4,
   "end": 216.94,
   "text": "یا ذاتی‌ست. یعنی تا به جنت اللقا و جنت ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.94,
   "end": 219.7,
   "text": "می‌رسد. میره تا اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.7,
   "end": 222.3,
   "text": "تا اون اوج طیرانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.3,
   "end": 226.32,
   "text": "برای رسیدن به حقایق به اونجا می‌کشونه انسان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.32,
   "end": 230.58,
   "text": "البته عرض شد که قصد که هر دو بال فعال باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.58,
   "end": 234.24,
   "text": "حالا رئیس کمالات معتبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.24,
   "end": 240.26,
   "text": "اون، اون رئیس، اون کسی که حرف اول رو می‌زنه، همه تحت امرشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.26,
   "end": 245.42,
   "text": "اونم کمالات معتبر، اون کمالاتی که اعتبار شده‌اند، معتبرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.42,
   "end": 248.68,
   "text": "در قوه نظری چیه به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.68,
   "end": 252.04,
   "text": "رئیس کمالات معتبر در قوه نظری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.04,
   "end": 255.74,
   "text": "اینجا حضرت استاد می‌فرمایند معرفت الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.74,
   "end": 267.06,
   "text": "یادتونه در بحث لقاء الله در اون فرمایش شریف ملا محسن در معانی لقاء الله انتهای بحث عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.06,
   "end": 271.5,
   "text": ". اون بذر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.5,
   "end": 278.42,
   "text": "شهود معرفته. حالا اینجا می‌فرماید که اون رئیس این کمالات معتبر تو قوه نظری معرفت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 278.42,
   "end": 281.7,
   "text": "اونم نه هر معرفتی. اتفاقاً وقتی شما در صحف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 281.7,
   "end": 285.48,
   "text": "نوریه عرفانیه و حکمیه دقت می‌کنید، می‌بینید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.48,
   "end": 292.64,
   "text": "اصلاً اون خمیرمایه و درون مایه و اون شیرازه و مخ و لب با اصلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.64,
   "end": 295.04,
   "text": "اصلاً همین بحث معرفت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.04,
   "end": 298.22,
   "text": "حتی مسیر معرفت نفس هم انسان رو به اونجا می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.22,
   "end": 303.38,
   "text": "این رئیس کمالاته در این مسیره، معرفت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 303.38,
   "end": 305.38,
   "text": "خب بقیه. و در قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 305.38,
   "end": 309.96,
   "text": "عملی، حالا در قوه عملی کمالات معتبر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 309.96,
   "end": 312.76,
   "text": "و در قوه عملی طاعت الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.76,
   "end": 316.12,
   "text": "اونجا معرفت الله، اینجا طاعت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.12,
   "end": 319.96,
   "text": "که به حسب شرعیات و عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.96,
   "end": 325.14,
   "text": "اخلاقیات و سیر و سلوک و این‌ها عملیات بندگی‌ش رو به نحو احسن انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.14,
   "end": 331.76,
   "text": "خودش رو صادقانه بسپره به حضرات حق و اوامر و نواهی رو لحاظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.76,
   "end": 340.16,
   "text": "این میشه. پس و در قوه عملی طاعت الله و به حسب مراتب فعلیت این دو قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.16,
   "end": 342.26,
   "text": "انسان را درجات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 342.26,
   "end": 348.44,
   "text": "خب نسبت به اینکه این دو قوه، این دو تا استعدادی که در وجود انسان هست چگونه شکوفا بشوند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 348.44,
   "end": 352.72,
   "text": "انسان درجاتش بر اساس اون مشخص میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.72,
   "end": 356.64,
   "text": "که خیلی شیرین با زیرکی خاصی حضرت استاد اینجا سه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.64,
   "end": 360.12,
   "text": "سه بخش از سه آیه رو با همدیگه میارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 360.12,
   "end": 363.72,
   "text": "پیوند میدن. که با هم مرتبط هم هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.72,
   "end": 373.82,
   "text": "اول از، اه، آیه یازده مجادله استفاده می‌کنن این بخش رو که \"یرفع الله الذین آمنوا منکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 373.82,
   "end": 377.1,
   "text": "والذین أوتوا العلم درجات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 377.1,
   "end": 380.36,
   "text": "که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 380.36,
   "end": 382.44,
   "text": "رف-رفعت می‌بخشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 382.44,
   "end": 386.94,
   "text": "از اونایی که از بین شما اونایی که ایمان آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 386.94,
   "end": 392.3,
   "text": "و کسانی که صاحب علم شدن رو درجات بهشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.3,
   "end": 402.3,
   "text": "بعد ا-تیکه بعدی رو از آیه صد و سی و دو انعام اقتباس می‌کنن که \"ولکل درجات مم ما عملوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 402.3,
   "end": 406.58,
   "text": "که بر اساس اون اِم-- چیزی که عمل می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 406.58,
   "end": 408.84,
   "text": "اِم، اینا مدرج می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 408.84,
   "end": 411.94,
   "text": "درجات، درجات متفاوت پیدا می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 411.94,
   "end": 415.82,
   "text": "از هر درجه‌ای. بعد بقیه‌ش رو هم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 415.82,
   "end": 422.24,
   "text": "آیه ده فاطر اقتباس می‌کنن بقیه کلمه رو که \"إليه يصعد الكلم الطيب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 422.24,
   "end": 425.22,
   "text": "والعمل الصالح يرفعه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 425.22,
   "end": 431.82,
   "text": "بعد ادامه میدن که کلم-كلم طيب اینجا کلم طيب کجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 431.82,
   "end": 437.14,
   "text": "إليه يصعد این کلم طيب به سمت خدا صعود می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 437.14,
   "end": 442.1,
   "text": "می‌فرماید که کلم طيب ارواح طاهره مؤمنان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 442.1,
   "end": 445.76,
   "text": "ارواح طاهره یعنی اون ارواحی که پاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 445.76,
   "end": 448.12,
   "text": "ماندن یا پاک شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 448.12,
   "end": 451.98,
   "text": "اون‌ها صعود می‌کنند. و خب حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 451.98,
   "end": 456.82,
   "text": "چی این صعود رو کمک می‌کنه و رفعت می‌بخشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 456.82,
   "end": 461.14,
   "text": "به ارواح مؤمنان یاری می‌رسه که اون‌ها رفعت پیدا کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 461.14,
   "end": 464.18,
   "text": "علو مکان پیدا کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 464.18,
   "end": 467.66,
   "text": "و عمل صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 467.66,
   "end": 472.56,
   "text": "و عمل صالح. چون فرمود که \"والعمل الصالح يرفعه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 472.56,
   "end": 475.84,
   "text": "و عمل صالح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 475.84,
   "end": 479.26,
   "text": "کردار نیکو و معارف عقلیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 479.26,
   "end": 484.14,
   "text": "حالا اینجا حضرت استاد توضیح میدن که منظور از این عمل صالح در این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 484.14,
   "end": 487.56,
   "text": "که روح مؤمن رو بالا می‌کشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 487.56,
   "end": 492.96,
   "text": "هم کردار نیکوعه هم معارف عقلیه است که رافع روح طيب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 492.96,
   "end": 495.96,
   "text": "باز تاکید می‌کنه رافع روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 495.96,
   "end": 499.8,
   "text": "طيب است نه هر روحی. روح باید پاک باشه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 499.8,
   "end": 502.28,
   "text": "رفعت پیدا کنه بالا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 502.28,
   "end": 506.32,
   "text": "که حالا در این مسیر سه وجودی‌ها متفاوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 506.32,
   "end": 508.58,
   "text": "درجات هم که الا ما شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 508.58,
   "end": 511.82,
   "text": "بی‌نهایت است. لذا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 511.82,
   "end": 520.14,
   "text": "اِم، در میان انبیا هم شما می‌بینید که \"تلک الرسل فضلنا بعضهم على بعض\" حتی انبیا هم بین همدیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 520.14,
   "end": 523.38,
   "text": "دقت می‌کنی می‌بینی فضیلت و برتری دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 523.38,
   "end": 525.34,
   "text": "درجاتشون با هم متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 525.34,
   "end": 526.9,
   "text": "اصلاً همه چیز رو مراتب‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 526.9,
   "end": 532.68,
   "text": "خب شما تو خود حکمت وقتی دقت می‌کنید خود حکمت، حکمت اعلی، حکمت اوسط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 532.68,
   "end": 535.6,
   "text": "حکمت ادنی. عرفان هم هم‌چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 535.6,
   "end": 538.44,
   "text": "چه در بحث نظر، چه در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 538.44,
   "end": 540.54,
   "text": "عمل این چنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 540.54,
   "end": 546.18,
   "text": "به قول حکما اون موجودات که تحت اختیار ما نیستند سه قسمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 546.18,
   "end": 549.08,
   "text": "یا، اِم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 549.08,
   "end": 552.88,
   "text": "چه در خارج یعنی خارج از ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 552.88,
   "end": 556.6,
   "text": "چه در ذهن ما باشن محتاج به ماده نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 556.6,
   "end": 560.46,
   "text": "چه در خارج از ما باشن، چه در ذهن ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 560.46,
   "end": 563.64,
   "text": "یعنی صورت علمیه در ذهن ما پیدا کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 563.64,
   "end": 565.6,
   "text": "اینا محتاج به ماده نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 565.6,
   "end": 569.84,
   "text": "مثل چی؟ اِم، که به اینا میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 569.84,
   "end": 574.84,
   "text": "حکمت به معنی أعم دیگه می‌دونید یا علم کلی یا فلسفه اولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 574.84,
   "end": 579.12,
   "text": "مثل مثلاً ملائکه، عقول مجرده، نفس ناطقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 579.12,
   "end": 583.66,
   "text": "مثل خود حضرت حق، ذات باری این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 583.66,
   "end": 586.9,
   "text": "که بهش میگن به این قبیل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.9,
   "end": 590.7,
   "text": "به این حکمت، به این قسمت حکمت میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 590.7,
   "end": 595.0,
   "text": "اِم، حکمت کلی یا فلسفه اولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 595.0,
   "end": 598.2,
   "text": "اِم، یا اینکه موجوداتی هستند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 598.2,
   "end": 604.74,
   "text": "در ذهن ما ماده معینه نمی‌خوان ولی در خارج محتاج به ماده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 604.74,
   "end": 607.68,
   "text": "مثل علوم ریاضی که به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 607.68,
   "end": 611.38,
   "text": "علامه فاضل تونی استاد حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 611.38,
   "end": 617.36,
   "text": "مثلاً در تصور اعداد مثل یک و دو یا مثلاً سه و چهار این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 617.36,
   "end": 621.0,
   "text": "این‌ها تصورشون در ذهن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 621.0,
   "end": 623.16,
   "text": "ماده معینه نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 623.16,
   "end": 627.0,
   "text": "ولی در خارج داره. در خارج باید بالاخره ماده معینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 627.0,
   "end": 630.34,
   "text": "این یک از دو کمتره، اون از این بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 630.34,
   "end": 634.24,
   "text": "این شیوه هم در ذهن ماده معینه‌ای نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 634.24,
   "end": 640.24,
   "text": "که، اِم، علم به چنین موجوداتی رو میگن علم اوسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 640.24,
   "end": 645.24,
   "text": "که بهترین مصداقش میشه گفت علم ریاضیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 645.24,
   "end": 652.34,
   "text": "و البته دسته سوم هم یه سری موجوداتی هستند که تحت قدرت ما نیستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 652.34,
   "end": 656.04,
   "text": "توی خارج، اِم، و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 656.04,
   "end": 660.78,
   "text": "در ذهن ما ماده معینه دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 660.78,
   "end": 663.68,
   "text": "در بیرون هم دارند. یعنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 663.68,
   "end": 670.1,
   "text": "اِم، هم در خارج از ما ماده معینه دارند هم در ذهن ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 670.1,
   "end": 672.28,
   "text": "در هر دو ماده معینه دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 672.28,
   "end": 676.88,
   "text": "مثل مثلاً میوه‌ها. مثل سیب و گلابی و انار و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 676.88,
   "end": 680.12,
   "text": "که هم در ذهن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 680.12,
   "end": 682.84,
   "text": "در صورت علمیه که در ذهن ما دارن هم از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 682.84,
   "end": 686.28,
   "text": "هم بیرون ماده معینه دارن که به این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 686.28,
   "end": 691.22,
   "text": "به این قبیل علم میگن علم یا حکمت طبیعی یا علم ادنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 691.22,
   "end": 693.54,
   "text": "که دیگه مثلاً ادنی‌ست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 693.54,
   "end": 697.12,
   "text": "از جهت فلسفی همه پایین‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 697.12,
   "end": 702.52,
   "text": "که حالا به تعبیر علامه رفیع قزوینی علیه رحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 702.52,
   "end": 706.9,
   "text": "از قوه عملیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 706.9,
   "end": 709.72,
   "text": "ایشون تعبیرشون این بود که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 709.72,
   "end": 713.0,
   "text": "اِم، در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 713.0,
   "end": 716.4,
   "text": "نفس انسانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 716.4,
   "end": 722.46,
   "text": "این قوه عملیه کارفرمای بدن جسمانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 722.46,
   "end": 726.47,
   "text": "اِم، برای چی؟ برای رسیدن به اوج سعادت و کمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 726.47,
   "end": 729.37,
   "text": "که خیلی مهمه. کارفرماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 729.37,
   "end": 732.33,
   "text": "یعنی اون قوه نظری رو بلده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 732.33,
   "end": 740.65,
   "text": "قوه عملی می‌کنه. که این دو باید به همدیگه کمک کنن تا انسان رو به سرمنزل سعادت برسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 740.65,
   "end": 745.21,
   "text": "که البته خب در بحث قوه عملی در کتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 745.21,
   "end": 748.29,
   "text": "قم مضبوط است مواردی حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 748.29,
   "end": 750.61,
   "text": "غالباً چهارگانه قو-- این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 750.61,
   "end": 754.65,
   "text": "مراتب چهارگانه قوه عملیه رو می‌شمارن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 754.65,
   "end": 760.53,
   "text": "از هزیج طبیعت به ذروه اولیای انسانیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 760.53,
   "end": 764.23,
   "text": "اه همین توسط مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 764.23,
   "end": 767.03,
   "text": "عقل عملی انسان رو می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 767.03,
   "end": 771.95,
   "text": "که حالا فرمودن اولیش تجلیه است بعد تخلیه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 771.95,
   "end": 774.29,
   "text": "بعد تحلیه است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 774.29,
   "end": 777.49,
   "text": "آخریشم فنا. که خود فنا هم مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 777.49,
   "end": 780.77,
   "text": "حالا تجلیه رو که فرمودن که همه قوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 780.77,
   "end": 786.61,
   "text": "و اعضای بدن به مراقبت کامل برن و تحت اوامر و نواهی الهی قرار بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 786.61,
   "end": 790.61,
   "text": "تخلیه رو گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 790.61,
   "end": 794.49,
   "text": "دیگه اسمش رو خودشه. تخلیه انسان وجودش از اخلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 794.49,
   "end": 796.89,
   "text": "هست و رذیله باطنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 796.89,
   "end": 800.15,
   "text": "پاک بشه. تحلیه هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 800.15,
   "end": 805.71,
   "text": "دیوچه بیرون رود فرشته درآید تا می‌تونه زینت ببخشه به صفات حمیده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 805.71,
   "end": 808.41,
   "text": "اسرار شریفه خانه دلش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 808.41,
   "end": 810.53,
   "text": "مزین کنه. یا متخلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 810.53,
   "end": 814.93,
   "text": "بشه به اخلاق الله. و بحث فنا هم که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 814.93,
   "end": 817.37,
   "text": "قبلاً عرض شده فناء در افعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 817.37,
   "end": 822.49,
   "text": "و فناء در صفات و فناء در ذات که بحثش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 822.49,
   "end": 826.85,
   "text": "که این‌ها در مجموع انسان رو به جایی می‌رسونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 826.85,
   "end": 830.15,
   "text": "به عالی‌ترین مراتب برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 830.15,
   "end": 833.71,
   "text": "و البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 833.71,
   "end": 839.79,
   "text": "مراتب درجات انسان رو حضرت استاد در این موضوع و در این کلمه پنجاه و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 839.79,
   "end": 844.85,
   "text": "متفرع بر مراتب فعلیت این دو قوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 844.85,
   "end": 848.43,
   "text": "یعنی همون قوه نظری و قوه عملی دونسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 848.43,
   "end": 850.49,
   "text": "که از این دو باید رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 850.49,
   "end": 855.89,
   "text": "البته نکته‌ای هم در یک نکته خیلی شیرین و جالبی هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 855.89,
   "end": 858.81,
   "text": "در دل این آیه نهفته است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 858.81,
   "end": 865.51,
   "text": "آیه شریفه \"یرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 865.51,
   "end": 872.33,
   "text": "خدا رحمت کنه از علامه طباطبایی در تفسیر شریف المیزانشون میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 872.33,
   "end": 877.23,
   "text": "می‌فرماید که مسئله رفع درجات که تو آیه شریفه مورد بحثه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 877.23,
   "end": 879.47,
   "text": "مخصوص علمایی از مؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 879.47,
   "end": 882.51,
   "text": "یعنی اینطوری نیستش که بقیه به درجات برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 882.51,
   "end": 887.89,
   "text": "چون می‌فرماید \"والذين أوتوا العلم درجات\" اونایی که دارای علمند درجات دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 887.89,
   "end": 891.71,
   "text": "ولی اهل ایمانی که خیلی تو مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 891.71,
   "end": 896.49,
   "text": "علمی و حکمت و عرفان و این‌ها ورود نکردن درجه دارن نه درجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 896.49,
   "end": 899.21,
   "text": "یعنی یک درجه. چند درجه نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 899.21,
   "end": 907.27,
   "text": "لذا حضرت علامه، حضرت علامه طباطبایی علیه الرحمه می‌فرمایند که تقریر این آیه چنین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 907.27,
   "end": 911.51,
   "text": "\"یرفع الله الذين آمنوا منكم درجة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 911.51,
   "end": 914.45,
   "text": "اونایی که اهل ایمانند و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 914.45,
   "end": 916.09,
   "text": "درجه، یه درجه پیدا می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 916.09,
   "end": 919.25,
   "text": "\"والذين آمنوا و أوتوا العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 919.25,
   "end": 922.55,
   "text": "درجات\" و اونایی که ایمان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 922.55,
   "end": 928.37,
   "text": "علم رو، یعنی این دو قوه رو با هم برداشتن این‌ها دیگه درجات پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 928.37,
   "end": 932.51,
   "text": "که حالا به نظر ایشون می‌فرمود که خیلی هم شیرین و خوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 932.51,
   "end": 938.31,
   "text": "که در این آیه شریفه تعظیمی و احترامی از علمای امت شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 938.31,
   "end": 940.25,
   "text": "که خیلی شیرین و عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 940.25,
   "end": 942.41,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 942.41,
   "end": 945.21,
   "text": "به برکت صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}