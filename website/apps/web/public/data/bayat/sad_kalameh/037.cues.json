 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ سی‌وششم؛ علم بصر نفس",
   "start": 11.52,
   "end": 66.32
  },
  {
   "index": 1,
   "title": "## رسالهٔ اتحاد عاقل و معقول؛ سه گونه اتحاد",
   "start": 66.32,
   "end": 194.58
  },
  {
   "index": 2,
   "title": "## مثال چراغ‌ها؛ نور واحد در فضا",
   "start": 194.58,
   "end": 325.1
  },
  {
   "index": 3,
   "title": "## علم الأبدان و علم الأدیان؛ شرافت توحید",
   "start": 325.1,
   "end": 595.27
  },
  {
   "index": 4,
   "title": "## داستان فرزند شهید و عطرفروشی",
   "start": 595.27,
   "end": 740.41
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 3.9,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.9,
   "end": 6.76,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.76,
   "end": 11.52,
   "text": "و ربانی آیاته السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.52,
   "end": 14.78,
   "text": "کلمه سی و ششم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.78,
   "end": 16.94,
   "text": "آن که در حقیقت علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.94,
   "end": 21.9,
   "text": "درست تأمل کند که بصر نفس می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.9,
   "end": 24.88,
   "text": "علم میشه چشم نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.88,
   "end": 28.38,
   "text": "و او را از ظلمت به ضیا می‌کشاند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.38,
   "end": 32.04,
   "text": "علمه که انسان را از تاریکی به نور می‌کشاند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.04,
   "end": 38.16,
   "text": "کسی که اینو توجه کنه حضرت استاد می‌فرمایند که آگاه گردد که نور علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.16,
   "end": 42.64,
   "text": "نفس نفس و عین ذات او می‌گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.64,
   "end": 45.32,
   "text": "یعنی ما عینیت پیدا می‌کنیم با علممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.32,
   "end": 52.32,
   "text": "همون که عرض کردیم بعد از مرگ نفسمون و جانمون حقیقت علممونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.32,
   "end": 56.68,
   "text": "و ادامه میدن که و به سر اتحاد عا- عالم و معلوم یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.68,
   "end": 60.54,
   "text": "علم و عالم و معلوم بحسب وجود می‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.54,
   "end": 63.46,
   "text": "به این سر می‌رسه که اتحاد بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.46,
   "end": 66.32,
   "text": "علم و عالم و معلوم رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.32,
   "end": 69.78,
   "text": "توضیح میدم کلاً رساله شریف و عرشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.78,
   "end": 72.0,
   "text": "اتحاد عاقل به معقول حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.0,
   "end": 74.76,
   "text": "استاد علامه رفیعی قزوینی اس-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.76,
   "end": 79.76,
   "text": "استاد و شیخ حضرت علامه حسن زاده بودن ایشونو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.76,
   "end": 81.72,
   "text": "این کتاب بسیار عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 81.72,
   "end": 86.46,
   "text": "الحمدلله ترجمه فارسیش هم هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.46,
   "end": 91.92,
   "text": "و خود علامه هم شرح دادن این کتاب رو که خودش یه رساله مفصوت و جو- جداگونه‌ای شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.92,
   "end": 98.62,
   "text": "اونجا این اتحاد عاقل-- کلاً اتحاد رو سه گونه بیان می‌کنه علامه رفیعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.62,
   "end": 102.64,
   "text": "یکی می‌فرمود که اتحاد از نوع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.64,
   "end": 106.32,
   "text": "اِممم مثل مثلاً جنس و فصل که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.32,
   "end": 110.34,
   "text": "از یک وجودند. مثل این‌که جن-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.34,
   "end": 113.62,
   "text": "جنس و فصل ه- هر دو از نوع‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.62,
   "end": 116.86,
   "text": "یه بحث فلسفی داره که کاری به اون نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.86,
   "end": 122.96,
   "text": "بعد دومیشو میگه مثل اتحاد دو چیزی که در عرض هم‌اند و این محاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.96,
   "end": 125.04,
   "text": "مثل اتحاد زید و عم با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.04,
   "end": 126.62,
   "text": "زید و عم بشن یک حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.62,
   "end": 132.46,
   "text": "نمیشه نار و نور بشن یک-- یا مثلاً آتش و آب بشن یک حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.46,
   "end": 135.28,
   "text": "نمیشه. این اتحاد هم که اصلاً محاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.28,
   "end": 140.9,
   "text": "اون اتحاد عاقل به معقول که مدنظر ایشون هست مثال می‌زنن میگن مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.9,
   "end": 144.22,
   "text": "اتحاد دو چیزی که در طول هم‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.22,
   "end": 153.1,
   "text": "و اون دومی ارتقاء یافته و رشد یافته و کمال یافته این اولی‌ست یا به عبارتی سبب ارتقا و استکمال اولی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.1,
   "end": 157.16,
   "text": "یعنی چی؟ مثل بچه که جوون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.16,
   "end": 159.2,
   "text": "در طول هم‌اند. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.2,
   "end": 161.7,
   "text": "اون دومی چیه؟ ارتقاء یافته همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.7,
   "end": 164.16,
   "text": "اینا در طول هم‌اند. یک حقیقت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.16,
   "end": 169.48,
   "text": "الان شما همون بچه‌ای نیستی که مثلاً ده سالت بود از شما سؤال کن آقا همونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.48,
   "end": 172.74,
   "text": "میگی بله همونم. چرا اینقدر عوض شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.74,
   "end": 176.24,
   "text": "این وجود با اون وجود متحد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.24,
   "end": 179.6,
   "text": "یا اتحاد بین همین علم و عمه-- علم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 179.6,
   "end": 183.58,
   "text": "عالم و معلوم و این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.58,
   "end": 190.6,
   "text": "این اتحادی که اینجا علامه رفیع قزوینی میگه یا مثلا حضرت استاد می‌فرماوند که اگه توجه کنی به حقیقت علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.6,
   "end": 194.58,
   "text": "می‌بینی که تو با علمت متحد میشی از اونی-- از این نوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.58,
   "end": 200.16,
   "text": "مثالی که خلاصه در انتهای خود رساله حضرت علامه میزنه علامه رفیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.16,
   "end": 202.56,
   "text": "خیلی شیرینه همه فهمش می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.56,
   "end": 206.66,
   "text": "مثال می‌فرمايد که اصلاً می‌دونید ما الان دائماً در حال س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 206.66,
   "end": 209.24,
   "text": "خود نفس ما در حال سیرورثیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.24,
   "end": 212.38,
   "text": "در حال شدنیم. دا- دائماً داریم می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 212.38,
   "end": 215.6,
   "text": "بحثی که دیروز داشتیم ن وَالْقَلَمِ وَمَا يَسْطُرُونَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.6,
   "end": 219.82,
   "text": "داریم با قلم خودمون به دست خودمون، خودمون رو می‌نویسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.82,
   "end": 223.32,
   "text": "داریم می‌شیم با عمل و علممون، با این دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 223.32,
   "end": 225.58,
   "text": "داریم می‌شویم سیرورت. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 225.58,
   "end": 229.5,
   "text": "چون علم نه-- نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.5,
   "end": 232.58,
   "text": "عالمم نوره یا عقل نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 232.58,
   "end": 239.32,
   "text": "عاقل نوره معقولم نوره همه‌شون از جنس نورند، حضرت علامه رفیع قزوینی می‌فرمايد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.32,
   "end": 245.12,
   "text": "چون همه نورند از یک حقیقت می-- یعنی میشن یک حقیقت در انتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.12,
   "end": 248.8,
   "text": "بعد مثال شیرینی که همه فهمه اینجا اینطوری می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.8,
   "end": 254.84,
   "text": "مثل چراغ، این چراغ‌هایی من تو همین در حسینه حسینیه ببینید چند تا چراغ روشنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.84,
   "end": 261.5,
   "text": "وقتی به خود چراغ نگاه می‌کنی ماده رو می‌بینی، شیئیت شی رو صورتش رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.5,
   "end": 263.78,
   "text": "می‌بینی این جدای از اونه، اون از این جداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.78,
   "end": 266.68,
   "text": "حتی بعضیا ضعیفه نورش اون قویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.68,
   "end": 269.44,
   "text": "درسته یکی پرژکتوره یکی شمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.44,
   "end": 271.98,
   "text": "اما وقتی نگاه می‌کنی به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.98,
   "end": 274.48,
   "text": "انعکاسی که از اینا رخ داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.48,
   "end": 277.78,
   "text": "اتحادی که بین اینا، پیرامون این‌ها رخ داده یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.78,
   "end": 281.24,
   "text": "یعنی به این فضا که نگاه می‌کنی می‌بینی همه جا پر نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 281.24,
   "end": 284.2,
   "text": "خب این نوری که الان تو این فضا هست چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 284.2,
   "end": 286.38,
   "text": "این اتحاد همون حقیقتی که داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 286.38,
   "end": 290.14,
   "text": "این اتحاد همین تجلی‌ای که از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.14,
   "end": 293.68,
   "text": "ماده‌های این چراغ‌ها داره رخ میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.68,
   "end": 299.2,
   "text": "بیرون از این چراغ‌ها وقتی شما اون حقیقت کلیو می‌بینی، می‌بینی نوره، همه جا نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.2,
   "end": 303.44,
   "text": "نمی‌تونی بگی این نوری که الان در این سالن هست مال کدوم چراغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.44,
   "end": 305.64,
   "text": "یک حقیقته. در ح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 305.64,
   "end": 308.2,
   "text": "در انتها ما می‌فهمیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.2,
   "end": 312.24,
   "text": "علم وقتی اخذ می‌کنیم عین نفسمون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 312.24,
   "end": 316.0,
   "text": "چون اون نوره نفسمون که نفس 나طق ما که النور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 316.0,
   "end": 319.18,
   "text": "من فخت فيهم الروحی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 319.18,
   "end": 321.26,
   "text": "نور السماوات والارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.26,
   "end": 322.82,
   "text": "پس ما عین علممون میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 322.82,
   "end": 325.1,
   "text": "باید ببینیم چه علمی رو داریم اخذ می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.1,
   "end": 328.0,
   "text": "البته العلم، العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 328.0,
   "end": 329.82,
   "text": "علمان. علم دو گونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 329.82,
   "end": 333.56,
   "text": "علم الاب- الأبدان علم بدن‌ها یعنی طب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 333.56,
   "end": 336.6,
   "text": "و علم الأدیان. اون که افضل علم أدیانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 336.6,
   "end": 339.28,
   "text": "البته علم الأبدان یعنی طب مقدمه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 339.28,
   "end": 342.06,
   "text": "یعنی آدم باید یه حد اقلی از طب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 342.06,
   "end": 344.64,
   "text": "بدونه، از علوم تجربی رو بدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 344.64,
   "end": 351.0,
   "text": "ولی اصل اون که شرافت داره، برتری داره، شرف داره علم أدیانه، علم الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 351.0,
   "end": 357.04,
   "text": "علم أدیان معرفة الجبار شناخت حضرت حقه، علم توحیدیه این از همه افضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 357.04,
   "end": 359.06,
   "text": "اصلاً علم از همه چی افضل‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 359.06,
   "end": 363.24,
   "text": "اصلاً بزرگان و حکما و عرفا فرمودن خدا خودش علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 363.24,
   "end": 365.47,
   "text": "اصلاً علمه، خدا علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 365.47,
   "end": 369.67,
   "text": "صفت دیگه. وقتی می‌خوای خدا رو بخونی که عین علمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 369.67,
   "end": 373.37,
   "text": "میشه علیم اسم پیدا می‌کنه که بتونی بخونیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 373.37,
   "end": 375.51,
   "text": "ظهور کنه که بتونی باهاش ارتباط بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 375.51,
   "end": 377.93,
   "text": "میشه علیم. العالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 377.93,
   "end": 381.43,
   "text": "العلیم. و الا اصلاً خدا علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 381.43,
   "end": 385.23,
   "text": "لذا اصلاً با شرافت، با شرافت‌تر از علم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 385.23,
   "end": 390.81,
   "text": "نداریم. این بحثی که از قدیمام می‌گفتن یادتونه وقتی بچه بودیم علم بهتر است یا ثروت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 390.81,
   "end": 394.21,
   "text": "همیشه انشاش می‌کردن تو مدارس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 394.21,
   "end": 396.63,
   "text": "الان به اونجا رسیدیم به اون بحث اولیمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 396.63,
   "end": 399.93,
   "text": "یه حدیث تقدیم کنم خیلی شیرین در همین باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 399.93,
   "end": 402.51,
   "text": "از اصول کافی جلد یک صفحه سی و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 402.51,
   "end": 405.95,
   "text": "امیرالمؤمنین علیه الصلاة والسلام فرمودند قابل توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 405.95,
   "end": 408.65,
   "text": "منی که از صبح تا شب میدوم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 408.65,
   "end": 410.75,
   "text": "پول و مال و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 410.75,
   "end": 413.11,
   "text": "و از علم البته غافلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 413.11,
   "end": 415.17,
   "text": "مولا فرمود \"ایها الناس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 415.17,
   "end": 416.89,
   "text": "یعنی به همه، همه مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 416.89,
   "end": 418.55,
   "text": "نه شما فقط مذهبی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 418.55,
   "end": 423.01,
   "text": "الناس تازه نمی‌فرماید الانسانا، الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 423.01,
   "end": 428.87,
   "text": "اینا فرق دارن. همه بدونین اعلموا، بدانید مولای امیر بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 428.87,
   "end": 433.83,
   "text": "وصی پیغمبر داره میگه که همه علم نزدش حاضره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 433.83,
   "end": 437.19,
   "text": "به نحو تف-- تفصیل. می‌فرماید ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 437.19,
   "end": 440.91,
   "text": "کمال. میگه اول میگه بدونید آگاه باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 440.91,
   "end": 449.99,
   "text": "ان، ان کمال الدین طلب العلم والعمل کمال دین تو به اینه که علم و عمل رو با هم ورداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 449.99,
   "end": 452.91,
   "text": "یعنی از طریق علم تازه برسی به عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 452.91,
   "end": 455.73,
   "text": "عمل بدون علم هم فایده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 455.73,
   "end": 460.13,
   "text": "الا وقتی میگه الا یه حرف اولاً کلیه برای همه عالمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 460.13,
   "end": 462.37,
   "text": "ثانیاً خیلی مهمه. الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 462.37,
   "end": 465.41,
   "text": "و ان طلب العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 465.41,
   "end": 468.77,
   "text": "اوجب عليكم من طلب المال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 468.77,
   "end": 473.79,
   "text": "طلب علم بر شما واجب‌تر است از طلب مال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 473.79,
   "end": 475.37,
   "text": "بعد توضیح میدن چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 475.37,
   "end": 478.51,
   "text": "چراش رو حضرت می‌فرماید ان المال مقسوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 478.51,
   "end": 481.75,
   "text": "مضموم لکم مضمونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 481.75,
   "end": 486.07,
   "text": "مقسومه، ضمانت شده، قسمت شده لکم برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 486.07,
   "end": 489.59,
   "text": "قد قسمه عادل بینکم و زمنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 489.59,
   "end": 494.43,
   "text": "و سیفی و سیف لکم میاد بر شما وارد میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 494.43,
   "end": 500.05,
   "text": "توسط خدای عادلی که اون رو تقسیم کرده علم میاد مقسومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 500.05,
   "end": 502.55,
   "text": "ز-- ضمانت شده توسط حضرت حق میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 502.55,
   "end": 505.23,
   "text": "والعلم مخزون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 505.23,
   "end": 509.43,
   "text": "عند اهله اما علم در خزانه ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 509.43,
   "end": 513.81,
   "text": "یک جایی قرار گرفت، قرار داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 513.81,
   "end": 516.35,
   "text": "قرار داره. اینطوری نیست که بگی به همه برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 516.35,
   "end": 519.13,
   "text": "نخیر باید سا-- به صاحبان همت می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 519.13,
   "end": 524.11,
   "text": "به صاحبان طهارت نفس و لا یمسه الا المطهرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 524.11,
   "end": 527.93,
   "text": "و هر باید به راه افتاد به قول علامه اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 527.93,
   "end": 532.19,
   "text": "طلب علم بود، اهل همت بود، اهل تلاش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 532.19,
   "end": 534.29,
   "text": "همونطور که یه کاسب می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 534.29,
   "end": 538.47,
   "text": "مثلاً تاجر بین المللی بشه باید صبح تا شب مشغول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 538.47,
   "end": 541.75,
   "text": "کار ااا علمی عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 541.75,
   "end": 545.43,
   "text": "ااا تجارتش باشه و مرا-- مراقب مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 545.43,
   "end": 552.83,
   "text": "این نوسان دلار و سکه و ارز و چی و اینا باشه صبح تا شب باید مراقب باشه یا آدم که می‌خواد عالم بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 552.83,
   "end": 558.91,
   "text": "اصلاً فرصت نمی‌کنه برای دنیاش خیلی وقت بگذره باید و اگه می‌خواد واقعاً ملا بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 558.91,
   "end": 562.47,
   "text": "و یه طوریه بعد میگه آقا چرا این مثلاً علما همش دارن درس می‌خونن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 562.47,
   "end": 566.47,
   "text": "خب می‌خواد عالم بشه. چطور نمیگه اون چرا همش داره کار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 566.47,
   "end": 569.93,
   "text": "بعد اون کسی که عالم میشه همه عالم‌ها در خدمت اونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 569.93,
   "end": 574.49,
   "text": "مثلاً شما باغ داری چون کسی که دنبال علم میره معلم میشه باغ داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 574.49,
   "end": 580.17,
   "text": "ببینیم شاگردش میگه آقای معلم من یه باغی دارم بیا با خونواده‌ت برو هفته‌ای یه بار، ماهی یه بار اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 580.17,
   "end": 586.73,
   "text": "اون اصلاً خادم این شده. اون نانوایی سر کوچه خادم این شده، بقاله خادم این شده، اون فرش فروشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 586.73,
   "end": 589.43,
   "text": "خونه فروشه، ماشین همه خادم این شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 589.43,
   "end": 592.15,
   "text": "این تلاشی برای دنیاش نکرده، این رفته سر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 592.15,
   "end": 595.27,
   "text": "سراغ اون اشرف طلب علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 595.27,
   "end": 597.51,
   "text": "اتفاقاً الان یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 597.51,
   "end": 599.71,
   "text": "داستانی ااا اومد تو ذهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 599.71,
   "end": 602.25,
   "text": "این داستان از در تاریخ اسلام نقل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 602.25,
   "end": 605.85,
   "text": "خیلی شیرینه. اینو خوب توجه کنید به بچه‌هاتونم از الان بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 605.85,
   "end": 607.77,
   "text": "یه بار دیگه همینجا گفته بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 607.77,
   "end": 614.87,
   "text": "یه شهیدی که از دنیا رفت مادرش این بچه رو آو-- بچه‌ی شهیدو، بچه‌ی این شهیدو آورد نزد پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 614.87,
   "end": 619.19,
   "text": "گفت یا رسول الله می‌خوایم بذاریمش سر کار دیگه مثلاً به سن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 619.19,
   "end": 621.57,
   "text": "بلوغ رسیده اینا. مثل الان نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 621.57,
   "end": 624.01,
   "text": "بچه ریشش سفید میشه هنوز بیکاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 624.01,
   "end": 627.49,
   "text": "به سن بلوغ می‌رسید نمی‌ذاشتن بچه بیکار باشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 627.49,
   "end": 631.25,
   "text": "یا رسول الله چه کاری بذاریم؟ پیغمبر فرمود یه تأملی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 631.25,
   "end": 636.99,
   "text": "سریعم جواب ندادن. تأملی کردن فرمودن بذارش عطر فروشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 636.99,
   "end": 643.79,
   "text": "بعد ایشون رفت تشکر کرد و رفت و با عموهای این بچه یعنی برادرای شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 643.79,
   "end": 647.77,
   "text": "مشورت گرفت. اونا گفتن والا پیغمبر یه چیزی فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 647.77,
   "end": 651.65,
   "text": "الان اون که بورسه اون که پول توشه به قول ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 651.65,
   "end": 660.23,
   "text": "آهنگریه. الان ساخت و ساز زیاده اینا بذاریدش آهنگری بابا خیلی پول تو اونه پیغمبر فرمود عطر فروشی پول نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 660.23,
   "end": 661.93,
   "text": "رفتن گذاشتنش آهنگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 661.93,
   "end": 663.97,
   "text": "یه مدتی گذشت جوانی شد و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 663.97,
   "end": 667.11,
   "text": "خلاصه وضعشم خیلی خوب شد وضع مالیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 667.11,
   "end": 669.19,
   "text": "زنه یه روز دوباره رسید به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 669.19,
   "end": 674.01,
   "text": "همون خاطره رو یادآور شد و گفت یا رسول الله ما اومدیم شما فرمودی عطر فروشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 674.01,
   "end": 675.57,
   "text": "وضع مالیشم خوب میشه اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 675.57,
   "end": 679.01,
   "text": "ولی ما گذاشتیم آهنگری وضع مالیش خوب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 679.01,
   "end": 681.57,
   "text": "پیغمبر یه خنده معناداری کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 681.57,
   "end": 683.87,
   "text": "فرمودن اون روز که شما اینو گفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 683.87,
   "end": 687.37,
   "text": "من در لوح محفوظ الهی نظر انداختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 687.37,
   "end": 690.91,
   "text": "دیدم که این بچه از سمت خدا خوش روزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 690.91,
   "end": 694.33,
   "text": "روزیش خشک رقم خورده از سمت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 694.33,
   "end": 696.99,
   "text": "هر کاری بره وضع مالیش خوب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 696.99,
   "end": 701.77,
   "text": "لذا گفتم کارشو آسون کنیم بگیم بذاریم عطر فروشی که زجر نکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 701.77,
   "end": 705.89,
   "text": "شما کارشو سخت کردی ولی با همون روزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 705.89,
   "end": 709.67,
   "text": "ببینید اینا اسرار پیغمبر با زبان عامیانه چگونه بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 709.67,
   "end": 712.31,
   "text": "رزق مقسومه تو بکش خودتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 712.31,
   "end": 714.77,
   "text": "اونچه که قراره به تو برسه میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 714.77,
   "end": 718.29,
   "text": "ولی علم چیه؟ نه میگه مخزون و در خزانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 718.29,
   "end": 721.11,
   "text": "باید تلاش کرد تا رسید و اشرف هم اونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 721.11,
   "end": 728.11,
   "text": "و هرچی به علم رسیدی اون عینیت نفس تو میشه و جان تو رو تشکیل میده بعد از مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 728.11,
   "end": 734.31,
   "text": "چقدر مهمه. ایشالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 734.31,
   "end": 740.41,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}