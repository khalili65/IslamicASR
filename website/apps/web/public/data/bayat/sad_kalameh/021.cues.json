 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ بیستم؛ فهمِ خطابِ محمّدی",
   "start": 0.28,
   "end": 20.46
  },
  {
   "index": 1,
   "title": "## اطّلاع؛ فرا رفتن از ظاهر",
   "start": 20.46,
   "end": 59.8
  },
  {
   "index": 2,
   "title": "## سوگندِ علّامه بر کتبِ حکمی",
   "start": 59.8,
   "end": 310.16
  },
  {
   "index": 3,
   "title": "## حکمتِ فردیّه در فصّ محمّدی",
   "start": 310.16,
   "end": 503.12
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 6.1,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.1,
   "end": 9.36,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.36,
   "end": 13.78,
   "text": "و ربانی یا ای یاس سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.78,
   "end": 18.22,
   "text": "کلمه بیستم. آنکه از اطلاع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.22,
   "end": 25.68,
   "text": "فهم خطاب محمدی صلی الله علیه و آله و سلم- صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.68,
   "end": 27.66,
   "text": "سر باز زده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.66,
   "end": 31.46,
   "text": "اینجا منظور قرآنه. خطاب محمدی یعنی قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.46,
   "end": 36.64,
   "text": "میگه، می‌فرمود آنکه از اطلاع فهم این حقیقت، این قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.64,
   "end": 40.78,
   "text": "سر باز زده است خود را به مفت باخته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.78,
   "end": 44.64,
   "text": "خب به یک معنا ما قرآن انفسیم داریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.64,
   "end": 47.84,
   "text": "ما قرآن انفسیمون همین خودمونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.84,
   "end": 51.24,
   "text": "که در درون، قرآن در درون ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.24,
   "end": 53.76,
   "text": "و در درون ما تعبیه شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.76,
   "end": 58.84,
   "text": "و شب قدر که قرآن به سر می‌گذاریم این دو قرآن رو با هم تطبیق میدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.84,
   "end": 64.34,
   "text": "و در حقیقت اگر کسی از این قرآن بی‌خبره از خودش بی‌خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.34,
   "end": 69.1,
   "text": "لذا می‌فرماید که خود را به مفت باخته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.1,
   "end": 74.4,
   "text": "چه جالب که همه بزرگان اهل معرفت تصریح کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.4,
   "end": 79.86,
   "text": "اون میزانی ما با امام عصرمون ارتباط داریم که با قرآن ارتباط، ارتباط داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.86,
   "end": 84.6,
   "text": "چه میزان با قرآن محشوریم، همون مقدار با امام عصرمون محشوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.6,
   "end": 91.76,
   "text": "امام عصر که تشریف میارن چقدر اجازه داریم با حضرت مس-- مهانست و مجالست و مصاحبت داشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.76,
   "end": 96.36,
   "text": "به همان میزانی که الان با قرآن مهانست و مصاحبت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.36,
   "end": 98.5,
   "text": "مجالست و این‌ها داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.5,
   "end": 101.42,
   "text": "یک چیز اون به هر حال اون اصله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.42,
   "end": 105.56,
   "text": "انسان کامله و این قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.56,
   "end": 107.94,
   "text": "صورت کتبیه همان آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.94,
   "end": 111.7,
   "text": "همین مقدار که الان برای قرآن وقت گذاشتی برای فهمش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.7,
   "end": 116.32,
   "text": "همان مقدار هم برای آقا بعدا هم بهت اجازه همین مقدار میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.32,
   "end": 118.02,
   "text": "راحت می‌شه انسان خودشو بشناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.02,
   "end": 122.38,
   "text": "حالا اینجا جالبه که علامه فرمود از اطلاع فهم خطاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.38,
   "end": 127.28,
   "text": "اطلاع یعنی صرفا فهم نه بلکه اطلاع، علو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.28,
   "end": 131.86,
   "text": "تعال بیو بالا. چرا اکتفا کردی فقط به ظاهر قرآن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.86,
   "end": 138.5,
   "text": "چرا اونایی که حتی در مسیر تحقیق و پژوهش و تفکر و اینا میرن صرفا به تفسیر آفاقی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.5,
   "end": 142.86,
   "text": "همین تفاسیر روزمره و متعارف پرداختند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.86,
   "end": 145.78,
   "text": "چرا؟ که یه روز اینجا ما مثلاً یه نظر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.78,
   "end": 150.84,
   "text": "از حضرت علامه گفتیم که ایشون فرمودن خیلی از مفسرین اینجا اشتباه فهمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.84,
   "end": 155.8,
   "text": "یکی از آقاهای همین تو جمع شما ناراحت شد به ما پرخاش کرد خیلی بد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.8,
   "end": 158.12,
   "text": "که شما جسارت کردی به مفسرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.12,
   "end": 160.74,
   "text": "نظر علمیه. خیلی‌ها اشتباه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.74,
   "end": 162.96,
   "text": "اتفاقا امروز هم عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.96,
   "end": 167.52,
   "text": "بعضی از مفسرین خیلی جاها اشتباه کردن اما خب صرفا نظرشون مف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.52,
   "end": 179.14,
   "text": "این تفسیر آفاقی‌ست. علامه این کلمات کلا معرفت نفس، سیر انفسیه، تفسیر انفسیه، باطن قرآن رو شناختنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.14,
   "end": 183.76,
   "text": "سیر در باطن قرآن یعنی به یک معنا سیر در باطن خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.76,
   "end": 187.26,
   "text": "به هر حال کتاب‌هایی که در سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.26,
   "end": 190.0,
   "text": "انفسی یا تفسیر انفسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.0,
   "end": 193.86,
   "text": "نوشته شدن همین تفا-- همین کتاب‌های متعارف به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.86,
   "end": 198.16,
   "text": "حالا حکمت متعالیه، عرفان این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.16,
   "end": 202.82,
   "text": "اتفاقا یه جمله علامه دارم براتون این جمله رو بگم یه ذره تنامون بلرزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.82,
   "end": 205.66,
   "text": "که می‌فرمايد به جانم سوگند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.66,
   "end": 208.22,
   "text": "علامه می‌فرمايد به جانم سوگند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.22,
   "end": 211.58,
   "text": "هر کس فهم این کتاب‌ها روزیش نشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.58,
   "end": 214.2,
   "text": "به فهم خطاب محمدی هم نمی‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.2,
   "end": 217.08,
   "text": "اون کتاب‌ها چی‌ان؟ اسم می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.08,
   "end": 220.98,
   "text": "می‌فرمايد شفا، کتاب اشارات و شفای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.98,
   "end": 227.3,
   "text": "شیخ الرئیس، کتاب اسفار ملاصدرا، تنهید القواعد ابن ترکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.3,
   "end": 229.92,
   "text": "نسبا العنس ابن فناری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.92,
   "end": 231.62,
   "text": "اسم می‌بره صراحتا علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.62,
   "end": 237.3,
   "text": "فتوحات و fusus حضرت شیخ اکبر محی الدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.3,
   "end": 241.04,
   "text": "که میگه اینا حالا چند تامون سر سفره این‌ها هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.04,
   "end": 245.34,
   "text": "اینجام که ما میگیم بعضیا بدشون میاد یا خیلی جاهای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.34,
   "end": 248.04,
   "text": "اون‌هایی که اینجا اعتراض کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.04,
   "end": 252.86,
   "text": "آقا مثلا دهه فجر از امام چرا کم سخن میشه از شهدا فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.86,
   "end": 256.56,
   "text": "آیا بفرما ببینم نامه‌ای که بزرگی ما حضرت امام به اندیشمندان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.56,
   "end": 262.66,
   "text": "شرق و غرب نوشت جز این که دعوتشون کرد سر سفره همین عزیزانی که الان اسم بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.66,
   "end": 266.2,
   "text": "تو اون نامه اسم همین عزیران با کتاباشونو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.2,
   "end": 269.38,
   "text": "خب ما هم همین سی رو داریم به زبان همه فهم میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.38,
   "end": 273.92,
   "text": "چرا باید اینطوری باید رفتار بشه با اینجور حقایق و به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.92,
   "end": 278.52,
   "text": "در حقیقت ق-- پشت پا زدن به حقیقت خودته عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.52,
   "end": 282.56,
   "text": "حالا اینجا می‌فرمود که حالا جای دیگه منظومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.56,
   "end": 286.42,
   "text": "ملا هادی سبزواری هم میگن بعضی از شاگردان ایشون اضافه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.42,
   "end": 289.64,
   "text": "حالا من به، به زرع قاطع میگم اصلا خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.64,
   "end": 294.7,
   "text": "کتاب‌های خود حضرت علامه رو مخصوصا کتاب‌های سیر معرفت نفس ایشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.7,
   "end": 298.9,
   "text": "اگر کسی مورد توجه قرار نداده باشه اصلا محال خودشو بشناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.9,
   "end": 307.38,
   "text": "من رک به شما میگم. چون یه چیزکی سر سوزنی رو رفتیم بالاخره یه چیزکی به ما چشوندن به شما حقیقتا عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 307.38,
   "end": 313.44,
   "text": "حیفه. حالا اتفاقا در همین خصوص خطاب محمدی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.44,
   "end": 315.64,
   "text": "اجازه بدید یه جمله از همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.64,
   "end": 319.44,
   "text": "فس حکمتیه، اون فس بیست و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.44,
   "end": 323.3,
   "text": "فسوس الحکم که علامه یکی از کتابا رو ایشون معرفی کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.3,
   "end": 326.8,
   "text": "براتون جمله اولشو بخونم ببینید چه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 326.8,
   "end": 330.1,
   "text": "شیخ اکبر. می‌فرمايد انما کانت حکمته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.1,
   "end": 332.56,
   "text": "فردیه لانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.56,
   "end": 337.0,
   "text": "اکمل موجود فی هذا النوع الانسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.0,
   "end": 339.62,
   "text": "اسمشو میذاره حکمت فردیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 339.62,
   "end": 342.16,
   "text": "حکمتی که به پیغمبر مختصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 342.16,
   "end": 347.02,
   "text": "چرا؟ میگه این تو نوع انسان اکمله از همه کامل تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.02,
   "end": 349.36,
   "text": "و می‌فرمايد و لهذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.36,
   "end": 352.44,
   "text": "بد ابه الامر و ختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.44,
   "end": 354.88,
   "text": "امر و ختم همه چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.88,
   "end": 357.72,
   "text": "به اوست، به آقاست، به رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.72,
   "end": 361.18,
   "text": "فكان نبي او پیغمبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.18,
   "end": 365.4,
   "text": "آدم، تازه حضرت آدم بین الماء والطین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 365.4,
   "end": 370.76,
   "text": "بین خاک و گل بود خاک و آب بود ولی پیغمبر ما پیغمبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 370.76,
   "end": 374.36,
   "text": "ثم کان بنشأة العنصریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.36,
   "end": 378.18,
   "text": "اما وقتی که به این نشئه عنصریه که رسید حالا تق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.18,
   "end": 382.28,
   "text": "ترتیب و تقدم و تأخر و زمان و مکان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.28,
   "end": 385.18,
   "text": "لحاظ شد اینجا خاتم النبیین شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.18,
   "end": 392.58,
   "text": "حالا اینجا چه شیرین که بحث فردیت رو بعد می‌فرماید و اول الأفراد الثلاثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.58,
   "end": 399.04,
   "text": "فردیت چرا؟ حکمتی که به پیغمبر عزیز عالم تعلق گرفته رو بیست و هفت حکمت میاره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.04,
   "end": 401.9,
   "text": "چرا اسم ایشون میذاره فردیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.9,
   "end": 406.06,
   "text": "بعد می‌فرماید که خب اصلاً اولین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 406.06,
   "end": 408.36,
   "text": "عدد فرد سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.36,
   "end": 411.22,
   "text": "سر رو ببینید. ا-اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.22,
   "end": 415.64,
   "text": "می‌دونید خود علامه هم می‌فرمایند که عدد کمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.64,
   "end": 417.58,
   "text": "یعنی عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.58,
   "end": 419.74,
   "text": "شمارش یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.74,
   "end": 422.88,
   "text": "واحد. اینکه اصلاً شمارش نداره یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.88,
   "end": 425.62,
   "text": "یک نداره. وقتی می‌شه دو شمارش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.62,
   "end": 428.02,
   "text": "پس اولین عدد دوئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 428.02,
   "end": 430.14,
   "text": "که می‌شه اولین عدد زوج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 430.14,
   "end": 433.3,
   "text": "اولین عدد فرد می‌شه سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 433.3,
   "end": 437.26,
   "text": "اولین عدد فرد رو سه رو می‌ذاره اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.26,
   "end": 440.16,
   "text": "فس حكمة فردیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.16,
   "end": 442.88,
   "text": "بعد سرش رو بعداً برملا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.88,
   "end": 445.82,
   "text": "فردیت چیه؟ سه، عدد سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.82,
   "end": 447.8,
   "text": "که ایشون در تکوین کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 447.8,
   "end": 453.54,
   "text": "ابن عربی. اصلاً تکوین رو بر پایه تثلیث می‌ذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.54,
   "end": 456.8,
   "text": "سه‌گانه. این سه‌گانه ذات احدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.8,
   "end": 459.76,
   "text": "چون این بحث‌ها رو قبلاً کردیم من راحت دارم برای شما میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.76,
   "end": 462.68,
   "text": "کسی توجه کرده الان متوجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.68,
   "end": 466.7,
   "text": "ذات احدیت که روح ما به اونجا ارتباط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 466.7,
   "end": 475.62,
   "text": "مرتبه الهیت دومی‌ش که قلب ما به اونجاست و حقیقت روحانیه محمدیه صلی الله علیه و آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.62,
   "end": 479.6,
   "text": "یعنی تکوین نظام اصلی بر این سه بنا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 479.6,
   "end": 488.6,
   "text": "که حالا ش-- میگه که اگر کسی خطاب این آقا رو یعنی قرآن رو توجه نکرد از خودش غافله و خودش رو مفت باخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.6,
   "end": 492.54,
   "text": "یعنی از نه از جهت تکوین چیزی فهمیده نه تشریع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 492.54,
   "end": 495.52,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 495.52,
   "end": 503.12,
   "text": "لبرکة صلوات بر محمد و آل محمد. اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}