 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ پنجم؛ محاجّه در برتری خودشناسی",
   "start": 6.58,
   "end": 27.18
  },
  {
   "index": 1,
   "title": "مولا می‌فرماید:",
   "start": 27.18,
   "end": 47.34
  },
  {
   "index": 2,
   "title": "حدیثی که به تنهایی ده منبر می‌خواهد: مولا علی صلوات‌الله‌علیه فرمود:",
   "start": 47.34,
   "end": 312.7
  },
  {
   "index": 3,
   "title": "### دو بُعد شناخت",
   "start": 312.7,
   "end": 354.62
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.7,
   "end": 3.98,
   "text": "یا داعی الله و ربانی یا ای یاسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.98,
   "end": 6.58,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.58,
   "end": 12.44,
   "text": "کلمه پنجم از کتاب شریف صد کلمه در معرفت نفس علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.44,
   "end": 18.68,
   "text": "می‌فرماید آن که می‌پندار، می‌پندارد کاری برتر از خودشناسی و خداشناسیست چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.68,
   "end": 21.74,
   "text": "یه محاجه‌ای کرده اینجا علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.74,
   "end": 27.18,
   "text": "بسم الله. کی حاضره قد علم کنه در این محاجه و جواب بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.18,
   "end": 32.8,
   "text": "می‌فرماید آن که می‌پندارد کاری برتر از خودشناسی و خداشناسیست چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.8,
   "end": 36.44,
   "text": "چه کاری مهم‌تره؟ بسم الله. بیان محاجه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.44,
   "end": 42.82,
   "text": "در حالی که ها را-- هر آنچه که خدای منان خلق کرده است در حدیث قدسی‌ست که مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.82,
   "end": 47.34,
   "text": "شیخ حر عاملی در جواهر الثنیه فی احادیث قدسیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.34,
   "end": 50.96,
   "text": "آورده که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.96,
   "end": 52.86,
   "text": "همه چی رو برای انسان آفریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.86,
   "end": 55.16,
   "text": "آیه‌ای هم داریم. \"هو الذی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.16,
   "end": 56.82,
   "text": "خودش رو این چنین معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.82,
   "end": 61.52,
   "text": "\"هو الذی سخر لکم ما فی الارض جميعا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.52,
   "end": 66.52,
   "text": "اونچه که شما می‌بینید پیرامون خونه‌تون همه رو خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.52,
   "end": 69.52,
   "text": "مسخر شما کرده. اصلاً برای شما خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.52,
   "end": 71.32,
   "text": "همه چی رو برای شما خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.32,
   "end": 77.26,
   "text": "برای نفس حضر تالی. و در اون حدیث قدسی می‌فرماید تو رو برای خودم خلق کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.26,
   "end": 81.48,
   "text": "توی انسان رو. حالا که قراره همه چی برای ما باشه، ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.48,
   "end": 87.26,
   "text": "وقتی خودمون رو نشناسیم چگونه اون‌ها رو، رابطه‌ی اون چیزهایی که برای ما ساخته شده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.26,
   "end": 91.24,
   "text": "با خودمون تنظیم کنیم. باید خودمون رو بشناسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.24,
   "end": 95.32,
   "text": "نیازهامون رو، اونچه که ما رو به فساد می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.32,
   "end": 99.54,
   "text": "اینکه انا لله اون اللهی که از، از او آمدیم کیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.54,
   "end": 103.08,
   "text": "و انا الیه راجعون. اون اللهی که به سمتش می‌رویم کیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.08,
   "end": 106.0,
   "text": "و من اصلاً کیستم که از اونجا آمده‌ام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.0,
   "end": 108.02,
   "text": "و به اونجا خواهم رفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.02,
   "end": 112.7,
   "text": "و اینجا اصلاً کجاست؟ این‌ها سوالات جدی‌ایه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.7,
   "end": 116.74,
   "text": "برای اینکه اهمیتش رو به ما بفهمونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.74,
   "end": 121.88,
   "text": "صدها کلمه قصار و حدیث و روایت از خصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.88,
   "end": 128.96,
   "text": "امیر بیان، قربان دهان پاک معصوم، امیرالمؤمنین صلوات الله علیه فرمودن چند تاشونو عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.96,
   "end": 133.62,
   "text": "که این‌ها همه در کتاب شریف میزان الحکمة جلد شش، صفحه صد و چ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.62,
   "end": 136.46,
   "text": "صفحه صد و چهل می‌تونید ببینید این ه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.46,
   "end": 142.42,
   "text": "احادیث رو. مولامون مثلاً فرمودن معرفت النفس انفع المعارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.42,
   "end": 144.54,
   "text": "الان می‌خوای شما بگردی دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.54,
   "end": 147.36,
   "text": "پرسودترین معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.36,
   "end": 149.62,
   "text": "می‌خوای اصلاً یه رشته‌ای انتخاب کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.62,
   "end": 151.22,
   "text": "می‌خوای بری تو رشته معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.22,
   "end": 153.26,
   "text": "یه رشته تخصصی می‌خوای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.26,
   "end": 155.34,
   "text": "پرسودترینش کدومه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.34,
   "end": 158.88,
   "text": "می‌فرماید معرفت النفس انفع المعارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.88,
   "end": 163.64,
   "text": "مولامون علی می‌فرماد اینکه ما سینه چاکیشیم و ادعا می‌کنیم که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.64,
   "end": 169.84,
   "text": "پیرامون ار شود در صراط مستقیم حق به واسطه اصلاً خود ایشون صراط مستقیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.84,
   "end": 174.18,
   "text": "به محبت ایشون مثلاً بهشتی هستیم و چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 174.18,
   "end": 180.04,
   "text": "ایشون داره می‌فرماد. می‌فرماید معرفت النفس اعل المعارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.04,
   "end": 181.96,
   "text": "اعلا بر وزن افعل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.96,
   "end": 185.04,
   "text": "یعنی دیگه بالاتر از این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.04,
   "end": 189.5,
   "text": "اون دیگه بالاترین حد معارف معرفت نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.5,
   "end": 195.16,
   "text": "باز می‌فرماد افضل المعرفة معرفة الانسان نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.16,
   "end": 197.52,
   "text": "ببینید به چند تا سیاق شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.52,
   "end": 200.38,
   "text": "به چند تا وجه اللفظ شد. یکی می‌فرماد افضل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.38,
   "end": 202.02,
   "text": "یه جا می‌فرماد اعلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.02,
   "end": 203.68,
   "text": "یک-- یه جا می‌فرماد انفع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 203.68,
   "end": 207.22,
   "text": "دیگه به چه زبونی بگه مولا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 207.22,
   "end": 209.84,
   "text": "به چه زبونی؟ همش هم بر وزن افعل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 209.84,
   "end": 213.62,
   "text": "افعل و تفضیل دیگه. یعنی اصلاً بالاتر از این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.62,
   "end": 215.34,
   "text": "پرفزیرت‌تر از این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 215.34,
   "end": 217.2,
   "text": "پرسودتر از این نیست. چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 217.2,
   "end": 221.68,
   "text": "معرفة النفس. حالا ما چقدر در این خصوص اصلاً حرکت کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 221.68,
   "end": 226.08,
   "text": "نفس ما در خصوص شناخت خودش چقدر حرکت کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 226.08,
   "end": 228.68,
   "text": "چه اقداماتی رو انجام داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 228.68,
   "end": 231.66,
   "text": "چه زحماتی رو کشیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 231.66,
   "end": 233.84,
   "text": "چه سیاست‌هایی رو به خرج داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 233.84,
   "end": 236.78,
   "text": "چه عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 236.78,
   "end": 243.98,
   "text": "در مسیر شناخت اونچه که فساد نفس میاره، چه مقدار تلاش کرده که نفسش رو حفظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 243.98,
   "end": 246.54,
   "text": "این حدیث رو هم تقدیم کنم ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.54,
   "end": 251.4,
   "text": "خداییش آیا همین یه دونه حدیث که الان می‌خونم ده تا منبر می‌خواد یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 251.4,
   "end": 253.84,
   "text": "مولا علی صلوات الله علیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.84,
   "end": 257.2,
   "text": "\"استدراک فساد نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 257.2,
   "end": 259.72,
   "text": "من انفع التحقيق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 259.72,
   "end": 265.34,
   "text": "بخوای محقق باشی، اهل تحقیق و تفحص و پژوهش باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 265.34,
   "end": 269.88,
   "text": "بسم الله. اونم پیرامون، اِاِاِ اینکه چه چیزهایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 269.88,
   "end": 273.48,
   "text": "فساد میاره. مثلاً جامعه رو به تباهی می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 273.48,
   "end": 276.12,
   "text": "جامعه اِاِاِ عرض شود اجتماع رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 276.12,
   "end": 278.42,
   "text": "خانواده رو. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 278.42,
   "end": 282.98,
   "text": "سبک زندگی اسلامی چه چیزهایی باعث اعوجاج خانواده می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 282.98,
   "end": 285.54,
   "text": "انحراف فرزندان می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 285.54,
   "end": 287.64,
   "text": "دلسردی و طلاق عاطفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 287.64,
   "end": 289.78,
   "text": "همه‌ی این‌ها رو شما بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 289.78,
   "end": 291.92,
   "text": "سرمنشاش برمی‌گرده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 291.92,
   "end": 301.6,
   "text": "به همین حدیث که \"استدراک فساد نفس\" یعنی جبران کردن تباهی نفس \"من انفع التحقيق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 301.6,
   "end": 304.5,
   "text": "پرسودترین تحقیق‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 304.5,
   "end": 308.88,
   "text": "چون وقتی تو خودت رو شناختی، این نفس رو شناختی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 308.88,
   "end": 312.28,
   "text": "دیگه تمام مشکلات برطرف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 312.28,
   "end": 320.56,
   "text": "می‌دونی چگونه زندگی کنی، چگونه آمادگی پیدا کنی، دامنتو از چه چیزهایی جمع کنی و به سمت چه چیزهایی حرکت کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 320.56,
   "end": 325.66,
   "text": "کجاها احتیاط کنی. تا خودت رو نشناسی هیچ کدوم از این‌ها محقق نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.66,
   "end": 328.62,
   "text": "و دو ب-- دو بُعده. یک ب-- یه بُعدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 328.62,
   "end": 330.64,
   "text": "کلاً شناخت ک-- نفس کله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 330.64,
   "end": 335.16,
   "text": "یعنی انسان. صورت انسانیه چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 335.16,
   "end": 336.84,
   "text": "سیرت انسانیه چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 336.84,
   "end": 339.74,
   "text": "صریرتش چگونه است؟ یه بخش هم خودتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 339.74,
   "end": 344.34,
   "text": "خود انسان، مزاج خودش، حیات ذاتیش، حیات مزاجیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 344.34,
   "end": 348.54,
   "text": "که به‌جز این‌ها معرفت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 348.54,
   "end": 354.62,
   "text": "میسر نیست. ان شا الله عاقبت ما ختم به خیر باشه و برکت صلوات بر محمد و آل محمد. الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}