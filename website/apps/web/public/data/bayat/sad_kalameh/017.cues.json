 },
 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 7.42,
   "end": 169.94
  },
  {
   "index": 1,
   "title": "## وزنِ فَعَلوت؛ شدّتِ عوالم",
   "start": 169.94,
   "end": 251.8
  },
  {
   "index": 2,
   "title": "## مانعِ نظر به ملکوت",
   "start": 251.8,
   "end": 466.4
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 3.06,
   "text": "سلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.06,
   "end": 7.42,
   "text": "و ربانی یا آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.42,
   "end": 9.44,
   "text": "کلمه شانزدهم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.44,
   "end": 12.58,
   "text": "آن که در خود فرو نرفته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.58,
   "end": 16.14,
   "text": "و در بهار ملکوت سیر نکرده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.14,
   "end": 20.26,
   "text": "و از دیار جبروت سر در نیاورده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.26,
   "end": 25.78,
   "text": "دیگر صباحت و سیاحت را چه وزنی نهاده است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.78,
   "end": 28.14,
   "text": "اولین نکته‌ای که در این کلمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.14,
   "end": 30.92,
   "text": "حضرت علامه حسن زاده در سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.92,
   "end": 35.18,
   "text": "اون صد کلمه در معرفت نفسشون خودنمایی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.18,
   "end": 37.62,
   "text": "بحث فرو رفتن در خوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 37.62,
   "end": 41.02,
   "text": "می‌فرماید اون کسی که در خودش فرو نرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.02,
   "end": 47.24,
   "text": "اشاره دارد به اون قلب عبارتی قرآن که بارها محضر شما عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.24,
   "end": 51.84,
   "text": "همونطور که سور قرآن قلب دارن، سوره یاسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.84,
   "end": 56.36,
   "text": "عبارات قرآن هم قلب دارند که \"و лиتلقف\" وسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.36,
   "end": 59.34,
   "text": "قرآن قرار گرفته در سوره کهف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.34,
   "end": 62.52,
   "text": "سلام علیکم و رحمة الله. این رمز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.52,
   "end": 65.94,
   "text": "ورود به بسم و باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 65.94,
   "end": 68.5,
   "text": "و پنهان و مکنون قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 68.5,
   "end": 71.7,
   "text": "که اون هم کن فی کتاب مکنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 71.7,
   "end": 73.48,
   "text": "در یک کنی قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 73.48,
   "end": 77.16,
   "text": "رمز و راز و سر رسیدن به باطن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 77.16,
   "end": 80.54,
   "text": "باطن قرآن یا به عبارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 80.54,
   "end": 83.68,
   "text": "سفر کردن به اون عوالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 83.68,
   "end": 86.64,
   "text": "که از درون خودمون شروع می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 86.64,
   "end": 92.0,
   "text": "به صورت اتصال متصل مثلا عالم مثال متصل یا ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 92.0,
   "end": 100.3,
   "text": "همینطور جبروت، لاهوت. اینا از خود ماست از درون ماست که حالا تو کلمه بعدی، کلمه هفدهم به اون می‌پردازه علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 100.3,
   "end": 103.1,
   "text": "پس سر اول اینه که در خودت فرو بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.1,
   "end": 108.26,
   "text": "حالا اونجا علامه پیرامون \"ولیتلقف\" توضیحات مبسوط و شیرینی می‌دن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 108.26,
   "end": 112.14,
   "text": "که ای تعقل، ای تأمل، ای تدبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 112.14,
   "end": 115.14,
   "text": "همه اینا معنای تلطیف سر میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 115.14,
   "end": 120.02,
   "text": "یعنی انسان تو خودش فرو بره، سر در گریبان خودش فرو ببره، کاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 120.02,
   "end": 125.3,
   "text": "به کسی نداشته باشه، خودش رو بسازه، در مسیر خودسازی خودش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 125.3,
   "end": 129.44,
   "text": "اون موقع همه‌ی این عوالم رو در وجود خودش می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.44,
   "end": 135.58,
   "text": "سلام علیکم و رحمة الله. عالم ناسوت رو که بدن خودشه، ملکوت رو که قوه مثالشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.58,
   "end": 139.82,
   "text": "جبروت رو که قوه عقلشه، لاهوت رو که قلبشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.82,
   "end": 144.24,
   "text": "همه این‌ها رو در خودش می‌یابه به شرط اینکه چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.24,
   "end": 147.08,
   "text": "سر در گریبان خودش فرو ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 147.08,
   "end": 152.42,
   "text": "هی اینو اونو به قول امیرالمؤمنین علیه السلام در نهج البلاغه بالا عرض کردیم دیگه بارها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 152.42,
   "end": 156.92,
   "text": "فرمودن اگر کسی به خودش بپردازه، به عیوب خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.92,
   "end": 160.68,
   "text": "انقدر عیب می‌بینه که اصلاً فرصت نمی‌کنه به عیب دیگران برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.68,
   "end": 162.76,
   "text": "ما فقط ذره‌بین گذاشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.76,
   "end": 165.24,
   "text": "عیوب دیگران رو. خب از خودم غافل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.24,
   "end": 168.44,
   "text": "لذا خب سفر ندارم. سفری به ملکوت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.44,
   "end": 172.18,
   "text": "جبروت و این‌ها ندارم. نکته بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 172.18,
   "end": 175.04,
   "text": "بحث جبروت که همون عالم عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 175.04,
   "end": 178.04,
   "text": "اولاً اینو بدونید حال چرا می‌گیم ملکوت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 178.04,
   "end": 180.96,
   "text": "خب جبروت، عظمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 180.96,
   "end": 183.44,
   "text": "لاهوت. این وزنش از کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 183.44,
   "end": 186.56,
   "text": "ناسوت. اینا وزنش همون فعلوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 186.56,
   "end": 190.32,
   "text": "وزن فعلوت در عربی وزن مبالغه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 190.32,
   "end": 193.18,
   "text": "یکی از صیغه‌های مبالغه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 193.18,
   "end": 195.72,
   "text": "که میخوان بگن شدت یه چیزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 195.72,
   "end": 200.54,
   "text": "مثلا ملک این عالم اینجاست، همین جا ناسوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 200.54,
   "end": 205.3,
   "text": "بعد میریم ملکوت همین ملکه اما شدت پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 205.3,
   "end": 208.5,
   "text": "یعنی سلطنت خدا اونجا خیلی شدیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 208.5,
   "end": 212.02,
   "text": "جبروت، جبر خدا دیگه به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 212.02,
   "end": 215.54,
   "text": "وضوحه، داره. جبروت شدید می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 215.54,
   "end": 219.74,
   "text": "یعنی اونجا اصلاً دیگه همه سیطره هرچی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 219.74,
   "end": 223.94,
   "text": "یا مج-- عالم مجرداته دیگه هیچ خبری از مادیات نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 223.94,
   "end": 226.7,
   "text": "همه تحت سیطره عقلن، عقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 226.7,
   "end": 229.74,
   "text": "عالم ارواحه، عالم امره فلان این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 229.74,
   "end": 232.32,
   "text": "و این یادمون باشه که این مبالغه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 232.32,
   "end": 237.68,
   "text": "مثلا عظمت میگن. خیلی عظیم، خیلی با عظمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 237.68,
   "end": 243.72,
   "text": "که حالا این سر رفتن از ملکوت نه اینکه بری به عالم ملکوت سیر کنی، کیف کنی، عشق کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 243.72,
   "end": 245.86,
   "text": "خب اون که هر شب داری تو خواب میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 245.86,
   "end": 249.0,
   "text": "تو لایه‌های ابتدایی ملکوتت حداقل میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 249.0,
   "end": 252.58,
   "text": "یعنی مثال بگی به به من رفتم به ملکوت و چه سیری و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 252.58,
   "end": 257.56,
   "text": "نه هنر نیست که. آدم خواب آلو هم هر شب داره میره ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 257.56,
   "end": 260.52,
   "text": "اما اون لایه های پنهان پایینشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 260.52,
   "end": 266.18,
   "text": "که حالا علامه می‌فرماید اگر آنچه که در عالم ملکوت یعنی مثال متصل خودت دیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 266.18,
   "end": 272.0,
   "text": "اگر اون لایه‌های ابتداییه یعنی تا خوابت رفت می‌بینی اونا، اون‌ها رو زودم تعبیر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 272.0,
   "end": 276.44,
   "text": "همین امروز، فردا، دو سه روز دیگه تو همین هفته می‌بینی تعبیر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 276.44,
   "end": 278.22,
   "text": "چون تنزل حقیقته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 278.22,
   "end": 281.46,
   "text": "از عالم بالا داره تنزل رخ میده میاد پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 281.46,
   "end": 286.74,
   "text": "تو رفتی هنوز به عالم ملکوت نرسیده تو ملکوت اون حقیقتو زیارت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.74,
   "end": 291.38,
   "text": "قراره فردا برسه، پسفردا برسه، تنزل پیدا کنه به عالم ملکوت دیدیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 291.38,
   "end": 298.34,
   "text": "اما اگر تو-- دیدی که رفتی به لایه‌های پنهان‌تر مثلا یک سال بعد، ده سال بعد، بعضی چهل سال بعد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 298.34,
   "end": 302.2,
   "text": "صد سال بعدو می‌بینن. انقدر فرو رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 302.2,
   "end": 304.7,
   "text": "یعنی رفتن به عالم عقول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 304.7,
   "end": 310.06,
   "text": "همتراز با ملائکه. پیغمبر که دیگه بالاتر از اون‌ها رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.06,
   "end": 311.9,
   "text": "پس چاره‌ای از اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 311.9,
   "end": 313.84,
   "text": "یعنی ما راهمون اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 313.84,
   "end": 318.86,
   "text": "راه باید رفت. حالا چون ما متاسفانه فقط خواب آلوئیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 318.86,
   "end": 325.06,
   "text": "خیالاتی هستیم و در عالم مثال و ملکوت ابتدایی وجود خودمون گیریم اینا خیلی باورمون نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 325.06,
   "end": 327.2,
   "text": "باز خداروشکر این ملکوته رو خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 327.2,
   "end": 329.42,
   "text": "گذاشت هر شب بریم ملکوتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 329.42,
   "end": 331.62,
   "text": "بالاخره ملکوتی بشیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 331.62,
   "end": 339.6,
   "text": "هپروتی بشیم و عالم خواب و چیزی یه چیزی باورمون بشه نه مثل اینکه یه خبرهایی هست و الا دیگه هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 339.6,
   "end": 343.9,
   "text": "و نکته آخر چی مانع رفتن ما در این سفره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 343.9,
   "end": 346.34,
   "text": "این از همه مهم‌تره. چی مانعه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 346.34,
   "end": 351.24,
   "text": "آیا پیغمبر، اهل بیت اصلاً در خصوص ملکوت، اصلاً خود ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 351.24,
   "end": 356.28,
   "text": "حرفی زدن که آقا چی مانع رفتنت به ملکوت و اون لایه‌های پنهانیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 356.28,
   "end": 358.64,
   "text": "لایه‌های ابتدایی‌ش که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 358.64,
   "end": 360.98,
   "text": "میره آدم در همون تا خوابش میره، میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 360.98,
   "end": 367.94,
   "text": "اون لایه‌های پنهانیش یعنی بتونه نظر بندازه از همین جا که اصلاً نه حتی نخوابیده بره به عالم مثال منفصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 367.94,
   "end": 372.32,
   "text": "یعنی بیرون از خودش. نظر بندازه به ملکوت بیرون از خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.32,
   "end": 375.98,
   "text": "چیه مشکل؟ اجازه بدید یه حدیث تقدیم کنم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 375.98,
   "end": 378.4,
   "text": "سند. دو تا سند محکم براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.4,
   "end": 384.08,
   "text": "یکی از مه-- از المهجة البيضاء في تحسين الأحياء مرحوم ملا محسن فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 384.08,
   "end": 386.88,
   "text": "کتاب شریفی‌ست. جلد دو، صفحه صد و بیست و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 386.88,
   "end": 390.68,
   "text": "همین ح-حديث رو میزان الحکمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 390.68,
   "end": 392.98,
   "text": "آقای ش- ریشهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 392.98,
   "end": 395.36,
   "text": "جلد نه، صفحه دویست و شونزده آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 395.36,
   "end": 397.38,
   "text": "پیغمبر عزیز اسلام فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 397.38,
   "end": 399.0,
   "text": "یه سالشون صلوات خط کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 399.0,
   "end": 404.52,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 404.52,
   "end": 406.86,
   "text": "انقدر این حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 406.86,
   "end": 410.72,
   "text": "مشخص و واضحه نیاز به هیچ تفسیر و توضیحی هم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 410.72,
   "end": 413.14,
   "text": "از رو براتون بخونم ببینید همه می‌فهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 413.14,
   "end": 417.98,
   "text": "لولا اگر نبود ان الشياطين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 417.98,
   "end": 420.66,
   "text": "همش بر می‌گرده به اون شياطين وجود خودمونه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 420.66,
   "end": 423.44,
   "text": "دنبال جای دیگه نگردیم. آره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 423.44,
   "end": 427.34,
   "text": "ان الشياطين يحومون على قلوب بني آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 427.34,
   "end": 429.9,
   "text": "اگر این نبود که اینا هی دور می‌زنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 429.9,
   "end": 433.44,
   "text": "يحومون حول قلب بني آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 433.44,
   "end": 436.38,
   "text": "این شياطين میان دور دل این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 436.38,
   "end": 440.08,
   "text": "در دل، دور دل اینا طواف می‌کنند و می‌گردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 440.08,
   "end": 442.38,
   "text": "لنظروا قطعاً نظروا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 442.38,
   "end": 444.92,
   "text": "اینا نظر می‌انداختن، چشم می‌انداختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 444.92,
   "end": 448.04,
   "text": "به کجا؟ الى ملكوت السماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 448.04,
   "end": 452.76,
   "text": "پس گیر کجاست؟ اینکه ما این شياطين رو از خودمون دفع نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 452.76,
   "end": 458.44,
   "text": "حجاب غبار گناه و معصیت و اینا رو آینه وجودمونو گرفته، نمی‌تونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 458.44,
   "end": 460.8,
   "text": "آینه روش غبار باشه چیزی نشون نمی‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 460.8,
   "end": 463.74,
   "text": "لذا نمی‌تونیم ببینیم. ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 463.74,
   "end": 466.4,
   "text": "و برکت صلوات بر محمد و آل محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}