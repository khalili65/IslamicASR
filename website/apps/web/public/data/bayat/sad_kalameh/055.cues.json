 },
 "chapters": [
  {
   "index": 0,
   "title": "## سوم شعبان؛ پرتوی از عظمت حسین",
   "start": 34.58,
   "end": 190.5
  },
  {
   "index": 1,
   "title": "## کلمهٔ پنجاه‌وچهار؛ یَقَظه",
   "start": 190.5,
   "end": 224.52
  },
  {
   "index": 2,
   "title": "امام خمینی پیوسته این آیه را در آغاز و پایان درس می‌خواندند:",
   "start": 224.52,
   "end": 686.65
  },
  {
   "index": 3,
   "title": "## فضلِ تعیّش؛ عیش آخرت",
   "start": 686.65,
   "end": 849.78
  },
  {
   "index": 4,
   "title": "## سلامی که جواب می‌شنود",
   "start": 849.78,
   "end": 974.84
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 8.56,
   "end": 13.0,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 13.0,
   "end": 16.12,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 16.12,
   "end": 19.24,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.24,
   "end": 23.12,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.12,
   "end": 26.48,
   "text": "بسیار تبریک میگم این روز بسیار بی‌نظیر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.48,
   "end": 32.56,
   "text": "نورانی رو. ان‌شاءالله برای همتون پر از خیر و برکت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.56,
   "end": 37.98,
   "text": "رهبر عزیزمون در خصوص روز سوم شعبان اشاره دارند به فرمایش یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.98,
   "end": 40.98,
   "text": "خیلی شیرینی از حضرت آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.98,
   "end": 44.46,
   "text": "آقا میرزا جواد آقا ملکی تبریزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.46,
   "end": 48.22,
   "text": "که ایشون می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.22,
   "end": 50.56,
   "text": "روز سوم شعبان را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.56,
   "end": 57.26,
   "text": "باید به عنوان پرتویی از عظمت حسین بن علی به حساب آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.26,
   "end": 62.7,
   "text": "روز بزرگی‌ست. یک پرتویی‌ست از عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.7,
   "end": 65.2,
   "text": "آقا امروز انقدر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.2,
   "end": 68.08,
   "text": "با عظمته حتما عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.08,
   "end": 70.1,
   "text": "اونایی که دسترسی دارند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.1,
   "end": 74.6,
   "text": "کانال امنا امنه تو همین کانال اینجا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.6,
   "end": 78.5,
   "text": "تو مرام که متعلق به اینجاست، اونجا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.5,
   "end": 84.0,
   "text": "عزیزان اطلاع‌رسانی کردند. یه ختمیه ما به یادگار از حضرت آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.0,
   "end": 90.7,
   "text": "نخودکی اصفهانی ختم صلوات خیلی شیرینیه برای حاجت روایی از امروز شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.7,
   "end": 97.8,
   "text": "تو امنا امنه عکسشو من نوشتم، عکسشو بچه‌ها گذاشتن می‌تونید رجوع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.8,
   "end": 103.94,
   "text": "امروز عظمتش همین بس که پرتویی از نور ارباب رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.94,
   "end": 114.4,
   "text": "می‌دونید که قبلاً هم به تفصیل عرض کردیم در خصوص ایام و ساعات که هر کس هر وقتی به دنیا میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 114.4,
   "end": 122.9,
   "text": "یا هر وقتی از دنیا میره قطعاً بین او و اون روز و اون ساعت یک ربط وجودی‌ای هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 122.9,
   "end": 126.5,
   "text": "ربط وجودی بین او و اون ساعت و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 126.5,
   "end": 131.22,
   "text": "روز هست. در خصوص انسان کامل بلعکسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 131.22,
   "end": 133.4,
   "text": "یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 133.4,
   "end": 136.88,
   "text": "روز و اون ساعتی که او به دنیا میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 136.88,
   "end": 141.46,
   "text": "یا از دنیا میره یک ربط وجودی با انسان کامل داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 141.46,
   "end": 144.74,
   "text": "ماها بلعکسی. ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 144.74,
   "end": 147.18,
   "text": "یک ربطی داریم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 147.18,
   "end": 153.78,
   "text": "حالت چگونه است، کم و کیف وجودت، خودت رو چگونه ساختی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 153.78,
   "end": 157.02,
   "text": "ملکات نفست که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 157.02,
   "end": 162.88,
   "text": "بذر صور و اشکال برزخی شما رو تشکیل میدن چه هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 162.88,
   "end": 166.66,
   "text": "بر اساس همون ساعت خاصی و روز خاصی از دنیا میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 166.66,
   "end": 172.22,
   "text": "این بحث رو قبلاً داشتیم. به هر حال روز بسیار بزرگ و فرخنده ای‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 172.22,
   "end": 177.14,
   "text": "و مخصوصاً به پاسداران عزیز ما امروز رو تبریک میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 177.14,
   "end": 183.94,
   "text": "که روز اون‌ها هم هست و جا داشت که مرکزی، حرکتی، یه کاری امروز انجام می‌داد بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 183.94,
   "end": 186.3,
   "text": "و چه عرض کنیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 186.3,
   "end": 194.08,
   "text": "نقل از حاج قاسم یه جمله بگم که ایشون می‌فرمودند \"من متعلق به آن صفایی هستم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 194.08,
   "end": 200.04,
   "text": "چشم بر هم نمی‌گذارد تا دیگران در آرامش بخوابند.\" این جمله حاج قاسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 200.04,
   "end": 202.66,
   "text": "این عظمت سپاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 202.66,
   "end": 208.06,
   "text": "اسلامه که فرمایشی هم از رهبر عزیزمون هست در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 208.06,
   "end": 211.74,
   "text": "عجیب بودن زندگی‌نامه پاسدارا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 211.74,
   "end": 214.76,
   "text": "پاسداران اسلام. ایشون می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 214.76,
   "end": 218.64,
   "text": "اگر حالا به صورت تقطیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 218.64,
   "end": 222.96,
   "text": "قطعه‌هایی از زندگی‌های، زندگی پاسداران رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 222.96,
   "end": 225.84,
   "text": "شما به صورت یک کتاب دربی و به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 225.84,
   "end": 228.72,
   "text": "زبان‌های مختلف ترجمه کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 228.72,
   "end": 232.74,
   "text": "توضیح کنید کشورها، هر کس این‌ها رو بخونه، ایشون می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 232.74,
   "end": 235.24,
   "text": "اونایی که خب آشنا نیستند با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 235.24,
   "end": 243.24,
   "text": "نمی‌دونم وضعیت شهدا و پاسدارا و انقلاب اسلامی و هجره شهدا و کردستان و چه و اینا اسم می‌بره آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 243.24,
   "end": 250.5,
   "text": "می‌فرمایند از هر ده نفرشون که این کتابو بخونن هشت نه نفرشون میگن اینا افسانه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 250.5,
   "end": 254.22,
   "text": "یعنی زندگی‌نامه پاسدارای ما رو که بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 254.22,
   "end": 256.44,
   "text": "در صورت که افسانه نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 256.44,
   "end": 261.72,
   "text": "واقعیت داشته و داره. یک زندگی‌ست فوق طور مادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 261.72,
   "end": 266.32,
   "text": "فوق طور مادی. یک زندگی، یک عیش دیگری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 266.32,
   "end": 267.96,
   "text": "حالا اون از کجا بیرون میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 267.96,
   "end": 270.96,
   "text": "اون عیش از کجاست؟ چه شیرین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 270.96,
   "end": 278.52,
   "text": "باز بحث ما تا اونچه که تا الان عرض کردیم یک ربط قشنگی داره به کلمه پنجاه و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 278.52,
   "end": 280.9,
   "text": "سیر بحث معرفت نفسمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 280.9,
   "end": 287.78,
   "text": "کلمه پنجاه و چهار صد کلمه در معرفت حضرت استاد این چنین می‌فرماید \"آن که در معرفت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 287.78,
   "end": 296.28,
   "text": "به مرحله یغز قدم نهاد\"، یغز یعنی بیداری، \"بسیاری از دانش‌ها را بیش از خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 296.28,
   "end": 299.08,
   "text": "و خیال ارزش نمی‌نهد.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 299.08,
   "end": 302.44,
   "text": "اصلاً خیلی از این دانش‌هایی که خیلی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 302.44,
   "end": 304.98,
   "text": "فزشو میدن، این‌ها رو اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 304.98,
   "end": 307.54,
   "text": "ارزشی برون، براشون قائل نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 307.54,
   "end": 311.12,
   "text": "کسی که چی باشه؟ به مرحله یغز رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 311.12,
   "end": 314.04,
   "text": "یغز یعنی بیداری، بیدار شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 314.04,
   "end": 316.92,
   "text": "که بعض از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 316.92,
   "end": 319.42,
   "text": "حکما و عرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 319.42,
   "end": 324.34,
   "text": "یغز رو گرفتن به معنای قیام نمودن برای حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 324.34,
   "end": 329.8,
   "text": "یعنی بیدار می‌شه طرف، مثل اینکه بیدار می‌شه انگار که راست قامت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 329.8,
   "end": 332.1,
   "text": "رستاخیز هم راست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 332.1,
   "end": 335.38,
   "text": "خیز درستش بوده، شده رستاخیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 335.38,
   "end": 338.82,
   "text": "راست خیز یعنی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 338.82,
   "end": 343.26,
   "text": "چطور میگه آقا من حق فبصرک اليوم حدید چشمش تیز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 343.26,
   "end": 346.8,
   "text": "میگه مو، موها به تنم سیخ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.8,
   "end": 350.8,
   "text": "سیخ وا می‌ایسته. لام تا کام حرفی برای گفتن نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 350.8,
   "end": 354.48,
   "text": "راست وا می‌ایسته به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 354.48,
   "end": 357.16,
   "text": "مثل یه سربازی که در برابر فرمندش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 357.16,
   "end": 359.9,
   "text": "میگن مثل سیخ وایساده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 359.9,
   "end": 363.1,
   "text": "این چنین رستاخیز، راست خیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 363.1,
   "end": 366.25,
   "text": "همه سیخ وامیسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.25,
   "end": 368.91,
   "text": "و تک کلمه ای بر لسانشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.91,
   "end": 371.45,
   "text": "جاری نمیشه مگر به اذن الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.45,
   "end": 374.41,
   "text": "و اینجا می‌فرماید که یغزه همچین حالتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 374.41,
   "end": 381.97,
   "text": "حالت بیداریه که انگار انسان قیام می‌کنه برای خدا بلند می‌شه یه دفعه بیدار می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 381.97,
   "end": 384.75,
   "text": "که خدا رحمت کنه حضرت امام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 384.75,
   "end": 390.21,
   "text": "که قل انما اعظکم بواحدة ان تقوموا لله یکی این آیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.21,
   "end": 393.87,
   "text": "که اگه بخواهی یه، یه موعظه به شما بکنم، یه موعظه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.87,
   "end": 396.29,
   "text": "یه موعظه قرآن داره میگه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 396.29,
   "end": 399.33,
   "text": "اون همین، همین بس. ان تقوموا لله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 399.33,
   "end": 401.79,
   "text": "برای الله قیام کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 401.79,
   "end": 404.33,
   "text": "و اون آیه دیگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 404.33,
   "end": 407.29,
   "text": "قموا لله مثنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 407.29,
   "end": 414.59,
   "text": "و فرادى. اگر عبارت عربیشو درست خونده باشم برای خدا قیام کنید چه تک تک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 414.59,
   "end": 418.79,
   "text": "چه دو تا دو تا. اینو امام همیشه تو درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.79,
   "end": 421.37,
   "text": "پایان و شروع درسشون می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 421.37,
   "end": 425.65,
   "text": "این یعنی همون یغوه. تا انسان به یغزه و بیداری نرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 425.65,
   "end": 428.57,
   "text": "قیامی براش نیست. برا لله، برای خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.57,
   "end": 430.93,
   "text": "پس چی قیام کنه وقتی بیدار نشده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.93,
   "end": 433.75,
   "text": "اتفاقا من به خودم و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.75,
   "end": 437.55,
   "text": "و فرزندان و نسل‌مون در هیئت نوجوانان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 437.55,
   "end": 444.77,
   "text": "همون جلسات خودمون هم به مسئولیت تاکید کردم آقا برای این نوجوان‌هایی که به سن بلوغ رسیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 444.77,
   "end": 446.99,
   "text": "اصلا از واجبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 446.99,
   "end": 453.89,
   "text": "یک دوره کتاب منازل السائرین خواجه عبدالله رو برید براشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 453.89,
   "end": 458.55,
   "text": "اگه می‌تونید با شرح و اینا اگه نه خودشو یه دوره بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.55,
   "end": 461.77,
   "text": "اولین منزل رو از اون صد منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 461.77,
   "end": 466.73,
   "text": "سائر الی الله که می‌خواد لله قیام کنه یغوه نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 466.73,
   "end": 469.91,
   "text": "گذاشتن. یغوه یعنی بیداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 469.91,
   "end": 471.67,
   "text": "که خدا رحمت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 471.67,
   "end": 475.89,
   "text": "safiyuddin محمد طارمی در رساله انیس العارفینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 475.89,
   "end": 480.71,
   "text": "که در شرح، شرح منازل السائرین خواجه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 480.71,
   "end": 485.29,
   "text": "این چنین نقل می‌کنه که و شکی نیست در این که انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 485.29,
   "end": 488.79,
   "text": "انسان مغمور در قواشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 488.79,
   "end": 491.37,
   "text": "نشئه و غافل از حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 491.37,
   "end": 497.09,
   "text": "و از نور فطرت به مقتضای طبیعت مثل نائم است به حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 497.09,
   "end": 501.97,
   "text": "کسی که گرفتار دنیاست، پرده‌ها براش کنار نرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 501.97,
   "end": 505.75,
   "text": "هد غرق در حجاب تعلقات دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 505.75,
   "end": 508.63,
   "text": "میگه به فرمایش پیغمبر فرمایش هم میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 508.63,
   "end": 511.41,
   "text": "فرمایش پیغمبر اینا مثل نائم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 511.41,
   "end": 513.77,
   "text": "مثل خواب‌اند. آدمی که خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 513.77,
   "end": 517.15,
   "text": "بعد می‌فرماید همان که ادامه فرمایش ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 517.15,
   "end": 521.65,
   "text": "همان، همچنان که پیغمبر فرموده است که الناس نیام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 521.65,
   "end": 525.27,
   "text": "مردم همه خواب‌اند. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 525.27,
   "end": 527.57,
   "text": "این باز ادامه فرمایش این بزرگواراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 527.57,
   "end": 532.45,
   "text": "\"پس لابد است از برای او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 532.45,
   "end": 535.57,
   "text": "منبهی\" یعنی کسی که او رو بیدار کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 535.57,
   "end": 539.27,
   "text": "\"که او واعظ الله است.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 539.27,
   "end": 541.27,
   "text": "یعنی کی وعظ می‌کنه؟ الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 541.27,
   "end": 544.99,
   "text": "اما یه واعظی داره. یه وسیله‌ای برای این کار داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 544.99,
   "end": 548.17,
   "text": "الم تجد لسن-- لسنة الله تبدیلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.17,
   "end": 554.13,
   "text": "اون کسی که میاد بیدارت می‌کنه اون واعظه از سمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 554.13,
   "end": 556.65,
   "text": "در قلب او به سبب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 556.65,
   "end": 559.67,
   "text": "انفواض نور اسم هادی در او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 559.67,
   "end": 567.09,
   "text": "این اتفاق می‌افته. یعنی همونطور که عرض کردیم نور هادی در طول ولایت کلیه الهیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 567.09,
   "end": 569.53,
   "text": "ولکل قوم هاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 569.53,
   "end": 574.77,
   "text": "اون هدایتگر و هادی انسان کامل و امام زمانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 574.77,
   "end": 578.55,
   "text": "که اب همه‌شون ریشه همه‌شون امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 578.55,
   "end": 583.01,
   "text": "اون من و شما رو انشاالله هدایت می‌کنه به نور ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 583.01,
   "end": 587.07,
   "text": "به این میگن یغوه. یعنی نور ولایت که تجلی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 587.07,
   "end": 589.45,
   "text": "هدایت آغاز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 589.45,
   "end": 593.49,
   "text": "به این حالت ابتداییش تازه میگن یغوه که منزل اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 593.49,
   "end": 597.71,
   "text": "که انسان نیت می‌کنه لله قیام کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 597.71,
   "end": 599.75,
   "text": "این نیت تازه می‌کنه که قیام کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 599.75,
   "end": 602.39,
   "text": "این حالا تا اینجاش بحث یغزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 602.39,
   "end": 608.47,
   "text": "بقیش رو که میگه حالا علامه توی این جمله حالا نصف جمله رو، نصف کلمه رو من عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 608.47,
   "end": 614.35,
   "text": "میگه کسی که تو این حالت میاد دیگه هی نمیره سراغ دانش و علوم بیخود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 614.35,
   "end": 617.75,
   "text": "عمرشو با اونا تلف کنه. اینا رو مثل یه خیال و یه خوابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 617.75,
   "end": 621.25,
   "text": "می‌پنداره و بس. آن علمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 621.25,
   "end": 627.61,
   "text": "بقیه فرمایش علامه است. \"آن علمی که نور نفس است دیگر است.\" یعنی یه علم دیگره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 627.61,
   "end": 631.79,
   "text": "اون چیه؟ که العلم نور اشاره به این حدیث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 631.79,
   "end": 634.77,
   "text": "یغظفه الله من یشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 634.77,
   "end": 639.15,
   "text": "هرکیو خدا بخواد یغظفه الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 639.15,
   "end": 642.61,
   "text": "می‌ندازه. قذف. می‌ندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 642.61,
   "end": 649.51,
   "text": "مثل این که فرمود من اراد الله بعبد خیرا قذف، قذف فی قلبه حب الحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 649.51,
   "end": 652.65,
   "text": "هرکس که خدا اراده خیر برش کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 652.65,
   "end": 655.65,
   "text": "اول کاری که می‌کنه محبت امام حسین می‌ندازه تو دلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 655.65,
   "end": 659.91,
   "text": "می‌ندازه. کار، کار خداست. یعنی تو دام می‌ندازه دلش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 659.91,
   "end": 662.65,
   "text": "دام عشق خداست. دام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 662.65,
   "end": 664.95,
   "text": "عشق خدا امام حسین، حب امام حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 664.95,
   "end": 668.03,
   "text": "حب زیارت آقاست. این چنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 668.03,
   "end": 672.73,
   "text": "میگه اینجا می‌فرماید که کسی رو که خدا می‌خواد هدایتش کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 672.73,
   "end": 675.51,
   "text": "چیکار می‌کنه؟ می‌ندازه نور رو تو دلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 675.51,
   "end": 677.11,
   "text": "این نور از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 677.11,
   "end": 679.25,
   "text": "از ولایت میاد. برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 679.25,
   "end": 682.57,
   "text": "چون می‌خواد هدایتش کنه. از طریق ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 682.57,
   "end": 686.65,
   "text": "هدایتش می‌کنه. بعد اتمام کلمه این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 686.65,
   "end": 689.45,
   "text": "و آن فضلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 689.45,
   "end": 692.47,
   "text": "عنوان تعیّش است دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 692.47,
   "end": 696.33,
   "text": "یعنی چی؟ میگه اون فضیلت یعنی برتری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 696.33,
   "end": 700.29,
   "text": "خدا می‌خواد همه رو هدایت کنه. الله نور السماوات والارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 700.29,
   "end": 703.27,
   "text": "چشم بندازین ببینید همه چی نور خدا رو در خودش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 703.27,
   "end": 706.69,
   "text": "آسمان و زمین حتی. حتی شب هم نور الهی رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 706.69,
   "end": 709.43,
   "text": "درست شد؟ همه رو خدا می‌خواد به این نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 709.43,
   "end": 712.03,
   "text": "که برخاسته از نور ولایت کلیه است هدایت بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 712.03,
   "end": 714.45,
   "text": "اما می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 714.45,
   "end": 717.91,
   "text": "و آن فضلی که عنوان تعیّش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 717.91,
   "end": 720.89,
   "text": "یه عنوان خودش، یه سر تیتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 720.89,
   "end": 726.61,
   "text": "تیتره اصلاً. یک شروع دوباره است بعد از یغزه تازه که میره سراغ انتباه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 726.61,
   "end": 728.57,
   "text": "بعد از انتباه میره سراغ توبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 728.57,
   "end": 731.09,
   "text": "یعنی برگشت. رجوع الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 731.09,
   "end": 737.04,
   "text": "این می‌شه عنوان جدیدت این عنوان جدید میگه اینجا علامه میگه فضل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 737.04,
   "end": 742.3,
   "text": "فضل اسم ف-- الفاضل حق کجا پیاده میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 742.3,
   "end": 744.52,
   "text": "جایی که تو استحقاقش رو نداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 744.52,
   "end": 748.62,
   "text": "مستقیم به لطف خودش این کارو با تو میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 748.62,
   "end": 751.52,
   "text": "یعنی فضیلت به تو میده. تو رو برتری می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 751.52,
   "end": 753.54,
   "text": "به چی؟ به یه تعیّش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 753.54,
   "end": 755.66,
   "text": "به یک زندگی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 755.66,
   "end": 759.82,
   "text": "یک زندگی دیگه‌ایه. شاید برخاسته از اون روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 759.82,
   "end": 765.14,
   "text": "مشهور پیغمبر که البته در صحیح مسلم و صحیح بخاری این روایت اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 765.14,
   "end": 768.66,
   "text": "که پیغمبر از خندق وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 768.66,
   "end": 777.48,
   "text": "اومد وارسی کنه، بررسی کنه خندق رو که می‌کندند انصار و مهاجرین دید خیلی اینا ت-تلاش‌ن، گرسنه‌ن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 777.48,
   "end": 780.54,
   "text": "و اصلا توجه به سختی کار ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 780.54,
   "end": 784.4,
   "text": "تو اون وضعیت شب‌ها سرد، روزا گرم دارن کار می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 784.4,
   "end": 786.54,
   "text": "بعد پیغمبر این جمله رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 786.54,
   "end": 791.84,
   "text": "بر لسان مبارکشون جاری کردن که اللهم ان العیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 791.84,
   "end": 797.26,
   "text": "عیش الآخرة. اون زندگی واقعی عیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 797.26,
   "end": 799.34,
   "text": "عیش و زندگی واقعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 799.34,
   "end": 801.88,
   "text": "عیش اون وره. آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 801.88,
   "end": 803.9,
   "text": "اصل زندگی اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 803.9,
   "end": 806.28,
   "text": "متأسفانه همه چشم دیدن به اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 806.28,
   "end": 808.5,
   "text": "وقتی این جمله رو پیغمبر میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 808.5,
   "end": 812.96,
   "text": "انصار و مهاجرین میگن ما با پیغمبر خدا عهدی بستیم که تا آخرش هم هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 812.96,
   "end": 816.38,
   "text": "یعنی انگار که شارژ میشن با این فرمایش پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 816.38,
   "end": 819.94,
   "text": "یعنی منتظر و مترصد اجر الهی برای اون ور باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 819.94,
   "end": 823.06,
   "text": "اینجا که حضرت علامه می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 823.06,
   "end": 825.04,
   "text": "در این جمله می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 825.04,
   "end": 827.46,
   "text": "و این آخر کلمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 827.46,
   "end": 831.5,
   "text": "\"و ان فضلی\" یعنی برتری، بر دیگران برتری میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 831.5,
   "end": 836.12,
   "text": "که عنوان یعنی یک تیتر یک برنامه شروع برنامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 836.12,
   "end": 838.14,
   "text": "\"تعیّش است دیگر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 838.14,
   "end": 840.56,
   "text": "یعنی یه زندگی دیگه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 840.56,
   "end": 843.64,
   "text": "یعنی چشمت به جای دیگه‌ای باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 843.64,
   "end": 845.84,
   "text": "یه چیزای دیگه‌ای می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 845.84,
   "end": 849.78,
   "text": "حتی خدا اینم عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 849.78,
   "end": 851.82,
   "text": "یکی از عرفا می‌رفت کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 851.82,
   "end": 855.96,
   "text": "چند بار تا حالا ما رفتیم؟ چند بار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 855.96,
   "end": 858.0,
   "text": "بعضیامون عددش از دستمون رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 858.0,
   "end": 865.74,
   "text": "چجوری رفتیم؟ چگونه است که علامه حسن زاده سلام \"السلام علیک ایها النبي\" رو میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 865.74,
   "end": 870.92,
   "text": "تأمل می‌کنه تا ببینه جواب سلام می‌شنوه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 870.92,
   "end": 874.9,
   "text": "اون عارف به الله میره کربلا تو راه یه روستایی رو میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 874.9,
   "end": 877.76,
   "text": "یه آدم خیلی درب و داغون به قول ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 877.76,
   "end": 879.54,
   "text": "که یهو جلوشو میگیره. می‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 879.54,
   "end": 881.68,
   "text": "نمی‌شناخته این کیه با این قیافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 881.68,
   "end": 884.66,
   "text": "میگه کجا میری؟ این عارف میگه دارم میرم زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 884.66,
   "end": 888.14,
   "text": "ابا عبدالله. میگه برای چی میری؟ میگه میخوام برم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 888.14,
   "end": 890.04,
   "text": "همین طوری حالا میخواد اینو از سر خودش باز کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 890.04,
   "end": 892.9,
   "text": "میگه میخوام برم یه سلامی به ابا عبدالله بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 892.9,
   "end": 897.58,
   "text": "اونم میگه خب حالا که تا حالا این همه سلام دادی جوابم گرفتی یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 897.58,
   "end": 899.64,
   "text": "میگه جواب که میمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 899.64,
   "end": 901.32,
   "text": "چی بگه؟ نه جوابی نگرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 901.32,
   "end": 904.4,
   "text": "می‌فرمود که یه طوری سلام بده که جواب بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 904.4,
   "end": 909.22,
   "text": "اونا جواب میدن. تو بشنوی جوابشونو بشنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 909.22,
   "end": 914.02,
   "text": "بعد خودش رو می‌کنه این روستاییه به قول ما مثلاً فرتوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 914.02,
   "end": 916.0,
   "text": "رو می‌کنه به کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 916.0,
   "end": 918.9,
   "text": "میگه \"السلام علیک یا ابا عبدالله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 918.9,
   "end": 925.18,
   "text": "این عارف میگه دیدم زمین و زمان و کوه و دشت و همه دارن سلام جواب سلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 925.18,
   "end": 928.92,
   "text": "ارباب رو به ایشون می‌رسونن و علیک السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 928.92,
   "end": 933.68,
   "text": "بعد تنم لرزید. به من گفت می‌تونی اینطوری سلام بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 933.68,
   "end": 937.7,
   "text": "گفتم ما سلام میدیم اما دیگه نمی‌تونم اینطوری بعید می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 937.7,
   "end": 941.2,
   "text": "گفت حالا بده. گفتم \"السلام علیک یا ابا عبدالله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 941.2,
   "end": 943.36,
   "text": "دیدم جواب سلام منم اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 943.36,
   "end": 947.34,
   "text": "اما نه اونطوری با اون عظمت که همه زمین و زمان بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 947.34,
   "end": 950.08,
   "text": "یه جواب سلامی اومد. این چنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 950.08,
   "end": 951.74,
   "text": "میگه یه تعیّش دیگریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 951.74,
   "end": 955.48,
   "text": "اصلا معاشقه تو با یه چیزای دیگه‌ای میشه.",
