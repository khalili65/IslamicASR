 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ چهل و نه؛ بازداشتن از هرزه‌خواری و هرزه‌گویی",
   "start": 92.96,
   "end": 261.2
  },
  {
   "index": 1,
   "title": "## وضع حدیث و ادعای سحر پیامبر",
   "start": 261.2,
   "end": 627.13
  },
  {
   "index": 2,
   "title": "## الرسالة العنبریة، سهو النبی و فصل الخطاب",
   "start": 627.13,
   "end": 881.29
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.0,
   "end": 5.32,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.32,
   "end": 9.08,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.08,
   "end": 13.38,
   "text": "آیاته. سلام علیک و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.38,
   "end": 19.0,
   "text": "یکی از شروط امام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.0,
   "end": 21.84,
   "text": "اینه که تلفظش درست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.84,
   "end": 25.1,
   "text": "مخارج حروف رو ادا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.1,
   "end": 30.4,
   "text": ". به قول امام که علیه الرحمه اصلا می‌فرمود به لحن عربی باید کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.4,
   "end": 34.58,
   "text": "حالا وسط نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.58,
   "end": 38.88,
   "text": "متوجه شدیم که تلفظ امام غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.88,
   "end": 44.38,
   "text": "چه باید بکنیم؟ وسط نماز جماعت ابتدا کردیم متوجه می‌شیم که دقت هم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.38,
   "end": 48.58,
   "text": "می‌گوییم آقا ببین درست داره تلفظ می‌کنه به گوش من بد می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.58,
   "end": 51.62,
   "text": "اما نه یقین حاصل کردی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.62,
   "end": 54.88,
   "text": "تلفظ امام غلطه .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.88,
   "end": 56.86,
   "text": "چه باید بکنیم؟ اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.86,
   "end": 59.28,
   "text": "باید نیت فرادا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.28,
   "end": 61.7,
   "text": "حق نداری دیگه جماعت رو ادامه بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.7,
   "end": 64.76,
   "text": "انقدر مهمه ها اینا. باید نیت فرادا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.76,
   "end": 69.34,
   "text": "منتها اینجا به گونه‌ای باید نماز رو ادامه بدی از اونجا به بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.34,
   "end": 71.72,
   "text": "از اونجا به بعد دیگه خودت باید فرادات رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.72,
   "end": 77.8,
   "text": "کسی متوجه نشه شما شکستی جماعتت رو و داری فرادا می‌کنی چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.8,
   "end": 80.52,
   "text": "نباید حرمت جماعت شکسته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.52,
   "end": 83.18,
   "text": "حرمت امام جماعت خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.18,
   "end": 86.48,
   "text": "پیش خدا خیلی این حرمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.48,
   "end": 92.88,
   "text": "برای همین این رو توجه داشته باشیم و اگر این اتفاق افتاد کسی متوجه نشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.88,
   "end": 96.76,
   "text": ". در کلمه چهل و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.76,
   "end": 99.88,
   "text": "از صد کلمه در معرفت نفس علامه هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.88,
   "end": 102.72,
   "text": "رسیدیم به کلمه چهل و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.72,
   "end": 105.56,
   "text": "آنکه چند روزی خود را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 105.56,
   "end": 110.1,
   "text": "چه جالب می‌فرماید چند روزی‌ها خیلی هم نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.1,
   "end": 112.12,
   "text": ". چند سال و فلان اینا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 112.12,
   "end": 114.86,
   "text": "آنکه چند روزی خود را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 114.86,
   "end": 119.54,
   "text": "از هرزه خواری و هرزه کاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.54,
   "end": 126.32,
   "text": "و از گزاف و یاوه سرایی بلکه زیاده گویی این می‌شه زی-- چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.32,
   "end": 129.7,
   "text": "هرزه گویی. از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.7,
   "end": 131.8,
   "text": "یعنی در حقیقت از هرزه خواری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 131.8,
   "end": 134.34,
   "text": "هرزه کاری و هرزه گویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 134.34,
   "end": 142.62,
   "text": "یه چند روز و خلاصه از مشتهیات و تعشقات حیوانی بازبدارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.62,
   "end": 147.42,
   "text": "چه اتفاقی میفته؟ می‌بیند که اقتضای تکوینی نفس این است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 147.42,
   "end": 151.88,
   "text": "یعنی اصلا خلقت نفس اینطوریه، انشا‌ش اینطوریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.88,
   "end": 156.32,
   "text": "که از ریاضت، ضمیر ویاع یعنی نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.32,
   "end": 158.6,
   "text": "و صفا می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.6,
   "end": 162.3,
   "text": "کسی تو دنبال نوره، یا نور یا قدوس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.3,
   "end": 165.94,
   "text": "دنبال صفاست که صفا از همون قدوسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.94,
   "end": 171.12,
   "text": "این میگه راهش اینه. ریاضت نفس و آثار او را نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.12,
   "end": 174.16,
   "text": "و بهایی‌ست. از خود نفس که نورانی می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 174.16,
   "end": 181.36,
   "text": "آثارش همین چنینه. پس اگر ریاضت مطابق دستورالعمل انسان‌ساز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.36,
   "end": 184.58,
   "text": "اعنی منطق وحی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.58,
   "end": 189.02,
   "text": "یعنی همچین هر کسی ریاضت نگیره یا دستور نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.02,
   "end": 196.92,
   "text": "إن هذا القرآن يهدي للتي هي أقوم بوده باشد یعنی بر اساس قرآن اون هدایت أقوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.92,
   "end": 202.26,
   "text": "قیامش به قرآن باشه. یا اینطوری باشه اقتضای تکوینی نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.26,
   "end": 205.22,
   "text": "به کمال غایی و نهایی خود نائل آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.22,
   "end": 208.7,
   "text": "به کمال غایی نفس سعادت نفس چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.7,
   "end": 212.74,
   "text": "جلسه پیش عرض کردیم در کلمه قبلی، کلمه چهل و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.74,
   "end": 216.1,
   "text": "که تصرفه در ماده کائناته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.1,
   "end": 219.74,
   "text": "به همین راحتی. حالا چرا ما به اینجا نرسیدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.74,
   "end": 222.5,
   "text": "دیگه جای تعامل داره .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.5,
   "end": 225.6,
   "text": "تعاملش رو برگردون به همون سه جمله اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.6,
   "end": 228.62,
   "text": "هرزه خاری، هرزه کاری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.62,
   "end": 237.28,
   "text": "هرزه گویی. مخصوصا هرزه گویی که دیگه بیداد می‌کنه بین خودمون آقا نه رو جای در غریبه نریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.28,
   "end": 239.62,
   "text": "بین خودمون هرزه گویی بیداد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.62,
   "end": 241.6,
   "text": "یعنی وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.6,
   "end": 244.72,
   "text": "و همین بچه‌های خودمون جای دور نریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.72,
   "end": 248.56,
   "text": "وقتی حتی مخصوصا وقتی میفتن به مزاح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.56,
   "end": 250.7,
   "text": "خدا نکنه ماها به مزاح بیوفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.7,
   "end": 254.68,
   "text": "بلد نیستیم. یه چیزهایی میگیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.68,
   "end": 259.94,
   "text": "حالا از این بگیر این هرزه گویی رو بگیر برو تا حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.94,
   "end": 267.16,
   "text": "قرآن، تحریف قرآن، احادیث، کتاب‌ها و چقدر کتاب نوشته شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.16,
   "end": 271.02,
   "text": "بر علیه اصیل‌ترین مبانی فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.02,
   "end": 274.16,
   "text": "دین اسلام. مثلا در تو خود انقلاب ما چقدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.16,
   "end": 278.56,
   "text": "یه کتابی تو ایتالیا پخش شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.56,
   "end": 280.38,
   "text": "توی فرانسه چاپ شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.38,
   "end": 287.36,
   "text": "تو ایتالیا هم پخش شده بود که چند تا کشور اروپایی متاسفانه پخش شده بود به زبون‌های رایج‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.36,
   "end": 292.02,
   "text": "که امام، امام علیه الرحمه بنیان‌گذار این انقلاب ملاک بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.02,
   "end": 294.94,
   "text": "خیلی تملک، اصلا خیلی ملک داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.94,
   "end": 297.98,
   "text": "گواش با شاه سر این بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.98,
   "end": 300.24,
   "text": ". لذا انقلاب به این خاطر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.24,
   "end": 302.46,
   "text": "این تحریف، هرزه گویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.46,
   "end": 307.08,
   "text": "تا دلت بخواد. تو خود ماها، بچه حسینی‌هامون، هیئتی‌هامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.08,
   "end": 309.64,
   "text": "و باعث اس-- تاسف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.64,
   "end": 314.3,
   "text": "آنچنانی که حتی کسایی که تریبون به دستن و مثلا حتی می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.3,
   "end": 319.96,
   "text": "لباس پیغمبر مثل من به تن مدعاهای بعضی مشهور و گفیه چیزایی میگن اصلا مخت سود می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.96,
   "end": 323.26,
   "text": "از کجا اینو درآوردی؟ از کجا اینو آوردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.26,
   "end": 325.54,
   "text": "از کجا آستینت درآوردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.54,
   "end": 329.5,
   "text": "اتفاقا این کتاب هزار و یک نکته رو داشتم می‌خوندم امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.5,
   "end": 331.92,
   "text": "رسیدم به نکته نهصد و بیست و هشتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 331.92,
   "end": 336.04,
   "text": "دیدم اصلا خدا خودش همه چی رو تنظیم می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 336.04,
   "end": 339.06,
   "text": ". که همین رو داره تو-- برید رجوع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 339.06,
   "end": 341.88,
   "text": "هست این کتاب خاصه در الان اینجا بیاید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 341.88,
   "end": 345.22,
   "text": "نکته نهصد و بیست و هشتش علامه اشاره به همین داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.22,
   "end": 353.34,
   "text": "می‌بردت تو کتاب مجمع البيان در تفسیر قرآن مورد مرحوم تدرسی علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 353.34,
   "end": 359.1,
   "text": "که اونجا ذیل شأن نزول معوذتين خصوصا سوره فلق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.1,
   "end": 362.88,
   "text": "تعویذه دیگه برای دوری از سحر و جادو و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.88,
   "end": 365.22,
   "text": "اونجا روایاتی رو مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.22,
   "end": 368.91,
   "text": "امین الاسلام عليه الرحمة میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.91,
   "end": 374.19,
   "text": "چقدر دروغ بستن و واعين و ضاع، ضاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 374.19,
   "end": 377.37,
   "text": "و ضاع و ضاعین وضع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.37,
   "end": 382.27,
   "text": "یه چیزی رو یه جایی قرار بدی. و ضاع یعنی کسی که به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.27,
   "end": 387.91,
   "text": "الکی هم چیزی برای خودش حدیث می بافه، حرف می-- دروغ می ترچه و می بنده بین اون بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 387.91,
   "end": 390.35,
   "text": "تا دلت بخواد. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 390.35,
   "end": 392.65,
   "text": "اونجا می فرما-- مثلاً میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.65,
   "end": 395.65,
   "text": "یه شخصی اسمش هم اونجا میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.65,
   "end": 399.45,
   "text": "به نام لبید بن أعسم یهودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.45,
   "end": 401.75,
   "text": "لبید أعسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.75,
   "end": 406.81,
   "text": "یهودی. این مدعی بود که من پیغمبر رو سحر کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.81,
   "end": 412.71,
   "text": "جادو کردم. بعد به، به تبعش خیلی‌ها رو افتادن که آره پیغمبر سحر شده اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 412.71,
   "end": 414.87,
   "text": "بعد چقدرم حدیث جعل کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 414.87,
   "end": 418.05,
   "text": "که آره پیغمبر العیاذ بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 418.05,
   "end": 423.97,
   "text": "اینا رو مرحوم طباطبایی میاره‌ها. درخت رو می‌دیده با شتر العیاذ بالله اشتباه می‌گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 423.97,
   "end": 427.31,
   "text": "نور چشمش رفته بوده، دست به دیوار می‌گرفته راه می‌رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.31,
   "end": 434.21,
   "text": "یعنی اثر سحر. پس آقای حاج تهرانی حسن زاده عليه الرحمة در درس نود و یک شرح مصباح الانسابش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 434.21,
   "end": 437.71,
   "text": "محکم وا میسته میگه اصلاً محال چنین چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.71,
   "end": 442.05,
   "text": "او نفس کل، اون عقل کل نفس کل صادر اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.05,
   "end": 447.23,
   "text": "خاتم الانبیا و لکن فی رسول الله اسوه حسنه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.23,
   "end": 450.03,
   "text": "مگه میشه کسی که اسوه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.03,
   "end": 453.11,
   "text": "جلودار و پیشوای برای همه‌ی عوالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.11,
   "end": 456.77,
   "text": "و عالمین بعد اینطوری مثلاً نتونه درست راه بره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.77,
   "end": 461.35,
   "text": "بعد سحر درش کار. این نفس هرچی قوی‌تره--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 461.35,
   "end": 465.59,
   "text": "علت اینکه ما خیلیامون زود چشم می‌خوریم، طلسمات قابل توجه هممون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 465.59,
   "end": 468.21,
   "text": "زود در ما تاثیر می‌کنه ضعف نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.21,
   "end": 472.21,
   "text": "نفس مثلاً این همه شما فکر می‌کنی یهودیا، صهیونیست‌ها این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.21,
   "end": 474.77,
   "text": "دست به کار نشدن، شیاطین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 474.77,
   "end": 481.03,
   "text": "اجنه و انسش حالا همه جن و انسش بر علیه مثلاً انقلاب ما، رهبر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 481.03,
   "end": 483.17,
   "text": "سحر و جادو نکردن تا دلت بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 483.17,
   "end": 485.81,
   "text": "چرا اثر در رهبر عزیزمون نکرد و نمی‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 485.81,
   "end": 488.53,
   "text": "چرا؟ ماشاءالله روز به روز خورشیدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.53,
   "end": 492.61,
   "text": "پرفروغ‌تر، چهره مصمم‌تر، زیباتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 492.61,
   "end": 498.17,
   "text": "اصلاً همین چهره ظاهری رهبر رو باور کنید بزرگان ما، مثلاً علامه رو من که از نزدیک دیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 498.17,
   "end": 500.97,
   "text": "اصلاً بهترین دلیل و گواه بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 500.97,
   "end": 505.85,
   "text": "چشم، بدون مسلم و غیرمسلح می‌تونی ببینی که بر حقانیتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 505.85,
   "end": 508.61,
   "text": "خورشیده اصلاً. چهره، چهره‌ی واقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 508.61,
   "end": 510.71,
   "text": "همین متعارف نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 510.71,
   "end": 512.35,
   "text": "خب چرا اینا تأثیر نمی‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 512.35,
   "end": 518.21,
   "text": "قوت نفسه. انقدر تا دلت بخواد از این وضعاین داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 518.21,
   "end": 523.09,
   "text": "اتفاقاً خود علامه در همون درس نود و یک مصباح می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 523.09,
   "end": 530.73,
   "text": "یه سری اومدن پیش ما، محرمی بود گفتن تو یکی از دعای عامول آخوندی اومده حرفای خیلی جدید و خوبی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.73,
   "end": 536.95,
   "text": "گفتن خب چی میگه؟ گفتن این گفته بالا منبر که دو نفر اومدن پیش پیغمبر زن و مرد بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 536.95,
   "end": 539.53,
   "text": "اینکه الصلاة، صلاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 539.53,
   "end": 546.25,
   "text": "مؤنثه دیگه. قد قامت الصلاة اسم زنه بود قد قامت الفلاح اسم مرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 546.25,
   "end": 548.73,
   "text": "یه کاری برای پیغمبر کردن بعد جزاشو خواستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 548.73,
   "end": 551.61,
   "text": "پیغمبر فرمود چون خیلی کار قشنگی کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 551.61,
   "end": 558.33,
   "text": "من شما رو در اذان قرار میدم تا قیام قیامت نامتون باقی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 558.33,
   "end": 561.79,
   "text": "اصلاً آدم تعجب می‌کنه چشمای شما هم الان چهار تا سینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.79,
   "end": 564.71,
   "text": "از کجا در میاد؟ یه آخوند بالا منبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 564.71,
   "end": 569.05,
   "text": "و اتفاقاً علامه اشاره می‌کرد به آیه هشت و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.05,
   "end": 574.37,
   "text": "فرقان که اگر اینطوری واقعاً این‌ها سحر کردن، حالا قبول سحر دست به کار شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 574.37,
   "end": 577.07,
   "text": "ها؟ اصلاً قبول که دست به کار شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 577.07,
   "end": 583.69,
   "text": "اما این آیه چی میگه؟ وقال الظالمون ان تتبعون الا رجلاً مسحورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.69,
   "end": 591.19,
   "text": "یعنی اینا شما میگن که ظالم‌ها میگن شما ت-ت-تبعیت نمی‌کنید مگر از یه آدمی که مسحوره، سحر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 591.19,
   "end": 595.35,
   "text": "اگه واقعاً سحر شده چرا خدا به اینا میگه ظالم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 595.35,
   "end": 602.51,
   "text": "واقعاً سحره دیگه. سحر شده. یه آیه بعدش می‌فرماید که قل كيف ربو لك الأمثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 602.51,
   "end": 604.67,
   "text": "فولوا فلا يستطيعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 604.67,
   "end": 607.13,
   "text": "میگه اینا فولوا پس گمراه شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 607.13,
   "end": 611.57,
   "text": "اینایی که ادعا کردن پیغمبر سحر شده و فلان، این حرفا رو زدن گمراه شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 611.57,
   "end": 613.69,
   "text": "اگه دروغه چرا گمراهی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 613.69,
   "end": 615.93,
   "text": "اگه راسته، اگه واقعاً پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 615.93,
   "end": 618.77,
   "text": "سحر شده اینا گمراهی، گمراه نبودن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 618.77,
   "end": 620.79,
   "text": "ظالم نبودن حقیقتو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 620.79,
   "end": 626.87,
   "text": "ولی قرآن اینا رو رد می‌کنه. خیلی راحت با قرآن میشه جوابشون رو داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 626.87,
   "end": 630.21,
   "text": "خود علامه می‌فرمود که حالا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 630.21,
   "end": 632.35,
   "text": "فر-فرمود یه کتابی رو من دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 632.35,
   "end": 634.73,
   "text": "ایشون می‌فرما من ندیدم البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 634.73,
   "end": 641.71,
   "text": "علامه می‌فرمایید من دیدم به نام الرسالة العنبریه في الصادرات المنبریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 641.71,
   "end": 644.69,
   "text": "چیزایی که صادر شده از منبری‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 644.69,
   "end": 647.89,
   "text": "تا دلت بخواد خزعبلات و اسرائیلیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 647.89,
   "end": 653.85,
   "text": "و اشاره می‌کنه به اون سفرنامه ناصرخسرو که میگه اون، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 653.85,
   "end": 657.65,
   "text": "عقلای اینا رفتیم حالا یه جایی به نزدیک به حجاز شدیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 657.65,
   "end": 659.91,
   "text": "بعد دیدیم که عاقل مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 659.91,
   "end": 662.93,
   "text": "آدمایی که اونجا دم از اسلام می‌زدن اومدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 662.93,
   "end": 666.33,
   "text": "و گفتن که آقا تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.33,
   "end": 669.19,
   "text": "surه نقاله الحطب رو برای ما بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 669.19,
   "end": 673.21,
   "text": "عقلای اون قوم. گفتیم آقا نقاله الحطب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 673.21,
   "end": 676.47,
   "text": "حماله الحطب. گفتن نه ما اینطوری شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 676.47,
   "end": 679.55,
   "text": "تازه اونا که حجاز سرزمین اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 679.55,
   "end": 682.83,
   "text": "تا دلت بخواد از این موضوعات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 682.83,
   "end": 686.57,
   "text": "متأسفانه، متأسفانه و متأسفانه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 686.57,
   "end": 688.65,
   "text": "شیخ صدوق من حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 688.65,
   "end": 690.67,
   "text": "نمی‌خوام اینطوری اسم ببرم اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 690.67,
   "end": 696.71,
   "text": "هر جایی نمیشه این حرفا رو زد. اما خب برای ما همیشه سؤال هست چرا امثال مثلاً حاجی نوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 696.71,
   "end": 700.45,
   "text": "محدث نوری صاحب کتاب مثلاً لؤلؤ و مرجان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 700.45,
   "end": 705.71,
   "text": "یه کتاب داره به نام فصل الخطاب فی تحریف کتاب رب الارباب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 705.71,
   "end": 709.47,
   "text": "در تحریف قرآن. این عالم بزرگوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 709.47,
   "end": 713.77,
   "text": "شیخ صدوق یه کتابی داره به نام سحو النبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 713.77,
   "end": 717.69,
   "text": "اکثر غریبه به اتفاق علمای امامیه و شیعه رد می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 717.69,
   "end": 720.17,
   "text": "میگن اصلاً محاله. حالا ایشون میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 720.17,
   "end": 728.99,
   "text": "در عصمتش مثلاً در نبوتش اخذ تلقیات الهی و وحی و اینا معصوم بوده اما در زندگی روزمره سحو داشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 728.99,
   "end": 732.15,
   "text": "فراموشی. مثلاً در یک نمازی پیغمبر فراموشش شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 732.15,
   "end": 735.49,
   "text": "مثله یه وقت من شک بکنم نفهمم چه رکتی‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 735.49,
   "end": 738.33,
   "text": "أستغفرالله. به شدت بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 738.33,
   "end": 744.09,
   "text": "رد می‌کنند این‌ها رو. بعد خیلی شیرین علامه شهرانی، استاد علامه حسن زاده می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 744.09,
   "end": 748.43,
   "text": "اگر بحث سحو النبی باشه شیخ صدوق که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 748.43,
   "end": 751.23,
   "text": "سحو النبی نوشته خود شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 751.23,
   "end": 754.69,
   "text": "اولى است به سهو تا پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 754.69,
   "end": 757.49,
   "text": "اولى است به سهو، اشتباه، خطا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 757.49,
   "end": 761.09,
   "text": "خطا کرده این کتابو نوشته. حتی دلت بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 761.09,
   "end": 765.01,
   "text": "متأسفانه از این‌ها که زیادن یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 765.01,
   "end": 773.53,
   "text": "متأسفانه الان رو بالای منبر هم خیلیا میش- میشنویم، می‌بینیم تو همین انقلاب خودمون حتی متأسفانه بعضی از منبرای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 773.53,
   "end": 779.51,
   "text": "معروفمون. علامه حلی حالا اگر خواستید تحقیقی هم بکنید دو سه تا سند و مدرک ارائه بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 779.51,
   "end": 781.67,
   "text": "در خلاصه الرجالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 781.67,
   "end": 784.03,
   "text": "شیخ بهائ‌ در اربعینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 784.03,
   "end": 790.35,
   "text": "اونجا میارن که یه شخصی به نام بابا رتن هندی چند هزار حالا الان عددش تو خاطرم نمونده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 790.35,
   "end": 795.83,
   "text": "چند هزار حدیث دروغین وضع کرد و در کتاب‌ها جای داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 795.83,
   "end": 799.19,
   "text": "که حالا علامه شهرانی در جواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 799.19,
   "end": 803.69,
   "text": "همون فصل الخطاب مرحوم حاجی نوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 803.69,
   "end": 805.67,
   "text": "می‌نویسه، یه خلاصه‌ای می‌نویسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 805.67,
   "end": 807.63,
   "text": "حاشیه‌ای می‌زنه بر رد اون کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 807.63,
   "end": 810.63,
   "text": "بعد علامه اینو جمع‌آوری می‌کنه خودش هم چیزی اضافه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 810.63,
   "end": 813.65,
   "text": "یک چیز کتاب خیلی شیرین. خواستید روژو کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 813.65,
   "end": 816.47,
   "text": "همون عنوان حاجی نوری رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 816.47,
   "end": 820.57,
   "text": "چی بود؟ فصل الخطاب فی تحریف کتاب رب الارباب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 820.57,
   "end": 826.71,
   "text": "یعنی قرآن تحریف شده. اما علامه فرمود که فصل الخطاب فی عدم تحریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 826.71,
   "end": 831.09,
   "text": "کتاب رب الارباب و خیلی محکم، قاطعانه جوابشونو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 831.09,
   "end": 833.27,
   "text": "اینه که انسان پشت سر علما باید حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 833.27,
   "end": 835.05,
   "text": "ما باید پشت سر بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 835.05,
   "end": 838.47,
   "text": "برای همین ما اصرار داریم پشت سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 838.47,
   "end": 843.51,
   "text": "علمای جامعه الاطراف راه بیفتیم حتی نه هر عالمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 843.51,
   "end": 847.59,
   "text": "خیلی باید حواسمونو جمع کنیم. اینه که حالا چرا بحث به اینجا کشیده شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 847.59,
   "end": 850.71,
   "text": "چون علامه یک می‌فرمود که از هرزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 850.71,
   "end": 859.55,
   "text": "خواری، هرزه کاری و هرزه گویی یه چند وقت نفست رو حفظ کن خصوصا این هرزه گویی رو ما امروز تاکید کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 859.55,
   "end": 862.63,
   "text": "حفظ کن ببین چی می‌شه. ببین چجوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 862.63,
   "end": 868.07,
   "text": "نورانی می‌شی و آثار وجودیت هم پر از نور می‌شه و می‌تونی تصرف کنی در ماده کائنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 868.07,
   "end": 872.85,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 872.85,
   "end": 880.71,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 880.71,
   "end": 881.29,
   "text": "محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}