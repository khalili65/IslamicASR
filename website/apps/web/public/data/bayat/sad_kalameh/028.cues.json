 "chapters": [
  {
   "index": 0,
   "title": "## سه آیه؛ جزا نفس عمل است",
   "start": 10.6,
   "end": 172.42
  },
  {
   "index": 1,
   "title": "## وهو فعلک؛ آنچه با تو در قبر می‌آید",
   "start": 172.42,
   "end": 373.56
  },
  {
   "index": 2,
   "title": "## شوره‌زار؛ رد ولایت و البلد الطیب",
   "start": 373.56,
   "end": 533.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 3.68,
   "text": "بسم الله الرحمن الرحیم و به نصرستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.68,
   "end": 10.6,
   "text": "السلام علیک یا داعی الله و ربانی ایاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.6,
   "end": 18.1,
   "text": "کلمه بیست و هفتم. آنکه در کریمه دقت کنید تو این کلمه بیست و هفتم حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.1,
   "end": 20.74,
   "text": "سه تا آیه رو مورد دقت قرار دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.74,
   "end": 26.14,
   "text": "سه تا آیه. آنکه در کریمه \"لا تجزون الا ما کنتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.14,
   "end": 32.76,
   "text": "تعملون\" یعنی جزای این‌ها نیست مگر اون کاری که انجام دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.76,
   "end": 35.54,
   "text": "لذا جزا میشه نفس عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.54,
   "end": 40.76,
   "text": "و \"هل یثب، هل ثوب الكفار ما كانوا يفعلون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.76,
   "end": 45.34,
   "text": "که آیا کفار نرسیدن به اون کاری که انجام می‌دادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.34,
   "end": 49.02,
   "text": "می‌رسن به چی؟ به کاری که انجام می‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.02,
   "end": 52.34,
   "text": "مثل لباسی که به تن می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.34,
   "end": 56.02,
   "text": "لباسی که به تن می‌کنند همون عملشونه، میشه جزاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.02,
   "end": 60.3,
   "text": "اینم یه آیه و \"کلما رزقوه منها من ثمرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.3,
   "end": 62.64,
   "text": "من ثمرة رزقا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.64,
   "end": 64.58,
   "text": "وقتی به اینا تو اون دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.58,
   "end": 71.12,
   "text": "رزق‌هایی داده میشه \"قالوا\" اینا میگن \"هذا الذي رزقنا من قبل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.12,
   "end": 78.46,
   "text": "از قبل \"هذا الذي\" همین رزق از قبل به ما داده شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.46,
   "end": 80.76,
   "text": "و \"أتوه متشابهة\" و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.76,
   "end": 83.3,
   "text": "متشابه همون‌ها رو بهشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.3,
   "end": 88.54,
   "text": "یعنی شبیه به همون‌ها رو به همون رزق‌هایی که تو دنیا داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.54,
   "end": 93.0,
   "text": "که بالاترین رزق این دنیا بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.0,
   "end": 97.74,
   "text": "رزق وجود، رزق ولایت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.74,
   "end": 100.52,
   "text": "که اونجا مشابهش رو می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.52,
   "end": 102.46,
   "text": "بعد این‌ها رو که حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.46,
   "end": 109.48,
   "text": "مورد توجه قرار می‌دن می‌فرمایند که و نظائر آنها به خوبی اندیشه کند اون که تو، تو نظائر این آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.48,
   "end": 112.74,
   "text": "و این دسته آیات توجه کند، اندیشه کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.74,
   "end": 118.84,
   "text": "جزا را موافق اعمال و عقاید می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.84,
   "end": 122.54,
   "text": "جزا را موافق اعمال و عقاید یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.54,
   "end": 126.14,
   "text": "هرچی که هست دست خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.14,
   "end": 128.46,
   "text": "آقا جزای من در قیامت چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.46,
   "end": 130.42,
   "text": "به من، با من چگونه رفتار میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.42,
   "end": 135.9,
   "text": "به من چی میدن؟ همون کارهایی که داری اینجا ان، انجام میدی، عقایدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.9,
   "end": 141.48,
   "text": "که قبلاً عرض شد اعمالت بدنت رو اونجا می‌سازه و شکل میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.48,
   "end": 144.42,
   "text": "اعمالت، اعمالت بدنت رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.42,
   "end": 150.94,
   "text": "عقاید و افکار و این‌ها علوم و معارفی که اخذ می‌کنی نفس و جانت رو شکل میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.94,
   "end": 157.74,
   "text": "اتفاقاً آیه دیگه‌ای از قرآن هست که حالا اینجا علامه فرمودن و نظائر این آیات قطعاً این هم مورد توجه‌شون بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.74,
   "end": 160.92,
   "text": "آیه بیست و شش سوره نف-- نبع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.92,
   "end": 164.32,
   "text": "چه آیه عجیبیه. \"جزاء وفاقا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.32,
   "end": 169.32,
   "text": "وفاقا. میگه اون جزایی که میدن به وفق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.32,
   "end": 172.42,
   "text": "خودته، اعمال خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.42,
   "end": 177.22,
   "text": "و چه شیرین که حالا حیف شد با خودم نیاوردم کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.22,
   "end": 180.0,
   "text": "شریف امالی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.0,
   "end": 186.0,
   "text": "اونجا در امالی شیخ صدوق علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.0,
   "end": 192.34,
   "text": "عرض شود یه حدیث مفصلی رو میاره که حالا یه بیابون گردی میاد پیش پیغمبر خلاصه‌ش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.34,
   "end": 196.56,
   "text": "میگه آقا شما پیغمبر خدا هستی و اینا ما هم بیابون گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.56,
   "end": 200.08,
   "text": "یه چیزی به ما یه هدیه، یه تحفه ای این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.08,
   "end": 202.08,
   "text": "که مثلاً همه عمr به درد ما بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.08,
   "end": 207.96,
   "text": "پیغمبر مضامین بلندی رو عجیب به این بیابون گرد میده که یه نفرم اونجا نشسته بوده اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.96,
   "end": 211.3,
   "text": "شعرش میکنه همونجا میخونه پیغمبر خوشحال میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.3,
   "end": 215.08,
   "text": "اگه خواستید تو امالی شیخ صدوق متن روایت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.08,
   "end": 218.84,
   "text": "انتها آخر آخر روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.84,
   "end": 226.22,
   "text": "پیغمبر بعد از این که حرفای بلند و عرشی رو پیاده میکنه می فرماید در خصوص چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.22,
   "end": 232.98,
   "text": "این که وقتی شما رو تو قبر میذارن یه چیزی با شما دفن میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.98,
   "end": 240.28,
   "text": "حالا در تمثلات که بعضی از بزرگان داشتن دیدن مثلاً آدم بدی دفن شد یه سگ همراهش رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.28,
   "end": 247.54,
   "text": "یا یه آدم خوب مؤمنی دفن شد، یه مؤمن زیباروی، خوشبو، خوشرویی رفت تو قبر باهاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 247.54,
   "end": 254.58,
   "text": "اینجا آخرین کلمه‌ای که پیغمبر می فرماید، می فرماید اون چیزی که با تو دفن میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 254.58,
   "end": 260.06,
   "text": "میخوای بهت بگم کیه به اون عرب بیابون گرد داره میگه عجب حرفی به اون زده، اون کی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 260.06,
   "end": 262.82,
   "text": "فرمود \"وهو فعلك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 262.82,
   "end": 268.84,
   "text": "آقا بزرگان حکمت و عرفان کتاب‌ها نوشتن که راه‌مون همه یه کلمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 268.84,
   "end": 271.32,
   "text": "و خطبه‌ها گفتن و خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 271.32,
   "end": 274.74,
   "text": "اون چیزی که با تو دفن میشه همون فعل خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 274.74,
   "end": 278.8,
   "text": "از اینجا می فرماید که خب جزام که موافق عمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 278.8,
   "end": 282.64,
   "text": "بلکه بزرگان فرمودن که اینو پیاده‌ش کردن فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 282.64,
   "end": 284.76,
   "text": "اصلاً جزا نفس عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.76,
   "end": 287.8,
   "text": "یعنی اون چیزی که به تو میدن همون عملته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 287.8,
   "end": 291.7,
   "text": "اینجا هم که پیغمبر فرمود اینکه با تو دفن میشه \"وهو فعلك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.7,
   "end": 293.72,
   "text": "همون عمل خودته باهات دفن میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.72,
   "end": 297.66,
   "text": "یعنی چی؟ یعنی اصلاً خودت با خودت محشور میشی آقا جون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.66,
   "end": 300.68,
   "text": "تمام. دعوا هم با کسی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.68,
   "end": 304.66,
   "text": "هر طور هستی الان طور وجودی‌ت چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.66,
   "end": 308.64,
   "text": "چه از حیث بدن که انزل مراتب وجود خودته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.64,
   "end": 311.7,
   "text": "و نفس ناطقه‌ته، پایین‌ترین رتبه رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.7,
   "end": 316.4,
   "text": "ولی همین بدن هم نشانگر و سایه نفست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.4,
   "end": 320.66,
   "text": "به قول علامه می‌فرمایند به بدن هرکی نگاه کنی می‌فهمی توش چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.66,
   "end": 323.8,
   "text": "این ظاهر نفسه. دقت بفرمایید چی عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.8,
   "end": 325.78,
   "text": "این جدایی از نفس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.78,
   "end": 328.04,
   "text": "بدن انسان جدایی از نفس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 328.04,
   "end": 330.84,
   "text": "صورت و وجه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.84,
   "end": 332.62,
   "text": "جدایی از نفس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 332.62,
   "end": 334.82,
   "text": "لذا صورتو نگاه کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.82,
   "end": 338.52,
   "text": "به سیرت پی‌ببر. صورت رو نگاه کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.52,
   "end": 341.12,
   "text": "به این ظاهره دیگه ظاهر نفست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.12,
   "end": 343.76,
   "text": "حالا باطن نفست رو پیدا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.76,
   "end": 349.82,
   "text": "باور کنید وقتایی که آدم نماز شب می‌خونه با چشم غیرمسلح نور رو تو صورت خودش می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 349.82,
   "end": 358.16,
   "text": "اصلاً کاری به کسی نداره. وقتایی که نماز صبحش قضا میشه تاریکیو تو صورت خودش با چشم غیرمسلح می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 358.16,
   "end": 361.88,
   "text": "قشنگ می‌چشه، حس می‌کنه تاریک شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.88,
   "end": 367.64,
   "text": "گناه می‌کنه. ضعیف شدن، تاریک شدن، ظلمت اینا رو می‌بینه، می‌چشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.64,
   "end": 371.2,
   "text": "تعارف هم باید نکنه با همونم محشور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 371.2,
   "end": 373.56,
   "text": "این یه حقیقت کلی‌ست در نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.56,
   "end": 379.48,
   "text": "وقتی امام صادق تشریفی بردن با یکی از دوستاشون به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 379.48,
   "end": 383.0,
   "text": "بیابونی جایی رسیدن حالا تو بیابون می‌خواستن نماز بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.0,
   "end": 385.14,
   "text": "از قضا اونجا حالا دم نماز هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.14,
   "end": 389.94,
   "text": "جالبه که خب امام معصوم باید اول وقت نماز بخونه دیگه دقت بفرمایید نکته رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.94,
   "end": 393.76,
   "text": "اینو من خودم از لسان حضرت آقا علم الهدى حسنزاده شنیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.76,
   "end": 396.04,
   "text": "مستقیم. ایشون فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 396.04,
   "end": 401.22,
   "text": "که امام صادق می‌خواد حالا الله اکبر نماز رو امام معصوم باید اول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 401.22,
   "end": 403.82,
   "text": "اول از همه دغدغه نماز داشته باشه که داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 403.82,
   "end": 408.84,
   "text": "خب چه کرده امام صادق؟ یه نگاه کردن این رفیقشم که مشغول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 408.84,
   "end": 413.5,
   "text": "آماده‌سازی جای نماز و اینا شد فرمود بریم یه جا دیگه اینجا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.5,
   "end": 416.22,
   "text": "آقا اول وقت فرمود اینجا شورزاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.22,
   "end": 419.26,
   "text": "خب چه اشکالی داره؟ فرمود در شورزار کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 419.26,
   "end": 422.48,
   "text": "حالا خیلی کراهت داره، کراهت داره رو بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 422.48,
   "end": 426.46,
   "text": "مثلا اهل بیت فرمودن دلیلی براش نگفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.46,
   "end": 429.14,
   "text": "و ما هم بی‌خبریم تبه-- تعبدًا می‌گیم چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 429.14,
   "end": 435.0,
   "text": "اما اینجا یه وجه دلیلش رو آورده امام صادق خیلی عجیب و مرتبط با بحث ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 435.0,
   "end": 437.96,
   "text": "حضرت فرمودن این زمین می‌دونید چرا شورزاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.96,
   "end": 441.64,
   "text": "چرا این چن، این چنین شده مثلا هیچ نباتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.64,
   "end": 443.62,
   "text": "هیچ rasteni درش نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 443.62,
   "end": 445.92,
   "text": "به جهت اینکه ولایت ما را قبول نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.92,
   "end": 448.98,
   "text": "عجب! عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 448.98,
   "end": 455.02,
   "text": "ببینید اونچه که هست این زمین اونچه که هست همینی که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 455.02,
   "end": 457.98,
   "text": "همونیه که قبول کرده و خواسته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.98,
   "end": 459.98,
   "text": "ولایت رو رد کرده شده شورزار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.98,
   "end": 462.88,
   "text": "لذا فرمود امام صادق در ادامه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.88,
   "end": 465.3,
   "text": "جایی نماز بخونید که سرسبزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 465.3,
   "end": 468.3,
   "text": "یعنی اون سرسبزی البلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.3,
   "end": 473.68,
   "text": "طيب يخرج نباته باذن ربه آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 473.68,
   "end": 478.48,
   "text": "بلده یا سرزمین پاک به اذن خدا ازش يخرج نبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 478.48,
   "end": 480.68,
   "text": "این نبات و سرسبزی بیرون می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 480.68,
   "end": 484.48,
   "text": "والذي خبث همونی که خبيثه لا يخرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.48,
   "end": 488.94,
   "text": "الا نكدا. که حالا این جالبه حکایتی هم داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 488.94,
   "end": 494.66,
   "text": "اون ملعون خبيث معاویه به امام حسن گفت شما این ریشتون خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 494.66,
   "end": 497.64,
   "text": "پرپشته خیلی ریشتون زیاده اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.64,
   "end": 499.38,
   "text": "حضرت این آیه رو تکرار کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 499.38,
   "end": 502.9,
   "text": "همین والذی البلد طيب يخرج نباته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 502.9,
   "end": 506.48,
   "text": "باذن ربه بعد اشاره به محاسن معاویه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 506.48,
   "end": 509.24,
   "text": "لعنت الله علیه. فرمود والذي خبث لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 509.24,
   "end": 515.88,
   "text": "يخرج الا نكدا تک تک مو داشته ریش معاویه مثل بعضیا که کوسه ان شا الله صدت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 515.88,
   "end": 521.48,
   "text": "بله ان شا الله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.48,
   "end": 526.74,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 526.74,
   "end": 531.34,
   "text": "محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.34,
   "end": 533.92,
   "text": "با یه کسی تعارفش کنم. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}