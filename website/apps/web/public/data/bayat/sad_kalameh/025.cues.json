 },
 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 10.26,
   "end": 84.86
  },
  {
   "index": 1,
   "title": "## طعام‌هایِ طبیعت و غذایِ روح",
   "start": 84.86,
   "end": 181.2
  },
  {
   "index": 2,
   "title": "## علمِ لاینفع؛ پناه به خدا",
   "start": 181.2,
   "end": 399.48
  },
  {
   "index": 3,
   "title": "## پس زدنِ حکمت به نامِ انقلابی‌گری",
   "start": 399.48,
   "end": 471.98
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 2.36,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.36,
   "end": 6.1,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.1,
   "end": 10.26,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.26,
   "end": 15.1,
   "text": "کلمه بیست و چهار. آن که غذا را مسانخ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.1,
   "end": 17.86,
   "text": "از سنخ میاد هم‌جنسي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.86,
   "end": 23.98,
   "text": "آن که غذا را مسانخ مقتضی نیابد، هرزه‌خوار می‌گردد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.98,
   "end": 29.16,
   "text": "و هرزه‌خوار، هرزه‌گو و هرزه‌کار می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.16,
   "end": 33.56,
   "text": "هم اشاره دارد به اون طعام پاکی که انسان حلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.56,
   "end": 39.28,
   "text": "بخورد که اگر کسی حرام‌کار و هرزه‌کار شد و هرزه‌گو و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.28,
   "end": 47.06,
   "text": "این در خوردنش مشکل پیدا شده، طعام پاک نخورده، طعام حلال نخورده، طعام حرام خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.06,
   "end": 52.36,
   "text": "نشانه‌هاشه. همچنین خب این مربوط به ظاهره، بدن ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.36,
   "end": 57.32,
   "text": "که انزل مراتب نفس ناطقه ماست و جدایی از نفس نیست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.32,
   "end": 63.22,
   "text": "حالات بدن ما در نفس ما تأثیرگذار که اگر کسی مثلاً کمردرد داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.22,
   "end": 65.58,
   "text": "نمی‌تونه درست حسابی فکرش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.58,
   "end": 67.66,
   "text": "متمرکز کنه در توحیدش حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.66,
   "end": 71.56,
   "text": "اینا تأثیرگذارن در هم. همچنین روح اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.56,
   "end": 76.66,
   "text": "ناراحت باشه، مضطرب باشه این‌ها جسم رو اذیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.66,
   "end": 79.6,
   "text": "جسم به اون نشاط خودشون اینا در هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.6,
   "end": 83.0,
   "text": "تأثیرگذارن چون یک حقیقت واحدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.0,
   "end": 84.6,
   "text": "مرتبه انزلش می‌شه بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.6,
   "end": 89.04,
   "text": "حالا این بدن همونطور که طعام داره، غذا داره، غذاهای مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.04,
   "end": 95.28,
   "text": "در قرآن هم زیاد اشاره شده به عنوان نمونه از آیه بیست و هشت تا سی و یک سوره عبس رو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.28,
   "end": 99.9,
   "text": "اشاراتی داره و \"انب و قببا\" انگور و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.9,
   "end": 105.56,
   "text": "سبزی زیاد و \"زیتون و نخلا\" زیتون و نخل فراوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.56,
   "end": 109.48,
   "text": "و \"حدائق غلبا\" باغ‌های پردرخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.48,
   "end": 113.26,
   "text": "و فاکهه و عبا، میوه، چراگاه اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.26,
   "end": 117.72,
   "text": "خدا همین‌طوری که برای در نشئه طبیعت برای بدن ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.72,
   "end": 123.4,
   "text": "ات-- اون اطعمه و اشربه‌های خیلی خوب و پاک و به دردبخور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.4,
   "end": 125.78,
   "text": "نه تفاله باشه اصل باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.78,
   "end": 132.44,
   "text": "این‌ها قرار داده که بین این‌ها باز انسان می‌گرده اون بهترین‌هاشو پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.44,
   "end": 135.86,
   "text": "همچنین برای روح هم غذایی قرار داده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.86,
   "end": 138.08,
   "text": "خدای منان برای روح هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.08,
   "end": 144.24,
   "text": "غذا قرار داده. ما متأسفانه برای بدنمون بهترین غذاها رو صبح تا شب سر کار جون بکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.24,
   "end": 146.22,
   "text": "کسب و تجارت و اینا خیلی هم خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.22,
   "end": 149.48,
   "text": "الكاسب حبیب الله. این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.48,
   "end": 152.44,
   "text": "الكاد للعيال كالمجاهد في سبيل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.44,
   "end": 158.54,
   "text": "این احادیث هم خوب بلدیم. کسی که برای مثلاً امرار معاش زن و بچه‌ش تلاش کنه مجاهده در راه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.54,
   "end": 160.7,
   "text": "پس بریم تلاش کنیم صبح تا شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.7,
   "end": 163.06,
   "text": "برای یه لقمه نون این‌ها. ولی خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.06,
   "end": 165.86,
   "text": "درست هم هست. کسی انکار نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.86,
   "end": 167.9,
   "text": "ضروری هم هست. اما جان چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.9,
   "end": 170.0,
   "text": "نفس چی؟ غذای جانت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.0,
   "end": 175.6,
   "text": "غذای نفست چی؟ اینجا علامه می‌فرماید حواست باشه چی به جانت می‌خورونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.6,
   "end": 181.2,
   "text": "اونچه که به جانت می‌خورونی همون علوم و معارف هست که ببین اینو رو از کجا اخذ می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.2,
   "end": 187.46,
   "text": "مگر در этого من این فرمایش علامه رو دیدم و چیزی که به ذهنم خطور کرد همین دعای بعد از نماز عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.46,
   "end": 190.04,
   "text": "اللهم إني أعوذ بك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.04,
   "end": 192.46,
   "text": "من نفس لا تشبع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.46,
   "end": 196.88,
   "text": "و من قلب لا يخشع، و من علم لا ينفع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.88,
   "end": 200.04,
   "text": "عجب! کأن علم لا ينفع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.04,
   "end": 202.82,
   "text": "اولا وجود داره که امام گفته پناه ببر به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.82,
   "end": 204.9,
   "text": "اللهم إني أعوذ بك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.9,
   "end": 207.08,
   "text": "به تو پناه می‌برم. از چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.08,
   "end": 209.36,
   "text": "از این‌ها. که یکیش علم لا ينفع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.36,
   "end": 212.72,
   "text": "پس علم بدون منفعت وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 212.72,
   "end": 215.36,
   "text": "که حالا شاید اون نفس لا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.36,
   "end": 219.26,
   "text": "اون نفسی که من نفس لا تشبع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.26,
   "end": 221.5,
   "text": "نفسی که پر-- یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 221.5,
   "end": 228.66,
   "text": "سیر نمی‌شه. قلب لا يخشع قلبی که خاشع نمی‌شه علتش این علم لا ينفع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.66,
   "end": 233.96,
   "text": "علم به دردبخور نیست. یعنی غذای جانش غذای درستی نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.96,
   "end": 236.64,
   "text": "یادمه اون موقع که اون پایین نماز می‌خوندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.64,
   "end": 239.76,
   "text": "زهرا محرم یکی دو سال پیش بود خیلی باصفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.76,
   "end": 244.34,
   "text": "اونجا یه حدیثی رو ذیل آیه \"فلينظر الإنسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.34,
   "end": 246.42,
   "text": "إلى طعامه أحسن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 246.42,
   "end": 251.32,
   "text": "اونجا فکر می‌کنم آیه بیست و چهار سوره عبس باشه اگه اشتباه نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 251.32,
   "end": 256.0,
   "text": "\"فلينظر الإنسان\". باید انسان توجه کنه إلى طعامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.0,
   "end": 259.6,
   "text": "به اونچه که می‌خوره. بعد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.6,
   "end": 262.52,
   "text": "از حضرت امام صادق صلوات الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.52,
   "end": 264.78,
   "text": "این در تفسیر برهان هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 264.78,
   "end": 269.64,
   "text": "پرسید آقا جون، زید پرسید از امام صادق آقا این چه طعامیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.64,
   "end": 272.76,
   "text": "که باید انسان بهش نگاه کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.76,
   "end": 277.3,
   "text": "بعد حضرت فرمودن در جواب این سؤال خدا خیر بده به امثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.3,
   "end": 279.94,
   "text": "زید شهام‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 279.94,
   "end": 282.28,
   "text": "که باعث شدن ما به این جواب‌ها برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 282.28,
   "end": 285.72,
   "text": "و الا اینا سؤال نمی‌پرسیدن کی برا ما مکشوف می‌شد این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 285.72,
   "end": 291.46,
   "text": "امام صادق فرمودن علمه الذي يأخذه عما يأخذه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.46,
   "end": 295.14,
   "text": "باید انسان یعنی اون آیه اشاره داره به علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 295.14,
   "end": 298.44,
   "text": "\"فلينظر الإنسان إلى طعامه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 298.44,
   "end": 302.8,
   "text": "انسان از حیث انسانیتش باید نگاه کنه غذای جانش چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.8,
   "end": 305.62,
   "text": "اینجا حالا اونو می‌زنیم به، به غذای ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 305.62,
   "end": 308.08,
   "text": "بله ببینیم چی داریم می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.08,
   "end": 310.46,
   "text": "توجه کرد به جای چیپس و پفک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.46,
   "end": 314.1,
   "text": "نمی‌دونم پفیلو و غذاهای پفیلایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.1,
   "end": 317.7,
   "text": "فست‌فود این‌ها مثلا عسل بخوریم، غذاهای خوب اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.7,
   "end": 320.6,
   "text": "همینو نگاه می‌کنیم. اما امام می‌گه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 320.6,
   "end": 326.56,
   "text": "تأویل آیه رو هم نگاه کن. تأویل آیه اینه که علمت رو از کجا داری اخذ می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 326.56,
   "end": 329.96,
   "text": "سرچشمه و منبع علمت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 329.96,
   "end": 333.26,
   "text": "یا وقتی بزرگ ما مثلا ما از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 333.26,
   "end": 338.92,
   "text": "مثلا من به عنوان یه آخوند می‌شینم رو منبر مثلا اصلا از امام ریاض نکنم مثلا خیلی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.92,
   "end": 341.88,
   "text": "همه ما سر سفره امام و انقلاب و شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.88,
   "end": 345.12,
   "text": "اما در حینی که دم از امام و شهدا می‌زنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.12,
   "end": 347.34,
   "text": "تا اسم شیخ الرئیس میاد حالم بد شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 347.34,
   "end": 349.22,
   "text": "اسم ملا صدرا میاد حالم بد شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 349.22,
   "end": 352.64,
   "text": "اسم ابن عربی میاد، علامه حسن زاده پس بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 352.64,
   "end": 354.82,
   "text": "خب این چه انقلابی‌گریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 354.82,
   "end": 359.46,
   "text": "تو داری اون اصل علم رو، اصل علم پرمنفعت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 359.46,
   "end": 364.08,
   "text": "پس می‌زنی که امام، اندیشمندان شرق و غرب عالم رو دعوت کرد سر این سفره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 364.08,
   "end": 366.92,
   "text": "بعد من و تو که دم می‌زنیم از انقلاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 366.92,
   "end": 370.5,
   "text": "امام و شهدا و بسیج و این حرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 370.5,
   "end": 374.26,
   "text": "تا حرف فلسفه و حکمت و عرفان و اون کتاب‌هایی که اس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 374.26,
   "end": 376.92,
   "text": "صاحبان کتاب‌هایی که اسبردیم همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 376.92,
   "end": 378.76,
   "text": "مادر و خدای این علم‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 378.76,
   "end": 381.36,
   "text": "العیاذ بالله حالا به تمثل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 381.36,
   "end": 384.2,
   "text": "به تمثیل عرض می‌کنیم. بعد مثلا پس بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 384.2,
   "end": 386.62,
   "text": "خب چه بسیجی، چه هیئتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 386.62,
   "end": 392.54,
   "text": "که حکمت و عرفان رو پس می‌زنیم فقط به ظاهر و بدن آیات و روایات توجه می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 392.54,
   "end": 394.22,
   "text": "میگه به باطن آیه هم دقت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 394.22,
   "end": 396.8,
   "text": "مثل اینجا که امام صادق صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 396.8,
   "end": 399.48,
   "text": "ما رو توجه دادن به این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 399.48,
   "end": 403.18,
   "text": "پس توجه داشته باشیم اینکه علممون رو از کجا اخذ می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 403.18,
   "end": 405.94,
   "text": "هرچی علم پاک‌تر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 405.94,
   "end": 413.14,
   "text": "زلال‌تر، عالی‌تر، من و شما جانمون متعالی‌تر می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 413.14,
   "end": 417.08,
   "text": "و اون شا-- انشاالله به اون اعلا علیین دست پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 417.08,
   "end": 422.74,
   "text": "لذا حالا این جمله هم براتون بخونم اگر که چه بحثو جمع کردم اما حیفه در رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 422.74,
   "end": 427.54,
   "text": "عنه الحق ببینید این جمله آخر رو از علامه ببینید نوشتم براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 427.54,
   "end": 430.14,
   "text": "علامه می‌فرماید انسان اینو گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 430.14,
   "end": 433.74,
   "text": "\"انسان از آن حیث که انسان است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 433.74,
   "end": 437.78,
   "text": "خوراک او علم نافع و عمل صالح است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 437.78,
   "end": 443.9,
   "text": "و هرکس به صورت علم و عمل خود در نشئات اخروی برانگیخته می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 443.9,
   "end": 447.98,
   "text": "چه اینکه روح غیر از بدن عنصری محسوس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 447.98,
   "end": 457.66,
   "text": "و او را بدن‌های در طول هم به وفق نشئات اخرویست و تفاوت ابدان\"، یعنی بدن‌ها، \"و نشئات به نقص و کمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 457.66,
   "end": 460.74,
   "text": "است.\" یعنی ما الان داریم همونطور که قبلاً عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 460.74,
   "end": 466.18,
   "text": "هم بدن برزخیمونو می‌سازیم هم نفس برزخیمونو با علم و عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 466.18,
   "end": 470.2,
   "text": "انشاالله عاقبت به بخیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 470.2,
   "end": 471.98,
   "text": "سلام الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}