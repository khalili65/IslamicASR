 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ نوزدهم: وادی «من کیستم»",
   "start": 12.12,
   "end": 120.08
  },
  {
   "index": 1,
   "title": "## اعجوبهٔ کون در رسالهٔ «النهضه الحق»",
   "start": 120.08,
   "end": 213.68
  },
  {
   "index": 2,
   "title": "## رستخیز و راست‌خیز",
   "start": 213.68,
   "end": 292.0
  },
  {
   "index": 3,
   "title": "## بخل نسبت به عمر و کار علمی",
   "start": 292.0,
   "end": 360.06
  },
  {
   "index": 4,
   "title": "## حدیث امام صادق دربارهٔ عمر",
   "start": 360.06,
   "end": 458.1
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.3,
   "end": 5.14,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.14,
   "end": 9.5,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.5,
   "end": 12.12,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.12,
   "end": 20.9,
   "text": "ثواب این معارف امروز رو هدیه می‌کنیم به همه عزیزانی که در شکل‌گیری این نهضت و این انقلاب سهم داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.9,
   "end": 23.8,
   "text": "خصوصا امام عزیز و شهدای عزیزمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.8,
   "end": 27.5,
   "text": "روح همشون شاد. کلمه نوزدهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.5,
   "end": 30.92,
   "text": "آن که در وادی مقدس من کیستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.92,
   "end": 33.16,
   "text": "قدم ننهاده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.16,
   "end": 37.34,
   "text": "خرواری به خردلی. خب این محکه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.34,
   "end": 42.32,
   "text": "کیا در وادی من کیستم قدم گذاشتن، خودشونو شناختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.32,
   "end": 44.84,
   "text": "و تلاش کردن در این حیث و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.84,
   "end": 49.3,
   "text": "اون‌ها هم که نکردن. میگه اون‌هایی که نکردن باختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.3,
   "end": 51.34,
   "text": "این کنایه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.34,
   "end": 53.16,
   "text": "میگه خرواری به خردلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.16,
   "end": 58.5,
   "text": "انگار مثلا شما یه دانه خردلی رو بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.5,
   "end": 62.72,
   "text": "یا مثلا خرواری رو بدی یه دانه خرده‌بگیری تو معامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.72,
   "end": 65.68,
   "text": "انقدر ضرر می‌کنی، انقدر ضرر می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.68,
   "end": 67.52,
   "text": "در پس چی انقدر ضرر می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.52,
   "end": 70.46,
   "text": "اینکه معرفت نفس نداری، خودتو نشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.46,
   "end": 75.4,
   "text": "وقتی قرآن خدا در قرآن به نفس قسم یاد کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.4,
   "end": 77.84,
   "text": "\"ونفس وما سواها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 77.84,
   "end": 84.28,
   "text": "اول به نفس قسم خورده اینجا بعد به خودش که نفس رو در بهترین و نیکوترین شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.28,
   "end": 87.06,
   "text": "آراسته. \"وما سواها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.06,
   "end": 89.94,
   "text": "اون خودشه. اما اول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.94,
   "end": 93.62,
   "text": "اول به نفس قسم می‌خوره \"ونفس وما سواها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 93.62,
   "end": 96.2,
   "text": "\"فألهمها فجورها وتقواها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 96.2,
   "end": 99.34,
   "text": "اگه کسی سر در گریبان خودش فرو ببره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 99.34,
   "end": 102.54,
   "text": "ملهم شده هم به تقوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 102.54,
   "end": 105.3,
   "text": "هم به فجور. هر دو تاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 105.3,
   "end": 110.56,
   "text": "یعنی در درون قشنگ داره در درون خودش، خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 110.56,
   "end": 113.62,
   "text": "پیدا می‌کنه. راه رو از چاه پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 113.62,
   "end": 117.16,
   "text": "اشکال اصلی ما اینه که به خودمون اصلا توجه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 117.16,
   "end": 120.08,
   "text": "همش به بیرون از خودمون، پیرامون خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 120.08,
   "end": 124.24,
   "text": "در رساله النهض الحق صفحه صد و پنجاه و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 124.24,
   "end": 131.02,
   "text": "ببینید علامه چی می‌فرماید. این اعجوبه کون شما رو داره میگه ها شما حضرت عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 131.02,
   "end": 135.08,
   "text": "حضرت عالیای خواهرها. علامه داره به شما میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 135.08,
   "end": 140.84,
   "text": "می‌فرماید این اعجوبه کون خودت رو تا حالا به اعجوبه دیده بودی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 140.84,
   "end": 143.6,
   "text": "یعنی عجیب‌ترین وجه خلقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 143.6,
   "end": 147.82,
   "text": "این اعجوبه کون که حالا کون رو هم که قبلا گفتیم یعنی چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 147.82,
   "end": 152.08,
   "text": "از حیث فلسفه میشه مادون فلک قمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 152.08,
   "end": 154.48,
   "text": "از حیث عرفان، نگاه عرفان اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 154.48,
   "end": 157.0,
   "text": "ما سوی الله میشه کون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 157.0,
   "end": 160.2,
   "text": "اکوان. حالا میگه بین همه این اکوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 160.2,
   "end": 163.84,
   "text": "انسان از همشون اعجوبه تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 163.84,
   "end": 167.92,
   "text": "معجونی شگفت است که همه اسباب کار در وی جمع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.92,
   "end": 170.86,
   "text": "آقا به هر کجا می‌خوای برسی تو خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 170.86,
   "end": 175.34,
   "text": "میگه اسباب کار همه در خودت جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 175.34,
   "end": 181.36,
   "text": "دو مرتبه در همین رساله النهض الحق علامه می‌فرماید هیچ معرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 181.36,
   "end": 184.76,
   "text": "چون معرفت نفس به کار انسان نمی‌آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 184.76,
   "end": 188.62,
   "text": "دنبال چی می‌گردیم ما؟ چقدر باید بگیم ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 188.62,
   "end": 198.44,
   "text": "هیچ معرفتی چون معرفت نفس به کار انسان نمی‌آید و سرمایه همه سعادت‌ها این معرفت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.44,
   "end": 204.78,
   "text": "و آن که خود را نشناخت عاتل و باطل زیست و گوهر ذاتش را تباه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.78,
   "end": 207.76,
   "text": "و برای همیشه بی‌بهره ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 207.76,
   "end": 210.46,
   "text": "خودش رو نشناخت لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 210.46,
   "end": 213.32,
   "text": "رستخیز زندگی نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.32,
   "end": 216.7,
   "text": "حالا در دروس در مومد الهمم علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.7,
   "end": 219.56,
   "text": "بحث شیرینی رو اونجا دارن. پیرامون همین کلمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 219.56,
   "end": 223.36,
   "text": "حالا بین ما معروف شده، متداول شده میگیم رستاخیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.36,
   "end": 225.52,
   "text": "اصلش رستخیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 225.52,
   "end": 228.5,
   "text": "راست‌خیز بوده، مخفف شده رستخیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 228.5,
   "end": 232.76,
   "text": "علامه می‌فرماید اکثر مردم راست‌خیز نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 232.76,
   "end": 234.54,
   "text": "یعنی افقی حرکت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 234.54,
   "end": 237.42,
   "text": "یعنی معذرت می‌خوام مثل حیوان زندگی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 237.42,
   "end": 240.88,
   "text": "\"أولئک کالأنعام\" قرآن میگه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 240.88,
   "end": 244.1,
   "text": "راست‌خیز نیستن یعنی سرشون به سمت آسمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 244.1,
   "end": 248.1,
   "text": "افقی زندگی می‌کنن مثل معذرت می‌خوام بهایم و انسان‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 248.1,
   "end": 250.64,
   "text": "از خودشون و درون خودشون غافلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 250.64,
   "end": 255.18,
   "text": "بعد علامه می‌فرماید کی راست‌خیز یا رستخیز میشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 255.18,
   "end": 256.88,
   "text": "میان میگن روز رستاخیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 256.88,
   "end": 261.8,
   "text": "میگه چرا منتظر اون موقعی؟ چرا منتظر اون موقعی که بلاجبار و به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 261.8,
   "end": 268.08,
   "text": "موت اجباری راستت کنن متوجه ملکوت عالم بشی و به قول ماها اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 268.08,
   "end": 273.4,
   "text": "کوب کنی و زلزله وجودی بگیرد که \"إذا زلزلت الأرض زلزالها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 273.4,
   "end": 276.32,
   "text": "که دچار هیمان و حیرت بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 276.32,
   "end": 279.5,
   "text": "از همین جا، از همین جا رستخیز باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 279.5,
   "end": 282.26,
   "text": "راست‌خیز باش. سرتو به آسمان بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 282.26,
   "end": 284.06,
   "text": "مثل حیوان زندگی نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 284.06,
   "end": 286.4,
   "text": "انسان زندگی کن. چرا گناه می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 286.4,
   "end": 289.92,
   "text": "چرا با گناه دامن خودتو آلوده می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 289.92,
   "end": 294.7,
   "text": "اتفاقا خدا رحمت کنه آقای صافی رو متأسفانه از بین همین مذهبی‌ها هم می‌شنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 294.7,
   "end": 297.84,
   "text": "هروکر و خنده و شوخی البته اما زشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 297.84,
   "end": 300.1,
   "text": "این آقا چیکار کرده صد و سه آخه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 300.1,
   "end": 302.68,
   "text": "بخل نسبت به عمر انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 302.68,
   "end": 308.72,
   "text": "مگه این چیکار کرده؟ اگر مثل ما مثلا شب و روز میومد سر کار صد و یک، صد و سه سال عمر نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 308.72,
   "end": 317.34,
   "text": "یه حرف‌های عجیب و غریبی. مگه کار کردن فقط همین اومدن و رفتن سر اداره و تو زمین و تو کشت‌زار و این‌هاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 317.34,
   "end": 321.82,
   "text": "اونم کار علمیه و اونم کار فکریه که سخت‌ترین کارها کار عقلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 321.82,
   "end": 325.06,
   "text": "کار فکریه. چطور یه آدم تاجر باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.06,
   "end": 332.36,
   "text": "شب و روز مراقب تجارتش باشه، نوسانات دلار و بورس باشه که ضرر نکنه، آدم موفقی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 332.36,
   "end": 334.72,
   "text": "بعد یه آدم محقق و عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 334.72,
   "end": 338.68,
   "text": "همین طوری مثل من و شما روزی دو خط کتاب بخونه باید عالم بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 338.68,
   "end": 342.88,
   "text": "شب و روز باید ت-ت درس بخونه، تلاش علمی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 342.88,
   "end": 348.32,
   "text": "علامه حسن زاده اواخر عمرش من با دامادشون صحبت می‌کردم می‌فرمود همین اواخر که حالش بد بود هجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.32,
   "end": 350.56,
   "text": "ساعت کار علمی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.56,
   "end": 354.38,
   "text": "خب اینم کار، پس اشرف کار همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 354.38,
   "end": 358.06,
   "text": "بعد ما بگیم مثلا چرا این آقا صد و پ-- صد و سه سال عمر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 358.06,
   "end": 364.12,
   "text": "بخل نسبت به عمر. عزیزم امام صادق فرمود این حدیث رو گوش بدید و بسه بالا برادر امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 364.12,
   "end": 367.06,
   "text": "امام صادق صلوات الله علیه فرمود نهیب عجیبیه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 367.06,
   "end": 370.48,
   "text": "خوب اینو توجه کنید و بسه. همین حدیث برای ما بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 370.48,
   "end": 373.14,
   "text": "فرمودن امام صادق صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 373.14,
   "end": 378.54,
   "text": "من امروز مخصوصا متن حدیث رو دیدم که باز اشتباه نگم چون خیلی سال‌های پیش دیده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.54,
   "end": 381.66,
   "text": "فرمود تعداد آدم‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 381.66,
   "end": 385.58,
   "text": "بر اثر طبیعی از دنیا میرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 385.58,
   "end": 390.66,
   "text": "مثلا عمرشون کمه، طبیعتاً عمرشون کمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 390.66,
   "end": 395.16,
   "text": "تعدادشون کمتر از آدماییه که بر اثر گناه می‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 395.16,
   "end": 397.18,
   "text": "یعنی گناه عمر رو کم می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.18,
   "end": 399.98,
   "text": "و تعداد آدم‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 399.98,
   "end": 403.54,
   "text": "به صورت طبیعی طول عمر دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 403.54,
   "end": 408.8,
   "text": "کمتر از آدماییه که به جهت اطاعت الهی طول عمر پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 408.8,
   "end": 413.08,
   "text": "شما ببین اکثر ارمها و مراجع بزرگان ما طول عمر دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 413.08,
   "end": 416.24,
   "text": "تو بخل داری نسبت به عمر شریف این‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 416.24,
   "end": 421.44,
   "text": "شما هم بفرمایید در خدمت دین و اسلام و مردم و خدمت به مردم باشید ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 421.44,
   "end": 424.4,
   "text": "چه خدمت‌هایی آقای صافی کرده به مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 424.4,
   "end": 428.48,
   "text": "چه خدماتی کرده اصلا نمیشه بنویسی این‌ها رو تو این عمر پربرکتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 428.48,
   "end": 431.08,
   "text": "خب بله مردم رو خدا هم نگهش می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.08,
   "end": 434.96,
   "text": "ولی من و شما معذرت می‌خوام به قول علامه عذرخواهی می‌کنم از شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 434.96,
   "end": 438.2,
   "text": "خودم رو میگم فقط شکمم رو پر می‌کنم، خالی می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 438.2,
   "end": 440.48,
   "text": "توقع دارم که مثلا ما هم طول عمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 440.48,
   "end": 443.2,
   "text": "نمیشه که. برکت یه چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 443.2,
   "end": 447.08,
   "text": "هیچ‌وقت بخل نورزیم به اینکه دیگه کسی خدا به کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 447.08,
   "end": 450.82,
   "text": "مرحمت کرده. انشاالله عاقبتمون ختم به خیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 450.82,
   "end": 453.88,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 453.88,
   "end": 458.1,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}