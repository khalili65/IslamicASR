 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین.",
   "start": 14.88,
   "end": 122.98
  },
  {
   "index": 1,
   "title": "## کلمهٔ بیست و ششم؛ من عرف نفسه فقد عرف ربّه",
   "start": 122.98,
   "end": 218.82
  },
  {
   "index": 2,
   "title": "## اعجوبهٔ کون؛ همهٔ اسباب در انسان",
   "start": 218.82,
   "end": 314.18
  },
  {
   "index": 3,
   "title": "## کانالِ وجودی؛ اسمِ اعظم و ربّ",
   "start": 314.18,
   "end": 385.95
  },
  {
   "index": 4,
   "title": "آن دریایِ لایتناهی را ربِّ پیامبر بگیر:",
   "start": 385.95,
   "end": 406.39
  },
  {
   "index": 5,
   "title": "نکته‌ای بسیار شریف: در تفسیرِ علی بن ابراهیم قمّی، حدیثی از امام باقر علیه‌السلام آمده دربارهٔ آیه:",
   "start": 406.39,
   "end": 515.49
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.2,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.2,
   "end": 6.42,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.42,
   "end": 8.36,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.36,
   "end": 11.16,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.16,
   "end": 14.62,
   "text": "شاید یکی از وجوهی که ما قبل از این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 14.62,
   "end": 22.52,
   "text": "اون سلام واجب نماز که سلام آخر است رو بگیم که السلام علیکم و رحمة الله و برکاته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.52,
   "end": 32.38,
   "text": "به همه عوالم هستی، همه جزئ جزئ و کل نظام هستی من جمله پیغمبر عزیز عالم، امام عصرمون، ائمه و اولیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.38,
   "end": 40.76,
   "text": "به قول حضرت علامه حائری یزدی علیه الرحمه حتی انبیاء دوره‌های قبل و دوره‌های بعد که قراره بیان سلام میدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.76,
   "end": 49.58,
   "text": "و در پس یه همچین سلامی همه عالم هستی دست به دست هم میدن که تو رو به سلامت بذارن که این بحثش قبلاً گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 49.58,
   "end": 56.6,
   "text": "شاید یه وجه این که قبل از این سلام واجب نماز مستحبه بگیم السلام علینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 56.6,
   "end": 60.86,
   "text": "و على عباد الله الصالحین ما به خودمون سلام میدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 60.86,
   "end": 63.66,
   "text": "شاید یه وجهش در این باشه. من خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.66,
   "end": 68.98,
   "text": "این برداشت خودمه شاید شما بگید اشتباس اما شاید یه وجهش این باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.98,
   "end": 71.94,
   "text": "که هرچه اتفاق میفته از درون ما میفته؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.94,
   "end": 76.42,
   "text": "یعنی ما از درون خودمون مرتبط می‌شیم با عالم بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.42,
   "end": 80.82,
   "text": "که اگر کسی این ارتباط درونی خودش، نفس خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.82,
   "end": 83.92,
   "text": "اون رب وجودیش، ربش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.92,
   "end": 86.78,
   "text": "که قراره او رو ملاقات کنه حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.78,
   "end": 90.12,
   "text": "حقیقت موت می‌شه ملاقات رب خودت؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.12,
   "end": 96.1,
   "text": "یعنی اون اسمی که منتشر شده از حضرت حق و تو رو ارتباط می‌ده با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.1,
   "end": 99.6,
   "text": "الله. اون اسم رب توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.6,
   "end": 103.2,
   "text": "ربی الاعلی، ربی العظیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.2,
   "end": 111.08,
   "text": "و به همده این‌ها شاید یه وجهش این باشه که از هرچه اتفاق میفته از درون خودت و اون رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 111.08,
   "end": 115.84,
   "text": "نفس خودته. اینو مقدمه کردم برای شاید اولین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 115.84,
   "end": 122.98,
   "text": "ااا جمله ایست از این صد کلمه که من براش مقدمه چیدم که بهتر متوجه بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.98,
   "end": 130.42,
   "text": "کلمه بیست و ششم. آن که من عرف نفسه فقط عرف ربه را درست فهم کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 130.42,
   "end": 132.2,
   "text": "من عرف نفسه فقط عرف ربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 132.2,
   "end": 137.86,
   "text": "هر کس به تحقیق نفسش رو شناخت، پروردگارش رو شناخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 137.86,
   "end": 145.86,
   "text": "می‌فرماید آن که این رو درست فهم کند جمیع مسائل اصیل فلسفی، اینو دقت کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 145.86,
   "end": 154.08,
   "text": "جمع میاره. جمیع مسائل اصیل فلسفی و مطالب قویم حکمت متعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 154.08,
   "end": 159.3,
   "text": "و حقایق متین عرفانی را از آن استنباط تواند کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 159.3,
   "end": 163.38,
   "text": "عجب! یعنی حکمت، عرفان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 163.38,
   "end": 167.08,
   "text": "فلسفه، اون اصلش، اساسش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 167.08,
   "end": 171.16,
   "text": "قوامش. اینا همه بسته به فهم این جمله داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 171.16,
   "end": 176.66,
   "text": "لذا معرفت نفس را مفتاح خزائن ملکوت فرمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 176.66,
   "end": 180.16,
   "text": "مفتاح خزائن ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 180.16,
   "end": 182.5,
   "text": "کلید خزینه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 182.5,
   "end": 187.82,
   "text": "عالم الوهی. پس برهان شرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 187.82,
   "end": 192.82,
   "text": "این گونه، این گوهر یگانه، برهان شرف این گوهر یگانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 192.82,
   "end": 195.14,
   "text": "این گوهر یگانه منظور چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 195.14,
   "end": 199.38,
   "text": "نفس انسانی. اعنی جوهر نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 199.38,
   "end": 202.74,
   "text": "همین معثور شریف من عرف بس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 202.74,
   "end": 207.22,
   "text": "میگه برای اینکه عظمت این نفست رو بشناسی همین یک حدیث که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 207.22,
   "end": 215.48,
   "text": "معجزه قولی امیرالمؤمنین و قبلاً عرض شد تمام قرآن و روایات رو اگر مندمش کنی در یک جمله همینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 215.48,
   "end": 218.64,
   "text": "بسه. چه کرده مولامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 218.64,
   "end": 220.98,
   "text": "حالا در رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 220.98,
   "end": 225.02,
   "text": "شریف انه الحق صفحه صد و پنجاه و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 225.02,
   "end": 229.32,
   "text": "حضرت علامه می‌فرمایند این اعجوبه کون یعنی شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 229.32,
   "end": 231.88,
   "text": "یعنی انسان که قبلاً عرض شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 231.88,
   "end": 236.94,
   "text": "در فلسفه مادون ف-فلک قمر رو میگن اکوان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 236.94,
   "end": 240.86,
   "text": "کون، هرچی که هست کون، اکوانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 240.86,
   "end": 247.2,
   "text": "در عرفان ماسوی الله رو میگن اکوان که یکیش می‌شه انسان، کون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 247.2,
   "end": 249.06,
   "text": "که انسان کامله می‌شه کون جامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 249.06,
   "end": 255.62,
   "text": "حالا ایشون علامه فرمود این اعجوبه کون یعنی بین همه موجودات شما اعجوبه ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 255.62,
   "end": 258.96,
   "text": "می‌خواد بگه تو کی هستی علامه ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 258.96,
   "end": 261.86,
   "text": "معجونی شگفت است که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 261.86,
   "end": 264.84,
   "text": "اسباب کار در وی جمع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 264.84,
   "end": 267.28,
   "text": "همه اسباب کار در وی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 267.28,
   "end": 271.82,
   "text": "جمع است. میگه سال‌ها دل طلب جام جم از مامی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 271.82,
   "end": 275.4,
   "text": "آنکه خود داشت ز بیگانه تمنا می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 275.4,
   "end": 278.48,
   "text": "هرچه که هست در وجود خود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 278.48,
   "end": 281.84,
   "text": "هرچه هست در ما تعبیه شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 281.84,
   "end": 284.64,
   "text": "اصلاً قرآن در ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 284.64,
   "end": 290.02,
   "text": "به یک معنا قبلاً عرض شد که یک شکل قرآن، قرآن انفسیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 290.02,
   "end": 294.42,
   "text": "در وجود ماست و هر اتفاقی هم میفته در درون انسان‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 294.42,
   "end": 297.7,
   "text": "شما هرچی کلاس درس و بحث و فلسفه و عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 297.7,
   "end": 302.84,
   "text": "و اینا معدات که تو رو آماده می‌کنند بری، اتفاق نهایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 302.84,
   "end": 306.8,
   "text": "اون انفجار اصلی تو وجود خودت رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 306.8,
   "end": 310.0,
   "text": "اون دروازه‌ها باز می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 310.0,
   "end": 316.14,
   "text": "دریچه‌ها باز می‌شه، ارتباط کانال وجودی تو با اون دریای لایتناهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 316.14,
   "end": 321.78,
   "text": "برقرار می‌شه. اون کانال وجودی تو که ارتباط می‌گیره با اون دریای لایتناهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 321.78,
   "end": 325.04,
   "text": "حق، اون، اون کاناله چیه اسمش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 325.04,
   "end": 327.1,
   "text": "اون اسم اعظم وجودی توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 327.1,
   "end": 330.76,
   "text": "حصه وجودی توئه. سر وجودی توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 330.76,
   "end": 333.44,
   "text": "همون اسمیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 333.44,
   "end": 336.3,
   "text": "در تو پیاده شده از حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 336.3,
   "end": 341.68,
   "text": "اسم اعظم توست که اون قراره مرتبط بشه با اون دریای لایتناهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 341.68,
   "end": 346.6,
   "text": "اون رب توئه. اون اسمی که مرتبط شده با الله تو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.6,
   "end": 349.02,
   "text": "برقرار کرده، اون رب توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 349.02,
   "end": 352.54,
   "text": "حالا میگه خودت رو شناختی، اون رب رو شناختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 352.54,
   "end": 355.56,
   "text": "چون مطابق با خودت، اون رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 355.56,
   "end": 358.08,
   "text": "ارتباط گرفته با اون دریا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 358.08,
   "end": 362.1,
   "text": "بعد علامه تو اون یکی اون از، از اون اصول می‌فرماید باید این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 362.1,
   "end": 365.57,
   "text": "کانال رو همین اسم رو لای رو بی کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 365.57,
   "end": 369.41,
   "text": "از آلودگی‌ها. بعد ببینید چجوری ارتباط می‌گیری با دریا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 369.41,
   "end": 375.17,
   "text": "دیگه قطره وقتی وقت وصل به دریا شد دریاست دیگه همه اینو می‌پذیری دریاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 375.17,
   "end": 378.73,
   "text": "بعد اون دریای لاتناهی، لایتناهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 378.73,
   "end": 380.99,
   "text": "رب پیغمبر بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 380.99,
   "end": 385.67,
   "text": "رب پیغمبر که و ان الی ربک المنتهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 385.67,
   "end": 388.67,
   "text": "اون انتها رب تو واقع شده پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 388.67,
   "end": 390.59,
   "text": "همه میرن به سمت رب پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.59,
   "end": 393.93,
   "text": "اون اسمی که از پیغمبر با حضرت حق بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 393.93,
   "end": 401.25,
   "text": "حالا یه نکته‌ای هم بگم خیلی شریف، خیلی این خودش باور کنید منبر مستقل عالی می‌طلبه فقط روش فکر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 401.25,
   "end": 406.39,
   "text": "در تفسیر، کتاب تفسیر اهل بیت علی ابن ابراهیم قمی صفحه دویست و چهارده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 406.39,
   "end": 410.55,
   "text": "جلد هجده البته. اونجا یه حدیث خیلی قشنگی از امام باقر میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 410.55,
   "end": 417.89,
   "text": "خیلی شیرینه این حدیث. این \"لقد خلقنا الانسان في احسن تقويم\" رو کی خدا فرموده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 417.89,
   "end": 422.75,
   "text": "آیسا به تحقیق خدا انسان را در احسن تقويم آفریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 422.75,
   "end": 425.75,
   "text": "همه ما ذهنمون میره به سمت این خلقت ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 425.75,
   "end": 430.29,
   "text": "بله اینم حقه. خلقت ظاهری ما احسن تقویمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 430.29,
   "end": 432.53,
   "text": "فتبرك الله احسن الخالقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 432.53,
   "end": 436.73,
   "text": "اما این \"ولقد خلقنا الانسان في احسن تقويم\" رو کی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 436.73,
   "end": 445.61,
   "text": "این آیه رو فرموده؟ اون لحظه‌ای که از انسان در عالم زر نسبت به نبوت انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 445.61,
   "end": 449.49,
   "text": "و ولایت اولیا عهد گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 449.49,
   "end": 454.37,
   "text": "اون لحظه این آیه رو گفت \"ولقد خلقنا الانسان في احسن تقويم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 454.37,
   "end": 457.89,
   "text": "یعنی چی؟ یعنی این احسن بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 457.89,
   "end": 466.05,
   "text": "تقويم انسان بر می‌گرده به باخبر شدنش از مقام رسالت و نبوت که نبوت هم از نبی میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 466.05,
   "end": 468.25,
   "text": "نابه، نابه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 468.25,
   "end": 471.77,
   "text": "نبی یعنی باخبر به شدت باخبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 471.77,
   "end": 479.13,
   "text": "نبه، خبر. مقام وجودی تو نفس ناطقه تو وقتی خبر از عالم گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 479.13,
   "end": 483.35,
   "text": "\"ولقد خلقنا الانسان في احسن تقويم\" باخبر میشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 483.35,
   "end": 485.81,
   "text": "تو در احسن تقويم هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 485.81,
   "end": 489.83,
   "text": "یعنی هرچی که خبر در عالم هست در درون خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 489.83,
   "end": 492.77,
   "text": "باید به نحو مکاشفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 492.77,
   "end": 499.07,
   "text": "از مکاشفات suriye و ارضیه بگیر تا سماییه که حداقلش در خواب پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 499.07,
   "end": 505.73,
   "text": "بعد تمثلات انسان رو رشد می‌ده بری برسی به اونجا و راهش بازه برای همه ما با ترک گناه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 505.73,
   "end": 510.71,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 510.71,
   "end": 515.49,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}