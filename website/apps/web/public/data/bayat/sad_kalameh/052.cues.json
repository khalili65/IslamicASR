 "chapters": [
  {
   "index": 0,
   "title": "## نیت امام جماعت",
   "start": 15.18,
   "end": 56.58
  },
  {
   "index": 1,
   "title": "## کلمهٔ پنجاه‌ویکم؛ دو غذا و دو دهان",
   "start": 56.58,
   "end": 166.16
  },
  {
   "index": 2,
   "title": "## آب مظهر حیات و علم",
   "start": 166.16,
   "end": 356.12
  },
  {
   "index": 3,
   "title": "## طعام جسم و طعام علم",
   "start": 356.12,
   "end": 466.55
  },
  {
   "index": 4,
   "title": "## اسم قیوم و هم‌سنخی غذا",
   "start": 466.55,
   "end": 608.31
  },
  {
   "index": 5,
   "title": "## حب بقا در فطرت کودک",
   "start": 608.31,
   "end": 707.63
  },
  {
   "index": 6,
   "title": "## مثال فارابی؛ از قطره تا فوق عرش",
   "start": 707.63,
   "end": 802.01
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.78,
   "end": 6.34,
   "text": "بسم الله الرحمن الرحیم و به نستقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.34,
   "end": 11.7,
   "text": "السلام علیک یا دای الله و ربانی یا آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.7,
   "end": 15.18,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.18,
   "end": 17.8,
   "text": "امام جماعت می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.8,
   "end": 21.4,
   "text": "هم نیت فرادا بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.4,
   "end": 23.82,
   "text": "یعنی نماز فرادا بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.82,
   "end": 28.6,
   "text": "هم می‌تونه نماز نیت جماعت کنه و جلو وایسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.6,
   "end": 32.6,
   "text": "اگر امام جماعت نیت فرادا بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.6,
   "end": 36.34,
   "text": "ثواب نماز جماعت رو به خودش نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.34,
   "end": 44.92,
   "text": "پس بهتره که اگرچه داره جماعت می‌خونه \"اما انما الاعمال بالنیات\" نیتی جماعت کنه و وایسه جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.92,
   "end": 47.06,
   "text": "برای مأموم هم فرقی نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.06,
   "end": 49.78,
   "text": "مأموم چه امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.78,
   "end": 56.58,
   "text": "نیت فرادا بکنه نماز بخونه چه جماعت، مأموم ثواب جماعت رو خواهد برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.58,
   "end": 59.72,
   "text": "کلمه پنجاه و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.72,
   "end": 63.14,
   "text": "آن که در رشد خود دقت کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.14,
   "end": 67.72,
   "text": "می‌بیند که او را دو گونه غذا باید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.72,
   "end": 71.78,
   "text": "غذایی که مایه پرورش تن اوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.78,
   "end": 76.32,
   "text": "و غذایی که مایه پرورش روان اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.32,
   "end": 82.06,
   "text": "یعنی دو گونه غذا هست. یک غذا هست که تن ما رو پرورش می‌ده، بدن ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.06,
   "end": 86.92,
   "text": "یه غذا هست که روح و روان ما رو پرورش می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.92,
   "end": 89.8,
   "text": "و هر یک را دهانی خاص است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.8,
   "end": 92.16,
   "text": "دهان آن دهان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.16,
   "end": 97.32,
   "text": "یعنی دهان بدن همین دهان معمولی که از اینجا ارتزاق می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.32,
   "end": 100.78,
   "text": "و دهان این یعنی دهان روح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.78,
   "end": 103.18,
   "text": "دهان روح و نفس ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.18,
   "end": 108.1,
   "text": "گوش. یعنی ما از طریق گوشمون غذا می‌خورونیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.1,
   "end": 111.54,
   "text": "نفسمون، به روحمون، به باطنمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.54,
   "end": 114.06,
   "text": "نه از غذای تن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.06,
   "end": 116.36,
   "text": "روان پرورش می‌یابد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.36,
   "end": 120.34,
   "text": "و فربه می‌شود و نه از غذای روان، تن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.34,
   "end": 124.8,
   "text": "یعنی این‌ها ربطی به هم ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.8,
   "end": 128.76,
   "text": "از خوردنش، از خوردن مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.76,
   "end": 130.98,
   "text": "برنج و گوشت و نون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.98,
   "end": 133.98,
   "text": "سبزی و چه می‌دونم این چیزا مادیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.98,
   "end": 137.26,
   "text": "روان انسان که پرورش پیدا نمی‌کنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.26,
   "end": 142.42,
   "text": "گاهی بعضیا فکر می‌کنن غذای توپ می‌خورن، غذای خوب می‌خورن مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.42,
   "end": 149.26,
   "text": "بازوانشون ستبره و بدنشون قویه این دلالت بر قدرت روح و پرورش روح داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.26,
   "end": 157.94,
   "text": "ربطی به هم نداره. همچنین بعضیا فکر می‌کنند که همین که روحشون با عبادات و ذکر الله تقویت بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.94,
   "end": 159.94,
   "text": "دیگه نیازی نیست به جسمشون برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.94,
   "end": 164.82,
   "text": "این هم غلطه. هر کدوم یه غذای خاص خودشون رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.82,
   "end": 171.18,
   "text": "بعد حالا حضرت استاد می‌فرمایند که غذای هر کدوم چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.18,
   "end": 177.14,
   "text": "می‌فرمود آب مظهر و ظل حیات و علم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.14,
   "end": 180.0,
   "text": "آب مظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.0,
   "end": 184.42,
   "text": "حیاته. سایه حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.42,
   "end": 187.2,
   "text": "سایه علمه. مظهر علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.2,
   "end": 190.08,
   "text": "کجا؟ در مشع طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.08,
   "end": 193.9,
   "text": "یعنی اینجا آب مایه حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.9,
   "end": 197.14,
   "text": "نشانه حیاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.14,
   "end": 201.78,
   "text": "که در عالم بالا نشانه حیات یا به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.78,
   "end": 207.78,
   "text": "آب در عالم بالا می‌شه علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.78,
   "end": 209.42,
   "text": "تکلف این چیه عرض می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.42,
   "end": 211.68,
   "text": "یعنی اگر کسی تو خواب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.68,
   "end": 215.94,
   "text": "خواب آب دید این ربط به علم پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.94,
   "end": 221.36,
   "text": "البته در بحث تعبیر خواب که باید عبور کرد از ظاهر خواب به باطنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.36,
   "end": 224.5,
   "text": "خود شر-- نفس شخص هم اینجا دخیله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.5,
   "end": 227.6,
   "text": "که فرق می‌کنه. اگر کسی پی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.6,
   "end": 235.62,
   "text": "دنبال معارف هست، کسب معارف هست، خواب دید آب خورده یعنی علمش زیاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.62,
   "end": 240.32,
   "text": "علامه فرمود اما اگر کسی نه اصلا مطلقا پی معارف نمیره، کاسبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.32,
   "end": 242.76,
   "text": "این یعنی رزقش زیاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.76,
   "end": 245.28,
   "text": "اگر نه کاسبه، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.28,
   "end": 249.4,
   "text": "اهل مطالعه و ایناس چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.4,
   "end": 252.06,
   "text": "چی می‌شه؟ ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.06,
   "end": 253.78,
   "text": "ربط به ولایت پیدا می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.78,
   "end": 257.08,
   "text": "اینا دیگه ریزه کاریای قصه است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.08,
   "end": 259.96,
   "text": "حالا هر کدومش یک محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.96,
   "end": 262.7,
   "text": "خروجی داره که اونجا ولایت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.7,
   "end": 265.02,
   "text": "دیگه مرتبه عالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 265.02,
   "end": 270.72,
   "text": "علمه. علم رو یعنی مرتبه عالی علم می‌شه ولایت، ولایت کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.72,
   "end": 272.82,
   "text": "حالا کاری به تعبیر خواب که فعلا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 272.82,
   "end": 277.62,
   "text": "اینجا می‌فرماید که آب مظهر و ظل حیات و علم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 277.62,
   "end": 281.24,
   "text": "و تن مرتبه نازله نفس و ظل آن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.24,
   "end": 283.54,
   "text": "ببینید همین طور که می‌گه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.54,
   "end": 287.64,
   "text": "مرتبه نازله علم اینجا آبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.64,
   "end": 291.54,
   "text": "من مرتبه نازله نفس ما هم اینجا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.54,
   "end": 295.38,
   "text": "تنه. حالا داره نتیجه می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.38,
   "end": 299.22,
   "text": "تن تشنه آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.22,
   "end": 302.76,
   "text": "تن تشنه آب خواهد که ظل حیات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.76,
   "end": 306.06,
   "text": "بله خب بدن وقتی تشنه شه آب می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.06,
   "end": 309.16,
   "text": "که سایه حیاته. اگه آب نخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.16,
   "end": 312.96,
   "text": "\"وجعلنا من الماء کل شيء حي\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 312.96,
   "end": 314.6,
   "text": "هر چیزی از آب حیات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 314.6,
   "end": 317.54,
   "text": "بدن ما دیگه زنده نمی‌مونه اگه این آبو نخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.54,
   "end": 321.62,
   "text": "اما روان چی؟ یعنی روان هم با خوردن آب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 321.62,
   "end": 324.4,
   "text": "نفس هم، روح هم با خوردن آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 324.4,
   "end": 328.98,
   "text": "حیات پیدا می‌کنه؟ نخیر اون حیاتش به چیز دیگه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.98,
   "end": 331.82,
   "text": "و روان تشنه علم خواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.82,
   "end": 334.02,
   "text": "و روان تشنه داشت و روان تشنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 334.02,
   "end": 337.88,
   "text": "یعنی کسی که روحش تشنه است، روانش، نفسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.88,
   "end": 340.6,
   "text": "تشنه است. چی می‌خواد این؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.6,
   "end": 343.64,
   "text": "می‌گه علم خواهد. علم اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 343.64,
   "end": 350.62,
   "text": "وقتی شما بری بالا به مرتبه عالی برسی، اونجا دیگه آب اونجا می‌شه علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.62,
   "end": 356.12,
   "text": "که اصل آن است. یعنی اصل آب علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 356.12,
   "end": 359.08,
   "text": "امام ملک و ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 359.08,
   "end": 364.22,
   "text": "کیه؟ معمولا حضرت استاد به کی می‌گه امام ملک و ملکوت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.22,
   "end": 370.79,
   "text": "می‌فرماید صادق آل محمد صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 370.79,
   "end": 373.11,
   "text": "در تفسیر طعام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.11,
   "end": 377.89,
   "text": "کریمه \"فلینظر الإنسان إلى طعامه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.89,
   "end": 383.97,
   "text": "که پس انسان نگاه می‌کنه به اینکه چی به طعامش که چی میخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.97,
   "end": 389.51,
   "text": "فرمود \"علمه الذي يأخذه عما يأخذه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.51,
   "end": 393.67,
   "text": "میگه امام صادق صلوات الله علیه فرمود این آیه که میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 393.67,
   "end": 398.97,
   "text": "انسان نگاه می‌کنه به طعامش که چه، چه طعامی رو میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.97,
   "end": 404.89,
   "text": "امام صادق صلوات الله علیه می‌فرماید منظور علمی‌ست که از کجا داره این علم رو اخذ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.89,
   "end": 408.71,
   "text": "این وجه باطنشه. بله وجه ظاهرش هم درسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.71,
   "end": 411.17,
   "text": "اینکه این غذا از کجا اومده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.17,
   "end": 414.45,
   "text": "پاکه، ناپاکه، طیبه، چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.45,
   "end": 417.03,
   "text": "حلاله، حلال نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 417.03,
   "end": 422.91,
   "text": "اینا همش هست. اما وجه باطن‌ش یک وجه باطن‌ش می‌شه اون علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.91,
   "end": 426.11,
   "text": "اون علمی که از کجا اخذ کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 426.11,
   "end": 429.37,
   "text": "بنگر که غذای جسم و جان تو چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.37,
   "end": 432.11,
   "text": "گونه است. میگه نگاه کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.11,
   "end": 434.27,
   "text": "غذای جسم و جانت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.27,
   "end": 439.95,
   "text": "چی می‌خوری سر سفره‌ت؟ هیچ‌وقت تو میری سم بذاری سر سفره بخوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 439.95,
   "end": 445.01,
   "text": "خودتو بکشی؟ غذای مسموم و کثیف و بدبو و زشت و چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.01,
   "end": 447.03,
   "text": "کریه و این. اصلا نمی‌خوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 447.03,
   "end": 451.93,
   "text": "تازه غذایی که سر سفره می‌ذاری اگرچه پاک باشه، حلال باشه، طیب باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 451.93,
   "end": 455.41,
   "text": "باز تزئینش می‌کنی. او رو می‌آرایی غذا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 455.41,
   "end": 457.59,
   "text": "تا دلچسبت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.59,
   "end": 461.19,
   "text": "اما چرا به نسبت به غذای روح اینطوری نیستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.19,
   "end": 463.53,
   "text": "چرا اونو آراایش نمیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 463.53,
   "end": 468.45,
   "text": "چرا اونو زیبا نمی‌کنی؟ و بدان که غذا با همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 468.45,
   "end": 470.37,
   "text": "اختلاف انواع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 470.37,
   "end": 472.55,
   "text": "با همه اختلافاتی که داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 472.55,
   "end": 477.57,
   "text": "انواع و زروبه‌آن یعنی اون ضرب‌هایی که درش می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 477.57,
   "end": 481.41,
   "text": "یعنی مثال‌هایی که براش هست انواع و اقسام غذاها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 481.41,
   "end": 483.95,
   "text": "مظهر صفت بقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 483.95,
   "end": 486.71,
   "text": "و صدنه اسم قیوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 486.71,
   "end": 489.11,
   "text": "و با مقتضی مناسب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 489.11,
   "end": 491.11,
   "text": "یعنی اینکه صدنه یعنی خادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 491.11,
   "end": 493.87,
   "text": "صد، صدنه یعنی خادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 493.87,
   "end": 496.63,
   "text": "یعنی میگه مظهر اسم قیومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 496.63,
   "end": 502.51,
   "text": "قیوم کسیه که في نفسه به ذات خودش قائمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 502.51,
   "end": 507.99,
   "text": "میگه این غذایی که تو می‌خوری چه اون غذای ظاهری، چه غذای باطنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 507.99,
   "end": 512.15,
   "text": "خادم چیه؟ صدنه اسم قیوم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 512.15,
   "end": 515.55,
   "text": "یعنی باعث می‌شه که خودت رو پای خودت بایستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 515.55,
   "end": 520.47,
   "text": "خودت رو پای خودت بایستی. چه جسمت، چه بدن، چه روح‌ت، روانت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 520.47,
   "end": 523.91,
   "text": "که تو در حقیقت داری تحت اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 523.91,
   "end": 526.83,
   "text": "الحی القيوم خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 526.83,
   "end": 530.85,
   "text": "این کار رو انجام میدی. هر چیزی تحت تعریف یک اسم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 530.85,
   "end": 536.13,
   "text": "و تق و می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 536.13,
   "end": 543.13,
   "text": "بله مظهر صفت بقا و از صدنه اسم قیوم و با مقتضی منا-- مصانح است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 543.13,
   "end": 547.89,
   "text": "هم سنخه. یعنی تو غذایی رو می‌خوری که هم سنخ بدنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 547.89,
   "end": 552.11,
   "text": "شما، من و شما هیچ‌وقت نمی‌ریم مثلا غذای حیوان رو بخوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 552.11,
   "end": 553.87,
   "text": "حیوان گوشت رو خام خام می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 553.87,
   "end": 556.07,
   "text": "ما می‌خوریم؟ چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 556.07,
   "end": 560.07,
   "text": "چون مصانح با ما نیست. هم سنخ با بدن ما طبعی ن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 560.07,
   "end": 562.71,
   "text": "اون باید پخته بشه. حالا اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 562.71,
   "end": 567.07,
   "text": "اون باکتری‌ها، اون کرم‌ها، اون چیزایی که در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 567.07,
   "end": 571.07,
   "text": "گوشت هست بدن حیوان هم مناسب، مصانح اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 571.07,
   "end": 576.11,
   "text": "اگر بخوره چیزیش نمی‌شه. اون یه طوری هست که بدنش اصلا اونو می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 576.11,
   "end": 578.27,
   "text": "اما ما نه. ما اگر بخوریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 578.27,
   "end": 583.29,
   "text": "خیلی غذاهایی که حیوانات می‌خورن اگه ما بخوریم اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 583.29,
   "end": 587.35,
   "text": "می‌میریم. ما طاقت و توانش رو نداریم بخوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 587.35,
   "end": 590.91,
   "text": "بنابراین میگه باید مصانح باشه، باید هم سنخ باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 590.91,
   "end": 593.49,
   "text": "که می‌فرماید دوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 593.49,
   "end": 596.55,
   "text": "ظهور اسم ظاهر و احکام آن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 596.55,
   "end": 598.95,
   "text": "چی؟ حب به دوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 598.95,
   "end": 603.39,
   "text": "اون چیزی که می‌خوری از به چه خاطر می‌خوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 603.39,
   "end": 605.95,
   "text": "برای چی چیزی رو می‌خوری؟ چه ظاهرت، چه باطنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 605.95,
   "end": 610.49,
   "text": "چون دوست داری باشی. رحمت خدا بر شیخ الرییس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 610.49,
   "end": 614.77,
   "text": "می‌فرمود دقت کردید یه بچه، یه بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 614.77,
   "end": 616.69,
   "text": "هنوز کودکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 616.69,
   "end": 619.13,
   "text": "اصلا حتی به حرف زدن نیفتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 619.13,
   "end": 623.17,
   "text": "شیخ الرییس می‌فرماید اگر اشتباه نکنم در نفس شفا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 623.17,
   "end": 627.33,
   "text": "مثال رو میاره. یه بچه کودکی در آغوش پدر، مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 627.33,
   "end": 630.75,
   "text": "یه تکون به پا-- پدر یا مادر میاد این بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 630.75,
   "end": 633.59,
   "text": "بدون اینکه کسی بهش آموزش داده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 633.59,
   "end": 636.67,
   "text": "یه دفعه یقه مادر یا پدر رو سفت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 636.67,
   "end": 638.35,
   "text": "کی به این آموزش داد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 638.35,
   "end": 645.93,
   "text": "کی بهش گفت پسر، دختر وقتی یه تکونی، تکانه‌ای به تو وارد شد سریع یقه مادر و پدر رو بگیر نیفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 645.93,
   "end": 650.61,
   "text": "کی اینو بهش آموزش داد؟ شیخ الرییس میگه این حب به بقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 650.61,
   "end": 653.23,
   "text": "حب به بقا دوست داره باقی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 653.23,
   "end": 657.09,
   "text": "در ذات و کمون غیب، غیبی این بچه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 657.09,
   "end": 660.41,
   "text": "در فطرش هست. دوست داره باقی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 660.41,
   "end": 663.55,
   "text": "حالا صرف اینکه الان ما می‌شینیم سر سفره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 663.55,
   "end": 667.55,
   "text": "درسته یه لذتی هم می‌بریم اما همون حب به بقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 667.55,
   "end": 671.81,
   "text": "دوست داریم باقی باشیم. چرا دوست داری جسمت باقی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 671.81,
   "end": 676.21,
   "text": "اما توجه نداری که باطنت هم باید باقی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 676.21,
   "end": 678.83,
   "text": "توجه نداریم این باطن ابدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 678.83,
   "end": 680.93,
   "text": "این جسم که چهل پنجاه سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 680.93,
   "end": 684.25,
   "text": "فوق الفوقش الان کسی صد سال عمر می‌کنه همه تعجب می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 684.25,
   "end": 687.27,
   "text": "ماشاالله صد سال عمر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 687.27,
   "end": 690.83,
   "text": "بعد به این نفس و این روحی که ال الابد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 690.83,
   "end": 695.91,
   "text": "ما می‌خوایم انشاالله کلمات بعدی این رو توضیح میده که ما ابد در پیش داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 695.91,
   "end": 699.69,
   "text": "اون لاغر و ضعیف و درب و داغون و این‌ها نحیف باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 699.69,
   "end": 704.63,
   "text": "چرا به اون نرسیم؟ و چرا ما باور نداریم این ارتقاء وجودی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 704.63,
   "end": 707.63,
   "text": "یه مثالی هم بزنم و برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 707.63,
   "end": 710.37,
   "text": "در جلسه نود و نه درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 710.37,
   "end": 712.83,
   "text": "شرح مثوا الانس حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 712.83,
   "end": 715.69,
   "text": "می‌فرمود که از فارابی مثال می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 715.69,
   "end": 718.77,
   "text": "علامه حسن زاده از مرحوم فارابی مثال می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 718.77,
   "end": 722.75,
   "text": "میگه شما چگونه‌ست که از یک آب، از یک قطره آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 722.75,
   "end": 726.69,
   "text": "باور داری یک قطره آبه به اون شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 726.69,
   "end": 730.53,
   "text": "تو پرورش پیدا کردی به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 730.53,
   "end": 733.97,
   "text": "این واقعا عجوبه خلقی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 733.97,
   "end": 736.39,
   "text": "خدا چه عجائبی در تو نهفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 736.39,
   "end": 739.45,
   "text": "چه عظمت، عظمتتی در من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 739.45,
   "end": 743.29,
   "text": "از یک قطره آب خدا چی خلق کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 743.29,
   "end": 750.21,
   "text": "که این چنین راه میره، می‌خوره، می‌خوابه، می‌خنده، فکر می‌کنه، تعقل می‌کنه، درمی‌آبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 750.21,
   "end": 756.29,
   "text": "مسئله حل می‌کنه، تفکر می‌کنه، تأمل می‌کنه، تعمق می‌کنه، بمب اتم می‌سازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 756.29,
   "end": 758.55,
   "text": "به فضاها میره میاد. از یه قطره آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 758.55,
   "end": 761.65,
   "text": "الان اینو که باور داریم‌ها همه، همه اینو قبول داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 761.65,
   "end": 763.87,
   "text": "از چیه؟ همه میگیم از یه قطره آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 763.87,
   "end": 769.43,
   "text": "چگونه‌ست که این سیر تطور وجودی خودمون رو از اون قطره آب تا حالا رو قبول داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 769.43,
   "end": 775.67,
   "text": "از اینجا به بعد رو قبول نداریم که بابا ما قراره بریم به ارتقاء وجودی و سیر استکمالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 775.67,
   "end": 779.45,
   "text": "بریم تا برسیم به حقیقت اسماء الهیه و به اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 779.45,
   "end": 782.55,
   "text": "به اون عرش و بلکه فوق عرش برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 782.55,
   "end": 785.31,
   "text": "بال و پر پیدا کنیم بریم به اون مقامات عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 785.31,
   "end": 789.23,
   "text": "اینجا رو قبول نداریم. میگیم نه همین چهل پنجاه روزه خوش از عشقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 789.23,
   "end": 793.45,
   "text": "چرا اونو باور نداریم؟ انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 793.45,
   "end": 796.53,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 796.53,
   "end": 802.01,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}