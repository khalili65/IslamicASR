   "title": "## کفارهٔ روزهٔ سال گذشته",
   "start": 15.36,
   "end": 177.16
  },
  {
   "index": 1,
   "title": "## شب اول رمضان؛ سورهٔ فتح در نوادر راوندی",
   "start": 177.16,
   "end": 197.68
  },
  {
   "index": 2,
   "title": "## نوشتن سورهٔ فتح زیر سر و با زعفران",
   "start": 197.68,
   "end": 580.93
  },
  {
   "index": 3,
   "title": "## کف گلاب روز اول رمضان؛ رفع پریشانی",
   "start": 580.93,
   "end": 636.79
  },
  {
   "index": 4,
   "title": "## کلمهٔ پنجاه و هفت؛ صورت انسانی و نظام هستی",
   "start": 636.79,
   "end": 738.36
  },
  {
   "index": 5,
   "title": "## فهم متفاوت؛ برزخ جامع و قابلمه",
   "start": 738.36,
   "end": 1094.74
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 4.88,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.88,
   "end": 9.1,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.1,
   "end": 15.36,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.36,
   "end": 24.1,
   "text": "در خصوص کفاره توجه داشته باشید عزیزانی که کفاره عذر میخوان بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.1,
   "end": 29.24,
   "text": "خب مثلا سال ماه مبارک رمضان سال گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.24,
   "end": 32.46,
   "text": "مریض بودن نتونستن بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.46,
   "end": 36.3,
   "text": "خب اینا به گردنشون هست تا امسال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.3,
   "end": 45.98,
   "text": "اگر چنانچه عذرشون برطرف شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.98,
   "end": 50.08,
   "text": "خب تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.08,
   "end": 58.68,
   "text": "ماه مبارک رمضان امسال وقت داشتن که یعنی تا امروز وقت داشتن که این قضا رو بگیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 58.68,
   "end": 63.44,
   "text": "و اگر چنانچه نه عذرشون برطرف نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 63.44,
   "end": 67.06,
   "text": "که هیچی فقط کفاره به گردنشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 67.06,
   "end": 71.12,
   "text": "دیگه اگر از سال قبل تا امسال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 71.12,
   "end": 76.72,
   "text": "این عذر به گردنشون بود، این مریضی برطرف نشد، کلاً قضا ساقط میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 76.72,
   "end": 79.58,
   "text": "قضای روزه فقط کفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 79.58,
   "end": 83.96,
   "text": "منتها اینو توجه داشته باشید به خاطر این نکته من عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 83.96,
   "end": 87.72,
   "text": "کفاره رو باید صبر کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.72,
   "end": 89.7,
   "text": "تا ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.7,
   "end": 93.64,
   "text": "بعدی برسه. یعنی اونایی که پارسال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.64,
   "end": 96.66,
   "text": "عذر داشتن مریض بودن روزه نگرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.66,
   "end": 100.5,
   "text": "خب باید صبر کنن تا این عذر برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.5,
   "end": 102.94,
   "text": "برطرف نشد تا امسال رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.94,
   "end": 110.36,
   "text": "نمی‌تونن قبل از اینکه امسال برسه کفاره بدن چون شاید عذر برطرف شد و روزه رو گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.36,
   "end": 118.62,
   "text": "دیگه کفاره نداره که. مگر کسی که یقین داره مریضی‌ش به گونه‌ایه که می‌کشه تا سال بعد؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.62,
   "end": 122.28,
   "text": "اون مشکل نداره و همون موقع می‌تونه کفاره رو بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.28,
   "end": 125.88,
   "text": "قبل از ماه مبارک رمضان. برای همین خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.88,
   "end": 131.26,
   "text": "غالباً این شکلیه که دیگه صبر می‌کنن تا ماه مبارک رمضان یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 131.26,
   "end": 137.04,
   "text": "فردا برسه بعد کفاره رو اونم به روز باید حساب کنن نه به سال قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 137.04,
   "end": 141.3,
   "text": "کس که می‌خواد حتی کفاره روزه‌های سال قبلش رو بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 141.3,
   "end": 146.18,
   "text": "مراجع همه فرمودن به اتفاق که باید به روز یعنی الان کفاره چقدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 146.18,
   "end": 148.84,
   "text": "من امروز سایت‌ها رو هم بررسی کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 148.84,
   "end": 153.24,
   "text": "چون بعضیا پرسیدن هنوز ندیدم مرجعی اعلام کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 153.24,
   "end": 158.52,
   "text": "شاید حالا من از صبح دیدم از صبح به بعد کسی اعلام کرده باشه ولی صبح که من دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 158.52,
   "end": 160.62,
   "text": "جان؟ مثل پارسال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 160.62,
   "end": 162.92,
   "text": "پارسال هجده هزار تومن بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.92,
   "end": 166.64,
   "text": "دوازده تومن بود. خب حالا به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.64,
   "end": 170.4,
   "text": "می‌تونید رجوع کنید تو سایت‌های مراجع و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.4,
   "end": 172.1,
   "text": "مرجع تقلید خودتون ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.1,
   "end": 177.16,
   "text": "حالا ما همون که دیدیم فردا انشاالله اعلام می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 177.16,
   "end": 180.12,
   "text": "امشب خب شب بسیار مهمی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.12,
   "end": 184.42,
   "text": "یکی دو تا نکته امشب عرض کنم بعد بریم سراغ درس و بحثمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.42,
   "end": 186.3,
   "text": "خب اعمال امشب خیلی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.3,
   "end": 188.92,
   "text": "شب اول ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.92,
   "end": 195.7,
   "text": "و احیا هم داره. یکی از اعمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.7,
   "end": 200.16,
   "text": "خیلی خوب امشب که متاسفانه من دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.16,
   "end": 206.76,
   "text": "تو فضای مجازی به دروغ بهش اضافه کردن در صورتی که سندیات نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 206.76,
   "end": 212.74,
   "text": "سوره فتحه. سوره فتح رو اون روایتی که مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 212.74,
   "end": 217.6,
   "text": "راوندی در کتابش آورده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 217.6,
   "end": 221.7,
   "text": "اون روایت رو من براتون تقدیم می‌کنم که اصلش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.7,
   "end": 226.36,
   "text": "تو کتاب ان نوادر میاره خواستید ببینید صفحه دویست و پنجاه و هفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 226.36,
   "end": 233.46,
   "text": "و ح-- صحن اصلی حضرت معصومه سلام الله علیها بغل حوضه سنگ قبر بلنده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 233.46,
   "end": 238.52,
   "text": "ایشونه. این کتاب ان نوادر ایشون معروفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 238.52,
   "end": 245.34,
   "text": "اونجا از ه-- پیامبر عظیم الشأن اسلام حدیث میاره که هر کس در شب اول ماه مبارک رمضان یعنی امشب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 245.34,
   "end": 247.86,
   "text": "امشب سوره فتح را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 247.86,
   "end": 251.7,
   "text": "بیست و نه آیه هم هست، سوره فتح را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 251.7,
   "end": 257.96,
   "text": "برآید نماید تا سال آینده همین روز در حفظ و حراست الهی خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 257.96,
   "end": 260.86,
   "text": "خب همه ما نگران اهل و ایال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 260.86,
   "end": 263.24,
   "text": "زندگی‌مون هستیم که یه وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 263.24,
   "end": 265.56,
   "text": "آفتی بزنه، مشکلی بلایی بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 265.56,
   "end": 267.24,
   "text": "خب بهترین کار مصون کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 267.24,
   "end": 272.08,
   "text": "الان این بچه‌های صیانت، بچه‌های حراست چگونه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 272.08,
   "end": 274.26,
   "text": "صیانت و حراست می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 274.26,
   "end": 280.38,
   "text": "سعی‌شون بر اینه از نیروها، از سازمان، چه چه اینا با سوره فتح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 280.38,
   "end": 282.74,
   "text": "بخون خدا حراست می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.74,
   "end": 284.88,
   "text": "از تو و خانواده‌ت امشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.88,
   "end": 288.54,
   "text": "یه را-- اون که من میگم دروغ گفتن دیدم که میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.54,
   "end": 295.44,
   "text": "سه بار امشب بخونی بعد به علاوه فردا صبحش به علاوه سوره یاسین کنی و نصر کنی و اینا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.44,
   "end": 299.98,
   "text": "تو هیچ کتاب مجموعه روایات ما اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 299.98,
   "end": 303.06,
   "text": "این هست که الان من عرض کردم سوره فتح رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 303.06,
   "end": 306.08,
   "text": "که البته در کنز العمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 306.08,
   "end": 309.06,
   "text": "پیامبر فرمودن اونجا روایتش اونجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.06,
   "end": 316.16,
   "text": "وقتی سوره فتح نازل شد پیغمبر فرمودن: \"سوره‌ای بر من نازل شد\" به یارانشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 316.16,
   "end": 318.2,
   "text": "\"که نزد من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.2,
   "end": 326.44,
   "text": "محبوب‌تر و دوست‌داشتنی‌تر از همه آن چیزهایی‌ست که خورشید بر اون‌ها تابیده است.\" الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 326.44,
   "end": 329.28,
   "text": "چقدر این سوره با عظمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.28,
   "end": 334.42,
   "text": "حالا برای اون‌هایی که میخوان بیشتر بهره بگیرن باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 334.42,
   "end": 336.58,
   "text": "هدیه عرض کنم خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 336.58,
   "end": 339.72,
   "text": "در تفسیر برهان یکی از تفاسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 339.72,
   "end": 344.9,
   "text": "رواییه مثل نور الثقلین، خود تفسیر اهل بیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 344.9,
   "end": 348.94,
   "text": "در المنثور اینا تفس-- تفاسیر روایی‌اند که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 348.94,
   "end": 352.06,
   "text": "علامه حائری شیرازی علیه الرحمه خیلی به این تفاسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.06,
   "end": 356.6,
   "text": "توصیه می‌کنن که ذیل آیات روایات آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.6,
   "end": 360.48,
   "text": "که اونجا در جلد پنج‌ش تفسیر برهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 360.48,
   "end": 363.82,
   "text": "صفحه صد و هفتاد و هفت می‌تونید این روایت رو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.82,
   "end": 366.22,
   "text": "که پیغمبر عزیز عالم در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.22,
   "end": 371.37,
   "text": "سوره فتح فرمودن که هر کس سوره فتح رو بنویسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.37,
   "end": 377.31,
   "text": "و هنگام خواب زیر سرش بذاره از شر دزد در امانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 377.31,
   "end": 379.87,
   "text": "بعضیا پرسیدن آقا ما چه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 379.87,
   "end": 383.59,
   "text": "که مثلاً از شر دزد در امان باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 383.59,
   "end": 386.27,
   "text": "بسم الله این راهشه و حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 386.27,
   "end": 389.61,
   "text": "این رو در گوشیه دیگه این حرف، این هدیه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 389.61,
   "end": 396.11,
   "text": "سند داره. سندش هم که عرض کردیم پیغمبر فرموده اما معمولاً اساتید ما اینو در گوشی به ما گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 396.11,
   "end": 398.25,
   "text": "ما هم در گوشی به شما می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 398.25,
   "end": 401.51,
   "text": "بره در گوش اونایی که اهلشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 401.51,
   "end": 404.71,
   "text": "چون البته اینم بگم می‌شنویما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 404.71,
   "end": 408.55,
   "text": "شاید خود منم توفیق انجامش رو پیدا نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 408.55,
   "end": 410.41,
   "text": "اینطوریه توفیق می‌خواد این چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 410.41,
   "end": 414.37,
   "text": "الان بعضیا ریششون سفید شده تازه همچین چیزی رو می‌شنون مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 414.37,
   "end": 417.79,
   "text": "توفیق می‌خواد، مال هرکسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.79,
   "end": 421.19,
   "text": "پیغمبر فرمودن که هرکی می‌خاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.19,
   "end": 423.39,
   "text": "حرفش به قول ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.39,
   "end": 426.23,
   "text": "برو داشته باشه، یعنی حرفشو بپذیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 426.23,
   "end": 430.71,
   "text": "مخصوصاً این سخنران‌ها، مدیرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 430.71,
   "end": 432.73,
   "text": ". البته حرف حقشون رو دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 432.73,
   "end": 440.57,
   "text": "درسته؟ سخنران مدعی می‌خواد تأثیر، تأثیر کلام داشته باشه، تأثیر نفس داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 440.57,
   "end": 445.37,
   "text": "فرمودن که سوره فتح رو در کاغذی بنویسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 445.37,
   "end": 450.41,
   "text": "پیغمبر فرمودن و با آب زمزم بشوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 450.41,
   "end": 453.61,
   "text": "اگر آب زمزم پیدا نکردید مشکل نداره با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 453.61,
   "end": 457.77,
   "text": "هر آبی. این که میگه بنویسه و بخوره چجوری بنویسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 457.77,
   "end": 462.37,
   "text": "با خودکار؟ نه. این که میگه بنویسی بشوری‌ش بخوری‌ش یعنی با زعفران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 462.37,
   "end": 464.83,
   "text": "اینو هر جا دیدید یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 464.83,
   "end": 468.13,
   "text": "با جوهره رو که نمیشه با آب بشوری بخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 468.13,
   "end": 473.91,
   "text": "با زعفران. مثلا یه کبریت رو برمی‌داری چوب کبریت رو می‌زنی تو آب زعفران رو کاغذ می‌نویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 473.91,
   "end": 477.37,
   "text": "نیاز هم نداره خیلی خوش خط و پشت سر هم و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 477.37,
   "end": 480.73,
   "text": "همین‌طور که بنویسی رو کاغذ، رو کاغذ تمیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 480.73,
   "end": 484.05,
   "text": "سوره فتح رو می‌نویسی بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 484.05,
   "end": 486.01,
   "text": "می‌شوری و اون رو می‌خوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 486.01,
   "end": 488.33,
   "text": "می‌تونی به خودت و خانواده‌ت بخورونین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 488.33,
   "end": 494.75,
   "text": "پیغمبر فرمود چنین کسی نزد مردم جایگاهی پیدا می‌کنه که به سخنانش گوش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 494.75,
   "end": 497.01,
   "text": "بعد مهمش اینجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 497.01,
   "end": 500.09,
   "text": "و هر چیزی رو که می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 500.09,
   "end": 503.99,
   "text": "و می‌شنوه ضبط می‌کنه و حفظ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 503.99,
   "end": 510.29,
   "text": "برای اونایی که می‌خوان کنکور بدن، کارهای مبحث علمی دارن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 510.29,
   "end": 514.29,
   "text": "من محضر استاد سراج که می‌رسیدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.29,
   "end": 518.53,
   "text": "ایشون به من می‌گفت بگو. خدا شاهده از حفظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.53,
   "end": 521.09,
   "text": "از صفر تا صد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.09,
   "end": 524.55,
   "text": "حرفای جلسه پیشش رو تند و تند و تند می‌گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.55,
   "end": 527.29,
   "text": "مثلا یک ساعت بیشتر از یک ساعت ایشون صحبت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 527.29,
   "end": 530.77,
   "text": "من تو ده دقیقه یه ربع تند تند همه رو می‌گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 530.77,
   "end": 533.29,
   "text": "یادم هست انشاالله تعریف از خود نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 533.29,
   "end": 537.31,
   "text": "می‌خوام بگم که بالاخره بخواهیم از این چیزا هم یه ذره بخواهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 537.31,
   "end": 540.41,
   "text": "همش سیب و گلابی نخواهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 540.41,
   "end": 545.77,
   "text": "ایشون می‌گفت بخ-- از وقتی که ایشان اینجا هست و من سنم خیلی کم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 545.77,
   "end": 548.21,
   "text": "ازدواجم نکرده بودم. گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 548.21,
   "end": 550.85,
   "text": "من هستم تا وقتی که ایشون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.85,
   "end": 554.53,
   "text": "چون از بقیه هرچی می‌پرسید هیچکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.53,
   "end": 558.27,
   "text": "نمی‌تونست بگه. خب بالاخره اینا مهم هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 558.27,
   "end": 562.13,
   "text": "آدم بالاخره وقت گذاشته. الان شما وقت گذاشتی نشستی اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.13,
   "end": 565.75,
   "text": "از این در رفتی از گوشت بده حاج آقا خیلی خوب بود صحبت‌های شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.75,
   "end": 568.97,
   "text": "خب بفرما ببینم یه خطشو بگو ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 568.97,
   "end": 571.67,
   "text": "حالا خوب بود دیگه. نه؟ یه خطشو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 571.67,
   "end": 574.13,
   "text": "اذیتمون نکن حاج آقا حرفای خوبی زدی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 574.13,
   "end": 577.69,
   "text": "یا چه درد خورد که یادت رفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 577.69,
   "end": 583.65,
   "text": "خب خسته‌تون نکنم. البته یه نکته‌ی دیگه هم بگم که فردا این‌هایی که دارم به شما میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 583.65,
   "end": 587.51,
   "text": "بزرگان خیلی تجربه‌ش رو کردن و به ما توصیه‌ش رو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.51,
   "end": 593.83,
   "text": "من خودم بعضیاشو مثل این که الان عرض می‌کنم رو سعی می‌کنم همه ساله انجام بدم برکاتشو ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 593.83,
   "end": 597.29,
   "text": "یکی از مشکلات عجیب امروزی ما پریشونیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 597.29,
   "end": 603.79,
   "text": "خاری و پریشونی و طرف چنان به هم ریخته است حوصله نداره با کسی حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 603.79,
   "end": 608.07,
   "text": "فرمود روز اول ماه مبارک رمضان که رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 608.07,
   "end": 610.97,
   "text": "اینم شیخ عباس تو مفاتیح آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 610.97,
   "end": 614.29,
   "text": "نگید حاج آقا از خودش درآورد. خدا رحمت کنه آقای بهجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 614.29,
   "end": 620.23,
   "text": "به ما توصیه کردن. روز اول ماه رمضان یه کف از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 620.23,
   "end": 624.47,
   "text": "گلاب رو بردار به روح خودت بزن، به صورتت، به بچه‌هات هم همینطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 624.47,
   "end": 629.89,
   "text": "یه کف از گلاب بزن به صورت خودت و بچه‌هات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 629.89,
   "end": 632.57,
   "text": "کل سال به برکت همین کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 632.57,
   "end": 635.77,
   "text": "که دستور پیغمبر رو انجام دادی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 635.77,
   "end": 637.41,
   "text": "خاری و پریشونی در امانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 637.41,
   "end": 641.61,
   "text": "و اگه به سرت بزنی تو اون سال از سرسام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 641.61,
   "end": 644.17,
   "text": "یا سرسام گرفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 644.17,
   "end": 646.87,
   "text": "یعنی اعصاب انقدر داغون می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.87,
   "end": 650.59,
   "text": "از اون هم خدا تو رو حفظ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 650.59,
   "end": 658.21,
   "text": "خب تو این فرصت خیلی کوتاهی که داریم یه بالاخره درسمون جا نمونه، کلمه پنجاه و هفت رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 658.21,
   "end": 662.91,
   "text": "کوتاه عرض کنیم. کلمه پنجاه و هفت از صد کلمه در معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 662.91,
   "end": 667.01,
   "text": "خیلی این کلمه حرف توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 667.01,
   "end": 672.57,
   "text": "به واقع باید اگر بخواد جا بیفته ده تا جلسه‌ی پر استخون مثلا چهل و پنج دقیقه‌ای می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 672.57,
   "end": 675.33,
   "text": "حالا ما میگیم میریم اجمالاً بشنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 675.33,
   "end": 681.21,
   "text": "آن که در صورت انسانی نسبت به نظام هستی عمیق شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 681.21,
   "end": 683.17,
   "text": "یعنی صورت انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 683.17,
   "end": 686.33,
   "text": "نسبت بگیره با نظام آفرینش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 686.33,
   "end": 690.51,
   "text": "این دو تا رو با هم قیاس کنه. صورت انسان کجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 690.51,
   "end": 693.35,
   "text": "این صورت عالم هستی کجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 693.35,
   "end": 696.19,
   "text": "اینا رو با هم کنار هم بگذاره دقت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 696.19,
   "end": 700.97,
   "text": "می‌بیند که اگر صورت انسانی نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 700.97,
   "end": 704.19,
   "text": "نه افاضات عقلی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 704.19,
   "end": 707.05,
   "text": "و نه استفادات نفسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 707.05,
   "end": 709.59,
   "text": "و نه سیاست شرعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 709.59,
   "end": 714.71,
   "text": "چه بحث شرعی‌ش، چه اون استفاده‌های نفسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 714.71,
   "end": 717.47,
   "text": "فألهمها فجورها وتقواها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 717.47,
   "end": 719.99,
   "text": "الهامات، اعلامات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 719.99,
   "end": 724.19,
   "text": "اون ای‌ها. هیچ‌کدوم از اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 724.19,
   "end": 726.67,
   "text": "القاها، هیچ‌کدوم از اینا نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 726.67,
   "end": 729.53,
   "text": "حتی افاضات عقلی هم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 729.53,
   "end": 732.84,
   "text": "یعنی ما کر و گنگ و کور و هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 732.84,
   "end": 735.24,
   "text": "هیچ افاضه‌ای، هیچ فیضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 735.24,
   "end": 738.24,
   "text": "چرا؟ به نظر شما چرا اینطوریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 738.24,
   "end": 742.62,
   "text": "یه نکته فقط بگم. چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 742.62,
   "end": 745.72,
   "text": "به فرمایش حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 745.72,
   "end": 748.42,
   "text": "شیخ اکبر و مرحوم آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 748.42,
   "end": 754.16,
   "text": "جلال‌الدین آشتیانی و خود حضرت استاد چند تا مطلب آماده کرده بودم ناب، عالی و ربط بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 754.16,
   "end": 758.18,
   "text": "انسان کامل و نظام آفرینش، باشه طلبتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 758.18,
   "end": 761.66,
   "text": "یه در اثبات این یه نکته عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 761.66,
   "end": 766.32,
   "text": "آیا اگر الله نبود اسماء دیگه بودند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 766.32,
   "end": 769.32,
   "text": "الله اسم جامعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 769.32,
   "end": 771.06,
   "text": "الله. لفظ جلاله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 771.06,
   "end": 773.74,
   "text": "همه‌ی اسماء برگشت به او می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 773.74,
   "end": 776.76,
   "text": "اب همه است، ریشه و ام همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 776.76,
   "end": 780.74,
   "text": "درسته؟ همه تلألأ و پرتوی او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 780.74,
   "end": 783.54,
   "text": "او مثل خورشیده که بقیه پرتوی او هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 783.54,
   "end": 786.2,
   "text": "همه‌ی اسماء، اسماء عینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 786.2,
   "end": 789.78,
   "text": "حالا ما داریم که مصداق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 789.78,
   "end": 793.0,
   "text": "اتم الله اسم جامع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 793.0,
   "end": 795.6,
   "text": "مصداق اتم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 795.6,
   "end": 801.82,
   "text": "انسان کامله. الان در نشئه عنصری تنها امام زمان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 801.82,
   "end": 804.54,
   "text": "با بدن عنصری‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 804.54,
   "end": 807.2,
   "text": "این مصداق اتم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 807.2,
   "end": 810.2,
   "text": "یعنی چی مصداق اتم الله حاج آقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 810.2,
   "end": 815.26,
   "text": "یعنی اینکه تمام اسماء حسنی و صفات اولیا الهی در او پیاده شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 815.26,
   "end": 819.66,
   "text": "اونم به نحو اتم، بالاتر از تام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 819.66,
   "end": 826.52,
   "text": "مثلاً انبیام خب به صورت تام اسماء الهی درشون پیاده شده اما اتم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 826.52,
   "end": 829.64,
   "text": "یعنی دیگه تمامه، به تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 829.64,
   "end": 832.18,
   "text": "لذا این انسان کامل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 832.18,
   "end": 838.76,
   "text": "انبیا دیگه به جز خطمی، به جز مقام خطمی بقیه در کنار اهل بیت ما و امام زمان ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 838.76,
   "end": 843.64,
   "text": "اون‌ها بذاری کنار انسان کامل زمان ما نقص داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 843.64,
   "end": 848.04,
   "text": "اون کامل نیست حتی شیخ الانبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 848.04,
   "end": 853.0,
   "text": "این انسان کامل، یعنی تمام اسماء به نحو احسن در او پیاده شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 853.0,
   "end": 856.78,
   "text": "خب اگر شما اینو ورداری چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 856.78,
   "end": 861.56,
   "text": "اصلا امکانش نیست ورداری چون همه چی تجلی اسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 861.56,
   "end": 865.08,
   "text": "وهرت الموجودات عن بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 865.08,
   "end": 868.28,
   "text": "یه نکته دیگه در گوشی باز خ-خدمتتون عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 868.28,
   "end": 871.68,
   "text": "که این، این مطلب رو تو یه جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 871.68,
   "end": 876.14,
   "text": "ما شب جمعه‌ای در هیئت یا زهرا شرق تهران در قالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 876.14,
   "end": 879.4,
   "text": "لقاء الله، اونجا بحثمون لقاء الله توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 879.4,
   "end": 888.96,
   "text": "خیلی به درد بخوره این بحث. چرا شما الان دارید یک حرف رو همه می شنوید اما یکی یه جوری می فهمه یکی یه جور دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 888.96,
   "end": 891.08,
   "text": "چرا؟ چون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 891.08,
   "end": 894.28,
   "text": "فهم شما خودش تجلی حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 894.28,
   "end": 897.42,
   "text": "تجلیات الهی یعنی ظهور حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 897.42,
   "end": 901.16,
   "text": "در حواجس افکار شما این شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 901.16,
   "end": 903.44,
   "text": "شما اینطوری می فهمی اونج-- چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 903.44,
   "end": 909.0,
   "text": "به جهت اینکه ف-فاعلیت بر اساس قابلیت پیاده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 909.0,
   "end": 913.6,
   "text": "قابلیت شما چقدره؟ سعه وجودی شما، ظرفیت شما چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 913.6,
   "end": 916.94,
   "text": "کاملاً با هم متفاوت. لذا متفاوت می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 916.94,
   "end": 920.38,
   "text": "همه هم به حق می‌فهمیم اما متفاوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 920.38,
   "end": 923.76,
   "text": "اون تجلی حقه. ظهور حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 923.76,
   "end": 927.62,
   "text": "همه‌ی این ظهورات ظهور اسم الله‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 927.62,
   "end": 930.78,
   "text": "که اگر تو اون اسمو ورداری اصلا دیگه چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 930.78,
   "end": 933.26,
   "text": "لذا قطعاً باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 933.26,
   "end": 937.12,
   "text": "این ظهور وجود داشته باشه و یک واسطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 937.12,
   "end": 940.74,
   "text": "فیضی باشد که بهش می‌گن برزخ جامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 940.74,
   "end": 943.38,
   "text": "بزرگ‌ترین و جامع‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 943.38,
   "end": 948.64,
   "text": "برزخ و حدی که بین خدا و خلقشه که ب-برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 948.64,
   "end": 955.7,
   "text": "طولیه نه عرضی. نه مثلا این دیوار بین مثلا این ور و اون ور برزخ شده، این برزخ عرضیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 955.7,
   "end": 959.1,
   "text": "نه برزخ طولی یعنی هم صفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 959.1,
   "end": 965.04,
   "text": "مافوق رو داره هم صفات مادون اما در عین حال نه اونه، نه این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 965.04,
   "end": 968.88,
   "text": "میگه علی علیه الصلاة والسلام بشره اما چه بشری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 968.88,
   "end": 973.48,
   "text": "خلیفه بشر. کأنه حقه اما حق هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 973.48,
   "end": 977.6,
   "text": "حق مطلق نیست. بشره اما باز بشر به اون صورت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 977.6,
   "end": 980.5,
   "text": "یعنی در برزخه. یعنی چی برزخه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 980.5,
   "end": 984.1,
   "text": "واسطه فیضه. مثل اینکه مثال آخری که بزنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 984.1,
   "end": 987.84,
   "text": "مثل اینکه چه اتفاقی افتاده و داره میفته در عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 987.84,
   "end": 995.12,
   "text": "اگر شما بخواید آب رو جوش کنید اثر کنه آتش در آب قطعاً یه قابلمه‌ای نیاز دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 995.12,
   "end": 998.12,
   "text": "یه دیگی چیزی بذاری آبو بریزی توش بذاری رو آتیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 998.12,
   "end": 1003.56,
   "text": "اگر این برزخ، این واسطه، قابلمه، این دیگ نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1003.56,
   "end": 1005.84,
   "text": "آب، آبو بریز رو آتیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1005.84,
   "end": 1010.2,
   "text": "این آتیش هر چقدرم حرارتش زیاد باشه دیگه میزنه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1010.2,
   "end": 1014.68,
   "text": "آب رو از بین میبره، بخار می‌کنه، اصلاً از بینش میبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1014.68,
   "end": 1017.36,
   "text": "خلائق در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1017.36,
   "end": 1020.84,
   "text": "برابر اون ظهور حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1020.84,
   "end": 1022.92,
   "text": "اشراقات الهیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1022.92,
   "end": 1025.84,
   "text": "چون ضعیفن، ناقصن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1025.84,
   "end": 1030.44,
   "text": "قدرت تحمل اون اشراقات رو ندارن، اون پرتوی نور رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1030.44,
   "end": 1033.14,
   "text": "اصلاً میزنه همه رو ذوب می‌کنه، آب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1033.14,
   "end": 1037.02,
   "text": "یه واسطه‌ای، یه وساطتی، یک برزخی می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1037.02,
   "end": 1041.02,
   "text": "اون انسان کامله که واسطه فیض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1041.02,
   "end": 1047.78,
   "text": "اون تعدیل می‌کنه نور رو در حد ظرف تو، قصت رو از ولایت می‌بخشه بهت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1047.78,
   "end": 1050.1,
   "text": "که این می‌شه وزن‌گیری هنگام موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1050.1,
   "end": 1053.66,
   "text": "هر کسی از ما اماممون رو که می‌بینیم وقت موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1053.66,
   "end": 1056.74,
   "text": "قصتمون رو ازش می‌گیریم. وزن‌کشی صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1056.74,
   "end": 1060.28,
   "text": "بارها عرض کردیم اونم که موازین القسط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1060.28,
   "end": 1063.6,
   "text": "قصت رو بهت میده. یعنی چه بهره‌ای از ولایت گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1063.6,
   "end": 1065.62,
   "text": "یعنی بهره‌ای از ولایت گرفتی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1065.62,
   "end": 1070.82,
   "text": "یعنی از خدا به تو اشراقات می‌رسه، الهامات می‌رسه، اعلامات می‌رسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1070.82,
   "end": 1073.94,
   "text": "ایها حتی می‌رسه. اما به دست امامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1073.94,
   "end": 1076.2,
   "text": "حالا اینو ورداری همه چی از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1076.2,
   "end": 1082.38,
   "text": "منظور از این کلمه یعنی این. یعنی اون انسان رو، انسان رو ورداری اصلاً چیزی دیگه باقی نمی‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1082.38,
   "end": 1090.06,
   "text": "نمی‌شه که نباشه. انشاالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1090.06,
   "end": 1094.74,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}