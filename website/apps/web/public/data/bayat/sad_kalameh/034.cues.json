   "title": "## کلمهٔ سی‌وسه؛ تجرد صورت علمیه",
   "start": 11.66,
   "end": 52.82
  },
  {
   "index": 1,
   "title": "## علم؛ حضور مجرد نزد مجرد",
   "start": 52.82,
   "end": 205.36
  },
  {
   "index": 2,
   "title": "## فارابی؛ دو دلیل بر تجرد نفس",
   "start": 205.36,
   "end": 247.4
  },
  {
   "index": 3,
   "title": "## دلیل دوم؛ اخذ از ملکوت در خواب",
   "start": 247.4,
   "end": 354.54
  },
  {
   "index": 4,
   "title": "## قیامت؛ صورت علم و عمل",
   "start": 354.54,
   "end": 397.82
  },
  {
   "index": 5,
   "title": "## حدیث ظرف علم؛ اتساع بی‌پایان",
   "start": 397.82,
   "end": 447.76
  },
  {
   "index": 6,
   "title": "## اقرأ و ارتق؛ قرآن بی‌انتها",
   "start": 447.76,
   "end": 538.54
  },
  {
   "index": 7,
   "title": "## هو الذی بعث فی الامیین",
   "start": 538.54,
   "end": 580.48
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 5.52,
   "text": "و بهین استعین. السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.52,
   "end": 7.5,
   "text": "و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.5,
   "end": 10.84,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.84,
   "end": 15.92,
   "text": "می‌رسیم به کلمه سی و سه از صد کلمه در معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.92,
   "end": 19.6,
   "text": "می‌فرمایند آنکه در صورت علمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.6,
   "end": 28.8,
   "text": "به درستی تعقل کند هم صورت علمیه را و هم واهب آن را عاری از ماده و احکام آن می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.8,
   "end": 38.5,
   "text": "یعنی اذعان می‌کند که صورت علمیه و وعاء تقرر آن مطلقاً چه مفیض و چه مستفیض فوق طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.5,
   "end": 43.66,
   "text": "و ورای آن‌اند. یه توضیح اجمالی کوتاهی عرض کنیم که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.66,
   "end": 48.86,
   "text": "قصدمون صرفاً توی این دور اول این صد کلمه اجمال گفتن اجماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.86,
   "end": 52.42,
   "text": "حالا بعداً انشاالله تفصیلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.42,
   "end": 55.66,
   "text": "حضرت علامه طباطبایی علیه رحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.66,
   "end": 59.46,
   "text": "در کتاب شریف بدایة الحکمه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.46,
   "end": 63.28,
   "text": "وقتی بحث تجرد علم رو میخوان بیان کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.28,
   "end": 67.56,
   "text": "میفرمایند که علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.56,
   "end": 71.46,
   "text": "وقتی خود علم رو میخوان توضیح بدن که مجرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.46,
   "end": 74.06,
   "text": "و وقتی این علم وارد بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.06,
   "end": 78.82,
   "text": "نفس ناطقه ما میشه و برای ما حقیقتی معلوم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.82,
   "end": 83.0,
   "text": "میفرمایند علم حضور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.0,
   "end": 85.94,
   "text": "حضوره. این دقت بفرمایید حضور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.94,
   "end": 89.14,
   "text": "یک چیز مجرد است در نزد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.14,
   "end": 93.02,
   "text": "مجرد. به این میگن علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.02,
   "end": 99.06,
   "text": "ما قبلاً گفتیم وقتی یک حقیقتی در درون ما آشکار میشه ما یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.06,
   "end": 101.52,
   "text": "حقیقتی رو می‌چشیم، می‌فهمیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.52,
   "end": 109.04,
   "text": "علمی رو فرا می‌گیریم، معلوم میشه برامون در درونمون پای یک ملک هست اینجا وسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.04,
   "end": 113.4,
   "text": "در ثغور نفسمون در اون کمون ذاتمون nefsi",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.4,
   "end": 118.28,
   "text": "اون ملکی متنزل شده و اون حقیقت رو به ما چشونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.28,
   "end": 121.8,
   "text": "این معنای نزول ملک بود که در ماه مبارک رمضان گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.8,
   "end": 124.34,
   "text": "ملائکه هم که خودشون مجردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.34,
   "end": 130.86,
   "text": "علمی هم که میارن اون هم یعنی اون حقیقتی که بر تو معلوم میشه اونم مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.86,
   "end": 133.5,
   "text": "نفس ناطقه تو هم مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.5,
   "end": 135.32,
   "text": "یعنی ظرف علم هم مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.32,
   "end": 136.92,
   "text": "نمیشه علم مجرد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.92,
   "end": 140.04,
   "text": "یعنی چی مجرده؟ نترسیم از این کلمات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.04,
   "end": 143.28,
   "text": "یعنی ماده نیست. مادی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.28,
   "end": 147.42,
   "text": "اینطوری نیست که به این شکل مثلا شکل و اندازه و رنگ و بو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.42,
   "end": 152.32,
   "text": "و چه می‌دونم این‌ها داشته باشه. یعنی ماده از شکل ماده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.32,
   "end": 154.42,
   "text": "مجرده. عالم بالاییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.42,
   "end": 157.66,
   "text": "علم. نمیشه علم مجرد باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.66,
   "end": 163.22,
   "text": "صورت علمیه مجرد باشه بعد نفس ناطقه مجرد نباشه و بالعکس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.22,
   "end": 165.64,
   "text": "پس هر دو مجردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.64,
   "end": 170.16,
   "text": "اتفاقاً از همین جاها خیلی نکات زیادی اینجا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.16,
   "end": 172.8,
   "text": "استخراج کرد که فرصت ما متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.8,
   "end": 178.58,
   "text": "ضیقه و اجازه نمیده و الا از همین جا انسان متوجه میشه که اصلاً علم از ملکوت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.58,
   "end": 181.72,
   "text": "ما میریم پای درس، کتاب می‌خونیم اینا معدات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.72,
   "end": 183.52,
   "text": "علت معده‌اند طعمه نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.52,
   "end": 187.92,
   "text": "اون که از، اون که فهم رو به من و تو می‌رسونه، می‌چشونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.92,
   "end": 191.0,
   "text": "علم رو برای ما معلوم می‌کنه، ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.0,
   "end": 196.5,
   "text": "پای ملائک در میانه. خود حضرت واهب که اینجا هم علامه می‌فرماید و هم واهب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.5,
   "end": 200.86,
   "text": "واهب یعنی اون که عطا می‌کنه، هبه می‌کنه، علم رو به تو می‌چشونه و می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.86,
   "end": 204.52,
   "text": "اون هم دیگه جایگاهش مجرده تام و بالای بالا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.52,
   "end": 207.3,
   "text": "اینچنین. اتفاقاً مرحوم فارابی خدا رحمتشون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.3,
   "end": 209.9,
   "text": "ایشون یه کتابی دارن به نام فسوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.9,
   "end": 213.82,
   "text": "که علامه کتاب ایشون هم توضیح و شرح دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.82,
   "end": 220.1,
   "text": "نسوس بر فسوس. اونجا در کلم-- در فصل سی و یک دو تا دلیل بر تجرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.1,
   "end": 225.0,
   "text": "نفس ناطقه و این‌ها روح انسانی و این‌ها میاره که بالاخره اینا مراتب معرفت نفسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.0,
   "end": 227.98,
   "text": "ما وقتی نشناسیم خودمون رو علم رو پس می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.98,
   "end": 231.1,
   "text": "یا یه مقدار علم رو فرا گرفتیم میگیم بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.1,
   "end": 232.64,
   "text": "چرا؟ حالا الان عرض می‌کنم چرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.64,
   "end": 237.78,
   "text": "مریضیم. بلی موس گرفتیم به قول خود مرحوم فارابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.78,
   "end": 244.26,
   "text": "بلی موس هم یعنی قبلاً عرض کردیم یعنی معده از کار افتاده گشنه شه نمی‌دونه خبر نداره گرسنه شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.26,
   "end": 247.02,
   "text": "پس می‌زنه. مریضی. مریضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.02,
   "end": 249.36,
   "text": "و الا اگر ظرف انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.36,
   "end": 251.54,
   "text": "وعاء انسان، خود ظرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.54,
   "end": 255.0,
   "text": "نفس ناطقه انسان مجرده، پر شدنی نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.0,
   "end": 258.08,
   "text": "چرا تو پر شده وجودت؟ چرا میگی بسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.08,
   "end": 261.12,
   "text": "حالا اونجا در فصل سی و یک دو تا دلیل میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.12,
   "end": 262.8,
   "text": "بر تجرد نفس ناطقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.8,
   "end": 265.32,
   "text": "ببین چقدر قشنگ همه فهم هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.32,
   "end": 267.84,
   "text": "نگیم اخ، اخ، اخ این حرفا سنگینه ما نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 267.84,
   "end": 273.62,
   "text": "چرا نفهمیم به این راحتی. می‌فرماید چطوره که تو از آینده خبر میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.62,
   "end": 278.42,
   "text": "الان از آینده یه حدس قوی می‌زنی همونم مسابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.42,
   "end": 280.66,
   "text": "می‌خوره و اصابت می‌کنه. درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.66,
   "end": 283.6,
   "text": "یا نه. یه حقیقتی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.6,
   "end": 286.24,
   "text": "متوجه میشی که زمانش رفت تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 286.24,
   "end": 288.82,
   "text": "الان به شما میگن اون اتفاقی افتاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 288.82,
   "end": 292.54,
   "text": "دوباره ب-بگو ببینم چی بود؟ میگی زمانش تموم شده رفته که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 292.54,
   "end": 294.98,
   "text": "از حیث مادی طی شده رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 294.98,
   "end": 298.2,
   "text": "زمان طی شده. الان چگونه شما اون رو دوباره میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 298.2,
   "end": 302.3,
   "text": "اون حقیقت رو بیان می‌کنی. این پیداست که مادی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 302.3,
   "end": 303.94,
   "text": "دلیل دوم خیلی زیباتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 303.94,
   "end": 307.0,
   "text": "می‌فرماید چگونه است که تو جسمت اینجا افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 307.0,
   "end": 312.4,
   "text": "دیشب همتون عالم ملکوت تشریف داشتید بدون استثناء هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.4,
   "end": 316.08,
   "text": "اینکه میگن هپروت از ملکوت گرفته شده دیگه ساختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.08,
   "end": 319.12,
   "text": "حالا به قول ما هپروت ولی اصلش ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.12,
   "end": 323.54,
   "text": "یعنی چی حاج آقا؟ خب جسم من که تو عالم ملک بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 323.54,
   "end": 331.86,
   "text": "مرحوم فارابی علیه الرحمه می‌فرمود همین که تو از عالم ملکوت اخذ حقایقی کردی پیداست نفست مجرده رفته اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.86,
   "end": 335.38,
   "text": "بلکه هم قوی‌ترن یه عده از ملکوت هم می‌زنن میرن به جبروت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.38,
   "end": 338.42,
   "text": "حقایق عقلی کسب می‌کنند، عقلی کلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.42,
   "end": 347.1,
   "text": "که والا بحثش بماند. پس این نشون میده که نفس ناطقه مجرده، علم مجرده و بین علم و عالم و معلوم هم اتحاد هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 347.1,
   "end": 351.94,
   "text": "اینا همه یک حقیقت میشن. اصلاً تو همونی هستی که علم پیدا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 351.94,
   "end": 358.42,
   "text": "چیزی جز اون نیست. لذا قبلاً هم عرض کردیم بر اساس کتاب انسان در عرف عرفان علامه ما قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.42,
   "end": 362.16,
   "text": "اصلاً بعد از مرگ همونطور که الان یک نفس داریم، یک بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.16,
   "end": 364.88,
   "text": "اونجام اینطوریه قبلاً گفتیم چ-- یادته دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.88,
   "end": 366.24,
   "text": "نفسمون به شکل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 366.24,
   "end": 373.32,
   "text": "علممونه نفسمون، جانمون وقتی می‌میریم به شکل علوم و معارفیه که اخذ کردیم باورهامون، اعتقاداتمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.32,
   "end": 376.22,
   "text": "بدنمون به س-- به شکل اعمالمونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 376.22,
   "end": 378.44,
   "text": "بدنمون به شکل اعمالمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 378.44,
   "end": 384.84,
   "text": "و این نفس ناطقه مجرده خیلی به درد ما می‌خوره اینکه ما در این خصوص کار ب-- اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 384.84,
   "end": 389.7,
   "text": "حضرت استاد علامه حسن زاده علیه الرحمه یادمه در شرح فصوصشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.7,
   "end": 393.86,
   "text": "حدود مثلاً درسای بعد از صد جلسه صد و خورده‌ای بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 393.86,
   "end": 397.82,
   "text": "خیلی شیرین اشاره کردن به اون آ-- به اون حدیث قشنگ پی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 397.82,
   "end": 402.44,
   "text": "امیرالمؤمنین که \"کل وعاء یضيق بما جعل فیه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 402.44,
   "end": 405.48,
   "text": "همه ظرف‌ها از چیزی که توش می‌ذارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.48,
   "end": 409.32,
   "text": "ضیق می‌شن. مثلاً پارچ آبو ریختی توش پر شد دیگه ضیق شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.32,
   "end": 413.52,
   "text": "دیگه جا نداره. \"الا وعاء العلم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.52,
   "end": 416.4,
   "text": "مگر ظرف علم که \"یتسع به\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.4,
   "end": 419.36,
   "text": "هرچی علم می‌ریزی توش پو-- هی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 419.36,
   "end": 422.08,
   "text": "\"یتسع\". اتساعش بیشتر می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 422.08,
   "end": 424.28,
   "text": "وسعتش بیشتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.28,
   "end": 428.46,
   "text": "یعنی هرچی علم می‌ریزی تو، هرچی علم پیدا می‌کنی می‌بینی کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 428.46,
   "end": 430.7,
   "text": "حلم مزید بازم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 430.7,
   "end": 432.9,
   "text": "اینجاست که می‌گیم بر اساس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 432.9,
   "end": 435.56,
   "text": "ما اگر بگیم بسه حالا همین مدرک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 435.56,
   "end": 442.34,
   "text": "مثلاً لیسانس بسه، دکترا بسه، الان چهار تا کتابو خوندیم بسه، همین دو تا نماز خوندیم بسه یعنی مریضییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 442.34,
   "end": 445.38,
   "text": "چون نفس ناطقه چیه؟ مجرده عزیز دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 445.38,
   "end": 448.72,
   "text": "بلکه از علامه اینجا اشاره می‌کنه به این حدیث پی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 448.72,
   "end": 454.94,
   "text": "امیرالمؤمنین می‌فرماید بلکه نفس ناطقه انسان مقامش فوق تجرده، بالاتر از تجرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.94,
   "end": 460.12,
   "text": "حتی تا این حد. حتی اشاره می‌کنه به اون حدیث شریف \"اقرأ ورقة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 460.12,
   "end": 462.22,
   "text": "اقرأ ورقة\" بخوان و بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 462.22,
   "end": 465.14,
   "text": "قیامت میگن بخوان قرآن رو بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 465.14,
   "end": 468.62,
   "text": "الانم هست \"اقرأ ورقة\" الانم قرآن بخوان بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 468.62,
   "end": 474.0,
   "text": "خب شما بفرما ببینم قرآن رو بخوانی بالا بری، قرآن خودش از سمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 474.0,
   "end": 476.94,
   "text": "اصلاً حد یقف و تمام-- تمامی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 476.94,
   "end": 478.6,
   "text": "یک دریای لایتناهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 478.6,
   "end": 480.5,
   "text": "خودش میگه خودشو معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.5,
   "end": 483.6,
   "text": "\"ولا رطب ولا یابس الا في كتاب مبین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 483.6,
   "end": 486.94,
   "text": "عجب. هیچ تر و خشکی نیست مگر در قرآن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 486.94,
   "end": 489.48,
   "text": "خودش می‌فرماید. \"إنك\" میره بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.48,
   "end": 491.1,
   "text": "این تو نشئه طبیعت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 491.1,
   "end": 493.28,
   "text": "میگه تر و خشک. میره بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 493.28,
   "end": 497.5,
   "text": "میگه \"إنك لتلقى القرآن من لدن حكیم علیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 497.5,
   "end": 502.98,
   "text": "تو این قرآن را اخذ کردی از علم لدنی یعنی از ذات حضرت حق این قرآن منتج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 502.98,
   "end": 508.82,
   "text": "پس انتها نداره. پس چطوره اگه قرآن انتها نداره به ما میگه \"اقرأ ورقة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.82,
   "end": 513.96,
   "text": "بخوان و بالا برو. پس پیداست که ما نفس ناطقمون بفرمایید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.96,
   "end": 519.86,
   "text": "مجرد که بلکه فوق تجرد مقامش و انتها نباید داشته باشه که نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.86,
   "end": 522.24,
   "text": "ما ظرفمونو کوچولو نگه داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 522.24,
   "end": 527.6,
   "text": "ما به چهار تا حرف و اصطلاح و این‌ها حفظ کردن چهار تا حرف و اصطلاح بسنده کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 527.6,
   "end": 533.9,
   "text": "پوزیشین عالمم به خودمون گرفتیم و دکتر و مهندس فکر می‌کنیم دیگه تمام علم تو دست ماست، تو چنته ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 533.9,
   "end": 538.22,
   "text": "اینطوری نیست. اگر تمام این جمله رو گوش بدید تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 538.22,
   "end": 545.52,
   "text": "حضرت علامه فرمودن اونچه که می‌فرماید \"هو الذي باثف الأميين رسولا منهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 545.52,
   "end": 550.3,
   "text": "یعنی اگر تمام حکمای اندیشمندان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.3,
   "end": 553.64,
   "text": "همه آدمایی که صاحب عقول بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 553.64,
   "end": 559.68,
   "text": "همه رو جمع کنی یه جا، بزرگان اهل حکمت و عرفان و معرفت و عقل و تدبیر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 559.68,
   "end": 562.3,
   "text": "همه رو بریزی یک جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 562.3,
   "end": 564.86,
   "text": "باز پیغمبر تو اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.86,
   "end": 568.48,
   "text": "بخوای از اینا ورش داری بقیه نسبت به پیغمبر امین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 568.48,
   "end": 570.74,
   "text": "یعنی همه نمی-- هیچی نمی‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 570.74,
   "end": 576.08,
   "text": "همه رو پیغمبر می‌دونه. الله اکبر و ما پشت سر همچین کسی باید حرکت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 576.08,
   "end": 579.82,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 579.82,
   "end": 580.48,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}