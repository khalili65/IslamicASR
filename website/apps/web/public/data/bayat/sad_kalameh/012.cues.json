 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ یازدهم؛ معاش مادی وسیلهٔ مقامات معنوی",
   "start": 14.54,
   "end": 142.04
  },
  {
   "index": 1,
   "title": "مولا در خطبهٔ هشتاد و دو — که سید رضی از آن اظهار شگفتی کرده — می‌فرماید:",
   "start": 142.04,
   "end": 164.04
  },
  {
   "index": 2,
   "title": "### دنیا برای غیر خودش",
   "start": 164.04,
   "end": 307.62
  },
  {
   "index": 3,
   "title": "## مقامات نه حالات",
   "start": 307.62,
   "end": 466.22
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.88,
   "end": 6.22,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.22,
   "end": 10.08,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.08,
   "end": 14.54,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.54,
   "end": 18.94,
   "text": "کلمه یازدهم از صد کلمه در معرفت حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.94,
   "end": 22.84,
   "text": "می‌فرمایند آن که معاش مادی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.84,
   "end": 27.22,
   "text": "وسیله‌ی مقامات معنوی نگیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.22,
   "end": 29.96,
   "text": "سخت در خطاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.96,
   "end": 33.7,
   "text": "یه بار دیگه. آن که معاش مادی را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.7,
   "end": 39.08,
   "text": "این معایش، عیش، زندگی، معاش مادی را وسیله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.08,
   "end": 42.42,
   "text": "مقامات اونم نه حالات، مقامات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.42,
   "end": 47.36,
   "text": "معنوی نگیرد سخت در خطاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.36,
   "end": 53.2,
   "text": "اولین نکته‌ای که ازش برداشت می‌کنیم ذیل وسیله‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.2,
   "end": 58.22,
   "text": "که می‌فرمود این معاش مادی وسیله‌ست نه هدف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.22,
   "end": 61.84,
   "text": "متأسفانه وسیله که دیگه الان بدل شده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.84,
   "end": 64.34,
   "text": "هدف. معاش مادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.34,
   "end": 67.8,
   "text": "همین زندگی دنیوی، عیش، نوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.8,
   "end": 71.2,
   "text": "این‌ها همه شده وسیله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.2,
   "end": 74.26,
   "text": "خیلی ببخشید شده هدف برای خیلی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.26,
   "end": 79.3,
   "text": "البته برای قلیلی و قلیل من عبادی اش شکور که اهل شکرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.3,
   "end": 83.32,
   "text": "توجه دارن. اینا نه خوبه درسته نگاهشون درسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.32,
   "end": 86.34,
   "text": "اما متأسفانه اکثریت این شده براشون هدف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.34,
   "end": 89.46,
   "text": "لذا آدم می‌کشن که به این برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.46,
   "end": 92.14,
   "text": "حالا اینجا اجازه بفرمایید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.14,
   "end": 95.48,
   "text": "به نور کلام مولا متبرک کنیم جلسه‌مونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.48,
   "end": 101.32,
   "text": "مولامون علی علیه الصلاة و السلام در همین رابطه در خطبه هشتاد و دو ببینید چه فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.32,
   "end": 103.14,
   "text": "که حالا این رو من اجمالاً عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.14,
   "end": 105.6,
   "text": "تو اون بحث قلب منغمر اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.6,
   "end": 108.86,
   "text": "گفتیم که اینجا شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.86,
   "end": 113.44,
   "text": "سید رضی علیه الرحمه اظهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.44,
   "end": 117.36,
   "text": "تعجب و شگرفی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.36,
   "end": 121.86,
   "text": "ح-- میشه گفت حیرت کرده از این کلام مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.86,
   "end": 124.3,
   "text": "چیه مولا می‌فرماید \"و من أبصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.3,
   "end": 130.08,
   "text": "بها\". این وقتی از دنیا سخن میگه این به هاها اینجا برمی‌گرده به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.08,
   "end": 134.32,
   "text": "یعنی کسی که \"من أبصر بها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.32,
   "end": 137.62,
   "text": "کسی که نگاهش شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.62,
   "end": 141.14,
   "text": "آخرت اما با دنیا آخرت رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.14,
   "end": 145.16,
   "text": "خب؟ یعنی بها یعنی با دنیا آخرت رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.16,
   "end": 147.76,
   "text": "\"من أبصر\" کسی نگاه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 147.76,
   "end": 149.5,
   "text": "\"بها\" با دنیا آخرت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.5,
   "end": 152.18,
   "text": "یعنی چی؟ یعنی دنیا رو وسیله گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 152.18,
   "end": 157.28,
   "text": "تا به آخرت برسه. دنیا رو وسیله رسیدن به آخرتش قرار داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 157.28,
   "end": 162.76,
   "text": "\"بصرت هو\". چنین کسی بیناتر میشه، نگاهش عمیق‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.76,
   "end": 165.54,
   "text": "اما الله اکبر \"و من أبصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.54,
   "end": 170.82,
   "text": "إليها\". هرکس که نگاهش به دنیا شد نه بها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 170.82,
   "end": 174.1,
   "text": "بها نه یعنی با دنیا آخرت رو ببینه نه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 174.1,
   "end": 176.72,
   "text": "الیها فقط دنیا رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 176.72,
   "end": 178.86,
   "text": "فرمود \"أعمى هو\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 178.86,
   "end": 180.42,
   "text": "چنین کسی کور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 180.42,
   "end": 184.28,
   "text": "اصلاً نابینا شده. چقدر عبارت شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 184.28,
   "end": 187.3,
   "text": "چقدر اصلاً چی بگم آدم واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 187.3,
   "end": 191.36,
   "text": "گاهی آقا فقط آدم با روضه‌ها نباید با سر بره تو دیوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 191.36,
   "end": 197.14,
   "text": "با این دقایقی که حکمت‌هایی که در فرمایش مولاست باید با سر بره تو دیوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 197.14,
   "end": 200.62,
   "text": "چقدر عظمت داره اینجا واقعاً نگاه رو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 200.62,
   "end": 204.46,
   "text": "که چه نگاهی به ما میده. باز در خطبه دویست و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 204.46,
   "end": 209.34,
   "text": "مولا می‌فرماد \"ففيها اختبرتم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 209.34,
   "end": 211.56,
   "text": "اومدید تو این دنیا تا آزمایش بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 211.56,
   "end": 213.68,
   "text": "\"ففيها\" باز به دنیا میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 213.68,
   "end": 215.74,
   "text": "در دنیا \"اختبرتم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 215.74,
   "end": 220.38,
   "text": "اینجا شما آزمایش میشید. \"ولغيرها خلقتم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 220.38,
   "end": 222.52,
   "text": "شما خلق شدید برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 222.52,
   "end": 224.42,
   "text": "غیر از اون. غیر از چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 224.42,
   "end": 227.92,
   "text": "دنیا. شما برای دنیا خلق نشدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 227.92,
   "end": 230.5,
   "text": "شما برای چیز دیگه‌ای خلق شدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 230.5,
   "end": 234.42,
   "text": "متأسفانه چی بگیم؟ باز در نهج‌البلاغه ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 234.42,
   "end": 240.46,
   "text": "همش مولا علی. اصلاً بحث دنیا یکی از پرحرف‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 240.46,
   "end": 244.12,
   "text": "موضوعات در نهج‌البلاغه دنیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 244.12,
   "end": 246.3,
   "text": "و البته زهد. این دو تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 246.3,
   "end": 250.58,
   "text": "مولا فرمودند \"الدنيا خلقت لغيرها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 250.58,
   "end": 253.52,
   "text": "عجیب فرمایشیه آخه چی بگه آدم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 253.52,
   "end": 257.9,
   "text": "دنیا خلق شده-- یه حقیقتیه خلق شده برای یه حقیقتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 257.9,
   "end": 260.3,
   "text": "\"لخلقت لغيرها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 260.3,
   "end": 263.58,
   "text": "غیر خودش. یعنی دنیا برای خودش خلق نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 263.58,
   "end": 265.5,
   "text": "برای غیر خودش خلق شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 265.5,
   "end": 268.82,
   "text": "\"ولم تخلق لنفسها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 268.82,
   "end": 272.86,
   "text": "می-می‌فرماید نه خلق نشده برای نفس خوده، برای خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 272.86,
   "end": 275.82,
   "text": "که بعضیا اینو هدف قرار دادن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 275.82,
   "end": 277.52,
   "text": "صرفاً میخوان به دنیا برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 277.52,
   "end": 279.82,
   "text": "دنیا یه وسیله‌ست، یه پله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 279.82,
   "end": 282.9,
   "text": "\"إنما تنتقلون من دار إلى دار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 282.9,
   "end": 285.12,
   "text": "ما منتقل میشیم همونطور که از نشئه ماد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 285.12,
   "end": 292.3,
   "text": "که رحم مادر بود منتقل شدیم به این نشئه از اینجام در حال منتقل شدن هستیم به نشئه بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 292.3,
   "end": 296.38,
   "text": "و چه زشت و چقدر بد که آدم دل ببنده به اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 296.38,
   "end": 297.84,
   "text": "چقدر بده یه آدم مثلاً به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 297.84,
   "end": 303.52,
   "text": "پلی که داره از روش رد میشه بره مثلاً اونجا ابزار رو پیاده کنه که میخواد تا ابد رو این پل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 303.52,
   "end": 306.68,
   "text": "بفرمایید آقا یا الله حرکت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 306.68,
   "end": 309.1,
   "text": "این چ-- حالا نکته دیگه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 309.1,
   "end": 312.7,
   "text": "حالا متأسفانه وقت نیست ولی خیلی پرحرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 312.7,
   "end": 315.94,
   "text": "الانم اشاره میکنه به مقامات معنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 315.94,
   "end": 317.5,
   "text": "اینم خیلی نکته پرحرفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 317.5,
   "end": 319.92,
   "text": "می‌فرماید که این دنیا رو وسیله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 319.92,
   "end": 323.06,
   "text": "مقامات معنوی قرار بدین، نه حالات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 323.06,
   "end": 325.08,
   "text": "حالت میاد و میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 325.08,
   "end": 328.98,
   "text": "ما معمولاً آخرت رو با حالمون جمع می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 328.98,
   "end": 330.98,
   "text": "یعنی میگیم یه حالی بکنیم بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 330.98,
   "end": 333.94,
   "text": "مثلاً هیئت یه حالی بکنیم، یه حالی بهمون دست بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 333.94,
   "end": 336.02,
   "text": "بریم مـ-- مثلاً امام رضا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 336.02,
   "end": 339.5,
   "text": "حالی، یه عشقی. ولی دنیا رو دنبال مقاماتشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 339.5,
   "end": 343.3,
   "text": "برعکس شده دنیا. مقام جای ثبوته، استحکامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 343.3,
   "end": 346.42,
   "text": "ایستادنه، مقامه. قیام میکنی اونجا هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 346.42,
   "end": 350.64,
   "text": "جایی که امام معصوم داره که نماز قیام کرده اونجا میگن مقام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 350.64,
   "end": 353.58,
   "text": "ما دنیا رو مقام کردیم، دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 353.58,
   "end": 356.46,
   "text": "مقامات دنیا. اما آخرت رو حال کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 356.46,
   "end": 360.4,
   "text": "یه حالی بکنیم. لذا حالی به حالی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 360.4,
   "end": 364.76,
   "text": "همگی حالیم. یه حالی بکنیم بریم نماز، یه حالی بکنیم بریم هیئت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 364.76,
   "end": 367.86,
   "text": "برنامه‌ای نداریم برای مقامات معنوی‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 367.86,
   "end": 373.06,
   "text": "مثلاً از این نماز به مقا-- نماز بعدی پل بزنیم به مقام برسیم، به رتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 373.06,
   "end": 375.62,
   "text": "از این زیارتمون به اون زیارت فرق کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 375.62,
   "end": 377.56,
   "text": "این هیئتمون به اون یکی هیئت فرق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 377.56,
   "end": 381.08,
   "text": "اصلاً هیئت‌ها هیچ دیباچه‌ای دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 381.08,
   "end": 386.0,
   "text": "می‌شینن بررسی کنن الان ده سال، بیست سال، سی سال این هیئت از کجا به کجا رسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 386.0,
   "end": 387.98,
   "text": "منبرهاش سیری داشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 387.98,
   "end": 391.18,
   "text": "الان یه آقایی تو این دانشگاه این هیئت رشد کردن به کجا رسیدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 391.18,
   "end": 395.72,
   "text": "یه امتا-امتحان بگیرن. ما الان اینجا داریم پنج ساله داریم ورراجی می‌کنیم برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 395.72,
   "end": 398.26,
   "text": "ببخشید حرافی می‌کنیم. چی شد آخرش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 398.26,
   "end": 400.7,
   "text": "برای خودم، از خودمم امتحان بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 400.7,
   "end": 406.32,
   "text": "حالا این مقامات خیلی حالا من بررسی می‌کردم عرض کنم برای اینکه مستند کنم بحث رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 406.32,
   "end": 412.38,
   "text": "شیخ عبدالله محمد انصاری، ابن محمد انصاری در منازل الصائرین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 412.38,
   "end": 414.46,
   "text": "کتاب شیرینیه. جلد یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 414.46,
   "end": 418.7,
   "text": "اونجا یه جمله‌ای میاره می‌فرماید \"والاحوال مواهب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 418.7,
   "end": 422.76,
   "text": "والمقامات مكاسب\". مقامات رو خودت باید بری کسب کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 422.76,
   "end": 426.36,
   "text": "سهم-- زحمت بکشی. \"أليس للإنسان إلا ما سعي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 426.36,
   "end": 428.54,
   "text": "باید تلاش کنی. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 428.54,
   "end": 430.4,
   "text": "حالات مواهب الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 430.4,
   "end": 433.02,
   "text": "میاد نفخه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 433.02,
   "end": 435.22,
   "text": "یه نسیم رحمته میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 435.22,
   "end": 437.9,
   "text": "اون دیگه دست تو نیست. میره-- برای چی میره دنبال حال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 437.9,
   "end": 441.6,
   "text": "اون حالو خدا میده. تو دنبال سیر مقامات باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 441.6,
   "end": 447.62,
   "text": "کشف مقامات باش. که شیخ الز-- شیخ عزالدین کاشانی هم تو مِثوا الهدایه‌ش اینو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 447.62,
   "end": 451.48,
   "text": "\"الحال نازلة تنزل بالقلب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 451.48,
   "end": 456.2,
   "text": "حال نازل میشه توسط حضرت حق به قلب \"ولا تدوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 456.2,
   "end": 461.24,
   "text": "دوام هم نداره. انقدر دنبال حال نباشین، دنبال اون مقام ثبوت باشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 461.24,
   "end": 462.94,
   "text": "ان شا الله عاقبت بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 462.94,
   "end": 466.22,
   "text": "به برکت صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}