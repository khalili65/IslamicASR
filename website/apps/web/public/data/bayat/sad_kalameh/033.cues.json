 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ سی‌ودو؛ قرآن صورت کتبیهٔ انسان کامل",
   "start": 0.32,
   "end": 32.12
  },
  {
   "index": 1,
   "title": "## سه کتاب؛ آفاقی و انفسی و قرآنی",
   "start": 32.12,
   "end": 72.4
  },
  {
   "index": 2,
   "title": "## تبیان کل شیء و امام مبین",
   "start": 72.4,
   "end": 453.46
  },
  {
   "index": 3,
   "title": "## شاهراه معرفت نفس؛ طب و نفس ناطقه",
   "start": 453.46,
   "end": 556.48
  },
  {
   "index": 4,
   "title": "## قوس نزول و صعود",
   "start": 556.48,
   "end": 576.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.32,
   "end": 7.38,
   "text": "و بهین استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.38,
   "end": 11.6,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.6,
   "end": 16.36,
   "text": "اگر چنانچه خاطرتون باشه قبل از ماه مبارک رمضان بحث ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.36,
   "end": 25.42,
   "text": "در рамون صد کلمه در معرفت نفس از تا استاد علامه حسن زاده علیه الرحمه بود تا س- کلمه سی و یکم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.42,
   "end": 27.44,
   "text": "اجمالاً البته توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.44,
   "end": 29.9,
   "text": "می‌رسیم به کلمه سی و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.9,
   "end": 33.44,
   "text": "آن که در معرفت انسان و قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.44,
   "end": 38.04,
   "text": "توقل کند یعنی عمیق بشه، تفکر عمیق کنه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.04,
   "end": 41.38,
   "text": "معرفت انسان و قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.38,
   "end": 43.86,
   "text": "به یه حقیقتی می‌رسه. اون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.86,
   "end": 48.94,
   "text": "قرآن را صورت کتبیه انسان کامل شناسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.94,
   "end": 54.88,
   "text": "و نظام هستی را صورت عینیه او یابد که قبلاً هم این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.88,
   "end": 56.44,
   "text": "اجمالاً توضیح داده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.44,
   "end": 60.8,
   "text": "می‌دونید که خب عزیزی که کار فکری می‌کنند ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.8,
   "end": 63.9,
   "text": "چهار نوع وجود داریم یا صورت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.9,
   "end": 67.12,
   "text": "وجود عینی یا خارجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.12,
   "end": 68.94,
   "text": "که بر می‌گرده به عینیّت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.94,
   "end": 74.44,
   "text": "مثلاً خود من یک وجود عینی دارم که در خارج هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.44,
   "end": 75.98,
   "text": "خارج از ذهن وجود دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.98,
   "end": 79.6,
   "text": "این یک وجود. یه وجود، وجود ذهنیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.6,
   "end": 85.16,
   "text": "که شما ذهنیتی که نسبت به یک موجودی داری به اون عینیّت داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.16,
   "end": 88.38,
   "text": "در ذهنت علمت به اون وجود چی-- چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.38,
   "end": 91.22,
   "text": "چیه؟ اینم یه وجود. یه وجود لفظیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.22,
   "end": 94.34,
   "text": "بالاخره هر شیی یه اسمی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.34,
   "end": 96.52,
   "text": "مثلا اسم من چیه؟ علی اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.52,
   "end": 99.46,
   "text": "این بهش میگن چی؟ وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.46,
   "end": 102.98,
   "text": "چی؟ لفظی یا صورت لفظیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.98,
   "end": 104.86,
   "text": "یه وجودم، وجود کتبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.86,
   "end": 107.16,
   "text": "حالا شما بخواهی منو بنویسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 107.16,
   "end": 110.36,
   "text": "روی یک مثلاً کتابی ترجمه‌ام کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 110.36,
   "end": 112.66,
   "text": "اون میشه وجود کتبی من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 112.66,
   "end": 115.96,
   "text": "شما اگر سیر معرفت نفس رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 115.96,
   "end": 121.94,
   "text": "با دستورات و آموزه‌های از تا استاد جلو پیش بری قشنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 121.94,
   "end": 126.24,
   "text": "بری جلو درست حسابی درست و درمان پیش بگیری بری جلو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 126.24,
   "end": 129.44,
   "text": "دروس خود و قلم آسا خود استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 129.44,
   "end": 131.88,
   "text": "به جایی می‌رسی که می‌بینی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 131.88,
   "end": 135.2,
   "text": "انسان کامل اون صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 135.2,
   "end": 137.48,
   "text": "کتبیش قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 137.48,
   "end": 140.8,
   "text": "یعنی اگر انسان کامل امام عصر بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 140.8,
   "end": 144.02,
   "text": "کتاب بشه میشه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 144.02,
   "end": 148.52,
   "text": "و صورت عینی یا خارجیش نظام هستیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 148.52,
   "end": 155.08,
   "text": "لذا قرآن به شدت تاکید داره در خوانش این کتاب‌ها، کتاب آفاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 155.08,
   "end": 161.16,
   "text": "و فی عرض شود \"في الأرض آيات للموقنين\" این کتاب آفاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 161.16,
   "end": 166.76,
   "text": "\"و في أنفسكم\" این کتاب انفسی \"أفلا تبصرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 166.76,
   "end": 172.3,
   "text": "این دو تا کتاب رو و کتاب عینی که خود قرآنه \"واتل القرآن ترتيلا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 172.3,
   "end": 173.9,
   "text": "تا می‌تونی قرآن رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 173.9,
   "end": 177.24,
   "text": "\"فاقرؤا ما تيسر من القرآن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 177.24,
   "end": 181.76,
   "text": "قرآن رو قرائت کنید. هیچ چاره‌ای جز خوانش این کتاب‌ها ما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 181.76,
   "end": 184.98,
   "text": "حالا چقدر چه میزان ما این کتاب‌ها رو خوندیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 184.98,
   "end": 189.34,
   "text": "کتاب انفسیمون که منجر میشه به شناخت اون کتاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 189.34,
   "end": 194.32,
   "text": "کتاب آفاقی که صورت عینی امام عصره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 194.32,
   "end": 196.94,
   "text": "کتاب کتبی قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 196.94,
   "end": 198.66,
   "text": "که صورت کتبی امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 198.66,
   "end": 201.94,
   "text": "چه میزان ما خوندیم؟ چقدر از این کتاب‌ها آگاهی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 201.94,
   "end": 208.38,
   "text": "و چقدر اخبار و اطلاعات بیخود که اصلا سی شایم به دردمون تو زندگی نمی‌خوره داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 208.38,
   "end": 211.56,
   "text": "به قول رهبر عزیزمون مثلا رونالدو رو می‌بینی یک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 211.56,
   "end": 214.8,
   "text": "یه زمانی فرمودن همه می‌شناسن و حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 214.8,
   "end": 217.84,
   "text": "چند تا گل زده. چه-چیکار کرده فلان اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 217.84,
   "end": 220.14,
   "text": "حتی شماره شناسنامه‌شم شاید بعضی جوونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 220.14,
   "end": 222.9,
   "text": "حفظ باشن اما چیزایی که به درد بخوره نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 222.9,
   "end": 225.04,
   "text": "مثلا یک مرحوم شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 225.04,
   "end": 229.64,
   "text": "کاظمی آشتیانی رو خود رهبر فرمودن چطور اینو کسی رو نمی‌شناسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 229.64,
   "end": 234.38,
   "text": "اون مبدع و متفکر سلول‌های ب-بنیادین بند ناف اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 234.38,
   "end": 237.92,
   "text": "چرا نباید ما بشناسیم؟ چرا این گرفتاری از کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 237.92,
   "end": 241.44,
   "text": "از اینکه فاصله گرفتیم از بزرگانمون، از آثار اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 241.44,
   "end": 246.14,
   "text": "یکی هم که میاد چون بالاخره حرف، حرف عرشیه، کلماتشون سنگینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.14,
   "end": 247.76,
   "text": "آثارشون قطعیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 247.76,
   "end": 251.36,
   "text": "فصل الخطابه، فصله، تفصیله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 251.36,
   "end": 255.54,
   "text": "برهانه، قاطعه، برنده است، علمه، روشنگره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 255.54,
   "end": 259.92,
   "text": "حجته. این جوری نیست که حالا، حالا شاید ظاهراً آقا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 259.92,
   "end": 262.7,
   "text": "از اینجا مطلع هستی ظاهراً اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 262.7,
   "end": 265.5,
   "text": "این از بیچارگی ماست به قول علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 265.5,
   "end": 268.7,
   "text": "این علم قطعی نیست. فصل الخطاب کلام اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 268.7,
   "end": 272.98,
   "text": "قطعیه. یعنی برگرفته از آیات روایات ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 272.98,
   "end": 276.54,
   "text": "فصل الخطابه. اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 276.54,
   "end": 278.62,
   "text": "اگر توجه داشته باشید در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 278.62,
   "end": 282.82,
   "text": "کتاب شریف انسان، انسان کامل حضرت استاد اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 282.82,
   "end": 290.84,
   "text": "علامه حسن زاده اشاره به این آیه می‌کنند که \"ونزلنا الیک الكتاب تبیانا لكل شیء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 290.84,
   "end": 294.18,
   "text": "الله اکبر. \"تبیانا لكل شیء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 294.18,
   "end": 297.28,
   "text": "این کتاب، این قرآنی که ما ازش بی‌خبریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 297.28,
   "end": 300.02,
   "text": "از همه چی پرده‌برداری کرده و می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 300.02,
   "end": 302.42,
   "text": "\"تبیانا لكل شیء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 302.42,
   "end": 305.16,
   "text": "و تبیان حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 305.16,
   "end": 309.22,
   "text": "\"لکل شیء\" که اینجاست بخواهیم هم وزنشو بگیریم اونجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 309.22,
   "end": 311.54,
   "text": "پیغمبر تو مسجد نشسته بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 311.54,
   "end": 313.38,
   "text": "سلمان و حالا صحابه نشسته‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 313.38,
   "end": 315.68,
   "text": "این روایت مشهور رو چند بار با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 315.68,
   "end": 318.0,
   "text": "توجه کردیم بهش خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 318.0,
   "end": 321.74,
   "text": "وقتی اون آیه \"و کل شیء احصیناه فی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 321.74,
   "end": 325.58,
   "text": "امام مبین\" رو تو surah یasin باید باشه ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 325.58,
   "end": 330.36,
   "text": "پیغمبر قرائت کردن همه \"کل شیء احصیناه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 330.36,
   "end": 333.34,
   "text": "این احصا از نوع اجمال نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 333.34,
   "end": 337.32,
   "text": "بگیم حالا مثلاً قوه است، استعداده رفته، رفته می‌رسه به کمالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 337.32,
   "end": 339.54,
   "text": "نه \"احصیناه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 339.54,
   "end": 343.86,
   "text": "خط، خط نوشته شده یعنی به نحو، به نحو تفصیل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 343.86,
   "end": 347.7,
   "text": "تفصیلاً، اجمال نه تمام به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 347.7,
   "end": 351.04,
   "text": "کل تبیان کل شیء همه چی درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 351.04,
   "end": 354.32,
   "text": "\"احصیناه کذا فی امام مبین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 354.32,
   "end": 358.98,
   "text": "گفتن امام مبین کیه؟ یکی گفت اینه، یکی اونه اسم اونا رو آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 358.98,
   "end": 361.28,
   "text": "اون ملعون‌ها رو آوردن فلانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 361.28,
   "end": 365.04,
   "text": "گفت نه پیغمبر نه سلمان که زیرک بود تا امیرالمؤمنین وارد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 365.04,
   "end": 368.9,
   "text": "حالا دو جور روایت شده، یکی میگن سلمان نشا-اشاره کرد به مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 368.9,
   "end": 371.66,
   "text": "ایشون میگه پیغمبر خودش با انگشت مولا علی رو نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 371.66,
   "end": 374.02,
   "text": "فرمود \"خذا امام المبین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 374.02,
   "end": 376.52,
   "text": "یعنی همه چی در او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 376.52,
   "end": 380.36,
   "text": "احسن اهو. قرآن هم همه چی در او احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 380.36,
   "end": 382.44,
   "text": "لذا تبیان کل شیء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 382.44,
   "end": 387.62,
   "text": "حالا قبلاً ما بر-- عرض کرده بودیم که ما خود وجود ما نفس ناطقه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 387.62,
   "end": 393.08,
   "text": "یه حالت مندمج شده‌ای، کلیتی، اجمالی از این قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 393.08,
   "end": 397.5,
   "text": "و اون عرض شود مقامات عالیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 397.5,
   "end": 399.74,
   "text": "انسانی رو به خودش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 399.74,
   "end": 401.42,
   "text": "یعنی ما هم در طول اون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 401.42,
   "end": 404.44,
   "text": "ما هم شعون، شعون او هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 404.44,
   "end": 410.66,
   "text": "جدایی از اون نیستیم. متاسفانه چون از خودمون بی‌خبریم از قرآن هم بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 410.66,
   "end": 413.9,
   "text": "شب قدر قرآن رو سر می‌ذاری علامه میگه قرآن به دل کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 413.9,
   "end": 417.88,
   "text": "یعنی اینو داری تطبیق میدی اون قرآن رو با درون خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 417.88,
   "end": 419.6,
   "text": "اون علم قطعیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 419.6,
   "end": 422.32,
   "text": "بزرگان ما علمشون قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 422.32,
   "end": 424.58,
   "text": "بیچاره‌گی ماست که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 424.58,
   "end": 429.8,
   "text": "فتوای بسیار-- شما مرجعی رو پیدا نمی‌کنید که مثلاً بگه اقوا این است نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 429.8,
   "end": 434.78,
   "text": "ولی مثلاً ظاهراً این است یا احتیاط کنید احتیاط یا چه واجب چه مستحب هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 434.78,
   "end": 436.58,
   "text": "احتیاط برای چی میگه احتیاط؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 436.58,
   "end": 439.46,
   "text": "چون از علم قطعی بی‌خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 439.46,
   "end": 442.14,
   "text": "این هم از بیچاره‌گی ماست. بیچاره‌گی نفس ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 442.14,
   "end": 445.86,
   "text": "جدایی و دوری ما از امام و حجت زمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 445.86,
   "end": 448.92,
   "text": "که \"و کل شیء احسن اهو فی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 448.92,
   "end": 455.08,
   "text": "امام مبین\". همه‌ی این‌ها عزیزان خسته‌تون نکنم از این شاهراه از کجا می‌گذره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 455.08,
   "end": 462.16,
   "text": "از معرفت نفس. علامه داره میگه آقا تا خودت رو نشناسی یک، امامت رو نمی‌شناسی دو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 462.16,
   "end": 466.28,
   "text": "قرآن رو نمی‌شناسی سه، نظام آفاقی رو نمی‌شناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 466.28,
   "end": 472.36,
   "text": "\"و فی الارض آیات للموقنین\" یعنی آیه های الهین \"و فی انفسکم\" درون خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 472.36,
   "end": 474.44,
   "text": "\"افلا تبصرون\" چرا نگاه نمی‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 474.44,
   "end": 477.98,
   "text": "آیه قرآنه. تا این‌ها را نشناسی از خودت بی‌خبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 477.98,
   "end": 481.12,
   "text": "تا از خودت بی‌خبری از همه جا بی‌خبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 481.12,
   "end": 486.46,
   "text": "لذا مرحوم الاخوینی حالا معروف به ابوبکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 486.46,
   "end": 489.58,
   "text": "ربیع بن بهش میگن احمد بن احمد معروفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 489.58,
   "end": 493.32,
   "text": "یه کتابی داره هدایت المتعلمین في الطب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 493.32,
   "end": 495.76,
   "text": "حالا عزیزانی که تو طب کار می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 495.76,
   "end": 499.96,
   "text": "می‌دونید ایشون اونجا خیلی به پسرش توصیه می‌کنه به جگرگوشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 499.96,
   "end": 502.32,
   "text": "بسیاری از-- خود علامه حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 502.32,
   "end": 503.88,
   "text": "خیلی توصیه دارن به طب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 503.88,
   "end": 506.58,
   "text": "میگن طب یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 506.58,
   "end": 509.4,
   "text": "زیل اسم طبيب خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 509.4,
   "end": 511.94,
   "text": "تعریف شده. اسم الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 511.94,
   "end": 515.84,
   "text": "ما باید آگاهی داشته باشیم. میگه طب مربوط به ظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 515.84,
   "end": 519.06,
   "text": "انزل مراتب نفس ناطقه که بدنته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 519.06,
   "end": 524.38,
   "text": "میگه واجبه که بری بخشی از طب رو حالا نه با اون سطح تخصصم رو یاد بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 524.38,
   "end": 529.22,
   "text": "که مریض نشی، حالت بد نشه، مزاجت به هم بریزه، همه چیت به هم می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 529.22,
   "end": 533.7,
   "text": "بعد میگه چطور که انزل مراتب نفس ناطقه که بدنته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 533.7,
   "end": 538.98,
   "text": "بزرگان، حکما و عرفا واجب دونستن که بدی-- بری طب رو یاد بگیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 538.98,
   "end": 541.12,
   "text": "مزاج شناسی رو یاد بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 541.12,
   "end": 543.86,
   "text": "که زندگیت به هم نریزه، به هم نپیچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 543.86,
   "end": 548.9,
   "text": "بعد اون اصل وجودت که نفس ناطقته بی‌خبر باشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 548.9,
   "end": 550.68,
   "text": "ندونی تو کی هستی؟ چی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 550.68,
   "end": 553.34,
   "text": "از کجا اومدی؟ به کجا اومدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 553.34,
   "end": 555.84,
   "text": "برای چی اومدی و به کجا میری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 555.84,
   "end": 563.76,
   "text": "نفهمی انا لله در قوس نزول یعنی چی و انا الیه راجعون قر-- در قوس صعود یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 563.76,
   "end": 565.72,
   "text": "نفهمی این خطاب به توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 565.72,
   "end": 567.76,
   "text": "بیچاره می‌شیم که شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 567.76,
   "end": 569.38,
   "text": "انشاالله خدا آقامون رو برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 569.38,
   "end": 574.06,
   "text": "عاقبتمون خیر بشه. به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 574.06,
   "end": 576.46,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}