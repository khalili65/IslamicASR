 ],
 "cues": [
  {
   "i": 0,
   "start": 2.72,
   "end": 5.64,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.64,
   "end": 9.4,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.4,
   "end": 13.8,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.8,
   "end": 17.08,
   "text": "می‌رسیم سراغ کلمه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.08,
   "end": 20.92,
   "text": "شصتم از صد کلمه در معرفت نفس از استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.92,
   "end": 24.26,
   "text": "کلمه شصتم. می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.26,
   "end": 27.66,
   "text": "آنکه نفس آگاه دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.66,
   "end": 31.9,
   "text": "روی دل را با الله دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.9,
   "end": 35.3,
   "text": "رویش رو می‌کنه به خدا. اونم به الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.3,
   "end": 39.1,
   "text": "چون دل به گونه‌ای خلق شده، دل انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.1,
   "end": 42.7,
   "text": "که می‌تونه آینه‌ی تمام‌نمای حضرت حق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.7,
   "end": 47.5,
   "text": "الله هم که اسم جامع یعنی می‌تونه اسماء الهی رو در خودش پیاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.5,
   "end": 50.54,
   "text": "یعنی کسی که خبر داشته باشه بدونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.54,
   "end": 55.58,
   "text": "که خدای منّان او رو چگونه خلق کرده، خبر داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.58,
   "end": 58.98,
   "text": "به وزان خودش در ذات و صفات و افعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.98,
   "end": 63.3,
   "text": "رو به الله می‌کنه. یعنی به کم راضی نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.3,
   "end": 67.48,
   "text": "رو به الله می‌کنه که این رو به الله کردن رو الان عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.48,
   "end": 72.22,
   "text": "کلمه رو تموم کنیم توضیح میدم که همون مقام حضوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.22,
   "end": 74.88,
   "text": "یعنی خودش رو در محضر حضرت حق می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.88,
   "end": 78.06,
   "text": "و فرمود کشاف حقایق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.06,
   "end": 83.92,
   "text": "امام به حق ناطق جعفر صادق علیه السلام که راک این حدیث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.92,
   "end": 87.74,
   "text": "فرموده حضرت صادق رو حضرت علامه می‌فرماید که حلقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.74,
   "end": 89.8,
   "text": "گوش خودش می‌کنه. کدomo؟ این حدیث رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.8,
   "end": 96.92,
   "text": "یادش بخیر، یه بار که محضر حضرت استاد رسیدیم و از ایشون بنده تقاضا کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.92,
   "end": 104.94,
   "text": "در اتاق شخصیشون بودیم ازشون خواهش کردم که یه هدیه‌ای به بنده بده تا آخر عمرم بسم باشه همین حدیث رو و بعد از خط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.94,
   "end": 108.28,
   "text": "قشنگشون مرقوم فرمودن و به بنده دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.28,
   "end": 112.18,
   "text": "و و اون شد باب برکات اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.18,
   "end": 115.22,
   "text": "تحقیق پیرامون قلب در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.22,
   "end": 119.56,
   "text": "که بیش از شصت نوع قلب از قرآن استخراج کردیم و بعد الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.56,
   "end": 121.78,
   "text": "جلسه حالا نمیدونم چهارصد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.78,
   "end": 125.36,
   "text": "چهل و پنج شش این حدودا هستیم تازه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.36,
   "end": 129.36,
   "text": "هنوز شاید بیست تا مثلا قلب رو گفته باشیم این حدودا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.36,
   "end": 133.26,
   "text": "برکت این. این حدیث چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.26,
   "end": 136.02,
   "text": "حالا فکر کنید علامه این حدیث رو به شما هم هدیه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.02,
   "end": 139.32,
   "text": "امروز پای درس ایشون نشستید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.32,
   "end": 143.74,
   "text": "القلب حرم الله ولا تسکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.74,
   "end": 146.62,
   "text": "فی حرم الله غیر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.62,
   "end": 150.2,
   "text": "البته در بعضی منابع دیدم این فی رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.2,
   "end": 153.92,
   "text": "یعنی القلب حرم الله فلا تسکن حرم الله غیر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.92,
   "end": 156.24,
   "text": "دو تاش هم وارد شده در بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.24,
   "end": 160.88,
   "text": "ما. حالا یعنی چی؟ یعنی قلب، قلب تو حرم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.88,
   "end": 163.52,
   "text": "تو حرم خدا غیر خدا رو راه نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.52,
   "end": 166.74,
   "text": "ولا تسکن فی حرم الله غیر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 166.74,
   "end": 171.38,
   "text": "یعنی این دل می‌شه آینه‌ی تمام‌نمای الله که اسم جامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.38,
   "end": 174.08,
   "text": "چگونه می‌شود به الله رو کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 174.08,
   "end": 181.3,
   "text": "یعنی چی آقا؟ من أتا کن نجا و لم ی-- ومن لم یأت کن هلک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.3,
   "end": 184.22,
   "text": "نجات در رو کردن به اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.22,
   "end": 191.64,
   "text": "ذکرنا ذکر الله. هرکس که اراده خدا رو کنه متوجه شما می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.64,
   "end": 195.3,
   "text": "هرکس که قصد الهی کنه به شما رو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.3,
   "end": 199.56,
   "text": "یابو الخلق الیکم مثلا. اصلاً إنا لله وإنا إليه راجعون یعنی او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.56,
   "end": 202.6,
   "text": "لذا پیغمبر فرمود من رآنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.6,
   "end": 204.92,
   "text": "هرکس که منو دید الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.92,
   "end": 207.88,
   "text": "کیو دیده؟ فقط رأى الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 207.88,
   "end": 211.2,
   "text": "رأى الله. هرکی منو دید الله رو دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.2,
   "end": 213.86,
   "text": "الله بالاخره مصداق عینی می‌خواد یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.86,
   "end": 217.94,
   "text": "می‌شه اسم خدا که اگرچه اسم جامع اما پیاده نشه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 217.94,
   "end": 219.66,
   "text": "نظام عالم؟ نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 219.66,
   "end": 223.22,
   "text": "اسم باید پیاده بشه. مجری می‌خواد، ظهور می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.22,
   "end": 229.82,
   "text": "یکی از دلایلی که ما می‌گیم آقا قطعاً در هر زمانی حجت حق با بدن عنصریش حاضره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.82,
   "end": 235.06,
   "text": "که الان امام عصره که تنزل الملائکه والروح بر او رخ می‌ده شبای قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.06,
   "end": 237.74,
   "text": "همینه. باید اسم جامع پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.74,
   "end": 242.48,
   "text": "در کی؟ در انسان کامل که قلبش می‌شه اون آینه‌ی تمام‌نما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 242.48,
   "end": 245.34,
   "text": "ما این رو در وجودمون داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 245.34,
   "end": 249.6,
   "text": "سیر نکردیم، سالک الی الله نشدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 249.6,
   "end": 253.42,
   "text": "لذا خیلی کوتوله ببخشید، کوتوله موندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.42,
   "end": 255.58,
   "text": "که به قول شیخ الرئیس اکثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.58,
   "end": 258.94,
   "text": "مردم عقل این‌ها صبیان العقول‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 258.94,
   "end": 260.52,
   "text": "اکثراً بچه عقل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 260.52,
   "end": 264.22,
   "text": "عقلشون رو برای همون حد کوچیک و نوزادی نگه داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.22,
   "end": 269.3,
   "text": "صرفاً به بدنشون پرداختن. این حدیث رو که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 269.3,
   "end": 274.46,
   "text": "اینجا منبعش رو حضرت استاد که نیاورده اما در خیلی منابع مثل جامع الأخبار هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.46,
   "end": 277.18,
   "text": "بهار جلد شصت و هفت صفحه بیست و پنج هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.18,
   "end": 279.6,
   "text": "کمال الأخلاق باب چهل و سه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.6,
   "end": 284.3,
   "text": "زیاد، خیلی روایات، خیلی در کتاب‌های بزرگان بهش پرداختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.3,
   "end": 288.26,
   "text": "حالا این چه مشخصه‌ای داره کسی که قلبش شد حرم خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 288.26,
   "end": 293.48,
   "text": "اینم از یک با یک تیزبینی امروز از یه روایتی درش بیاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.48,
   "end": 300.56,
   "text": "قطعاً کسی که قلبش شد حرم الله یعنی غیر الله رو در قلبش جایی نداد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.56,
   "end": 303.3,
   "text": "اون بهترین قلبه. اینو قبول دارید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.3,
   "end": 309.68,
   "text": "حالا خصوصیت بهترین قلب که به یک معنا همون قلب سلیمه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.68,
   "end": 314.76,
   "text": "یه روایت تقدیم می‌کنم. میزان الحکمة حدیث شونزده هزار نهصد و سیزده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.76,
   "end": 318.84,
   "text": "حدیث نبوی است. پیغمبر از اول چون فرصت نیست که عربیشو نخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.84,
   "end": 326.02,
   "text": "خداوند در روی زمین ظرف‌هایی دارد که عبارت است از این دل‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.02,
   "end": 328.78,
   "text": "دل‌ها ظرف‌های مـ-- خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.78,
   "end": 333.52,
   "text": "یعنی خدا در هر دلی به اندازه‌ی اون دل ظهور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.52,
   "end": 335.96,
   "text": "مثلا دل حرم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.96,
   "end": 338.58,
   "text": "حرم‌ها محل حضورند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.58,
   "end": 341.8,
   "text": "محل حضور حالا نسبت به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.8,
   "end": 343.78,
   "text": "صاحب اون بقعه و بارگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 343.78,
   "end": 348.78,
   "text": "چه ظرفیت وجودی و چه سعتی داشته، همون مقدار خدا اونجا ظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 348.78,
   "end": 351.94,
   "text": "حالا مثلا حضرت عبدالعظیم تهرانی‌ ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 351.94,
   "end": 355.1,
   "text": "چه عظمت وجودی داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 355.1,
   "end": 358.52,
   "text": "که کسی زیارتش کنه که الان امام حسین رو زیارت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 358.52,
   "end": 362.28,
   "text": "اینا دیگه ربط‌هاشو شما باید پیدا کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 362.28,
   "end": 366.28,
   "text": "خب حالا فرمودن که بهترین این ظرف‌ها نزد خداوند چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 366.28,
   "end": 369.72,
   "text": "تو این حدیث یعنی این دل‌ها بهترینش کدوماست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.72,
   "end": 373.74,
   "text": "که میشه همون حرم قلبه‌شو کرده حرم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.74,
   "end": 379.66,
   "text": "جز خدا راه نداده. سه تا خصوصیت اینجا پیغمبر عظیم الشأن اسلام برشمرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 379.66,
   "end": 387.08,
   "text": "این نشون میده که این سه تا خصوصیت مال کسیه که اون قلبش و همون حرم الله دست نخورده باقی نگه داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 387.08,
   "end": 391.86,
   "text": "اول فرمود دل نازک اند، نازک دلشون نسبت به دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.86,
   "end": 396.0,
   "text": "یعنی زود به رحم میاد، شفقت دارن، خیرخواه و ناصح دیگرانن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 396.0,
   "end": 398.74,
   "text": "بد کسی رو نمیخوان. خیرشون به همه میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.74,
   "end": 401.06,
   "text": "حالا این ترجمه‌هاییه که من دارم ازش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.06,
   "end": 408.64,
   "text": "خلاصه تو روایت می‌فرماید که نسبت به دیگران نازک دل‌اند، نرمه دلشون قلب لنگ یا لئن که دیروز بحثش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.64,
   "end": 410.92,
   "text": "قلبشون نرمه، خشونتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.92,
   "end": 413.34,
   "text": "مگر أشد على الكفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.34,
   "end": 415.02,
   "text": "در غیر این صورت نازک‌ دln.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 415.02,
   "end": 418.98,
   "text": "دوم فرمود پاکه، دلشون پاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 418.98,
   "end": 421.18,
   "text": "یعنی غش و غلی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 421.18,
   "end": 424.04,
   "text": "قلبشون نیست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.04,
   "end": 426.54,
   "text": "دلشون زنگار نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 426.54,
   "end": 431.0,
   "text": "با قرآن، با نماز شب، با اشک، با آه این زنگارها رو شستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.0,
   "end": 437.2,
   "text": "دل پاک‌اند. سومم فرمود قلبشون استواره، محکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.2,
   "end": 442.36,
   "text": "ما راست قامتان جاودانه تاریخ خواهیم بود، شهید بهشتی فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.36,
   "end": 449.8,
   "text": "این دل استواره که باعث میشه جلوی قدرت ششم عالم دنیا به زحمت خودشون البته بایسته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.8,
   "end": 455.96,
   "text": "سر سوزنی نترسه. یا الانو الان میگیم آقا قدرت موشکی، اون موقع چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.96,
   "end": 457.66,
   "text": "چهل و پنج سال پیش ما چی داشتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.66,
   "end": 460.58,
   "text": "یه سیم خاردار هم نداشتیم از خارج از کشور وارد می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 460.58,
   "end": 464.62,
   "text": "موشک چیه؟ چی داشتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 464.62,
   "end": 469.76,
   "text": "اولین کسی که گفت آمریکا هیچ غلطی نمیتونه بکنه چی داشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 469.76,
   "end": 474.52,
   "text": "تو حیاط جماران با دست ظاهراً خالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 474.52,
   "end": 477.56,
   "text": "اون موقع هم فکر نکنیم همه مردم پشت امام بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.56,
   "end": 482.88,
   "text": "نه. حالا عزیزانی که آمار میدن من خودم تا دو میلیون فکر می‌کردم بعضی از بچه‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.88,
   "end": 487.12,
   "text": "تو سپاه هستن و چه میدونم آمار و اطلاعات دارن میگن یک میلیون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.12,
   "end": 490.58,
   "text": "از اون چهل میلیون اون موقع کلاً اومدن جنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 490.58,
   "end": 494.24,
   "text": "چقدر ما میدیدیم آدمایی که همون موقعش سربازن بچه بسیجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 494.24,
   "end": 499.96,
   "text": "پایگاه خود ما نامه از نمازجمعه امام جماعت گرفتن که نرن خط مقدم بیفتن تو شهرها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.96,
   "end": 505.1,
   "text": "خیلیا فرار می‌کردن. اینطوری نیست شما فکر کنید همه پشت امام بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.1,
   "end": 508.84,
   "text": "که الان اگه مثلاً یهو نزدیک پونزده میلیون فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.84,
   "end": 512.34,
   "text": "اعلام آمادگی می‌کنند برای رفتن به جنگ مثلاً طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 512.34,
   "end": 514.0,
   "text": "اسرائیل این چیز کمی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.0,
   "end": 516.58,
   "text": "اون موقع امام با چه دلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 516.58,
   "end": 519.64,
   "text": "میگه آمریکا هیچ غلطی نمی‌تونه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 519.64,
   "end": 524.48,
   "text": "میگه کسی جرات داشت اسم آمریکا رو بدون احترام ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 524.48,
   "end": 526.78,
   "text": "همینه. این دله. این خصوصیت این دله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.78,
   "end": 528.62,
   "text": "شیطان دور این دل نگشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 528.62,
   "end": 530.78,
   "text": "شک و ریب و تردید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 530.78,
   "end": 533.7,
   "text": "عذر شود. شرک درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 533.7,
   "end": 536.76,
   "text": "کتاب امام صادق صلوات الله علیه خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 536.76,
   "end": 539.78,
   "text": "این روایت در مجمع البیان، بیان مرحوم طبسی‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.78,
   "end": 542.52,
   "text": "می‌فرماید امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 542.52,
   "end": 547.08,
   "text": "کل قلبن فیه شرک أو شک، هر دلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 547.08,
   "end": 550.84,
   "text": "تو شرک یا شک بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 550.84,
   "end": 553.26,
   "text": "فرمودن فهو ساقط و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 553.26,
   "end": 555.88,
   "text": "السلام. اون ساقط میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 555.88,
   "end": 559.3,
   "text": "میگن سقط جنین. دیگه این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 559.3,
   "end": 560.96,
   "text": "این قلب دیگه قلب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.96,
   "end": 562.92,
   "text": "حرم خدا نیست. چرا اینطوری میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 562.92,
   "end": 566.76,
   "text": "چون شرک و شرک و شک از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 566.76,
   "end": 570.86,
   "text": "این روایت آخر رو تقدیم کنم که بارها در مباحث‌مون گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 570.86,
   "end": 573.82,
   "text": "من خواهش می‌کنم این روایت آخر رو خوب دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 573.82,
   "end": 577.68,
   "text": "روح فرزند عزیزمان آقای حمزه شاد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 577.68,
   "end": 583.06,
   "text": "خدا با نورانیت این آیات و روایات روحشو بنوازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.06,
   "end": 586.0,
   "text": "در بحار جلد هفتاد صفحه بیست و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 586.0,
   "end": 591.32,
   "text": "یه سری رو اینجا پیغمبر عظیم الشأن اسلام بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.32,
   "end": 593.98,
   "text": "لولا أن الشياطين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 593.98,
   "end": 596.04,
   "text": "يحومون على قلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 596.04,
   "end": 598.8,
   "text": "ببینید قلوب بنی آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 598.8,
   "end": 603.14,
   "text": "اگر اینطور نبود که شیاطین میان دور دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 603.14,
   "end": 607.86,
   "text": "فرزندان آدم می‌چرخن، با دل اینا کار دارن چون حرم اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 607.86,
   "end": 612.4,
   "text": "حرم خداست دیگه. میگه اگر نبود که این شیطونا میان دور این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 612.4,
   "end": 618.12,
   "text": "دل که رسوخ کنن، بچرخن برن داخلش، اگه این نبود چه اتفاقی میفتاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 618.12,
   "end": 620.34,
   "text": "به به. لامش هم تأکیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 620.34,
   "end": 623.76,
   "text": "لن نظروا إلى الملكوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 623.76,
   "end": 628.82,
   "text": "قطعاً همه نگاه می‌کردن، ملکوتو همینجا می‌دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 628.82,
   "end": 631.66,
   "text": "اصلاً نیاز نبود که بمیرن تا ببینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 631.66,
   "end": 634.82,
   "text": "چون موت یه فلسفه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 634.82,
   "end": 637.74,
   "text": "دیدن ملکوته. سفر از ظاهر به باطن آدمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 637.74,
   "end": 643.1,
   "text": "از ملک به ملکوته. میگه اگر این شیطونا نیومدن تو هم می‌دیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 643.1,
   "end": 645.94,
   "text": "پس قلبی-- اختصار تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 645.94,
   "end": 650.62,
   "text": "قلبی حرم الهیه که حریمشو بسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 650.62,
   "end": 655.18,
   "text": "خود نگه داره. خودش رو در محضر حق می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 655.18,
   "end": 658.52,
   "text": "از م-مرحوم لاهوری هم یه جمله‌ای پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 658.52,
   "end": 660.64,
   "text": "حضور در برابر حق آماده کرده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 660.64,
   "end": 662.96,
   "text": "میگه فرصت نیست. باشه طلبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 662.96,
   "end": 666.02,
   "text": "چنین کسی وقتی قلبش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 666.02,
   "end": 673.74,
   "text": "حرم نگه داشت یعنی محاز محاصره کرد خودش قلبشو پلیس قلب خودش بود دیگه شیاطین نیومدن چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 673.74,
   "end": 677.02,
   "text": "چشمش بیفته به ملکوت. چیز عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 677.02,
   "end": 679.58,
   "text": "ملکوت رو می‌بینه همین جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 679.58,
   "end": 684.5,
   "text": "از به از فکر به حدس میفته و به جذبه که قبلاً بحثش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 684.5,
   "end": 689.46,
   "text": "انشاالله که عاقبت‌مون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 689.46,
   "end": 698.72,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}