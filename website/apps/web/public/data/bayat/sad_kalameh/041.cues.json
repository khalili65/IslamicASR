 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ چهلم؛ مناسبتِ طالب و مطلوب",
   "start": 13.9,
   "end": 58.18
  },
  {
   "index": 1,
   "title": "## سرمایهٔ سعادت؛ چهل حدیثِ معرفتِ نفس",
   "start": 58.18,
   "end": 140.18
  },
  {
   "index": 2,
   "title": "## سحر، روحِ بخاری و توحد",
   "start": 140.18,
   "end": 581.32
  },
  {
   "index": 3,
   "title": "## شاه‌چراغ؛ بیعت‌نکردن از سرِ کَندَن",
   "start": 581.32,
   "end": 814.82
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 2.34,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.34,
   "end": 6.0,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.0,
   "end": 13.9,
   "text": "و ربانی یا یا صه سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.9,
   "end": 17.8,
   "text": "یاد حضرت امام و شهدا رو گرامی میداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.8,
   "end": 26.0,
   "text": "و البته در ایام بسیار پربرکت و فرخنده دهه کرامت هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.0,
   "end": 33.5,
   "text": "که فرزندان موسى بن جعفر علیهم أصلات و السلام قرار کردند این ایام رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.5,
   "end": 37.96,
   "text": "بسیار ایام فرخنده، نورانی و پرفروغی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.96,
   "end": 43.56,
   "text": "نثار امام و شهدا و نثار که ما رو با اون‌ها آشنا کردند و نثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.56,
   "end": 46.9,
   "text": "فرزندان موسى بن جعفر تا قیام قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.9,
   "end": 48.78,
   "text": "صلواتی هدیه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.78,
   "end": 55.36,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.36,
   "end": 63.78,
   "text": "کلمه چهلهم. آن که در طلب دقت کند بین طالب و مطلوب مناسبتی می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.78,
   "end": 67.42,
   "text": "یه مناسبتی بین طالب و مطلوب هست شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.42,
   "end": 74.2,
   "text": "مطلوبت هرچی که باشه با اون سمت حرکت می‌کنی و تو میشی طالب اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 74.2,
   "end": 76.54,
   "text": "مناسبته بین این دو هست و پی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.54,
   "end": 79.4,
   "text": "پی می‌برد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.4,
   "end": 84.92,
   "text": "میگه اون کسی که دقت کنه بین طالب و مطلوب یه چیزی رو متوجه میشه، چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.92,
   "end": 89.18,
   "text": "پی می‌برد که نفس بدون توحد و تجمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.18,
   "end": 92.44,
   "text": "به کمال انسانی نرسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.44,
   "end": 96.6,
   "text": "نفس بدون توحد و تجمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.6,
   "end": 106.6,
   "text": "به مقام جمع، به کمال انسانی نرسد و تعلق با تعقل جمع نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.6,
   "end": 108.6,
   "text": "نمیشه کسی تعقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.6,
   "end": 111.58,
   "text": "میخواد داشته باشه که برسه به توحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 111.58,
   "end": 115.32,
   "text": "از طریق کار عقلی برسه به توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 115.32,
   "end": 117.32,
   "text": "اما تعلق داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.32,
   "end": 120.76,
   "text": "اصلا امکانش نیست. بعد اشاره به حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.76,
   "end": 127.28,
   "text": "به حدیث حضرت بصی امیرالمؤمنین می‌کنند که العارف من عرف نفسه فاعتقها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.28,
   "end": 129.54,
   "text": "ونزهها عن کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.54,
   "end": 135.32,
   "text": "ما یبعدها که البته در کتاب شریف غرر الحکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.32,
   "end": 139.66,
   "text": "اونجا و یوبقه ها هم انتهای این حدیث هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.66,
   "end": 144.3,
   "text": "منتها اینجا علامه اون کلمه رو دیگه اضافه نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.3,
   "end": 149.62,
   "text": "که معناش اینه که کسی که نفسش رو شناخت آزاد می‌کنه نفسش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 149.62,
   "end": 152.62,
   "text": "نفسش رو آزاد می‌کنه از قید و بندها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.62,
   "end": 157.24,
   "text": "از تعلقات و پاک می‌کنه ونزهها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.24,
   "end": 161.48,
   "text": "پاک می‌کنه از هر چیزی که نفس رو دور می‌کنه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.48,
   "end": 165.16,
   "text": "اون طالب خودش، اون مطلوب خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.16,
   "end": 171.12,
   "text": "از اون طلب خودش از هر چیزی که نفس رو دور می‌کنه این رو خودش رو آزاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.12,
   "end": 175.56,
   "text": "اینجا مهم‌ترین چیزی که حضرت استاد اشاره بهش می‌کنند بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.56,
   "end": 178.86,
   "text": "در دل معرفت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.86,
   "end": 184.62,
   "text": "بحث توحده و کندن از تعقلات، تعلقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.62,
   "end": 188.96,
   "text": "برای رسیدن به عقل که مسیر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.96,
   "end": 192.5,
   "text": "راه رو به رسیدن به توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.5,
   "end": 198.16,
   "text": "اتفاقا در کتاب شریف هزار و یک نکته صفحه هشتاد و، هشتصد و بیست و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 198.16,
   "end": 201.38,
   "text": "در ختامه‌شون اونجا وقتی چهل تا حدیث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.38,
   "end": 204.88,
   "text": "پیرامون معرفت نفس علامه جمع می‌کنند که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.88,
   "end": 208.42,
   "text": "توصیه می‌کنم اون چهل تا حدیث رو بریم ببینیم پیرامون معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.42,
   "end": 211.28,
   "text": "در ابتدای این چهل حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.28,
   "end": 216.58,
   "text": "حضرت استاد این چنین مرقوم می‌فرمایند که سرمایه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 216.58,
   "end": 222.04,
   "text": "سرمایه همه سعادت‌ها و اهم واجبات معرفت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 222.04,
   "end": 223.8,
   "text": "یعنی خودشناسی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.8,
   "end": 228.36,
   "text": "میگه سرمایه همه واجبات معرفت نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.36,
   "end": 234.8,
   "text": "و آن که خود را نشناخت عاتل و باطل زیخ، زیست و گوهر ذاتش را تباه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 234.8,
   "end": 236.96,
   "text": "و برای همیشه بی‌بهره ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.96,
   "end": 241.12,
   "text": "هیچ معرفتی چون معرفت نفس به کار انسان نمی‌آید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.12,
   "end": 247.86,
   "text": "و انسان کاری مهم‌تر از خودسازی ندارد و آن مبتنی بر خودشناسی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 247.86,
   "end": 252.94,
   "text": "میگه خودسازی خدا رحمت کنه چقدر امام تاکید بر خودسازی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 252.94,
   "end": 255.78,
   "text": "حضرت علامه می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 255.78,
   "end": 257.96,
   "text": "خودسازی مبتنی بر خودشناسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 257.96,
   "end": 261.74,
   "text": "کسی که خودش رو نمی‌شناسه نمی‌تونه خودش رو بسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 261.74,
   "end": 266.72,
   "text": "پس مهم‌تر از خودشناسی یا معرفت نفس ما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.72,
   "end": 271.4,
   "text": "که البته این معرفت نفس و خودشناسی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 271.4,
   "end": 273.72,
   "text": "کندن از تعلقات رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.72,
   "end": 279.16,
   "text": "تعلقات نمی‌ذاره، مانعه عزیزان به طور جد عرض می‌کنم مانعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 279.16,
   "end": 282.74,
   "text": "اصلا تع-تعلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.74,
   "end": 286.5,
   "text": "مانع تعقله و کسی هم که بر اساس آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.5,
   "end": 289.04,
   "text": "صد سوره یونس که قبلا عرض کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.04,
   "end": 292.2,
   "text": "کسی هم که تعقل نداره میفته به رجس و ناپاکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.2,
   "end": 298.36,
   "text": "یعنی عقل کسی تعطیل شد میفته به رجس و اصلا به توحید نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.36,
   "end": 303.36,
   "text": "اتفاقا حضرت استاد توصیه می‌کنند در، در جلسه صد و بیست و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 303.36,
   "end": 307.2,
   "text": "شرح فصوص‌شون به سحرها که چرا سحرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 307.2,
   "end": 309.78,
   "text": "انقدر مورد تاکید اسلام قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.78,
   "end": 313.16,
   "text": "نیمه شب \"فتحجت به نافلة اللیل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.16,
   "end": 315.76,
   "text": "تهجد نافله نیمه شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.76,
   "end": 319.74,
   "text": "اونجا اشاره می‌کنند به همین توحد نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.74,
   "end": 323.3,
   "text": "به اینکه نفس در سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.3,
   "end": 329.04,
   "text": "از تعلقاتش دور میشه، به توحد و توحید نزدیک میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 329.04,
   "end": 332.94,
   "text": "و مخصوصا اینکه روح بخاری توی حالتی قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 332.94,
   "end": 336.28,
   "text": "روح بخاری می‌دونید دیگه توی طب قدیم و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 336.28,
   "end": 339.38,
   "text": "و اون طب اصیل البته بگیم بهتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 339.38,
   "end": 345.2,
   "text": "که قائل بودند که ما به جز این روح نفس ناطقمون یه روح دیگه‌ای داریم به نام نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 345.2,
   "end": 349.66,
   "text": "یا روح بخاری که این اثبات شده است که از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.66,
   "end": 352.34,
   "text": "از همون امتزاج اخلاط حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.34,
   "end": 356.82,
   "text": "اون عناصر اربعه در ق-غذایی که می‌خوریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 356.82,
   "end": 358.9,
   "text": "قوه قاضیه که غذا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 358.9,
   "end": 362.1,
   "text": "جذب می‌کنه که بخواد هضمش کنه اونجا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.1,
   "end": 364.84,
   "text": "تصفیه این‌ها از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 364.84,
   "end": 368.9,
   "text": "این اخلاط حالا یا بگیم عناصر اربعیه که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.9,
   "end": 373.8,
   "text": "غذا وجود داره، یه مایع ماده صافی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 373.8,
   "end": 376.8,
   "text": "ایجاد میشه که از اون ماده و مایع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.8,
   "end": 381.18,
   "text": "خون جریان پیدا میکنه در روغ-- عروق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.18,
   "end": 390.16,
   "text": "و اون خون دو مرتبه بالا میاد صاف میشه، زلال میشه، حالت صافی عجیبی میگیره به خودش تبدیل میشه به روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.16,
   "end": 397.12,
   "text": "اولین محلی که نفس ناطقه انسان تعلق به بدن پیدا میکنه از طریق روح بخاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 397.12,
   "end": 404.36,
   "text": "وقتی این روح بخاری سحر شد چون معده هم خالیه، امتلاء معده خیلی بده، پر بودنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 404.36,
   "end": 407.24,
   "text": "سحر معده خالیه. از اون طرف رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 407.24,
   "end": 411.5,
   "text": "هوا تلتیخ شده، هوا بسیار پاک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 411.5,
   "end": 415.3,
   "text": "اِاِاِ یه حالت لطیفی پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 415.3,
   "end": 417.68,
   "text": "سر و صدا هم که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 417.68,
   "end": 421.14,
   "text": "همه این‌ها این حسیات کمک میکنه انسان بره سمت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 421.14,
   "end": 425.04,
   "text": "توحد. یعنی متمرکز بشه سر حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 425.04,
   "end": 432.48,
   "text": "لذا بهترین راه از این کسی که سحر نداره دیگه از خودش گفتن \"آنکه سحر ندارد از خود خبر ندارد.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 432.48,
   "end": 436.74,
   "text": "اونجا باعث میشه انسان از تعلقاتش خارج بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 436.74,
   "end": 439.88,
   "text": "این تعلقات پدر ما رو درآورده عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 439.88,
   "end": 442.0,
   "text": "رک بگم حالا یکی متعلق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 442.0,
   "end": 445.12,
   "text": "این تعلقش برمیگرده بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 445.12,
   "end": 450.76,
   "text": "به اصل و نسبش. پز میده به اصل و نسبش به مثلاً پدر مادرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 450.76,
   "end": 459.3,
   "text": "چه میدونم یکی پز میده به میز و مدیریتش یکی به تیپ و قیافش، یکی به قدرت و بازوش، یکی به پولش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 459.3,
   "end": 461.06,
   "text": "یکی هرکی یه چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 461.06,
   "end": 463.16,
   "text": "یکی به مدرک تحصیلیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 463.16,
   "end": 465.5,
   "text": "پدر همه رو درآورده عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 465.5,
   "end": 471.08,
   "text": "اینکه آستاد علی خمینی نوه حضرت امام چند روز پیش در پس صحبت ام--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 471.08,
   "end": 475.36,
   "text": "رهبر عزیزمون در حرم امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 475.36,
   "end": 481.64,
   "text": "خودش گفت من واقعاً اعجاب برانگیز بود و تعجب کردم از این سخن رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 481.64,
   "end": 486.52,
   "text": "که ره-- مثلاً جد ما، امام خمینی مثلا سی-- خود ایشون فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 486.52,
   "end": 489.84,
   "text": "نمیدونم شنیدید یا نه. نوه امام آستاد علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 489.84,
   "end": 492.48,
   "text": "گفتش که پدر ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 492.48,
   "end": 495.92,
   "text": "پدربزرگ ما حدود ده سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.92,
   "end": 499.7,
   "text": "این کشتی پرتلاطم انقلاب رو مثلاً مدیریت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 499.7,
   "end": 502.28,
   "text": "ایشون سی و سه ساله داره مدیریت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 502.28,
   "end": 505.44,
   "text": "بعد وقتی میاد تو جما-- توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 505.44,
   "end": 510.36,
   "text": "حرم امام، سالگرد امام بیان میکنه که چرا منو با امام قیاس میکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 510.36,
   "end": 513.4,
   "text": "فاصله من با حضرت امام نجومیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 513.4,
   "end": 515.44,
   "text": "بعد پسر، پسر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 515.44,
   "end": 518.14,
   "text": "نوه حضرت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 518.14,
   "end": 522.28,
   "text": "میگه این واقعاً این صحبت رهبر اعجاب برانگیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 522.28,
   "end": 524.92,
   "text": "عین صحبت ایشون که من گوش دادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 524.92,
   "end": 530.72,
   "text": "که این چقدر این ناشی از خودساختگی عجیب ایشون و کندنش از تعلقاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 530.72,
   "end": 533.86,
   "text": "واقعاً اینطوریه‌ها. یه پست، یه میز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 533.86,
   "end": 539.88,
   "text": "یه آدمی که به شدت آدم خوبی هم جلوه میکرده رو از این رو به اون رو میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 539.88,
   "end": 543.12,
   "text": "یه هفته تازه مدیریت نگرفته همه رو فراموش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 543.12,
   "end": 546.56,
   "text": "باید بری چقدر وقت بگیری تا آقا رو ببینی فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 546.56,
   "end": 549.32,
   "text": "دیگه نمازش تعطیل میشه، هیالش تعطیل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 549.32,
   "end": 552.2,
   "text": "چقدر ما مدیر داریم اصلاً نماز نمیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 552.2,
   "end": 556.36,
   "text": "بهش هم که میگی آقا یه حرفای الکی و بیخود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 556.36,
   "end": 558.62,
   "text": "یه چیزایی که اصلاً هیچ توج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 558.62,
   "end": 561.56,
   "text": "هیچ تایی نداره وقتی میری بررسی میکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 561.56,
   "end": 564.12,
   "text": "مثل اینکه من با چند تا از مدیرای همین جا صحبت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 564.12,
   "end": 567.72,
   "text": "آقا چرا شما نماز نمیاد؟ مشکلی در بنده میبینید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 567.72,
   "end": 570.56,
   "text": "گفتن نخیر، اینجا مثلاً حرفای بی پایه و اساس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 570.56,
   "end": 574.26,
   "text": "این بنا مثلاً ما شنیدیم این بنا مشکل داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 574.26,
   "end": 578.44,
   "text": "بنای فلان. یه حرفایی که هیچ پایه و اساسی هم واقعاً نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 578.44,
   "end": 580.28,
   "text": "همش تعلقاته عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 580.28,
   "end": 585.54,
   "text": "یا همین آقای احمد بن موسی الکاظم که امروز معروفه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 585.54,
   "end": 588.52,
   "text": "شاه چراغ. حالا شاه چراغ چرا میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 588.52,
   "end": 591.08,
   "text": "یه داستانی داره که پیرزن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 591.08,
   "end": 594.58,
   "text": "سحر میرفته اون دور چراغو میبینه و چه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 594.58,
   "end": 601.4,
   "text": "نور قبر ایشون رو میبینه که مثل چراغ، مثل یک خورشید روشنه و براش یه حکایتی گفتن کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 601.4,
   "end": 605.4,
   "text": "ایشون سنش از امام رضا بیشتر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 605.4,
   "end": 606.98,
   "text": "سنش بالاتر از امام رضا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 606.98,
   "end": 610.1,
   "text": "وقتی که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 610.1,
   "end": 615.74,
   "text": "موسی بن جعفر به رحمت حق رفت، مردم هجوم آوردن بیعت کنن با این آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 615.74,
   "end": 618.04,
   "text": "به عنوان امام و حجت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 618.04,
   "end": 622.74,
   "text": "ایشون دست همه رو گرفت گفت همه جمع شید برید محضر برادر کوچیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 622.74,
   "end": 625.68,
   "text": "ولی و حجت خدا ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 625.68,
   "end": 627.84,
   "text": "آیا شما بگید اگر ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 627.84,
   "end": 633.06,
   "text": "سر سوزنی تعلق داشت به حاکمیت، به نمیدونم، به اینکه بخواد حاکم باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 633.06,
   "end": 637.24,
   "text": "رئیس باشه، مدیر باشه، چه میدونم بالا دست مردم باشه ظاهراً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 637.24,
   "end": 639.68,
   "text": "اصلاً این کارو میتونست انجام بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 639.68,
   "end": 644.2,
   "text": "آیا این جز کندن از تعلقاته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 644.2,
   "end": 648.56,
   "text": "که ب-باید امروز، امروز هم روز میلادشه دیگه این بزرگوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 648.56,
   "end": 651.26,
   "text": "که تو شیراز دفنه. چقدر حا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 651.26,
   "end": 655.34,
   "text": "یکی از فامیلای ما دیروز میگفت من تلفنی یه مشکلی داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 655.34,
   "end": 657.52,
   "text": "رفیق-- فامیل ما اونجا تو حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 657.52,
   "end": 660.7,
   "text": "حضرت شاه چراغ بود. تلفنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 660.7,
   "end": 664.28,
   "text": "تلفنی حاجتم رو به حضرت شاه چراغ احمد بن موسی گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.28,
   "end": 666.28,
   "text": "مشکلم حل شد. حاجتم روا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 666.28,
   "end": 669.84,
   "text": "تلفنی. بر و منکرش لعنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 669.84,
   "end": 673.9,
   "text": "این‌ها به جز کندن از تعلقات نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 673.9,
   "end": 676.74,
   "text": "اصلاً محاله. رهبر عزیز ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 676.74,
   "end": 682.84,
   "text": "که حضرت استاد علامه حسن زاده می فرمودن اگر ما کو-- یک مکروه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 682.84,
   "end": 686.4,
   "text": "از ایشون میدیدیم، کرنش نمیکردیم در برابرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 686.4,
   "end": 689.82,
   "text": "اینو علامه حسن زاده خودم شنیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 689.82,
   "end": 693.68,
   "text": "ازشون. اگر یک مکروه از رهبر میدیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 693.68,
   "end": 696.92,
   "text": "و فرمود پاک‌تر از ایشون نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 696.92,
   "end": 701.28,
   "text": "من حالا که اینطور شد اجازه بدید یه خاطره کوچولو سی ثانیه‌ای بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 701.28,
   "end": 704.94,
   "text": "مفصله کوچ-- خیلی مختصر اجمالاً میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 704.94,
   "end": 708.0,
   "text": "محضر حضرت استاد علامه حسن زاده بودیم یه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 708.0,
   "end": 712.14,
   "text": "و ایشون حالا اس-- اتفاقات خاصی اون روز افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 712.14,
   "end": 716.74,
   "text": "و ایشون ما در خصوص رهبر ازشون سؤال کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 716.74,
   "end": 718.94,
   "text": "تکیه داده بود و عصا رو سینه شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 718.94,
   "end": 722.08,
   "text": "ایشون تا اسم رهبر رو بنده بردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 722.08,
   "end": 725.54,
   "text": "سه مرتبه به حالت رکوع اینطوری تعظیم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 725.54,
   "end": 727.14,
   "text": "حضرت استاد علامه حسن زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 727.14,
   "end": 729.38,
   "text": "تو اتاق شخصی خودشون بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 729.38,
   "end": 732.6,
   "text": "با سه چهار تا طلبه و دانشجو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 732.6,
   "end": 734.9,
   "text": "و سه بار فرمودن جانم به فداش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 734.9,
   "end": 737.52,
   "text": "جانم به فداش. جانم فدای رهبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 737.52,
   "end": 740.74,
   "text": "این جا، این عالم جامع الاطراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 740.74,
   "end": 745.46,
   "text": "که واقعاً اندیشمندان حوزه های مختلف علمی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 745.46,
   "end": 748.7,
   "text": "اِاِاِ شرق و غرب جلوش زانو زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 748.7,
   "end": 752.46,
   "text": "علامه حسن زاده یعنی چیز کم، کم کسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 752.46,
   "end": 755.46,
   "text": "بعد ایشون سه بار بگه جانم به فداش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 755.46,
   "end": 760.58,
   "text": "بعد به ما یه جو-- فرمود یه جمله به شما بگم یادگار از من داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 760.58,
   "end": 762.82,
   "text": "که ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 762.82,
   "end": 767.02,
   "text": "تنها، عین عبارت علامه رو دارم به شما منتقل میکنم سینه به سینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 767.02,
   "end": 769.92,
   "text": "یعنی واسطه ای نیست. خودم از ایشون شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 769.92,
   "end": 777.42,
   "text": "ایشون تنها عالمیست که غبار دنیا رو عباش نشسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 777.42,
   "end": 781.18,
   "text": "حالا همین این جمله علامه حسن زاده یه منبر می طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 781.18,
   "end": 782.74,
   "text": "غبار نه خاک تازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 782.74,
   "end": 784.74,
   "text": "اونم رو عبا، نه قبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 784.74,
   "end": 787.38,
   "text": "این لایه زیرین نه، این رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 787.38,
   "end": 791.14,
   "text": "عبا رو رو میندازه عالم. روی عباش غبار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 791.14,
   "end": 793.2,
   "text": "اونم نه خاک، غبار دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 793.2,
   "end": 795.74,
   "text": "اونم میگه تنها عالمیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 795.74,
   "end": 798.32,
   "text": "بعد ما قدر نمیدونیم واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 798.32,
   "end": 800.94,
   "text": "اینا در کندن از تعلقات رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 800.94,
   "end": 808.84,
   "text": "تا کسی تعلق داره نمیتونه به تعقلش برسه و کسی که تعقل نداره به توحد یعنی توحید ناب نمیرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 808.84,
   "end": 814.82,
   "text": "ان شا الله عاقبت بخیر بشه و برکت صلوات بر محمد و آل محمد. اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}