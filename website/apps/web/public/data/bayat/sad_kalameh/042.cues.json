 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ چهل‌ویکم؛ شخص ممتد ذومراتب",
   "start": 14.82,
   "end": 39.1
  },
  {
   "index": 1,
   "title": "## انه الحق؛ به قدر معراج قرآنی",
   "start": 39.1,
   "end": 239.4
  },
  {
   "index": 2,
   "title": "## حکمت خیر کثیر و خزائن",
   "start": 239.4,
   "end": 423.92
  },
  {
   "index": 3,
   "title": "## یس و ترس از مرگ",
   "start": 423.92,
   "end": 597.84
  },
  {
   "index": 4,
   "title": "## قد قامت الصلاة",
   "start": 597.84,
   "end": 617.92
  },
  {
   "index": 5,
   "title": "## رسانه و جبههٔ فرهنگی",
   "start": 617.92,
   "end": 703.48
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 2.68,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.68,
   "end": 6.12,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.12,
   "end": 12.26,
   "text": "و ربانی ایاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.26,
   "end": 14.82,
   "text": "کلمه چهل و یکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.82,
   "end": 18.22,
   "text": "آنکه در معرفت نفس غور کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.22,
   "end": 20.68,
   "text": "یعنی کسی که تو وادی معرفت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.68,
   "end": 24.16,
   "text": "عمیق بشه به چی میرسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.16,
   "end": 27.5,
   "text": "خود را یک شخص ممتد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.5,
   "end": 30.22,
   "text": "کشیده شده، یک شخص کشیده شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.22,
   "end": 34.32,
   "text": "ادامه‌دار دارای مراتب بیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 34.32,
   "end": 38.98,
   "text": "که هر رتبه را یا هر مرتبه را حکمی خاص است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.98,
   "end": 44.54,
   "text": "و در عین حال مرتبه بالا حقیقت مرتبه پایین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.54,
   "end": 47.1,
   "text": "و پایین رقیقت بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.1,
   "end": 50.38,
   "text": "اون بالا حقیقته اینجا رقیقت اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.38,
   "end": 54.28,
   "text": "اینجا رقیق شده اون حقیقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.28,
   "end": 57.32,
   "text": "سایه اون حقیقته اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 57.32,
   "end": 59.9,
   "text": "ملک سایه ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 59.9,
   "end": 64.5,
   "text": "متأسفانه ما همه توجه‌مون غالباً به ملکه، اصلاً ملکوت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 64.5,
   "end": 69.6,
   "text": "غافلیم. چنانکه بدن مرتبه نازله نفس است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 69.6,
   "end": 76.16,
   "text": "و مع ذلك همه افعال مراتب از یک هوییت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.16,
   "end": 80.62,
   "text": "خیلی فرمایش بسیار عالی و عرشی رو اینجا علامه پیاده کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.62,
   "end": 88.02,
   "text": "حالا الحمد لله پیشامون این موضوع ما چندین بار در همین سیر بحث و خصوصاً در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.02,
   "end": 90.34,
   "text": "قلب در قرآن اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.34,
   "end": 93.58,
   "text": "سخن زیاد گفتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.58,
   "end": 99.94,
   "text": "اتفاقاً در راس-- رساله شریف انه الحق صفحه صد و سی و چهار حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.94,
   "end": 102.16,
   "text": "اونجا مرقوم فرمودند که به هم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.16,
   "end": 109.48,
   "text": "به همان اندازه که از این درجات ارتقا یافته‌ای یعنی این درجات وجودت هرچی رفتی بالاتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.48,
   "end": 112.94,
   "text": "به همان اندازه قرآنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.94,
   "end": 118.6,
   "text": "یعنی ما به همان میزانی که رفتیم به لایه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.6,
   "end": 121.98,
   "text": "باطنی‌ترمون، به اون رتبه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.98,
   "end": 128.94,
   "text": "بالا دستی‌مون ارتقای وجودی پیدا کردیم و به معراج رفتیم، همان مقدار به قرآن رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.94,
   "end": 131.96,
   "text": "الان عزیزم حالا با خلوص گفت چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.96,
   "end": 137.28,
   "text": "هرچی بود این قد قامت الصلاة رو که گفت نمیدونم یه دفعه لرزه ای تو بدن من افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.28,
   "end": 143.8,
   "text": "حالا شاید به جهت اینکه از دیشب دارم به همین موضوع فکر می‌کنم واقعاً قد قامت الصلاة،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.8,
   "end": 146.16,
   "text": "الصلاة قیامت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.16,
   "end": 149.08,
   "text": "قیام کرد. قام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.08,
   "end": 152.36,
   "text": "قد قام، قد قامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.36,
   "end": 155.64,
   "text": "الصلاة. نماز قیام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.64,
   "end": 158.18,
   "text": "یعنی با همه مراتبش قیام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.18,
   "end": 162.08,
   "text": "لذا فرمود الصلاة معراج المؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.08,
   "end": 165.24,
   "text": "واقعاً آدم تنش می‌لرزه توجه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.24,
   "end": 169.94,
   "text": "یعنی ما متأسفانه نمازمون می‌بینی مثل من اگه بخونی فقط همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.94,
   "end": 176.2,
   "text": "نماز خاکیه به همین هیئت جسمی و ملکی نماز بردار و در هیئت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.2,
   "end": 178.5,
   "text": "ملکی خودش نماز اقامه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.5,
   "end": 181.1,
   "text": "نگاش می‌کنی می‌بینی آقا داره نماز می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.1,
   "end": 184.4,
   "text": "اما آیا عروج کرده به اون رتبه‌های پنهانی‌تر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.4,
   "end": 186.6,
   "text": "خود نماز، خود نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 186.6,
   "end": 188.74,
   "text": "پله پله داره تا بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.74,
   "end": 193.86,
   "text": "معراج مگه نیست؟ آیا در نماز سفر مثالی داشتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.86,
   "end": 197.42,
   "text": "یعنی رفتی به مثال عالم مثال نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.42,
   "end": 203.92,
   "text": "به عالم عقل نماز، قلب نماز، فوق عقل و فوق عرش نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.92,
   "end": 205.96,
   "text": "همین‌طوری برو تا حضرت حق دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.96,
   "end": 209.62,
   "text": "مراتب محفوظه. آدم تنش می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.62,
   "end": 213.36,
   "text": "چه نمازی من دارم می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.36,
   "end": 217.96,
   "text": "بعد حضرت ادامه میدن که و به همان اندازه خزانه الهی هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.96,
   "end": 220.72,
   "text": "و به همان اندازه بهشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.72,
   "end": 223.76,
   "text": "به همان اندازه که به معراج رفتی بهشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 223.76,
   "end": 238.58,
   "text": "چقدر به معراج رفتی به همان مقدار به درجات قرآن رسیده و بهشتی و اشاره می‌کنند به این آیه از قرآن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.58,
   "end": 244.5,
   "text": "اشاره می‌کنند به حکمت که قرآن میگه هرکی بهش حکمت دادیم خیر کثیر بهش دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.5,
   "end": 248.12,
   "text": "خیر کثیر. حکمت هم یعنی علم به اعیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.12,
   "end": 251.58,
   "text": "موجود-- علم به حقایق و اعیان موجودات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.58,
   "end": 255.9,
   "text": "عین اشیا که خود شما الان یک عینیتی داری، یه شیئی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.9,
   "end": 258.78,
   "text": "به حقیقت خودت پی ببری به حکمت رسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.78,
   "end": 262.44,
   "text": "حقیقت تو چیه؟ بر اساس بارها این آیه رو خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.44,
   "end": 264.06,
   "text": "آیه بیست و یک سوره هجری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.06,
   "end": 273.46,
   "text": "چقدر این آیه قشنگه. هیچ شیئی نیست که من و شما هم یکی از اون اشیا ایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.46,
   "end": 276.22,
   "text": "مگر اینکه خزينه‌اش پیش ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.22,
   "end": 279.1,
   "text": "یعنی ما کشیده شدیم عندنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.1,
   "end": 284.08,
   "text": "ما همین الان‌ها همین الان کشیده شدیم، ممتدیم دیگه تا عند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.08,
   "end": 286.7,
   "text": "ربی، ربی، عند ربی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.7,
   "end": 291.18,
   "text": "عند ربی. اصلاً میگی ربببییی همینطوری ولش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.18,
   "end": 293.78,
   "text": "رببی هم بکش برو ممتد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.78,
   "end": 297.18,
   "text": "اصلاً یکی از اسراری که حضرت استاد علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.18,
   "end": 300.02,
   "text": "در شرح فصوصشون می‌فرمودن که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.02,
   "end": 302.04,
   "text": "مشایخ‌مون شنیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.04,
   "end": 306.02,
   "text": "که بخوایم مثلاً اسم الأعلیم رو که هرچه الهامات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.02,
   "end": 310.36,
   "text": "حالا چه ایها-- ایها باشد و وحی نبو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.36,
   "end": 313.5,
   "text": "انباعی، باخبر شدن از حقایق عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.5,
   "end": 317.84,
   "text": "یا به نحو الهام باشد یا به نحو اعلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.84,
   "end": 320.52,
   "text": "یعنی باخبر شدن از حقایق عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.52,
   "end": 322.84,
   "text": "اینا همه زیر سر اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 322.84,
   "end": 325.64,
   "text": "الأعلیم حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.64,
   "end": 329.76,
   "text": "بعد می‌فرمودند مشایخ ما می‌گفتند این الأعلیم رو بکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.76,
   "end": 332.46,
   "text": "نگو الأعلیم، الأعلییییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.46,
   "end": 334.54,
   "text": "این کمک میده که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.54,
   "end": 338.2,
   "text": "در اون سیرت-- اینا حقایقیه که دارن میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.2,
   "end": 341.38,
   "text": "اینا رو ما به بازی نگیریم. داریم هر روز باهاش مرتبط می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.38,
   "end": 347.06,
   "text": "الان تو نماز سبحان ربی الأعلااا و بحمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.06,
   "end": 348.78,
   "text": "یه ذره بکش تو اونجا سیر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 348.78,
   "end": 351.16,
   "text": "برو به معراج ببین چه حالی بهت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 351.16,
   "end": 357.72,
   "text": "نگو أعلى و بحمد یا الله بخوای تکبیر بگی الله اکبر نه، بگو الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.72,
   "end": 359.54,
   "text": "اکبر. یه ذره با خودت حال کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 359.54,
   "end": 361.64,
   "text": "ببخشید بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 361.64,
   "end": 367.52,
   "text": "تو کتاب الجواهر الثنیه في احاديث القدس شیخ حر عاملی اونجا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.52,
   "end": 375.58,
   "text": "موسی پ-- خدای منان به موسی گفت موسی می‌خوای با من حرف بزنی صدا رو تو حنجرت بچرخون، خشک با من حرف نزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.58,
   "end": 378.56,
   "text": "یا حالا سر مدح‌ایی از اینجا شروع شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.56,
   "end": 384.86,
   "text": "یعنی بکشی بری این مدارج و معارف یعنی ما کشیده شدیم تا ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 384.86,
   "end": 387.68,
   "text": "و آقا اون آیه آخر سوره یاسین چی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 387.68,
   "end": 391.26,
   "text": "\"فسبحان الذي بيده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.26,
   "end": 394.76,
   "text": "ملكوت كل شيء واليه ترجعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 394.76,
   "end": 398.24,
   "text": "همه قراره بریم رجعت کنیم به سمت همون سبحان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.24,
   "end": 403.96,
   "text": "که هرکی مونده‌زه‌تره، پاک‌تره این رجعت بهتر براش رخ میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 403.96,
   "end": 408.08,
   "text": "و لقاء الله رو ب-بهتر درک می‌کنه چون با سبحان شروع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.08,
   "end": 412.78,
   "text": "میگه \"بيده ملكوت كل شيء\" یعنی هر چیزی ملکوتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.78,
   "end": 416.26,
   "text": "سررشته دست خداست. الان ما تو عالم ملکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.26,
   "end": 420.12,
   "text": "می‌خوایم \"والیه ترجعون\" قطعا میریم به عالم ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.12,
   "end": 423.12,
   "text": "اصلا داریم میریم، حواسمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.12,
   "end": 426.88,
   "text": "چرا می‌ترسیم از مرگ؟ چون سرکشی به عالم ملکوت نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 426.88,
   "end": 429.64,
   "text": "الان شما بخوای از اینجا بری به خونه‌ت می‌ترسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.64,
   "end": 433.24,
   "text": "ترس داره؟ چرا؟ چون انقدر رفتی چشم بسته میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 433.24,
   "end": 436.28,
   "text": "اما یه بچه وقتی می‌خواد بیاد تو این عالم گریه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 436.28,
   "end": 439.38,
   "text": "از رحم مادر می‌کشنش بیرون شروع می‌کنه گریه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 439.38,
   "end": 442.5,
   "text": "اع-- اعتراض می‌کنه. چرا منو آوردید به این دنیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.5,
   "end": 447.12,
   "text": "اما رفته رفته همه کراتم بهش بدی باز کمشه و ب-- اصلا نمی‌خواد از اینجا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 447.12,
   "end": 449.98,
   "text": "دوست نداره. چرا؟ آشنا می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 449.98,
   "end": 452.62,
   "text": "یه رتبه‌ش اون-- وقتی میاد به یه رتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.62,
   "end": 456.8,
   "text": "پنهانی‌تر از عالم رحم که دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 456.8,
   "end": 459.68,
   "text": "عالم رحم خودش مادون عالم دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 459.68,
   "end": 463.42,
   "text": "عالم ملکوت مافوق عالم ملکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 463.42,
   "end": 468.6,
   "text": "ما چون نرفتیم به ملکوت می‌ترسیم از مرگ، از چشیدن موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 468.6,
   "end": 470.58,
   "text": "از این حقایق و اسرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 470.58,
   "end": 472.86,
   "text": "آقا، آقا نگو، نگو این حرفا رو نزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 472.86,
   "end": 481.14,
   "text": "چرا نزنیم؟ تا کی؟ حالا این حرفا رو مثلا ما می‌زنیم از کلام بزرگان و آیات و روایات چیز بدی گیرمون اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.14,
   "end": 485.92,
   "text": "این همه حرفای تکراری شنیدیم. یه بارم یه حرفایی که قراره بریم \"والیه ترجعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 485.92,
   "end": 488.74,
   "text": "اصلا راهیه که داریم میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.74,
   "end": 491.0,
   "text": "و همه رو تو نماز باید چشیده باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 491.0,
   "end": 493.04,
   "text": "\"الصلاة معراج المؤمن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 493.04,
   "end": 499.96,
   "text": "ما داریم میریم به معراج. \"انا لله\" اومدیم و \"انا الیه راجعون\" و در قوس صعود داریم به معراج میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 499.96,
   "end": 502.5,
   "text": "کسی که نمازش عروجی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.5,
   "end": 504.62,
   "text": "موتشم مرگشم عروجی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 504.62,
   "end": 507.22,
   "text": "تو همین نشئه طبیعت می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 507.22,
   "end": 515.2,
   "text": "دیگه خیلی، خیلی کارش درست باشه به قول علامه теهرانی چهل سال طول می‌کشه تا از این نشئه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 515.2,
   "end": 518.0,
   "text": "به جهت تعلق نفس ناطقه به بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 518.0,
   "end": 520.72,
   "text": "همون بغل قبرشو همش گرفتار بدنشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 520.72,
   "end": 522.9,
   "text": "همش توجهش به بدنشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 522.9,
   "end": 527.06,
   "text": "مضطربه. نفس مض-- مضطربه داره نه مطمئنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 527.06,
   "end": 531.34,
   "text": "نه آدم خوب باشه مثل برق جهنده برزخ رو هم رد می‌کنه مثل شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 531.34,
   "end": 533.96,
   "text": "اصلا توجه به عالم دنیا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 533.96,
   "end": 536.36,
   "text": "اما بعضیا داریم تا حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 536.36,
   "end": 539.18,
   "text": "هزار سال تو نشئه طبیعت ارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 539.18,
   "end": 543.94,
   "text": "سرگردانن. چرا؟ خب این نرفته به این ب-- معراج نداشته اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 543.94,
   "end": 545.92,
   "text": "اون حقایق باطنی‌ترش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 545.92,
   "end": 549.22,
   "text": "ببین عزیز من در عالم رحم بودیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.22,
   "end": 552.46,
   "text": "خب اومدیم در عالم دنیا یعنی یه رتبه اومدیم پنهان‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 552.46,
   "end": 557.0,
   "text": "ب-به یعنی به از جهت رتبه‌ای بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 557.0,
   "end": 560.3,
   "text": "دنیا مافوق رحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.3,
   "end": 562.6,
   "text": "ملکوت مافوق دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 562.6,
   "end": 567.7,
   "text": "حالا الان اتفاقا اهل بیت در روایت فرمودن دنیا نسبتش به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 567.7,
   "end": 571.2,
   "text": "عالم ملکوت مثل نسبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 571.2,
   "end": 573.78,
   "text": "رحم است به اینجا، به همین جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 573.78,
   "end": 579.08,
   "text": "یعنی ما الان از رحم طبیعت قراره متولد شیم، بشیم بریم به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 579.08,
   "end": 581.56,
   "text": "این اتفاق قراره برای هممون بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 581.56,
   "end": 584.18,
   "text": "چرا آماده نیستیم برای اون معراج؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 584.18,
   "end": 587.76,
   "text": "چرا؟ مثل بچه‌ای که یهو میاد تو این دنیا گریه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.76,
   "end": 590.3,
   "text": "آخ داد و فریاد لحظه مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 590.3,
   "end": 592.2,
   "text": "آی خدا ما رو نبر. چرا داری ما رو می‌بری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 592.2,
   "end": 595.88,
   "text": "انقدر که تعلقات بیچاره‌مون کرده، تعلقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 595.88,
   "end": 598.86,
   "text": "این مراتب محفوظه در همه عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 598.86,
   "end": 601.5,
   "text": "حالا این مراتب رو حالا بحث زیاد داشتیم بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 601.5,
   "end": 604.3,
   "text": "فرصت گذشت. چند تا آیه دیگه می‌خواستیم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 604.3,
   "end": 606.68,
   "text": "اینا همه ریشه‌ها در آیات و روایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 606.68,
   "end": 609.34,
   "text": "این مراتب گاهی در خود ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 609.34,
   "end": 613.84,
   "text": "که ما از همین عالم ملک کشیده شدیم به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 613.84,
   "end": 617.92,
   "text": "همین الان که اینجایی انزل مراتب نفس ناطقت بدنته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 617.92,
   "end": 621.24,
   "text": "یعنی اینم نفس توئه. اون مراتب عالیه هم نفس توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 621.24,
   "end": 624.36,
   "text": "یک حقیقتی نه دو تا حقیقت که یه هویت داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 624.36,
   "end": 626.4,
   "text": "این انزلشه اون اشمخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 626.4,
   "end": 633.06,
   "text": "از ملک، ملکوت، جبروت، لاهوت، عرش، فوق عرش، برو تا ذات حضرت حق اندنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 633.06,
   "end": 635.02,
   "text": "ما همین الان عند ربی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 635.02,
   "end": 638.94,
   "text": "عند الله ایم. توجه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 638.94,
   "end": 645.46,
   "text": "یه وقتی یهو حالی به ما دست میده منقلب می‌شیم، دل پاک می‌شه، اشکی می‌ریزه از کجا میاد اینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 645.46,
   "end": 648.86,
   "text": "تو وجود خودت الان خیلیا تون با این چشای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 648.86,
   "end": 653.76,
   "text": "ببخشید از حدقه بیرون زدتون یه چیزایی دارید می‌فهمید که اینطوری می‌شه حالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 653.76,
   "end": 657.28,
   "text": "توجه داری قشنگ. داری یه چیزی می‌فهمی از کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 657.28,
   "end": 662.3,
   "text": "به قول علامه حلی در شرح فروصش این نزول ملک رخ داده در وجود، در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 662.3,
   "end": 667.36,
   "text": "ثغور نفس ناطقه خودت، در اون باطن و کمون ذاتت داری می‌فهمی حقیقتی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 667.36,
   "end": 671.66,
   "text": "یعنی مرتبط شدی با یه رتبه پ-- حداقل به پنهان وجود خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 671.66,
   "end": 673.72,
   "text": "رفتی به معراج داری می‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 673.72,
   "end": 676.76,
   "text": "حالا هرکی بره بالاتر هی بفهم-- بره خدا رو بفهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 676.76,
   "end": 683.6,
   "text": "الله اکبر. بالاخره اینجا رسانه‌ست باید حرفا هم ارتقا بده به انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 683.6,
   "end": 685.82,
   "text": "همینطور حرفای متعارف و معمولی نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 685.82,
   "end": 689.86,
   "text": "رسانه خط مقدم جبهه فرهنگی نظامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 689.86,
   "end": 694.88,
   "text": "جای کمی نیست. تو سر ما نکوبن یه عده این حرفا نگید حاجی آقا سنگینه فلان، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 694.88,
   "end": 698.28,
   "text": "من سبکم. این حرفا باید زده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 698.28,
   "end": 700.12,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 700.12,
   "end": 703.48,
   "text": "به برکت صلوات بر محمد و آل محمد. الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}