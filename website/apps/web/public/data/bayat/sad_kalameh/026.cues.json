 },
 "chapters": [
  {
   "index": 0,
   "title": "## فقدان مربی؛ عبادت بدون سلوک",
   "start": 26.64,
   "end": 181.82
  },
  {
   "index": 1,
   "title": "## مزاج عالم؛ شرح فصوص علامه",
   "start": 181.82,
   "end": 290.28
  },
  {
   "index": 2,
   "title": "## خطر استدراج برای اهل مذهب",
   "start": 290.28,
   "end": 458.52
  },
  {
   "index": 3,
   "title": "## تذکر خصوصی؛ حفظ آبرو",
   "start": 458.52,
   "end": 601.42
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 2.02,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.02,
   "end": 5.08,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.08,
   "end": 9.78,
   "text": "و ربانی آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.78,
   "end": 13.04,
   "text": "کلمه بیست و پنجم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.04,
   "end": 17.58,
   "text": "آن که کشتزارش را وجین نکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.58,
   "end": 23.62,
   "text": "وجین یه اصطلاحی است که در کشاورزی به کار می‌ره و اون علف‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.62,
   "end": 28.1,
   "text": "مزاحم و هرزه رو می‌چینن از کنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.1,
   "end": 32.28,
   "text": "اون نهال‌ها و این‌ها جوانه ها می‌چینن کنار می‌ذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.28,
   "end": 36.06,
   "text": "علامه فرمود آن که کشتزارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.06,
   "end": 42.92,
   "text": "را این کشتزار حالا بر اساس اون کلمه بیست و سوم بود فکر کنم یادمون باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.92,
   "end": 46.56,
   "text": "عرض کردیم زرع و زارعه و مزروع خود وجود انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.56,
   "end": 49.2,
   "text": "یعنی ما کشتزار هم خودمون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.2,
   "end": 52.68,
   "text": "دانه و بذر رو در خودمون می‌کاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.68,
   "end": 56.98,
   "text": "می‌فرماید «آن که کشتزارش را وجین نکند از گیاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.98,
   "end": 60.24,
   "text": "هرزه آزار بیند.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.24,
   "end": 63.12,
   "text": "یعنی بر می‌گرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.12,
   "end": 67.14,
   "text": "ریشه‌کن کردن آلودگی‌ها از درون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.14,
   "end": 70.6,
   "text": "متأسفانه ما از همون بچگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.6,
   "end": 77.14,
   "text": "از همون انفوان بچگی به جهت اینکه بالا سر خودمون یه معلم و استاد و مربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.14,
   "end": 80.94,
   "text": "درستی نداشتیم صرفاً رفتیم سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.94,
   "end": 84.64,
   "text": "عباديات. فوقش حالا اخلاقیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.64,
   "end": 88.82,
   "text": "حالا در حد همین دروغ نگو، غیبت نکن همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.82,
   "end": 91.34,
   "text": "نرفتیم سراغ اون سلوک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.34,
   "end": 95.12,
   "text": "سیر الی الله صائر بشیم، سالک بشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.12,
   "end": 97.36,
   "text": "کاشف بشیم این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.36,
   "end": 101.54,
   "text": "لذا ز-- نور و ظلمت با هم مشوب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.54,
   "end": 106.74,
   "text": "یعنی در حینی که داشتیم عبادت می‌کردیم می‌دونی در حوزه اعتقادات اصلاً مشرک بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.74,
   "end": 108.82,
   "text": "خیلی از کارها و اعتقادات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.82,
   "end": 112.54,
   "text": "از اصلاً حرف‌های ما بوی شرک می‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.54,
   "end": 116.86,
   "text": "و شرک چیزی‌ست که خود قرآن صریحتاً-- صریحاً می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.86,
   "end": 120.1,
   "text": "من همه گناه‌ها رو می‌بخشم الا شرک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.1,
   "end": 124.6,
   "text": "این خیلی ت-- واقعاً آدم تنش می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.6,
   "end": 128.9,
   "text": "شاید بعد مثلاً میگی اول خدا، دوم خدا، چقدرم برای خدا احترام قائله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.9,
   "end": 132.18,
   "text": "میگه سوم هم خدا. اما بعدش شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.18,
   "end": 135.76,
   "text": "تموم شد این شرکه. حالا در خصوص شرک نمی‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.76,
   "end": 143.68,
   "text": "حداقل در سیر حکمت و عرفان اگر کسی توحیدش توحید اصمد قرآنی نباشه به قول علامه این مشرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.68,
   "end": 149.28,
   "text": "به قول عارف عربی اون‌هایی که توحید وجودی رو قبول ندارن مشرکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.28,
   "end": 152.64,
   "text": "چرا به ما انگ عش-- مش-- شرک می‌زنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.64,
   "end": 155.3,
   "text": "شما میگید آسمان یه چیز، زمین یه چیز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.3,
   "end": 158.38,
   "text": "آس-- مثلاً ملائکه یه چیز، انسان یه چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.38,
   "end": 162.22,
   "text": "حالا بگردین خدا هم پیدا کنین که اینا رو خلق کرده به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.22,
   "end": 170.22,
   "text": "این شرکه. یکی از مهم‌ترین کارهای ما اینه که وجین کنیم این آشغال‌ها و هرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.22,
   "end": 174.74,
   "text": "حالا این عرض شود گیاه‌های هرزه رو از زمین وجودمون وجین کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.74,
   "end": 176.76,
   "text": "و اینا کار دست ما میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.76,
   "end": 179.64,
   "text": "غدارات و آلودگی‌ها. یه جمله‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.64,
   "end": 183.96,
   "text": "خیلی شریف، خیلی عرشی حضرت علامه دارن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.96,
   "end": 186.28,
   "text": "ج-جلسه هشتاد و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 186.28,
   "end": 188.94,
   "text": "شرح فصوصشون اینو باز کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.94,
   "end": 193.8,
   "text": "خیلی عالی. من اجمالاً همینجا تو این فرصت کوتاهی که دارم عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.8,
   "end": 199.06,
   "text": "علامه می‌فرماید همونطور که انسان مزاج داره، عالم هم مزاج داره، عالم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.06,
   "end": 201.42,
   "text": "مزاج داره. همونطوری که اگر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.42,
   "end": 209.28,
   "text": "به مخالف مزاج وجود خودت غذا بخوری حالت تهوع پیدا می‌کنی و پس می‌زنی اون غذا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.28,
   "end": 211.62,
   "text": "چون مخالف با مزاج توئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.62,
   "end": 216.2,
   "text": "و بالا میاری. عالم هم اگر بر خلاف مزاجش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.2,
   "end": 221.36,
   "text": "کاری صورت بگیره حال تهوع پیدا می‌کنه و تو رو پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.36,
   "end": 224.1,
   "text": "تو رو پس می‌زنه یعنی می‌ری زیر اسم انت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.1,
   "end": 227.8,
   "text": "المنتقم حضرت حق و خدا از تو تو همین دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.8,
   "end": 231.2,
   "text": "انتقام می‌گیره. حالا يوم تبلی السرائر که بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.2,
   "end": 233.8,
   "text": "همینجا آبروت میره، رسوا میشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.8,
   "end": 238.04,
   "text": "گرفتاری‌ها پیدا می‌کنی، ضیغ معش-- معیشتی پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.04,
   "end": 240.76,
   "text": "«و من أعرض عن ذکری»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.76,
   "end": 245.02,
   "text": "آیه قرآن هرکس که اعراض کنه، پشت کنه به ذکر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.02,
   "end": 248.04,
   "text": "«فإن قطعاً قطعاً له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.04,
   "end": 250.18,
   "text": "معیشة ضنکا»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.18,
   "end": 254.06,
   "text": "تو همین دنیا دچار زنک معیشتی می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.06,
   "end": 256.24,
   "text": "چون پشت کرده به ذکر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 256.24,
   "end": 258.56,
   "text": "ف-- و تازه این مال این دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 258.56,
   "end": 262.94,
   "text": "«ونحشره يوم القيامة أعمى» قیامت هم نابینا محشور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.94,
   "end": 266.14,
   "text": "اون مال اون وره. يوم تبلی السرائر که باطنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.14,
   "end": 268.52,
   "text": "آشکار می‌شه. چرا نابینا محشور می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 268.52,
   "end": 271.78,
   "text": "چون اینجا هم نابینا بود. باطناً اینجا نابینا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 271.78,
   "end": 276.04,
   "text": "نور الهی رو نمی‌دید. لذا همه-- همش سمت ظلمت‌ها می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.04,
   "end": 278.86,
   "text": "اون ور باطن آشکار شد. نابیناست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 278.86,
   "end": 284.56,
   "text": "توجه کردی؟ این مخالفت با مزاج عالم انسان رو یه همچین بلایی سر انسان میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.56,
   "end": 286.54,
   "text": "که حداقل دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.54,
   "end": 290.28,
   "text": "از آیات قرآن سنت استدراج خدا رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.28,
   "end": 293.44,
   "text": "متأسفانه ما مذهبی‌ها خیلی در خطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 293.44,
   "end": 296.56,
   "text": "استدراج هستیم و بی‌توجه‌ایم به این قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 296.56,
   "end": 301.48,
   "text": "که خدا رفته رفته می‌بینی یا هی گناه می‌کنی لابلای عباداتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 301.48,
   "end": 305.0,
   "text": "هی گناه می‌کنی و اصلاً حواست نیست، توجه نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 305.0,
   "end": 307.04,
   "text": "مخصوصاً این‌هایی که گناهان اشتباهی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 307.04,
   "end": 310.46,
   "text": "اجتماعی تو گن-- مثلاً اون جلسه‌ای که رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 310.46,
   "end": 315.76,
   "text": "عزیز اون با آقای بهجت داشتن آخرین جلسه‌ای که سی و پنج دقیقه فقط همدیگه رو نگاه کرده بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 315.76,
   "end": 318.12,
   "text": "و سرشون پایین هی نگاه سر پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 318.12,
   "end": 321.32,
   "text": "حالا به نحو اشراق از همدیگه بهره برده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 321.32,
   "end": 326.32,
   "text": "سرح اس-- اطلاقی یکی از مقامات اولیاء الله از هر قیدی خارج می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 326.32,
   "end": 330.48,
   "text": "و می‌تونن در درون هم غور کنن، از درون هم بهره بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 330.48,
   "end": 336.36,
   "text": "یه بحثی که قبلاً گذشته در ش-- رساله شرح رساله نهج‌البلاغه استاد اونجا ما گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 336.36,
   "end": 340.64,
   "text": "بعد این‌ها سی و پنج دقیقه همدیگه رو نگاه می‌کنند یا در همدیگه غور می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.64,
   "end": 343.98,
   "text": "چ-- وقتی می‌خوان پاشن آقای بهجت یه جمله میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 343.98,
   "end": 350.04,
   "text": "می‌فرماید که انسان خوب است گناه نکند و اگر می‌کند گناه اجتماعی نکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.04,
   "end": 356.7,
   "text": "گناه اجتماعی خیلی بده. آدم مثلاً آبروی یکی رو تو اجتماع ببره یا تو جمع یکی رو تحقیر کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 356.7,
   "end": 359.56,
   "text": "یا تو جمع مثلاً یه حرف زشتی بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 359.56,
   "end": 364.42,
   "text": "کراهت مثلاً کراهت یه گناهی رو قبش رو بشکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.42,
   "end": 371.98,
   "text": "نمیدونم آقا مثلاً یه زنو ببینه بگه عجب حوری بهشتی دنیایی فلان مثلاً اون عظمت حوری بهشتی رو اینطوری قبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.98,
   "end": 378.84,
   "text": "این عظمتش رو بشکنه با شکستن قبح نگاه به نامحرم و امثالهم و و و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.84,
   "end": 381.92,
   "text": "اگر به مزاج عالم در بیفتی عالم باهات در میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.92,
   "end": 386.64,
   "text": "یه اصل اصیله. حالا مزاج عالم چیه بگم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.64,
   "end": 392.9,
   "text": "البته یه جمله ای از حضرت امام آماده کرده بودم خیلی شیرین بخونم دیگه فرصت نیست چون بعد از عصر هم می‌خوایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.9,
   "end": 396.0,
   "text": "روضه هم بخونیم همین مقدار بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 396.0,
   "end": 398.62,
   "text": "میگه در خانه اگر کس است یک حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.62,
   "end": 400.94,
   "text": "بس است. مزاج عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 400.94,
   "end": 403.44,
   "text": "اهل بیت فرمودند که بالعدل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 403.44,
   "end": 406.96,
   "text": "ببینید بالعدل قامت السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.96,
   "end": 411.62,
   "text": "تو قرآن هم می‌فرماید هو الذي خلق السماوات والأرض بالحق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 411.62,
   "end": 415.22,
   "text": "نظام عالم بر اساس حقه و عدله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 415.22,
   "end": 419.06,
   "text": "اگر کسی ناحق کنه ناحق بگه ناحق ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 419.06,
   "end": 423.44,
   "text": "یا کسی ظلم کنه بر خلاف عدل حرف بزنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 423.44,
   "end": 425.84,
   "text": "رأی بده، عمل کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 425.84,
   "end": 429.6,
   "text": "یعنی خب وز-- عدل هم که وضع الشی في موضعش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.6,
   "end": 431.66,
   "text": "یعنی هر چیزی تو جای خودش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.66,
   "end": 434.62,
   "text": "آدم متلاشی‌ایه، اصلاً نظم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 434.62,
   "end": 436.86,
   "text": "این قطعاً دچار سنت استدراج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.86,
   "end": 439.94,
   "text": "خدا ولش می‌کنه و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.94,
   "end": 442.24,
   "text": "بر خلاف مزاج عالم عمل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.24,
   "end": 443.96,
   "text": "عالم به جنگش بلند می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 443.96,
   "end": 447.22,
   "text": "عالم یعنی زمین و زمان به جنگش بلند می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 447.22,
   "end": 450.84,
   "text": "هر کاری بکنه می‌خواد کمرش رو راست کنه بدتر می‌زننش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 450.84,
   "end": 458.22,
   "text": "این یه قاعده‌ست. تو همین دنیا هم رخ می‌ده بعد دیگه اصلش اون وله که يوم تبلى السرائر که دیگه وحشتناک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.22,
   "end": 463.36,
   "text": "یعنی اگر کسی بخوا-- آقا تذکر هم بخوای به کسی بدی آبروش رو حفظ کن تذکر بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 463.36,
   "end": 465.68,
   "text": "نری تو جمع تخریبش کنی و بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 465.68,
   "end": 468.5,
   "text": "می‌خوای برای کسی حالا می‌خوای یکیو نصیحت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 468.5,
   "end": 472.82,
   "text": "برو، برو به خودش بگو. چرا باید براش پرونده سازی می‌کنی آبروشو می‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 472.82,
   "end": 474.84,
   "text": "این‌ها متأسفانه غوغا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 474.84,
   "end": 477.3,
   "text": "بعد می‌گیم چرا نماز ما نماز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 477.3,
   "end": 479.12,
   "text": "صلاة معراج الموجین. چی میگین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 479.12,
   "end": 481.78,
   "text": "این حرفا چیه؟ معراج کجا بود؟ خبری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 481.78,
   "end": 488.66,
   "text": "اصلاً دور شدیم از ملکوت. مزاج عالمو باهاش در بیوفتی عالم می‌ری ذیل اسم المنتقم حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 488.66,
   "end": 491.52,
   "text": "بعد تازه در خصوص استدراج هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 491.52,
   "end": 496.8,
   "text": "چند تا شعبه داره. یه وقت هست تو گناه من گناه می‌کنم قاطی عبادتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 496.8,
   "end": 499.32,
   "text": "سنت استدراج خدا ولت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 499.32,
   "end": 501.2,
   "text": "یه بعد فکر می‌کنی نه کارت درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 501.2,
   "end": 503.04,
   "text": "خدا کاری با من انگار نداره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 503.04,
   "end": 505.08,
   "text": "کارم درسته انگار. نه ولت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 505.08,
   "end": 507.96,
   "text": "مثل بادبادکی که هی استدراج می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 507.96,
   "end": 510.06,
   "text": "هی بهش نخ میدی میره، میره، میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 510.06,
   "end": 514.62,
   "text": "سر و گوشش می‌جنبه تو آسمون رفته اصلاً دور شده از اصلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 514.62,
   "end": 516.62,
   "text": "یا اینکه نعمت رو شکر نمیگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 516.62,
   "end": 519.22,
   "text": "اینم حدیث داریم. هی نعمت‌ها رو شکر نمیگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 519.22,
   "end": 521.68,
   "text": "هی مینالی. هی نق می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 521.68,
   "end": 524.12,
   "text": "دچار سنت استدراج الهی می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 524.12,
   "end": 528.9,
   "text": "یا نه حتی در کشف و کرامات بسنده می‌کنی به همین نخود کیش میاد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 528.9,
   "end": 534.08,
   "text": "کیش میشا، به خواب خوب، به حتی طی الارض، به نمی‌دونم ماف الزمیر خوندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 534.08,
   "end": 538.16,
   "text": "دلخوش می‌کنی به اینا از قرب و مقام لقای الهی غافل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 538.16,
   "end": 542.58,
   "text": "می‌شی. اینم استدراجه. اینم خدا ولت می‌کنه چون از اصل غافل شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 542.58,
   "end": 547.48,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 547.48,
   "end": 550.2,
   "text": "اللهم صل على محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 550.2,
   "end": 553.34,
   "text": "آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 553.34,
   "end": 556.84,
   "text": "آله محمد. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 556.84,
   "end": 568.94,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 568.94,
   "end": 574.72,
   "text": "صل و سلم على الرسول و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 574.72,
   "end": 579.08,
   "text": "آل النبي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 579.08,
   "end": 583.78,
   "text": "اللهم صل و سلم على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.78,
   "end": 586.5,
   "text": "الرسول و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 586.5,
   "end": 589.18,
   "text": "آل النبي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 589.18,
   "end": 591.18,
   "text": "اللهم صل و سلم على الرسول و آل النبي العظيم. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 591.18,
   "end": 594.34,
   "text": "صل و سلم على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 594.34,
   "end": 596.96,
   "text": "الرسول و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 596.96,
   "end": 601.42,
   "text": "آل النبي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}