 },
 "chapters": [
  {
   "index": 0,
   "title": "## کلمهٔ بیست‌ویکم؛ حاکمیتِ طبیعت بر عقل",
   "start": 7.44,
   "end": 27.52
  },
  {
   "index": 1,
   "title": "## عقلانیتِ امام؛ حقیقتِ محمّدیّه و عقلِ نظری و عملی",
   "start": 27.52,
   "end": 177.52
  },
  {
   "index": 2,
   "title": "## احسن تقویم",
   "start": 177.52,
   "end": 207.18
  },
  {
   "index": 3,
   "title": "## روایتِ ابن عباس؛ الخرف و أرذل العمر",
   "start": 207.18,
   "end": 443.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.76,
   "end": 5.06,
   "text": "یا داعی الله و ربانی ایاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.06,
   "end": 7.44,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.44,
   "end": 12.48,
   "text": "کلمه بیست و یکم. آنکه طبیعتش را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.48,
   "end": 15.98,
   "text": "بر عقلش حاکم گردانیده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.98,
   "end": 20.5,
   "text": "در محکمه‌ی هر بخردی محکوم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.5,
   "end": 24.98,
   "text": "خب این مرتبه‌ی طبیعت همون انزل مراتب وجودی انسان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.98,
   "end": 29.7,
   "text": "یعنی بدن که الان ما در نشئه طبیعت هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.7,
   "end": 34.92,
   "text": "اون مرتبه‌ی عقل هم که مرتبه‌ی اشرف و اشمخ انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.92,
   "end": 38.38,
   "text": "عقل وجود انسان که خدا حالا دهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.38,
   "end": 43.04,
   "text": "فجر ااا پرنور هم هست، یاد می‌کنیم از امام عزیزمون شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.04,
   "end": 46.28,
   "text": "امام خیلی تاکید بر عقلانیت داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.28,
   "end": 49.74,
   "text": "اصلا انقلاب ایشون انقلاب عقلانیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.74,
   "end": 53.36,
   "text": "بود سلام علیه و همون روزی هم که آمدن تو بهشت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.36,
   "end": 57.9,
   "text": "زهرا سلام الله علیها توصیه‌شون این بود که ما آمدیم شما رو به تعالی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.9,
   "end": 61.64,
   "text": "تعالی معنوی و عقلی برسونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.64,
   "end": 67.06,
   "text": "که حالا عرض شود خدمتتون در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.06,
   "end": 72.3,
   "text": "نگاه امام اگر کسی اهل تحقیق بوده باشه میدونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.3,
   "end": 82.24,
   "text": "امام عقل رو کلا م- وقتی موضوع عقل رو از امام بپرسی در آثارشون می‌بینی عقل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.24,
   "end": 86.04,
   "text": "اولاً خود حقیقت عقل رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.04,
   "end": 91.9,
   "text": "مبدأ عوالم هم بالایی هم مادونه، اون وجود منبسط و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.9,
   "end": 99.82,
   "text": "صادر نخستین میدونه که به یک معنا حقیقت محمدیه هم بهش میگن صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.82,
   "end": 102.0,
   "text": "و عالم عقلی رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.0,
   "end": 107.9,
   "text": "عالم عقلی رو میاد حضرت امام به دو بخش تقسیم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.9,
   "end": 112.08,
   "text": "عالم عقلی انسانی و غیرانسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.08,
   "end": 114.98,
   "text": "و اون عالم عقلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.98,
   "end": 118.82,
   "text": "غیرانسانی رو عقل کل می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.82,
   "end": 120.72,
   "text": "عقل کل که همه مادون اونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.72,
   "end": 125.1,
   "text": "عالم عقلی انسانی که الان مورد بحث ماست رو میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.1,
   "end": 128.3,
   "text": "دو بخش عقل عملی، عقل نظری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.3,
   "end": 135.54,
   "text": "عقل نظری میشه همین مباحث عقلی، مباحث برهانی، مباحث فلسفی و حکمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.54,
   "end": 138.46,
   "text": "عقل عملی هم به یک معنا یعنی همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.46,
   "end": 141.4,
   "text": "عرفانه، عرفان. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.4,
   "end": 143.36,
   "text": "که بعد امام می‌فرماید عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.36,
   "end": 147.28,
   "text": "نظری باید بیاد در خدمت عقل عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.28,
   "end": 155.78,
   "text": "یعنی کسی عاقله که هم در حوزه ورزش فکری به قول حضرت آقا مصطفی نژاد حرکت کرده، مباحث عقلی رو دیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.78,
   "end": 157.7,
   "text": "و هم اون رو پیاده کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.7,
   "end": 163.24,
   "text": "این یه مجموعه کاملی، یه هرمی بود که هندسه فکری حضرت امام رو بر اساس حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.24,
   "end": 167.12,
   "text": "نگاهشون به عقل بیان کردیم که اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.12,
   "end": 170.86,
   "text": "در آیه چهار و پنج سوره تين اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.86,
   "end": 175.9,
   "text": "دقت فرموده باشید \"لقد خلقنا الانسان في احسن تقويم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.9,
   "end": 181.56,
   "text": "اینجا می‌فرماید ما خلق کردیم انسان رو در بهترین وجه و نیکوترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.56,
   "end": 184.38,
   "text": "وضعیت ممکن که اونجا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.38,
   "end": 189.38,
   "text": "مفسرین روایاتی آوردن خصوصاً در تفاسیر رواییمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.38,
   "end": 194.34,
   "text": "که این احسن تقويم رو بعض از تفاسیر زدن به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.34,
   "end": 198.5,
   "text": "یعنی اون بهترین حالتش همون عقل اوله که پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.5,
   "end": 200.86,
   "text": "باز عقل اوله، عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.86,
   "end": 208.46,
   "text": "و در بعض از تفاسیر هم گفتن یعنی اینکه انسان عقلش غالب بشه بر همه قوای وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.46,
   "end": 212.8,
   "text": "یعنی سلطان و مالک وجودش، رهبر وجودش بشه عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.8,
   "end": 219.22,
   "text": "نه وهم، نه خیال. عقلی نگاه کنه، عقلی بچشه، عقلی گوش بده، عقلی حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 219.22,
   "end": 222.46,
   "text": "به این صورت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.46,
   "end": 225.36,
   "text": "حالا تفاسیر دیگه‌ای هم گفتن که کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.36,
   "end": 227.98,
   "text": "اما آیه بعدش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.98,
   "end": 230.82,
   "text": "\"ثم رددناه اسفل سافلین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.82,
   "end": 234.42,
   "text": "خدا اینجا آیه پنج سوره تين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 234.42,
   "end": 239.98,
   "text": "خدا اینجا بیان می‌کنه که ما سپس اون رو به پایین‌ترین مرحله باز گرداندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.98,
   "end": 243.94,
   "text": "اینجا باز تفاسیر روایی بعضی‌ها گفتن اسفل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.94,
   "end": 248.64,
   "text": "بر وزن انزل پایین‌ترین یا پست‌ترین مراتب همون درکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.64,
   "end": 251.58,
   "text": "جهنمه که اگر کسی دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.58,
   "end": 254.16,
   "text": "اینجا جمله چی بود؟ جمله علمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.16,
   "end": 257.74,
   "text": "آنکه طبیعتش را بر عقلش حاکم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.74,
   "end": 262.32,
   "text": "یعنی معذرت میخوام حیوانی زندگی کنه، عقلش رو تعطیل کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.32,
   "end": 265.06,
   "text": "در محکمه‌ی هر بخردی محکوم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.06,
   "end": 269.1,
   "text": "یعنی حیوانی زندگی کنه یعنی اینجا می‌فرماید \"اسفل سافلین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.1,
   "end": 272.92,
   "text": "یعنی پست‌ترین مراتب خودشو بلکه بلهم ازل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 272.92,
   "end": 274.94,
   "text": "یعنی جهنم. یعنی درک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.94,
   "end": 277.88,
   "text": "بعضی از روایات که اینا همه قابل جمع‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.88,
   "end": 280.26,
   "text": "هر آیه بطون متعددی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.26,
   "end": 284.48,
   "text": "این روایت هم بگم خیلی شیرینه به دردتون، به درد همه ما الان می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.48,
   "end": 287.68,
   "text": "مخصوصا اینایی که دیگه پا به سن دارن میذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.68,
   "end": 291.26,
   "text": "سند تفسیر اهل بیت ج هجده، صفحه دویست و چهارده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.26,
   "end": 295.38,
   "text": "ابن عباس می‌فرمایده، ابن عباس هم از رووات خیلی قوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.38,
   "end": 300.68,
   "text": "ماست. می‌فرماید \"ثم رددناه اسفل سافلین\" می‌خواد اینو باز کنه وجهش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.68,
   "end": 304.62,
   "text": "\"يريد الى الخرف\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 304.62,
   "end": 307.04,
   "text": "شنیدین میگن فلانی خرف شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 307.04,
   "end": 310.22,
   "text": "از اینجا گرفته شده. خرف یعنی کودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.22,
   "end": 316.24,
   "text": "معذرت میخوام نفه. یعنی میخواد بگه این آیه دلالت بر اینجور آدما داره که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.24,
   "end": 319.26,
   "text": "عقلت رو تعطیل کنی به اینجور جاها می افتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 319.26,
   "end": 323.92,
   "text": "\"وأرول العمر\" البته \"أرول العمر\" رو قبلاً تو آیه حج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.92,
   "end": 326.1,
   "text": "فکر می‌کنم آیه پنج بود حالا عددش یادم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.1,
   "end": 327.9,
   "text": "در سوره حج اونجا بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 327.9,
   "end": 330.3,
   "text": "یعنی اون حالت فرتوتگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.3,
   "end": 332.68,
   "text": "افتاده‌حالی که انسان می‌بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.68,
   "end": 335.88,
   "text": "خدا انسان رو می‌بره از اون قوت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.88,
   "end": 338.56,
   "text": "شباب و جوانی می‌کشونه به حالت پیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.56,
   "end": 342.12,
   "text": "\"والحرم\" یعنی کهنسالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.12,
   "end": 348.86,
   "text": "می‌بره به اون ضعف. قاعده‌ست اینا همه به سمت ضعف میرن \"ونقصان العقل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.86,
   "end": 352.82,
   "text": "یه نقصی در عقلش ایجاد میشه \"والسافلون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.82,
   "end": 356.0,
   "text": "هم الزف-- ضعفاء\". حالا این داره میگه این سافلون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.0,
   "end": 359.38,
   "text": "\"ثم رددناه اسفل سافلین\" سافلون کیان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.38,
   "end": 364.94,
   "text": "\"هم الزعفاء\" آدمای ضعیف \"وزم-- وزمنای\" یعنی اونایی که زمین‌گیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.94,
   "end": 369.14,
   "text": "\"والاطفال\" بچه‌ها \"والشيخ الكبير\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.14,
   "end": 373.48,
   "text": "پیرمردا یا پیرزن‌ها \"اسفل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.48,
   "end": 376.04,
   "text": "اولئك جميع\". اینا همه همون اسفل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.04,
   "end": 380.02,
   "text": "یعنی دیگه اون حالت مثلا ضعف تمام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.02,
   "end": 384.26,
   "text": "فرتوتگی اینا میفتن و قراره همه ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.26,
   "end": 388.7,
   "text": "به اون سمت بریم و همه داریم الان به، به سمت اون کهولت میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.7,
   "end": 392.36,
   "text": "مهم اینجاست که مراقب باشیم نقص در عقل رخ نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.36,
   "end": 394.72,
   "text": "هرچی پیرتر میشیم عقلمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.72,
   "end": 398.28,
   "text": "قوی‌تر بشه رفقا. اینجا خیلی مهمه این نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.28,
   "end": 403.62,
   "text": "که آدمایی که این رو مورد توجه قرار میدن هرچی پیرتر میشن عاقل‌ترن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.62,
   "end": 407.52,
   "text": "درسته بدنشون ضعیف‌تر میشه اما عقلشون قوی‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 407.52,
   "end": 409.68,
   "text": "آدمای موفق‌تری‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.68,
   "end": 413.86,
   "text": "میری پیش اون میگی چند تا پیرهن بیشتر پاره کرده یعنی عقلش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.86,
   "end": 419.62,
   "text": "اما نه، اونایی که هوای نفسشون رو غالب کردن، عقلشون مشوب به وهم و هوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.62,
   "end": 429.0,
   "text": "نفس شده. نه، مطلقا از اینا نباید خیرخواهی کنی، مشورت بگیری چون زدن اون عقلیت وجودشونو که نظام احسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 429.0,
   "end": 432.04,
   "text": "و اشمخ و اشرف وجودشونه اون رو از بین بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 432.04,
   "end": 435.02,
   "text": "گرفتار هوای نفس شدن. ان شا الله عاقبتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 435.02,
   "end": 443.3,
   "text": "خیر باشه و برکت صلوات بر محمد و آل محمد. اللهم صل على محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}