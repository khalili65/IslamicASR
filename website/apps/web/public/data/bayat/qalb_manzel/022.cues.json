 },
 "chapters": [
  {
   "index": 0,
   "title": "## آیهٔ پنج سجده و قوس نزول و عروج",
   "start": 8.3,
   "end": 116.42
  },
  {
   "index": 1,
   "title": "## قلب و وحدت شخصیه؛ حجاب و بهشت و جهنم",
   "start": 116.42,
   "end": 155.08
  },
  {
   "index": 2,
   "title": "## شنود شب و شهود روز",
   "start": 155.08,
   "end": 577.61
  },
  {
   "index": 3,
   "title": "## علامه و زبان زمین",
   "start": 577.61,
   "end": 804.24
  },
  {
   "index": 4,
   "title": "## هیچ چاره‌ای از عروج نیست",
   "start": 804.24,
   "end": 912.7
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 5.84,
   "text": "و بهی نستعین. السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.84,
   "end": 8.3,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.3,
   "end": 11.42,
   "text": "از فرصت پیش آمده نهایت بهره رو بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.42,
   "end": 16.48,
   "text": "حالا که گرد هم هستیم تبرکی بجوییم از آینه آیات و روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.48,
   "end": 19.56,
   "text": "آیه پنج سوره سجده رو قطعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.56,
   "end": 22.42,
   "text": "دقت کردید چون قبلا در مباحث سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.42,
   "end": 24.08,
   "text": "قبل در قرآن هم گفته بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.08,
   "end": 30.02,
   "text": "خیلی عجیب آیه‌ای \"یدبر الأمر من السماء إلى الأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.02,
   "end": 33.24,
   "text": "دقت بفرمایید \"یدبر الأمر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.24,
   "end": 38.06,
   "text": "تدبیر، خدای منان تدبیر می‌کند امر را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.06,
   "end": 41.6,
   "text": "از کجا؟ \"من السماء إلى الأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.6,
   "end": 44.74,
   "text": "قوس چگونه است؟ نزول یا صعود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.74,
   "end": 47.34,
   "text": "\"من السماء إلى الأرض\" به سوی أرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.34,
   "end": 54.72,
   "text": "این قوس نزول است. خدا تدبیر کرده از عالم امر، از اون عالم بالایی، الوها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.72,
   "end": 58.72,
   "text": "از اونجا قوس نزول شروع شده اومده تا جماد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.72,
   "end": 61.4,
   "text": "انزل مراتب. بعد چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.4,
   "end": 65.8,
   "text": "\"ثم يعرج إليه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.8,
   "end": 70.0,
   "text": "این های ضمیر برمی‌گرده به همون حضرت حق \"یدبر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.0,
   "end": 72.44,
   "text": "که تدبیر می‌کند. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.44,
   "end": 74.64,
   "text": "یعنی شما حالا وظیفتونه که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.64,
   "end": 77.46,
   "text": "این انزل مراتب که ظلمت سراست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 77.46,
   "end": 81.42,
   "text": "نسبت به اون مراتب بالاتر ظلمت دارد، نه اینکه ظلمت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 81.42,
   "end": 86.74,
   "text": "اینم دنیا هم عین نوره. چون کلمات وجودی نظام هستیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.74,
   "end": 89.14,
   "text": "چون شؤون اسمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.14,
   "end": 92.44,
   "text": "است. پس نوره. نسبت به مراتب مافوق ظلمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 92.44,
   "end": 95.74,
   "text": "میگه حالا وظیفه شما اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 95.74,
   "end": 98.0,
   "text": "آماده باشید برای عروج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 98.0,
   "end": 99.78,
   "text": "کی شما رو به معراج می‌بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 99.78,
   "end": 103.88,
   "text": "خدا می‌بره اما شما آماده باشید که \"يعرج إليه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 103.88,
   "end": 107.88,
   "text": "که اگر آماده نباشید بدون آمادگی هم \"يعرج إليه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 107.88,
   "end": 110.42,
   "text": "اما با حجاب می‌رید و نمی‌فهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 110.42,
   "end": 115.56,
   "text": "فهمتون منقطع می‌شه. خیلی آیه عجیبیه که در امور مختلف می‌شه بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 115.56,
   "end": 120.48,
   "text": "استناد کرد. بحث ما چون قلبه در قرآن بود و قلب منزل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 120.48,
   "end": 123.72,
   "text": "این آیه داره به زیبایی تمام به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 123.72,
   "end": 128.1,
   "text": "اون وحدت شخصیه وجود به ذات مظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 128.1,
   "end": 133.48,
   "text": "از جهت صع و ذیق توجه می‌ده ما رو که این مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.48,
   "end": 137.16,
   "text": "مظاهر یعنی موجودات هم مراتب دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 137.16,
   "end": 141.72,
   "text": "از جماد بگیر برو حالا از نش-- اینطوری بخواهیم به صورت کلی بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 141.72,
   "end": 146.7,
   "text": "از نشئه طبیعت برو مثال و عقل و الهیت نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 146.7,
   "end": 153.94,
   "text": "یا عالم امر. خب؟ یعنی از اونجا اومدی حالا خودت رو ما کمکت می‌کنیم دو مرتبه برگردی اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.94,
   "end": 157.06,
   "text": "رسیدنه به اونجا این می‌شود کمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 157.06,
   "end": 158.98,
   "text": "خب قلب کجاست مرتبه‌اش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 158.98,
   "end": 161.0,
   "text": "اون بالاییه است. اون بالای بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 161.0,
   "end": 164.14,
   "text": "الهیته دیگه. الهیت قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 164.14,
   "end": 167.28,
   "text": "قلب اونجاست. تنزل صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.28,
   "end": 169.98,
   "text": "یعنی مراتب شؤون مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 169.98,
   "end": 172.14,
   "text": "صورت گرفته بل اجبار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 172.14,
   "end": 174.86,
   "text": "توجه کردید؟ حالا اختیار رو به خودت دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 174.86,
   "end": 177.24,
   "text": "ما دو مرتبه می‌خوایم ببریمت بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 177.24,
   "end": 179.38,
   "text": "آماده‌ای یا نه؟ بالاخره می‌بریمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 179.38,
   "end": 181.4,
   "text": "اما می‌تونی در حجاب بیای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 181.4,
   "end": 185.76,
   "text": "یا بی‌حجاب بیای. با حجاب بیای خودت می‌شه همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 185.76,
   "end": 189.46,
   "text": "به یک معنا با حجاب ببریمات بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 189.46,
   "end": 191.74,
   "text": "می‌شود عذاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 191.74,
   "end": 194.38,
   "text": "می‌شود سختی. می‌شود اون فشار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 194.38,
   "end": 197.86,
   "text": "می‌شود اون ظلمت. چون هنوز تو عالم ظلمتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 197.86,
   "end": 200.32,
   "text": "خودت نخواستی. در یک حجابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 200.32,
   "end": 203.58,
   "text": "اگر بدون حجاب بیای می‌شود بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 203.58,
   "end": 205.66,
   "text": "اون اولیه می‌شه جهنم، این می‌شه بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 205.66,
   "end": 209.24,
   "text": "ببینید چقدر راحت همه مطالب با هم چفت و جور می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 209.24,
   "end": 211.76,
   "text": "حالا باید سعی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 211.76,
   "end": 215.42,
   "text": "که ما از این مراتب نازله برسیم به اون مراتب عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 215.42,
   "end": 219.66,
   "text": "اینو خوب دقت کنید اینجا رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 219.66,
   "end": 222.84,
   "text": "هر چیزی، هر عینی، ما اعیانیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 222.84,
   "end": 225.02,
   "text": "ما اشیا ایم، اسما ایم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 225.02,
   "end": 226.72,
   "text": "اعیان بیرون از ذاتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 226.72,
   "end": 229.08,
   "text": "به عبارتی می‌شه گفت خارجیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 229.08,
   "end": 232.48,
   "text": "خارج از ذاتیم. شؤون حضرت حقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 232.48,
   "end": 239.3,
   "text": "که وقتی ما برگردیم به ذات مستهلک می‌شیم، مندمج می‌شیم به احدیت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 239.3,
   "end": 241.98,
   "text": "ما وقتی در ذات بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 241.98,
   "end": 245.06,
   "text": "عین-- وقتی در عین ذات بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 245.06,
   "end": 248.86,
   "text": "عین علم الهی بودیم. توجه بفرمایید چی دارم میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 248.86,
   "end": 252.56,
   "text": "ما در ذات بودیم دیگه. وقتی که در ذات بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 252.56,
   "end": 259.66,
   "text": "وقتی عین در علم حضرت حق بودیم، این اعیان، اعیان که یکیش ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 259.66,
   "end": 263.94,
   "text": "عینی که-- عینیت ما وقتی در عین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 263.94,
   "end": 267.5,
   "text": "حضرت حق بودیم، اونجا الهی بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 267.5,
   "end": 273.76,
   "text": "الهی بودیم. وقتی تنزل پیدا کردیم یعنی از عین ذات، از عین علم خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 273.76,
   "end": 277.46,
   "text": "خارج شدیم، شدیم به طور عقلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 277.46,
   "end": 282.18,
   "text": "و طور مثالی و طور طبیعی یا نشئه ملکمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 282.18,
   "end": 286.8,
   "text": "طور مادی. دو مرتبه وقتی با-- می‌خوایم بگردیم این سلسله باید چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 286.8,
   "end": 290.58,
   "text": "برگردیم \"ثم يعرج إليه\" این سلسله باید طی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 290.58,
   "end": 294.04,
   "text": "دو مرتبه باید برگردیم به طور مثالی‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 294.04,
   "end": 298.18,
   "text": "که اگر بر نگردیم ما به زور برامون می‌گردونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 298.18,
   "end": 301.4,
   "text": "این یک معنی میگم اگه بر نگردیم، چگونه برگردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 301.4,
   "end": 304.16,
   "text": "موت قبل ان تموت. این موت اختیاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 304.16,
   "end": 306.28,
   "text": "باید بریم به طور مثالی‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 306.28,
   "end": 311.42,
   "text": "باید بریم به طور عقلیمون که برسه دستمون به الهیت نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 311.42,
   "end": 315.7,
   "text": "از طریق قلبمون که قلب مقام اون بالا رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 315.7,
   "end": 319.38,
   "text": "بریم به طور قلبی‌مون. خب این‌ها تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 319.38,
   "end": 323.16,
   "text": "به چگونه صورت می‌گیره؟ با شنود و شهود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 323.16,
   "end": 326.22,
   "text": "شنود و شهود. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 326.22,
   "end": 330.74,
   "text": "شنود که حالا طبق آیاتی که حالا انشالله فردا براتون میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 330.74,
   "end": 335.78,
   "text": "طبق آیاتی که آیه هفتاد و یک و هفتاد و دو سوره قصص باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 335.78,
   "end": 339.44,
   "text": "شنود رو خدا طبق آیات می‌زنه به شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 339.44,
   "end": 342.76,
   "text": "شهود رو می‌زنه به روز. که این رمزه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 342.76,
   "end": 345.58,
   "text": "در جلسه قبل هم عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 345.58,
   "end": 349.56,
   "text": "کسی که نماز شب نمی‌خونه تا شیطان که اسمش رهاست میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 349.56,
   "end": 352.78,
   "text": "یه کاری می‌کنه که بالاخره رهاش کنه از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 352.78,
   "end": 356.2,
   "text": "قید و بند الهی تا جایی که نماز صبحش هم قضا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 356.2,
   "end": 360.34,
   "text": "اون شیطان اسمش رها بود، میاد انسان رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 360.34,
   "end": 362.9,
   "text": "دل شب غافل کنه. شب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 362.9,
   "end": 366.25,
   "text": "شب مال شنوده روز مال شهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 366.25,
   "end": 370.45,
   "text": "اگر شنود شب داشتی شهود روز پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 370.45,
   "end": 374.55,
   "text": "توجه کردید؟ که اگر این‌ها قطع بشن زنجیره‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 374.55,
   "end": 381.93,
   "text": "ما تو همین عالم طبیعت می‌مانیم و لو بریم به عالم برزخ ببرنمون، ببرنمون \"ثم یعرج الیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 381.93,
   "end": 385.47,
   "text": "ببرن ما رو یعنی بمیریم. بمیرانند ما را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 385.47,
   "end": 389.19,
   "text": "به مرگ اجباری ببرن به موت اجباری باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 389.19,
   "end": 391.81,
   "text": "تو نشئ طبیعت سرگردانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 391.81,
   "end": 394.45,
   "text": "یعنی باور نمی‌کنیم که رفتیم تو عالم مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 394.45,
   "end": 396.51,
   "text": "می‌گن ارواح سرگردان. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 396.51,
   "end": 400.91,
   "text": "چون علقه داریم. طرف می‌بینی حدیث داریم هزار سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 400.91,
   "end": 402.97,
   "text": "سکرات مرگش طول می‌کشه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 402.97,
   "end": 406.99,
   "text": "یعنی همین که گفتم. طوره هنوز تو طور طبیعیش مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 406.99,
   "end": 408.59,
   "text": "نمی‌خواد باور کنه که رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 408.59,
   "end": 411.03,
   "text": "نمی‌کنه. نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 411.03,
   "end": 414.49,
   "text": "توجه کردید؟ این سختی جان کندن یه معناش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 414.49,
   "end": 417.13,
   "text": "می‌خوان طورشو اول کن-- عوض کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 417.13,
   "end": 420.13,
   "text": "این خودش پابند این نشئ طبیعت مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 420.13,
   "end": 422.97,
   "text": "به شنود و شهود نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 422.97,
   "end": 424.77,
   "text": "باید طورشو عوض کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 424.77,
   "end": 427.87,
   "text": "حداقل چی بود که جلسه پیش عرض کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 427.87,
   "end": 432.17,
   "text": "شروع کنه که از جهت طور مثالی خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 432.17,
   "end": 436.61,
   "text": "شنود کنه عالم مثال وجود خودش رو حداقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 436.61,
   "end": 440.93,
   "text": "یعنی اینکه صدای عالم مثال وجودش رو بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 440.93,
   "end": 444.33,
   "text": "الان من دارم می‌گم بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 444.33,
   "end": 446.95,
   "text": "الحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 446.95,
   "end": 450.49,
   "text": "خب این یه صوت کمه مسموعه معروض به عالم ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 450.49,
   "end": 453.41,
   "text": "آیا طور مثالی همین آیه رو هم می‌شنوم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 453.41,
   "end": 455.95,
   "text": "شنود می‌کنه وجودم، نفسم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 455.95,
   "end": 459.69,
   "text": "اگه شنود نمی‌کنه تو همین نشئ طبیعتم هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 459.69,
   "end": 463.85,
   "text": "و دچار غفلم و از دل شب استفاده نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 463.85,
   "end": 465.87,
   "text": "دل شب به شنود می‌کشونه آدمو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 465.87,
   "end": 473.45,
   "text": "لذا شیطان تمام قوتشو جمع می‌کنه از نماشب، از نماز شب و سحر و بیداری بندازد که به اون شنود نرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 473.45,
   "end": 475.77,
   "text": "اگر مداومت کنی قطعاً می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 475.77,
   "end": 478.11,
   "text": "چون مداومت نیست نمی‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 478.11,
   "end": 480.91,
   "text": "هی منقطع می‌شیم. نوسان داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 480.91,
   "end": 484.73,
   "text": "اگر کسی طور مثالی‌شو رد کرد یعنی به برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 484.73,
   "end": 491.11,
   "text": "ارتباط برقرار کرد، همان که خیلی‌ها هستند قرآن می‌خونن صدای مثالی قرآن رو هم می‌شنوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 491.11,
   "end": 494.75,
   "text": "یا صدای اموات در برزخ رو می‌شنوند و خیلی چیزای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 494.75,
   "end": 496.35,
   "text": "بعد آماده طور عقلی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 496.35,
   "end": 500.55,
   "text": "صدای ملائکه رو می‌شنوه. \"سبح هن قدوس ربنا و رب الملائکة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 500.55,
   "end": 503.37,
   "text": "اگه کسی بالاتر از این رفت به صدای چی رو می‌شنوه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 503.37,
   "end": 507.55,
   "text": "الهیت نظام هستی رو. یک کل هم نور واحد رو درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 507.55,
   "end": 509.91,
   "text": "اون حقیقت کلیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 509.91,
   "end": 512.33,
   "text": "درک می‌کنه. به توحید ناب می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 512.33,
   "end": 514.97,
   "text": "به اتم قصه توحید می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 514.97,
   "end": 517.69,
   "text": "این راهیه که ما در پیش داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 517.69,
   "end": 522.65,
   "text": "نگیم این حرفا چیزای به درد-- استغفرالله العظیم اعوذ بالله جسارت کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 522.65,
   "end": 524.85,
   "text": "به درد نمی‌خوره. آیه شو براتون خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 524.85,
   "end": 528.91,
   "text": "اگه حکما و عرفا اومدن اینا رو ترازبندی کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 528.91,
   "end": 532.73,
   "text": "دسته‌بندی کردن از بس-- بر اساس این آیات این کارو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 532.73,
   "end": 535.39,
   "text": "اگر پیغمبر نهی رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 535.39,
   "end": 537.85,
   "text": "اگر پیغمبر می‌فرماید اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 537.85,
   "end": 545.07,
   "text": "گناه کنی با هر گناهی بخشی از عقلت رو می‌گیرن و دیگه برنمی‌گرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 545.07,
   "end": 546.99,
   "text": "و دیگه برنمی‌گرده یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 546.99,
   "end": 549.47,
   "text": "یعنی از اون طور عقلیت دیگه می‌افتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 549.47,
   "end": 551.15,
   "text": "تو عالم مثال مثلاً می‌مونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 551.15,
   "end": 553.49,
   "text": "نمی‌تونی به طور عقلت بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 553.49,
   "end": 557.07,
   "text": "یعنی تو عروجت تو ظلمت، توی حجابی می‌مونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 557.07,
   "end": 559.35,
   "text": "عروج نداری. می‌خوان ببرنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 559.35,
   "end": 561.57,
   "text": "به زور می‌خوان ببرنت. تو گیر کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 561.57,
   "end": 563.87,
   "text": "این زیغه، این فشاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 563.87,
   "end": 567.61,
   "text": "این ظلمته. چون عالم مادون موندی می‌خوای بری عالم بالا نمی‌تونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 567.61,
   "end": 570.53,
   "text": "تو این ظلمت پایین موندی. این یه معنای فشاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 570.53,
   "end": 574.41,
   "text": "یه معنای اِاِاِ عذاب برزخیه یا حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 574.41,
   "end": 579.13,
   "text": "عذاب اخروی. یا مثلاً اینجا که علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 579.13,
   "end": 583.63,
   "text": "این رو هم بگم چون مرتبط به بحثه بعد همین مقدار اینجا استپ می‌کنیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 583.63,
   "end": 588.51,
   "text": "حضرت علامه حسن زاده خودشون می‌فرمایند که دو نفر اومدن به ما گفتن آقا ما یه دعوایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 588.51,
   "end": 591.13,
   "text": "داریم، بحثی داریم شما بیا گره ما رو باز کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 591.13,
   "end": 593.93,
   "text": "چی شده؟ سر یه زمینی اینا با هم بحث دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 593.93,
   "end": 596.95,
   "text": "یه زمین کشاورزیه. این میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 596.95,
   "end": 599.69,
   "text": "این مقدارش مال منه. اون میگه نه این دروغ میگه مال منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 599.69,
   "end": 603.37,
   "text": "بحث داشتن. اومدن پیش حضرت علامه گفتن شما گره گشایی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 603.37,
   "end": 607.51,
   "text": "حرفاشونو شنید فرمود من باید حرف زمین رو هم بشنوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 607.51,
   "end": 612.67,
   "text": "کی؟ حضرت علامه حسن زاده میگه من باید صحبت‌های شما رو که شنیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 612.67,
   "end": 615.37,
   "text": "صحبت‌های طرف دعواتون رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 615.37,
   "end": 617.15,
   "text": "یعنی زمین رو هم باید بشنوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 617.15,
   "end": 623.05,
   "text": "با همدیگه رفتن سر زمین. حرفای اینا رو که شنیده بود گفت حالا صبر کنید ببینم زمین چی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 623.05,
   "end": 625.79,
   "text": "گوششو آورد نزدیک زمین گفت سلام علیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 625.79,
   "end": 628.07,
   "text": "بله. خب. چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 628.07,
   "end": 632.73,
   "text": "باشه. یه چند تا همین حرفا زد و اینا همینجوری مات و مبهوت نگاه می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 632.73,
   "end": 637.17,
   "text": "این همونه که داریم می‌گیم. یعنی می‌تونه زبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 637.17,
   "end": 644.43,
   "text": "مثال زمین. حالا من الان نمی‌تونم بگم که زبان حال مثال زمین رو می‌شنیده، مثالی زمین رو می‌شنیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 644.43,
   "end": 647.81,
   "text": "یا زبان حال مثلاً عقلی طور عقلی ز-- اینم همینطوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 647.81,
   "end": 655.39,
   "text": "زمین هم مگر نه فقط و عذر شود \"ام من شيء الا اندنا خزائنه و ما ننزله الا بقدر معلوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 655.39,
   "end": 657.15,
   "text": "زمین هم به یک معنا نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 657.15,
   "end": 660.05,
   "text": "اونم طوره. زمین هم جون داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 660.05,
   "end": 663.71,
   "text": "زمین هم عذر شود شعور داره، فهم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 663.71,
   "end": 668.87,
   "text": "اونم نازل شده. زمین هم طور مثالی داره، طور عقلی داره، دور طور الهی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 668.87,
   "end": 671.63,
   "text": "همه اشیا نه فقط انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 671.63,
   "end": 675.29,
   "text": "حالا علامه کدوم طور از اطوار زمین رو شنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 675.29,
   "end": 679.13,
   "text": "من نمی‌دونم. حداقل طور برزخیشو شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 679.13,
   "end": 681.19,
   "text": "لسان برزخی زمین رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 681.19,
   "end": 683.39,
   "text": "زبان حالش رو در اون عالم شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 683.39,
   "end": 685.37,
   "text": "بله. چشم. چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 685.37,
   "end": 688.83,
   "text": "اینا تموم شد و گفت خب می‌دونید زمین چی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 688.83,
   "end": 692.99,
   "text": "زمین به من میگه اینا دروغ میگن این زمین مال ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 692.99,
   "end": 697.29,
   "text": "بلکه اونا مال منن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 697.29,
   "end": 699.93,
   "text": "توجه کردید چی شد؟ همینجوری موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 699.93,
   "end": 705.01,
   "text": "اینا دو تا موندن. همینطور موندن چی گفت و واقعاً هم باید موند اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 705.01,
   "end": 707.57,
   "text": "چی شد؟ یعنی چی اونا مال منن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 707.57,
   "end": 710.51,
   "text": "خب ظاهراً ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 710.51,
   "end": 713.01,
   "text": "ذهنمون متبادر می‌شه به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 713.01,
   "end": 718.21,
   "text": "زمین هر روز فریاد می‌زنه \"ان بعثت القبر، ان بعثت الدود، ان بعثت الظلمة\" اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 718.21,
   "end": 721.17,
   "text": "خب؟ اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 721.17,
   "end": 724.27,
   "text": "قصه از جهت حکمت بخوای نگاه کنی جور دیگه‌ای می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 724.27,
   "end": 726.91,
   "text": "دقت کنید ما گفتیم طور طبیعی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 726.91,
   "end": 731.64,
   "text": "مثالی، عقلی، الهی وقتی زمین میگه اینا مال منن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 731.64,
   "end": 736.52,
   "text": "الان زمین، الان این زمینی که روش وایسادن طور طبیعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 736.52,
   "end": 738.56,
   "text": "نشئه ملکه. جماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 738.56,
   "end": 743.72,
   "text": "انزل مراتب. میگه اینا مال منن یعنی بدن اینا، اینا میاد به من میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 743.72,
   "end": 748.72,
   "text": "یعنی حد اینا در همین طور طبیعیشون باقی مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 748.72,
   "end": 752.06,
   "text": "توجه کردید چی شد؟ این برداشت من از فرمایش علامه‌ست‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 752.06,
   "end": 756.66,
   "text": "اگه اشتباه می‌کنم بگید. اینکه زمین میگه اینا مال منن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 756.66,
   "end": 760.58,
   "text": "نه من مال اینا؛ یعنی اینا تو همین طور زمینیشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 760.58,
   "end": 767.6,
   "text": "تو همین اطوار وجودیشون، تو طور طبیعی و زمینی و مادی و ظلمانیشون موندن که مال منن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 767.6,
   "end": 769.84,
   "text": "یعنی نرفتن به عالم مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 769.84,
   "end": 773.18,
   "text": "نرفتن به آل-- به طور عقلیشون، به طور الهیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 773.18,
   "end": 775.98,
   "text": "اصلا به عالم مثالی‌شون نرفتن هنوز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 775.98,
   "end": 778.66,
   "text": "هنوز تو همین نشئه‌ طبیعتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 778.66,
   "end": 781.78,
   "text": "تو همون حالت جمادیه‌ست دارن زندگی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 781.78,
   "end": 787.8,
   "text": "بل هم ازل. اولائک کالانعام بل ام ازل یعنی دیگه از حیوان پست‌تر می‌شه جماد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 787.8,
   "end": 790.88,
   "text": "اینا اصلا جمادن. خب جمادم که مال منه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 790.88,
   "end": 793.74,
   "text": "تو دل من خاکش می‌کنن. توجه کردید چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 793.74,
   "end": 798.6,
   "text": "چی رو زده علامه؟ با فرمایش زمین چی رو زده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 798.6,
   "end": 800.64,
   "text": "چه تنبیهی ایجاد کرده اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 800.64,
   "end": 804.24,
   "text": "چه تنبّه خاطری داده. هیچ چاره‌ای هم نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 804.24,
   "end": 807.26,
   "text": "ثم يعرج إليه قراره همه بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 807.26,
   "end": 813.48,
   "text": "حالا نگاه نکن همه اكثرهم لا يعقلون، لا يتدبرون، لا يفقهون، لا يسمعون، لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 813.48,
   "end": 815.16,
   "text": "تبصرون. اینا رو دقت نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 815.16,
   "end": 818.64,
   "text": "ما چی؟ ما می‌خوایم اینطوری باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 818.64,
   "end": 822.42,
   "text": "یه بار دیگه آیه رو می‌خونم به دلتون انشاالله بشینه، بچشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 822.42,
   "end": 826.86,
   "text": "و السلام. آیه پنج سوره سجده برید در خلوتتون بخونیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 826.86,
   "end": 831.92,
   "text": "\"یدبر الأمر من السماء إلى الأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 831.92,
   "end": 835.12,
   "text": "این \"إلى\" همون کشیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 835.12,
   "end": 839.58,
   "text": "کش-- معنوی کشاندن داره از آسمان تا زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 839.58,
   "end": 841.84,
   "text": "انا لله این قوس نوزول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 841.84,
   "end": 845.82,
   "text": "اومدیم. خب دستت درد نکنه خدا آورد، آوردیم ما رو از زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 845.82,
   "end": 849.2,
   "text": "حالا وقت معراج ماست. ثم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 849.2,
   "end": 852.18,
   "text": "يعرج إليه باز من کمکتون می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 852.18,
   "end": 855.82,
   "text": "خداست که باز اینجا يعرج شما رو به معراج می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 855.82,
   "end": 859.3,
   "text": "اما تو فقط آمادگیتو پیدا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 859.3,
   "end": 864.5,
   "text": "اینه که پیغمبر می‌فرماید \"اعنی اعنی اعنی\" یعنی منو کمک بکنید یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 864.5,
   "end": 869.1,
   "text": "من دستتونو می‌گیرم می‌برم فقط شما دستتونو دراز کنید به من بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 869.1,
   "end": 873.48,
   "text": "که من دست بی‌طهارت رو نمی‌تونم بگیرم چون دست من طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 873.48,
   "end": 878.02,
   "text": "طهارت مطلقه است. \"إنما يريد الله ليذهب عنكم الرجس أهل البيت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 878.02,
   "end": 880.92,
   "text": "ويطهركم تطهيرا\". آماده این عروج باید باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 880.92,
   "end": 887.36,
   "text": "هیچ چاره‌ای هم ازش نداریم. و الا سکرات مرگمون این هفتاد، هفتاد هزار سال، هفتصد هزار سال طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 887.36,
   "end": 896.2,
   "text": "هستن کسایی که هزاران سال پیش مردن هنوز تو نشئه طبیعتن، ارواح سرگردانن، نکندن تعلق‌شون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 896.2,
   "end": 898.54,
   "text": "اینا هنوز تو طور طبیعیشون موندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 898.54,
   "end": 903.02,
   "text": "هنوز تو عذابن. الهی که عاقبتمون ختم به خیر باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 903.02,
   "end": 905.64,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 905.64,
   "end": 912.7,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}