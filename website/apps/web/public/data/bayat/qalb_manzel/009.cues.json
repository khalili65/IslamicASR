 "chapters": [
  {
   "index": 0,
   "title": "## قلب منزل؛ نزول فیض با واسطه یا بی‌واسطه",
   "start": 19.32,
   "end": 350.74
  },
  {
   "index": 1,
   "title": "## قوس نزول و دعای موسی",
   "start": 350.74,
   "end": 388.74
  },
  {
   "index": 2,
   "title": "## لحظهٔ مرگ و واسطه‌های فیض",
   "start": 388.74,
   "end": 623.74
  },
  {
   "index": 3,
   "title": "## نقل علامه؛ حصهٔ وجودی و اسم اعظم",
   "start": 623.74,
   "end": 733.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.16,
   "end": 3.32,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.32,
   "end": 5.76,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.76,
   "end": 8.22,
   "text": "محمد عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.22,
   "end": 11.38,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.38,
   "end": 15.28,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.28,
   "end": 19.06,
   "text": "آیاته. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.06,
   "end": 22.18,
   "text": "ما نکته شرعی‌مون رو که گفتیم همونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.18,
   "end": 25.32,
   "text": "اجازه بفرمایید که ورود کنیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 25.32,
   "end": 27.72,
   "text": "ادامه بحث. امروز خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 27.72,
   "end": 30.4,
   "text": "خیلی مثلا اون حالت دشوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 30.4,
   "end": 34.86,
   "text": "ذهنی رو نداره و به دل همه‌تون انشاالله می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 34.86,
   "end": 38.6,
   "text": "ما عرض کردیم که قلب منزله دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 38.6,
   "end": 42.64,
   "text": "م-منزل ببخشید. من-منزل یعنی جایی که محل نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 42.64,
   "end": 50.46,
   "text": "فیض الهیه. حالا سؤال این فیض الهی مستقیم میاد به قلب ما می‌شینه یا با واسطه میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.46,
   "end": 53.66,
   "text": "و اگر با واسطه میاد چند تا واسطه می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.66,
   "end": 56.16,
   "text": "سؤالات خیلی شیرین و جدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 56.16,
   "end": 60.58,
   "text": "و اگر با چند تا واسطه میاد این واسطه‌ها کی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.58,
   "end": 65.36,
   "text": "و اگر این واسطه‌ها مشخص‌اند ما این‌ها رو می‌بینیم یا نمی‌بینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 65.36,
   "end": 67.74,
   "text": "درکشون می‌کنیم یا نمی‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 67.74,
   "end": 70.5,
   "text": "همه‌ی این‌ها رو اجازه بفرمایید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 70.5,
   "end": 74.72,
   "text": "در قالب یکی از فرمایشات حضرت شیخ اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 74.72,
   "end": 79.08,
   "text": "در کتاب انشاء الدوائرش عرض کنم خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 79.08,
   "end": 82.94,
   "text": "اون دوائر در رقائق احکام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 82.94,
   "end": 87.34,
   "text": "ائمه الاسماء الهیه شون یه دوائر خاصیه که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 87.34,
   "end": 95.46,
   "text": "حضرت آقای شیرازی هم در کتاب الانوار و توالق الاسرارشون صفحه ششصد و پنجاه و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.46,
   "end": 99.58,
   "text": "اینو مختصراً توضیح دادن، اجمالاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.58,
   "end": 102.3,
   "text": "ایشون اونجا این‌طوری می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.3,
   "end": 108.6,
   "text": "اول فیضی که، عین جمله‌ی ایشونه، اول فیضی که از حق تعالی نزول می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.6,
   "end": 113.72,
   "text": "بر قلب حضرت قطب الاقطاب و قوس الاعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.72,
   "end": 120.32,
   "text": "نزول می‌نواید و از قلب آن حضرت بر قلب ذو قطب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.32,
   "end": 128.9,
   "text": "وارد می‌شود. خب این رو، اون قطب الاقطاب رو شما نبی اکرم اسلام بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.9,
   "end": 132.28,
   "text": "و این ذو قطب رو بگیر کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.28,
   "end": 141.36,
   "text": "امام عصرت. یعنی اول فیضی که میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.36,
   "end": 144.42,
   "text": "این در حقیقت قلب مقدس پیغمبر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.42,
   "end": 149.48,
   "text": "هر فیضی. حالا اولین فیضی که ما مرزوق به اون فیض شدیم چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.48,
   "end": 151.52,
   "text": "رزق وجود بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.52,
   "end": 156.06,
   "text": "درست شد؟ بعد از اون دیگه هرچه می‌آید از حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.06,
   "end": 159.54,
   "text": "علم ادامه حیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.54,
   "end": 164.46,
   "text": "قدرته، اراده‌ست، رزقه از همه هیئیتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.46,
   "end": 170.5,
   "text": "اراده‌ست. اینا همه برمی‌گرده حتی اون قواى سامعه، بصره دائماً تحت فیض‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.5,
   "end": 174.9,
   "text": "آن به آن و کل يوم هو فى شأن یک معناش اینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.9,
   "end": 178.38,
   "text": "آن به آن، آن ف-- یعنی همینطوری دائم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.38,
   "end": 184.82,
   "text": "این قواى سامعه مرتبط‌اند با اون اتصال دارند با اون نظام، با اون نظام اقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.82,
   "end": 186.98,
   "text": "و الا کار نمی‌کنن. باید وجود بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.98,
   "end": 189.94,
   "text": "هی شدت بیاد رو شدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.94,
   "end": 195.32,
   "text": "پس اول نازل می‌شه به قلب پیغمبر بعد به امام عصر شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.32,
   "end": 198.54,
   "text": "و بعد از اینکه این فیض نازل شد بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.54,
   "end": 201.56,
   "text": "قلب مقدس امام عصر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.56,
   "end": 207.2,
   "text": "می‌فرماید که و از قلب ایشان بر قلب سه تنان ابدال وارد می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.2,
   "end": 212.74,
   "text": "ایشون معتقد است که حلقه اول گرد امام عصر سه نفرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.74,
   "end": 215.18,
   "text": "اسمشون هم ابدال هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.18,
   "end": 219.72,
   "text": "حالا چرا ابدال؟ یعنی بدل انشایی می‌تونن بکنن از جسمشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.72,
   "end": 222.6,
   "text": "می‌تونن جسمشون رو اِب-- بدل کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.6,
   "end": 227.16,
   "text": "مثلاً اینایی که تو بیابون گرفتار‌اند می‌گن یه آدم نورانی اومد نجاتم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.16,
   "end": 231.6,
   "text": "مریضه می‌گه آدم نورانی اومد دست کشید سرم، شفا گرفتم اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.6,
   "end": 234.04,
   "text": "می‌گن امام عصر رو دیدم. نخیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.04,
   "end": 237.12,
   "text": "آقا شأنش فوق این حرف‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.12,
   "end": 240.02,
   "text": "اون می‌تواند این ابدال باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.02,
   "end": 242.8,
   "text": "حالا سه تن. البته اینو عرض کنم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.8,
   "end": 246.34,
   "text": "در ترتیب این‌ها و عددشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.34,
   "end": 247.98,
   "text": "اِاِاِ اختلاف هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.98,
   "end": 250.58,
   "text": "بعضیا گفتن نه اون اول اب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.58,
   "end": 253.48,
   "text": "اوتادن بعد ابدال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.48,
   "end": 259.82,
   "text": "و ابدال پنجاه نفرن یا پنجاه و سه نفر و اون اوتاد چهار نفرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.82,
   "end": 262.72,
   "text": "اول میگن اوتادن. حالا این نظر شیخ اکبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.72,
   "end": 267.32,
   "text": "بحثی هم نداریم. به هر حال بدونیم فعلاً اینو بفهمیم که فیض ذو مراتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.32,
   "end": 270.38,
   "text": "همینطوری مرتبت به مرتبت نازل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.38,
   "end": 272.02,
   "text": "و از قلب ایشان یعنی کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.02,
   "end": 276.24,
   "text": "اون ابدال. بر قلب چهار تنان اوتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.24,
   "end": 281.4,
   "text": "وارد می‌شود. حلقه دوم گرد امام عصر اوتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.4,
   "end": 283.86,
   "text": "والجبال اوتادا قرآن می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.86,
   "end": 289.28,
   "text": "کوه‌ها مثل کو-- مثل میخ کوبیده شده روی زمین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.28,
   "end": 292.72,
   "text": "و از ایشان بر قلب هفت تنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.72,
   "end": 295.62,
   "text": "که اسمشون رجال الغیب هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 295.62,
   "end": 301.2,
   "text": "وارد می‌شود. حالا تازه اینا که حلقه سوم‌اند و هفت نفرند رجال الغیب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.2,
   "end": 307.14,
   "text": "بعد ما توقع داریم اون غیب اصلی رو یعنی امام عصر رو که غائب‌ست از نظرها رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.14,
   "end": 309.96,
   "text": "خودمون رو می‌کشیم شب و روز که مثلا اون آقا رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.96,
   "end": 313.48,
   "text": "بابا همین هفت نفر حلقه سومم رجال الغیب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.48,
   "end": 316.98,
   "text": "و از قلب ایشان بر قلب چهل تنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.98,
   "end": 324.46,
   "text": "که نقبا نام گذاشته شده‌اند نازل می‌شود و از قلب ایشان بر قلب سیصد تنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.46,
   "end": 334.26,
   "text": "اسمشون نجباست نازل می‌شود یا وارد می‌شود و از ایشان بر قلب سایر بندگان خدا البته الاقرب فالأ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.26,
   "end": 336.6,
   "text": "فالأقرب وارد می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.6,
   "end": 339.3,
   "text": "یعنی همینطوری هر به مراتب هرکی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.3,
   "end": 341.66,
   "text": "اقربه، نزدیک‌تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.66,
   "end": 346.66,
   "text": "به ولایت از قلب اون بعد منتشر می‌شه میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 346.66,
   "end": 348.72,
   "text": "به قلب همینطوری مادون خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.72,
   "end": 350.74,
   "text": "این سلسله مراتب همیشه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.74,
   "end": 355.0,
   "text": "همینطور که در سلسله طولی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.0,
   "end": 358.6,
   "text": "تنزل یا انزال یا حتی نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.6,
   "end": 360.8,
   "text": "عرض شود ابتدایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.8,
   "end": 366.48,
   "text": "انا ان-- انا لله اینکه از سمت خدا ما در قوس نزول اومدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.48,
   "end": 370.72,
   "text": "همون الوهیت نظام هستی که حالا شما بگی اسمشو بگی قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.72,
   "end": 372.84,
   "text": "که اتصال همه موجودات با اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.84,
   "end": 380.34,
   "text": "میاد بعد عالم عقل و یا عقول و مجردات و سو اینا بعد مثال که حالا به یک معنا برزخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.34,
   "end": 382.12,
   "text": "بعد عالم طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 382.12,
   "end": 383.78,
   "text": "این زو مراتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.78,
   "end": 386.86,
   "text": "این مراتب حفظ میشن و باید بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 386.86,
   "end": 390.02,
   "text": "در نزول فیض الهی هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.02,
   "end": 396.98,
   "text": "چون که حضرت موسی علی نبینا و آله و علیه الصلاة والسلام رفت اون گوشه زیر سایه درخت نشست رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.98,
   "end": 398.88,
   "text": "انی چقدر این دعا زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.88,
   "end": 401.44,
   "text": "دعای قرآنی. خیلی از علمای از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.44,
   "end": 404.7,
   "text": "تأکید دارن که دعاهاتونو این دعاهای قرآنی بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.7,
   "end": 413.12,
   "text": "یه بحث مفصلی هم گوش دارن که \"رب انی لما انزلت الیا انزلت الی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.12,
   "end": 415.8,
   "text": "من خیر فقیر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.8,
   "end": 418.76,
   "text": "گرسنش بود حضرت موسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.76,
   "end": 421.42,
   "text": "نگفت خدایا من غذا می‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.42,
   "end": 425.02,
   "text": "گفت \"رب انی لما انزلت الی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.02,
   "end": 427.26,
   "text": "اینکه از تو باید نازل بشه این فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.26,
   "end": 429.9,
   "text": "اینم فیضه. غذا هم فیضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.9,
   "end": 432.66,
   "text": "\"الی\" از سمت تو بیاد. اونم خیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.66,
   "end": 435.94,
   "text": "خیر. هرچی از تو بیاد خیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.94,
   "end": 439.68,
   "text": "\"ما اصابک من حسنة فمن الله\" آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 439.68,
   "end": 445.76,
   "text": "هرچی از تو اصابت به ما بکنه حسنه است و \"ما اصابک من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.76,
   "end": 448.08,
   "text": "سیئة فمن نفسك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 448.08,
   "end": 454.24,
   "text": "مطلقا هرچی که از بدی به تو اصابت میکنه از نفس خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 454.24,
   "end": 457.58,
   "text": "خب میگه \"من خیرًا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.58,
   "end": 460.3,
   "text": "فقیر\". اونم فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 460.3,
   "end": 462.76,
   "text": "دیگه به شدت فقیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.76,
   "end": 466.56,
   "text": "مگر فیض تو نازل بشه. منتها این سلسله طولیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 466.56,
   "end": 468.16,
   "text": "حفظ میشه. یعنی اینطوری بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 468.16,
   "end": 470.48,
   "text": "الان به شما یه فیضی نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 470.48,
   "end": 473.88,
   "text": "یه حال خوشی، یه عنایتی بهت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 473.88,
   "end": 477.14,
   "text": "لطف عنایی حضرت شامل حال شما شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 477.14,
   "end": 480.52,
   "text": "الان بر اساس این سلسله طولیه باید چه نتیجه بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 480.52,
   "end": 485.52,
   "text": "اون رشته‌های قبل از شما موافق شما همه قلبشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 485.52,
   "end": 493.88,
   "text": "مستفیض شدن. فیض الهی بر قلب اونا که اول از همه حضرت پیغمبر اکرم و بعد امام عصره اونها م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.88,
   "end": 496.76,
   "text": "مستفیض شدن از فیض الهی بعد به تو رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 496.76,
   "end": 501.46,
   "text": "پس اینه که میگه آقا اگر تو به سمت خیر بری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 501.46,
   "end": 504.04,
   "text": "خیرت به امام عصر هم میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 504.04,
   "end": 507.02,
   "text": "این یه معناشه. اگر تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 507.02,
   "end": 510.3,
   "text": "به سمتی بری \"لا یمسه إلا المتحرون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 510.3,
   "end": 514.74,
   "text": "به جایی بری طهارت پیشه کنی که بتونی حقایق عالم رو مس کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 514.74,
   "end": 516.68,
   "text": "نازل بشه حقایق بر تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 516.68,
   "end": 519.94,
   "text": "فیض الهی از انواعش بر تو نازل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 519.94,
   "end": 522.14,
   "text": "اول به قلب کی نازل میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 522.14,
   "end": 524.86,
   "text": "امام عصره. از طریق پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 524.86,
   "end": 527.74,
   "text": "درست شد؟ کانال فیض امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 527.74,
   "end": 534.42,
   "text": "اینه که حالا اون بچه هایی که توی یه زمانی با یک بچه های مقاومت من صحبتی، خلوتی داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.42,
   "end": 536.2,
   "text": "خیلی چیزای شیرینی می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 536.2,
   "end": 544.86,
   "text": "مثلا می‌گفتن ما بسیار دیدیم شهدایی که تو لبنان زمین می‌افتادن می‌گفتن لحظه احتضارشون، لحظه شهادتشون می‌گفتن حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.86,
   "end": 547.66,
   "text": "صاحب الزمان و حالا امام خمینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 547.66,
   "end": 551.32,
   "text": "بعد شه-شهید می‌شدن. این چرا باید امام، امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 551.32,
   "end": 555.04,
   "text": "مثلا حضرت امام علیه الرحمه کنار امام عصر تشریف داشته باشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 555.04,
   "end": 558.44,
   "text": "این سلسله نزولی طولیه باید حفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 558.44,
   "end": 562.42,
   "text": "این یک معناش. به همین اعتبار بعضیا معتقدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 562.42,
   "end": 566.62,
   "text": "هرکس که بر ما ولایت دارد در مسیر فیض‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 566.62,
   "end": 570.6,
   "text": "هرکس بر ما ولایت دارد، لز-- لب مرگ می‌آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 570.6,
   "end": 575.34,
   "text": "اونچه مولامون علی علیه الصلاة والسلام فرمود \"مایموت یرنی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 575.34,
   "end": 578.78,
   "text": "یرنی یعنی می‌بیند ولایت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 578.78,
   "end": 583.46,
   "text": "شؤونش هم هستن. یعنی از پیغمبر تشریف میارن تا امام عصر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 583.46,
   "end": 586.06,
   "text": "تا مثلا نماینده امام زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 586.06,
   "end": 590.16,
   "text": "هر کسی که واسطه فیض تو بوده حتی استاد تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 590.16,
   "end": 596.72,
   "text": "استاد تو اگر واسطه فیض بوده، منقطع نبوده از ولایت و واقعا ولایت مدار بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 596.72,
   "end": 599.56,
   "text": "معلم تو، اونم لحظه مرگ میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 599.56,
   "end": 602.28,
   "text": "اینا حقایقی‌اند که حالا روش خیلیا بحث کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 602.28,
   "end": 606.2,
   "text": "ما هم نمی‌خوایم خیلی درش تصرفی بکنیم و حرفی بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 606.2,
   "end": 609.24,
   "text": "می‌رید تشنه‌اید، می‌رید انشاالله پیداش می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 609.24,
   "end": 612.72,
   "text": "پس مهم اینجاست که فعلا اینو ما بدانیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 612.72,
   "end": 615.9,
   "text": "اون فیض الهی که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 615.9,
   "end": 619.18,
   "text": "به حصه وجودی ما نازل می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 619.18,
   "end": 623.74,
   "text": "از قلب نازل می‌شود از قلب با این سلسله مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 623.74,
   "end": 627.72,
   "text": "حالا این جمله رو هم از حضرت علامه براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 627.72,
   "end": 630.32,
   "text": "فیض این جمله ایشونه. ببینید چقدر شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 630.32,
   "end": 633.26,
   "text": "\"فیض الهی همان فعل الهیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 633.26,
   "end": 641.92,
   "text": "همان فعل الهیست و همان کلام اوست که ما عسى الله همه گویااند بصورت لا ما في السماوات و ما في الأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 641.92,
   "end": 648.04,
   "text": "و بتسبیح و ثنای اویند و این فیض حصه وجودی هر موجودیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 648.04,
   "end": 652.02,
   "text": "که واسطه ارتباط او با حق مطلق است.\" همون قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 652.02,
   "end": 656.28,
   "text": "حصه وجودی رو به یک معنا می‌تونی همون جانت، همون قلبت فرض بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 656.28,
   "end": 659.0,
   "text": "وعاء فیض الهی. ظرف فیضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 659.0,
   "end": 663.18,
   "text": "\"ارتباطی که عین ربط است.\" یعنی عین ربط به حضرت حقی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 663.18,
   "end": 671.74,
   "text": "مطلقا جدا نیستی. \"در صحف عرفان از حصه وجودی تعبیر به اسم اعظم او می‌گردد.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 671.74,
   "end": 676.74,
   "text": "این حصه وجودی، این نقطه اتصال تو با الوهیت نظام هست که از طریق قلب هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 676.74,
   "end": 681.04,
   "text": "به این میگن اسم اعظم. پس اسم اعظم اونجاست که حضور مطلقا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 681.04,
   "end": 683.62,
   "text": "یعنی حاضری. حضورت مطلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 683.62,
   "end": 686.3,
   "text": "کاملا ح-حس حضور داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 686.3,
   "end": 689.9,
   "text": "به این میگن اسم اعظم و یا سر هم بهش میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 689.9,
   "end": 693.28,
   "text": "\"این فیضی‌ست که همه مرزوق به آن‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 693.28,
   "end": 698.18,
   "text": "إن للحق في کل خلق ظهورًا خاصًا بهی.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 698.18,
   "end": 704.62,
   "text": "برای حق در هر مرتبه‌ای از خلقت ظهور خاصی‌ست از خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 704.62,
   "end": 706.62,
   "text": "همه ظهور حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 706.62,
   "end": 708.36,
   "text": "تشؤنات حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 708.36,
   "end": 711.44,
   "text": "مرآه حضرت حق‌اند. کلمات حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 711.44,
   "end": 716.0,
   "text": "آیات حضرت حق‌اند. مجالی حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 716.0,
   "end": 719.7,
   "text": "هرچه هست حق است و حق است و حق و شؤوناتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 719.7,
   "end": 722.12,
   "text": "حق ذو مراتب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 722.12,
   "end": 727.86,
   "text": "انشاالله که عاقبتمون ختم به خیر بشود به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 727.86,
   "end": 733.92,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}