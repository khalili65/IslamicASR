   "title": "## اثر کذب بر کژی خیال و فکر",
   "start": 624.74,
   "end": 654.58
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.52,
   "end": 6.26,
   "text": "بسم الله الرحمن الرحيم وبه نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.26,
   "end": 10.68,
   "text": "السلام عليك يا داعي الله ورباني اياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.68,
   "end": 13.58,
   "text": "سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.58,
   "end": 16.58,
   "text": "ادامه بحث مزاج رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.58,
   "end": 20.14,
   "text": "قول داده بودیم که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.14,
   "end": 23.86,
   "text": "ارتباط حیات مزاجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.86,
   "end": 27.12,
   "text": "با وضعیت قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.12,
   "end": 30.8,
   "text": "قلبمون منزل صحبت بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.8,
   "end": 33.18,
   "text": "که رسیده بودیم به مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.18,
   "end": 42.1,
   "text": "اتم که وعده داده بودیم که مزاج اتم یا اشرف رو بیان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.1,
   "end": 44.74,
   "text": "اجازه بفرمایید در همین خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.74,
   "end": 49.02,
   "text": "از کتاب شریف شفا، شفا شیخ الرئیس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.02,
   "end": 53.12,
   "text": "جلد یک، صفحه سیصد و هفتاد و نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.12,
   "end": 62.12,
   "text": "یه بخشی رو بخونیم که ایشون می فرماید انسان اتم و اعدل امزجه را داراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.12,
   "end": 68.1,
   "text": "یعنی مزاج انسانی معتدل‌ترین و تام‌ترین مزاج‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.1,
   "end": 72.26,
   "text": "و گاهی گفته می‌شود مزاج اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.26,
   "end": 74.98,
   "text": "مزاج اول به چی میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.98,
   "end": 79.64,
   "text": "به همون کیفیت اصلی عناصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.64,
   "end": 81.58,
   "text": "به اون میگن مزاج اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.58,
   "end": 87.8,
   "text": "چهارگانه. مراد از مزاج اول کیفیت اصلی عناصر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.8,
   "end": 92.44,
   "text": "مثال برودت، حرارت، رطوبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.44,
   "end": 101.28,
   "text": "و یبوست. در مقابل مزاج ثانی که کیفیت حاصل از امتزاج و ترکیب اجزای عناصر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.28,
   "end": 108.68,
   "text": "که با ترکیب اجزای عناصر کیفیتی حاصل می‌شود که از آن کیفیت تعبیری مزاج می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.68,
   "end": 111.62,
   "text": "پس مزاج اول همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.62,
   "end": 116.56,
   "text": "کیفیت عناصر اربعه‌ش هستش که بحث شد قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.56,
   "end": 124.68,
   "text": "و اما مزاج ثانی کیفیت حاصل از امتزاج و ترکیب اجزاء یعنی اختلاط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.68,
   "end": 127.44,
   "text": "اختلاط اون اجزاء چهارگانه با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.44,
   "end": 129.7,
   "text": "یک کیفیت جدیدی رو ایجاد می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.7,
   "end": 134.82,
   "text": "حالا مزاج اتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.82,
   "end": 141.28,
   "text": "مزاج موجودی‌ست که نزدیک به نوع کامل‌تر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.28,
   "end": 149.74,
   "text": "یا به تعبیر دیگه، به مزاج انسانی مزاج اتم یا اشرف گفته میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 149.74,
   "end": 152.46,
   "text": "که مراد از مزاج اتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 152.46,
   "end": 155.22,
   "text": "اكمل مزاجات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 155.22,
   "end": 159.76,
   "text": "حالا این، باید توجه داشته باشن عزیزان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 159.76,
   "end": 162.9,
   "text": "این مزاج اتم یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.9,
   "end": 165.06,
   "text": "اشرف یا اكمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.06,
   "end": 167.1,
   "text": "در هر کدوم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.1,
   "end": 170.9,
   "text": "نفوس هست، یعنی در هر کدوم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.9,
   "end": 172.66,
   "text": "رتبه‌های وجودی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.66,
   "end": 178.6,
   "text": "یعنی اینکه در میان کل مخلوقات، اینجا رو توجه بکنند عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.6,
   "end": 181.68,
   "text": "که بعد اشتباه نشه. در میان همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.68,
   "end": 184.78,
   "text": "مخلوقات انسان است که مزاجش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.78,
   "end": 190.22,
   "text": "مزاج اتم و اشرف و اكمل است نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.22,
   "end": 194.4,
   "text": "رتبه‌های مادون خودش. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.4,
   "end": 197.02,
   "text": "در میان انسان‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.02,
   "end": 200.3,
   "text": "بین خود انسان‌ها، اون که نظامش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.3,
   "end": 204.48,
   "text": "مزاجش اتمه، اون دیگه میشه انسان کامل که اعدله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.48,
   "end": 206.52,
   "text": "یعنی اعدل امزجه رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.52,
   "end": 210.46,
   "text": "که لذا به قول شیخ الرئیس چنین کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.46,
   "end": 212.96,
   "text": "به جهت اعدل امزجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.96,
   "end": 216.78,
   "text": "که معتدل‌ترین مزاج‌ها رو داره، دیگه عمرش همیشگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.78,
   "end": 223.04,
   "text": "مگر اینکه او رو بکشند. لذا اهل بیت علیهم الصلاة والسلام فرمودند که ما منا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.04,
   "end": 226.02,
   "text": "الا مسموم او مقتول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.02,
   "end": 232.68,
   "text": "حالا این نکته‌ای که می‌خواستم عرض کنم ذیل بحث اینجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.68,
   "end": 238.4,
   "text": "حالا در میان خود رتبه‌های دیگر وجود مثل مثلاً حیوانات، نباتات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.4,
   "end": 242.72,
   "text": "حتی جمادات، این‌ها، اون‌ها هم اتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.72,
   "end": 245.58,
   "text": "مزاج اتم و اشرف و اینا دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.58,
   "end": 248.84,
   "text": "منتها در رتبه خودشون و در رتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.84,
   "end": 252.78,
   "text": "خود اون‌ها مثلاً در حیوانات، اون حیوانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.78,
   "end": 256.98,
   "text": "مزاجش بین حیوانات دیگر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.98,
   "end": 265.5,
   "text": "نوع خودش اتمه، مزاجش اتمه یا اشرفه، اون به انسان نزدیک‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.5,
   "end": 271.32,
   "text": "یعنی مزاج اون کم و کیف و حالاتش به انسان نزدیک‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.32,
   "end": 274.36,
   "text": "حالا باید پیدا کرد که در میان حیوانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.36,
   "end": 276.16,
   "text": "کدوم حیوان به انسان نزدیک‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.16,
   "end": 279.7,
   "text": "مثلاً گوسفند میگن مظهر تسلیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.7,
   "end": 282.16,
   "text": "تسلیم خیلی در گوسفند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.16,
   "end": 284.6,
   "text": "بروز داره، ظهور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 284.6,
   "end": 287.24,
   "text": "مثلاً راحت می‌خوابونیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.24,
   "end": 289.36,
   "text": "که بخواد ذبحش کنن راحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.36,
   "end": 292.06,
   "text": "تن میده. اما گاو این‌ها اینطوری نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.06,
   "end": 293.8,
   "text": "لذا گوسفند همه چیش خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.8,
   "end": 295.96,
   "text": "همه چیش، خوردنش خوبه. اما گوساله نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.96,
   "end": 298.32,
   "text": "گوسفند، گاو نه. اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.32,
   "end": 300.64,
   "text": "گاو و گوساله و اینا مثلاً شیرش خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.64,
   "end": 303.12,
   "text": "گوشتش کراهت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.12,
   "end": 306.66,
   "text": "و نه شده. اما مثلاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.66,
   "end": 308.28,
   "text": "شاید نباتاتم همینطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.28,
   "end": 314.48,
   "text": "اون نباتی که مزاجش اتمه، می‌خوام بگم اون‌ها هم دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.48,
   "end": 316.18,
   "text": "در رتبه وجودی خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.18,
   "end": 319.18,
   "text": "اون که مزاج اتم دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.18,
   "end": 325.72,
   "text": "مزاج اكمل و اشرف دارد، اون باز به حیوانات نزدیک‌تر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.72,
   "end": 328.44,
   "text": "و باز باید پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.44,
   "end": 333.66,
   "text": "یه شاید اینکه در قرآن بعضی از نباتات هستند که مورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.66,
   "end": 338.62,
   "text": "عنایت واقع شدن مثل خرما، مثل زیتون، این‌ها شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.62,
   "end": 341.62,
   "text": "مزاجشون این شکلی باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.62,
   "end": 346.5,
   "text": "اما باز عبارت دیگری رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.5,
   "end": 352.7,
   "text": "شیخ الرئیس علیه الرحمه بخونیم در کتاب شفا، جلد یک، صفحه چهارصد و چهل و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.7,
   "end": 357.92,
   "text": "ایشون می‌فرماید، حالا می‌خوان اینجا مزاج خارج رو در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.92,
   "end": 363.82,
   "text": "مزاج معتدل بگن. می‌فرمایند مزاج خارج مزاجی‌ست که خارج از حد اعتدال باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.82,
   "end": 368.4,
   "text": "دیگه اسمش رو خودشه. اگر مزاج معتدل باشد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.4,
   "end": 374.6,
   "text": "او مزاج معتدل گفته می‌شود و اگر مزاج خارج از حد اعتدال باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.6,
   "end": 376.66,
   "text": "به آن مزاج خارج گویند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.66,
   "end": 379.56,
   "text": "مزاج معتدل مزاجی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.56,
   "end": 385.56,
   "text": "که حاصل از تعادل اخلاط اربع و ترکیب عناصر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.56,
   "end": 389.14,
   "text": "یعنی وقتی که مختلط می‌شوند این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.14,
   "end": 391.3,
   "text": "عناصر، عناصر اربع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.3,
   "end": 394.62,
   "text": "مختلط می‌شوند به حالت تعادل مختلط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.62,
   "end": 399.02,
   "text": "می‌شوند. حالا این در حقیقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.02,
   "end": 401.7,
   "text": "اِاِاِ هر چقدر که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.7,
   "end": 404.82,
   "text": "اختلاط این عناصر اربع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.82,
   "end": 409.6,
   "text": "معتدل‌تره، صاحب اون مزاج- معتدله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.6,
   "end": 412.94,
   "text": "آره اون به سمت اعتداله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.94,
   "end": 416.3,
   "text": "یعنی وجودش به عدالت نزدیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 416.3,
   "end": 418.64,
   "text": "خب این هم یک موضوع که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.64,
   "end": 425.26,
   "text": "حالا هرچه مزاج انسان معتدل‌تر شد پس تمثلاتش روشن‌تر است، شفاف‌تر است که بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 425.26,
   "end": 428.46,
   "text": "قبلاً بحثش گذشت اجمالاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 428.46,
   "end": 431.24,
   "text": "و اعتدال مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.24,
   "end": 436.94,
   "text": "البته به اطاعت از شریعت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.94,
   "end": 442.04,
   "text": "که هرچه انسان اطاعتش از خداوند بیشتر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.04,
   "end": 451.2,
   "text": "مزاجش هم معتدل‌تر و هرچه مزاج معتدل‌تر باشه در پذیرش حقایق و معارف و صور غیبی موفق‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.2,
   "end": 453.8,
   "text": "این یک رابطه دو طرفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 453.8,
   "end": 455.92,
   "text": "یعنی نکته اینجاست که این رابطه دو طرفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 455.92,
   "end": 459.32,
   "text": "هرچه که مزاج معتدل‌تر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.32,
   "end": 463.3,
   "text": "انسان به سمت حقایق سریع‌تر حرکت می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.3,
   "end": 467.62,
   "text": "تمثلاتش قوی‌تر، شفاف‌تر، ظرافت‌تره که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.62,
   "end": 473.32,
   "text": "یک وجه دیگه هم هست که هرچه انسان به سمت اطاعت الهی حرکت کنه باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 473.32,
   "end": 475.42,
   "text": "مزاجش معتدل میشه. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.42,
   "end": 479.84,
   "text": "در جواب اون‌هاییه که وقتی این بحث‌ها رو می‌شنوند میگن خب ما چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 479.84,
   "end": 484.18,
   "text": "حالا مثلاً مزاج ما معتدل نیست یا نبوده و گرفتاری پیش اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 484.18,
   "end": 486.72,
   "text": "چه کنیم؟ گناه ما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 486.72,
   "end": 490.92,
   "text": "میگیم اصلاً خود به سمت حضرت حق حرکت کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.92,
   "end": 493.88,
   "text": "اعتدال مزاج میاره. باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 493.88,
   "end": 498.76,
   "text": "دقت بفرمایید نکته‌ی دیگری رو بخونید برای همین بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.76,
   "end": 502.32,
   "text": "که از هزار و یک نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.32,
   "end": 505.26,
   "text": "حضرت علامه، نکته ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.26,
   "end": 513.52,
   "text": "ببینید چقدر شیرین ایشون می‌فرماید \"و بدان که هرچه مزاج معتدل‌تر و مراقبت قوی‌تر باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 513.52,
   "end": 520.22,
   "text": "و صداقت خلوص نیت و صفای قلب بیشتر باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 520.22,
   "end": 523.86,
   "text": "تمثلات صور روشن‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.86,
   "end": 527.4,
   "text": "و حکایت آنها از واقع بیشتر است.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 527.4,
   "end": 530.38,
   "text": "که بعد اینجا اشاره به فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 530.38,
   "end": 534.04,
   "text": "شیخ الرئیس می‌کنه که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.04,
   "end": 539.38,
   "text": "کسی که مثلاً علامه با ش-- فرمایش شیخ الرئیس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 539.38,
   "end": 544.54,
   "text": "نکته رو ادامه میده که کسی که مزاجش خشکه دیرتر به حقیقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 544.54,
   "end": 546.86,
   "text": "به حقیقت مطلب دست پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 546.86,
   "end": 550.04,
   "text": "ولی مطلب رو خوب نگه می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.04,
   "end": 553.76,
   "text": "مزاج خشک چی بود؟ همون یابس بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 553.76,
   "end": 556.8,
   "text": "یعنی مربوط به خاک، عنصر خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 556.8,
   "end": 560.3,
   "text": "کسی که مزاجش رطبه یعنی تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 560.3,
   "end": 563.12,
   "text": "که مربوط به آب هست، عنصر آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 563.12,
   "end": 567.02,
   "text": "مطلب رو هم زود میگیره و هم زود از دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 567.02,
   "end": 569.82,
   "text": "دقیقا مثل من. و کسی که مزاجش حاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 569.82,
   "end": 572.32,
   "text": "حالا من سریع میگم رد میشم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 572.32,
   "end": 575.46,
   "text": "دیگه صدای عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.46,
   "end": 578.4,
   "text": "قرآن حرم هم بلند شد بگذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 578.4,
   "end": 580.66,
   "text": "کسی که مزاجش حاره یعنی گرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 580.66,
   "end": 583.74,
   "text": "برای همین هم حرکاتش مشوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 583.74,
   "end": 585.48,
   "text": "هم در بیداری هم تو خوابش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 585.48,
   "end": 587.88,
   "text": "هم در بیداری عصبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.88,
   "end": 596.28,
   "text": "و زود براش افته میشه و هم در خواب همیشه در حال جنگ و درگیری و خونریزی و دعوا و خواب‌هاشم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 596.28,
   "end": 599.1,
   "text": "اما کسی که مزاجش خشک، حالا اون حار چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 599.1,
   "end": 603.5,
   "text": "همون آتش. اما مزاج سرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 603.5,
   "end": 606.44,
   "text": "که ربط دارد به هوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 606.44,
   "end": 609.02,
   "text": "وارد، باد. این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 609.02,
   "end": 613.12,
   "text": "این شیخ الرئیس می‌فرماید چنین کسی بلیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 613.12,
   "end": 616.8,
   "text": "جاهله یعنی جاهله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 616.8,
   "end": 618.62,
   "text": "یعنی خیلی نادونی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 618.62,
   "end": 622.2,
   "text": "تو کاراش می‌بینی همش جهل نشون میده از خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 622.2,
   "end": 626.96,
   "text": "نادونی به خرج میده که البته صحیح‌ترین مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 626.96,
   "end": 629.98,
   "text": "اونه که عادت به راستی کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 629.98,
   "end": 634.38,
   "text": "لذا فرمودند که نیت خلاف و قول کذب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 634.38,
   "end": 637.04,
   "text": "و این‌ها دروغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 637.04,
   "end": 639.14,
   "text": "حتی به شوخی نفس و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 639.14,
   "end": 642.5,
   "text": "خیال رو، فکر رو کج و معوج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 642.5,
   "end": 645.26,
   "text": "برای همین در روایت به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 645.26,
   "end": 647.26,
   "text": "نهی شده حتی به شوخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 647.26,
   "end": 649.7,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
