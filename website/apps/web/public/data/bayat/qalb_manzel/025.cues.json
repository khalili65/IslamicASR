   "start": 12.52,
   "end": 32.56
  },
  {
   "index": 1,
   "title": "## سوختن، حس حضور و نقطهٔ تحت الباء",
   "start": 32.56,
   "end": 166.76
  },
  {
   "index": 2,
   "title": "## سعهٔ قلب و عالم ذر",
   "start": 166.76,
   "end": 519.17
  },
  {
   "index": 3,
   "title": "## قرآن وحدت و فرقان کثرت",
   "start": 519.17,
   "end": 746.62
  },
  {
   "index": 4,
   "title": "## عبارت علامه؛ قبل را خواندن و بعد را دانستن",
   "start": 746.62,
   "end": 831.68
  },
  {
   "index": 5,
   "title": "## لیلة القدر؛ لیل و نهار در قوس نزول و صعود",
   "start": 831.68,
   "end": 939.58
  },
  {
   "index": 6,
   "title": "## ظرفیت قلب منزل",
   "start": 939.58,
   "end": 989.08
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.72,
   "end": 4.98,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.98,
   "end": 10.18,
   "text": "السلام علیک یا داعی الله و ربانی آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.18,
   "end": 12.52,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.52,
   "end": 18.3,
   "text": "در مورد بحث احکام و اینا اجازه بفرمایید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.3,
   "end": 24.78,
   "text": "امروز یه زیربنایی رو از بحث فقهی عرض کنیم که همه این فقه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.78,
   "end": 28.0,
   "text": "بر اساس یک عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.0,
   "end": 32.56,
   "text": "بستر سازی شده است و مبنای عرفانی و شناختی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.56,
   "end": 38.98,
   "text": "یعنی چی؟ مثلا این که ما خب چند وقت است که در خصوص احکام جماعت با هم حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.98,
   "end": 42.16,
   "text": "این که می‌فرماید نماز جماعت این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.16,
   "end": 46.9,
   "text": "تاثیرات دارد یا ثواب دارد و این‌ها و جایگاه دارد؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.9,
   "end": 50.02,
   "text": "نماز جماعت یعنی چه جماعتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.02,
   "end": 52.8,
   "text": "به نظر بنده حقیر نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.8,
   "end": 58.44,
   "text": "اون نقطه‌ای که محل اتکای این عرفان و این شناخت واقع شده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.44,
   "end": 63.28,
   "text": "یعنی شده محلی که این فقه از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.28,
   "end": 70.66,
   "text": "صعود کرده است عزیز دلم که کلام معصوم می‌شود قرآن صاعد، قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.66,
   "end": 75.24,
   "text": "صعود کرده. اون بر اساس همون بحث اجتماع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.24,
   "end": 81.48,
   "text": "اجتماع یعنی یک جماعتی از اهل ایمان بیان و اجتماع کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.48,
   "end": 85.32,
   "text": "به مقام جمعی برسند قلبشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.32,
   "end": 87.66,
   "text": "به سمت یک نقطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.66,
   "end": 91.5,
   "text": "به دور یک قطب بگردد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.5,
   "end": 93.94,
   "text": "معطوف به اون سمت بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.94,
   "end": 96.72,
   "text": "یعنی همون مقام جمعی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.72,
   "end": 98.58,
   "text": "به قلب ربط پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.58,
   "end": 102.46,
   "text": "و الا اگر قرار باشد که جماعتی گرد هم جمع شوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.46,
   "end": 107.08,
   "text": "در حالی که قلوب‌شون شتاست و جدا و متشتت است، خب این چه جماعتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.08,
   "end": 110.34,
   "text": "چه ثوابی؟ این نکته رو توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.34,
   "end": 113.04,
   "text": "اهمیت اجتماع و جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.04,
   "end": 118.92,
   "text": "که امیدواریم خدا این بلای عمومی رو برطرف کند و هرچه زودتر این اجتماعات اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.92,
   "end": 122.14,
   "text": "ایمان بهتر از قبل پا بگیره انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.14,
   "end": 124.88,
   "text": "یکی از نکات بسیار مهمی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.88,
   "end": 132.28,
   "text": "الصاق می‌کنیم و سنجاق می‌کنیم به بحث جلسه قبل‌مون در ادامه موضوع قلب منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.28,
   "end": 136.72,
   "text": "که خیلی به دردتون می‌خوره، همون بحث سوختن و این‌ها، اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.72,
   "end": 140.86,
   "text": "ارتباط سوختن و حس حضور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.86,
   "end": 146.9,
   "text": "به عالم زر است و اصلاً معنای عالم زر چیست که ارتباطش با این چگونه باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.9,
   "end": 148.82,
   "text": "اینو خوب دقت کنید خیلی به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.82,
   "end": 152.64,
   "text": "ما جلسه پیش عرض کردیم که همه چیز در سوختن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.64,
   "end": 155.18,
   "text": "اگر خدای منان می‌فرماید که \"أنا عند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.18,
   "end": 158.9,
   "text": "منكسرة قلوبهم\" من در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.9,
   "end": 164.32,
   "text": "نزد اون شکسته دلهام یا دل‌های شکسته ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.32,
   "end": 166.02,
   "text": "خب دل چی میشه که می‌شکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.02,
   "end": 172.32,
   "text": "می‌سوزه. وقتی می‌سوزه پیداست که ظرفیت و سعه وجودی پیدا می‌کنه که خدا جاش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.32,
   "end": 177.08,
   "text": "خدا هیچ کجا جاش نمیشه الا در قلب شکسته یا در قلب مؤمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.08,
   "end": 181.94,
   "text": "در قلب سوزناک. این سوز رو گرفتیم همون حس حضور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.94,
   "end": 185.96,
   "text": "که این حس حضور به یک معنا می‌شود همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.96,
   "end": 189.78,
   "text": "نقطه زیر با. حس حضور، همین سوختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.78,
   "end": 194.76,
   "text": "که اگر تمام قرآن جمع شده باشد اگر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.76,
   "end": 197.46,
   "text": "قطعاً جمع شده است در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.46,
   "end": 200.94,
   "text": "اون بسم الله الرحمن الرحیم و اون هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.94,
   "end": 203.2,
   "text": "اون نقطه زیر با،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.2,
   "end": 206.52,
   "text": "اون نقطه زیر با همان سوختن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.52,
   "end": 208.66,
   "text": "همان حس حضور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.66,
   "end": 214.22,
   "text": "یعنی اگر هر چیزی تو رو به سوختن و حس حضور رساند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 214.22,
   "end": 217.44,
   "text": "او تو رو به حقیقت نزدیک کرده و الا دورتر شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.44,
   "end": 220.96,
   "text": "حالا چه شیرین که مولامون علی علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.96,
   "end": 225.28,
   "text": "فرمودند که أنا نقطة تحت الباء اون نقطه زیر با منم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.28,
   "end": 229.98,
   "text": "یعنی هر-- به یک معنا البته به یک وجه هرکس به ولایت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.98,
   "end": 232.18,
   "text": "ملتزم شود او هم می‌سوزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.18,
   "end": 235.78,
   "text": "او هم همراه من می‌سوزد، به حس حضور می‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.78,
   "end": 239.54,
   "text": "و چه شیرین‌تر اینکه در اون حدیث شریف فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.54,
   "end": 242.1,
   "text": "العلم نقطة. به به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.1,
   "end": 245.24,
   "text": "العلم نقطة. العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.24,
   "end": 247.26,
   "text": "نقطة. یعنی علم یک نقطه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.26,
   "end": 249.98,
   "text": "حالا بگیرید الصاقش کنید به اون بحث چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.98,
   "end": 252.94,
   "text": "علم یک نقطه است. کفرها الجاهلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.94,
   "end": 260.02,
   "text": "یعنی هر-- اگر تو به سوختن رسیدی علم همون علمیست که العلم نور یضعه الله في قلب من یشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.02,
   "end": 262.32,
   "text": "پس جواب سؤال خیلی‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.32,
   "end": 269.62,
   "text": "بسیار حالا یا از، از شود مدیر کانال یا از بنده حقیر می‌پرسند که چه کنیم ظرفیت وجودی ما زیاد بشود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.62,
   "end": 274.82,
   "text": "هی شما می‌گید آقا فاعلیت نظام هستی در دهش بخل ندارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.82,
   "end": 277.58,
   "text": "اشکال در قابلیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.58,
   "end": 281.58,
   "text": "قوابل مشکل دارند که إن الأعطیات على قدر القابليات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.58,
   "end": 283.78,
   "text": "خب چه کنیم که قابلیتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.78,
   "end": 287.7,
   "text": "زیاد بشود؟ به یک معنا چه کنیم که سعه وجودی پیدا کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.7,
   "end": 291.54,
   "text": "خب آقا بسم الله. هر آنچه که تو را بسوزاند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.54,
   "end": 293.16,
   "text": "به حس حضور بکشاند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.16,
   "end": 296.1,
   "text": "اینجا مراقبت حرف اول رو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.1,
   "end": 300.42,
   "text": "وقتی حالا ربطش به بحث عالم زر رو الان متوجه می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.42,
   "end": 304.82,
   "text": "وقتی این قلب انقدر بسوزد، انقدر بسوزد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.82,
   "end": 308.94,
   "text": "که گنجایشش به حدی بشود که بتواند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.94,
   "end": 311.82,
   "text": "قبل و بعد سیطره پیدا کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.82,
   "end": 317.72,
   "text": "یعنی بتواند ماقبل را بخواند و مابعد را بداند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.72,
   "end": 322.14,
   "text": "یه چنین سعه‌ای وقتی کسی پیدا کرد می‌شود همون عالم زر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 322.14,
   "end": 325.62,
   "text": "شما توجه بفرمایید که یعنی از پس سوختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.62,
   "end": 328.72,
   "text": "قلب مقام قلب این چنین است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.72,
   "end": 331.46,
   "text": "که به یه همچین جایگاهی خواهد رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.46,
   "end": 335.64,
   "text": "حالا شما توجه بفرمایید در آیه صد و هفتاد و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.64,
   "end": 337.84,
   "text": "اعراف باید باشه اگر اشتباه نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.84,
   "end": 340.68,
   "text": "ببینید حالا که اونجا که خدا می‌فرماید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 340.68,
   "end": 345.68,
   "text": "أخذ ربک من بني آدم من ظهورهم ذريتهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 345.68,
   "end": 351.62,
   "text": "این ذريتهم نقطه اتکای ما در این آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.62,
   "end": 354.88,
   "text": "وأشهدهم على أنفسهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.88,
   "end": 360.65,
   "text": "اونجا خدا، پروردگار تو می‌فرماید که از پشت فرزندان آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.65,
   "end": 362.85,
   "text": "که همون ذریه او بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.85,
   "end": 365.81,
   "text": "اینها ازشون چیکار کرد خدای منان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.81,
   "end": 371.51,
   "text": "شهادت، یعنی شهادت خواست ازشون \"أشهدهم على أنفسهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.51,
   "end": 375.29,
   "text": "بر خودشون گواه ساخت شهادت اینها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.29,
   "end": 380.75,
   "text": "که چی بشه؟ \"ألست بربكم\" آیا پروردگار شما نیستم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.75,
   "end": 383.33,
   "text": "اینجا \"قالوا بلى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.33,
   "end": 385.95,
   "text": "همه گواهی دادیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.95,
   "end": 392.79,
   "text": "چی؟ بله. \"أن تقولوا يوم القيامة إنا كنا عن هذا غافلين\" که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.79,
   "end": 395.13,
   "text": "تا انتهای آیه و اینها. اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.13,
   "end": 397.93,
   "text": "اشاره دارد به همون عالم ذر به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 397.93,
   "end": 402.21,
   "text": "حالا عالم هم خب میدونید اصطلاحات وسیعی دارد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 402.21,
   "end": 408.63,
   "text": "حالا عالم مثلا عقل، عالم خیال، عالم طبیعت، عالم علم، عالم خواب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.63,
   "end": 412.73,
   "text": "عالم بیداری، عالم انس، جن، حیوانات اینها اصطلاحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.73,
   "end": 417.85,
   "text": "یک اطلاقش هم یک کاربردش هم در عالم ذر هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.85,
   "end": 420.13,
   "text": "حالا اینکه چرا می‌گوین ذر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.13,
   "end": 423.53,
   "text": "این را هم خب می‌دانید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.53,
   "end": 428.07,
   "text": "منشأ اشتقاق ذر رو بعضیا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.07,
   "end": 430.61,
   "text": "ورأه گرفتن به معنای خلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 430.61,
   "end": 433.61,
   "text": "که ذریه هم به معنای همون مخلوقه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 433.61,
   "end": 437.49,
   "text": "بعضیا گفتن نه از ذر به معنای موجودات ریز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.49,
   "end": 441.67,
   "text": "مثل ذرات غبار یا مثلا در عرب به مورچه میگن ور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.67,
   "end": 445.53,
   "text": "بعضی گفتن که از ذر به معنای ورّه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.53,
   "end": 449.23,
   "text": "ورّه که یعنی تفرق و پراکندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.23,
   "end": 458.01,
   "text": "که به همین خاطر در عالم ذر حالا نظرات مفسرین، حکما و عرفا خیلی پراکنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.01,
   "end": 461.37,
   "text": "و گوناگون است. ما چون سیر بحثمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.37,
   "end": 467.83,
   "text": "زیل فرمایشات حضرت استاد علامه حسن زاده علیه الرحمه هست، توجهتون رو جلب می‌کنم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.83,
   "end": 472.39,
   "text": "نکته سیصد و نه کتاب شریف هزار و یک نکته ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.39,
   "end": 477.85,
   "text": "ایشون می‌فرمایند که عالم ذر چنانکه از روایات آن با تأیید و تسدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.85,
   "end": 484.51,
   "text": "روایات دیگر و اصول براهین عقی-عقلیه مستفاده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.51,
   "end": 489.07,
   "text": "عبارت از؛ ببینید داره عالم ذر رو بر اساس یعنی بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 489.07,
   "end": 493.13,
   "text": "بستر روایات و اصول عقلیه بیان می‌کنه علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 493.13,
   "end": 496.89,
   "text": "چگونه؟ تو یک جمله دقت کنید عبارت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 496.89,
   "end": 501.37,
   "text": "فرقان کثرت از متن قرآن وحدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 501.37,
   "end": 504.13,
   "text": "در قلب لیلة القدر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 504.13,
   "end": 506.71,
   "text": "ففهم. حالا این ففهم هم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 506.71,
   "end": 509.37,
   "text": "نشون میده که عبارت بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 509.37,
   "end": 511.89,
   "text": "مغزای غنی‌ای دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 511.89,
   "end": 517.61,
   "text": "لذا می‌فرماید ففهم یا فت دبر، فت عمل و این قبیل الفاظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 517.61,
   "end": 521.51,
   "text": "پس این فرقان کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.51,
   "end": 523.77,
   "text": "یا قرآن وحدت چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 523.77,
   "end": 526.51,
   "text": "همون چیزی که عرض کردیم. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.51,
   "end": 531.05,
   "text": "یه توضیح کوچولو عرض کنم که از تمثل تفصیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 531.05,
   "end": 535.03,
   "text": "فرقانی موجودات برای انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.03,
   "end": 539.57,
   "text": "در مقام قلب البته به عالم ذر تعبیر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.57,
   "end": 541.15,
   "text": "تمثل چی؟ تفصیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 541.15,
   "end": 545.61,
   "text": "ببینید ما یک وجود جمعی قرآنی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 545.61,
   "end": 548.15,
   "text": "که حقایق دو نحو وجود دارن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 548.15,
   "end": 552.03,
   "text": "یکیش وجود جمعی قرآنی‌ست چون قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 552.03,
   "end": 553.79,
   "text": "القرآن مقام جمعی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 553.79,
   "end": 557.37,
   "text": "یک وجود تفصیلی قرآنی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.37,
   "end": 565.89,
   "text": "که حضرت آدم هم آنچه را که بعدا تحقق پیدا می‌کرد در قالب شکلی متمثل دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.89,
   "end": 572.61,
   "text": "از همین تمثل حقایق برای حضرت آدم تعبیر به عالم ذر شده که از تعالم در حقیقت همین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 572.61,
   "end": 574.97,
   "text": "توضیح دادم که یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 574.97,
   "end": 581.27,
   "text": "یعنی میشه گفت که همه موجودات یک وجود جمعی دارند، یک وجود تفصیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 581.27,
   "end": 586.05,
   "text": "اونم در لیلة القدر قلب انسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 586.05,
   "end": 593.61,
   "text": "که همه این حقایق جمعی به نحو حقایق تفصیلی متمثل می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 593.61,
   "end": 600.79,
   "text": "یعنی که اون قرآنی که مقام جمعی موجوداته در لیلة القدر قلب به نحو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 600.79,
   "end": 603.29,
   "text": "فرقان متمثل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 603.29,
   "end": 606.57,
   "text": "یعنی اون مقام تفصیل رو میگن فرقان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.57,
   "end": 608.69,
   "text": "مقام جمع رو میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 608.69,
   "end": 611.81,
   "text": "قرآن که \"إنا أنزلناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 611.81,
   "end": 614.39,
   "text": "في ليلة القدر\" چه شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 614.39,
   "end": 618.67,
   "text": "که حالا اینجا لیلة القدر اشاره به اون مقامیه که در اون مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 618.67,
   "end": 627.93,
   "text": "حقایق کلمات وجودیه همه حقایق همه کلمات وجودیه برای عارف کامل تمثل پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 627.93,
   "end": 633.25,
   "text": "که حالا اینجا همه حقایق در روح انسان به نحو جمعی قرآنی وجود دارن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 633.25,
   "end": 635.23,
   "text": "مگه اینطور نیست؟ این بحث‌ها رو قبلا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 635.23,
   "end": 641.27,
   "text": "همه حقایق در روح انسان که مرتبه احدیت صورت اهدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 641.27,
   "end": 644.97,
   "text": "وجود ماست به نحو جمعی قرآنی وجود دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 644.97,
   "end": 651.89,
   "text": "که ما شب قدر که قرآن به سر می‌گیریم داریم تطبیق میدیم اون قرآن رو با قرآن وجودیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 651.89,
   "end": 656.75,
   "text": "و انزال این حقیقت جمعی از مقام روح به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 656.75,
   "end": 658.57,
   "text": "قلب را فرقان گویند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 658.57,
   "end": 660.59,
   "text": "به مقام چی؟ قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 660.59,
   "end": 663.19,
   "text": "انزال اون حقیقت جمعی از مقام روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 663.19,
   "end": 665.27,
   "text": "روح بسیطه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 665.27,
   "end": 668.23,
   "text": "از اون مقام به مقام قلب رو میگن فرقان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 668.23,
   "end": 670.37,
   "text": "حالا فکر می‌کنم دیگه جا افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 670.37,
   "end": 674.13,
   "text": "حالا فرق قرآن با فرقان در اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 674.13,
   "end": 677.17,
   "text": "باز عرض می‌کنم قرآن عبارت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 677.17,
   "end": 680.41,
   "text": "اون مقام جمعی حقایقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 680.41,
   "end": 686.67,
   "text": "و فرقان عبارت است از اون مقام و نشئه تفصیلی حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 686.67,
   "end": 692.89,
   "text": "که حالا در قلب انسان کامل حقایق جمعی عالم تفصیل و تمثل پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 692.89,
   "end": 695.95,
   "text": "به این میگن همون مقام چی؟ حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 695.95,
   "end": 700.77,
   "text": "عالم ذر که از این تمثل حقایق تفصیلیه در مقام قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 700.77,
   "end": 703.43,
   "text": "اولیاى الهی تعبیر به عالم ذر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 703.43,
   "end": 706.05,
   "text": "حالا به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 706.05,
   "end": 710.37,
   "text": "همونطور که انسان می‌تونه با گذشته‌ش ارتباط بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 710.37,
   "end": 712.85,
   "text": "و حقایق گذشته رو بدونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 712.85,
   "end": 718.57,
   "text": "می‌تونه با آینده هم ارتباط بگیره و حقایق تفصیلی و اون حوادثی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 718.57,
   "end": 720.87,
   "text": "در آینده اتفاق میفته رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 720.87,
   "end": 724.74,
   "text": "به تفصیل اِاِاِ درک کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 724.74,
   "end": 729.12,
   "text": "و اون معانی مدرکه رو مفصل و متمثل کنه به این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 729.12,
   "end": 731.4,
   "text": "یعنی این همون حقیقت مع-- چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 731.4,
   "end": 734.88,
   "text": "عالم زر که حضرت آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 734.88,
   "end": 738.62,
   "text": "ذریه‌ش رو به شکل ذراتی متمثل شده دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 738.62,
   "end": 741.96,
   "text": "این یعنی همون. حالا عبارت دیگری رو هم به اجازه بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 741.96,
   "end": 746.1,
   "text": "حالا نفس از علامه چون درشه براتون بخونم اینم شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 746.1,
   "end": 748.7,
   "text": "باز از علامه بیان همین مقام رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 748.7,
   "end": 750.82,
   "text": "می‌فرمایند بیانش این است. بیان چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 750.82,
   "end": 753.24,
   "text": "همین عالم زر که مربوط به قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 753.24,
   "end": 756.18,
   "text": "مقام تفصیل در قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 756.18,
   "end": 764.98,
   "text": "بیانش این است که عارف کامل در هر مرتبه از عالم هم قبل آن را می‌خواند و هم بعد آن را می‌داند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 764.98,
   "end": 770.54,
   "text": "ببینید چه زیبا هم قبل آن را می‌خواند و هم بعد آن را می‌داند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 770.54,
   "end": 772.66,
   "text": "اون که می‌خواند میشه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 772.66,
   "end": 775.08,
   "text": "جمعی. اون که می‌داند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 775.08,
   "end": 777.82,
   "text": "از قبل می‌شود فرقان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 777.82,
   "end": 780.16,
   "text": "تفصیلی. حالا ادامه عبارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 780.16,
   "end": 786.26,
   "text": "اما قبل را برای اینکه قرآنس یعنی جمع و متن مابعدش است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 786.26,
   "end": 790.06,
   "text": "از این جهت می‌خونه چون متنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 790.06,
   "end": 793.86,
   "text": "متنه. اصله. لفظ قضاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 793.86,
   "end": 799.16,
   "text": "و اما بعد را برای اینکه فرقانه است یعنی شرح و تفصیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 799.16,
   "end": 802.2,
   "text": "ماقبلش است از این جهت میدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 802.2,
   "end": 805.38,
   "text": "چون وقتی متن رو داره خب شرحش رو هم میدونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 805.38,
   "end": 808.68,
   "text": "شرحش میشه تفصیل میشه فرقان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 808.68,
   "end": 811.86,
   "text": "و قلب چنان عارف ربانی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 811.86,
   "end": 816.52,
   "text": "دقت کنید عبارت رو و قلب چنان عارف ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 816.52,
   "end": 820.26,
   "text": "مصداق انا انزلناه في ليلة القدر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 820.26,
   "end": 828.3,
   "text": "یا حالا چه شیرین که علامه می‌فرمایند و کثرت آحاد بنی‌آدم را مثلا در مقام تمثل همانند زر می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 828.3,
   "end": 830.56,
   "text": "فتدبر، فتدبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 830.56,
   "end": 832.44,
   "text": "حالا اینجا چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 832.44,
   "end": 836.66,
   "text": "چقدر شیرین که حالا به ليلة القدر آمده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 836.66,
   "end": 839.22,
   "text": "به بحث ليلة القدر آمده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 839.22,
   "end": 843.92,
   "text": "ليلة القدر چرا مثلا روز قدر نفرمودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 843.92,
   "end": 846.1,
   "text": "ليل اشاره دارد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 846.1,
   "end": 848.0,
   "text": "شب دیگه شنودم در شب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 848.0,
   "end": 851.26,
   "text": "این مباحث را قبلاً عرض کردیم خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 851.26,
   "end": 855.44,
   "text": "حالا وقتی که چون می‌فرماید انا انزلناه قوس، قوس نزول است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 855.44,
   "end": 864.6,
   "text": "در قوس نزول ما کل به صورت کلی قبلاً عرض کردیم که مراتب عالیه نسبت به مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 864.6,
   "end": 869.08,
   "text": "به منزله روز هستند، روشن‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 869.08,
   "end": 874.64,
   "text": "مادون ظلمت دارند یعنی مادون لیل است ما فوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 874.64,
   "end": 880.82,
   "text": "چی؟ نهار است، روز است و وقتی که قوس نزول است انا انزلناه في ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 880.82,
   "end": 884.34,
   "text": "خب از ما فوق داره به مادون نازل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 884.34,
   "end": 886.82,
   "text": "در حقیقت در لیل نازل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 886.82,
   "end": 892.62,
   "text": "این یک معناش البته. ولی وقتی که در قوس صعود قرار می‌گیری بلعکس میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 892.62,
   "end": 897.76,
   "text": "در قوس صعود که ما الان در اون مر-مرتبه هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 897.76,
   "end": 900.62,
   "text": "از در حقیقت لیل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 900.62,
   "end": 905.22,
   "text": "نهار میری از شب به روز میری چون مرتبه مادون نشئه طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 905.22,
   "end": 907.98,
   "text": "وقتی می‌خوای بری به عالم مثال و عقل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 907.98,
   "end": 911.28,
   "text": "الاهیته نظام و این‌ها یا مقام قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 911.28,
   "end": 917.16,
   "text": "می‌شود چی؟ یا مقام جمعی و اگر روح بگیری همینطور می‌شود از لیل به نهار از شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 917.16,
   "end": 921.54,
   "text": "لذا در قرآن غالباً می‌بینید که لیل مقدم شده بر نهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 921.54,
   "end": 927.24,
   "text": "مثلاً والليل اذا يغشى والنهار اذا تجلى یا طولج الليل في النهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 927.24,
   "end": 930.16,
   "text": "همچنین اینم به همون معناست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 930.16,
   "end": 932.48,
   "text": "که حالا اینم چه شیرین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 932.48,
   "end": 937.24,
   "text": "فرمودند که این ليلة القدر این لیله حضرت زهراست و قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 937.24,
   "end": 942.48,
   "text": "خدای منان. پس در کل این که ما بتوانیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 942.48,
   "end": 947.44,
   "text": "قبل، قبل‌مان را بخوانیم و بعدمان را بدانیم می‌شود همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 947.44,
   "end": 953.46,
   "text": "مقام عالم زر که امکانش از این مقام به روی عهدی بسته نیست می‌شود رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 953.46,
   "end": 956.7,
   "text": "یکی از در حقیقت ظرفیت‌های قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 956.7,
   "end": 965.08,
   "text": "قلب ما که منزلگاه القاءات و الهامات الهی و حقایق نظام هستی است و ما متاسفانه از اون غافل بودیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 965.08,
   "end": 967.62,
   "text": "متاسفانه قلبمون رو در حجاب قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 967.62,
   "end": 972.88,
   "text": "ان شا الله که به برکت این ایام خدای منان نظر کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 972.88,
   "end": 976.98,
   "text": "و این حجاب‌ها برطرف شود و منزلگاه",
