 ],
 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 4.52,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.52,
   "end": 8.32,
   "text": "آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.32,
   "end": 12.6,
   "text": "عزیزانی که در صفوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.6,
   "end": 14.74,
   "text": "نماز جماعت می‌ایستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.74,
   "end": 17.2,
   "text": "اگر ببینند که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.2,
   "end": 23.08,
   "text": "کسایی که جلوی اون‌هستند یا از کنارشون اتصال رو برقرار کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.08,
   "end": 29.28,
   "text": "هنوز آماده نماز جماعت نیستند و اتصال شما از طریق اون‌هاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.28,
   "end": 32.48,
   "text": "آیا شما می‌تونی ورود به نماز جماعت کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.48,
   "end": 38.1,
   "text": "در حالی که هنوز این جلویی‌هات آماده نماز جماعت نیستند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.1,
   "end": 40.56,
   "text": "مثلاً داره هنوز طرف با موبایلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.56,
   "end": 45.3,
   "text": "صحبت می‌کنه یا موبایلشو نگاه می‌کنه یا با بغل دستی‌ش داره صحبت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.3,
   "end": 50.54,
   "text": "یا مثلاً روش اونوره داره شلوارشو می‌کشه بالا یا بالاخره یه چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.54,
   "end": 53.6,
   "text": "نشون میده آماده در هیئت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.6,
   "end": 58.08,
   "text": "کثوت شروع به نماز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.08,
   "end": 60.76,
   "text": "فرمودند خیر، نمی‌تونید شما اینجا ورود کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.76,
   "end": 65.92,
   "text": "وقتی اون کسی که اتصال شما رو با امام برقرار کرده، حالا هر چند نفرند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.92,
   "end": 69.52,
   "text": "چه یه نفرند، چه ده‌ها نفر هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.52,
   "end": 73.38,
   "text": "آماده نیستند، نمی‌تونید شما تکبیرة الاحرام بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.38,
   "end": 75.48,
   "text": "مگر اینکه آماده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.48,
   "end": 82.3,
   "text": "یعنی مثلاً طرف ایستاده آماده‌ی شروعه اما هنوز تکبیرة الاحرام نگفته اشکال نداره شما می‌تونید اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.3,
   "end": 87.24,
   "text": "ورود کنید. پس ملاک گفتن تکبیرة الاحرام اونا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.24,
   "end": 89.48,
   "text": "ولو اونا تکبیرة الاحرام نگفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.48,
   "end": 92.08,
   "text": "ملاک آمادگیشون براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.08,
   "end": 98.76,
   "text": "ورود به نماز جماعته. اگه می‌بینی آماده‌ست طرف شما می‌تونی تکبیرة الاحرام یعنی زودتر از اون هم بگی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.76,
   "end": 106.48,
   "text": "ورود به جماعت کنی. بحث ما تو بله بحث قلب منزل به اینجا رسید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.48,
   "end": 109.94,
   "text": "هر آینه ذره‌ای هوای نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.94,
   "end": 113.76,
   "text": "و رها کردن اژدهای نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.76,
   "end": 118.44,
   "text": "فیض رو قطع می‌کنه و البته شما چون حرف شنیده هستید و الحمد لله دیگه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.44,
   "end": 122.84,
   "text": "فیض قطع می‌شه نه یعنی از ناحیه حضرت حق قطع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.84,
   "end": 126.58,
   "text": "نه. اینو که عرض شد فیض دائماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.58,
   "end": 130.98,
   "text": "از طرف فیاض علی الاطلاق در حال ریزشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.98,
   "end": 133.72,
   "text": "قطع شدن که می‌گیم فیض قطع شد یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.72,
   "end": 136.14,
   "text": "در قلب تو به روی فیض بسته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.14,
   "end": 139.54,
   "text": "منظور اینه و خودت رو محروم کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.54,
   "end": 142.32,
   "text": "لذا می‌گیم هرچی فریاد داری بر سر خودت بکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.32,
   "end": 145.06,
   "text": "خودت هرچی کردی خودت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.06,
   "end": 147.48,
   "text": "اصلاً و ابداً ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.48,
   "end": 153.48,
   "text": "وقتی آیات قرآن رو نگاه می‌کنیم، اون امانت الهی رو وقتی اختیار کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.48,
   "end": 159.8,
   "text": "منظور از این امانت تسبیح و قنوت و دعا و این‌ها نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.8,
   "end": 164.42,
   "text": "درسته خدا فرمود که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.42,
   "end": 167.4,
   "text": "قل لا یبع بکم لولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.4,
   "end": 171.3,
   "text": "دعاکم لا یبع بکم ربي به اینا بگو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.3,
   "end": 176.92,
   "text": "اصلاً به شما نظر نمی‌کرد، عنایت نمی‌کرد، توجهی به شما نداشت پروردگار من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.92,
   "end": 180.4,
   "text": "لولا دعاکم اگر دعای شما نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.4,
   "end": 183.36,
   "text": "اگر شما دعا نمی‌کردید. درسته اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.36,
   "end": 185.78,
   "text": "اما باید دید منظور از دعا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.78,
   "end": 190.74,
   "text": "دعا نه یعنی لغلغه زبان، نه یعنی وردی رو باید از زبانت جاری کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.74,
   "end": 192.48,
   "text": "دعا یعنی خواندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.48,
   "end": 195.68,
   "text": "یعنی همه قوای وجودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.68,
   "end": 198.1,
   "text": "تحت فرمان امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.1,
   "end": 200.78,
   "text": "قلبت خدا را بخواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.78,
   "end": 204.98,
   "text": "به این می‌گن دعا. همه قوای وجودیت خدا را بخواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.98,
   "end": 210.32,
   "text": "حالا اگر کسی اینطوری نبود ولو تسبیح دستش باشه به قول علامه علیه الرحمه بس بس هم بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.32,
   "end": 211.98,
   "text": "این، این که دعا نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.98,
   "end": 213.9,
   "text": "این که ذکر نیست، این ورد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.9,
   "end": 216.52,
   "text": "حالا ورد هست ولی ذکر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.52,
   "end": 220.52,
   "text": "اونجا که فرمود انا عرضنا الامانة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.52,
   "end": 227.36,
   "text": "علی السماوات والارض والجبال فابین ان يحملنها وشفقن منها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.36,
   "end": 232.18,
   "text": "اینا ابا کردن از اینکه بپذیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.18,
   "end": 236.58,
   "text": "اونقدر که بار سنگین بود. اون ابا شیطانو با این قاطی نکنید که اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.58,
   "end": 241.54,
   "text": "ابا و استکبر. اون ابا شیطان از رو استکبار بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.54,
   "end": 243.78,
   "text": "این ابایی که اینجا کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.78,
   "end": 249.36,
   "text": "فابین ان يحملنها وشفقن منها تو وشفقن منها معلومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.36,
   "end": 252.72,
   "text": "ترسیدن. خوف داشتن از برداشتن این بار سنگین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.72,
   "end": 256.24,
   "text": "کی؟ آسمان‌ها و زمین و کوه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.24,
   "end": 260.76,
   "text": "فحملها الانسان این انسان برداشت این بار رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.76,
   "end": 264.7,
   "text": "خب شما بفرمایید اگر قرار بود این بار امانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.7,
   "end": 266.88,
   "text": "همین تسبیح باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.88,
   "end": 270.86,
   "text": "چرا قرآن می‌گه ان من شيء الا یسبح بحمده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.86,
   "end": 274.48,
   "text": "هیچ چیزی نیست مگر اینکه تسبیح گوی خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.48,
   "end": 277.46,
   "text": "خب پس پیداست که تسبیح نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.46,
   "end": 280.4,
   "text": "اگر دعا و قنوت و نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.4,
   "end": 282.8,
   "text": "ظاهری و این چیزا باشه خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 282.8,
   "end": 286.36,
   "text": "خود قرآن می‌گه کل له قانتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 286.36,
   "end": 290.2,
   "text": "اصلاً همه برای خدا در حالت قنوت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.2,
   "end": 293.6,
   "text": "پس پیداست اون امانت این هم نبوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.6,
   "end": 296.52,
   "text": "چون همه موجودات این رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 296.52,
   "end": 298.28,
   "text": "پس این امانت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 298.28,
   "end": 305.18,
   "text": "کارشناس دین که امام معصومه فرقه برداری کرده اون امانت رو فرموده ولایت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 305.18,
   "end": 307.88,
   "text": "ولایت مآل الله بوده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 307.88,
   "end": 313.5,
   "text": "که انسان این رو برداشت. ولایت هم یعنی تحقق اسماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.5,
   "end": 316.84,
   "text": "تحقق اسماء یعنی تلبس به اسماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 316.84,
   "end": 320.64,
   "text": "یعنی لباس اسماء خدا رو به تنت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 320.64,
   "end": 325.8,
   "text": "یعنی اینکه لباس مثلاً اسم الرؤوف خدا رو به تنت کنی تو هم مهران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.8,
   "end": 331.84,
   "text": "لباس مثلاً الرحیم، الرحمن، لباس المنتقم در برابر دشمن رو به تنت کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 331.84,
   "end": 338.56,
   "text": "و هر چیزی که چیز آسونیه، گفتنش خیلی آسونه اما در عمل مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.56,
   "end": 341.94,
   "text": "فهمش سخت نیست. تلقّی به اس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.94,
   "end": 346.9,
   "text": "به اخلاق الهی یعنی همون تلبس به اسماء فهمش سخت نیست به همین راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.9,
   "end": 353.5,
   "text": "اما در عمل سخته. این که ما هی تسبیح دستمون بگیریم هی بس بس به قول علامه بکنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.5,
   "end": 358.14,
   "text": "این که نشد که اون حقیقتی که می‌گه قلبت همراه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.14,
   "end": 363.24,
   "text": "قلب وقتی همراهه که قلب اتصالش از اون مبدأ فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.24,
   "end": 366.08,
   "text": "قطع نشه به تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.08,
   "end": 368.76,
   "text": "به تمامه که البته هیچوقت قطع نمی‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.76,
   "end": 375.98,
   "text": "از جهت اینکه انعکاس بدهد فیض رو از مرتبه‌ی احدیت که مرتبه‌ی روح بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.98,
   "end": 379.42,
   "text": "گفتیم روح صورت احدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.42,
   "end": 382.46,
   "text": "به قلب که صورت الهیته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.46,
   "end": 386.42,
   "text": "به ذیل قلب که دیگه مر-مرتبه کثرت و کثراته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 386.42,
   "end": 392.48,
   "text": "قوه‌ی وهمت، خیالت، عقلت تا اعضا و جواره و جوانه و جواهرت همه و همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 392.48,
   "end": 395.5,
   "text": "اگر این فیض رو انتقال داد قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.5,
   "end": 399.28,
   "text": "بله ولی اگر نداد علتش یه مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.28,
   "end": 402.84,
   "text": "شما گاهی اوقات می‌بینید تنظیم نیست موتور ماشینت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.84,
   "end": 406.18,
   "text": "موتور ماشینت تنظیم نیست و سر و صداهایی از توش در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.18,
   "end": 409.38,
   "text": "یه مشکلاتی ایجاد شده. سریع می‌ری پیش متخصص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.38,
   "end": 412.8,
   "text": "میگه این مشکله داره. مثلاً روغنان، گیری بوکش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.8,
   "end": 416.9,
   "text": "کمه، روغن موتورت کمه، این نشتی داشته، اون فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.9,
   "end": 419.56,
   "text": "اون نشتی قلب می‌شه هوای نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.56,
   "end": 425.58,
   "text": "قلب وقتی نشتی پیدا کرد، نفوذ پیدا کردن شیاطین به قلب انسان، \"یحمون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.58,
   "end": 430.22,
   "text": "هجوم میارن \"على انفسهم\" میان حمله می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 430.22,
   "end": 432.5,
   "text": "از طریق قلب حمله می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.5,
   "end": 435.28,
   "text": "قلب انسان رو غافل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.28,
   "end": 441.8,
   "text": "غافل از حضور. و اگر این اتفاق افتاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 441.8,
   "end": 446.08,
   "text": "ما دیگه نباید توقع داشته باشیم که قلبمون محل نزول حقایق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.08,
   "end": 449.46,
   "text": "نباید توقع داشته باشیم بشینیم تو مجلس امام حسین یا حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.46,
   "end": 454.24,
   "text": "سلام الله علیهما مثل همیشه تا اسم خانم رو آوردن، اسم ارباب رو آوردن دل بشکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 454.24,
   "end": 460.18,
   "text": "نه نمی‌شه. دل تا در حضور قرار نگیرد نمی‌سوزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.18,
   "end": 462.3,
   "text": "قبلاً این رو بحثشو کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.3,
   "end": 464.64,
   "text": "سوختن قلب نشان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 464.64,
   "end": 467.98,
   "text": "شدت حضوره، حس حضوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.98,
   "end": 473.48,
   "text": "نمی‌شه و با هوای نفس هم جور در نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 473.48,
   "end": 476.74,
   "text": "نفس اژد-- می‌گن نفس اژدهاست یا اژدرهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 476.74,
   "end": 481.12,
   "text": "کی او خفته‌ست از غم بی‌عالتی افسرده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.12,
   "end": 484.44,
   "text": "فکر می‌کنه که آله آرالم که دستش یه تسبیح گرفته و یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 484.44,
   "end": 489.04,
   "text": "زمونه نمازی و هیئتی و خودم اینطوری لباس پیغمبر تن کرده و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 489.04,
   "end": 491.38,
   "text": "دیگه مثلاً نفسشو کشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.38,
   "end": 494.84,
   "text": "نه داداش صبر کن. به قول علامه به وقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 494.84,
   "end": 499.76,
   "text": "صبر کن پشت میز بشینی. صبر کن یک حسبتی، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.76,
   "end": 503.66,
   "text": "هی-هیئتی، یه مسئولیتی، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 503.66,
   "end": 508.42,
   "text": "آبرویی، یه عزتی بهت بدن، اون موقع معلوم می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.42,
   "end": 513.08,
   "text": "چند مرد حلاجی. و اینم که مطلقاً مدیرا رو می‌کوبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 513.08,
   "end": 515.84,
   "text": "بفرما خودت پشت میز بشین ببینم چه می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.84,
   "end": 522.26,
   "text": "خودت همه مسئولیت این آقایی که پنج نفر زیر دستش هستن بگی بفرمایید چجوری غلط کاری می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 522.26,
   "end": 526.7,
   "text": "اتفاقاً نقل می‌کنند که یه مارگیری بود فالگیر و مارگیر و اینا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.7,
   "end": 530.28,
   "text": "قدیم‌ها زیاد بودند. رفت از تو کوهستان‌های بغداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 530.28,
   "end": 533.18,
   "text": "اونجا هوا خیلی سرد بود. یه ماره خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 533.18,
   "end": 535.36,
   "text": "بزرگی پیدا کرد برای معرکه گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 535.36,
   "end": 537.68,
   "text": "گفت ماره چیزی که اونجا افتاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 537.68,
   "end": 541.08,
   "text": "بیچاره فکر کرد این ماره هیچ مثلاً حسی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.08,
   "end": 543.4,
   "text": "ماره مثلاً خنثایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 543.4,
   "end": 547.74,
   "text": "نگو هوا سرد بود این ماره از غم بی‌عالتی افسرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 547.74,
   "end": 554.56,
   "text": "اونجا افتاده بود. کردش تو یه کیسه و خوشحال و خندان اومد صدا زد مردم رو جمع کردن تو شهر بغداد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 554.56,
   "end": 557.56,
   "text": "یه حکا-حکایتی رو نقل می‌کنند که مثلاً می‌خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.56,
   "end": 562.24,
   "text": "معرکه گیری کنن. بعد دیگه آفتاب اومده بود بالا از کوه هم اومده بود پایین دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 562.24,
   "end": 565.02,
   "text": "هوا گرم شده بود این ماره به خودش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 565.02,
   "end": 567.48,
   "text": "گفت آقا مردم جمع شید ببینید چی براتون امروز آوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.48,
   "end": 570.24,
   "text": "تا در کیسر رو باز کرد ماره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 570.24,
   "end": 574.1,
   "text": "پرید و اول کسی که هلاکش کرد خود همین مارگیره بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.1,
   "end": 578.68,
   "text": "مردم هم به فرار. نفس اژدرهاست یا اژدهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 578.68,
   "end": 583.26,
   "text": "کی او خفته‌ست از غم بی‌عالتی افسرده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 583.26,
   "end": 586.2,
   "text": "وقتی بیفتی توی معرکه، توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 586.2,
   "end": 589.48,
   "text": "جمعی، توی خلوتی، خلوت، خلوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 589.48,
   "end": 591.48,
   "text": "با بی، با نامحرم اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 591.48,
   "end": 594.08,
   "text": "چرا میگه اگه دو تا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 594.08,
   "end": 598.68,
   "text": "نامحرم یه جا خلوت کنن نفر سوم شیطانه، قطعاً شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 598.68,
   "end": 601.36,
   "text": "اینجا اون نفس خودشو اونجا نشون می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 601.36,
   "end": 605.04,
   "text": "حالا بیا هی برای من بس بس کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 605.04,
   "end": 607.94,
   "text": "اونجا و پیش میاد برای هممون پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 607.94,
   "end": 615.7,
   "text": "علت اینکه شیخ رجب علی خیاط می‌تونست ماف الذمیر بخونه اونطوری شده بود خودش میگه توی قایقی با یه زنی تنها شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 615.7,
   "end": 619.02,
   "text": "و اختیار کرد چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 619.02,
   "end": 622.36,
   "text": "کف نفس رو. خدا هم نگهش داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 622.36,
   "end": 627.48,
   "text": "خدا به قلبش هی نازل کرد، هی نازل کرد تا جایی که از قبل و بعد خبر می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 627.48,
   "end": 633.08,
   "text": "کسی که با هوای نفسش مخالفت کرد قلبش می‌شه محل نزول حقایق از قبل و بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 633.08,
   "end": 634.96,
   "text": "هم قبل و می‌خواند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 634.96,
   "end": 637.38,
   "text": "هم ق-بعد رو می‌داند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 637.38,
   "end": 643.62,
   "text": "همه رو خدا بهش به نحو سعه قلبی که پیدا کرده بر اثر این طهارت نفس بهش می‌ده، می‌چشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 643.62,
   "end": 645.88,
   "text": "\"لا یمسّه الاّ المتحدون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 645.88,
   "end": 648.16,
   "text": "امتحان کنیم. زیاد هم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 648.16,
   "end": 650.6,
   "text": "من می‌گم همیشه به رفقا می‌گم زیاد هم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 650.6,
   "end": 652.28,
   "text": "یه arbaeen بگیر. نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 652.28,
   "end": 655.22,
   "text": "نمی‌خواد همه عمر. به شما هم می‌گم به خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 655.22,
   "end": 657.48,
   "text": "نمی‌خواد همه عمر. اصلاً کی گفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 657.48,
   "end": 660.3,
   "text": "نمی‌خواد. یه arbaeen خلوص تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.3,
   "end": 664.78,
   "text": "بعد تموم می‌شه. اصلاً دیگه همون یه arbaeen برکتش تا آخر عمرت می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 664.78,
   "end": 669.02,
   "text": "تو اون شرح رسائل عرفانی یا سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 669.02,
   "end": 671.72,
   "text": "رساله سیر و سلوک سید بحر العلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 671.72,
   "end": 677.5,
   "text": "حالا اونایی که مباحث رو تو در کانال مرام گمنامی پیگیرن، اونجا گروه جمعه این بحث رو داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 677.5,
   "end": 679.88,
   "text": "رسیدیم به بحث عدد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 679.88,
   "end": 682.6,
   "text": "برکت عدد چهل. خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 682.6,
   "end": 685.7,
   "text": "بسم الله شروع کنیم یه چهل ببین چی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 685.7,
   "end": 689.82,
   "text": "اصلاً غوغا از این زمین تا آسمون عوض می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 689.82,
   "end": 692.36,
   "text": "اراده کنی چهل روز خودتو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 692.36,
   "end": 697.96,
   "text": "اصلاً منافذ قلب باز می‌شه از قبل-- اصلاً همه آیات قرآنی که تا امروز می‌خوندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 697.96,
   "end": 699.56,
   "text": "شاید درکت خیلی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 699.56,
   "end": 703.2,
   "text": "دوباره شروع کن به خوندن. چنان درک جدیدی داری، چنان...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 703.2,
   "end": 705.06,
   "text": "حقایق می‌ریزه تو قلبت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 705.06,
   "end": 710.48,
   "text": "خلاصه اینطوری. اگر قلب با زبان همراهی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 710.48,
   "end": 712.42,
   "text": "در مسیر حق، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 712.42,
   "end": 718.34,
   "text": "بهترین‌هاست. اما اگر این دو از هم جدا شدن خطرناک‌ترین‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 718.34,
   "end": 720.98,
   "text": "حالا برای اینکه این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 720.98,
   "end": 723.86,
   "text": "رسمی‌ترش کنم به قول امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 723.86,
   "end": 728.84,
   "text": "یاد فرمایش لقمان حکیم افتادم و خیلی عظمت داشت که قرآن ازش یاد می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 728.84,
   "end": 735.46,
   "text": "اینو بگم و دیگه بسه امروز. که ایشون می‌دونین در زمان حضرت داوود سلام الله عليه بوده حضرت لقمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 735.46,
   "end": 737.2,
   "text": "بعد غلام هم بود اون اوایل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 737.2,
   "end": 740.04,
   "text": "غما-غلام یکی از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 740.04,
   "end": 742.52,
   "text": "مثلاً چیز بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 742.52,
   "end": 744.56,
   "text": "آدمایی که غلام زیاد داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 744.56,
   "end": 749.4,
   "text": "همین یه دونه هم نداشت در زمان بنی اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 749.4,
   "end": 752.54,
   "text": "بهش خب دیگه حرکات خیلی جالبی از لقمان می‌دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 752.54,
   "end": 755.9,
   "text": "بهش گفت برو یه گوسفند ذبح کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 755.9,
   "end": 758.66,
   "text": "بهترین اجزای گوسفندو وردار بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 758.66,
   "end": 762.36,
   "text": "لقمان رفت ذبح کرد دل و زبونشو برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 762.36,
   "end": 765.54,
   "text": "قل-- مولای خودش برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 765.54,
   "end": 769.8,
   "text": "برای مالک خودش برد. فردا دوباره گفت یه گوسفند دیگه ذبح کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 769.8,
   "end": 771.46,
   "text": "بدترین اجزاشو بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 771.46,
   "end": 775.76,
   "text": "دوباره اون لقمان همین قلب و زبان رو براش برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 775.76,
   "end": 778.22,
   "text": "دوباره روز سوم گفت برو یه بار دیگه بر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 778.22,
   "end": 783.68,
   "text": "بهترینو وردار بیار ببینم. موند چرا این، این کارو می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 783.68,
   "end": 785.62,
   "text": "نکنه مشاعرش عیب پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 785.62,
   "end": 787.92,
   "text": "دوباره این کارو بکن این دفعه بهترین‌ها رو دوباره بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 787.92,
   "end": 791.42,
   "text": "دوباره ذبح کرد. دوباره قلب و زبان رو لقمان برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 791.42,
   "end": 794.58,
   "text": "گفت چه می‌کنی تو؟ چی کار داری می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 794.58,
   "end": 801.16,
   "text": "گفت این، این سر رو فاش کرد و اونجا بود که مالکش و مولای لقمان، لقمان رو آزاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 801.16,
   "end": 804.94,
   "text": "اینجا بود. این هوش و ذکاوتو ازش دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 804.94,
   "end": 810.8,
   "text": "گفت به مولای خودش گفت اگر این دو با هم باشن بهترین چیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 810.8,
   "end": 814.42,
   "text": "اما اگر جداشون کنی بدترین چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 814.42,
   "end": 816.54,
   "text": "ان شا الله که عاقبت ما ختم به خیر باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 816.54,
   "end": 819.28,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 819.28,
   "end": 824.92,
   "text": "الله- اللهumma صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}