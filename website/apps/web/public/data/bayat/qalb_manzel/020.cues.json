  {
   "index": 5,
   "title": "## مادر؛ کشتزار پرورش؛ قلب و رزق",
   "start": 552.44,
   "end": 837.7
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.6,
   "end": 13.44,
   "text": "سلام. بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 13.44,
   "end": 18.44,
   "text": "و به نستعین. السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 18.44,
   "end": 20.9,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.9,
   "end": 24.4,
   "text": "ما ظهر عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.4,
   "end": 28.62,
   "text": "قلب مقام یعنی به یک عبارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.62,
   "end": 31.2,
   "text": "مقام برزخی که دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.2,
   "end": 36.92,
   "text": "گاهی رو به حالا عالم شهود دارد گاهی رو به عالم غیب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.92,
   "end": 39.06,
   "text": "محل تعلقات انسان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.06,
   "end": 44.6,
   "text": "محل القه‌ها، علاقه‌ها، دلبستگی‌ها و همچنین نفرت‌ها دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.6,
   "end": 46.56,
   "text": "یه همچین جایگاهی دارد. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.56,
   "end": 48.92,
   "text": "عرض کردیم مادر این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.92,
   "end": 52.48,
   "text": "مادر در نظام هستی جایگاهش جایگاه قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.48,
   "end": 56.02,
   "text": "جایگاه شفقت و مهر و محبت و پرورشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.02,
   "end": 59.0,
   "text": "عرض کردیم که نفس کل مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.0,
   "end": 62.9,
   "text": "و مرد جایگاه عقل دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.9,
   "end": 65.78,
   "text": "عقل هم که تدبیر و این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.78,
   "end": 71.16,
   "text": "بعد عرض کردیم که در کتاب فس الصمتی از تلامذة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.16,
   "end": 79.76,
   "text": "حضرت صدیقه طاهره سلام الله علیها رو ایشون می‌فرماید از این جهت پدرشون بهشون می‌گفتن ام ابیها که در سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.76,
   "end": 82.02,
   "text": "صعودی در نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.02,
   "end": 90.3,
   "text": "حضرت صدیقه طاهره سلام الله علیها رفتند و به مقام نفس کل رسیدند و چون مقام نفس کل، اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.3,
   "end": 93.48,
   "text": "سوالی که ایجاد شده اینو توجه نداشتن دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.48,
   "end": 96.48,
   "text": "چون در مقام نفس کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.48,
   "end": 102.9,
   "text": "همه عوالم مادون تحت پرورش نفس کلا من جمله خود پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.9,
   "end": 107.96,
   "text": "و حضرت زهرا سلام الله علیها رفته به اون مرتبه رسیده در قوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.96,
   "end": 112.44,
   "text": "صعود از این جهت بهشون گفتن ام ابیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.44,
   "end": 115.72,
   "text": "بعضی از عزیزان گفتن پس مقام حضرت زهرا بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.72,
   "end": 120.68,
   "text": "دقت به این نکردند که نفس کل، عقل کل، اون مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.68,
   "end": 124.18,
   "text": "رقه منشوره، اون پرده آویخته و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.18,
   "end": 127.88,
   "text": "عرض شود صادر اول و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.88,
   "end": 131.06,
   "text": "حالا بهش ام الاكوان می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.06,
   "end": 134.22,
   "text": "یا مثلاً ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.22,
   "end": 141.74,
   "text": "بهش می‌گن به یک معنا حالا بهتره بگیم همون رقه منشور که پرده‌ای که افتاده و نشر پیدا کرده، همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.74,
   "end": 145.98,
   "text": "کثرات، این کثرات نه فقط تو عالم نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.98,
   "end": 149.22,
   "text": "حتی عالم مثال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.22,
   "end": 154.86,
   "text": "عالم عقل و حتی عالم اله همه اینا منتقشن در او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.86,
   "end": 158.26,
   "text": "که اگر او نبود مثل یه پارچه‌ای رو در نظر بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.26,
   "end": 161.62,
   "text": "نقش‌هایی روش کشیده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.62,
   "end": 165.62,
   "text": "این نقش‌ها اگر اون تار و پود اون پارچه نبود کجا کشیده می‌شدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.62,
   "end": 170.6,
   "text": "اصلاً نیست و ما-ما-م-محو می‌شدن، نابود می‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.6,
   "end": 173.5,
   "text": "اون بوده، اون مقام نفس کل بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.5,
   "end": 179.4,
   "text": "اینو میخوام عرض کنم. مقام نفس کل، مقام عقل کل پیش از خلق بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.4,
   "end": 181.86,
   "text": "صادر اول که خلق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.86,
   "end": 185.74,
   "text": "اولین چیزیست که از خدا صادر شده، نه خلق شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.74,
   "end": 189.44,
   "text": "پیغمبر وجودش بعد از صادر اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.44,
   "end": 191.26,
   "text": "همه خلائق این چنین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.26,
   "end": 196.54,
   "text": "درست شد؟ این اشاره اینجا رو خیلی توجه نشده که این سؤال پیش اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.54,
   "end": 202.18,
   "text": "حضرت صدیقه طاهره سلام الله علیها که به مقام نفس کل رسیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.18,
   "end": 205.38,
   "text": "در این نشئه رسیده. نفس کل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.38,
   "end": 211.74,
   "text": "یعنی حضرت پیغمبر هم به یک معنا تحت پرورش اون نفس کل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.74,
   "end": 220.5,
   "text": "درست شد؟ اما چون حضرت زهرا سلام الله علیها در این نشئه طبیعت تو قوس صعود رفت به مقام نفس کل رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 220.5,
   "end": 224.78,
   "text": "به مقام نفس کل رسید، اتحاد وجودی برقرار شد بینشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.78,
   "end": 229.28,
   "text": "یعنی انگار که حضرت زهرا نه خود نفس کل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.28,
   "end": 233.2,
   "text": "نه اینکه رتبه پیغمبر مادون حضرت زهرا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.2,
   "end": 237.5,
   "text": "نه. چون حضرت زهرا رفت و تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.5,
   "end": 241.1,
   "text": "میشه اینو گفت رسید، اتحاد وجودی پیدا کرد با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.1,
   "end": 248.04,
   "text": "نفس کل از این جهت و چون نفس کل پرورش دهنده همه موجودات من جمله پیغمبر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.04,
   "end": 252.64,
   "text": "از این جهت بهش پیغمبر فرمود ام ابیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.64,
   "end": 256.56,
   "text": "امیرالمؤمنین هم همینطور به عقل کل رسید یا خود پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.56,
   "end": 261.12,
   "text": "اصلاً این رو خوب شاید با خود پیغمبر بهت-بهتر بشه به جواب رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 261.12,
   "end": 267.38,
   "text": "پیغمبر هم می‌فرماید وقتی می‌گن که حقیقت محمدیه همون صادر اول است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 267.38,
   "end": 270.44,
   "text": "نه یعنی اینکه پیغمبر از اول بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.44,
   "end": 277.94,
   "text": "نه یعنی اینکه پیغمبر چون رفته رسیده به مقام صادر اول، اون صادر اول پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.94,
   "end": 280.64,
   "text": "نه. صادر اول بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 280.64,
   "end": 287.74,
   "text": "و پیغمبر هم مقامش از جهت خلقی مادون صادر اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 287.74,
   "end": 294.72,
   "text": "اما توی قوس صعود یعنی در همین نشئه طبیعت که ما داریم زندگی می‌کنیم، ایشون چنان او عبادت کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 294.72,
   "end": 300.2,
   "text": "عبدیت ایشون به جایی رسید که اشهد ان محمدا عبده و رسوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 300.2,
   "end": 305.2,
   "text": "این عبادتش و عبدیتش بهتره بگیم به مقام رسالت رسوندش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 305.2,
   "end": 308.16,
   "text": "رفت چنان پرواز کرد، صعود کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 308.16,
   "end": 317.4,
   "text": "با مقام صادر اول مقامش برابری کرد و اتحاد وجودی برقرار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 317.4,
   "end": 320.2,
   "text": "از جهت رتبه‌ای حساب کنی از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 320.2,
   "end": 324.88,
   "text": "مثلاً تقدم تأخر بگیری بله، اول صادر اول بوده بعد پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 324.88,
   "end": 328.06,
   "text": "چون پیغمبر خلقه. صادر اول خلق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 328.06,
   "end": 330.94,
   "text": "اولین چیزیست که مثل nefsi که از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 330.94,
   "end": 333.34,
   "text": "صادر شده، إنشاء شده. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 333.34,
   "end": 335.6,
   "text": "خلق نیست یعنی حد نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 335.6,
   "end": 338.98,
   "text": "جنس نداره، نمی‌دونم وزن نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 338.98,
   "end": 342.42,
   "text": "ارتفاع و عرض و طول و این‌ها نداره صادر اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 342.42,
   "end": 344.02,
   "text": "خب؟ مثل نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 344.02,
   "end": 346.5,
   "text": "نفس من و شما میاد می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 346.5,
   "end": 348.56,
   "text": "به مخارج حروف، کلمات خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 348.56,
   "end": 351.12,
   "text": "این همه بی‌نهایت کلمات رو از خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.12,
   "end": 357.52,
   "text": "إنشاء می‌کنه. اون نفس اما پیغمبر در قوس صعود یعنی بعد از صادر اول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 357.52,
   "end": 361.38,
   "text": "بعد از صادر اول اومد توی همین نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.38,
   "end": 365.54,
   "text": "رفت به مثال و عقل و الهیت و همه رو عروج کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 365.54,
   "end": 368.98,
   "text": "یعنی به معراج رفت از همین جا، از همین نشئه خاکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.98,
   "end": 374.38,
   "text": "قشنگیش اینه پیغمبر اومد از این عالم زلمانی رفت همه حجاب‌های نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 374.38,
   "end": 379.04,
   "text": "و ظلمت و همه رو پاره کرد. رفت تا رسید به مقام صادر اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 379.04,
   "end": 383.28,
   "text": "چون رسید به مقام صادر اول فرمود أنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.28,
   "end": 389.8,
   "text": "مثلا من اون عقل اول‌ام یا اول ما خلق الله نوری، اول ما خلق الله العقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 389.8,
   "end": 392.76,
   "text": "بعد فرمود اون عقل اول منم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.76,
   "end": 395.24,
   "text": "یا بهش میگن حقیقت محمدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 395.24,
   "end": 399.78,
   "text": "به چی؟ به صادر اول. از این جهت فکر می‌کنم این گره باز شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 399.78,
   "end": 404.4,
   "text": "که نه یعنی اینکه حضرت زهرا سلام الله علیها مقامش بالاتر از پیغمبره، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 404.4,
   "end": 408.68,
   "text": "شبیه به اون حدیثی که می‌فرمود \"لولک لما خلقت الأفلاك\"،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 408.68,
   "end": 410.7,
   "text": "\"لولا فاطمه لما خلق\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 410.7,
   "end": 415.28,
   "text": "یا \"لولا علی لما خلقتک\"، \"لولا فاطمه لما خلقتكما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 415.28,
   "end": 418.66,
   "text": "اگر هم-- اگه تو نبودی افلاک رو نمی‌آفریدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 418.66,
   "end": 420.7,
   "text": "اگر علی نبود تو رو نمی‌آفریدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 420.7,
   "end": 424.7,
   "text": "اگه فاطمه زهرا نبود علیهما صلوة الله هیچ‌کدوم از شما دو تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 424.7,
   "end": 427.46,
   "text": "یعنی حضرت زهرا بالاتر از پیغمبر و امیرالمؤمنینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 427.46,
   "end": 430.34,
   "text": "نه. یعنی اینکه این رتبه‌ها این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 430.34,
   "end": 434.58,
   "text": "عالم ملکوت که ما فوق عالم ملکه به دست حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 434.58,
   "end": 437.24,
   "text": "عالم جبروت که ما فوق عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 437.24,
   "end": 439.56,
   "text": "ملکوته به دست امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 439.56,
   "end": 441.84,
   "text": "یعنی سلطان اونجا امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 441.84,
   "end": 447.06,
   "text": "عالم لاهوت که ما فوق جبروته و مادون صادر اوله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 447.06,
   "end": 449.68,
   "text": "اونجا سلطان پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 449.68,
   "end": 452.56,
   "text": "اگر پیغمبر می‌خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 452.56,
   "end": 459.5,
   "text": "اون نور اصلی و عظمت وجودی ایشون که به مقام صادر اول رسیده تجلی کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 459.5,
   "end": 463.26,
   "text": "عالم جبروت که یه رتبه پایین‌تر بود گنجایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 463.26,
   "end": 466.6,
   "text": "اخذ اون نور رو نداشت. انقدر اون نور عظمت داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 466.6,
   "end": 470.52,
   "text": "یک آینه‌ای نیاز بود که نور پیغمبر رو از عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 470.52,
   "end": 474.38,
   "text": "لاهوت انعکاس بده به مادون، به رتبه پایین‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 474.38,
   "end": 477.82,
   "text": "یعنی عالم جبروت که سلسله خلقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 477.82,
   "end": 483.98,
   "text": "ادامه پیدا کنه. همچنین امیرالمؤمنین نورش در عالم جبروت به حدری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 483.98,
   "end": 487.1,
   "text": "ج-جلوه داشت، عظمت داشت، شکوه داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 487.1,
   "end": 489.6,
   "text": "عالم ملکوت گنجایش اینو نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 489.6,
   "end": 491.22,
   "text": "اصلاً عالم یه رتبه پایین‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.22,
   "end": 493.44,
   "text": "حالا علی الاسم هر اسمی می‌خوای بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.44,
   "end": 497.66,
   "text": "گنجایش اینو نداشت که نور امیرالمؤمنین رو به یک باره بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 497.66,
   "end": 500.32,
   "text": "و اصلاً خلق ادامه پیدا نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 500.32,
   "end": 503.12,
   "text": "این انعکاس، این نزول اصلاً دیگه وجود نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 503.12,
   "end": 506.46,
   "text": "ق-- انا لله. مگه کلهم نورا واحد نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 506.46,
   "end": 508.68,
   "text": "ثابت و طهرت بعضها من بعض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 508.68,
   "end": 511.18,
   "text": "مقام نداریم که. همشون جود یه دونه‌ند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 511.18,
   "end": 513.3,
   "text": "بله هم-همه‌شون یک حقیقتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 513.3,
   "end": 516.46,
   "text": "اما اول پیغمبر رفته به این رتبه رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 516.46,
   "end": 520.56,
   "text": "اینو توجه- ما جود یک بدن رو می‌بینید مثل این که چشم رسیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 520.56,
   "end": 523.74,
   "text": "مغز رسیده، چشم مثلا جود همون بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.74,
   "end": 526.04,
   "text": "پس همه‌شون اگر آقا رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 526.04,
   "end": 528.96,
   "text": "به نورشون خلق نمی‌شد عالم خلق نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 528.96,
   "end": 531.86,
   "text": "اگر حضرت زهرا سلام الله خلق نمی‌شد، خلق نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 531.86,
   "end": 536.14,
   "text": "خب. برای همین قیاس، قیاس تو اسلام اصلاً چه عیبی-- رتبه بندی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 536.14,
   "end": 539.74,
   "text": "نه چرا نداریم. اول کی رفته به اون مقام رسیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 539.74,
   "end": 543.28,
   "text": "آقا رسول الله، آقا امیرالمؤمنین علیه السلام، آقا رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.28,
   "end": 547.68,
   "text": "نه، نه. ببینید این، این مثالی که زدم رو درست توجه نکردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.68,
   "end": 549.52,
   "text": "اول کی به اون مقام رسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 549.52,
   "end": 552.44,
   "text": "پیغمبر. همه‌شون یکین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 552.44,
   "end": 556.26,
   "text": "نه ببینید- اگه همه‌شون رو یکی بگیریم اول- از، نه از حیث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 556.26,
   "end": 562.5,
   "text": "نه از این حیث یکین که همه‌شون به اون مقام صادر اول یا انسان کامل رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 562.5,
   "end": 565.42,
   "text": "و الا پیغمبر همون علیه از حیث خلقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 565.42,
   "end": 568.56,
   "text": "نه. ایشون یه حد داره، ایشون یه حد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 568.56,
   "end": 570.16,
   "text": "اصلاً دو- جسمانی‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 570.16,
   "end": 576.48,
   "text": "خب دیگه. از جهت نورانی می‌خوای بگی بله از جهت نورانی کلهم نور واحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 576.48,
   "end": 580.18,
   "text": "چرا نور واحد؟ چون همه‌شون رفتن به اون مقام رسیدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 580.18,
   "end": 587.28,
   "text": "که اگر یک دیگه‌ای هم پیدا می‌شد مثلا حضرت علی هم می‌تونست در قوس صعود بری به مقام صادر اول برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 587.28,
   "end": 591.5,
   "text": "شما، شما هم می‌شدی با اون‌ها اتحاد وجودی برقرار می‌کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.5,
   "end": 595.1,
   "text": "شما هم با ا-اضافه اون‌ها می‌شدی کلهم نور واحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.1,
   "end": 598.4,
   "text": "این ثابت و طهارة بعضها من بعض رو باید توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 598.4,
   "end": 601.84,
   "text": "بعضها من بعض. یعنی ترتیب وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 601.84,
   "end": 603.8,
   "text": "بعضها من بعض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 603.8,
   "end": 609.78,
   "text": "بعضی از بعضی دیگه. یعنی امام حسن رفت به اون رتبه رسید اما بچه ام-امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 609.78,
   "end": 612.34,
   "text": "یعنی رتبه وجودی رو باید در نظر گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.34,
   "end": 615.26,
   "text": "اون که اول رفت بقیه به تبعش رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 615.26,
   "end": 620.78,
   "text": "یعنی امیرالمؤمنین به، به تبع از پیغمبر رفت به اون مقام رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 620.78,
   "end": 624.46,
   "text": "نه که بالعصاله. به تبع رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 624.46,
   "end": 627.7,
   "text": "اون که بع-بالعصاله رفت پیغمبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 627.7,
   "end": 633.84,
   "text": "بقیه عالم از خود امیرالمؤمنین بگیر تا حضرت بقیةالله همه به دنبال پیغمبرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 633.84,
   "end": 641.76,
   "text": "منتهی از اینایی که دنبال پیغمبر حرکت کردن رفتن تو قوس صعود چهارده، سیزده تا تونستن به اون مقام برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 641.76,
   "end": 646.08,
   "text": "بقیه نتونستن. حتی انبیا به اون مقام کل نتونستن برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.08,
   "end": 650.58,
   "text": "از این جهت همه‌شون کلهم نور واحد، اون چهارده تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 650.58,
   "end": 655.38,
   "text": "که تونستن اون سیزده تا هم بعد از پیغمبر اینو توجه بکنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 655.38,
   "end": 658.92,
   "text": "بعد از پیغمبر به تبع پیغمبر برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 658.92,
   "end": 661.9,
   "text": "یعنی امیرالمؤمنین هم به تبع پیغمبر رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 661.9,
   "end": 664.36,
   "text": "نه ذاتاً، نه بالعصاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 664.36,
   "end": 666.84,
   "text": "حضرت زهرا به تبع پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.84,
   "end": 672.88,
   "text": "برای همینه حضرت علامه میگه یعنی چی اومدید کتاب نوشتید فاطمه فاطمه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 672.88,
   "end": 675.52,
   "text": "نگید فاطمه بنت رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 675.52,
   "end": 678.48,
   "text": "اتفاقا علامه حسن زاده میگه خط بزنید رو این جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 678.48,
   "end": 681.54,
   "text": "این جمله غلطه. دکتر شریعتی این کتاب رو نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 681.54,
   "end": 685.02,
   "text": "میگه اتفاقاً بگید یابن-- یا بنت رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 685.02,
   "end": 695.92,
   "text": "ای دختر رسول خدا از این جهت که در صلب همچین کسی بوده طهارت لازم رو داشت که بره به اون قوس برسه که کنتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 695.92,
   "end": 700.2,
   "text": "فی الاسلاب الشامخه والارحام المطهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 700.2,
   "end": 702.6,
   "text": "برای همین پدر مادر خیلی مهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 702.6,
   "end": 709.5,
   "text": "حرف اولو دارن می‌زنن. همونطور که ما تو این بحث سیر بحثمون تو قلب داریم میگیم قلب حرف اولو تو وجود میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 709.5,
   "end": 712.02,
   "text": "مادر حرف اول رو میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 712.02,
   "end": 717.32,
   "text": "نساءکم حرف لكم. قرآن میگه همسران شما، زنان شما نساءکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 717.32,
   "end": 719.74,
   "text": "حرف لكم زمین کشتزار شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 719.74,
   "end": 722.58,
   "text": "م-مرد مقام ده‌ش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 722.58,
   "end": 724.76,
   "text": "دانه رو میکاره. والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 724.76,
   "end": 727.92,
   "text": "برای همین گفتن الولد سر ابي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 727.92,
   "end": 730.8,
   "text": "بچه سر پدرشه. یعنی دانه رو پدر کاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 730.8,
   "end": 733.92,
   "text": "درست. هرچی اگه پوکه بچه هم پوکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 733.92,
   "end": 736.96,
   "text": "نمی‌دونم درست حسابیه بچه هم درست حسابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 736.96,
   "end": 740.6,
   "text": "اما همون دانه رو کی پرورش میده به مقام می‌رسونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 740.6,
   "end": 742.98,
   "text": "زمین. درست شد؟ اون زمین کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 742.98,
   "end": 745.62,
   "text": "قرآن میگه نساءکم حرف لكم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 745.62,
   "end": 749.68,
   "text": "یعنی مقام پرورش با مادره، با زنه، مقام قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 749.68,
   "end": 751.84,
   "text": "اصلاً رزقش رو قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 751.84,
   "end": 755.96,
   "text": "قلب مقامی داره که رزق رو از الله می‌گیره چون مرتبت الهیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 755.96,
   "end": 759.16,
   "text": "وجود ماست. رزق رو از الله می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 759.16,
   "end": 764.82,
   "text": "در کانال وجودی هر جزئی از اجزاء موجودات جاری می‌کنه که اون کاناله می‌شه رب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 764.82,
   "end": 767.44,
   "text": "این سلسله طولی رو باید در نظر گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 767.44,
   "end": 770.22,
   "text": "حالا بعداً دوست داشتید حالا بعد از جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 770.22,
   "end": 773.44,
   "text": "مفصل با هم بحث می‌کنیم. ولی الان اینو بدونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 773.44,
   "end": 779.48,
   "text": "که اول کسی که رفت به قو-- در قوس صعود به اون مقام و مرتبت رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 779.48,
   "end": 782.9,
   "text": "پیغمبر رسید. امیرالمؤمنین هم رفت رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 782.9,
   "end": 784.54,
   "text": "حضرت زهرا هم رفت رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 784.54,
   "end": 787.94,
   "text": "امام حسن هم همینطور تا حضرت بقیةالله فقط این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 787.94,
   "end": 791.48,
   "text": "سیزده تا بعد از پیغمبر رفتن رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 791.48,
   "end": 794.12,
   "text": "اما به تبع پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 794.12,
   "end": 797.08,
   "text": "یعنی اونام شیعه پیغمبر حساب می‌شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 797.08,
   "end": 804.18,
   "text": "و همه این‌ها رفتن چون به اون رتبه انسان کامل که مقام صادر اول هست رسیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 804.18,
   "end": 807.06,
   "text": "گفتن ما همونیم. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 807.06,
   "end": 812.66,
   "text": "پس حضرت زهرا سلام الله علیها هم رتبه خ-- ایشون مادون پیغمبر بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 812.66,
   "end": 816.54,
   "text": "اما از حیث اینکه رفت به اون مقام نفس کل رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 816.54,
   "end": 822.64,
   "text": "چون اون نفس کل پیغمبر رو پرورش داده، همه موجودات رو پرورش داده بهش میگه ام ابيها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 822.64,
   "end": 824.78,
   "text": "این چیزیه که حضرت علامه در کتاب آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 824.78,
   "end": 828.0,
   "text": "حالا اگه سوالی باز باقی موند ان شا الله با هم بحث می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 828.0,
   "end": 832.76,
   "text": "ان شا الله که عاقبت good خیر باشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 832.76,
   "end": 837.7,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}