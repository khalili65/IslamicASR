  },
  {
   "index": 1,
   "title": "## حکایت آیت‌الله لواسانی و امام جمعهٔ مدینه",
   "start": 78.48,
   "end": 101.04
  },
  {
   "index": 2,
   "title": "## قلب نبض جان و محل نزول رزق",
   "start": 101.04,
   "end": 174.92
  },
  {
   "index": 3,
   "title": "## تلقین شهادتین و علم به عنوان حجاب اکبر",
   "start": 174.92,
   "end": 510.06
  },
  {
   "index": 4,
   "title": "## نگین قلب بر فص شعیبی در ممد الهمم",
   "start": 510.06,
   "end": 625.0
  },
  {
   "index": 5,
   "title": "## عوالم خمس و برزخیت قلب",
   "start": 625.0,
   "end": 843.78
  },
  {
   "index": 6,
   "title": "## مناجات نور: ظاهر، باطن، قلب، روح، سر",
   "start": 843.78,
   "end": 1081.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.1,
   "end": 6.18,
   "text": "السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.18,
   "end": 9.64,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.64,
   "end": 17.6,
   "text": "کسی که قرائتش درست نیست و مخارج حروف رو نمی‌تونه درست پیاده کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.6,
   "end": 22.72,
   "text": "و البته خب زحمتش رو کشیده حتی کارشم انجام داده مثلا رفته کلاس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.72,
   "end": 28.18,
   "text": "هم دیده مطالعه‌اش کرده در خصوص مخارج حروف و نحوه قرائت و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.18,
   "end": 31.26,
   "text": "اما نمی‌تونه، نمی‌تونه درست ادا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.26,
   "end": 36.18,
   "text": "زیاد هم هستن اینا یه سری اصلا می‌دونی شصت سال، هفتاد سال داره نماز می‌خونه اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.18,
   "end": 46.56,
   "text": "قرائتش درست نیست. رهبر عزیزمون فرمودن این برای خودش نمازش درسته باطل نیست نمازش اما نمی‌تونه امام جماعت بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 46.56,
   "end": 48.9,
   "text": "و کسی نمی‌تونه به او اقتدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.9,
   "end": 55.16,
   "text": "اصلا یکی از احکام امام جماعت اینه که قرائتش صحیح باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 55.16,
   "end": 60.26,
   "text": "و مخارج رو رعایت کنه که اگر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 60.26,
   "end": 65.26,
   "text": "ببینید امام جماعتتون حتی، حتی آیت الله العظما هم که باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 65.26,
   "end": 68.1,
   "text": "ببینید نه-- قرائتش اشتباه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.1,
   "end": 71.44,
   "text": "حق اقتدا به او رو ندارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.44,
   "end": 74.82,
   "text": "ولو عالم دهر باشه عارف دهر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.82,
   "end": 78.48,
   "text": "اینا دیگه فقه باید رعایت شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.48,
   "end": 82.46,
   "text": "اجازه بفرمایید که با یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.46,
   "end": 84.72,
   "text": "حکایت خیلی عجیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.72,
   "end": 88.84,
   "text": "شروع کنم مبحث قلب منزل امروز را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.84,
   "end": 92.2,
   "text": "اینو اگر هم کسی جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.2,
   "end": 96.86,
   "text": "جان؟ لفظه دومش تلفظ در، در خودش- با، نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.86,
   "end": 101.04,
   "text": "برا خودش نمازش درسته اما نمی‌شه بهش اقتدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.04,
   "end": 106.34,
   "text": "این چیزی که می‌خوام عرض کنم و عزیزانی هم که عجله دارن و کار دارن و نمی‌تونن بشینن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.34,
   "end": 109.8,
   "text": "بشنون و اینا اینو بشنون و برن اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.8,
   "end": 114.58,
   "text": "یعنی خیلی دو دقیقه است اینو گوش بدن بعد حالا تفصیلش رو برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.58,
   "end": 118.42,
   "text": "که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.42,
   "end": 120.3,
   "text": "آیت الله لواسانی فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.3,
   "end": 124.8,
   "text": "ایشون یه مدتی می‌دونین نمایندگی ولی فقیه بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.8,
   "end": 131.88,
   "text": "در مدینه. ایشون رفتن در حج اعقاف رفت خودشون می‌فرمودن که رفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.88,
   "end": 137.76,
   "text": "دیدن امام جمعه مدینه که اهل تسنن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.76,
   "end": 141.88,
   "text": "در روز ماه مبارک رمضان در ظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.88,
   "end": 144.36,
   "text": "رفتم منزل ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.36,
   "end": 149.66,
   "text": "و خب مخصوصا نماز جمعه‌های اهل تسنن و اینا رو اونجا ایشون اقامه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.66,
   "end": 153.16,
   "text": "همین آقا که امام جماعت اونا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.16,
   "end": 155.3,
   "text": "رفتم دیدم داره غذا می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.3,
   "end": 157.98,
   "text": "کی؟ ظهر ماه رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.98,
   "end": 161.34,
   "text": "تعجب کردم. به ایشون گفتم که شما کسالتی دارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.34,
   "end": 164.56,
   "text": "مریضی چیزی دارید که روزه براتون حلاله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.56,
   "end": 167.26,
   "text": "گفت نه مشکلی ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.26,
   "end": 172.08,
   "text": "الحمد لله سالمم. گفتم خب مسافر هم که نیستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.08,
   "end": 177.0,
   "text": "دیگه من نمی‌دونم شما چرا داری روزه می‌خوری از این طرف هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.0,
   "end": 183.42,
   "text": "امام جماعتی و ارشد امام جمعه‌ای، امام جماعتی، امام جمعه شهر مدینه هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.42,
   "end": 188.04,
   "text": "چگونه که داری نماز می‌خونی، روزه، روزه تو می‌خوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.04,
   "end": 191.88,
   "text": "بعد یه جمله عجیبی گفت ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.88,
   "end": 194.24,
   "text": "این حالا نقلی که می‌کنم به نقل از کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.24,
   "end": 197.68,
   "text": "حضرت آیت الله لواسانی. نمایندگی ولی فقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.68,
   "end": 199.3,
   "text": "فرمودن یه جمله معناداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.3,
   "end": 206.04,
   "text": "ایشون گفتش که \"من از جهت علمی برام ثابت شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.04,
   "end": 211.64,
   "text": "که کسی که ولایت علی ابن ابی طالب رو نپذیرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.64,
   "end": 216.94,
   "text": "اعمالش قبول نیست. نه نمازش، نه روزه‌اش، هیچ‌کدوم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.94,
   "end": 222.16,
   "text": "میگه من تعجب کردم. گفتم خب شما که از جهت علمی این برات ثابت شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.16,
   "end": 228.6,
   "text": "چرا قبول نمی‌کنی؟ خب شهادتین رو بر لسانت جاری کن تمومش کن بره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.6,
   "end": 231.12,
   "text": "تو که مگه نمیگی برات علمی ثابت شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.12,
   "end": 233.96,
   "text": "عالمی دیگه. تحقیق کردی رسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.96,
   "end": 235.9,
   "text": "یه تعملی کرد. یه جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.9,
   "end": 242.02,
   "text": "پرمعناتری از اون گفت که جواب بسیاری از سوالات و شبهات جوونای امروزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.02,
   "end": 244.98,
   "text": "ایشون تأمل کرد گفت می‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.98,
   "end": 248.42,
   "text": "اقرار کنم نمی‌تونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.42,
   "end": 252.64,
   "text": "نمی‌تونم یعنی قلبم نمی‌گذاره قلبم، درونم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.64,
   "end": 259.22,
   "text": "داخلم از جهت علمی یعنی عقل هم به اینجا رسیده کار فکری انجام دادم به اینجا رسیده که بله اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.22,
   "end": 263.04,
   "text": "ولی قلبم نمی‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.04,
   "end": 265.24,
   "text": "یه چیزی از درونم مانعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.24,
   "end": 269.52,
   "text": "دلم نمی‌ذاره. دلم راه نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.52,
   "end": 273.82,
   "text": "اینه که این بحث قلب رو که ما دست گرفتیم اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.82,
   "end": 278.58,
   "text": "نبض جان ماست. اصلا اصل و اساس وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.58,
   "end": 282.2,
   "text": "اینو نباید کم بگیریم. حالا الان رسیدیم به بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.2,
   "end": 285.66,
   "text": "منزل، منزلگاه یعنی محل نزول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.66,
   "end": 289.42,
   "text": "عرض کردیم هرچه فیض، هرچه رزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 289.42,
   "end": 296.94,
   "text": "حتی در سیر وجودی ما اشتداد وجودی بخواهیم پیدا کنیم، وجود رو وجود بیاد، هی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 296.94,
   "end": 302.94,
   "text": "ارتقاء درجات پیدا کنیم، مقام می‌خوای، درجه می‌خوای، رتبه می‌خوای، هرچی می‌خوای نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.94,
   "end": 305.24,
   "text": "همش اینا همه رزق الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 305.24,
   "end": 310.2,
   "text": "علم می‌خوای؟ همش برگشت می‌کنه به نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.2,
   "end": 313.44,
   "text": "نور هم که عین حضرت حق است، عین وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.44,
   "end": 316.24,
   "text": "اینا بر قلب نازل میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.24,
   "end": 320.26,
   "text": "نه جای دیگه. یعنی جای دیگه نباید دنبالش گشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.26,
   "end": 324.02,
   "text": "اگر گیر و گوری توی این مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 324.02,
   "end": 333.8,
   "text": "حالا ربط بین اعتقادات یا به عبارتی دانسته‌های ما، علم فکری ما در عمل وجود داره، همش کار قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 333.8,
   "end": 337.34,
   "text": "آقا کتاب خونده، آقا شما نمی‌دونی دروغ گناه کبیره است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 337.34,
   "end": 341.94,
   "text": "بله می‌دونم. از من عالم‌تری خب چرا دروغ میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.94,
   "end": 346.86,
   "text": "نمی‌دونی اگر کسی آبروی مؤمن رو ببرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 346.86,
   "end": 348.92,
   "text": "به جنگ با خدا بلند شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 348.92,
   "end": 350.72,
   "text": "چرا؟ اینم کتاب‌ها رو خوندم می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 350.72,
   "end": 353.18,
   "text": "پس چرا میگی؟ چرا این کارو می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 353.18,
   "end": 358.68,
   "text": "چرا به همین راحتی تو فضای مجازی آبرو می‌ریزی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 358.68,
   "end": 362.2,
   "text": "چرا؟ دلیلشو خودشم نمی‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.2,
   "end": 365.28,
   "text": "اما من دارم به شما میگم دلیلش قلبشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 365.28,
   "end": 369.08,
   "text": "قلبش در یک حجابی قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 369.08,
   "end": 372.5,
   "text": "دیگه نزول درش در این قلب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.5,
   "end": 376.92,
   "text": "رزق میاد. فیضان حضرت حق اون فیض علی الاسلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.92,
   "end": 381.7,
   "text": "علی الدوام لا یزال و ازلاً و ابداً در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.7,
   "end": 383.36,
   "text": "ریزش به سر این آقا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.36,
   "end": 390.14,
   "text": "همین طوری داره میاد اما این قلبش محجای یک حجابی قرار گرفته پس می‌زنه رزقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 390.14,
   "end": 395.8,
   "text": "یعنی اون چیزی که می‌داند را به قول علامه حسن زاده رحمت الله علیه ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 395.8,
   "end": 399.9,
   "text": "می‌داند اما دارا نشده یعنی نچشیده یعنی نفهمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 399.9,
   "end": 402.42,
   "text": "یعنی قلبش این رو باور نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 402.42,
   "end": 404.62,
   "text": "این حوزه قلب خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 404.62,
   "end": 408.3,
   "text": "اصلاً ربطی به کتاب و درس و بحث و اینا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.3,
   "end": 409.66,
   "text": "لذا یه وقت می‌بینی یه آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 409.66,
   "end": 416.3,
   "text": "خیلی معمولی، یه کاسب جزو، یه پیرمرد که ما براش احترام هم شاید قائل نشیم، یه پیرزن و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 416.3,
   "end": 419.68,
   "text": "اینا یه وقت می‌بینی از یه آیت الله العظما اتفاقاً بهتر می‌فهمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.68,
   "end": 424.12,
   "text": "یعنی ده-- اون باورشون بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 424.12,
   "end": 427.88,
   "text": "توجه کردید اینا که حضرت امام علیه الرحمه فرمود: \"رفتم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 427.88,
   "end": 434.36,
   "text": "چند بار اینو براتون عرض کردم. خودم از امام شنیدم از صوت ایشون که پخش میشد تو رادیو معارف بود یا قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.36,
   "end": 436.4,
   "text": "فرمود: \"رفتم بالا سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.4,
   "end": 444.34,
   "text": "یکی از علما که چقدر درس و بحث و شاگرد و مجتهد و این و چی و اینا رفتم شهادتین رو تغییر بدم نگفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 444.34,
   "end": 447.98,
   "text": "شهادتین رو نگفت و به خدا جسارت کرد و مرد.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 447.98,
   "end": 451.86,
   "text": "امام، حضرت امام، بزرگ همه امام میگه من اونجا تنم لرزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 451.86,
   "end": 454.7,
   "text": "اصلاً این درس و بحث‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 454.7,
   "end": 457.6,
   "text": "باید باشه نه که انکار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 457.6,
   "end": 461.78,
   "text": "به قول حضرت امام درسته العلم هو الحجاب الاکبر اما چاره‌ای ازش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 461.78,
   "end": 463.84,
   "text": "باید رفت. علت مؤدّه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 463.84,
   "end": 468.72,
   "text": "شخم می‌زنه زمین وجودت رو کمکت می‌کنه که راهی به دریچه قلبت باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 468.72,
   "end": 471.46,
   "text": "بدون اینم نمی‌شه. باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 471.46,
   "end": 475.94,
   "text": "حالا اینکه نباید نادون و جاهل باشه راحت شبهات رو قبول کنه و سر بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 475.94,
   "end": 480.64,
   "text": "اما این اصل نیست. اصل کشف قلبیه، شهود قلبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 480.64,
   "end": 482.68,
   "text": "قلب اینقدر جایگاهش مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.68,
   "end": 486.96,
   "text": "اون درک، اون باران فیضان حضرت حق بر قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 486.96,
   "end": 491.34,
   "text": "اخذ اون مهمه. حالا این بابا قلبش راه نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.34,
   "end": 492.96,
   "text": "چرا؟ حالا باید رفت بررسی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 492.96,
   "end": 499.56,
   "text": "من نمی‌دونم طرف مثلاً می‌بینه یه گناه‌هایی، مص ibت‌هایی، چیزایی تو نطفشه، تو پدر مادر و اجدادشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.56,
   "end": 502.76,
   "text": "اصلاً اون حرامخوری، چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 502.76,
   "end": 504.8,
   "text": "اصرار بر گناهان یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.8,
   "end": 507.56,
   "text": "خدایی نکرده حرامزادگی چه چه اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 507.56,
   "end": 509.86,
   "text": "باعث می‌شه که سد راه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.86,
   "end": 512.1,
   "text": "حالا اجازه بفرمایید که تا اینجا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.1,
   "end": 516.76,
   "text": "خطابی یه مقدار حرف زدیم اقناعی مثلاً منبری چه می‌دونم امروزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 516.76,
   "end": 519.0,
   "text": "داستان و حکایت و چه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 519.0,
   "end": 521.24,
   "text": "ولی پایه‌اش پایه علمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 521.24,
   "end": 523.86,
   "text": "اجازه بدید برای اینکه اینو قشنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.86,
   "end": 529.88,
   "text": "ااا درک علمی هم بکنیم از روی کتاب ممد الهمم حضرت علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 529.88,
   "end": 535.32,
   "text": "که شرحی‌ست بر شرح قیصری بر فصوص الحکم ابن عربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 535.32,
   "end": 538.94,
   "text": "از فصل دوازدهم‌ش براتون از رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 538.94,
   "end": 542.68,
   "text": "اون عبارت اولش رو بخونم. خیلی شیرین، خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 542.68,
   "end": 544.9,
   "text": "با عظمت، خیلی قشنگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 544.9,
   "end": 547.9,
   "text": "محکم، وزین. فصل اسمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 547.9,
   "end": 551.76,
   "text": "قلبیة قلبیة قلب، قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 551.76,
   "end": 553.72,
   "text": "فی کلمة شعیبیة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 553.72,
   "end": 557.76,
   "text": "حالا اینجا خود علامه قیصری خیلی زیبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.76,
   "end": 561.7,
   "text": "می‌فرمایند که می‌دونید چرا محی الدین اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 561.7,
   "end": 564.68,
   "text": "اون گوهر و نگین، فصل یعنی نگین، نگین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 564.68,
   "end": 567.84,
   "text": "قلب رو اومده پیاده کرده رو حضرت شعیب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 567.84,
   "end": 571.5,
   "text": "به جهت اینکه قلب شع-شعب مختلف داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.5,
   "end": 574.38,
   "text": "انشعابات متعدد و مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 574.38,
   "end": 576.28,
   "text": "منقلبه دیگه. انقلاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 576.28,
   "end": 578.38,
   "text": "هی در تقلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 578.38,
   "end": 580.68,
   "text": "هی بالا پایین می‌شه. هی اینور اونور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 580.68,
   "end": 583.18,
   "text": "یه حالت ساکن نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.18,
   "end": 585.28,
   "text": "خب؟ و شعب متعدد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.28,
   "end": 588.48,
   "text": "حضرت شعیب هم کثیر الاولاد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 588.48,
   "end": 591.68,
   "text": "فرزندان بسیار، نتیجه‌های زیادی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 591.68,
   "end": 593.54,
   "text": "لذا اینجا پیاده کرده خیلی زیبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 593.54,
   "end": 605.02,
   "text": "حالا حضرت علامه قیصری می‌فرمایند قلب بر نفس ناطقه اطلاق می‌شود آنگاه که معانی کلیه و جزئیه را هرگاه بخواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 605.02,
   "end": 608.86,
   "text": "مشاهده می‌کند. قلبه که به مشاهده می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 608.86,
   "end": 611.94,
   "text": "چه معانی کلیه، چه معانی جزئیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 611.94,
   "end": 616.78,
   "text": "و این مرتبه نفس ناطقه در نزد حکما عقل مستفاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 616.78,
   "end": 619.38,
   "text": "یعنی عقل بالفعل هم برو بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 619.38,
   "end": 624.1,
   "text": "عقل مستفاد. قلب خیلی جایگاهش بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 624.1,
   "end": 626.72,
   "text": "که البته بعد ایشون ادامه میدن که و گاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 626.72,
   "end": 634.28,
   "text": "قلب بر نفس ناطقه کسی که متصف به اخلاق حمیده شد و آن اخلاق ملکه او گردید اطلاق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 634.28,
   "end": 638.06,
   "text": "یعنی کسی که متصف می‌شه به اخلاق حسنه و حمیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 638.06,
   "end": 640.62,
   "text": "قلبش به این جایگاه می‌رسه که حالا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 640.62,
   "end": 644.32,
   "text": "در حقیقت به اون اتصافش به اخلاق حمیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 644.32,
   "end": 649.78,
   "text": "بهش میگن به اون نفس ناطقه‌ش میگن قلب، مقام قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 649.78,
   "end": 654.06,
   "text": "ادامه رو دقت کنید. نفس ناطقه را قلب می‌نامند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 654.06,
   "end": 661.68,
   "text": "چرا قلب می‌نامند؟ چون بین عالم عقلی محض و عالم نفس منتبه منقلب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 661.68,
   "end": 667.78,
   "text": "و در وجوه پنج‌گانه‌ای که نفس به سوی عوالم کلیه خمس دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 667.78,
   "end": 672.1,
   "text": "متقلب است. حالا این عوالم خمس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 672.1,
   "end": 678.76,
   "text": "که این نفس ناطقه یا به عبارتی اینجا بحث می‌کنیم قلب انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 678.76,
   "end": 681.4,
   "text": "بینش هی تردید دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 681.4,
   "end": 687.34,
   "text": "اولیش همون معانی یا عالم معانی یا اعیان ثابته در اون صورت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 687.34,
   "end": 693.0,
   "text": "صور علمیه یا ماهیات در ثقل ذات حضرت حقه که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 693.0,
   "end": 697.58,
   "text": "دومیش عالم ارواحه یا بهش عالم امر هم میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 697.58,
   "end": 700.24,
   "text": "سومیش عالم مثال همین برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 700.24,
   "end": 702.02,
   "text": "که همه اینام باز رتبه رتبه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 702.02,
   "end": 704.66,
   "text": "مراتب دارن. چهارمیش عالم شهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 704.66,
   "end": 706.26,
   "text": "ما الان در عالم شهود هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 706.26,
   "end": 709.84,
   "text": "نشئہ الملك. ناسوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 709.84,
   "end": 714.0,
   "text": "دنیا. چهارمی، پنجمی‌شم عالم انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 714.0,
   "end": 716.88,
   "text": "که البته همه این عوالم در انسان کامل هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 716.88,
   "end": 725.32,
   "text": "قلب، قلب میگه تقلب داره، انقلاب داره، رفت و برگشت و رفت و آمد داره در همه این عوالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 725.32,
   "end": 729.68,
   "text": "عجب！ یعنی نفوذ داره. یعنی میگن آدم فلانی آدم بانفوذه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 729.68,
   "end": 736.06,
   "text": "همه جا نفوذ داره. قلب اسماء الهیه را به نحو احدیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 736.06,
   "end": 738.24,
   "text": "اهدیت جمع داراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 738.24,
   "end": 741.46,
   "text": "که حالا این اهدیّت رو قبلاً گفتیم برمی‌گرده به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 741.46,
   "end": 746.48,
   "text": "به اعتبار ذات یعنی درون ذات در، در نه بیرون ذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 746.48,
   "end": 748.94,
   "text": "که حالا اجازه بدید بعداً الان جاش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 748.94,
   "end": 754.14,
   "text": "\"و مر قلب را و مر قلب راست ظهور آن اسماء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 754.14,
   "end": 757.88,
   "text": "که حکم هر یک از آنها بر سبیل عدالت ظاهر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 757.88,
   "end": 762.44,
   "text": "اینجا هم ببینید یه بخش دیگه از صحبت از تعلّمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 762.44,
   "end": 768.16,
   "text": "قیصری. \"قلب برزخ ظاهر و باطن است.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 768.16,
   "end": 770.42,
   "text": "اینجا خیلی گره گشاست برای فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 770.42,
   "end": 774.86,
   "text": "جایگاه قلب. \"قلب برزخ ظاهر و باطن است و از قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 774.86,
   "end": 779.36,
   "text": "فیض بر هر یک از آنها فایض می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 779.36,
   "end": 782.6,
   "text": "و قلب صورت مرتبه الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 782.6,
   "end": 785.76,
   "text": "است چنانکه روح صورت مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 785.76,
   "end": 792.14,
   "text": "اهدیّت است.\" دنباله قلب همون روح می‌شه که اتصالش به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 792.14,
   "end": 794.9,
   "text": "مرحله ذات حضرت حق می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 794.9,
   "end": 799.94,
   "text": "\"از این روی قلب وسعت هر چیز حتی حق را داراست.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 799.94,
   "end": 804.86,
   "text": "الله اکبر. یه همچین وسعتی داره اینکه بگه \"وسعت رحمتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 804.86,
   "end": 809.26,
   "text": "کل شیء\" یا \"برحمتی کلتی وسعت کل شیء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 809.26,
   "end": 814.76,
   "text": "به جهت داشتن قلبه که اگر قلب نداشتیم ما همچین چیزی امکان نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 814.76,
   "end": 817.92,
   "text": "توجه کردید؟ پس قلب جایگاهش خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 817.92,
   "end": 820.12,
   "text": "محل نزول فیض الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 820.12,
   "end": 827.48,
   "text": "حالا این فیض رو شما می‌تونی وجود بگیری، می‌تونی علم بگیری، می‌تونی رزق بگیری، می‌تونی نور بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 827.48,
   "end": 833.14,
   "text": "هر چیزی که بر تو می‌رسد از حضرت حق اصلاً وجود تو، همین وجود تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 833.14,
   "end": 837.76,
   "text": "در حقیقت از قلب می‌رسه از قلب تو محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 837.76,
   "end": 843.78,
   "text": "در حقیقت این رسیدن فیض وجوده که اگر تو هستی چون قلب داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 843.78,
   "end": 852.0,
   "text": "خب حالا بعد از تعلّمه در ادامه بعد از که این فرمایش حضرت قیصری رو نقل می‌کنند در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 852.0,
   "end": 858.96,
   "text": "عرض شود خدمتتون اونجایی که فیض اقدس و مقدس رو از تعلّمه بیان می‌کنند، اشاره میدن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 858.96,
   "end": 861.02,
   "text": "دعا. اینم بگم و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 861.02,
   "end": 863.42,
   "text": "به چقدر شیرینه این دعا رو یاد بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 863.42,
   "end": 869.14,
   "text": "دعای مولا امیرالمؤمنین صلوات الله علیه که از خدا چی می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 869.14,
   "end": 874.66,
   "text": "خیلی دعای عجیبه. واقعاً میگم کسی که مقدار سوادش بالاست نه در حد سطح من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 874.66,
   "end": 882.22,
   "text": "باید واقعاً یه بگم سی شب چقدر در مورد همین چند عبارت دعا مناجات مولا علی حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 882.22,
   "end": 884.98,
   "text": "انقدر پر مغزه، پر حرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 884.98,
   "end": 887.5,
   "text": "که حضرت تعلّمه اشاره میده به اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 887.5,
   "end": 889.98,
   "text": "می‌فرماید که \"امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 889.98,
   "end": 893.84,
   "text": "کل حضرت وصی علیه الصلاة والسلام\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 893.84,
   "end": 901.08,
   "text": "عین عبارت علامه‌ست. در مناجات از خدایش می‌خواهد \"الله منور\" اینجا رو دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 901.08,
   "end": 903.12,
   "text": "این تقسیم‌بندی‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 903.12,
   "end": 905.8,
   "text": "\"الله منور\" خدایا منور کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 905.8,
   "end": 910.26,
   "text": "\"ظاهری بطاعتك\". ظاهر من رو به اطاعت خودت منور کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 910.26,
   "end": 917.24,
   "text": "اونایی که میخوان ظاهرشون منور بشه نورانی بشن به عباد-- به طاعت خدا به اطاعت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 917.24,
   "end": 919.64,
   "text": "باطن آدم با چی نورانی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 919.64,
   "end": 922.18,
   "text": "\"وباطنی بمحبتك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 922.18,
   "end": 924.3,
   "text": "ببین از ظاهر رفت به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 924.3,
   "end": 928.56,
   "text": "این ارتباط بین ظاهر و باطن توسط چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 928.56,
   "end": 932.16,
   "text": "الان گفتیم برزخ ظاهر و باطن در وجود انسان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 932.16,
   "end": 935.54,
   "text": "قلب مقام قلب. بعد به محبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 935.54,
   "end": 940.28,
   "text": "بعد چه-- لذا بلافاصله وقتی بحث باطن رو حضرت مطرح می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 940.28,
   "end": 944.54,
   "text": "و، \"وباطنی بمحبتك\" یعنی \"ونور باطنی بمحبتك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 944.54,
   "end": 947.52,
   "text": "می‌فرماید \"وقلبی بمعرفتك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 947.52,
   "end": 949.76,
   "text": "\"وقلبی بمعرفتك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 949.76,
   "end": 951.64,
   "text": "معرفت جایگاهش قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 951.64,
   "end": 954.62,
   "text": "الان بحثش گذشت. علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 954.62,
   "end": 956.54,
   "text": "و اون حقیقت علم رو کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 956.54,
   "end": 958.68,
   "text": "اون علم فکری، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 958.68,
   "end": 961.28,
   "text": "دانسته ها، این الفاظ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 961.28,
   "end": 965.82,
   "text": "این صغرا، كبرا چیدن، استنباط، نتیجه‌گیری، قضایا، اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 965.82,
   "end": 970.32,
   "text": "قضایای منطقی. اینا جاش تو عقله تو فکر انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 970.32,
   "end": 974.86,
   "text": "ولی اونکه درک می‌کنه اینو می‌فهمه می‌چشه جایگاهش قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 974.86,
   "end": 978.36,
   "text": "لذا می‌فرماید \"وقلبی بمعرفتك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 978.36,
   "end": 983.0,
   "text": "و البته چون اومده تو حوزه باطن حضرت داره ارتباط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 983.0,
   "end": 986.24,
   "text": "قلب تو رو با حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 986.24,
   "end": 990.34,
   "text": "اینجا اتصالش رو مشخص می‌کنه از چه ناحیه ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 990.34,
   "end": 992.42,
   "text": "از باطن اما کشیده شده از کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 992.42,
   "end": 996.16,
   "text": "از قلب تو. چه-- لذا بلافاصله می‌فرماید \"وروحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 996.16,
   "end": 1001.26,
   "text": "بمشاهدتك\". این روح همون مقام قلب است که مقام انشا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1001.26,
   "end": 1004.86,
   "text": "مقام در حقیقت حیات توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1004.86,
   "end": 1008.94,
   "text": "به تو حیات می‌دهد. مثل درختی که وقتی خشک شد دیگه روح نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1008.94,
   "end": 1011.42,
   "text": "وقتی سرزنده است روح داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1011.42,
   "end": 1016.02,
   "text": "زنده است اصطلاحاً. بعد انتها می‌فرماید \"وسری\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1016.02,
   "end": 1018.68,
   "text": "\"وسری\". این سر به کجا میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1018.68,
   "end": 1022.28,
   "text": "به استقلال اتصال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1022.28,
   "end": 1024.9,
   "text": "حضرتك. به استقلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1024.9,
   "end": 1027.3,
   "text": "اتصال حضرتك. سر من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1027.3,
   "end": 1030.12,
   "text": "يا ذي الجلال والاكرام. سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1030.12,
   "end": 1032.58,
   "text": "می‌شه همون مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1032.58,
   "end": 1035.1,
   "text": "اولیٰ یا علیٰ بگیم بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1035.1,
   "end": 1039.82,
   "text": "اون عالی‌ترین مرتبه قلب انسان که مرتبه اتصال ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1039.82,
   "end": 1045.6,
   "text": "با اهدیّت حضرت حق و ذات حضرت حق است که اون اصلاً دیگه جدا شدنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1045.6,
   "end": 1051.32,
   "text": "بحثش گذشت. ولی هرچه هست این وسط بین ظاهر و باطن قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1051.32,
   "end": 1053.26,
   "text": "گاهی رو به دنیا داره، به ظاهر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1053.26,
   "end": 1055.92,
   "text": "گاهی رو به باطن داره، به آخرت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1055.92,
   "end": 1057.48,
   "text": "منقلبه، متقلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1057.48,
   "end": 1059.82,
   "text": "هی اینور اونور. اینو باید بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1059.82,
   "end": 1062.18,
   "text": "خیلی باید مراقب باشیم که اگر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1062.18,
   "end": 1069.84,
   "text": "محجوب باشه دیگه خودمون با دست خودمون راه رزق، فیض و علم خدا رو به روی خودمون مسدود کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1069.84,
   "end": 1073.08,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر شود به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1073.08,
   "end": 1075.46,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1075.46,
   "end": 1078.68,
   "text": "الله- الله سلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1078.68,
   "end": 1081.04,
   "text": "محمد آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}