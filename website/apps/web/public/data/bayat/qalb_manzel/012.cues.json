   "title": "## نماز جماعت و امام راتب مسجد",
   "start": 0.68,
   "end": 129.26
  },
  {
   "index": 1,
   "title": "## قبول اعمال به معرفت",
   "start": 129.26,
   "end": 243.7
  },
  {
   "index": 2,
   "title": "## آفت هیئت‌ها و ادارات؛ فرار از معارف",
   "start": 243.7,
   "end": 389.5
  },
  {
   "index": 3,
   "title": "## هو الذی؛ تلاوت و تزکیه و تعلیم",
   "start": 389.5,
   "end": 775.89
  },
  {
   "index": 4,
   "title": "## به یادگار؛ اوتاد از زبان اولیاء",
   "start": 775.89,
   "end": 867.43
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.68,
   "end": 10.02,
   "text": "آیا اگر کسی در جایی که امام جماعت راتبی هست یعنی از طرف مرکز رسیدگی به امور مساجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.02,
   "end": 13.14,
   "text": "اونجا امام جماعت تعیین شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.14,
   "end": 16.5,
   "text": "اجازه داره، میشه بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.5,
   "end": 21.14,
   "text": "اذن اون امام جماعت راتب اونجا نماز جماعت به پا کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.14,
   "end": 25.24,
   "text": "یعنی یه کسی بیاد اون امام جماعت راتب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.24,
   "end": 29.9,
   "text": "خب مثلا وارد مسجدی شد یه روحانی، یه آخوندی، کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.9,
   "end": 34.86,
   "text": "یا همونجا بود بعد دید امام جماعت راتب مسجد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.86,
   "end": 39.3,
   "text": "بعضیا میگن باید اجازه بگیره از اون امام جماعت راتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.3,
   "end": 43.64,
   "text": "که جماعت به پا بشه. آیا این درسته این حرفی که میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.64,
   "end": 46.38,
   "text": "رهبر عزیزمون فرمودن نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.38,
   "end": 54.02,
   "text": "اقامه نماز جماعت متوقف بر اذن امام جماعت راتب مسجد نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.02,
   "end": 59.74,
   "text": "و اما آقا توصیه کردن که اون امام جماعت راتب رو کمک کنن در امام جماعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.74,
   "end": 66.62,
   "text": "مثلا اینکه بخواد نماز بخونه تا حالا یه دقیقه دیر کرد سریع یه دونه نزن یکی جلو آقا شروع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.62,
   "end": 69.52,
   "text": "این کار بدیه که یعنی به نوعی بی‌حرمتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.52,
   "end": 74.66,
   "text": "مخصوصا اگر طرف روحانی نباشه که اصلا امام جایز نمی‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.66,
   "end": 76.7,
   "text": "دو دقیقه صبر کن نمازت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.7,
   "end": 78.82,
   "text": "یعنی عین عبادتت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.82,
   "end": 84.18,
   "text": "صبرتو بر اقامه نماز جماعت صبری که می‌کنی عین عبادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.18,
   "end": 89.46,
   "text": "که اگر مکلف یعنی غیرروحانی وایسته جلو که اصلا امام میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.46,
   "end": 92.38,
   "text": "جایز نیست، حق این کارو نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.38,
   "end": 95.28,
   "text": "و رهبر باز اینجا یک موضوع دیگه هم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.28,
   "end": 99.66,
   "text": "آقا می‌فرمایند که اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.66,
   "end": 104.88,
   "text": "اقامه نماز جماعت بدون اذن راتب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.88,
   "end": 108.98,
   "text": "امام جماعت راتب بدون اذن فتنه ایجاد کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.98,
   "end": 111.2,
   "text": "اون موقع اصلاً دیگه حرامه این کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.2,
   "end": 114.08,
   "text": "اگه باعث فتنه بشه که بعضی جاها می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.08,
   "end": 117.62,
   "text": "دودستگی و دعوا و نزاع و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.62,
   "end": 124.06,
   "text": "اجازه بفرمایید که امروز توی فرصت کوتاهی که داریم یه چند تا سؤال رو که پیش اومده بود در مبحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.06,
   "end": 126.8,
   "text": "قلب منزل جواب بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.8,
   "end": 132.5,
   "text": "اول سؤال کردن که آقا شما بر اساس روایات و این‌ها فرمودید که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.5,
   "end": 139.72,
   "text": "اهل بیت فرمودند که لا-- \"و لا یَقْبَلُ اللهُ أَعْمَالَ العِبادِ إِلَّا بِمَعْرِفَتِه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.72,
   "end": 144.04,
   "text": "که اصلا هیچ عملی از بندگان قبول نمی‌شه مگر به معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.04,
   "end": 146.8,
   "text": "الله، مگر به شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.8,
   "end": 154.4,
   "text": "و این معرفت رو بر اساس روایات و گو فرمایش ابا عبدالله سلام الله علیه معرفت امام گرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.4,
   "end": 157.92,
   "text": "یعنی در حقیقت جمعش که کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.92,
   "end": 163.76,
   "text": "هیچ عبادتی از بندگان قبول نمی‌شود الا با معرفت امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.76,
   "end": 170.16,
   "text": "خب بعد سؤال پیش اومده که عزیزان میگن که خب این معرفت امام چگونه بدست میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.16,
   "end": 178.16,
   "text": "شما گفتی رد شدی. این سؤال رو ما قبلاً جواب داده بودیم قبلاً ها و حتی حدود بیست جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 178.16,
   "end": 182.1,
   "text": "در خصوص معرفت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.1,
   "end": 187.6,
   "text": "سخن گفتیم در شرح رساله شریف نهج‌البلغه از طرف علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 187.6,
   "end": 192.02,
   "text": "رحمت الله علیه. اگر کسی تونست حالا تو کانال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 192.02,
   "end": 197.6,
   "text": "مرام گمنامی سرچ کنید اگر مونده باشه چون متاسفانه اینا غالباً از سرور پاک شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 197.6,
   "end": 201.12,
   "text": "بعضیا تو ابر موبایلشون اینا رو نگه داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 201.12,
   "end": 203.44,
   "text": "رجوع کنید. ببینید ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 203.44,
   "end": 207.84,
   "text": "باید اهل تفکر و تأمل و تعقل و این‌ها باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 207.84,
   "end": 213.5,
   "text": "ورزش فکری به قول علامه باید بکنیم در خصوص معرفت امام تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 213.5,
   "end": 217.52,
   "text": "چون شما میگید که العلم نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.52,
   "end": 220.52,
   "text": "جنس علم نوره، جنس معرفت نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 220.52,
   "end": 224.7,
   "text": "پس اون کسی که نور رو می‌تاباند به قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 224.7,
   "end": 227.54,
   "text": "اون الهام گر اصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 227.54,
   "end": 230.66,
   "text": "ملکوت نظامه. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 230.66,
   "end": 232.84,
   "text": "صرفاً بسپاریم به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.84,
   "end": 238.68,
   "text": "کار فکری نکنیم. این اشتباه بسیار خطرناکیه که متاسفانه ما می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 238.68,
   "end": 243.2,
   "text": "اینجا من یک هشداری بدم که متاسفانه در هیئت‌ها خیلی باب شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 243.2,
   "end": 245.72,
   "text": "حتی در ادارجات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.72,
   "end": 250.58,
   "text": "و حتی اینجا من دیدم این تفکر بسیار خطرناک رو متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 250.58,
   "end": 254.22,
   "text": "که طرف میگه یه روضه بخون بریم بابا این حرفا به چه درد ما می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.22,
   "end": 259.26,
   "text": "گاهی اوقات به شوخی و گاهی اوقات داره میگن نصف شوخی جدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 259.26,
   "end": 260.86,
   "text": "داره جدی حرفشو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.86,
   "end": 266.56,
   "text": "حضرت آقای جوادی آملی بالاخره کارشناسان دین اینا ما باید پشت سر متخصص راه بیفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.56,
   "end": 270.8,
   "text": "اینطوری نیست که هر وقت هر جای بدنمون درد گرفت بریم استامینوفن بخوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.8,
   "end": 276.24,
   "text": "باید از متخصص علم طب بپرسیم الان من مثلا اینجای گوشه سینم درد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 276.24,
   "end": 281.56,
   "text": "بعد میگه برو آزمایش بده، برو سی‌تی اسکن بده، MRI بده، همینطوری که نباید قرص بخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.56,
   "end": 285.0,
   "text": "آقا قرص من الان مثلاً اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 285.0,
   "end": 288.76,
   "text": "صرفاً اشک بریزم، صرفاً مناجات کنم، دعا این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 288.76,
   "end": 292.8,
   "text": "کی گفته اینا رو؟ پاشو پشت سر کارشناس دین باید حرکت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 292.8,
   "end": 295.34,
   "text": "اونم نه مثل من. علما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.34,
   "end": 298.74,
   "text": "عرفا، حکما. آقای جوادی آملی می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.74,
   "end": 301.16,
   "text": "معارف به سان خورشیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.16,
   "end": 305.74,
   "text": "خورشید. اما روضه، اشک، آه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.74,
   "end": 308.12,
   "text": "به سان نمک خورشیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.12,
   "end": 311.02,
   "text": "حالا هر کدوم از اینا رو شما بگیر نمک رو بگیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.02,
   "end": 314.62,
   "text": "مزه نداره غذا. اون نمک، اون روضه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.62,
   "end": 319.72,
   "text": "نمک غذاته. مزه میده بهت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.72,
   "end": 322.38,
   "text": "حالا شما نمک بخور کور میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 322.38,
   "end": 325.24,
   "text": "خورش نخور، کور میشی، تقویت نمی‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.24,
   "end": 330.06,
   "text": "صرفاً برو تو شرکت کن تو مجالس امام حسین به کجا می‌رسی تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.06,
   "end": 335.06,
   "text": "یه آدم معذرت میخوام دگمی بار میای که هیچی از معارف نمی‌دونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 335.06,
   "end": 338.42,
   "text": "دو تا شبهه هم بشنوی سریع چپ می‌کنی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.42,
   "end": 342.32,
   "text": "السلام. اینطوری نمی‌شه باید دو تاش با هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 342.32,
   "end": 344.76,
   "text": "هم ورزش فکری نیازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 344.76,
   "end": 347.94,
   "text": "و هم طهارت نفس. اینو رو من به صورت جد عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 347.94,
   "end": 350.64,
   "text": "اینایی که صرفا فراری‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 350.64,
   "end": 359.22,
   "text": "از شنیدن، حرف شنیدن بارها عرض کردیم علامه می‌فرمودند اونچه که انسان رو تأدیب می‌کنه حرف شنیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 359.22,
   "end": 363.08,
   "text": "همونطور که حیوان رو شلاق زدن و جمادات رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 363.08,
   "end": 366.12,
   "text": "نباتات رو هرس کردن تأدیب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 366.12,
   "end": 371.12,
   "text": "حرف شنو باشیم و بعضی‌هام از اون طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 371.12,
   "end": 373.8,
   "text": "متاسفانه فقط حرف می‌شنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 373.8,
   "end": 377.3,
   "text": "اصلا حوصله‌ی اشک و آه و عنابه‌ و روضه ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.3,
   "end": 379.82,
   "text": "اینا رو کسر شأن خودشون می‌دونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 379.82,
   "end": 386.2,
   "text": "که مثلا گریه کنن. حتی اگرم اشکی بیاد اصلا نه آهی داره نه شی-- اینام بده، اینام خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 386.2,
   "end": 389.5,
   "text": "در هر دو-- اصلا شما دقت کنید آیه دو سوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.5,
   "end": 392.16,
   "text": "چرا از خودمون حرف بزنیم، سوره جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.16,
   "end": 396.88,
   "text": "\"هُوَ الَّذِي\" همون هُوَ‌ای که بهت میگه \"قُل\" بگو \"هُوَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.88,
   "end": 399.2,
   "text": "اللَّهُ أَحَدٌ\" تو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.2,
   "end": 405.56,
   "text": "هدایت می‌کنه به سمت خدایی که بدون لحظات و اعتبارات و امتیازات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.56,
   "end": 407.36,
   "text": "عذر شود تشئونات هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.36,
   "end": 410.02,
   "text": "اون هُوَ، اون الله، الله ذاتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 410.02,
   "end": 412.5,
   "text": "برو سر هُوَ. اشاره به او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 412.5,
   "end": 415.12,
   "text": "دیگه کاری نداشته باش او کیه، چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 415.12,
   "end": 419.48,
   "text": "چون نمی‌تونی بفهمی. بعد باز میگه \"اللَّهُ أَحَدٌ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 419.48,
   "end": 421.62,
   "text": "اون احدیت اشاره به ذات خدا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.62,
   "end": 425.54,
   "text": "گفتیم واحدیت، واحدیت حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.54,
   "end": 427.94,
   "text": "مقام کثرت ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 427.94,
   "end": 430.4,
   "text": "و تشئونات حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.4,
   "end": 434.01,
   "text": "احدیت مقام ذاته. اصلا تو نمی‌تونی بفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.01,
   "end": 436.78,
   "text": "با این که نمی‌تونی بفهمی هدایتت کرده به اون سمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.78,
   "end": 438.56,
   "text": "میگه \"قُل\" بگو. چی بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 438.56,
   "end": 442.04,
   "text": "هُوَ. کدوم هُوَ؟ او که داری اشاره می‌کنی کدوم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.04,
   "end": 444.62,
   "text": "اللهی که اینجا معلومه اسم ذاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.62,
   "end": 449.66,
   "text": "اللهی که احده. این احد باز داره تاکید می‌کنه که این الله اسم ذاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.66,
   "end": 452.72,
   "text": "تو به سمت ذات حضرت حق در حرکتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.72,
   "end": 455.7,
   "text": "بعد اون الله بعدی که \"اللَّهُ الصَّمَدُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.7,
   "end": 460.14,
   "text": "چون میاد مبتدا می‌شه بر الصمد و اسم و صفت حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.14,
   "end": 464.36,
   "text": "اون دیگه می‌شه ال-- حالا الله صفاتی می‌شه و اسم صفاتی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.36,
   "end": 468.4,
   "text": "کاری نداریم. همون ق-- همون اللهی، همون هُوَ‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.4,
   "end": 471.02,
   "text": "اینجا بهت گفتن بگو هُوَ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.02,
   "end": 473.56,
   "text": "همون هُوَ میگه \"هُوَ الَّذِي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.56,
   "end": 478.42,
   "text": "بَعَثَ فِي الْأُمِّيِّينَ رَسُولًا مِنْهُمْ يَتْلُو عَلَيْهِمْ آيَاتِهِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.42,
   "end": 480.94,
   "text": "اومده که تلاوت کنه یعنی متخصصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.94,
   "end": 484.3,
   "text": "چون تخصص دین داره اومده برای تو تلاوت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.3,
   "end": 486.66,
   "text": "تلاوت رو از متخصص بشنو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.66,
   "end": 490.06,
   "text": "که چی بشه؟ \"وَيُزَكِّيهِمْ\" طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.06,
   "end": 494.1,
   "text": "\"وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 494.1,
   "end": 496.98,
   "text": "هم کتاب رو حکمتم که باطنشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.98,
   "end": 500.22,
   "text": "ببری از ظاهر عبور کنی بری به باطن‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 500.22,
   "end": 503.92,
   "text": "این دو تا باید با هم باشه. نمی‌شه صرفا طهارت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 503.92,
   "end": 506.68,
   "text": "پیشه کرد و گناه نکرد و به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 506.68,
   "end": 509.72,
   "text": "\"وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ\" نرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.72,
   "end": 512.84,
   "text": "پنجاه درصد کار پیغمبر رو تعطیل کردی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 512.84,
   "end": 515.52,
   "text": "نمی‌شه صرفا رفت تعلیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.52,
   "end": 517.66,
   "text": "این‌ها و تعلیم و حالا ف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.66,
   "end": 522.5,
   "text": "ورزش فکری کرد به قولی و طهارت نفس و ترک نفس چیزی نمی‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.5,
   "end": 526.54,
   "text": "این‌ها باید با هم باشه. طهارت نفس عزیزم میاد چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.54,
   "end": 529.18,
   "text": "زمینه رو آماده می‌کنه، شخم می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 529.18,
   "end": 532.88,
   "text": "حالا دانه‌ی بذر معرفت و علم رو بکار، کار فکری بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 532.88,
   "end": 535.64,
   "text": "قشنگ جوانه می‌زنه میاد بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 535.64,
   "end": 540.92,
   "text": "دو تاش باید با هم باشه. عزیزانی که گفتن در حیث معرفت چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.92,
   "end": 545.6,
   "text": "بسم الله. یک طهارت نفس تا می‌تونیم گناه نکنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.6,
   "end": 550.24,
   "text": "تا افاضات صورت بگیره. دو کتاب‌هایی که پیرامون امام عصر بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 550.24,
   "end": 554.14,
   "text": "کتاب‌های خوبی هست. مهدی موعود خیلی کتاب خوبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 554.14,
   "end": 556.82,
   "text": "و النجم الثاقب کتاب خوبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 556.82,
   "end": 559.82,
   "text": "خیلی کتاب عالیه. مکارم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 559.82,
   "end": 562.32,
   "text": "اخ-- امم مخيال المكارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 562.32,
   "end": 564.12,
   "text": "مخيال المكارم دو جلدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.12,
   "end": 568.98,
   "text": "اصلا تو این دو جلد کتابو بخونی اون امام عصری که تا حالا شناختیو می‌ذاری کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 568.98,
   "end": 575.0,
   "text": "اینطوری به شما بگم. بالاتر، برو بالاتر نهج الولایه حضرت استاد علامه حسن زاده رو بخون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 575.0,
   "end": 580.02,
   "text": "بتون ولایت کلیه الهیه و باطن امام رو برات آشکار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 580.02,
   "end": 583.14,
   "text": "بسم الله آدم باید زحمت بکشه، کار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 583.14,
   "end": 587.86,
   "text": "این یه سؤال. یه سؤال دیگه‌ای هم شده اونم جواب بدم خیلی سریع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 587.86,
   "end": 590.08,
   "text": "که پرسیدن عزیزان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 590.08,
   "end": 594.62,
   "text": "اون سلسله مراتبی که در تنزل فیض حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 594.62,
   "end": 602.34,
   "text": "از قلب قطب الاقطاب و غوث الاعظم به ذی قطب که اون رو امام بگیری این می‌شود نائبش همینطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 602.34,
   "end": 604.58,
   "text": "تا ابدال و اوتاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 604.58,
   "end": 611.8,
   "text": "نقبا و نجبا و این‌ها همینطور تا الأغرب فالأغرب که هرکی نزدیک‌تره این فیض رو اول می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 611.8,
   "end": 614.96,
   "text": "و از قلوب منتشر می‌شه این فیض الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 614.96,
   "end": 618.82,
   "text": "هنوز همین چنینه یا فرق کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 618.82,
   "end": 622.98,
   "text": "این سلسله طولیه نزولیه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 622.98,
   "end": 627.12,
   "text": "فیض الهی از-- چون بحث ما قلب منزل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.12,
   "end": 632.52,
   "text": "اول به قلب امام عصر نازل می‌شه حقایق بعد به ما می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 632.52,
   "end": 634.42,
   "text": "این هنوز همین چنینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 634.42,
   "end": 637.5,
   "text": "بله. \"وَلَن تَجِدَ لِسُنَّةِ اللَّهِ تَبْدِيلًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.5,
   "end": 640.42,
   "text": "قرآن میگه \"وَابْتَغُوا إِلَيْهِ الْوَسِيلَةَ\" با وسیله بیاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 640.42,
   "end": 642.4,
   "text": "اصلا نمی‌شه غیر از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 642.4,
   "end": 645.74,
   "text": "چون اون برزخ جامعه و این سلسله طولیه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 645.74,
   "end": 649.72,
   "text": "سؤال اگر یکی از این‌ها از دنیا رفت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 649.72,
   "end": 653.18,
   "text": "حالا شما اوتاد رو بگیرید بعضیا گفتن سه تا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 653.18,
   "end": 655.86,
   "text": "حالا بعضیا گفتن چهار تا. کاری به عددش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 655.86,
   "end": 659.16,
   "text": "بگیرید چهار تا. این اوتاد چهار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 659.16,
   "end": 663.56,
   "text": "که حلقه‌ی بعضیا گفتن وصل اول، بعضیا گفتن وصل دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 663.56,
   "end": 668.9,
   "text": "به هر حال حلقه‌ی ارتباطی امثال ما با امام عصر یکیش اوتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 668.9,
   "end": 671.42,
   "text": "چهار نفر اگه بگیری یکیش مرد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 671.42,
   "end": 673.22,
   "text": "دو تاش مرد، چهار تاش. یعنی نمی‌میرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 673.22,
   "end": 675.38,
   "text": "می‌میرن. چرا انسان‌ها می‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 675.38,
   "end": 679.94,
   "text": "پس چی می‌شه؟ کسای دیگه از اون حلقه‌ی پایین‌تر میان وصل می‌شن به اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 679.94,
   "end": 682.42,
   "text": "رتبه می‌گیرن میان بالاتر. همینطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 682.42,
   "end": 686.96,
   "text": "الأغرب فالأغرب اون آخر سر برای همین آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 686.96,
   "end": 694.44,
   "text": "یعنی ماها هم اگر بجنبیم رو خودمون کار کنیم تلاش کنیم بکشیم بالا خودمون رو \"تعالوا تعالوا\" بریم بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 694.44,
   "end": 696.34,
   "text": "ما هم امید هست بریم تو اون حلقه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 696.34,
   "end": 703.38,
   "text": "چرا نریم؟ بعد سؤال کردن که آیا امکان داره مثلا یکی مثل سردار سلیمانی یکی از اون حلقه‌ها باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 703.38,
   "end": 708.04,
   "text": "ما چه می‌دونیم؟ ما نمی‌تونیم مصداق تعیین کنیم که ما در اون حد و رتبه نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 708.04,
   "end": 711.06,
   "text": "اما بعید نیست. چون کار، کار قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 711.06,
   "end": 715.42,
   "text": "گفتیم اول فیض بر قلب حجت خدا نازل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 715.42,
   "end": 719.86,
   "text": "بعد از قلب اون قطب الاقطاب غوث اعظم به ذی قطب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 719.86,
   "end": 726.42,
   "text": "بعد اوتاد حالا یا ابدال رو اول بخوای تقدم تأخرشو بگیری فرق نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 726.42,
   "end": 732.22,
   "text": "مثلا ابدال، اوتاد، بعد نجبا و نقبا الأغرب فالأغرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 732.22,
   "end": 735.26,
   "text": "پس اگر این چنینه کار، کار قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 735.26,
   "end": 739.1,
   "text": "واقعا در خصوص سردار سلیمانی کار قلب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 739.1,
   "end": 742.34,
   "text": "هیچی دیگه نبود. دل‌ها رو تکون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 742.34,
   "end": 744.82,
   "text": "اصلا بی‌اختیار همه گریان بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 744.82,
   "end": 746.6,
   "text": "من می‌دیدم شما هم زیاد دیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 746.6,
   "end": 749.61,
   "text": "آدم‌هایی که حتی حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 749.61,
   "end": 753.05,
   "text": "چی بگیم؟ انقلابم حتی شاید قبول نداشتن ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 753.05,
   "end": 759.05,
   "text": "اصلاً بدشون میاد از سیاست حرف سیاست می‌زنی حالشون بد می‌شه و اینا اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 759.05,
   "end": 762.13,
   "text": "برای ح-- سردار سلیمانی گریه‌شون گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 762.13,
   "end": 767.57,
   "text": "ناراحت شدن، خرما دادن مجلس که من دیدم خیلی دیدم تو آشنا‌هامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 767.57,
   "end": 772.69,
   "text": "این کار قلبه دیگه. می‌تونه یکی از اون حلقه‌ها ایشون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 772.69,
   "end": 774.79,
   "text": "حالا مصادیق رو ما نمی‌تونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 774.79,
   "end": 778.15,
   "text": "اما من شنیدم حالا به یادگار به شما بگم و بحث تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 778.15,
   "end": 782.23,
   "text": "به یادگار به شما عرض کنم که من از یکی از اولیاء خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 782.23,
   "end": 784.81,
   "text": "شنیدم که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 784.81,
   "end": 790.71,
   "text": "حلقه اول، اون چهار نفر حلقه اول رو که ایشون می‌گفت اوتادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 790.71,
   "end": 793.43,
   "text": "و تد والجبال اوتادا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 793.43,
   "end": 797.73,
   "text": "از امام عصر به اون‌ها می‌رسه، اون‌ها به بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 797.73,
   "end": 801.81,
   "text": "و اگر البته ذیقطر رو که بعد از قطب الاقطاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 801.81,
   "end": 803.93,
   "text": "ولی فقیه یا نائب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 803.93,
   "end": 807.33,
   "text": "خاص یا عام بگیری اونا میشن حلقه دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 807.33,
   "end": 810.49,
   "text": "حالا ایشون می‌فرمودن که از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 810.49,
   "end": 814.47,
   "text": "می‌گفت من از چند تا از بزرگان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 814.47,
   "end": 816.73,
   "text": "اسم نبرد برای من، از لسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 816.73,
   "end": 819.61,
   "text": "خودشون شنیدم که گفت از دنیا هم رفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 819.61,
   "end": 824.93,
   "text": "یکی از اون اوتاد حضرت علامه حسن زاده بودند که ایشون زنده بود هنوز به من ایشون گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 824.93,
   "end": 829.69,
   "text": "یعنی علامه زنده بود. یکیشونم که از دنیا رفتن حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 829.69,
   "end": 833.17,
   "text": "سید محمد حسین حسینی تهرانی بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 833.17,
   "end": 837.79,
   "text": "که گفتم اگه رفتید حرم امام رضا نشونه قبرشو به شما دادم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 837.79,
   "end": 841.71,
   "text": "برید ایشونو زیارت کنید که هدیه حضرت آیت الله العظمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 841.71,
   "end": 843.29,
   "text": "فقیه امامی بود به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 843.29,
   "end": 846.17,
   "text": "ما یه چیزی به ایشون تو، تو حرم نشون دادیم، یاد دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 846.17,
   "end": 849.25,
   "text": "ایشون هم اینو به ما یاد داد. قبر ایشون بوی بهشت می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 849.25,
   "end": 852.97,
   "text": "همینطوری بدون شامه مسلح هم که نداشته باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 852.97,
   "end": 858.13,
   "text": "صورتتو می‌ذاری رو قبر ایشون که اسمم نداره قشنگ بوی بهشتو می‌چشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 858.13,
   "end": 861.19,
   "text": "انشاالله که عاقبت ما ختم بخیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 861.19,
   "end": 867.43,
   "text": "به برکت صلوات بر محمد و آل محمد. اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}