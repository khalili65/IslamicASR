   "start": 60.72,
   "end": 85.28
  },
  {
   "index": 2,
   "title": "## حیات ذاتی: جدول وجودی متصل به دریای وجود",
   "start": 85.28,
   "end": 154.84
  },
  {
   "index": 3,
   "title": "## حیات مزاجی و عناصر اربعه",
   "start": 154.84,
   "end": 542.15
  },
  {
   "index": 4,
   "title": "## تأثیر مزاج بر حالات و منامات قلب",
   "start": 542.15,
   "end": 562.99
  },
  {
   "index": 5,
   "title": "## واردات قلبی بر وفق استعداد و ترکیب مزاج",
   "start": 562.99,
   "end": 1024.39
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.0,
   "end": 6.42,
   "text": "می‌خواستیم بگیم آیا می‌شود به کسی که به دیگری اقتدا کرده اقتدا کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.42,
   "end": 14.3,
   "text": "یعنی مثلاً شما وارد شدی در نمازخونه دیدی دو تا، سه تا، چهار تا آدم رفیقا اینا با هم دارن نماز جماعت می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.3,
   "end": 17.72,
   "text": "شما امام رو قبول نداشتی مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.72,
   "end": 21.7,
   "text": "اون رفیقت که اقتدا کرده به امام اونو قبول داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.7,
   "end": 27.2,
   "text": "می‌تونی اقتدا کنی به اون مأمومی که اقتدا کرده به یکی دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.2,
   "end": 30.46,
   "text": "نه. همه مراجع گفتن اجازه‌اش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.46,
   "end": 33.9,
   "text": "نمی‌شه به مأمومی که در حال اقتداس اقتدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.9,
   "end": 36.76,
   "text": "حالا اگر این سهوا پیش اومد چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.76,
   "end": 45.78,
   "text": "اینجا رهبر عزیزمون فرمودن که خب از اون لحظه که متوجه می‌شی نیت فرادا می‌کنی و اگر به ر-رکن نمازت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.78,
   "end": 49.3,
   "text": "ارکان نمازت سهوا یا عمداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.3,
   "end": 53.26,
   "text": "چیزی کم و زیاد نشده، نمازت تا اونجا درسته ادامه میدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.26,
   "end": 58.98,
   "text": "ولی به نیت فرادا دیگه اقتدات رو برمی‌داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.98,
   "end": 64.64,
   "text": "بوده باشه. خب خیلی بحث مهمی رو ورود می‌کنیم به فضل الهی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.64,
   "end": 71.24,
   "text": "خیلی همه این، همه بحثی که الان به فضل الهی امروز ورود می‌کنیم خودش ده‌ها جلسه منبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.24,
   "end": 73.66,
   "text": "استخون‌دار سی چهل دقیقه‌ای وقت می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.66,
   "end": 76.34,
   "text": "حالا ما می‌خوایم تو ده دقیقه جمعش کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.34,
   "end": 78.86,
   "text": "تو چند جلسه خدا لطف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.86,
   "end": 82.88,
   "text": "اون هم بحث که بعضیا برا بعضیا هم سؤال شده بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.88,
   "end": 86.06,
   "text": "ربط حیات مزاجی با حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.06,
   "end": 91.6,
   "text": "ذاتی. این چه فر-- اینا چه ربطی، با چه فرقی با هم دارن، چه ربطی به هم دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.6,
   "end": 99.74,
   "text": "و اصلاً این چیه که الان تو خیلی هم توی رسانه معروف شده، مشهور شده مزاج‌شناسی، مزاج‌شناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.74,
   "end": 101.42,
   "text": "اصلاً این چیه؟ این قصه‌ش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.42,
   "end": 107.04,
   "text": "جریانش کجاست؟ آیا ریشه مثلاً روایی داره تو آیات اینا بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.04,
   "end": 109.82,
   "text": "ببینید ما قبلاً عرض کردیم البته ما ق-- بحثمون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.82,
   "end": 118.66,
   "text": "عنوان بحثمون قلب منزل هست یعنی منزلگاه، جایی که نزول می‌کند فیض الهی، اول جایی که فیض الهی از مرتبه احدیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 118.66,
   "end": 123.18,
   "text": "که روح هست از مرتبه احدیت حضرت حق که روح هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.18,
   "end": 126.66,
   "text": "اه، نازل می‌شود بر وجود ما قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.66,
   "end": 129.2,
   "text": "یعنی فیض رو مرتبه اول ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.2,
   "end": 134.74,
   "text": "اون قلب ماست که می‌گیره. لذا برزخ بین ظاهر و باطن بوده و این‌ها که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.74,
   "end": 140.04,
   "text": "اما اینجا باید توجه داشت که این قلب، همین قلبی که محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.04,
   "end": 143.76,
   "text": "نزول فیض الهی از انواع و اقسامش هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 143.76,
   "end": 148.16,
   "text": "کاملاً، کاملاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.16,
   "end": 152.52,
   "text": "از دو چیز تأسی می‌گیره، متأثر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.52,
   "end": 156.12,
   "text": "یک، حیات ذاتی. دو، حیات مزاجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.12,
   "end": 158.38,
   "text": "حیات ذاتی که مشخصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.38,
   "end": 163.3,
   "text": "یعنی اون جدول وجودی تو، حسه‌ات وجودی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.3,
   "end": 165.88,
   "text": "که متصل است به دریای وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.88,
   "end": 172.5,
   "text": "ما تو درس اول معرفت نفس حضرت علامه همون جملات اول این بود یادتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.5,
   "end": 175.2,
   "text": "که وجود است که مشهود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.2,
   "end": 181.88,
   "text": "هرچی می‌بینی وجوده. وجود از صمد حضرت حق که اگر یک دریای لایتناهی بگیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.88,
   "end": 190.62,
   "text": "اون جداولی که از آب وجود بهره گرفتن به میزان صعه وجودی‌شون، اون جدول‌ها من و شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 190.62,
   "end": 192.98,
   "text": "اشیااند، اسماء خارجی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.98,
   "end": 196.22,
   "text": "این عین اشیااند در بیرون که یکیش ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 196.22,
   "end": 201.18,
   "text": "نسبت به صعه وجودیمون از اون آب برخوردار شدیم که حالات ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.18,
   "end": 203.72,
   "text": "صفات ما، اسماء ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.72,
   "end": 206.68,
   "text": "حالا بهتره بگیم اون حالات ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 206.68,
   "end": 212.0,
   "text": "انقلابات درونی ما که همش برمی‌گرده اول از همه از قلب شروع می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 212.0,
   "end": 215.06,
   "text": "که ما متغیر‌الاحوال می‌شویم، همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.06,
   "end": 218.24,
   "text": "بستگی به اون شکن موج‌های دریا دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 218.24,
   "end": 223.96,
   "text": "که وقتی دریا موج-- وقتی شکن در خودش ایجاد می‌کنه در حرکت، در ان--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.96,
   "end": 226.84,
   "text": "فعل و انفعال موجی دا-- ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 226.84,
   "end": 229.64,
   "text": "این موج در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.64,
   "end": 235.32,
   "text": "میاد در اطراف این دریای وجودی و همه این جداول وجودی تأثیرگذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 235.32,
   "end": 237.36,
   "text": "این جدول وجودی رو حالا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.36,
   "end": 244.44,
   "text": "شکن، شکن موج اگر بگیرید، شکن موج دریا بگیرید، می‌بینید انفعالات کاملاً از وجود برخاسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.44,
   "end": 247.32,
   "text": "اما چی؟ چه چیزی باعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.32,
   "end": 250.96,
   "text": "بروز و ظهور این حالات می‌شود در من و شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.96,
   "end": 252.94,
   "text": "یک، حیات ذاتی ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.94,
   "end": 256.12,
   "text": "که چه میزانی از وجود بهره گرفته‌ایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.12,
   "end": 258.76,
   "text": "یعنی صعه و ذیق وجودیمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.76,
   "end": 260.78,
   "text": "صعه و ذیق وجودی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.78,
   "end": 264.88,
   "text": "که اونو بحثمون چون خیلی درباره‌ش صحبت کردیم، خیلی دیگه چیزی نمیگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.88,
   "end": 267.16,
   "text": "دو، به حیات مزاجی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.16,
   "end": 270.12,
   "text": "حیات مزاجی ما به حالات ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.12,
   "end": 273.26,
   "text": "به شدت یعنی که ما چه حالتی داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.26,
   "end": 275.88,
   "text": "انقلابات قلبی‌مون چگونه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.88,
   "end": 281.14,
   "text": "قلب ما در ارتباط با باطن و ظاهر چون برزخ بین ظاهر و باطنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.14,
   "end": 283.1,
   "text": "چگونه؟ چه عکس‌العملی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.1,
   "end": 287.46,
   "text": "چگونه رفتار می‌کند؟ کاملاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.46,
   "end": 291.1,
   "text": "مرتبط با حیات مزاجی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.1,
   "end": 293.56,
   "text": "حالا حیات مزاجی چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.56,
   "end": 296.54,
   "text": "خودش حیات مزاجی رو ابتدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.54,
   "end": 300.54,
   "text": "دو قسمت کنیم. یک قسمتش برمی‌گرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 300.54,
   "end": 305.82,
   "text": "خود اون عناصر اربعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.82,
   "end": 312.24,
   "text": "فرداً. یعنی خود تک‌تک عناصر اربعه خودشون یک مزاجی دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.24,
   "end": 317.44,
   "text": "بعد مرتبه دوم می‌ره امتزاج این عناصر اربعه با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 317.44,
   "end": 320.2,
   "text": "اونم اختلاط این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 320.2,
   "end": 323.8,
   "text": "و امتزاج این‌ها با هم باز یه مزاجی ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.8,
   "end": 329.02,
   "text": "پس یک مزاج اولیه داریم که مربوط به عناصر اولیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.02,
   "end": 331.18,
   "text": "این عناصر اولیه چی‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.18,
   "end": 334.58,
   "text": "که ما وجودمون برگرفته از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.58,
   "end": 337.34,
   "text": "امتزاج این عناصر چهارگانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.34,
   "end": 339.5,
   "text": "چی‌اند؟ آب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.5,
   "end": 342.62,
   "text": "خاک و هوا و آتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.62,
   "end": 347.52,
   "text": "این چهار تا. که این چهار تا هر کدومشون یک مزاجی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.52,
   "end": 351.5,
   "text": "دیگه مشخصه دیگه. آتش مزاجش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.5,
   "end": 354.62,
   "text": "حاره، خار، گرم حالا گرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.62,
   "end": 358.08,
   "text": "آب مزاجش چیه؟ شما بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.08,
   "end": 362.14,
   "text": "رطبه دیگه. «ولا رطب ولا يابس إلا في كتاب مبين».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 362.14,
   "end": 365.62,
   "text": "تو قرآن اومده که بله اینا همش ریشه قرآنی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 365.62,
   "end": 368.66,
   "text": "حکمای ما، عرفای ما، شیخ الرئیس اگر تو کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 368.66,
   "end": 371.9,
   "text": "شفاش اینا رو توضیح میده تو طبش و اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.9,
   "end": 376.58,
   "text": "اینا همش ریشه‌های قرآنی داره. «ولا رطب ولا يابس إلا في كتاب مبين».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.58,
   "end": 380.07,
   "text": "تو دو، تو نماز غفيلين رو می‌خونیم این آیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.07,
   "end": 382.37,
   "text": "رطب، طری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 382.37,
   "end": 386.43,
   "text": "یابس، خشکی. میگن یبوست از اینجا گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.43,
   "end": 389.73,
   "text": "پس آب رطب است یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.73,
   "end": 392.61,
   "text": "رطوبت دارد. آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 392.61,
   "end": 395.11,
   "text": "حار است یعنی حرارت دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.11,
   "end": 397.47,
   "text": "خاک یابس است یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.47,
   "end": 399.95,
   "text": "یبوست دارد یعنی خشکی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 399.95,
   "end": 402.87,
   "text": "هوا برودت دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 402.87,
   "end": 405.27,
   "text": "بار است، خنکی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.27,
   "end": 408.01,
   "text": "باد، باد از هواست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 408.01,
   "end": 410.61,
   "text": "برودت دارد. خب اینا هر کدومشون چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 410.61,
   "end": 413.49,
   "text": "یک خصوصیتی در ما ایجاد می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 413.49,
   "end": 420.51,
   "text": "نسبت به اینکه هر کدوم از این عناصر چهارگانه در ما چه میزان تاثیر داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.51,
   "end": 423.79,
   "text": "از همون نطفه بگیر به این ور دیگه شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 423.79,
   "end": 428.43,
   "text": "ببین مزاج در حقیقت حیات مزاجی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.43,
   "end": 430.45,
   "text": "ربط به نشئہ طبیعت پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 430.45,
   "end": 439.63,
   "text": "حیات اون ذاتی که رفت به عالم علو و یا علو و حضرت حق و اون کانال ارتباطی ما با وجود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 439.63,
   "end": 443.71,
   "text": "وصل به احدیت نظام هستی‌ست که مرتبه قلبو اینجا گم نکنیدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 443.71,
   "end": 446.65,
   "text": "قلب واسط بود، برزخ بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.65,
   "end": 451.17,
   "text": "یعنی شما ذات حضرت حق رو در نظر بگیر اون ذات غنی عن العالمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.17,
   "end": 454.11,
   "text": "اون غیب الغیوب که اسماء عین ذاتشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 454.11,
   "end": 456.43,
   "text": "مرتبه‌ی بعدش می‌شد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.43,
   "end": 459.75,
   "text": "می‌شد، ااه احدیت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.75,
   "end": 461.97,
   "text": "مرتبه حالا باز به اعتبار ذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.97,
   "end": 467.61,
   "text": "احدیت یعنی جایی که یعنی صور علمیه همین اعیان ثابته ماهیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.61,
   "end": 472.51,
   "text": "ما که یکی از اعیان خارجی هستیم، یکی از اشیاء در خارج از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.51,
   "end": 474.63,
   "text": "عرض شود ذات هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 474.63,
   "end": 476.71,
   "text": "صور علمیه‌مون. حالا خلاصه‌شو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 476.71,
   "end": 480.21,
   "text": "علم، علم به ما در ذات حضرت حق بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 480.21,
   "end": 483.41,
   "text": "همه‌ی این کثرات اونجا بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 483.41,
   "end": 485.05,
   "text": "بهش میگن مقام استهلاك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 485.05,
   "end": 487.63,
   "text": "حالا کل شیء انحال کن الا وجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.63,
   "end": 495.19,
   "text": "م-مقام استهلاك و انداماج همه‌ی این کثرات در ذات حضرت حق که مقام احدیت بود، اون مقام روحه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 495.19,
   "end": 497.57,
   "text": "روح. که روح ما متصل به اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 497.57,
   "end": 500.77,
   "text": "برای همین گفتیم هیچ‌وقت هیچ، هیچ شیئی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 500.77,
   "end": 507.63,
   "text": "هیچ کدوم از اشیا که یکیش ما باشیم ارتباط و اتصالش با احدیت حضرت حق قطع شدنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 507.63,
   "end": 511.93,
   "text": "حالا ارتباط با اون احدیت یا روح از طریق کجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 511.93,
   "end": 514.19,
   "text": "که اون متصل می‌شه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 514.19,
   "end": 517.75,
   "text": "نظام ماادون یا حالا این نشئہ طبیعت یا هر کجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 517.75,
   "end": 520.75,
   "text": "اون قلب ماست. ببین می‌شه مرتبه برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 520.75,
   "end": 523.09,
   "text": "که قلب ما دیگه مقام واحدیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 523.09,
   "end": 525.83,
   "text": "خدا شروع می‌شه. واحدیت کثراته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 525.83,
   "end": 530.59,
   "text": "کثرات یعنی ربط بین احدیت و واحدیت این نظام توسط قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 530.59,
   "end": 532.93,
   "text": "اگه قلب نبود اصن تمام بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 532.93,
   "end": 535.79,
   "text": "اصن هیچ اصن نمی‌شه چیزی رو تصور کرد اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 535.79,
   "end": 537.77,
   "text": "قلب خیلی مقامش بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 537.77,
   "end": 540.39,
   "text": "لذا فرمانروا و سلطان وجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.39,
   "end": 544.53,
   "text": "حالا اینجا قلب، اینجا علامه می‌خواد یه جمله‌ای رو به ما تفهیم کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 544.53,
   "end": 551.77,
   "text": "قلب کاملاً حالاتش، تمثلاتش، مناماتش، بیداریش، اینا همه تحت تاثیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 551.77,
   "end": 554.15,
   "text": "هم حیات ذاتی‌ست هم حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 554.15,
   "end": 557.41,
   "text": "مزاجی. دوباره یه مرور کردم که بحثو گم نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 557.41,
   "end": 559.11,
   "text": "حالا داریم تو حیات مزاجی کار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 559.11,
   "end": 561.87,
   "text": "حیات ذاتی که هیچی مربوط به احدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 561.87,
   "end": 564.63,
   "text": "حیات مزاجی از تشکیل نطفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 564.63,
   "end": 569.25,
   "text": "اینکه این نطفه از چه صلبی یعنی چه پدری، بلکه اصلابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.25,
   "end": 572.95,
   "text": "این نطفه از چه رحمی، بلکه چه ارحامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.95,
   "end": 575.49,
   "text": "با هم م-ممزوج شدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 575.49,
   "end": 577.05,
   "text": "و نطفه تشکیل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 577.05,
   "end": 582.81,
   "text": "بعد علقه و مضغه و جنین و عظام واللحم و این‌ها، اینا همه مزاج درشون تشکیل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 582.81,
   "end": 585.79,
   "text": "پس یه مطلب اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 585.79,
   "end": 588.75,
   "text": "تک تک خود این عناصر اربعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 588.75,
   "end": 595.49,
   "text": "این‌ها یه مزاجی دارند که در ما این‌ها ظهور می‌کنند، بروز می‌کنند در طبیعت ما که کاملاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 595.49,
   "end": 597.41,
   "text": "باطن ما با ظاهر عجینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 597.41,
   "end": 599.63,
   "text": "یعنی باطن ما از این مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 599.63,
   "end": 602.01,
   "text": "تاثیر می‌گیره، تأثر می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 602.01,
   "end": 605.05,
   "text": "یکی هم برمی‌گرده به اختلاط این‌ها با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 605.05,
   "end": 608.83,
   "text": "یعنی اینکه این عناصر اربعه بهش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 608.83,
   "end": 611.17,
   "text": "ااه مزاج ثانویه حالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 611.17,
   "end": 616.11,
   "text": "برای چ-- اربعه به چه میزان با هم اختلاط و امتزاج پیدا کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 616.11,
   "end": 619.63,
   "text": "یکی می‌بینی آتش در وجودش، در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 619.63,
   "end": 622.31,
   "text": "مزاجش بیشتر حضور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 622.31,
   "end": 626.31,
   "text": "یعنی حاره، داغه، گرمه، طبعش میگن گرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 626.31,
   "end": 628.19,
   "text": "اینا مثلاً یه، یه خصوصیت‌هایی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 628.19,
   "end": 631.41,
   "text": "حالا اینا رو بررسی می‌کنیم. اجازه بدید عجله نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 631.41,
   "end": 635.97,
   "text": "و مثلاً یکی می‌بینی نه، آب در وجودش بیشتر هست، رطبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 635.97,
   "end": 638.31,
   "text": "یعنی رطوبت داره. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 638.31,
   "end": 642.85,
   "text": "یکی می‌بینی مثلاً خشکی، یابس، یو-یبوست زیاد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 642.85,
   "end": 645.69,
   "text": "حالا یبوستو به معنای اون متداولش نگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 645.69,
   "end": 648.15,
   "text": "بحث کلی مزاج شناسی رو داریم میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 648.15,
   "end": 650.79,
   "text": "یا مثلاً هوا. حالا هر کدوم از این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 650.79,
   "end": 653.27,
   "text": "که شما مثلاً یکی می‌بینی خنکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 653.27,
   "end": 655.99,
   "text": "خن-- اصلاً برودتش زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 655.99,
   "end": 658.63,
   "text": "خنکای وجودش بیشتره تا گرمیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 658.63,
   "end": 663.69,
   "text": "همه‌ی این‌ها شما خوبه اینو بدونید حتی در امر ازدواج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 663.69,
   "end": 670.01,
   "text": "اون‌هایی که نکته سنج بودند از عرفا و علمای ما حتی من خودم از آقای بهجت در این خصوص شنیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 670.01,
   "end": 674.57,
   "text": "که همسرت رو توجه به این مزاجش داشته باش و بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 674.57,
   "end": 679.35,
   "text": "یعنی اگر مثلاً اون مزاجش یه جوری باشه مثلاً خنک باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 679.35,
   "end": 682.03,
   "text": "تو مثلاً گرم باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 682.03,
   "end": 684.91,
   "text": "اینا مشکلات ایجاد می‌شه بینشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 684.91,
   "end": 687.47,
   "text": "یعنی مزاج‌ها باید با همدیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 687.47,
   "end": 689.53,
   "text": "وقتی تل-- دوباره یه امتزاجه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 689.53,
   "end": 692.07,
   "text": "بعد بچه‌تون دوباره امتزاج مزاج در مزاج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 692.07,
   "end": 695.27,
   "text": "یه چیز عجیب غریبی در میاد. این خودش یک علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 695.27,
   "end": 698.17,
   "text": "متأسفانه ما اصلا توجه به این چیزا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 698.17,
   "end": 703.13,
   "text": "اجازه بدید از رو خود کتاب براتون فرمایش upstate علامه حسن زاده رو ب-بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 703.13,
   "end": 708.07,
   "text": "شما خ-- \"در کتب و رسائل ارباب سیر و سلوک مثل تهف ال--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 708.07,
   "end": 713.11,
   "text": "تهفت الملوک سید بحر العلوم\" که سینه به سینه امام عسک داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 713.11,
   "end": 714.75,
   "text": "علامه میگه اونجا هم اینو فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 714.75,
   "end": 719.25,
   "text": "\"و غیرها سنوح و احوالی از خودشان به اسناء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 719.25,
   "end": 722.15,
   "text": "سیر و سلوک خبر می‌دهند.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 722.15,
   "end": 725.63,
   "text": "یعنی میگن که از سیر و سلوک که وقتی میخوان خبر بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 725.63,
   "end": 730.91,
   "text": "میگن که چگونه‌ست این سیر و سلوک که الان ما هم داریم به سمت حضرت حق حرکت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 730.91,
   "end": 734.57,
   "text": "چرا انواع وجود داره؟ چرا طورهای مختلف وجود داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 734.57,
   "end": 737.37,
   "text": "چرا یکی یه حرفو یه جور می‌گیره، یکی یه جور دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 737.37,
   "end": 739.49,
   "text": "چرا یه کسی دیر گر می‌گیره، یکی زود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 739.49,
   "end": 741.95,
   "text": "چرا یه کسی یک حرفه، یک حرفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 741.95,
   "end": 746.73,
   "text": "یک شعره، یک روضه‌ست، یکی به شدت تاثیر می‌گیره، یکی کمتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 746.73,
   "end": 749.89,
   "text": "یکی اینو برداشت می‌کنه، یکی یه چیز دیگه برداشت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 749.89,
   "end": 752.67,
   "text": "یکی این خوابو می‌بینه، یکی اون خوابو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 752.67,
   "end": 757.17,
   "text": "در تمثلات اگر پرده بره کنار هرکسی یه جور تمثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 757.17,
   "end": 761.73,
   "text": "براش رخ میده. چرا؟ می‌فرماید مثلاً در همین تهفه فرماید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 761.73,
   "end": 764.31,
   "text": "کی فرماید؟ سید بحر العلوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 764.31,
   "end": 768.33,
   "text": "می‌فرماید و از جمله آثار به صدا آمدن قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 768.33,
   "end": 771.65,
   "text": "میگه آثار، آثار، آثار اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 771.65,
   "end": 776.39,
   "text": "این حالا بعضیا در سیر و سلوک حرکت می‌کنند، این حرکتشون درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 776.39,
   "end": 779.31,
   "text": "بعضیا با صدا، صدای قلبو شنیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 779.31,
   "end": 782.89,
   "text": "میخواد بفهمه که آقا یعنی انقدر تاثیر داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 782.89,
   "end": 789.29,
   "text": "بعد میگه که این چه ربطی به مزاج داره که بعضیا تو سیر و سلوکشون حتی تو نمازشون صدای قلبشونو می‌شنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 789.29,
   "end": 792.95,
   "text": "که قبلاً وعده داده بودیم اینو براتون بگیم مستندش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 792.95,
   "end": 800.37,
   "text": "و در مبادی آوازی مانند آواز کبوتر و قمری از او سا-- ظاهر شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 800.37,
   "end": 805.11,
   "text": "یعنی یه صدایی مثل آواز کبوتر و قمری از تو سینه‌شون می‌شنوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 805.11,
   "end": 811.89,
   "text": "اهل سیر و سلوک. و بعد از آن صدایی چون انداختن مهره در تاس که در آن پی-پیچد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 811.89,
   "end": 814.05,
   "text": "مسموع شود به صداش می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 814.05,
   "end": 818.99,
   "text": "حالا بعد ادامه داره مطلب. و همچنین دیگران حکایاتی از خود دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 818.99,
   "end": 822.71,
   "text": "غرضم، حالا علامه میگه غرضم از م-- بیان این چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 822.71,
   "end": 825.25,
   "text": "این است که آگاهی بدین گونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 825.25,
   "end": 831.19,
   "text": "احوال رهزنت نشود که اوه اوه اه این فلانی مثلا این صدا رو شنید، اون این صدا رو شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 831.19,
   "end": 834.59,
   "text": "چرا من نشنیدم؟ چرا صدایی که من شنیدم متفاوت بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 834.59,
   "end": 838.77,
   "text": "که باید به همان کیفیت برای تو هم پیش بیاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 838.77,
   "end": 842.69,
   "text": "فکر نکنی باید عین همونی که برای فلانی پیش اومد برای تو پیش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 842.69,
   "end": 845.81,
   "text": "چه اینکه برای هر شخص، اینجا رو گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 845.81,
   "end": 851.61,
   "text": "تموم شد بحث. چه اینکه برای هر شخص به وفق ابتزای استعداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 851.61,
   "end": 855.09,
   "text": "و ترکیب مزاج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 855.09,
   "end": 857.57,
   "text": "ابتزای استعداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 857.57,
   "end": 862.47,
   "text": "و ترکیب مزاج و قابلیت او در اثنای سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 862.47,
   "end": 864.77,
   "text": "وارداتی رو می‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 864.77,
   "end": 868.39,
   "text": "همونطور که چهره‌ها و لهجه‌ها مختلف‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 868.39,
   "end": 870.07,
   "text": "استعدادها نیز مختلف‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 870.07,
   "end": 873.17,
   "text": "چطور چهره‌ها هرکی یه شکله، لهجه‌ها همه یه شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 873.17,
   "end": 876.81,
   "text": "لذا استعدادها و مزاج‌ها متفاوت‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 876.81,
   "end": 880.09,
   "text": "و مطابق اختلاف استعداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 880.09,
   "end": 882.89,
   "text": "واردات قلبی نیز، واردات چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 882.89,
   "end": 884.87,
   "text": "قلبی نیز گوناگون‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 884.87,
   "end": 888.63,
   "text": "اینو توجه داشته باشید. خیلی‌ها به این توجه نمی‌کنند و خراب می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 888.63,
   "end": 893.75,
   "text": "و ناامید می‌شن. میگن چرا فلانی زود مثلا خواب امام زمان دید در تمثلاتش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 893.75,
   "end": 896.43,
   "text": "ولیعصر رو دید، من ندیدم. چرا من همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 896.43,
   "end": 898.41,
   "text": "خواب چرت و پرت می‌بینم، اون--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 898.41,
   "end": 900.45,
   "text": "اینا همش به اون مزاج‌ها ربط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 900.45,
   "end": 903.77,
   "text": "فکر نکنید به حیات ذاتی‌تون مشکلی وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 903.77,
   "end": 907.13,
   "text": "پس اگر این بقیه کلام علامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 907.13,
   "end": 909.11,
   "text": "واردات قلبی نیز گوناگون‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 909.11,
   "end": 911.67,
   "text": "پس اگر پشت به این ده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 911.67,
   "end": 914.53,
   "text": "با شماست، اگر پشت به این ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 914.53,
   "end": 916.79,
   "text": "و رو به شهر آورده‌ای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 916.79,
   "end": 920.33,
   "text": "این نکته حلق گوشت باد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 920.33,
   "end": 922.95,
   "text": "و فراموشت مباد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 922.95,
   "end": 927.87,
   "text": "چی؟ اینکه این ترکیب مزاج‌هاست که باعث می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 927.87,
   "end": 932.85,
   "text": "تو دیرتر بجوشی، اون زودتر بجوشه، این زودتر ببینه، اون دیرتر ببینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 932.85,
   "end": 936.83,
   "text": "این خواباش با اون متفاوت باشه، تمثلات، حالات قلبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 936.83,
   "end": 939.69,
   "text": "حالات روحی. اینا همه کاملاً متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 939.69,
   "end": 943.29,
   "text": "ببینید جایگاه مزاج چقدر مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 943.29,
   "end": 946.65,
   "text": "خیلی‌ها بریدن به خاطر اینکه مزاجشون رو نشناختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 946.65,
   "end": 951.49,
   "text": "حالا بعد صحبت می‌کنیم که ما چه باید بکنیم برای اینکه تمثلات قوی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 951.49,
   "end": 954.59,
   "text": "حالا یکی ضعیفه. یا یکی حرفو خیلی‌ها حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 954.59,
   "end": 956.75,
   "text": "ما جاهای مختلفی می‌ریم صحبت می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 956.75,
   "end": 959.59,
   "text": "می‌بینیم یه مطلب گفتیم ده جور برداشت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 959.59,
   "end": 962.25,
   "text": "چرا؟ چون ده جور مزاج بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 962.25,
   "end": 964.37,
   "text": "اینا کاملاً مرتبط‌اند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 964.37,
   "end": 966.59,
   "text": "حقایق سیر و سلوکی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 966.59,
   "end": 968.77,
   "text": "برای همین آدما با هم متفاوت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 968.77,
   "end": 972.25,
   "text": "حالا آیا راهی هست که ما بتوانیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 972.25,
   "end": 982.91,
   "text": "مزاجمون رو معتدل کنیم که اگر کسی مزاجش هرچی به سمت اعتدال برود تمثلات و منامیاتش، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 982.91,
   "end": 988.77,
   "text": "خواب‌هاش، حالا پر-- تمثلات این نیست که شما بیداری یهو پرده میره کنار حقیقتو می‌بینی یا چیزی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 988.77,
   "end": 993.05,
   "text": "یا شنودت یا شهودت که به، قبلاً بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 993.05,
   "end": 995.69,
   "text": "اینا زلال بشه، غبار نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 995.69,
   "end": 998.37,
   "text": "خیلی موقع‌ها خواب خوب دیدی غبار داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 998.37,
   "end": 1000.79,
   "text": "یه مهی تو خوابت بوده نتونستی ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1000.79,
   "end": 1002.71,
   "text": "تمثلت قوی نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1002.71,
   "end": 1004.81,
   "text": "چرا؟ چون مزاجت مشکل داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1004.81,
   "end": 1007.17,
   "text": "آیا راهی هست اینا درست بشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1007.17,
   "end": 1011.37,
   "text": "بله. راهی هست که مزاج ما به سمت اعتدال برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1011.37,
   "end": 1013.65,
   "text": "بحث رو دنبال کنید انشاالله متوجه می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1013.65,
   "end": 1016.65,
   "text": "عاقبتمون انشاالله ختم به خیر بشود به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1016.65,
   "end": 1018.79,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1018.79,
   "end": 1024.39,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}