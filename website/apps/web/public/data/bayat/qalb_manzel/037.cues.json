 "chapters": [
  {
   "index": 0,
   "title": "## اقتدا به گمان رکعت اوّل در حالی که امام در رکعت سوم است",
   "start": 3.0,
   "end": 162.82
  },
  {
   "index": 1,
   "title": "## تودیع و معارفه در دنیا و قیامت",
   "start": 162.82,
   "end": 214.94
  },
  {
   "index": 2,
   "title": "## آیهٔ سی‌وهفت سورهٔ قاف؛ ذکر برای صاحب قلب",
   "start": 214.94,
   "end": 319.9
  },
  {
   "index": 3,
   "title": "## وساطت رزق و زنده بودن قلب",
   "start": 319.9,
   "end": 426.84
  },
  {
   "index": 4,
   "title": "## مدیر قلم‌به‌دست و سنگینی بار وساطت",
   "start": 426.84,
   "end": 619.58
  },
  {
   "index": 5,
   "title": "## دست‌بسته آمدن مسئولان در محشر",
   "start": 619.58,
   "end": 640.32
  },
  {
   "index": 6,
   "title": "## ألقى السمع و هو شهید؛ شنود قلب",
   "start": 640.32,
   "end": 955.54
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.0,
   "end": 7.02,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.02,
   "end": 10.86,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.86,
   "end": 14.96,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.96,
   "end": 18.72,
   "text": "اگر کسی گمان کنه که امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.72,
   "end": 23.06,
   "text": "امام جماعت در رکعت اوله بیاد اقتدا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.06,
   "end": 25.94,
   "text": "و حمد نخونه، حمد سوره نخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.94,
   "end": 30.84,
   "text": "فکر می‌کنه امام در رکعت اوله در حالی که امام در رکعت سومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.84,
   "end": 34.16,
   "text": "امام تسبیحات اربعه داره میگه آهسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.16,
   "end": 37.76,
   "text": "و مثلاً نماز ظهر و عصرم هست که امام آهسته هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.76,
   "end": 40.2,
   "text": "حتی حمد سوره‌شون می‌خونه. گمان کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.2,
   "end": 44.06,
   "text": "رکعت اول امامه، حمد سوره نخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.06,
   "end": 46.82,
   "text": "این تکلیفش چی می‌شه وضعیت نمازش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.82,
   "end": 53.8,
   "text": "رهبر عزیزمون فرمودن که اگر قبل از اینکه به رکوع برود متوجه بشود که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.8,
   "end": 56.46,
   "text": "رکعت امام اشتباه کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.46,
   "end": 60.76,
   "text": "واجبه که حداقل حمدش رو قرائت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.76,
   "end": 63.28,
   "text": "بعد بره به رکوع امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.28,
   "end": 66.08,
   "text": "اما اگر رفت به رکوع متوجه شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.08,
   "end": 74.76,
   "text": "که عجب! فکر می‌کرد رکعت اوله در حالی که رکعت سوم بوده، یعنی در رکوع یا بعد از رکوع متوجه شد که امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.76,
   "end": 78.92,
   "text": "رکعت اول نبوده و این بابا حمد سوره‌شو نخونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.92,
   "end": 81.42,
   "text": "اینجا چه باید کرد؟ رهبر اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.42,
   "end": 86.82,
   "text": "فرمودن که اشکالی نداره، چیزی بر او واجب نیست، نمازش هم صحیحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.82,
   "end": 89.28,
   "text": "اما احتیاط کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.28,
   "end": 93.8,
   "text": "بعد از اینکه نمازش تموم شد دو تا سجده صف به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.8,
   "end": 96.2,
   "text": "ترک این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.2,
   "end": 99.6,
   "text": "ترک سهوی ذکر قرائت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.6,
   "end": 104.8,
   "text": "انجام بده. ولی چون احتیاط رو اینجا بعد از فتوا آوردن می‌شه چه احتیاطی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.8,
   "end": 106.8,
   "text": "احتیاطی مستحب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.8,
   "end": 113.86,
   "text": "یعنی اینکه می‌تونه دوست داشت انجام، دوست داشت احتیاطو انجام میده، دوست نداشت خود اصل فتوا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.86,
   "end": 124.7,
   "text": "اگر آها اگر حمد و سوره، حمدو که حداقل باید بخونه اگه قبل رکوع بود خب، دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.7,
   "end": 127.54,
   "text": "سوره دید نمی‌رسه سوره رو که نباید بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.54,
   "end": 129.42,
   "text": "اما حمدو خوند دید به رکوع نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.42,
   "end": 132.38,
   "text": "واجبه که حمدو بخونه و لو به رکوع نرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.38,
   "end": 135.64,
   "text": "حالا اگر بالاخره نماز جماعتش چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.64,
   "end": 139.02,
   "text": "به رکوع نرسید. اگر دو تا رکنه پشت سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.02,
   "end": 144.54,
   "text": "هم رو نرسه از جماعت فارغ می‌شه، خارج می‌شه و باید دیگه نیتش فراده باید بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.54,
   "end": 150.64,
   "text": "اگه دو تا رکنه پشت سر هم، یعنی رکوع رو نرسید سجود رو هم نرسه، نه یک سجده، دو تا سجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.64,
   "end": 152.74,
   "text": "جانم. دو تا سجده می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.74,
   "end": 155.16,
   "text": "بله دو تا سجده یک رکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.16,
   "end": 159.66,
   "text": "اگر دو تا سجده رو با هم با رکوع این دو تا رو با هم نرسید دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.66,
   "end": 164.36,
   "text": "باید نیت فراده کنه. به فضل الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.36,
   "end": 168.0,
   "text": "دیگه شیب بحث قلب منزل ماست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.0,
   "end": 170.64,
   "text": "خب دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.64,
   "end": 173.06,
   "text": "یه تودیع و معارفه‌ای داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.06,
   "end": 175.54,
   "text": "قیامت یه تودیع و معارفه‌ای داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.54,
   "end": 179.26,
   "text": "هر کدوم خصوصیات خاص خودش رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.26,
   "end": 183.52,
   "text": "و البته اینجا ما ذیل اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.52,
   "end": 187.2,
   "text": "اوضح حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.2,
   "end": 189.88,
   "text": "هیچکس از باطن دیگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.88,
   "end": 191.84,
   "text": "آشکار، براش آشکار نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.84,
   "end": 195.9,
   "text": "مگر حالا اوهدی از اولیاء الله عده قلیلی به استثناء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 195.9,
   "end": 198.5,
   "text": "حالا خدا سلام میدونه از بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.5,
   "end": 205.4,
   "text": "که رد و فتح امور خلق رو دارن مثل اون دستجات حالا ابدال و اوتاد و اینا که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.4,
   "end": 209.76,
   "text": "ولی اون ور تودیع و معارفه‌های اون ور معلوم می‌شه که باطن‌های يوم تبد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.76,
   "end": 214.94,
   "text": "تبل السرائر که رخ داد باطن‌ها آشکار شد معلوم می‌شه چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.94,
   "end": 222.26,
   "text": "اجازه بفرمایید که آیه سی و هفت سوره قاف رو با همدیگه قرائت کنیم ببینیم چه نکته‌ای درش خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.26,
   "end": 225.4,
   "text": "ان فی والک. این والک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.4,
   "end": 232.82,
   "text": "برمی‌گرده به آیات قبلی که مربوط به پیشینیان است که معذب شدند، دچار عذاب شدند، گرفتار شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.82,
   "end": 238.98,
   "text": "میگه این، اینچه که ما به شما گفتیم از پیشینیان و هلاکت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.98,
   "end": 241.88,
   "text": "اقوام قبلی لذكر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.88,
   "end": 244.04,
   "text": "فقط یادآوری برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.04,
   "end": 246.44,
   "text": "عده خاصیه. کیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.44,
   "end": 249.38,
   "text": "لمن كان له قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.38,
   "end": 251.98,
   "text": "برای کسیه که قلب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.98,
   "end": 255.6,
   "text": "خب سؤال، مگه همه مقام قلب رو ندارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.6,
   "end": 258.32,
   "text": "بله مقام قلب رو همه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.32,
   "end": 260.76,
   "text": "اصلاً چه در سیر نزول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.76,
   "end": 264.18,
   "text": "چه قوس نزول، چه در قوس صعود بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.18,
   "end": 267.06,
   "text": "همه این مرتبه وجودی رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.06,
   "end": 270.5,
   "text": "پس چرا میگه، اینجا میگه اینو فقط اونایی که قلب دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.5,
   "end": 273.8,
   "text": "پیداست که یه عده از قلبشون غافلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.8,
   "end": 279.62,
   "text": "یعنی از قلبشون از مقام قلبشون که محل نزول فیض هست غافلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.62,
   "end": 283.6,
   "text": "و خیلی این خطرناکه غفلت از این محل نزول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.6,
   "end": 285.92,
   "text": "چون گفتیم واسطه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.92,
   "end": 288.7,
   "text": "برزخه بین باطن و ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.7,
   "end": 290.94,
   "text": "اگر غافل از این بشی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.94,
   "end": 293.86,
   "text": "در حقیقت عالم ظاهر تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.86,
   "end": 300.84,
   "text": "از عالم باطن تو غافل می‌شه و دستش خالی می‌شه، دستش جدا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.84,
   "end": 303.26,
   "text": "که اگر چنانچه ما این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.26,
   "end": 309.58,
   "text": "بلا سرمون بیاد دیگه بی‌خبر از باطن عالم می‌شیم و موت ما موت خطرناکی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.58,
   "end": 312.18,
   "text": "چون موت یعنی عبور از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 312.18,
   "end": 315.92,
   "text": "بحثش خیلی گذشت دیگه. و هیچ خبری از باطن نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.92,
   "end": 319.82,
   "text": "چرا؟ چون مقام قلب رو درک نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 319.82,
   "end": 322.88,
   "text": "و اگر کسی این رو بداند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.88,
   "end": 326.52,
   "text": "می‌ترسد از اینکه امام بشود، جلودار بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 326.52,
   "end": 329.74,
   "text": "نه اینکه می‌ترسد یعنی نشود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 329.74,
   "end": 332.22,
   "text": "با لوازم و اسبابش می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.22,
   "end": 335.4,
   "text": "می‌ترسد مثلا یه امام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.4,
   "end": 339.48,
   "text": "قلبش هیچ خبری از باطن نداشته باشه بیاد وایسته جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.48,
   "end": 341.8,
   "text": "آیا الان واسطه‌ی رزق شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.8,
   "end": 344.4,
   "text": "مگر قلب رزق...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 344.4,
   "end": 348.5,
   "text": "عرض نکردیم که رزق خدا بر اونجا نازل می‌شه، محل نزوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.5,
   "end": 353.58,
   "text": "خب این الان واسطه شده. یه مسئول، یه پدر، پدر یه خانواده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.58,
   "end": 356.12,
   "text": "می‌شه واسطه‌ی رزق اون خونواده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 356.12,
   "end": 362.94,
   "text": "شوخی نیست اینا. چرا امام عصر صلوات الله علیه به اون رفیقش از اولیاء خدا بود گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 362.94,
   "end": 365.18,
   "text": "فرمود که برو از اینجا خرید کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.18,
   "end": 367.08,
   "text": "یه مغازه خاصی رو مشخص کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 367.08,
   "end": 371.16,
   "text": "خب این همه بقالی و چقالی و اینا چرا آقا باید بری از اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 371.16,
   "end": 374.66,
   "text": "چون اون معلومه قلبش زنده است، خبر داره، یعنی ه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 374.66,
   "end": 378.18,
   "text": "غافل نیست. این وساطت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.18,
   "end": 383.82,
   "text": "توجه داره که اگر توجه نداشته باشه می‌شه غفلت و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 383.82,
   "end": 387.72,
   "text": "رزقی که از دست این بابا می‌گیری دیگه طیب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 387.72,
   "end": 390.62,
   "text": "اینا، اینا خیلی مهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 390.62,
   "end": 394.08,
   "text": "حالا حدیث داریم که رزق طیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 394.08,
   "end": 398.32,
   "text": "با رزق ح-- رزق طیب از حلال هم بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 398.32,
   "end": 402.04,
   "text": "شما پولو از راه حلال درآوردی خرج هم کردی و خب حلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 402.04,
   "end": 409.78,
   "text": "اما معلوم نیست طیب باشه. مثلاً شما پول حلال رو ببر به یه آدمی که بی‌نمازه از یه مغازه‌ای که بی‌نمازه خرید کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 409.78,
   "end": 412.44,
   "text": "اون خرید تو طیب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 412.44,
   "end": 416.8,
   "text": "حلال هست اما چون از دست بی‌نماز گرفتی طیب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 416.8,
   "end": 421.32,
   "text": "طیب، رزق طیب مخصوص اولیا و انبیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 421.32,
   "end": 426.54,
   "text": "حالا امام عسکری به اون رفیقش می‌گه از اینجا پیداست یه خبراییه ما بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 426.54,
   "end": 431.84,
   "text": "حالا مدیری که بیاد، مدیری که بیاد دست به قلم بشه وساطت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.84,
   "end": 436.62,
   "text": "رزق یه عده‌ای بشه. این توديع معارفه‌ها خیلی بار سنگینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.62,
   "end": 441.2,
   "text": "یعنی از طرف باید عرق بریزه همین طوری از گرفتن این بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.2,
   "end": 443.52,
   "text": "حالا صدای ما که به گوش فلک هم نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 443.52,
   "end": 448.46,
   "text": "چی بگیم؟ به اهلش که برسه نبای-- نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 448.46,
   "end": 452.28,
   "text": "اتفاقاً ما اینطوری حرف می‌زنیم پس گردنی هم می‌خوریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.28,
   "end": 455.66,
   "text": "و تو همین رسانه من دارم این حرفا رو می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.66,
   "end": 458.08,
   "text": "خدا رحمت کنه شهید حججی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.08,
   "end": 460.06,
   "text": "ما پدر مادر ایشون رو دعوت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 460.06,
   "end": 463.44,
   "text": "خب یکی از برنامه ها اسم نبرم، یکی از برنامه‌های خیلی مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 463.44,
   "end": 467.8,
   "text": "شبکه های مهم سیما. ایشون رو می‌خواست پدر مادر شهید رو دعوت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.8,
   "end": 469.36,
   "text": "اینا خب نمی‌اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 469.36,
   "end": 472.8,
   "text": "مثل خیلیا نیستن که تا بگن آقا بفرمایید تلویزیون به به آب دهنشون راه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 472.8,
   "end": 475.22,
   "text": "اینا عزت نفس دارن. نمی‌اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 475.22,
   "end": 481.52,
   "text": "ما حالا به جهت اون نوکری که اونجا برای شهیدشون چندین سال منبر می‌رفتیم محرم‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 481.52,
   "end": 484.4,
   "text": "ازشون خواهش کردیم دعوت ما رو پذیرفتن، اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 484.4,
   "end": 489.3,
   "text": "قرار بود که من هم به عنوان کارشناس تو مج-- تو اون برنامه باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 489.3,
   "end": 492.74,
   "text": "من خودم قبول نکردم. اونا نمی‌دونستن من قبول نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 492.74,
   "end": 496.54,
   "text": "یکی از رفیقامون حالا اسم نمیارم چون می‌ره تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 496.54,
   "end": 499.1,
   "text": "حالا کانال و اینا. یکی از دوستانمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 499.1,
   "end": 504.62,
   "text": "که میاد اینجا بعضی موقع‌ها نماز، ایشونو به عنوان کارشناس معرفی کردیم و پذیرفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.62,
   "end": 510.72,
   "text": "بعد دیدیم که اون‌ها مسئولین اون برنامه زنگ زده بودن و خلاصه آمار ما رو از مدیر می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 510.72,
   "end": 512.56,
   "text": "مثلاً مدیر قسمتی که ما بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 512.56,
   "end": 516.62,
   "text": "این زبان تندی داره مطلقاً به درد رسانه نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 516.62,
   "end": 519.04,
   "text": "به درد برنامه زنده اونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.04,
   "end": 521.34,
   "text": "اصلاً حالا اینا بی‌خبر که من اصلاً نمی‌خواستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 521.34,
   "end": 524.26,
   "text": "حالا کسی دیگه رو هماهنگ کرده بودیم بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 524.26,
   "end": 527.82,
   "text": "توجه کردید؟ که بعداً مادر شهید، پدر شهید به من گله کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 527.82,
   "end": 529.38,
   "text": "گفتن چرا خود شما نیومدین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 529.38,
   "end": 532.8,
   "text": "ما دوست داشتیم شما بیای از خاطرات شهید بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 532.8,
   "end": 536.04,
   "text": "ببینید رسانه ما که به جا-- به قول رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 536.04,
   "end": 538.4,
   "text": "خط مقدم جبهه فرهنگی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 538.4,
   "end": 542.34,
   "text": "مگه ما چی می‌گیم؟ مگه ما جز از آیات قرآن چیز دیگه می‌گیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 542.34,
   "end": 544.76,
   "text": "مگه ما اسمی از مدیری میاریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 544.76,
   "end": 551.1,
   "text": "فقط مدیریت اسلامی رو میاریم می‌ذاریم رو میز که این شیوه درست مدیریته مثل الان ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 551.1,
   "end": 553.3,
   "text": "ما به کسی جسارت نمی‌کنیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 553.3,
   "end": 556.44,
   "text": "اگر شما ریگی به کفشت نیست چرا ناراحت می‌شی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 556.44,
   "end": 560.6,
   "text": "و اگر نیست انشاالله باید استقبالم بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 560.6,
   "end": 565.42,
   "text": "حالا به درددل افتادیم. ببخشید از بحث یه لحظه خارج می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 565.42,
   "end": 572.72,
   "text": "خلاصه بحث چی بود اینجا؟ اینکه اون مدیری که میاد قلم به دست می‌شه و واسطه رزق می‌شه، اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.72,
   "end": 577.4,
   "text": "این توجه نداشته باشه که این رزق رو از خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 577.4,
   "end": 579.36,
   "text": "این کانال رزقه، کانال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 579.36,
   "end": 586.34,
   "text": "فیضه داره می‌گیره به زیردست می‌رسه، این توجه رو نداشته باشه پولی که تو از مدیرت می‌گیری طیب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 586.34,
   "end": 590.72,
   "text": "خیلی این بحث‌ها مهمه. قلب خیلی مقامش مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 590.72,
   "end": 597.16,
   "text": "یعنی اگه من بخوام به فضل الهی با فرمایشاتی که بزرگان ما ذیل بحث قلب داشتن حرف بزنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 597.16,
   "end": 599.94,
   "text": "مثل بحث مزاج می‌شه. هی بریم توش دیگه رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 599.94,
   "end": 601.9,
   "text": "اصلاً خودمو کشوندن بیرون دیگه اوه، اوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 601.9,
   "end": 605.14,
   "text": "باید بریم دیگه تا آخرش. همه هم تشنه بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 605.14,
   "end": 607.82,
   "text": "فکر می‌کنم هفت، هشت جلسه پیرامون مزاج حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 607.82,
   "end": 611.48,
   "text": "دوستانی که پیگیر بودن تو کانال گذاشتن بچه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 611.48,
   "end": 613.12,
   "text": "و فرار می‌کنیم از مباحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 613.12,
   "end": 617.18,
   "text": "انقدر که عمیقه. عمیقه واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 617.18,
   "end": 621.98,
   "text": "و اگر آدم دستش به جایی بند نباشه، خود من امثال من اینجا خفه می‌شیم تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 621.98,
   "end": 624.96,
   "text": "بحر موّاج معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 624.96,
   "end": 627.92,
   "text": "چرا؟ چون تو دنیا داره مطرح می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 627.92,
   "end": 633.92,
   "text": "متوجه... \"از دنیا بحر عمیق قد غرق فیها خلق کثیر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 633.92,
   "end": 636.7,
   "text": "چقدر آدم‌ها غرق شدن تو این دریا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 636.7,
   "end": 640.32,
   "text": "چرا؟ چون حواسشون به قلبشون نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 640.32,
   "end": 647.46,
   "text": "حالا اونجا تو توديع معارفه اونجا اون مدیرایی موفق‌اند چون حدیث هم داریم کسایی که هر مسئولیتی داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 647.46,
   "end": 649.84,
   "text": "اول با دست بسته وارد محشر می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 649.84,
   "end": 652.4,
   "text": "رهبر عزیزمون هم توی درس خارجش یه روز اینو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 652.4,
   "end": 654.44,
   "text": "منم اینجا تو جمع مدیرایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 654.44,
   "end": 656.5,
   "text": "همه مدیرای استانی بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 656.5,
   "end": 659.22,
   "text": "اصلاً گذاشتم-- همینو گذاشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 659.22,
   "end": 663.4,
   "text": "قشنگ وسط بحث و به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 663.4,
   "end": 666.72,
   "text": "این رو مورد بحث قرار دادیم و برای بعضیا هم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 666.72,
   "end": 671.04,
   "text": "بد اومد این موضوع. ولی نظر رهبر رو گفتیم، نظر علم الهدای رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 671.04,
   "end": 673.9,
   "text": "دست بسته پیغمبر فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 673.9,
   "end": 680.14,
   "text": "که اصلاً صرف اینکه مدیریت داشته، مسئولیت داشته، مسئول بر وزن مفعول مورد سؤال واقع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 680.14,
   "end": 685.64,
   "text": "و ازش سؤال می‌کنن قیامت. اگر تونست جواب درست بده دستشو باز می‌کنن تازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 685.64,
   "end": 689.88,
   "text": "یعنی با دست-- حدیثه. همه م-مسئولین با دست بسته میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 689.88,
   "end": 691.62,
   "text": "حالا این دست بسته باید تعویل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 691.62,
   "end": 693.94,
   "text": "یعنی چی؟ یعنی طناب بستن؟ نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 693.94,
   "end": 697.8,
   "text": "یعنی اینکه تو یه زیقی، تو یه فشاری، تو یه فشار روانی میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 697.8,
   "end": 701.16,
   "text": "مسئولیت سنگینه. شوخیه مگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 701.16,
   "end": 705.0,
   "text": "که اگر از مقام قلبش غافل باشه در زیغ و فشار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 705.0,
   "end": 708.86,
   "text": "شدیدی قرار می‌گیره. حالا این آیه رو من نخوندم که اینا رو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 708.86,
   "end": 711.64,
   "text": "اینا جوشید تو جمع شما یهو جوشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 711.64,
   "end": 713.18,
   "text": "اینو بیشتر به این خاطر خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 713.18,
   "end": 718.88,
   "text": "بقیشو دقت کنید. برای چه کسی ذکر پیشینیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 718.88,
   "end": 722.28,
   "text": "کارسازه؟ ذکر آگاهی بخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 722.28,
   "end": 724.14,
   "text": "لذكر است؟ برای چه کسایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 724.14,
   "end": 727.26,
   "text": "\"لمن کان له قلب\". برای کسایی که قلب دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 727.26,
   "end": 729.24,
   "text": "أو یه دسته دیگه هم هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 729.24,
   "end": 731.9,
   "text": "أو ألقى السمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 731.9,
   "end": 735.26,
   "text": "\"وهو الشهید\". این کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 735.26,
   "end": 738.2,
   "text": "تلقی شنوایی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 738.2,
   "end": 742.56,
   "text": "یعنی گوش قلبشون، اون شنود که بحث کردیم یکی دو جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 742.56,
   "end": 745.42,
   "text": "بحث شنود و فرقش با شهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 745.42,
   "end": 747.48,
   "text": "که خود اون جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 747.48,
   "end": 752.08,
   "text": "عرض کردم حداقل اون بحث شنود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 752.08,
   "end": 760.6,
   "text": "شهود و اینا گفتیم چ-- حداقل یه سی روزی سی جلسه واقعاً کم کمش بگیم فقط کلیات رو بگیم بحث می‌خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 760.6,
   "end": 763.5,
   "text": "شنود غمایی اینجا الان داره مشخص میشه تو این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 763.5,
   "end": 769.06,
   "text": "یا کسی که تلقی قوای سامعه داره یعنی گوش قلبش بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 769.06,
   "end": 775.48,
   "text": "توجه کردید؟ اینجا نشون میده چه کسانی غافل از مقام قلب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 775.48,
   "end": 778.28,
   "text": "کسایی که گوش قلبشون بسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 778.28,
   "end": 780.52,
   "text": "یعنی کسایی که گوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 780.52,
   "end": 782.62,
   "text": "به حرف نمی‌دهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 782.62,
   "end": 785.46,
   "text": "حوصله‌ی حرف شنیدن ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 785.46,
   "end": 789.24,
   "text": "این تذکر جانانه‌ی امروز آیه‌ی سی و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 789.24,
   "end": 792.98,
   "text": "سوره قاف به من و شماست که این سوره، سوره عزّت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 792.98,
   "end": 797.38,
   "text": "اگر کسی دنبال عزّت دنیا و آخرته فرمودن اینو هر روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 797.38,
   "end": 804.02,
   "text": "مداومت کنه مخصوصاً داخل منزلش بخونه، منزل عزیز و کریم می‌شه، با کرامت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 804.02,
   "end": 807.06,
   "text": "که این سوره حالا هدیه، هدیه بدیم عیب نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 807.06,
   "end": 811.22,
   "text": "این سوره با سوره ذاریات که سوره رزقه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 811.22,
   "end": 816.18,
   "text": "با سوره واقعه که به قول حضرت علامه حسن زاده علیه الرحمه سوره الغناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 816.18,
   "end": 820.78,
   "text": "این سه تا سوره پشت سر هم دیگه تمومه یعنی می‌ترکونه برات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 820.78,
   "end": 823.14,
   "text": "دنیا و آخرتتو می‌بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 823.14,
   "end": 827.94,
   "text": "خدا کفیلت می‌شه. هرکی هر روز مداومت کنه این سه تا سوره تقریباً هم پشت سرهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 827.94,
   "end": 832.24,
   "text": "اول قافه بعد ذاریاته بعد سه چهار تا سوره واقعه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 832.24,
   "end": 834.82,
   "text": "عجیبن این سه تا. مشکل رزقت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 834.82,
   "end": 838.42,
   "text": "مشکل آبروی کسی حالا، حالا بحث این چنینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 838.42,
   "end": 840.56,
   "text": "قرآنه دیگه. قرآن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 840.56,
   "end": 842.62,
   "text": "معامله با قرآن هرکی دوست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 842.62,
   "end": 848.0,
   "text": "اما پس حرف شنیدن اینکه حضرت علامه می‌فرماید حرف گوش بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 848.0,
   "end": 855.88,
   "text": "حرف بشنو. اینکه جوونای ما اصلاً حوصله شنیدن حرف ندارن تا شروع می‌کنی دو کلام باهاش حرف زدن فرار می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 855.88,
   "end": 860.12,
   "text": "اینجا خیلی خطره، قلبش رو از دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 860.12,
   "end": 864.82,
   "text": "وقتی قلبش رو از دست داد دیگه قرآن هم براش ذکر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 864.82,
   "end": 867.24,
   "text": "همین قرآن که \"وننزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 867.24,
   "end": 870.28,
   "text": "من القرآن ما هو شفاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 870.28,
   "end": 875.1,
   "text": "و-- ما هو شفاء ورحمة للمؤمنین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 875.1,
   "end": 878.22,
   "text": "همین که شفا و رحمت برا اهل ایمانه \"ولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 878.22,
   "end": 881.12,
   "text": "يزيد الظالمين إلا خسارا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 881.12,
   "end": 884.84,
   "text": "کسی که گوش به حرف نده، قلبش رو از دست داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 884.84,
   "end": 887.74,
   "text": "به ظلم می‌افته، ظلم to نفسی رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 887.74,
   "end": 890.52,
   "text": "بعد دیگه قرآن هم براش ذکر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 890.52,
   "end": 892.44,
   "text": "خسارت‌بار قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 892.44,
   "end": 895.14,
   "text": "هرچی قرآ-- به سمت قرآن میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 895.14,
   "end": 898.54,
   "text": "قلبش پس می‌زنه. حالت اکراه پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 898.54,
   "end": 902.06,
   "text": "بعد می‌افته به خدایی نکرده \"ان كذبوا بآيات الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 902.06,
   "end": 904.74,
   "text": "خیلی خطرناکه این‌هایی که من دارم می‌گم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 904.74,
   "end": 907.8,
   "text": "حالا شما ببینید من می‌خواستم برم تو قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 907.8,
   "end": 911.3,
   "text": "تودیع معارفه بحث مدیران تو دنیا بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 911.3,
   "end": 914.36,
   "text": "که امروز هم اینجا یه اتفاق این چنینی شنیدیم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 914.36,
   "end": 917.28,
   "text": "خواستیم بزنیمش به قیامت ببینیم اونور چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 917.28,
   "end": 920.18,
   "text": "تودیع معارفه‌های اونور چه خبره بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 920.18,
   "end": 922.66,
   "text": "آیات و روایات و اینا. اینجا ما چی می‌شنویم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 922.66,
   "end": 925.52,
   "text": "به به به چه آقای خوبی بود، چه خدماتی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 925.52,
   "end": 928.96,
   "text": "بگید. تیتر کنید. هورا دست بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 928.96,
   "end": 933.08,
   "text": "هدیه بدید. اونور، اونور چیا می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 933.08,
   "end": 938.9,
   "text": "اونجا چیا می‌گن خیلی مهمه و اینکه چی می‌گن از لحظه مرگ شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 938.9,
   "end": 941.48,
   "text": "حالا اینو اجازه بدید در فردا براتون بگم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 941.48,
   "end": 946.34,
   "text": "آیا واقعاً از لحظه مرگ چیزی که درباره‌ی ما می‌گن مهمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 946.34,
   "end": 949.6,
   "text": "این شنیده‌ها؟ فردا انشاالله می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 949.6,
   "end": 953.9,
   "text": "ان شا الله عقب قسم خطبه به خیر باشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 953.9,
   "end": 955.54,
   "text": "الله ما صلي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}