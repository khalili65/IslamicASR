   "index": 6,
   "title": "## روایت دانشمند نابینا و آیهٔ اسراء",
   "start": 807.53,
   "end": 1053.39
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.16,
   "end": 4.1,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.1,
   "end": 7.68,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.68,
   "end": 12.1,
   "text": "آیات. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.1,
   "end": 17.26,
   "text": "عزیزان توجه دارن که در نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.26,
   "end": 19.66,
   "text": "باید مأموم سعی کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.66,
   "end": 23.18,
   "text": "صداش خیلی بلند نباشه. اون جهره صداش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.18,
   "end": 28.58,
   "text": "به گونه‌ای نباشه که حالا از امام بعضیا میگن از امام بالاتر نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.58,
   "end": 32.2,
   "text": "ولی در صورت کلی اینطور که مزاحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.2,
   "end": 33.92,
   "text": "مأمومین دیگر نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.92,
   "end": 36.52,
   "text": "بعضیا در نماز جماعت خیلی بلند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.52,
   "end": 42.24,
   "text": "نماز رو می‌خونن. خب اونچه که باید بلند خونده بشه تحیرت و لهرام و اون حمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.24,
   "end": 46.88,
   "text": "سوره است که حمد و سوره رو خب امام داره می‌خونه به جای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.88,
   "end": 49.32,
   "text": "دیگه بقیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.32,
   "end": 52.26,
   "text": "نیازی نداره به بلند خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.26,
   "end": 57.4,
   "text": "لذا این رو توجه داشته باشیم که صدا به گونه‌ای بلند نباشه که مزاحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.4,
   "end": 60.2,
   "text": "دیگران باشد. در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.2,
   "end": 63.7,
   "text": "قلب منزل و محل نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.7,
   "end": 67.1,
   "text": "اجازه بفرمایید که اشاره کنم به آیه پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.1,
   "end": 72.0,
   "text": "سوره سجده که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.0,
   "end": 75.84,
   "text": "با علت هیؤفالهیال خاصی حضرت حق اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.84,
   "end": 80.96,
   "text": "سخن گفته‌اند که \"یدبر الأمر من السماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.96,
   "end": 86.8,
   "text": "إلى الأرض\". یعنی اوست که امر عالم رو به نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.8,
   "end": 90.02,
   "text": "احسن و اکمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.02,
   "end": 94.98,
   "text": "از آسمان تدبیر می‌کند یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.98,
   "end": 97.44,
   "text": "در حقیقت آره، تدبیر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.44,
   "end": 102.02,
   "text": "امر رو دست گرفته \"من السماء إلى الأرض، إلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.02,
   "end": 108.7,
   "text": "الأرض\". این اصطلاح الأرض رو بگیر درش اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.7,
   "end": 111.14,
   "text": "رتبه‌های نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.14,
   "end": 114.72,
   "text": "در اون تنزل یعنی این دیگه ب-باز بحث تنزله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.72,
   "end": 118.52,
   "text": "\"من السماء\" این سما رو بگیر رتبه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.52,
   "end": 121.02,
   "text": "مافوق \"إلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.02,
   "end": 124.72,
   "text": "الأرض\" مطلقاً بگیر رتبه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.72,
   "end": 132.66,
   "text": "مادون. که همه این امور تحت تدبیر متفرد حضرت حق است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.66,
   "end": 138.54,
   "text": "که بعد بلافاصله می‌فرماید \"ثم يعرج إليه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.54,
   "end": 144.46,
   "text": "سپس دو مرتبه این‌ها عروج می‌کنند، میرن به سمت این امور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.46,
   "end": 147.18,
   "text": "عروج می‌کنند به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.18,
   "end": 150.74,
   "text": "اون کسی که داره تدبیر می‌کنه \"یدبر الأمر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.74,
   "end": 156.06,
   "text": "که حضرت حق است. در حقیقت اشاره باز به یک معنا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.06,
   "end": 161.48,
   "text": "به یک الفاظ دیگری داره اشاره می‌کنه به \"إن لله قوس نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.48,
   "end": 164.98,
   "text": "إنا إليه راجعون\" قوس صعود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.98,
   "end": 167.26,
   "text": "به یک معنا. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.26,
   "end": 170.16,
   "text": "\"یدبر الأمر من السماء إلى الأرض\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.16,
   "end": 174.2,
   "text": "این می‌شه قوس نزول. به یک وجه البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.2,
   "end": 178.82,
   "text": "بعد \"ثم يعرج إليه\" از عروج میاد این قوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.82,
   "end": 183.58,
   "text": "صعود و \"إنا إليه راجعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.58,
   "end": 186.44,
   "text": "همش به یک پارچه تحت تدبیر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.44,
   "end": 188.68,
   "text": "چرا؟ چون همه شعون اوین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.68,
   "end": 192.6,
   "text": "این شعون اوین، این مظاهر اوین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.6,
   "end": 194.78,
   "text": "این مجلای اوین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.78,
   "end": 203.0,
   "text": "این ظهور اوین که یعنی او، او ظهور کرده که این ظاهر شده نه اینکه یک چیزی هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.0,
   "end": 205.6,
   "text": "خدا درش ظهور کرده. نه این چیزی اصلاً نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.6,
   "end": 208.92,
   "text": "اصلاً عینش ظهور حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.92,
   "end": 216.84,
   "text": "اینا همه یک حقیقت واحدند لذا فرمودن کل \"إن الله کل الأشیاء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.84,
   "end": 219.44,
   "text": "و اصلاً هیچ شیی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.44,
   "end": 222.64,
   "text": "هیچ شیی نیست حتی بر اساس این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.64,
   "end": 226.44,
   "text": "میشه اینطوری برداشت کرد که هیچ شیی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.44,
   "end": 231.46,
   "text": "که مستثنای از این قصه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.46,
   "end": 237.44,
   "text": "که چی؟ که از الهیت نظام هستی وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.44,
   "end": 243.1,
   "text": "طولاً گرفته شده اومده تا دانی‌ترین مرتبه که دا-مرتبه طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.1,
   "end": 246.7,
   "text": "یعنی چی Mr. آقای ب-- ببینید کسی می‌گه الهیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.7,
   "end": 250.4,
   "text": "ببینید همه موجودات، این ماهیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.4,
   "end": 252.96,
   "text": "وجودات، ماهیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.96,
   "end": 257.58,
   "text": "که مظهر وجود مطلقه صمدیه احدیه حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.58,
   "end": 262.42,
   "text": "که یکیش شما هستی، یکیش منم، این اشیاء، یکیش ملکه، یکیش فلکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.42,
   "end": 270.02,
   "text": "این‌ها همه می‌خواید خودتو بشناسی دیگه مراتب وجودیت چگونه است و قلب اینجا کجا جایگاهش کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.02,
   "end": 276.7,
   "text": "همه و همه در ذات حضرت حق در علم حضرت حق بودند یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.7,
   "end": 280.84,
   "text": "بودند یا نه؟ اصلاً خدا نمی‌تونه ظهور نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.84,
   "end": 283.18,
   "text": "می‌تونه خدا ظهور نداشته باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.18,
   "end": 286.54,
   "text": "اگر بگی خدا ظهور نداره یکی از اسماء خدا رو ورداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.54,
   "end": 289.1,
   "text": "کدوم اسمو؟ آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.1,
   "end": 293.74,
   "text": "هو الواهر. هو الأول والآخر والواهر والباطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.74,
   "end": 296.0,
   "text": "از ظاهر رو وردار. نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.0,
   "end": 299.68,
   "text": "اصلاً نشدنیه. پس حتما خدا ظهور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.68,
   "end": 303.9,
   "text": "ظهور خدا چیه؟ یکی از ظهورات خدا شمایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.9,
   "end": 307.3,
   "text": "یکیش آسمانه، یکیش زمینه، یکیش جماداته، نباتاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.3,
   "end": 311.64,
   "text": "مجموعاً کل این اشیاء که همه اسماء‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.64,
   "end": 315.34,
   "text": "که \"علم آدم الأسماء كلها\" بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.34,
   "end": 322.06,
   "text": "\"علم آدم و علم آدم الأشیاء كلها\" علم فرمود می‌تونید به جاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 322.06,
   "end": 325.22,
   "text": "اینطوری بگذارید تفصیلًا که بفهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 325.22,
   "end": 328.12,
   "text": "همین اشیاء‌اند ولی کلها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.12,
   "end": 331.92,
   "text": "کلها، کل. می‌گه \"إن الله\" اون الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.92,
   "end": 334.3,
   "text": "\"کل الأشیاء\". اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.3,
   "end": 336.8,
   "text": "نمی‌شه اینا رو از هم جدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.8,
   "end": 341.3,
   "text": "حالا عرض می‌کنیم یعنی چی نمی‌شه جدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.3,
   "end": 345.26,
   "text": "خب حالا در علم حضرت حق بالاخره ما بودیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.26,
   "end": 349.12,
   "text": "حالا کسی بیاد اشکال کنه آقا شما اگر میگی هیچ‌کس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.12,
   "end": 356.1,
   "text": "اصلاً نمی‌شه خدا ظهور نداشته باشه یعنی خدا هیچوقت بدون خلق نبوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.1,
   "end": 359.44,
   "text": "خب پس چطور تو بعضی از دعاها فکر کنم در دعای سمات باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 359.44,
   "end": 363.1,
   "text": "که می‌گیم خدا همه چیز رو از عدم آفرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.1,
   "end": 365.88,
   "text": "پس این عدم کجا بوده؟ چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 365.88,
   "end": 368.3,
   "text": "عدمه دیگه مقابل وجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 368.3,
   "end": 372.26,
   "text": "می‌گیم این باید تفس-- این باید تعبیر بشه، تأویل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 372.26,
   "end": 376.78,
   "text": "منظور از این عدم چیه؟ یعنی اینکه در علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.78,
   "end": 379.22,
   "text": "اون ثقل ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.22,
   "end": 382.48,
   "text": "که عین علم است در علم خدا بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 382.48,
   "end": 384.52,
   "text": "یعنی وجود داشتند همین مظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 384.52,
   "end": 389.46,
   "text": "که الان ظهور کردند اون موقع در علم حضرت حق بودند یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.46,
   "end": 395.2,
   "text": "خدا از علم ذاتی خودش خدا علم داشت دیگه به این موجودات، به این وجودات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.2,
   "end": 398.48,
   "text": "اصطلاحاً حالا با الفاظ نمی‌خوایم خسته کنیم شما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.48,
   "end": 400.9,
   "text": "اصطلاحاً در فلسفه بهش می‌گن عین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.9,
   "end": 403.32,
   "text": "عین ثابت با سه تا نقطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.32,
   "end": 406.5,
   "text": "عین ثابت یا اعیان ثابته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.5,
   "end": 411.56,
   "text": "همون، همین وجود شما بالاخره تو علم حضرت حق بوده یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.56,
   "end": 415.76,
   "text": "اینکه می‌گیم حضرت زهرا السلام علیک یا ممتحنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.76,
   "end": 420.06,
   "text": "\"امتحنك الله الذي خلقك قبل ان يخلقك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 420.06,
   "end": 424.94,
   "text": "یا اگه اشتباه عربیشو اشتباه نگفته باشم تو زیارت نامه حضرت زهرا سلام الله علیها میگه تو ممتحنه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.94,
   "end": 428.6,
   "text": "یعنی قبل از اینکه خلق بشی امتحان شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 428.6,
   "end": 430.26,
   "text": "خب یعنی چی قبل از اینکه خلق بشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 430.26,
   "end": 432.88,
   "text": "یعنی در علم خدا، یعنی در ذات در اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.88,
   "end": 435.62,
   "text": "تو عین ثابت بودی در علم خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.62,
   "end": 442.42,
   "text": "درست شد؟ اون لحظه‌ای که ما در علم خدا بودیم، حالا لحظه که می‌گیم از ذیقه و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.42,
   "end": 445.3,
   "text": "لفظه. اصلاً لحظه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 445.3,
   "end": 447.64,
   "text": "یک وجود واحد اهدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.64,
   "end": 449.88,
   "text": "اول بی اول و آخر بی آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.88,
   "end": 453.94,
   "text": "اصلاً یک حقیقته. دیگه وقتی یک حقیقت بود هوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.94,
   "end": 459.52,
   "text": "تمام. یک حقیقت بود دیگه چه اولی، چه آخری، چه ظاهری، چه باطنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.52,
   "end": 461.92,
   "text": "باطن نداره، ظاهر. یک حقیقته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 461.92,
   "end": 463.8,
   "text": "که بگی آقا این از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 463.8,
   "end": 471.66,
   "text": "ما که نگاه می‌کنیم قیاس می‌کنیم این حدودات رو موجودات رو با هم می‌گیم این اوله، اون آخره، این ظاهره، اون باطنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.66,
   "end": 475.3,
   "text": "این ضعیفه، اون قویه، این امتیازات رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.3,
   "end": 477.64,
   "text": "حالا اون موق-- حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.64,
   "end": 479.98,
   "text": "وقتی که همه موجودات در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 479.98,
   "end": 489.94,
   "text": "عین علم حضرت حق یعنی این اعیان ثابته در علم خدا بودند، اونجا مرتبه الوهیت نظام هستیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 489.94,
   "end": 493.0,
   "text": "یعنی تمام اشیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.0,
   "end": 495.74,
   "text": "همه اشیا که یکی شما هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.74,
   "end": 500.34,
   "text": "در الوهیت نظام هستی بودی و خواهی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 500.34,
   "end": 502.28,
   "text": "در علم حضرت حق بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 502.28,
   "end": 505.52,
   "text": "خب از اونجا تنزل پیدا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 505.52,
   "end": 509.3,
   "text": "اومدی به کجا؟ به عالم مادون که مثلاً حالا طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.3,
   "end": 514.2,
   "text": "لذا اینجا حضرت علامه در جلسه اگه خس-خس-کسی خواست بره شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.2,
   "end": 516.4,
   "text": "مبثوت این قصه رو بشنوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 516.4,
   "end": 522.24,
   "text": "توی جلسه شونزدهم شرح فصوص قیصری قشنگ اونجا علامه شرح داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.24,
   "end": 526.12,
   "text": "خیلی باز قشنگ اینجا کرده حدود پنجاه دقیقه صحبت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 526.12,
   "end": 531.26,
   "text": "اونجا اصلا علامه می‌فر-- حضرت علامه حسن زاده رحمت الله علیه جانم فدای اسمشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 531.26,
   "end": 533.48,
   "text": "می‌فرمایند که اصلاً هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 533.48,
   "end": 539.26,
   "text": "شیعی نیست \"کل الاشیا\" هیچ شیعی نیست که استثناء داشته باشن تو این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 539.26,
   "end": 542.54,
   "text": "همه در علم حضرت حق بوده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 542.54,
   "end": 544.46,
   "text": "این مرتبه الوهیت هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 544.46,
   "end": 549.94,
   "text": "نه وجود هر کسی‌ست. بعد که تنزل کردند \"ام من شيء الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 549.94,
   "end": 553.58,
   "text": "عندنا خزائنه و ما ننزله الا بقدر معلوم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 553.58,
   "end": 556.8,
   "text": "نازل شد میاد به مرتبه عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 556.8,
   "end": 559.94,
   "text": "بعد تنزل پیدا می‌کنه دو مرتبه به صورت طولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.94,
   "end": 562.34,
   "text": "تجافي نه و تجلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 562.34,
   "end": 565.04,
   "text": "مجلان. توجه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 565.04,
   "end": 567.66,
   "text": "تجلی می‌کنند. این ظهوراتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 567.66,
   "end": 572.84,
   "text": "میاد به مرتبه مادون‌تر نسبت به مرتبه عقل میشه مثالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.84,
   "end": 576.7,
   "text": "برزخ همون مثق عالم مثاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.7,
   "end": 579.14,
   "text": "میاد به مرتبه مادون می‌شه مرتبه طبیعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.14,
   "end": 581.54,
   "text": "همه اشیا این رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 581.54,
   "end": 583.78,
   "text": "یه مرتبه طبیعی دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 583.78,
   "end": 585.96,
   "text": "مرتبه مثالی دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 585.96,
   "end": 588.28,
   "text": "مرتبه عقل دارن و مرتبه الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 588.28,
   "end": 596.4,
   "text": "حالا اون الوهیت وجود ما که گفتیم اصلاً محال است کسی از او جدا بشود الان متوجه می‌شیم چرا محال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 596.4,
   "end": 598.9,
   "text": "چون تو علم حضرت حقه، تو ذات ح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 598.9,
   "end": 602.78,
   "text": "و همه این کثرات مستهلك در ذات حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 602.78,
   "end": 606.94,
   "text": "وقتی از خدا از ذات خدا ظهور می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 606.94,
   "end": 611.56,
   "text": "به عبارتی ببینید به تعبیر تنزیها داریم می‌گیم دورادور یعنی این لفظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.56,
   "end": 615.88,
   "text": "خاکیه نمیذاره ما بگیریم بفهمیم خیلی ولی کمک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 615.88,
   "end": 620.14,
   "text": "اه وقتی از ذات حضرت خدا ظهور کردیم ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 620.14,
   "end": 621.8,
   "text": "اون موقع حدود پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 621.8,
   "end": 624.72,
   "text": "اونم حدود نسبت به همدیگه حد می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.72,
   "end": 627.32,
   "text": "این از اون شدیدتره، اون از این قوی‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 627.32,
   "end": 631.34,
   "text": "این امتیازات. و الا یکپارچه یک حقیقته‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 631.34,
   "end": 634.06,
   "text": "مثالی که برای خودت می‌تونیم بزنیم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.06,
   "end": 641.52,
   "text": "ببینید امتیازات یا امتیازات تقابلی‌اند مثل دو شخص از یک نوع انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 641.52,
   "end": 645.92,
   "text": "الان روبروی من این دو عزیزی که نشستن دو فردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 645.92,
   "end": 648.16,
   "text": "دو شخص مشخص‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 648.16,
   "end": 650.62,
   "text": "از یک نوع یعنی انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 650.62,
   "end": 653.78,
   "text": "اینا وجودشون تقابلیه، مقابل همند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 653.78,
   "end": 658.4,
   "text": "اما وجود محیط و محاطی که ما دو جور بیشتر امتیاز نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 658.4,
   "end": 660.82,
   "text": "یا تقابلی‌اند که الان مثال زدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.82,
   "end": 663.72,
   "text": "یا محیط محاطیه. محیط محاطی مثل چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 663.72,
   "end": 670.26,
   "text": "مثل نسبت حضرت علامه اینجا که می‌رسن می‌فرمایند مثل نسبت دست به بدن ما، به من، به خود من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 670.26,
   "end": 674.66,
   "text": "این دست من هست یا نه؟ این دست حضرت عالیه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 674.66,
   "end": 678.8,
   "text": "یا می‌تونیم بگیم اصلاً جدا کنیم این دستو جدا کنیم، این دستو جدا کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 678.8,
   "end": 681.84,
   "text": "اصلاً دیگه دست شماست. جو-- اصلاً جدا نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 681.84,
   "end": 685.9,
   "text": "این دست مال شماست. یعنی چی جدا کن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 685.9,
   "end": 692.48,
   "text": "این محیط محاطیه که وجود عین وجود تو، اون الوهیت وجود تو که الان می‌خوایم برسیم به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 692.48,
   "end": 694.02,
   "text": "بحث قلب بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 694.02,
   "end": 696.82,
   "text": "قلب من-منزل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 696.82,
   "end": 699.98,
   "text": "این قلب محیط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 699.98,
   "end": 702.22,
   "text": "احاطه داره بر همه وجود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 702.22,
   "end": 705.9,
   "text": "به همه وجود تو. این دست تو محاطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 705.9,
   "end": 713.62,
   "text": "تحت تدبیر قلبه. اون که مرتبه الوهیت و نظام هستیه، قلب توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 713.62,
   "end": 717.7,
   "text": "قلب، قلب که محل نزول اولین جایی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 717.7,
   "end": 720.8,
   "text": "هر چیزی، هر فیضی، هر فیضی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 720.8,
   "end": 726.01,
   "text": "حالا رزق بگیر، علم بگیر، حیات بگیر، قدرت بگیر، حکمت بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 726.01,
   "end": 729.51,
   "text": "هرچی که هست اولین مرتبه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 729.51,
   "end": 735.75,
   "text": "از ذات حضرت حق در تو، در وجود تو، در شیئی به نام وجود به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 735.75,
   "end": 742.83,
   "text": "شکل و هیکل تو که یه زمانی هیولای اول بودی، قوه‌ی محض بودی، هیچ فعالیتی نداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 742.83,
   "end": 747.01,
   "text": "همین‌طوری حالا به تعابیر فلسفی ثمه، ثمه، ثمه، استدراجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 747.01,
   "end": 756.25,
   "text": "اومدی رفتی حالا انسان کامل میره تا عقل اول میرسه بلکه فوق اون طور وجودیش میره تا صادر اول، صادر نخستین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 756.25,
   "end": 758.21,
   "text": "این اطوار وجودی انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 758.21,
   "end": 760.43,
   "text": "همه این‌ها یک حقیقت‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 760.43,
   "end": 762.19,
   "text": "اشتداد وجودی پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 762.19,
   "end": 765.33,
   "text": "درست شد؟ اون چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 765.33,
   "end": 771.37,
   "text": "اتصال ما به اون محال قطع بشود الوهیت نظام هستی یعنی ذات حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 771.37,
   "end": 773.83,
   "text": "این اتصال ما با اونجا چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 773.83,
   "end": 779.79,
   "text": "با قلب ماست که هر فیضی از خدا بخواهد به من، به منی که یکی از اشیام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 779.79,
   "end": 786.65,
   "text": "نازل بشود، اول در اون مرتبه‌ی قلب من یعنی الوهیت من نازل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 786.65,
   "end": 790.17,
   "text": "به شما باید دقت بکنید بگید لا الهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 790.17,
   "end": 792.95,
   "text": "لا الهه. اول اینو نفی می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 792.95,
   "end": 795.67,
   "text": "هیچ الهی نیست. هیچ الهه‌ای نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 795.67,
   "end": 798.75,
   "text": "الا الله. حالا بگو الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 798.75,
   "end": 801.43,
   "text": "ان الله کل الاشیاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 801.43,
   "end": 807.31,
   "text": "همه یک حقیقت‌اند. مثال اون بدن رو که زدیم نسبت دست به بدن، چشم به بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 807.31,
   "end": 813.03,
   "text": "این‌ها یک حقیقت واحدند. النفس فی وحدتها کل القوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 813.03,
   "end": 816.71,
   "text": "نفس در اینه که یک حقیقته همه‌ی قوا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 816.71,
   "end": 821.43,
   "text": "تحت تدبیر او هستند. کثرات هست اما همه یک حقیقت‌اند همه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 821.43,
   "end": 825.07,
   "text": "یعنی چشمتو نمی‌بینه، نفستو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 825.07,
   "end": 829.09,
   "text": "چه-- نفس یا به عبارتی بهتره الان بگیم قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 829.09,
   "end": 831.67,
   "text": "مظهر لا تأخذه سنة ولا نومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 831.67,
   "end": 834.95,
   "text": "اصلاً خواب نداره، چرت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 834.95,
   "end": 839.09,
   "text": "مظهر لا يشغله شأن عن شأن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 839.09,
   "end": 841.69,
   "text": "هیچ شأنی از اون یکی شأنش غافلش نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 841.69,
   "end": 845.03,
   "text": "الان نفستو داره می‌بینه. غافل از شنیدنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 845.03,
   "end": 847.09,
   "text": "نفس تو، من و نفس من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 847.09,
   "end": 854.69,
   "text": "قلب من داره سخن می‌گه. یه حقیقتی در الوهیت وجود من داره تنزل پیدا می‌کنه بیاد به عالم طبیعت می‌شه صوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 854.69,
   "end": 858.89,
   "text": "اصلش تو الوهیت وجود منه اتصال داره به ذات حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 858.89,
   "end": 861.23,
   "text": "اون حقیقت که داره کلمه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 861.23,
   "end": 863.81,
   "text": "اما این حقیقت، این قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 863.81,
   "end": 867.97,
   "text": "غافل از قوه‌ی دافعه و هاضمه‌ی معده منه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 867.97,
   "end": 869.85,
   "text": "غافل از قوه‌ی لامسه منه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 869.85,
   "end": 873.91,
   "text": "عینا تسلی به تمام این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 873.91,
   "end": 877.27,
   "text": "در اصطلاح داره. اون حقیقت واحده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 877.27,
   "end": 879.27,
   "text": "هرچی بیاد اول به قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 879.27,
   "end": 882.75,
   "text": "حالا این الفاظ رهزن نشه چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 882.75,
   "end": 886.37,
   "text": "به هر حال این الفاظ رو اه- اومدن در--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 886.37,
   "end": 889.47,
   "text": "دیگه خاکی دیگه لفظ مربوط به این عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 889.47,
   "end": 891.47,
   "text": "اما باید تأویل کرد. باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 891.47,
   "end": 896.67,
   "text": "عبور کرد، تعبیر کرد، عبور کرد از این الفاظ رسید به اون حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 896.67,
   "end": 898.65,
   "text": "گولمون نزنه این الفاظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 898.65,
   "end": 900.97,
   "text": "علامه معمولاً مثال هم که می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 900.97,
   "end": 908.75,
   "text": "می‌گه دورا دور. حالا حتی مثال دریا و موج رو هم که می‌زنه نسبت به الوهیت نظام هستی و ما می‌گه ما موجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 908.75,
   "end": 912.07,
   "text": "مثلاً اون دریا می‌گه از دورا دور تنزیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 912.07,
   "end": 915.37,
   "text": "می‌گه مثلاً چون از ذیق لفظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 915.37,
   "end": 918.09,
   "text": "توجه کردی؟ حالا یه مثال برای این بزنم و بسه امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 918.09,
   "end": 922.27,
   "text": "این روایت شیرین رو گوش بدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 922.27,
   "end": 925.79,
   "text": "از خود علامه من شنیدم. ایشون می‌فرمودند که اسمم نبردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 925.79,
   "end": 928.35,
   "text": "گفتند یه دانشمند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 928.35,
   "end": 931.59,
   "text": "غیر امامی یعنی از مذاهب دیگه‌ی اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 931.59,
   "end": 933.75,
   "text": "اومدن فر-- مثلاً فرقه‌های دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 933.75,
   "end": 936.79,
   "text": "اومدن پیش یه دانشمند امامی یعنی شیعه اثنی عشری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 936.79,
   "end": 939.49,
   "text": "بحث کردن که شما یه قرآن جدید درست کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 939.49,
   "end": 941.15,
   "text": "یه دین جدید و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 941.15,
   "end": 944.91,
   "text": "چرا ما می‌گیم رافضی؟ پشت کرده به دین رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 944.91,
   "end": 948.01,
   "text": "که دیروز بحثش گذشت یا پریروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 948.01,
   "end": 951.33,
   "text": "اینا میگن که آقا شما یک دن-- قرآن جدید آوردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 951.33,
   "end": 955.59,
   "text": "قرآن رو تأویل می‌کنید. مثلاً می‌گید یخرج منهم اللؤلؤ والمرجان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 955.59,
   "end": 958.89,
   "text": "این لؤلؤ امام حسن، مرجان امام حسینه مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 958.89,
   "end": 961.95,
   "text": "این تأویلات چیه؟ از خودتون یه قرآن جدید درست کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 961.95,
   "end": 964.67,
   "text": "تو اصول کافی ما پره از این تأویلات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 964.67,
   "end": 967.65,
   "text": "توجه کردی؟ هرچی این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 967.65,
   "end": 974.45,
   "text": "حالا امامی براش می‌خواست مدرک بیاره، حالا دلیل عقلی بیاره این نمی‌پذیرفت، بحث می‌کرد اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 974.45,
   "end": 976.91,
   "text": "بعد یه دفعه خب ایشون نابینا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 976.91,
   "end": 981.67,
   "text": "این دانشمند یا عالمی که غیر شیعه بوده نابینا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 981.67,
   "end": 987.49,
   "text": "خیلی جالبه که این دانشمند امامی این آیه رو براش می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 987.49,
   "end": 994.43,
   "text": "می‌گه که اول بهش می‌گه که تو حیفه تو با این علم و دانشی که داری قیامت پیغمبر رو نبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 994.43,
   "end": 998.01,
   "text": "نگاهت به پ- پیغمبر نیفته با این حالا وجاهت که داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 998.01,
   "end": 1001.97,
   "text": "بعد طرف شاکی می‌شه می‌گه این چه حرفیه می‌زنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1001.97,
   "end": 1004.19,
   "text": "رو چه حسابی داری می‌گی من پیغمبر رو نمی‌بینم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1004.19,
   "end": 1006.75,
   "text": "اشاره به این آیه هفتاد و دو سوره‌ی اسرا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1006.75,
   "end": 1009.83,
   "text": "\"ومن کان فی هذه اعمى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1009.83,
   "end": 1012.11,
   "text": "هر کسی که اینجا نابینا است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1012.11,
   "end": 1014.79,
   "text": "\"فهو في الآخرة اعمى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1014.79,
   "end": 1017.33,
   "text": "و او تو آخرت هم نابینا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1017.33,
   "end": 1020.77,
   "text": "مگه نمی‌گید تأویل نکن؟ خب این ظاهر قرآن بفهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1020.77,
   "end": 1027.15,
   "text": "می‌گه نخیر این منظ-- اون عالم غیر شیعه می‌گه نخیر این منظور از این نابینایی ظاهر نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1027.15,
   "end": 1028.93,
   "text": "می‌گه خب آها موچتو بگیرم بچه‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1028.93,
   "end": 1032.55,
   "text": "مگه نمی‌گید تأویل نکن، عبور نکن، ظاهر رو بگیر و سلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1032.55,
   "end": 1034.81,
   "text": "چرا تو الان تو تعبیر کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1034.81,
   "end": 1036.87,
   "text": "اینطوریه. حالا باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1036.87,
   "end": 1039.33,
   "text": "اون تأویل رو کی می‌دونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1039.33,
   "end": 1042.15,
   "text": "ائمه معصومین علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1042.15,
   "end": 1045.89,
   "text": "که هرکی به عصمت نزدیک‌تر می‌شه به دایره‌ی عصمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1045.89,
   "end": 1048.21,
   "text": "از این تأويل باخبر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1048.21,
   "end": 1051.37,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر باشد به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1051.37,
   "end": 1053.05,
   "text": "صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1053.05,
   "end": 1053.39,
   "text": "اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}