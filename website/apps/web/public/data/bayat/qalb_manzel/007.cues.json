 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 2.2,
   "text": "الله و ربanie",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.2,
   "end": 6.92,
   "text": "آياته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.92,
   "end": 10.32,
   "text": "خب کسی که مأموم هست در امام ج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.32,
   "end": 15.3,
   "text": "در نماز جماعت و اقتدا می‌کند قطعاً باید نیت جماعت کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.3,
   "end": 19.24,
   "text": "نمیشه که مأموم قصد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.24,
   "end": 21.14,
   "text": "فرادا خوندن بکنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.14,
   "end": 23.3,
   "text": "اقتدا کنه. معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.3,
   "end": 30.34,
   "text": "امام جماعت چطور؟ امام جماعت هم اگر انشاالله یه روزی شما مثلاً توفیق حاصل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.34,
   "end": 34.22,
   "text": "برای خاطر خدا فقط که خدا رحمت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.22,
   "end": 38.08,
   "text": "شیخ مرتضی انصاری رو که می‌فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.08,
   "end": 42.84,
   "text": "امام جماعت شدن رو فقط اگر برای خدا بود قبول کن و الا ق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.84,
   "end": 49.82,
   "text": "خیر مطلقا. علم رو فرمودند چه برای خدا، چه برای غیر خدا قطعاً انجام بده چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.82,
   "end": 51.94,
   "text": "تو رو به سمت نور بالاخره می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.94,
   "end": 54.68,
   "text": "حقیقتش نوره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.68,
   "end": 59.6,
   "text": "قضاوت رو فرمودند چه برای خدا، چه برای غیر خدا مطلقا انجام نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.6,
   "end": 62.74,
   "text": "اما امام جماعت شدن رو فرمود برای خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.74,
   "end": 66.76,
   "text": "حالا، حالا یه روزی شما امام جماعت شدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.76,
   "end": 68.96,
   "text": "نیتتون باید فرادا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.96,
   "end": 73.0,
   "text": "یا شما هم باید نیت جماعت کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.0,
   "end": 81.46,
   "text": "خب رهبر عزیزمون می‌فرمایند که می‌تونید نیت فرادا کنید همینطوری خب شروع کنید نمازتون رو خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.46,
   "end": 87.92,
   "text": "اما اگر می‌خواید فضیلت جماعت رو درک کنید بالاخره شما می‌خواید فضیلت نماز جماعت رو درک کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.92,
   "end": 91.64,
   "text": "باید قصد امامت جماعت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.64,
   "end": 95.22,
   "text": "اینو حواسمون باشه و الا ثواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.22,
   "end": 99.76,
   "text": "نماز جماعت برای شما امام جماعت نمی‌نویسن اگر قصد فرادا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.76,
   "end": 103.48,
   "text": "صرف کنید. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.48,
   "end": 107.3,
   "text": "اجازه بدید که بحث دیروز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.3,
   "end": 113.46,
   "text": "تکمیلش کنیم. ما عرض کردیم که فردا می‌گیم چه فرقی می‌کنه علمی که در قلب باشد یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.46,
   "end": 116.52,
   "text": "معرفتی که از قلب خارج شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.52,
   "end": 122.02,
   "text": "چون گفتیم وعاء و ظرف اصلی معرفت قلب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.02,
   "end": 128.44,
   "text": "و وقتی از قلب خارج شد دیگه اون کارکرد و اثر و ظهور و سلطنت خودش رو ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.44,
   "end": 134.88,
   "text": "یه هسته عرفانی رو هم دیروز عرض کردیم که به بهانه این موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.88,
   "end": 137.4,
   "text": "وعاء معرفت در قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.4,
   "end": 141.56,
   "text": "یه بحث علمی هم شنیده باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.56,
   "end": 145.12,
   "text": "که و الا شاید خیلی به هم مرتبط نبودن اون بحث دیروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.12,
   "end": 148.82,
   "text": "می‌خواستیم نکته علمی رو عرض کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.82,
   "end": 153.84,
   "text": "ذائقه تون با مسائل عرفانی که در توحید هست آشنا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.84,
   "end": 158.0,
   "text": "اجازه بفرمایید که به ه- بر همین مبنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.0,
   "end": 162.4,
   "text": "یک جمله‌ای رو از مرحوم علامه قیسری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.4,
   "end": 166.3,
   "text": "بر فصل اوزعیری ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.3,
   "end": 170.86,
   "text": "در فصوص الحکم بیان کنیم که ایشون می‌فرماید طور المعرفة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.86,
   "end": 177.62,
   "text": "این طور معرفت که خلقکم اتوارا، خدا شما رو به طورهای مختلف خلق کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.62,
   "end": 179.54,
   "text": "یه طور شما هم طور معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.54,
   "end": 186.1,
   "text": "یک طور من و شما طور تعلیمه، علم آموزیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.1,
   "end": 188.0,
   "text": "یاد گرفتن چیزهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.0,
   "end": 191.52,
   "text": "اما وقت چیز- وقتی می‌خواد بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.52,
   "end": 194.48,
   "text": "معرفت اصطلاح بشه فوق اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.48,
   "end": 196.68,
   "text": "علم ظاهری و علم فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.68,
   "end": 202.9,
   "text": "در حقیقت میشه گفت اصل علمه یا حقیقت علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.9,
   "end": 206.8,
   "text": "توجه کردید؟ اینجا می‌فرماید طور المعرفة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.8,
   "end": 211.26,
   "text": "فوق طور الادراک العقلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.26,
   "end": 216.24,
   "text": "و هو الكشف عن الحقائق الامور ماهیة علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.24,
   "end": 219.98,
   "text": "میگه این طور معرفت می‌خوای بدونید چه شکلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.98,
   "end": 222.44,
   "text": "چه مزه‌ای، چه خصوصیتی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.44,
   "end": 226.18,
   "text": "فوق طور عقله و کشفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.18,
   "end": 228.78,
   "text": "یعنی تو رو به کشف میندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.78,
   "end": 233.8,
   "text": "تو کاشف میشی، مکشوف می‌شه حقایق برای تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.8,
   "end": 236.56,
   "text": "مشهود میشی، شاهد میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.56,
   "end": 239.14,
   "text": "و همه عالم برای تو مشهود می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.14,
   "end": 241.0,
   "text": "تو هم برای عالم مشهود میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.0,
   "end": 244.82,
   "text": "تو شاهد میشی. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.82,
   "end": 248.28,
   "text": "علم فکری نیست. این رو میخواد بگه که اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.28,
   "end": 254.66,
   "text": "وقتی علم وارد حوزه قلب شد دیگه علم فکری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.66,
   "end": 259.18,
   "text": "این اصل علمه که اصطلاحاً بهش میگن نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.18,
   "end": 261.76,
   "text": "و حقیقتا میگن نور، نه اصطلاحاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.76,
   "end": 265.34,
   "text": "حقیقتا بهش میگن، اینجا دیگه بهش میگن نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.34,
   "end": 269.46,
   "text": "حالا بر این موضوع حدیثی هم داریم همتون حفظید اجازه بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.46,
   "end": 273.06,
   "text": "جهت تسهیل در فهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.06,
   "end": 279.68,
   "text": "نکته دیگری رو عرض کنیم که حالا اینا چه کسایی‌ان که میرن به این میرسن، کشف می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.68,
   "end": 282.26,
   "text": "میرن و با حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.26,
   "end": 287.7,
   "text": "علم طرف می‌شن، با معرفت با قلبشون طرف می‌شن، چه کسایی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.7,
   "end": 290.34,
   "text": "قیسری دو مرتبه در شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.34,
   "end": 295.14,
   "text": "فرمایش شیخ، شیخ اکبر این چنین می‌فرماید: عارفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.14,
   "end": 297.78,
   "text": "اصحاب کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.78,
   "end": 301.06,
   "text": "و فائز به سر القدراند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.06,
   "end": 304.94,
   "text": "و کمند. سر القدر اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.94,
   "end": 308.48,
   "text": "حسه وجودی ما. میگه عارفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.48,
   "end": 310.76,
   "text": "اولاً اصحاب کشف‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.76,
   "end": 313.48,
   "text": "نه اصحاب فکر. عارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.48,
   "end": 316.96,
   "text": "از معرفت میاد دیگه. کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.96,
   "end": 320.26,
   "text": "درون اون حقایق رو می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.26,
   "end": 325.94,
   "text": "و این از فائز م-مفیض به سر القدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.94,
   "end": 331.24,
   "text": "یعنی به اون درونیات پی برده و البته می‌فرماید که و کم‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.24,
   "end": 333.86,
   "text": "و اکثراً اصحاب فکر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.86,
   "end": 340.6,
   "text": "عاقلانند. پس ادراک به سر القدر برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.6,
   "end": 347.9,
   "text": "و البته در فتوحات ابن عربی این حقیقت رو اسمشو میذاره علم الاسرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.9,
   "end": 351.88,
   "text": "این که تو بتونی به اون باطن برسی علم الاسرار اسمشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.88,
   "end": 353.92,
   "text": "یعنی اینطور نیست که نصیب همه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.92,
   "end": 356.36,
   "text": "سره، سر اگر قرار بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.36,
   "end": 361.44,
   "text": "ااا س-- پنهان نباشه و آشکار بشه که دیگه بهش سر نمی‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.44,
   "end": 363.72,
   "text": "مال هرکسی نیست. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.72,
   "end": 369.14,
   "text": "اینجا میگه اکثراً اصحاب فکرند، اص-اصحاب تدبر عقلی‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.14,
   "end": 373.7,
   "text": "تفکر عقلین نه قلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.7,
   "end": 381.36,
   "text": "در فصل عصمت قلبیة فی کلمة شعیبیه اونجا هم شیخ اکبر ببینید عبارت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.36,
   "end": 384.2,
   "text": "ان فی ذلک لذکرا این آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.2,
   "end": 387.76,
   "text": "داره اشاره میکنه به این آیه استنباط میکنه شیخ اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.76,
   "end": 395.26,
   "text": "علیه الرحمه. ان فی ذلک خدا میفرماید قطعاً تو این، تو اون چیزی که من خدمت شما گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.26,
   "end": 399.64,
   "text": "لذکرا یه یادآوری‌ست، ذکری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.64,
   "end": 402.56,
   "text": "ذکر ورای اسم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.56,
   "end": 408.6,
   "text": "یا من اسمه اسمه دوا، اسمت دواست و ذکره شفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 408.6,
   "end": 411.08,
   "text": "شفا در ذکره، نه در اسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.08,
   "end": 413.94,
   "text": "میشه کسی دوا رو بخوره خوب نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.94,
   "end": 416.9,
   "text": "دوا اسمه یا من اسمه دوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.9,
   "end": 423.02,
   "text": "اما اونچه که شفاس ذکره و ذکره شفا که ما فکر میکنیم تسبیح دست بگیریم بس بس کنیم این ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.02,
   "end": 425.54,
   "text": "نه این ذکر نیست اصلاً ورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 425.54,
   "end": 430.12,
   "text": "لغلغه زبانه. کی میشه ذکر که شفا باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.12,
   "end": 435.2,
   "text": "وقتی که اینجا حالا داره-- این قرآن داره همین الان آیه قرآن داره همین سر رو فاش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.2,
   "end": 439.52,
   "text": "لذکرا لمن کان له قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.52,
   "end": 445.86,
   "text": "برای کسی که دل داده، دل داره، قلب داره، قلبش رو به کار انداخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.86,
   "end": 453.16,
   "text": "عجب! بعد اینجا لقلبه فی انواع این کلام ذیل این آیه کلام شیخ اکبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 453.16,
   "end": 457.24,
   "text": "فی انواع سبر و صفات و لم یقل من کان له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 457.24,
   "end": 459.68,
   "text": "عقل فأن العقل قید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 459.68,
   "end": 462.22,
   "text": "میگه اینجا اگر بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 462.22,
   "end": 465.7,
   "text": "عقل رو مطرح میکرد خدا اینجا ذکرش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.7,
   "end": 471.6,
   "text": "منتسب به عقل میکرد، اینجا مقید میشد چون عقل مقیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 471.6,
   "end": 475.7,
   "text": "قید میخوره یعنی مطلق نیست. قلبه که مطلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.7,
   "end": 481.02,
   "text": "اصلاً نهایت نداره. لذا خدا میفرماید من تنها جایی که جام میشه قلب مومنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 481.02,
   "end": 484.5,
   "text": "یعنی نهایت نداره. وسعت رحمتی کل شیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 484.5,
   "end": 487.66,
   "text": "که از مصادیق رحمت حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 487.66,
   "end": 489.54,
   "text": "اینجا شیخ اتفاقاً به همین اشاره میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 489.54,
   "end": 495.24,
   "text": "میگه اینجا خدا نفرموده که \"ولم یقل لمن کان له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 495.24,
   "end": 497.86,
   "text": "عقل\" بلکه فرموده چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 497.86,
   "end": 506.14,
   "text": "\"لمن کان له قلب\". این جایگاه قلب رو میرسونه که چقدر ما حالا اگر این معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 506.14,
   "end": 509.56,
   "text": "نرفت اصلاً دو وجه داره که دیروز گفتیم فردا توضیح میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 509.56,
   "end": 513.94,
   "text": "اگر این مع-- علم، علم حالا علم فکری بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 513.94,
   "end": 519.32,
   "text": "وارد قلب نشد میشه علم فکری حتی اگر علم الهیات باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 519.32,
   "end": 523.08,
   "text": "علم فلسفه و عرفان باشه، علم قرآن باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 523.08,
   "end": 525.88,
   "text": "ها؟ فقه و اصول باشه، هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.88,
   "end": 528.28,
   "text": "وارد حوزه قلب نشد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 528.28,
   "end": 530.58,
   "text": "معرفت حساب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 530.58,
   "end": 533.14,
   "text": "نور نداره. اینطوری میتونیم بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 533.14,
   "end": 539.12,
   "text": "باطن نداره. لذا تو همون حد نگرش میداره انسان رو و وارد باطن عالم نمیکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 539.12,
   "end": 541.9,
   "text": "و وقت مرگ همین آقا تازه آغاز راهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.9,
   "end": 545.62,
   "text": "تازه میخواد وارد باطن عالم بشه از ظاهر عبور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 545.62,
   "end": 548.9,
   "text": "قبلش عبور نکرده لذا موتش سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 548.9,
   "end": 552.58,
   "text": "کسی موتش آسونه که موت قبلاً تموتویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.58,
   "end": 555.24,
   "text": "یعنی قبلاً از ظاهر به باطن سفر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 555.24,
   "end": 557.24,
   "text": "از ظاهر به باطن قرآن سفر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 557.24,
   "end": 559.84,
   "text": "از ظاهر به باطن خودش سفر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 559.84,
   "end": 562.18,
   "text": "از ظاهر به باطن این ادعیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 562.18,
   "end": 564.12,
   "text": "یا روایات اهل بیت که به منزله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 564.12,
   "end": 572.76,
   "text": "بدنن نسبت به نفس قرآن عبور کرده از ظاهر به باطن این نظام افقی عبور کرده موتش آسون میشه چون عبور کرده از ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.76,
   "end": 575.58,
   "text": "موت هم یعنی عبور از ظاهر به باطن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 575.58,
   "end": 577.84,
   "text": "یعنی خروج از عادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 577.84,
   "end": 581.2,
   "text": "که قب-- بحثش قبلاً گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 581.2,
   "end": 585.48,
   "text": "و این سخت میشه. اما اگر ورود کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 585.48,
   "end": 588.12,
   "text": "ورود کرد این علم در قلب میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.12,
   "end": 591.8,
   "text": "معرفت، نور معرفت. امکان داره کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.8,
   "end": 596.94,
   "text": "دچار این بشود که این علمی که در قلب رسوخ کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 596.94,
   "end": 601.18,
   "text": "ورود کرد دو مرتبه از قلبش خارج بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 601.18,
   "end": 603.74,
   "text": "یعنی دو مرتبه از اون کشف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.74,
   "end": 607.86,
   "text": "از اون سر، از اون نور خارج بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.86,
   "end": 610.74,
   "text": "اگر امکانش نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 610.74,
   "end": 614.02,
   "text": "این سر-- این نکته خ-- خیلی مهمه دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 614.02,
   "end": 616.44,
   "text": "اگه امکانش نبود خودتون آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 616.44,
   "end": 626.34,
   "text": "آخر آیه تبارک الذی نمی فرمود \"والذین کفروا اولیائهم الطاغوت یخرجونهم من النور الی الظلمات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 626.34,
   "end": 630.22,
   "text": "از نور میکشوننشون به ظلمت، از نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 630.22,
   "end": 635.0,
   "text": "یعنی نور باز این امکان هست کسی بره تو دل نور باز بیاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 635.0,
   "end": 636.6,
   "text": "چنین کسی بهش میگن مرتد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 636.6,
   "end": 641.58,
   "text": "یعنی رفت تو دل نور. کشف قلبی براش حاصل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 641.58,
   "end": 646.0,
   "text": "این خیلی خطرناکه. یعنی پس زدن نظام اقدس نه مقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.0,
   "end": 648.98,
   "text": "چون نور مستقیماً برمیگرده به وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 648.98,
   "end": 651.94,
   "text": "وجود هم مال نظام اقدس نه مقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.94,
   "end": 655.3,
   "text": "که این فرق اقدس و مقدس چیه قبلاً گفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.3,
   "end": 659.72,
   "text": "اینقدر خطرناکه این جزئیات و این ریزه کاری‌ها اینا رو باید بدونیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 659.72,
   "end": 661.98,
   "text": "نگیم این حرفا چیه؟ اینا کجا بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 661.98,
   "end": 665.24,
   "text": "چی بوده؟ ما تا حالا نشنیدیم. پس نزنیم این حقایقو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 665.24,
   "end": 667.9,
   "text": "در دل قرآنه. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 667.9,
   "end": 673.62,
   "text": "به قول مرحوم علامه قیسری یکی میاد سر القدرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 673.62,
   "end": 678.92,
   "text": "رو متوجه میشه، اهل علم و کشفه، به علم و اسرار میرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 678.92,
   "end": 684.78,
   "text": "و میتونه اینا رو بفهمه. یکی هم مثل من فقط توجه به ظواهر و توتی‌وار یه چیزی حس میکنه میاد میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 684.78,
   "end": 688.6,
   "text": "اینا خیلی مهمه. اصلاً نور برگشت میکنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 688.6,
   "end": 692.78,
   "text": "وجود و اصلاً علم هم عین نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 692.78,
   "end": 698.76,
   "text": "چون علم عین ذات حضرت حق است و حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 698.76,
   "end": 706.34,
   "text": "علم مطلقه است و به قول علامه اگر همه عالم علم انباشته شده روی هم است یعنی وجود روی وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 706.34,
   "end": 709.58,
   "text": "ها؟ همه موجودات، این وجودات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 709.58,
   "end": 714.92,
   "text": "وجود دارن دیگه. وجود سهمی از وجود دارن که این سهمشون از وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 714.92,
   "end": 721.78,
   "text": "جایگاهشون و رتبه‌شون رو مشخص کرده که انسان بیشترین سهم رو از وجود دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 721.78,
   "end": 727.82,
   "text": "اجازه بفرمایید اشاره کنم جهت باز فهم این موضوع هم یه نکته دیگه هم بگم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 727.82,
   "end": 732.62,
   "text": "از عین سی و شش سرح العیون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 732.62,
   "end": 735.84,
   "text": "سرخ العيون کتاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 735.84,
   "end": 741.22,
   "text": "میشه گفت متخصصی‌ترین کتاب علامه در سیر معرفت نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 741.22,
   "end": 744.44,
   "text": "خیلی سنگینه. شصت و شش عین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 744.44,
   "end": 747.12,
   "text": "چشمه، عین از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 747.12,
   "end": 751.22,
   "text": "مسائل معرفت نفسه. در عین سی و ششمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 751.22,
   "end": 755.02,
   "text": "حضرت علامه می‌فرماید-- مطالبی رو می‌فرماید بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 755.02,
   "end": 757.86,
   "text": "این‌چنين می‌فرماید که \"در این موضوع است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 757.86,
   "end": 763.98,
   "text": "که برای انسان ادراکاتی فوق طهور عقل است.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 763.98,
   "end": 769.76,
   "text": "یعنی همون قلب. بعد بر شاهد این آیه رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 769.76,
   "end": 772.18,
   "text": "آیه شصت و شش سوره کهف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 772.18,
   "end": 776.24,
   "text": "\"و علمناه\". ما تعلیم دادیم به او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 776.24,
   "end": 779.52,
   "text": "چی؟ \"من لدنا علما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 779.52,
   "end": 783.1,
   "text": "علم لدنّی. این علم لدنّی یعنی همون معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 783.1,
   "end": 787.2,
   "text": "جاش تو قلبه. کسی اگر علم وارد بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 787.2,
   "end": 790.4,
   "text": "قلبش نشد به حوزه قلبش یعنی باور نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 790.4,
   "end": 793.36,
   "text": "یعنی نچشید. یعنی نفهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 793.36,
   "end": 797.56,
   "text": "حالا باز نفهمیدم نمیشه گفت فهم باز ما رو حوزه فکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 797.56,
   "end": 800.2,
   "text": "میشه گفت نرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 800.2,
   "end": 805.44,
   "text": "اینطوری بگیم به قول علامه دارا نشد، واضح وارد حوزه قلبش نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 805.44,
   "end": 807.42,
   "text": "اینجا میگه \"من لدنا علما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 807.42,
   "end": 810.74,
   "text": "علم لدنّیه از منه خ-- از ذات منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 810.74,
   "end": 813.1,
   "text": "اصلا جنسش از نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 813.1,
   "end": 817.88,
   "text": "نورم عین وجوده. \"الله نور السماوات والارض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 817.88,
   "end": 820.42,
   "text": "تمام ادراکات ما نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 820.42,
   "end": 822.34,
   "text": "ادراکات ما همه نوره. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 822.34,
   "end": 830.14,
   "text": "چون وصل به حسه وجودیمون، همون نفس ناطقه‌مون و نفس ناطقه‌مون وصل به الهیت نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 830.14,
   "end": 835.7,
   "text": "همون بحثی که قبلاً گذشت. را-- این رابطه اتصال ما با الهیت نظام هستی چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 835.7,
   "end": 838.76,
   "text": "همه نوره چون از وجود برخورد دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 838.76,
   "end": 842.82,
   "text": "توجه کردید. حالا هرچی این اجتهادش بیشتر می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 842.82,
   "end": 846.0,
   "text": "خب یعنی در حقیقت تجلی اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 846.0,
   "end": 848.58,
   "text": "یا اسم الله که به عبارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 848.58,
   "end": 852.0,
   "text": "حالا بهش می‌گن ملائکه الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 852.0,
   "end": 854.12,
   "text": "مثلاً ارباب مشرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 854.12,
   "end": 857.1,
   "text": "افلاطون میگه مثلاً فلسفه میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 857.1,
   "end": 860.08,
   "text": "ملائکه مثلاً عرفان میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 860.08,
   "end": 865.1,
   "text": "اسماء الله. این‌ها هرچی بیشتر پیاده بشه تو ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 865.1,
   "end": 868.36,
   "text": "شدت نورمون بیشتره. میگن فلانی نورانی‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 868.36,
   "end": 872.02,
   "text": "بعد علامه اشاره می‌کنه به این حدیث معروف از پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 872.02,
   "end": 874.04,
   "text": "چقدر زیبا و شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 874.04,
   "end": 877.12,
   "text": "دیگه فصل الخطاب. می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 877.12,
   "end": 880.28,
   "text": "\"العلم نور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 880.28,
   "end": 886.42,
   "text": "عجب! \"العلم نور يغرفهُ الله فی قلب من یشاء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 886.42,
   "end": 890.34,
   "text": "خدا اینو می‌ندازه. \"يغرفهُ الله\" می‌ندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 890.34,
   "end": 894.44,
   "text": "یعنی این‌طور نیست که خرد خرد، نه یک‌باره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 894.44,
   "end": 898.52,
   "text": "تن-- انزال می‌ده بهش، نازلش می‌کنه بر قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 898.52,
   "end": 901.58,
   "text": "میگه م-- \"بقلب من یشاء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 901.58,
   "end": 904.16,
   "text": "جایگاه نور علم قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 904.16,
   "end": 908.5,
   "text": "آیه چهل سوره نور رو هم اگر دقت کنید داره به همین اشاره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 908.5,
   "end": 912.82,
   "text": "این رو هم بخونم کامتون شیرین‌تر بشه، وجودتون نورانی‌تر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 912.82,
   "end": 914.88,
   "text": "\"ومن لم يجعل له\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 914.88,
   "end": 916.72,
   "text": "ببین فصل الخطابه‌ها این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 916.72,
   "end": 921.64,
   "text": "آیه چهل سوره نور. \"ومن لم يجعل الله له نورا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 921.64,
   "end": 925.2,
   "text": "هرکس که خدا \"لم يجعل الله له نورا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 925.2,
   "end": 928.64,
   "text": "هرکس که خدا براش نوری رو قرار نداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 928.64,
   "end": 931.26,
   "text": "\"فما له من نور\". نور کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 931.26,
   "end": 933.64,
   "text": "نوری نداره. کار خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 933.64,
   "end": 942.26,
   "text": "خدا باید دست به کار بشه \"من لدنا علما\" باشه از علم لدنّی خودش و باید چیکار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 942.26,
   "end": 947.04,
   "text": "حجاب‌ها رو درید. حجاب-- بعد قلب رو از حجاب خارج کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 947.04,
   "end": 949.02,
   "text": "تا بشه قلب منزل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 949.02,
   "end": 953.22,
   "text": "تا نازل بشه این نور، این علم من لدن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 953.22,
   "end": 955.5,
   "text": "علم لدنّی از حضرت حق نازل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 955.5,
   "end": 957.96,
   "text": "فقط کار خداست. که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 957.96,
   "end": 960.94,
   "text": "باید مراقب بود. به قول علامه باید کشیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 960.94,
   "end": 963.2,
   "text": "نفس داد. کشیک قلب داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 963.2,
   "end": 967.66,
   "text": "قلب. مخصوصاً خطورات و ادراکات قلبی خیلی مهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 967.66,
   "end": 970.58,
   "text": "خیلی متصل‌اند به نظام عقل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 970.58,
   "end": 972.18,
   "text": "حالا مراقب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 972.18,
   "end": 975.92,
   "text": "بعضیا میان سؤال می‌کنن آقا ما مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 975.92,
   "end": 977.9,
   "text": "از صبح تا شب می‌بینیم مراقبیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 977.9,
   "end": 979.6,
   "text": "هیچ گناهی از ما سر نزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 979.6,
   "end": 982.38,
   "text": "این سؤال پیش اومده. می‌پرسن از ما بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 982.38,
   "end": 985.68,
   "text": "آقا من مثلاً یه روز صبح تا شب کاملاً مراقب کارهام بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 985.68,
   "end": 989.62,
   "text": "کشیک قلب دادم. اما حالم خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 989.62,
   "end": 993.2,
   "text": "ها؟ اینطوری پیش میاد برای بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 993.2,
   "end": 995.58,
   "text": "خب جوابشو اجازه بدید از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 995.58,
   "end": 999.2,
   "text": "لسان گوهربار حضرت آیت الله‌الحق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 999.2,
   "end": 1006.08,
   "text": "حضرت آیت الله سعادت‌پرور یا پهلوانی که رهبر عزیزمون خیلی ایشون رو با عظمت یاد کردن بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1006.08,
   "end": 1008.32,
   "text": "ایشون چه جوابی می‌دن اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1008.32,
   "end": 1014.98,
   "text": "ایشون می‌فرمایند که طرح-- یعنی، یعنی با یه اشاره‌ای یه چیزی رو می‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1014.98,
   "end": 1017.38,
   "text": "می‌فرمایند که این اس-- این س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1017.38,
   "end": 1020.56,
   "text": "ذکر رو زیاد بگید اگه گرفتار این قصه شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1020.56,
   "end": 1022.3,
   "text": "مراقبه کردید، نمی‌دونید چتونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1022.3,
   "end": 1025.26,
   "text": "حالتون خوب نیست. بگید \"استغفر الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1025.26,
   "end": 1031.96,
   "text": "به این شکل \"استغفر الله من جميع ما کره الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1031.96,
   "end": 1035.12,
   "text": "از هر چیزی که خدا خوشش نمیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1035.12,
   "end": 1038.08,
   "text": "کریه، بده پیش خدا بدش میاد از این ه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1038.08,
   "end": 1041.36,
   "text": "چون تو مراقبه کردی. کشیک دادی اما نمی‌دونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1041.36,
   "end": 1044.36,
   "text": "شاید یه کاری بوده، یه نفس یه آدم ناپاکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1044.36,
   "end": 1046.32,
   "text": "از بیرون بود یا از داخل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1046.32,
   "end": 1051.62,
   "text": "یه چیزی بوده که خدا از اون بدش میومده که تو حالت اینه و تو بی‌خبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1051.62,
   "end": 1055.24,
   "text": "خب اینجا بپرس به خدا بگو خدایا تو اینو برطرف کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1055.24,
   "end": 1057.94,
   "text": "\"استغفر الله من جميع ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1057.94,
   "end": 1064.94,
   "text": "کهر، کره الله\". ان شا الله که عاقبتون ختم بخیر بشود به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1064.94,
   "end": 1069.6,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}