 "chapters": [
  {
   "index": 0,
   "title": "## ذکر مطلق در نمازهای اخفاتی جماعت",
   "start": 10.78,
   "end": 84.16
  },
  {
   "index": 1,
   "title": "## قلب منزل؛ محل نزول فیض",
   "start": 84.16,
   "end": 299.0
  },
  {
   "index": 2,
   "title": "## برکت بحث قلوب و حدیث حرم‌الله",
   "start": 299.0,
   "end": 530.26
  },
  {
   "index": 3,
   "title": "## رفع و نفع؛ رافضی و نافذ؛ خانه‌تکانی دل",
   "start": 530.26,
   "end": 703.18
  },
  {
   "index": 4,
   "title": "## غبار ملکات و خیال مشوش",
   "start": 703.18,
   "end": 821.52
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 4.42,
   "text": "بسم الله الرحمن الرحیم. السلام علیکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.42,
   "end": 8.04,
   "text": "ای داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.04,
   "end": 10.78,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.78,
   "end": 15.34,
   "text": "در خصوص احکام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.34,
   "end": 20.22,
   "text": "عرض کنیم که اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.22,
   "end": 26.46,
   "text": "انسان در مأموم در نماز جماعت در نمازهای اخفاتیه باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.46,
   "end": 30.48,
   "text": "یعنی مثلا نمازهای ظهر و عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.48,
   "end": 36.82,
   "text": "که امام هم باید آهسته حمد و سوره رو بخونه و ذکر رو بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.82,
   "end": 44.34,
   "text": "اینجا مأموم در این نمازها فقط می‌تواند چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.34,
   "end": 51.68,
   "text": "چیزی نمی‌شنوه دیگه ذکر امام رو استماع نمی‌کنه، اجازه دارد ذکر مطلق بگوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.68,
   "end": 55.16,
   "text": "ذکر مطلق حتی آیات قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.16,
   "end": 60.48,
   "text": "یعنی مثلا امام داره مثل الان نماز ظهر و عصر رو ما داشتیم می‌خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.48,
   "end": 64.04,
   "text": "خب شما میگید امام ساکته تو هم ساکتی برای چی ساکت باشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.04,
   "end": 71.22,
   "text": "یه ذکری بگی. اشکال نداره هر ذکر مطلق هر ذکری و آیات قرآن حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.22,
   "end": 73.68,
   "text": "اما در نمازهای جهریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.68,
   "end": 78.82,
   "text": "صبح و مغرب و عشا این‌ها رو که امام داره ذکر میگه حمد و سوره می‌خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.82,
   "end": 80.64,
   "text": "باید سکوت کامل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.64,
   "end": 84.16,
   "text": "حق ذکر گفتن کسی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.16,
   "end": 90.88,
   "text": "به فضل الهی به امید عنایت حضرت حجت سلام الله علیه ورود می‌کنیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.88,
   "end": 94.08,
   "text": "عنوان جدید قلبمون که قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.08,
   "end": 96.0,
   "text": "منزل هست. منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.0,
   "end": 98.66,
   "text": "در مَضْمُن مَفْعِل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.66,
   "end": 103.38,
   "text": "یعنی محل نزول قلبی که محل نزول است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.38,
   "end": 110.32,
   "text": "از کجا اقتباس شده؟ به عنوان نمونه از آیه نود و هفت سوره بقره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.32,
   "end": 113.88,
   "text": "سوره بقره نود و هفت رو ملاحظه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.88,
   "end": 117.34,
   "text": "اونجا می‌فرماید \"قل من كان عدوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.34,
   "end": 121.4,
   "text": "لجبرائیل\" پیغمبر بگو هر کسی که دشمنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.4,
   "end": 126.6,
   "text": "جبرائیل رو داره دشمن اوست، عدو اوست \"فإنه\" بداند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.6,
   "end": 129.04,
   "text": "او یعنی جبرائیل کارش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.04,
   "end": 132.4,
   "text": "برای چی دشمنی می‌کنی باهاش؟ کارش اینه \"نزله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.4,
   "end": 137.42,
   "text": "على قلبك، على قلبك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.42,
   "end": 140.62,
   "text": "او نازل کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.62,
   "end": 144.64,
   "text": "بر قلب تو و نازل می‌کنه البته به اذن الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.64,
   "end": 150.2,
   "text": "به اذن خدا \"مصدق لما بین یده و هدى وبشرى للمؤمنین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.2,
   "end": 154.58,
   "text": "تصدیق آنچه که قبلاً بوده و البته هدایت و بشرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.58,
   "end": 156.86,
   "text": "و بشارت است بر اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.86,
   "end": 161.06,
   "text": "آنچه که نازل می‌شه. نکته اینجاست البته پرنکته‌ست آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.06,
   "end": 163.38,
   "text": "آنچه که مدنظر ماست این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.38,
   "end": 166.24,
   "text": "\"على قلبك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.24,
   "end": 172.34,
   "text": "بر قلب تو یعنی محل نزول شده قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.34,
   "end": 178.24,
   "text": "قلب. این حالا به یک معنا اولین روزهایی که به فضل الهی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.24,
   "end": 180.1,
   "text": "شروع کردیم بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.1,
   "end": 183.2,
   "text": "در قرآن رو اونجا عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.2,
   "end": 186.96,
   "text": "ماحصل آنچه که از ما می‌مونه بعد از مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.96,
   "end": 193.16,
   "text": "قلب ماست. به عبارتی الهیت وجود ما و نقطه اتصال ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.16,
   "end": 196.24,
   "text": "با ذات حضرت حق است که اگر که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.24,
   "end": 200.76,
   "text": "اگر حالا حجاب برمی‌داره محجوب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.76,
   "end": 204.18,
   "text": "اما اینکه کلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.18,
   "end": 207.8,
   "text": "از بین بره و این قلب کلاً مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.8,
   "end": 213.22,
   "text": "بگیم دلش مرد کلاً یعنی به معنای این باشه که یعنی اتصالش کلاً قطع شد نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.22,
   "end": 216.04,
   "text": "اصلاً این امکان‌پذیر نیست. راه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.04,
   "end": 219.32,
   "text": "به قول حضرت علامه حسن زاده اصلاً راه نداره همچین چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.32,
   "end": 222.48,
   "text": "چرا؟ چون همونطور که قبلاً عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.48,
   "end": 226.96,
   "text": "در سیر طولی نزولیه‌ همه چی نازل شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.96,
   "end": 231.94,
   "text": "\"من شيئ إلا و عندنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.94,
   "end": 235.86,
   "text": "إلا عندنا\" واو نداره \"إلا عندنا خزائنه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.86,
   "end": 239.14,
   "text": "هیچ چیزی نیست مگر اینکه خزينه‌ش پیش ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.14,
   "end": 242.66,
   "text": "و نو، و نو \"وما ننزله إلا بقدر معلوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.66,
   "end": 246.62,
   "text": "اینکه همه چی پیش ماست و همه چی نازل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.62,
   "end": 250.26,
   "text": "و ما هم نازل شدیم. خود انسان هم تنزل پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.26,
   "end": 253.98,
   "text": "این مهمه که ما بدانیم آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 253.98,
   "end": 258.76,
   "text": "به ما می‌رسد از فياض علی الاطلاق از فیوضات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.76,
   "end": 260.94,
   "text": "از الهامات، از الح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 260.94,
   "end": 265.88,
   "text": "القاءات. حالا اون معنای اتم‌ش، وحی این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.88,
   "end": 269.48,
   "text": "که حالا باید بعداً انشاالله بحث کنیم که این‌ها چه فرقی با هم می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.48,
   "end": 273.96,
   "text": "مثلاً القا با الهام، وحی این‌ها چه فرقی با هم دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.96,
   "end": 276.48,
   "text": "با فهمیدن، با تعقل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.48,
   "end": 278.68,
   "text": "یه چیزایی که قبلاً ها گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.68,
   "end": 280.7,
   "text": "به هر حال این‌ها همشون کجا میان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.7,
   "end": 284.24,
   "text": "در کجا فرود میان؟ در قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.24,
   "end": 286.04,
   "text": "نقطه نزول قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.04,
   "end": 288.28,
   "text": "لذا می‌گه \"على قلبك\" این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.28,
   "end": 292.76,
   "text": "منزل قلبه. بهش می‌گیم اصطلاحاً قلب منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.76,
   "end": 294.48,
   "text": "که باید در اونجا نازل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.48,
   "end": 299.0,
   "text": "منزل یعنی جایی که نازل می‌شن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 299.0,
   "end": 301.44,
   "text": "که حالا خدا برکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 301.44,
   "end": 305.52,
   "text": "ما هم حقیقتش اون اول که شروع کردیم فکر نمی‌کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.52,
   "end": 313.46,
   "text": "انقدر برکت کنه. ما می‌خواستیم پیرامون هر قلبی که حالا طبق پژوهشی که کردیم بیش از شصت قلب در قرآن پیدا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.46,
   "end": 316.66,
   "text": "حالا مثلا هر قلبی رو یکی دو جلسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.66,
   "end": 318.74,
   "text": "اما وقتی میری تو دریای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.74,
   "end": 326.08,
   "text": "بیکران این حقایق و آیات و این‌ها و بعد کلمات بزرگان رو می‌بینی، می‌بینی هرچی میگی تمومی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.08,
   "end": 328.24,
   "text": "\"لا نفاد لكلمة الله\" اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.24,
   "end": 330.5,
   "text": "نفاد نداره، پایان نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.5,
   "end": 334.38,
   "text": "و شاید هم اتفاقاً دیروز داشتم فکر می‌کردم شاید برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.38,
   "end": 338.42,
   "text": "این جلسات قلب در قرآن ما که اصلاً همین ما اصلاً دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.42,
   "end": 342.82,
   "text": "هیچی نبودیم، همین برکتش بودیم که الحمد لله دیدیم برکتشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.82,
   "end": 350.3,
   "text": "این‌ها شاید به برکت اون یادواری‌ایه که ما از حضرت علامه حسن زاده گرفتیم که خدمتشون عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.3,
   "end": 353.44,
   "text": "شاید ما تا آخر عمر شما رو دیگه ندیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.44,
   "end": 358.16,
   "text": "یه چیزی به ما بدید که تا آخر عمر-- حالا ایشون سه تا هدیه به ما داد اون موقع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.16,
   "end": 360.98,
   "text": "یکیش این بود که اون حدیثی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.98,
   "end": 364.34,
   "text": "امام صادق صلی الله علیه و آله فرمودند در خصوص قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.34,
   "end": 369.1,
   "text": "و مرحوم شیخ صدوق علیه الرحمة در انتهاء معانی الأحد-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 369.1,
   "end": 371.74,
   "text": "اِاِاِ جام معانی الاخبار بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.74,
   "end": 377.56,
   "text": "اونجا آورده در اونجا جامع الاخبار ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.56,
   "end": 381.9,
   "text": "تو معانی نیست، تو جامع. اونجا تو انتهای کتاب آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.9,
   "end": 384.24,
   "text": "علامه از دستخط مبارکش نوشت به ما داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 384.24,
   "end": 388.1,
   "text": "البته ما یه غزلی به ایشون هدیه کردیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 388.1,
   "end": 392.2,
   "text": "بهشون دادیم و ایشون خوند و بعد این رو تبرکاً به ما هدیه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 392.2,
   "end": 397.48,
   "text": "این همین حدیث بود که القلب حرم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.48,
   "end": 401.38,
   "text": "ولا تسکن فی حرم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.38,
   "end": 406.6,
   "text": "غیر الله. بعضی از جاها منابع دیدم این فی رو نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.6,
   "end": 409.0,
   "text": "که بگه حالا چون فی جار است میگه هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.0,
   "end": 411.82,
   "text": "فی که میاد میشه حرم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.82,
   "end": 414.38,
   "text": "حرم مجرور میشه حرم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.38,
   "end": 417.36,
   "text": "فی رو برداری خب حرم الله یا حرم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.36,
   "end": 420.02,
   "text": "در هر حال میگه قلب حرم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.02,
   "end": 425.22,
   "text": "هیچ چیزی رو در حرم خدا نباید جای بدی جز خود خدا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.22,
   "end": 430.46,
   "text": "پس آنچه که در قلب نازل می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 430.46,
   "end": 436.42,
   "text": "اگر از سمت حضرت حق بگیری، حق نازل می‌شود با شؤوناتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 436.42,
   "end": 439.32,
   "text": "چی باعث می‌شه که قلب بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 439.32,
   "end": 443.18,
   "text": "منزل الهامات، القاءات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.18,
   "end": 446.82,
   "text": "و وحی نباشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.82,
   "end": 448.62,
   "text": "چی باعث می‌شه؟ همون حجاب‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 448.62,
   "end": 451.82,
   "text": "چیز عجیبی نیست. حجاب‌ها باعث می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.82,
   "end": 453.96,
   "text": "که نازل نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.96,
   "end": 457.62,
   "text": "اگرچه نازل می‌شود البته این نمیشه گفت نازل نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.62,
   "end": 459.72,
   "text": "حقایق آن‌فآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.72,
   "end": 463.46,
   "text": "در حال نزول‌اند چون سیل طولی گفتیم نزولیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 463.46,
   "end": 467.1,
   "text": "اصلاً و کل یوم هو فی شأن اینکه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.1,
   "end": 469.62,
   "text": "کل یوم هر روز هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 469.62,
   "end": 472.76,
   "text": "همون هو که قل هو الله احد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 472.76,
   "end": 477.82,
   "text": "همون هو که هو الاول والاخر والظاهر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 477.82,
   "end": 485.38,
   "text": "این هو در هر روز و کل یوم هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.38,
   "end": 488.32,
   "text": "در چیه؟ فی شأن. توی شأن جدیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.32,
   "end": 490.56,
   "text": "یعنی به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 490.56,
   "end": 494.22,
   "text": "در میشه گفت مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 494.22,
   "end": 496.74,
   "text": "تنزل یا انزال یا تنزیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 496.74,
   "end": 500.0,
   "text": "حالا اینا هم با هم فرق می‌کنند که بعداً می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 500.0,
   "end": 502.0,
   "text": "یعنی حقایق داره نازل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.0,
   "end": 506.32,
   "text": "به یک معنا اون خود حضرت حق هم که ذو مراتب هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 506.32,
   "end": 508.5,
   "text": "چه اسم‌هاشون، چه صفاتشون، این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 508.5,
   "end": 512.34,
   "text": "در حال تنزل‌اند. یعنی خدا آن به آن داره در تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 512.34,
   "end": 515.9,
   "text": "حقایق حقه در تو تنزل می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 515.9,
   "end": 517.68,
   "text": "که ان الله کل الاشیاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 517.68,
   "end": 520.68,
   "text": "ان الله کل الاشیاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 520.68,
   "end": 525.14,
   "text": "خب اگر این قلب محجوب باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 525.14,
   "end": 530.26,
   "text": "دیگه چه نزولی؟ نزول صورت می‌گیره اما وارد قلب تو نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 530.26,
   "end": 533.04,
   "text": "حالا اینجا یه نکته‌ای رو عرض کنم تبرکاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 533.04,
   "end": 536.9,
   "text": "این رو خوب برای اینکه چون خیلی مهمه بعد از این دیگه حرف نمی‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 536.9,
   "end": 540.84,
   "text": "یعنی همین نقطه پایونیمون باشه روش خوب توجه کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 540.84,
   "end": 543.44,
   "text": "که در فکر می‌کنم مدخل اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 543.44,
   "end": 546.52,
   "text": "شرح فصوص القیسری بود از حضرت علامه شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 546.52,
   "end": 550.22,
   "text": "ایشون اشاره کردن به مقامات العارفین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 550.22,
   "end": 554.28,
   "text": "شیخ در نعمت چهارم اشارات و فرمودند اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 554.28,
   "end": 557.32,
   "text": "حضرت شیخ الرئیس وقتی میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 557.32,
   "end": 559.86,
   "text": "مقامات العارفین رو بیان می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 559.86,
   "end": 563.68,
   "text": "می‌فرمایند که ما یک رفع داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 563.68,
   "end": 566.06,
   "text": "یک نفع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 566.06,
   "end": 569.54,
   "text": "رفع مثلاً به شیعه‌ها میگن رافضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.54,
   "end": 572.8,
   "text": "چرا میگن رافضی؟ رفع یعنی پشت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.8,
   "end": 575.76,
   "text": "به قول علامه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 575.76,
   "end": 577.98,
   "text": "اِاِاِ رو برگردوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 577.98,
   "end": 580.74,
   "text": "رو برگردوندن مثلاً از دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 580.74,
   "end": 587.36,
   "text": "به این میگن رفع. از این جهت به ما شیعه‌ها اون وهابی‌ها میگن رافضی، شیعه رافضی اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.36,
   "end": 590.72,
   "text": "که میگن اینا اصلاً کلاً پشت کردن به اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 590.72,
   "end": 592.66,
   "text": "اونا اعتقادشون نسبت به ما شیعه‌ها اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 592.66,
   "end": 595.7,
   "text": "برای همین میگن رافضی. رفع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 595.7,
   "end": 602.58,
   "text": "شی-- اونجا شیخ الرئیس می‌فرماد که در مقامات العارفین می‌فرمود این حجاب‌ها برطرف نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 602.58,
   "end": 608.02,
   "text": "علت اینکه بسیاری از الهامات و القاءات الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 608.02,
   "end": 614.86,
   "text": "و تنزلات وحیانی بر قلب ما نازل نمی‌شود این است که ما اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 614.86,
   "end": 620.9,
   "text": "رفع رو داریم یعنی پشت کردیم مثلاً به باطل، به دنیا اینا اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 620.9,
   "end": 623.88,
   "text": "به نفع نرسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 623.88,
   "end": 626.65,
   "text": "نفع با صاد و اد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 626.65,
   "end": 629.82,
   "text": "اونجا می‌فرماید مقام خانه تکانیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 629.82,
   "end": 632.46,
   "text": "اونم علامه اینطوری بازش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 632.46,
   "end": 635.72,
   "text": "تو همون مدخل شرح فصوص القیسری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 635.72,
   "end": 639.72,
   "text": "علامه می‌فرمود نه اینکه تو جارو دستت بگیری خانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 639.72,
   "end": 642.1,
   "text": "دلت رو جاروب کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 642.1,
   "end": 644.84,
   "text": "حالا جارو کن. هنوز توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 644.84,
   "end": 647.16,
   "text": "فرش‌ها خاک هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 647.16,
   "end": 649.98,
   "text": "غبار هست. رو دیوارها غبار هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 649.98,
   "end": 655.84,
   "text": "تو فقط این آشغال‌های روین رو برداشتی با جارو شستی، مثلاً برطرف کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 655.84,
   "end": 659.06,
   "text": "هنوز اون غبارها، خاک‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 659.06,
   "end": 666.04,
   "text": "حضرت علامه لذا به اینجا که می‌رسه می‌فرماید باید فرش رو گرفت تکون تا اون غبار و خاک درونش بریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 666.04,
   "end": 669.18,
   "text": "بتکونی. خانه تکاندن یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 669.18,
   "end": 672.48,
   "text": "نه جا-- نه خانه جاروب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 672.48,
   "end": 675.76,
   "text": "که اگر این نباشد یعنی تکاندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 675.76,
   "end": 680.62,
   "text": "نباشد باز تنزلی نیست بر قلب تو البته، بر قلب من البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 680.62,
   "end": 682.24,
   "text": "و الا تنزل که دائماً هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 682.24,
   "end": 686.4,
   "text": "انزال نیست، تنزيل نیست. حالا اینا معناش چه فرق می‌کنه بعداً انشالله عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 686.4,
   "end": 691.06,
   "text": "خیلی شیرینه. خوبه بدونید که همه ما در معرضش هستیم و باید بدونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 691.06,
   "end": 694.64,
   "text": "صرفاً انزال و تنزيل رو در قرآن به قلب پیغمبر ندونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 694.64,
   "end": 697.94,
   "text": "بر ما هم هست. حالا بعداً متوجه می‌شیم چگونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 697.94,
   "end": 703.18,
   "text": "ما هم انزال دفعی داریم، انزال تدریجی داریم خود قلب ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 703.18,
   "end": 707.02,
   "text": "خود من امروز داشتم فکر می‌کردم به این قصه به این نتیجه رسیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 707.02,
   "end": 709.6,
   "text": "که این نتیجه رو روش زوم کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 709.6,
   "end": 712.4,
   "text": "که به نظر بنده حقیر این استنباط بنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 712.4,
   "end": 719.1,
   "text": "اون خاک و غبار و این‌ها که میگه داخل خاکه، داخل فرشه، حضرت علامه می‌فرمودین باید بتکونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 719.1,
   "end": 723.84,
   "text": "خب اون آشغالا که معاصین و حجاب‌ها اینا رو برطرف کردی رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 723.84,
   "end": 725.78,
   "text": "گناه هم نمی‌کنی. پشت به دنیا هم کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 725.78,
   "end": 728.46,
   "text": "چرا باز تنزلی نیست بر قلب من؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 728.46,
   "end": 733.42,
   "text": "اون غبارها آثار گناهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 733.42,
   "end": 736.82,
   "text": "به یک معنا می‌شه گفت ملکات نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 736.82,
   "end": 741.66,
   "text": "تو الان کَندی اما اون صور و اشکال مدهشه، وحشتناک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 741.66,
   "end": 747.36,
   "text": "زشت، کریه، اینایی که تو ذهنت، تو قوه خیالت هنوز مونده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 747.36,
   "end": 751.46,
   "text": "اون خیال مشوش، اون تخیلات فاسده، اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 751.46,
   "end": 754.52,
   "text": "تخیلات فاسده به قول علامه اینا رو چه می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 754.52,
   "end": 758.12,
   "text": "خب تموم شد. دیگه سعی می‌کنی نگاه به نامحرم نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 758.12,
   "end": 760.3,
   "text": "دیگه سعی می‌کنم گوش به حرام ندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 760.3,
   "end": 762.32,
   "text": "دیگه سعی می‌کنم زبانم به نا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 762.32,
   "end": 764.32,
   "text": "به حرام باز نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 764.32,
   "end": 766.08,
   "text": "اما با قوه خیالم چه کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 766.08,
   "end": 771.48,
   "text": "با قوه وهمم چه کنم که به شدت آلوده است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 771.48,
   "end": 779.46,
   "text": "به عقل غیر متوحدم چه کنم که پراکنده شده، مشوبه به وهم شده، اصلاً توحد نداره، متشتته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 779.46,
   "end": 782.0,
   "text": "این‌ها آثار، این‌ها همون غبار هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 782.0,
   "end": 784.94,
   "text": "می‌شه گفت به یک معنا همون ملکات نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 784.94,
   "end": 787.66,
   "text": "که اجازه بدید بعداً درباره‌ش صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 787.66,
   "end": 791.5,
   "text": "پس باید سعی کنیم به نه فقط رفع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 791.5,
   "end": 794.22,
   "text": "یعنی نه فقط رافظ باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 794.22,
   "end": 797.08,
   "text": "تا الهامات و القاءات الهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 797.08,
   "end": 799.62,
   "text": "اخذ کنیم بلکه ناف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 799.62,
   "end": 802.38,
   "text": "نافذ باشیم. نفع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 802.38,
   "end": 804.14,
   "text": "رافظ و نافذ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 804.14,
   "end": 807.24,
   "text": "بتکونیم دل رو. انشالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 807.24,
   "end": 809.0,
   "text": "عاقبتمون ختم بخیر باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 809.0,
   "end": 811.92,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 811.92,
   "end": 821.52,
   "text": "اللهم صل على محمد آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}