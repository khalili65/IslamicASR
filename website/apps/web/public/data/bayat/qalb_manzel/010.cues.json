 },
 "chapters": [
  {
   "index": 0,
   "title": "## طول نماز جماعت در ادارات و حقوق ارباب‌رجوع",
   "start": 7.12,
   "end": 104.92
  },
  {
   "index": 1,
   "title": "## رأفت امام و ضرورت سلسله‌مراتب",
   "start": 104.92,
   "end": 342.6
  },
  {
   "index": 2,
   "title": "## جلالت ضریح و جمع جمال و جلال",
   "start": 342.6,
   "end": 902.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.16,
   "end": 3.92,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.92,
   "end": 7.12,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.12,
   "end": 10.12,
   "text": "نکته‌ای که می‌خواستم پیرامون احکام بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.12,
   "end": 15.56,
   "text": "عزیزمون یاد و برکت در خصوص اتفاقا نماز جماعت‌های در اداراته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.56,
   "end": 19.46,
   "text": "سازمان‌ها و ادارات مثل همینجا مثلا سازمان صدا و سیما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.46,
   "end": 21.68,
   "text": "استفتایی که از رهبر شده آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.68,
   "end": 28.88,
   "text": "این طول دادن نماز جماعت به هر دلیلی حالا یا مثلا امام خیلی کشش میده، قوسش میده اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.88,
   "end": 35.66,
   "text": "یا نه قبل و بعد یا در اثنای نماز بین نماز مستحبات زیاد انجام می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.66,
   "end": 42.52,
   "text": "انواع هم هستن بعضی جاها حتی دعا توسل رو یا عاشورا رو بین دو نماز میاد، سخنرانی رو بین دو نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.52,
   "end": 45.6,
   "text": "می‌کنن اینا. آیا این اشکال داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.6,
   "end": 51.28,
   "text": "رهبر عزیزمون فرمودن در صورتی که تضییع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.28,
   "end": 54.98,
   "text": "حقوق اون کسی که میاد حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.98,
   "end": 60.84,
   "text": "بهش می‌گن ارباب رجوع، تض-تضییع حقوق از ارباب رجوع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.84,
   "end": 64.02,
   "text": "یک. حالا اونی که ارباب رجوع ندارن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.02,
   "end": 68.38,
   "text": "کار اداری‌شون به جهت این طول کشیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.38,
   "end": 70.64,
   "text": "کار نماز حالا اون مستحبات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.64,
   "end": 73.54,
   "text": "اون کار عقب بیفته، کار اداری‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.54,
   "end": 76.4,
   "text": "مختل بشه. اختلال در کار اداری‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.4,
   "end": 80.06,
   "text": "در این دو صورت اگر اینها باشه اشکال داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.06,
   "end": 84.78,
   "text": "نماز جماعت طول بکشه. خب بهتر اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.78,
   "end": 91.6,
   "text": "مثل همین جا صحبت بعد از نماز عصر باشه و بعد یه تسبيحت از ازده رو کفایت کن و دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.6,
   "end": 94.52,
   "text": "برنامه‌های دیگه هم که، اِاِاِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.52,
   "end": 100.68,
   "text": "ربطی به نماز نداره. کسی واقعا ارباب رجوع نداشت، مشکل اختلالی در کارش ایجاد نمی‌شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.68,
   "end": 104.7,
   "text": "می‌تونه بیاد شرکت کنه خوبم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.7,
   "end": 110.06,
   "text": "اما اجازه بفرمایید که بحث دیروز رو که عزیزان گفتن خیلی شیرین بوده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.06,
   "end": 114.48,
   "text": "چون سوالی پیش اومد ادامه بدیم والا کاملا مبرهن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.48,
   "end": 116.54,
   "text": "سؤال اینجا این چنین پیش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.54,
   "end": 122.52,
   "text": "عزیزان ریختن سر ما دیروز که آقا شما می‌گید که شأن امام عصر صلوات الله علیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.52,
   "end": 126.98,
   "text": "اممم فوق اینه که ما بریم حاجتمون رو از امام بخواهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.98,
   "end": 131.74,
   "text": "اون قطب الاقطاب بعد قوص اعظم، ذی قطب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.74,
   "end": 134.96,
   "text": "حالا قطب الاقطاب رو اگر قوص اعظم بگیریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.96,
   "end": 139.92,
   "text": "ذی قطب و امام و این چنین سلسله‌ای که دیروز گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.92,
   "end": 143.38,
   "text": "اوتاد و ابدال و نجبا و نقبا اینها یا نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.38,
   "end": 146.52,
   "text": "بگیم اون قطب الاقطاب امام است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.52,
   "end": 151.28,
   "text": "قوص الاعظم ذی قطب بشود یه حلقه اول یعنی یه نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.28,
   "end": 153.62,
   "text": "اون رو می‌تونیم نائب امام بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.62,
   "end": 156.3,
   "text": "اگه به این نگاه ببینیم که دیروز اینو من نگفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.3,
   "end": 162.22,
   "text": "اون نفر اول رو ذی قطب رو اگر به این شکل قطب الاقطاب رو امام بگیریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.22,
   "end": 165.5,
   "text": "ذی قطب یعنی حلقه اول می‌شود نائب امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.5,
   "end": 169.04,
   "text": "حالا این نیابت می‌تونه خاص باشه یا عام که الان عامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.04,
   "end": 173.38,
   "text": "ولی فقیه می‌شه عام. که حالا من اینجا خیلی حرف دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.38,
   "end": 179.04,
   "text": "اینجا خیلی حرف دارم تو ذی قطب که اینا جاش نیست الان بعدا رسانه‌ای می‌شه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.04,
   "end": 181.84,
   "text": "یعنی ظرفیت‌ها اقتضا نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.84,
   "end": 186.06,
   "text": "جایگاه نا-نیابت امام کجاست و چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.06,
   "end": 190.36,
   "text": "خب اینجا این سؤال پیش میاد که آقا اون رأفت امام چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.36,
   "end": 197.3,
   "text": "الامام نه کل والد شفیق هم نه، بلکه ال والد شفیق یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.3,
   "end": 202.1,
   "text": "اصلا پدر به شدت مهربانه، نه مثل پدر مهربان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.1,
   "end": 204.32,
   "text": "خب ما این رابطه چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.32,
   "end": 207.86,
   "text": "یعنی چی شما می‌گید باید سلسله مراتب حذف بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.86,
   "end": 210.96,
   "text": "اولا این سلسله مراتب باید حذف بشه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.96,
   "end": 214.94,
   "text": "خدای منان ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.94,
   "end": 219.7,
   "text": "زی-- ذات مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.7,
   "end": 222.34,
   "text": "شدت و ضعف در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.34,
   "end": 223.96,
   "text": "در حقیقت در مراتبشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.96,
   "end": 227.56,
   "text": "یک ذاتی‌ست، ذات اهدی صمدی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.56,
   "end": 231.8,
   "text": "که دارای مراتب در شدت و ضعفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.8,
   "end": 234.3,
   "text": "اینو تو الهیات شفا می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.3,
   "end": 242.04,
   "text": "توی کتاب‌های عرفانی مثل فصوص و مصباح و تمهید القواعد و اینا می‌خونیم نه، ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.04,
   "end": 246.06,
   "text": "خدای منان، ذات اهدی صمدیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.06,
   "end": 251.14,
   "text": "ذو مظاهر ثعه و ضیغه یعنی مظاهرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.14,
   "end": 253.62,
   "text": "مظاهر خدا رو مراتب می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 253.62,
   "end": 257.12,
   "text": "مثل این‌که یکی از مظاهر خدا انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 257.12,
   "end": 259.64,
   "text": "مراتبش اعظم از همه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.64,
   "end": 265.06,
   "text": "مظاهر دیگه‌ی خدا. ذو مراتب رو میایم رو اون رو ذو مظاهر پیاده می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.06,
   "end": 269.48,
   "text": "در هر حال خود حضرت حق هم مراتب و مظاهرش با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.48,
   "end": 272.94,
   "text": "تعدد دارن، ثعه و ضیغ دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.94,
   "end": 275.5,
   "text": "شدت و ضعف دارن. این یک اصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.5,
   "end": 278.88,
   "text": "ولن تجد لسنت الله تبدیلا و تحویلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.88,
   "end": 282.32,
   "text": "شما آب رو می‌تونی مستقیم بریزی رو آتیش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.32,
   "end": 284.02,
   "text": "اثر همگر رو خنثی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.02,
   "end": 286.76,
   "text": "باید یک واسطه‌ای باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.76,
   "end": 288.64,
   "text": "اون واسطه بهش می‌گن برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.64,
   "end": 294.2,
   "text": "رز-لذا در حکمت و عرفان یکی از اسامی امام عصر برزخ جامع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.2,
   "end": 298.42,
   "text": "مثل اون مثلا بلا تشبیه مثل اون قابلمه‌ای که آب می‌ریزن توش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.42,
   "end": 303.9,
   "text": "داغی آتش داره آب رو می‌جوشونه اما به واس-- به وساطت اون ظرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.9,
   "end": 308.56,
   "text": "اصلا نمی‌شه، امکانش نیست مستقیم با خدا مرتبط شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.56,
   "end": 313.74,
   "text": "باید یه واسطه‌ای باشه و شما همین طوری هم بری مستقیم با امامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.74,
   "end": 317.46,
   "text": "مرتبط بشی باز باید یه واسطه‌ای باشه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.46,
   "end": 320.16,
   "text": "نظام هستی ذو مراتب است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.16,
   "end": 325.02,
   "text": "ذو درجات است. تازه حضرت آقا علم الحسن زاده که اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.02,
   "end": 326.98,
   "text": "فوق این. می‌گه آقا حتی یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.98,
   "end": 330.72,
   "text": "نمی‌گه قیامت نمی‌فرمون اقرأ ورقق بخوان بالا برو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.72,
   "end": 333.68,
   "text": "هر آیه قرآن که می‌خونی یه درجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.68,
   "end": 338.68,
   "text": "اتفاقا علم الحسن زاده می‌فرمود اونچه که اینو خوب دقت کنید خیلی به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.68,
   "end": 343.96,
   "text": "اونچه که شما از این آیه اخذ کردی و تو وجودت پیاده شد، اون درجته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.96,
   "end": 351.76,
   "text": "نه این آیه. والا هر آیه، حدیث داریم هر یک حرف یک آیه، یک حرف آیه تا قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.76,
   "end": 355.06,
   "text": "هفتاد هزار تأویل و معنا داره، عمق داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.06,
   "end": 357.18,
   "text": "هفتاد هزار هم عدد کثرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.18,
   "end": 361.5,
   "text": "چه برسه به یک آیه. تو از این آیه چه میز-چه میزان درک کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.5,
   "end": 364.62,
   "text": "چه میزان اخذ کردی؟ چقدر متحقق شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.62,
   "end": 367.92,
   "text": "در وجودت پیاده شد، اون می‌شه درجه تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.92,
   "end": 370.52,
   "text": "از همین آیه یکی دیگه بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.52,
   "end": 374.54,
   "text": "کسب کرد، اخذ کرد، فیض برد، درجه اون به مراتب...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.54,
   "end": 380.62,
   "text": "می‌خوام بگم حتی یک آیه هم درجات داره، یک حرف قرآن درجات داره چه برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.62,
   "end": 383.56,
   "text": "پس این زومراتب باید حفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.56,
   "end": 385.76,
   "text": "ضمن اینکه من این مثال رو زدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.76,
   "end": 393.28,
   "text": "الان شما اگه بری مثلا پیش پروفسور سمعی که نفر اول هم حالا تو حالا مغز و اعصاب نفر اول دنیاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.28,
   "end": 395.76,
   "text": "زشت نیست، اصلا این دون شأن ایشون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.76,
   "end": 400.56,
   "text": "شما بری به ایشون بگی آقا من می‌خوام یه آمپول بزنم، بیا به من آمپول بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.56,
   "end": 402.18,
   "text": "درسته؟ اصلا این کار درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.18,
   "end": 406.44,
   "text": "عاقلانه است این کار؟ شما رو شماتت نمی‌کنم به خاطر این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.44,
   "end": 409.6,
   "text": "هر چیزی یه مرتبتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.6,
   "end": 414.18,
   "text": "اینجا که می‌رسیم مرحوم آشیخ محمدتقی عاملی، استاد حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 414.18,
   "end": 417.72,
   "text": "علامه حسن زاده که خیلی با عظمت از ایشون یاد می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 417.72,
   "end": 423.38,
   "text": "من خودم این رو از حضرت علامه شنیدم که فرمودن استاد ما آشیخ محمدتقی عاملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 423.38,
   "end": 429.72,
   "text": "خودشون گفتن هرچه تو کل عمرم از آقامون علی ابن موسی الرضا امام رئوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.72,
   "end": 433.46,
   "text": "خواستم نشد و نگرفتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.46,
   "end": 438.52,
   "text": "در عوض هرچه از حضرت عبدالعظیم حسنی سلام‌الله‌علیه خواستم گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 438.52,
   "end": 443.14,
   "text": "این زومراتب حالا نه اینکه امام رضا جواب نداده، امام رضا جواب داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.14,
   "end": 446.68,
   "text": "سلسله این طولی نزولی که دیروز گفتیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.68,
   "end": 450.72,
   "text": "قلب‌ها میاد، این فیض از اینجا منتشر می‌شه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.72,
   "end": 453.34,
   "text": "رعایت می‌شه. اما اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.34,
   "end": 455.66,
   "text": "واسطه فیض بین تو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.66,
   "end": 458.08,
   "text": "سلسله مراتب تا امام می‌شه حضرت عبدالعظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.08,
   "end": 460.58,
   "text": "لذا حضرت علامه حسن زاده می‌فرمود که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.58,
   "end": 467.98,
   "text": "بسیاریش یعنی اص-اصلا می‌شه گفت غالبه یعنی اکثر غریب به اتفاق حاجات ما رو یه شهید هم می‌تونه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.98,
   "end": 470.18,
   "text": "یه امامزاده خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.18,
   "end": 471.8,
   "text": "حالا ج-- دسته چندم بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 471.8,
   "end": 473.72,
   "text": "یه بچه سید هم می‌تونه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 473.72,
   "end": 476.52,
   "text": "بعضی شهدا عجیب دارن حاجت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 476.52,
   "end": 478.7,
   "text": "ما اینا رو نباید غافل-- اون امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 478.7,
   "end": 481.38,
   "text": "شأنش مافوق این حرف‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 481.38,
   "end": 488.0,
   "text": "اجل این حرف‌هاست که من برم بگم به من اون باید تمام نظام هستی رو تدبیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.0,
   "end": 491.12,
   "text": "اون کانال فیض تمام موجوداته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.12,
   "end": 496.2,
   "text": "حالا بعضیا میگن شونزده هزار عالم بعضیا میگن نه اصلا عوالم در عوالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.2,
   "end": 498.52,
   "text": "لا یتناهی چون حضرت حق لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.52,
   "end": 500.82,
   "text": "یتناهی است. حض-- خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 500.82,
   "end": 504.94,
   "text": "یعنی امام عصر جامع این برزخ جامع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.94,
   "end": 510.02,
   "text": "کون جامع است برای وساطت فیض بین خدا و همه مخلوقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.02,
   "end": 514.98,
   "text": "تو می‌خوای بری برای خودت. امام استجابت می‌کنه، همون می‌سپره به کس دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.98,
   "end": 518.12,
   "text": "حالا امتحان کنید. من خودم به این امتحان افتادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 518.12,
   "end": 520.08,
   "text": "البته امتحان نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.08,
   "end": 522.3,
   "text": "تجرباً این رو کسب کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.3,
   "end": 524.78,
   "text": "واقعاً از امام رضا بعضی موقع‌ها چیزایی می‌خواستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 524.78,
   "end": 530.94,
   "text": "می‌دیدم هیچ خبری نمی‌شه. بعدا از حضرت عبدالعظیم به زبانم اومد دیدم سریع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.94,
   "end": 533.12,
   "text": "اینو خودمم تجربه‌ش رو کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 533.12,
   "end": 537.48,
   "text": "این مراتب باید حفظ بشه در این که امام جواب تو رو میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.48,
   "end": 541.94,
   "text": "همون مراتب. اون‌ها هم خدا دارن، آقا بالا سرشون دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 541.94,
   "end": 546.3,
   "text": "خداست داره خدایی می‌کنه. امام رضا بی‌اذن حضرت حق کاری نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 546.3,
   "end": 551.2,
   "text": "اگر امام رضا شأن خودش رو حفظ نکنه جسارت کرده به حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 551.2,
   "end": 553.4,
   "text": "چون حضرت حق شأن دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 553.4,
   "end": 554.96,
   "text": "مراتبش هم شأن دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 554.96,
   "end": 557.96,
   "text": "اجازه بفرمایید یه حدیث هدیه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 557.96,
   "end": 561.58,
   "text": "این حدیث رو ببینید چقدر شیرینه در ادامه همین بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 561.58,
   "end": 564.86,
   "text": "که ما گفتیم وعاء معرفت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.86,
   "end": 573.56,
   "text": "ظرف معرفت چیه؟ قلبه و هرچه فیض حالا این شما معرفت رو فیض بگیر، رزق بگیر که اولین رزق ما وجود ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 573.56,
   "end": 579.24,
   "text": "هرچه فیض میاد، هرچه میاد، هرچه میاد، هرچه میاد رزق، هرچه میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 579.24,
   "end": 581.32,
   "text": "از کجا میاد؟ از حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 581.32,
   "end": 585.16,
   "text": "سلسله طولی‌اش رو گفتیم ولی میاد در قلب می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 585.16,
   "end": 590.84,
   "text": "این مهمه که بدانیم اهمیت قلب که ما داریم بحث قلب منزل رو می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 590.84,
   "end": 594.06,
   "text": "حالا این حدیث رو توجه کنید از قربونش بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 594.06,
   "end": 596.86,
   "text": "آقامون ابا عبدالله الحسین سلام‌الله‌علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 596.86,
   "end": 599.28,
   "text": "بحار جlde پنج، صفحه سیصد و دوازده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 599.28,
   "end": 602.0,
   "text": "امام صادق صلی الله علیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 602.0,
   "end": 605.9,
   "text": "\"خرج الحسین بن علی علی اصحابه فقال\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 605.9,
   "end": 610.16,
   "text": "امام حسین رفت تو جمع. حالا به ما به قول ما رفیقاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 610.16,
   "end": 618.22,
   "text": "فرمود \"أيها الناس إن الله جل ذكره ما خلق العباد إلا ليعرفوه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 618.22,
   "end": 624.56,
   "text": "خدای منnam خلق نکرده بندگانشو مگر برای اینکه ليعرفوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 624.56,
   "end": 626.38,
   "text": "مگر اینکه اون رو بشناسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 626.38,
   "end": 630.76,
   "text": "قرآن می‌گه ما خلقت الجن والانس الا ليعبدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 630.76,
   "end": 639.4,
   "text": "از اینجا مفسرین از این حدیث اه امثال این حدیث استفاده کردن که اون ليعبد ليعبدون می‌شود ای ليعرفون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 639.4,
   "end": 641.5,
   "text": "عین عبادت می‌شود عین معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 641.5,
   "end": 644.56,
   "text": "\"فإذا عرفوه عبدوه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 644.56,
   "end": 647.06,
   "text": "اگر بنده‌ای اونو شناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 647.06,
   "end": 651.1,
   "text": "\"فإذا عبدوه\" و عبادتش کرد \"استغنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 651.1,
   "end": 653.66,
   "text": "بعبدته عن عبادة ما سوا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 653.66,
   "end": 656.58,
   "text": "مستقل می‌شه از اینکه به غیر خدا رو عبادت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 656.58,
   "end": 658.56,
   "text": "چون همه چی رو در او می‌بینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 658.56,
   "end": 663.52,
   "text": "عین حیات، عین علم، عین قدرت، عین شعور، عین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 663.52,
   "end": 665.48,
   "text": "اراده، عین سمی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 665.48,
   "end": 668.18,
   "text": "سمع، عین بصر. همه چی اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 668.18,
   "end": 670.92,
   "text": "\"النفس فی وحدته کل القوی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 670.92,
   "end": 674.16,
   "text": "بعد حضرت ادامه دادن که \"فقال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 674.16,
   "end": 679.66,
   "text": "فقال\". البته یه نفر سؤال کرد \"فقال له رجل يا ابن رسول الله بأبی أنت وأمی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 679.66,
   "end": 682.42,
   "text": "چه سؤال قشنگی. \"فما معرفة الله؟\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 682.42,
   "end": 684.62,
   "text": "حالا این شناخت خدا چیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 684.62,
   "end": 688.24,
   "text": "که ما وظیفه‌مون اینه که خدا رو بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 688.24,
   "end": 690.36,
   "text": "این نبض بحث ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 690.36,
   "end": 692.9,
   "text": "و سنجاقش به بحث دیروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 692.9,
   "end": 695.64,
   "text": "\"قال\". کی قال؟ کی قال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 695.64,
   "end": 698.02,
   "text": "الان کی داره جواب میده؟ امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 698.02,
   "end": 702.82,
   "text": "یعنی توجه داشته باشید امام حسین داره با شما می‌گه الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 702.82,
   "end": 706.4,
   "text": "\"قال معرفت\". آقا چیو می‌گه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 706.4,
   "end": 709.34,
   "text": "اینکه معرفت الله یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 709.34,
   "end": 714.02,
   "text": "ما به چی بگیم معرفت الله که ظرف اون معرفت بشه قلبمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 714.02,
   "end": 717.22,
   "text": "\"معرفة أهل کل زمان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 717.22,
   "end": 721.34,
   "text": "اینکه اهل هر زمانی معرفت پیدا کنن به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 721.34,
   "end": 725.74,
   "text": "\"امامهم الذي يجب عليهم طاعته\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 725.74,
   "end": 728.74,
   "text": "امام‌شون که اطاعتش واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 728.74,
   "end": 730.96,
   "text": "پس معرفت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 730.96,
   "end": 734.48,
   "text": "مسابق شد با چی؟ معرفت امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 734.48,
   "end": 738.89,
   "text": "تا امام رو نشناسی معرفت هم به اما-- به خدا پیدا نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 738.89,
   "end": 743.08,
   "text": "پس اصلاً سیر عبودیت و بندگی یعنی شناخت امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 743.08,
   "end": 749.16,
   "text": "نه اینکه امام عصر کی به دنیا اومد، پدرش کی بود، مادرش کی بود، غیبتش چه سالی اتفاق افتاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 749.16,
   "end": 751.66,
   "text": "علائم ظهور. اینا هم حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 751.66,
   "end": 755.84,
   "text": "کسی دعوا با اینا نداره. اما معرفت امام قصه‌ش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 755.84,
   "end": 761.66,
   "text": "یه رساله نهج‌الولایه حضرت علامه حسن زاده رو باید بخونی اونم با شرح و بسط و توضیح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 761.66,
   "end": 767.04,
   "text": "تازه یه مقدارکی بفهمیم واقعاً این آقا شأنش کجاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 767.04,
   "end": 770.4,
   "text": "چه شأنی دارد امام عصر و ما با چه کسی طرفیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 770.4,
   "end": 772.7,
   "text": "و اون جلالت حضرت باید حفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 772.7,
   "end": 776.94,
   "text": "این نکته پایانی من باشه باز در جواب سؤال عزیزان دیروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 776.94,
   "end": 781.14,
   "text": "که چرا امام حالا مثلا ما باید این سلسله مراتب رو رعایت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 781.14,
   "end": 784.64,
   "text": "یکی سنت الهیه، یکی هم بحث جلالته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 784.64,
   "end": 790.38,
   "text": "اون-- می‌دونید چرا خیلی موقع‌ها ما تو مسائل مذهبی‌مون، معنوی‌مون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 790.38,
   "end": 792.96,
   "text": "عبادی‌مون سست می‌شیم؟ چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 792.96,
   "end": 796.28,
   "text": "نفس اصلاً عادتش اینه به هر طرفی که می‌کنه خو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 796.28,
   "end": 798.44,
   "text": "خو که کرد عادی می‌شه براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 798.44,
   "end": 801.16,
   "text": "ما عا-عادی شده برامون امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 801.16,
   "end": 804.7,
   "text": "فکر می‌کنیم حالا چون پدر شفیقه دیگه بریم بغلش بشینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 804.7,
   "end": 806.86,
   "text": "بغلش کنیم و همینطوری داستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 806.86,
   "end": 813.16,
   "text": "فلان بگیم. نه. چرا می‌گه پیش در ضریح، در ضریح امام، نزد ضریح امام زیاد نمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 813.16,
   "end": 815.56,
   "text": "برای اینکه اون جلالت آقا برات حفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 815.56,
   "end": 818.52,
   "text": "ذو الجلاله و الاكرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 818.52,
   "end": 822.96,
   "text": "تو آیه قرآن می‌گه هم جلال داره جلالت، هم اکرام که جماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 822.96,
   "end": 825.78,
   "text": "جمال و جلال رو با هم نبینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 825.78,
   "end": 827.66,
   "text": "دچار افراط و تفریط می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 827.66,
   "end": 833.3,
   "text": "باید برای امام حسین جلالت و عظمت قائل بشی بلکه عظمت قائل بشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 833.3,
   "end": 835.64,
   "text": "و البته جمال هم قائل بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 835.64,
   "end": 842.24,
   "text": "اگر کسی بره مستقیم پیش امام واسطه‌ها رو بزنه کنار، اصلاً امام جوابشو نمی‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 842.24,
   "end": 847.66,
   "text": "چون این جلالت امام رو چرا هی می‌گه انا، انا، انا این تعریف از خوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 847.66,
   "end": 852.18,
   "text": "انا الله، انا القلم، انا الكرسي، انا-- اینا رو امیرالمؤمنین می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 852.18,
   "end": 854.02,
   "text": "انا الشمس، انا القمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 854.02,
   "end": 858.8,
   "text": "آقا یعنی، یعنی چی؟ این اون وجهیه که به سمت حضرت حق داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 858.8,
   "end": 863.82,
   "text": "ذو وجهینه دیگه. یه دستش به سمت خداست، یه دست، یه دستش به سمت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 863.82,
   "end": 869.58,
   "text": "از او می‌گیره به ما می‌ده. اونو که نگاه می‌کنه انا الحق اصلاً می‌گه انا الحق امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 869.58,
   "end": 875.14,
   "text": "کتاب الزام الناصب رو ببینید پونصد بار امیرالمؤمنین می‌گه انا، انا، انا الحق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 875.14,
   "end": 877.36,
   "text": "انا الحق، انا الجنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 877.36,
   "end": 881.24,
   "text": "همه-- انا النور. از این طرف خلق رو که می‌بینه می‌گه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 881.24,
   "end": 887.82,
   "text": "مولای یا مولای أنت المولى و أنا العبد هل يرحم العبد الا نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 887.82,
   "end": 892.02,
   "text": "این مراتب باید حفظ بشه که اگر این حفظ نشه ما گیر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 892.02,
   "end": 896.84,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 896.84,
   "end": 902.26,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}