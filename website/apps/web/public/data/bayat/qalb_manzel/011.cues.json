   "start": 8.42,
   "end": 70.64
  },
  {
   "index": 1,
   "title": "## روز بسیج؛ عشق و وعاء معرفت",
   "start": 70.64,
   "end": 263.36
  },
  {
   "index": 2,
   "title": "حدیثی بسیار شیرین در بحار جلد بیست و شش صفحه‌ی یک؛ مولا علی علیه‌السلام فرمود:",
   "start": 263.36,
   "end": 301.04
  },
  {
   "index": 3,
   "title": "## تشکیک؛ دریا و برکه و پیاله",
   "start": 301.04,
   "end": 555.46
  },
  {
   "index": 4,
   "title": "## لیس کمثله شیء و مثلِ مثل خدا",
   "start": 555.46,
   "end": 692.56
  },
  {
   "index": 5,
   "title": "## قلب؛ از معرفت به محبت",
   "start": 692.56,
   "end": 920.86
  },
  {
   "index": 6,
   "title": "اجازه دهید در انتهای بحث به قسمتی از زیارت عاشورا اشاره کنم:",
   "start": 920.86,
   "end": 979.38
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.98,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.98,
   "end": 8.42,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.42,
   "end": 13.56,
   "text": "آیا اگر از امام جماعتی ببینیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.56,
   "end": 15.52,
   "text": "سخن ناشایستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.52,
   "end": 20.58,
   "text": "گفت و مزاح بدی کرد که در شان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.58,
   "end": 26.56,
   "text": "یک عالم نیست. یه مزاحی کرد که در شان اون عالم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.56,
   "end": 30.78,
   "text": "آیا این ضرری به عدالتش می‌رسونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.78,
   "end": 33.88,
   "text": "چون عدالت امام جماعت باید محرز بشه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.88,
   "end": 39.04,
   "text": "برای مأموم. از عدالت میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.04,
   "end": 42.0,
   "text": "رهبر عزیزمون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.0,
   "end": 44.86,
   "text": "در صورتی که اون حرفش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.86,
   "end": 51.3,
   "text": "اون مزاحش مخالف با شرع نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.3,
   "end": 54.2,
   "text": "ضرری به عدالتش نمی‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.2,
   "end": 59.32,
   "text": "اون مزاحی که کرد مخالف با شرع نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.32,
   "end": 60.94,
   "text": "اینجا ضرری به عدالتش نمی‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.94,
   "end": 66.42,
   "text": "اما نه اگر مغایر با شرع بود یعنی شرع دین رو زیر سؤال برد اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.42,
   "end": 70.3,
   "text": "مزاحش اینجا از عدالت ساقطه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.3,
   "end": 72.62,
   "text": "خب روز بسیج هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.62,
   "end": 78.32,
   "text": "ما تبریک میگیم به حضر همه بسیجیان عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.32,
   "end": 81.72,
   "text": "خاصه رهبر عزیزمون و شما خوبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.72,
   "end": 84.56,
   "text": "خب بسیج هم مظهر عشق بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.56,
   "end": 89.08,
   "text": "دیگه اونچه که از بسیج حرف میشه زد عشق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.08,
   "end": 92.12,
   "text": "شجره طیبه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.12,
   "end": 95.26,
   "text": "واقعاً اصالتش به محبتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.26,
   "end": 101.42,
   "text": "همه هم به عشق، به محبت، به وادی محبت رفتن، نه هیچ چیز دیگه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.42,
   "end": 104.92,
   "text": "و نه پولی، نه دنیایی، هیچی درش نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.92,
   "end": 106.96,
   "text": "واقعاً همه به عشق می‌رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.96,
   "end": 111.1,
   "text": "عشق، خواستن اون ولی الله اعظم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.1,
   "end": 116.3,
   "text": "حالا در طول ایشون سلسله مراتبی که عرض کردیم از ولی فقیه برو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.3,
   "end": 121.9,
   "text": "امام عصر و به هر حال تا الله دیگه عشق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.9,
   "end": 129.7,
   "text": "اتفاقاً بحث گذشته‌ی ما در خصوص قلب منزل تداعی همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.7,
   "end": 134.2,
   "text": "اگر چنانچه یادتون باشه عرض کردیم که قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.2,
   "end": 139.22,
   "text": "وعاء معرفت است یعنی ظرف معرفت قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.22,
   "end": 142.2,
   "text": "که تبرکاً اشاره باز می‌کنم به این حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.2,
   "end": 148.2,
   "text": "شریف از کافی مرحوم کلینی اعلا الله مقامه شریف جلد یک صفحه دویست و سه که \"ولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.2,
   "end": 151.78,
   "text": "يقبل الله اعمال العباد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.78,
   "end": 156.76,
   "text": "خدا اعمال بندگانشو قبول نمی‌کنه \"الا بمعرفته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.76,
   "end": 160.12,
   "text": "به معرفت مگر با معرفت خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.12,
   "end": 163.24,
   "text": "یعنی با همراه معرفت میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.24,
   "end": 167.48,
   "text": "عبادت قبول بشه. عبادت بدون معرفت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.48,
   "end": 171.6,
   "text": "اصلاً عبادت محسوب نمی‌شه. که بعد دیروز عرض کردیم که بر فر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.6,
   "end": 174.9,
   "text": "اساس فرمایش آقا ابا عبدالله سلام الله علیه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.9,
   "end": 179.42,
   "text": "معرفت الله می‌شه همون معرفت امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.42,
   "end": 183.04,
   "text": "باز در تأیید هم همین فرمایش آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.04,
   "end": 186.9,
   "text": "از امالی شیخ صدوق صفحه ششصد و پنجاه و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.9,
   "end": 193.92,
   "text": "فرمایش دیگری که این راوی این حدیث امیرالمؤمنین قربونش بریم از پیغمبر نقل می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.92,
   "end": 197.96,
   "text": "پیامبر به امیرالمؤمنین فرمود \"من عرفنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.96,
   "end": 201.74,
   "text": "جمع بسته \"من عرفنی\" نه \"من عرفنا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.74,
   "end": 204.28,
   "text": "علی جان هرکس ما را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.28,
   "end": 207.3,
   "text": "شناخت \"عرف الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.3,
   "end": 209.66,
   "text": "\"عرف الله\" الله را شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.66,
   "end": 215.86,
   "text": "چون الله اسم جمع و مصداق اسم جمع خدا اون اسم جامع خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.86,
   "end": 218.74,
   "text": "در بیرون امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.74,
   "end": 224.7,
   "text": "پیغمبر عظیم الشأن اسلام و \"من انکرنا فقط انکر الله عز وجل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.7,
   "end": 228.74,
   "text": "هرکسی هم که انکار ما کنه انکار الله کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.74,
   "end": 233.0,
   "text": "یا عرض شود در اون حدیث شیرین، خیلی این حدیث شیرینه، خیلی جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.0,
   "end": 235.34,
   "text": "بحث داره، جای بسط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.34,
   "end": 240.5,
   "text": "در بحار جلد بیست و شش صفحه یک مولا مون علی فرمودن صلوات الله عليه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.5,
   "end": 244.2,
   "text": "\"معرفتی بنورانیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.2,
   "end": 247.14,
   "text": "معرفة الله عز وجل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.14,
   "end": 249.48,
   "text": "معرفت من البته به نورانیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.48,
   "end": 251.9,
   "text": "حالا اینجا خیلی حرف‌ها پیاده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.9,
   "end": 255.06,
   "text": "در مقام نورانیت منو بشناسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.06,
   "end": 260.58,
   "text": "و \"معرفت الله عز وجل معرفتی بنورانیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.58,
   "end": 263.12,
   "text": "و هو الدين الخالص\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.12,
   "end": 264.82,
   "text": "یعنی این دو تا توأمان‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.82,
   "end": 269.2,
   "text": "یعنی معرفت من در مقام نورانیت معرفت الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.2,
   "end": 272.74,
   "text": "شناخت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.74,
   "end": 276.1,
   "text": "همان معرفت و شناخت من در مقام نورانیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.1,
   "end": 281.2,
   "text": "بعد حضرت فرمود \"هو الدين الخالص\" اون دین خالص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.2,
   "end": 284.5,
   "text": "که مخصوص مخلصین بل که مخلصین است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.5,
   "end": 288.28,
   "text": "این دینه. یعنی معرفت حضرت در مقام نورانیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.28,
   "end": 291.94,
   "text": "حالا این نورانیت هم یه چیزکی عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.94,
   "end": 294.06,
   "text": "نور برمی‌گرده به وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.06,
   "end": 296.72,
   "text": "اصل نور و لذا میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.72,
   "end": 299.06,
   "text": "خود این حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.06,
   "end": 301.04,
   "text": "معرفت تشکیکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 301.04,
   "end": 303.58,
   "text": "در حکمت و عرفان میگن تشکیکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.58,
   "end": 306.36,
   "text": "یعنی چی؟ مثل وحدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.36,
   "end": 308.22,
   "text": "شخصیه وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.22,
   "end": 310.88,
   "text": "که به حضرت حق اطلاق می‌شه. حالا بعد میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.88,
   "end": 315.0,
   "text": "به تشکیک که دیروز البته یه نکته‌ای عرض کردیم در رابطه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.0,
   "end": 318.46,
   "text": "حالا یا به ذات مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 318.46,
   "end": 321.16,
   "text": "در شدت و ضعف یا ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.16,
   "end": 323.96,
   "text": "مظاهر در صع و ضیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 323.96,
   "end": 329.42,
   "text": "یعنی چی؟ مثلاً اون‌هایی که قائل به وحدت شخصیه حضرت حق‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 329.42,
   "end": 335.6,
   "text": "به ذات مظاهر میگن اون چیزی که سبب صع و ضیق شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.6,
   "end": 338.06,
   "text": "اون خود مظاهرند، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.06,
   "end": 340.0,
   "text": "خود وجود. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.0,
   "end": 343.96,
   "text": "میگن مثلاً شما آب رو برای تسهیل در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 343.96,
   "end": 346.64,
   "text": "فهم موضوع آب رو بگیرید وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 346.64,
   "end": 349.86,
   "text": "آب. \"ومن الماء من الماء کل شيء حي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 349.86,
   "end": 354.22,
   "text": "یا در خصوص پیغمبر فرمودن حقیقت مایی است ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 354.22,
   "end": 357.54,
   "text": "همه‌چی از آب حی حیات گرفته، زنده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 357.54,
   "end": 363.94,
   "text": "حالا اینو وجود بگیر. خب؟ میگه آقا توی این دریا انقدر آب جمع شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 363.94,
   "end": 366.12,
   "text": "شدتی که اونجا خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 366.12,
   "end": 368.82,
   "text": "زیاد آب جمع شده لذا از خودش چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 368.82,
   "end": 371.48,
   "text": "یه شدتی نشون میده. اینجا یه برکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 371.48,
   "end": 374.72,
   "text": "انقدر آب جمع شده. اینجا یه استخره، جای پیاله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 374.72,
   "end": 377.14,
   "text": "آب جمع شده. آب همون آبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.14,
   "end": 379.62,
   "text": "رأی، شدت و ذیق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 379.62,
   "end": 383.02,
   "text": "این عرض شود سه و ذیق بر می‌گرده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 383.02,
   "end": 386.04,
   "text": "به اون مظاهر یعنی به اون نمودها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 386.04,
   "end": 393.52,
   "text": "نه به وجود. یعنی اون مظهر خدا، اون دریای سه داره که آب، آب یک آبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 393.52,
   "end": 397.26,
   "text": "وجود یک وجوده که عین نوره، درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 397.26,
   "end": 403.82,
   "text": "جمع شده. میگن این به سه و ذیق نمود نمودارهای حضرت حق یا نمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 403.82,
   "end": 411.88,
   "text": "خدا یا عرض شود نمودار وجود یا مظاهر، مجالی، آیات، کلمات، ازلال، ظلّاً، آ-- سایه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 411.88,
   "end": 414.96,
   "text": "به این بستگی داره نه به اون آب یعنی به وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 414.96,
   "end": 418.52,
   "text": "اونا میگن لذا وحدت شخصیه وجود به تشکیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 418.52,
   "end": 421.46,
   "text": "به چی؟ ذات مظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 421.46,
   "end": 424.28,
   "text": "به سه و ذیق. اینا عده‌ای میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 424.28,
   "end": 429.3,
   "text": "چی؟ به نه، ذات مراتب به شدت و ضعف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 429.3,
   "end": 435.66,
   "text": "یعنی مرا-- این رو مراتب رو شدت و ضعف رو میگیرن رو خود مراتب وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 435.66,
   "end": 439.28,
   "text": "یعنی به آب، به آب می‌زنن. میگن آب اینجا شدت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.28,
   "end": 442.06,
   "text": "وجود اینجا شدت داره، اینجا ضعف داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.06,
   "end": 445.82,
   "text": "نه به مظاهر. حالا این یه بحثه بین فلاسفه، حکما، عرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.82,
   "end": 448.44,
   "text": "ما هم کاری باهاش نداریم. می‌خوایم این رو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 448.44,
   "end": 452.18,
   "text": "حالا چرا اینو گفتیم؟ چون عرفا اینجا گفتن، یه نکته‌ای رو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 452.18,
   "end": 456.54,
   "text": "گفتن نور چون مولا می‌فرماید در جایگاه نورانیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 456.54,
   "end": 459.98,
   "text": "کسی منو بشناسه معرفت اللهه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 459.98,
   "end": 462.2,
   "text": "نه شناخت شناسنامه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 462.2,
   "end": 465.4,
   "text": "این جایگاه نورانیت نور به وجود بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 465.4,
   "end": 468.4,
   "text": "یعنی به اون ولایت کلیه بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 468.4,
   "end": 472.26,
   "text": "یعنی چی به اون اصل اصیل و به حقیقت الحقائق بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 472.26,
   "end": 477.8,
   "text": "به اون نفس کل، عقل کل، ولایت کلیه‌ی الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 477.8,
   "end": 481.0,
   "text": "بر می‌گرده. اما اینجا میگن تشکیکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 481.0,
   "end": 483.52,
   "text": "یعنی چی؟ یعنی شدت و ضعف داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 483.52,
   "end": 487.18,
   "text": "یعنی انزل مراتب نور هم نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 487.18,
   "end": 490.08,
   "text": "اینو توجه کنید. توجه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 490.08,
   "end": 492.86,
   "text": "اینو ما این همه زور زدم اینو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 492.86,
   "end": 498.74,
   "text": "انزل مراتب نور یعنی اون ضعیف‌ترین حالت نور هم باز نوره، عین وجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 498.74,
   "end": 501.92,
   "text": "نه که نور نیست. ضعف داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 501.92,
   "end": 504.02,
   "text": "نه اینکه نور نیست. چرا اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 504.02,
   "end": 507.26,
   "text": "خب ضعف داره. حالا این ضعف به چی بر می‌گرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 507.26,
   "end": 508.92,
   "text": "بحث فلسفیه کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 508.92,
   "end": 512.92,
   "text": "اما باز نوره، عین وجوده یعنی عین ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 512.92,
   "end": 517.54,
   "text": "در-- توجه کردید چی شد؟ اینطور نیست که حالا بگیم یه حالا یه بسیجی معمولی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 517.54,
   "end": 521.08,
   "text": "عاشق شده، محبت پیدا کرده اینا اما خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 521.08,
   "end": 524.2,
   "text": "گل نکرده، لب نفس ناطقه‌اش گل ننداخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 524.2,
   "end": 526.36,
   "text": "اونطوری نیست بگی به همه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 526.36,
   "end": 531.02,
   "text": "اون شدت عرض شود معرفت دست پیدا کرده یا به شدت نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 531.02,
   "end": 537.1,
   "text": "نه، یه چیزکیه مثل امثال ماها مثلا شاید بشه گفت ها، به خود، خودم عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 537.1,
   "end": 540.18,
   "text": "و اینم نوره. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 540.18,
   "end": 542.24,
   "text": "مهم اینه که وصل به اون نور باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 542.24,
   "end": 545.4,
   "text": "یعنی این مهمه که امام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 545.4,
   "end": 548.84,
   "text": "مفتر و طاع بدونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 548.84,
   "end": 552.78,
   "text": "اطاعتش واجب است از سمت حضرت حق بدونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 552.78,
   "end": 560.28,
   "text": "این مهمه. جالبه که حضرت علامه طباطبایی به اینجا که می‌رسن میگن می‌دونید چرا معرفت امام خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 560.28,
   "end": 561.98,
   "text": "شیرینه؟ چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 561.98,
   "end": 565.64,
   "text": "از زبان کی؟ علامه طباطبایی که در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 565.64,
   "end": 568.2,
   "text": "محضر علامه می‌تونید کاملش رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 568.2,
   "end": 574.5,
   "text": "در محضر علامه. ایشون فرمای-- می‌دونید چرا معرفت امام مساو با معرفت الله شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 574.5,
   "end": 577.68,
   "text": "این جمله‌ی خود علامه است براتون می‌خونم از رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.68,
   "end": 579.88,
   "text": "می‌فرماید شناسایی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 579.88,
   "end": 583.3,
   "text": "بدون شناسایی امام صورت نمی‌گیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 583.3,
   "end": 585.48,
   "text": "زیرا امامی زیراشو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 585.48,
   "end": 588.94,
   "text": "امام به منزله‌ی مثب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 588.94,
   "end": 591.64,
   "text": "صاد و محل اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 591.64,
   "end": 596.42,
   "text": "شدت ریزش رو میگه و محل ریزش و آبشار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 596.42,
   "end": 599.44,
   "text": "و جایگاه فیض از بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 599.44,
   "end": 602.68,
   "text": "یعنی اگر تو این جایگاه فیض رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 602.68,
   "end": 606.74,
   "text": "این کانال فیض رو نشناسی چجوری می‌خوای فیض رو بشناسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 606.74,
   "end": 608.64,
   "text": "کانال وجود رو نشناسی وج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 608.64,
   "end": 611.9,
   "text": "کانال نور رو نشناسی نور رو چگونه بشناسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 611.9,
   "end": 615.46,
   "text": "تا اینو نشناسی چون این از جنس همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 615.46,
   "end": 618.82,
   "text": "اتفاقاً حالا این حرفا رو هر جایی هم نمیشه زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 618.82,
   "end": 625.02,
   "text": "اما خب ما قبلاً هم تو یکی دو تا جلسه خصوصی با چند تا رفیقامون گفته بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 625.02,
   "end": 628.72,
   "text": "که فکر می‌کردیم فقط حضرت شیخ اکبر علیه رحمة این رو گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 628.72,
   "end": 631.32,
   "text": "بعداً از لسان خود علامه که شنیدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 631.32,
   "end": 633.02,
   "text": "حالا یکی دو جا عموماً هم گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 633.02,
   "end": 635.98,
   "text": "دیدم نه خود علامه در شرح fosusش فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 635.98,
   "end": 639.32,
   "text": "و خیلی هم براش مقدمه چیدند که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 639.32,
   "end": 643.0,
   "text": "که تو قرآن می‌فرماید \"لیس کمثله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 643.0,
   "end": 648.24,
   "text": "شیء\" خود حضرت علامه اول فرمودن که اگر این کاف زایده بگیریم یعنی هیچکس مثل خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 648.24,
   "end": 652.62,
   "text": "درسته. اما اگر کاف زایده نگیریم می‌شه \"ليس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 652.62,
   "end": 655.84,
   "text": "ك\" یعنی مثل. مثلم که خودش مثله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 655.84,
   "end": 659.72,
   "text": "\"كمثله\" می‌شه نیست مثل، مثل خدا چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 659.72,
   "end": 664.4,
   "text": "یعنی پس خدا مثل، مثل دارد که مثل او هیچکس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 664.4,
   "end": 665.62,
   "text": "اینو حضرت علامه فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 665.62,
   "end": 672.48,
   "text": "چقدر هم مقدمه البته چیدند براش که ما این مقدمات رو الحمدالله گفتیم قبلاً ها تو درس و بحث‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 672.48,
   "end": 678.06,
   "text": "به این وزانه اگه بگیم خدا مثل دارد، مثلش امام حی زمانه، هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 678.06,
   "end": 684.44,
   "text": "زمانه‌ای است مثل امام عصر الان ما و این امام دیگر مثل ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 684.44,
   "end": 687.28,
   "text": "یعنی دیگه آیه، آیه بوی ولایت می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 687.28,
   "end": 692.02,
   "text": "اینطوری وقتی بخوای ببینی دیگه، دیگه اون اوج، اون اوج معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 692.02,
   "end": 694.56,
   "text": "منتها اینا این معارف باید بیاد چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 694.56,
   "end": 697.2,
   "text": "این نکته بحث ما اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 697.2,
   "end": 700.48,
   "text": "باید بیاد کجا؟ وعاء این معرفت کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 700.48,
   "end": 702.22,
   "text": "قلب بود. چرا قلب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 702.22,
   "end": 706.28,
   "text": "چون وقتی معرفت وارد حوزه قلب شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 706.28,
   "end": 710.02,
   "text": "اینجا رو دقت کنید. قلب حوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 710.02,
   "end": 713.46,
   "text": "محبت و نفرته. حوزه تعلقاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 713.46,
   "end": 717.74,
   "text": "اینطوری بگیم تعلقات، کندن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 717.74,
   "end": 722.52,
   "text": "و علقه‌ها، نفرت‌ها، محبت‌ها، قلب اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 722.52,
   "end": 725.68,
   "text": "اگر معرفت وارد قلب شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 725.68,
   "end": 729.76,
   "text": "قطعاً اون چیزی که خارج ازش می‌شه محبته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 729.76,
   "end": 734.5,
   "text": "چیزی جز این نمی‌تونه باشه. معرفت اگر وارد قلب شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 734.5,
   "end": 737.36,
   "text": "خروجی قلب در این مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 737.36,
   "end": 740.44,
   "text": "می‌شود محبت، می‌شود عشق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 740.44,
   "end": 742.9,
   "text": "اون موقع است که انسان با معرفت عاشق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 742.9,
   "end": 747.02,
   "text": "پس هرچه معرفت بیشتر، عشق بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 747.02,
   "end": 751.08,
   "text": "دیروز ما اون بحثی که پیرامون حضرت داشتیم باز برای بعضیا سؤال شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 751.08,
   "end": 754.98,
   "text": "که آقا پس چیه می‌گید امام باب الحوائج الی الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 754.98,
   "end": 761.74,
   "text": "چرا شما میگی که از امام زمان مثلا از امام رضا می‌خوای بری حرم هر چیزی نخوای یعنی هیچی نخوای واقعاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 761.74,
   "end": 763.7,
   "text": "ما نگفتیم هیچی نخواh.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 763.7,
   "end": 766.28,
   "text": "گفتیم نخود کیشمیش نخواه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 766.28,
   "end": 768.38,
   "text": "امام رتبه‌ش خیلی بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 768.38,
   "end": 772.68,
   "text": "بر اساس بحث امروزمون، بحث عشق در مقام نورانیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 772.68,
   "end": 781.72,
   "text": "اگر کسی مولامون علی رو در جایگاه نورانیت درست بشناسه، جرات می‌کنه بره در محضر مولا بگه آقا چکمو پاس کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 781.72,
   "end": 784.16,
   "text": "اصلاً جرات می‌کنه؟ لال می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 784.16,
   "end": 787.38,
   "text": "اصلاً فراموش می‌کنه این مسئله در محضر امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 787.38,
   "end": 791.54,
   "text": "همه چی رو فراموش می‌کنه. از تمام تعلقاتش می‌کَنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 791.54,
   "end": 796.04,
   "text": "پس چی از امام می‌خواد؟ وقتی رفت پیش امام می‌آرمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 796.04,
   "end": 798.66,
   "text": "به اصل رسیده. اصلاً چیزی نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 798.66,
   "end": 802.66,
   "text": "بخوایم تنزل بدیم به بحث می‌گیم خب خودش رو می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 802.66,
   "end": 807.0,
   "text": "می‌گه آقا امام من تو رو از شما، خودت رو می‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 807.0,
   "end": 813.64,
   "text": "که اگر او مصداق اسم الله هست چون اسم الله مجمع است و جامع همه اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 813.64,
   "end": 816.16,
   "text": "و امام هم محل جمع است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 816.16,
   "end": 822.5,
   "text": "یعنی الله رو می‌خواد. یعنی همون باز معرفت امام شد معرفت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 822.5,
   "end": 825.24,
   "text": "دیگه حالا تنزل بدیم می‌گیم ما از تو خودت رو می‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 825.24,
   "end": 828.26,
   "text": "و الا اگر کسی من واقعاً چندین مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 828.26,
   "end": 834.44,
   "text": "رفتم به نیت گرفتن یه چیزی که چیز کمی هم نبود، خیلی بزرگ بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 834.44,
   "end": 840.22,
   "text": "از امیرالمؤمنین. بعضی وقت‌ها بود که سحر من بودم و ضریح و سه چهار نفر آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 840.22,
   "end": 842.66,
   "text": "انقدر تو اون ایام خلوتی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 842.66,
   "end": 848.14,
   "text": "چندین بار خدا رو شاهد می‌گیرم این چیزی که الان من گفتم اونجا چشیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 848.14,
   "end": 851.36,
   "text": "جرات اص-- اصلاً چیزی یادم نمی‌اومد از امیرالمؤمنین بخوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 851.36,
   "end": 855.86,
   "text": "می‌گفتم من دیگه چی می‌خوام؟ الان اینجا در محضر امیرالمؤمنین نشستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 855.86,
   "end": 859.54,
   "text": "چی می‌خوام؟ برای شما هم قطعاً این مسائل پیش اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 859.54,
   "end": 863.32,
   "text": "رسیده باشی به سید الشهدا مثل قطره‌ای که وصل به دریا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 863.32,
   "end": 866.6,
   "text": "دیگه قطره چی می‌خواد؟ وصل شد به دریا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 866.6,
   "end": 868.84,
   "text": "چی می‌خواد دیگه؟ دریا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 868.84,
   "end": 871.02,
   "text": "دیگه چی می‌خوای؟ همه چی رو بهت دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 871.02,
   "end": 873.42,
   "text": "اینجا دیگه وقت آرمیدن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 873.42,
   "end": 877.18,
   "text": "ما نمی‌گیم، اون می‌گه باب الحوائج الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 877.18,
   "end": 880.78,
   "text": "یعنی الله رو بخواه. ما نمی‌گیم از امام هیچی نخواه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 880.78,
   "end": 885.82,
   "text": "چرا؟ ولی اون چیزی که از امام می‌خواد خودش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 885.82,
   "end": 889.12,
   "text": "اگه چیزهای نخود کیشمیشی می‌خوای بفرمایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 889.12,
   "end": 893.22,
   "text": "عرض شد خیلی‌ها از خیلی سطح پایین‌تر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 893.22,
   "end": 895.66,
   "text": "می‌شه این‌ها رو از امام گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 895.66,
   "end": 898.6,
   "text": "اجازه بفرمایید که اشاره کنم توی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 898.6,
   "end": 903.76,
   "text": "انتهای بحث به یک قسمتی از عاشورا که دیگه همتون خوندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 903.76,
   "end": 908.52,
   "text": "ببینید چقدر شیرینه. فأسأل الله الذي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 908.52,
   "end": 913.14,
   "text": "أکرمنی من درخواست می‌کنم از خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 913.14,
   "end": 917.12,
   "text": "چه خدایی؟ که أکرمنی بمعرفتکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 917.12,
   "end": 920.66,
   "text": "به معرفت شما گرامی می‌دارد خدا ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 920.66,
   "end": 926.64,
   "text": "یعنی اگر کسی معرفت امام حسین بهش داده شد، خدا تکریمش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 926.64,
   "end": 929.68,
   "text": "من أراد الله به خيرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 929.68,
   "end": 931.76,
   "text": "قذف فی قلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 931.76,
   "end": 937.62,
   "text": "حب الحسين. هر کس خدا اراده‌ی خیر رو aboutش کرده، خدا اراده‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 937.62,
   "end": 940.46,
   "text": "خیر کنه. محبت حسین رو می‌ندازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 940.46,
   "end": 942.98,
   "text": "که این جوشش معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 942.98,
   "end": 946.1,
   "text": "تا نشناسی نمی‌فهمی و معرفت اولیاءکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 946.1,
   "end": 952.58,
   "text": "اینم یه بحثه. شناخت دوستان شما البته و رزقنا البراءة من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 952.58,
   "end": 956.3,
   "text": "أعدائکم. یه بحثی هم رو یؤتی الحكمة داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 956.3,
   "end": 962.32,
   "text": "می‌خواستیم حکمت رو بزنیم به همین معرفت و محبت از قرآن که دیگه فرصت نیست انشاالله جلسه بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 962.32,
   "end": 968.18,
   "text": "که همه‌ی ح-- همه‌ی حکمت معرفت امام است و همه‌ش عشق و محبت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 968.18,
   "end": 970.74,
   "text": "ان شاء الله که عاقبتمون ختم به خیر باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 970.74,
   "end": 973.98,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 973.98,
   "end": 979.38,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}