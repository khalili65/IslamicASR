  {
   "index": 7,
   "title": "## تجربهٔ پنجاه‌ساله",
   "start": 834.02,
   "end": 920.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.84,
   "end": 4.78,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.78,
   "end": 8.78,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.78,
   "end": 17.28,
   "text": "آخرین جایی که در نماز ما می‌تونیم متصل بشیم به امام جماعت و البته یک رکعت حساب بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.28,
   "end": 19.04,
   "text": "در رکوع آخر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.04,
   "end": 22.04,
   "text": "رکوع آخر امام رو درک کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.04,
   "end": 27.7,
   "text": "آخرین جایی‌ست که می‌شود به امام متصل شد و یک رکعت حساب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.7,
   "end": 31.18,
   "text": "اما آخرین جایی که میشه متصل شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.18,
   "end": 35.76,
   "text": "ثواب جماعت رو برد نه اینکه ر-- یک رکعت حساب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.76,
   "end": 40.6,
   "text": "یه جا دیگه هم هست که در نماز جماعت ما رسیدیم، دیر رسیدیم می‌تونیم متصل شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.6,
   "end": 45.52,
   "text": "فقط ثواب نماز جماعتو برا ما می‌نویسن، دیگه یک رکعت حساب نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.52,
   "end": 48.76,
   "text": "اون مخصوص تشهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.76,
   "end": 50.84,
   "text": "رکعت آخر نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.84,
   "end": 52.76,
   "text": "حواستون باشه نه سلام‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.76,
   "end": 55.74,
   "text": "بعضیا میان امام داره سلام میده، اق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.74,
   "end": 57.78,
   "text": "الله اکبر می‌گن اقتدا می‌کنند می‌شینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.78,
   "end": 61.28,
   "text": "این غلطه. باید تو تشهد باشه امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.28,
   "end": 64.92,
   "text": "وقتی در تشهد بود می‌تونید اقتدا کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.92,
   "end": 70.84,
   "text": "و منتها وقتی نشستید به نی-- به حالت تجافي نیم‌خیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.84,
   "end": 72.88,
   "text": "می‌شینید. نه نشسته، نه ایستاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.88,
   "end": 78.86,
   "text": "اینطوری نماز ثواب نماز جماعتو ان‌شاءالله بهتون هدیه می‌کنند و پا می‌شید ادامه می‌دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.86,
   "end": 84.72,
   "text": "حالا به طمع ثواب دیگه از فردا ما باید تشهدمون رو طول بدیم که عزیزان به طمع ثواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.72,
   "end": 87.22,
   "text": "موقع تشهد خودشون رو برسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.22,
   "end": 90.22,
   "text": "خب چون عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.22,
   "end": 96.56,
   "text": "عزیزمون مادر خانمشون رو از دست دادن اجازه بدید که اگرچه ما نمی‌خواستیم امروز ورود کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.56,
   "end": 100.44,
   "text": "به بحث، سلسله بحث منقطع می‌شه اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.44,
   "end": 105.66,
   "text": "نیابتا ان‌شاءالله ثوابش برسه به روح اون بزرگوار و هر کسی که از اینجا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.66,
   "end": 107.8,
   "text": "مادر از دست داده مادرش فیض ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.8,
   "end": 111.06,
   "text": "تأمل کنید نکته خوبی گیره‌تون میاد پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.06,
   "end": 114.04,
   "text": "اینکه مقام مادر وا- و پدر چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.04,
   "end": 116.36,
   "text": "این‌ها فرقشون چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.36,
   "end": 118.9,
   "text": "اولا یک سیر کوتاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.9,
   "end": 122.62,
   "text": "حکمی عرض کنم خدمتتون در کتاب فصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.62,
   "end": 129.72,
   "text": "اسم سیفی کلمات فاطمیه حضرت علامه حسن زاده علیه رحمة اگر کسی مطالعه کرده باشه این کتاب رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.72,
   "end": 135.96,
   "text": "اونجا حضرت علامه مقام مادر رو می‌برن رو نفس پیاده می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.96,
   "end": 143.78,
   "text": "و می‌فرمایند مقام مادر مثلا حضرت صدیقه طاهره سلام الله علیها در قوس صعود تو این نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.78,
   "end": 147.78,
   "text": "رفت عروج کرد و رسید به مقام نفس کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.78,
   "end": 151.86,
   "text": "نفس کل، نفس مقام پرورش دهنده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.86,
   "end": 160.1,
   "text": "و امیرالمؤمنین علیه الصلاة والسلام در سیر صعودی در نشئه طبیعت رفت رسید به مقام عقل کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.1,
   "end": 163.24,
   "text": "پس مرد مقام عقل دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.24,
   "end": 170.1,
   "text": "زن مقام نفس. مرد مقام تدبیر دارد، جایگاه تدبیر دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.1,
   "end": 174.48,
   "text": "مدیریت دارد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.48,
   "end": 177.22,
   "text": "زن یا به عبارتی مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.22,
   "end": 179.82,
   "text": "مقام پرورش دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.82,
   "end": 187.6,
   "text": "حالا این مقام پرورش رو که حالا از این جهت هم اونجا البته اثبات می‌کند علامه که چرا خیلی شیرین، که چرا پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.6,
   "end": 190.04,
   "text": "به دخترش گفت ام ابیها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.04,
   "end": 195.14,
   "text": "مادر پدر و از همین حیث علامه اثبات کردن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.14,
   "end": 203.12,
   "text": "مطلب شیرین رو که چون در قوس صعود حضرت صدیقه طاهره سلام الله علیها رفت و به مقام نفس کلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.12,
   "end": 206.76,
   "text": "الهیه رسید و نفس مقامش پرورشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.76,
   "end": 211.12,
   "text": "حتی پدرش پیغمبر هم تحت نفس کل قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.12,
   "end": 214.08,
   "text": "از این حیث می‌شه مادر پدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.08,
   "end": 218.6,
   "text": "که حالا کاری به اون نداریم اگرچه مطلب بسیار ارشی و سنگینه اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.6,
   "end": 222.16,
   "text": "پیاده کرده ایشون. حالا یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.16,
   "end": 228.0,
   "text": "وجوه خود نفس عرض کردیم اون جایگاهی از نفس، اون می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.0,
   "end": 232.02,
   "text": "عرض کرد جلوه‌ای از نفس، وجهی از نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.02,
   "end": 234.76,
   "text": "رتبه‌ای از نفس کل که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.76,
   "end": 237.64,
   "text": "مقام شفقت و علقه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.64,
   "end": 242.6,
   "text": "یعنی تعلقات انسان در اونجا شکل می‌گیرد قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.6,
   "end": 246.48,
   "text": "ببینید حتی خدا وقتی خودش رو می‌خواد معرفی کنه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.48,
   "end": 254.56,
   "text": "احادیث قدسی که شیخ حر عاملی علیه الرحمه در جواهر الثنیه آورده به پیغمبرش می‌فرماید به این‌ها بگو من از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.56,
   "end": 258.56,
   "text": "مادر هزار مرتبه مهربان‌ترم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.56,
   "end": 260.62,
   "text": "اولا دست رو مادر می‌ذاره خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.62,
   "end": 265.28,
   "text": "خودش رو با شکل مادر می‌خواد معرفی کنه با شاکله مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.28,
   "end": 268.08,
   "text": "دو، می‌فرماید هزار مرتبه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.08,
   "end": 271.6,
   "text": "مهربان‌تر. بحث شفقت و رأفت رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.6,
   "end": 277.38,
   "text": "مهر و محبت رو میاره. اصلا جایگاه مادر شفقت و مهر و محبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.38,
   "end": 281.58,
   "text": "جایگاه علقه، علاقه، شفقت، محبت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.58,
   "end": 283.28,
   "text": "این‌ها هم همه در قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 283.28,
   "end": 287.8,
   "text": "پس به یک معنا الان ما داریم در مقام قلبی مادر سخن می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.8,
   "end": 290.78,
   "text": "اینکه مادر مقامش مقام قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.78,
   "end": 293.06,
   "text": "درسته نفس کل است اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.06,
   "end": 299.56,
   "text": "یکی از وجوهش علقه و علاقه و شفقت و مهر و محبت است که مقام قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 299.56,
   "end": 303.54,
   "text": "اصلا اینکه ما در زیارت اربعین می‌گیم \"و قلبی لقلبکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.54,
   "end": 309.42,
   "text": "سلم\" به امام حسین صلوات الله علیه عرض می‌کنیم قلب من در طول قلب شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.42,
   "end": 312.86,
   "text": "یعنی همون هرچی شما علاقه داری منم علاقه دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.86,
   "end": 315.64,
   "text": "هرچی شما بدت میاد منم بدم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.64,
   "end": 323.6,
   "text": "جایگاه علقه، جایگاه محبت و حب و جایگاه نفرت حتی همه قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.6,
   "end": 326.54,
   "text": "پس محبت برمی‌گرده به مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.54,
   "end": 333.2,
   "text": "حالا در قرآن وجه اختلاف مادر و پدر را از حیث مقام ببینید چگونه بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.2,
   "end": 339.78,
   "text": "چند تا آیه براتون بخونم. گاهی اوقات آیات قرآن میان هر دو رو تکریم می‌کنند که حق هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 339.78,
   "end": 343.32,
   "text": "مثلا آیه بیست و سه سوره اسرا می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.32,
   "end": 349.28,
   "text": "\"اما یبلغن عندك الكبر احدهما او كلاهما\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.28,
   "end": 351.32,
   "text": "هر کدوم از این دو تا هما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 351.32,
   "end": 356.14,
   "text": "ضمیر مفنا. چه پدر، چه مادر اگر از پا افتادن پیر شدن این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 356.14,
   "end": 358.34,
   "text": "\"فلا تقلهما افاً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 358.34,
   "end": 363.44,
   "text": "کمترین بی‌حرمتی که مثلا اف بگی، اوه بگی، آه بگی، اه بگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 363.44,
   "end": 369.25,
   "text": "مطلقا فلا تقلّهما اف نباید اینطوری کنی ولا تنهرهما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 369.25,
   "end": 372.69,
   "text": "و قلّهما قولا کریما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 372.69,
   "end": 377.05,
   "text": "به بهترین وجه ممکن با قول کریم با این‌ها سخن بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 377.05,
   "end": 380.05,
   "text": "یا مثلا در آیه پونزده سوره احقاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 380.05,
   "end": 386.27,
   "text": "می‌فرماید انتهی آیه که و وصّینا الإنسان بوالدیه احسانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 386.27,
   "end": 391.71,
   "text": "ما وصیت کردیم باور کنید من امروز که این آیه رو می‌نوشتم تنم لرزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 391.71,
   "end": 396.29,
   "text": "دیدم و وصّینا خدا داره وصیت می‌کنه، خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 396.29,
   "end": 400.29,
   "text": "یه وقت هست یه کسی پدر، مادر، بزرگی وصیت می‌کنه و از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 400.29,
   "end": 404.57,
   "text": "می‌گن وصیت هر کسی انجام وصیت واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 404.57,
   "end": 406.29,
   "text": "خدا داره وصیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 406.29,
   "end": 409.33,
   "text": "ما وصیت می‌کنیم، توصیه می‌کنیم به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 409.33,
   "end": 411.53,
   "text": "چی رو؟ بوالدیه احسانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 411.53,
   "end": 414.51,
   "text": "اینا خب همه مقام کلی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 414.51,
   "end": 417.85,
   "text": "یا اعوذ به الله از آیه دوباره بیست و سه اسراء که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.85,
   "end": 423.81,
   "text": "اسراء که اون بالا خوندیم ادامه‌ش اینه و قل ربک الا اعبدوا الله ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 423.81,
   "end": 427.27,
   "text": "اصلا قضای الهی بر این تعلق گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.27,
   "end": 431.81,
   "text": "نه قدر. یعنی انقدر حکم سنگینه قضا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 431.81,
   "end": 434.05,
   "text": "لف به هم پیچیده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.05,
   "end": 436.43,
   "text": "یعنی متنه، محکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.43,
   "end": 438.43,
   "text": "بعد قدر میاد اون رو شرح میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 438.43,
   "end": 440.67,
   "text": "قضا چیه؟ یکی که مطلقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 440.67,
   "end": 444.91,
   "text": "مشرک نباشی بلافاصله می‌فرماید و بالوالدین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.91,
   "end": 449.87,
   "text": "احسانا و احسان کردن بهوالده، بهوال-- یعنی در کنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.87,
   "end": 454.35,
   "text": "منع نهی شرک یا عبادت محض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 454.35,
   "end": 458.67,
   "text": "احسان به والدین اومده. یا مثلا اومده و انشکر لی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 458.67,
   "end": 467.05,
   "text": "و لوالدیک. یعنی شکر پدر و مادر بلافاصله اومده در کنار شکر حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 467.05,
   "end": 471.05,
   "text": "بزرگان گفتن تنها جایی که خدا شریک گرفته اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 471.05,
   "end": 474.15,
   "text": "همین جا. انشکر لی و لوالدیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 474.15,
   "end": 476.11,
   "text": "منو شکر بگو و پدر و مادرت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 476.11,
   "end": 479.09,
   "text": "این جایگاه دو-- هر دو بزرگوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 479.09,
   "end": 481.33,
   "text": "خدا حقشون رو بر ما حلال کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 481.33,
   "end": 485.41,
   "text": "اما وقتی میاد از پدر سخن میگه در قرآن اختصاصا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.41,
   "end": 488.83,
   "text": "در همون آیه دویست و بیست و سه سوره بقره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 488.83,
   "end": 492.89,
   "text": "وقتی میاد مقام-- بعد از اینکه توصیه می‌کنه به هر دو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 492.89,
   "end": 495.01,
   "text": "بعد میاد مختصا پیراهون پدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 495.01,
   "end": 500.23,
   "text": "می‌فرماید و على المولود له رزقهن و كسوتهن بالمعروف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 500.23,
   "end": 506.41,
   "text": "عجب. می‌خواد مقام پدر رو بگه اما گوشزد می‌کنه انگار این آیه گوش پدر رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 506.41,
   "end": 509.63,
   "text": "میگه حواست جمع باشه به وظیفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 509.63,
   "end": 513.89,
   "text": "وقتی می‌خواد از پدر سخن بگه به وظایف پدر اشاره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 513.89,
   "end": 516.35,
   "text": "میگه تو وظیفه داری که به معروف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 516.35,
   "end": 521.21,
   "text": "یعنی به حد عرف اونطور که شایسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.21,
   "end": 523.89,
   "text": "اعوذ به الله همسرت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 523.89,
   "end": 526.39,
   "text": "و خانواده و فرزندانت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 526.39,
   "end": 528.95,
   "text": "رزقهن و كسوتهن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 528.95,
   "end": 531.67,
   "text": "نفقه شونو فراهم کنی، لباسشون رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.67,
   "end": 534.21,
   "text": "لباس همسرت رو، لب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.21,
   "end": 539.15,
   "text": "و نفقه شو هرچی که نیاز داره رزقش رو و على المولود له،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 539.15,
   "end": 542.27,
   "text": "له یعنی وقتی بچه دار که میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 542.27,
   "end": 546.27,
   "text": "مثلا همسرتو بچه دار شد، بر توست که به حد عرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 546.27,
   "end": 548.97,
   "text": "به حد معروف نفقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.97,
   "end": 552.15,
   "text": "این‌ها رو فراهم کنی. اما وقتی مادر میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 552.15,
   "end": 555.23,
   "text": "وقتی سخن از مادر میاد ببینید چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 555.23,
   "end": 564.49,
   "text": "مطلب بیان می‌شه. ادامه آیه پونزده سوره احقاف رو اگر دقت کنید متوجه جایگاه ویژه مادر می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 564.49,
   "end": 566.95,
   "text": "می‌فرماید که اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 566.95,
   "end": 571.03,
   "text": "وقتی مقام-- می‌خواد از مادر سخن بگه مقام، مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 571.03,
   "end": 576.61,
   "text": "شرح وظایف نیست. مقام گوشزد کردن به مادر به وظایفش نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 576.61,
   "end": 580.53,
   "text": "بلکه مقام تجلیل ما از زحمات مادر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 580.53,
   "end": 583.59,
   "text": "اصلا لحن متفاوته. می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 583.59,
   "end": 585.81,
   "text": "حم-- هم-- حملته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 585.81,
   "end": 590.35,
   "text": "امه کرها و وضعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 590.35,
   "end": 593.91,
   "text": "کرها و حمله و فصاله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 593.91,
   "end": 596.67,
   "text": "ثلاث ثلاثون شهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 596.67,
   "end": 599.27,
   "text": "اشاره می‌کنه به اون سی ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 599.27,
   "end": 601.89,
   "text": "خیلی جالب ها این از جهت علمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 601.89,
   "end": 607.41,
   "text": "ذیل این آیه کتاب‌ها نوشتن باور کنید که چجوری اون موقع خدا اشاره به این سی ماه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 607.41,
   "end": 612.55,
   "text": "این سی ماه اهمیتش چگونه است که وقتی این سی ماه پر شد دیگه نباید بچه شیر بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 612.55,
   "end": 618.13,
   "text": "بعضیا ادامه میدن و این بچه هرچی میخوره خراب میشه، مزاجش به هم میریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 618.13,
   "end": 621.79,
   "text": "این سی ماه رو از حمل آورده یعنی وضع حمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 621.79,
   "end": 624.49,
   "text": "و فصاله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 624.49,
   "end": 632.33,
   "text": "یعنی اون حال شیردهیش گرفته بارداری و وضع حمل و شیردهیشو همه رو گرفته شش ماه رو هم، چ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 632.33,
   "end": 634.53,
   "text": "سی ماه روی هم. حالا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 634.53,
   "end": 637.81,
   "text": "و اون حالت بارداری مادر رو حذف کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 637.81,
   "end": 640.01,
   "text": "بقیش باید از این سی ماه کم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 640.01,
   "end": 643.29,
   "text": "باید اون مقدار شیر بخوره که اینو متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 643.29,
   "end": 647.13,
   "text": "با اینکه قانون قرآنه رعایت نمیشه و بچه مزاجش به هم میریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.13,
   "end": 650.13,
   "text": "اینجا داره چی میگه؟ میگه توجه داشته باش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 650.13,
   "end": 652.97,
   "text": "که این همه مادر سی ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 652.97,
   "end": 656.33,
   "text": "سختی کشید برا تو. متوجه این عظمت باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 656.33,
   "end": 663.09,
   "text": "این کاملا با لحن آیه آدم متوجه می‌شه که جایگاه مادر نسبت به پدر چقدر ویژه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 663.09,
   "end": 670.51,
   "text": "من وقتی یه بررسی همین ضمنی کردم تو زندگی‌نامه، خیلی زندگی‌نامه بسیاری از بزرگان رو مطالعه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 670.51,
   "end": 675.97,
   "text": "از انبیا و اهل بیتمون بگیر علیهم الصلاة والسلام تا عرفا و حکما سلام الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 675.97,
   "end": 680.81,
   "text": "علیهم أجمعین. غالب اونایی که مقامات عالیه داشتن مادراشونو تو بچگی از دست دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 680.81,
   "end": 683.93,
   "text": "دنبال این سر بودم تا یکی از عرفا شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 683.93,
   "end": 690.15,
   "text": "ایشون فرمودن که اصلا سرش اینه که انقدر مقام مادر سنگینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 690.15,
   "end": 692.45,
   "text": "خدا بار اولیاشو سبک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 692.45,
   "end": 696.23,
   "text": "زود از اینا می‌گیره که اینا بتونن تا آخرش بکشن این بار رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 696.23,
   "end": 698.73,
   "text": "انقدر مقام مادر سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 698.73,
   "end": 702.43,
   "text": "خیلی مقام مادر یعنی اینکه میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 702.43,
   "end": 704.51,
   "text": "پیغمبر فرموده بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 704.51,
   "end": 710.91,
   "text": "زیر پای مادرانه یعنی اصلا رضایت خدا به رضایت مادر بسته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 710.91,
   "end": 716.33,
   "text": "انقدر مهمه. لذا بزرگان گفتن هر وقت گره به کارت افتاد، اینایی که دارن قدر بدونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 716.33,
   "end": 719.23,
   "text": "اونا هم که ندارن برن همین کارو با خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 719.23,
   "end": 725.33,
   "text": "پای مادر بکنن. هر وقت گره به کارت افتاد برو صورتتو بذار کف پای مادرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 725.33,
   "end": 727.89,
   "text": "اگه می‌تونی اشک بریز. اگر گریه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 727.89,
   "end": 730.26,
   "text": "اگر گره‌ت باز نشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 730.26,
   "end": 736.06,
   "text": "تف کن به صورت ما. بسیاری از بزرگان اینو گفتن و من خودم از بچگی این رو همیشه درک کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 736.06,
   "end": 739.2,
   "text": "هر وقت گره به کارم می‌افتاد تو همون عالم بچگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 739.2,
   "end": 741.44,
   "text": "صورت به کف پای مادر می‌ذاشتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 741.44,
   "end": 743.58,
   "text": "اشک می‌ریختم و گره واقعاً باز می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 743.58,
   "end": 745.78,
   "text": "الانم میریم سر خاک مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 745.78,
   "end": 749.88,
   "text": "می‌شینیم پایین پای مادر صورت به خاک پای مادر می‌مالیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 749.88,
   "end": 752.14,
   "text": "و این‌هام که حالا توجه داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 752.14,
   "end": 754.46,
   "text": "یه نکته‌ای هم در این آخر عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 754.46,
   "end": 759.28,
   "text": "خب عزیزمون مادر خانم از دست داده یا بعضیا ما-- می‌گن خب چه ربطی داشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 759.28,
   "end": 761.74,
   "text": "حواستون جمع باشه، حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 761.74,
   "end": 766.58,
   "text": "حدیث داریم که ما سه پدر داریم و سه مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 766.58,
   "end": 771.42,
   "text": "می‌دونستید اینو؟ سه-- اصلاً اونجایی که می‌گه سه پدر داریم کی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 771.42,
   "end": 779.5,
   "text": "می‌فرماید اولین پدر کسیه که تو رو به دنیا آورده، در صلبش بودی آمدی به دنیا، پدر جسمی‌ته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 779.5,
   "end": 782.64,
   "text": "پدر بعدی پدر ابا زوجک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 782.64,
   "end": 786.84,
   "text": "اون ابا ولدک، ابا زوجک یعنی پدرخانم توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 786.84,
   "end": 790.5,
   "text": "اونم پدر دومته. همونطور بعد می‌فرماید ابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 790.5,
   "end": 798.58,
   "text": "علمک البته، پدری که به تو علم می‌آموزه که البته حدیث گفت پدری که به تو علم می‌آموزه مقامش از همه اشرفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 798.58,
   "end": 800.78,
   "text": "بالاتره. یعنی معلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 800.78,
   "end": 804.32,
   "text": "اونجا هم همینطوره. ما هم سه تا مادر داریم باز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 804.32,
   "end": 807.1,
   "text": "مادر رو، هم مادر جسمی‌ته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 807.1,
   "end": 812.46,
   "text": "هم مادر معنوی و کلی‌ته که حضرت صدیقه طاهره صلوات الله علیهاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 812.46,
   "end": 815.04,
   "text": "و هم مادر خانومته. این سه تا مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 815.04,
   "end": 816.58,
   "text": "خب این‌ها مهم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 816.58,
   "end": 818.56,
   "text": "ما باید این‌ها رو بدونیم و الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 818.56,
   "end": 821.14,
   "text": "در مسیر سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 821.14,
   "end": 827.9,
   "text": "شل می‌شیم و می‌بینیم یه گره‌هایی میاد تو کارمون زمین می‌خوریم، هی زمین می‌خوریم، نوسان تو عبادتمون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 827.9,
   "end": 830.04,
   "text": "چرا؟ چون این ریزه کاری‌ها رو نمی‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 830.04,
   "end": 833.42,
   "text": "پس از این به بعد حواسمون نسبت به مقام مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 833.42,
   "end": 836.08,
   "text": "باشه. من توصیه می‌کنم به همه‌ی شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 836.08,
   "end": 841.56,
   "text": "این توصیه بنده رو تجربه‌ی پنجاه ساله‌ی عمرم بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 841.56,
   "end": 847.9,
   "text": "که چند-- چقدر وقت گذاشتم یه منبر برای این، برای رفیقای خصوصیم رفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 847.9,
   "end": 850.9,
   "text": "خیلی خلاصه تو یه جمله برای شما جمعش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 850.9,
   "end": 854.54,
   "text": "تجربه پنجاه سالم رو پیرامون مقام مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 854.54,
   "end": 858.04,
   "text": "اگر می‌خواید به اسرار عالم پی ببرید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 858.04,
   "end": 860.8,
   "text": "اگر می‌خواید برکت عمر پیدا کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 860.8,
   "end": 866.54,
   "text": "اگر می‌خواید خدا به شما چیزی رو بده که اگر کسی صد سال عمر بذاره نمی‌تونه برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 866.54,
   "end": 869.36,
   "text": "بخواید یه دفعه راه صد ساله ببرنتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 869.36,
   "end": 871.28,
   "text": "یه چیزایی خدا بریزه تو دومت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 871.28,
   "end": 873.7,
   "text": "بندازه تو وجودت که واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 873.7,
   "end": 876.22,
   "text": "دیگران متحیر بمونن. می‌گن اصلاً به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 876.22,
   "end": 878.94,
   "text": "عمر تو نمی‌خوره، به سن تو نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 878.94,
   "end": 881.66,
   "text": "تو چیکار کردی به این برکت، به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 881.66,
   "end": 883.84,
   "text": "وجاهت به اینجا رسیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 883.84,
   "end": 885.76,
   "text": "همش زیر پای مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 885.76,
   "end": 889.78,
   "text": "همش تو آغوش مادره. همش ذیل مقام مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 889.78,
   "end": 891.94,
   "text": "تا می‌تونی به مادر خدمت کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 891.94,
   "end": 893.98,
   "text": "تا می‌تونی کوچیکیشو بکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 893.98,
   "end": 897.42,
   "text": "تا می‌تونی یه کاری کن جگر مادر خنک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 897.42,
   "end": 900.28,
   "text": "اگر جگر مادر ازت خنک شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 900.28,
   "end": 902.7,
   "text": "برات همه‌ی عالم خنک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 902.7,
   "end": 905.16,
   "text": "جهنمم ببرنت خنکه برات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 905.16,
   "end": 910.0,
   "text": "این تجربه پنجاه ساله‌ی من بود تو چند جمله براتون آخر منبر جمعش کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 910.0,
   "end": 915.16,
   "text": "انشاالله که عاقبتمون ختم به خیر باشد به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 915.16,
   "end": 920.92,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}