  {
   "index": 1,
   "title": "## فکر گناه نکنید؛ تمثیل آتش در اتاق سفید",
   "start": 109.34,
   "end": 214.08
  },
  {
   "index": 2,
   "title": "## فارابی؛ مزاج اعدل و چشمهٔ تسنیم",
   "start": 214.08,
   "end": 799.54
  },
  {
   "index": 3,
   "title": "یکی تا می‌توانیم تا آنجا که ظرفیت داریم:",
   "start": 799.54,
   "end": 851.34
  },
  {
   "index": 4,
   "title": "## حیات ذاتی بدون حیات مزاجی کافی نیست",
   "start": 851.34,
   "end": 896.2
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 3.7,
   "text": "بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.7,
   "end": 9.02,
   "text": "السلام عليك يا داعي الله و رباني آيات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.02,
   "end": 11.56,
   "text": "السلام عليكم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.56,
   "end": 14.64,
   "text": "بحث مزاج رو به فضل الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.64,
   "end": 18.0,
   "text": "در این حرم با صفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.0,
   "end": 22.92,
   "text": "و بی نظیر در این فضای ملکوتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.92,
   "end": 26.98,
   "text": "ادامه بدهیم. رسیدیم به اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.98,
   "end": 29.88,
   "text": "عرض کردیم که به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.88,
   "end": 38.98,
   "text": "برای اینکه نفس و خیال و فکر بر اثر نیت خلاف و قول کذب کج و معوج می شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.98,
   "end": 43.46,
   "text": "لذا روایات زیادی داریم که نهی کرده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.46,
   "end": 48.12,
   "text": "اینکه انسان حتی به هزل و مطایبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.12,
   "end": 52.64,
   "text": "دروغ بگوید که به چه جهت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.64,
   "end": 55.5,
   "text": "از این جهت که کذب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.5,
   "end": 59.04,
   "text": "حتی نیت خلاف و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.04,
   "end": 63.7,
   "text": "به یک معنا معاصی خصوصاً کذب و نیت خلاف اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.7,
   "end": 66.64,
   "text": "چی می‌کنند؟ مزاج رو تخریب می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.64,
   "end": 70.74,
   "text": "مزاج رو به هم می‌زنند. وقتی مزاج به هم ریخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.74,
   "end": 74.12,
   "text": "مزاج از سلامت خارج شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.12,
   "end": 80.22,
   "text": "انسان مستعد معصیت های دیگر می‌شود و قول حق رو نمی‌پذیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.22,
   "end": 82.72,
   "text": "و مشکلات ان‌چنینی براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.72,
   "end": 86.8,
   "text": "پدید میاد و خودش هم نمی‌دونه از کجا داره می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.8,
   "end": 92.1,
   "text": "نگو که از خودش داره می‌خوره از اندیشه‌های باطلی که داشته، از اندیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.1,
   "end": 96.54,
   "text": "کج و فکر گناهی که داشته که نفس و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.54,
   "end": 99.14,
   "text": "جان و روحش رو آلوده کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.14,
   "end": 103.6,
   "text": "و مزاج خراب شده از اعتدال خارج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.6,
   "end": 105.84,
   "text": "کارهایی می‌کنه ناشایست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.84,
   "end": 109.34,
   "text": "و خودش هم در کارهای خودش حتی شاید بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.34,
   "end": 114.38,
   "text": "لذا از امام صادق صلوات الله علیه حدیث داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.38,
   "end": 117.98,
   "text": "حتی فرمودند که من نمیگم گناه نکنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.98,
   "end": 120.6,
   "text": "که هیچ، نباید گناه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.6,
   "end": 124.02,
   "text": "بلکه می‌گویم فکر گناه هم نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.02,
   "end": 127.46,
   "text": "این فکر گناه، فکر گناه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.46,
   "end": 131.78,
   "text": "که همین فکر رفته رفته نیت رو تشکیل میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.78,
   "end": 134.34,
   "text": "فکر زیاد به گناه مخصوصا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.34,
   "end": 137.98,
   "text": "تشکیل نیت میده و قصد می‌کنه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.98,
   "end": 140.46,
   "text": "مثل یک اتاقی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.46,
   "end": 143.0,
   "text": "حالا مثالی که عرفا زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.0,
   "end": 146.88,
   "text": "همچون اتاقی که دور تا دور این اتاق و سقف و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.88,
   "end": 151.4,
   "text": "دیوارها اون همه رو رنگ تمیز و سفیدی زده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.4,
   "end": 154.6,
   "text": "بعد وسط این اتاق یه آتشی روشن کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 154.6,
   "end": 162.44,
   "text": "این آتش ولو اینکه اون آتش خونه رو نمی‌سوزونه اما دیوار‌های سفید و براق خونه رو کدر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.44,
   "end": 165.82,
   "text": "سیاه و دودی می‌کنه. همچنین رفته رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.82,
   "end": 169.18,
   "text": "وجود انسان تاریک می‌شه، مزاج به هم می‌ریزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.18,
   "end": 172.78,
   "text": "و دیده می‌شه که در پس همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.78,
   "end": 175.56,
   "text": "تدریج در آلودگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 175.56,
   "end": 178.08,
   "text": "ضمنی و عارضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.08,
   "end": 182.32,
   "text": "بعد به گونه‌ای می‌شه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 182.32,
   "end": 187.9,
   "text": "بر اثر تصفیف هی صوفه صوفه کردن و فردا فردا کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.9,
   "end": 195.0,
   "text": "در تطهیر وجود خودش و قوای وجودی‌ش، اون آلودگی‌ها بر پس آلودگی‌ها رفته رفته به جایی می‌رسه که دیگه خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.0,
   "end": 197.28,
   "text": "طرف از خودش شرمنده می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.28,
   "end": 198.92,
   "text": "و دیگه خودش رو رها می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.92,
   "end": 201.7,
   "text": "می‌گه دیگه کار از کار گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.7,
   "end": 203.3,
   "text": "نمی‌دونم آب از سر گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 203.3,
   "end": 205.04,
   "text": "چک وجب چه ده وجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 205.04,
   "end": 211.04,
   "text": "و اینها دیگه به اینجا می‌رسه که خیلی انسان باید مراقب باشد که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 211.04,
   "end": 214.08,
   "text": "بحثش انشاالله خواهد آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 214.08,
   "end": 219.72,
   "text": "اجازه بفرمایید که نقل کنم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 219.72,
   "end": 224.64,
   "text": "عیون مسائل فارابی که حضرت علامه حسن زاده علیه الرحمه نیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 224.64,
   "end": 227.04,
   "text": "اشاره به این جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 227.04,
   "end": 229.42,
   "text": "حضرت فارابی دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 229.42,
   "end": 232.32,
   "text": "در خصوص همین بحث مزاج که ایشان می‌فرمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 232.32,
   "end": 236.04,
   "text": "و من تلك العيون التي مزاجها من تسنيم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 236.04,
   "end": 239.76,
   "text": "عينا يشرب بها المقربون ان المزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 239.76,
   "end": 243.96,
   "text": "کلما کان اعدل کان مزاجها افضل و اکمل و اشرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 243.96,
   "end": 246.64,
   "text": "همون بحث مزاج افضَل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 246.64,
   "end": 249.22,
   "text": "اکمل و اشرف و اتم و اینهاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.22,
   "end": 251.6,
   "text": "که اینها همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 251.6,
   "end": 254.42,
   "text": "مزاج شریف‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 254.42,
   "end": 260.38,
   "text": "به جایی می‌رسونه که آیه قرآن درباره‌ش می‌فرماید که يشرب بها المقربون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 260.38,
   "end": 263.86,
   "text": "از اون تسنیم، از اون چشمه تسنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 263.86,
   "end": 268.66,
   "text": "که شاید به همین رزان، به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 268.66,
   "end": 273.6,
   "text": "در حقیقت رایحه خوش است به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 273.6,
   "end": 276.2,
   "text": "دلیل است که حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 276.2,
   "end": 278.9,
   "text": "جوادی آملی اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 278.9,
   "end": 284.2,
   "text": "تفسیر قرآنشون رو تسنیم گذاشتند که ان المزاج کلما کان اعدل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 284.2,
   "end": 290.22,
   "text": "وقتی که این معتدل‌ترین حالت رو مزاج پیدا کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.22,
   "end": 297.16,
   "text": "دیگه این مقام مقربون است که از اون چشمه جوشان الهی می‌نوشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 297.16,
   "end": 299.48,
   "text": "باز یعنی داره می‌زنه به مزاج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.48,
   "end": 302.14,
   "text": "یعنی مزاج وقتی اعدل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 302.14,
   "end": 308.42,
   "text": "اجازه چشیدن از آن چشمه الهی که قطعاً اون معارف حق است رو دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.42,
   "end": 315.46,
   "text": "که حالا خلاصه‌ش اینه که بهترین و عالی‌ترین و معتدل‌ترین مزاج، مزاج انسانی می‌شه که برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.46,
   "end": 318.66,
   "text": "همین قابلیت پذیرش نفس ناطقه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 318.66,
   "end": 322.92,
   "text": "پیدا می‌کنه. به قبول نفس ناطقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.92,
   "end": 328.84,
   "text": "از چه جهت؟ از جهت اینکه و جعل نوع الاغرب من الاعتدال من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.84,
   "end": 332.28,
   "text": "الاعتدال مزاج البشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 332.28,
   "end": 337.32,
   "text": "مزاج البشر حتی يصلح لقبول النفس الناطقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.32,
   "end": 340.0,
   "text": "خب این هم دلیل اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 340.0,
   "end": 348.94,
   "text": "چرا انسان در میان همه موجودات و کلمات وجودی نظام هستی قابلیت این رو پیدا کرده که نفس ناطقه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.94,
   "end": 350.92,
   "text": "بپذیره و پذیرا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.92,
   "end": 355.94,
   "text": "یا به عبارتی همون می‌شود گفت امانت الهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.94,
   "end": 359.74,
   "text": "که همه ازش سرباز زدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.74,
   "end": 364.72,
   "text": "ان عرضنا الامانة على السماوات والارض فابین ان يحملنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.72,
   "end": 369.91,
   "text": "اشفق منها. اونجا \"فحمله الإنسان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.91,
   "end": 372.89,
   "text": "اینجا انسان این بار رو برداشت، بار امانت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 372.89,
   "end": 376.11,
   "text": "این بار امانت نفس ناطقه به یک معنا همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 376.11,
   "end": 377.99,
   "text": "می‌شود گفت بار ولایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.99,
   "end": 381.45,
   "text": "بار ولایت برداشته. نفس ناطقه انسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.45,
   "end": 389.05,
   "text": "این ظرفیت رو و سعه وجودی رو دارد که بتواند به ولایت دسترسی پیدا کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.05,
   "end": 391.11,
   "text": "اما مطلب دیگر اینکه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.11,
   "end": 393.91,
   "text": "صفحه دویست و نود کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 393.91,
   "end": 398.75,
   "text": "شریف عوین مسائل نفس از علامه حسن زاده علیه الرحمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.75,
   "end": 406.05,
   "text": "اونجا وقتی می‌فرمایند که \"إذا کان المزاج أعدل\" وقتی مزاج به نحو عدل شد و عادل-- عدالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.05,
   "end": 412.13,
   "text": "و معتدل‌ترین حالت را پیدا کرد، \"کانت النفس الفائدة عليه أفضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 412.13,
   "end": 416.31,
   "text": "و كانت الحقائق الفائدة على النفس عيبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.31,
   "end": 419.63,
   "text": "على مراتبها في الفضل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.63,
   "end": 423.67,
   "text": "البته متفاوتة فضلا و درجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 423.67,
   "end": 427.53,
   "text": "بعد اشاره می‌کنه به \"والذین أوتوا العلم درجات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.53,
   "end": 432.07,
   "text": "که این‌ها، این‌هایی که به علم دسترسی پیدا می‌کنند درجات دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.07,
   "end": 435.49,
   "text": "این درجات، تفاوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.49,
   "end": 440.17,
   "text": "درجات و فضل این‌ها علما به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 440.17,
   "end": 447.93,
   "text": "تفاوت در اون فیضی است که دریافت می‌کنند و تفاوت فیض به جهت تفاوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.93,
   "end": 451.23,
   "text": "مزاج است که وقتی مزاج عدل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.23,
   "end": 453.75,
   "text": "دیگه همه فیض رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.75,
   "end": 457.59,
   "text": "خلاصه اینه که حالا بعد اشا-ایشون ادامه پیدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.59,
   "end": 460.63,
   "text": "می‌کنه مطلبشون که تا اونجا که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.63,
   "end": 464.33,
   "text": "خب چطور هستش که بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.33,
   "end": 470.27,
   "text": "به وحی دسترسی پیدا می‌کنند، بعضیا به الهام و بعضیا به تعلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.27,
   "end": 473.35,
   "text": "ایشون می‌فرمایند همش بر می‌گرده به مزاج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.35,
   "end": 477.71,
   "text": "در همون کتاب شریف عوین مسائل نفسشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.71,
   "end": 485.55,
   "text": "فرمود همش به مزاج. لذا اولیاء الهی، انبیا مثلاً انبیا به وحی دسترسی پیدا می‌کنند، اولیاء الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 485.55,
   "end": 488.65,
   "text": "به عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 488.65,
   "end": 493.01,
   "text": "الهام و علما به تعلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 493.01,
   "end": 498.43,
   "text": "این هم یک نکته که باز می‌بینید به هر طرف ما میریم برگشت می‌کنه به چی عزیزان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.43,
   "end": 502.09,
   "text": "به مزاج و نوع مزاج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.09,
   "end": 504.55,
   "text": "نکته دیگری که عرض کنیم اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 504.55,
   "end": 510.81,
   "text": "که خیلی جای بحث دارد و ما فقط عرض می‌کنیم اجمالا که شما تشنه بشید و رد می‌شیم ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.81,
   "end": 516.73,
   "text": "اونم اینکه اخلاق فرمودن تابع-- اخلاق هم حتی تابع مزاجه، اخلاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 516.73,
   "end": 518.69,
   "text": "اخلاق هم تابع مزاجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 518.69,
   "end": 521.21,
   "text": "مثلاً کسی که بلغم بروش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.21,
   "end": 527.23,
   "text": "مستولی است می‌گن که دارای وقاره، دارای سکینه‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.23,
   "end": 529.07,
   "text": "یک آرامش خاطری دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 529.07,
   "end": 531.91,
   "text": "کسی که بلغم برش استیلا دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 531.91,
   "end": 535.69,
   "text": "یا مثلاً کسی که صفراویه، صفرا برش مستولیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 535.69,
   "end": 538.21,
   "text": "که این کسی غضب زیاد می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 538.21,
   "end": 542.87,
   "text": "زیاد عصبی می‌شه، پرخاشگر می‌شه این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 542.87,
   "end": 546.07,
   "text": "یا کسی که مثلاً سوداش زیاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.07,
   "end": 548.35,
   "text": "و بعد این‌ها موجب چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 548.35,
   "end": 551.05,
   "text": "سوء خلق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 551.05,
   "end": 554.17,
   "text": "اخلاقش خیلی بد می‌شه. کسی که سوداش زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 554.17,
   "end": 559.45,
   "text": "بعد خیلی‌ها تو مسیر سیر و سلوک و تهذیب و این‌ها که حرکت می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.45,
   "end": 565.73,
   "text": "بسیار شده که میان می‌گن آقا ما خیلی مراقبیم، خیلی مراقب هستیم اما اصلاً نمی‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 565.73,
   "end": 569.53,
   "text": "جلوی خودمون رو بگیریم. بعضا یه دفعه به شدت عصبی می‌شیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 569.53,
   "end": 572.29,
   "text": "خیلی زود عصبانی می‌شیم یا بد خلق می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 572.29,
   "end": 575.43,
   "text": "چرا؟ آخه چرا؟ این چرا هم بر می‌گرده به مزاج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 575.43,
   "end": 583.63,
   "text": "ببینید چقدر مهمه. همونطور که البته مزاج‌ها مختلفه، خب اخلاق هم متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 583.63,
   "end": 586.65,
   "text": "حالا نکته دیگه اینکه، اصلا اینو برای این گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 586.65,
   "end": 593.15,
   "text": "که حالا همونطور که مزاج‌ها رو گفتیم قابل تغییرند، پس اخلاق هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 593.15,
   "end": 597.55,
   "text": "قابل تغییره و اینجا این‌ها تأثیرشون در هم توأمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.55,
   "end": 605.11,
   "text": "این نکته قابل تأمله که یعنی همونطور که مزاج‌ها قابل تغییرند، پس اخلاق‌ها هم قابل تغییرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 605.11,
   "end": 609.39,
   "text": "باز همونطوری که اخلاق رو می‌شه تغییر داد، مزاج‌هام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 609.39,
   "end": 614.51,
   "text": "قابل تغییرند. حتی مزاج قابل تبديله حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 614.51,
   "end": 619.25,
   "text": "کسی که دارای اعتدال مزاجه به راحتی می‌تونه تغییر اخلاق بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 619.25,
   "end": 623.39,
   "text": "یعنی کسی که، اینو دقت کنید، کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 623.39,
   "end": 631.33,
   "text": "مزاجش به سمت اعتداله، هر مقدار که به اعتدال نزدیک‌تره، راحت‌تر می‌تونه اخلاقش رو تغییر بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 631.33,
   "end": 635.45,
   "text": "و برای همین برای تهذیب اخلاق و این‌ها اعتدال فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 635.45,
   "end": 638.69,
   "text": "اعتدال مزاج بسیار موثره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 638.69,
   "end": 645.85,
   "text": "و اون کسی که اعتدال مزاج نداره، قابلیتش برای تهذیب خیلی کمه، خیلی زجر می‌کشه، خیلی اذیت می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 645.85,
   "end": 649.07,
   "text": "تا بتونه خودکنترلی پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 649.07,
   "end": 652.29,
   "text": "در حالی که کسی که اعتدال مزاج داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 652.29,
   "end": 656.85,
   "text": "قابلیت و شعنیت بیشتری برای تهذیب پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 656.85,
   "end": 660.65,
   "text": "خلاصه اینکه هرچی مزاج معتدل‌تر، پذیرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 660.65,
   "end": 662.97,
   "text": "ملکات فاضله نفسانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 662.97,
   "end": 666.73,
   "text": "حتی ملکات علمی و حتی ملکات عملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 666.73,
   "end": 671.55,
   "text": "مستعدتره این‌ها استعدادش در وجود انسان بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 671.55,
   "end": 676.67,
   "text": "پس نتیجه، یه نتیجه جانانه برای امروز به فضل الهی در این حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 676.67,
   "end": 679.99,
   "text": "بسیار باصفا و مقدس بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 679.99,
   "end": 685.15,
   "text": "اینکه یکی از زمینه‌های تحصیل فضائل و کمالات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 685.15,
   "end": 689.85,
   "text": "می‌شه همون وجود مزاج عدل در انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 689.85,
   "end": 692.49,
   "text": "که هرچی معتدل‌تر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 692.49,
   "end": 696.03,
   "text": "زمینه‌ی تحصیل فضائل و کلا-کمالات بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 696.03,
   "end": 702.85,
   "text": "خب همه‌ی شما و همه‌ی اونایی که این صدا رو می‌شنوند در حالا کانال‌هایی که بچه‌ها می‌ذارن این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 702.85,
   "end": 707.09,
   "text": "خب همه، همه پذیرای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 707.09,
   "end": 711.33,
   "text": "فضائل و کمالات‌اند. همه به سمتش در حرکت‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 711.33,
   "end": 719.63,
   "text": "و همه براشون این سؤاله که گاهی اوقات چرا توقف می‌کنند یا پسرفت دارند، چرا زوری می‌زنند به نتیجه نمی‌رسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 719.63,
   "end": 721.97,
   "text": "خب این‌ها جواب داره داده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 721.97,
   "end": 725.27,
   "text": "خب به جهت همون گونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 725.27,
   "end": 729.14,
   "text": "همونطور که عرض کردیم ظاهرها متفاوته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 729.14,
   "end": 731.2,
   "text": "در باطن هم متفاوت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 731.2,
   "end": 734.36,
   "text": "چرا؟ چون مزاجشون متفاوته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 734.36,
   "end": 738.0,
   "text": "و لذا اخلاقشون هم متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 738.0,
   "end": 742.5,
   "text": "نکته‌ی جدی که در این انتهای بحث در این جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 742.5,
   "end": 746.32,
   "text": "عرض می‌کنیم اون نکته بسیار مهمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 746.32,
   "end": 753.4,
   "text": "است که باید عزیزان توجه داشته باشند اینکه این دو در هم توأمان تاثیرگذارند که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 753.4,
   "end": 758.08,
   "text": "یعنی همه حکما و رفا که قائل به حیات مزاجی‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 758.08,
   "end": 760.96,
   "text": "من جمله حضرت استاد فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 760.96,
   "end": 766.1,
   "text": "همونطور که اعتدال مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 766.1,
   "end": 769.18,
   "text": "سبب اطاعت از شریعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 769.18,
   "end": 771.9,
   "text": "به وجه بهتری می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 771.9,
   "end": 775.94,
   "text": "اطاعت از شریعت هم اعتدال مزاج می‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 775.94,
   "end": 783.76,
   "text": "یعنی هرچه انسان اطاعتش از خداوند بیشتر بشه مزاجش معتدل‌تر میشه و هرچه مزاج معتدل بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 783.76,
   "end": 787.9,
   "text": "در پذیرش حقایق و معارف و صور غیبی موفق‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 787.9,
   "end": 790.84,
   "text": "این دو در هم توأمان تاثیرگذارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 790.84,
   "end": 792.92,
   "text": "حالا پس ما باید دو تا کار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 792.92,
   "end": 799.54,
   "text": "یک تا می‌تونیم تا اونجا که ظرفیت داریم \"واعبد ربک حتی یأتیک الیقین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 799.54,
   "end": 801.74,
   "text": "که این مزاج ما رو به یقین برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 801.74,
   "end": 808.84,
   "text": "اینقدر عبادت بکنیم تا مزاج معتدل بشود به حقیقت یقین که اسم اعظم حضرت حق است دسترسی پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 808.84,
   "end": 817.22,
   "text": "دو، بتوانیم مزاجمون رو با توجه به این علم مزاج شناسی و شناخت مزاج خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 817.22,
   "end": 821.12,
   "text": "به گونه‌ای به سمت اعتدال بکشونیم که کار ما در تهذیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 821.12,
   "end": 823.14,
   "text": "و در تحصیل هر دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 823.14,
   "end": 826.46,
   "text": "آسون‌تر بشه. عرض شد دیگه کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 826.46,
   "end": 831.12,
   "text": "مزاجش معتدل‌تره بهتر یاد می‌گیره و دیرتر هم از ذهنش میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 831.12,
   "end": 833.78,
   "text": "این‌هایی که بعضیا میبینید زود یادشون میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 833.78,
   "end": 836.8,
   "text": "اصلا یکی از دلایل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 836.8,
   "end": 840.7,
   "text": "خودفراموشی یا زود فراموشی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 840.7,
   "end": 843.34,
   "text": "حتی آلزایمر. اینا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 843.34,
   "end": 848.94,
   "text": "خروج از نحو اعتدال مزاج است که سبب میشه که انسان خیلی چیزا رو فراموش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 848.94,
   "end": 851.34,
   "text": "ببینید چقدر این‌ها به هم مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 851.34,
   "end": 858.58,
   "text": "پس کسانی که صرفا به حیات ذاتی توجه می‌کنند و حیات مزاجی رو رها کردن قطعاً تو مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 858.58,
   "end": 861.82,
   "text": "سیر و سلوکشون به مشکلات جدی برمی‌خورند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 861.82,
   "end": 868.02,
   "text": "و اینا نباید منتظر این باشند که به حضور یک عارف کامل واسلی برسند، ذکری بگیرند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 868.02,
   "end": 873.1,
   "text": "خطوماتی بگیرند، یه نفسی بهشون بخوره که مثلاً بخوان یه دفعه رها بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 873.1,
   "end": 879.64,
   "text": "این چنین نیست. باید تلاش کرد و \"أليس للإنسان إلا ما سعى\" آیا چیزی جز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 879.64,
   "end": 883.36,
   "text": "سعی کردن برای انسان هست از اون تلاشش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 883.36,
   "end": 885.78,
   "text": "چیزی جز تلاشش براش هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 885.78,
   "end": 889.1,
   "text": "انشاالله که این امام مهربان هممون رو کمک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 889.1,
   "end": 891.14,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 891.14,
   "end": 893.94,
   "text": "عاقبتمون انشاالله به ختم به خیر شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 893.94,
   "end": 896.2,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}