 ],
 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 4.4,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.4,
   "end": 8.36,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.36,
   "end": 12.06,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.06,
   "end": 15.56,
   "text": "فاصله‌ای که مأمومین در نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.56,
   "end": 19.44,
   "text": "حد اکثر فاصله‌ای که می‌تونن از هم داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.44,
   "end": 22.5,
   "text": "حالا قدیم‌ها در فقه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.5,
   "end": 27.32,
   "text": "به اندازه لم دادن یک گوسفند یا یک گوسفند لمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.32,
   "end": 31.28,
   "text": "فعلاً فرمودن حداکثر به اندازه یک متر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.28,
   "end": 33.98,
   "text": "مخصوصاً در این دوران کرونایی و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.98,
   "end": 42.66,
   "text": "اون فاصله‌ای که جهت رعایت فاصله‌های بهداشتی می‌گفتن در نماز جماعت نباید بیش از یک متر باشد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.66,
   "end": 46.38,
   "text": "نه دیگه نماز جماعت اتصال برقرار نیست در این صورت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.38,
   "end": 48.94,
   "text": "اما بریم سراغ بحث قلب منزل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.94,
   "end": 53.7,
   "text": "چقدر ما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.7,
   "end": 57.92,
   "text": "قلعمون وظایف داریم که از این وظایف بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.92,
   "end": 61.28,
   "text": "چقدر فرصت‌هامون رو، اوقات عمرمون رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.28,
   "end": 69.02,
   "text": "فرصت‌ها رو سوزاندیم و فرصت‌سوزی کردیم و به جای اینکه بپردازیم به مهمات زندگیمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.02,
   "end": 71.24,
   "text": "متأسفانه وقت‌هامون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.24,
   "end": 74.6,
   "text": "جاهای دیگه گذاشتیم مثل دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.6,
   "end": 77.38,
   "text": "تلویزیون و عرض شود این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.38,
   "end": 80.26,
   "text": "فیلم‌ها و سریال‌هایی که جز اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.26,
   "end": 85.22,
   "text": "ذهن ما رو آشفته کنه و متخیلات فاسده ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.22,
   "end": 90.38,
   "text": "در قوه خیال اون بیش از پیش کنه عایدی نداشت برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.38,
   "end": 92.48,
   "text": "امیدوارم که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.48,
   "end": 95.66,
   "text": "به داد ما برسه و اون لحظه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.66,
   "end": 99.34,
   "text": "دست دراز می‌کنیم تا حجت خدا دستمون رو بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.34,
   "end": 106.72,
   "text": "حجت خدا بتواند که دست ما را بگیرد که جز با طهارت نمی‌شود که \"نما یرید الله لیلث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.72,
   "end": 111.92,
   "text": "عنکم الرجس اهل البت ویطهرکم تطهيرا\" در خصوص اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.92,
   "end": 115.54,
   "text": "\"ولا یمسه الّا المتهرون\" در خصوص ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.54,
   "end": 120.46,
   "text": "که اگر دست ما طهارت لازم رو نداشته باشد چگونه اون‌ها دست ما رو بگیرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.46,
   "end": 127.22,
   "text": "باید آماده شد که قرآن می‌فرماید ابتدا \"ویزکیهم\" تذکره مقدم قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.22,
   "end": 129.74,
   "text": "سپس \"ویعلمهم الكتاب والحکمة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.74,
   "end": 134.38,
   "text": "عزیزان حدیث نفس البته برای خودم می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.38,
   "end": 139.8,
   "text": "نشه اون جایی که ابا عبدالله با اون همه رأفت و مهربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.8,
   "end": 143.18,
   "text": "می‌رفتن در یک مسیری، یکی از دوستانشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.18,
   "end": 146.98,
   "text": "تشریف اومدن رسیدن محضر حضرت شرفیاب شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.98,
   "end": 151.46,
   "text": "دست دراز کردن امام حسین در روایت هست دستش رو کنار کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.46,
   "end": 155.1,
   "text": "فرمود تو با دستت گناه کردی امروز و توبه نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.1,
   "end": 158.7,
   "text": "نشه به اون روز و به اون حال ما گرفتار بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.7,
   "end": 164.54,
   "text": "چقدر ما بحث حیات مزاجی رو که بیان کردیم چقدر عزیزان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.54,
   "end": 169.18,
   "text": "منقلب کرده، چقدر مضطرب کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.18,
   "end": 174.08,
   "text": "چقدر نگران کرده و چقدر عزیزان رو به فکر فرو برده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.08,
   "end": 178.44,
   "text": "خب چه کنیم؟ نگیم؟ یک وظیفه است که باید بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.44,
   "end": 180.94,
   "text": "بگیم یک مشکل است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.94,
   "end": 183.54,
   "text": "این چنین بازخوردهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.54,
   "end": 185.96,
   "text": "به هر حال گوناگونی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.96,
   "end": 188.26,
   "text": "نوع عزیزان دارد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.26,
   "end": 192.8,
   "text": "ما هم که چقدر فرصت مگر داریم، چقدر همدیگر رو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.8,
   "end": 196.32,
   "text": "خدای منان برکت بدهد ان شاء الله به وقت و اوقات ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.32,
   "end": 200.84,
   "text": "بحث ما بحث حیات مزاجی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.84,
   "end": 203.3,
   "text": "و همونطور که عرض شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.3,
   "end": 215.08,
   "text": "می‌دانید که هر چه مزاج انسان سالم‌تر و به اعتدال نزدیک‌تر، شهود حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.08,
   "end": 218.36,
   "text": "و مشاهدات انسان شفاف‌تر و زلال‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.36,
   "end": 221.8,
   "text": "در حقیقت یک رابطه‌ی مستقیمی بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.8,
   "end": 225.7,
   "text": "میزان اعتدال مزاج انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.7,
   "end": 229.2,
   "text": "و شفافیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.2,
   "end": 234.18,
   "text": "شهود و زلال بودن شهود برقرار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.18,
   "end": 239.02,
   "text": "از این جهت اجازه بفرمایید که اصل پانزدهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.02,
   "end": 245.96,
   "text": "حضرت علامه در کتاب شریف انسان در عرف عرفان رو با هم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.96,
   "end": 249.18,
   "text": "در اصل پانزدهم این کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.18,
   "end": 255.46,
   "text": "حضرت استاد می‌فرمایند \"اصل دیگر اینکه وارداتی از قبیل تمثلات و مکاشفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.46,
   "end": 262.06,
   "text": "و دیگر القاءات صبوهی در حال مراقبت و توجه مثلاً پیش می‌آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.06,
   "end": 265.88,
   "text": "بدین معنی نیست\" حالا اون می‌فرماید که اون توجهاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.88,
   "end": 268.78,
   "text": "انسان دارد خب یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.78,
   "end": 272.6,
   "text": "القاءاتی رو صورت می‌گیره برای هرکی به یک نسبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 272.6,
   "end": 278.74,
   "text": "بعد حضرت می‌فرمایند که، ایشون می‌فرمایند که \"بدین معنی نیست که برای هر سالکی یکسان روی آورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.74,
   "end": 283.32,
   "text": "زیرا که هر شخص جدولی خاص از بحر بیکران هستی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 283.32,
   "end": 286.84,
   "text": "و نصیب او از این جدول وجودی خاصش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 286.84,
   "end": 290.24,
   "text": "به اقتضای مناسبتی میان او با واقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.24,
   "end": 296.04,
   "text": "عاید او می‌شود. خلاصه اینکه آنچه در خواب و بیداری نصیب هر کسی می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 296.04,
   "end": 300.14,
   "text": "میوه‌هایی‌ست که از کمون شجره‌ی وجود او بر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 300.14,
   "end": 304.98,
   "text": "بروز می‌کند و اختلاف امزجه را دخلی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.98,
   "end": 308.5,
   "text": "در واردات و القاءات و منامات است.\" خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 308.5,
   "end": 312.52,
   "text": "جالبه که حضرت استاد علامه حسن زاده علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.52,
   "end": 318.92,
   "text": "این کلاً واردات و القاءات و منامات و این‌ها رو می‌فرماید این اختلاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.92,
   "end": 323.64,
   "text": "امزجه درش دخل و تصرف تام و تمام دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.64,
   "end": 328.42,
   "text": "و خیلی جالبه که ایشون می‌فرماید هم در خواب هم در بیداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.42,
   "end": 332.84,
   "text": "در هر دو موردش این اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 332.84,
   "end": 340.2,
   "text": "پا برجاست و خیلی باید مراقبت کرد در خصوص مجا-- مزاج که این مزاج رو به هم نزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.2,
   "end": 345.04,
   "text": "مزاج رو از بین نبریم، تخریبش نکنیم بلکه به سمت اعتدال بکشونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 345.04,
   "end": 349.26,
   "text": "حالا ما که بحثمون مزاج شناسی نیست دوستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.26,
   "end": 351.4,
   "text": "دوست داریم که این بحث رو ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.4,
   "end": 354.62,
   "text": "اما چه کنیم؟ بحث ما قلب سیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 354.62,
   "end": 358.52,
   "text": "بحث قلب در قرآن است و رسیده‌ایم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.52,
   "end": 362.2,
   "text": "بیست و یکمین قلب، نوع قلب در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.2,
   "end": 365.06,
   "text": "به نام قلب منزل. و چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.06,
   "end": 372.38,
   "text": "عرض کردیم که القاءات حضرت حق، تنزلات حضرت حق، اون فیضی که از سمت ناحیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 372.38,
   "end": 374.86,
   "text": "حضرت حق بر قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 374.86,
   "end": 379.04,
   "text": "انسان نازل می‌شود کاملاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 379.04,
   "end": 383.02,
   "text": "ااا مرتبط با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 383.02,
   "end": 386.66,
   "text": "امزجه و نوع مزاج انسان‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 386.66,
   "end": 391.2,
   "text": "از همین حیث ما مجبور شدیم یه چیزکی پیرامون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 391.2,
   "end": 395.38,
   "text": "ااا مزاج و حیات مزاجی صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 395.38,
   "end": 399.7,
   "text": "و الا سخن به مراتب بیش از این‌هاست دامنه‌ی بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 399.7,
   "end": 402.3,
   "text": "و نیاز ما هم به مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 402.3,
   "end": 406.76,
   "text": "بسیار است نسبت به شناخت مزاج و نوع مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 406.76,
   "end": 410.7,
   "text": "و چگونگی این که انسان چگونه به سمت اعتدال برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 410.7,
   "end": 413.5,
   "text": "حالا ما چیزکی عرض می‌کنیم اما چه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 413.5,
   "end": 417.68,
   "text": "که بحث ما این نیست. حالا اگر خدا لطف کرد توفیق داد بعدها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 417.68,
   "end": 419.96,
   "text": "حالا به قول علامه به وقتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 419.96,
   "end": 421.94,
   "text": "در این خصوص هم سخن خواهیم گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.94,
   "end": 423.96,
   "text": "اما تشنه‌گان این موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.96,
   "end": 428.1,
   "text": "می‌توانند رجوع کنند به رسالات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 428.1,
   "end": 430.44,
   "text": "و ارباب این علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 430.44,
   "end": 438.42,
   "text": "پس توجه داشتید، متوجه شدید بر اساس این اصل پانزدهم کتاب شریف انسان در عرف عرفان حضرت علامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.42,
   "end": 447.52,
   "text": "حتی ایشون نوع مکاشفات و القاءات و این‌ها تمثلات که برای انسان رخ می‌دهد چه در بیداری چه در خواب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 447.52,
   "end": 450.54,
   "text": "جالبه که بدانید همونطور که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 450.54,
   "end": 453.06,
   "text": "عین متن قرائت کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 453.06,
   "end": 456.06,
   "text": "به جدول وجودی ما هم مرتبط می‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 456.06,
   "end": 461.26,
   "text": "نه صرفاً به حیات مزاجی بلکه به حیات ذاتی هم مرتبط می‌داند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 461.26,
   "end": 464.66,
   "text": "که حالا بعضیا اشکال داشتن به این قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 464.66,
   "end": 467.22,
   "text": "که چرا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 467.22,
   "end": 470.9,
   "text": "بحث حیات ذاتی رو هم اینجا مطرح کردید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 470.9,
   "end": 475.62,
   "text": "اینکه د-- هم در حیات مزاجی و هم در حیات ذاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 475.62,
   "end": 478.0,
   "text": "ما این اختلاف رو داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 478.0,
   "end": 480.04,
   "text": "در حالی که این چنین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 480.04,
   "end": 483.94,
   "text": "اتفاقا اینجا حضرت علامه اگه دقت کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 483.94,
   "end": 490.56,
   "text": "فرمودند زیرا که هر شخص جدول خاص از بحر بیکران هستی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 490.56,
   "end": 498.44,
   "text": "و نصیب او از این جدول وجودی خاصش به اقتضای مناسبتی میان او با واقع عاید او می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 498.44,
   "end": 500.98,
   "text": "پس جدول وجودی هم کاملاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 500.98,
   "end": 505.06,
   "text": "در این قصه سهم به سزایی دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 505.06,
   "end": 508.66,
   "text": "که هرچه مزاج به سمت اعتدال می‌رود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 508.66,
   "end": 513.3,
   "text": "هرچه مزاج سالم‌تر است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 513.3,
   "end": 518.28,
   "text": "انسان در تمثلات و مکاشفات و القاءاتش موفق‌تر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 518.28,
   "end": 523.82,
   "text": "حالا ما داریم تقریباً جواب اون عزیزان رو هم میدیم که بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 523.82,
   "end": 527.18,
   "text": "خیلیا یعنی یا به حالا به اون کانال‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 527.18,
   "end": 529.56,
   "text": "این مباحث مطرح میشه درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 529.56,
   "end": 534.74,
   "text": "از مدیران اون کانال‌ها می‌پرسن یا حضوری از خود حقیر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 534.74,
   "end": 537.32,
   "text": "سؤالشون این هست که چگونه است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 537.32,
   "end": 541.5,
   "text": "ما هرچه زحمت می‌کشیم به تعبیر خودشون برکت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 541.5,
   "end": 546.88,
   "text": "کارهای ما نیست یا دیر جرقه می‌خوریم، دیر وجودمون روشن می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 546.88,
   "end": 551.16,
   "text": "یا بعضیا زودتر، بعضیا دیرتر، بعضیا حتی می‌ترسند از خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 551.16,
   "end": 554.2,
   "text": "به حالت ترس و رعب از خودشون افتادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 554.2,
   "end": 556.12,
   "text": "که خیلی سریع جرقه می‌خورند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 556.12,
   "end": 558.12,
   "text": "خیلی سریع به مکاشفه می‌افتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 558.12,
   "end": 562.72,
   "text": "خیلی سریع به خواب‌های آنچنانی حتی طی الارض می‌رسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 562.72,
   "end": 567.46,
   "text": "این‌ها دیگه بستگی دارد به همون بحث مزاج و جدول وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 567.46,
   "end": 571.96,
   "text": "که این‌ها بحث بسیار دقیق و ظریفی‌ست عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 571.96,
   "end": 575.34,
   "text": "که اون‌ها الان تقریباً جواب خودشون رو دارن می‌گیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 575.34,
   "end": 578.26,
   "text": "و اگر کسی بتواند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 578.26,
   "end": 581.16,
   "text": "اعتدال مزاج رو در خودش حفظ کنه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 581.16,
   "end": 583.46,
   "text": "به اون سمت حرکت کنه خیلی زودتر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 583.46,
   "end": 590.06,
   "text": "نتیجه ممکن خواهد رسید که حالا راه‌هاش رو بعضیاش رو که حالا وقت ما ایجاب می‌کند و سیر بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 590.06,
   "end": 592.36,
   "text": "انشاالله در آینده و به مور--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 592.36,
   "end": 597.64,
   "text": "به مرور عرض خواهیم کرد. اجازه بفرمایید به همین مناسبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 597.64,
   "end": 603.5,
   "text": "یه چند جمله‌ای هم از مرحوم قطب‌الدین شیرازی از همین خصوص عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 603.5,
   "end": 609.32,
   "text": "که ایشون می‌فرمایند چون عناصر اربعة بعضی با بعضی دیگر مجتمع شوند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 609.32,
   "end": 612.12,
   "text": "همون چهار تا عنصری که عرض کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 612.12,
   "end": 615.08,
   "text": "این‌ها با هم مجتمع می‌شن، اجتماع می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 615.08,
   "end": 618.5,
   "text": "اختلاط پیدا می‌کنند با هم، امتزاج پیدا می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 618.5,
   "end": 621.36,
   "text": "که آتش بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 621.36,
   "end": 624.42,
   "text": "عرض شود آب بود و خاک بود و هوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 624.42,
   "end": 628.6,
   "text": "چنانچه عزیزان سیر بحث رو داشتن این‌ها رو عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 628.6,
   "end": 638.3,
   "text": "حالا ایشون می‌فرمایند که به واسطه‌ی کیفیات متضاده تا حدی که حاصل شود از ایشان کیفیتی متشابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 638.3,
   "end": 643.24,
   "text": "در جمع اجزای این اجتماع امتزاج ایشان باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 643.24,
   "end": 645.96,
   "text": "و آن کیفیت متوسط را مزاج گویند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 645.96,
   "end": 651.08,
   "text": "یعنی این‌ها بالاخره هر کدوم یه، هر کدوم از این عناصر اربعة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 651.08,
   "end": 653.86,
   "text": "خودشون یک کیفیاتی داشتند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 653.86,
   "end": 656.06,
   "text": "برودت بود و حرارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 656.06,
   "end": 657.88,
   "text": "و رطوبت بود و یبوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 657.88,
   "end": 661.2,
   "text": "این‌ها امتزاجی که با هم پیدا می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 661.2,
   "end": 665.58,
   "text": "هر کدوم یک کیفیت خاصی رو پیدا می‌کنند که حالا از امتزاجشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 665.58,
   "end": 668.7,
   "text": "همون مزاج ایجاد میشه و حاصل میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 668.7,
   "end": 672.38,
   "text": "که ایشون می‌فرمایند و آن کیفیت متوسط را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 672.38,
   "end": 678.36,
   "text": "مزاج گویند. متوسط یعنی همون حالت اعتدالی که ایجاد می‌شود از امتزاج این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 678.36,
   "end": 682.68,
   "text": "و البته ایشون می‌فرمایند و فساد با مزاج فرق دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 682.68,
   "end": 688.66,
   "text": "آقا خیلیا اینجا متوجه مسئله نیستند و فساد رو با مزاج یکی می‌گیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 688.66,
   "end": 692.02,
   "text": "در حالی که فساد تبدیل بصاعت‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 692.02,
   "end": 694.68,
   "text": "توجه داشته باشید. یعنی بعضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 694.68,
   "end": 697.9,
   "text": "به بعضی دیگر ااا این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 697.9,
   "end": 702.76,
   "text": "تبدیل می‌شن. یعنی انقلاب عنصری به عنصر دیگر رخ میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 702.76,
   "end": 705.88,
   "text": "و اما در مزاج این چنین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 705.88,
   "end": 709.64,
   "text": "در مزاج حد مت-- حد متوسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 709.64,
   "end": 716.78,
   "text": "تجمعات است. ربطی به بدل عنصری و تبدل عنصری به عنصر دیگر ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 716.78,
   "end": 720.04,
   "text": "و اتفاقاً مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 720.04,
   "end": 723.82,
   "text": "شیخ الرئیس در جلد یک شفا، صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 723.82,
   "end": 728.2,
   "text": "چهارصد و بیست و سه، اونجا در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 728.2,
   "end": 730.74,
   "text": "موضوع مزاج می‌فرمايد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 730.74,
   "end": 732.82,
   "text": "اصلاً ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 732.82,
   "end": 738.1,
   "text": "چون اختلاط عناصر موجب پیدایش کیفیت مخصوصه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 738.1,
   "end": 740.64,
   "text": "اصلاً مزاج کیفیتی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 740.64,
   "end": 747.64,
   "text": "که از تفاعل کیفیات متضاده موجود در عناصر یعنی همین عناصر اربعة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 747.64,
   "end": 752.76,
   "text": "حاصل میشه. یعنی بالاخره هر کدومشون یک کیفیتی دارند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 752.76,
   "end": 755.66,
   "text": "متضاد با هم‌اند. یعنی برودت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 755.66,
   "end": 758.66,
   "text": "برودت متضاد با حرارت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 758.66,
   "end": 762.08,
   "text": "یا رطوبت متضاد با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 762.08,
   "end": 766.78,
   "text": "یبوست است. این‌ها همونطور که ملاحظه می‌فرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 766.78,
   "end": 769.88,
   "text": "به روایت بزرگان اهل معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 769.88,
   "end": 772.88,
   "text": "اهمیت این موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 772.88,
   "end": 777.4,
   "text": "حتی در ساختن ابدیت ما موثر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 777.4,
   "end": 780.68,
   "text": "چه به نه فقط همین دو روزه دنیا، بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 780.68,
   "end": 783.24,
   "text": "ما به قول بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 783.24,
   "end": 787.56,
   "text": "از حضرت علامه طباطبایی علیه رحمة بگیر تا استاد کل حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 787.56,
   "end": 793.6,
   "text": "علامه حسن زاده ابد در پیش داریم و در این ابد ساختن ابد خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 793.6,
   "end": 797.02,
   "text": "کاملاً نیاز مبرم داریم به شناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 797.02,
   "end": 799.38,
   "text": "این کیفیات حاصله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 799.38,
   "end": 803.02,
   "text": "و چه حیات از حیث حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 803.02,
   "end": 805.86,
   "text": "ذاتی و چه از حیث حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 805.86,
   "end": 809.02,
   "text": "مزاجی که حالا بعد انشاالله در جلسات بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 809.02,
   "end": 814.66,
   "text": "بیشتر با هم سخن خواهیم گفت که اصلاً مزاج اتم چیست، مزاج اشرف چیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 814.66,
   "end": 817.9,
   "text": "یا مزاج خارج چگونه است و ربط این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 817.9,
   "end": 823.24,
   "text": "انشاالله که عاقبت good به خیر باشد به برکت صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}