 ],
 "cues": [
  {
   "i": 0,
   "start": 0.58,
   "end": 5.0,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.0,
   "end": 8.7,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.7,
   "end": 12.26,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.26,
   "end": 22.08,
   "text": "ایام میلاد بسیار با عظمت و بی‌نظیر حضرت زینب کبرا سلام الله علیها را بر همه دوستان و عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.08,
   "end": 29.28,
   "text": "تبریک عرض می‌کنیم. ان شاء الله که مورد عنایت خاص و ویژه عمه امام زمانمون قرار بگیریم همگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.28,
   "end": 31.64,
   "text": "بله، طوفان هوى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.64,
   "end": 34.36,
   "text": "تهلیهٔ عنی زینب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.36,
   "end": 39.58,
   "text": "خب می‌دونید که همه آنچه که مشهود ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.58,
   "end": 43.52,
   "text": "هر آنچه که می‌بینیم وجود است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.52,
   "end": 51.2,
   "text": "به یک معنا تشئونات وجود است که و \"کل يوم هو في شأن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.2,
   "end": 53.4,
   "text": "اصلاً از همین آیه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.4,
   "end": 56.14,
   "text": "بحث شؤون الهی برداشت شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.14,
   "end": 63.4,
   "text": "هو في شأن و همه این تشئونات حضرت حق هر کدوم یک جلوه‌ای دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.4,
   "end": 67.02,
   "text": "هرچه سعه وجودی بیشتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.02,
   "end": 71.68,
   "text": "جلوه‌شون بیشتر. یکی جلوه‌ش مثل یک نسیمه، یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.68,
   "end": 74.92,
   "text": "شدیدتره، یکی طوفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.92,
   "end": 80.24,
   "text": "حالا اینجا عرض می‌کنیم طوفان هوى تهلیهٔ عنی زینب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.24,
   "end": 85.62,
   "text": "تهلیه هم که همون ذکر حقیقت ذکر لا اله الا الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.62,
   "end": 94.12,
   "text": "امیدوارم که در جدول وجودیتون این شعر درست جا بیفته که عنایت حضرت حق بود در جلسه‌ای به این حقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.12,
   "end": 97.2,
   "text": "طوفان هوى تهلیهٔ عنی زینب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.2,
   "end": 101.14,
   "text": "زینب علی و فاطمهٔ عنی زینب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.14,
   "end": 105.42,
   "text": "این عین حسن مثل حسین عمه ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.42,
   "end": 110.42,
   "text": "به به. این عین حسن مثل حسین عمه ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.42,
   "end": 113.38,
   "text": "آن ولوله در علقه عنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.38,
   "end": 115.52,
   "text": "زینب سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.52,
   "end": 119.12,
   "text": "عزیزان توجه داشته باشن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.12,
   "end": 125.32,
   "text": "خب از بحث احکام هم جا نمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.32,
   "end": 129.82,
   "text": "ذیل محبت و ولایت بیبی جانمون عرض می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.82,
   "end": 134.78,
   "text": "سؤال، چرا انقدر نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.78,
   "end": 138.82,
   "text": "اهمیت پیدا کرده و هرچه تعداد بیشتر ثواب بیشتر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.82,
   "end": 141.16,
   "text": "جواب، اهمیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.16,
   "end": 144.78,
   "text": "بُعد اجتماعی انسان‌هاست که این چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.78,
   "end": 148.44,
   "text": "می‌کند تا جایی که پرده‌نشینی مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.44,
   "end": 154.84,
   "text": "دختر شیر خدا حضرت زینب سلام الله علیها به جهت اون عظمت و جایگاه و اهمیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.84,
   "end": 157.32,
   "text": "بُعد و ابعاد اجتماعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.32,
   "end": 159.94,
   "text": "حاضر میشن بیرون و بیرون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.94,
   "end": 162.84,
   "text": "صحنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.84,
   "end": 165.32,
   "text": "در حقیقت در میان گود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.32,
   "end": 168.32,
   "text": "این چنین خرو-- به خروشند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.32,
   "end": 172.7,
   "text": "شکوه بیافرینند و آنچنان خطبه بخوانند و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.7,
   "end": 178.48,
   "text": "پس یادمون نره اهمیت و جایگاه ابعاد اجتماعی ما رو که متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.48,
   "end": 183.1,
   "text": "دستخوش تحلیل غلط بسیاری از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.1,
   "end": 191.36,
   "text": "رهروان دروغین این راه قرار گرفته و جوون‌های ما رو از ابعاد اجتماعی و اهمیت اون غافل کردند و دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.36,
   "end": 195.96,
   "text": "عرفان‌های حلقه و گوشه‌نشینی و روحانیت و این چنین چیزها کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.96,
   "end": 202.64,
   "text": "اما بحثمون که پیرامون قلب منزل بود رو به فضل الهی ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 202.64,
   "end": 212.44,
   "text": "بله به هر حال بعضاً یا پیام‌هایی که میاد از طریق مدیر کانال یا عزیزانی که حضوری شرکت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 212.44,
   "end": 219.04,
   "text": "خب بعضیا معتقدن که این مطالب و این معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 219.04,
   "end": 222.76,
   "text": "خیلی دست یافتنی نیست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 222.76,
   "end": 226.48,
   "text": "به نوعی میشه گفت عملیاتی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 226.48,
   "end": 229.24,
   "text": "و خیلی بیشتر بُعد نظری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 229.24,
   "end": 233.9,
   "text": "خیلی-- حالا خلاصه‌ش اینکه خیلی به درد ما نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 233.9,
   "end": 236.1,
   "text": "به چه جهت به درد ما نمی‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 236.1,
   "end": 239.34,
   "text": "چون ما متوجه نمی‌شیم. خیلی بحث سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 239.34,
   "end": 244.32,
   "text": "خب اینجا وقتی بحث سنگین میشه دو تا مطلب رو عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 244.32,
   "end": 246.82,
   "text": "عقل رو خدا برای چی به ما داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 246.82,
   "end": 250.56,
   "text": "عقل برای مطالب و مباحث پیچیده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 250.56,
   "end": 253.62,
   "text": "مسائل متعارف که نیازی به عقل نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 253.62,
   "end": 260.86,
   "text": "مسائلی که در حقیقت قوه خیال ما و وهم ما جوابگوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.86,
   "end": 263.24,
   "text": "اون‌ها هستند چه نیازی به عقل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 263.24,
   "end": 266.66,
   "text": "عقل اصلاً برای مطالب پیچیده و غامض و دشواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.66,
   "end": 269.46,
   "text": "اگر کسی وقتی متوجه شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.46,
   "end": 272.54,
   "text": "درک چیزی سخته، دشواره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.54,
   "end": 277.56,
   "text": "و سر باز زد از اون یعنی عقلش رو به بیگاری گرفته و عقلش رو تعطیل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 277.56,
   "end": 280.34,
   "text": "چنین کسی نه به عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.34,
   "end": 284.06,
   "text": "یعنی نه به عقل می‌رسد، نه به فوق طور عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.06,
   "end": 288.52,
   "text": "خب چنین کسی بله در گرداب‌های نفهمی گیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.52,
   "end": 291.06,
   "text": "حالا ما جسارت نمی‌کنیم به عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.06,
   "end": 293.1,
   "text": "منظورمون کساییه که این چنین هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.1,
   "end": 296.12,
   "text": "یعنی با این روشی که ما عرض کردیم جلو میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 296.12,
   "end": 300.48,
   "text": "بله اینها گیر می‌کنند و اون مطالب پیچیده و غامض رو متوجه نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 300.48,
   "end": 303.96,
   "text": "لذا به اطوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.96,
   "end": 307.4,
   "text": "گوناگون خودشون، به اون اطوار خطیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.4,
   "end": 310.88,
   "text": "و دقیق وجودی خودشون آگاه نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.88,
   "end": 313.58,
   "text": "لایه‌های وجودی خودشون رو بی‌خبر می‌مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.58,
   "end": 317.12,
   "text": "و چه بد که انسان نسبت به خودش بی‌خبر باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.12,
   "end": 324.68,
   "text": "این بدترین نوع زندگی‌ست به نظرم که کسی از خودش بی‌خبر باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 324.68,
   "end": 329.56,
   "text": "خب بله این معارف وقتی عقل به کار افتاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.56,
   "end": 335.56,
   "text": "عقل این‌ها رو برهان‌سازی می‌کنه و کلی‌سازی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 335.56,
   "end": 341.74,
   "text": "اون جزئی‌سازی‌هایی که وهم ایجاد کرده بودو به صورت کلی در میاره تا بفهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.74,
   "end": 344.24,
   "text": "و وقتی باز عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 344.24,
   "end": 346.64,
   "text": "کارکردش اینجا تمام شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 346.64,
   "end": 353.72,
   "text": "این کلی‌سازی‌ها رو برای درک بهتر و درک عمیق‌تر و ظریف‌تر تحویل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.72,
   "end": 359.3,
   "text": "اون رتبه پنهانی‌تر یا رتبه بالایی‌تر از جهت مکانیتی عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 359.3,
   "end": 367.21,
   "text": "از جهت رتبه‌ای یعنی قلب میده که سلطان وجود است و همه این‌ها کارگران او حساب می‌شوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 367.21,
   "end": 373.07,
   "text": "و اینجا در حقیقت فهم این حقایق و این م-مطالب غالباً می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 373.07,
   "end": 376.13,
   "text": "فوق طور عقل. بارها عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 376.13,
   "end": 380.87,
   "text": "که بزرگان اهل معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 380.87,
   "end": 383.39,
   "text": "بسیار این رو گوشزد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.39,
   "end": 389.91,
   "text": "بسیار حضرت علامه حسن زاده گوشزد کردن که این معارف فوق طور عقل شماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 389.91,
   "end": 393.65,
   "text": "و باید با قلبتون در مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 393.65,
   "end": 397.59,
   "text": "حضور، در مقام Sand دیدن حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 397.59,
   "end": 400.85,
   "text": "در معرکه باشید، در محضر باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 400.85,
   "end": 405.83,
   "text": "و الا خب بله انسان گیر میکنه و دست و پا میزنه و چیزی هم متوجه نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 405.83,
   "end": 412.95,
   "text": "لذا باید درست درمان به داد قلبمون برسیم، او رو بشناسیم، جایگاهش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 412.95,
   "end": 415.73,
   "text": "چگونگی انزال حقایق بر او رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 415.73,
   "end": 419.29,
   "text": "پس و پیشش رو. اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 419.29,
   "end": 424.51,
   "text": "بزرگان فهمیدن و چند جلسه ما عرض کردیم که قلب مقامش مقام برزخی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 424.51,
   "end": 430.13,
   "text": "یعنی چی؟ این‌ها رو بداند و در کم و کیف کار در حین عملیات بندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 430.13,
   "end": 434.65,
   "text": "از این‌ها بهره بگیرد و بهره بجوید که اگر غیر از این باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 434.65,
   "end": 436.75,
   "text": "خب انسان به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 436.75,
   "end": 443.59,
   "text": "همون حیوانیت پیش میره بلکه پس میفته و به سمت نباتی و بلکه جمادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 443.59,
   "end": 447.23,
   "text": "پس وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 447.23,
   "end": 450.71,
   "text": "حقایق فوق طور عقل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 450.71,
   "end": 454.99,
   "text": "اسمش رو خودشه. می‌طلبد که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 454.99,
   "end": 460.27,
   "text": "خیلی اولاً نسبت به شناخت لایه‌های درونی خودش بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 460.27,
   "end": 464.75,
   "text": "توجه کرده باشه، زحمت کشیده باشه و اهل همت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 464.75,
   "end": 466.99,
   "text": "و دو اینکه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 466.99,
   "end": 469.89,
   "text": "عملیات پیچیده‌تری رو می‌طلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 469.89,
   "end": 472.97,
   "text": "و دقت نظر بیشتری رو می‌طلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 472.97,
   "end": 475.47,
   "text": "که اصلاً اسمش هم رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 475.47,
   "end": 478.51,
   "text": "قلبه یک آن ازش غافل بشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 478.51,
   "end": 482.25,
   "text": "منقلب میشه. منقلب میشه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 482.25,
   "end": 484.71,
   "text": "قلبی که تا لحظاتی پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 484.71,
   "end": 489.51,
   "text": "وجهش رو به قدس نظام هستی داشت، رو به عرش داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 489.51,
   "end": 492.13,
   "text": "یک آن غفلت می‌بینی رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 492.13,
   "end": 495.39,
   "text": "مادون و دنیا دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.39,
   "end": 498.17,
   "text": "یک آن غفلت کنی می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 498.17,
   "end": 501.89,
   "text": "دچار یعنی مشوب به وهم و خیال و این‌ها میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 501.89,
   "end": 503.89,
   "text": "حقایق رو درست متوجه نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 503.89,
   "end": 507.23,
   "text": "خیلی باید دقت کرد. تازه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 507.23,
   "end": 511.15,
   "text": "الفاظی هم که می‌بینید بزرگان استفاده می‌کنند برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 511.15,
   "end": 513.91,
   "text": "سهولت در فهم این الفاظ هم خاکی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 513.91,
   "end": 518.95,
   "text": "یعنی این‌ها هم توان این رو ندارن که اون حقیقت رو به ما القا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 518.95,
   "end": 526.65,
   "text": "این‌ها این الفاظ تازه خیلی موقع به قول حضرت علامه حسن زاده علیه رحمة رهزن می‌شوند و ما رو به بیراهه می‌کشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 526.65,
   "end": 534.33,
   "text": "خیلی می‌طلبه که انسان اهل تلاش و کوشش و سوز و توسل و سجاده و اشک و آه و این‌ها باشد که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 534.33,
   "end": 537.25,
   "text": "پس عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 537.25,
   "end": 539.99,
   "text": "می‌طلبد که اهل همت باشند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 539.99,
   "end": 544.29,
   "text": "و در اوصاف الاشراف کتاب خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 544.29,
   "end": 547.39,
   "text": "با عظمت و عالی‌ست. عزیزان بگیرن مطالعه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 547.39,
   "end": 550.61,
   "text": "الحمدلله ترجمه به فارسی هم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 550.61,
   "end": 553.23,
   "text": "مرحوم خواجه طوسی علیه رحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 553.23,
   "end": 557.65,
   "text": "اونجا اصلاً این مقام رو این مقام برهان رب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 557.65,
   "end": 562.33,
   "text": "که فوق طور عقل هست رو مقام هیمان می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 562.33,
   "end": 565.27,
   "text": "هیمان که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 565.27,
   "end": 571.01,
   "text": "به یک تعبیری میشه شاید از اونجا برداشت کردن که ملائکه‌ای هستند که مهیمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 571.01,
   "end": 573.61,
   "text": "که هستن. اینا اون در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 573.61,
   "end": 580.31,
   "text": "رتبه‌های بسیار بالا قرار گرفتند که اون‌ها فقط از حضرت حق باخبرند نه از هیچ خلقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 580.31,
   "end": 584.07,
   "text": "از هیچکس خبر ندارند جز حضرت حق که بحثش در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 584.07,
   "end": 586.91,
   "text": "موضوع لقاء الله شب‌های جمعه گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.91,
   "end": 593.21,
   "text": "بحث ما در قلب منزل این بود که قلب منزلگاه و فرودگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 593.21,
   "end": 599.93,
   "text": "عنایات الهی‌ست و رزق رو از طریق قلب وجود ما اخذ می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 599.93,
   "end": 603.77,
   "text": "در صفحه دویست و هفتاد و دو فس الشعیبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 603.77,
   "end": 608.49,
   "text": "خصوص الحکم رو اگر عزیزان داشته باشن مرحوم ابن عربی اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 608.49,
   "end": 611.47,
   "text": "یه جمله خیلی ظریفی رو دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 611.47,
   "end": 618.85,
   "text": "که می‌فرماید \"و لیس ذلک النفس الا عين الهویه الساریه في الموجودات کلها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 618.85,
   "end": 621.81,
   "text": "بحث نفس رحمانی رو مطرح می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 621.81,
   "end": 630.13,
   "text": "چون بحث حیات اینجا مطرح می‌شود و هر مقدار که قلب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 630.13,
   "end": 634.09,
   "text": "در وجود خودش در جدول وجود اون حس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 634.09,
   "end": 638.35,
   "text": "وجودی خودش از آب حیات بیشتر بهره گرفته است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 638.35,
   "end": 640.33,
   "text": "فهم و درکش هم بیشتر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 640.33,
   "end": 642.87,
   "text": "که ما باید تا می‌تونیم ظرفیت سازی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 642.87,
   "end": 647.61,
   "text": "یکی از مهم‌ترین کارهایی که یک سالک الی الله می‌کنه ظرفیت سازی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 647.61,
   "end": 649.55,
   "text": "عبادات ظرفیت سازی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 649.55,
   "end": 652.55,
   "text": "البته ع-عبادات به حق معثور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 652.55,
   "end": 655.63,
   "text": "نه هر ذکری، نه هر نمازی، نه هر کاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 655.63,
   "end": 663.55,
   "text": "بعضی دوستان میان به ما میگ- مثلاً میگن فلان نماز اصلاً این تو هیچ کتابی نیومده، نه اسمش نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 663.55,
   "end": 666.51,
   "text": "طورش. هیچ طور هیچ کجا ندیدیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 666.51,
   "end": 668.57,
   "text": "نمی‌دونم این نمازها از کجا ساخته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 668.57,
   "end": 670.41,
   "text": "این از کار از کجا ساخته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 670.41,
   "end": 675.15,
   "text": "بارها عرض کردیم کتاب‌هایی که بزرگان سفارش کردن حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 675.15,
   "end": 679.09,
   "text": "به مرور عرض می‌کنیم. جای دیگه‌ای نرن عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 679.09,
   "end": 681.93,
   "text": "اینجا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 681.93,
   "end": 685.57,
   "text": "وقتی بحث حیات مطرح می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 685.57,
   "end": 688.69,
   "text": "حیات رو می‌بره از همون ابتدایی که حس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 688.69,
   "end": 691.07,
   "text": "وجودی ما به اونجا مرتبط میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 691.07,
   "end": 693.45,
   "text": "که اون هم صادر اول است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 693.45,
   "end": 698.89,
   "text": "البته اون هم الب-- از وجود اهدی حضرت حق بهره گرفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 698.89,
   "end": 709.03,
   "text": "وقتی که ما ذیل نفس رحمانی حضرت حق قرار گرفتیم که \"و لیس ذلک النفس الا عين الهویه الساریه في الموجودات کلها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 709.03,
   "end": 713.13,
   "text": "همه موجودات که همه این‌ها به یک معنا همون اشیاء‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 713.13,
   "end": 717.03,
   "text": "به یک معنا همون اسماء خارجی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 717.03,
   "end": 721.27,
   "text": "این‌ها بهره گرفتند از نفس رحمانی حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 721.27,
   "end": 726.11,
   "text": "و این عنایتی‌ست به همه موجودات نظام هستی که خدا به همشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 726.11,
   "end": 733.31,
   "text": "توجه کرده است و اون‌ها، اون‌ها رو قابلیت بخشیده است که از آب حیات و وجود بهره بگیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 733.31,
   "end": 736.69,
   "text": "که این حیات رو ما مدیون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 736.69,
   "end": 739.33,
   "text": "پس از حضرت حق مدیون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 739.33,
   "end": 746.77,
   "text": "مقام شامخ نفس رحمانی یا صادر اول هستیم که از اونجا حیات منشعب می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 746.77,
   "end": 749.31,
   "text": "و همه این خلائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 749.31,
   "end": 751.71,
   "text": "از عقل اول بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 751.71,
   "end": 759.31,
   "text": "تا مادون عقل اول که همه خلق هستند و در آنها تقدیر و اندازه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 759.31,
   "end": 762.43,
   "text": "همه که خلقند یعنی در آنها تقدیر و اندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 762.43,
   "end": 766.05,
   "text": "همه این‌ها در حقیقت یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 766.05,
   "end": 772.07,
   "text": "قدری، یک اندازه‌ای، یک جدولی تعبیه شده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 772.07,
   "end": 780.13,
   "text": "و از همون جا از وجود بهره‌مند شدند که همه این‌ها در هویت سارية یعنی همون صادر اول منطقش‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 780.13,
   "end": 783.11,
   "text": "که اینها کلمات وجودی نظام هستی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 783.11,
   "end": 785.61,
   "text": "در حقیقت می‌سازن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 785.61,
   "end": 790.19,
   "text": "همه این خلائق، همه این کثرات که البته اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 790.19,
   "end": 798.77,
   "text": "به تشریح و به، اه، تفصیل خواست این بحث رو دنبال کنه در کتاب شریف وحدت از دیدگاه عارف و حکیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 798.77,
   "end": 803.27,
   "text": "حضرت علامه حسن زاده علیه الرحمه مباحث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 803.27,
   "end": 806.81,
   "text": "اه، این اول ما خلق الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 806.81,
   "end": 809.39,
   "text": "اه، العقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 809.39,
   "end": 811.35,
   "text": "یا نوری این‌ها رو اونجا آورده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 811.35,
   "end": 813.73,
   "text": "علامه خیلی خوب دسته‌بندی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 813.73,
   "end": 816.15,
   "text": "که حالا در آیات قرآن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 816.15,
   "end": 819.53,
   "text": "مثلاً همونطور که در سیر بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 819.53,
   "end": 826.51,
   "text": "لقاءالله عرض کردیم در آیه بیست و هفت سوره لقمان، اونجا خدای منان می‌فرماید که \"و لو انما في الأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 826.51,
   "end": 829.13,
   "text": "من شجرة أقلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 829.13,
   "end": 838.11,
   "text": "والبحر یمده من بعده سبعة أبحر ما نفدت كلمات الله إن الله عزيز حکیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 838.11,
   "end": 844.05,
   "text": "این همون کلمات وجودی ذیل رقیه منشور یا صادر اول رو داره بیان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 844.05,
   "end": 849.63,
   "text": "که همه این‌ها اجتماع کردن و منطق‌شن در اون پرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 849.63,
   "end": 854.49,
   "text": "آویخته. این کلمات قرآن می‌فرماید این آیه شریفه می‌فرماید که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 854.49,
   "end": 856.79,
   "text": "هفت تا دریا هم بشن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 856.79,
   "end": 859.37,
   "text": "درختان قلم باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 859.37,
   "end": 864.71,
   "text": "این‌ها تموم میشن، این دریاها و قلم‌ها تموم میشن اما کلمات الهی تموم نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 864.71,
   "end": 868.61,
   "text": "کلمات الهی به یک معنا همون آیاتند، همون مجالی‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 868.61,
   "end": 872.43,
   "text": "همون تجلیات حضرت حق‌اند، همون اضلالند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 872.43,
   "end": 875.41,
   "text": "ظل و سایه‌اند که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 875.41,
   "end": 878.83,
   "text": "ذیل هویت سارية و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 878.83,
   "end": 881.53,
   "text": "اونجا تعریف می‌شوند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 881.53,
   "end": 887.93,
   "text": "در حقیقت هر کجا رقیه منشور یا این هویت سارية یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 887.93,
   "end": 892.07,
   "text": "عرض شود نفس الرحمن قدم گذاشت به فراخور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 892.07,
   "end": 894.33,
   "text": "سع و ضیغ مظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 894.33,
   "end": 897.07,
   "text": "خودنمایی می‌کند. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 897.07,
   "end": 903.01,
   "text": "اینجا از اینجا به بعد که دیگه حیات خلقی خودش رو نشون میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 903.01,
   "end": 907.09,
   "text": "حیات انشعاب پیدا می‌کنه که عرض شد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 907.09,
   "end": 913.65,
   "text": "از اینجا به بعد مقام یعنی بعد از احدیت حضرت حق که مقام استهلاك است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 913.65,
   "end": 916.63,
   "text": "مقام استهلاك که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 916.63,
   "end": 919.23,
   "text": "اه، بحث قلب مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 919.23,
   "end": 922.19,
   "text": "Sandیدن است در مقابل استهلاك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 922.19,
   "end": 925.55,
   "text": "اینو دیگه مستحضر هستید قبلاً عرض کردیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 925.55,
   "end": 931.37,
   "text": "که به ضرب من البيان همونطور که حضرت علامه حسن زاده علیه الرحمه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 931.37,
   "end": 937.47,
   "text": "در شرح در اون کتاب شریف ممد الهمم همشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 937.47,
   "end": 940.19,
   "text": "در تشریح حقیقت هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 940.19,
   "end": 944.05,
   "text": "و وجود و عرفان به الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 944.05,
   "end": 949.45,
   "text": "که میشه گفت غایت قصبای مسیر تکاملی انسان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 949.45,
   "end": 953.39,
   "text": "در این سیر الله منتشر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 953.39,
   "end": 957.05,
   "text": "الله همون مقام، اه، سان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 957.05,
   "end": 959.37,
   "text": "مقام حضور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 959.37,
   "end": 963.09,
   "text": "اینکه سان می‌بینی از همه قوای وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 963.09,
   "end": 967.57,
   "text": "و می‌شود گفت که اسماء و صفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 967.57,
   "end": 975.41,
   "text": "میان در مقام کثرت از اینجا به بعد خودشونو نشون میدن که ذیل مقام احدیت حضرت حق تعریف شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 975.41,
   "end": 978.79,
   "text": "حالا ما خیلی وارد این اصطلاحات نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 978.79,
   "end": 982.73,
   "text": "منظورمون ارتباط و اتصال این‌ها با هم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 982.73,
   "end": 986.59,
   "text": "که متوجه بشیم بالاخره ما کجا قرار داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 986.59,
   "end": 991.11,
   "text": "و، اه، اونجا به نحو اهدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 991.11,
   "end": 994.73,
   "text": "همه کثرات مستهلک هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 994.73,
   "end": 997.83,
   "text": "مقابلش میشه مقام قلب که مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 997.83,
   "end": 1001.75,
   "text": "Sandیدن حقایق است. و این مقام قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1001.75,
   "end": 1005.47,
   "text": "مقامی‌ست که برزخ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1005.47,
   "end": 1007.95,
   "text": "در حقیقت حیات ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1007.95,
   "end": 1013.33,
   "text": "بعد از مقام احدیه حضرت حق، حیات ما از طریق قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1013.33,
   "end": 1022.07,
   "text": "منتشر شده، از طریق قلب ایجاد شده، از طریق قلب ادامه پیدا کرده است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1022.07,
   "end": 1025.73,
   "text": "عرض کردیم اگر قلب رو ورداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1025.73,
   "end": 1028.85,
   "text": "اصلاً اون اتصال قطع میشه و امکانش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1028.85,
   "end": 1035.67,
   "text": "می‌شود که قلب کسی بمیرد منظور در حجاب است نه اینکه اون اتصال بن کل قطع بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1035.67,
   "end": 1037.83,
   "text": "حالا چون فرصت گذشت انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1037.83,
   "end": 1045.49,
   "text": "بقیه همین مطلب رو ادامه خواهیم داد که جایگاه قلب رو بهتر متوجه بشید و انشاالله ربطش بدیم به بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1045.49,
   "end": 1048.57,
   "text": "حیات مزاجی. والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1048.57,
   "end": 1050.77,
   "text": "انشاالله که عاقبت بخیر شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1050.77,
   "end": 1052.63,
   "text": "به برکت صلوات بر محمد و آل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
