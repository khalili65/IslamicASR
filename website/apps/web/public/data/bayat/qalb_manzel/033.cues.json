 "chapters": [
  {
   "index": 0,
   "title": "## اعتدال مزاج و نگرانی دوستان",
   "start": 9.66,
   "end": 93.34
  },
  {
   "index": 1,
   "title": "## تغذیه و عبدیت؛ دو راه تغییر مزاج",
   "start": 93.34,
   "end": 185.96
  },
  {
   "index": 2,
   "title": "## تبدیل اخلاق با بندگی",
   "start": 185.96,
   "end": 276.72
  },
  {
   "index": 3,
   "title": "## مصحف و سلسلهٔ نخودکی تا شوشتری",
   "start": 276.72,
   "end": 380.86
  },
  {
   "index": 4,
   "title": "## دستور چهارده ماه چهارده ختم",
   "start": 380.86,
   "end": 645.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.78,
   "end": 4.24,
   "text": "بسم الله الرحمن الرحيم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.24,
   "end": 9.66,
   "text": "السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.66,
   "end": 16.78,
   "text": "سلام ما و همه عزیزانی که دلشون اینجاست به آقای مهربانی‌ها، امام رؤوف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.78,
   "end": 23.38,
   "text": "الحمد لله على کل نعمة که در فضای حرم رضوی نفس می‌کشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.38,
   "end": 27.58,
   "text": "خدا این توفیق را از ما نگیره و همیشگیش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.58,
   "end": 31.22,
   "text": "در بحث قلب منزل رسیده بودیم به مزاج و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.22,
   "end": 36.54,
   "text": "شاید این آخرین جلسه‌ای باشه که در محضر شما پیرامون این موضوع حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.54,
   "end": 41.02,
   "text": "خب بعضیا دل نگران شده بودند چون ما عرض کرده بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.02,
   "end": 44.2,
   "text": "بر اساس فرمایش بزرگان خصوصا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.2,
   "end": 47.94,
   "text": "حضرت علامه حسن زاده علیه الرحمه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.94,
   "end": 55.3,
   "text": "اعتدال مزاج بسیار موثره برای تهذیب اخلاق و کسب فضایل و کمالات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.3,
   "end": 58.36,
   "text": "حتی در تمثلات و منامات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.36,
   "end": 62.16,
   "text": "این‌ها و در سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.16,
   "end": 65.92,
   "text": "و کسی که اعتدال مزاج نداره و مزاجش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.92,
   "end": 68.4,
   "text": "حالت اعتدال خارج شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.4,
   "end": 71.92,
   "text": "گرفتاری‌های عدیده و عجیبی در این قصه پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.92,
   "end": 74.42,
   "text": "خب اینا نگران شده بودند خیلیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.42,
   "end": 76.16,
   "text": "توجه نداشتند به یک چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.16,
   "end": 80.24,
   "text": "اونم این که ما عرض کردیم مزاج قابل تبدیل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.24,
   "end": 83.12,
   "text": "عزیزان این نکته رو توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.12,
   "end": 86.34,
   "text": "شاید خیلی به این قصه بعضیا توجه نکرده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.34,
   "end": 89.42,
   "text": "بله مزاج قابل تبدیل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.42,
   "end": 91.96,
   "text": "مزاج عوض شدنی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.96,
   "end": 97.9,
   "text": "و ما باید تلاش کرد. حالا یکی از راه‌هایی که مزاج تغییر می‌کنه خب هم بحث تغذیه‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.9,
   "end": 101.82,
   "text": "که باید عزیزان به منابع و مواخل مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.82,
   "end": 106.44,
   "text": "و صحیح اسلامی ما البته رجوع کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.44,
   "end": 108.74,
   "text": "و راهش رو بیابند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.74,
   "end": 115.34,
   "text": "اما یکی دیگه از راه‌ها اگر یادتون باشه عرض کردیم که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.34,
   "end": 120.94,
   "text": "خود اطاعت الهی و عبادیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.94,
   "end": 123.88,
   "text": "یا بهتره بگیم عبدیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.88,
   "end": 126.74,
   "text": "خودش اعتدال مزاج میاره به مرور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.74,
   "end": 134.08,
   "text": "شما دقت بفرمایید کسانی که بیشتر در مسیر اطاعت حضرت حق هستند مراجع و علما و بزرگان رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.08,
   "end": 136.48,
   "text": "معمولا آدمای تو هر جهت موفق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.48,
   "end": 139.62,
   "text": "حتی چهره‌هاشون، قد و قامت‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.62,
   "end": 144.6,
   "text": "اینا همه با دیگران انرژی و پتانسیلی که دارند با دیگران خیلی فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.6,
   "end": 149.06,
   "text": "خیلی اون‌ها آدم‌های م-موفق‌تری هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.06,
   "end": 153.2,
   "text": "و خیلی سریع‌تر به هدف و مقصودشون می‌رسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.2,
   "end": 155.56,
   "text": "حتی چهره‌هاشون، ظاهرشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.56,
   "end": 158.58,
   "text": "باطن‌شون همه فرق می‌کنه با دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.58,
   "end": 164.3,
   "text": "باور کنید یکی از علت‌های زیادش همینه که در-- چون در مسیر اطاعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.3,
   "end": 168.52,
   "text": "حضرت حق هستند، یکی از مهم‌ترین دلایلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.52,
   "end": 172.74,
   "text": "به جهت اینکه در مسیر اطاعت حضرت حق هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.74,
   "end": 179.02,
   "text": "و در مسیر تهذیب نفس هستند و در مسیر تهذیب اخلاق هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.02,
   "end": 183.24,
   "text": "اینا مزاج به سمت اعتدال حرکت می‌کنه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.24,
   "end": 185.96,
   "text": "اینو توجه داشته باشیم هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.96,
   "end": 191.36,
   "text": "مثال مزاج. حالا دیده شده خیلیا کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.36,
   "end": 197.14,
   "text": "قبل از اینکه ورود کنند به مسیر بندگی، آدمای به شدت بداخلاقی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.14,
   "end": 199.5,
   "text": "اصلا نمیشد اونها رو تحمل کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.5,
   "end": 204.04,
   "text": "ولی به مرور وقتی که عبادت و بندگی رو پیش گرفتند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.04,
   "end": 209.06,
   "text": "حالا حتی درس و بحث‌ها و این‌ها رو بعد سعی کردند در عمل پیاده کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.06,
   "end": 211.76,
   "text": "به سمت اخلاق بروند، سبک زندگی اسلامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.76,
   "end": 214.78,
   "text": "اینا بعد می‌بینی به رفته، رفته آدم‌های خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 214.78,
   "end": 216.88,
   "text": "خوب و متین و آرام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.88,
   "end": 218.88,
   "text": "حتی چهره‌ها بشاش، زیبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 218.88,
   "end": 223.78,
   "text": "آدم دوست داره نگاه کنه، نگاهش رو ادامه بده و مد بده به نگاهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.78,
   "end": 229.26,
   "text": "حتی عبادت نیمه شب، نماز شب می‌بینی چنان تأثیر می‌کنند در چهره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.26,
   "end": 233.4,
   "text": "وقتی در ظاهر این چنین تأثیر می‌کنه ببین در باطن چه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.4,
   "end": 236.52,
   "text": "بله این‌ها چه می‌کنند عزیزان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.52,
   "end": 239.14,
   "text": "مزاج رو تقویت می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.14,
   "end": 241.66,
   "text": "اعتدال می‌بخشند. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.66,
   "end": 243.9,
   "text": "یکی از اسرار اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.9,
   "end": 247.94,
   "text": "مداومت بر اعمال خیلی توصیه شده در اسلام همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.94,
   "end": 252.14,
   "text": "و در احادیثی داریم که فرمودند یک عملی رو که دست گرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.14,
   "end": 254.62,
   "text": "حالا چهل‌ه که می‌گیری خیلی خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.62,
   "end": 258.6,
   "text": "چهل‌ه به د-به جهت اون برکت عدد چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.6,
   "end": 260.18,
   "text": "کمکت می‌کنه، برکت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.18,
   "end": 267.36,
   "text": "اما حتما سعیت بر این باشه که د-- تا چ-- حداقل یک سال مداومت کنی بر هر چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.36,
   "end": 272.42,
   "text": "یه سرش در اینه که مداومت بر هر کار خوبی تا یک سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.42,
   "end": 276.72,
   "text": "مزاج رو به سمت اعتدال می‌کشونه سریعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.72,
   "end": 282.16,
   "text": "حالا که به اینجا رسید اجازه بفرمایید که در این تحت عنوان بحث مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.16,
   "end": 289.36,
   "text": "ما یک یادگاری و یک هدیه‌ای هم به شما تقدیم کنیم که بعضی از دوستانی که در هیئت یا زهرا بودند بهشون گفتیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.36,
   "end": 292.74,
   "text": "بعضا انجام دادند و الحمد لله نتیجه گرفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.74,
   "end": 296.58,
   "text": "یکی از چیزهایی که اعتدال مزاج می‌آورد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.58,
   "end": 301.48,
   "text": "حالا در کنار اون هدایایی که از خصوصه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.48,
   "end": 304.62,
   "text": "مصح قرآن، مصح قرآن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.62,
   "end": 308.0,
   "text": "چهارشنبه و پنجشنبه و جمعه در سوره بیست و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.0,
   "end": 311.62,
   "text": "هزار و یک کلمه حضرت علامه علیه الرحمه دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.62,
   "end": 316.32,
   "text": "اونم خیلی تاثیرگذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.32,
   "end": 320.86,
   "text": "نکته‌ای که امروز عرض-- هدیه‌ای که امروز عرض می‌کنیم از حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.86,
   "end": 323.52,
   "text": "شوشتری است. ایشون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.52,
   "end": 329.04,
   "text": "خب یه زمانی خدمتشون که اصفهان که درس می‌خوندیم بعضا خدمتشون رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.04,
   "end": 333.5,
   "text": "می‌دونید که حضرت آقای نخودکی علیه الرحمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.5,
   "end": 341.06,
   "text": "ایشون آنچه که داشتند به آقای حافظیان دادند و آقای حافظیان آنچه داشتند به حضرت آقای شوشتری بخشیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.06,
   "end": 347.98,
   "text": "ما محضرشون که بودیم یکی از دوستان در خصوص اراده سخ-صحبت کرد و سؤال پرسید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.98,
   "end": 350.06,
   "text": "آقا ما چه کنیم اراده‌مون قوی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 350.06,
   "end": 355.44,
   "text": "اراده‌مون ضعیفه. نمی‌تونیم وقتی تصمیم رو می‌گیریم زود منصرف می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.44,
   "end": 360.12,
   "text": "ایشون یک دستورالعملی دادند که این دستورالعمل خیلی قشنگه، خیلی زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.12,
   "end": 364.56,
   "text": "البته بسیاری از بزرگان من جمله حضرت علامه حسن زاده علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.56,
   "end": 367.36,
   "text": "برای اعتدال مزاج خصوصا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.36,
   "end": 369.24,
   "text": "توصیه به ختم قرآن می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.24,
   "end": 371.44,
   "text": "ختم قرآن نه اینکه حالا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.44,
   "end": 380.86,
   "text": "سوره ای رو فقط بخونی مداومت بر یک سوره نه کل قرآن رو بخونی کل قرآن کل مزاجت رو به سمت اعتدال میبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.86,
   "end": 383.52,
   "text": "حالا این دستورالعمل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.52,
   "end": 386.92,
   "text": "ایشون دادن مرحوم حضرت آقا شوشتری برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.92,
   "end": 390.7,
   "text": "تقویت اراده. خب اراده چی میشه که قوی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 390.7,
   "end": 395.86,
   "text": "بحثش گذشت دیگه. وقتی مزاج معتدل شد اراده قوی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.86,
   "end": 398.04,
   "text": "توجه کردید مزاج که به سمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.04,
   "end": 400.78,
   "text": "به سمت اعتدال رفت انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.78,
   "end": 404.96,
   "text": "س-سریع میتونه یک تصمیم رو بگیره و بر اون مداومت به خرج بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.96,
   "end": 408.62,
   "text": "خب دستور این چنین است که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.62,
   "end": 410.98,
   "text": "ده و-- چهارده ماه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 410.98,
   "end": 418.4,
   "text": "چهارده ماه پشت سر هم چهارده ختم قرآن میکنید به نیت چهارده معصوم علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.4,
   "end": 420.94,
   "text": "خیلی در تقویت اراده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.94,
   "end": 425.16,
   "text": "همچنین اعتدال مزاج مؤثر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 425.16,
   "end": 429.04,
   "text": "چگونه؟ ماه اول به نیت پیغمبر عزیز عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 429.04,
   "end": 430.98,
   "text": "ماه دوم به پی-- به نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 430.98,
   "end": 433.46,
   "text": "مولامون علی علیه الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.46,
   "end": 439.58,
   "text": "ماه سوم به نیت حضرت زهرا سلام الله علیها همینطور تا امام عصر میشه چهارده ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.58,
   "end": 442.62,
   "text": "اما هر روز یک جزء میخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.62,
   "end": 447.2,
   "text": "حالا هر ساعتی که بهتر به، بهتر به البته بین الطولین دیگه نور on النوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.2,
   "end": 450.66,
   "text": "هر ساعتی راحت تری یک جزء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.66,
   "end": 456.8,
   "text": "اون ماه هایی که بیست و نه روزه تموم میشه، روز بیست و نهم قطعاً باید دو جزء بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.8,
   "end": 459.08,
   "text": "جزء بیست و نه و سی رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.08,
   "end": 463.32,
   "text": "ماه هایی که سی و یک روز تموم میشه، روز سی و یکم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.32,
   "end": 466.54,
   "text": "شما دو مرتبه جزء سی رو تکرار میکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.54,
   "end": 468.72,
   "text": "ماه های سی روزه هم که مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.72,
   "end": 473.54,
   "text": "اگر احیانا خدای نکرده حالا یک روز به هر دلیلی ترک شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 473.54,
   "end": 477.22,
   "text": "نشد که شما ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.22,
   "end": 479.94,
   "text": "ختمت رو انجام بدی فردا قضاشو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 479.94,
   "end": 483.52,
   "text": "رها نکن. رها کنی بدتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 483.52,
   "end": 488.22,
   "text": "هم ارادت ضعیف میشه هم مزاجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 488.22,
   "end": 491.32,
   "text": "از اعتدال به سمت خروج حرکت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.32,
   "end": 497.36,
   "text": "اینا خیلی مهمن ها. اینکه انسان یک دستوری رو دست بگیره که خارج از ظرف و حد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.36,
   "end": 503.92,
   "text": "حد صعه وجودی شه بعد هی زمین بخوره، اینا خیلی هم در اراده انسان تاثیر بد میذاره هم در مزاج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 503.92,
   "end": 509.78,
   "text": "اینا به هر حال سراییه که اسراریه که بزرگان میگن و متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 509.78,
   "end": 516.46,
   "text": "ماها توجه نداریم. پس این حالا چه بهتر که این چهارده ماه رو انسان انجام میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 516.46,
   "end": 524.34,
   "text": "تو یک ساعت و یک محل یعنی یک مکان و زمان خاص و ثابت رو در نظر بگیره که خیلی نور على نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.34,
   "end": 527.66,
   "text": "اگرم نشد که خب مانعی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 527.66,
   "end": 530.3,
   "text": "اینم یک دستور بر اینکه چه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 530.3,
   "end": 534.74,
   "text": "یک هدیه بر اینکه چه کنیم بر اثر مداومت بر این کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 534.74,
   "end": 536.94,
   "text": "اعتدال مزاج رخ بدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 536.94,
   "end": 541.72,
   "text": "امیدوارم که خدای منان همین قلیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.72,
   "end": 551.88,
   "text": "مطالبی رو که در ذیل آیات و روایات و فرمایشات بزرگان عرض می‌کنیم از ما بپذیرد و به جایی برسید شما و ما هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 551.88,
   "end": 556.92,
   "text": "یه جالبه که یکی دیگه از جاهایی که مزاج اومده در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 556.92,
   "end": 563.1,
   "text": "می فرماید مزاجها من تسنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 563.1,
   "end": 565.24,
   "text": "که مرحوم-- عرض کردیم مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 565.24,
   "end": 569.78,
   "text": "فارابی در عیون مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 569.78,
   "end": 577.52,
   "text": "فارابیین اومده. مرحوم فارابیین آورده و حضرت علامه حسن زاده هم در کتاب شریف عیون مسائل نفسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 577.52,
   "end": 580.46,
   "text": "براتون یادم از رو خوندم صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 580.46,
   "end": 585.86,
   "text": "دویست و هشتاد و پنج بود گویا اونجا براتون خوندم اینو آورده که می فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 585.86,
   "end": 589.88,
   "text": "و من تلک العیون التي مزاجها من تسنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 589.88,
   "end": 593.32,
   "text": "ببینید مزاجها من تسنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 593.32,
   "end": 600.18,
   "text": "عین يشرب بها المقربون ان المزاج کلما کان اعدل کان مزاجه افضل و اکمل و اشرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 600.18,
   "end": 603.76,
   "text": "تو بحث مزاج افضل و اکمل و اشرف و اتم و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 603.76,
   "end": 605.46,
   "text": "اونجا صحبت کردیم درباره‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 605.46,
   "end": 612.18,
   "text": "امیدوارم یعنی یاد این افتادیم چون داشتم دعا می‌کردم که امیدوارم شما و ما هممون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 612.18,
   "end": 617.8,
   "text": "به چشیدن از این چشمه‌ها که مخصوص مقربین است برسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 617.8,
   "end": 620.04,
   "text": "که مزاجش از، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 620.04,
   "end": 623.78,
   "text": "تسنیم است. مزاج اون چشمه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 623.78,
   "end": 626.2,
   "text": "چشمه‌های خاص بهشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 626.2,
   "end": 629.94,
   "text": "درون اعلی مرتبه‌های بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 629.94,
   "end": 632.9,
   "text": "از تسنیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 632.9,
   "end": 637.04,
   "text": "ان شا الله که خدا به ما بچشاند هم در این دنیا هم در اون دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 637.04,
   "end": 640.24,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 640.24,
   "end": 645.04,
   "text": "اه نسال آقامون علی ابن موسی الرضا با معرفت و حضور قلب صلوات فرست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}