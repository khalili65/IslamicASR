 },
 "chapters": [
  {
   "index": 0,
   "title": "## همت؛ شرط رسیدن به اسم یقین",
   "start": 10.96,
   "end": 37.62
  },
  {
   "index": 1,
   "title": "## حروف عالیات و اهل‌بیت",
   "start": 37.62,
   "end": 361.82
  },
  {
   "index": 2,
   "title": "## حیات مزاجی و حیات ذاتی",
   "start": 361.82,
   "end": 538.76
  },
  {
   "index": 3,
   "title": "## مزاج غیر از نفس؛ تفاوت مشاهدات",
   "start": 538.76,
   "end": 738.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 3.5,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.5,
   "end": 6.72,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.72,
   "end": 8.9,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.9,
   "end": 10.96,
   "text": "سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 10.96,
   "end": 14.94,
   "text": "جلسه گذشته عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 14.94,
   "end": 18.78,
   "text": "ما باید اهل همت باشیم، باید تلاش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 18.78,
   "end": 26.76,
   "text": "همین طور صرف اینکه دست رو دست هم بگذاریم و فقط گوش بدیم و به به و چه چه و لذت ببریم به جایی نمی‌رسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.76,
   "end": 29.2,
   "text": "و تا دیر نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.2,
   "end": 34.22,
   "text": "باید شروع کنیم که ان‌شاءالله اصحاب همت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.22,
   "end": 36.84,
   "text": "آستین بالا بزنن به قول قدیمی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.84,
   "end": 41.2,
   "text": "و چاره‌ای جز رسیدن به اسم یقین حضرت حق نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.2,
   "end": 44.34,
   "text": "باید تلاش کنیم. باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.34,
   "end": 46.34,
   "text": "در این مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.34,
   "end": 49.26,
   "text": "با کسب معرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.26,
   "end": 56.74,
   "text": "با کسب معرفت و عمل کردن به اونچه که اخذ کردیم هی صعه وجودیمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.74,
   "end": 62.5,
   "text": "از ضیغ به صعه بدل کنیم و ظرف وجودیمون رو بزرگ کنیم بلکه ان‌شاءالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.5,
   "end": 65.12,
   "text": "بیشتر بهره بگیریم از وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.12,
   "end": 69.48,
   "text": "خدا رحمت کنه مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.48,
   "end": 73.98,
   "text": "افعمی علیه الرحمه رو در کتاب شریف مصباحشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.98,
   "end": 77.92,
   "text": "وقتی شرح اسماء الهی رو میخوان بیان کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.92,
   "end": 83.18,
   "text": "یکی از اسماء الهی رو که بلکه ایشون میگن اسم اعظم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.18,
   "end": 87.5,
   "text": "یقین است. یعنی خدا رو به یا یقین صدا می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.5,
   "end": 95.9,
   "text": "که در قرآن هم داریم \"واعبد ربک حتى یأتیک الیقین\" عبادت کن پروردگار تو تا به یقین برسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.9,
   "end": 99.54,
   "text": "و هیچ چاره‌ای جز این نیست و این با همت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.54,
   "end": 105.76,
   "text": "اتفاق میفته عزیزان. باید هم اهل همت بود، اهل تلاش بود که جلسه پیش هم عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.76,
   "end": 111.04,
   "text": "صرف اینکه این حقایق فوق طور عقلن و ما در عقلمون موندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.04,
   "end": 116.6,
   "text": "و قلبمون رو رها کنیم بعد اون موقع قلب که جایگاه و منزلگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.6,
   "end": 120.7,
   "text": "و فرودگاه الهامات و القاءات الهی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.7,
   "end": 126.1,
   "text": "اون موقع وقتی بی بهره شد از رزق خودش، قلب خدای نکرده دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.1,
   "end": 135.24,
   "text": "اون مشکلاتی می‌‌شود که دیگه برون رفت از اون مشکلات کار دشوار و سختی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.24,
   "end": 137.42,
   "text": "لذا باید از همین ابتدا شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.42,
   "end": 139.7,
   "text": "باید حرکت کرد. قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.7,
   "end": 143.6,
   "text": "کدش رو داده. اصل رو بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.6,
   "end": 149.02,
   "text": "چی؟ \"واعبد ربک\". پروردگار اون-- حالا خیلی رو این آیه میشه هفتصد الان جاش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.02,
   "end": 151.98,
   "text": "فرصت گرفته می‌شه. از بحث خارج می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.98,
   "end": 156.4,
   "text": "\"واعبد\". این عبادت رو قبلاً عرض کردیم که به معرفته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.4,
   "end": 158.8,
   "text": "اصل عبودیت به معرفت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.8,
   "end": 164.16,
   "text": "و معرفت هم که در اون دعای امیرالمؤمنین صلی الله علیه در اون مناجات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.16,
   "end": 166.9,
   "text": "خاص امام کامل حضرت ولی عسلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.9,
   "end": 171.76,
   "text": "عليه الصلاة والسلام ایشون هم اشاره کرده بودند که جایگاه معرفت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.76,
   "end": 178.16,
   "text": "که اللهم نور ظاهری بطاعتك وباطنی بمحبتك وقلبي بمعرفتك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.16,
   "end": 183.98,
   "text": "قلبي بمعرفتك. و البته و روحي بمشاهدتك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.98,
   "end": 189.54,
   "text": "وسري باستقلال اتصال حضرتك يا ذو الجلال والاكرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.54,
   "end": 192.88,
   "text": "جالبه که انتهاش با ذو الجلال والاكرام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.88,
   "end": 195.42,
   "text": "یعنی هم اسماء جلالیه است هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.42,
   "end": 202.9,
   "text": "جمالیه و ما چاره‌ای جز غور کردن در اسماء حضرت حق نداریم که هرچی می‌بینی اسماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.9,
   "end": 206.7,
   "text": "یا اسماء در ذات یا اسماء بیرون از ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.7,
   "end": 215.7,
   "text": "که شما هر کدومتون یکی از اون اعیانید و یکی از اون اسماءید و یکی از اشیاید که \"وعلم آدم الأسماء كلها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.7,
   "end": 219.92,
   "text": "چاره‌ای جز از چشیدن این حروفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 219.92,
   "end": 223.76,
   "text": "و حروف عالیات نظام هستی نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.76,
   "end": 229.1,
   "text": "که این حروف از مادون گرفته تا مافوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 229.1,
   "end": 232.62,
   "text": "برای تغذیه وجود ما؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.62,
   "end": 238.28,
   "text": "یعنی ما اونچه که غذا اخذ می‌کنیم از بیرون، از خارج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 238.28,
   "end": 242.38,
   "text": "توسط همین حروفه. همین حروف عالیات که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 242.38,
   "end": 245.92,
   "text": "از مادون بگیر تا مافوق و یکی از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.92,
   "end": 250.28,
   "text": "حروف و کلمات نظام هستی خود حضرت عالی هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 250.28,
   "end": 254.1,
   "text": "که اتفاقاً حدیث هم داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.1,
   "end": 257.16,
   "text": "\"کنا حروفاً عالیاتٍ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 257.16,
   "end": 260.94,
   "text": "لم تقل\". ما اون حروف عالیات هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.94,
   "end": 265.16,
   "text": "عالی‌ترین حروف نظام هستی ما اهل بیت علیهم الصلاة والسلام هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.16,
   "end": 267.26,
   "text": "اما نه اون کلماتی که بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.26,
   "end": 270.08,
   "text": "لم تقل، نه اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.08,
   "end": 273.02,
   "text": "شما قرائت می‌کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.02,
   "end": 276.68,
   "text": "و می‌گویید. ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.68,
   "end": 279.36,
   "text": "مافوق حتی تصور شما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.36,
   "end": 283.68,
   "text": "اما ن-- شما نسبت به صعه وجودی خودتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 283.68,
   "end": 287.34,
   "text": "باید از این کلمات عالیات بچشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.34,
   "end": 292.0,
   "text": "خب چه کنیم که ما متأسفانه خودمون رو دست کم می‌گیریم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 292.0,
   "end": 295.32,
   "text": "در چشیدن این حقایق هستی دچار مشکل می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 295.32,
   "end": 297.72,
   "text": "دفعه پیش عرض کردیم جلسه پیش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.72,
   "end": 300.1,
   "text": "یکی از مشکلات اصلی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 300.1,
   "end": 304.46,
   "text": "برمی‌گرده به عدم کارکرد صحیح قلب ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 304.46,
   "end": 310.06,
   "text": "البته باید توجه داشته باشیم که این حروف و این کلمات نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.06,
   "end": 312.92,
   "text": "که باز هم عرض می‌کنم یکیش ما هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.92,
   "end": 315.78,
   "text": "نسبت به اینکه کدوم یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.78,
   "end": 323.14,
   "text": "اسماء حضرت حق غلبه پیدا کردن در اون، در اون کلمه و در هو-- اون حروف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.14,
   "end": 327.62,
   "text": "صعه و ضیغ پیدا می‌کنند که حالا اون مزاج حاصل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 327.62,
   "end": 331.28,
   "text": "حیاتی دارد. اون ذات حاصل شده حیاتی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.28,
   "end": 334.86,
   "text": "هر کدوم از اینا حذ-- حیات منحصر به خودش دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.86,
   "end": 337.48,
   "text": "خب حالا برای اینکه این حیات رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.48,
   "end": 340.5,
   "text": "این کلمات وجودی نظام هستی رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.5,
   "end": 348.22,
   "text": "این حروف رو اعم از مادون تا مافوق تا حروف عالیات رو خوب بشناسیم چاره‌ای نداریم جز اینکه حیات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 348.22,
   "end": 351.38,
   "text": "و چگونگی درج حیات در اونها رو بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 351.38,
   "end": 356.42,
   "text": "چگونگی درج حیات و اخذ حیات رو از رتبه‌های وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 356.42,
   "end": 359.54,
   "text": "خصوصاً در مقام قلبمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 359.54,
   "end": 363.0,
   "text": "بشناسیم که حالا اینجا دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 363.0,
   "end": 367.48,
   "text": "دو شق-- حیات پیش میاد که بحث ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.48,
   "end": 371.1,
   "text": "اینجا یه مقدار بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 371.1,
   "end": 374.02,
   "text": "داغی خواهد شد ان شاءالله به فضل الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 374.02,
   "end": 378.4,
   "text": "چون وقتی بحث \"ام من شيءٍ\" میاد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 378.4,
   "end": 382.66,
   "text": "منظور همون آب حیات است که \"من الماء كل شيءٍ حي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 382.66,
   "end": 385.42,
   "text": "اما اینکه چگونه این آب حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.42,
   "end": 389.8,
   "text": "منتقل شده، درک شده در کلمات وجودی نظام هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.8,
   "end": 396.08,
   "text": "این بحث بسیار داغ و مهمه که شیخ در فتوحاتشون می فرمایند که این ثمه‌هایی که خدا می فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.08,
   "end": 399.48,
   "text": "\"ثُمَّ مِنْ نُطْفَةٍ عَلَقَةً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.48,
   "end": 401.96,
   "text": "بعد دوباره \"ثُمَّ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 401.96,
   "end": 405.84,
   "text": "مُضْغَةً ثُمَّ عِظَامًا ثُمَّ لَحْمًا\" همین طوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 405.84,
   "end": 411.4,
   "text": "این ثمه ثمه‌ها که استق-- دلالت بر استدراج دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.4,
   "end": 413.12,
   "text": "اینها همون حیات مزاجی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.12,
   "end": 417.6,
   "text": "بعد اینجا بحث پیش میاد که اصلاً این حیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.6,
   "end": 421.28,
   "text": "حیات ذاتی آیا همان حیات مزاجی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 421.28,
   "end": 423.46,
   "text": "یا حیات مزاجی همان حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.46,
   "end": 426.3,
   "text": "ذاتی است یا دو گونه حیات است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.3,
   "end": 433.04,
   "text": "حالا اینجا بحث است بین حکما و عرفا بحث است که مرحوم آخوند در اسفارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 433.04,
   "end": 437.94,
   "text": "اعتراض به شیخ داره در فتوحات که چون شیخ در فتوحاتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 437.94,
   "end": 441.42,
   "text": "می فرماین اونجا بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 441.42,
   "end": 444.3,
   "text": "حیات مزاجی رو که مطرح می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.3,
   "end": 446.48,
   "text": "اونجا میگن که حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 446.48,
   "end": 450.62,
   "text": "دو گونه است حیات مزاجی و حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 450.62,
   "end": 457.98,
   "text": "ذاتی. در حیات مزا-- حیات مزاجی می فرمایند که ترکیب عناصر و مزاج و فعل و انفعالاتشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 457.98,
   "end": 462.94,
   "text": "و البته این موضوع در تجرید و کتب فلسفی و نمت سوم اشارات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 462.94,
   "end": 465.72,
   "text": "مرحوم شیخ رئیس هم آمده. اما اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 465.72,
   "end": 471.46,
   "text": "کسی که مقدمه بر اینها بیان کرده موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 471.46,
   "end": 477.44,
   "text": "رو حضرت ابن عربی علیه الرحمه هستش که بعد اونجا حیات ذاتی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 477.44,
   "end": 484.38,
   "text": "می فرماین که کاری به مزاج نداره و برای همه هست و همون حس وجودی است که قبلاً توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 484.38,
   "end": 488.66,
   "text": "ولو اینکه حیات البته بعد توضیح میدن که ولو اینکه حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 488.66,
   "end": 492.9,
   "text": "در مزاج خودش رو بیشتر نشون میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 492.9,
   "end": 498.98,
   "text": "یعنی در مزاج حیات خودش رو بهتر و بیشتر نشون میده یعنی ظهورش در مزاج بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 498.98,
   "end": 501.72,
   "text": "اما حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 501.72,
   "end": 506.8,
   "text": "ذاتی می‌شود ذات حیات مزاجی است به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 506.8,
   "end": 511.92,
   "text": "حالا هرچه مزاج معتدل‌تر است، اسما و صفات خودشون رو بهتر درون نشون میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 511.92,
   "end": 516.94,
   "text": "و ما قراره با همین حیات مزاجمون بچشیم حقایق نظام هستی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 516.94,
   "end": 520.4,
   "text": "که اگر این مزاج معتدل نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 520.4,
   "end": 528.26,
   "text": "واقع است که درک و چشیدن و رسیدن به این حروف و کلمات نظام هستی دشوار میشه، سخت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 528.26,
   "end": 532.56,
   "text": "جایگاه قلب خیلی مهمه. عزیزان توجه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 532.56,
   "end": 536.1,
   "text": "و حالا بحث مزاج که اینجا پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 536.1,
   "end": 538.2,
   "text": "باید توجه داشت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 538.2,
   "end": 540.5,
   "text": "اصولاً مزاج غیر از نفس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 540.5,
   "end": 543.24,
   "text": "عزیزان توجه بفرمایید که مزاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 543.24,
   "end": 545.26,
   "text": "این مزاجی که ما هی داریم ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 545.26,
   "end": 547.22,
   "text": "حرف می‌زنیم غیر از نفس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 547.22,
   "end": 550.84,
   "text": "که حالا انشاالله به تعریف مزاج اشاره خواهیم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 550.84,
   "end": 555.28,
   "text": "همونطور که انسان رو یه ظاهری است و یک باطنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 555.28,
   "end": 560.9,
   "text": "همینطور یک صورتی دارد و انسان یک سیرتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 560.9,
   "end": 568.74,
   "text": "و باز ظاهر و صورت انسان‌ها اگه همونطور که دقت می‌کنید خیلی متفاوتند از هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 568.74,
   "end": 572.28,
   "text": "همچنین سیرت و باطن و مزاج‌هاشون هم متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 572.28,
   "end": 576.38,
   "text": "بر همین اساس اون مشاهدات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 576.38,
   "end": 579.58,
   "text": "واردات انسان‌ها متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 579.58,
   "end": 586.46,
   "text": "یعنی انسانی که در شهود حقایق نشسته متفاوت مشاهده می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.46,
   "end": 591.28,
   "text": "و اینطور نیستش که همه به یک گونه ببینند، مشاهده کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 591.28,
   "end": 596.32,
   "text": "همه حقایق عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 596.32,
   "end": 604.22,
   "text": "در وجود هر شخصی نسبت به اون سیرت و باطن و مزاجی که دارد متفاوت خودش رو نشون میدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 604.22,
   "end": 608.9,
   "text": "البته نه اینکه یکی حق باشه یکی باطل، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 608.9,
   "end": 614.2,
   "text": "در طول هم‌اند. مثل اینکه یکی نور رو با شدت بیشتری می‌بینه، یکی با شدت کمتری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 614.2,
   "end": 618.18,
   "text": "ولی همه نور رو می‌بینند. اما خب واردات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 618.18,
   "end": 623.88,
   "text": "کاملاً متناسب با نوع مزاج و باطن‌ها متغیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 623.88,
   "end": 626.68,
   "text": "شهود حقایق مبتنی بر مزاج است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 626.68,
   "end": 634.22,
   "text": "یعنی هرچی مزاج معتدل‌تر باشه، سالم‌تر باشه، مشاهدات انسان شفاف‌تر و زلال‌تر خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 634.22,
   "end": 639.26,
   "text": "و در این میان جایگاه قلب اهمیت بسیار ویژه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 639.26,
   "end": 642.18,
   "text": "خاصی دارد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 642.18,
   "end": 648.38,
   "text": "انشاالله بحثش خواهد گذشت و می‌شود گفت که اون مقام سان و مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 648.38,
   "end": 654.74,
   "text": "حضور، حضور ملکا است در قلب اتفاق می‌افتد که هرچه قلب قوی‌تر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 654.74,
   "end": 656.82,
   "text": "نشان از مزاج قوی‌تر دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 656.82,
   "end": 662.06,
   "text": "مزاج معتدل دارد. وقتی مزاج معتدل بود فرمانروا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 662.06,
   "end": 664.1,
   "text": "یا اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 664.1,
   "end": 672.16,
   "text": "می‌شود گفت امیر وجود انسان است، امیر قوای وجود انسان است، امیر محال قوای وجود انسان است، اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 672.16,
   "end": 676.26,
   "text": "در تدبیر و مدیریتش قوی‌تر و بهتر عمل می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 676.26,
   "end": 682.44,
   "text": "حالا اینها ارتباطاتشون توأمان است و همه در هم تأثیرگذارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 682.44,
   "end": 685.96,
   "text": "که انشاالله به مرور عرض خواهیم کرد به چه نحوی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 685.96,
   "end": 689.2,
   "text": "من خواهش می‌کنم که بحث مزاج رو جدی بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 689.2,
   "end": 691.4,
   "text": "اگرچه عرض شد در اسفار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 691.4,
   "end": 693.74,
   "text": "همانطور که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 693.74,
   "end": 696.38,
   "text": "ملا صدرا اشکال کرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 696.38,
   "end": 702.24,
   "text": "حضرت محی الدین در فتوحات که چطور ایشان حیات را دوگونه کرده که حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 702.24,
   "end": 707.18,
   "text": "مزاجی و حیات ذاتی. اما حضرت علامه حسن زاده علیه الرحمه با انبساط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 707.18,
   "end": 711.08,
   "text": "خاطر و طيب خاطر می فرمایند که نخیر، این اشکال وارد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 711.08,
   "end": 713.98,
   "text": "این اشکال حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 713.98,
   "end": 716.96,
   "text": "آخوند در اسفار وارد نیست بر حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 716.96,
   "end": 722.96,
   "text": "محی الدین علیه الرحمه و بحث می‌کنند بهش و انشاالله ما هم اجمالاً نسبت به ضیق وقتمون البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 722.96,
   "end": 726.78,
   "text": "نه تفصیلًا اجمالاً نکاتی رو در آینده عرض خواهیم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 726.78,
   "end": 732.3,
   "text": "انشاالله که عاقبت ما ختم به خیر باشد به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 732.3,
   "end": 738.04,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}