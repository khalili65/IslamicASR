 "chapters": [
  {
   "index": 0,
   "title": "## استفتا؛ نماز فرادا در کنار جماعت",
   "start": 2.58,
   "end": 94.6
  },
  {
   "index": 1,
   "title": "## اساس آمدن و بازگشت؛ از وحدت به کثرت",
   "start": 94.6,
   "end": 215.18
  },
  {
   "index": 2,
   "title": "## وجود یک حقیقت؛ صمد لا جوف له",
   "start": 215.18,
   "end": 358.4
  },
  {
   "index": 3,
   "title": "## کن مع الناس؛ جماعت و طواف و کل فی فلک",
   "start": 358.4,
   "end": 491.48
  },
  {
   "index": 4,
   "title": "## عذاب برزخی و قلب منزلِ اتصال",
   "start": 491.48,
   "end": 546.64
  },
  {
   "index": 5,
   "title": "## ما جعل الله لرجل من قلبین فی جوفه",
   "start": 546.64,
   "end": 681.94
  },
  {
   "index": 6,
   "title": "## نماز از أحد تا وحده؛ وحدت در عبادت",
   "start": 681.94,
   "end": 812.82
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.58,
   "end": 7.26,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.26,
   "end": 10.74,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.74,
   "end": 14.26,
   "text": "استفتاء شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.26,
   "end": 22.26,
   "text": "گاهی دیده می‌شه هنگام اقامه نماز جماعت بعضیا یه گوشه‌ای از اون محل اقامه، حالا مسجد، نمازخونه هر جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.26,
   "end": 27.0,
   "text": "به صورت انفرادی نمازشون رو فرادا می‌خونن در حین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.0,
   "end": 29.3,
   "text": "برپایی نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.3,
   "end": 32.1,
   "text": "آیا اشکال داره یا نه؟ همه جا هم دیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.1,
   "end": 36.08,
   "text": "حالا یا امام جماعت رو قبول دارن یا اون جماعت رو قبول دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.08,
   "end": 41.38,
   "text": "ندارن یا نه اصلاً عجله دارن میخوان سریع بخونن برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.38,
   "end": 47.72,
   "text": "رهبر عزیزمون دو تا شرط گذاشتن که اگر این دو شرط باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.72,
   "end": 50.88,
   "text": "و اگه، اگر لحاظ بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.88,
   "end": 54.66,
   "text": "شما می‌تونین این کارو انجام بدید و الا جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.66,
   "end": 57.98,
   "text": "اول اینکه اهانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.98,
   "end": 60.32,
   "text": "به امام جماعتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.32,
   "end": 63.42,
   "text": "اون مردم او رو به عدالت قبول کردن نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.42,
   "end": 65.84,
   "text": "یعنی اهانت محسوب نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.84,
   "end": 73.86,
   "text": "یعنی کسی نگاه کرد نگه که واسه حالا مثلاً آره دارن اهانت می‌کنن، منظورشون کوبیدن این امام جماعته مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.86,
   "end": 78.44,
   "text": "این نباشه. نکته دوم تضعیف جماعت نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.44,
   "end": 81.76,
   "text": "یعنی اون کسی که داره اونجا می‌خونه حالا یه گوشه‌ای داره تنهایی می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.76,
   "end": 84.72,
   "text": "یه وقت می‌بینی چند نفر با هم جمع می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.72,
   "end": 88.08,
   "text": "اون گوشه اینا تضعیف جماعت باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.08,
   "end": 91.74,
   "text": "نمی‌شه. جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.74,
   "end": 94.6,
   "text": "اما اگر این‌ها نبود مانعی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.6,
   "end": 98.24,
   "text": "اجازه بفرمایید که ورود کنیم به ادامه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.24,
   "end": 102.12,
   "text": "قلب منزل .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.12,
   "end": 104.8,
   "text": "نکته‌ای که امروز عرض می‌کنیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.8,
   "end": 110.4,
   "text": "اگر هم همین عبارت اولیه بحث ما رو شنیدید روش فکر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.4,
   "end": 116.38,
   "text": "مهمه چون اصلاً اساس اومدن و رفت و برگشت ما به این دنیا همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.38,
   "end": 121.64,
   "text": "چیزی هم غیر از این نیست. ما این جمله رو ما از وحدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.64,
   "end": 127.32,
   "text": "به کثرت اومدیم. اگرچه کثرت این عالم عین وحدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.32,
   "end": 131.08,
   "text": "به قول حضرت علامه علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.08,
   "end": 135.34,
   "text": "تأکید می‌کنه کثرت این عالم وحدت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.34,
   "end": 139.6,
   "text": "چون وجودش رو از اون وجود اصمد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.6,
   "end": 143.94,
   "text": "هر، هر حال حالا این بحثای فلسفی نکنیم بعضیا حوصله‌شون سر بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.94,
   "end": 147.36,
   "text": "بخوایم عرض کنیم که از وحدت آمدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.36,
   "end": 150.1,
   "text": "به کثرت. اینجا نشئه کثرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.1,
   "end": 152.42,
   "text": "قراره چی بشه؟ چه اتفاقی قرار بیفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.42,
   "end": 154.98,
   "text": "ما همینطور در کثرت خواهیم ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.98,
   "end": 157.98,
   "text": "انا لله. اون الله هم جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.98,
   "end": 164.48,
   "text": "اسم جمع است. اسم جمع است یعنی همه اسما در اون متمرکز است به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.48,
   "end": 168.44,
   "text": "معنای جمعی دارد دیگه تجمع، جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.44,
   "end": 171.64,
   "text": "معنای جمعی داره. یعنی مقامش مقام جمعی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.64,
   "end": 174.06,
   "text": "مثل اینکه قرآن مقامش مقام جمعی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.06,
   "end": 179.5,
   "text": "مثل اینکه عالم مجردات مقام جمع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.5,
   "end": 181.08,
   "text": "مقام لفظ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.08,
   "end": 183.24,
   "text": "قضا است. متن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.24,
   "end": 187.82,
   "text": "بقیه قدر او هستند، شرح او هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.82,
   "end": 190.5,
   "text": "سایه او هستند. همین کثرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.5,
   "end": 193.2,
   "text": "حالا قراره که ما اینجا بمونیم یا بالاخره بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.2,
   "end": 197.78,
   "text": "انا لله آمدیم. خب قطعاً همه می‌گید و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.78,
   "end": 200.62,
   "text": "الیه بر می‌گرده این ضمیر الیه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.62,
   "end": 203.18,
   "text": "کی؟ به اون الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.18,
   "end": 206.46,
   "text": "و انا الیه. یعنی می‌ریم دوباره به جمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.46,
   "end": 209.24,
   "text": "یعنی چی؟ یعنی می‌ریم به وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.24,
   "end": 212.8,
   "text": "پس اومدن ما از وحدت بوده به کثرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 212.8,
   "end": 215.18,
   "text": "حالا ظاهراً کثرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 215.18,
   "end": 220.24,
   "text": "چرا؟ چون عرض کردیم اینو خوب دیگه باید با آمیزه‌هایی که عرض کردیم این مدت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.24,
   "end": 224.22,
   "text": "آثار حضرت علامه قربونشون بریم دیگه باید متوجه باشید یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 224.22,
   "end": 228.58,
   "text": "چون وجود، اصل وجود یک وجود بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 228.58,
   "end": 231.4,
   "text": "وجود اصمد است که بقیه همه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 231.4,
   "end": 236.0,
   "text": "همه موجودات نسبت به برخورداری‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.0,
   "end": 240.34,
   "text": "از اون وجود موجود شدند و رتبه گرفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.34,
   "end": 243.18,
   "text": "و محل ظهور او،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.18,
   "end": 249.72,
   "text": "آن وجود شدند. حالا از حیث وجودشون یک حقیقت‌اند چون وجود یک حقیقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 249.72,
   "end": 254.66,
   "text": "وجود اصمد حضرت حق که همه جا رو پر کرده هیچ کجا از او خالی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.66,
   "end": 261.82,
   "text": "اون ق-- مثالی که بعضیا زدن نفهمیدن توحید رو هنوزم هستن، نمازم می‌خونن، قرآن هم اینا، مشرکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.82,
   "end": 264.96,
   "text": "خدا رو بنایی فرض می‌کنند که بنایی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.96,
   "end": 267.88,
   "text": "اهداف کرده. بنا جدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.88,
   "end": 272.52,
   "text": "بنا جدا. اصلاً این توحید نمی‌شه که این اصمد نمی‌شه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 272.52,
   "end": 274.9,
   "text": "اصمد الذی لا جوف له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.9,
   "end": 276.52,
   "text": "هیچ کجا از او خالی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 276.52,
   "end": 278.94,
   "text": "همه جا رو پر کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 278.94,
   "end": 284.06,
   "text": "نمی‌شه بگی استقلالا ذا که ها ذا ذال که این، آن، آن، این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 284.06,
   "end": 286.96,
   "text": "آسمان، زمین، حیوان، انسان، جماد، نبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 286.96,
   "end": 289.66,
   "text": "حالا یه خدا هم بله یه و یه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 289.66,
   "end": 294.9,
   "text": "نمی‌شه. اصمد همه اصلاً وجود یعنی همین و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 294.9,
   "end": 300.14,
   "text": "که اصلاً کثرات می‌شه ظهور او، مجالی اوئند، آیات اوئند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.14,
   "end": 303.64,
   "text": "تجلیات اوئند، مظاهر اوئند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.64,
   "end": 307.4,
   "text": "درست شد؟ پس اینم باز بوی وحدت می‌ده کثرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.4,
   "end": 310.38,
   "text": "از حیث وجود عین وحدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.38,
   "end": 313.28,
   "text": "پس از چه حیثی شده کثرت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.28,
   "end": 315.96,
   "text": "که یکیش منم، یکیش شما حضرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.96,
   "end": 318.84,
   "text": "حالا مشخص بخوای بگی یا فرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 318.84,
   "end": 321.64,
   "text": "می‌گیم از حیث حدود کثرات پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.64,
   "end": 325.84,
   "text": "اون وجود حد گرفته، یه حدش شده این، یه حدش شده این، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 325.84,
   "end": 335.52,
   "text": "حد وجود شده این، یه حدش شده انسان، یه حدش شده حیوان، یه حد ح-- از حیث حدود و الا از حیث وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.52,
   "end": 338.8,
   "text": "به ماهیت وجود یعنی به آنچه که هو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 338.8,
   "end": 342.86,
   "text": "هو و وجود است یک حقیقت است و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 342.86,
   "end": 345.52,
   "text": "چیزی هم نمی‌شه ازش جدا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.52,
   "end": 347.66,
   "text": "حالا پس این یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.66,
   "end": 353.18,
   "text": "بالاخره اومدیم حد گرفتیم، اومدیم وارد عالم کثرت شدیم، حد گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 353.18,
   "end": 355.48,
   "text": "درست شد؟ قراره به چی برگردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 355.48,
   "end": 358.4,
   "text": "به وحدت. این نکته‌ست، به وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.4,
   "end": 365.84,
   "text": "برای همین است که میگه تا می‌تونی \"کن مع الناس ولا تكن معهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 365.84,
   "end": 369.36,
   "text": "با مردم باش، توی مردم باش اما با اون‌ها نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.36,
   "end": 374.78,
   "text": "یعنی چی؟ یعنی تو کثرت باش اما حواشت، حواست به وحدتت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.78,
   "end": 377.8,
   "text": "تو اهل وحدتی، اهل توحیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.8,
   "end": 381.24,
   "text": "تأکد کنه همون کثراتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.24,
   "end": 383.7,
   "text": "حالا قوای وجودیت به اون وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.7,
   "end": 386.38,
   "text": "چرا میگه حالا اسرار رو بنداره یک یک فاش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 386.38,
   "end": 388.26,
   "text": "چرا میگه نماز جماعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 388.26,
   "end": 393.18,
   "text": "جماعت بخون. خیلی جالبه در عین کثرت، وحدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 393.18,
   "end": 395.58,
   "text": "همه به یک امام اقتدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 395.58,
   "end": 398.64,
   "text": "همه به یک قبله‌اند. به سمت یک قبله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 398.64,
   "end": 400.34,
   "text": "همه به یک هیئت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 400.34,
   "end": 402.48,
   "text": "یک شکل‌اند. همه رکوع‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 402.48,
   "end": 408.26,
   "text": "همه سجودند. \"ورکعوا مع الراكعين وسجدوا مع الساجدين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 408.26,
   "end": 413.76,
   "text": "ببینید این معیت‌ها رو این عین وحد-- داره ترغیب می‌کنه، تشویق می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 413.76,
   "end": 415.82,
   "text": "نگاهت رو باز می‌کنه به سمت وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 415.82,
   "end": 418.0,
   "text": "طواف، حج خانه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 418.0,
   "end": 421.82,
   "text": "ببین همه هفت دور، هفت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 421.82,
   "end": 424.62,
   "text": "این طوافی که دارند، مطاف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 424.62,
   "end": 431.56,
   "text": "این همه به یک شکل، به یک وضع، به یک هیئت، به یک ذکر، دور یک مرکز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.56,
   "end": 434.54,
   "text": "اصلاً \"کل فی فلك یسبحون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 434.54,
   "end": 437.26,
   "text": "همه ه کل، کلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 437.26,
   "end": 439.94,
   "text": "هیچی دیگه فروگذار نیست از حدود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 439.94,
   "end": 442.68,
   "text": "همه و همه \"فی فلک یسبحون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 442.68,
   "end": 447.32,
   "text": "شناورن یا به یک معنا تسبیح گوئن تو فلک، تو مدارشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 447.32,
   "end": 450.34,
   "text": "اصلاً عین وحدته، عین وحدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 450.34,
   "end": 453.24,
   "text": "هر کدوم از می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 453.24,
   "end": 455.84,
   "text": "اوامر الهی رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 455.84,
   "end": 460.72,
   "text": "حالا اوامر می‌بینی هر کدومشو بررسی می‌کنی بوی وحدت می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 460.72,
   "end": 465.08,
   "text": "نواهی چیزهایی‌ست که تو رو از وحدت دور می‌کنه، به کثرت می‌ندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 465.08,
   "end": 467.48,
   "text": "تشتت افکار بهت می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 467.48,
   "end": 472.56,
   "text": "این متخیلات فاسده پدر انسانو اصلاً از توحید آدم رو خارج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 472.56,
   "end": 474.96,
   "text": "صور و اشکال مدهشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 474.96,
   "end": 479.04,
   "text": "به جای ملذّه. مدهشه اونایی که آدم می‌ترسه ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 479.04,
   "end": 482.8,
   "text": "و چیزایی که نفس ناطق ما با ازش بریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 482.8,
   "end": 487.98,
   "text": "چیزی که نهی الهیه. یعنی تو رو می‌بره به تشتت، می‌بره به تفرق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 487.98,
   "end": 489.82,
   "text": "و می‌بره از وحدت دور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 489.82,
   "end": 492.98,
   "text": "حالا حالا بیا تا برگردی. اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 492.98,
   "end": 500.84,
   "text": "سیر استکمالی همه ما در برزخ به میزانی‌ست که از وحدت دور شدیم و گرفتار کثرات شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 500.84,
   "end": 503.48,
   "text": "می‌خوان ما رو برگردونن می‌شه به عذاب برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 503.48,
   "end": 505.9,
   "text": "این یک معنای عذاب برزخیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 505.9,
   "end": 509.78,
   "text": "ما چندین معنا بابت عذاب برزخی تو بحث‌هامون ارائه دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 509.78,
   "end": 514.8,
   "text": "اینم یکیش. اون حسّه وجودی ما از حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 514.8,
   "end": 517.2,
   "text": "اون حسّه وجودی ما حالا کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 517.2,
   "end": 520.62,
   "text": "اون چیزی که نحوه اتصال ما با وحدته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 520.62,
   "end": 523.86,
   "text": "با اون توحیده. چون بحث ما قلب منزل بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 523.86,
   "end": 526.8,
   "text": "به بیراهه که نباید بریم. همه اینا رو زور زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 526.8,
   "end": 530.66,
   "text": "اون محل تمرکز، اون محل اتصال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 530.66,
   "end": 535.82,
   "text": "محلی که من و شما که در دل کثرات هستیم ارتباط می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 535.82,
   "end": 541.52,
   "text": "با وحدت، با توحید و تأکد می‌کنیم اون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 541.52,
   "end": 546.64,
   "text": "قلب ماست. قلب ما که جان وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 546.64,
   "end": 551.82,
   "text": "شاید به همین خاطر باشد که امروز داشتم بررسی می‌کردم خیلی شیرین بود برام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 551.82,
   "end": 557.34,
   "text": "خدا هم کمک می‌کنه ما نیت خیر می‌کنیم خدا هم کمک می‌کنه آیاتو جلوی پا میز-- ما می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 557.34,
   "end": 559.88,
   "text": "آیه چهار سوره احزاب ببینید چگونه شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 559.88,
   "end": 563.26,
   "text": "\"ما جعل الله لرجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 563.26,
   "end": 566.12,
   "text": "من قلبین فی جوفه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 566.12,
   "end": 568.44,
   "text": "دو تا \"من قلبین\" دو تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 568.44,
   "end": 572.66,
   "text": "مثنی‌ست. دو تا قلب رو خدا تو دل یک مرد نگذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 572.66,
   "end": 574.28,
   "text": "یعنی چی؟ یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 574.28,
   "end": 577.68,
   "text": "چطور دو تا چشم داده، دو تا گوش داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.68,
   "end": 582.56,
   "text": "ها؟ چرا اینطور دو تا سوراخ بینی داده، دو تا دست داده، دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 582.56,
   "end": 586.38,
   "text": "حتی دو تا به یک اعتبار می‌شه گفت دو تا مغز داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 586.38,
   "end": 589.96,
   "text": "مغز و مخچه یا مغزچه هم بهش می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 589.96,
   "end": 593.9,
   "text": "چرا این چنینه ولی مثلاً قلب یه دونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 593.9,
   "end": 596.52,
   "text": "اون حقیقت قلب رو دارم می‌گم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 596.52,
   "end": 603.36,
   "text": "خب. حالا از جهت ظاهری هم یه دونه‌ست اما باطنی اون محل اتصال ما با کثرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 603.36,
   "end": 605.38,
   "text": "با وحدت نظام هستیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 605.38,
   "end": 607.7,
   "text": "محل اتصال ماست. یه دونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 607.7,
   "end": 611.78,
   "text": "چرا؟ چون از سمت خدا یه دونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 611.78,
   "end": 614.46,
   "text": "ع-العجیب آیه‌ی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 614.46,
   "end": 616.88,
   "text": "برید روش خواهش می‌کنم این آیه رو بشکافید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 616.88,
   "end": 620.0,
   "text": "تفاسیر رو نگاه کنید، حکما، علما ببینید چی گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 620.0,
   "end": 623.24,
   "text": "واقعاً آدم شب و روزش با این آیه می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 623.24,
   "end": 626.26,
   "text": "یه عالم دیگه‌ای پیدا می‌کنی از من قبول کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 626.26,
   "end": 628.76,
   "text": "\"هو الذي في السماء اله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 628.76,
   "end": 633.54,
   "text": "و في الارض اله\". این الهیت نظام هستی کجا انت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 633.54,
   "end": 636.06,
   "text": "کجا متصل با الهیت نظام هستی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 636.06,
   "end": 640.42,
   "text": "قلب ما. میگه او کسی‌ست همون \"قل هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 640.42,
   "end": 648.12,
   "text": "الله احد\" اون هو میگه \"هو الذي\" همون هو \"هو الاول والآخر والظاهر والباطن\" همون هو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 648.12,
   "end": 651.88,
   "text": "همون هو \"الذي\" کسی‌ست که \"في السماء اله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 651.88,
   "end": 655.16,
   "text": "همون هو تو آسمون، همون الهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 655.16,
   "end": 659.32,
   "text": "و همون هو در زمین هم \"وفى الارض اله\" همین الهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 659.32,
   "end": 663.44,
   "text": "یک حقیقته. یعنی اگر قرار باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 663.44,
   "end": 666.48,
   "text": "تو دو تا قلب داشته باشی می‌شه دو الهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 666.48,
   "end": 670.24,
   "text": "الهه این می‌شه. نمی‌شه که. لذا دو تا قلب تو دلت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 670.24,
   "end": 672.62,
   "text": "یه دونه قلبه. چون یک الهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 672.62,
   "end": 675.56,
   "text": "\"في السماء اله و في الارض اله\" اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 675.56,
   "end": 679.8,
   "text": "ببینید چگونه خودش رو باز می‌کنه این آیات با یک نگاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 679.8,
   "end": 681.94,
   "text": "یک نگاه ذره‌بین بگذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 681.94,
   "end": 684.06,
   "text": "به هر حال اینا راهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 684.06,
   "end": 686.96,
   "text": "حالا میگه حتی مرد، طرف از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 686.96,
   "end": 689.58,
   "text": "همه جمع شید نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 689.58,
   "end": 691.16,
   "text": "جماعت بهش بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 691.16,
   "end": 695.04,
   "text": "نماز میت بهش بخونید. نماز خود نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 695.04,
   "end": 697.6,
   "text": "نماز نماد وحدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 697.6,
   "end": 700.08,
   "text": "تأکد داری می‌کنی به وحدتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 700.08,
   "end": 704.34,
   "text": "ببینید خود نماز تنها سوره ای که عرض شد شب جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 704.34,
   "end": 709.3,
   "text": "تو هیئت یا زهرا شرقی تهران اونایی که مباحث رو پیگیری می‌کنند، اونجا عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 709.3,
   "end": 711.48,
   "text": "تو مباحثی سنگین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 711.48,
   "end": 716.36,
   "text": "قربونتون برم نماز با احدیت شروع می‌شه با واحدیت تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 716.36,
   "end": 718.18,
   "text": "اجازه بدید همین رو بگیم و بسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 718.18,
   "end": 722.46,
   "text": "نه دوست ندارم خیلی طول بکشه بحث‌ها که بشینید حوصله کنید گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 722.46,
   "end": 724.54,
   "text": "نگید وای حاج آقا دوباره شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 724.54,
   "end": 727.54,
   "text": "با واحدیت \"قل هو الله احد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 727.54,
   "end": 733.16,
   "text": "تنها سوره ای که اتفاقاً مستحبه تو دو تا رکعت یه نماز تکرار شه همین سوره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 733.16,
   "end": 735.4,
   "text": "\"قل هو\" کدوم هو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 735.4,
   "end": 737.26,
   "text": "الله. کدوم الله؟ احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 737.26,
   "end": 744.28,
   "text": "احدیت حضرت حق. اون احدیت به اعتبار ذات و که همه لفن پیچیده شده در اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 744.28,
   "end": 750.26,
   "text": "اون مقام بسیط و حقیقت الحقایق اونجا که ما اتصال با اونجا داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 750.26,
   "end": 753.92,
   "text": "خب با احدیت شروع شده نماز با چی تموم می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 753.92,
   "end": 756.12,
   "text": "تو شهادتین، تشهد ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 756.12,
   "end": 758.42,
   "text": "تشهد که آخر نمازته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 758.42,
   "end": 761.46,
   "text": "\"اشهد ان لا اله\" لا اله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 761.46,
   "end": 763.86,
   "text": "اله. \"الا الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 763.86,
   "end": 765.96,
   "text": "همون \"قل هو الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 765.96,
   "end": 769.4,
   "text": "اهده. حالا اینجا به چی اشاره می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 769.4,
   "end": 773.4,
   "text": "\"اشهد ان لا اله الا الله وحده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 773.4,
   "end": 775.74,
   "text": "وحده لا شريك له\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 775.74,
   "end": 783.14,
   "text": "واحدیته. اون حالت ظهور و بروز اون احدیت رو می‌گن اومده به عالم کثرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 783.14,
   "end": 785.82,
   "text": "یعنی ببین یه رفت و برگشت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 785.82,
   "end": 788.18,
   "text": "کثرت به وحدت، وحدت به کثرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 788.18,
   "end": 790.42,
   "text": "همین جوری. همه‌ی این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 790.42,
   "end": 793.42,
   "text": "عنایت‌های حضرت حقه که من و شما اینا رو بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 793.42,
   "end": 797.94,
   "text": "برای چی داریم نماز می‌خونیم؟ برای چی داریم طواف می‌ب-- اصلاً برای عبادت یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 797.94,
   "end": 801.12,
   "text": "حالا یه معنایی از عبادت تو همین بحث داشتیم که فرصت گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 801.12,
   "end": 807.12,
   "text": "انشاالله فردا. انشاالله که عاقبتمون ختم بخیر باشد به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 807.12,
   "end": 812.82,
   "text": "الله- اللهuma صلي على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}