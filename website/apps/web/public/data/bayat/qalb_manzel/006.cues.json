 ],
 "cues": [
  {
   "i": 0,
   "start": 0.68,
   "end": 4.86,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.86,
   "end": 8.36,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.36,
   "end": 14.02,
   "text": "آیاته. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.02,
   "end": 20.86,
   "text": "آیا خانم‌ها می‌تونن امام جماعت باشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.86,
   "end": 30.54,
   "text": "می‌تونن یا نه؟ مواردی هم می‌دونن که بله احسنت فقط برای خانم‌ها می‌تونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.54,
   "end": 36.02,
   "text": "خانم‌ها می‌تونن امام جماعت بایستن اما فقط برای خانم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 36.02,
   "end": 40.72,
   "text": "البته آقایون نه، هم برای آاا خانم‌ها می‌تونن بایستن هم برای آقایون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.72,
   "end": 45.96,
   "text": "یعنی اگر فقط مأمومین خانم باشن باز آقا می‌تونه امام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.96,
   "end": 51.58,
   "text": "ولی خانم فقط در صورتی که همه مأمومین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 51.58,
   "end": 54.18,
   "text": "خانم باشن می‌تونه بایسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.18,
   "end": 58.24,
   "text": "این فکر می‌کنم هنوز اکو داره آقای د.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.24,
   "end": 63.06,
   "text": "خب ، یه نکته خیلی ظریفی رو امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.06,
   "end": 68.52,
   "text": "عرض می‌کنم چون خیلی این نکته ظریفه و دقت نظر می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.52,
   "end": 75.16,
   "text": "مخصوصا امروز این نکته رو انتخاب کردم برای بیان در قلب منزل چون روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 75.16,
   "end": 81.88,
   "text": "شهادته به نظر حقیر شهادت حضرت معصومه سلام الله علیها نه ف-وفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 81.88,
   "end": 84.26,
   "text": "هستش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 84.26,
   "end": 87.34,
   "text": "عظمت و جلالت ایشون این نخ-نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.34,
   "end": 94.24,
   "text": "دقیق و ظریف رو امروز هدیه می‌کنم به روح بلند خانم که همه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 94.24,
   "end": 98.98,
   "text": "مدیون ایشون هستیم و حق حیات گردن همه ما دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 98.98,
   "end": 106.9,
   "text": "اینم که می‌گیم شهید چون یک واقعه شبیه به کربلا در نزدیکی ساوه پیش اومد در تاریخ قم ذکر شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 106.9,
   "end": 109.8,
   "text": "و ایشون مورد هجمه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 109.8,
   "end": 112.96,
   "text": "دشمنی دشمنان قرار گرفتن با اون کاروان قریب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 112.96,
   "end": 118.52,
   "text": "سی و پنج نفر از بنی هاشم و نزدیکان و فامیل و اینایی که با حضرت بودن به شهادت رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 118.52,
   "end": 120.78,
   "text": "اینا یه واقعه عجیبی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 120.78,
   "end": 123.66,
   "text": "خانم از پس این مریض شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 123.66,
   "end": 125.84,
   "text": "و حالا هفده روز در قم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.84,
   "end": 128.24,
   "text": "تشریف داشتن و به شهادت رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.24,
   "end": 132.84,
   "text": "از دنیا رفتن امروز. هدیه می‌کنیم این نکته ظریف رو به ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.84,
   "end": 136.44,
   "text": "برای اینکه متوجه این نکته بشیم اشاره می‌کنم به اون دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.44,
   "end": 143.12,
   "text": "بسیار با عظمتی که دیروز عرض کردم حضررتون از مولامون امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 143.12,
   "end": 148.4,
   "text": "که چون بحث قلب منزل است، قلب منزلگاه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 148.4,
   "end": 155.2,
   "text": "فرودگاه الهامات و القاءات و رزق الهی است از همه حیثیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 155.2,
   "end": 160.06,
   "text": "اشاره می‌کنیم به اینجا که مولا عرض می‌کنه به خدا که اللهم نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 160.06,
   "end": 162.36,
   "text": "ظاهری بطاعتك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 162.36,
   "end": 166.08,
   "text": "وباطنی بمحبتك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 166.08,
   "end": 168.36,
   "text": "وقلبی بمعرفتك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 168.36,
   "end": 172.26,
   "text": "این قلبی بمعرفتك وقتی مولامون علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 172.26,
   "end": 177.3,
   "text": "این امیر بیان داره از خدا تقاضا می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 177.3,
   "end": 179.72,
   "text": "منور کن قلب مرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 179.72,
   "end": 185.54,
   "text": "به معرفت خودت. این قشنگ داره تصریح می‌کنه که وعاء معرفت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 185.54,
   "end": 188.5,
   "text": "قلب. یعنی ظرف معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.5,
   "end": 192.26,
   "text": "قلب است. جایگاه معرفت قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.26,
   "end": 194.88,
   "text": "اشتباهی که خیلیا فکر می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.88,
   "end": 200.42,
   "text": "فز-صرفا کار فکری انجام می‌دن و تعقل انجام می‌دن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.42,
   "end": 207.88,
   "text": "مثلا مطالعاتشون رو زیاد کن-- حفظیات‌شون رو، معلومات‌شون رو زیاد می‌کنند گمان می‌کنند مثلا معرفت پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 207.88,
   "end": 212.52,
   "text": "نخیر. جایگاه معرفت قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 212.52,
   "end": 216.0,
   "text": "حالا اون نکته دقیقی که می‌خوام عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 216.0,
   "end": 220.84,
   "text": "اینجاست که حکما تو بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 220.84,
   "end": 226.28,
   "text": "از جهت خدمتتون ایجاد و اعدام خلق و حق وقتی وارد می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 226.28,
   "end": 228.86,
   "text": "اونجا می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.86,
   "end": 231.88,
   "text": "وعاء ماهیات، ماهیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 231.88,
   "end": 235.08,
   "text": "همین مربوط به حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 235.08,
   "end": 239.02,
   "text": "در حقیقت حدود و جنس و فصل اشیا، اشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 239.02,
   "end": 241.92,
   "text": "یکی هم از این اشیا هم که ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.92,
   "end": 244.74,
   "text": "خود من و شما هم از اشیا ایم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.74,
   "end": 248.24,
   "text": "و علم آدم الأسماء كلها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.24,
   "end": 251.88,
   "text": "أي الأشياء كلها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.88,
   "end": 256.2,
   "text": "که حکمت می‌شود علم به احوال اعیان موجودات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.2,
   "end": 262.04,
   "text": "یکی از این اعیان یعنی عین این موجودات و این اشیا من و شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.04,
   "end": 264.76,
   "text": "وعاء اصلی و خانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.76,
   "end": 269.26,
   "text": "اصلی این ماهیات در ذهن انسان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.26,
   "end": 274.52,
   "text": "که وقتی از ذهن بیرون اومد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 274.52,
   "end": 278.76,
   "text": "در حقیقت ماهیات از ذهن انسان خارج شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.76,
   "end": 283.14,
   "text": "اصطلاحا میگن مختفی می‌شن و هالك می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.14,
   "end": 287.2,
   "text": "در سلطان وجود، در سلطنت وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 287.2,
   "end": 291.78,
   "text": "یعنی این ماهیات، این اشیا وقتی ببینید میگه می‌خوای خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.78,
   "end": 297.58,
   "text": "ظهور و اثر یا سلطان اثر ماهیات رو درک کنی ببینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 297.58,
   "end": 300.3,
   "text": "در وعاء ذهن خودت ببین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.3,
   "end": 306.08,
   "text": "که وقتی این از ذهن خارج شد در متن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 306.08,
   "end": 308.34,
   "text": "خارج قرار گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.34,
   "end": 311.2,
   "text": "مختفی می‌شه، خفی می‌شه در وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.2,
   "end": 315.12,
   "text": "چرا؟ اصطلاحا به این اتفاقا میگن قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 315.12,
   "end": 319.08,
   "text": "کبرای عارف. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 319.08,
   "end": 321.52,
   "text": "غرق در وجود می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 321.52,
   "end": 323.8,
   "text": "در اون وجود اصمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.8,
   "end": 326.86,
   "text": "که کل شیء حال کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.86,
   "end": 330.78,
   "text": "الا وجهه. نه اینکه نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.78,
   "end": 338.72,
   "text": "نه اینکه وجودش رو ورداری اون ماهیات رو کلا بگی این وجود نداره، این آسمان الان دیگه نیست در متن خارج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 338.72,
   "end": 346.52,
   "text": "از اون متن، از اون ذات حضرت حق از صورت علمیه حضرت حق که بهش می‌گفتن اعیان ثابته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 346.52,
   "end": 349.88,
   "text": "خارج شد، حد گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.88,
   "end": 354.64,
   "text": "ایجاد شد. درست شد در نشئه خارج در اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 354.64,
   "end": 358.24,
   "text": "در س-- خارج از ذات حضرت حق ایجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 358.24,
   "end": 361.34,
   "text": "این آسمان، این زمین، من، شما همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.34,
   "end": 364.06,
   "text": "این میگه اثر اون اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 364.06,
   "end": 365.96,
   "text": "ظهورش رو دیگه از دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.96,
   "end": 368.56,
   "text": "اون سلطنت ظهور رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 368.56,
   "end": 371.76,
   "text": "چرا؟ مخفی می‌شه در وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 371.76,
   "end": 373.28,
   "text": "چون هرچه هست اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 373.28,
   "end": 377.74,
   "text": "\"هو الاول والآخر والله والباطن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.74,
   "end": 383.06,
   "text": "هرچه هست اوست. اگه هرچه هست اوست، وجود اصمد حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 383.06,
   "end": 385.56,
   "text": "پس اینجا ماهیات اصلا دیده نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 385.56,
   "end": 388.6,
   "text": "به این می‌گن قیامت کبرای عارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 388.6,
   "end": 392.76,
   "text": "یعنی عارف آنچه که ظهور کرده است رو در خارج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.76,
   "end": 395.96,
   "text": "ظهور حق می‌بیند. سلطنت حق می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 395.96,
   "end": 399.06,
   "text": "لذا می‌گه \"لمن اليوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.06,
   "end": 402.86,
   "text": "لمن الملك اليوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 402.86,
   "end": 406.18,
   "text": "\"لمن\" یعنی برای کیست؟ \"الملک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 406.18,
   "end": 410.2,
   "text": "همه سلطنت، همه مالکیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 410.2,
   "end": 415.3,
   "text": "\"لمن الملك اليوم\" امروز مال کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.3,
   "end": 419.02,
   "text": "خود خدا جواب می‌ده. آیه قرآنه \"لله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.02,
   "end": 422.54,
   "text": "اونم کدوم الله؟ \"الواحد القهار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 422.54,
   "end": 425.14,
   "text": "الله اکبر. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 425.14,
   "end": 434.06,
   "text": "فرمودن اگر اسم الواحد به علاوه اسم القهار بشه یعنی مثل اینجا \"لله الواحد القهار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.06,
   "end": 438.44,
   "text": "این معنای احدیت حضرت حق رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.44,
   "end": 442.08,
   "text": "احدیت. \"لله الواحد القهار\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 442.08,
   "end": 446.34,
   "text": "اینجا معنای احدیته. معنای احدیت هم به صغرا ذات برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 446.34,
   "end": 448.92,
   "text": "یعنی اوست، دومی ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 448.92,
   "end": 451.48,
   "text": "خداست و خدایی می‌کند تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 451.48,
   "end": 454.4,
   "text": "اصلا چیزی نیست جز او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 454.4,
   "end": 457.48,
   "text": "توجه کردین؟ و هرچی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 457.48,
   "end": 461.54,
   "text": "حتی حالا ما و در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.54,
   "end": 464.42,
   "text": "وجود زمین و آسمان و اینا رو که نمی‌تونیم برداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 464.42,
   "end": 472.18,
   "text": "اینا ایجاد‌اند. وقتی از اون وعاء ذهن یا وعاء اعیان ثابته در علم در صور علمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 472.18,
   "end": 476.48,
   "text": "در ذات حضرت حق خارج می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 476.48,
   "end": 479.62,
   "text": "دیگه هالك می‌شن در وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 479.62,
   "end": 482.88,
   "text": "یعنی دیگه غرق در اون سلطنت رو دیگه ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.88,
   "end": 487.52,
   "text": "اتفاقا اینجا خدا رحمت کنه از علامه حسن زاده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.52,
   "end": 491.36,
   "text": "به ضرب من التقریب و تمثیل به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.36,
   "end": 498.0,
   "text": "حالا نزدیکی و فهم بهتر مثل می‌زدن از حضرت علامه رفیع قزوینی آشخ ابوالحسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 498.0,
   "end": 502.2,
   "text": "که استادشون بودن مثال آوردن که می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 502.2,
   "end": 505.94,
   "text": "مرحوم علامه قزوینی اینجا که می‌رسیدن مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 505.94,
   "end": 510.74,
   "text": "اون عرض شود خدمتتون سیارات سبعه و بروج رو می‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 510.74,
   "end": 514.86,
   "text": "این مثال رو خوب گوش بدید قشنگ متوجه می‌شید یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 514.86,
   "end": 517.98,
   "text": "که هر چیزی در خانه خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 517.98,
   "end": 520.08,
   "text": "اثرش قوی‌تره. اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 520.08,
   "end": 525.76,
   "text": "خود ما هم اینطوریم. وقتی تو خونه خودمونیم، در موطن خودمونیم، در شهر خودمونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 525.76,
   "end": 528.64,
   "text": "تمام تاثیرات ما عیان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 528.64,
   "end": 533.56,
   "text": "ولی وقتی میریم یه جا غریب واقع می‌شیم، از خونه خودمون خارج می‌شیم، مسافر می‌شیم، غریب می‌شیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 533.56,
   "end": 535.6,
   "text": "اون اثر واقعی رو، اون ظهور رو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 535.6,
   "end": 539.5,
   "text": "کسی ما رو نمی‌شناسه اصلا. یا اون مثالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 539.5,
   "end": 543.46,
   "text": "شیخ اجل این شیخ عارف سعدی علیه الرحمه زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 543.46,
   "end": 545.2,
   "text": "حالا البته اینو به نظم کشونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 545.2,
   "end": 548.7,
   "text": "این مثال اون کرمک شبتاب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.7,
   "end": 553.9,
   "text": "و می‌فرماید که این کرمک شبتاب رو بهش گفتن آقا تو چرا روز بیرون نمیای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 553.9,
   "end": 556.5,
   "text": "همه شب بیرونی. عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 556.5,
   "end": 559.84,
   "text": "کرمک شبتاب. این نظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 559.84,
   "end": 565.44,
   "text": "ش-سعدی علیه الرحمه‌ست. کرمک شبتاب، شبتاب شب می‌تابید مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 565.44,
   "end": 569.06,
   "text": "می‌گن تو چرا روز بیرون نیومدی؟ می‌گه آقا من روز هم بیرونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 569.06,
   "end": 572.86,
   "text": "اما به واسطه ظهور خورشید دیده نمی‌شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 572.86,
   "end": 577.52,
   "text": "ببین یعنی، یعنی همه چی هالك می‌شه در وجود حضرت حق یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 577.52,
   "end": 580.1,
   "text": "نه اینکه اصلا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 580.1,
   "end": 582.56,
   "text": "نه اینکه ماهیات وجود ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 582.56,
   "end": 585.98,
   "text": "نه، نمی‌شه وجودشون رو برداشت. ایجاد شدن، ایجاد شدن، ایجاد شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 585.98,
   "end": 588.84,
   "text": "اما اصلا اینا دیگه به-در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 588.84,
   "end": 590.96,
   "text": "ظهور سلطنت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 590.96,
   "end": 595.06,
   "text": "وقتی عزت حق ظهور کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 595.06,
   "end": 598.08,
   "text": "دیگه اصلا اینا دیده نمی‌شن. عین حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 598.08,
   "end": 600.78,
   "text": "عین ظهور و شؤون حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 600.78,
   "end": 603.74,
   "text": "وقتی هم موطن خودشون خارج می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 603.74,
   "end": 608.48,
   "text": "که اونجا حالا حضرت علامه اشاره می‌کنند به دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 608.48,
   "end": 611.34,
   "text": "عرض شود که سحر‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 611.34,
   "end": 618.54,
   "text": "مناجات شعبانیه. اونجا می‌فرماید \"تسیر ارواحنا معلقةً بعز قدسک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 618.54,
   "end": 620.8,
   "text": "عز، عز، عزت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 620.8,
   "end": 626.24,
   "text": "اگر سلطنت عزت خودش رو نشون بده که حالا این بیت آخره به نظم کشیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 626.24,
   "end": 628.9,
   "text": "سعدی ببین چه شیرین همین رو داره می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 628.9,
   "end": 632.66,
   "text": "چو سلطان عزت علم برکشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 632.66,
   "end": 636.24,
   "text": "چو سلطان عزت علم برکشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 636.24,
   "end": 639.66,
   "text": "جهان سر به جیب عدم برکشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 639.66,
   "end": 646.86,
   "text": "این اعدام نه اینکه کلا ایجادش رو، اون انشاش رو، اون کلا وجودش رو ورداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 646.86,
   "end": 650.38,
   "text": "نه، هست اما دیگه به خودی خود چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 650.38,
   "end": 654.0,
   "text": "اصلا دیده نمی‌شه. این قیامت کبرای عارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 654.0,
   "end": 657.18,
   "text": "توجه کردی؟ حالا اون مثال حالا اون مثال چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 657.18,
   "end": 660.74,
   "text": "علامه ق-رفیع قزوینی می‌زدن مثال شیوائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 660.74,
   "end": 665.86,
   "text": "در علم هیئت هم حضرت علامه حسن زاده می‌گفتن در علم هیئت هم هست مطرح این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 665.86,
   "end": 667.86,
   "text": "همون سیارات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 667.86,
   "end": 669.92,
   "text": "سبعه و بروج. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 669.92,
   "end": 672.38,
   "text": "مثلا می‌گن که خورشید خانه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 672.38,
   "end": 676.52,
   "text": "برج اسده. خانه خورشید برج اسده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 676.52,
   "end": 681.96,
   "text": "قلب الاسد می‌گن وقتی خورشید در برج اسده خیلی داغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 681.96,
   "end": 684.78,
   "text": "به شدت ظهور دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 684.78,
   "end": 693.12,
   "text": "خب؟ خیلی گرمه. وقتی که خارج می‌شه از این برج به خصوص به وبال می‌افته، حدود مثلا شش برج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 693.12,
   "end": 695.38,
   "text": "دور می‌شه، عقب می‌افته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 695.38,
   "end": 699.04,
   "text": "خارج می‌شه این دیگه مثلا ظهور اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 699.04,
   "end": 701.22,
   "text": "در حقیقت اثر رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 701.22,
   "end": 703.24,
   "text": "چرا؟ از خانه خودش خارج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 703.24,
   "end": 705.2,
   "text": "حالا این به ضرب من التمثیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 705.2,
   "end": 708.7,
   "text": "جهت تقریب ذهنه. مثاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 708.7,
   "end": 713.36,
   "text": "این داره نشون می‌ده که هر چیزی از خانه خود به-- اینو، این نکته‌س دارم می‌گما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 713.36,
   "end": 720.48,
   "text": "اینم به זה دارم زور می‌زنم. هر چیزی از موطن خودش خارج شد دیگه اثر خودش رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 720.48,
   "end": 723.34,
   "text": "ضعیفه. اصلا هالکه. اصلا دیده نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 723.34,
   "end": 726.64,
   "text": "خب چه ربطی داره به بحث قلب م-منزل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 726.64,
   "end": 728.98,
   "text": "برمی‌گردیم به همین دعای مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 728.98,
   "end": 732.44,
   "text": "می‌گه، می‌فرماید که خدایا نورانی کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 732.44,
   "end": 735.2,
   "text": "قلب مرا به معرفتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 735.2,
   "end": 738.04,
   "text": "پس قلب وعاء معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 738.04,
   "end": 742.64,
   "text": "خب نتیجه. اگر معرفت از قلب خارج شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 742.64,
   "end": 746.02,
   "text": "معرفت، شناخت، اون یقین، اون باور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 746.02,
   "end": 747.84,
   "text": "نور علم بهتره بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 747.84,
   "end": 750.54,
   "text": "علم خود علم که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 750.54,
   "end": 755.6,
   "text": "نور علم نگیریم، اون دانسته‌ها، اون مفروضات، اون الفاظ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 755.6,
   "end": 762.44,
   "text": "اونه که شخم می‌زنه وجود تو، اون وارد فضای فکر تو و عقل تو می‌شه، حوزه تدبر تو، تعقل تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 762.44,
   "end": 765.72,
   "text": "اون اگر بره تو قلب می‌شه معرفت، می‌شه نور علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 765.72,
   "end": 770.0,
   "text": "حالا الان دیگه وقت نیست فردا درباره‌ش صحبت می‌کنیم یعنی چی، چه فرقی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 770.0,
   "end": 777.48,
   "text": "اگر این معرفت، شناخت از قلب خارج شد یعنی از دسترس قلب خارج شد، دیگه اثر نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 777.48,
   "end": 781.1,
   "text": "دیگه حالا این مثال رو من زدم. مثال علمی و دقیق رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 781.1,
   "end": 786.32,
   "text": "حیث قیامت کبرای عارف به شما مثال زدم که بدونیم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 786.32,
   "end": 789.72,
   "text": "اگر م-- خانه‌ی معرفت قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 789.72,
   "end": 794.78,
   "text": "اگر کسی معارف رو به قلبش وارد نکنه اثری نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 794.78,
   "end": 799.96,
   "text": "تاثیری نداره. اینه که می‌بینی هزار و یک نماز می‌خونم، زیارت میرم، قرآن میرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 799.96,
   "end": 805.68,
   "text": "هیئت میرم. هزار و یک کار می‌کنم حتی اطلاعاتم ه-هر روز داره زیادتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 805.68,
   "end": 808.16,
   "text": "اما اون اثر ممکن رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 808.16,
   "end": 811.58,
   "text": "تاثیری نه در خودم دارم، نه در دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 811.58,
   "end": 817.62,
   "text": "چرا؟ چون اون معرفت، اون شناخت از حوزه قلب خارج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 817.62,
   "end": 822.18,
   "text": "یعنی تحت تصرف و اون سکونت قلب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 822.18,
   "end": 828.0,
   "text": "باید زحمت کشید و این رو در حوزه قلب قرار داد تا اثرش رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 828.0,
   "end": 830.24,
   "text": "ان شا الله که عاقبتمون ختم بخیر شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 830.24,
   "end": 833.38,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 833.38,
   "end": 840.12,
   "text": "اللهم صل على محمد وآل محمد. هرچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}