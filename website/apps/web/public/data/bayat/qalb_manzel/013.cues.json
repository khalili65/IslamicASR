 },
 "chapters": [
  {
   "index": 0,
   "title": "## قلب وعاء معرفت؛ هشدار از انحراف عرفان‌های حلقه",
   "start": 0.7,
   "end": 847.99
  },
  {
   "index": 1,
   "title": "## انتصاب به امامت با خشیت",
   "start": 847.99,
   "end": 890.59
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.7,
   "end": 4.76,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.76,
   "end": 9.76,
   "text": "السلام علیک یا داعی الله و ربانیة آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.76,
   "end": 11.8,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.8,
   "end": 15.96,
   "text": "جلسه‌ی گذشته عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.96,
   "end": 22.78,
   "text": "یعنی در جلسات گذشته در بحث قلب منزل عرض کردیم که قلب وعاء معرفت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.78,
   "end": 25.72,
   "text": "و به جز معرفت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.72,
   "end": 27.6,
   "text": "عبودیت معنا ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.6,
   "end": 30.62,
   "text": "و سپس زدیم اون رو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.62,
   "end": 36.5,
   "text": "عنایت با روایات آل الله علیهم الصلاة و السلام به معرفت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.5,
   "end": 45.76,
   "text": "و این رو عرض کردیم اصل معرفت، اون نور معرفت، اون حقیقت معرفت و شناخت و عرفان از ملکوت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.76,
   "end": 48.36,
   "text": "و البته خیلی راحت ازش گذشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.36,
   "end": 50.66,
   "text": "اینجا یه نکته‌ای رو عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.66,
   "end": 57.5,
   "text": "یه وقت ما به انحرافاتی که بعضیا کشیده میشن در عرفان‌های حلقه و چه و چه و اینها ما گرفتار نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.5,
   "end": 62.32,
   "text": "که معرفت درسته که اصلش از بالاست، اصلش از ملکوت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.32,
   "end": 64.66,
   "text": "اصلاً جنس معرفت از نور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.66,
   "end": 69.44,
   "text": "عرفان از نور است. همون که همونطور که علم از نور است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.44,
   "end": 73.26,
   "text": "که العلم نور یغرف الله فی قلب من یشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.26,
   "end": 76.32,
   "text": "لکن ما چون صاحب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.32,
   "end": 79.4,
   "text": "نفس مکتفی نیستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.4,
   "end": 83.0,
   "text": "و نفس ما نفس مستکفیه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.0,
   "end": 84.92,
   "text": "چاره‌ای نداریم جز تلاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.92,
   "end": 91.7,
   "text": "چاره‌ای نداریم جز شخم زدن وجودمون و بذرپاشی در وجودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.7,
   "end": 97.82,
   "text": "اون بسترسازی در وجودمون با ورزش فکری به قول حضرت علم حسن زاده علیه الرحمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.82,
   "end": 101.28,
   "text": "معرفت پیش درآمد عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.28,
   "end": 104.38,
   "text": "یعنی عمل بدون معرفت اصلاً قبول نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.38,
   "end": 109.68,
   "text": "و جالبه که عمل هم باز خودش مقدمه معرفت بعدی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.68,
   "end": 112.66,
   "text": "یعنی اگر معرفت اومد عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.66,
   "end": 118.28,
   "text": "زایش نشد، این اصلاً معرفت نبوده و خود عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.28,
   "end": 121.9,
   "text": "و اگر عمل پشت معرفت اومد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.9,
   "end": 125.22,
   "text": "معروف معلومه که اون تلاش ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.22,
   "end": 129.22,
   "text": "اِمم، به مراحل بعدی ما رو رسونده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.22,
   "end": 132.04,
   "text": "أليس للإنسان إلا ما سعى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.04,
   "end": 136.3,
   "text": "آیا برای انسان جز اونچه که سعی و تلاش میکنه چیزی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.3,
   "end": 139.24,
   "text": "قرآن میفرماید. و اگر چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.24,
   "end": 143.18,
   "text": "چیزی شد یعنی معرفت به عمل کشیده شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.18,
   "end": 148.9,
   "text": "عمل مطابق با شرع، این باز خودش مقدمه معرفت بعدی میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.9,
   "end": 151.42,
   "text": "و در هر-- چون هندسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.42,
   "end": 159.68,
   "text": "هندسه به حقیقت اخلاص یعنی عملی که با اخلاص انجام بشود پایین به بالاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.68,
   "end": 163.06,
   "text": "و بالعکس هندسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.06,
   "end": 166.88,
   "text": "سیر نزولی معرفت از بالا به پایینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.88,
   "end": 175.34,
   "text": "که حالا از بالا به پایین توفیق معرفت نازل میشود و در مرحله بعدی در سیر و سلوک عملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.34,
   "end": 181.64,
   "text": "معرفت هرچی که بیشتر میشه موجب بیداری انسان میشه تا جایی که اشراف بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.64,
   "end": 183.96,
   "text": "هستی خودش پیدا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.96,
   "end": 186.98,
   "text": "این شناخت هرچی بیشتر میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.98,
   "end": 193.4,
   "text": "عمل رو بیشتر میکنه و یک مسابقه‌ای در به قول بزرگان در خیر و کمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.4,
   "end": 196.44,
   "text": "شروع میشه که هر عملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.44,
   "end": 200.44,
   "text": "دو مرتبه پشت سر خودش هم عمل می‌زاید هم معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.44,
   "end": 203.88,
   "text": "همینطور مسابقه و سباق الخیرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.88,
   "end": 205.94,
   "text": "که کاری هم جز این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.94,
   "end": 210.08,
   "text": "یعنی کاری ما جز اینکه تلاش کنیم چه میخوایم بکنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.08,
   "end": 212.9,
   "text": "تلاش ما شخم زدن وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.9,
   "end": 221.92,
   "text": "بله. اهل، اهل بیت علیهم الصلاة و-- چون اونهایی که معمولاً متأسفانه تو این عرفان‌های حلقه جوون‌ها رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.92,
   "end": 226.28,
   "text": "انحراف می‌کشونن میگن پس چگونه است که اهل بیت علیهم الصلاة و السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.28,
   "end": 232.18,
   "text": "مثلاً درس و بحث و کلاس و حوزه و دانشگاه نداشتند و نرفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.18,
   "end": 234.68,
   "text": "و اینچنین به اون مقامات عالیه رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.68,
   "end": 238.54,
   "text": "اون‌ها صاحبان نفس مکتفیه بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.54,
   "end": 242.06,
   "text": "اون‌ها به علم لدنیه حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.06,
   "end": 244.8,
   "text": "حضرت حق مفتخر بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.8,
   "end": 251.52,
   "text": "اگرچه جنبه بشری خودشان را حفظ می‌کردند که همون آیه آخر سوره کهف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.52,
   "end": 255.32,
   "text": "آیه صد و یازده که قل إنما أنا بشر مثلکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.32,
   "end": 258.98,
   "text": "این اشاره به جنبه بشری آل الله دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.98,
   "end": 262.76,
   "text": "که پیغمبر بگو که قطعاً منم مثل شما بشرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.76,
   "end": 266.48,
   "text": "مثل شما زندگی می‌کنم. اما يوحي إلي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.48,
   "end": 269.12,
   "text": "أنما إلهكم إله واحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.12,
   "end": 271.38,
   "text": "این اشاره به اون جنبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.38,
   "end": 274.1,
   "text": "نفس مس-- مکتفیه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.1,
   "end": 281.62,
   "text": "جنبه نورانیت، همون مقام نوری و مقام نورانیتی که مولامون علی علیه الصلاة والسلام فرمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.62,
   "end": 285.6,
   "text": "یعنی پیغمبر در میان مردم مثل خودشون زندگی می‌کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.6,
   "end": 289.6,
   "text": "اما به وقتش از اون علم الهی بهره می‌جست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.6,
   "end": 293.4,
   "text": "هر جا که اجازه داشت و هر جا که اذن داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.4,
   "end": 297.5,
   "text": "خدا حفظ کنه آقای قرائتی اینجا مثال قشنگی داشتن می‌فرمودن مثل یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.5,
   "end": 300.1,
   "text": "حالا مثل دیگه برای تسهیل در فهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.1,
   "end": 303.78,
   "text": "مثل یک پلیسی که یک اسلحه ای رو به خودش می‌بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.78,
   "end": 308.12,
   "text": "و اجازه نداره از این اسلحه در هر جایی استفاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.12,
   "end": 309.84,
   "text": "به وقتش ازش استفاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.84,
   "end": 314.48,
   "text": "یا اون داستانی که در تاریخ اومده در تاریخ پیغمبر عظیم الشأن اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.48,
   "end": 317.3,
   "text": "که حالا برمی‌گشتن از یک جنگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.3,
   "end": 321.2,
   "text": "حدود یک فرسخی مدینه نزدیک چاهی به نام بقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.2,
   "end": 328.8,
   "text": "منزل کردن. اونجا حضرت به علم غیب از مرگ یک منافقی خبر داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.8,
   "end": 331.86,
   "text": "بلافاصله یه توفان شدیدی گرفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.86,
   "end": 335.14,
   "text": "شترها فراری شدند. از جمله شتر پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.14,
   "end": 337.96,
   "text": "پیغمبر فرمود برید شتر منو پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.96,
   "end": 341.12,
   "text": "یه منافقی که تو اون جمع بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.12,
   "end": 343.88,
   "text": "یه سست ایمانی حالا بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.88,
   "end": 351.68,
   "text": "گفتش که این چگونه پیغمبریه که خبر از غیب میگه که فلان منافق کشته شد در حالی که خبر از شتر خودش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.68,
   "end": 355.26,
   "text": "پیغمبر همون آن فرمودند برید فلان جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.26,
   "end": 361.16,
   "text": "شتر من که رم کرده رفته حالا اون افسارش گیر کرده به شاخه درختی، اونجا آزادش کنید بیاریدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.16,
   "end": 363.62,
   "text": "رفتن همونجا دیدن همونجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 363.62,
   "end": 366.85,
   "text": "اتفاقاً نام صادق صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 366.85,
   "end": 371.45,
   "text": "در کتاب شریف کافی جلد یک صفحه دویست و پنجاه و هشت از امـ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.45,
   "end": 377.71,
   "text": "روایت نقل کرده مرحوم کلینی از امام صادق صلی الله علیه می‌فرماید که إن الإمام إذا شاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 377.71,
   "end": 380.41,
   "text": "أن يعلم أعلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.41,
   "end": 383.97,
   "text": "امام هرگاه که اراده کند که بداند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.97,
   "end": 388.61,
   "text": "أعلم به او، اون علم داده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.61,
   "end": 391.93,
   "text": "یعنی معلوم می‌شه براش اون علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.93,
   "end": 397.45,
   "text": "و به حضرت داده می‌شه. حالا اینجا ما نباید که خودمون رو قیاس کنیم در این مسئله چون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.45,
   "end": 400.87,
   "text": "بالاخره انحرافاتی داشتیم، آلودگی‌هایی داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 400.87,
   "end": 403.95,
   "text": "از همون نطفه بگیر به بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.95,
   "end": 406.05,
   "text": "خیلی چیزها مزاج ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 406.05,
   "end": 411.13,
   "text": "نفس‌ها، خوردنی‌ها، لمس کردنی‌ها، بوییدنی‌ها، شنیدنی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.13,
   "end": 413.91,
   "text": "دیدنی‌ها اینا همه ما رو متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.91,
   "end": 420.21,
   "text": "به ذیق کشونده. اما خب باید اینو با طهارت نفس و ورزش فکری و کار فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.21,
   "end": 423.95,
   "text": "آماده کنیم، شخم بزنیم وجودمون رو برای کاشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.95,
   "end": 425.55,
   "text": "دانه و بذر معرفت؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 425.55,
   "end": 427.65,
   "text": "که معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 427.65,
   "end": 437.69,
   "text": "در حقیقت میاد در اون، اون دانه و بذر عرفان میاد در ضمیر پاک می‌شینه و شاخ و برگ میده، به ثمر می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.69,
   "end": 440.25,
   "text": "ااا پس ما باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.25,
   "end": 444.49,
   "text": "طلب کنیم و بخواهیم تلاش کنیم تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.49,
   "end": 446.51,
   "text": "این تلاش و کوشش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 446.51,
   "end": 448.91,
   "text": "منجر به سوز و گداز بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 448.91,
   "end": 451.37,
   "text": "تا این سوز و گداز ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.37,
   "end": 456.95,
   "text": "برسونه به مرحله معرفت که تجلیات حضرت حق است که کل يوم هو في شأن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.95,
   "end": 462.43,
   "text": "دائم آنفآن حضرت حق در تجلی جدیدیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 462.43,
   "end": 465.69,
   "text": "خصوصا در خصوص قلب مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 465.69,
   "end": 469.55,
   "text": "آنفآن خدا تجلی جدید می‌کنه به قلب مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.55,
   "end": 472.05,
   "text": "اتفاقا حالا مراحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.05,
   "end": 474.83,
   "text": "عرفان رو هم دیدید دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 474.83,
   "end": 481.01,
   "text": "عرفا حالا اگرچه به ذوق فرمودن اما همش ریشه روایی و آیه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.01,
   "end": 489.07,
   "text": "از عروین سبعه، سماوات سبع این‌ها استفاده کردن فرمودن هفت شهر عشق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 489.07,
   "end": 491.51,
   "text": "هفت مرحله برای عرفان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 491.51,
   "end": 496.07,
   "text": "بالاخره می‌خوایم حرکت کنیم. اولین مرحله رو گفتن مرحله طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.07,
   "end": 498.61,
   "text": "طلب رو همون تلاش بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.61,
   "end": 500.91,
   "text": "طلب کردی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 500.91,
   "end": 502.97,
   "text": "تلاش کنی. خب کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.97,
   "end": 505.25,
   "text": "تلاش نمی‌کنه طلب نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.25,
   "end": 509.47,
   "text": "یعنی طالب نیست. بارها ما وقتی می‌شینیم رو منبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 509.47,
   "end": 515.29,
   "text": "میگیم طلب وجودی شما باعث می‌شه که ما یه روایت دست بگیریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 515.29,
   "end": 517.95,
   "text": "ساعت‌ها درباره‌ش حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.95,
   "end": 520.69,
   "text": "به جهت طلب وجودی شماست که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 520.69,
   "end": 526.11,
   "text": "ملکوت عالم اشراقيات و القاءات حضرت حق صورت می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 526.11,
   "end": 529.51,
   "text": "بر کسی که البته با اخلاص روی منبر بنشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 529.51,
   "end": 532.05,
   "text": "این طلب وجودی شماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.05,
   "end": 539.17,
   "text": "که حتی یه منبری رو، یک مربی و یک معلم رو به تلاش وامی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 539.17,
   "end": 541.19,
   "text": "مرحله دوم می‌شه عشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.19,
   "end": 543.95,
   "text": "که میگن عقل سوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.95,
   "end": 546.77,
   "text": "یعنی مافوق طور عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.77,
   "end": 550.45,
   "text": "طلب که کردی بعد به سوز عشق می‌افتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.45,
   "end": 554.11,
   "text": "این سوز عشق کاری می‌کنه با تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 554.11,
   "end": 556.61,
   "text": "که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 556.61,
   "end": 559.25,
   "text": "سوختن‌ها باعث می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.25,
   "end": 563.03,
   "text": "به یک معنا هرچه اضافه است از وجودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.03,
   "end": 568.03,
   "text": "از بین بره. مثل این قدیم‌ها طلا رو می‌ذاشتن تو بوته، تو تنور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 568.03,
   "end": 575.27,
   "text": "انقدر آتش بر می‌افروختن هلوهش این طلا تا هرچه ناخالصی است از وجودش بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.27,
   "end": 577.99,
   "text": "وقتی ناخالصی‌ها رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 577.99,
   "end": 579.63,
   "text": "معرفت تجلی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 579.63,
   "end": 585.23,
   "text": "اینجا دیگه تجلیات آنفآن حضرت حق است بر وجود عارف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 585.23,
   "end": 590.07,
   "text": "بر قلب کسی که در مسیر معرفت حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 590.07,
   "end": 594.35,
   "text": "مرحله چهارم، پس سوم شد معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 594.35,
   "end": 595.91,
   "text": "که وعاء قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 595.91,
   "end": 599.19,
   "text": "مرحله چهارم فرمودن استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 599.19,
   "end": 601.81,
   "text": "یعنی اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 601.81,
   "end": 605.65,
   "text": "راز و نیاز باشه. به سمت بی‌نیاز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 605.65,
   "end": 608.81,
   "text": "عالم توجه داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 608.81,
   "end": 611.15,
   "text": "و خودش رو بدهکار بدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 611.15,
   "end": 613.75,
   "text": "خودش رو گناهکار بدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 613.75,
   "end": 618.87,
   "text": "خودش رو عاصی بدونه. چون تجلیات حضرت حق که رخ میده اگر انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 618.87,
   "end": 624.07,
   "text": "ظرفش کوچیک باشه یه وقت خدای نکرده به اشتباه می‌افته و فکر می‌کنه که خبری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 624.07,
   "end": 627.21,
   "text": "حالا مثلاً به جایی رسید و این‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 627.21,
   "end": 633.09,
   "text": "متاسفانه صاحبان نفوس ذیق این گرفتاری رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 633.09,
   "end": 636.35,
   "text": "که معمولا اینجور جاها خدا دست به کار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 636.35,
   "end": 639.81,
   "text": "خدای منان البته لطف می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 639.81,
   "end": 644.41,
   "text": "با هرکس البته نسبت به وجود-- اون قدر و سر القدرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 644.41,
   "end": 649.37,
   "text": "به گونه‌ای رفتار می‌کنه که از اون اوج و از اون خوش-- خودشیفتگی نجاتش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 649.37,
   "end": 653.71,
   "text": "مرحله پنجم فرمودن تجرید و توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 653.71,
   "end": 656.31,
   "text": "یعنی چنان صعود می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 656.31,
   "end": 658.43,
   "text": "به عالم مجردات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 658.43,
   "end": 661.69,
   "text": "از عالم ماده و تعلقات می‌کَنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 661.69,
   "end": 664.83,
   "text": "به حقیقت موت قبلاً تموت می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 664.83,
   "end": 669.55,
   "text": "که یکپارچه همه کثرات رو نه اینکه از کثرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 669.55,
   "end": 673.47,
   "text": "دور بشه، روحانیت بگذینه و بره در غار زندگی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 673.47,
   "end": 676.81,
   "text": "نه. در عین اینکه کن for الناس ولا تکن معهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 676.81,
   "end": 679.09,
   "text": "در عین اینکه بین مردم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 679.09,
   "end": 684.23,
   "text": "اما همه کثرات رو مستهلك در ذات حضرت حق می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 684.23,
   "end": 688.09,
   "text": "مستهلك در احدیت حضرت حق می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 688.09,
   "end": 692.57,
   "text": "وقتی یک عارف که به این مرحله رسیده ورود می‌کنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 692.57,
   "end": 695.81,
   "text": "سوره اخلاص، قیامت در وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 695.81,
   "end": 699.43,
   "text": "قیامت می‌کنه. یکپارچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 699.43,
   "end": 702.45,
   "text": "قامتش سرتاپا قیامت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 702.45,
   "end": 708.67,
   "text": "که وقتی می‌گوید قل، قل چه بگویم ای خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 708.67,
   "end": 710.75,
   "text": "هو. این هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 710.75,
   "end": 712.63,
   "text": "اشاره دارد به همان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 712.63,
   "end": 714.79,
   "text": "احدیت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 714.79,
   "end": 716.75,
   "text": "خب من می‌خوام صداش بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 716.75,
   "end": 719.97,
   "text": "چگونه صداش بزنم؟ بگو الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 719.97,
   "end": 725.01,
   "text": "اولین اسمی که از اون ذات غیب الغیوب و واجب الوجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 725.01,
   "end": 729.39,
   "text": "صادر شده، خودش رو نشون داده، منتشر شده، انتشار شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 729.39,
   "end": 732.01,
   "text": "همین الله است. الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 732.01,
   "end": 735.85,
   "text": "خب حالا الله چگونه الله بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 735.85,
   "end": 737.69,
   "text": "چه اللهی رو صدا بزنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 737.69,
   "end": 739.41,
   "text": "احد. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 739.41,
   "end": 745.19,
   "text": "ببینید یعنی این مرحله تمام کثرات رو مستهلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 745.19,
   "end": 748.49,
   "text": "در ذات حضرت حق می بیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 748.49,
   "end": 751.83,
   "text": "که کل شیء حال کن الا وجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 751.83,
   "end": 758.09,
   "text": "مرحله ششم از اینجا عارف به مرحله حیرت و هیمان می رسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 758.09,
   "end": 762.79,
   "text": "که رب زدنی فیک تحیرات چنان به احوال اعیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 762.79,
   "end": 769.91,
   "text": "موجودات و کلمات وجودی نظام هستی پی می برد که یکپارچه در هیمان و حیرت سر می برد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 769.91,
   "end": 773.89,
   "text": "و به هر طرف نگاه می کند در حیرت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 773.89,
   "end": 776.99,
   "text": "که اتفاقا از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 776.99,
   "end": 781.41,
   "text": "زندگی‌ها و حشر و نشر طبیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 781.41,
   "end": 784.75,
   "text": "حتی مسائل جنسی این‌ها استفاده می کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 784.75,
   "end": 789.43,
   "text": "خوردن، خوابیدن این‌ها بهره می بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 789.43,
   "end": 795.11,
   "text": "از مباحات بهره می بره برای اینکه روحش مفارقت نکنه از این عالم بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 795.11,
   "end": 799.39,
   "text": "و مرحله هفتم هم فقر و ف-فقر و فناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 799.39,
   "end": 803.49,
   "text": "فقر و فنا رو هم مرتبه مقام ولایت بگیر؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 803.49,
   "end": 806.33,
   "text": "یعنی به هر میزان که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 806.33,
   "end": 816.27,
   "text": "بهتر و سریع‌تر و بیشتر به این مرحله رسید و سعی وجودی در اینجا پیدا کرد، آب و اون مائ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 816.27,
   "end": 820.57,
   "text": "حقیقت مائیه و همون من المائ کل شیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 820.57,
   "end": 823.37,
   "text": "حی. اون آبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 823.37,
   "end": 833.91,
   "text": "آب حیات است و به یک معنا علم است و سبب قرب است یا عین قرب، عین علم است و عین علم، عین ولایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 833.91,
   "end": 837.45,
   "text": "او رو به چنان فقر و فنایی دچار می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 837.45,
   "end": 839.77,
   "text": "که دیگه بهش میگن مقام ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 839.77,
   "end": 843.55,
   "text": "به هر میزان که این قرب رو پیدا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 843.55,
   "end": 846.73,
   "text": "ولی شده است. تا جایی که خیلی عجیب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 846.73,
   "end": 852.99,
   "text": "خیلی عجیب واقعا امام صادق صلوات الله علیه ازشون پرسیدن آقا چگونه شما متوجه می‌شید که امام شدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 852.99,
   "end": 860.35,
   "text": "مثلا ابا عبدالله در گودی قتلگاه بود، امام سجاد در خیمه گاه پرده خیمه آویخته افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 860.35,
   "end": 862.83,
   "text": "چگونه متوجه شد که امام شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 862.83,
   "end": 865.57,
   "text": "امام رضا در نیشابور، امام جواد در مدینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 865.57,
   "end": 868.71,
   "text": "چگونه حضرت عجیب رمزگشایی کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 868.71,
   "end": 876.81,
   "text": "فرمودن تو اون لحظه یک خشیتی، یک فقری، یک ذلتی نسبت به حضرت حق ما پیدا می‌کنیم که پیش از اون نداشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 876.81,
   "end": 882.55,
   "text": "انتصاب به مقام ولایت با یک خشیت افتاده حالی و ذلت در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 882.55,
   "end": 886.67,
   "text": "حضرت حق است. ان‌شاءالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 886.67,
   "end": 888.51,
   "text": "عاقبتمون ختم به خیر باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 888.51,
   "end": 890.59,
   "text": "به برکت صلوات بر محمد و آل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}