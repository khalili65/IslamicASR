 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 6.16,
   "text": "بسم الله الرحمن الرحیم. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.16,
   "end": 12.1,
   "text": "آیه سه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.1,
   "end": 14.68,
   "text": "در خصوص احکام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.68,
   "end": 17.04,
   "text": "خانم‌ها نکته‌ای عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.04,
   "end": 25.1,
   "text": "خانم‌ها می‌دونید وقتی که نامحرم حضور داشته باشه البته فرق نمی‌کنه چه فرادا باشه چه جماعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.1,
   "end": 28.16,
   "text": "همین که حضور نامحرم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.16,
   "end": 31.18,
   "text": "خانم‌ها حتی نمازهایی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.18,
   "end": 33.54,
   "text": "می‌تونن جهریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.54,
   "end": 37.86,
   "text": "یعنی با صدای بلند اون سوره حمد و سوره رو این‌ها رو بخونن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.86,
   "end": 41.14,
   "text": "اونجا هم باز اجازه ندارن خواهرها فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.14,
   "end": 46.52,
   "text": "با صدای بلند بخونن. مثلا نماز صبح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.52,
   "end": 50.32,
   "text": "مغرب و عشا این‌ها رو می‌تونن بلند بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.32,
   "end": 56.04,
   "text": "البته حتی تکبیرات الاهرامشونو که همیشه در هر نمازی باید بلند بگه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.04,
   "end": 59.2,
   "text": "باز در خصوص خواهرها این نکته رو توجه داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.2,
   "end": 65.38,
   "text": "اگر حضور نامحرم باشد حتی تکبیرات الاهرامشونو نمی‌تونن بلند بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.38,
   "end": 69.86,
   "text": "پس نتیجه می‌گیریم در نماز جماعت که قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.86,
   "end": 73.32,
   "text": "نامحرم هست. در این صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.32,
   "end": 79.64,
   "text": "اصلاً و ابداً خانم‌ها حتی تکبیرات الاهرامشونو هم نباید بلند بگن که نامحرم بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.64,
   "end": 82.06,
   "text": "چه برسه دیگه بقیه .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.06,
   "end": 86.14,
   "text": "اما در خصوص حالا روز میلاد آقامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.14,
   "end": 89.62,
   "text": "امام عسکری صلوات الله علیه هست که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.62,
   "end": 96.1,
   "text": "اون صلوات خواجه نصیر منسوب به خواجه نصیر به حضرت که می‌رسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.1,
   "end": 99.58,
   "text": "عرض می‌کنیم که \"والهيبة العسكرية\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.58,
   "end": 106.12,
   "text": "به‌هرحال این هیبت حالا چه ارتباطی دارد به امام عسکری که نه که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.12,
   "end": 109.56,
   "text": "م-- که نه که نه قطعاً مظهر اتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.56,
   "end": 116.44,
   "text": "همه اسماء جلالیه حضرت حق‌اند، جلالت دارند، عظمت دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.44,
   "end": 119.42,
   "text": "و ه-- لذا هیبت‌شون گل کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.42,
   "end": 126.66,
   "text": "اینچنین که به فرزندشون عرض می‌کنیم شما صاحب هیبت عسکری هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.66,
   "end": 129.62,
   "text": "حالا ما گمان می‌کنیم امام عسکری اگر در یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.62,
   "end": 135.52,
   "text": "کنجی گوشه‌ای در یک خادگان نظامی محصور بودند مثلا دیگه هیبتی نداشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.52,
   "end": 137.88,
   "text": "اتفاقاً اینچنین نیست. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.88,
   "end": 139.98,
   "text": "داستان‌هایی روایاتی بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.98,
   "end": 144.34,
   "text": "همین موضوع وارد شده. من نمی‌خوام داستان برای شما عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.34,
   "end": 147.16,
   "text": "و حکایت بگم موضوع قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.16,
   "end": 153.86,
   "text": "منزل رو ادامه بدیم هدیه کنیم به خود حضرت امام عسکری صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.86,
   "end": 160.1,
   "text": "که دقت بفرمایید چ-- همون‌طور که عرض شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.1,
   "end": 163.82,
   "text": "مراتب طولی نزولیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.82,
   "end": 169.02,
   "text": "اول عالم اله بود بعد عالم عقل بود بعد عالم مثال بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.02,
   "end": 171.42,
   "text": "عالم طبیعت یا ملک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.42,
   "end": 173.58,
   "text": "یا ناسوت یا دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.58,
   "end": 180.1,
   "text": "که ما الان در این نشئه قرار داریم و قراره که انشاالله عروج کنیم و سفر کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.1,
   "end": 183.54,
   "text": "سفر، سفر مثلا اسفار جمع سفره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.54,
   "end": 186.9,
   "text": "سفرهای اربعه. اون ص--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.9,
   "end": 191.52,
   "text": "اهمیت خوندن اینچنین سفرها آماده کردن ما برای اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.52,
   "end": 198.9,
   "text": "دیدار هست. اهمیت رساله لقاء الله علامه یا رساله لقاء اللقائیه ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.9,
   "end": 203.26,
   "text": "همین است که ما رو آماده می‌کنه برای اون سفرها که قراره همه بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.26,
   "end": 208.02,
   "text": "حالا در این طولی که داریم به‌هرحال بحث می‌کنیم مراتب هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.02,
   "end": 213.56,
   "text": "عرض شد اولین فیضی که انسان از خدا اخذ می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.56,
   "end": 216.36,
   "text": "به قلبش نازل می‌شه این فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.36,
   "end": 219.54,
   "text": "که مستحضر هستید اولین رزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.54,
   "end": 222.4,
   "text": "همون فیض رو شما رزق بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.4,
   "end": 225.3,
   "text": "اولین رزق انسان همون وجودشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.3,
   "end": 230.02,
   "text": "وجود. همین که شما وجود پیدا کردی اولین رزق شماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.02,
   "end": 232.96,
   "text": "که البته اگر بخوای به سیر حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.96,
   "end": 236.1,
   "text": "حکمت نظری یا عرفان نظری دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.1,
   "end": 241.66,
   "text": "نمی‌خوام بحث خشک بشه اما توجه داشت-- دارید دیگه مستحضر هستید این بحث‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.66,
   "end": 244.24,
   "text": "کم و بیش گذشته بین ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.24,
   "end": 247.38,
   "text": "از اون ثغ ذات حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.38,
   "end": 252.46,
   "text": "اون ذات خود حضرت حق رو، اون علم ذاتی حضرت حق رو بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.46,
   "end": 255.36,
   "text": "در حقیقت از همون جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.36,
   "end": 259.24,
   "text": "ما یعنی اتصال‌مون، ارتباط‌مون برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.24,
   "end": 261.56,
   "text": "هنوزم که هنوزه به همون جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.56,
   "end": 265.44,
   "text": "که این نحوه ارتباط رو عرض کردیم از قلب کشیده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.44,
   "end": 269.28,
   "text": "لذا فرمود قلب المؤمن عرش الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.28,
   "end": 276.06,
   "text": "فی-- لذا فرمود در اون حدیث قدسی که من هیچ کجا جا نمی‌شه مگر در قلب بنده مؤمنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 276.06,
   "end": 281.0,
   "text": "اینا تداعی از همین قصه دارد که اتصال به اونجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.0,
   "end": 283.5,
   "text": "و این اتصال عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 283.5,
   "end": 290.7,
   "text": "ضعیف می‌شه بر اثر کدورت‌ها و گناهان و این‌ها حتی اصطلاحاً می‌گن م-- قلب، قلب مرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.7,
   "end": 293.14,
   "text": "حیاتش رو از دست داد. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.14,
   "end": 298.26,
   "text": "ا-- مو-- تماماً این اتصال قطع نمی‌شه چون اگر قطع بشه فناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 298.26,
   "end": 302.26,
   "text": "اصلاً دیگه عدمه بهتره بگیم نه فنا، عدمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 302.26,
   "end": 305.72,
   "text": "که نقطه مقابل وجود است و نمی‌شود وجود عدم بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.72,
   "end": 309.5,
   "text": "همیشه ارتباط داریم برای یک حجابی قرار می‌گیرد این حج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.5,
   "end": 314.52,
   "text": "اتصال و ما متوجه این اتصال یا اون اشراقات و القاءات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 314.52,
   "end": 317.1,
   "text": "الهیه نمی‌شویم. خب اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.1,
   "end": 326.3,
   "text": "مرتبه بعدی تنزل رو اگر بخواهیم از ثغ ذات اون بطنان حضرت، اون باطن حضرت که همه ازش-- هیچ‌کس ازش خبر نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.3,
   "end": 329.5,
   "text": "و حتی به نحوه ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.5,
   "end": 332.26,
   "text": "میشه گفت دانایی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 332.26,
   "end": 336.26,
   "text": "در حقیقت ااا اون علم حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.26,
   "end": 340.26,
   "text": "در اون مرتبه نسبت به موجودات همه بی‌خبریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 340.26,
   "end": 345.78,
   "text": "همه بی‌خبرن. اما یه رتبه پایین‌ترش می‌شود ظل اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.78,
   "end": 348.22,
   "text": "ذات یعنی سایه اون ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 348.22,
   "end": 350.86,
   "text": "یا اعیان ثابته بهش می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 350.86,
   "end": 356.96,
   "text": "عین این وجود تو، عین که تو یکی از اعین-- اعیان هستی، عین این وجود تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 356.96,
   "end": 361.26,
   "text": "این عین وجود تو که بالاخره در علم حضرت حق بوده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 361.26,
   "end": 364.01,
   "text": "به اون می‌گن اعیان ثابته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 364.01,
   "end": 367.79,
   "text": "و فیض اول از ذات حضرت حق به اونجا می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.79,
   "end": 370.49,
   "text": "حالا اینکه به اونجا به ذیق لفظه دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.49,
   "end": 376.87,
   "text": "به اون مرتبه. یعنی همه از ذات حضرت حق که فیض رو دریافت می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.87,
   "end": 382.61,
   "text": "می‌شن عین ثابت. یعنی همین عینیت الان شما اما نه به وجود خارجی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 382.61,
   "end": 386.79,
   "text": "به اون وجود تو در ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 386.79,
   "end": 391.11,
   "text": "که همه از اونجا در حقیقت ظهور کردن و بروز کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.11,
   "end": 393.25,
   "text": "به اون می‌گن فیض اقدس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.25,
   "end": 399.09,
   "text": "فیض اقدس که به، به یک عبارت بهش مد هم می‌گن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 399.09,
   "end": 401.21,
   "text": "مد ببخشید ول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 401.21,
   "end": 403.29,
   "text": "م-مد مرتبه‌ی بعدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 403.29,
   "end": 405.37,
   "text": "ول می‌گن. حالا یه آیه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 405.37,
   "end": 408.55,
   "text": "حالا الان که این مد و ول رو گفتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 408.55,
   "end": 412.63,
   "text": "خب چون قبلاً این آیه رو براتون گفته بودیم در وجود منبسط یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 412.63,
   "end": 416.45,
   "text": "در حقیقت صادر اول که همه‌ی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.45,
   "end": 420.85,
   "text": "از اون ظهور کردیم، اون اولین چیزی‌ست که از خدا صادر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 420.85,
   "end": 424.35,
   "text": "اول ما صدر عن الله نه اول ما خلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.35,
   "end": 431.03,
   "text": "عن الله. اولین صاد، اولین چیزی که از خدا صادر شده چندین بار در رابطه با این صحبت کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 431.03,
   "end": 433.77,
   "text": "که یه رتبه مادون‌تر از اون ولّه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 433.77,
   "end": 436.69,
   "text": "ظل همون اعیان ثابته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 436.69,
   "end": 440.61,
   "text": "اولین رتبه‌ی بعد از ذات حضرت حقن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 440.61,
   "end": 444.19,
   "text": "بعد در خارج از ذات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.19,
   "end": 449.79,
   "text": "خوب توجه کنید خارج از ذات حضرت حق یعنی مرحله ظهور و بروز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.79,
   "end": 455.11,
   "text": "ظهور حضرت حقه اولین چیزی که ص-صادر شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 455.11,
   "end": 456.87,
   "text": "می‌شود صادر اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 456.87,
   "end": 459.05,
   "text": "اون مد ولّه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 459.05,
   "end": 463.43,
   "text": "ظل می‌شه اون، ول می‌شه اون یعنی سایه می‌شه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 463.43,
   "end": 466.85,
   "text": "در حقیقت اعیان ثابته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.85,
   "end": 471.49,
   "text": "یا مرتبه‌ی مادون ذات حضرت حق در ذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 471.49,
   "end": 477.83,
   "text": "وقتی ظهور می‌کنی از ذات خارج می‌شی اولین مرتبه رو می‌گن صادر اول بهش می‌گن مد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.83,
   "end": 481.95,
   "text": "یعنی همون سایه که فیض اقدس بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 481.95,
   "end": 484.07,
   "text": "مد الول. آیه‌ی قرآنه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 484.07,
   "end": 487.45,
   "text": "فکر نکنید من دارم از بیرون از قرآن با شما سخن می‌گم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 487.45,
   "end": 490.25,
   "text": "ألم تر آیا نگاه نکردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 490.25,
   "end": 493.83,
   "text": "نگاه نمی‌کنی؟ به چی؟ إلا ربک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.83,
   "end": 498.57,
   "text": "به پروردگار خودت. كيف مد الول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 498.57,
   "end": 501.49,
   "text": "که چگونه مد می‌ده به ول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 501.49,
   "end": 504.45,
   "text": "ول اون فیض اقدس بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 504.45,
   "end": 509.25,
   "text": "اون وجود عین شما در ذات حضرت حق که بهش می‌گن اعیان ثابته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.25,
   "end": 512.29,
   "text": "بالاخره ما در ذات خدا بودیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.29,
   "end": 515.69,
   "text": "بعد وقتی میای بیرون از وجود حق یعنی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 515.69,
   "end": 519.93,
   "text": "خارج، بیرون از ذات حضرت حق یعنی در خارج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 519.93,
   "end": 523.43,
   "text": "بهش می‌گن مد یعنی کشیده شدن همون ول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.43,
   "end": 526.27,
   "text": "قرآن داره می‌گه مد الول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 526.27,
   "end": 528.55,
   "text": "که به این می‌گن فیض مقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 528.55,
   "end": 533.19,
   "text": "حالا فرق بین مق-- فیض مقدس با اقدس مشخص شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 533.19,
   "end": 539.29,
   "text": "خب بعد دیگه بعد ز-- دیگه این مد الول می‌شه صادر اول که از اون بیست و هشت گانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 539.29,
   "end": 547.45,
   "text": "اون خلائقه، خلائقه بیست و هشت گانه دیگه اینجا صادرات نیستن، خلائق ظهور کردن که یکی شمایی، یکیش انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 547.45,
   "end": 549.39,
   "text": "حالا این مراتب رو عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.39,
   "end": 552.07,
   "text": "وقتی که می‌خواد همینطوری سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.07,
   "end": 559.21,
   "text": "نزولی پیدا کنه میاد مرتبه‌ی بعدی از این حالت قلبی که الان بحث کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 559.21,
   "end": 563.97,
   "text": "متصل می‌شه به رتبه‌ی عقل انسان، عقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.97,
   "end": 568.27,
   "text": "مرتبه‌ی عقل و از عقل تنزل پیدا می‌کنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 568.27,
   "end": 570.31,
   "text": "مرتبه‌ی خیال و بعد طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 570.31,
   "end": 572.67,
   "text": "یعنی این سلسله همینطوری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.67,
   "end": 576.83,
   "text": "حالا اگر کسی گناه کنه اصطلاحاً بگیم آقا حیا-- می‌گن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 576.83,
   "end": 579.49,
   "text": "حیات قلبش از-- قلبش مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 579.49,
   "end": 585.63,
   "text": "این چه اتفاقی افتاده؟ غبار و حجاب اومده رو این سلسله طولی و ارتباط رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 585.63,
   "end": 588.03,
   "text": "مثل اینکه شعاع نور هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 588.03,
   "end": 594.41,
   "text": "تو عینک سیاه زدی به چشمت، دودی زدی نور رو نمی‌بینی، داری تاریک می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 594.41,
   "end": 597.09,
   "text": "تو داری چشمت تاریک می‌بینه نه که اتصال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 597.09,
   "end": 601.17,
   "text": "نور نیست. این ارتباط اتصال برقراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 601.17,
   "end": 603.61,
   "text": "و این حیات قلب تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 603.61,
   "end": 606.75,
   "text": "بر اثر حجاب در یک حالتی قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 606.75,
   "end": 610.85,
   "text": "اصطلاحاً بهش می‌گن ذیق. در علم اخلاق می‌گن ذیق شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 610.85,
   "end": 613.85,
   "text": "یعنی مضطرب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 613.85,
   "end": 616.31,
   "text": "نه مضطرب. مضطرب خوبه، مضطرب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 616.31,
   "end": 619.63,
   "text": "قبلاً بحثش گذشته. که بر اثر گناهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 619.63,
   "end": 623.27,
   "text": "اینجا حالا فقه میاد می‌گه آقا شرع دین می‌آد آقا این، این، این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.27,
   "end": 628.45,
   "text": "اینا تو رو در حجاب قرار می‌ده یا قلب تو رو، اون اتصالت رو در حجاب قرار می‌ده انگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 628.45,
   "end": 633.07,
   "text": "که تو عینک دودی زدی اتصالو متوجه نمی‌شی لذا اشراقات هم نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 633.07,
   "end": 636.59,
   "text": "اتصال هست، تو دریافتی نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 636.59,
   "end": 638.41,
   "text": "تو رزقت بهت نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 638.41,
   "end": 642.27,
   "text": "نه که تنزل نیست. فیض دائماً در حال نزوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 642.27,
   "end": 647.41,
   "text": "اون فیض از فیض اقدس بگیر تا مقدس همینطوری در حال فورانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.41,
   "end": 649.59,
   "text": "کل يوم هو في شأن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 649.59,
   "end": 652.09,
   "text": "يوم هم که ظرف ظهور اشیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 652.09,
   "end": 655.27,
   "text": "دائماً داره خدا ظهور می‌کنه حتی در تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.27,
   "end": 658.43,
   "text": "بر تو، در تو، به سوی تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 658.43,
   "end": 660.37,
   "text": "برای تو. دائماً در فیضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 660.37,
   "end": 663.77,
   "text": "یعنی فیضش رو عن-- از انواع و اقسام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 663.77,
   "end": 667.45,
   "text": "رزق‌ها بهتره رزق بگیم، داره می‌ریزه تو سر تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 667.45,
   "end": 671.07,
   "text": "تو بستی وجودت رو با گناه حجاب شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 671.07,
   "end": 679.25,
   "text": "این حجاب بعد این اگر کسی این کارو کرد هر چقدر این مرتبه شدت بگیره تنزل پیدا می‌کنه از اون مرتبه انسانیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 679.25,
   "end": 683.29,
   "text": "و قلب که رتبه انسانی ما قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 683.29,
   "end": 685.71,
   "text": "تنزل پیدا می‌کنه به عقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 685.71,
   "end": 689.99,
   "text": "عقل مشوب به وهم همینطوری دیگه حیوانات هم دارن اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 689.99,
   "end": 692.41,
   "text": "وهم دارن. وهم حیوانات دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 692.41,
   "end": 695.17,
   "text": "این تنزل کرده. می‌گه بلهم ازل مثل حیواناتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 695.17,
   "end": 699.13,
   "text": "چرا؟ چون قلبش محجوب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 699.13,
   "end": 701.07,
   "text": "ع-عقلش هم مشوب به وهم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 701.07,
   "end": 703.69,
   "text": "نمی‌تونه درست فکر کنه. حیوانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 703.69,
   "end": 705.97,
   "text": "بلهم ازل یعنی اصلاً جماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 705.97,
   "end": 711.55,
   "text": "یعنی دیگه از وهم و از اون خیال و وهم هم سقوط کرده صرفاً جماده، سنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 711.55,
   "end": 718.31,
   "text": "اصلاً هیچ احساسی نداره. این آیه قرآن رو ببین حالا این سلسله طولی رو ببین چجوری با هم مرتبط‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 718.31,
   "end": 720.99,
   "text": "که حالا یه هدیه هم به شما تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 720.99,
   "end": 728.5,
   "text": "قبل از این هدیه یه روایتی رو برای شما بگم ببینید اهل بیت چگونه این حقایق سنگینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 728.5,
   "end": 731.14,
   "text": "حالا به قول ما عرفانی یا حکمی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 731.14,
   "end": 736.88,
   "text": "در قالب الفاظ خاکی به مردم یاد میدادن چاره‌ای هم نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 736.88,
   "end": 739.72,
   "text": "پیغمبر تو مسجد نشسته-- به این روایتو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 739.72,
   "end": 744.2,
   "text": "ببینید پیغمبر این حقایق عرشی رو چگونه بیان کرده برای اون مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 744.2,
   "end": 747.46,
   "text": "ولی بیان کرده. تو مسجد نشسته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 747.46,
   "end": 752.16,
   "text": "یه صدای مهیبی اومد، وحشتناک و همه ترسیدن، لرزیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 752.16,
   "end": 757.58,
   "text": "پیغمبر فرمود هفتاد سال پیش سنگی، سنگ نشانه جماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 757.58,
   "end": 760.02,
   "text": "سنگی سقوط کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 760.02,
   "end": 763.78,
   "text": "به جهنم. بعد از هفتاد سال الان به ته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 763.78,
   "end": 771.56,
   "text": "جهنم رسید و این صدای برخورد اون سنگ به اعماق یا اون اسفل السافلین حالا عمق جهنم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 771.56,
   "end": 773.28,
   "text": "همه حالا تعجب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 773.28,
   "end": 775.54,
   "text": "عجب که اینام شنیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 775.54,
   "end": 778.24,
   "text": "حالا اینجا میرداماد علیه الرحمه میاد میگه بب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 778.24,
   "end": 781.1,
   "text": "ببخشیدا شما یه وقت نرید این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 781.1,
   "end": 788.5,
   "text": "در حقیقت شنیدن این‌ها رو ببرید رو اینکه پیغمبر معجزه‌ش رو گوشه روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 788.5,
   "end": 790.3,
   "text": "صدای اون سنگ پیاده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 790.3,
   "end": 796.6,
   "text": "میرداماد میگه نگید که صدای اون سنگ اینکه این صدا بلند شده معجزه‌ی پیغمبر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 796.6,
   "end": 803.56,
   "text": "نه. معجزه‌ی پیغمبر رو گوش مردم پیاده شده که اونا بشنون و الا این صدا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 803.56,
   "end": 808.36,
   "text": "که این‌ها بشنون. حالا بعد پ-- رفتن از مسجد بیرون دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 808.36,
   "end": 810.32,
   "text": "در یه خونه‌ای داد و فریاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 810.32,
   "end": 813.58,
   "text": "چه خبره؟ گفتن فلانی از دنیا همین الان رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 813.58,
   "end": 818.28,
   "text": "یه کافر، یه منافقی بود که هفتاد سالشم بود دقیقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 818.28,
   "end": 820.54,
   "text": "همون لحظه از دنیا رفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 820.54,
   "end": 828.44,
   "text": "حالا پیغمبر خصوصی به اون کسایی که درک و فهمش رو داشتن این حقیقت عرشی رو باز کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 828.44,
   "end": 830.02,
   "text": "که این همونه. همون سنگ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 830.02,
   "end": 832.18,
   "text": "چرا سنگه؟ مگه انسان نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 832.18,
   "end": 834.84,
   "text": "نزول کرده به مرتبه جمادیه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 834.84,
   "end": 838.76,
   "text": "هفتاد سال پیش قعر جهنم سقوط کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 838.76,
   "end": 841.0,
   "text": "یعنی رفت به درک. داره همینطوری میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 841.0,
   "end": 843.48,
   "text": "از خدا داره دور می‌شه. الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 843.48,
   "end": 845.62,
   "text": "رسید به ته جهنم. یعنی مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 845.62,
   "end": 850.0,
   "text": "تموم شد. این پیغمبر تعبیر می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 850.0,
   "end": 853.06,
   "text": "از این منافق به سنگ، به جماد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 853.06,
   "end": 854.86,
   "text": "چرا؟ تنزل پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 854.86,
   "end": 857.16,
   "text": "حقیقتش از اون مرتبه قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 857.16,
   "end": 859.92,
   "text": "اومده به مرتبه جمادی حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 859.92,
   "end": 862.6,
   "text": "نه عقلی و نه خیالی حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 862.6,
   "end": 865.12,
   "text": "جماد. سنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 865.12,
   "end": 870.44,
   "text": "یعنی کاملا نزول. این هدیه‌ای که می‌خواستم بهتون بگم خواهشا ارزششو بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 870.44,
   "end": 874.48,
   "text": "حضرت علامه حسن زاده فرمودن برای حیات قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 874.48,
   "end": 878.0,
   "text": "برای حیات قلب و اون حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 878.0,
   "end": 885.58,
   "text": "معنوی قلب یعنی اتصال شدید بشه، شدت بگیره، رزا-- اشتداد وجودی پیدا کنی، هی وجود رو وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 885.58,
   "end": 888.36,
   "text": "رزقتو بگیری اینطوری بگم. هی رزقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 888.36,
   "end": 895.98,
   "text": "ااا مانعی نباشه برای رسیدن و اخذ فیض و رزق که انواع و اقسام رزق هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 895.98,
   "end": 899.44,
   "text": "این ذکر رو فرمودن اکثارش، اکثار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 899.44,
   "end": 902.28,
   "text": "خود حضرت علامه فرمودن اکثار این ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 902.28,
   "end": 907.6,
   "text": "نه مثلا همینطوری بگی به بعضی موقع دلخوشی، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 907.6,
   "end": 910.74,
   "text": "اکثار. زیاد. در وزن افعال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 910.74,
   "end": 912.92,
   "text": "که بگی. چی بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 912.92,
   "end": 915.6,
   "text": "\"یا حی یا قیوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 915.6,
   "end": 919.22,
   "text": "یا من لا اله الا انت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 919.22,
   "end": 922.78,
   "text": "حالا چ-- این ذکر رو بعد ایشون باز می‌کنند در شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 922.78,
   "end": 926.38,
   "text": "فصوص، در شرح فصوص القیسری این ذکر رو باز می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 926.38,
   "end": 929.26,
   "text": "ایشون توضیح میدن یا حی یا قیوم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 929.26,
   "end": 933.18,
   "text": "یا من لا اله الا انت یعنی حالا خیلی شریف، شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 933.18,
   "end": 935.52,
   "text": "پس یه بار دیگه میگم و شما رو به خدا میسپارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 935.52,
   "end": 938.34,
   "text": "ان شا الله امام عسکری از ما قبول کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 938.34,
   "end": 940.44,
   "text": "و از ما بپذیره همین قلیل رو.",
   "kind": "speech",
   "chapter": null,
