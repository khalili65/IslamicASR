 ],
 "cues": [
  {
   "i": 0,
   "start": 1.88,
   "end": 5.88,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.88,
   "end": 10.48,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.48,
   "end": 14.88,
   "text": "در خصوص احکام جماعت عرض می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.88,
   "end": 17.24,
   "text": "خب می‌دونید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.24,
   "end": 21.06,
   "text": "مستحب است بعد از اتمام سوره حمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.06,
   "end": 24.76,
   "text": "انسان بگوید الحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.76,
   "end": 28.6,
   "text": "حالا چه خودش داره نماز می‌خونه چه در جماعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.6,
   "end": 32.1,
   "text": "دیروز عرض کردیم که وقتی امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.1,
   "end": 38.36,
   "text": "در وضع جهر است یعنی ذکرش رو داره به جهر میگه نه اخفات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.36,
   "end": 43.14,
   "text": "ما وظیفه‌مون استماع حمد و سوره‌ای که داره می‌خونه به جهر مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.14,
   "end": 44.84,
   "text": "ص-صبح و مغرب و عشا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.84,
   "end": 50.16,
   "text": "ما وظیفه‌مون استماع گوش باید بدیم، حرف نباید بزنیم، ذکر نباید بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.16,
   "end": 54.88,
   "text": "و وقتی که در حال اخ-اخفات مثل ظهر و عصر می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.88,
   "end": 58.64,
   "text": "ذکر مطلق بگیم رجوعاً اونم نه به قصد ورود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.64,
   "end": 60.8,
   "text": "خب حالا الان که امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.8,
   "end": 63.3,
   "text": "و لضالین رو گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.3,
   "end": 69.06,
   "text": "ما می‌تونیم فرصت داریم بگیم الحمد لله رب العالمین به همون نیت که مستحبه وروده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.06,
   "end": 73.9,
   "text": "یعنی اینجا اصلاً دیگه ذکر مطلق هم نیست وروده یعنی اهل بیت دستور دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.9,
   "end": 79.62,
   "text": "خب حالا بعدش بلافاصله و لضالین رو که گفت امام تأمل نمی‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.62,
   "end": 83.04,
   "text": "که ما الحمد لله بگیم شروع می‌کنه بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.04,
   "end": 86.02,
   "text": "سوره حمد رو گفتن و ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.02,
   "end": 89.42,
   "text": "آره اینجا خب امام داره ذکر میگه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.42,
   "end": 95.04,
   "text": "خب اینجا وظیفه ما الا-- اگه بلافاصله امام شروع کرد بسم الله وظیفه ما باز سکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.04,
   "end": 101.6,
   "text": "اما دیدیم تا و لضالین رو گفت من شروع کردم الحمد لله یه دفعه امام هم بسم الله‌شو گفت اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.6,
   "end": 105.3,
   "text": "توجه کردید اینجا اشکال نداره که توأمان شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.3,
   "end": 108.68,
   "text": "چون شما تا و لضالین رو گفت سکوته امام الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.68,
   "end": 113.86,
   "text": "شروع کردم و الحمد لله اگه بسم الله‌شو شروع کرده نباید بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.86,
   "end": 116.54,
   "text": "اما تا و لضالین رو گفت تموم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.54,
   "end": 119.02,
   "text": "من الان فرصت دارم سکوت امامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.02,
   "end": 127.98,
   "text": "می‌تونم بگم الحمد لله حالا در اثنای الحمد لله رب العالمین من امام بسم الله سوره‌ش رو گفت اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.98,
   "end": 131.56,
   "text": "اما بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.56,
   "end": 134.68,
   "text": "منزل یا محل نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.68,
   "end": 140.1,
   "text": "یا فرودگاه به عبارتی محل فرود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.1,
   "end": 146.06,
   "text": "عرض کردیم آیه نود و هفت بقره که قل من کان عدواً لجبرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.06,
   "end": 149.14,
   "text": "فإنه نزله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.14,
   "end": 155.18,
   "text": "یعنی خدای منان از علم اهدی خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.18,
   "end": 157.86,
   "text": "به وساطت جبرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.86,
   "end": 162.4,
   "text": "به علم واحدی خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.4,
   "end": 165.22,
   "text": "نازل کرد چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.22,
   "end": 168.1,
   "text": "علم رو، وحی رو که وحی همون علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.1,
   "end": 171.46,
   "text": "علم خداست. علی قلبک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.46,
   "end": 177.58,
   "text": "حالا این علی قلبک به قلبک نیست، فی قلبک نیست، علی قلبک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.58,
   "end": 180.88,
   "text": "یعنی از مراتب سلسله مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.88,
   "end": 183.14,
   "text": "تجلیات الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.14,
   "end": 188.8,
   "text": "در قوس النزول اینطوری بگیریم از بالا تنزل پیدا کرده به نحو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.8,
   "end": 192.0,
   "text": "تجلی نه تجافي که می‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.0,
   "end": 200.06,
   "text": "پس اینجا حالا این رو دقت بفرمایید یه جمله‌ای رو از حضرت علامه که البته بسیاری از حکما فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.06,
   "end": 206.04,
   "text": "که از ذیل روایات و آیات استخراج شده که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.04,
   "end": 212.8,
   "text": "انسان رو به وزان خودش در ذات و صفات و افعال آفریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.8,
   "end": 218.52,
   "text": "یعنی هم مثال می‌زنم همونطور که خدای منان به عنوان نمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.52,
   "end": 224.36,
   "text": "دانن فی علوه و علوهی یا عالن فی علوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.36,
   "end": 227.7,
   "text": "یکی از اسماء خداست توی جوشن می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.7,
   "end": 237.56,
   "text": "یا عالن فی دونوه تو اون بالایی حالا تنزیهاً تو اون بالایی در حالی که علوه دونوه پایین هم هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.56,
   "end": 244.18,
   "text": "یعنی این در حقیقت این مراتب تجافي نیست که اون بالا باشی این پایین نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 244.18,
   "end": 249.54,
   "text": "یا عالن فی دونوه در حالی که پایینی بالا هم هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 249.54,
   "end": 253.58,
   "text": "یا دانن فی علوه در حالی که پایینی بالا هم هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 253.58,
   "end": 259.18,
   "text": "انسان هم این چنینه. انسان هم در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 259.18,
   "end": 261.38,
   "text": "دونه یا دانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 261.38,
   "end": 264.2,
   "text": "چگونه دانه؟ جسمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 264.2,
   "end": 266.22,
   "text": "جسمت الان مربوط به نشئه طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.22,
   "end": 268.96,
   "text": "انزل مراتب وجود طبیعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 268.96,
   "end": 272.0,
   "text": "جسم فعلاً کاری به بدن نداریم ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.0,
   "end": 274.64,
   "text": "که این جسم الان به یک معنا بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.64,
   "end": 281.12,
   "text": "طبیعی شماست و الا بدن پشت بدن ما همینطور داریم و انشا هم می‌تونیم بکنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 281.12,
   "end": 284.78,
   "text": "و بدن برزخی، بدن حالا مثالی، عقلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.78,
   "end": 291.36,
   "text": "همینطور برو. بدن در طول این ابدان در طول هم‌ان، تفاوت در نقص و کمال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.36,
   "end": 295.1,
   "text": "یعنی این بدن، این بدن جسمی و طبیعی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.1,
   "end": 298.16,
   "text": "در طول همون بدن برزخی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.16,
   "end": 302.28,
   "text": "لذا شما تو خواب وقتی خودتو می‌بینی شبیه همین جسم الانت می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.28,
   "end": 305.44,
   "text": "اگرچه اون بدن برزخیت این بدن طبیعیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.44,
   "end": 308.2,
   "text": "در طول هم‌ان اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.2,
   "end": 311.98,
   "text": "احکامشون متفاوته. تفاوت در نقص و کماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.98,
   "end": 316.72,
   "text": "این بدن ب-دنیوی نسبت به بدن برزخیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.72,
   "end": 318.98,
   "text": "ناقص‌تره یعنی ناقصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.98,
   "end": 323.06,
   "text": "همینطور در-- و الا در طول هم‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.06,
   "end": 325.94,
   "text": "خب بحث اینجا بود که شما هم اینطوری هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.94,
   "end": 329.56,
   "text": "ما هم از ی-- به یک معنا این شکلی هستیم یعنی در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.56,
   "end": 335.6,
   "text": "بدن داریم و بدن مربوط به انزل مراتب عالم است این می‌شه دانن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 335.6,
   "end": 337.58,
   "text": "دانن انزل مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.58,
   "end": 339.86,
   "text": "فی علوهی. چگونه علوهی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 339.86,
   "end": 342.42,
   "text": "چون قلب داری. رسیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.42,
   "end": 344.28,
   "text": "نکته سر خط. چون قلب داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.28,
   "end": 349.98,
   "text": "اون ذاتت، اون قلبت محل تجلیات حضرت حق یا به عبارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.98,
   "end": 353.04,
   "text": "حالا شما اینجا خیلی دقت به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.04,
   "end": 356.28,
   "text": "اختلافات بین حکما نکنید که بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.28,
   "end": 358.48,
   "text": "حالا مثلاً میان میگن قلب همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.48,
   "end": 360.44,
   "text": "سره یا سر سره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.44,
   "end": 364.84,
   "text": "بعضیا میگن نه بعد از قلب تازه یه مرتبه پنهان‌تر داریم به نام روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.84,
   "end": 370.38,
   "text": "فعلاً شما قلب رو همون سر یا همون سر رو سر یا خفی و اخفی یا همون روح بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.38,
   "end": 375.96,
   "text": "به این معنا داریم بحث می‌کنیم. یعنی همون جان تو، ذات تو، ذات تو بهتره بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 375.96,
   "end": 380.48,
   "text": "که حالا مربوط است حالا اونچه که تو اخذ می‌کنی از عالم از حقایق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.48,
   "end": 384.5,
   "text": "د-در، در حقیقت ثغر ذات تو می‌نشینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 384.5,
   "end": 388.18,
   "text": "در اون کمون ذاتت، در اون بطنان ذاتت اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 388.18,
   "end": 391.6,
   "text": "حالا اینا رو قلب می‌گیریم، قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 391.6,
   "end": 396.52,
   "text": "که این عالی‌ترین مرتبه‌ی وجود انسان، عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 396.52,
   "end": 404.4,
   "text": "خب و آنچه که شما الان به لسانت جاری می‌شه، لسان، این لسان خاکی جسمی مربوط به انزل مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 404.4,
   "end": 411.36,
   "text": "از کجا اومده به اینجا؟ اون حقیقتی که الان بر لسان تو داره تکلم می‌شه و جاری می‌شه این الفاظ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 411.36,
   "end": 415.14,
   "text": "این الفاظ، این صوت، کم و کیف مسموع اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 415.14,
   "end": 417.86,
   "text": "همه چی‌ان؟ اعراضن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.86,
   "end": 423.24,
   "text": "یعنی مربوط به عالم نشئه طبیعتن، انزل مراتبن، مال ماده‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 423.24,
   "end": 428.9,
   "text": "خب این صوت مجرد که نیست اما از عالم مجردات تنزل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.9,
   "end": 431.7,
   "text": "از روح تو، از قلب تو، از ذات تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 431.7,
   "end": 439.6,
   "text": "اون چیزی که الان شما می‌خوای بگی بالاخره در حقیقت ذات وجودیت هست یا نه الان می‌خوای بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 439.6,
   "end": 442.82,
   "text": "این حقیقتی که می‌خوای الان بیان کنی از کجا اومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 442.82,
   "end": 445.82,
   "text": "شبیه کلمات بر لسان تو جاری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 445.82,
   "end": 448.16,
   "text": "عین این حقیقتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.16,
   "end": 451.88,
   "text": "به صورت بسیط و اهدی و جمعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 451.88,
   "end": 455.34,
   "text": "در ذات وجود تو، در اون بطنان وجود تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 455.34,
   "end": 457.2,
   "text": "که حالا ما می‌گیریم قلب وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 457.2,
   "end": 463.76,
   "text": "تنزل پیدا کرده اومده به این شکل خودش رو نشون داده که الان من دارم با شما صحبت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 463.76,
   "end": 470.44,
   "text": "و الا حقیقت به صورت اهدی و بسیط در جان منه، در قلب منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.44,
   "end": 473.62,
   "text": "در حقیقت من مراتبم، ذو مراتبم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 473.62,
   "end": 477.1,
   "text": "مرتبه‌ی عالی دارم، مرتبه‌ی دانی هم دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 477.1,
   "end": 482.88,
   "text": "همینطوره. اصلاً اینکه میگن خدای من اینا خیلی مهمه که ما اینا رو بدونیم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 482.88,
   "end": 487.32,
   "text": "حضرت علامه می‌فرماید نزدیک‌ترین راه به خدا م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 487.32,
   "end": 490.7,
   "text": "از طریق خودته. یعنی معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 490.7,
   "end": 494.9,
   "text": "معرفت نفس اصلاً انفع المعارفه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 494.9,
   "end": 500.74,
   "text": "چقدر امیرالمؤمنین فرمود، پیغمبر فرمود \"من عرف نفسه فقد عرف ربه.\" چقدر فرمودن، چقدر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 500.74,
   "end": 503.24,
   "text": "اصلاً شما پیدا نمی‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 503.24,
   "end": 505.84,
   "text": "کتاب‌های معارفی حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 505.84,
   "end": 514.16,
   "text": "استاد کل عزیز دلمون آقای حسن زاده رو که درش چیزی پیرامون معرفت نفس نباشه، اصلاً نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 514.16,
   "end": 519.38,
   "text": "یکی بحث توحید و وجود حضرت حق، وجود صمدی حضرت حق، یکی هم بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 519.38,
   "end": 521.3,
   "text": "نفس‌شناسی، خودت رو بشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 521.3,
   "end": 526.88,
   "text": "اصلاً موج می‌زنه تو سرتاسر کتاب‌های علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 526.88,
   "end": 530.54,
   "text": "نزدیک‌ترین راه ما به سوی خدا از طریق خودمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 530.54,
   "end": 534.4,
   "text": "و ما به خودمون از هر کسی نزدیک‌تریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 534.4,
   "end": 542.98,
   "text": "خب اینا شناخت خوده. اینکه خدا ما رو از حیث ذات و صفات و افعال به وزان خودش آفریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 542.98,
   "end": 551.62,
   "text": "حالا یه مثال الان زدیم. ذات برمی‌گرده اینکه ما به وزان ذات حضرت حق، یعنی برمی‌گرده این معر-- مقام قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 551.62,
   "end": 556.68,
   "text": "اینکه ذات ما به وزان ذات حضرت حق است مقام قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 556.68,
   "end": 558.72,
   "text": "مقام قلب حوزه‌ی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 558.72,
   "end": 561.7,
   "text": "حقایق است. معارف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 561.7,
   "end": 565.08,
   "text": "به یک عبارت می‌شه گفت نور علوم است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 565.08,
   "end": 569.46,
   "text": "نور علوم. بسیط الحقیقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 569.46,
   "end": 571.6,
   "text": "یعنی حالا این معنای بسیط و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 571.6,
   "end": 575.04,
   "text": "اهدی چه فر-فرقی با واحدیت می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 575.04,
   "end": 578.92,
   "text": "بعداً می‌گیم اینکه در لسان تو جاری شد واحدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 578.92,
   "end": 583.52,
   "text": "اون که در حقیقت و ذات تو هست، اون واحد-- اون اهدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 583.52,
   "end": 585.98,
   "text": "حالا اینا رو توضیح میدیم که تو اینا رو باید بدونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 585.98,
   "end": 590.02,
   "text": "داری همش هر روز داری تو سوره قل هوالله احد میگی قل هوالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 590.02,
   "end": 591.86,
   "text": "کدوم الله؟ قل بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 591.86,
   "end": 593.74,
   "text": "کد-- کیو، چی، چی بگم اصلاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 593.74,
   "end": 595.46,
   "text": "بگو هو. کدوم هو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 595.46,
   "end": 598.42,
   "text": "الله. کدوم الله؟ احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 598.42,
   "end": 602.16,
   "text": "خب ما باید بدونیم اهدیه چیه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 602.16,
   "end": 605.86,
   "text": "فرقش با واحدیت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 605.86,
   "end": 609.86,
   "text": "خب حالا اینکه ما در ذات به وزان حضرت حظ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 609.86,
   "end": 612.14,
   "text": "حضرت حق هستیم مقام قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 612.14,
   "end": 617.04,
   "text": "ببین جایگاه و محل نزول تمام حقایق قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 617.04,
   "end": 621.4,
   "text": "محل اتصال ما با الهیت نظام هستی، با حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 621.4,
   "end": 624.06,
   "text": "یعنی اهدیه ما به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 624.06,
   "end": 631.06,
   "text": "یا بهتره بگیم حالا تو این مثالی که الان زدیم واحدیت ما به اهدیه خودمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 631.06,
   "end": 634.2,
   "text": "اهدیه ما به واحدیت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 634.2,
   "end": 636.98,
   "text": "و برو تا اهدیه حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 636.98,
   "end": 641.22,
   "text": "قلب ماست. قلب خیلی جایگاه مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 641.22,
   "end": 645.7,
   "text": "لذا اونچه که ملائکه بو می‌کنند، میگن میت رو می‌ذارن توی قبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 645.7,
   "end": 649.54,
   "text": "ملائکه میرن سینه‌شو بو می‌کنند، سینه این جسم خاکی رو بو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 649.54,
   "end": 651.58,
   "text": "اصلاً قبر که اون تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 651.58,
   "end": 653.66,
   "text": "قبر فقیه خاک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 653.66,
   "end": 661.48,
   "text": "حالا اعتبارا به لحاظ ایمان و انسان و شرافت انسان میگن دفنش کن و الا اون که قبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 661.48,
   "end": 664.28,
   "text": "ااا فلسفی و حکمتی ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 664.28,
   "end": 667.18,
   "text": "قبر عرفانی یا قلب، قبر حقیقی ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 667.18,
   "end": 669.88,
   "text": "اون قبر فقیه مال مشع طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 669.88,
   "end": 671.94,
   "text": "جسم چون از نون و آبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 671.94,
   "end": 675.36,
   "text": "و از نطفه است، می‌ره برمی‌گرده به چرخه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 675.36,
   "end": 678.5,
   "text": "و الا اون قبر اصلی همون ورود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 678.5,
   "end": 681.02,
   "text": "جان ما به باطن عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 681.02,
   "end": 686.84,
   "text": "اون قبره. اونجا میگن سینه رو بو می‌کنند، یعنی قلبو بو می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 686.84,
   "end": 690.42,
   "text": "که قلب تو چه بویی می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 690.42,
   "end": 694.76,
   "text": "ریح قلب تو به چه صورته، چه نسیمی از قلبت بلند می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 694.76,
   "end": 697.46,
   "text": "اصلاً ملائکه میان دم می‌زنن به تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 697.46,
   "end": 700.48,
   "text": "چطور تو می‌خوای یه چیز رو بو کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 700.48,
   "end": 704.54,
   "text": "مثلاً تربت سید و شهدا رو که می‌گیری یه صلوات می‌فرستی بعد هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 704.54,
   "end": 709.66,
   "text": "دم می‌زنی هو. دم می‌زنی در تربت ببین بازدم چه بویی می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 709.66,
   "end": 712.7,
   "text": "ملائکه میان دم می‌زنن در تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 712.7,
   "end": 716.66,
   "text": "به عبارتی، به عبارتی می‌شه گفت نفخ می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 716.66,
   "end": 718.76,
   "text": "می‌کشند نفس تو رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 718.76,
   "end": 721.8,
   "text": "نسیم تو رو می‌کشند. نفخت فیهم روحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 721.8,
   "end": 724.36,
   "text": "نفخ. یه فخ داریم یه نفخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 724.36,
   "end": 727.88,
   "text": "اینا فرق می‌کنند با هم. می‌کشند ببینند بازدمش چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 727.88,
   "end": 730.9,
   "text": "nefsi که اونا می‌زنن بازدم قلب تو چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 730.9,
   "end": 732.62,
   "text": "قلبتو یعنی جانتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 732.62,
   "end": 736.27,
   "text": "نه این سینه خاکی که خاک شد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 736.27,
   "end": 740.49,
   "text": "این به وزان ذات حضرت حق شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 740.49,
   "end": 745.37,
   "text": "آدم وقتی اینطوری نگاه می‌کنه خودش رو تو آینه‌ی حضرت حق می‌بینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 745.37,
   "end": 751.45,
   "text": "تو آینه‌ی ملائکه، در آینه‌ی ملکات، در آینه‌ی مجردات، در آینه‌ی حجت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 751.45,
   "end": 755.77,
   "text": "خودش رو می‌بینه، میگه اصلاً من چرا باید اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 755.77,
   "end": 758.45,
   "text": "غافل باشم؟ چرا باید گناه کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 758.45,
   "end": 763.77,
   "text": "چرا باید دچار اهانت نفس بشم که \"من هانت علیه نفس فلا تأمن شره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 763.77,
   "end": 768.17,
   "text": "کسی که دچار اهانت نفس شد از شرش ایمن مباش چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 768.17,
   "end": 773.61,
   "text": "و از جهت حالا پس بحث ذات و این‌ها که مقام قلب است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 773.61,
   "end": 776.77,
   "text": "می‌شه محل نزول حقایق یا علوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 776.77,
   "end": 779.21,
   "text": "معارف. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 779.21,
   "end": 782.21,
   "text": "که اون نفس ما رو می‌سازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 782.21,
   "end": 784.61,
   "text": "شکل می‌ده به جان ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 784.61,
   "end": 789.13,
   "text": "مثل این‌که الان نفس ما یه شکلی داره که این بدن ما سایه‌ی اون است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 789.13,
   "end": 793.55,
   "text": "اون ور هم نفس ما یه شکلی داره که بدن برزخی ما سایه‌ی اون است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 793.55,
   "end": 797.51,
   "text": "نفس ما به شکل معارف ماست، به شکل قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 797.51,
   "end": 799.79,
   "text": "قلب ما وضعیتش چگونه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 799.79,
   "end": 802.29,
   "text": "جان ما، نفس ما اون شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 802.29,
   "end": 808.55,
   "text": "ما الان به وسیله‌ی معارف، اعتقادات، علوم، نور علم هرچی اخذ می‌کنیم داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 808.55,
   "end": 810.49,
   "text": "شکل نفس‌مون رو می‌سازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 810.49,
   "end": 816.89,
   "text": "دادن دست خودمون داریم می‌دمیم در اون کوزه وجودمون شکل بهش می‌دیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 816.89,
   "end": 819.41,
   "text": "در اون جان وجودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 819.41,
   "end": 824.03,
   "text": "اما خب ذات و صفات و افعال اینا کجان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 824.03,
   "end": 826.95,
   "text": "صفات برمی‌گرده به جوهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 826.95,
   "end": 830.11,
   "text": "صفات، صفات برمی‌گرده به جوهر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 830.11,
   "end": 831.87,
   "text": "به اخلاق انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 831.87,
   "end": 834.89,
   "text": "ببخشید صفات برمی‌گرده به اخلاقیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 834.89,
   "end": 837.39,
   "text": "اینجا جایگاه علم اخلاق مشخص می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 837.39,
   "end": 843.03,
   "text": "علم اخلاق که انسان خلق و خو و منش‌ش چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 843.03,
   "end": 849.01,
   "text": "به عبارتی می‌شه گفت میل اون جانش، میل قلبش به چه سمته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 849.01,
   "end": 852.11,
   "text": "میل ق-قلبش-- می‌گن لیلة الرغائب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 852.11,
   "end": 854.33,
   "text": "شب رغبت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 854.33,
   "end": 856.49,
   "text": "به چی میل داری؟ به چی رغبت داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 856.49,
   "end": 859.29,
   "text": "بسم الله. وقتی هم که می‌میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 859.29,
   "end": 863.71,
   "text": "نسبت به میل و رغبتت برات آماده می‌شه فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 863.71,
   "end": 867.79,
   "text": "ر-- میل و رغبت تو ناری بوده نار برات آماده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 867.79,
   "end": 869.79,
   "text": "نوری بوده نور برات آماده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 869.79,
   "end": 871.87,
   "text": "نور می‌شه بهشت، نار می‌شه جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 871.87,
   "end": 880.07,
   "text": "و الا یک حقیقتند. پس این‌که خدای منان ما را از حیث صفات هم به وزان خودش آفریده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 880.07,
   "end": 885.65,
   "text": "ما باید این صفات رو در وجود خودمون پیاده‌سازی کنیم در علم اخلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 885.65,
   "end": 888.87,
   "text": "که این می‌شه مرتبه‌ی دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 888.87,
   "end": 891.15,
   "text": "درست شد؟ اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 891.15,
   "end": 893.73,
   "text": "جواره چگونه؟ به کجا برمی‌گرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 893.73,
   "end": 899.85,
   "text": "یا به عبارتی اون افعال خدا ما رو به ذات و صفات و افعال خودش به وزان این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 899.85,
   "end": 902.01,
   "text": "افعال برمی‌گرده به جواره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 902.01,
   "end": 905.57,
   "text": "همون عبودیت، عبادیت، عبودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 905.57,
   "end": 909.55,
   "text": "تو، عبدیت تو رو نمی‌گما، عبدیت تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 909.55,
   "end": 916.13,
   "text": "اون شاه‌راهی که بین تو و حضرت حق است که یه جا تردד می‌کنند، یه سری راه، جا پا می‌افته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 916.13,
   "end": 921.31,
   "text": "جا پا می‌افته، یه جا لاله چمنا یه سری تردد می‌شه می‌بینی راه افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 921.31,
   "end": 924.43,
   "text": "به این عرب می‌گه عبد، عبد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 924.43,
   "end": 927.29,
   "text": "به این جاده‌ای که درست شده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 927.29,
   "end": 930.27,
   "text": "شدت تردد می‌گن عبد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 930.27,
   "end": 935.53,
   "text": "عبدیت تو همون شاه‌راه تو به سمت حضرت حق مقام قلب توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 935.53,
   "end": 939.31,
   "text": "اما عبودیت چیه؟ راهیه که تو رو به این منتهی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 939.31,
   "end": 943.05,
   "text": "عبودیت می‌شه همون اعضا و جواره تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 943.05,
   "end": 947.07,
   "text": "خب الان نمازه. می‌گه آقا من قلبم نماز می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 947.07,
   "end": 949.69,
   "text": "نیاز ندارم مثلاً اعضا و جوارحم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 949.69,
   "end": 955.55,
   "text": "خب شما وقتی راهی منتهی نشد به اون عبدیت یعنی اصلاً اون عبدیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 955.55,
   "end": 958.03,
   "text": "اصلاً قبول تو عبدیت داشته باشی ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 958.03,
   "end": 961.31,
   "text": "مثال که نیست و الا می‌گیم داری، قلبت حاضره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 961.31,
   "end": 964.27,
   "text": "اما از چه راهی می‌خوای بری برسی به اون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 964.27,
   "end": 967.91,
   "text": "این راهی که تو رو می‌رسونه به اون عبدیت، عبودیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 967.91,
   "end": 971.61,
   "text": "یعنی اعضا و جواره باید کار کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 971.61,
   "end": 976.21,
   "text": "نیست. این فعل انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 976.21,
   "end": 980.39,
   "text": "باید در طول فعل حضرت حق باشه، نه در طول فعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 980.39,
   "end": 983.03,
   "text": "شیطان ملعون. پس این ز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 983.03,
   "end": 985.25,
   "text": "که انسان، این یه توضیحی دادیم پیراهن این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 985.25,
   "end": 989.33,
   "text": "اولاً جایگاه قلب و جان مشخص بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 989.33,
   "end": 991.87,
   "text": "که بعد انشاالله بعداً بفهمیم که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 991.87,
   "end": 999.31,
   "text": "نزول دفعی و تدریجی در این قلب چگونه است که همه‌ی ما این رو داریم نه فقط پیغمبر داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 999.31,
   "end": 1003.43,
   "text": "و اولاً جایگاه قلب معلوم بشه و این باز بشه یه ذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1003.43,
   "end": 1009.73,
   "text": "یعنی چی که انسان به وزان حضرت حق آفریده شده است از حیث ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1009.73,
   "end": 1014.87,
   "text": "و صفات و افعال و مشخص بشه این عبودیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1014.87,
   "end": 1016.99,
   "text": "اخلاق و حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1016.99,
   "end": 1020.59,
   "text": "ببینید الان جایگاه عبادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1020.59,
   "end": 1023.67,
   "text": "درست شد؟ جایگاه عبادت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1023.67,
   "end": 1030.85,
   "text": "جایگاه اخلاق، موعظه و الموعظة الحسنة و جایگاه حکمت مشخص شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1030.85,
   "end": 1034.15,
   "text": "این آیه رو حالا با هم قرائت، قرائت کنیم و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1034.15,
   "end": 1038.11,
   "text": "ادعو الى-- خدا به پیغمبر فرموده ادعو، دعوت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1038.11,
   "end": 1041.21,
   "text": "سطح بحث رو ببینید. مراتب رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1041.21,
   "end": 1044.41,
   "text": "ادعو الى سبيل ربك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1044.41,
   "end": 1051.01,
   "text": "سبيل ربك. به پر-- به راه پروردگار خودت دعوت کن نه به ذات پروردگار اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1051.01,
   "end": 1053.15,
   "text": "سطح بحث بالای بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1053.15,
   "end": 1054.79,
   "text": "با چی دعوت کنم خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1054.79,
   "end": 1058.63,
   "text": "بالحكمة. اول با حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1058.63,
   "end": 1060.67,
   "text": "حکمت جایگاهش قلب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1060.67,
   "end": 1063.21,
   "text": "اول قلب، قلب باید درست شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1063.21,
   "end": 1066.29,
   "text": "بالحكمة والموعظة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1066.29,
   "end": 1068.59,
   "text": "والموعظة می‌شه اخلاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1068.59,
   "end": 1070.59,
   "text": "والموعظة الحسنة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1070.59,
   "end": 1075.65,
   "text": "وجادلهم بالتي هي أحسن که دیگه اون کار جواره‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1075.65,
   "end": 1079.73,
   "text": "داد می‌زنی، بحث می‌کنی، جدل می‌کنی، دستت بالا پایین میره، پایت بالا...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1079.73,
   "end": 1083.61,
   "text": "بعضیا تو بحث‌شون خوندن هم دیدید یا نه دیگه انقدر بحث با--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1083.61,
   "end": 1085.59,
   "text": "یکی از نشانه‌ها، حالا قدیم بود الان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1085.59,
   "end": 1090.91,
   "text": "نشانه‌ی این که طرف دیگه با تمام وجودش یه چیزو قبول داره عمامه پرت می‌کرد به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1090.91,
   "end": 1094.25,
   "text": "طرف. یعنی دیگه من بیش از این هیچی دیگه هیچ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1094.25,
   "end": 1096.89,
   "text": "یعنی اینجا دیگه خط قرمز منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1096.89,
   "end": 1100.71,
   "text": "توجه کردید؟ این می‌شه جا دلهم بالتي هي أحسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1100.71,
   "end": 1105.21,
   "text": "ان شاء الله که عاقبتmon ختم به خیر بشود به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1105.21,
   "end": 1107.41,
   "text": "اللهم صل علی محمد و آل محمد. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 281,
   "start": 1107.41,
   "end": 1113.63,
   "text": "صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}