 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 11.1,
   "end": 51.6
  },
  {
   "index": 1,
   "title": "## الله و ربّ؛ جدولِ رزق",
   "start": 51.6,
   "end": 214.2
  },
  {
   "index": 2,
   "title": "## قلب؛ مقامِ الهیّت و تقلّب در عوالمِ خمس",
   "start": 214.2,
   "end": 315.28
  },
  {
   "index": 3,
   "title": "## مادرانگیِ قلب",
   "start": 315.28,
   "end": 548.2
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.36,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.36,
   "end": 6.88,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.88,
   "end": 10.66,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.66,
   "end": 12.98,
   "text": "سؤال اگر بشود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.98,
   "end": 17.34,
   "text": "چنانچه امام جماعت رو ببینیم که مثلا سوار به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.34,
   "end": 19.66,
   "text": "دوچرخه شده یا موتور شده؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.66,
   "end": 22.38,
   "text": "یعنی تو عرف مثلا خیلی مرسوم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.38,
   "end": 25.38,
   "text": "البته تو شهر‌هایی مثل قم و مشهد و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 25.38,
   "end": 29.3,
   "text": "زیاد دیده میشه اما در بعضی شهرها کمتر یا اصلا دیده نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 29.3,
   "end": 36.08,
   "text": "به هر حال اگر چنانچه همچین صحنه‌ای ببینیم که امام جماعت ما مثلا سوار بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.08,
   "end": 44.42,
   "text": "وسایلی‌ست که خیلی مرسوم نیست تو عرف جامعه مثل مثلا دوچرخه و موتور آیا به عدالتش لطمه‌ای می‌زنه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.42,
   "end": 50.28,
   "text": "چه حکمی داره؟ رهبر عزیزمون فرمودن که این کار به عدالت و صحت امام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.28,
   "end": 52.72,
   "text": "ضرر نمی‌زند. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.72,
   "end": 56.88,
   "text": "در ادامه بحث قلب در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.88,
   "end": 59.48,
   "text": "و قلب منزل البته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.48,
   "end": 62.2,
   "text": "امروز اشاره می‌کنیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.2,
   "end": 66.66,
   "text": "ارتباط نام و اسم شریف رب الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.66,
   "end": 73.62,
   "text": "ببینید عزیزان، عرض شد که الله اولین اسمی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.62,
   "end": 76.26,
   "text": "از ذات منتشی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.26,
   "end": 78.74,
   "text": "و این الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.74,
   "end": 82.8,
   "text": "وقتی می‌خواهد با خلائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.8,
   "end": 87.84,
   "text": "و همه‌ی اسماء در بیرون از ذات ارتباط بگیرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.84,
   "end": 91.94,
   "text": "با اسماء و صفات و مظاهر اسماء و صفات در بیرون از ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.94,
   "end": 97.92,
   "text": "ارتباط بگیرد، این ارتباط از نوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.92,
   "end": 100.36,
   "text": "رب و مربوبی‌ست. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.36,
   "end": 105.58,
   "text": "او پر-- مقام پرورش پیدا می‌کند چرا که می‌خواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.58,
   "end": 111.14,
   "text": "اون اشیا و اون اسماء و اون موجوداتی رو که تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.14,
   "end": 113.52,
   "text": "خلقت او هستند، تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.52,
   "end": 117.36,
   "text": "صیانت او هستند، تحت مالکیت او هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.36,
   "end": 120.68,
   "text": "تحت رازقیّت او هستند، به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.68,
   "end": 123.24,
   "text": "رزق اونا رو تأمین کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.24,
   "end": 128.02,
   "text": "خب این الله وقتی می‌خواهد رزق هر کسی رو تعیین کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.02,
   "end": 131.2,
   "text": "این الله که اسم جامع است و همه اسماء در او هستند؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.2,
   "end": 133.16,
   "text": "یعنی وصل به دریای لا تن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.16,
   "end": 136.12,
   "text": "لایتناهی حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.12,
   "end": 140.02,
   "text": "این الله می‌خواهد رزق هر شیئی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.02,
   "end": 145.1,
   "text": "تضمین کند. رزق هر شیئی نسبت به سر القدر اوست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.1,
   "end": 147.46,
   "text": "یعنی به میزان و اندازه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 147.46,
   "end": 150.16,
   "text": "اون ظرفی که هر رزقی دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.16,
   "end": 156.74,
   "text": "و در حقیقت مزرو-- مرزوق حضرت حق است می‌خواهد رزق رو دریافت کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.74,
   "end": 159.14,
   "text": "اون کانالی، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.14,
   "end": 162.02,
   "text": "جدولی که از الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.02,
   "end": 164.78,
   "text": "رزق رو می‌گیرد و به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.78,
   "end": 168.3,
   "text": "شیء می‌رساند، به اون عین هر موجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.3,
   "end": 171.28,
   "text": "می‌رساند. یا به یک عبارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 171.28,
   "end": 178.12,
   "text": "از اون معانی یا اعیان ثابته یا ماهیات ثبته علمی ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.12,
   "end": 181.36,
   "text": "به علم لایتناهی حضرت حق می‌خواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.36,
   "end": 183.66,
   "text": "اون رزق رو برساند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 183.66,
   "end": 186.44,
   "text": "از طریق الله، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 186.44,
   "end": 189.8,
   "text": "رزقی که می‌رسد توسط رب می‌رسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 189.8,
   "end": 192.06,
   "text": "و اون جدول وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 192.06,
   "end": 195.12,
   "text": "که ارتباط بین هر شیئی‌ست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 195.12,
   "end": 197.8,
   "text": "یعنی حصه وجودی هر شیئی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 197.8,
   "end": 201.86,
   "text": "با الله هست، اون می‌شود رب او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 201.86,
   "end": 205.22,
   "text": "و به همون میزان هم رزق دریافت می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 205.22,
   "end": 208.44,
   "text": "چگونگی کم و کیف رزق هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 208.44,
   "end": 212.98,
   "text": "به اون جدول وجودی و حصه وجودیش ربط دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 212.98,
   "end": 216.34,
   "text": "که از این جهت هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 216.34,
   "end": 219.02,
   "text": "خب ما قبلاً عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 219.02,
   "end": 224.32,
   "text": "قلب مقام الهی‌ه، الهیت وجود ما را دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 224.32,
   "end": 232.42,
   "text": "یعنی همونطور که از شرح بر فسوس حضرت علامه قیرانی عرض کردیم نفس ناطقه رو قلب میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 232.42,
   "end": 237.64,
   "text": "از این جهت که بین عالم عقلی محض و عالم نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 237.64,
   "end": 240.16,
   "text": "منبع متقلبه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 240.16,
   "end": 242.28,
   "text": "انقلاب دارد دائما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 242.28,
   "end": 247.28,
   "text": "همچنین در وجوه پنج گانه نفس انقلاب دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 247.28,
   "end": 254.44,
   "text": "که به، در حقیقت همون به سوی عوالم کلیه خمس متقلب است، انقلاب دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 254.44,
   "end": 259.46,
   "text": "گاهی به این عالم، گاهی به اون عالم، گاهی به این یکی عالم سرکشی دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 259.46,
   "end": 261.9,
   "text": "عنایت دارد، تصرف دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 261.9,
   "end": 266.68,
   "text": "این عوالم هم که بر-- قبلاً عرض شد همون عوالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.68,
   "end": 269.66,
   "text": "ک-کلیه خمس اولیش معانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 269.66,
   "end": 273.88,
   "text": "یا اعیان ثابته بود که در ثغر ذات حضرت حق‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 273.88,
   "end": 276.4,
   "text": "که مرتبه دون ذات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.4,
   "end": 281.74,
   "text": "در به مقام احدیت حضرت حق که همه اش ya مستهلك در او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.74,
   "end": 284.96,
   "text": "دومیش عالم ارواح و عالم امر بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.96,
   "end": 287.8,
   "text": "و سومیش عالم مثال بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 287.8,
   "end": 291.02,
   "text": "که ما بیشتر به عالم برزخ می‌شناسیمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 291.02,
   "end": 293.48,
   "text": "و چهارمیش عالم شهادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 293.48,
   "end": 298.08,
   "text": "بود که شهادت مطلقه میشه همین عالم نشئه طبیعت و دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 298.08,
   "end": 302.56,
   "text": "و پنجمیش هم البته عالم انسان کامل بود که دارای همه این عوالم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 302.56,
   "end": 306.64,
   "text": "همه این عوا-عوا-عوالم می‌شوند شؤون وجودی او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 306.64,
   "end": 308.86,
   "text": "قلب بین همه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.86,
   "end": 312.2,
   "text": "منقلب است، متقلب است، در رفت و آمد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.2,
   "end": 315.0,
   "text": "این مقام خاص و ویژه قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 315.0,
   "end": 318.88,
   "text": "خب قلب وقتی می‌خواهد رزق بگیرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 318.88,
   "end": 321.26,
   "text": "عرض شد که از طریق الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 321.26,
   "end": 323.36,
   "text": "از طریق اسم الله رزق می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 323.36,
   "end": 326.04,
   "text": "خب خود قلب مقام الهیت دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 326.04,
   "end": 328.86,
   "text": "یعنی قلب ماست که متصل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 328.86,
   "end": 335.22,
   "text": "یعنی خودش مقام الوهیت و الهیت دارد در نفس ما البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 335.22,
   "end": 338.02,
   "text": "یعنی در وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 338.02,
   "end": 340.72,
   "text": "اگر بخواهیم قیاس بگیریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 340.72,
   "end": 344.54,
   "text": "مقامی که الله در بیرون از ما دارد، قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 344.54,
   "end": 348.88,
   "text": "در درون ما دارد. در خارج ما الله چه معنایی دارد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 348.88,
   "end": 351.24,
   "text": "در درون ما قلب اون معنا رو دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 351.24,
   "end": 355.88,
   "text": "معنای جمعی دارد. اشتباه نشه عزیزان اسم جمع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 355.88,
   "end": 359.56,
   "text": "مثل مادری‌ست، مثل مادری‌ست دقیقاً که همه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 359.56,
   "end": 365.54,
   "text": "همه اجزا رو گرد هم جمع می‌کنه، گرد سفره رزقشون جمع می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 365.54,
   "end": 370.16,
   "text": "پس رزق الهی از خود قلب منتشر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 370.16,
   "end": 373.56,
   "text": "اما از مقام قلب به بعد، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 373.56,
   "end": 378.18,
   "text": "کانالی که اون جدولی که فیض رو از قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 378.18,
   "end": 381.74,
   "text": "انتشا میده و انتشار میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 381.74,
   "end": 389.4,
   "text": "میرسونه به اجزاء دیگر مثل مادری که لقمه لقمه بر دهان بچه‌هاش می‌گذارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 389.4,
   "end": 392.04,
   "text": "قلب این مقام رو دارد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 392.04,
   "end": 395.2,
   "text": "با توجه که اینکه به چه عالمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 395.2,
   "end": 399.88,
   "text": "توجه کرده قلب از چه عالمی اخذ فیض کرده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 399.88,
   "end": 402.44,
   "text": "و رو به چه عالمی دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 402.44,
   "end": 407.4,
   "text": "رزق، رزق مناسب و متناسب با اون عالم اخذ می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 407.4,
   "end": 410.78,
   "text": "که این تناسب بین اون رزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 410.78,
   "end": 413.9,
   "text": "و اون عالمی که قلب به اون سمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 413.9,
   "end": 416.88,
   "text": "به اون وجه نظر دوخته است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 416.88,
   "end": 419.7,
   "text": "نوع رزق رو مشخص می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 419.7,
   "end": 427.8,
   "text": "کم و کیف رزق رو یا به عبارتی نوع ربط به این شخص و ربط به این قلب رو مشخص می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 427.8,
   "end": 435.84,
   "text": "ل-لذا می‌شود گفت که نه اینکه هر انسانی یک رب دارد بلکه اجزاء هر انسانی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 435.84,
   "end": 439.5,
   "text": "یک رب دارند. یعنی قلب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.5,
   "end": 442.88,
   "text": "به صورت کلی رزق رو می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.88,
   "end": 448.06,
   "text": "عقل ما به این معنا اگر توجه شود عقل ما از قلب رزق می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 448.06,
   "end": 452.14,
   "text": "قوه خیال ما از عقل، از قلب رزق می‌گیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 452.14,
   "end": 454.76,
   "text": "اما به وساطت عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.76,
   "end": 456.84,
   "text": "همین‌طور این به مادون بیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 456.84,
   "end": 464.7,
   "text": "قوای همون حواس پنجگانه ما و حواس ظاهری ما که از باطن می‌گیرد در نهایت از قلب می‌گیرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.7,
   "end": 466.82,
   "text": "و قلب است که متصل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 466.82,
   "end": 468.66,
   "text": "به اون عوالم خمسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 468.66,
   "end": 470.42,
   "text": "عوالم کلیه خمس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 470.42,
   "end": 476.4,
   "text": "رزق، رزق رو نسبت به اینکه با کجا ارتباط دارد و به کجا رو می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 476.4,
   "end": 478.4,
   "text": "از حضرت حق می‌گیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 478.4,
   "end": 479.96,
   "text": "و به اجزاء تقسیم می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 479.96,
   "end": 482.3,
   "text": "دقیقاً مق-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 482.3,
   "end": 484.86,
   "text": "مثالی که می‌توان زد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 484.86,
   "end": 487.68,
   "text": "سهولت فهم ایجاد کند مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 487.68,
   "end": 490.22,
   "text": "مادر است نسبت به فرزندانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 490.22,
   "end": 494.22,
   "text": "چگونه لقمه لقمه نسبت به سعه وجودی فرزندانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 494.22,
   "end": 496.82,
   "text": "و اون قوای هاضمه فرزندانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 496.82,
   "end": 500.14,
   "text": "و اون زبان حال فرزندانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 500.14,
   "end": 504.8,
   "text": "لقمه لقمه رزق رو بر دهانشان می‌گذارد، همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 504.8,
   "end": 506.48,
   "text": "نسبت به سعه وجودی‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 506.48,
   "end": 511.72,
   "text": "گاهی فرزند مریضه هر لقمه‌ای رو بر دهانش نمی‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 511.72,
   "end": 513.58,
   "text": "دارو بر دهانش می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 513.58,
   "end": 517.38,
   "text": "گاهی فرزند نیازش بیشتره رزق بیشتری می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 517.38,
   "end": 520.28,
   "text": "گاهی فرزند طهارت وجودی دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 520.28,
   "end": 526.04,
   "text": "سعه وجودی دارد، رزق بیشتری نیاز دارد، رزق بیشتری در اختیار او قرار می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 526.04,
   "end": 528.56,
   "text": "این چنین است مقام قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 528.56,
   "end": 533.4,
   "text": "مقام تو-- از این حیث که نگاه می‌کنید ارتباط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 533.4,
   "end": 538.14,
   "text": "با باطن و ظاهر عالم یا عالم غیب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 538.14,
   "end": 540.28,
   "text": "عالم شهود می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 540.28,
   "end": 543.62,
   "text": "از حیث ارتضاغ اجزاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 543.62,
   "end": 548.2,
   "text": "انشاالله که عاقبتمون ختم به خیر باشه به برکت صلوات بر محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}