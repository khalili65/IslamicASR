 "chapters": [
  {
   "index": 0,
   "title": "## استفتای عدول از نیت در نماز قضا",
   "start": 13.12,
   "end": 73.76
  },
  {
   "index": 1,
   "title": "## قلب مطبوع؛ مهر دل از تبعیت هوا",
   "start": 73.76,
   "end": 123.24
  },
  {
   "index": 2,
   "title": "## هشدار پیامبر از دو چیز",
   "start": 123.24,
   "end": 175.28
  },
  {
   "index": 3,
   "title": "## قتال با نفس؛ کلام قاضی و حداد",
   "start": 175.28,
   "end": 222.6
  },
  {
   "index": 4,
   "title": "## محک مجلس؛ قال الصادق و گریز دل",
   "start": 222.6,
   "end": 409.23
  },
  {
   "index": 5,
   "title": "## غیبت امام و محبت عملی آل محمد",
   "start": 409.23,
   "end": 570.83
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.12,
   "end": 4.92,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.92,
   "end": 8.44,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.44,
   "end": 13.12,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.12,
   "end": 16.22,
   "text": "در موضوع عدول از نیت داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.22,
   "end": 23.12,
   "text": "سیر می‌کردیم تو احکام که تبرّکاً عرض کردیم استفتار شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.12,
   "end": 28.2,
   "text": "من ااا نماز قضای صبح رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.2,
   "end": 31.5,
   "text": "خون-- ا الله اکبر گفتم خوندم بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.5,
   "end": 35.5,
   "text": "خب باید رکعت دوم بعد از تشهد سلام می‌دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.5,
   "end": 38.34,
   "text": "حواسم نبود بلند شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.34,
   "end": 42.1,
   "text": "یه دفعه یادم افتاد که خب من الان باید تشهد بعد از شش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.1,
   "end": 47.2,
   "text": "تشهد سلام می‌گفتم تموم می‌شد دو رکعت نماز صبح دیگه، ولی بلند شده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.2,
   "end": 50.1,
   "text": "یادم افتاد که نماز ظهر قضا هم دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.1,
   "end": 56.38,
   "text": "اونجا نیت رو برگردوندم به نماز قضای ظهرم و ادامه دادم چهار رکعتی تموم کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.38,
   "end": 58.26,
   "text": "آیا اجازه همچین کاری هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.26,
   "end": 61.16,
   "text": "رهبر فرمودند نه خیر جایز نیست، صحیح نیست این کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.16,
   "end": 64.12,
   "text": "اصلاً اون نماز اشکال داره، باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.12,
   "end": 72.66,
   "text": "یک جاهای خاصی هست که انسان می‌تونه عدول از نماز از نیت بکنه که من چند تاشو گفتم بقیه‌ش هم انشاالله عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.66,
   "end": 80.7,
   "text": "خب ما رسیدیم به دومین قلب در قرآن که قلب مطبوع باطله دسته‌دار بود، یعنی قلبی که مهر خورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.7,
   "end": 83.62,
   "text": "و آیاتش رو عرض کردیم محضر شما خوبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.62,
   "end": 86.64,
   "text": "امروز اشارتا عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.64,
   "end": 90.82,
   "text": "نکته خیلی، خیلی، خیلی مهمی که در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.82,
   "end": 96.46,
   "text": "شانزده سوره رسول الله وجود داره در خصوص کسانی که مشخصه کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.46,
   "end": 102.66,
   "text": "مهر می‌خوره قلبشون فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.66,
   "end": 109.26,
   "text": "اینا مشخصه‌شون اینه از این جهت مهر خورده دلشون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.26,
   "end": 114.4,
   "text": "اینا هوای نفسشون رو تبعیت کردن، پیرو خواهش‌های دلشون بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.4,
   "end": 119.88,
   "text": "ترمز نداشتن. هرچی که دلشون خواست دنبال اون رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.88,
   "end": 121.48,
   "text": "و بسیار این خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.48,
   "end": 125.2,
   "text": "یادمه که قبلاً این حدیث شریف رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.2,
   "end": 131.36,
   "text": "از پیامبر عظیم الشأن اسلام که مرحوم مجلسی در کتاب بحار الشعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.36,
   "end": 137.7,
   "text": "七 صفحه چهارصد و هفده نقل کرده بود قبلاً توضیح داده بودیم براتون خوندم که حضرت فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.7,
   "end": 139.98,
   "text": "ببین خطاب به همه مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.98,
   "end": 149.9,
   "text": "پیامبر داره می‌فرماد بیشتر از هر چیزی من برای شما از دو چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 149.9,
   "end": 152.88,
   "text": "نگران و ناراحتم، ترسانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.88,
   "end": 158.58,
   "text": "اول فرمود تبعیت کردن هوای نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.58,
   "end": 162.1,
   "text": "بعد فرمود آرزوی طولانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.1,
   "end": 167.26,
   "text": "هوای نفس مقدس و غیر مقدس هم نمی‌شناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 167.26,
   "end": 172.34,
   "text": "یک چیزی که در درون ماست، شیطانی‌ست که در درون ما نهفته‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 172.34,
   "end": 175.12,
   "text": "و سر بزنگاه خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.12,
   "end": 182.68,
   "text": "یه جمله‌ای از آستاد هاشم حداد رحمة الله علیه هست که از قول استادشون آقای قاضی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.68,
   "end": 184.82,
   "text": "نقل کردن. جمله خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.82,
   "end": 189.54,
   "text": "می‌فرمود آقای قاضی فرمودند زمانی که نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.54,
   "end": 194.14,
   "text": "غیر از خواسته معشوقه طلب کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 194.14,
   "end": 199.48,
   "text": "واجب است انسان آماده‌ی قتال و جنگ با او باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 199.48,
   "end": 202.9,
   "text": "میگه تو اصلاً واجبه برات وقتی می‌بینی نفست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 202.9,
   "end": 208.6,
   "text": "طلبی به غیر از اون چیزی که محبوبه، معشوقت دوست داره می‌کنه باهاش بجنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 208.6,
   "end": 211.86,
   "text": "من واقعاً با نفسم می‌جنگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 211.86,
   "end": 216.46,
   "text": "nefsi که اعدی عدو ماست، بدترین دشمنان ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 216.46,
   "end": 218.72,
   "text": "و واقعاً بدتر از یزیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 218.72,
   "end": 225.34,
   "text": "ما وقتی ش-- اسم شمر و یزید رو می‌شنویم لعنت الله علیه بغضمون هم بجوشد خیلی هم خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 225.34,
   "end": 227.98,
   "text": "اما شمر وجودمون چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 227.98,
   "end": 237.42,
   "text": "یزید وجودم چی؟ حضرته آیت الله نورالله شاهرودی یه کتابی دارن به نام شذرات المعارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 237.42,
   "end": 240.24,
   "text": "کتاب خیلی ذی قیمتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 240.24,
   "end": 249.18,
   "text": "در صفحه صد و سی و یکش می‌فر-- اینو نوشته فرموده که مادامی که انسان مبتلا به معشوقه نفس است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 249.18,
   "end": 252.62,
   "text": "یعنی معشوقه‌ش میشه نفسش، قبله‌ش میشه نفسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 252.62,
   "end": 255.72,
   "text": "هرچی که دلش خواست دنبال همون میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 255.72,
   "end": 259.06,
   "text": "فرمود و از این اشتباه خارج نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 259.06,
   "end": 262.72,
   "text": "یعنی همینطوری مونده تو این اشتباه با خودش مبارزه نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 262.72,
   "end": 266.86,
   "text": "البته به وصال معشوقه حقیقی نائل نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 266.86,
   "end": 271.64,
   "text": "اصلاً وصل به خدا و اهل بیت و قرآن و حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 271.64,
   "end": 275.52,
   "text": "روح قرآن و امام عصر و این‌ها محاله کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 275.52,
   "end": 278.94,
   "text": "دنبال معشوقه نفسش، یعنی عشقش بشه نفسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 278.94,
   "end": 280.56,
   "text": "آقا عشقم کشیده دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 280.56,
   "end": 282.34,
   "text": "آقا ملاکت چیه؟ مبنات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 282.34,
   "end": 286.8,
   "text": "هیچی. در یک قسمت دیگه‌ای از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 286.8,
   "end": 297.24,
   "text": "کتاب شریف شذرات المعارفش ایشون این جمله رو میاره می‌فرماید هرچند خدا فرموده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 297.24,
   "end": 301.88,
   "text": "خدا وعده داده تو قرآن که ما هستیم که این ذکر یعنی قرآن رو حفظ می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 301.88,
   "end": 306.98,
   "text": "قطعاً ما حفظش می‌کنیم. ولی الان شما هم وظیفه داریم نسبت به دینمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 306.98,
   "end": 311.06,
   "text": "نباید دنبال هواهای نفسانی و خواهش‌های نفسانیمون بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 311.06,
   "end": 315.1,
   "text": "باید ببینیم حالا که خدا فرموده من حفظ می‌کنم اما خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 315.1,
   "end": 322.76,
   "text": "سنتش سنت خدا عوض نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 322.76,
   "end": 326.96,
   "text": "خدا از طریق اسباب کاراش رو انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 326.96,
   "end": 328.58,
   "text": "می‌خواد فیض به من و تو برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 328.58,
   "end": 334.44,
   "text": "من و تو باید هم و غممون این باشه که قرآن رو حفظ کنیم، آیات قرآن رو حفظ کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 334.44,
   "end": 339.98,
   "text": "و اون چیزی که سبب میشه ما از قرآن فاصله بگیریم به معشوقمون که همون قرآنه نرسیم اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 339.98,
   "end": 342.08,
   "text": "که نفسمون رو معشوقه قرار بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 342.08,
   "end": 344.8,
   "text": "اگر کسی اینطور شد خدا نکره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 344.8,
   "end": 347.46,
   "text": "یک وقتی می‌رسه که دیگه دلش مهر می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 347.46,
   "end": 350.5,
   "text": "هرچی از قرآن و این‌ها بهش بگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 350.5,
   "end": 353.04,
   "text": "بدش میاد، فرار می‌کنه ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 353.04,
   "end": 356.02,
   "text": "امتحان کنید یه جا گرده‌ای باشه فامیلی جمعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 356.02,
   "end": 358.24,
   "text": "چرت و پرت بگو، بگو بخند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.24,
   "end": 364.45,
   "text": "همه کیف می‌کنن. به محض اینکه می-- قال الصادق علیه السلام خب کاری ندارید التماس دعا خداحافظ شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 364.45,
   "end": 367.85,
   "text": "من بارها اینو امتحان کردم. اصلاً بعضیا بدشون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 367.85,
   "end": 369.47,
   "text": "اقال الصادق والباطل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 369.47,
   "end": 373.19,
   "text": "دوست ندارن. اصلاً میل دلشون برگشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 373.19,
   "end": 380.89,
   "text": "و این دقیقاً، اِاِاِ به قول آقای شاهرودی این کاری بود که بنی اسرائیل کردن، این طریقه‌ی رفتار ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 380.89,
   "end": 384.47,
   "text": "بنی اسرائیل به موسی گفتن موسی خودت برو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 384.47,
   "end": 387.27,
   "text": "خدات برو با فرعون بجنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 387.27,
   "end": 389.93,
   "text": "تو و خدا با فرعون بجنگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 389.93,
   "end": 394.01,
   "text": "وقتی پیروز شدید ما میایم و شما ملحق میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 394.01,
   "end": 399.81,
   "text": "خب خدا-- ولی غافل بودن از اینکه نه اینا هم وظیفه ای دارن نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 399.81,
   "end": 401.89,
   "text": "دینشون، به کتابشون، به پیغمبرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 401.89,
   "end": 404.85,
   "text": "لذا خدا چهل سال اینا رو آواره کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 404.85,
   "end": 406.71,
   "text": "از شهرنشینی محرومشون کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 406.71,
   "end": 409.23,
   "text": "چهل سال تو بیابون‌ها آواره بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.23,
   "end": 413.89,
   "text": "چرا؟ چون که گرفتار نفس و خواهش‌های نفسشون شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.89,
   "end": 415.87,
   "text": "خدا هم به دلشون مهر زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 415.87,
   "end": 419.97,
   "text": "پیغمبرشون رو ازشون گرفت. چرا الان امام زمان رو از ما گرفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 419.97,
   "end": 423.55,
   "text": "شما گمان کنی مثلاً مدافعین حرم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 423.55,
   "end": 431.69,
   "text": "می‌گفتن که خب حالا خدایا برو تو از حرم اهل بیت خودت دفاع کن دیگه اهل بیت تو بودن دیگه اینا برو ازشون دفاع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 431.69,
   "end": 436.09,
   "text": "این چه کلامیه؟ اصلاً مگه خدا خودش از دین خودش دفاع کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 436.09,
   "end": 438.61,
   "text": "اتفاقاً تو همین کتاب، تو همین بخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 438.61,
   "end": 444.29,
   "text": "آقای شاهرودی می‌فرماید که این حدیث رو اشاره می‌کنه به ممات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 444.29,
   "end": 451.87,
   "text": "علی حب آل محمد صلی الله علیه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 451.87,
   "end": 455.63,
   "text": "فرمود اگر کسی بمیره با محبت آل پیغمبر آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 455.63,
   "end": 459.19,
   "text": "رسول الله رسول اعظم صلی الله علیه و سلم می‌فرماید فهوا شهیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 459.19,
   "end": 462.43,
   "text": "این حدیث بسیار مهمی‌ست از رسول خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 462.43,
   "end": 465.43,
   "text": "و تو منابع مهم ما اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 465.43,
   "end": 471.29,
   "text": "بعد اینجا آقای شاهرودی اشاره می‌کنه میگه خب ما هیچوقت رفتیم به دنبال اینکه ببینیم حب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 471.29,
   "end": 477.75,
   "text": "ما می‌گیم خب دلمون دوست داره علی رو دیگه قلباً ما علی رو دوست داریم، اهل بیت رو دوست داریم اما نمی‌ریم دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 477.75,
   "end": 482.77,
   "text": "به عمل کشوندنش. یعنی این محبت بشه مودت است چون سه شق داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 482.77,
   "end": 486.23,
   "text": "شق قلبی‌ش رو ما داریم الحمد لله دوست داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 486.23,
   "end": 489.15,
   "text": "اگه نداشتیم که منافق بودیم. اما زبانی‌ش چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 489.15,
   "end": 491.71,
   "text": "یعنی لسانت هم به نفع اونا حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 491.71,
   "end": 497.43,
   "text": "عملی‌ش چی؟ آیا عملیات التزام عملیه به دستورات اون دارم من؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 497.43,
   "end": 499.81,
   "text": "این یک. میگه، می‌فرماید که نهیب می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 499.81,
   "end": 505.37,
   "text": "میگه اگر تو واقعاً ادعا می‌کنی دوست داری در عمل هم باید پی این دوستی بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 505.37,
   "end": 508.71,
   "text": "کاری که مدافعین حرم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 508.71,
   "end": 515.35,
   "text": "یکی از علما اخیراً داد می‌زد می‌گفت آی مردم چقدر بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 515.35,
   "end": 520.05,
   "text": "امام حسین دوستت دارم حضرت زینب دوستت دارم و ابی انت و امي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 520.05,
   "end": 521.95,
   "text": "خب حرمش در خطر افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 521.95,
   "end": 524.87,
   "text": "چند نفر، چند نفرمون رفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 524.87,
   "end": 527.33,
   "text": "حرمشو می‌خواستن با خاک یکسان کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 527.33,
   "end": 529.97,
   "text": "میگه نمی‌کردن نمونه‌ش سامرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 529.97,
   "end": 532.27,
   "text": "چند نفرمون دغدغه رفتن داشتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 532.27,
   "end": 534.73,
   "text": "حالا یه ظواوی داشت همه نمی‌تونستن برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 534.73,
   "end": 537.47,
   "text": "اما دغدغه رفتن چند تامون داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 537.47,
   "end": 540.05,
   "text": "واقعاً نهیبه دیگه. نکنه ما خدایی نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 540.05,
   "end": 545.63,
   "text": "دلمون مهر بخوره با خواهش‌های دل و دنیا و بعد از وظایفمون غايل– غافل بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 545.63,
   "end": 553.47,
   "text": "بعد تازه یه روزی العیاذ بالله ختم کلام اینکه سر برداریم ببینیم عجب اصلاً به خاطر این خواهش‌های ما آقا نیومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 553.47,
   "end": 557.59,
   "text": "امام عصر به خاطر خواهش‌های دل امثال من بوده که غیبت داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 557.59,
   "end": 563.89,
   "text": "وا مصيبتا. ان شاء الله عاقبتمون ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 563.89,
   "end": 570.83,
   "text": "اللهم صل علی محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}