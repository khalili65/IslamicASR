 "chapters": [
  {
   "index": 0,
   "title": "## عدول از ظهر جمعه برای سورهٔ جمعه",
   "start": 11.26,
   "end": 79.64
  },
  {
   "index": 1,
   "title": "## قلب مطبوع؛ آیات مهر",
   "start": 79.64,
   "end": 99.7
  },
  {
   "index": 2,
   "title": "## اوصاف سبب مهر",
   "start": 99.7,
   "end": 370.34
  },
  {
   "index": 3,
   "title": "## جدایی از جمع ایمان؛ زنگ خطر",
   "start": 370.34,
   "end": 419.98
  },
  {
   "index": 4,
   "title": "## سخت‌ترین لحظهٔ موسی",
   "start": 419.98,
   "end": 679.54
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 3.68,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.68,
   "end": 7.1,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.1,
   "end": 11.26,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.26,
   "end": 15.56,
   "text": "در خصوص احکام ما رسیده بودیم به موضوع عدول از نیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.56,
   "end": 19.78,
   "text": "جاهایی که جایز هست که انسان از نیتش عدول کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.78,
   "end": 22.88,
   "text": "یکی از مواردی که انسان اجازه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.88,
   "end": 30.34,
   "text": "در حین نماز واجب عدول کنه به مستحب نیت نماز مستحبی کنه در نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.34,
   "end": 33.96,
   "text": "ظهر روز جمعه‌ست در صورتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.96,
   "end": 36.74,
   "text": "یه دفعه به خودش بیاد ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.74,
   "end": 43.1,
   "text": "نیمی از سوره، سوره ای که دست گرفته رو خونده یا نه اصلا تموم شده سوره در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.1,
   "end": 45.62,
   "text": "سوره جمعه رو نخونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.62,
   "end": 50.3,
   "text": "به قدری سوره جمعه فضیلت داره خوانشش در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.3,
   "end": 52.94,
   "text": "نماز ظهر روز جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.94,
   "end": 57.28,
   "text": "که اینجا رهبر عزیزمون اجازه دادن که شما میتونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.28,
   "end": 60.52,
   "text": "نیت رو برگردونید عدول کنید از نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.52,
   "end": 63.44,
   "text": "نماز ظهر یعنی نماز واجب ظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.44,
   "end": 66.36,
   "text": "جمعه برگردونید به مستحبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.36,
   "end": 69.7,
   "text": "نماز مستحبی رو تموم کنید دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.7,
   "end": 74.32,
   "text": "نماز ظهر روز جمعه رو بخونید که سوره جمعه رو درش بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.32,
   "end": 77.4,
   "text": "یکی از موارد. اما بحث ما پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.4,
   "end": 79.34,
   "text": "انواع قلب در قرآن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.34,
   "end": 86.3,
   "text": "دیگه از قلب مطمئن بگذریم اگرچه خیلی مباحث مون اما اشارتا ما عرض میکنیم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.3,
   "end": 89.68,
   "text": "اهل پژوهش و تحقیق خودشون برن مطالعه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.68,
   "end": 96.76,
   "text": "میریم سراغ دومین نوع قلب که در قرآن حدود نه یا ده تا آیه در رابطه با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.76,
   "end": 104.88,
   "text": "قلب وارد شده. قلب مهر خورده‌ست از نوع تابعة با ط دستدار یا قلب مطبوع با ط دستدار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.88,
   "end": 109.52,
   "text": "چون ما ختم هم داریم، قلب مختوم هم داریم که اونو بعداً بحث میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.52,
   "end": 111.54,
   "text": "یه فرق کوچولویی با این داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.54,
   "end": 115.36,
   "text": "قلب مطبوع با ط دستدار و عين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.36,
   "end": 117.6,
   "text": "یا همون قلب مهر خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.6,
   "end": 123.92,
   "text": "من فقط شماره آیاتی رو که پیرامون این قلب وارد شده رو عرض میکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.92,
   "end": 126.42,
   "text": "دیگه خود آیات رو نخونم که فرصت زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.42,
   "end": 132.1,
   "text": "برید خودتون نگاه کنید و خواهش میکنم برید نگاه کنید نکات خوبی دستگیرتون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.1,
   "end": 136.18,
   "text": "حتی اگه فرصت کردید تفاسیر ذیل آیات رو ببینید خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.18,
   "end": 138.42,
   "text": "سوره اعراف آیه صد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.42,
   "end": 140.8,
   "text": "سوره اعراف آیه صد و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.8,
   "end": 144.82,
   "text": "سوره توبه آیه هشتاد و هفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.82,
   "end": 148.1,
   "text": "سوره توبه آیه نود و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.1,
   "end": 152.66,
   "text": "سوره یونس آیه هفتاد و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.66,
   "end": 155.68,
   "text": "سوره نحل آیه صد و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.68,
   "end": 158.28,
   "text": "سوره روم آیه پنجاه و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.28,
   "end": 161.48,
   "text": "سوره غافر آیه سی و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.48,
   "end": 170.86,
   "text": "سوره محمد صلى الله عليه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.86,
   "end": 176.76,
   "text": ". آیه شونزده و سوره منافقون آیه سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.76,
   "end": 179.96,
   "text": "البته آیه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.96,
   "end": 186.16,
   "text": "سر فصل هم قرار دادم شماره آیه شو، یه آیه دیگه‌ای هست که سر فصل قرار دادم رو یادم رفته شماره آیه شو بنویسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.16,
   "end": 189.08,
   "text": "كذلك يتبع الله على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.08,
   "end": 192.0,
   "text": "كل قلب متكبر جبار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.0,
   "end": 194.32,
   "text": "ببینید يتبع الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.32,
   "end": 197.52,
   "text": "على كل قلب متکبر. میگه خدای متعال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.52,
   "end": 202.06,
   "text": "این چنین خدای متعال مهر میزنه به همه دل‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.06,
   "end": 204.0,
   "text": "این آیه میفرماید دو تا خصوصیت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.0,
   "end": 206.0,
   "text": "متکبرن جبار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 206.0,
   "end": 210.14,
   "text": "حالا من این خصوصیت‌هایی که سبب شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.14,
   "end": 214.14,
   "text": "خدا مهر بزنه به دل این‌ها رو از تو این آیات درآوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.14,
   "end": 217.72,
   "text": "مختصراً به شما عناوینشو میگم بعد یکیشو توضیح میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.72,
   "end": 225.28,
   "text": "اولا متکبرن جبار تو دو تا آیه اومده یعنی دل‌هایی مهر میخورن که متکبرن و زورگوئن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.28,
   "end": 228.56,
   "text": "جبار هم بر وزن فعال یعنی خیلی اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.56,
   "end": 231.42,
   "text": "زورن، زورگویی‌ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.42,
   "end": 236.24,
   "text": "و بعدیش لا يسمعون میگه اینا اهل شنیدن نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 236.24,
   "end": 238.14,
   "text": "ش-ش-گوش خوبی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.14,
   "end": 240.96,
   "text": "اصلاً حال و حوصله شنیدن حرف حق ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.96,
   "end": 246.98,
   "text": "بعدیش الكافرین است. این‌ها اهل کفران نعمت و کفران حقایق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.98,
   "end": 248.7,
   "text": "دو بار لا يفقهون اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.7,
   "end": 251.62,
   "text": "اینا نمیفهمن. هرچی بهشون بگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 251.62,
   "end": 254.56,
   "text": "تو گوششون نمیره تو دلشون نمیشینه، نمیفهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.56,
   "end": 259.7,
   "text": "دو بار لا يعلمون اومده یعنی این‌ها اون علم لازم رو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.7,
   "end": 263.64,
   "text": "هرچی تو بهشون بگی اینا اصلاً خالین از اون علوم لازم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.64,
   "end": 268.04,
   "text": "معتدین اومده یعنی اهل ستم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.04,
   "end": 269.9,
   "text": "واتبعوا اهواءهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.9,
   "end": 274.28,
   "text": "این‌ها اهل تبعیت هوی–هوس‌های نفسانیشون هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.28,
   "end": 279.42,
   "text": "و آخریش که امروز من اینو یه نکته‌ای فقط درباره‌ش عرض می‌کنم آمنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.42,
   "end": 282.92,
   "text": "ثم كفروا. ما خیلی باید حواسمون به این باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.92,
   "end": 289.56,
   "text": "همین آیه سه منافقون میفرماید که ذلك بانهم آمنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.56,
   "end": 291.84,
   "text": "به خاطر این خدا این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.84,
   "end": 297.02,
   "text": "مهر زده به دلشون که این‌ها ایمان داشتن ثم كفروا سپس کافر شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.02,
   "end": 300.3,
   "text": "فطبع الله على قلوبهم فهم لا يفقهون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.3,
   "end": 302.72,
   "text": "و علت نفهمیشونم اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.72,
   "end": 304.84,
   "text": "که این‌ها از ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 304.84,
   "end": 307.58,
   "text": "برگشتن به کفر. ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.58,
   "end": 312.56,
   "text": "زنگ خطری بغل گوشمون هست و باید این صدا رو بشنویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 312.56,
   "end": 316.64,
   "text": "که هر آینه این امکان وجود داره که ما هم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 316.64,
   "end": 319.86,
   "text": "خدایی نکرده ایمان برگردیم به کفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 319.86,
   "end": 322.88,
   "text": "بسیاری تو زمانه خودمون من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.88,
   "end": 327.62,
   "text": "قسم می‌خورم عاشق‌تر از ما، عالم‌تر از ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.62,
   "end": 334.5,
   "text": "و پیشتازتر از ما تو جبهه‌های مختلف، صفوف مقدم از حیث مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.5,
   "end": 338.46,
   "text": "بودند و الان صفشون رو از ما جدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.46,
   "end": 343.94,
   "text": "اهل ایمان هم بودند، اهل انقلاب بودند، اهل هیئت و مسجد بودند، الان فحش میدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.94,
   "end": 350.5,
   "text": "ناسزا میگن. بسیار متأسفانه بچه شیعه سراغ داریم که مسیحی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.5,
   "end": 352.98,
   "text": "اصلاً laik شدن، شیطان پرست شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.98,
   "end": 356.84,
   "text": "من زیاد سراغ دارم دور و ورم چون مراجعه به ما میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.84,
   "end": 359.56,
   "text": "پدر میاد درد دل میکنه پسرم اینطوری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.56,
   "end": 362.14,
   "text": "مادره میاد درد دل میکنه دخترم اینطوری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.14,
   "end": 365.28,
   "text": "طرف میاد میگه رفیقم هیئتی بوده اینطوری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.28,
   "end": 367.3,
   "text": "زیاده‌ها. گمان نکنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.3,
   "end": 369.92,
   "text": "ما مصونیت کامل داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.92,
   "end": 376.42,
   "text": "اصلاً یکی از حالا وجوه مختلفی داره دلایل اینکه اینس-انسان به اینجا کشیده میشه کارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 376.42,
   "end": 379.74,
   "text": "اما یکی از دلایل مهم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 379.74,
   "end": 383.8,
   "text": "انسان از ایمان به کفر کشیده میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.8,
   "end": 387.18,
   "text": "جدایی از جمع اهل ایمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.18,
   "end": 391.28,
   "text": "کنار کشیدن از اجتماع مؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.28,
   "end": 394.84,
   "text": "خصوصاً خالی کردن درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.84,
   "end": 400.34,
   "text": "علما، منبر بزرگان، علماها، نه من بچه طلبه، علما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 400.34,
   "end": 405.02,
   "text": "مراجع ما، بزرگان ما، اساتید اخلاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.02,
   "end": 408.18,
   "text": "اینکه اونها درسشون خالی بشه این زنگ خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 408.18,
   "end": 411.02,
   "text": "جلساتشون خلوت بشه قیامتم شکایت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 411.02,
   "end": 417.82,
   "text": "زنگ خطر برای ماست. ببینید من میدیدم که خیلی جالبه این روایت خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 417.82,
   "end": 422.14,
   "text": "ز-زنگ خطر بزرگیه برای ما که از حضرت موسی...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.14,
   "end": 424.32,
   "text": "مثلا این، این خود این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.32,
   "end": 427.38,
   "text": "روایتی که من عرض می‌کنم کل مطرح توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.38,
   "end": 433.92,
   "text": "از حضرت موسی علیه النبيان و آله و علیه الصلاة والسلام میدونید خیلی فراز و نشیب داشت زندگی این بزرگوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 433.92,
   "end": 438.62,
   "text": "ازش سؤال کردن سخت‌ترین لحظه عمر شما کی بود یا کریم الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 438.62,
   "end": 443.7,
   "text": "به نظر شما چی جواب داده؟ حضرت فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 443.7,
   "end": 446.98,
   "text": "اون لحظه‌ای که استادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.98,
   "end": 453.38,
   "text": "حضرت خضر به من فرمود هاذا فراغ بينی و بينك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 453.38,
   "end": 455.42,
   "text": "این دیگه جدایی من است با تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.42,
   "end": 459.62,
   "text": "تو اون سه تا حرکت که انجام داد، تو قرآن می‌فرماید همه می‌دونید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.62,
   "end": 465.98,
   "text": "اون بچه رو کشت و کشتی رو سوراخ کرد و اون دیواره ریخته شده رو ترمیم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 465.98,
   "end": 468.7,
   "text": "بعد حضرت موسی صبوری نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 468.7,
   "end": 471.08,
   "text": "صبر نشون حلم به خرج نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.08,
   "end": 473.76,
   "text": "اینجا حضرت خضر فرمود حالا که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 473.76,
   "end": 480.04,
   "text": "سکوت نمی‌کنی، صبوری نداری، اینجا حلم به خرج نمیدی هاذا فراغ بينی و بينك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.04,
   "end": 482.08,
   "text": "دیگه بین من و تو جدایی افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.08,
   "end": 488.36,
   "text": "تموم. میگه سخت‌ترین لحظه عمر من حضرت موسی میگه اون لحظه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.36,
   "end": 496.3,
   "text": "آیا ما وقتی که بین ما و استادمون، بین ما و عالممون، بین ما و رفیق مؤمن‌مون جدایی می‌افته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.3,
   "end": 498.31,
   "text": "این درد رو احساس می‌کنیم اصلاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.31,
   "end": 501.06,
   "text": "یه حدیث عجیب برای شما بگم واقعاً این عج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 501.06,
   "end": 505.72,
   "text": "از عجائبه و روانشناسا باید بزنن کنار کنار این حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.72,
   "end": 512.28,
   "text": "مولا. حضرت فرمودن که وقتی دو تا مؤمن اهل ایمان از هم جدا میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.28,
   "end": 515.82,
   "text": "اصلاً باید اینطوری باشه. اگه نباشه باید شک کرد به ایمانشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 515.82,
   "end": 521.36,
   "text": "فرمود دردی رو احساس می‌کنند که انگار عضوی از بدنشون جدا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.36,
   "end": 525.18,
   "text": "مثلا شما الان خداحافظی می‌کنی با رفیق مؤمنت میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.18,
   "end": 532.54,
   "text": "آیا واقعاً انقدر درد تو وجودت می‌شینه این جدایی از رفیق مؤمنت که انگار دستتو قطع کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.54,
   "end": 535.16,
   "text": "پاتو قطع کردن، چشاتو درآوردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 535.16,
   "end": 539.58,
   "text": "اگه نیست این توحید و این ایمان تثبیت نشده تو وجود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 539.58,
   "end": 545.8,
   "text": "این‌ها فرمایشات گوهربار امیرالمؤمنین و اهل بیت عصمت و طهارت، آیات قرآن و تفاسیرشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 545.8,
   "end": 549.3,
   "text": "که این‌ها نهیب باید به ماها بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 549.3,
   "end": 556.96,
   "text": "هر وقت ما میل پیدا کردیم از اهل ایمان جدا شیم، ولش کن بابا، هیئت چیه، مسجد چیه، جماعت مؤمنین چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 556.96,
   "end": 560.88,
   "text": "خودم و عشقه. رفتیم تو انزوا و تو لاک خودمون، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 560.88,
   "end": 564.56,
   "text": "زنگ خطره. این احتمال داره که قلبمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 564.56,
   "end": 568.34,
   "text": "نهایت به جایی بکشه که مهر بزنه خدا بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 568.34,
   "end": 574.4,
   "text": "اتفاقاً یکی از حالا شما که اخیراً از اربعین هم اومدید، خیلی هم نگذشته، کمتر از یک ماه شاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 574.4,
   "end": 582.1,
   "text": "فرمودن که یکی از راهکارهای خوب نگهداری نور زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 582.1,
   "end": 586.64,
   "text": "ارتباط با اهل ایمانه، با دوستداران اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 586.64,
   "end": 589.22,
   "text": "میگه با امام زمانو که نمی‌تونی ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 589.22,
   "end": 591.84,
   "text": "برو با اهل بیت، با اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 591.84,
   "end": 595.2,
   "text": "محبت اهل بیت بشین، با اهل ایمان بشین، رفاقت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 595.2,
   "end": 602.54,
   "text": "هر وقت احساس کردی دوست نداری، بدت میاد، کینه پیدا کردی، خوشت نمیاد از جماعت ایمان به ایمانت شک کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 602.54,
   "end": 606.22,
   "text": "نه به اهل ایمان. همه که کامل نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 606.22,
   "end": 611.42,
   "text": "به قول اهل بیت فرمودن اگر دنبال آدم کامل بگردی همیشه تنها می‌مونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 611.42,
   "end": 615.08,
   "text": "هیچ‌کس کامل نیست جز اهل بیت علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 615.08,
   "end": 618.84,
   "text": "پس باید مراقب این ارتباطمون با اهل ایمان باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 618.84,
   "end": 623.54,
   "text": "البته عرفا از این استفاده‌های پیرامون امامت کردن حالا اونش بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 623.54,
   "end": 626.2,
   "text": "و هاذا فراغ بينی و بينك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 626.2,
   "end": 630.42,
   "text": "که دردناک‌ترین اتفاق زندگی موسی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 630.42,
   "end": 633.58,
   "text": "چطور برای ما دردناک نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 633.58,
   "end": 637.24,
   "text": "ندیدن امام عصرمون، جدایی از امام عصرمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 637.24,
   "end": 641.32,
   "text": "اللهم انا نشکو الیک فقد نبينا و غیبه ولینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 641.32,
   "end": 645.4,
   "text": "اصلاً انگار نه... عزيزا علی ان ارى الخلق و لا تراك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 645.4,
   "end": 648.32,
   "text": "همه رو می‌بینیم جز تو. حالا این بحثش بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 648.32,
   "end": 651.22,
   "text": "در هر حال هر وقت ختم کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 651.22,
   "end": 653.82,
   "text": "چ-- دوست داشتیم، میل پیدا کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 653.82,
   "end": 661.02,
   "text": "انزوا و دوری و جدایی از اهل ایمان و بزرگان، علما، اهل علم، اهل معرفت رو بترسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 661.02,
   "end": 664.56,
   "text": "که زنگ خطر بغل گوشمون خورده، مبادا مهر بخوره به دلمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 664.56,
   "end": 666.96,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 666.96,
   "end": 670.32,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 670.32,
   "end": 673.52,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 673.52,
   "end": 675.72,
   "text": "محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 675.72,
   "end": 677.86,
   "text": "آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 677.86,
   "end": 679.54,
   "text": "قد قضي، بارک الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}