 "chapters": [
  {
   "index": 0,
   "title": "## عدول نیت از نماز دوم به اول",
   "start": 1.8,
   "end": 128.16
  },
  {
   "index": 1,
   "title": "## قلب مطبوع؛ مهر بر دلِ متکبر جبار",
   "start": 128.16,
   "end": 227.82
  },
  {
   "index": 2,
   "title": "## روایت کافی؛ ثروتمند و فقیر نزد پیامبر",
   "start": 227.82,
   "end": 366.14
  },
  {
   "index": 3,
   "title": "## مگس و ذلیل کردن جباران؛ سفینة البحار",
   "start": 366.14,
   "end": 473.8
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.8,
   "end": 5.22,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.22,
   "end": 9.74,
   "text": "السلام علیک یا داعی الله و ربانی ایه آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.74,
   "end": 12.5,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.5,
   "end": 14.72,
   "text": "قبلا عرض کرده بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.72,
   "end": 18.98,
   "text": "اگر چنانچه انسان اشتباها نماز دوم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.98,
   "end": 23.42,
   "text": "شروع کنه به خوندن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.42,
   "end": 29.4,
   "text": "متوجه بشه بین نماز دوم که نماز اولش رو نخوانده مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.4,
   "end": 32.52,
   "text": "عصر رو داره میخونه یادش بیفته که ظهر نخوانده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.52,
   "end": 34.62,
   "text": "عشا رو میخونه یادش بیفته مغرب رو نخوانده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.62,
   "end": 41.06,
   "text": "اینجا وظیفه اش اینه که برگرده نیت کنه به نماز اول و ادامه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.06,
   "end": 48.8,
   "text": "مگر اختصاصا در خصوص نماز مغرب اگه تو عشا باشه در صورتی میتونه نیتو عدول کنه که گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.8,
   "end": 51.3,
   "text": "به رکوع رکعت چهارم نرسیده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.3,
   "end": 56.1,
   "text": "اگر به رکوع رکعت چهارم رسید یادش افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.1,
   "end": 63.1,
   "text": "رهبری می فرمایند که همون نماز عشاشو تموم کنه بعد مغرب رو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.1,
   "end": 66.1,
   "text": "منتها احتیاط کرده رهبر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.1,
   "end": 73.1,
   "text": "بعد از این یه مغرب و عشا دوباره احتیاطاً بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.1,
   "end": 75.12,
   "text": "این احتیاطش هم میتونه انجام نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.12,
   "end": 81.26,
   "text": "همون نیت- نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.26,
   "end": 85.3,
   "text": "یا دو کار میتونه بکنه یا اینکه اگه رفته باشه رکعت چندم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.3,
   "end": 88.46,
   "text": "چهارم یعنی ورود کرده باشه به رکوع رکعت چهارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.46,
   "end": 95.22,
   "text": "اگه ورود نکرده به رکوع رکعت چهارم باید نیتو برگرده و نماز مغرب سه رکعتی تموم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.22,
   "end": 100.08,
   "text": "اگه ورود کرده به رکعت چهارم رفته رکوع، اینجا دو کار میتونه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.08,
   "end": 105.56,
   "text": "یا اینکه نیت عشا رو بکنه همون که عشا بوده تموم کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.56,
   "end": 109.64,
   "text": "بعد یه مغرب بخونه یا اینکه نه، وقتی تموم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.64,
   "end": 114.2,
   "text": "مغرب و عشا رو با هم دوباره بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.2,
   "end": 119.12,
   "text": "بله از رکوعش. اگر به رکوع نرفته میتونه نیت مغرب کنه بشینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.12,
   "end": 121.44,
   "text": "بشینه تشهد سلام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.44,
   "end": 127.22,
   "text": "به رکعت، به رکوع رکعت چهارم رفت دیگه نمیتونه نیت سه رکعتی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.22,
   "end": 137.8,
   "text": "خب بحث ما بحث قلوب بود و رسیدیم به دومین قلب در قرآن که به نام قلب مطبوع با طاء دسته و عین بود یعنی قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 137.8,
   "end": 143.22,
   "text": "مهر خورده. و نکته ای را هم امروز عرض کنیم که دیگه از این قلب رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 143.22,
   "end": 149.38,
   "text": "وقتی دقت کنید به آیاتی که امروز عرض کردیم که پیرامون قلب مطبوع هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 149.38,
   "end": 153.72,
   "text": "یکی از بخش‌های این آیات که خیلی هم مهم به نظر میرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 153.72,
   "end": 161.96,
   "text": "اینجا که می فرماید \"کذلک یتبع الله على کل قلب متکبر جبار\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 161.96,
   "end": 165.58,
   "text": "خدا مهر میزنه آیه سی و پنج سوره قاف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 165.58,
   "end": 169.12,
   "text": "مهر میزنه به همه دل‌هایی که متکبر و جبارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 169.12,
   "end": 172.46,
   "text": "این نهیب بزرگیست. یعنی هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 172.46,
   "end": 177.86,
   "text": "کسی که دچار تکبر و زورگویی بشه قطعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 177.86,
   "end": 182.24,
   "text": "خدا مهر میزنه بهش. برای همین خیلی خطر بزرگ یک چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 182.24,
   "end": 187.02,
   "text": "تکبر که ریشه گناهان کبیره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 187.02,
   "end": 189.66,
   "text": "متکبرن جبار. باید خودمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 189.66,
   "end": 195.5,
   "text": "بترسونه که سعی کنیم تا اونجایی که میشه ریشه تکبر رو تو وجودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 195.5,
   "end": 199.68,
   "text": "بخوشکونیم. غالبا اینطوریه که ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 199.68,
   "end": 203.06,
   "text": "گرفتار هستیم، توجه نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 203.06,
   "end": 207.22,
   "text": "به رفتارمون وقتی توجه میکنیم میفهمیم که گرفتاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 207.22,
   "end": 212.56,
   "text": "مثلا نحوه سلام دادنمون با یه، با یه آدم پولدار، با یه آدم فقیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 212.56,
   "end": 216.18,
   "text": "با یه آدم معروف، با یه آدم غریب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 216.18,
   "end": 218.06,
   "text": "با یه آدم ظاهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 218.06,
   "end": 220.0,
   "text": "تمیز، با یه آدم ظاهرا کثیف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 220.0,
   "end": 227.4,
   "text": "اینا همه نشون میده که ما دچار تکبر هستیم یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 227.4,
   "end": 229.74,
   "text": "شخصی در کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 229.74,
   "end": 235.8,
   "text": "کافی معلون کلینی اعل الله مقام شریف جلد سه صفحه دویست و شصت و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 235.8,
   "end": 239.54,
   "text": "یه روایتی داره که تو همین مضمون میگه پیغمبر نشسته بود یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 239.54,
   "end": 245.42,
   "text": "ثروت مندی اومد پیش پیغمبر نشست بلافاصله یه فقیرم اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 245.42,
   "end": 247.8,
   "text": "کنار این ثروت منده نشست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 247.8,
   "end": 251.56,
   "text": "تا فقیره نشست ف-- این ثروت منده خودش یه ذره جمع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 251.56,
   "end": 254.78,
   "text": "به قول ما دامنشو جمع کرد. پیغمبر ناراحت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 254.78,
   "end": 262.42,
   "text": "رو کرد به این آدم ثروتمند گفت چیه ترسیدی از ثروتش به این برسه یا از فقر اون به تو برسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 262.42,
   "end": 269.16,
   "text": "طرف ناراحت شد از این حرکت خودشو گفت یا رسول الله من حاضرم جبران کنم نصف ثرو-- خیلی هم آدم متوکل بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 269.16,
   "end": 273.4,
   "text": "نصف ثروتمو میبخشم به این فقیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 273.4,
   "end": 277.46,
   "text": "پیغمبر رو کرد به این فقیر گفت تو قبول میکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 277.46,
   "end": 279.92,
   "text": "گفت نه یا رسول الله. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 279.92,
   "end": 282.26,
   "text": "گفت میترسم منم اینطوری بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 282.26,
   "end": 286.0,
   "text": "نمیخوام ثروتی که باعث تکبر بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 286.0,
   "end": 289.74,
   "text": "نمیخوام. أخاف أن یدخلنی ما دخل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 289.74,
   "end": 295.52,
   "text": "دخلک. من میترسم اون چیزی که این درش داخل شده منم داخل بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 295.52,
   "end": 297.7,
   "text": "معمولا اینطوریه. عنوان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 297.7,
   "end": 302.06,
   "text": "مدرک تحصیلی، نژاد، نمیدونم پول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 302.06,
   "end": 310.62,
   "text": "حتی تیپ، قیافه، مدیریت، پست، شغل اینها متاسفانه به جای اینکه باعث بشه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 310.62,
   "end": 315.8,
   "text": "افتاده تر، افتاده حال تر بشه و اهل خدمت بشه برعکس میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 315.8,
   "end": 319.62,
   "text": "تمام از مدیرانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 319.62,
   "end": 324.16,
   "text": "خودشیفته و متکبرن که هرچی میکشیم از دست ایناست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 324.16,
   "end": 326.92,
   "text": "مرحبا به مدیرانی که هرچی اتفاقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 326.92,
   "end": 329.38,
   "text": "ترازشون میره بالاتر افتاده حال تر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 329.38,
   "end": 332.62,
   "text": "افتاده حال تر میشن. شما رفتن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 332.62,
   "end": 336.42,
   "text": "کرمانشاه رهبری رو مقایسه کنید با بعضی از مسئولین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 336.42,
   "end": 339.14,
   "text": "رهبر رفت تو دل مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 339.14,
   "end": 342.96,
   "text": "اصلا خ-- این بادیگاردها ترسیده بودن که بلایی سر آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 342.96,
   "end": 346.82,
   "text": "رفت حتی نعل ایناش و عباشون همه گل و خالی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.82,
   "end": 352.34,
   "text": "لابلای مردم. ولی بعضی از مسئولین ما از همون بالا ماشین جرات نکردن پیاده شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 352.34,
   "end": 356.46,
   "text": "همون بالا ماشین. انگار میخوان سان ببینن ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 356.46,
   "end": 359.3,
   "text": "امام فرمود اینا ولی نعمت ما مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 359.3,
   "end": 366.14,
   "text": "حالا اون مسئولی که اینطوری با مردم رفتار میکنه هیچوقت تو دل مردم جا نمیکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 366.14,
   "end": 372.5,
   "text": "در کتاب سفینه البحار جلد یک صفحه هشتصد و چهل هم یه روایت جالبی بود اینم بگم و بسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 372.5,
   "end": 376.92,
   "text": "که خیلی جالبه این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 376.92,
   "end": 379.08,
   "text": "ااا یه ذره هم خنده داره هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 379.08,
   "end": 385.74,
   "text": "واقعا جالبه که منصور دوانیقی ملعون نشسته بود امام صادق هم پیشش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 385.74,
   "end": 388.2,
   "text": "این ملعون هی یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 388.2,
   "end": 395.78,
   "text": "مگسی میشست رو دماغش رو صورتش هر کاری کرد زورش نرسید این مگس رو دفع کنه دوباره مگسه برمی‌گشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 395.78,
   "end": 398.62,
   "text": "اعصابش خورد شد به امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 398.62,
   "end": 403.0,
   "text": "گفت آقا این فلسفه خلقت مگس چیه آخه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 403.0,
   "end": 406.04,
   "text": "خدا برا چی مگس رو خلق کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 406.04,
   "end": 408.78,
   "text": "خیلی قشنگ آقا جواب داده فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 408.78,
   "end": 413.12,
   "text": "اون سوالش این بود \"لأي شيء ان خلق الله الذباب؟\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 413.12,
   "end": 415.24,
   "text": "چرا خدا این بشو مگس رو خلق کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 415.24,
   "end": 420.66,
   "text": "جواب آقا رو ببینید. قال علیه السلام \"لیذل به الجبارین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 420.66,
   "end": 424.08,
   "text": "برای اینکه همین مگس ذلیل کنه آدمای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 424.08,
   "end": 427.1,
   "text": "جبار و متکبر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 427.1,
   "end": 431.8,
   "text": "واقعا هم اینطوریه. آدمو به ذلت و خاری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 431.8,
   "end": 434.5,
   "text": "اون حالات تکبر میکشونه پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 434.5,
   "end": 437.06,
   "text": "تکبر خیلی خطرناکه یعنی باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 437.06,
   "end": 442.96,
   "text": "ریز بشیم تو کارهامون تا متوجه بشیم که هستیم یا نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 442.96,
   "end": 449.06,
   "text": "زنگ خطر بزرگیه که اگر کسی رعایت نکنه، مراقبت نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 449.06,
   "end": 453.04,
   "text": "دلش مهر میخوره. دیگه هرچی حقایق، آیه قرآن هم هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 453.04,
   "end": 456.5,
   "text": "هرچی میان تو گوشش حقایقو میگن باز حرف خودشو میپذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 456.5,
   "end": 459.28,
   "text": "اصلا و ابدا زیر بار حرف حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 459.28,
   "end": 462.06,
   "text": "نمیره. خیلیا هم اینطورین ها، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 462.06,
   "end": 463.84,
   "text": "ایشالا ما جزو اون دسته نباشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 463.84,
   "end": 468.68,
   "text": "عاقبتمون به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 468.68,
   "end": 473.8,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}