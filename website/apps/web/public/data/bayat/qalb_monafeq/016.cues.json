 },
 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 13.34,
   "end": 312.92
  },
  {
   "index": 1,
   "title": "## نمازِ امام حسین پیش از گرهٔ سخت",
   "start": 312.92,
   "end": 441.54
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.18,
   "end": 5.52,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.52,
   "end": 9.18,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.18,
   "end": 13.24,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.24,
   "end": 16.34,
   "text": "یه استفتایی که پیرامون مسافت شرعی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.34,
   "end": 19.74,
   "text": "ترخص از رهبر عزیز شده این هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.74,
   "end": 27.9,
   "text": "گفتن ما از ابتدا خب می‌خوایم یه مسیری رو بریم که اون مسافت شرعی هست یعنی می‌دونیم که قطعاً ما مسافر می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.9,
   "end": 31.22,
   "text": "لکن در بین راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.22,
   "end": 34.2,
   "text": "نیت می‌خوایم بکنیم که در صورتی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.2,
   "end": 38.2,
   "text": "عرض شود، در صورتی این مسافت، مسافت شرعی می‌شه که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.2,
   "end": 44.24,
   "text": "نیت کردیم وسط راه دقت بفرمایید از مسیر اصلی منحرف شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.24,
   "end": 50.64,
   "text": "بریم یه مسیر فرعی، یه کاری انجام بدیم، کسی رو ببینیم، دو مرتبه برگردیم به مسیر اصلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.64,
   "end": 53.22,
   "text": "با توجه به اون مسافتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.22,
   "end": 60.76,
   "text": "حالا به قول ما تو خاکی می‌زنیم یا میریم تو یه مسافت ش-فرعی دیگه‌ای بر می‌گردیم بعد ادامه سفر میدیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.76,
   "end": 63.5,
   "text": "اون رو وقتی ضمیمه می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.5,
   "end": 69.42,
   "text": "مسافت شرعی می‌شه. یعنی چهار فرسخ یا حد به قول رهبری بیست کیلومتر و نیم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.42,
   "end": 75.4,
   "text": "اگر اون مسافت فرعی رو، قسمت فرعی وسط کار می‌خوایم بریم یه جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.4,
   "end": 81.18,
   "text": "بین مسیر یکی رو ببینیم و برگردیم، اونو برداری مسافت شرعی نیست مثلاً سه فرسخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.18,
   "end": 84.44,
   "text": "اینجا تکلیف چی می‌شه؟ سؤال مهمیه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.44,
   "end": 90.38,
   "text": "ببینید میگه که من می‌خوام برم، شما گفتید که چهار فرسخ حداقل رفتت باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.38,
   "end": 95.76,
   "text": "اما من در صورتی چهار فرسخ می‌شه که در مسیر اصلی منحرف شم برم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.76,
   "end": 102.9,
   "text": "یه جایی از اول هم قصد داشتم این کارو بکنم، یکی رو ببینم، برگردم تو مسیر اصلی دوباره برم به محلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.9,
   "end": 105.0,
   "text": "به شهری که حالا قصد کردم برسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.0,
   "end": 108.24,
   "text": "اگه اون مسیر فرعیه رو هم اضافه کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.24,
   "end": 112.2,
   "text": "چهار فرسخ می‌شه. اگر اونو منها کنم چهار فرسخ نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.2,
   "end": 116.84,
   "text": "اینجا چه کنیم؟ رهبری فرمودن اون مسیر فرعی ملاک نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.84,
   "end": 119.7,
   "text": "اضافه کردن اون مسیر فرعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.7,
   "end": 123.72,
   "text": "ملاک میزان مسافت شرعی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.72,
   "end": 126.66,
   "text": "باید مسیر اصلی رو در نظر بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.66,
   "end": 129.22,
   "text": "مسیری که اصلی که داری میری یه شهری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.22,
   "end": 132.02,
   "text": "حالا قصد کردی بری. اگه کمتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.02,
   "end": 139.52,
   "text": "اون شهری که قصد کردی اگر ک-- با وطن خودت کمتر از چهار فرسخه یعنی بیست کیلومتر و نیم کمتره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.52,
   "end": 141.12,
   "text": "دیگه شما مسافر نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.12,
   "end": 147.1,
   "text": "ولو وسط راه بری یکی رو ببینی کاری انجام بدی دو مرتبه برگردی به مسیر اصلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.1,
   "end": 149.96,
   "text": "خب این ظرافت‌های احکامه که باید دقت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.96,
   "end": 154.84,
   "text": "در خصوص قلب منافق یه حدیث دیگه‌ای عرض کنیم امروز که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.84,
   "end": 157.0,
   "text": "خیلی حدیث محوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.0,
   "end": 160.4,
   "text": "مستدرک الوسائل، جلد چهار، صفحه نود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.4,
   "end": 162.94,
   "text": "امام باقر صلوات الله علیه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.94,
   "end": 165.98,
   "text": "که \"لا تقم الی الصلاة متکاسلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.98,
   "end": 168.42,
   "text": "متکاسلا یعنی با کسالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.42,
   "end": 171.02,
   "text": "نرو تو نماز. نماز نخون با کسالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.02,
   "end": 173.86,
   "text": "دیگه چی؟ \"ولا متناعسا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.86,
   "end": 175.86,
   "text": "در حالت خواب آلودگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.86,
   "end": 177.84,
   "text": "نه، نماز نخون تو این حالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.84,
   "end": 180.86,
   "text": "\"ولا متثاقلا\" از ثقل میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.86,
   "end": 184.1,
   "text": "در حالی که سنگینی، بیحالی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.1,
   "end": 187.24,
   "text": "حال نماز نداری. میگه تو این حال‌هات چیکار کن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.24,
   "end": 193.68,
   "text": "نماز نخون. \"فان الله\" امام باقر صلوات الله علیه می‌فرماید \"فان الله نهی المؤمنین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.68,
   "end": 195.84,
   "text": "خدا نهی کرده اهل ایمان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.84,
   "end": 198.6,
   "text": "\"ان يقوموا الی الصلاة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.6,
   "end": 201.12,
   "text": "که نماز بخونن، اقامه نماز کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.12,
   "end": 208.8,
   "text": "\"و هم سکارى\" در حالی که قرآن میگه، آیه قرآن امام باقر صلوات الله علیه می‌فرماید که قرآن گفته در حالتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.8,
   "end": 211.44,
   "text": "مثلاً حالت خوشی نداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.44,
   "end": 215.24,
   "text": "نماز نخونید. بعد حضرت می‌فرماید \"یعنی من النوم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.24,
   "end": 219.0,
   "text": "حضرت یکی از تعابیر این آیه رو اینجا بیان می‌کنه، می‌گه خواب آلودگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.0,
   "end": 223.06,
   "text": "می‌گه بیحالی، خواب آلودگی، کسلی، سنگینی نماز نخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.06,
   "end": 226.8,
   "text": "حالا یه مع-- بعد حضرت می‌فرماید که این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.8,
   "end": 230.94,
   "text": "می‌فرماید \"فانها من خلل نفاق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 230.94,
   "end": 233.58,
   "text": "این خلل نفاق در وجود آدمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.58,
   "end": 235.58,
   "text": "حالا دو تا، دو تا وجه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.58,
   "end": 239.98,
   "text": "یا اینکه اینطور نماز خوندن نشانه نفاقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.98,
   "end": 247.18,
   "text": "یا اینکه نه، اینطور نماز خوندن انسان خللی در وجود انسان ایجاد می‌کنه که انسان رو به سمت نفاق می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.18,
   "end": 250.82,
   "text": "دوتاش هم می‌شه برداشت کرد. هر دوتاش هم می‌شه برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.82,
   "end": 253.68,
   "text": "در هر حال باید مراقب باشیم. نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.68,
   "end": 256.34,
   "text": "خط قرمز از حدود الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.34,
   "end": 258.44,
   "text": "در حقیقت نماز مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.44,
   "end": 261.88,
   "text": "می-می‌خوای بری چکاپ کامل کنی پیش دکتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.88,
   "end": 267.3,
   "text": "دقیقاً نماز اونطور که از معارف الهی برمی‌آد اون چکاپ کامله در برابر خداست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.3,
   "end": 269.64,
   "text": "وضعیتتو با خدا مشخص می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.64,
   "end": 271.76,
   "text": "لذا آیه بهجت فرمود نماز نخون حال کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 271.76,
   "end": 274.22,
   "text": "نماز بخون ببینی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.22,
   "end": 275.88,
   "text": "طی روزت چگونه گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 275.88,
   "end": 277.84,
   "text": "اگر خوب گذشته نمازت باحاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 277.84,
   "end": 280.96,
   "text": "اگر بد گذشته یعنی این خط نفاقه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 280.96,
   "end": 283.62,
   "text": "اگر کسی قلبش سر خورده رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 283.62,
   "end": 290.42,
   "text": "نفاق پیدا کرده، دو رو شده نسبت به خدا احکام رو التزام عملی نداشته قطعاً نماز خوبی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.42,
   "end": 296.0,
   "text": "لذا امیرالمؤمنین صلوات الله علیه فرمود اگر کسی سحر هر کاری می‌کنه پا نمی‌شه برای نماز یا نماز صبحش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 296.0,
   "end": 300.46,
   "text": "لب طلایی می‌شه یا اصلاً نمی‌خونه، نمی‌تونه درست حسابی، این قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 300.46,
   "end": 304.48,
   "text": "بدون که مقید شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.48,
   "end": 306.68,
   "text": "گرفتار شده، محدود شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 306.68,
   "end": 309.0,
   "text": "به چی؟ به گناه، به معصیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 309.0,
   "end": 310.96,
   "text": "این گناه و معصیت همونه که انسان رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 310.96,
   "end": 315.3,
   "text": "جالبه که بدونید همه بزرگان ما اینم بگم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 315.3,
   "end": 324.34,
   "text": "به این توجه کنید حتی اهل بیت علیهم السلام کارهای دشوار می‌خواستن بکنن، بابا امام معصوم اول نماز می‌خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 324.34,
   "end": 327.5,
   "text": "امام حسین. یه داستان ازش می‌گم همه هم اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.5,
   "end": 329.92,
   "text": "متاسفانه قصه‌ش کشیده می‌شه به کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 329.92,
   "end": 333.1,
   "text": "اون آخرشو شنیدیم و دیدیم تو روایات اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 333.1,
   "end": 336.32,
   "text": "خیلی مفصله. تو چند تا کتاب هم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 336.32,
   "end": 342.54,
   "text": "که اون شخصی که دست رو خانه کعبه گذاشت، حالا مفصله من وقت نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.54,
   "end": 345.34,
   "text": "م-مفصوشو بگم. یه زنی دست رو خانه کعبه گذاشته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.34,
   "end": 349.56,
   "text": "این خوشش اومد وسوسه شد. تو خونه خدا دست رو دست اون زنه گذاشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.56,
   "end": 352.22,
   "text": "و دستش چسبید به دست اون زن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 352.22,
   "end": 354.02,
   "text": "تو روایت می‌گه کنده نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 354.02,
   "end": 356.8,
   "text": "حاکم مکه گفت باید دستش قطع شه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 356.8,
   "end": 361.66,
   "text": "مردم بالا اشکالاتی کردن و گفتن آقا این-- فقط تنها کسی که می‌تونه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 361.66,
   "end": 364.36,
   "text": "مسئله رو حل کنه یکی از بچه‌های حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 364.36,
   "end": 367.8,
   "text": "پیداست آدم بافهم و شعوری بوده این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 367.8,
   "end": 370.0,
   "text": "گشتن امام حسین رو پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 370.0,
   "end": 375.46,
   "text": "امام حسین تشریف آوردن، ماجرا رو دیدن و شروع کردن دو رکعت نماز خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 375.46,
   "end": 377.38,
   "text": "امام حسینه دیگه. لب ترک کنه خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.38,
   "end": 380.94,
   "text": "اسم اعظم خداست. اما چرا نماز می‌خونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 380.94,
   "end": 384.04,
   "text": "یعنی این سره دیگه. این نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 384.04,
   "end": 386.32,
   "text": "برای کارهای سنگین آدم نما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 386.32,
   "end": 393.6,
   "text": "می‌خوای بیای اداره وزنه سنگینی بزنی، حالا هر کاری هست واقعاً هر چم آدم مسئولیتش بیشتره، سنگین تره بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 393.6,
   "end": 400.06,
   "text": "نماز بخونه. حالا دو رکعت نماز خوندن که حالا کاری به بقیه داستان نداریم که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 400.06,
   "end": 404.14,
   "text": "دعا کرد بعد با دست خودش دست اون مرد رو برداشت و کنده شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 404.14,
   "end": 406.9,
   "text": "نامرد می‌دونید این از چی-- چه کار دراومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 406.9,
   "end": 410.92,
   "text": "همون ساربانی از کار دراومد که تو کربلا اون جنایت رو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 410.92,
   "end": 413.86,
   "text": "انگشت مبارکه‌ها رو قطع کرد. همه این معلومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 413.86,
   "end": 417.82,
   "text": "این معجزه رو از امام حسین دید ولی بعد همونجا از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 417.82,
   "end": 421.84,
   "text": "معجزه ای که دید همونجا اومد خدمتکار امام حسین شد و ساربان شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 421.84,
   "end": 425.34,
   "text": "ولی کار به اونجا کشیده شد. این خاندان چقدر مظلوم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 425.34,
   "end": 428.54,
   "text": "خلاصه مطلب این که نماز کلیدواژه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 428.54,
   "end": 432.64,
   "text": "خیلی مهمه. اگه کسی می‌خواد خودش رو بشناسه از نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 432.64,
   "end": 434.38,
   "text": "ان شا الله عاقبت و مختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 434.38,
   "end": 437.5,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 437.5,
   "end": 441.54,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}