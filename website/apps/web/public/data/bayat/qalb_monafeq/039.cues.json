 "chapters": [
  {
   "index": 0,
   "title": "## قصد وطن و عدم اعراض",
   "start": 12.74,
   "end": 76.96
  },
  {
   "index": 1,
   "title": "## قلب نفاق و تسلیم امام",
   "start": 76.96,
   "end": 160.1
  },
  {
   "index": 2,
   "title": "## آیات ابتدایی حجرات؛ لا تقدموا",
   "start": 160.1,
   "end": 250.04
  },
  {
   "index": 3,
   "title": "## یغضون أصواتهم؛ امتحان قلب برای تقوا",
   "start": 250.04,
   "end": 407.94
  },
  {
   "index": 4,
   "title": "## اباالفضل؛ تسلیم محض و روضه",
   "start": 407.94,
   "end": 689.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 4.22,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.22,
   "end": 12.74,
   "text": "السلام علیک یا داعی الله و ربانی ایاته السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.74,
   "end": 15.92,
   "text": "سؤال این هستش که اگر کسی جایی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.92,
   "end": 19.22,
   "text": "قصد وطن کرده بود منتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.22,
   "end": 27.06,
   "text": "رفته بود جای دیگه ای ساکن شده بود، فعلاً برای مدت طولانی حتی اون جایی که وطنش بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.06,
   "end": 32.74,
   "text": "نرفته بود. مثلاً کسی تو تهران، تهران وطنش بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.74,
   "end": 37.1,
   "text": "اینجا رشد و نمو کرده. حالا رفته مثلاً کرج یه خونه گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.1,
   "end": 40.44,
   "text": "مدت طولانی یک کرج زندگی میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.44,
   "end": 43.26,
   "text": "تهران دیگه نیست اما اعراض نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.26,
   "end": 50.9,
   "text": "اینو دقت کنید یعنی قصد اعراض یعنی پشت کردن اینکه دیگه مثلاً تهران وطنش نباشه قصد نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.9,
   "end": 57.9,
   "text": "آیا اینجا چون قصد اعراض نکرده ولو اینکه مدتیه تو وطن اصلیش نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.9,
   "end": 60.76,
   "text": "و قصد اعراض نکرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.76,
   "end": 64.3,
   "text": "آیا هنوز اونجا وطنش حساب میشه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.3,
   "end": 72.7,
   "text": "رهبر عزیزمون فرمودن چون قصد اعراض نکرده هنوز وطنش میشه ولو مدت طولانی اونجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.7,
   "end": 76.58,
   "text": "حواسمون باشه قصد اعراض خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.58,
   "end": 82.08,
   "text": "ما نکاتی رو که گفتیم دیگه بحث قلب نفاق رو یواش یواش سفره‌شو جمع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.08,
   "end": 87.32,
   "text": "اگرچه خیلی بحث‌ها موند دیگه ما متبرکاً میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.32,
   "end": 91.4,
   "text": "رسیدیم به اینکه ما هر مقدار تسلیم امام معصوم و احکام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.4,
   "end": 97.54,
   "text": "دین نباشیم، همون مقدار قلبمون به سمت نفاق متاسفانه سر خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.54,
   "end": 101.74,
   "text": "و بعد عرض کردیم که این تسلیم بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.74,
   "end": 106.34,
   "text": "می‌طلبه که ما تعلقاتمون با تعلقات امام یکی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.34,
   "end": 109.22,
   "text": "قلبی لقلبکم صرم رو توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.22,
   "end": 113.62,
   "text": "هر مقداری که تعلقات ما به تعلق امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.62,
   "end": 119.22,
   "text": "یکی نباشه، همون مقدار قطعاً تو چرخش روزگار یه روزی ما از امام جدا خواهیم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 119.22,
   "end": 123.36,
   "text": "القه‌های ما باید با القه‌های امام مطابقت داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 123.36,
   "end": 125.7,
   "text": "حالا این تصمیم چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.7,
   "end": 128.88,
   "text": "چرا ما باید انقدر تسلیم امام اصلاً باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.88,
   "end": 138.22,
   "text": "که اگر کسی تسلیم نبود در هر جزئی از اجزاء دین تسلیم نبود به همان مقدار دچار نفاق قلبی شده نسبت به امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 138.22,
   "end": 140.98,
   "text": "به دروغ میگه قلبی لقلبکم صرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 140.98,
   "end": 143.52,
   "text": "به دروغ میگه السلام علیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 143.52,
   "end": 145.94,
   "text": "سلام میده یا امام رئوف مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.94,
   "end": 148.78,
   "text": "این سلام گفتیم یه معناش تسلیمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.78,
   "end": 152.94,
   "text": "حالا که تو یه بخشی از گفته‌های امام رو قبول نداری سلامم میدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.94,
   "end": 156.0,
   "text": "این سلام از رو نفاقه. رک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.0,
   "end": 160.1,
   "text": "شوخی هم نداریم. اینا رو ما قبلاً با آیات و روایات ثابت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.1,
   "end": 164.5,
   "text": "اگر دقت بفرمایید در آیات ابتدایی سوره حجرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.5,
   "end": 166.78,
   "text": "می‌فرماید بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.78,
   "end": 170.36,
   "text": "عجیب آیاتیه. یا ایها الذین آمنوا لبیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.36,
   "end": 173.08,
   "text": "امام صادق فرمود اینجا بگید لبیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.08,
   "end": 175.78,
   "text": "چا-جانم خدا چی میخوای بگی به ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.78,
   "end": 179.46,
   "text": "لا تقدموا بین ید ید الله و رسوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.46,
   "end": 181.76,
   "text": "نکنید جلو، جلو بیفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.76,
   "end": 184.9,
   "text": "پیشقدم بشید از خدا و رسولش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.9,
   "end": 188.02,
   "text": "جلو بزنید. یعنی حرفی برای گفتن داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.02,
   "end": 190.54,
   "text": "واتقوا الله تقوا پیشه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.54,
   "end": 193.44,
   "text": "اصلاً این از شروط تقوا که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.44,
   "end": 199.82,
   "text": "جلو نیافتی از خدا و پیغمبرش از امام، از احکام دین، از خودت رأی و نظر صادر نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.82,
   "end": 201.94,
   "text": "آیه دو. یا-- خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.94,
   "end": 208.02,
   "text": "ببین دوباره میگه یا ایها الذین آمنو باز لبیک این نشون میده که خیلی قصه مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.02,
   "end": 213.08,
   "text": "دوباره خطاب می‌کنه. ادامه همون رو باز با خطاب به اهل ایمان میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.08,
   "end": 216.3,
   "text": "لا ترفعوا اصواتکم فوق صوت النبي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.3,
   "end": 218.6,
   "text": "اونایی که مکه رفتن، ما که نرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.6,
   "end": 220.54,
   "text": "ان‌شاءالله قسمت شه بریم، بالای سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.54,
   "end": 223.4,
   "text": "ضریح پیغمبر این آیه رو، این آیه رو زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.4,
   "end": 225.54,
   "text": "فقط اونجا ازش کاربرد گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.54,
   "end": 229.34,
   "text": "انقدر نفهمیدن. میگه صداتونو بالا نبرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.34,
   "end": 232.28,
   "text": "بالاتر از صدای پیغمبر. ولا تجهروا له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.28,
   "end": 234.28,
   "text": "بالقول كجهر بعضکم لبعض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.28,
   "end": 239.02,
   "text": "اونطور که بعضیا پیغمبر صدا می‌زنن شما صدا نزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.02,
   "end": 241.3,
   "text": "چی میشه اگه این کارو بکنی؟ ان ته--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.3,
   "end": 245.1,
   "text": "خیلی عجیبه. ان تهبط أعمالکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.1,
   "end": 250.04,
   "text": "باعث میشه همه اعمالتون هبط بشه، نابود بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.04,
   "end": 252.72,
   "text": "آیه سه. ان الذین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.72,
   "end": 255.96,
   "text": "خیلی این آیه دیگه عجیبا غریباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.96,
   "end": 259.78,
   "text": "ان الذین یغضون اصواتهم عند رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.78,
   "end": 264.26,
   "text": "اونایی که صداشون در وقتی محضر پیغمبرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.26,
   "end": 268.16,
   "text": "حالا امام هم که جلوه تام پیغمبره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.16,
   "end": 275.62,
   "text": "اینها نزد امامشون، نزد پیغمبرشون، نزد قرآن، نزد خدا و دین خدا هیچ س-- حرفی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.62,
   "end": 279.92,
   "text": "یغضون اصواتهم یعنی اصلاً حرفی برای گفتن ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.92,
   "end": 284.14,
   "text": "اینو ترجمه ای که مفسرین کردن من همه فهمشو عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.14,
   "end": 285.76,
   "text": "بعد اینجاشو میگم عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.76,
   "end": 287.98,
   "text": "این سرّ السر به خدا قسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.98,
   "end": 296.28,
   "text": "اون عزیزانی که تو اه-- مباحث پیشین ما بودن الان متوجه این قصه میشن که چرا من انقدر اصرار دارم این سرّ السر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.28,
   "end": 300.06,
   "text": "میگه اینایی که هیچ حرفی پیش پیغمبر، امام، قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.06,
   "end": 307.16,
   "text": "خدا ندارن .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.16,
   "end": 313.64,
   "text": "عجب. اینا همونایین که مورد امتحان قرار گرفتن و نمرشون بیست شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 313.64,
   "end": 315.58,
   "text": "آدمای متقی‌ان. چرا میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.58,
   "end": 317.44,
   "text": "چه ربطی به بحث سرّ السر داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.44,
   "end": 320.28,
   "text": "قبلاً ما روایاتی رو آورده بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.28,
   "end": 322.84,
   "text": "که یه جا می‌فرماید ان امرنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.84,
   "end": 329.96,
   "text": "یه جا می‌فرماید ان حدیث آل محمد صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.96,
   "end": 331.76,
   "text": "صعب مستصعب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.76,
   "end": 334.88,
   "text": "توجه داشته باشید می‌گفت صعب مستصعب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.88,
   "end": 339.2,
   "text": "خیلی دشواره حدیث ما فهمش، امر ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.2,
   "end": 341.82,
   "text": "حمل امر ما. لا يحمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.82,
   "end": 344.34,
   "text": "اصلاً نمیشه که کسی نمی‌تونه حمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.34,
   "end": 346.2,
   "text": "کسی نمی‌تونه بفهمه حدیث ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.2,
   "end": 348.7,
   "text": "ولایت ما رو کسی نمی‌تونه حمل کنه الا سه دسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.7,
   "end": 353.96,
   "text": "یادتونه؟ تو یه جا می‌فرماید عبد امتحن الله قلبه للإيمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.96,
   "end": 356.14,
   "text": "یه جا می‌فرماید سه دسته می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.14,
   "end": 359.64,
   "text": "میگه اون سه دسته یکیشون ملک مقرب بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.64,
   "end": 364.44,
   "text": "یکی نبی و مرسل بود، یکی هم باز عبد امتحن الله قلبه للإيمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.44,
   "end": 368.3,
   "text": "میگه فقط بنده‌ای که مورد امتحان خدا قرار گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.3,
   "end": 371.86,
   "text": "و این نمرش بیست شده. این میتونه بار ولایت ما رو برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.86,
   "end": 375.04,
   "text": "یعنی سر سوزنی دچار نفاق و دورویی نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.04,
   "end": 380.18,
   "text": "همه بار رو برداره و اون میتونه بفهمه حدیث ما اصلاً یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.18,
   "end": 381.98,
   "text": "این نو بودن چرا بهش میگن حدیث؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.98,
   "end": 389.34,
   "text": "چون نوئه. این حدیث، این نو بودن، تازه به تازه، نو به نو بودن امر ما رو او میفهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.34,
   "end": 394.98,
   "text": "بعد اینجا یه جور دیگه داره دوباره خدا تو این آیه سه سوره حجرات همون رو ترجمه میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.98,
   "end": 399.82,
   "text": "چی؟ میگه اینا اصلاً حرفی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.82,
   "end": 405.8,
   "text": ". اصلاً اینا صداشون انقدر پایینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.8,
   "end": 407.94,
   "text": ". هیچ حرفی برای گفتن ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.94,
   "end": 412.02,
   "text": "این همه نهج البلاغه بعد از شهادت پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 412.02,
   "end": 414.8,
   "text": "امیرالمؤمنین حرفی برای گفتن نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.8,
   "end": 420.44,
   "text": "این همه ید بیضا و عظمتی که برای اباالفضل العباس سلام الله عليه می‌شمردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 420.44,
   "end": 426.18,
   "text": "تو این کاشی‌هایی که روی لرستان اگه رفته باشید در سردر خونه‌هاشون زدن خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 426.18,
   "end": 431.2,
   "text": "الله و اسم چهار-- خمسہ طیبه ریز و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.2,
   "end": 438.02,
   "text": "بزرگ یا وسط یا پایین و بعضیا بالا زیر نام الله بزرگ نوشتن اباالفضل العباس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 438.02,
   "end": 440.92,
   "text": "از نام پیغمبر هم بزرگتر نوشتنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.92,
   "end": 445.72,
   "text": "این همه عظمتی که از حضرت اباالفضلیات می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 445.72,
   "end": 450.68,
   "text": "یه دلیلش اینه میگن اصلاً هیچ حرفی در برابر امام معصوم نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.68,
   "end": 454.36,
   "text": "حالا تحلیل خود واقعه عاشورا خودش یه قصه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.36,
   "end": 457.04,
   "text": "که اصلاً ذخیره روز عاشورا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.04,
   "end": 461.0,
   "text": "خودتون میدونید شاگرد رزم هم امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.0,
   "end": 464.72,
   "text": "علی هم امام حسن بوده و هم امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.72,
   "end": 467.38,
   "text": "ذخیره بهش وعده ذخیره بودن دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.38,
   "end": 470.16,
   "text": "به همین وعده ذخیره صبر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.16,
   "end": 477.1,
   "text": "همون روز ذخیره و وعده که رسیده وقتی میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.1,
   "end": 483.9,
   "text": "بذار برم تار و مار کنم که عرض کردیم تنها کسی که نگفته بذار برم فدات شم، شهید شم، انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 483.9,
   "end": 489.58,
   "text": "عظمت قائله برای شأن ولایت میگه بذار برم اینا رو تار و مار کنم از جلو پات ورشون دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 489.58,
   "end": 491.84,
   "text": "انقدر اعتماد به نفس داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 491.84,
   "end": 496.18,
   "text": "وقتی امیر آقا اباعبدالله می‌فرماد که \"برو آب بیار\"،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 496.18,
   "end": 501.66,
   "text": "\"چشم\". اصلاً اینطوری من به شما بگم این رو تحلیل رو حواستون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 501.66,
   "end": 508.08,
   "text": "نه اینکه با ناراحتی که متاسفانه مداح‌ها بد بیان می‌کنند با ضیغ صدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 508.08,
   "end": 513.92,
   "text": "اون نه برای اینکه برم آب بیارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 513.92,
   "end": 516.86,
   "text": "هم-- به همون قوت و قدرتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 516.86,
   "end": 521.76,
   "text": "شمشیر می‌زد به همون قوت و قدرت رفته آب بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 521.76,
   "end": 524.6,
   "text": "لذا اصلاً شهادت حضرت اباالفضل به خاطر آب بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 524.6,
   "end": 527.94,
   "text": "به خاطر آوردن آب. نه برای اصلاً جنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 527.94,
   "end": 531.82,
   "text": "تنها کسی که تو کربلا نجنگید اباالفضل العباس بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.82,
   "end": 534.38,
   "text": "تنها کسی که نجنگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.38,
   "end": 541.42,
   "text": "حالا اینا رو شما ببینید. اینا اگر روضه می‌خونیم در کنار آیات و روایات روضه بخونید ببینید چی گیرمون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.42,
   "end": 543.98,
   "text": "اگر کسی سر سوزن حرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 543.98,
   "end": 547.64,
   "text": "حدیث، اصلاً نظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 547.64,
   "end": 551.5,
   "text": "حتی از رو خیرخواهی. برادر ابی عبد الله داره از مدینه میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 551.5,
   "end": 554.36,
   "text": "خیرخواهی می‌کنه. میگه به نظر من نرو آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.36,
   "end": 560.72,
   "text": "فلان اینا. این چ-- چنین کسی به هر مقدار که نظر داره سر خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.72,
   "end": 563.34,
   "text": "نظر در برابر امام داری سر خوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.34,
   "end": 565.36,
   "text": "شوخی نداریم ما. تو کی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.36,
   "end": 567.54,
   "text": "من کی هستم که نظر داشته باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 567.54,
   "end": 569.32,
   "text": "بشین سر جات حرف نزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 569.32,
   "end": 571.84,
   "text": "لام تا کام. شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.84,
   "end": 575.18,
   "text": "کل زیارت عاشورا که عجیبه یک دوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.18,
   "end": 577.92,
   "text": "حالا همه اون سلام و لعنشو توجه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 577.92,
   "end": 581.0,
   "text": "یه بار بشینیم توجه کنیم به دعاهایی تو عاشورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 581.0,
   "end": 584.8,
   "text": "بشینیم توجه کنیم. من توجه کردم سرم درد گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 584.8,
   "end": 587.64,
   "text": "دعاهای تو زیارت عاشورا عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 587.64,
   "end": 590.46,
   "text": "اون همه ش-- تو زجه می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 590.46,
   "end": 599.38,
   "text": "مصیبت رو میگی. مصیبت ما اعظمها رو میگی که چی بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 599.38,
   "end": 605.44,
   "text": ". یا تو ز-- سجده آخر که دیگه مخلص کار اوج و عرش کار عاشوراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 605.44,
   "end": 615.08,
   "text": "میگه .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 615.08,
   "end": 617.16,
   "text": "میگه من با تو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 617.16,
   "end": 621.14,
   "text": "مقعد صدق باشم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 621.14,
   "end": 623.26,
   "text": "اما مع حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.26,
   "end": 626.3,
   "text": "معیت با اباعبدالله. به هر مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 626.3,
   "end": 629.28,
   "text": "که تو چون و چرا تو وجودت بیاری چرا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 629.28,
   "end": 631.56,
   "text": "چرا، چرا، چرا اینطوری؟ چرا اینطوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 631.56,
   "end": 635.94,
   "text": "تسلیم محض نباشی، همون مقدار متاسفانه دچار نفاق شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 635.94,
   "end": 642.58,
   "text": "من رک بگم یکی از علت‌هایی که خلاصه الان من روی حرف خیلی حرف دارم رو این نکته آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 642.58,
   "end": 646.04,
   "text": "میگه هر که را اسرار حق آموختن مهر کردن به دهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.04,
   "end": 647.78,
   "text": "نه که به من اسرار حق آموختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 647.78,
   "end": 651.0,
   "text": "به شما آموختن من نمی‌تونم جلوی شما حرف بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.0,
   "end": 654.04,
   "text": "اما میگه که هر مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 654.04,
   "end": 658.88,
   "text": "که اینجا تسلیم سر امام نباشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 658.88,
   "end": 661.9,
   "text": "همون مقدار هم با این روضه‌ها نمی‌تونی گریه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 661.9,
   "end": 663.8,
   "text": "حق روضه رو نمی‌تونی ادا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 663.8,
   "end": 667.56,
   "text": "کسی می‌تونه روضه اباالفضل سلام الله عليه رو حق روضه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 667.56,
   "end": 670.62,
   "text": "و گریه، چه روضه‌ش، چه گریه اباالفضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 670.62,
   "end": 672.94,
   "text": "سلام الله عليه رو ادا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 672.94,
   "end": 675.74,
   "text": "که این تسلیم بودن رو درک کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 675.74,
   "end": 679.36,
   "text": "و الا نمی‌تونه درست برای امام حضرت اباالفضل گریه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 679.36,
   "end": 684.42,
   "text": "ایشالله که عاقبت ما ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 684.42,
   "end": 689.26,
   "text": "اللهم صل علی محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}