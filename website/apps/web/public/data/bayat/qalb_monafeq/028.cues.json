   "title": "## وطن اصلی؛ سه شرط",
   "start": 16.4,
   "end": 116.44
  },
  {
   "index": 1,
   "title": "## نفاق و نفوذ؛ استضعاف اقویا",
   "start": 116.44,
   "end": 149.16
  },
  {
   "index": 2,
   "title": "## مستضعف‌کردن نیرومندان نه ضعفا",
   "start": 149.16,
   "end": 296.34
  },
  {
   "index": 3,
   "title": "## امام حسین؛ مستضعف الغریب",
   "start": 296.34,
   "end": 368.85
  },
  {
   "index": 4,
   "title": "## انقلاب و گشایش بال‌های مستضعف",
   "start": 368.85,
   "end": 486.95
  },
  {
   "index": 5,
   "title": "## سازمان‌ها و کنارکشیدن برای تواناتر",
   "start": 486.95,
   "end": 657.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 3.0,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.0,
   "end": 6.46,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.46,
   "end": 11.14,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.14,
   "end": 15.74,
   "text": "یه مقدار رو بحث وطن کار کنیم تو احکام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.74,
   "end": 20.12,
   "text": "که به عنوان نمونه از رهبر عزیزمون سؤال شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.12,
   "end": 25.2,
   "text": "آیا اگر کسی در یک شهری به دنیا بیاد لکن اونجا نمونه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.2,
   "end": 27.8,
   "text": "دقت کنید یه جا به دنیا بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.8,
   "end": 33.16,
   "text": "چون ما گمانمون اینه که معمولا وطن اصلی اونجاییه که طرف به دنیا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.16,
   "end": 37.48,
   "text": "حالا سؤال اینه ما اونجا به دنیا اومدیم اما رشد و نمو نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.48,
   "end": 43.4,
   "text": "بردنمون یه جای دیگه. آیا اونجایی که به دنیا اومدیم وطنمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.4,
   "end": 45.46,
   "text": "یا جایی که رشد و نمو کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.46,
   "end": 48.26,
   "text": "رهبر عزیزمون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.26,
   "end": 57.62,
   "text": "جایی که وطن اصلیت حساب میشه صرفا جایی نیست که به دنیا میای بلکه باید مدتی اونجا رشد و نمو هم داشته باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.62,
   "end": 61.0,
   "text": "و البته اعراض هم نکرده باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.0,
   "end": 68.38,
   "text": "یعنی از اون و-وطنت اعراض نکنی بگی خب دیگه من نمی خوام اونجا وطنم باشه برم یه جای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.38,
   "end": 74.8,
   "text": "پس در حقیقت سه تا شرط میشه وطن، وطن اصلی ها، وطن دوم رو نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.8,
   "end": 79.0,
   "text": "وطن اصلی سه تا شرط؛ یک اونجا به دنیا اومدی، دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.0,
   "end": 81.16,
   "text": "رشد و نمو کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.16,
   "end": 84.3,
   "text": "سه اعراض نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.3,
   "end": 87.52,
   "text": "اونجا وطن اصلیت حساب میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.52,
   "end": 90.3,
   "text": "و جان؟ اعراض یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.3,
   "end": 93.2,
   "text": "اعراض یعنی اینکه شما میگی دیگه نمی خوام اونجا زندگی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.2,
   "end": 96.7,
   "text": "دیگه نمی خوام اهل این شهر باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.7,
   "end": 98.92,
   "text": "می خوام بکنم برم فلان جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.92,
   "end": 104.74,
   "text": "این یعنی اعراض. یعنی عقب گرد، پشت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.74,
   "end": 106.5,
   "text": "در هر حال حالا این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.5,
   "end": 114.14,
   "text": "طولانیه حالا چون نکات دقیقی هم درش هست، مخصوصا تو بحث وطن دوم و سوم یا وطن کاری و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.14,
   "end": 121.34,
   "text": "اینا رو باید بحث کنیم. یه نکته قابل تأمل دیگه ای پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.34,
   "end": 123.86,
   "text": "موضوع نفاق عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.86,
   "end": 127.08,
   "text": "اگر دقت بفرمایید معمولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.08,
   "end": 132.48,
   "text": "آدم‌هایی که نفوذ می‌کنند به و-به خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.48,
   "end": 136.26,
   "text": "نفاقشون نفوذ می‌کنند تو دستگاه‌های مهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.26,
   "end": 139.58,
   "text": "ما یه مدته دیگه بحثمون اینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.58,
   "end": 146.62,
   "text": "یکی از کارهایی که متاسفانه این‌ها انجام میدن که در انقلاب خودمون خیلی این دیده شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.62,
   "end": 153.28,
   "text": "استضعافه. ما یک مستضعف داریم یک مستضعف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.28,
   "end": 158.6,
   "text": "مستضعف اسم مفعولیه اما مستضعف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.6,
   "end": 161.82,
   "text": "اسم فاعلیه. این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.82,
   "end": 164.96,
   "text": "معروفی که \"و نريد ان نمن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.96,
   "end": 168.32,
   "text": "این \"نريد\" اراده قطعی خداست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.32,
   "end": 173.2,
   "text": "قبلا عرض کردیم. قطعا خدا از همین حالا خواسته هیچ اهری هم نمیتونه جلوشو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.2,
   "end": 176.0,
   "text": "که چی؟ \"ان نمن\" که منت بگذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.0,
   "end": 179.82,
   "text": "بلکه یا \"عل الذین استضعفو\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.82,
   "end": 182.72,
   "text": "\"تضعفو\". \"استضعفو\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.72,
   "end": 186.32,
   "text": "نه \"استضعفو\". فعل مجهول میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.32,
   "end": 196.22,
   "text": "خیلی جالبه. \"عل الذین استضعفو فی الارض و نجعلهم ائمة و نجعلهم الوارثین\" از آیات کلیدی قرآن اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.22,
   "end": 200.06,
   "text": "که حالا روایات زیادی داریم که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.06,
   "end": 204.32,
   "text": "یاران امام عصر البته پیرامون اول خود امام عصره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.32,
   "end": 208.16,
   "text": "مستضعف واقع شده امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.16,
   "end": 211.24,
   "text": "اول کسایی که مستضعف واقع شدن اونان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.24,
   "end": 216.5,
   "text": "مستضعف کسیه که او رو به استضعاف کشونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.5,
   "end": 224.38,
   "text": "یعنی اون منافق، اون نفوذی، اون آدم پست دو رو که ظاهرا ادعا به اسلام داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.38,
   "end": 231.76,
   "text": "ظاهرا ادعا حتی قسم خورده رو ارزش‌های انقلاب اما نفوذیه، منافده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.76,
   "end": 238.24,
   "text": "این چیکار میکنه؟ میاد اونایی که قدرتمند هستن رو دقت بفرمایید نه ضعفا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 238.24,
   "end": 241.1,
   "text": "اونایی که واقعا ضعیفن که خب ضعیفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.1,
   "end": 243.62,
   "text": "اون که اصلا بلد نیستن مدیریت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.62,
   "end": 246.64,
   "text": "نه پول داره که اقتصاد کشور رو نجات بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.64,
   "end": 251.58,
   "text": "نه ایده داره، هیچی، نه علم داره، نه تحصیلات داره، نه فکر داره، نه شعور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.58,
   "end": 254.06,
   "text": "اصن اینا که مس-- اینا که اصلا ضعیفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.06,
   "end": 258.46,
   "text": "اتفاقا اقویا رو میاد قویا رو مستضعف میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 258.46,
   "end": 264.2,
   "text": "تحت استضعاف قرار میگیره. این مستضعف میشه اسم فاعلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.2,
   "end": 267.02,
   "text": "درست شد؟ این میاد مستضعف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.02,
   "end": 270.72,
   "text": "کیو؟ حالا اگر دقت بکنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.72,
   "end": 278.72,
   "text": "\"استضعفو\" کلا این فعل چون تو باب استفعال هم رفته در باب استفعال یک طلب و میلی هم درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.72,
   "end": 280.98,
   "text": "اینو ادبیات خونا میدونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.98,
   "end": 285.76,
   "text": "این طلب و میل برمیگرده به میل اون مستضعف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.76,
   "end": 294.4,
   "text": "یعنی اون کسی که تحت استضعاف قرار داده دیگران رو میل داره که این آقا اصلا به هیچ جا نرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 294.4,
   "end": 299.18,
   "text": "میل داره. یه عبارتی امام سجاد این روضه خونا اینو خوب گوش بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 299.18,
   "end": 304.36,
   "text": "امام سجاد سلام الله علیه نمیگن متاسفانه آقا این اوج خودش اوج روضه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 304.36,
   "end": 308.64,
   "text": "امام سجاد بعد از واقعه عاشورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 308.64,
   "end": 312.82,
   "text": "در خصوص امام حسین، آقا چرا از خودم حرف در میارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 312.82,
   "end": 318.94,
   "text": "ببین امام سجاد چجوری امام حسین رو تو کربلا موقعیت شناسی کرده، توصیف کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 318.94,
   "end": 324.74,
   "text": "یه عبارت حضرت اینه به ابی چطور ما میگیم به ابی انتبأ میم باء تفتیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 324.74,
   "end": 328.28,
   "text": "تفدیه، فدا. پدر مادرم فدات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 328.28,
   "end": 334.52,
   "text": "امام سجاد وقتی میخواد امام حسین رو معرفی میکنه میفرماید به ابی یا به أبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 334.52,
   "end": 340.4,
   "text": "مستضعف. به أبل مستضعف الغریب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 340.4,
   "end": 344.24,
   "text": "جانم من جا-- پدرم فدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 344.24,
   "end": 348.0,
   "text": "مستضعفی که غریب واقع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 348.0,
   "end": 350.24,
   "text": "امام حسین که خیلی قوی بوده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 350.24,
   "end": 351.88,
   "text": "همه قدرت مال اون بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 351.88,
   "end": 354.12,
   "text": "همه علم و حکمت الهی تو دمنش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 354.12,
   "end": 357.86,
   "text": "همه طهارت، همه عزت، همه چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 357.86,
   "end": 360.72,
   "text": "اما مستضعف الغریب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 360.72,
   "end": 364.14,
   "text": "استضعاف کشوندن. البته که اول کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 364.14,
   "end": 368.13,
   "text": "مستضعف شدن اونان. لذا بلافاصله بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 368.13,
   "end": 373.55,
   "text": "صقیفه همه محبین و شیعیان امیرالمؤمنین هم مستضعف شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 373.55,
   "end": 377.91,
   "text": "بقیه مستضعف، اونایی که سکوت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 377.91,
   "end": 385.05,
   "text": "تو همه کشورها خود حالا تو بحث کوفه و شام این استضعاف هرچی جلوتر رفت غلیظ‌تر شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 385.05,
   "end": 387.79,
   "text": "تا جایی که امام سجاد فرمود تو بیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 387.79,
   "end": 389.73,
   "text": "بیست نفرم ما رو دوست نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 389.73,
   "end": 392.39,
   "text": "بعد از قصه کربلا تو کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.39,
   "end": 398.49,
   "text": "جزیرة العرب. یعنی غلظت استضعاف به حدی بالا میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 398.49,
   "end": 401.73,
   "text": "بعد کی میاد میشه، کی میاد میخواد خطبه بخونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 401.73,
   "end": 404.21,
   "text": "کی میاد میخواد نماز جمعه به پا کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 404.21,
   "end": 407.87,
   "text": "اهل اسلام رو جمع کنه جالبه نماز جمعه بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 407.87,
   "end": 410.49,
   "text": "یزید علیه لعنه که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 410.49,
   "end": 413.85,
   "text": "که شوربه خمرش چیزایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.85,
   "end": 416.21,
   "text": "علنا بر علیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 416.21,
   "end": 418.57,
   "text": "ببینید جامعه به کجا کشیده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.57,
   "end": 422.79,
   "text": "بله وقتی یه کسی مثل امام حسین مستضعف بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 422.79,
   "end": 426.93,
   "text": "مستضعفین میان سر کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 426.93,
   "end": 431.01,
   "text": "و همین صدام یزیدها اینام ادامه دهنده راه اونان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 431.01,
   "end": 435.29,
   "text": "ملعون خبیث میگفت یزید یه اس-اشتباه استراتژیک کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 435.29,
   "end": 438.07,
   "text": "صدام میگفت. میگفت یزید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 438.07,
   "end": 441.07,
   "text": "علیه لعنه سیاست بلد نبود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 441.07,
   "end": 448.31,
   "text": "زن و بچه امام حسین رو رها کرد بیان کوفه و شام اون بلوا رو به پا کنن ما رو اینطوری الان اذیت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 448.31,
   "end": 451.39,
   "text": "خیلی ملعون بوده. هی غلظت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 451.39,
   "end": 454.11,
   "text": "پستی‌شون تو نسل‌شون بیشتر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.11,
   "end": 460.03,
   "text": "میگه که اگر من جای یزید بودم زن و بچه امام حسین هم تو کربلا دفن میکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 460.03,
   "end": 463.57,
   "text": "که تموم شه بره. ببین اوج استضعاف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 463.57,
   "end": 467.75,
   "text": "اینکه تو همین زمان پهلوی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 467.75,
   "end": 470.65,
   "text": "مگه شهید بابایی‌ها، کشوری‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.65,
   "end": 473.11,
   "text": "عرض شود سیاد شیرازی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 473.11,
   "end": 474.73,
   "text": "اینها مگه تو ارتش نبودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 474.73,
   "end": 477.51,
   "text": "تو ارتش زمان شاه بودن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 477.51,
   "end": 481.93,
   "text": "اینا ولی مستضعف بودن. به محض اینکه انقلاب شد پر و بال اینا باز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 481.93,
   "end": 485.55,
   "text": "ببین چه گشایشی ایجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 485.55,
   "end": 488.43,
   "text": "حالا این گشایش در زمان حضرت رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 488.43,
   "end": 491.29,
   "text": "اما الان ما الان باید مراقب باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.29,
   "end": 496.77,
   "text": "که کسی تو در مенеدستگاه که شده، متأسفانه دیگه داد رهبر چقدر دراومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 496.77,
   "end": 500.31,
   "text": "نفوذ، نفوذ، نفوذ همین نفاق، نفاق، نفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 500.31,
   "end": 506.13,
   "text": "چرا وقتی یه آدم ارزشی میاد در کلان مملکت حالا رای یه رییس جمهور میشه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 506.13,
   "end": 508.81,
   "text": "هرچی، هرچی میشه فایده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 508.81,
   "end": 513.21,
   "text": "همه به جای اینکه کمکش کنن مستضعفش قرار میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 513.21,
   "end": 517.19,
   "text": "بهش ظلم میکنن، ستم میکنن، براش دروغ بافی میکنن، دروغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 517.19,
   "end": 520.47,
   "text": "عرض شود شایعه میسازن که ضعیفش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 520.47,
   "end": 525.29,
   "text": "چرا دست به دست هم میدن اونایی که مراکز قدرت دستشونه، ثروت دستشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 525.29,
   "end": 527.41,
   "text": "که فلانی رو چون حالا تو حزب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 527.41,
   "end": 529.73,
   "text": "تو حزب ما نیست بذار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 529.73,
   "end": 532.69,
   "text": "زیر پاشو خالی کنیم. تو مستضعفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 532.69,
   "end": 536.09,
   "text": "تو ادامه‌ی همونای قتله کربلایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 536.09,
   "end": 540.25,
   "text": "همونی که امام حسین رو مستضعف کردن تو هم در ادامه اونایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.25,
   "end": 543.55,
   "text": "انقدر پست شدن. تو جمهوری اسلامی ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 543.55,
   "end": 547.57,
   "text": "این اتفاقات داره رخ میده. حالا شما بیا اینا هم ب-بیا پایین و پایین و پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 547.57,
   "end": 550.07,
   "text": "تو همین سازمان‌ها و ادارجات خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 550.07,
   "end": 553.13,
   "text": "چقدر مدیر جایی نشستن که لیاقتشو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 553.13,
   "end": 557.47,
   "text": "اون کسی که زیردستشه بهتر میتونه کار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 557.47,
   "end": 559.95,
   "text": "حالا جسارت به مدیرای خوب نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 559.95,
   "end": 567.59,
   "text": "مثل حاج رضای عزیرمون. من کیف میکنم میبینمش که مدیریت داشت دادن به یه بچه ارزشی اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 567.59,
   "end": 569.35,
   "text": "این با حرف ما به همه نمیرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 569.35,
   "end": 572.21,
   "text": "ولی هستن دیگه. مستضعف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.21,
   "end": 574.69,
   "text": "واقع شدن. کسایی که این کاره نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 574.69,
   "end": 580.97,
   "text": "اصن ظرفیتشو ندارن. اصن طرف بلد نیست چجوری با زیردستش تعامل کنه، جواب سلامشو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 580.97,
   "end": 584.27,
   "text": "شده مدیر. بعد دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 584.27,
   "end": 589.21,
   "text": "میان از این چون تو گروه خودشونه حمایت میکنن، دیگران رو پس میزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 589.21,
   "end": 593.11,
   "text": "اینها تا دلت بخواد تو جمهوری اسلامی ما داره دیده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 593.11,
   "end": 598.21,
   "text": "اینها همون کسایین که مستضعف شده‌اند و خدا اینها رو قراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 598.21,
   "end": 605.45,
   "text": "\"و نجعلهم ائمه\" مژده، مژده، مژده \"و نجعلهم ائمه و نجعلهم الوارثین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 605.45,
   "end": 608.85,
   "text": "حواسمون جمع باشه یه وقت ما دچار این نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 608.85,
   "end": 612.17,
   "text": "یه زیرنویس بیام برای سهولت فهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 612.17,
   "end": 615.13,
   "text": "تو هیئتامون، تو مساجدمون، تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 615.13,
   "end": 620.13,
   "text": "ادارجاتمون، سازمان‌هامون. یه آدم میاد میبینیم از من تواناییش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 620.13,
   "end": 625.67,
   "text": "اگه من نکشم کنار اجازه ندم اون بیاد جای من بشینه، منم مستضعفم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 625.67,
   "end": 627.77,
   "text": "چون میبینم اون از من تواناییش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 627.77,
   "end": 629.83,
   "text": "از من بهتر بلده منبر بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 629.83,
   "end": 633.15,
   "text": "آقا بفرما کنار اون بره. از من بهتر بلده مداحی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 633.15,
   "end": 634.85,
   "text": "از من بهتر بلده مدیریت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 634.85,
   "end": 636.99,
   "text": "از من بهتر بلده اون مسئولیت رو به دوش بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 636.99,
   "end": 643.87,
   "text": "آقا بفرما کنار اون بیاد. خودت باید بکشی کنار اون بیاد و الا تو مستضعفی و ادامه دهنده راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 643.87,
