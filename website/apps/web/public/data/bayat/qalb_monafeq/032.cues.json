 "chapters": [
  {
   "index": 0,
   "title": "## قصد وطن؛ عنوان شرعی با نیت ساخته می‌شود",
   "start": 0.48,
   "end": 44.04
  },
  {
   "index": 1,
   "title": "## حسنه و پرهیز از نگاه کیلویی به ثواب",
   "start": 44.04,
   "end": 246.68
  },
  {
   "index": 2,
   "title": "## استغفار زیر هر گناه؛ پناه به جابرالعثرات",
   "start": 246.68,
   "end": 609.09
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.48,
   "end": 5.52,
   "text": "عزیزان پیرامون وطن شده این هستش که اگر کسی در یک شهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.52,
   "end": 11.58,
   "text": "مدت طولانی موند اما قصد نکرده بود که اونجا رو وطن خودش قرار بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.58,
   "end": 15.56,
   "text": "بدون قصد جایی مونده بود، خیلی هم طولانی موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.56,
   "end": 19.24,
   "text": "اینجا تکلیفش چی میشه؟ نمازش اونجا شکسته است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.24,
   "end": 23.56,
   "text": "کامله. آقا فرمودن قصد باید انجام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.56,
   "end": 30.54,
   "text": "اگر شما قصد نکردی جایی رو وطن خودت قرار بدی حالا هر چقدر هم موندی وطن شما نمیشه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.54,
   "end": 36.28,
   "text": "باید قصد کنی. اگر قصد کردی اونجا وطنت و مدتی موندی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.28,
   "end": 41.0,
   "text": "اونجا وطنت حساب میشه و اگر از مسافت شرعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.0,
   "end": 44.04,
   "text": "عدول کنی و رد کنی دیگه مسافر حساب میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.04,
   "end": 48.28,
   "text": "یکی از عزیزان فرمودن پیرامون آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.28,
   "end": 53.32,
   "text": "جا و \"من جاء بالحسنه فله عشر امثالها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.32,
   "end": 56.5,
   "text": "و اینکه حقیقت این حسنه چی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.5,
   "end": 59.18,
   "text": "و اینکه ما معمولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.18,
   "end": 63.92,
   "text": "به تعبیر ایشون وجبی یا مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.92,
   "end": 70.84,
   "text": "همینطور کیلویی شاید به نوعی بشه گفت خرواری به ثواب‌ها نگاه می‌کنیم بحث کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.84,
   "end": 73.98,
   "text": "ما این آیه رو قبلا روش بحث کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.98,
   "end": 82.48,
   "text": "و مطالبشو گفتیم. اصلا ذیلش خیلی چند جلسه دربارش صحبت کردیم چون بحث ما پیرامون قلب نفا-- دچار نفاق است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.48,
   "end": 85.24,
   "text": "اجازه بدید ربطش بدیم به بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.24,
   "end": 88.3,
   "text": "برای همین یک سؤال من طرح کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.3,
   "end": 92.04,
   "text": "تا اینجا خب آیاتی رو و روایاتی رو پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.04,
   "end": 94.5,
   "text": "قلبی که دچار نفاق شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.5,
   "end": 98.5,
   "text": "بیان کردیم و گفتیم که خیلی هم خطر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.5,
   "end": 104.96,
   "text": "حالا سؤال، ما چجوری بفهمیم که بالاخره این همه آیات و روایات رو ما مرور کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.96,
   "end": 106.7,
   "text": "که ما دچار نفاق شدیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.7,
   "end": 109.32,
   "text": "آیا ما منافق هستیم؟ خودم، اصلا کاری ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.32,
   "end": 117.12,
   "text": "چون ما یک بحث رو از و اواسط بحث ااا میشه گفت تقریبا منصرف کردیم به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.12,
   "end": 120.58,
   "text": "شناخت عوامل نفاق و نفوذ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.58,
   "end": 124.1,
   "text": "حالا فعلا کاری به دیگری ندارم، خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.1,
   "end": 128.9,
   "text": "سؤال اساسیه. آیا من بالاخره با توجه به اون علائمی که گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.9,
   "end": 133.76,
   "text": "نگران این باشم که منافق هستم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.76,
   "end": 141.1,
   "text": "یه محک خیلی مهم و خیلی اساسی که پیامبر عظیم الشأن اسلام پیرامون این سؤال دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.1,
   "end": 146.02,
   "text": "اینه که جالبه که بدونید در اون نامه‌ای که مرحوم حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.02,
   "end": 153.24,
   "text": "بروجردی رحمت الله علیه که اون موقع ایشون تک مرجع بودن دیگه مثل الان نبود که این همه مرجع مطرح باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.24,
   "end": 161.82,
   "text": "یک نامه‌ای علمای اهل تسنن حجاز به ایشون نوشتن، اشکال کردن به اینکه چرا شما شیعه‌ها تو نمازتون، اذان و اقامه‌تون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 161.82,
   "end": 164.2,
   "text": "\"اشهد ان علیا ولی الله\" میگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 164.2,
   "end": 167.28,
   "text": "این مسبوق به تاریخ نیست و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 167.28,
   "end": 169.42,
   "text": "مرحوم آیه بروجردی این نامه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.42,
   "end": 175.48,
   "text": "دادن به حضرت علامه شعرانی، استاد علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.48,
   "end": 186.02,
   "text": "حفظه الله تعالی، که جا-- این نامه و جوابش در به عربی در کتاب فس Fatمیه علامه هست اگر خواستید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 186.02,
   "end": 191.58,
   "text": "که اونجا علامه شعرانی توضیح مبسوطی میده به این اشکال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 191.58,
   "end": 195.78,
   "text": "یک بخشش که اینجاست که اشاره میکنه علامه به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 195.78,
   "end": 204.36,
   "text": "یکی از کتاب سهاح السطه، اون شش کتاب شش گانه اهل تسنن به نام سهاح یا صحیح ترمذی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 204.36,
   "end": 209.7,
   "text": "اشاره میکنه به یه روایتی که ام سلمه همسر پیامبر نقل میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 209.7,
   "end": 213.04,
   "text": "که \"کان رسول الله\" عین عبارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 213.04,
   "end": 217.72,
   "text": "روایتو من میخونم \"کان رسول الله یقول\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 217.72,
   "end": 223.5,
   "text": "این \"کان رسول الله یقول\" یک عبارت بسیار مهمه در فقه و استنباط احکام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 223.5,
   "end": 226.18,
   "text": "یک وقت هست میگه پیغمبر گفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 226.18,
   "end": 230.12,
   "text": "\"قال\" این یه معنا داره یعنی یک بار گفت، دو بار گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 230.12,
   "end": 236.2,
   "text": "اما \"کان رسول الله یقول\" اینکه میگه \"کان یقول\" یعنی دائما میگفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 236.2,
   "end": 238.76,
   "text": "این خیلی قصه رو تغییر میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 238.76,
   "end": 240.98,
   "text": "چی میگفت پیغمبر دائرا- دائما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 240.98,
   "end": 244.64,
   "text": "\"لا یحب علیا منافق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 244.64,
   "end": 249.22,
   "text": "اصلا منافق امکان نداره امیرالمؤمنین علیه السلام رو دوست داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 249.22,
   "end": 253.24,
   "text": "\"ولا يبغضه مؤمن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 253.24,
   "end": 256.92,
   "text": "و اصلا هم امکان نداره مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 256.92,
   "end": 258.92,
   "text": "بغض نسبت به این آقا داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 258.92,
   "end": 261.4,
   "text": "اصلا این آقا ملاکه. لذا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 261.4,
   "end": 265.9,
   "text": "پیامبر وقتی سؤال کردن ما کی بفهمیم تو صراط مستقیمیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 265.9,
   "end": 273.36,
   "text": "به قول ما کی بفهمیم چپ کردیم، حضرت اشاره کردن با انگشت مبارک سریع به امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 273.36,
   "end": 277.06,
   "text": "فرمودن هروقت که این آقا رو دوست داشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 277.06,
   "end": 279.4,
   "text": "خیلی این ملاکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 279.4,
   "end": 283.24,
   "text": "دیدید دوستش داری بدون تو راه صراط مستقیمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 283.24,
   "end": 288.64,
   "text": "این خیلی قابل توجهه و م-- علامه شعرانی داره به این استنباط میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 288.64,
   "end": 295.52,
   "text": "که البته از توش مسائل فقهی و شرعی هم بیرون میاد پیرامون اذان و اقامه که بعدا ایشون میفرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 295.52,
   "end": 299.8,
   "text": "جایز هست که در اذان و اقامه ما \"اشهد ان علیا ولی\" که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 299.8,
   "end": 304.36,
   "text": "علامه حسن زاده که دیگه به قول ما دیگه سنگ تموم گذاشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 304.36,
   "end": 308.36,
   "text": "و حضرت زهرا سلام الله علیها رم میاره تو اذان و اقامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 308.36,
   "end": 312.7,
   "text": "اشکالی هم نداره. حالا بحث اون سمت نره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 312.7,
   "end": 320.38,
   "text": "که امیرالمؤمنین علیه الصلاة والسلام هم در نهج البلاغه همین نکته استادش رو لطیفانه‌تر بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 320.38,
   "end": 323.86,
   "text": "اونجایی که فرمودن که اگر من تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 323.86,
   "end": 331.38,
   "text": "دنیا رو به منافق ببخشم محاله که حب به من تو دلش وارد بشه و منو دوست داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 331.38,
   "end": 340.08,
   "text": "و همچنین فرمود محال ممکنه مؤمن اگر با شمشیر بزنم بینیشو قطع کنم، بیخ بینیش بزنم با شمشیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 340.08,
   "end": 342.94,
   "text": "چ-- خیلی بیش-- این بینی خودش مطلب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 342.94,
   "end": 348.78,
   "text": "چرا حضرت میگه بینی؟ میگن دماغشو به خاک مالوندم یعنی دیگه نهایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 348.78,
   "end": 355.38,
   "text": "تحقیر نسبت به مؤمن منو انجام بدم، میگه محال بغض من و علی تو دلش بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 355.38,
   "end": 357.66,
   "text": "پس این ملاک بسیار مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 357.66,
   "end": 362.04,
   "text": "الحمد لله دارید میخندید از اینا بعضیا اشک تو چشماشون جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 362.04,
   "end": 365.67,
   "text": "این نشانه ایمان شماست لکن یه نکته هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 365.67,
   "end": 374.13,
   "text": "اون نکته رو من عرض کنم که البته این رو خیلی میگم انقدر من با آب و تاب گفتم خیلی، خیلی، خیلی جدی بگیریدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 374.13,
   "end": 381.17,
   "text": "و حتی اگر این حرف منو درست انشاالله برداشت کردید امروز با یه هدیه برید خونه بچه‌هاتونو ببوسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 381.17,
   "end": 383.73,
   "text": "که خدا رحمت کنه جابر بن عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 383.73,
   "end": 390.83,
   "text": "انصاری از بزرگترین صحابی پیغمبر وقتی تازه امیرالمؤمنین مظلوم و غریب شده بود و تو سکوت بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 390.83,
   "end": 395.57,
   "text": "تو خیابون کوچه‌های مدینه راه می‌افتاد میگفت آی جار می‌زد آی مردم!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 395.57,
   "end": 399.85,
   "text": "چه شجاعتی داشته. آی مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 399.85,
   "end": 404.21,
   "text": "، فرزندانتونو با حب علی ام-امتحان کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 404.21,
   "end": 406.27,
   "text": "نام علی رو کنارشون ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 406.27,
   "end": 409.87,
   "text": "اگر دیدید دوست دارن صاحب این نام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 409.87,
   "end": 412.83,
   "text": "بدونید که نطفه‌شون پاک بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 412.83,
   "end": 419.21,
   "text": "اما اگر دیدید خوششون نمیاد پس می‌زنن بدونید که اشکالی وجود داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 419.21,
   "end": 424.23,
   "text": "این نطفه مشکل داشته. جابر اونم جابر که من قبلاً توضیح دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 424.23,
   "end": 429.81,
   "text": "می-- اینطور که ما از اثاثیه مون شناختیم جابر یه چیزی بالاتر از مثل الان رهبر ما بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 429.81,
   "end": 432.61,
   "text": "یعنی انقدر عظمت داشته میانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 432.61,
   "end": 436.57,
   "text": "انگار که یه کوه داشته راه می‌رفته تو خیابونا و کوچه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 436.57,
   "end": 440.87,
   "text": "حالا این مل-ملاک رو داشته باشید اما از یه چیزی بترسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 440.87,
   "end": 442.91,
   "text": "آدم مؤمن باید بین خوف و رجا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 442.91,
   "end": 449.59,
   "text": "این آیه که عزیزم فرمودن اشاره کنید به نکته‌ی خیلی بسیار مهمی داره اشاره می‌کنه، تصریح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 449.59,
   "end": 455.37,
   "text": "\"من جاع\". هرکس که بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 455.37,
   "end": 458.93,
   "text": "بل حسنه. البته من قبلاً گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 458.93,
   "end": 462.05,
   "text": "ذیل حسنه روایات داریم که م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 462.05,
   "end": 469.51,
   "text": "اون لب و چکیده و عصر، عصاره و مخلص این لب یا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 469.51,
   "end": 472.59,
   "text": "حسنه یعنی حب فاطمه زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 472.59,
   "end": 475.67,
   "text": "حسنه یعنی فاطمه زهرا و حبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 475.67,
   "end": 478.97,
   "text": "یعنی ولایت امیرالمؤمنین، ولایت این خاندان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 478.97,
   "end": 484.63,
   "text": "هرکس که بیاد، نکته اینجاست \"من جاع بل حسنه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 484.63,
   "end": 486.81,
   "text": "بله \"فله عشر امثالها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 486.81,
   "end": 491.37,
   "text": "که علامه جوادی آملی فرمود نه اینکه ده بار پاداشش، پاداشش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 491.37,
   "end": 495.27,
   "text": "یه روایت ذیل این آیه آورد که قبلاً بحثش گذشت که یعنی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 495.27,
   "end": 500.49,
   "text": "هروله کنان ده برابر سرعت او به سمتش حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 500.49,
   "end": 504.95,
   "text": "کسی که با محبت علی و فاطمه به سمت خدا بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 504.95,
   "end": 508.57,
   "text": "این نکته‌ست \"من جاع\" یعنی بتونه این حب رو ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 508.57,
   "end": 511.01,
   "text": "آقا مگه میشه این حب از دست بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 511.01,
   "end": 513.97,
   "text": "بله. مشکل اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 513.97,
   "end": 521.73,
   "text": "اگر فرمودن ، من عرض شود \"ان الحسنات يذهبن السيئات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 521.73,
   "end": 526.93,
   "text": "خوبی‌ها بدی‌ها رو می‌بره از اون طرفم روایات زیادی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 526.93,
   "end": 530.17,
   "text": "در کتاب اگر دوست داشتید حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 530.17,
   "end": 534.79,
   "text": "زیابادی که تو یک سال ما این کتابو اینجا تدریس کردیم دو سه سال پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 534.79,
   "end": 539.05,
   "text": "کل کتابو. راه‌های کنترل نفوذ شیطان در قلب انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 539.05,
   "end": 543.35,
   "text": "اونجا ایشون روایات تکان‌دهنده‌ای رو میاره که می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 543.35,
   "end": 547.19,
   "text": "گناه، پشت گناه، اصرار بر گناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 547.19,
   "end": 552.67,
   "text": "هی حب رو کم‌رنگ می‌کنه، کم‌رنگ می‌کنه، کم‌رنگ می‌کنه و خدا نکرده دیگه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 552.67,
   "end": 554.67,
   "text": "بدل می‌شه. خدا نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 554.67,
   "end": 557.55,
   "text": "تبدیل بشه. بعد قلب منکوس بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 557.55,
   "end": 562.53,
   "text": "که ق-- بحثش قبلاً گذشت. پس باید مراقب باشیم اصرار در گناه نداشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 562.53,
   "end": 565.73,
   "text": "لذا امیرالمؤمنین فرمود \"خشا به حال کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 565.73,
   "end": 569.47,
   "text": "قیامت وقتی نامه‌عملشو میدن زیر هر گناهش یه استغفار داره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 569.47,
   "end": 572.31,
   "text": "یعنی چی؟ یعنی تا به گناه افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 572.31,
   "end": 576.05,
   "text": "آقا بالاخره ما که معصوم نیستیم گناه، سریع برگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 576.05,
   "end": 578.75,
   "text": "استحب نکنه سریع به قول ه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 578.75,
   "end": 585.11,
   "text": "عرفا فرمودن اولین کارش این باشه که بلند شه رو به قبله دست به سینه حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 585.11,
   "end": 591.61,
   "text": "از گناه اومده بیرونا. یه وضو بگیره بگه \"السلام علیک یا أبا عبدالله الحسین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 591.61,
   "end": 597.61,
   "text": "که او مظهر جابر العزم الكثیر میان خاندان عصمت و طهارت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 597.61,
   "end": 599.83,
   "text": "این بحث ادامه داره انشاالله عاقبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 599.83,
   "end": 603.25,
   "text": "بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 603.25,
   "end": 609.09,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}