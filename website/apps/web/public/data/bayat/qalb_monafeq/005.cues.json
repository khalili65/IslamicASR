 "chapters": [
  {
   "index": 0,
   "title": "## لوازم آرایشی و اصل طهارت",
   "start": 15.68,
   "end": 132.98
  },
  {
   "index": 1,
   "title": "## حجاب اکبر نفس در آداب الصلاة",
   "start": 132.98,
   "end": 169.72
  },
  {
   "index": 2,
   "title": "آیهٔ چهل و یک سورهٔ مائده منافقین را چنین معرفی می‌کند:",
   "start": 169.72,
   "end": 325.54
  },
  {
   "index": 3,
   "title": "## قلب مقام حضور",
   "start": 325.54,
   "end": 398.17
  },
  {
   "index": 4,
   "title": "## حاجت کودکستانی و مثال پروفسور",
   "start": 398.17,
   "end": 615.61
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 4.1,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.1,
   "end": 7.7,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.7,
   "end": 13.54,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.54,
   "end": 18.62,
   "text": "خب اینطور در خبرگزاری‌ها و این‌ها بعضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.62,
   "end": 25.22,
   "text": "اعلام می‌شه که از خارج از کشور یه سری و لوازم آرایشی وارد شده که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.22,
   "end": 30.06,
   "text": "از، اِاِاِ حالا یا ژلاتین یا بعضی از اعضای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.06,
   "end": 35.54,
   "text": "خوک که نجس هست یا بعضا از مردار اصلا از مرداری که خب از نظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.54,
   "end": 38.3,
   "text": "اسلام نجس هست تهیه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.3,
   "end": 42.42,
   "text": "لوازم آرایشی حالا هم از رژ لب و نمی‌دونم هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.42,
   "end": 46.7,
   "text": "این‌ها اعلام می‌شه که مراقب باشید در خرید این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.7,
   "end": 49.66,
   "text": "خب حالا چه کنن این خانم‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.66,
   "end": 55.16,
   "text": "مؤمنه‌ای که می‌خوان برن لوازم آرایشی تهیه کنن برای شوهرهاشون آرایش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.16,
   "end": 58.32,
   "text": "بالاخره حضرت حوا منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.32,
   "end": 60.94,
   "text": "می‌خواد برای آدم منزلش چه کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.94,
   "end": 63.26,
   "text": "خودش رو آرایش کنه از دستورات اسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.26,
   "end": 67.66,
   "text": "خب چه کنه؟ این قصه‌ای که پیچیده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.66,
   "end": 71.72,
   "text": "بالاخره بره تهیه بکنه، نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.72,
   "end": 78.86,
   "text": "رهبری فرمودن که اصلا این اصل طهارته دیگه ما یه چند روزه داریم پیرامون اصل طهارت بحث می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.86,
   "end": 82.8,
   "text": "نه فقط ایشون، همه مراجع فرمودن که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.8,
   "end": 87.84,
   "text": "اِاِاِ تا وقتی که از جهت شرعی براش محرز نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.84,
   "end": 95.56,
   "text": "نجس بودن این حالا وسیله‌ای که می‌خواد تهیه کنه یا اینکه از مردار تهیه شده یا نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.56,
   "end": 99.32,
   "text": "براش از نظر شرعی این محرز نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.32,
   "end": 102.64,
   "text": "همون بنا به اصل طهارته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.64,
   "end": 107.34,
   "text": "اون محکوم به طهارته و بنا رو می‌ذاره بر پاکی و خریداری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.34,
   "end": 114.02,
   "text": "اشکالی نداره. مگر اینکه مطمئن بشه یقین حالا اسبابی ایجاد بشه که یقین کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.02,
   "end": 117.72,
   "text": "حالا یه وارد کننده‌ای که قبولش داره بگه آقا این مارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.72,
   "end": 119.6,
   "text": "مثلا مشکل داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.6,
   "end": 121.78,
   "text": "اینو تهیه نکن شما قطعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.78,
   "end": 129.12,
   "text": "نجسه یا از مردار تهیه شده ولی در غیر این صورت اصل طهارت میگه نه آقا بنا رو بر طهارت و پاکی بذار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.12,
   "end": 132.98,
   "text": "چون محرز نشده برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.98,
   "end": 135.6,
   "text": "بحث قلب منافق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.6,
   "end": 139.86,
   "text": "به قسمت ظریفی از موضوع خودش رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.86,
   "end": 143.92,
   "text": "که یه نکته‌ای رو هم لای پرانتز عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.92,
   "end": 147.62,
   "text": "در کتاب آداب الصلاة حضرت امام رحمت الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.62,
   "end": 152.96,
   "text": "می‌فرماید که برای اینکه انسان بتونه به حقایق و بطون قرآن دست پیدا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.96,
   "end": 157.24,
   "text": "لاجرم باید از حجاب رد شه و بزرگ‌ترین حجاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.24,
   "end": 161.4,
   "text": "خود انسانه. خود نفس انسان و این تکبر و غرور و عجبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.4,
   "end": 167.44,
   "text": "ببخشید. هرکس در هر جایگاهی به نوعی گرفتار این قصه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.44,
   "end": 172.28,
   "text": "یکی کمتر، یکی بیشتر. تو نام و لایمات روزگار معلوم می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.28,
   "end": 176.64,
   "text": "که چه خبره. حالا یه آبدارچی میاد برای جناب حضرت مدیر یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.64,
   "end": 180.96,
   "text": "چایی رو می‌ذاره یادش میره پریشون احواله یادش میره مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.96,
   "end": 183.7,
   "text": "نلبکی بیاره. یا یادش میره مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.7,
   "end": 188.0,
   "text": "سلام کنه بیاد. چه می‌دونم. یا یادش میره در به بنده حضرت مدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.0,
   "end": 192.38,
   "text": "اعصابش می‌ریزه به هم و داد و فریاد و این چه وضعشه به من بی‌احترامی شد و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.38,
   "end": 194.82,
   "text": "یعنی یکی اینطوری، یکی هم یه جور دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.82,
   "end": 197.56,
   "text": "هرکی یه طور عجبش معلوم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.56,
   "end": 203.62,
   "text": "حضرت امام می‌فرماید که یکی از نشانه‌های عجب دقت بفرمایید خیلی عجیبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.62,
   "end": 207.24,
   "text": "که تو وجود ماست و این حجاب اکبره حضرت امام می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.24,
   "end": 210.86,
   "text": "که باعث می‌شه ما نفهمیم به حقایق قرآن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.86,
   "end": 216.96,
   "text": "پی نبریم که هیچی و از آیات قرآن حتی از آیات منافقین ما می‌تونیم استفاده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.96,
   "end": 220.9,
   "text": "یکی از عللی که نمی‌تونیم ما استفاده کنیم اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.9,
   "end": 225.76,
   "text": "در درون خودمون گمانمون اینه، امام می‌فرمایند، گمانمون اینه که این آیاتی که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.76,
   "end": 232.36,
   "text": "کفر و شرک و نفاق و جهنم و خزو و غلو و ثمل جهیم سلوا و چه می‌دونم این‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.36,
   "end": 234.94,
   "text": "به ما ربطی نداره. ما هم که اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 234.94,
   "end": 240.3,
   "text": "ایمانیم و اسلام رو قبول کردیم و نماز و روزه و این‌ها رو و حج و این‌ها رو داریم خمس میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.3,
   "end": 244.26,
   "text": "دیگه مثلا اینا مال ما نیست. جالبه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.26,
   "end": 248.94,
   "text": "اتفاقا امام می‌فرماید همین باعث می‌شه که شما از همه آیات قرآن استفاده نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.94,
   "end": 252.3,
   "text": "این حجاب اکبره. چرا آیات نفاق رو نمی‌خونید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.3,
   "end": 256.48,
   "text": "چرا آیات کفر رو نمی‌خونید؟ چرا آیات پیرامون جهنم رو نمی‌خونید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.48,
   "end": 261.64,
   "text": "هرکس در وا- وجود خودش در عالم وجودی خودش به نوعی گرفتار این قصه‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.64,
   "end": 265.18,
   "text": "یکی کمتر، یکی بیشتر. شما این آیه رو دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.18,
   "end": 268.8,
   "text": "آیه چهل و یک سوره مائده این بحثی که میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.8,
   "end": 275.2,
   "text": "الذین قالوا وقتی می‌خواد منافقین رو معرفی کنه یه چیزی داره میگه که انصافا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.2,
   "end": 278.74,
   "text": "تو اکثریت ماها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 278.74,
   "end": 283.7,
   "text": "می‌فرماید الذین قالوا آمنا بأفواههم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.7,
   "end": 288.46,
   "text": "همون که تو اون آیه صد و شصت و هفت سوره آل عمران دیروز گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.46,
   "end": 293.64,
   "text": "اینا چیزی رو میگن به زبونشون و لم تُعْمَنْ قُلُوبُهُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.64,
   "end": 296.5,
   "text": "در حالی که تو دلشون این رسوخ نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 296.5,
   "end": 303.3,
   "text": "و این نشونه نفاقه دیگه. حالا یکی کمتر یکی بیشتر لایه‌هاش عمیق‌تره، یکی ظریف‌تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 303.3,
   "end": 305.36,
   "text": "حالا لطیف‌تره چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.36,
   "end": 312.7,
   "text": "یکی ذومخ شده. چیزی که انسان به زبانش جاری کنه در حالی که بهش باور نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 312.7,
   "end": 315.62,
   "text": "اعتماد نه این نشانه نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 315.62,
   "end": 318.24,
   "text": "آیا این تو ما نیست انصافا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.24,
   "end": 322.58,
   "text": "حالا یکی کمتر یکی بیشتر گرفتاریم دیگه تعارف که با هم نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 322.58,
   "end": 325.06,
   "text": "هم که سراغ این آیات نمی‌ریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.06,
   "end": 330.18,
   "text": "ببینید دیروز ما عرض کردیم اصلا قلب، قلب مقام حضوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 330.18,
   "end": 335.2,
   "text": "قلب ببین میگه لم تُعْمَنْ قُلُوبُهُمْ اشاره به قلبشون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 335.2,
   "end": 337.16,
   "text": "قلب مقامیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 337.16,
   "end": 341.06,
   "text": "اون تو سلسله مراتب حس مشترک و تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.06,
   "end": 343.38,
   "text": "عالم خیال و وهم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.38,
   "end": 345.66,
   "text": "عقل و قلب و روح رو ما توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.66,
   "end": 348.0,
   "text": "جلسه گفتیم و رد شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 348.0,
   "end": 353.18,
   "text": "یادتون باشه قلب جایگاهیه که جمع می‌کنه، حاضر می‌کنه همه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 353.18,
   "end": 358.64,
   "text": "همه ادراکات قوای خیالیه که اومده به وهم یا و- بعد وهم داده به عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 358.64,
   "end": 362.07,
   "text": "عقل کلی‌سازی کرده از جزئیات و صور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.07,
   "end": 364.67,
   "text": "و اشکالی که در عالم خیال تشکیل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 364.67,
   "end": 368.57,
   "text": "همه رو میدن به قلب. قلب سان میبینه از اینا یعنی حاضرش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.57,
   "end": 372.07,
   "text": "اصلا قلب محل حضوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.07,
   "end": 377.25,
   "text": "اگر کسی حس حضور نداره در درگاه خدا این قلبش مشکل داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.25,
   "end": 379.31,
   "text": "این به نوعی دچار نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 379.31,
   "end": 381.39,
   "text": "صراحتا این آیه داره اینو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 381.39,
   "end": 387.47,
   "text": "اگر کسی به حضور نرسیده چون قلب، قلب مقام جمعیه، مقام حضوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.47,
   "end": 389.55,
   "text": "جمع حقایقه، حضوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.55,
   "end": 392.77,
   "text": "اگه کسی نماز میخونه حاضر نیست در برابر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 392.77,
   "end": 395.55,
   "text": "قرآن میخونه خدا رو حاضر نمیدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 395.55,
   "end": 400.49,
   "text": "جالبه میره مثلا حرم امام رضا میخواد امام رضا رو احضار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 400.49,
   "end": 405.37,
   "text": "بعضی جاها دیگه آدم به جایی میرسه انقدر بیچاره میشه که میخواد خدا رو هم احضار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 405.37,
   "end": 408.89,
   "text": "خدایا کجایی؟ تشریف بیارید ما با شما کار داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 408.89,
   "end": 411.37,
   "text": "یعنی دیگه انقدر مشکل پیدا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 411.37,
   "end": 413.41,
   "text": "خدایا تشریف بیار ما با شما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.41,
   "end": 416.43,
   "text": "احضار خدا صورت میگیره. احضار امام صورت میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.43,
   "end": 420.49,
   "text": "خیلی جالبه. امام رضا تشریف بیارید اینجا ما با شما کار داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.49,
   "end": 422.67,
   "text": "امام حسن تشریف بیارید ما با شما کار داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.67,
   "end": 426.67,
   "text": "احضاره. این یعنی اوج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.67,
   "end": 431.33,
   "text": "خدایی نکرده استغفرالله بی احترامیه به امام و خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.33,
   "end": 434.33,
   "text": "یعنی این یعنی چی؟ یعنی امام رو میخوای حاضر کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.33,
   "end": 437.47,
   "text": "تو مادونی اون مافوقه و اون اصلا همه جا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.47,
   "end": 445.21,
   "text": "جایی خالی از اون نیست. او در حضور تام تو میخوای حاضر کنی یعنی قلبت به حضور نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.21,
   "end": 450.77,
   "text": "این یعنی نفاق. اینکه ما میریم محضر امام رعوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 450.77,
   "end": 458.09,
   "text": "و کودکستانی حاجت میخوایم اینکه از خدا از امام حسن دبستانی حاجت میخوایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 458.09,
   "end": 462.19,
   "text": "یعنی اینکه اونها رو در جایگاه خودشون قرار ندادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 462.19,
   "end": 466.23,
   "text": "میگن بزرگان حکما میگن اگر رفتی حرم امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 466.23,
   "end": 470.77,
   "text": "دستت نرسید میوه بچینی از شجره طیبه اونها بی احترامی نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.77,
   "end": 473.71,
   "text": "نگو آقا خم شو من میوه بچینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 473.71,
   "end": 477.85,
   "text": "آقا به من ماشین بده، زنمو شفا بده، مشکل فلانمو حل کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.85,
   "end": 481.75,
   "text": "این یعنی خم شو من. میگه بیفت دستت نمیرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 481.75,
   "end": 487.63,
   "text": "بیفت پای شجره طیبه رو ببوس تبرکاً برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.63,
   "end": 492.81,
   "text": "شما حساب کنید اینکه میگه شما بری مثلا این همه راه بکوبی بری کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 492.81,
   "end": 497.43,
   "text": "بله تحت بقعه اباعبدالله دعا مستجابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 497.43,
   "end": 502.15,
   "text": "این همه بکوبی خودتو بری اونجا یا نماز الله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 502.15,
   "end": 505.11,
   "text": "بسم الله الرحمن الرحیم الحمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 505.11,
   "end": 509.15,
   "text": "لله مالکی یوم الدین میری رکوع، عزیم، سجده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 509.15,
   "end": 511.65,
   "text": "اعلا، السلام علیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 511.65,
   "end": 518.01,
   "text": "چه خبره؟ چی شده؟ لطف کنید یه مقدار پول تو جیبمون کم شده حضرت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 518.01,
   "end": 521.03,
   "text": "این آیا پایین آوردن و تنزل خدا نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 521.03,
   "end": 524.01,
   "text": "اینکه مثلا مثالی که حکما میزنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 524.01,
   "end": 526.71,
   "text": "حضرت علامه حسن زاده معمولا اینطوری مثال میزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 526.71,
   "end": 530.49,
   "text": "میگن شما فکر کن برید محضر مثلا پروفسور سمعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.49,
   "end": 533.55,
   "text": "ایشون حتما اسم میارن. میگن برید پیش somebody که متخصص مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 533.55,
   "end": 538.17,
   "text": "قلب و عروق و مغز و اعصاب در، در طراز اول تو دنیا وقت بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 538.17,
   "end": 540.13,
   "text": "خودت خودتونو بکشید که چی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.13,
   "end": 543.35,
   "text": "میخواید برید محضر ایشون. برسید محضر پروفسور سمعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 543.35,
   "end": 546.61,
   "text": "خب چی شده؟ خیلی س-تلاش کردی شش ماه تو نوبت بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 546.61,
   "end": 548.79,
   "text": "ببخشید اذیت شدی وقت گرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 548.79,
   "end": 551.17,
   "text": "چقدرم پول هزینه کردی. حالا چی میخوای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 551.17,
   "end": 554.19,
   "text": "یه آمپول دارم تشریف بیارید من بخوابم رو تخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.19,
   "end": 560.71,
   "text": "شما یه آمپول به ما بزن. دقیقا این چ حاجاتی که ما از خدا از اهل بیت و طلب میکنیم عین اینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.71,
   "end": 562.93,
   "text": "اون مقام کجا ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.93,
   "end": 565.85,
   "text": "لذا میگن رفتی محضر او بسپار به خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.85,
   "end": 568.53,
   "text": "تو تعیین نکن چی به تو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 568.53,
   "end": 574.39,
   "text": "تو خودش رو بخواه. از او کرامات بخواه، از او معارف و علوم دینی رو بخواه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 574.39,
   "end": 576.37,
   "text": "دیگه بقیه‌ش رو بسپر به خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 576.37,
   "end": 579.19,
   "text": "جزئیات رو. بی ادبی نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 579.19,
   "end": 582.73,
   "text": "چرا ما بی ادبی میکنیم؟ چرا دچار دو رویی و نفاق میشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.73,
   "end": 584.37,
   "text": "چرا از این حجاب‌ها رد نمیشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 584.37,
   "end": 588.61,
   "text": "چون در رو-- در درون خودمون میگه \"لم تمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.61,
   "end": 591.91,
   "text": "قلوبهم\" این وارد قلبشون نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.91,
   "end": 595.77,
   "text": "لذا این خطر نفاقه. از همین جا شروع میشه عزیز دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.77,
   "end": 601.05,
   "text": "نفاق، دو رویی، دو دستگی، بیچارگی که همه ما رو بیچاره کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 601.05,
   "end": 605.81,
   "text": "انشاالله عاقبت بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 605.81,
   "end": 607.95,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.95,
   "end": 612.49,
   "text": "صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 612.49,
   "end": 615.61,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}