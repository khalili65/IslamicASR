 "chapters": [
  {
   "index": 0,
   "title": "## کفارهٔ روزهٔ عمد و استغفارِ ناتوانی",
   "start": 9.38,
   "end": 147.88
  },
  {
   "index": 1,
   "title": "## قلب نفاق و پیوند با غیبت",
   "start": 147.88,
   "end": 169.4
  },
  {
   "index": 2,
   "title": "## خاتم الحصى و غیبتِ مقام در ترجمه",
   "start": 169.4,
   "end": 288.8
  },
  {
   "index": 3,
   "title": "## معجزهٔ خاتم الحصى در خانهٔ پیامبر",
   "start": 288.8,
   "end": 313.56
  },
  {
   "index": 4,
   "title": "## سنگریزه و مهر؛ معجزه در برابر انکار",
   "start": 313.56,
   "end": 668.13
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.1,
   "end": 4.74,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.74,
   "end": 9.38,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.38,
   "end": 15.48,
   "text": "در یکی از استفتائات که از رهبر عزیزمون شده پرسیدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.48,
   "end": 17.22,
   "text": "من عمداً روزه نگرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.22,
   "end": 23.84,
   "text": "خب کسی که عمداً بدون عذر شرعی روزه نمی‌گیره، می‌دونید کفاره جمع بهش تعلق می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.84,
   "end": 28.04,
   "text": "یعنی ب-برای هر یک روزی که عمداً نگرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.04,
   "end": 32.62,
   "text": "بدون عذر کفاره جمع یعنی شصت تا فقیر رو باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.62,
   "end": 38.2,
   "text": "سیر کنه و شصت روز روزه بگیره که سی و یک روزش پشت سر هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.2,
   "end": 40.46,
   "text": "خب برای هر یه روزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.46,
   "end": 44.34,
   "text": "حالا اون طرف هر کی بوده پرسیده که آقا جون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.34,
   "end": 50.22,
   "text": "من که اون روزه رو یه دونه رو نگرفتم، سی روزو نگرفتم برای هر یه روزش چی جوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.22,
   "end": 53.02,
   "text": "نمی‌تونم. من توان اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.02,
   "end": 55.46,
   "text": "کف-- به این شکل کفاره بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.46,
   "end": 57.72,
   "text": "ندارم. نه یت-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.72,
   "end": 60.84,
   "text": "فقرا رو شصت تا برای هر یه روز سیر کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.84,
   "end": 65.0,
   "text": "نه شصت روز روزه بابت هر یه روز بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.0,
   "end": 67.12,
   "text": "چه کنم؟ توان ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.12,
   "end": 73.24,
   "text": "حالا بعضیا اشتباه می‌گیرن این حکم رو مخصوصاً دارن میگن چون آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.24,
   "end": 77.84,
   "text": "ته حکم می‌فرماید کسی که توان نداره استغفار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.84,
   "end": 82.82,
   "text": "استغفاره جالبه که آقا می‌فرمایند هم قلبی هم لسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.82,
   "end": 84.82,
   "text": "منتها خب طرف میگه خب من توان ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.82,
   "end": 87.74,
   "text": "أستغفر الله ربي و أتوب الیه تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.74,
   "end": 94.88,
   "text": "در صورتی که ابتدای حکم رو دقت بفرمایید آقا می‌فرماید هر مقدار توان داره باید انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.88,
   "end": 100.26,
   "text": "یعنی اگه می‌تونه به جای شصت تا فقیر یه دونه فقیر رو سی-سیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.26,
   "end": 104.02,
   "text": "دیگه یه دونه فقیر رو می‌تونه باید همون یه دونه رو سیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.02,
   "end": 107.34,
   "text": "احتیاط واجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.34,
   "end": 113.14,
   "text": "بعدش چیکار کنه؟ بعدش هم دوباره استغفار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.14,
   "end": 119.1,
   "text": "یا اینکه نه، اصلاً اون یه دونه هم نمی‌تونه سیر کنه اون موقع استغفاره به تنها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.1,
   "end": 123.68,
   "text": "حواسمون جمع باشه بعضیا دنبال راحتی میگن خب أستغفر الله تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.68,
   "end": 127.28,
   "text": "اگه یه دونه‌ هم مثل فطریه که دیروز عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.28,
   "end": 134.96,
   "text": "اگر به اندازه‌ی یه نفر از اعضای خانواده رو می‌تونه فطریه‌ش رو بده باید دستگرکون، دستگرکون کنه بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.96,
   "end": 139.48,
   "text": "بچرخونه تو دست‌ها و بده از طرف همه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.48,
   "end": 143.3,
   "text": "نه اینکه حالا چون توان نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.3,
   "end": 147.88,
   "text": "به اندازه‌ی یه نفر فقط توان داره کلاً نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.88,
   "end": 153.48,
   "text": "بحث ما پیرامون قلب نفاق و دچار نفاق بود رو و ارتباطش با موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.48,
   "end": 159.72,
   "text": "غیبت رو عرض کردیم و حساسیت موضوع رو تا حدی متوجه شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.72,
   "end": 162.88,
   "text": "که البته این رو باید دقت داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.88,
   "end": 167.28,
   "text": "گرفتار شدن و سر خوردن به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.28,
   "end": 170.26,
   "text": "نفاق در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.26,
   "end": 172.46,
   "text": "غیبت‌های مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.46,
   "end": 178.34,
   "text": "یا به عبارتی در ازمنه‌ی مختلف، زمان‌های مختلف با هم متفاوت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.34,
   "end": 182.32,
   "text": "اگر کسی در زمان غیبت صغری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.32,
   "end": 185.26,
   "text": "دچار نفاق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.26,
   "end": 189.7,
   "text": "نشناختن امامش شده و باعث شده پرده‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.7,
   "end": 192.76,
   "text": "غیبت غلیظ‌تر بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.76,
   "end": 194.94,
   "text": "گناهش به نظر شما بیشتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.94,
   "end": 201.12,
   "text": "یا کسی که در زمان غیبت اینطور شده یا کسی که در زمان گشایش و ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.12,
   "end": 203.82,
   "text": "باز باعث غیبت حضرت بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.82,
   "end": 210.18,
   "text": "می‌شه در زمان ظهور، در زمان بودن امام کسی باعث غیبت امامش بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.18,
   "end": 214.36,
   "text": "گفتیم که همه‌ی اهل بیت به نوعی غیبت داشتن پس می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.36,
   "end": 217.56,
   "text": "حتی حضرت امام یه جمله‌ی طلایی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.56,
   "end": 220.6,
   "text": "نمی‌دونم اینو اصلاً شما دیدید یا نه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.6,
   "end": 228.12,
   "text": "یکی از شاگردان خاص حضرت امام می‌فرمودند که از امام سؤال کردیم همون اوایل انقلاب که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.12,
   "end": 234.72,
   "text": "این انقلاب آیا از علائم نزدیک بودن ظهور حضرت است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 234.72,
   "end": 241.34,
   "text": "امام محکم فرموده بود نه اینکه از علائم ظهوره، بلکه ابتدای ظهوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.34,
   "end": 244.78,
   "text": "علائم ظهور چیه؟ اصلاً ابتدای ظهوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.78,
   "end": 247.38,
   "text": "یعنی ظهور شروع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.38,
   "end": 251.46,
   "text": "همونطور که غیبت صغری و کبری داره، بزرگان فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.46,
   "end": 254.18,
   "text": "ظهور هم صغری، کبری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.18,
   "end": 261.26,
   "text": "ظهور صغری رخ داده. خب اگر کسی الان باعث غیبت امامش بشه به، به علت عدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.26,
   "end": 266.72,
   "text": "شناخت خیلی گناهش بیشتره در زمان ظهور، ظهور صغری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.72,
   "end": 270.12,
   "text": "الان چطور بعضیا با امام مرتبط‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.12,
   "end": 277.58,
   "text": "چطور امام رو می‌بینن؟ در زمان‌های مختلف این پرده غلظت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 277.58,
   "end": 281.78,
   "text": "حدت و شدت داره، رقت و غلظت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 281.78,
   "end": 284.82,
   "text": "البته همش ناشی می‌شه از عدم شناخت امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.82,
   "end": 290.32,
   "text": "بله. من دیروز اینجا با بچه‌ها که نشستیم این بحث براشون جالب اومده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 290.32,
   "end": 292.66,
   "text": "اومدن یه سؤالاتی رو پرسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.66,
   "end": 294.54,
   "text": "همونجا باز کردیم زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.54,
   "end": 299.48,
   "text": "مولودیه‌ی امیرالمؤمنین علیه الصلاة والسلام رو دیروز داشتم ملاحظه می‌کردم، بهشون نشون دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 299.48,
   "end": 301.62,
   "text": "گفتم غصه خوردم امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.62,
   "end": 304.38,
   "text": "تو مفاتیح خودمون حضرت غائبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.38,
   "end": 306.74,
   "text": "توی بخشیش، تو ترجمه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 306.74,
   "end": 309.94,
   "text": "گفتن یعنی چی حاجی؟ باز کردم تو بخش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.94,
   "end": 315.12,
   "text": "نگاه کنید تو مفاتیح توی القاب امیرالمؤمنین در زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 315.12,
   "end": 317.7,
   "text": "امیرالمؤمنین مولودیه‌ش یعنی روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.7,
   "end": 319.84,
   "text": "مولود پیغمبر حضرت رو زیارت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.84,
   "end": 326.66,
   "text": "یه بخشیش میگیم السلام امیر المؤمنین، السلام علیک یا خاتم الحصا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.66,
   "end": 328.5,
   "text": "چی ترجمه کرده باشن خوبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 328.5,
   "end": 331.72,
   "text": "خیلی من غصه خوردم. حالا نمی‌دونم مترجمش کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.72,
   "end": 337.1,
   "text": "تو این مفاتیح نوشته که سلام بر تو ای دارای خاتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.1,
   "end": 341.12,
   "text": "میگه خاتم الحصى اصلاً حرف تو اون حصى هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.12,
   "end": 346.82,
   "text": "این یعنی یه نوع غیبت. غائبه از نظر ما مقام و رتبه حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 346.82,
   "end": 349.64,
   "text": "اینه که ما سر می‌خوریم به سمت دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.64,
   "end": 352.84,
   "text": "به سمت باج‌خواهی، زیاده‌خواهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.84,
   "end": 355.18,
   "text": "مگه امیرالمؤمنین چجوری شد که تو خونه نشست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.18,
   "end": 358.84,
   "text": "چرا کشتن حضرت رو؟ اینقدر که سهم خواستن ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.84,
   "end": 363.84,
   "text": "اون‌هایی که تو بدر و خ-خیبر و حنین و عرض شود اوحد و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.84,
   "end": 366.5,
   "text": "سرداران لشکر بودن. س-- تلحه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.5,
   "end": 368.76,
   "text": "زوهر بزرگان لشکر بودن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.76,
   "end": 374.04,
   "text": "سهم‌خواهی است که کردن. مثل الان شما تو انقلاب خودمون چقدر پیش اومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 374.04,
   "end": 378.2,
   "text": "چقدر این پیش اومد که آقا ما سردار سازندگی فلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 378.2,
   "end": 383.31,
   "text": "بعد الان خیلی تو بحث خودمون خیلی از سردارهای ما این مشکلاتو پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.31,
   "end": 386.01,
   "text": "جذب دنیا شدن، سهم‌خواهی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.01,
   "end": 388.09,
   "text": "لذا ولایت فقیه در غربت رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.09,
   "end": 393.67,
   "text": "الان یکی از دلایل اینکه ولایت فقیه حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.67,
   "end": 396.73,
   "text": "شناختش میسر نیست برای خیلیا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.73,
   "end": 401.97,
   "text": "غلط کاری‌هاییه که خیلیا تو خ-خط ولایت مرتکب شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.97,
   "end": 406.09,
   "text": "مکدر کردن. چهره ولایت فقیه رو تو اذهان مکدر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.09,
   "end": 407.97,
   "text": "نمی‌تونه ببینه. اینو داره می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.97,
   "end": 413.47,
   "text": "این نماد ولایت فقیه؟ این بابایی که سردار مثلا فلان بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.47,
   "end": 418.71,
   "text": "از جزو مثلا علمدار‌های انقلاب بوده الان اینطوری تو زهر عذاب دراومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.71,
   "end": 424.93,
   "text": "این مکدر می‌کنه دیگه. نمی‌تونه دیگه شفاف نمی‌شه ببینه ولایت فقیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.93,
   "end": 428.05,
   "text": "لذا متاسفانه گناه اینا هم میفته دوش آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.05,
   "end": 433.91,
   "text": "اون موقع هم اینطوری بود. جالبه تو خونه خود امیرالمؤمنین این قصه حسى رو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 433.91,
   "end": 436.23,
   "text": "تو خونه خود پیغمبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 436.23,
   "end": 441.03,
   "text": "همسر پیغمبر اومده ازش سؤال می‌کنه بعد از حدیث منزلت، بعد از حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 441.03,
   "end": 450.77,
   "text": "غدیر، بعد از این همه هفتاد بار علنا پیغمبر امیرالمؤمنین رو جانشین بلافاصله خودش مع-معرفی کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 450.77,
   "end": 453.67,
   "text": "که این ل-لفظ وسی هم غریب واقع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 453.67,
   "end": 462.81,
   "text": "وسی. که باز همسر پیغمبر اومده پیش پیغمبر میگه آقا بالاخره بعد از شما کی جانشینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 462.81,
   "end": 467.85,
   "text": "بابا تو خونه پیغمبر امیرالمؤمنین غائبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 467.85,
   "end": 469.53,
   "text": "چیکار کرده باشه خوبه پیغمبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 469.53,
   "end": 472.15,
   "text": "دیگه حدیث و آیه دید کارساز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 472.15,
   "end": 475.63,
   "text": "عملیاتی وارد شد. گفت برو یه سر سنگ‌ریزه بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 475.63,
   "end": 479.45,
   "text": "سنگ‌ریزه آورد. سنگ‌ریزه نه شن یا سنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 479.45,
   "end": 482.11,
   "text": "تو رمی جمره انشاالله عزیزان میرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 482.11,
   "end": 485.37,
   "text": "این رمی جمره سنگ‌ریزه و شن حق نداری بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 485.37,
   "end": 491.57,
   "text": "چی؟ ببخشید. سنگ یعنی سنگ‌های درشت و شن حق نداری بزنی، سنگ‌ریزه باید بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 491.57,
   "end": 495.01,
   "text": "بین این دو. حسى یعنی سنگ‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 495.01,
   "end": 497.37,
   "text": "این رفت جمع کرد آورد داد دست پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 497.37,
   "end": 499.47,
   "text": "پیغمبر دو تا کف مبارک رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.47,
   "end": 502.35,
   "text": "اینطوری به هم مالوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 502.35,
   "end": 504.67,
   "text": "سنگ‌ریزه‌ها لای دست حضرت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.67,
   "end": 508.55,
   "text": "باز کرد دید اِ مثل خمیر نون شده این سنگ‌ریزه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.55,
   "end": 511.85,
   "text": "بعد بهش شکل داد روش مهر زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.85,
   "end": 515.41,
   "text": "سنگ‌ریزه رو مثل شکل بهش داد مهر زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.41,
   "end": 522.69,
   "text": "یعنی معجزه نشون داد. پیغمبر فرمود هرکس این کارو بکنه بعد از-- هرکس این کارو انجام بده جانشین بعد از منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.69,
   "end": 526.11,
   "text": "دیگه، دیگه به این صراحت، به این وضوح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 526.11,
   "end": 532.19,
   "text": "جالبه همسر پیغمبر میدونه دیگه گراها رو با-- بلافاصله رفت پیش امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 532.19,
   "end": 535.85,
   "text": "با این حال باز رفت گفت مولا همچین اتفاقی افتاده یا علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 535.85,
   "end": 539.79,
   "text": "پیغمبر باز همین کارو امیرالمؤمنین فرمود برو سنگ‌ریزه جمع کن بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 539.79,
   "end": 542.69,
   "text": "آورد و با دست مبارک مالوند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 542.69,
   "end": 544.75,
   "text": "بهش شکل داد و بعد مهر زد روش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 544.75,
   "end": 551.17,
   "text": "خاتم الحسى. یعنی سلام بر تو ای کسی که مهر کردی سنگ‌ریزه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 551.17,
   "end": 555.01,
   "text": "عهدی نکرده جز بعد از پیغمبر امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 555.01,
   "end": 558.05,
   "text": "می‌خوام به شما عرض کنم تو خونه پیغمبر امیرالمؤمنین غائبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 558.05,
   "end": 560.61,
   "text": "برای همسر پیغمبر غیبت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 560.61,
   "end": 563.39,
   "text": "اما خب اون غیبت کجا، غیبت الان کجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.39,
   "end": 568.15,
   "text": "الان تو این نظام ولایی آدم بخواد باعث غیبت امام عصر بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 568.15,
   "end": 570.53,
   "text": "این خیلی گناهش سنگین‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 570.53,
   "end": 574.81,
   "text": "مگر ام-امام رحمة الله سؤال خیلی قشنگی اینم بگم و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 574.81,
   "end": 578.63,
   "text": "دیروز بچه‌ها خیلی کیف کردن پرسیدن که آقا بعد از بحث ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 578.63,
   "end": 582.47,
   "text": "که آیا بحث این غیبت موضوعش به ولایت فقیه هم کشیده می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 582.47,
   "end": 585.43,
   "text": "گفتم عزیز دلم مگر حضرت امام نفرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 585.43,
   "end": 588.17,
   "text": "ولایت فقیه ادامه‌ی ولا-- همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 588.17,
   "end": 590.23,
   "text": "پیغمبر، ولایت پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 590.23,
   "end": 597.13,
   "text": "یعنی چی؟ آیا واقعاً ما ولایت فقیه رو، این جایگاه رو به جایگاه پیغمبر می‌بینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 597.13,
   "end": 601.71,
   "text": "چطور سید حسن نصرالله میگه من میل رهبر رو، میل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 601.71,
   "end": 608.27,
   "text": "رهبر ایران که چه عرض کنم می‌فرماید ولی امر مسلمین جهان رو، میلشو پیگیری می‌کنم نه دستوراتشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 608.27,
   "end": 612.33,
   "text": "که میل ایشون رو ببینم چیه، طبق میل ایشون رفتار کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 612.33,
   "end": 618.33,
   "text": "بعد میگه من تعجبم چطور مسئولین تو ایران بعضیا اصلاً دستور ایشونو رو زمین میذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 618.33,
   "end": 622.77,
   "text": "ج-- چرا-- یعنی تو ح-- بحث ولایت فقیه هم الان در غیبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 622.77,
   "end": 625.59,
   "text": "ما کِی شناختیم؟ کِی می‌شناسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 625.59,
   "end": 630.71,
   "text": "لذا وقتی که اسم ببرم، وقتی آقا می‌خواستن انتخابش کنن دیدید فیلمه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 630.71,
   "end": 632.81,
   "text": "توی خبرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 632.81,
   "end": 637.29,
   "text": "آقا می‌فرمود به یکی از اینا میگه که ولایت فقیه جایگاه حکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 637.29,
   "end": 640.33,
   "text": "اگه من، من حکم کنم تو می‌پذیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 640.33,
   "end": 645.85,
   "text": "میگه بله می‌پذیرم. بعد جالبه اول کسی که جلو آقا وایمیسته همون آقا بود، همون شخص بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 645.85,
   "end": 649.45,
   "text": "جایگاه حکمه. غائبه از نظر‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 649.45,
   "end": 653.33,
   "text": "مراقب باشیم این پرده غیبت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 653.33,
   "end": 657.33,
   "text": "که اگر رقیق شده دوباره غلیظش نکنیم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 657.33,
   "end": 660.53,
   "text": "خدایی نکرده نفاق قلبی‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 660.53,
   "end": 665.31,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 665.31,
   "end": 668.13,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}