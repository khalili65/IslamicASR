 },
 "chapters": [
  {
   "index": 0,
   "title": "## سه شرط باقی‌ماندهٔ سفر برای قصر نماز",
   "start": 13.68,
   "end": 174.72
  },
  {
   "index": 1,
   "title": "## شرح نزول؛ همراه جنگ و مسخره‌گر در خلوت",
   "start": 174.72,
   "end": 194.78
  },
  {
   "index": 2,
   "title": "## تطبیق با زبان امروز دربارهٔ اهل ولایت",
   "start": 194.78,
   "end": 307.74
  },
  {
   "index": 3,
   "title": "## آیات نصرت؛ سرخوردگی ظاهرالدینان",
   "start": 307.74,
   "end": 654.6
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 3.74,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.74,
   "end": 7.46,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.46,
   "end": 12.16,
   "text": "آياته. سلامٌ عليكم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.16,
   "end": 18.56,
   "text": "خب ما عرض کردیم برای اینکه انسان مسافر باشه و نمازش قصر باشه هشت تا شرط وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.56,
   "end": 21.74,
   "text": "پنج تاشو گفتیم سه تا دیگه‌ش هم امروز سریع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.74,
   "end": 27.42,
   "text": "عرض کنیم که البته به موقعش باید اینا رو توضیح بدیم و استفتائات، استفتائات‌شون رو بررسی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.42,
   "end": 30.14,
   "text": "یکی دیگه اینه که از شروط اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.14,
   "end": 34.92,
   "text": "شخص مسافر حساب بشه اینه که خانه بدوش نباشه اصطلاحا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.92,
   "end": 36.84,
   "text": "مثل این کوچ‌نشین‌ها، اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.84,
   "end": 38.92,
   "text": "خانه بدوش‌اند از اینجا به اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.92,
   "end": 41.32,
   "text": "یلاق قشلاق می‌کنند. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.32,
   "end": 45.1,
   "text": "مسافر نیستند هر جا که میرن مسافر حساب نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.1,
   "end": 47.94,
   "text": "دو اینکه سفرشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.94,
   "end": 50.72,
   "text": "نکته بعدی اینکه یا عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.72,
   "end": 54.04,
   "text": "ااا میشه گفتش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 54.04,
   "end": 59.88,
   "text": "شرط بعدی اینه که مسافرتش سفر شغلی حساب نشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.88,
   "end": 62.12,
   "text": "که حالا اینو باید بعدا بحث کنیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.12,
   "end": 66.48,
   "text": "با چه شرایطی انسان سفرش، سفر شغلی میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.48,
   "end": 70.02,
   "text": "عرض شود خیلی هم استفتائات زیادی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.02,
   "end": 73.76,
   "text": "و متاسفانه البته از جهتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 73.76,
   "end": 81.34,
   "text": "مردم هم خیلی آگاه نیستند از این جهت چون اختلاف فتاوی تو این قصه زیاده اینو حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.34,
   "end": 85.82,
   "text": "تو بحث سفر شغلی اختلاف فتوا ما زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.82,
   "end": 88.12,
   "text": "یکی هم اینکه سفرش جایز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.12,
   "end": 92.82,
   "text": "باشه. اگر سفرش جایز نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.82,
   "end": 95.58,
   "text": "حتی اگر مسافت شرعی هم رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.58,
   "end": 99.2,
   "text": "مسافر حساب نمیشه که حالا اینو بعدا توضیح میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.2,
   "end": 101.1,
   "text": "یعنی جایز باشه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 101.1,
   "end": 103.28,
   "text": "یعنی برای گناه نره یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.28,
   "end": 107.08,
   "text": "سفرش گناه نباشه. حالا اینو بعدا توضیح میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 107.08,
   "end": 110.68,
   "text": "یعنی یا سفرش گناه میشه طرف یا برای گناه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 110.68,
   "end": 112.88,
   "text": "اون موقع سفرش جایز نیست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 112.88,
   "end": 117.08,
   "text": "مسافر حساب نمیشه. خب یکی دیگه از آیاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 117.08,
   "end": 119.44,
   "text": "پرده‌برداری کرده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 119.44,
   "end": 122.12,
   "text": "صفات اهل نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 122.12,
   "end": 126.1,
   "text": "آیه شصت و پنج و شصت و شش سوره نسا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 126.1,
   "end": 133.32,
   "text": "بخشیش رو من قرائت کنم. \"قل أبالله وآياته ورسوله كنتم تستهزئون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.32,
   "end": 136.84,
   "text": "لا تعتذروا قد كفرتم بعد إيمانكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 136.84,
   "end": 140.28,
   "text": "فرمود که بهشون بگو يا رسول الله که آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 140.28,
   "end": 144.48,
   "text": "به خدا و آیاتش \"أبالله وآياته ورسوله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 144.48,
   "end": 149.64,
   "text": "به خدا و آیاتش و پیغمبرش \"كنتم تستهزئون\" استهزاء می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 149.64,
   "end": 152.28,
   "text": "مسخره می‌کنید؟ می‌خندید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 152.28,
   "end": 160.02,
   "text": "\"لا تعتذروا\" شما وضعیتتون به یه جایی رسیده که اصلاً عذرخواهی‌تون هم دیگه فایده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 160.02,
   "end": 162.36,
   "text": "انقدر گناهای شما سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 162.36,
   "end": 165.12,
   "text": "\"قد كفرتم\" به تحقیق شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 165.12,
   "end": 168.78,
   "text": "کفر ورزیدید \"بعد إيمانكم\" این خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 168.78,
   "end": 174.72,
   "text": "قابل تأمله. میگه بعد ایمان شما به کفر کشیده شدید به خاطر صفت نفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 174.72,
   "end": 180.12,
   "text": "در حقیقت این آیه رو من بررسی می‌کردم امروز شرح نزولش دیدم پیرامون عده‌ایه که اینا حتی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 180.12,
   "end": 183.22,
   "text": "جنگ هم همراه اهل ایمان بودند، همراه پیغمبر بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 183.22,
   "end": 186.94,
   "text": "عجیبه！ یعنی حتی رفته بودند جنگیده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 186.94,
   "end": 192.96,
   "text": "تو جهاد شرکت کردن، تو حج با پیغمبر بودند، نماز جماعت می‌دادند به پیغمبر اقتدا می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 192.96,
   "end": 197.52,
   "text": "اما وقتی دور هم جمع می‌شدند مسخره می‌کردند اهل ایمان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.52,
   "end": 201.84,
   "text": "حرفشون هم این بود. می‌گفتند ما ندیدیم از اصحاب و یاران پیغمبر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.84,
   "end": 204.46,
   "text": "انقدر شکموتر و انقدر به فکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 204.46,
   "end": 207.96,
   "text": "سیر کردن شکم خودش باشه و انقدر ترسو باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 207.96,
   "end": 210.1,
   "text": "این دو تا رو مخصوصا زیاد می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 210.1,
   "end": 213.34,
   "text": "اینا ترسوئن، این‌ها اهل شکم، شکم‌پرستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.34,
   "end": 216.58,
   "text": "فلان. هر-- دقیقا حرفایی که الان در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 216.58,
   "end": 219.14,
   "text": "کیا می‌زنن؟ بچه ولایتی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 219.14,
   "end": 221.7,
   "text": "آره اینا آخوندها، بچه ولایتی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 221.7,
   "end": 224.44,
   "text": "اینا آره من دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 224.44,
   "end": 226.8,
   "text": "خالی کردن جیب مردمند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 226.8,
   "end": 231.2,
   "text": "اینا نم-- جوجه بسیجی جلو آمریکا وایمیسته، این جوجه بسیجی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 231.2,
   "end": 234.54,
   "text": "دقیقا بعضیاشون هم جالبه که خودشون هم تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 234.54,
   "end": 238.78,
   "text": "وجاهت‌ها بودند و تو سابقه جنگ دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 238.78,
   "end": 242.28,
   "text": "جنگ رفتن. بعضیاشون متاسفانه حتی جانبازن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 242.28,
   "end": 245.92,
   "text": "و ه-- نماز می‌خونن، مسجد میرن، هیئت هم می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 245.92,
   "end": 248.04,
   "text": "اما مسخره می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 248.04,
   "end": 253.38,
   "text": "اصلا بچه-- چقدر رهبر فرمود آقا انقدر این بچه بسیجی‌ها رو تندرو لقب ندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.38,
   "end": 255.58,
   "text": "یادتونه چقدر این رو بولد کرده بودند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 255.58,
   "end": 258.14,
   "text": "تندروها، افراطیون فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 258.14,
   "end": 262.4,
   "text": "عه بچه ارزشی‌ها رو هی تندرو لقب می‌زدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 262.4,
   "end": 265.86,
   "text": "انگ می‌زدن. که این‌ها خودشان ترسوئن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 265.86,
   "end": 271.12,
   "text": "بعد جالبه که با پررویی تمام هم می‌گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 271.12,
   "end": 276.52,
   "text": "ما بودیم اگر ما نبودیم آمریکا میومد و جنگ میشد و فلان و که رهبر صراحتا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 276.52,
   "end": 280.02,
   "text": "خدا حفظ کنه آقا رو فرم-- عقب، عقبشون دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 280.02,
   "end": 285.52,
   "text": "گفتن که خجالت بکشید. چرا برمی‌گردید میگید که میگید ما بودیم که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 285.52,
   "end": 287.7,
   "text": "سایه جنگ را از سر مملکت بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 287.7,
   "end": 291.52,
   "text": "مردم بودند حضور اقشار مختلف مردم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 291.52,
   "end": 295.28,
   "text": "رهبر این رو توجه داد که به مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 295.28,
   "end": 300.24,
   "text": "یعنی این پشتوانه بودن مردم از نظامی که آمریکا جرات نکرده و الا شما چی کاره‌اید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 300.24,
   "end": 305.6,
   "text": "شما خودتون ترسوئید و این‌ها غالبا به وعده‌های خدا هم عمل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 305.6,
   "end": 308.82,
   "text": "توجه ندارن. اینکه آیه مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 308.82,
   "end": 311.92,
   "text": "صد و شصت آل عمران تا دلتون بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 311.92,
   "end": 318.06,
   "text": "از این آیات در قرآن هست. وقتی آدم یه دونه از این آیات رو نگاه می‌کنه دلش قرص میشه اگه اهل ایمان باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 318.06,
   "end": 320.54,
   "text": "این نشون میده که این‌ها سر خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 320.54,
   "end": 323.16,
   "text": "به ظاهر تو لباس دین و هیئت دینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 323.16,
   "end": 326.2,
   "text": "ترسوئن، از دشمن می‌ترسند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 326.2,
   "end": 329.46,
   "text": "که اینچنین‌اند. و الا همین یه آیه اصلاً بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 329.46,
   "end": 333.34,
   "text": "\"إن ينصركم الله فلا غالب لكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 333.34,
   "end": 336.22,
   "text": "الله اکبر. میگه اگه شما نس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 336.22,
   "end": 341.66,
   "text": "خدا شما رو نصرت بده \"فلا غالب لكم\" احدی نمی‌تونه بر شما غلبه پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 341.66,
   "end": 345.64,
   "text": "آمریکا کیلو چنده؟ توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 345.64,
   "end": 348.76,
   "text": "همین یه آیه و \"إن يخذلكم\" بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 348.76,
   "end": 353.12,
   "text": "اگر هم خدا بخواد شما رو خوار کنه \"فمن الله الذي ينصركم من بعده\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 353.12,
   "end": 357.04,
   "text": "هیچکس نمی‌تونه جلوی اینکه خدا بخواد شما رو خوار کنه رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 357.04,
   "end": 363.54,
   "text": "قدرت دست خداست و \"وعلى الله فليتوكل المؤمنون\" اهل ایمان اهل توکل، اعتماد به خدااند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 363.54,
   "end": 369.22,
   "text": "اینا به خدا هم اعتماد ندارن. جالبه تو نظامن، دارن نون نظامو می‌خورن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 369.22,
   "end": 374.14,
   "text": "بعد بر علیه نظامم بر علیه ارزش‌های نظام، اون چیزهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 374.14,
   "end": 379.06,
   "text": "یا اون قشرهایی که بار نشا-- نظام رو دوششون نگه داشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 379.06,
   "end": 381.74,
   "text": "سایه جنگ و و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 381.74,
   "end": 385.94,
   "text": "عدم امنیت رو از مملکت دور کردن رو اونا رو مسخره می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 385.94,
   "end": 391.46,
   "text": "یه مشت پا برهنه گرسنه استغفرالله جاهل نادونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 391.46,
   "end": 395.14,
   "text": "دنبال سر اینا راه افتادن، این آخوندا و فلان و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 395.14,
   "end": 397.56,
   "text": "و چقدرم تحریف کردن تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.56,
   "end": 399.96,
   "text": "حتی یادتونه زمان جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 399.96,
   "end": 403.06,
   "text": "اِاِاِ یه شعرهایی می‌خوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 403.06,
   "end": 404.7,
   "text": "یا تو هیئتا هم الان هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 404.7,
   "end": 406.86,
   "text": "نمی‌دونم سینه بزن هله هلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 406.86,
   "end": 412.72,
   "text": "امشب پلو می‌خوری فلان. یه وقت اینا میاد حالت جنبه شوخی و مزاح بین خودمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 412.72,
   "end": 416.38,
   "text": "ازشم رد میشیم. ولی اون‌ها حساب شده اینا رو میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 416.38,
   "end": 419.56,
   "text": "الان خیلی خدا حفظ کنه علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 419.56,
   "end": 424.56,
   "text": "هزار و سیصد و خرده‌ای ضرب‌المثل رو آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 424.56,
   "end": 427.68,
   "text": "جمع کرده تو یه کتاب که این‌ها منحرف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 427.68,
   "end": 430.02,
   "text": "توسط کی اینا رو منحرف می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 430.02,
   "end": 433.8,
   "text": "همین دشمن، همین منافقا. تو لباس دینم هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 433.8,
   "end": 436.74,
   "text": "مثلاً یکیش همین ملاخوری، ملاخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 436.74,
   "end": 440.02,
   "text": "علامه می‌فرمود الان میگن ملاخور شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 440.02,
   "end": 442.42,
   "text": "یعنی مثلاً مفخور، مفخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 442.42,
   "end": 445.6,
   "text": "میگن ملاخور. در صورتی که اصلش چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 445.6,
   "end": 449.7,
   "text": "این ضرب‌المثل اینجا بوده که مثلاً قدیما وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 449.7,
   "end": 451.78,
   "text": "می‌خواستن برداشت محصول کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 451.78,
   "end": 454.2,
   "text": "برای برکت زمین‌شون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 454.2,
   "end": 458.28,
   "text": "محصول آماده برداشته یه ملا، یه عالم میاوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 458.28,
   "end": 462.34,
   "text": "می‌گفتن اولین مثلاً خیار مزرعه ما رو شما بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 462.34,
   "end": 465.48,
   "text": "ملاخوره یعنی این آماده‌ برداشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 465.48,
   "end": 468.8,
   "text": "یعنی برکت اومده توش. بعد اومدن الان چیکارش کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 468.8,
   "end": 471.88,
   "text": "میگن اِ ملاخوری، نمی‌دونم مفخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 471.88,
   "end": 474.3,
   "text": "توجه کردی؟ دقیقاً می‌بینید چجوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 474.3,
   "end": 478.6,
   "text": "تحریف کردن. مسخره می‌کنن حقایق و معارف رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 478.6,
   "end": 480.64,
   "text": "یا همین ماستخور، ملا ماستخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 480.64,
   "end": 483.06,
   "text": "همیشه زیاد شنیدیم شما ماستخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 483.06,
   "end": 487.1,
   "text": "یه کسی ش سسته، شلوغله میگن ملا ماستخور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 487.1,
   "end": 488.92,
   "text": "یا ماستخور ماستخورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 488.92,
   "end": 494.52,
   "text": "این‌طور نیست؟ در صورتی که علامه می‌فرمود اصلش این بوده ملا ماست خورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 494.52,
   "end": 496.8,
   "text": "چون قدیما ملاها، ع-علمای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 496.8,
   "end": 500.36,
   "text": "شیعه الانم اینطوریه. شلواراشونو کوتاه می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 500.36,
   "end": 505.02,
   "text": "سیبیل‌شون رو کوتاه می‌کردن. ولی مشایخ و دیگران اینطوری نبودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 505.02,
   "end": 507.98,
   "text": "بزرگان دهکده اینا سیبیل‌های بلند می‌ذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 507.98,
   "end": 512.96,
   "text": "بعد وقتی می‌خواستن یه کسی تبرکن شیر و ماست مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 512.96,
   "end": 515.5,
   "text": "اِاِاِ از گوسفند و گاوش که گرفته بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 515.5,
   "end": 519.72,
   "text": "تبرکن می‌خواسته بده به بزرگ ده‌شون، ترجیح می‌داده به ملاها بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 519.72,
   "end": 524.34,
   "text": "چرا؟ چون اون‌ها سیبیل نداشتن سریع می‌خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 524.34,
   "end": 526.92,
   "text": "سریع می‌خوردن. اتفاقاً چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 526.92,
   "end": 531.34,
   "text": "با سرعت می‌خوردن می‌گفتن ملا ماست خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 531.34,
   "end": 538.52,
   "text": "ولی اون وری‌ها چی؟ سیبیلا بلند کلی طول می‌کشید این سیبیلا رو بده کنار یواش یواش شیر و یا ماست بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 538.52,
   "end": 541.36,
   "text": "اینارو علامه توضیح می‌ده ها. جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 541.36,
   "end": 544.32,
   "text": "الان مثلاً یکی شلوغله بهش میگن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 544.32,
   "end": 549.2,
   "text": "ملا ماست خورد. چنام تحریف کردن تو حقایق و اونا دست آوردن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 549.2,
   "end": 552.56,
   "text": "اونا آوردن. حالا وقتتونو نگیرم خلاصه‌ش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 552.56,
   "end": 559.54,
   "text": "اینکه خیلی موقع‌ها این مسخره کردن‌ها تو خود من خودم بارها شنیدم میگم رهبر دلش به کی خوشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 559.54,
   "end": 562.9,
   "text": "باور کنید از همین بچه مثبت و هیئتی‌هام اینو شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 562.9,
   "end": 567.5,
   "text": "به کی دلش خوشه؟ آمریکا هم هیچ غلطی نمی‌تونه با کی می‌خواد بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 567.5,
   "end": 570.32,
   "text": "شهید حججی رفته بود شهید شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 570.32,
   "end": 573.66,
   "text": "شهادت اینو چقدر تحریف کردن همین بچه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 573.66,
   "end": 577.62,
   "text": "آقا تو اگه می‌خواستی شهید شی چرا رفتی ازدواج کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 577.62,
   "end": 580.36,
   "text": "برای چی رفتی ازدواج کردی؟ به زنت میگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 580.36,
   "end": 583.3,
   "text": "شب قد تو حرم امام رضا علیه‌السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 583.3,
   "end": 585.98,
   "text": "برام دعا کن. من یه دعا بیشتر ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 585.98,
   "end": 587.6,
   "text": "زنت به زور از تو بپرسه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 587.6,
   "end": 592.18,
   "text": "بعد اولش یه شینه، بعدش یه ه، بعدش یه الف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 592.18,
   "end": 594.86,
   "text": "و همینطوری برسه تا شهادت. خب برای چی ازدواج کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 594.86,
   "end": 597.22,
   "text": "من اینو بارها شنیدم. نمی‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 597.22,
   "end": 601.24,
   "text": "شعور ندارن. این کار نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 601.24,
   "end": 604.68,
   "text": "کار منافقینه. تو همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 604.68,
   "end": 609.62,
   "text": "من یه توصیه می‌کنم انشاالله اینو بعداً دوباره تصریحش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 609.62,
   "end": 613.82,
   "text": "یه مدیر موفق مگه رهبر نمیگه نفوذ، نفوذ کار کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 613.82,
   "end": 616.34,
   "text": "کافر و مشرک؟ نه منافق نفوذ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 616.34,
   "end": 619.48,
   "text": "کافر و مشرک معلوم الحال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 619.48,
   "end": 622.94,
   "text": "این آیاتو بیان دسته‌بندی کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 622.94,
   "end": 630.04,
   "text": "یه حرمی درست کنن. یه منظومه‌ای درست کنن قشنگ مشخصات منافقین و اهل نفاق رو کاملاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 630.04,
   "end": 633.06,
   "text": "برهنه با قرآن و روایات بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 633.06,
   "end": 636.1,
   "text": "یه مدیر برای اینکه از نفوذ حفظ بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 636.1,
   "end": 639.32,
   "text": "اینو یه منظومه کنه مشخص بشه اینا چه خصوصیت‌هایی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 639.32,
   "end": 642.46,
   "text": "راحت می‌تونه نفوذ رو شناسایی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 642.46,
   "end": 647.08,
   "text": "انشاالله عاقبت ما ختم به خیر بشه و به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 647.08,
   "end": 654.6,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}