   "title": "## ریشهٔ لغوی نفاق: نافقاءُ الیربوع",
   "start": 95.66,
   "end": 211.1
  },
  {
   "index": 1,
   "title": "## حدیث امام سجاد: نهی می‌کند و نهی نمی‌پذیرد",
   "start": 211.1,
   "end": 235.42
  },
  {
   "index": 2,
   "title": "## تواضع امام و علامه در برابر مخالفت و نقد",
   "start": 235.42,
   "end": 433.53
  },
  {
   "index": 3,
   "title": "## داستان علامه قزوینی و ملا محسن فیض کاشانی",
   "start": 433.53,
   "end": 668.13
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.04,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.04,
   "end": 6.68,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.68,
   "end": 10.98,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.98,
   "end": 16.32,
   "text": "خب ایام عید نزدیکه و معمولا سفرها شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.32,
   "end": 22.38,
   "text": "خب آدم همسفر میشه تو راه بالاخره تو قطار، اتوبوس هر جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.38,
   "end": 26.0,
   "text": "هواپیما یا خودش وسیله‌ش که میره بیرون جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.0,
   "end": 28.1,
   "text": "میشینن همه گرد هم‌ن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.1,
   "end": 32.12,
   "text": "میخوان غذای چیزی بخورن کسی بهش تعارف میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.12,
   "end": 37.76,
   "text": "بالاخره نمیدونه این کسی که مثلا تو کوپه قطار بهش داره غذا رو تعارف میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.76,
   "end": 42.48,
   "text": "غذا هم مثلا رطوبت داره بهش مثلا آبکیه یا هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.48,
   "end": 45.5,
   "text": "این بالاخره مسلمانه، کافره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.5,
   "end": 51.64,
   "text": "مشرکه، اهل کتابه، بها-بهائیه، مسیحیه، چه میدونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.64,
   "end": 57.38,
   "text": "خب ما هم که اجازه نداریم که از دست کافر مثلا غذا بگیریم بخوریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.38,
   "end": 61.16,
   "text": "حرامه. اینجا چه باید بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.16,
   "end": 64.52,
   "text": "بر اساس اصل طهارت همه مراجع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.52,
   "end": 70.2,
   "text": "فرمودن که اینجا واجب نیست تفتیش در خصوص عقاید طرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.2,
   "end": 76.28,
   "text": "واجب نیست و همون بر اساس اصل طهارت باید چیکار کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.28,
   "end": 80.5,
   "text": "بنا رو بذاری بر اینکه آقا پاکه این غذا و اینم ایشالله مسلمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.5,
   "end": 85.6,
   "text": "نیازی به تفتیش نیست. حالا یه وقت کسی میخواد احتیاط کنه اون قصه‌ش فرق میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.6,
   "end": 90.42,
   "text": "اما قضیه شرعی‌ش، حکم شرعی‌ش این میشه که واجب نیست تفتیش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.42,
   "end": 95.66,
   "text": "بخور آقا جون حلاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.66,
   "end": 98.8,
   "text": "در خصوص قلب منافق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.8,
   "end": 105.1,
   "text": "بحث لغتی‌ش رو من یه ذره بررسی کردم به یه نتیجه جالبی رسیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.1,
   "end": 109.44,
   "text": "که اصلا نفاق از نفق میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.44,
   "end": 114.7,
   "text": "و دلیل اینکه بهش گفتن منافق یا نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.7,
   "end": 116.98,
   "text": "میگن در اصل از ناف–",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.98,
   "end": 119.94,
   "text": "نافقا اليربوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.94,
   "end": 125.04,
   "text": "گرفته شده که این نافقا هم جمع نف-نفقاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.04,
   "end": 128.66,
   "text": "آخرش همزه است. نفقاء هم به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.66,
   "end": 131.26,
   "text": "حفره موش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.26,
   "end": 135.76,
   "text": "و اصلا کلا این نافقا اليربوع به اون حفره‌های موش میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.76,
   "end": 137.9,
   "text": "حالا موش چیکار میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.9,
   "end": 141.2,
   "text": "بعضی از این حفر-حفره‌ها رو جلوی چشم قرار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.2,
   "end": 148.14,
   "text": "خیلی زیرکه این موش. و بعضی از این حفره‌ها رو یه جوری قرار میده تو چشم نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.14,
   "end": 153.22,
   "text": "برای روز مبادا که اگه یه وقت کسی خواست فر-- مثلا حمله کنه بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.22,
   "end": 156.84,
   "text": "بدونه از کدوم سوراخ بره تو، از کدوم بیاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.84,
   "end": 160.56,
   "text": "گم کنه طرف رو. یعنی یه کاری کنه که نتونن بگیرنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.56,
   "end": 163.12,
   "text": "این کارе دقیقا منافقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.12,
   "end": 166.28,
   "text": "منافق دو روئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.28,
   "end": 168.36,
   "text": "زیر و روکشی میکنه به قول بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.36,
   "end": 171.86,
   "text": "اینطوری نیست. صاف و ساده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.86,
   "end": 176.26,
   "text": "رو در رو که برخورد میکنه پشت قضیه یه چیز دیگه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.26,
   "end": 180.2,
   "text": "برای روز مبادا خیلی چیزا رو تو دلش نگه داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.2,
   "end": 185.74,
   "text": "و خیلی-- اینکه میگه حتی اگر عیب‌هایی رو از کسی دید مینویسه، ثبت میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.74,
   "end": 188.14,
   "text": "ضبط میکنه، مراقبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.14,
   "end": 193.9,
   "text": "دیدی بعضیا ضبط میکنن بعد نگه میدارن برای روز مبادا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.9,
   "end": 195.64,
   "text": "که آبرو حیثیت طرف رو ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.64,
   "end": 199.46,
   "text": "این از صفات منافقه. حالا بهش هم میرسیم ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.46,
   "end": 201.4,
   "text": "این فعلا حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.4,
   "end": 203.44,
   "text": "بعد ناراحت هم نشید خواهش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.44,
   "end": 207.9,
   "text": "ببینید من دارم آیات قرآن رو بررسی می‌کنم، روایات و گفتار بزرگانو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.9,
   "end": 212.34,
   "text": "هیچیش از خودم نیست و خدا رو شاهد می‌گیرم حدیث نفس برای خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.34,
   "end": 214.8,
   "text": "من وقتی اینا رو می‌خونم تنم می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.8,
   "end": 216.92,
   "text": "میگم برم بلند برای همه بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.92,
   "end": 221.52,
   "text": "اونا هم شاید تاثیری کرد. اگر کسی مثل من وضعش خرابه اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.52,
   "end": 226.38,
   "text": "مراقب خودش باشه. و الا خدا شاهده برای خودم دارم میگم به کسی بر نخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.38,
   "end": 229.9,
   "text": "خودم نگرانم، ناراحتم برای خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.9,
   "end": 237.14,
   "text": "وقتی بررسی کردم خیلی صادقانه گفتم دیروز، پریروز که یکی از بچه‌ها اومد گفت بالاخره ما به شما اعتماد کنیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.14,
   "end": 244.18,
   "text": "داره می‌خنده اینجا به ما. چون من صادقانه گفتم وقتی بررسی کردم یه رد پاهایی تو خودمم پیدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.18,
   "end": 249.26,
   "text": "آدم باید صادق باشه. فکر نکنیم دیگه یک تافته جدا بافته و تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.26,
   "end": 253.0,
   "text": "این حرفا نیست. آقا همینطوری عظام میگه دست و پا شکسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 253.0,
   "end": 255.9,
   "text": "تا دیدن صداشو ضبط می‌کنن چه چه می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.9,
   "end": 259.04,
   "text": "خودمو میگم. مدعی می‌کنه در و داغون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.04,
   "end": 262.88,
   "text": "تا دیدن داره ضبط میشه، شد جمعیت زیاده، تا دید یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.88,
   "end": 266.84,
   "text": "مدیرکل، یه آدم محترم و یه آدم چی اومده نشسته چه چه می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.84,
   "end": 269.2,
   "text": "آقا اینا همش نشانه نفاقه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.2,
   "end": 271.36,
   "text": "تا-تعارف که با هم نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.36,
   "end": 275.42,
   "text": "حالا این حدیث رو توجه کنید ببینید چقدر این حدیث طولانیه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.42,
   "end": 280.58,
   "text": "همه حدیثو بخوایم بحث کنیم راجع بهش ده تا، ده تا منبر نه این جلسات کوتاه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.58,
   "end": 286.48,
   "text": "حالا اولشو ببینید امام سجاد سلام الله علیه می‌فرمود “به درستی که منافق نهی می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.48,
   "end": 289.8,
   "text": "و نهی نمی‌پذیرد”.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.8,
   "end": 293.36,
   "text": "همش اینو اونو نهی می‌کنه، امر می‌کنه، نهی می‌کنه، امر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.36,
   "end": 297.34,
   "text": "بعد دنبالش می‌فرمود و امر می‌کند به آنچه خود انجام نمی‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.34,
   "end": 301.18,
   "text": "نهی می‌کنه، امر می‌کنه، نهی می‌کنه، نهی نمی‌پذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.18,
   "end": 303.28,
   "text": "اص-- همش داره اینو اونو نصیحت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.28,
   "end": 307.18,
   "text": "این خطرش مخصوصا مال ما تریبون به دستا، آخوندها و مدیرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.18,
   "end": 310.34,
   "text": "مدیرا هم همیشه مشغول امر و نهین دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.34,
   "end": 313.8,
   "text": "آخوندها، تریبون به دستا، خود ماها اینطورییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.8,
   "end": 318.3,
   "text": "بعد نهی هم نمی‌پذیره. اصلا عادت کرده همش نگاهش بالا به پایین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.3,
   "end": 320.4,
   "text": "بالا منبر بشینه پایینشو نگاه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.4,
   "end": 324.22,
   "text": "نمی‌تونه برعکس بشه. نمی‌شینه پای منبر اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.22,
   "end": 326.74,
   "text": "عادت کرده آقا پشت میز باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.74,
   "end": 330.24,
   "text": "قلم دست بگیره، آیین‌نامه بنویسه، امر و نهی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.24,
   "end": 333.98,
   "text": "چرا دیر اومدی؟ چرا زود اومدی؟ چرا-- ولی خودش اصلا نمی‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.98,
   "end": 337.28,
   "text": "من خیلی کم دیدم کسی که مدیرکل باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.28,
   "end": 341.7,
   "text": "مدیر چیزی بعد یهو مثلا یه روز بره نیرو عادی بشه، سختش نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.7,
   "end": 346.94,
   "text": "اصلا نمی‌تونه. لذا از این مدیری-مدیریت پا میشه میره یه مدیریت بالاتر یا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.94,
   "end": 349.36,
   "text": "بالاخره ما-- اصلا نمی‌تونه غیرمدیر وایسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.36,
   "end": 355.8,
   "text": "این یعنی چی؟ مگه تو ذات وجود تو ثبت شده مدیریت یا آخوندی یا منبر رفتن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.8,
   "end": 361.11,
   "text": "جلودار بودن. اون که مولامون امیرالمؤمنین بود تو خونه نشست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.11,
   "end": 364.29,
   "text": "من نمی‌دونم چرا بعضی اون امثال من مریضن، دلن مریضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.29,
   "end": 366.25,
   "text": "همش عادت کردن به امر و نهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.25,
   "end": 368.57,
   "text": "بعد امر و نهی هم نگیرن. سختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.57,
   "end": 371.63,
   "text": "عه منو نصیحت کردی به من گفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.63,
   "end": 375.89,
   "text": "همین جا بچه‌های متسدی تون به من می‌گفتن حاجی نمی‌دونی ما چی می‌کشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.89,
   "end": 378.41,
   "text": "طرف اومده براتون میگیم بهش کارت ورود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.41,
   "end": 382.29,
   "text": "خودروتو نشون بده. دستش رو کشیده بیرون و کشیده بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.29,
   "end": 385.43,
   "text": "می‌دونی من کیم؟ می‌دونم پدرتو در میارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.43,
   "end": 388.81,
   "text": "آخه تو کی هستی مگه؟ چی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 388.81,
   "end": 391.09,
   "text": "چی شده مثلا انقدر واسه خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.09,
   "end": 397.21,
   "text": "جایگاه درست کردی؟ بعضی ما گرفتار نفاق-- حالا سراغ دیگران نریم، خودمون رو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 397.21,
   "end": 401.31,
   "text": "میگه امر می‌کنه اون چیزی رو که عمل نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.31,
   "end": 404.33,
   "text": "\"لَمَ تَقُولُونَ مَا لاَ تَفْعَلُونَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.33,
   "end": 408.33,
   "text": "یادم یه روز علامه حسن زاده خدا حسشون کنه برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 408.33,
   "end": 412.95,
   "text": "ش-شفای وجودشون که خیلی حالشون بده صلوات بفرستین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 412.95,
   "end": 416.47,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.47,
   "end": 419.21,
   "text": "اللهم صل على محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 419.21,
   "end": 422.05,
   "text": "فرجهم. ایشون شروع کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 422.05,
   "end": 427.11,
   "text": "وعظ و خطابه. خب درس بحث خطابه با درس و بحث فرق می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.11,
   "end": 429.67,
   "text": "اومد وعظ و خطابه گریه‌ش گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.67,
   "end": 432.91,
   "text": "گفت من شرمنده نمی‌تونم حرف بزنم برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 432.91,
   "end": 438.61,
   "text": "گفت می‌دونی یاد یه حدیثی افتادم که خدا به حضرت عیسی فرمود عیسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.61,
   "end": 442.79,
   "text": "شرم کن از اینکه به دیگران چیزی رو بگی که خودت عمل نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.79,
   "end": 444.49,
   "text": "بعد گریه‌ش گرفت. گفت من چی بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 444.49,
   "end": 446.63,
   "text": "بعد همه ملت گریه‌شون گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 446.63,
   "end": 452.05,
   "text": "اونا که نشسته بودن. آقا یه همچین کسی می‌تونه استاد اخلاق باشه، می‌تونه امر و نهی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.05,
   "end": 454.39,
   "text": "ببین چقدر مراقب و مواظب خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.39,
   "end": 459.97,
   "text": "خداوکیلی اون پیغمبر با اون عظمتش نمی‌تونست اون زنه اومد گفت به پسرم بگو خرما نخوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 459.97,
   "end": 463.07,
   "text": "خیلی خرما می‌خوره، همون موقع بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 463.07,
   "end": 466.23,
   "text": "نمی‌تونست همون موقع بگه. فرمود برو فردا بیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 466.23,
   "end": 468.01,
   "text": "چرا آخه دیروز نگفتی یا رسول الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 468.01,
   "end": 470.45,
   "text": "فرمود اون روز من خودم خرما خورده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 470.45,
   "end": 475.43,
   "text": "الله اکبر از این دین. این میگه امر-- نهی می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.43,
   "end": 477.47,
   "text": "نهی نمی‌پذیره، امر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.47,
   "end": 481.13,
   "text": "حضرت امام با اون عظمتش بهش گفتن آقا خیلیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 481.13,
   "end": 484.01,
   "text": "اصن مخالف شما ان. اصن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 484.01,
   "end": 486.51,
   "text": "قبول ندارن شما رو، نظام تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 486.51,
   "end": 489.09,
   "text": "خیلی عجیبه به خدا از این بزرگان این جملات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.09,
   "end": 491.67,
   "text": "ما وایمیستیم میگیم پوستشو بکنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 491.67,
   "end": 496.73,
   "text": "من جانشین امام عصر، هرکی با من مخالفه با خدا مخالفه، با امام عصر مخالفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 496.73,
   "end": 499.79,
   "text": "می‌فرمود خیلی راحت می‌فرمود مخالف منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 499.79,
   "end": 502.71,
   "text": "من، من، من سید روح الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 502.71,
   "end": 506.71,
   "text": "مخالف نظام، مخالف اسلام که نیست که، با من مخالفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 506.71,
   "end": 509.11,
   "text": "الله اکبر از این روحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 509.11,
   "end": 511.29,
   "text": "به علامه طباطبایی می‌گفتن این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 511.29,
   "end": 514.65,
   "text": "گران سنگ تفسیر المیزان نوشتی، یه سری نقدت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 514.65,
   "end": 518.43,
   "text": "فرم-- یه آهی کشید فرمود البته هرکس نظری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 518.43,
   "end": 521.07,
   "text": "حالا خدا نکنه کسی منو نقد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 521.07,
   "end": 523.89,
   "text": "خدا نکنه کسی به من مشکلی وارد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 523.89,
   "end": 527.05,
   "text": "من نمی‌دونم چه گرفتاری نفسانیه من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 527.05,
   "end": 529.37,
   "text": "این نفاق داره پدر ما رو درمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 529.37,
   "end": 532.79,
   "text": "مراقب باشیم. من خودم رو دارم میگم به شما بر نخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 532.79,
   "end": 535.77,
   "text": "خیلی باید مراقب باشیم. خیلی، خیلی، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 535.77,
   "end": 538.39,
   "text": "این‌ها رو بررسی کنیم. این تازه اول حدیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 538.39,
   "end": 540.73,
   "text": "شاید ده پونزده بند این حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 540.73,
   "end": 544.05,
   "text": "که نشانه‌های نفاق در درون رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 544.05,
   "end": 545.93,
   "text": "یادم افتاد اینم بگم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 545.93,
   "end": 553.25,
   "text": "خدا رحمت کنه ملا محسن فیض کاشانی و علامه قزوینی رو با هم بحث طلبگی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 553.25,
   "end": 555.55,
   "text": "علامه سر یه قصه‌ای حالا مفصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 555.55,
   "end": 560.23,
   "text": "علامه قزوینی اونجا مستولی شد به بحث و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 560.23,
   "end": 561.87,
   "text": "قبول نکرد که اشتباه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 561.87,
   "end": 564.53,
   "text": "گفت نه حرف من درسته و بحث علمی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 564.53,
   "end": 568.43,
   "text": "جا-- اونجا گاهی اوقات تو بحث علمی عمامه هم به سمت هم پرتاب می‌کنن علما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 568.43,
   "end": 570.89,
   "text": "من تو جلساتشون خصوصی بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 570.89,
   "end": 575.27,
   "text": "انقدر بحث داغ میشه اینطوریه نشون میده دیگه بابا اوج چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 575.27,
   "end": 577.75,
   "text": "اعتقادش به اون حرفه. عمامه رو پرت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 577.75,
   "end": 580.57,
   "text": "حالا نه نه جایی بگیدا. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 580.57,
   "end": 584.03,
   "text": "آره حالا یه روزی هم ما به شما پرتاب می‌کنیم واسه نفع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 584.03,
   "end": 587.57,
   "text": "بعدش البته تو خودشونا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 587.57,
   "end": 590.55,
   "text": "بعضا دیده شده. حالا ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 590.55,
   "end": 592.43,
   "text": "مستولی شد تو بحث رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 592.43,
   "end": 594.29,
   "text": "بعدا متوجه شد که اشتباه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 594.29,
   "end": 595.99,
   "text": "ایشون قزوین می‌نشست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 595.99,
   "end": 598.19,
   "text": "ملا محسن فیض کا-- کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 598.19,
   "end": 600.65,
   "text": "ملا محسن فیض کاشانی کجا می‌نشست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 600.65,
   "end": 603.69,
   "text": "کاشان. چقدر راهه از قزوین تا کاشان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 603.69,
   "end": 609.03,
   "text": "کوبید این پیرمرد ق-- مل-ملا علامه قزوینی پیرمرد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 609.03,
   "end": 610.91,
   "text": "پیرمرد اونم اون زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 610.91,
   "end": 613.99,
   "text": "نه ماشینی، نه هیچی. کوبید خودشو رسوند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 613.99,
   "end": 617.79,
   "text": "کاشان. گفتن علامه قزوینی اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 617.79,
   "end": 622.97,
   "text": "آقای مح-- ملا محسن فیض کاشانی رحمت الله علیه خودشو رسوند دم در.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 622.97,
   "end": 627.09,
   "text": "به حالت تواضع، جانم به قربان شما این همه رو تشریف آوردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 627.09,
   "end": 630.17,
   "text": "گفت نه تو نمیام. هرچی اصرار کرد گفت من تو نمیام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 630.17,
   "end": 633.67,
   "text": "فقط اومدم یه جمله بگم من اشتباه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 633.67,
   "end": 638.81,
   "text": "اون چیزی که من گفتم، حضرت علمی بحث کردی، من رو حرف خودم وایسادم، من اشتباه می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 638.81,
   "end": 642.93,
   "text": "شما درست می‌گفتی. فقط اومدم همینو اقرار کنم و برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 642.93,
   "end": 645.45,
   "text": "الله اکبر. تو هم نرفت. یه چایی هم نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 645.45,
   "end": 651.29,
   "text": "برگشت. خب اینا می‌تونن زمامدار دین بشن که پرچم اسلام الان اینطوری بر فراش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 651.29,
   "end": 654.13,
   "text": "بر فراز قله‌های رفیع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 654.13,
   "end": 656.69,
   "text": "عظمت باشه. یکی ساعتشو نگاه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 656.69,
   "end": 658.91,
   "text": "یعنی تموم کن دیگه حاجی بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 658.91,
   "end": 660.55,
   "text": "انشاالله عاقبتمون به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 660.55,
   "end": 663.47,
   "text": "به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 663.47,
   "end": 666.65,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 666.65,
   "end": 668.13,
   "text": "محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}