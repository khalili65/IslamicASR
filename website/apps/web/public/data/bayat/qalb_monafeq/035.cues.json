 "chapters": [
  {
   "index": 0,
   "title": "## حومهٔ شهر و تابعیت وطن",
   "start": 0.58,
   "end": 159.62
  },
  {
   "index": 1,
   "title": "## منافقون همان فاسقون",
   "start": 159.62,
   "end": 237.18
  },
  {
   "index": 2,
   "title": "## پس از جنگ؛ سردی و هشدار",
   "start": 237.18,
   "end": 483.38
  },
  {
   "index": 3,
   "title": "## یتیمان و کَندن از دلبستگی",
   "start": 483.38,
   "end": 695.32
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.58,
   "end": 5.66,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.66,
   "end": 11.0,
   "text": "عزیزان یکی از همسایه‌های عمو حسین مرادی سخت مریض‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.0,
   "end": 18.94,
   "text": "خواهش کردن که براشون حمد شفا بخونیم به نیت شفای همه مریض‌ها، این عزیزمون، دل مریض من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.94,
   "end": 22.96,
   "text": "زحمت بکشید حمد شفا رو بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.96,
   "end": 26.7,
   "text": "تسبیحاتتون انشاالله قرائت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.7,
   "end": 28.86,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.86,
   "end": 31.82,
   "text": "و به نستعین. السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.82,
   "end": 34.52,
   "text": "یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.52,
   "end": 38.96,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.96,
   "end": 44.4,
   "text": "یه استفتای دیگه‌ای که پیرامون وطن شده پرسیدن از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.4,
   "end": 46.32,
   "text": "اگر چنانچه ما حومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.32,
   "end": 52.78,
   "text": "شهر متمرکز بشیم، مثلا مدتی داخل شهر بودیم شهر رو وطن کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.78,
   "end": 58.26,
   "text": "بعد حالا بعدا مثلا هفت سالگی ما رو بردن یا هفت سال تو وطن بودیم بعد رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.26,
   "end": 63.14,
   "text": "حومه شهرمون، حومه شهرمون مدتی طولانی حدود مثلا ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.14,
   "end": 66.66,
   "text": "سال موندیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.66,
   "end": 70.46,
   "text": "قبلا عرض کردیم رهبری فرمودن هفت تا هشت سال دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.46,
   "end": 72.5,
   "text": "ده سال حومه شهر موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.5,
   "end": 75.3,
   "text": "حالا اینجا تکلیف ما چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.3,
   "end": 80.0,
   "text": "آیا حومه شهر جزء شهر حساب میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.0,
   "end": 83.3,
   "text": "که اگر کسی صرفا حومه شهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.3,
   "end": 91.12,
   "text": "مدت مدیدی موند قصد تبtten کرد یا عرفا طبق صحبت‌هایی که روزهای پیش گفتیم دیگه عرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.12,
   "end": 93.66,
   "text": "دیگه اونو بچه اونجا حساب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.66,
   "end": 96.52,
   "text": "این حومه شهر جزو شهره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.52,
   "end": 100.38,
   "text": "حومه شهر تهران الان جزو شهر تهرانه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.38,
   "end": 102.84,
   "text": "که اگر کسی اونجا زیاد موند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.84,
   "end": 106.9,
   "text": "بگن این بچه تهرانه دیگه تهران بشه وطنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.9,
   "end": 109.42,
   "text": "آقا فرمودن که اگر چنانچه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.42,
   "end": 113.8,
   "text": "توابع و حومه، اون حومه هر شهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.8,
   "end": 118.2,
   "text": "مثل مثلا باغات و مزارع و کشت‌زارها و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.2,
   "end": 122.72,
   "text": "این‌ها جزو توابع شهر حساب میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.72,
   "end": 129.36,
   "text": "به تبع شهره. یعنی اونجا هم بری میگن اینم جزو این شهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.36,
   "end": 135.26,
   "text": "در این صورت شما همین شهر مثلا همین تهران هم وطنتون حساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.26,
   "end": 138.7,
   "text": "اما نه، اگر جدای از هم می‌دونن اونجا رو یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.7,
   "end": 143.0,
   "text": "شهر و شهرک و یک جای جدای از این شهر می‌دونن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.0,
   "end": 146.4,
   "text": "دیگه این شهر که اونجا حومه اونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.4,
   "end": 149.48,
   "text": "وطن تو حساب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.48,
   "end": 153.96,
   "text": "چون این استثنا بعضا من دیدم تو پرسش‌ها هم می‌پرسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.96,
   "end": 157.84,
   "text": "اینا ظرافت‌ها و دقت‌های تو فقهه دیگه باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.84,
   "end": 161.22,
   "text": "خیلی مراقب باشیم. آیه شصت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.22,
   "end": 164.62,
   "text": "هفت سوره توبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.62,
   "end": 170.76,
   "text": "جالبه که بدونید انتهای آیه می‌فرماید ان المنافقین هم الفاسقون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.76,
   "end": 173.28,
   "text": "منافق رو فاسق معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.28,
   "end": 178.08,
   "text": "البته می‌دونید این فس-- این فاسق العمل صرفا نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.08,
   "end": 180.8,
   "text": "چون ما یه حدیث هم داریم مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.8,
   "end": 185.14,
   "text": "از جهت اعتقادی فاسق نیست و نمی‌تونه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.14,
   "end": 186.72,
   "text": "اما از جهت عملی چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.72,
   "end": 191.44,
   "text": "چون احتمال داره فسق از منا-- از مؤمن سر بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.44,
   "end": 195.1,
   "text": "ولی خب زود توبه می‌کنه. اینجا که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.1,
   "end": 198.72,
   "text": "ان المنافقین هم الفاسقون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.72,
   "end": 203.78,
   "text": "این منظور فسق اعتقادی‌ست، فسق درونی‌ست، فسق قلبی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.78,
   "end": 206.74,
   "text": "یعنی قلبش فاسق شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.74,
   "end": 211.0,
   "text": "فاسد شده، خراب شده، آلوده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.0,
   "end": 216.62,
   "text": "که حالا این رو شما بیاید بذارید این آیه‌ای که منافقون رو همون مناف-- همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.62,
   "end": 222.52,
   "text": "فاسقون معرفی می‌کنه بیایید بگذارید کنار آیه بیست و دو همین سوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.52,
   "end": 225.36,
   "text": "این آیه آخرش اینطوری تموم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.36,
   "end": 228.32,
   "text": "والله لا یهد القوم الفاسقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.32,
   "end": 231.54,
   "text": "پیداست پیرامون فاسقین داشته حرف می‌زده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.54,
   "end": 237.18,
   "text": "حالا چون بعدا فرموده فاسقون همون منافقونن یا منافقون همون فاسقونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.18,
   "end": 240.06,
   "text": "پس این چیزی که تو این آیه داره میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.06,
   "end": 243.5,
   "text": "شرح حال اوناییه که دچار نفاق قلبی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.5,
   "end": 246.84,
   "text": "ببینیم چیه این. یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.84,
   "end": 255.1,
   "text": "میشه گفت مهم‌ترین آیاتیه که امروزه به درد بچه حزب‌اللهی‌ها و مذهبی‌ها و انقلابی‌ها می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.1,
   "end": 258.96,
   "text": "چون خیلی از ماها بعد از متاسفانه جنگ و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.96,
   "end": 263.86,
   "text": "داغی جنگ سر خوردیم سر، سر زندگی روزمره‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.86,
   "end": 266.5,
   "text": "می‌فرماید قل ان کان آباؤکم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.5,
   "end": 269.26,
   "text": "آباؤکم و أبناءکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.26,
   "end": 272.5,
   "text": "بهشون بگو که پیغمبر به این مردم بگو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.5,
   "end": 275.1,
   "text": "مبادا کار به جایی برسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.1,
   "end": 278.64,
   "text": "شماها آباؤکم پدر هاتون رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.64,
   "end": 282.56,
   "text": "أبناءکم فرزندانتون رو و إخوانکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.56,
   "end": 285.8,
   "text": "برادرانتون رو و أزواجکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.8,
   "end": 288.64,
   "text": "همسرانتون رو و عشیرتکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.64,
   "end": 293.88,
   "text": "فامیل و قوم و خویشتون رو و أموال اقترفتمو ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.88,
   "end": 296.98,
   "text": "اون اموالی که جمع کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.98,
   "end": 300.1,
   "text": "أموال اقترفتمو ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 300.1,
   "end": 304.82,
   "text": "و تجارتخشعون کسادها اون کار و کسب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.82,
   "end": 309.72,
   "text": "تجارتی که از کساد بودنش می‌ترسید، تخشعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.72,
   "end": 312.3,
   "text": "می‌ترسید کسادها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.3,
   "end": 314.62,
   "text": "و مساکن تربع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.62,
   "end": 323.98,
   "text": "تربعونها. اه اگر حتی اون خونه‌هایی که بهشون راضی شدید، تو اون خونه‌های خوبی که زندگی می‌کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.98,
   "end": 326.8,
   "text": "فکر می‌کنم هشت تا شد حالا اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.8,
   "end": 331.4,
   "text": "اشتباه نشمرده باشم. میگه اگر به جایی برسید خیلی حواستون جمع باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.4,
   "end": 333.66,
   "text": "که هر کدوم از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.66,
   "end": 337.44,
   "text": "چیزهایی که ما برای شما شمردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.44,
   "end": 339.28,
   "text": "حالا موضوعات هشتگانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.28,
   "end": 342.64,
   "text": "أحب إليكم من الله و رسوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.64,
   "end": 345.02,
   "text": "و جهاد فی سبيله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.02,
   "end": 350.62,
   "text": "أحب إليكم پیش شما مهم‌تر بشه، محبوب‌تر بشه از سه چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.62,
   "end": 353.34,
   "text": "من الله و رسوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.34,
   "end": 358.86,
   "text": "و جهاد فی سبيله. از خدا و پیغمبرش و جهاد در راه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.86,
   "end": 361.64,
   "text": "اونا چی بشن؟ محبوب‌تر بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.64,
   "end": 366.46,
   "text": "پیش تو عزیزتر بشن فتربصوا حتى يأتی الله بأمره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.46,
   "end": 371.28,
   "text": "چنین کسانی باید مراق-- منتظر باشن که امر خدا واقع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.28,
   "end": 376.62,
   "text": "یعنی همون عذاب. بعد می فرماید والله لا يهدي القوم الفاسقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 376.62,
   "end": 378.66,
   "text": "بحث فاسقین رو اینجا خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 378.66,
   "end": 381.36,
   "text": "این چنین بیان می کنه. پس نتیجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 381.36,
   "end": 385.98,
   "text": "اگر کسی به گونه ای بشه حدیث نفس، حدیث نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 385.98,
   "end": 390.88,
   "text": "اگر کسی به گونه ای بشه که کارش، کسبش، خونه‌ش، زندگیش، پولاش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.88,
   "end": 394.78,
   "text": "مالش، اموالش، قوم و خویشش، زنش، بچه‌ش، برادراش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.78,
   "end": 400.94,
   "text": "اینا پیش، پیش خودش محبوب‌تر بشن از خدا و پیغمبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.94,
   "end": 404.9,
   "text": "جهاد در راه خدا. چنین کسی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 404.9,
   "end": 407.56,
   "text": "سر خورده، قلبش به سمت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.56,
   "end": 409.52,
   "text": "نفاق و دو رویi افت-- بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.52,
   "end": 411.54,
   "text": "چنین کسی هم قرآن میگه فاسقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.54,
   "end": 415.4,
   "text": "عجب! چقدرها وقت جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.4,
   "end": 417.9,
   "text": "خدا ما سراغ داشتیم با همه بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 417.9,
   "end": 420.36,
   "text": "مسجدی‌ها ما سراغ داشتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.36,
   "end": 426.58,
   "text": "رفتن با مثلا تو مسجد ما تو بسیج ما آدمی بود که با امام جماعت بستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 426.58,
   "end": 433.44,
   "text": "چون یه رسته بالایی داشت که سر زمان جنگ‌ها سربازیش نیفته تو جبهه، مناطق مرزی نیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 433.44,
   "end": 437.3,
   "text": "بیفته توی شهرای داخل و که راحت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.3,
   "end": 439.72,
   "text": "بسیجی هم بود، مسجدی هم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 439.72,
   "end": 442.64,
   "text": "بگه مدافعین حرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.64,
   "end": 446.0,
   "text": "ما چرا، چرا رهبر فرمودن این‌ها دو تا گل زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.0,
   "end": 454.32,
   "text": "اینا دو تا اجر دارن. این‌ها وقتی رفتن سراغ این چیز اصن کسی توجه به این مسائل، ما همه گرم زندگیمون بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 454.32,
   "end": 460.72,
   "text": "رک. و تا چند وقت شهدایی که از اینا میاوردن گمنام دفنشون می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.72,
   "end": 464.06,
   "text": "اجازه نمی‌دادن کسی بفهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.06,
   "end": 470.12,
   "text": "اینا اوج مظلومیت و فداکاریشون بود و چقدرم تهمت خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.12,
   "end": 476.42,
   "text": "البته این به قول، به شهادت تاریخ خوبه بدونید سومین باری بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 476.42,
   "end": 482.14,
   "text": "وهابیت البته به جلو داری وهابیت حرم‌های اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 482.14,
   "end": 488.0,
   "text": "مورد هجمه واقع شد که کلاً با یک شعار این چنینی بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.0,
   "end": 490.94,
   "text": "دو بارش قبلاً اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.94,
   "end": 497.04,
   "text": "همیشه هم جالبه که بدونید وهابیت جلو بودن، سلفی‌ها جلو بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 497.04,
   "end": 499.1,
   "text": "اصلاً شیعه‌کشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.1,
   "end": 501.82,
   "text": "بلافاصله بعد از رحلت پیغمبر شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 501.82,
   "end": 508.62,
   "text": "مال الان نیست که. زیاد، زیاد بن ابی میگن عبیدالله بن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 508.62,
   "end": 515.3,
   "text": "زیاد، ابن زیاد. او-- خود باباش یعنی زیاد، زیاد بن ابی چرا بهش میگن زیاد بن ابی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 515.3,
   "end": 517.92,
   "text": "میگن زیاد پسر باباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 517.92,
   "end": 523.16,
   "text": "چون معلوم نبود باباش کیه. معاویه میگفت پسر منه عمرو عاص میگفت پسر منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.16,
   "end": 525.58,
   "text": "روش مدعی بودن دوازده تا مرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 525.58,
   "end": 529.72,
   "text": "انقدر پست بود و حروم زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 529.72,
   "end": 534.32,
   "text": "این زیاد بن ابی به دستور معاویه بیست هزار شیعه امیرالمؤمنین رو کشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.32,
   "end": 539.2,
   "text": "پوست کند، سر کند. حجاج و یوسف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 539.2,
   "end": 542.0,
   "text": "چجوری لای جرثقیل دیوار می‌گذاشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 542.0,
   "end": 545.5,
   "text": "تو لای درخت می‌ذاشت ارّه ارّه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 545.5,
   "end": 549.1,
   "text": "همین کارایی که داعشیا می‌کردن. بصر بن ارتات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 549.1,
   "end": 551.92,
   "text": "اومد حدود سی هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 551.92,
   "end": 554.12,
   "text": "شیعه امیرالمؤمنین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 554.12,
   "end": 557.88,
   "text": "قتل عام کرد. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.88,
   "end": 566.16,
   "text": "، تو تاریخ ثبت شده. دفعه اول نبود اما این دفعه ببینید نظام ولایی ما، انقلاب ما پیروز شده، نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 566.16,
   "end": 569.68,
   "text": "شکل گرفته، جنگم تموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 569.68,
   "end": 573.64,
   "text": "حالا یه جوونی با داشتن این همه algha و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.64,
   "end": 576.06,
   "text": "به هر حال ما هم داریم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 576.06,
   "end": 578.22,
   "text": "گرفتاری‌های زندگی پاشه بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 578.22,
   "end": 581.54,
   "text": "مثل شهید حججی‌ها اونطوری جون بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 581.54,
   "end": 586.92,
   "text": "بعدم بالاخره این‌ها هم کار داشتن، تلاش داشتن، دلبستگی‌ها داشتن، زن و بچه داشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 586.92,
   "end": 590.2,
   "text": "عاشق‌تر از من و تو هم به زن و بچه‌شون بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 590.2,
   "end": 594.3,
   "text": "اینو باور کنید. چرا می‌کنه میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 594.3,
   "end": 598.36,
   "text": "چرا و م-ما می‌مونیم؟ این چه اتفاقی افتاده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 598.36,
   "end": 601.0,
   "text": "این چه بصیرتیه؟ من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 601.0,
   "end": 604.12,
   "text": "رفته بودیم حالا اذیتتون نکنم تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 604.12,
   "end": 607.94,
   "text": "هر-- صرفاً ما یه شاخه نباته میگیم تبرکاً تلنگری باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.94,
   "end": 610.16,
   "text": "رفته بودیم قاطی یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 610.16,
   "end": 613.94,
   "text": "سری دخترهای یتیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 613.94,
   "end": 615.52,
   "text": "یه حالا هدیه‌ای بهشون بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 615.52,
   "end": 618.12,
   "text": "دختر کوچولوی من هفت هشت ساله هم باهام بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.12,
   "end": 621.9,
   "text": "فاطمه ما با ما بود. وقتی اومدیم بیرون گفت بابا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 621.9,
   "end": 625.17,
   "text": "دخترا دور منو گرفته بودن، دخترای یتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 625.17,
   "end": 627.12,
   "text": "می‌گفتن تو پدر مادر داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 627.12,
   "end": 633.22,
   "text": "گفتم آره. با یه حالی گفتن آره خوش به حالت ما آرزومونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 633.22,
   "end": 638.0,
   "text": "کاش پدر مادر داشتیم. کاش پدر داشتیم ما رو بغل می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 638.0,
   "end": 642.66,
   "text": "این دختر بچه به دختر ما چند تا این دخترا دور دختر ما رو گرفته بودن گفته بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 642.66,
   "end": 645.8,
   "text": "دختر من تأثر شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 645.8,
   "end": 648.34,
   "text": "حالا اینا شما، شما کنید فا-- اونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 648.34,
   "end": 650.28,
   "text": "همینه که رفتن مدافع حرم شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 650.28,
   "end": 653.28,
   "text": "چقدرهاشون دختر بچه دارن، پسر بچه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 653.28,
   "end": 655.26,
   "text": "فکر میکنید اینا دلبسته نبودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 655.26,
   "end": 658.14,
   "text": "اما کندن، کندن واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 658.14,
   "end": 661.3,
   "text": "از کی-- از تجارتشون کندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 661.3,
   "end": 666.0,
   "text": "بعضیاشون حتی از جهت تجاری و مالی خیلی هم وضعشون خوب بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.0,
   "end": 669.6,
   "text": "حتی من بعضی تو زندگی‌نامه بعضیاشون دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 669.6,
   "end": 673.8,
   "text": "ماشینای مدل بالا اصلاً مشکل مالی نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 673.8,
   "end": 676.58,
   "text": "ولی چی میشه اینطوری میکنن میرن و ما جا میمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 676.58,
   "end": 680.42,
   "text": "خیلی باید مراقب دلمون باشیم که سر نخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 680.42,
   "end": 685.28,
   "text": "خدایی نکرده حبیب دلمون نشه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 685.28,
   "end": 687.86,
   "text": "مسائل هشت گانه که قرآن گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 687.86,
   "end": 692.8,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 692.8,
   "end": 695.32,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}