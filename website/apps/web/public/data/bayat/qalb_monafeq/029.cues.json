 },
 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 0.36,
   "end": 21.2
  },
  {
   "index": 1,
   "title": "## شیطان پیش‌نمازِ نفاق",
   "start": 21.2,
   "end": 41.36
  },
  {
   "index": 2,
   "title": "## ربّی بما اغویتنی",
   "start": 41.36,
   "end": 447.4
  },
  {
   "index": 3,
   "title": "آیهٔ هفتاد و نهٔ نساء را باید هر روز زمزمه‌ کنیم تا به آن نفاق دچار نشویم:",
   "start": 447.4,
   "end": 489.72
  },
  {
   "index": 4,
   "title": "حضرت آدم ادب را رعایت کرد:",
   "start": 489.72,
   "end": 541.12
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.2,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.2,
   "end": 6.92,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.92,
   "end": 11.16,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.16,
   "end": 15.3,
   "text": "رهبر عزیزمون از استفتایی که پیرامون‌شون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.3,
   "end": 18.86,
   "text": "پیرامون موضوع وطن ازشون شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.86,
   "end": 22.18,
   "text": "به این عنوان که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.18,
   "end": 31.76,
   "text": "جایی رو ما بخواهیم وطن خودمون قرار بدیم و بمونیم اونجا زندگی کنیم، چه مدت باید حداقل بمونیم تا اونجا وطن بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.76,
   "end": 36.52,
   "text": "آقا این چنین جواب دادن که حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.52,
   "end": 39.62,
   "text": "هفت یا هشت سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.62,
   "end": 42.32,
   "text": "باید اونجا بمونی تا وطنت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.32,
   "end": 53.06,
   "text": "اینطور نیست که شما حالا یه جا قصد کردی یه سال، دو سال، پنج سال بمونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.06,
   "end": 58.24,
   "text": "جان؟ خب اومدی تهران. نه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.24,
   "end": 65.32,
   "text": "اگر شما قصد کنی حتما هفت یا هشت سال بمونی از همین الان دیگه وطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.32,
   "end": 68.56,
   "text": "نه اینکه هشت سال بگذره بعد وطنت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.56,
   "end": 74.72,
   "text": "قربونت برم. نیتت باید این باشه که هفت هشت سال بمونی حداقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.72,
   "end": 77.26,
   "text": "بله. اینو باید قصد باید بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.26,
   "end": 82.48,
   "text": "اگر کمتر باشه به فتوای رهبری اونجا شما وطنت حساب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.48,
   "end": 87.2,
   "text": "حالا یه بحثی تو وطن کاری و وطن دوم و اینا هست، اونو قاطی نکنید با اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.2,
   "end": 92.1,
   "text": "اونو بعدا میگیم. نکته دیگه‌ای رو پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.1,
   "end": 96.22,
   "text": "قلب منافق عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.22,
   "end": 100.32,
   "text": "که خیلی صریح و شفاف تو آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.32,
   "end": 103.88,
   "text": "دوازده سوره اعراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.88,
   "end": 107.96,
   "text": "موضوع نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.96,
   "end": 110.7,
   "text": "مطرح شده. در اون آیه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.7,
   "end": 117.5,
   "text": "خدا مستقیم رو می‌کنه به شیطان به عنوان جلودار منافقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.5,
   "end": 120.3,
   "text": "آقا جان چرا شما نمیگی جلودار کفار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.3,
   "end": 122.42,
   "text": "میگیم بابا این پیش نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.42,
   "end": 127.48,
   "text": "ا-- ملائکه بوده. مخصوصا نمیگم امام جماعت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.48,
   "end": 130.66,
   "text": "چون امام جماعت قصه‌ش فرق می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.66,
   "end": 133.48,
   "text": "که مشق ولایت می‌کنی، اون، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.48,
   "end": 138.48,
   "text": "پیش نماز اِاِاِ ملائکه مقربین هم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.48,
   "end": 143.68,
   "text": "یعنی چهره بسیار موجهی داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.68,
   "end": 147.12,
   "text": "در وادی حالا عبادت و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.12,
   "end": 153.38,
   "text": "خب این دیگه میشه منافق. درسته تو دلش کفر هم هست اما خطرش بسیار به مراتب بدتر از کفره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.38,
   "end": 156.64,
   "text": "کفر روئه اما منافق رو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.64,
   "end": 160.02,
   "text": "توی اینجا میگه خدا رو می‌کنه بهش می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.02,
   "end": 163.6,
   "text": "قال خدا می‌فرماید که ما منعک الا تسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.6,
   "end": 167.92,
   "text": "لامر توک. بگو ببینم چی باعث شد، چی تو رو منع کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.92,
   "end": 170.96,
   "text": "از اینکه ما تو رو امر کردیم به سجده اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.96,
   "end": 173.66,
   "text": "نکردی. قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.66,
   "end": 177.62,
   "text": "شیطان ملعون میگه انا خیر من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.62,
   "end": 180.36,
   "text": "من بهترم از آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.36,
   "end": 182.84,
   "text": "من از اون بهترم. خیر من. حالا ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.84,
   "end": 185.8,
   "text": "برداشت این رو، این نگاهش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.8,
   "end": 188.24,
   "text": "خلقنی من نار وخلقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.24,
   "end": 192.88,
   "text": "من طین. منو از آتش آفریدی، او رو از آت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.88,
   "end": 197.74,
   "text": "از خاک. این نگاه غلط او که به نوعی بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.74,
   "end": 203.14,
   "text": "میگن نوع-- حالا فکر جاهلیت، تعصب بیجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.14,
   "end": 206.16,
   "text": "امروز معروفه به چی؟ ژن برتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.16,
   "end": 209.52,
   "text": "اینایی که تعصب بیجا دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.52,
   "end": 213.1,
   "text": "آقا من آقازاده هستم، من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.1,
   "end": 222.76,
   "text": "مال فلان نسب و نسب هستم و انتصابم به فلانی میرسه و بابام مدیرکل و فلان و این حرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.76,
   "end": 228.06,
   "text": "در حقیقت زیربناش همون ابا و استکبر، استکباره، تکبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.06,
   "end": 231.66,
   "text": "اما به چه جهت این ات-- استکبار رخ داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.66,
   "end": 235.56,
   "text": "نگاه غلط و تعصب جاهلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.56,
   "end": 238.14,
   "text": "خودبرتربینی بیجهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.14,
   "end": 244.02,
   "text": "که بعضیا آقا طرف مثلا نتونسته یه جا مدیریت کنه ورش میدارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.02,
   "end": 246.78,
   "text": "عجیب‌تر از اون اینه که میذارن تو یک مدیریت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.78,
   "end": 252.92,
   "text": "سنگین‌تر از اون. بابا اینجا امتحانش رو پس داده، بلد نبوده، نتونسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.92,
   "end": 258.14,
   "text": ". وقتی میری زیرش بررسی می‌کنی می‌بینی دست‌های پنهان که نمی‌دونم این‌ها کی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.14,
   "end": 261.42,
   "text": "ما به هر کس هم گله‌ای می‌کنیم به، پیش مدیرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.42,
   "end": 264.72,
   "text": "میگن دست‌های پنهان یا بالا دستی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.72,
   "end": 267.48,
   "text": "حالا این دست‌های بالا دستی تا کجا میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.48,
   "end": 271.22,
   "text": "نمی‌دونیم که اون‌ها سفارش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.22,
   "end": 274.42,
   "text": "عزیز دلم خب خط و رد کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.42,
   "end": 276.98,
   "text": ". حالا اون سمت خیلی نریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.98,
   "end": 281.54,
   "text": "حضور مدیرها ریزش می‌کنه که کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.54,
   "end": 283.98,
   "text": ". یه نکته خیلی قابل تأمل اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.98,
   "end": 286.64,
   "text": "نمی‌دونم توجه کردید تو این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.64,
   "end": 289.8,
   "text": "مهاجه این ملعون با خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.8,
   "end": 292.42,
   "text": "تو آیه سی و نه هجر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.42,
   "end": 297.9,
   "text": "سوره هجر، اِاِاِ شروع آیه اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 297.9,
   "end": 301.64,
   "text": "وقتی به خدا میگه قال رب به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.64,
   "end": 304.2,
   "text": "خیلی جالبه. شیطان داره میگه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 304.2,
   "end": 308.96,
   "text": "قال رب به. این کسره‌ای که زیر به اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.96,
   "end": 311.48,
   "text": "معنای ربی میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.48,
   "end": 315.04,
   "text": "رب به اینجا یعنی اون ضمیر مستتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.04,
   "end": 318.72,
   "text": "مستتر متکلم وحده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.72,
   "end": 321.8,
   "text": "رب به یعنی ربی. گفت ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.8,
   "end": 326.34,
   "text": "داره به خدا میگه رب من، پروردگار من، این چیو می‌رسونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.34,
   "end": 329.42,
   "text": "این یعنی قائل به ربوبیت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.42,
   "end": 335.0,
   "text": "قائل به توحیده. اما ببینید به ما اغویتنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.0,
   "end": 337.96,
   "text": "استغفرالله. اینجا دیگه خراب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 337.96,
   "end": 339.76,
   "text": "من قبول دارم تو خالق منی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.76,
   "end": 342.38,
   "text": "تو ربوبیت، ربوبیت خدا رو قبولم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.38,
   "end": 346.0,
   "text": "تو رب منی اما تو منو اغوا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.0,
   "end": 349.32,
   "text": "این نگاه غلط. اگر ریز بشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.32,
   "end": 352.66,
   "text": "تو خیلی از کارهای ما این هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.66,
   "end": 355.26,
   "text": "کارهای بدمون رو به خدا نسبت میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.26,
   "end": 362.02,
   "text": "کارا-- اول که یهو چند میلیون پول میاد تو حسابمون حقوق می‌گیریم، اصلا توجه نداریم که خدا داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.02,
   "end": 366.3,
   "text": "میگیم زحمت بازو نه زحمت کشیدم صبح تا شب فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.3,
   "end": 371.26,
   "text": "به محض اینکه این پول تموم شد، همون ده روز، پنج روز اول ماه تموم شد و خرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.26,
   "end": 377.06,
   "text": "شد و رفت و نیمه دوم ماه به پیسی خوردی هی قرش رو سر خدا میزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.06,
   "end": 380.28,
   "text": "چرا نمیدی؟ چرا نمیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.28,
   "end": 385.04,
   "text": "این میشه عین همین. همیشه متأسفانه بدی‌هامون رو به خدا نسبت میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.04,
   "end": 387.02,
   "text": "وقتی قوی هستیم اصلاً کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.02,
   "end": 390.88,
   "text": "خدا، خدا نده که خودم ورزش کردم، خودم سالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.88,
   "end": 393.32,
   "text": "وقتی مریض میشیم خدایا تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.32,
   "end": 396.19,
   "text": "تو مریض. در حالی که میگه و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.19,
   "end": 404.4,
   "text": "و مرض تو اذا مرضت وقتی من مریض میشم فه و یشفینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.4,
   "end": 409.56,
   "text": "نی. وقتی من مریض میشم خدا شفا می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.56,
   "end": 412.44,
   "text": "کمال رو به خدا نسبت میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.44,
   "end": 417.84,
   "text": "نقص رو به خودش. این کار رو یعنی بی‌تقوایی و شیطان داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.84,
   "end": 422.72,
   "text": "این بی‌تقوایی اگرچه توحید داشته، اگرچه مثل من و تو سر به سجده داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.72,
   "end": 424.94,
   "text": "اما بی‌تقوایی داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 424.94,
   "end": 428.12,
   "text": "یعنی حالیش نبوده اینو. اون آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 428.12,
   "end": 433.24,
   "text": "هفتاد و نه سوره نساء رو باید هر روز ما زمزمه کنیم که بترسیم یه وقت به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.24,
   "end": 436.04,
   "text": "نفاق دچار نشیم. میگه ما اصابک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.04,
   "end": 440.32,
   "text": "من حسنة فمن الله هرچی خیر به تو میرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.32,
   "end": 443.32,
   "text": "از خداست. و ما اصابک من سیئة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.32,
   "end": 446.6,
   "text": "فمن نفسك. هرچی بدیه از خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.6,
   "end": 451.04,
   "text": "لذا مرحوم شیخ اکبر محی الدین عربی رحمة الله علیه می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.04,
   "end": 457.22,
   "text": "معنای عرشی تقوا اینه که هرچی کماله به خدا نسبت بدی، هرچی نقصه به خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.22,
   "end": 464.3,
   "text": "ببین شیطان اینجا میگه به ما رب به ما اقویتنی نقص رو به خدا اینجا نسبت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 464.3,
   "end": 467.98,
   "text": "بی‌تربیتی کرده. البته لا زینه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.98,
   "end": 472.3,
   "text": "لا زینه نلهم فی الارض و لاغینهم أجمعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.3,
   "end": 476.1,
   "text": "بی‌تربیتی می‌کنه. اما حضرت آدم بلافاصله چی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.1,
   "end": 478.5,
   "text": "این آیه رو هم دقت کنید و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 478.5,
   "end": 481.38,
   "text": "آیه بیست و سه اعراف حضرت آدم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 481.38,
   "end": 484.98,
   "text": "ادب رو رعایت می‌کنه. قال ربنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.98,
   "end": 487.64,
   "text": "ظلمنا انفسنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.64,
   "end": 491.48,
   "text": "ما، من و همسرم ظلم کردیم به ما، به خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.48,
   "end": 493.84,
   "text": "ببین نقص رو به خودش نسبت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 493.84,
   "end": 500.98,
   "text": "و ان لم تغفر لنا و ترهمنا اگه تو نبخشی و رحم نکنی، ببین کمال رو به خدا نسبت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 500.98,
   "end": 503.76,
   "text": "اگه تو نبخشی، تو رحم نکنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 503.76,
   "end": 505.58,
   "text": "لنکونن من الخاسرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 505.58,
   "end": 508.26,
   "text": "باز خسارت رو به خودش نسبت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.26,
   "end": 511.04,
   "text": "پس معنای عرشی تقوا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 511.04,
   "end": 514.24,
   "text": "هرچی کماله به خدا نسبت میدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.24,
   "end": 517.44,
   "text": "هرچی نقصه به خودت. اما شیطان بلعکس کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.44,
   "end": 521.26,
   "text": "این دروازه میشه گفت نفوذ شیطان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 521.26,
   "end": 525.76,
   "text": "نفوذ نفاق در وجود انسان از اینجاست که بلعکس بشه نگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 525.76,
   "end": 528.5,
   "text": "نقص رو استغفرالله به خدا نسبت بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 528.5,
   "end": 530.94,
   "text": "کمال رو به خودش. ان‌شاءالله عاقبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 530.94,
   "end": 535.08,
   "text": "هممون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 535.08,
   "end": 537.8,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 537.8,
   "end": 541.12,
   "text": "على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}