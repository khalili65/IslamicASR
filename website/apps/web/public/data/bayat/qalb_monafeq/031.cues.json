 },
 "chapters": [
  {
   "index": 0,
   "title": "## وطن کودک پیش از استقلال فکری",
   "start": 4.36,
   "end": 81.04
  },
  {
   "index": 1,
   "title": "## آدم؛ خلیفه در زمین نه فقط در بهشت",
   "start": 81.04,
   "end": 144.04
  },
  {
   "index": 2,
   "title": "امروز آیاتی دیگر همین را تأکید می‌کند.",
   "start": 144.04,
   "end": 575.87
  },
  {
   "index": 3,
   "title": "## ظهور ظاهر و بَلای سرائر",
   "start": 575.87,
   "end": 635.81
  },
  {
   "index": 4,
   "title": "## جمع فقه و اخلاق (بخش 5)",
   "start": 635.81,
   "end": 672.73
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.36,
   "end": 7.14,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.14,
   "end": 11.82,
   "text": "در خصوص احکام وطن حرف می‌زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.82,
   "end": 16.1,
   "text": "گاهی اوقات میشه که یه بچه‌ای یه جا به دنیا میاد حتی بعضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.1,
   "end": 24.06,
   "text": "به علت مریضی حالا یا مادر یا بچه مدتی اونجا می مونه اون بچه یا مادرش اینا تو اون زایشگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.06,
   "end": 26.52,
   "text": "تو اون شهر، دهات هر جا می مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.52,
   "end": 29.1,
   "text": "یه مدتی می مونه بعد میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.1,
   "end": 33.8,
   "text": "به وطن حالا برش می‌گردونن جایی که رشد و نمو می‌کنه یا وطن پدر مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.8,
   "end": 36.84,
   "text": "اینجا وطن بچه کجا حساب میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.84,
   "end": 38.96,
   "text": "وطن بچه اونجاییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.96,
   "end": 42.34,
   "text": "به دنیا اومد و حتی مدتی هم موند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.34,
   "end": 45.4,
   "text": "یا اونجایی که برش می‌گردونن، می‌برنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.4,
   "end": 48.62,
   "text": "و اونجا رشد و نمو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.62,
   "end": 54.8,
   "text": "ما دیروز حکمی رو گفتیم از سمت رهبر عزیزمون که این تو دل همون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.8,
   "end": 60.4,
   "text": "گفتیم بچه‌ای که هنوز به استقلال فکری نرسیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.4,
   "end": 63.6,
   "text": "وطنش وطن پدر و مادره حساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.6,
   "end": 69.8,
   "text": "پس اینجا اگر چنانچه اونجایی که بچه به دنیا اومده وطن پدر مادر هم هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.8,
   "end": 77.94,
   "text": "همونجا وطن بچه‌ست. اما اگر جای دیگه‌ای وطن پدر مادره و بچه بعدا منتقل میشه به اونجا، اونجا وطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.94,
   "end": 83.96,
   "text": "بچه حساب میشه. دیروز ما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.96,
   "end": 90.72,
   "text": "اینکه چرا حضرت آدم جد عزیز ما به دنیا اومدن آیاتی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.72,
   "end": 92.9,
   "text": "بهش دقت کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.9,
   "end": 95.92,
   "text": "شاید بشه گفت از مهم‌ترین آیات همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.92,
   "end": 99.8,
   "text": "آیه‌ای بود که \"قال رب کل الملائکه‌\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.8,
   "end": 102.7,
   "text": "خدا به ملائکه فرمود که \"اني جاعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.7,
   "end": 105.34,
   "text": "في الارض خليفة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.34,
   "end": 110.48,
   "text": "نفرمود \"اني جاعل في الجنة خليفة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.48,
   "end": 114.44,
   "text": "و نفرمود \"ولكم في الجنة مستقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.44,
   "end": 119.34,
   "text": "ومتاع الی يوم\" بلکه فرمود \"ولكم في الارض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.34,
   "end": 121.74,
   "text": "مستقر ومتاع الی يوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.74,
   "end": 125.52,
   "text": "جد عزیز ما حضرت آدم سلام الله عليه دریافت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.52,
   "end": 128.32,
   "text": "که خلافت در زمین واقع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.32,
   "end": 132.78,
   "text": "مستقر استقرار، قرار، آرامش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.78,
   "end": 141.78,
   "text": "و تمتع در زمین، در ارز واقع میشه لذا تشریف آوردن در زمین و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.78,
   "end": 146.68,
   "text": "امر اشفاقی یا ارشادی خدا که \"لا تقربوا هذه الشجرة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.68,
   "end": 148.84,
   "text": "به اون درخت نزدیک نشو رو عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.84,
   "end": 154.56,
   "text": "این امر مولوی نبوده، امر ارشادی از جهت دلسوزی خدا بوده که بار سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.56,
   "end": 157.64,
   "text": "اما حضرت آدم که قصد کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.64,
   "end": 165.18,
   "text": "خلیفه خدا رو زمین باشه برای اینکه خودش رو به رشد بکشونه و دیگران رو سوی-- سوار کشتی نجات بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.18,
   "end": 168.82,
   "text": "امروز دو سه تا دیگه آیه دیدم خیلی جالبه همین‌ها رو تاکید می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.82,
   "end": 172.6,
   "text": "آیه شصت و یک سوره هود رو با هم بخونیم \"هو الذي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.6,
   "end": 174.92,
   "text": "انشأکم من الارض\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.92,
   "end": 181.12,
   "text": "خدا اون کسیست که شما رو ایجاد کرد، ایجاد کرد \"من الارض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.12,
   "end": 184.86,
   "text": "دقت بفرمایید خدا شما رو از زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.86,
   "end": 187.32,
   "text": "از اینجا نه \"من الجنة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.32,
   "end": 190.9,
   "text": "اصلاً ایجاد ما در زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.9,
   "end": 194.04,
   "text": "و اون چهار عنصر آب و ه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.04,
   "end": 201.04,
   "text": "آب و خاک و هوا و حرارت که گفتیم که تو وجود در بدن و جسم و وجود داره تو این عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.04,
   "end": 205.26,
   "text": "بعد فرمود و بقیه آیه‌ست \"وستعمرکم فيها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 205.26,
   "end": 210.16,
   "text": "اصلاً شما باید برید تو زمین تا امارت ایجاد کنید، زمین رو تعمیر کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.16,
   "end": 213.24,
   "text": "آباد کنید زمین رو. اصلاً یه ماموریته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.24,
   "end": 216.86,
   "text": "اینطور نیست که بگیم آقا چرا حضرت آدم عذرخواهی خدا خطا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.86,
   "end": 220.3,
   "text": "ما مجبور میشیم بشیم بیاییم تو این زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.3,
   "end": 224.08,
   "text": "این اشتباهاتیه که متاسفانه حتی بعضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.08,
   "end": 228.76,
   "text": "بعضی از مفسرین ما مرتکب شدن، نگاه‌های اشتباه به ما دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.76,
   "end": 230.86,
   "text": "اینطور نیست که حالا هرچی که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.86,
   "end": 235.0,
   "text": "تفاسیر خدا خیر بده به بزرگان ما زحمت کشیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.0,
   "end": 239.24,
   "text": "جون کندن واقعا این‌ها رو گذاشتن همون بشه عین واقع که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.24,
   "end": 242.32,
   "text": "\"وما اوتیكم من العلم الا قلیلا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.32,
   "end": 246.12,
   "text": "یا م-- \"وما اوتیكم\" ما اصلاً به علم از جهت علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.12,
   "end": 248.9,
   "text": "چیزی به شما ندادیم \"الا قلیل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.9,
   "end": 253.76,
   "text": "این چیزی نیستش که ما گمان می‌کنیم همین که ما می‌دونیم همونه و لاغیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.76,
   "end": 256.44,
   "text": "یا آیه نود و هشت سوره انعام ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.44,
   "end": 260.38,
   "text": "\"هو الذي انشأكم من نفس واحدة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.38,
   "end": 268.0,
   "text": "خدا کسیست که شما را ایجاد کرده از یک نفس واحد که این بحث مبسوطی حکمای در مورد نفس واحد کردن کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.0,
   "end": 271.96,
   "text": "\"فمستقر\" ف پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.96,
   "end": 275.18,
   "text": "عده‌ای از شما قرار گرفتید در زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 275.18,
   "end": 279.42,
   "text": "و \"مستودع\" عده‌ای هم در رحم و در صلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.42,
   "end": 281.64,
   "text": "به ودیعت به امانت سپرده شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.64,
   "end": 284.42,
   "text": "مستقر میگه باز قرار شما در زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.42,
   "end": 286.84,
   "text": "اصلاً قرار بوده ما بیاییم اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.84,
   "end": 288.94,
   "text": "ما وقتی عبادت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.94,
   "end": 290.66,
   "text": "میگیم قربتا الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.66,
   "end": 293.46,
   "text": "نمیگیم قربتا الی الجنة که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.46,
   "end": 298.0,
   "text": "اگه قرار بود استقرار ما وعده ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.0,
   "end": 301.06,
   "text": "بهشت باشه خب تو بهشت بودیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.06,
   "end": 305.54,
   "text": "\"اسکن انت وزوجك الجنة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.54,
   "end": 312.3,
   "text": "تو بهشت ساکن بودیم. لکن قربتا الی الله می‌خواستیم بگیریم که اومدیم تو این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.3,
   "end": 321.96,
   "text": "برای عروج، برای اینکه بشیم \"وادخلي يا ايتها النفس المطمئنة ارجعي\" به سمت من برگرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 321.96,
   "end": 324.98,
   "text": "\"الى ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 324.98,
   "end": 329.54,
   "text": "راضية مرضية\" \"وادخلي عبادي وادخلي جنتي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.54,
   "end": 334.72,
   "text": "برای اینکه به بهشت ذات خدا برسیم اومدیم تو این دنیا و الا ما که تو بهشت بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.72,
   "end": 338.48,
   "text": "اونجا چی بود؟ \"کلوا منها حيث شئتم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.48,
   "end": 340.68,
   "text": "هرچی می‌خواید تو این بهشت آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 340.68,
   "end": 344.58,
   "text": "با همسرت بخورید. خب ما که دنبال بخور بخور نبودیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 344.58,
   "end": 349.0,
   "text": "دنبال سیب و گلابی و حوری و نعل و قصر نبودیم که و الا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 349.0,
   "end": 351.1,
   "text": "اومدیم اینجا قربتا الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.1,
   "end": 355.86,
   "text": "نه تازه الی الرحمن، الی الرحیم، الی الحکیم، الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.86,
   "end": 358.08,
   "text": "لفظ جلاله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 358.08,
   "end": 365.98,
   "text": "همه اسم‌ها درش. ما اومدیم که اسم خدا در اینجا پیاده بشه یا اسم خدا رو در وجود خودمون پیاده‌سازی کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.98,
   "end": 368.86,
   "text": "سوار بر کشتی خلیفت الله بشیم و بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.86,
   "end": 372.3,
   "text": "حالا این یه بحث بود که دیروز ناقص مونده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 372.3,
   "end": 374.56,
   "text": "ما بحثمون در خصوص قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.56,
   "end": 377.87,
   "text": "منافق بود گفتیم خب تکلیف این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.87,
   "end": 382.29,
   "text": "نفاق‌ها، این کفرها، این شرک‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.29,
   "end": 384.95,
   "text": "این‌ها چی میشه؟ این خونریزی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.95,
   "end": 390.99,
   "text": "این طغیان‌ها که ملائکه میگن بابا میخوای \"اتج العفی may یفسد فیها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 390.99,
   "end": 396.53,
   "text": "آیا کسایی رو میخوای بیاری که خونه‌ها رو بریزن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.53,
   "end": 400.81,
   "text": "خدا فرم-- گفتن که \"نحن مقدس لک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 400.81,
   "end": 404.51,
   "text": "یا \"نسبح بحمدک و نقدس لک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.51,
   "end": 406.29,
   "text": "ما مقدسین دیگه میخوای چه کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 406.29,
   "end": 410.09,
   "text": "خدا رحمت کنه علامه شهرانی لطیفانه میفرمایند که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.09,
   "end": 412.05,
   "text": "به ملائکه اینطور جواب داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.05,
   "end": 413.99,
   "text": "که ما مقدس نمیخوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 413.99,
   "end": 417.89,
   "text": "ما آدم میخوایم. آدم که بیاد تو این زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.89,
   "end": 423.17,
   "text": "اسماء منو پیاده کنه و بتونه شهوت داشته باشه، غضب داشته باشه، کنترل کنه خودشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.17,
   "end": 427.21,
   "text": "حالا تکلیف این نفاق‌ها، این‌ها چی میشه نسبت به ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 427.21,
   "end": 429.69,
   "text": "ببینید هرکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.69,
   "end": 433.69,
   "text": "نفاق به خرج بده، کفر به خرج بشه، به خرج بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.69,
   "end": 439.31,
   "text": "به ضرر خودشه. هیچ آسیبی از کفر و نفاق دیگران به ما نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.31,
   "end": 443.19,
   "text": "قابل توجه کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.19,
   "end": 446.47,
   "text": "گمان می‌کنند که حتما باید برن زیر چتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.47,
   "end": 451.15,
   "text": "دشمن یا منافقین یا نفوذی‌ها تا به جایی برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.15,
   "end": 453.37,
   "text": "دوستای آیه سریع من بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.37,
   "end": 458.83,
   "text": "من عمل آیه چهل و شش فصلت رو دقت کنید \"من عمل صالحا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.83,
   "end": 461.83,
   "text": "هرکس کار خیری بکنه \"فلنفسه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.83,
   "end": 464.83,
   "text": "به خودش کرده و \"من اساء فعلیها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.83,
   "end": 467.77,
   "text": "هرکس هم کار بد بکنه به علیه خودش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.77,
   "end": 470.05,
   "text": "آسیبی به کسی نمی‌رسه از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.05,
   "end": 476.55,
   "text": "از زشتی دیگران. مگر اینکه طرف خودش بخواد و الا نخواد تازه رشد می‌کنه \"و بشر الصابرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 476.55,
   "end": 479.37,
   "text": "ولنبلونکن بشیء من الخوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 479.37,
   "end": 483.63,
   "text": "والجوع ونقص من الاموال والانفس والثمرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 483.63,
   "end": 488.41,
   "text": "و بشر الصابرین\". تو همه‌ی این مص ibت‌ها که یکیش ترسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 488.41,
   "end": 491.75,
   "text": "نفوذی‌ها یه کاری کردن که مردم ترسیدن ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.75,
   "end": 495.15,
   "text": "تو امرار معاش‌شون، تو بحث سیاست‌شون، تو بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.15,
   "end": 499.47,
   "text": "اتصال‌شون به ترس افتادن \"من الخوف\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 499.47,
   "end": 503.61,
   "text": "میگه \"وبشر الصابرین\". اگه تو صبر کنی رشد می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 503.61,
   "end": 506.47,
   "text": "اون به خ-- علیه خودش اقدام کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 506.47,
   "end": 511.43,
   "text": "یا آیه هفت اسرا میفرماید \"ان احسنتم احسنتم لانفسکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 511.43,
   "end": 516.23,
   "text": "و ان اسأتم فلها\". هرکی هر کاری کنه به ضرر خودش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 516.23,
   "end": 520.67,
   "text": "یعنی نفاق، نفوذ لطمه به خود طرف میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 520.67,
   "end": 523.17,
   "text": "به تو نمی‌تونه آسیبی برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 523.17,
   "end": 528.37,
   "text": "اینطور که می‌بینی یکی مثل رهبر عزیزمون دور تا دورشو انصافا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 528.37,
   "end": 531.99,
   "text": "خیانتکارا پر کردن از داخل و خارج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 531.99,
   "end": 537.01,
   "text": "که حالا دیگه از خارج دیگه مگه رهبر عزیزمون چی داره که مثلا بخواهند اموالش رو بلکه کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 537.01,
   "end": 541.43,
   "text": "داخل هم به ریش استغفرالله ماها بخندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.43,
   "end": 544.59,
   "text": "توجه کردی؟ حالا فکر کنیم که رهبر مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.59,
   "end": 547.03,
   "text": "دیگه دستاشو باید بیاره بالا ضربه بخوره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.03,
   "end": 550.45,
   "text": "در صورتی که محکم و مقتدرانه وایساده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.45,
   "end": 552.69,
   "text": "اتفاقا داره سود می‌بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 552.69,
   "end": 555.21,
   "text": "از این نفاق این منافقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 555.21,
   "end": 563.03,
   "text": "اون داره رشدشو می‌کنه. به قول آیه بهجت اگر به استعمام به یکباره همچی رو دادن به ایشون، به رهبر عزیز ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 563.03,
   "end": 566.69,
   "text": "خرد خرد دارن میدن. هی دارن رشدش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 566.69,
   "end": 571.65,
   "text": "اینا رشده دیگه. اصلا شما ختم کلام اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.65,
   "end": 575.27,
   "text": "ما وقتی میریم اونور الان ببینید ظهور ظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.27,
   "end": 580.57,
   "text": "عالم این دنیا نشئه طبیعت، ظهور ظاهر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 580.57,
   "end": 586.11,
   "text": "ظاهر‌های ما ظهور بر اساس اسم ظاهر خدا ظاهر ما ظاهر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 586.11,
   "end": 589.69,
   "text": "ولی وقتی میریم اونور باطن‌ها ظهور می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 589.69,
   "end": 592.05,
   "text": "یعنی باطن ظاهر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 592.05,
   "end": 595.15,
   "text": "باطن به اسم ظاهر خدا در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.15,
   "end": 599.89,
   "text": "اونجا ملکات نفسانی هرکس که نفاق داره دو روئه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 599.89,
   "end": 603.49,
   "text": "نفوذی اومده اینور، اونور مثل روباهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.49,
   "end": 607.83,
   "text": "ملکات نفسانی که خلق کرده، ایجاد کرده در وجود خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.83,
   "end": 610.51,
   "text": "تو اینجا بچه مذهبی می‌بینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 610.51,
   "end": 614.41,
   "text": "هیئتی و مسجدی شاید ببینیش ولی اونور مثل روباهه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 614.41,
   "end": 624.11,
   "text": "مثل گرگه. حتی ملکات نفسانی که در وجودش در نفس ناطقه خودش ایجاد کرده اینجا بروز پیدا می‌کنه باطن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 624.11,
   "end": 627.49,
   "text": "\"یوم تبلى السرائر\" نمیگه سریره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 627.49,
   "end": 631.03,
   "text": "روزی که آشکار میشه باطن‌ها ما تو در توایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 631.03,
   "end": 635.81,
   "text": "قبلا این بحثش گذشت. باطن‌ها داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 635.81,
   "end": 637.85,
   "text": "سر و خفی و اخفا داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.85,
   "end": 641.61,
   "text": "این‌ها ملکاتی که در وجود خودمون ایجاد کردیم اونور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 641.61,
   "end": 647.13,
   "text": "میشه قیامت ما. اگر این ملکات معنوی‌اند بهشت محض و برین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.13,
   "end": 649.65,
   "text": "اگر خدایی نکرده ظلمانی‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 649.65,
   "end": 651.99,
   "text": "میشه جهنم، میشه دوزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.99,
   "end": 656.47,
   "text": "پس هرکس نفاق به خرج بده، کفر به خرج بده، شرک به خرج بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 656.47,
   "end": 659.73,
   "text": "گناه و معصیت کنه \"فعلیها\" به ضرر خودش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 659.73,
   "end": 662.19,
   "text": "تازه سبب رشد من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 662.19,
   "end": 664.35,
   "text": "میشه. انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 664.35,
   "end": 667.47,
   "text": "برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 667.47,
   "end": 670.07,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 670.07,
   "end": 672.73,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}