 },
 "chapters": [
  {
   "index": 0,
   "title": "## شروط قصر؛ مردد نشدن در راه",
   "start": 0.34,
   "end": 20.38
  },
  {
   "index": 1,
   "title": "## هرم فکری شهید مطهری؛ از منافق تا شهید",
   "start": 20.38,
   "end": 181.16
  },
  {
   "index": 2,
   "title": "## از معرفتِ آیه‌ای تا ایدئولوژی",
   "start": 181.16,
   "end": 516.6
  },
  {
   "index": 3,
   "title": "این‌که در خانواده چندشخصیتی می‌شود: آیهٔ چهارده بقره دربارهٔ منافقین:",
   "start": 516.6,
   "end": 740.28
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.02,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.02,
   "end": 7.5,
   "text": "والسلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.5,
   "end": 11.22,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.22,
   "end": 18.3,
   "text": "عرض کردیم که برای اینکه انسان مسافر باشه و نمازش قصر باشه شروط هشت گانه ای وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.3,
   "end": 22.82,
   "text": "یکیشو که گفتیم حتما باید مسافت شرعی طی بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.82,
   "end": 26.46,
   "text": "و از اول قصد داشته باشه مسافت شرعی رو بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.46,
   "end": 30.06,
   "text": "دو اینه که حد ترخص رو رد کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.06,
   "end": 33.44,
   "text": "سومیش اینه که از اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.44,
   "end": 40.9,
   "text": "عرض شود که قصد مسافت شرعی رو که میکنه بین راه مر-مردد هم حتی نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.9,
   "end": 47.76,
   "text": "نه اینکه قصدش مثلا بدل بشه یا برگرده کلا منقطع بشه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.76,
   "end": 53.32,
   "text": "پشیمون بشه از اینکه مسافت شرعی رو بره حتی مردد هم نشه مثل روزه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.32,
   "end": 59.5,
   "text": "یه کسی مردد بشه آقا من بالاخره این روزه رو بگیرم یا نگیرم، روزه مستحبی گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.5,
   "end": 62.44,
   "text": "این وقتی نیتش برگشت تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.44,
   "end": 68.44,
   "text": "همین که تو راه مردد شد من بقیه سفرم رو، بقیه مسافت شرعی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.44,
   "end": 70.94,
   "text": "تا آخر برم یا نه تمام میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.94,
   "end": 74.48,
   "text": "یعنی اینجا مشکل پیش میاد و مسافر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.48,
   "end": 81.46,
   "text": "خیلی این نکته مهمه. و چهارمین نکته هم اینه که حتی در بین راه قطع نشه این سفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.46,
   "end": 83.82,
   "text": "یعنی یه دفعه نرسه به وطنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.82,
   "end": 87.54,
   "text": "یه طوری دور نزنه بیاد یهو از وطنش دوباره برگرده بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.54,
   "end": 90.84,
   "text": "یا یک جایی که قصد ده روز میخواد بمونه از اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.84,
   "end": 95.72,
   "text": "به هر حال این سفر قطع نشه، چیزی قطعش نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.72,
   "end": 99.64,
   "text": "امروز به فضل الهی خیلی فکر می‌کردم حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.64,
   "end": 102.58,
   "text": "شاید یه هدیه‌ای باشه برای شما، نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.58,
   "end": 106.64,
   "text": "شایدم شما خیلی به مزاقتون خوش نیاد این نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.64,
   "end": 109.36,
   "text": "اما برای خود من خیلی جالب بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.36,
   "end": 113.88,
   "text": "البته خب ایام شهادت استاد کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.88,
   "end": 118.34,
   "text": "حضرت شهید مطهری هم هست، روحش شاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.34,
   "end": 122.16,
   "text": "و به همه معلم‌های عزیز ما این ایام رو تبریک می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.16,
   "end": 124.84,
   "text": "که واقعا گردن همه ما حق دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.84,
   "end": 128.54,
   "text": "هر کسی که به ما چیزی یاد داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.54,
   "end": 139.14,
   "text": "یه اگر کسی مجموعه آثار شهید مطهری رو ملاحظه فرموده باشه و اهل تفکر و دقت نظر باشه متوجه می‌شه هرم فکری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.14,
   "end": 142.48,
   "text": "شهید مطهری داده، این هرم خیلی حائز اهمیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.48,
   "end": 145.56,
   "text": "اگر کسی خوب آثارش رو نه یکی دو تا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.56,
   "end": 148.74,
   "text": "آثار رو دقت کرده باشه. من اینو خدمت شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.74,
   "end": 151.1,
   "text": "خب سؤال هست همیشه برای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.1,
   "end": 153.84,
   "text": "که چطور می‌شه یکی منافق می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.84,
   "end": 157.42,
   "text": "چطور حتی تو خونواده مذهبی هم هست، پدر مادر خوبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.42,
   "end": 162.82,
   "text": "پدرش آیت اللهه، یهو طرف مثلا خراب در میاد یا بالعکس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.82,
   "end": 166.36,
   "text": "اصلا چی می‌شه یه آدمی می‌شه شهید حججی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.36,
   "end": 169.54,
   "text": "چ-توی خونواده می‌بینید معمولی هم هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.54,
   "end": 176.6,
   "text": "نه مثلا عالم آنچنانیه پدرش که مثلا بگه مرجع تقلید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.6,
   "end": 179.68,
   "text": "چطور می‌شه آدم‌ها اینطوری می‌شن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.68,
   "end": 182.86,
   "text": "یا منافق می‌شن یا اهل ایمان مجاهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.86,
   "end": 184.64,
   "text": "و اونطوری می‌شن یا کافر و مشرک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.64,
   "end": 187.44,
   "text": "و بالاخره این‌ها هر کدوم یه ایدئولوژی‌ای دارن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.44,
   "end": 189.56,
   "text": "یه برنامه‌ای برای زندگیشون دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.56,
   "end": 193.82,
   "text": "مکاتب و مذاهب مختلف ایدئولوژی‌هایی رو ارائه دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.82,
   "end": 196.24,
   "text": "خب این نظام فکری رو دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.24,
   "end": 199.04,
   "text": "اینا به هم متصل‌اند و خیلی هم مهمه دقت بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.04,
   "end": 200.82,
   "text": "حتی خودمون رو می‌تونیم واکاوی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.82,
   "end": 204.96,
   "text": "چرا الان من اینطوریم؟ محکمم یا شلم هرچی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.96,
   "end": 207.28,
   "text": "شهید مطهری می‌فرماید که اون ایدئولوژی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.28,
   "end": 214.26,
   "text": "نوع سبک زندگی و برنامه‌ای که هر کسی برای زندگیش داره مشحون از جهان‌بینیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.26,
   "end": 216.84,
   "text": "نوع نگاهش به این جهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.84,
   "end": 219.0,
   "text": "در حقیقت باورهاش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.0,
   "end": 222.86,
   "text": "باورهاشه که ایدئولوژی‌شو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.86,
   "end": 225.64,
   "text": "حالا البته این در این نکته، این ریشه قرآنی داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.64,
   "end": 228.78,
   "text": "می‌دونید دیگه که همه جای قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.78,
   "end": 231.28,
   "text": "اصلاً باور مقدم شده بر عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.28,
   "end": 236.18,
   "text": "\"إلا الذين آمنوا آمنوا\" ایمان همون باورهاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.18,
   "end": 240.18,
   "text": "\"وعملوا الصالحات\". این دیگه کاملا برهنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.18,
   "end": 242.86,
   "text": "یا \"إن الذين آمنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 242.86,
   "end": 247.62,
   "text": "وهاجروا وجاهدوا في سبيل الله أولئك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.62,
   "end": 249.92,
   "text": "يرجون رحمت الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 249.92,
   "end": 257.66,
   "text": "میگه اون‌هایی می‌تونن به رحمت خدا که فکر می‌کنم حدود دویست و هفتاد و شش آیه در قرآن به رحمت خدا اشاره کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.66,
   "end": 262.68,
   "text": "میگه حتی این همه، همه چی رحمت خداست و این همه آیه درباره‌ش اومده اما کسایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.68,
   "end": 264.62,
   "text": "می‌تونن به رحمت خدا امیدوار باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.62,
   "end": 267.6,
   "text": "اول با چی شروع می‌شه؟ آمنوا بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.6,
   "end": 271.32,
   "text": "هاجروا وجاهدوا. ایمان خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.32,
   "end": 278.04,
   "text": "یا تو سوره بقره میگه \"الذین يؤمنون\" ببینید \"يؤمنون بالغيب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.04,
   "end": 283.04,
   "text": "بعد عملیات رو میگه که نماز می‌خونن، نمی‌دونم زکات می-- انفاق می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.04,
   "end": 285.16,
   "text": "ایمان خب این یه ریشه قرآنی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.16,
   "end": 287.2,
   "text": "اما خب ایمان از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.2,
   "end": 290.6,
   "text": "اینجا مهمه. ایمان، این باورها رو چی می‌سازه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.6,
   "end": 293.86,
   "text": "ما گفتیم ایدئولوژی مشحون از باورهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.86,
   "end": 301.34,
   "text": "باورها از کجا میان؟ شهید مطهری تو نظام فکری که میده میگه معرفت، شناخت، نوع شناختی که انسان پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 301.34,
   "end": 303.08,
   "text": "اون شناخت‌ها باورشو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 303.08,
   "end": 306.5,
   "text": "خب دوباره سؤال. این شناخت‌ها از کجا ایجاد می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.5,
   "end": 310.2,
   "text": "اینا از کجا میاد؟ این دیگه مهم‌ترین نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.2,
   "end": 314.4,
   "text": "شهید مطهری مع-معتقده به آیه شناحی یا آیه‌ای‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.4,
   "end": 317.1,
   "text": "شناخت و معرفت آیه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.1,
   "end": 321.04,
   "text": "آیه یعنی چی؟ یعنی نشانه. میگه از نشانه‌ها انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.04,
   "end": 327.12,
   "text": "معرفت کسب می‌کنه و معرفت بدل به باور می‌شه و باورش بدل به ایدئولوژی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 327.12,
   "end": 330.54,
   "text": "دقت کردین نظام فکری و آیه، نشانه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.54,
   "end": 332.2,
   "text": "توی این عالم همه چی نشانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 332.2,
   "end": 335.44,
   "text": "میگه \"فأنظر إلى آثار رحمت الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.44,
   "end": 338.12,
   "text": "آثار خدا، آثار رحمت خدا رو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 338.12,
   "end": 341.54,
   "text": "یا میگه نگاه کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 341.54,
   "end": 344.76,
   "text": "در آ-- در آیات الهی قر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.76,
   "end": 349.18,
   "text": "اون عالم رقائق که حقائق گفتیم عالم معقولات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 349.18,
   "end": 354.18,
   "text": "ملکوت و مجردات و عرض شود معقولات و ملائکه اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 354.18,
   "end": 356.8,
   "text": "رقائق همین عالم نشئه طبیعته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 356.8,
   "end": 359.52,
   "text": "ما معتقدیم همینم نام-- بی‌نهایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 359.52,
   "end": 363.38,
   "text": "همین عالم نشئه طبیعت. اینجا هم تبدیل شد به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 363.38,
   "end": 366.9,
   "text": "قبلاً عرض کردیم خوراک عقلی که ش-- حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 366.9,
   "end": 370.4,
   "text": "حسن زاده میگه بگیرید به سه تا کتاب تبدیل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.4,
   "end": 373.06,
   "text": "که \"وفی الأَرْضِ آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 373.06,
   "end": 375.9,
   "text": "للموقنین أفلا تبصرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 375.9,
   "end": 378.54,
   "text": "این تو زمین خدا می فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.54,
   "end": 381.74,
   "text": "ما سه تا کتاب گذاشتیم، کتاب آفاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 381.74,
   "end": 384.1,
   "text": "که قبلاً بحث شد، کتاب انفسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 384.1,
   "end": 389.6,
   "text": "اینا کتاب تکوینند. به جانت دقت کنی و کتاب تدوینی که قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 389.6,
   "end": 394.08,
   "text": "حالا اینا، اینا آیاتند. نشانه شناسی خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 394.08,
   "end": 399.22,
   "text": "نشانه-- نگاه کردن به این آیه ها و اثری که انسان از اینا می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 399.22,
   "end": 402.8,
   "text": "چی می‌خوام بگم؟ از اول بچگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 402.8,
   "end": 409.38,
   "text": "اولین آثاری که انسان اثری که از محیطش می‌گیره و آیه ها رو شناسایی می‌کنه، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 409.38,
   "end": 412.68,
   "text": "آیه ها بدل به معرفتش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 412.68,
   "end": 415.08,
   "text": "این نشانه ها، این آثار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 415.08,
   "end": 418.24,
   "text": "اثری که در او این آثار می گذارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 418.24,
   "end": 420.76,
   "text": "این‌ها منجر به چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 420.76,
   "end": 424.64,
   "text": "معرفتش و اون باور و اون ایدئولوژی رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 424.64,
   "end": 433.12,
   "text": "اون اولین آثار و اثرها توسط حواس پنج گانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.12,
   "end": 437.06,
   "text": "جلوه می‌کنه و گرفته می‌شه از محیط اطراف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 437.06,
   "end": 441.16,
   "text": "درست شد؟ یعنی بچه از حواس پنج گانه‌ش اثر می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 441.16,
   "end": 443.32,
   "text": "یعنی اولین چیزی که دید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 443.32,
   "end": 448.38,
   "text": "اولین چیزی که شنید، اولین چیزی که لمس کرد، اولین چیزی که خورد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 448.38,
   "end": 452.54,
   "text": "اولین چیزهایی که بو کرد. اینه که میگه تا بچه به دنیا اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 452.54,
   "end": 455.6,
   "text": "تو گوشش اذان بگو اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 455.6,
   "end": 461.02,
   "text": "میگه مراقب باش موسیقی تو گوشش نباشه، قرآن تو گوشش باشه، حکمت تو گوشش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 461.02,
   "end": 462.66,
   "text": "هر کسی مسش نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.66,
   "end": 465.46,
   "text": "پدر مادر وضو داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 465.46,
   "end": 471.1,
   "text": "آدم که بی‌نمازه، لاابالیه، مشروب خور، عرق خوره اصلاً نذارید این بچه رو بغل کنه حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 471.1,
   "end": 474.38,
   "text": "از اولین مسی که این بچه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 474.38,
   "end": 478.32,
   "text": "این اصلاً این تمثلات همه الی الأبدشو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 478.32,
   "end": 480.18,
   "text": "توجه داشته باشید دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.18,
   "end": 483.36,
   "text": "این بحث یه مقدار بحث حکمی و فلسفی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 483.36,
   "end": 486.8,
   "text": "اما هم قرآنی‌ست الحمدالله، هم اخلاقی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 486.8,
   "end": 490.58,
   "text": "هم نظام فکری رو درست می‌کنه هم خیلی سؤالات ما رو جواب میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 490.58,
   "end": 493.96,
   "text": "اینکه توی خانواده می‌بینی طرف چند شخصیتی می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 493.96,
   "end": 497.44,
   "text": "یکی از آیات قرآن پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 497.44,
   "end": 504.72,
   "text": "همین منافقین بحث ما بحث قلب نفاق آیه چهارده سوره بقره \"وإذا لقوا الذين آمنوا قالوا آمنا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.72,
   "end": 507.08,
   "text": "وقتی میرن پیش اهل ایمان میگن ما با شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 507.08,
   "end": 510.74,
   "text": "\"وإذا خلوا إلى شياطينهم قالوا إنا معكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 510.74,
   "end": 513.84,
   "text": "با خلوت شیاطین که خلوت می‌کنند میگن ما با شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.84,
   "end": 516.6,
   "text": "اینا در حقیقت یه نوع مضزبزبند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 516.6,
   "end": 523.48,
   "text": "آیه صد و چهل و سه نساء می فرماید \"مضزبزبين بين ذلك لا ألهائلا و لا الهائلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 523.48,
   "end": 525.44,
   "text": "نه اینن، نه اونن. مضزبزبند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 525.44,
   "end": 528.22,
   "text": "چرا؟ چون یک نظام، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 528.22,
   "end": 531.36,
   "text": "اثر‌هایی که از محیط از اول گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 531.36,
   "end": 534.16,
   "text": "این‌ها تناقض داشته با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 534.16,
   "end": 536.3,
   "text": "پدر خوب بوده، مادر بد بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 536.3,
   "end": 538.36,
   "text": "عمه خوب بوده، دایی بد بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 538.36,
   "end": 545.06,
   "text": "اصلاً اون اثر‌هایی که گرفتن، حرف‌هایی که شنیدن، مس‌هایی که کردن، لقمه‌های شیری که خورده بچه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 545.06,
   "end": 546.94,
   "text": "این‌ها خیلی مهمن. خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 546.94,
   "end": 550.54,
   "text": "اون رحمی که این بچه توش بزرگ شده، صلبی که ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 550.54,
   "end": 553.18,
   "text": "خارج شده، اینا یک یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 553.18,
   "end": 555.28,
   "text": "در حقیقت اینطوری می‌خوام بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 555.28,
   "end": 562.16,
   "text": "اون تأثیری که حواس پنج گانه بچه از چهار ماهگی تو رحم مادر که روح دمیده می‌شه و این حواس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 562.16,
   "end": 564.14,
   "text": "شروع می‌شن، هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 564.14,
   "end": 568.06,
   "text": "کدوم از البته گوش و چشم مهم‌ترینان دیگه می‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 568.06,
   "end": 571.04,
   "text": "هرچی اینا حس می‌گیرن از آثار و از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 571.04,
   "end": 573.26,
   "text": "از این آیه ها از اطرافشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 573.26,
   "end": 576.2,
   "text": "این خمیرمایه همه عمرشونو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 576.2,
   "end": 582.06,
   "text": "حتی تمثلاتشونو، عالم خیال و مثالشونو می‌سازه که این بچه به چه چیزایی فکر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 582.06,
   "end": 583.9,
   "text": "خیال این بچه به چی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 583.9,
   "end": 587.18,
   "text": "عالم مثالش تو چه چیزی س-سیر کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 587.18,
   "end": 590.04,
   "text": "به دنیا فقط فکر کنه یا به آخرت فکر کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 590.04,
   "end": 595.56,
   "text": "اینا همش مهمه. این ریشه‌یابی‌ها رو برید تو قرآن، تو روایات، تو منظومه فکری شهید مطهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 595.56,
   "end": 601.62,
   "text": "رد پاش دیده می‌شه. پس اینطور نیست که اگر حالا یکی اومد یکی رو زد کشت، مثل این طلبه شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 601.62,
   "end": 603.74,
   "text": "روحش شاد طلبه حمیدانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 603.74,
   "end": 606.44,
   "text": "که این ملعون زد کشت، شهیدش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 606.44,
   "end": 610.14,
   "text": "بله با یه مثلاً پیام توئیتری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 610.14,
   "end": 613.88,
   "text": "یه خبیثه ملعونه‌ای یه دفعه اینطوری تحریک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 613.88,
   "end": 616.8,
   "text": "اما این نیست این صرفاً همین باشه علتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 616.8,
   "end": 619.04,
   "text": "این ریشه داره از بچگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 619.04,
   "end": 623.48,
   "text": "دچار نفاق و دورویی و دودستگی و مضزبذب بودن شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 623.48,
   "end": 626.48,
   "text": "توجه کردید؟ اینا رو باید در اطراف، در پیرامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 626.48,
   "end": 629.48,
   "text": "یه مثال بزنم و این مثال روشن‌گره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 629.48,
   "end": 632.84,
   "text": "ببینید خدا رحمت کنه حضرت آیت الله العظمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 632.84,
   "end": 637.0,
   "text": "محمدعلی اراکی رحمة الله علیه مرجع تقلید روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 637.0,
   "end": 640.54,
   "text": "این بزرگوار اشاره کرد توی جلسه‌ای به یه آیه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 640.54,
   "end": 648.96,
   "text": "که آره این آیه‌ای که تو قرآن حضرت یوسف میگه وقتی که اومد با اون جلال و عظمت و زیبایی و جمال حضرت یوسف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 648.96,
   "end": 651.82,
   "text": "اومد زنان چیکار کردن زنان مصری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 651.82,
   "end": 653.9,
   "text": "د-- این دستاشونو به جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 653.9,
   "end": 657.12,
   "text": "تورنج‌ها بریدن. دستشونو بریدن و نفهمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 657.12,
   "end": 660.78,
   "text": "قرآن میگه نفهمیدن. انقدر محو جمال یوسف شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 660.78,
   "end": 665.74,
   "text": "اگر یه کسی که تمثلاتش خرابه، عالم خیالش فاسده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 665.74,
   "end": 669.0,
   "text": "تا این آیه رو ببینه چی میگه به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 669.0,
   "end": 671.02,
   "text": "میگه که عجب پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 671.02,
   "end": 677.68,
   "text": "خدا تخفیف میده دیگه. اونا که دستشونو بریدن ما هم یهو تو خیابون چشممون رفت طرف یه آدم خوشگلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 677.68,
   "end": 681.84,
   "text": "پس ایرادی نداره دیگه. ببینید تفکرات و تمثلات آدمو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 681.84,
   "end": 688.68,
   "text": "چجوری برداشت می‌کنه. اما حضرت آیت الله اراکی بالا منبر زد تو سر خودش همینطور گریه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 688.68,
   "end": 691.88,
   "text": "گفت وای بر من محمدعلی!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 691.88,
   "end": 697.74,
   "text": "زنان مصری یوسف رو که یک جلوه‌ای از جمال خداست رو دیدن دست بریدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 697.74,
   "end": 700.16,
   "text": "تو چطور در نماز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 700.16,
   "end": 705.44,
   "text": "در نماز عین خیالت نیست که داری با مظهر کل جمال و جلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 705.44,
   "end": 708.16,
   "text": "همه عالم هستی، اون حقیقت الحقائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 708.16,
   "end": 711.14,
   "text": "گفت‌وگو می‌کنی و عین خیالت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 711.14,
   "end": 713.68,
   "text": "اونا دست بریدن، تو عین خیالت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 713.68,
   "end": 716.56,
   "text": "اینا همش بر می‌گرده به اون آیه ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 716.56,
   "end": 719.76,
   "text": "به اون آثاری که اولین بار بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 719.76,
   "end": 722.36,
   "text": "از این عالم محیط پیرامون خودش می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 722.36,
   "end": 726.22,
   "text": "این بحث خیلی مبسute. من خیلی فشرده ام پی تریش کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 726.22,
   "end": 729.2,
   "text": "یه ذره هم طول کشید. ببخشید ان‌شاءالله عاقبت بخیر باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 729.2,
   "end": 732.26,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 732.26,
   "end": 740.28,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}