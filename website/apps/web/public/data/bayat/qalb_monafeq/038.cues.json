   "start": 11.52,
   "end": 31.98
  },
  {
   "index": 1,
   "title": "## تسلیم امام و جملهٔ زیارت اربعین",
   "start": 31.98,
   "end": 178.8
  },
  {
   "index": 2,
   "title": "## ادب حاجت و ترازوی قیامت",
   "start": 178.8,
   "end": 257.76
  },
  {
   "index": 3,
   "title": "## علی میزان اعمال و انتخاب‌های روزانه",
   "start": 257.76,
   "end": 331.26
  },
  {
   "index": 4,
   "title": "## زراره و بدگویی ظاهری برای حفظ جان",
   "start": 331.26,
   "end": 530.08
  },
  {
   "index": 5,
   "title": "## ترمه در دوراهی کوفه و کربلا",
   "start": 530.08,
   "end": 647.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.86,
   "end": 4.4,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.4,
   "end": 9.52,
   "text": "السلام علیک یا داعی الله و ربانی ایاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.52,
   "end": 11.52,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.52,
   "end": 15.16,
   "text": "سؤال اینه که اگر کسی از وطنش اعراض کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.16,
   "end": 22.6,
   "text": "بعد دو مرتبه تصمیم گرفت به وطنش برگرده و اونجا رو وطن خودش قرار بده از جایی که اعراض کرده می‌تونه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.6,
   "end": 26.04,
   "text": "رهبر عزیز فرمودن که صرف این که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.04,
   "end": 29.04,
   "text": "بگی می‌خوام اینجا دوباره وطنم باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.04,
   "end": 31.98,
   "text": "نمیشه که. باید قصد کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.98,
   "end": 38.84,
   "text": "که اونجا مدت طولانی حداقل به مدت هفت یا هشت سال بمونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.84,
   "end": 43.16,
   "text": "در این صورت که این قصد رو داشته باشی که حتما بمونی اشکالی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.16,
   "end": 47.12,
   "text": "ما قبلاً بحثمون رسیده بود به اینجا که هر مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.12,
   "end": 51.82,
   "text": "تسلیم امام نباشی هم، همون مقدار به همون نسبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.82,
   "end": 55.18,
   "text": "سر خورده قلب ما میره سمت نفاق و باید مراقب باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.18,
   "end": 58.34,
   "text": "حالا سؤال اساسی اینه که ما چه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.34,
   "end": 62.12,
   "text": "که عرض شود تسلیم امام باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.12,
   "end": 67.0,
   "text": "چگونه میشه که انسان همیشه تسلیم محض امام باقی بمونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.0,
   "end": 69.16,
   "text": "اگر یادتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.16,
   "end": 74.48,
   "text": "در زیارت اربعین یه جمله کلیدی رو تشریح کردیم قبلاً ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.48,
   "end": 77.22,
   "text": "که می‌فرمود و قلبی لقلبک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.22,
   "end": 84.8,
   "text": "سل. اینجا ما اقرار می‌کنیم محضر امام معصوم که قلب ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.8,
   "end": 87.04,
   "text": "تسلیم محض قلب شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.04,
   "end": 89.9,
   "text": "قلبی لقلبک سل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.9,
   "end": 94.16,
   "text": "چرا قلب؟ قلب حوزه تعلقات انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.16,
   "end": 98.58,
   "text": "عرض شد که اونچه که انسان علقه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.58,
   "end": 101.42,
   "text": "این میل قلبشه، از قلبش بلند میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.42,
   "end": 107.04,
   "text": "در حقیقت تعلقات ماست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.04,
   "end": 109.22,
   "text": "حوزه قلب ما رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.22,
   "end": 111.78,
   "text": "کارکرد قلب ما رو تشکیل میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.78,
   "end": 114.18,
   "text": "در حقیقت میشه اینطوری گفت که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.18,
   "end": 118.14,
   "text": "مادامی که تعلقات قلبی‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.14,
   "end": 121.42,
   "text": "در حقیقت متعلقات قلبمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.42,
   "end": 125.08,
   "text": "اونچه که قلب ما بهش متعلقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.08,
   "end": 127.82,
   "text": "مطابق با مت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 127.82,
   "end": 130.64,
   "text": "علقه‌ها و علاقه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 130.64,
   "end": 133.3,
   "text": "و عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 133.3,
   "end": 138.32,
   "text": "اونچه که امام عصر بهش تعلق داره باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.32,
   "end": 140.98,
   "text": "ما در این صورت تسلیم محض امام هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 140.98,
   "end": 147.94,
   "text": "اما به هر میزان تعلقات ما از تعلقات امام کنده بشه و جدا بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 147.94,
   "end": 150.72,
   "text": "همون مقدار ما دیگه تسلیم نخواهیم روش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.72,
   "end": 155.8,
   "text": "نخواهیم بود و در گردش روزگار بالاخره یه روزی از امام جدا میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.8,
   "end": 158.72,
   "text": "این که می‌فرماین باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.72,
   "end": 167.9,
   "text": "سعی کنیم تعلقات امام رو بشناسیم، یکی از نکات معرفتیه به جهت حساسیت این قصه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.9,
   "end": 172.54,
   "text": "ما در تاریخ هم زیاد می‌بینیم کسایی که از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.54,
   "end": 178.8,
   "text": "و ائمه جدا شدن معمولاً کسانی هستن که علقه‌هاشون با امام به تعارض رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.8,
   "end": 184.94,
   "text": "متاسفانه ما گاهی اوقات که محضر امام می‌رویم یک لیستی از حاجتمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.94,
   "end": 189.74,
   "text": "می‌نویسیم و محضر امام میریم که اینو می‌خوایم، اونو می‌خوایم، اینو می‌خوایم، اینو می‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.74,
   "end": 193.28,
   "text": "کی به شما گفته انقدر از امام چیز بخواید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.28,
   "end": 197.98,
   "text": "شما باید بنشینی ادب کنی و بگی امام شما از من چی می‌خوای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.98,
   "end": 200.48,
   "text": "حالا بحث آداب دعا یه چیز دیگه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.48,
   "end": 202.24,
   "text": "بحث توقعات ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.24,
   "end": 204.98,
   "text": "تو که جاتو با امام عوض کردی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.98,
   "end": 212.02,
   "text": "استغفرالله امام رو کردی کلفتی خودت که آقا من اینو می‌خوام به من بده، اونو می‌خوام به من بده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.02,
   "end": 217.18,
   "text": "باید مراقب باشیم که در حوزه تعلقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.18,
   "end": 223.42,
   "text": "قلب ما به بی‌راهه نره. ببینید شما وقتی یک جنسی رو وزن می‌کنید، ظاهراً دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.42,
   "end": 225.98,
   "text": "وزن‌کشی می‌کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.98,
   "end": 231.86,
   "text": "در حقیقت جاذ-- میزان جاذبه زمین رو، اون جنس رو یا اون شی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.86,
   "end": 234.18,
   "text": "با ترازو بررسی می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.18,
   "end": 238.32,
   "text": "در واقع دارید میزان تعلق اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.32,
   "end": 242.8,
   "text": "شی رو به زمین که همون جاذبه‌ست می‌سنجید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.8,
   "end": 245.64,
   "text": "میزان تعلق هر شی به زمین وزنشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.64,
   "end": 248.3,
   "text": "قیامت هم میگن که یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.3,
   "end": 253.24,
   "text": "آیه قرآن می‌فرماد \"والوزنو یومئذ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.24,
   "end": 255.86,
   "text": "الحق\". امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.86,
   "end": 259.18,
   "text": "ترازو حقه. حالا حق چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.18,
   "end": 261.9,
   "text": "علیٌ میزان الأعمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.9,
   "end": 264.88,
   "text": "علیٌ حبه ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.88,
   "end": 268.36,
   "text": "علیٌ مع الحق والحق مع علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.36,
   "end": 273.64,
   "text": "در حقیقت قیامت تعلقات ما رو می‌سنجن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.64,
   "end": 276.3,
   "text": "با تعل-- نسبت به تعلقات امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.3,
   "end": 281.0,
   "text": "هر مقدار که این تعلق جدا شده، همون مقدار ما سر خوردیم به سمت بی‌راهه و نفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.0,
   "end": 284.16,
   "text": "از امام جدا شده قلبمون. ببینید شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.16,
   "end": 287.3,
   "text": "در انتخابات روزگارتون به شما الان میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.3,
   "end": 289.92,
   "text": "تشریف بیارید یه مثلاً مدیریتی رو قبول کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.92,
   "end": 294.32,
   "text": "یا سن و شغل به شما پیشنهاد میدن یا میگن نه اصلاً شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.32,
   "end": 296.94,
   "text": "زحمت کشیدید، مدیر بودید، خسته نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.94,
   "end": 299.58,
   "text": "زحمت کشیدید، خدمت کردید، خدا هم خیرتون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.58,
   "end": 302.18,
   "text": "حالا بفرمایین مسئولیت عادی داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.18,
   "end": 311.38,
   "text": "یه کارمند جز باشید. یا هر انتخابی تو زندگی، انتخاب همسر حتی ساده‌ترین وجه بگیم انتخاب اسم برای فرزند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.38,
   "end": 315.2,
   "text": "این‌ها اولین کاری که ما در این حوزه ها انجام میدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.2,
   "end": 320.58,
   "text": "میریم سراغ امیال درونیمون، میل قلبی‌مون، تعلقات باطنی‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.58,
   "end": 323.72,
   "text": "هر مقدار که این تعلقات باطنی با امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.72,
   "end": 328.68,
   "text": "تعارض داشته باشه، همون مقدار ما رو از امام جدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.68,
   "end": 330.48,
   "text": "یه مثال من به شما بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.48,
   "end": 335.54,
   "text": "این مثال در رجال کشی این روایت وارد شده که خیلی قابل تحمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.54,
   "end": 339.62,
   "text": "که میگن امام صادق صلوات الله عليه سه کس از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.62,
   "end": 344.56,
   "text": "یاران خودش رو جزء از سابقون، از سابقون معرفی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.56,
   "end": 347.98,
   "text": "خب می‌دونید ائمه سر و اسرار رو به هر کسی نمی‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.98,
   "end": 351.78,
   "text": "لکن متاسفانه این‌هایی که سر رو می‌گرفتن بعضیاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.78,
   "end": 354.66,
   "text": "فهم و شعورشون انقدر نبود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.66,
   "end": 358.52,
   "text": "این سر رو نگه دارن یا از کسی اگر شنیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.52,
   "end": 365.9,
   "text": "انتقالش ندن. ما گاهی اوقات میگیم آقا خدمت امیرالمؤمنین نجف مشرف می‌شید از دنیا چیزی نخواید، حکمت بخواید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.9,
   "end": 368.64,
   "text": "میریم می‌شینیم میگیم آقا سینه ما رو پر کن از حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.64,
   "end": 377.56,
   "text": "خب آقا جان تا حالا چند تا از سری که مولا به تو داده، ائمه به تو دادن تو صیفهتی نکردی و حفظ کردی به کسی ندادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.56,
   "end": 382.7,
   "text": "حالا زراره چون می‌دونید ائمه هم توی تنگناهایی خفقان‌هایی بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.7,
   "end": 384.66,
   "text": "نمی‌تونستن بگن ما اصلاً امامیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.66,
   "end": 387.44,
   "text": "قبلاً عرض شده امام رضا صلوات الله علیه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.44,
   "end": 389.94,
   "text": "ظرفیت رو تونست ایجاد کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.94,
   "end": 393.5,
   "text": "به همه عالم اعلام کنه ما امام هستیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.5,
   "end": 400.88,
   "text": "اون حدیث ادل جامعه کبیره که پیرامون امام هست توسط امام رضا فرمودن در اصول کافی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.88,
   "end": 404.82,
   "text": "اصلاً جامعه کبیره ببینید بعضی از شؤون امامت رو برمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.82,
   "end": 408.2,
   "text": "در کدوم امام این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 408.2,
   "end": 411.76,
   "text": "زیارت جامعه وارد شده؟ امام هادی صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 411.76,
   "end": 415.6,
   "text": "ظرفیت نبود. امام صادق وقتی زراره رو تعریفش رو کرد، حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.6,
   "end": 419.86,
   "text": "قابل توجه کسانی که میگن شما ولایت فقیه رو از خودتون ساختین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.86,
   "end": 424.24,
   "text": "امام صادق صلوات الله علیه می‌فرماید هرچی زراره بگه حرف منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 424.24,
   "end": 426.32,
   "text": "این یعنی زراره نایب منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 426.32,
   "end": 433.96,
   "text": "چیز عجیبی نیست. حالا زراره به محض اینکه این خبر در خصوص جایگاه زراره رسید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.96,
   "end": 442.74,
   "text": "یه عده‌ای بی‌ظرفیت بالاخره خبر، خبر پیچید و رسید به والیان حکومت اون زمان و قصد جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.74,
   "end": 447.78,
   "text": "زراره رو کردن. حالا به نظر شما امام صادق صلوات الله علیه اینجا چیکار باید بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.78,
   "end": 449.62,
   "text": "بخواد جان زراره رو نجات بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 449.62,
   "end": 452.46,
   "text": "امام صادق پشت سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 452.46,
   "end": 456.58,
   "text": "جملاتی رو پیرامون زراره گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.58,
   "end": 460.32,
   "text": "م-مضمونش اینه که زراره از چشم اُف-ما افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.32,
   "end": 464.06,
   "text": "چرا امام رضا-- امام صادق صلوات الله علیه این کار رو کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 464.06,
   "end": 466.22,
   "text": "این بدگویی ظاهری رو کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.22,
   "end": 468.22,
   "text": "برای اینکه جان زراره رو نشون بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.22,
   "end": 470.34,
   "text": "حالا زراره چه باید بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.34,
   "end": 473.18,
   "text": "باید بگه امام مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.18,
   "end": 477.08,
   "text": "از من برید، به من بدی کرد یا هرچی در دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.08,
   "end": 481.9,
   "text": "کدورتی ایجاد بشه. همونطور دست بوس امام صادق صلوات الله علیه باقی موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.9,
   "end": 484.88,
   "text": "این می‌شه که می‌شه سابقون و مقربون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.88,
   "end": 487.08,
   "text": "اما ما چی؟ بسیاری از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 487.08,
   "end": 490.96,
   "text": "اتفاقات روزگار که می‌افته ما از چشم این و اون می‌افتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.96,
   "end": 493.78,
   "text": "از گردش از گرده، گردونه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.78,
   "end": 496.0,
   "text": "خارج می‌شیم و خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.0,
   "end": 497.9,
   "text": "جایگاه‌ها به ما نمی‌رسه و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 497.9,
   "end": 503.02,
   "text": "یه وقت می‌بینی امام عصر ما رو از چشم انداخته که خرابکاری نکنیم، جان حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 503.02,
   "end": 506.72,
   "text": "معنوی ما رو حفظ کنه، حیات اخروی ما رو حفظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 506.72,
   "end": 513.08,
   "text": "در هر حال اینو می‌خوام بگم که تسلیم امام شدن و امام موندن خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 513.08,
   "end": 518.82,
   "text": "اینکه انسان بر اساس چی انتخابات زندگیش رو انجام میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 518.82,
   "end": 522.06,
   "text": "و هر مقدار این انتخاباتی که انجام میده مطابق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 522.06,
   "end": 529.4,
   "text": "با تعلقات امام نباشه، همون مقدار قطعاً تو گردش روزگار وارد حوزه نفاق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 529.4,
   "end": 534.2,
   "text": "در خصوص ترمه قبلاً ما عرض کردیم ترمه با طی دسته‌ و هجیمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 534.2,
   "end": 540.56,
   "text": "از شعراي خیلی خوب امام حسین صلوات الله علیه در دوراهی کوفه و کربلا حضرت رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 540.56,
   "end": 543.4,
   "text": "بار گندم، حالا چند تا شتر اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.4,
   "end": 546.52,
   "text": "بار گندم زده بود، قوت سالیانه می‌بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.52,
   "end": 552.04,
   "text": "به حضرت رسید گفت آقا من در کوفه لشگریانی دیدم که به این عظمت تا حالا ندیده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 552.04,
   "end": 554.4,
   "text": "نرید. ببینید امامش رو نصیحت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 554.4,
   "end": 560.14,
   "text": "نصیحت امام که آخه تو در جایگاهی نیستی که امام رو نصیحت کنی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 560.14,
   "end": 561.78,
   "text": "ول-ولی نصیحت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 561.78,
   "end": 565.14,
   "text": "می‌گه آقا نرو. و حضرت می‌فرمایند من به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 565.14,
   "end": 567.32,
   "text": "خواست خدا میرم. شما چیکاره‌ای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 567.32,
   "end": 570.28,
   "text": "شما می‌خوای چیکار کنی؟ خب اینجا ترمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 570.28,
   "end": 572.56,
   "text": "تعلقاتش کار دستش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 572.56,
   "end": 575.12,
   "text": "می‌گه اول به حضرت پیشنهاد میده بیا بریم یمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 575.12,
   "end": 578.26,
   "text": "من ده هزار تا مرد جنگی برای شما جور می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 578.26,
   "end": 583.44,
   "text": "آخه مرد جنگی که مثل ترمه باشه به چه درد امام می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.44,
   "end": 589.58,
   "text": "در هر حال امام فرمودن ما به سمت خواست خدا میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 589.58,
   "end": 592.6,
   "text": "گفت نه سربازای شما هم نمی‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 592.6,
   "end": 595.58,
   "text": "ترمه گفت اجازه بدید من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 595.58,
   "end": 598.54,
   "text": "بار گندمم رو ببرم برسونم برگردم محضر شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 598.54,
   "end": 600.44,
   "text": "حضرت فرمود هر کاری می‌خوای بکنی بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 600.44,
   "end": 603.58,
   "text": "خب اونجا باید بار گندم رو می‌ریخت یا ت-- می‌داد به حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 603.58,
   "end": 607.0,
   "text": "به ابی عنتوعمی و مالی و آسرازی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 607.0,
   "end": 609.04,
   "text": "مالمم فدا، جانمم فدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 609.04,
   "end": 611.82,
   "text": "این گندم‌ها رو باید فدای امام حسین می‌کرد خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 611.82,
   "end": 613.42,
   "text": "همونطور که جانش رو فدا می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 613.42,
   "end": 616.5,
   "text": "اما نکرد. چرا؟ تعلقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 616.5,
   "end": 619.32,
   "text": "تعلقات ما نسبت به دنیا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 619.32,
   "end": 624.5,
   "text": "شؤونات متعدد ما در این دنیا هر مقدار که بیشتر باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 624.5,
   "end": 626.36,
   "text": "همون مقدار ترس ما بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 626.36,
   "end": 629.4,
   "text": "یاران امام حسین بودن کسایی مثل حبیب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 629.4,
   "end": 634.62,
   "text": "زنشون رو طلاق دادن برای اینکه بتونن تو خط امام حسین بمونن و فدایی حضرت بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 634.62,
   "end": 636.22,
   "text": "که حالا البته این باید تبیین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 636.22,
   "end": 638.32,
   "text": "حالا فردا از، هرکسی نره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 638.32,
   "end": 641.52,
   "text": "سوءاستفاده کنه نسبت به زنش و هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 641.52,
   "end": 643.1,
   "text": "مراقب تعلقاتمون باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 643.1,
   "end": 647.3,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
