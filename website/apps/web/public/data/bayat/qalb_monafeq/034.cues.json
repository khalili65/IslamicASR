 "chapters": [
  {
   "index": 0,
   "title": "## وطن و قصد؛ شرط عرفی ماندن طولانی",
   "start": 1.74,
   "end": 65.72
  },
  {
   "index": 1,
   "title": "## وجه تمایز مؤمن و منافق؛ احسان‌سازی در برابر کمی‌سازی",
   "start": 65.72,
   "end": 139.14
  },
  {
   "index": 2,
   "title": "## ملک/۲؛ لیبلوکم ایکم احسن عملاً نه اکثر عملاً",
   "start": 139.14,
   "end": 291.8
  },
  {
   "index": 3,
   "title": "## سید عبدالکریم کفاش؛ دیدار هفتگی و کیفی‌سازی دل",
   "start": 291.8,
   "end": 474.58
  },
  {
   "index": 4,
   "title": "## سلام بر اباعبدالله؛ عمل از دل",
   "start": 474.58,
   "end": 562.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.74,
   "end": 4.9,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.9,
   "end": 8.42,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.42,
   "end": 13.06,
   "text": "آیاته. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.06,
   "end": 19.14,
   "text": "ما قبلا عرض کردیم که در خصوص وطن به فتوای رهبری باید قصد وجود داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.14,
   "end": 22.44,
   "text": "هر کجا رو بخوای وطن خودت بگیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.44,
   "end": 25.1,
   "text": "چه وطن اول، چه وطن دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.1,
   "end": 31.9,
   "text": "باید قصد کنی. اما حالا سؤال اینجاست که اگر کسی زیاد موند یه جا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.9,
   "end": 37.22,
   "text": "خیلی موند اگرچه قصد نکرده بود اونجا رو وطنش کنه اما خیلی موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.22,
   "end": 41.3,
   "text": "چی میشه اینجا؟ وطنش میشه یا نمیشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.3,
   "end": 44.68,
   "text": "قصد نکرده اما زیاد مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.68,
   "end": 48.82,
   "text": "رهبری می فرماید به شرط اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.82,
   "end": 52.76,
   "text": "انقدر بمونه تا عرفاً اونجا رو وطنش بدونن همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.76,
   "end": 56.64,
   "text": "یعنی تو عرف اینطوری جا بیفته که فلانی بچه اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.64,
   "end": 63.22,
   "text": "اگر اینطوری تو عرف جا موند، جا افتاد حتی اگر قصد نکرده باشه اونجا وطنشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.22,
   "end": 71.1,
   "text": "اینو حواسمون باشه. یکی دیگه از وجه تمایز بین مؤمن و منافق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.1,
   "end": 75.72,
   "text": "یا کسی که قلبش در وادی ایمان تثبیت شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.72,
   "end": 81.4,
   "text": "و کسی که متاسفانه قلبش دچار نفاق و دو رویی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.4,
   "end": 85.06,
   "text": "اینه که حالا این رو مهکیه دیگه بسنجیم خودمون رو امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.06,
   "end": 93.42,
   "text": "از خودم بگیر تا شماها. اونم اینه که معمولاً این چنین هست که مؤمن دچار احسان‌سازی اعماله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.42,
   "end": 96.54,
   "text": "مشغول احسان‌سازی عملشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.54,
   "end": 100.08,
   "text": "دچار کیفی‌سازی عملشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.08,
   "end": 103.04,
   "text": "منافق دچار کمی‌سازیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.04,
   "end": 107.82,
   "text": "منافق بیشتر به قول ماها خرواری و کیلویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.82,
   "end": 111.38,
   "text": "عمل میکنه که به چشم بیاد، به ظاهر بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.38,
   "end": 116.9,
   "text": "چند تا نماز خوندم، چند تا حج رفتم، چند تا زیارت، چند تا قربونی، چند تا چند تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.9,
   "end": 124.74,
   "text": "ولی مؤمن اینطوری نیست. مؤمن دچار و گرفتار، خودش گرفتاره اصلاً احسان‌سازی عملشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.74,
   "end": 131.62,
   "text": "این یه وجه بسیار مهمیه در بین مؤمن و منافق که باید اینو توجه داشته باشیم حتی تو آیه دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 131.62,
   "end": 136.28,
   "text": "سوره ملک اگر دقت بفرمایید می فرماید \"الذی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 136.28,
   "end": 139.14,
   "text": "خلق الموت والحیاه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 139.14,
   "end": 144.1,
   "text": "خدا کسیه که اصلاً این مرگ و حیات رو آفریده که چی، که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 144.1,
   "end": 146.74,
   "text": "برای چی مرگ و حیات رو خدا آفریده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.74,
   "end": 152.82,
   "text": "\"لیبلوکم\" برای اینکه شما رو دچار آزمایش‌هایی بکنه از بلا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 152.82,
   "end": 157.34,
   "text": "\"لیبلوکم ایکم احسن عملا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 157.34,
   "end": 160.16,
   "text": "برای اینکه ببینه کدوم یکی از شماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 160.16,
   "end": 166.26,
   "text": "احسن عمل دارید. نه فرموده \"لیبلوکم ایکم اکثر عملا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 166.26,
   "end": 169.98,
   "text": "کی بیشتر عمل انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 169.98,
   "end": 174.2,
   "text": "فرمود احسن. البته امام صادق صلوات الله علیه فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 174.2,
   "end": 178.26,
   "text": "وقتی ازش پیرامون احسن اعمال سؤال کردن که چه نوع عملیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 178.26,
   "end": 179.84,
   "text": "حضرت دو تا مشخصه دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 179.84,
   "end": 184.04,
   "text": "فرمودن عملی که درش خلوص باشه و معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.04,
   "end": 192.96,
   "text": "اگر عملی چنان زلال شده باشه که بر اساس خلوص و معرفت انجام شده باشه، این جزو احسن اعماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 192.96,
   "end": 195.5,
   "text": "و ما باید چاره ای نداریم رفقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 195.5,
   "end": 199.02,
   "text": "چاره ای جز کیفی‌سازی عمل نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 199.02,
   "end": 206.06,
   "text": "کی گفته قیامت نگاه میکنن چند تا نماز شب خوندی، چند تا زیارت عاشورا خوندی، چند تا حج و زیارت رفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 206.06,
   "end": 208.28,
   "text": "اصلاً این حرفا نیست قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 208.28,
   "end": 214.42,
   "text": "قیامت اونچه که در وجود ما تثبیت شده، ملکه وجود شما، ما شده اون خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 214.42,
   "end": 217.36,
   "text": "یعنی همون کیفیت وجودی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.36,
   "end": 222.36,
   "text": "اصلاً ربطی نداره ما چند تا نماز خوندیم چند تا اصلاً کیلویی نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 222.36,
   "end": 225.86,
   "text": "چجوری خوندیم؟ این مهمه که چجوری خوندیم، به کجا رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 225.86,
   "end": 228.14,
   "text": "به خلوص و معرفت رسیدیم یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.14,
   "end": 233.06,
   "text": "اگر ما این مثلاً سبکی که رو تسبیحات مقدسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 233.06,
   "end": 238.86,
   "text": "منوره و به حق بیbadil حضرت صدیقه کبرا سلام الله علیها گذاشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 238.86,
   "end": 243.88,
   "text": "برای اینه که کیفی‌سازی بشه تسبیح بی بی که همه جا ازش مینالن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 243.88,
   "end": 252.18,
   "text": "همه جا. همینطوری تند تند صبح، صبح، صبح، صبح تو مساجد، تو خیلی جاها میبینی میگن میرن اصلاً توجه هم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 252.18,
   "end": 255.7,
   "text": "داره با بغل دستی‌ش داره صحبت میکنه الله اکبر، الله اکبر سلام چطوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 255.7,
   "end": 258.5,
   "text": "خوبی؟ الحمد لله خوبم. الله اکبر، الله اکبر و بقیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 258.5,
   "end": 261.06,
   "text": "اصلاً نمیفهمه چی داره میگ... نگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 261.06,
   "end": 262.7,
   "text": "نگو بارتو سنگین میکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 262.7,
   "end": 265.64,
   "text": "جسارت داری میکنی به این تسبیح‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 265.64,
   "end": 268.86,
   "text": "اگه مجبور شدی وسطش حرف بزنی ولش کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 268.86,
   "end": 273.74,
   "text": "از اول شروع کن. به خدا یک بار تسبیحو بگیم درست بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 273.74,
   "end": 280.42,
   "text": "من چهار ساله دارم اینجا میگم بعض، بعض موقعa یه دفعه همینطوریه خدا میدونه ناگدا-- ناخودآگاه از چشام میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 280.42,
   "end": 284.86,
   "text": "میبینم یکی از معلومه انگشتش تند تند داره میشماره میره غصه میخورم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 284.86,
   "end": 290.78,
   "text": "آخه من چقدر بگم؟ یک بار یه تسبیح آدم درست بگه به خدا هیچی دیگه نگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 290.78,
   "end": 294.1,
   "text": "درست بگه. خدا رحمت کنه سید عبد الکریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 294.1,
   "end": 299.84,
   "text": "کفاش رو. آخه چرا همه میشتافتیم هفته ای یه بار تو همین دو رقیه بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 299.84,
   "end": 302.54,
   "text": "هفته ای یه بار محضر امام عصر میرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 302.54,
   "end": 308.74,
   "text": "آخه مگه شوخیه این؟ بعد خیلی جالبه حضرت ببین این کیفی‌سازی تو دله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 308.74,
   "end": 311.62,
   "text": "حضرت این یه تلنگره به خدا قسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 311.62,
   "end": 316.54,
   "text": "حضرت ازش سؤال کرد که اگه تو منو نمی دیدی چیکار می‌کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 316.54,
   "end": 318.74,
   "text": "یه نگاهی به دلش کرد. این یعنی کیفی‌سازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 318.74,
   "end": 321.18,
   "text": "یعنی احسن کردن عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 321.18,
   "end": 327.34,
   "text": "بر اساس معرفته. یه نگاه کرد به دلش همینطوری هم شعاری حرف نزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 327.34,
   "end": 332.14,
   "text": "گفت آقا جان میمیرم اگه شما رو هفته ای یه بار نبینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 332.14,
   "end": 335.58,
   "text": "حالا من چقدر عادت کردم اصلاً به ندیدن آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 335.58,
   "end": 340.94,
   "text": "حضرت فرمود چون اینطور شده دلت منو میبینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 340.94,
   "end": 342.82,
   "text": ". خیلی کلیدیه این حرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 342.82,
   "end": 345.18,
   "text": "چون دلت اینطور شده منو میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 345.18,
   "end": 349.24,
   "text": "اگه اینطور نشده بود نمی دیدی. مثل خیلیا که عادت کردن به ندیدن من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 349.24,
   "end": 356.38,
   "text": "بی مهدی خوشن. بعد جالب بعدش سؤال کردن آقا سید عبد الکریم کفاش چی شد شما این، تو به اینجا کشیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 356.38,
   "end": 360.86,
   "text": "تو رو خدا اینو دقت کنید. رمزیه ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 360.86,
   "end": 363.8,
   "text": "می‌گه من خواب جدم پیغمبر رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 363.8,
   "end": 367.16,
   "text": "انقدر که امام زمانمو دوست داشتم ازش خواهشم این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 367.16,
   "end": 370.88,
   "text": "خدا وکیلی اگه ما امشب خواب پیغمبر رو ببینیم چی ازش می‌خوایم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 370.88,
   "end": 373.3,
   "text": "اونجا دل انسانه که می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 373.3,
   "end": 377.56,
   "text": "حقیقت وجودی انسان، ملک-- اون چیزی که ملکه وجودی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 377.56,
   "end": 383.46,
   "text": "چی می‌خوای؟ پست می‌خوای، پول می‌خوای، من-منصب می‌خوای، مقام می‌خوای، مدیر کلی می‌خوای، چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 383.46,
   "end": 386.24,
   "text": "معروفیت و مشهوریت می‌خوای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 386.24,
   "end": 389.62,
   "text": "که ما الان اومدیم از مداح معروف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 389.62,
   "end": 393.98,
   "text": "حالا این صحبت میره تو، عرض شود درج بشه تو کانال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 393.98,
   "end": 398.34,
   "text": "یادمان شهدای نجف آباد و دو هزار و پونصد تا شهید اونجا و شهید ح-حججی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 398.34,
   "end": 401.88,
   "text": "حدود هزار نفر آدم این حرف ما رو گوش میدن، اونجا میذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 401.88,
   "end": 404.1,
   "text": "ببخشن ما رو اونا. ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 404.1,
   "end": 411.26,
   "text": "از مداح معروف و سخنران معروف که بخوره تو سر من این معروفیت‌ها، دعوت کردیم برای سالگرد شهید حججی بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 411.26,
   "end": 417.54,
   "text": "مداحه گفته بیست میلیون-- پنجاه میلیون می‌گیرم میام سخنرانه گفته بیست میلیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 417.54,
   "end": 420.02,
   "text": "آخه بخور تو سرت این چه معروفیتیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 420.02,
   "end": 423.7,
   "text": "مردمم سینه چاک می‌کنند براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 423.7,
   "end": 426.04,
   "text": "آخه احسان‌سازی عمل کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 426.04,
   "end": 429.72,
   "text": "میگه چرا شما چیکار کردی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 429.72,
   "end": 432.64,
   "text": "می‌بینی آقارو میگه جدم پیغمبر رو خواب دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 432.64,
   "end": 436.44,
   "text": "ازش خواستم پیغمبر دستور عملی که داد عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 436.44,
   "end": 438.38,
   "text": "فرمود عزیزم آست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 438.38,
   "end": 444.22,
   "text": "عبد الکریم روزی دو بار برای حسینم سعی کن گریه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 444.22,
   "end": 449.68,
   "text": "من سعی کردم یک سال روزی دو بار برای حسین ابن علی گریه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 449.68,
   "end": 452.1,
   "text": "سال تموم شد آقامو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 452.1,
   "end": 455.96,
   "text": "بعد دیگه آقا بلند می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 455.96,
   "end": 458.08,
   "text": "ببینید تو رو قرآن این گریه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 458.08,
   "end": 462.7,
   "text": "بعد بعضی از اعمال هست که اصلا خودش صالح‌سازی می‌کنه، احسان‌سازی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 462.7,
   "end": 464.96,
   "text": "مثل سوختن، مثل گریه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 464.96,
   "end": 469.62,
   "text": "اینا شوخی نیست. گریه تا دل نسوزه اشک نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 469.62,
   "end": 472.7,
   "text": "حالا حالتون چون منقلب شد اجازه میدین من یه سلام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 472.7,
   "end": 477.72,
   "text": "خوبه. السلام علیک یا ابا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 477.72,
   "end": 484.22,
   "text": "يا أبا عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 484.22,
   "end": 488.42,
   "text": "و علی الارواح التي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 488.42,
   "end": 493.38,
   "text": "حلت بفنائك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 493.38,
   "end": 498.82,
   "text": "علیک منی سلام الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 498.82,
   "end": 503.82,
   "text": "ابدا. ما بقیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 503.82,
   "end": 508.48,
   "text": "و بقي الليل والنهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 508.48,
   "end": 513.04,
   "text": "و لا جعله الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 513.04,
   "end": 516.08,
   "text": "آخر العهد منی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 516.08,
   "end": 518.66,
   "text": "لزيارتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 518.66,
   "end": 521.46,
   "text": "خدا یا اباعبدالله یادت کردی یه لحظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 521.46,
   "end": 524.82,
   "text": "السلام علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 524.82,
   "end": 528.52,
   "text": "الحسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 528.52,
   "end": 532.38,
   "text": "و علی علی ابن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 532.38,
   "end": 534.94,
   "text": "الحسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 534.94,
   "end": 538.92,
   "text": "و علی اولاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 538.92,
   "end": 543.2,
   "text": "الحسین و علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 543.2,
   "end": 547.16,
   "text": "اصحاب الحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 547.16,
   "end": 550.44,
   "text": "به این میگن سالم‌سازی، احسان‌سازی عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 550.44,
   "end": 555.08,
   "text": "عملی که از دل بر بیاد، دل بسوزه، اشکی جاری شه، این میمونه تا قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 555.08,
   "end": 561.08,
   "text": "انشاالله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 561.08,
   "end": 562.3,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}