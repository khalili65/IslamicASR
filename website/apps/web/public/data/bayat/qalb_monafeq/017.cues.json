 "chapters": [
  {
   "index": 0,
   "title": "## حد ترخص؛ یک شرط یا دو شرط",
   "start": 12.94,
   "end": 98.68
  },
  {
   "index": 1,
   "title": "## بازگشت به قلب منافق؛ خطر متهم‌کردن",
   "start": 98.68,
   "end": 192.68
  },
  {
   "index": 2,
   "title": "## داستان پنج ریال و حرمان از دیدار",
   "start": 192.68,
   "end": 328.8
  },
  {
   "index": 3,
   "title": "## پشیمانی دیرهنگام",
   "start": 328.8,
   "end": 585.8
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.6,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.6,
   "end": 8.4,
   "text": "السلام علیک یا داغی الله و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.4,
   "end": 12.16,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.16,
   "end": 16.38,
   "text": "استفتاء شده از رهبر عزیزمون پیرامون حد ترخص که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.38,
   "end": 21.58,
   "text": "شما فرمودین که حد ترخص جاییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.58,
   "end": 24.26,
   "text": "صدای اذان شهر رو نشنوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.26,
   "end": 31.5,
   "text": "و دیوارها یا اون آخرین خانه‌های شهر هم مبهم ببینی یا نبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.5,
   "end": 37.04,
   "text": "خب حالا سؤال اینه که باید هر دو شرط با هم باشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.04,
   "end": 44.24,
   "text": "یعنی حتما نه صدای اذان شهر رو بشنوی، نه دیوار یا آخرین خونه شهر رو ببینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.24,
   "end": 47.96,
   "text": "یا یکیش باشه به حد ترخص رسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.96,
   "end": 55.76,
   "text": "یعنی یکی، یک شرط محقق شد مثلا فقط صدای اذان رو نشنیدی اما آخرین خونه رو هنوز می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.76,
   "end": 61.82,
   "text": "سؤال مهمیه. آقا فـ-- احتیاط کردن، احتیاطم چون بلافاصله با احتیاط شروع کردن فـ‌",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.82,
   "end": 65.0,
   "text": "فرمودن احوط این است احتیاج میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.0,
   "end": 68.96,
   "text": "احتیاط واجب میشه دیگه. یعنی یا باید همین رو انجام بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.96,
   "end": 71.04,
   "text": "یا رجوع کنیم به مرجع دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.04,
   "end": 75.58,
   "text": "حکم ندادن. فرمودن احتیاط یا احوط این است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.58,
   "end": 77.76,
   "text": "هر دو شرط لحاظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.76,
   "end": 81.52,
   "text": "یعنی به گونه‌ای باشه که هم صدای اذان شنیده نشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.52,
   "end": 83.54,
   "text": "هم آخرین خونه شهر دیده نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.54,
   "end": 88.14,
   "text": "البته بعدش فرمودن بعید نیست که فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.14,
   "end": 90.9,
   "text": "نشنیدن اذان کفایت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.9,
   "end": 95.2,
   "text": "این رو هم گفتن اما حکم صریح ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.2,
   "end": 98.68,
   "text": "و احتیاط پس دو تا شرط رو باید حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.68,
   "end": 104.7,
   "text": "در خصوص قلب منافق ما برگشت کنیم بعد چند وقت به موضوع اصلی بحثمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.7,
   "end": 107.56,
   "text": "نکته‌ای رو عرض کنم. اونم این که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.56,
   "end": 111.1,
   "text": "خطرناکه ورود به این قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.1,
   "end": 116.72,
   "text": "از جهت اینکه معمولاً ببینید کسی که مشرک و کافر و این‌ها شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.72,
   "end": 119.06,
   "text": "اون خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.06,
   "end": 123.18,
   "text": "بعضی موقع‌ها حتی این‌ها بر اساس فطرتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.18,
   "end": 126.94,
   "text": "عمل کردن اما در مصداق اشتباه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.94,
   "end": 129.7,
   "text": "خطر وقتیه که آدم بدونه حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.7,
   "end": 136.32,
   "text": "برای همین برای ما اهل ایمان، برای مایی که حقایق رو می‌دونیم خطر نفاق خیلی بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.32,
   "end": 138.88,
   "text": "دقت بفرمایید چی عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.88,
   "end": 142.86,
   "text": "مثلاً زهیر در جنگ صفین تو صف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.86,
   "end": 146.4,
   "text": "معاویه بود. بر اساس فطرتش عمل کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.4,
   "end": 151.5,
   "text": "این نفاق نداشت که. چگو-چگونه بر اساس فطرتش عمل کرده بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.5,
   "end": 156.06,
   "text": "به قول آیت الله خائری شیرازی رحمة الله علیه می‌فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.06,
   "end": 158.74,
   "text": "فطرتش این بود که موافق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.74,
   "end": 160.6,
   "text": "مظلوم باش مخالف ظالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.6,
   "end": 164.84,
   "text": "اون در تشخیص مصداق اشتباه کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.84,
   "end": 167.5,
   "text": "فطرتش اینو بهش می‌گفت اما او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.5,
   "end": 172.54,
   "text": "مصداق استغفرالله ظالم رو علی علیه الصلاة والسلام دیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.54,
   "end": 175.88,
   "text": "مصداق مظلوم رو معاویه. لذا رفته بود تو صف مظلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.88,
   "end": 178.58,
   "text": "اینطوری گمان می‌کرد. بعد تو کربلا جبران کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.58,
   "end": 181.18,
   "text": "متوجه شد که اشتباه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.18,
   "end": 183.74,
   "text": "ببینید این خیلی خطر نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.74,
   "end": 188.26,
   "text": "یعنی خطر داره‌ها، خطرش به جدیت این نیست که کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.26,
   "end": 198.0,
   "text": "بداند راهی اشتباهه و اون راه رو بره تازه به دیگران رو هم توصیه کنه یا بداند یک راهی درست است و از اون سر باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.0,
   "end": 200.16,
   "text": "زند و دیگران رو منع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.16,
   "end": 203.54,
   "text": "سد در سبیل الله. این خطر نفاق اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.54,
   "end": 205.74,
   "text": "نفاق یعنی دورویی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.74,
   "end": 208.76,
   "text": "دورویی از کجا میاد؟ یعنی یه روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.76,
   "end": 214.78,
   "text": "دلش میگه آقا این حرف درسته قبول دارم اما یه روی دلش میگه نه عمل نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.78,
   "end": 216.36,
   "text": "کی میگه این حرف درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.36,
   "end": 221.22,
   "text": "وقتی تو صف اهل ایمانه میگه این حرف درسته، این راه درسته، این حرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.22,
   "end": 224.92,
   "text": "این راه بر حقه اما در عمل بر خلافشو انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.92,
   "end": 229.44,
   "text": "این خیلی خطرناکه و در حقیقت به خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.44,
   "end": 232.22,
   "text": "ضریه خودزنی عجیبی منافق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.22,
   "end": 238.22,
   "text": "کسی که دلش به سمت نفاق خـ-- سر خورده دائما داره خودزنی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.22,
   "end": 244.58,
   "text": "یه روایتی هست که رهبر عزیزمون هم پیش از درس خارجشون یه روزی فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.58,
   "end": 247.1,
   "text": "در ک-- از کتاب الشافی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.1,
   "end": 250.88,
   "text": "صفحه هشتصد و شصت و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.88,
   "end": 253.64,
   "text": "که البته در کافی هم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.64,
   "end": 261.8,
   "text": "که امام صادق صلوات الله علیه فرمودند که [سخنگوی 1: کتب رجلا الی ابیذر] یه نفر یه نامه‌ای به ابیذر نوشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.8,
   "end": 268.66,
   "text": "که [سخنگوی 1: یا اباذر اعطرفنی بشیئ من العلم] یه طرف، طرفه‌ای، یه چیز تازه‌ای از علم به من بیاموز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.66,
   "end": 271.4,
   "text": "چه چیز نابی از تعابذر گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.4,
   "end": 275.68,
   "text": "فرمودند که [سخنگوی 1: فکت- فکتب الیه ان العلم كثير]",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.68,
   "end": 279.38,
   "text": "علم خیلی زیاده ولی من یه چیزی به تو میگم که برات بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.38,
   "end": 280.94,
   "text": "حالا ببینید چی فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.94,
   "end": 290.34,
   "text": "[سخنگوی 1: ان قدرت لا تسیء الى من تحبه فافعل] اگه می‌تونی به کسی که دوسش داری بدی نکنی همین بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.34,
   "end": 293.26,
   "text": "همین کارو بکن. به کسی که دوسش داری بدی نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.26,
   "end": 298.62,
   "text": "بعد این طرف گفت [سخنگوی 1: هل رأیت احدا یسيء الى من يحبه] یعنی چه حرفی رو می‌زنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.62,
   "end": 302.72,
   "text": "مگه کسی که-- میشه کسی که دوست داشته باشی بعد بهش بدی کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.72,
   "end": 304.88,
   "text": "حالا استنباط از تعابذر چه زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 304.88,
   "end": 307.54,
   "text": "[سخنگوی 1: فقال له] گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.54,
   "end": 308.68,
   "text": "نه بله میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.68,
   "end": 317.84,
   "text": "[سخنگوی 1: نفسک احب الانفس الیک فان انت اسٔت الله تعالی فقط اسٔت الیها] تو نفستو هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.84,
   "end": 322.06,
   "text": "جانشو بیشتر از دیگر، هر چیز دیگه‌ای دوست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 322.06,
   "end": 326.86,
   "text": "هنر شهدا اینجاست که بیشترین چیزی که بهش علاقه‌مندند که این ثابت شده‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 326.86,
   "end": 332.1,
   "text": "جان و نفس وجود و موجودیت خود انسان‌ست با خدا معامله می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.1,
   "end": 335.3,
   "text": "این کار، کار کمی نیست. برای همین مقاماتشون خیلی بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.3,
   "end": 338.88,
   "text": "حالا میگه تو نفستو از هر چیزی بیشتر دوست داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.88,
   "end": 343.06,
   "text": "وقتی معصیت می‌کنی داری بر علیه خودت عمل می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.06,
   "end": 345.28,
   "text": "به خودت که دوسش داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.28,
   "end": 348.18,
   "text": "داری خیانت می‌کنی، داری بد می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.18,
   "end": 351.96,
   "text": "این از بدترین انواع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.96,
   "end": 355.5,
   "text": "خطر در مسائل اخلاقیه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.5,
   "end": 358.68,
   "text": "مخصوصاً اینکه بدونه، بدونه که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.68,
   "end": 362.38,
   "text": "تو این نفست، این نفس تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 362.38,
   "end": 364.88,
   "text": "از نفس کلیه الهیه گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.88,
   "end": 367.92,
   "text": "تو بچه شیعه هستی، تو بچه ولایتی هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.92,
   "end": 370.56,
   "text": "این‌ها رو بدونه که ما می‌دونیم هممون عالمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.56,
   "end": 376.08,
   "text": "الحمدلله. هممون وقت گناه می‌دونیم این کار برای همین خیلی خطرش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.08,
   "end": 380.12,
   "text": "برای ما که آگاه هستیم عزیزانی خطرش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.12,
   "end": 386.9,
   "text": "همه اینایی که می‌دونن آقا گرون‌فروشی پسته، زشته، مخالف با فطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.9,
   "end": 389.82,
   "text": "اختلاس بده، نجومی گرفتن بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 389.82,
   "end": 395.56,
   "text": "خیانت کردن به مردم، فروختن آب این مردم، فروختن خاک این مردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.56,
   "end": 398.46,
   "text": "فروختن عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.46,
   "end": 400.38,
   "text": "این همه ماحصل انقلاب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.38,
   "end": 404.5,
   "text": "اینا رو می‌دونن خبر دارن اما طمع دنیا گرفته‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.5,
   "end": 407.68,
   "text": "این‌ها عین نفاق و منافقین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 407.68,
   "end": 411.2,
   "text": "هیچ فرقی با اونا-- بلکه اینا بدترن چون اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 411.2,
   "end": 414.94,
   "text": "ظاهرشون می‌بینید سردمدار و پرچمدار دین هم بعضا هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 414.94,
   "end": 418.5,
   "text": "بعضیاشون حتی لباس پیغمبر هم هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.5,
   "end": 423.44,
   "text": "یه روزی تو یه کتاب مطالعه می‌کردم اینو خوب دقت کنید و بحثه برای امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 423.44,
   "end": 426.7,
   "text": "خیلی عجیبه. تو رو خدا اینا رو دقت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 426.7,
   "end": 429.32,
   "text": "یه کسی خیلی دوست داشت آقاشو ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.32,
   "end": 432.14,
   "text": "و ایام شعبانیه هم هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.14,
   "end": 435.88,
   "text": "ما هم دوست داریم. اما ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.88,
   "end": 438.06,
   "text": "خود امام عصر چی بهش فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.06,
   "end": 442.52,
   "text": "ایشون رفت چهل روز تو مسجد جمکران بیعتوته کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.52,
   "end": 444.8,
   "text": "چهل روز، کدوممون تا حالا این کارو کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.8,
   "end": 447.4,
   "text": "چهل روز شبانه روز بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.4,
   "end": 452.62,
   "text": "مسجد جمکران. من خودم شاید یه روزی بود من چند روز رفتم خسته شدم ول کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.62,
   "end": 455.16,
   "text": "نتونستم کار هرکسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.16,
   "end": 457.38,
   "text": "چهل شبانه روز که آقاشو ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.38,
   "end": 459.62,
   "text": "نشد. ندید. خسته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.62,
   "end": 461.98,
   "text": "بعد چهل روز که تموم شد برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.98,
   "end": 465.84,
   "text": "تو راه دید شیخ جعفر مشتدی نشسته داره کفش واکس می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.84,
   "end": 468.76,
   "text": "یه نفرم کفششو بهش داد که واکس بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 468.76,
   "end": 471.14,
   "text": "اینم شیخ جعفر رو می‌شناخت. مرد بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.14,
   "end": 473.28,
   "text": "داره نفسشو عقاب می‌کنه عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 473.28,
   "end": 475.6,
   "text": "کارایی می‌کردن کفش واکس می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.6,
   "end": 479.46,
   "text": "مهمونای آقا رو. وایساد نگاه کرد ببینم چیکار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 479.46,
   "end": 483.42,
   "text": "بعد گفت خب چقدر اون طرف که کفششو داده بود به شیخ جعفر گفت چقدر بدم بهت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 483.42,
   "end": 486.48,
   "text": "مال اون دوره‌هاست البته‌ها. گفت پنج ریال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 486.48,
   "end": 492.38,
   "text": "پنج ریال. این آقایی که چهل روز مو-متوصل شده بود گفت پنج ریال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 492.38,
   "end": 496.52,
   "text": "همه دارن بیست ریال می‌گیرن کفش واکس می‌کنن تو پنج ریال می‌گیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 496.52,
   "end": 500.12,
   "text": "مثلا داری کار و کاسبی همون کس رو می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 500.12,
   "end": 502.76,
   "text": "یه نگاه بهش کرد شیخ جعفر گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 502.76,
   "end": 507.18,
   "text": "سه ریال پول موادشو میدم، دو ریال هم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 507.18,
   "end": 511.4,
   "text": "اجرت هم کفایت می‌کنه. گفت آقا این معجره کرد آقا دیونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 511.4,
   "end": 512.98,
   "text": "همه دارن بیست ریال میگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 512.98,
   "end": 515.62,
   "text": "امروز چقدر این مدته تو همین بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 515.62,
   "end": 520.18,
   "text": "معنوی‌ها و مذهبی‌ها. بابا همه دارن، همه دارن می‌خورن، همه دارن فلان می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 520.18,
   "end": 522.9,
   "text": "تو دیونه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 522.9,
   "end": 527.76,
   "text": "بعد یه نفر که بغلش وایساده بود بغل شیخ جعفر و خیلی هم نورانی بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 527.76,
   "end": 530.84,
   "text": "رو کرد به همین آقایی که چهل روز بیعتوته کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 530.84,
   "end": 539.26,
   "text": "بهش فرمود که کسی که پنج ریال رو بده بیست ریال لیاقت نداره امام زمانشو ببینه و رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.26,
   "end": 542.5,
   "text": "این موند ت-- بدنه‌اش لرزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 542.5,
   "end": 546.5,
   "text": "فرمود آدم عادی نبود. از شیخ جعفر پرسید این آقا کی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 546.5,
   "end": 551.34,
   "text": "گفت همون کسی بود که به خاطرش چهل شبانه روز خودتو به زحمت انداختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 551.34,
   "end": 556.78,
   "text": "امام زمانت بود. اینا همه به ن-- علیه خودشون دارن اقدام می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 556.78,
   "end": 559.1,
   "text": "اینایی که این غلط‌ها رو می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 559.1,
   "end": 564.28,
   "text": "و یه روزی هم که وقتی بدنشون سست شد، پیری اومد سراغشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.28,
   "end": 568.58,
   "text": "ذلت و خاری زمین‌گیری اومد سراغشون، همشون پشیمون میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 568.58,
   "end": 571.1,
   "text": "بدون استثناء همه‌شون می‌فهمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 571.1,
   "end": 574.24,
   "text": "که لا حول و لا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 574.24,
   "end": 580.34,
   "text": "ولی دیگه دیر شده. ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.34,
   "end": 585.8,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}