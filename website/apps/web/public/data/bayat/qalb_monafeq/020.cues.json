 "chapters": [
  {
   "index": 0,
   "title": "## قصد مسافت شرعی از آغاز سفر",
   "start": 0.38,
   "end": 127.16
  },
  {
   "index": 1,
   "title": "## قلب منافق؛ امر به منکر و نهی از معروف",
   "start": 127.16,
   "end": 147.3
  },
  {
   "index": 2,
   "title": "## خبرچینی به نام خیرخواهی",
   "start": 147.3,
   "end": 172.84
  },
  {
   "index": 3,
   "title": "## تبوک و حدیث منزلت؛ شایعه علیه جانشین",
   "start": 172.84,
   "end": 610.93
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 3.02,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.02,
   "end": 6.54,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.54,
   "end": 10.74,
   "text": "آياته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.74,
   "end": 15.76,
   "text": "یکی از نکات دیگه‌ای که تو باب فقه و احکام مسافر خیلی مهمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.76,
   "end": 25.54,
   "text": "این رو دقت بفرمایید و ظریف هست، این هستش که شما حتما باید وقت شروع سفرت قصد قطعا قصد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.54,
   "end": 28.68,
   "text": "طی کردن مسافت شرعی رو داشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.68,
   "end": 33.02,
   "text": "از همون اول. مردد نباید باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.02,
   "end": 38.24,
   "text": "یعنی قصدت این باشه که حتما من مسافت شرعی رو میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.24,
   "end": 47.18,
   "text": "که حالا این سؤال پیش میاد اگر کسی قصد نداشت که مسافت شرعی رو بره به جای چهار فرسخ مثلا سه فرسخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.18,
   "end": 52.44,
   "text": "میخواست بره و رفت، رسید به اون محل بعد از اونجا قصد کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.44,
   "end": 56.52,
   "text": "که بره مثلا به یه محل دومی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.52,
   "end": 58.8,
   "text": "فاصله محل دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.8,
   "end": 62.06,
   "text": "از منزلش مسافت شرعی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.06,
   "end": 66.64,
   "text": "اما از اونجایی که میخواست تازه قصد کنه و حرکت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.64,
   "end": 70.08,
   "text": "مسافت شرعی نمیشه. اینجا چیکار باید کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.08,
   "end": 77.74,
   "text": "دقت بفرمایید یه بار دیگه میگم. از منزل شروع میکنه قصد طی کردن چهار فرسخ در رفت رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.74,
   "end": 82.28,
   "text": "میره به یه جایی حالا سه فرسخه هرچقدر کمتر از مسافت شرعیه، اونجا می مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.28,
   "end": 85.58,
   "text": "بعد از اونجا قصد میکنه یه سفر بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.58,
   "end": 95.12,
   "text": "بره به یه شهر دیگه. که اون شهر دوم که میخواد بره از منزل خودش از همون شهر اولش مسافت شرعی حساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 95.12,
   "end": 100.58,
   "text": "اما از این جایی که الان درش قرار گرفته میخواد بره مسافت شرعی نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.58,
   "end": 104.18,
   "text": "این چه باید بکنه؟ فرمودن این مسافر نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 104.18,
   "end": 112.5,
   "text": "مسافر حساب نمیشه. چون تازه الان میخواد قصد کنه و از اینجا تا اونجا از این محلی که الان میخواد قصد کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 112.5,
   "end": 115.98,
   "text": "تا مقصد بعدی که میخواد بره مسافت شرعی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 115.98,
   "end": 118.86,
   "text": "و لو تا منزلش مسافت شرعی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.86,
   "end": 123.66,
   "text": "الان میخواد قصد کنه. این رو حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 123.66,
   "end": 126.02,
   "text": "در خصوص قلب منافق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.02,
   "end": 128.46,
   "text": "قرآن در سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.46,
   "end": 132.48,
   "text": "توبه آیه شصت و هفت نکته مهمی رو میفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.48,
   "end": 135.96,
   "text": "که مخصوصا این‌ها برای کارایی که کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.96,
   "end": 141.12,
   "text": "تو نهادهای دولتی‌اند، جاهایی‌اند که اخبار بهشون میرسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.12,
   "end": 143.54,
   "text": "این‌ها خیلی این‌ها مهمه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 143.54,
   "end": 146.72,
   "text": "توجه به این بخش از آیات که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.72,
   "end": 148.72,
   "text": "نفاق هست داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.72,
   "end": 153.9,
   "text": "بسیاری از این خبرها که به ما میرسه خبرهای کذبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.9,
   "end": 156.1,
   "text": "عرض کردیم کار منافقین اصلاً چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.1,
   "end": 160.12,
   "text": "تحریف خبره، تقطیع و سوئیچ که میکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.12,
   "end": 163.34,
   "text": "حرف طرف و اصل مطلب رو در نمیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.34,
   "end": 167.14,
   "text": "حالا چه تو کلیپش، حالا صدا و چه سخنرانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.14,
   "end": 174.62,
   "text": "هرچی که هست اصل مطلب رو نمیذارن، تقطیع میکنن، اونچه که به دردشون میخوره رو در میارن، طرفو خراب میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.62,
   "end": 178.48,
   "text": "بسیاری از اخباری که به ما میرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.48,
   "end": 185.76,
   "text": "نقضه. دقیقا چیزی نیست که اتفاق افتاده و جالبه که این‌ها مدعی هستند که آقا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.76,
   "end": 189.12,
   "text": "مصلحت شما رو میخوایم. ما اصلا مصلحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 189.12,
   "end": 192.64,
   "text": "ما اصلاح گریم. ما اصلا میخوایم شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.64,
   "end": 197.22,
   "text": "درست فکر کنید. این اخبار رو برای شما آوردیم که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.22,
   "end": 200.74,
   "text": "متوجه باشید و درست راه رو انتخاب کنید و چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.74,
   "end": 204.14,
   "text": "بعد اینا جالبه که قرآن میگه اتفاقا اینا برعکسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.14,
   "end": 210.04,
   "text": "وقتی دقت میکنی نهی از معروف میکنن و امر به منکر میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.04,
   "end": 213.28,
   "text": "وقتی دقت میکنی تو اعمالشون و رفتارشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.28,
   "end": 215.98,
   "text": "میبینی اتفاقا دارن ارزش‌ها رو میزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.98,
   "end": 218.84,
   "text": "مثلا توی اداره میاد طرح و برنامه میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.84,
   "end": 221.82,
   "text": "میخواد توسعه بده کارش رو تو اداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.82,
   "end": 225.82,
   "text": "بعد مثلا شعار میده که من میخوام به نفع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.82,
   "end": 228.8,
   "text": "همکارا عمل کنم. جاشون تنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.8,
   "end": 230.68,
   "text": "یه دفعه گیر میده به مسجد اداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.68,
   "end": 234.02,
   "text": "این مسجد خب نماز برن مثلا فلان جا بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.02,
   "end": 236.38,
   "text": "این بره به چه درد میخوره؟ بیاییم اینجا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.38,
   "end": 239.96,
   "text": "حجره، حجره‌اش کنیم، کتابش چند تا اتاقش کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.96,
   "end": 242.56,
   "text": "همکارا برن فلان جا نماز بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.56,
   "end": 248.36,
   "text": "یعنی این‌ها وقتی شما ریز میشی میبینی اتفاقا نقطه‌ای که میزنن اول به ارزش‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.36,
   "end": 251.88,
   "text": "اول به ساحت قدس و اقدس‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.88,
   "end": 254.66,
   "text": "اول به اون چهره‌های مثبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.66,
   "end": 260.76,
   "text": "حالا دقت بفرمایید آیه میفرماید المنافقون والمنافقات بعضهم من بعض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.76,
   "end": 264.32,
   "text": "يأمرون بالمنكر. ببینید چقدر صریح داره میگه قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.32,
   "end": 267.2,
   "text": "يأمرون امر میکنن به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 267.2,
   "end": 271.98,
   "text": "بالمنكر. به جای اینکه امر کنن به معروف يأمرون بالمنكر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.98,
   "end": 276.4,
   "text": "صریح داره قرآن میگه. وينهون عن المعروف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.4,
   "end": 278.66,
   "text": "نهی میکنن از چیزای خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.66,
   "end": 283.98,
   "text": "یکی از صفات بسیار بارز اهل نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.98,
   "end": 287.46,
   "text": "یه طرف میاد مثلا جلو تو زیاد اتفاق افتاده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.46,
   "end": 290.14,
   "text": "اینارو ما باید بترسیم. خیلی باید بترسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.14,
   "end": 294.26,
   "text": "میاد میگه فلانی پشت سرت اینو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.26,
   "end": 295.82,
   "text": "پشت سرت نمیدونید چیا گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.82,
   "end": 299.1,
   "text": "این حرفو زد، اون حرفو زد. خب شما چیکار کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.1,
   "end": 305.02,
   "text": "اگر آمده غیبت کرده، تهمت زده و تو هم قبول نداشتی چرا دفاع نکردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.02,
   "end": 307.98,
   "text": "ده سالی اومدی الان به من برای چی میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.98,
   "end": 311.74,
   "text": "این خبرچینیت برای چیه؟ پشت سر من که دفاع که نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.74,
   "end": 315.12,
   "text": "حالا هم که اومدی داری اونو پیش من خراب میکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.12,
   "end": 317.36,
   "text": "این کاملا چهره نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.36,
   "end": 320.22,
   "text": "ما گاهی اوقات گیر به یه سری چیزایی میدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.22,
   "end": 323.2,
   "text": "که خیلی اهل بیت به این‌ها ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.2,
   "end": 326.72,
   "text": "اصرار نداشتن. توجه آنچنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.72,
   "end": 328.36,
   "text": "توجهشون معطوف بهش نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.36,
   "end": 337.2,
   "text": "اما یه چیزایی که اصلا کل عمرشون رفاقتش رو با یه نفر قطع میکرد امام معصوم به خاطر این یه مورد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 337.2,
   "end": 343.56,
   "text": "بسیار نقل نواط مجلسونه مثل غیبت، مثل تهمت، مثل خبرسازی، مثل شایعه‌سازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.56,
   "end": 346.12,
   "text": "چقدر الان زیاده. همینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 346.12,
   "end": 349.76,
   "text": "بنده خدا یه روز آقای باقری داشت صحبت میکرد با استاد باقری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.76,
   "end": 351.94,
   "text": "یکی از بچه های خوب شما من دلم میسوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 351.94,
   "end": 355.02,
   "text": "اومد بیرون یکی دیگه از بچه هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.02,
   "end": 358.02,
   "text": "ما با هم بزرگ شدیم هر دو هم بچه های خودتونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.02,
   "end": 359.8,
   "text": "نشسته بود اینجا آدم مزاحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.8,
   "end": 361.74,
   "text": "هر وقت میاد اینجا تیکه پرونی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.74,
   "end": 365.4,
   "text": "ما اصلا با هم بزرگ شدیم. یه دفعه گفت سلامتی حاج آقا صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.4,
   "end": 368.49,
   "text": "بعد به شوخی گفت منظورم حاج آقا بیات بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.49,
   "end": 370.85,
   "text": "یه تیکه‌ای انداخت خندیدیم چند نفری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.85,
   "end": 377.33,
   "text": "بعد اون دوست اون یکی دوست ما که اونم بچه خوبیه اومد بیرون به من گفت حاج آقا خیلی برحذر باش از فلانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.33,
   "end": 380.07,
   "text": "دیدی؟ اصلا به قصد تخریب اومده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.07,
   "end": 382.61,
   "text": "اصلا اومده که این جلسه رو تخریب کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.61,
   "end": 386.17,
   "text": "آقای باقری رو تخریب کنه. من یه چیزایی درباره ایشون میدونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.17,
   "end": 388.11,
   "text": "گفتم عجب بگو ببینم چی میدونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 388.11,
   "end": 391.55,
   "text": "یه چیزای خیلی پیش پا افتاده‌ای گفت، گفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.55,
   "end": 399.55,
   "text": "بعد بهش گفتم که اولا تو باید میکشیدیش کنار تو گوشش میگفتی فلانی این کارت اشتباه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 399.55,
   "end": 402.61,
   "text": "این درسته اگه تو صلح میخوای براش-- به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 402.61,
   "end": 406.43,
   "text": "نفع اون بخوای عمل کنی. دو، الان برای چی اومدی داری به من میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.43,
   "end": 408.83,
   "text": "به چه درد من میخوره این رفتار تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 408.83,
   "end": 413.39,
   "text": "سه، این کسی که شما داری میگی من از بچگی بزرگش کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.39,
   "end": 416.55,
   "text": "اصلا یه آدم مزاحی هم such-- ذاتش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.55,
   "end": 418.91,
   "text": "تعجب کرده از این رفتار من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 418.91,
   "end": 421.19,
   "text": "معمولا ما جرات و جسارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 421.19,
   "end": 424.37,
   "text": "رد کردن اخبار غلط رو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.37,
   "end": 431.97,
   "text": "بعد جالبه تو آیه‌ی یازده سوره بقره میگه \"و اذا قیل لهم لا تفسدوا فی الارض\" وقتی بهشون تشر میزنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.97,
   "end": 437.71,
   "text": "فساد نکنید تو زمین شعارشونو ببین \"قالوا انما نحن مصلحون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.71,
   "end": 439.59,
   "text": "بابا ما صلاح شما رو میخوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 439.59,
   "end": 443.41,
   "text": "ما اصلاح گریم. ما اصلاح طلبیم ما فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 443.41,
   "end": 446.95,
   "text": "کاملا-- یادتونه زمان انتخابات یه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.95,
   "end": 452.45,
   "text": "چجوری تو بوق و کرنا کردن که اگه اگر مثلا فلانی بیاد رییس جمهور بشه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.45,
   "end": 454.09,
   "text": "نمیدونم دیوار میکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 454.09,
   "end": 457.59,
   "text": "نمیدونم جنگ میشه. آمریکا میاد فلان میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.59,
   "end": 462.63,
   "text": "اگرچه الان تخریب‌هایی تو مملکت ایجاد کردن که از ده تا جنگ هم بدتر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.63,
   "end": 467.61,
   "text": "اما اینا، اینها کاملا این خبرسازی‌ها، این شایعه سازی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.61,
   "end": 475.53,
   "text": "و این اتفاقاتی که اون موقع رخ میداد الان قرآن داره به ما میگه که اینا همش ریشه در نفاق داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.53,
   "end": 478.49,
   "text": "کسایی که اینطورین منافقانه عمل میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 478.49,
   "end": 481.93,
   "text": "ببین زمان امیرالمؤمنین همه الحمدالله اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 481.93,
   "end": 484.51,
   "text": "مطالعه هستید. تاریخ اسلام رو خوندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 484.51,
   "end": 489.39,
   "text": "اینا به شد-- الان اگر اینارو ما مطالعه نکنیم، همین رهبر توصیه میکنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.39,
   "end": 491.57,
   "text": "خوندن تاریخ اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.57,
   "end": 497.07,
   "text": "الان میبینی چقدر به درد میخوره. زمان جنگ تبوک که بر علیه رومی‌ها رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 497.07,
   "end": 500.41,
   "text": "که قلمرو اسلام رو در برابر روم محافظت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 500.41,
   "end": 504.63,
   "text": "امیرالمؤمنین رو یادتونه دیگه تو تاریخ نوشته پیغمبر گذاشت تو شهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.63,
   "end": 507.53,
   "text": "مدینه و رفت. امیرالمؤمنین موند تو شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 507.53,
   "end": 509.67,
   "text": "جانشین پیغمبر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 509.67,
   "end": 511.81,
   "text": "نامردا نیومدن بگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 511.81,
   "end": 517.81,
   "text": "پیغمبر چقدر مولا رو دوست داشته قبول داشته که به عنوان جانشین خودش گذاشته تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.81,
   "end": 521.81,
   "text": "شهر. برعکس گفتن که قبولش نداشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 521.81,
   "end": 526.53,
   "text": "از چشمش افتاده مولا علی که گذاشته‌ش تو شهر و رفته جنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.53,
   "end": 530.55,
   "text": "انقدر حرف زدن، انقدر حرف زدن که هم تخریب کنن چهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.55,
   "end": 536.65,
   "text": "امیرالمؤمنین رو هم مولا به تنگ بیاد ول کنه شهر رو بره اینا بریزن غلط‌هاشون رو بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 536.65,
   "end": 539.13,
   "text": "توجه کردید؟ چیکار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 539.13,
   "end": 542.87,
   "text": "امیرالمؤمنین سریع خودشو رسوند به پیغمبر گفت اینا دارن اینطوری خبرسازی میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 542.87,
   "end": 546.01,
   "text": "پیغمبر بار دوم حدیث منزلت رو بیان کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 546.01,
   "end": 550.93,
   "text": "به نفع اتفاقا امیرالمؤمنین شد و دوباره مولا برگشت تو شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 550.93,
   "end": 553.91,
   "text": "نتونستن کاری بکنن. اما هی شایعه سازی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 553.91,
   "end": 559.75,
   "text": "بسیاری از این شایعاتی که الان تو همه اداره‌جات مخصوصا تو بخش‌های شما این زیاد موج میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.75,
   "end": 563.55,
   "text": "انقدر من اینو خدمت مدیرای خوب شما عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.55,
   "end": 569.67,
   "text": "اگر حضور دارن. انقدر از بچه‌های خود شما بارها و بارها اومدن پیش من گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.67,
   "end": 576.71,
   "text": "پرونده سازی‌هایی بر علیه ما شده که اصلا یه دونه از اینا صحت نداشته و من نمیدونم به کی بگم این‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.71,
   "end": 578.27,
   "text": "ما باید خیلی مراقب باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 578.27,
   "end": 583.37,
   "text": "بسیاری از این‌ها میبینی حالا بعضیاش برنامه‌ریزی شده است، بعضیاش نشده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.37,
   "end": 585.79,
   "text": "اما تو قرآن گراش رو به ما داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.79,
   "end": 590.61,
   "text": "باید یه مدیر خوب، یه مدیر توانا و موفق تو هر مجموعه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 590.61,
   "end": 593.37,
   "text": "باید بتونه اینا رو تو نطفه خفه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 593.37,
   "end": 598.57,
   "text": "خبرسازی‌ها و شایعه سازی‌های به دروغ رو که همش از نفاق نشأت میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 598.57,
   "end": 603.59,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 603.59,
   "end": 610.93,
   "text": "اللهم صلي على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}