 "chapters": [
  {
   "index": 0,
   "title": "## مسافت شرعی و قصد منزل در شهر مقصد",
   "start": 8.9,
   "end": 115.14
  },
  {
   "index": 1,
   "title": "## چهار علامت نفاق؛ سیر از حرص دنیا",
   "start": 115.14,
   "end": 265.86
  },
  {
   "index": 2,
   "title": "## خطر نفاق وقتی دین برای دنیا اختیار شود",
   "start": 265.86,
   "end": 369.42
  },
  {
   "index": 3,
   "title": "## میرزا جواد ملکی تبریزی و محو کتاب برای خدا",
   "start": 369.42,
   "end": 528.62
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.54,
   "end": 4.3,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.3,
   "end": 8.9,
   "text": "السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.9,
   "end": 11.74,
   "text": "موضوع احکام، احکام سفر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.74,
   "end": 14.98,
   "text": "عرض کردیم که نظر رهبری اخیراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.98,
   "end": 17.18,
   "text": "در مسافت شرعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.18,
   "end": 20.12,
   "text": "بیست کیلومتر و نیم شده حداقل در رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.12,
   "end": 24.6,
   "text": "حالا یه استفتای خیلی مهمی است که معمولاً بهش توجه نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.6,
   "end": 27.38,
   "text": "این هست دقت بفرمایید که از آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.38,
   "end": 30.16,
   "text": "رهبر عزیزمون سؤال شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.16,
   "end": 33.02,
   "text": "اگر از انتهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 33.02,
   "end": 38.36,
   "text": "شهر مبدا تا ابتدای شهر مقصد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.36,
   "end": 41.98,
   "text": "این مسافت به میزان مسافت شرعی نشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.98,
   "end": 47.0,
   "text": "اما به اون خونه و محلی که داخل شهر می‌خوایم بریم مستقر بشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.0,
   "end": 49.18,
   "text": "تا اونجا اگر حساب کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.18,
   "end": 52.96,
   "text": "مسافت شرعی میشه، آیا اینجا ما مسافریم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 52.96,
   "end": 54.86,
   "text": "آقا فرمودن اگر شما ف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 54.86,
   "end": 60.06,
   "text": "صرفاً به قصد اون شهر داری سفر می‌کنی، یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.06,
   "end": 62.5,
   "text": "یعنی اگر از شما سؤال کنن برای چی میری اونجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 62.5,
   "end": 67.34,
   "text": "بگی دارم میرم شهر فلان مثلاً شهر یزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 67.34,
   "end": 71.3,
   "text": "اگر از شما سؤال کردن و شما جوابت اینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 71.3,
   "end": 76.2,
   "text": "خب شما اونجا مسافر حساب نمیشی چون رسیدی به شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 76.2,
   "end": 83.74,
   "text": "به مقصد رسیدی. اما اگر به عنوان نمونه مثلاً کسی از شما دعوت کرده به منزلش، به باغش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.74,
   "end": 91.94,
   "text": "شما بری به باغش، به منزلش بری، اصلاً قصد شما از این سفر صرفاً این دعوتیه که فلانی از شما کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.94,
   "end": 94.12,
   "text": "بری به منزل ایشون، به باغ ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.12,
   "end": 99.54,
   "text": "خب اون لحظه، حالا ما حرف باغو که می‌زنیم همه می‌خندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.54,
   "end": 101.82,
   "text": "معلومه که همه باغ دوستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.82,
   "end": 104.1,
   "text": "بله خدا نعمت رو بر شما افزون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 104.1,
   "end": 107.5,
   "text": "به هر حال اگر قصد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.5,
   "end": 111.1,
   "text": "منزل اون شخص باشه و تا منزل اون شخص هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.1,
   "end": 114.68,
   "text": "مسافت شرعی باشه بله مسافر حساب میشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.68,
   "end": 117.64,
   "text": "اما بحث ما کشیده بود به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.64,
   "end": 120.92,
   "text": "قلب منافق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 120.92,
   "end": 122.48,
   "text": "گرفتاری‌مون زیاده آقا جان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 122.48,
   "end": 125.22,
   "text": "ببینید یه حدیث خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 125.22,
   "end": 130.04,
   "text": "عجیبی رو من از امام صادق صلوات الله علیه امروز حدیث نفس کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 130.04,
   "end": 134.92,
   "text": "از کتاب شریف مستدرک الوسائل، جلد یازده، صفحه سیصد و شصت و هفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 134.92,
   "end": 140.64,
   "text": "حضرت فرمودن که ان للمنافق اربع من علامات النفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 140.64,
   "end": 142.98,
   "text": "چهار تا علامت دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 142.98,
   "end": 146.12,
   "text": "منافقین. حالا ما تا بحث منافقین رو میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 146.12,
   "end": 149.46,
   "text": "همه دامن جمع می‌کنند که آره دیگه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 149.46,
   "end": 152.8,
   "text": "بری هستیم از این بحث و در صورتی که اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 152.8,
   "end": 155.2,
   "text": "اتفاقاً ماها بیشتر در معرض خطریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 155.2,
   "end": 161.2,
   "text": "حالا عرض می‌کنم. اولین نشونه فرمودن قساوة القلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 161.2,
   "end": 168.18,
   "text": "دلش سنگ میشه. بعد فرمودن و جمود العين چشمش خشک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.18,
   "end": 171.86,
   "text": "سومین نشونه فرمودن والاصرار علی الذنب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 171.86,
   "end": 175.56,
   "text": "اص-- هی اصرار بر گناه و معصیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 175.56,
   "end": 179.72,
   "text": "بر ذنب داره اصرار. این اصرار رو توجه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.72,
   "end": 185.02,
   "text": "چهارم فرمود والحرص على الدنيا حریص به دنیا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 185.02,
   "end": 187.48,
   "text": "هی حرص میزنه بر دنیاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 187.48,
   "end": 193.96,
   "text": "حالا اگر کسی دقت کرده باشه در آیین معارف، ذیل این چهار تا موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 193.96,
   "end": 197.22,
   "text": "متوجه میشه که اتفاقاً حکمت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.22,
   "end": 200.64,
   "text": "حدیث اینه که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 200.64,
   "end": 203.6,
   "text": "این از همون آخر به اول شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 203.6,
   "end": 205.8,
   "text": "یعنی چی؟ یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 205.8,
   "end": 209.18,
   "text": "نکته‌ای که آخر حضرت فرموده، این سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 209.18,
   "end": 210.84,
   "text": "از اونجا آغاز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 210.84,
   "end": 216.1,
   "text": "یعنی اگر کسی دچار طمع و حرص به دنیا شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 216.1,
   "end": 218.8,
   "text": "سپس اصرار به گناه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 218.8,
   "end": 222.18,
   "text": "یعنی شروع، نقطه‌ی انحراف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 222.18,
   "end": 225.7,
   "text": "نقطه‌ی شروع نفاق قلب، حرص به دنیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 225.7,
   "end": 228.78,
   "text": "که آدم به لذت‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 228.78,
   "end": 235.64,
   "text": "به هر حال اون متاع دنیوی و اینها دل ببنده و دل خوش کنه و دنبال اون‌ها باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 235.64,
   "end": 237.84,
   "text": "اگر کسی حرص به دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 237.84,
   "end": 240.18,
   "text": "داشت، چنین کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 240.18,
   "end": 242.82,
   "text": "دچار اصرار بر گناه میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 242.82,
   "end": 246.1,
   "text": "و اگر کسی اصرار بر گناه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.1,
   "end": 250.76,
   "text": "چشمش خشک میشه و خشکی چشم نشونه‌ی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 250.76,
   "end": 253.88,
   "text": "قساوة قلبه که قبلاً تو بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.88,
   "end": 257.7,
   "text": "قلب قسی فکر می‌کنم یه بیست جلسه‌ای بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 257.7,
   "end": 260.16,
   "text": "در هر حال این، ا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 260.16,
   "end": 263.66,
   "text": "خیلی تذکر به جایی‌ست برای حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 263.66,
   "end": 265.86,
   "text": "ماهایی که تو لباس دین هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 265.86,
   "end": 268.54,
   "text": "خطر اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 268.54,
   "end": 273.14,
   "text": "در موضوع نفاق اونجایی به اوج میرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 273.14,
   "end": 275.32,
   "text": "که و خطر جدی میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 275.32,
   "end": 277.34,
   "text": "که ما دین رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 277.34,
   "end": 281.56,
   "text": "لباس دین رو، هیئت و وجهه دین و مقدسات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 281.56,
   "end": 283.44,
   "text": "به خاطر دنیا اختیار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 283.44,
   "end": 286.62,
   "text": "این حتی بدتر و خطرناک‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 286.62,
   "end": 288.72,
   "text": "یعنی اینکه من خلوت کنم با خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 288.72,
   "end": 291.3,
   "text": "آقا شما که رفتی تو لباس پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 291.3,
   "end": 297.44,
   "text": "آخوند شدی که قدیم‌ها می‌گفتن آخوند یعنی آقا خوند، آقا اونو خونده یعنی امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 297.44,
   "end": 299.66,
   "text": "الان نبینید که تحقیر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 299.66,
   "end": 304.38,
   "text": "حالا آیا واقعاً تو به این سبب رفتی تو لباس دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 304.38,
   "end": 308.54,
   "text": "که ندای امام زمانت رو لبیک بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 308.54,
   "end": 311.32,
   "text": "شاگرد حضرت بشی؟ مرید حضرت بشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 311.32,
   "end": 315.0,
   "text": "پیرو حضرت یا اینکه نه، الان فعلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 315.0,
   "end": 321.68,
   "text": "نون تو این لباسه. آیا شما تو هیئت‌هات و این وجاهت، این وجهه دل و سجاده و تسبیح و ریش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 321.68,
   "end": 323.62,
   "text": "ولایت و چه می‌دونم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 323.62,
   "end": 326.32,
   "text": "آیا این‌ها به خاطر دنیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 326.32,
   "end": 329.12,
   "text": "یا نه؟ عشق و علاقه‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 329.12,
   "end": 332.38,
   "text": "و اون، ا، الگه‌های درونی‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 332.38,
   "end": 335.44,
   "text": "حالا هرچی که هست، نه به خاطر دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 335.44,
   "end": 338.34,
   "text": "این آدم به هر حال بل 인간 علی نفسه بصیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 338.34,
   "end": 341.84,
   "text": "این بصیرت رو قبلاً عرض کردیم و که بهتر خودشو می‌شناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 341.84,
   "end": 345.82,
   "text": "به شدت انسان نسبت به جان خودش و نفس خودش آگاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 345.82,
   "end": 348.08,
   "text": "در خلوت متوجه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 348.08,
   "end": 352.62,
   "text": "حالا باید مراقب بود حتی در عملیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 352.62,
   "end": 355.96,
   "text": "دینی و مذهبی‌مون ما قصدمون دنیا نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 355.96,
   "end": 359.12,
   "text": "این خیلی خطرناکه. من نمی‌دونم چی بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 359.12,
   "end": 364.76,
   "text": "دهان خودم بسته است. آدم وقتی توجه می‌کنه و ریز میشه تو کارهای خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 364.76,
   "end": 367.38,
   "text": "می‌بینه که خیلی در معرض خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 367.38,
   "end": 374.66,
   "text": "مگر خدا نجات بده. خدا رحمت کنه مرحوم حاج میرزا جواد آقای ملکی تبریزی، استاد از طهام رو دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 374.66,
   "end": 377.36,
   "text": "در عظمت ایشون زبان‌ها قاصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 377.36,
   "end": 379.9,
   "text": "چی بگم من؟ ایشون در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 379.9,
   "end": 385.8,
   "text": "احوالاتشون می‌خوندم که یه کتابی ایشون می‌نویسن خیلی خوب و قوی در یک موضوع علمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 385.8,
   "end": 390.3,
   "text": "تازه بحث علمی است، معرفتی است، عین حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 390.3,
   "end": 392.6,
   "text": "حرفی از دنیا اصلاً توش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 392.6,
   "end": 397.92,
   "text": "چنین کسی وقتی این کتاب رو می‌خونه-- می‌نویسه متوجه می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 397.92,
   "end": 404.76,
   "text": "مرحوم ملا محسن فیض کاشانی اعلا الله مقامه شریف هم تو همین موضوع کتاب خوبی نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 404.76,
   "end": 407.6,
   "text": "کتاب رو مطالعه می‌کنه و اصلاً کی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 407.6,
   "end": 408.92,
   "text": "من از شما سؤال کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 408.92,
   "end": 417.82,
   "text": "کی اصلاً تو امروزه خود ماها کی یه همچین نگاه‌هایی داریم به عملیات عبادتمون، در کتاب نوشتنمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 417.82,
   "end": 424.7,
   "text": "به هر حال ایشون کـ-وقتی کتاب رو مطالعه می‌کنه شک می‌کنه که بالاخره کتاب خودش قوی‌تره یا اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 424.7,
   "end": 427.2,
   "text": "توسل می‌کنه به امام صادق صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 427.2,
   "end": 431.5,
   "text": "روزه می‌گیره. اون اعمال خاصی رو که یک بخشیش رو مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 431.5,
   "end": 436.0,
   "text": "شیخ عباس قمی رحمة الله علیه در مفاتیح الجنان آورده که انسان بتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 436.0,
   "end": 437.94,
   "text": "معصوم رو ببینه چه شرایطی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 437.94,
   "end": 441.06,
   "text": "لباس متحر، بستر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 441.06,
   "end": 443.68,
   "text": "با طهارت، وجود طاهر این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 443.68,
   "end": 448.36,
   "text": "و اون اذکار خاصی که حالا هزار تا قل و قلو چه و چه اینا رو می‌خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 448.36,
   "end": 452.56,
   "text": "و می‌بینه. مجربه. ایشون امام صادق صلوات الله علیه رو با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 452.56,
   "end": 455.16,
   "text": "اعمال خاصی که داشتن انجام میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 455.16,
   "end": 458.6,
   "text": "زیارت می‌کنند در عالم رؤیای صادقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 458.6,
   "end": 461.84,
   "text": "از حضرت سؤال می‌کنند که آقا جان کتاب من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 461.84,
   "end": 466.88,
   "text": "در این موضوع علمی کامل‌تره یا کتاب حاج ملا محسن فیض رحمة الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 466.88,
   "end": 469.56,
   "text": "امام صادق صلوات الله علیه به یکباره سکوت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 469.56,
   "end": 473.18,
   "text": "حالا اینم درش نکاتی هست، این سکوت حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 473.18,
   "end": 476.38,
   "text": "به هر حال ایشون اصرار می‌کنند که آقا جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 476.38,
   "end": 479.58,
   "text": "مثل شمایی سائل رو محروم نمی‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 479.58,
   "end": 484.06,
   "text": "حضرت تو یه جمله می‌فرمایند که کتاب ملا محسن کامل‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 484.06,
   "end": 486.88,
   "text": "همین تمام. وقتی ایشون از اون حالت میاد بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 486.88,
   "end": 489.4,
   "text": "کتاب خودش رو محو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 489.4,
   "end": 494.92,
   "text": "آخه من نمی‌دونم چی بگم در قبال این، همین یک حرکت این عارف و این واصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 494.92,
   "end": 501.42,
   "text": "و این عالم و آگاه. چی بگیم ما الان به قول علامه جوادی آملی حفظه الله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 501.42,
   "end": 507.82,
   "text": "می‌فرمودند که از یک میلیون نفر آدم یه نفر شاید حاضر باشه اسمش تو کتابش ثبت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 507.82,
   "end": 510.3,
   "text": "واقعاً فقط برای خدا نوشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 510.3,
   "end": 514.2,
   "text": "اینکه حالا حتی بحث علمیش، بحث معرفتش اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 514.2,
   "end": 519.26,
   "text": "مطلقاً دنیا رو در نظر نداشته باشه کار هر کسی نیست عزیزان دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 519.26,
   "end": 523.0,
   "text": "خلاصه هممون در معرض، معرض خطریم و کار می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 523.0,
   "end": 528.62,
   "text": "باید کار کنیم. ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}