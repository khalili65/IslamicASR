 "chapters": [
  {
   "index": 0,
   "title": "## استفتا؛ خشکشویی و طهارت لباس و فرش",
   "start": 12.38,
   "end": 149.74
  },
  {
   "index": 1,
   "title": "## اثر وضعی و بحث عرفانی؛ حسنات الابرار",
   "start": 149.74,
   "end": 288.6
  },
  {
   "index": 2,
   "title": "هندسهٔ جهنم از بالا به پایین است؛ درک و درکات. بهشت از پایین به بالاست؛ درجات. دربارهٔ منافق آیه است:",
   "start": 288.6,
   "end": 310.8
  },
  {
   "index": 3,
   "title": "## نفاق اعتقادی؛ شدیدترین وجه",
   "start": 310.8,
   "end": 424.83
  },
  {
   "index": 4,
   "title": "## نفاق اخلاقی؛ اضافه بر خشوع",
   "start": 424.83,
   "end": 444.93
  },
  {
   "index": 5,
   "title": "## نفاق رفتاری؛ جلوت و خلوت",
   "start": 444.93,
   "end": 540.45
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.98,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.98,
   "end": 12.16,
   "text": "السلام علیک یا داعی الله و ربانی ایه آیه سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.16,
   "end": 21.16,
   "text": "خب شب سال نو داره میاد و معمولا فرش‌ها و پتوها و یه سری البسه اینا داده میشه به خشکشویی برای شستشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 21.16,
   "end": 24.38,
   "text": "حالا چه کنیم؟ اونجا خب آدمایی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.38,
   "end": 26.66,
   "text": "لباس میدن، فرش میدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.66,
   "end": 29.96,
   "text": "پتو میدن که اینا اصلا مسلمون نیستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.96,
   "end": 35.32,
   "text": "یا اصلاً اینا فرش‌شون نجس باشه، لباس‌هاشون نجس باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.32,
   "end": 38.6,
   "text": "فرش و لباس ما میره قاطی اونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.6,
   "end": 41.62,
   "text": "شستشو میشه میاد، این چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.62,
   "end": 44.02,
   "text": "آیا چه باید کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.02,
   "end": 48.32,
   "text": "اینا بالاخره طهارتش قطعیه، مشکوکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.32,
   "end": 55.02,
   "text": "چه کنیم؟ آقا فرمودن، رهبر عزیز فرمودن که اگر اون لباسو حالا هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.02,
   "end": 60.24,
   "text": "پتو یا فرشی که تو دادی که بشورن، اگر مال خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.24,
   "end": 67.42,
   "text": "چی بوده؟ نجس بوده. اگه مال خودت نجس بوده وظیفته که به اون کسی که داری میدی بشوره بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.42,
   "end": 71.44,
   "text": "بگی که آقا این نجسه شستشو شرعی انجام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.44,
   "end": 78.88,
   "text": "اگر تو بدونی که اون کسی که چون بعضی از اینا با مواد شوینده حتی بخارشویی می‌کنن، اصلا آب نمیزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.88,
   "end": 81.18,
   "text": "یعنی مواد شیمیایی میزنن، آب نمیزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.18,
   "end": 84.82,
   "text": "بخارشویی می‌کنن، آب مطلق نمیزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.82,
   "end": 87.4,
   "text": "این‌ها رو باید بدونه آدم به کی میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.4,
   "end": 92.4,
   "text": "این وظیفه ماست اول. اگر مال خودمون نجسه، می‌دونیم مال خودمون نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.4,
   "end": 95.0,
   "text": "باید بگیم که آقا این نجسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.0,
   "end": 97.56,
   "text": "شما شستشو شرعی کن تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.56,
   "end": 100.12,
   "text": "اگر اینطور بود مشکل حله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.12,
   "end": 103.84,
   "text": "توجه کردید؟ حالا اگر اون مال خودت پاکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.84,
   "end": 109.04,
   "text": "دیگه نیاز نداره بری تجف– تفس– تفحص کنی، تجسس کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.04,
   "end": 111.94,
   "text": "سؤال و جواب کنی، بری نمیدونم کارخونه طرفو برانداز کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.94,
   "end": 114.76,
   "text": "نه، گفتن اصلا تو اینجا وظیفه‌ای نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.76,
   "end": 122.72,
   "text": "همین که مال خودت پاکه، ولو این رد خیلی جالبه که آقا می‌فرمود ولو اگه بدونی اونجایی که دارن میشورن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.72,
   "end": 125.84,
   "text": "شستشو شرعی نمی‌کنن. یعنی حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.84,
   "end": 128.16,
   "text": "با مواد شوینده میشورن. مال تو پاک بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.16,
   "end": 133.18,
   "text": "چه کار داری به مال دیگران؟ همین که مال تو پاک بوده و دادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.18,
   "end": 137.98,
   "text": "دیگه مطلقاً دیگه باید بذاری به اصل طهارت و بگی ان شا الله پاکه تموم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.98,
   "end": 143.2,
   "text": "دیگه نمیخواد بری بگی آقا اون فرشی که از کسی دیگه گرفتی شاید نجس بود به تو چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.2,
   "end": 146.06,
   "text": "تو وظیفه خودتو انجام بده تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.06,
   "end": 149.74,
   "text": "سخت نگیر تو این چیزا. جانم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.74,
   "end": 151.44,
   "text": "اثر وضعیش چی میشه بعد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.44,
   "end": 154.76,
   "text": "آها. اون اثر بعضی بحث‌های عرفانیه قضیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.76,
   "end": 158.74,
   "text": "بحث شرعی نیست. [سخنگوی 1] تأثیر داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.74,
   "end": 162.02,
   "text": "بله تاثیر داره. اون تو بحث طهارت یه روز ما اینجا عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.02,
   "end": 165.8,
   "text": "حتی حالشون فرمودن که اثر وضعیش، خب این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.8,
   "end": 168.48,
   "text": "ما یه بحث شرعی داریم، قانون دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.48,
   "end": 172.28,
   "text": "آقا هرکی این کارو بکنه قانون دین رو انجام داده جهنمی نمیشه بهشتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.28,
   "end": 174.38,
   "text": "اما درجه‌هات داره بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.38,
   "end": 177.38,
   "text": "همونطور که جهنم درکات داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.38,
   "end": 179.02,
   "text": "بهشت هم درجه‌هات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.02,
   "end": 181.16,
   "text": "بزرگان اهل معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.16,
   "end": 187.76,
   "text": "حالا ایشون فرمودن، می‌فرمایند که حتی اگه لباسی نجس بشه، تو بحث طهارت نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.76,
   "end": 190.02,
   "text": "لباسی نجس بشه شما بری پاکش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.02,
   "end": 191.62,
   "text": "فرشی نجس بشه پاکش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.62,
   "end": 194.78,
   "text": "شستشو شرعی بدی رو همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.78,
   "end": 199.62,
   "text": "فرش نماز بخونی، رو همون لباسی که نجس شد پاکش کردی روش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 199.62,
   "end": 204.82,
   "text": "نماز خوندی با همون بری نماز بخونی یا مثلاً بری زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.82,
   "end": 209.28,
   "text": "اون تمثلات معنوی و عرفانی برات رخ نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.28,
   "end": 213.9,
   "text": "چون یه بار این نجس شده به خباثت افتاده دوباره پاک شده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.9,
   "end": 218.16,
   "text": "اینا دیگه مسائل معنوی خیلی دقیق و ظریف و لطیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.16,
   "end": 219.8,
   "text": "لطائف و ذرائف کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.8,
   "end": 222.96,
   "text": "دقایق کاره. مال کار معن-- عرفانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 222.96,
   "end": 225.08,
   "text": "کسی می‌خواد خیلی رشد کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 225.08,
   "end": 230.3,
   "text": "حدیثش چیه؟ حسنات الأبرار سیئات المقربین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.3,
   "end": 233.54,
   "text": "نیکی‌های آدم‌های خوب برای اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.54,
   "end": 238.66,
   "text": "اونایی که مثلا خیلی مقرب میخوان بشن ثواب بگیرن این گناه حساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.66,
   "end": 242.42,
   "text": "من آخوند برم سر خیابون وایسم بستنی نیک بزنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 242.42,
   "end": 244.46,
   "text": "گناهه اصلا. گناهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.46,
   "end": 247.06,
   "text": "ولی یه کس دیگه نه چه گناهی داره براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 247.06,
   "end": 253.34,
   "text": "توجه کردی کسی که بخواد بیشتر رشد کنه بله، این‌ها رو باید لحاظ کنه که حالا تو بحث‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.34,
   "end": 255.64,
   "text": "عرفانیه قضیه اینا باید پیش گرفته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.64,
   "end": 259.2,
   "text": "ما بحث شرعی رو گفتیم. بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 259.2,
   "end": 263.1,
   "text": "درکات شد خب بذار از همین جا استفاده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.1,
   "end": 266.96,
   "text": "خب همونطور که میدونید هندسه جهنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.96,
   "end": 270.68,
   "text": "از بالا به پایینه، عمقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.68,
   "end": 274.4,
   "text": "درک، درکات، جهنم درکات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.4,
   "end": 276.52,
   "text": "بهشت هندسه‌ش پایین به بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.52,
   "end": 280.04,
   "text": "درجات داره. اون درجاته، این درکات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 280.04,
   "end": 284.6,
   "text": "منافق یه آیه درباره‌ش داریم که می‌فرماید ان المنافقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.6,
   "end": 287.44,
   "text": "في الدرک الاسفل من النار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 287.44,
   "end": 292.12,
   "text": "عجب! یعنی در عمیق‌ترین، پست‌ترین جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 292.12,
   "end": 294.4,
   "text": "جهنم جا میدن این‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 294.4,
   "end": 298.16,
   "text": "حالا منافق که ما داریم میگیم قلب منافق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 298.16,
   "end": 302.12,
   "text": "آیا منافق صرفاً فقط همینه که تو پست‌ترین جا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 302.12,
   "end": 306.08,
   "text": "یعنی میشه انسان خب مسلمون باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 306.08,
   "end": 312.12,
   "text": "عرض شود شیعه، سنّت، تشیع باشه، بچه ولایتی و هیئتی و مسجدی هم باشه اما نفاق داشته باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 312.12,
   "end": 314.24,
   "text": "میشه اصلاً؟ این باید تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.24,
   "end": 317.2,
   "text": "سه حوزه بحث بشه. نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.2,
   "end": 319.04,
   "text": "تو سه حوزه باید بررسی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.04,
   "end": 323.34,
   "text": "یا اعتقادیه که این اعتقادیه شدیدترین وجهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 323.34,
   "end": 326.42,
   "text": "اون في الدرک الاسفل مال ایناست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 326.42,
   "end": 329.4,
   "text": "که اصلاً اعتقاد نداره به زبان جاری میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 329.4,
   "end": 332.68,
   "text": "این منافق محضه، مطلقاً منافقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 332.68,
   "end": 334.94,
   "text": "مثل کسی که اصلاً قبول نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 334.94,
   "end": 337.06,
   "text": "خدا رو الکی لباس پ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 337.06,
   "end": 339.28,
   "text": "مثلاً اسلام پوشیده اومده تو مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 339.28,
   "end": 342.48,
   "text": "نفوذیه این. می‌خواد اطلاعات جمع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 342.48,
   "end": 345.72,
   "text": "این دیگه اون پست‌ترین نوع نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 345.72,
   "end": 348.62,
   "text": "یا حالا شاید یه پله پایین‌ترش کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 348.62,
   "end": 353.88,
   "text": "یا چند پله بهتره بگیم پایین‌ترش کسایی که اصلاً به بعضی از اصول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 353.88,
   "end": 361.4,
   "text": "اعتقادی مثلاً پایبند نیستن برای اینکه یک اداره‌ای استخدام شن تو گزینشش که میرن هاجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 361.4,
   "end": 364.71,
   "text": "شما اصل ولایت فقیه بلبل صحبت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 364.71,
   "end": 367.09,
   "text": "اصل ولایت فقیه جانم به فداش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 367.09,
   "end": 369.07,
   "text": "شروع می‌کنه. بخواد چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 369.07,
   "end": 372.59,
   "text": "استخدام شه. خب اینم یه خط نفاق اعتقادیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 372.59,
   "end": 377.41,
   "text": "خیلی هم خطرناکه ها. اما مثل دیگه اون نیرو نفوزی و اون طوریه با اون شدت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 377.41,
   "end": 384.15,
   "text": "اما اینم نفاقه. خطرتا-- خطرناک‌ترین نوع نفاق، نفاق اعتقادیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 384.15,
   "end": 385.99,
   "text": "خیلی از مسئولین و مدیران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 385.99,
   "end": 393.93,
   "text": "کلان مملکت ما که زاویه می‌گیرن با نظام، با ارزش‌های نظام، با رهبری، با ولایت فقیه، با اصل امام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 393.93,
   "end": 398.11,
   "text": "اصول و ارزش‌های شهدا و امام و شهادت و چه می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 398.11,
   "end": 400.81,
   "text": "اینا گرفتار نفاق اعتقادی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 400.81,
   "end": 406.07,
   "text": "از بدترین نوع نفاقم هست و به شدت خدا از اینا متنفره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 406.07,
   "end": 411.59,
   "text": "لذا برای کسی هم تو زندگیشون، تو کاراشون دست به هر کاری می‌زنن خرابکاری می‌شه بدتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 411.59,
   "end": 413.61,
   "text": "به جای اصلاح خراب می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 413.61,
   "end": 417.99,
   "text": "هیچ خیری ازشون سر نمی‌زنه چون بدترین نوع نفاق رو دارن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 417.99,
   "end": 421.35,
   "text": "حالا خیلی ما متوقف نشیم وقت نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 421.35,
   "end": 423.59,
   "text": "دیگه پژوهش و تحقیقش با خودتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 423.59,
   "end": 426.09,
   "text": "دومین نوع نفاق، نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 426.09,
   "end": 431.29,
   "text": "اخلاقی‌ست. یعنی کسی مثلا آدم خاشعی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 431.29,
   "end": 434.51,
   "text": "قلبش واقعاً خشوع آنچنانی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 434.51,
   "end": 438.89,
   "text": "موقع نماز یه جوری نماز می‌خونه می‌گه بابا این الان تو عرش معلاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 438.89,
   "end": 440.87,
   "text": "اینم اصلاً حدیث داریم براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 440.87,
   "end": 442.47,
   "text": "که حالا بعداً این‌ها رو بررس می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 442.47,
   "end": 447.05,
   "text": "فعلاً دسته‌بندی بکنیم که پیغمبر فرمودن که هر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 447.05,
   "end": 453.97,
   "text": "هر اضافه‌ای از خشوع قلبت تو نماز هر اضافه‌ای مضمون حدیث اینو حالا بعد اصلشو بعداً می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 453.97,
   "end": 457.99,
   "text": "تو نماز هر اضافه‌ای از اصل خشوع قلبت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 457.99,
   "end": 463.65,
   "text": "چقدر قلبت خاشعه، چقدر حاضره، هر چقدر اضافه داری نشون میدی اون نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 463.65,
   "end": 466.49,
   "text": "مثلاً کله‌شو کج کرده، دستشو گرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 466.49,
   "end": 472.71,
   "text": "قنوت. تو الان میگی این الان در محضر خدا اما کله‌شو جلو مدیرش کج کرده تو خیالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 472.71,
   "end": 475.63,
   "text": "اصلاً ذهنش جای دیگه هست. توجه کردین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 475.63,
   "end": 477.87,
   "text": "این نفاقه، این نفاق اخلاقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 477.87,
   "end": 483.99,
   "text": "باید خیلی مراقب باشیم. سومین نفاقم نفاق رفتاری یا عملیاتی بهش میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 483.99,
   "end": 489.07,
   "text": "یعنی اینکه کسی در خلوت آدم علیه السلامه، مقدسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.07,
   "end": 492.43,
   "text": "ببخشید در جلوت، در بین مردم، در انظار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 492.43,
   "end": 495.39,
   "text": "آدم خوبیه، مقدسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 495.39,
   "end": 499.29,
   "text": "مثل من. واعظان کین جلوه در محراب و منبر می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 499.29,
   "end": 500.89,
   "text": "چه سرتو تکون می‌دی آقای زند دل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 500.89,
   "end": 505.55,
   "text": "تایید می‌کنه چون به خلوت می‌روند آن کار دیگر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 505.55,
   "end": 509.31,
   "text": "چی دیدی از ما؟ می‌رن تو خلوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 509.31,
   "end": 513.41,
   "text": "این نفاق رفتاریه. خلوتشون اصلاً قابل قیاس با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 513.41,
   "end": 516.27,
   "text": "جلوتشون نیست. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 516.27,
   "end": 518.39,
   "text": "این آهاان آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 518.39,
   "end": 521.09,
   "text": "امروز نهضت نخود خورونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 521.09,
   "end": 524.03,
   "text": "و روضه حضرت مسلم بخونیم امروز ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 524.03,
   "end": 526.83,
   "text": "بله. پس دیگه تمام دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 526.83,
   "end": 538.49,
   "text": "بحث تمام. انشاالله عاقبتمون ختم بخیر بشه و برکت صلوات در محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 538.49,
   "end": 540.45,
   "text": "صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}