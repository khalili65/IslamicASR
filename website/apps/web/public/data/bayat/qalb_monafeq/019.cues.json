 "chapters": [
  {
   "index": 0,
   "title": "## شهرهای متصل؛ حکم مسافر و حد ترخص",
   "start": 1.2,
   "end": 96.68
  },
  {
   "index": 1,
   "title": "## آیهٔ تربص؛ منافق دورو در نساء",
   "start": 96.68,
   "end": 223.96
  },
  {
   "index": 2,
   "title": "## تربص؛ فرصت‌طلبی منافق",
   "start": 223.96,
   "end": 342.02
  },
  {
   "index": 3,
   "title": "## خلوص سلمان؛ بهشت من تویی",
   "start": 342.02,
   "end": 429.84
  },
  {
   "index": 4,
   "title": "## چرا امام رضا به ایران آمد؛ پاسخ خلوص سلمان",
   "start": 429.84,
   "end": 550.38
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.2,
   "end": 4.18,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.18,
   "end": 8.94,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.94,
   "end": 12.06,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.06,
   "end": 18.14,
   "text": "استفتا شده از رهبر عزیزمون که گاهی اوقات شهرها به قدری به هم نزدیکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.14,
   "end": 22.16,
   "text": "که به محض اینکه از این شهر خارج میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.16,
   "end": 24.52,
   "text": "مد-- یه مقداری میری جلوتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.52,
   "end": 27.3,
   "text": "بلافاصله وارد شهر بعدی میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.3,
   "end": 33.6,
   "text": "ما در خ-خصوص احکام مسافر و اینا داریم حرف می‌زنیم، مسافت شرعی و حد ترخص و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.6,
   "end": 39.3,
   "text": "استفساراتش. یا گاهی اوقات اصلاً شهرها به گونه‌ای میشه از این شهر خارج شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.3,
   "end": 42.7,
   "text": "ولی وسط بین این شهر و شهر بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.7,
   "end": 46.74,
   "text": "چنان خونه ساخته شده و آباد شده، اینطوری نیست که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.74,
   "end": 49.64,
   "text": "مشخص باشه اصلاً از این شهر خارج شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.64,
   "end": 54.0,
   "text": "وارد شهر دیگه شدی. اصلاً انگار این دو تا شهر به هم متصل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.0,
   "end": 56.5,
   "text": "بینشم هم توی خونه ساختن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.5,
   "end": 59.6,
   "text": "چه باید کرد اینجا؟ آقا فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.6,
   "end": 65.74,
   "text": "با این شرط فرضی که شما فرمودید که خیلی این دو شهر به هم نزدیک‌اند یا بینش به گونه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.74,
   "end": 69.78,
   "text": "عملیات عمرانی انجام شده که از کلاً این دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.78,
   "end": 73.32,
   "text": "یه شهر حساب میشن. رهبری فرمودن از جهت فقهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.32,
   "end": 77.04,
   "text": "این‌ها دو محل از یک شهر حساب میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.04,
   "end": 81.12,
   "text": "مثل مثالش چیه؟ همه فهمش مثل تهران و شهرری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.12,
   "end": 86.0,
   "text": "اینا دیگه یه جوری شدن، شدن دو تا محل از یه شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.0,
   "end": 89.86,
   "text": "یعنی ص-- الان کسی شهر ری رو جدای از تهران فرض نمیکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.86,
   "end": 93.22,
   "text": "اینطور شد یا شمیرانات رو از تهران جدا نمیدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.22,
   "end": 95.06,
   "text": "این‌ها ج-- حکم یک شهر رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.06,
   "end": 101.92,
   "text": "حواستون باشه. در آیه صد و چهل و یک نساء سوره نساء، این نکته امروز رو خوب گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.92,
   "end": 107.42,
   "text": "خوب به دردمون میخوره. مخصوصاً به درد ام-امثال من که تو لباس دین هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.42,
   "end": 111.64,
   "text": "حواسمون جمع باشه. ما در خصوص انحرافات قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.64,
   "end": 115.64,
   "text": "و سر خوردن به سمت نفاق داریم نکاتی رو از قرآن برداشت میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.64,
   "end": 122.04,
   "text": "\"الذین یتربصون بکم فإن کان لکم فتح من الله قالوا ألم نکن معکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.04,
   "end": 125.12,
   "text": "اینایی که قلبشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.12,
   "end": 129.02,
   "text": "منافق و دو روست، یه خصوصیتشون تو این آیه اینچنین فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.02,
   "end": 132.26,
   "text": "میگه \"يتربصون بکم\" اینا مراقب شمااند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.26,
   "end": 134.5,
   "text": "مراقب شما اهل ایمان‌اند. که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.5,
   "end": 141.44,
   "text": "\"فإن کان لکم فتح من الله\" وقتی خدا برای شما فتح و نصرت و گشایشی ایجاد میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.44,
   "end": 145.4,
   "text": "\"قالوا\" میگن که \"ألم نکن معکم\" آیا ما با شما نبودیم و نیستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.4,
   "end": 148.28,
   "text": "اصلاً ما با شماییم. ما اصلاً با-- از شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.28,
   "end": 151.24,
   "text": "به محض اینکه سفره چرب میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.24,
   "end": 157.66,
   "text": "یه بالاخره عنایتی میشه، فتح و نصرتی رخ میده با ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.66,
   "end": 160.2,
   "text": "این‌ها با ما خود-- اصلاً تو دلمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.2,
   "end": 165.5,
   "text": "\"وإن كان للكافرين نصيب قالوا ألم نتحوز-- نح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.5,
   "end": 170.54,
   "text": "نستحوذ عليكم\" وقتی که برای کافرین نصيبی ایجاد میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.54,
   "end": 177.28,
   "text": "میگن آیا ما نبودیم که اسرار مسلمونا رو به شما گفتیم \"ونمنعکم من المؤمنين\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.28,
   "end": 181.34,
   "text": "و ما منفعت به شما دادیم از طرف مؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.34,
   "end": 183.78,
   "text": "ما بودیم اصلاً این کارو ایجاد کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.78,
   "end": 186.68,
   "text": "ما کمک حال شما بودیم که شما به جایی برسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.68,
   "end": 192.38,
   "text": "\"فالله يحكم\". انقدر کار دشوار میشه که خیلی نکته‌ست، انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.38,
   "end": 199.32,
   "text": "امر مشتبه میشه که هرکی نگاه کنه میگه بابا این اصلاً علیه السلام بهش بگو التماس دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.32,
   "end": 201.44,
   "text": "دیگه انقدر کار دشوار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.44,
   "end": 204.32,
   "text": "اینا انقدر تو لباس دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.32,
   "end": 206.7,
   "text": "و عرض شود توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.7,
   "end": 212.46,
   "text": "ااا هیئت و کسوت دین میان جلو که میگه کار فقط با خداست دیگه اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.46,
   "end": 216.7,
   "text": "چطور؟ می فرماید \"فالله يحكم بينكم يوم القيامة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.7,
   "end": 219.36,
   "text": "خداست که حکو-- بین شما حکم میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.36,
   "end": 221.22,
   "text": "چون انقدر امر مشتبه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.22,
   "end": 223.7,
   "text": "اصلاً به سختی میشه تشخیص داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.7,
   "end": 225.98,
   "text": "حالا نکته اینجاست، نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.98,
   "end": 231.02,
   "text": "تو \"تربص\" هست. یعنی اون مراقبت، اینکه طرف سودجویی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.02,
   "end": 235.34,
   "text": "یکی از خصوصیت‌های منافق فرصت‌طلبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.34,
   "end": 240.42,
   "text": "هر طرف که فرصت براش ایجاب کنه و اونجا سود ببره اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.42,
   "end": 243.56,
   "text": "اگر تو دامن آمریکا سود ببره اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.56,
   "end": 245.7,
   "text": "اصلاً کاری به ارزش‌های نظام نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.7,
   "end": 249.52,
   "text": "کاری به سیصد هزار خون شهید ریخته شده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.52,
   "end": 252.54,
   "text": "کاری با آه دل پدر مادرای شهدا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.54,
   "end": 254.24,
   "text": "اگر سودش اونجاست، اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.24,
   "end": 257.68,
   "text": "اگر سودش با ملت بودنه، با ملته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.68,
   "end": 260.3,
   "text": "هر کجا که میبینی سود میبره میره به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.3,
   "end": 262.76,
   "text": "اصلاً اومده تو لباس دین برای دنیاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.76,
   "end": 268.08,
   "text": "این نکته‌ست. این نکته‌ایه که عرض کردم خیلی به درد امثال من میخوره مراقب باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.08,
   "end": 270.24,
   "text": "خدا وکیلی در خلوتم خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.24,
   "end": 273.06,
   "text": "در وجود خودم \"وليتلقف\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.06,
   "end": 276.32,
   "text": "تلطیف سر کنم، برم تو وجود خودم بررسی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 276.32,
   "end": 282.8,
   "text": "آیا واقعاً من به خاطر فرصت‌طلبی و سودجویی و دنیام اومدم تو کسوت دین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.8,
   "end": 285.38,
   "text": "هیئت دین رو به خودم گرفتم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.38,
   "end": 288.7,
   "text": "یا نه عاشق بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.7,
   "end": 291.32,
   "text": "این‌ها رو ببینید الان اینایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.32,
   "end": 298.36,
   "text": "سر تعظیم فرود میارن جلوی آمریکا و انگلیس و چه میدوننم این قدرت‌های خارجی از اون طرف میگن آقا ما با شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 298.36,
   "end": 300.56,
   "text": "چراغ سبز بهشون میدن که نفوذ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.56,
   "end": 303.38,
   "text": "تو مملکت رخ داده دیگه. و الا نفوذ چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.38,
   "end": 310.18,
   "text": "از این طرفم چنان تیپ اصلاح‌طلبی و مصلح‌گونه به خودشون میگیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.18,
   "end": 317.06,
   "text": "تو جمع ملت. گمان-- ملت گمان می‌کنند اگه این آقا نبود، اگه این گروه نبودن اصلاً دیگه مملکت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.06,
   "end": 318.22,
   "text": "واد فنا رفته بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.22,
   "end": 321.38,
   "text": "الان تقسیم اراضی شده بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.38,
   "end": 324.64,
   "text": "این چه-- این دقیقاً خصلت منافقانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.64,
   "end": 329.04,
   "text": "دقیقاً این‌ها اگه بری تو دلشون میبینی فقط به خاطر دنیا اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.04,
   "end": 333.26,
   "text": "اگر حکومت اسلامی ما الان نبود، یه حکومت دیگه‌ای بود، اصلاً اینا ج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.26,
   "end": 337.04,
   "text": "لباس دین رو کنار میذاشتن و تو هیئت اونا در میآوردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.04,
   "end": 341.34,
   "text": "در میومدن. کما اینکه الان با اون‌هان در خارج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.34,
   "end": 347.34,
   "text": "شما ببینید در میان اولیاء خدا چه کسی خلوص سلمان رو داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.34,
   "end": 350.9,
   "text": "سلمان-- الان ببینید آخر کار ما کجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.9,
   "end": 354.58,
   "text": "آیا همه ما عاشق نیستیم بریم بهترین جای بهشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.58,
   "end": 357.18,
   "text": "خدا وکیلی دیگه. دوست داریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.18,
   "end": 360.3,
   "text": "تعارف که نداریم که. هممون دوست داریم بریم بهترین جای بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.3,
   "end": 362.4,
   "text": "هرکی هم بگه نه چاخان گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 362.4,
   "end": 368.46,
   "text": "من میگم چاخان گفته سلمان و امیرالمؤمنین دو تا انگشتش رو باز کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.46,
   "end": 375.74,
   "text": "اونم ده تا درجه ایمان رو به یکباره برداشته سلمان منا اهل البیت شده و همه علوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.74,
   "end": 380.84,
   "text": "اهل بیت رو به یکباره در صراط اطلاقی یعنی بیقیدی و بی تعینی بی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.84,
   "end": 385.98,
   "text": "بدون حدود همه رو به یکباره اخذ کرده معارف سینه مولا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 385.98,
   "end": 390.84,
   "text": "یه همچین مقامی رسیده. حالا ببینید چی باید خدا اونور براش آماده کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.84,
   "end": 393.18,
   "text": "پرده میره کنار میگه سلمان نگاه کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 393.18,
   "end": 397.26,
   "text": "از لا انگشتای مولا جایگاه خودشو در بهشت میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.26,
   "end": 399.14,
   "text": "الله اکبر من و تو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 399.14,
   "end": 401.06,
   "text": "بعد مولا فرمود میخوای بری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.06,
   "end": 404.42,
   "text": "میخوای بری بسم الله. خود وکیلی من و شما باشیم چی میگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.42,
   "end": 407.12,
   "text": "قید علی رو میزنیم یا نه؟ میگیم بریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 407.12,
   "end": 410.22,
   "text": "اصلاً ما با امیرالمؤمنین بودیم برای این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 410.22,
   "end": 412.54,
   "text": "، ما برای این با مولا بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.54,
   "end": 415.44,
   "text": "حتی سود اخروی‌ش هم در نظر نمیگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.44,
   "end": 418.98,
   "text": "به گریه میفته. جمله رو ببینید تو قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.98,
   "end": 421.76,
   "text": "عرض میکنه علی جان بهشت من تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 421.76,
   "end": 424.52,
   "text": "من هر جا، کجا که تو باشی دوست دارم اونجا باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 424.52,
   "end": 427.2,
   "text": "بهشتو میخوام چه کنم؟ عشق من تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 427.2,
   "end": 436.3,
   "text": "میبینید به اینجا میرسه. حالا یه نکته‌ای بگم سربسته اینو خواهشا هر جایی خرجش نکنید چون به سختی به من رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.3,
   "end": 440.32,
   "text": "به هر حال برکت بعضا حالا رسیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 440.32,
   "end": 446.78,
   "text": "محضر از علامه حسن زاده خیلی کوچولو و کوتاه اما این رو هر جایی هم شما نگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.78,
   "end": 451.16,
   "text": "انقدر خوب امروز دل دارید و دارید گوش میدید من امروز خرجش می‌کنم که ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 451.16,
   "end": 455.88,
   "text": "خود علامه فرمان که من خیلی دوست داشتم بدونم چرا امام رضا اومد ایران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 455.88,
   "end": 461.08,
   "text": "ببینید بحث‌های سیاسی رو بذار کنار که آره مأمون مجبور کرد آقا رو بحث سیاسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 461.08,
   "end": 463.34,
   "text": "بیای ولایت عهدی منو بگیری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 463.34,
   "end": 467.86,
   "text": "اینا کنار ها. اصلاً ته قضیه تو دل امام رضا چی میگذره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.86,
   "end": 471.24,
   "text": "امام رضا شما چرا اومدی ایران؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 471.24,
   "end": 473.62,
   "text": "تو رو خدا ببین بعضا دنبال چی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 473.62,
   "end": 476.12,
   "text": "علامه حسن زاده میگه به حرم ام--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 476.12,
   "end": 479.4,
   "text": "آقا علی ابن موسی الرضا رفتم توسل کردم، خلوت کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 479.4,
   "end": 482.5,
   "text": "و از امام رضا این سؤال رو پرسیدم آقا جواب داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 482.5,
   "end": 485.46,
   "text": "حالا اینکه چگونه جواب داد اینا بحث‌ها داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 485.46,
   "end": 491.5,
   "text": "امام رضا فرموده بودند میخواید حسن جان میخواید دل منو بدونی چرا اومدم ایران؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 491.5,
   "end": 493.5,
   "text": "پیغمبر به من دستور داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 493.5,
   "end": 499.8,
   "text": "فرمود رضا جان پاشو برو ایران جواب خلوص و زحمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 499.8,
   "end": 502.98,
   "text": "سلمان، محبت سلمان رو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.98,
   "end": 508.56,
   "text": "سلمان مال ما بوده دیگه. انقدر سلمان خلوصش محض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 508.56,
   "end": 510.72,
   "text": "اسلام و اخلاص بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 510.72,
   "end": 517.56,
   "text": "انقدر بی‌خطشه بود پ-- دویست سال حدود، به حدود دویست سال بین پیغمبر و امام رضا فاصله‌ست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.56,
   "end": 521.9,
   "text": "نسل هشتم آقاست. بعد دویست سال میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 521.9,
   "end": 525.56,
   "text": "يا امام رضا شما مأموری بری جواب سلمانو بدی بیای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 525.56,
   "end": 530.68,
   "text": "ببینید تو رو قرآن اگر کسی الان برای اهل بیت خالصانه عمل کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.68,
   "end": 535.78,
   "text": "شده الان نه، تو نسل بعدت، تو نسل‌های بعدت خود امام عصر جبران میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 535.78,
   "end": 538.22,
   "text": "تو کارتو انجام بده، تو نوکریتو بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 538.22,
   "end": 542.58,
   "text": "انشاالله عاقبت بخیر بشیم به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 542.58,
   "end": 546.86,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 546.86,
   "end": 550.38,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}