 "chapters": [
  {
   "index": 0,
   "title": "## کفش چرم نجس و اصل طهارت",
   "start": 10.88,
   "end": 106.84
  },
  {
   "index": 1,
   "title": "## نفاق خوراک و مهار شهوت با روزه",
   "start": 106.84,
   "end": 190.14
  },
  {
   "index": 2,
   "title": "## صبح همه‌اش خواب با آنکه شب بیدار نبوده",
   "start": 190.14,
   "end": 262.56
  },
  {
   "index": 3,
   "title": "## خواب محمود و مذموم در روایات",
   "start": 262.56,
   "end": 283.08
  },
  {
   "index": 4,
   "title": "## سه محبوب الهی؛ ظاهر و باطن کم‌خوابی",
   "start": 283.08,
   "end": 555.84
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.56,
   "end": 6.3,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.3,
   "end": 10.52,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.52,
   "end": 12.94,
   "text": "خب ایام شب عید است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.94,
   "end": 16.6,
   "text": "خرید و این‌ها خیلیا میرن کفش میخرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.6,
   "end": 25.26,
   "text": "باید حواسمون جمع باشه اگر کفشی که میخریمیقین داشته باشیم که اون کفش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.26,
   "end": 31.0,
   "text": "از کشورهایی اومده که اون‌ها تزکیه نمی‌کنن حیواناتشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.0,
   "end": 35.48,
   "text": "یا این کفش از پوست حیوانی که تزکیه نشده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.48,
   "end": 40.28,
   "text": "مردار یا پوست حیوانات نجس این‌ها بر تقدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.28,
   "end": 43.16,
   "text": "مخصوصا چرم و این‌ها تهیه شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.16,
   "end": 45.46,
   "text": "خب خریدن اون کفش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.46,
   "end": 48.02,
   "text": "حرامه چون نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.02,
   "end": 51.48,
   "text": "اصلاً خریدش حرامه چه برسه استفاده ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.48,
   "end": 53.16,
   "text": "حالا ما چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.16,
   "end": 55.24,
   "text": "به هر حال تو بازار اسلامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.24,
   "end": 59.06,
   "text": "می‌گردیم کفش می‌گیریم. البته دو تا شرط نیاز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.06,
   "end": 62.76,
   "text": "هست باید باشه که مثلا ک-- پای انسان نجس بشه در کفش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.76,
   "end": 67.28,
   "text": "یکی اینکه پا عرق کنه یا کفش خیس بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.28,
   "end": 72.46,
   "text": "نکته دوم اینکه یقین داشته باشی که اون کفش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.46,
   "end": 77.16,
   "text": "از پوست حیوانی تهیه شده که تزکیه نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.16,
   "end": 80.5,
   "text": "حالا اگر ما پامون هم عرق کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.5,
   "end": 82.74,
   "text": "کفشو خریدیم پامون هم عرق کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.74,
   "end": 86.3,
   "text": "یا کفش خیس شد اما یقین نداریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.3,
   "end": 89.84,
   "text": "شک داریم که آیا این کفش بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.84,
   "end": 92.72,
   "text": "از پوست حیوان تزکیه شده‌ست یا نشده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.72,
   "end": 95.28,
   "text": "همین که شک کردیم بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.28,
   "end": 100.5,
   "text": "اصل طهارت محکومه به طهارت اون کفش و استفاده ازش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 100.5,
   "end": 103.7,
   "text": "حتی خرید و فروشش هم اشکال نداره همین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 103.7,
   "end": 113.18,
   "text": "مطمئن نیستیم. خب ما رسیده بودیم به بخشی از حدیث امام سجاد سلام الله علیه در رابطه با نشانه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.18,
   "end": 120.28,
   "text": "نفاق قلبی. رسیدیم به این تیکه که حضرت می‌فرماید \"شخصی که دچار نفاق قلبی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.28,
   "end": 123.7,
   "text": "شام می‌کند و همش خوراک است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.7,
   "end": 125.72,
   "text": "با اینکه روزه نبوده.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.72,
   "end": 128.46,
   "text": "اینو مختصراً توضیح دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.46,
   "end": 136.36,
   "text": "که بعد به ربطش دادیم به روزه که این ایام اگه کسی بتونه روزه بگیره چقدر ارزشمنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.36,
   "end": 139.38,
   "text": "یه بخشی از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.38,
   "end": 145.76,
   "text": "اِاِاِ رساله حقوق امام سجاد سلام الله علیه رو اگر دقت کرده باشید، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.76,
   "end": 151.36,
   "text": "قسمتی که به حق اندام جنسی حضرت می‌پردازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.36,
   "end": 154.34,
   "text": "خیلی جالبه. حضرت فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.34,
   "end": 161.12,
   "text": "حق اندام جنسی برای تو این است که چون خودسری کنه البته این یه بخشیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.12,
   "end": 167.58,
   "text": "چون خودسری کنه، پررویی کنه به قول ما اندام جنسی انسان، غریزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.58,
   "end": 170.36,
   "text": "فرمودن که با گرسنگی و تشنگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.36,
   "end": 172.26,
   "text": "روزه مهارش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.26,
   "end": 176.12,
   "text": "یعنی با روزه یکی از بهترین راه‌هایی که میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.12,
   "end": 181.8,
   "text": "انسان جلوی این لجام گسیختگی شهواتشو بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.8,
   "end": 183.68,
   "text": "با همون گرسنگی، تشنگی روزه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.68,
   "end": 186.96,
   "text": "انقدر ارزشمنده. این قوا تحلیل میره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.96,
   "end": 190.14,
   "text": "به قولی خفه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.14,
   "end": 194.6,
   "text": "اما بخش بعدیش که امروز عرض کنیم مختصراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.6,
   "end": 198.76,
   "text": "از نشانه‌های نفاق. حضرت فرمودن که صبح می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.76,
   "end": 200.6,
   "text": "و همش خواب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.6,
   "end": 203.8,
   "text": "با اینکه شب بیدار نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.8,
   "end": 207.34,
   "text": "از نشانه‌های قلب دچار نفاق اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.34,
   "end": 209.86,
   "text": "شبم بیدار نبوده، عبادت نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.86,
   "end": 214.54,
   "text": "اما صبح که می‌کنه با اینکه شب سیر خوابیده بازم می‌خواد بخوابه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.54,
   "end": 216.8,
   "text": "بازم خواب آلوئه، بازم می‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.8,
   "end": 219.44,
   "text": "اصلاً کارش این شده. همش خواب، خواب، خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.44,
   "end": 221.7,
   "text": "یکی از نشانه‌های نفاقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.7,
   "end": 223.58,
   "text": "که خیلی هم خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 223.58,
   "end": 228.3,
   "text": "روایاتی در این زمینه هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.3,
   "end": 230.78,
   "text": "و عرض شود خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.78,
   "end": 233.98,
   "text": "انسان رو از خواب زیاد می‌ترسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.98,
   "end": 237.3,
   "text": "البته خود خواب باید تنظیم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.3,
   "end": 239.34,
   "text": "اسلام مخالف خواب که نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 239.34,
   "end": 242.56,
   "text": "میگه به موقع بخواب، به اندازه بخواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 242.56,
   "end": 247.2,
   "text": "حتی نماز شب هم آقای بهجت می‌فرمودن که مدیریت زمانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 247.2,
   "end": 251.04,
   "text": "نخوابیدن نیست. میگه حالا الان عبادت کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 251.04,
   "end": 255.44,
   "text": "یه وقت دیگه بخواب. روزه، میگه الان نخور، یه وقت دیگه بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.44,
   "end": 260.96,
   "text": "تنظیم وقته. اصلاً ربطی به نخوردن یا نخوابیدن نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.96,
   "end": 263.44,
   "text": "تنظیم وقته. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.44,
   "end": 265.58,
   "text": "در روایات داریم که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 265.58,
   "end": 269.24,
   "text": "پیامبر عظیم الشأن اسلام داره و امیرالمؤمنین هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 269.24,
   "end": 274.72,
   "text": "زیاده روایات که، اِاِاِ بهترین خواب یکی قیلوله است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.72,
   "end": 277.68,
   "text": "قبل و بعد از اذان، قبل و بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.68,
   "end": 283.08,
   "text": "نماز ظهر و عصر. قبل-- مثلا یک ساعت مونده به ظهر و یک ساعت بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.08,
   "end": 286.64,
   "text": "نماز ظهر. خیلی-- میگن خواب nemte.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 286.64,
   "end": 290.84,
   "text": "حدیث داریم خواب nemte. همچنین شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.84,
   "end": 293.3,
   "text": "حدود مثلا ده شب تا دو نصفه شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.3,
   "end": 294.92,
   "text": "این بهترین ساعت خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 294.92,
   "end": 297.62,
   "text": "حتی روانشناسای امروزم اینو تایید کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 297.62,
   "end": 299.6,
   "text": "بالعکسش خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 299.6,
   "end": 303.16,
   "text": "بین طلوعین فرمودن مانع روزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 303.16,
   "end": 310.18,
   "text": "خواب بین نماز مغرب و عشا، بین زمان مغرب و عشا مانع روزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.18,
   "end": 312.98,
   "text": "خواب اول صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.98,
   "end": 317.52,
   "text": "یعنی مثلا آفتاب طلوع کرده دیگه همه میرن سراغ کار آقا می‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.52,
   "end": 319.88,
   "text": "این فرمودن سبب نادانی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.88,
   "end": 323.62,
   "text": "دیدی گاهی اوقات هرچی زور می‌زنیم یه چیزو بفهمیم نمی‌فهمیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 323.62,
   "end": 326.58,
   "text": "نادونی میاره. آدم نمی‌فهمه حقایقو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 326.58,
   "end": 329.56,
   "text": "عقلش کم میشه. خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 329.56,
   "end": 332.76,
   "text": "بعد از عصر یا نزدیک غروب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 332.76,
   "end": 336.92,
   "text": "فرمودن سبب حماقت و ابلهی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 336.92,
   "end": 344.3,
   "text": "کودن می‌کنه آدمو. این‌ها به هر حال دستوراتی که از اهل بیت علیهم الصلاة والسلام وارد شده، در یه حدیثی دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 344.3,
   "end": 347.32,
   "text": "پیغمبر فرمودن که یکی از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 347.32,
   "end": 353.38,
   "text": "چیزهایی که به شدت بر امتم ازش هراسانه زیاد خوابیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.38,
   "end": 360.86,
   "text": "که باز حدیث از امام باقر صلوة الله علیه هستش که اگر کسی زیاد بخوابه قیامت فقیر محشور میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 360.86,
   "end": 363.36,
   "text": "آدم باید خوابشو مدیریت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 363.36,
   "end": 365.94,
   "text": "حالا آدمی که دچار نفاقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.94,
   "end": 372.6,
   "text": "گرفتار دو روی قلبی شده، ما بحث قلب نفاق رو داریم، قلب منافق رو بحث می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 372.6,
   "end": 376.58,
   "text": "چنین کسی خودبه‌خود اصلاً وله، برنامه‌ای برای خوابش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 376.58,
   "end": 379.8,
   "text": "همش دوست داره بخوابه. حتی می‌بینی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.8,
   "end": 384.18,
   "text": "حالا یه وقت شب ببین تو حدیث داره میگه شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.18,
   "end": 388.6,
   "text": "عبادت نکرده و باز خـ-- صبح، روز می‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 388.6,
   "end": 391.4,
   "text": "حالا عبادت نکرده سر کارشم می‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 391.4,
   "end": 394.16,
   "text": "دوباره از سر کار میره خونه دوباره می‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 394.16,
   "end": 397.34,
   "text": "این همش خوابه که. البته اینم عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 397.34,
   "end": 399.96,
   "text": "یه حدیث داریم که پیغمبر فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 399.96,
   "end": 401.84,
   "text": "خدا سه چیزو اصلاً دوست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 401.84,
   "end": 404.12,
   "text": "یکی کم خوردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 404.12,
   "end": 406.46,
   "text": "کم صحبت کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 406.46,
   "end": 409.36,
   "text": "و کم خوابیدن. این یه معنای باطنی هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 409.36,
   "end": 413.58,
   "text": "اینو عرض کنم و بسه. معنای ظاهرش همینایه که می‌فهمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 413.58,
   "end": 416.84,
   "text": "معنای باطنش اینه که میگه کم خوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 416.84,
   "end": 419.44,
   "text": "یعنی انقدر فقط خوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 419.44,
   "end": 422.8,
   "text": "از ناحیه گلو انسان بره پایین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 422.8,
   "end": 425.7,
   "text": "یعنی کم برای خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 425.7,
   "end": 427.92,
   "text": "ح-حق کم قائل باشه در مال دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 427.92,
   "end": 430.06,
   "text": "هی جمع نکنه، هی جمع نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 430.06,
   "end": 433.34,
   "text": "اینو می‌خواد، اونو می‌خواد، همه رو می‌خواد برای خودش ورداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 433.34,
   "end": 436.7,
   "text": "یه معنای دیگه اون که میگه کم‌گویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 436.7,
   "end": 438.96,
   "text": "نه اینکه فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 438.96,
   "end": 443.76,
   "text": "صرفاً اینم هستا. ظاهرش اینه که رو زبانش کمتر حرف جاری بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 443.76,
   "end": 446.5,
   "text": "کلمات جاری بشه، سکوت داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 446.5,
   "end": 449.5,
   "text": "اما یه معناش اینه که خیلی بی‌ادعاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 449.5,
   "end": 451.66,
   "text": "کم‌گویی یعنی ادعایی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 451.66,
   "end": 454.68,
   "text": "معمولاً آدمای پرمدعا خیلی حرف می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 454.68,
   "end": 456.76,
   "text": "همش این و اون رو تحلیل می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 456.76,
   "end": 459.76,
   "text": "همش نگاه می‌کنن به عیب و ایراد دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 459.76,
   "end": 462.78,
   "text": "و در خصوص کم‌خوابی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 462.78,
   "end": 466.72,
   "text": "فرمودن این یه معنای باطنیش میشـ-- می‌تونه این باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 466.72,
   "end": 470.48,
   "text": "آقا اصلاً حتی خوابشم بیداریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 470.48,
   "end": 473.38,
   "text": "توجه کردی؟ برعکس بعضیا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 473.38,
   "end": 477.46,
   "text": "بیداریشونم خوابه. توجه کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 477.46,
   "end": 480.9,
   "text": "یعنی معنای باطنیش می‌تونه این باشه که آقا حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 480.9,
   "end": 483.06,
   "text": "میگه کم بی-- کم می‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 483.06,
   "end": 485.96,
   "text": "یعنی اصلاً به ندرت پیش میاد این اصلاً تو خواب بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 485.96,
   "end": 489.78,
   "text": "یعنی همیشه بیداره. بیداره، هشیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 489.78,
   "end": 491.86,
   "text": "حتی اگر می‌خوابه باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 491.86,
   "end": 495.9,
   "text": "حواسش هست. از صفات اولیای خداست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 495.9,
   "end": 501.86,
   "text": "و خیلی از مسئولین الان ما، مدیران ما متأسفانه متولیان امر فرهنگ ما الان تو خوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 501.86,
   "end": 504.72,
   "text": "بیدارنو اما ظاهراً بیدارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 504.72,
   "end": 506.5,
   "text": "باطناً تو خوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 506.5,
   "end": 509.44,
   "text": "این رو هم عرض کردم که معنای باطنی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 509.44,
   "end": 513.7,
   "text": "داره. خوش به حال کسی که حتی وقتی می‌خوابه بیداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 513.7,
   "end": 516.9,
   "text": "برای همین فرمودن خواب مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 516.9,
   "end": 524.58,
   "text": "یا خواب عاقل عبادت محسوب می‌شه و از عبادت جاهل برتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 524.58,
   "end": 527.56,
   "text": "از بیداری جاهل برتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 527.56,
   "end": 532.94,
   "text": "منظور اون خواب، خواب-- اون بیداریه عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 532.94,
   "end": 542.46,
   "text": "حقیقیه که انسان سعی کنه حتی تو خوابشم بیدار بشه چون مؤمن و عاقل حتی ظاهراً خوابه باز عقلش از کار نیفتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 542.46,
   "end": 546.48,
   "text": "باز هم حاضره، باز هم متوجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 546.48,
   "end": 549.2,
   "text": "حس حضور رو داره. ان‌شاءالله اوقات به خیر باشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 549.2,
   "end": 552.22,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 552.22,
   "end": 555.84,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}