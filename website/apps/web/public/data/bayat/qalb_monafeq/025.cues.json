 },
 "chapters": [
  {
   "index": 0,
   "title": "## فطریهٔ تأخیری",
   "start": 24.18,
   "end": 67.06
  },
  {
   "index": 1,
   "title": "## نفاق و غیبت امام",
   "start": 67.06,
   "end": 615.58
  },
  {
   "index": 2,
   "title": "## دعای معرفت",
   "start": 615.58,
   "end": 657.66
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.62,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.62,
   "end": 8.2,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.2,
   "end": 12.4,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.4,
   "end": 17.38,
   "text": "سؤال میشه که بعضیا هنوز فطریه‌شونو ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.38,
   "end": 23.98,
   "text": "حالا یا کنار گذاشتن یا اصلاً فراموش کردن یا نداشتن که بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.98,
   "end": 26.48,
   "text": "اون کسی که نداشته بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.48,
   "end": 30.6,
   "text": "خب نداشته دیگه. وقتی نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.6,
   "end": 34.36,
   "text": "از گردنش ساقطه. اگر داشته باشه که به اندازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.36,
   "end": 39.38,
   "text": "یک نفر از اعضای خونوادش رو دست گردون کرده باشه، رد کرده باشه کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.38,
   "end": 42.98,
   "text": "اگر نداشته باشه که اصلاً از گردنش ساقطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.98,
   "end": 45.9,
   "text": "اما کسی که نداده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.9,
   "end": 50.64,
   "text": "حالا کنار هم نذاشته، خب این وظیفشه که هرچه زودتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.64,
   "end": 56.4,
   "text": "به محض اینکه یادش اومد یا حالا مشکل برطرف شد این فطریه رو رد کنه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.4,
   "end": 58.84,
   "text": "واجبه، اینطور نیستش که شما بگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.84,
   "end": 62.72,
   "text": "حالا یه چیزی اعتبار شده به نام فطریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.72,
   "end": 66.26,
   "text": "بحث فطر هم گذشت اهمیتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.26,
   "end": 70.12,
   "text": "و نکته‌ی دیگه اینکه کسی گذاشته کنار هنوز رد نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.12,
   "end": 72.16,
   "text": "خب اینم باز به گردنش که رد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.16,
   "end": 76.28,
   "text": "مهم اینه که این به دست فقیر برسه هرچه زودتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.28,
   "end": 80.42,
   "text": "برسه به دست فقیر. البته فقیرم فقیر شرعی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.42,
   "end": 87.94,
   "text": "که حالا ما بخوایم شرعیات قصه فقر رو باز کنیم متوجه میشیم که بسیاریمون فقیر شرعی‌ایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.94,
   "end": 93.88,
   "text": "که قبلاً توضیح دادیم. لکن حالا اگه کسی توی خونوادش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.88,
   "end": 96.24,
   "text": "فقیر باشه مثلاً پسرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.24,
   "end": 99.8,
   "text": "فقیره، آیا می‌تونه فطریه رو بده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.8,
   "end": 104.28,
   "text": "اهل بیتش و خونوادش که فقیرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.28,
   "end": 111.18,
   "text": "آقا فرمودن که اگر واجب النفقه است اون شخص یعنی تحت تکفل پس-- پدره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.18,
   "end": 117.32,
   "text": "یا همسر که تحت تکفل شوهرشه، این‌ها نمی‌تونه فطریه بهشون تعلق نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.32,
   "end": 123.48,
   "text": "اگر حتی فقیر باشن. لکن این فطریه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.48,
   "end": 126.88,
   "text": "البته اگر در جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.88,
   "end": 130.82,
   "text": "بر گردن پدر واجب نیست دادن این نفقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.82,
   "end": 135.94,
   "text": "میشه هزینه کرد. مثلاً بدهکاری پسر گردن پدر نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.94,
   "end": 139.76,
   "text": "پسر بدهکاره یا خرج دانشگاه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.76,
   "end": 142.86,
   "text": "یا یه سری خرج‌های شخصی داره، اینا گردن پدر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.86,
   "end": 147.58,
   "text": "اینا، از اینا میشه، تو اینا میشه فطریه رو پدر هزینه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.58,
   "end": 150.34,
   "text": "اگر مشکل مالی پسر داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.34,
   "end": 153.2,
   "text": "یا هر کدوم که واجب النفقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.2,
   "end": 159.0,
   "text": "نکته آخر اینکه فطریه رو اصلاً اتفاقاً بهتر، بهتر که نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.0,
   "end": 161.98,
   "text": "باید اول به نزدیکان داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.98,
   "end": 165.96,
   "text": "موضوع فطریه رو یادتون باشه. یعنی اگه تو شهر شما، تو فامیل شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.96,
   "end": 171.0,
   "text": "تو خونواده‌ی شما فقیر باشه حق نداری ببری بدی به کس دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.0,
   "end": 175.22,
   "text": "اول نزدیکان. این بحث فطریه رو جدی بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.22,
   "end": 178.84,
   "text": "اما در خصوصه، برمی‌گردیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.84,
   "end": 183.74,
   "text": "بحث قبلیمون قبل از ماه مبارک رمضان ما پیرامون قلب منافق بحث می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.74,
   "end": 187.24,
   "text": "قلبی که دچار نفاق شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.24,
   "end": 190.58,
   "text": "و این بحث نصفه کارمون به جهت اهمیتش ادامه‌ش بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.58,
   "end": 193.66,
   "text": "یه چند تا نکته هم دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.66,
   "end": 198.18,
   "text": "اضافه کنیم بهش. اونم اینه که دقت داشته باشید عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.18,
   "end": 202.0,
   "text": "اصلاً نفاق حالا به قول ما نفوذ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.0,
   "end": 205.18,
   "text": "نفوذ رو ما قبلاً همون نفاق معنا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.18,
   "end": 210.76,
   "text": "تا نفاق نباشه نفوذ معنا نداره که رهبر صداش دراومده دیگه چند وقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.76,
   "end": 214.44,
   "text": "قطعاً نفاق وجود داشته که نفوذ صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.44,
   "end": 216.68,
   "text": "این نفوذ از دو جهت قابل بررسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.68,
   "end": 224.88,
   "text": "یکی خود طرف چطور گرفتار نفاق شده که حالا خیلی ما حرف‌ها پیرامون آیات و روایات زدیم در این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.88,
   "end": 227.98,
   "text": "یکی هم از جهت دیگران یعنی اجتماع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.98,
   "end": 233.04,
   "text": "اجتماع اهل ایمان قابل بررسیه که شما چگونه رفتار کردید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.04,
   "end": 240.4,
   "text": "نفوذ صورت گرفت یا منافقین تونستن رخنه کنن در حساس‌ترین جاهای حکومت و نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.4,
   "end": 243.84,
   "text": "و دین. آی مردم، شما چگونه رفتار کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.84,
   "end": 247.1,
   "text": "چه علت اصلی، عامل اصلی چی بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.1,
   "end": 250.22,
   "text": "بلافاصله بعد شهادت پیغمبر همون کفن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.22,
   "end": 252.78,
   "text": "آقا به قول معروف خشک نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.78,
   "end": 257.66,
   "text": "به این سرعت نفوذ صورت گرفت و منافقین جای حضرت نشستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.66,
   "end": 259.92,
   "text": "خب این چه-- اجتماع چگونه رفتار کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.92,
   "end": 262.9,
   "text": "مشکل اصلی چیه؟ یا انقلاب خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.9,
   "end": 266.28,
   "text": "باز تازه الحمدالله از خیلی خطرات مصون موند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.28,
   "end": 271.82,
   "text": "برکت خون شهدا و به قول رهبری خلوصی که در زمان جنگ وجود داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.82,
   "end": 275.44,
   "text": "اما باز حدود چهل سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.44,
   "end": 277.48,
   "text": "حالا کمتر و بیشتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.48,
   "end": 281.8,
   "text": "خیلی جاهای حساس نظام افتاد دست اهل نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.8,
   "end": 285.32,
   "text": "که الان هر کاریش هم بخوای بکنی کاریش نمیشه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.32,
   "end": 287.36,
   "text": "چرا؟ این علت اصلیش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.36,
   "end": 291.08,
   "text": "علت اصلیش برمی‌گرده البته عوامل زیادی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.08,
   "end": 294.74,
   "text": "میشه با توجه به روایات و آیات گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.74,
   "end": 298.88,
   "text": "مهم‌ترین نکته عدم شناخت امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.88,
   "end": 304.28,
   "text": "اینکه حضرت زهرا سلام الله علیها می‌فرمود امام مثل کعبه‌ست و شما باید برید گردش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 304.28,
   "end": 307.64,
   "text": "بگردید و بچرخید، این صورت نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.64,
   "end": 311.98,
   "text": "امام درست شناخته نشده که بلافاصله بعد شهادت پیغمبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.98,
   "end": 314.88,
   "text": "اون تا جاش می‌شینن هیچکس هم هیچی نمیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.88,
   "end": 320.66,
   "text": "یه مقدار و ایناها کتک می‌خورن و داد و فریاد می‌کنن دماغش می‌شکنه بیچاره مشت می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.66,
   "end": 325.38,
   "text": "و سرش می‌خوره به خشت و اولین مجروحه بعد از قصه‌ی پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 325.38,
   "end": 327.52,
   "text": "این‌ها، بقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 327.52,
   "end": 330.18,
   "text": "همراه میشن با این موج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.18,
   "end": 335.72,
   "text": "اصلاً غیبت شما دقت بفرمایید که غیبت که مرحوم شیخ صدوق در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.72,
   "end": 340.38,
   "text": "بسیار شریف کامل الدین و تمام نعمتش محور اصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.38,
   "end": 343.88,
   "text": "این کتاب قرار داده غیبت رو از انبیا شروع کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.88,
   "end": 346.64,
   "text": "اصلاً چرا غیبت؟ غیبت برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 346.64,
   "end": 349.84,
   "text": "به جهت اینکه هم مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.84,
   "end": 352.28,
   "text": "اهل ایمان نشناختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.28,
   "end": 354.48,
   "text": "پیغمبر و امام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 354.48,
   "end": 357.78,
   "text": "به قول حضرت زهرا قربونش بریم سلام الله علیها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.78,
   "end": 361.98,
   "text": "اون وظیفه‌شون رو نسبت به امام رعایت نکردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.98,
   "end": 370.4,
   "text": "همون کسی هم که نفوذ کرده و منافق شده و دوگونه رفتار میکنه دوگانه رفتار میکنه، اون هم نشناخته این آقا کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 370.4,
   "end": 374.26,
   "text": "بحث غیبت چیزی نیست که الان ما گرفتارش شده باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.26,
   "end": 379.28,
   "text": "اصلا شما هم کتاب کمال الدین شیخ صدوق رو بخونید ببینید چقدر از انبیا غیبت داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.28,
   "end": 383.88,
   "text": "حضرت ادریس اولین پیغمبری بوده که غیبت داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.88,
   "end": 388.74,
   "text": "حضرت ادریس جالبه که بدونید بیست سال غیبت داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 388.74,
   "end": 392.12,
   "text": "حضرت ادریس علیه السلام ن-- نبی بود غیبت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.12,
   "end": 394.04,
   "text": "بعد بیست سال رسول شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.04,
   "end": 396.18,
   "text": "با ارتقای درجه برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.18,
   "end": 401.18,
   "text": "بیست سال بعد رسالت گرفت و برگشت ولی به نام الیاس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.18,
   "end": 403.76,
   "text": "ادریس بود بعد شد الیاس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.76,
   "end": 409.18,
   "text": "با بیست سال، بیست سال غیبت کرد، ارتقای درجه خودش پیدا کرد اما بیچاره شدن این ملت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.18,
   "end": 412.24,
   "text": "یا حضرت موسی که چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.24,
   "end": 416.76,
   "text": "از روی چهارصد سال، چهارصد سال قرار بود غیبت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 416.76,
   "end": 423.5,
   "text": "که حالا به خاطر التجا و اضطرار مردم و اینها انابه‌هاشون صد و هفتاد سال خدا تخفیف داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.5,
   "end": 426.72,
   "text": "دویست و سی سال غیبت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.72,
   "end": 428.6,
   "text": "دقت بفرمایید حضرت نوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 428.6,
   "end": 432.94,
   "text": "حدود هزار سال کمتر و بیشتر براش غیبت نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.94,
   "end": 436.5,
   "text": "این غیبت وجود داشته و این تو خود اهل بیت هم همینطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.5,
   "end": 440.16,
   "text": "خود ائمه ما یک یکشون غیبت داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.16,
   "end": 441.92,
   "text": "اینو یه روز من مطرح کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.92,
   "end": 444.08,
   "text": "یکی دو نفر فقط اومدن پیگیر بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 444.08,
   "end": 446.84,
   "text": "نشنیده بودین تا حالا؟ یعنی حضرت زهرا غیبت داشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.84,
   "end": 449.44,
   "text": "بله. امیرالمؤمنین غیبت داشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.44,
   "end": 451.76,
   "text": "بله. امام سجاد غیبت داشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.76,
   "end": 455.2,
   "text": "بله. منتها باید غیبت معنا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.2,
   "end": 459.62,
   "text": "وقتی تو امام رو درست نشناختی از چشمت پنهان میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.62,
   "end": 462.5,
   "text": "چطور میشه راوی میگه با امام بعد از میدونید ح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.5,
   "end": 465.74,
   "text": "سال دوم حکومت یزید ملعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 465.74,
   "end": 468.94,
   "text": "خب تو اون سه سال حکومتش سه تا اتفاق بزرگ افتاد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.94,
   "end": 473.12,
   "text": "کعبه رو منجنیق بستن و کربلا قصه کربلا و قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 473.12,
   "end": 476.72,
   "text": "غارت مدینه. سال دوم غارت مدینه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 476.72,
   "end": 480.22,
   "text": "که راوی میگه ما تو مسجد النبی کنار امام سجاد بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 480.22,
   "end": 484.36,
   "text": "حضرت تو سجده بود. امام وقت بعد از قصه کربلا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 484.36,
   "end": 486.36,
   "text": "امام تو سجده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.36,
   "end": 488.88,
   "text": "شنیدیم بیرون مسجد النبی درگیری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.88,
   "end": 492.92,
   "text": "چه خبره؟ گفتن دارالدس-- حسین با صاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 492.92,
   "end": 496.56,
   "text": "حسین ابن نومیر لعنت الله علیه که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 496.56,
   "end": 502.12,
   "text": "کسایی بود که شاید حدود ده هزار نفر با خودش برد کربلا بر علیه حسین ابن علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 502.12,
   "end": 507.22,
   "text": "اومد بعد سمت مدینه. غارت داره میکنه همه رو میکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 507.22,
   "end": 514.3,
   "text": "ریختن یه دفعه دید میگه من دیدم یهو مسجد النبی داخل مسجد پر شد از جمعیت اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.3,
   "end": 517.72,
   "text": "همون بدبختایی که حسین ابن علی رو کمک نکردن حالا اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 517.72,
   "end": 519.9,
   "text": "د-دچار تیغ شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 519.9,
   "end": 523.34,
   "text": "میگه دیدم عوامل یزید هم ریختن تو مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 523.34,
   "end": 528.5,
   "text": "داخل روضه مقدسه بکش بکش خون بود سر بود که جدا میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 528.5,
   "end": 535.2,
   "text": "سیل خون رو کف روضه مسجد النبی سی هزار نفر داخل مسجد، مسجد النبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 535.2,
   "end": 538.12,
   "text": "س-سر زده شدن. داخل روضه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.12,
   "end": 540.1,
   "text": "همینجوری خون جاری شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 540.1,
   "end": 542.62,
   "text": "این چیزیه که تو تاریخ راوی نوشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 542.62,
   "end": 545.32,
   "text": "من دیدم. منتها میگه دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.32,
   "end": 548.42,
   "text": "من به خاطر مصم با حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 548.42,
   "end": 553.36,
   "text": "سجاد و امام عصرم این خون گرد ما گردش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 553.36,
   "end": 558.42,
   "text": "این خونه که توی مسجد النبی به من و امام مص نمی‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 558.42,
   "end": 561.44,
   "text": "و احدی امام و من رو نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 561.44,
   "end": 566.16,
   "text": "این یه معنای غیبته. این همه آدم هجوم آوردن به مسجد النبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 566.16,
   "end": 569.28,
   "text": "از ترس جانشون اما امامشون رو نمی‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 569.28,
   "end": 572.66,
   "text": "این یه غیبته دیگه. این یه نوع غیبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.66,
   "end": 574.24,
   "text": "میخوام بگم غیبت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 574.24,
   "end": 583.58,
   "text": "وقتی شروع شده و تا وقتی ادامه خواهد داشت که ما اماممون رو نشناختیم و نشناسیم و معرفت پیدا نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 583.58,
   "end": 585.7,
   "text": "حالا این بحث باید ادامه پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 585.7,
   "end": 594.68,
   "text": "فقط بترسیم از اینکه ما امام رو نشناسیم و امام رو در غیبت نگه داریم و همینجوری بحث ادامه پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 594.68,
   "end": 600.2,
   "text": "لذا این دعای شریف که بر اگر بخواید ه-- چندین جلسه روش بحث کنیم کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 600.2,
   "end": 607.32,
   "text": "این دعا رو غنیمت بشماریم که نائب اول امام فرمودن در دوران غیبت خودشون به املا فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 607.32,
   "end": 609.24,
   "text": "املا نائب اول امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 609.24,
   "end": 615.58,
   "text": "خیلی این دعا از با عظمت‌ترین دعاهاست که روش بحث‌ها کردن بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 615.58,
   "end": 618.74,
   "text": "اللهم عرفنی نفسک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.74,
   "end": 623.14,
   "text": "دیگه حفظید تا آخرش. فإنك إن لم تعرفني نفسك لم أعرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 623.14,
   "end": 629.68,
   "text": "رسولك. اللهم عرفني رسولك فإنك إن لم تعرفني رسولك لم أعرف حجتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 629.68,
   "end": 637.02,
   "text": "اللهم عرفني حجتك فإنك إن لم تعرفني حجتك بللت عن ديني.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.02,
   "end": 639.68,
   "text": "همش میگه نفسک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 639.68,
   "end": 642.24,
   "text": "رسولک، حجتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 642.24,
   "end": 643.94,
   "text": "اینجا یه دفعه میگه ديني.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 643.94,
   "end": 646.88,
   "text": "اینم یه بحثیه که شاید بعداً عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 646.88,
   "end": 652.12,
   "text": "ان شاء الله عاقبت 末 خته بخیر باشه و به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 652.12,
   "end": 657.66,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
