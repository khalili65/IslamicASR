 "chapters": [
  {
   "index": 0,
   "title": "## خدمت در هیئت؛ مصرفی نباشیم",
   "start": 14.06,
   "end": 34.18
  },
  {
   "index": 1,
   "title": "## سلام منافقانه و حقیقت نفاق",
   "start": 34.18,
   "end": 253.42
  },
  {
   "index": 2,
   "title": "## ظاهر و باطن صلوات",
   "start": 253.42,
   "end": 273.64
  },
  {
   "index": 3,
   "title": "## مالک اشتر و تسلیم محض",
   "start": 273.64,
   "end": 494.56
  },
  {
   "index": 4,
   "title": "## فاصله از باطن صلوات و ورود به نفاق",
   "start": 494.56,
   "end": 629.72
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.76,
   "end": 4.28,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.28,
   "end": 8.84,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.84,
   "end": 14.06,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.06,
   "end": 18.72,
   "text": "امروز این یکی دو دقیقه ای که معمولا ما حکم شرعی میگیم یه نکته دیگه ای عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.72,
   "end": 23.38,
   "text": "اونم این که بارها من این رو چند بار عرض کردم جزو خاطرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.38,
   "end": 31.28,
   "text": "خوب ماست که اصفهان درس میخوندیم مدرسه صدر اصفهان خدا رحمت کنه حضرت آیت الله العظمی ابتهی شیرازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.28,
   "end": 33.16,
   "text": "ایشون یه روز بین دو نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.16,
   "end": 39.94,
   "text": "ظهر و عصر بلند شد قسم خورد گفت اینایی که نمازخونه رو گرم میکنن، صلوات میگیرن، دعا میخونن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.94,
   "end": 45.54,
   "text": "اذان میگن، تکبیر میگن اینا قیامت یه سر و گردن از ما بالاترن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.54,
   "end": 49.34,
   "text": "من خواهش میکنم که فقط مصرفی نباشیم تو این وادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.34,
   "end": 53.58,
   "text": "بالاخره الان ببین بعد چند سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.58,
   "end": 59.72,
   "text": "دو تا دو تا نماز رو یه عزیزی اومدن تکبیر گفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.72,
   "end": 63.02,
   "text": "خب من وقتی که میخوام اون تهیا متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.02,
   "end": 67.26,
   "text": "سجود و رکوع و اینها بشن یا خانوما باید داد بزنن الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.26,
   "end": 73.34,
   "text": "اکبر. خب این تمرکز منو تو نماز میریزه به هم که من حواسم به اون تهیام باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.34,
   "end": 77.64,
   "text": "وقتی یکی اذان میگه اینا خودش بار برداشتنه در راه خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.64,
   "end": 80.44,
   "text": "چرا بعضیامون فقط مصرفی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.44,
   "end": 86.06,
   "text": "حالا یکی قرآن بلده بشینه قرآن، دعا، اذان، تکبیر چه اشکالی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.06,
   "end": 88.24,
   "text": "چرا بار رو دوش یه نفر دو نفر باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.24,
   "end": 94.44,
   "text": "همیشه متاسفانه شما ببینید هیئت‌هایی که خیلی رشد میکنن یکی دو نفر چهار نفر فدا میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.44,
   "end": 97.42,
   "text": "عمرشونو میذارن تا اون هیئت رشد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.42,
   "end": 104.36,
   "text": "الان هیئت همین جا، هیئت مسلم بن جعفر نعمت صلوات الله مطمئن باشید بعضیا فدا شدن تا این هیئت جون گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.36,
   "end": 107.86,
   "text": "اینطوری نیست که شما فکر کنید همینطوری یه هیئت به پا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.86,
   "end": 110.26,
   "text": "خون دل‌ها خورده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.26,
   "end": 113.02,
   "text": "مراقب باشیم اینطور نباشه که مصرفی باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.02,
   "end": 116.08,
   "text": "به خدا قیامت باید جواب بدیم برای این ارزش‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.08,
   "end": 123.74,
   "text": "بی‌تفاوت نباشیم. و بعضیا متاسفانه بدتر تو هیئت‌های خودمون که به نام خودمونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.74,
   "end": 127.38,
   "text": "هیئت فلانی وسط گود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.38,
   "end": 134.22,
   "text": "سینه زب ضرب می‌زنیم ولی جاهایی که میریم یه گوشه میشینیم اصلا کار به کار اینا انگار که اصلا با روضه غریبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.22,
   "end": 138.08,
   "text": "این خوب نیست. این نشانه معذرت میخوام یه نشانه بدی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.08,
   "end": 141.1,
   "text": "حالا نگم. ورود به بحث کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.1,
   "end": 146.16,
   "text": "یه آیه ای رو میخونم که این آیه جزو آیات عجیب قرآنه و من نمیدونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.16,
   "end": 150.66,
   "text": "آیا ماها توجه تا حالا کردیم به این آیه و این قبیل آیات یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.66,
   "end": 154.64,
   "text": "یه ترسی رو یک لرزi رو تو وجود ما میندازه این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.64,
   "end": 157.84,
   "text": "ببینیم میترسیم امروز یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.84,
   "end": 162.62,
   "text": "اولش آیه پ-- شصت و پنج سوره نساء میفرماید فلا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.62,
   "end": 167.08,
   "text": "نه چنین است. خیلی بحث حرف معلومه مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.08,
   "end": 170.4,
   "text": "و ربک و قسم یاد میکنه به پروردگار تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.4,
   "end": 177.94,
   "text": "خدا میگه نه چنین است قسم به پروردگار ربک تو یا رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 177.94,
   "end": 181.66,
   "text": "خیلی حرف معلومه مه-مهمه و سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.66,
   "end": 185.16,
   "text": "لا يؤمنون اینا اهل ایمان نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.16,
   "end": 192.46,
   "text": "چه کسایی؟ حتی يحكموك فيما شجر بينهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.46,
   "end": 197.76,
   "text": "این کسایی که ادعا میکنن ما اهل ایمانیم، ما مسجد میاییم، ما هیئت میریم، چه اینا، اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 197.76,
   "end": 201.64,
   "text": "اهل ایمان نیستن حتی يحكموك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.64,
   "end": 211.78,
   "text": "مگر اینکه تو رو حاکم قرار بدن، قاضی قرار بدن فيما شجر بينهم در اون چیزی که مشاجره کردن و اختلاف پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 211.78,
   "end": 217.82,
   "text": "حالا شما به من بگید معمولا دو گروه دو نفر میرن پیش قاضی بالاخره یکیشون ناراضی برمیگرده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 217.82,
   "end": 222.54,
   "text": "چون قاضی حکم به صلاح دو تا عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 222.54,
   "end": 226.58,
   "text": "اِاِاَ مقبولیت دو تا که نمیده یکی رو رد میکنه که تایید میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 226.58,
   "end": 228.86,
   "text": "این نهیب اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 228.86,
   "end": 232.24,
   "text": "میگه اولا تو رو حاکم قرار بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 232.24,
   "end": 234.64,
   "text": "ثانیا ثم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 234.64,
   "end": 244.8,
   "text": "سپس تو رو که حاکم قرار دادن ثم تو هم قضاوت کردی لا يجدوا في أنفسهم دقت بفرمایید نمیفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 244.8,
   "end": 248.4,
   "text": "مثلا على لسانهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 248.4,
   "end": 251.32,
   "text": "لا يجدوا في أنفسهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 251.32,
   "end": 253.42,
   "text": "حرج مما قضيت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 253.42,
   "end": 259.12,
   "text": "از اونجا که تو قضاوت کردی تو دلشون في أنفسهم تو جانشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 259.12,
   "end": 263.9,
   "text": "حرجی پیش نیاد. تو دلشون هم آه نکشن از این حکم تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 263.9,
   "end": 267.98,
   "text": "نگن عجب چرا مثلا پیغمبر این حکم رو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 267.98,
   "end": 272.52,
   "text": "بعد ادامشو ببینید و يسلموا تسليما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 272.52,
   "end": 277.22,
   "text": "و اینا تسلیم باشن. اگر تسلیم امر تو نباشند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 277.22,
   "end": 282.34,
   "text": "قبلش قسم خورده به خود پیغمبر به پروردگار پیغمبر که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 282.34,
   "end": 287.38,
   "text": "فلا آگاه مد-- متوجه باشید فلا متوجه باشید اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 287.38,
   "end": 292.1,
   "text": "و ربک قسم به پروردگار تو لا يؤمنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 292.1,
   "end": 294.78,
   "text": "حالا بگید شما لا يؤمنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 294.78,
   "end": 297.38,
   "text": "حتى يسلموا تسليما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 297.38,
   "end": 305.4,
   "text": "این آخر اینطوری هم میشه گفت. اینا ایمان نیاوردن مگر اینکه تسلیم محض تو باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 305.4,
   "end": 308.3,
   "text": "میشه سلام منافقانه گفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 308.3,
   "end": 313.16,
   "text": "میشه رفت حرم علی بن موسی الرضا با عشقم بریم و اون بگیم السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 313.16,
   "end": 318.08,
   "text": "یا امام رئوف اما منافقانه باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 318.08,
   "end": 323.4,
   "text": "مگر ما نفاق رو قبلا تر با خود قرآن ترجمه نکردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 323.4,
   "end": 329.78,
   "text": "قالوا یه چیزی رو میگن بأفواه، بأفواههم به زبونشون جاری میکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 329.78,
   "end": 336.54,
   "text": "لا يجدوا في قلوبهم یا أنفسهم این تو جانشون تو قلبشون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 336.54,
   "end": 340.98,
   "text": "پیداش نمیکنی. اون چیزی که رو زبونشون جاری میشه این علامت نفاقه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 340.98,
   "end": 343.36,
   "text": "حالا بیای به امام معصوم بگی سلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 343.36,
   "end": 346.36,
   "text": "سلام چیه یه معناش؟ یه معناش تسلیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 346.36,
   "end": 350.26,
   "text": "من تسلیم محض توام ای امام مهربان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 350.26,
   "end": 355.32,
   "text": "ای شاهان. که چطور تصمیمی تسلیم این امامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 355.32,
   "end": 358.02,
   "text": "که خیلی وظایفت رو زمینه استغفرالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 358.02,
   "end": 361.62,
   "text": "کار داره دشوار میشه ها کار داره دشوار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 361.62,
   "end": 365.78,
   "text": "یعنی واقعاً ببینید این چیزی که دارم میگم ببینید من از خودم که حرف نمیزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 365.78,
   "end": 369.1,
   "text": "وقتی توجه به آیات و روایات می‌کنم میبینم کار چقدر دشواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 369.1,
   "end": 377.84,
   "text": "تازه میفهمم چرا عرفا و بزرگان اهل معرفت فرمودن حتی آیات قعر جهنم هم که خوندی خطاب به خودت بگیر نه به اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 377.84,
   "end": 380.6,
   "text": "نفاق و مثلاً مشرکین و کفار و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 380.6,
   "end": 386.08,
   "text": "نه به خودت بگیر. به خود-- این قرآن برای من و تو اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 386.08,
   "end": 389.84,
   "text": "بعد امام صادق صلوات الله علیه ازش سؤال کردن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 389.84,
   "end": 392.06,
   "text": "حقیقت صلوات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 392.06,
   "end": 399.58,
   "text": "اشاره کرد به اون آیه \"إن الله وملائكته يصلون على النبي يا أيها الذين آمنوا صلوا عليه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 399.58,
   "end": 402.6,
   "text": "فرمود این \"صلوا عليه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 402.6,
   "end": 404.94,
   "text": "صلوات است. ظاهر صلوات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 404.94,
   "end": 410.9,
   "text": "همون چی؟ صلواتی که الان رو زبونتون جاری شد بعضیاتون دیدم دارید میگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 410.9,
   "end": 413.66,
   "text": "این همون ظاهر صلواته که اجر هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 413.66,
   "end": 417.7,
   "text": "خیلی هم اجر داره. با هر صلواتی چقدر گناه پاک میشه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 417.7,
   "end": 423.2,
   "text": "اما حضرت فرمود دنبال باطن صلواتی \"ويسلموا تسليما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 423.2,
   "end": 425.7,
   "text": "اون \"يسلموا\" یه تسلیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 425.7,
   "end": 427.76,
   "text": "اونم چه تسلیم شدنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 427.76,
   "end": 431.06,
   "text": "تسلیم محض بودن باطن صلواته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 431.06,
   "end": 435.3,
   "text": "یعنی تو اگر میخوای به باطن صلوات برسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 435.3,
   "end": 438.5,
   "text": "ذکر صلوات وارد ذکرت بشه نه ذاکرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 438.5,
   "end": 441.24,
   "text": "ذکر یعنی قلب. ذاکر لسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 441.24,
   "end": 446.38,
   "text": "به قول علامه حسن زاده حفظه الله تعالی میگه این ذکر وارد ذکرت بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 446.38,
   "end": 450.42,
   "text": "وارد قلبت بشه باید باطن صلوات رو برش برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 450.42,
   "end": 453.16,
   "text": "باطن یعنی تسلیم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 453.16,
   "end": 457.78,
   "text": "چطور بعضی از امور دین رو زمین میذاری بعضیاشو برمیداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 457.78,
   "end": 463.52,
   "text": "چرا کراهت داری به بعضی از دستورات دین، قرآن، اهل بیت و به بعضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 463.52,
   "end": 470.96,
   "text": "شوق نشون میدی؟ چرا ورق ورق می‌کنیم قرآن رو به بعضی از دستورات عمل می‌کنیم بعضیا رو تعطیل می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 470.96,
   "end": 473.52,
   "text": "چقدر ما بچه هیئتی داریم که خمس نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 473.52,
   "end": 477.66,
   "text": "میگه برو بابا آخوندا درست کردن. بابا قرآن داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 477.66,
   "end": 480.16,
   "text": "خمس میده. نمیره بده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 480.16,
   "end": 482.38,
   "text": "مرجع تقلیدش. نمیره بده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 482.38,
   "end": 484.72,
   "text": "مثلاً نماینده مرجع تقلیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 484.72,
   "end": 490.62,
   "text": "خودش میده به یه فقیر. میگه بابا این که به کی بدی هم از قرآن درآوردن علما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 490.62,
   "end": 493.64,
   "text": "آخه چرا از خودمون بعضی‌ها دین درست می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 493.64,
   "end": 497.26,
   "text": "خیلی بترسیم. خلاصه مطلب اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 497.26,
   "end": 499.98,
   "text": "تسلیم میخوان اهل بیت، تسلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 499.98,
   "end": 503.52,
   "text": "کیه که تسلیم باشه؟ کی میشه مالک اشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 503.52,
   "end": 508.16,
   "text": "که وقتی امیرالمؤمنین بهش فرمود مالک برو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 508.16,
   "end": 510.22,
   "text": "و فاتح برگرد، رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 510.22,
   "end": 512.84,
   "text": "فرمود این قرآن‌ها رو می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 512.84,
   "end": 520.82,
   "text": "بزن بنداز. قرآن اینا. واقعاً جیگر میخواد آدم تصور کنید شما با شمشیر قرآن رو بزنی بندازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 520.82,
   "end": 523.34,
   "text": "تصورش مشکله. آدم تنش میلرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 523.34,
   "end": 527.04,
   "text": "بابا میگه قرآن رو رو پات نذار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 527.04,
   "end": 528.92,
   "text": "چه برسه بزنی با شمشیر بندازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 528.92,
   "end": 533.42,
   "text": "بابا یه ذره فکر کنیم به این‌ها تو عالم خیال وجودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 533.42,
   "end": 536.22,
   "text": "واقعاً تسلیم محض امام باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 536.22,
   "end": 540.9,
   "text": "همه هم پینه بسته این پینشونی‌ها، اهل-- میدونه دیگه میشناسه اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 540.9,
   "end": 545.08,
   "text": "بعضیاشون از فقهای زمانن حافظ قرآن چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 545.08,
   "end": 547.52,
   "text": "خسته تون نکنم. مالک میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 547.52,
   "end": 549.52,
   "text": "یه قدمیه خیمه معاویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 549.52,
   "end": 553.32,
   "text": "یعنی کار تمومه. یه قدم دیگه بره جلو معاویه رو زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 553.32,
   "end": 559.6,
   "text": "علم رو انداخته. خبر رسید مالک، امیرالمؤمنین فرمود برگرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 559.6,
   "end": 562.04,
   "text": "خوارج منو محاصره کردن برگرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 562.04,
   "end": 566.34,
   "text": "چشم. اصلاً چون یک لحظه، یک آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 566.34,
   "end": 570.16,
   "text": "نمیگه بابا آخه امیرالمؤمنین الان جاش بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 570.16,
   "end": 572.3,
   "text": "این حرفا چیه؟ تسلیم محض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 572.3,
   "end": 575.7,
   "text": "سریع برمی‌گرده. برمی‌گرده میره کمک آقاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 575.7,
   "end": 579.98,
   "text": "هرچی امام بگه. کد خدا وکیلی کدوم یکی از ما اینطوری هستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 579.98,
   "end": 582.5,
   "text": "من خلاصه مطلب رو تو یه جمله بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 582.5,
   "end": 589.56,
   "text": "هر میزان، می‌ترسیم از این حرفام عیبی نداره بترسیم چون پشتوانه ش قرآن بود میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 589.56,
   "end": 591.82,
   "text": "شاید جایی هم این حرفو پیدا نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 591.82,
   "end": 596.42,
   "text": "با زرص قاطع با پشتوانه قرآن عرض می‌کنم حدیث نفس برای خودم و به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 596.42,
   "end": 600.08,
   "text": "هر مقدار از حقیقت و باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 600.08,
   "end": 604.22,
   "text": "صلوات که همون تسلیم محض امام بودن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 604.22,
   "end": 608.68,
   "text": "فاصله گرفتیم، همون مقدار ما ورود به نفاق کرده قلبمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 608.68,
   "end": 613.42,
   "text": "دو رو هستیم. به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 613.42,
   "end": 616.36,
   "text": "به همین قاطعیت می‌تونم اینو رو بیان کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 616.36,
   "end": 622.78,
   "text": "ان شا الله خدا به دادمون برسه و عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 622.78,
   "end": 629.72,
   "text": "اللهم صل على محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}