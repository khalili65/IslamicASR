 },
 "chapters": [
  {
   "index": 0,
   "title": "## وضو پیش از دخول وقت",
   "start": 13.66,
   "end": 48.98
  },
  {
   "index": 1,
   "title": "## سرفصل قلب منافق",
   "start": 48.98,
   "end": 156.86
  },
  {
   "index": 2,
   "title": "## دوگانگی زبان و دل",
   "start": 156.86,
   "end": 620.67
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 2.38,
   "text": "رحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.38,
   "end": 6.1,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.1,
   "end": 10.1,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.1,
   "end": 13.16,
   "text": "استفتاحی که از رهبر عزیزمون شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.16,
   "end": 17.26,
   "text": "پیرامون اینکه آیا میشه قبل از اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.26,
   "end": 21.14,
   "text": "وقت نماز داخل بشه ما به نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.14,
   "end": 29.4,
   "text": "نماز وضو بگیریم؟ استفتاهای جالبی یعنی این‌ها این دقایق، این لطائف و دقت نظرها رو همه ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.4,
   "end": 33.6,
   "text": "طرف صبح وضو می‌گیره با همون نماز ظهر می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.6,
   "end": 37.86,
   "text": "برای نماز صبحو نمیگما همینطوری صبح مثلا هشت صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.86,
   "end": 42.72,
   "text": "یهو عشقش می‌کشه وضو بگیره خیلی هم خوب اما با همون میره نماز می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.72,
   "end": 48.98,
   "text": "نماز ظهر رو. میشه؟ خب این کی میره فکر کنه به این، دقت کنه به این چیزها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.98,
   "end": 51.8,
   "text": "یه کسی که دین براش ارزش داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.8,
   "end": 54.16,
   "text": "سؤال شده از رهبر که چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.16,
   "end": 60.0,
   "text": "آقا فرمودن فقط در صورتی میشه که اون وقت به اذان نزدیک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.0,
   "end": 62.7,
   "text": "دیگه نگفتن چند ساعت. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.7,
   "end": 65.94,
   "text": "عرف بگه آقا نزدیک اذانه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.94,
   "end": 71.8,
   "text": "مثلا یه ساعت فکر می‌کنم دیگه مثلا عرف بگه یک ساعت به اذان دیگه نزدیک اذانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.8,
   "end": 77.2,
   "text": "ولی قبل از این تو نمی‌تونی به نیت نماز ظهر بری وضو بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.2,
   "end": 82.32,
   "text": "اگر خیلی مونده. می‌تونی مستحبی همینطوری وضو بگیری خیلی هم خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.32,
   "end": 85.1,
   "text": "بعدا با همون هم می‌تونی نماز ظهرتو بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.1,
   "end": 87.92,
   "text": "اما به نیت نماز ظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.92,
   "end": 90.46,
   "text": "فقط وقتی می‌تونی وضو بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.46,
   "end": 93.82,
   "text": "که نزدیک باشه. اینو دقت بفرمایید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.82,
   "end": 98.7,
   "text": "اما بحث قلب ما در قرآن رسیده به بحث جدیدمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.7,
   "end": 100.38,
   "text": "که یه مقدار خطرناک هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.38,
   "end": 104.6,
   "text": "خب ما یک قلب، قلب خوب رو بررسی می‌کنیم، یک قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.6,
   "end": 108.24,
   "text": "بد. حالا الان قلب مخبت که تموم شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.24,
   "end": 110.6,
   "text": "قلب‌های خوب بود خیلی خوب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.6,
   "end": 113.18,
   "text": "حالا می‌رسیم به سرفصل قلب منافق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.18,
   "end": 115.94,
   "text": "آخ، آخ، آخ! امان از این قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.94,
   "end": 118.7,
   "text": "قلب منافق، قلب دو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.7,
   "end": 122.0,
   "text": "و خیلی بده، خیلی. جزو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.0,
   "end": 128.0,
   "text": "متأسفانه مرض‌های قلبیه که خیلی درمانش سخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.0,
   "end": 133.78,
   "text": "و برای همینم اصلاً جهت درمانش خدا شدید رفتار می‌کنه با آدمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.78,
   "end": 135.86,
   "text": "گرفتار همچین مرضی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.86,
   "end": 137.8,
   "text": "شدید، شدید العقاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 137.8,
   "end": 140.66,
   "text": "اصلاً شدید العقاب خدا مال اینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 140.66,
   "end": 148.14,
   "text": "مال قلب منافقه. اینطوری نیست که خدا پدر کشتگی داشته باشه با بنده‌ش که حتی می‌خواد منافق رو هم اصلاح کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.14,
   "end": 150.68,
   "text": "خدا لذا شدت می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.68,
   "end": 153.92,
   "text": "تشع شدید برای اینکه درستش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.92,
   "end": 160.72,
   "text": "حالا یکی از آیاتی که پیرامون این و خیلی این آیه پر رمز و رازه مفسرین اوف، اوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.72,
   "end": 163.76,
   "text": "من امروز بررسی می‌کردم چه حرفایی که نزدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.76,
   "end": 168.16,
   "text": "خیلی عجیبه. حالا ما فرصت که نداریم تبرکاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.16,
   "end": 172.72,
   "text": "یک بخش آیه رو بخونم. آیه چهل و یک surah Maeedh برید خودتون ملاحظه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.72,
   "end": 175.28,
   "text": "و خوشا به حال اونایی که قبول می‌کنند حرف ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 175.28,
   "end": 178.82,
   "text": "میگیم برید از این گوش نمیره از اون گوش در کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.82,
   "end": 181.48,
   "text": "واقعاً میرن نگاه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.48,
   "end": 189.58,
   "text": "یک بخش آیه می‌فرماید که حالا اولش می‌فرماید \"یا ایها الرسول لا يحزنک الذين يسارعون في الكفر\" عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.58,
   "end": 193.58,
   "text": "پیغمبر محزونت نکنه سرعت گرفتن اینایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.58,
   "end": 195.84,
   "text": "حالا تو کفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 195.84,
   "end": 199.44,
   "text": "خیلی سریع به سمت کفر حرکت می‌کنند که این خودشه دو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 199.44,
   "end": 201.64,
   "text": "هشداره چون بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.64,
   "end": 204.36,
   "text": "آیه منافقینه میگه می‌خواد بگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 204.36,
   "end": 207.9,
   "text": "نفاق تو رو به سرعت به سمت کفر می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 207.9,
   "end": 212.7,
   "text": "دو رویی. \"من الذين\" حالا اینا کیان که سرعت در کفر می‌گیرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 212.7,
   "end": 217.08,
   "text": "\"من الذين قالوا امنا بافواههم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 217.08,
   "end": 220.66,
   "text": "اینا به زبونشون میگن آمنا ما ایمان آوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.66,
   "end": 222.7,
   "text": "\"ولا تؤمن قلوبهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 222.7,
   "end": 225.1,
   "text": "الله اکبر. اشکال اینجا ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 225.1,
   "end": 231.52,
   "text": "مرض اینجا ایجاد شده که این‌ها تو دلشون ایمان رسوخ نکرده، زبانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 231.52,
   "end": 237.94,
   "text": "این خیلی مرض بدیه. اصلاً این کرمی که تو وجود انسانه از کرم نفاق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.94,
   "end": 242.68,
   "text": "از کرم شهوت و از کرم غضب بدتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 242.68,
   "end": 249.94,
   "text": "بعضیا شاخک‌هاشون اصلاً تیز نمی‌شه تا من تو صحبت‌هام یه اسم عجیب غریبی مثل کرم نیارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.94,
   "end": 254.48,
   "text": "هرچی حرفای خوب و معنوی و اصطلاح فلسفی و حکمی ببری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.48,
   "end": 260.06,
   "text": "اصلا حواسش جایی نیست. تا میگم کرم هم که یهو می‌خنده یعنی خب شاخک‌هاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.06,
   "end": 262.38,
   "text": "چیز شد گیرنده‌هاش...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.38,
   "end": 266.42,
   "text": "این خوبه. بالاخره ما هم باید بدونیم چجوری حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.42,
   "end": 271.64,
   "text": "عزیز دلم اصلاً کار خدا همینه که کرم‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.64,
   "end": 278.64,
   "text": "در درون ما رو ها می‌خواد از اعم از شهوت باشه، کرم غضب باشه، کرم شیطنت باشه، اینا رو بکشه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.64,
   "end": 281.02,
   "text": "حالا تو این دنیا نشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.02,
   "end": 285.08,
   "text": "وقت سکرات مرگ نشد، تو عالم برزخ نشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.08,
   "end": 288.06,
   "text": "نفخ صور نشد، قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.06,
   "end": 290.76,
   "text": "صغری، کبری همینجوری برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.76,
   "end": 293.76,
   "text": "کار خدا اینه. هم-- مثل که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.76,
   "end": 297.94,
   "text": "خدا حفظ کنه حضرت استاد علامه حسن زاده حفظه الله تعالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.94,
   "end": 303.3,
   "text": "مثال جالبی پیرامون مراقبه می‌زنن ایشون و شدت حضور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 303.3,
   "end": 305.2,
   "text": "اصلاً، اصلاً فلسفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.2,
   "end": 307.18,
   "text": "حکمت عبادت یعنی حضور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.18,
   "end": 312.52,
   "text": "اینکه انسان به حضور برسه، غافل نباشه، بدونه در محضر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 312.52,
   "end": 314.14,
   "text": "عالم محضر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.14,
   "end": 316.12,
   "text": "در محضر خدا معصیت نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 316.12,
   "end": 321.16,
   "text": "حرف امام تمام سیر و سلوک رو جمع کرده همین یه جمله از ته امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.16,
   "end": 323.26,
   "text": "حالا یه پرنده...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.26,
   "end": 327.12,
   "text": "الان ما وقتی که جراحتی، کرمی تو بدنمون می‌زنه، میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.12,
   "end": 330.48,
   "text": "دست ج-- خودمون رو دست طبیب و جراح می‌سپاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.48,
   "end": 333.44,
   "text": "حیوانات چی کار می‌کنند؟ حیوانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 333.44,
   "end": 336.98,
   "text": "جالبه که بدونید خدا پرنده‌های مخصوصی رو خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.98,
   "end": 338.64,
   "text": "اینا جراحن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.64,
   "end": 340.98,
   "text": "هستن تو مناطق مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.98,
   "end": 344.82,
   "text": "نوک‌های خیلی بلند و تیزی مثل چاقو جراحی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 344.82,
   "end": 348.6,
   "text": "و کارشون خوردن این کرم‌هاییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.6,
   "end": 353.06,
   "text": "وقتی یک بدن یک حیوونی مریض میشه مثلا جراحتی پیدا می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.06,
   "end": 356.02,
   "text": "آلودگی محیط باعث می‌شه که کرم بزنه تو این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 356.02,
   "end": 360.74,
   "text": "خب این چی‌کار کنه؟ مثل ما که نمی‌تونه بره پزشک و جراح و اتاق عمل که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.74,
   "end": 363.29,
   "text": "خب می‌میره بدبخت. خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 363.29,
   "end": 366.35,
   "text": "تکویناً این پرنده‌ها رو ایجاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 366.35,
   "end": 368.67,
   "text": "جالبه که حالا کی اینا رو هدایت میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 368.67,
   "end": 371.17,
   "text": "چه اعم از اون حیوان مجروح رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 371.17,
   "end": 375.83,
   "text": "چه این پرنده رو که این حیوان بره کجا بشینه، اون پرنده چجوری بیاد تشخیص بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 375.83,
   "end": 378.61,
   "text": "اینا دیگه الله اعلم حکمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 378.61,
   "end": 384.67,
   "text": "میره این پرنده جراحتو پیدا میکنه، میشینه رو اونجا و با این نوک تیزش شروع میکنه کرم‌ها رو بیرون آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 384.67,
   "end": 387.01,
   "text": "نه سرری کرده، نه هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 387.01,
   "end": 389.09,
   "text": "این حیوان باید درد رو تحمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 389.09,
   "end": 391.27,
   "text": "تکون اگه بخوره اون پرنده میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 391.27,
   "end": 393.53,
   "text": "لوسه، خیلی نازش زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 393.53,
   "end": 395.99,
   "text": "مثل پرنده‌ی حضوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 395.99,
   "end": 400.87,
   "text": "یک لحظه غافل بشی خدا تو قرآن سوره قیامت میگه \"لا تحرک به لسانک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 400.87,
   "end": 405.65,
   "text": "پیغمبر وقتی بهت دارم آیه رو القا میکنم لبت هم حتی تکون نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 405.65,
   "end": 407.23,
   "text": "از اون حالت تمرکز میای بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 407.23,
   "end": 411.57,
   "text": "لطافت سر به هم میریزه. تکون بخوری میره، ناز میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 411.57,
   "end": 415.11,
   "text": "باید بشینه یک یک این کرم‌ها رو بیرون بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 415.11,
   "end": 419.91,
   "text": "به این حالت که قبلاً بحث کردیم میگن حالت اخبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 419.91,
   "end": 423.35,
   "text": "اینکه تکون نمیخوره، طرف خودشو در اختیار قرار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 423.35,
   "end": 431.99,
   "text": "حالا این کرم‌ها رو همونطور که ملا محسن فیض کاشانی قبلاً از کریم در کتاب مهجت البعیدات می‌فرمود انسان چهار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 431.99,
   "end": 435.23,
   "text": "قوه تو وجودش داره. قوه شیطنت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 435.23,
   "end": 437.97,
   "text": "قوه شهوت و غضب و حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 437.97,
   "end": 444.73,
   "text": "بعد اینا رو توضیح میده. معمولاً کرم شهوت راحت از وجود میره بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 444.73,
   "end": 446.87,
   "text": "کرم غضب راحت میره بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 446.87,
   "end": 449.93,
   "text": "سخته البته من میگم سخته واقعاً سخته ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 449.93,
   "end": 453.05,
   "text": "اما نسبت به کرم نفاق راحت‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 453.05,
   "end": 455.53,
   "text": "با یه مشکلی، با مصائب و با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 455.53,
   "end": 461.09,
   "text": "م-مثلاً م-- مشکلاتی که در زندگی پیش میاد متفاوته، اینا برطرف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 461.09,
   "end": 463.75,
   "text": "اما، اما این کرم نفاق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 463.75,
   "end": 467.47,
   "text": "کرف-- کرم دورویی این خیلی دیر برطرف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 467.47,
   "end": 471.59,
   "text": "انقدر باید این پرنده بیاد بشینه، انقدر انسان به حضور بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 471.59,
   "end": 476.87,
   "text": "انقدر نماز بخونه که حس حضور بگیره، انقدر حرم بره، حس حضور بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 476.87,
   "end": 479.85,
   "text": "اصلاً حظ-- زیارت یعنی حضور ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 479.85,
   "end": 484.25,
   "text": "ببینید حضور، حضور ظاهر عند المظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 484.25,
   "end": 486.91,
   "text": "بره واقعاً در محضر امام قرار بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 486.91,
   "end": 491.13,
   "text": "تکون هم نخوره. اصلاً از خودش لام تا کام حرف نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 491.13,
   "end": 495.63,
   "text": "خودش رو م-- دست امامش بسپره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 495.63,
   "end": 498.65,
   "text": "و بگه آقا من اومدم کرم‌های وجودم رو بکشی بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 498.65,
   "end": 501.11,
   "text": "دیگه دردش هرچی هست رو باید تحمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 501.11,
   "end": 504.79,
   "text": "دردهای مختلف داره. یه وقت می‌بینی باید از یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 504.79,
   "end": 509.27,
   "text": "وجاهتی، از یک منصبی، از یک مدیریتی، از یک چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 509.27,
   "end": 513.39,
   "text": "بکنه بره. مثلاً امام صادق، یه داستان کوچولو بگم و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 513.39,
   "end": 516.53,
   "text": "ببینید سخته‌ها ولی امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 516.53,
   "end": 519.39,
   "text": "هرکیو بخوان تأدیب کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 519.39,
   "end": 522.63,
   "text": "شاید ما لیاقت-- ما نتونیم واقعاً کشششو نداشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 522.63,
   "end": 526.19,
   "text": "اما اگر بخوایم نجات پیدا کنیم باید بسپاریم خودمون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 526.19,
   "end": 531.63,
   "text": "کارهای عجیبی می‌گفتن. امام صادق علیه السلام یکی از دوستانش وارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 531.63,
   "end": 534.99,
   "text": "حوزه درسی‌شون حالا اونجایی که حضرت بودن شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 534.99,
   "end": 541.47,
   "text": "یک لحظه ایشون تعمل کرد که بیاد بالای مجلس بشینه یا اولین صدر ذیل مجلس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 541.47,
   "end": 544.89,
   "text": "باز هم رفت ذیل مجلس نرفت بالا بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 544.89,
   "end": 547.43,
   "text": "اما امام صادق بعد، بعد از جلسه خواستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 547.43,
   "end": 549.75,
   "text": "حالا اسمش از ذهنم رفته. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 549.75,
   "end": 554.35,
   "text": "از شاگردان خوب آقاست. حضرت فرمود چرا تعمل کردی یه لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 554.35,
   "end": 557.21,
   "text": "که بالای مجلس بشینم یا پایین مجلس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 557.21,
   "end": 561.57,
   "text": "پیداست که حالا به قول من بچه طلبه یه کرمی تو وجودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 561.57,
   "end": 564.57,
   "text": "این باید بیرون بیاد. این با چی بیاد، میاد بیرون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 564.57,
   "end": 569.23,
   "text": "باید بری شش ماه. این وضعیت مالی هم خیلی قوی بوده این طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 569.23,
   "end": 574.51,
   "text": "شش ماه بری تو بازار پرش-- رفت و آمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 574.51,
   "end": 577.21,
   "text": "شهر خرما فروشی کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.21,
   "end": 579.49,
   "text": "پست‌ترین شغل بوده اون موقع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 579.49,
   "end": 585.71,
   "text": "الان به من و شما بگن آقای مدیر کل، آقای مدیر فلان، آقای مسئول فلان، آقای آخوند، آقای ف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 585.71,
   "end": 588.03,
   "text": "اصلاً نه تو پدر یه خونواده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 588.03,
   "end": 590.93,
   "text": "برو دست‌فروشی کن شش ماه سر چهارراه نظام آباد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 590.93,
   "end": 593.39,
   "text": "خدا وکیلی کدوممون حاضریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 593.39,
   "end": 595.63,
   "text": "امام گفته باشه ها. نمیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 595.63,
   "end": 598.71,
   "text": "میگیم آقا، آقا، آخه فلان تموم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 598.71,
   "end": 601.67,
   "text": "ولی ایشون انجام داد که اون کرمه بیاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 601.67,
   "end": 605.83,
   "text": "نفاق خیلی مشکله. باید خودمون رو به دست حضرت بسپریم تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 605.83,
   "end": 610.31,
   "text": "انشاالله این برطرف شه. این بحث انشاالله به امید خدا ادامه خواهد داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 610.31,
   "end": 614.65,
   "text": "نساء حضرت حجت هر کجا هستن انشاالله یاد ما باشن صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 614.65,
   "end": 620.67,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
