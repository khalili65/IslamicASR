 "chapters": [
  {
   "index": 0,
   "title": "## پرز لباس نجس و پاک؛ اصل طهارت",
   "start": 15.92,
   "end": 94.18
  },
  {
   "index": 1,
   "title": "## منافقین؛ یقولون بافواههم",
   "start": 94.18,
   "end": 289.22
  },
  {
   "index": 2,
   "title": "## حضور؛ نقطۀ تحت الباء و خطر نفاق",
   "start": 289.22,
   "end": 439.54
  },
  {
   "index": 3,
   "title": "## نماز معراج؛ تخفیف از پنجاه به پنج",
   "start": 439.54,
   "end": 534.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.06,
   "end": 6.82,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.82,
   "end": 10.44,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.44,
   "end": 15.92,
   "text": "آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.92,
   "end": 19.22,
   "text": "از رهبر عزیز اِ-- استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.22,
   "end": 23.1,
   "text": "این پرزهایی که از لباس‌ها جدا میشه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.1,
   "end": 25.5,
   "text": "مثلا شما یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.5,
   "end": 31.84,
   "text": "سم-- سبدی دارید درش لباس‌های پاک و نجس رو با هم می‌ریزین که بعد شستشو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.84,
   "end": 39.02,
   "text": "حالا این ش-- لباس‌ها رو وقتی از داخل سبد برمی‌دارید داخل این سبد می‌بینید پر پرزه و مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.02,
   "end": 41.3,
   "text": "پشم لباسه و یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.3,
   "end": 44.12,
   "text": "نخ و این‌ها بقایای اون لباس‌ها مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.12,
   "end": 48.62,
   "text": "بعد می‌دونید که داخل این لباس‌ها هم لباس نجس بوده هم پاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.62,
   "end": 51.0,
   "text": "خب این بقایایی که مونده اینا چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.0,
   "end": 53.72,
   "text": "اینا نجسن، پاکن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.72,
   "end": 56.78,
   "text": "بنا بر اصل طهارت فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.78,
   "end": 59.26,
   "text": "بنا رو بذارید بر طهارت همه‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.26,
   "end": 62.14,
   "text": "چون شما نمی‌دونید که از چه لباسی جدا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.14,
   "end": 67.86,
   "text": "حتی فرمودن اگر شما بدونید که این پشم‌ها، این پرزها، این نخ‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.86,
   "end": 71.3,
   "text": "حتی اگه بدونید از لباس نجس جدا شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.3,
   "end": 75.56,
   "text": "اما از کدوم قسمت لباس نجس جدا شده رو نمی‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.56,
   "end": 81.12,
   "text": "از قسمت پاک لباس نجس جدا شده یا از قسمت نجس پاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.12,
   "end": 82.76,
   "text": "این لباس نجس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.76,
   "end": 87.42,
   "text": "همین که نمی‌دونید از چه قسمتی جدا شده باز بنا به اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.42,
   "end": 91.44,
   "text": "طهارت می‌فرمایند که بنا رو بذارید بر طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.44,
   "end": 94.84,
   "text": "نمی‌تونید بگید نجاست. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.84,
   "end": 98.96,
   "text": "آیه صد و شصت و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.96,
   "end": 108.24,
   "text": "سوره آل عمران یه نکته‌ای البته تو همون آیه قبلی هم که در، در بحث قلب منافق کار کردیم این نکته هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.24,
   "end": 110.68,
   "text": "حالا ما این تیکه رو انتخاب کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.68,
   "end": 116.0,
   "text": "که می‌فرماید یه نکته ظریف و دقیقی رو اینجا قرآن داره اشاره می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.0,
   "end": 120.9,
   "text": "از حالات منافقین که می‌فرماید: \"یقولون بأفواههم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.9,
   "end": 124.8,
   "text": "اینا چیزی رو به زبونشون جاری می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.8,
   "end": 127.4,
   "text": "که \"ما ليس في قلوبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.4,
   "end": 133.74,
   "text": "این تو دلشون نیست. این یکی از نشانه‌های مبرهن نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.74,
   "end": 136.58,
   "text": "که البته قبلاً عرض کردیم نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.58,
   "end": 139.72,
   "text": "همونطور که ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.72,
   "end": 142.4,
   "text": "درجات داره نفاق هم درکات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.4,
   "end": 146.5,
   "text": "یکی کمتر یکی بیشتر. ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.5,
   "end": 150.34,
   "text": "باید مراقب بود که به سنت استدراج یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.34,
   "end": 158.8,
   "text": "اِاِاِ اون خطوه خطوه یا به قول حضرت امام وجب به وجب شیطان ما رو به سمت نفاق اکبر بزرگ می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.8,
   "end": 161.12,
   "text": "نفا-- نفاق جلی، دو رویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.12,
   "end": 165.06,
   "text": "حالا اینجا دقت بفرمایید همین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.06,
   "end": 169.64,
   "text": "خدا در قرآن می‌فرماید این‌ها اون چیزی که دارن به زبونشون ایجاد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.64,
   "end": 171.64,
   "text": "وارد می‌کنند، جاری می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.64,
   "end": 175.74,
   "text": "تو قلبشون نیست. این یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.74,
   "end": 180.32,
   "text": "هنوز این‌ها به حالت حضور نرسیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.32,
   "end": 187.26,
   "text": "یعنی چی؟ یعنی الان که اینجا دارن به زبونشون جاری می‌کنند کلمات حق رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.26,
   "end": 189.94,
   "text": "گمان می‌کنند که الان اینجا خدا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.94,
   "end": 192.52,
   "text": "وقتی میرن تو خلوت‌شون یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.52,
   "end": 195.08,
   "text": "پیش دیگران عکس اونو میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.08,
   "end": 197.64,
   "text": "فکر می‌کنند اونجا خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.64,
   "end": 202.5,
   "text": "یعنی در حقیقت این‌ها به توحید نرسیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.5,
   "end": 205.3,
   "text": "اگر هم قائل باشند که خدا وجود داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.3,
   "end": 209.28,
   "text": "خدا توحید عددی رو اینا قبول دارند نه توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.28,
   "end": 213.32,
   "text": "صمدی رو. یعنی اینطور نمی‌دونن که همه جا خدا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.32,
   "end": 216.4,
   "text": "هیچ جا بدون خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.4,
   "end": 221.68,
   "text": "موجودات رو جدای از وجود واجب الوجود فرض کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.68,
   "end": 224.34,
   "text": "این یک درد، یک مرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.34,
   "end": 227.16,
   "text": "درونی، قلبی و عقیدتیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.16,
   "end": 230.84,
   "text": "که اگر ریز بشیم می‌بینیم خیلی‌هامون گرفتارشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 230.84,
   "end": 234.26,
   "text": "عدم حضور. چطور میگیم خیلی‌هامون گرفتارشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.26,
   "end": 237.34,
   "text": "چون می‌بینید نمازمون حضور قلب نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.34,
   "end": 243.7,
   "text": "چرا حضور قلب نداره؟ چون که قائل نیستیم که الان خدا اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.7,
   "end": 248.2,
   "text": "اگه خدا اینجا هست و ما در محضر حضور خدا حاضر شدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.2,
   "end": 250.26,
   "text": "چطور حواسم جای دیگه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.26,
   "end": 253.04,
   "text": "چطور اصلاً لذت از نماز نمی‌برم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.04,
   "end": 256.48,
   "text": "چطور این الصلاة معراج المؤمن برای من معراج نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.48,
   "end": 259.4,
   "text": "چرا؟ یه بار بشینیم فکر کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.4,
   "end": 261.78,
   "text": "دلیلش اینه که ما به حضور نرسیدیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.78,
   "end": 266.16,
   "text": "یعنی هنوز خدا رو اینجا حاضر نمی‌دونیم که ما در محضرشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.16,
   "end": 269.12,
   "text": "یا اگر در خلوت گناه می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.12,
   "end": 273.08,
   "text": "علتش اینه که اونجا رو خالی از خدا فرض کردم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.08,
   "end": 276.64,
   "text": "حالا این‌ها عرض کردم درکات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 276.64,
   "end": 279.1,
   "text": "یعنی اینطور نیست که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 279.1,
   "end": 283.74,
   "text": "به یک اندازه دچار و گرفتار این مریضی عقیدتی باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.74,
   "end": 285.94,
   "text": "نه یکی کمتر یکی بیشتر هم باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 285.94,
   "end": 287.7,
   "text": "مراقب بود و تسویه کرد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 287.7,
   "end": 293.2,
   "text": "باید شروع کرد. اصلاً بزرگان اهل معرفت، حکما فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.2,
   "end": 296.5,
   "text": "مگر نه فرمودن همه قرآن در فاتحة الكتاب جمعه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 296.5,
   "end": 300.92,
   "text": "مگر نه فرمودن فاتحة الكتاب در بسم الله الرحمن الرحیم جمعه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 300.92,
   "end": 304.36,
   "text": "مگر حدیث نه فرمودن که بسم الله الرحمن الرحیم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.36,
   "end": 309.76,
   "text": "باش جمعه و همه اون در نقطه‌ی زیرش جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 309.76,
   "end": 313.9,
   "text": "به یک تعبیر مولا فرمودند ان نقطة تحت الباء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.9,
   "end": 321.08,
   "text": "اما تمام بزرگان اهل معرفت فرمودن اون نقطه و اون چیزی که ما باید بهش برسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.08,
   "end": 326.74,
   "text": "و همه‌ی قرآن، همه‌ی اهل بیت اومدن ما رو به اون برسونن چیزی نیست جز حضور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.74,
   "end": 332.22,
   "text": "درک حضور. اینکه انسان به حضور برسه بعد سلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.22,
   "end": 335.3,
   "text": "اگر کسی به حضور نرسیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.3,
   "end": 337.26,
   "text": "حالا اون شدت و حدت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.26,
   "end": 343.7,
   "text": "اما همین که به هر میزانی که به حضور نرسیده در خطر نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.7,
   "end": 350.24,
   "text": "وقتی حرفش دو تا میشه، عملکردش مطابق با هم نیست، خلوت و جلوتش با هم فرق می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.24,
   "end": 353.92,
   "text": "یعنی یه جا رو خدا فرض کرده حاضر بوده، یک جا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.92,
   "end": 357.12,
   "text": "فرض کرده که حاضر نیست. این یعنی نفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.12,
   "end": 359.62,
   "text": "دقت بفرمایید رو این خیلی ریز بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.62,
   "end": 362.22,
   "text": "یه چند وقت هست من خودم دارم ریز میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.22,
   "end": 366.18,
   "text": "خیلی در خصوص خودم چیزای عجیبی پیدا کردم تو زندگیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.18,
   "end": 369.12,
   "text": "تو اعمال و رفتار و افکار و حتی عقائدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.12,
   "end": 372.68,
   "text": "شما هم ریز بشید ببینید به چی می‌رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 372.68,
   "end": 376.32,
   "text": "اینکه ما نمازمون معراج نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 376.32,
   "end": 382.52,
   "text": "پیغمبر جالبه که بدونید وقتی به قول م-مرحوم مجلسی روایت داره که وقتی پیغمبر رفت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.52,
   "end": 388.36,
   "text": "معراج و برگشت از اون صد و بیست معراجی که مرحوم شیخ طوسی رحمت الله علیه در امالی خودش به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.36,
   "end": 391.44,
   "text": "پیغمبر نسبت میده، یه معراج اصلیشون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.44,
   "end": 398.62,
   "text": "رفتند و برگشتن که شهید دستغیب هم یه کتاب پیرامونش نوشته، کتاب معراج، تفسیر سوره النجم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.62,
   "end": 401.5,
   "text": "وقتی پیغمبر برمی‌گشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.5,
   "end": 406.4,
   "text": "تو آسمون چهارم حضرت موسی علی نبی و آله و علیه الصلاة والسلام رو دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.4,
   "end": 409.72,
   "text": "اونجا حضرت موسی فرمودن کجا بودید یا رسول الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.72,
   "end": 411.6,
   "text": "فرمودن رفته بودم معراج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.6,
   "end": 416.34,
   "text": "به شدت حضور پیغمبر رسیده بود به حضور طام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.34,
   "end": 418.12,
   "text": "که میگه اونجا من حیرت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.12,
   "end": 425.56,
   "text": "یه جا می‌فرماید خدا، به خدا عرض می‌کنه پیغمبر رب زدنی علما، یه جا می‌فرماید رب زدنی فیک تحیرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.56,
   "end": 427.46,
   "text": "حیرت من را در خودت زیاد کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.46,
   "end": 429.82,
   "text": "این حیرت یعنی همون حس حضور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.82,
   "end": 434.24,
   "text": "چنان حضور تو رو درک کنم که به حیرت بیفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 434.24,
   "end": 437.18,
   "text": "حضرت موسی دید پیغمبر خیلی خوشحاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.18,
   "end": 439.4,
   "text": "چرا خوشحالی شما اینقدر یا رسول الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 439.4,
   "end": 444.34,
   "text": "از معراج داره برمی‌گرده. پیغمبر فرمودن که برای امتم هدیه آوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 444.34,
   "end": 446.62,
   "text": "چی آوردی؟ پنجاه تا نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.62,
   "end": 450.28,
   "text": "نماز. نماز هدیه معراج پیغمبر به ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.28,
   "end": 456.36,
   "text": "که حالا اونجا حضرت موسی گفت‌وگو کردن که امت من که اون همه قدرتشون بیشتر از امت شما بود تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.36,
   "end": 458.12,
   "text": "دستورات الهی کم آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 458.12,
   "end": 461.42,
   "text": "پنجاه تا نماز شما یا رسول الله این‌ها می‌برن و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.42,
   "end": 468.0,
   "text": "حالا پیغمبر در حقیقت در افق وجودی خودش که حضرت موسی یکی از شعون وجودی پیغمبره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.0,
   "end": 472.34,
   "text": "حضرت خلوت کرد با خودش اینطوری بگیم بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.34,
   "end": 476.5,
   "text": "اما رفت دو مرتبه معراج از خدا درخواست تخفیف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 476.5,
   "end": 479.2,
   "text": "کمترش کرد. دو مرتبه حضرت موسی گفت‌وگو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 479.2,
   "end": 481.98,
   "text": "رفت دوباره برگشت. دو مرتبه گفت‌وگو رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.98,
   "end": 484.02,
   "text": "در نهایت پنج تا نماز آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 484.02,
   "end": 486.82,
   "text": "قرار بود ما پنجاه تا نماز بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 486.82,
   "end": 488.42,
   "text": ". تو پنج تاش الان گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 488.42,
   "end": 490.9,
   "text": "حضرت موسی دستش درد نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.9,
   "end": 495.74,
   "text": ". ما رو نجات داد. اینکه میگن بهانه‌های بنی اسرائیل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 495.74,
   "end": 498.46,
   "text": "این اصلاً تو وجود پیغمبرشون هم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 498.46,
   "end": 502.36,
   "text": "هی پیغمبر، آخه بابا زیاده برو کمش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 502.36,
   "end": 504.5,
   "text": "رفت دوباره در محضر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.5,
   "end": 506.56,
   "text": "حالا اون طرفی نریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 506.56,
   "end": 510.08,
   "text": "آخه غرض اینکه نماز معراج ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 510.08,
   "end": 513.62,
   "text": "خب پس چرا ما به اون عروج نمی‌رسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.62,
   "end": 516.94,
   "text": "چرا تو همین پنج تا؟ چون به حضور نرسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 516.94,
   "end": 521.02,
   "text": "تا به حضور نرسیم در معرض نفاق و دو رویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 521.02,
   "end": 523.96,
   "text": "در عقیده و اخلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 523.96,
   "end": 527.0,
   "text": "و اعمال هستیم. خیلی مراقب باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 527.0,
   "end": 534.18,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد. سلام بر محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}