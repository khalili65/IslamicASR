 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتا؛ مبدأ مسافت شرعی",
   "start": 14.88,
   "end": 35.0
  },
  {
   "index": 1,
   "title": "## الخیانة رأس النفاق",
   "start": 35.0,
   "end": 101.06
  },
  {
   "index": 2,
   "title": "## امانت ولایت اهل بیت",
   "start": 101.06,
   "end": 167.98
  },
  {
   "index": 3,
   "title": "## بلایای طبیعی و مکافات خیانت",
   "start": 167.98,
   "end": 551.49
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.14,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.14,
   "end": 8.26,
   "text": "السلام علیک یا داعی الله و ربانی ایه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.26,
   "end": 11.38,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.38,
   "end": 17.8,
   "text": "یکی دیگه از استفتاهات که پیرامون مسافت شرعیه اینه که از رهبر عزیزمون سؤال شده که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.8,
   "end": 23.14,
   "text": "وقتی می‌خوایم مسافت شرعی رو از مبدا تا مقصد حساب کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.14,
   "end": 25.3,
   "text": "از کجا حساب کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.3,
   "end": 28.26,
   "text": "جواب اینه که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.26,
   "end": 31.72,
   "text": "آخرین خانه شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.72,
   "end": 37.0,
   "text": "حالا یه استفتا دیگه هستش که اگر شهر با کارخونه جات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.0,
   "end": 39.06,
   "text": "این‌ها تموم شد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.06,
   "end": 46.08,
   "text": "بعضی شهرها اینطوریه صنعتی‌اند مثلا کارخونه جات همینطور ادامه دارن رشته‌وار بعد از منازل داخل اون شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.08,
   "end": 49.32,
   "text": "آقا فرمودن ملاک خانه‌هاست نه کارخانه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.32,
   "end": 53.24,
   "text": "اینا رو حواسمون باشه. یه حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.24,
   "end": 55.56,
   "text": "تکون دهنده عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.56,
   "end": 60.34,
   "text": "در کتاب شریف مستدرک الوسائل جلد چهارده صفحه چهارده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.34,
   "end": 66.24,
   "text": "امام صادق صلوات الله عليه فرمودن «الخيانة رأس النفاق».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.24,
   "end": 68.48,
   "text": "خیانت سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.48,
   "end": 70.98,
   "text": "نفاقه. همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.98,
   "end": 76.06,
   "text": "برای هر چیزی یه سری هست مثلا الحياء رأس الدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.06,
   "end": 78.86,
   "text": "سر دین حیاعه. روایت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.86,
   "end": 81.52,
   "text": "حالا سر نفاق چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.52,
   "end": 84.42,
   "text": "خیانته. یعنی اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.42,
   "end": 87.52,
   "text": "خیانت کرد قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.52,
   "end": 91.62,
   "text": "انسانیه که دچار نفاق شده، قلبش سر خورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.62,
   "end": 94.7,
   "text": "و هر چقدر این خیانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.7,
   "end": 99.18,
   "text": "به ارزش‌های اصیل‌تری باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.18,
   "end": 104.8,
   "text": "اون مکافاتشم بیشتره. ما در قرآن یه آیه داریم که انا عرضنا الامانة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 104.8,
   "end": 108.36,
   "text": "على السماوات والارض والجبال این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.36,
   "end": 111.06,
   "text": "اون امانتو قبلاً بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.06,
   "end": 113.26,
   "text": "چون اینجا داره میگه خیانت کردن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 113.26,
   "end": 116.5,
   "text": "خیانت کردن به چی؟ به همه چی امانات الهین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.5,
   "end": 119.04,
   "text": "لکن رأس الامانة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.04,
   "end": 122.62,
   "text": "ولایت اهل بیته. ذیل اون آیه قبلاً گفتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 122.62,
   "end": 125.4,
   "text": "فرمودن اون امانت ولایت ما اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 125.4,
   "end": 128.3,
   "text": "در زیارت جامعه کبیره هم می‌خونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 128.3,
   "end": 133.62,
   "text": "که شما به اون به اهل بیت عرض می‌کنیم والامانة المحفوظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.62,
   "end": 137.96,
   "text": "شما امانت محفوظه خدایید که پیرامون اون محفوظه بودن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 137.96,
   "end": 140.42,
   "text": "سه تا نکته قبلاً گفتیم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 140.42,
   "end": 145.12,
   "text": "در هر حال ولایت اهل بیت علیهم الصلاة والسلام بزرگترین امانتی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 145.12,
   "end": 148.38,
   "text": "خدای منان از طریق پیغمبرش به ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 148.38,
   "end": 151.58,
   "text": "ودیعه داده. قرآن و عترت دیگه خلاصش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 151.58,
   "end": 156.98,
   "text": "این‌ها بزرگ‌ترین اماناتن. اگر کسی خیانت کنه به این امانت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 156.98,
   "end": 161.72,
   "text": "این نشانه نفاقشه. حالا هر کی می‌خواد باشه، تو هر جایگاهی می‌خواد باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 161.72,
   "end": 166.1,
   "text": "و هر چقدر این خ-خیانت‌ها به ارزش‌های اصیل‌تریست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 166.1,
   "end": 170.92,
   "text": "مکافاتشم بدتره. ما گاهی اوقات تو کشورمون زلزله میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 170.92,
   "end": 179.1,
   "text": "سیل‌های عجیب میاد و اتفاقات عجیب و غریب میفته، بادهای تند و مهیب، جرات نمی‌کنیم بعضیامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 179.1,
   "end": 183.4,
   "text": "خودزنی می‌دونیم مثلا تف سر بالا جرات نمی‌کنیم حتی بعضی از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.4,
   "end": 189.84,
   "text": "عمامه به سر‌هایی مثل من جرات نمی‌کنیم بگیم که، جر-جرأت نداریم که بگیم بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.84,
   "end": 194.66,
   "text": "عذابه. بابا این همه خیانت داره میشه، این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.66,
   "end": 199.04,
   "text": "گناه داره میشه، این همه بدحجابی که هیچی بی‌حجابی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.04,
   "end": 202.62,
   "text": "این همه خیانت به خون شهدا از بالا تا پایین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.62,
   "end": 208.14,
   "text": "بعد توقع داشته باشیم نه اینا رحمته ما بلد نیستیم استفاده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.14,
   "end": 211.5,
   "text": "البته از طرف خدا هرچی می‌رسه رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.5,
   "end": 213.68,
   "text": "اینکه بله ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.68,
   "end": 216.78,
   "text": "مکافات عمل خودت وقتی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 216.78,
   "end": 221.54,
   "text": "مکافات خیانتت باشه این دیگه عذابی که خودت باعثش شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.54,
   "end": 225.26,
   "text": "خودمون باعث شدیم. شما به من بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.26,
   "end": 228.4,
   "text": "حالا بعضیاشون میان سر این حرفا رو که می‌زنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.4,
   "end": 231.52,
   "text": "یه حرفای عجیب و غریبی می‌زنن خودشونم نمی‌فهمن چی میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.52,
   "end": 233.56,
   "text": "میگن چطور تو آمریکا نمیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.56,
   "end": 237.8,
   "text": "مگه اونجا تو انگلیس، تو آلمان کشورهایی که کفن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.8,
   "end": 239.78,
   "text": "مشرکن چرا اونجاها عذاب نمیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 239.78,
   "end": 242.62,
   "text": "اولاً اونجا هم میاد این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 242.62,
   "end": 245.3,
   "text": "جنگل‌هاشون چند هکتار سوخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 245.3,
   "end": 249.32,
   "text": "یا این همه بلاهای طبیعی اونجا هم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.32,
   "end": 252.32,
   "text": "حتی بعضی کارشناسا گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 252.32,
   "end": 257.62,
   "text": "اگر یه همچین سیل مهیبی که تو صد سال اخیر تو کشور ما بی-بی‌نظیر بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 257.62,
   "end": 261.26,
   "text": "توی حتی کار خود آمریکا اومده بود چ-چند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 261.26,
   "end": 264.04,
   "text": "بعضیا گفتن تا میلیون کشته می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.04,
   "end": 266.56,
   "text": "حالا ما نمیگیم میلیون، چند هزار تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 266.56,
   "end": 269.1,
   "text": "اینجوری نیست که ما فکر کنیم اونجا هم نمیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 269.1,
   "end": 272.88,
   "text": "اونجا هم داره میاد، زلزله میاد، باد میاد، سیل میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 272.88,
   "end": 276.66,
   "text": "اما من یه سؤال دارم از آقایی که این تحلیل رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 276.66,
   "end": 281.88,
   "text": "میگن که گناه کردن در خانه کعبه بدتره، مکافاتش سنگین‌تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 281.88,
   "end": 287.14,
   "text": "عذاب‌آورتره یا نه تو کوچه و خیابون و تو میکده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 287.14,
   "end": 289.82,
   "text": "قطعاً تو یک جای مقدس گناهش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 289.82,
   "end": 293.66,
   "text": "الان سیده‌ها چرا گناهاشون دو برابر دیگران نوشته میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 293.66,
   "end": 297.3,
   "text": "همونطور که ثوابشون دو برابر نوشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 297.3,
   "end": 299.72,
   "text": "شاخک‌ها تیز شد اینا که سیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 299.72,
   "end": 304.72,
   "text": "بله چرا؟ چون ذاتاً اینا ذاتی تقدس دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 304.72,
   "end": 308.06,
   "text": "مقدسن. چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.06,
   "end": 312.44,
   "text": "گفتن که بعضی از کارهایی که بیرون از مسجد کراهت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.44,
   "end": 316.86,
   "text": "یا حتی مباحه داخل مسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.86,
   "end": 321.0,
   "text": "کراهت سنگین داره که هیچی حتی بعضی از مراجع گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.0,
   "end": 327.94,
   "text": "حرام است. بعضی از مراجع دست زدن داخل مسجد رو، مگه دست زدن اشکالی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.94,
   "end": 332.74,
   "text": "یه امر مباحه حتی وقتی برای اهل بیت باشه خیلی هم خوبه آدم بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.74,
   "end": 335.86,
   "text": "توی هیئتش تو خونه‌ش شادی کنه برای اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.86,
   "end": 339.32,
   "text": "ولی میگه تو مسجد جایی که صیغه مسجد خوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.32,
   "end": 343.36,
   "text": "بعضی از مراجع حرام اعلام کردن اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 343.36,
   "end": 345.86,
   "text": "ببینید بعضیا مکروه اعلام کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.86,
   "end": 347.84,
   "text": "چرا؟ چون جای مقدسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 347.84,
   "end": 350.22,
   "text": "من می‌خوام بگم کدوم کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.22,
   "end": 352.9,
   "text": "شهید حججی داده؟ کدوم کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 352.9,
   "end": 359.34,
   "text": "شهدای مدافع حرم اینچنین با این صد، کدوم کشور حدود سیصد هزار خون داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 359.34,
   "end": 362.36,
   "text": "شوخیه مگه؟ این همه جانباز داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 362.36,
   "end": 365.97,
   "text": "این همه آبرو داده در راه اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 365.97,
   "end": 368.33,
   "text": "این همه پول داده، این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 368.33,
   "end": 371.33,
   "text": "آسیب دیده، این همه خانواده‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 371.33,
   "end": 375.15,
   "text": "پای این نظام، نظام مقدس، پای این ارزش‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 375.15,
   "end": 377.43,
   "text": "همه‌ی هستیشون رو دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.43,
   "end": 381.29,
   "text": "مگه شوخیه آدم هشت تا بچه‌ش، هفت تا بچه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 381.29,
   "end": 385.73,
   "text": "هر-- توی کوچه‌ی محله‌ی ما سیزده تا شهید داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 385.73,
   "end": 389.25,
   "text": "مگه شوخیه همه این همه عزیز بدن، خون بدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 389.25,
   "end": 392.71,
   "text": "بابا تو یه بچه‌ت میخوره زمین دیوونه میشی شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 392.71,
   "end": 394.85,
   "text": "بعد طرف بهترین عزیزانشو داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 394.85,
   "end": 396.85,
   "text": "من دیروز تلفنی با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 396.85,
   "end": 399.29,
   "text": "پدر شهید هججی گفت‌وگو می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 399.29,
   "end": 401.43,
   "text": "رفته بود ایشون مناطق سیل‌زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 401.43,
   "end": 405.61,
   "text": "جالب بود و اونجا بچه‌ها زنگ زدن خودشون به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 405.61,
   "end": 411.17,
   "text": "حالا خلاصه خیلی جالب بود برام که این پدر شهید ببینید چجوری موقعیت‌شناسی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 411.17,
   "end": 412.79,
   "text": "پا شده رفته مناطق سیل‌زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 412.79,
   "end": 416.81,
   "text": "پدر پیر یه شهید. آخه اینا همه زندگیشون خرج...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 416.81,
   "end": 419.85,
   "text": "بعد کسی بیاد خیانت به این ارزش‌ها بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 419.85,
   "end": 422.95,
   "text": "کدوم کشور یه همچین سرمایه‌هایی داشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 422.95,
   "end": 427.89,
   "text": "کدوم کشور نظام ولایی و اسلامی و حکومت ولایی داشته و داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 427.89,
   "end": 431.45,
   "text": "کدوم کشور؟ خب اینجا حکومتش ولایی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 431.45,
   "end": 435.97,
   "text": "اگه کسی اینجا خیانت کنه بدتر، مکافات سنگین‌تر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 435.97,
   "end": 442.27,
   "text": "لذا خیلی از بلاهایی که سر ما میاد شاید سر اون وریا هم میاد به خاطر اینکه خیانت ما بدج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 442.27,
   "end": 445.33,
   "text": "مکافاتی داره. توجه به این داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 445.33,
   "end": 448.31,
   "text": "ما تو مسجد، ما تو کعبه خیانت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 448.31,
   "end": 455.77,
   "text": "این خیلی سنگین‌تر از ک... یعنی من نمی‌دونم این مسئولینی که بعضیا خیانت می‌کنن حتی خیانت کشیده می‌شه به اینکه بغل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 455.77,
   "end": 460.19,
   "text": "مثلا بغل رودخونه بیاد طرف و این اصول شهرسازی هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 460.19,
   "end": 463.61,
   "text": "اونجا اجازه نباید بدن مجوز ساخت خونه نداده ولی می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 463.61,
   "end": 467.33,
   "text": "چرا؟ پول درمیاره. ها این، این خودش یه خیانته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 467.33,
   "end": 470.31,
   "text": "این‌ها، این از جزئیاش برو تا کلیاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 470.31,
   "end": 472.55,
   "text": "ببین اینا چجوری میخوان قیامت جواب بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 472.55,
   "end": 474.83,
   "text": "این همه خون دادیم، این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 474.83,
   "end": 480.03,
   "text": "مفقودالاثر دادیم، این همه جانباز دادیم، این همه مادر پدرای شهدا هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 480.03,
   "end": 484.99,
   "text": "بعضیاشون رو قبر بچه‌هاشون جون دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 484.99,
   "end": 491.27,
   "text": "مادر همین شهید پلارک خدا رحمتش کنه، شب‌ها چند و چند سال چقدر همش بالاسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 491.27,
   "end": 499.07,
   "text": "بچه‌ش بود تا صبح. یه شهید دیگه همون نزدیکا بود اسمش یادم نمیاد که تا آخر عمرش مادر پیرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 499.07,
   "end": 504.79,
   "text": "هشتاد-- اصلاً چادر زده بود. لعنتی‌ها بعضی مسئولین مسخره‌ش کرده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 504.79,
   "end": 508.23,
   "text": "اونجا زندگی کرد تا موت، همون بغل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.23,
   "end": 510.47,
   "text": "بدن بچه‌ش. شوخیه این‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 510.47,
   "end": 514.39,
   "text": "شهید؟ معروف بود به ننه علی ننه علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 514.39,
   "end": 518.69,
   "text": "آره یه مستندی هم ازش یه کوچولو تو فضای مجازی دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 518.69,
   "end": 522.37,
   "text": "رسانه که تعطیله متأسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 522.37,
   "end": 525.11,
   "text": "اینا سرمایه‌های نظامن بعد ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 525.11,
   "end": 526.79,
   "text": "چی بگم دل پره درد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 526.79,
   "end": 528.65,
   "text": "خلاصه مطلب وقتتونو نگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 528.65,
   "end": 534.25,
   "text": "اگر ما خیانتمون به ارزش‌ها باشه، مکافاتشم سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 534.25,
   "end": 537.13,
   "text": "حواسمون جمع باشه و این نشانه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 537.13,
   "end": 538.83,
   "text": "نفاقه، نفاق، نفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 538.83,
   "end": 541.55,
   "text": "خدا به ما رحم کنه. انشاالله عاقبت خطبه بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 541.55,
   "end": 544.95,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 544.95,
   "end": 546.99,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 546.99,
   "end": 551.49,
   "text": "صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}