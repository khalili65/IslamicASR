 },
 "chapters": [
  {
   "index": 0,
   "title": "## قصدِ ده روز و خروج از شهر",
   "start": 14.86,
   "end": 132.84
  },
  {
   "index": 1,
   "title": "## عادتِ اهلِ نفاق؛ غر زدن از نفهمیدنِ حقایق",
   "start": 132.84,
   "end": 153.32
  },
  {
   "index": 2,
   "title": "## سورهٔ ضحی؛ ما ودعک ربک وما قلی",
   "start": 153.32,
   "end": 419.56
  },
  {
   "index": 3,
   "title": "سورهٔ بعد با ضحی پیوند دارد؛ فقها گفته‌اند اگر ضحی خوانی انشراح را نیز بخوان:",
   "start": 419.56,
   "end": 457.64
  },
  {
   "index": 4,
   "title": "## قارون؛ امتحان در میانِ قومِ موسی",
   "start": 457.64,
   "end": 713.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.42,
   "end": 7.14,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.14,
   "end": 10.86,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.86,
   "end": 14.86,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.86,
   "end": 18.4,
   "text": "اگر کسی جایی قصد ده روز بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.4,
   "end": 20.66,
   "text": "و بخواد قطعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.66,
   "end": 23.76,
   "text": "ده تا بیست و چهار ساعتی جا بمونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.76,
   "end": 26.58,
   "text": "خب این مسافر حساب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.58,
   "end": 32.46,
   "text": "نکته اینجاست بعضیا این اشتباه رو میکنن، گمان میکنن مثل اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.46,
   "end": 37.38,
   "text": "وقتی تو وطن خودت هستی درسته اونجا ده روز قصد کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.38,
   "end": 44.28,
   "text": "دیگه مسافر نیستی اما مثل وطن خودت نیست که بتونی از شهر خارج بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.28,
   "end": 48.96,
   "text": "مثلا روزه‌ای از شهر خارج بشی بعد از ظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.96,
   "end": 53.4,
   "text": "قبل از اذان ظهر فردا برگردی به وطنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.4,
   "end": 56.64,
   "text": "درسته؟ این میشه مثلا شما روزه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.64,
   "end": 60.28,
   "text": "عصر میتونی از وطنت خارج بشی روزه اون روزت درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.28,
   "end": 65.26,
   "text": "فردا قبل از اذان ظهر برگردی به وطنت، اون روز هم میتونی روزه بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.26,
   "end": 69.24,
   "text": "اما این حکم توی ده روز قصد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.24,
   "end": 74.24,
   "text": "شما وقتی ده روز قصد مثلا رفتی انشاالله توفیق شه به زودی بریم نجف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.24,
   "end": 77.44,
   "text": "نجف قصد کردی ده روز بمونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.44,
   "end": 82.96,
   "text": "اونجا حق نداری بری کوفه حتی برای یک ساعت بری برگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.96,
   "end": 86.16,
   "text": "مسجد کوفه فقط یک شرط داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.16,
   "end": 89.42,
   "text": "اونم مراجع بل-بدون استثناء فرمودن فقط در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.42,
   "end": 95.42,
   "text": "صورتی میتونی بری برگردی که اون محل حالا نجف و مسجد سحل کوفه هرجا، اونجا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.42,
   "end": 98.76,
   "text": "جزو شهر نجف بدونن مردم اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.76,
   "end": 107.96,
   "text": "بگن آقا مثلا رفتی بپرسی آقا اینجا مسجد کوفه رو من میخوام برم بیام حدود پونزده کیلومتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.96,
   "end": 111.38,
   "text": "تا کو- اینو جزو کوفه میدونن، جزو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.38,
   "end": 115.36,
   "text": "شهر کوفه میدونن یا جزو شهر نجف میدونن یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.36,
   "end": 121.18,
   "text": "کجا رو؟ مسجد کوفه رو. اگه گفتن آره اینجا عرفان مثل شاه عبدالعظیم علیه السلام و تهران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.18,
   "end": 123.52,
   "text": "حالا یه م- تو یه شهر میدونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.52,
   "end": 126.38,
   "text": "اگر اینچنین بود اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.38,
   "end": 130.8,
   "text": "اما اگر اینچنین نبود حق نداری خارج بشی حتی برای یک ساعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.8,
   "end": 136.08,
   "text": "اینو حواسمون باشه. یکی دیگه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.08,
   "end": 141.58,
   "text": "عادت‌های اهل نفاق هی غر زدن و نق زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.58,
   "end": 144.48,
   "text": "به جهت نفهمیدن حقایق الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.48,
   "end": 148.58,
   "text": "چون قرآن می‌فرماید \"لا یمسه إلا المتحرون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.58,
   "end": 151.62,
   "text": "جز با طهارت نمیشه حقایق رو مس کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.62,
   "end": 155.46,
   "text": "معارف و علوم الهی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.46,
   "end": 158.1,
   "text": "حقیقت دارن، یک حقیقته‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.1,
   "end": 160.3,
   "text": "اونها هم جز با طهارت نمیشه مس کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.3,
   "end": 164.54,
   "text": "اگر گاهی اوقات من زور میزنم یه حقیقتی رو، یه علمی رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.54,
   "end": 167.84,
   "text": "یه قضای عقلی رو بفهمم و وردارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.84,
   "end": 173.7,
   "text": "به جهت اینکه یه طها- ناپاکی‌هایی در درونم هست ما باید برطرف شه این صریح آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.7,
   "end": 177.56,
   "text": "چون اونا ناپاکی دارن یه سری حقایق رو نمی‌فهمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.56,
   "end": 181.18,
   "text": "و این حقایق اگرچه تو قرآن هم به صراحت اومده اما نمی‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.18,
   "end": 183.26,
   "text": "لذا هی اشکال‌تراشی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.26,
   "end": 186.1,
   "text": "یکی از اون اشکال‌تراشی‌ها این بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.1,
   "end": 189.62,
   "text": "که وقتی سختی ریخت رو سر پیغمبر و یارانش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.62,
   "end": 193.92,
   "text": "اینا رو شما تق- تطبیق بدید به دوران انقلاب خودمون و فی الحال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.92,
   "end": 197.58,
   "text": "قبل و بعد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.58,
   "end": 201.06,
   "text": "با اینچه وضع شهر اگه مملکت اسلامیه من کاری ندارم به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.06,
   "end": 206.04,
   "text": "خلاف‌هایی که باعث شده یه اشکالاتی ایجاد بشه، نه کاری به اون ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.04,
   "end": 209.32,
   "text": "ما مخالف رفاه و سعادت و اینها که نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.32,
   "end": 211.54,
   "text": "اما بحث چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.54,
   "end": 214.28,
   "text": "یه سری بالطبع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.28,
   "end": 217.86,
   "text": "اشکالاتی، موانعی دشمنان سر راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.86,
   "end": 220.76,
   "text": "مسلمونا ایجاد کردن. مثلا تو جنگ تبوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.76,
   "end": 225.96,
   "text": "می‌دونید میگن روزی یه دونه خرما به سه نفر می‌رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.96,
   "end": 230.76,
   "text": "خدا وکیلی کدوم یکی از ما یه همچین روزی رو تو عمرمون درک کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.76,
   "end": 234.18,
   "text": "سه نفر باشیم یه دونه مثلا من و زن و بچه‌هام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.18,
   "end": 236.92,
   "text": "روزی یه دونه خرما داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 236.92,
   "end": 241.84,
   "text": "اونم چند وقت، نه یکی دو روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.84,
   "end": 244.84,
   "text": "این انقدر سختی زیاد شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.84,
   "end": 248.36,
   "text": "که این‌ها یه حرفی زدن این منافقا سواستفاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.36,
   "end": 254.9,
   "text": "چی گفتن؟ گفتن خدا هم به پیغمبر غضب کرده هم ولش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.9,
   "end": 256.36,
   "text": "ول کرده پیغمبر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.36,
   "end": 262.66,
   "text": "اگه این پیغمبر بود استغفرالله این پیغمبر بود راست میگفت اینطوری نبود که وضع ما باید خوب می شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.66,
   "end": 266.86,
   "text": "مثل الان که خیلیا میگن اگه این نظام به حقه چرا انقدر مشکلات هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.86,
   "end": 271.02,
   "text": "خب یه سری مشکلات که به بی‌تدبیری مدیرا برمی‌گرده کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.02,
   "end": 277.66,
   "text": "یه سری مشکلات برمی‌گرده به خود مردم که البته اصلش اصلا خود مردمند که اونا رو انتخاب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.66,
   "end": 282.98,
   "text": "اونم کاری نداریم. ولی یه سری مشکلات بالطبع این راهیه که انتخاب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.98,
   "end": 287.18,
   "text": "خب بله اگر ما هم مثل آل سعود گاو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.18,
   "end": 291.06,
   "text": "شیرده میشدیم برای استکبار خب خیلی از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.06,
   "end": 293.54,
   "text": "دلاری وضع مملکت خوب میشد اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.54,
   "end": 296.74,
   "text": "حالا کاری به اون سمت نداریم. آیه شو براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.74,
   "end": 300.38,
   "text": "آیه سوره، آیه سه سوره ضحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.38,
   "end": 305.68,
   "text": "\"والضحی\" که اشاره به زمان رجعت و ظهور امام Asره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.68,
   "end": 307.66,
   "text": "شدت تابش رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.66,
   "end": 309.98,
   "text": "\"والليل اذا سجا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.98,
   "end": 313.42,
   "text": "وقتی شب یه استقرار پیدا میکنه، آرامش پیدا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.42,
   "end": 317.8,
   "text": "این شب بعضیا میگن در تفاسیر تعبیر شده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.8,
   "end": 322.72,
   "text": "دوران پشت پرده غیبت قرار گرفتن ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.72,
   "end": 327.7,
   "text": "که از زمان امیرالمؤمنین علیه الصلاة والسلام شروع شد، نه امام عصر ما صرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 327.7,
   "end": 329.86,
   "text": "آیه سه \"وما ودعک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.86,
   "end": 332.38,
   "text": "انقدر اونا حرف زدن منافقین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.38,
   "end": 335.56,
   "text": "انقدر نفهم‌ها تیکه انداختن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.56,
   "end": 338.22,
   "text": "نیش زدن به اهل ایمان و پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.22,
   "end": 342.52,
   "text": "که خدا آیه نازل کرد. پیغمبر \"ما ودعک ربک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.52,
   "end": 344.22,
   "text": "چی گفته خدا تو رو ولت کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.22,
   "end": 346.36,
   "text": "\"وما قلی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.36,
   "end": 350.76,
   "text": "خدا نه تو رو ول کرده نه بهت خشم کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.76,
   "end": 353.6,
   "text": "اینطوری نیست. توجه به حرفای اینا نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 353.6,
   "end": 355.48,
   "text": "منتها خب اینو کی میفهمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 355.48,
   "end": 360.5,
   "text": "کسی که \"لا یمسه إلا المتحرون\" طهارت باطنی داره میتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.5,
   "end": 365.44,
   "text": "حق رو درک کنه و حالا شما بیاین این حرفا رو تو بازار تهران امروز بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.44,
   "end": 368.5,
   "text": "مش-مسخره‌ت می‌کنن. می‌گه پاشو برو کاسه گوزت رو جمع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.5,
   "end": 371.18,
   "text": "چرت و پرت‌ها چیه میگی؟ دلار چنده امروز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.18,
   "end": 373.64,
   "text": "انقدر پول حروم خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.64,
   "end": 377.42,
   "text": "اصلا تو نمی‌تونی حرف از خدا پیش اینا بیاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.42,
   "end": 382.22,
   "text": "و نمی‌دونم این پول‌های حروم امروز بعدها قراره چه نطفه‌هایی رو ببنده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 382.22,
   "end": 385.48,
   "text": "چه فرزندانی رو تحویل اجتماع بده خدا رحم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.48,
   "end": 388.9,
   "text": "همونطور که طبق وعده‌ی قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 388.9,
   "end": 397.02,
   "text": "هرچی میریم جلوتر نور تجلیش بیشتر میشه همونطور ظلمت هم ملأ الظلم والجهال بیشتر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 397.02,
   "end": 400.98,
   "text": "تو آ-- بعد عرض شود خدمتتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 400.98,
   "end": 403.12,
   "text": "سوره‌ی بعدی که خیلی جالبه فقها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 403.12,
   "end": 408.56,
   "text": "گفتن اگر خواستی سوره‌ی ذهن‌ها رو بخونی می‌دونید دیگه انشراح رو هم باید باهاش بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 408.56,
   "end": 412.32,
   "text": "حالا یه ربط‌هایی بین این دو سوره وجود داره که کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 412.32,
   "end": 418.3,
   "text": "اصلا توی این سوره‌ی بعدی \"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ\" میگه پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.3,
   "end": 423.08,
   "text": "یادت باشه که ما به تو شرح صدر دادیم \"وَوَضَعْنَا عَنْكَ وِزْرَكَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.08,
   "end": 425.64,
   "text": "بار بود، بار هست رو دوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 425.64,
   "end": 428.54,
   "text": "اما وزعنا ما این بار رو سبک کردیم رو دوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.54,
   "end": 431.38,
   "text": "نه اینکه بار نباشه، نه اینکه فشار نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.38,
   "end": 438.38,
   "text": "ما سبکش کردیم. \"الَّذِي أَنْقَضَ ظَهْرَكَ\" همون باری که تو به تو فشار سنگینی داشت میاورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 438.38,
   "end": 442.06,
   "text": "\"وَرَفَعْنَا لَكَ ذِكْرَكَ\" ما اسم تو رو بالا بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.06,
   "end": 447.32,
   "text": "اینجا \"فَإِنَّ مَعَ الْعُسْرِ يُسْرًا، إِنَّ مَعَ الْعُسْرِ يُسْرًا\" دو بارم پشت سر هم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.32,
   "end": 450.2,
   "text": "این یکی از مؤکدات قرآنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.2,
   "end": 453.18,
   "text": "و یکی از اصول اعتقادی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.18,
   "end": 457.2,
   "text": "اصلا نمیشه میگه \"مَعَ الْعُسْرِ يُسْرًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.2,
   "end": 462.4,
   "text": "اولا خدا فرموده ما خواستیم \"إِنَّمَا يُرِيدُ اللَّهُ بِكُمُ الْيُسْرَ وَلَا يُرِيدُ بِكُمُ الْعُسْرَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.4,
   "end": 465.44,
   "text": "ما برای شما راحتی خواستیم. اینو حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 465.44,
   "end": 467.64,
   "text": "خدا نمی‌خواد بنده‌شو اذیت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.64,
   "end": 472.64,
   "text": "اما از اون طرف هم حدیث داریم اگر سه چیز نبود مردم ادعای خدایی می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.64,
   "end": 475.96,
   "text": "یکی فقر، یکی مریضی، یکی مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 475.96,
   "end": 478.32,
   "text": "این سه تا نبود انصافاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 478.32,
   "end": 481.9,
   "text": "ما موحدین کمتر یاد خدا می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.9,
   "end": 486.52,
   "text": "وقتی مریض میشی فقر، فقر میاد، مری-- مرگ پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.52,
   "end": 495.8,
   "text": "میگه در دل خود سختی \"إِنَّ مَعَ الْعُسْرِ يُسْرًا\" اون یسر در دل خود سختی قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.8,
   "end": 498.62,
   "text": "اصلا نمیشه اینطور نیست که شما بگی حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.62,
   "end": 501.56,
   "text": "لا اله الا الله تموم تمام مشکلات برطرف شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.56,
   "end": 504.44,
   "text": "اینطوری نیست. تازه اولشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.44,
   "end": 509.8,
   "text": "همین امروز عزیزانی که رفتن تست ورزش دادن یک، یه، یکی از عزیزی حالش بد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.8,
   "end": 514.62,
   "text": "گلاب به روتون بالا آورد. گفت نه مثلا امتا-- چیز نداشتم، تمرین نداشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.62,
   "end": 516.62,
   "text": "یه دفعه اومده بود کار سنگین انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 516.62,
   "end": 520.68,
   "text": "خب اون‌ها باید مراقب باشن هرکسی هم این حرکات رو انجام نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.68,
   "end": 523.24,
   "text": "بدبخت یک ساعت حالش بد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 523.24,
   "end": 525.0,
   "text": "اصلا کسی هم متوجه ایشون نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 525.0,
   "end": 528.9,
   "text": "من رفتم اونور دیدم حالش بد شده بالا آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 528.9,
   "end": 531.54,
   "text": "طفلی رو. هیچکس هم متوجه‌ش نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 531.54,
   "end": 536.62,
   "text": "پزشک اونور. باید مراقب باشید یهو تموم می‌کرد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 536.62,
   "end": 540.2,
   "text": "خب این الان چرا این سختی رو الان این اذیتش کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.2,
   "end": 542.5,
   "text": "چرا؟ چون قبلاً سختی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 542.5,
   "end": 546.32,
   "text": "حرکات نرمشی چه می‌دونم ورزشی اینا رو به خودش نداده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 546.32,
   "end": 549.76,
   "text": "اون سختیه باعث شده بود الان سخ-- اذیت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 549.76,
   "end": 554.18,
   "text": "اگر اون سختی بود، اون آسانی تو دل خود اون سختیه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 554.18,
   "end": 558.2,
   "text": "امروز انقدر اذیت نمی‌شد. با آمادگی کامل می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.2,
   "end": 560.84,
   "text": "امیرالمؤمنین علیه‌الصلاة والسلام می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 560.84,
   "end": 563.84,
   "text": "درخت‌هایی که کمتر آب می‌خورن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 563.84,
   "end": 567.16,
   "text": "محکم‌ترن و آتیش‌شون آتیش‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 567.16,
   "end": 570.18,
   "text": "آتیشی‌تره. بیشتر آتیش دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 570.18,
   "end": 573.52,
   "text": "اینایی که بیشتر آب می‌خورن زودی تموم میشه آتیش‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 573.52,
   "end": 579.12,
   "text": "امیرالمؤمنین می‌فرماید زغال این درخت‌هایی که تو بیابون‌اند و آب نمی‌خورن خیلی بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 579.12,
   "end": 586.4,
   "text": "اصلا استحکام‌شون بیشتره. شما ببین رتبه‌های اول تا دهم کنکور بیشتر بچه‌های دهات و شهرستان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 586.4,
   "end": 588.58,
   "text": "کمتر از تهران می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.58,
   "end": 591.82,
   "text": "این‌هایی که سختی کشیدن. اصلا سختی همراهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 591.82,
   "end": 593.62,
   "text": "بعد این فهمش مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 593.62,
   "end": 597.72,
   "text": "قربونتون برم. اینکه انسان اینو بفهمه بعد داد نزنه سر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 597.72,
   "end": 601.6,
   "text": "انقدر خدا عجیب امتحان می‌کنه مؤمنین رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 601.6,
   "end": 606.24,
   "text": "حالا دیگه نمی‌رسیم ولی حالا شاید فردا همین بحث هم ادامه دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 606.24,
   "end": 611.6,
   "text": "که در انقدر سخت امتحان کرد خدا که در زمان حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.6,
   "end": 616.7,
   "text": "یکی مثل قارون، قرآن میگه قارون جزو قوم موسی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 616.7,
   "end": 618.72,
   "text": "اصلا فامیل موسی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 618.72,
   "end": 620.84,
   "text": "قارون. اصلا امتحان رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 620.84,
   "end": 624.56,
   "text": "یهو تو دل انقلاب یه آدم کله گنده‌ای تو زرد از آب در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.56,
   "end": 629.18,
   "text": "تو بیت خود حضرت امام می‌بینی آدم تو زرد از آب در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 629.18,
   "end": 632.02,
   "text": "تو بیت رهبری یهو می‌بینی آدم تو زرد از آب در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 632.02,
   "end": 637.92,
   "text": "این همش امتحانات خداست. تو بیت پیغمبر یهو می‌بینی اینطوری در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 637.92,
   "end": 641.08,
   "text": "قارون فامیل موسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 641.08,
   "end": 645.0,
   "text": "علم کیمیا رو تا حدودی از حضرت موسی یاد گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 645.0,
   "end": 649.66,
   "text": "موسی از، از موسی کیمیا رو یه مقدار یاد گرفت که مس رو طلا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 649.66,
   "end": 651.78,
   "text": "آقا زد اونوری شد یهو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 651.78,
   "end": 656.32,
   "text": "رفت تو دل فرعون رفت با فرعون شد وضعش توپ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 656.32,
   "end": 660.04,
   "text": "خدا هم میگه ما نامردی نکردیم دادیم بهش حسابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 660.04,
   "end": 664.34,
   "text": "کنوز رو در اختیار، گنج‌ها رو در اختیارش قرار دادیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 664.34,
   "end": 669.36,
   "text": "شترها فقط کلید‌های گنجش رو می‌بردن، گنجینه‌هاش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 669.36,
   "end": 671.82,
   "text": "بعد صدای طرفدارای موسی دراومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 671.82,
   "end": 676.04,
   "text": "ببین تا رفت پیش قارون، تا رفت پیش فرعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 676.04,
   "end": 679.02,
   "text": "وضعش خوب شد. تو چی برای ما آوردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 679.02,
   "end": 681.08,
   "text": "تو این پا برهنه چی برای ما آوردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 681.08,
   "end": 684.7,
   "text": "شروع شد. امتحان‌ها شروع شد. می‌خوام عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 684.7,
   "end": 690.24,
   "text": "خیلی باید مراقب باشیم که گرفتار این سم‌پاشی‌های منافقین نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 690.24,
   "end": 693.0,
   "text": "الانم تو دوره خودمون تا دلت بخواد زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 693.0,
   "end": 697.04,
   "text": "نمی‌فهمن، تحلیل ندارن، نه تحلیل سیاسی دارن، نه تحلیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 697.04,
   "end": 700.76,
   "text": "فرهنگی دارن، نه تحلیل مذهبی دارن، نه قرآن رو می‌فهمن، نه حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 700.76,
   "end": 703.44,
   "text": "هی چرت می‌گن و بعد ما رو می‌ریزن به جون هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 703.44,
   "end": 705.76,
   "text": "انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 705.76,
   "end": 708.96,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 708.96,
   "end": 713.3,
   "text": "اللهم صل علی محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}