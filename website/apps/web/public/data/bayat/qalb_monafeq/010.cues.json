 },
 "chapters": [
  {
   "index": 0,
   "title": "## اصل طهارت و تریِ دست کودک",
   "start": 11.38,
   "end": 54.9
  },
  {
   "index": 1,
   "title": "## نشانهٔ نفاق؛ خواب بسیار",
   "start": 54.9,
   "end": 149.96
  },
  {
   "index": 2,
   "title": "## خیانت در امانت؛ ظاهر و باطن",
   "start": 149.96,
   "end": 226.64
  },
  {
   "index": 3,
   "title": "## غیبت؛ ظاهر و معنای عصر غیبت",
   "start": 226.64,
   "end": 318.72
  },
  {
   "index": 4,
   "title": "## خلف وعده؛ عهد عبادت",
   "start": 318.72,
   "end": 480.41
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.38,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.38,
   "end": 7.1,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.1,
   "end": 11.38,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.38,
   "end": 14.78,
   "text": "یکی دیگه از جاهایی که بر اساس اصل طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.78,
   "end": 17.22,
   "text": "ما محکوم می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.22,
   "end": 19.74,
   "text": "موضوع رو به طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.74,
   "end": 24.0,
   "text": "که می‌گیم ان‌شاءالله پاک هست وقتیه که یه بچه‌ای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.0,
   "end": 27.5,
   "text": "بچه کوچیکی دائماً خودش رو نجس می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.5,
   "end": 30.72,
   "text": "حالا این بچه‌ای که دائماً خودش رو نجس می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.72,
   "end": 36.92,
   "text": "و به‌هرحال لباسش نجسه، یهو برمی‌خوردیم مثلاً دستش تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.92,
   "end": 41.54,
   "text": "نگاه کنیم ببینیم دستش تره، حالا این دست ترش رو به خیلی جاها زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.54,
   "end": 48.38,
   "text": "چون ما یق-یقین نداریم که این تری دستش از نجاست لباسشه یا نه، باز اینجا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.38,
   "end": 51.58,
   "text": "بر اساس اصل طهارت میگن محکومه به طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.58,
   "end": 54.9,
   "text": "یقین نداریم. به همین راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.9,
   "end": 63.48,
   "text": "یکی دیگه از نشانه‌های قلبی که دچار نفاق شده بر اساس حدیث امام سجاد سلام الله علیه رو که بررسی کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.48,
   "end": 69.42,
   "text": "دیروز عرض کردیم اینجاست که فرمودند: \"صبح می‌کند و همه‌ش خواب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.42,
   "end": 73.86,
   "text": "با اینکه شب بیدار نبوده.\" این رو صحبت کردیم پیرامون خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.86,
   "end": 76.56,
   "text": "مطالبی رو گفتیم. تبرّکاً یه حدیث دیگه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.56,
   "end": 79.38,
   "text": "در همین خصوص بخونم و رد شیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.38,
   "end": 82.06,
   "text": "اختصاص شیخ مفید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.06,
   "end": 88.1,
   "text": "صفحه دویست و هجده. پیامبر اعظم السلام فرمودند: \"ایاکم و کثرة النوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.1,
   "end": 90.06,
   "text": "بپرهیزید از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.06,
   "end": 94.14,
   "text": "زیاد خوابیدن. \"و إن كثرة النوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.14,
   "end": 97.32,
   "text": "يدع صاحبه فقیر يوم القيامة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.32,
   "end": 100.7,
   "text": "کسی که زیاد می‌خوابه قیامت فقیر محشور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.7,
   "end": 103.46,
   "text": "فقر میاره. البته این تو دنیا هم این‌چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.46,
   "end": 106.58,
   "text": "آدمی که زیاد می‌خوابه تو دنیا هم فقیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.58,
   "end": 109.68,
   "text": "قیامت هم از جهت معنوی دستش خالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.68,
   "end": 112.18,
   "text": "اما نشانه‌های دیگه همین حدیث رو حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.18,
   "end": 117.22,
   "text": "تمومش کنیم دیگه امروز بخوایم رو هر جز جزش حرف بزنیم خیلی طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.22,
   "end": 121.4,
   "text": "همین که گرای بگیریم، متوجه باشیم، خودمون رو بررسی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.4,
   "end": 126.52,
   "text": "فرمودند که اگر با تو سخن گوید، دروغ می‌گوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 126.52,
   "end": 130.68,
   "text": "دروغ به قول بزرگان کج و مع-- کج و معوج بار میاره آدمو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.68,
   "end": 135.12,
   "text": "هرچی زور می‌زنی خودتو درست کنی، خودسازی، تهذیب نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.12,
   "end": 140.02,
   "text": "هی زمین می‌خوری. چرا؟ چون صداقت تو وجود ریشه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.02,
   "end": 142.38,
   "text": "دروغ آدمو کج و معوج بار میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.38,
   "end": 145.02,
   "text": "خیلی چیز بدیه در مسیر خودسازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.02,
   "end": 149.34,
   "text": "و از نشانه‌های نفاقه. کسی که مخصوصاً به راحتی دروغ میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.34,
   "end": 153.7,
   "text": "بعد فرمود و اگر به او امانت بسپاری خیانت می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.7,
   "end": 159.18,
   "text": "این یه معنای ظاهری داره که یعنی امانت بهش میدی، تصرف می‌کنه در امانت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.18,
   "end": 163.4,
   "text": "ناخنک می‌زنه، خیانت می‌کنه، درست نگه نمیداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.4,
   "end": 166.0,
   "text": "یه معنای باطنی هم داره، اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.0,
   "end": 169.96,
   "text": "در زیارت جامعه کبیره می‌خونیم \"والأمانة المحفوظة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.96,
   "end": 174.04,
   "text": "شما اهل بیت علیهم الصلاة والسلام امانت محفوظه خدایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 174.04,
   "end": 177.36,
   "text": "اینکه اینجا می‌فرماید خیانت می‌کنه به امانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.36,
   "end": 181.9,
   "text": "یعنی در امانت ولایت \"إنا عرضنا الأمانة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.9,
   "end": 184.7,
   "text": "على السماوات والأرض والجبال\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.7,
   "end": 190.1,
   "text": "این‌ها این امانتی که به همه داده شد پس دادن نتونستن اون عظمت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.1,
   "end": 195.18,
   "text": "بگیرن. اون امانت ولایت اهل بیت علیهم الصلاة والسلام که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.18,
   "end": 198.14,
   "text": "انسان‌ها پذیرفتیم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.14,
   "end": 201.42,
   "text": "عالم الست، عالم زر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.42,
   "end": 207.2,
   "text": "بعد حالا متأسفانه توی این عوالم بعدی که میایم هی خیانت می‌کنیم، هی خیانت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.2,
   "end": 209.62,
   "text": "هر چقدر که التزام عملیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.62,
   "end": 216.4,
   "text": "به اون امانت، به ولایت اهل بیت علیهم الصلاة والسلام که امانت محفوظه الهی هستن داشته باشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.4,
   "end": 220.56,
   "text": "همون مقدار امانت داریم و هر مقدار التزام نداریم خیانتکاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.56,
   "end": 225.8,
   "text": "شوخی هم نداریم. این از نشانه‌های نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.8,
   "end": 228.58,
   "text": "و بعد فرمود و اگر او غایب از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.58,
   "end": 232.48,
   "text": "از او غایب شوی غیبت تو را می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.48,
   "end": 234.62,
   "text": "غیبت، غیبت. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.62,
   "end": 238.0,
   "text": "این غیبت چقدر پسته که میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.0,
   "end": 240.94,
   "text": "صاحبان گناهان زشت مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.94,
   "end": 244.98,
   "text": "شراب‌خواری و چه می‌دونم شهوت‌رانی و اینا رو می‌کنند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.98,
   "end": 252.86,
   "text": "غیبت‌کننده در قیامت میگن بابا ما یه کیفی کردیم، این گناهو کردیم، اون کیفش گول ما رو، ما رو گول زد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.86,
   "end": 255.04,
   "text": "سر ما رو گول زد. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.04,
   "end": 258.34,
   "text": "اینطوری گفت‌وگو می‌کنند. تو یه روایت دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.34,
   "end": 264.02,
   "text": "میگن که ما کیف کردیم مثلا استغفرالله شراب خوردیم یا زنا کردیم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.02,
   "end": 266.48,
   "text": "تو چه کیفی کردی؟ خاک بر سرت کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.48,
   "end": 269.3,
   "text": "با هم مواجهه می‌کنند. فحش‌ش میدن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.3,
   "end": 271.78,
   "text": "میگن تو خجالت نکشیدی آخه چه ز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.78,
   "end": 275.56,
   "text": "چه کیفی داشت برات؟ چه لذتی بردی از غیبت کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 275.56,
   "end": 279.16,
   "text": "نامردیه دیگه بز-- قدیمیا همه گفتن غیبت کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.16,
   "end": 283.4,
   "text": "اصل نامردیه. اینم از نشانه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.4,
   "end": 287.88,
   "text": "به‌هرحال نفاق هست که البته معنای باطنی‌ش هم می‌تونه این باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.88,
   "end": 290.94,
   "text": "وقتی امام هستش، حاضره، پیششه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.94,
   "end": 298.64,
   "text": "پیش حضرته، دم از ولایت می‌زنه و اقرار می‌کنه و وقتی امام غایب شد مثل الان عصر غیبت ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.64,
   "end": 302.0,
   "text": "غیبت حضرته، این چی کار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.0,
   "end": 306.58,
   "text": "هی بدگویی می‌کنه بر علیه ارزش‌های دینی، ولایت، دستورات اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 306.58,
   "end": 309.98,
   "text": "کی گفته، چی، کی رفته، کی شنیده، این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.98,
   "end": 313.08,
   "text": "غیبت می‌کنه. اهل غیبت و بدگویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.08,
   "end": 318.38,
   "text": "اینم یه معنای باطنی‌ش و آخرین نشانه که البته در این روایت بررسی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.38,
   "end": 322.06,
   "text": "فرموده و اگر با او وعده کنی خلف وعده می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 322.06,
   "end": 325.98,
   "text": "اصلاً عادتشه وقتی وعده میده وفای به وعده‌ش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.98,
   "end": 328.7,
   "text": "اینم خب یه معنای ظاهری داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.7,
   "end": 331.74,
   "text": "که پیغمبر یه جا صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.74,
   "end": 334.2,
   "text": "ظاهراً وعده داشت تا غروب وایساد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.2,
   "end": 336.66,
   "text": "طرف اومد رد شد دید پیغمبر وایساده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 336.66,
   "end": 339.2,
   "text": "و پیغمبر فرمود اگر نمی‌اومدی شبم وایمیستادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 339.2,
   "end": 347.36,
   "text": "من قول داده بودم به تو. خب این یه معنای ظاهری‌ش، یه معناش اون آیه است که می‌فرماید \"أن اعبدونی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.36,
   "end": 355.94,
   "text": "قل-- می‌فرماید که \"ألم أعهد إليكم يا بني آدم أن لا تعبدوا الشيطان وأن اعبدوني هذا صراط مستقيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.94,
   "end": 358.14,
   "text": "ما از تو عهد نگرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.14,
   "end": 361.65,
   "text": "که عبادت ما رو بکن نه شیطان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.65,
   "end": 363.41,
   "text": "اون دشمن آشکار توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.41,
   "end": 367.17,
   "text": "اعبدونی عبادتو این وعده‌ی ما به خدا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 367.17,
   "end": 369.35,
   "text": "وعده‌ای بوده که ما با خدا بستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.35,
   "end": 372.87,
   "text": "علم أعهد، أعهد الیکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 372.87,
   "end": 375.05,
   "text": "عهد بستید با من خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.05,
   "end": 377.81,
   "text": "که اعبدونی منو عبادت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.81,
   "end": 382.27,
   "text": "و این هم معنای باطنش. هر مقدار که ما از عبادت فاصله بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 382.27,
   "end": 387.73,
   "text": "اینجا در حقیقت ما خلف وعده کردیم و این نشانه نفاق درونی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.73,
   "end": 392.15,
   "text": "و این‌هام، این‌هایی که الان ما داریم می‌گیم علم ظاهریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.15,
   "end": 394.89,
   "text": "حواسمون جمع باشه. علم فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.89,
   "end": 399.65,
   "text": "الان من اینا رو دارم می‌فهمم فکر نکنم خب دیگه پاک شدم از نفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.65,
   "end": 403.37,
   "text": "اینا یک علم فکریه. اینا تو فکر من جمع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 403.37,
   "end": 405.35,
   "text": "عملم رو باید بررسی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 405.35,
   "end": 410.03,
   "text": "اینا کمک باید بکنه به عمل، به پاک‌سازی عمل، به صالح‌سازی عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 410.03,
   "end": 415.31,
   "text": "و الا بزرگانی مثل آقا باقر بهبهانی بزرگ رو، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 415.31,
   "end": 419.97,
   "text": "عارف و اون آو-- واصل و اون عالم رو آخر عمرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 419.97,
   "end": 422.75,
   "text": "هرچی بلد بود یادش رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 422.75,
   "end": 424.85,
   "text": "میگن اصلا صفحه ذهنش خالی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.85,
   "end": 430.35,
   "text": "هرچی علم داشت رفت. یکی از علما اسمش یادم نیست وسط نماز سوره حمد یادش رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 430.35,
   "end": 434.23,
   "text": "هرچی فکر کرد یادش نیومد سوره حمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.23,
   "end": 436.49,
   "text": "سوره حمدو یادش نیومد اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 436.49,
   "end": 439.35,
   "text": "گرفتن ازش. این ف-- میره حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.35,
   "end": 443.45,
   "text": "با یک بعضی از بزرگان اجازه نمیدن جراحیشون کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 443.45,
   "end": 445.21,
   "text": "چرا؟ میگن یه دفعه علممون میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 445.21,
   "end": 447.87,
   "text": "خب این چه علمیه که با یک فشار جراحی بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 447.87,
   "end": 450.17,
   "text": "این دیگه با فشار قبر چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 450.17,
   "end": 452.95,
   "text": "با فشار قبر می‌خواد چی بشه؟ همش میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 452.95,
   "end": 455.19,
   "text": "این علم فکریه. فکر نکنین به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 455.19,
   "end": 462.97,
   "text": "علامه جوادی آملی اینکه چهار تا حدیث و آیه بخونیم و هی بگیم این علم فکریه فکر نکنیم این اصل عملیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.97,
   "end": 468.01,
   "text": "اینا باید سا-- منتج بشه به صالح‌سازی اعمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 468.01,
   "end": 472.95,
   "text": "انشاالله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 472.95,
   "end": 480.41,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}