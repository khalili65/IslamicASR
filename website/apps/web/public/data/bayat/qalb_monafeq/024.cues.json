 "chapters": [
  {
   "index": 0,
   "title": "## حکم روز یوم‌الشک در آستانهٔ رمضان",
   "start": 0.36,
   "end": 206.48
  },
  {
   "index": 1,
   "title": "## نشانه‌شناسی نفاق؛ آیهٔ پنجاه توبه",
   "start": 206.48,
   "end": 260.38
  },
  {
   "index": 2,
   "title": "یکی از آیات، آیهٔ پنجاه سورهٔ توبه است:",
   "start": 260.38,
   "end": 341.8
  },
  {
   "index": 3,
   "title": "## حمد نابجا و بلای همسایه",
   "start": 341.8,
   "end": 374.12
  },
  {
   "index": 4,
   "title": "## نشانه‌شناسی منظومه‌ای نه نقطهٔ تنها",
   "start": 374.12,
   "end": 394.54
  },
  {
   "index": 5,
   "title": "آیهٔ دوازده احزاب:",
   "start": 394.54,
   "end": 609.92
  },
  {
   "index": 6,
   "title": "## ده سفارش امام رضا برای استقبال از رمضان",
   "start": 609.92,
   "end": 760.6
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.38,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.38,
   "end": 10.84,
   "text": "السلام علیک یا داعی الله و ربانی ایاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.84,
   "end": 12.78,
   "text": "دست بوسه همتونم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.78,
   "end": 18.82,
   "text": "حرف گوش کردید خدا خیرتون بده انشاالله اون جمله بعدی منم گوش بدید گفتم پاشید برید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.82,
   "end": 23.24,
   "text": "بعد از حکم شرعی حرف گوش کنین دیگه انشاالله تکمیل کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.24,
   "end": 28.72,
   "text": "در خصوص حکمی که چون قبل از اذان من با دفتر آقا گفتگو کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.72,
   "end": 31.34,
   "text": "و خیلیا مرددن بالاخره چه کنن فردا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.34,
   "end": 35.1,
   "text": "عده‌ای امروز رو یوم الشک می‌دونستن عده‌ای فردا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.1,
   "end": 38.12,
   "text": "امروز که قطعا آخر شعبان بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.12,
   "end": 42.92,
   "text": "ببخشید اواخر شعبان بود، فردا احتمال آخر شعبان باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.92,
   "end": 44.98,
   "text": "روز سیام شعبان باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.98,
   "end": 51.1,
   "text": "خب چه کنیم؟ احتمالم داره اول ماه رمضون باشه تا رؤیت هلال صورت نگیره که نمیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.1,
   "end": 53.58,
   "text": "یقین کرد. وظیفه ما اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.58,
   "end": 58.46,
   "text": "چون اعلام نشده ماه مبارک رمضانه می‌تونیم روزه نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.46,
   "end": 62.82,
   "text": "این یکی. روزه نگیریم فردا رو چون اعلام نشده ماه، واجب نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.82,
   "end": 70.96,
   "text": "این یک. اگر کسی می‌خواد ه-- احتیاط کنه چون احتمال داره فردا ماه رمضان باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.96,
   "end": 73.24,
   "text": "فردا رو می‌تونه فقط به نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.24,
   "end": 75.04,
   "text": "آخر شعبان روزه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.04,
   "end": 78.5,
   "text": "حق نداره نیت کنه ماه رمضونه چون اعلام نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.5,
   "end": 81.36,
   "text": "به نیت آخر شعبان روزه می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.36,
   "end": 87.54,
   "text": "هر زمان اعلام شد، چه وسط روز، چه بعد از که روز تموم شد اعلام شد ماه رمضان بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.54,
   "end": 89.92,
   "text": "جزء ماه رمضونش حساب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.92,
   "end": 94.38,
   "text": "اگر وسط روز، اینا رو دقت کنید این ظرافت‌ها برای این میگم گوش بدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.38,
   "end": 97.28,
   "text": "اگر وسط روز اعلام شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.28,
   "end": 101.08,
   "text": "از دفتر آقا که آقا امروز روز اول ماه رمضونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.08,
   "end": 103.9,
   "text": "ما باید نیتمونو برگردونیم به ماه رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.9,
   "end": 106.78,
   "text": "حواسمون باشه نیت ما آخر شعبان بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.78,
   "end": 114.04,
   "text": "باید اونجا نیت کنی خب دیگه ماه رمضونه من برای آخر-- اول رمضان دارم روزه می‌گیرم و الا باز مشکل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.04,
   "end": 116.22,
   "text": "نکته‌ی بعدی اینکه حالا کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.22,
   "end": 120.86,
   "text": "اون روز وسط روز متوجه شد ماه رمضونه روزه نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.86,
   "end": 123.7,
   "text": "دقت کنید اول ماه رمضونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.7,
   "end": 127.3,
   "text": "فکر می‌کرده آخر شعبانه اعلام شد روزه نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.3,
   "end": 129.34,
   "text": "اگه چیزی خورده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.34,
   "end": 131.92,
   "text": "نمی‌تونه روزه بگیره چون خورده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.92,
   "end": 136.6,
   "text": "ولی اینم از ظرافت‌هاست تا اذان مغرب حق نداره هیچی بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.6,
   "end": 138.48,
   "text": "آقا خوردم که من الان روزه نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.48,
   "end": 143.12,
   "text": "باشه حکم اینه تا اذان مغرب حق نداری چون حرمت داره ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.12,
   "end": 148.22,
   "text": "اما اگر چیزی نخورده و تا اذان ظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.22,
   "end": 153.94,
   "text": "هنوز اذان ظهر رو هنوز نداده وقت داره دیگه برای نیت نماز وا-- روزه واجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.94,
   "end": 157.32,
   "text": "هیچی نخورده تا اذان ظهر اعلام شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.32,
   "end": 160.38,
   "text": "که ماه رمضونه، اونجا واجبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.38,
   "end": 167.18,
   "text": "روز-- نیت روزه بکنه، نیت روزه اول ماه رمضان بکنه و باز تا آخرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.18,
   "end": 173.28,
   "text": "هیچی نخوره. و اگر کسی خب حالا اون روز رو به هر دلیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.28,
   "end": 176.92,
   "text": "به دلی-- حالا گمان نمی‌کرد که ماه رمضان باشه، اصلاً نگرفت و خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.92,
   "end": 179.7,
   "text": "اصلاً هم متوجه نشد که اعلام شده ماه رمضونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.7,
   "end": 183.32,
   "text": "بعداً فهمید که ماه رمضان بوده و این خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.32,
   "end": 185.06,
   "text": "آیا کفاره داره؟ آیا چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.06,
   "end": 190.94,
   "text": "فرمودن نه، فقط بعداً بعد از ماه مبارک رمضان غذاشو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.94,
   "end": 193.16,
   "text": "این نکات رو سریع من عرض کردم که بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.16,
   "end": 195.46,
   "text": "التماس دعا از همگی .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 195.46,
   "end": 198.22,
   "text": "خدا خیرتون بده. اما بحثمون رو ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.22,
   "end": 200.48,
   "text": "من خواهش می‌کنم هر کی کار داره بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 200.48,
   "end": 202.96,
   "text": "من قسم می‌خورم اصلاً من ناراحت نمی‌شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 202.96,
   "end": 208.0,
   "text": "شما به کارتون باید برسید. این هفت هشت دقیقه ای که پیرامون بحث قلب نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 208.0,
   "end": 210.9,
   "text": "یا دچار نفاق شده ما حرف می‌زنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 210.9,
   "end": 215.06,
   "text": "مخصوصاً قابل توجه مدیرها باز تصریح می‌کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 215.06,
   "end": 221.64,
   "text": "عرض کردیم اینا یک منظومه ای درست کنن حتی یه دفترچه ای می‌شه با توجه به آیات و روایات و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 221.64,
   "end": 227.78,
   "text": "نشانه شناسی کرد. یه منظومه کاملی ایجاد کرد از شناخت نفاق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.78,
   "end": 233.5,
   "text": "شناخت نفوذ به قول رهبر عزیزمون حتی تو دستگاه‌های دولتی و حتی جاهای خوبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.5,
   "end": 239.9,
   "text": "که هرچی رو می‌بینی وجیه المنظره تو جمعیت ماها حتی اینجام احتمال نفوذ هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.9,
   "end": 244.02,
   "text": "بشناسیم. یکی دیگه از اون آیات، آیه پنجاه سوره توبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.02,
   "end": 248.34,
   "text": "ببینید یکی از مشخصات آدمایی که دچار نفاقن چی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.34,
   "end": 251.04,
   "text": "می‌فرماید \"ان تصبک حسنة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.04,
   "end": 254.84,
   "text": "تسؤهم وان تصبک مصيبة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.84,
   "end": 260.38,
   "text": "يقولوا قد أخرنا أمرنا من قبل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.38,
   "end": 266.68,
   "text": "وقتی که یه تس-- تصبک حسنه وقتی یه خیری به شما می‌رسه تسؤهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.68,
   "end": 269.68,
   "text": "عصبانی میشن، چهره‌شون سیاه می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.68,
   "end": 273.38,
   "text": "ناراحت میشن. چرا این خیر به این اهل ایمان رسیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.38,
   "end": 276.5,
   "text": "توجه کردین؟ این یکی از راه‌های شناخت نفوذه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.5,
   "end": 278.5,
   "text": "دندون رو هم فشار میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.5,
   "end": 281.7,
   "text": "که چرا این جبهه‌ی حق داره پیروز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.7,
   "end": 285.2,
   "text": "چرا قاسم سلیمانی تو سوریه اینطور افتخار آفریده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.2,
   "end": 287.68,
   "text": "چرا قاسم سلیمانی نشان ذوالفقار گرفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.68,
   "end": 290.98,
   "text": "توجه کردین؟ شروع می‌کنند هی زیر پا خالی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.98,
   "end": 292.94,
   "text": "هی حرف زدن، هی انگ زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 292.94,
   "end": 295.8,
   "text": "اینا پول می‌گیرن، اینا فلانن، اینا بازیشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 295.8,
   "end": 298.4,
   "text": "شهید حججی، خ-- اینا گمش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 298.4,
   "end": 300.52,
   "text": "این یه بچه بسیجی پا شده رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 300.52,
   "end": 304.82,
   "text": "اصلاً چرا رفت؟ اینکه زن و بچه داشت و می‌خواستی شهیدی چرا رفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.82,
   "end": 307.2,
   "text": "همش دارن چرت و پرت میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 307.2,
   "end": 311.4,
   "text": "یعنی شما وقتی می‌شینید تو صحبت‌شون هر خیری به من و شما می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.4,
   "end": 316.38,
   "text": "ناراحتن از این خیر. از اون طرف اینم هست \"وان تصبک مصيبة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 316.38,
   "end": 319.38,
   "text": "وقتی بدی، مصیبتی، سختی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 319.38,
   "end": 326.86,
   "text": "به اهل ایمان می‌رسه، يقولوا اینا اینطوری میگن \"قد أخرنا أمرنا من قبل ويتولوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 326.86,
   "end": 328.86,
   "text": "وهم فرحون\". اینا خوشحال میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.86,
   "end": 331.82,
   "text": "میگن ما که از اول راهمونو از اینا جدا کرده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.82,
   "end": 334.22,
   "text": "دامن می‌کشن. میگن اصلاً ما از اینا نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 334.22,
   "end": 337.52,
   "text": "این شری که به اینا رسید ما تازه نصیحتشونم کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.52,
   "end": 340.4,
   "text": "خوشحال میشن از اینکه خ-- شری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.4,
   "end": 347.4,
   "text": "به اهل ایمان برسه. یکی از بزرگان تا آخر عمرش استغفار می‌کرد، گریه می‌کرد به خاطر یک حمدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.4,
   "end": 351.84,
   "text": "یک حمدی که گفته بود. می‌گفت من این یه گناه خودمو نمی‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 351.84,
   "end": 353.92,
   "text": "حالا چرا؟ ظاهراً یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.92,
   "end": 356.18,
   "text": "حالا بلایی نازل شده بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 356.18,
   "end": 360.84,
   "text": "یه مثل الان سیل اومده، یا دیروز یکی از این بچه‌های لر مشتی رو من می‌دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.84,
   "end": 367.18,
   "text": "در نمایشگاه کتاب. می‌گفت حاجی تو نمی‌دونی اصلاً هیچی معلوم نیست چه، اون دهات ما هیچیش نمونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 367.18,
   "end": 369.74,
   "text": "اصلاً معلوم نیست خونه‌ی ما کجا بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 369.74,
   "end": 372.34,
   "text": "اصلا هیچ اثری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.34,
   "end": 375.26,
   "text": "تو رو خدا ببینید. بعد می‌گفت با این حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 375.26,
   "end": 377.9,
   "text": "ما نیت روزه داریم. چون بعضیا هی میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 377.9,
   "end": 383.48,
   "text": "اینو خواهر جاویدان خدا حفظش کنه، یه چیزی پخش کرد نفری سه هزار تومن بریزید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 383.48,
   "end": 388.08,
   "text": "برای افطاری ساده نفری سه هزار تومن افطاری برای سیل زده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 388.08,
   "end": 390.82,
   "text": "یه عده شروع کردن. لامردها هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 390.82,
   "end": 394.54,
   "text": "حرف از دهان این بزرگان درنیومده شروع می‌کنند تو فضای مجازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 394.54,
   "end": 397.54,
   "text": "آخه اینا مگه روزه می‌گیرن؟ اصلا اگه می‌تونن بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.54,
   "end": 400.24,
   "text": "این پولا معلوم نیست چی بخواد بشه. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 400.24,
   "end": 403.9,
   "text": "هی حرف می‌سازن هی. اعتمادم که ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 403.9,
   "end": 407.44,
   "text": "ایشون می‌گفت اصلا هیچی از زندگی ما نمونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 407.44,
   "end": 410.52,
   "text": "حالا ایشون یه بلایی میاد، بلای طبیعی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 410.52,
   "end": 414.88,
   "text": "زندگی و مغازه و چمیدونم حالا اون ملک و املاک ایشون سالم می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 414.88,
   "end": 420.26,
   "text": "میگه الحمد لله رب العالمین که مثلا ملک ما خونه‌ی ما سالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 420.26,
   "end": 423.06,
   "text": "بعد یهو متوجه می‌شه چه غلطی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 423.06,
   "end": 426.96,
   "text": "تا آخر عمرش میگه من از این الحمد لله گفتنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 426.96,
   "end": 430.28,
   "text": "چی؟ مثل یکی از بچه‌ها می‌گفت تو نماز جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 430.28,
   "end": 435.26,
   "text": "اخیرا تا خطبه‌خون برگشت گفت آره الحمد لله این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 435.26,
   "end": 440.74,
   "text": "باران‌ها بار-- خیلی این بارش رحمت خدا منابع آبی رو خیلی زیاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 440.74,
   "end": 445.12,
   "text": "یه دفعه یک پیرمردی دستش رو بلند کرد الحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.12,
   "end": 448.68,
   "text": "گفت صبر کن یه آهی هم بکش برای این بیچاره‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 448.68,
   "end": 452.62,
   "text": "سیل برده‌شون. خیلی باید انسان منا-- مراقب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 452.62,
   "end": 455.22,
   "text": "جالبه که شما بدونید این‌ها حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 455.22,
   "end": 458.56,
   "text": "اگر هم، اینو دقت بکن اینا ریشه‌هاش همش قرآنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 458.56,
   "end": 461.98,
   "text": "نشانه‌شناسی یعنی فقط یه مورد رو نبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 461.98,
   "end": 464.92,
   "text": "بعضی بچه‌ها دیروز من ازها رو نظر-نگرانی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 464.92,
   "end": 469.86,
   "text": "که حاجی تو گفتی حدیثه البته، من نگفتم پیغمبر فرموده ابن مسعود گفت از پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 469.86,
   "end": 474.26,
   "text": "شنیدیم هرکس تخلف کنه از نماز جماعت این نشانه نفاقشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 474.26,
   "end": 480.18,
   "text": "دلیل شرعی هم نداره نمیاد. بعد یه وقت اینایی که مدیرن، مدیرکلن، اینا تصمیم‌گیرنده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.18,
   "end": 482.68,
   "text": "یه دفعه میان خط قرمز می‌کشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 482.68,
   "end": 485.54,
   "text": "رو اونایی که نماز جماعت نمیان، زود قضاوت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 485.54,
   "end": 489.92,
   "text": "گفتم من عرض کردم نشانه‌شناسی یعنی نقطه‌ها رو بچینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.92,
   "end": 492.44,
   "text": "این یه نقطه، این یه نقطه. همش هم آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 492.44,
   "end": 496.4,
   "text": "این‌ها رو با هم وصل کنی. نه یه دونه‌شو ببینی دو تاشو نبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 496.4,
   "end": 503.48,
   "text": "اینجا این آیه سوره، برید ببینید دیگه پنجاه توبه از اون طرف شصت و هفت توبه هم میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 503.48,
   "end": 506.26,
   "text": "و یغب-- و یغب زون عیدی اه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 506.26,
   "end": 508.6,
   "text": "اینا دستاشون قبضیت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.6,
   "end": 514.18,
   "text": "میگه یعنی چی؟ تفاسیر رو اگر ببینید میگه حتی کمک مالی هم می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 514.18,
   "end": 519.34,
   "text": "اما با سختی. یا اینکه اسم خ-- اسمشون باید مطرح باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.34,
   "end": 522.36,
   "text": "و وقتی هم که کمک کردن ناراحتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 522.36,
   "end": 525.38,
   "text": "تو دلشون ناراحتن چرا کمک کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 525.38,
   "end": 529.72,
   "text": "کاش کمتر می‌دادم. اما مؤمن وقتی کمک می‌کنه شرح صدر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 529.72,
   "end": 532.86,
   "text": "میگه آخ جون کاش داشتم بیشتر کمک می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 532.86,
   "end": 535.48,
   "text": "توجه کردید؟ اینا نشانه‌شناسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 535.48,
   "end": 540.02,
   "text": "اینا وقتی کمک می‌کنن فقط باید اسمشون مطرح باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.02,
   "end": 542.5,
   "text": "شما بیا برو پیش خیلی آدمای خیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 542.5,
   "end": 547.7,
   "text": "آقا بیا گمنام به ما، به هیئت ما، به خیریه‌ی ما هیچ اسم و رسم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 547.7,
   "end": 550.2,
   "text": "بیا صد میلیون دادی فلان جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 550.2,
   "end": 552.66,
   "text": "پونصد هزار تومن هم بده اینجا. نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 552.66,
   "end": 556.5,
   "text": "ما اص-اصلا ما اینجا ما باید بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 556.5,
   "end": 560.54,
   "text": "کمه پونصد هزار تومن. کسر شأن پونصد هزار تومن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 560.54,
   "end": 567.32,
   "text": "باور کنید ق-- نمیگیم همه ولی خیلی از اینایی که اینطورین حاضر نیستن گمنام بدن، اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 567.32,
   "end": 570.08,
   "text": "قلب نفاق صریح آیه‌ی قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 570.08,
   "end": 572.52,
   "text": "گرفتار نفاق قلبی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.52,
   "end": 575.9,
   "text": "کمک هم می‌کنن باید حتما اسمشون مطرح باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 575.9,
   "end": 578.72,
   "text": "اگر اسمشون مطرح نباشه کمک نمی‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 578.72,
   "end": 581.0,
   "text": "و اعتماد به وعده‌های خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 581.0,
   "end": 584.2,
   "text": "ندارن. آیه دیگه‌ای که این رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 584.2,
   "end": 585.84,
   "text": "مخصوصا دیگه من توضیح نمی‌دم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 585.84,
   "end": 590.1,
   "text": "برید بخونید آیه دوازده احزاب هر کدوم از اینا چند جلسه باید بحث شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 590.1,
   "end": 593.22,
   "text": "من سریع میگم میرم. نشانه‌ها رو ببینید تو رو خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 593.22,
   "end": 600.54,
   "text": "إذ يقول المنافقون والذین في قلوبهم مرض ما وعد الله ورسوله إلا غرورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 600.54,
   "end": 602.46,
   "text": "اینا اصلاً اعتماد به خدا ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 602.46,
   "end": 604.84,
   "text": "همه وعده‌های خدا و پیغمبر میگن دروغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 604.84,
   "end": 607.08,
   "text": "دروغه این حرفا چیه روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 607.08,
   "end": 609.92,
   "text": "لذا نقطه سر خط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 609.92,
   "end": 617.08,
   "text": "امام رضا سلام الله علیه به اباصلد اواخر ماه شعبان گفت دیگه آخر ماه شعبانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 617.08,
   "end": 619.48,
   "text": "آماده شو برای استقبال از ماه رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 619.48,
   "end": 622.44,
   "text": "گفت چجوری آماده شم؟ امام رضا غوغا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 622.44,
   "end": 625.06,
   "text": "ده تا، ده تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 625.06,
   "end": 627.82,
   "text": "دستورالعمل داده برای استقبال از ماه رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 627.82,
   "end": 631.4,
   "text": "من تیترشو میگم میرم. یکیش اعتماد به خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 631.4,
   "end": 635.62,
   "text": "میگه اعتماد کن. تو اگه اعتماد نداشته باشی سختت می‌شه روزه نگرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 635.62,
   "end": 638.14,
   "text": "این ده تا رو من سریع میگم دیگه توضیحشو نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 638.14,
   "end": 642.8,
   "text": "برید سرچ کنید ده تا سفارش امام رضا برای استقبال از ماه رمضان به اباصلد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 642.8,
   "end": 645.8,
   "text": "روش کار کنین. تو همین فرصت یه شبه روش کار کنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 645.8,
   "end": 647.98,
   "text": "من خودم برنامه دارم روش کار کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 647.98,
   "end": 650.16,
   "text": "یکیش حضرت فرمود جبران قصورات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 650.16,
   "end": 654.38,
   "text": "هرچی کوتاهی داری تو این یه شب معلومه خیلی طلاییه امشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 654.38,
   "end": 657.7,
   "text": "جبران کن. دو، توجه به مهمات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 657.7,
   "end": 660.7,
   "text": "اضافات رو بذار کنار. گفت‌وگوهای بی‌موردو تعطیل کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 660.7,
   "end": 664.32,
   "text": "تلویزیون تعطیل. توجه به مهمات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 664.32,
   "end": 666.86,
   "text": "سه، فرمود کثرت دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 666.86,
   "end": 669.82,
   "text": "کثرت دعا یعنی خواندن خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 669.82,
   "end": 673.28,
   "text": "حتی تو می‌تونی لبت نجنبه قلباً بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 673.28,
   "end": 676.46,
   "text": "دعا، استغفار و تلاوت قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 676.46,
   "end": 679.8,
   "text": "چهار فرمود تو-توبه با اخلاص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 679.8,
   "end": 682.06,
   "text": "یعنی واقعاً بکنی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 682.06,
   "end": 688.7,
   "text": "خالصانه بکنی. بعد فرمود رد امانت که می‌تونه رد دین هم باشه تو دلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 688.7,
   "end": 695.1,
   "text": "دینی، بدهکاری. اگرم نداریم المفلس فی امان الله حداقل زنگ بزنه از طلبکار عذرخواهی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 695.1,
   "end": 697.28,
   "text": "بعد فرمود کندن دل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 697.28,
   "end": 699.54,
   "text": "کینه. این کینا، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 699.54,
   "end": 704.48,
   "text": "کینه‌های اهل ایمان رو از دل ریشه بکنه که مانع استجابت دعاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 704.48,
   "end": 707.36,
   "text": "به هر اهل ایمانی کینه تو دلته صافش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 707.36,
   "end": 709.76,
   "text": "بعد فرمود ریشه‌کن کردن عادت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 709.76,
   "end": 712.6,
   "text": "بعضی عادت‌ها تو وجود ما ریشه دوانده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 712.6,
   "end": 714.7,
   "text": "این‌ها رو باید ریشه زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 714.7,
   "end": 716.72,
   "text": "تقوا یعنی رعایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 716.72,
   "end": 719.04,
   "text": "مراقب باشیم فقط گرسنگی تشنگی نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 719.04,
   "end": 721.5,
   "text": "چشممون، زبانمون، گوشمون، اینا رو پاک نگه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 721.5,
   "end": 723.48,
   "text": "توکل که عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 723.48,
   "end": 729.32,
   "text": "اعتماد به وعده‌های خدا. دهمش هم فرمود این فرصت چند ساعت باقی‌مونده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 729.32,
   "end": 731.48,
   "text": "زیاد بگید این دعای معروف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 731.48,
   "end": 737.84,
   "text": "اللهم ان لم تکن غفرت لنا فيما مضى من شعبان فغفر لنا ما فی ما بقي من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 737.84,
   "end": 744.42,
   "text": "حالا فارسیشو خدایا اگه تا حالا ما رو نبخشیدی تو این ساعت‌های پایانی ماه شعبان ما رو ببخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 744.42,
   "end": 746.12,
   "text": "پاک وارد ماه رمضون شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 746.12,
   "end": 749.6,
   "text": "از صعه صدر و حوصله شما تشکر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 749.6,
   "end": 751.38,
   "text": "حرف گوش ندادید و نرفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 751.38,
   "end": 754.24,
   "text": "ما هم پررویی کردیم. ان‌شاءالله عاقبت بخیر بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 754.24,
   "end": 760.6,
   "text": "به برکت صلوات بر محمد و آل محمد. سلام بر محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}