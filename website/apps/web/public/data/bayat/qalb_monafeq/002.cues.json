 "chapters": [
  {
   "index": 0,
   "title": "## آب چکۀ ماشین زباله؛ اصل طهارت",
   "start": 13.52,
   "end": 113.88
  },
  {
   "index": 1,
   "title": "## جنگ تبوک؛ گم‌شدن شتر و نجوای ابن‌لثیت",
   "start": 113.88,
   "end": 142.82
  },
  {
   "index": 2,
   "title": "## بصیرت شهید حججی در برابر نجوای نفاق",
   "start": 142.82,
   "end": 381.07
  },
  {
   "index": 3,
   "title": "## پیامبر آگاه می‌کند؛ شتر در دره",
   "start": 381.07,
   "end": 595.65
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 3.54,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.54,
   "end": 7.48,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.48,
   "end": 13.52,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.52,
   "end": 17.68,
   "text": "سؤال این هستش که گاهی اوقات از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.68,
   "end": 22.06,
   "text": "ماشین‌هایی که برای شهرداری میاد زباله رو جمع می‌کنه می‌بره یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.06,
   "end": 24.7,
   "text": "آب‌هایی میچکه، آب می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.7,
   "end": 27.1,
   "text": "آب حالا این آشغال‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.1,
   "end": 29.92,
   "text": "می‌ریزه از این ماشین‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.92,
   "end": 36.84,
   "text": "یا تو همین گذر دارن میرن تو خیابون، کوچه دارن آدم میره می‌بینه آب جمع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.84,
   "end": 39.56,
   "text": "بالاخره اینا وضعیتش چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.56,
   "end": 44.96,
   "text": "پاکه؟ نجسه؟ مخصوصا اون آب‌هایی که از آشغال‌ها می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.96,
   "end": 47.54,
   "text": "این برمی‌گرده به اصل طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.54,
   "end": 50.32,
   "text": "و این که می‌فرماید هر چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.32,
   "end": 52.18,
   "text": "محکوم به طهارته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.18,
   "end": 57.58,
   "text": "تا وقتی که شما یقین نکردیم اون نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.58,
   "end": 59.92,
   "text": "که راه‌های یقین رو هم قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.92,
   "end": 62.84,
   "text": "پس این آبه و حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.84,
   "end": 66.48,
   "text": "فرمودن که نیازی به تحقیق و جستجو هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.48,
   "end": 72.26,
   "text": "شما بری تحقیق کنی که حالا این آب نجسه یا نه، به، حالا به شما چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.26,
   "end": 76.04,
   "text": "دیگه سخت نگیر دیگه. اسلام داره میگه آقا محکوم به طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.04,
   "end": 80.8,
   "text": "این آبی که داره از آشغال‌ها می‌ریزه، ماشین شهرداری می‌بره، این محکوم به طهارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.8,
   "end": 83.52,
   "text": "حالا بگو می‌خوای بری ذره‌بین بذاری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.52,
   "end": 88.2,
   "text": "یعنی آبی که جمع شده تو کوچه حالا یه ماشین اومد رفت پاشید به دامن تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.2,
   "end": 90.58,
   "text": "سخت نگیر پاکه. پاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 90.58,
   "end": 96.88,
   "text": "پیغمبر عباش تو خود معذرت می‌خوام مستراح افتاد زمین انداخت رو دوشش رفت نماز خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.88,
   "end": 101.8,
   "text": "آقا محکوم به پاکیه دیگه. چرا هی ما بعضیا تو این چیزا هی ذره‌بین می‌ذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.8,
   "end": 103.52,
   "text": "شیطان هم از همین راه میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 103.52,
   "end": 106.5,
   "text": "بعد تو حق الناس، حق الناس، حق الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 106.5,
   "end": 108.86,
   "text": "عین خیال هم نیست. آبرو بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 108.86,
   "end": 112.14,
   "text": "اونایی که اسلام گفته ذره‌بین بذار نمی‌ذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 112.14,
   "end": 115.18,
   "text": "این کار شیطونه دیگه. در واقع سی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 115.18,
   "end": 119.8,
   "text": "حرمت می‌شکنم، زیر آب می‌زنم، غیبت، تهمت، دروغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.8,
   "end": 121.82,
   "text": "اوف، اوف، اوف، نفاق، دروغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 121.82,
   "end": 128.14,
   "text": "آخ، آخ چی بگم دیگه. خب بریم سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 128.14,
   "end": 135.72,
   "text": "بحث قلب منافق که بحث بسیار دشواری‌ست و اگر تأمل کنید عزیزان و دوستان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.72,
   "end": 137.88,
   "text": "یه مقدار تأمل داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 137.88,
   "end": 142.82,
   "text": "می‌بینیم که عجب ما گاهی اوقات می‌گیم قلب منافق بهمون بر می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.82,
   "end": 146.88,
   "text": "یکی از دوستان حالا با مزاح جلсе پیش که ما اولین بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.88,
   "end": 151.94,
   "text": "حالا دوره قلب نفاق اومد گفت حاجی ما هر وقت اولین بار میایم اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.94,
   "end": 155.86,
   "text": "یا قلب منافقه یا قلب قسیه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.86,
   "end": 160.78,
   "text": "... حالا اگر تأمل کنید متوجه می‌شیم که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.78,
   "end": 164.26,
   "text": "این لایه‌های پنهانی وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.26,
   "end": 165.84,
   "text": "یه دورویی‌هایی وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.84,
   "end": 168.2,
   "text": "حالا نه اون من-- مصداق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.2,
   "end": 173.96,
   "text": "اتم مثلا نفاق نه ولی د-- تأمل کنید متوجه می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 173.96,
   "end": 180.26,
   "text": "در یک روایتی که امروز می‌دیدم تو بین راه جنگ تبوک، تو یکی از منازل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 180.26,
   "end": 184.76,
   "text": "حالا پیغمبر خیمه گاه زده و دوستان و یارانش جمع شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.76,
   "end": 189.24,
   "text": "بعد یه شخصی که حالا بعداً در جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.24,
   "end": 192.06,
   "text": "به نام یمامه شهید می‌شه ایشون به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 192.06,
   "end": 195.24,
   "text": "عمارة بن حزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 195.24,
   "end": 198.5,
   "text": "این عمارة با عین، عمارة من دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.5,
   "end": 201.12,
   "text": "اینطوری تلفظ شده. عمارة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.12,
   "end": 204.3,
   "text": "که بعداً هم شهید می‌شه، تو خیمه پیش پیغمبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 204.3,
   "end": 207.74,
   "text": "البته تو خیمه‌ی خودش چند تا از یاراشم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 207.74,
   "end": 209.88,
   "text": "یکی از اون کسایی که بود به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 209.88,
   "end": 214.82,
   "text": "ز-زید بن لثید، لثید با صاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 214.82,
   "end": 217.44,
   "text": "حالا یه وقت برخوردید تو روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 217.44,
   "end": 219.38,
   "text": "اینم اونجا تو خیمه نشسته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 219.38,
   "end": 223.84,
   "text": "حالا عمارة که رفیقش بود پیش پیغمبر بود اون لحظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 223.84,
   "end": 228.52,
   "text": "زید بن لثید تو خیمه عمارة نشسته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 228.52,
   "end": 233.06,
   "text": "زید بن لثید که از یهودیان بنی قینق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 233.06,
   "end": 236.18,
   "text": "قینقاه بود یا قینقاه هم می‌گن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 236.18,
   "end": 239.92,
   "text": "اونجا نشسته بود برگشت در گوشی-- ببین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 239.92,
   "end": 242.04,
   "text": "مشکل خیلی موقعا تو این در گوشی‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 242.04,
   "end": 247.48,
   "text": "جلوی طرف تمام قد بلند می‌شه مدیر کل تشریف آوردن، یا الله بلند می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 247.48,
   "end": 250.4,
   "text": "دست بوسیم می‌کنه بعد رفت فلان، فلان شده این کارو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 250.4,
   "end": 254.9,
   "text": "این، این نفاقه دیگه. حالا جلوی پیغمبر قربونت برم، فدات شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 254.9,
   "end": 257.18,
   "text": "بعد حالا در گوشی داره میگه ب-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 257.18,
   "end": 260.58,
   "text": "چی شده بود؟ داستان این بود که پیغمبر صبح که شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 260.58,
   "end": 264.06,
   "text": "دید شترش نیست. گم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 264.06,
   "end": 267.5,
   "text": "اعلام کرد که شتر ما گم شده و حالا صواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 267.5,
   "end": 270.08,
   "text": "در صدد این بودن پیداش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 270.08,
   "end": 277.88,
   "text": "این ابن لثید تو گوش رفیقاش گفت \"مگه نمیگه از راه‌های آسمون از من بپرسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 277.88,
   "end": 280.76,
   "text": "چطور میگه شترم گم شده؟\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 280.76,
   "end": 286.82,
   "text": "ببین امتحانه دیگه. اونم که در گوششون شنیدن اونام گفتن اِ راست میگه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.82,
   "end": 290.94,
   "text": "به جای اینکه اونا مثلا بزنن تو دهنش بگن خجالت بکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.94,
   "end": 293.14,
   "text": "اینا همه به صیرت‌ها بستگی داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 293.14,
   "end": 299.18,
   "text": "ببینید چطور یکی مثل شهید حججی نه امامی دیده، نه انقلابی دیده، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.18,
   "end": 308.62,
   "text": "سنی داره، نه مدرک تحصیلی‌ای داره، نه آدم معروف و مهم و نه مثلاً صاحب منصب و جای و چه می‌دونم نه فرمانده کله، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.62,
   "end": 310.52,
   "text": "آخوند و رفته حوزه درس خونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.52,
   "end": 318.92,
   "text": "یه آدم معمولی. اصلاً با تمام گوشت و پوست و خون خودش ولایت رو درک کرده و قسم می‌خوره که من به یقین رسیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.92,
   "end": 321.5,
   "text": "در خصوص ولایت امری رهبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.5,
   "end": 323.84,
   "text": "عجب. بعد پیغام میده به آقا بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.84,
   "end": 327.72,
   "text": "اصلاً نه آقا رو دیده، نه گفت و گو و مذاکره مستقیم داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.72,
   "end": 331.88,
   "text": "بهش بگید ما اومدیم اینجا که شما سر سلامت باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 331.88,
   "end": 337.32,
   "text": "آخه این چیه؟ ببینید این‌ها حج-- برای چی رهبری می‌فرمایند اینا حجتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.32,
   "end": 342.24,
   "text": "محکم. بعد یکی می‌بینید ش-- با-- رهبر هم بزرگ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.24,
   "end": 347.78,
   "text": "اما از جلسه گفت و گو با رهبر که میاد بیرون، بیرون به بغل دستی‌ش میگه دیدی فلان، فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.78,
   "end": 351.6,
   "text": "استغفرالله ربي و اتوب الیه. نگیم. بعد همونا می‌بینید مدیریت می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.6,
   "end": 355.14,
   "text": "حالا به اون سمت نریم. نفاق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.14,
   "end": 357.02,
   "text": "تو در گوشی بهش گفت اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.02,
   "end": 360.5,
   "text": "اینام نکردن که بابا همه به صیرت بستگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.5,
   "end": 362.69,
   "text": "صیرت وقتی مشکل داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 362.69,
   "end": 367.87,
   "text": "ضمیر و سا-سجیه انسان، شاکله انسان مشکل داشت، بو بد داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.87,
   "end": 372.69,
   "text": "بارون هم بهش بخوره، پیغمبر هم بیاد بشینه کنارش، بو گند بلند میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 372.69,
   "end": 375.11,
   "text": "اینایی که تو مص-مجلس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.11,
   "end": 382.33,
   "text": "کی بود ز-- با سلفی شهید حججی، خدا میخواد اینا رو یهو مواجه میشه سلفی اونا با سلفی شهید حججی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.33,
   "end": 384.89,
   "text": "بو گند کارشون بلند میشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 384.89,
   "end": 390.37,
   "text": "یه شهید شهید میشه مثل بارونی که میباره میزنه به لجنزار وجود اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 390.37,
   "end": 394.07,
   "text": "بو گندشون با اون سلفی مجلس بلند میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 394.07,
   "end": 396.01,
   "text": "حالا دوباره های ما ذهنمون اینور اونور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 396.01,
   "end": 398.71,
   "text": "نمیدونم. اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.71,
   "end": 400.83,
   "text": "هیچ چیزی جز بو نفاق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.83,
   "end": 403.39,
   "text": "تعجب نکنیم. باید نجات بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.39,
   "end": 406.71,
   "text": "حالا هر کی یه جور. یکی کمتر یکی بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.71,
   "end": 408.31,
   "text": "ببین این بحث خیلی دقیقهه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 408.31,
   "end": 411.01,
   "text": "حالا شروع شده اجازه بدید تأمل کنیم بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 411.01,
   "end": 414.63,
   "text": "شاید بیشتر از هر بحث دیگه‌ای رو بحث قلب ما رو این کاف شاری کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 414.63,
   "end": 417.49,
   "text": "داستانو بگیم تموم شه، ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 417.49,
   "end": 421.55,
   "text": "آقا اینا همون لحظه‌ای که این ابن لسیع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 421.55,
   "end": 426.61,
   "text": "داشت تو گوش بغل دستیاش می‌گفت، همون لحظه عمار که بعدا شهید میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 426.61,
   "end": 432.07,
   "text": "پیش پیغمبر بود. همون لحظه پیغمبر تو گوشش گفت یکی از منافقین داره اینطوری میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 432.07,
   "end": 436.93,
   "text": "“به خدا قسم من به هیچ چیزی آگاه نیستم مگر اینکه خدا آگاهم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.93,
   "end": 439.23,
   "text": "و الان خدا منو آگاه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.23,
   "end": 441.95,
   "text": "که شترم تو فلان دره است اسب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 441.95,
   "end": 445.21,
   "text": "بگید به اصحاب زحمت کشیدن برن ورش دارن بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.21,
   "end": 448.59,
   "text": "بیچاره داشته می‌رفته افسارش گیر کرده به شاخه درخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 448.59,
   "end": 453.03,
   "text": "گیر کرده اونجا. برید بیاریدش.” همونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 453.03,
   "end": 458.47,
   "text": "بعد عمار وقتی اومد بیرون رفت تو خیمه‌ش گفت \"کی حرف زده الان در رابطه با این قصه؟\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.47,
   "end": 461.75,
   "text": "لو رفت که ابن لسیع زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 461.75,
   "end": 463.95,
   "text": "گفت \"ای ملعون برو\" باهاش دعوا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 463.95,
   "end": 467.51,
   "text": "برو. ببین این چه تعصبی رو به پیغمبر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 467.51,
   "end": 470.79,
   "text": "برو به قول ما برو گمشو از خیمه من بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 470.79,
   "end": 476.01,
   "text": "چون تو خیمه این بود. پیغمبر گفت یه منافق این حرفو زده معلومه تو...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 476.01,
   "end": 480.37,
   "text": "حالا بعضی روایات اهل تسنن میگن این ابن لسیع بعداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.37,
   "end": 482.95,
   "text": "توبه کرد. ولی کاری حالا-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 482.95,
   "end": 487.03,
   "text": "روایت ضعیفه. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 487.03,
   "end": 490.47,
   "text": "و رفتن شتر پیغمبر رو پیدا کردن و اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 490.47,
   "end": 496.57,
   "text": "واقعاً اگر یه کسی مثل امیرالمؤمنین علیه الصلاة والسلام بعد از پیغمبر نبود که چهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 496.57,
   "end": 502.15,
   "text": "نفاق رو-- حضرت زهرا سلام الله علیها نبود که چهره نفاق رو آشکار کنه، همه اینا دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 502.15,
   "end": 504.33,
   "text": "پیغمبری هم می‌کردن یه وقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.33,
   "end": 507.03,
   "text": "دعای اسلام که داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 507.03,
   "end": 527.03,
   "text": "این تو ندبه می‌خونید که به امیرالمؤمنین میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 586.21,
   "end": 589.87,
   "text": "[سخنگوی 1] اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 589.87,
   "end": 592.67,
   "text": "صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 592.67,
   "end": 595.65,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}