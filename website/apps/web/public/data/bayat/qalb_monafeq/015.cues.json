   "start": 497.4,
   "end": 521.26
  },
  {
   "index": 6,
   "title": "## انقلاب؛ معجزهٔ عصر ما",
   "start": 521.26,
   "end": 567.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.04,
   "end": 4.2,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.2,
   "end": 7.82,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.82,
   "end": 11.86,
   "text": "آياته. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.86,
   "end": 13.88,
   "text": "یکی دیگه از عناوین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.88,
   "end": 16.48,
   "text": "شرعی در فقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.48,
   "end": 21.24,
   "text": "مسافر و این‌ها برای بحث مسافر و مسافرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.24,
   "end": 23.06,
   "text": "تر-- حد ترخص است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.06,
   "end": 25.6,
   "text": "حد ترخص با صاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 25.6,
   "end": 28.22,
   "text": "با مسافت شرعی با هم متفاوت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 28.22,
   "end": 30.88,
   "text": "مسافت شرعی اون میزانی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 30.88,
   "end": 35.28,
   "text": "تو باید قصد کنی قطعاً بری تا مسافر حساب بشی که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 35.28,
   "end": 38.18,
   "text": "اما حد ترخص یعنی کجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 38.18,
   "end": 41.96,
   "text": "مرخص میشی؟ یعنی کجا دیگه می‌تونی شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 41.96,
   "end": 45.52,
   "text": "کجا وقتی از شهر خارج شدی کجا دیگه مسافر حساب میشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 45.52,
   "end": 48.6,
   "text": "از کجا تو قصد داری مسافت شرعی رو بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 48.6,
   "end": 55.64,
   "text": "اما از کجا حق داری نمازتو یعنی باید نمازتو شکسته بخونی و روزت رو بخوری که قبل از اون حق نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 55.64,
   "end": 58.6,
   "text": "اینو دقت بفرمایید. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 58.6,
   "end": 60.82,
   "text": "کتاب‌های مراجع همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 60.82,
   "end": 64.08,
   "text": "رساله‌های عملیه همه نوشتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 64.08,
   "end": 67.7,
   "text": "جایی که صدای اذان شهر رو نشنوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 67.7,
   "end": 71.44,
   "text": "و دیوارهای شهری یا آخرین خانه‌های شهر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 71.44,
   "end": 76.06,
   "text": "واضح نتونی ببینی. خب الان خب از اذان مثلا اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 76.06,
   "end": 78.8,
   "text": "از رسانه پخش می‌شه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 78.8,
   "end": 80.78,
   "text": "اذان و توی با بلندگو و اینا میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 80.78,
   "end": 84.66,
   "text": "یه مقدار قصه فرق کرده لذا مراجع اومدن حد تعیین کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 84.66,
   "end": 91.44,
   "text": "بررسی کردن بین هزار و سیصد و پنجاه متر تا هزار و پونصد متر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 91.44,
   "end": 97.08,
   "text": "اختلاف هست. رهبر عزیزمون هزار و سیصد و پنجاه متر حد ترخص رو بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 97.08,
   "end": 103.04,
   "text": "یعنی از آخرین خونه شهر یا دیوار شهر شما حساب کن هزار و سیصد و پنجاه متر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.04,
   "end": 107.24,
   "text": "الانم تابلو زدن. معمولاً همه شهرها تا خارج می‌شی تابلو زده حد ترخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 107.24,
   "end": 115.78,
   "text": "یعنی چی حد ترخص؟ یعنی شما اگر قصد داری قطعاً به فتوای رهبری بیست کیلومتر و نیم حداقل در رفتت بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.78,
   "end": 118.46,
   "text": "از حد ترخص دیگه مسافر حساب میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.46,
   "end": 121.08,
   "text": "بعضیا وایمیستن تا برسن به مقصد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 121.08,
   "end": 123.84,
   "text": "بعد نماز شکسته می‌خونن. این غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 123.84,
   "end": 127.58,
   "text": "اصلاً تا به حد ترخص رسیدی دیگه مسافری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 127.58,
   "end": 130.58,
   "text": "و باید نمازتو شکسته بخونی، روزت هم اونجا باید بخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 130.58,
   "end": 133.54,
   "text": "تو شهرت نمی‌تونی بخوری باید برسی به حد ترخص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.54,
   "end": 135.74,
   "text": "و نباید هم صبر کنی تا برسی به مقصد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 135.74,
   "end": 140.72,
   "text": "نه این اشتباهه. در خصوص قلب منافق دیروز نکته خیلی مهمی رو ما گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 140.72,
   "end": 143.56,
   "text": "چون انقدر این قصه مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 143.56,
   "end": 147.78,
   "text": "من امروز هم روش تاکید می‌کنم که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 147.78,
   "end": 149.54,
   "text": "رأس النفاق خیانته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 149.54,
   "end": 153.82,
   "text": "اون سر نفاق یعنی اون اوجش، اون بحث قلب نفاق بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 153.82,
   "end": 160.76,
   "text": "قلبی که دچار نفاق شده. هرکس که دچار نفاق شد، دچار خیانت شده قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 160.76,
   "end": 162.76,
   "text": "سر خورده سمت نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 162.76,
   "end": 164.98,
   "text": "و قلبش به دورویی افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 164.98,
   "end": 168.06,
   "text": "دوراهی. به صراط مستقیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 168.06,
   "end": 172.9,
   "text": "ثبات قدم پیدا نکرده. تسبت پیدا نکرده به قول بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 172.9,
   "end": 178.74,
   "text": "حالا این خیانت عرض کردیم هر چقدر که به ارزش‌های اصیل‌تر باشه، مکافاتش هم بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 178.74,
   "end": 182.7,
   "text": "یه نمونه من در روایات براتون عرض کنم که ریشه قرآنی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 182.7,
   "end": 187.92,
   "text": "ذیل آیات سیزده فصلت، چهل و چهار ذاریات و هفتاد و هشت اعراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 187.92,
   "end": 190.14,
   "text": "می‌تونید این داستان رو پیگیری کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 190.14,
   "end": 193.1,
   "text": "تقریباً هم معروف هست. یکی از بزرگان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 193.1,
   "end": 195.92,
   "text": "از انبیاء عظام ما حضرت صالح‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 195.92,
   "end": 199.38,
   "text": "کنار حضرت هود کجا دفنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 199.38,
   "end": 204.2,
   "text": "انشاالله به زودی برید. آفرین وادی السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 204.2,
   "end": 208.32,
   "text": "که مقفول هم واقع مونده. این دو بزرگوار از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 208.32,
   "end": 210.9,
   "text": "بزرگترین انبیاء الهی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 210.9,
   "end": 214.32,
   "text": "حضرت صالح حدود صد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 214.32,
   "end": 216.16,
   "text": "چهار سال رسالت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 216.16,
   "end": 218.48,
   "text": "شونزده سالگی مبعوث شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 218.48,
   "end": 221.2,
   "text": "صد و بیست سال هم عمر کرد. صد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 221.2,
   "end": 225.1,
   "text": "چهار سال می‌شه دیگه آره. صد و چهار سال ایشون رسالت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 225.1,
   "end": 227.64,
   "text": "رسالت داشت، نبوت و این‌ها داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 227.64,
   "end": 230.24,
   "text": "خب مردم رو دعوت می‌کرد لکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 230.24,
   "end": 233.5,
   "text": "خیلی جالبه دیگه آخرها هرچی می‌گفت گوش نمی‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 233.5,
   "end": 237.18,
   "text": "مردم هم رفته بودند گرفتار دنیا شده بودند عجیبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 237.18,
   "end": 240.1,
   "text": "بدتر از الان انقلاب ما که خیلی از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 240.1,
   "end": 242.36,
   "text": "حتی عمامه به سر‌هایی که باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 242.36,
   "end": 247.08,
   "text": "مظهر زهد و تقوا باشن تو کاخ زندگی می‌کنند بعضی از این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 247.08,
   "end": 252.64,
   "text": "اصلاً بدتر از این‌ها تو دل کوه یه خونه‌ها و قصرهایی ساخته بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 252.64,
   "end": 255.64,
   "text": "که بعضی از آثارشو الان میرن نگاه می‌کنن باورشون نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 255.64,
   "end": 259.44,
   "text": "اون موقع نه جرثقیل بوده نه هیچی چجوری اینا ساخته شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 259.44,
   "end": 261.34,
   "text": "خیلی گرفتار دنیا شده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 261.34,
   "end": 265.18,
   "text": "باغ‌های بزرگ، بدجوری حرص دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 265.18,
   "end": 268.02,
   "text": "و هرچی حضرت صالح اینا رو نصیحت می‌کرد فایده نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 268.02,
   "end": 271.82,
   "text": "آخر گفت آقا عجب کلک قشنگی زده، زرنگی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 271.82,
   "end": 274.92,
   "text": "حالا کلک شناخته شده زرنگی، زیرکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 274.92,
   "end": 277.94,
   "text": "حضرت فرمود آقا بیایید جمع شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 277.94,
   "end": 281.06,
   "text": "چی می‌خواید شما؟ از بت‌های شما درخواست کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 281.06,
   "end": 285.3,
   "text": "اگه بت‌های شما دادن خب همه ایمان بیاریم به بت‌های شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 285.3,
   "end": 288.58,
   "text": "اگه خدای من داد درخواست شما رو ایمان بیارید به خدای من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 288.58,
   "end": 291.54,
   "text": "گفتن حرف خوبیه، حرف منطقی‌یه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 291.54,
   "end": 295.38,
   "text": "هفتاد نفر گنده‌هاشونو جمع کردن، زبده‌هاشونو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 295.38,
   "end": 299.54,
   "text": "رفتن توی کوهی، اونجا شروع کردن درخواست کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 299.54,
   "end": 303.1,
   "text": "عباد، اون عباد مثلا اصل کارشون زوحدشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 303.1,
   "end": 306.52,
   "text": "این‌ها شروع کردن اول از بت‌ها خواستن هیچ خبری نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 306.52,
   "end": 309.02,
   "text": "نوبت حضرت صالح شد سلام الله عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 309.02,
   "end": 311.08,
   "text": "گفتن خب حضرت باز زرنگی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 311.08,
   "end": 315.1,
   "text": "چی می‌خواید از خودش نگفت. گفت شما چی می‌خواید من طلب کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 315.1,
   "end": 318.7,
   "text": "از خدای من؟ همه گفتن یه چیز عجیب غریب بخواهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 318.7,
   "end": 322.06,
   "text": "گفتن که از خدا بخواه همین الان از دل این کوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 322.06,
   "end": 326.66,
   "text": "یه شتری بیاد بیرون که اولاً ده ماهه آبستن باشه، ماده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 326.66,
   "end": 332.24,
   "text": "بعد سینش سفید باشه، بدنش هم زرد خیلی پررنگی باشه بقیه بدنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 332.24,
   "end": 336.94,
   "text": "چیزا عجیبی خواستن. به محض که حضرت صالح سلام الله دستشو برد بالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 336.94,
   "end": 342.84,
   "text": "در قصص الانبیا مبثوت این هست و ذیل اون آیاتی که گفتم تفاسیر اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 342.84,
   "end": 346.16,
   "text": "یه دفعه دیدن یه غرش و صدای مهیبی اومد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 346.16,
   "end": 351.06,
   "text": "کوه شکافته شد. اون شتره اومد بیرون با همین وضعی که اینا می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 351.06,
   "end": 354.04,
   "text": "همه متعجب موندن. جالبه که از اون هفتاد نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 354.04,
   "end": 356.92,
   "text": "متأسفانه فقط شش نفر ایمان آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 356.92,
   "end": 360.86,
   "text": "بقیه گفتن بابا این سحر کرده، این ساحره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 360.86,
   "end": 364.42,
   "text": "رفتن. از اون شش نفر هم یه نفر دوباره بین راه برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 364.42,
   "end": 367.12,
   "text": "گفت من پشیمون شدم. پنج نفر موندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 367.12,
   "end": 372.24,
   "text": "بعداً خب قرار شد که این پنج نفر ایمان آوردن قرار شد که این شتر چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 372.24,
   "end": 374.78,
   "text": "چون معجزه الهیه تزئین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 374.78,
   "end": 378.92,
   "text": "حضرت فرمود یه روز یه چشمه اونجا بود خیلی آب خوبی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 378.92,
   "end": 384.24,
   "text": "از-- اینم امتحان خداست. اینا امتحانات عجیبی هست که رو اینا باید بحث شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 384.24,
   "end": 387.56,
   "text": "حضرت فرمود یه روز از این آبه شتره بخوره، یه روز مال شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 387.56,
   "end": 390.1,
   "text": "اون روزی که شتر میخوره شما حق نداری دست به آب بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 390.1,
   "end": 393.42,
   "text": "خب ما تشنه میشیم چیکار کنیم؟ حضرت فرمود از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 393.42,
   "end": 398.2,
   "text": "شیر شتره بخورید. این همه آدم از چی-- گفت آره معجزه خداست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 398.2,
   "end": 401.68,
   "text": "آقا همه از شیر این شتره می خوردن بازم برکت می کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 401.68,
   "end": 405.82,
   "text": "چه که خدا بخواد. خلاصه این گذشت تا اینکه دیدن نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 405.82,
   "end": 408.68,
   "text": "نتونستن ببینن. حقد و کینه نتونستن ببینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 408.68,
   "end": 410.34,
   "text": "این معجزه الهی خیانت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 410.34,
   "end": 414.2,
   "text": "چیکار کردن؟ هج า ร์ زدن که آقا اینقدر پول میدیم هرکی بره اینو بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 414.2,
   "end": 416.0,
   "text": "هم کسی جرات نمی کرد. عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 416.0,
   "end": 418.86,
   "text": "اینها همش نکته است ها. سره باور کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 418.86,
   "end": 420.46,
   "text": "از چه طریقی موفق شدند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 420.46,
   "end": 423.26,
   "text": "زن. دو تا زن خوشگل پیدا کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 423.26,
   "end": 426.14,
   "text": "این زن‌ها یکیشون اسمش سدوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 426.14,
   "end": 429.18,
   "text": "دختر مهیا بود. اومد پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 429.18,
   "end": 431.86,
   "text": "خلاصه یه شخصی به نام مصرع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 431.86,
   "end": 436.18,
   "text": "زیر پاش نشست و تننازی کرد و عشوه گری کرد دل اینو برد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 436.18,
   "end": 441.34,
   "text": "گفت آره اگه میخوای به من برسی راه مهریه من کشتن این شتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 441.34,
   "end": 444.8,
   "text": "یکی یه زن دیگه‌ای هم رفت سراغ قدار بن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 444.8,
   "end": 451.16,
   "text": "صالح. اونو گیر آورد و گفت آره از اونم دلبری کرد و اینا مثلا زن‌های پولدار و خوشگل اون زمان بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 451.16,
   "end": 454.56,
   "text": "خلاصه قدار هم گول خورده که چیکار کنن اونو بکشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 454.56,
   "end": 462.4,
   "text": "شترو. رفتن خلاصه پنهانی شتر اونجا واسه خودش داشت کیف می‌کرد و این اولین قدار یه تیر زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 462.4,
   "end": 466.68,
   "text": "نوشتن تو روایت که دو تا پای جلوی این شتر رو به هم دوخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 466.68,
   "end": 469.56,
   "text": "اون مصرع هم با یه شمشیر دو تا پای عقبشو زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 469.56,
   "end": 475.8,
   "text": "افتاد زمین. قدار هم بلند شد با شمشیر گردن شترو زد و تا افتاد ریختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 475.8,
   "end": 477.84,
   "text": "خیلی عجیبه که ملت خبردار شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 477.84,
   "end": 481.2,
   "text": "ریختن شو-- گوشت این شترو قربونی می‌بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 481.2,
   "end": 484.92,
   "text": "عجب! اگه شما قبول ندارید این معجزه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 484.92,
   "end": 487.96,
   "text": "مثل شیخ فضل‌الله نوری رحمت‌الله علیه بالا م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 487.96,
   "end": 491.86,
   "text": "بردنش بالا دار. بعد پای دار گریه می‌کردن ملت به حالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 491.86,
   "end": 496.12,
   "text": "گریه، گریه چیه؟ ظلم شده نجاتش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 496.12,
   "end": 500.68,
   "text": "خلاصه هیچی. بعد حضرت صالح فرمود حالا که خیانت کردید چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 500.68,
   "end": 504.58,
   "text": "تا سه روز اول چهره‌تون زرد میشه بعد سرخ، بعد سیاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 504.58,
   "end": 509.78,
   "text": "بازم اینم لطف خدا بود که اینا با خودشون-- باز این چهره‌هاشون اینطوری شد باز ایمان نیاوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 509.78,
   "end": 512.42,
   "text": "گفتن بگو خدا عذابشو بفرسته ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 512.42,
   "end": 518.48,
   "text": "یه دفعه تندباد و صاعقه زد هم اون خونه‌ها هم همه درد و درب و داغون شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 518.48,
   "end": 521.26,
   "text": "ببین خیانت به معجزه الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 521.26,
   "end": 525.04,
   "text": "حالا شما به من بگید بحث دیروز ما بحث‌های روز بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 525.04,
   "end": 530.92,
   "text": "به روزش کنیم به نظر شما چه معجزه‌ای در عصر ما بالاتر از انقلاب خود ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 530.92,
   "end": 533.38,
   "text": "خود حضرت امام از معجزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 533.38,
   "end": 535.46,
   "text": "الهی ازش یاد کرد. انفجار نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 535.46,
   "end": 540.04,
   "text": "معجزه قرن. اگر کسی به این انقلاب به خون این شهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 540.04,
   "end": 547.94,
   "text": "خیانت کنه، این هم به مقدسات و معجزات الهی خیانت کرده و مطمئن باشه یه روزی صاعقه خدا می‌گیرتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 547.94,
   "end": 552.92,
   "text": "حالا یا، یا تو آب خرق خفه میشه یا سقف سرش خراب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 552.92,
   "end": 555.9,
   "text": "بالاخره آه دل این خانواده‌های شهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 555.9,
   "end": 558.48,
   "text": "می‌گیرتش و این نشانه نفاق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 558.48,
   "end": 563.22,
   "text": "انشاالله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 563.22,
   "end": 567.3,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}