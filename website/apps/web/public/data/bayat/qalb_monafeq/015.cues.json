   "index": 1,
   "title": "## رأس النفاق خیانت است",
   "start": 137.46,
   "end": 157.46
  },
  {
   "index": 2,
   "title": "## دعوت صالح و کاخ‌های در کوه",
   "start": 157.46,
   "end": 268.02
  },
  {
   "index": 3,
   "title": "## پیشنهاد صالح و درخواست شتر",
   "start": 268.02,
   "end": 367.12
  },
  {
   "index": 4,
