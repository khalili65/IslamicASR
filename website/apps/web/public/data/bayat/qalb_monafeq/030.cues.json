 "chapters": [
  {
   "index": 0,
   "title": "## تابعیت همسر و فرزند از وطن پدر",
   "start": 0.6,
   "end": 52.02
  },
  {
   "index": 1,
   "title": "## زمین؛ قرارگاه استکمال نه تبعیدگاه",
   "start": 52.02,
   "end": 90.84
  },
  {
   "index": 2,
   "title": "## بهشت خوردن و نهی از شجره",
   "start": 90.84,
   "end": 370.15
  },
  {
   "index": 3,
   "title": "## خلیفه در زمین؛ خط بطلان بر شعر فراق",
   "start": 370.15,
   "end": 482.39
  },
  {
   "index": 4,
   "title": "## نهی ارشادی از سر شفقت",
   "start": 482.39,
   "end": 667.21
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.6,
   "end": 4.62,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.62,
   "end": 8.14,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.14,
   "end": 13.16,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.16,
   "end": 17.22,
   "text": "در خصوص وطن از رهبر عزیزمون پرسیدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.22,
   "end": 22.36,
   "text": "آیا همسر و فرزندان از جهت وطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.36,
   "end": 26.72,
   "text": "باید تابع همسر باشن، شوهر باشن، پدر باشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.72,
   "end": 31.56,
   "text": "یعنی هر کجا که وطن پدر شد، لاجرم هم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.56,
   "end": 36.28,
   "text": "زن ایشون و بچه های ایشونم اونجا وطن‌شون باید باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.28,
   "end": 40.88,
   "text": "یا می‌تونن اعراض کنن، می‌تونن اصلا اونجا رو وطن نگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.88,
   "end": 44.1,
   "text": "آقا فرمودن در خصوص همسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.1,
   "end": 47.82,
   "text": "می‌تونه وطن شوهرش رو مثلا زن می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.82,
   "end": 51.74,
   "text": "وطن شوهرش رو وطن اتخاذ نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.74,
   "end": 56.86,
   "text": "این یه نکته. اما در خصوص بچه‌ها اگر بچه‌ها صغیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.86,
   "end": 60.86,
   "text": "و در کسب و کاسبی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.86,
   "end": 65.22,
   "text": "و تشخیص سیر زندگیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.22,
   "end": 67.54,
   "text": "تحت تکفل پدرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.54,
   "end": 73.26,
   "text": "و مستقل نیستن، اون‌هام لاجرم وطن پدر وطن اون‌هام حساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.26,
   "end": 75.56,
   "text": "اما اگر مستقلن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.56,
   "end": 79.06,
   "text": "و خودشون کسب و کاسبی دارند و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.06,
   "end": 84.48,
   "text": "اون‌هام می‌تونن وطن پدر رو وطن اتخاذ نکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.48,
   "end": 87.58,
   "text": "نکته‌ای که امروز بهش منتقل می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.58,
   "end": 89.92,
   "text": "نکته بسیار مهمی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.92,
   "end": 96.54,
   "text": "و به صورت دلگرمی نه دستگرمی به یکی از عزیزان قبل از بحث عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.54,
   "end": 98.56,
   "text": "خیلی منقلب شد. گفت چه خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.56,
   "end": 101.44,
   "text": "چه نگرش انسان رو این بحث‌ها عوض می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.44,
   "end": 107.4,
   "text": "من جمله از اینکه بدونید مباحث پیرامون ذیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.4,
   "end": 114.56,
   "text": "درس علامه حسن زاده حفظه الله تعالی و علامه جوادی آملیه معمولا مطالبی که من میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.56,
   "end": 117.52,
   "text": "لذا شما با خیال راحت بپذیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.52,
   "end": 121.46,
   "text": "البته همش ذیل آیات و روایات هست از خودمون که حرفی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.46,
   "end": 126.66,
   "text": "شاید این بحث امروز ناپخته بمونه و فردا انشاالله تکمیلش کنیم اما بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.66,
   "end": 131.22,
   "text": "نکته مهمی درش هست. سریع بریم جلو ذهن‌هاتون رو آماده کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.22,
   "end": 134.22,
   "text": "که نکته پیام خیلی خوبی انشاالله دستگیرتون بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.22,
   "end": 138.32,
   "text": "اولا خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.32,
   "end": 145.82,
   "text": "به حضرت آ-- به ملائکه می‌فرماید اونجا که \"اذ قال رب کل الملائکه انی جاعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.82,
   "end": 149.04,
   "text": "فی الارض خليفه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.04,
   "end": 152.86,
   "text": "من قصد کردم که در زمین \"فی الارض\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.86,
   "end": 155.16,
   "text": "حالا در دروس هئیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.16,
   "end": 159.2,
   "text": "ارز رو چی میگن؟ به کره اطلاق نمی‌کنن، به سطح اطلاق می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.2,
   "end": 163.32,
   "text": "یه بحثی‌ست که من به هر حال خدا میگه من می‌خوام تو زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.32,
   "end": 166.1,
   "text": "جعل خليفه کنم. این یه نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.1,
   "end": 171.1,
   "text": "جای دیگه می‌فرماید که \"ولکم فی الارض\" این آیات قرآنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.1,
   "end": 173.3,
   "text": "\"ولکم فی الارض مستقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.3,
   "end": 175.88,
   "text": "و متاع الی حين\". ما دوباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.88,
   "end": 178.24,
   "text": "بارش برای شما این لكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.24,
   "end": 185.2,
   "text": "لام استكمالیه. یعنی ما برای کمال شما \"فی الارض\" دوباره میگه در زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.2,
   "end": 188.46,
   "text": "نمیگه در بهشت. \"فی الارض مستقر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.46,
   "end": 191.02,
   "text": "مستقر از ریشه قر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.02,
   "end": 193.36,
   "text": "به معنای آرامش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.36,
   "end": 199.76,
   "text": "قرار گرفتنه. میگه ما تو زمین برای شما قرار، استقرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.76,
   "end": 203.96,
   "text": "و قرارگاه و آرامگاه قرار دادیم و \"متاع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.96,
   "end": 209.1,
   "text": "الی حين\" تا یه فرصتی به شما بدیم اونجا تمتع پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.1,
   "end": 212.96,
   "text": "متجر شما میشه. حدیث داریم دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.96,
   "end": 216.32,
   "text": "متجر اولیاء الله محله تجارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.32,
   "end": 218.8,
   "text": "اینم یه نکته. باز میگه تو زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 218.8,
   "end": 221.36,
   "text": "ما برای شما اون آرامگاه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.36,
   "end": 224.76,
   "text": "رسیدن به تمتع گوناگون رو قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.76,
   "end": 231.84,
   "text": "توی آیه دیگه می‌فرماید به حضرت آدم خدا رو می‌کنه می‌فرماید \"اسکن انت وزوجک الجنه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.84,
   "end": 233.92,
   "text": "تو و همسرت تو بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.92,
   "end": 237.0,
   "text": "ساکن بشید \"وکل من ها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.0,
   "end": 242.96,
   "text": "کل نعمت‌های بهشتی رو خلاصه اینجا خدا میاره تو یه جمله، تو یک کلمه که \"کل من ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.96,
   "end": 246.32,
   "text": "حيث شئتما\". بخورید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.32,
   "end": 250.18,
   "text": "از آنچه که دوست دارید تو بهشت بخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.18,
   "end": 253.88,
   "text": "که آن این بهشتی که الان حضرت آدم توشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.88,
   "end": 256.36,
   "text": "تو اون لحظه یه بهشت خورد و خوراکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.36,
   "end": 263.94,
   "text": "بخور و بخوابه. اون بهشت بهشتی نیست که کمال وجودی درش تعبیه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.94,
   "end": 271.12,
   "text": "لذا از خوردن مثل اینکه نیاز ما صرفا خوردن نیست که \"کل من ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.12,
   "end": 275.76,
   "text": "حيث\" هرچی دوست دارید بخورید \"ولا تقربا هذه الشجرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.76,
   "end": 279.34,
   "text": "فتكونا من الظالمين\". به این نمیگه باز نخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.34,
   "end": 282.6,
   "text": "میگه به این شجره نزدیک نشید که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.6,
   "end": 286.58,
   "text": "عرب به هر چیز رویش و رستنی میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.58,
   "end": 288.96,
   "text": "شجره نه فقط به درخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 288.96,
   "end": 291.94,
   "text": "حالا که این بعضا توش مباحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.94,
   "end": 294.22,
   "text": "مبسوطی شده که اصلا این شجره چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.22,
   "end": 299.1,
   "text": "فعلا هم ما کاری نداریم. که فرمودن یه به یک معنا نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.1,
   "end": 301.64,
   "text": "انسانه که نفس به هر حال ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.64,
   "end": 305.9,
   "text": "می‌دونید که نفس از جهتی تعلق به بدن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.9,
   "end": 310.38,
   "text": "برای یک تعلقش ذاتی‌ست، یک تعلقش استكمالی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.38,
   "end": 313.14,
   "text": "یک تعلقش هم تجلی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.14,
   "end": 315.86,
   "text": "نفس اگر بخواد به کمال برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.86,
   "end": 318.44,
   "text": "از طریق این بدن به کمال میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.44,
   "end": 321.94,
   "text": "اصلا جسمانیة الحدوث هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.94,
   "end": 324.1,
   "text": "بدون بدن نمی‌تونه باشه نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 324.1,
   "end": 327.9,
   "text": "ه-- تو هر عالمی هم بره یک بدن نیاز داره تا به کمال برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 327.9,
   "end": 332.96,
   "text": "حالا این بدنی که ما داریم از چهار تا عنصر آب و خاک و هوا و آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.96,
   "end": 336.46,
   "text": "گرفته شده، این آب و خاک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.46,
   "end": 338.68,
   "text": "هوا و آتش توی کره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.68,
   "end": 343.74,
   "text": "عرض، توی سطح عرض، توی عرض، تو زمین تعبیه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.74,
   "end": 347.82,
   "text": "اگر نفس بخواد با اون جسمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.82,
   "end": 349.84,
   "text": "که ت-- گرفته شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 349.84,
   "end": 354.68,
   "text": "یا عصاره شده م-- عرض شود عصر یا عصاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.68,
   "end": 357.24,
   "text": "اون چهار تا عنصر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.24,
   "end": 360.16,
   "text": "جسم ما وجود داره بخواد به کمال برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.16,
   "end": 363.02,
   "text": "باید بیاد جایی که این عناصر وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.02,
   "end": 366.71,
   "text": "یعنی همین زمین در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 366.71,
   "end": 369.25,
   "text": "یک نکته اینجا برداشت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.25,
   "end": 373.87,
   "text": "اولا خدا در زمین خلیفه قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.87,
   "end": 380.59,
   "text": "حضرت آدم از اول میدونه اگر بخواد \"وعلم آدم الاسماء كلها\" معلم به همه‌ی اسماءه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.59,
   "end": 383.99,
   "text": "میدونه حضرت آدم خلیفه کجا باید باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.99,
   "end": 388.31,
   "text": "تو زمین نه تو بهشت که. اصلا قراره بره تو زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 388.31,
   "end": 390.63,
   "text": "چون قراره \"إني جاعل في الأرض خليفة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 390.63,
   "end": 393.59,
   "text": "آدم ما تورو ز-- خلیفه قرار دادیم کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 393.59,
   "end": 396.63,
   "text": "تو زمین قرار نیست تو بهشت خلیفه باشی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 396.63,
   "end": 401.09,
   "text": "پس اصلا قرار بوده حضرت آدم بیاد تو زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.09,
   "end": 406.43,
   "text": ". و اینجا میگه استقرار شما و متاع شما، تمتع شما تو زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.43,
   "end": 411.11,
   "text": "حتی اگر بخوای به بهشت که هشت یعنی گذاشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 411.11,
   "end": 419.37,
   "text": "بگذاری اون چیزهایی که خدا بهت داده استکمال پیدا کنه، نفس ناطقت کمال پیدا کنه و بتونی اون رو حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.37,
   "end": 421.47,
   "text": "آذوقه قرار بدی برای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 421.47,
   "end": 425.93,
   "text": "توشه قرار بدی برای سیر آخرتت باید بیای این دنیا راه دیگه‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 425.93,
   "end": 429.81,
   "text": "اگر ما تو بهشت می‌موندیم صرف خوردن و خوابیدن بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.81,
   "end": 434.33,
   "text": "یک. دوما امام حسین و شمر کنار هم بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 434.33,
   "end": 437.85,
   "text": "اونجا هم شمر شیطنت‌هاشو می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.85,
   "end": 441.73,
   "text": "سوما ، استکمال به وجود نمی‌اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.73,
   "end": 444.95,
   "text": "یعنی اونجا اصلا قابلیت اینو نداشت که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 444.95,
   "end": 449.65,
   "text": "نفس ناطقمون به کمال برسه، به عروج برسه، معراج بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.65,
   "end": 453.13,
   "text": "\"الصلات معراج المؤمن\". اصلا اونجا این قابلیت رو نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.13,
   "end": 455.23,
   "text": "اینجا این قابلیت رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 455.23,
   "end": 457.85,
   "text": "ما اصلا باید میومدیم رو زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.85,
   "end": 461.05,
   "text": "حالا اینا رو می‌خوام بگم منتقل بشیم به این نکته‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.05,
   "end": 464.19,
   "text": "پس یه خط بسلان اولا بکشید رو اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.19,
   "end": 471.41,
   "text": "شعری که من ملک بودم و فردوس برین جایم بود آدم آورد در این خیر خرابات مرا، در این دیر خرابات مرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 471.41,
   "end": 475.93,
   "text": "نه خیر اتفاقا باید میومدیم که به استکمال برسیم، به کمال برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 475.93,
   "end": 479.49,
   "text": "این حرفا نیست. اصلا در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 479.49,
   "end": 481.73,
   "text": "حضرت آدم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.73,
   "end": 487.13,
   "text": "نهی‌ام که \"ولا تقربانه\" میگه نخورید، نزدیک این شجره نشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 487.13,
   "end": 493.81,
   "text": "در حقیقت این امر مولوی هم مفسرین فرمودن، علامه طباطبایی فرمود امر مولوی نیست که \"الا بالله حق ند\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 493.81,
   "end": 495.87,
   "text": "نباید نزدیک بشه. نه امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 495.87,
   "end": 498.47,
   "text": "ارشادیه، اشفاقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 498.47,
   "end": 504.47,
   "text": "از رو شفقت. مثل اینکه تو به پسرت میگی پسرم نرو آهنگری خیلی سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.47,
   "end": 507.25,
   "text": "برو عطر فروشی. پیغمبر به یه نفر این توصیه رو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 507.25,
   "end": 509.87,
   "text": "گوش نداد رفت آهنگری. وضعش هم خوب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 509.87,
   "end": 515.37,
   "text": "پیغمبر فرمود تو عطر فروشی هم می‌رفتی همینقدر درآمد داشتی اما کارتو سخت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.37,
   "end": 520.73,
   "text": "این امر اشفاقیه. خدا از رو شفقت میگه نزدیک این درخت نشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.73,
   "end": 522.93,
   "text": "توجه کردید که کار سخت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.93,
   "end": 526.33,
   "text": "اما حضرت آدم جعل شده برای خلیفه در زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.33,
   "end": 530.99,
   "text": "این سختی رو به جان خرید که بیاد رو زمین چی کار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.99,
   "end": 534.23,
   "text": "هم خودش رو به کمال برسونه و به معراج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 534.23,
   "end": 540.37,
   "text": "هم یک ملتی رو کشتی نجاتی بشه برای یک امتی اون‌ها رو هم به معراج برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 540.37,
   "end": 543.11,
   "text": "که اون سه سیر پیغمبر در معراج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 543.11,
   "end": 547.41,
   "text": "یکیش از مسجد الحرام تا مسجد الاقصی رو زمین این عروج صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 547.41,
   "end": 549.27,
   "text": "این همین عبادت‌های ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 549.27,
   "end": 552.55,
   "text": "همین معراج‌های زمینی ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 552.55,
   "end": 555.19,
   "text": "که اگر این صورت نمی‌گرفت ما معراجی نداشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.19,
   "end": 562.15,
   "text": "پس نکته اول که الان نکته دوم دیگه فردا، الان وقت نمیشه اگرچه آماده کرده بودم امروز بگم فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 562.15,
   "end": 565.03,
   "text": "نکته اول که بهش منتقل می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 565.03,
   "end": 568.09,
   "text": "اینه که ما باید میومدیم رو این زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 568.09,
   "end": 573.41,
   "text": "حتی تو دعایی که برای امام عصرم می‌کنیم میگیم حتی تسکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 573.41,
   "end": 580.69,
   "text": "ارضک. تا ساکن بشه حضرت آدم-- حضرت ولی عصر در زمین تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 580.69,
   "end": 584.31,
   "text": "طوعا به مدت طولانی و تمتعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 584.31,
   "end": 589.43,
   "text": "ببینید مستقر و ملکم في الارض مستقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 589.43,
   "end": 591.69,
   "text": "و متاع تمتع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 591.69,
   "end": 594.99,
   "text": "الهی و تمتعه فيها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 594.99,
   "end": 598.55,
   "text": "طویلا. امام عصر هم اینجا متمتع بشه طولانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 598.55,
   "end": 601.61,
   "text": "البته اون طو یعنی با خا-- با طیب خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 601.61,
   "end": 605.87,
   "text": "نه با اکراه. پس نکته اول اینکه ما باید میومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 605.87,
   "end": 608.43,
   "text": "نکته دوم که فردا بهش منتقل می‌شیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 608.43,
   "end": 614.55,
   "text": "حالا که اومدیم این همه سختی‌ها چون بحث ما بحث قلب نفاق بود، چه ربطی به بحث داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 614.55,
   "end": 619.59,
   "text": "این همه نفاق، این همه کفر، این همه دشمنی تو این زمین، تو این ارز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 619.59,
   "end": 623.69,
   "text": "این چی میشه؟ جواب این خونریزی‌ها و فسادها رو کی چی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.69,
   "end": 626.45,
   "text": "چی میگه؟ بالاخره از کجا در میاریم اینو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 626.45,
   "end": 629.43,
   "text": "آیاتی آماده کردم که بگم خلاصش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 629.43,
   "end": 636.25,
   "text": "که همه آنچه که نفاق، کفر، شرک توی این زمین س-- رخ میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 636.25,
   "end": 639.99,
   "text": "کار رو سخت‌تر می‌کنه. اما افضل الاعمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 639.99,
   "end": 643.77,
   "text": "احمزها. گرامی‌ترین کارها سخت‌ترین اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 643.77,
   "end": 646.15,
   "text": "ما برای اینکه به کمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 646.15,
   "end": 649.33,
   "text": "مطلق برسیم نیاز به این سختی‌ها داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 649.33,
   "end": 653.69,
   "text": "در حقیقت نفاق منافقین به ضرر خودشون تموم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 653.69,
   "end": 656.07,
   "text": "nema ما رو به رشد می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 656.07,
   "end": 658.79,
   "text": "این بحث فرداست. انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 658.79,
   "end": 661.71,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 661.71,
   "end": 667.21,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
