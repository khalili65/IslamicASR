 },
 "chapters": [
  {
   "index": 0,
   "title": "## طهارت قلم‌مو؛ اصل طهارت در بازار مسلمانان",
   "start": 12.7,
   "end": 95.38
  },
  {
   "index": 1,
   "title": "## التفات به غیر در نماز؛ خضوع جسد بیش از قلب",
   "start": 95.38,
   "end": 199.6
  },
  {
   "index": 2,
   "title": "## همّ شکم با آنکه روزه نبوده",
   "start": 199.6,
   "end": 305.58
  },
  {
   "index": 3,
   "title": "## حدیث ثوبان؛ یک روز روزۀ رجب و عذاب قبر",
   "start": 305.58,
   "end": 507.05
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 3.98,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.98,
   "end": 7.8,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.8,
   "end": 12.7,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.7,
   "end": 20.52,
   "text": "این قلموهایی که مو بهش وصل هست و من می‌خواد نقاشی بکشه یا به هر حال نوشته‌ای رو باهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.52,
   "end": 24.66,
   "text": "قلم بزنه، این موهایی که در این قلم‌ها هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.66,
   "end": 27.24,
   "text": "این‌ها باید از جنس پاک باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.24,
   "end": 36.36,
   "text": "یعنی اگر این مویی که در این قلمو استفاده شده مثلا موی سگ باشه، موی خوک باشه، موی مرده‌ار باشه، اینا همه نجسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.36,
   "end": 41.96,
   "text": "و نمیشه به اون مخصوصا کلمات نورانی قرآن و ادعیه رو نوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.96,
   "end": 45.38,
   "text": "حرامه اصلا. با یه همچین قلمویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.38,
   "end": 49.48,
   "text": "مثلا بخوای یه آیه‌ای از قرآن یا حدیثی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.48,
   "end": 52.9,
   "text": "اون قلم باید پاک باشه، از جنس پاک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.9,
   "end": 56.5,
   "text": "یا حتی بخوای نقاشی کنی بالاخره می‌زنی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.5,
   "end": 60.3,
   "text": "اون آب که خیسش کنی، اون آب می‌ریزه رو فرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.3,
   "end": 63.72,
   "text": "خب این فرش نجس میشه. لازمه که این پاک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.72,
   "end": 69.6,
   "text": "اما سؤال اینجاست که آیا نیاز واجبه که انسان حالا رفته از بازار خریده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.6,
   "end": 73.96,
   "text": "واجبه که بره تفحص کنه بررسی کنه این موها از کجا هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.96,
   "end": 81.92,
   "text": "از چه جنسیه و این‌ها؟ همه مراجع بر اساس اصل طهارت فرمودن نخیر بنا رو بذارید بر طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.92,
   "end": 87.7,
   "text": "چون بالاخره تو بازار مسلمون‌ها این خریداری شده، تو بازار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.7,
   "end": 90.5,
   "text": "دولت اسلامی هست بنا رو بذارید بر طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.5,
   "end": 95.38,
   "text": "شما یقین ندارید نیازی هم به تفحص بر این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.38,
   "end": 98.0,
   "text": "یکی دیگه از نشانه‌هایی که ما بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.0,
   "end": 101.64,
   "text": "قلبی که دچار مریضی نفاق شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.64,
   "end": 103.68,
   "text": "عرض کردیم بر اساس حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.68,
   "end": 106.06,
   "text": "امام سجاد سلام الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.06,
   "end": 109.0,
   "text": "این بود که می‌فرمود وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.0,
   "end": 113.24,
   "text": "به نماز می‌ایستد، التفات و توجهش به غیر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.24,
   "end": 115.64,
   "text": "وقتی نماز می‌خونه توجهش به کس دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.64,
   "end": 118.74,
   "text": "این قلب منحرف شده، منصرف شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.74,
   "end": 121.7,
   "text": "انصراف داده از توجه به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.7,
   "end": 126.32,
   "text": "لذا دچار نفاقه باید درمان بشه که درمانش هم اون روز اول بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.32,
   "end": 131.66,
   "text": "قلب منافق ما زرنگی کردیم همون اول عرض کردیم درمان نفاق چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.66,
   "end": 137.58,
   "text": "حالا ما داریم اوا-- علام- علائمش رو می‌شماریم بر اساس روایت و آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.58,
   "end": 143.44,
   "text": "یه حدیث از رسول خدا پیرامون این هست که می‌فرماید \"مازاد خشوع الجسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.44,
   "end": 145.6,
   "text": "على ما في القلب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.6,
   "end": 153.0,
   "text": "هر مقدار اضافه بر اون حالتی که در قلب هست در جسد خودش رو نشون بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.0,
   "end": 155.76,
   "text": "\"فهو عندنا نفاق\" این پیش ما نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.76,
   "end": 161.34,
   "text": "یعنی کسی می‌خواد مخصوصا این رمز می‌فرماید \"عندنا نفاق\" پیش ما این نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.34,
   "end": 164.58,
   "text": "یعنی اگر کسی می‌خواد عندنا بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.58,
   "end": 168.9,
   "text": "به مقام هندیّت برسه، معنى بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.9,
   "end": 171.36,
   "text": "اصلاً از ما بشه، منا بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.36,
   "end": 176.28,
   "text": "همراه ما باشه این چاره‌ای نداره جز اینکه حواسش به این ریزه‌کاری‌ها باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.28,
   "end": 179.02,
   "text": "پیش ما همچین چیزی نفاقه که کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.02,
   "end": 185.74,
   "text": "در نماز مقداری خشوع بده به جسدش خضوع بده که مغایره با حضور قلبشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.74,
   "end": 188.04,
   "text": "یعنی بیشتر از حضور قلبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.04,
   "end": 190.24,
   "text": "خو- خضوع به جسدش بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.24,
   "end": 193.2,
   "text": "که اینو ما توضیح دادیم. فقط این حدیث چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.2,
   "end": 199.6,
   "text": "حدیث خوبی بود و توجه می‌داد ما رو به اون مبحث قبلی ازش رد می‌شیم و عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.6,
   "end": 205.38,
   "text": "نشانه بعدی که نشانه خیلی عجیبیه و امروز خیلیا گرفتارشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.38,
   "end": 209.48,
   "text": "می‌فرمايد تو همین حدیث‌ها حضرت سجاد سلام الله عليه می‌فرمايد با،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.48,
   "end": 213.72,
   "text": "می‌فرمايد که شام می‌کند، شب می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.72,
   "end": 216.56,
   "text": "و همش خوراک است، خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.56,
   "end": 220.38,
   "text": "آقا شامو بردار بیار که شکممون ضعف رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.38,
   "end": 223.76,
   "text": "هاج خانم چی درست کردی؟ زود پاشو بیار خیلی گرسنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.76,
   "end": 226.44,
   "text": "حالا یه شب آدم اینطوریه، دو شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.44,
   "end": 229.5,
   "text": "هم-- اصلاً همش اینه. توجه داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.5,
   "end": 231.9,
   "text": "روایت میگه همش خوراکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.9,
   "end": 235.96,
   "text": "اصلاً همش ولا-- حرص می‌زنه که برسه خونه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.96,
   "end": 238.62,
   "text": "غذای حضرت حوا منزل رو نوش جان کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.62,
   "end": 241.48,
   "text": "و سر اینجاست فرمود با اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.48,
   "end": 246.26,
   "text": "روزه نبوده، روزه نبوده بازم اینقدر حرص می‌زنه برای خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.26,
   "end": 249.24,
   "text": "این نشون میده اصلاً همش شده شکمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.24,
   "end": 253.46,
   "text": "یکی از نشانه‌های نفاق اینه که آدم هم و غمش بشه شکمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.46,
   "end": 256.1,
   "text": "مثل خیلی از ماها که الان واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.1,
   "end": 259.74,
   "text": "هم و غممون شده شکم خودم و زن و بچه‌م",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.74,
   "end": 262.8,
   "text": "و البته تو این فشارهای اقتصادی چیکار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.8,
   "end": 266.92,
   "text": "گریزی از این نیست. اما نه اینکه آدم فقط هم و غمش این بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.92,
   "end": 272.4,
   "text": "این خطره، این نفاقه که توجه به مسائل دینی و معرفتیش نداشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.4,
   "end": 277.24,
   "text": "فقط شکم. حالا یه وقت هست کسی خب روزه بوده خب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.24,
   "end": 281.94,
   "text": "ببینید چقدر رحمت دارن این‌ها چقدر مهربونن کارو سخت نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.94,
   "end": 284.12,
   "text": "نگفتن حتی اگر روزه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.12,
   "end": 287.56,
   "text": "خب بالاخره وقتی روزه است طرف گرسنه است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.56,
   "end": 293.36,
   "text": "اصلاً یکی از را-- لحظات شادی یا ساعت بهشتیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.36,
   "end": 295.4,
   "text": "مؤمن وقتیه که می‌خواد افطار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.4,
   "end": 298.14,
   "text": "اما اون همش خوردن نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.14,
   "end": 302.62,
   "text": "شکم نیست. اون همش اتصال امر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.62,
   "end": 304.84,
   "text": "حالا می‌خواد اف- افطار کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.84,
   "end": 309.44,
   "text": "که البته چه خوب وقتی هم رسیدیم به این حدیث، به این قطعه از حدیث که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.44,
   "end": 311.86,
   "text": "بالاخره شروع ماه رجب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.86,
   "end": 314.28,
   "text": "این شروع رو تبرکاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.28,
   "end": 318.78,
   "text": "یه حدیثی هم عرض کنیم که مرتبط، چه جالب امروز این حدیث رو می‌دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.78,
   "end": 323.72,
   "text": "که نقل شده از کتاب بهار، جلد چهل و نه، صفحه سی و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.72,
   "end": 325.94,
   "text": "چهل و نه، سی و نه. راحت حس می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.94,
   "end": 329.26,
   "text": "صفحه چهل و-- ج- جلد چهل و نه، صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.26,
   "end": 332.16,
   "text": "سی و نه. یه شخصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.16,
   "end": 334.76,
   "text": "اونجا حالا اینو چجوری حس کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.76,
   "end": 337.64,
   "text": "اتوبان رو الف و لامشو وردار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.64,
   "end": 341.64,
   "text": "توبان می‌مونه. توبان خ-- غلام پیغمبر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.64,
   "end": 344.1,
   "text": "یکی از غلامای پیغمبر به نام توبان بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 344.1,
   "end": 350.28,
   "text": "میگه من با پیغمبر همراه شدم با یه عده‌ای می‌رفتیم تا رسیدیم به یه قبرستونی پیغمبر توقف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.28,
   "end": 352.82,
   "text": "یه لحظاتی بین قبرها ایستاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 352.82,
   "end": 355.08,
   "text": "تأمل کرد و بعد رد شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 355.08,
   "end": 359.4,
   "text": "ازش سؤال کردم. چه زرنگ بودن اینا دیگه می‌دونستن پیغمبر بی‌خودی توجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 359.4,
   "end": 361.72,
   "text": "توجه نمی‌کنه، توقف نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 361.72,
   "end": 364.42,
   "text": "یا رسول الله اون تأملتون چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.42,
   "end": 370.29,
   "text": "حضرت به گریه افتاد. میگه انقدر شدت گریه‌ش که همه ما به گریه افتادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 370.29,
   "end": 374.37,
   "text": "چقدر قشنگ میشه آدم با گریه‌ی آقاش گریه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.37,
   "end": 377.13,
   "text": "چی شده یا رسول الله؟ گریه‌ی حضرت شدید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.13,
   "end": 380.69,
   "text": "فرمود که من دیدم این بیچاره‌ها گرفتار عذابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.69,
   "end": 382.25,
   "text": "عذاب بدجوری این‌ها رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 382.25,
   "end": 385.71,
   "text": "من اندوه و ناله و آهشون رو شنیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 385.71,
   "end": 387.63,
   "text": "و از خدا درخواست تخفیف کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 387.63,
   "end": 389.73,
   "text": "من دلم به رحم اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 389.73,
   "end": 393.01,
   "text": "قربون این رحمت الله العالمین برم و خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 393.01,
   "end": 397.05,
   "text": "شفاعت منو در حقشون پذیرفت، عذابشون رو تخفیف داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.05,
   "end": 401.41,
   "text": "بعد این جمله رو فرمود. فرمود توبان اگر این‌ها یک روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 401.41,
   "end": 406.35,
   "text": "فقط یک روز از ماه رجب رو تو کل عمرشون یک روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 406.35,
   "end": 410.21,
   "text": "روزه گرفته بودن دچار این عذاب قبر نمی‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 410.21,
   "end": 413.49,
   "text": "الله اکبر. این چه ماهیه، چه عظمتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 413.49,
   "end": 417.47,
   "text": "حالا خدا لطف کرده عمر ما قطع بده برسیم به این ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 417.47,
   "end": 421.41,
   "text": "یه روزش رو حالا ما که نمیگیم حالا سی روز رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 421.41,
   "end": 424.65,
   "text": "البته کمالین اولیاء خدا هر سی روز رو می‌گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 424.65,
   "end": 429.51,
   "text": "حالا یه روزشو. بعد جالبه پیغمبر این چنین ادامه دادند که بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 429.51,
   "end": 431.45,
   "text": "توبان میگه من تعجب کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.45,
   "end": 435.49,
   "text": "عرض کردم که به راستی انقدر روزه و عبادت ماه رجب ارزش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 435.49,
   "end": 441.33,
   "text": "رسول خدا فرمود اگر کسی قسم به اون خدا قسم خورده معلومه که خیلی حرف جدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 441.33,
   "end": 444.21,
   "text": "قسم به اون خدایی که منو به حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 444.21,
   "end": 446.35,
   "text": "به رسالت مبعوث کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.35,
   "end": 454.47,
   "text": "اگر کسی یه روز از ما این ماه رجب رو روزه بگیره یا یک شبش رو تا صبح به عبادت ب- بلند شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.47,
   "end": 457.25,
   "text": "در حالی که این قیدش خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 457.25,
   "end": 459.73,
   "text": "در حالی که ر-- همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 459.73,
   "end": 462.61,
   "text": "اون قصدش جز رضای خدا نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 462.61,
   "end": 466.05,
   "text": "همین. جز رضای خدا نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 466.05,
   "end": 473.49,
   "text": "پیغمبر فرمود خدا در نامه‌ی عملش ثواب هزار روز عبادت رو می‌نویسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 473.49,
   "end": 479.43,
   "text": "در حالی که هزار شبانه‌روز در حالی که روزها روزه بوده و شب‌ها تا صبح شب‌زنده‌داری کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 479.43,
   "end": 482.49,
   "text": "الله اکبر از این عظمت و از این رأفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 482.49,
   "end": 484.65,
   "text": "پس از این فرصت استفاده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 484.65,
   "end": 487.69,
   "text": "اونجایی که خط نفاقه میگه شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 487.69,
   "end": 489.93,
   "text": "میگه که روزه نبوده روز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.93,
   "end": 491.93,
   "text": "شب هرس خوردن می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 491.93,
   "end": 493.95,
   "text": "اما اگر کسی روزه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 493.95,
   "end": 495.57,
   "text": "حالا این ازش برداشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 495.57,
   "end": 499.87,
   "text": "انشاالله عاقبت بخیر بشیم به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 499.87,
   "end": 502.25,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 502.25,
   "end": 507.05,
   "text": "صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}