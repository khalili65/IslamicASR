 },
 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 11.16,
   "end": 199.44
  },
  {
   "index": 1,
   "title": "## قلبِ منافق؛ فحش و زبان‌درازی",
   "start": 199.44,
   "end": 453.7
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 2.64,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.64,
   "end": 6.16,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.16,
   "end": 10.18,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.18,
   "end": 16.96,
   "text": "امروز من متوجه شدم که نظر رهبری در خصوص یکی از احکامشون گذ-- رفت یعنی بر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.96,
   "end": 20.6,
   "text": "یه چیز جدیدی شده. اینو شما باید بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.6,
   "end": 25.22,
   "text": "در خصوص ما گفتیم می‌خوایم بریم تو بحث احکام سفر، اگه یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.22,
   "end": 30.64,
   "text": "خب اولین چیزی که در خصوص احکام سفر حائز اهمیته، مسافت شرعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.64,
   "end": 33.52,
   "text": "که کسی بدونه اصلا مسافت شرعی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.52,
   "end": 40.28,
   "text": "یعنی مقداری که اگر تو به اون میزان رفتی از وطنت سفر کردی و رفتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.28,
   "end": 43.6,
   "text": "تو مسافر حساب میشی. نمازت شکسته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.6,
   "end": 47.48,
   "text": "و روزه هم نمی‌تونی بگیری. حالا این مسافت رو همه مراجع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.48,
   "end": 51.98,
   "text": "اصلا حکمی داریم کلیه که هشت فرسخ رفت و برگشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.98,
   "end": 54.32,
   "text": "یا رفت. یعنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.32,
   "end": 60.52,
   "text": "یعنی بری کلاً بری رفتت کلاً بشه هشت اگه نمی‌خوای برگردی اون مسیر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.52,
   "end": 63.74,
   "text": "بری که بری یه جای دیگه. هشت فرسخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.74,
   "end": 67.7,
   "text": "رفت باشه یا رفت و برگشت هشت فرسخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.7,
   "end": 72.68,
   "text": "که فرمودن حداقل برگشتش یا رفتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.68,
   "end": 81.38,
   "text": "چهار فرسخ باشه. حالا این که چهار فرسخ از نظر مراجع چند کیلومتره اختلافه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.38,
   "end": 86.2,
   "text": "رهبری قبلاً و اکثر مراجع فرموده بودند بیست و دو کیلومتر و نیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.2,
   "end": 88.94,
   "text": "یعنی بیست و دو کیلومتر و نیم رفتت باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.94,
   "end": 92.02,
   "text": "بیست و دو کیلومتر و نیم برگشتت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.02,
   "end": 100.1,
   "text": "امروز من متوجه شدم با دفتر آقا که صحبت می‌کردم که عجب چند روزه ایشون فرمودن یک هفته‌ست حدوداً، هفته اخیر گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.1,
   "end": 102.54,
   "text": "آقا نظرشون برگشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.54,
   "end": 105.4,
   "text": "فرمودن بیست کیلومتر و نیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.4,
   "end": 109.04,
   "text": "چهار فرسخ رو بیست کیلومتر و نیم می‌دونن رهبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.04,
   "end": 111.8,
   "text": "عزیزانی که مرجع‌شون آقاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.8,
   "end": 116.72,
   "text": "حواسشون باشه از این به بعد حساب کتابشون تو سفر بیست کیلومتر و نیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.72,
   "end": 120.72,
   "text": "فرض کنن. حالا الان بعضیا میخوان برن مناطق سیل‌زده اینور اونور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.72,
   "end": 123.46,
   "text": "یا حاشیه تهران اینا حواسشون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.46,
   "end": 129.88,
   "text": "و حالا بعد سؤال پیش میاد خب نماز روزه‌هایی که براساس اون قاعده قبلی خوندن چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.88,
   "end": 133.42,
   "text": "نمی‌دونستن. یا حتی همین الان همه که این حکمو نمی‌دونن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.42,
   "end": 135.06,
   "text": "براساس اون دارن عمل می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.06,
   "end": 138.02,
   "text": "یه روزی یهو متوجه می‌شن نه حکم عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.02,
   "end": 140.14,
   "text": "البته تو سایت آقا اومده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.14,
   "end": 148.08,
   "text": "اما ب-- فرمودن که همه نماز روزایی که تا اون روزی که اون لحظه که متوجه حکم جدید می‌شن همش درسته غصه نخورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.08,
   "end": 150.18,
   "text": "پس اینو بگید به عزیزان دور و برتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.18,
   "end": 154.04,
   "text": "به هر حال مراجع یکی از پویایی فقه همینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.04,
   "end": 157.56,
   "text": "استنباط جدید می‌کنن. خدا رحمت کنه استه امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.56,
   "end": 161.38,
   "text": "لب از دنیا رفتنشون که داشتن از این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.38,
   "end": 165.98,
   "text": "رحلت می‌کردن، می‌رفتن تو اون لحظات که رفتن از، می‌دونید از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.98,
   "end": 169.26,
   "text": "نشانه‌های اولیای خدا رجعت اون لحظه مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.26,
   "end": 171.22,
   "text": "بحث مبثوتی داره که دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.22,
   "end": 173.58,
   "text": "ایشون رفتن تمام قلب از کار افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.58,
   "end": 177.7,
   "text": "اینا دو مرتبه برگشتن. معمولاً اولیای خدا این رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.7,
   "end": 183.9,
   "text": "حضرت زهرا سلام الله علیها در احوالاتشون این ثبت شده تو تاریخ که رفتن دوباره برگشتن این‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.9,
   "end": 188.02,
   "text": "امام تو اون حالت برگشت یه حکمشو عوض کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.02,
   "end": 192.94,
   "text": "گفت به مردم بگید این حالا یه حکمی داشت در مورد وضو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.94,
   "end": 195.8,
   "text": "خب این رو نگران نباشید. استنباط مرجعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.8,
   "end": 198.54,
   "text": "اینم پویایی فقه ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.54,
   "end": 202.8,
   "text": "خب ما چون صبح‌ها الحمد لله به اندازه کافی جشن دارید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.8,
   "end": 204.44,
   "text": "هر روز صبح دارید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.44,
   "end": 209.12,
   "text": "من امروز بحث همیشگیمون رو تو سه چهار دقیقه سریع عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.12,
   "end": 212.14,
   "text": "چون زیاد احکام طول کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.14,
   "end": 215.22,
   "text": "ما داشتیم حالت قلب نف-- منافق رو بحث می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.22,
   "end": 217.0,
   "text": "قلبی که دچار نفاق شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.0,
   "end": 221.24,
   "text": "یکی از نشانه‌های قلبی که دچار نفاق شده رو ببینید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.24,
   "end": 225.48,
   "text": "بترسم خودم. فکر نکنم منافق یعنی اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.48,
   "end": 228.68,
   "text": "میاد تیشه به ریشه اسلام می‌خواد بزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.68,
   "end": 232.98,
   "text": "بعد تو لباس خدمت می-- نه خیلی از موقع-- از همین جاها شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.98,
   "end": 235.42,
   "text": "از همین رعایت نکردن ریزه‌جزییات کاریا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.42,
   "end": 237.56,
   "text": "چی؟ حدیثو دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.56,
   "end": 240.24,
   "text": "سندم محکم. خدا رحمت کنه مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.24,
   "end": 246.36,
   "text": "کلینی اعلا الله مقامه الشریف در کتاب شریف کافی‌ش جلد دو صفحه سیصد و بیست و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 246.36,
   "end": 251.2,
   "text": "امام صادق صلوات الله علیه فرمودن \"إن الفحش والبغاء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 251.2,
   "end": 253.68,
   "text": "با زاد دال. \"والبغاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.68,
   "end": 257.56,
   "text": "والسلاطة من النفاق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.56,
   "end": 259.9,
   "text": "فحش و ناسزا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 259.9,
   "end": 263.4,
   "text": "زبون درازی، سلاطه یعنی زبون درازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.4,
   "end": 267.6,
   "text": "این از نفاق قلبه. یعنی به طور کلی بی‌ادبی زبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 267.6,
   "end": 270.3,
   "text": "کسی زبونش ترمز نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.3,
   "end": 272.98,
   "text": "مخصوصاً وقتی عصبانی می‌شه می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 272.98,
   "end": 276.08,
   "text": "این از نفاق قلبه. من یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.08,
   "end": 279.88,
   "text": "تحلیل یه دقیقه‌ای به شما ارائه بدم همتون اینو می‌پذیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.88,
   "end": 283.66,
   "text": "شما چند تایید؟ چند نفرید شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 283.66,
   "end": 286.22,
   "text": "خود شخص شما چند نفره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.22,
   "end": 289.32,
   "text": "اگه بگی یه نفره یا خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 289.32,
   "end": 293.72,
   "text": "وقتی گوشت می‌شنوه همون لحظه چشت هم داره می‌بینه همون لحظه شاید داری حرف هم می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 293.72,
   "end": 299.3,
   "text": "اینا انواع مختلفن که آدمای مختلفن که یکی داره حرف می‌زنه، یکی داره می‌شنوه، یکی داره می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.3,
   "end": 303.18,
   "text": "نخیر، میگی استناد میدی همه رو به یک حقیقت واحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 303.18,
   "end": 305.56,
   "text": "من می‌بینم، من می‌شنوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 305.56,
   "end": 308.76,
   "text": "من حرف می‌زنم. این من توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.76,
   "end": 310.98,
   "text": "یک شخص واحد انواع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 310.98,
   "end": 313.62,
   "text": "و ظهور و بروز متعدد داره، خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 313.62,
   "end": 315.7,
   "text": "اون لحظه‌ای که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 315.7,
   "end": 319.2,
   "text": "به طورهای مختلف جلوه می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 319.2,
   "end": 324.38,
   "text": "خود شخص و جان انسانه که داره جلوه می‌کنه به طورهای مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 324.38,
   "end": 328.8,
   "text": "یعنی چی؟ یعنی تویی که داری حرف می‌زنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 328.8,
   "end": 331.16,
   "text": "خود شخص تو، یعنی نفس تو، یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 331.16,
   "end": 334.28,
   "text": "جان من داره حرف می‌زنه الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 334.28,
   "end": 336.12,
   "text": "می‌گن که تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 336.12,
   "end": 339.96,
   "text": "مرد سخن نگفته باشد عیب و هنرش نهفته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 339.96,
   "end": 343.48,
   "text": "یعنی این. یعنی چی؟ داریم به مطلب نزدیک می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 343.48,
   "end": 350.16,
   "text": "یعنی تو منت، اون شخصیت درونی‌ت، سجیت، صیرتت، جان وجودت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 350.16,
   "end": 355.82,
   "text": "اون اصلاً خود تو، خود شخص تو که تو همون، همون حقیقت می‌مونه برای قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 355.82,
   "end": 358.52,
   "text": "اون همینه که الان داره حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 358.52,
   "end": 363.28,
   "text": "اگه حرف زشت می‌زنه خباثت خودشو داره نشون می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 363.28,
   "end": 366.44,
   "text": "انحراف قلب، انحراف وج-- اصلاً منحرف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 366.44,
   "end": 372.48,
   "text": "لذا می‌گن چنین کسی نجس و د-- از درون نجاست داره، خبث باطن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 372.48,
   "end": 374.86,
   "text": "نجس شده درو-- یعنی نفسش نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 374.86,
   "end": 379.56,
   "text": "نه این کلام. نفس نجس شده که کلام نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 379.56,
   "end": 382.4,
   "text": "نفس خبیث شده که کلام خبیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 382.4,
   "end": 385.44,
   "text": "نفس منحرف شده که کلام منحرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 385.44,
   "end": 392.28,
   "text": "نفس متأسفانه از طهارت خارج شده و قذارات بیچاره‌اش کرده و آلودگی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 392.28,
   "end": 397.14,
   "text": "که می‌تونه راحت دروغ بگه، راحت غیبت کنه، راحت فحش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.14,
   "end": 399.56,
   "text": "حالا من خیلی نمی‌رم تو احادیث تکان‌دهنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 399.56,
   "end": 401.98,
   "text": "دیگه که بترسیم بعضیاون که حتی تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 401.98,
   "end": 410.54,
   "text": "جایی بردن که علمت فرمودن اگه کسی فحاشه یعنی دیگه خیلی بر وزن فعال، یعنی خیلی فحش میده، اصلاً تو نطفه‌ش شک کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 410.54,
   "end": 413.62,
   "text": "خلاصه اون سمت نمی‌رم. خیلی باید مراقب باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 413.62,
   "end": 416.08,
   "text": "این زبان نشانگر باطن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 416.08,
   "end": 419.64,
   "text": "اگه کسی لسانش، صداش، صوتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 419.64,
   "end": 421.96,
   "text": "این به دل می‌شینه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 421.96,
   "end": 424.84,
   "text": "جانش دلنشینه. یعنی طهارت باطن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 424.84,
   "end": 428.68,
   "text": "برعکس. یکی دید دو کلم باهات حرف می‌زنه می‌خوای فرار کنی ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 428.68,
   "end": 432.62,
   "text": "به دلت نمی‌شینه. این خبث باطن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 432.62,
   "end": 437.94,
   "text": "چرا امام یه جمله می‌گفت همه می‌پذیرفتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 437.94,
   "end": 443.44,
   "text": "این طهارت باطنه. انشاالله عیدی ما از امام حسین امروز همین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 443.44,
   "end": 445.34,
   "text": "چیز کمی نیست. طهارت باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 445.34,
   "end": 448.02,
   "text": "لا یمسه إلا المتطهرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 448.02,
   "end": 453.7,
   "text": "انشاالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد. الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}