 },
 "chapters": [
  {
   "index": 0,
   "title": "## طهارت لوازم هتل در بلاد کفر",
   "start": 0.44,
   "end": 57.18
  },
  {
   "index": 1,
   "title": "## داستان دو درهم و برکت از‌دست‌رفته",
   "start": 57.18,
   "end": 248.66
  },
  {
   "index": 2,
   "title": "## جمع حکم سفر و درس نفاق",
   "start": 248.66,
   "end": 570.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 2.98,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.98,
   "end": 6.8,
   "text": "السلام علیک یا داغی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.8,
   "end": 11.52,
   "text": "آیات. ایام سفره بعضیا خب سفر میرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.52,
   "end": 14.36,
   "text": "یا سفرهای خارج از کشور میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.36,
   "end": 16.58,
   "text": "این هتل‌هایی که بعضا میرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.58,
   "end": 21.78,
   "text": "مستقر میشن با این هتل‌ها رو کفار ساختن یا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.78,
   "end": 26.28,
   "text": "ممالک کفر هستش بالاخره اون اموال و اثاثیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.28,
   "end": 29.46,
   "text": "در و دیوار و صندلی‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.46,
   "end": 35.26,
   "text": "اون البسه و حتی بعضا پوشاک که داخل اون‌ها هست رو خب کفار این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.26,
   "end": 37.72,
   "text": "تامین کردن، تعبیه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.72,
   "end": 43.24,
   "text": "چه کنیم؟ اینا بالاخره پاکن، نجسن، تصرف درشون اشکال داره، نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.24,
   "end": 47.7,
   "text": "فرمودن همین که حتی اگر کفار این کارو انجام دادن همین که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.7,
   "end": 52.1,
   "text": "یقین نداری به نجاست اون‌ها محکوم به طهارتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.1,
   "end": 56.36,
   "text": "و حتی اگر یقین پیدا کردی که بعضی از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.36,
   "end": 59.02,
   "text": "لوازم و اثاثیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.02,
   "end": 62.08,
   "text": "در و دیوار این هتل مثلا یا هرچیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.08,
   "end": 65.28,
   "text": "نجسه واجب نیست تطهیرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.28,
   "end": 67.46,
   "text": "نیازی نیست تطهیرش اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.46,
   "end": 71.64,
   "text": "مگر در خصوص آره رفتن آنتالیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.64,
   "end": 76.36,
   "text": "مگر در خصوص خوردن و خوابیدن و ببخشید خوردن و آشامیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.36,
   "end": 84.2,
   "text": "و نماز خوندن. اون چیزایی که در خصوص خوردن و آشامیدن و نماز خوندن استفاده میشه چرا اونا باید تطهیر شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.2,
   "end": 87.48,
   "text": "تو اون البسه، لوازمات، اون چیزایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.48,
   "end": 89.58,
   "text": "توی اون هتل یا هرجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.58,
   "end": 91.84,
   "text": "انشاالله برید و ما هم دعا کنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.84,
   "end": 98.48,
   "text": "اما در خصوص قلب منافق هم حدیثی بخونم که این حدیث از احادیث زیربنایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.48,
   "end": 102.5,
   "text": "نشانه ها یا حتی میشه گفت دلایل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.5,
   "end": 105.68,
   "text": "رسیدن خدایی نکرده به نفاق قلبی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.68,
   "end": 108.84,
   "text": "پیامبر عظیم الشأن اسلام فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.84,
   "end": 112.76,
   "text": "داره منشاء نفاق رو میگه پیغمبر از کجا نشأت میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.76,
   "end": 115.88,
   "text": "حب المال والشرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.88,
   "end": 119.32,
   "text": "یمبت النفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 119.32,
   "end": 123.36,
   "text": "في القلب كما یمبت الماء البغل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.36,
   "end": 126.5,
   "text": "الله اکبر. خیلی حدیث عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.5,
   "end": 131.08,
   "text": "میفرماiet چطور یه گیاه با آب رشد میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.08,
   "end": 135.36,
   "text": "میرویه، همونطور قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.36,
   "end": 137.84,
   "text": "با حب دو چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 137.84,
   "end": 139.42,
   "text": "نفاق درش رشد میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 139.42,
   "end": 141.82,
   "text": "یکی حب مال، یکی هم حب شرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 141.82,
   "end": 143.7,
   "text": "یعنی دوست داشتن خودبرتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 143.7,
   "end": 149.42,
   "text": "اینکه آدم مطرح باشه، برتر از دیگران باشه، همش سر باشه، اسمش مطرح باشه، مشروعیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 149.42,
   "end": 153.1,
   "text": "اینکه امیرالمؤمنین فرمود مشهوریت و معروفیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 153.1,
   "end": 155.64,
   "text": "حتی خیرش هم شره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 155.64,
   "end": 158.54,
   "text": "حتی آدم یعنی حتی به اینکه خودش بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 158.54,
   "end": 161.44,
   "text": "یه وقت از خدا انسان رو معروف میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 161.44,
   "end": 167.2,
   "text": "خدا میخواد یکی مثل حضرت امام گنده بشه، مطرح بشه تو کل دنیا اون قصه‌ش فرق میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.2,
   "end": 170.02,
   "text": "اما یکی از خود طرف میره به سمتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 170.02,
   "end": 173.5,
   "text": "میره بذری پاشه که یه روزی این معروف شه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 173.5,
   "end": 176.22,
   "text": "این، نه این میگن در آتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 176.22,
   "end": 181.98,
   "text": "امام سجاد سلام الله علیه فرمود حب به معروفیت، حب به مشهوریت، اصلا دوست داشتنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 181.98,
   "end": 185.94,
   "text": "در آتشه. عرض کردم این خلط بحث نشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 185.94,
   "end": 188.98,
   "text": "خودش میره اقدام میکنه. نه اینکه بسپره به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 188.98,
   "end": 192.22,
   "text": "معمولا اولیا خدا از معروفیت فرار میکنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 192.22,
   "end": 199.88,
   "text": "پشت صحنه کار میکنن، مگر خدا معروفشون کرد که قبلا هم بارها عرض کردیم در حکمت عباداتش من حضرت علامه هست--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 199.88,
   "end": 206.88,
   "text": "حضرت علامه جوادی آملی میفرماید اصلا بعضیا رو خدا میخواد اینا رو یه زمانی مشهورشون کنه، میخواد معروفشون بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 206.88,
   "end": 209.26,
   "text": "خیر در اینه ولی خودش میزنه خراب میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 209.26,
   "end": 213.32,
   "text": "چی رو؟ زودتر از موعد خودش خودشو معروف میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.32,
   "end": 218.58,
   "text": "که الانم یکی از راه‌هایی که خیلی راحت و سریع خودشو طرف معروف کنه همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 218.58,
   "end": 223.96,
   "text": "بنرهای هیئت‌هاست. طرف اسمشو چند برابر اسم اهلب دوش بزرگ زده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.96,
   "end": 228.16,
   "text": "کربلایی فلانی. بابا حضرت زینب کربلایی بود، حضرت ابوالفضل کربلایی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 228.16,
   "end": 232.22,
   "text": "تو که چیکاره‌ای به خودت لقب کربلایی هم میزنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 232.22,
   "end": 236.52,
   "text": "آدم تنش میلرزه. یا حتی این شعار عجیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.52,
   "end": 239.86,
   "text": "هم به خود لیدرهای اصلی خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 239.86,
   "end": 243.66,
   "text": "سپاه قدس و این گنده هاشون این اعتراض رو همون اوایل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.66,
   "end": 248.42,
   "text": "گفتن دیگه نمیشه جمعش کرد. کلنا عباس و کی یا زینب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.42,
   "end": 253.96,
   "text": "اگر کسی حضرت ابوالفضل سلام الله علیه رو شناخته باشه جرات نمیکنه حتی همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.96,
   "end": 258.04,
   "text": "ما رو هم رو جمع کنیم انگشت کوچیکه ابوالفضل هم نمیشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.04,
   "end": 262.68,
   "text": "هممون رو هم. بعد بگیم ما عباس تو هستیم یا زینب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.68,
   "end": 267.54,
   "text": "استغفرالله. اینجا اصلا یکی از گناهان فاحش ما اینجور ادعاهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.54,
   "end": 269.58,
   "text": "ما حالا اون به اون سمت نریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.58,
   "end": 272.08,
   "text": "پس ببینید یه نکته ای رو دقت داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.08,
   "end": 275.28,
   "text": "اونم میگه حب. حواستون باشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 275.28,
   "end": 278.22,
   "text": "حواستون باشه. حواس خود منم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 278.22,
   "end": 280.52,
   "text": "نمیگه مال داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 280.52,
   "end": 284.18,
   "text": "نمیگه اینکه انسان مطرح و معروف شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.18,
   "end": 289.16,
   "text": "یا برتری داشت نسبت به دیگران از هر جهت، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 289.16,
   "end": 292.92,
   "text": "شروع نفاقه ها. ببین اول کلام با حب شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 292.92,
   "end": 295.04,
   "text": "حب المال والشرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 295.04,
   "end": 296.82,
   "text": "و الا داشتن مال بد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 296.82,
   "end": 302.24,
   "text": "اینکه آن انسان فی ذاته حالا معروف بشه خب علم داره معروف شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 302.24,
   "end": 307.36,
   "text": "هنر داره معروف شد. یا مدیر مثلا رییس جمهور معروف شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 307.36,
   "end": 311.96,
   "text": "اما نه این میگه حب یعنی دوست داره مال رو دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.96,
   "end": 314.92,
   "text": "یکی هست خیلی هم داره اما دوست نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.92,
   "end": 320.16,
   "text": "یعنی اصلا فرار میکنه. مثل امیرالمؤمنین شبان هرچی که داشت دامن می تکوند و میخوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 320.16,
   "end": 322.48,
   "text": "گفتم آقا حالا فردا هم روز خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 322.48,
   "end": 327.16,
   "text": "هرچی داشت می بخشید. هرچی پول دستش بود پول نگه نمیداشت مولا شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.16,
   "end": 330.42,
   "text": "یک شب کسی ندید مولا شب پول نگه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 330.42,
   "end": 333.14,
   "text": "میگفتن آخه می فرمود معلوم نیست من تا فردا زنده باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 333.14,
   "end": 337.12,
   "text": "بعد چه کسایی فقیر گرسنه سر به زمین بگذارن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.12,
   "end": 341.02,
   "text": "بعدم معلوم نیست این پوله با من چه بلایی سر من بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.02,
   "end": 342.8,
   "text": "توجه کنید حب خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 342.8,
   "end": 346.32,
   "text": "اونا هم اگر این کارو میکنن میترسن از حبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 346.32,
   "end": 350.36,
   "text": "میگه مثل آبی که گیاه رو میرویاند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.36,
   "end": 356.62,
   "text": "حب به مال یا حب به دنیا بهتره بگیم یا همین حب به خود برتربینی، حب به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 356.62,
   "end": 360.8,
   "text": "مشهوریت و معروفیت نفاق میرویاند در قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.8,
   "end": 362.94,
   "text": "من انقدر غصه میخورم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 362.94,
   "end": 367.42,
   "text": "به حال این برنامه هایی که میبینم به عصر جدید و فلان مثلا بچه طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 367.42,
   "end": 375.58,
   "text": "ده سالشه، هفت هشت سالشه، سیزده سالشه اومده با افتخار میگه آرزوی من این بود که دیده بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 375.58,
   "end": 378.5,
   "text": "خب این، این پدر مادر درست تربیتش نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 378.5,
   "end": 381.46,
   "text": "این چه طرز، این چه آرزویه که تو داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 381.46,
   "end": 384.54,
   "text": "این آتشه که یا حتی دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 384.54,
   "end": 388.72,
   "text": "دنیا اگر اولیاء خدا ازش فرار می‌کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 388.72,
   "end": 391.02,
   "text": "نه اینکه نمی‌رفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 391.02,
   "end": 394.6,
   "text": "داشتن، خوبم کار می‌کردن، خوبم در می‌آوردن اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 394.6,
   "end": 399.24,
   "text": "همه رو دامن می‌چکوندن، فرار می‌کردن ازش، می‌دادن به دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 399.24,
   "end": 401.3,
   "text": "چون مثل مار افعیه. خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 401.3,
   "end": 403.66,
   "text": "گنده گنده آره زمین زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 403.66,
   "end": 406.34,
   "text": "این روایتو حتما همه‌تون شنیدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 406.34,
   "end": 409.26,
   "text": "آقای قراتی هم تو کتابشون رو آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 409.26,
   "end": 412.78,
   "text": "تو گناه شناسیشه، کتابی داره ایشون به نام گناه شناسی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 412.78,
   "end": 415.58,
   "text": "داستان رو آورده. حتما شنیدید سریع بگم برم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 415.58,
   "end": 418.54,
   "text": "یه تلنگری باشه برای خودم که وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 418.54,
   "end": 421.72,
   "text": "شخص به نام سعد خیلی فقیر بود، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 421.72,
   "end": 425.8,
   "text": "پیغمبر دلش واقعا می‌سوخت. وقتی می‌دید غم‌زده می‌شد پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 425.8,
   "end": 428.0,
   "text": "می‌گفت آخه ببینین پیغمبره دیگه رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 428.0,
   "end": 432.18,
   "text": "دلش می‌سوخت. یا آخه این یار من چرا انقدر فقیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 432.18,
   "end": 439.96,
   "text": "هیچی نداشت. پیغمبر بعد حضرت جبرائیل نازل شده یا رسول الله خدا غم دل تو رو به خاطر سعد که از اصحاب صفه بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 439.96,
   "end": 442.46,
   "text": "خیلی فقیر بودن، دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 442.46,
   "end": 446.1,
   "text": "خدا فرمود بیا این دو درهم رو بهش بده بگو کاسبی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 446.1,
   "end": 448.9,
   "text": "خوشحال شد پیغمبر بعد به سعد گفت بیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 448.9,
   "end": 451.92,
   "text": "بیا برو کاسبی کن حالا. جمعش مفصله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 451.92,
   "end": 458.64,
   "text": "و با دو درهم پیغمبر کنار مسجد شروع کرد کاسبی راه انداخت و بعد مغازه گرفت و وضعش توپ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 458.64,
   "end": 463.98,
   "text": "کسی که همیشه وایمیستاد در مسجد پیغمبر برسه با هم برن تو با هم بیان بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 463.98,
   "end": 467.8,
   "text": "پیغمبر دید حالا بلال اذان میده این پیداش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 467.8,
   "end": 471.2,
   "text": "رفت سراغش گفت سعد اذان داد بلال چرا نمیای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 471.2,
   "end": 473.34,
   "text": "گفت یا رسول الله خرید و فروش دارم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 473.34,
   "end": 477.0,
   "text": "ببین ازم جنس خریده می‌خوام پولشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 477.0,
   "end": 481.4,
   "text": "بگیرم ازش. ازش جنس خریدم می‌خوام پول بهش بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 481.4,
   "end": 484.08,
   "text": "پیغمبر خیلی ناراحت شد، خیلی غمگین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 484.08,
   "end": 487.66,
   "text": "تو روایت میگه غمگین‌تر از اون وضع قبلیش شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 487.66,
   "end": 493.36,
   "text": "حضرت جبرائیل دوباره نازل شد یا رسول الله اصلاً فلسفه مال اینه، دنیا اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 493.36,
   "end": 498.2,
   "text": "اینجوری میشه. آدم رو از صلاة از نماز وا می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 498.2,
   "end": 505.58,
   "text": "چقدر اشتغال به دنیا معمولاً اینطوریه مگر خیلی طرف کارش درست باشه دیگه خود ساخته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 505.58,
   "end": 508.34,
   "text": "بعد فرمود برو اون دو درهمتو پس بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.34,
   "end": 510.94,
   "text": "پیغمبر رفت فرمود نمی‌خوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 510.94,
   "end": 513.86,
   "text": "بدهی ما رو بدی؟ گفت دویست درهم میدم یا رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 513.86,
   "end": 517.92,
   "text": "وضعش خوب شده بود. پیغمبر گفت نمی‌خوام همون دو درهم خودمو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 517.92,
   "end": 521.7,
   "text": "برگشت و دو درهم برگشت همانا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 521.7,
   "end": 523.88,
   "text": "روزگار به این طرف برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.88,
   "end": 529.06,
   "text": "برکت از زندگیش رفت. پاچید و ورشکست شده دوباره همون فقیر قبلی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 529.06,
   "end": 531.32,
   "text": "پیغمبر فرمود این حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 531.32,
   "end": 534.86,
   "text": "بهتر از اون حالت قبلیه چون الان نمازتو میای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 534.86,
   "end": 538.1,
   "text": "نه اینکه پول توجه داشته باشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 538.1,
   "end": 543.54,
   "text": "نه اینکه پول داشتن، پول نداشتن خوبه‌ها، نه اینکه فقر خوبه‌ها اشتباه نکنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 543.54,
   "end": 545.54,
   "text": "فقر خیلی بده، بلاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 545.54,
   "end": 547.78,
   "text": "خیلی بده ما باید فرار کنیم ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 547.78,
   "end": 552.82,
   "text": "اما این که من انقدر خودمو نساختم، انقدر ظرفیتم بالا نرفته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 552.82,
   "end": 556.9,
   "text": "دو درهم منو اینطوری به هم می‌ریزه، همون طوره همون بهتر که فقیر بمونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 556.9,
   "end": 559.68,
   "text": "اون بهتره. البته و آخرتت رو از دست ندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 559.68,
   "end": 564.54,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 564.54,
   "end": 570.78,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}