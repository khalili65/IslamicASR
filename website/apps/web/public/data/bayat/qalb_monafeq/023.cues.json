 },
 "chapters": [
  {
   "index": 0,
   "title": "## سفر معصیت و شرط قصر",
   "start": 11.28,
   "end": 161.14
  },
  {
   "index": 1,
   "title": "## تخلف از نماز جماعت؛ علامت نفاق",
   "start": 161.14,
   "end": 435.57
  },
  {
   "index": 2,
   "title": "## سه توصیهٔ شیخ انصاری",
   "start": 435.57,
   "end": 507.25
  },
  {
   "index": 3,
   "title": "## توحد ظاهری و باطنی جماعت",
   "start": 507.25,
   "end": 617.11
  },
  {
   "index": 4,
   "title": "سورهٔ احزاب آیهٔ نوزده:",
   "start": 617.11,
   "end": 664.75
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 2.74,
   "text": "بسم الله الرحمن الرحیم و بهیم نستغفریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.74,
   "end": 7.32,
   "text": "السلام علیک یا داعی الله و ربانی ایه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.32,
   "end": 10.34,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.34,
   "end": 17.8,
   "text": "عرض کردیم که یکی از شروط هشت گانه اینکه انسان مسافر باشه و نمازش قصر باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.8,
   "end": 21.92,
   "text": "این هستش که نما-- سفر، سفر گناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.92,
   "end": 24.94,
   "text": "و معصیت نباشه. چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.94,
   "end": 29.22,
   "text": "این سفر برای گناه باشه، چه سفر گناه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.22,
   "end": 31.18,
   "text": "اینو دوست دارم مصداق بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.18,
   "end": 33.62,
   "text": "اینکه سفر گناه باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.62,
   "end": 38.2,
   "text": "مثل بچه‌ای که بدون اذن پدر مادرش بره سفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.2,
   "end": 42.12,
   "text": "مثل زنی که بدون اذن شوهرش بره سفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.12,
   "end": 44.24,
   "text": "این سفر معصیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.24,
   "end": 47.7,
   "text": "نه برای معصیت رفته‌ها، سفر معصیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.7,
   "end": 51.8,
   "text": "چنین کسی مسافر نیست، ولو حد شرعی هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.8,
   "end": 55.76,
   "text": "رد کنه مسافر نیست، نمازش کامله، روزه‌شم باید بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.76,
   "end": 59.44,
   "text": "یا اینکه میگه اگر برای معصیت بره یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.44,
   "end": 62.04,
   "text": "مشخصه. یعنی اینکه سفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.04,
   "end": 66.1,
   "text": "صرفاً نیتش از رفتن به این سفر انجام یه کار مع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.1,
   "end": 69.1,
   "text": "گناه و معصیت باشه. مثل کسی که بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 69.1,
   "end": 71.94,
   "text": "مثلاً استغفرالله بخواد دزدی کنه، بخواد یه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 71.94,
   "end": 77.94,
   "text": "بره یه شهری قضاوت نابجایی بکنه، بره به کسی ستم بکنه، بره یکی رو بزنه حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 77.94,
   "end": 81.16,
   "text": "این زدن ظلم باشه. برای هر gun--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 81.16,
   "end": 87.02,
   "text": "س-- قصد گناه و معصیتی اگه سفر کنه این سفر برای معصیت میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.02,
   "end": 93.8,
   "text": "و مسافر حساب نمیشه. یه منظومه‌ای رو ما با توجه به آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.8,
   "end": 99.08,
   "text": "فکر می‌کنم توی این حدود شصت نوع قلبی که ما داریم از قرآن استخراج می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.08,
   "end": 103.48,
   "text": "و رسیدیم به قلب منافق، هیچ‌گاه به اندازه این قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.48,
   "end": 110.38,
   "text": "نفاق، قلبی که گرفتار نفاق شده توقف نکردیم به جهت اینکه اولاً آیات قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.38,
   "end": 114.44,
   "text": "خیلی درباره‌ش هست و خیلی هم قصه مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.44,
   "end": 120.68,
   "text": "و قابل توجه. ضمن اینکه خ-- عرض کردیم تصریح می‌کنم دو مرتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.68,
   "end": 126.68,
   "text": "یک منظومه‌ای رو قرآن از اهل نفاق بیان کرده، مشخصات داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.68,
   "end": 132.88,
   "text": "که این نقطه‌ها رو مثل نقاشی که به بچه میدن نقطه‌ها-- میگه نقطه‌ها رو به هم بچی-- برس کن یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.88,
   "end": 135.14,
   "text": "آخر سر یه شکلی رو بهت نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.14,
   "end": 141.16,
   "text": "این منظومه رو کسی از قرآن درآره و روایات متوجه اون قصه نفوذ رهبری میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.16,
   "end": 145.34,
   "text": "خب این قرآنه دیگه. قابل توجه مدیران عزیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.34,
   "end": 149.36,
   "text": "که اگر کسی واقعاً بخواد ریشه نفوذ رو بزنه این یه راهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.36,
   "end": 152.4,
   "text": "نفوذ یعنی چی؟ آیا جز اینه که نفاقه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.4,
   "end": 155.4,
   "text": "اگر نفاق نباشه دیگه نفوذ معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.4,
   "end": 158.1,
   "text": "منافقانه میان نف-نفوذ می‌کنن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.1,
   "end": 162.54,
   "text": "با این همه عرض شود فیلترهایی که در ورود و خروج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.54,
   "end": 165.1,
   "text": "نهادها و ادارجات ما وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.1,
   "end": 167.54,
   "text": "خب این آیاتو ما داریم میگیم. ببین الان یه مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.54,
   "end": 172.08,
   "text": "من الان به شما میگم یه مثال قرآنی و روایی ببین تعجب شاید بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.08,
   "end": 175.82,
   "text": "عجب این هم نشانه نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.82,
   "end": 179.84,
   "text": "در یک روایت معتبری که ابن مسعود از پیامبر اعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.84,
   "end": 182.78,
   "text": "اسلام بیان کردن در صفات منافق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.78,
   "end": 188.26,
   "text": "فرمودن \"و ما يتخلف عنها إلا منافق معلوم النفاق\" خیلی‌هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.26,
   "end": 192.28,
   "text": "تصریح کرده پیغمبر که اصلاً چنین کسی معلوم النفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.28,
   "end": 195.62,
   "text": "اصلاً نفاقش کاملاً مثل اینکه میگن فلانی معلوم الحاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.62,
   "end": 197.76,
   "text": "اصلاً مشخصه چه جور آدمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.76,
   "end": 199.86,
   "text": "این \"و ما يتخلف عنها\" از چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.86,
   "end": 203.06,
   "text": "یه بخشی از یک روایته. تخلف از چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.06,
   "end": 206.06,
   "text": "از نماز جماعت. عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 206.06,
   "end": 209.68,
   "text": "میگه اگر کسی از نماز جماعت تخلف کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.68,
   "end": 214.42,
   "text": "حالا اینجا نمیاد، اون یکی مسجد، این جما-- اون جماعتو نمیاد، اون یکی جماعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.42,
   "end": 217.38,
   "text": "اصلاً جماعت اهل ایمان و نمازو نمیره شرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.38,
   "end": 221.26,
   "text": "این چنین کسی اصلاً میگه معلوم النفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.26,
   "end": 224.46,
   "text": "پیغمبر فرمود اینو دیگه از بچگی ما شنیدیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.46,
   "end": 228.98,
   "text": "فرمود به یهودی‌ها سلام کنید اما به یهود امت من سلام نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.98,
   "end": 230.88,
   "text": "گفتن مگه امت شما یهودی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.88,
   "end": 233.7,
   "text": "فرمود بله، کسی که صدای اذان رو بشنوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.7,
   "end": 237.14,
   "text": "هیچ عذر شرعی هم نداشته باشه، مریض هم نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.14,
   "end": 243.48,
   "text": "ولی تو جماعت اهل ایمان برای نماز شرکت نکنه، این که اصلاً یهودی امت منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.48,
   "end": 249.5,
   "text": "بعد ما جالبه یه آدم خیلی معمولی می‌خواد بیاد توی اداره ما مست-- استخدام بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.5,
   "end": 253.52,
   "text": "پوستشو می‌کنیم که آیا باید حتما باید اهل جماعت و مسجد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.52,
   "end": 255.76,
   "text": "میریم مسجد محلش تحقیق می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 255.76,
   "end": 261.78,
   "text": "ولی ما بسیار می‌بینیم حتی مدیرانی که اصلاً نماز جماعتو اصلاً وقت Free نمی-نمی‌بینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.78,
   "end": 268.16,
   "text": "من سؤال می‌کنم این‌ها شأنشون بالاتره یا رهبر عزیز ما یا مراجع؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.16,
   "end": 271.46,
   "text": "این‌ها دائماً نماز جماعت سه وقت حتی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.46,
   "end": 273.56,
   "text": "صبحشون هم جماعت می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 273.56,
   "end": 275.96,
   "text": "رهبر عزیزمون نماز جماعت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 275.96,
   "end": 280.86,
   "text": "اون دور و بریا میان جماعت حتی دوشنبه‌هاش که عمومیه مردم میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.86,
   "end": 285.68,
   "text": "اصلاً کسی که نسبت به نماز جماعت بی‌خیاله، این نشانه نفاقشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.68,
   "end": 288.36,
   "text": "حالا هر دلیلی می‌خواد در خودش بیاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 288.36,
   "end": 292.64,
   "text": "هر توجیهی می‌خواد بیاره، هر آدم امنیتی که هست که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.64,
   "end": 295.5,
   "text": "کسی که تخلف کنه به این صریح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.5,
   "end": 298.34,
   "text": "ش-- پیغمبر داره نشونه میده دیگه به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 298.34,
   "end": 303.02,
   "text": "باید مراقب باشیم. در هر حال و جالبه که این‌ها وقتی میری بررسی می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 303.02,
   "end": 309.48,
   "text": "می‌بینی خیلی‌هاشون اصلاً به جهت مریضی دل دچار نفاق و دورویی با اهل ایمان شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.48,
   "end": 314.46,
   "text": "آخه چه جماعتی کم ار-- کم خرج‌تر از نماز جماعت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.46,
   "end": 319.86,
   "text": "هیچ هزینه‌ای نداره. چه جماعتی مثل با صفایی نماز جماعت اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.86,
   "end": 323.24,
   "text": "انقدر در دسترس باشه، انقدر آدمو منظم کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.24,
   "end": 325.62,
   "text": "ساعتتو باهاش تنظیم کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.62,
   "end": 328.32,
   "text": "توجه کردی؟ بعد چقدر به انسان رشد فکری میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.32,
   "end": 330.24,
   "text": "اصلاً چرا ایشون شده امام جماعت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.24,
   "end": 333.56,
   "text": "برای چی؟ چون ظاهراً از دیگران بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.56,
   "end": 338.58,
   "text": "مثلاً علم بیشتری داره که به غالب مراجع فرمودن اگر آخوند هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.58,
   "end": 343.2,
   "text": "عمامه به سر هست، چون تحصیل علم داشته این نشانه‌ی عظمت علمه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.2,
   "end": 346.94,
   "text": "العلم سلطان. میگه اصلاً جایز نیست به غیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.94,
   "end": 351.62,
   "text": "عمامه به سر جلو وایسته. من بعضی مساجد رفتم با همین لباس آخوندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.62,
   "end": 355.52,
   "text": "جماعت زیاد یک نفر پا نشد بگه حاج آقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.52,
   "end": 360.08,
   "text": "آقای پیرمردی که اون جلو وایسادی بیا اینور یه آخوند تو مسجد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.08,
   "end": 366.11,
   "text": "یک نفر یعنی این اصلاً انقدر ضعف دارن بعضیا از جهت آگاهی مسائل شرعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.11,
   "end": 371.51,
   "text": "یا حتی جالب اینا رو شما ببینید پیغمبر می‌فرمود آقای قراشی هم تو کتاب راز نمازش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.51,
   "end": 374.13,
   "text": "می‌فرمايد باید اهل فکر هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.13,
   "end": 376.31,
   "text": "امام جماعت باید فکور باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 376.31,
   "end": 378.51,
   "text": "مبرهن باشه، اهل برهان باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.51,
   "end": 382.21,
   "text": "یعنی بین شما آدمی که تقواش بیشتره، علمش بیشتره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.21,
   "end": 385.17,
   "text": "مبرهن اهل برهان و فکره، اون وایسته جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.17,
   "end": 387.41,
   "text": "و البته باید عدالت محرز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.41,
   "end": 389.53,
   "text": "این هست. ولی این که حتما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.53,
   "end": 394.07,
   "text": "حق نداری اصلاً شما بری تفحص کنی، بررسی کنی آقا ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.07,
   "end": 398.29,
   "text": "چیکار می‌کنه تو زندگیش. پیغمبر و امام باقر شاخص دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.29,
   "end": 400.87,
   "text": "فرمودن چشمش پاک باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.87,
   "end": 406.63,
   "text": "زبانش پاک باشه، تو داد و ستد و معاملات هم اهل خیانت نباشد و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.63,
   "end": 409.17,
   "text": "بعد تازه مراجع اینو فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 409.17,
   "end": 413.31,
   "text": "اصلاً نیاز نداره تو بری عین ذره‌بین بذاری یه دونه عیب ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 413.31,
   "end": 418.25,
   "text": "کدوم یکی از ما می‌تونیم ادعا کنیم هیچ گناهی از ما سر نزده و ما عدالتمونه مطلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 418.25,
   "end": 421.27,
   "text": "اهدی جرأت همچین جسارتی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 421.27,
   "end": 424.77,
   "text": "پس چه کنیم؟ فرمودن اصرار بر گناه نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.77,
   "end": 427.51,
   "text": "یعنی شما نبینی این همش داره گناه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.51,
   "end": 431.37,
   "text": "تو ازش گناهی نبینی. اصرار مصر نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.37,
   "end": 438.21,
   "text": "البته سخته. پیش‌نمازی خدا رحمت کنه شیخ اعظم مرحوم شیخ مرتضی انصاری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.21,
   "end": 444.95,
   "text": "این عالم بزرگوار چند بار عرض کردم خدمتتون همیشه به شاگرداشون سه تا توصیه داشتن دیگه یادتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 444.95,
   "end": 447.43,
   "text": "اصلاً دیشب یادتون هست چی خوردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 447.43,
   "end": 450.39,
   "text": "توصیه می‌کردن که آقا جون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.39,
   "end": 453.77,
   "text": "یه چیزو چه برای خدا باشه چه برای غیر خدا انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.77,
   "end": 456.85,
   "text": "عجب! اون چیه؟ تحصیل علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 456.85,
   "end": 459.37,
   "text": "علم نور داره آدمو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 459.37,
   "end": 462.25,
   "text": "خوش فکر می‌کنه. یک چیزو فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 462.25,
   "end": 465.33,
   "text": "چه برای خدا بود و چه برای غیر خدا انجام نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 465.33,
   "end": 467.17,
   "text": "اونم قضاوت. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.17,
   "end": 469.65,
   "text": "چقدر بین ما این قضاوت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 469.65,
   "end": 475.39,
   "text": "حتی برای غیر خدا. و یک چیزو فرمود فقط اگه برای خدا بود انجام بده برای غیر خدا انجام نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.39,
   "end": 478.23,
   "text": "اونم پیش‌نمازیه. امام جماعت شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 478.23,
   "end": 484.29,
   "text": "سخته اما اگر بدونیم چه توفیق بزرگی نصیب ما می‌شه با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 484.29,
   "end": 490.45,
   "text": "جماعت اهل ایمان و این شخصی که جلو می‌ایسته به نیابت از شما انشا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 490.45,
   "end": 492.71,
   "text": "اهدنا ما را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 492.71,
   "end": 498.29,
   "text": "هدایت کن به سمت راه مستقیم و اگه یه نفر اون تو جمع قر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 498.29,
   "end": 501.79,
   "text": "قبول بشه نمازشو از همه می‌پذیرن و بحث‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 501.79,
   "end": 505.97,
   "text": "این چنینی که البته من معتقدم دوست داشتید بحث می‌کنیم با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.97,
   "end": 509.41,
   "text": "معتقدم که اون جماعتی که فرمود اگر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.41,
   "end": 517.73,
   "text": "جماعت اتفاق بیفته فقط خدا ثوابشو می‌دونه نه این جماعت‌هایی که ماها داریم جسارتاً ببخشید با امام جماعتی من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.73,
   "end": 520.83,
   "text": "جماعت محل جمع توحد محضه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.83,
   "end": 523.77,
   "text": "یعنی همه به سمت یک قبله ایستادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 523.77,
   "end": 526.25,
   "text": "همه یک شکل دارن نماز می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 526.25,
   "end": 529.51,
   "text": "امام که میره رکوع همه رکوعن، سجود همه سجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.51,
   "end": 532.15,
   "text": "ظاهراً، ظاهراً توحد هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.15,
   "end": 534.85,
   "text": "اما اگر باطناً هم توحد بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.85,
   "end": 541.41,
   "text": "قلب‌ها همه به سمت خدا بود نه یکی تو بازارش، یکی پشت میزش، یکی مشغول گفت‌وگو با همسرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 541.41,
   "end": 545.71,
   "text": "یکی مشغول مطالعه، یکی داره چک‌هاش رو بررسی می‌کنه تو نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 545.71,
   "end": 548.81,
   "text": "این چه جماعتیه؟ این جماعت نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 548.81,
   "end": 550.93,
   "text": "اگر محل جمع بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 550.93,
   "end": 554.45,
   "text": "نقطه رو زد. توحد داشت اون جماعت اتفاق می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 554.45,
   "end": 560.29,
   "text": "در هر حال این‌هایی که معمولاً نمیان ختم کلام اینکه این‌ها مریض، مریض احوالن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 560.29,
   "end": 563.15,
   "text": "قلبشون مریضه، دچار بدبینی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 563.15,
   "end": 566.91,
   "text": "همین چند روز پیش یه عزیز بچه‌ی خوب ما گفتش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 566.91,
   "end": 570.41,
   "text": "به من گفتن مسجد بلال اگه می‌خوای مشکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 570.41,
   "end": 572.69,
   "text": "کاریت حل بشه برو مسجد بلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 572.69,
   "end": 575.89,
   "text": "چرا؟ اونجا مدیرها، برو صف اول مدیرها می‌شینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 575.89,
   "end": 579.71,
   "text": "بشین اونجا مدیرها نگاهت کنن ببیننت کارت حل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 579.71,
   "end": 584.23,
   "text": "گره‌ات باز می‌شه. حالا یکی اومده یه چیزی به ایشون گفته یا خودش از کسی شنیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 584.23,
   "end": 586.27,
   "text": "دیگه همه رو به این چشم می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 586.27,
   "end": 588.85,
   "text": "فکر می‌کنه هر کی میاد مسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 588.85,
   "end": 593.01,
   "text": "دنبال اینه که مثلاً خودی نشون بده و دنبال اینجور حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 593.01,
   "end": 597.41,
   "text": "این بدبینیه. اتفاقاً یه آیه هم بگم و این آیه رو برید دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 597.41,
   "end": 603.03,
   "text": "این منظومه‌ها رو من توصیه می‌کنم مدیران این منظومه قرآنی رو نشانه شناسی کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 603.03,
   "end": 605.95,
   "text": "یه منظومه قشنگی می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 605.95,
   "end": 609.99,
   "text": "من ندیدم جایی انجام بدن. این آیه رو هم بشنوید و برید به امید خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 609.99,
   "end": 616.87,
   "text": "احزاب سوره 19. \"سلَقُوکم بألسنتٍ هداد أشهةً على الخير\" عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 616.87,
   "end": 623.65,
   "text": "میگه اهل نفاق زبان‌های تند و تیز خودشون رو بی‌ادبانه به سمت شما می‌کشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 623.65,
   "end": 626.11,
   "text": "\"سلَقُوکم بألسنتٍ هداد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 626.11,
   "end": 628.33,
   "text": "اما \"أشهةً على الخير\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 628.33,
   "end": 630.93,
   "text": "وقتی بحث مال پیش میاد میان تو جمع شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 630.93,
   "end": 634.99,
   "text": "پرایس‌ند. تا میگن دارن فلان چیزو پخش می‌کنن، دارن فلان چیزو...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.99,
   "end": 638.09,
   "text": "میان تو جماعت مؤمنین. اما همش بدگویی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 638.09,
   "end": 643.29,
   "text": "فلانی ول کن بابا. اونو می‌دونی اون برای این اومده تو جماعت، اون برای این اومده تو جماعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 643.29,
   "end": 646.55,
   "text": "همش بدبینی و بدگویی برای اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 646.55,
   "end": 650.19,
   "text": "چرا؟ دل دچار نفاق شده، بدبین شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 650.19,
   "end": 654.69,
   "text": "عالم مثال و خیال وجودش رو تصفیه نکرده عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 654.69,
   "end": 660.87,
   "text": "لذا همش بدبینه. ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 660.87,
   "end": 664.75,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}