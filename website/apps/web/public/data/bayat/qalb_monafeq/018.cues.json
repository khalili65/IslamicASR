 "chapters": [
  {
   "index": 0,
   "title": "## استفتا در حدِّ ترخّص",
   "start": 11.26,
   "end": 68.46
  },
  {
   "index": 1,
   "title": "## نشانهٔ نفاق؛ ایمانِ زبانی بدونِ قلب",
   "start": 68.46,
   "end": 193.72
  },
  {
   "index": 2,
   "title": "## نمونه‌ها؛ انقلاب، خطِّ امام، هیئت",
   "start": 193.72,
   "end": 263.72
  },
  {
   "index": 3,
   "title": "## مجالس و ملائکه؛ مدیریت؛ داستانِ مهزیار",
   "start": 263.72,
   "end": 689.72
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.54,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.54,
   "end": 7.12,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.12,
   "end": 11.26,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.26,
   "end": 16.0,
   "text": "از رهبر عزیزمون پیرامون حد ترخص استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.0,
   "end": 19.44,
   "text": "خب میدونید ما وقتی که از سفر برمی‌گردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.44,
   "end": 21.88,
   "text": "وقتی که به وطنمون رسیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.88,
   "end": 24.54,
   "text": "قاعدتاً نماز دیگه کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.54,
   "end": 27.52,
   "text": "وقتی رسیدیم به وطن نماز کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.52,
   "end": 35.2,
   "text": "حالا سؤال اینه که حتما باید برسیم به وطن یا اگر به حد ترخص هم رسیدیم، به حد ترخص وطنمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.2,
   "end": 38.22,
   "text": "رسیدیم دیگه می‌تونیم نماز رو کامل بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.22,
   "end": 41.78,
   "text": "رهبری فرمودن، اول فتوا دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.78,
   "end": 48.7,
   "text": "فرمودن همین که به حد ترخص رسیدید کفایت می‌کنه که نماز رو کامل بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.7,
   "end": 52.72,
   "text": "بعد احتیاط کردن. فرمودن اگرچه احتیاط این است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.72,
   "end": 56.54,
   "text": "که صبر کنی به وطن برسی بعد کامل بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.54,
   "end": 58.82,
   "text": "خب این یعنی چی؟ احتیاط چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.82,
   "end": 63.4,
   "text": "مستحب میشه چون اول فتوا داده بعد احتیاط کرده یعنی مستحب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.4,
   "end": 66.4,
   "text": "یعنی باید فتوا، یا فتوا رو رعایت کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.4,
   "end": 72.46,
   "text": "یا احتیاط رو. یکی دیگه از نشانه‌های منافقین که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.46,
   "end": 75.64,
   "text": "یا اهل نفاق یا کسایی که قلبشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.64,
   "end": 78.76,
   "text": "منحرف شده به سمت دورویی و نفاق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.76,
   "end": 82.52,
   "text": "آیه چهل و یک که قبلاً سرفصلشو بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.52,
   "end": 85.06,
   "text": "اونجایی که می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.06,
   "end": 89.74,
   "text": "«الذین قالوا آمنا بأفواههم ولم تؤمن قلوبهم»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.74,
   "end": 91.42,
   "text": "گفتیم این نشانه منافقینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.42,
   "end": 94.3,
   "text": "به زبانشون چیزی رو جاری می‌کنن که تو دلشون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.3,
   "end": 97.56,
   "text": "دورون. خب بعد میریم جلوتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 97.56,
   "end": 101.14,
   "text": "تو بخش دیگه این آیه یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 101.14,
   "end": 103.58,
   "text": "کارهایی که اهل نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.58,
   "end": 106.96,
   "text": "انجام میدن و اینچنین فرموده صراحتاً که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 106.96,
   "end": 111.02,
   "text": "«يُحَرِّفُونَ الْكَلِمَ مِن بَعْدِ مَوَاضِعِهِ».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 111.02,
   "end": 116.06,
   "text": "عجب! این‌ها اصلاً کارشون اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.06,
   "end": 123.2,
   "text": "میان انحراف ایجاد می‌کنن، تحریف ایجاد می‌کنن در دستورات خدا، در دین خدا، در احکام دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.2,
   "end": 126.14,
   "text": "حتی در سبک زندگی اسلامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.14,
   "end": 129.16,
   "text": "انحراف و تحریف ایجاد می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.16,
   "end": 135.2,
   "text": "و این تحریف تا دلت بخواد عزیزان دلم الان موج می‌زنه تو قسمت‌های مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.2,
   "end": 139.2,
   "text": "متاسفانه دین ما تا جایی که ما تو نذبه می‌خونیم «أين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.2,
   "end": 143.32,
   "text": "مؤمل لإحياء الكتاب وحدوده»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.32,
   "end": 148.58,
   "text": "درسته؟ این مؤمل از عمل میاد یعنی آرزومندشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.58,
   "end": 150.32,
   "text": "کیو؟ إحياء الكتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.32,
   "end": 153.56,
   "text": "بیاد احیا کنه کتاب و حدودش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.56,
   "end": 158.58,
   "text": "یعنی انقدر دین به انحراف رفته و تحریف شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.58,
   "end": 163.92,
   "text": "یا «أين محی معالم الدين وأهله» دوباره عبارت بعدیش تو نذبه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.92,
   "end": 166.82,
   "text": "اصلاً انقدر حتی اهل دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 166.82,
   "end": 169.64,
   "text": "تحریف شدن. خیلی اینجا بحث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 169.64,
   "end": 176.42,
   "text": "الان شما دقت بفرمایید ببینید تو جنبه‌های مختلف اعم از احکام دینی، اقتصادیش، سیاسیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.42,
   "end": 178.82,
   "text": "فرهنگیش، نظامیش حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.82,
   "end": 182.8,
   "text": "سبک زندگیمون، نوع مدیریتمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 182.8,
   "end": 188.96,
   "text": "هیأت‌داریمون، همه این‌ها انحرافات و تحریف‌های عجیبی درش ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.96,
   "end": 193.64,
   "text": "تا دلت بخواد. چند نمونه ما مثال بزنیم خودتون دارید می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.64,
   "end": 197.08,
   "text": ". در کلمات رهبرمون چقدر تحریف ایجاد می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.08,
   "end": 200.1,
   "text": "در ارزش‌های ناب انقلابمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.1,
   "end": 205.66,
   "text": "در گفته‌های اماممون، خط امام چقدر انحراف، چقدر دعای خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.66,
   "end": 209.48,
   "text": "نمی‌دونم پیرو خط امام دارن اما کاملاً متناقض با هم حرف می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.48,
   "end": 216.38,
   "text": "اینا همه تحریفه دیگه. حتی تو هیأت‌های ما که ناب‌ترین جلسات ما انحرافات عجیبی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.38,
   "end": 218.98,
   "text": "من پارسال عرض کردم که آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.98,
   "end": 220.96,
   "text": "سیستانی هم دیگه صداش دراومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.96,
   "end": 225.38,
   "text": "نامه زد به صدا و سیما حضرت آیت الله العظمی سیستانی عایدونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.38,
   "end": 228.06,
   "text": "گله کرده بود که صدا و سیمای ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.06,
   "end": 231.54,
   "text": "داره مجلس اهل بیت رو مداح محور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.54,
   "end": 234.46,
   "text": "از، از چه عرض کنم بهتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.46,
   "end": 236.64,
   "text": "عالم محوری می‌کشونه به اون سمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.64,
   "end": 240.56,
   "text": "بعضی از خود شماها اومدید به من گله کردید که خب حق دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.56,
   "end": 243.3,
   "text": "حق دارن. آمن-- عالم درست نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.3,
   "end": 248.08,
   "text": "این حرف خیلی غلطه. نه که خیلی مداح درست زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.08,
   "end": 251.1,
   "text": "من خودم می‌دونید مدال نوکری ابی عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 251.1,
   "end": 253.6,
   "text": "به گردنمه و بیش از اینکه مد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 253.6,
   "end": 259.86,
   "text": "مثلاً آخوند باشیم و عرض شود عالم منبر و اینا روضه خونیم، مداحیم، بودیم بیست و پنج سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 259.86,
   "end": 262.4,
   "text": "افتخار می‌کنیم. اما خیلی تحریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.4,
   "end": 266.44,
   "text": "تا دلت بخواد در نوع عزاداری‌ها، تو هیئت‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.44,
   "end": 268.74,
   "text": "تو بهترین هیئت‌ها می‌بینی اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 268.74,
   "end": 271.12,
   "text": "طرف نه میاد پای منبر می‌شینه، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 271.12,
   "end": 276.1,
   "text": "حال داره دو تا حدیث بشنوه، نه روضه و هیچی فقط میاد چایی بریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.1,
   "end": 278.38,
   "text": "فقط میاد مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 278.38,
   "end": 281.0,
   "text": "عشقش اینه که بیاد دیگ بشوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 281.0,
   "end": 283.14,
   "text": "میگه من همین بسمه، من همین رو می‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 283.14,
   "end": 286.0,
   "text": "هیچی، اصلاً دنبال هیچ معرفتی نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.0,
   "end": 291.86,
   "text": "این یه نوع تحریفه اصلاً. یا تو بعضی هیئت و جلسات خانوما که لا ما شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 291.86,
   "end": 295.8,
   "text": "مثلاً خانومه وراش تو جلسه گفته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 295.8,
   "end": 298.44,
   "text": "آره خانوما که میان می‌شینن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.44,
   "end": 302.1,
   "text": "تو خا- مجالس زنونا چادر سرتون کنید because چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 302.1,
   "end": 305.08,
   "text": "بعضی از ملائکه مردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 305.08,
   "end": 306.76,
   "text": "نمی‌تونن حضور پیدا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 306.76,
   "end": 309.4,
   "text": "یعنی دیگه تا اینجا شما نشنیده بودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 309.4,
   "end": 312.26,
   "text": ". بابا ملائکه از جنس مجر— از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 312.26,
   "end": 316.86,
   "text": "ما را عالم معقولاتن از جن-- اصلاً مجرد تامن اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 316.86,
   "end": 322.14,
   "text": "تجرد دارن. اصلاً جنس ندارن، جنس زن و مرد ندارن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 322.14,
   "end": 329.34,
   "text": "این تحریفی که مسیحی‌ها ایجاد کردن مثلاً ملائکه رو معمولاً به شکل دختر می‌کشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 329.34,
   "end": 332.74,
   "text": "آخه نمی‌دونم از کدومش بگم. نوع مدیریت ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 332.74,
   "end": 340.42,
   "text": "مدیریت بین-- الان تا کسیه مدیری میشه، مسئولی میشه، مدیر کلی میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.42,
   "end": 343.34,
   "text": "که متاسفانه جمع شما معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 343.34,
   "end": 346.36,
   "text": "اخیراً اینقدر ما این حرفو زدیم خالی شده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 346.36,
   "end": 348.36,
   "text": "جماعت مدیرکل‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 348.36,
   "end": 350.86,
   "text": "همه فراری شدن از بحث‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 350.86,
   "end": 354.04,
   "text": "خدا خیر بده باز این بچه‌هایی که جدیداً دارن میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 354.04,
   "end": 356.7,
   "text": "میگم بچه‌ها چون همه هم جنسیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 356.7,
   "end": 361.74,
   "text": "بچه‌های سپاه که دارن میان. اینا باز الحمد لله خیلی خاکی‌ترن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 361.74,
   "end": 367.5,
   "text": "این‌ها می‌بینی اصلاً چجوری تحریف شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 367.5,
   "end": 372.8,
   "text": "یادتونه یه داستانی یه روز که خیلی هم معروفه‌ها اما متاسفانه این داستان هم تحریف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 372.8,
   "end": 377.36,
   "text": "دیدن پسر امام زمان توسط پسر مهزیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 377.36,
   "end": 380.26,
   "text": "که امام عصر آخر میگه چقدر دیر اومدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 380.26,
   "end": 383.28,
   "text": "می‌گه آقا ما دنبال شما بودیم و حضرت می‌فرماید نخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 383.28,
   "end": 385.98,
   "text": "می‌دونید چرا دیر به دیدن ما رسیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 385.98,
   "end": 388.02,
   "text": "سه تا یادتون باشه دلیل میاره حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 388.02,
   "end": 408.02,
   "text": "میگه اول می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 638.88,
   "end": 658.88,
   "text": "خسته‌تون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 661.9,
   "end": 664.78,
   "text": "نکنم. این یادمون باشه مراقب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 664.78,
   "end": 669.0,
   "text": "تحریف‌های دین در جز جز معالم دینیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 669.0,
   "end": 674.48,
   "text": "و این مکتب عزیزمون و سبک زندگیمون حتی باشیم که این نشانه نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 674.48,
   "end": 676.06,
   "text": "و انحراف قلبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 676.06,
   "end": 681.12,
   "text": "انشاالله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 681.12,
   "end": 684.06,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 684.06,
   "end": 686.76,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 686.76,
   "end": 689.72,
   "text": "محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}