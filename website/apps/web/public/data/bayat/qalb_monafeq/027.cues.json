 "chapters": [
  {
   "index": 0,
   "title": "## ریزه‌کاری کفاره؛ یک فقیر یا شصت فقیر",
   "start": 13.94,
   "end": 101.42
  },
  {
   "index": 1,
   "title": "## تعریف راغب؛ نفاق ورود از دری و خروج از دری دیگر",
   "start": 101.42,
   "end": 151.04
  },
  {
   "index": 2,
   "title": "## نفاق در برابر تقیه",
   "start": 151.04,
   "end": 171.22
  },
  {
   "index": 3,
   "title": "## اشتباه استراتژیک جابر؛ سلام علنی به امام باقر",
   "start": 171.22,
   "end": 321.52
  },
  {
   "index": 4,
   "title": "## جملۀ طلایی حضرت زهرا؛ شیطان و آمادگی خواص",
   "start": 321.52,
   "end": 418.93
  },
  {
   "index": 5,
   "title": "## مثال گرا‌دادن خواص و غیبت ولایت فقیه در فهم ملت",
   "start": 418.93,
   "end": 540.95
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.48,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.48,
   "end": 7.12,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.12,
   "end": 11.02,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.02,
   "end": 17.02,
   "text": "دقت بفهمید یه اشتباهی که بعضیا انجام میدن در دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.02,
   "end": 23.84,
   "text": "کفاره. خب ما داریم که یک جایی هست شما مثلا چند تا روزه رو نگرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.84,
   "end": 31.5,
   "text": "خب کفاره عذر میخوای بدی کشیده به ماه سا-- ماه رمضان سال بعد کفاره گردنت اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.5,
   "end": 33.8,
   "text": "بخوای کفاره رو رد کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.8,
   "end": 39.14,
   "text": "این بابت هر یک روز یک مد طعام به فقیر میتونی بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.14,
   "end": 41.86,
   "text": "حالا شما سی روزم نگرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.86,
   "end": 46.64,
   "text": "اینجا میتونی عین سی روز کفاره رو بدی به یک فقیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.64,
   "end": 49.5,
   "text": "به یک فقیر. دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.5,
   "end": 53.32,
   "text": "اما جایی که کفاره جمع تعلق گرفته میگه س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.32,
   "end": 55.82,
   "text": "شصت تا فقیر رو سیر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.82,
   "end": 58.54,
   "text": "اینجا شما نمیتونی بری شصت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.54,
   "end": 64.34,
   "text": "تا کفاره یا عرض شود مثلا شصت وعده غذا بدی به یک فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.34,
   "end": 69.58,
   "text": "این اشتباه است. این اشتباهی که بعضیا میکنن حواستون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.58,
   "end": 71.88,
   "text": "در کفاره جمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.88,
   "end": 75.14,
   "text": "شما نمیتونی همه رو جمع کنی بدی به فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.14,
   "end": 77.76,
   "text": "میگه شصت تا فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.76,
   "end": 79.7,
   "text": "موضوع اصلا فرق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.7,
   "end": 87.04,
   "text": "شصت تا فقیر رو بله باید شصت نفر رو جدا، جدا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.04,
   "end": 88.78,
   "text": "اینا رو چیکار کنی؟ سیر کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.78,
   "end": 91.36,
   "text": "این اخ-اختلاف رو حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.36,
   "end": 98.84,
   "text": "ریزه کاریای فقه رو. قلب منافق رو هم خب نکته‌ای دو مرتبه امروز عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.84,
   "end": 104.5,
   "text": "داشتم بررسی میکردم که جالبه دیدم راغب اصفهانی رحمة الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.5,
   "end": 109.46,
   "text": "فرق یه ج-- تعریف جالبی پیرامون نفاق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.46,
   "end": 111.66,
   "text": "میگه که خیلی کار ما رو آسون کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.66,
   "end": 114.08,
   "text": "میگه نفاق یعنی ورود از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.08,
   "end": 118.6,
   "text": "از دری وارد به اسلام بشی از دری خارج بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.6,
   "end": 123.06,
   "text": "اصلا نمیشه کسی وارد به اسلام نشده باشه و منافق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.06,
   "end": 129.86,
   "text": "ما گاهی اوقات دنبال منافقین، دنبال چهره‌های منافقین در خارج از حطه مسلمونا می‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.86,
   "end": 134.28,
   "text": "در صورتی که اصلا کسی که وارد شده تو حطه اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.28,
   "end": 137.58,
   "text": "خودش رو حتی مسلمان که هیچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.58,
   "end": 142.78,
   "text": "دعاتیشه که هیچی، حزب اللهی که چی، انقلابی هم حتی شاید نشون بده ظاهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.78,
   "end": 145.8,
   "text": "اما نفاقه، نفوذه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.8,
   "end": 148.04,
   "text": "این یه نکته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.04,
   "end": 154.94,
   "text": "نکته بعدی اینه که توجه داشته باشید نفاق در مقابل تقیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.94,
   "end": 161.86,
   "text": "تقیه یعنی حق رو تو دلت، وجودت کتمان میکنی، کفر رو آشکار میکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.86,
   "end": 167.32,
   "text": "نفاق برعکسه. کفر رو یعنی اصلا قبول نداره این حقیقت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.32,
   "end": 172.32,
   "text": "ظاهر سازی کرده. یا شاید یه زمانی قبول کرده الان پشیمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.32,
   "end": 174.04,
   "text": "اما ظاهر رو داره حفظ میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.04,
   "end": 177.18,
   "text": "ظاهر به ایمان باطن به کفر این نف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.18,
   "end": 182.02,
   "text": "این برعکس اونه. تقیه که یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.02,
   "end": 186.06,
   "text": "مهم‌ترین وظایف مؤمنین در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.06,
   "end": 193.02,
   "text": "زمان اختناق و خفقان و اینجور چیزاست که حالا البته در انقلاب ما آقا فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.02,
   "end": 199.18,
   "text": "اصلا رهبر-- حضرت امام رحمة الله علیه فرمودن ما دیگه تو دوران ما دیگه ما تقیه نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.18,
   "end": 206.66,
   "text": "که اون یه بحث مفصلی‌ست. ولی انقدر اون پرده غیبت که من عرض کرده بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.66,
   "end": 209.12,
   "text": "غلظت پیدا کرده بود در زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.12,
   "end": 217.08,
   "text": "خود امام معصوم که تقیه از اوجب واجبات شده بود که حتی اهل بیت لعن می‌کردن کسی بره حقایق ما رو بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.08,
   "end": 219.64,
   "text": "تا جایی که روایت داریم خیلی عجیبه این روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.64,
   "end": 224.04,
   "text": "هم-- همتون شنیدید ها ولی نکته آخرش رو شاید توجه نکرده باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.04,
   "end": 228.3,
   "text": "که امام-- حضرت رسول وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.3,
   "end": 236.82,
   "text": "به جابر بن عبدالله انصاری فرمود که تو فرزند من رو، فرزند پنجم من رو میبینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.82,
   "end": 239.66,
   "text": "سلام منو بهش برسون، امام باقر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.66,
   "end": 244.24,
   "text": "این یه اشتباهی جابر اش-اشتباه استراتژیکی کرده تو تاریخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.24,
   "end": 247.16,
   "text": "این اشتباهش رو معمولا ذکر نمیشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.16,
   "end": 248.74,
   "text": "منبریا. اشتباهش این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.74,
   "end": 250.88,
   "text": "اومد سلام پیغمبر رو رسوند. اما چجوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.88,
   "end": 253.06,
   "text": "تو علن، تو انظار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 253.06,
   "end": 254.98,
   "text": "ظاهرا امام باقر خردسال هم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.98,
   "end": 256.98,
   "text": "توی بازار داشت می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.98,
   "end": 260.94,
   "text": "مردمو جمع کرد در اون زمان خفقان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.94,
   "end": 264.82,
   "text": "که امام سجاد سلام الله علیه مجبور بود معارفو تو قابل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.82,
   "end": 267.74,
   "text": "قالب دعا بیان کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 267.74,
   "end": 270.42,
   "text": "یه دفعه بلند شد گفت آره من مأمورم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.42,
   "end": 273.5,
   "text": "خب اون موقع هم صحابی پیغمبر اکثراً از دنیا رفته بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.5,
   "end": 277.58,
   "text": "شاید حدود شاید فقط بشه گفت جابر بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.58,
   "end": 281.22,
   "text": "یه جابر دیگه‌ای. چون تو زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.22,
   "end": 287.04,
   "text": "کربلا و امام حسین میگن پنج تا صحابی دیگه از پیغمبر باقی نمونده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.04,
   "end": 293.66,
   "text": "حالا تو اون وضعیت که خیلی بر جابر احترام قائل بودن حتی بعضیا تلقی‌شون اینه که از یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.66,
   "end": 298.46,
   "text": "مثلا از یه مرجع تقلید که حتی از رهبر الان ما هم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.46,
   "end": 302.88,
   "text": "بالاتر، یه همچین عظمتی براش قائل بودن مردم بر جابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.88,
   "end": 305.32,
   "text": "تو اون وضعیت اومد گفت آره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.32,
   "end": 308.3,
   "text": "پیغمبر به من فرموده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.3,
   "end": 311.98,
   "text": "پنجمین جانشین من این آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.98,
   "end": 314.88,
   "text": "خبر رسید به امام سجاد. خیلی ناراحت شد حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.88,
   "end": 318.2,
   "text": "تشر زد. جابر رو خواست گفت چرا این کارو کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.2,
   "end": 320.42,
   "text": "مگر تو ندیدی-- اصلا این زبان حال ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.42,
   "end": 323.8,
   "text": "جابر تو ندیدی با حضرت زهرا، امیرالمؤمنین چه کردند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.8,
   "end": 327.64,
   "text": "با ائمه قبل از امام سجاد، با امام حسین چه کردند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 327.64,
   "end": 331.0,
   "text": "این خ-- حالا میخوام منتقل بشم به یه پیامی از اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.0,
   "end": 335.76,
   "text": "اینکه خواص چگونه رفتار کنن خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.76,
   "end": 339.84,
   "text": "من دیدم گاهی اوقات تو بعضی اداره‌جات یا حتی سازمان‌ها یا حتی اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.84,
   "end": 342.82,
   "text": "یه چیزایی رو، فرم‌هایی رو، تعهدنامه‌ها رو میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.82,
   "end": 345.4,
   "text": "آقا امضا بزن افشاء اطلاعات نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.4,
   "end": 348.48,
   "text": "ولی این فرم‌ها رو به گونه‌ای تنظیم کردن که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.48,
   "end": 353.12,
   "text": "اگر یه آدمی نفوذ کرد اومد نشست بالا سر این فرم‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.12,
   "end": 355.44,
   "text": "یعنی تو اون تسدی نشست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.44,
   "end": 357.94,
   "text": "متصدی اونجا شد. نفوذ کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.94,
   "end": 361.36,
   "text": "منافق بود اومد. مگه نیست الان تو کشور ما تا دلت بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.36,
   "end": 364.82,
   "text": "اون بعد نشست. نمیتونه از این تعهدات سوء استفاده کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.82,
   "end": 371.55,
   "text": "خیلی راحت میتونه اصلاً طرف رو میتونه دو دستی ببنده دستشو بیچاره‌ش کنه با بعضی از این تعهدات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.55,
   "end": 375.57,
   "text": "حالا من سر بسته عرض کردم. نفوذ همه جا رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 375.57,
   "end": 377.95,
   "text": "یه جمله‌ای رو عرض کنم اینو خوب دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.95,
   "end": 379.97,
   "text": "این ظرافت‌ها رو تو خدا دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.97,
   "end": 382.27,
   "text": "حضرت زهرا سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.27,
   "end": 386.11,
   "text": "بعد از شهادت پیغمبر یه جمله طلایی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 386.11,
   "end": 388.75,
   "text": "البته تمام خطبه خانم طلاییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.75,
   "end": 391.23,
   "text": "این نکته اولیش رو هم دقت کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.23,
   "end": 395.55,
   "text": "فرمود شیطان سر از لانه خود بیرون آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.55,
   "end": 399.77,
   "text": "نگاه کرد شما رو آماده‌ی دعوت خودش دید دعوت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 399.77,
   "end": 406.73,
   "text": "این نکته خیلی طلاییه. تا خواص گرا ندن به دشمن، به شیاطین روزگار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.73,
   "end": 409.25,
   "text": "یعنی نرن تو ج-جبهه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.25,
   "end": 416.01,
   "text": "نفاق و دو رویی و دو دستگی و ارزش‌ها رو نبازن و اصول رو نبازن شیطان چجوری جرات کنه بیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.01,
   "end": 418.67,
   "text": "شیاطین روزگار. حالا من مثال می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.67,
   "end": 422.75,
   "text": "اون آقایی که حالا ما به حرمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 422.75,
   "end": 427.89,
   "text": "خیلی چیزها و شاید نان و نمک انقلاب حرمت نگه می‌داریم و الا نمیگفتم اون آقایی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.89,
   "end": 432.19,
   "text": "اون آقایی که میاد تمام مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.19,
   "end": 435.01,
   "text": "مسئولین رو جمع میکنه بعد توی تریبونش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.01,
   "end": 437.11,
   "text": "تو فضاهام پیچید صدای ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.11,
   "end": 439.49,
   "text": "حتی س-- تصویرشو من دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 439.49,
   "end": 441.71,
   "text": "علناً اعلام میکنه که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.71,
   "end": 447.77,
   "text": "کشورهایی پیشرفت کردن که بودجه نظامی‌شون رو حذف کردن گذاشتن برای فرهنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.77,
   "end": 450.91,
   "text": "و من امیدوارم در دولت آقای فلانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.91,
   "end": 454.95,
   "text": "این اتفاق بیفته که مثلاً دیگه سپاه موشک نسازه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 454.95,
   "end": 457.75,
   "text": "بعد همه سوت و کف و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.75,
   "end": 462.23,
   "text": "خب این، این گرا دادن این آدمای خواص اینطوری، اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.23,
   "end": 466.13,
   "text": "ش-شیطان نگاه میکنه میبینه خب این آقا آماده‌ست پذیرششو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 466.13,
   "end": 468.59,
   "text": "بفرمایید، بفرمایید تو جبهه‌ی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.59,
   "end": 472.41,
   "text": "میره یه ملتی هم با خودش میبره و بیچاره میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.41,
   "end": 475.87,
   "text": "این نفوذها، این نفاق‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 475.87,
   "end": 478.69,
   "text": "از همون جایی صورت گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 478.69,
   "end": 482.19,
   "text": "که این خواص ما متزلزل شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 482.19,
   "end": 485.97,
   "text": "و نه تشخیص ندادن تکلیفشون چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 485.97,
   "end": 491.07,
   "text": "که البته عرض کردیم اشکال اصلی بر می‌گرده به اینکه امام رو خوب نشناختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.07,
   "end": 495.55,
   "text": "الان اینام که دور رهبر عزیزم دیروز عرض کردم دیروز، روز گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 495.55,
   "end": 497.97,
   "text": "جایگاه ولایت فقیه رو نمی‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 497.97,
   "end": 501.43,
   "text": "نه همشون، خیلیاشون. و الا اینطوری رفتار نمی‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 501.43,
   "end": 505.05,
   "text": "اینا جایگاه ولایت فقیه رو به عنوان ادامه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 505.05,
   "end": 507.25,
   "text": "ولایت پیغمبر درک نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 507.25,
   "end": 509.45,
   "text": "لذا ولایت فقیه هنو در غیبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.45,
   "end": 517.43,
   "text": "نه فقط امام عصر، جایگاه ولایت فقیه تو ملت، تو کشور ما در غیبت به سر می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.43,
   "end": 524.49,
   "text": "اینو میشه ثابت کرد. لذا یکی مثل سید حسن نصرالله، آقای سیستانی، این سینه چاکان و علمداران اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 524.49,
   "end": 527.73,
   "text": "سر تعظیم در برابر جایگاه ولایت فقیه فرود میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 527.73,
   "end": 530.47,
   "text": "ما هی اما، اگر، چرا فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.47,
   "end": 535.23,
   "text": "خدا عاقبتمون رو ختم به خیر کنه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 535.23,
   "end": 537.63,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.63,
   "end": 540.95,
   "text": "على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}