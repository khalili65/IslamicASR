   "title": "## وطن بدون ملک",
   "start": 0.52,
   "end": 72.36
  },
  {
   "index": 1,
   "title": "## نوسان حال و پرسش از نفاق",
   "start": 72.36,
   "end": 140.76
  },
  {
   "index": 2,
   "title": "## پاسخ امام صادق و پیامبر",
   "start": 140.76,
   "end": 270.34
  },
  {
   "index": 3,
   "title": "## ملائکه و تقویت جنبهٔ عقلی",
   "start": 270.34,
   "end": 348.22
  },
  {
   "index": 4,
   "title": "## آیهٔ شهد الله و چهار دسته",
   "start": 348.22,
   "end": 437.45
  },
  {
   "index": 5,
   "title": "## کار عقلی در برابر خیال",
   "start": 437.45,
   "end": 561.77
  },
  {
   "index": 6,
   "title": "## نهیب دربارهٔ جایگاه علمی",
   "start": 561.77,
   "end": 631.67
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.52,
   "end": 5.06,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.06,
   "end": 8.86,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.86,
   "end": 13.12,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.12,
   "end": 20.36,
   "text": "بعضیا گمان می‌کنند برای اینکه جای وطن انسان بشه لاجرم باید حتما اونجا خونه بخرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.36,
   "end": 25.7,
   "text": "و مالک یه ملکی، خونه‌ای چیزی باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.7,
   "end": 29.4,
   "text": "یا برای وطن دوم‌شون یا وطن شغلی‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.4,
   "end": 33.06,
   "text": "اونجا حتما یه مغازه‌ای به نامشون باشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.06,
   "end": 39.68,
   "text": "اینطوری نیست. تمام مراجع فرمودن نیازی به داشتن ملک نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.68,
   "end": 45.54,
   "text": "همین که شما اونجا اسکان داری ولو به استیجاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.54,
   "end": 54.78,
   "text": "یا حتی یه مدت طولانی مهمان حتی کسی باشی، یه جایی ولی قصد داری دیگه اونجا بمونی و اونجا رو وطن خودت قرار بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.78,
   "end": 56.36,
   "text": "ولی فعلا جایی رو نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.36,
   "end": 59.92,
   "text": "فعلا مثلا مهمان طبقه دوم خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.92,
   "end": 64.82,
   "text": "فامیلت، رفیقت خالیه، فعلا اونجایی حتی یه جایی هم اجاره هم نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.82,
   "end": 72.36,
   "text": "توجه کردی؟ همین که قصد کردی جایی بمونی، اونجا دیگه وطنت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.36,
   "end": 79.36,
   "text": "در خصوص قلبی که دچار نفاق شده، دیروز یک سوالی رو طرح کردیم و پاسخش رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 79.36,
   "end": 81.5,
   "text": "یه سوال دیگه‌ای رو هم امروز طرح کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.5,
   "end": 85.6,
   "text": "اونم اینه که گاهی اوقات میشه ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.6,
   "end": 90.76,
   "text": "البته خیلی هم پیش میاد، دلایل متعددی هم داره که به جاش باید بحث بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 90.76,
   "end": 94.1,
   "text": "حالمون هی فراز و نشیب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.1,
   "end": 96.56,
   "text": "یه روز خوبیم، یه روز بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.56,
   "end": 101.34,
   "text": "وقتی تو هیئتیم، در جماعت اهل ایمانیم، تو مسجдим،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.34,
   "end": 103.56,
   "text": "در محضر یه عالمیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.56,
   "end": 105.78,
   "text": "یک آدم عارفیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.78,
   "end": 108.6,
   "text": "حتی اون‌هایی که محضر پیغمبر بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.6,
   "end": 110.58,
   "text": "اینو حالمون خیلی خوب و خوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.58,
   "end": 120.34,
   "text": "اینطوری هست. البته اینم پیش میاد که گاهی اوقات آدم تو اینجور جاها هم حالش بد باشه، این دیگه خیلی فاجعه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.34,
   "end": 122.48,
   "text": "اما معمولا تو اینجور جاها حال ما خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.48,
   "end": 126.52,
   "text": "حرم که میریم خیلی حالمون خوش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.52,
   "end": 130.04,
   "text": "وقتی که از اینجا فارغ میشیم حالمون بد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.04,
   "end": 136.26,
   "text": "اصلا دیگه اون آدم نیستیم. وقتی از هیئت میایم بیرون میریم تو کسب و کاسبی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.26,
   "end": 139.66,
   "text": "محیط کارمون و اجتماع و اینا دوباره حالمون بد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.66,
   "end": 143.26,
   "text": "آیا-- این سؤال اینجاست که آیا این نشان نفاقه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.26,
   "end": 145.86,
   "text": "خب آدم دوگانه میشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.86,
   "end": 148.66,
   "text": "به قولی دو دل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.66,
   "end": 152.54,
   "text": "اونی نیست که اونجا بود. این سؤال خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.54,
   "end": 159.62,
   "text": "جالبه که بدونید همین سؤالو هم از پیغمبر و هم از امام صادق علیهم الصلاة والسلام پرسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.62,
   "end": 164.3,
   "text": "از امام صادق صلی الله علیه این چنین پرسیدن که آقا ما حالمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.3,
   "end": 167.64,
   "text": "خیلی فراز و نشیب پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.64,
   "end": 169.38,
   "text": "آیا این نشانه نفاقه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.38,
   "end": 172.74,
   "text": "حضرت سریع فرمودن همین که دلنگرانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.74,
   "end": 175.06,
   "text": "این نشونه‌ایه که نفاق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.06,
   "end": 179.92,
   "text": "این خودش کُده. دلنگرانی که نکنه نفاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.92,
   "end": 185.02,
   "text": "این نشونه‌ایه که نفاق نیست. نفاق یعنی اصن طرح‌ریزی می‌کنی، برنامه‌ریزی می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.02,
   "end": 187.68,
   "text": "اصن می‌خوای که اینطوری باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.68,
   "end": 189.68,
   "text": "از پیغمبر چطوری پرسیدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.68,
   "end": 194.02,
   "text": "پرسیدن که آقا ما وقتی پیش شماییم حالمون خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.02,
   "end": 197.9,
   "text": "به محض اینکه میریم تو بازار و کار و کسب و این‌ها حالمون بد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.9,
   "end": 200.58,
   "text": "اون حالی که پیش-- حالا شاید نگفتن بد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.58,
   "end": 204.2,
   "text": "میگن اون حالی که پیش شما بودیمو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.2,
   "end": 211.2,
   "text": "پیغمبر فرمودن که اگر شما-- یه نکته بسیار مهمی رو اینجا پیغمبر اشاره کردن که خودش یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.2,
   "end": 215.98,
   "text": "مدخل ورودی به یک بحث بسیار مهم و فهم عمیقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.98,
   "end": 220.26,
   "text": "که من معمولا ندیدم اینجا رو مورد توجه قرار بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.26,
   "end": 222.86,
   "text": "میگن میرن روایتو، اونجا کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.86,
   "end": 229.56,
   "text": "اینکه پیغمبر فرمود اگر اون حالی که محضر ما هستید رو بتونید حفظش کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.56,
   "end": 234.14,
   "text": "وقتی هم که از ما فارغ شدید، اگر بتونید حفظش کنید یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.14,
   "end": 241.26,
   "text": "ان الذین قالوا ربنا الله اون ثمة تقاموا رم بتونید رعایت کنید، استقامت بخرجید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.26,
   "end": 243.42,
   "text": "صراحت آیه قرآن چیه بعدش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.42,
   "end": 245.4,
   "text": "تتنزل علیهم الملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.4,
   "end": 250.54,
   "text": "اون آیه ش گفتار پیغمبره فرمود اگر بتونید خودتونو حفظ کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.54,
   "end": 255.56,
   "text": "ملائکه نازل میشن با شما مصافحه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.56,
   "end": 258.8,
   "text": "همینو میگیم رد میشیم. یا حالا این خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.8,
   "end": 264.98,
   "text": "یک دلیله که بر-- پس سؤال جواب داده شد تا حدودی که نه، این نشانه نفاق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.98,
   "end": 270.34,
   "text": "این نشانه غفلته. باید مراقب باشیم، غافل نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.34,
   "end": 276.12,
   "text": "اما اون خیلی نکته مهمیه که پیغمبر فرمود ملائکه میان با شما مصافحه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.12,
   "end": 278.56,
   "text": "ملائکه جنسشون چیه عزیزانی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.56,
   "end": 281.7,
   "text": "عالم مجرداتن دیگه، عقولن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.7,
   "end": 283.56,
   "text": "عقل م-- اونا عقل محضن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 283.56,
   "end": 289.94,
   "text": "جنسشون عقله. اینکه پیغمبر می‌فرمود ملائکه به شما نازل میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 289.94,
   "end": 300.54,
   "text": "یعنی اگر بتونید در مسیر ما مراقب غفلت باشید در راه ما چه در ه-حضر، چه در سفر، چه در حضور، چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.54,
   "end": 307.9,
   "text": "جلوت، چه در خلوت همیشه مراقب باشید دچار غفلت نشید، همیشه در حالت حضور باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 307.9,
   "end": 312.44,
   "text": "یعنی شما جنبه عقلیتون تقویت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 312.44,
   "end": 318.78,
   "text": "جنبه عقلی شما که تقویت شد آثارش میشه تنزل الملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 318.78,
   "end": 323.72,
   "text": "تتنزل علیهم الملائکه بر ایشان ملائکه نازل می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 323.72,
   "end": 327.56,
   "text": "ملائکه هرجا که نمیرن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 327.56,
   "end": 329.54,
   "text": "مل-ملائکه جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.54,
   "end": 334.18,
   "text": "نازل میشن که بحث، بحث عقلیه، بحث علمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 334.18,
   "end": 336.18,
   "text": "اصن عقلو خدا اومده داده برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 336.18,
   "end": 340.6,
   "text": "رشد علمی. اگه بخوای حالت بد نشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.6,
   "end": 343.96,
   "text": "برو سراغ کار عقلی. برو سراغ کار علمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 343.96,
   "end": 346.18,
   "text": "این اون نکته ظریفیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 346.18,
   "end": 348.98,
   "text": "بهش توجه نمیشه. آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 348.98,
   "end": 351.76,
   "text": "هجده سوره آل عمران رو برید ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 351.76,
   "end": 354.72,
   "text": "جزو اون چهار تا دسته آیاتیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 354.72,
   "end": 359.58,
   "text": "که عرض کردیم شیخ حر عاملی تو وسائل شیعه‌ش میگه وقتی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 359.58,
   "end": 366.3,
   "text": "دستور نزول قرآن داد، این چهار دسته به عرش معلق موندن، به خدا گلایه کردن که قدر ما رو نمی‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.3,
   "end": 369.47,
   "text": "پیداست خیلی اینا با عظمتن این چهار دسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 369.47,
   "end": 374.59,
   "text": "که خدا فرمود برید هرکس بعد از هر نمازش شما رو بخونه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 374.59,
   "end": 376.57,
   "text": "هر روز هفتاد بار نگاهش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 376.57,
   "end": 380.67,
   "text": "در هر نگاه هفتاد حاجتش رو روا می‌کنم که این باید بحث بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 380.67,
   "end": 383.03,
   "text": "این نگاه چیه؟ حاجت‌ها چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 383.03,
   "end": 385.73,
   "text": "یه دستش این آیه هجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 385.73,
   "end": 389.57,
   "text": "سوره آل عمرانه که شهد الله معروف به آیه شهد الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.57,
   "end": 392.31,
   "text": "شهد الله أنه لا إله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.31,
   "end": 396.71,
   "text": "إلا هو که فرمودن این اسم اعظم اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.71,
   "end": 400.81,
   "text": "والملائكة وعُلُّو العِلْم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 400.81,
   "end": 403.93,
   "text": "البته در تعابیر فرمودن این اول علم اهل بیتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 403.93,
   "end": 407.31,
   "text": "اما وجه اتمش اهل بیتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.31,
   "end": 414.25,
   "text": "هر صاحب خردی هم پیداست کسی که به علم و معرفت دست پیدا کنه همپای کی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 414.25,
   "end": 417.19,
   "text": "والملائكة بعد میگه و اول علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.19,
   "end": 419.31,
   "text": "با ملائکه همسفر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.31,
   "end": 425.37,
   "text": "جالبه در چی؟ در شهادت بر شهد الله که خدا شاهده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 425.37,
   "end": 428.83,
   "text": "که انه لا اله الا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 428.83,
   "end": 433.73,
   "text": "عظیم‌ترین شهادت عالم رو کسی که صاحب علمه باهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.73,
   "end": 436.69,
   "text": "چی میشه؟ هم قطار میشه، همسفر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.69,
   "end": 439.85,
   "text": "چیز کمی نیست. الان کار عقلی چقدر ما داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.85,
   "end": 442.81,
   "text": "آقا جون سؤال، خودم از خودم سؤال کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 442.81,
   "end": 447.89,
   "text": "ما چقدر کار عقلی، تو حاجی جون چقدر کار عقلی و علمی داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 447.89,
   "end": 451.71,
   "text": "چقدر داری برای کارهای مالی و مادی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 451.71,
   "end": 454.45,
   "text": "امرار معاشت و تفریحت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 454.45,
   "end": 457.53,
   "text": "خوش گذرونی و اوقات فراغتت صرف می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 457.53,
   "end": 460.25,
   "text": "خداوکیلی چقدر داری برای کار علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.25,
   "end": 463.35,
   "text": "و عقلی وقت می‌گذاری؟ اصلاً فراری‌اند مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 463.35,
   "end": 466.87,
   "text": "یه عبارتی داره شیخ طوسی علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.87,
   "end": 469.01,
   "text": "خیلی دردناکه این روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.01,
   "end": 474.93,
   "text": "می‌فرماید و کثرت عند الخیالة عرفو اکثر مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 474.93,
   "end": 478.09,
   "text": "خیالاتی‌اند. هم‌نشین با خیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.09,
   "end": 481.07,
   "text": "الان شما بگو آقا ما می‌خوایم خاطره بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.07,
   "end": 486.59,
   "text": "هزار نفر آدم میاد. فیلم پخش کنیم هزار نفر آدم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 486.59,
   "end": 489.79,
   "text": "و وحدت عند العقول اكشف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 489.79,
   "end": 493.69,
   "text": "وحدت، اوحدی، عده قلیلی‌اند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.69,
   "end": 497.11,
   "text": "دنبال کشف عقلی و علمی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 497.11,
   "end": 501.91,
   "text": "شما کار علمی بکن. تو منبرت بیا بحث علمی، برهان ارائه بده فرار می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 501.91,
   "end": 504.29,
   "text": "بابا این چی میگه حاجی دیونه ما رو بی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 504.29,
   "end": 508.59,
   "text": "کار گیر آورده. اینجا رو کرده کلاس درس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 508.59,
   "end": 512.25,
   "text": "آقا یه داستان بگو، یه مثل به قول اساتید ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.25,
   "end": 518.65,
   "text": "وقتی طرف میگه آقا من نفهمیدم یه مثال بگو یعنی رفته تو عالم مثال و خیالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.65,
   "end": 520.53,
   "text": "نمی‌فهمه کار عقلی نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 520.53,
   "end": 522.33,
   "text": "مثال بگو یعنی من نمی‌فهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 522.33,
   "end": 525.21,
   "text": "مثل بزن. قرآن هم متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 525.21,
   "end": 527.59,
   "text": "انقدر ما فهممون امثال من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.59,
   "end": 531.03,
   "text": "کم بوده. می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.03,
   "end": 535.65,
   "text": "کذلک نضرب الأمثال للناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 535.65,
   "end": 538.85,
   "text": "خدا همش ضرب مثل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.85,
   "end": 541.05,
   "text": "تازه باز می‌فرماد همینم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.05,
   "end": 544.35,
   "text": "همین مثل‌هایی هم که خدا تو قرآن میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.35,
   "end": 548.23,
   "text": "لا يعقلها الا العالم، عامل، عالمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 548.23,
   "end": 550.67,
   "text": "فقط علما می‌فهمن، تعقل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.67,
   "end": 553.81,
   "text": "همین ضرب مثال، مثال‌هایی که قرآن هی میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 553.81,
   "end": 559.17,
   "text": "که ما بفهمیم بازم همینه. کار عقلی، کار علمی کردن کو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 559.17,
   "end": 561.31,
   "text": "تو هیأت‌ها، تو جلسات، تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 561.31,
   "end": 564.59,
   "text": "لذا من ختم کلامو یه نکته‌ای حالا نهیب‌وار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 564.59,
   "end": 571.55,
   "text": "به همه شما عرض می‌کنم که اصلاً و ابداً شما مدیون صاحب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.55,
   "end": 579.03,
   "text": "جایگاه هستید که اگر بخواهید به امثال من و این‌ها به نگاه یک آخوند بازاری که بیاد چهار تا کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 579.03,
   "end": 582.15,
   "text": "مثلاً احکامی بگه که خودتم تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.15,
   "end": 584.67,
   "text": "تحریر الوسیله می‌تونی ببینی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 584.67,
   "end": 588.87,
   "text": "وقتتو بگیره تا حدیث بگه و نماز بخونه و بگه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.87,
   "end": 591.55,
   "text": "مدیونی اگه بخوای اینطوری نگاه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.55,
   "end": 596.53,
   "text": "اگر فکر می‌کنید کسی که اینجاست هرکی می‌خواد باشه منم یا هر کس دیگه‌ای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 596.53,
   "end": 599.93,
   "text": "اون جایگاه عقلی و علمی رو نداره سریع عوضش کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 599.93,
   "end": 603.99,
   "text": "بگید آقا یکی دیگه بیاد از جهت علمی به ما رشد بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.99,
   "end": 609.87,
   "text": "اگر این کارو نکنی به خودت خیانت کردی، به منم خیانت کردی، به همه خیانت کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 609.87,
   "end": 614.81,
   "text": "و فاجعه اونجاست که بیایم بشینیم بگیم بابا این بحث‌ها سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 614.81,
   "end": 617.83,
   "text": "نمی‌دونم ثقیله. این بحثا مال کلاس درسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 617.83,
   "end": 619.91,
   "text": "ولش کن حاجی آقا یه حدیث بگو بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 619.91,
   "end": 623.51,
   "text": "این دیگه خیلی فاجعه میشه. ان‌شاءالله عاقبت ما ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 623.51,
   "end": 626.69,
   "text": "به برکت صلوات بر محمد آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 626.69,
   "end": 631.67,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}