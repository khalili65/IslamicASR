  {
   "index": 5,
   "title": "## رضای اباعبدالله در گودی قتلگاه",
   "start": 484.96,
   "end": 680.32
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.32,
   "end": 2.62,
   "text": "آه و ربانی آیه عسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.62,
   "end": 8.3,
   "text": "استفتاء شده که از رهبر عزیزمون که اگر بچه‌ای که غالباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.3,
   "end": 14.96,
   "text": "نجس می‌کنه بالاخره به قول قدیمی‌ها جیش می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.96,
   "end": 18.86,
   "text": "و این دستش مثلاً تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.86,
   "end": 20.78,
   "text": "این ور اون ور حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.78,
   "end": 25.1,
   "text": "دستشو گاهی میزنه به پاهاش اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.1,
   "end": 28.5,
   "text": "این دستی که تره بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.5,
   "end": 31.06,
   "text": "رطوبت رو انتقال میده. اینا چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.06,
   "end": 34.98,
   "text": "به فرش خونه میزنه، بازیگوشی می‌کنه این ور اون ور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.98,
   "end": 39.1,
   "text": "آیا نجسه یا نه؟ این حالت مثلا نجس می‌کنه خونه رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.1,
   "end": 42.96,
   "text": "آقا فرمودن که تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.96,
   "end": 50.48,
   "text": "انتقال نجاست قطعییت پیدا نکنه، یعنی شما یقین پیدا نکنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.48,
   "end": 52.72,
   "text": "نجاست منتقل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.72,
   "end": 57.48,
   "text": "محکوم به طهارته. اینو توجه داشته باشید که اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.48,
   "end": 62.04,
   "text": "در نجس و پاکی خیلی سخت نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.04,
   "end": 64.98,
   "text": "اسلام در گناه خیلی سخت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.98,
   "end": 70.04,
   "text": "خیلی در گناه، نجاست درونی اون رو خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.04,
   "end": 74.54,
   "text": "سخت می‌گیره. چون قراره که فرش‌ها بره برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.54,
   "end": 79.44,
   "text": "انشاالله تطهیر و شستشو خیلی مختصر‌تر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.44,
   "end": 84.4,
   "text": "صحبت کنم. همیشه ده دقیقه حرف می‌زنیم امروز پنج دقیقه حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.4,
   "end": 86.04,
   "text": "اگرچه موضوع مهم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.04,
   "end": 90.2,
   "text": "یکی از راه‌های رسیدن به قلب معروف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.2,
   "end": 93.04,
   "text": "رضایت به قضای الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.04,
   "end": 96.04,
   "text": "رضایت به قضا. قضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.04,
   "end": 99.46,
   "text": "جالبه که دقت توجه می‌کردم یکی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.46,
   "end": 104.12,
   "text": "صحیفه حضرت زهرا سلام الله علیها که البته از بهار جلد هشتاد و سه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.12,
   "end": 108.02,
   "text": "دعا رو آورده از حضرت صدیقه طاهره یه دعایی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.02,
   "end": 110.36,
   "text": "در این دعا حضرت زهرا از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.36,
   "end": 113.62,
   "text": "تقاضا می‌کنند که \"و اسئلک الرضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.62,
   "end": 119.48,
   "text": "بالقضاء\". جالبه رضایت در قضای الهی رو طلب می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.48,
   "end": 126.58,
   "text": "دو مرتبه در یه دعای دیگه‌ای که شیخ جعفر بن احمد قممی میاره، کتاب عروس از امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.58,
   "end": 131.52,
   "text": "صلوات الله علیه روایت میاره برای سحر شب‌های جمعه است دو مرتبه اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.52,
   "end": 134.48,
   "text": "\"والرضا بالقضاء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.48,
   "end": 137.26,
   "text": "البته اونجا \"والقدر\" رو هم اضافه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.26,
   "end": 142.74,
   "text": "یه دعای دیگه‌ای هم هستش که مرحوم کلینی اعلا الله مقامه الشریف در اصولش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.74,
   "end": 147.78,
   "text": "اصول کافی از امام جواد صلوات الله علیه نقل کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.78,
   "end": 151.1,
   "text": "اون عبارت رو حضرت آیه الله مستنزه هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.1,
   "end": 154.42,
   "text": "رساله ربا الله‌شون توصیه کردن بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.42,
   "end": 160.22,
   "text": "اونجا هم امام جواد صلوات الله علیه از خدا خواهش می‌کنه که \"و اسئلک الرضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.22,
   "end": 164.88,
   "text": "بالقضاء\". البته این یه تیکه از دعاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.88,
   "end": 169.76,
   "text": "مقصود. حالا قضا فرقش با قدر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.76,
   "end": 174.44,
   "text": "یه توضیح کوچولویی تو این فرصت کوتاه بدم که البته خیلی بحث عمیقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.44,
   "end": 178.02,
   "text": "قضا و قدر یه بحث بسیار گسترده‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.02,
   "end": 181.32,
   "text": "اعتقادی‌ست که بزرگان رساله‌ها هم براش نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.32,
   "end": 186.16,
   "text": "خود حضرت آیه الله مستنزه یه رساله بر مبنای قضا و قدر دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.16,
   "end": 193.12,
   "text": "ببینید قضا ما گفتیم که قلب معروف توجه به مقام جمعی عالمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.12,
   "end": 198.62,
   "text": "مقام جمعی مثل مثلا انسان کامل که مقام جمعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.62,
   "end": 201.7,
   "text": "بعد مثلاً قرآن تدوینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.7,
   "end": 205.78,
   "text": "این قرآن میشه شرح تدوینیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.78,
   "end": 209.56,
   "text": "یا شرح نوشتاری و کتبیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.56,
   "end": 213.56,
   "text": "نظام آفاقی میشه شرح عینی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.56,
   "end": 215.88,
   "text": "یعنی مق-- انسان کامل ایشون میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.88,
   "end": 219.94,
   "text": "امام عصر میشه مقام جمعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.94,
   "end": 223.5,
   "text": ". کلاً قضا مقامش مقام جمعی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.5,
   "end": 227.04,
   "text": "به عبارتی لفظ جمع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.04,
   "end": 230.52,
   "text": "جمع، متن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.52,
   "end": 234.22,
   "text": "همه اینا رو اصل همه اینا رو میشه بهش اطلاق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.22,
   "end": 237.62,
   "text": "در حالی که قضا-- قدر نه، قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.62,
   "end": 245.04,
   "text": "شرح اون متنه. قدر مقام تعیین و تشخص قضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.04,
   "end": 249.02,
   "text": "یعنی در متن خارج مشخص می‌کنی چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.02,
   "end": 252.18,
   "text": "مصداق بهش میدی. این فرقشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.18,
   "end": 261.8,
   "text": "مثال؛ جالبه که حالا ابا عبدالله در گودی قتلگاه بعد از اون مصیبت سنگین و آمادگی برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.8,
   "end": 268.64,
   "text": "حالا اسارت خاندانشون هم می‌فرماید \"الهی رضاً بقضائک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.64,
   "end": 271.6,
   "text": "قضاء الهی رو مورد توجه قرار میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.6,
   "end": 275.98,
   "text": "قضا مثلا خدا حکم کلی می‌کنه که به عنوان نمونه عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 275.98,
   "end": 281.54,
   "text": "ببینید مثلاً اینکه اصلاً تو ریاضیات مثلا یک به علاوه یک می‌شود دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.54,
   "end": 283.56,
   "text": "این یک واحد کلیه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 283.56,
   "end": 286.26,
   "text": "کلیه است. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.26,
   "end": 289.28,
   "text": "اما اینکه مصداق این یک به علاوه یک چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.28,
   "end": 291.4,
   "text": "می‌تونه بی‌نهایت مصداق داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.4,
   "end": 296.08,
   "text": "یک درخت به علاوه یک درخت، یک سیب به علاوه یک سیب، یک انسان به علاوه یک انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.08,
   "end": 300.44,
   "text": "خیلی مصداق داره. اون واحد کلیه رو بهش میگن قضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.44,
   "end": 309.36,
   "text": "مثلا خدا قضای او بر این تعلق گرفته که انسان بعد از طی یک مدت عمر طبیعی بمیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.36,
   "end": 312.88,
   "text": "موت. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.88,
   "end": 315.94,
   "text": "خود موت در کنار حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.94,
   "end": 319.08,
   "text": "که بحث شد قبلاً خلق خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.08,
   "end": 326.36,
   "text": "این قضای الهیه تعلق گرفته که حتما انسان‌ها بمیرن حتی پیغمبر هم بود موت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.36,
   "end": 330.34,
   "text": "خب اما اینکه این موت چگونه حاصل بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.34,
   "end": 333.58,
   "text": "می‌شود قدر الهی. مصداقش چگونه باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.58,
   "end": 338.42,
   "text": "طرف با تصادف بمیره، با مریضی بمیره، با شهادت بمیره، چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.42,
   "end": 341.94,
   "text": "کجا بمیره؟ کی بمیره؟ اینا همه قدره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.94,
   "end": 345.8,
   "text": "و قدر مربوط به لوح محو و اثبات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 345.8,
   "end": 351.08,
   "text": "\"یمحل ما یشاء و یثبت\" دائما در حال تغییره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 351.08,
   "end": 353.5,
   "text": "شب‌های قدر هم اسمش رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.5,
   "end": 358.96,
   "text": "قدره. شب‌های قدر هم این قدر یعنی مصادیق تغییر می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 358.96,
   "end": 364.78,
   "text": "تو لوح محو و اثبات الهی نه تو لوح قضای الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 364.78,
   "end": 367.12,
   "text": "یعنی اینکه میشه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.12,
   "end": 371.26,
   "text": "با گناه مصداق اون قضای کلی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 371.26,
   "end": 375.14,
   "text": "مثلا مرگ رو اگر در نظر بگیریم هر چیزی مریضی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 375.14,
   "end": 378.2,
   "text": "فقر، قنا همه این‌ها مصادیق کلی‌ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 378.2,
   "end": 380.86,
   "text": "یا عرض شود مفهوم کلی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.86,
   "end": 389.98,
   "text": "اینکه کی طرف مریض بشود، چگونه مریض بشود یا شفا بگیرد، چگونه شفا بگیرد، کی، کجا، به چه دارویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.98,
   "end": 395.12,
   "text": "اینا همه قدره. امکان داره که خب اینو خدا قرار داده همه بمیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 395.12,
   "end": 397.38,
   "text": "طبق یک عمر طبیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 397.38,
   "end": 399.58,
   "text": "نهایتش دیگه صد سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.58,
   "end": 403.64,
   "text": "همه قراره منتقل بشن از این نشئه طبیعت به نشئه بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 403.64,
   "end": 408.74,
   "text": "جالبه که عبارت بعدیشو امام جواد صلوات الله علیه چه زیبا می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.74,
   "end": 413.48,
   "text": "از جمله چیزهایی که بعد از رضایت بر قضای الهی از خدا طلب کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.48,
   "end": 415.56,
   "text": "\"وبرکة الموت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.56,
   "end": 419.84,
   "text": "بعد العیش\". مگه موت برکت داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.84,
   "end": 423.06,
   "text": "بله. مورد ارتقای وجودیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.06,
   "end": 431.94,
   "text": "ارتقای وجودی میاره. هم که ارتقای وجودی میاره و تعلق رو می‌کَنه و خروج از عادته و میری به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 431.94,
   "end": 434.0,
   "text": "مرحله‌ی کامل‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.0,
   "end": 435.94,
   "text": "و شدت وجودی پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 435.94,
   "end": 442.38,
   "text": "اینا برکته دیگه. منتها جالبه زمینه‌شو رضای به قضای الهی قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 442.38,
   "end": 446.14,
   "text": "یعنی تو راضی باشی که قراره بمیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 446.14,
   "end": 450.48,
   "text": "راضی باشی اساسا. معمولا مردم کراهت دارن از مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 450.48,
   "end": 452.98,
   "text": "حتی اگر بگی شهادت‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 452.98,
   "end": 455.24,
   "text": "حتی اگر بگی به، به بهترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 455.24,
   "end": 461.22,
   "text": "در صورت کلی به بهترین وجه مردن رو هم اصلا کلا از نفس مردن مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 461.22,
   "end": 463.4,
   "text": "کراهت دارن. حتی مرگ خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 463.4,
   "end": 467.12,
   "text": "چرا؟ چون نمی‌دونن به ارتقای وجودی می‌خوان برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 467.12,
   "end": 470.72,
   "text": "نمی‌دونن شدت وجودی پیدا-- نه، نمی‌دونن سیر تکاملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.72,
   "end": 473.44,
   "text": "نمی‌دونن خروج از عادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 473.44,
   "end": 475.68,
   "text": "نمی‌دونن به قلب مألوف می‌رسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.68,
   "end": 478.92,
   "text": "که بحثش قبلا گذشت تو موضوع موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.92,
   "end": 481.02,
   "text": "حالا قضا اون کلیه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.02,
   "end": 484.6,
   "text": "خدا قرار داده که همه بمیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 484.6,
   "end": 489.4,
   "text": "بعد حالا مثلا قضای الهی قرار گرفته که بمیرن به اعمالت نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 489.4,
   "end": 495.54,
   "text": "حالا این مرگ کی باشه؟ حدیث داریم اون کسایی که بر اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 495.54,
   "end": 498.3,
   "text": "عمر طبیعی می--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 498.3,
   "end": 504.76,
   "text": "عمر طبیعی از دنیا میرن یعنی طبیعتا مثلا قرار بوده هشتاد سال عمر کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.76,
   "end": 508.08,
   "text": "طبیعتا میمیرن. بر اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.08,
   "end": 510.54,
   "text": "مثلا اجل غیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 510.54,
   "end": 514.02,
   "text": "حتمی نمی‌میرن. خب اون‌ها تعدادشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.02,
   "end": 518.56,
   "text": "خیلی کمتر از اوناییه که به خاطر گناه می‌میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.56,
   "end": 520.98,
   "text": "عجب، یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 520.98,
   "end": 526.24,
   "text": "یعنی اکثرا به جهت گناه مرگشون زود می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 526.24,
   "end": 529.22,
   "text": "این مرگشون زود می‌رسه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 529.22,
   "end": 536.1,
   "text": "یعنی قدر. مثلا خدا قرار داده بوده که بنده نود سالگی بمیرم، عمرم هم برکت داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 536.1,
   "end": 538.94,
   "text": "اما یه گناهایی ازم سر می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 538.94,
   "end": 543.22,
   "text": "لوح محو و اثبات، محو میشه نود سالگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 543.22,
   "end": 546.36,
   "text": "مثلا پنجاه سالگی، سی سالگی، بیست سالگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 546.36,
   "end": 548.52,
   "text": "اثبات میشه. یثبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 548.52,
   "end": 552.58,
   "text": "\"یمحل الله ما یشاء ويثبت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.58,
   "end": 557.08,
   "text": "خدا این کارو می‌کنه. برعکس، یه کسی قرار بوده سی سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 557.08,
   "end": 559.34,
   "text": "عمر کنه. قدرش این بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 559.34,
   "end": 562.26,
   "text": "بر اساس قضای الهی که مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.26,
   "end": 565.38,
   "text": "باید حتما بمیره سی سالگی بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.38,
   "end": 569.8,
   "text": "ها؟ یه دفعه یه صدقه سنگین، صدقه خیلی عمر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 569.8,
   "end": 573.86,
   "text": "بهش اضافه می‌کنه. یه صدقه سنگین میده، یهو اون بیست سال، سی سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.86,
   "end": 578.88,
   "text": "مثلا قرار بود سی سالگی بمیره، یهو شصت سالگی براش نوشتن، هفتاد سالگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 578.88,
   "end": 582.34,
   "text": "پس نسبت به اعمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 582.34,
   "end": 584.32,
   "text": "اون قدر جلو و عقب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 584.32,
   "end": 587.86,
   "text": "یا تو قنا، تو فقر، تو مریضی، تو مردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.86,
   "end": 590.92,
   "text": "این‌ها اون کلی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 590.92,
   "end": 596.86,
   "text": "امر کلی حضرت حق که بدون برو برگرده و قطعا حتمی خواهد شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 596.86,
   "end": 600.02,
   "text": "به اون می‌گن قضا که مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 600.02,
   "end": 604.0,
   "text": "متنه. شرحش، مصداقش می‌شه قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 604.0,
   "end": 608.92,
   "text": "اینجا امام جواد صلوات الله علیه در این دعا داره تصریح می‌کنه که حواستون باشه از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 608.92,
   "end": 611.66,
   "text": "رضای به اون قدر رو طلب کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 611.66,
   "end": 614.0,
   "text": "ابی عبدالله صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 614.0,
   "end": 617.78,
   "text": "بله، مرگ براشون مقدر بود اما به چه شکل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 617.78,
   "end": 623.88,
   "text": "به اون شکلی که اونم نه فقط خودش و یارانش مردن، شهید می‌شن، یکی می‌کشه یکی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.88,
   "end": 626.38,
   "text": "اما با زن و بچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 626.38,
   "end": 628.92,
   "text": "زن و بچه‌ت هم باید بیاری. \"ان الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 628.92,
   "end": 632.18,
   "text": "شاء\" ببینید \"ان الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 632.18,
   "end": 634.94,
   "text": "شاء ایّراك قتیلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 634.94,
   "end": 640.18,
   "text": "خدا می‌خواد تو رو به کشته ببینه نه فقط این بلکه زن و بچه‌ات هم اسیر ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 640.18,
   "end": 646.14,
   "text": "این می‌شه قضا. خدا خواست قضای کلی для ابی عبدالله تو گودی قتلگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.14,
   "end": 648.3,
   "text": "دیگه ف-- حرف آخر رو زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 648.3,
   "end": 651.94,
   "text": "تو اون وضعیت تازه نه که بگه تو راه بگه نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.94,
   "end": 659.08,
   "text": "توی اون وضعیت که دیگه اوج مصیبته همه دورشو گرفتن کار تموم شده و قراره زن و بچه برن اسارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 659.08,
   "end": 664.44,
   "text": "می‌گه \"الهی رضا بقضائک وتسلیما لأمرک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.44,
   "end": 669.12,
   "text": "لا معبود سواک یا قیاس المستغيثين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 669.12,
   "end": 672.5,
   "text": "خب این بحث البته نیمه کاره موند اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 672.5,
   "end": 674.6,
   "text": "قول داده بودیم مختصر‌تر حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.6,
   "end": 680.32,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}