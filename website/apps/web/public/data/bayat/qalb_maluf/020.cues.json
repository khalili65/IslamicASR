   "start": 8.36,
   "end": 99.46
  },
  {
   "index": 1,
   "title": "## قلب مألوف؛ طلب تجلی خدا در افعال",
   "start": 99.46,
   "end": 129.76
  },
  {
   "index": 2,
   "title": "## یدالله و رضای فاطمه؛ ارادهٔ الرب",
   "start": 129.76,
   "end": 204.74
  },
  {
   "index": 3,
   "title": "## نافله و حدیث قرب؛ ظهور صمدی",
   "start": 204.74,
   "end": 392.92
  },
  {
   "index": 4,
   "title": "## قوهٔ خیال و کثرت؛ فاجمعنی علیک",
   "start": 392.92,
   "end": 633.24
  },
  {
   "index": 5,
   "title": "## مثال حرم و تطهیر خیال؛ جواب سؤال",
   "start": 633.24,
   "end": 759.24
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.46,
   "end": 5.72,
   "text": "السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.72,
   "end": 8.36,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.36,
   "end": 13.1,
   "text": "امروز شایع شده بعضی چیزها در اجتماع مثلاً اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.1,
   "end": 18.0,
   "text": "میگن لوازم آرایشی که تو این مغازه‌ها اینا داره فروش میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.0,
   "end": 20.98,
   "text": "از بند ناف جنین یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.98,
   "end": 26.92,
   "text": "جنین مرده مثلاً درست شده و این چنین مسائل یا حتی در خصوص دلستر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.92,
   "end": 31.04,
   "text": "یه صحبت‌هایی می‌شه بعضی از چرب‌ها اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.04,
   "end": 34.76,
   "text": "خلاصه یه استفتای کلی از آقا هست که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.76,
   "end": 37.58,
   "text": "چه باید کرد ما در خصوص این‌ها یا اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.58,
   "end": 40.7,
   "text": "به هر حال نجاستشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.7,
   "end": 46.02,
   "text": "رو ما باید رعایت کنیم یعنی نباید خریداری کنیم نباید استفاده کنیم مخصوصاً در خصوص لوازم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.02,
   "end": 49.72,
   "text": "آرایش مثلاً رژ لبی که خانم‌ها استفاده می‌کنند این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.72,
   "end": 52.52,
   "text": "بعضاً خورده می‌شه رو لبه و خورده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.52,
   "end": 54.76,
   "text": "خب اگه قرار باشه نجس باشه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.76,
   "end": 59.28,
   "text": "این دست صحبت‌ها. آقا آب پاکی رو ریختن رو دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.28,
   "end": 62.98,
   "text": "اون کسی که دیگه و این دست استفتائات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.98,
   "end": 68.28,
   "text": "خب خیرت بده آقا. هر روز ما این مشکل رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.28,
   "end": 74.32,
   "text": "این صدا حواس‌ها رو هم پرت می‌کنه و قوه خیال رو به بازیگری می‌گیره اصلاً دیگه بحث پرت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.32,
   "end": 78.42,
   "text": "خیر ببینی. بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.42,
   "end": 83.26,
   "text": "آقا فرمودن که صرف شایعات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.26,
   "end": 87.86,
   "text": "دلیل شرعی بر نجس بودن این دست چیزها نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.86,
   "end": 94.72,
   "text": "و تا به دلایل قطعی از جهت شرعی نجاست چیزی ثابت نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.72,
   "end": 99.46,
   "text": "محکومه به طهارته. تموم شد دیگه خیالتون راحته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.46,
   "end": 107.6,
   "text": "در جمع‌بندی قلب معلوف ما موضوعی رو عرض کردیم که مورد سؤال بعضیا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.6,
   "end": 113.6,
   "text": "چون انشاالله وعده دادیم که ورود کنیم به قلب بعدی، به بیستمین نوع قلب از قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.6,
   "end": 117.58,
   "text": "منتها چون دیدم مورد سؤال واقع شد برای بعضیا اینو یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.58,
   "end": 120.16,
   "text": "مختصری امروز توضیح بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.16,
   "end": 126.94,
   "text": "که گفتیم در رسیدن به مقام قلب معلوف یا اون مقام جمعی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.94,
   "end": 130.78,
   "text": "نگاه دفعی به نظام هستی کردن و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.78,
   "end": 139.0,
   "text": "با دیده عقل که بحثش گذشته به توجه عرفانی که در خصوص توجه عرفانی نکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.0,
   "end": 145.04,
   "text": "به هر حال jeste گریخته‌ای عرض کردیم انسان می‌تواند به جایی برسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.04,
   "end": 150.74,
   "text": "که تمام نظام هستی رو یکپارچه ببیند بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 150.74,
   "end": 152.42,
   "text": "از خدا طلب کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.42,
   "end": 155.1,
   "text": "دقت کنید اینجا مورد سؤال شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.1,
   "end": 158.88,
   "text": "که خدایا تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.88,
   "end": 162.56,
   "text": "در من بدم، تو نفس بزن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.56,
   "end": 165.42,
   "text": "تو صحبت کن، تو گریه کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.42,
   "end": 168.12,
   "text": "تو ناله بزن، تو راه برو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.12,
   "end": 171.64,
   "text": "تو گره باز کن، تو تصمیم بگیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.64,
   "end": 173.78,
   "text": "تو تعقل کن، تو تخیل کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.78,
   "end": 176.08,
   "text": "خدا در تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.08,
   "end": 179.68,
   "text": "این چنین تجلی کنه. این مورد سؤال شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.68,
   "end": 182.0,
   "text": "آقا مگه می‌شه؟ یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.0,
   "end": 186.78,
   "text": "مثلاً طرف سخنرانی داره می‌کنه بگه خدایا تو حرف بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.78,
   "end": 191.36,
   "text": "طرف داره مدعی می‌کنه بگه خدایا تو هم گریه کن هم بگریون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.36,
   "end": 193.18,
   "text": "تو خودت اصلاً اشک بریز، تو ناله بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.18,
   "end": 196.1,
   "text": "اینا یعنی چی؟ اینا چه- چه گونه می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.1,
   "end": 204.74,
   "text": "اینا خیلی راحت تو بعضی از روایات ما که تمثل این حقایق کلیه‌ست بیان شده برای فهم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.74,
   "end": 207.32,
   "text": "مگر همه ما نشنیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.32,
   "end": 211.2,
   "text": "امام عصر يد الله-- امیرالمؤمنین يد الله هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.2,
   "end": 214.68,
   "text": "سیف الله هست. چطوری اونجا گیر نمی‌دیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.68,
   "end": 219.1,
   "text": "مگه اونجا چرا نمیگیم مگه خدا دست داره که مولا شده دستش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.1,
   "end": 223.1,
   "text": "مگه خدا چشم داره که مولا شده عینش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.1,
   "end": 226.34,
   "text": "مگه خدا شمشیر داره که مولا شده سیفش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.34,
   "end": 229.42,
   "text": "سیف الله. چرا اونجا یا اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.42,
   "end": 234.08,
   "text": "رض الله مع رض Fateme فوق این همه این حرف‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.08,
   "end": 239.22,
   "text": "نمیگه رضایت حضرت زهرا سلام الله علیها در رضای خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.22,
   "end": 241.78,
   "text": "بلکه بالعکس هندسه‌ش بالعکسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.78,
   "end": 244.82,
   "text": "میگه رضای خدا در رضای فاطمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.82,
   "end": 247.82,
   "text": "الله اکبر. این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.82,
   "end": 251.92,
   "text": "یا مگه ما در خصوص حالا بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.92,
   "end": 255.5,
   "text": "همین حجت الله بودن و این‌ها بارها نشنیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.5,
   "end": 258.92,
   "text": "که آقا صرفاً نگو امام زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.92,
   "end": 264.42,
   "text": "حجت خداست، مظهر خداست، بلکه بگو اراده الرب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.42,
   "end": 270.36,
   "text": "یعنی چی؟ یعنی امام عصر اراده می‌کند، خدا اراده کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.36,
   "end": 274.6,
   "text": "این یعنی اراده الرب. خب این چطور اینجور جاها ما چونه‌چرا نمی‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.6,
   "end": 279.8,
   "text": "ولی اینجا تا می‌خوایم بگیم من دارم حرف می‌زنم از خدا خواستم خدا حرف بزنه به جای من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.8,
   "end": 281.74,
   "text": "اصلاً خدا در من تجلی کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.74,
   "end": 285.86,
   "text": "مگه ما نگفتیم همه چیز ظهور و بروز حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.86,
   "end": 290.0,
   "text": "حتی شیطان هم به یک معنا ظهور و بروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.0,
   "end": 294.68,
   "text": "اسم مبدل خداست. البته اون اسماء فعلیه حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.68,
   "end": 297.46,
   "text": "به ذات حضرت حق برنمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 297.46,
   "end": 301.52,
   "text": "اون در پس اعمال انسان‌ها خودشو نشون میده، به فعلیت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.52,
   "end": 305.64,
   "text": "که قبلاً چون صحبتش گذشته دیگه به ذهن شما باید آشنا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.64,
   "end": 308.36,
   "text": "مگر حدیث نداریم این حدیثو چی میگید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.36,
   "end": 315.08,
   "text": "مگر حدیث نداریم مؤمنی که بر نافله‌ها استمرار بورزه، مداومت کنه نافله‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.08,
   "end": 318.48,
   "text": "خداوند چشمش می‌شه، گوشش می‌شه، قلبش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.48,
   "end": 321.24,
   "text": "ها؟ مگه این حدیثو-- دستش می‌شه، پاش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.24,
   "end": 323.78,
   "text": "این یعنی چی؟ این همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.78,
   "end": 328.62,
   "text": "یعنی اگر شما توحید، توحید صمدی شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.62,
   "end": 333.84,
   "text": "و همه چی رو در عالم ماده هم ظهور حضرت حق دیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 333.84,
   "end": 336.98,
   "text": "توجه کردی نه که بگی این یک چیزی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.98,
   "end": 339.52,
   "text": "که دارد خدا در او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.52,
   "end": 344.22,
   "text": "تجلی می‌کند، در او یعنی او یک چیزی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 344.22,
   "end": 347.28,
   "text": "قبل از تجلی، قبل از ظهور، یک چیزی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.28,
   "end": 348.98,
   "text": "که شده محل ظهور خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.98,
   "end": 352.06,
   "text": "نه اصلاً اون وجودش خودش ظهور حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.06,
   "end": 359.74,
   "text": "مگه این بحث نگذشت؟ پس میگی خدایا تو در من این چنین ظهور کن با کلماتی که دوست داری ظهور کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 359.74,
   "end": 367.52,
   "text": "تو در مادری من، در خونه، در پدری من، در منزلم تو تجلی کن، تو پدر بچه‌های من باش، تو مادر بچه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.52,
   "end": 371.7,
   "text": "می‌شه؟ چرا نمی‌شه این توحید صمدی قرآنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.7,
   "end": 378.32,
   "text": "که اگر دقت بفرمایید جیری هست همه بر می‌گرده به بازیگری قوه خیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 378.32,
   "end": 383.72,
   "text": "حالا انشاالله تو قلب بعدی به این زیاد می‌پردازیم اگرچه قبلاً هم کم نگفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.72,
   "end": 386.66,
   "text": "قلبی که گرفتار شک و تردید می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.66,
   "end": 390.64,
   "text": "مردد می‌شه تا آخر به مردود می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.64,
   "end": 392.92,
   "text": "به جایی که بهش میگن مردود شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 392.92,
   "end": 397.36,
   "text": "قوه خیال چون م-مرتبط به عالم کثرته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.36,
   "end": 399.82,
   "text": "اساساً به قول محقق هلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.82,
   "end": 403.52,
   "text": "محقق طوسی علیه الرحمه قوه خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.52,
   "end": 406.44,
   "text": "مربوط است به عالم کثرت یعنی ماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 406.44,
   "end": 408.58,
   "text": "ماده هم عالم تضاهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.58,
   "end": 411.92,
   "text": "دائماً چون ماده کثرات، کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.92,
   "end": 416.72,
   "text": "این، اون، اون، این، این، همش این، آن، این، آن همه اینا با هم در تضاهمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.72,
   "end": 423.16,
   "text": "گرفتار‌اند و اساساً سیر صعودی ما در س- قوس صعود به همین جهته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.16,
   "end": 428.4,
   "text": "انسان به همین جهت به مدارج عالی می‌رسه که از دل این کثرات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.4,
   "end": 430.44,
   "text": "از دل این تخیلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.44,
   "end": 433.32,
   "text": "می‌خواد برسه به عقل وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.32,
   "end": 435.28,
   "text": "این همه تضاهم در نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 435.28,
   "end": 439.78,
   "text": "یه نماز می‌خوای بخونی پدرت در میاد تا تجمع کنه قوای وجودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.78,
   "end": 443.68,
   "text": "تمرکز کنه. فجمعنی علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.68,
   "end": 445.82,
   "text": "بخدمت توصلنی الیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 445.82,
   "end": 449.2,
   "text": "تو دعای عرفه. فجمعنی علیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.2,
   "end": 454.08,
   "text": "منو مجتمع کن. اگرچه تو از اول این کارو با من کردی، من خراب کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.08,
   "end": 460.12,
   "text": "فطرت الله التي فطر الناس علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.12,
   "end": 462.88,
   "text": "این علیها به کجا بر می‌گرده شما بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.88,
   "end": 467.84,
   "text": "فطرت من و شما ما فظاء ق-- حالا نفس ناطقمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.84,
   "end": 471.48,
   "text": "علیها به کجا بر می‌گرده؟ به فطرت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.48,
   "end": 473.66,
   "text": "همون فطرت که ما مفتوریم بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 473.66,
   "end": 476.64,
   "text": "علیها یعنی بنا، اون مبنا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 476.64,
   "end": 480.98,
   "text": "بستر نفس ناطقه تو فطرت الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 480.98,
   "end": 484.76,
   "text": "فطرت الله. اصلاً جلوه و ظهور و بروز اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.76,
   "end": 487.42,
   "text": "چیزی جز این نیست که اگر یک آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.42,
   "end": 490.38,
   "text": "این ارتباطش قطع بشه، اصلاً وجودی دیگه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 490.38,
   "end": 494.5,
   "text": "تو اصلاً نیستی. لذا میگن همه‌ی عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 494.5,
   "end": 496.76,
   "text": "رو یک وجود واحد ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.76,
   "end": 499.22,
   "text": "این همون توحید صمدیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.22,
   "end": 503.0,
   "text": "که ازش بعضاً حکما به وحدت وجود یاد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.0,
   "end": 505.64,
   "text": "متاسفانه اونایی که نفهمیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.64,
   "end": 510.96,
   "text": "متوجه نشدن جلوی این استوانه‌های توحید مثل حضرت امام هم ایستادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.96,
   "end": 514.2,
   "text": "مثل ایشون هم جلوش ایستادن. ما بعداً شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.2,
   "end": 517.7,
   "text": "نمی‌دونستیم که چرا تفسیر سوره حمد امام تعطیل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.7,
   "end": 525.48,
   "text": "پنج شش جلسه بیشتر. که یه سری علما که اینو نفهمیده بودن که حرف ملا صدرا چیه، می‌گفتن نه حدیث میگه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.48,
   "end": 529.56,
   "text": "نمی‌دونستن که ملا صدرا خودش شرح بر اصول کافی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 529.56,
   "end": 534.24,
   "text": "یعنی همه این احادیث که تو داری میگی شونزده هزار تا حدیث تو اصول کافی اگر هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 534.24,
   "end": 536.54,
   "text": "همه رو ملا صدرا شرح داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 536.54,
   "end": 542.36,
   "text": "ندیده اون؟ چرا حضرت امام هم انقلاب کرد اومد یهو از ملا صدرا گفت، از محی الدین عربی گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 542.36,
   "end": 545.78,
   "text": "چرا اندیشمندان جهان غرب و شرق رو به سفره‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 545.78,
   "end": 548.76,
   "text": "فوستوس الحکم ابن عربی دعوت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 548.76,
   "end": 551.34,
   "text": "چرا مص-- ملا صدرا، چقدر شیخ الرئیس حرف زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 551.34,
   "end": 553.54,
   "text": "اینا گفتن و یه سری علما نامه زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 553.54,
   "end": 555.66,
   "text": "بعداً متاسفانه ما فهمیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 555.66,
   "end": 558.34,
   "text": "چه بلایی سر حکیم ما آوردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 558.34,
   "end": 563.2,
   "text": "مرشد ما آوردن که ما کفن می‌پوشیم میایم و میگیم تو سر ما رو کلاه گذاشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 563.2,
   "end": 567.06,
   "text": "انقلاب تو ما فکر می‌کردیم انقلاب نابیه، نه دوباره شد حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 567.06,
   "end": 569.72,
   "text": "حکمت و نمی‌دونم وحدت وجود و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.72,
   "end": 572.58,
   "text": "نفهمیدن و امام مجبور شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 572.58,
   "end": 574.2,
   "text": "دید انقلاب داره به تلاطم می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.2,
   "end": 578.46,
   "text": "از خارج از کشور نامه زدن از قم و اصفهان به امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 578.46,
   "end": 581.8,
   "text": "علما نامه زدن حتی بعضی از مراجع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 581.8,
   "end": 588.22,
   "text": "نفهمیدن. الحمد لله به برکت وجود امثال حضرت علم حسن زاده‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 588.22,
   "end": 590.8,
   "text": "این تکانه‌هایی کم شد، کم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 590.8,
   "end": 593.8,
   "text": "شاگردان ایشون الحمد لله تبور پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 593.8,
   "end": 598.7,
   "text": "ظهور و بروز کردن تو شهرهای مختلف و مردم الان دیگه الحمد لله ذهن‌ها آشنا شده تا حدودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 598.7,
   "end": 601.3,
   "text": "نه باز صد درصد. مثل اون موقع نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 601.3,
   "end": 603.8,
   "text": "اینا همه کار قوه خیاله. قوه خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 603.8,
   "end": 608.64,
   "text": "هی میره سراغ کثرات، هی اشکال می‌کنه، هی تر-تردید ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 608.64,
   "end": 610.46,
   "text": "اما قوه عقل مربوط به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 610.46,
   "end": 612.5,
   "text": "یک حقیقت کلی مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 612.5,
   "end": 618.24,
   "text": "برهنه از ماده‌ست. که اگر کسی قوه خیالش ختم کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 618.24,
   "end": 622.98,
   "text": "طهارت پیدا کرد، می‌تونه بشینه به توجه عرفانی برسه، به عقل وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 622.98,
   "end": 628.34,
   "text": "تا قوه خیال طهارت پیدا نکرده از اون سه ج-سه جبهه‌ای که قبلاً عرض کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 628.34,
   "end": 630.74,
   "text": "عقل مشوب به وهم و خیاله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 630.74,
   "end": 633.24,
   "text": "و همه چی تو متخیل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 633.24,
   "end": 635.36,
   "text": "مثل اینکه تو می‌خوای نمازم بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 635.36,
   "end": 638.02,
   "text": "میری یه کنجی، یه پستویی، اصلاً برو تو دل حرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 638.02,
   "end": 641.8,
   "text": "اصلاً برو تو ضریح امام رضا درو باز کن از بغل قبر امام رضا وایسا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 641.8,
   "end": 643.96,
   "text": "سکوت محض. برقام همه خاموش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 643.96,
   "end": 646.26,
   "text": "اهدی هم مزاحم‌ت نباشه. نه صدای جنگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 646.26,
   "end": 650.44,
   "text": "جیغ و فریاد بچه‌ها، نه صدای مداح‌ها، نه سخن-- هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 650.44,
   "end": 654.52,
   "text": "یه تسبیحات حضرت زهرا ما جمعی می‌خونیم آقا حواس ما رو پرت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 654.52,
   "end": 656.22,
   "text": "چقدر ما ضعیفیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 656.22,
   "end": 658.98,
   "text": "چقدر. برو بغل قبر حضرت علی ابن موسی الرضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 658.98,
   "end": 661.08,
   "text": "اونجا برقام خاموش. همونجا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 661.08,
   "end": 665.36,
   "text": "به هر حال خلوت محض نمازتو بخون ببینم می‌تونی پرواز کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 665.36,
   "end": 672.82,
   "text": "به خدا قسم، به حق قسم تا قوه خیال تطهیر نشده باشه، همونجا پدرت در میاد با قوه خیالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 672.82,
   "end": 675.2,
   "text": "انقدر اینور اونور می‌کشونت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 675.2,
   "end": 678.86,
   "text": "تو اصلاً نفهمی چیکار کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 678.86,
   "end": 684.0,
   "text": "بازی که نیست که. یک کارخانه‌ایه که خدا تأدی-- تأسیس کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 684.0,
   "end": 687.34,
   "text": "نه من و شما، همه عالم وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 687.34,
   "end": 690.58,
   "text": "هم طبیعت داره، ماده داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 690.58,
   "end": 693.36,
   "text": "یه، یه وجه، یه وجهش عالم مثاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 693.36,
   "end": 695.3,
   "text": "تو هم داری. یه وجهش عالم عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 695.3,
   "end": 698.88,
   "text": "تو هم داری. یه وجهش عالم الاه تو هم داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 698.88,
   "end": 701.52,
   "text": "همه اینا رو داریم باید بازشناسی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 701.52,
   "end": 705.24,
   "text": "اگر کسی ختم کلام به قلب معلوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 705.24,
   "end": 710.48,
   "text": "رسید یعنی ق-کسیه که قوه خیالش تطهیر پیدا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 710.48,
   "end": 713.08,
   "text": "و تونسته به توجه عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 713.08,
   "end": 715.56,
   "text": "بنشینه. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 715.56,
   "end": 718.32,
   "text": "جوابی بود بر اون عزیزانی که براشون خیلی عجیب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 718.32,
   "end": 721.54,
   "text": "یعنی چی؟ چون بعضا پرسیدن حاج آقا این چه حرفیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 721.54,
   "end": 724.2,
   "text": "خ-- تو منبر بری خدا حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 724.2,
   "end": 729.42,
   "text": "بله میشه. چطور امیرالمؤمنین شمشیر می‌زنه خدا می‌زنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 729.42,
   "end": 731.82,
   "text": "چطور حضرت زهرا راضیه خدا راضیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 731.82,
   "end": 734.96,
   "text": "چطور اراده امام حسین اراده خداست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 734.96,
   "end": 737.28,
   "text": "فیا سیوف خذینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 737.28,
   "end": 739.96,
   "text": "شمشیرها منو بگیرید ریختن سر امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 739.96,
   "end": 745.58,
   "text": "و الا کسی جرات نداشت. شمشیرها، ما-- عالم ماده هم جرات نداشت با حجت خدا درگیر شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 745.58,
   "end": 752.9,
   "text": "اینه، قصه اینه. انشاالله که عاقبت ما ختم به خیر باشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 752.9,
   "end": 755.14,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 755.14,
   "end": 759.24,
   "text": "محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}