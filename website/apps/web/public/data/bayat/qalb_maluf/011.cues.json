 ],
 "cues": [
  {
   "i": 0,
   "start": 4.24,
   "end": 6.1,
   "text": "در خصوص کفاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.1,
   "end": 12.62,
   "text": "دقت بفرمایید عزیزان. کفاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.62,
   "end": 16.92,
   "text": "می‌دونید ما یه کفاره جمع داریم که یا در قتل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.92,
   "end": 20.88,
   "text": "قتل عمدی یا در کفاره روزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.88,
   "end": 25.94,
   "text": "حالا شما بفرمایید توجه بفرمایید که آیا این کفاره جمع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.94,
   "end": 32.7,
   "text": "به در حقیقت چه موقعی تعلق می‌گیره و نظر رهبری تو کفاره روزه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.7,
   "end": 37.64,
   "text": "چه موقع تعلق می‌گیره؟ که حالا شما عزیزان هم سؤال کردن اینو خوبه بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.64,
   "end": 40.4,
   "text": "اولاً اون موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.4,
   "end": 44.32,
   "text": "برده آزاد کردن یا بنده آزاد کردن که دیگه ملغی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.32,
   "end": 46.86,
   "text": "الان دیگه بنده‌ای نیست که آزاد بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.86,
   "end": 52.8,
   "text": "و اتفاقاً شما استفتائات رهبر رو هم که ببینید فقط اشاره می‌کنند به همون دو وجهی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.8,
   "end": 55.14,
   "text": "فرمودن سی تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.14,
   "end": 57.98,
   "text": "در حقیقت شصت تا شصت روز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.98,
   "end": 61.5,
   "text": "روزه بگیری که سی و یک روزش پی در پی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.5,
   "end": 65.16,
   "text": "و یا اینکه شصت تا فقیر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.16,
   "end": 67.22,
   "text": "اطعام کنی، سیر کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.22,
   "end": 72.02,
   "text": "حالا این اگر کفاره جمع باشه دو تاشو باید با هم انجام بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.02,
   "end": 81.22,
   "text": "خب م-منتها موضوع اینجاست در کفاره روزه آیا آقا رهبر عزیزمون قائل به کفاره جمع هستند یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.22,
   "end": 86.56,
   "text": "دقت بفرمایید بسیاری از م-مراجع ما می‌گن که اگر با گناه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.56,
   "end": 89.42,
   "text": "با گناه، با فعل حرام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.42,
   "end": 94.24,
   "text": "با فعل حرام و عمداً روزت رو بخوری کفاره جمع تعلق می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.24,
   "end": 97.06,
   "text": "اما رهبری این نظر رو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.06,
   "end": 100.34,
   "text": "رهبری می‌فرمایند که حتی اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.34,
   "end": 105.04,
   "text": "با فعل حرام و عمداً روزت رو بخوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.04,
   "end": 106.88,
   "text": "کفاره جمع ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.88,
   "end": 109.96,
   "text": "می‌تونی یا شصت روز روزه بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.96,
   "end": 113.56,
   "text": "یا اینکه شصت یا \"یا\" داره، نه \"و\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.56,
   "end": 117.06,
   "text": "یا اینکه شصت تا فقیر رو اطعام کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.06,
   "end": 122.66,
   "text": "اما اینجا آقا رهبر وقتی فتوا میدن بعد احتیاط مستحب هم می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.66,
   "end": 128.72,
   "text": "یعنی اگر بخواهی مستحب رو انجام بدی، احتیاط مستحب کنی، خب جمع رو انجام بده اگه توانش رو داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.72,
   "end": 131.22,
   "text": "اینو دقت بکنید. بعضیا اینو نمی‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.22,
   "end": 133.1,
   "text": "من دیدم حتی فتو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.1,
   "end": 135.82,
   "text": "مثلاً مقلد رهبر که داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.82,
   "end": 137.8,
   "text": "کفاره جمع انجام می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.8,
   "end": 140.24,
   "text": "با گناه عمداً مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.24,
   "end": 143.22,
   "text": "جنب شده بود عمداً در ماه رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.22,
   "end": 146.06,
   "text": "افطارش، افطار کرده بود و مجبور مثلاً داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.06,
   "end": 149.92,
   "text": "روزه می‌گرفت بیچاره سی و یک روز پشت سر هم نمی‌دونست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.92,
   "end": 155.88,
   "text": "پس ما حواسمون باشه. امروز به یکی از شیرینی‌های بحث قلب معلوف می‌رسیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.88,
   "end": 162.12,
   "text": "اگر انشاالله جلسات پیش رو خوب توجه کرده باشید امروز به کامتون مثل عسل شیرین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.12,
   "end": 169.54,
   "text": "یکی از مقامات جمعی اول-- البته اون مقام جمعی چون قلب معلوف الفت، امس الفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.54,
   "end": 172.84,
   "text": "قلبیه که گفتیم بشود عرش الرحمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.84,
   "end": 177.14,
   "text": "و توحید صمدیه قرآن رو ببیند از ظواهر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.14,
   "end": 181.24,
   "text": "این آیات و نشانه‌ها به حضرت حق پی ببرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.24,
   "end": 184.34,
   "text": "و همه نظام هستی رو یکپارچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.34,
   "end": 191.9,
   "text": "حق ببیند که این بحث‌ها گذشت، که از تولد انسانی، خروج از عادت، نگاه دفعی به عالم با دیده عقلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.9,
   "end": 198.44,
   "text": "اِ-- به این جاها رسیدیم. نکته دوم زیل همین که در دل اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.44,
   "end": 201.5,
   "text": "بحث ولایت دقت کنید کلامو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.5,
   "end": 204.26,
   "text": "ولایت کلیه الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.26,
   "end": 208.64,
   "text": "اونم مقام جمعی دارد. یعنی تمام ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.64,
   "end": 210.6,
   "text": "دست صاحبان ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.6,
   "end": 214.06,
   "text": "امام عصر ما تمام شئون ولایت رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 214.06,
   "end": 220.06,
   "text": "لذا تمام ولایت داران عالم حتی انبیا زیل امام عصر ما تعریف می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.06,
   "end": 223.26,
   "text": "این مقام جمعی‌ست. هر وقت قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.26,
   "end": 228.38,
   "text": "متوجه حضور امام، تو، تو رو خدا دقت کنید خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.38,
   "end": 234.2,
   "text": "متوجه حضور تام در محضر ولایت کلیه شد به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.2,
   "end": 236.32,
   "text": "قلب معلوف رسیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.32,
   "end": 240.74,
   "text": "یعنی چی؟ اینو برای اینکه درست متوجه بشیم الصاقش بدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.74,
   "end": 243.22,
   "text": "سنجاقش کنیم به بحث‌های جلسه پیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.22,
   "end": 246.58,
   "text": "خوب دل بدید ببینید به کجا می‌رسیم، یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.58,
   "end": 249.32,
   "text": "اتفاقاً تو دعای عهدمون آخرش چی میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.32,
   "end": 252.7,
   "text": "اللهمäkشف هذه الغمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.7,
   "end": 254.68,
   "text": "این پریشانی رو برطرف کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.68,
   "end": 256.28,
   "text": "این غم و غصه رو بردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.28,
   "end": 260.1,
   "text": "به چی؟ بحضور الحجة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.1,
   "end": 263.94,
   "text": "اللهمäkشف هذه الغمة عن هذه الأمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.94,
   "end": 267.52,
   "text": "بحضوره. به حضور امام این پریشانی بر...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.52,
   "end": 272.38,
   "text": "این حضور، حالا ما باید منتظر باشیم تا اون ز-- حضور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.38,
   "end": 276.76,
   "text": "یا ظهور زمانی اون برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.76,
   "end": 280.82,
   "text": "اینجا رو خوب دل بدید. انشاالله قلب معلوف ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.82,
   "end": 283.24,
   "text": "ببینید عزیزان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.24,
   "end": 286.3,
   "text": "می‌خوام خیلی هم طول نکشه برای همین دل بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.3,
   "end": 290.68,
   "text": "عزیزان دلم ببینید ما عرض کردیم که تمام عالم در حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.68,
   "end": 296.24,
   "text": "از نقص به کمال و این نقص به کمال در همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.24,
   "end": 298.62,
   "text": "مراتب عالم ریخته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.62,
   "end": 302.14,
   "text": "در عالم ملکوت گفتیم حرکت ایجادی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.14,
   "end": 304.88,
   "text": "البته این حرکت اشتیاقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.88,
   "end": 313.14,
   "text": "اما در عالم ملک، در عالم ما حرکت استکمالیه که احتیاجی، از رو احتیاجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.14,
   "end": 317.72,
   "text": "شما بفرمایید ببینم چه کسی اینا رو متوجه خروج از نقص به کمال می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.72,
   "end": 320.16,
   "text": "حرکت همه از نقص به کماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.16,
   "end": 326.06,
   "text": "سؤال حضرت علامه حسن زاده حفظه الله تعالی در ابتدای همون دروس معرفت نفسشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.06,
   "end": 331.22,
   "text": "درس ششم به بعد می‌فرما چه کسی اینا رو آگاه می‌کنه که شما از نقص به کمال خَر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.22,
   "end": 335.4,
   "text": "حرکت کن. یک سنگ در رحم کوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.4,
   "end": 337.5,
   "text": "از کجا می‌فهمه باید خانی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.5,
   "end": 345.04,
   "text": "باید مثلاً یک سنگ گرانقیمت و طلا و نقره و مروارید و صدف و چه این‌ها مروارید این‌ها بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.04,
   "end": 348.62,
   "text": "کی اینو متوجه می‌کنه؟ رحمش می‌شه کوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.62,
   "end": 352.4,
   "text": "کی از نقص به... یا یک نبات رو یک دانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.4,
   "end": 355.36,
   "text": "مثلاً خرما رو بکاری، کی بهش درس می‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.36,
   "end": 360.98,
   "text": "که شما بهش گفت و شکوفا که شدی این شکلی بار و برگ بده، این شکلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.98,
   "end": 363.71,
   "text": "میوه بده شکلت اینطوری باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.71,
   "end": 365.81,
   "text": "نکنه تو انگور بدی خرما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.81,
   "end": 369.69,
   "text": "کی اینو بهش آموزش میده؟ چه کسی در ف-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 369.69,
   "end": 373.99,
   "text": "بچه‌ای که در رحم شتره میگه تو شتر به دنیا بیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 373.99,
   "end": 375.73,
   "text": "مبادا یه وقت اسب بشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.73,
   "end": 377.75,
   "text": "و اصلاً هم نمیشه اساساً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.75,
   "end": 380.57,
   "text": "چطور میشه که اینطوریه؟ یا بچه در رحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.57,
   "end": 383.51,
   "text": "مادر، انسان در رحم مادر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.51,
   "end": 385.73,
   "text": "چی بهش آموزش میده که تو این شکلی شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.73,
   "end": 391.67,
   "text": "ببین این همه بچه. اصلاً یه مادر رو تصور کنید بیست تا بچه بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.67,
   "end": 395.01,
   "text": "هر کدومش یه شکله. کاملاً عین هم نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.01,
   "end": 398.15,
   "text": "حتی دوقلوها اینطور نیست که مو نزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.15,
   "end": 401.13,
   "text": "نه. کی به اون میگه تو این شکلی شو، تو این شکلی شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.13,
   "end": 405.85,
   "text": "تو سه تا چله‌ای که تو رحم مادر میگیره تا \"وَنَفَخْتُ فِيهِ مِن رُوحِي\" بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.85,
   "end": 409.47,
   "text": "سه تا چله. چهل روز طول میکشه نطفه بشه علقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.47,
   "end": 412.03,
   "text": "چهل روز طول میکشه علقه بشه مزغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 412.03,
   "end": 414.77,
   "text": "چهل روز طول میکشه مزغه بشه جنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 414.77,
   "end": 417.39,
   "text": "صد و بیست روز. مجموعاً حدود چهار ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 417.39,
   "end": 419.47,
   "text": "حالا \"وَنَفَخْتُ فِيهِ مِن رُوحِي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 419.47,
   "end": 421.83,
   "text": "روح خدا دمیده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 421.83,
   "end": 425.23,
   "text": "این سیر چهل، سه تا چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.23,
   "end": 427.27,
   "text": "روز رو کی بهش تعلیم میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 427.27,
   "end": 429.83,
   "text": "چهل. عجیبه که انسان هم تا چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 429.83,
   "end": 433.85,
   "text": "سالش نشه کامل نیست. همه‌ی انبیا هم چهل ساله کامل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 433.85,
   "end": 439.29,
   "text": "کی این سی رو داده؟ شما غذا رو تا وقتی دست خودته که ببلعی، بخوری، تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.29,
   "end": 442.61,
   "text": "شمایی که هضمش می‌کنی، شمایی که دفعش می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.61,
   "end": 446.17,
   "text": "شمایی که جذبش می‌کنی، این قوای وجودی دست توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 446.17,
   "end": 449.11,
   "text": "نه. کی داره این کارو می‌کنه از درون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 449.11,
   "end": 454.07,
   "text": "تو فقط اختیار داشتی بخوری. لذا اینجا علامه میاد یه اصلی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.07,
   "end": 460.49,
   "text": "القا می‌کند که عزیزم تمام عالم حتی جماد که تو فکر می‌کنی شعور ندارد، جان دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 460.49,
   "end": 465.61,
   "text": "شعور دارد. نه قوه ادراکی دارد بلکه قوه دراکه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 465.61,
   "end": 467.51,
   "text": "دراک است بر وزن فعال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.51,
   "end": 469.73,
   "text": "به شدت درک داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 469.73,
   "end": 472.35,
   "text": "همه‌ی عالم. حالا این نکته‌ی اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 472.35,
   "end": 474.69,
   "text": "نکته‌ی دوم انشاالله دیگه می‌زنیم به خال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 474.69,
   "end": 480.57,
   "text": "به امید حق. اونم اینکه آقا هر مخرجی، یه اصل علمیه در فلسفه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.57,
   "end": 485.81,
   "text": "عرفان که هر، هر خروجی از نقص به کمال یه مخرج می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 485.81,
   "end": 488.81,
   "text": "اینطور نیست که طرف خودش مگه ناقص نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 488.81,
   "end": 492.73,
   "text": "وقتی ناقصه چگونه خارج بشه بره به سمت کمال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 492.73,
   "end": 497.17,
   "text": "ها؟ ناقصه دیگه. ناقص چگونه خارج بشه بره به سمت کمال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 497.17,
   "end": 498.99,
   "text": "اصلاً در ذات او این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.99,
   "end": 502.49,
   "text": "پس یکی از بیرون، از خارج باید این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 502.49,
   "end": 509.03,
   "text": "حرکت رو ایجاد کنه. یه متحرکی می‌خواد که حرکت ایجاد کنه در موجود ناقص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 509.03,
   "end": 512.73,
   "text": "هر خروجی از نقص به کمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 512.73,
   "end": 515.25,
   "text": "مخرج می‌خواهد. به به، به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 515.25,
   "end": 520.85,
   "text": "حالا ببینید به چی می‌رسیم. بریم سراغ آیه‌ی یک سوره حضرت ابراهیم سلام الله عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 520.85,
   "end": 524.87,
   "text": "\"الف. لام. را\". ببینید چقدر شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 524.87,
   "end": 527.25,
   "text": "پیغمبر حواست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 527.25,
   "end": 531.75,
   "text": "این کتابی که ما به تو نازل کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 531.75,
   "end": 537.13,
   "text": "این کتاب رو ما برای این نازل کردیم که \"لِتُخْرِجَ النَّاسَ\"، \"لِتُخْرِجَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 537.13,
   "end": 539.97,
   "text": "تا تو خارج کنی. اونم \"النَّاسَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 539.97,
   "end": 542.69,
   "text": "همه‌ی مردم رو. به سمت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 542.69,
   "end": 545.57,
   "text": "\" مِنَ الظُّلُمَاتِ إِلَى النُّورِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 545.57,
   "end": 549.01,
   "text": "ظلمات نقصه، نور کماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.01,
   "end": 551.33,
   "text": "به اذن ربه. البته به اذن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 551.33,
   "end": 553.93,
   "text": "\"إِلَى صِرَاطِ الْعَزِيزِ الْحَمِيدِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 553.93,
   "end": 555.61,
   "text": "\"الف. لام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 555.61,
   "end": 560.75,
   "text": "را. كِتَابٌ أَنزَلْنَاهُ إِلَيْكَ لِتُخْرِجَ النَّاسَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 560.75,
   "end": 563.01,
   "text": "نکته اول که ازش اومد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 563.01,
   "end": 566.89,
   "text": "اونچه که پیغمبر باهاش ما رو از نقص به کمال می‌بره چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 566.89,
   "end": 569.63,
   "text": "قرآنه. کتاب. دو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 569.63,
   "end": 576.45,
   "text": "مخرج کیه؟ چه کسی داره نظام هستی رو از نقص به کمال می‌بره به توسط قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 576.45,
   "end": 578.65,
   "text": "\"لِتُخْرِجَ\". فعل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 578.65,
   "end": 580.65,
   "text": "مخاطبه به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 580.65,
   "end": 584.71,
   "text": "\"تُخْرِجَ\". تو باید خارج کنی از نقص به کمال همه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 584.71,
   "end": 587.21,
   "text": "همه رو. خوب و بد و نظام هستی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 587.21,
   "end": 589.79,
   "text": "پیغمبر داره سیر می‌کنه به سمت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 589.79,
   "end": 591.81,
   "text": "\"إِلَى صِرَاطِ الْعَزِيزِ الْحَمِيدِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 591.81,
   "end": 594.81,
   "text": "همه رو هم داره به سمت خودش سیر میده، به سمت او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 594.81,
   "end": 597.25,
   "text": "کی پس مخرجه؟ پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 597.25,
   "end": 599.47,
   "text": "خب، نکته‌ی آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 599.47,
   "end": 602.71,
   "text": "پیغمبر که از این دنیا رخت بستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 602.71,
   "end": 606.61,
   "text": "الان در نشئه مرگ کی مخرج ما از نقص به کماله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 606.61,
   "end": 609.41,
   "text": "دائماً آن به آن، نه من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 609.41,
   "end": 612.43,
   "text": "تمام نظام هستی رو داره اخراج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 612.43,
   "end": 615.47,
   "text": "\"يُخْرِجُهُ مِنَ الظُّلُمَاتِ إِلَى النُّورِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 615.47,
   "end": 618.61,
   "text": "کیه؟ حضرت ولی عصر، امام زمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 618.61,
   "end": 621.41,
   "text": "مهدی فاطمه سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 621.41,
   "end": 625.83,
   "text": "الله. اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 625.83,
   "end": 635.03,
   "text": "الله. وقتی این با این دید قلب تو معلوف شد، انس و الفت با اون نظام جمعی ولایت کلیه‌ی الهیه در نظام هستی گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 635.03,
   "end": 638.39,
   "text": "دیگه نمیگی که امیرالمؤمنین، ولایت رو از علی قصد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 638.39,
   "end": 640.45,
   "text": "غلط کردی که میگی ولایت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 640.45,
   "end": 643.95,
   "text": "ریاست رو قصد کردن که امروز دارن سرش دست و پا می‌شکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 643.95,
   "end": 649.19,
   "text": "در حالی که مولا فرمود ریاست از اون چیزی که از دماغ بز وقتی عطسه می‌ریزه بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 649.19,
   "end": 651.43,
   "text": "پیش من بدتره، کثیف تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 651.43,
   "end": 655.97,
   "text": "منزجه. ولایت رو نگرفتن، ولایت جاری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 655.97,
   "end": 662.67,
   "text": "پس اونچه که وقتی شما به این نگاه می‌رسی، می‌بینی که اصلاً ولایت جاری و ساریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 662.67,
   "end": 667.51,
   "text": "کی امام غائبه؟ کی امام نیست که تو دنبال حضورش بگردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 667.51,
   "end": 671.11,
   "text": "ببین \"اللَّهُمَّ كَشِفْ هَذِهِ الْغُمَّةَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 671.11,
   "end": 674.09,
   "text": "عَنْ هَذِهِ الْأُمَّةِ بحضوره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 674.09,
   "end": 679.73,
   "text": "یعنی همین الان نه که منتظر اون زمانی باشی که حالا کی باشه ما باشیم یا نباشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 679.73,
   "end": 682.33,
   "text": "امام عصر پشت به خانه خدا خودشو معرفی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 682.33,
   "end": 686.83,
   "text": "اونم حقه. اما الان، الان این اکتشاف رو انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 686.83,
   "end": 690.53,
   "text": "خدایا در وجود من این توحید رو ایجاد کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 690.53,
   "end": 692.11,
   "text": "قلب معلوف رو به من بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 692.11,
   "end": 697.29,
   "text": "همین الان امامم رو حاضر ببینم در جز جز کائنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 697.29,
   "end": 701.55,
   "text": "که هست، من نمی‌بینم. که اگر رسید به دیدن امام عصر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 701.55,
   "end": 704.01,
   "text": "در و دیوار رو دید امام عصرش رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 704.01,
   "end": 706.27,
   "text": "آسمان و زمین رو دید امام عصرش رو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 706.27,
   "end": 710.89,
   "text": "میگه حضرت حضور داره. این می‌شه همون فرج فردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 710.89,
   "end": 715.85,
   "text": "که اصل اینه که سید ابن طاووس فرمود کی گفته نمیشه امام عصر رو دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 715.85,
   "end": 720.75,
   "text": "هر وقت مشکل و گله، گرای علمی برای من پیش بیاد میرم محضر حضرت و از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 720.75,
   "end": 722.97,
   "text": "حضرت سؤال می‌کنم و جواب می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 722.97,
   "end": 728.31,
   "text": "لذا تمام بزرگان گفتن آثار سید ابن طاووس رو اصلاً حرفی ما جرات نداریم روش بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 728.31,
   "end": 732.48,
   "text": "تا لیتلب معصوم. پس می‌شه. افسانه نیست اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 732.48,
   "end": 736.62,
   "text": "نکته‌ای که از دل این اومد الان بیرون به شما عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 736.62,
   "end": 739.7,
   "text": "حالا ما آماده هستیم برای اصلاً بگو اون حضور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 739.7,
   "end": 741.64,
   "text": "اصلاً بگو حضور مقید به زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 741.64,
   "end": 744.24,
   "text": "آماده هستیم آقا تشریف بیارن میخوان چیکار کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 744.24,
   "end": 747.06,
   "text": "شما بفرمایید آقا تشریف بیارن شما چی ازش می‌خواید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 747.06,
   "end": 749.52,
   "text": "حاج آقا ببخشید میگم حاج آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 749.52,
   "end": 751.56,
   "text": "آقا یه استخاره‌ای برای ما بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 751.56,
   "end": 754.2,
   "text": "امام عصر تشریف آوردید مریض ما را شفا بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 754.2,
   "end": 756.78,
   "text": "آقا چک برگشتی دارم. آقا خونه می‌خوایم آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 756.78,
   "end": 760.4,
   "text": "چی می‌خوایم از آقا؟ در حالی که ختم کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 760.4,
   "end": 763.76,
   "text": "تنمون بلرزه. حضرت تشریف میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 763.76,
   "end": 769.16,
   "text": "اساساً اون اصل و لب کار ایشون، برنامه‌ی اصلی ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 769.16,
   "end": 773.36,
   "text": "انفجار است. سلامٌ هى حتى مطلع الفجر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 773.36,
   "end": 776.1,
   "text": "علامه می‌گه این فجر رو انفجار بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 776.1,
   "end": 778.72,
   "text": "انفجار علم و معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 778.72,
   "end": 781.88,
   "text": "هفتاد و سه حرف از علم رو اگر بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 781.88,
   "end": 784.46,
   "text": "که همش تو سینه حجت خداست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 784.46,
   "end": 789.94,
   "text": "از ازل تا ظهور امام عصر، امام صادق صلی الله علیه فرمود یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 789.94,
   "end": 794.42,
   "text": "یا یک حرف و نیم از همه‌ی این علوم استخراج می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 794.42,
   "end": 797.0,
   "text": "کشف می‌شه، ظهور می‌کنه، بروز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 797.0,
   "end": 801.22,
   "text": "این همه علم که آب و هوا ساختن، می‌رن مثلاً کرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 801.22,
   "end": 804.84,
   "text": "یک حرف هفتاد و دو تاش تو سینه‌ی امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 804.84,
   "end": 809.72,
   "text": "بعد آقا تشریف بیارن بگن آقای فلانی، آقای فلانی آقا تشریف بیارید یه جلسه‌ای داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 809.72,
   "end": 811.6,
   "text": "می‌خوام منفجرت کنم با علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 811.6,
   "end": 815.72,
   "text": "کی حاضره؟ ما علامه حسن زاده رو الان می‌تونیم درک کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 815.72,
   "end": 819.28,
   "text": "چه کردیم با همین شاگردان امام عصرمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 819.28,
   "end": 822.48,
   "text": "آقای جوادی آملی رو می‌تونیم؟ رهبرمون رو می‌تونیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 822.48,
   "end": 824.78,
   "text": "آقای طبا طبایی، علامه طباطبایی رو می‌تونیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 824.78,
   "end": 831.24,
   "text": "آقای علامه طباطبایی خودشون فرمودن حسن زاده را جز امام عصر کسی نشناخت و نخواهد شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 831.24,
   "end": 833.92,
   "text": "ما تو اینا موندیم. تو آثار اینا موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 833.92,
   "end": 836.14,
   "text": "چهار تا حرف عقلی می‌زنیم همه فراری‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 836.14,
   "end": 839.22,
   "text": "بابا ولمون کن. یه حدیث، یه حکم بگو ما بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 839.22,
   "end": 846.02,
   "text": "بعد می‌خوان امام عصر به اون ظهور مقید به زمان تشریف بیارن و هفتاد و دو حرف از علم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 846.02,
   "end": 852.1,
   "text": "که از خزينه‌ی حضرت حق اخذ کرده و ولایت بوی ولایت می‌ده رو به ما بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 852.1,
   "end": 856.92,
   "text": "باید آمادگی داشته باشیم یا نه؟ اینجاست که مرحوم حاجی سبزواری می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 856.92,
   "end": 861.9,
   "text": "اگر کسی عقلش رو به کار ننداخته، ننداخته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 861.9,
   "end": 864.42,
   "text": "به به-- بهشتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 864.42,
   "end": 868.42,
   "text": "به بهشت راهش می‌دن اما مستأجر بهشتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 868.42,
   "end": 873.2,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر باشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 873.2,
   "end": 885.38,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 885.38,
   "end": 886.06,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}