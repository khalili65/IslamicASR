  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 5.32,
   "text": "[سخنگوی 1] السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.32,
   "end": 9.0,
   "text": "آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.0,
   "end": 17.8,
   "text": "استفتاء شده از رهبر عزیزمون که آیا این پوست‌های نازکی که از دست، لب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.8,
   "end": 22.82,
   "text": "بعضا بلند میشه از بدن انسان، این پوست‌ها نجسن یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.82,
   "end": 29.22,
   "text": "رهبر عزیزمون فرمودن که این پوست‌های نازکی که به خودی خود بلند میشه از بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.22,
   "end": 32.44,
   "text": "از لب، از دست یا هر جا از صورت اینا پاک‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.44,
   "end": 39.36,
   "text": "محکوم به طهارن. وقتی نجس میشن که خودت بکنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.36,
   "end": 42.58,
   "text": "که معمولا هم با یک سوزش و درد همراهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.58,
   "end": 47.04,
   "text": "دیده میشه بعضیا به جهت فشارهای عصبی که روشون هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.04,
   "end": 50.76,
   "text": "مثلا نوک این انگشتاشونو می‌خورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.76,
   "end": 52.74,
   "text": "دور ناخوناشونو می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.74,
   "end": 55.2,
   "text": "لبشونو حتی با دندونی اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.2,
   "end": 58.5,
   "text": "این پوست‌هایی که می‌کنن، خودشون می‌کنن اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.5,
   "end": 63.4,
   "text": "که معمولا هم با سوزش و درد همراهه این نجسه حواستون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.4,
   "end": 68.46,
   "text": "باید شستشو داده بشه دهن و اون قسمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.46,
   "end": 72.76,
   "text": "بحث ما قلب معروف هست و اگر می‌دونستیم که انقدر دریای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.76,
   "end": 77.14,
   "text": "عمیقیه به این زودی ورود به این قلب نمی‌کردیم، یه قلب دیگه‌ای رو دست می‌گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.14,
   "end": 79.84,
   "text": "اما چه کنیم؟ هرچی میریم جلوتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.84,
   "end": 85.4,
   "text": "عمیق‌تر میشه. در آیه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.4,
   "end": 91.8,
   "text": "سوره عرض شود دعای شریف عرفه یه بخشی هست که آقامون ابا عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.8,
   "end": 98.82,
   "text": "اون جمله عجیبی رو که شب‌های قدر سر سفره‌ش نشستیم رو وقتی بیان می‌کنه مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.82,
   "end": 104.14,
   "text": "که الهی ترددی في الآثار یوجب بعد المزار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.14,
   "end": 114.84,
   "text": "این تردد یعنی رفت و آمد من یا به عبارتی توجه من به آثار وجودی تو که امروزه در ابتدایی‌ترین حالت عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 114.84,
   "end": 118.66,
   "text": "یا توحید میگن از اثر پی به مؤثر ببر ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.66,
   "end": 122.52,
   "text": "درست هم هست غلط نیست اما برای مبتدی‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.52,
   "end": 130.2,
   "text": "وقتی توحیدت قوی‌تر شد، جانت قوت گرفت، دیگه ابا عبدالله تو رو از این سیر هم عبور میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 130.2,
   "end": 135.14,
   "text": "از اینجا هم عبور میده. میگه برو بالاتر تعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 135.14,
   "end": 140.82,
   "text": "ترددی رفت و آمد من في الآثار در همین آثار و همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 140.82,
   "end": 143.28,
   "text": "نشانه‌های وجودی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 143.28,
   "end": 147.76,
   "text": "یوجب بعد المزار سبب دوری من از تو میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 147.76,
   "end": 151.84,
   "text": "از اون مزار محل زیارت تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 151.84,
   "end": 158.8,
   "text": "بعد چون بحث عرض کردیم که قلب معروف مقام جمعی دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 158.8,
   "end": 165.3,
   "text": "و سؤال پیش میاد این همه حرف می‌زنیم در خصوص قلب معروف و میگیم حتی طبق صحبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 165.3,
   "end": 170.34,
   "text": "دیروز ما حتی مرگ علتش اینه که ما به اون تألیف قلوب برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 170.34,
   "end": 172.48,
   "text": "به اون مقام جمعی و حضور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 172.48,
   "end": 175.58,
   "text": "تام برسیم. خب چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 175.58,
   "end": 180.62,
   "text": "اینجا ابی عبدالله عجیبه بلافاصله بعد از این جمله سنگین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 180.62,
   "end": 183.64,
   "text": "سر رو بیان کرده. فجمعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 183.64,
   "end": 189.92,
   "text": "کلام مستقیما حضرت ابا عبدالله است و جالب است در تهللمه می‌فرمودن که همین‌ها، اینا معجزات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 189.92,
   "end": 192.44,
   "text": "قولیه‌ی امام اهل بیت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 192.44,
   "end": 197.02,
   "text": "یعنی اگر اهل بیت هیچی نداشتن جز همین کلمات و جملات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 197.02,
   "end": 199.34,
   "text": "این اقوالشون برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 199.34,
   "end": 202.12,
   "text": "اینکه اون‌ها به حق‌اند بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 202.12,
   "end": 204.22,
   "text": "می‌فرمود فجمعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 204.22,
   "end": 208.58,
   "text": "جمعم کن خدایا منو متمرکز کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 208.58,
   "end": 211.68,
   "text": "تو چی؟ علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 211.68,
   "end": 217.36,
   "text": "فجمعنی علیک بخدمة توسلنی الیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.36,
   "end": 221.02,
   "text": "به یه خدمتی که منو به تو وصل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 221.02,
   "end": 224.2,
   "text": "این توسلنی الیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 224.2,
   "end": 228.24,
   "text": "نتیجه‌ی چی میشه؟ خدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.24,
   "end": 232.04,
   "text": "که در حقیقت انسان رو به مقام معلوف می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 232.04,
   "end": 235.84,
   "text": "حالا این خدمت چی می‌تونه باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 235.84,
   "end": 239.84,
   "text": "یک وقت هست انسان در خدمت دین خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 239.84,
   "end": 246.02,
   "text": "إن تنصر الله ينصركم ويثبت أقدامكم در اون چهار تا فاکتوری که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 246.02,
   "end": 249.26,
   "text": "نماز و زکات و امر به معروف اونایی که ازمون کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 249.26,
   "end": 252.7,
   "text": "یک وقت هست در خدمت حجت خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 252.7,
   "end": 257.88,
   "text": "که پایه‌ریزی حکومت و ظهور امام عصر رو می‌کنه و انتقال معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 257.88,
   "end": 260.44,
   "text": "یک وقت هست در خدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.44,
   "end": 263.18,
   "text": "دوستان خدا و اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 263.18,
   "end": 264.98,
   "text": "کجای عاشورا اینو پیدا می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.98,
   "end": 269.66,
   "text": "فأسأل الله الذي أکرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.66,
   "end": 272.44,
   "text": "من از خدا درخواست می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.44,
   "end": 275.08,
   "text": "که گرامی داشت مرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.08,
   "end": 282.84,
   "text": "به چی گرامی داشت؟ أکرمني بمعرفةکم و معرفة أولیاءکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.84,
   "end": 285.54,
   "text": "این قسمت متاسفانه مغفول مانده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.54,
   "end": 288.56,
   "text": "همه توجهمون تو عاشورا به خود امام حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.56,
   "end": 292.46,
   "text": "خب عشق. اما اولیاءکم چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.46,
   "end": 296.98,
   "text": "عبارت رو دقت کنید. فأسأل الله الذي أکرمني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 296.98,
   "end": 301.54,
   "text": "درخواست می‌کنم از خدایی که منو گرامی داشت به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.54,
   "end": 308.04,
   "text": "بمعرفةکم به معرفت و شناخت شما و معرفة أولیاءکم و دوستان شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.04,
   "end": 311.48,
   "text": "من نسبت به دوستان شما چه کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.48,
   "end": 314.92,
   "text": "خدمت. همین امل-- همین الان نیت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.92,
   "end": 319.74,
   "text": "نیت کنیم که ما حتی وقتی میایم سر کار نیتمون خدمت به خلق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 319.74,
   "end": 325.68,
   "text": "اعم از عیال، همسر و فرزندانمون که عیال الله هم هستن اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 325.68,
   "end": 327.78,
   "text": "یا خلق خدا یا هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 327.78,
   "end": 332.28,
   "text": "حتی این عزیزی که چایی میده به نیت خدمت به خلق خدا چایی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 332.28,
   "end": 337.3,
   "text": "باور کنید همین‌ها چیزای جزئی انسان رو به مقام معلوف می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.3,
   "end": 340.24,
   "text": "فرمایش مولامون امام حسین چیز عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.24,
   "end": 343.46,
   "text": "یه مدیر پشت میزش می-- می‌شینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 343.46,
   "end": 349.12,
   "text": "سعی کنه اونایی که ظاهرا البته زیر دستشن باطنا خدا می‌دونه کی بالا پایینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.12,
   "end": 352.86,
   "text": "به اون‌ها رسیدگی کنه، خدمت کنه بهشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.86,
   "end": 357.92,
   "text": "جالبه که نقل می‌کنند یه آدم حالا متموّلی، تاجری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 357.92,
   "end": 362.46,
   "text": "ثروت‌مندی اومد حرم امام رضا قربونش بریم انشاالله ایام زیارت عرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 362.46,
   "end": 365.92,
   "text": "شود هم تولدشون بود هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 365.92,
   "end": 368.72,
   "text": "ایام زیارتیشون داره میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.72,
   "end": 375.54,
   "text": "زیارت مخصوصه که فرمودن که رفت حرم یه چند روزی میومد هر از چند گاهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 375.54,
   "end": 382.26,
   "text": "ما یه رفیق داشتیم اینطوری بود. هفته‌ای یه بار می‌رفت حرم با هواپیما می‌رفت زیارت تموم می‌شد با هواپیما برمی‌گشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 382.26,
   "end": 385.14,
   "text": "تاجری بود همه پولش هم در خدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 385.14,
   "end": 390.46,
   "text": "کارهای خیر بود. خب این رفت حرم و بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 390.46,
   "end": 392.5,
   "text": "یه روز، دو روز، سه روز معمولاً می‌موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.5,
   "end": 398.46,
   "text": "دید هیچ خبری نشد. نه اشکی ازش میاد نه حال عبادت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 398.46,
   "end": 402.58,
   "text": "پیداست یه خبری هست. موند که چرا اینطوری شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 402.58,
   "end": 404.7,
   "text": "گفت جای من الان اینجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 404.7,
   "end": 407.32,
   "text": "جای من جای دیگست. زد بیرون از حرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 407.32,
   "end": 411.3,
   "text": "از بیرون اومد پی چی می‌گشت ببینه آقا کجا گرا داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 411.3,
   "end": 413.86,
   "text": "\"فجمعني\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.86,
   "end": 417.66,
   "text": "منو متمرکز کن \"عَلَيكَ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 417.66,
   "end": 421.54,
   "text": "به سمت خودت البته \"بِخِدمَةٍ تُوصِلُني إِلَيكَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 421.54,
   "end": 423.2,
   "text": "ببینم آقا می‌خواد الان من کجا باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 423.2,
   "end": 425.38,
   "text": "الان نمی‌خواد آقا من تو حرم باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 425.38,
   "end": 427.7,
   "text": "این حال بد من یعنی برو، برو بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.7,
   "end": 430.62,
   "text": "فعلاً جای-- اومدم بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.62,
   "end": 434.64,
   "text": "به هر حال گفتم حالا چند ساعتی مونده تا پرواز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.64,
   "end": 436.38,
   "text": "برم یه گشتی بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.38,
   "end": 439.46,
   "text": "همینطوری یه دوری زدم. دیدم که پیرمردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.46,
   "end": 444.74,
   "text": "داره یک گاری رو می‌کشه. سنگین به سختی گیرم کرده، زورش نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 444.74,
   "end": 447.22,
   "text": "روش بار سنگینی گذاشته. رفتم کمکش کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 447.22,
   "end": 451.22,
   "text": "در حینی که با گاری رو هل می‌دادم بهش گفتم آقا پیرمرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 451.22,
   "end": 455.3,
   "text": "مجبوری این همه بار بذاری رو این گاری که نتونی بکشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 455.3,
   "end": 458.42,
   "text": "یه آهی کشید گفت دست رو دل ما نذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 458.42,
   "end": 460.92,
   "text": "خانمم گفته تا نت-- تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.92,
   "end": 467.46,
   "text": "جهیزیه دخترت رو آماده نکنی، انقدر کار نکنی تا این جهیزیه آماده بشه، دخترت دم وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 467.46,
   "end": 469.66,
   "text": "ایناها حق نداری بیای خونه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 469.66,
   "end": 472.36,
   "text": "دست رو دل ما نذار. مجبورم اینطوری کار کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 472.36,
   "end": 474.32,
   "text": "چه کنم؟ میگه آها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 474.32,
   "end": 476.64,
   "text": "گفت پس معلومه که ماموریت من اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 476.64,
   "end": 481.54,
   "text": "وضعش هم خوب بود دیگه. خلاصه کمک کردیم بار رو رسوند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.54,
   "end": 486.84,
   "text": "رفت خونه. حالا مفصله. رفت خونه‌ی همین بابا، پیرمرد درب و داغون و کارگر بارکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 486.84,
   "end": 491.66,
   "text": "دید خیلی خونه زندگی ساده و خیلی درب و داغون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 491.66,
   "end": 495.72,
   "text": "بعد شروع کرد پیرمردה درد و دل کردن که حالا این دختر ماست و اینا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 495.72,
   "end": 500.24,
   "text": "منم به شدت مجبورم. همونجا یه چک درآورد کشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 500.24,
   "end": 502.28,
   "text": "کل جهیزیه رو چک داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 502.28,
   "end": 505.28,
   "text": "یه چک هم داد گفت برو با این پول یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.28,
   "end": 506.98,
   "text": "سرمایه اولیه پیدا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 506.98,
   "end": 509.4,
   "text": "یه کاسبی راه بنداز. برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 509.4,
   "end": 514.42,
   "text": "بعد حالا میگه وقتی برمی‌گشت این پیرمرد و خونوادش اشک می‌ریختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 514.42,
   "end": 518.48,
   "text": "پشت سر این مرد تاجری که رفته بود حرم چشمش خشک شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 518.48,
   "end": 521.54,
   "text": "فهمیده بود جاش الان اونجا نیست. گریه می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 521.54,
   "end": 528.32,
   "text": "می‌گفتن انشاالله عاقبتت به خیر باشه و همین الان از امام رضا یه هدیه، عیدی و هدیه مشتی بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 528.32,
   "end": 532.12,
   "text": "یه همین حالت میگه دیدم اصن دلم یه جوری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 532.12,
   "end": 534.0,
   "text": "دلم اصن از این رو به اون شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.0,
   "end": 536.36,
   "text": "یه نشاطی برای عبادت و زیارت دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 536.36,
   "end": 539.34,
   "text": "رفتم حرم. گفتم هنوز که حالا وقت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 539.34,
   "end": 541.3,
   "text": "تو این دقایق آخر برم وداع کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.3,
   "end": 544.28,
   "text": "رفتم ورود به حرم همانا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.28,
   "end": 547.38,
   "text": "این چشمه اشک همینطوری می‌ریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.38,
   "end": 550.7,
   "text": "می‌گفت وال امام رضا بغلم کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.7,
   "end": 552.82,
   "text": "تازه فهمیدم که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 552.82,
   "end": 555.02,
   "text": "یعنی چی. \"فجمعني\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 555.02,
   "end": 558.94,
   "text": "ببین عبارت دعای عرفه \"فجمعني عَلَيكَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 558.94,
   "end": 561.48,
   "text": "بِخِدمَةٍ تُوصِلُني إِلَيكَ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 561.48,
   "end": 564.64,
   "text": "یه خدمتی بکنم که وصل به تو بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 564.64,
   "end": 567.8,
   "text": "دیگه مگه ول می‌کرد امام رضا منو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 567.8,
   "end": 573.82,
   "text": "توجه کردید خیلی موقع‌ها ما چون معذرت می‌خوام از شما بی‌خدمتی می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 573.82,
   "end": 578.36,
   "text": "گرفتار دوری از الفت قلب، تألیف قلوب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 578.36,
   "end": 581.6,
   "text": "فهم حقایق و معارف و چشیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 581.6,
   "end": 584.3,
   "text": "باطن عالم و لذت از عبادت می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 584.3,
   "end": 587.04,
   "text": "بی‌خدمتی می‌کنیم. حالا به هر کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.04,
   "end": 590.0,
   "text": "نیت کنیم. ختم کلام وقتتون رو نگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 590.0,
   "end": 595.2,
   "text": "نیت کنیم. البته این عبارت‌های بعدی این دعای عرفه خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 595.2,
   "end": 597.7,
   "text": "خیلی. که چرا بعد از این خدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 597.7,
   "end": 599.92,
   "text": "ابا عبدالله میره سراغ توحید ناب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 599.92,
   "end": 602.46,
   "text": "میگه اصن مظهر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 602.46,
   "end": 604.52,
   "text": "تو خ-- هرچی که میگین شما مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 604.52,
   "end": 611.12,
   "text": "وقتی که میان لول پایین میارن برای مبتدی‌هایی مثل من میگن آقا همه این مثلاً من و شما مظهر خداییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 611.12,
   "end": 615.7,
   "text": "یعنی محل ظهور حقیم ها محل تجلی حقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 615.7,
   "end": 620.08,
   "text": "این یه حرفه. ولی ابی عبدالله حالا روزای بعد عرض می‌کنیم اگه توفیق شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 620.08,
   "end": 625.58,
   "text": "جلوتر که میره تو همین عبارت بعد از این بحث خدمت بلافاصله می‌فرماید مظهر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 625.58,
   "end": 629.54,
   "text": "اصلاً منی که هستم هر چیزی که وجود دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 629.54,
   "end": 632.26,
   "text": "ظهور توست. عین ظهور توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 632.26,
   "end": 634.46,
   "text": "نه اینکه این یک محلی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 634.46,
   "end": 636.7,
   "text": "که تو در او ظهور کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 636.7,
   "end": 639.86,
   "text": "نه اینکه من یک وجودیم، یک چیزی‌ام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 639.86,
   "end": 641.64,
   "text": "که تو در من ظهور کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 641.64,
   "end": 643.44,
   "text": "نه. اون که یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 643.44,
   "end": 646.38,
   "text": "یعنی من یه چیزی بودم از اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 646.38,
   "end": 649.16,
   "text": "جدای از وجود که تو در من تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 649.16,
   "end": 653.3,
   "text": "نه، اینطوری نیست. اصلاً بودن من یعنی ظهور تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 653.3,
   "end": 655.46,
   "text": "یعنی من ظهور توام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 655.46,
   "end": 660.1,
   "text": "ببین اصلاً چقدر بحث توحید و ابی عبدالله اینجا یهو می‌کشه بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 660.1,
   "end": 662.44,
   "text": "که اصلاً بعد و قربی دیگه اینجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 662.44,
   "end": 664.52,
   "text": "ببینید وقتی دو چیز هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 664.52,
   "end": 666.14,
   "text": "شما دو چیز رو در نظر بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 666.14,
   "end": 671.26,
   "text": "این میگی این چیز دوم نسبت به این اولیه دوره یا نزدیکه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 671.26,
   "end": 676.4,
   "text": "ولی وقتی یه دونه بود چی؟ به قول حضرت آلامه حسن زاده وقتی واحد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 676.4,
   "end": 678.68,
   "text": "\"قُلْ هُوَ اللَّهُ أَحَدٌ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 678.68,
   "end": 681.38,
   "text": "وقتی یه دونه بود، یکتا بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 681.38,
   "end": 686.36,
   "text": "توحید صمدی لایتناهی بود، یک وجود مطلقه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 686.36,
   "end": 689.26,
   "text": "شما بفرمایید اصلاً دیگه بعد و قرب معنا داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 689.26,
   "end": 691.76,
   "text": "نزدیکی و دوری معنا داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 691.76,
   "end": 693.8,
   "text": "همه چی شهود محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 693.8,
   "end": 696.0,
   "text": "حتی غیب هم برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 696.0,
   "end": 700.14,
   "text": "حالا پس دیگه چرا خدا تو قرآن میگه \"عَالِمُ الْغَيْبِ وَالشَّهَادَةِ\" اون غیب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 700.14,
   "end": 704.06,
   "text": "اون رو باید توضیح بدیم یعنی چی؟ انشاالله جلسات بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 704.06,
   "end": 709.48,
   "text": "عاقبتمون انشاالله ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 709.48,
   "end": 714.3,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}