 ],
 "cues": [
  {
   "i": 0,
   "start": 1.48,
   "end": 5.3,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.3,
   "end": 11.54,
   "text": "آقا جواد این اکو شد دیگه. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.54,
   "end": 15.1,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.1,
   "end": 18.84,
   "text": "قبلاً ما عرض کردیم که اگر کسی توان پرداخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.84,
   "end": 21.64,
   "text": "کفاره رو نداشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.64,
   "end": 27.96,
   "text": "او باید استغفار کنه از دل و جان و به زبانشم البته استغفار جاری بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.96,
   "end": 33.82,
   "text": "بعد یه سؤال پیش میاد که حالا اگر کسی اون موقع نداشت، استغفار کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.82,
   "end": 36.24,
   "text": "بعداً توانمند شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.24,
   "end": 40.14,
   "text": "بعداً مستغنی شد، وضع مالیش خوب شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.14,
   "end": 45.22,
   "text": "اینجا تکلیفش چیه؟ کسی که بعداً وضع مالیش خوب بوده، خوب شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.22,
   "end": 50.96,
   "text": "خب اینجا باید بده یا نه؟ کفاره‌ای که قبلاً بر تو-- گردنش بوده و نتونسته بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.96,
   "end": 56.54,
   "text": "رهبر عزیرمون می‌فرماید، فتوای رهبر اینه که لازم نیست کفاره رو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.54,
   "end": 59.52,
   "text": "الان که توانمند شده لازم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.52,
   "end": 62.34,
   "text": "اما احتیاط مستحب اینه که بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.34,
   "end": 65.04,
   "text": "پس یا فتوا رو عمل می‌کنه، خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.04,
   "end": 74.2,
   "text": "می‌تونه نده یا احتیاط می‌کنه و می‌ده که احتیاط اینجا دیگه مستحبه چون بعد از فتوا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.2,
   "end": 86.48,
   "text": "خب بحث ما سلسله بحث و نظم بحث در قلب معروف قلبی که به انس و الفت با نظام یک‌پارچه عالم بر اساس توحید صمدی قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 86.48,
   "end": 89.38,
   "text": "که همه چی حق است و لا غیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.38,
   "end": 99.24,
   "text": "رسیده بود به اینجا رسید که گفتیم راهش اینه که انسان از تولد حیوانی تولد انسانی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 99.24,
   "end": 102.9,
   "text": "تولد انسانی رو گفتیم خروج از عادت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 102.9,
   "end": 109.26,
   "text": "جلسه‌ی گذشته هم دیروز عرض کردیم که خروج از عادت رو علامه در د-- آخر درس ششم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 109.26,
   "end": 115.58,
   "text": "سیر معرفت نفس می‌فرماین با نگاه دفعی نگاه کردن به عالم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 115.58,
   "end": 120.72,
   "text": "یعنی در حقیقت معناش همون این نگاه دفعی یعنی با دیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 120.72,
   "end": 126.12,
   "text": "عقل نگاه کردن یا به عبارتی تفکر در نظام آفرینش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 126.12,
   "end": 131.12,
   "text": "تفکر هم تا دلتون بخواد در قرآن عظیم الشأن بیان شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 131.12,
   "end": 136.0,
   "text": "و دائماً به ما نهیب زده قرآن که چرا تفکر نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 136.0,
   "end": 140.92,
   "text": "چرا نگاه نمی‌کنید؟ چرا توجه ندارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 140.92,
   "end": 144.9,
   "text": "مثل آیه صد و نود سوره آل عمران که بارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 144.9,
   "end": 147.74,
   "text": "عرض محضر شما قرائت کردین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 147.74,
   "end": 153.54,
   "text": "بعد از اینکه اولو الالباب رو معرفی می‌کنه حالا این صاحبان مغز، صاحبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 153.54,
   "end": 155.68,
   "text": "لب چه کسانی هستند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 155.68,
   "end": 162.36,
   "text": "جالبه. می‌فرماید \"الذین یذكرون الله قياما و قعودا و على جنوبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 162.36,
   "end": 166.52,
   "text": "اینا کسانی‌اند که دائماً ایستاده، نشسته، خوابیده مشغول ذکر‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 166.52,
   "end": 169.14,
   "text": "یذ- یذكرون فعل مضارعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 169.14,
   "end": 172.76,
   "text": "دلالت بر دائم و ذکر بودن این‌ها داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 172.76,
   "end": 177.76,
   "text": "بعد جالبه می‌فرماید حالا اونایی که دارای مغز و تفکر و عقل بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 177.76,
   "end": 182.74,
   "text": "تعامل در نظام آفرینش می‌کردن، اینجا اومده میگه اهل ذکر‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 182.74,
   "end": 185.32,
   "text": "حالا اهل ذکر دوباره کیان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 185.32,
   "end": 187.54,
   "text": "\"ويتفكرون\" ادامه‌شه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 187.54,
   "end": 192.16,
   "text": "همون آیه صد و نود. \"ويتفكرون في خلق السماوات والأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 192.16,
   "end": 195.74,
   "text": "ربنا ما خلقت هذا باطلا سبحانك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 195.74,
   "end": 199.02,
   "text": "فقنا عذاب النار\" اینا حرفشون اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 199.02,
   "end": 203.74,
   "text": "که جالبه دقت کنید ذکر بین دو تفکر قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 203.74,
   "end": 208.52,
   "text": "ذکر. \"الذین یذكرون الله\" بعد میگه \"ويتفكرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.52,
   "end": 212.74,
   "text": "بالاشم که آیه قبلشم می‌فرمود اولو الالباب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 212.74,
   "end": 218.12,
   "text": "صاحبان مغز و فکر. که علامه از این آیه استناد می‌کنند که اگر تو بخواهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 218.12,
   "end": 220.98,
   "text": "ذکر بگیری دستت ذکر بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.98,
   "end": 225.74,
   "text": "و اهل ذکر بشی، ذاکر الهی باشی هیچ راهی جز تفکر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 225.74,
   "end": 229.8,
   "text": "فکر کن، اهل تفکر باش خودبه‌خود به ذکر می‌افتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 229.8,
   "end": 232.28,
   "text": "لذا ایشون هر وقت درس و بحث داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 232.28,
   "end": 236.48,
   "text": "خدا انشاالله شفای کامل به ایشون بده که بستری‌ان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 236.48,
   "end": 239.34,
   "text": "هر وقت ز-- مشغول درس و بحث بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 239.34,
   "end": 245.36,
   "text": "چه در برچه کلاس درس اگر کسی شروع می‌کرد به گفتن تسبیح دستش می‌گرفت، سریع تذکر می‌داد ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 245.36,
   "end": 248.04,
   "text": "می‌فرمود آقا من دارم برای شما ذکر میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 248.04,
   "end": 253.12,
   "text": "خود فکر، اهل فکر بودن، اهل ذکر بودنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 253.12,
   "end": 255.84,
   "text": "درس و بحث نظام عالم احسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 255.84,
   "end": 258.38,
   "text": "صنعه الهی این خودش ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 258.38,
   "end": 260.72,
   "text": "پس چرا داری تو دوباره ذکر میگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.72,
   "end": 262.76,
   "text": "و متوجه این ذکر نیستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.76,
   "end": 264.86,
   "text": "در حالی که این فکر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.86,
   "end": 268.66,
   "text": "که تو رو به ذکر وا می‌داره. حالا فکر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 268.66,
   "end": 272.74,
   "text": "در منطق یادمه که یک سال و نیم پیش اینجا این حرفو زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.74,
   "end": 276.5,
   "text": "قشنگ تو خاطرم هست. در منطق می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.5,
   "end": 280.3,
   "text": "خروج از نقص به کمال معنای فکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.3,
   "end": 283.06,
   "text": "شما بالاخره به یک چیزی جاهلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.06,
   "end": 285.54,
   "text": "که می‌خوای عالم بشی به اون چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.54,
   "end": 289.52,
   "text": "جهل به یک معنا نقصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.52,
   "end": 294.68,
   "text": "و حرکت تو در حقیقت خروج تو از نقص به کمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.68,
   "end": 297.58,
   "text": "یا به عبارتی از جهل به علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.58,
   "end": 299.9,
   "text": "که جاهلی می‌خوای عالم بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 299.9,
   "end": 303.58,
   "text": "این می‌شه همون تفکر و یک حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.58,
   "end": 305.6,
   "text": "حرکته دیگه. یک سیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.6,
   "end": 309.32,
   "text": "سیری از نقص به کمال، حرکته از نقص به کمال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.32,
   "end": 311.76,
   "text": "از جهل به دانایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 311.76,
   "end": 314.22,
   "text": "که حالا اون سه کتابی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 314.22,
   "end": 316.58,
   "text": "باید ما بهش فکر کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.58,
   "end": 323.44,
   "text": "بخوانیم، کتابخوان باشیم، کتاب عالم را بخوانیم بارها عرض کردیم دیگه سه تا کتاب چی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.44,
   "end": 325.42,
   "text": "حالا این تفکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.42,
   "end": 328.9,
   "text": "در حقیقت از نقص به کمال است عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.9,
   "end": 333.16,
   "text": "سیر تفکر. که همه عالم در حال حرکت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.16,
   "end": 335.74,
   "text": "حالا در نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.74,
   "end": 340.2,
   "text": "یادمه که قبلاً حدود دو سال و نیم پیش ما سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 340.2,
   "end": 344.26,
   "text": "فس اسمتسیفی کلمات فاطمیه رو که داشتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 344.26,
   "end": 348.38,
   "text": "شرح مختصر و اجمالی از ک-- این کتاب گران سنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.38,
   "end": 352.12,
   "text": "حضرت علامه که به رهبر تقدیم شد توسط ایشون رو بیان می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 352.12,
   "end": 359.3,
   "text": "اونجا گفتیم که در نشئه طبیعت این حرکتی که دائم وجود داره بهش میگن حرکت وجودیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 359.3,
   "end": 362.71,
   "text": "یا به عبارتی سیر استکمالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.71,
   "end": 365.43,
   "text": "نترسید از این عبارت‌ها. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.43,
   "end": 369.29,
   "text": "یعنی دائما تو از نقص به کمال حرکت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 369.29,
   "end": 373.79,
   "text": "یه چیزی رو الان نمی‌دونستی، حالا قبل از این نمی‌دونستی، الان دانستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.79,
   "end": 375.87,
   "text": "این می‌شه سیر از نقص به کمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.87,
   "end": 379.61,
   "text": "جسم تو، ظاهر تو، باطن تو دائما داره از نقص به کمال میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.61,
   "end": 382.99,
   "text": "در نشئه طبیعت همه چی از نقص به کمال‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.99,
   "end": 385.65,
   "text": "خروج از ظلمت به نور‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.65,
   "end": 387.61,
   "text": "لذا این می‌شه چی؟ سیر استکمالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.61,
   "end": 389.93,
   "text": "یعنی تو یک طلبی داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 389.93,
   "end": 393.13,
   "text": "طلب‌ت چیه؟ ک-- به کمال رسیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.13,
   "end": 398.05,
   "text": "چون ناقصی، جزآ-- جز-- چونکه عاجزی، چونکه فقیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.05,
   "end": 400.39,
   "text": "چونکه جاهلی. یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.39,
   "end": 403.55,
   "text": "حرکت دیگه داریم مربوط، مربوط به نشئه ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.55,
   "end": 408.39,
   "text": "اونجا هم حرکت داره. اون تا-- اون دیگه حرکت بهش می‌گن حرکت تکمیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 408.39,
   "end": 412.05,
   "text": "یعنی یک سری موجودات اونجا هستن که اینا تکمیل‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.05,
   "end": 414.11,
   "text": "کامل‌اند در نوع خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 414.11,
   "end": 416.63,
   "text": "نسبت به دیگران کامل نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.63,
   "end": 419.87,
   "text": "مثلاً اون‌ها نسبت به انسان کامل، کامل نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.87,
   "end": 422.69,
   "text": "اون‌ها هم نقص دارن اما در جای خودشون کامل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 422.69,
   "end": 424.85,
   "text": "اون‌ها دیگه سیر استکمالی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.85,
   "end": 429.61,
   "text": "مثلاً ملائکه الله. اون‌ها یک کمالاتی رو دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 429.61,
   "end": 432.05,
   "text": "که می‌خوان ما رو سیر بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.05,
   "end": 435.01,
   "text": "ما که در نشئه ملکی‌ایم، اونا تو ملکوتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.01,
   "end": 438.83,
   "text": "از بالا اصطلاحاً بهش می‌گن حرکت ایجادیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 438.83,
   "end": 441.67,
   "text": "حرکت رو در ما ایجاد می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.67,
   "end": 445.17,
   "text": "ما حرکت وجودیه یا استکمالی، اون‌ها حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.17,
   "end": 448.13,
   "text": "ایجادیه یا به عبارتی تکمیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 448.13,
   "end": 450.69,
   "text": "اون‌ها می‌خوان حرکت رو به ما ببخشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.69,
   "end": 453.59,
   "text": "حرکت از چی؟ از نقص به کمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.59,
   "end": 457.19,
   "text": "دائما دنیا در حال حرکت است از نقص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.19,
   "end": 463.61,
   "text": "به کمال. شما مثلاً به یک دانه‌ای که در زمین می‌کاری به محض اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 463.61,
   "end": 467.93,
   "text": "در ظلمت قرار می‌گیره، ببین \"یخرجهم من الظلمات إلى النور\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.93,
   "end": 472.17,
   "text": "در ظلمت و تاریکی رحم زمین قرار می‌گیره شروع می‌کنه به شکفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.17,
   "end": 474.25,
   "text": "بهش بگو چرا داری می‌شکفی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 474.25,
   "end": 475.89,
   "text": "می‌گه دوست دارم. چرا دوست داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 475.89,
   "end": 481.35,
   "text": "مگه نقصی-- می‌گه مگه من در من، در شکفتن من نقصی می‌بینی که می‌گی چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.35,
   "end": 483.39,
   "text": "نه نقصی نمی‌بینم. خب چرا داری می‌شکفی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 483.39,
   "end": 488.21,
   "text": "استعداد ذاتی منه. از عالم بالا دارن به من این استعداد رو بخشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.21,
   "end": 490.89,
   "text": "دارن مرا حرکت میدن از نقص به کمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 490.89,
   "end": 495.79,
   "text": "باید جوونه بزنم که بعداً بشم یک نخل پر از بار و بر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 495.79,
   "end": 498.63,
   "text": "توجه کردید؟ حالا من دانه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 498.63,
   "end": 502.29,
   "text": "خرمام. از من توقع نداشته باش انار بشم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.29,
   "end": 505.07,
   "text": "انگور بشم. تو هم نمی‌تونی در من دست ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.07,
   "end": 508.25,
   "text": "در کارخانه‌ی وجودی من نمی‌تونی دست ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 508.25,
   "end": 511.21,
   "text": "تکوین نظام هستی داره منو سیر می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 511.21,
   "end": 518.35,
   "text": "همون حرکت ایجادی از عالم ملکوت داره منی رو که در ملک قرار دارم، در نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 518.35,
   "end": 521.65,
   "text": "حرکت به من می‌ده که برم به سمت شکوفایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.65,
   "end": 524.25,
   "text": "و اینم دوست داشتن منه از کمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 524.25,
   "end": 530.77,
   "text": "دوست دارم به کمال برسم. این ناآرامی رو، اینکه ناآرامی‌ست، بهش می‌گن همون حرکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 530.77,
   "end": 532.97,
   "text": "آرامش نداره، دائما می‌خواد ا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.97,
   "end": 538.25,
   "text": "سیر کنه از نقص به کمال. حالا تمام موجودات، حیوانات اینطورین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 538.25,
   "end": 543.25,
   "text": "جمادات اینطورین، انسان‌ها هم، انسان‌ها هم در تکوین این شکلی‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 543.25,
   "end": 545.19,
   "text": "تکویناً انسان داره حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 545.19,
   "end": 550.23,
   "text": "بفرمایین ببینن. من و شما یک قطره بیش بودیم، یک قطره نطفه بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.23,
   "end": 555.13,
   "text": "کی در عرض نه ماه این نطفه رو تبدیل کرد به علقه و مزغه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.13,
   "end": 560.41,
   "text": "جنین و عظام و لحم و گوشت و استخوان و این عروق و این همه عظمت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 560.41,
   "end": 563.13,
   "text": "کی نه ماه این کارو کرد؟ شما نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.13,
   "end": 570.55,
   "text": "نه ماه که چه عرض کنم، نه قرن بده به دست بزرگ‌ترین دانشمندای قطره آبو بگو از این انسان بساز ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 570.55,
   "end": 575.67,
   "text": "کی این حرکت رو از نقص به کمال تو نه ماه به نطفه، به یک آب گندیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 575.67,
   "end": 578.91,
   "text": "به یک آب بدبو داد شده من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 578.91,
   "end": 582.49,
   "text": "کی این سیر رو داد؟ این حرکتو کی ایجاد کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 582.49,
   "end": 587.81,
   "text": "این سیر، استکمال بر وزن استفعال یک نوع طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 587.81,
   "end": 591.05,
   "text": "طلب می‌کنی از نقص به کمال رو، حرکت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 591.05,
   "end": 593.55,
   "text": "اصلاً عالم در حال حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 593.55,
   "end": 596.57,
   "text": "حالا این حرکت دائماً هم از نقص به کماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 596.57,
   "end": 598.61,
   "text": "هیچ نقصی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 598.61,
   "end": 602.57,
   "text": "مگر من و شما بشر دوپا بیاییم نقصی درش ایجاد کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 602.57,
   "end": 605.33,
   "text": "بعد نطفه رو ببندیم بچه ناقص به دنیا بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 605.33,
   "end": 607.95,
   "text": "ربطی به تکوین عالم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 607.95,
   "end": 613.47,
   "text": "توجه کردید؟ حالا اینجا این شما نگاه کن در نظام وجودی خودت، کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 613.47,
   "end": 616.07,
   "text": "نفس و جان خودت رو بررسی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 616.07,
   "end": 620.13,
   "text": "آیا می‌تونی کوچک‌ترین اعوجاجی ببینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 620.13,
   "end": 622.63,
   "text": "چرا مثلاً مژه‌های تو رشد نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 622.63,
   "end": 625.75,
   "text": "اگر رشد داشت چشمت رو از بین می‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 625.75,
   "end": 628.09,
   "text": "آیا از یک زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 628.09,
   "end": 631.27,
   "text": "سیراب نمی‌شه این مژه؟ از همون زمینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 631.27,
   "end": 638.63,
   "text": "از همون ارز وجود و جان تو داره سیراب می‌شه که موی سر تو هم از همونه، ریش تو هم از همونه، ابروی تو هم از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 638.63,
   "end": 641.27,
   "text": "چرا این حرکت نداره مو حرکت داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 641.27,
   "end": 643.49,
   "text": "چرا این شکلیه اون، اون شکلیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 643.49,
   "end": 646.71,
   "text": "یا مثلاً چشم، تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 646.71,
   "end": 650.81,
   "text": "دانشمندان علم تجربی گفتن بیست نوع اشک از چشم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 650.81,
   "end": 653.13,
   "text": "وقتی که گریه می‌کنی یه جوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 653.13,
   "end": 655.45,
   "text": "وقتی غم و غصه‌ای گریه می‌کنی یه جوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 655.45,
   "end": 658.27,
   "text": "اشکی که برای امام حسین اصلاً جنسش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 658.27,
   "end": 660.39,
   "text": "اشک در مثلاً درد یه جوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 660.39,
   "end": 663.81,
   "text": "اشک شوق، یه خبر خوشحالی اشک تو چشم جمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 663.81,
   "end": 665.41,
   "text": "اینا همه جنس‌هاش با هم فرق می‌کنه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 665.41,
   "end": 667.53,
   "text": "یعنی تو آزمایشگاه، labrator،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 667.53,
   "end": 670.05,
   "text": "labrator اینا رو برداشتن چیکار کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 670.05,
   "end": 673.69,
   "text": "بررسی کردن دیدن اصلاً جنس این اشک‌ها با هم فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 673.69,
   "end": 677.45,
   "text": "اشک از روی ترس، اشک از روی مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 677.45,
   "end": 682.97,
   "text": "عرض کنم خدمتتون درد، اشک از روی سوزش چشم، اشکی که دود بیاد بره توش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 682.97,
   "end": 687.23,
   "text": "همه‌ی این‌ها با هم فرق می‌کنه. کی این‌ها رو این چنین آموزش داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 687.23,
   "end": 692.63,
   "text": "کی؟ ما چند وقت پیش که یه مزرعه حیوانات رفته بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 692.63,
   "end": 699.65,
   "text": "یه بزقاله ای رو برداشتیم از بین حدود دو هزار تا گوسفند و بزقاله و آوردیم نشون دادیم به بر و بچه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 699.65,
   "end": 705.81,
   "text": "بعد ولش کردیم. این رفت تو دو هزار تا بزقاله و گوسفند یک راست رفت سراغ مادرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 705.81,
   "end": 708.29,
   "text": "شروع کرد شیر خوردن. واقعاً عجیب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 708.29,
   "end": 711.31,
   "text": "از کجا می‌فهمه این بزقاله اون مادرشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 711.31,
   "end": 714.25,
   "text": "این سیر رو کی بهش داره می‌ده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 714.25,
   "end": 720.75,
   "text": "کی این حرکت رو در این ایجاد کرده که بره از شیر مادر بخوره و اگر اشتباهی بره اون مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 720.75,
   "end": 723.81,
   "text": "بفهمه این بچه‌اش نیست، یه لگد می‌زنه پرتش می‌کنه اونور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 723.81,
   "end": 726.4,
   "text": "ابّو، حالا هرچی تشخیص می‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 726.4,
   "end": 729.36,
   "text": "این سیر رو کی داره میده در نظام تکوین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 729.36,
   "end": 734.34,
   "text": "همین حر-- میگه آقا آوردن تخت بلقیس از یمن به صبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 734.34,
   "end": 740.6,
   "text": "که ملکه صبا رو حضرت سلیمان نبی همین رو دستاویز قرار داد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 740.6,
   "end": 744.3,
   "text": "مثلاً ارشادش کنه، اون آسف یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 744.3,
   "end": 749.9,
   "text": "بعضیا گفتن آصف تو قرآن میاد میگه طرفة العینی تخت رو میاره از یمن تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 749.9,
   "end": 753.2,
   "text": "صبا. چقدر؟ میگه عجب معجزه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 753.2,
   "end": 758.4,
   "text": "عجب معجزه‌ای. یا مثلاً میگه که عصای موسی به آب زد عجب معجزه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 758.4,
   "end": 760.04,
   "text": "دوازده چشمه جاری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 760.04,
   "end": 763.4,
   "text": "چه-- چشم تو بیست تا چشمه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 763.4,
   "end": 765.86,
   "text": "چشم تو بیست نوع آب ازش می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 765.86,
   "end": 771.74,
   "text": "این معجزه نیست؟ کدوم جش-- چشمه رو سراغ دارید که دو نوع آب ازش بن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 771.74,
   "end": 774.44,
   "text": "بجوشه؟ ها؟ این معجزه نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 774.44,
   "end": 780.28,
   "text": "این حرکت نظام هستی در تکوین نظام تکوین معجزه نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 780.28,
   "end": 784.3,
   "text": "زمین، من همین امروز داشتم بررسی می‌کردم با همکارمون جالب بود برام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 784.3,
   "end": 787.26,
   "text": "که زمین در یک ثانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 787.26,
   "end": 790.46,
   "text": "دور خودش حرکت وضعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 790.46,
   "end": 792.82,
   "text": "نیم کیلومتر در یک ثانیه می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 792.82,
   "end": 795.84,
   "text": "دور خورشید حرکت انتقالی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 795.84,
   "end": 799.1,
   "text": "دور خورشید سی کیلومتر در ثانیه می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 799.1,
   "end": 802.68,
   "text": "دور منظومه شمسی بخوای حساب کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 802.68,
   "end": 806.38,
   "text": "در حقیقت دویست و پنجاه کیلومتر در ثانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 806.38,
   "end": 812.84,
   "text": "اون منظومه، همین منظومه شمسی دورِ دور اون منظومه محلی اصطلاحاً منظومه بزرگ‌تر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 812.84,
   "end": 814.96,
   "text": "سیصد کیلومتر در ثانیه می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 814.96,
   "end": 817.6,
   "text": "الله اکبر. اینا معجزه نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 817.6,
   "end": 820.4,
   "text": "آن به آن یک آن سیصد کیلومتر رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 820.4,
   "end": 826.7,
   "text": "حالا اینو برو با ستاره شعراء یمانی یا ستاره تازه گل-گلکا، شعراء یمانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 826.7,
   "end": 832.68,
   "text": "حالا خیلی دورتره. گلکا چهارصد و پنجاه میلیون کیلومتر از خورشید دورتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 832.68,
   "end": 836.12,
   "text": "با اون حساب کن. اصلاً قابل-- بعد برو تو شعراء یمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 836.12,
   "end": 838.64,
   "text": "بعد برو سراغ آسمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 838.64,
   "end": 843.12,
   "text": "ستارگان ثوابت که عکسی که گرفتن انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 843.12,
   "end": 845.48,
   "text": "نقاط نورانی، من دیدم این عکس رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 845.48,
   "end": 848.72,
   "text": "نقاط رو-- نورانی هست که هر کدوم از این نقطه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 848.72,
   "end": 853.94,
   "text": "یک ترمینال به-- عذر شود میلیاردها ترمینال به توان میلیارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 853.94,
   "end": 859.76,
   "text": "که هر ترمینال درش میلیاردها سیاره و ستاره به توان میلیاردها سیاره و ستاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 859.76,
   "end": 863.06,
   "text": "اصلاً قابل احصا و شمارش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 863.06,
   "end": 866.26,
   "text": "این همه حرکت معجزه آسا در نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 866.26,
   "end": 868.36,
   "text": "میگه به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 868.36,
   "end": 872.22,
   "text": "نظام هستی رو بشین با دید تفکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 872.22,
   "end": 874.52,
   "text": "با نگاه تفکر ببین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 874.52,
   "end": 877.74,
   "text": "که دائماً از نقص به کمال حرکت می‌کنه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 877.74,
   "end": 880.74,
   "text": "این ناآرامی می‌شه همون حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 880.74,
   "end": 882.62,
   "text": "تو رو می‌خواد که مقام قلبه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 882.62,
   "end": 884.78,
   "text": "مقام قلب یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 884.78,
   "end": 887.8,
   "text": "انقلاب، منقلبه، ناآرامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 887.8,
   "end": 891.18,
   "text": "دائماً می‌خواد حرکت کنه. کی به اطمینان برسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 891.18,
   "end": 896.0,
   "text": "زمانی که قلب تو با، به انس و الفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 896.0,
   "end": 902.4,
   "text": "با این توحید سمدی نظام یکپارچه که همه ظهور و بروز حقاً برسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 902.4,
   "end": 905.16,
   "text": "انس با این پیدا کنه نه به ظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 905.16,
   "end": 911.14,
   "text": "انس با اون حقیقت باطنی پیدا کنه از این آرامش خارج بشه بشه قلب مطمئن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 911.14,
   "end": 913.24,
   "text": "پس قلب معلوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 913.24,
   "end": 915.2,
   "text": "انتهاش ختم می‌شه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 915.2,
   "end": 920.68,
   "text": "قلب مطمئن. یعنی کسی که به مقام اطمینان قلبی رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 920.68,
   "end": 923.66,
   "text": "راهش هم اینه. هیچ چاره‌ای جز این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 923.66,
   "end": 927.34,
   "text": "اگر تو تفکر نکنی نمی‌رسی به اون مقام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 927.34,
   "end": 932.3,
   "text": "ایشالله که عاقبت بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 932.3,
   "end": 937.34,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}