  {
   "index": 6,
   "title": "## عادت در خواب و نماز و ساعات",
   "start": 746.98,
   "end": 818.98
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 3.66,
   "text": "سلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.66,
   "end": 8.0,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.0,
   "end": 11.34,
   "text": "یه عزیزی پرسیدن که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.34,
   "end": 15.46,
   "text": "نظرات رهبری شما گفتید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.46,
   "end": 20.7,
   "text": "کسی که فطریه‌ش رو کنار گذاشته باشه دیگه نمی‌تونه از طریق بانک فطریه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.7,
   "end": 24.7,
   "text": "باید همون پولی که نقداً کنار گذاشته همونو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.7,
   "end": 27.44,
   "text": "حالا کس که این حکم رو نمی‌دونسته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.44,
   "end": 31.02,
   "text": "پول گذاشته بوده برای فطریه کنار، پول نقد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.02,
   "end": 34.04,
   "text": "بعد نمی‌دونسته که حتماً همونو باید بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.04,
   "end": 37.3,
   "text": "از بانک، یا اینکه مثلاً بهش زنگ زده گفته آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.3,
   "end": 40.28,
   "text": "فقیر رو می‌شناسم و مستأصل و اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.28,
   "end": 43.96,
   "text": "دسترسی به اون نداشته از طریق بانک فطریه‌ش رو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.96,
   "end": 48.62,
   "text": "تکلیف این پولی که پیشش مونده بابت فطریه این چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.62,
   "end": 54.22,
   "text": "من اینو زنگ زدم چون خودم نمی‌دونستم حقیقتش زنگ زدم از دفتر آقا پرسیدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.22,
   "end": 61.88,
   "text": "فرمودن که در اون پول، اون پولی که بابت فطریه گذاشته بوده کنار نمی‌تونه تصرف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.88,
   "end": 64.7,
   "text": "مگر اینکه از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.7,
   "end": 70.86,
   "text": "حالا صائر، فقیر، هر کسی که این پول از طریق بانک فطریه رو بهش داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.86,
   "end": 73.52,
   "text": "ارتباط بگیره و از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.52,
   "end": 76.88,
   "text": "اجازه تصرف در این پولو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.88,
   "end": 80.54,
   "text": "بگه آقا من این پول رو گذاشته بودم کنار بدم به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.54,
   "end": 84.28,
   "text": "دسترسی به شما نداشتم از طریق بانک فرستادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.28,
   "end": 86.82,
   "text": "حالا این پول فطریه مونده دست من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.82,
   "end": 90.62,
   "text": "یا از طریق خود همون طرف یا واسطه‌ای که بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.62,
   "end": 94.1,
   "text": "اجازه بگیره از اون طرف که جابجا بشن این پولا با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.1,
   "end": 98.6,
   "text": "بعد می‌تونه، می‌تونه تصرف کنه و الا در غیر این صورت نمی‌تونه تصرف در اون پول کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.6,
   "end": 101.8,
   "text": "اونم باید رد کنه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.8,
   "end": 103.8,
   "text": "بله. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 103.8,
   "end": 106.26,
   "text": "بحث قلب مألوف رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 106.26,
   "end": 109.98,
   "text": "ما جایی رسیدیم که بحث عادت پیش اومده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 109.98,
   "end": 113.2,
   "text": "خروج از عادت. گفتیم تولده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 113.2,
   "end": 116.18,
   "text": "ما یک تولد حیوانی داریم، تاریخ تولدمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.18,
   "end": 120.28,
   "text": "یک تولد انسانی داریم که ما باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 120.28,
   "end": 123.76,
   "text": "خروج پیدا کنیم از عادت‌های حیوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 123.76,
   "end": 126.06,
   "text": "به انسانیت وجودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 126.06,
   "end": 130.54,
   "text": "از طریق عقل و قلب و این‌ها که تعاریفش گذشته قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 130.54,
   "end": 134.28,
   "text": "تا بتونیم به حقیقت الف و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 134.28,
   "end": 141.44,
   "text": "در حقیقت الفت پیدا کردن و انس گرفتن با حقایق نظام هستی برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 141.44,
   "end": 143.56,
   "text": "منتها امروز می‌خوایم اینو عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 143.56,
   "end": 150.22,
   "text": "اینو خوب دقت کنید. چرا ما گاهی اوقات از مثلاً بعضی از مسائل لذت نمی‌بریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.22,
   "end": 153.62,
   "text": "چه در حسیات، ادراکات حسی‌مون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.62,
   "end": 157.38,
   "text": "قوه باصره، سامعه اینا لذت نمی‌بریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 157.38,
   "end": 160.68,
   "text": "یا بحث‌های ماوراء طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 160.68,
   "end": 164.32,
   "text": "مثل مثلاً نماز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.32,
   "end": 167.58,
   "text": "هیئت، زیارت لذت نمی‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 167.58,
   "end": 171.44,
   "text": "چرا؟ علتش اینه که ما عادت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 171.44,
   "end": 176.92,
   "text": "اساساً هر چیزی که درش خو و عادت بیاد، یعنی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 176.92,
   "end": 179.74,
   "text": "عادت کنه به یک چیز تکراری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.74,
   "end": 185.26,
   "text": "یا اگرچه چیز اون چیزی که داره نگاه می‌کنه یا درک می‌کنه تکراری نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 185.26,
   "end": 190.58,
   "text": "این درک نمی‌کنه که اون دائماً در حال تازه به تازه، نو به نو شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 190.58,
   "end": 195.24,
   "text": "این درکش رو نداره. چون عادت کرده به یک چیز تکراری لذت نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 195.24,
   "end": 200.3,
   "text": "مثالش هم زیاده. چرا شما دائماً دکوراسیون منزلتو تغییر میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.3,
   "end": 204.52,
   "text": "برای اینکه حواست، این حس باصره‌ت عادت نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.52,
   "end": 208.42,
   "text": "چون عادت که می‌کنه به یک منظره‌ای، به یک چینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 208.42,
   "end": 212.12,
   "text": "مثلاً چیدمان و وسایل منزل دیگه لذت نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 212.12,
   "end": 214.4,
   "text": "چرا لباستو دائم عوض می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 214.4,
   "end": 221.76,
   "text": "اگر یه لباس ثابت دائم بپوشی دیگه لذت نمی‌بری یا اون کسی که تو رو می‌بینه لذت رو نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.76,
   "end": 225.76,
   "text": "شما وقتی یه ماشین نو می‌خری اول چقدر بهش می‌رسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.76,
   "end": 227.82,
   "text": "شیش قفلش می‌کنی هر روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.82,
   "end": 231.98,
   "text": "دستمال می‌کشی سرش. کسی نگاهی چپش بکنه به تو سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.98,
   "end": 235.32,
   "text": "تو یه جای زیر یه سقفی آفتاب بهش نخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.32,
   "end": 237.68,
   "text": "ولی یه مدت برات دیگه عادی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.68,
   "end": 240.82,
   "text": "دیگه ولش می‌کنی تو خیابون همینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.82,
   "end": 246.7,
   "text": "چرا؟ چون عادت می‌کنی، خو می‌گیری بعد دیگه لذت ازش نمی‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 246.7,
   "end": 250.94,
   "text": "کتاب حتی علم. شما مثلاً یه سال یه کتابو بخون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.94,
   "end": 252.84,
   "text": "اشراف پیدا کن به اون کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 252.84,
   "end": 257.76,
   "text": "بعد مرتبه دوم بخوای دوباره همون کتابو بخونی خیلی لذت نمی‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.76,
   "end": 260.58,
   "text": "حالا این دیگه چه سریه در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.58,
   "end": 268.26,
   "text": "که یک عمره هزار و چهارصد ساله حتی بی‌صفا، سواداش حالا بگی یه دانشمند هر بار که می‌خونه یه نکته جدید درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.26,
   "end": 274.24,
   "text": "نه. بی‌سواد‌هاش حتی پیرزن و پیرمردهایی که سواد ندارن قرآن رو باز می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.24,
   "end": 277.32,
   "text": "سوره قل هو الله رو می‌خونن، فقط نگاه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 277.32,
   "end": 283.88,
   "text": "باز خسته نمی‌شن. یا در زیارت یا مثلاً روضه‌خوانی، روضه امام حسین چه سری درشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.88,
   "end": 286.38,
   "text": "همون روضه رو دائم برای تو می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.38,
   "end": 289.94,
   "text": "همین برم شام می‌رسد هر لحظه بوی کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.94,
   "end": 293.26,
   "text": "دائم همه در هر هیئتی می‌شینی اینو می‌شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.26,
   "end": 296.58,
   "text": "هر بار تازه به تازه، نو به نو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.58,
   "end": 299.78,
   "text": "جلوه کند نگار من تازه به تازه، نو به نو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.78,
   "end": 302.94,
   "text": "یه چیز تازه دستگیرت می‌شه. چرا لذت می‌بری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.94,
   "end": 305.98,
   "text": "چون این تازه، تازه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.98,
   "end": 309.72,
   "text": "یعنی در سر خودش، در نهاد خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.72,
   "end": 311.82,
   "text": "یک حقیقتی خوابیده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.82,
   "end": 315.1,
   "text": "تو داری متوجه می‌شی یه چیز جدیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.1,
   "end": 317.16,
   "text": "اگرچه ظاهراً تکرار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.16,
   "end": 321.14,
   "text": "حالا خداى منان هم به لطف و مرحمتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 321.14,
   "end": 323.38,
   "text": "حتی در نشئہ طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 323.38,
   "end": 327.38,
   "text": "اومده فصول رو، فصول چهارگانه رو قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.38,
   "end": 331.96,
   "text": "اگر قرار بود همیشه تابستون باشه و آفتاب داغ، خسته می‌شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.96,
   "end": 337.98,
   "text": "همیشه قرار بود زمستان باشه و سرما و برف و کولاک، خسته می‌شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.98,
   "end": 340.26,
   "text": "پاییزو بینش قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.26,
   "end": 345.12,
   "text": "بهار رو قرار داده. اد-- تعدیل می‌کنه اون حالت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.12,
   "end": 349.62,
   "text": "ببین این فصول چهارگانه که از رفته آمده حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 349.62,
   "end": 355.04,
   "text": "در، از حرکت زمین به دور خورشید رخ میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 355.04,
   "end": 357.8,
   "text": "این فصول چهارگانه یا حتی شب و روز که از بر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 357.8,
   "end": 361.92,
   "text": "حرکت وضعی زمینه، گردش زمین به دور خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 361.92,
   "end": 365.18,
   "text": "شما گمان کنید اگر همیشه شب بود چه لذتی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 365.18,
   "end": 367.52,
   "text": "اگر همیشه روز بود چه لذتی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 367.52,
   "end": 371.28,
   "text": "حتی بر اساس رساله رصد و فلك قدر تعلّامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 371.28,
   "end": 374.78,
   "text": "که اونجا ثابت میکنه ایشون از جهت علم هئیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 374.78,
   "end": 378.38,
   "text": "و نجوم که صد و هشتاد و شش هزار سال بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 378.38,
   "end": 380.32,
   "text": "دوباره کره زمین رو آب میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 380.32,
   "end": 382.64,
   "text": "چرا کره، کره زمین رو آب میگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 382.64,
   "end": 384.66,
   "text": "چون منطقت البروج با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 384.66,
   "end": 387.36,
   "text": "اون در حقیقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 387.36,
   "end": 392.44,
   "text": "اه، میرن در یک منطقه در یک جا قرار میگیرن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 392.44,
   "end": 396.36,
   "text": "با اون، اه، منطقت البروج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 396.36,
   "end": 400.84,
   "text": "با اون، اه، در حقیقت مداری که تم-- این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 400.84,
   "end": 405.82,
   "text": "خورشید و ماه و ستاره و اینا تو مداری که دارن حرکت می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 405.82,
   "end": 407.48,
   "text": "به یک وضعی قرار میگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 407.48,
   "end": 410.76,
   "text": "حالا باید تابلو باشه روش ترسیم بشه متوجه بشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 410.76,
   "end": 413.56,
   "text": "که دیگه اینطوری بگم خلاصش خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 413.56,
   "end": 417.24,
   "text": "طلوع خورشید، طلوع و غروب خورشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 417.24,
   "end": 419.04,
   "text": "تو یه جای ثابتی قرار میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 419.04,
   "end": 422.1,
   "text": "دیگه اختل-- ببین الان شما هر روز یه دقیقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 422.1,
   "end": 426.78,
   "text": "خورشید یا زودتر داره طلوع میکنه یا بعداً یه دقیقه دیرتر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 426.78,
   "end": 431.14,
   "text": "هی در حقیقت داره سا-ساعت طلوع خورشید هی تغییر میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 431.14,
   "end": 435.98,
   "text": "درش در حقیقت یه تغییر و تبدلی وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 435.98,
   "end": 444.58,
   "text": "اون دایره نصف النهار با منطقت البروج وقتی یه جا قرار گرفتن طلوع خورشید، طلوع و غروب خورشید یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 444.58,
   "end": 446.48,
   "text": "جای ثابتی قرار میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.48,
   "end": 450.88,
   "text": "وقتی اینطوری شد فکر کن که دائماً خورشید داره میتابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 450.88,
   "end": 452.82,
   "text": "اصلاً هیچ غروبی براش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 452.82,
   "end": 458.52,
   "text": "چه اتفاقی میفته؟ اینجا حالا از تعلّامه میاد میفرماید که دوباره آ-آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 458.52,
   "end": 462.9,
   "text": "حالت مد میگیره. مد، کشش میگیره کل کره زمین رو میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 462.9,
   "end": 465.64,
   "text": "که حضرت تعلّامه میفرماید این قیامت این دوره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 465.64,
   "end": 470.24,
   "text": "این قیامت همین دوره انسان‌هایی که ما هم جزءشیم تو همین دوره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 470.24,
   "end": 473.76,
   "text": "بعد دوباره حالا که این خورشید از این حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 473.76,
   "end": 480.0,
   "text": "ثابت دربیاد دوباره تغییر و تبدل رخ بده بر اساس حرکت جوهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.0,
   "end": 485.52,
   "text": "و هی از درون تا حالا بعد حالا علم هئیت دیگه خستتون نکنیم اصطلاحات علمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 485.52,
   "end": 490.12,
   "text": "که بعد دوباره، اه، تغییرات این تدریج باعث بشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.12,
   "end": 495.12,
   "text": "نه دفعةً، تدریج باعث بشه که رفته، رفته دوباره برگرده به همین چهار فصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 495.12,
   "end": 498.56,
   "text": "دو مرتبه دهول ارض پیش بیاد خاک خودشو نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 498.56,
   "end": 502.22,
   "text": "حالا از دو-- تو دوره ما از زیر خونه خدا خودشو نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 502.22,
   "end": 505.64,
   "text": "دوره بعدی معلوم نیست. الله اعلم نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 505.64,
   "end": 508.6,
   "text": "بعد انسان‌های جدید دوباره بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 508.6,
   "end": 513.48,
   "text": "میخوام اینطوری عرض کنم خدمتتون که حتی تو ادراکات حسی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.48,
   "end": 516.2,
   "text": "خدا یه کاری کرده که تو اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 516.2,
   "end": 518.12,
   "text": "دائماً روز باشه لذت نمی‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 518.12,
   "end": 519.84,
   "text": "دائماً شب باشه لذت نمی‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 519.84,
   "end": 523.62,
   "text": "لذا خود خدا یه کاری کرده تو دائم لذت ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 523.62,
   "end": 525.7,
   "text": "یه وقت شب باشه، یه وقت روز باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 525.7,
   "end": 528.24,
   "text": "یه وقت گرم باشه، یه وقت سرد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 528.24,
   "end": 530.46,
   "text": "تو مسائل معنوی هم اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 530.46,
   "end": 533.9,
   "text": "اگر تو نمازد همیشه ثابت باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 533.9,
   "end": 535.96,
   "text": "یه حال ثابتی همیشه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 535.96,
   "end": 542.02,
   "text": "همون لذتی که الان از نماز ظهرت میبری همونو از الان میخوایم نماز عصر بخونیم همونو ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 542.02,
   "end": 544.08,
   "text": "لذتت لذت واقعی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 544.08,
   "end": 550.62,
   "text": "نمیمونه برات. چون خو گرفتی و عادت کردی دولا راست بشی لذت‌ها م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 550.62,
   "end": 554.32,
   "text": "در حقیقت تجدد درش نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 554.32,
   "end": 558.66,
   "text": "تبدل درش نیست. لذت نمی‌بری، خسته میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 558.66,
   "end": 567.78,
   "text": "پس راه اینکه انسان قلبش از طریق کشف و شهود با این نظام احسن عالم، دقت کنید نکته چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 567.78,
   "end": 569.48,
   "text": "انس و الفت پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.48,
   "end": 571.74,
   "text": "چون بحث ما قلب معلوف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 571.74,
   "end": 575.08,
   "text": "قلبی که الفت گرفته با عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 575.08,
   "end": 578.18,
   "text": "الفت گرفته با نظام احسن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 578.18,
   "end": 580.36,
   "text": "الفت گرفته با حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 580.36,
   "end": 584.5,
   "text": "الفت گرفته با اون توحید صمدی که میفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 584.5,
   "end": 588.48,
   "text": "\"همه یار است و نیست غیر از یار.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 588.48,
   "end": 590.68,
   "text": "دقت کنید شعر علامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 590.68,
   "end": 594.12,
   "text": "\"همه یار است و نیست غیر از یار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 594.12,
   "end": 597.96,
   "text": "واحدی جلوه کرد و شد بسیار.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 597.96,
   "end": 603.42,
   "text": "همون حضرت حق است که دائماً در حال ظهور و بروز و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 603.42,
   "end": 605.4,
   "text": "در حال جلوه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 605.4,
   "end": 609.84,
   "text": "هی لذا حرکت حالا بهش میگن اصطلاحاً خیلی هم شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 609.84,
   "end": 614.06,
   "text": "اصطلاحش یه ذره خطرناکه ولی میری تو عمقش میبینی چقدر شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 614.06,
   "end": 618.08,
   "text": "حرکت جوهری. اینکه تو دائم در حال تغییرi خودتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 618.08,
   "end": 620.66,
   "text": "یک آن، آن قبلی تو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 620.66,
   "end": 623.42,
   "text": "یک آن جدیده لذا لذت میبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 623.42,
   "end": 626.12,
   "text": "آدمی که حتی تو این نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 626.12,
   "end": 630.24,
   "text": "دچار مشکلات متعدده باز بهش میگی آقا پنجاه سال، شصت سال، نود سال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 630.24,
   "end": 635.26,
   "text": "صد سال انشاالله عمر کردی تشریف بیار ببری از این دنیا بخوای بری آدم دیگه-- یه عالم دیگه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 635.26,
   "end": 637.36,
   "text": "میگه نه نمیشه من تو این دنیا بمونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 637.36,
   "end": 639.6,
   "text": "نمیشه من همیشه تو این دنیا باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 639.6,
   "end": 642.06,
   "text": "چرا آدمی که وقتی باهاش صحبت میکنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 642.06,
   "end": 646.26,
   "text": "ای بابا همه چی خرابه. اصلاً اوضاع بر وفق مراد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 646.26,
   "end": 649.72,
   "text": "چرا حاضر نیست از این دنیا بره؟ برای چی میخوای بمونی اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 649.72,
   "end": 653.04,
   "text": "چون میبینه که چی؟ همه چی در حال حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 653.04,
   "end": 659.14,
   "text": "حرکت جوهری یا اصطلاحاً تبدل امثال یا تجدد صور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 659.14,
   "end": 661.38,
   "text": "صورت‌ها در حال تغییره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 661.38,
   "end": 664.0,
   "text": "مثال‌ها همش در حال تبادل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 664.0,
   "end": 666.7,
   "text": "تبدیل میشن به هم. یه چیز ثابتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 666.7,
   "end": 670.68,
   "text": "همه چی در حال حرکته. نش， نشئه طبیعت، حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 670.68,
   "end": 673.98,
   "text": "وجودیه. نشئه ملکوت، حرکت ایجادیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 673.98,
   "end": 676.4,
   "text": "ملائکه از بالا دارن انشا میکنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 676.4,
   "end": 678.9,
   "text": "ایجاد میکنن در ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 678.9,
   "end": 682.46,
   "text": "ه-- د-دائماً قلب در حال انقلابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 682.46,
   "end": 684.86,
   "text": "قلب. چرا بهش میگن قلب؟ منقلبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 684.86,
   "end": 687.86,
   "text": "تقلب داره. هی در حال حالی به حال دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 687.86,
   "end": 689.5,
   "text": "این باعث میشه که تو لذت ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 689.5,
   "end": 691.46,
   "text": "بهشت هم همینطوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 691.46,
   "end": 693.04,
   "text": "چرا در بهشت لذت میبرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 693.04,
   "end": 694.94,
   "text": "دائماً در حال تغییر و تبادله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 694.94,
   "end": 697.44,
   "text": "نعمت‌ها هی دگرگون میشه، هی عوض میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 697.44,
   "end": 699.34,
   "text": "حتی به جهنم هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 699.34,
   "end": 702.28,
   "text": "جهنم هم چرا عذاب الیمه دردناکه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 702.28,
   "end": 709.06,
   "text": "چون هی عوض میشه. اگه هی دائم عذاب یک نوع عذاب باشه دیگه دردناک نیست، عادت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 709.06,
   "end": 712.8,
   "text": "مثل بچه‌ای که هی کتکش بزنی دیگه عادت میکنه تو بزنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 712.8,
   "end": 715.9,
   "text": "هه هه هه میخنده. لذت هم میبره بزدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 715.9,
   "end": 721.78,
   "text": "اما وقتی تو جهنم عذاب تغییر کرد ثابت نموند عذاب هم میشه عذاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 721.78,
   "end": 725.0,
   "text": "علیم. خلاصه بحث چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 725.0,
   "end": 734.3,
   "text": "به اینجا رسیدیم عزیزان دلم که اگر بخوایم به حقیقت قلب معلوف برسیم یعنی قلب ما انس و الفت بگیره با نظام ملکوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 734.3,
   "end": 739.6,
   "text": "با این حقیقت یکپارچه عالم که واحدی جلوه کرده شده بسیار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 739.6,
   "end": 742.9,
   "text": "باید خو نگیری، عادت نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 742.9,
   "end": 745.28,
   "text": "اگه عادت به هر چیزی بکنی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 745.28,
   "end": 748.52,
   "text": "عادت کنی نماز بخونی، از رو عادت نماز بخونی، بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 748.52,
   "end": 753.3,
   "text": "لذت نمی‌بری. عادت کردی مثلاً این ساعت بخوابی لذت نمی‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 753.3,
   "end": 755.36,
   "text": "لذا عادت‌ها رو باید شکست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 755.36,
   "end": 760.22,
   "text": "اگرم خدا از اول میومد یه، یک به یکباره ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 760.22,
   "end": 765.68,
   "text": "مثلاً دفعةً یه دفعه ما رو مثل الان شما چجوری چه، چه درک و فهم و شعوری داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 765.68,
   "end": 769.04,
   "text": "یه دفعه از رحم مادر با همین درک و فهم و شعور میومدی بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 769.04,
   "end": 771.58,
   "text": "دفعةً، نه تدریجاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 771.58,
   "end": 775.08,
   "text": "آقا یه دفعه مواجه میشدی با این نظام احسن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 775.08,
   "end": 777.78,
   "text": "اصلاً کفت میکردی به قول ما متحیر می موندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 777.78,
   "end": 781.02,
   "text": "نمیتونستی زندگی کنی. خدا تدریج آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 781.02,
   "end": 784.72,
   "text": "یواش یواش بچه رشد میکنه میره بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 784.72,
   "end": 787.12,
   "text": "اما این بدیش اینه که چی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 787.12,
   "end": 788.92,
   "text": "چیکار میکنی؟ خو میگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 788.92,
   "end": 792.78,
   "text": "عادت میکنی با این نظام و این باعث میشه تو لذت نبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 792.78,
   "end": 797.36,
   "text": "پس اگر میخوایم لذت ببریم راهش خروج از عادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 797.36,
   "end": 803.32,
   "text": "اگر میخوایم لذت ببریم راهش اینه که خو نگیری با نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 803.32,
   "end": 806.46,
   "text": "بلکه همه چی رو تازه به تازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 806.46,
   "end": 811.5,
   "text": "نو به نو ببینی. این یه کار عقلی میخواد که تو رو به قلبت برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 811.5,
   "end": 816.28,
   "text": "انشاالله که به فضل و کرم اهل بیت عاقبت مختومه بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 816.28,
   "end": 818.98,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}