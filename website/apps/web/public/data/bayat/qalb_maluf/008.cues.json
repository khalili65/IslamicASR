  {
   "index": 1,
   "title": "## قلب مألوف؛ خروج از عادت",
   "start": 103.8,
   "end": 196.7
  },
  {
   "index": 2,
   "title": "## مثال‌های حس و عادت",
   "start": 196.7,
   "end": 317.5
  },
  {
   "index": 3,
   "title": "## فصول و شب و روز؛ لطف در طبیعت",
   "start": 317.5,
   "end": 482.52
  },
  {
   "index": 4,
