   "start": 0.44,
   "end": 203.3
  },
  {
   "index": 1,
   "title": "## قلب مألوف؛ ودّ و شاکله",
   "start": 203.3,
   "end": 308.7
  },
  {
   "index": 2,
   "title": "## حسودان و سه آیهٔ مدّ نظر",
   "start": 308.7,
   "end": 379.08
  },
  {
   "index": 3,
   "title": "## توحید صمدی و یکپارچگی هستی",
   "start": 379.08,
   "end": 490.76
  },
  {
   "index": 4,
   "title": "## نماز جماعت و خطر تعطیلی مساجد",
   "start": 490.76,
   "end": 736.47
  },
  {
   "index": 5,
   "title": "## مرگ خواب سلول و لا إله إلا الله",
   "start": 736.47,
   "end": 898.47
  },
  {
   "index": 6,
   "title": "## هفت سال آن‌به‌آن و اضطرار",
   "start": 898.47,
   "end": 994.39
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 3.24,
   "text": "رحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.24,
   "end": 8.22,
   "text": "السلام علیک ای داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.22,
   "end": 13.84,
   "text": "این اکو شد در خصوص فطریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.84,
   "end": 16.34,
   "text": "می‌دونید حکم این هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.34,
   "end": 20.54,
   "text": "تمام مراجع هم فرمودن که اختلافی هم درش نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.54,
   "end": 24.04,
   "text": "زکات فطره این هستش که هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.04,
   "end": 26.94,
   "text": "سه کیلو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.94,
   "end": 30.84,
   "text": "در حقیقت اون قوت غالبش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.84,
   "end": 33.26,
   "text": "این رو معمولا خیلی توجه بهش نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.26,
   "end": 38.02,
   "text": "قوت غالب رو باید فطریه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.02,
   "end": 41.78,
   "text": "بر اساس هر یک نفر که نون خورشن سه کیلو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.78,
   "end": 46.3,
   "text": "قوت غالب یعنی اون بیشترین چیزی که استفاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.3,
   "end": 47.92,
   "text": "دیگه باید هرکی خودش حساب کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.92,
   "end": 51.38,
   "text": "نباید منتظر بشه که مرجع اعلام کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.38,
   "end": 56.86,
   "text": "شما خودت نمی‌دونی بیشترین چیزی که تو خونه استفاده می‌کنی از جهت خوراک چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.86,
   "end": 62.52,
   "text": "اگه حبوباته، قیمت حبوبات، اگه برنجه برنج، اگه نانه قیمت گندم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.52,
   "end": 66.86,
   "text": "هرچی. اگه نان و نمکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.86,
   "end": 71.08,
   "text": "اگه نمکه هرچی. چه می‌دونم هرکی بالاخره یه قوتی داره دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.08,
   "end": 77.42,
   "text": "غالب. اگه رهبری اخیراً حالا هر سال یه قیمتی امسال فرمودن بیست تومن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.42,
   "end": 82.94,
   "text": "منظور بر اساس دیگه حد اقلی حساب می‌کنن با این فشارهای اقتصادی و بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.94,
   "end": 85.54,
   "text": "که مردم هم از دین زده نشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.54,
   "end": 94.68,
   "text": "خب اعلام می‌شه که حد اقل بیست هزار تومن یعنی بر اساس قیمت گندمه که دیگه حد اقل دیگه الان ارزون‌ترینش نونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.68,
   "end": 98.02,
   "text": "حالا کسی که بیشتر برنج استفاده می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.02,
   "end": 99.92,
   "text": "باید قیمت برنج حساب کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.92,
   "end": 103.7,
   "text": "قیمت مثلا برنج ایرانی استفاده می‌کنه باید برنج قیمتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.7,
   "end": 109.68,
   "text": "ایرانی حساب کنه. اگر کسی نه نمی‌تونه خب همه چی استفاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.68,
   "end": 113.02,
   "text": "به قولی همه چی خواره. این باید خودش چی کار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.02,
   "end": 115.56,
   "text": "یه میانگینی حساب کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.56,
   "end": 121.08,
   "text": "حالا به نظر من پنجاه تومنه مثلا میانگین بین برنج و نون و چی و مسائل دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.08,
   "end": 127.42,
   "text": "حدودا نفری پنجاه تومن. حالا اگر کسی بگه آقا من رسید زکات فطرم چشم تو چشمم خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.42,
   "end": 130.44,
   "text": "می‌خوام تقدیم کنم اما الان چی کار کنم ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.44,
   "end": 133.82,
   "text": "من همون دو هفته اول ماه حقوقم تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.82,
   "end": 137.62,
   "text": "دو هفته دوم به قول بعضیا باید سماق بمیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.62,
   "end": 143.0,
   "text": "چه باید بکنم؟ خیلی راحت دیگه چه باید بکنمش مشخصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.0,
   "end": 146.78,
   "text": ". آفرین. المفلس یعمان الله حدیثشم فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.78,
   "end": 154.98,
   "text": "حکم به هر حال فقه هم از دل روایات میاد بیرون بر اساس استنباط فقیه دیگه از دل روایات و آیات البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.98,
   "end": 159.1,
   "text": "فرمودن که کسی که نداره، اگه داره به قدر یه نفر بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.1,
   "end": 162.38,
   "text": "به قدر یه نفر از طرف همه خانواده بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.38,
   "end": 164.54,
   "text": "اگر اون رو هم نداره استغفار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.54,
   "end": 168.66,
   "text": "تمام شد دیگه. استغفار کنیم انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.66,
   "end": 172.74,
   "text": ". استغفار می‌کنیم هممون. آره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.74,
   "end": 176.88,
   "text": ". که همون استغفاری که می‌کنه کفاره‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.88,
   "end": 180.24,
   "text": "بالاخره. حالا اینا رو ما به ص-- به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.24,
   "end": 186.84,
   "text": "نحوی بیان می‌کنیم که فشاری هم به کسی نیاد گمان کنیم حالا حساب عرض شود دیگه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.84,
   "end": 193.68,
   "text": "دین اومده یه پاشو گذاشته رو گلوی ما و نه همه راه همه جا فکر همه جا رو کرده دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.68,
   "end": 196.6,
   "text": "ولی کسی که داره خب کجا بهتر از این راه‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.6,
   "end": 198.38,
   "text": "عزیزان این میره دست کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.38,
   "end": 203.22,
   "text": "میره دست فقرا، گرفتارا، نیازمندها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.22,
   "end": 209.36,
   "text": ". اجازه بفرمایید که امروز به فضل الهی ورود کنیم به بحث و قلب جدیدی که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.36,
   "end": 214.52,
   "text": "انشاالله به فضل الهی روی این قلب حرف‌ها داریم انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.52,
   "end": 217.44,
   "text": "قلب معلوف، معلوف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.44,
   "end": 221.48,
   "text": "الف. لام. فا. تألیف قلوب شنیدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.48,
   "end": 225.16,
   "text": "اینکه حالا ظاهرا دل‌ها یکی بشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.16,
   "end": 227.64,
   "text": "و بپیچند در هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.64,
   "end": 232.54,
   "text": "آیه آخر سوره مریم هم می‌فرماید که “من الذين آمنوا وعملوا الصالحات”",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.54,
   "end": 235.06,
   "text": "اگر دو تا شرط بیاد وسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.06,
   "end": 237.22,
   "text": "ایمان، عمل صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.22,
   "end": 241.0,
   "text": "تو هر جمعیتی “سيجعل” قطعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.0,
   "end": 246.02,
   "text": "خدا قرار می‌ده \"سيجعل لهم الرحمن ودا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.02,
   "end": 249.96,
   "text": "ود یکی از اسامی خدا هم ودوده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.96,
   "end": 253.78,
   "text": "رحمت پیچیده شده یعنی یک عشق، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 253.78,
   "end": 255.6,
   "text": "سوز، یک گداز، یک شوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.6,
   "end": 259.18,
   "text": "دیدی دلت تنگ می‌شه برای بچه هیئتی، برای مسجدیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.18,
   "end": 262.7,
   "text": "برای بچه‌های همشکل، همشکل خودت حالا بهتره بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.7,
   "end": 265.82,
   "text": "که قل کللی عمل علی شاکلته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.82,
   "end": 270.72,
   "text": "عملیات تو اصلاً بر اساس شاکله‌ی وجودی تو که و هرکی هم شکل تو باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.72,
   "end": 272.76,
   "text": "تو بهش شوق پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.76,
   "end": 276.54,
   "text": "تألیف قلوب می‌کنه. این دو باعث می‌شه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.54,
   "end": 279.9,
   "text": "محبت بندازه تو دل اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.9,
   "end": 282.78,
   "text": "بعد حالا یکی اون وسط قط میشه به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.78,
   "end": 286.16,
   "text": "تقوای بیشترش، به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.16,
   "end": 289.52,
   "text": "رشد علمی و معرفتی و خودسازی و تهذیب نفسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.52,
   "end": 293.46,
   "text": "مثل، مثل مثلا محزبین، عرفا، علما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.46,
   "end": 296.96,
   "text": "مثلا سر سلسله‌شون رهبر عزیزمون، امام عزیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.96,
   "end": 301.1,
   "text": "می‌بینی قط می‌شه قطب الاقطاب می‌شه همه به سمت او حرکت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.1,
   "end": 304.12,
   "text": "دل‌ها به سمت او حرکت می‌کند که دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.12,
   "end": 308.7,
   "text": "حرکتش اساسا به س-- به دست حضرت حق است و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.7,
   "end": 313.26,
   "text": "بعد اینجا یه سری نادان یا حسود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.26,
   "end": 318.94,
   "text": "میان چیکار می‌کنن؟ میگن که آقا این آقا مثلا مریدبازی راه انداخته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.94,
   "end": 322.92,
   "text": "نمی‌دونم دنبال آدم جمع کردن دور خودشه شلوغ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.92,
   "end": 324.74,
   "text": "دل دست خداست. تو چی کاره‌ای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.74,
   "end": 327.44,
   "text": "بله یکی میاد دکون دستک راه می‌ندازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.44,
   "end": 330.16,
   "text": "معرکه گیری می‌کنه، اون و کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.16,
   "end": 335.66,
   "text": "اونکه خلافه. اما یکی واقعا خ-خالصانه داره حرکت می‌کنه همه دوسش دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.66,
   "end": 341.18,
   "text": "چطور می‌شه که سر شهید همت می‌ریزن که ببوسنش بعد شست دستش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.18,
   "end": 344.1,
   "text": "شست انگشت شستش می‌شکنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.1,
   "end": 347.46,
   "text": "و این شدت معرفت و محبت از کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.46,
   "end": 349.3,
   "text": "خب شما بفرمایید شهید همت چیکار کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.3,
   "end": 354.68,
   "text": "عسل می‌ذاشت دهن اینا؟ جز بشین پاشو تو جبهه چی به اینا می‌گفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.68,
   "end": 357.32,
   "text": "این “ألّف قلوبهم ألّف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.32,
   "end": 360.62,
   "text": "بين قلوبهم” این تألیف قلوب دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.62,
   "end": 363.5,
   "text": "ما می‌خوایم پیرامون این قصه انشاالله حرف بزنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.5,
   "end": 365.6,
   "text": "که سه تا آیه رو مد نظرمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.6,
   "end": 369.56,
   "text": "آل عمران صد و سه “فألّف بين قلوبكم”.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.56,
   "end": 373.54,
   "text": "انفال شصت و سه \"و ألّف بین قلوبهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.54,
   "end": 376.96,
   "text": "توبه \"و المؤلفة قلوبهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 376.96,
   "end": 379.08,
   "text": "همش بحث تألیف قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 379.08,
   "end": 382.16,
   "text": "برای اینکه به فضل الهی این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 382.16,
   "end": 390.16,
   "text": "بتونیم خوب مور-- ورود کنیم یه مقدمه‌ای امروز لازمه که این مقدمه رو چون الحمد لله قبلاً در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 390.16,
   "end": 392.0,
   "text": "توحید صمدی قرآنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.0,
   "end": 396.0,
   "text": "چیدیم راحت وارد این بحث می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 396.0,
   "end": 399.5,
   "text": "که نظام هستی یکپارچه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.5,
   "end": 401.9,
   "text": "واحد در هم پیچیده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.9,
   "end": 406.08,
   "text": "یک حقیقت و یک واقعیت در هم پیچیده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.08,
   "end": 408.92,
   "text": "بر اساس توحید صمدی قرآنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 408.92,
   "end": 415.14,
   "text": "که \"هو الأول والآخر والظاهر والباطن\" یک معناش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 415.14,
   "end": 417.14,
   "text": "او ظاهر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 417.14,
   "end": 420.5,
   "text": "او باطن است. او اول است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.5,
   "end": 424.8,
   "text": "او آخر است. یک معنای دیگه می‌تونی بگی ظاهر اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.8,
   "end": 427.16,
   "text": "باطن اوست. اول اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.16,
   "end": 430.36,
   "text": "آخر اوست. اصلاً چیزی جز او نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 430.36,
   "end": 440.66,
   "text": "که این بحث تو-لیلة القدر وجودی گذشت که هر مقدار که به نیستی خودت بپیبردی به همان مقدار به هستی می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 440.66,
   "end": 449.74,
   "text": "از هستی برخورداری که این باعث می‌شه که انسان نظام هستی رو یکپارچه یک حقیقت وجودی ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.74,
   "end": 452.94,
   "text": "اصلاً جدایی و انف-انفکاکی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.94,
   "end": 458.28,
   "text": "همه شؤون و ظهور و بروز یک وجودند که شد نمودار حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.28,
   "end": 463.34,
   "text": "این بحث‌ها گذشت دیگه. اصلاً می‌بینی که همه چی تألیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.34,
   "end": 465.46,
   "text": "همه چی در هم پیچیده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 465.46,
   "end": 467.96,
   "text": "همه در هم تنیده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.96,
   "end": 472.14,
   "text": "همه به سمت یک حقیقت واحد در حرکت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.14,
   "end": 475.96,
   "text": "که این هم اتفاقاً همون اسم اعظم وجودی هم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.96,
   "end": 477.98,
   "text": "ببین این وجودی، وجودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.98,
   "end": 482.56,
   "text": "توحید وجودی، لیلة القدر وجودی، اسم اعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.56,
   "end": 486.1,
   "text": "وجودی. خیلی اینا کارسازه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.1,
   "end": 488.92,
   "text": "گره‌های ما رو باز می‌کنه. نمازت نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.92,
   "end": 493.42,
   "text": "باطnte معنینی می‌شه. چرا نماز جماعت انقدر تأثیرگذره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 493.42,
   "end": 495.56,
   "text": "چرا انقدر پیش خدا عزیزه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 495.56,
   "end": 497.72,
   "text": "چون همه به یک سمت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 497.72,
   "end": 501.66,
   "text": "به یک قبله، به یک شکل، به یک نفر اقتدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 501.66,
   "end": 503.8,
   "text": "همش وحدته. همه بی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 503.8,
   "end": 506.82,
   "text": "وقتی او رفت رکوع، همه رکوع، سجده، همه سجده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 506.82,
   "end": 510.68,
   "text": "همه-- اصلاً نگاه می‌کنی یکپارچگی درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 510.68,
   "end": 515.9,
   "text": "یک تألیف قلوبی. لذا می‌گه فقط خدا ثوابشو می‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 515.9,
   "end": 519.28,
   "text": "حالا بگذاریم الان متأسفانه مساجد رو به جای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.28,
   "end": 522.78,
   "text": "بیان ابرو بردارن زدن چشم کور کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 522.78,
   "end": 527.22,
   "text": "به جای اینکه بیان خب رعایت کنن مسائل بهداشتی رو به همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 527.22,
   "end": 532.32,
   "text": "شیوه مساجد رو احیا کنن یا هیئت‌ها رو کلاً مساجد تعطیل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 532.32,
   "end": 539.0,
   "text": "الان جوونا کجا برن؟ یه خطر بزرگی که الان داره جامعه جوون‌ها رو تهدید می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 539.0,
   "end": 542.2,
   "text": "همین طوریش که خالی شده بود از جوون‌ها به خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 542.2,
   "end": 544.28,
   "text": "بداخلاقی‌های خیلی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 544.28,
   "end": 547.06,
   "text": "اما الان که دیگه بدتر. حالا به اون سمت نریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.06,
   "end": 551.48,
   "text": "پس اون حتی اسم اعظم وجودی هم بر اساس تألیفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 551.48,
   "end": 555.24,
   "text": "تألیف. خصوصاً حضرت علامه حسن زاده می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.24,
   "end": 558.96,
   "text": "هر کسی از جدول وجودی خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.96,
   "end": 562.92,
   "text": "و \"إنا إليه راجعون\" به سمت حضرت حق در حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 562.92,
   "end": 568.38,
   "text": "ببینن جالبه که حضرت علامه طباطبایی علیه الرحمه در اول کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 568.38,
   "end": 570.64,
   "text": "بدایه و نهایش دو تا کتابند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 570.64,
   "end": 573.62,
   "text": "بدایت حکمت، نهایت حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 573.62,
   "end": 575.84,
   "text": "اول حکمت، آخر حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 575.84,
   "end": 577.94,
   "text": "کتاب شریفیه. بچه‌های حوزه می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 577.94,
   "end": 580.68,
   "text": "شما هم می‌تونید بگیرید. می‌شه فهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 580.68,
   "end": 584.14,
   "text": "مطالب خیلی، خیلی واقعاً عرشیه کتابش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 584.14,
   "end": 587.06,
   "text": "ابتدای هر دو کتاب می‌نویسه که حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 587.06,
   "end": 589.8,
   "text": "یک حقیقت بیش نیست. نشان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 589.8,
   "end": 592.54,
   "text": "چطور بچه به دنیا میاد می‌ره به سمت سینه مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 592.54,
   "end": 594.68,
   "text": "تمام بچه‌ها بدون استثناء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 594.68,
   "end": 598.52,
   "text": "کی به این بچه آموزش داد که برو به سمت سینه مادر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 598.52,
   "end": 604.32,
   "text": "کی وقتی که بچه از شکم مادر تو حیوانات حتی به دنیا میاد مادرشو تشخیص می‌ده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 604.32,
   "end": 607.76,
   "text": "یه بچه رو بنداز بین یک هزار تا دو هزار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 607.76,
   "end": 610.14,
   "text": "گله گوسفند، راس گوسفند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 610.14,
   "end": 612.38,
   "text": "این بچه مادرشو بین اونا پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 612.38,
   "end": 617.1,
   "text": "مادر هم اصلاً بچه بیاد اشتباهی بره به سمت یه مادر دیگه‌ای بخواد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 617.1,
   "end": 618.8,
   "text": "سینه پیش-- کم پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 618.8,
   "end": 621.9,
   "text": "اما حالا اشتباهی مادر با لگد پرت می‌کنه این بچه رو اونور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 621.9,
   "end": 624.66,
   "text": "می‌فهمه از کجا می‌فهمه این بچشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 624.66,
   "end": 629.68,
   "text": "چجوری تشخیص می‌ده؟ این درخت چجوری تشخیص می‌ده اینطوری ریشه بزنه، اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 629.68,
   "end": 632.42,
   "text": "رشد و نمو داشته باشه، آونداش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 632.42,
   "end": 635.36,
   "text": "عروقش، برگ‌هاش، شاخه‌هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 635.36,
   "end": 637.64,
   "text": "چجوری به این شکل؟ میوه‌اش به این شکل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 637.64,
   "end": 641.28,
   "text": "همه‌ساله‌اند به همین شکل. هیچ سالی تغییر نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 641.28,
   "end": 643.56,
   "text": "انگور، انگور است. انار، انار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 643.56,
   "end": 646.82,
   "text": "هیچ کدومش نمی‌تونی تو، تو نسخه‌اش دست ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 646.82,
   "end": 649.96,
   "text": "کی تا حالا تونسته یه کاری کنه انار، انگور بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 649.96,
   "end": 651.92,
   "text": "درخت انار، انگور بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 651.92,
   "end": 656.06,
   "text": "اصلاً می‌تونی دست ببری؟ یکپارچه نظام، نظام احسنه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 656.06,
   "end": 661.16,
   "text": "لذا در قرآن سوره نوه-- صد و نود و یک آل عمران \"ربنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 661.16,
   "end": 663.94,
   "text": "ما خلقت هذا باطلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 663.94,
   "end": 666.72,
   "text": "اصلاً این خلقت و باطل نیافریدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 666.72,
   "end": 669.16,
   "text": "\"سبحانک فقنا عذاب النار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 669.16,
   "end": 674.14,
   "text": "در آیه هشت مائده \"بالعدل قامت السماوات والأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 674.14,
   "end": 681.56,
   "text": "این قامت آسمانها و زمین همه نظام هستی به یک معنا پیچیده شده در یک حقیقته، اونم عدله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 681.56,
   "end": 686.3,
   "text": "اعتدال وجودی. اسم اعظم وجودی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 686.3,
   "end": 696.54,
   "text": "به قول علامه جدول وجودی تو که از بحر وجود از دریای وجود جدول وجودی تو فیض بخش می‌گیره و برخوردار می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 696.54,
   "end": 700.2,
   "text": "داره تو رو سوق می‌ده به سمت اعتدال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 700.2,
   "end": 709.26,
   "text": "معتدل باشی. لذا امام عصر و امامان معصوم اعدل امزجه رو دارن به قول شیخ الرئیس علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 709.26,
   "end": 713.12,
   "text": "اعدل امزجه یعنی مزاجشون معتدل‌ترین‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 713.12,
   "end": 717.32,
   "text": "لذا به بالاترین درجات غرب رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 717.32,
   "end": 723.48,
   "text": "در آیه بیست و دو جاسیه هم می‌فرماید \"و خلق الله السماوات والأرض بالحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 723.48,
   "end": 731.05,
   "text": "این حق همون عدله. آیه هفتاد و سه انعام \"وهو الذي خلق السماوات والأرض بالحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 731.05,
   "end": 733.47,
   "text": "اصلاً تار و پود نظام هستی حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 733.47,
   "end": 735.85,
   "text": "حق هم یک حقیقت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 735.85,
   "end": 739.07,
   "text": "ببینید پس چطور تألیف قلوب پیش نیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 739.07,
   "end": 741.97,
   "text": "اصلاً نمیشه تو به حقیقت فکر کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 741.97,
   "end": 743.99,
   "text": "به حقیقت زندگی کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 743.99,
   "end": 747.47,
   "text": "به سمت حقیقت در حرکت باشی بعد تألیفی نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 747.47,
   "end": 753.67,
   "text": "مگه میشه؟ اصلاً نظام وجودی تو یکپارچه تألیفه و الا میپاچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 753.67,
   "end": 757.21,
   "text": "مرگ قصه‌ش چیه؟ چه بلایی سر بدن میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 757.21,
   "end": 760.91,
   "text": "اون تألیف بین نفس ناطقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 760.91,
   "end": 764.83,
   "text": "و بدن به یک معنا یا جسمیت تو برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 764.83,
   "end": 772.31,
   "text": "نفس ناطقه انصراف اعلام انصراف میده از این جسم مثل اینکه تو خواب از همین جسم تو انصراف میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 772.31,
   "end": 776.01,
   "text": "نم-- اما نه کامل تعلقش رو کامل برنمیداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 776.01,
   "end": 777.93,
   "text": "متوجه بدن برزخی تو میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 777.93,
   "end": 780.37,
   "text": "تو با اون بدن فعال میشی تو خواب این ور اون ور میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 780.37,
   "end": 787.83,
   "text": "تو عالم برزخ هم هستیم که فاصله بین یعنی حد اون عالم برزخ که تو خواب میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 787.83,
   "end": 794.09,
   "text": "و قراره ما بعد از مرگ بریم که ان النوم اخ الموت بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 794.09,
   "end": 799.41,
   "text": "خواب برادر مرگه. مثالش به این دنیا اونجایی که میری تو خواب‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 799.41,
   "end": 801.19,
   "text": "اندازه‌ش به این دنیا میدونی چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 801.19,
   "end": 805.53,
   "text": "حدش رو امام معصوم صلوات الله علیه مشخص کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 805.53,
   "end": 808.69,
   "text": "فرموده عالم رحم مادر چقدر زیغه برای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 808.69,
   "end": 812.47,
   "text": "اونجا چقدر تنگه. تو ب-بچه دیدی تو عالم رحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 812.47,
   "end": 818.57,
   "text": "چنبات میزده زانوهاشم تو بغلش چقدر احساس راحتی میکنه وقتی میاد تو این دنیا عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 818.57,
   "end": 825.89,
   "text": "الا ما شاء الله. حالا اونجا میتونه-- برزخ هم نسبت به دنیا همچین عظمتی داره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 825.89,
   "end": 829.75,
   "text": "اینطوریه. مثل یه ارزن در برابر کوه دماوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 829.75,
   "end": 831.45,
   "text": "ما داریم به این سمت حرکت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 831.45,
   "end": 836.25,
   "text": "یکپارچه تألیفه. اگر این تألیف در وجود تو نباشه نظامت میپاچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 836.25,
   "end": 838.61,
   "text": "مثل مرگ که دیگه بدن میپاچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 838.61,
   "end": 840.93,
   "text": "برمی‌گرده به چرخه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 840.93,
   "end": 842.89,
   "text": "بدن برزخی‌ت فعال میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 842.89,
   "end": 849.05,
   "text": "توجه کردید؟ تمام سلول‌های بدن ما تک تک در حال تألیفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 849.05,
   "end": 855.05,
   "text": "یکپارچه تألیف بینشون یکپارچگی و پیچیدگی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 855.05,
   "end": 857.49,
   "text": "تومارشون در هم تنیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 857.49,
   "end": 861.13,
   "text": "یک محبت، علقه و علاقه خاصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 861.13,
   "end": 863.57,
   "text": "این برق، این لامپ حتی علم روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 863.57,
   "end": 866.91,
   "text": "ببینید تا مث-- مثبت و منفی با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 866.91,
   "end": 869.65,
   "text": "تألیف پیدا نکنند، نوری ایجاد نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 869.65,
   "end": 873.55,
   "text": "تألیفه همش مثبت و منفی با هم جمع میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 873.55,
   "end": 876.41,
   "text": "لا اله این نفیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 876.41,
   "end": 879.91,
   "text": "الا الله. لا اله الا الله نفی و اثباته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 879.91,
   "end": 882.13,
   "text": "یعنی منفی مثبته. اینم تألیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 882.13,
   "end": 887.51,
   "text": "اصلاً همه چی تألیفه. سبحان الذي خلق الازواج كلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 887.51,
   "end": 889.11,
   "text": "ازواج كلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 889.11,
   "end": 891.91,
   "text": "زوج زوج تألیف. همه چی زوجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 891.91,
   "end": 896.29,
   "text": "همه چی زن و شوهر. همه چی در حال تألیفند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 896.29,
   "end": 900.05,
   "text": "حالا این رو هم عرض کنم که در علم روز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 900.05,
   "end": 906.03,
   "text": "علم تجربی ثابت کرده هر هفت سال تو بدنت کاملاً بدن جدید و تازه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 906.03,
   "end": 908.37,
   "text": "یعنی شکل سلول‌هات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 908.37,
   "end": 913.45,
   "text": "گلبول‌هات هرچی ریزترین اجزاء وجودت همه بعد هفت سال نو به نو میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 913.45,
   "end": 916.77,
   "text": "دیگه اون-- اما علم الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 916.77,
   "end": 919.21,
   "text": "متافیزیک، نه فیزیک، متافیزیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 919.21,
   "end": 921.39,
   "text": "مرا-- ماوراء طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 921.39,
   "end": 927.39,
   "text": "بر اساس آیات و روایات ثابت کردن نه، تو آن به آن آدم جدیدی هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 927.39,
   "end": 930.55,
   "text": "آن به آن سلول‌ها تغییر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 930.55,
   "end": 933.87,
   "text": "به چه سمتی در حال حرکتی؟ به سمت اون اسم اعظم وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 933.87,
   "end": 936.85,
   "text": "توحید فطریت، فطریت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 936.85,
   "end": 940.11,
   "text": "توحید فطری تو. که متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 940.11,
   "end": 942.37,
   "text": "ختم کلام متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 942.37,
   "end": 946.63,
   "text": "با کمال تأسف وقتی ما متوجه اون میشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 946.63,
   "end": 955.35,
   "text": "که تو اضطرار میفتیم متوجه اون توحید فطری یا یقین وجودی یا به یک معنا اسم اعظم وجودی میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 955.35,
   "end": 961.23,
   "text": "لذا قرآن میگه \"ام یجيب المضطر اذا دعاه ويكشف السوء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 961.23,
   "end": 963.57,
   "text": "وقت اضطرار استجابت قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 963.57,
   "end": 971.45,
   "text": "چرا؟ توجه به اسم اعظم وجودی، همون یقین، همون جدول وجودی برای تو اسم اعظم توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 971.45,
   "end": 976.35,
   "text": "اگر کسی از همه جا قطع امید کرد فقط نگاهش به خدا باز میشه وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 976.35,
   "end": 979.79,
   "text": "به حضرت حق بود تمام استجابت قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 979.79,
   "end": 984.97,
   "text": "انقدر ما تعلق خاطر به این، به اون، به مدیر بالادستیمون، به رفیقمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 984.97,
   "end": 989.05,
   "text": "به این پولدار، به اون نمی‌دونم دفتردار، به کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 989.05,
   "end": 992.93,
   "text": "دستیم آخر کار می‌بینیم کار از دست کسی باز نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 992.93,
   "end": 994.39,
   "text": "می‌ریم خب حالا یه خدایی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}