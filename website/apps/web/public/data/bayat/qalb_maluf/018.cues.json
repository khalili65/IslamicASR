 "chapters": [
  {
   "index": 0,
   "title": "## خلاصۀ قلب مألوف؛ قصد عبور از ظاهر به باطن",
   "start": 11.48,
   "end": 57.92
  },
  {
   "index": 1,
   "title": "## نفحات در ایام دهر؛ فتعرضوا لها",
   "start": 57.92,
   "end": 120.78
  },
  {
   "index": 2,
   "title": "## چهار چشم؛ روایت امام سجاد در تفسیر صافی",
   "start": 120.78,
   "end": 140.84
  },
  {
   "index": 3,
   "title": "## یوم ظرف ظهور؛ نحن ایام الله",
   "start": 140.84,
   "end": 493.81
  },
  {
   "index": 4,
   "title": "## توجه عرفانی؛ اصحاب کهف، توسل، آل یاسین",
   "start": 493.81,
   "end": 550.63
  },
  {
   "index": 5,
   "title": "## ختم جلسات قلب مألوف",
   "start": 550.63,
   "end": 625.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.62,
   "end": 4.92,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.92,
   "end": 9.5,
   "text": "السلام علیک یا داعی الله و ربانی ایه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.5,
   "end": 11.48,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.48,
   "end": 18.26,
   "text": "خلاصه قلب مألوف آنچه که به فضل الهی در این چند جلسه عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.26,
   "end": 21.12,
   "text": "خلاصه‌ش این بود که قلب مألوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.12,
   "end": 23.58,
   "text": "صاحب مقامی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.58,
   "end": 26.82,
   "text": "سیر و سفر می‌کند از ظاهر به باطن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.82,
   "end": 31.88,
   "text": "در حقیقت از اسم ظاهر خدا از اسم از ظاهر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.88,
   "end": 35.22,
   "text": "به اسم الباطن سفر می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.22,
   "end": 38.28,
   "text": "و اساساً قصدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.28,
   "end": 41.28,
   "text": "حرکت است از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.28,
   "end": 47.74,
   "text": "بر همین اساس روایت بسیار زیبایی که قطعاً بارها شنیدید رو عرض می‌کنم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.74,
   "end": 50.38,
   "text": "و چون هدف ما در این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.38,
   "end": 57.92,
   "text": "ز-- عبور از ظاهر به باطن هست، یک لایه پنهان‌تر این حدیث رو هم با هم بررسی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.92,
   "end": 60.22,
   "text": "از کتاب احیا العلوم، جلد یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.22,
   "end": 66.02,
   "text": "صفحه صد و سی و چهار، پیامبر عظیم الشأن اسلام علیه الصلاة و السلام و علی آله فرمودند که ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.02,
   "end": 70.26,
   "text": "لربکم فی ایام دهرکم نفحات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.26,
   "end": 73.18,
   "text": "فتعرضوا لها. در بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.18,
   "end": 76.32,
   "text": "منابع نوشته‌اند الا فتعرضوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.32,
   "end": 79.22,
   "text": "لها. یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.22,
   "end": 81.3,
   "text": "بدونید که قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.3,
   "end": 87.32,
   "text": "برای پروردگار شما ظاهرش البته اینو می‌فرماید که در ایام عمر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.32,
   "end": 90.5,
   "text": "نفحات جمع نفح یعنی وزیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.5,
   "end": 97.9,
   "text": "یه نسیم‌های رحمتی از سمت پروردگارتون وزیدن می‌گیره فتعرضوا لها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.9,
   "end": 102.46,
   "text": "خودتون رو در معرض این نسیم‌ها قرار بدهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.46,
   "end": 106.72,
   "text": "که به هر حال قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.72,
   "end": 108.84,
   "text": "اونطور که در روایات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.84,
   "end": 113.68,
   "text": "آیات بررسی شده است، اساساً همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.68,
   "end": 120.32,
   "text": "در ظاهر خدای منان به ما چشم و گوش و قلب و این‌ها داده، در باطن هم این‌ها رو به ما عطا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.32,
   "end": 128.36,
   "text": "مثلاً در تفسیر صافی، جلد دو، صفحه صد و بیست و هشت از امام سجاد صلوات الله علیه روایتی هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.36,
   "end": 132.74,
   "text": "الا ان للعبد اربع اعین عینان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.74,
   "end": 135.66,
   "text": "يبصر بها امر دينه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.66,
   "end": 139.54,
   "text": "ودنياه وعینان يبصر بها امر آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.54,
   "end": 146.86,
   "text": "فاذا اراد الله بعبد خيرا فتح له العينین اللتين في قلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.86,
   "end": 149.92,
   "text": "فأبصر بهما الغیب وامر آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.92,
   "end": 152.42,
   "text": "واذا اراد الله به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.42,
   "end": 155.28,
   "text": "غير ذلك ترك القلب بما فيه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.28,
   "end": 161.22,
   "text": "خلاصه‌ش این می‌شه که وقتی خدای منان برای بنده‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.22,
   "end": 164.46,
   "text": "یعنی بنده برای بنده‌ی خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.46,
   "end": 168.88,
   "text": "ایجاد کرد چهار تا چشم رو ایجاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.88,
   "end": 171.66,
   "text": "خدا برای بنده‌ی خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.66,
   "end": 175.86,
   "text": "در خلقت بشری چهار چشم رو قرار داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.86,
   "end": 178.06,
   "text": "دو تا چشم در سره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.06,
   "end": 180.52,
   "text": "که در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.52,
   "end": 183.04,
   "text": "امر ظاهر رو باهاش رصد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.04,
   "end": 185.96,
   "text": "دو تا چشم هم در قلبشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.96,
   "end": 189.64,
   "text": "که نسبت به آخرتش با اون دو تا چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.64,
   "end": 197.36,
   "text": "بصیرت پیدا می‌کنه. که وقتی خدا برای بنده‌ش خیری رو بخواد دو تا چشم قلبش رو باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.36,
   "end": 199.84,
   "text": "یعنی همون چشم باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.84,
   "end": 203.9,
   "text": "که و اگر به جهت کارهای خود بنده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.9,
   "end": 206.44,
   "text": "کارهای زشت بنده، خدا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.44,
   "end": 209.44,
   "text": "خیرش رو بخواد به روی بنده‌ای ببنده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.44,
   "end": 213.6,
   "text": "اون موقع اون دو تا چشم قلبش رو می‌بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.6,
   "end": 216.9,
   "text": "و در حقیقت غلق می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.9,
   "end": 219.36,
   "text": "و قلب چیزی رو نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.36,
   "end": 225.94,
   "text": "این اشاره به همین داره و اشاره به همین توجه به باطن البته از ظاهر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.94,
   "end": 229.08,
   "text": "ببینید مختصراً عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.08,
   "end": 233.92,
   "text": "يوم در حکمت می‌فرمایند يوم ظرف ظهور اشیا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.92,
   "end": 237.96,
   "text": "چون اینجا می‌فرماید ان لربکم فی ایام دهرکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.96,
   "end": 240.3,
   "text": "ایام جمع يوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 240.3,
   "end": 243.12,
   "text": "يوم ظرف ظهور اشیا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.12,
   "end": 248.18,
   "text": "جالبه که از اهل بیت علیهم الصلاة والسلام روایت شده که نحن ایام الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.18,
   "end": 250.76,
   "text": "اون ایام الهی ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.76,
   "end": 255.52,
   "text": "یعنی ظرف ظهور تمام اشیا ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.52,
   "end": 263.6,
   "text": "در حقیقت آنچه که در نظام هستی در آن به آن در حال ظهور و بروز و تجلیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.6,
   "end": 267.08,
   "text": "همان ظهور و بروز ولایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.08,
   "end": 270.72,
   "text": "تجلیات ولایت کلیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.72,
   "end": 280.14,
   "text": "که البته ان لربکم از ناحیه پرورش دهنده شما همه این‌ها ذیل اسم رب خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 280.14,
   "end": 286.66,
   "text": "و اینکه می‌فرمود در این حدیث ان لربکم فی ایام دهرکم نفحات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.66,
   "end": 289.24,
   "text": "این وزش‌ها در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.24,
   "end": 292.5,
   "text": "در حقیقت ایام دهرکم یعنی در همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.5,
   "end": 296.18,
   "text": "ظرف ظهور عمر شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.18,
   "end": 303.02,
   "text": "یعنی آن به آن هر روز تمام اشیا برای شما در حال تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.02,
   "end": 308.2,
   "text": "نو به نو هستند. در حال ظهور نو به نو و تازه به تازه هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.2,
   "end": 312.74,
   "text": "شما ظاهراً در و دیوار می‌بینی و فرش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.74,
   "end": 316.6,
   "text": "این وسایل و اشیاء دور و برت و آسمان و زمین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.6,
   "end": 322.6,
   "text": "نباتات و جمادات و حیوانات و انسان‌ها و این‌ها که یکی از این اشیا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.6,
   "end": 325.94,
   "text": "خود شما هستی. در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.94,
   "end": 329.96,
   "text": "می‌فرماید در این اشیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.96,
   "end": 333.78,
   "text": "که در آن به آن در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.78,
   "end": 337.16,
   "text": "ظهور جدید هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.16,
   "end": 342.94,
   "text": "یک نفحه‌هایی است، وزش‌های رحمتی است، خودتون رو در معرض اون‌ها قرار بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.94,
   "end": 346.98,
   "text": "یعنی اینکه چشم باطنتون رو باز کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.98,
   "end": 351.32,
   "text": "و این باطن رو ببینید، از ظاهر عبور کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.32,
   "end": 358.5,
   "text": "ظهور اشیا رو آن به آن ببینید که یسبح لله ما في السماوات وما في الارض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 358.5,
   "end": 367.17,
   "text": "که آنچه که در آسمان و زمین آنچه که در نظام هستی وجود دارد دائماً در حال تسبیح الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 367.17,
   "end": 372.23,
   "text": "و در حقیقت و \"کلّاً فی فلك یسبحون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 372.23,
   "end": 375.23,
   "text": "شناگرند در وجه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 375.23,
   "end": 379.55,
   "text": "این همون ز-- در حقیقت معنای دقیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 379.55,
   "end": 383.23,
   "text": "يوم هست که ظرف ظهور اشیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 383.23,
   "end": 389.71,
   "text": "که شما ببینید همون‌طور که قبلاً توضیح داده شد یک اساس اما یک وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 389.71,
   "end": 391.83,
   "text": "رود نیل می‌شکافد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.83,
   "end": 396.01,
   "text": "یک وقت اژدها و مار بزرگ می‌شود، یک وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 396.01,
   "end": 399.91,
   "text": "سنگ رو می‌شکافد به دوازده چشمه بدل می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 399.91,
   "end": 405.19,
   "text": "یک چیز هست، یک شی هست اما ظهور و بروز متعدد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 405.19,
   "end": 411.45,
   "text": "لذا خدا در قرآن در خصوص خودش می‌فرماید \"کل یوم هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 411.45,
   "end": 416.37,
   "text": "فی شأن\". هو اون خدا \"قل هو الله احد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 416.37,
   "end": 421.65,
   "text": "اون خدای احد صمد \"کل یوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 421.65,
   "end": 424.81,
   "text": "هو فی شأن\". این يوم رو دوباره ظرف ظهور بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 424.81,
   "end": 432.07,
   "text": "یعنی در آن به آن در همه‌ی اشیا خدا در حال تجلی و ظهور جدید است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 432.07,
   "end": 436.15,
   "text": "که مرحوم محی الدین عربی یک رساله اساساً بر اساس بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 436.15,
   "end": 441.01,
   "text": "ذیل همین آیه شریفه دارد که یعنی چی و \"کل یوم هو فی شأن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 441.01,
   "end": 444.27,
   "text": "آن به آن خدا در حال تجلی و ظهور و بروز است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 444.27,
   "end": 447.11,
   "text": "که قبلاً هم باز عرض شد حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 447.11,
   "end": 449.81,
   "text": "ما هم آن به آن فرد جدیدی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 449.81,
   "end": 452.31,
   "text": "سلول‌هامون دائماً در حال تغییرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 452.31,
   "end": 456.35,
   "text": "علم تجربی میگه هر هفت سال یک بار ما بدنمون نو می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 456.35,
   "end": 460.27,
   "text": "اما حکمت و عرفان می‌فرماید آن به آن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 460.27,
   "end": 462.63,
   "text": "در حقیقت اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 462.63,
   "end": 465.25,
   "text": "به توجه عرفانی بشینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 465.25,
   "end": 470.61,
   "text": "و از ظاهر به باطن سفر کنه، می‌بینه که همه‌ی اشیا در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.61,
   "end": 473.81,
   "text": "ذکر حضرت حق‌اند و برای او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 473.81,
   "end": 476.43,
   "text": "ظهور و تجلی جدید دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 476.43,
   "end": 478.87,
   "text": "لذا از این جاها می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 478.87,
   "end": 484.81,
   "text": "به اون و-- نسیم‌های رحمت برسه و توجه عرفانیه که انسان رو به اونجا می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 484.81,
   "end": 486.91,
   "text": "در خصوص توجه عرفانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 486.91,
   "end": 493.71,
   "text": "حالا انشاالله قبلاً البته م-مباحثی رو عرض کردیم چند جلسه اگر فرصت شد بعداً نکته‌ای هم عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 493.71,
   "end": 498.41,
   "text": "که یکی از معجزات حضرت حق در انسان همین توجه عرفانی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 498.41,
   "end": 502.33,
   "text": "یک خواب سیصد و نه ساله‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 502.33,
   "end": 506.79,
   "text": "در حقیقت اصحاب کهف همون توجه عرفانی اون‌ها بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 506.79,
   "end": 512.75,
   "text": "ما می‌گیم خواب. در عموم گفته می‌شه خواب اما توجه عرفانیه و جالب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 512.75,
   "end": 516.17,
   "text": "خود خواب یه شعبه از توجه عرفانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 516.17,
   "end": 519.97,
   "text": "و اگر کسی به توجه عرفانی بنشیند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 519.97,
   "end": 525.05,
   "text": "توجه کند و این توجه مقام بسیار بالاییست که تو دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 525.05,
   "end": 528.49,
   "text": "توسل هم ما می‌ف-- به خدا عرض می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 528.49,
   "end": 532.91,
   "text": "\"اللهم انی اسئلک و اتوجه الیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 532.91,
   "end": 535.33,
   "text": "بنبيك نبي الرحمه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.33,
   "end": 539.25,
   "text": "ما به وسیله پیغمبر به تو متوجه می‌شویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 539.25,
   "end": 545.49,
   "text": "یا امام عصر فرمود هرکی می‌خواد به ما توجه کنه از طریق آل یاسین زیارت آل یاسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 545.49,
   "end": 550.01,
   "text": "حالا بحثش انشاالله بعداً اگرچه قبلاً مطالبی هم عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 550.01,
   "end": 555.97,
   "text": "به هر حال ختم کلام این که اگر چنانچه کسی بخواد خودشو \"فتعرّض لها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 555.97,
   "end": 560.67,
   "text": "در معرض نفحات و وزش‌های رحمت الهی قرار بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 560.67,
   "end": 563.71,
   "text": "قرار بده، بایستی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 563.71,
   "end": 566.75,
   "text": "چشمش رو باز کنه به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 566.75,
   "end": 572.41,
   "text": "همین در حقیقت سفر از ظاهر به باطن همون حقیقت قلب معروف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 572.41,
   "end": 574.73,
   "text": "اونم از تک تک اشیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 574.73,
   "end": 578.27,
   "text": "که این اشیا همون اسماء الله‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 578.27,
   "end": 585.53,
   "text": "و به میزان سعه وجودی انسان می‌تونه تعلیم بگیره اون اسماء رو که \"علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 585.53,
   "end": 589.37,
   "text": "و علم آدم الاسماء كلها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 589.37,
   "end": 593.39,
   "text": "که حضرت علامه حسن زاده حفظه الله تعالی فرمودن به جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 593.39,
   "end": 596.45,
   "text": "الاسماء می‌تونید بگذارید الاشیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 596.45,
   "end": 599.75,
   "text": "\"وعلم آدم الاشیا كلها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 599.75,
   "end": 603.21,
   "text": "یعنی به باطن و به حقیقت آنچه که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 603.21,
   "end": 608.17,
   "text": "برسی. \"اللهم ارني الاشیاء كما هي\" دعای پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 608.17,
   "end": 610.39,
   "text": "خب پس قلب معروف می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 610.39,
   "end": 616.81,
   "text": "خلاصه‌ش این که در این انتهای بحث جلسات مربوط به قلب معروف خلاصه‌ش این هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 616.81,
   "end": 619.75,
   "text": "که سفری‌ست از ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 619.75,
   "end": 625.23,
   "text": "به باطن. انشاالله که عاقبتمون ختم به خیر باشد به برکت صلوات بر محمد و آل-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}