 ],
 "cues": [
  {
   "i": 0,
   "start": 2.2,
   "end": 5.64,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.64,
   "end": 10.06,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.06,
   "end": 13.46,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.46,
   "end": 18.76,
   "text": "در خصوص انتقال نجاست از رهبر عزیزمون استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.76,
   "end": 23.6,
   "text": "تا چه حلقه‌ای، تا چند بار این انتقال نجاست صورت می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.6,
   "end": 28.4,
   "text": "یعنی اگر یه شیی، یه شیء پاکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.4,
   "end": 31.34,
   "text": "ارتباط پیدا کنه، متصل بشه به یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.34,
   "end": 34.92,
   "text": "به عین نجاست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.92,
   "end": 37.98,
   "text": "خب یکیشون هم رطوبت داشته باشه، این رطوبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.98,
   "end": 40.84,
   "text": "ن-نجاست انتقال پیدا کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.84,
   "end": 47.84,
   "text": "اون شیء پاک بر اثر انتقال نجاست از عین نجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.84,
   "end": 51.8,
   "text": "متنجس میشه. این تا کجا اده-ادامه داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.8,
   "end": 55.94,
   "text": "یعنی اگر همون شیی که پاک بوده و نجس شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.94,
   "end": 59.26,
   "text": "دوباره به یه شیء پاک دیگه و دوباره اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.26,
   "end": 67.1,
   "text": "بعدی به یه شیء پاک دیگه، همینطور این تا چه حلقه‌ای، تا چند بار می‌تونه نجاست رو انتقال بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.1,
   "end": 70.54,
   "text": "رهبر عزیزمون فرمودن اولین بار که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.54,
   "end": 77.0,
   "text": "شیء پاک به عین نجاست ارتباط می‌گیره، اگر یکیش رطوبت داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.0,
   "end": 79.3,
   "text": "خب اون شیء پاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.3,
   "end": 81.84,
   "text": "اولی، اون نجس میشه قطعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.84,
   "end": 85.86,
   "text": "میشه متنجس. پاکی که نجس شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.86,
   "end": 91.98,
   "text": "برای بار دوم اینی که پاک بود و نجس شد به یک شیء دیگه پاکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.98,
   "end": 94.38,
   "text": "مرتبط میشه و اون رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.38,
   "end": 97.04,
   "text": "متنجس می‌کنه، نجس می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.04,
   "end": 105.68,
   "text": "این هم تا اینجا رهبر عزیزمون تو این قسمت سوم احتیاط واجب کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.68,
   "end": 113.84,
   "text": "که سومین، در انتقال اون سومین حالت رو احتیاط واجب کردن که نجس می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.84,
   "end": 121.12,
   "text": "فتوا ندادن. اما از سومی به بعد رو فتوا دادن که دیگه نجس نمی‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.12,
   "end": 126.5,
   "text": "این ارتباطات رو. پس تو سومی رو اگر خواستیم باید ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.5,
   "end": 131.72,
   "text": "چون احتیاط واجبه، بعد از رهبرمون بین مراجع کی اعلمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.72,
   "end": 137.2,
   "text": "کی فتوا داده بحث ایشون رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 137.2,
   "end": 146.88,
   "text": "اما تبریک عرض می‌کنم به نوبه خودم بابت این حماسه‌ی عظیمی که و غرورآفرینی که خلق کردید شما ملت عزیز و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 146.88,
   "end": 153.22,
   "text": "الحمد لله تجمع قوا صورت گرفت علی‌رغم سه تا مشکل عمده و مهم و اساسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 153.22,
   "end": 160.64,
   "text": "یکی بحث کرونا که حالا دانشگاه هاروارد آمریکا هم دیدید تو تحقیقاتش بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 160.64,
   "end": 170.84,
   "text": "انتخابات فرانسه خودش عنوان کرد که حداقل بیست درصد مشارکت مردم تو انتخابات فرانسه به جهت کرونا کم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 170.84,
   "end": 174.54,
   "text": "این یک چیز فراگیر بود، نه فقط بگیم ما بیاییم ادعا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 174.54,
   "end": 180.6,
   "text": "دانشگاه هاروارد آمریکا در خصوص انتخابات فرانسه اینو ک-- این ادعا رو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 180.6,
   "end": 184.3,
   "text": "ولی وقتی در مثلا خصوص ما، کشور ما یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 184.3,
   "end": 189.8,
   "text": "به خاطر کرونا حضور مردم کم‌رنگ‌تر میشه، میگن نه، این علتش سیاسی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 189.8,
   "end": 192.62,
   "text": "یه فشار این قصه بود، یکی فشار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 192.62,
   "end": 196.48,
   "text": "معیشتی و اقتصادی و فشارهای عجیب و غریبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 196.48,
   "end": 199.64,
   "text": "این چند ساله به جهت بی‌تدبیری داخل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 199.64,
   "end": 202.72,
   "text": "دشمنی‌های خارج و تحریم‌ها واقعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 202.72,
   "end": 205.94,
   "text": "به ملت فشارهای عجیبی آورده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 205.94,
   "end": 209.92,
   "text": "یکی هم حداقل شصت و یک رسانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 209.92,
   "end": 215.92,
   "text": "رسانه فارسی‌زبان این مدت بر علیه انتخابات ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 215.92,
   "end": 220.0,
   "text": "پالس منفی دادن و مردم رو ناامید کردن از شرکت در انتخابات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 220.0,
   "end": 222.4,
   "text": "تازه فقط این شصت و یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 222.4,
   "end": 227.38,
   "text": "ماهواره‌ای به زبان فارسی و الا اوه تا دلت بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 227.38,
   "end": 232.26,
   "text": "معاندین در کار بودن. با همه‌ی این مشکلات الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 232.26,
   "end": 235.78,
   "text": "یه همچین تجمع قوایی صورت گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 235.78,
   "end": 239.52,
   "text": "که امیدوارم، حالا من خیلی خوشحال شدم دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 239.52,
   "end": 243.46,
   "text": "بچه‌ها به همدیگه توصیه نماز و شکر می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 243.46,
   "end": 247.76,
   "text": "و رهبر عزیزمون هم تو صحبت‌هاشون فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 247.76,
   "end": 254.62,
   "text": "که من جبهه‌ی س-س-- در درگاه حضرت حق می‌سایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 254.62,
   "end": 260.46,
   "text": "و واقعا هم حق همین است که ن الله يهدي من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 260.46,
   "end": 263.62,
   "text": "دل‌ها رو خدای منان هدایت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 263.62,
   "end": 268.08,
   "text": "و ما سپاسگزاریم از خدای بزرگ و امیدواریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 268.08,
   "end": 276.68,
   "text": "تو این مدتی که این بزرگوار، این سید خادم امام رضا صلوات الله عليه و این دلسوز ملت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 276.68,
   "end": 281.36,
   "text": "سکان اجرای اجراییات کشور رو دست می‌گیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 281.36,
   "end": 285.26,
   "text": "به امید خدا مردم لذت داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 285.26,
   "end": 291.14,
   "text": "مدیرانی انقلابی و تمان-- توانمند و کارآمد رو بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 291.14,
   "end": 294.64,
   "text": "حدود سی سال بچشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 294.64,
   "end": 302.26,
   "text": "اما به هر حال از همین جا استفاده می‌کنم تو این چند دقیقه فرصت کوتاهی که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 302.26,
   "end": 307.14,
   "text": "پیرامون یکی دیگه از راه‌های رسیدن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 307.14,
   "end": 312.58,
   "text": "قلب مألوف با شما عزیزان گفتگو می‌کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 312.58,
   "end": 316.2,
   "text": "اون هم ااا نماز هست، نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 316.2,
   "end": 319.52,
   "text": "الصلاة. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 319.52,
   "end": 325.72,
   "text": "خیلی جالبه که در آیه چهل و یک سوره حج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 325.72,
   "end": 329.58,
   "text": "خدای منان می‌فرماید أنَّهُنَّ أَنْ مَكَّنَّاهُمْ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 329.58,
   "end": 332.84,
   "text": "جالبه می‌فرماید أَنْ مَكَّنَّاهُمْ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 332.84,
   "end": 337.6,
   "text": "ما. ماییم که تمکن می‌بخشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 337.6,
   "end": 346.96,
   "text": "وقتی که ما تمکن میدیم به این‌ها یعنی به اهل ایمان که البته در روایت هستش که منظور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 346.96,
   "end": 351.0,
   "text": "اون مصداق اتم و اصلی این آیه ما اهل بیت علیهم السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 351.0,
   "end": 356.96,
   "text": "هستیم. اما خب مصادیق پایین‌دست‌ترش هم خب کارگزاران ایشان هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 356.96,
   "end": 360.06,
   "text": "و می‌فرماید، خدا می‌فرماید وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 360.06,
   "end": 365.02,
   "text": "ما به این‌ها تمکن در زمین می‌بخشیم، اولین کاری که این‌ها می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 365.02,
   "end": 368.9,
   "text": "یعنی نشانه، اولین نشانه حکومت حق اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 368.9,
   "end": 370.64,
   "text": "أَقَامُوا الصَّلَاةَ. اقامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 370.64,
   "end": 373.92,
   "text": "اونم نمی‌فرماید خواندن نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 373.92,
   "end": 377.49,
   "text": "بلکه می‌فرماید اقامه نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 377.49,
   "end": 381.75,
   "text": "که این یعنی به پا داشتن نماز نه اینکه خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 381.75,
   "end": 385.95,
   "text": "خب میشه که آ-- انسان می‌بینه در کنار این نماز جماعت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 385.95,
   "end": 391.33,
   "text": "بعضیا هم یه گوشه‌ای مثلاً نماز فرادا می‌خونن، می‌رن که خیلی هم درش برکتی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 391.33,
   "end": 396.43,
   "text": "اما وقتی که اقامه شد یعنی تعظیم شد، به جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 396.43,
   "end": 404.61,
   "text": "برگزار شد. این شرکت در اجتماعات اهل ایمان که یکی از مهم‌ترین مصادیقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 404.61,
   "end": 409.37,
   "text": "نماز جماعت و حضور در مساجد و نمازخانه‌ها هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 409.37,
   "end": 412.55,
   "text": "این تجمع قوا می‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 412.55,
   "end": 416.83,
   "text": "در حقیقت انسان رو به حقیقت قلب مألوف می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 416.83,
   "end": 420.17,
   "text": "اگر یادتون باشه عرض کردیم که قلب مألوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 420.17,
   "end": 425.51,
   "text": "اون قلبی که به الف رسیده بر وزن جسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 425.51,
   "end": 429.21,
   "text": "یا به الفت رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 429.21,
   "end": 433.79,
   "text": "یعنی تجمع قوا صورت گرفته درش به حضور رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 433.79,
   "end": 436.41,
   "text": "به حضور تام ان شاء الله رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 436.41,
   "end": 438.87,
   "text": "که البته در این آیه چهار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 438.87,
   "end": 442.79,
   "text": "فاکتور رو بیان می‌کنند که این‌ها نشانه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 442.79,
   "end": 445.25,
   "text": "مردان الهی‌ست که پس از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 445.25,
   "end": 450.03,
   "text": "یا به محض رسیدن به تمکن توسط ما در زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 450.03,
   "end": 452.87,
   "text": "این چهار تا رو دارن. اول اقامه صلات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 452.87,
   "end": 457.73,
   "text": "بعد آتو زکا. جالبه اقامه صلاة دلالت بر رشد معنوی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 457.73,
   "end": 461.61,
   "text": "آتو زکا دلالت بر رشد اقتصادی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 461.61,
   "end": 468.03,
   "text": "نشون میده که مردان خدا بی‌توجه به هیچ‌کدوم از این ابعاد وجودی انسان‌ها نیستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 468.03,
   "end": 471.13,
   "text": "و ان شاء الله مدیران تراز بالای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 471.13,
   "end": 473.21,
   "text": "انقلابی کشور ما هم ان--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 473.21,
   "end": 479.29,
   "text": "خواهند نشان داد که توجه به هر دو رشد دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 479.29,
   "end": 483.33,
   "text": "هم رشد توسعه اقتصادی، هم رشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 483.33,
   "end": 485.93,
   "text": "معنوی و معرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 485.93,
   "end": 490.43,
   "text": "بعد دو تا فاکتور انتهایی یعنی سوم و چهارم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 490.43,
   "end": 496.19,
   "text": "امر به معروف و نهی عن منکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 496.19,
   "end": 502.21,
   "text": "که جالبه که انتهای آیه می‌فرماید \"ولله عاقبة الأمور\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 502.21,
   "end": 505.05,
   "text": "یعنی برای خداست عاقبت همه امور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 505.05,
   "end": 509.65,
   "text": "یعنی این حتی این تمکن ما هم این هم مقطعی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 509.65,
   "end": 512.31,
   "text": "پیغمبر عزیز عالم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 512.31,
   "end": 517.43,
   "text": "بعد از حضرت حق نفر اول عالم خلقت است هم از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 517.43,
   "end": 520.39,
   "text": "شما هم می‌رید. یک فرصتی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 520.39,
   "end": 523.43,
   "text": "که همه قراره برن و دل نبندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 523.43,
   "end": 527.43,
   "text": "به هر حال این اقامه صلاة و نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 527.43,
   "end": 532.45,
   "text": "انسان رو به این در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 532.45,
   "end": 536.33,
   "text": "مقام الفت قلبی می‌رساند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 536.33,
   "end": 541.43,
   "text": "که به مقام جمعی به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 541.43,
   "end": 546.67,
   "text": "حضور تام که کار هر کسی هم البته نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 546.67,
   "end": 553.41,
   "text": "و البته عرض شود چون در آیه قبل از همین آیه چهل و یک سوره حج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 553.41,
   "end": 557.35,
   "text": "خدای منان به نصرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 557.35,
   "end": 562.91,
   "text": "خودش اشاره می‌کنه که \"ولينصرن الله من ينصره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 562.91,
   "end": 564.63,
   "text": "إن الله لقوي عزيز\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 564.63,
   "end": 569.53,
   "text": "بعد این آیه \"الذين إن مکناهم في الأرض أقاموا الصلاة\" میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 569.53,
   "end": 574.39,
   "text": "نشون میده که اساساً اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 574.39,
   "end": 577.71,
   "text": "نیت یاری حضرت حق رو داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 577.71,
   "end": 580.55,
   "text": "یاری حضرت حق که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 580.55,
   "end": 585.97,
   "text": "در پسش یاری خدا و نصرت الهی رو در پیش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 585.97,
   "end": 589.23,
   "text": "این در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 589.23,
   "end": 593.11,
   "text": "بعد از اینکه به تمکن رسیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 593.11,
   "end": 596.69,
   "text": "انجام این چهار فاکتور با قوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 596.69,
   "end": 603.19,
   "text": "یعنی یاری دین خدا می‌شود اقامه صلاة، آتو زکا، امر به معروف و نهی عن منکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 603.19,
   "end": 607.73,
   "text": "اقامه نماز جماعت رو نباید دست کم گرفت که نشانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 607.73,
   "end": 615.95,
   "text": "حاکمان صالحه. که البته حاکمانی که غیر از این باشند و ناسالح باشند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 615.95,
   "end": 618.19,
   "text": "اون‌ها هم خب \"إن الإنسان ليزغ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 618.19,
   "end": 621.45,
   "text": "اون‌ها طغیان می‌کنند وقتی به قدرت می‌رسند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 621.45,
   "end": 624.53,
   "text": "و ادعاشون هم دروغین از آب در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 624.53,
   "end": 629.51,
   "text": "یا آیه دویست و پنج سوره بقره باید باشه که \"وإذا تولى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 629.51,
   "end": 632.59,
   "text": "سعى فى الأرض ليفسد فيها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 632.59,
   "end": 635.27,
   "text": "اینایی که تو زمین به جا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 635.27,
   "end": 641.17,
   "text": "به جایگاهی می‌رسند به فساد کشیده، سراغ فساد میرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 641.17,
   "end": 645.25,
   "text": "در زمین فساد می‌کنند. \"ويهلك الحرث والنسل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 645.25,
   "end": 648.67,
   "text": "این‌ها هلاک می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 648.67,
   "end": 655.17,
   "text": ". زمین‌ها رو، زمینه‌ها رو از بین می‌برن، بسترها رو از بین می‌برن، نسل رو نابود می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 655.17,
   "end": 657.83,
   "text": "\"أئمة يدعون إلى النار\" اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 657.83,
   "end": 659.45,
   "text": "سمت آتش هدایت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 659.45,
   "end": 661.59,
   "text": "آیه چهل و یک سوره قصص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 661.59,
   "end": 666.25,
   "text": "\"أئمة يدعون إلى النار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 666.25,
   "end": 669.15,
   "text": "اما حکومت صالحین این چنین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 669.15,
   "end": 672.63,
   "text": "حکومت صالحین میاد اقامه صلاة می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 672.63,
   "end": 679.05,
   "text": "در کل در این اقامه نماز جماعت جمع بین قلوب پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 679.05,
   "end": 681.15,
   "text": "و یکی از حکمت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 681.15,
   "end": 686.01,
   "text": "ثواب بسیار زیاد و عجیبی که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 686.01,
   "end": 688.87,
   "text": "در اقامه صلاة گذاشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 688.87,
   "end": 692.33,
   "text": "که وقتی دو نفر بشن صد و بیش از صد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 692.33,
   "end": 697.19,
   "text": "رکعت ثواب همینطوری هرچی بیشتر میشه تا وقتی که به ده نفر رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 697.19,
   "end": 700.83,
   "text": "دیگه حدیث مشهوری‌ست قطعاً شنیدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 700.83,
   "end": 704.17,
   "text": "تا اگر تمام ملائکه که کثرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 704.17,
   "end": 708.81,
   "text": "کثرت خلق خدا بیشتر به اینا اختصاص داده شده، بیشترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 708.81,
   "end": 711.83,
   "text": "خلق خدا هستند، بشوند نویسنده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 711.83,
   "end": 719.73,
   "text": "اقیانوس‌های بیکران مرکب و این قلم نباتات و درختان و اینا همه بشوند قلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 719.73,
   "end": 722.41,
   "text": "ثواب یک رکعتشو نمی‌تونن برس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 722.41,
   "end": 725.17,
   "text": "بنویسن. این از این جهت هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 725.17,
   "end": 727.49,
   "text": "در حقیقت به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 727.49,
   "end": 731.33,
   "text": "قلب مألوف انسان رو نزدیک می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 731.33,
   "end": 738.51,
   "text": "و جالبه که به اون کسی هم که جلو می‌ایسته و نماز اقامه میشه به اقتدای بر او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 738.51,
   "end": 743.58,
   "text": "بهش باید گفت امام جماعت، امام، پیشوا، جلودار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 743.58,
   "end": 747.04,
   "text": "مرکز قواست. مرکز تجمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 747.04,
   "end": 753.3,
   "text": "قواست که \"وَجَعَلْنَا لِلْمُتَّقِينَ إِمَامًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 753.3,
   "end": 758.0,
   "text": "دعای ثابت مولامون علی علیه الصلاة والسلام در قنوت‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 758.0,
   "end": 761.26,
   "text": "که متأسفانه الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 761.26,
   "end": 764.08,
   "text": "م-- بین ما مرسوم شده می‌گیم پیش نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 764.08,
   "end": 768.92,
   "text": "این پیش نمازی از اهل تسنن اومده که هر کی اومد می‌زنش جلو و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 768.92,
   "end": 770.76,
   "text": "و حالا هر کی بود. این اشتباه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 770.76,
   "end": 774.26,
   "text": "باید عدالت اون شخص محرز بشه برای انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 774.26,
   "end": 777.26,
   "text": "اهل اصرار بر گناه نباشه طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 777.26,
   "end": 782.16,
   "text": "علمش رو داشته باشه. اینه که تو لباس پیغمبر قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 782.16,
   "end": 784.56,
   "text": "یعنی باید این علم رو خونده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 784.56,
   "end": 788.28,
   "text": "علم دین رو، تخصص در دین داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 788.28,
   "end": 791.7,
   "text": "که بتواند امام جماعت شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 791.7,
   "end": 794.7,
   "text": "امام جماعت نه پیش نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 794.7,
   "end": 797.16,
   "text": "مرکز قوا می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 797.16,
   "end": 800.36,
   "text": "البته نکته‌ای رو هم بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 800.36,
   "end": 804.76,
   "text": "حالا نگاه تشنه بعضی از شما به من اینو می‌فهمونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 804.76,
   "end": 808.22,
   "text": "سطح بحث رو بالا ببرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 808.22,
   "end": 810.74,
   "text": "بزرگان اهل معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 810.74,
   "end": 814.42,
   "text": "فرمودن اون ثواب عجیبی که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 814.42,
   "end": 819.82,
   "text": "بر نماز جماعت مترتب کرده و وعده داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 819.82,
   "end": 824.2,
   "text": "وقتی‌ست که حقیقتاً قلب‌ها معلوف بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 824.2,
   "end": 827.58,
   "text": "یعنی جمع به مقام جمعی برسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 827.58,
   "end": 831.96,
   "text": "یعنی اگر ده نفر در نماز جماعت شرکت کردند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 831.96,
   "end": 834.84,
   "text": "واقعاً ده تا قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 834.84,
   "end": 839.08,
   "text": "به تألیف برسد، معلوف بشود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 839.08,
   "end": 843.24,
   "text": "انس و الفت با توحید صمدی حضرت حق پیدا کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 843.24,
   "end": 846.68,
   "text": "خودش را در محضر تام خدا ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 846.68,
   "end": 849.24,
   "text": "همه به یک سمت، به یک قبله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 849.24,
   "end": 852.1,
   "text": "به توجه عرفانی بنشینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 852.1,
   "end": 855.46,
   "text": "خالی از اوغاها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 855.46,
   "end": 858.1,
   "text": "عرض شود شلوغی‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 858.1,
   "end": 861.24,
   "text": "افکار و تخیلات و توهمات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 861.24,
   "end": 864.84,
   "text": "که البته امان از این قوه تخیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 864.84,
   "end": 868.16,
   "text": "تو اینجور موارد. حالا ما متأسفانه یکی از دلایل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 868.16,
   "end": 874.32,
   "text": "خلوتی مساجد رو بداخلاقی بعضی از پیشکسوت‌ها می‌دونیم که نمی‌تونند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 874.32,
   "end": 877.8,
   "text": "شلوغی مثلاً نوجوون‌ها رو بربی-- برتو-- برتابند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 877.8,
   "end": 884.52,
   "text": "خب این خیلی بده. حالا شما مثلاً بگو آقا بچه شلوغ نکن من حواسم تو نماز پرت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 884.52,
   "end": 889.18,
   "text": "آقا نمی‌دونم این در و پنجره رو ببند صدا از بیرون نیاد حواس من پرت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 889.18,
   "end": 892.42,
   "text": "آقا حتی بعضیا به بغل دستی‌شون تذکر میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 892.42,
   "end": 894.86,
   "text": "ذکرتو، نمازتو آروم بخون حواس من پرت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 894.86,
   "end": 897.84,
   "text": "آقا این تسبیحات حضرت زهرا سلام الله علیها رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 897.84,
   "end": 902.02,
   "text": "جمع‌خوانی می‌کنید که هدف ما هم یکیش همین تألیف قلوب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 902.02,
   "end": 904.16,
   "text": "آقا آروم بخونید حواس ما پرت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 904.16,
   "end": 906.36,
   "text": "اینا آقا حالا این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 906.36,
   "end": 911.96,
   "text": "که البته همه \"يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 911.96,
   "end": 913.76,
   "text": "آقا اینا تسبیح الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 913.76,
   "end": 917.94,
   "text": "از صدای شرشر آب بگیر تا صدای قارقار کلاغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 917.94,
   "end": 920.7,
   "text": "تا شلوغی این بچه‌ها مشغول تسبیح الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 920.7,
   "end": 924.96,
   "text": "این‌ها در حقیقت ظهور حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 924.96,
   "end": 927.2,
   "text": "این‌ها آیات الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 927.2,
   "end": 929.82,
   "text": "شؤون و بروز حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 929.82,
   "end": 931.42,
   "text": "چطور این‌ها رو دست کم می‌گیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 931.42,
   "end": 936.06,
   "text": "چطور در نماز این‌ها رو می‌شنوی از خدا غافل می‌شی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 936.06,
   "end": 941.1,
   "text": "خب اصلاً بگو که آقا همه این همهمه‎ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 941.1,
   "end": 947.74,
   "text": "شلوغی‌ها رو خوابوندی که آقا حضرت آقا می‌خوان یه الله اکبر بگن به آقا، به خدا وصل بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 947.74,
   "end": 949.74,
   "text": "با قوه خیالت چه می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 949.74,
   "end": 952.2,
   "text": "با بازیگری قوه خیالت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 952.2,
   "end": 955.28,
   "text": "حالت نماز چه می‌کنی؟ که گاهی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 955.28,
   "end": 957.3,
   "text": "پشت میز کار و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 957.3,
   "end": 959.9,
   "text": "نمی‌دونم مغازه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 959.9,
   "end": 964.36,
   "text": "بازار و گاهی در خانواده و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 964.36,
   "end": 969.36,
   "text": "شلوغی مردم و به فکر چک‌ش و به فکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 969.36,
   "end": 977.0,
   "text": "جواب دادن به فلانی و چه و چه و خواب و خوراک و این‌هاش و اصلاً توجهی به نماز نه-- اون‌ها، با اون‌ها چه می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 977.0,
   "end": 980.82,
   "text": "باید پیاده بشه این حقایق در انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 980.82,
   "end": 982.88,
   "text": "خب اذیتتون نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 982.88,
   "end": 986.94,
   "text": "پس یکی از جاهایی که انسان به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 986.94,
   "end": 989.7,
   "text": "قلب معلوف می‌رسد عزیزان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 989.7,
   "end": 992.22,
   "text": "اقامه نماز می‌باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 992.22,
   "end": 995.38,
   "text": "اونم به صورت جماعت که بسیار برکات دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 995.38,
   "end": 998.6,
   "text": "حالا تو این آخر کاری یه خاطره‌ای هم برای شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 998.6,
   "end": 1002.36,
   "text": "فرصت کوتاهی بدید. اونم اینکه یادش بخیر حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1002.36,
   "end": 1007.18,
   "text": "شاید بیست و پنج شش سال پیش بود ما محضر حضرت آیت الله مظاهری اصفهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1007.18,
   "end": 1011.24,
   "text": "می‌رفتیم درس می‌خوندیم البته در مدرسه صدر اصفهان که مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1011.24,
   "end": 1014.5,
   "text": "فیضیه قم از قدیمی‌ترین مدارس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1014.5,
   "end": 1018.28,
   "text": "مطرح و خوب اصفهان هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1018.28,
   "end": 1020.6,
   "text": "اونجا حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1020.6,
   "end": 1022.82,
   "text": "عبته شیرازی که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1022.82,
   "end": 1026.4,
   "text": "گمانم در حرم حضرت معصومه سلام الله علیها دفن باشن روحشون شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1026.4,
   "end": 1032.68,
   "text": "زهرا که نماز می‌خوندن، یه روز با اون هیبت علمایی و ریش سفید و عظمت که داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1032.68,
   "end": 1035.44,
   "text": "بین دو نماز بلند شدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1035.44,
   "end": 1041.16,
   "text": "و با یک حالتی فرمودند که به خدا قسم همه این‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1041.16,
   "end": 1044.04,
   "text": "شور و نوا در مساجد ایجاد می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1044.04,
   "end": 1046.28,
   "text": "باعث گرم شدن سفره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1046.28,
   "end": 1052.54,
   "text": "نمازگزاران و خانه خدا می‌شن، این‌ها قیامت یه سر و گردن از ما بالاترند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1052.54,
   "end": 1058.58,
   "text": "این‌هایی که اذان میدن، دعا می‌خونن، \"إِنَّ اللَّهَ وَمَلَائِكَتَهُ يُصَلُّونَ عَلَى النَّبِيِّ\" میگن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1058.58,
   "end": 1060.78,
   "text": "صلوات بلند میگن، دعا می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1060.78,
   "end": 1062.78,
   "text": "این‌ها مسجد رو آماده می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1062.78,
   "end": 1065.58,
   "text": "ما چه کردیم؟ ما برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1065.58,
   "end": 1069.34,
   "text": "اینکه تعظیم شعائر الهی کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1069.34,
   "end": 1073.08,
   "text": "\"فَإِنَّهَا مِنْ تَقْوَى الْقُلُوبِ\" از نشانه تقوای الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1073.08,
   "end": 1076.36,
   "text": "چه کردیم ما برای این مساجد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1076.36,
   "end": 1079.78,
   "text": "محل سجده در برابر حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1079.78,
   "end": 1083.08,
   "text": "چه کردیم؟ چه خدمتی به این مساجد کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1083.08,
   "end": 1086.66,
   "text": "که یکی از عزیزانی که در قرآن خدا می‌ستاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1086.66,
   "end": 1088.8,
   "text": "کسانی‌اند که تعمیر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1088.8,
   "end": 1091.74,
   "text": "عمران و آبادی مساجد را انجام می‌دهند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1091.74,
   "end": 1094.26,
   "text": "که بهترین، به بهترین وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1094.26,
   "end": 1097.4,
   "text": "با حضورشون، با پول خرج کردن‌شون، با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1097.4,
   "end": 1104.06,
   "text": "خدمتی‌شون، با عرض شود شور و نوا ایجاد کردن و اکثراً ماها مصرفی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1104.06,
   "end": 1108.5,
   "text": "بیایم یه حاج آقایی جلو وایسته نماز رو بخونیم و یا علی از تو خداحافظ شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1108.5,
   "end": 1113.56,
   "text": "این که نشد که. بالاخره باید زحمت کشید، پول خرج کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1113.56,
   "end": 1116.16,
   "text": "حضور پیدا کرد، وقت گذاشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1116.16,
   "end": 1118.26,
   "text": "و، و، و. انشاالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1118.26,
   "end": 1119.8,
   "text": "عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1119.8,
   "end": 1122.16,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}