 },
 "chapters": [
  {
   "index": 0,
   "title": "## تألیف قلوب؛ کار خداست نه تلاش ما",
   "start": 1.04,
   "end": 357.12
  },
  {
   "index": 1,
   "title": "## دو شرط؛ ایمان و عمل صالح",
   "start": 357.12,
   "end": 582.85
  },
  {
   "index": 2,
   "title": "## خداست و خدایی می‌کند؛ توحید صمدی",
   "start": 582.85,
   "end": 889.48
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.04,
   "end": 4.52,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.52,
   "end": 9.54,
   "text": "السلام علیک یا داعی الله و ربانی ایه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.54,
   "end": 11.34,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.34,
   "end": 17.18,
   "text": "موضوع قلب مألوف رو به فضل الهی سفره‌ش رو دیگه جمع کنیم و واگذار کنیم به حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.18,
   "end": 25.56,
   "text": "اگرچه هرچی جلوتر میریم بر اساس آیات و روایات و گفته‌ها بزرگان هی این دریا هم عمیق‌تر و خطیرتر می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.56,
   "end": 28.34,
   "text": "ژرف‌تر می‌شه و هم موّاج‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.34,
   "end": 31.54,
   "text": "لذا بهتر این هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.54,
   "end": 33.96,
   "text": "دامن خودمون رو جمع کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.96,
   "end": 37.34,
   "text": "امر رو به صاحبش واگذار و به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.34,
   "end": 43.16,
   "text": "میزان اکتفا و بسنده کنیم تا یار که را خواهد و میلش به که باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.16,
   "end": 49.52,
   "text": "البته ما فقط یک آیه از آیات مربوط به قلب مألوف رو موفق شدیم تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.52,
   "end": 52.22,
   "text": "چند جلسه بیان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.22,
   "end": 61.8,
   "text": "نکته‌ای رو که فقط در جمع‌بندی عرض می‌کنم اون هم این هستش که بر اساس آیات خصوصاً آیه‌ی صد و سه سوره آل عمران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.8,
   "end": 68.02,
   "text": "و شصت و سه انفاق، موضوع تألیف قلوب به خود خدای منان نسبت داده شده؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.02,
   "end": 76.5,
   "text": "یعنی کار، کار خداست. البته بنده زحمتش رو می‌کشه، تلاشش رو می‌کنه، تیر رو می‌اندازه اما و ما رأیتَ إذ رمیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.5,
   "end": 78.64,
   "text": "ولکن الله رمى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.64,
   "end": 83.6,
   "text": "اون کسی که تیر رو پرت می‌کنه به واقع خداست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.6,
   "end": 86.56,
   "text": "نه اعتباراً، حقیقتاً خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.56,
   "end": 91.74,
   "text": "که البته فهمش مهمه. حالا در آیه‌ی صد و سه سوره آل عمران می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.74,
   "end": 95.22,
   "text": "\"واعْتَصِمُوا بِحَبْلِ اللَّهِ جَمِيعًا وَلَا تَفَرَّقُوا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.22,
   "end": 100.5,
   "text": "یادش بخیر زمان جنگ چقدر این آیه بیان می‌شد، قرائت می‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.5,
   "end": 105.36,
   "text": "که به راه‌های متفرق نرید، همگی به رشته خدا چنگ بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.36,
   "end": 108.98,
   "text": "\"وَاذْكُرُوا نِعْمَتَ اللَّهِ عَلَيْكُمْ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.98,
   "end": 113.96,
   "text": "یادآور بشید نعمت بزرگی رو که خدا به شما کرد-- عطا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.96,
   "end": 119.78,
   "text": "که حالا این نعمت رو بیان می‌کنه که البته نعمت الله، نعمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 119.78,
   "end": 123.66,
   "text": "\"إِذْ كُنْتُمْ أَعْدَاءً\" شما دشمن بودید با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.66,
   "end": 126.7,
   "text": "\"فَأَلَّفَ بَيْنَ قُلُوبِكُمْ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.7,
   "end": 129.34,
   "text": "و خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.34,
   "end": 132.72,
   "text": "این نعمت بزرگی که به شما داده بود رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.72,
   "end": 138.52,
   "text": "این چنین داره تشریح می‌کنه که دل‌های-- بین دل‌های شما الفت و مهربانی قرار داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.52,
   "end": 143.04,
   "text": "\"فَأَلَّفَ بَيْنَ قُلُوبِكُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 143.04,
   "end": 147.98,
   "text": "فَأَصْبَحْتُمْ بِنِعْمَتِهِ إِخْوَانًا\" به این نعمت بزرگ ص--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.98,
   "end": 151.26,
   "text": "که کردید برادر دینی یکدیگر شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.26,
   "end": 155.88,
   "text": "یعنی همه کار، کار خداست و کنتم در حالی که چگونه بودید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.88,
   "end": 159.32,
   "text": "\"كُنْتُمْ عَلَى شَفَا حُفْرَةٍ مِنَ النَّارِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.32,
   "end": 161.76,
   "text": "در حالی که در پرتگاه آتش بودید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.76,
   "end": 164.92,
   "text": "\"فَأَنقَذَكُم مِّنْهَا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.92,
   "end": 171.82,
   "text": "خدا شما رو نجات داد و به این مرتبه رسوند که \"كَذَٰلِكَ يُبَيِّنُ اللَّهُ لَكُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.82,
   "end": 174.22,
   "text": "آيَاتِهِ\" الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.22,
   "end": 180.82,
   "text": "و خداست که این چنین آیاتش رو برای شما بیان می‌کنه \"لَعَلَّكُمْ تَهْتَدُونَ\" باشد که هدایت بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.82,
   "end": 186.58,
   "text": "این نشون میده که اولاً بحث هدایت نکات بسیار زیادی در این آیه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.58,
   "end": 189.74,
   "text": "منتها ما چون فرصتمون ضیق هست تبرّکاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 189.74,
   "end": 195.94,
   "text": "یکی دو تاش رو عرض کنیم. یکی اینکه نعمت هدایت بسته به توجه به آیات دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.94,
   "end": 199.48,
   "text": "اونم آیات‌هی، نه آیات مستقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.48,
   "end": 203.1,
   "text": "نکته دوم اینکه اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.1,
   "end": 208.38,
   "text": "جالبه که این تألیف قلوب رو خدای منان در این آیه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.38,
   "end": 213.72,
   "text": "آیات خودش \"يُبَيِّنُ اللَّهُ لَكُمْ آيَاتِهِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 213.72,
   "end": 215.72,
   "text": "به آیات خودش نسبت داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.72,
   "end": 221.02,
   "text": "یعنی در حقیقت این موضوع تألیف قلوب یکی از آیات الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.02,
   "end": 224.86,
   "text": "اول انقلاب یادتون هست چقدر دل‌های مردم به هم نزدیک بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 224.86,
   "end": 227.34,
   "text": "البته الان هم بین اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.34,
   "end": 231.12,
   "text": "چون این ف-- یک فرمول قطعی‌ست در قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.12,
   "end": 234.24,
   "text": "این در بین اهل ایمان هم الحمد لله هنوز هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.24,
   "end": 241.82,
   "text": "اگرچه مقدار بعضاً کمرنگ در اجتماع دیده می‌شه اما هنوز بین اهل ایمان اجتماعات ایمانی وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.82,
   "end": 244.12,
   "text": "که اینجا اگر دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.12,
   "end": 249.72,
   "text": "مستقیماً موضوع تألیف قلوب رو به خدای منان نسبت داده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 249.72,
   "end": 253.98,
   "text": "خدا به خودش نسبت داده. همچنین دو مرتبه به همین وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 253.98,
   "end": 259.88,
   "text": "در آیه‌ی شصت و سه سوره انفاق \"وَأَلَّفَ بَيْنَ قُلُوبِهِمْ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 259.88,
   "end": 265.54,
   "text": "یعنی دل‌ها این خدای منان الفت داد دل‌های اهل ایمان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 265.54,
   "end": 272.06,
   "text": "\"لَوْ أَنفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا\" اگه آنچه که در زمین هست، ثروت روی زمین رو شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 272.06,
   "end": 279.6,
   "text": "انفاق می‌کردی که این اتفاق بیفته، \"مَا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ\" اصلاً این الفت قلبی ایجاد نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 279.6,
   "end": 281.58,
   "text": "\"وَلَٰكِنَّ اللَّهَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 281.58,
   "end": 283.94,
   "text": "أَلَّفَ بَيْنَهُمْ\" این رو سره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 283.94,
   "end": 287.18,
   "text": "\"اللَّهَ أَلَّفَ بَيْنَهُمْ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 287.18,
   "end": 291.66,
   "text": "خداست که در حقیقت به معجزه خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 291.66,
   "end": 298.74,
   "text": "تألیف قلوب ایجاد کرده. البته \"إِنَّهُ عَزِيزٌ حَكِيمٌ\" اینکه خ-- چرا خدا انتهای آیه رو با اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 298.74,
   "end": 304.86,
   "text": "عزیز و حکیم خودش جمع کرده باز بحث هست که بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 304.86,
   "end": 307.24,
   "text": "موضوع قابل بحث اینجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 307.24,
   "end": 309.86,
   "text": "تألیف قلوب دست خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 309.86,
   "end": 313.78,
   "text": "و در حقیقت آنچه که ما دست و پا زدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 313.78,
   "end": 317.32,
   "text": "تلاش کردیم، گفتیم و شنیدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 317.32,
   "end": 322.28,
   "text": "عطش پیدا کردیم، تشنه شدیم، عاشق شدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 322.28,
   "end": 326.92,
   "text": "انگیزه پیدا کردیم که در مسیر رسیدن به مقام قلب مألوف حرکت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 326.92,
   "end": 332.22,
   "text": "به اون مقام جمعی، خروج از عادت، کندن از تعلقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 332.22,
   "end": 337.78,
   "text": "و موتو قبلاً تموتو دو بار تولد پیدا کردن و چه و چه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 337.78,
   "end": 340.38,
   "text": "می‌خوایم بهش برسیم. همش به دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 340.38,
   "end": 345.3,
   "text": "این آیات این مژده رو میده. این آرامش رو در انسان ایجاد می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 345.3,
   "end": 351.8,
   "text": "اگر می‌خوای تأثر پیدا کنی و اثر بگیری لا مؤثر فی الوجود، فی الوجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 351.8,
   "end": 357.12,
   "text": "الا الله. پس توجه به خدا کن، ناامید هم نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 357.12,
   "end": 360.24,
   "text": "اگر دو تا شرط لحاظ شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 360.24,
   "end": 363.46,
   "text": "خدای منان دست تو کار میاره، دل‌ها رو نزدیک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 363.46,
   "end": 365.74,
   "text": "بالاخره ما در کارهای اجتماعی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 365.74,
   "end": 370.13,
   "text": "کارهای جمعی که بسیاری از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 370.13,
   "end": 372.41,
   "text": "در حقیقت حتی عبادات ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 372.41,
   "end": 376.15,
   "text": "جمعی هستن. مثلا همین نماز جماعت و غیره، هیئت‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 376.15,
   "end": 380.61,
   "text": "جلسات این‌ها. در آیه نود و شش سوره مریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 380.61,
   "end": 386.07,
   "text": "خدا می‌فرماید \"إن الذين آمنوا وعملوا الصالحات\" این همون دو تا شرطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 386.07,
   "end": 388.43,
   "text": "دلدادگی می‌شه ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 388.43,
   "end": 398.03,
   "text": "بحث دله. دل بدی و \"وعملوا الصالحات\" البته تلاش کنی که \"أليس للإنسان ما سعي\" آیا برای انسان چیزی جز تلاشش هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 398.03,
   "end": 403.69,
   "text": "این دو تا شرط که اومد \"قطعاً سيجعل لهم الرحمن ودا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 403.69,
   "end": 409.49,
   "text": "این دل‌ها بینشون محبت شدید برقرار می‌شه توسط خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 409.49,
   "end": 412.33,
   "text": "که به اسم رحمان خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 412.33,
   "end": 414.77,
   "text": "این سفره‌ها رو، این کانال‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 414.77,
   "end": 421.77,
   "text": "وجودی رو به هم مرتبط می‌کنه که وقتی دیگه این کانال‌ها به هم مرتبط شدن وصل به اقیانوس و دریای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 421.77,
   "end": 426.89,
   "text": "یک لایتناهی شدن، دیگه اون‌ها هم دریا‌ن، موج دیگه دریاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 426.89,
   "end": 430.35,
   "text": "که اگر کسی بتونه با این دو شرط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 430.35,
   "end": 434.33,
   "text": "زانو بزنه در درگاه حضرت حق، دلدادگی، ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 434.33,
   "end": 439.77,
   "text": "و تلاش، عمل صالح، تنبل نباشه، همت بلند بداره و حرکت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 439.77,
   "end": 443.21,
   "text": "قطعاً خدا اصلاح امورش رو در دست می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 443.21,
   "end": 445.69,
   "text": "که یکی از این اصلاحات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 445.69,
   "end": 451.63,
   "text": "در حقیقت تألیف قلوب بین او و اجتماعات بین او و همسرش، فرزندانش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 451.63,
   "end": 456.01,
   "text": "اجتماع اهل ایمان. نمی‌شه یک امام جماعت مأمومین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 456.01,
   "end": 458.43,
   "text": "بهش علقه قلبی نداشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 458.43,
   "end": 461.75,
   "text": "نمی‌شه یک سخنران، یک مداح، یک مدیر، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 461.75,
   "end": 466.97,
   "text": "مسئول، یک پدر یک خانواده، یک م-- یک مادر یک خانواده، هرکس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 466.97,
   "end": 470.71,
   "text": "اون کسایی که به ظاهر تحت امرشن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 470.71,
   "end": 474.35,
   "text": "زیردستشن اون‌ها دوستش نداشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 474.35,
   "end": 477.35,
   "text": "اینطوری که سنگ رو سنگ بند نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 477.35,
   "end": 479.89,
   "text": "و البته خدا اصلاحات می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 479.89,
   "end": 481.71,
   "text": "و دل‌ها رو به هم متصل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 481.71,
   "end": 487.73,
   "text": "جالبه که در بحار جlde هفتاد و یک، صفحه سیصد و شصت و شش هم امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 487.73,
   "end": 495.73,
   "text": "یک حدیث بسیار زیبایی‌ست که می‌فرمایند \"من أصلح فيما بينه وبين الله\" هر کسی که رابطه‌ش رو با خدا اصلاح کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 495.73,
   "end": 503.07,
   "text": "بین او و بین خ-- او و خداش در حقیقت اصلاح بشه \"من أصلح فيما بينه وبين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 503.07,
   "end": 506.13,
   "text": "الله\" بین او و الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 506.13,
   "end": 511.15,
   "text": "حالا این که سری‌ست که چرا الله، بين الرحمن نه، بين الرحیم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 511.15,
   "end": 515.37,
   "text": "بين الله. اسم خاص که همه اسماء درشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 515.37,
   "end": 518.05,
   "text": "یعنی تمام اسماء الهی رو در خودش چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 518.05,
   "end": 520.77,
   "text": "پیاده کنه دیگه. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 520.77,
   "end": 527.87,
   "text": "اون موقع چه اتفاقی میفته؟ \"أصلح الله فيما بينه وبين الناس\" خدا هم دست به کار می‌شه و بین او و بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 527.87,
   "end": 531.83,
   "text": "الناس، همه مردم اصلاحگری ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 531.83,
   "end": 537.61,
   "text": "البته اینجا یک بخشیش در دنیا رخ می‌ده، یک بخشیش هنگام مرگ و بخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 537.61,
   "end": 543.39,
   "text": "شاید اعظمش بعد از مرگ که اون ارتباط عمیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 543.39,
   "end": 548.43,
   "text": "یکپارچگی نظام هستی رو اونجا درک می‌کنه که دل‌ها یک دل می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 548.43,
   "end": 550.99,
   "text": "و در حقیقت یک حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 550.99,
   "end": 554.45,
   "text": "رو می‌بینه که از قبل هم بود اما در غفلت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 554.45,
   "end": 557.25,
   "text": "غفلت همون حضوره، هیچ فرقی با هم نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 557.25,
   "end": 561.43,
   "text": "هر دو در حضورن اما غفلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 561.43,
   "end": 568.09,
   "text": "خبر نداره که در حضوره و الا حاضر، در حضوره، غافل هم در حضوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 568.09,
   "end": 572.27,
   "text": "غافل گرفتار غفلت شده، خبر از حضور نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 572.27,
   "end": 579.87,
   "text": "وقتی مرد خبر از حضور و اون مقام جمعی پیدا می‌کنه که باید در دنیا با رسیدن به قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 579.87,
   "end": 582.39,
   "text": "معلوف به اون حقیقت دست پیدا می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 582.39,
   "end": 587.69,
   "text": "به هر حال نکته مهمی که ما اینجا به فضل، به فضل الهی نیت داشتیم القا کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 587.69,
   "end": 594.79,
   "text": "این که همه چی رو خدا ببینیم و دست خدا-- هیچ چیزی رو مستقل از خدا نبینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 594.79,
   "end": 598.81,
   "text": "ب-- در دعای عرفه عرض کردیم حتی نگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 598.81,
   "end": 607.49,
   "text": "چیزهایی هستن، آیات و نشانه‌هایی از حضرت حق هستن که این‌ها مستقلن مثلاً محل ظهور خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 607.49,
   "end": 612.15,
   "text": "نه خیر، همه چی خود ظهور حضرت حقه که بحث‌هاش گذشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 612.15,
   "end": 616.01,
   "text": "و اساساً دست خدا رو در کار ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 616.01,
   "end": 617.87,
   "text": "خدا رو ببینیم و بس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 617.87,
   "end": 623.47,
   "text": "که \"لا حول ولا قوة إلا بالله العلي العظيم\" و مطلقاً ناامید نشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 623.47,
   "end": 629.53,
   "text": "که خدا، خداست و به قول عرفا خداست و خدایی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 629.53,
   "end": 632.17,
   "text": "و این رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 632.17,
   "end": 634.23,
   "text": "عرض کنم تبرکاً که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 634.23,
   "end": 637.67,
   "text": "خداست و خدایی می‌کند عزیزان دلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 637.67,
   "end": 640.09,
   "text": "درش لطافتی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 640.09,
   "end": 642.87,
   "text": "حالا شما این رو بستگی داره به چه نیتی ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 642.87,
   "end": 644.65,
   "text": "من یه مثالی بزنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 644.65,
   "end": 651.57,
   "text": "چون بسیاری از عزیزانی که بعداً این صحبت‌ها به دستشون می‌رسه، در کانال‌ها بارگذاری می‌کنند دوستان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 651.57,
   "end": 655.91,
   "text": "بالاخره غالباً بچه‌های هیئتی و مجلس‌دار و این‌ها هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 655.91,
   "end": 659.23,
   "text": "شما ببینید یک وقت هست ما مجلسی میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 659.23,
   "end": 662.37,
   "text": "و مثلاً می‌گیم که خدایا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 662.37,
   "end": 665.53,
   "text": "میریم هیئت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 665.53,
   "end": 668.71,
   "text": "عبادت انجام میدیم، زیارت انجام میدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 668.71,
   "end": 674.09,
   "text": "برای امام حسین گریه می‌کنیم، نماز می‌خونیم، توسل می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 674.09,
   "end": 677.83,
   "text": "حالا شما به این عبادت ما توجه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 677.83,
   "end": 682.11,
   "text": "خب؟ یک وقت هست در حقیقت فعل و انفعالات خودت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 682.11,
   "end": 687.57,
   "text": "مستقل از خدا دیدی، حالا میگی خدا توجه کنه به کارهای تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 687.57,
   "end": 689.79,
   "text": "که این باز می‌شه همون توحید عددی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 689.79,
   "end": 696.65,
   "text": "یعنی توحید ناب و توحید صمدی به تعبیر presto علم حسن زاده حفظه الله تعالی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 696.65,
   "end": 698.61,
   "text": "حالا یه پله بالاتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 698.61,
   "end": 706.13,
   "text": "این می‌شه این که خدایا من میرم مثلاً منبر میرم مداحی می‌کنم، سخنرانی می‌کنم، مدیریت می‌کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 706.13,
   "end": 710.13,
   "text": "تلاش می‌کنم مثلاً دل‌ها بشکنه به تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 710.13,
   "end": 714.17,
   "text": "متمایل بشه، تو رو بهتر بشناسه این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 714.17,
   "end": 716.67,
   "text": "تو کمکم کن در این کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 716.67,
   "end": 719.95,
   "text": "ببینید یعنی تو \"لا مؤثر في الوجود إلا الله\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 719.95,
   "end": 722.87,
   "text": "تو کمک کن. بعضیا معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 722.87,
   "end": 727.53,
   "text": "\"لا حول ولا قوة إلا بالله العلي العظيم\" رو اینطوری می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 727.53,
   "end": 731.39,
   "text": "من کارهامو انجام میدم، تو کمکم کن که درست انجام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 731.39,
   "end": 732.97,
   "text": "اینم باز می‌شه توحید عددی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 732.97,
   "end": 736.24,
   "text": "اینم استقلال وجودی برای خودت قائل شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 736.24,
   "end": 741.74,
   "text": "لذا وقتی بسیاری از ما ازمون تعریفی می‌شه، تنجیدی می‌شه این‌ها به خودمون برمی‌گردونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 741.74,
   "end": 748.2,
   "text": "نه به خدا. در حالی که ما باید همیشه لبمون تر باشه به این آیه بسیار کو-- رهگشا و کارگشا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 748.2,
   "end": 753.82,
   "text": "که \"ما أصابک من حسنة فمن الله\" مطلق آنچه که حسنه به تو می‌رسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 753.82,
   "end": 758.54,
   "text": "از الله است و \"ما أصابک من سیئة فمن نفسك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 758.54,
   "end": 762.62,
   "text": "آنچه که از سیئه به تو اصابت می‌کنه از نفس خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 762.62,
   "end": 765.42,
   "text": "این خیلی فهمش مهمه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 765.42,
   "end": 769.32,
   "text": "دیگه بلندای قله تقوای عرفاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 769.32,
   "end": 776.08,
   "text": "حالا اینجا درست می‌شه که ما بگیم خدایا-- ببینید تا حالا همچین نیتی کردید شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 776.08,
   "end": 778.92,
   "text": "خدایا من میرم مثلا منبر صحبت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 778.92,
   "end": 782.34,
   "text": "من میرم منبر خودت صحبت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 782.34,
   "end": 784.74,
   "text": "ببینید این چقدر با اون فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 784.74,
   "end": 787.48,
   "text": "خدایا تو صحبت کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 787.48,
   "end": 789.84,
   "text": "تو بشنو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 789.84,
   "end": 794.4,
   "text": "تو تأثیر کن، تو تأث-- تو تأثیر بگیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 794.4,
   "end": 799.32,
   "text": "تو ناله بزن، تو اشک بریز، تو گریه کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 799.32,
   "end": 802.54,
   "text": "تو جلوه کن، تو ظهور کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 802.54,
   "end": 804.34,
   "text": "ببینید این‌ها با هم فرق می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 804.34,
   "end": 809.06,
   "text": "این می‌شه توحید صمدی. اساسا چیزی جز ظهور حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 809.06,
   "end": 811.94,
   "text": "در نظام اسمایی و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 811.94,
   "end": 814.2,
   "text": "دنیا و نشئه م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 814.2,
   "end": 815.94,
   "text": "طبیعت و ملک نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 815.94,
   "end": 818.7,
   "text": "همه ظهورند دیگه. ظهور او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 818.7,
   "end": 820.92,
   "text": "عین ظهور او هستند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 820.92,
   "end": 822.92,
   "text": "ابا عبدالله در دعای عرفه می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 822.92,
   "end": 824.58,
   "text": "این فهمش خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 824.58,
   "end": 828.58,
   "text": "امروز به فضل الهی نیت رو داشتیم و زور زدیم که بدانیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 828.58,
   "end": 832.14,
   "text": "هرچه هست خداست. لذا این که می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 832.14,
   "end": 835.3,
   "text": "خداست و خدایی می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 835.3,
   "end": 842.32,
   "text": "اینجاست که دیگه عارف به هر قدرتی هم دست پیدا کنه دست تصرف به نظام هستی باز نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 842.32,
   "end": 844.52,
   "text": "یه خود از تعلّمه، خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 844.52,
   "end": 849.36,
   "text": "تو نوجوانی در حقیقت جایگاهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 849.36,
   "end": 852.34,
   "text": "عرض شود طی الارض بهشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 852.34,
   "end": 858.14,
   "text": "اعطا شد اما مطلقا خودشون می‌فرمایند استفاده نکردند الا ظاهرا یک بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 858.14,
   "end": 860.26,
   "text": "استفاده نکردند. برای چی استفاده کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 860.26,
   "end": 864.18,
   "text": "خداست و خدایی می‌کند. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 864.18,
   "end": 870.28,
   "text": "انشاالله که خدای منان به فضل و کرمش با ما رفتار کنه و همین مقدار قلیلی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 870.28,
   "end": 873.84,
   "text": "در دریای مواج معارف خاصه در وادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 873.84,
   "end": 876.04,
   "text": "و سیطره قلب معروف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 876.04,
   "end": 880.1,
   "text": "ما شناگری کردیم و از ما بپذیرد که کلا فی فلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 880.1,
   "end": 884.32,
   "text": "یسبحون، همه در حال شناگری در وجه حضرت حق هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 884.32,
   "end": 887.1,
   "text": "انشاالله عاقبت بخیر، خیر باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 887.1,
   "end": 889.48,
   "text": "به برکت صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}