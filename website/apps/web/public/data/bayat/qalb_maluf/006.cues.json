 },
 "chapters": [
  {
   "index": 0,
   "title": "## قضای روزهٔ فراموش‌شده؛ حداقلِ یقینی",
   "start": 9.7,
   "end": 75.88
  },
  {
   "index": 1,
   "title": "پیرامون قلب معروف به فضل الهی، آیهٔ پنجاه‌وسه فصلت بسیار تأمل‌برانگیز است:",
   "start": 75.88,
   "end": 159.94
  },
  {
   "index": 2,
   "title": "## توحید صمدی؛ یک وجود و آثار او",
   "start": 159.94,
   "end": 180.08
  },
  {
   "index": 3,
   "title": "## یهدی و یضل در خوانش ابن‌عربی",
   "start": 180.08,
   "end": 468.42
  },
  {
   "index": 4,
   "title": "## زیارت حسنین؛ السلام علیک ایها الحق",
   "start": 468.42,
   "end": 489.74
  },
  {
   "index": 5,
   "title": "## قلب مألوف و انس با آیات",
   "start": 489.74,
   "end": 570.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 5.6,
   "text": "نستعین. السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.6,
   "end": 7.86,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.86,
   "end": 15.1,
   "text": "عزیزی پرسید که اگر کسی فراموش کرده چه تعداد روزهایی رو روزه‌ش قضا شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.1,
   "end": 18.06,
   "text": "یا نگرفته، حالا یا بچه‌ش یا خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.06,
   "end": 20.62,
   "text": "یا پدر مادرش که حالشون خوب نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.62,
   "end": 25.92,
   "text": "حالا می‌خواد روزه قضاشو بگیره فراموش کرده یا ننوشته اینا چه کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.92,
   "end": 33.64,
   "text": "نظر آقا و مراجع این هستش که اون حداقلی که یقین دارد، این دو تا رو در نظر داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.64,
   "end": 36.38,
   "text": "یکی حداقل نه حداکثر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.38,
   "end": 41.04,
   "text": "یکی هم یقین. یعنی باید یقین کنه که حداقل مثلا این چه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.04,
   "end": 43.68,
   "text": "چهار روز، پنج روزو حتما دیگه داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.68,
   "end": 45.42,
   "text": "به همون میزان اکتفا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.42,
   "end": 47.82,
   "text": "مگر اینکه بخواد احتیاط کنه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.82,
   "end": 52.74,
   "text": "اشکال نداره خواست احتیاط کنه بیشتر بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.74,
   "end": 60.06,
   "text": "نکته‌ی دیگه‌ای که پیرامون قلب معروف به فضل الهی امروز عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.06,
   "end": 65.82,
   "text": "توجه به این آیه‌ی عجیبیه که خیلی فکر منو مشغول کرده به خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.82,
   "end": 69.16,
   "text": "و از شما دعوت می‌کنم که روی این آیه کار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.16,
   "end": 72.6,
   "text": "می‌فرماید که آیه پنجاه و سه سوره فصلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.6,
   "end": 75.88,
   "text": "\"سنریهم\" اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.88,
   "end": 78.84,
   "text": "سین و صوفه مال آینده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.84,
   "end": 81.0,
   "text": "به شما خواهیم نشان داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.0,
   "end": 84.58,
   "text": "چی رو؟ آیاتنا، نشانه‌های ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.58,
   "end": 86.64,
   "text": "\"فی آفاق و فی أنفس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.64,
   "end": 91.9,
   "text": "اون نظام آفاقی و انفسی که عرض کردیم دو تا کتابی که کتاب آفاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.9,
   "end": 95.92,
   "text": "و کتاب ن-- انفسی که این‌ها باید مطالعه بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.92,
   "end": 102.04,
   "text": "می‌گه ما آیاتمون رو در این‌ها یعنی این قرآن آفاقی یا قرآن هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.04,
   "end": 106.5,
   "text": "یا قرآن انفسی رو که آیات ما درش نوشته شده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.5,
   "end": 109.12,
   "text": "به شما خواهیم نشان داد که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.12,
   "end": 111.62,
   "text": "عجیبه این تیکه‌ی آیه. \"حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.62,
   "end": 117.18,
   "text": "یتبین\". تا اینکه روشن بشه \"لهم\" برای این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.18,
   "end": 120.66,
   "text": "برای این-- یعنی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.66,
   "end": 122.42,
   "text": "انسان‌ها این روشن بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.42,
   "end": 124.38,
   "text": "چی؟ \"أنه الحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.38,
   "end": 128.3,
   "text": "\"أنه الحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.3,
   "end": 137.02,
   "text": "یعنی تمام این آفاق و انفس و همه رو یکپارچه یک نظام بگیر که او حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.02,
   "end": 140.46,
   "text": "نمی‌فرماید به حق است، می‌فرماید بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.46,
   "end": 145.24,
   "text": "حق است. توجه بفرمایید به این نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.24,
   "end": 148.6,
   "text": "مثلا منصور حلاج بیچاره گفت أنا الحق دارش زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.6,
   "end": 151.88,
   "text": "نفهمیدن چی داره میگه. این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.88,
   "end": 156.42,
   "text": "داره میگه این نزا-- أنه الحق نمیگه أنهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.42,
   "end": 158.72,
   "text": "اینا تک تک‌شون ح-- مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.72,
   "end": 167.7,
   "text": "حق‌اند یا به حق‌اند بلکه همه رو یکپارچه یک نظام بگیر و این نظام احسن عالم که تو هم یکی از اج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.7,
   "end": 170.64,
   "text": "اجزاء اون‌ها هستی حق است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.64,
   "end": 173.46,
   "text": "نه به حق. اینا ترجمه‌اش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.46,
   "end": 175.9,
   "text": "مثلا شما الان خدا رو بخوای ف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.9,
   "end": 179.5,
   "text": "ترجمه کنی بهترین اسم که رو خدا می‌ذاری چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.5,
   "end": 182.36,
   "text": "براساس فلسفه بری جلو میگی وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.36,
   "end": 185.7,
   "text": "براساس عرفان بری جلو میگی حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.7,
   "end": 191.98,
   "text": "درسته؟ اینجا داره میگه این نظام احسن رو جدای از هم فرض نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.98,
   "end": 194.28,
   "text": "یکپارچه فرض کن و اسمش هم حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.28,
   "end": 197.38,
   "text": "قرآن داره میگه. نه اینکه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.38,
   "end": 202.62,
   "text": "نظام مثلا استغفرالله آفتاب خداست، زمین خداست، اینا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.62,
   "end": 205.34,
   "text": "اما جدای از خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.34,
   "end": 210.54,
   "text": "خدا هم جدای از این‌ها نیست که شما بری توی آسمون یه جایی دنبال خدا بگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.54,
   "end": 216.14,
   "text": "این حیرتی که انسان بهش دست میده در پس این آیه، این آیه‌ی عجیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.14,
   "end": 219.96,
   "text": "نشون میده که تمام نظام هستی یک وجود واحدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.96,
   "end": 224.0,
   "text": "باز توحید صمدی. ما به هر طرف میریم بر می‌خوریم به همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.0,
   "end": 228.28,
   "text": "توحید صمدیه که ابداعات حضرت علامه حسن زاده است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.28,
   "end": 230.48,
   "text": "که یک وجود واحد داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 230.48,
   "end": 233.06,
   "text": "بقیه آثار این وجودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.06,
   "end": 236.64,
   "text": "من و شما از آثار وجودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.64,
   "end": 238.78,
   "text": "که نمودار حضرت حقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.78,
   "end": 241.44,
   "text": "اصلا چیزی جز حق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.44,
   "end": 244.3,
   "text": "چیزی جز خدا و آثارش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.3,
   "end": 248.2,
   "text": "من و شما کی هستیم، چی هستیم که بخواهیم اظهار وجود کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.2,
   "end": 258.92,
   "text": "هرچی هست خداست. وقتی این چنین نگاه می‌کنی میگه به س-- به صحرا بنگرم صحرات بینم درستشه، نه صحرات بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.92,
   "end": 261.24,
   "text": "به دریا بنگرم دریات بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.24,
   "end": 264.12,
   "text": "هر طرف نگاه می‌کنی خدا می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.12,
   "end": 268.56,
   "text": "لذا حضرت علامه می‌فرمایند که خدا رو ش-- الهی شکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.56,
   "end": 271.42,
   "text": "که دیده‌ی جهان‌بین ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.42,
   "end": 275.26,
   "text": "من اصلا جهان نمی‌بینم، یکپارچه خدا می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 275.26,
   "end": 278.22,
   "text": "این البته به کشف و شهود قلبی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.22,
   "end": 284.36,
   "text": "و وقتی حاصل می‌شه که تمام طبق سیر بحث و روزهای پیش که عرض کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.36,
   "end": 289.5,
   "text": "عقل انسان، عقل نظری بیاد برنامه‌ریزی کنه بر اساس سهء وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.5,
   "end": 293.28,
   "text": "بدن و قلب تو یه جوری برنامه‌ریزی کنه که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.28,
   "end": 297.3,
   "text": "دائما انشراح داشته باشی، شرح صدر، بسط وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.3,
   "end": 302.28,
   "text": "لذت ببری، زده نشی از عبادت و بندگی خدا تا بری جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.28,
   "end": 307.86,
   "text": "بعد یواش‌یواش چشمت به عالم به این گونه باز بشه که همه چی رو آیت حق ببینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.86,
   "end": 311.82,
   "text": "که همون معنای موت قبل انتموت‌ایه که حالا فردا درباره‌ش صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.82,
   "end": 313.6,
   "text": "خیلی شیرینه. مثلا یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.6,
   "end": 317.08,
   "text": "اون تولد دوباره‌ست که به قول حضرت عیسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.08,
   "end": 320.32,
   "text": "سلام الله علیه تا کسی دو بار متولد نشه به اون کمالات نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 320.32,
   "end": 323.92,
   "text": "حالا بعدا بحث می‌کنیم. همه چی رو باید آیت حق دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.92,
   "end": 325.9,
   "text": "این چیز دشواری هم نیست‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.9,
   "end": 329.8,
   "text": "یعنی اگر یه مقدار به فکرمون، به مغزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.8,
   "end": 333.48,
   "text": "فشار بیاریم تو سختی، عقل مال سختی‌هاست دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.48,
   "end": 337.5,
   "text": "برسونیش به حوزه‌ی قلب، به حس حضور برسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.5,
   "end": 339.76,
   "text": "عالم رو محضر خدا می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 339.76,
   "end": 345.66,
   "text": "یه جمله‌ی ثقیله البته، خیلی دشواره اما چون جاشه دیگه عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 345.66,
   "end": 348.56,
   "text": "چون حضرت امام بزرگ ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 348.56,
   "end": 357.24,
   "text": "این عزیز خدا روحش شاد کنه که گردن ما حق حیات داره به عظمت از ابن عربی یاد می‌کرد، ما هم یاد می‌کنیم چرا نکنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.24,
   "end": 362.42,
   "text": "بذار سنگ‌سارمون هم بکنیم. ایشون توی کتاب فتوحاتش یه جمله‌ای--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.42,
   "end": 364.88,
   "text": "بحثی داره بین ذیل آیه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.88,
   "end": 370.48,
   "text": "\"إن الله يهدي من يشاء ويضل من يشاء\" خیلی عجیب سخن میگه اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.48,
   "end": 373.66,
   "text": "می‌فرماید يهدي من يشاء عده‌ی خدا هدایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.66,
   "end": 377.0,
   "text": "هرکی بخواد هدایت می‌کنه. کیا رو هدایت می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.0,
   "end": 379.12,
   "text": "کی نیاز به هدایت داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 379.12,
   "end": 381.74,
   "text": "کسی که به گمراهی رفته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.74,
   "end": 385.22,
   "text": "دقت-- توجه بکنید، یه نگاه جدیدی از آیه پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.22,
   "end": 387.56,
   "text": "کی نیاز داره که دستشو بگیری هدایتش کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.56,
   "end": 391.52,
   "text": "کسی که راه رو گم کرده. میگه \"یهدی میشها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.52,
   "end": 394.98,
   "text": "مال کساییه که توحید عددی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.98,
   "end": 397.06,
   "text": "همه چی رو یه چیزه، یه جدا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 397.06,
   "end": 401.94,
   "text": "انسان و ان-- جماد و حیوان و آسمان و زمین و اینا رو جدا فرض کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.94,
   "end": 403.72,
   "text": "بعد حالا دنبال خدا دارن می‌گردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.72,
   "end": 406.1,
   "text": "به قول استاد علامه کوکو می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.1,
   "end": 410.34,
   "text": "اما میگه تو هوهو کن. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.34,
   "end": 413.86,
   "text": "باید بری به جایی برسی که به مقام ضلالت برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 413.86,
   "end": 416.18,
   "text": "عجب! چه ترجمه عجیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 416.18,
   "end": 419.94,
   "text": "این عارف به الله میگه \"و یضل میشها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 419.94,
   "end": 422.46,
   "text": "اون یض-- یضل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 422.46,
   "end": 425.16,
   "text": "مقام هیمانه، حیرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 425.16,
   "end": 427.36,
   "text": "یعنی همین توحید صمدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 427.36,
   "end": 431.6,
   "text": "یعنی خدا کسایی رو که محو در حضرت حق میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.6,
   "end": 434.98,
   "text": "هیچ چیزی نمی‌بینن جز خدا، اون‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 434.98,
   "end": 437.64,
   "text": "خدا به حالت ضلالت می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 437.64,
   "end": 442.9,
   "text": "ضلالت اینجا نه به معنای گمراهی‌ها، یعنی اصلاً راهی دیگه ندارن، کجا برن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 442.9,
   "end": 446.4,
   "text": "به هر طرف نگاه می‌کنند حق می‌بینن، خدا می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.4,
   "end": 452.04,
   "text": "آیه‌شم که الان خوندیم. \"یتبین لهم انه الحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 452.04,
   "end": 458.22,
   "text": "همه چی حق है. اصلاً جز خدا چیزی نیست که قبلاً بحث شد مقام ليلة القدر وجودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.22,
   "end": 464.58,
   "text": "جالبه که امروز زیارت امام حسن رو می‌خوندید، زیارات هر روز هفته رو می‌خونید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.58,
   "end": 468.42,
   "text": "امروز متوسل می‌شید به چ-- کدوم بزرگوارا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 468.42,
   "end": 471.32,
   "text": "امروز متعلق به امام حسن و امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 471.32,
   "end": 473.86,
   "text": "یه زیارت‌نامه کوچولو داره. بخونید اینا رو هر روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 473.86,
   "end": 475.98,
   "text": "بعد مهمان می‌کنی خودتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 475.98,
   "end": 483.2,
   "text": "جالبه، توفیق اجباری. میگی یا امام حسن، یا امام حسین ما مهمان شماییم، پناهنده به شماییم، فعظیفانی و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 483.2,
   "end": 488.04,
   "text": "و فاحسن مثلاً ضیافتی، بهترین مهمونی رو برای ما وفا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 488.04,
   "end": 490.54,
   "text": "فعجیرانی، ما رو پناه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.54,
   "end": 493.52,
   "text": "اونجا به امام حسن میگی \"السلام علیک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 493.52,
   "end": 498.84,
   "text": "دقت کنید \"السلام علیک ایها الحق الحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 498.84,
   "end": 501.46,
   "text": "تو حقی. امام حسن حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 501.46,
   "end": 504.94,
   "text": "نمیگی تو به حقی. اصلاً حقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.94,
   "end": 506.92,
   "text": "چیزی جز حق وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 506.92,
   "end": 509.38,
   "text": "یکی از شؤون حضرت حق امام حسنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 509.38,
   "end": 512.54,
   "text": "یکی از شؤون حضرت حق، یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 512.54,
   "end": 518.62,
   "text": "در حقیقت ش-- می‌شه گفت آثار حق، به یک معنا ظهور حق، به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 518.62,
   "end": 525.02,
   "text": "جلوه‌ی حق تو هستی. وقتی اینطوری نگاه کردی قلب به مقام شهود می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 525.02,
   "end": 527.28,
   "text": "اصطلاحاً بهش می‌گن قلب چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 527.28,
   "end": 529.0,
   "text": "شما بفرمایید. بحث ما چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 529.0,
   "end": 538.02,
   "text": "قلب معلوف. به انس و الفت با آیات خدا می‌رسی و همه‌ی نظام هستی رو یکپارچه می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 538.02,
   "end": 541.6,
   "text": "یک حقیقت می‌بینی که تو یک جزئی از اون‌ها هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 541.6,
   "end": 544.54,
   "text": "این نگاه ببین چقدر نگاه زیبا و شیرینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 544.54,
   "end": 547.88,
   "text": "اصلاً انسان احساس خطر می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 547.88,
   "end": 551.82,
   "text": "احساس پوچی می‌کنه؟ احساس بی‌هدفی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 551.82,
   "end": 556.28,
   "text": "همه چی رو دارای هدف که ربنا سبحانک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 556.28,
   "end": 558.92,
   "text": "ما خلقت هذا باطلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 558.92,
   "end": 561.76,
   "text": "سبحانک ربنا ما خلقت هذا باطلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 561.76,
   "end": 564.22,
   "text": "تو باطل نیافریدی این عالم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 564.22,
   "end": 570.76,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد. سلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}