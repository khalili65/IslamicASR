 "chapters": [
  {
   "index": 0,
   "title": "## فطریه؛ پول کنارگذاشته و اولویت اقربا",
   "start": 17.52,
   "end": 254.06
  },
  {
   "index": 1,
   "title": "## خادع نفسک فی العبادة",
   "start": 254.06,
   "end": 399.92
  },
  {
   "index": 2,
   "title": "## وضو و دو رکعت و دعا؛ جفا به حق",
   "start": 399.92,
   "end": 478.84
  },
  {
   "index": 3,
   "title": "## حفظ الفت با تنظیم سه جبهه",
   "start": 478.84,
   "end": 599.56
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.22,
   "end": 3.44,
   "text": "[سخنگوی 1] [سخنگوی 1] .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.44,
   "end": 6.42,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.42,
   "end": 9.88,
   "text": "یکی دیگه از موارد فسویه رو هم عرض کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.88,
   "end": 11.94,
   "text": "خیلی سؤال می‌شه در این خصوص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.94,
   "end": 15.84,
   "text": "اگر کسی فسویه رو کنار گذاشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.84,
   "end": 19.96,
   "text": "حالا یه وقت تعجب هم نکنید که هنوز بحث فسویه داریم می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.96,
   "end": 25.88,
   "text": "هنوزم که هنوزه بعضیا فسویه‌شون رو ندادن از سؤالاتی که از ما پرسیده می‌شه مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.88,
   "end": 28.5,
   "text": "اگر کسی فسویه‌ش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.5,
   "end": 31.22,
   "text": "کنار گذاشته باشه نقد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 31.22,
   "end": 36.7,
   "text": "چنین کسی دیگه نمی‌تونه به غیر از اون پولی که کنار گذاشته فسویه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.7,
   "end": 40.64,
   "text": "حتما باید اون پولی که کنار گذاشته رو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.64,
   "end": 43.78,
   "text": "دیگه نمی‌تونه کارت به کارت کنه از بانک انتقال بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.78,
   "end": 48.3,
   "text": "اما اگر کسی پول رو کنار نگذاشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.3,
   "end": 54.08,
   "text": "نیت کرده باشه از اون پولی که تو کارتشه انتقال بده، اون مشکلی نداره از هر کارتش و از هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.08,
   "end": 57.38,
   "text": "حسابش می‌تونه این رو انتقال بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.38,
   "end": 61.66,
   "text": "و نکته‌ی دیگه این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.66,
   "end": 63.88,
   "text": "اگر کسی اینم خیلی مهمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.88,
   "end": 70.78,
   "text": "امروز یه عزیزی هم سؤال کرد. اگر کسی تو محل خودش حالا البته نزدیک‌تر می‌شه فامیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.78,
   "end": 76.44,
   "text": "اگر کسی تو فامیل‌های نزدیکش فقیر داره نمی‌تونه فسویه رو بده به دیگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.44,
   "end": 79.08,
   "text": "باید تو فامیل‌های نزدیکش بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.08,
   "end": 84.42,
   "text": "و اگر کسی تو فامیلش فقیر نداره تو همسایه‌هاش داره باید بده به همسایه‌هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.42,
   "end": 89.7,
   "text": "یعنی اول می‌رسه به اقربا، نزدیکا، خویشان این‌ها و اگر توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.7,
   "end": 93.6,
   "text": "همسایه‌هاش، نزدیکانش، شهرش اینا نرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.6,
   "end": 95.46,
   "text": "اون موقع به شهرای دیگه می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.46,
   "end": 101.4,
   "text": "اینو حواستون جمع باشه. اینم آقا مجید فکر کنم اکو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.4,
   "end": 104.36,
   "text": "نکته‌ای رو عرض کنم که در ادامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.36,
   "end": 108.34,
   "text": "موضوع دیروز خیلی به درد بخور هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.34,
   "end": 113.58,
   "text": "به نظرم یکی از گرفتاری‌های ما مع-معمولاً همینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.58,
   "end": 117.04,
   "text": "وقتی قلبمون از حالت تألیف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.04,
   "end": 122.02,
   "text": "و اون مقام جمعی حالا اصطلاحاً بگیم حضور، می‌گن حضور قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.02,
   "end": 125.12,
   "text": "وقتی از این حالت حضور خارج می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.12,
   "end": 131.28,
   "text": "مثلاً تو شبای ماه مبارک رمضان می‌بینی حالت خوشی داری حالا اصطلاحاً حالا حضور خوبی داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.28,
   "end": 133.44,
   "text": "قلبت به حالت تألیف رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.44,
   "end": 136.74,
   "text": "انس و الفت با ذکر دعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.74,
   "end": 140.74,
   "text": "با اهل ایمان با درگاه خدا اون مقام جمعی رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.74,
   "end": 143.44,
   "text": "بعد از ماه مبارک رمضان این رفته رفته کم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.44,
   "end": 149.7,
   "text": "چرا؟ یه علتش رو مولامون امیرالمؤمنین صلوات الله علیه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.7,
   "end": 152.72,
   "text": "حکمت هفتاد نهج البلاغه بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.72,
   "end": 157.1,
   "text": "این یه دلیلشه. حضرت می‌فرماید لا تر الجاهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.1,
   "end": 160.52,
   "text": "إلا مفرطاً أو مفرطا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.52,
   "end": 163.46,
   "text": "جاهل رو نمی‌بینی مگر اینکه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.46,
   "end": 167.46,
   "text": "کوتاهی می‌کنه یا زیاده‌روی می‌کنه یعنی افراط و تفریط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.46,
   "end": 170.6,
   "text": "این کوتاهی کردن یا زیاده‌روی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 170.6,
   "end": 174.46,
   "text": "باعث می‌شه که قلب از حالت حضور دور بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 174.46,
   "end": 178.98,
   "text": "و طبق بحث دیروز حالا به نز-به نظم بحث بریم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.98,
   "end": 182.96,
   "text": "طبق بحث دیروزمون ما سه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.96,
   "end": 189.52,
   "text": "جبهه‌ی وجودی داشتیم که اینا باید به همدیگه کمک بدن که قلب تو اون حالت تألیف بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.52,
   "end": 194.06,
   "text": "یکیش بحث عقل بود، یکیش خود قلب بود، یکیش هم اعضا و جوارح بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.06,
   "end": 200.94,
   "text": "اعضا و جوارح در سیر بندگی و عبادتشون، اون عملیات بندگی، نماز، روزه، ذکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.94,
   "end": 205.92,
   "text": "صدقه دادن و غیره. عقل برنامه‌ریزی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.92,
   "end": 209.04,
   "text": "تا قلب به حضور و الفت برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.04,
   "end": 212.1,
   "text": "خب حالا عقل چگونه باید بیاد برنامه‌ریزی کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.1,
   "end": 215.72,
   "text": "اینجا نکته اینجاست. اونجا می‌گه جاهل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.72,
   "end": 219.3,
   "text": "جاهل یا به کوتاهی می‌افته یا به زیاده‌روی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.3,
   "end": 224.3,
   "text": "یعنی نمی‌تونه تنظیم کنه رابطه‌ی بین خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.3,
   "end": 228.04,
   "text": "ع-عقل وجودیش، رابطه بین خودش، عقلش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.04,
   "end": 230.98,
   "text": "با قلبش رو با اعضا و جوارحش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.98,
   "end": 234.04,
   "text": "این رابطه رو نمی‌تونه تنظیم کنه لذا می‌ریزه به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.04,
   "end": 237.6,
   "text": "یعنی چی؟ مثال می‌زنم. مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.6,
   "end": 242.54,
   "text": "کسی می‌بینه که آقا نمی‌تونه صدقه سنگین بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.54,
   "end": 246.36,
   "text": "صدقه نمی‌تونه سنگین بده. نمی‌تونه نماز شب طولانی بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.36,
   "end": 250.06,
   "text": "نمی‌تونه نماز پیغمبر بخونه که یک ساعت طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.06,
   "end": 251.9,
   "text": "نمی‌تونه این کارا سنگینه براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.9,
   "end": 255.32,
   "text": "خب این فرمایش مولا رو عمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.32,
   "end": 257.32,
   "text": "این فرمایش مولا رو هم برید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.32,
   "end": 265.12,
   "text": "دقیقش و تکمیلش حالا چون بخشیش رو من عرض می‌کنم ببینید خطبه شصت و نه نهج البلاغه چقدر مولا قشنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.12,
   "end": 268.46,
   "text": "زیرکانه و هوشمندانه به ما راهکار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.46,
   "end": 272.78,
   "text": "فرموده خادع نفسک في العبادة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.78,
   "end": 275.72,
   "text": "تو عبادت نفستو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 275.72,
   "end": 278.12,
   "text": "فریب بده. خادع، خودعه بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.12,
   "end": 281.62,
   "text": "نفست رو فریب بده که حالا توضیح میدم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.62,
   "end": 284.0,
   "text": "وارفق بها باهاش رفاقت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.0,
   "end": 286.82,
   "text": "مدارا کن با نفست. بهش فشار نیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.82,
   "end": 289.72,
   "text": "ولا تقهرها بهش شدت نگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.72,
   "end": 293.9,
   "text": "قهر نکن باهاش. سنگین نگیر یعنی زیاده‌روی نکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.9,
   "end": 297.62,
   "text": "وخذ عفها و نشاطها إلا ما کان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.62,
   "end": 300.2,
   "text": "مكتوبا عليك من الفريضة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.2,
   "end": 302.28,
   "text": "سعی کن اون نشاطش وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.28,
   "end": 308.14,
   "text": "نشاط داره اول بری سمت واجباته تا اونجایی که نشاط داره بری جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.14,
   "end": 311.98,
   "text": "وقتی می‌بینی نشاط داره می‌خوابه یعنی مثلاً تو سختته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.98,
   "end": 313.86,
   "text": "سختته صدهزار تومن صدقه بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.86,
   "end": 316.56,
   "text": "خب چرا میدی؟ چرا میدی که بعد حساب کتاب کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 316.56,
   "end": 320.14,
   "text": "ای کاش انقدر نمی‌دادم. ده هزار تومن بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 320.14,
   "end": 324.98,
   "text": "نفست رو گول بزن. مثلاً نماز شب نمی‌خونی، دو رکعت بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 324.98,
   "end": 327.68,
   "text": "قبل از اینکه بخوابی دو رکعت نماز بخون بخواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.68,
   "end": 329.86,
   "text": "نمی‌تونی پاشی. خرد خرد شروع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 329.86,
   "end": 335.4,
   "text": "این خادع نفسک در حقیقت عقلت دقت کنید این رابطه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.4,
   "end": 337.64,
   "text": "عقلت میاد نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.64,
   "end": 339.74,
   "text": "سعه‌ی وجودی یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 339.74,
   "end": 345.5,
   "text": "قلبتو که چه مقدار سعه داره، تا چه مقدار توان داره ب-بکشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.5,
   "end": 349.22,
   "text": "و حس حضورش رو از دست نده، الفتش از بین نره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.22,
   "end": 353.38,
   "text": "برنامه‌ریزی می‌کنه. دو، نسبت به اعضا و جوارحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.38,
   "end": 355.78,
   "text": "اعضا و جواره‌ت تو چه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 355.78,
   "end": 360.16,
   "text": "عبادت کنن، عملیات بندگی بکنن خسته نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.16,
   "end": 362.88,
   "text": "نسبت به همون عقل باید بیاد اینجا تدبیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 362.88,
   "end": 368.62,
   "text": "اگر عقل رو برداریم اونجا امیرالمؤمنین می‌فرما چی، از نشونه‌های جاهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 368.62,
   "end": 372.76,
   "text": "جاهل یعنی اینجا مشخصه که مقابل عقل قرار گرفته، جهل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.76,
   "end": 375.72,
   "text": "یعنی اگر کسی عقلش رو تعطیل کرد قربونت برم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 375.72,
   "end": 381.82,
   "text": "همینطوری کیلویی رفت به سمت عبادات و معذرت می‌خوام بحث‌های بندگی قطعاً زمین می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 381.82,
   "end": 383.58,
   "text": "هی می‌خوره زمین دوباره پا می‌شه هی می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 383.58,
   "end": 386.4,
   "text": "می‌گه نمی‌دونم چرا، چرا من همش نوسان دارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 386.4,
   "end": 388.76,
   "text": "موفق نیستم. چون عقلت تعطیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 388.76,
   "end": 392.74,
   "text": "عقلت نیومده کمک کنه این رابطه رو تنظیم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 392.74,
   "end": 395.54,
   "text": "این رابطه خیلی مهمه. من مثال می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 395.54,
   "end": 399.58,
   "text": "آقایون تو بحث‌های عبادی اینو مث-- امتحان کنید شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 399.58,
   "end": 403.02,
   "text": "مگر حدیث نداریم، این حدیث هم خیلی حدیث شریفیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 403.02,
   "end": 406.64,
   "text": "که خدا فرموده اگر بنده‌ی من رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 406.64,
   "end": 410.14,
   "text": "قضای حاجت کرد. حالا به قول ما مثلاً رفت مستراح هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 410.14,
   "end": 413.96,
   "text": "بعد وضو نگرفت بعدش به من جفا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 413.96,
   "end": 418.2,
   "text": "الان که الحمدالله دیگه همه از فرهنگ جبهه و جنگ برامون این باقی مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 418.2,
   "end": 423.28,
   "text": "یکی از هدایای بچه‌های شهدا تو جنگ این بود که دائم‌الوضو بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 423.28,
   "end": 425.3,
   "text": "شما رو هم انشاالله به این وادی کشوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 425.3,
   "end": 427.94,
   "text": "یه مقدار آسونه این تا اینجاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 427.94,
   "end": 434.0,
   "text": "بعد فر-- خدا فرمود اگر وضو گرفت نرفت دو رکعت نماز نخوند باز به من جفا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 434.0,
   "end": 439.98,
   "text": "حالا این دو رکعت نمازو نسبت به خود سعای قلبی خودت و اعضا و جوارحت باید بسنجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 439.98,
   "end": 443.6,
   "text": "می‌تونی تو راه بخونی. یه دقیقه هم شاید نکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 443.6,
   "end": 446.28,
   "text": "سوره‌ی قل هوالله‌شم حذف کن چون مستحبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.28,
   "end": 448.48,
   "text": "رکوع سجودش هم با ایماء و اشاره بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 448.48,
   "end": 452.58,
   "text": "یه سبحان الله هم بگو بسه. سی ثانیه طول می‌کشه ولی بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 452.58,
   "end": 455.2,
   "text": "چون می‌گه به من جفا کرده خدا فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 455.2,
   "end": 459.36,
   "text": "و اگر نماز بخونه بعد از نماز دعا نکنه باز به من جفا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 459.36,
   "end": 466.78,
   "text": "عجب! اما اینجا فرمود اگر این کارو کرد دعاشم کرد من خدا به اون جفا کردم اگه حاجتشو ندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 466.78,
   "end": 469.68,
   "text": "ببین چقدر آسونه. امتحان کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 469.68,
   "end": 474.72,
   "text": "این یه برنامه-- بسیاری از برنامه‌های مستمر ب-زندگی‌مون باشه تو بحث‌های عبادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 474.72,
   "end": 477.34,
   "text": "تا وضو گرفتیم یا بعدش اگه حال داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 477.34,
   "end": 480.2,
   "text": "حتی پشت میز کارت می‌تونی این کارو بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 480.2,
   "end": 484.84,
   "text": "می‌گه خاد نفسک. نفستو گول بزن با همین کارهای ریز ریز جزء جزء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 484.84,
   "end": 486.58,
   "text": "بعد غرور هم نمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 486.58,
   "end": 491.12,
   "text": "خوبیش اینه که پررو نمی‌شم بگم من مثلاً نماز پیغمبر خوندم، نماز جعفر طیار خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 491.12,
   "end": 493.14,
   "text": "نه. چه نمازی بود؟ تو راه خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 493.14,
   "end": 498.26,
   "text": "پشت میز کارم خوندم. ولی اون رو انجام بده یا اون طرحی که دیروز عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 498.26,
   "end": 501.56,
   "text": "هر وقت خواستی بری سراغ موبایلت یه صفحه قرآن بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 501.56,
   "end": 504.74,
   "text": "ببین تو یه روز شاید دو روز رو یک بار یه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 504.74,
   "end": 511.22,
   "text": "یه جزء قرآن می‌خونی. بعد هیچوقتم مدعی نمی‌شی من به به دیگه روزی انقدر قرآن می‌خونم و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.22,
   "end": 513.24,
   "text": "بعد بهتم فشار نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 513.24,
   "end": 518.88,
   "text": "نفست پس نمی‌زنه. اعضا و جوارحت خسته نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 518.88,
   "end": 524.86,
   "text": "مهم‌تر از اینکه قلبت از همه مهم‌تر، قلبت از حالت الفت خارج نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 524.86,
   "end": 526.8,
   "text": "اون انس و الفت رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 526.8,
   "end": 529.14,
   "text": "چون بحث ما قلب معلوفه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 529.14,
   "end": 531.8,
   "text": "قلبی که به حالت تعلیف رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 531.8,
   "end": 535.24,
   "text": "این نشاط عبادت همیشه برات باقی می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 535.24,
   "end": 537.88,
   "text": "حتی تو صدقه دادن به جای سنگین دادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 537.88,
   "end": 540.32,
   "text": "خرد خرد. اصلاً یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 540.32,
   "end": 543.24,
   "text": "اون روایاتی که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 543.24,
   "end": 548.06,
   "text": "صدقه طرد فعل بلا، بلا رو دفع می‌کنه صدقه‌ی دائمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 548.06,
   "end": 550.32,
   "text": "نه شما ماهی یک بار صدقه بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 550.32,
   "end": 552.04,
   "text": "دائم هر روز صدقه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 552.04,
   "end": 553.98,
   "text": "روزی دو بار صدقه، اما خرد خرد بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 553.98,
   "end": 558.24,
   "text": "هزار تومن بده. یه صندوق صدقه یه گوشه بذار هر روز بریز توش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 558.24,
   "end": 560.34,
   "text": "بعد جمع شد بده به یه فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 560.34,
   "end": 563.68,
   "text": "این راه‌ها باعث می‌شه که دقت کنید به کجا رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 563.68,
   "end": 567.68,
   "text": "تنظیم بین این سه تا جبهه‌ی وجودیت حفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 567.68,
   "end": 571.16,
   "text": "چرا؟ برای اینکه از الفت قلبی خارج نشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 571.16,
   "end": 574.98,
   "text": "از مقام جمعی حضور و سوز خارج نشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 574.98,
   "end": 580.92,
   "text": "عقل تدبیر می‌کنه نسبت به سعای وجودی اعضا و جواره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 580.92,
   "end": 584.32,
   "text": "و حس حضور قلب برنامه‌ریزی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 584.32,
   "end": 587.0,
   "text": "این‌ها رو به برنامه‌ریزی-- ب-بندگی می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 587.0,
   "end": 589.72,
   "text": "اگر عقل رو تعطیل کنی همش می‌خوری زمین پا می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 589.72,
   "end": 592.7,
