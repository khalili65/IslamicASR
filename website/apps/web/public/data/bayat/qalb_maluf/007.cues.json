   "title": "## نکته‌ای فقهی در روزهٔ زنان",
   "start": 12.78,
   "end": 77.06
  },
  {
   "index": 1,
   "title": "## قلب مألوف و تولد انسانی",
   "start": 77.06,
   "end": 97.46
  },
  {
   "index": 2,
   "title": "## رحم مراتب و دعای تحویل حال",
   "start": 97.46,
   "end": 322.82
  },
  {
   "index": 3,
   "title": "## کشتن عادت‌های حیوانی؛ موتوا قبل ان تموتوا",
   "start": 322.82,
   "end": 429.26
  },
  {
   "index": 4,
   "title": "## دو بار متولد شدن و حدیث عیسی",
   "start": 429.26,
   "end": 817.5
  },
  {
   "index": 5,
   "title": "## عذاب برزخی؛ خروج اجباری از عادت",
   "start": 817.5,
   "end": 927.22
  },
  {
   "index": 6,
   "title": "## مصائب دنیا؛ رحمت پیش از برزخ",
   "start": 927.22,
   "end": 1049.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.76,
   "end": 5.02,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.02,
   "end": 8.92,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.92,
   "end": 12.78,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.78,
   "end": 19.24,
   "text": "خانم‌هایی که عادت ماهانه دارن در زمان روزه داری و ماه مبارک رمضان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.24,
   "end": 21.98,
   "text": "اون چند روزی که عادت میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.98,
   "end": 24.78,
   "text": "خب اون روزها رو نباید روزه بگیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.78,
   "end": 29.44,
   "text": "ولی بعد از ماه مبارک رمضان باید قضاشو به جا بیارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.44,
   "end": 31.74,
   "text": "و اون موقع کفاره نیاز نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.74,
   "end": 35.86,
   "text": "بعضیا اشتباهاً گمان می‌کنند که باید همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.86,
   "end": 43.26,
   "text": "به محض اینکه عادت شدن یا بعد از ماه مبارک کفاره اون روزا رو بدن حتی بعضیا قضاشم نمیگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.26,
   "end": 47.42,
   "text": "نخیر قضا به گردنشونه و کفاره نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.42,
   "end": 49.68,
   "text": "مگر اینکه تا ماه مبارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.68,
   "end": 56.08,
   "text": "رمضان سال بعد قضاشو نگیرن، اون موقع کفاره هم به گردنشون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.08,
   "end": 59.86,
   "text": "در حین اینکه قضا هم باز بر گردنشون هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.86,
   "end": 62.5,
   "text": "کفاره اون روزها‌ها رو هم باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.5,
   "end": 66.86,
   "text": "ادا کنن. خب پیرامون قلب مألوف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.86,
   "end": 69.36,
   "text": "یکی از مهمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.36,
   "end": 72.68,
   "text": "حقایق این قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.68,
   "end": 75.16,
   "text": "امروز بیان می‌شود به فضل الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.16,
   "end": 79.26,
   "text": "اونم اینکه یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.26,
   "end": 83.1,
   "text": "بطون معانی قلب مألوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.1,
   "end": 91.12,
   "text": "قلبی که به مقام جمعی و تألیف و انس با ملکوت رسیده است، تولد انسانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.12,
   "end": 97.46,
   "text": "در حقیقت معنای درست تولد انسانی همون رسیدن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.46,
   "end": 100.32,
   "text": "قلب مألوف است. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.32,
   "end": 103.88,
   "text": "ببینید عزیزان ما یک تولد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.88,
   "end": 107.6,
   "text": "حیوانی داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.6,
   "end": 114.06,
   "text": "روزی‌ست که از رحم شریف مادر متولد شدیم و وارد این عالم شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.06,
   "end": 118.92,
   "text": "اون تولد انسانی نیست، تولد حیوانی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.92,
   "end": 123.26,
   "text": "و در حقیقت هر کسی الان میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.26,
   "end": 125.32,
   "text": "اگر ازش بپرسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.32,
   "end": 128.9,
   "text": "شما چند سال عمر کردی بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.9,
   "end": 135.74,
   "text": "سال‌هایی که از گردش زمین به دور ماه یا خورشید از لحظه تولد حیوانیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.74,
   "end": 138.88,
   "text": "گذشته است سنش رو محاسبه میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.88,
   "end": 142.7,
   "text": "که به قول حضرت آقای جوادی آملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.7,
   "end": 147.48,
   "text": "میفرمود که این حرکت تو محسوب نمیشه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.48,
   "end": 150.8,
   "text": "این در حقیقت حرکت دیگری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.8,
   "end": 155.66,
   "text": "حرکت زمین است به دور خورشید یا ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.66,
   "end": 161.28,
   "text": "در حالی که زندگی هر کسی محصول حرکت خود اوست نه حرکت دیگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.28,
   "end": 163.96,
   "text": "اینکه زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.96,
   "end": 168.16,
   "text": "چند مرتبه یا چند سال به دور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.16,
   "end": 171.16,
   "text": "خورشید گذشت، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.16,
   "end": 174.94,
   "text": "میزان در حقیقت سال‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.94,
   "end": 176.96,
   "text": "گذشته بر زمین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.96,
   "end": 181.64,
   "text": "نشون میده نه من و شما که به ما چه که زمین این مقدار گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.64,
   "end": 184.7,
   "text": "پس میزان عمر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.7,
   "end": 188.52,
   "text": "در حقیقت برمی‌گرده به اون میزانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.52,
   "end": 191.28,
   "text": "ما حرکت در خودمون داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.28,
   "end": 200.42,
   "text": "حرکت در خود می‌شود حرکت علمی و عملی که به قول حضرت علامه حسن زاده آملی حفظه الله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.42,
   "end": 205.2,
   "text": "\"علم و عمل جوهرند و انسان ساز.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.2,
   "end": 213.0,
   "text": "در حقیقت شناسنامه هر کسی به قول حضرت آقای جوادی آملی سیره و سنت خود اوست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.0,
   "end": 216.84,
   "text": "نه گردش زمین به دور ماه و خورشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.84,
   "end": 222.18,
   "text": "که اگر به این موضوع دقت کنید در حقیقت ما یک تولد حیوانی داریم که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.18,
   "end": 226.46,
   "text": "رحم مادر متولد میشیم، وارد نشئه طبیعت میشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.46,
   "end": 229.68,
   "text": "که در مراتب اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.68,
   "end": 238.24,
   "text": "در مراتب سیر کنی هر مرتبه مادون به منزله رحم هست برای مرتبه مافوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.24,
   "end": 241.5,
   "text": "یعنی وقتی که ما وارد عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.5,
   "end": 248.38,
   "text": "ملک و نشئه طبیعت شدیم، فعلاً اینجا به منزله رحم می‌شود برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.38,
   "end": 252.18,
   "text": "عالم برزخ. نشئه بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.18,
   "end": 254.12,
   "text": "در حقیقت طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.12,
   "end": 256.6,
   "text": "اینجا رحم اونجا می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.6,
   "end": 259.5,
   "text": "که ما باید دائماً در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.5,
   "end": 264.16,
   "text": "سیر و حرکت علمی و عملی باشیم تا حالمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.16,
   "end": 269.24,
   "text": "عوض بشود. چقدر این دعا شریفه که \"یا مقلب القلوب والابصار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.24,
   "end": 275.74,
   "text": "يا مدبر الليل والنهار يا محول الحول والاحوال حول حالنا الى احسن الحال\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.74,
   "end": 281.64,
   "text": "که اتفاقاً این دعا وارد شده به هنگام تحویل سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 281.64,
   "end": 285.26,
   "text": "دقیقاً توش از تحویل حال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.26,
   "end": 291.12,
   "text": "عوض شدن حال، حالی به حال جدید بلکه احسن حال سخن گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.12,
   "end": 293.84,
   "text": "که قبلاً بحثش گذشت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.84,
   "end": 298.18,
   "text": "برا- بنا به نظر شیخ اکبر محی الدین علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.18,
   "end": 304.06,
   "text": "این احسن حال همون حال پیغمبر است که \"اللهم غير سوء حالنا بحسن حالک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.06,
   "end": 308.8,
   "text": "همون احسن حال همون حال خداست یا همون حال پیغمبر است که همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.8,
   "end": 311.16,
   "text": "حال صادر اول است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.16,
   "end": 316.36,
   "text": "که این در سیر و حرکت علمی و عملی ما نشون داده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.36,
   "end": 318.76,
   "text": "در حقیقت صعه وجودی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.76,
   "end": 323.9,
   "text": "خب پس ما یک تولد حیوانی داریم، یک تولد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.9,
   "end": 327.04,
   "text": "انسانی. اما تولد انسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.04,
   "end": 330.38,
   "text": "اصطلاحاً یا همون در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.38,
   "end": 334.12,
   "text": "معنای واقعی قلب مألوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.12,
   "end": 338.44,
   "text": "میشه گفت با کشتن عادت‌های حیوانی رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.44,
   "end": 341.68,
   "text": "کی ما متولد میشیم به انسانی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.68,
   "end": 343.46,
   "text": "تولد انسانی پیدا می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 343.46,
   "end": 347.0,
   "text": "وقتی که عادت‌های حیوانی مون رو بکشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 347.0,
   "end": 350.24,
   "text": "اینکه میفرماین \"موتو قبل ان تموتو\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 350.24,
   "end": 354.08,
   "text": "یعنی اون عادت‌های حیوانیت رو بکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 354.08,
   "end": 357.92,
   "text": "موتو. بکش عادت‌های حیوانیت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.92,
   "end": 361.6,
   "text": "و وارد به عادت‌های الهی شو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.6,
   "end": 365.02,
   "text": "که این اصطلاحاً بهش میگن خروج از عادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.02,
   "end": 370.26,
   "text": "و در موضوع خروج از عادت، عادت خیلی حرف داریم خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.26,
   "end": 377.66,
   "text": "انشاالله توفیق بشه میگیم. لکن فعلاً همین مقدار داشته باشیم که ما با خروج از عادت‌ها و اون خو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.66,
   "end": 380.86,
   "text": "کردن‌های با عالم کفرات در این دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.86,
   "end": 384.18,
   "text": "اینکه خو می‌کنیم به هر چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 384.18,
   "end": 387.62,
   "text": "با خروج از این خو و این عادت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.62,
   "end": 390.36,
   "text": "در حقیقت سیر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.36,
   "end": 397.12,
   "text": "به، به سمت قلب مألوف یا در حقیقت به سوی یک حقیقت یا نظام توحیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 397.12,
   "end": 402.66,
   "text": "توحید الهی، اونم مقام جمعی، توحید صمدی که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 402.66,
   "end": 405.34,
   "text": "نظامات هستی رو یکپارچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.34,
   "end": 408.42,
   "text": "همونطور که بحثش گذشت یک حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.42,
   "end": 410.72,
   "text": "مألوف و در هم پیچیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 410.72,
   "end": 417.06,
   "text": "یا ملهوف در هم پیچیده فرض کنی و ببینی بلکه ببینی و بلکه بچشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.06,
   "end": 421.2,
   "text": "که بر اساس توحید صمدی یک وجود بود و بقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.2,
   "end": 424.74,
   "text": "تمام ما سوی الله همه آثار او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 424.74,
   "end": 426.96,
   "text": "همه ظهور و بروز او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 426.96,
   "end": 429.26,
   "text": "آیات او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 429.26,
   "end": 437.64,
   "text": "اگر کسی در همین نشئه طبیعت خو کند به همین ظاهر آیات، به همین ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 437.64,
   "end": 439.86,
   "text": "در حقیقت نظامات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.86,
   "end": 444.44,
   "text": "این از عادت خارج نشده، این زندگی حیوانی کرده مثل حیوانات که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 444.44,
   "end": 449.62,
   "text": "همین می‌خورند و می‌خوابند و می‌چرند و با هم حتی گفت‌وگوها دارند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 449.62,
   "end": 451.9,
   "text": "اونا هم زاد و ولد دارند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 451.9,
   "end": 456.92,
   "text": "خشم و غضب و شهوت دارند و اینکه به حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 456.92,
   "end": 461.6,
   "text": "سلام الله عليه و علی نبينا و آله دستور داد خدای منان که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 461.6,
   "end": 466.44,
   "text": "چهار تا پرنده رو بگیر، قبلاً الحمدالله بحثش گذشت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 466.44,
   "end": 470.36,
   "text": "این چهار تا پرنده مظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 470.36,
   "end": 473.52,
   "text": "در حقیقت اون خلق و خوی حیوانی بودند در وجود انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 473.52,
   "end": 475.84,
   "text": "اینا رو چرا میگه ذبحشون کن بکششون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 475.84,
   "end": 481.14,
   "text": "همون بحث موتوعه. بمیرید قبل از اینکه بمیرانند شما را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 481.14,
   "end": 484.84,
   "text": "یعنی قبل از اینکه به زور شما رو با مرگ از این عادت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 484.84,
   "end": 489.5,
   "text": "بخوان خارج کنن، خودتون از این عادت‌های حیوانی خارج بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 489.5,
   "end": 492.4,
   "text": "اینا رو بکشید که طاووس بود مظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 492.4,
   "end": 498.44,
   "text": "عجب و ریا و در حقیقت خودپسندی و تکبر و خودشیفتگی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 498.44,
   "end": 502.52,
   "text": "خودنمایی و. اردک بود مظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 502.52,
   "end": 507.18,
   "text": "لجن‌خواری، حرامخواری، شبهه خواری یا خساست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 507.18,
   "end": 510.66,
   "text": "خساست نفس عرض شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 510.66,
   "end": 514.8,
   "text": "کرکس بود مظهر غضب، شهوت، لاشخوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 514.8,
   "end": 518.8,
   "text": "زور، استکبار این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 518.8,
   "end": 521.28,
   "text": "و همچنین خروس بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 521.28,
   "end": 526.76,
   "text": "مظهر شهوت. اون هم شهوات، همه‌گونه شهوات، شهوت نگاه کردن، شهوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 526.76,
   "end": 531.38,
   "text": "حرف زدن، شهوت راه رفتن، شهوت خوابیدن، شهوت خوردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 531.38,
   "end": 536.58,
   "text": "شهوت پست و مقام و همه و شهوات غریزه ای همه و همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 536.58,
   "end": 538.78,
   "text": "این‌ها هم به عنوان نمونه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 538.78,
   "end": 541.94,
   "text": "مظهرند. و الا میشه در هر کدوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.94,
   "end": 544.74,
   "text": "تمام حیواناتی که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 544.74,
   "end": 548.2,
   "text": "زیبایی دارند تو زیل طاووس تعریف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 548.2,
   "end": 551.86,
   "text": "حیواناتی که شهوتشون زیاده زیل خروس تعریف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 551.86,
   "end": 553.94,
   "text": "می‌فرمود این‌ها رو بکش، ذبح کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 553.94,
   "end": 556.68,
   "text": "بعد به حضرت می‌فرمود رو کوه ده تا قله بگذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 556.68,
   "end": 560.04,
   "text": "این قله‌ها، قله‌های قوای وجودی انسان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 560.04,
   "end": 563.24,
   "text": "چرا ده تا؟ پنج تا حواس ظاهری داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.24,
   "end": 565.04,
   "text": "و پنج تا هم حواس باطنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 565.04,
   "end": 568.0,
   "text": "ظاهر همین حواس مثلاً بین--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 568.0,
   "end": 569.98,
   "text": "قوه باصره می‌بینی خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 569.98,
   "end": 572.86,
   "text": "همین قوه رو باطنت هم داری که در خواب می‌بینی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.86,
   "end": 575.98,
   "text": "این بصره، چشم بصرت سرت بسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 575.98,
   "end": 578.34,
   "text": "در خواب با چه چشمی می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 578.34,
   "end": 582.34,
   "text": "با چشم باطن. همین پنج تا حواس ظاهری رو در باطن هم داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.34,
   "end": 589.94,
   "text": "می‌فرمود این در حقیقت در این پ-- ده تا قوا، پنج تا ظاهر و پنج تا باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 589.94,
   "end": 594.44,
   "text": "چکن، ریشه‌کن کن، ذبح کن این عادت‌ها رو، عادت‌های حیوانی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 594.44,
   "end": 599.08,
   "text": "بعد دو مرتبه روی این قله‌ها که گذاشتی این‌ها رو بخوان زنده شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 599.08,
   "end": 602.68,
   "text": "اینا همش سیر انفسیشو وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 602.68,
   "end": 607.38,
   "text": "از تعلمه در، در حقیقت شرح مصباح الانس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 607.38,
   "end": 609.5,
   "text": "فناری می‌فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 609.5,
   "end": 611.7,
   "text": "اینجا ده تا قله رو به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 611.7,
   "end": 616.36,
   "text": "ده تا قوای وجودی و اینکه دو مرتبه می‌خوانی زنده شون می‌کنی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 616.36,
   "end": 619.06,
   "text": "دوباره شهوت زنده بشه؟ دوباره غضب زنده بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 619.06,
   "end": 624.12,
   "text": "دو-- می‌فرمود این‌ها رو نسبت به شرع احیا کن، زنده کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 624.12,
   "end": 628.54,
   "text": "زیل شرع ت-تفسیر کن، تعیین کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 628.54,
   "end": 633.48,
   "text": "متمز کن. قوای وجودیت رو التزام بهش ببخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 633.48,
   "end": 639.36,
   "text": "نسبت به دستورات شرع و دین و قرآن و اهل بیت علیهم السلام و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 639.36,
   "end": 642.88,
   "text": "در حقیقت احیاش کن. نه اینکه شهوتت رو کلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 642.88,
   "end": 647.26,
   "text": "بکشی، ریشه‌کن کنی. از حیوانیت خارج کنی به انسانیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 647.26,
   "end": 649.58,
   "text": "تحت عقل یعنی همه این قوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 649.58,
   "end": 652.28,
   "text": "دو مرتبه تحت عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 652.28,
   "end": 661.66,
   "text": "احیا بشوند. که اون موقع می‌شود خروج از عادت، از عادات حیوانی خارج میشی و تولد انسانیت تو از اینجا شروع می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 661.66,
   "end": 667.86,
   "text": "این هستش که در حقیقت اگر ما بخواهیم به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 667.86,
   "end": 670.88,
   "text": "جمعی یا به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 670.88,
   "end": 673.44,
   "text": "در حقیقت الفت با ملکوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 673.44,
   "end": 682.72,
   "text": "قلب مألوف، قلبی که الفت و انس گرفته با یکپارچگی نظام هستی، توحید صمدی حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 682.72,
   "end": 684.92,
   "text": "پیدا کرده برسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 684.92,
   "end": 689.06,
   "text": "هیچ چاره‌ای نداریم جز اینکه دو بار متولد بشویم عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 689.06,
   "end": 692.5,
   "text": "که حدیثش هم البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 692.5,
   "end": 696.8,
   "text": "هست. حدیثی از حضرت عیسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 696.8,
   "end": 704.94,
   "text": "علی نبينا و آله و عليه الصلاة والسلام در کتاب بحر المعارف مولی عبد الصمد احمدانی صفحه صد و سه اومده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 704.94,
   "end": 707.82,
   "text": "از قول از عیسی فرمودن \"لن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 707.82,
   "end": 710.32,
   "text": "یلج ملکوت السماوات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 710.32,
   "end": 715.9,
   "text": "وارد ملکوت آسمان‌ها نمیشه کسی که \"ملم يولد مرتين\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 715.9,
   "end": 721.56,
   "text": "کسی که دو بار زنده نشده باشه، دو بار متولد نشده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 721.56,
   "end": 725.04,
   "text": "اینجا زنده شدن به وجه ربییه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 725.04,
   "end": 728.44,
   "text": "تولد دوم زنده شدن به وجه ربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 728.44,
   "end": 732.48,
   "text": "تولد اول زنده شدن خب به وجه خلقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 732.48,
   "end": 734.36,
   "text": "لذا اینا خیلی سر درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 734.36,
   "end": 741.8,
   "text": "میگه دو بار تا کسی دو بار متولد نشود نمی‌تونه به ملکوت آسمان‌ها راه پیدا کنه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 741.8,
   "end": 746.96,
   "text": "که این هم در حقیقت تولد اول همون از رحم مادر وارد میشی به این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 746.96,
   "end": 749.82,
   "text": "تولد دوم خروج از عادت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 749.82,
   "end": 756.3,
   "text": "رسیدن به حقیقت قلب مألوف، انس و الفت گرفتن با ملکوت عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 756.3,
   "end": 759.72,
   "text": "با اون توحید صمدی خو گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 759.72,
   "end": 763.52,
   "text": "و آ-- ترک عادت‌های حیوانی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 763.52,
   "end": 769.36,
   "text": "که اگر کسی تولد دوم رو نداشت همون یک بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 769.36,
   "end": 777.22,
   "text": "تولد حیوانی رو داشت مثل بچه‌ای که از رحم مادر ناقص متولد می‌شه، سقط جنین که می‌گن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 777.22,
   "end": 780.76,
   "text": "ساقط می‌شه. وقت مرگش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 780.76,
   "end": 789.54,
   "text": "اون موقع می‌خوان خروج از عادت بهش بدن و چون ناقص وارد عالم برزخ شده، تولد ثانیش تولد دومش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 789.54,
   "end": 793.0,
   "text": "نا-- نقص داره. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 793.0,
   "end": 796.12,
   "text": "این نقص باید جبران بشه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 796.12,
   "end": 798.66,
   "text": "در برزخ هم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 798.66,
   "end": 802.54,
   "text": "سیر تکاملی داریم. در تکامل برزخی بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 802.54,
   "end": 806.48,
   "text": "و انّا الیه راجعون میگه باید به سمت الله حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 806.48,
   "end": 810.76,
   "text": "همه نواقص باید به نوعی برطرف بشود در این سیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 810.76,
   "end": 814.8,
   "text": "وقتی که طرف از دنیا می‌رود اصطلاحاً حالا به هر مرگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 814.8,
   "end": 817.5,
   "text": "مرگ با تصادف، مریضی، هرچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 817.5,
   "end": 820.38,
   "text": "همین مرگ مصطلح وقتی از دنیا رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 820.38,
   "end": 823.94,
   "text": "این دیگه تولد ثانی خودش رو اونجا داره تجربه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 823.94,
   "end": 828.04,
   "text": "اگر در دنیا تولد انسانی نداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 828.04,
   "end": 832.72,
   "text": "در حقیقت اونجا ناقص وارد عالم برزخ شده و اونجا می‌خواد متولد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 832.72,
   "end": 836.7,
   "text": "یعنی اونجا خروج از عادت‌های حیوانی‌ش می‌خوان بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 836.7,
   "end": 839.86,
   "text": "لذا اون خیلی سخته، خیلی دشواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 839.86,
   "end": 844.08,
   "text": "سالیان سال بلکه برای بعضیا هزاران هزار سال طول می‌کشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 844.08,
   "end": 846.56,
   "text": "که اصطلاحاً بهش می‌گن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 846.56,
   "end": 848.62,
   "text": "بهش می‌گن به این سختی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 848.62,
   "end": 852.24,
   "text": "خروج از عادت و تولد انسانی پس از مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 852.24,
   "end": 854.94,
   "text": "بهش می‌گن عذاب برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 854.94,
   "end": 861.1,
   "text": "عذاب برزخی. اون فشار قبر و تنگی و تاریکی و ظلمت و که همه هم در درون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 861.1,
   "end": 863.26,
   "text": "خود انسان است و بس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 863.26,
   "end": 867.86,
   "text": "برای اینکه از این عادت‌ها خارج بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 867.86,
   "end": 870.4,
   "text": "در آیینه روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 870.4,
   "end": 873.68,
   "text": "مثالی که اهل بیت علیهم الصلاة والسلام آوردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 873.68,
   "end": 877.66,
   "text": "مثل زدن. تلك الأمثال ندر بحال الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 877.66,
   "end": 879.7,
   "text": "این مثلی که آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 879.7,
   "end": 881.74,
   "text": "به وجه عذاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 881.74,
   "end": 884.5,
   "text": "معذب شدن و زنجیر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 884.5,
   "end": 888.2,
   "text": "آتش و نمی‌دونم سرب گداخته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 888.2,
   "end": 892.88,
   "text": "از شود. به هر حال تشبیه عاقل به معقول به محسوسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 892.88,
   "end": 895.96,
   "text": "تشبیه معقول به محسوسه که تو حس کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 895.96,
   "end": 898.9,
   "text": "آنچه که در عالم عقل قراره اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 898.9,
   "end": 903.98,
   "text": "پس این می‌شه تولد انسانی در نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 903.98,
   "end": 905.94,
   "text": "در حقیقت طبیعت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 905.94,
   "end": 912.2,
   "text": "وظیفه اول ماست. و اگر کسی به این وظیفه‌ش عمل نکرد و ناقص وارد عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 912.2,
   "end": 915.02,
   "text": "برزخ شد، می‌شود باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 915.02,
   "end": 919.04,
   "text": "همون تولد انسانی یا خروج از عادت اما به دست ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 919.04,
   "end": 922.58,
   "text": "دیگه تو از دستت خارج شده و به زور دیگه اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 922.58,
   "end": 925.32,
   "text": "در حقیقت باز پاک‌سازیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 925.32,
   "end": 926.88,
   "text": "همش خروج از عادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 926.88,
   "end": 933.44,
   "text": "اینه که در همین دنیا ولنبلونکم بشیئ من الخوف والجوع ونقص من الأموال والأنف-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 933.44,
   "end": 937.56,
   "text": "والأنفس والثمرات وبشر الصابرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 937.56,
   "end": 939.92,
   "text": "حالا صابرین کیان؟ الذين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 939.92,
   "end": 944.5,
   "text": "اذا اصابتهم مصيبة قالوا وقتی مصیبت بهشون وارد می‌شه چی می‌گن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 944.5,
   "end": 947.5,
   "text": "انا لله وانا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 947.5,
   "end": 952.24,
   "text": "یعنی این دقیقاً همین رو داره توصیه می‌کنه که اساساً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 952.24,
   "end": 958.5,
   "text": "ااا می‌شه گفت علت اصلی این مصیبات در دنیا اینه که خدا قبل از اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 958.5,
   "end": 964.8,
   "text": "وارد عالم برزخ بکنی و کار به شدت دشوار بشود، همینجا خروج از عادت به تو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 964.8,
   "end": 967.72,
   "text": "دلت رو بکنه با این عالم خو نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 967.72,
   "end": 970.98,
   "text": "حشر و نشر با این عالم سبب نشه تو خو بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 970.98,
   "end": 976.6,
   "text": "یکی از دلایلی که به نفس می‌گن نفس چون خو می‌کنه به هر طرف رو کنه زودی خو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 976.6,
   "end": 979.3,
   "text": "لذا میگه از ملک دل بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 979.3,
   "end": 985.28,
   "text": "تو دل نکندی من با مشکلات و مصائب و فقر و مریضی و گرفتاری و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 985.28,
   "end": 988.08,
   "text": "من خدای مهربان چون خیر تو رو می‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 988.08,
   "end": 991.32,
   "text": "یه کاری می‌کنم تو دل بکنی تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 991.32,
   "end": 996.3,
   "text": "مسقط در حقیقت ساقط شده، سقط شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 996.3,
   "end": 998.46,
   "text": "ناقص وارد عالم برزخ نشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 998.46,
   "end": 1001.86,
   "text": "همینجا بیدار بشی، متنبه بشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1001.86,
   "end": 1006.02,
   "text": "که انشاالله همه ما به این تولد انسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1006.02,
   "end": 1008.92,
   "text": "متولد بشیم که اون موقع اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1008.92,
   "end": 1013.14,
   "text": "درست در همین در حقیقت تولد انسانی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1013.14,
   "end": 1019.46,
   "text": "تولد ثانیش درست خروج از عادت به تمامه کنه دیگه برزخ معنا نداره براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1019.46,
   "end": 1024.88,
   "text": "تا به محض اینکه نفس 나طقش انصراف از بدن داد و وارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1024.88,
   "end": 1030.54,
   "text": "نشئه بعدی شد یک راه-- یک راست می‌برنش به سمت بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1030.54,
   "end": 1034.48,
   "text": "برین و بهشت در حقیقت وعده داده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1034.48,
   "end": 1039.76,
   "text": "اصلاً دیگه برزخ معنا نداره که بخواد بین این عالم و اون عالم منتظر نگرش دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1039.76,
   "end": 1042.84,
   "text": "چون ناقص و سقط شده وارد نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1042.84,
   "end": 1044.98,
   "text": "انشاالله این بحث رو ادامه خواهیم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1044.98,
   "end": 1049.5,
   "text": "عاقبتمون ختم به خیر بشه انشاالله به برکت صلوات بر محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}