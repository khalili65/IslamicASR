   "start": 0.38,
   "end": 22.1
  },
  {
   "index": 1,
   "title": "## تجلی حضرت حق و مراتب نفس و بدن",
   "start": 22.1,
   "end": 247.14
  },
  {
   "index": 2,
   "title": "## قوس صعود؛ صادر اول و نفس الرحمن",
   "start": 247.14,
   "end": 267.14
  },
  {
   "index": 3,
   "title": "## دعای تغییر حال؛ حال پیامبر",
   "start": 267.14,
   "end": 420.92
  },
  {
   "index": 4,
   "title": "## قلب مؤمن عرش الرحمن؛ پیوند در سیر الی‌الله",
   "start": 420.92,
   "end": 592.1
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 2.84,
   "text": "\"کنت کنزا مخفیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.84,
   "end": 5.04,
   "text": "فاحببت ان اعرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.04,
   "end": 8.6,
   "text": "فخلقت الخلق لکی اعرف\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.6,
   "end": 14.5,
   "text": "که چندین جلسه به فضل الهی قبلاً صحبت کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.5,
   "end": 22.1,
   "text": "در حقیقت عشق خدا، محبت و حب ذاتی حضرت حق به خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.1,
   "end": 27.24,
   "text": "بر این تعلق گرفت که شناخته بشود و خلائق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.24,
   "end": 32.18,
   "text": "ظهور داد، بروز داد، نمودار اون وجود کلی شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.18,
   "end": 34.68,
   "text": "این یعنی خود مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.68,
   "end": 39.66,
   "text": "توحید صمدی در حقیقت همان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.66,
   "end": 45.62,
   "text": "یک حقیقت پیچیده و معلوف و در هم جمع شده‌ست دیگه که ثمره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.62,
   "end": 47.9,
   "text": "توحید صمدی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.9,
   "end": 51.58,
   "text": "فهم این حقیقت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.58,
   "end": 60.4,
   "text": "و در حقیقت کسی بتواند این رو درک کند که همه عوالم هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.4,
   "end": 66.12,
   "text": "از یک حقیقت و حقیقت الحقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.12,
   "end": 70.36,
   "text": "کلی بسط پیدا کردن این خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.36,
   "end": 74.26,
   "text": "کا-- به درد می‌خوره. این یعنی در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.26,
   "end": 77.12,
   "text": "در حقیقت عرفان و توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.12,
   "end": 79.38,
   "text": "بسیار کارگشا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.38,
   "end": 81.68,
   "text": "خب حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.68,
   "end": 84.42,
   "text": "ما قبلاً بحث کردیم که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.42,
   "end": 90.72,
   "text": "اه تجلی حضرت حق در حقیقت اون وجود صمدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.72,
   "end": 93.86,
   "text": "احدی حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.86,
   "end": 98.08,
   "text": "وقتی که تنزل پیدا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.08,
   "end": 105.54,
   "text": "که اون ذات غیب الغیوب امم در حقیقت بحث نفس بعداً پیاده شد و بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.54,
   "end": 108.94,
   "text": "بدن که همون عالم هستی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.94,
   "end": 112.74,
   "text": "که در مراتب سیر معرفت نفس انسانی این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.74,
   "end": 117.64,
   "text": "خوب تدوین میشه. در حقیقت می‌خوام عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.64,
   "end": 126.14,
   "text": "حتی حکما فرمودند خدای منان در ابتدا یک تجلی اعظم کرد لکن به سه قسمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.14,
   "end": 130.72,
   "text": "یادمه که در محرم و صفر سال گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.72,
   "end": 134.5,
   "text": "این‌ها اون پایین که جمع می‌شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.5,
   "end": 141.92,
   "text": "به جهت قصه کرونا، اونجا این مطلب رو چند روز درباره‌ش بحث کردیم اگه خاطرتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.92,
   "end": 146.14,
   "text": "که قرآن یک وجود است به سه شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.14,
   "end": 149.5,
   "text": "در حقیقت از حضرت حق تنزل پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.5,
   "end": 155.9,
   "text": "سوره زمر آیه یک \"تنزیل الكتاب من الله العزيز الحکیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.9,
   "end": 158.88,
   "text": "تنزل پیدا کرده از کیه این کتاب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.88,
   "end": 161.56,
   "text": "از من ال من الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.56,
   "end": 166.6,
   "text": "العزيز الحکیم که بر اساس نام عزت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.6,
   "end": 169.34,
   "text": "عزیز و حکیم حضرت حق این تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.34,
   "end": 173.84,
   "text": "حالا به سه شکل بود دیگه یادتون هست قرآن تدوینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.84,
   "end": 177.36,
   "text": "که همون مقام تألیف کلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.36,
   "end": 180.28,
   "text": "که هم برگشت می‌کنه به همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.28,
   "end": 184.9,
   "text": "اه مقام تألیف کلیه قرآن \"إنك لتلقى القرآن من لدن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.9,
   "end": 187.92,
   "text": "علم لدنی ذاتی حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.92,
   "end": 193.46,
   "text": "حکیم علیم. این قرآن تدوین بهش یک شکلش قرآن تدوینی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.46,
   "end": 200.26,
   "text": "یک شکلش قرآن هستی که همین نظام آفاقی و به منزله بدن اون نفس کلیه الهیه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.26,
   "end": 203.68,
   "text": "و یک قسمش هم که قرآن انفسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.68,
   "end": 206.0,
   "text": "قرآن جان، جان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.0,
   "end": 210.68,
   "text": "نفسی یعنی انسان، انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.68,
   "end": 213.88,
   "text": "خب این به سه شکل از کجا اومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.88,
   "end": 218.64,
   "text": "از اون مقام تألیف کلی، ال از علم ذاتی حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.64,
   "end": 225.62,
   "text": "خب این که در حقیقت در قوس نزول این اتفاق افتاده چون تنزيل الكتاب درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.62,
   "end": 228.36,
   "text": "این در قوس نزول رخ داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.36,
   "end": 232.2,
   "text": "از یک وجود واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.2,
   "end": 237.76,
   "text": "کثرات اه ظهور پیدا کردن، نمود پیدا کردن از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.76,
   "end": 239.7,
   "text": "وجود. خب این میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.7,
   "end": 244.4,
   "text": "در قوس نزول تألیف بدل به کثرات شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.4,
   "end": 247.14,
   "text": "اون الفت بدل به کثرات شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.14,
   "end": 250.3,
   "text": "پس تألیف بر می‌گرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.3,
   "end": 254.72,
   "text": "چی؟ در قوس صعود یعنی در همین نشئه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.72,
   "end": 258.84,
   "text": "نشئه طبیعت که حرکت می‌کنید حالا اون \"إنا لله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.84,
   "end": 262.4,
   "text": "آمدن از یک وجود واحد که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.4,
   "end": 268.34,
   "text": "قبل از خلقت یعنی واسطه بین خلقت و حضرت حق باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.34,
   "end": 276.14,
   "text": "اه مقام قدسی دیگری هست به نام صادر اول که اون خلق هم نیست ازش به صورت الرحمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.14,
   "end": 280.3,
   "text": "یاد میشه یا نفس الرحمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.3,
   "end": 283.44,
   "text": "که سایه هم نداشته. سایه مال خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.44,
   "end": 288.22,
   "text": "از اون بیست و هشت دسته خلائق خلق شدن که یکیش انسان هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.22,
   "end": 291.76,
   "text": "در حقیقت باز مقام تألیف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.76,
   "end": 301.28,
   "text": "اه بالا دست رتبه بالای خلائق میشه مقام صادر اول که پیغمبر و اهل بیت علیهم الصلاة والسلام در سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.28,
   "end": 305.56,
   "text": "صعود در قوس صعود دنیوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 305.56,
   "end": 308.9,
   "text": "رفتن و رسیدن به همون مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.9,
   "end": 311.24,
   "text": "صادر اول. جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.24,
   "end": 314.56,
   "text": "عین این سی روز ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.56,
   "end": 319.98,
   "text": "شما هر روز عرض می‌کردید به خدا در این دعای معروف که \"اللهم غیر سوء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 319.98,
   "end": 327.34,
   "text": "حالنا بحسن حالک\" مگر خدا حال داره که میگی خدایا بدی حال ما رو به خوشی حال خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 327.34,
   "end": 330.12,
   "text": "تبدیل کن، تغییر بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 330.12,
   "end": 333.62,
   "text": "مرحوم محی الدین عربی علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 333.62,
   "end": 338.66,
   "text": "در فتوحاتش اگر اشتباه نکنم در فتوحات مکیه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 338.66,
   "end": 341.56,
   "text": "اونجا دارن که این حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 341.56,
   "end": 349.76,
   "text": "منظور همون حال مقام صادر اول است که چون پیغمبر عظیم الشأن اسلام در قوس صعود یعنی در این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 349.76,
   "end": 356.9,
   "text": "رفت و سیر کرد و رسید به اون مقام صادر اول فرمود: اون صادر اول منم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 356.9,
   "end": 359.68,
   "text": "پس لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 359.68,
   "end": 363.34,
   "text": "اینجا مه-مرحوم شیخ اکبر می‌فرمود که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 363.34,
   "end": 369.1,
   "text": "\"غير سوء حالنا بحسن حالک\" یعنی اون حالک یعنی، یعنی حال خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 369.1,
   "end": 371.36,
   "text": "به یک معنا میشه حال پیغمبر عظیم الشأن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 371.36,
   "end": 375.62,
   "text": "یعنی شما هر روز بعد از نماز‌هاتون از خدا می‌خواستید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 375.62,
   "end": 379.16,
   "text": "حالتون تغییر پیدا کنه به حال پیغمبر عظیم الشأن اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 379.16,
   "end": 382.44,
   "text": "ببینید درون مایه این دعاها که به قول حضرت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 382.44,
   "end": 386.54,
   "text": "رحمت الله علیه عظیم‌ترین معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 386.54,
   "end": 392.02,
   "text": "اهل بیت علیهم الصلاة والسلام در قالب این ادعیه است چون خلوت اونا با خدا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 392.02,
   "end": 395.66,
   "text": "وقتی با قر-- با مردم و با ناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 395.66,
   "end": 399.62,
   "text": "تکلم می‌کردن با عموم مردم و تعارف صحبت می‌کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 399.62,
   "end": 402.42,
   "text": "فوقش احکام فقهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 402.42,
   "end": 406.16,
   "text": "و بایدها و نبایدها اینها رو بیان می‌کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 406.16,
   "end": 407.88,
   "text": "که در حد عقل همه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 407.88,
   "end": 411.24,
   "text": "اما وقتی با خدا خلوت می‌کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 411.24,
   "end": 420.2,
   "text": "ببینید چنان عظمتی می‌آفریدند که به قول حضرت امام علیه الرحمه کمیل‌شون می‌شود دعای کمیل میشه سر Ser.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 420.2,
   "end": 425.9,
   "text": "خب پس این رو باید امروز متوجه شدیم که اون تألیف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 425.9,
   "end": 430.08,
   "text": "در قوس صعود داره رخ میده و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 430.08,
   "end": 432.94,
   "text": "همه ما داریم میریم به سمت او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 432.94,
   "end": 437.54,
   "text": "که در حقیقت اگر اون عرش رو مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 437.54,
   "end": 444.48,
   "text": "جمعی فرض کنیم، اون عرش رو قلب المؤمن عرش الرحمن که عرض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 444.48,
   "end": 449.4,
   "text": "در حقیقت تو قلبت باید پیوند بخوره به اون قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 449.4,
   "end": 453.58,
   "text": "یعنی به اون عرش الهی که به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 453.58,
   "end": 459.84,
   "text": "اون مؤمن رو اگر حجت خدا بگیری که بعضی از روایت اطلاق به این موضوع داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 459.84,
   "end": 467.18,
   "text": "که اون ال-- قلب المؤمن عرش الرحمن منظور اون المؤمن حجت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 467.18,
   "end": 471.9,
   "text": "پس تو قلبت که مقام جمعی وجودته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 471.9,
   "end": 476.92,
   "text": "سلطان وجودته، حاکم وجودته، حکیم وجودته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 476.92,
   "end": 486.56,
   "text": "باید پیوند بخوره در قوس صعود در سیر الی الله، قربتا الی الله، انا لله و انا و انا الیه راجعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 486.56,
   "end": 488.22,
   "text": "یا الی المسیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 488.22,
   "end": 494.76,
   "text": "اینا همه باید پیوند بخوره با اون قلب با اون عرش، عرش الرحمن که قلب تپنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 494.76,
   "end": 501.88,
   "text": "عالم هستی یا امام و حجت بن حسن العسکری علیهم الصلاة والسلام هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 501.88,
   "end": 504.56,
   "text": "خب پس مقام تألیف اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 504.56,
   "end": 506.94,
   "text": "اونجا الفت برقرار میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 506.94,
   "end": 513.48,
   "text": "که حالا بعدا انشاالله ما سخن خواهیم گفت به فضل الهی، به توفیق الهی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 513.48,
   "end": 517.7,
   "text": "این، اه، راه‌های رسیدن به الفت چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 517.7,
   "end": 520.26,
   "text": "چگونه انسان به الفت میرسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 520.26,
   "end": 522.84,
   "text": "از طریق نماز، از طریق روزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 522.84,
   "end": 525.82,
   "text": "از طریق-- ببینید همه الفت میاره که حالا به چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 525.82,
   "end": 530.82,
   "text": "نحوی به چه شکلی اینا باید بررسی بشه عزیزان روش کار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 530.82,
   "end": 534.54,
   "text": "پس در مفهوم اصطلاح قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 534.54,
   "end": 538.22,
   "text": "به یک معنا همون بحث انس گرفتن قریش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 538.22,
   "end": 544.1,
   "text": "با مکه بود که با ایجاد وحدت و الفتی که برقرار شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 544.1,
   "end": 547.6,
   "text": "این اتفاق رخ داد. اما در معنای کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 547.6,
   "end": 552.44,
   "text": "عرض شود این در قوس نزول و صعود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 552.44,
   "end": 566.54,
   "text": "باید بحث بشود و در حقیقت در سیر بند-بندگی که \"انه عبدونی هذا صراط مستقیم\" اون نزدیک‌ترین راه به حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 566.54,
   "end": 568.62,
   "text": "صراط مستقیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 568.62,
   "end": 571.92,
   "text": "و چیزی که برگشت کند به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 571.92,
   "end": 575.64,
   "text": "جهت، به یک قبله، به یک سمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 575.64,
   "end": 578.7,
   "text": "به یک قلب، به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 578.7,
   "end": 581.68,
   "text": "حقیقت کلیه که همون توحید ثمدی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 581.68,
   "end": 587.08,
   "text": "اینا باید انشاالله درک بشه و دربارش به امید خدا در آینده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 587.08,
   "end": 592.1,
   "text": "سخن بگیم. انشاالله که عاقبتمون ختم بخیر بشه و برکت صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}