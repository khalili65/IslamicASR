 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتا دربارهٔ نجاست در خانهٔ میزبان",
   "start": 0.3,
   "end": 97.82
  },
  {
   "index": 1,
   "title": "## آیات قلب مألوف؛ صدقات در توبه",
   "start": 97.82,
   "end": 276.62
  },
  {
   "index": 2,
   "title": "## المؤلفة قلوبهم در نظام حاکمیت",
   "start": 276.62,
   "end": 313.66
  },
  {
   "index": 3,
   "title": "## داستان جوان و مادر کافر",
   "start": 313.66,
   "end": 334.86
  },
  {
   "index": 4,
   "title": "## اخلاق به مثابه صدقه",
   "start": 334.86,
   "end": 793.69
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 7.52,
   "text": "و بین الستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.52,
   "end": 14.58,
   "text": "المستغفر بک یا صاحب الزمان السلام علیک یا داعی الله و ربانی ایاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.58,
   "end": 17.86,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.86,
   "end": 20.9,
   "text": "استفتا شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.9,
   "end": 24.4,
   "text": "اگر مهمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.4,
   "end": 28.18,
   "text": "بخشی از اثاث یا لوازم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.18,
   "end": 31.28,
   "text": "منزل میزبان رو نجس کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.28,
   "end": 37.22,
   "text": "یا حالا مثلاً انسان سفری میره با خونواده یه هتلی خونه‌ای اجاره میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.22,
   "end": 40.56,
   "text": "بچه‌ها اونجا نجس کاری میکنن مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.56,
   "end": 44.68,
   "text": "آیا لازمه که حتما به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.68,
   "end": 47.94,
   "text": "صاحبخانه و میزبان خبر بدین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.94,
   "end": 52.06,
   "text": "که مثلاً این لوازم منزل شما نجس شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.06,
   "end": 55.36,
   "text": "آقا فرمودن که به غیر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.36,
   "end": 58.26,
   "text": "خوردنی و آشامیدنی و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.26,
   "end": 64.48,
   "text": "ظرفی که درش غذا و آب میخورن دیگه در بقیه لازم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.48,
   "end": 68.72,
   "text": "یعنی در خوردنی، آشامیدنی و ظرفی که درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.72,
   "end": 74.98,
   "text": "غذا و آب و اینو میخورن اگر نجاست اتفاق افتاد باید حتما خبر بدی به صاحبخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.98,
   "end": 79.02,
   "text": "اما غیر از این اتفاق افتاد در البسه و پوشاک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.02,
   "end": 83.1,
   "text": "بستر و لباس و اینا نه نیازی نداره حتما بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.1,
   "end": 87.48,
   "text": "اگرچه بگی اشکال نداره اما لازم نیست بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.48,
   "end": 90.3,
   "text": "یکی از آیاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.3,
   "end": 95.4,
   "text": "حالا ما این مدت به فضل الهی پیرامون قلب مألوف که حرف زدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.4,
   "end": 97.82,
   "text": "هنوز ورود به آیاتش نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.82,
   "end": 101.78,
   "text": "سه تا آیه در قرآن هست که پیرامون قلب مألوف حرف زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.78,
   "end": 108.2,
   "text": "یکی از این آیات، آیه شصت سوره توبه است که بحث صدقات رو میاره که به هشت طایفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.2,
   "end": 111.38,
   "text": "میفرماید صدقات، این صدقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.38,
   "end": 115.58,
   "text": "اعم از واجب و مستحب اینا به هشت طایفه میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.58,
   "end": 120.34,
   "text": "إنما الصدقات للفقراء اول به فقراء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.34,
   "end": 126.16,
   "text": "فقراء هم از این جهت بهش میگن فقیر که کعنه ستون فقراتش شکسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.16,
   "end": 129.24,
   "text": "انقدر ضربه خورده بهش میگن فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.24,
   "end": 131.5,
   "text": "ولالمساكين دسته دوم مساکین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.5,
   "end": 137.14,
   "text": "مساکین یا مسکین یعنی کسی که دیگه نشسته زمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.14,
   "end": 140.6,
   "text": "سکون پیدا کرده، اصلاً نمی‌تونه حرکت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.6,
   "end": 143.18,
   "text": "که وضعش از فقیر بدتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.18,
   "end": 145.22,
   "text": "والعاملین علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.22,
   "end": 150.5,
   "text": "کسایی که دست‌اندرکار جمع‌آوری صدقات‌اند به اون‌ها هم میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.5,
   "end": 153.86,
   "text": "یعنی اون عامل‌ها. والمؤلفة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.86,
   "end": 157.8,
   "text": "قلوبهم این چهارمین دسته‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.8,
   "end": 161.14,
   "text": "صدقات بهشون میرسه جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.14,
   "end": 164.12,
   "text": "اونایی‌اند-- یعنی کسایی‌اند که تو میخوای براشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.12,
   "end": 167.72,
   "text": "خرج کنی تا تألیف قلوب اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.72,
   "end": 170.68,
   "text": "که حالا بسیاری از مفسرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.68,
   "end": 174.38,
   "text": "زیل این آیه فرمودن پولی که انسان خرج کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.38,
   "end": 177.7,
   "text": "برای اینکه دیگران جذب به دین بشوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.7,
   "end": 180.7,
   "text": "که حالا بحث می‌کنیم. بقیشم بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.7,
   "end": 184.44,
   "text": "پنجمیش و في الرقاب از رقبه میاد گردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.44,
   "end": 190.24,
   "text": "غلامان، بندگان این‌ها که حالا قدیما مرسوم بوده خرج اونا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.24,
   "end": 193.24,
   "text": "والغارمین غارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.24,
   "end": 197.94,
   "text": "که قرضوندی‌ایه که از راه فساد و اسراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.94,
   "end": 205.38,
   "text": "قرضمند نشده. شدیداً گرفتار شده، قرضش بالا گرفته، ضرر مالی خورده اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.38,
   "end": 211.5,
   "text": "فساد نکرده. مثلاً در تفسیر کنز الدقائق از امام صادق صلوات الله علیه حدیثی دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.5,
   "end": 215.38,
   "text": "حضرت فرمودن هر مؤمن یا مسلمانی که بمیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.38,
   "end": 217.86,
   "text": "و بدهی بر جای بگذارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.86,
   "end": 222.92,
   "text": "که بر اساس فساد و اسراف نبوده باشه این بدهیش، این قرضش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.92,
   "end": 225.4,
   "text": "پرداخت بدهی او بر امام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.4,
   "end": 231.2,
   "text": "بر امام جامعه واجبه که بدهی اون مسلمانی که از دنیا رفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.2,
   "end": 235.92,
   "text": "بدهی گردنش اومده اما از رو فساد و اسراف البته نبوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.92,
   "end": 241.68,
   "text": "بپردازه. بعدیش و في سبيل الله در راه خدا بالاخره همه این راه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.68,
   "end": 245.18,
   "text": "کاراهایی که در مسیر حضرت حق انجام می‌شود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.18,
   "end": 247.34,
   "text": "شعائر دینی و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.34,
   "end": 250.1,
   "text": "و ابن السبیل کسی که تو س-- تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.1,
   "end": 252.72,
   "text": "و ابن السبیل رو اینطوری فرمودن تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.72,
   "end": 256.1,
   "text": "س-- وطن خودش وضعش خوبه، مشکلی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.1,
   "end": 260.66,
   "text": "اومده سفر، تو سفر به مشکل برخورده، تو راه مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.66,
   "end": 263.16,
   "text": "اینم واجبه که بهش کمک بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.16,
   "end": 270.02,
   "text": "از صدقات. که این‌ها فريضة من الله والله عليم حكيم از طرف خدا اینا فرض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.02,
   "end": 274.52,
   "text": "اما چهارمش رو که مورد بحث ماست والمؤلفة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 274.52,
   "end": 279.74,
   "text": "قلوبهم یکی از وظایف حکما اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.74,
   "end": 283.94,
   "text": "از جالبه از جمع‌آوری صدقات اعم از واجب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 283.94,
   "end": 286.38,
   "text": "مستحب برای تألیف قلوب استفاده کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.38,
   "end": 289.46,
   "text": "این تألیف قلوب تو دو بخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.46,
   "end": 292.32,
   "text": "استفاده میشه. یکی برای جذب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.32,
   "end": 296.44,
   "text": "اون‌هایی که اسلام رو نمی‌شناسن یا حتی مخالفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.44,
   "end": 300.5,
   "text": "حتی تو تفاسیر میگه که پیغمبر فرمود حتی برای کفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.5,
   "end": 305.24,
   "text": "امام صادق صلوات الله علیه فرمود حتی برای مشرکینی که میشه با این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.24,
   "end": 310.44,
   "text": "قلبشون رو الفت برقرار کرد و برگردوند به اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.44,
   "end": 313.66,
   "text": "البته اینجا یه بحثی پیش میاد که مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.66,
   "end": 317.26,
   "text": "بگن که آقا مثلاً اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.26,
   "end": 319.84,
   "text": "پولکی با پول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.84,
   "end": 321.6,
   "text": "دیگری رو مسلمان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.6,
   "end": 323.82,
   "text": "این‌ها باید حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.82,
   "end": 326.86,
   "text": "اتفاقاً صاحب تفسیر نور الثقلین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.86,
   "end": 329.78,
   "text": "میفرماید پرداخت زکات برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.78,
   "end": 334.86,
   "text": "تألیف قلوب به مفهوم ایمان آوردن پولی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.86,
   "end": 337.12,
   "text": "فرمایش صاحب تفسیر نور الثقلین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.12,
   "end": 339.66,
   "text": "بلکه زمینه‌سازی برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.66,
   "end": 345.08,
   "text": "حصول درک و آموزش و سپس معرفت و ایمان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.08,
   "end": 349.5,
   "text": "یعنی اینکه تو با خرج کردن، پول دادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.5,
   "end": 354.78,
   "text": "بخشی از پول رو هزینه کردن برای این کسایی که اسلام رو خوب نمی‌شناسن و گرفتار‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.78,
   "end": 360.06,
   "text": "و چه شیرین که انسان بتونه گرفتاری یکی رو برطرف کنه، بعد جذبش کنه به اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.06,
   "end": 364.59,
   "text": "بگه اصلاً این سخا اسم یکی از درهای بهشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.59,
   "end": 369.71,
   "text": "یه میوه‌ای در بهشت هست که فقط خدا به کسایی می‌ده که دست بخشنده دارن، سخی هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 369.71,
   "end": 374.03,
   "text": "به بقیه نمیده. وقتی تو تعالیم دین رو اینطوری براش بگی خب جذب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.03,
   "end": 377.81,
   "text": "چرا نشه؟ قطعاً میاد جذب دین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.81,
   "end": 380.79,
   "text": "یا کسی که وقتی مسلمون شد، یه جوونی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.79,
   "end": 385.31,
   "text": "داستانش مح-- مشهوره که خیلی به مادرش احترام گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.31,
   "end": 387.81,
   "text": "اگرچه مادرش مسلمون نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.81,
   "end": 393.79,
   "text": "خیلی مادره دید اصن این رفتارش عوض شده از وقتی رفته مسجد، منزل پیغمبر اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.79,
   "end": 398.69,
   "text": "زیرکی که خود بنده انجام دادم اولین بار که رفتم بسیج یادش بخیر مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.69,
   "end": 400.87,
   "text": "فک کنم دوازده سیزده سالم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.87,
   "end": 403.95,
   "text": "خب من جزو شاگردای ممتاز مدرسه بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.95,
   "end": 407.55,
   "text": "رفتم تا یازده شب موندیم یادش بخیر بسیج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.55,
   "end": 409.63,
   "text": "بعد وقتی اومدم خونه پدرم دعوام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.63,
   "end": 412.09,
   "text": "گفت تو سابقه نداشت تا یازده بیرون باشی فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.09,
   "end": 416.37,
   "text": "دیگه نمی‌شه بری بسیج. بعدا خب رگ خواب بابا رو داشتم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.37,
   "end": 419.29,
   "text": "می‌دونستم بابا نگران درس بنده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.29,
   "end": 422.05,
   "text": "حسابی نشستم درس خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.05,
   "end": 427.01,
   "text": "در حین اینکه دیگه زیاد هم تو بسیج نموندم، رتبه درسی‌م رو کشوندم بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.01,
   "end": 429.19,
   "text": "بعد پدرم گفت اگه بسیج اینه برو پسرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.19,
   "end": 432.45,
   "text": "بعدم به شدت شروع کردم تو خونه ظرف می‌شستم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.45,
   "end": 435.73,
   "text": "خونه رو جارو می‌کردم، خریدای خونه رو می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.73,
   "end": 439.33,
   "text": "پدر و مادر گفتن عجب! چه بسیجی شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 439.33,
   "end": 441.73,
   "text": "سرشون رو گول مالیدیم به قول بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.73,
   "end": 446.09,
   "text": "دقیقاً صدر اسلام. والا ما اقتباس کردیم از این نسخه که اون جوون-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.09,
   "end": 449.95,
   "text": "الان برعکس شده بله. بسیج رفتیم اون برعکس شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 449.95,
   "end": 457.55,
   "text": "بله. که پ-- مادره دید این بچه اصلاً عوض شده از وقتی رفته پیش پیغمبر خیلی احترام برای مادر قائل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.55,
   "end": 460.57,
   "text": "گفت چرا تو اینطوری شدی؟ گفت پیغمبر دستور داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 460.57,
   "end": 463.29,
   "text": "این آیه‌شه تو قرآن اومده. گفت چه دین قشنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 463.29,
   "end": 467.95,
   "text": "خب بذار منم مسلمون-- جالبه تا مسلمون شد گفت حالا دیگه چیکار باید بکنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.95,
   "end": 472.69,
   "text": "شهادت این رو داد. اذان مغرب رو داد گفت الان باید نماز مغرب رو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.69,
   "end": 474.29,
   "text": "یه ساعتی گذشت. الان چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 474.29,
   "end": 477.89,
   "text": "الان باید نماز عشا رو بخونیم. پسره نماز به ب-- مادرش یاد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 477.89,
   "end": 480.41,
   "text": "همون شبم مادر از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 480.41,
   "end": 486.49,
   "text": "تو روایت می‌نویسه. ببینید تألیف حالا این بچه صدقه‌ای که به مادرش داد با اخلاق بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.49,
   "end": 492.23,
   "text": "چون خوشرویی، صدقه قابل توجه مدیران، پشت میزنشینان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 492.23,
   "end": 494.71,
   "text": "صاحب منصبان، خوشرویی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 494.71,
   "end": 498.47,
   "text": "عالمان دینی، خوش برخورد کردن، تبسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 498.47,
   "end": 502.11,
   "text": "اینا. المؤمن فرحه فی وجهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 502.11,
   "end": 506.11,
   "text": "و حزنه فی قلبه. که ما برعکس می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.11,
   "end": 509.73,
   "text": "پول خرج کردن. حالا یکی بحثش اینه که تو دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 509.73,
   "end": 511.75,
   "text": "مخالفین یا اونایی که اصلاً م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 511.75,
   "end": 515.19,
   "text": "در حقیقت اسلام رو درست نمی‌شناسن رو جذب کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 515.19,
   "end": 519.23,
   "text": "جذب دین بکنی بعد روشون کار کنی، بعد معارف رو یادشون بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.23,
   "end": 524.35,
   "text": "یکی هم اونایی که نه، اتفاقا واجب‌تر از اون، اونایی که خودشون مؤمنن، مسلمونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 524.35,
   "end": 527.07,
   "text": "اونایی که یعنی تو راه دین هستن و گرفتار شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 527.07,
   "end": 529.25,
   "text": "اونا رو هم دریاب. اتفاقا اینا برترن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.25,
   "end": 532.83,
   "text": "اینا بالاترن. این‌ها رو دریاب که این‌ها نبازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.83,
   "end": 536.85,
   "text": "خیلیا الان به خاطر فشارهای اقتصادی نتونستن تحمل کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 536.85,
   "end": 539.85,
   "text": "گفتن این چه انقلابیه، انقلاب اسلامی اینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.85,
   "end": 545.03,
   "text": "نخواستیم. خیلیا به جهت بی‌تدبیری مسئولین ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 545.03,
   "end": 550.45,
   "text": "یکی از وظایف مهم ما که الان در آستانه انتخابات هم هستیم دیگه بحث رو جمع کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.45,
   "end": 555.17,
   "text": "از وظایف مهم این کسایی که میان متصدی میشن و کاندیدا میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.17,
   "end": 558.85,
   "text": "عزیزان اینه که یه فکری به حال همین بحث‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.85,
   "end": 563.61,
   "text": "مؤلفه قلوبهم بکنن بر اساس آیه قرآن وظیفشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.61,
   "end": 567.33,
   "text": "اینطوری نیست که شما فکر می‌کنی آره وعده وعید داره میده آدم خوبیه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 567.33,
   "end": 569.83,
   "text": "اصلاً تو وظیفته برای همین اومدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 569.83,
   "end": 573.17,
   "text": "چه اینایی که تو وادی دین بودن کمرشون شکسته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 573.17,
   "end": 576.15,
   "text": "ستون فقراتشون شکسته، بهش می‌گن فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 576.15,
   "end": 579.41,
   "text": "یا درمانده شدن. اصلاً نمی‌دونه چه کنه، چه نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 579.41,
   "end": 583.39,
   "text": "مسکینه، گرفتاره به هر حال برای اینا باید یه فکری بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 583.39,
   "end": 585.19,
   "text": "و همچنین برای جذب دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 585.19,
   "end": 592.07,
   "text": "تو همین کشور ما چقدر آدم هست باور کنید اگه گره مالیش بس-- باز بشه برمی‌گرده به سمت دین، به انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 592.07,
   "end": 595.25,
   "text": "چقدر با اقتصاد می‌ده-- می‌شه به مردم خدمت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 595.25,
   "end": 600.77,
   "text": "چقدر ما ریزش داشتیم به خاطر فشارهای اقتصادی و بی‌تدبیری مسمو-- مسئولین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 600.77,
   "end": 602.81,
   "text": "این همه رانت و این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 602.81,
   "end": 607.33,
   "text": "عرض شود دست گروه بازی و بنده پر و چی و این‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 607.33,
   "end": 610.53,
   "text": "پول‌هایی که رفت اون طرف اینا اگه واقعاً اینا می‌اومد خرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 610.53,
   "end": 614.53,
   "text": "فقیر بیچاره‌ها به قول امام ولی نعمت‌های ما پا برهنه ها اینا می‌شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 614.53,
   "end": 616.71,
   "text": "هیچوقت انقلاب ما اینطوری می‌شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 616.71,
   "end": 620.81,
   "text": "یعنی ما الان باید در بین همین آدمایی که کاندیدا شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 620.81,
   "end": 625.77,
   "text": "بریم بر اساس به قول رهبر کارنامه‌هاشون هم بریم ببینیم هر کجا بالاخره یه جایی بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 625.77,
   "end": 630.61,
   "text": "هر کجا بودن آیا این مؤلفه قلوبهم رو در این دو قشر انجام دادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 630.61,
   "end": 636.97,
   "text": "یکی از شاخصه‌هاست. بین آدمایی که مؤمن بودن، انقلابی بودن، کمرشون شکست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 636.97,
   "end": 641.23,
   "text": "به خاطر فشارهای اقتصادی و نتونستن دیگه بیان زیر دوش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 641.23,
   "end": 643.37,
   "text": "دوششونو قرار بدن زیر بار انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 643.37,
   "end": 644.91,
   "text": "دیگه تو مسجد پیداشون نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 644.91,
   "end": 649.21,
   "text": "تو هیئتا پیداشون نشد. آقایونایی که الان چقدر اینجا هستید هیئت دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 649.21,
   "end": 654.47,
   "text": "تو هیئتاتون یه کسی نمیاد به خاطر فشارهای اقتصادی پیگیر می‌شیم اصلاً ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 654.47,
   "end": 656.79,
   "text": "وظیفه، یکی از وظیفه‌های ما اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 656.79,
   "end": 661.15,
   "text": "که پیداش کنیم بالاخره گیر-- یه مدیر، یه مدیر همکارش چرا پریشونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 661.15,
   "end": 663.07,
   "text": "چرا گرفتاره؟ چرا نمی‌خنده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 663.07,
   "end": 666.23,
   "text": "چرا سلام منو خشک داد؟ حتماً گرهی تو کارشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 666.23,
   "end": 669.03,
   "text": "برم سراغش. یه مدیر کارآمد اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 669.03,
   "end": 670.65,
   "text": "بره آقا تو دردت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 670.65,
   "end": 672.87,
   "text": "مشکلت چیه؟ چرا اینطوری شدی؟ چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 672.87,
   "end": 675.87,
   "text": "سر کار دیر میای، زود میری، نمی‌دونم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 675.87,
   "end": 681.07,
   "text": "اینا پس یکی از وظایف بر اساس قرآن که شاخصه‌هایی که انسان می‌تونه پیدا کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 681.07,
   "end": 683.37,
   "text": "به سراغش بره. تا می‌تونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 683.37,
   "end": 686.11,
   "text": "با صدقات البته صدقه فقط هم مالی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 686.11,
   "end": 691.39,
   "text": "تو صحبتم عرض کردم. با صدقات تا می‌تونید هنر یه بچه مؤمن اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 691.39,
   "end": 696.19,
   "text": "که تا می‌تونه جذب دین کنه، تألیف قلوب، قلوب بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 696.19,
   "end": 704.05,
   "text": "الفت یا قلب معروف قبلاً عرض کردیم از الف میاد بر وزن جسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 704.05,
   "end": 707.49,
   "text": "الف یعنی در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 707.49,
   "end": 715.17,
   "text": "جمع کردن، توی تمرکز قوا انجام دادن، جمع کردن از تشتت و پراکندگی جلوگیری کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 715.17,
   "end": 716.91,
   "text": "بسم الله با اخلاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 716.91,
   "end": 719.41,
   "text": "اخلاق خوش خودش یه صدقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 719.41,
   "end": 724.59,
   "text": "سلام گرم دادن، دست حالا الان که متأسفانه این بر افتاده، دست گرم فشار دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 724.59,
   "end": 728.33,
   "text": "اینا صدقه است. پول خرج کردن بهترین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 728.33,
   "end": 731.93,
   "text": "حالا تا اینجا رسیدیم اینم بگم و تمام کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 731.93,
   "end": 734.57,
   "text": "من تحقیق کردم به شما تحقیقا عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 734.57,
   "end": 737.45,
   "text": "الان تا طرف می‌میره براش چیکار می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 737.45,
   "end": 741.79,
   "text": "چیکار می‌کنن بفرمایید. تا مرد شب دفنش چیکار می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 741.79,
   "end": 744.81,
   "text": "آفرین نماز لیلة الدفن یا وحشت می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 744.81,
   "end": 749.41,
   "text": "می‌دونستید نصف روایت رو نمی‌گن و عمل نمی‌کنن اکثراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 749.41,
   "end": 752.31,
   "text": "اصلاً روایت می‌گه تا طرف مرد براش صدقه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 752.31,
   "end": 754.67,
   "text": "اونم صدقه قابل توجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 754.67,
   "end": 756.97,
   "text": "هیچ چیزی برای مؤمن مثل صدقه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 756.97,
   "end": 763.07,
   "text": "اینو من به شما بگم. هیچی. اگر نداشتی صدقه بدی این نماز رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 763.07,
   "end": 765.61,
   "text": "اون اولیشو نمی‌گن به من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 765.61,
   "end": 770.23,
   "text": "اول صدقه بده اگه نداشتی این نماز جایگزین اون صدقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 770.23,
   "end": 772.95,
   "text": "انقدر یعنی دست امواتو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 772.95,
   "end": 777.11,
   "text": "چه برسه این زنده‌ها رو. بعد ما فقط می‌خوایم فقط به نظر می‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 777.11,
   "end": 785.13,
   "text": "با اشک و گریه و هیئت و با نماز و این شعائر ظاهریه اینطوری جذب کنیم اما حاضر نیستیم پول خرج کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 785.13,
   "end": 789.77,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 789.77,
   "end": 793.69,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}