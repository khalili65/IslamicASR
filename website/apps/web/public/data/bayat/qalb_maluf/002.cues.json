 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتای فطریهٔ مهمان شب عید فطر",
   "start": 0.46,
   "end": 93.24
  },
  {
   "index": 1,
   "title": "## قلب مألوف؛ لغت تألیف",
   "start": 93.24,
   "end": 170.26
  },
  {
   "index": 2,
   "title": "### چرا ایلاف؟ کار تجاری هاشم",
   "start": 170.26,
   "end": 322.02
  },
  {
   "index": 3,
   "title": "### بازگشت به قلب مألوف",
   "start": 322.02,
   "end": 403.84
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 5.18,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.18,
   "end": 10.14,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.14,
   "end": 15.44,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.44,
   "end": 18.7,
   "text": "خب استفتایی که از رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.7,
   "end": 27.66,
   "text": "خود بنده کردم در خصوص این حرفی که بین مردم شایع هست که اگر چنانچه کسی شب عید فطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.66,
   "end": 35.58,
   "text": "افطاری کسی رو دعوت کنه فطریه‌ش میفته گردن میزبان، فطریه مهمان میفته گردن میزبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 35.58,
   "end": 37.94,
   "text": "چون در فتوا هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.94,
   "end": 45.54,
   "text": "آقا فرمودن که اگر طرف نانخور میزبان هست و مهمان نانخور میزبان بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.54,
   "end": 47.68,
   "text": "فطریه‌ش میفته گردن میزبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.68,
   "end": 50.22,
   "text": "اما مصداق نانخور چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.22,
   "end": 55.66,
   "text": "این مهمه. من از دفتر آقا خودم که استفتاء کردم این حکم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.66,
   "end": 62.06,
   "text": "فرمودن که آقا نظرشون اینه که با یکی دو شب کسی نانخور کسی نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 62.06,
   "end": 64.64,
   "text": "حالا شما یه شب عید فطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.64,
   "end": 68.54,
   "text": "مثلا کسی رو دعوت کنی افطاری خونه‌تون، نخیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.54,
   "end": 71.24,
   "text": "اگر مقلد آقا هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.24,
   "end": 76.16,
   "text": "با خیال راحت بگیر و فطریه مهمان تو گردن تو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.16,
   "end": 78.8,
   "text": "و پرسیدم خب نظر دیگران چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.8,
   "end": 82.96,
   "text": "ظاهراً بعضیا از یک هفته تا دو هفته اینا گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.96,
   "end": 86.12,
   "text": "اگر کسی مهمان شد جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.12,
   "end": 89.82,
   "text": "اون میشه نانخور. با یکی دو شب و سه شب و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.82,
   "end": 93.24,
   "text": "نانخور نمیشه. خیالتون راحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.24,
   "end": 97.64,
   "text": "بحث قلب معلوف رو به فضل الهی دومین جلسه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.64,
   "end": 100.68,
   "text": "ادامه بدیم. از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.68,
   "end": 104.42,
   "text": "کتاب‌های لغت معانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.42,
   "end": 107.8,
   "text": "بنده توجه کردم در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.8,
   "end": 111.34,
   "text": "تألیف، تألیف به چه معناست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.34,
   "end": 114.6,
   "text": "تدوین، تصنیف اینا مترادفاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.6,
   "end": 119.38,
   "text": "این در حقیقت ترجمه‌های بحث تألیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.38,
   "end": 125.92,
   "text": "جمع‌آوری، گردآوری کردن، نگارش، تدوین کردن، ایجاد الف و انس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.92,
   "end": 130.16,
   "text": "انس و الفت و دلجویی، دلجویی هم حساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.16,
   "end": 133.58,
   "text": "ترکیب کردن، پیوند دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.58,
   "end": 137.96,
   "text": "مثلا تو لغت‌نامه ده، دهخدا نگاه کردم نوشته بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.96,
   "end": 140.32,
   "text": "تألیف و جمع کردن معنا کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.32,
   "end": 142.44,
   "text": "مقام جمعی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.44,
   "end": 149.62,
   "text": "جمع کردن که البته در قرآن هم می‌دونید در سوره قرش این به این شکل اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.62,
   "end": 152.64,
   "text": "ایلاف هم، لایلاف قرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.64,
   "end": 155.74,
   "text": "همون از ریشه الف و لام و فاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.74,
   "end": 159.76,
   "text": "همون هم‌خانواده معلوفه، الفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.76,
   "end": 163.02,
   "text": "لایلاف قرش، ایلافهم رحلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.02,
   "end": 166.48,
   "text": "شتاء و صيف. حالا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.48,
   "end": 169.48,
   "text": "توجه کردم تو تفاسیر و اینا دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.48,
   "end": 171.74,
   "text": "خب چرا اینجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.74,
   "end": 175.58,
   "text": "میره به بحث اجداد پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.58,
   "end": 186.56,
   "text": "بنی عبد مناف فرزندان حضرت عبد مناف که جد پیغمبر بودن یکیشون هاشم بود که دیگه ایشون هم میشه جد پیغمبر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.56,
   "end": 189.14,
   "text": "که این‌ها حضرت هاشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.14,
   "end": 197.58,
   "text": "سلام الله علیه، ایشون اولین کسی بود که در قرش در مکه سفرهای تابستانه و زمستانه رو باب کرد تو قرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.58,
   "end": 202.4,
   "text": "چرا؟ تو مکه قحطی بود، گرسنگی بود، سختی بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.4,
   "end": 208.58,
   "text": "خشکی بود و قرش داشتن از هم متشتت و جدا جدا می‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.58,
   "end": 213.12,
   "text": "اون الفت از بینشون داشت از بین می‌رفت که برن جاهای دیگه کار کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.12,
   "end": 216.62,
   "text": "ایشون اومد سفرهای تجاری رو راه انداخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.62,
   "end": 219.4,
   "text": "به کشورهای دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.4,
   "end": 222.58,
   "text": "به عرض شود سرزمین‌های دیگه می‌رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.58,
   "end": 227.68,
   "text": "که جالبه که حالا من حتی درآوردم که برادران ایشون، برادران چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.68,
   "end": 231.14,
   "text": "خیلی زیاد هم بودند اینا هر کدوم به کجا رفتن سفر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.14,
   "end": 235.0,
   "text": "مثلا خود حضرت هاشم سلام الله علیه به، رفت پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.0,
   "end": 241.72,
   "text": "قیصر در شام. اونجا معاهده‌ی پیمان، مثلا پیمان تجاری امضا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.72,
   "end": 247.32,
   "text": "و اون‌ها هم به بالاخره کلیددارای کعبه، به مردمی که در حرم امن الهی بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.32,
   "end": 249.76,
   "text": "حتی اونایی هم که قائل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.76,
   "end": 254.1,
   "text": "توحید ابراهیمی نبودن خیلی احترام قائل بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.1,
   "end": 258.28,
   "text": "مثلا برادرشون نفل رفت پیش کسری در عراق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.28,
   "end": 262.5,
   "text": "عبد شمس که باز برادر حضرت هاشم فرزند عبد منافه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.5,
   "end": 264.92,
   "text": "ایشون رفت پیش نجاشی، نجاشی در حبشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.92,
   "end": 269.06,
   "text": "مطلب رفت پیش پادشاه حمیر در یمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.06,
   "end": 271.18,
   "text": "همه این‌ها رو البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.18,
   "end": 274.66,
   "text": "اصحاب ایلاف یاد می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.66,
   "end": 276.94,
   "text": "کیا رو؟ بنی عبد منافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.94,
   "end": 279.32,
   "text": "رسوخ مذهب‌ها تو ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.32,
   "end": 283.24,
   "text": "بود. جان؟ رسوخ مذهب‌ها تو مذاهب ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.24,
   "end": 285.64,
   "text": "بود. بله جزءش بوده دیگه. ایشون-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.64,
   "end": 289.56,
   "text": "پخش شده. بله اینا همه یک س-- یک امپراتوری بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.56,
   "end": 292.32,
   "text": "احسنت. یک امپراتوری بودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.32,
   "end": 298.36,
   "text": "مثل مثلا ایران خودمون که الان یک حکومته با چندین استان، این شکلی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.36,
   "end": 300.38,
   "text": "به هر حال اینا پخش شدند. چیکار کردند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 300.38,
   "end": 302.92,
   "text": "چرا میگه لایلاف قرش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.92,
   "end": 305.74,
   "text": "اشاره می‌کنه به اون تألیف قلوبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.74,
   "end": 308.46,
   "text": "حضرت هاشم جد پیغمبر تو قرش ایجاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.46,
   "end": 312.24,
   "text": "این‌ها رو جمع کرد دور هم و حفظ کرد این‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.24,
   "end": 314.06,
   "text": "که این کار بسیار با ارزشیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.06,
   "end": 318.18,
   "text": "خیلی کار قشنگیه. مقام جمعه، مقام جمعیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.18,
   "end": 324.96,
   "text": "که جالبه که حالا برگردیم به بحث سیر بحث خودمون، یه حاشیه رفتیم از جهت تاریخی متوجه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.96,
   "end": 330.84,
   "text": "حالا معنای تألیف و ایلاف و الفت و اینا بشیم چون بحث ما قلب معلوفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.84,
   "end": 333.12,
   "text": "اساساً خود قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.12,
   "end": 336.24,
   "text": "جمعی‌ست، مقامش مقام جمعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.24,
   "end": 339.26,
   "text": "قلب تمام شؤون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.26,
   "end": 341.76,
   "text": "دوائر وجود رو در خودش جمع کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.76,
   "end": 344.8,
   "text": "لذا بهش، بهش میگن مقام حضور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.8,
   "end": 348.4,
   "text": "مقام در حقیقت جمعیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.4,
   "end": 353.0,
   "text": "و همه قوای تو متمرکز در قلب تو هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.0,
   "end": 357.04,
   "text": "لذا می‌فرماید قلب المؤمن عجیب حدیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.04,
   "end": 361.88,
   "text": "عرش الرحمن. اساساً عرش مقام جمعیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.88,
   "end": 371.0,
   "text": "البته این جمعی برای اینکه متوجه بشیم قشنگ یعنی چی تو سیر بحث حکمی و عرفانیمون درست پیش بریم به نظم بحث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.0,
   "end": 374.02,
   "text": "متوجه باشید که این مقام جمعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.02,
   "end": 376.8,
   "text": "در قوس صعود اتفاق می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.8,
   "end": 381.2,
   "text": "در قوس نزول از جمع تشتت ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 381.2,
   "end": 384.06,
   "text": "انا لله. من از قوس صعود، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.06,
   "end": 387.8,
   "text": "قوس النزول از سمت حضرت حق شما تشریف آوردید به این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.8,
   "end": 392.5,
   "text": "همه کثرات یعنی از یک وجود واحد، واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.5,
   "end": 394.86,
   "text": "خدای احد، واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.86,
   "end": 397.38,
   "text": "صمدی، این از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.38,
   "end": 399.6,
   "text": "حقیقت توحید ناب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.6,
   "end": 403.84,
   "text": "کثرات چی شدند؟ ظهور کردند. کنت کنز-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}