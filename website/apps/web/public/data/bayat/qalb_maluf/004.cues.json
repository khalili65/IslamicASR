 "chapters": [
  {
   "index": 0,
   "title": "## عید فطر؛ شکفتن و بازگشت به فطرت",
   "start": 8.56,
   "end": 93.86
  },
  {
   "index": 1,
   "title": "## جبههٔ نخست؛ عمل جوارحی و قطره‌چکانی",
   "start": 93.86,
   "end": 121.18
  },
  {
   "index": 2,
   "title": "## جبههٔ دوم؛ قلب و کشف و شهود",
   "start": 121.18,
   "end": 141.18
  },
  {
   "index": 3,
   "title": "## جبههٔ سوم؛ کار عقلی که از آن می‌گریزیم",
   "start": 141.18,
   "end": 447.26
  },
  {
   "index": 4,
   "title": "## سه کتاب علامه؛ آفاق و تدوین و انفس",
   "start": 447.26,
   "end": 587.74
  },
  {
   "index": 5,
   "title": "## خواب؛ آینهٔ هستی در جان",
   "start": 587.74,
   "end": 697.12
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 4.6,
   "text": "السلام علیک ایADA الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.6,
   "end": 7.36,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.36,
   "end": 12.82,
   "text": "تبریک عرض می‌کنم این عید بسیار با عظمت رو که عید شکفتن است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.82,
   "end": 16.44,
   "text": "برگشتن به فطرت و درون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.44,
   "end": 22.76,
   "text": "از رهبر عزیزمون استفتاء شده در خصوص فطریه که اگر کسی فطریه‌ش رو نده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.76,
   "end": 27.54,
   "text": "به هر دلیلی نتونسته بده فطریه رو و مدتی گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.54,
   "end": 34.22,
   "text": "چه کنه؟ آقا فرمودن که اگر فقیر بوده نداشته که بده که هیچ از گردنش ساقطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.22,
   "end": 37.56,
   "text": "اما اگر فقیر نبوده به هر دلیل دیگه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.56,
   "end": 41.32,
   "text": "نداده، این احتیاط واجب این است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.32,
   "end": 44.9,
   "text": "آقا اینجا احتیاط کردن، فتوا ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.9,
   "end": 47.08,
   "text": "احتیاط واجب این هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.08,
   "end": 49.36,
   "text": "بده فطریه رو حتما بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.36,
   "end": 54.38,
   "text": "که وقتی احتیاط واجبه دیگه می‌دونید یعنی یا باید همین رو حتما انجام بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.38,
   "end": 57.78,
   "text": "یا رجوع کنی به مجتهدی که بعد از رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.78,
   "end": 61.74,
   "text": "یا بعد از مجتهد تو اعلمه ببینی ایشون چی فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.74,
   "end": 65.52,
   "text": "یکی از این دو راه رو داره. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.52,
   "end": 70.86,
   "text": "در خصوص از اینجا به بعد اون یک ماه الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.86,
   "end": 75.2,
   "text": "خدای مهربانم توفیق داد که سر سفره‌ش باشیم قشنگ م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.2,
   "end": 79.2,
   "text": "همه داریم متوجه می‌شیم به قول معروف با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.2,
   "end": 87.26,
   "text": "حس غیرمسلح حتی کاملاً متوجه می‌شیم که انگار یک بساتی جمع شد، یه فضایی رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.26,
   "end": 89.88,
   "text": "یه چیز دیگه‌ای شد. اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.88,
   "end": 92.62,
   "text": "همه دلتنگی و بی‌قراری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.62,
   "end": 95.8,
   "text": "این‌ها باید تو سه جبهه حرکت شروع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.8,
   "end": 99.62,
   "text": "یعنی از عید فطر به بعد حتماً یعنی این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.62,
   "end": 103.94,
   "text": "تأکید بزرگان اهل معرفت نه بنده حقیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.94,
   "end": 109.1,
   "text": "که اگر به غیر از این سه جبهه ما حرکت نکنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.1,
   "end": 112.72,
   "text": "قطعاً ماه عسل ماه مبارک رمضان‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.72,
   "end": 115.48,
   "text": "به باد فنا خواهد رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.48,
   "end": 120.68,
   "text": "و دستخوش تصورات شریطانی خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.68,
   "end": 125.46,
   "text": "در سه جبهه ما باید حرکت کنیم که اتفاقاً وقتی هم که از این دنیا میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.46,
   "end": 128.84,
   "text": "تو همین سه جبهه ما مورد بررسی قرار می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.84,
   "end": 131.74,
   "text": "یک بحث عمل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.74,
   "end": 136.12,
   "text": "جوارح با اعضا و جوارح عبادت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.12,
   "end": 139.54,
   "text": "ما باید با همون وزان بلکه بهتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.54,
   "end": 141.18,
   "text": "عبادتمون رو ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.18,
   "end": 143.92,
   "text": "عبادت‌ها، شبزنده‌داری‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.92,
   "end": 147.78,
   "text": "ختم قرآن کردن‌ها، ذکرها، وردها، نمازها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.78,
   "end": 154.3,
   "text": "عبادت رو. و من توصیه می‌کنم حالا بعداً انشاالله تو بحثمون اگه دوست داشتید این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.3,
   "end": 157.38,
   "text": "روش کار می‌کنیم. توصیه می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.38,
   "end": 159.94,
   "text": "نمکین بریم جلو اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.94,
   "end": 166.92,
   "text": "پی‌در‌پی. به جای اینکه بشینیم یه دفعه یه ختم قرآن مثلاً یه، یه جزء قرآن رو بخونیم یک ساعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.92,
   "end": 170.84,
   "text": "بعد نفس بیاد به ما فشار بیاره که بابا خسته میشی ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.84,
   "end": 172.84,
   "text": "این‌ها چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.84,
   "end": 175.32,
   "text": "خورد خورد، قطره‌شکانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.32,
   "end": 184.02,
   "text": "امتحان کنید. مثلاً برنامه بذارید هر وقت می‌خواید برید سراغ موبایلتون، موبایلتونو باز کنید یه صفحه قرآن بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.02,
   "end": 189.94,
   "text": "امتحان کنید. من همین دیروز این کارو کردم پونزده صفحه قرآن خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.94,
   "end": 194.0,
   "text": "گفتم خدایا امروز هر وقت خواستم موبایلمو نگاه کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.0,
   "end": 196.22,
   "text": "موبایل مهم‌تره یا نگاه به کتاب تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.22,
   "end": 198.6,
   "text": "کتاب تو. یه صفحه قرآن بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.6,
   "end": 203.94,
   "text": "دیدم پونزده شب شد حساب کردم دیدم پونزده صفحه قرآن یعنی پونزده بار رفته بودم سراغ موبایلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.94,
   "end": 205.86,
   "text": "خب امتحان کنید این قطره‌شکانی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.86,
   "end": 209.64,
   "text": "یه صفحه من خوندم دیدم دو دقیقه طول کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.64,
   "end": 213.74,
   "text": "خب این باعث می‌شه میگه حتی حدیث داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.74,
   "end": 215.72,
   "text": "خودعه بزن به نفست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.72,
   "end": 218.88,
   "text": "به نفست خودعه بزن، کلاه سرش بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.88,
   "end": 222.12,
   "text": "وقتی بگی یه دقیقه می‌خوام قرآن بخونم نفس اشکال نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.12,
   "end": 225.62,
   "text": "میگه بخون بابا یه دقیقه چیه؟ و تو سرشو کلاه می‌ذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.62,
   "end": 231.7,
   "text": "همین‌طوری. یه دور تسبیح به جای هزار تا یه دور تسبیح مثلاً صلوات، استغفار اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.7,
   "end": 234.62,
   "text": "حالا این خودش یه بحثیه که به موقعش باید روش کار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.62,
   "end": 238.32,
   "text": "پس بحث، بحث عمل به جوارح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.32,
   "end": 241.46,
   "text": "که نباید این کفش به هر حال این وزنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.46,
   "end": 244.48,
   "text": "ااا کم بشه نسبت به ماه مبارک رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.48,
   "end": 247.22,
   "text": "دو بحث قلب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.22,
   "end": 250.04,
   "text": "حرکت قلبی، کشف شهود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.04,
   "end": 252.86,
   "text": "کشف و شهود همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 252.86,
   "end": 258.5,
   "text": "به نحو اشراق در ماه مبارک رمضان به شما القاءاتی رخ داد از جاناهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.5,
   "end": 261.28,
   "text": "مقدس حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.28,
   "end": 263.46,
   "text": "قطعاً این رو باید ادامه بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.46,
   "end": 265.28,
   "text": "کشف و شهودتون رو حفظ کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 265.28,
   "end": 267.8,
   "text": "کشف و شهود با چی رخ میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 267.8,
   "end": 269.76,
   "text": "با گناه نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 269.76,
   "end": 272.22,
   "text": "خیلی رک، پوست کنده، راحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 272.22,
   "end": 275.98,
   "text": "اینکه گناه نکنیم. اگر کسی به سمت گناهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 275.98,
   "end": 279.14,
   "text": "و معاصی حرکت کنه دیگه کشفی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 279.14,
   "end": 282.08,
   "text": "به قول معروف که کشفت کشکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 282.08,
   "end": 286.48,
   "text": "اگر کسی نگاهش دوباره آلوده بشه میگه غض ابصارکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.48,
   "end": 289.84,
   "text": "ترهم العجائب چشماتو ببند عجائب رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 289.84,
   "end": 292.14,
   "text": "یعنی چی عجائب رو ببین؟ یعنی پشت پرده رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 292.14,
   "end": 296.46,
   "text": "یعنی چی پشت پرده رو ببینی؟ کشف و شهود میشینه قلبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 296.46,
   "end": 301.0,
   "text": "یکی از دوباره اون جبهه‌هایی که بعد از مرگ ما مورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 301.0,
   "end": 303.9,
   "text": "سؤال قرار می‌گیریم بحث قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 303.9,
   "end": 307.44,
   "text": "قلب که حالا ما دو سه ساله روش داریم focus کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 307.44,
   "end": 312.8,
   "text": "از بحث قرآنی داریم قلب‌ها رو یک یک می‌شماریم میریم جلو و الان رسیدیم به قلب معلوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 312.8,
   "end": 314.84,
   "text": "که تألیف محل الفت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 314.84,
   "end": 317.82,
   "text": "تألیف، جمع، مقام جمعی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 317.82,
   "end": 322.1,
   "text": "عرش خداست. که ما باید و حتماً حتماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 322.1,
   "end": 327.28,
   "text": "بحث کشف قلبی‌مون رو جدی بگیریم با ترک معاصی و گناهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 327.28,
   "end": 330.84,
   "text": "سومیش هم که متأسفانه، متأسفانه، متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 330.84,
   "end": 335.56,
   "text": "یا دل نمیدیم یا فرارییم یا اصلاً توجه بهش نداریم و اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 335.56,
   "end": 342.82,
   "text": "اون‌هایی که تریبون به دست هستن هم خیلی توجه به این ندارن به جهت اینکه مستمعین فراری میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 342.82,
   "end": 344.54,
   "text": "و مستمعین هم دل نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 344.54,
   "end": 347.56,
   "text": "بیشتر دوست دارن آقا یه ذکر بده، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 347.56,
   "end": 349.84,
   "text": "دستور العمل بده در نحو چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 349.84,
   "end": 352.86,
   "text": "در بحث جوارح. یعنی اون جبهه اول، عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 352.86,
   "end": 354.72,
   "text": "چگونه عبادت کنیم؟ چه جوری ذکر بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 354.72,
   "end": 357.06,
   "text": "چه-- آقا یه دستور العمل بده حاج آقا فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 357.06,
   "end": 359.7,
   "text": "یه ذکر بده گرم باز شه. بحث دست--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 359.7,
   "end": 365.68,
   "text": "یا تو بحث کشف و کرامت قلبی میگه آقا چه کنیم مثلاً گناه نکنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 365.68,
   "end": 369.86,
   "text": "موعظه حسنه. بیشتر دنبال موعظه‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 369.86,
   "end": 373.3,
   "text": "در صورتی که دعای امروز رو اگه خونده باشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 373.3,
   "end": 377.74,
   "text": "دعای روز شنبه رو یا زیارت پیغمبر در امروز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 377.74,
   "end": 381.3,
   "text": "خونده باشید، اونجا میگی-- عرض می‌کنی به پیغمبر که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 381.3,
   "end": 383.74,
   "text": "دعوت کردی به سمت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 383.74,
   "end": 386.34,
   "text": "بر اساس آیه ادعو الی سبيل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 386.34,
   "end": 393.6,
   "text": "ربک اول بالحکمة با حکمت بعد موعظة الحسنة که بحثش قبلاً گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 393.6,
   "end": 396.14,
   "text": "جبهه‌ی سوم که معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 396.14,
   "end": 401.84,
   "text": "از ما بگیرید تا شما معمولاً ازش فراری هستیم، دل نمی‌دیم کار عقلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 401.84,
   "end": 404.14,
   "text": "آقا جون بالاخره ما عقل داریم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 404.14,
   "end": 407.96,
   "text": "اصلاً این عقل رو خدا برای چی به من و شما داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 407.96,
   "end": 410.22,
   "text": "عقل رو برای کارهای دشوار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 410.22,
   "end": 412.6,
   "text": "دقت بفرمایید. دشوار نه متعارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 412.6,
   "end": 416.68,
   "text": "حالا آقا روزه یا شبه؟ خب معلومه روزه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 416.68,
   "end": 421.2,
   "text": "خب این ربط به عقل ما داره اینکه الان روزه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 421.2,
   "end": 427.96,
   "text": "این به عقل ربط داره یا به قوه‌ی خیال ما به اون سطوح از مسائل حسی ما تشخیص می‌ده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 427.96,
   "end": 431.84,
   "text": "نگاه ما، بصر ما تشخیص می‌ده اصلاً نیازی به عقل نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 431.84,
   "end": 433.56,
   "text": "عقل جاهای دشواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 433.56,
   "end": 437.64,
   "text": "بری درون مایه آیات و روایات رو بکشی بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 437.64,
   "end": 441.2,
   "text": "بری توجه کنی به نظام آفاقی، به نظام انف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 441.2,
   "end": 444.06,
   "text": "انفسی، به کتاب تدوینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 444.06,
   "end": 449.04,
   "text": "حالا حصرتون نکنم. اینجا که می‌رسیم حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 449.04,
   "end": 451.46,
   "text": "دیگه قلم زده. غوغا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 451.46,
   "end": 454.54,
   "text": "کولاک کرده. می‌گه آقا جون وظیفه شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 454.54,
   "end": 458.66,
   "text": "این جبهه سومه. کار عقلی و بعد از مرگ هم از ما سؤال می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 458.66,
   "end": 461.1,
   "text": "رک بگم از ما سؤال خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 461.1,
   "end": 463.44,
   "text": "کار عقلی چقدر کردی؟ مگه عقل نداشتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 463.44,
   "end": 465.68,
   "text": "مگه وجه تمایز شما با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 465.68,
   "end": 468.04,
   "text": "حیوانات عقل نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 468.04,
   "end": 471.9,
   "text": "با عقلت چه کردی؟ عقل مال جاهای دشواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 471.9,
   "end": 474.78,
   "text": "خطر. می‌گه آقا من نمی‌فهمم حرفی که تو می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 474.78,
   "end": 476.88,
   "text": "خب نمی‌فهمی بشین تفکر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 476.88,
   "end": 481.66,
   "text": "چطور شیخ الرئیس وقتی متوجه نمی‌شد دوری کرد نماز می‌خوند، توسل می‌کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 481.66,
   "end": 486.7,
   "text": "می‌رفت می‌زد به بیابون از امام عصر می‌خواست که گره‌ی علمیش باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 486.7,
   "end": 491.56,
   "text": "چطور مرحوم آله 神 الهی برادر حضرت علامه حسن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 491.56,
   "end": 500.06,
   "text": "حضرت علامه طباطبایی چطور وقتی یه گره‌ی علمی براش پیش می‌اومد از کشف کرامات قلبیش، شهود قلبیش استفاده می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 500.06,
   "end": 503.86,
   "text": "می‌رفت تو قبرستون با ارواح بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 503.86,
   "end": 510.62,
   "text": "مثلاً آصف دلیی قاضی و این‌ها سعی می‌کرد ارتباط بگیره که بتونه گره‌ی علمیش و عقلیش باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 510.62,
   "end": 513.96,
   "text": "ولی من تا یه چیزی رو نمی‌فهمم پس می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 513.96,
   "end": 516.78,
   "text": "این سه تا کتاب رو حضرت علامه توصیه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 516.78,
   "end": 521.66,
   "text": "جالبه که یه جا یه جای خیلی شلوغ و حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 521.66,
   "end": 525.12,
   "text": "دست به قلمم بودم خیلی برام جای تعجب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 525.12,
   "end": 527.08,
   "text": "من این مطلب رو عنوان کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 527.08,
   "end": 529.54,
   "text": "بعد دیدم بعد از منبر یکی اومد گفت آقا میشه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 529.54,
   "end": 531.9,
   "text": "سه تا کتاب رو بگید از کجا می‌تونیم بخریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 531.9,
   "end": 537.7,
   "text": "حالا ببینید کتاب‌ها چی بود که بعد متوجه می‌شید چرا من تعجب کردم از سؤال ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 537.7,
   "end": 540.56,
   "text": "این سه تا کتاب رو علامه فرموده چاره‌ای ندارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 540.56,
   "end": 542.6,
   "text": "باید بخونید اونم با عقلتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 542.6,
   "end": 545.64,
   "text": "یک، کتاب آفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 545.64,
   "end": 549.3,
   "text": "خوانش کتاب حالا بهش می‌گن کتاب هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 549.3,
   "end": 552.48,
   "text": "از جهت عرفانی بهش می‌گن قرآن هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 552.48,
   "end": 555.36,
   "text": "و فی الارض آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 555.36,
   "end": 559.16,
   "text": "للمؤمنین. این یه کتابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 559.16,
   "end": 568.32,
   "text": "آفا-- نظام آفاقی زمین و آسمان إن في خلق السماوات والأرض واختلاف الليل والنهار لآيات البته لأولي الألباب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 568.32,
   "end": 570.08,
   "text": "برای اهل فکر، اهل مغز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 570.08,
   "end": 571.66,
   "text": "کجاست این مغز ما کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 571.66,
   "end": 573.9,
   "text": "تفکر به آیات الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 573.9,
   "end": 576.6,
   "text": "دو، کتاب چی؟ کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 576.6,
   "end": 579.84,
   "text": "تدوینی. کتاب تدوینی همین قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 579.84,
   "end": 582.72,
   "text": "تدبر در آیات. نه اینکه همینجوری رد شیم ازش بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 582.72,
   "end": 585.18,
   "text": "از ظاهرش به باطنش برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 585.18,
   "end": 592.4,
   "text": "بریم تدبر در قرآن رو ببینیم ملاصدرا چه معنا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 592.4,
   "end": 596.34,
   "text": "و پییش رو بگیریم در کتاب مفاتیح الغیبش ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 596.34,
   "end": 600.58,
   "text": "ده تا شرط آورده در فاتحه دوم مفاتیح دومش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 600.58,
   "end": 604.34,
   "text": "می‌فرماید ده تا شرط داره تو از ظاهر به باطن قرآن برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 604.34,
   "end": 605.96,
   "text": "یکی فهم عظمت قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 605.96,
   "end": 608.5,
   "text": "بفهمی قرآن چه عظمتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 608.5,
   "end": 612.96,
   "text": "راه‌هاش رو بریم دنبالش بگیریم. سومین کتاب هم کتاب انفسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 612.96,
   "end": 620.36,
   "text": "جان. این سه تا کتاب رو باید خوند و فی الارض آیات للمؤمنین و فی أنفسکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 620.36,
   "end": 624.84,
   "text": "أفلا تبصرون. تو جان شما هم آیه ها خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 624.84,
   "end": 631.7,
   "text": "جان خودت رو بررسی کن که وقتی جان خودت رو بررسی کنی می‌بینی قرآن خودتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 631.7,
   "end": 637.94,
   "text": "اساساً تمام نظام آفاقی همه‌ی این‌ها در وجود تو خوابیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 637.94,
   "end": 643.06,
   "text": "تو وقتی خواب می‌بینی همه‌ی نظام هستی رو سیر می‌کنی میای کجا می‌بینی این‌ها رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 643.06,
   "end": 645.86,
   "text": "تو وجود خودت. کجا دیدی این‌ها رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 645.86,
   "end": 648.24,
   "text": "چگونه دیدی؟ تو که اینجا بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 648.24,
   "end": 653.36,
   "text": "این سیر رو که حالا باز، باز هم برای چندمین بار تاکید می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 653.36,
   "end": 659.36,
   "text": "کتاب سیر معرفت نفس از علامه رو برید پی بگیرید عزیزان دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 659.36,
   "end": 661.22,
   "text": "ببینید به کجا می‌کشونت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 661.22,
   "end": 665.58,
   "text": "این سه تا کتاب رو باید از سیر عقلی شروع کرد رفت جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 665.58,
   "end": 668.08,
   "text": "کتاب هستی، نظام آفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 668.08,
   "end": 670.9,
   "text": "کتاب تدوینی، قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 670.9,
   "end": 674.24,
   "text": "کتاب انفسی، معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 674.24,
   "end": 678.44,
   "text": "این تازه می‌شه سیر عقلیمون. اگر تو این سه جبهه رفتیم جلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 678.44,
   "end": 682.48,
   "text": "موفق بودیم، انشالله ما بنده خوبی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 682.48,
   "end": 685.7,
   "text": "اما اگر تو این‌ها در جا زدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 685.7,
   "end": 689.06,
   "text": "شرمنده‌ام و قیامت باید حساب کتاب پس بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 689.06,
   "end": 694.22,
   "text": "ان شا الله که عاقبت ما ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 694.22,
   "end": 697.12,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}