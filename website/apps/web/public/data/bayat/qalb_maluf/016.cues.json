 },
 "chapters": [
  {
   "index": 0,
   "title": "## پیش از معرکه؛ خطّ قیام در دعای عرفه",
   "start": 11.46,
   "end": 97.14
  },
  {
   "index": 1,
   "title": "## توحید در دعای عرفه؛ از استدلال به فقر وجود",
   "start": 97.14,
   "end": 485.32
  },
  {
   "index": 2,
   "title": "## غیبت و شهود؛ حجابِ شدّت نور",
   "start": 485.32,
   "end": 512.02
  },
  {
   "index": 3,
   "title": "## قرب و بعد؛ وحدت وجود",
   "start": 512.02,
   "end": 735.1
  },
  {
   "index": 4,
   "title": "## بک أستدلّ علیک",
   "start": 735.1,
   "end": 848.12
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 2.98,
   "text": "\"یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.98,
   "end": 8.6,
   "text": "آیات\". سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.6,
   "end": 10.3,
   "text": "بعضیا گمان می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.3,
   "end": 17.9,
   "text": "در مجالس آقا اباعبدالله صلوات الله علیه السلام اگر از خود بیخود شدند و لطمه‌ای به خودشون زدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.9,
   "end": 20.1,
   "text": "سری به دیوار کوبیدن و این‌ها؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.1,
   "end": 23.74,
   "text": "که اینا همه هم حق است، اون خونی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.74,
   "end": 29.2,
   "text": "از بدن خارج می‌شه چون در دستگاه امام حسین است پاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.2,
   "end": 34.62,
   "text": "نمی‌دونم این‌ها رو از کجا در میارن و من دیدم این‌ها رو که به شما میگم حتی هیئتی رفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.62,
   "end": 40.02,
   "text": "جمعیت بسیار زیاد از جوون‌ها ما روضه می‌خوندیم این‌ها خودشون رو می‌کشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.02,
   "end": 42.7,
   "text": "بعداً مدیر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.7,
   "end": 47.52,
   "text": "مداح همون هیئت به من گفت حاجی اینا اکثرشون نماز نمی‌خونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.52,
   "end": 51.52,
   "text": "و می‌گن نماز ما را امام حسین تو کربلا خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.52,
   "end": 53.92,
   "text": "بیا برای این‌ها حرف بزن. این‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.92,
   "end": 58.44,
   "text": "نخیر. شرع می‌گه که خون انسان به هر وضعیت که باشه نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.44,
   "end": 61.82,
   "text": "تمام. حالا به هر دلیلی بیرون بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.82,
   "end": 65.5,
   "text": "خون انسان نجسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.5,
   "end": 70.56,
   "text": "نکته‌ای که امروز به فضل الهی عرض می‌کنم به درد بچه هیئتی‌ها خیلی می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.56,
   "end": 77.26,
   "text": "من توصیه می‌کنم که این رو ببرید تو هیئت‌هاتون بالاخره محرم هم داره میاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.26,
   "end": 81.0,
   "text": "و حتی خب داریم دیگه آمادگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.0,
   "end": 84.96,
   "text": "سیاه‌پوشان و این چیزا که داریم یا مسلمیه این‌ها که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.96,
   "end": 89.76,
   "text": "به هر حال نزدیکه الحمد لله خدا توفیق بده نوکری کنیم باز هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.76,
   "end": 92.1,
   "text": "این‌ها به نظرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.1,
   "end": 96.02,
   "text": "مهم‌تر از اون یا به عبارتی بگیم در کنار اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.02,
   "end": 100.6,
   "text": "این نکته‌ای که امروز می‌خوام عرض کنم رو برید روش کار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.6,
   "end": 106.98,
   "text": "چون آقامون اباعبدالله صلوات الله عليه قبل از اینکه بره معرکه کربلا و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.98,
   "end": 114.52,
   "text": "حماسه‌ی با عظمت رو بیافرینه، خلق کنه، قبلش نشسته با مناجات با خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.52,
   "end": 117.22,
   "text": "داره خط و خطوط یا حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.22,
   "end": 118.8,
   "text": "قیامش رو مشخص می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.8,
   "end": 120.88,
   "text": "اساساً بنای قیامش چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.88,
   "end": 126.86,
   "text": "کجا؟ تو دعای عرفه. متأسفانه این چون این نکته‌ای که می‌خوام بگم تو انتهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.86,
   "end": 131.66,
   "text": "اون عبارت دعای عرفه است که مرحوم سید بن طاووس آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.66,
   "end": 135.1,
   "text": "تو اقبالش مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.1,
   "end": 138.8,
   "text": "کف عمین نیاورده این‌ها که شیخ عباس هم از کف امیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.8,
   "end": 142.88,
   "text": "نقل روایت کرده برای همین تو اصل دعا نیاورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.88,
   "end": 147.04,
   "text": "ولی اون انتهاش که اگر دقت کنید بعد از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.04,
   "end": 150.86,
   "text": "نفسی که چاق می‌کنی \"یا رب، یا رب، یا رب\" میگی بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.86,
   "end": 155.86,
   "text": "\"الهی ان الفقر فی غنای كيف لا اکون فقيرا\" از اینجا شروع می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.86,
   "end": 159.12,
   "text": "که یه بخشش رو جلسه پیش گفتیم نیمه کاره موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.12,
   "end": 162.06,
   "text": "تو بخش خدمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.06,
   "end": 166.68,
   "text": "گفتیم که بعد از اینکه به خدا عرض می‌کنیم شب‌های قدر هم توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.68,
   "end": 170.76,
   "text": "\"الهی ترددی في الآثار یوجب وعد المزار\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.76,
   "end": 177.44,
   "text": "بعد عرض می‌کنیم به خدا که \"فجمعنی الیک بخدمة توصلنی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.44,
   "end": 184.3,
   "text": "ایاک یا الیک که به منو مجتمع کن که گفتیم این دیگه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.3,
   "end": 188.3,
   "text": "خدمت هست که ما را به مقام معلوف می‌ره-- قلب معلوف می‌رساند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.3,
   "end": 194.34,
   "text": "اجتماع، تجمع، حرف جمعی توشه که حالا چقدرم خوبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.34,
   "end": 197.58,
   "text": "به ذهن ما القا شد که مثلاً ده شب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.58,
   "end": 200.94,
   "text": "شام میدیم محرم یا اصلاً یه شب، شب عاشورا میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.94,
   "end": 205.42,
   "text": "هرکس میاد کمک می‌کنه حداقل این خادما و خودیا باهاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.42,
   "end": 209.4,
   "text": "قرار بذارین با هماهنگی اونا چون بدون اون شرعاً اشکال داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.4,
   "end": 214.92,
   "text": "بخشی از اون پولی که می‌خواد شام بشه برای مجالس امام حسین انسان به خدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.92,
   "end": 219.18,
   "text": "به یکی از محبین امام حسین که گره به کارش افتاده قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.18,
   "end": 222.84,
   "text": "فجمعنی. اینجا داره امام حسین از خدا می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.84,
   "end": 225.96,
   "text": "\"فجمعنی الیک بخدمة توصلنی الیک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.96,
   "end": 228.82,
   "text": "این ما رو به تو وصل می‌کنه این خدمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.82,
   "end": 232.54,
   "text": "مقصودم از اینجا به بعدشه که جلسه پیش جاموند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.54,
   "end": 239.04,
   "text": "ببینید سطح بحث توحید رو اباعبدالله ارباب ما تا کجا برده بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.04,
   "end": 243.76,
   "text": "بعداً دیگه نشینیم بگیم این عرفا از خودشون یه چیزی ساختن با-- استغفرالله به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.76,
   "end": 246.84,
   "text": "توحید، توحید صمدی خدا و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.84,
   "end": 249.76,
   "text": "\"كيف يستدل عليك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.76,
   "end": 254.12,
   "text": "بما هو في وجوده مفتقر الیک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.12,
   "end": 257.44,
   "text": "آقا و-- خدا عرض می‌کنه خدایا چگونه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.44,
   "end": 260.82,
   "text": "از چیزی بخوام به تو دلیل بیارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.82,
   "end": 267.22,
   "text": "چیزی رو دلیل تو قرار بدم، توجه به آثار وجودی تو بکنم که این‌ها رو قرآن می‌گه آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.22,
   "end": 271.52,
   "text": "ماست دیگه. ها؟ \" و في الارض آيات للموقنين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.52,
   "end": 275.18,
   "text": "زمین آیه توه. \" و في انفسكم افلا تبصرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 275.18,
   "end": 277.62,
   "text": "جان‌ها آیه تواند. درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.62,
   "end": 279.86,
   "text": "این‌ها اثر وجودی تواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.86,
   "end": 287.16,
   "text": "اما من چگونه بیام بر این‌ها \"يستدل عليك بما هو في وجوده مفتقر الیک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.16,
   "end": 293.9,
   "text": "از این‌ها به تو دلالت کنم در حالی که همه این‌ها اصلاً فقیر محض به درگاه تواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.9,
   "end": 295.64,
   "text": "عین ربط به تو هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.64,
   "end": 299.92,
   "text": "اگر-- اصلاً این‌ها وجود استقلالی ندارند، اصلاً نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 299.92,
   "end": 305.3,
   "text": "هرچه هست تویی. عالم اطوار وجودی حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.3,
   "end": 309.0,
   "text": "هر چیزی که وجود گرفته است شعی از شؤون وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.0,
   "end": 312.84,
   "text": "طوری از اطوار وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.84,
   "end": 315.44,
   "text": "ظهور خود وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.44,
   "end": 317.6,
   "text": "حالا این قسمت‌ش هم آقا می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 317.6,
   "end": 319.54,
   "text": "خوب دقت کنید. خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 319.54,
   "end": 323.28,
   "text": "\"ایكون لغيرك من الظهوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.28,
   "end": 328.56,
   "text": "ما ليس لك حق حتى يكونه والمظهر لك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.56,
   "end": 332.84,
   "text": "ما می‌گیم عالم مظاهر خدا، مظهر مثلاً مظهر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.84,
   "end": 335.06,
   "text": "خدا را ظاهر کردن. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.06,
   "end": 337.62,
   "text": "این تو بحث‌های اعتقادی تو علم کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.62,
   "end": 341.78,
   "text": "این‌ها خیلی هست. اما این برای مبتدی‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.78,
   "end": 346.0,
   "text": "به یه بچه بگی نگاه کن به اثر پی به مؤثر ببر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.0,
   "end": 349.3,
   "text": "برای مبتدی‌هاست که آسمان و زمین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.3,
   "end": 354.58,
   "text": "این‌ها رو مظهره یا مظهر خدا بدونی بگی این داره خدا رو ظاهر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.58,
   "end": 356.38,
   "text": "یعنی چی این داره خدا رو ظاهر می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.38,
   "end": 359.3,
   "text": "یعنی خودش یک وجودی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 359.3,
   "end": 361.94,
   "text": "پیش از اینکه خدا رو ظهور بدهد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.94,
   "end": 367.66,
   "text": "خودش یه چیزی بوده است که حالا داره وجود رو ظاهر می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.66,
   "end": 369.36,
   "text": "اصلاً عین و ربط به خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.36,
   "end": 372.3,
   "text": "اگه خدا نباشه که این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 372.3,
   "end": 376.5,
   "text": "اینکه عین فقره اصلاً وجودی از خودش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.5,
   "end": 378.88,
   "text": "هرچه هست شأن خداست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 378.88,
   "end": 382.72,
   "text": "طور خداست. خدا اینطوری بروز کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 382.72,
   "end": 385.78,
   "text": "\"إن الله کل الأشیاء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.78,
   "end": 391.08,
   "text": "حالا اینجا دقت بفرمایید، ابی عبدالله اصلاً این باب رو بسته به روی ما تو بع-- تو دعای عرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.08,
   "end": 393.52,
   "text": "میگه کسی داره میاد کربلا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.52,
   "end": 396.46,
   "text": "کسی با من داره میاد همسفر می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.46,
   "end": 399.16,
   "text": "حدود حسینی رو بشناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.16,
   "end": 402.74,
   "text": "همه عالم نه مظهر خدااند، دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.74,
   "end": 407.42,
   "text": "بلکه خود عالم ظهور خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.42,
   "end": 409.46,
   "text": "این دو تا با هم خیلی فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.46,
   "end": 414.74,
   "text": "بگیم آقا این آسمان، این زمین محل ظهور خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.74,
   "end": 417.84,
   "text": "اثره که از نگاه به او پی به خدا ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.84,
   "end": 422.3,
   "text": "این بحث برای مبتدیاست. امام حسین توی این جمله، یه بار دیگه می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 422.3,
   "end": 427.04,
   "text": "\"أیکون لغیرک من الظهور\" اصلاً به غیر از تو چیزی ظهور کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.04,
   "end": 431.26,
   "text": "\"ما لیس لک حتی یکونه والمظهر لک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.26,
   "end": 435.38,
   "text": "که ما بخوایم اون رو مظهر تو بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.38,
   "end": 442.32,
   "text": "اون یه بحثه. اینجا امام حسین داره میگه اصلاً این آسمان و زمین و همه وجود و موجودات همه ظ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.32,
   "end": 445.5,
   "text": "خود عین‌شون ظهور حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 445.5,
   "end": 449.4,
   "text": "یعنی خدا اینچنین خودش رو ظاهر کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.4,
   "end": 455.66,
   "text": "نه اینکه یک محلی باشد انسان، آسمان، زمین، جمادات، نباتات، حیوانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.66,
   "end": 459.3,
   "text": "برای ظهور خدا. یه چیزی باشد که خدا رو ظاهر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.3,
   "end": 462.48,
   "text": "نه. اصلاً وجودش ظهور حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.48,
   "end": 464.54,
   "text": "این حرف خیلی با هم فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.54,
   "end": 466.4,
   "text": "اصلاً جز حق چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 466.4,
   "end": 471.36,
   "text": "\"هو الذي خلق السماوات والأرض بالحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 471.36,
   "end": 475.32,
   "text": "بالاتر \"سنريهم آياتنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.32,
   "end": 479.86,
   "text": "في الآفاق وفي أنفسهم حتى يتبين لهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 479.86,
   "end": 482.5,
   "text": "أنه الحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 482.5,
   "end": 485.32,
   "text": "اینا همه یکپارچه حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.32,
   "end": 487.78,
   "text": "باز میره بالاتر از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.78,
   "end": 490.62,
   "text": "الله اکبر از آقا. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 490.62,
   "end": 495.62,
   "text": "می‌تونید با این، با این جملات امام حسین تنتون بلرزه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.62,
   "end": 500.54,
   "text": "\"متاقب حتى تحتاج إلى دليل يدل عليك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 500.54,
   "end": 504.8,
   "text": "اصلاً تو کی غائب بودی که من بخوام برای تو دلیل بیارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.8,
   "end": 506.76,
   "text": "تو کی غائب از نظر بودی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 506.76,
   "end": 508.92,
   "text": "غائب چیه؟ غیب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 508.92,
   "end": 514.78,
   "text": "حالا اگر بگه پس این عالم الغیب و شهاده که قرآن میگه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.78,
   "end": 517.18,
   "text": "این مربوط به قابلیته نه قابلیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 517.18,
   "end": 520.64,
   "text": "مربوط به ماست. برای ما یه سری چیزا غائبه از من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.64,
   "end": 525.84,
   "text": "مثل اینکه ما بگیم آقا پشت اون دیوار برای من غیبه، اینجا الان شهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 525.84,
   "end": 528.8,
   "text": "درست شد؟ برای خدا که چیزی غیب نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 528.8,
   "end": 532.04,
   "text": "و تازه برای ما هم این نیست که بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.04,
   "end": 534.26,
   "text": "غیب به این معنا که ما نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 534.26,
   "end": 537.18,
   "text": "اینم اشتباه است. نه، هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.18,
   "end": 540.14,
   "text": "ما اونطور که باید ببینیم نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.14,
   "end": 544.0,
   "text": "مثل اینکه بگیم مثلاً خورشید از نظر ما غائبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 544.0,
   "end": 547.62,
   "text": "اونطور که باید خورشید رو ببینیم نمی‌تونیم ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.62,
   "end": 551.9,
   "text": "نور شدید خورشید شده حجاب خورشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 551.9,
   "end": 555.44,
   "text": "نه اینکه یه پرده‌ای بیاد جلوی من و شما نتونیم اصلاً خورشید رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.44,
   "end": 559.5,
   "text": "چرا داریم می‌بینیم. اما اونطور که هست نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 559.5,
   "end": 564.0,
   "text": "چون شدت نور خورشید کور می‌کنه اصلاً تو بخوای ببینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 564.0,
   "end": 568.94,
   "text": "دقت کنید این فرق می‌کنه ها بگیم حجاب یعنی یه چیزی اومده پرده شده تو اونو نبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 568.94,
   "end": 573.78,
   "text": "نه، می‌بینی. بلکه شدت نور خورشید خودش شده حجاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 573.78,
   "end": 576.26,
   "text": "یعنی تو نه-- اگر ببینی کور می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.26,
   "end": 578.56,
   "text": "عین اون حقیقت رو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 578.56,
   "end": 580.92,
   "text": "ولی جلوه‌شو می‌بینی، نورش رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.92,
   "end": 585.52,
   "text": "حالا ببینید بریم جلوتر. جگر دارید بریم جلوتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.52,
   "end": 588.38,
   "text": "\"ومن بعد حتى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.38,
   "end": 592.62,
   "text": "تكون الآثار هي التي توصل إليک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 592.62,
   "end": 595.46,
   "text": "تو کی \"من بعد\" تو کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 595.46,
   "end": 598.96,
   "text": "دور شدی؟ تو کی بعد داشتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 598.96,
   "end": 601.96,
   "text": "یا اصلاً به عبارتی بگیم ما کی از تو دوریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 601.96,
   "end": 605.26,
   "text": "ما در حضور و ظهور مطلقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 605.26,
   "end": 607.54,
   "text": "ما در عین حضور و ظهوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 607.54,
   "end": 613.32,
   "text": "تو مراقب مایی. که حالا جملات بعدی حضرت می‌فرماید بحث مراقبت رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 613.32,
   "end": 619.6,
   "text": "که اصلاً تو کی دور بودی که \"حتى تكون الآثار هي التي توصل إليك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 619.6,
   "end": 622.12,
   "text": "که من بخوام به آثار به تو وصل بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 622.12,
   "end": 624.54,
   "text": "نگاه به اثر کنم که به تو برسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.54,
   "end": 629.68,
   "text": "تو کی از من دور بودی؟ اینجا اون بحث دویت و وحدت پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 629.68,
   "end": 631.94,
   "text": "اینایی که میان میگن آقا عرفا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 631.94,
   "end": 637.82,
   "text": "حکما از خودشون یه چیزی به نام توحید وجودی یا توحید صمدی قرآن پیدا کردن، اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 637.82,
   "end": 640.44,
   "text": "همش تو آثار ابا عبدالله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 640.44,
   "end": 644.36,
   "text": "تازه یه رمزگشایی از یکی از عبارات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 644.36,
   "end": 648.6,
   "text": "یکی از دعای امام حسین با خداست که برای ما فاش شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 648.6,
   "end": 653.5,
   "text": "شما بفرمایید اگر دو چیز باشن، دقت کنید دو چیز رو در نظر بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 653.5,
   "end": 657.18,
   "text": "به این چیز دوم می‌گیم آقا تو به این چیز اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 657.18,
   "end": 659.44,
   "text": "به شیء اول دوری یا نزدیکی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 659.44,
   "end": 662.08,
   "text": "این درسته. درسته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 662.08,
   "end": 665.5,
   "text": "به شیء دوم میگی از این شیء اول دوری یا نزدیکی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 665.5,
   "end": 668.66,
   "text": "این درسته. عقلیه. اما اگر یک بود چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 668.66,
   "end": 670.86,
   "text": "یک وجود بود، یک شیء بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 670.86,
   "end": 676.0,
   "text": "آیا دیگه یک شیء، یک وجود دیگه بعد و قرب داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 676.0,
   "end": 678.28,
   "text": "غیبت و شهود داره؟ یکیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 678.28,
   "end": 684.12,
   "text": "تموم شد رفت. مگه نمیگه \"قل هو الله احد\" تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 684.12,
   "end": 687.58,
   "text": "کدوم احد؟ الله الصمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 687.58,
   "end": 694.04,
   "text": "پرپر. هیچ گز-- هیچ چیزی ازش خالی نیست و هر چیزی که هست ظهور همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 694.04,
   "end": 696.68,
   "text": "تمام. پس چیزی دیگه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 696.68,
   "end": 704.44,
   "text": "ببینید اگر عرفا و حکما حرفی می‌زنن، اگر حضرت علامه حسن زاده حرفی می‌زنه و در رساله لقاء الله‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 704.44,
   "end": 710.06,
   "text": "این عبارات رو میاره توز-- توصیه می‌کنه به من و شما سر این سفره بشینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 710.06,
   "end": 715.96,
   "text": "اینا رو در رساله لقاء الله حضرت علامه حسن زاده به شدت ترغیب می‌کنه ما رو که سر این سفره بشینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 715.96,
   "end": 721.74,
   "text": "به خاطر اینه. کی داره میگه؟ اون که از همه به قول شما عشقش حسی‌تر بوده امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 721.74,
   "end": 724.44,
   "text": "بهتر از هر اهل بیتی در دسترس ما بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 724.44,
   "end": 727.58,
   "text": "حالا برو جلو ببین چه خبره، چه غوغایی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 727.58,
   "end": 730.02,
   "text": "دیگه فرصت نیست من بیشتر از این برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 730.02,
   "end": 732.06,
   "text": "اهان حالا برید ببینید بقیشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 732.06,
   "end": 737.84,
   "text": "که آقا جان می‌کشه به جایی که چند تا جمله جلوتر می‌فرماید \"بک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 737.84,
   "end": 740.38,
   "text": "استدل عليك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 740.38,
   "end": 747.22,
   "text": "من به تو بر خودت دلالت می‌کنم نه با آثار تو، نه با آیات تو، به خودت \"بک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 747.22,
   "end": 749.8,
   "text": "استدل عليك\". الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 749.8,
   "end": 752.66,
   "text": "ببینید تا کجا برده توحید رو بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 752.66,
   "end": 757.32,
   "text": "اگه به موسی میگه از عصات رو بزن دوازده تا چشمه‌ جاری شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 757.32,
   "end": 759.98,
   "text": "عصات رو بزن. نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 759.98,
   "end": 763.06,
   "text": "این نهر رود نیل شکافته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 763.06,
   "end": 769.28,
   "text": "اگر از اون درخت از شاخه درخت صدا بلند می‌شه \"اني ان الله\" اینا سرش در چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 769.28,
   "end": 772.06,
   "text": "مگه عصای موسی یه چوب نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 772.06,
   "end": 776.18,
   "text": "مگه شاخه درخت یه چ-- شاخه درخت نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 776.18,
   "end": 778.96,
   "text": "چگونه می‌شه که این‌ها یه کارهای این چنینی می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 778.96,
   "end": 784.12,
   "text": "عصا می‌افته، عصا چوبه می‌افته زمین به قولی می‌شه ماره بزرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 784.12,
   "end": 787.98,
   "text": "یعنی اصلاً همه این‌ها ظهور خودم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 787.98,
   "end": 793.72,
   "text": "ظهور خودم. تموم شد. لذا لا حول و لا قوه الا بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 793.72,
   "end": 797.8,
   "text": "العلی العظیم. کسی اینو فهمید کار تموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 797.8,
   "end": 799.82,
   "text": "اینو کسی متوجه شد دیگه کار--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 799.82,
   "end": 803.32,
   "text": "اصلاً امام حسین رفت کربلا جمله آخرما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 803.32,
   "end": 812.0,
   "text": "تو گوشمون حک بشه. امام حسین رفت کربلا که ما رو به همین سطح تراز توحید برسونه که لا حول و لا قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 812.0,
   "end": 814.48,
   "text": "الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 814.48,
   "end": 817.36,
   "text": "لذا خواهرش حضرت زینب هرچی دید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 817.36,
   "end": 821.2,
   "text": "هرچی خواستن حرصشو درآرن فرمود \"ما رأيت الا جميلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 821.2,
   "end": 823.84,
   "text": "همش جماله. همش زیباییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 823.84,
   "end": 825.7,
   "text": "من جز زیبایی چیزی ندیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 825.7,
   "end": 829.58,
   "text": "چون رسیده به لا حول و لا قوه الا بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 829.58,
   "end": 832.14,
   "text": "العلی العظیم دل زینب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 832.14,
   "end": 836.68,
   "text": "حالا من بخوام نوکر امام حسین باشم، نوکر همچین افکاری باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 836.68,
   "end": 839.72,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 839.72,
   "end": 843.88,
   "text": "صلوات بر ابا آقا-- ابا عبدالله و یاران شهیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 843.88,
   "end": 848.12,
   "text": "الله- الله محمد علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}