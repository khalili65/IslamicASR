   "start": 24.0,
   "end": 131.9
  },
  {
   "index": 1,
   "title": "## لحظهٔ احتضار؛ حضور موت",
   "start": 131.9,
   "end": 164.8
  },
  {
   "index": 2,
   "title": "## موتوا قبل أن تموتوا؛ احلی من العسل",
   "start": 164.8,
   "end": 185.44
  },
  {
   "index": 3,
   "title": "و در دخان:",
   "start": 185.44,
   "end": 205.58
  },
  {
   "index": 4,
   "title": "## قابض و ارتقای وجودی",
   "start": 205.58,
   "end": 270.72
  },
  {
   "index": 5,
   "title": "## قلب مألوف غایت قبض",
   "start": 270.72,
   "end": 352.56
  },
  {
   "index": 6,
   "title": "## مراقبت حضور روزانه",
   "start": 352.56,
   "end": 599.48
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.62,
   "end": 8.48,
   "text": "و به 你 نستعین. السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.48,
   "end": 12.58,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.58,
   "end": 14.4,
   "text": "ما بحثمون قلب مألوف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.4,
   "end": 22.68,
   "text": "امروز یک نکته بسیار به دردبخوری رو عرض می‌کنیم در این خصوص که همه ما هم قراره اون لحظه رو درک کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.68,
   "end": 29.42,
   "text": "می‌دونید عرض کردیم که برای رسیدن به حقیقت قلب مألوف که مقام جمعی دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.42,
   "end": 32.5,
   "text": "باید توجه به حضور و مراقبت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.5,
   "end": 35.32,
   "text": "یعنی حضور، حضور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.32,
   "end": 39.64,
   "text": "درک حضور که آ-- حضرت امام علیه الرحمه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.64,
   "end": 41.22,
   "text": "عالم محضر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.22,
   "end": 44.14,
   "text": "در محضر خدا معصیت نکنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.14,
   "end": 49.74,
   "text": "که دیگه انزل صحبت‌هایی که در این حیث میشه کرد همین حرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.74,
   "end": 51.62,
   "text": "چون فرمودن معصیت نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.62,
   "end": 55.58,
   "text": "البته باید دید معنای معصیت چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.58,
   "end": 62.0,
   "text": "یعنی دیگه سطح پایین‌ترین حرفیه که امام از یک حرف ارشی به نام توحید صمدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.0,
   "end": 65.26,
   "text": "به ابتکار از تلمذ حسن زاده بیان می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.26,
   "end": 71.8,
   "text": "وجود صمدی که همه عوالم هستی که یکی از اجزاش و اعضا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.8,
   "end": 74.3,
   "text": "اعضاش من و شما هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.3,
   "end": 78.44,
   "text": "شأنی از شؤون حضرت حق هستند که الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.44,
   "end": 82.0,
   "text": "کل الاشیاء. الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.0,
   "end": 89.24,
   "text": "کل الاشیاء. در حقیقت می‌خوام عرض کنم که درک این حقیقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.24,
   "end": 93.0,
   "text": "به قول بزرگان خداست و خدایی دارد می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.0,
   "end": 100.5,
   "text": "لذا هرکه در مسیر معرفتی به هر مقامی هم می‌رسد دست تصرف به نظام هستی باز نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.5,
   "end": 104.56,
   "text": "هر چقدر هم که بتواند دست تصرف باز نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.56,
   "end": 110.0,
   "text": "ابا عبدالله می‌تونست یه نگاه کنه همه سنگ شن اما دست تصرف باز نکرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.0,
   "end": 112.96,
   "text": "و سپرد به خدا. خداست خدایی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.96,
   "end": 115.8,
   "text": "چرا؟ چون محل حضور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.8,
   "end": 118.06,
   "text": "هر چقدر که این حضور رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.06,
   "end": 121.22,
   "text": "حضور توحید صمدی حضرت حق رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.22,
   "end": 127.62,
   "text": "حضور وجود مطلقه حضرت حق رو درک کنی به حقیقت قلب مألوف رسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.62,
   "end": 131.9,
   "text": "اون نکته‌ای که می‌خواستم بگم نیاز به این مقدمه‌چینی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.9,
   "end": 134.96,
   "text": "یکی از جاهایی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.96,
   "end": 141.1,
   "text": "به شدت این حضور رو درک می‌کنیم و سعی حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.1,
   "end": 144.1,
   "text": "حق بر این است که ما رو به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.1,
   "end": 147.02,
   "text": "قلب مألوف برساند لحظه مرگ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.02,
   "end": 149.46,
   "text": "یکی از دلایلی که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.46,
   "end": 153.08,
   "text": "بهش هم میگن، اون لحظه رو میگن لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.08,
   "end": 158.28,
   "text": "احتضار از آیه صد و هشتاد سوره بقره هم گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.28,
   "end": 161.9,
   "text": "دقت بفرمایید \"اذا حور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.9,
   "end": 166.18,
   "text": "احدکم الموت\" هنگامی که مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.18,
   "end": 171.32,
   "text": "حاضر می‌شه برای تک تک شما وقت موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.32,
   "end": 173.5,
   "text": "این مرگی که حاضر می‌شه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.5,
   "end": 176.48,
   "text": "که مرحوم مجلسی علیه الرحمه در بحار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.48,
   "end": 179.6,
   "text": "حدیثی را آوردن که تلک الامثال دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.6,
   "end": 181.6,
   "text": "تلک الامثال نضر بحال الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.6,
   "end": 185.44,
   "text": "مثلش برای اینکه من و شما بفهمیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.44,
   "end": 189.78,
   "text": "پیامبر فرمودن فرشته مرگ حاضر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.78,
   "end": 191.98,
   "text": "جالبه که در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.98,
   "end": 197.3,
   "text": "دو سوره ملک می‌فرماید \"الذي خلق الموت والحياة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.3,
   "end": 204.78,
   "text": "البته \"لیبلok ایکم احسن عملا\" برای اینکه بدونه کدومتون احسن عمل رو دارید اساساً خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.78,
   "end": 206.74,
   "text": "چی رو؟ موت و حیات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.74,
   "end": 209.38,
   "text": "یعنی موت خود مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.38,
   "end": 211.04,
   "text": "خلقه، خودش خلقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.04,
   "end": 215.32,
   "text": "پس وجود دارد. مرگ یک وجودی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.32,
   "end": 219.5,
   "text": "که لحظه احتضار و رفتن ما از این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.5,
   "end": 228.08,
   "text": "حاضر می‌شود. حالا اینجا مرحوم طبرسی علیه الرحمه در مجمع البيانش این حضور مرگ رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.08,
   "end": 232.56,
   "text": "گرفته به حضور قابض الارواح یا جبرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.56,
   "end": 237.32,
   "text": "حالا این یک معناست البته. معانی دیگه‌ای هم شده من نمی‌خوام وقتتون رو بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.32,
   "end": 240.16,
   "text": "فرصت کمه. حالا قابض الارواح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.16,
   "end": 242.2,
   "text": "قابض الارواح اسمش رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.2,
   "end": 245.72,
   "text": "مجری اسم قابض حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.72,
   "end": 249.12,
   "text": "قبض کننده‌ست دیگه. قبض می‌کنه چی رو به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.12,
   "end": 256.06,
   "text": "قبلاً بحثش گذشته. قبضی که صورت می‌گیره از رتبه مادون به رتبه مافوق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.06,
   "end": 265.08,
   "text": "لذا بزرگان اهل معرفت در حکمت و عرفان فرمودن ما دائماً از هر رتبه مادونی به یه رتبه مافوق بخوایم بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.08,
   "end": 268.54,
   "text": "مثل لحظه‌ای که از رتبه مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.54,
   "end": 274.9,
   "text": "عالم رحم مادر می‌خوایم بریم به رتبه مافوق عالم طبیعت، لحظه تولدمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.9,
   "end": 279.38,
   "text": "همه اینجور موارد حضرت قابض الارواحه که طرف حساب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.38,
   "end": 281.9,
   "text": "یعنی عزرائیل رو اصطلاحاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.9,
   "end": 284.76,
   "text": "که متأسفانه همه فحش و لعنش می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.76,
   "end": 289.72,
   "text": "اون دائماً داره به ما ارتقای وجودی می‌ده و اولین وقتی هم که ما ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.72,
   "end": 294.7,
   "text": "در این نشئه طبیعت زیارتش کردیم اون وقتی بود که از رحم مادر ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 294.7,
   "end": 299.0,
   "text": "قبض کرد از اون رتبه مادون آورد به یه رتبه بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 299.0,
   "end": 300.98,
   "text": "هر کجا که ما رتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.98,
   "end": 308.88,
   "text": "حقیقی و وجودیمون می‌خواد صعده وجودی پیدا کنه، ما نیاز داریم به همچین مجری‌ای که کارگزار خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 308.88,
   "end": 313.36,
   "text": "لذا قرآن میگه با اینا در بیفتی دشمنی کنی دشمن منی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.36,
   "end": 316.72,
   "text": "اینا کارگزاران خدا به یک معنا شؤونی از حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 316.72,
   "end": 321.58,
   "text": "به یک معنای دقیق‌تر حتی این‌ها شؤون وجودی خود تو هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.58,
   "end": 325.38,
   "text": "ملائکه عقل‌اند. مل-- در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.38,
   "end": 327.72,
   "text": "عرفان بهش میگه ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.72,
   "end": 329.7,
   "text": "قرآن بهش میگه ملک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.7,
   "end": 334.88,
   "text": "فرشته. حکمت یا فلسفه بهش میگه عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.88,
   "end": 336.82,
   "text": "خب عقل ما داریم یا نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 336.82,
   "end": 338.78,
   "text": "هممون داریم. از این جهت انسانیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.78,
   "end": 343.78,
   "text": "پس ملک داریم. بلکه ملائکه الله داریم نسبت به درجات عقلیمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.78,
   "end": 347.38,
   "text": "حالا این‌ها شأنی از شؤون وجودی خود ما هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.38,
   "end": 349.54,
   "text": "کمک حال مااند که به ارتقا برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.54,
   "end": 355.0,
   "text": "این مرگ برای چیه؟ برای اینکه ما به حضور برسیم، ارتقای وجودی پیدا کنیم، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.0,
   "end": 358.48,
   "text": "حضوری که در دنیا درک نکردیم حالا اونجا درک کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 358.48,
   "end": 361.04,
   "text": "جالبه که به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.04,
   "end": 365.36,
   "text": "این شدید القوی که میگن اونجا به شدت تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.36,
   "end": 369.04,
   "text": "عوالم هستی دست به دست هم میدن حتی تکوین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.04,
   "end": 372.74,
   "text": "تکوین چیه؟ بدن تو، جسم تو مرتبط به تکوینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.74,
   "end": 379.62,
   "text": "می‌خواد اینو بکنه جانت رو، نفست رو، روحت رو از این تکوین از این جسم که باید برگرده به شرخ طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.62,
   "end": 383.5,
   "text": "بکنه. همه دست به دست هم میدن که این تعلق رو بکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.5,
   "end": 385.38,
   "text": "که تو مقام حضور رو درک کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.38,
   "end": 387.0,
   "text": "یعنی به قلب مألوف برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.0,
   "end": 394.02,
   "text": "خب عزیزم اگر تو که اینطوری قراره یه همچین شدتی بهت بیاد، همین جا موتو قبل ان تموتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.02,
   "end": 399.44,
   "text": "همین جا به قلب مألوف برس که اون موقع مرگ برات بشه شیرین‌تر از عسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.44,
   "end": 404.62,
   "text": "احلی من العسل. تا این اتفاق نیفته در دوره زندگیمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.62,
   "end": 411.94,
   "text": "اون مرگ همچنان برای ما یک خطر بزرگ و یک ترس و یک چیز جانکاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 411.94,
   "end": 417.12,
   "text": "جالبه که بر اساس آیه یازده سوره قاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.12,
   "end": 419.12,
   "text": "حالا اینا برید ببینید من چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 419.12,
   "end": 423.92,
   "text": "خودم اگه مثلاً وقتی میشنوم یه استاد بزرگی مثلاً علامه مخصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.92,
   "end": 428.34,
   "text": "اشاره میدن به یه آیه، سریع میرم آیه رو نگاه می‌کنم، زیر و روش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.34,
   "end": 432.86,
   "text": "انقدر برام شیرینه. آیه یازده سوره قاف رو برید خلوتتون ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 432.86,
   "end": 435.74,
   "text": "قالوا. این آیه مربوطه به کسایی که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 435.74,
   "end": 438.02,
   "text": "مثلاً دچار عذاب شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 438.02,
   "end": 442.18,
   "text": "قالوا ربنا اینا میگن خدای ما، پروردگار ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.18,
   "end": 445.4,
   "text": "ربنا امتنا فنتین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.4,
   "end": 448.36,
   "text": "عجب! تو دو بار ما رو کشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.36,
   "end": 452.98,
   "text": "عجب! و احییتنا فنتین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.98,
   "end": 455.5,
   "text": "دو بار ما رو زنده کردی. چرا دو بار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 455.5,
   "end": 457.6,
   "text": "چرا دو بار ما، ما رو کشتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.6,
   "end": 459.9,
   "text": "مگه یه بار ما قرار نیست بمیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.9,
   "end": 464.06,
   "text": "ها؟ فاعترفنا بذنوبنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 464.06,
   "end": 466.12,
   "text": "فهل الی خروج من سبيل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.12,
   "end": 470.2,
   "text": "آیا راهی هست که بریم، یه راهی هست از این عذاب خارج شیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.2,
   "end": 473.06,
   "text": "اینو بذارید کنار این آیه پنجاه و شش دخان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 473.06,
   "end": 475.6,
   "text": "برید ببینید پنجاه و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.6,
   "end": 478.92,
   "text": "دخان. آیا همه دو بار میمیرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.92,
   "end": 481.54,
   "text": "بر اساس این آیه پنجاه و شش دخان نخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.54,
   "end": 485.3,
   "text": "میفرماید لا یذوقون فیها الموت الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 485.3,
   "end": 488.06,
   "text": "الموتة الاولى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.06,
   "end": 491.28,
   "text": "موتة الا الموتة الاولى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.28,
   "end": 494.4,
   "text": "یه مرگ رو فقط می‌چشن. کیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 494.4,
   "end": 497.92,
   "text": "و وقاهم عذاب الجحیم. اونایی که از عذاب در امنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 497.92,
   "end": 500.52,
   "text": "که بزرگان این رو آوردن زیرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 500.52,
   "end": 504.46,
   "text": "اه الصاقش کردن به شهدا و اول--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.46,
   "end": 506.88,
   "text": "اولیای خدا و انبیا و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 506.88,
   "end": 510.36,
   "text": "اون چهار دسته صلحا، انبیا، شهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.36,
   "end": 512.7,
   "text": "و در حقیقت صلحا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 512.7,
   "end": 515.22,
   "text": "انبیا، شهدا و اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.22,
   "end": 519.32,
   "text": "اولیا خدا. این‌ها یک بار مرگ رو می‌چشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 519.32,
   "end": 520.98,
   "text": "یک بار مرگ رو می‌چشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.98,
   "end": 526.18,
   "text": "به چه جهت؟ همون لحظه مرگ می‌خوان به حضور تام برسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.18,
   "end": 528.18,
   "text": "به قلب مألوف رسیدن تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 528.18,
   "end": 532.48,
   "text": "دیگه برای چی دوباره بمیرن؟ اما کسایی که ناقص‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 532.48,
   "end": 537.24,
   "text": "سقط شدن که قبلاً تو بحث سقط جنین، جنین عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.24,
   "end": 542.64,
   "text": "اینا دیگه برزخشون نسبت به میزانی که دقت بفرمایید بحث تموم شد؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 542.64,
   "end": 549.44,
   "text": "نسبت به میزانی که اینا نقص دارن طول میکشه تا برسن به اون حقیقت قلب مألوف یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 549.44,
   "end": 552.88,
   "text": "به اون مقام جمعی یا به حضور تام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 552.88,
   "end": 555.88,
   "text": "اگر در برزخ نکش-- نشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.88,
   "end": 558.3,
   "text": "نشد انقدر این نقص داره نشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 558.3,
   "end": 561.88,
   "text": "که به این رفع از نقص به کمال بهش میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 561.88,
   "end": 565.96,
   "text": "همون عذاب برزخی. نشد، میکشه به قیامت به پنجاه موقف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 565.96,
   "end": 568.68,
   "text": "هی موقف به موقف اینا قراره چی بشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 568.68,
   "end": 572.8,
   "text": "از نقص خارج شن، برن به حضور تام برسن بابا به خدا برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.8,
   "end": 575.94,
   "text": "بفهمن که خدا چیه و انا الیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 575.94,
   "end": 580.82,
   "text": "راجعون. پس یکی از جاهایی که ما قراره درک کنیم مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 580.82,
   "end": 583.32,
   "text": "الفت قلب و قلب مألوف رو اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 583.32,
   "end": 586.68,
   "text": "خب زودتر بجنبیم. به خودم عرض می‌کنم حدیث نفس می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 586.68,
   "end": 588.46,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.46,
   "end": 591.66,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 591.66,
   "end": 599.48,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}