 },
 "chapters": [
  {
   "index": 0,
   "title": "## افطار پیش از اذان از سر اضطرار؛ فقط قضا",
   "start": 10.78,
   "end": 86.38
  },
  {
   "index": 1,
   "title": "## روزه حقیقتی مخفی؛ خلوص محض و الصوم لی",
   "start": 86.38,
   "end": 192.74
  },
  {
   "index": 2,
   "title": "چنان‌که در مجالس امام حسین علیه‌السلام سه دسته فیض می‌برند:",
   "start": 192.74,
   "end": 269.94
  },
  {
   "index": 3,
   "title": "## افطار؛ شکفتن انوار از درون",
   "start": 269.94,
   "end": 413.62
  },
  {
   "index": 4,
   "title": "## دو صید روزه‌دار؛ افطار و بین‌الطلوعین",
   "start": 413.62,
   "end": 512.68
  },
  {
   "index": 5,
   "title": "## خلوص محض؛ نمونهٔ شهید حججی",
   "start": 512.68,
   "end": 580.0
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.32,
   "end": 2.78,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.78,
   "end": 6.48,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.48,
   "end": 10.78,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.78,
   "end": 17.82,
   "text": "از رهبر عزیزمون استفتاء شده که اگر کسی م-- به هر دلیلی حالا سحری نتونست بخوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.82,
   "end": 23.98,
   "text": "خب بهش فشار اومد و دم غروب مخصوصا این روزا هم که خب حدود هفده هجده ساعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.98,
   "end": 26.28,
   "text": "سخته برای بعضیا توانشو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.28,
   "end": 28.94,
   "text": "انقدر دیگه حالش بد شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.94,
   "end": 31.34,
   "text": "دیگه نمیتونه ادامه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.34,
   "end": 35.7,
   "text": "افطار کرد قبل از اینکه اذان رو بده افطار کرد حالش بد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.7,
   "end": 39.52,
   "text": "آیا چنین کسی حکمش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.52,
   "end": 45.34,
   "text": "فقط روزه قضا باید بعدا بگیره یا کفاره هم میاد یا کفاره جمع اصلاً میاد چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.34,
   "end": 51.2,
   "text": "عمداً افطار کرده. رهبر عزیز فرمودن که اگر به هرج بیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.2,
   "end": 55.0,
   "text": "یعنی دیگه خیلی سخت بشه براش و چاره‌ای نداشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.0,
   "end": 57.86,
   "text": "یعنی داره دیگه تلف میشه به قولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.86,
   "end": 60.66,
   "text": "یعنی خیلی دیگه حالش بد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.66,
   "end": 64.5,
   "text": "نمیتونه. حالا یه وقت هست آدم بالاخره طبیعت روزه بیحالی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.5,
   "end": 66.9,
   "text": "داره میگه آقا بیحال شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.9,
   "end": 69.68,
   "text": "خب نوش جونت بیحالی. خودشه اینم عشق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.68,
   "end": 72.28,
   "text": "اما نه واقعا حالش بد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.28,
   "end": 76.36,
   "text": "میگه اگر اینچنین بود فقط قضا گردنشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.36,
   "end": 84.3,
   "text": "کفاره جمع که هیچی حتی یه دونه، یه مدتی تمام برای یه روز کفاره عذر هم حتی نمیخواد بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.3,
   "end": 90.8,
   "text": "در خصوص اسرار روزه خدا رحمت کنه مرحوم حاجیه سبزواری علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.8,
   "end": 96.46,
   "text": "یکی دیگه از اسرار روزه رو اینچنین بیان میکنه که همه فهم هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.46,
   "end": 99.44,
   "text": "می فرماید روزه یک حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.44,
   "end": 102.22,
   "text": "غیر جهریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.22,
   "end": 103.98,
   "text": "و غیر ظاهریه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.98,
   "end": 107.24,
   "text": "در حقیقت مخفیه است روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.24,
   "end": 112.58,
   "text": "یکی از دلایل اینکه خدای منان روزه رو اضافه تشریفی داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.58,
   "end": 117.34,
   "text": "شرافت داده و او رو به خودش منتسب کرده از صوملی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.34,
   "end": 122.58,
   "text": "روزه مال منه. دیگه هیچ عبادت دیگه ای رو خدا نگفته مال من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.58,
   "end": 127.46,
   "text": "فرمودن یکی از اسرارش البته اینه که روزه کاملاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.46,
   "end": 133.28,
   "text": "خلوص محضه. هر کجا که خلوص عیارش میره بالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.28,
   "end": 136.48,
   "text": "اونجا رد پای خدا رو میتونی ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.48,
   "end": 139.48,
   "text": "رد پای خدا و اولیاش رو میتونی ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.48,
   "end": 142.68,
   "text": "هر کجا سر سوزنی غیرت بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.68,
   "end": 148.4,
   "text": "ظهور و بروز بیاد ریا و منیت و این‌ها سی шаی در درگاه خدا اونجا ارزش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.4,
   "end": 150.36,
   "text": "خدا غیوره. غیرت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.36,
   "end": 153.4,
   "text": "نمیتونه دل آدم رو چند جا ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.4,
   "end": 157.1,
   "text": "ببینید تمام عباديات به نوعی ظهور دارن، بروز دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.1,
   "end": 160.42,
   "text": "نماز خم و راست میشی بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.42,
   "end": 165.62,
   "text": "همه میفهمن. وضو میخوای بگیری، حج میخوای بری، زکات بری خمس بدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.62,
   "end": 168.02,
   "text": "ذکر میخوای بگی بالاخره لبت میجنبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.02,
   "end": 169.76,
   "text": "تسبیح دستت. نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.76,
   "end": 172.64,
   "text": "قرآن میخوای-- هر کاری میخوای بکنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.64,
   "end": 176.62,
   "text": "یه ظهوری داره. اما این روزه کاملاً مخفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.62,
   "end": 180.02,
   "text": "کف نفسه دیگه. اعم از خود کف نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 180.02,
   "end": 183.16,
   "text": "و خود نیت روزه. همش پنهانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.16,
   "end": 189.7,
   "text": "جالبه. اینم خودش از نکات ظریفه که میگه حتی اونایی هم که روزه ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.7,
   "end": 192.12,
   "text": "حق ندارن بخورن علنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 192.12,
   "end": 194.0,
   "text": "خودشون رو شبیه روزه دارا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.0,
   "end": 197.64,
   "text": "چطور میگه تو مجالس امام حسین سه دسته فیض میبرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.64,
   "end": 200.1,
   "text": "من بكی و أبکی و طباک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 200.1,
   "end": 203.12,
   "text": "فی مصیبت الحسین وجبت له الجنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 203.12,
   "end": 208.26,
   "text": "جالبه میگه حتی اون کسی که نمیتونه بگریونه نمیتونه گریه کنه خودشو شبیه گریه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 208.26,
   "end": 211.14,
   "text": "میگه خودشو شبیه روزه دارا قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 211.14,
   "end": 213.58,
   "text": "اینم یه به نوعی تشبه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.58,
   "end": 217.38,
   "text": "در حقیقت خدا میخواد روزه دار رو کاملاً مخفی نگه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 217.38,
   "end": 223.28,
   "text": "اهدی جز خدا نفهمه. حالا الان ماه رمضونه که همه همدیگه رو به چشم صائم میبینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.28,
   "end": 226.94,
   "text": "به غیر ماه مبارک رمضان یه کسی روزه بگیره کی میفهمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 226.94,
   "end": 229.02,
   "text": "آقا بفرمایید غذا بخور. حالا میل ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 229.02,
   "end": 233.34,
   "text": "حالا بعدا میخورم. کاملاً خلوص محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 233.34,
   "end": 238.54,
   "text": "لذا بعد شما کدوم عبادتو گیر میارید در کنار این خلوص و پنهان بودنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 238.54,
   "end": 242.22,
   "text": "هفده ساعت، هجده ساعت، شونزده ساعت عبادت طول بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 242.22,
   "end": 247.0,
   "text": "مگه نماز چقدر طول میکشه؟ نماز امام حسین که از همه طولانی تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 247.0,
   "end": 250.02,
   "text": "جالبه نماز جعفر طیار رحمة الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 250.02,
   "end": 252.22,
   "text": "باب شده مثلا به نماز طولانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 252.22,
   "end": 255.22,
   "text": "نماز امام حسین سه ساعت طول میکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 255.22,
   "end": 259.76,
   "text": "سه ساعت. خب سه ساعت فوقش سه ساعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 259.76,
   "end": 262.9,
   "text": "ما چق-چقدر مگه توان داری دولا راست شی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 262.9,
   "end": 265.78,
   "text": "اما روزه هجده ساعت در حال عبادتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 265.78,
   "end": 267.98,
   "text": "کدوم م-- شما کدوم عبادت پیدا میکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 267.98,
   "end": 277.38,
   "text": "این همه. بعد از اسرار دیگه‌ش اینه که وقت افطار عرب میگه انفترت الانوار و من الشجر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.38,
   "end": 281.88,
   "text": "فتر-- این افطار فتر از شکفتن میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.88,
   "end": 286.58,
   "text": "اینجا که میگه انفترت الانوار، انوار اگر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 286.58,
   "end": 289.24,
   "text": "نور بگیریم که اینجا معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 289.24,
   "end": 291.52,
   "text": "اینجا معنا-- اینجا از نور میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 291.52,
   "end": 296.78,
   "text": "نور یعنی شکوفه. میگه ش-- درخت از شکوفه‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 296.78,
   "end": 299.48,
   "text": "ش-- اون شکوفه‌هایی که تو درخته شو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.48,
   "end": 303.3,
   "text": "خودش در درون خودش شکوفا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 303.3,
   "end": 307.42,
   "text": ". شکوفه‌ای که در درخته در درون خود درخت شکوفا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 307.42,
   "end": 312.78,
   "text": "وقت افطار که ما میگیم افطار می‌کنیم یعنی ما شکوفا میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 312.78,
   "end": 317.22,
   "text": "در حقیقت در درون خودمون یه اتفاقی افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.22,
   "end": 321.04,
   "text": "اون چیزی که در درون وجود ماست داره شکوفا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 321.04,
   "end": 325.0,
   "text": "وقت افطار خدای منان که میگه آقا جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.0,
   "end": 329.88,
   "text": "خدای عزیز عالم میگه آقا جان افطار بدید به روزه به فقرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 329.88,
   "end": 331.84,
   "text": "خب خودش که شارع مقدسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.84,
   "end": 335.08,
   "text": "خودش هم عامله. خودش هم افطار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.08,
   "end": 337.58,
   "text": "نون و غذا و نون و آب و اینا که همه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.58,
   "end": 341.84,
   "text": "اون افطاری که خدا میده، اون شکفتن وقت اذانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.84,
   "end": 345.74,
   "text": "دیدید وقت اذان الان همه گرسنه اند تشنه اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.74,
   "end": 349.28,
   "text": "وقتی به اذان نزدیک میشه اصلاً تشنگی و گرسنگی رفع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.28,
   "end": 352.6,
   "text": "یه فرحی میاد. اون فرح همون شکفتن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 352.6,
   "end": 355.06,
   "text": "همون افطاریه که خدا داره به تو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 355.06,
   "end": 359.18,
   "text": "این افطار درونیه. افطار ظاهری که چیز میذاری دهنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 359.18,
   "end": 361.7,
   "text": "اما از درون داری شکفته میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 361.7,
   "end": 364.72,
   "text": "ببینید بین الطلوعین رو میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 364.72,
   "end": 367.74,
   "text": "انف-انفطار یعنی شکفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 367.74,
   "end": 370.7,
   "text": "اصلاً عید فطر رو چرا میگن عید فطر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 370.7,
   "end": 374.76,
   "text": "چرا میگن ف-- به جهت اینکه روز اول شعبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 374.76,
   "end": 377.32,
   "text": "داره شکفته میشه ماه رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.32,
   "end": 381.32,
   "text": "ماه رمضان داره شکفته میشه که ما اصلاً اینطوری نیست بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 381.32,
   "end": 384.72,
   "text": "اعتبارا ماه رمضان بعد شواله اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 384.72,
   "end": 389.88,
   "text": "تا، تا ماه رمضان شکفته نشه فطری وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 389.88,
   "end": 392.82,
   "text": "ماه شوالی وجود نداره. همه ماهام اینچنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 392.82,
   "end": 396.54,
   "text": "شکفتنه و اصل شکفتن اون فرحی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 396.54,
   "end": 401.58,
   "text": "اون افطاری‌ست که خدا داره به انسان می‌ده در سر و سر و ضمیر وجود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 401.58,
   "end": 403.74,
   "text": "میگه فقرا رو ما هم فقیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 403.74,
   "end": 405.32,
   "text": "خودش میگه فقرا رو افطار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 405.32,
   "end": 407.92,
   "text": "ما هم فقیریم. پس خودش به ما افطار میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 407.92,
   "end": 410.5,
   "text": "خودش به ما افطار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 410.5,
   "end": 413.2,
   "text": "لحظه‌ی افطار، لحظه‌ی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 413.2,
   "end": 416.94,
   "text": "دو تا دو جا رو تو روزه دار گفتن حواسش باشه اینا صیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 416.94,
   "end": 419.46,
   "text": "یکی وقت افطاره، یکی بین الطلوعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 419.46,
   "end": 423.04,
   "text": "اینا صیدند. سحر سیره، سفره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 423.04,
   "end": 426.94,
   "text": "کل ما روزه تو روز سیر و سفر توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 426.94,
   "end": 430.24,
   "text": "وقت افطار میگن صیده، عرفا میگن صید کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 430.24,
   "end": 437.2,
   "text": "لذا بزرگان جالبه آقا میخوای بشینی افطار کنی دو تا لقمه غذا بخوری میگه حواست باشه عجله نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 437.2,
   "end": 440.72,
   "text": "اگر نمیتونی مهمون داری قبل از اینکه اذان بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 440.72,
   "end": 446.86,
   "text": "مرحوم آقای قاضی رحمت الله علیه حاج میرزا جواد آقا ملکی تبریزی میفرمودن دیگه حداقل دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 446.86,
   "end": 450.56,
   "text": "عهدو جالبه دعای عهدو قبل افطار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 450.56,
   "end": 454.86,
   "text": "موقع افطار بخون. یعنی فطر معنوی شکفتن از درون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 454.86,
   "end": 457.08,
   "text": "ببین چه اتفاقی میفته تو وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 457.08,
   "end": 461.48,
   "text": "حواست یکی اینه. یکی هم بین الطلوعین صید بین الطلوعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 461.48,
   "end": 466.24,
   "text": "میگه اون حالت بین-- دیدی بین الطلوعین نفس تو رو میکشونه به بیداری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 466.24,
   "end": 469.42,
   "text": "طبیعت میکشونه به خواب. سحره پاشدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 469.42,
   "end": 471.66,
   "text": "میگه اونجا وقت شکاره. صیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 471.66,
   "end": 476.38,
   "text": "میگه بین الطلوعین خدا تیم تدارکاتیش رو بسیج میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 476.38,
   "end": 481.72,
   "text": "چیکار کنید؟ رزق رو الان بدید اون رزقو بزرگان فرمودن این حالته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 481.72,
   "end": 484.1,
   "text": "این صیده. رزق معنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 484.1,
   "end": 485.86,
   "text": "دیدید حالت خلسه بهش میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 485.86,
   "end": 488.06,
   "text": "نه خوابی، نه بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 488.06,
   "end": 492.66,
   "text": "البته روزه-- وضوتم باطل نمیشه چون میشنوی صدا رو چشمت بسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 492.66,
   "end": 497.68,
   "text": "میگه اون لحظه یه دفعه یه آنی، یه صدایی، یه کرشمه‌ای، یه جلوه‌ای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 497.68,
   "end": 500.66,
   "text": "یه تصویری، یه چیزی میبینی، یه چیزی میفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 500.66,
   "end": 502.92,
   "text": "شکار‌های وقت بین الطلوعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 502.92,
   "end": 505.24,
   "text": "این وقت افطار به اوج میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 505.24,
   "end": 509.36,
   "text": "یکی از اسرار روزه همین شکار‌های وقت افطاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 509.36,
   "end": 511.7,
   "text": "که من دارم به همین راحتی عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 511.7,
   "end": 514.04,
   "text": "حواسمون باشه خلاصه مطلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 514.04,
   "end": 519.2,
   "text": "چون روزه خلوص محضه خدا اینو برداشته برای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 519.2,
   "end": 521.44,
   "text": "هرجا خلوص محض باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 521.44,
   "end": 524.44,
   "text": "هرکس خالص محض باشه مال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 524.44,
   "end": 527.0,
   "text": "اگر شهید هججی اینطوری ترکوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 527.0,
   "end": 530.32,
   "text": "باور کنین ما به خاطر خلوص محضش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 530.32,
   "end": 533.56,
   "text": "سر سوزنی تو وجود این بچه ریا نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 533.56,
   "end": 537.66,
   "text": "پ-پدرش چند بار من اینو از محضر پدرشون شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 537.66,
   "end": 543.76,
   "text": "چه حتی آوردیم این تهران تشریف آوردن بریم که فرمول یک اونجا برنامه داشته باشن، چه اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 543.76,
   "end": 546.84,
   "text": "محضر خودشون خدمتشون خونه‌شون رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 546.84,
   "end": 549.94,
   "text": "با آه میگفت من نشناختم پسرم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 549.94,
   "end": 553.04,
   "text": "وقتی شهید شد شناختم. این یعنی خلوص محض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 553.04,
   "end": 555.1,
   "text": "که چه خدمت‌هایی داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 555.1,
   "end": 559.28,
   "text": "چقدر پول‌هاشو کمک به مثلا جهیزیه میکرده، کمک به فقرا میکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 559.28,
   "end": 561.94,
   "text": "پدرش اینا رو نمی فهمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 561.94,
   "end": 567.76,
   "text": "عجب! جالبه. این خلوص محض رو از اسرار روزه سعی کنیم تمرین کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 567.76,
   "end": 570.0,
   "text": "انشاالله عاقبتمون بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 570.0,
   "end": 572.94,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 572.94,
   "end": 580.0,
   "text": "الله- الله الله .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}