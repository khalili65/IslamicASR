 "chapters": [
  {
   "index": 0,
   "title": "## شب بیست‌وسوم؛ شب قدر اصلی نزد فقهای امامیه",
   "start": 13.88,
   "end": 52.4
  },
  {
   "index": 1,
   "title": "## هزار و یک نکته؛ روایات شب قدر",
   "start": 52.4,
   "end": 128.94
  },
  {
   "index": 2,
   "title": "## هزار بار انزلنا در شب بیست‌وسوم و شدت یقین",
   "start": 128.94,
   "end": 273.02
  },
  {
   "index": 3,
   "title": "## احیای دو شب با مذاکرهٔ علم؛ ریاض الجنة",
   "start": 273.02,
   "end": 434.62
  },
  {
   "index": 4,
   "title": "## ذکر و طهارت؛ مقدمهٔ مسّ کتاب",
   "start": 434.62,
   "end": 484.74
  },
  {
   "index": 5,
   "title": "## تنزل ملائکه و روح؛ فیضان فهم معارف",
   "start": 484.74,
   "end": 576.36
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 2.36,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.36,
   "end": 5.7,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.7,
   "end": 7.62,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 7.62,
   "end": 12.46,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.46,
   "end": 17.64,
   "text": "اجازه بفرمایید که در ادامه بحث درون مایه ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.64,
   "end": 22.32,
   "text": "اشاراتی هم داشته باشیم در خصوص عظمت امشب که شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.32,
   "end": 26.86,
   "text": "بیست و سوم ماه مبارک هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.86,
   "end": 29.46,
   "text": "جالبه که بدونید غالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.46,
   "end": 35.22,
   "text": "فقهای امامیه ما قائلن به اینکه اون شب قدر اصلی امشب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.22,
   "end": 38.88,
   "text": "عنوان نمونه صاحب جواهر انتهای کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.88,
   "end": 42.78,
   "text": "دیاتش میاره که این کتاب رو تموم کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.78,
   "end": 46.58,
   "text": "کدوم کتاب رو؟ جواهر الكلام فی شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.58,
   "end": 52.4,
   "text": "شرایع الاسلام فی مسائل الحرام و حلا-حلال و الحرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.4,
   "end": 56.66,
   "text": "در شب بیست و سوم ماه مبارک رمضان که شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.66,
   "end": 60.64,
   "text": "قدر است، ایشون می‌نویسه انتهای کتابش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.64,
   "end": 67.68,
   "text": "یا حضرت علامه طباطبایی علیه الرحمه که بیست سال بیست جلد کتاب المیزان رو می‌نویسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.68,
   "end": 70.62,
   "text": "اون آخر که دیگه تموم می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.62,
   "end": 72.7,
   "text": "می‌نویسه که تم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.7,
   "end": 75.32,
   "text": "تمام شد تألیف این کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.32,
   "end": 77.94,
   "text": "فی لیلة المبارکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.94,
   "end": 83.14,
   "text": "از سالفه و العشرين من لیالی شهر رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.14,
   "end": 90.12,
   "text": "لیلة المبارکه. یعنی ایشونم تصریح می‌کنه که امشب که شب بیست و سومه اون شب قدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.12,
   "end": 93.64,
   "text": "اتفاقاً در نکته صد و هفتاد و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.64,
   "end": 96.5,
   "text": "هزار و یک نکته و من نکته‌ها رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.5,
   "end": 104.44,
   "text": "امروز مخصوصاً به دلیل کتاب علامه هزار و یک نکته، نکته رو دو مرتبه همه نکاتی که پیرامون شب قدر بود رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.44,
   "end": 106.74,
   "text": "حالا اگه کسی خواست رجوع کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.74,
   "end": 112.64,
   "text": "نکته یک، صد و هفتاد و چهار، دویست و سی و دو، چهارصد و نود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.64,
   "end": 114.96,
   "text": "ششصد و چهل و هفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.96,
   "end": 121.16,
   "text": "ششصد و هفتاد و سه. اینا همه پیرامون لیلة القدر در هزار و یک نکته بود از تو استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.16,
   "end": 125.84,
   "text": "در نکته صد و هفتاد و چهارش اشاره می‌کنه به حدیثی از امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.84,
   "end": 128.94,
   "text": "صلوات الله علیه که حضرت می‌فرمایند هر کس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.94,
   "end": 134.3,
   "text": "هر شب ماه مبارک رمضان هزار مرتبه انزلنا بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.3,
   "end": 138.28,
   "text": "و وقتی که رسید به شب بیست و سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.28,
   "end": 143.16,
   "text": "دل را محکم بدارد و گوش‌های خود را بگشاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.16,
   "end": 147.78,
   "text": "از برای شنیدن عجائب از آنچه خواهی خواهد دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.78,
   "end": 150.26,
   "text": "یعنی نشون میده که به شب بیست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.26,
   "end": 157.86,
   "text": "سوم رسید میگه اگه از شب اول شبی هزار تا انزلنا خوندی حالا به شب بیست و سوم رسیدی دیگه عجائب رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.86,
   "end": 162.06,
   "text": "ببین. چرا اصلاً سوره قدر تمسل آفرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.06,
   "end": 166.38,
   "text": "تنزل الملائکه و الروح تنزیل ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.38,
   "end": 169.16,
   "text": "میاد کمک میکنه که تمسلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.16,
   "end": 172.1,
   "text": "در انسان رخ بده که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.1,
   "end": 176.68,
   "text": "اصلاً نزول ملک دلیله یا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.68,
   "end": 183.58,
   "text": "تمسل حقیقت در صغری نفس دلیله بر نزول ملکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.58,
   "end": 187.76,
   "text": "و همچنین دو مرتبه در همین نکته از تو استاد به حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.76,
   "end": 192.06,
   "text": "شاید بعضیا بگن آقا ما که از اول ماه رمضان هزار تا انزلنا نگفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.06,
   "end": 194.36,
   "text": "خب بسم الله. میشه جبران کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.36,
   "end": 199.96,
   "text": "این یه حدیث دیگه. ات خیلی جالبه که در همین نکته صد و هفتاد و چهار از تو استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.96,
   "end": 204.62,
   "text": "می فرمایند به سندهای معتبر از آن حضرت یعنی از امام صادق به سندهای معتبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.62,
   "end": 212.06,
   "text": "یکیش هم اینجا نقل میکنه سند رو به بحار مرحوم مجلسی علیه الرحمه که از امام صادق صلوات الله علیه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.06,
   "end": 216.64,
   "text": "علامه حسن زاده اینجا روایت میاره که کسی که در شب بیست و سوم، امشب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.64,
   "end": 220.9,
   "text": "هزار مرتبه انزلنا بخواند چون صبح کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.9,
   "end": 223.44,
   "text": "خیلی به درد ما میخوره این جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.44,
   "end": 227.66,
   "text": "چون گرفتاری ما همه تو اینه که یقین نداریم، مشکوکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.66,
   "end": 233.1,
   "text": "چون صبح کند یقین او شدید و محکم شده باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.1,
   "end": 236.72,
   "text": "اونم به چی؟ به اعتراف نمودن به چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.72,
   "end": 240.4,
   "text": "که مخصوص ماست از غرائب فضائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.4,
   "end": 250.86,
   "text": "ما. و خیلی عجیب اینجا که حضرت اشاره میکنه و نیست این مگر به چیزی که به سبب چیزی که در خواب مشاهده می‌نماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.86,
   "end": 256.0,
   "text": "اینم حالا شاید بزرگان دستور دادن کسی که میخواد خوابش، تمسلاتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.0,
   "end": 261.8,
   "text": "تمسلات نومیه ش اینا خوب بشه، زلال بشه و زیاد بشه، خواب‌های خوب زیاد ببینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 261.8,
   "end": 266.98,
   "text": "سوره نز-انزلنا رو اکثار داشته باشه از همین فرمایش امام صادق میتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.98,
   "end": 269.32,
   "text": "دلیلش باشه و برداشت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.32,
   "end": 271.7,
   "text": "حالا پس امشب خیلی شب مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.7,
   "end": 276.08,
   "text": "حالا امشب چه کنیم؟ مهمترین کار امشبم براتون عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.08,
   "end": 279.56,
   "text": "باز تو نکته قربون علامه بریم روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.56,
   "end": 281.88,
   "text": "نکته ششصد و هفتاد و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 281.88,
   "end": 286.86,
   "text": "اینجا از علامه میگه که از شیخ صدوق در امالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.86,
   "end": 293.76,
   "text": "روایت میاره که در احیای شب‌های بیست و یک و بیست و سه ماه مبارک رمضان مخصوصاً تو این دو شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.76,
   "end": 296.04,
   "text": "و من احیاها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 296.04,
   "end": 298.34,
   "text": "طین اللیلتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.34,
   "end": 302.26,
   "text": "و من احیا هر کسی که احیا بداره این دو شب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.26,
   "end": 305.52,
   "text": "خاتین لیلتن. این دو شب رو احیا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 305.52,
   "end": 309.7,
   "text": "بمذاکره العلم فهو افضل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 309.7,
   "end": 314.6,
   "text": "یعنی به مذاکره علمی بگذرونه این شب رو افضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.6,
   "end": 316.6,
   "text": "و دو مرتبه سند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.6,
   "end": 319.1,
   "text": "خ-- این عین کلام از علامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.1,
   "end": 322.38,
   "text": "در کدوم نکته؟ ششصد و هفتاد و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.38,
   "end": 325.9,
   "text": "می‌فرمایند سند این حکم محکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.9,
   "end": 327.98,
   "text": "میگه خیلی حکم محکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.98,
   "end": 331.86,
   "text": "همین فرمایشی که الان شیخ صدوق در امالی آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.86,
   "end": 335.98,
   "text": "می‌فرمایند سند این حکم محکم خود را از رسول اکرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 335.98,
   "end": 339.52,
   "text": "در ملل یهزر الفقیه هم آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.52,
   "end": 348.82,
   "text": "شیخ صدوق و اونجا این حدیث رو نقل میکنه که بادروا از پیغمبر بادروا الریاض الجنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 348.82,
   "end": 352.0,
   "text": "سرعت به سبقت بگیرید به سمت باغ‌های بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 352.0,
   "end": 356.04,
   "text": "یکی سؤال کرد قیل یا رسول الله ما-- و ما ریاض الجنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 356.04,
   "end": 359.04,
   "text": "این باغ بهشت چیه؟ باغ‌های بهشت چی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 359.04,
   "end": 361.12,
   "text": "عجیبه. حضرت فرمودند قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.12,
   "end": 363.46,
   "text": "فرمودند خلقت الذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.46,
   "end": 366.62,
   "text": "حلقه های ذکر و حالا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.62,
   "end": 370.18,
   "text": "احتمال داره که یکی برگرده بگه آقا این ذکر گفته دیگه ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.18,
   "end": 373.12,
   "text": "پیغمبر فرموده حلقه‌های ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.12,
   "end": 377.24,
   "text": "یعنی همون یاد خدا. خب باید ببینیم کارشناس دین چی فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 377.24,
   "end": 380.26,
   "text": "دو مرتبه خود حضرت استاد اینجا میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.26,
   "end": 382.14,
   "text": "از ملا محسن فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.14,
   "end": 385.54,
   "text": "به به به. بهترین شاگرد ملاصدرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.54,
   "end": 389.2,
   "text": "در کتاب شریف وافیش که خیلی حضرت استاد اشاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.2,
   "end": 391.54,
   "text": "تأکید داشتن به وافیه ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.54,
   "end": 395.4,
   "text": "که بخونید. باب مجالس العلماء و صحبتهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.4,
   "end": 397.42,
   "text": "جلد یک صفحه چهل و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 397.42,
   "end": 401.22,
   "text": "پس از نقل حدیث در بیان آن گفته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.22,
   "end": 405.68,
   "text": "أرید به حلقت به حلق الذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 405.68,
   "end": 409.28,
   "text": "مجالس العلماء. اینو ملا محسن میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.28,
   "end": 412.5,
   "text": "میگه این ا اینو اراده کنیم از چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.5,
   "end": 417.02,
   "text": "از این حلقه‌های ذکر که پیغمبر گفت فرموده باغ‌های بهشته به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.02,
   "end": 423.92,
   "text": "مجالست با علما. یعنی نشستن پای درس علما، مذاکره علمی، معارف، کسب معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.92,
   "end": 431.36,
   "text": "حالا هج-- هر ش-- امشب تا صبح بشینیم تو سر خودمون بکوبیم و هیچ خبری از معارف نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.36,
   "end": 434.62,
   "text": "این اشتباهه. البته این رو هم عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.62,
   "end": 439.14,
   "text": "وقتی نگاه می‌کنیم به سیرت اولیا می‌بینیم که خب این همه همین ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.14,
   "end": 446.5,
   "text": "هزار تا انزلنا قرآن به سر گرفتن، توسل به حضرت حجت خاصه به حضرت صدیقه کبرا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 446.5,
   "end": 449.38,
   "text": "دعا و تضرع و انابه و اینا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.38,
   "end": 453.28,
   "text": "اینا همه، همه، همه این‌ها مقدمه است برای همون علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.28,
   "end": 455.82,
   "text": "چرا؟ چون لا یمس Firetouch او الا المتهرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 455.82,
   "end": 457.94,
   "text": "این‌ها طهارت نفس میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.94,
   "end": 460.28,
   "text": "تطهیر قوای وجودی میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.28,
   "end": 463.68,
   "text": "حالا آماده میشی برای کسب فضائل و حقایق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.68,
   "end": 468.52,
   "text": "انشاالله اینکه این‌ها در وجودت پیاده بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 468.52,
   "end": 473.1,
   "text": "که پس مجموعاً ما متوجه میشیم که امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 473.1,
   "end": 479.24,
   "text": "شبی است که باید طهارت نفس ایجاد کرد برای نشستن پای درس و بحث و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 479.24,
   "end": 481.78,
   "text": "معرفت حلقه‌های-- حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.78,
   "end": 487.26,
   "text": "ما چون بحثمون این نکته هم بگم و بحثو جمع کنم بحث تنزل الملائکه و الروح بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 487.26,
   "end": 492.18,
   "text": "گفتیم از درون مایه های امشب و این ماه رمضان تنزيل ملائکه بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 492.18,
   "end": 495.4,
   "text": "ملائکه اصلاً کارشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 495.4,
   "end": 499.0,
   "text": "واسطه‌های فیضان به یک معنا به صورت کلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 499.0,
   "end": 505.08,
   "text": "از مهم‌ترین فیوضاتی که از حضرت حق نصیب بنده ش می‌شه همین فهم معارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.08,
   "end": 509.22,
   "text": "پس اگر امشب تنزل و الملائکه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.22,
   "end": 515.78,
   "text": "همه ملائکه که همشون واسطه فیضان نازل میشن به اتفاق روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.78,
   "end": 518.16,
   "text": "که اون روح رو توضیح دادیم کیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.16,
   "end": 525.78,
   "text": "چه وجاهتی و چه جایگاهی دارد که مقام پرورش عالم هستی است و حضرت صدیقه کبری صلوات الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.78,
   "end": 530.46,
   "text": "اینا میان برای چی؟ برای اینکه به من و تو فهم بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.46,
   "end": 533.6,
   "text": "القاءات معنویه و حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 533.6,
   "end": 535.84,
   "text": "تو رو به تمثلات بکشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 535.84,
   "end": 539.02,
   "text": "وقتی به قول حضرت عالمه در شرح فصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 539.02,
   "end": 542.02,
   "text": "تمثلی از حقیقت در وجود تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 542.02,
   "end": 546.3,
   "text": "اتفاق میفته که تو یه چیزی رو درک می‌کنی، می‌چشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 546.3,
   "end": 549.9,
   "text": "نه علم فکری که مفهوم بفهمی نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.9,
   "end": 555.14,
   "text": "لفظ حس کنی نه. در درون درک عمیقی از یک حقیقت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 555.14,
   "end": 560.44,
   "text": "این نزول ملکه. حالا همه ملائکه امشب میان به اتفاق نو-- روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 560.44,
   "end": 564.24,
   "text": "پس همه دارن میان دست به دست هم بدن که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 564.24,
   "end": 566.96,
   "text": "ما تا دلت بخواد امشب بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 566.96,
   "end": 571.68,
   "text": "یعنی غرق در معارف و معالم الهی بشیم انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 571.68,
   "end": 575.8,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 575.8,
   "end": 576.36,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}