 },
 "chapters": [
  {
   "index": 0,
   "title": "امروز در ختم قرآن رسیدیم به آیهٔ سی‌ویک سورهٔ فصلت؛ چه شیرین آنجا که می‌فرماید:",
   "start": 0.56,
   "end": 99.04
  },
  {
   "index": 1,
   "title": "## قرب نافله و قرب فریضه؛ هم‌نشینی",
   "start": 99.04,
   "end": 233.52
  },
  {
   "index": 2,
   "title": "## مزاج و هم‌جنس؛ فیروزه و رحم کوه",
   "start": 233.52,
   "end": 329.76
  },
  {
   "index": 3,
   "title": "## هدهد و عذاب شدید؛ هم‌نشین ناجنس",
   "start": 329.76,
   "end": 509.86
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 6.14,
   "text": "و بهین استعین. السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.14,
   "end": 8.32,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.32,
   "end": 11.72,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.72,
   "end": 17.32,
   "text": "موضوع تنزل ملائکه رو ما خیلی باید جدی بگیریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.32,
   "end": 22.8,
   "text": "حالا این اتفاق عجیب در شب قدر که بهترین شب هم هست میفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.8,
   "end": 26.24,
   "text": "خودش فلسفه‌ای دارد. خب اگر بگیم که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.24,
   "end": 29.94,
   "text": "ملائکه میان بر امام عصر که همینم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.94,
   "end": 34.6,
   "text": "رو حضرت روح، حضرت روح اعظم بر امام عصر نازل میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.6,
   "end": 39.34,
   "text": "سؤال آیا امام عصر نمیتونست خودش بره به معراج؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.34,
   "end": 42.68,
   "text": "چرا ما الان حدیث داریم. علامه همدانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.68,
   "end": 49.06,
   "text": "در کتاب الشموس الطالعه‌ش میاره که امام عصر هر شب جمعه معراج داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.06,
   "end": 51.54,
   "text": "معراج داره. ایشون تشریف می‌برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.54,
   "end": 55.68,
   "text": "بالا. خب نمیشد شب‌های قدر هم حضرت تشریف ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.68,
   "end": 59.28,
   "text": "یه وجهش و یک فلسفه‌ش به خاطر من و شماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.28,
   "end": 63.04,
   "text": "که نزول رخ بده اون‌ها بیان اینجا فضا متفاوت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.04,
   "end": 68.22,
   "text": "انقدر که ما گیر و گور داریم و گرفتار دنیا و سجن دنیا شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.22,
   "end": 72.44,
   "text": "و در حقیقت یک هم‌نشینی رخ بدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.44,
   "end": 75.42,
   "text": "اینکه تصریح می‌کنه در سوره قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.42,
   "end": 78.06,
   "text": "که تنزل الملائکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.06,
   "end": 80.66,
   "text": "الملائکه همه میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.66,
   "end": 82.96,
   "text": "این تصریحه و دوباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.96,
   "end": 85.42,
   "text": "الروح این پیداست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.42,
   "end": 87.8,
   "text": "مثلا آقای مس Bah روحشون شاد می‌فرمایند این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.8,
   "end": 92.92,
   "text": "واوی که اینجا اومده قبل الروح متفاوت کرده روح رو با ملائکه پیداست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.92,
   "end": 95.84,
   "text": "روح یه چیز دیگه‌ایست فارغ از ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.84,
   "end": 99.04,
   "text": "مثلا ملائکه جنود او حساب میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.04,
   "end": 104.64,
   "text": "حالا اتفاقا همین امروز که با عزیزان داشتیم ختم می‌کردیم قرآن رو همین جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 104.64,
   "end": 107.76,
   "text": "رسیدیم به آیه سی و، سی و یک سوره فصلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.76,
   "end": 115.12,
   "text": "دیدم چه شیرین اونجا که می‌فرماید إن الذين قالوا ربنا الله ثم استقاموا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.12,
   "end": 117.5,
   "text": "تتنزل عليهم الملائكة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.5,
   "end": 121.32,
   "text": "همون روزای اول در خصوص درون ماه رمضان گفتیم همین آیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.32,
   "end": 124.34,
   "text": "تتنزل عليهم الملائكة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.34,
   "end": 130.22,
   "text": "بعد میگن الا تخافوا ولا تحزنوا وأبشروا بالجنة التي كنتم توعدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.22,
   "end": 132.26,
   "text": "آیه سی و یک ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.26,
   "end": 136.04,
   "text": "چه‌جوری، چه‌جوری تصریح می‌کنه دوباره همین رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.04,
   "end": 141.26,
   "text": "ما معمولا اسم ملک، فرشته اینا که میاد میگیم آخرت، قیامت، بعد از مرگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.26,
   "end": 146.26,
   "text": "عالم برزخ اینا. ذهن، ذهن ما تداعی اون ور رو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.26,
   "end": 153.62,
   "text": "اما اینجا تو این آیه خود ملائکه به انسان‌هایی که استقامت دارن در مسیر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.62,
   "end": 156.62,
   "text": "میگن نحن اولیاؤکم آیه بعدشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.62,
   "end": 160.96,
   "text": "نحن ما اولیاؤکم في الدنيا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.96,
   "end": 165.66,
   "text": "دقت کنین تصریح داره في الدنيا والآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.66,
   "end": 167.78,
   "text": "ما یاران شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.78,
   "end": 170.14,
   "text": "اولیاء شماییم. هم‌نشین با شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 170.14,
   "end": 172.2,
   "text": "هم تو دنیا هم آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.2,
   "end": 180.68,
   "text": "اینه که بعضی از بزرگان ما مشایخ‌مون داشتیم کسایی که اون‌ها خیلی توصیه می‌کردن اگر می‌خواید از جهت معنوی قوی شید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.68,
   "end": 184.56,
   "text": "هرجا رفتید زیارت به نیت ملائکه‌ای هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.56,
   "end": 187.1,
   "text": "مو-- این‌ها محافظ شما هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.1,
   "end": 188.8,
   "text": "خدا می‌دونه تعداد اینا چقدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.8,
   "end": 194.22,
   "text": "وقتی هر ذره، ذره وجودی ما رو ملکی موکل شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.22,
   "end": 196.28,
   "text": "اینا چه تعداد عجیبی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.28,
   "end": 200.24,
   "text": "چه عظمتی در این عالم است. به نیت اونا زیارت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.24,
   "end": 203.28,
   "text": "حالا اینا همه نازل میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.28,
   "end": 206.54,
   "text": "میان پایین که بهش میگن اصطلاحا حالا فردا اگه تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.54,
   "end": 208.84,
   "text": "خدا توفیق داد توضیح میدیم چه فرقی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 208.84,
   "end": 211.26,
   "text": "اصطلاحا بهش میگن قرب نا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 211.26,
   "end": 216.2,
   "text": "نافله. اینکه تو بری بالا معراج می‌شی قرب، قرب فریضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.2,
   "end": 219.0,
   "text": "حالا قرب نافله رخ داده اونا میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 219.0,
   "end": 223.68,
   "text": "برای چی میان؟ خب نمی‌تونست امام زمان تشریف بیاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.68,
   "end": 225.58,
   "text": "برای هم‌نشینی ما با اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 225.58,
   "end": 229.18,
   "text": "اینکه ما عوض شیم. اصلا فلسفه جز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 229.18,
   "end": 233.3,
   "text": "بحث هم‌نشینی رو جدی بگیرید که دیروز گفتیم خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 233.3,
   "end": 236.62,
   "text": "البته استاد علامه حسن زاده انقدر تأکید دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 236.62,
   "end": 238.52,
   "text": "وقتی بحث مزاج رو تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 238.52,
   "end": 241.62,
   "text": "عرض شد که در اسرار الآیات نمت 十",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 241.62,
   "end": 245.12,
   "text": "م اشارات شیخ انصاری می‌گه ایشون ذیلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 245.12,
   "end": 249.26,
   "text": "شرح می‌ده. خیلی تأکید می‌کنه بعد مزاجو که بحث می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.26,
   "end": 252.0,
   "text": "شما ببین مثلا یه سنگ فیروزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 252.0,
   "end": 254.7,
   "text": "از دو تا شهر تو دو تا کوه متفاوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 254.7,
   "end": 257.54,
   "text": "چرا این‌ها مزاجشون با هم فرق می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 257.54,
   "end": 260.02,
   "text": "سنگ، سنگه. این سنگ فیروزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 260.02,
   "end": 262.46,
   "text": "این مال نیشابوره، اون مال یه جا دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 262.46,
   "end": 268.6,
   "text": "چرا با هم فرق می‌کنن؟ اینکه تو چه کوهی هست، چه خاکیه، چقدر آفتاب بهش خورده، چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 268.6,
   "end": 272.06,
   "text": "بارون ریخته سرش. تو دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 272.06,
   "end": 275.42,
   "text": "رحم کدوم کوه پرورش پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 275.42,
   "end": 278.46,
   "text": "هو الذي یصورکم في الأرحام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 278.46,
   "end": 286.06,
   "text": "كيف یشاء. چرا انار سابە با انار نمیدونم ورامین با انار فلان اینا همه فرق می‌کنند مزاج...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.06,
   "end": 288.92,
   "text": "آدما هم اتفاقا حضرت علامه می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 288.92,
   "end": 294.78,
   "text": "این مزاج‌ها این بر اس-- که بر اثر رحم‌ها، ترکیب‌ها این‌ها رخ میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 294.78,
   "end": 297.78,
   "text": "به عددش به تعداد شهرهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 297.78,
   "end": 299.74,
   "text": "یعنی همه با همه متغیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 299.74,
   "end": 302.14,
   "text": "همه. همه با هم متفاوتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 302.14,
   "end": 304.4,
   "text": "تو یه‌دونه‌ای. چون خدا یه‌دونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 304.4,
   "end": 307.06,
   "text": "خلقش هم یه‌دونه‌ست. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 307.06,
   "end": 309.38,
   "text": "این همه که کثرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 309.38,
   "end": 314.0,
   "text": "میگه تو برو هم جنس و هم سنخ خودت رو پیدا کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 314.0,
   "end": 319.36,
   "text": "باهاش بنشین. تو ملکوتی هستی باید عروج کنی لذا ملائکه میان کمکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 319.36,
   "end": 321.92,
   "text": "حضرت روح هم میاد کمکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 321.92,
   "end": 325.54,
   "text": "چون جنس روح ما از جنس روح اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 325.54,
   "end": 329.76,
   "text": "این بحثو قبلا گذشت. اتفاقا خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 329.76,
   "end": 334.18,
   "text": "جالب بود برام که داشتم تفاسیر رو بررسی می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 334.18,
   "end": 336.84,
   "text": "پیرامون اون قصه از سلیمان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 336.84,
   "end": 340.1,
   "text": "اون مورچه و اینا که چرا حضرت سلیمان خندید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 340.1,
   "end": 342.24,
   "text": "خیلی برام شیرین بود. حالا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 342.24,
   "end": 348.86,
   "text": "یه روز دیگه. بعد رسیدم به این آیه بیست و یک سوره نمل که لأعذبنه عذابا شديدا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 348.86,
   "end": 351.46,
   "text": "حضرت سلیمان. پیرامون حضرت سلیمان داشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 351.46,
   "end": 357.36,
   "text": "یه تحقیقی می‌کردم. أو لأذبحنه أو ليأتين بسلطان مبين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 357.36,
   "end": 359.5,
   "text": "وقتی دید هدهد نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 359.5,
   "end": 363.88,
   "text": "حضرت سلیمان گوی کجاست؟ یا باید دلیل روشن بیاره قاطع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 363.88,
   "end": 366.46,
   "text": "یا اینکه عذاب شدیدی بهش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 366.46,
   "end": 373.78,
   "text": "لا و اونم تأکید داره. قطعاً، قطعاً لا و اولاً نه و عذاباً شدیدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 373.78,
   "end": 376.6,
   "text": "و یا اینکه میگه زبش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 376.6,
   "end": 382.38,
   "text": "حالا این عذاب شدید رو من آخه یه پرنده هدهد عذاب شدید داره مگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 382.38,
   "end": 384.68,
   "text": "چیه آخه مگه؟ بعد تو روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 384.68,
   "end": 389.16,
   "text": "یکی تو کتاب روح المعانی جلد ده صفحه صد و هفتاد و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 389.16,
   "end": 395.3,
   "text": "یه روایت دیدم. یکی هم от تفسیر الکبیر و مفاتیح الغیب معروف جلد بیست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 395.3,
   "end": 397.52,
   "text": "چهار صفحه پونصد و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 397.52,
   "end": 401.74,
   "text": "خیلی جالب برام بود. توی روح المعانی اینو بگم بسه دیگه امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 401.74,
   "end": 406.22,
   "text": "تو روح المعانی میگه که منظور از این عذاب شدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 406.22,
   "end": 411.2,
   "text": "اینه که حضرت سلیمان شاید قصد داشته که دیگه تو دستگاه ما نیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 411.2,
   "end": 415.86,
   "text": "مثل اینکه امام حسین بیاد به من و تو بگه دیگه حق نداری هیئت ما بیای نوکری ما رو بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 415.86,
   "end": 418.74,
   "text": "هدهد تو حق نداری دیگه نوکری سلیمانو بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 418.74,
   "end": 421.68,
   "text": "عذاب شدیده. توجه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 421.68,
   "end": 425.68,
   "text": "بعد توی اون کتاب مفاتیح الغیب می‌فرمود نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 425.68,
   "end": 429.94,
   "text": "هدف این بوده که حضرت سلیمان این آقا رو یعنی آقای هدهد رو بندازه توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 429.94,
   "end": 434.48,
   "text": "قفسی همراه یک پرنده‌ای که ناجنسه هم سنخش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 434.48,
   "end": 439.18,
   "text": "مثل زاغ. مثال زدن مثل زاغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 439.18,
   "end": 442.64,
   "text": "که اینا اون تو درگیر میشن و حالت سجن و زندان پیدا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 442.64,
   "end": 444.8,
   "text": "مثل الان-- اصلاً nature طبیعت همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 444.8,
   "end": 448.6,
   "text": "درگیریه دائماً. نور و ظلمت مشوبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 448.6,
   "end": 451.98,
   "text": "شب و روز. ببین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 451.98,
   "end": 455.6,
   "text": "خوشی و ناخوشی، مریضی و شفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 455.6,
   "end": 459.6,
   "text": "اصلاً همینه. دائماً اینطوری درگیرن همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 459.6,
   "end": 462.62,
   "text": "حالا میگه که ببینید بحث چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 462.62,
   "end": 469.28,
   "text": "هم نشین. میگه که زاغ میخواست هدهد رو بندازه با یه زاغ مثلاً توی یه قفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 469.28,
   "end": 472.1,
   "text": "این زجر میکشه تا قیام قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 472.1,
   "end": 477.76,
   "text": "اینکه امیرالمؤمنین تو کمیل می فرمود خدايا ما رو با دشمنان دیجه قرار نده و اشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 477.76,
   "end": 482.9,
   "text": "فی جه بارک مع المومنین با اهل ایمان باش یعنی هم جنسی، هم سنخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 482.9,
   "end": 485.28,
   "text": "حالا خسته تون نکنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 485.28,
   "end": 490.0,
   "text": "از درون مایه های ماه مبارک رمضان خاصه شب قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 490.0,
   "end": 496.92,
   "text": "این قرب نافله یا نزول ملائکه و حضرت روحه که من و تو هم نشین پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 496.92,
   "end": 501.84,
   "text": "هم نفس بشیم با اون اصلیتمون که حضرت روح اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 501.84,
   "end": 509.86,
   "text": "خب اینو نباید از دست داد. انشاالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد. اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}