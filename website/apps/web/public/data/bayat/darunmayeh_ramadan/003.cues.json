 },
 "chapters": [
  {
   "index": 0,
   "title": "## درون‌مایهٔ رمضان؛ ارتباط با ملائکه",
   "start": 10.5,
   "end": 276.88
  },
  {
   "index": 1,
   "title": "## ملاصدرا؛ ملائکه قوای عالم‌اند",
   "start": 276.88,
   "end": 412.41
  },
  {
   "index": 2,
   "title": "## کراماً کاتبین و ثبت اعمال",
   "start": 412.41,
   "end": 488.27
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 5.86,
   "text": "و بهین استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.86,
   "end": 10.5,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.5,
   "end": 18.0,
   "text": "بحث ما پیرامون نحوه ارتباط ما با این ماه مبارک و درون مایه این ماه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.0,
   "end": 21.58,
   "text": "به عبارتی اسرار و برکات این ماه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.58,
   "end": 26.86,
   "text": "و البته نمی‌خواستیم توقف کنیم اما انقدر حرف زیاد داره این موضوع که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.86,
   "end": 29.32,
   "text": "حیفمون میاد زود بگذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.32,
   "end": 34.62,
   "text": "عرض شد که به فرمایش حضرت استاد علامه حسن زاده علیه الرحمه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.62,
   "end": 39.1,
   "text": "شرح فصوص‌شون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.1,
   "end": 42.44,
   "text": "می‌تونیم با ملائکه ارتباط بگیریم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.44,
   "end": 47.12,
   "text": "به ظعم ایشون اون تمثلات از حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.12,
   "end": 51.52,
   "text": "در سقع نفس یعنی در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.52,
   "end": 55.52,
   "text": "کمون ذات ما، در اون باطن وجود ما، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.52,
   "end": 59.2,
   "text": "تمثلات که از حقایق رخ میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.2,
   "end": 63.46,
   "text": "و ما حالا بخوایم همə فهم سخن بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.46,
   "end": 69.06,
   "text": "حقیقتی که در درون ما جلوه می‌کنه و ما در درون خودمون یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.06,
   "end": 72.96,
   "text": "حقیقتی رو متوجه می‌شیم، می‌چشیم، می‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.96,
   "end": 75.42,
   "text": "اون همون نزول ملکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.42,
   "end": 77.4,
   "text": "حالا چرا ما این بحث رو داریم می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.4,
   "end": 84.7,
   "text": "می‌خوایم بگیم که از برکات و اسرار و درون مایه ماه مبارک رمضان ارتباط با ملائکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.7,
   "end": 89.58,
   "text": "الا اینکه \"و تنزل الملائکه والروح فيها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.58,
   "end": 93.72,
   "text": "و اینکه لیلة القدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.72,
   "end": 99.66,
   "text": "یک امری‌ست که هر ساله داره اتفاق میفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.66,
   "end": 103.74,
   "text": "یک امر اتفاقی‌ست. یعنی در میان همه فرق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.74,
   "end": 107.38,
   "text": "فریقین عامه و خاصه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.38,
   "end": 111.46,
   "text": "امامی و غیر امامی همه پذیرفتن که لیلة القدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.46,
   "end": 114.72,
   "text": "دائما همه ساله داره تکرار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.72,
   "end": 118.92,
   "text": "این نیست که فقط اون سالی که پیغمبر اخذ قرآن کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.92,
   "end": 125.78,
   "text": "شد و تمام شد. نه. که اتفاقا امام باقر علیه السلام در اون باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.78,
   "end": 129.4,
   "text": "شریف ان انزلناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.4,
   "end": 133.5,
   "text": "مرحوم کلینی علیه الاعلام مقامش شریف در اصول کافی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.5,
   "end": 138.6,
   "text": "اونجا از امام باقر علیه السلام روایت شریفی میاره که با دشمنان ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.6,
   "end": 142.64,
   "text": "با مخالفین با وجود حجت و امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.64,
   "end": 144.24,
   "text": "با این سوره محاجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.24,
   "end": 149.06,
   "text": "\"و تنزل الملائکه والروح\" اونجا بگید که این ملائکه و روح به کی نازل میشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.06,
   "end": 153.08,
   "text": "بالاخره ظرف نزول این ملائکه و روح کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.08,
   "end": 156.52,
   "text": "چیست؟ حالا که بحث ما فعلا اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.52,
   "end": 160.82,
   "text": "موضوع اینجاست که در ماه مبارک رمضان به خصوص شب‌های قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.82,
   "end": 168.84,
   "text": "ملائکه نازل میشن. حالا شما این لیلة القدر رو اگر تفصیلی بگیرید در ماه شعبان رخ میده، اجمالی بخواید بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.84,
   "end": 174.56,
   "text": "به صورت کلی بخواید بگیرید شب قدر ماه مبارک رمضان رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.56,
   "end": 177.78,
   "text": "حالا غیر زمانی بگیرید، زمانی بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.78,
   "end": 179.96,
   "text": "همه این‌ها معانی مختلفی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.96,
   "end": 182.16,
   "text": "مهم اینه که ما اینو بدونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.16,
   "end": 190.44,
   "text": "ما می‌توانیم با ملائکه ارتباط داشته باشیم بلکه آن به آن در حال ارتباط یا با ملائکه یا با شیاطین هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.44,
   "end": 195.82,
   "text": "این یک امر قرآنی‌ست که عرض می‌کنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.82,
   "end": 203.06,
   "text": "وقتی شما توجه به آیاتی که پیرامون ملائکه سخن گفته می‌کنید مثلا آیه شش سوره تحریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.06,
   "end": 205.04,
   "text": "ملائکه رو چگونه معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.04,
   "end": 210.36,
   "text": "لا یعصون الله اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.36,
   "end": 212.76,
   "text": "ما امرهم مطلقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.76,
   "end": 218.6,
   "text": "معصیت امر الهی نمی‌کنند و يفعلون ما يؤمرون آنچه که امر میشه بهشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 218.6,
   "end": 225.2,
   "text": "انجام میدن. یا آیه بیست و شش و بیست و هفت انبیا می‌فرماید \"بل عباد مكرمون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 225.2,
   "end": 228.98,
   "text": "این‌ها بندگان گرامی خدا هستند ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.98,
   "end": 232.96,
   "text": "لا یسبقونه بالقول وهم بأمره يعملون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.96,
   "end": 237.54,
   "text": "اصلا حرفی بر علیه هر خدا هر-- اصلا حرفی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.54,
   "end": 242.48,
   "text": "سابقه ای ندارن بر حرف بر علیه خدا یا زودتر سخن گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 242.48,
   "end": 246.62,
   "text": "و به امرهی يعملون به امر خدا عمل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 246.62,
   "end": 251.5,
   "text": "این ملائکه‌ای که این چنین قرآن اومده معرفیشون کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 251.5,
   "end": 254.24,
   "text": "یه رابطه‌ای به هر حال بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.24,
   "end": 258.72,
   "text": "ما و ملائکه و ملائکه و خدا وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.72,
   "end": 261.9,
   "text": "که این رابطه در این ایام شدت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 261.9,
   "end": 267.18,
   "text": "در ایام ماه مبارک رمضان شدت ارتباط با ما با، با ملائکه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 267.18,
   "end": 271.26,
   "text": "که ملائکه هم ارتباطشون با حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 271.26,
   "end": 275.94,
   "text": "شبیه ارتباط نفس ما با قوای خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 275.94,
   "end": 278.92,
   "text": "این رو حضرت ملاصدرا می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.92,
   "end": 281.22,
   "text": "این رو دقت کنید خیلی نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 281.22,
   "end": 283.76,
   "text": "شیرین و علمی و به درد بخوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.76,
   "end": 286.14,
   "text": "رابطه ملائکه با خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.14,
   "end": 291.24,
   "text": "به قول ملاصدرا مثل رابطه نفس ما با قوای خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.24,
   "end": 296.14,
   "text": "یعنی ملائکه قوای عالمن که نازل میشن بر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 296.14,
   "end": 302.5,
   "text": "و همونطور که عن نفس فی وحدتها کل القوی قبلا توضیح دادیم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.5,
   "end": 305.84,
   "text": "همه قوا در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.84,
   "end": 309.26,
   "text": "اگرچه نفس یک حقیقته اما همه قواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.26,
   "end": 314.42,
   "text": "یعنی نفس می‌بیند، نفس می‌شنود، نفس لمس می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.42,
   "end": 318.28,
   "text": "نه اینکه پوستتو لمس کنه، نفس تو داره لمس می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.28,
   "end": 322.66,
   "text": "این بدن تو هم نازله، مرتبه نازله نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 322.66,
   "end": 327.82,
   "text": "این رابطه چگونه است؟ رابطه بین این قوا یا مدرکات حسیه اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 327.82,
   "end": 330.48,
   "text": "چگونه است با اون نفس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 330.48,
   "end": 332.5,
   "text": "این‌ها قوای نفس‌اند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 332.5,
   "end": 334.14,
   "text": "چشم، بصر، سمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.14,
   "end": 337.2,
   "text": "این‌ها قوای نفس‌اند. جدای از نفس نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.2,
   "end": 339.32,
   "text": "نفس می‌بینه، نفس می‌شنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 339.32,
   "end": 341.9,
   "text": "رابطه ملائکه با خدا همینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.9,
   "end": 345.78,
   "text": "اون‌ها جدای از خدا نیستند. اون‌ها قوای حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 345.78,
   "end": 348.28,
   "text": "عن نفس فی وحدتها کل القوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.28,
   "end": 350.92,
   "text": "حالا این ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.92,
   "end": 358.16,
   "text": "در ذات وجودی من و شما در سر و سر ما در اون مرتبه خفی و اخفای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 358.16,
   "end": 360.99,
   "text": "اونجا تمثلات دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.99,
   "end": 366.63,
   "text": "و اون حقایق الهیه رو به ما القا می‌کنند، الهام می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 366.63,
   "end": 368.49,
   "text": "اگر کسی پس بزنه با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 368.49,
   "end": 372.57,
   "text": "با گناه، با معصیت. اونا جاشونو با شیاطین عوض می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 372.57,
   "end": 377.61,
   "text": "اونچه که در وجود ما، در ذات ما، در باطن ما خودش رو نشون میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.61,
   "end": 381.57,
   "text": "همش رنگ و بوی حیوانیت و شیط-- شیطانی میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 381.57,
   "end": 385.67,
   "text": "پس ما دائماً اینو توجه داشته باشید یا در ارتباط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.67,
   "end": 389.83,
   "text": "یا محل نزول ملائکه هستیم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.83,
   "end": 392.33,
   "text": "در ذاتمون یا شیاطین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 392.33,
   "end": 395.19,
   "text": "این یک امر ثابت شده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 395.19,
   "end": 397.71,
   "text": "که در شب قدر این شدت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.71,
   "end": 401.05,
   "text": "ما باید تمرین کنیم در این ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.05,
   "end": 405.99,
   "text": "خصوصاً در ایام ماه مبارک رمضان ارتباطمون رو با ملائکه قوی کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.99,
   "end": 409.43,
   "text": "که اون که می‌فرمود ملا-- اون که می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.43,
   "end": 415.03,
   "text": "کرامل کاتبین اینو رو خوب دقت کنید آخرین صحبتم باشه اگرچه این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 415.03,
   "end": 419.89,
   "text": "نپخته موند انشاالله روزهای بعد که اصلاً حالا رابطه بین ملائکه با اون روح چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 419.89,
   "end": 423.03,
   "text": "اصلاً روح چیه؟ تنزل الملائکه و الروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.03,
   "end": 424.67,
   "text": "اینا خیلی خوبه ما بدونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 424.67,
   "end": 426.81,
   "text": "ارتباط داریم با این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.81,
   "end": 430.33,
   "text": "ما ارتباط وجودی، ربط وجودی با این‌ها داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.33,
   "end": 435.67,
   "text": "حالا س-- این، اینو توجه بفرمایید کرامل کاتبین چیکار می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.67,
   "end": 439.75,
   "text": "اصلاً موضوع کرامل کاتبین که هم ملائکت الله‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.75,
   "end": 441.97,
   "text": "می‌شود نقشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.97,
   "end": 445.67,
   "text": "ملک و فرشته به نفس من و تو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.67,
   "end": 447.83,
   "text": "اون نقش، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.83,
   "end": 451.25,
   "text": "اثری که فرشته در نفس من و تو می‌گذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.25,
   "end": 453.87,
   "text": "می‌شه ک-ک-کار کرامل کاتبین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.87,
   "end": 459.79,
   "text": "در حقیقت ثبت اعمال می‌شه نقوشی که ملائکه دارن بر نفس ما می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.79,
   "end": 463.27,
   "text": "که اگر جای این ملائکه با شیاطین عوض بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.27,
   "end": 465.87,
   "text": "می‌شه نقوشی که شیاطین به نفس ما زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 465.87,
   "end": 471.51,
   "text": "این می‌شه ثبت اعمال. بعد اون موقع معلوم می‌شه ما وجودمون بهشته یا جهنمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.51,
   "end": 476.35,
   "text": "انشاالله عاقبتمون ختم بخیر باشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.35,
   "end": 479.29,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 479.29,
   "end": 481.47,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 481.47,
   "end": 484.33,
   "text": "محمد. الله اکبر، الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.33,
   "end": 488.27,
   "text": "اشهد ان لا اله الا الله. اشهد ان محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}