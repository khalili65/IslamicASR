 },
 "chapters": [
  {
   "index": 0,
   "title": "السلام علیک ای داعیَ الله و ربّانیَّ آیاته.",
   "start": 10.06,
   "end": 103.32
  },
  {
   "index": 1,
   "title": "## فصلِ دهمِ قیصری؛ روحِ اعظم",
   "start": 103.32,
   "end": 160.82
  },
  {
   "index": 2,
   "title": "## ربّ؛ کانالِ وجودی با حقیقتِ عالم",
   "start": 160.82,
   "end": 401.26
  },
  {
   "index": 3,
   "title": "## کنهِ روحِ اعظم و ربِّ پیامبر",
   "start": 401.26,
   "end": 496.72
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.18,
   "end": 4.0,
   "text": "السلام علیک ای داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.0,
   "end": 10.06,
   "text": "و ربانی ایاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.06,
   "end": 13.78,
   "text": "بحث ما پیرامون ارتباط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.78,
   "end": 22.3,
   "text": "ما در ماه مبارک رمضان با ملائکه بود که عرض کردیم این شده‌نیست و داره می‌شه اگرچه ما بی‌خبریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.3,
   "end": 26.1,
   "text": "و از درون‌مایه‌های این ماه همین است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.1,
   "end": 31.56,
   "text": "که تنزل الملائکه والروح تصریح بر همین قصه داره در این ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.56,
   "end": 35.54,
   "text": "حالا خدا رحمت کنه از to استاد علامه حسنزاده رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.54,
   "end": 38.72,
   "text": "ایشون خیلی تأکید داشتن که حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.72,
   "end": 42.06,
   "text": "یک دور قرآن رو ختم کنید پیرامون روح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.06,
   "end": 44.52,
   "text": "کلمه روح که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.52,
   "end": 48.26,
   "text": "کجاهای قرآن پیرامون روح سخن گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.26,
   "end": 50.8,
   "text": "و از اون هم در ما هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.8,
   "end": 53.22,
   "text": "نفخت فیهم روحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.22,
   "end": 55.24,
   "text": "یا یه جا این آیه قرآن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.24,
   "end": 58.92,
   "text": "ما از روح خودمون در او نفخ کردیم، دمیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.92,
   "end": 63.92,
   "text": "یا یسألونك عن الروح قل الروح من امر ربی این آیه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.92,
   "end": 69.3,
   "text": "که از تو سؤال می‌کنند در خصوص روح بگو این از امر پروردگار منه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.3,
   "end": 73.72,
   "text": "یا كذلك أوحينا إليك الروح من أمرنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.72,
   "end": 77.36,
   "text": "این چنین ما بر تو وحی کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.36,
   "end": 80.66,
   "text": "که توسط یک روحی امرمون به تو رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.66,
   "end": 82.64,
   "text": "حالا این روح کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.64,
   "end": 91.06,
   "text": "چیه؟ که از خصوصیات ماه مبارک رمضان به خصوص لیلة القدر نزول این روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.06,
   "end": 100.16,
   "text": "اجازه بدید که خب چند تا وجه داره این بحث خیلی هم بحث شیرین و خوب و مبسوط و البته سنگینیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.16,
   "end": 103.32,
   "text": "و من توقع ندارم که همه عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.32,
   "end": 107.62,
   "text": "حوصله شنیدن اون رو داشته باشن برای همین منم خیلی بهش ورود نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.62,
   "end": 111.82,
   "text": "کلیتی عرض می‌کنم اما اگر کسی دوست داشت بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.82,
   "end": 113.98,
   "text": "به مداخل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.98,
   "end": 118.54,
   "text": "شر-- مدخلی که علامه قیسری بر فصوص ابن عربی نوشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.54,
   "end": 121.24,
   "text": "خصوصاً مدخل دهم به بعد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.24,
   "end": 125.84,
   "text": "اونجا خیلی بحث مبسوطی داره علامه هم شرح قشنگی دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.84,
   "end": 128.94,
   "text": "اجازه بفرمایید همون مدخل دهم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.94,
   "end": 136.48,
   "text": "که علامه قیسری پیرامون حقیقت روح بیان کرده بر اساس روایت و آیات؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.48,
   "end": 140.6,
   "text": "من اینو بیان کنم به اختصار البته اجمالاً توضیح بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.6,
   "end": 145.32,
   "text": "می‌فرماید الفصل العاشر في بيان الروح الأعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.32,
   "end": 148.7,
   "text": "و مراتبِهِ و أسماءه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.7,
   "end": 152.3,
   "text": "اینو قبل از این که این فصل رو بخونم ابتداش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.3,
   "end": 157.0,
   "text": "بدونید که همونطور که قبلاً فهم، فهمیدیم و متوجه شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.0,
   "end": 162.76,
   "text": "ملائکه آن‌فہ آن بر ما دارن نازل می‌شن و هر حقیقتی در ما متمثل می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.76,
   "end": 167.0,
   "text": "چیزی رو ما می‌چشیم، می‌فهمیم، به حقیقتی می‌رسیم، کار ملائکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.0,
   "end": 173.52,
   "text": "نزول ملک رخ داده لکن نزول ملک در این وضعیت نزول تشریعی نیست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.52,
   "end": 177.58,
   "text": "اون دیگه بر م-- بر انبیا بود و تمام شد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.58,
   "end": 184.24,
   "text": "اما این حقیقت ادامه داره که ملائکه حالا چه از الوهیت بگیریم ملک رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.24,
   "end": 188.18,
   "text": "چه از ملک به هر حال معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.18,
   "end": 190.32,
   "text": "تدبیر و سلطنت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.32,
   "end": 192.2,
   "text": "اینا مدبرات عالم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.2,
   "end": 196.04,
   "text": "تو قرآن میگه والمدبرات أمرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.04,
   "end": 198.98,
   "text": "و اینها تدبیر می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.98,
   "end": 201.16,
   "text": "احکام خلق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.16,
   "end": 205.78,
   "text": "به خصوص انسان رو که ما ارتباط داریم با این ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.78,
   "end": 208.26,
   "text": "اما با روح اعظم کی ارتباط داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.26,
   "end": 215.38,
   "text": "آیا اون روحی که تنزل الملائکه والروح خب ما با ملائکه ارتباط داریم اونا با ما مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.38,
   "end": 217.44,
   "text": "خب اما روح چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.44,
   "end": 219.82,
   "text": "آیا با روح هم ارتباط داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.82,
   "end": 222.48,
   "text": "اینجا علامه می‌فرماید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.48,
   "end": 224.62,
   "text": "در ادامه همین فصل عاشر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.62,
   "end": 230.16,
   "text": "اعلم بدون أن الروح الأعظم الذي في الحقيقة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.16,
   "end": 232.5,
   "text": "حقیقت این روح اعظم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.5,
   "end": 236.36,
   "text": "هو الروح الإنساني این روح انسانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.36,
   "end": 238.94,
   "text": "مظهر ذات الإلهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.94,
   "end": 242.7,
   "text": "من حيث ربوبیتها مظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.7,
   "end": 244.98,
   "text": "ذات الله. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.98,
   "end": 250.9,
   "text": "خیلی پس عظمت داره. یه جا بهش میگن روح اعظم، یه جا بهش میگن روح القدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.9,
   "end": 254.22,
   "text": "حالا روایات، آیات زیاد تصریح دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.22,
   "end": 260.18,
   "text": "این مظهر الله. الله هم من-- به منظور حالا الله خودش یک اسمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.18,
   "end": 264.88,
   "text": "اسم البته مستجمع جمع اسماء نه اسمی که مثلاً بگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.88,
   "end": 268.3,
   "text": "خدا اسم خداست. یزدان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.3,
   "end": 271.12,
   "text": "دیو، نمی‌دونم تاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.12,
   "end": 274.84,
   "text": "این اسماء نه. اون اسمایی که در کارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.84,
   "end": 278.8,
   "text": "یعنی اون اسمایی که دارن پیاده می‌شن در نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.8,
   "end": 284.46,
   "text": "حالا بعد چون قبلاً اینجا در خصوص اسماء الهی صحبت کردیم، دیگه الان اینجا چیزی نمیگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.46,
   "end": 287.14,
   "text": "می‌دونید منظور از این اسم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.14,
   "end": 292.18,
   "text": "م-- در الله یا الوهت ربوبیت خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.18,
   "end": 296.2,
   "text": "رب، پرورش‌دهنده، تدبیر کننده عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.2,
   "end": 298.48,
   "text": "همه ما ربی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.48,
   "end": 301.1,
   "text": "سبحان ربی الأعلى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.1,
   "end": 303.8,
   "text": "سبحان ربی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 303.8,
   "end": 306.2,
   "text": "ربی، ربی. همه ما ربی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 306.2,
   "end": 308.62,
   "text": "اون رب حصه وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.62,
   "end": 314.4,
   "text": "کانال وجودی ما با حقیقت عالمه که بهش میگن الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.4,
   "end": 318.6,
   "text": "اون که اسم اعظم وجود ماست، رب ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.6,
   "end": 325.76,
   "text": "و ما از اون طریق با دریای لایتناهی وجود و وجود اصمد حضرت حق ارتباط داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.76,
   "end": 334.28,
   "text": "خ-- حضرت پیغمبر عزیز عالم و انسان کامل که الان با ن-- در نشئه عنصری و طبیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.28,
   "end": 338.06,
   "text": "حضرت حجت با بدن عنصری حاضره به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 338.06,
   "end": 342.16,
   "text": "انسان کامل. این‌ها به ج-- این‌ها هم رب دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.16,
   "end": 347.08,
   "text": "این‌ها هم اون رب و حصه وجودی و اسم اعظم وجودی‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.08,
   "end": 351.74,
   "text": "می‌شه همین روح اعظم. پس تا الان اینجا متوجه شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.74,
   "end": 355.48,
   "text": "که اون روح اعظم هم که نازل می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.48,
   "end": 360.18,
   "text": "اولاً این روح اعظم ارتباطش با انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.18,
   "end": 364.64,
   "text": "لذا امام باقر علیه‌السلام همونطور که عرض کردیم فرمود با دشمنان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 364.64,
   "end": 367.68,
   "text": "مخالفین ما محاجه کنید با سوره قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.68,
   "end": 369.7,
   "text": "که ما همینجوری تند تند توتی واری می‌خونیم می‌ریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.7,
   "end": 372.48,
   "text": "\"این تنزل الملائكة والروح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 372.48,
   "end": 375.32,
   "text": "خب ملائکه که آنفاً با انسان‌ها مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 375.32,
   "end": 379.2,
   "text": "درست رد و فتح و اموره. اما این روح چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.2,
   "end": 382.8,
   "text": "این روح مگر بر انسان کامل نازل نمی‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 382.8,
   "end": 388.88,
   "text": "کو انسان کامل؟ همه فریقین هم قبول دارند که لیلة القدر همه ساله تکرار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.88,
   "end": 392.04,
   "text": "پس انسان کامل هست. چرا شما می‌گید نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.04,
   "end": 394.06,
   "text": "یا مرده یا قراره بعداً بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.06,
   "end": 396.69,
   "text": "خیلی دلیل قشنگ و محاجه زیبائیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.69,
   "end": 398.86,
   "text": "این قسمت رو براتون بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.86,
   "end": 401.26,
   "text": "که حالا اینجا بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.26,
   "end": 403.78,
   "text": "علامه قیصری می‌فرماید \"لا يعلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 403.78,
   "end": 408.84,
   "text": "كنها إلا الله\". كنها ذات این روح اعظم را جز خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.84,
   "end": 411.54,
   "text": "نمی‌داند که این اسم اعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.54,
   "end": 414.32,
   "text": "وجود پیغمبر رب پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.32,
   "end": 419.36,
   "text": "و چه شیرین قرآن می‌فرماید \"و ان الى ربك المنتهى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.36,
   "end": 423.12,
   "text": "اون ربی که همه به سمت اون دارن حرکت می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.12,
   "end": 425.3,
   "text": "\"ربك المنتهى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 425.3,
   "end": 427.58,
   "text": "اون رب توئه پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.58,
   "end": 429.68,
   "text": "همه ما رب داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.68,
   "end": 434.66,
   "text": "و با اون ربمون ارتباط با حقیقت عالم و حضرت حق داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 434.66,
   "end": 437.68,
   "text": "همه این‌ها در طول رب پیغمبر‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.68,
   "end": 441.26,
   "text": "که اسم اعظم پیغمبر و همه دارن میرن که به اون رب برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.26,
   "end": 445.46,
   "text": "به رب پیغمبر برسن. اون همون روح ال-- روح اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 445.46,
   "end": 448.54,
   "text": "همون روح القدسه که شب قدر نازل می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 448.54,
   "end": 452.64,
   "text": "و هرچی که چه در عالم کبیر یعنی عالم بیرون از ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.64,
   "end": 455.52,
   "text": "عالم نظام هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.52,
   "end": 460.92,
   "text": "نظام افقی و چه در عالم صغیر که در وجود خود ما هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 460.92,
   "end": 464.14,
   "text": "ایشون یعنی روح اعظم مظهر دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.14,
   "end": 470.3,
   "text": "حالا این مظهر روح اعظم در عالم خارج از ما یعنی نشئه طبیعت و همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.3,
   "end": 476.36,
   "text": "عوالم هستی برو تا ملکوت و برو تا جبروت و لاهوت و عرش و فوق عرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 476.36,
   "end": 480.18,
   "text": "مظهر داره یعنی محل ظهور داره روح اعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 480.18,
   "end": 482.74,
   "text": "در خود ما هم محل ظهور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 482.74,
   "end": 487.68,
   "text": "حالا ما ارتباط باهاش نداریم اما در ما محل ظهور دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 487.68,
   "end": 490.58,
   "text": "این چگونه است؟ اجازه بدید بعداً انشاالله بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 490.58,
   "end": 496.72,
   "text": "انشاالله که عاقبتمون ختم بخیر بشود به برکت صلوات بر محمد و آل محمد. اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}