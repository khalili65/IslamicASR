   "title": "## روزهٔ مادر شیرده؛ ضرر به کودک",
   "start": 0.3,
   "end": 32.54
  },
  {
   "index": 1,
   "title": "## روزه و بستن مجرای نفوذ شیطان",
   "start": 32.54,
   "end": 176.84
  },
  {
   "index": 2,
   "title": "## قوای چهارگانه؛ وهم عقل ساقط‌شده",
   "start": 176.84,
   "end": 450.82
  },
  {
   "index": 3,
   "title": "## از وهم تا حس؛ فرمول گناه",
   "start": 450.82,
   "end": 539.9
  },
  {
   "index": 4,
   "title": "## عظمت روزه؛ بستن مجرا و بازگشت به عقل",
   "start": 539.9,
   "end": 593.16
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 2.54,
   "text": "[سخنگوی 1] و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.54,
   "end": 6.4,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.4,
   "end": 9.32,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.32,
   "end": 14.24,
   "text": "[سخنگوی 1] استفتا شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.24,
   "end": 19.94,
   "text": "اگر زنی که شیر میده به بچه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.94,
   "end": 23.62,
   "text": "بچه‌ش خب نیاز به شیر داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.62,
   "end": 27.96,
   "text": "و اگر شیر نخوره قطعاً این بچه تلف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.96,
   "end": 33.9,
   "text": "مادر بر اثر روزه داری شیرش کم میشه یا خشک میشه یکی از این دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.9,
   "end": 37.56,
   "text": "و این محرزه. اما حال مادر خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.56,
   "end": 41.78,
   "text": "دقت کنید مادر هیچ مشکلی از جهت جسمی نداره روزه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.78,
   "end": 44.58,
   "text": "قشنگ توانشو داره، مریضی هم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.58,
   "end": 47.78,
   "text": "این ضرر متوجه بچه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.78,
   "end": 50.54,
   "text": "آیا برای او روزه گرفتن جایزه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.54,
   "end": 53.14,
   "text": "رهبر فرمودن اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.14,
   "end": 59.48,
   "text": "ضرری از این حیث به بچه وارد میشه، روزه بر او واجب نیست و افطار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.48,
   "end": 61.32,
   "text": "واجبه براش. روزه‌ش حرامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.32,
   "end": 64.14,
   "text": "باید ب-بگیره بعداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.14,
   "end": 67.04,
   "text": "این عذر که رفت شد اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.04,
   "end": 71.24,
   "text": "روزه‌شو قضا کنه. خب ما یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.24,
   "end": 77.74,
   "text": "بحث‌هایی که پیرامون اسرار روزه داشتیم و از بحث‌های بسیار مهم و دقیق بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.74,
   "end": 83.72,
   "text": "یه ذره اینو بسطش بدیم، این بود که عرض کردیم مجرای ورود شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.72,
   "end": 86.4,
   "text": "به وجود انسان رو روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.4,
   "end": 89.96,
   "text": "می‌بنده. در حقیقت درب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.96,
   "end": 96.0,
   "text": "نفوذ رو می‌بنده. چطور الان رهبر عزیزمون می‌فرما تو مملکت متأسفانه تو جای جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.0,
   "end": 101.6,
   "text": "کشور ما، تو اداره‌هات، نهادها، همه جا نفوذ کرده دشمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.6,
   "end": 108.72,
   "text": "شیطان هم در بافت‌ها و اعضای بدن جزء جزء اعضای بدن می‌تونه نفوذ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.72,
   "end": 111.86,
   "text": "روزه می‌تونه این راه نفوذ شیطان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.86,
   "end": 114.36,
   "text": "دشمن رو به درون ببنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.36,
   "end": 119.24,
   "text": "این رو عرض کردیم. حالا این که شیطان رو چی فرض کنی خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.24,
   "end": 121.18,
   "text": "خلاصه شیطان چی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.18,
   "end": 124.78,
   "text": "یک وجود خارجیه یا در درون خود منه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.78,
   "end": 128.72,
   "text": "عالم بالا است، عالم اصلاً مربوط به دنیاست، ملکوتیه، چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.72,
   "end": 132.78,
   "text": "مجرده. اینا یه بحث‌های مبسوط و مفصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.78,
   "end": 134.88,
   "text": "در کتاب‌های متعدد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.88,
   "end": 138.58,
   "text": "مثلاً شیخ اکبر ماییدین در کتاب فصوصش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.58,
   "end": 141.4,
   "text": "بحث مفصلی اینجا دارن. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.4,
   "end": 143.54,
   "text": "عیون مسائل نفس یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.54,
   "end": 146.72,
   "text": "سر حل عیونشون علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.72,
   "end": 149.68,
   "text": "مسائل مبسوطی رو دارن. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.68,
   "end": 152.92,
   "text": "عرض شود جامی در کتابشون داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 152.92,
   "end": 157.36,
   "text": "کتاب‌های مثلاً مرحوم قیسری در شرح فصوص الحکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 157.36,
   "end": 159.36,
   "text": "کتاب‌های زیادی تو این زمینه هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 159.36,
   "end": 164.6,
   "text": "می‌تونی اصفار ملاصدرا مطالب بسیار جالب و قشنگی پیرامون این داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.6,
   "end": 171.76,
   "text": "من یه چند وجهشو به مناسبت این چند روز عرض می‌کنم که یه ذره بشناسیم چون دشمن شناسی خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.76,
   "end": 173.86,
   "text": "اگه نشناسیم این کیه، چیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 173.86,
   "end": 179.54,
   "text": "به مشکل بر می‌خوریم. دقت بفرمایید که در حکمت مشاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 179.54,
   "end": 183.94,
   "text": "می‌فرمایند که قوای وجودی انسان من سریع میگم میرم دیگه جا نمونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.94,
   "end": 189.54,
   "text": "قوای وجودی انسان چهارگانه اند: حس و خیال و وهم و عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.54,
   "end": 192.48,
   "text": "اینو همه شنیدید. لکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 192.48,
   "end": 194.7,
   "text": "در حکمت متعالیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.7,
   "end": 197.66,
   "text": "معتقدند مثلاً خود علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.66,
   "end": 200.3,
   "text": "در سی و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 200.3,
   "end": 206.7,
   "text": "مسائل حالا اون عیون مسائل نفسشون قسمت سی و یکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.7,
   "end": 209.92,
   "text": "بله، قسمت سی و یکمشون این رو شرح میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.92,
   "end": 214.98,
   "text": "و می‌فرمایند که از نظر حکمت متعالیه وهم هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 214.98,
   "end": 218.04,
   "text": "لکن وهم عقل ساقط شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 218.04,
   "end": 222.48,
   "text": "یعنی اگر عقل، عقل رهایی داره دیگه، اطلاق داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 222.48,
   "end": 224.48,
   "text": "عقل کلیات رو درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 224.48,
   "end": 226.82,
   "text": "اصلاً وارد جزئیات نمی‌شه. رهاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 226.82,
   "end": 231.54,
   "text": "از قید و بندها آزاده. لذا کسی که عاقلانه زندگی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 231.54,
   "end": 233.94,
   "text": "از قید و بندها و تعیینات رها میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 233.94,
   "end": 237.16,
   "text": "به سرح، به مقام سرح اصطلاحی اصطلاحاً میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 237.16,
   "end": 239.84,
   "text": "رها میشه، شاهد بر عالم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 239.84,
   "end": 242.28,
   "text": "شهید ما معتقدیم با عقلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 242.28,
   "end": 246.7,
   "text": "به عقلش دست پیدا می‌کنه که شهید میشه، رها میشه، مستقل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 246.7,
   "end": 248.74,
   "text": "حالا این رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 248.74,
   "end": 251.24,
   "text": "علامه حسن زاده می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 251.24,
   "end": 254.98,
   "text": "وقتی که عقل از کارکرد خودش خارج شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 254.98,
   "end": 259.5,
   "text": "اون رهایی‌ش به قید تبدیل شد، میشه وهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 259.5,
   "end": 261.52,
   "text": "وهم جزئیات رو درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 261.52,
   "end": 266.72,
   "text": "میره سراغ جزئیات، اصول، امهات و کلیات رو رها می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 266.72,
   "end": 271.76,
   "text": "دیدی بعضیا گیر میدن به یه سری چیزای جزئی که اصلاً خیلی هم مهم نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 271.76,
   "end": 273.56,
   "text": "اون موقع مشکل میشه زندگیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 273.56,
   "end": 275.76,
   "text": "چیزهای ریز براش درشت جلوه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 275.76,
   "end": 278.98,
   "text": "مشکلاتش چنان مثل کوه رو دوشش می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 278.98,
   "end": 281.24,
   "text": "چرا؟ از دایره عقل خارج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 281.24,
   "end": 286.8,
   "text": "بعد اینو دقت بفرمایید. اولین نظریه‌ای که پیا-پیرامون ماهیت شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 286.8,
   "end": 291.14,
   "text": "وجود داره این نظریه‌ست که میگن وهم همون شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 291.14,
   "end": 296.0,
   "text": "قوه واهمه وجود ما همون شیطانه که همه اینو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 296.0,
   "end": 302.54,
   "text": "تو همه هست که پیغمبر هم فرمود من این شیطان وجودم رو مسلمون کردم یا تسلیم کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 302.54,
   "end": 305.56,
   "text": "ادبش کردم. حالا این وهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 305.56,
   "end": 308.02,
   "text": "جزئیات رو درک می‌کنه. یه توضیح کوچولو بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 308.02,
   "end": 311.6,
   "text": "خیلی این خوبه آدم بدونه. عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 311.6,
   "end": 313.42,
   "text": "عقل کلیات رو درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 313.42,
   "end": 316.58,
   "text": "یعنی چی؟ آقا جان زیبایی خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 316.58,
   "end": 318.82,
   "text": "بله خب خیلی خوبه. قدرت خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 318.82,
   "end": 320.8,
   "text": "لباس پوشیدن خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 320.8,
   "end": 323.36,
   "text": "اصلاً از مهماته که انسان پوشیده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 323.36,
   "end": 325.28,
   "text": "اینا رو عقل کاملاً درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 325.28,
   "end": 330.74,
   "text": "همه هم اینا رو می‌پذیرن. اصلاً فطرت بشر، عقل بشر با عریانی ناسازگاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 330.74,
   "end": 333.88,
   "text": "عریانی رو زشت می‌دونه، پست می‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 333.88,
   "end": 335.98,
   "text": "مگر فطرتش رو منسوخ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 335.98,
   "end": 339.92,
   "text": "خب حالا که عقل کلیات رو درک می‌کنه اشکال از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 339.92,
   "end": 342.66,
   "text": "اشکال از اونجاست که میره این به جزئیات می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 342.66,
   "end": 344.74,
   "text": "یعنی عقل ساقط بشه به وهم می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 344.74,
   "end": 347.2,
   "text": "یعنی شیطنت. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 347.2,
   "end": 352.3,
   "text": "یعنی میره خب تو، تو جزئیات می‌گرده این لباس قشنگ کدومه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 352.3,
   "end": 355.38,
   "text": "آقا لباس قشنگ خوبه. رنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 355.38,
   "end": 357.94,
   "text": "زیبا خوبه. چشم نواز خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 357.94,
   "end": 360.58,
   "text": "عطر خوبه. زیبایی اصلاً خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 360.58,
   "end": 365.62,
   "text": "درست شد؟ اما حالا کدوم یکی از این‌ها اون لباس قشنگه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 365.62,
   "end": 368.12,
   "text": "تو جزئیات که میره شیطان میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 368.12,
   "end": 370.16,
   "text": "یعنی همون وهم. یعنی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 370.16,
   "end": 372.86,
   "text": "میگه این، این، این، این، این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 372.86,
   "end": 375.6,
   "text": "میشه همون وهم. عقل کلی رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 375.6,
   "end": 379.2,
   "text": "لباس پوشیدن خیلی خوبه. از ضروریات فطری بشره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 379.2,
   "end": 383.5,
   "text": "اما اینکه این لباس، لباس زیبائه زیبایی هم که قشنگه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 383.5,
   "end": 386.04,
   "text": "الله جميل و يحب الجمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 386.04,
   "end": 390.78,
   "text": "این جمال تو کدوم یک از این لباس‌ها جلوه کرده اینجا گیر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 390.78,
   "end": 395.28,
   "text": "اینجا اشکال پیش میاد. این همون شیطنت وجوده که این لباس، اون لباس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 395.28,
   "end": 398.32,
   "text": "میره سراغ کثرات. توجه کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 398.32,
   "end": 403.96,
   "text": "یا زیبایی‌ها. عقل میگه خوردن خوبه آدم باید بخوره تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 403.96,
   "end": 406.62,
   "text": "سالم بمونه. وهم میاد میگه این غذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 406.62,
   "end": 409.02,
   "text": "چلو کباب، بوقلمون نمیدونم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 409.02,
   "end": 413.8,
   "text": "یکی، یکی میره تو انتخاب. این‌ها این مصادیق میشه وهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 413.8,
   "end": 417.46,
   "text": "عقل کلی رو میگه. وهم میاد میگه این، این غذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 417.46,
   "end": 420.6,
   "text": "حالا بعد تو مرتبه نازل‌ترش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 420.6,
   "end": 426.3,
   "text": "تنزل پیدا کرده‌ش خیال و قوه خیال قبلاً بحث کردیم که قوه عکس برداریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 426.3,
   "end": 429.62,
   "text": "حالا اونچه که وهم جزئی‌ش کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 429.62,
   "end": 431.66,
   "text": "عقل میاد بهش نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 431.66,
   "end": 433.94,
   "text": "میگه خب آقای وهم ببخشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 433.94,
   "end": 437.14,
   "text": "خیال. قوه خیال میاد به وهم نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 437.14,
   "end": 439.12,
   "text": "اون جزئی شده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 439.12,
   "end": 441.24,
   "text": "قوه خیال عکسشو بهش نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 441.24,
   "end": 446.08,
   "text": "میگه این عکس اون لباسی که تو خوشت میومدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 446.08,
   "end": 448.56,
   "text": "این بوی اون عطریه که تو خوشت میادا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 448.56,
   "end": 452.16,
   "text": "آقا عقل یه مثال دیگه. عقل میگه ازدواج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 452.16,
   "end": 454.46,
   "text": "نیاز فطری بشره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 454.46,
   "end": 459.3,
   "text": "درست شد؟ حتی اگر برای ایجاد صورت انسانین تو نگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 459.3,
   "end": 464.8,
   "text": "حتی برای اطفاء شهوت حیوانی هم بگیری باز نیاز فطری بشر ازدواج هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 464.8,
   "end": 467.68,
   "text": "که نازل‌ترین نگاه به ازدواجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 467.68,
   "end": 470.92,
   "text": "حالا که این هست عقل این رو می‌پذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 470.92,
   "end": 472.54,
   "text": "اما وهم چی کار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 472.54,
   "end": 476.08,
   "text": "میگه خب حالا تو بخوای ازدواج کنی با کی ازدواج کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 476.08,
   "end": 482.78,
   "text": "میای سراغ جزئیات. با این زن، با اون زن، با این مشکل، با این خصوصیات، با این مرد، با این مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 482.78,
   "end": 485.78,
   "text": "حالا این صورت ظاهری‌شو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 485.78,
   "end": 489.96,
   "text": "صورت بیرونیش رو در نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 489.96,
   "end": 493.42,
   "text": "عالم خیال تو به تو صورت‌گری می‌کنه نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 493.42,
   "end": 496.78,
   "text": "گاهی اوقات تو خیال، گاهی اوقات تو بیرون از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 496.78,
   "end": 498.82,
   "text": "میگه این همون زنیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 498.82,
   "end": 502.26,
   "text": "مطلوب توئه. این همون مردیه که مطلوب توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 502.26,
   "end": 506.3,
   "text": "این شیطنت‌هاست. حالا خدا رحم کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 506.3,
   "end": 509.08,
   "text": "این زنجیر بکشه به بحث حس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 509.08,
   "end": 511.22,
   "text": "که دیگه اولین و نازل‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 511.22,
   "end": 512.88,
   "text": "قوای وجودی انسان حسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 512.88,
   "end": 515.38,
   "text": "حس مشترک یا حواس پنج گانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 515.38,
   "end": 519.56,
   "text": "که بخوای اون کلی عقل و جزئی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 519.56,
   "end": 525.7,
   "text": "در وهم و و صورت‌گری شده در قوه خیال و که این زن مطلوب توئه رو بخوای چیکار کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 525.7,
   "end": 528.72,
   "text": "حس کنی. اون موقع این میشه عملیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 528.72,
   "end": 531.38,
   "text": "این میشه گناه. این میشه عمل. این میشه زشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 531.38,
   "end": 533.38,
   "text": "این میشه مکروه. این میشه منکرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 533.38,
   "end": 535.82,
   "text": "چیز به همین راحتی این فرمول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 535.82,
   "end": 539.2,
   "text": "مشخص شد در وجود انسان چگونه این شکل می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 539.2,
   "end": 542.88,
   "text": "حالا ببینید روزه چقدر عظمت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 542.88,
   "end": 548.96,
   "text": "که پیغمبر فرموده هیچ چیزی و تمام حکما من کتاب‌ها رو بررسی کردم تو این حیس دارم به شما میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 548.96,
   "end": 554.38,
   "text": "تحقیقاً عرض می‌کنم. هیچ کدوم از حکما این نظر رو رد نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 554.38,
   "end": 558.58,
   "text": "میگن هیچی مثل جو و روزه و صوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 558.58,
   "end": 563.76,
   "text": "چی؟ این مجرای ورود اون شیطان رو تو وجود تو نمی‌بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 563.76,
   "end": 565.78,
   "text": "یعنی تو رو به عقل می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 565.78,
   "end": 568.5,
   "text": "تو رو به رهایی و اطلاق می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 568.5,
   "end": 571.94,
   "text": "به کمدن از دلبستگی‌ها و جزئیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 571.94,
   "end": 574.44,
   "text": "و چیزهای پوچ و بی‌ارزش می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 574.44,
   "end": 577.68,
   "text": "این یکی از کارکردهای اساسی روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 577.68,
   "end": 581.88,
   "text": "تو بحث جلوگیری از ورود شیطان به این نگاه به شیطانه.",
