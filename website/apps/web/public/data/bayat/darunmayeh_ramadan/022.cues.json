 "chapters": [
  {
   "index": 0,
   "title": "## مسافرت برای فرار از روزه؛ حکم شرعی",
   "start": 11.12,
   "end": 131.1
  },
  {
   "index": 1,
   "title": "## الصوم جُنّة؛ روزه سپر آتش",
   "start": 131.1,
   "end": 202.9
  },
  {
   "index": 2,
   "title": "## نفس ناطقه و آتش درون",
   "start": 202.9,
   "end": 395.84
  },
  {
   "index": 3,
   "title": "## توجه عرفانی؛ اوج با روزه",
   "start": 395.84,
   "end": 441.14
  },
  {
   "index": 4,
   "title": "## روزه و آینهٔ درون",
   "start": 441.14,
   "end": 552.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 3.12,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.12,
   "end": 8.16,
   "text": "السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.16,
   "end": 11.12,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.12,
   "end": 16.46,
   "text": "استفتا شده از رهبر عزیزمون که آیا میشه مسافرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.46,
   "end": 23.42,
   "text": "ااا حالا میشه گفت تحمیلی خودمون به خودمون تحمیل کنیم مسافرتو اجباری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.42,
   "end": 33.34,
   "text": "پاشیم بریم؟ یعنی ضرورتی نداره مسافرت ما فقط برای فرار، عین این کلمه تو استفتا اومده برای فرار از روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.34,
   "end": 37.48,
   "text": "مسافرت بریم. آیا اشکال داره این؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.48,
   "end": 45.92,
   "text": "رهبری فرمودن از جهت شرعی اشکال نداره شما حتی برای فرار از روزه مسافرت برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.92,
   "end": 50.32,
   "text": "توجه کردید از جهت شرعی بحث های عرفانی رو کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.32,
   "end": 53.8,
   "text": "لکن توجه به این داشته باشید که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.8,
   "end": 58.82,
   "text": "ااا ما قبلاً عرض کردیم که باید مسافر قصد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.82,
   "end": 66.16,
   "text": "پیمودن مسافت شرعی رو که به نظر رهبر عزیزمون بیست کیلومتر و نیم حداقل در رفت هست رو داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 66.16,
   "end": 74.02,
   "text": "بعد وقتی به محض اینکه حد ترخص رو رد کرد، هزار و سیصد و پنجاه متر از شهر اون ورتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 74.02,
   "end": 77.44,
   "text": "رسید اونجا افطار کنه نه تو وطن خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 77.44,
   "end": 80.18,
   "text": "یعنی نیت روزه میکنه. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 80.18,
   "end": 86.98,
   "text": "هیچی هم نخورده، افطار نکرده، نیت روزه رو کرده میره تا به حد ترخص رسید افطار میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 86.98,
   "end": 92.88,
   "text": "بعد اینطور هم نیست این نکته آخرین که اینطور هم نیست که حالا که افطار کرد برگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 92.88,
   "end": 95.36,
   "text": "نه این که اصلاً مسافر نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 95.36,
   "end": 98.46,
   "text": "چون باید حتماً مسافت شرعی رو بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 98.46,
   "end": 101.14,
   "text": "اون بیست کیلومتر و نیم رو حتما باید بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.14,
   "end": 104.28,
   "text": "اما از حد ترخص رد شد میتونه افطار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 104.28,
   "end": 109.14,
   "text": "یکی از راه‌های کمک کردن به بچه هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.14,
   "end": 113.56,
   "text": "توان ندارن اما به سن، به سن تکلیف رسیدن، مخصوصاً دختر بچه ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.56,
   "end": 118.32,
   "text": "نه ساله جون نداره. مخصوصاً با این سوء تغذیه امروزی ها نمیتونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.32,
   "end": 120.38,
   "text": "یه راهش اینه که ببرنشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.38,
   "end": 122.88,
   "text": "مسافرت اونجا بخوره حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 122.88,
   "end": 126.82,
   "text": "ترخص رو رد کرد بخوره حد شرعی رو هم مسافت شرعی رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.82,
   "end": 130.94,
   "text": "بره بیست کیلومتر و نیم بعد برگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.94,
   "end": 135.22,
   "text": "خب یکی از اسرار روزه رو امروز عرض کنیم که این نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.22,
   "end": 139.28,
   "text": "خیلی نکته بسیار مهمیه و باید بهش توجه کنیم و الا ضرر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.28,
   "end": 142.54,
   "text": "از جهت معنوی کم برداشت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.54,
   "end": 147.82,
   "text": "که حالا من منصرف شدم بحث رو من منصرف کردم به سمت اسرار روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.82,
   "end": 152.38,
   "text": "چند تا نکته این روزها بگیم حالا اون قلب منافق رو بعداً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.38,
   "end": 155.64,
   "text": "حاج آقا هادی سبز، سبزواری رحمة الله علیه حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.64,
   "end": 159.4,
   "text": "نبوی میارن که در کتاب شریفشون که اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.4,
   "end": 165.26,
   "text": "صوم رو بیان می‌کنند که الصوم جنة من النار روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.26,
   "end": 166.88,
   "text": "سپر است در برابر آتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.88,
   "end": 171.22,
   "text": "بعد یک بحث مبثوتی اینجا بزرگان اهل معرفت آوردن غوغاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.22,
   "end": 178.12,
   "text": "اونم نه اینکه دقت بفرمایید، نه اینکه روزه صرفاً سپر است در برابر آتش برزخ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.12,
   "end": 181.42,
   "text": "آتش دوزخ و آتش اون دنیایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.42,
   "end": 183.98,
   "text": "بلکه آتش این دنیا رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.98,
   "end": 186.66,
   "text": "که ما همین جا تهیه می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.66,
   "end": 190.6,
   "text": "چون اینجا آتش تهیه می‌شه که میره اونجا اشتباه نشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.6,
   "end": 196.02,
   "text": "همین تو همین دنیا سور-- ااا صوم یا روزه سپر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.02,
   "end": 200.08,
   "text": "چگونه؟ دقت بفرمایید توضیح کوتاهی فلسفی بدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.08,
   "end": 202.9,
   "text": "ااا که همه فهم هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.9,
   "end": 204.96,
   "text": "جسم ما، ما یک جسم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.96,
   "end": 207.8,
   "text": "این جسم طبیعیمون به راحتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.8,
   "end": 209.72,
   "text": "صورت ظاهرش رو از دست نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.72,
   "end": 212.34,
   "text": "مگه با بیماری‌های س-- خیلی سخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.34,
   "end": 214.92,
   "text": "یا دور از جونتون با موت طبیعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.92,
   "end": 218.1,
   "text": "جسم ما که این صورتی که خدا آفریده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.1,
   "end": 220.68,
   "text": "این از بین نمیره به راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.68,
   "end": 224.62,
   "text": "اما ما یک نفس ناطقه‌ای هم داریم که درون ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.62,
   "end": 229.28,
   "text": "انقدر این نفس لطیفه، انقدر نفس ناطقه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.28,
   "end": 231.64,
   "text": "مجرد جنسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.64,
   "end": 236.0,
   "text": "که به راحتی به هر چیزی رو کنه خو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.0,
   "end": 240.36,
   "text": "مثل آبی که فرض کرد-- فرض کنید مثل آبی که می‌ریزید تو هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.36,
   "end": 243.64,
   "text": "شیی می‌ریزید سریع به شکل اون شیء در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.64,
   "end": 248.92,
   "text": "نفس ناطقه انسان انقدر لطیفه، انقدر خو می‌گیره سریع با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.92,
   "end": 251.96,
   "text": "دور و بر خودش و با فعل و انفعالات و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.96,
   "end": 255.66,
   "text": "حالا این نفس اگر این نفس ناطقه انسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.66,
   "end": 257.62,
   "text": "که در درون خودمون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.62,
   "end": 262.96,
   "text": "شیطان داریم که پیغمبر فرمود من شیطان درون خودمو به دست خودم مسلمون کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.96,
   "end": 265.98,
   "text": "همه ما در درون خودمون اعدا عدو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.98,
   "end": 268.7,
   "text": "دشمن ترین دشمن‌ها در درون خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.7,
   "end": 271.46,
   "text": "حال اینکه ما بیرون دنبالش می‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.46,
   "end": 274.04,
   "text": "لذا یکی از بزرگان می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.04,
   "end": 276.8,
   "text": "من با اثاثیه منزلم گفت‌وگو کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.8,
   "end": 279.1,
   "text": "اینو همه شاید درک نکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.1,
   "end": 283.48,
   "text": "همه شاید درک نکنند چرا علامه حسن زاده وقتی غذا می‌خوره با غذا حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.48,
   "end": 286.56,
   "text": "سلامٌ علیکم برنج‌های قشنگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.56,
   "end": 290.9,
   "text": "عدس‌های زیبا، ای خرماهای شیرین، ای خلقت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.9,
   "end": 293.14,
   "text": "قدم رنجه کردید، خوش آمدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.14,
   "end": 295.78,
   "text": "گفت‌وگو می‌کنه یک ساعت با اینا حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.78,
   "end": 300.02,
   "text": "حالا اینا رو شاید من نفهمم. با اث، اثاثیه منزلش گفت‌وگو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.02,
   "end": 302.18,
   "text": "میگه به اینا گفتم آقای سماور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.18,
   "end": 304.88,
   "text": "آقای نمی‌دونم قند، آقای فرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 304.88,
   "end": 307.28,
   "text": "آقای لامپ، آقای پرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.28,
   "end": 308.98,
   "text": "همه اینا رو باهاشون گفت‌وگو کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.98,
   "end": 311.74,
   "text": "گفتم اینجا شما تو این اتاق تشریف داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.74,
   "end": 314.3,
   "text": "شما وجودید دیگه. وجود دارید شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.3,
   "end": 316.8,
   "text": "شما عدم که نیستید. وجود دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.8,
   "end": 319.04,
   "text": "حقیقت دارید. شما واقعیت دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.04,
   "end": 322.18,
   "text": "شما هستید. شما هم به نوعی یک شعوری دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 322.18,
   "end": 324.2,
   "text": "شما اینجا تشریف داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 324.2,
   "end": 325.98,
   "text": "یه چند لحظه من تو خودم باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 325.98,
   "end": 331.52,
   "text": "برم اون اتاق خودم باشم. میگه رفتم تو اون اتاق دیگه تا رسیدم اون اتاق دیدم همه اونجان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 331.52,
   "end": 334.7,
   "text": "همه اثاثیه‌هایی که باهاشون خداحافظی کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 334.7,
   "end": 339.48,
   "text": "ازشون اجازه گرفتم که بدون اونا باشم لحظاتی دیدم اونجان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 339.48,
   "end": 342.04,
   "text": "خلاصه میگه من فهمیدم که آقا جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 342.04,
   "end": 345.8,
   "text": "اصلاً ما در درون خودمون، دشمنمون در درون خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 345.8,
   "end": 349.24,
   "text": "این زواهر و این بیرون این‌ها دشمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 349.24,
   "end": 351.22,
   "text": "ااا اصلی ما نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 351.22,
   "end": 360.1,
   "text": "هرچی هست تو درون ماست. حالا اونچه که در درون ما حتی از میل‌های بیخودی شاید شهوانی نباشه، غضب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 360.1,
   "end": 364.22,
   "text": "آلود نباشه اما میل بیخوده، میل‌های بیخود، این‌ها هم آتشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 364.22,
   "end": 366.62,
   "text": "در درون خودمون ما آتش داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 366.62,
   "end": 369.92,
   "text": "لذا اگر کسی چشم برزخی‌ش باز شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 369.92,
   "end": 372.94,
   "text": "همین اینجا خودش رو می‌بینه چه شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 372.94,
   "end": 375.38,
   "text": "اصلا نیاز نداره منتظر اونجا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 375.38,
   "end": 377.74,
   "text": "قیامت هم میگه \"اقرأ كتابك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 377.74,
   "end": 381.3,
   "text": "قرآنه دیگه. بخون کتابتو \"کفى بربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 381.3,
   "end": 383.84,
   "text": "بنفسك اليوم عليك حسيبا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 383.84,
   "end": 386.02,
   "text": "خودت بسی برای حسابرسی خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 386.02,
   "end": 388.42,
   "text": "چرا میگه؟ چون خودت خودتو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 388.42,
   "end": 394.9,
   "text": "اونجا پرده‌ها میره کنار قشنگgg چهره واقعی خودت رو می‌بینی که نفس ناطقه تو به چه شکلی دراومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 394.9,
   "end": 401.6,
   "text": "حالا یه قدرتی خدای منان در انسان قرار داده که دیروز ما عرض کردیم تذکراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 401.6,
   "end": 404.68,
   "text": "که با روزه این قدرت تقویت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 404.68,
   "end": 408.0,
   "text": "هیچ عبادتی مثل روزه این قدرت رو تقویت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 408.0,
   "end": 410.38,
   "text": "بهش میگن توجه عرفانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 410.38,
   "end": 417.8,
   "text": "همون حس حضور. توجه عرفانی با روزه به شدت زیاد می‌شه، به اوج خودش می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 417.8,
   "end": 420.54,
   "text": "چون ما هرچی می‌کشیم از همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 420.54,
   "end": 423.12,
   "text": "خوردن‌هاست از اکول بودنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 423.12,
   "end": 430.72,
   "text": "همش بخور، همش. گرفتاری ما از این مس-مسائل نفسانی و هواها و این‌هاست که وقتی روزه می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 430.72,
   "end": 434.6,
   "text": "مثل یک سپر از همه این آتش‌ها ما رو حفظ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 434.6,
   "end": 441.14,
   "text": "روزه باعث می‌شه اون توجه نفسانی تو زیاد بشه و بزرگان فرمودن اون آینه‌ای که در درون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 441.14,
   "end": 446.74,
   "text": "توئه و تو می‌تونی از درونش خودت رو ببینی که چه شکلی هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.74,
   "end": 448.68,
   "text": "همین توجه نفسانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 448.68,
   "end": 452.14,
   "text": "همین توجه عرفانی‌ست که با روزه به اوج می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 452.14,
   "end": 457.12,
   "text": "البته باید با مراقبه و محاسبه شروع بشه اما روزه اینو به اوج می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 457.12,
   "end": 461.66,
   "text": "یکی از اسرار روزه که خدا فرموده مال منه \"من الصوم لي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 461.66,
   "end": 467.62,
   "text": "و من جزاشو میدم یا اون چیزی که بهش جزا میدن منم، منو به روزه دار جزا میدن اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 467.62,
   "end": 470.12,
   "text": "چون تمام امیالش رو میذاره کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 470.12,
   "end": 472.9,
   "text": "این چیز کمی نیست. این یکی از اسرارش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 472.9,
   "end": 480.46,
   "text": "که به هر حال اگر ما چشممون باز شه علم الهدی سنزده در-- برید بخونید در کتاب هزار و یک نکته‌شون نکته ده به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.46,
   "end": 483.02,
   "text": "زیبا و قشنگ توضیح داده که ما نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 483.02,
   "end": 489.0,
   "text": "ولی یه دروغ ولو به شوخی میگی، به شوخی هم دروغ میگی همون لحظه نفست زشت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 489.0,
   "end": 494.04,
   "text": "کج و معوج می‌شه. هیچی هم مثل دروغ آدم رو کج و معوج نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 494.04,
   "end": 499.84,
   "text": "یکی از بزرگان می‌گفتش که پسرم که از دنیا رفته بود، یه پسر خیلی پاک و متحری داشت، خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 499.84,
   "end": 506.44,
   "text": "با صفا، اهل سحر، رفته بود میگفت هر وقت که پسرم رو زیارت می‌کنم در عالم معنا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 506.44,
   "end": 510.62,
   "text": "پسرم بهم میگه بابا بعضی موقع‌ها ما از این عالم تو رو می‌بینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 510.62,
   "end": 512.52,
   "text": "به شدت نورانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 512.52,
   "end": 519.58,
   "text": "انقدر نفست نورانیه که چشم ما رو می‌زنه و بعضی موقع‌ها بالعکس نگات می‌کنیم، همون بابایی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.58,
   "end": 522.02,
   "text": "اما تاریکی. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 522.02,
   "end": 528.58,
   "text": "با چی ایجاد می‌شه؟ با همین امیال، همین شهوات، همین غضب‌ها که روزه بهترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 528.58,
   "end": 531.54,
   "text": "سپر برای نجات از این چیاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 531.54,
   "end": 534.92,
   "text": "از این آتش‌هاست. نکته دوم هم تو دل بحث بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 534.92,
   "end": 537.56,
   "text": "اگر کسی می‌خواد خودش رو ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 537.56,
   "end": 540.4,
   "text": "روزه باعث می‌شه به اون توجه نفسانی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 540.4,
   "end": 546.48,
   "text": "تمرین می‌خواد. انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 546.48,
   "end": 552.26,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}