 "chapters": [
  {
   "index": 0,
   "title": "## میلاد امام حسن؛ عقل مجسّم",
   "start": 16.14,
   "end": 81.18
  },
  {
   "index": 1,
   "title": "## شباهت حسن به زهرا و حسین به علی",
   "start": 81.18,
   "end": 173.56
  },
  {
   "index": 2,
   "title": "## روح اعظم؛ مظهر در عالم کبیر و صغیر",
   "start": 173.56,
   "end": 253.1
  },
  {
   "index": 3,
   "title": "## شب قدر؛ سرکشی مادر به فرزندان ارواح",
   "start": 253.1,
   "end": 458.5
  },
  {
   "index": 4,
   "title": "آیهٔ صد سورهٔ یونس می‌فرماید:",
   "start": 458.5,
   "end": 631.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.16,
   "end": 7.46,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.46,
   "end": 14.96,
   "text": "السلام علیک یا داعی الله و ربانی آیاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.96,
   "end": 17.96,
   "text": "تبریک عرض می‌کنم. روز بسیار با عظمتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.96,
   "end": 24.38,
   "text": "میلاد کریم اهل بیت آقا امام حسن مجتبی سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.38,
   "end": 33.04,
   "text": "در یک روایت و حدیث زیبایی پیامبر عظیم الشأن اسلام، امام حسن صلوات الله علیه رو این چنین معرفی کردن که لو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 33.04,
   "end": 40.14,
   "text": "کان العقل رجلا یعنی اگر عقل مرد می‌شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 40.14,
   "end": 43.6,
   "text": "عقل تبدیل می‌شد به یک مرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 43.6,
   "end": 47.0,
   "text": "لکان الحسن سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.0,
   "end": 56.68,
   "text": "در کتاب وسائل شیعه شیخ حر عاملی علیه الرحمه هم یه روایتی داره اونجا می‌فرماید خدای منان همه حکمت رو به علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 56.68,
   "end": 62.6,
   "text": "صلوات الله علیه بخشید و همه عقل رو به امام حسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 62.6,
   "end": 66.8,
   "text": "همه عقل رو. خیلی فرمایش شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 66.8,
   "end": 70.38,
   "text": "و همه نیکویی‌ها رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 70.38,
   "end": 73.34,
   "text": "حسنات رو به امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 73.34,
   "end": 76.52,
   "text": "و همه شفقت‌ها و مهر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 76.52,
   "end": 80.28,
   "text": "عطوفت‌ها رو، مهربانی‌ها رو به حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 80.28,
   "end": 82.88,
   "text": "سلام الله علیهم أجمعين. عجیبه این روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.88,
   "end": 85.64,
   "text": "همه عقل به امام حسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.64,
   "end": 88.2,
   "text": "خب می‌دونید که ملائکه الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.2,
   "end": 91.0,
   "text": "جنسشون از عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.0,
   "end": 93.56,
   "text": "با این تفصیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.56,
   "end": 95.46,
   "text": "متوجه می‌شیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.46,
   "end": 99.04,
   "text": "ملائکه سربازان امام حسنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.04,
   "end": 103.7,
   "text": "در خدمت حضرتم. شؤون وجودی امام حسنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.7,
   "end": 106.96,
   "text": "تحت امر ح-- امام حسنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.96,
   "end": 113.04,
   "text": "جالبه که امام حسن در روایت داریم شبیه به حضرت زهرا سلام الله علیها بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.04,
   "end": 118.82,
   "text": "هم چهره، هم خلق، صدای ایشون، راه رفتن ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.82,
   "end": 121.62,
   "text": "عجیبه. حالا حکمت در چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.62,
   "end": 124.6,
   "text": "و امام حسین شبیه امیرالمؤمنین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.6,
   "end": 127.02,
   "text": "مثلاً وقتی امام حسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.02,
   "end": 133.7,
   "text": "یه جا نشسته بود امام حسین وارد می‌شد، امام حسن تمام قد بلند می‌شد جلوی امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.7,
   "end": 139.52,
   "text": "اشکال می‌کردم آقا شما برادر بزرگتری، شما چرا بلند می‌شی جلوی برادر کوچیکتر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.52,
   "end": 145.74,
   "text": "می‌فرمود که حسینم هیبت بابام علی رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.74,
   "end": 148.76,
   "text": "به امیرالمؤمنین رفته بود امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.76,
   "end": 150.62,
   "text": "امام حسن به حضرت زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.62,
   "end": 153.54,
   "text": "حالا همه اینا رو توضیح دادم مقدمه کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.54,
   "end": 159.02,
   "text": "که او که همه عقل بود به مادرش زهرای مرضیه سلام الله علیها رفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.02,
   "end": 167.56,
   "text": "ملائکه هم که جنسشون از عقل است و حضرت پیغمبر عزّ عالم هم فرمودن اگر عقل بشه مرد امام حسنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.56,
   "end": 173.56,
   "text": "چی می‌خوام بگم؟ بحث ما تنزّل الملائکه و الروح بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.56,
   "end": 178.74,
   "text": "همه ملائکه به یک معنا سربازان و جنود روحن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.74,
   "end": 182.0,
   "text": "روح اعظم و روح اعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.0,
   "end": 186.14,
   "text": "روحی‌ست که شب قدر نازل می‌شه بر انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.14,
   "end": 195.26,
   "text": "قبلاً عرض کردیم که روح اعظم در عالم کبیر یعنی عوالم بیرون از متن وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 195.26,
   "end": 198.12,
   "text": "مظهر دارد که همه این‌ها من--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 198.12,
   "end": 202.12,
   "text": "از نفس کل، عقل کل، لوح، قلم، کرسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 202.12,
   "end": 204.72,
   "text": "اینا همه عرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.72,
   "end": 209.32,
   "text": "و مافوقش همه مظهر روح اعظم‌اند در بیرون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 209.32,
   "end": 212.38,
   "text": "وجود انسان. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 212.38,
   "end": 214.66,
   "text": "ذات انسانی، در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.66,
   "end": 220.14,
   "text": "وجود خود ما که بهش میگن عالم صغیر، روح اعظم مظهر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.14,
   "end": 222.84,
   "text": "اولین روحی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.84,
   "end": 228.32,
   "text": "اولین وجودی که در وجود ما، اولین جایی حالا بگیم، حالا بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.32,
   "end": 230.58,
   "text": "شأنی از وجود ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.58,
   "end": 233.18,
   "text": "از روح اعظمه روح ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.18,
   "end": 236.4,
   "text": "روح من و شما جنسش از روح اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.4,
   "end": 239.34,
   "text": "روح اعظم هم که جنسش عقل کله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.34,
   "end": 242.02,
   "text": "همه ملائکه هم که عقول‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.02,
   "end": 245.4,
   "text": "این مفارقات، عقول اینا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.4,
   "end": 252.84,
   "text": "چی‌ان؟ شؤون روح کل‌اند یا روح اعظم‌اند یا روح القدس‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.84,
   "end": 257.76,
   "text": "او شب قدر میاد پایین که نازل می‌شه بر امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.76,
   "end": 262.34,
   "text": "ملائکه هم همه تحت امر اونن و المدبرات أمرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.34,
   "end": 266.56,
   "text": "روح ما هم از اون جنسه، از اون سنخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.56,
   "end": 269.5,
   "text": "پس ما می‌شیم جزء، اون می‌شه کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.5,
   "end": 277.26,
   "text": "شب قدر که آن‌هم مثل این می‌مونه که مادر بیاد سرکشی کنه به بچه‌هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 277.26,
   "end": 279.98,
   "text": "اون روح اعظم، اون روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.98,
   "end": 290.62,
   "text": "کلی ارواحی که در من و شما وجود داره، این ارواح در وجود من و شما به منزله فرزندان او هستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 290.62,
   "end": 292.72,
   "text": "شؤون وجودی او هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 292.72,
   "end": 298.74,
   "text": "برای همینه که روح کلی که نازل می‌شه همه ارواح متوجه می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 298.74,
   "end": 305.12,
   "text": "در هر nefsi که باشن. متوجه می‌شن یک فراخان عجیبی رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 305.12,
   "end": 307.06,
   "text": "توجه بفرمایید چی دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 307.06,
   "end": 309.52,
   "text": "مطلب خیلی می‌دونم سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 309.52,
   "end": 315.14,
   "text": "منتها چون مقدمه چیدیم اومدیم تا اینجا باید دیگه بگیرید دیگه من چی دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 315.14,
   "end": 318.7,
   "text": "از خودمم حرف نمی‌زنم. همش با سند و روایت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 318.7,
   "end": 323.24,
   "text": "مدخل دهم از مداخل ورود به fusus ابن عربی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 323.24,
   "end": 328.26,
   "text": "علامه قیسری به زیبایی همین مطلب منو اونجا به عربی پیاده کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 328.26,
   "end": 332.24,
   "text": "که در وجود ما هست. همینطور بیاد تا پایین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 332.24,
   "end": 334.96,
   "text": "اعم از حالا مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 334.96,
   "end": 338.14,
   "text": "روح که می‌شه قلب، بعد عقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 338.14,
   "end": 341.62,
   "text": "بعد وهم، خیال، حس مشترک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 341.62,
   "end": 343.9,
   "text": "و حتی حواس ظاهری ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 343.9,
   "end": 347.62,
   "text": "به یک معنا از اون روح اعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 347.62,
   "end": 351.28,
   "text": "شأن گرفتن که حالا اینا بحث‌هاش مفصوله بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.28,
   "end": 353.86,
   "text": "فعلاً اینو بدونیم. اون روح ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.86,
   "end": 358.12,
   "text": "روح ما که رب وجودی ما، حصه وجودی ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.12,
   "end": 362.34,
   "text": "کانال وجودی و ارتباطی ما با دریای لایتناهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.34,
   "end": 364.72,
   "text": "اصمد حضرت حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 364.72,
   "end": 367.2,
   "text": "اون اسم اعظم وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 367.2,
   "end": 370.82,
   "text": "اون کانال وجودی ماست، جدول وجودی ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.82,
   "end": 373.28,
   "text": "که باید لای‌روبی بشه تا اتصال بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 373.28,
   "end": 376.02,
   "text": "اون رب وجودی ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.02,
   "end": 380.2,
   "text": "و اون روح اعظم رب پیغمبر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.2,
   "end": 384.12,
   "text": "که \"و ان الی ربک المنتهی\" یه جای قرآن می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 384.12,
   "end": 387.54,
   "text": "یه جا می‌فرماید \"و ان الی ربک الرجع\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.54,
   "end": 390.52,
   "text": "همه رجعت می‌کنند به سمت پروردگار تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.52,
   "end": 393.7,
   "text": "کأنّ همه میرن به سمت روح اعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.7,
   "end": 401.62,
   "text": "خب که رب وجودی ما، رب ما \"سبحان ربي الا عظيم\"، \"سبحان ربي الا الاعلى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 401.62,
   "end": 405.0,
   "text": "این رب وجودی ما، شان وجودی اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.0,
   "end": 408.32,
   "text": "حالا شب قدر ببین چه فضایی حاکم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.32,
   "end": 411.48,
   "text": "اینکه همه اصلاً فضا متفاوت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.48,
   "end": 413.92,
   "text": "همه یه حالت عجیبی پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.92,
   "end": 420.22,
   "text": "مگر دیگه ایمان رو کشته باشن خدایی نکرده روح ایمان ازشون اخذ شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 420.22,
   "end": 422.3,
   "text": "اون دیگه کار-- روح ایمان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 422.3,
   "end": 428.16,
   "text": "حالا من دارم میگم همین روح اعظمه که بخشی در هر کسی نسبت به صع وجودیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 428.16,
   "end": 431.62,
   "text": "این نفل شده \"ونفخت فیه من روحی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 431.62,
   "end": 435.84,
   "text": "اجازه بفرمایید همون روز آخری که ما اینجا داشتیم روز یازدهم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 435.84,
   "end": 438.54,
   "text": "روز یازدهم مبارک فکر کنم چهارشنبه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 438.54,
   "end": 443.42,
   "text": "داشتیم اینجا قبل نماز ختم قرآن می‌کردیم با آقای بیاتی و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 443.42,
   "end": 446.0,
   "text": "بعد رسیدم به این آیه دیدم چه شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.0,
   "end": 449.64,
   "text": "این همه ما ختم قرآن کردیم انگار اولین بار این آیه رو دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.64,
   "end": 452.08,
   "text": "شما ببینید چه عجیب آیه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 452.08,
   "end": 455.0,
   "text": "آیه صد سوره یونس \"وما کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.0,
   "end": 458.5,
   "text": "نفس ان تؤمن الا باذن الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.5,
   "end": 463.26,
   "text": "هیچ نفسی نیست مگر اینکه به اذن الهی \"تؤمن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 463.26,
   "end": 467.12,
   "text": "ایمان میاره. \"ان تؤمن الا باذن الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 467.12,
   "end": 471.02,
   "text": "خب همه نفوس به اذن الله ایمان میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 471.02,
   "end": 477.76,
   "text": "ما اونجا گفتیم دار دار اسبابه \"ولن تجد لسنّة الله تبدیلا او تحویلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.76,
   "end": 481.6,
   "text": "دار دار اسبابه. مظهر اسم الله چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 481.6,
   "end": 484.96,
   "text": "روح اعظم بود. همون \"تنزّل الملائكة والروح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 484.96,
   "end": 488.36,
   "text": "مظهر اسم الله میاد پایین شب قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 488.36,
   "end": 492.1,
   "text": "اینجا میگه بدون اذن الله احدی ایمان نمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 492.1,
   "end": 496.34,
   "text": "ایمان اون مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.34,
   "end": 499.46,
   "text": "بهره‌ایست که ما از روح اعظم بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 499.46,
   "end": 502.48,
   "text": "خدا در دایره اسباب فیضشو می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 502.48,
   "end": 505.82,
   "text": "یعنی اگر روح ایمان به من و شما برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.82,
   "end": 509.7,
   "text": "از طریق واسطه فیض الله که کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.7,
   "end": 512.44,
   "text": "روح اعظمه. این یه نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.44,
   "end": 516.42,
   "text": "نکته آخر اینجا رو خوب گوش بدید خواهشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 516.42,
   "end": 518.44,
   "text": "آیه قرآن دارم براتون می‌خونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 518.44,
   "end": 521.3,
   "text": "\"ويجعل الرجس على الذين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 521.3,
   "end": 524.7,
   "text": "لا يعقلون\". عجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 524.7,
   "end": 527.14,
   "text": "ما رجسو قرار میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.14,
   "end": 531.32,
   "text": "یعنی ببخشید \"يجعل\" این \"يجعل\" کی \"يجعل\"؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.32,
   "end": 533.48,
   "text": "الله \"يجعل\" چون می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 533.48,
   "end": 536.18,
   "text": "\"ان تؤمن الا باذن الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 536.18,
   "end": 540.56,
   "text": "حالا می‌فرماید \"ويجعل الرجس\" قرار می‌دهد اون الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 540.56,
   "end": 543.82,
   "text": "رجس و ناپاکی رو پلیدی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.82,
   "end": 547.84,
   "text": "بر کی؟ \"على الذين لا يعقلون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.84,
   "end": 550.14,
   "text": "یعنی کسی که از عقل بهره نبرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.14,
   "end": 553.04,
   "text": "یعنی کسی که خالی شده از روح ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 553.04,
   "end": 557.34,
   "text": "یعنی از اون روح اعظم. یعنی روح اعظم رو پس زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 557.34,
   "end": 558.88,
   "text": "ملائکه می‌خوان بهش ناظر بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 558.88,
   "end": 562.96,
   "text": "اینا رو پس می‌زنن و شیاطین میان به جاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 562.96,
   "end": 565.16,
   "text": "اینا چی میشن؟ رجس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.16,
   "end": 568.9,
   "text": "بعد ما دم می‌زنیم از تشیع بودن، شیعه بودن‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 568.9,
   "end": 573.12,
   "text": "در حالی که قرآن می‌فرماید \"لیذهب عنكم الرجس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 573.12,
   "end": 577.0,
   "text": "اهل البيت\" از اهل بیت رجس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 577.0,
   "end": 580.14,
   "text": "دفع شده، کلاً برداشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 580.14,
   "end": 582.26,
   "text": "و چرا ما باید رجس، رجس داشته باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 582.26,
   "end": 584.36,
   "text": "کسی رجس دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 584.36,
   "end": 587.62,
   "text": "بر اساس این آیه که عقلش رو تعطیل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 587.62,
   "end": 591.78,
   "text": "بترسن اون‌هایی که کار عقلی، فکری نمی‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 591.78,
   "end": 594.24,
   "text": "فقط کار احساسی و خیالی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 594.24,
   "end": 598.64,
   "text": "تا چهار تا حرف علمی، عقلی اینها می‌شنوند پس می‌زنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 598.64,
   "end": 601.66,
   "text": "اینا خطر رجس در کمین این‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 601.66,
   "end": 603.86,
   "text": "و کسانی شب‌های قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 603.86,
   "end": 610.32,
   "text": "می‌توانند از اون روح اعظم و تنزيل ملائکه بهره بگیرند که کارهای عقلی زیاد این آیه قرآنشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 610.32,
   "end": 614.76,
   "text": "کار عقلی کرده باشن، اهل تفکر در قرآن باشن، در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 614.76,
   "end": 619.42,
   "text": "نظام خلقت و جان خودشون باشن که \"وفی انفسکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 619.42,
   "end": 622.89,
   "text": "افلا تبصرون\". انشاالله عاقبتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 622.89,
   "end": 627.86,
   "text": "به برکت امام حسن مجتبی ختم به خیر بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.86,
   "end": 631.3,
   "text": "صلوات ختم کنید. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}