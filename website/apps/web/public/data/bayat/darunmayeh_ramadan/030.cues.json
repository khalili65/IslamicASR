 },
 "chapters": [
  {
   "index": 0,
   "title": "## قضای روزهٔ سفر؛ مهلت و کفاره",
   "start": 12.76,
   "end": 169.34
  },
  {
   "index": 1,
   "title": "## فطر؛ شکفتن از درون",
   "start": 169.34,
   "end": 378.87
  },
  {
   "index": 2,
   "title": "## خلقت نوریهٔ فاطمه؛ شکفتن از نور ذات",
   "start": 378.87,
   "end": 398.97
  },
  {
   "index": 3,
   "title": "## شکفتگی عید و فطرت الله",
   "start": 398.97,
   "end": 548.89
  },
  {
   "index": 4,
   "title": "## القای علم از ذات علیم",
   "start": 548.89,
   "end": 614.45
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.66,
   "end": 7.54,
   "text": "السلام علیک یا دارعی الله و ربانیة آیاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.54,
   "end": 11.98,
   "text": "السلام علیکم و رحمه الله. السلام علیکُم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.98,
   "end": 15.32,
   "text": "استفتاء شده از رهبر عزیزمون که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.32,
   "end": 18.86,
   "text": "در ماه مبارک رمضان مسافرت رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.86,
   "end": 21.48,
   "text": "خب اون نمازی که، اون روزه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.48,
   "end": 24.94,
   "text": "نگرفتیم قضا‌ش به گردنونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.94,
   "end": 27.24,
   "text": "آیا اینو تا کی وقت داریم یک؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.24,
   "end": 29.84,
   "text": "دوما کفاره هم داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.84,
   "end": 38.52,
   "text": "فقط قضا یا کفاره هم داره و تا کی وقت داریم که قضای این روزهایی که سفر رفتیمو انجام بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.52,
   "end": 41.2,
   "text": "رهبر عزیزمون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.2,
   "end": 46.26,
   "text": "خب این قضا‌ش که وقتی رفتی مسافرت قضا‌ش که به گردنت هست یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.26,
   "end": 51.3,
   "text": "دوما بنا بر احتیاط واجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.3,
   "end": 57.28,
   "text": "نباید این قضا رو به تأخیر بندازی تا س-- ماه مبارک رمضان سال بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.28,
   "end": 63.06,
   "text": "یعنی تا قبل از اینکه ماه مبارک رمضان سال بعد برسه باید قضا‌شو بری، بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.06,
   "end": 66.02,
   "text": "کفاره هم نداره، قضا فقط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.02,
   "end": 70.14,
   "text": "اما اگر نگرفتی به هر دلیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.14,
   "end": 73.04,
   "text": "و ماه مبارک رمضان سال بعد رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.04,
   "end": 77.42,
   "text": "هم قضا گردنت داره هم کفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.42,
   "end": 82.78,
   "text": "کفاره هم که همون یه مطعمه که هفتصد و پنجاه گرم از برنج و گندم و اینجور چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.78,
   "end": 85.28,
   "text": "که البته سؤال شده که ما فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.28,
   "end": 88.68,
   "text": "باید جنس رو بدیم یا میشه پول جنس رو هم بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.68,
   "end": 91.18,
   "text": "مثلاً پول هفتصد و پنجاه گرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.18,
   "end": 97.26,
   "text": "برنج رو بدیم. آقا فرمودن نه اشکال نداره میتونید پولشو بدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.26,
   "end": 101.48,
   "text": "خب از اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.48,
   "end": 104.74,
   "text": "راضق حقایق کلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.74,
   "end": 107.42,
   "text": "من و شما نیستیم و کس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.42,
   "end": 115.74,
   "text": "دیگه‌ای تنظیم میکنه \"و في السماء رزقكم وما توعدون\" ما گمان می‌کردیم توفیق پیدا می‌کنیم خیلی از اسرار روزه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.74,
   "end": 120.12,
   "text": "و صوم و جوع رو بر اساس کتاب شریف اسرار الحکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.12,
   "end": 126.2,
   "text": "مرحوم حاج آقا سبزواری علیه الرحمه به شما تو ماه مبارک رمضان و به خودمون حدیث نفس کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.2,
   "end": 129.26,
   "text": "توفیق نشد. این بحث موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.26,
   "end": 133.88,
   "text": "اگر خدا توفیق داد سال‌های بعد ما زنده بودیم و در خدمت بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.88,
   "end": 136.0,
   "text": "ادامه‌ش میدیم که حداقل یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.0,
   "end": 138.58,
   "text": "بیست سی جلسه دیگه این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.58,
   "end": 143.58,
   "text": "می‌خواست که تموم شه. حالا نکته‌ای رو عرض کنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.58,
   "end": 145.96,
   "text": "بعداً برگردیم به مباحث گذشته‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.96,
   "end": 148.28,
   "text": "این نکته رو خوب دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.28,
   "end": 150.66,
   "text": "خیلی به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.66,
   "end": 153.86,
   "text": "حالا که تأمل دارید می‌کنید، دل بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.86,
   "end": 160.48,
   "text": "که انشاالله مس کنید حقیقت این موضوع رو که \"لا یمسهُ\" البته \"إلا المطهرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.48,
   "end": 165.66,
   "text": "انشاالله با طهارت لازم این نکته رو مس کنید حقیقتون درک کنه خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.66,
   "end": 169.34,
   "text": "سر، به سر و جانتون بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.34,
   "end": 172.56,
   "text": "فطر اصلاً یعنی چی؟ عید فطر یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.56,
   "end": 177.2,
   "text": "چرا ما فطریه میدیم؟ اصلاً افطار یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.2,
   "end": 181.2,
   "text": "چرا بهش میگن افطار، فطرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.2,
   "end": 184.88,
   "text": "فاطر. اینا ببین همه از یه ریشه‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.88,
   "end": 191.2,
   "text": "چرا وقتی نماز می‌خونیم قبل از نماز میگیم \"إِنِّی وَجَّهْتُ وَجْهِیَ لِلَّذِی فَطَرَ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.2,
   "end": 197.02,
   "text": "فَطَرَ، فَتَرَ السَّمَاوَاتِ وَالْأَرْضَ حَنِيفًا مُسْلِمًا وَمَا أَنَا مِنَ الْمُشْرِکِينَ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.02,
   "end": 201.3,
   "text": "که توصیه شده بگیم. معنای دقیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.3,
   "end": 204.18,
   "text": "حالا من دیدم متأسفانه بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.18,
   "end": 206.26,
   "text": "اه قرآن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.26,
   "end": 209.5,
   "text": "ذیل این فطره نوشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.5,
   "end": 213.74,
   "text": "خالق یا به وجود آورنده مثلاً آسمان و زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.74,
   "end": 222.38,
   "text": "در صورتی که با دقت نظر اگر تو اسماء الهی کار کنیم معنای دقیقش میشه شکافنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.38,
   "end": 227.42,
   "text": "فاطر شکافنده است. از شکفتن میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.42,
   "end": 229.68,
   "text": "فطر از شکفتن میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.68,
   "end": 233.34,
   "text": "شکفتن اونم از درون ذات وجود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.34,
   "end": 235.3,
   "text": "نه بیرون از متن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.3,
   "end": 237.66,
   "text": "بیرون از متن واقع، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.66,
   "end": 243.66,
   "text": "از درون. ببینید وقتی ماه مبارک رمضان شکفته شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.66,
   "end": 248.9,
   "text": "اون روزی که ماه مبارک رمضان از درون خودش شکفته میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.9,
   "end": 253.06,
   "text": "میشه اون روز فطر. همه ماه‌ها اینطورین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 253.06,
   "end": 257.02,
   "text": "نه فقط اول شوال فطر باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 257.02,
   "end": 259.62,
   "text": "همه اول همه ماه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.62,
   "end": 263.1,
   "text": "چون ماه قبل شکفته میشه از درون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.1,
   "end": 266.12,
   "text": "ما اصلاً چیزی در این عالم به نام تکرار نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.12,
   "end": 269.7,
   "text": "تکرار چیه؟ یک شکفتن جدیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.7,
   "end": 272.94,
   "text": "\"کل یوم هو فی شأن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.94,
   "end": 276.82,
   "text": "از چهل رساله‌ای که مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.82,
   "end": 279.9,
   "text": "شیخ اکبر محی الدین رحمة الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.9,
   "end": 286.52,
   "text": "بر این حالا بعضی از موضوعات خاص داره که همه رو الان جمع کردن تو یک مجلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.52,
   "end": 296.76,
   "text": "حالا علوم خاص به قول بعضی علوم غریبه یا به قول علامه حسن زان-- حسن زاده حفظه الله تعالی آشنای غریب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.76,
   "end": 299.74,
   "text": "یه رساله‌ش فقط پیرامون همین آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.74,
   "end": 303.16,
   "text": "\"کل یوم هو فی شأن\". اصلاً تکرار چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.16,
   "end": 305.78,
   "text": "آن به آن، آنات عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.78,
   "end": 308.34,
   "text": "شکفتن است. شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.34,
   "end": 313.44,
   "text": "همین الان آدمی نیستی که یک لحظه پیش بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 313.44,
   "end": 318.5,
   "text": "از جهت جسمی، روحی دائماً ما در حال عوض و بدلیم، تغییر و تبدلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.5,
   "end": 321.12,
   "text": "حالا خستتون نکنم. فطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.12,
   "end": 324.46,
   "text": "یعنی شکفتن. اینکه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.46,
   "end": 330.26,
   "text": "در هنگام غروب افطار می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 330.26,
   "end": 333.96,
   "text": "از این جهت بهش میگن افطار که در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 333.96,
   "end": 337.2,
   "text": "شب میاد روز رو می‌شکفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.2,
   "end": 340.76,
   "text": "شب، غروب آفتاب میاد اون روز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.76,
   "end": 343.88,
   "text": "می‌شکفه از درون خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.88,
   "end": 349.62,
   "text": "این اتفاق میفته. در ذات وجود روز این اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.62,
   "end": 356.46,
   "text": "یکی از دلایلی که تو این دعا رو هم دقت کردید چرا میگی يا فاطر به حق فاطمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 356.46,
   "end": 359.96,
   "text": "چرا اشاره به اسم فاطر می‌کنی بعد به حق فاطمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 359.96,
   "end": 363.87,
   "text": "خب اینا اسراره دیگه آدم باید دقت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 363.87,
   "end": 365.99,
   "text": "به جهت اینکه من اینا رو خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.99,
   "end": 369.93,
   "text": "جون کندم خدا میدونه به فضل الهی به اینا رسیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.93,
   "end": 373.25,
   "text": "شما هم انشاالله قدر بدونید این‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.25,
   "end": 376.83,
   "text": "منتی نیست می‌خوام ارزش موضوع رو بدونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.83,
   "end": 385.73,
   "text": "که مرحوم مجلسی رحمت الله علیه در کتاب چهارده معصومش اشاره به یک روایت بسیار عجیبی پیرامون خلقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 385.73,
   "end": 390.29,
   "text": "نوریه حضرت صدیقه طاهره سلام الله علیها کرده از امام باقر علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.29,
   "end": 395.79,
   "text": "روایت مبسوطیه. اونجا می‌فرماید که دو قول وجود داره برای خلقت نوریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 395.79,
   "end": 401.03,
   "text": "خانم که بعضیا میگن از انشقاق نور پیغمبر و علی خلق شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 401.03,
   "end": 404.47,
   "text": "از ادامه انشقاق ادامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.47,
   "end": 408.47,
   "text": "منتها این روایتو هرکسی جگر نداشته بیاره اینطوری بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 408.47,
   "end": 414.11,
   "text": "مرحوم مجلسی آورده می‌فرماید اتفاقاً خیلی از بزرگان ظاهراً سید بن طاووس هم این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 414.11,
   "end": 418.45,
   "text": "قبول داشته که دقت بفرمایید می‌فرماید خدا بعد از خلقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 418.45,
   "end": 427.19,
   "text": "پیغمبر و امیرالمؤمنین دو مرتبه برگشت به ذات خودش از نور ذات خودش فاطمه زهرا رو خلق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.19,
   "end": 429.83,
   "text": "شکفته شدن از نور یعنی نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 429.83,
   "end": 435.53,
   "text": "ذات خدا شکفته بشه حضرت زهرا ببین چی باید بشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 435.53,
   "end": 440.77,
   "text": "لذا یک وجه که میگیم یا فاطره به حق فاطمه اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 440.77,
   "end": 445.41,
   "text": "بحث شکفته شدن است. ما باید در روز عید فطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 445.41,
   "end": 449.31,
   "text": "چنان در درون خودمون شکفتگی ایجاد شده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 449.31,
   "end": 454.83,
   "text": "این دیدید درخت شکوفه میزنه کیف میکنی میبینی از این درخت زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.83,
   "end": 462.99,
   "text": "اگر قرار باشه ما اول ماه شوال‌مون هیچ شکوفه‌ای تو وجودمون نزده باشه شکفته نشده باشه چه ما رمضونی داشتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 462.99,
   "end": 467.45,
   "text": "لب افطار دقت کردید که شما یه نشاط اصلاً حدیث هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 467.45,
   "end": 469.95,
   "text": "دو تا فرح برای مؤمن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 469.95,
   "end": 472.73,
   "text": "یکی دم افطار، یکی روز قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 472.73,
   "end": 480.25,
   "text": "دم افطار از صبح گرسنگی تشنگی رو تحمل کردی دم افطار اصلاً گرسنگی میره تشنگی میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 480.25,
   "end": 484.25,
   "text": "اصلاً نه ماه مبارک رمضان الانم روزه بگیری همین حالت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 484.25,
   "end": 488.75,
   "text": "دم افطار یک ساعتی مونده به افطار یک شکفتگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 488.75,
   "end": 491.21,
   "text": "عجیبی در درونت میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 491.21,
   "end": 493.39,
   "text": "اصلاً دوست نداری افطار کنی غذا بخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 493.39,
   "end": 496.01,
   "text": "یک نشاط عجیبی. اون همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 496.01,
   "end": 503.59,
   "text": "فتره. ببینید فطرت الله آیاتو میگم روایاتو میگم ببینید چقدر بحث مبنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 503.59,
   "end": 506.67,
   "text": "فطرت الله، فطرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 506.67,
   "end": 511.35,
   "text": "الله، فطرت الله التي فطر الناس عليها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 511.35,
   "end": 514.45,
   "text": "اون چیزی که در درون ذات ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 514.45,
   "end": 518.33,
   "text": "فطرت الهی‌ست. در درون شکفته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 518.33,
   "end": 520.67,
   "text": "نمیشه با سیاه قلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 520.67,
   "end": 523.15,
   "text": "و با فـ-- صرفاً حرف زدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 523.15,
   "end": 526.05,
   "text": "حفظ کردن محفوظات خدا رو پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 526.05,
   "end": 529.87,
   "text": "در درون ذات باید بشکفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 529.87,
   "end": 533.21,
   "text": "کل مولود یولد علی الفطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 533.21,
   "end": 535.73,
   "text": "این فطرت هم ذاتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 535.73,
   "end": 539.63,
   "text": "توحید ذاتیه در درونه از بیرون نمیاد که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 539.63,
   "end": 541.47,
   "text": "اصلاً کی گفته از بیرون میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.47,
   "end": 548.37,
   "text": "حالا که به اینجا رسیدیم نکته‌ای الان دیگه فرصت نیست منتقل به یک نکته بسیار مهمی میشیم فردا بهتون میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 548.37,
   "end": 550.19,
   "text": "اصلاً این علم از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 550.19,
   "end": 552.57,
   "text": "من الان دارم به شما تعلیم علم میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 552.57,
   "end": 554.87,
   "text": "شما خودت داری اخذ علم می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 554.87,
   "end": 557.37,
   "text": "این القای علمی از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 557.37,
   "end": 559.87,
   "text": "چرا یکی میفهمه یکی نمیفهمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 559.87,
   "end": 563.27,
   "text": "چرا یکی عالمه اما نمیفهمه علمشو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.27,
   "end": 571.27,
   "text": "یکی هم ظاهراً نادانه ظاهراً عالمی‌ست اما بسیار میفهمه این علم القای علم از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 571.27,
   "end": 574.75,
   "text": "این نک-نکته رو اگر ما بدونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 574.75,
   "end": 581.67,
   "text": "اونوقت به درون مایه و غنای عجیب دینمون پی می‌بریم که این‌ها همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 581.67,
   "end": 584.53,
   "text": "عرض شود از ذات خدا، خدا علیمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 584.53,
   "end": 586.63,
   "text": "اسمایش هم عین ذاتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 586.63,
   "end": 589.21,
   "text": "خدای علیم. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 589.21,
   "end": 591.73,
   "text": "همه این علوم از ذات خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 591.73,
   "end": 594.77,
   "text": "شکفته شده که همش مبنای عشق داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 594.77,
   "end": 600.91,
   "text": "انشاالله اگر دوست داشتید این بحث رو تا آخر هفته با هم ادامه بدیم نکته خوبي انشاالله گیرمون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 600.91,
   "end": 603.17,
   "text": "سال امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 603.17,
   "end": 608.11,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 608.11,
   "end": 614.45,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}