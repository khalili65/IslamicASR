 "chapters": [
  {
   "index": 0,
   "title": "## تنزیل ملائکه و روح؛ کثرت ملائکه",
   "start": 11.38,
   "end": 31.5
  },
  {
   "index": 1,
   "title": "## تمایز روح و ملائکه؛ روح اعظم",
   "start": 31.5,
   "end": 53.16
  },
  {
   "index": 2,
   "title": "## ینزّل الملائکة بالروح؛ روح القدس",
   "start": 53.16,
   "end": 415.65
  },
  {
   "index": 3,
   "title": "## روح مظهر اسم الله؛ فطرت الله در انسان",
   "start": 415.65,
   "end": 577.99
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.32,
   "end": 2.86,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.86,
   "end": 6.28,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.28,
   "end": 8.34,
   "text": "و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.34,
   "end": 11.38,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.38,
   "end": 16.22,
   "text": "بحث ما پیرامون تنزيل ملائکه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.22,
   "end": 21.46,
   "text": "روح بود در شب قدر که درون مایه این ماه رو مشخص می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.46,
   "end": 24.7,
   "text": "یکی از وجوهش البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.7,
   "end": 31.5,
   "text": "یکی از درس‌های از تـ-- علامه حسن زاده علیه الرحمه اشاره کردن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.5,
   "end": 35.68,
   "text": "اینکه حتی چون می‌دونید کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.68,
   "end": 41.04,
   "text": "مخلوقات خدا در میان مخلوقات الهی هیچ کدوم به کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.04,
   "end": 44.82,
   "text": "ملائکه نیستن. حضرت استاد فرمودن که حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.82,
   "end": 46.98,
   "text": "در ذره‌ذره‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.98,
   "end": 52.46,
   "text": "کائنات، در اون جزئی‌ترین، کوچک‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.46,
   "end": 59.84,
   "text": "اجزاء این عالم امکانی مثل حالا اتم حتی، اونجا ملائکه هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.84,
   "end": 62.1,
   "text": "و اون‌ها واسطه‌ی فیض‌ن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.1,
   "end": 66.98,
   "text": "بین عالم امر و عالم خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.98,
   "end": 72.14,
   "text": "اصلاً نمیشه چون ولن تجد لسنة الله تبدیلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.14,
   "end": 78.8,
   "text": "سنت الهیه دایره دا این از دایره‌ی اسباب فیض رو می‌رسونه و این دایره این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.8,
   "end": 82.12,
   "text": "وسیله‌ی فیض ملائکه‌اند که از شؤون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.12,
   "end": 84.82,
   "text": "ولایت کلیه‌ی الهیه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.82,
   "end": 87.56,
   "text": "سربازان و جنود امام عصرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.56,
   "end": 91.28,
   "text": "سربازان و جنود انسان کامل‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.28,
   "end": 92.9,
   "text": "و این‌ها همه جا هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.9,
   "end": 96.14,
   "text": "بعد علامه فرمودن حالا شما ببینید که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.14,
   "end": 102.28,
   "text": "ذر-- در یک خود بدن انسان این همه میلیاردها میلیارد اصلاً غیر قابل شمارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.28,
   "end": 105.6,
   "text": "اتم وجود داره. بیاید بیرون حالا از ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.6,
   "end": 111.26,
   "text": "جمادات، نباتات، انسان‌ها، حیوان‌ها این همه کثرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.26,
   "end": 117.3,
   "text": "همه و همه جزء به جزء تحت تدبیر و المدبرات امر ملائکه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.3,
   "end": 119.34,
   "text": "حالا این ملائکه دسته‌بندی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.34,
   "end": 122.66,
   "text": "از این فرمود بعضیا ملائکه رو به دو دسته‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.66,
   "end": 125.16,
   "text": "ملکوتی و جبروتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.16,
   "end": 131.32,
   "text": "تقسیم می‌کنند. بعضیا نه میگن نشئه ملک هم هست بعد ملکوت بعد جبروت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.32,
   "end": 134.14,
   "text": "حالا به نسبت به رتبه‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.14,
   "end": 140.64,
   "text": "بعضیا میان میگن نه ملائکه محیمین یا کروبین، کروبیین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.64,
   "end": 146.54,
   "text": "و غیر اون‌ها. حالا اونچه که مسلم است در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.54,
   "end": 153.36,
   "text": "وجه تمایز بین روح و ملائکه که هر دو نازله‌اند ملائکه نازل میشن هم روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.36,
   "end": 159.02,
   "text": "چه فرقی، چه تمایزی بین روح و دیگر ملائکه هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.02,
   "end": 163.12,
   "text": "بزرگان اهل معرفت تصریح کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.12,
   "end": 169.44,
   "text": "مثلا خود حضرت امام در آداب الصلاواتش بحث قشنگی اینجا دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.44,
   "end": 176.8,
   "text": "که ملائکه اولاً ملائکه‌ای که در شب قدر نا-نازل میشن بر امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.8,
   "end": 184.54,
   "text": "و میان به عالم خاکی به نشئه ملک این‌ها نسبت به ملائکه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.54,
   "end": 190.26,
   "text": "این‌ها قرب خیلی شدیدتری به خدا دارن یعنی مقامشون خیلی بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 190.26,
   "end": 193.4,
   "text": "اما روح اختصاص به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.4,
   "end": 196.92,
   "text": "ملائکه محیمین یا کروبیین داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.92,
   "end": 201.64,
   "text": "یعنی چی؟ یعنی از میان ملائکه‌ایست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.64,
   "end": 205.48,
   "text": "که از همه مقامش بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.48,
   "end": 208.3,
   "text": "رتبه‌شو اینطوری فرض کردن و گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.3,
   "end": 215.86,
   "text": "که جبرائیل که یکی از باعظمت‌ترین یعنی جزو ملائکه اربعه‌ست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.86,
   "end": 218.7,
   "text": "که ملک علمه. یعنی علم خدا شده جبرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 218.7,
   "end": 222.22,
   "text": "اینطوری حساب کنید. علم خدا شده جبرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.22,
   "end": 224.66,
   "text": "علم پیغمبر شده جبرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.66,
   "end": 227.72,
   "text": "ایشون آخرین رتبه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.72,
   "end": 233.28,
   "text": "داره در میان ملائکه مقربین و کروبیین آخرین رتبه رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.28,
   "end": 237.3,
   "text": "حسابشو بکنید بین اون همه ملائکه مقربین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.3,
   "end": 240.38,
   "text": "کروبیین ایشون آخرین رتبه رو داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.38,
   "end": 244.74,
   "text": "که مادون اون میشه دیگه بعد از کروبیین ملائکه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.74,
   "end": 250.76,
   "text": "حالا ببینید نسبت رو در میان اون فوج، فوج ملائکه کروبیین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.76,
   "end": 253.4,
   "text": "اولین ملک روحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.4,
   "end": 260.88,
   "text": "که ارتباط میان همه‌ی این اسباب فیض رو با حضرت حق برقرار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.88,
   "end": 266.16,
   "text": "ببینید شما این رتبه رو داشته باشید قشنگ نگاهتون رو عمیق کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.16,
   "end": 274.12,
   "text": "اولین ملک بین این همه وساطت فیض در این کثرات، این همه ملائکه که گفتیم شمارش نمیشه کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 274.12,
   "end": 277.94,
   "text": "اولین ملک که ارتباط با ذات حضرت حق داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.94,
   "end": 281.24,
   "text": "روحه. حالا شما حساب کنید چه شبی عه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.24,
   "end": 283.46,
   "text": "چه درون مایه ای داره این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.46,
   "end": 285.46,
   "text": "که اون روح میاد نازل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.46,
   "end": 290.18,
   "text": "یعنی از اون مرتبه والای والا که غیر قابل تصور ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 290.18,
   "end": 297.22,
   "text": "میاد نازل میشه. حالا ببینید اون آقایی، اون عزیزی که این روح بهش نازل میشه چه عظمتی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 297.22,
   "end": 300.74,
   "text": "که اون در اون مراتب عالیه میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.74,
   "end": 302.74,
   "text": "و نازل میشه بر این آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.74,
   "end": 307.14,
   "text": "و چه شبی‌ست که شده ظرف نزول حضرت روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 307.14,
   "end": 314.4,
   "text": "این چیزی که من الان تو این هفت هشت دقیقه دارم به شما میگم ماحصل حدود سه چهار ساعت مطالعه‌ام از کتاب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 314.4,
   "end": 318.92,
   "text": "بزرگانی مثل حضرت علامه حسن زاده، حضرت امام این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 318.92,
   "end": 320.92,
   "text": "یه آیه ای در قرآن هست به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 320.92,
   "end": 323.42,
   "text": "حالا آیه هشتاد و هفت بقره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 323.42,
   "end": 325.54,
   "text": "که منتسب است به حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.54,
   "end": 328.96,
   "text": "عیسی که و ایدناه بروح القدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.96,
   "end": 333.5,
   "text": "حضرت عیسی با اون عظمتش معید بوده بروح القدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 333.5,
   "end": 337.18,
   "text": "حالا روح القدس کیه؟ حسابشو بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 337.18,
   "end": 343.1,
   "text": "حضرت عیسی که حضرت عیسی شده معید بوده به روح القدس تازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 343.1,
   "end": 349.28,
   "text": "در آیه دو سوره نحل می‌فرماید یُنَزِّلُ الْمَلَائِكَةَ بِالرُّوحِ مِنْ أَمْرِهِ الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.28,
   "end": 357.62,
   "text": "ببینید الملائکه ای که اینجا اومده یعنی همه‌ی ملائکه ای که نازل میشن یُنَزِّلُ الْمَلَائِكَةَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 357.62,
   "end": 360.16,
   "text": "به کمک کی نازل میشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 360.16,
   "end": 364.42,
   "text": "نگفته اینجا و الروح که بگیم ملائکه و روح نازل میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 364.42,
   "end": 370.37,
   "text": "بروح یعنی اون کسی که اینا رو تنزل بهشون میده، سان بهشون میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 370.37,
   "end": 372.31,
   "text": "دستور میده به امر الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 372.31,
   "end": 375.93,
   "text": "اونم من امری. بفرمایید پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 375.93,
   "end": 380.25,
   "text": "کیه؟ حضرت روحه. یعنی همه ملائکه تحت الامر حضرت روح‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 380.25,
   "end": 387.29,
   "text": "الله اکبر. حالا شما کثرت ملائکه رو بگیر ببینید این چه عظمتی داره، چه شدید القوایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 387.29,
   "end": 389.87,
   "text": "حالا حضرت جبرائیل رو میگن شدید القوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 389.87,
   "end": 392.75,
   "text": "اون دیگه چه شدتی داره در قوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.75,
   "end": 399.15,
   "text": "که حضرت جبرائیل و میکائیل و اسرافیل و ملک الموت الله اکبر قابض الارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 399.15,
   "end": 406.89,
   "text": "که مجری اسم قابض الهیه از هر مرتبه مادونی قبض میکنه به مرتبه مافوق میکشونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 406.89,
   "end": 409.95,
   "text": "اون قابض-- اینها همه تحت امرشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 409.95,
   "end": 412.25,
   "text": "الله-- حالا آدم واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 412.25,
   "end": 418.21,
   "text": "میمونه توی این قضایا که ما دیش-- عرض کردیم از مدخل دهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 418.21,
   "end": 421.65,
   "text": "مداخله دوازده گانه علامه قیسری بر شه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 421.65,
   "end": 426.37,
   "text": "بر فصوص ابن عربی عرض کردیم که مظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 426.37,
   "end": 430.79,
   "text": "ذات الهی یا مظهر اسم الله روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 430.79,
   "end": 432.89,
   "text": "حالا شما دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 432.89,
   "end": 435.49,
   "text": "مظهر اسم الله روحه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 435.49,
   "end": 438.55,
   "text": "الله اسم جمعه. همه اسماء درشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 438.55,
   "end": 441.47,
   "text": "اونجایی که قرآن به حضرت آدم می‌فرماید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 441.47,
   "end": 446.29,
   "text": "در خصوص حضرت آدم می‌فرماید و علم آدم الاسماء كلها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 446.29,
   "end": 448.81,
   "text": "همه اسماء رو به آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 448.81,
   "end": 451.73,
   "text": "انبا کردیم و تعلیم دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 451.73,
   "end": 454.21,
   "text": "این همه اسماء می‌شه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 454.21,
   "end": 457.09,
   "text": "یعنی الله رو تعلیم دادیم و حضرت آدم می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 457.09,
   "end": 459.77,
   "text": "مظهری از مظاهر اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 459.77,
   "end": 464.53,
   "text": "اسم الله. حالا اگر همه اسماء در اللهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 464.53,
   "end": 467.59,
   "text": "یه آیه در قرآن هست بین همش دارم آیه قرآن برات می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 467.59,
   "end": 471.31,
   "text": "فط-- اینجا دیگه جمع کنید بحثو تو این شیب بحث ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 471.31,
   "end": 475.11,
   "text": "فطرت الله، فطرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 475.11,
   "end": 479.57,
   "text": "الله التي فطرن ناس علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 479.57,
   "end": 484.61,
   "text": "الناس همه مردم از اون فطرت الله دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 484.61,
   "end": 488.53,
   "text": "فطرت الله چیه؟ همون علم آدم الاسماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 488.53,
   "end": 491.77,
   "text": "یعنی مندمج شده به قول امروزی‌ها MP3 شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 491.77,
   "end": 495.11,
   "text": "حالا بگیم جزئی شده فشرده شده‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 495.11,
   "end": 499.17,
   "text": "اون فطرت که از الله هست و اسم جمعه‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 499.17,
   "end": 502.53,
   "text": "در همه مردم هست. اونم فطرتشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 502.53,
   "end": 506.01,
   "text": "خب اگر این هست چه کسی مظهر روح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 506.01,
   "end": 509.23,
   "text": "مظهر الله بود به سب-- به نحو اعظم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 509.23,
   "end": 511.93,
   "text": "گفتیم روح. در جلسات پیش گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 511.93,
   "end": 518.01,
   "text": "پس ما در وجود خودمون از حضرت روح اعظم که شب قدر نازل می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 518.01,
   "end": 521.61,
   "text": "مظهری داریم، جلوه‌ای داریم که روح ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 521.61,
   "end": 524.31,
   "text": "اینم یک اثبات دیگه بر مدعامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 524.31,
   "end": 527.13,
   "text": "اما حالا ارتباط این روح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 527.13,
   "end": 531.03,
   "text": "دیگه فرصت نیست می‌خواستم این ارتباطو سنجاق کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 531.03,
   "end": 533.91,
   "text": "شیرین بشه اما انشاالله فردا اگه زنده بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 533.91,
   "end": 537.57,
   "text": "که شب قدر هم هست فردا خوب شبی هم بهش رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 537.57,
   "end": 541.35,
   "text": "ارتباط این روح با حضرت زهرا چه گونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.35,
   "end": 545.61,
   "text": "اون موقع برسیم به اونجا که حقیقت لیلة القدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 545.61,
   "end": 547.39,
   "text": "حضرت زهرا سلام الله علیهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 547.39,
   "end": 549.27,
   "text": "اجازه بدید فردا درباره‌ش صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 549.27,
   "end": 552.07,
   "text": "خیلی شیرینه و خیلی به دردمون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 552.07,
   "end": 556.25,
   "text": "شب قدر دیگه این همه نه جلسه ما پیرامون در ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 556.25,
   "end": 558.91,
   "text": "رمضان به صورت نظری حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 558.91,
   "end": 563.29,
   "text": "فردا به سمت دیگه بش-- به صورت عملی می‌شه که حالا چه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.29,
   "end": 568.39,
   "text": "انشاالله عاقبت همه‌مون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 568.39,
   "end": 571.61,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 571.61,
   "end": 576.31,
   "text": "محمد و آل محمد اجمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 576.31,
   "end": 577.99,
   "text": "جمع. الله اکبر. الله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}