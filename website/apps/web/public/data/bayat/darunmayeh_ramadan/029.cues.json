 ],
 "cues": [
  {
   "i": 0,
   "start": 0.7,
   "end": 4.8,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.8,
   "end": 8.7,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.7,
   "end": 11.96,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.96,
   "end": 15.74,
   "text": "استفتای دیگری که پیرامون موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.74,
   "end": 19.06,
   "text": "صوم و روزه داری از رهبر عزیزمون شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.06,
   "end": 21.4,
   "text": "کسی پرسیده که آقا جان من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.4,
   "end": 26.84,
   "text": "روزه که می‌گیرم چون سیگاری هستم و سیگارم نمی‌تونم بکشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.84,
   "end": 34.12,
   "text": "خیلی بداخلاق میشم. بهم فشار میاد، عصبی میشم، تو خونه بد رفتاری می‌کنم و این‌ها طوری که خانواده به تنگ میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.12,
   "end": 38.08,
   "text": "من وظیفه‌م چیه؟ رهبری فرمودن اولا روزه بر شما واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.08,
   "end": 40.68,
   "text": "این مجوز نمیشه که شما روزه نگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.68,
   "end": 44.06,
   "text": "ضمن اینکه باید اخلاق و رفتارشو انسان درست کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.06,
   "end": 46.98,
   "text": "این مجوز بد رفتاری هم نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.98,
   "end": 50.32,
   "text": "اما در خصوص شاید منظور ایشون این باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.32,
   "end": 53.52,
   "text": "اجازه دارم سیگار بکشم یا نه در حین ز-- روزه داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.52,
   "end": 57.84,
   "text": "آقا اینجا فتوا ندادن. فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.84,
   "end": 60.78,
   "text": "احتیاط واجب این است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.78,
   "end": 65.36,
   "text": "شما حق سیگار کشیدن هم ندارید در روزه داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.36,
   "end": 70.5,
   "text": "خب اینجا چون آقا فتوا ندادن مقلدین آقا می‌تونن رجوع کنن به مراجع دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.5,
   "end": 73.14,
   "text": "اما در خصوص اسرار روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.14,
   "end": 85.5,
   "text": "اشاره می‌کنم به یکی از حکمت‌های نهج البلاغه که مولامون امیرالمؤمنین علیه الصلاة والسلام می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.5,
   "end": 97.2,
   "text": "یعنی چه بسیار روزه‌داری که از روزه‌ش جز گرسنگی و تشنگی بهره‌ای نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.2,
   "end": 101.26,
   "text": "و چه بسیار شبزنده‌داری که از شبزنده‌داریش جز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.26,
   "end": 103.34,
   "text": "رنج بیداری چیزی به دست نمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.34,
   "end": 106.94,
   "text": "این سهر با ه دو چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.94,
   "end": 110.0,
   "text": "یعنی بیداری، مطلق بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.0,
   "end": 113.16,
   "text": "لکن خب سحر با ه جیمی میشه همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.16,
   "end": 115.38,
   "text": "ساعت خاص دل شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.38,
   "end": 118.4,
   "text": "حالا بعد حضرت می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.4,
   "end": 121.58,
   "text": "وه هبذا این هبذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.58,
   "end": 129.5,
   "text": "جزو کلمات مدح و ذمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.5,
   "end": 133.6,
   "text": "یعنی اینکه چه نیک است خواب زیرکان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.6,
   "end": 136.78,
   "text": "و چقدر افطارشون نیکوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.78,
   "end": 141.74,
   "text": "خوش و گوارا است که حالا نکاتی اینجا هست که بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.74,
   "end": 148.78,
   "text": "این اشاره به این هست که روزه یک پوسته‌ای داره و یک حد اقلی‌ای که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.78,
   "end": 150.66,
   "text": "تحمل گرسنگی و این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.66,
   "end": 153.34,
   "text": "که البته این دلیل بر این نمیشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.34,
   "end": 156.06,
   "text": "ما استنباط کنیم این هیچ اجری نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.06,
   "end": 159.68,
   "text": "چرا؟ معجور هست روزه‌داری که صرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.68,
   "end": 161.52,
   "text": "گرسنگی رو تحمل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.52,
   "end": 165.98,
   "text": "لکن این تنزل دادن حقیقت روزه و صوم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.98,
   "end": 170.66,
   "text": "ما عرض کردیم روزه یه معنا، به یک معنا کف نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.66,
   "end": 173.2,
   "text": "خب تعال و بیا بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.2,
   "end": 175.52,
   "text": "عرض کردیم روزه خلوص محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.52,
   "end": 179.76,
   "text": "تعال و بیا بالاتر. عرض کردیم روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.76,
   "end": 182.52,
   "text": "معرفت است. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.52,
   "end": 184.88,
   "text": "روزه اصل معرفت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.88,
   "end": 189.72,
   "text": "نهر معرفت است و حتی اشاره کردیم به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.72,
   "end": 196.02,
   "text": "جمله‌ای که معسور از اولیا، حاجی سبزواری علیه الرحمه در اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.02,
   "end": 199.44,
   "text": "صومش میاره. می‌فرماید که ببینید چقدر زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.44,
   "end": 207.84,
   "text": "می‌فرماید روزه ابریست به مانند ابری است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.84,
   "end": 211.2,
   "text": "همین طور حکمت ازش ریزش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.2,
   "end": 216.46,
   "text": "خب من از شما سؤال می‌کنم عزیزان حکمت به دامن چه کسی می‌ریزه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.46,
   "end": 219.42,
   "text": "حکمت به دامن عقل می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.42,
   "end": 223.48,
   "text": "به کسی که کار عقلی بر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.48,
   "end": 228.76,
   "text": "لقمه غذای عقلی از عالم برداشت می‌کنه از کتاب‌های عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.76,
   "end": 232.22,
   "text": "در حقیقت روزه تقویت عقل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.22,
   "end": 235.44,
   "text": "اصلاً شکم پر بخار غذا می‌زنه به مغز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.44,
   "end": 241.58,
   "text": "مغز رو از کار میندازه. کسی با شکم پر نمی‌تونه فهم و دقایق و حقایق کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.58,
   "end": 245.82,
   "text": "با گرسنگی‌ست با البته نه به ش-- به نحوه افراطش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.82,
   "end": 247.94,
   "text": "با حقیقت صوم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.94,
   "end": 254.32,
   "text": "روزه داری‌ست که میشه انسان حقایق رو درک کنه، معارف ظریف رو متوجه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.32,
   "end": 259.64,
   "text": "چرا ما این شب‌ها، امشب هم که شب قدر و شب بیست و یکم ماه مبارک رمضان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.64,
   "end": 264.26,
   "text": "چرا از خدای منان طلب عقل و غذای عقلی و رشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.26,
   "end": 267.58,
   "text": "فکری نکنیم؟ چرا از خدا صرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 267.58,
   "end": 271.28,
   "text": "از امیرالمؤمنین، از امام عصر امشب صرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.28,
   "end": 275.16,
   "text": "شفای مرضامونو طلب کنیم و رفع گرفتاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.16,
   "end": 282.86,
   "text": "مثلا کساد بودن بازارمونو چه می‌دونم این مسائل از حضرت طلب علم و معرفت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.86,
   "end": 286.46,
   "text": "در حقیقت بعد از این قصه وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.46,
   "end": 293.94,
   "text": "باز مرحوم سب-- حاجی سبزواری علیه الرحمه می‌فرمود بلکه بالاتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.94,
   "end": 303.32,
   "text": "بخوانید و بالا برید. از حدیث نبوی میاره که بلکه شما باید به وسیله صوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 303.32,
   "end": 307.06,
   "text": "روحانیین یعنی ملائکت الله که عالم مجرداتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.06,
   "end": 310.76,
   "text": "می‌فرماید متخلق بشید به اخلاق ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.76,
   "end": 316.44,
   "text": "بل بلکه بالاتر تعال و بیایید بالاتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.44,
   "end": 319.64,
   "text": "به اخلاق خدا متخلق بشید با صوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.64,
   "end": 323.64,
   "text": "یکی از اسامی خدا صمد لا یطعم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.64,
   "end": 328.56,
   "text": "یعنی پر، توپری که لا یطعم غذا نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.56,
   "end": 333.02,
   "text": "ملائکه هم از به نظر شما غذای ملائکه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 333.02,
   "end": 337.66,
   "text": "اینکه میگه یا به اخلاق الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 337.66,
   "end": 343.14,
   "text": "یا به اسماء خدا متخلق بشید این‌ها همش سر درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 343.14,
   "end": 350.74,
   "text": "در حقیقت میگه شما سعی کنید بروز و ظهوری از اسم صمد لا یطعم خدا باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 350.74,
   "end": 353.26,
   "text": "یا ز-- ظهور و بروزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 353.26,
   "end": 355.14,
   "text": "از ملائکت الله باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 355.14,
   "end": 359.06,
   "text": "اون‌ها عالم عقلن، آقه-- عالم مجرداتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 359.06,
   "end": 362.07,
   "text": "جنس ملائکه از عقل است عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.07,
   "end": 366.27,
   "text": "در حقیقت اینکه میگه یه وجهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.27,
   "end": 370.89,
   "text": "یعنی اینکه عقلتون رو بارور کنید در این شب‌های عزیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 370.89,
   "end": 375.61,
   "text": "چرا شب قدر یکی از یا بلکه بالاترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.61,
   "end": 380.51,
   "text": "اه فضیلت مخصوص کار علمی و آگاهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 380.51,
   "end": 384.03,
   "text": "گرفتن و غذای عقلی برداشتن از این سفره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 384.03,
   "end": 387.07,
   "text": "میگه متخلق بشید به اخلاق روحانیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 387.07,
   "end": 390.81,
   "text": "آیا ملائکت الله هم غذا میخورن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.81,
   "end": 393.05,
   "text": "طعام و شراب اون‌ها چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 393.05,
   "end": 397.41,
   "text": "اون‌ها که مظهر اسم سبوح و قدس قدوس خدا هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 397.41,
   "end": 405.11,
   "text": "و خودشون فرمودن که تو آیه قرآن بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 405.11,
   "end": 409.61,
   "text": "فرمودن که غذا طعامشون تسبیح است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.61,
   "end": 412.67,
   "text": "شرابشون تقدیس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 412.67,
   "end": 416.15,
   "text": "البته تسبیح به حمد که بحثش قبلاً گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 416.15,
   "end": 424.95,
   "text": "خب اگر ملائکت الله با تسبیح و تقدیس طعام و شراب دارن میگه شما هم اهل ذکر و تسبیح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 424.95,
   "end": 427.11,
   "text": "و تقدیس الهی باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 427.11,
   "end": 431.19,
   "text": "و البته این می‌طلبه کار عقلی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 431.19,
   "end": 435.91,
   "text": "عقل مظهر اسم خبیر و لطیف خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 435.91,
   "end": 441.59,
   "text": "همون که عبارت یا میشه گفت قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 441.59,
   "end": 445.39,
   "text": "عبارتی قرآن است که این هم بحثش قبلاً گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 445.39,
   "end": 450.53,
   "text": "خب این نشون میده که ما باید سعی کنیم رشد کنیم و کار عقلی انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 450.53,
   "end": 453.27,
   "text": "شما تصور کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 453.27,
   "end": 457.81,
   "text": "یک مورچه‌ای روی صفحه کاغذ نشسته جوهرها رو فقط میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 457.81,
   "end": 460.37,
   "text": "یه نگاه سطحی داره نه عمقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 460.37,
   "end": 464.77,
   "text": "فقط جوهر رو کاغذ رو میبینه که داره نقش میکشه رو کاغذ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 464.77,
   "end": 469.97,
   "text": "با کلمات و الفاظ. خب این مورچه میگه این جوهره که داره این رو مینویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 469.97,
   "end": 472.19,
   "text": "در حالی که تو باید بهش بگی تعالى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 472.19,
   "end": 475.25,
   "text": "بیا بالا نگاهتو به بالا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 475.25,
   "end": 478.39,
   "text": "این جوهر نیست قلم داره مینویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 478.39,
   "end": 481.37,
   "text": "باز هم بیا بالاتر. بلکه بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 481.37,
   "end": 486.31,
   "text": "این قلم نیست. قلم در میان انگشتان انگشت داره مینویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 486.31,
   "end": 489.37,
   "text": "بیا بالاتر. بلکه کف دسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 489.37,
   "end": 493.03,
   "text": "بیا بالاتر. این دست بازوها حرکتش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 493.03,
   "end": 497.29,
   "text": "بیا بالاتر. بلکه بدن یک بدن داره این رو مینویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 497.29,
   "end": 499.57,
   "text": "بلکه این بدن مغزی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 499.57,
   "end": 501.79,
   "text": "مغزه که داره اراده میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 501.79,
   "end": 506.15,
   "text": "بعد سؤال پیش میاد. سؤال پیش میاد که حاج آقا خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 506.15,
   "end": 509.55,
   "text": "حیوانات هم مغز دارن بدن دارن اونا چرا نمی‌نویسن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 509.55,
   "end": 511.99,
   "text": "ببینید این کار این سیر عقلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 511.99,
   "end": 515.41,
   "text": "از اون اه از شبد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 515.41,
   "end": 519.65,
   "text": "اه عرض‌ها انسان پی به ذاتی ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 519.65,
   "end": 522.17,
   "text": "در حقیقت سؤال میشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 522.17,
   "end": 525.29,
   "text": "خب راست میگه حاج آقا حیوانات هم بدن دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 525.29,
   "end": 530.65,
   "text": "عقل دارن. خب پی می‌بریم که انسان یک نفس ناطقه‌ای مافوق بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 530.65,
   "end": 532.67,
   "text": "نشئه طبیعت خودش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 532.67,
   "end": 534.83,
   "text": "این نفس ناطقه است که اراده میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.83,
   "end": 536.61,
   "text": "حالا دوباره سؤال پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 536.61,
   "end": 539.33,
   "text": "آیا این نفس ناطقه استقلال داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 539.33,
   "end": 541.11,
   "text": "اراده‌ش ذاتیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.11,
   "end": 543.63,
   "text": "میگیم نخیر اینم عارضیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 543.63,
   "end": 548.85,
   "text": "تا می‌رسی به که دیگه اوج این قله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 548.85,
   "end": 552.07,
   "text": "ببینید این یه کار عقلیه. این کار علمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.07,
   "end": 561.41,
   "text": "در حقیقت روزه و صوم این حرکت رو در انسان ایجاد میکنه که انسان دائماً پله‌های ترقی، آگاهی و معرفت رو بره بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 561.41,
   "end": 563.55,
   "text": "خب س-- فرصت من تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.55,
   "end": 570.95,
   "text": "لکن چون شب قدر است یک بهره شب قدری ببریم که مرتبط با بحثمون هم البته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 570.95,
   "end": 575.87,
   "text": "لحظاتی تأمل بفرمایید ببینید اسبق بن نواته که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 575.87,
   "end": 578.47,
   "text": "بهترین شاگردان مولا بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 578.47,
   "end": 580.69,
   "text": "لحظات آخر مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 580.69,
   "end": 583.37,
   "text": "چه استفاده و بهره عقلی از آقا بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 583.37,
   "end": 590.55,
   "text": "تشریف آوردن زانو زدن خدمت حضرت و اون حال و نظر که خودشون توصیف می‌کنند و مفصل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 590.55,
   "end": 594.65,
   "text": "که اون دستمال زردی که به پیشانی بسته بود مولا تشخیص ندادن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 594.65,
   "end": 597.27,
   "text": "دستمال زرد تر از چهره حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 597.27,
   "end": 601.75,
   "text": "بعد پرسید از حضرت طلب غذای عقلی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 601.75,
   "end": 605.99,
   "text": "حضرت فرمودن که اتفاقاً لحظات آخر عمر پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 605.99,
   "end": 608.17,
   "text": "من از پیغمبر خواستم با من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 608.17,
   "end": 610.77,
   "text": "تکلم کنه. کلمه‌ای به من بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 610.77,
   "end": 613.09,
   "text": "حکمتی به من بیاموزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 613.09,
   "end": 615.35,
   "text": "دقیقاً همین سؤال شما رو از پیغمبر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 615.35,
   "end": 620.57,
   "text": "پیغمبر فرمود علی جان برو مسجد به این مردم بگو از رحمت خدا به دور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 620.57,
   "end": 623.69,
   "text": "لعنت خدا یعنی ره دوری از رحمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 623.69,
   "end": 628.37,
   "text": "از رحمت حق. لعنت خدا بر کسی که آغ والدین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 628.37,
   "end": 633.53,
   "text": "علی جان برو به این مردم بگو ره لعنت خدا بر عبدی که از مولاش فرار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 633.53,
   "end": 637.47,
   "text": "علی جان به این مردم بگو لعنت خدا بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 637.47,
   "end": 641.37,
   "text": "اون کسانی که کسی را اجیر کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 641.37,
   "end": 643.13,
   "text": "و اجر و مزدش رو ندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 643.13,
   "end": 646.31,
   "text": "مولامون امیرالمؤمنین علیه السلام تشریف بردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 646.31,
   "end": 651.09,
   "text": "از طرف پیغمبر تو مسجد فریاد زدن به همه این خبر رو دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 651.09,
   "end": 657.45,
   "text": "بعد ببینید چند تا یه تک و توکی از این اصحاب نکته سنج دیدن اصلاً این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 657.45,
   "end": 660.85,
   "text": "حرف، حرف پیغمبر باطن داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 660.85,
   "end": 663.69,
   "text": "مغز داره؟ دنبال غذای عقلی می‌گشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 663.69,
   "end": 666.05,
   "text": "گفتن یا علی علی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 666.05,
   "end": 671.55,
   "text": "همه این مطالبی که شما فرمودی عالی اما باطنشم شرح بدید به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 671.55,
   "end": 673.65,
   "text": "بذارید عقل ما بارور بشه حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 673.65,
   "end": 677.55,
   "text": "قربون ادب آقا که همه علم تو سینه شه اما چیزی نگفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 677.55,
   "end": 683.03,
   "text": "برگشت مس و محضر پیغمبر پرسید که مردم شرح می‌خوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 683.03,
   "end": 688.47,
   "text": "پیغمبر فرمودن که علی جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 688.47,
   "end": 691.63,
   "text": "من و دو من و تو دو پدر این امتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 691.63,
   "end": 696.53,
   "text": "خدا لعنت کنه اون کسی رو که آغ من و تو که پدرشونیم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 696.53,
   "end": 699.53,
   "text": "ببینید تو قرآن این یعنی رفتن یه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 699.53,
   "end": 702.29,
   "text": "یه لایه پنهان‌تر معارف رو دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 702.29,
   "end": 705.69,
   "text": "این یعنی غذای عقلی برداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 705.69,
   "end": 708.17,
   "text": "چقدر زرک بوده اسبق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 708.17,
   "end": 712.67,
   "text": "که البته وقتی که به اینجا می‌رسه تو روایت هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 712.67,
   "end": 721.09,
   "text": "مولا انگشت اسبق رو می‌گیره محکم می‌کشه و میگه همینطور پیغمبر انگشت منو گرفت و کشوند و فرمود علی جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 721.09,
   "end": 723.97,
   "text": "لعنت خدا بر کسی که آغ من و تو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 723.97,
   "end": 726.75,
   "text": "علی جان به مردم بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 726.75,
   "end": 733.99,
   "text": "که اه من و تو مولای این‌ها ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 733.99,
   "end": 738.33,
   "text": "خدا لعنت کنه اون بنده‌ای رو که از ما فراری باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 738.33,
   "end": 741.53,
   "text": "خب چقدر ما الان از امام عصرمون فراری هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 741.53,
   "end": 748.91,
   "text": "علی جان خ من و تو اجیر این مردم شدیم تا اونا رو به راه هدایت و ارشاد و صلاح و فلاح دعوت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 748.91,
   "end": 756.99,
   "text": "خدا لعنت کنه اونایی که اجر ما رو ندادن و چه اجری هم دادن این ایام بعد از پیغمبر با دخترش چه کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 756.99,
   "end": 759.09,
   "text": "با امیرالمؤمنین تو این ایام چه کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 759.09,
   "end": 761.23,
   "text": "و بعداً با بچه‌هاش چه کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 761.23,
   "end": 763.87,
   "text": "انشاالله که عاقبت ما ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 763.87,
   "end": 766.31,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}