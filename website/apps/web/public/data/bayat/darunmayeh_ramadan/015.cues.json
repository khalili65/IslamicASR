 "chapters": [
  {
   "index": 0,
   "title": "## هدیه به روحِ نادر طالب‌زاده",
   "start": 0.3,
   "end": 87.92
  },
  {
   "index": 1,
   "title": "بحث بر درون‌مایهٔ ماهِ رمضان است. آیهٔ دهمِ فاطر:",
   "start": 87.92,
   "end": 110.02
  },
  {
   "index": 2,
   "title": "«إن روح المؤمن أشد اتصالاً بروح الله من اتصال شعاع الشمس بها.»",
   "start": 110.02,
   "end": 189.46
  },
  {
   "index": 3,
   "title": "## روحِ اعظم در شبِ قدر و سعهٔ رمضان",
   "start": 189.46,
   "end": 240.04
  },
  {
   "index": 4,
   "title": "## دفاع از معارفِ عقلی و عرفانی",
   "start": 240.04,
   "end": 539.56
  },
  {
   "index": 5,
   "title": "## لطفِ خدا در بعثتِ صدرا",
   "start": 539.56,
   "end": 559.98
  },
  {
   "index": 6,
   "title": "## تجربهٔ میدانِ معرفت نفس",
   "start": 559.98,
   "end": 698.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 2.14,
   "text": "[سخنگوی 1] و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.14,
   "end": 5.42,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.42,
   "end": 11.32,
   "text": "و ربانی آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.32,
   "end": 14.1,
   "text": "بحث امروزمون رو هدیه می‌کنم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.1,
   "end": 17.88,
   "text": "روح مرحوم نادر طالب‌زاده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.88,
   "end": 20.16,
   "text": "به یک روایت هم شهید حسابش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.16,
   "end": 22.52,
   "text": "به هر حال توره بی-- این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.52,
   "end": 25.12,
   "text": "ترور اِاَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 25.12,
   "end": 28.8,
   "text": "عرض شود حالا امروز ساعت چهار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 28.8,
   "end": 30.78,
   "text": "دو تا چهار ها آقای؟ [سخنگوی 2] چهار تا شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 30.78,
   "end": 33.66,
   "text": "[سخنگوی 1] چهار تا شش تو معراج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 33.66,
   "end": 36.34,
   "text": "برنامه دارن براش. انشاالله هر کی تونست بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 36.34,
   "end": 39.12,
   "text": "به هر حال گردن جبهه‌ی انقلاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 39.12,
   "end": 42.6,
   "text": "حق دارن. ایشون خیلی زحمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 42.6,
   "end": 45.68,
   "text": "جبهه‌ی انقلاب رو کشیدن. خودشونم بچه انقلابی و من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 45.68,
   "end": 50.08,
   "text": "خودم در اون حد نیستم که از روح بلند ایشون حرفی بزنم و تقدیر کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 50.08,
   "end": 53.12,
   "text": "فقط حرف‌های نورانی امروزمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 53.12,
   "end": 54.68,
   "text": "هدیه می‌کنیم خدمت ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 54.68,
   "end": 59.82,
   "text": "انشاالله از ما بپذیره. بحث ما پیرامون درون‌مایه ماه مبارک رمضان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 59.82,
   "end": 62.66,
   "text": "یک آیه ای رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 62.66,
   "end": 68.16,
   "text": "آیه ده سوره فاطر \"الْهِ يَسْعَدُ الْكَلِمُ الطَّیِّبُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 68.16,
   "end": 71.44,
   "text": "بالا میره کلمه طیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 71.44,
   "end": 75.92,
   "text": "پاک \"وَالْعَمَلُ الصَّالِحُ یَرْفَعُهُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 75.92,
   "end": 79.58,
   "text": "عمل صالح هم اونو بالاترش می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 79.58,
   "end": 82.7,
   "text": "صدر‌الدین قونوی امروز اتفاقاً نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 82.7,
   "end": 84.8,
   "text": "دویست پنجاه و یک هزار و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 84.8,
   "end": 92.14,
   "text": "نکته علامه رو که می‌خوندم دیدم اونجا اتفاقاً هم از صدر‌الدین قونوی یه کتاب شریفی داره به نام نفحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 92.14,
   "end": 95.44,
   "text": "علامه از نفحه چهارم اون کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 95.44,
   "end": 98.78,
   "text": "و هم از مرحله چهارم اسفار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 98.78,
   "end": 101.74,
   "text": "کلام این بزرگان را آورده بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 101.74,
   "end": 104.34,
   "text": "منظور از این و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 104.34,
   "end": 107.34,
   "text": "این \"إِلَهِ یَسْعَدُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 107.34,
   "end": 112.66,
   "text": "کَلِمُ الطَّیِّبِ\" این کلمه طیب رو روح مؤمن گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 112.66,
   "end": 117.52,
   "text": "و فرمودن \"الْكَلِمُ الطَّیِّبُ عَلَى الْأَرْوَاحِ الطَّاهِرَةِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 117.52,
   "end": 120.32,
   "text": "جان‌ها و روح‌های پاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 120.32,
   "end": 122.58,
   "text": "حالا این رو بذارید کنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 122.58,
   "end": 129.16,
   "text": "این حدیث بسیار قشنگ که فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 129.16,
   "end": 137.72,
   "text": "روح مؤمن این حدیث رو در می‌تونید در کتاب کافی جلد دو صفحه صد و شصت و شش بنویسید-- ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 137.72,
   "end": 140.32,
   "text": "\"إِنَّ رُوحَ الْمُؤْمِنِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 140.32,
   "end": 142.8,
   "text": "همه شما انشاالله مؤمنید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 142.8,
   "end": 150.62,
   "text": "روح شما چگونه است؟ \"أَشَدُّ اتِّصَالًا بِرُوحِ اللهِ مِنْ اتِّصَالِ شُعَاعِ الشَّمْسِ بها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 150.62,
   "end": 155.38,
   "text": "شعاع شمس این پرتو نور شمس چگونه ارتباط داره با خورشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 155.38,
   "end": 162.42,
   "text": "میگه روح مؤمن شدت اتصالش با روح الله از این شدیدتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 162.42,
   "end": 165.2,
   "text": "اصلاً جدا و لا ینفك نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 165.2,
   "end": 167.64,
   "text": "یه از این جدایی ناپذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.64,
   "end": 172.82,
   "text": "لا ینفك اصلاً جدایی بین روح مؤمن و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 172.82,
   "end": 183.28,
   "text": "منبع، مخز الله \"إِنْ مِنْ شَيْءٍ إِلَّا عِنْدَنَا خَزَائِنُهُ\" از اون خزانه اصلی که مرتبه احدیت نظام هستی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.28,
   "end": 185.54,
   "text": "و روح الله هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 185.54,
   "end": 187.78,
   "text": "امکانش نیست این جدایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 187.78,
   "end": 192.86,
   "text": "حالا شما دقت بفرمایید روح اعظم شب قدر تشریف میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 192.86,
   "end": 195.26,
   "text": "باز دوباره برگردیم به اون بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 195.26,
   "end": 201.26,
   "text": "که در حقیقت اون میاد ما رو به حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.26,
   "end": 205.68,
   "text": "اصلیمون، اون مبدأمون، مخزمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.68,
   "end": 211.28,
   "text": "منبعمون چی بگم؟ از مرتبه والایی که از اونجا نازل شدیم \"إِنَّا لِلَّهِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.28,
   "end": 215.7,
   "text": "وَإِنَّا إِلَيْهِ رَاجِعُونَ\" دو مرتبه قراره به اونجا برگردیم، یادآوری کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.7,
   "end": 219.18,
   "text": "این تو عالم هستی در این نشئه رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.18,
   "end": 221.3,
   "text": "هر کس که نزدیک‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 221.3,
   "end": 227.34,
   "text": "قرب داره، قرب هم یعنی تلبس به اسماء الله لباس‌های اسماء الهی رو به تن کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.34,
   "end": 229.96,
   "text": "یا قرب یعنی ولایت، ولایت پذیرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.96,
   "end": 234.4,
   "text": "اینا رو همه رو قبلاً ت-- ما تبیین کردیم در بحث‌هامون و سایر بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.4,
   "end": 237.32,
   "text": "هرکی اینو بیشتر داره اونو بیشتر می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.32,
   "end": 244.28,
   "text": "اون ارتباط روح رو در شب قدر و در کل این ماه رمضان که یه همچین سعه‌ی وجودی این ماه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.28,
   "end": 248.58,
   "text": "پیدا می‌کنه لذا قریب العهد می‌شه به مبدأ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.58,
   "end": 251.7,
   "text": "میره نزدیک می‌شه به مبدأ، به خدا نزدیک‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 251.7,
   "end": 254.32,
   "text": "شما ببینید دست پای شیطون بسته تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.32,
   "end": 256.42,
   "text": "اصلاً یه ماه بسیار عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 256.42,
   "end": 259.02,
   "text": "حالا این مباحثی که من میگم بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 259.02,
   "end": 262.46,
   "text": "شاید حالا جسارت نشه، خوششون نیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.46,
   "end": 268.32,
   "text": "کما این که بعضیا میگن آقا یه حدیث بخون بر-- برو بابا اینقدر چی میگی تو خودتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 268.32,
   "end": 273.68,
   "text": "شلوغش کردی و فلان و مثلاً ها خوندی که بدی یه حدیث بگه و بره اونو خیلی بیشتر دوست دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.68,
   "end": 279.96,
   "text": "یا مخصوصاً داستان. چون با قوه مثال و خیال آدم مرتبطه خوب می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.96,
   "end": 282.5,
   "text": "مثال و ق-قصه و داستان و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.5,
   "end": 286.42,
   "text": "در حالی که اجازه بدید من حالا درد دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.42,
   "end": 287.96,
   "text": "چیزی من براش-- کاری نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 287.96,
   "end": 294.42,
   "text": "برای من یه کتاب حدیثی مجامع روایی دستم بگیرن مثلاً توحید صدوق که اونم خیلی ارزشمند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.42,
   "end": 299.04,
   "text": "اما از روی حدیث بخونم نه خودمو خسته کنم نه شما رو حاج و واج پاشم برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.04,
   "end": 301.32,
   "text": "کاری داره؟ مثلاً برای من کاری داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 301.32,
   "end": 304.3,
   "text": "باور کنید برای هر ده دقیقه صحبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 304.3,
   "end": 311.76,
   "text": "واقعاً اغراق نمی‌کنم به فضل الهی سه ساعت مطالعه و تحقیق می‌کنم برای ده دقیقه حرف که اینجا برای شما می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.76,
   "end": 313.82,
   "text": "بعد این روانی‌ست پس بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.82,
   "end": 318.4,
   "text": "یعنی واقعاً هم منو خسته کنیم هم خودتون پس بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.4,
   "end": 321.8,
   "text": "اتفاقاً امروز در ز-- جلسه صد و دوازده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.8,
   "end": 324.7,
   "text": "شرح فصوص الحکم علامه طباطبایی فرمودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.7,
   "end": 331.9,
   "text": "از ایشون شنیدم که فرمودن تا اینجور مطالب رو شما ندونید، همین حکمت متعالی عرفان این‌ها رو ندونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.9,
   "end": 336.48,
   "text": "به اون درون مایه و سر روایت اهل بیت هم دسترسی پیدا نمی‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.48,
   "end": 339.32,
   "text": "یه پوسته ظاهری ازش متوجه می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.32,
   "end": 345.06,
   "text": "حتی یه جا دیگه مخصوصاً نوشتمش در کتاب مفاتیح الاسرار که تعلیقات بر اسفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.06,
   "end": 349.16,
   "text": "از تعالمه نوشتن. از رو براتون بخونم به جانم سوگند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.16,
   "end": 354.54,
   "text": "ببینید یه شخص جامع الاسراف که نیست علمی که اون براش قلم نزده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.54,
   "end": 356.3,
   "text": "و تخصص کامل درش داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.3,
   "end": 359.66,
   "text": "آدم پشت سر عالم جامع الاسراف باید راه بیفته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.66,
   "end": 363.24,
   "text": "نه هر بچه طلبه بی‌سوادی مثل من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.24,
   "end": 369.1,
   "text": "به جانم سوگند آنکه خود را از کتب عقلی و صحف عرفانی، همینه که ما داریم بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.1,
   "end": 372.66,
   "text": "میگیم آقا از این کتاب و از اون کتاب، همینی که ما منبع میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 372.66,
   "end": 379.0,
   "text": "به جانم سوگند آنکه خود را از کتب عقلی و صحف عرفانی که دست‌های نورانی آن‌ها را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.0,
   "end": 384.12,
   "text": "اهدا کرده است، یعنی دست‌های نورانی حکما مثل ملاصدرا که در کهک قم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 384.12,
   "end": 390.38,
   "text": "تبعید شد، فرمود من این اسفار رو با اشک چشمم سحرها چندین سال اشک ریختم گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.38,
   "end": 393.66,
   "text": "قریب به هزار جلد کتاب‌های محی الدین عربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.66,
   "end": 395.66,
   "text": "من یه جلد کتاب تو زندگیم ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.66,
   "end": 399.68,
   "text": "هزار جلد کتاب نوشته. میگه همه رو از سجاده دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.68,
   "end": 401.62,
   "text": "میگه اینا همه دست‌های نورانی بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.62,
   "end": 405.12,
   "text": "علامه میگه. دوری کن-- کسی که از اینا دوری کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.12,
   "end": 408.48,
   "text": "بعد مثال میزنه مثل تمهید القواعد ابن ترکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.48,
   "end": 414.6,
   "text": "مثل عرض شود شرح خواجه طوسی بر اینها مثل، مثل با العنس ابن فناری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.6,
   "end": 419.76,
   "text": "بعد صرح العیون خودش رو میگه که مت-- تخصصی‌ترین کتاب معرفت نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.76,
   "end": 426.72,
   "text": "عرض شود اسفار ملاصدرا، فصوص و فتوحات ابن عربی، ا-اشارات و شفای شیخ الرئیس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 426.72,
   "end": 432.84,
   "text": "آقای بچه‌های بسیجی‌ها، انقلابی‌ها، اینایی که دم می‌زنیم از رهبر و خودمون رو کشتیم برای آقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.84,
   "end": 440.64,
   "text": "رهبر و بنیانگذار جمهوری اسلامی ایران و شرق و غرب و دانشمندان رو جده دعوت کرد سر کتابای همینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 440.64,
   "end": 443.2,
   "text": "و همین شیخ الرئیس و ابن عربی و کتابای اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.2,
   "end": 450.02,
   "text": "بعد من و شما بچه‌های یتیم یکی از این حرفا تا میزنه دکش میزنیم-- می‌کنیم مثلا تو سرش می‌کوبیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.02,
   "end": 452.5,
   "text": "وقت ما رو گرفتی. این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 452.5,
   "end": 456.32,
   "text": "ایشون ببینید به جان خودش سوگند خورده علامه حسن زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.32,
   "end": 464.24,
   "text": "کسی که این کتابا رو، این سیر حکمت متعالیه و عرفان نظری که بکشه به عمل رو پیگیری نکرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 464.24,
   "end": 467.26,
   "text": "فرمودن همانا خود را از فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 467.26,
   "end": 469.8,
   "text": "خطاب محمدی دور کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.8,
   "end": 474.6,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 474.6,
   "end": 476.98,
   "text": "خطاب محمدی منظور قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.98,
   "end": 482.7,
   "text": "میگه از فهم قرآن خودش رو دور کرده و جان خود را از نیل به سعادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.7,
   "end": 485.82,
   "text": "قصوای خودش محروم ساخته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.82,
   "end": 492.48,
   "text": "اتفاقا خود علامه فرمودن یه بار هم فکر می‌کنم براتون گفتم که با علامه طباطبایی استادش بوده علامه طباطبایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 492.48,
   "end": 495.52,
   "text": "می‌رفتن در خ-- تا در خونه مشایعت می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 495.52,
   "end": 498.36,
   "text": "علامه طباطبایی می‌خواست بره یه آهی کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.36,
   "end": 500.52,
   "text": "این کوه عظمت و عرفان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 500.52,
   "end": 507.42,
   "text": "آه کشید فرمود که این همه‌ی حکما و عرفا مثل ملاصدرا، ابن عربی،‌ها، شیخ الرئیس‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 507.42,
   "end": 513.86,
   "text": "آقا جون کندن، سنگ حوادث خوردن، تهمت خوردن، لعن و نفرین و تبعید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 513.86,
   "end": 518.68,
   "text": "اما اون حرفی که حق بود رو نوشتن و گفتن که حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.68,
   "end": 521.2,
   "text": "همین است و لاغیر. حالا بریم باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 521.2,
   "end": 527.74,
   "text": "صرفا به یه پوسته یک روایت و آیه که نمی‌فهمیم درون مایه ش چیه هی بسنده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 527.74,
   "end": 529.5,
   "text": "خود کلاه سر خودمون گذاشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 529.5,
   "end": 533.06,
   "text": "اینا جون کردن با ذره‌بین طهارت نفس اینا رو نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 533.06,
   "end": 535.4,
   "text": "چرا دنبال اینا نریم؟ چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 535.4,
   "end": 538.16,
   "text": "یا مثلا خود عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 538.16,
   "end": 541.92,
   "text": "ش-- ملاصدرا استاد علامه حسن زاده، مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 541.92,
   "end": 545.76,
   "text": "علامه شهرانی. من میگم شهرانی یه چیزی، من میگم شما یه چیزی می‌شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 545.76,
   "end": 548.04,
   "text": "اصلا نمونه نداشته این بزرگوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.04,
   "end": 554.6,
   "text": "جامع منقول و معقول. به خود علامه حسن زاده فرموده بودند که ملاصدرا لطف خدا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.6,
   "end": 559.98,
   "text": "در وقتی حدود چهارصد سال پیش که اصلا عقل تعطیل بود، کسی کار فکری نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 559.98,
   "end": 562.14,
   "text": "همه دنبال قصه و داستان بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.14,
   "end": 566.9,
   "text": "اصلا تعطیل شده بود مباحث فکری خدا ایشون رو به عنوان لطف خودش فرستاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 566.9,
   "end": 574.76,
   "text": "اونایی که تو سیر مباحث عقلی و اعتقادی هستن، می‌دونید قاعده ل-- قاعده لطف یعنی امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 574.76,
   "end": 578.06,
   "text": "یعنی خدا ایشون رو فرستاد پیشوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 578.06,
   "end": 580.46,
   "text": "عقول باشه در غیبت امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 580.46,
   "end": 583.32,
   "text": "بعد حالا ما پس بزنیم. اینا رو پس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 583.32,
   "end": 587.92,
   "text": "به هر حال یه نهیبی من درد دلی کردم از خودم بر شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 587.92,
   "end": 591.04,
   "text": "چون به هر حال نه اینجا، هر جا میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 591.04,
   "end": 594.02,
   "text": "بالاخره حرف و حدیث زیاد میشنویم اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 594.02,
   "end": 598.68,
   "text": "من یه سی ثانیه بهم وقت بدید یه چیزی به شما بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 598.68,
   "end": 602.7,
   "text": "سی سال منبر رفتم. به اون حالت متعارف که شما میگید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 602.7,
   "end": 611.08,
   "text": "خیلی هم منبر رفتم. از وقتی که از حضرت استاد علامه یه کاری با ما کرد، یه بلایی سر ما درآورد، یه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 611.08,
   "end": 613.42,
   "text": "اینها حالا بماند داستان داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 613.42,
   "end": 619.42,
   "text": "این چند وقتی که افتادیم تو دام ایشون، دام عشق ایشون، دام معارف ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 619.42,
   "end": 623.14,
   "text": "خروجی‌ای که من از منبرام گرفتم، از اون سی سال نگرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 623.14,
   "end": 625.78,
   "text": "باور کنید در تجربه میدانیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 625.78,
   "end": 631.62,
   "text": "من تو فامیلامون آدم‌هایی که نماز نمی‌خونن، امام و رهبر و انقلاب رو اصلا قبول ندارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 631.62,
   "end": 634.34,
   "text": "به خط کردم. تجربه میدانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 634.34,
   "end": 641.66,
   "text": "همین معرفت نفس علامه رو که شاید اکثر ما ندیدیمش چون مباحث کاملا عقلیه صد و پنجاه و سه درصد اولش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 641.66,
   "end": 644.18,
   "text": "اصلا حرف از آیه و حدیث توش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 644.18,
   "end": 645.8,
   "text": "اونا رو براشون پیاده کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 645.8,
   "end": 650.8,
   "text": "باور کنید به جلسه سیزدهم این درس معرفت نفس رسیدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 650.8,
   "end": 652.68,
   "text": "این‌ها به نماز خوندن افتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 652.68,
   "end": 656.76,
   "text": "الان دارن روزه می‌گیرن و برای رهبر و انقلاب ما احترام قائلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 656.76,
   "end": 661.48,
   "text": "مباحث کاملا عقلیه. حالا ما پس بزنیم، مسخره کنیم اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 661.48,
   "end": 668.82,
   "text": "یه آخوندی مثل ما مثلاً که نه دایه‌ای داره، هرچی هم میگه از بزرگان و از خودش حرفی نداره رو پس بزنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 668.82,
   "end": 670.68,
   "text": "دنبال یکی باشیم برای ما داستان بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 670.68,
   "end": 673.52,
   "text": "اونا هم جسارت نشه. اونا هم جاشون رو سر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 673.52,
   "end": 676.22,
   "text": "همه عزیزان. اما ما آخونده هم شما رو بد کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 676.22,
   "end": 679.9,
   "text": "انقدر که قصه گفتیم شما بد عادت شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 679.9,
   "end": 684.92,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 684.92,
   "end": 687.76,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 687.76,
   "end": 689.96,
   "text": "محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 689.96,
   "end": 693.96,
   "text": "محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 693.96,
   "end": 696.04,
   "text": "اشهد ان لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 696.04,
   "end": 698.04,
   "text": "اشهد ان لا اله الا الله. اشهد ان محمد رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}