 },
 "chapters": [
  {
   "index": 0,
   "title": "## نزولِ ملائکه در رمضان و صغیرِ نفس",
   "start": 9.9,
   "end": 75.38
  },
  {
   "index": 1,
   "title": "## علم آبِ روح؛ عمل نانِ روح",
   "start": 75.38,
   "end": 95.68
  },
  {
   "index": 2,
   "title": "## تتنزّل علیهم الملائکة؛ نه یک ملک",
   "start": 95.68,
   "end": 373.4
  },
  {
   "index": 3,
   "title": "## پیاده‌کردنِ اسماء و شدّتِ نزول در رمضان",
   "start": 373.4,
   "end": 442.2
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 2.38,
   "text": "الله يا داعي الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.38,
   "end": 4.76,
   "text": "و رباني آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 4.76,
   "end": 8.0,
   "text": "سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.0,
   "end": 12.48,
   "text": "بحث ما این بود که بر اساس آیه شریفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.48,
   "end": 15.64,
   "text": "تنزل الملائكة والروح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.64,
   "end": 18.18,
   "text": "در ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 18.18,
   "end": 23.7,
   "text": "ملائکه بیش از پیش نازل می‌شوند و امکان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.7,
   "end": 27.28,
   "text": "ارتباط با ملائکه شدت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.28,
   "end": 31.56,
   "text": "به عبارتی امکان ارتباط با ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 31.56,
   "end": 37.5,
   "text": "زیاد می‌شه. ظرفیت و درون مایه ماه مبارک رمضان این چنین است و عرض شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.5,
   "end": 42.78,
   "text": "طبق فرمایش حضرت استاد علامه علیه الرحمه، علامه حسن زاده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.78,
   "end": 47.2,
   "text": "اون حقیقتی که متمثل می‌شه در صغیر نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.2,
   "end": 51.32,
   "text": "اون همون نزول ملک است و بر ما نازل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.32,
   "end": 55.28,
   "text": "آیا آیه‌ای در قرآن داریم که صراحتا از نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.28,
   "end": 58.8,
   "text": "ملائکه بر ما سخن گفته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.8,
   "end": 61.72,
   "text": "که احتیاجی به تفسیر و اینها هم نداشته باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.72,
   "end": 66.4,
   "text": "از صریح آیه قرآن بفهمیم که پس ملائک بر ما هم نازل می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.4,
   "end": 68.76,
   "text": "بله. آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.76,
   "end": 70.84,
   "text": "سی تا سی و دو سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.84,
   "end": 73.86,
   "text": "فصلت رو اگر ملاحظه بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 73.86,
   "end": 77.74,
   "text": "می‌فرماید \"إن الذين قالوا ربنا الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 77.74,
   "end": 81.14,
   "text": "قطعاً اون کسانی که گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 81.14,
   "end": 84.5,
   "text": "پروردگار ما الله هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 84.5,
   "end": 86.94,
   "text": "و \"واستقاموا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 86.94,
   "end": 89.56,
   "text": "این \"واستقاموا\" شرط دومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 89.56,
   "end": 101.72,
   "text": "شرط اول اینه که با علم و آگاهی و معرفت به اینجا برسن که ربشون الله که می‌شه همون ایمان، دلدادگی، بحث علمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.72,
   "end": 108.1,
   "text": "بحث معرفته. این قسمت دوم که \"واستقاموا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.1,
   "end": 110.02,
   "text": "می‌شود عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.02,
   "end": 114.98,
   "text": "پس می‌شه در پس علم و عمل درست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.98,
   "end": 118.24,
   "text": "استقامت ورزیدن و در مسیر حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.24,
   "end": 121.38,
   "text": "چه اتفاقی می‌افته که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.38,
   "end": 125.72,
   "text": "علم برای ما به منزله‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.72,
   "end": 132.32,
   "text": "آب است برای بدن. عمل برای روح ما به منزله‌ی نان است برای بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.32,
   "end": 139.28,
   "text": "یعنی چی؟ همونطور که بدن ما آب و نان داره، دارو و درمان داره بدن، جسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.28,
   "end": 141.68,
   "text": "روح هم آب و نان می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.68,
   "end": 147.4,
   "text": "دارو و درمان می‌خواد. غذای جسم ما، بدن ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.4,
   "end": 153.56,
   "text": "آب و نانش چیه؟ همین آب و نان متعارفی که می‌خوریم غذای جسم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.56,
   "end": 159.9,
   "text": "از گندم و آب فلان... اما دارو و درمانش هم که مشخصه مریض که می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.9,
   "end": 164.16,
   "text": "روح چگونه است؟ حکما فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.16,
   "end": 166.52,
   "text": "نا-- آب روح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.52,
   "end": 170.0,
   "text": "آب روح، آب نفس ناطقه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.0,
   "end": 175.28,
   "text": "علمه. اینجا می‌فرماید \"إن الذين قالوا ربنا الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.28,
   "end": 178.4,
   "text": "به این علم و معرفت رسیدن این آبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.4,
   "end": 181.24,
   "text": "آب گوارا غذای رو-- آب روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.24,
   "end": 182.98,
   "text": "اما نان روح چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.98,
   "end": 186.16,
   "text": "\"واستقاموا\" عمل. عمل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.16,
   "end": 188.52,
   "text": "این می‌شه نان. پس نان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.52,
   "end": 190.76,
   "text": "آب روح ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.76,
   "end": 193.54,
   "text": "می‌شه علم و عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.54,
   "end": 197.78,
   "text": "دارو روح چیه؟ دارو روح اخلاصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.78,
   "end": 200.14,
   "text": "صرفاً خدا رو ببینی و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.14,
   "end": 203.46,
   "text": "درمانش چیه؟ اگر کسی حالا درم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.46,
   "end": 206.5,
   "text": "مریض شد، روحش مریض شد، درمان روحش با چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.5,
   "end": 211.08,
   "text": "با توبه است. حالا اینا از روایات بلند می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.08,
   "end": 216.78,
   "text": "ببینید صریح آیه داره می‌فرماید که وقتی این دو تا شرط اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 216.78,
   "end": 222.66,
   "text": "یعنی علم و عمل با همدیگه اومد \"تتنزل عليهم الملائكة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.66,
   "end": 228.32,
   "text": "\"عليهم الملائكة\" بر اون‌ها ملائکه نازل می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.32,
   "end": 232.6,
   "text": "پس ملائکه به کسی که اهل علم و عمله نازل می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.6,
   "end": 234.92,
   "text": "و م-- الملائکه هم تازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.92,
   "end": 241.2,
   "text": "ببینید اونجا می‌گه \"تنزل الملائکه\" اینجا می‌فرماید \"عليهم الملائكة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.2,
   "end": 245.56,
   "text": "یعنی ملائکه نازل می‌شن، نه یکی دو تا ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.56,
   "end": 248.58,
   "text": "بر کسی که علم و عمل داره. نباید اینا رو دست کم گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.58,
   "end": 252.66,
   "text": "بعد اینا میان هفت تا موهبت الهی رو بشارت میدن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.66,
   "end": 260.04,
   "text": "بنده. \"لا تخافوا\" نترس \"ولا تحزنوا\" محزون نباش \"وأبشروا بالجنة التي كنتم توعدون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.04,
   "end": 265.48,
   "text": "بشارت میدن به این‌ها اون جهنمی-- اون بهشتی رو که بهشون وعده داده شده بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.48,
   "end": 270.68,
   "text": "ببینید چقدر قرآن به بهشت‌های بسیار با عظمت و وسیع وعده داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.68,
   "end": 273.12,
   "text": "همه رو به یکباره به این آقا بشارت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.12,
   "end": 276.0,
   "text": "کم نیست. بعد به who-- کیا میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.0,
   "end": 278.2,
   "text": "ملائکه میگن \"نحن\" ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.2,
   "end": 280.48,
   "text": "ما که ملائکه‌ایم به تو نازل شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.48,
   "end": 285.52,
   "text": "\"أولياءكم\" رفیقای شماییم، دوستای شماییم، همراه شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.52,
   "end": 288.32,
   "text": "کجا؟ \"في الحياة الدنيا والآخرة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.32,
   "end": 291.96,
   "text": "دوباره یه تصریح دیگه. هم تو دنیا هم تو آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.96,
   "end": 296.06,
   "text": "یعنی اون ملائکه میگن \"نحن أولياءكم\" ما رفیقای شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.06,
   "end": 298.58,
   "text": "ما دوستداریم. ما با شماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.58,
   "end": 300.66,
   "text": "هم تو دنیا هم آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.66,
   "end": 302.98,
   "text": "پس ملائکه دائماً با ما دم خوران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.98,
   "end": 305.06,
   "text": "ما پسشون می‌زنیم با گناه و معصیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.06,
   "end": 309.1,
   "text": "\"ولكم فيها تشتهي أنفسكم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.1,
   "end": 311.5,
   "text": "تا حالا شده یه رستورانی بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.5,
   "end": 314.8,
   "text": "بهت بگن هرچی اشتها داری همونو بگو برات حاضر کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 314.8,
   "end": 317.78,
   "text": "بهشت اینجا. دارن بشارت میدن ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.78,
   "end": 322.88,
   "text": "میگن هرچی که اینجا تو اشتها کنی، میل‌ت، رغبتت به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.88,
   "end": 326.34,
   "text": "اینجا ارزش و اهمیت لیلة الرغائب معلوم می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 326.34,
   "end": 328.94,
   "text": "که از اونجا ما رو می‌کشونه تا لیلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.94,
   "end": 332.36,
   "text": "لیلة الرغائب شب، شب رغبت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.36,
   "end": 336.24,
   "text": "بهشت میگن هرچی رغبت کنی همون برات آماده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.24,
   "end": 339.74,
   "text": "هرچی اشتها کنی یعنی رغبت کنی یعنی میل‌ت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.74,
   "end": 342.72,
   "text": "لیلة الرغائب معلوم می‌شه میل انسان‌ها چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.72,
   "end": 347.72,
   "text": "\"ولكم فيها تدعون\" هرچی بخواید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.72,
   "end": 350.46,
   "text": "دعاتون، خواستتون، تقاضاتون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.46,
   "end": 353.28,
   "text": "الله اکبر! عجب بهشتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.28,
   "end": 356.52,
   "text": "و عجیب‌تر از اون این آیه آخر، آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 356.52,
   "end": 360.76,
   "text": "سی و سه، سی و دو می‌فرماید \"نزلاً من غفور رحیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.76,
   "end": 365.62,
   "text": "الله اکبر! این مائده‌ی \"نزلاً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.62,
   "end": 367.94,
   "text": "از سمت حضرت حق نازل شده برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 367.94,
   "end": 372.0,
   "text": "بفرمایید. کدوم خدا؟ خ-خدایی که غفور است و رحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.0,
   "end": 379.14,
   "text": "این بشارت رو یعنی این ظرفیت رو ملائکه دارن که این هفت تا موهبت رو بیان به من و شما بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.14,
   "end": 382.56,
   "text": "اما در پس چی؟ در پس دو چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 382.56,
   "end": 390.12,
   "text": "فرمود \"قالوا ربنا الله\" گفتن پروردگار ما الله که الله مستجمع جميع اسماء و صفاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 390.12,
   "end": 394.66,
   "text": "یعنی انسان همه‌ی اسماء الهی رو تو وجود خودش پیاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.66,
   "end": 399.72,
   "text": "اعم از اسماء جلال در مواجهه با دشمنان \"أشد على الكفار\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.72,
   "end": 404.3,
   "text": "و اسماء جمال در مواجهه با اهل ایمان \"رحماء بينهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.3,
   "end": 409.86,
   "text": "خب و، و بعدش که مهم‌تر از شاید اون باشه \"ثم استقاموا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.86,
   "end": 413.62,
   "text": "استقامت در عمل، در عمل مرد عمل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.62,
   "end": 416.12,
   "text": "مرد اون چیزی که \"قالوا ربنا الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.12,
   "end": 419.64,
   "text": "حرفشو زد باشه. اون موقع \"تتنزل عليهم الملائكة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 419.64,
   "end": 426.26,
   "text": "ملائکه میان و ما می‌خوایم بگیم که در ماه مبارک رمضان این شدت می‌گیره و بسیار بیش از ماه‌های دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 426.26,
   "end": 428.04,
   "text": "انشاالله ادامه خواهیم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.04,
   "end": 431.7,
   "text": "عاقبتمون انشاالله ختم به خیر بشه و برکت صلوات بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.7,
   "end": 439.56,
   "text": "محمد و آل محمد. الله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 439.56,
   "end": 442.2,
   "text": "الله اکبر، الله اکبر. لا اله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}