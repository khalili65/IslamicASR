 },
 "chapters": [
  {
   "index": 0,
   "title": "## پس از نزول روح اعظم؛ هم‌نشینی شب قدر",
   "start": 6.36,
   "end": 104.86
  },
  {
   "index": 1,
   "title": "## آثار نفس؛ هم‌نشینی نفوس",
   "start": 104.86,
   "end": 307.06
  },
  {
   "index": 2,
   "title": "## روایت مجمع‌البیان؛ اثر هم‌نشینی با پیامبر",
   "start": 307.06,
   "end": 549.41
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.28,
   "end": 6.36,
   "text": "و ربانی آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.36,
   "end": 9.14,
   "text": "تبریک میگم شروع سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.14,
   "end": 11.36,
   "text": "جدید معنوی تون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.36,
   "end": 15.18,
   "text": "شب سختی رو پشت سر گذاشتیم و سنگین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.18,
   "end": 16.84,
   "text": "و باید هم چنین باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.84,
   "end": 20.94,
   "text": "تنزل الملائكة والروح فیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.94,
   "end": 26.86,
   "text": "وقتی روح که روح اعظم که بزرگترین فرشته خداست و حتی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.86,
   "end": 31.64,
   "text": "حضرت جبرائیل هم اعظم و بزرگتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.64,
   "end": 37.64,
   "text": "دیشب نازل شده دیگه باید شب سنگینی می‌بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.64,
   "end": 42.32,
   "text": "دیشب همه ما به یک معنا هم‌نشین با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.32,
   "end": 49.86,
   "text": "حضرت روح شدیم و همه ملائکه با اون کثرتی که دارن الملائکه همه نازل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.86,
   "end": 52.86,
   "text": "اونا چون جنسشون عقله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.86,
   "end": 57.3,
   "text": "لذا یکی از بهترین کارها دیشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.3,
   "end": 61.38,
   "text": "کار علمی و عقلی بود که بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.38,
   "end": 64.58,
   "text": "اونا چون واسطه فیض‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.58,
   "end": 69.62,
   "text": "کار رو آسون‌تر کردن برای نزول فیض بر جان‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.62,
   "end": 72.28,
   "text": "لذا باید الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.28,
   "end": 76.22,
   "text": "وضعیت ما از هر حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.22,
   "end": 79.2,
   "text": "حتی قوای وجودی نفسمون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.2,
   "end": 82.16,
   "text": "روزهای قبل فرق کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.16,
   "end": 85.32,
   "text": "این یک اثر هم‌نشینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.32,
   "end": 89.24,
   "text": "نفس روح اعظم و ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.24,
   "end": 92.48,
   "text": "وقتی بر حضرت حجت نازل می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.48,
   "end": 97.38,
   "text": "و اون توجهی که حضرت حجت به تک‌تک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.38,
   "end": 100.06,
   "text": "مخلوقات و کائنات دارن در حین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.06,
   "end": 102.82,
   "text": "امضای پرونده‌ی تک‌تک ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.82,
   "end": 108.18,
   "text": "این‌ها همه تاثیرگذارن. اتفاقاً در خصوص خاصیت نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.18,
   "end": 111.4,
   "text": "خواص نفس، کیفیات و آثار نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.4,
   "end": 112.94,
   "text": "بزرگان زیاد قلم زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.94,
   "end": 118.06,
   "text": "مثلاً خود شیخ الرئیس علیه رحمة در شفا نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.06,
   "end": 121.42,
   "text": "نفس شفا اونجا داره یا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.42,
   "end": 125.1,
   "text": "مرحوم ملا محسن فیض علیه رحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.1,
   "end": 131.84,
   "text": "در اون مجلدات سه‌گانه علم الیقین و عین الیقین و حق الیقینش که با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.84,
   "end": 138.2,
   "text": "توی یک جلد چاپ شده. خیلی حضرت استاد سفارش می‌کردن به این کتاب، به این سه تا کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.2,
   "end": 141.4,
   "text": "یکی از فصولش رو می‌پردازه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.4,
   "end": 144.82,
   "text": "آثار نفس. خیلی سنگین، شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.82,
   "end": 147.7,
   "text": "خود شیخ الرئیس در نمت دهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.7,
   "end": 151.0,
   "text": "خب می‌دونید الاشارات و التنبیه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.0,
   "end": 156.08,
   "text": "کتاب معروف اشارات و تنبیهات ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.08,
   "end": 159.5,
   "text": "که ده تا نهج داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.5,
   "end": 164.14,
   "text": "در تنبیهاتش. ده تا نمت داره در اشاراتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.14,
   "end": 167.7,
   "text": "اونجا در اشا-- در نمت دهمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.7,
   "end": 171.2,
   "text": "که وقتی اسرار الآیات رو میاد میگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.2,
   "end": 176.14,
   "text": "اونجا بخشی اشاره می‌کنه به همین مباحث نفس، آثار نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.14,
   "end": 181.12,
   "text": "که حالا اون اسرار الآیات یعنی خوارق عادات؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.12,
   "end": 184.26,
   "text": "یعنی نفوس چنان می‌تونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.26,
   "end": 187.48,
   "text": "رشد کنن که بتونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.48,
   "end": 189.28,
   "text": "تأثیر کنن در ماده کائنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.28,
   "end": 191.54,
   "text": "این در هر دو صورتش هست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.54,
   "end": 197.18,
   "text": "یعنی نفوس می‌تونن چنان به سمت شر برن که نه فقط شر باشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.18,
   "end": 203.48,
   "text": "بلکه شریر باشن، بلکه بدتر از اون شریر باشن به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.48,
   "end": 208.92,
   "text": "علامه حسن زاده یا فسیق یعنی کسی که خیلی فسادش زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.92,
   "end": 211.7,
   "text": "شریر کسی که خیلی شروره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.7,
   "end": 215.18,
   "text": "این نفس این خصوصیتو داره که به اون سمت بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.18,
   "end": 220.28,
   "text": "از این طرف می‌تونه نفس خیر نباشه، بلکه خیر باشه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.28,
   "end": 224.86,
   "text": "یعنی اصلاً شخ-خیر مطلق و محض بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.86,
   "end": 227.26,
   "text": "این کیفیات نفس، آثار نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.26,
   "end": 232.16,
   "text": "که تاثیرگذار است و عجیب که حضرت استاد می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.16,
   "end": 236.78,
   "text": "عین مثالی که در شرح فصوص مداخل دوازده گانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 236.78,
   "end": 239.88,
   "text": "مد-مداخل غیثری بر فصوص داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.88,
   "end": 245.86,
   "text": "علامه حسن زاده شرح میده، اونجا خود حضرت استاد می‌فرمایند که اگر کسی مثلاً مثال می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.86,
   "end": 253.34,
   "text": "شعر میگه. تو بری زیاد مدت زیادی با این بپری کنارش بشینی، می‌بینی در تو هم هوس شعر گفتن گل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.34,
   "end": 255.98,
   "text": "این تاثیر نفسه، نفوس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.98,
   "end": 258.78,
   "text": "خیلی آدم باید مراقب باشه با کی می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.78,
   "end": 263.5,
   "text": "بحث ما از کجا شروع شد؟ اینکه دیشب ما هم‌نشین بودیم، هم‌نفس بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.5,
   "end": 267.6,
   "text": "با حضرت روح. این از درون مایه های عجیب و غریبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.6,
   "end": 271.98,
   "text": "ماه مبارک رمضان و دیشبه که متأسفانه داره از دست ما میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.98,
   "end": 274.62,
   "text": "معلوم هم نیست سال بعد زنده باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.62,
   "end": 277.44,
   "text": "پس هم‌نشین انقدر تاثیر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.44,
   "end": 280.52,
   "text": "خیلی خیلی. نفوس شرور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.52,
   "end": 283.54,
   "text": "شر یا شر-شریر یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.54,
   "end": 291.3,
   "text": "شریر. دیگه خیلی باید آدم-- تا نگاش می‌کنی بعضیا رو اصلاً تا می‌شینی کنارش شروع می‌کنه دروغ، غیبت فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.3,
   "end": 293.16,
   "text": "اصلاً بعضیا نفسشون انقدر پلیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.16,
   "end": 296.82,
   "text": "بالعکسش هم هست. انقدر بعضیا پاک می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.82,
   "end": 304.02,
   "text": "که به محض اینکه می‌شینی کنارش نفست اون-- اصلاً ثقل نفس ناطقه، اون باطنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.02,
   "end": 307.06,
   "text": "خالص می‌شه. یاد خدا می‌افتی، می‌بینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.06,
   "end": 311.72,
   "text": "حالا مرحوم طبرسی یه داستان جالبی میاره در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.72,
   "end": 315.3,
   "text": "مجمع البيانش از یه آدم خبیثی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.3,
   "end": 317.62,
   "text": "حالا اسمش از خاطرم رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.62,
   "end": 323.46,
   "text": "در این روایت میاره که اثر هم‌نشینی، این روایتو گوش بدید خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.46,
   "end": 326.26,
   "text": "میگه که یه کسی بود آدم درستی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.26,
   "end": 328.28,
   "text": "نفسش به سمت پلیدیا رفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.28,
   "end": 333.4,
   "text": "اما چنان هم‌نشینی با پیغمبر درش تأثیر کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.4,
   "end": 337.2,
   "text": "می‌اومد هی بغل پیغمبر وقتی مخصوصاً پیغمبر با کتابه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.2,
   "end": 341.02,
   "text": "القا می‌کرد بنویسید آیات رو، همون لحظه‌ای که نازل می‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.02,
   "end": 345.86,
   "text": "این هم نشسته بود یه روز با پررویی کنار پیغمبر در محضر پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.86,
   "end": 347.92,
   "text": "آیه دالش نازل می‌شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.92,
   "end": 354.16,
   "text": "این داشت می‌نوشت. حضرت استاد علامه حسن زاده هم اینو گفتن یه روز من یادم قشنگ که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 354.16,
   "end": 358.12,
   "text": "این داست-- این قصه روایت رو شرح دادن خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.12,
   "end": 363.89,
   "text": "که بعد همینطور که پیغمبر داشت آیه رو می‌گفت، این جلو جلو انتهای آیه رو گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.89,
   "end": 366.35,
   "text": "مثلاً کان الله عزيزا حکیما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.35,
   "end": 371.03,
   "text": "ززز جلو جلو آخر اون اسمایی که میاد آخر آیه ها اینو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.03,
   "end": 374.67,
   "text": "پیغمبر یه نگاه بهش کرد. خب این اثر هم‌نشینی اون فی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.67,
   "end": 377.97,
   "text": "میشه گفت افاضات و القائات هم‌نشینی با پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.97,
   "end": 381.25,
   "text": "ببینید حتی در یک نفس اون طوری هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.25,
   "end": 383.83,
   "text": "چگونه می‌تونه تأثیری بگذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.83,
   "end": 391.05,
   "text": "که خود علامه هم یادمه تأکید می‌کرد که این اثر هم‌نشینیه با پیغمبر بوده که تونست جلوتر بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.05,
   "end": 393.79,
   "text": "چون لایه‌لایه داره ناظر میشه به پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.79,
   "end": 397.03,
   "text": "کسی که در محضر پیغمبره ببین چه فیضی دریافت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.03,
   "end": 400.77,
   "text": "حالا ببینید دیشب ما هممون در محضر روح اعظم بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.77,
   "end": 403.35,
   "text": "چه باید، چه فیضی رو باید دریافت می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.35,
   "end": 407.07,
   "text": "خلاصه این جلوتر میگه پیغمبر هم فرمود همون که گفتی رو بنویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.07,
   "end": 409.71,
   "text": "درسته. عجیبه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.71,
   "end": 412.21,
   "text": "آیه رو درست خوندی بنویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.21,
   "end": 416.35,
   "text": "این آقا پررو شد. وقتی اینطور شد گمان کرد که به اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.35,
   "end": 421.07,
   "text": "وحی میشه. بلند شد رفت و ادعا کرد داره به منم قرآن وحی شده و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.07,
   "end": 424.57,
   "text": "خلاصه بعدم منکر کلاً رسالت پیغمبر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.57,
   "end": 427.81,
   "text": "یه آدم خبیثی شد و پیغمبرم اونو محدود الدم اعلام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.81,
   "end": 430.51,
   "text": "گفت قتلش-- هرکی دید اینو بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 430.51,
   "end": 435.15,
   "text": "فراری شد و بعد حالا اتفاقاً برادر رضاعی عثمان هم بود این آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.15,
   "end": 439.67,
   "text": "اومد دامن عثمان رو گرفت که حالا عثمان هم رفت چیکار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 439.67,
   "end": 446.09,
   "text": "شفاعت کرد و که پیغمبر ایشون رو ببخشه و پیغمبر هم خب بالاخره رحمة للعلمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.09,
   "end": 452.87,
   "text": "گفت باشه بخشیدمش. ولی تو صحرا بلند شد پیغمبر در میان همه گفت مگه من به شما نگفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.87,
   "end": 456.09,
   "text": "اصلاً مجالش ندید این محدود الدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 456.09,
   "end": 457.65,
   "text": "حقایق رو به تمسخر گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.65,
   "end": 465.87,
   "text": "هر جا دیدید بکشیدش. یکی از این صحابه بهش گفت یا رسول الله من که به شما گفتم وقتی اومد اشاره کنید من می‌کشمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 465.87,
   "end": 470.93,
   "text": "بعد پیغمبر این جمله رو فرمود إن الأنبياء لا يقتلون بالإشارة،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.93,
   "end": 472.67,
   "text": "انبیا به اشاره کسی رو نمی‌کشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.67,
   "end": 475.37,
   "text": "اینم از نفوس خیر انبیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.37,
   "end": 477.85,
   "text": "که شیخ الرئیس اونجا بازش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.85,
   "end": 481.37,
   "text": "نفس خیلی مهمه. آثار نفس زدن با کی می‌شینه با کی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.37,
   "end": 485.77,
   "text": "قدیم‌ها یادتونه یه خر-- خر موهره‌هایی آویزون می‌کردن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.77,
   "end": 488.23,
   "text": "حالا مثلا کلا یا لباس بچه‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.23,
   "end": 492.33,
   "text": "یادتونه؟ مخصوصا به رنگ کبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.33,
   "end": 496.13,
   "text": "احسنت. اینا اتفاقا رو اون رنگ کبود علامه تاکید داره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.13,
   "end": 498.03,
   "text": "میگه اون جلوی چشمو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.03,
   "end": 501.55,
   "text": "اصلا این اصابة العين تو روایات اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.55,
   "end": 505.11,
   "text": "از آثار nefse زدن دیگران با چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 505.11,
   "end": 508.79,
   "text": "چگونه است که ما چشم مثلا زخم زبان داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 508.79,
   "end": 512.21,
   "text": "زخم قلم داریم. یه چیزی می‌نویسی پدر یکی رو درمیاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 512.21,
   "end": 515.13,
   "text": "خب زخم چشم هم داریم. چشم حسود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.13,
   "end": 517.39,
   "text": "خیلی اینا آثار nefse.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.39,
   "end": 521.51,
   "text": "و کی ما می‌خوایم تو معرفت نفس پیش بریم اینا رو بدونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 521.51,
   "end": 524.17,
   "text": "که حداقل آثار نفس خودمون رو پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 524.17,
   "end": 528.15,
   "text": "چه جور آدمی هستیم و خودمون رو در معرض آثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 528.15,
   "end": 531.53,
   "text": "بد و خبث باطنی بعضیا و نفوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 531.53,
   "end": 534.89,
   "text": "پلید بعضیا قرار ندیم بلکه بریم در محضر بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 534.89,
   "end": 537.55,
   "text": "خلاصه دیشب در محضر روح اعظم بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 537.55,
   "end": 543.51,
   "text": "نوش جون هممون. انشاالله خوش به حال کسی که توبرش پر شده از معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 543.51,
   "end": 549.41,
   "text": "الهیه. عاقبتمون انشاالله ختم به خیر بشه و برکت صلوات بر محمد و آل محمد. آمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}