 "chapters": [
  {
   "index": 0,
   "title": "## کفاره و قضای روزه‌های سال گذشته",
   "start": 12.2,
   "end": 104.82
  },
  {
   "index": 1,
   "title": "## الصوم لی؛ عظمت روزه میان عبادات",
   "start": 104.82,
   "end": 191.42
  },
  {
   "index": 2,
   "title": "## ظاهر روزه پوست است؛ باطن حضور نفس",
   "start": 191.42,
   "end": 357.32
  },
  {
   "index": 3,
   "title": "## در رمضان چه کنیم؛ تقویت حس حضور",
   "start": 357.32,
   "end": 441.93
  },
  {
   "index": 4,
   "title": "## دعای اهل قبور؛ ظهور و برطرف شدن آثار گناه",
   "start": 441.93,
   "end": 522.49
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.52,
   "end": 4.22,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.22,
   "end": 8.24,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.24,
   "end": 11.92,
   "text": "آياته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.92,
   "end": 19.14,
   "text": "ما این چند روز رو به لطف خدا سعی می‌کنیم احکام ماه مبارک رمضان رو بیان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.14,
   "end": 28.44,
   "text": "امروز عرض کنیم که بعضیا گمانشون اینه که هنوز ماه مبارک رمضان امسال نرسیده باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.44,
   "end": 31.02,
   "text": "کفاره روزه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.02,
   "end": 33.14,
   "text": "سال گذشته‌شون رو بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.14,
   "end": 40.26,
   "text": "یعنی این الزامه و باید قبل از رسیدن این ماه مبارک رمضان کفاره‌ی روزه‌های نگرفته سال قبلشونو بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.26,
   "end": 43.42,
   "text": "در صورتی که این چنین نیست. الزام نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.42,
   "end": 47.8,
   "text": "باید نداره. ضمن اینکه اصلا ما باید صبر کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.8,
   "end": 52.68,
   "text": "تا ماه مبارک رمضان امسال برسه که اگر ما سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.68,
   "end": 57.4,
   "text": "قبل عذر داشتیم و نتونستیم روزه رو بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.4,
   "end": 61.22,
   "text": "باید عرض شود خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.22,
   "end": 63.12,
   "text": "قضای اون روزه‌ها رو بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.12,
   "end": 70.9,
   "text": "حالا اگر قضای اون روزه‌ها رو این عذر بر ما باقی موند، مریضی باقی موند نتونستیم بگیریم یا دائماً سفر بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.9,
   "end": 73.7,
   "text": "نتونستیم بگیریم به هر دلیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.7,
   "end": 80.54,
   "text": "ماه مبارک رمضان امسال که رسید دیگه قضا از گردن ما ساقط میشه و باید کفاره بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.54,
   "end": 84.98,
   "text": "ضمن اینکه مراجع غالباً فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.98,
   "end": 88.38,
   "text": "اینطور نیست که حالا حتماً همین الان باید کفاره رو بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.38,
   "end": 91.16,
   "text": "خب بدهکارید دیگه هرچی زودتر بدید بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.16,
   "end": 94.9,
   "text": "اما الزام و بایدی وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.9,
   "end": 99.26,
   "text": "البته دفتر آقام امسال هم کفاره رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.26,
   "end": 104.64,
   "text": "کفاره روزه عذر رو دو هزار و پونصد تومن برای هر روز در نظر گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.64,
   "end": 108.48,
   "text": "خب به لطف خدا ما بحث قلب منافق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.48,
   "end": 112.22,
   "text": "منعطف می‌کنیم، منصرف میشیم ازش میایم سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.22,
   "end": 116.98,
   "text": "اسراری و از ماه مبارک رمضان و پیرامون اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.98,
   "end": 119.18,
   "text": "روزه با هم گفتگو کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.18,
   "end": 124.96,
   "text": "یکی از نکات بسیار مهمی که تقریباً می‌تونم بگم ماحصل حدود چهار جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.96,
   "end": 130.2,
   "text": "درس استاد هست به شما عرض می‌کنم امروز و از اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.2,
   "end": 133.5,
   "text": "خیلی مهم روزه داریست این هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.5,
   "end": 136.28,
   "text": "خب برای ما معمولاً سؤال میشه که چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.28,
   "end": 139.32,
   "text": "انقدر روزه عظمت پیدا کرده که در میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.32,
   "end": 142.68,
   "text": "عبادات هیچ کدوم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.68,
   "end": 146.0,
   "text": "عبادات رو خدا به خودش نسبت نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.0,
   "end": 149.48,
   "text": "مثلاً فرموده \"أَقِمِ الصَّلَاةَ لِذِكْرِي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.48,
   "end": 151.32,
   "text": "نماز بخونید برای یاد من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.32,
   "end": 156.58,
   "text": "اما به روزه که میرسه می‌فرماید \"الصَّوْمُ لِي\" روزه مال منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.58,
   "end": 161.74,
   "text": "حالا یا این فعل رو اگر مجهول بگیریم یا معلوم معناش متفاوت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.74,
   "end": 164.78,
   "text": "حالا یا اینه که أنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.78,
   "end": 172.98,
   "text": "أجزيه یعنی من جزاشو میدم یا اینکه أنا أجزاه یعنی اون چیزی که بهش پاداش میدن من هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.98,
   "end": 177.22,
   "text": "منو بهش پاداش میدن. که بسیاری از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.22,
   "end": 180.16,
   "text": "بزرگان اهل معرفت فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.16,
   "end": 183.8,
   "text": "درستش اینه که جزا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.8,
   "end": 186.0,
   "text": "روزه دار خود من هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.0,
   "end": 188.48,
   "text": "خب چرا انقدر عظمت پیدا کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.48,
   "end": 191.42,
   "text": "دقت بفرمایید نکته‌ای رو من عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.42,
   "end": 194.18,
   "text": "اگر چنانچه شما روزه باشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.18,
   "end": 197.64,
   "text": "خب با توجه عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.64,
   "end": 200.24,
   "text": "و حضور نفستون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.24,
   "end": 204.9,
   "text": "متوجه این هستید که نباید اکل و شرب کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.9,
   "end": 207.04,
   "text": "نباید بخورید و بیاشامید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.04,
   "end": 209.98,
   "text": "اون مبتلا‌ت روزه رو نباید انجام بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.98,
   "end": 215.96,
   "text": "حالا اگر احیاناً انسان یادش رفت یعنی اون توجه نفس از دستش رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.96,
   "end": 219.4,
   "text": "حضور نداشت، حواسش نبود، خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.4,
   "end": 222.48,
   "text": "اصلاً یه پرس غذا خورد، یه پارچ آبم روش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.48,
   "end": 225.04,
   "text": "یه دفعه متوجه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.04,
   "end": 226.8,
   "text": "اینجا آیا روزه‌ش باطله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.8,
   "end": 230.8,
   "text": "همه مراجع می‌فرمایند چون یادش رفته بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 230.8,
   "end": 235.4,
   "text": "و اینجا کف نفس نداشته از روی بی‌توجهی یا در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.4,
   "end": 237.92,
   "text": "نفسش حضور نداشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.92,
   "end": 241.54,
   "text": "توجه عرفانی نداشته، اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.54,
   "end": 244.94,
   "text": "روزه‌ش صحیحه. عمداً نخورده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.94,
   "end": 250.12,
   "text": "به شرط اینکه وقتی متوجه شد دو مرتبه حال و حس حضور پیدا کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.12,
   "end": 252.54,
   "text": "نفس، نفسش حاضر شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.54,
   "end": 258.26,
   "text": "دیگه اون مبتلا‌ت روزه رو مفطرات رو انجام نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.26,
   "end": 263.72,
   "text": "حالا ما از شما سؤال می‌کنیم آقا اینشون که خورد اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.72,
   "end": 267.46,
   "text": "روزه دار بودن و صائم بودن به صرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.46,
   "end": 272.06,
   "text": "نخوردن و نیاشامیدن ظاهریه که البته اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.06,
   "end": 275.4,
   "text": "در باطن‌ش هست، اون هم از واجباتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 275.4,
   "end": 277.96,
   "text": "اما ما میگیم اینجا آقا ایشون خورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 277.96,
   "end": 283.38,
   "text": "هم آب خورد هم غذا. پس چرا دوباره ما میگیم صائمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.38,
   "end": 287.02,
   "text": "ببینید این نکته‌ست. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.02,
   "end": 289.26,
   "text": "اصل روزه درسته ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.26,
   "end": 292.9,
   "text": "روزه، پوست روزه یا اون شریعت روزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.9,
   "end": 296.54,
   "text": "شرع روزه، نخوردن و نیاشامیدن و این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.54,
   "end": 298.2,
   "text": "لکن این‌ها یک پوسته‌ایست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 298.2,
   "end": 302.02,
   "text": "این ظاهر است که ما رو برسونه به اون باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.02,
   "end": 305.0,
   "text": "در حقیقت میشه گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.0,
   "end": 307.28,
   "text": "از این ظاهر باید به اون باطن رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.28,
   "end": 310.8,
   "text": "باطن حضوره. توجه عرفانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.8,
   "end": 315.28,
   "text": "حضور نفسه. چطور شما تا حالا شده به حضور نفس خودت شک کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.28,
   "end": 318.2,
   "text": "اصلاً شک کنی که آیا من هستم یا نیستم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 318.2,
   "end": 319.88,
   "text": "تا حالا همچین اتفاقی نیفتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 319.88,
   "end": 323.06,
   "text": "روزه چنان عظمتی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 323.06,
   "end": 326.14,
   "text": "که حالا انشاالله به مرور ما این اسرار رو عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 326.14,
   "end": 330.42,
   "text": "چنان عظمتی داره که سبب توجه عرفانی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 330.42,
   "end": 335.12,
   "text": "توجه-- در حقیقت حس حضور رو چنان تقویت میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.12,
   "end": 343.82,
   "text": "که انسان خودش رو در محضر تام خدا ببینه و پای روی همه امیال نفسانی و درونی خودش بگذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 343.82,
   "end": 347.88,
   "text": "این‌ها رو از همون شهوت و غضب شروع میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 347.88,
   "end": 353.88,
   "text": "تا امیال بیخودی درونی، فکر و خیال‌ها، خیال‌های نازشایست و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 353.88,
   "end": 357.06,
   "text": "پس این رو توجه بفرمایید که خودش یک نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.06,
   "end": 360.41,
   "text": "حالا اگر کسی بپرسه آقا تو این ماه ما چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.41,
   "end": 364.41,
   "text": "عرض می‌کنیم که هر کاری که از میان همه این دستوراتی که واقع شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.41,
   "end": 367.91,
   "text": "ما که نمی‌تونیم همه رو انجام بدیم که بسیار زیادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.91,
   "end": 370.03,
   "text": "هرکس با هر کدوم بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 370.03,
   "end": 373.91,
   "text": "توجه عرفانی پیدا می‌کنه و حس حضور داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.91,
   "end": 377.59,
   "text": "اونو انجام بده. امکان داره کسی بگه آقا من می‌خوام هر شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.59,
   "end": 380.41,
   "text": "هزار سوره ان انزلناه رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.41,
   "end": 384.11,
   "text": "خب نوش جونت که من معتقدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.11,
   "end": 388.11,
   "text": "تجربه شده‌ست دیگه. متق-- معتقدم که حتی کمترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 388.11,
   "end": 390.91,
   "text": "از جهت توجهی کمترین آدم‌ها از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 390.91,
   "end": 397.41,
   "text": "جهت صعه وجودی یا عرض شود این‌هایی که حتی شاخک‌هاشون هم تیز نیست تو سیر و سلوک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 397.41,
   "end": 399.65,
   "text": "حداقل یه چیزکی گیرشون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 399.65,
   "end": 402.05,
   "text": "چون فرمودن اگه کسی هر شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 402.05,
   "end": 406.15,
   "text": "هزار مرتبه سوره قدر رو بخونه در ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.15,
   "end": 411.25,
   "text": "بعد ااا پرده‌ها براش کنار میره ماه که تموم شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 411.25,
   "end": 415.21,
   "text": "حالا یه کسی شاید بگه من می‌خوام شبی صد رکعت نماز رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.21,
   "end": 418.89,
   "text": "کسی بگه من می‌خوام پنج ختم قرآن تو این ماه انجام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.89,
   "end": 423.05,
   "text": "کسی بگه من دعاهای سحر رو دوست دارم انجام بدم، بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 423.05,
   "end": 426.67,
   "text": "ابو حمزه بخونم، دعای سحر بخونم، افتتاح بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 426.67,
   "end": 428.83,
   "text": "کسی بگه استغفار روزی هزار تا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 428.83,
   "end": 432.99,
   "text": "حالا هرچی که هست اگرچه روزه اصل است اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 432.99,
   "end": 435.63,
   "text": "لکن در کنار این روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 435.63,
   "end": 441.93,
   "text": "اونچه که حس حضور ما رو تقویت می‌کنه، توجه ما رو تکمیل می‌کنه، اون خیلی بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 441.93,
   "end": 444.03,
   "text": "در خصوص این دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 444.03,
   "end": 448.19,
   "text": "اللهم ادخل على اهل القبور السرور هم نکته‌ای رو عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 448.19,
   "end": 451.73,
   "text": "کی می‌شه که همه مرده‌ها شاد بشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 451.73,
   "end": 454.71,
   "text": "همه مریض‌ها شفا بگیرن، همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.71,
   "end": 457.57,
   "text": "کروب و پریشانی‌ها برطرف شه، همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 457.57,
   "end": 459.51,
   "text": "دربندها آزاد بشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 459.51,
   "end": 461.97,
   "text": "همه مفاسد اصلاح بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 461.97,
   "end": 466.65,
   "text": "این کل، کل، کل. بزرگان فرمودن این اشاره به زمان ظهور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 466.65,
   "end": 470.47,
   "text": "شما غیرمستقیم دارید برای ظهور حضرت دعا می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 470.47,
   "end": 472.89,
   "text": "لذا این دعا از این حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 472.89,
   "end": 475.03,
   "text": "خیلی با عظمت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 475.03,
   "end": 477.43,
   "text": "حیث دیگه‌ش اینه که همه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 477.43,
   "end": 481.73,
   "text": "دعا می‌کنی خودت رو فراموش می‌کنی یا خودتم تو دل جمع پنهان می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 481.73,
   "end": 485.99,
   "text": "در حقیقت دیگران رو می‌بینی خیرت به دیگران می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 485.99,
   "end": 489.63,
   "text": "برای همه دیگه. ما نداریم، من ندیدم دعایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 489.63,
   "end": 493.57,
   "text": "ااا بگه هم گناهاتو می‌بخشم هم آثارش رو برطرف می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 493.57,
   "end": 500.51,
   "text": "در روایت داریم که این دعا رو هرکس در ماه مبارک رمضان بعد از هر نماز واجبش مداومت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 500.51,
   "end": 503.69,
   "text": "خدا گناه‌هاشو می‌بخشه. آثار گناه‌هاشم برطرف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 503.69,
   "end": 509.51,
   "text": "این خیلی عظیمه. خب ما می‌گیم آقا فلان کار حدیث داریم انجام بدی گناهاتو خدا می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 509.51,
   "end": 513.37,
   "text": "خب می‌بخشه. اما اینکه آثار گناه برطرف بشه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.37,
   "end": 515.85,
   "text": "لذا این دعا خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 515.85,
   "end": 517.97,
   "text": "سعی کنید این رو مداومت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 517.97,
   "end": 520.09,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 520.09,
   "end": 522.49,
   "text": "به برکت صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}