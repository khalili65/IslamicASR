   "title": "## روح در آیه و روایت ابوبصیر",
   "start": 23.24,
   "end": 46.32
  },
  {
   "index": 1,
   "title": "## اقرار انبیا به فاطمه و روح‌القدس",
   "start": 46.32,
   "end": 328.68
  },
  {
   "index": 2,
   "title": "## لیلةالقدر فاطمه است",
   "start": 328.68,
   "end": 510.6
  },
  {
   "index": 3,
   "title": "## ملائکه مؤمنان و روح فاطمه",
   "start": 510.6,
   "end": 566.38
  },
  {
   "index": 4,
   "title": "## ملائکه علم آل محمد",
   "start": 566.38,
   "end": 587.72
  },
  {
   "index": 5,
   "title": "## عمل شب قدر: استغاثه",
   "start": 587.72,
   "end": 714.36
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 15.1,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 15.1,
   "end": 23.24,
   "text": "السلام علیک یا داعی الله و ربانی ایاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 23.24,
   "end": 28.12,
   "text": "در کتاب اصول کافی جلد دو صفحه شونزده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 28.12,
   "end": 32.64,
   "text": "روایتی از حضرت ابوبصیر هست از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 32.64,
   "end": 37.22,
   "text": "یکی از بهترین شاگردان امام صادق صلی الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 37.22,
   "end": 39.62,
   "text": "اینجا میگه در خصوص آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 39.62,
   "end": 42.78,
   "text": "هشتاد و پنج سوره عصر از حضرت سؤال کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 42.78,
   "end": 48.38,
   "text": "بحث ما پیرامون ملائکه و روح بود و تنزلشون در شب قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 48.38,
   "end": 52.64,
   "text": "اون آیه که می فرماید یسألونك عن الروح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 52.64,
   "end": 55.58,
   "text": "پیغمبر از تو سؤال می‌کنند در خصوص روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 55.58,
   "end": 58.24,
   "text": "قل الروح من أمر ربي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.24,
   "end": 62.54,
   "text": "بگو که روح از امر پروردگار من است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 62.54,
   "end": 66.42,
   "text": "میگه در خصوص این آیه از حضرت سؤال کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.42,
   "end": 70.08,
   "text": "از امام صادق که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 70.08,
   "end": 75.58,
   "text": "این روح کیه؟ حالا امام صادق دارن تصریح می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 75.58,
   "end": 80.2,
   "text": "خب با هر کدوم از صحابه‌شون نسبت به عقلشون حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.2,
   "end": 82.68,
   "text": "اینجا یه مقدار باطن‌تر رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.68,
   "end": 91.68,
   "text": "امام صادق بیشتر از اون چیزی که دیروز ما گفتیم امروز لطیفانه‌تر و عمیق‌تر سخن گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.68,
   "end": 98.32,
   "text": "این فرمایش امام صادق صلی الله علیه فرمودن آفریده‌ایست بزرگتر از جبرائیل و میکائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 98.32,
   "end": 103.54,
   "text": "کی؟ روح. با رسول الله بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 103.54,
   "end": 112.98,
   "text": "یعنی همراه پیغمبر بود و با ائمه علیهم السلام یعنی با امامان معصوم هم دائماً بوده و هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 112.98,
   "end": 116.78,
   "text": "و او از ملکوت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 116.78,
   "end": 121.24,
   "text": "این از ملکوت است با یک سر و رمزی اینجا حضرت صادق صلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 121.24,
   "end": 127.02,
   "text": "الله علیه بیان کرده که حقیقت روح چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 127.02,
   "end": 130.74,
   "text": "خیلی در لفافه گفته. من قبلاً اینجا سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 130.74,
   "end": 133.92,
   "text": "عوالم هستی رو گفتم براتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 133.92,
   "end": 142.0,
   "text": "اونهایی که الان مستحضر هست، استحضار دارن نسبت اون مبـ-- مباحثی که قبلاً گفتیم استحضار دارن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 142.0,
   "end": 145.66,
   "text": "نشئه ملکوت تحت تصرف کی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 145.66,
   "end": 147.72,
   "text": "نشئه جبروت و لاهوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 147.72,
   "end": 152.04,
   "text": "اینا رو توضیح داده بودیم. سلطنت اونجا با کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 152.04,
   "end": 157.22,
   "text": "حالا اجازه بدید که بریم جلوتر ببینیم به کجا می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 157.22,
   "end": 163.74,
   "text": "در ک-کتاب شریف عوالم العلوم صفحه صد و شصت و یک امام صادق صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 163.74,
   "end": 167.36,
   "text": "فرمودند که ما تکاملة النبوة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 167.36,
   "end": 174.86,
   "text": "لنبیً. نبوت هیچ پیغمبری تکمیل نمی‌شه، به کمال نمی‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 174.86,
   "end": 177.18,
   "text": "حتی تا وقتی که أقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 177.18,
   "end": 182.76,
   "text": "بفضلها ومعرفتها یه جای دیگه می فرماید بمحبتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 182.76,
   "end": 186.58,
   "text": "به معرفت و محبت و فضل کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 186.58,
   "end": 190.18,
   "text": "پیغمبرها اقرار می‌کردند نبوتشون کامل می‌شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 190.18,
   "end": 193.9,
   "text": "حضرت فرمودند مادرم فاطمة الزهرا سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 193.9,
   "end": 201.94,
   "text": "این اقرار، اقرار همه انبیا به محبت، فضیلت و معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 201.94,
   "end": 207.66,
   "text": "به میزانی که به حضرت صدیقه طاهره سلام الله علیها معرفت داشتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 207.66,
   "end": 211.52,
   "text": "درجه و رتبه نبوتشون همین مقدار بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 211.52,
   "end": 214.08,
   "text": "الله اکبر. این حالا جایگاه خانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 214.08,
   "end": 218.62,
   "text": "بریم جلوتر. الكافي جلد یک صفحه دویست و هفتاد و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 218.62,
   "end": 224.78,
   "text": "امام صادق صلی الله علیه فرمود روح‌القدس فبه حمل النبوة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 224.78,
   "end": 230.34,
   "text": "اون وسیله‌ای که برای حمل نبوت بوده روح‌القدس بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 230.34,
   "end": 234.04,
   "text": "حالا اینو بذارید کنار اون حدیث بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 234.04,
   "end": 237.58,
   "text": "بریم جلوتر. امام رضا صلی الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 237.58,
   "end": 243.2,
   "text": "كانت فاطمة علیها السلام إذا طلع هلال شهر رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 243.2,
   "end": 245.44,
   "text": "يغلب نوره الهلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 245.44,
   "end": 253.02,
   "text": "به به، به به. فرمود وقتی امام رضا قربونش بریم فرمود وقتی که حضرت زهرا سلام الله علیها می‌رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 253.02,
   "end": 256.12,
   "text": "رؤیت هلال ماه رمضان بکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 256.12,
   "end": 261.12,
   "text": "يغلب نوره الهلال غالب می‌شد نور مادر ما فاطمه بر نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 261.12,
   "end": 264.34,
   "text": "هلال. یعنی هلال محو می‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 264.34,
   "end": 267.3,
   "text": "و يخفى مخفی می‌شد هلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 267.3,
   "end": 272.38,
   "text": "یعنی دیگه دیده نمی‌شد از شدت نور حضرت زهرا سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 272.38,
   "end": 277.98,
   "text": "فإذا غابت وقتی غائب می‌شد یعنی حضرت زهرا مادر ما غائب می‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 277.98,
   "end": 281.72,
   "text": "عنه از اون رؤیت هلال ظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 281.72,
   "end": 283.9,
   "text": "دوباره هلال دیده می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 283.9,
   "end": 288.54,
   "text": "اینا همه اسراره که چگونه‌ست که یعنی اشراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 288.54,
   "end": 294.62,
   "text": "اون اشرافییت حضرت زهرا، اشراف حضرت زهرا سلام الله علیها بر این ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 294.62,
   "end": 299.16,
   "text": "اون روزهای اول گفتیم که فضیلت رمضان بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 299.16,
   "end": 305.32,
   "text": "ماه‌های دیگه مثل فضیلت پیغمبر و امیرالمؤمنین بود بر دیگر خلائق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 305.32,
   "end": 311.08,
   "text": "اینا رو یادتون باشه. حالا اینجا میگه حضرت زهرا می‌آمد رؤیت این ماه رو بکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 311.08,
   "end": 317.34,
   "text": "این ماهی که فضیلتش بر ماه‌های دیگه مثل فضیلت پیغمبر و امیرالمؤمنین بر دیگر خلائقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 317.34,
   "end": 322.64,
   "text": "محو می‌شد. یعنی نور حضرت زهرا استیلا داشت، استقلال داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 322.64,
   "end": 327.74,
   "text": "خب حالا اجازه بدید که بریم جلوتر حدیث آخر رو بگیم و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 327.74,
   "end": 331.66,
   "text": "این ت- حدیث از تفسیر فرات کوفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 331.66,
   "end": 334.38,
   "text": "این که تفسیر روایی بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 334.38,
   "end": 337.18,
   "text": "خوبیه. توصیه می‌کنم این تفسیرو بگیرید بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 337.18,
   "end": 342.52,
   "text": "الحمد لله هست، چاپ شده‌ش هست ترجمه فارسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 342.52,
   "end": 345.68,
   "text": "از امام صادق صلی الله علیه پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 345.68,
   "end": 348.16,
   "text": "ليلة القدر و سورة القدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 348.16,
   "end": 353.04,
   "text": "شأن سورة القدر تفسیر و تأویل سورة القدر سؤال شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 353.04,
   "end": 356.12,
   "text": "خب اینجا پیداست که راوی خیلی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 356.12,
   "end": 361.48,
   "text": "اون درون مایه‌ش خیلی قوی بوده که حضرت دیگه کنه مطلب داره براش ب-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 361.48,
   "end": 363.8,
   "text": "اونجا با اشاره به اون راوی گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 363.8,
   "end": 370.4,
   "text": "و ابو بصیر با اینکه ابو بصیر خیلی از رویاها را بسیار خوب حضرت بوده باز با اشاره گفت ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 370.4,
   "end": 373.12,
   "text": "گفت روح القدس روح از ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 373.12,
   "end": 376.24,
   "text": "درسته؟ حالا اینجا ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 376.24,
   "end": 379.83,
   "text": "حضرت داره می‌فرماید انا انزلناه في ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 379.83,
   "end": 382.78,
   "text": "ليلة القدر فاطمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 382.78,
   "end": 385.6,
   "text": "سلام الله عليها. اصلاً لیلة قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 385.6,
   "end": 388.34,
   "text": "مادر ما فاطمه است. این یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 388.34,
   "end": 390.22,
   "text": "والقدر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 390.22,
   "end": 392.78,
   "text": "قدر الله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 392.78,
   "end": 397.92,
   "text": "فمن عرف واقعاً چهار ستون بدن آدم باید بلرزه با این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 397.92,
   "end": 400.42,
   "text": "فمن عرف فاطمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 400.42,
   "end": 408.02,
   "text": "حق معرفتها، حق معرفت به میزانی که انبیا معرفت پیدا می‌کردن همون مقدار نبوت می‌گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 408.02,
   "end": 418.26,
   "text": "اون حدیثه. حالا اینجا می‌فرماید هرکس که حق معرفت مادر ما فاطمه را احصا کنه فقط اطر-- ادرک ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 418.26,
   "end": 424.46,
   "text": "یعنی حق معرفت فاطمه زهرا مساوی است با درک ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 424.46,
   "end": 426.98,
   "text": "چرا؟ و انما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 426.98,
   "end": 431.92,
   "text": "سمیت فاطمة لان الخلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 431.92,
   "end": 434.42,
   "text": "فتموا عن معرفتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 434.42,
   "end": 442.0,
   "text": "از این جهت امام داره میگه به مادر ما فاطمة گفتند چون خلق کنده شدند از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 442.0,
   "end": 449.7,
   "text": "حق معرفتش. یعنی خلق نمی‌تونند بفهمند عظمت حضرت زهرا سلام الله علیها و اون کنه معرفتش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 449.7,
   "end": 453.66,
   "text": "بریم جلوتر. ليلة القدر خير من الف شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 453.66,
   "end": 456.2,
   "text": "حالا اینجا میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 456.2,
   "end": 457.86,
   "text": "تا کجا اومده اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 457.86,
   "end": 459.68,
   "text": "تا اینکه ليلة القدر کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 459.68,
   "end": 461.82,
   "text": "قدر الله است. ليلة القدر حضرت زهرا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 461.82,
   "end": 465.04,
   "text": "میره جلوتر. قوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 465.04,
   "end": 468.2,
   "text": "يعني امام صادق می‌فرماید قول خدا ادامه‌ش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 468.2,
   "end": 471.3,
   "text": "و ما ادراک ما ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 471.3,
   "end": 475.6,
   "text": "ليلة القدر خير من الف شهر یعنی، این یعنی هم امام فرموده ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 475.6,
   "end": 478.1,
   "text": "داره ترجمه می-- تأویل میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 478.1,
   "end": 485.62,
   "text": "یعنی خير من الف شهر رو حضرت می‌فرماید یعنی خير من الف مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 485.62,
   "end": 488.3,
   "text": "المؤمن یکی از اسامی خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 488.3,
   "end": 493.18,
   "text": "که وقتی به نحو اتم در کسی پیاده بشه اون شخص هم می‌شه مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 493.18,
   "end": 495.98,
   "text": "اینو اینطوری بگیرید نه مؤمن مثل من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 495.98,
   "end": 501.56,
   "text": "ببخشید جسارتا. میگه هزار تا، هزار تا مؤمن رو بریزی رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 501.56,
   "end": 507.0,
   "text": "و هي ام المؤمنين خير من یعنی ام المؤمنين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 507.0,
   "end": 509.7,
   "text": "که ليلة القدره افضل از اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 509.7,
   "end": 513.02,
   "text": "بریم جلوتر. تنزل الملائكة والروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 513.02,
   "end": 518.84,
   "text": "رسیدیم به روح. حالا حضرت می‌خواد اینجا ترجمه کنه که روح کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 518.84,
   "end": 521.0,
   "text": "عجیبه این حدیث خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 521.0,
   "end": 523.24,
   "text": "واقعاً این حدیث باید باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 523.24,
   "end": 526.26,
   "text": "ما بازش ن-- الان نمی‌کنیم‌ها وقت نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 526.26,
   "end": 529.36,
   "text": "انشاالله اگر فرصت بشه، توفیق بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 529.36,
   "end": 531.58,
   "text": "درون مایه‌شو بریزیم بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 531.58,
   "end": 534.66,
   "text": "اون موقع همه‌تون مست می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 534.66,
   "end": 537.5,
   "text": "تنزل الملائكة والروح فيها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 537.5,
   "end": 539.4,
   "text": "حالا حضرت توضیح میده یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 539.4,
   "end": 543.5,
   "text": "والملائكة گوش بدید المؤمنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 543.5,
   "end": 546.58,
   "text": "الذین یملکون علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 546.58,
   "end": 549.62,
   "text": "آل محمد صلی الله علیه و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 549.62,
   "end": 551.3,
   "text": "اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 551.3,
   "end": 558.04,
   "text": "می‌فرماید اون ملائکه‌ای که نازل می‌شن شب قدر بر حجت خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 558.04,
   "end": 562.64,
   "text": "اهل ایمانی هستند که علم ما اهل بیت رو احصا کرده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 562.64,
   "end": 564.44,
   "text": "اونم نه، یعنی اهل ایمان‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 564.44,
   "end": 572.28,
   "text": "مؤمنین‌اند. خدا در قرآن می‌فرماید والملائک-- یک حرف قرآن حدیث داریم هفتاد هزار معنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 572.28,
   "end": 577.54,
   "text": "حالا یه معنای می‌شه گفت عرشی بلکه فوق عرشی‌ش رو حضرت اینجا داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 577.54,
   "end": 579.66,
   "text": "بریم جلوتر و حرفو تموم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 579.66,
   "end": 585.08,
   "text": "الله اکبر. حضرت صادق صلوات الله علیه فرمود والروح القدس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 585.08,
   "end": 589.42,
   "text": "هي فاطمة. به به، به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 589.42,
   "end": 593.3,
   "text": "اون روحی که تنزل الملائكة والروح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 593.3,
   "end": 598.22,
   "text": "می‌شه گفت اون الملائکه مؤمنین کمل‌اند، کاملین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 598.22,
   "end": 601.68,
   "text": "و اون روح مادر ما فاطمة سلام الله علیها است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 601.68,
   "end": 604.16,
   "text": "با اذن ربهم من کل امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 604.16,
   "end": 609.0,
   "text": "سلام هي حتى مطلع الفجر هم باز فرمود حتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 609.0,
   "end": 611.06,
   "text": "حتی یخرج القائم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 611.06,
   "end": 614.9,
   "text": "برمی‌گرده به روز خ-- سلام هي حتى مطلع الفجر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 614.9,
   "end": 617.92,
   "text": "روز خروج فرزندمون مهدی صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 617.92,
   "end": 622.24,
   "text": "پس نتیجه امشب که شب اول شب قدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 622.24,
   "end": 627.24,
   "text": "برای اینکه ما انشاالله امشب رو بتونیم درک کنیم هیچ چاره‌ای و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 627.24,
   "end": 629.72,
   "text": "هیچ راه دیگه‌ای جز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 629.72,
   "end": 633.74,
   "text": "توسل و توجه به حضرت زهرا سلام الله علیها نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 633.74,
   "end": 635.86,
   "text": "جای دیگه نرید. توسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 635.86,
   "end": 639.5,
   "text": "لذا توصیه می‌کنم اینو از مشایخ‌مون داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 639.5,
   "end": 642.34,
   "text": "من وقت‌هایی که شب قدر می‌بینم هیچ کاری نمی‌تونم بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 642.34,
   "end": 645.08,
   "text": "چون بالاخره سخنرانی، مداحی، روضه خونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 645.08,
   "end": 647.24,
   "text": "کل مجلسو باید چند ساعت اداره کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 647.24,
   "end": 650.58,
   "text": "خیلی فرصت‌های دیگه نمی‌کنیم کارهای شخصی انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 650.58,
   "end": 653.74,
   "text": "وقت‌هایی که فرصت ندارم فقط یه کار می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 653.74,
   "end": 655.98,
   "text": "و ازش بیشترین نتیجه رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 655.98,
   "end": 658.36,
   "text": "نماز استغاثه به حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 658.36,
   "end": 659.92,
   "text": "سلام الله علیها رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 659.92,
   "end": 662.58,
   "text": "تو مفاتیح هست شیخ عباس قمی گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 662.58,
   "end": 664.42,
   "text": "بسیار نماز عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 664.42,
   "end": 668.38,
   "text": "بسیار من از آثار و فواید و برکاتش برای بعضیا گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 668.38,
   "end": 672.64,
   "text": "تعجب کردند که چرا تا حالا ازش غافل بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 672.64,
   "end": 676.18,
   "text": "نماز استغاثه به حضرت زهرا سلام الله علیها رو امشب بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 676.18,
   "end": 680.94,
   "text": "وقتی اون پونصد و ده بار یا مولاتی یا فاطمة عقیلینی رو تو سجده گفتید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 680.94,
   "end": 683.96,
   "text": "بعد با زبان حال با حضرت زهرا حرف بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 683.96,
   "end": 690.14,
   "text": "همینطوری بگید مادر جان شب قدر گفتن امشب شب شماست و من از شما می‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 690.14,
   "end": 693.02,
   "text": "هرچی که هست در دامن شماست، در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 693.02,
   "end": 696.02,
   "text": "دست شماست و من به شما متوجه شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 696.02,
   "end": 700.5,
   "text": "هیچ کس هم جز شما ندارم. بچه وقتی راه گم می‌کنه میره سمت مادرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 700.5,
   "end": 703.6,
   "text": "همینطوری به همین راحتی با حضرت زهرا از من بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 703.6,
   "end": 706.26,
   "text": "امشب حرف بزنید نتیجه‌شو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 706.26,
   "end": 708.12,
   "text": "انشاالله عاقبت به بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 708.12,
   "end": 711.26,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 711.26,
   "end": 714.36,
   "text": "اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}