   "title": "## ضرر روزه؛ ملاک تشخیص مکلف",
   "start": 11.26,
   "end": 110.72
  },
  {
   "index": 1,
   "title": "## دو حدیث نبوی؛ بستن مجاری شیطان با جوع",
   "start": 110.72,
   "end": 244.84
  },
  {
   "index": 2,
   "title": "## اجماع حکما؛ صمت و جوع و سحر و خلوت و ذکر",
   "start": 244.84,
   "end": 265.18
  },
  {
   "index": 3,
   "title": "## هضم چهارگانه و نطفهٔ زلال",
   "start": 265.18,
   "end": 285.38
  },
  {
   "index": 4,
   "title": "## بستن شیطان در رمضان و پس از آن",
   "start": 285.38,
   "end": 621.15
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.7,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.7,
   "end": 7.36,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.36,
   "end": 11.26,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.26,
   "end": 14.94,
   "text": "استفتای دیگری که از رهبر عزیزمون شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.94,
   "end": 19.42,
   "text": "سؤال شده که برای اینکه روزه برای انسان ضرر داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.42,
   "end": 24.78,
   "text": "انسان رو مریض کنه یا مریضی انسان رو تشدید کنه که در هر دو صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.78,
   "end": 29.0,
   "text": "روزه واجب نیست و افطار واجبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.0,
   "end": 32.58,
   "text": "و روزه حرام میشه. خب برای تشخیص این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.58,
   "end": 39.2,
   "text": "این ملاک چیه؟ پزشک باید بگه یا خود شخص باید به این تشخیص برسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.2,
   "end": 42.5,
   "text": "که اگر حالا صرفا اگر دکتر گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.5,
   "end": 46.12,
   "text": "من خودم تشخیصم چیز دیگه‌ای بود چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.12,
   "end": 50.36,
   "text": "رهبر عزیزمون فرمودن که ملاک تشخیص خود طرفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.36,
   "end": 54.7,
   "text": "خود مکلف. البته از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.7,
   "end": 60.36,
   "text": "پزشک و متخصص مشورت می‌گیره اما خودش باید تشخیص بده در نهایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.36,
   "end": 62.92,
   "text": "که بالاخره چی شد این روزه آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.92,
   "end": 65.14,
   "text": "مریضی‌شو تشدید می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.14,
   "end": 72.64,
   "text": "یا مریضش می‌کنه؟ طول درمان اینا بهش میده اینها که در این صورت اگر اینچنین هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.64,
   "end": 74.78,
   "text": "روزه براش حرام میشه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.78,
   "end": 78.32,
   "text": "حتی تو یه استفتایی یه کسی به رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.32,
   "end": 81.38,
   "text": "نوشته که من چشمام ضعیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.38,
   "end": 84.86,
   "text": "دکتر گفته که مراقب باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.86,
   "end": 89.6,
   "text": "تو باید چشمت رو مراقبت کنی که ضعیف‌تر از این نشه خطرناکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.6,
   "end": 92.62,
   "text": "و من روزه می‌گیرم چشمم ضعیف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.62,
   "end": 98.96,
   "text": "چه کنیم؟ آقا فرمودن که اگه خودت، خودت می‌دونی اینو کاری به پزشک نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.96,
   "end": 101.5,
   "text": "خودت اینو می‌دونی که روزه بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.5,
   "end": 103.62,
   "text": "چشت ضعیف‌تر از این میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.62,
   "end": 110.72,
   "text": "روزه بر تو حرام است. همون شرع، شارع مقدس که واجب کرده همون حرام هم کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.72,
   "end": 115.44,
   "text": "یکی دیگه از اسرار روزه رو امروز به فضل الهی عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.44,
   "end": 121.2,
   "text": "که مرحوم حاجی سبزواری علیه الرحمه پیرامون ذیل اسرار روزe",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.2,
   "end": 122.78,
   "text": "دو تا حدیث نبوی آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.78,
   "end": 125.38,
   "text": "خیلی زیباست این احادیث. دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.38,
   "end": 127.54,
   "text": "ببینید چه اتفاقی داره در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.54,
   "end": 130.6,
   "text": "ضمن روزه میفته در وجود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.6,
   "end": 136.6,
   "text": "اولین حدیث می‌فرماید ان الشیطان لیجری من ابن ادم مجری الدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.6,
   "end": 140.42,
   "text": "میگه شیطان، فرمود شیطان همونطور چطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.42,
   "end": 144.2,
   "text": "خون در عروق ما همینطور در جریانه و به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.2,
   "end": 150.78,
   "text": "جزئیات اجزاء بدن ما به همه بافت‌های بدن ما این خون می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.78,
   "end": 156.5,
   "text": "میگه شیطان هم می‌تونه همینطوری نفوذ کنه به تمام اعضای بدن ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.5,
   "end": 162.96,
   "text": "که البته می‌دونید از طریق قوه وهم که بحثش قبلاً گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.96,
   "end": 166.32,
   "text": "حالا چه کنیم برای اینکه جلوی شیطان رو بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.32,
   "end": 169.82,
   "text": "پیغمبر می‌فرماید فدیقو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.82,
   "end": 173.8,
   "text": "بس از بستن میاد. می‌فرمود پس ببندید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.8,
   "end": 176.02,
   "text": "مجاریهو اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.02,
   "end": 182.46,
   "text": "جریانی، اون مجاری محل‌هایی که جاری میشه شیطان در وجود انسان رو ببندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.46,
   "end": 184.92,
   "text": "با چی؟ بالجوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.92,
   "end": 192.12,
   "text": "با گرسنگی. که منظور این گرسنگی هدفمند و نیت‌داره که کف نفس می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.12,
   "end": 197.18,
   "text": "به نیت قربت الی الله. حدیث دیگه می‌فرمود لولا ان الشیاطین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.18,
   "end": 200.52,
   "text": "لیوحون علی قلوب بنی ادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.52,
   "end": 204.82,
   "text": "اگر این نبود که شیاطین میان گرد قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.82,
   "end": 209.48,
   "text": "انسان رو می‌گیرن، حمله می‌کنن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.48,
   "end": 212.48,
   "text": "هروله کنان دور قلب انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.48,
   "end": 216.72,
   "text": "قرار می‌گیرن لنظروا الى ملكوت السماء قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.72,
   "end": 220.5,
   "text": "لام تأکید هم داره لنظروا قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.5,
   "end": 224.22,
   "text": "انسان نگاهش میفتاد به ملکوت آسمان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.22,
   "end": 228.98,
   "text": "این نشون میده که جوع یا همین روزه، جوع هدف‌مند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.98,
   "end": 233.02,
   "text": "چه اثر گرانقدری در وجود انسان ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.02,
   "end": 237.72,
   "text": "راه‌های نفوذ ان-- شیطان و شیاطین و ابالسه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.72,
   "end": 241.76,
   "text": "به وجود انسان به ضمیر و جان و سر انسان می‌بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.76,
   "end": 247.02,
   "text": "چه چیزی بالاتر از این؟ جالبه که حکما و عرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.02,
   "end": 252.1,
   "text": "من این چند روز بررسی می‌کردم هیچ کدومشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.1,
   "end": 254.0,
   "text": "تخطی از این قصه نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.0,
   "end": 259.9,
   "text": "همه‌شون به، حالا به هر کدوم لفظش فرق می‌کنه اما همه‌شون بلاتفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.9,
   "end": 265.18,
   "text": "فرمودن هیچ چیزی مثل گرسنگی و روزه نفس رو تأدیب نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.18,
   "end": 268.5,
   "text": "نفس رو عقاب نمی‌کنه و نفس رو، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.5,
   "end": 272.74,
   "text": "نفس رحمانی رو پرواز میده به معراج می‌کشونده جوع و گرسنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.74,
   "end": 274.68,
   "text": "یه شعری هم هست که صمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.68,
   "end": 277.38,
   "text": "با صاد، با صاد یعنی سکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.38,
   "end": 281.8,
   "text": "صمت و جوع و سحر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.8,
   "end": 283.88,
   "text": "خلوت و حالا بعضیا میگن عزلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 283.88,
   "end": 287.34,
   "text": "خلوت من دیدم. ذکر به دوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.34,
   "end": 292.52,
   "text": "این پنج تا. ناتمامان جهان را کند این پنج تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.52,
   "end": 296.18,
   "text": "اون ذکر به دوام هم بزرگان فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.18,
   "end": 299.42,
   "text": "ذکر به دوام، اون چهار تا قبلیه دوام نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.42,
   "end": 301.22,
   "text": "صمت، سکوت دوام نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.22,
   "end": 304.66,
   "text": "جوع دوام نداره. سحر یعنی بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.66,
   "end": 306.82,
   "text": "اون سحر با هجریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.82,
   "end": 309.18,
   "text": "چیز نیست. سحر از بیداری میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.18,
   "end": 311.5,
   "text": "بیداری اصلاً صرف اینکه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.5,
   "end": 318.54,
   "text": "دل شب پاشه بیدار باشه و خلوت، خلوت کنه که هر کدوم از اینا بزرگان توضیح دادن تو کتاب‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.54,
   "end": 322.64,
   "text": "ذکر به دوام باشه. اون‌ها افراط و تفریط نباید داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.64,
   "end": 325.18,
   "text": "یعنی اینکه انسان اگر صبح تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.18,
   "end": 327.54,
   "text": "بعد تا غروب نمی‌خوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.54,
   "end": 329.72,
   "text": "وقتی که افطار شد بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.72,
   "end": 332.64,
   "text": "گفتن که آقا بخور ولو شده یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.64,
   "end": 335.24,
   "text": "هسته خرما تو دهانت بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.24,
   "end": 339.54,
   "text": "اینطور نباشه که به تفریط بیفتی که این تفریط و افراط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.54,
   "end": 345.38,
   "text": "باعث میشه مجرای شیطان باز بشه و شیطان به رو انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.38,
   "end": 347.74,
   "text": "باز بشه راهش. یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.74,
   "end": 351.36,
   "text": "بحثی هست توی علم طب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.36,
   "end": 354.12,
   "text": "و یادمه که این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.12,
   "end": 357.1,
   "text": "هضم چهارگانه رو سقراط داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.1,
   "end": 360.43,
   "text": "که اطباء اسلامی هم اینو تأیید کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.43,
   "end": 364.83,
   "text": "این رو دقت بفرمایید که ما می‌دونید تو بدنمون چهار تا هضم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.83,
   "end": 367.75,
   "text": "وقتی غذا می‌خوریم وارد اول روده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.75,
   "end": 369.67,
   "text": "هضم اول، ببخشید معده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.67,
   "end": 373.03,
   "text": "هضم اول معده است. هضم دوم کبده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.03,
   "end": 375.25,
   "text": "هضم سوم روده‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 375.25,
   "end": 378.73,
   "text": "هضم چهارم کجاست؟ اصلاً شنیدیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 378.73,
   "end": 384.13,
   "text": "هضم چهارم وجود داره. هضم چهارم که البته تک‌تک این‌ها رو علامه حسن‌زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.13,
   "end": 385.95,
   "text": "قشنگ توضیح مفصلی دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 385.95,
   "end": 390.99,
   "text": "هضم چهارم در کلیه‌ی اعضا و بافت‌های بدن صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 390.99,
   "end": 394.13,
   "text": "جزء جزء سلول‌های بدن هم هضم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 394.13,
   "end": 398.49,
   "text": "وقتی این اغذیه جمع میشه توی تک‌تک اعضای بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 398.49,
   "end": 401.67,
   "text": "بعد این‌ها عصاره‌شون گرفته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 401.67,
   "end": 405.97,
   "text": "دقت بفرمایید آنچه که در تک‌تک اعضای بدن جمع شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 405.97,
   "end": 410.27,
   "text": "عصاره‌ش، چکیده‌ش، ذوبده‌ش عصاری میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.27,
   "end": 412.75,
   "text": "گرفته میشه. اینا جمع میشه تو مغز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 412.75,
   "end": 414.61,
   "text": "اون عصاره جمع میشه تو مغز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 414.61,
   "end": 416.91,
   "text": "یعنی چکیده، دیگه خلاصه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 416.91,
   "end": 420.15,
   "text": "میشه گفت بهترین چیزی که وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 420.15,
   "end": 425.35,
   "text": "جمع میشه تو مغز از طریق مغز از کنار نخاع یا داخل نخاع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 425.35,
   "end": 429.09,
   "text": "یه رگی هست اینو انتقال میده به محل نطفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 429.09,
   "end": 431.27,
   "text": "و این همون نطفه انسان میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.27,
   "end": 436.43,
   "text": "اینکه بچه همه اجزای بدنش شبیه پدر و مادرشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 436.43,
   "end": 440.67,
   "text": "ابروها، چشمش، قیافش، قد و هیکلش که البته پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 440.67,
   "end": 443.67,
   "text": "فرمود این از محسنات پدر و مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 443.67,
   "end": 446.19,
   "text": "این از توفیقات پدر و مادره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.19,
   "end": 448.53,
   "text": "که بچه‌شون شبیه به خودشون بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 448.53,
   "end": 451.75,
   "text": "این بحث مفصل پزشکی می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 451.75,
   "end": 454.37,
   "text": "تو طب اسلامی خیلی هم شیرینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 454.37,
   "end": 457.55,
   "text": "که وقتی انسان روزه می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 457.55,
   "end": 461.89,
   "text": "باعث میشه که این اعتلا، اع-اعتدال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 461.89,
   "end": 464.75,
   "text": "امتزا-- این مزاج انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 464.75,
   "end": 468.87,
   "text": "اصطلاحاً میگن امزجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 468.87,
   "end": 473.13,
   "text": "معتدل میشه. معتدل میشه مزاج انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 473.13,
   "end": 478.59,
   "text": "یعنی اون اضافات، چیزهایی حالا ما بهش میگیم تفاله، بیخودی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 478.59,
   "end": 480.61,
   "text": "اون‌ها از وجود دفع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 480.61,
   "end": 483.31,
   "text": "سموم حالا بهتره بگیم. به یک نوعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 483.31,
   "end": 490.49,
   "text": "سم‌ها از جزء جزء بدن دفع میشه و اون نطفه‌ای که درست میشه نطفه بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 490.49,
   "end": 493.69,
   "text": "زلال و پاکیه. حتی تأثیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 493.69,
   "end": 498.41,
   "text": "یکی از اسرار روزه‌ست. تأثیر روزه در تشکیل نطفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 498.41,
   "end": 502.55,
   "text": "تأثیر روزه در عدم، دقت بفرمایید کلمات رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 502.55,
   "end": 507.31,
   "text": "در عدم دسترسی شیاطین به نطفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 507.31,
   "end": 509.91,
   "text": "و به ضمیر و جان انسان و بچه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 509.91,
   "end": 512.37,
   "text": "لذا بعضی از بزرگان میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 512.37,
   "end": 515.09,
   "text": "من زیاد دیدم تو سفارشاتشون به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 515.09,
   "end": 517.11,
   "text": "شاگردان ممتازشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 517.11,
   "end": 520.71,
   "text": "که برای تشکیل نطفه چهل روز روزه بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 520.71,
   "end": 525.67,
   "text": "روزه درست، صواب، دو سه درمان و حتی اینکه چی بخورید، چی نخورید هم میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 525.67,
   "end": 530.03,
   "text": "این‌طور نیست که یه دفعه یکی میشه ابوعلی سینا که میشه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 530.03,
   "end": 532.39,
   "text": "عرض شود علامه حسن‌زاده همینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 532.39,
   "end": 535.99,
   "text": "شما همینطوری الان هیچ کدوم از این‌ها رو جامعه لحاظ نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 535.99,
   "end": 539.01,
   "text": "همینطوری معذرت میخوام تفاله terwijl اجتماع میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 539.01,
   "end": 541.79,
   "text": "همینطوری نطفه تشکیل میشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 541.79,
   "end": 545.29,
   "text": "بر اثر یک قرا-قرابتی و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 545.29,
   "end": 547.47,
   "text": "عرض شود جماعی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 547.47,
   "end": 550.51,
   "text": "یک غریزه‌ای تحریک میشه و اصلاً هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 550.51,
   "end": 553.03,
   "text": "نه اعتز-اعتدالی وجود داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 553.03,
   "end": 556.09,
   "text": "نه مجراها بسته شده، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 556.09,
   "end": 560.73,
   "text": "عرض شود برنامه خاصی برای این طرف در نظر گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 560.73,
   "end": 564.05,
   "text": "حواسمون جمع باشه. یکی از اینکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 564.05,
   "end": 568.81,
   "text": "جالبه اینم بدونید اینکه تو ماه رمضان تا حالا سؤال شده براتون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 568.81,
   "end": 572.77,
   "text": "چرا تو ماه رمضان دست و پای شیطون بسته است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 572.77,
   "end": 577.21,
   "text": "یکی از بزرگان می‌فرمود این نیستش که فقط تو ماه رمضان بسته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 577.21,
   "end": 579.61,
   "text": "تو ماه رمضان هم میشه حتی باز باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 579.61,
   "end": 585.95,
   "text": "کی؟ آدم افطار کنه ولع نشون بده، طمع کنه بخوره، انقدر بخوره که بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 585.95,
   "end": 589.71,
   "text": "اینم یعنی افراط کنه. اینم باز دست و پای شیطون رو باز کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 589.71,
   "end": 592.47,
   "text": "شهوات گل می‌کنن دوباره تو وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 592.47,
   "end": 598.63,
   "text": "اینکه خدا فرموده تو ماه رمضان دست و پای شیطون رو بستم یعنی این مجراها رو با روزه شما بستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 598.63,
   "end": 603.59,
   "text": "شیطون دیگه نه. اگر کسی تو همین ماه رمضان مجراها رو نبنده باز شیطون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 603.59,
   "end": 607.25,
   "text": "اگر کسی بعد از ماه رمضان این مجراها رو برای شیطون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 607.25,
   "end": 610.21,
   "text": "ببنده باز دست و پای شیطون بسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 610.21,
