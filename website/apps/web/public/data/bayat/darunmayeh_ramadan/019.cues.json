 "chapters": [
  {
   "index": 0,
   "title": "## فطر و افطار و فطرت؛ یک ریشه",
   "start": 10.84,
   "end": 84.78
  },
  {
   "index": 1,
   "title": "حضرت یوسف دعا که می‌کند با این اسم خدا را می‌خواند. یا آیهٔ یک سورهٔ فاطر:",
   "start": 84.78,
   "end": 137.48
  },
  {
   "index": 2,
   "title": "## فاطمه از الفاطر؛ منشأ فیضان فیض",
   "start": 137.48,
   "end": 251.98
  },
  {
   "index": 3,
   "title": "خلق یعنی اندازه‌گیری کردن. آیه‌ای در اواخر سورهٔ حشر:",
   "start": 251.98,
   "end": 331.74
  },
  {
   "index": 4,
   "title": "## دو فرح مؤمن روزه‌دار؛ شکوفایی خلقت",
   "start": 331.74,
   "end": 410.97
  },
  {
   "index": 5,
   "title": "## ماه رمضان؛ اتصال به روح اعظم و حضرت زهرا",
   "start": 410.97,
   "end": 547.31
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.42,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.42,
   "end": 6.76,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.76,
   "end": 10.84,
   "text": "و ربانیة آیاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.84,
   "end": 15.18,
   "text": "اجازه بفرمایید که در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.18,
   "end": 20.82,
   "text": "فطر و کلمه فطر و افطار و فطریه و فاطر و فتر-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.82,
   "end": 25.08,
   "text": "فتر و این‌ها فطرت و که همه از یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.08,
   "end": 28.68,
   "text": "ریشه هستند به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.68,
   "end": 34.12,
   "text": "عید شریف فطر با هم نکته‌ای رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.12,
   "end": 37.62,
   "text": "بررسی کنیم. ببینید فطر بر خلاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.62,
   "end": 40.74,
   "text": "خلق، فتر، خلق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.74,
   "end": 43.8,
   "text": "فطر. محققین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.8,
   "end": 50.78,
   "text": "خصوصاً در حالا مثلاً مفردات مرحوم اف- اصفهانی در سها اللغه اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.78,
   "end": 57.5,
   "text": "لغت شناسان که دلالت داره فهم این لغات بر فهم آیات قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.5,
   "end": 61.48,
   "text": "اون‌ها راهرو هستند که ما رو به آیات قرآن برسونند، به فهمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.48,
   "end": 65.98,
   "text": "اینا می‌فرمایند فطر یعنی شکافتن نه یعنی خلق کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.98,
   "end": 70.74,
   "text": "فتره یعنی شکافت. در قرآن هم داریم مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.74,
   "end": 74.72,
   "text": "آیه صد و یک سوره یوسف \"فاطر السماوات و الارض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.72,
   "end": 77.94,
   "text": "حضرت یوسف دعا که می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.94,
   "end": 84.78,
   "text": "با این اسم خدا رو می‌خونه \"فاطر السماوات والارض انت ولیی في الدنيا والاخره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.78,
   "end": 90.74,
   "text": "یا آیه یک سوره فاطر \"الحمد لله فاطر السماوات والارض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.74,
   "end": 95.46,
   "text": "یا اون دعای حضرت ابراهیم که مستحبه قبل از نماز بگیم \"اني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.46,
   "end": 98.6,
   "text": "وجهت وجهي للذي فطر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.6,
   "end": 104.1,
   "text": "فطر السماوات والارض حنيفا مسلما و ما انا من المشركين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.1,
   "end": 111.78,
   "text": "این فتره. که حالا حضرت علامه طباطبایی علیه الرحمه تصریح می‌کنند که اینجا مراد از آسمان‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.78,
   "end": 114.52,
   "text": "زمین که فطر السماوات والارض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.52,
   "end": 118.28,
   "text": "نه یعنی فر- صرفاً همین آسمان و زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.28,
   "end": 123.02,
   "text": "مثلاً مد نظر ما، بلکه جمیع کائنات، همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.02,
   "end": 127.4,
   "text": "ممکنات که مجموع نظام عالم رو ایشون می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.4,
   "end": 130.04,
   "text": "که دلالت بر فیض مستمر حق داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.04,
   "end": 132.34,
   "text": "این کلام علامه طباطباییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.34,
   "end": 137.48,
   "text": "دلالت بر فیض مستمر حق داره بر همه این کائنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.48,
   "end": 145.66,
   "text": "و اشاره می‌کنه به اون فرمایش شریفی که حدیث داریم که الفاطر اسم فاطمه از الفاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.66,
   "end": 149.9,
   "text": "گرفته شده. حتی من پیداش کردم از بهار جلد سه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.9,
   "end": 152.34,
   "text": "جلد چهل و سه، صفحه پونزده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.34,
   "end": 159.82,
   "text": "شق الله لک یا فاطمه اینو پیغمبر به حضرت زهرا فرمودند شق الله لک یا فاطمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.82,
   "end": 163.7,
   "text": "اسما من اسماءه فهو الفاطر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.7,
   "end": 171.66,
   "text": "فاطمه جان خدا منشق کرده اسما رو از همدیگه یکی از اسم‌هاش الفاطر است و انت فاطمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.66,
   "end": 175.16,
   "text": "شبهه. و تو هم از اون الفاطر گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.16,
   "end": 178.5,
   "text": "بعد علامه طباطبایی اینجا اشاره می‌کنه به همین موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.5,
   "end": 181.34,
   "text": "می‌فرماید که فتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.34,
   "end": 186.08,
   "text": "که آسمان‌ها و زمین یعنی همه عوالم هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.08,
   "end": 188.96,
   "text": "منشاء فیضش حضرت حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.96,
   "end": 193.14,
   "text": "و چون فاطمه از الفاطر گرفته شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.14,
   "end": 197.98,
   "text": "پس فاطمه زهرا منشاء همه برکات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.98,
   "end": 201.52,
   "text": "فیضان فیض فیاض علی الاطلاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.52,
   "end": 204.26,
   "text": "بر همه کائنات یعنی فیض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.26,
   "end": 208.52,
   "text": "فیض از حضرت زهرا می‌ریزه که بکُن فَتَحَ الله و بِکُن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.52,
   "end": 212.62,
   "text": "يَخْتِمُ یا در جامعه کبیره می‌کنی- می‌خونیم که انذا کر الخير",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.62,
   "end": 218.68,
   "text": "کنتم اوله و اصله و فرعه و معدنه و مأواه و منتهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 218.68,
   "end": 221.14,
   "text": "و، و، و. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.14,
   "end": 223.42,
   "text": "دلالت بر فضـ فاط- بر فطر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.42,
   "end": 228.34,
   "text": "حالا اون موضوعی که ما در درون ماه ما ماه مبارک رمضان ارتباط شب قدر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.34,
   "end": 232.92,
   "text": "روح اعظم با حضرت زهرا گفتیم اینجا الان خودشو بهتر نشون میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.92,
   "end": 235.48,
   "text": "که ارتباط خود عید فطر حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.48,
   "end": 239.12,
   "text": "با حضرت زهرا. اصلاً فطر یعنی فتره یعنی شکفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.12,
   "end": 242.96,
   "text": "شکافت. خلق یعنی اندازه‌گیری کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.96,
   "end": 251.98,
   "text": "یه آیه در فکر کنم سوره حشر باشه آخرای سوره حشر \"هو الله الخالق البارئ المصور له الاسماء الحسنی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.98,
   "end": 256.7,
   "text": "خالق رو اونجا ذیلش مفسرین فرمودند یعنی اندازه‌گیری کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.7,
   "end": 258.7,
   "text": "خالق اندازه‌گیری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 258.7,
   "end": 262.54,
   "text": "باره می‌دوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.54,
   "end": 265.46,
   "text": "ببخشید برش میده. باره بعد از اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.46,
   "end": 268.24,
   "text": "شما یه خیاط وقتی می‌خواد یه چیزی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.24,
   "end": 270.8,
   "text": "مثلاً تولید کنه، یه لباسی رو اول چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.8,
   "end": 275.28,
   "text": "اندازه می‌گیره، الگو می‌زنه. بعد باره اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.28,
   "end": 277.38,
   "text": "چیکار می‌کنه؟ می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.38,
   "end": 280.64,
   "text": "برش می‌زنه. باره یعنی برش زننده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 280.64,
   "end": 282.56,
   "text": "بعد چیکار می‌کنه؟ اینا رو با هم می‌دوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.56,
   "end": 285.28,
   "text": "شکل بهش میده مصور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.28,
   "end": 287.8,
   "text": "که قوه خیال ما از هر اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.8,
   "end": 291.38,
   "text": "مصور حضرت حقه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.38,
   "end": 295.02,
   "text": "اینجا این فاطر یعنی شکفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.02,
   "end": 300.76,
   "text": "شکفتن الان به یک، به این معنایی که داریم می‌گیم شما بیاید اینو پیاده کنید تو همین ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.76,
   "end": 304.36,
   "text": "الان عید فطر داره چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 304.36,
   "end": 309.2,
   "text": "داره از درون ماه مبارک رمضان می‌شکوفد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.2,
   "end": 313.94,
   "text": "اصلاً هر ماهی از ماه قبلش شکفته می‌شه، شکوفا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 313.94,
   "end": 320.96,
   "text": "اصلاً یکی از اسم‌هایی که به این شکوفه‌ها عربا می‌دن در زبان عربی به شکوفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.96,
   "end": 325.6,
   "text": "به این شکوفه‌ها می‌گن اینا فاطرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.6,
   "end": 328.5,
   "text": "فطرن. اصلاً عید فطر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 328.5,
   "end": 331.74,
   "text": "افطار، فطرت همش از این ریشه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.74,
   "end": 335.16,
   "text": "چرا دم افطار مؤمن یه شکوفایی در وجودش هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 335.16,
   "end": 341.36,
   "text": "حدیث داریم دیگه که دو تا جا مؤمن، مؤمن روزه‌دار، فرح و انبساط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.36,
   "end": 344.38,
   "text": "میشه شکوفایی درونشه. یکی وقت افطاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.38,
   "end": 348.0,
   "text": "نه به خاطر خوردنه، خدا خواسته شکوفا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.0,
   "end": 350.5,
   "text": "یکی هم وقت دیدار روز قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.5,
   "end": 354.16,
   "text": "ببینید همه چیز شکوفاییه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.16,
   "end": 358.68,
   "text": "شکفتنه که ما برای همین فطریه میدیم، افطار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.68,
   "end": 363.26,
   "text": "فطرت ما هم از درون شکوفایی در وجود ما ایجاد می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.26,
   "end": 366.36,
   "text": "که هر ماهی از ماه قبل شکوفا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.36,
   "end": 369.89,
   "text": "حالا شما دقت کنید اصلاً مجموعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 369.89,
   "end": 373.11,
   "text": "خلائق رو معمولاً از شکفتن بیرون اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.11,
   "end": 375.21,
   "text": "دانه رو تو زمین می‌کاری می‌شکفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.21,
   "end": 378.23,
   "text": "تخم مرغ شکفته می‌شه مرغ میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.23,
   "end": 380.87,
   "text": "شما دقت کنید خود انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.87,
   "end": 383.87,
   "text": "انسان از دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.87,
   "end": 387.01,
   "text": "مثلاً اون رحم مادر شکفته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.01,
   "end": 391.69,
   "text": "خود نطفه شکفته می‌شه، می‌شه مضغه شکفته می‌شه، می‌شه علقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.69,
   "end": 394.81,
   "text": "آیه قرآن رو دارم می‌خونم‌ها ترجمه‌شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.81,
   "end": 397.99,
   "text": "بعد علقه شکفته می‌شه، می‌شه لحم و ج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 397.99,
   "end": 401.25,
   "text": "اون عظام و جنین و همینطوری از هم می‌شکفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.25,
   "end": 407.29,
   "text": "شکوف، شکوفاییه. وقتی شکوفه، اون گل از درخت جدا شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.29,
   "end": 410.97,
   "text": "دیگه از اصلش جدا، جدا شده دیگه شکوفایی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 410.97,
   "end": 413.73,
   "text": "ماه مبارک رمضان خصوصیتش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 413.73,
   "end": 418.37,
   "text": "که بیاد بین ما و اون موجودیت اصلی‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.37,
   "end": 421.17,
   "text": "که اون روحه، روح اعظم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 421.17,
   "end": 426.99,
   "text": "به یک معنا حضرت زهرا در مقام پرورش است، ارتباط و اتصال برقرار کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.99,
   "end": 429.23,
   "text": "که شکوفا بشویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.23,
   "end": 431.99,
   "text": "خلاصه مطلب عزیزان خسته‌تون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.99,
   "end": 435.95,
   "text": "هرکس که در این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.95,
   "end": 439.77,
   "text": "ارتباط پیدا کرد با اون وحدت کلیه، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.77,
   "end": 445.33,
   "text": "وحدت کلیه‌ای که دیروز گفتیم سعه ضیق مظاهر داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 445.33,
   "end": 447.15,
   "text": "و شدت و ضعف مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.15,
   "end": 450.83,
   "text": "ارتباط گرفت با اون وحدت کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 450.83,
   "end": 454.27,
   "text": "از چی؟ دل این کثرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.27,
   "end": 458.51,
   "text": "این شکوفا شده. این می‌شه در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.51,
   "end": 461.23,
   "text": "اون هنری که شهدا دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 461.23,
   "end": 463.79,
   "text": "هم مثل نادق طالب زاده‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.79,
   "end": 467.57,
   "text": "قاسم سلیمانی‌ها، از شهید حججی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.57,
   "end": 470.49,
   "text": "این‌ها چه کردن؟ یا شهید آوینی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.49,
   "end": 472.89,
   "text": "در دل این کثرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.89,
   "end": 476.97,
   "text": "که حالا دیگه فرصت نیست احادیثی رو داشتم اینجا ارائه بدم فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 476.97,
   "end": 482.05,
   "text": "هر مقدار بسته. در دل این کثرات ارتباط می‌گیرن با اون وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 482.05,
   "end": 484.41,
   "text": "به طریق چی؟ اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 484.41,
   "end": 487.57,
   "text": "ف-- فیض کی بود که فیض رو می‌آورد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.57,
   "end": 489.53,
   "text": "به یک معنا روح اعظم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.53,
   "end": 493.77,
   "text": "به یک معنا حضرت زهرا بود که این‌ها اتحاد وجودی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 493.77,
   "end": 496.71,
   "text": "که در درون مایه این ماه اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.71,
   "end": 501.41,
   "text": "پس عید مبارک فطر یعنی شکوفایی از درون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.41,
   "end": 505.51,
   "text": "یعنی رفتن حرکت ما از کثرت به وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 505.51,
   "end": 508.57,
   "text": "رسیدن به اون وحدت جمعی و مقام روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 508.57,
   "end": 511.05,
   "text": "که مقام، مقام روح، مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.05,
   "end": 515.79,
   "text": "وحدت و جمعی‌ست، اجمال است و مقام قلب یعنی این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.79,
   "end": 520.17,
   "text": "م-مقام تفصیل و کثرت است بر هممون مبارک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.17,
   "end": 529.21,
   "text": "انشاالله این شکوفایی تا قیام قیامت ادامه پیدا کنه تا جایی که ما دستمون برسه به دامن حضرت صدیقه طاهره که مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.21,
   "end": 532.15,
   "text": "پرورش عالم و اون روح کل رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.15,
   "end": 537.15,
   "text": "ماه رمضان، ماه اتصال و ارتباط ما با مادرمون حضرت زهرا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 537.15,
   "end": 543.13,
   "text": "خلاصه انشاالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 543.13,
   "end": 547.31,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}