   "title": "## فاطر و فطر در تحقیق مصطفوی",
   "start": 24.66,
   "end": 146.92
  },
  {
   "index": 1,
   "title": "## خالق و فاطر؛ علم و قدرت",
   "start": 146.92,
   "end": 166.96
  },
  {
   "index": 2,
   "title": "## ابن‌عباس و أنا فطرتها",
   "start": 166.96,
   "end": 194.42
  },
  {
   "index": 3,
   "title": "## دعای روز سی‌ام؛ فروع محکم به اصول",
   "start": 194.42,
   "end": 733.1
  },
  {
   "index": 4,
   "title": "## دعای عید فطر و تکرار الله و رباه",
   "start": 733.1,
   "end": 828.58
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.5,
   "end": 4.8,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.8,
   "end": 7.66,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.66,
   "end": 12.26,
   "text": "و ربانی آیه. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.26,
   "end": 15.56,
   "text": "اجازه بفرمایید که در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.56,
   "end": 18.84,
   "text": "جلسه آخر که در این ماه توفیق شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.84,
   "end": 21.5,
   "text": "باز هم در خدمت شما باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.5,
   "end": 27.26,
   "text": "نکته دیگری که پیرامون فطر و در ادامه مبحث درون مایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.26,
   "end": 31.6,
   "text": "ماه مبارک رمضان مونده بود رو تقدیم کنم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.6,
   "end": 37.52,
   "text": "علامه مصطفوی در کتاب شریف التحقیق فی کلمات القرآن کریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.52,
   "end": 44.2,
   "text": "می فرماید که فاطر از اسماء الهی بوده و دلالت می‌کند بر کسی که پس پس از تکوین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.2,
   "end": 48.14,
   "text": "احوال و کیفیاتی احداث می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.14,
   "end": 51.04,
   "text": "یعنی مربوط به بحث بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.04,
   "end": 53.7,
   "text": "نظام تکوینی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.7,
   "end": 57.5,
   "text": "بحث فاطر بودن حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.5,
   "end": 60.64,
   "text": "که به عنوان تربیت و ربوبیت باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.64,
   "end": 68.48,
   "text": "این عنوان فاطر رو تعریف میکنه در تربیت و ربوبیت که بعد از نظام تکوین است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.48,
   "end": 70.94,
   "text": "که ما قبلاً هم یادتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.94,
   "end": 73.88,
   "text": "جلسه پیش عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.88,
   "end": 78.88,
   "text": "نام حضرت فاطمه صلوات الله علیهم از اسم فاطر الفاطر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.88,
   "end": 82.94,
   "text": "منشعب شده. اتفاقا در کتاب فرایض جل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.94,
   "end": 87.04,
   "text": "یک صفحه سی و شش هم حدیث داریم که هؤلاء خمسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.04,
   "end": 90.38,
   "text": "شفق لهم خمسه اسماء من اسماء خدای منان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.38,
   "end": 94.02,
   "text": "فرمودند این حدیث قدسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.02,
   "end": 100.88,
   "text": "اشاره به چهارده به پنج تن آل عبا و این خمسه طیبه می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.88,
   "end": 108.76,
   "text": "و می فرماید فانا محمود و هذا محمد صلى الله عليه و آله و سلم و انا العلی و هذا علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.76,
   "end": 112.6,
   "text": "و انا الفاطر و هذه فاطمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.6,
   "end": 117.66,
   "text": "اینجا و انا الاحسان و هذا الحسن و انا المحسن و هذا الحسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.66,
   "end": 120.48,
   "text": "صلوات الله علیه. بله این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.48,
   "end": 124.8,
   "text": "اشاره دارد به چی؟ به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.8,
   "end": 130.18,
   "text": "و انا الفاطر و هذه فاطمه که فاطمه از فاطر گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.18,
   "end": 132.64,
   "text": "اینجا هم همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.64,
   "end": 137.8,
   "text": "دقت میکنید در اینجا فرمایشات علامه مصطفوی همینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.8,
   "end": 144.96,
   "text": "عنوان فاطر رو پیاده میکنه در تربیت و ربوبیت که بعد از تکوین واقع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.96,
   "end": 149.04,
   "text": "در حالی که مفاهیم خالق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.04,
   "end": 151.66,
   "text": "ایجاد، ابداع، اختراع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.66,
   "end": 156.68,
   "text": "اینها همه به اصل، اصل تکوین برمی‌گرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.68,
   "end": 161.46,
   "text": "که در حقیقت این برمی‌گرده به همون معنای عام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.46,
   "end": 165.8,
   "text": "خالق بودن و خلقت که مطلق ایجاد و هستی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.8,
   "end": 168.08,
   "text": "سخن میگه که مربوط به قبل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.08,
   "end": 170.36,
   "text": "موضوع ربوبیت و پرورش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.36,
   "end": 173.14,
   "text": "ربوبیت و تربیت و پرورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.14,
   "end": 178.04,
   "text": "برمی‌گرده به بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.04,
   "end": 181.64,
   "text": "خلقت و خاص‌تر معناش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.64,
   "end": 187.74,
   "text": "لذا از این حیث گفتند که خالق بودن خداوند اشاره به صفت علم الهی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.74,
   "end": 193.42,
   "text": "یعنی اون اندازه‌گیری رو خدا وقتی می‌خواد چون عرض کردیم جلسه پیش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.42,
   "end": 196.4,
   "text": "معنایی که در خلقت هست یعنی اندازه‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.4,
   "end": 199.96,
   "text": "هو الله الخالق البارئ المصور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.96,
   "end": 202.34,
   "text": "این خالق یعنی اندازه‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.34,
   "end": 205.2,
   "text": "خب بر اساس چی خدا اندازه می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.2,
   "end": 209.34,
   "text": "اندازه، قدر، میزان یعنی قابلیت اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.34,
   "end": 212.52,
   "text": "قدر، قَدَر، قَدَرها و قدرها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.52,
   "end": 215.82,
   "text": "و ما ننزله إلا بقدر معلوم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.82,
   "end": 219.8,
   "text": "در غوص نزول این چگونه اتفاق می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.8,
   "end": 224.84,
   "text": "قَدَرها رو قدرها رو چگونه خدا تعیین میکنه اندازه‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.84,
   "end": 227.14,
   "text": "به صفت علمش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.14,
   "end": 230.0,
   "text": "به صفت علم الهیه، به اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.0,
   "end": 232.3,
   "text": "عالم و علیم بودنشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.3,
   "end": 236.1,
   "text": "پس در حقیقت خالق بودن خداوند اشاره به صفت علمش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.1,
   "end": 239.5,
   "text": "در حالی که فاطر بودن به صفت قدرتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.5,
   "end": 241.84,
   "text": "به قدرتش شکوفا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.84,
   "end": 245.74,
   "text": "حالا ما حالتی که ش-اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.74,
   "end": 250.34,
   "text": "شکوفا میشه یک شکوفه یا یک گل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.34,
   "end": 255.76,
   "text": "ساقه و از برگ یک درخت بهش حالت انفطار میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.76,
   "end": 258.48,
   "text": "فطر. اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.48,
   "end": 261.28,
   "text": "فاطر علی الاطلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.28,
   "end": 270.0,
   "text": "انفقر. یعنی این شکوفه رو به شکوفایی رسوند که یک آن اگر ارتباط اتصال این شکوفه قطع بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.0,
   "end": 272.88,
   "text": "دیگه این فطر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.88,
   "end": 280.38,
   "text": "فتره درش نیست. پس خلقت با توجه به علم خدا به کلیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 280.38,
   "end": 285.44,
   "text": "و جزئیات اشیا که به ذات اونا تعلق گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.44,
   "end": 289.52,
   "text": "مربوطه. در حالی که انفطار نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.52,
   "end": 293.34,
   "text": "فطر نه، فتره نه، فطریه، فطرت اینا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.34,
   "end": 297.58,
   "text": "از یک ریشه‌اند دیگه. که حالا در وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 297.58,
   "end": 302.4,
   "text": "اینها این حقایقی که داریم عرض می‌کنیم این شکوفایی از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.4,
   "end": 307.16,
   "text": "مرتبه احدیت حضرت حق مندمج شده و وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 307.16,
   "end": 312.52,
   "text": "که خی-- پس این رو هم عرض کردیم جلسه پیش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.52,
   "end": 316.1,
   "text": "هر ماهی از ماه دیگه بیرون میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.1,
   "end": 319.02,
   "text": "و از دل دقت بفرمایید چی عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 319.02,
   "end": 324.72,
   "text": "مثلا اول شوال از دل رمضان شکوفا میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 324.72,
   "end": 328.36,
   "text": "شکفته میشه. اتفاقا در این خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.36,
   "end": 333.02,
   "text": "ابن عباس یه روایتی ازش داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.02,
   "end": 340.26,
   "text": "می فرماید وقتی معنای فاطر رو دقیق فهمیدم که دو تا عرب صحرانشین و بادیه نشین و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.26,
   "end": 344.58,
   "text": "از این بیابون نشین‌ها اومدن پیش من با هم دعوا داشتن سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.58,
   "end": 348.24,
   "text": "یک چاهی که کنده بودن دعوا داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.24,
   "end": 351.46,
   "text": "بعد میگه یکی از اون‌ها گفت أنا فترت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.46,
   "end": 354.56,
   "text": "فترتها. أنا فترتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.56,
   "end": 357.46,
   "text": "من، من اول اون رو کندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 357.46,
   "end": 360.18,
   "text": "هی به این اشاره می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.18,
   "end": 363.06,
   "text": "اصرار می‌کرد که أنا فترتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 363.06,
   "end": 367.36,
   "text": "من اول کندم اونو. بعد اینجا میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.36,
   "end": 374.88,
   "text": "من اینجا بود که متوجه معنای دقیق فاتر شدم که معلوم شد فاتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 374.88,
   "end": 379.82,
   "text": "ااا همون مبدا اشاره دارد به همون مبدا و آغازگر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 379.82,
   "end": 385.08,
   "text": "آغازگر که بعد از خلقت که اندازه‌گیریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.08,
   "end": 388.02,
   "text": "میاد اون عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 388.02,
   "end": 390.34,
   "text": "ااا برشی که میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.34,
   "end": 393.06,
   "text": "بر اساس اسم بارع و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.06,
   "end": 397.1,
   "text": "دوخت و دوزی که میده بر اساس اسم المسور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.1,
   "end": 399.88,
   "text": "بعد میاد اینو شکوفا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.88,
   "end": 404.9,
   "text": "یه مقام شکوفائه، مقام تربیته، مقام پرورشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.9,
   "end": 407.72,
   "text": "که عرض شد شب قدر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.72,
   "end": 411.84,
   "text": "این مقام تنزل پیدا میکنه میاد در نشئه خاکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.84,
   "end": 414.7,
   "text": "که ما مرتبط بشیم با اون مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 414.7,
   "end": 420.18,
   "text": "و در حقیقت فرزندان با مادرشون مقام مادر نفس کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.18,
   "end": 422.2,
   "text": "حضرت صدیقه طاهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.2,
   "end": 424.34,
   "text": "روح اعظم اینا همون مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 424.34,
   "end": 430.52,
   "text": "همون نفس عرض شود نفس کل یا پرورشند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.52,
   "end": 435.0,
   "text": "که از این حیث اختلافشون با دیگر الملائکه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.0,
   "end": 437.68,
   "text": "تنزل الملائکه و بر روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.68,
   "end": 441.32,
   "text": "مشخص میشه به یک وجه که چرا روح از ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.32,
   "end": 443.98,
   "text": "متمایز شدن. ملائکه عقلن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.98,
   "end": 447.48,
   "text": "عقلن، کلی‌ان، ربطی به مقام پرورش ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.48,
   "end": 450.16,
   "text": "اگرچه در مسیر پرورش عقل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.16,
   "end": 457.38,
   "text": "که غذای عقلی برمی‌دارد و میپر و پرورانده می‌شود موجود اما به وسیله عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.38,
   "end": 462.56,
   "text": "و اون مقامی که پرورش و ربوبیت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 462.56,
   "end": 466.26,
   "text": "و تربیت رو به عهده داره به یک معنا ربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.26,
   "end": 469.32,
   "text": "اون میشه همون نفس کل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.32,
   "end": 477.22,
   "text": "نفس کل که قبلاً در م-مبحث لقاء الله عرض کردیم که جنس القاءات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 477.22,
   "end": 482.52,
   "text": "الهامات الهیه برای اولیاء خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 482.52,
   "end": 486.44,
   "text": "نه برای انبیا، برای اولیاء خدا از جنس نفس کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 486.44,
   "end": 489.98,
   "text": "و این منقطع نشده. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 489.98,
   "end": 493.56,
   "text": "وحی از جنس عقل کل، کلیات رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.56,
   "end": 499.46,
   "text": "حالا پس این رو هم توجه داشته باشید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 499.46,
   "end": 502.96,
   "text": "در معنای فطر معنای ربوبیت خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 502.96,
   "end": 506.52,
   "text": "این رو میخواستیم امروز بگیم که جا مونده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 506.52,
   "end": 508.92,
   "text": "در ادامه مبحث ظهرمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 508.92,
   "end": 514.8,
   "text": "جلسه قبلمون. اتفاقاً داشتم دقت می‌کردم خیلی برام شیرین بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.8,
   "end": 518.2,
   "text": "در آ-- این دعای ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.2,
   "end": 524.02,
   "text": "مبارک رمضان آخرین دو روز که امروز باشد روز سیام ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.02,
   "end": 526.92,
   "text": "چه شیرین که در دعای آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 526.92,
   "end": 529.46,
   "text": "روز سی‌ام از خدا طلب کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 529.46,
   "end": 536.98,
   "text": "اللهم اجعل صیامی فیه بالشکر والقبول على ما ترضاه و یرضاه الرسول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 536.98,
   "end": 541.02,
   "text": "محکمة فروعہ بالاصول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 541.02,
   "end": 545.28,
   "text": "عجب! یعنی به واسطه اصول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 545.28,
   "end": 547.34,
   "text": "اون فروع محکم میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 547.34,
   "end": 550.16,
   "text": "اساسشون رو یعنی میگی خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 550.16,
   "end": 552.34,
   "text": "اساس اصول رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.34,
   "end": 557.18,
   "text": "به استحکام اساس-- ببخشید اساس فروع رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 557.18,
   "end": 561.08,
   "text": "محکمة فروعہ بالاصول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 561.08,
   "end": 563.9,
   "text": "محکم کن اساس فروع رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.9,
   "end": 566.88,
   "text": "به اصول. این اصل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 566.88,
   "end": 569.7,
   "text": "مادره. اصل. ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 569.7,
   "end": 575.06,
   "text": "ام مادره. اصل ریشه در عربی ریشه مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 575.06,
   "end": 578.2,
   "text": "یک معنا اصل هم همون مادر معنا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 578.2,
   "end": 585.3,
   "text": "ریشه. فرع-- می‌فرماید اصلہ ثابت و فرعہ فی السماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 585.3,
   "end": 588.92,
   "text": "این اصل مادر ریشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 588.92,
   "end": 596.62,
   "text": "این باز داره ببینید کجا اینو داره تسریح میکنه در دعای روز سی‌ام آخرین روز ماه مبارک رمضان که داریم فارغ میشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 596.62,
   "end": 602.98,
   "text": "میگه این فروع ما. حالا شما این فروع رو اینجا به یک وجه ماه‌های بعد در نظر بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 602.98,
   "end": 605.2,
   "text": "ماه‌های بعد شدن فروع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 605.2,
   "end": 607.34,
   "text": "و اون اصل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 607.34,
   "end": 611.08,
   "text": "ماه مبارک رمضان. سی روزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 611.08,
   "end": 617.16,
   "text": "به علاوه شب قدرش و نزول قرآن و این‌ها و نزول روح و ملائکه میشن اصول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 617.16,
   "end": 622.08,
   "text": "این فروع یعنی ماه‌های دیگه از دل اصول بیرون میان و محکم میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 622.08,
   "end": 624.22,
   "text": "استح-استحکامشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 624.22,
   "end": 629.26,
   "text": "بر اساس اصوله، بر اساس اصل و ریشه و امه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 629.26,
   "end": 631.98,
   "text": "پس باز می‌رسیم به معنای فطر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 631.98,
   "end": 636.04,
   "text": "ماه شوال از دل ماه رمضان شکوفا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 636.04,
   "end": 641.08,
   "text": "به یک معنا تمام ماه‌های بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 641.08,
   "end": 643.14,
   "text": "همینطور از چون بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 643.14,
   "end": 646.74,
   "text": "شوال میشه ذی القعده دیگه بعد ذی القعده، ذی الحجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 646.74,
   "end": 650.36,
   "text": "همینطور این مثلا ذی القعده از دل شوال شکوفا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 650.36,
   "end": 652.48,
   "text": "شوال از کجا شو-شکوفا شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 652.48,
   "end": 654.62,
   "text": "شکفته شد؟ از دل رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 654.62,
   "end": 656.44,
   "text": "پس رمضان میشه مادر همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 656.44,
   "end": 659.42,
   "text": "شاید به یک معنا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 659.42,
   "end": 662.26,
   "text": "اهل سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 662.26,
   "end": 669.32,
   "text": "فرمودن که ماه مبارک رمضان رو ابتدای سال معنوی و بندگی قرار بده همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 669.32,
   "end": 671.62,
   "text": "چون بقیه فروع این اصلن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 671.62,
   "end": 675.92,
   "text": "و اونا از دل این جوشیده میشن، شکفته میشن، شکوفا میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 675.92,
   "end": 680.08,
   "text": "پس هر کسی که ماه مبارک رمضان خوبی داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 680.08,
   "end": 683.14,
   "text": "چون اصلش خوبه فروعش هم خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 683.14,
   "end": 686.16,
   "text": "دقت بفرمایید نتیجه قشنگ امروز رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 686.16,
   "end": 688.5,
   "text": "فرعش هم خوبه. خروجی‌ش هم خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 688.5,
   "end": 692.42,
   "text": "یعنی به یک معنا وقتی واردات یک کارخانه‌ای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 692.42,
   "end": 695.76,
   "text": "اون ملات اصلیش خوب بود، اصیل بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 695.76,
   "end": 702.7,
   "text": "بلحاصله بود اینا بعد خروجی‌ش که فروع هستن اونام یا صادرات اون کارخانه هم عالی میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 702.7,
   "end": 706.82,
   "text": "میگن اگر صادرات یک کارخانه خوبه ببینید وارداتش خوب بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 706.82,
   "end": 711.68,
   "text": "اینم به یک معنا که خواستیم بگیم جا مونده بود از بحث ماه مبارک، از بحث فطر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 711.68,
   "end": 715.8,
   "text": "حالا در موضوع فطر و عید فطر و اینا حرف زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 715.8,
   "end": 723.22,
   "text": "شما برید همونطور که قبلاً هم اشاره‌ای عرض کردم در خصوص یکی از درون مایه های ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 723.22,
   "end": 726.44,
   "text": "و ارتباطش با لفظ جلالی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 726.44,
   "end": 729.22,
   "text": "خب دیگه اون مباحث قبلی رو جمع کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 729.22,
   "end": 732.8,
   "text": "تو بحث امشب ما که شب عید فطره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 732.8,
   "end": 736.18,
   "text": "چرا در دعای عید فطر، چرا به واقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 736.18,
   "end": 738.26,
   "text": "در دعای عید فطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 738.26,
   "end": 740.8,
   "text": "همش نام الله تکرار میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 740.8,
   "end": 743.66,
   "text": "برید ببینید حتما این دعا رو بخونیم ان‌شاءالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 743.66,
   "end": 746.3,
   "text": "یا الله، یا الله، یا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 746.3,
   "end": 749.14,
   "text": "سه بار. بعد یا رحمان دوباره یا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 749.14,
   "end": 752.94,
   "text": "یا رحیم، یا الله، یا ملک، یا الله، یا قدوس، یا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 752.94,
   "end": 760.62,
   "text": "همینطور میره. و چه شیرین که اون انتها هی میگه یا رباه، یا الله، یا رباه، یا الله، یا رباه، یا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 760.62,
   "end": 764.62,
   "text": "یه فرقی هست بین رب و رباه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 764.62,
   "end": 768.46,
   "text": "رباه انگار رفتی تو آغوش پروردگاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 768.46,
   "end": 770.66,
   "text": "یعنی خدا جونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 770.66,
   "end": 773.16,
   "text": "یه همچین معنایی داره رباه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 773.16,
   "end": 776.82,
   "text": "حالا چه شیرین که باز اینجا رباه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 776.82,
   "end": 780.42,
   "text": "معنای پرورش دارد، پروراندن دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 780.42,
   "end": 782.78,
   "text": "که ماه رمضان همه کارش همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 782.78,
   "end": 786.18,
   "text": "ما مقام مادره، امه، اصل، ریشه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 786.18,
   "end": 789.76,
   "text": "و بقیه ماه‌های دیگه فروع این ماه هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 789.76,
   "end": 794.48,
   "text": "ببینید حالا یه نکته رو که درست بذاری رو میز و درباره‌ش بحث کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 794.48,
   "end": 796.98,
   "text": "مذاکره علمی کنی، ببینید چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 796.98,
   "end": 801.42,
   "text": "فرع و شاخ و برگ ازش میزنه بیرون که همه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 801.42,
   "end": 806.48,
   "text": "کل حینه به اذن ربها همش به اذن پروردگار است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 806.48,
   "end": 808.84,
   "text": "ان‌شاءالله که نوش جانتون باشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 808.84,
   "end": 811.98,
   "text": "در این شب عزیز ما رو هم دعا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 811.98,
   "end": 816.74,
   "text": "و البته خیلی حرف‌هامون ان‌شاءالله فرصت‌های بعد، سال‌های بعد خدا لطف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 816.74,
   "end": 820.36,
   "text": "نشد ان‌شاءالله در عالم برزخ عالم‌های دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 820.36,
   "end": 824.72,
   "text": "ان‌شاءالله با هم باشیم و اونجا مباحث رو به امید خدا پیگیر باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 824.72,
   "end": 828.58,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر بشه. به برکت صلوات بر محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}