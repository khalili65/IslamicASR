 },
 "chapters": [
  {
   "index": 0,
   "title": "## صوموا تصحوا؛ روزه و سلامت",
   "start": 12.04,
   "end": 183.76
  },
  {
   "index": 1,
   "title": "## صوم قطع نه صوم وصل؛ توسط",
   "start": 183.76,
   "end": 259.34
  },
  {
   "index": 2,
   "title": "## ثمرهٔ اعتدال مزاج",
   "start": 259.34,
   "end": 592.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.5,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.5,
   "end": 7.08,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.08,
   "end": 12.04,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.04,
   "end": 15.48,
   "text": "از رهبر عزیزمون استفتاء شده که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.48,
   "end": 17.96,
   "text": "ما حواسمون نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.96,
   "end": 22.02,
   "text": "و اونچه که لای دندون‌مون هست از غذای مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.02,
   "end": 28.6,
   "text": "سحری چیزی خوردیم در طی روز این غذایی که لای دندون‌مون بوده حواسمون نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.6,
   "end": 35.36,
   "text": "و بلعیدیم این غذا رو حالا تکه‌های غذایی که لای دندون می‌مونه مسواک نزدیم و این رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.36,
   "end": 38.3,
   "text": "وارد معده‌مون شد. آیا روزه‌مون باطله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.3,
   "end": 41.38,
   "text": "باید دوباره غذا بگیریم یا نه غذای روزه رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.38,
   "end": 49.18,
   "text": "رهبری فرمودن که اگر شما ملتفت نبودید یعنی علم نداشتید که لای دندوناتون غذا مونده یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.18,
   "end": 52.18,
   "text": "یا اینکه این غذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.18,
   "end": 57.92,
   "text": "وارد به مثلاً منطقه بلع و حلقش، حلق شما شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.92,
   "end": 67.16,
   "text": "این یک. دو اینکه وقتی که اینو قورت دادید باز ملتفت نبودید حواستون نبوده عمداً قورت ندادید این غذا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.16,
   "end": 70.36,
   "text": "سهواً یه دفعه متوجه شدید که رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.36,
   "end": 73.54,
   "text": "وارد منطقه بلع و حالا حلق شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.54,
   "end": 76.3,
   "text": "اگر اینچنین است نخیر غذا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.3,
   "end": 78.96,
   "text": "اما اگر شما می‌دونستید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.96,
   "end": 84.64,
   "text": "که این غذا هست و لحظه‌ای که قورت دادید عمداً قورت دادید بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.64,
   "end": 89.14,
   "text": "چنین چیزی غذا داره. در مزه مزه کردن هم اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.14,
   "end": 93.74,
   "text": "حتی سؤال شده از آقا که برای رفع عطش میشه مزه مزه کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.74,
   "end": 97.2,
   "text": "اشکال نداره فقط حواسمون باید باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.2,
   "end": 100.12,
   "text": "اون آبی که داخل فضای دهان شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.12,
   "end": 102.86,
   "text": "نباید پایین بره. اینو حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.86,
   "end": 105.0,
   "text": "در ای، در صورتی می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.0,
   "end": 109.52,
   "text": "مزه مزه کنیم که مطمئن باشیم این آب پایین نمیره، می‌ریزیمش بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.52,
   "end": 116.52,
   "text": "اگر مطمئن بشیم که می‌دونیم اگر من مزه مزه کنم این آب میره تو حلقم حق این کار رو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.52,
   "end": 118.72,
   "text": "در خصوص اسرار روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.72,
   "end": 127.7,
   "text": "یکی دیگه از سر هایی که بزرگان در خصوص روزه گفتن و البته این توضیح مبسوطی می‌طلبه تبرّکاً من عرض می‌کنم میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.7,
   "end": 131.46,
   "text": "اون هم یه حدیث دو کلمه‌ای داریم خیلی این حدیث زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.46,
   "end": 134.7,
   "text": "می‌فرمود صوموا تصحّوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.7,
   "end": 138.98,
   "text": "روزه بگیرید تا سالم بمونید، سلامت باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.98,
   "end": 144.46,
   "text": "عجیبه عجين بودن روزه و جو و گرسنگی با سلامت بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.46,
   "end": 147.46,
   "text": "اطباء هم ثابت کردن که وقتی روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.46,
   "end": 151.68,
   "text": "به سی روز می‌رسه، حالا روزهای اول آدم رو ضعف و غش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.68,
   "end": 157.38,
   "text": "ولی دقت کنید هرچی میرید جلوتر بدن معتدل‌تر میشه، آمادگیش بیشتر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.38,
   "end": 160.66,
   "text": "مخصوصاً وقتی یه ماه روزه می‌گیری کلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.66,
   "end": 166.0,
   "text": "سموم از بدن دفع می‌شه. حالا این یه روندی داره که تو فیزیولوژی و این‌ها توضیح دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.0,
   "end": 169.56,
   "text": "اگر تو کانالم ما گذاشتیم یه روز اگر دیده باشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.56,
   "end": 172.5,
   "text": "که اطباء این... حالا ما کاری به صحبت اطباء نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.5,
   "end": 180.02,
   "text": "اصلاً اسلام داره میگه پیغمبر داره می‌فرماید که حکمت‌های این رو جز خودشون هم هیچکس نف، نخواهد فهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.02,
   "end": 182.26,
   "text": "میگه اگر می‌خوای سالم بمونی روزه بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.26,
   "end": 184.98,
   "text": "لکن حواسمون باشه که این صوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.98,
   "end": 187.1,
   "text": "و این جو و گرسنگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.1,
   "end": 191.12,
   "text": "باید صوم القطع باشه نه صوم الوصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.12,
   "end": 194.8,
   "text": "یعنی افراط و تفریط درش نباشه، توسط درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.8,
   "end": 200.24,
   "text": "خرج بشه. یعنی مثلاً صوم الوصل یعنی شما امروز رو روزه بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.24,
   "end": 206.36,
   "text": "افطار که شد دیگه خشک مقدسی آدم قول کنه بگه من می‌خوام به عشق خدا هیچی نخورم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.36,
   "end": 209.22,
   "text": "نخوری تا فردا، دوباره فردا روزه بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.22,
   "end": 211.06,
   "text": "به این میگن صوم الوصل. حرامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.06,
   "end": 214.62,
   "text": "اصلاً این روزه باطله. روزه فرداט باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.62,
   "end": 216.84,
   "text": "اگه تو این کارو بکنی عمداً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.84,
   "end": 218.52,
   "text": "یه وقتی کسی خواب بمونه که نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.52,
   "end": 223.96,
   "text": "عمداً کسی نخوره بگه حالا فازش زده بالا و نخوره بعد، بدبخت می‌میری که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.96,
   "end": 232.18,
   "text": "این چه روزه گرفته. صوم القطع یعنی قطع کنی همون خدایی که شارع مقدس که گفته نخور حالا میگه بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.18,
   "end": 234.06,
   "text": "منتها به حد توسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.06,
   "end": 240.56,
   "text": "مرحوم حاجی سبزواری در اسرار روزه میگه خیلی تأکید می‌کنه، خیلی تأکید می‌کنه مرحوم حاجی سبزواری این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.56,
   "end": 244.24,
   "text": "حکیم و عارف می‌فرماید که به توسط نه افراط نه تفریط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.24,
   "end": 246.84,
   "text": "نه انقدر بخوری که بیفتی دیگه نتونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.84,
   "end": 248.9,
   "text": "پاشی نماز بخونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.9,
   "end": 251.5,
   "text": "نه انقدر نخوری که دیگه جونت نیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.5,
   "end": 254.5,
   "text": "هیچکدوم. به توسط اگر کسی این کارو کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.5,
   "end": 256.82,
   "text": "فرمودن که اعتدال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.82,
   "end": 260.02,
   "text": "امزجه یعنی معتدل میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.02,
   "end": 263.14,
   "text": "مزاجش معتدل میشه، براش ایجاد میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.14,
   "end": 268.78,
   "text": "و داریم که اگر کسی مزاجش معتدل شد نمی‌میره هیچوقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.78,
   "end": 271.0,
   "text": "چرا اهل بیت هیچوقت نمی‌مردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.0,
   "end": 276.78,
   "text": "مگر اینکه کشته بشن. چرا انبیای پیشین عمرهای هزار ساله داشتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.78,
   "end": 282.46,
   "text": "این‌ها علم این رو داشتن که کی بخورن، کی بخوابن، چی بخورن، کی نخو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.46,
   "end": 287.24,
   "text": "کی نخورن، کی بخورن، چی بخورن، چی نخورن، کی بخوابن، کی نخوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.24,
   "end": 289.28,
   "text": "همه این علوم رو داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.28,
   "end": 290.9,
   "text": "بعد بدن معتدل می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.9,
   "end": 294.16,
   "text": "بدن که معتدل شد، مزاج معتدل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.16,
   "end": 298.46,
   "text": "دیده دیگه یک خطات وقتی مزاجش معتدله غوغا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.46,
   "end": 301.14,
   "text": "یک خطی می‌نویسه میگه خودش تعجب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.14,
   "end": 306.14,
   "text": "یه مداح وقتی مزاجش معتدله می‌ترکونه به قول ما مداح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.14,
   "end": 311.68,
   "text": "یه سخنران بالا منبر میگه امروز اصلاً همه میگن حاجی امشب یه جور دیگه صحبت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.68,
   "end": 313.88,
   "text": "مزاجش معتدله. یه مدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.88,
   "end": 321.2,
   "text": "یه وقت کیفش کوکه یه تصمیماتی برای بچه‌ها و کارکن‌هاش می‌گیره همه رو حال میده، کیف می‌کنن همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.2,
   "end": 324.38,
   "text": "این اصلاً خودشم می‌مونه این تصمیمات از کجا اومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.38,
   "end": 326.76,
   "text": "من بلد نبودم از این تصمیمات بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.76,
   "end": 329.12,
   "text": "مزاج معتدله. قربونت برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.12,
   "end": 332.18,
   "text": "وقتی مزاج معتدل بود آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.18,
   "end": 334.84,
   "text": "کارهایی می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.84,
   "end": 340.78,
   "text": "خارق‌العاده. در حقیقت البته این باید حواسمون جمع باشه بازم تأکید می‌کنم به توسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.78,
   "end": 349.3,
   "text": "شما ببینید چرا بعد از ماه مبارک رمضان بعد از عید فطر که حرامه روزه گرفتن شش روز روزه گرفتن مستحبه دوباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.3,
   "end": 354.28,
   "text": "دوباره بری به رقم ماه رمضان بعد از عید فطر شش روز روزه گرفتن مستحبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.28,
   "end": 356.7,
   "text": "هی می‌خواد تو شارع مقدس عادت بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.7,
   "end": 360.52,
   "text": "آقا این سی روز بدنت معتدل شد، ولش نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.52,
   "end": 362.5,
   "text": "نگاه نکنی یه ذره ضعف و غشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.5,
   "end": 364.52,
   "text": "بدنت داره معتدل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.52,
   "end": 366.9,
   "text": "از مریضی‌ها حفظ میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.9,
   "end": 372.2,
   "text": "بعدا دیگه هی مریضی‌هایی که بیست میلیون صد میلیون طرف باید خرج کنه تو نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.2,
   "end": 377.06,
   "text": "اینا رو ببین. لذا میگه ادامه بده این روندو ول نکن البته به توسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.06,
   "end": 379.34,
   "text": "حالا مثلا شش روز بعد گرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.34,
   "end": 383.64,
   "text": "بعد میره تا کی؟ شوال که تموم میشه اول ذی القعده میاد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.64,
   "end": 387.84,
   "text": "از اول ذی القعده دوباره چله کلیمیه شروع می‌شه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.84,
   "end": 392.98,
   "text": "دهم ذی الحجه یعنی عید قربان که عید قربان هم حرامه گرفتنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 392.98,
   "end": 399.39,
   "text": "باز حدود سی و نه چهل روز شما می‌تونی اینجا چله بگیری و بهترین کار اونجا فرمودن باز روزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.39,
   "end": 401.64,
   "text": "چرا؟ دوباره بعدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.64,
   "end": 404.28,
   "text": "ذی الق-- ذی الحجه تموم می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 404.28,
   "end": 407.4,
   "text": "محرم میاد. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.4,
   "end": 409.28,
   "text": "عاشقا میگن چله حسینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.28,
   "end": 412.1,
   "text": "تو شرع نداریم چله حسینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.1,
   "end": 417.42,
   "text": "لکن جابر از شهادت امام حسین شروع کرد تا اربعین چهل روز روزه گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.42,
   "end": 420.12,
   "text": "اربعین رفت بالا سر حضرت اونجا افطار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.12,
   "end": 423.3,
   "text": "غش کرد رو قبر مقدس آقا اباعبدالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.3,
   "end": 426.64,
   "text": "دوباره یه چهله. ببینید این چهل چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 426.64,
   "end": 429.3,
   "text": "هی می‌خواد بدنتو رو عادت بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.3,
   "end": 433.58,
   "text": "که خیلی هم جالبه. به قول آقای بهجت رحمت الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 433.58,
   "end": 437.76,
   "text": "روزه نخوردن نیست، تنظیم ساعات خوردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.76,
   "end": 439.5,
   "text": "شما کی بخوری، کی نخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 439.5,
   "end": 442.76,
   "text": "روزه نخوردن نیست که. مثل اینکه نماز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.76,
   "end": 450.3,
   "text": "نماز تنظیم خواب، نماز شب، نماز شب می‌خوای پاشی بخونی نخوابیدن نیست، تنظیم ساعات خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.3,
   "end": 452.6,
   "text": "یه وقت دیگه بخواب. این دو ساعتو نخواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.6,
   "end": 455.28,
   "text": "این یک ساعتو نخواب. خیلی زیبا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 455.28,
   "end": 457.36,
   "text": "اصلا بدن که معتدل شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.36,
   "end": 460.76,
   "text": "اون موقع می‌تونه بارهای سنگین رو برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 460.76,
   "end": 463.54,
   "text": "حرف‌های عمیق حکمی رو بفهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 463.54,
   "end": 466.88,
   "text": "گاهی اوقات هرچی معلم زور-- من اصلا خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 466.88,
   "end": 468.56,
   "text": "هرچی زور می‌زنم نمی‌فهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 468.56,
   "end": 470.24,
   "text": "میگم آقا ولمون کن من نمی‌فهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 470.24,
   "end": 472.72,
   "text": "چرا؟ بدن معتدل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 472.72,
   "end": 478.38,
   "text": "مزاج معتدل نیست. برعکس یه دفعه یه نکته‌ای کشفی تو ذهنت ایجاد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 478.38,
   "end": 480.04,
   "text": "ماشاالله قیافه هاتون داد می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.04,
   "end": 483.08,
   "text": "همه اهل کشف و کرامت و نصفه‌شبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 483.08,
   "end": 485.92,
   "text": "ماشاالله به ما هم از این روزیا بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 485.92,
   "end": 489.78,
   "text": "و بیوف-- دل شب یه کشفی برات رخ داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.78,
   "end": 492.04,
   "text": "یه چیزی. چرا؟ بدنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 492.04,
   "end": 494.22,
   "text": "چی باعث شده این امتزاج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 494.22,
   "end": 497.44,
   "text": "این اعتدال امزجه ایجاد بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 497.44,
   "end": 499.82,
   "text": "چی؟ روزه. جو گرسنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 499.82,
   "end": 504.14,
   "text": "که حالا این فهم عقید مطالبی داره، دقایقی داره، ذرائفی داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 504.14,
   "end": 507.96,
   "text": "انشاالله فردا میگیم. یه سلام به اباعبدالله الحسین عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 507.96,
   "end": 511.36,
   "text": "به هر حال دل رقیقا میگن ما آماده‌ی گرییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 511.36,
   "end": 514.98,
   "text": "السلام علیک یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 514.98,
   "end": 521.0,
   "text": "ابا عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 521.0,
   "end": 525.56,
   "text": "و علی الارواح التي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 525.56,
   "end": 531.0,
   "text": "حلّت بفنائک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 531.0,
   "end": 533.9,
   "text": "علیک مني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 533.9,
   "end": 538.78,
   "text": "سلام الله ابدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 538.78,
   "end": 547.42,
   "text": "ما بديت وبقي الليل والنهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 547.42,
   "end": 549.44,
   "text": "ولا جعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.44,
   "end": 554.08,
   "text": "الله اخر العهد مني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 554.08,
   "end": 558.1,
   "text": "لزيارتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 558.1,
   "end": 566.92,
   "text": "ان شاء الله کربلا بگیم. السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 566.92,
   "end": 574.24,
   "text": "على الحسين وعلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 574.24,
   "end": 578.42,
   "text": "علي ابن حسين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 578.42,
   "end": 582.2,
   "text": "وعلى اولاد حسين وعلى اصحاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 582.2,
   "end": 587.0,
   "text": "حسين. ان شاء الله عقبت بخیر بشیم به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 587.0,
   "end": 592.96,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}