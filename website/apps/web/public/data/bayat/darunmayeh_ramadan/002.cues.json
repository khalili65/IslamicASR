 },
 "chapters": [
  {
   "index": 0,
   "title": "## قیاسِ رمضان با پیامبر؛ سنگینیِ حرمت",
   "start": 0.26,
   "end": 179.96
  },
  {
   "index": 1,
   "title": "## رمضان؛ مخزنِ القائات و غفلتِ ما",
   "start": 179.96,
   "end": 498.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 2.88,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.88,
   "end": 6.2,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.2,
   "end": 10.92,
   "text": "و ربانی آیاته السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.92,
   "end": 19.96,
   "text": "دیروز عرض کردیم که پیغمبر عزیز عالم برای اینکه عظمت این ماه رو بفهمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.96,
   "end": 27.22,
   "text": "یا به عبارتی اگر دقت بشه شاید حتی بشه گفت عظمت خودش رو بخواد بفهمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.22,
   "end": 32.84,
   "text": "قیاس میگیره فاصله بین خودش و امت رو با فاصله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.84,
   "end": 36.82,
   "text": "ماه مبارک رمضان با دیگر اشهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.82,
   "end": 40.98,
   "text": "و شهرها و ماه‌های دیگه. خب اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.98,
   "end": 46.24,
   "text": "یه دقت نظری رو می‌طلبه در این سری که پیغمبر فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.24,
   "end": 50.02,
   "text": "که اگر فاصله یا فضیلت و برتری بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.02,
   "end": 56.2,
   "text": "ماه مبارک رمضان با ماه‌های دیگه مثل فضیلت و برتری پیغمبر است با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.2,
   "end": 60.12,
   "text": "خلائق دیگه، خب اگر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.12,
   "end": 63.46,
   "text": "به پیغمبر محبت کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.46,
   "end": 66.04,
   "text": "پیغمبر رو تکریم کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.04,
   "end": 69.36,
   "text": "ثوابش بیشتره، اجرش بالاتره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.36,
   "end": 73.24,
   "text": "پیش خدا مقرب‌تری یا یه آدم معمولی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.24,
   "end": 81.78,
   "text": "قطعاً میگی پیغمبر. پس تکریم کردن این ماه مثل اینه که پیغمبر رو تکریم کرده باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.78,
   "end": 86.92,
   "text": "یا بالعکس اگر کسی به پیغمبر جسارت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.92,
   "end": 90.4,
   "text": "حرمت پیغمبر رو بشکونه چقدر سنگینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.4,
   "end": 94.92,
   "text": "قبیحه این کار تا بخواد یه آدم معمولی رو جسارت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.92,
   "end": 102.78,
   "text": "همون مقدار کسی که ماه مبارک رمضان رو حرمت شکنی کنه، همون مقدار جرمش سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.78,
   "end": 108.66,
   "text": "این رو که حالا از دیروز جا مونده بود خواستم عرض کنم این نگاه رو به ما میده این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.66,
   "end": 112.76,
   "text": "حالا وقتی پیغمبر قیاس میگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.76,
   "end": 116.28,
   "text": "از تو دلش اسراری می‌ریزه بیرون از تو دل همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.28,
   "end": 124.0,
   "text": "قیاس پیغمبر. وجود مقدس پیغمبر مملو است از الهامات، القاءات الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 124.0,
   "end": 129.58,
   "text": "صریح آیه قرآن هم می‌فرماید \"إنك لتلقى القرآن عن لدن حكيم عليم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 129.58,
   "end": 134.42,
   "text": "این قرآنی که علم اول و آخر الهی درش جمع شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 134.42,
   "end": 138.2,
   "text": "تلقی شده قلب مقدس پیغمبر از حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 138.2,
   "end": 143.42,
   "text": "یعنی القاءات خ-پ-خدای منان است به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 143.42,
   "end": 145.96,
   "text": "به عبارتی به فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 145.96,
   "end": 151.52,
   "text": "ابن عربی، اون عارف بزرگ، کشف تام محمدی است صلی الله علیه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 151.52,
   "end": 153.74,
   "text": "قرآن .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 153.74,
   "end": 157.98,
   "text": "کشف تام. کشف، کشف پیغمبر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 157.98,
   "end": 166.02,
   "text": "تمثلاتی‌ست که یعنی همونطور که پیغمبر وجودش مملو از الهامات است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 166.02,
   "end": 170.58,
   "text": "این ماه رو هم نکته‌ای که امروز می‌خوایم بگیم این سری که امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 170.58,
   "end": 176.2,
   "text": "فاش بشه برای من و شما. این ماه هم تو دلش مملو از القاءات و اله--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 176.2,
   "end": 179.02,
   "text": "عذر request الهامات الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 179.02,
   "end": 184.2,
   "text": "تمثلات بسیار أعم از صور ظاهریه و باطنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 184.2,
   "end": 187.68,
   "text": "منتها تا یار که را خواهد و میلش به که باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 187.68,
   "end": 190.6,
   "text": "ظرفیت این ماه این چنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 190.6,
   "end": 193.28,
   "text": "می‌خوام امروز تو این نکته این رو عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 193.28,
   "end": 198.6,
   "text": "خیلی غافلیم ما از الهاماتی که بهمون می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 198.6,
   "end": 204.44,
   "text": "بسیاری از این صحف نوریه عرفانیه که بزرگان نوشتن و قلم زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 204.44,
   "end": 208.78,
   "text": "مثل خ-- غریبه هزار عنوان کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.78,
   "end": 212.88,
   "text": "ابن عربی شوخی نیست. خود حضرت علامه حسن زاده می‌فرمودن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 212.88,
   "end": 218.92,
   "text": "فهرست‌بندی اون تألیفات ابن عربی قریب به هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 218.92,
   "end": 220.98,
   "text": "کتاب نوشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.98,
   "end": 227.66,
   "text": "شوخی نیست. یک عنوانش فقط نود و پنج جلد کتاب تفسیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 227.66,
   "end": 230.76,
   "text": "تفسیر همین قرآن. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 230.76,
   "end": 233.48,
   "text": "یه دونه‌ش می‌شه مثلا فتوحاتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 233.48,
   "end": 235.66,
   "text": "یه دونه‌ش می‌شه این فسوس، فسوسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 235.66,
   "end": 239.16,
   "text": "خود ابن عربی می‌فرماید هرچی هست از سجاده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 239.16,
   "end": 242.24,
   "text": "همه این‌ها رو من از سجاده اخذ کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 242.24,
   "end": 246.16,
   "text": "ببینید این القاءات، این الهامات الهی پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 246.16,
   "end": 249.06,
   "text": "منتها میگه یکی رو می‌خواد که اینا رو برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 249.06,
   "end": 251.62,
   "text": "ما غافلیم از این الهام‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 251.62,
   "end": 255.22,
   "text": "خود علامه حسن زاده بسیاری از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 255.22,
   "end": 261.02,
   "text": "قلم فرسایی‌هایی که کرده و این عظمتی که آفریده در آثارش خودش می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 261.02,
   "end": 265.84,
   "text": "الهامات ربوبی، نمی‌دونم القاءات ربوبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 265.84,
   "end": 269.86,
   "text": "القاءات قلب مقدس پیغمبر به من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 269.86,
   "end": 273.28,
   "text": "به من و شما هم می‌شه. خود علامه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 273.28,
   "end": 280.54,
   "text": "مق-- وقتی شرح فسوس قیصری رو حالا شرح قیصری بر فسوس رو داره شرح میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 280.54,
   "end": 283.34,
   "text": "می‌رسه به اون مداخل دوازده گانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 283.34,
   "end": 285.4,
   "text": "شروع به فسوس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 285.4,
   "end": 288.76,
   "text": "در مدخل دهم غوغا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 288.76,
   "end": 291.52,
   "text": "صوتش هست. گوش بدید. علامه اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.52,
   "end": 295.18,
   "text": "می‌فرما-- اولا که می‌فرمود خود علامه قیصری در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.18,
   "end": 298.38,
   "text": "فصل یا مدخل دهم غوغا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.38,
   "end": 301.86,
   "text": "حرف‌های بسیار عرشی و بزرگی رو اینجا مطرح کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.86,
   "end": 304.44,
   "text": "بعد اونجا علامه میاد یه نکته‌ای رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.44,
   "end": 306.74,
   "text": "خیلی با زیرکی. اینو من امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 306.74,
   "end": 310.3,
   "text": "همین رو بتونم به خودم و شما تفهیم کنم هنر کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.3,
   "end": 314.3,
   "text": "علامه اونجا می‌فرمود که دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.3,
   "end": 316.84,
   "text": "وقتی یک حقیقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.84,
   "end": 320.94,
   "text": "متمثل می‌شه در ثغور ذا-ذات نفس من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.94,
   "end": 324.38,
   "text": "یعنی باطن و مکنون نفس من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 324.38,
   "end": 328.66,
   "text": "تمثلی پیدا می‌شه از حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 328.66,
   "end": 332.06,
   "text": "اون همون ملکی‌ست که به من و شما نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 332.06,
   "end": 338.24,
   "text": "بعد حضرت علامه می‌فرمایند اون ملک تن از-- تن-تنزیل ملائک یعنی برای من و شما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.24,
   "end": 340.06,
   "text": "فقط نیست که برای پیغمبر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 340.06,
   "end": 342.66,
   "text": "بله به نحو وحی تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.66,
   "end": 345.26,
   "text": "دیگه خاتم الانبیا دیگه وحی تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 345.26,
   "end": 350.1,
   "text": "اما الهام ادامه داره. الهام از جنس وحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 350.1,
   "end": 354.62,
   "text": "اما زیر هرچه هست در الهام زیر سر، زیر سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 354.62,
   "end": 359.74,
   "text": "نفس کله. وحی از زیر سر عقل کله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 359.74,
   "end": 361.72,
   "text": "الهام ادامه داره. برای همه هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.72,
   "end": 364.82,
   "text": "بهش میگن نبوت انبهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 364.82,
   "end": 369.84,
   "text": "باخبر شدن از حقایق عالم که با-بارها درباره‌ش صحبت کردیم یا نبوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 369.84,
   "end": 373.26,
   "text": "بهش میگن عام یا تعریفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.26,
   "end": 376.88,
   "text": "در همه من و شما هست. بسیاری از اون کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 376.88,
   "end": 381.32,
   "text": "حقایق رو چشیدن، رسیدن و بعضاً تو کتاب‌هاشون ریختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 381.32,
   "end": 385.1,
   "text": "در س-- به قول علامه در صغع عین تعبیر خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.1,
   "end": 389.86,
   "text": "صغع ذات نفس ناطقه‌شون یعنی در باطن‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.86,
   "end": 395.86,
   "text": "ملک نازل شد، الهام کرد، القا کرد و اون‌ها هم گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 395.86,
   "end": 403.06,
   "text": "کی این اتفاق رخ می‌ده؟ به قول علامه وقتی کانال وجودی رو در اون صد کلمه در معرفت نفس عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 403.06,
   "end": 411.2,
   "text": "کانال وجودی رو لایروبی کنی، اون کانال وجودی، اون رب وجودیت سبحان ربی الأعلى ربی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 411.2,
   "end": 415.86,
   "text": "رب، این رب وجودیت که ارتباط حسه وجودی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 415.86,
   "end": 418.66,
   "text": "با ذات حضرت حق است، اون رو لایروبی کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.66,
   "end": 421.6,
   "text": "یعنی چی کار کنی؟ از گناه و معصیت پاک کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 421.6,
   "end": 423.32,
   "text": "بشه لا یمسّه إلا المتهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 423.32,
   "end": 427.34,
   "text": "بعد الهامات میاد، القاءات میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.34,
   "end": 430.72,
   "text": "میاد برای خیلی‌ها آمده. برای من-- من قسم می‌خورم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.72,
   "end": 437.42,
   "text": "اونچه که بنده فهمیدم از درس و بحث‌های علامه این آخرین جمله من باشه، چرت نزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 437.42,
   "end": 444.76,
   "text": "آخرین جمله‌م این باشه. قسم می‌خورم اونچه که من فهمیدم به همه شمای که اینجا نشستید الهام شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 444.76,
   "end": 448.02,
   "text": "القا شده و می‌شود خصوصاً در این ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 448.02,
   "end": 452.08,
   "text": "منتها ما خبر نداریم، توجه بهش نداریم، غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 452.08,
   "end": 454.96,
   "text": "نمی‌دونیم این الهامات و القاءات چیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.96,
   "end": 458.36,
   "text": "و چگونه است که به نحو اول ابتداً به نحو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.36,
   "end": 464.26,
   "text": "انزال دفعی میاد. یه شب، یه حال خوش، یه توجه عا-- عجیب عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 464.26,
   "end": 467.8,
   "text": "تو حرم امام حسین، تو حرم امام رضا، تو هیئت، شب قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 467.8,
   "end": 470.14,
   "text": "اینجا یه حال عجیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.14,
   "end": 473.32,
   "text": "انفجار درونی. اون انزال دفعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 473.32,
   "end": 475.66,
   "text": "می‌ریزه تو وجودت القاءات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 475.66,
   "end": 478.92,
   "text": "بعد می‌بینی یهویی سی سال، چهل سال، پنجاه سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 478.92,
   "end": 483.9,
   "text": "تنزیل تدریجیش طول می‌کشه یا اصلاً برای بعضیا می‌کشه به عالم برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 483.9,
   "end": 488.92,
   "text": "از این الهامات در ماه مبارک رمضان تا دلت بخواد زیاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 488.92,
   "end": 493.82,
   "text": "غافل نباشیم. ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت و صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 493.82,
   "end": 495.66,
   "text": "اللهم صل على محمد وآل محمد. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 495.66,
   "end": 498.5,
   "text": "صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}