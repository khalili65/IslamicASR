 },
 "chapters": [
  {
   "index": 0,
   "title": "## نزول ملائکه در رمضان؛ الهام و علم",
   "start": 11.2,
   "end": 153.72
  },
  {
   "index": 1,
   "title": "آیهٔ شانزده سورهٔ جن اهمیت استقامت را چنین می‌گوید:",
   "start": 153.72,
   "end": 274.8
  },
  {
   "index": 2,
   "title": "## شهادت حضرت خدیجه؛ جایزهٔ استقامت",
   "start": 274.8,
   "end": 302.98
  },
  {
   "index": 3,
   "title": "## نعمت و رزق و برکت؛ الگوی خدیجه",
   "start": 302.98,
   "end": 465.58
  },
  {
   "index": 4,
   "title": "## شعب ابی‌طالب و آیهٔ تعجیل در وحی",
   "start": 465.58,
   "end": 575.4
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 4.96,
   "text": "و بهین استعین. السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.96,
   "end": 9.76,
   "text": "و ربانی آیاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.76,
   "end": 15.02,
   "text": "بحث ما این بود که در اون ماه، ماه مبارک رمضان به قدری‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.02,
   "end": 20.46,
   "text": "ملائکه شدت نزول دارند و در پس نزول ملائکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.46,
   "end": 25.3,
   "text": "انسان مه-مهلم می‌شه، ملهم می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.3,
   "end": 29.66,
   "text": "و به نحو حالا الهام از جنس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.66,
   "end": 33.5,
   "text": "وحی زیر سر وحی الهام هم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.5,
   "end": 36.36,
   "text": "نوعش نوع وحی اما نه وحی تشریعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.36,
   "end": 41.3,
   "text": "همون نبوت انبایی و همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.3,
   "end": 44.68,
   "text": "علم رو اخذ می‌کنه به وساطت ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.68,
   "end": 46.94,
   "text": "و دیروز عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.94,
   "end": 50.34,
   "text": "صریح‌ترین آیه قرآن در نزول ملائکه بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.34,
   "end": 53.26,
   "text": "انسان‌ها همین آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.26,
   "end": 61.3,
   "text": "سی سوره فصلت که \"إن الذين قالوا ربنا الله ثم استقاموا تتنزل عليهم الملائكة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.3,
   "end": 63.8,
   "text": "صراحتا در نزول ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.8,
   "end": 67.92,
   "text": "اینجا تصریح کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.92,
   "end": 73.3,
   "text": "اتفاقا در تفسیر روح البيان جلد هشت صفحه دویست پنجاه و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.3,
   "end": 80.86,
   "text": "روایتی از پیغمبر وارد شده که شخصی میگه به پیغمبر عرض کردم أخبرني بأمر أعتصم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.86,
   "end": 85.8,
   "text": "یه چیزی به من یاد بده که من بهش اتصام داشته باشم، چنگ بندازم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.8,
   "end": 87.94,
   "text": "متوسل بشم و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.94,
   "end": 91.98,
   "text": "پیغمبر فرمودند که قل ربی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.98,
   "end": 96.3,
   "text": "بگو پروردگار من الله است ثم استقامو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.3,
   "end": 98.0,
   "text": "و سپس استقامت بورز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.0,
   "end": 102.04,
   "text": "نشون میده که استقامت در پس ایمان چقدر مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.04,
   "end": 106.0,
   "text": "که مجموع این‌ها عرض کردیم علم و عمل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.0,
   "end": 110.22,
   "text": "ایمان علم است و استقامت عمل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.22,
   "end": 112.8,
   "text": "وقتی این دو تا با هم اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.8,
   "end": 117.7,
   "text": "نزول ملائکه رخ میده و اون تمسل حقایق، چشیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.7,
   "end": 122.1,
   "text": "حقایق در ذات و ثقل نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.1,
   "end": 124.04,
   "text": "دلیل بر نزول ملائکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.04,
   "end": 130.08,
   "text": "تا اینجا اومدیم. اتفاقا یکی دیگه از آیاتی که ارزش و اهمیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.08,
   "end": 135.56,
   "text": "استقامت رو بیان می‌کنه خیلی این آیه شیرین آیه شونزده سوره جن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.56,
   "end": 138.74,
   "text": "و \"أل لَاستَقاموا على الطریقة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.74,
   "end": 144.42,
   "text": "اگر این‌ها استقامت می‌ورزیدند بر اون بر این طریقت چه اتفاقی می‌افتاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.42,
   "end": 147.06,
   "text": "قطعاً \"لأسقیناهم ماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.06,
   "end": 153.72,
   "text": "غدقا\". ما قطعاً اون‌ها رو سیراب می‌کردیم \"لأسقیناهم ماء غدقا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.72,
   "end": 156.76,
   "text": "غدق یعنی فراوانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.76,
   "end": 160.72,
   "text": "زلالیّت و اینا. فراوانی همراه با زلال بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.72,
   "end": 166.0,
   "text": "یعنی اگر اینا در مسیر حالا این طریقت رو شما مسیر حق بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.0,
   "end": 170.4,
   "text": "استقامت می‌ورزیدند قطعاً ما سیرابشون می‌کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.4,
   "end": 173.04,
   "text": "از ماء غدق از اون آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.04,
   "end": 175.0,
   "text": "فراوان زلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.0,
   "end": 177.94,
   "text": "حالا ببینیم منظور از این طریقه و این آب چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.94,
   "end": 183.72,
   "text": "امام صادق صلی الله علیه، خدا رحمت کنه مرحوم شیخ صدوق رو در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.72,
   "end": 186.96,
   "text": "تمام نعمت این رو میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.96,
   "end": 194.32,
   "text": "که این روایت و ذیل این آیه میارن که امام صادق صلی الله علیه فرمود این طریقه ولایت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.32,
   "end": 198.76,
   "text": "یعنی کسی که استقامت بورزه در مسیر ولایت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.76,
   "end": 201.48,
   "text": "اون \"لأسقیناهم ماء غدقا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.48,
   "end": 206.96,
   "text": "که سیرابشون می‌کنیم قطعاً اون مستقیم‌های در مسیر ولایت ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.96,
   "end": 209.96,
   "text": "اون آب فراوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.96,
   "end": 214.56,
   "text": "زلال، یک جا فرمود علم امام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.56,
   "end": 217.94,
   "text": "الله اکبر. دقت بفرمایید چی دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.94,
   "end": 220.96,
   "text": "یعنی اگر کسی در مسیر ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.96,
   "end": 224.9,
   "text": "استقامت ورزید از علم امام بهره‌مند می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.9,
   "end": 226.96,
   "text": "باز اینجا تصریح بر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.96,
   "end": 231.06,
   "text": "نزول ملکه. چرا؟ چون وساطت نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.06,
   "end": 234.1,
   "text": "علم ملائکه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.1,
   "end": 236.88,
   "text": "که حالا به نحو اتمشو بگیریم شخص جبرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.88,
   "end": 241.02,
   "text": "اصلاً علم پیغمبر، شأن علمی پیغمبر یعنی جبرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.02,
   "end": 245.54,
   "text": "چون جبرائیل هم شؤونی از شؤون پیغمبره، شأنی از شؤون پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.54,
   "end": 248.1,
   "text": "خب علم وساطت جبرائیله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.1,
   "end": 251.08,
   "text": "ملکه. وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.08,
   "end": 256.94,
   "text": "که انسان در مسیر ولایت استقامت ورزید از علم امام بهره‌مند می‌شه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.94,
   "end": 259.44,
   "text": "یعنی اون ملائکه خاصی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.44,
   "end": 263.1,
   "text": "متولی علم امام هستند و شأنی از شؤون عه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.1,
   "end": 267.52,
   "text": "شؤون امام و حجت زمان هستند نازل می‌شن بر تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.52,
   "end": 271.18,
   "text": "این چیز کمی نیست و در این ماه این‌ها شدت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.18,
   "end": 274.3,
   "text": "همه بحث ما اینه در ماه مبارک رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.3,
   "end": 277.62,
   "text": "که البته امروز روز شهادته، قطعاً شهادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.62,
   "end": 281.22,
   "text": "نگیم وفات، شهادت حضرت خدیجه سلام الله علیهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.22,
   "end": 284.84,
   "text": "کی از ایشون مستقیم‌تر در مسیر پیغمبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.84,
   "end": 293.56,
   "text": "که به قول حضرت استاد علامه حسن زاده علیه الرحمه جایزه این استقامت و این مجاهدت در مسیر پیغمبر حضرت زهرا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.56,
   "end": 299.96,
   "text": "ببینید چه استقامتی در مسیر پیغمبر داشته که یکی مثل حضرت زهرا شده جایزه ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.96,
   "end": 306.36,
   "text": "شوخی نیست. حالا شما ببینید فرق بین نعمت و رزق و برکت رو می‌دونید دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.36,
   "end": 309.94,
   "text": "مثلاً یه باغی رو خدا به شما داده باشه مثال می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.94,
   "end": 312.9,
   "text": "این باغ نعمته، درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.9,
   "end": 315.82,
   "text": "هر مقدار این خیلی مهمه دونستنش ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.82,
   "end": 320.92,
   "text": "هر مقدار شما از این باغی که نعمت خداست استفاده کنی شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.92,
   "end": 325.26,
   "text": "اون رزق توه. اگه استفاده نکنی رزقت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 325.26,
   "end": 329.06,
   "text": "یه نعمتی یه گوشه افتاده و حساب کتابم باید پس بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.06,
   "end": 333.14,
   "text": "حالا مثلاً ماهی یه بار میخوای بری از این باغ استفاده کنی، سالی یه بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 333.14,
   "end": 337.8,
   "text": "سالی یه بار رزق توه. اگر کسی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.8,
   "end": 342.24,
   "text": "باغ رو برای دیگران قرار بده دیگران ازش استفاده کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 342.24,
   "end": 344.38,
   "text": "خودش که استفاده می‌کنه هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 344.38,
   "end": 346.72,
   "text": "به دیگران هم خیر این باغ برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 346.72,
   "end": 354.36,
   "text": "هر مقدار که دیگران از این نعمتی که رزق تو شد بهره‌مند بشن اون می‌شه برکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.36,
   "end": 358.02,
   "text": "حالا شما بیاید اینو جمع کنید تو حضرت خدیجه سلام الله علیها و ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 358.02,
   "end": 361.44,
   "text": "وجود ایشون خودش که یه نعمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.44,
   "end": 363.92,
   "text": "رزقی در خدمت پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.92,
   "end": 370.7,
   "text": "چه برکتی کرد که مرح-- مرحوم شهید مطهری فرمود اون سه چیزی که اسلام رو احیا کرد یکیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.7,
   "end": 374.68,
   "text": "ثروت خدیجه بوده. بابا این همه آدم دارا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.68,
   "end": 377.32,
   "text": "یه بخشی از دارایی‌شون رو می‌بخشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.32,
   "end": 380.46,
   "text": "یه گوشه‌ای از دارایی‌شون رو ذرت منت هم میذارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.46,
   "end": 384.54,
   "text": "سر خدا. یه گوشه‌ای از دارایی‌شون که زندگیشون به هم نریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.54,
   "end": 387.28,
   "text": "اصلا ظرفیت ندارن بیان یهو همه دارایی‌شون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.28,
   "end": 390.28,
   "text": "مگه میشه؟ مگه میشه همچین چیزی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.28,
   "end": 397.4,
   "text": "یه نفر تو معاصر ما مرحوم مجتهدی علیه الرحمه، شیخ آشیخ جعفر که تو حرم امام رضا دفنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 397.4,
   "end": 400.74,
   "text": "مریداش دورش رو می‌گرفتن. یکی از این مریداش خود من بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.74,
   "end": 403.3,
   "text": "متاسفانه خادمای حرم راهشو مسدود کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.3,
   "end": 407.24,
   "text": "گفتن در بغل امام رضا یه دکاندستکی فلانی راه انداخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.24,
   "end": 411.48,
   "text": "و متاسفانه وقتی فهمش نباشه بابا ایشون خودش ریزه خور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.48,
   "end": 418.78,
   "text": "سفره‌ی امام رضاست. بزرگوارا می‌رفتن محضر امام رضا حاجت بگیرن آقا می‌فرمود برید پیش شیخ جعفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.78,
   "end": 420.82,
   "text": "حالا بماند. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.82,
   "end": 425.56,
   "text": "تنها کسی بود ما تو زندگی‌نامه‌ی علما دیدیم کل دارایی‌شو بخشیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 425.56,
   "end": 430.66,
   "text": "هرچی داشت یعنی تکون داد دامنشو داد و خدا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.66,
   "end": 434.34,
   "text": "حکمت و اون مقامات عرفانی رو بهش داد که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.34,
   "end": 436.36,
   "text": "کمتر کسی داد. حالا ح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.36,
   "end": 438.06,
   "text": "نه یه نفر تو کل معاصر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 438.06,
   "end": 441.04,
   "text": "در زمان حضرت خدیجه خود حضرت خدیجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 441.04,
   "end": 446.06,
   "text": "دیگه می‌دونید دیگه ثروتمند جزیرة العرب و تاجر دست اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.06,
   "end": 448.38,
   "text": "هرچه که داشت دامن تکون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.38,
   "end": 451.92,
   "text": "طوری که امروزی کفن نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.92,
   "end": 456.6,
   "text": "خب این میشه که میشه چی؟ برکت، اسلام، همه‌ی ما سر سفره‌ی حضرت خدیجه‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 456.6,
   "end": 458.96,
   "text": "این یعنی برکت. این یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.96,
   "end": 465.58,
   "text": "برکت و اگر به قول بزرگان ایشون این همه سختی که در مسیر پیغمبر فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 465.58,
   "end": 470.18,
   "text": "سه سال در شعب ابی طالب یه خرما دوازده نفر در روز می‌خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.18,
   "end": 474.84,
   "text": "این همه حالا این که ما می‌گیم شهادت چون از همون مریضی‌های تو شعب ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 474.84,
   "end": 479.28,
   "text": "سختی‌ها و فقری که کشید تا همون انتهای شعب دیگه به رحمت حق رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 479.28,
   "end": 481.42,
   "text": "حضرت خدیجه به شهادت رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 481.42,
   "end": 485.56,
   "text": "ایشون اونجا تو شعب این همه سختی کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 485.56,
   "end": 490.04,
   "text": "یه آه، یه اف، یه ناراحتی به پیغمبر نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.04,
   "end": 492.18,
   "text": "یه آیه براتون بخونم و بحثو جمع کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.18,
   "end": 495.48,
   "text": "یه آیه شونزده سوره قیامت عجب آیه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.48,
   "end": 497.9,
   "text": "\"لا تحرك به لسانک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.9,
   "end": 501.88,
   "text": "لتعجله\". پیغمبر وقتی ما داریم قران می‌خونیم عجله نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.88,
   "end": 504.72,
   "text": "هی لسانتو تکون نده. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 504.72,
   "end": 507.46,
   "text": "مزاجت می‌ریزه به هم. عجله می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.46,
   "end": 510.56,
   "text": "تعجیل تو، این لب تکون دادن حتی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.56,
   "end": 515.86,
   "text": "این پیداست که پیغمبر از قبل قرآن رو به نفع دفعی داشته به نحو انزال دفعی به یک باره کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 515.86,
   "end": 519.7,
   "text": "قرآن رو داشته ملک که می‌امده تدریجا انزال کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.7,
   "end": 522.36,
   "text": "تنزیل کنه، ایشون تکرار می‌کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 522.36,
   "end": 526.04,
   "text": "پیغمبر میگه تکر-- خدا میگه تکرار هم نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.04,
   "end": 532.24,
   "text": "چرا؟ می‌ریزه به هم مزاجت و اون اصل قصه رو شاید نگیری اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 532.24,
   "end": 536.44,
   "text": "یعنی یک آن اگر پیغمبر مزاجش به هم می‌ریخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 536.44,
   "end": 538.62,
   "text": "اون وحی منقطع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.62,
   "end": 540.92,
   "text": "حتی لبت رو نباید بجنبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 540.92,
   "end": 544.74,
   "text": "خیلی موضوع مهمیه. اگر حضرت خدیجه تو این سختی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 544.74,
   "end": 548.88,
   "text": "یه آه می‌کشید، یه انقط میآورد، یه مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 548.88,
   "end": 552.12,
   "text": "اه خسته شدم همین به پیغمبر تمام بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 552.12,
   "end": 556.68,
   "text": "وحی قطع میشد. نکرده یک بار این کارو نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 556.68,
   "end": 559.2,
   "text": "شوخی نیست. اینو برید بررسی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.2,
   "end": 562.14,
   "text": "حق حیات بر گردن ما دارد حضرت خدیجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 562.14,
   "end": 564.9,
   "text": "انشاالله که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 564.9,
   "end": 570.48,
   "text": "به برکت وجود حضرت خدیجه به عمر ما هم برکت عطا و مرقبت بفرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 570.48,
   "end": 575.4,
   "text": "انشاالله عاقبتمون ختم به خیر باشد به برکت صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}