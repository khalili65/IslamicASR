 "chapters": [
  {
   "index": 0,
   "title": "## صفر و دعوت به غیاث الله؛ کیفی‌سازی اعمال",
   "start": 18.12,
   "end": 142.92
  },
  {
   "index": 1,
   "title": "## دعای کلّ؛ ظرفیت ماه و حرکت به‌سوی الله",
   "start": 142.92,
   "end": 241.12
  },
  {
   "index": 2,
   "title": "## سه روایت؛ رمضان چون پیامبر و چون علی",
   "start": 241.12,
   "end": 358.44
  },
  {
   "index": 3,
   "title": "## حرمت نام رمضان؛ شهر رمضان ضیافت الله",
   "start": 358.44,
   "end": 453.61
  },
  {
   "index": 4,
   "title": "## حتی آلوده‌ترین‌ها؛ ناامیدی راه ندارد",
   "start": 453.61,
   "end": 532.95
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.7,
   "end": 5.26,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.26,
   "end": 10.22,
   "text": "السلام علیک ای داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.22,
   "end": 13.5,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.5,
   "end": 18.12,
   "text": "به نوبه خودم تبریک عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.12,
   "end": 20.54,
   "text": "صفر شروع شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.54,
   "end": 23.88,
   "text": "ماه، ماه صفر است. دعیتم الی غیاث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.88,
   "end": 27.72,
   "text": "الله است. به راستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.72,
   "end": 30.46,
   "text": "و به حقیقت سفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.46,
   "end": 35.04,
   "text": "الی الله شروع شده است به طور جدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.04,
   "end": 38.38,
   "text": "و در این مسافرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.38,
   "end": 41.02,
   "text": "بعضی‌ها گویی سبقت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.02,
   "end": 44.14,
   "text": "می‌ربایند و از دیگران سبقت می‌گیرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.14,
   "end": 47.48,
   "text": "و در وضعیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.48,
   "end": 52.24,
   "text": "کیفی‌سازی خودشون و اعمالشون قرار می‌گیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.24,
   "end": 56.74,
   "text": "که بهترین کار در این ماه هم کیفی‌سازی اعمال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.74,
   "end": 62.48,
   "text": "نه صرفاً کم و تعداد اعمال رو بیشتر کردن، کیفی‌سازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.48,
   "end": 69.46,
   "text": "و چه عجیب که در این ماه این چنین نیست که اگر کسی جلو زد و گویی سبقت رو ربود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.46,
   "end": 73.24,
   "text": "بگیم تشویق مال یه نفر تنبیه مال همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.24,
   "end": 74.84,
   "text": "فقط اون به خیر برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.84,
   "end": 76.94,
   "text": "نه، هرکس در این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.94,
   "end": 79.84,
   "text": "رفت و جلودار شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.84,
   "end": 86.28,
   "text": "به نوری، معرفتی، حقیقتی رسید از نور وجود او همه بهره می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.28,
   "end": 93.44,
   "text": "مثل اینکه نا انزلناه فی لیلة القدر به انزال دفعی به قلب مقدس پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.44,
   "end": 99.44,
   "text": "تمام حقایق نازل می‌شه و تا الی يوم القيامة همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.44,
   "end": 104.92,
   "text": "تمام خلائق و کائنات و ممکنات دارن از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.92,
   "end": 107.84,
   "text": "انزال دفعی خیر می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.84,
   "end": 116.24,
   "text": "اینطوری نیستش که کسی گمان کنه اگر کسی به جایی رسید فقط خودش بهره برده مثل نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.24,
   "end": 118.54,
   "text": "که یه نفر نمازش قبول بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.54,
   "end": 121.74,
   "text": "سر یکی از اسرار نماز جماعت اینه مال همه قبول می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.74,
   "end": 125.28,
   "text": "یه نفر اگر قبول شه، البته اگر قبول شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.28,
   "end": 127.66,
   "text": "ولی مال همه قبول می‌شه. برکت ج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.66,
   "end": 130.72,
   "text": "شرکت در هیئات، جلسات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.72,
   "end": 134.68,
   "text": "اینا یه نفر مورد لطف خدا قرار بگیره همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.68,
   "end": 137.08,
   "text": "مشمول می‌شن. این یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.08,
   "end": 140.46,
   "text": "سفره‌ایست که عجیبه، یک سفره عجیبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.46,
   "end": 142.92,
   "text": "و چه ظرفیتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.92,
   "end": 147.64,
   "text": "حالا ما پیرامون اسرار و برکات ماه مبارک رمضان بخوایم صحبت کنیم خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.64,
   "end": 151.9,
   "text": "الا ما شاء الله بزرگان مثلاً کتاب اسرارالحکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.9,
   "end": 156.48,
   "text": "مرحوم حاجی سبزواری علیه الرحمه که غوغا کرده تو اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.48,
   "end": 159.16,
   "text": "که چه ظرفیتی دارد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.16,
   "end": 161.5,
   "text": "ماه که کل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.5,
   "end": 164.06,
   "text": "کل، کل تو دعاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.06,
   "end": 174.62,
   "text": "که از بهترین دعاهاست که حتی من ندیدم کمتر دعایی رو دیدم که در انجا در پس انجامش آثار گناه هم بخشیده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.62,
   "end": 178.42,
   "text": "گناه بخشیده می‌شه اما آثارش بخشیده بشه کار بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.42,
   "end": 182.82,
   "text": "کار کمی نیست در مداومت بر این دعای اللهم ادخل اهل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.82,
   "end": 185.86,
   "text": "علی اهل القبور السرور این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.86,
   "end": 187.92,
   "text": "آثار گناه هم بخشیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.92,
   "end": 193.74,
   "text": "بعد از نمازها بخونیم. حالا شما توش دقت کنید می‌گه کل، کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.74,
   "end": 197.02,
   "text": "همش کل. کل مریض‌ها شفا بگیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.02,
   "end": 200.06,
   "text": "کل اسرا خلاص بشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.06,
   "end": 202.6,
   "text": "کل مدیونین قرضشون ادا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.6,
   "end": 205.18,
   "text": "کل اینجا هست دارید نگاه می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.18,
   "end": 207.32,
   "text": "این ظرفیت این ماه رو داره می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 207.32,
   "end": 211.76,
   "text": "چرا؟ به نظر شما چرا این کل‌ها اینجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.76,
   "end": 215.08,
   "text": "به جهت اینکه دعیتم الی غیاث الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.08,
   "end": 217.0,
   "text": "الله هم کله. اسم کله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 217.0,
   "end": 220.42,
   "text": "اسم خاصه. حرکت به سمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.42,
   "end": 222.58,
   "text": "همه داریم به سمت الله میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 222.58,
   "end": 228.04,
   "text": "و هر مقدار که از این الله بهره گرفتیم همون مقدار از این کل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 228.04,
   "end": 233.28,
   "text": "بهش رسیدیم. توجه بفرمایید چی عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.28,
   "end": 238.88,
   "text": "که محل و مخرج فرج هم برای دیگران هم ما می‌شویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.88,
   "end": 243.34,
   "text": "بسیار ماه عجیبیه. حالا اجازه بدید من تبرکاً یک دو سه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.34,
   "end": 245.92,
   "text": "روایت تقدیم کنم ببینید چقدر عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 245.92,
   "end": 248.34,
   "text": "تو همین مقدار کم وقتمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.34,
   "end": 255.42,
   "text": "از کتاب شریف بهار جلد نود و یک صفحه شصت و پنج البته به نقل از تفسیر امام عسکری فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 255.42,
   "end": 259.66,
   "text": "مرحوم مجلسی تفسیری دارد امام عسکری کلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.66,
   "end": 264.92,
   "text": "منسوب به ایشونه. ایشون فرمودن قال رسول الله از قول پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.92,
   "end": 270.42,
   "text": "خیلی عجیبه. نمی‌دونم این حدیث رو دیدید یا نه که بچه‌ها حالا تو کانالم گذاشتم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.42,
   "end": 277.7,
   "text": "پیغمبر وقتی می‌خواد عظمت جایگاه خودش رو در میان خلائق بسنجه به، به مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.7,
   "end": 285.4,
   "text": "به رخ بکشه و به نمایش بده عظمت ماه مبارک رمضان رو بین شهور دیگه ماه‌های دیگه مثل این چنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.4,
   "end": 289.54,
   "text": "می‌فرماید محمدٌ صلى الله عليه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.54,
   "end": 297.28,
   "text": "صلى الله محمد و آله في عباد الله كشهر رمضان في الشهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 297.28,
   "end": 299.48,
   "text": "پیغمبر جایگاهش مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.48,
   "end": 302.28,
   "text": "در میان همه بندگان الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.28,
   "end": 305.14,
   "text": "مثل ماه رمضان بین بقیه ماه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.14,
   "end": 308.16,
   "text": "عجب! تا حالا یه همچین نگاهی ما داشتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.16,
   "end": 313.2,
   "text": "فرق بین این ماه با ماه‌های دیگه واقعاً مثل فرق پیغمبر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.2,
   "end": 315.54,
   "text": "با خلائق دیگه. بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.54,
   "end": 321.44,
   "text": "عظمت رو ببینید. یا مثلاً دو مرتبه در بهار جلد سی و هشت صفحه چهارده البته اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.44,
   "end": 328.34,
   "text": "این روایت رو مرحوم مجلسی علیه الرحمه به نقل از فضل ابن شاذان، فضائل ابن شاذان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.34,
   "end": 331.36,
   "text": "فضائل ابن شاذان خودش یه کتاب مستقل نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.36,
   "end": 338.84,
   "text": "کتاب روایی‌ست. اینجا باز پیغمبر این‌چنینی می‌فرماید فضل علی ابن ابی طالب علی هذا الامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.84,
   "end": 341.28,
   "text": "فضیلت و برتری امیرالمؤمنین بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.28,
   "end": 343.66,
   "text": "این مردم مثل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.66,
   "end": 349.38,
   "text": "مثل رو ببینید. كفضل شهر رمضان على شا-- سائر الشهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.38,
   "end": 354.82,
   "text": "الله اکبر. چقدر برتری هست بین امیرالمؤمنین و دیگر خلائق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.82,
   "end": 358.44,
   "text": "همونقدر برتری هست بین این ماه و ماه‌های دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 358.44,
   "end": 360.77,
   "text": "و چه عجیب که من روایتی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.77,
   "end": 363.33,
   "text": "حضرت امام کاظم بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.33,
   "end": 366.53,
   "text": "از ایشون که البته نقل از امیرالمؤمنین کرده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 366.53,
   "end": 369.35,
   "text": "از کتاب النوادر. اونجا می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.35,
   "end": 376.17,
   "text": "ایشون حالا انتهای روایت مبسوطی‌ست که امام کاظم صلوات الله علیه فرمود نگید رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.17,
   "end": 380.01,
   "text": "توبیخ داره. اگه کسی بگه رمضان امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.01,
   "end": 383.01,
   "text": "کاظم صلوات الله علیه در این روایته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.01,
   "end": 387.23,
   "text": "عجیبشون فرمودن کفاره داره و باید یه روز روزه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.23,
   "end": 388.97,
   "text": "تو این روایت رمضان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.97,
   "end": 394.53,
   "text": "حرمت نگه دارید. حتی در یک روایت دیگه‌ای که باز اون از کتاب معانی الاخبار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.53,
   "end": 400.33,
   "text": "سعد، سعد خفاف میگه من از با هشت نفر محضر امام باقر صلوات الله علیه بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.33,
   "end": 402.69,
   "text": "بعد بحث رمضان شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.69,
   "end": 404.65,
   "text": "حالا عین روایت میگه اون داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.65,
   "end": 406.57,
   "text": "میگه ب-- چون قرار شد نگیم رمضان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.57,
   "end": 408.59,
   "text": "اون میگه بحث رمضان شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.59,
   "end": 410.15,
   "text": "بعد امام باقر ما رو توبیخ کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.15,
   "end": 416.07,
   "text": "فرمودن چرا میگید رمضان؟ نه برای چی میگید رمضان آمد، رمضان رفت، رمضان شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.07,
   "end": 420.81,
   "text": "رمضان اسمی از اسماء الله هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 420.81,
   "end": 423.25,
   "text": "و چیز زوال پذیر میاد و میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 423.25,
   "end": 425.67,
   "text": "اسم خدا که زوال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.67,
   "end": 428.59,
   "text": "بلکه بگید شهر رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.59,
   "end": 433.05,
   "text": "ماه رمضان. حالا این ماه رمضان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 433.05,
   "end": 435.57,
   "text": "ضیافت الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.57,
   "end": 438.35,
   "text": "سفر شروع شده‌ ها عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 438.35,
   "end": 441.23,
   "text": "سفر آغاز شده و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.23,
   "end": 443.57,
   "text": "سفره برای همه گسترده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 443.57,
   "end": 446.31,
   "text": "همینطور که تو این دعا میگه کل، کل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.31,
   "end": 449.31,
   "text": "کل. نمیشه هیچکس رو مستثنا کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 449.31,
   "end": 453.61,
   "text": "حتی اجازه بدید شیب و انتهای بحثم اینجا تموم شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.61,
   "end": 456.43,
   "text": "حتی پست‌ترین آدم‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 456.43,
   "end": 461.79,
   "text": "به این شکلی که ما امروز عرض کردیم یعنی آلوده‌ترین‌ها که اگر بنده باشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.79,
   "end": 464.85,
   "text": "و بهترین‌ها که انشاالله شما باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.85,
   "end": 467.63,
   "text": "اصلاً و ابداً راه فراری از این سفره نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 467.63,
   "end": 473.09,
   "text": "یعنی خ-- حتی آلوده‌ترین‌ها، بیچاره‌ترین‌ها، در و داغون‌ترین‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 473.09,
   "end": 477.51,
   "text": "اونایی که اصلاً خراب کردن، از بین بردن حتی مستهلک شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 477.51,
   "end": 479.29,
   "text": "به وادی هلاکت رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 479.29,
   "end": 483.05,
   "text": "توجه بفرمایید چی عرض می‌کنم. غرق در گناه شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 483.05,
   "end": 489.11,
   "text": "توجه بفرمایید چون رمضان اسم الله هست از تو دل الله بیرون اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.11,
   "end": 492.51,
   "text": "و این ضیافت، ضیافت الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 492.51,
   "end": 494.69,
   "text": "احدی نمی‌تونه ناامید باشه تو این ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 494.69,
   "end": 501.99,
   "text": "بسم الله شروع کنیم. من به فضل الهی اومدم امروز رب ادخلنی مدخل صدق و اخرجنی مخرج صدق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 501.99,
   "end": 508.41,
   "text": "واجعل لي من لدنک سلطاناً نصيرا که به زحمت تفاسیر سلطان نصير امام عصر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 508.41,
   "end": 513.73,
   "text": "دعا کردم ورود کردم به همین نیت که خراب کردم اومدم اصلاح کنی منو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 513.73,
   "end": 515.33,
   "text": "ناامید مطلقا نباشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.33,
   "end": 518.55,
   "text": "انشاالله به سمت کیفی سازی اعمالمون بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 518.55,
   "end": 522.37,
   "text": "امیدوارم که از برکات و اسرار این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.37,
   "end": 525.51,
   "text": "هممون از آنات عجیبش و عرشیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 525.51,
   "end": 527.95,
   "text": "هممون بهره‌مند بشیم. صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 527.95,
   "end": 532.95,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}