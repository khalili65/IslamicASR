   "start": 28.2,
   "end": 96.72
  },
  {
   "index": 1,
   "title": "## شرف ماه و محرومیت اشقیا",
   "start": 96.72,
   "end": 184.16
  },
  {
   "index": 2,
   "title": "## حکمت، معرفت و علم در شرح قیصری",
   "start": 184.16,
   "end": 211.22
  },
  {
   "index": 3,
   "title": "## نتیجه: علم مندمج و نیاز به منبّه",
   "start": 211.22,
   "end": 341.66
  },
  {
   "index": 4,
   "title": "## روح مظهر روح اعظم؛ حس ویژهٔ رمضان",
   "start": 341.66,
   "end": 681.24
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 2.86,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.86,
   "end": 5.94,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.94,
   "end": 8.1,
   "text": "و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.1,
   "end": 11.46,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.46,
   "end": 13.64,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 13.64,
   "end": 16.82,
   "text": "محمد و عجل فرجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 16.82,
   "end": 20.86,
   "text": "بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 20.86,
   "end": 23.72,
   "text": "السلام علیک يا داعي الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 23.72,
   "end": 28.2,
   "text": "و رباني آياته سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 28.2,
   "end": 32.06,
   "text": "بحث ما پیرامون درون مایه ماه مبارک رمضان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 32.06,
   "end": 36.14,
   "text": "پیشاپیش عید فطر رو بر همه شما تبریک میگیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 36.14,
   "end": 44.02,
   "text": "در همین ابتدای بحثو ما هنوز موندیم در همون نکته روح و ارتباط و اتصالش با ما یا ما با او اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.02,
   "end": 49.24,
   "text": "یه توصیه به خودم و شما می‌کنم اگر انشاالله توفیق شد امشب این دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.24,
   "end": 58.3,
   "text": "وداع رو وداع ماه مبارک رمضان که امام سجاد علیه السلام دارن رو حداقل یه مروری بکنیم اگر حال نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.3,
   "end": 60.58,
   "text": "بخونیم. آیا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.58,
   "end": 63.28,
   "text": "قسمت چهل و پنجه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.28,
   "end": 65.7,
   "text": "عرض شود دعای چهل و پنج صحیفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.7,
   "end": 69.3,
   "text": "این کتابی که از دستم میاد صحیفه است دعای چهل و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.3,
   "end": 72.86,
   "text": "خیلی عجیبه واقعاً مرور که می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.86,
   "end": 78.24,
   "text": "انگار اِاِاِ مثلاً عاشق داره از معشوقش جدا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.24,
   "end": 81.0,
   "text": "یه همچین حالتیه امام سجاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.0,
   "end": 83.8,
   "text": "بسیار یعنی ده‌ها مورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.8,
   "end": 93.44,
   "text": "از اون نکاتی که ما باید پیرامون درون مایه این ماه می‌گفتیم امام سجاد در متن این دعا آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.44,
   "end": 98.66,
   "text": "یه دونشو که حالا ساق کنیم سنجاقش کنیم به بحث حضرت روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.66,
   "end": 101.08,
   "text": "و تاثیرش در ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.08,
   "end": 104.94,
   "text": "با یک لطائف الحیل خاصی حضرت آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.94,
   "end": 109.26,
   "text": "در این بخشش که عرض می‌کنه به حضرت حق که هذا شهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.26,
   "end": 114.1,
   "text": "این ماهی‌ست که الذي شرفتنا به اونجا هم تو اون دعا داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.1,
   "end": 120.38,
   "text": "که ها ال این اِاِاِ و هذا شهر عظمته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.38,
   "end": 123.82,
   "text": "و کرمته و شرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.82,
   "end": 126.24,
   "text": "و چی؟ فضلت احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.24,
   "end": 131.72,
   "text": "حالا اینجا ببینید الذي شرفتنا به اونجا هم شرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.72,
   "end": 138.02,
   "text": "شرفتنا به. تو ما رو مشرف کردی شرف دادی بزرگواری دادی به این ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.02,
   "end": 140.9,
   "text": "الله اکبر. و وفقن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.9,
   "end": 143.94,
   "text": "و وفق ت و وفقتنا بمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.94,
   "end": 147.34,
   "text": "که به من خودت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.34,
   "end": 152.24,
   "text": "اون منتی که به ما گذاشتی ما رو موفق کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.24,
   "end": 162.5,
   "text": "له حين جهل الاشقيا وقتا وقتی نادانا اشقیا عالم وقتش رو مقدّم نشمردند یا دست دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.5,
   "end": 167.38,
   "text": "و حرمو لشقائهم و محروم شدن به جهت اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.38,
   "end": 169.66,
   "text": "شقی بودنشون بدبخت بودنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.66,
   "end": 174.6,
   "text": "فضل له. اونجا دو مرتبه فضلته اینجا فضل له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.6,
   "end": 177.84,
   "text": "از فضل و برتری این ماه اینا غافل بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.84,
   "end": 181.66,
   "text": "حالا اینجا. انت ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.66,
   "end": 184.16,
   "text": "الله اکبر. تو ولی مایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.16,
   "end": 187.78,
   "text": "ما آثرتنا به من معرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.78,
   "end": 191.72,
   "text": "از اینکه ما رو برگزیدی آثرتنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.72,
   "end": 197.06,
   "text": "به من معرفته از معرفت این ماه ما رو برگزیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.06,
   "end": 203.66,
   "text": "عجیبه اینجا نکته‌ای رو می‌خوام به فضل الهی بگم ارتباطش حالا معرفت چرا اینجا حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.66,
   "end": 209.38,
   "text": "مثلاً علم نیاورده به علم این نیاورده فرموده به معرفت این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.38,
   "end": 213.32,
   "text": "اگر یادتون باشه متولّی از آنکه متولّ خوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.32,
   "end": 216.72,
   "text": "حالا یا اونایی هم که نخوندن شرح فصوص رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.72,
   "end": 223.3,
   "text": "حالا اِاِاِ علامه قیسری رو خونده باشن ذیل همون ابتدای شروع خطبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.3,
   "end": 227.12,
   "text": "فصوص الحکم ابن عربی شروع می‌کنه شرح دادن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.12,
   "end": 230.2,
   "text": "علامه قیسری شروع می‌کنه شرح دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.2,
   "end": 232.98,
   "text": "یه شرح مفصلی رو من همیشم اینجا نوشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.98,
   "end": 238.72,
   "text": "این تیکشو مقصودمه. داره فرق بین حکمت، معرفت و علم رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.72,
   "end": 241.1,
   "text": "علامه قیسری ذیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.1,
   "end": 243.76,
   "text": "خطبه ابن عربی در فصوص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.76,
   "end": 247.3,
   "text": "ببینید چی می‌فرماید. اول که می‌فرماید حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.3,
   "end": 249.28,
   "text": "توأمان علم و عمل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.28,
   "end": 253.3,
   "text": "یعنی علم و عمل با هم جمع شد می‌شه حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 253.3,
   "end": 256.18,
   "text": "بعد می‌ره سراغ معرفت و فرقش با علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.18,
   "end": 263.12,
   "text": "چرا اینو دارم میگم؟ اینجا حضرت می‌فرماید تو ولی مایی که برگزیدی ما رو به معرفت این ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 263.12,
   "end": 265.56,
   "text": "نفرمود به علم به این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.56,
   "end": 270.22,
   "text": "فرقش در چیه؟ اینجا علامه قیسری می‌فرماید المعرفة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.22,
   "end": 273.34,
   "text": "مصبوغة بالنسيان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.34,
   "end": 275.34,
   "text": "حاصل بعد العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.34,
   "end": 281.52,
   "text": "معرفت به چیزی می‌گن که قبلاً بعد از علم یعنی قبلاً علم بهش داشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.52,
   "end": 285.04,
   "text": "بعد نسیان اومده فراموش کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.04,
   "end": 288.74,
   "text": "خیلی مهمه این نکته. فراموش کردی اون علمی رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.74,
   "end": 295.42,
   "text": "قبل داشتی حالا دو مرتبه یکی اومد یه منبّهی، یه مذکّری اومد تو رو متنبّه کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.42,
   "end": 301.06,
   "text": "متذکّر کرد. به تو این اذکار رو داد، توجه رو داد که حواستو جمع کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.06,
   "end": 303.64,
   "text": "یه دفعه یادت میاد که قبلاً اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.64,
   "end": 305.48,
   "text": "می‌دونستی. به این میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.48,
   "end": 308.64,
   "text": "معرفت. لذا اسم خدا عارف نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.64,
   "end": 310.94,
   "text": "چون خدا نسیان درش نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.94,
   "end": 313.94,
   "text": "اسم خدا عالم، عالمه، علیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.94,
   "end": 316.94,
   "text": "و ادامه میده اینجا حالا علم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.94,
   "end": 323.0,
   "text": "بخلاف العلم لذلك مسمی الحق بالعالم دون العارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.0,
   "end": 326.84,
   "text": "بخلاف علم یعنی چی؟ علم اینطوری نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.84,
   "end": 330.04,
   "text": "شما بگی اِاِاِ نسیان بیاره براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.04,
   "end": 332.98,
   "text": "برای همین خدا رو عالم دونستن نه عارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.98,
   "end": 340.84,
   "text": "حالا اینجا امام سجاد علیه السلام می‌فرماید به معرفت این ماه ما رو برگزیدی تویی که ولی ما هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.84,
   "end": 343.4,
   "text": "شما بفرمایید چی می‌شه نتیجه گرفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 343.4,
   "end": 348.64,
   "text": "یعنی معرفت این ماه و درون مایه این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.64,
   "end": 353.64,
   "text": "علم به عظمت و فضلته و کرمته و شرفته و چه می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 353.64,
   "end": 355.76,
   "text": "اینا همه در ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.76,
   "end": 358.98,
   "text": "یعنی ما این علم به این ماه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.98,
   "end": 363.7,
   "text": "مندمج بود در ما. در روح ما بود به صورت کلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.7,
   "end": 367.08,
   "text": "حالا یک منبّه و یک مذکّری می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.08,
   "end": 369.48,
   "text": "که بیاد تنبّه بده ما رو بیدار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.48,
   "end": 373.28,
   "text": "اون چیه؟ حضرت روح اعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.28,
   "end": 377.56,
   "text": "که شب قدر تنزل الملائک و الروح میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.56,
   "end": 379.92,
   "text": "که این معرفت در ما ایجاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.92,
   "end": 383.28,
   "text": "یعنی چی؟ یعنی ما برگشت کنیم به اون علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.28,
   "end": 388.4,
   "text": "یعنی اصلاً اینکه قرآن رو ذکر گفتن ذکر یعنی یادآوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.4,
   "end": 394.78,
   "text": "یعنی از قبل بوده. اصلاً ما قبلاً این بحث‌هاش چون گذشته من راحت امروز حرف می‌زنم این روزها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.78,
   "end": 399.3,
   "text": "ما ثابت کردیم که قرآن در وجود ما هست، مندمج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.3,
   "end": 402.14,
   "text": "اصلاً در احدیت نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.14,
   "end": 406.22,
   "text": "که روح ما صورت روح ما از اون مرتبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.22,
   "end": 409.24,
   "text": "همه این‌ها متنقش بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.24,
   "end": 416.2,
   "text": "و کل همه این کثرات مستهلک در او بودند که کل شیء انخالق الا وجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.2,
   "end": 418.86,
   "text": "خب یعنی خلاصه اذیتتون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.86,
   "end": 420.96,
   "text": "یعنی این علوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 420.96,
   "end": 426.34,
   "text": "در وجود ما بوده در مرتبه‌ای از وجود ما به نام روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.34,
   "end": 427.92,
   "text": "که حالا جنسش از چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.92,
   "end": 431.06,
   "text": "گفتیم روح ما مظهر روح اعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.06,
   "end": 435.54,
   "text": "روح اعظم تشریف میارن به عالم دنیا که متنبه ما باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.54,
   "end": 441.7,
   "text": "لذا این ایام ماه مبارک رمضان به خصوص شب‌های قدر آدم بیدار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 441.7,
   "end": 446.14,
   "text": "یه حس عجیبی. این حس رو بیرون ماه مبارک رمضان نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.14,
   "end": 449.6,
   "text": "لذا امام سجاد به یک ظرافت خاصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.6,
   "end": 454.98,
   "text": "داره اینجا می‌فرماید به معرفت به این ماه ما رو تو برگزیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.98,
   "end": 457.48,
   "text": "به فضیلتش به معرفتش، نه به علمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.48,
   "end": 459.84,
   "text": "یعنی ما می‌دونستیم فراموش کرده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.84,
   "end": 462.14,
   "text": "حالا حضرت روح میاد. این یه وجهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.14,
   "end": 463.78,
   "text": "حالا خیلی حرف‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.78,
   "end": 466.7,
   "text": "دوست داشتم که فرصت بود بی‌رامونه، پیرامون اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 466.7,
   "end": 475.04,
   "text": "اصلاً ال-- یکی از علل اینکه این ماه نسبت به ماه‌های دیگه این‌همه تجلیات از حضرت حق به خودش داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.04,
   "end": 482.0,
   "text": "داره که طوری که حضرت روح که تجلی اعظم حضرت حق است نازل می‌شه بر این ماه صحبت، صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 482.0,
   "end": 486.5,
   "text": "یعنی چی؟ حالا اختلافی که بین فلاسفه یا حکما و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 486.5,
   "end": 490.08,
   "text": "عرفا هست. مثلاً ملاصدرا می‌فرماید خب اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.08,
   "end": 492.44,
   "text": "توحید الصمدی رو یادتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.44,
   "end": 495.84,
   "text": "که حضرت فرمود الصمد الذي لا جوف له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.84,
   "end": 498.34,
   "text": "حق یک وجود واحدست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 498.34,
   "end": 501.5,
   "text": "همه این عوالم هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.5,
   "end": 503.36,
   "text": "اطوار وجود حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.36,
   "end": 506.26,
   "text": "ظهور حق‌اند. مجالی حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 506.26,
   "end": 508.6,
   "text": "آیات حق‌اند. شعون حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.6,
   "end": 511.66,
   "text": "شجون حق‌اند. اینا همه بحث‌هاش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.66,
   "end": 514.88,
   "text": "یک حقه. اینطور نیست بگیم خدا یکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.88,
   "end": 517.16,
   "text": "آسمان یکی، زمین یکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 517.16,
   "end": 520.4,
   "text": "جدایی از هم نیستند. حق نو-- وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.4,
   "end": 523.24,
   "text": "یا حق یک وجود بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 523.24,
   "end": 525.26,
   "text": "پس این همه کثرات چی‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 525.26,
   "end": 531.0,
   "text": "شعون او هستند. مثل اینکه تو یک وجود واحدی یک شأنت قوه باصرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 531.0,
   "end": 533.38,
   "text": "یک شأنت قوه سامعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 533.38,
   "end": 535.56,
   "text": "النفس في وحدتها کل القوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 535.56,
   "end": 540.08,
   "text": "یک وجود واحدی همه این قوای وجودی تو شعون اون یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.08,
   "end": 545.54,
   "text": "حقیقت‌اند. همه عالم من جمله من و شما که یک آیت الله هستیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.54,
   "end": 548.08,
   "text": "یک کلمة الله هستیم. ظهور حقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 548.08,
   "end": 550.36,
   "text": "اینو امام حسین در دعای عرفه فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.36,
   "end": 553.64,
   "text": "ظهور خدا شده من. حالا اینجا اختلاف هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 553.64,
   "end": 556.12,
   "text": "این اختلافو گوش بدید به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 556.12,
   "end": 559.7,
   "text": "حکما مثل مثلاً ملاصدرا در اسفار می‌فرماید این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 559.7,
   "end": 562.8,
   "text": "این اختلافی که در اشیا هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 562.8,
   "end": 569.36,
   "text": "یکی عظیم شده، یکی مثل یکی ضعیف شده، یکی قوی شده، یکی ماه مبارک رمضان شده، یکی ماه مثلاً شوال شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 569.36,
   "end": 572.3,
   "text": "شدت عظمت مثلاً خدا در این ماه بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 572.3,
   "end": 575.08,
   "text": "می‌فرماید یک حقیقت واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 575.08,
   "end": 578.24,
   "text": "ذات مراتب به شدت و ضعف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 578.24,
   "end": 585.1,
   "text": "یعنی چی؟ یعنی خدا در ماه مبارک رمضان شدت ظهور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.1,
   "end": 588.18,
   "text": "در جای دیگه ضعف ظهور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.18,
   "end": 592.18,
   "text": "خب؟ اما البته علامه حسن زاده می‌فرماید نه این اشتباس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 592.18,
   "end": 594.92,
   "text": "اتفاقاً باید گفت حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 594.92,
   "end": 598.76,
   "text": "واحده‌ی ذات مظاهر به سعة و ضیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 598.76,
   "end": 602.92,
   "text": "مثالشو دقت کنید. مثال یه استخر آب توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 602.92,
   "end": 604.9,
   "text": "یه دریاچه هم توش آبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 604.9,
   "end": 608.4,
   "text": "خب؟ می‌گیم آقا این استخره چرا این اندازه آب داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 608.4,
   "end": 614.0,
   "text": "دریاچه اون اندازه. می‌گیم چون آب شدیدتره در دریاچه و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 614.0,
   "end": 616.18,
   "text": "استخر ضعیف‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 616.18,
   "end": 618.82,
   "text": "یعنی آب، آب‌تره در دریاچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 618.82,
   "end": 622.3,
   "text": "آب که آبه. همون آبی که تو دریاچه هست تو استخر هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 622.3,
   "end": 625.62,
   "text": "تو یه پیاله هم هست. پس فرق بین این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 625.62,
   "end": 629.48,
   "text": "که اون شده دریا، این شده استخر، این شده پیاله آب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 629.48,
   "end": 634.22,
   "text": "برمی‌گرده علامه حسن زاده می‌فرماید به سعة و ضیق مظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.22,
   "end": 637.62,
   "text": "یعنی این سعة داره آب بیشتری توش جا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 637.62,
   "end": 640.62,
   "text": "اون ضیق تنگ آب کمتری جا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 640.62,
   "end": 643.94,
   "text": "پس به مظاهر برمی‌گرده نه به مراتب حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 643.94,
   "end": 652.34,
   "text": "پس نتیجه این ماه، ماه مبارک رمضان علت اینکه این‌همه عظمت پیدا کرده اینقدر که سعة داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 652.34,
   "end": 654.6,
   "text": "اینقدر که ظرفیت داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 654.6,
   "end": 658.32,
   "text": "آب وجود و تجلیات حضرت حق رو در خودش جای داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 658.32,
   "end": 661.62,
   "text": "یعنی شدت حضور حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 661.62,
   "end": 664.16,
   "text": "انشاالله که عاقبت ما ختم به خیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 664.16,
   "end": 667.0,
   "text": "انشاالله اگر زنده بودید شما هم حالشو داشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 667.0,
   "end": 673.28,
   "text": "سال بعد توفیق بود ماه مبارک رمضان این درون مایه رو ما یکی دو تا گفتیم، نکته گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 673.28,
   "end": 678.74,
   "text": "حدود سی تا نکته‌ست. انشاالله سی تا ماه رمضان می‌تونه با همدیگه سر سفره بشینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 678.74,
   "end": 681.24,
   "text": "صلوات ختم کنیم. الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}