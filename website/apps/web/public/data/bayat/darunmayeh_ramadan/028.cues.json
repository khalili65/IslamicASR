 },
 "chapters": [
  {
   "index": 0,
   "title": "## اسرار صوم؛ توقف نکردن در خلوص نخستین",
   "start": 131.98,
   "end": 240.78
  },
  {
   "index": 1,
   "title": "## الجوع سحاب یمطر الحکمة",
   "start": 240.78,
   "end": 260.9
  },
  {
   "index": 2,
   "title": "## هفت بطن و یوم تبلی السرائر",
   "start": 260.9,
   "end": 672.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 4.16,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.16,
   "end": 7.88,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.88,
   "end": 12.62,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.62,
   "end": 15.86,
   "text": "سؤال شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.86,
   "end": 19.14,
   "text": "کارگری که وقتی مشغول به کار می‌شه در ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.14,
   "end": 21.62,
   "text": "ماه مبارک رمضان حالش خیلی بد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.62,
   "end": 25.98,
   "text": "روزه که می‌گیره حالش به گونه‌ای بد می‌شه که به کارش لطمه می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.98,
   "end": 29.2,
   "text": "اصلاً احتمال داره که اخراجش کنن از سر کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.2,
   "end": 31.98,
   "text": "می‌گه آقا این چه وضع کار کردنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 31.98,
   "end": 34.52,
   "text": "چه باید بکنه؟ روزه‌شو بگیره، نگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 34.52,
   "end": 40.04,
   "text": "آقا فرمودن اگر این شدتی که به تو عارض می‌شه به حرج بندازه تو رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.04,
   "end": 45.16,
   "text": "ما یه مریضی داریم که طرف مریضه، روزه براش مضره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.16,
   "end": 52.84,
   "text": "یا شدت مریضی میاره یا مریضی قبلش، قبلنش رو دوباره الان به وجود میاره یا طول درمان میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.84,
   "end": 57.16,
   "text": "این‌ها همه هیچی که اصلاً نباید بگیره حرامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.16,
   "end": 58.92,
   "text": "یه بحث دیگه حرج داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.92,
   "end": 60.86,
   "text": "حرج با مریضی فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.86,
   "end": 65.44,
   "text": "مثلاً می‌گن بچه، یه دختر بچه که تازه به سن تکلیف رسیده اگه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.44,
   "end": 67.44,
   "text": "حرج میفته روزه‌شو بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.44,
   "end": 71.66,
   "text": "اما نیت، کسی که مریضه حق نداره اصلاً رو، نیت روزه بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.66,
   "end": 74.12,
   "text": "و روزه برای مریضی‌ش ضرر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.12,
   "end": 75.94,
   "text": "اما حرجی نه. حرجی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.94,
   "end": 77.86,
   "text": "یعنی می‌تونه شروع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 77.86,
   "end": 79.64,
   "text": "خب بچه می‌تونه شروع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 79.64,
   "end": 82.56,
   "text": "کارگر می‌تونه روزه‌شو شروع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 82.56,
   "end": 85.48,
   "text": "از اول روز روزه بگیره، نیت کنه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 85.48,
   "end": 87.94,
   "text": "هر وقت غیر قابل تحمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 87.94,
   "end": 90.96,
   "text": "حرج یعنی مشقت غیر قابل تحمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 90.96,
   "end": 92.88,
   "text": "خیلی براش سخت شد بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 92.88,
   "end": 97.8,
   "text": "اینجا مجوز داره بخوره و بعداً و کفاره هم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 97.8,
   "end": 103.16,
   "text": "مگر بخوره به ماه مبارک رمضان و الا یه قضا گردنشه بعد از ماه مبارک رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 103.16,
   "end": 105.34,
   "text": "منتها اینم دقت این خیلی نکته ظریفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 105.34,
   "end": 110.12,
   "text": "کسی که مریضه، ها، به خاطر مریضی حق نداره روزه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 110.12,
   "end": 116.38,
   "text": "اگه تا ماه مبارک رمضان نگرفت با این مریضی براش باقی موند تا ماه مبارک رمضان بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 116.38,
   "end": 118.68,
   "text": "دیگه قضا نداره، کفاره داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 118.68,
   "end": 123.16,
   "text": "اما کسی که حرجی روزه نگرفته یعنی مشقت ایجاد شده، خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 123.16,
   "end": 128.64,
   "text": "این دیگه همیشه قضا گردنشه و لا تا ماه مبارک رمضان بعدم باز این حالت حرج رو داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 128.64,
   "end": 131.14,
   "text": "اینو حواسمون باشه اختلافشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 131.14,
   "end": 134.48,
   "text": "نکته‌ی دیگه‌ای که پیرامون اسرار روزه عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 134.48,
   "end": 138.26,
   "text": "و تقریباً مخصوصاً شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 138.26,
   "end": 143.36,
   "text": "به حول و قوه الهی الان این رو بیان می‌کنیم بعد از این همه مطالبی که پی، پیرامون اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 143.36,
   "end": 145.36,
   "text": "روزه تبرکه‌ن عرض کردیم الان جاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 145.36,
   "end": 147.9,
   "text": "خوب دقت بفرمایید که حاجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 147.9,
   "end": 151.2,
   "text": "سبزواری رحمة الله علیه حری， حکیم عارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 151.2,
   "end": 154.48,
   "text": "یه جمله‌ای میارن در اسرار ص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 154.48,
   "end": 159.22,
   "text": "صومشون که میگن آقا جان شما که اومدی کف نفس کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 159.22,
   "end": 161.86,
   "text": "وجودت رو از مفترات حفظ کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 161.86,
   "end": 163.88,
   "text": "که روزه ات باطل نشه. برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 163.88,
   "end": 165.88,
   "text": "برای اینکه حالا مثلاً خلوص پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 165.88,
   "end": 168.46,
   "text": "ما گفتیم یکی از معانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 168.46,
   "end": 170.9,
   "text": "یکی از اسرار روزه خلوص محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 170.9,
   "end": 179.52,
   "text": "خب همین؟ تمام شد؟ خب عزیز دلم تو که کف نفس کردی روزه گرفتی که صوم تسهُ بدنت سالم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 179.52,
   "end": 183.92,
   "text": "و بعد همین باعث شد به خلوص برسی در درون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 183.92,
   "end": 187.94,
   "text": "همین، همین سر روزه باعث شد تو به جایی برسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 187.94,
   "end": 192.38,
   "text": "یک جنت من النار سپری باشه بر آتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 192.38,
   "end": 195.28,
   "text": "خب برو بالاتر. اقرأ ورق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 195.28,
   "end": 198.58,
   "text": "برو تعال بیاید بالاتر، بیا بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 198.58,
   "end": 203.26,
   "text": "میگه بلکه تو توجه داشته باش که تخلّق با اخلاق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 203.26,
   "end": 205.34,
   "text": "به اخلاق ربانیین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 205.34,
   "end": 207.8,
   "text": "تو متخلّق شو به اخلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 207.8,
   "end": 212.9,
   "text": "یا روحانیین. تو متخلّق شو به اخلاق ملائکه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 212.9,
   "end": 216.1,
   "text": "صرفاً این نباشه که یه چیزی نخوری یا از آتش جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 216.1,
   "end": 219.94,
   "text": "آقا برای چی روزه می‌گیری؟ می‌خوام اگه نگیرم جهنم میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 219.94,
   "end": 222.48,
   "text": "این دیگه ابتدایی‌ترین معناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 222.48,
   "end": 225.3,
   "text": "این تنزّل دادن موضوع روزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 225.3,
   "end": 228.06,
   "text": "آقا برای چی روزه می‌گیری؟ اصلاً برای اینکه خالص شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 228.06,
   "end": 230.98,
   "text": "چون روزه خلوص محضه. هیچکس نمی‌فهمه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 230.98,
   "end": 235.68,
   "text": "روزه‌ام. اما آیا سؤال، آیا تو فقط یک باطن داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 235.68,
   "end": 239.22,
   "text": "همین یه باطن رو با خلوص می‌خوای درست کنی تموم شد و رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 239.22,
   "end": 242.98,
   "text": "اینجا مرحوم حاجی سبزواری میاد یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 242.98,
   "end": 248.4,
   "text": "عرض شود یک باب عجیب و گسترده‌ای رو به روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 248.4,
   "end": 251.14,
   "text": "ما بیننده‌ها و شنونده‌ها باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 251.14,
   "end": 254.16,
   "text": "میگه آقا بله این بل، بله از رابی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 254.16,
   "end": 256.72,
   "text": "بله ترقیه. بله اعراض نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 256.72,
   "end": 260.38,
   "text": "میگه بل تخلّق با اخلاق الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 260.38,
   "end": 262.78,
   "text": "میگه شما اخ، ملائکه مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 262.78,
   "end": 267.86,
   "text": "عالم عقلن دیگه. میگه تو فقط عقل نداری که قلبم داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 267.86,
   "end": 271.96,
   "text": "القلب حرم الله ولا تسکن حربا الله قلب الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 271.96,
   "end": 275.4,
   "text": "غیر الله. همون حدیثی که علامه حسن زاده گفتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 275.4,
   "end": 279.14,
   "text": "گفتم تا آخر عمر شاید نبینمت به من بگو همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 279.14,
   "end": 281.74,
   "text": "میگه آقا تو باید به جایی برسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 281.74,
   "end": 284.86,
   "text": "هی بری تو. ما چند تا تو اصلاً داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 284.86,
   "end": 288.4,
   "text": "شما تا حالا تحمل، تحمل کردی پیرامون این قصه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 288.4,
   "end": 292.64,
   "text": "ما یه باطنی، یه ظاهر داریم باطن همین بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 292.64,
   "end": 296.58,
   "text": "تموم شد. خب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 296.58,
   "end": 301.68,
   "text": "تو دعاها و این‌ها هم وارد شده که خدایا ظاهر منو نورانی کن به طاعت خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 301.68,
   "end": 305.48,
   "text": "اما چند تا تو داریم؟ من همین الان اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 305.48,
   "end": 310.14,
   "text": "دعای بعد از آل یاسین رو می‌خوندم دیدم چه جالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 310.14,
   "end": 314.5,
   "text": "چهار تا تو درون باطن رو مولا پشت سر هم تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 314.5,
   "end": 317.4,
   "text": "دعای بعد از آل یاسین گفته ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 317.4,
   "end": 323.14,
   "text": "الله وقتی که صلوات می‌فرسته بعد تو دعا میگه ان تملأ قلبی نور اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 323.14,
   "end": 328.8,
   "text": "این یه تو، این یه درون و صدری نور الايمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 328.8,
   "end": 331.14,
   "text": "سدر یه تو دیگه. حالا این سدر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 331.14,
   "end": 334.56,
   "text": "باید واکاوی بشه و فکری نور--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 334.56,
   "end": 337.24,
   "text": "فکر حوزه تدبر و اندیشه و عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 337.24,
   "end": 339.5,
   "text": "دوباره می‌فرماید و عزمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 339.5,
   "end": 341.54,
   "text": "عزم مال حوزه روح انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 341.54,
   "end": 343.78,
   "text": "اراده می‌کنی، روحت اراده می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 343.78,
   "end": 348.1,
   "text": "که این بحثش قبلاً گذشته. چهار تا تو رو اینجا امام می- می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 348.1,
   "end": 350.44,
   "text": "خب ما فقط یک درون که نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 350.44,
   "end": 354.58,
   "text": "دیدی گاهی اوقات بیست سال، سی سال، پنجاه سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 354.58,
   "end": 359.04,
   "text": "با یکی رفیقی یه حادثه‌ای رخ میده یهو خودشو می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 359.04,
   "end": 361.86,
   "text": "عجب! عجب تو این بودی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 361.86,
   "end": 364.27,
   "text": "همه تحلیل‌های منو به هم ریختی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 364.27,
   "end": 366.51,
   "text": "تو اصلاً از تو بعیده این رفتاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 366.51,
   "end": 369.15,
   "text": "ببین تو درونش، تو سر و سرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 369.15,
   "end": 373.07,
   "text": "ماف الضمیرش یه چیزایی بوده که الان یه دفعه خودش رو نشون داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 373.07,
   "end": 374.77,
   "text": "میگه تعال بیا بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 374.77,
   "end": 377.65,
   "text": "اتفاقاً بعدش اشاره می‌کنه ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 377.65,
   "end": 381.03,
   "text": "خود مرحوم حاجی سبزوری به یک روایت خیلی زیبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 381.03,
   "end": 383.33,
   "text": "که البته می‌فرماید اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 383.33,
   "end": 386.23,
   "text": "بزرگانه. دیگه من ندیدم تو احادیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 386.23,
   "end": 393.25,
   "text": "شاید منظور ایشون اینه که بزرگان از احادیث اخذ کردن یا از مضامین احادیث اخذ کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 393.25,
   "end": 395.35,
   "text": "به هر حال در هرچی که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 395.35,
   "end": 399.59,
   "text": "ایشون می‌فرماد که این حدیث زیبا را الجوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 399.59,
   "end": 402.79,
   "text": "معنای صم. الجوع سحاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 402.79,
   "end": 406.61,
   "text": "یمطر الحکمه. الله اکبر چقدر زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 406.61,
   "end": 411.73,
   "text": "میگه روزه مثل یک ابریه که ازش همینجوری چجوری بارون داره می‌ریزه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 411.73,
   "end": 416.05,
   "text": "حکمت می‌ریزه. میگه تو چرا فقط می‌خوای توقف کنی تو اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 416.05,
   "end": 418.03,
   "text": "من به جهنم نرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 418.03,
   "end": 421.71,
   "text": "و به بهشت برم اینکه ابتدایی‌ترین-- دیدی یکی می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 421.71,
   "end": 424.39,
   "text": "مثلاً کارشناسیشو بگیره. هیچ جا نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 424.39,
   "end": 427.37,
   "text": "نه بازی می‌کنه، نه سینما میره، فوتبال بیا بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 427.37,
   "end": 429.73,
   "text": "گده‌های رفاقتی بیا بریم یه گپی بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 429.73,
   "end": 431.77,
   "text": "بحث سیاسی اصلاً و مطلقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 431.77,
   "end": 434.33,
   "text": "من باید شب امتحانم دکترا دارم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 434.33,
   "end": 438.23,
   "text": "به محض اینکه مدرکو گرفت چون همتش فقط مدرکه تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 438.23,
   "end": 444.15,
   "text": "دوباره برمی‌گرده تو بازیش و تازه میگه خب من مدرکمو گرفتم آقای دولت یالا کار به من بده ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 444.15,
   "end": 448.25,
   "text": "اصلاً رفته برای کار. مدرک گرفته برای این کار متوقف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 448.25,
   "end": 451.01,
   "text": "اما کسی که اون افقش بالاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 451.01,
   "end": 454.49,
   "text": "می‌دونه نفس ناطقه انسان سیرش بی‌نهایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 454.49,
   "end": 457.09,
   "text": "با این روزه متوقف نمی‌شه صرفاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 457.09,
   "end": 460.43,
   "text": "کف نفس. فقط اینکه بهشت بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 460.43,
   "end": 464.27,
   "text": "یا یه سپری داشته باشه از آتش جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 464.27,
   "end": 467.27,
   "text": "میگه که آقا بیا رشد کن تعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 467.27,
   "end": 470.51,
   "text": "برو بالا. شیخ ابوعلی سینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 470.51,
   "end": 473.15,
   "text": "شیخ الرئیس اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 473.15,
   "end": 477.29,
   "text": "راه نمی‌داد. البته توجه بالای پرانتز اینو مدیرای وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 477.29,
   "end": 479.73,
   "text": "توجه داشته باشن برداشت بد نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 479.73,
   "end": 482.53,
   "text": "مدیرها باید وقت بدن به زیردستاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 482.53,
   "end": 485.67,
   "text": "جسارت نشه اون‌ها میگن آقا من وقتم ارزشمنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 485.67,
   "end": 488.29,
   "text": "اصلاً اتفاقاً شما اومدی که مدیریت کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 488.29,
   "end": 491.41,
   "text": "گره‌های همکاراتو باز کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 491.41,
   "end": 495.65,
   "text": "خب شما باید وقت بدی تا درد دل همکارا رو ندونی چه گره‌ای، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 495.65,
   "end": 498.81,
   "text": "همایشی، چه جلسه‌ای تا هی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 498.81,
   "end": 501.09,
   "text": "نمی‌دونم امضا بزنیم سیاهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 501.09,
   "end": 504.63,
   "text": "این مصوبات جلسه در حالی که اصلاً نمی‌دونیم گره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 504.63,
   "end": 507.65,
   "text": "ذهنی این همکارا چیه، مشکلاتشون چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 507.65,
   "end": 513.03,
   "text": "اون فرق می‌کنه. اما بزرگان وقتی یه سری رو می‌خوان بگن هر مانعی رو می‌ذارن کنار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 513.03,
   "end": 514.97,
   "text": "هر ملاقاتی رو قبول نمی‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 514.97,
   "end": 517.95,
   "text": "هر حرف و حدیثی رو اصلاً گده نمی‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 517.95,
   "end": 520.71,
   "text": "شیخ ابوعلی سینا اصلاً وقت به کسی نمی‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 520.71,
   "end": 523.89,
   "text": "اصلاً باورتون می‌شه وقت نکرد ازدواج کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 523.89,
   "end": 526.15,
   "text": "اینا یه مقدار برای ما سنگینه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 526.15,
   "end": 528.31,
   "text": "حکیمی که اصلاً یادش رفت شهوت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 528.31,
   "end": 532.81,
   "text": "معذرت می‌خوام. انقدر غرق در رشد و معنویت و تعالی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 532.81,
   "end": 535.67,
   "text": "اینا یه ذره برای ما سنگینن چون ابتدای کارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 535.67,
   "end": 539.23,
   "text": "ها یکی اومد می‌دونست چی-- نبض شیخ چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 539.23,
   "end": 542.47,
   "text": "دید یه، یه عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 542.47,
   "end": 546.73,
   "text": "کلاغی میره بالا. یه ماری بالای درخت این کلاغه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 546.73,
   "end": 550.01,
   "text": "حالا نمی‌دونم ماره به لونه‌ش تعدی کرده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 550.01,
   "end": 551.79,
   "text": "این کلاغه هی نوک می‌زنه به ماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 551.79,
   "end": 555.69,
   "text": "ماره نیشش می‌زنه تا نیش می‌خوره میاد از یه گیاهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 555.69,
   "end": 557.69,
   "text": "نوک می‌زنه کلاغه حالش خوب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 557.69,
   "end": 563.39,
   "text": "دوباره میره با ماره می‌جنگه. رفت این گیاه رو چند دید کلاغه اومد گیاه رو پیدا نکرد مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 563.39,
   "end": 566.75,
   "text": "رفت به شیخ الرئیس گفت ها اینطوریه و شیخ الرئیس بلند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 566.75,
   "end": 568.73,
   "text": "گفت حالا وقتشه بریم ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 568.73,
   "end": 571.71,
   "text": "این گیاه چی بوده، کجا بوده، چه منطقه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 571.71,
   "end": 573.45,
   "text": "خب چون یه راهی رو می‌خواد بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 573.45,
   "end": 575.57,
   "text": "بعد الان کتاب قانونش، طبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 575.57,
   "end": 578.57,
   "text": "اینا تو کل دنیا داره تدریس می‌شه الا ایران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 578.57,
   "end": 582.23,
   "text": "جالبه. حالا دقت بفرمایید ما چند تا تو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 582.23,
   "end": 588.67,
   "text": "حکما توها، اون درون‌ها، بواتنی که برای ما شمردند حداقل هفت‌تاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 588.67,
   "end": 590.73,
   "text": "گفتن خب یه ظاهر داریم بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 590.73,
   "end": 593.47,
   "text": "بعد نفسه، بعد عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 593.47,
   "end": 595.73,
   "text": "اینا بحثش قبلاً گذشته بینمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 595.73,
   "end": 599.21,
   "text": "بعد عقله، بعد قلبه، بعد روحه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 599.21,
   "end": 603.41,
   "text": "بعد سره، بعد خفیه، بعد أخفا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 603.41,
   "end": 607.07,
   "text": "گاهی اوقات قرآن خدا تو قرآن میگه من به سر شما آگاهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 607.07,
   "end": 609.41,
   "text": "گاهی اوقات میگه به خفیه درون دل شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 609.41,
   "end": 612.43,
   "text": "گاهی اوقات میگه به أخفاء بما في الصدور شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 612.43,
   "end": 614.77,
   "text": "اینا با هم متفاوت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 614.77,
   "end": 618.09,
   "text": "روزه باید به گونه‌ای برسه که ما رو به اونجا برسونه که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 618.09,
   "end": 622.55,
   "text": "س-- میگه يوم تبلى السرائر هیچ‌وقت رو این آیه کار کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 622.55,
   "end": 626.47,
   "text": "همه می‌چسبونش به دیگران. می‌گن آقا درون همه می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 626.47,
   "end": 629.93,
   "text": "این سرائر سریرت‌ها برمی‌گرده به کثرت انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 629.93,
   "end": 635.89,
   "text": "نه عزیزم. این سرائر برمی‌گرده به یک واحد، یک نفر، توی یک نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 635.89,
   "end": 641.27,
   "text": "سرائرت می‌ریزه بیرون. انقدر ما تو در توییم، انقدر پیچیده‌ایم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 641.27,
   "end": 643.45,
   "text": "انقدر در درون خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 643.45,
   "end": 646.35,
   "text": "دنیاهایی داریم. یه دفعه همه می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 646.35,
   "end": 649.71,
   "text": "تازه عجب! ما چه آدمی بودیم، چی بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 649.71,
   "end": 651.73,
   "text": "توقف نکنیم. تعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 651.73,
   "end": 653.85,
   "text": "اقرأ ورءا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 653.85,
   "end": 656.89,
   "text": "تا یارkra خواهد و میلش به که باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 656.89,
   "end": 659.27,
   "text": "این بحث مفصود بود. بعد بیشتر ادامه می‌دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 659.27,
   "end": 662.11,
   "text": "تبرکاً عرض کردیم. ان‌شاءالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 662.11,
   "end": 665.15,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 665.15,
   "end": 672.23,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}