 "chapters": [
  {
   "index": 0,
   "title": "## نزول روح و ملائکه؛ قرب فریضه و نافله",
   "start": 11.64,
   "end": 216.26
  },
  {
   "index": 1,
   "title": "## بدن انزل مراتب نفس",
   "start": 216.26,
   "end": 264.2
  },
  {
   "index": 2,
   "title": "## فرق قرب فریضه و نافله",
   "start": 264.2,
   "end": 487.28
  },
  {
   "index": 3,
   "title": "## شیخ عباس تربتی و ترک نگاه به بازار",
   "start": 487.28,
   "end": 529.8
  },
  {
   "index": 4,
   "title": "## نام سلیمان و داود؛ داء الود",
   "start": 529.8,
   "end": 662.3
  },
  {
   "index": 5,
   "title": "## جمع‌بندی؛ روح و کندن از دنیا",
   "start": 662.3,
   "end": 687.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 2.94,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.94,
   "end": 6.28,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.28,
   "end": 8.12,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.12,
   "end": 11.64,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.64,
   "end": 14.28,
   "text": "بحث ما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 14.28,
   "end": 21.82,
   "text": "نزول ملائکه و روح بود و البته ما می‌خواستیم در ماه مبارک رمضان حداقل بیست تا الی سی تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.82,
   "end": 24.34,
   "text": "نکته رو پیرامون در این مایه این ماه بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.34,
   "end": 27.66,
   "text": "تو همین یه دونش موندیم چه برسه بقیه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.66,
   "end": 30.8,
   "text": "حالا دیگه انتهای بحث و انتهای ماه هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.8,
   "end": 37.16,
   "text": "بحث ما این بود که می‌تونه یه دونه از دلایکی از اون وجوه و دلایل نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.16,
   "end": 40.46,
   "text": "ملائکه به اتفاق حضرت روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.46,
   "end": 48.1,
   "text": "این باشد که شما دقت بفرمایید همون‌طور که قبلاً عرض کردیم روح از جایگاه حضرت روح اعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.1,
   "end": 55.26,
   "text": "بالاترین مراتب بود در میان خلائق طوری که ملائکه مهیمین که خصوصیتشون اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.26,
   "end": 58.46,
   "text": "هیچ خبری از خلائق ندارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.46,
   "end": 62.0,
   "text": "به یک معنی یعنی کاملاً متوجه حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.0,
   "end": 66.18,
   "text": "فقط توجهشون به خداست و بس، تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.18,
   "end": 68.74,
   "text": "اون بهشون می‌گن ملائکه مهیمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.74,
   "end": 72.96,
   "text": "انزل مراتب رو یعنی پایین‌ترین رتبه رو تو اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.96,
   "end": 78.96,
   "text": "حضرت جبرائیل داره بالاترین رتبه رو که دیگه می‌شه نزدیک‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.96,
   "end": 82.28,
   "text": "رتبه خلائق به صادر اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.28,
   "end": 84.2,
   "text": "یعنی دیگه چی بگم دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.2,
   "end": 90.12,
   "text": "مرتبه احدیت حضرت حق بگیرید که روح ما هم از اون جنسه و اون روح اعظم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.12,
   "end": 93.48,
   "text": "از اون مرتبه است. یعنی دیگه بالاترین مرتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.48,
   "end": 97.1,
   "text": "حالا بخواهیم راحت‌تر سخن بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.1,
   "end": 99.68,
   "text": "یعنی نزدیک‌ترین محل به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.68,
   "end": 102.7,
   "text": "چی بگم دیگه؟ به ذات حضرت حق، خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.7,
   "end": 109.18,
   "text": "حضرت روح از اونجا که اعلی مرتبه است میاد به انزل مراتب که دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.18,
   "end": 116.52,
   "text": "چرا؟ ما دیروز عرض کردیم که میج-- امام عصر عزیز ما اگر بحث فقط خودش بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.52,
   "end": 118.66,
   "text": "خ-خ-خود حضرت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.66,
   "end": 124.14,
   "text": "قرب فریضه می‌رفت بالا همان‌که شب‌های جمعه می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.14,
   "end": 126.86,
   "text": "اما اون‌ها نازل شدن به قرب نافله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.86,
   "end": 129.84,
   "text": "اینا فرقش در چیه؟ اتفاقاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.84,
   "end": 135.68,
   "text": "شرح فصوص قیصری علامه حسن زاده می‌فرمود اصل قرب فریضه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.68,
   "end": 137.3,
   "text": "قرب فریضه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.3,
   "end": 146.46,
   "text": "اگه در کتب و صحف نوریه عرفانیه و حکمت متعالیه دیدید یعنی این که تو زحمت بکش برو محضر حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.46,
   "end": 148.12,
   "text": "تو به عروج و صعود برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.12,
   "end": 154.4,
   "text": "تو به اعراج برو. منتظر نباش حضرت حق تنزل پیدا کنه بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.4,
   "end": 156.64,
   "text": "این اش-- این یعنی تو منتظر این نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.64,
   "end": 161.78,
   "text": "اون هم هست مثل \"انا انزلناه في ليلة القدر\" خود شب قدر دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.78,
   "end": 165.96,
   "text": "تنزل پیدا کرد. حق تنزل پیدا کرد که در دسترس ما قرار بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.96,
   "end": 172.84,
   "text": "اما اون اصل نیست. اون برای آدمای مثل ماها ضعیفیم، بنیه ضعیفی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.84,
   "end": 175.3,
   "text": "اما اصل قرب فریضه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.3,
   "end": 177.6,
   "text": "خودت تعالی پیدا کنی بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.6,
   "end": 182.22,
   "text": "چون غریب به اتفاق انسان‌ها نفس ناقصی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.22,
   "end": 185.3,
   "text": "نفس مستکفی داریم اصطلاحاً از جهات علمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.3,
   "end": 190.7,
   "text": "نه مکتفی. لذا مجبور شده حضرت روح تشریف بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.7,
   "end": 196.0,
   "text": "یه عنسی، مؤانستی بین نشئه طبیعت که انزل مراتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.0,
   "end": 199.7,
   "text": "با نشئ اون اعلی علیین که بالاترین مرتبه برقرار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.7,
   "end": 202.18,
   "text": "به یک عبارت خودمونی‌ش این می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.18,
   "end": 206.32,
   "text": "اومده ما رو از دنیا بکنه، از تعلقات بکنه، یه بویی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.32,
   "end": 211.1,
   "text": "عالم بالا از ملکوت به ما بخوره، یه رشحه‌ای، یه رایحه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.1,
   "end": 213.98,
   "text": "حضرت جالب که در درس صد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.98,
   "end": 216.26,
   "text": "دوازده شرح فصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.26,
   "end": 220.2,
   "text": "دیدم از تعالمه می‌فرمود از استادشون علامه شعرانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.2,
   "end": 225.52,
   "text": "که وقتی می‌خواست بدن رو مثال بزنه و صحبت کنه، بدن که انزل مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.52,
   "end": 227.42,
   "text": "نفس ناطقه ماست، می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.42,
   "end": 233.48,
   "text": "سه بار می‌گفت انزل، انزل، انزل مراتب وجودی نفس انسان بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.48,
   "end": 239.46,
   "text": "حالا اونم حضرت روح هم از اعلی علیین اومده نزول کرده اومده به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.46,
   "end": 244.06,
   "text": "به پست‌ترین فلسفی و نه اخلاقی، به پست‌ترین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.06,
   "end": 247.32,
   "text": "پایین‌ترین مرتبه که دنیاست که دست ما رو بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.32,
   "end": 249.36,
   "text": "بکشونه ببره به ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.36,
   "end": 251.52,
   "text": "که این باید از خود ما اتفاق می‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.52,
   "end": 253.12,
   "text": "چطور پیغمبر رفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.12,
   "end": 257.56,
   "text": "چطور امام ما رفت؟ اگر ما مأموم او هستیم چرا ما نریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.56,
   "end": 262.2,
   "text": "متأسفانه نقصه. که درستش اینه به قرب فریضه تو بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.2,
   "end": 264.2,
   "text": "اون موقع تو بشی یدالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.2,
   "end": 267.56,
   "text": "در قرب نافله وقتی حق نازل می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.56,
   "end": 269.56,
   "text": "چشم تو می‌شه چشم حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.56,
   "end": 272.2,
   "text": "یعنی ببخشید خدا می‌شه چشم تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 272.2,
   "end": 274.12,
   "text": "یعنی خدا با چشم تو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.12,
   "end": 277.08,
   "text": "فوقش. یه ولی خدا به جایی می‌رسه که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.08,
   "end": 278.84,
   "text": "با دست این گره باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 278.84,
   "end": 283.18,
   "text": "خدا با قوه خیال این صور، صور و اشکال ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.18,
   "end": 289.22,
   "text": "این می‌شه قرب نافله. اما قرب فریضه تو میری بالا، تو می‌شی یدالله مثل امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.22,
   "end": 292.24,
   "text": "دیگه یدالله می‌شه، عین الله می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 292.24,
   "end": 295.74,
   "text": "که در مورد ما اینطور نیست. لذا روح آمده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 295.74,
   "end": 299.94,
   "text": "به، به همه ملائکه دست ما رو بگیره ببره بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.94,
   "end": 305.7,
   "text": "و این نشون می‌ده چقدر دلبستنه به دنیا و توجه نکرده به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.7,
   "end": 314.28,
   "text": "زشته. تا جایی که سخن یه مورچه که قول داده بودم اینم بگم براتون از تفاسیر سخن یه مورچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.28,
   "end": 316.32,
   "text": "سلیمان نبی رو به خنده وامی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 316.32,
   "end": 323.3,
   "text": "قصه‌ش همینه. خدا رحمت کنه حضرت آیت الله آقای جلالی خمینی که نماینده ولی فقیه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.3,
   "end": 326.22,
   "text": "شرق تهران بودند. یه روز پاداش ایشون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 326.22,
   "end": 330.06,
   "text": "این روایتو دیدیم. بعد گشتیم پیداش کردیم، مأخذ و منبعشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.06,
   "end": 334.24,
   "text": "خلاصه در تفاسیر هم دیدیم. حالا تقدیم کنم ببینید چقدر شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.24,
   "end": 336.98,
   "text": "این آیه هجده و نوزده سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.98,
   "end": 342.38,
   "text": "نمل رو برید بخونید. می‌فرمود \"حتی اذا أتى على واد النمل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.38,
   "end": 345.96,
   "text": "وقتی که سلیمان رسید به وادی مورچه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.96,
   "end": 348.32,
   "text": "\"قالت نملة\" اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.32,
   "end": 351.04,
   "text": "فرمانده مورچه‌ها که بعد تو صحبتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.04,
   "end": 355.04,
   "text": "تو قصص الانبیا اومده. حالا مفصله من نمی‌خوام وقت‌تون رو بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.04,
   "end": 360.44,
   "text": "اونجا به سلیمان میگه تو این همه هرچی هم نمیدونم چیز داری مثلاً سلطنت داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.44,
   "end": 367.42,
   "text": "منم زیر این زمین چهار طبقه خدا در اختیارم گذاشته در هر طبقه یک وزیر دارم هر وزیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.42,
   "end": 374.8,
   "text": "ده تا زیردست داره هر کدوم از اون زیردست‌هاش چهار هزار سرباز دارن شروع کرد کُری خوندن برای حضرت سلیمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.8,
   "end": 377.54,
   "text": "خیلی شیرینه داستانش. حالا برید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.54,
   "end": 380.14,
   "text": "وقتی حضرت رسید به اینجا اِ-- سب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.14,
   "end": 382.14,
   "text": "آیه قرآن دارم براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.14,
   "end": 387.52,
   "text": "\"یا ایها النمل ادخلوا\" اون فرمانده‌ی کلشون گفت برید داخل لونه‌هاتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.52,
   "end": 389.32,
   "text": "\"مساکِنَکُم\". چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.32,
   "end": 393.66,
   "text": "\"لا يهْتَمَنَّکُم سلیمان وجنوده وهم لا يشعرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 393.66,
   "end": 395.86,
   "text": "اینا نمی‌دونن یهو شما رو پایمال می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.86,
   "end": 402.4,
   "text": "یعنی به شما تعدی می‌کنند. خب بعدش آیه بعد می‌فرماید \"فتَبَسَّمَ ضاحِکًا من قوله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.4,
   "end": 405.08,
   "text": "حضرت سلیمان خنده‌اش گرفت از این سخن مورچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.08,
   "end": 407.12,
   "text": "از چی سخن، از کدوم سخن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 407.12,
   "end": 410.3,
   "text": "از همین حرف؟ نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.3,
   "end": 415.86,
   "text": "امام صادق، امام باقر، امام رضا همه‌شون از قول پیغمبر فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.86,
   "end": 418.08,
   "text": "که سرّش چیه. وقتی که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.08,
   "end": 420.92,
   "text": "سلیمان خب داشته روی تخت و تا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.92,
   "end": 426.44,
   "text": "تختش که با حالا میگن فرش قالیچه سلیمان هرچی با سرعت باد می‌رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 426.44,
   "end": 429.16,
   "text": "صدا بهش می‌رسه که این مورچه اینو داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.16,
   "end": 431.8,
   "text": "میگه فرود بیا. دستور میده همونجا میره کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.8,
   "end": 435.04,
   "text": "مورچه رو صدا می‌کنه. میگه تو چی گفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.04,
   "end": 437.54,
   "text": "مگر من-- تو خبر نداری من پیغمبرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.54,
   "end": 440.66,
   "text": "چرا می‌دونم. مگه نمی‌دونی پیغمبر ظلم نمی‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 440.66,
   "end": 444.42,
   "text": "چرا می‌دونم. پس چرا به اینا گفتید برید تا مورد تعدی قرار نگیرید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 444.42,
   "end": 447.58,
   "text": "\"لا يهْتَمَنَّکُم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.58,
   "end": 450.76,
   "text": "چرا به اینا گفتی؟ پیغمبر هم چه عظمتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.76,
   "end": 452.64,
   "text": "جزئی‌ترین مسائل رو توجه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 452.64,
   "end": 455.1,
   "text": "حالا حرف جواب مورچه رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 455.1,
   "end": 462.04,
   "text": "گفت من به این مورچه‌ها گفتم برید توی لونه‌هاتون که این تاج و تخت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 462.04,
   "end": 464.62,
   "text": "نمی‌دونم عظمت تو رو نبینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.62,
   "end": 467.78,
   "text": "مبادا دلباخته‌ی به دنیا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.78,
   "end": 470.72,
   "text": "زر و سیم بشن. اینو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 470.72,
   "end": 474.72,
   "text": "عجب! چه حرف حکیمانه‌ای مورچه به سلیمان گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 474.72,
   "end": 477.28,
   "text": "که مبادا اینا دل فریفته‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.28,
   "end": 482.8,
   "text": "این تاج و تخت تو بشن. توجه به دنیا کنن، سرگرم کارهای وظایف خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 482.8,
   "end": 486.5,
   "text": "ببین این مورچه رو. این چجوری ما رو باز می‌داره از توجه به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 486.5,
   "end": 488.86,
   "text": "خدا رحمت کنه شیخ عباس تربتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 488.86,
   "end": 491.04,
   "text": "بارها گفتن رفتید ه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 491.04,
   "end": 493.86,
   "text": "صحن آزادی حرم امام رضا علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 493.86,
   "end": 499.68,
   "text": "انشاالله به زودی قسمتشو بریم. رو به حرم که وایسادید دست راستتون همون بغل ورودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 499.68,
   "end": 508.18,
   "text": "اِاِاِ قبرشه. پسرش می‌گفت مطلقا بازار که می‌رفتیم تو تهران نگاه به این مغازه‌ها، حجرا اینا مطلقا نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 508.18,
   "end": 511.16,
   "text": "گردنشم خشک شده بود دیگه تا آخر عمر اینطوری بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 511.16,
   "end": 515.34,
   "text": "می‌گفت آخه بابا چرا نگاه نمی‌کنی؟ می‌گفت می‌ترسم نگاه کنم دلم بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 515.34,
   "end": 517.2,
   "text": "چقدر ما به این دنیا توجه می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 517.2,
   "end": 520.92,
   "text": "رضا دلمون رفته. بعد حضرت سلیمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 520.92,
   "end": 523.0,
   "text": "صحبت کرد. حالا این صحبت طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 523.0,
   "end": 526.56,
   "text": "یه نکته‌شو می‌خوام بگم که مثلا مورچه گفت می‌دونی چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 526.56,
   "end": 529.66,
   "text": "چرا اسم تو، اسم تو سلیمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 529.66,
   "end": 532.16,
   "text": "یه حرف بیشتر از پدرت داووده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 532.16,
   "end": 534.46,
   "text": "داود. سلیمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 534.46,
   "end": 536.5,
   "text": "یه حرف سلیمان بیشتر از داود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 536.5,
   "end": 538.48,
   "text": "گفت این علمیه که من نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 538.48,
   "end": 544.14,
   "text": "سلیمان به مورچه گفت. مورچه گفت راست میگی خدا همه‌ی علمشو به همه نداده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 544.14,
   "end": 547.06,
   "text": "فرمود علتش اینه که دَواءُ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 547.06,
   "end": 549.42,
   "text": "دَاءُ الود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 549.42,
   "end": 551.54,
   "text": "دَاءُ الود شده داود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 551.54,
   "end": 554.76,
   "text": "یعنی یه ترک اولی کرد پدر داود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 554.76,
   "end": 557.08,
   "text": "یه دلش مریض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 557.08,
   "end": 561.56,
   "text": "زخم قلبی یعنی دلش جری-- جراحت پیدا کرد درون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 561.56,
   "end": 566.88,
   "text": "با ود یعنی محبت شدید با عشق تامش به خدا اینو جبران کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 566.88,
   "end": 570.56,
   "text": "تو این رو نداری. تو اسمت سلیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 570.56,
   "end": 573.44,
   "text": "سلیم یه الف اومده اضافه شده سلمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 573.44,
   "end": 577.28,
   "text": "سلیمان. سلیم یعنی سلامتی از ترک اولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.28,
   "end": 581.5,
   "text": "مورچه به سلیمان داره میگه بعد ما چقدر راحت با این جونورا و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 581.5,
   "end": 583.9,
   "text": "تا می‌کنیم. چقدر می‌کشیمشون فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 583.9,
   "end": 586.78,
   "text": "حالا این جمله آخرش نبض قصه اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 586.78,
   "end": 589.84,
   "text": "اینو گفت که حضرت سلیمان خندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 589.84,
   "end": 596.56,
   "text": "گفتش که مورچه. گفت سلیمان می‌دانید چرا باد صدای منو به گوش تو رسوند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 596.56,
   "end": 599.98,
   "text": "اینجا رو می‌خوام بگم. گفت نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 599.98,
   "end": 602.94,
   "text": "جالب حضرت سلیمان گفت این هم علمیه که من نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 602.94,
   "end": 609.68,
   "text": "چرا باد؟ برای همین بزرگواران گفتن هیچوقت مورچه رو نکشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 609.68,
   "end": 613.44,
   "text": "شش تا-- امیرالمؤمنین روایت کرده شش تا حیوونو گفته نکشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 613.44,
   "end": 616.04,
   "text": "یکیش مورچه است. میگن حکمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 616.04,
   "end": 619.62,
   "text": "عجب! قد علم کرده جلو سلیمان نبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 619.62,
   "end": 623.42,
   "text": "فرمود می‌دونید چرا باد؟ به جهت اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 623.42,
   "end": 625.4,
   "text": "خدا خواست به تو بگه سلیمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 625.4,
   "end": 629.52,
   "text": "دل به این تخت و تاجه نبند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 629.52,
   "end": 636.04,
   "text": "که به بادی بنده که اگر تمام این تخت و تاج و تمام سلطنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 636.04,
   "end": 639.6,
   "text": "عوالم هستی هم در خدمت و در اختیار تو بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 639.6,
   "end": 643.3,
   "text": "مثل یه باد می‌گذره تموم می‌شه میره دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 643.3,
   "end": 646.2,
   "text": "دنیا مثل باد می‌گذره تموم می‌شه میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 646.2,
   "end": 648.28,
   "text": "مدیر باشی، مدیر کل باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 648.28,
   "end": 650.76,
   "text": "ریاست سازمان، ریاست جمهور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 650.76,
   "end": 653.86,
   "text": "هرکی بخوای باشی یه عالم به اب-- تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 653.86,
   "end": 656.92,
   "text": "تموم. اونجا یه کفن بخواب که جای تو همین جاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 656.92,
   "end": 662.08,
   "text": "از این سخن قشنگ و شیرین سلیمان نبی خندید و تو قرآن آیه‌ش اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 662.08,
   "end": 664.52,
   "text": "یعنی حضرت روح خلاصه جمع‌بندی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 664.52,
   "end": 672.02,
   "text": "حضرت روح تشریف بیاره از اعلی علیین به انزل مراتب که دست من و تو رو بگیره از دنیا بکنمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 672.02,
   "end": 673.86,
   "text": "یه ذره روحانیمون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 673.86,
   "end": 677.86,
   "text": "این از درون مایه های ماه مبارک رمضان و شب قدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 677.86,
   "end": 682.22,
   "text": "انشاالله عاقبتمون رو ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 682.22,
   "end": 687.78,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}