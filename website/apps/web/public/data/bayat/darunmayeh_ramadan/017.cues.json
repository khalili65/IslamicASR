   "start": 597.79,
   "end": 1016.81
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.86,
   "end": 5.48,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.48,
   "end": 9.0,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.0,
   "end": 12.24,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.24,
   "end": 16.9,
   "text": "بحثی که در درون مایه ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.9,
   "end": 21.56,
   "text": "جا مونده بود رو عرض کنم. خیلی به درد بخوره در خصوص نزول روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.56,
   "end": 26.9,
   "text": "ببینید اونجایی که خداوند متعال با شیطان سخن میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.9,
   "end": 29.26,
   "text": "از تکبرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.26,
   "end": 30.86,
   "text": "آیا تو استکبار ورزیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.86,
   "end": 33.08,
   "text": "تکبر کردی؟ ام کنت من العالین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.08,
   "end": 36.04,
   "text": "تو آیه قرآن اومده. حالا یادم نیست کدوم آیه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.04,
   "end": 40.82,
   "text": "که یا تو تکبر کردی سجده نکردی یا از عالین بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.82,
   "end": 48.2,
   "text": "حالا این عالین رو بعضی از مفسرین طبق روایت فرمودن وجود مقدس اهل بیت علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.2,
   "end": 54.58,
   "text": "بعضی هم فرمودن نه اشاره دارد به ملائکه عالین یا کروبین یا همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.58,
   "end": 57.86,
   "text": "ملائکه مکرمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.86,
   "end": 62.94,
   "text": "مقربین یا ملائکه‌ای که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.94,
   "end": 66.68,
   "text": "مرتبه عالیه نظام واقع شدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.68,
   "end": 73.6,
   "text": "مهیمین‌اند. خبر فقط از حضرت حق دارند و کثرات رو هم شعون حق می‌بینند و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.6,
   "end": 77.14,
   "text": "که عرض شد اون بالاترین مرتبه‌اش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.14,
   "end": 80.48,
   "text": "در اون اعلی مرتبه حضرت روح قرار داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.48,
   "end": 83.4,
   "text": "روح اعظم که تنزل الملائکۃ والروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.4,
   "end": 87.1,
   "text": "که مرتبه مادون و پایین‌ترین حدش میشه جبرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.1,
   "end": 93.86,
   "text": "حالا بحث ما اینه که ببینید حضرت روح وقتی نازل میشه از اعلی مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.86,
   "end": 95.84,
   "text": "میاد. خب این اون اعلی مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.84,
   "end": 98.08,
   "text": "مرتبه اجمال دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.08,
   "end": 100.9,
   "text": "اجمال حقایقه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.9,
   "end": 105.38,
   "text": "به نحو بساطت همه حقایق جمع در اون هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.38,
   "end": 110.6,
   "text": "خب اون میاد، میاد در مرتبه ادنا میاد تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.6,
   "end": 113.38,
   "text": "مرتبه قلب و تفصیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.38,
   "end": 115.8,
   "text": "قلب تفصیل روح چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.8,
   "end": 120.82,
   "text": "اجماله. در مرتبه تفصیل که بتونه به ربوبیت بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.82,
   "end": 125.5,
   "text": "حالا بحث ربوبیت خودش بحث خیلی مهمیه که یه جلسه باید درباره‌اش سخن بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.5,
   "end": 131.68,
   "text": "و ارتباطش با شب قدر و ماه مبارک رمضان و حضرت زهرا سلام الله علیه و پروراندن این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.68,
   "end": 139.12,
   "text": "و به تبعش بعد از عید فطر پروراندن ماه‌های بعد در دل این ماه که حالا بحثش میاد انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.12,
   "end": 146.58,
   "text": "خب ببینید نزول روح اعظم میتونه خودش وقتی اینطوری نگاه می‌کنی دلالتی بکنه بر دعوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.58,
   "end": 148.64,
   "text": "کثرات به وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.64,
   "end": 151.56,
   "text": "یعنی دعوت کثرت به وحدت داره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.56,
   "end": 156.66,
   "text": "چرا که روح مربوط به مرتبه احدی و اجمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.66,
   "end": 159.78,
   "text": "مقام جمعی داره. میاد به مرتبه مادون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.78,
   "end": 162.92,
   "text": "مرتبه کثرت و تفصیل و قلب و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.92,
   "end": 165.24,
   "text": "که حالا به یک معنا قلب نبی اکرم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.24,
   "end": 169.14,
   "text": "این‌ها و امام حسن صلوات الله علیه فرمود چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.14,
   "end": 175.62,
   "text": "قلب مقدس پیغمبر أوسع قلوب بود قرآن برش نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.62,
   "end": 182.8,
   "text": "و پس اینجا میشه عرض کرد یکی از درون مایه های این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.8,
   "end": 185.32,
   "text": "تجمع اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.32,
   "end": 187.74,
   "text": "گرد سفره حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.74,
   "end": 191.68,
   "text": "این تجلی یکی از تجلیات در میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.68,
   "end": 195.68,
   "text": "اهل صفوف اهل ایمان است. ببینید جماعت اهل ایمان چقدر شکل میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.68,
   "end": 199.04,
   "text": "مساجد شلوغ‌ترند. اینجا ببینید الان تعدادتون همیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.04,
   "end": 202.52,
   "text": "از پیش از ماه مبارک رمضان هر روز شلوغ‌تر بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.52,
   "end": 206.54,
   "text": "و علتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.54,
   "end": 208.96,
   "text": "دعوت وحدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.96,
   "end": 211.0,
   "text": "از کثرت به وحدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.0,
   "end": 214.16,
   "text": "اون مرتبه عالی از دانی دعوت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.16,
   "end": 217.44,
   "text": "در شب قدر به اوج میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.44,
   "end": 219.62,
   "text": "به این شکل که حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.62,
   "end": 224.82,
   "text": "همینم یک-- همین یک راه هم پیش نیست که این مرتبه تجمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.82,
   "end": 227.18,
   "text": "ید الله فوق أیدیهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.18,
   "end": 231.68,
   "text": "یا کلمة الله العلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.68,
   "end": 235.12,
   "text": "اون کلمه‌ی الله عالی‌ترینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.12,
   "end": 238.56,
   "text": "این‌ها هم مرتبه جمعی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.56,
   "end": 242.32,
   "text": "اینا همه یک معنا داره که راه مستقیمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.32,
   "end": 245.56,
   "text": "و بقیه راه‌هاییه که یا منحرفن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.56,
   "end": 248.44,
   "text": "قرار هست ما رو به صراط مستقیم برسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.44,
   "end": 252.12,
   "text": "اما در هر حال این رو می‌خواستم عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.12,
   "end": 253.9,
   "text": "دعوت کثرت به وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.9,
   "end": 258.76,
   "text": "اتفاقاً یه آیه‌ای در قرآن هست، آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.76,
   "end": 260.42,
   "text": "صد و پنجاه و سه انعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.42,
   "end": 263.34,
   "text": "برید ببینید که می‌فرمود إن هذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.34,
   "end": 269.56,
   "text": "صراطي مستقيما فاتبعوه ولا تتبعوا السبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.56,
   "end": 272.34,
   "text": "فتفرق بكم عن سبيله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.34,
   "end": 275.32,
   "text": "ذلكم وصاكم به لعلكم تتقون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 275.32,
   "end": 277.72,
   "text": "می‌خواد بلکه شما با تقوا باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.72,
   "end": 283.76,
   "text": "حالا در بحث تقوا ارتباطش با ماه رمضان خودش یک نکته‌اش که بهش نمی‌رسیم متأسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.76,
   "end": 287.16,
   "text": "که بلکه شما اهل تقوا بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 287.16,
   "end": 288.78,
   "text": "این وصیت ما به شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 288.78,
   "end": 293.42,
   "text": "چی؟ هذا صراطي مستقيما فاتبعوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.42,
   "end": 297.1,
   "text": "اینجا میگه این صراط مستقیم همون ملئ-- همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 297.1,
   "end": 302.1,
   "text": "موضوع وحدت، حرکت از کثرت به سمت وحدت، صراط مستقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.1,
   "end": 305.82,
   "text": "یک راه بیش نیست. حرکت از کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 305.82,
   "end": 307.96,
   "text": "به وحدت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 307.96,
   "end": 310.68,
   "text": "قوس صعود و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.68,
   "end": 315.22,
   "text": "ثم يعرج الیه اینا والیه ترجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.22,
   "end": 320.3,
   "text": "و جالب که بعدش می‌فرماید تو همین آیه ولا تتبعوا السبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 320.3,
   "end": 322.52,
   "text": "تبعیت نکنید از اون راه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 322.52,
   "end": 327.74,
   "text": "اتفاقاً مرحوم طبرسی علیه رحمة در تفسیر شریف مجمع البیانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.74,
   "end": 332.04,
   "text": "ذیل همین آیه روایتی از پیغمبر عظیم الشأن اسلام میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.04,
   "end": 338.42,
   "text": "که پیغمبر عزیز عالم در بین صحابه یه دو خط، دو تا نقطه ترسیم فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 338.42,
   "end": 341.78,
   "text": "از نقطه اول به نقطه دوم یک خط مستقیم کشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 341.78,
   "end": 345.86,
   "text": "بعد خطوط دیگری رو همینطور انحنا دادن، انحراف دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.86,
   "end": 347.94,
   "text": "از نقطه اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.94,
   "end": 351.26,
   "text": "کشیدن قوسی شکل به نقطه دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 351.26,
   "end": 358.28,
   "text": "از یمین و یسار. بعد فرمودند که یمین و یسار موله والوسطه هي الجاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 358.28,
   "end": 360.04,
   "text": "وتفرق بكم عن سبيله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 360.04,
   "end": 363.33,
   "text": "حالا که اشاره داره به همون آیه‌ای که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 363.33,
   "end": 369.95,
   "text": "که این، اه پیغمبر می‌فرماد که این ا-- این صراط مستقیم یه دونه بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.95,
   "end": 373.53,
   "text": "یک خط مستقیم بیشتر از این نقطه به اون نقطه نمیشه کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.53,
   "end": 377.35,
   "text": "بقیه اعوجاج دارن، انحراف دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.35,
   "end": 380.71,
   "text": "از یمین و یسار. اینا لذا قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.71,
   "end": 383.47,
   "text": "می‌فرماید \"إن الدين عند الله الإسلام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.47,
   "end": 385.75,
   "text": "دین نزد خدا یک دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 385.75,
   "end": 390.89,
   "text": "اسلام تمام و \"لا نفرق بین أحد من رسله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 390.89,
   "end": 393.41,
   "text": "اینا بین رسولان هم هیچ نه-- فرقی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 393.41,
   "end": 395.71,
   "text": "چرا؟ همه مسلمون بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 395.71,
   "end": 399.27,
   "text": "پ-- حضرت ابراهیم می‌فرماد که عرض می‌کنه به خدا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 399.27,
   "end": 404.45,
   "text": "\"إني وجهت وجهي لله الذي fatra السماوات والأرض حنيفا مسلما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 404.45,
   "end": 406.11,
   "text": "و أنا و ما أنا من المشركين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 406.11,
   "end": 408.43,
   "text": "همه مسلمون بودن لکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 408.43,
   "end": 413.21,
   "text": "اون اسلام بخشی از اسلام بود، نه همه اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 413.21,
   "end": 416.01,
   "text": "همه اسلام نبود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 416.01,
   "end": 418.43,
   "text": "لذا مقام جمعی نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 418.43,
   "end": 423.19,
   "text": "اسلام اون‌ها، دین اون‌ها مقام جمعی نداشت، بخشی از اسلام بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 423.19,
   "end": 429.55,
   "text": "دین اسلام است که یعنی پیغمبر عزیز عالم است که اون مقام اتم جمعی رو دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 429.55,
   "end": 431.95,
   "text": "لذا کتابش و دینش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.95,
   "end": 433.89,
   "text": "مقام اتم جمعی رو دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 433.89,
   "end": 438.27,
   "text": "\"اهدنا صراط المستقيم\" باز بحث جمع است و جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 438.27,
   "end": 440.47,
   "text": "و دعوت از کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 440.47,
   "end": 443.09,
   "text": "به وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 443.09,
   "end": 447.33,
   "text": "و شما وقتی ابت-- اتفاقا اون ابتدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 447.33,
   "end": 449.87,
   "text": "شروع خطبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 449.87,
   "end": 453.85,
   "text": "ابن عربی در فصوص رو که ببینید اینطوری شروع می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 453.85,
   "end": 459.39,
   "text": "چقدر عظمت داره این خطبه که حضرت استاد علامه حسن زاده چندین جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 459.39,
   "end": 463.67,
   "text": "پیرامون شرح همین جمله اول سخن گفتند که \"الحمد لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 463.67,
   "end": 469.03,
   "text": "منزل الحکم\". که حالا چرا اینجا منزل نه منزل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 469.03,
   "end": 471.99,
   "text": "حکم چرا؟ جمع چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 471.99,
   "end": 475.27,
   "text": "حکمت نه حکم جمع حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 475.27,
   "end": 477.97,
   "text": "و چرا حکمت؟ نه علم، نه معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 477.97,
   "end": 480.15,
   "text": "اونم \"على قلوب الکلم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 480.15,
   "end": 483.65,
   "text": "و چرا کلم؟ جمع کلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 483.65,
   "end": 488.07,
   "text": "کلمه که مثلا قرآن به حضرت عیسی می‌فرماید کلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 488.07,
   "end": 496.81,
   "text": "که اشاره دارد به قول حضرت استاد علامه حسن زاده اشاره دارد این کلمه گفتن به حضرت عیسی در قرآن به مقام روح او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 496.81,
   "end": 502.23,
   "text": "به مقام روح او. حالا اینا روح باز مرتبه احدیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 502.23,
   "end": 506.75,
   "text": "به احد بعد به ادامه خطبه‌ش رو ببینید \"على قلوب الکلم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 506.75,
   "end": 510.13,
   "text": "به احدیت طریق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 510.13,
   "end": 513.25,
   "text": "الأمم. ام ببینید الح-- یه بار دیگه می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.25,
   "end": 520.59,
   "text": "\"الحمد لله منزل الحکم على قلوب الکلم باحدیت طریق الأمم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 520.59,
   "end": 524.51,
   "text": "من المقام الأقدم و إن اختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 524.51,
   "end": 527.33,
   "text": "النحل و الملل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 527.33,
   "end": 531.17,
   "text": "لاختلاف الأمم\" که حالا این، اینم باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 531.17,
   "end": 534.27,
   "text": "در، در واقع داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 534.27,
   "end": 537.41,
   "text": "ااا اون میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 537.41,
   "end": 543.73,
   "text": "تنزل حکمت رو که جمع بین علم و عمل بود رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 543.73,
   "end": 546.25,
   "text": "بر قلوب که مقام تفصیله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 546.25,
   "end": 549.07,
   "text": "قلوب کی؟ ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.07,
   "end": 553.75,
   "text": "اگر یادتون باشه اون آیه که یک بار تلاوت کردیم تو جمعتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 553.75,
   "end": 557.03,
   "text": "ااا \"الکلم الطيب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 557.03,
   "end": 560.03,
   "text": "إليه يسعى الكلم الطيب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.03,
   "end": 561.81,
   "text": "به سمت خدا صعود می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 561.81,
   "end": 564.39,
   "text": "کلمه طيب که فرمودن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 564.39,
   "end": 567.53,
   "text": "روح مؤمنه. کلمه طيب باز اشاره به چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 567.53,
   "end": 571.07,
   "text": "روح مؤمن. این الكلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 571.07,
   "end": 575.35,
   "text": "ااا و البته \"والعمل الصالح يرفعه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 575.35,
   "end": 580.29,
   "text": "عمل صالح بالا می‌بره اینو که انسان مجموعه‌ایست از علم و عملش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 580.29,
   "end": 582.59,
   "text": "باز اینجا هم تصریح داره بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 582.59,
   "end": 587.55,
   "text": "مقام جمعی. یعنی اون مقام جمعی، اون کلمه، اون روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.55,
   "end": 590.35,
   "text": "میاد ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 590.35,
   "end": 594.67,
   "text": "در مقام قلب که تفصیل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 594.67,
   "end": 598.47,
   "text": "تنزل پیدا می‌کنه که رو-- ارتباط بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 598.47,
   "end": 602.79,
   "text": "مقام تفصیل و اجمال، ال-التباط بین قلب و روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 602.79,
   "end": 608.97,
   "text": "برقرار بشه. لذا روح انسان‌ها در ماه مبارک رمضان یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 608.97,
   "end": 611.61,
   "text": "انقلابی، تقلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 611.61,
   "end": 615.49,
   "text": "یا بهتره بگیم یک ارتفاعی پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 615.49,
   "end": 619.57,
   "text": "در خصوص قلب بهتره بگیم تقلب و انقلاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 619.57,
   "end": 622.45,
   "text": "رخ میده که اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 622.45,
   "end": 625.95,
   "text": "روح در قلب میشه تقلب قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 625.95,
   "end": 629.53,
   "text": "اثر عرض شود اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 629.53,
   "end": 632.91,
   "text": "مرتبه مادون روح که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 632.91,
   "end": 636.75,
   "text": "به یک معنا صادر اول و صادر نخستین است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 636.75,
   "end": 638.33,
   "text": "در روح میشه ارتفاع روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 638.33,
   "end": 642.27,
   "text": "حالا اون صادر نخستین هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 642.27,
   "end": 648.77,
   "text": "ااا که حدود صد تا اسم داره قبلا درباره‌ش بحث کردیم که \"اللهم غير سوء حالنا بحسن حالک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 648.77,
   "end": 654.41,
   "text": "یادمه که فکر می‌کنم در فتوحات بود حضرت ابن عربی علیه الرحمة این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 654.41,
   "end": 658.51,
   "text": "حسن حال خدا رو می‌فرمود همون حال صادر نخستین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 658.51,
   "end": 661.97,
   "text": "یعنی حال حقیقت محمدیه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 661.97,
   "end": 665.71,
   "text": "که در قوس سعود ایشون اتصال و ارتباط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 665.71,
   "end": 668.57,
   "text": "ااا اتحاد وجودی با ایشون برقرار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 668.57,
   "end": 672.15,
   "text": "پس حواسمون جمع باشه که ما از کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 672.15,
   "end": 677.37,
   "text": "باید به وحدت سفر کنیم. ماه، ماه این هجرت و این سفره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 677.37,
   "end": 680.39,
   "text": "لذا \"والذین آمنوا هاجروا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 680.39,
   "end": 683.21,
   "text": "وجاهدوا\" حالا اینا سه تا با هم آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 683.21,
   "end": 685.47,
   "text": "جهاد، هجرت، ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 685.47,
   "end": 690.19,
   "text": "اتفاقا فلسفه امتیاز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 690.19,
   "end": 692.61,
   "text": "بزرگان، شهدا اینا با امثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 692.61,
   "end": 700.01,
   "text": "من و اینها همینه. که این‌ها هجرت کردن، جهاد کردن، ایمان آوردن، دل سپردن، رفتن، حرکت کردن از کثرت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 700.01,
   "end": 702.83,
   "text": "کجا؟ وحدت. که اتفاقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 702.83,
   "end": 706.57,
   "text": "در یکی از کلمات حالا عددش یادم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 706.57,
   "end": 709.47,
   "text": "کلمات هزار و یک کلمه حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 709.47,
   "end": 711.79,
   "text": "می‌فرمودن از امام به حق ناطق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 711.79,
   "end": 718.19,
   "text": "کشاف حقایق امام صادق علیه السلام یه حدیثی آورده بودن اونجا که \"العارف شخصه مع الخلائق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 718.19,
   "end": 724.33,
   "text": "شخص عارف با خلائق بدنش، تنش، جسمش تو خلا ظاهرش بین مردمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 724.33,
   "end": 726.51,
   "text": "و قلبهم مع الله تعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 726.51,
   "end": 730.15,
   "text": "اما دلش معیت داره به الله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 730.15,
   "end": 732.65,
   "text": "که کن فی الناس ولا تكن معهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 732.65,
   "end": 736.87,
   "text": "حالا این دیگه میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 736.87,
   "end": 740.27,
   "text": "هنر شهدا همین بود که از این کثرت رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 740.27,
   "end": 743.93,
   "text": "و انس با خدای حی حاضر نه با ا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 743.93,
   "end": 747.77,
   "text": "انس گرفتن با خدا، نه آگاهی از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 747.77,
   "end": 754.25,
   "text": "یعنی دقت بفرمایید نه آگاه بشن، علم لفظی و فکری پیدا کنن و یه مشت اصطلاح حفظ کنن، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 754.25,
   "end": 756.83,
   "text": "انس گرفتن. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 756.83,
   "end": 761.55,
   "text": "فصوص و کتب عرفانی و صحف نوریه عرفانی این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 761.55,
   "end": 764.95,
   "text": "اصلاً دستورالعمل حرکت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 764.95,
   "end": 768.91,
   "text": "از ظاهر به باطنه، دستورالعمل سیر عرفانی ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 768.91,
   "end": 772.29,
   "text": "حرکت ما از کثرت به وحدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 772.29,
   "end": 775.17,
   "text": "اینه که حضرت امام علیه رحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 775.17,
   "end": 778.41,
   "text": "مثلاً در نامه‌ش به گورباچف بارها عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 778.41,
   "end": 782.61,
   "text": "اونها رو دعوت کرد به حکمت و کتب صدراایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 782.61,
   "end": 785.99,
   "text": "و کتب ابن عربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 785.99,
   "end": 788.01,
   "text": "این‌ها علتش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 788.01,
   "end": 790.73,
   "text": "چون بهترین راه برون رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 790.73,
   "end": 793.99,
   "text": "از مدرنیته، از این pluralism و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 793.99,
   "end": 796.83,
   "text": "تکثرگرایی و چه و چه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 796.83,
   "end": 802.01,
   "text": "این‌ها مدرنیته و لیبرالیسم و ماده‌گرا اینا اینا بهترین راه عبور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 802.01,
   "end": 806.61,
   "text": "از همه این کثرات به وحدت، به اون وحدت محضه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 806.61,
   "end": 810.17,
   "text": "وحدت شخصیه‌ی الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 810.17,
   "end": 812.25,
   "text": "که قبلاً عرض کردیم ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 812.25,
   "end": 814.87,
   "text": "چی بود؟ مظاهر در سه و ضیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 814.87,
   "end": 819.81,
   "text": "همه عوالم هستی مظاهر او هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 819.81,
   "end": 823.79,
   "text": "در سه و ضیق نسبت به ظرفیت و قابلیتشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 823.79,
   "end": 826.73,
   "text": "این‌ها بهترین راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 826.73,
   "end": 828.97,
   "text": "عبور از این مدرنیته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 828.97,
   "end": 832.19,
   "text": "از فرهنگ غلط مدرنیته در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 832.19,
   "end": 836.81,
   "text": "معاصر ما نسبت به طاقت بشری همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 836.81,
   "end": 839.89,
   "text": "صحف عرفانی است. لذا امام اونها رو دعوت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 839.89,
   "end": 842.71,
   "text": "شهدا هم همین کار رو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 842.71,
   "end": 845.61,
   "text": "و میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 845.61,
   "end": 851.07,
   "text": "امثال مرتضی آوینی‌ها، قاسم سلیمانی‌ها، نادر طالب‌زاده‌ها و چه و چه این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 851.07,
   "end": 856.97,
   "text": "این‌ها عرفان رو پیدا کردن که راهی بود برای انس با خدا، خلوت با خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 856.97,
   "end": 860.03,
   "text": "حرکت از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 860.03,
   "end": 861.97,
   "text": "از شود کثرت به سمت وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 861.97,
   "end": 867.49,
   "text": "این در ماه مبارک رمضان دیگه به اوج میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 867.49,
   "end": 875.47,
   "text": "و این عرفان، این نوع عرفان وقتی نگاه می‌کنید به این نوع عرفان دیگه می‌بینید انزوا درش نیست بلکه عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 875.47,
   "end": 877.43,
   "text": "وحدت در عین کثرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 877.43,
   "end": 881.21,
   "text": "یعنی از عین کثرت حرکت می‌کنه به وحدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 881.21,
   "end": 884.57,
   "text": "و توجه به ناسوت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 884.57,
   "end": 890.03,
   "text": "اینجا متوجه ناسوت هست اما توجه تامش به حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 890.03,
   "end": 897.99,
   "text": "حالا اون آیات مثل، مثل آیه هفتاد و پنج انعام رو ببینید \"وکذلک نری ابراهیم ملكوت السماوات والأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 897.99,
   "end": 904.53,
   "text": "ما این چنین به آ-- ابراهیم ملکوت باطن آسمانها و زمین رو نشون دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 904.53,
   "end": 913.35,
   "text": "یا سوره هشت-- سوره یاسین آیه آخر، آیه هشتاد و سه \"فسبحان الذي بيده ملكوت کل شيء والیه ترجعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 913.35,
   "end": 915.09,
   "text": "بيده ملكوت کل شيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 915.09,
   "end": 918.45,
   "text": "ملکوت همه چیز من جمله شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 918.45,
   "end": 922.65,
   "text": "آسمان‌ها، زمین، این‌ها همه بيده، به دست حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 922.65,
   "end": 925.13,
   "text": "باطن اونجاست. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 925.13,
   "end": 932.43,
   "text": "انسان می‌تونه ابراهیم‌وار به جایگاه ملکوتی اشیا که وجهه الهیت اون‌ها یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 932.43,
   "end": 935.45,
   "text": "وجه الهی اشیاست بنگره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 935.45,
   "end": 938.75,
   "text": "و در میدان عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 938.75,
   "end": 944.99,
   "text": "به اون olomi که اخذ کرده عمل به اون علوم برسه به اون وحدت جمعیه، به اون ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 944.99,
   "end": 948.79,
   "text": "لذا آقای بهجت اینجا سرش داره آشکار میشه در دل بحثمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 948.79,
   "end": 951.71,
   "text": "آقای بهجت همیشه سفارش داشتن روحشون شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 951.71,
   "end": 954.25,
   "text": "هر وقت خدمتشون می‌رفتیم، دیگران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 954.25,
   "end": 959.93,
   "text": "ایشون سفارششون به اونچه که علم داری عمل کن تا خدا به تو تعلیم بده olomi که بلد نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 959.93,
   "end": 962.53,
   "text": "یعنی چی تعلیم بده؟ از درون می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 962.53,
   "end": 967.83,
   "text": "از ملکوت میاد. اون مقام پرورش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 967.83,
   "end": 971.33,
   "text": "اون اجمال میاد به تفصیل، روح میاد کمک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 971.33,
   "end": 978.79,
   "text": "قلب و تو رو به وساطت حضرت صدیقه طاهره سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 978.79,
   "end": 981.99,
   "text": "حرکت میدن. حرکت نفستو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 981.99,
   "end": 987.15,
   "text": "از نقص به کمال، از ضعف به شدت، از مجهول به معلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 987.15,
   "end": 990.57,
   "text": "و این همان معنای اشتداد وجودیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 990.57,
   "end": 992.33,
   "text": "شدت وجودی پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 992.33,
   "end": 994.91,
   "text": "ببینید چه، چقدر درون مایه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 994.91,
   "end": 998.49,
   "text": "امروز یه مقدار بیشتر صحبت کردیم. ببخشید چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 998.49,
   "end": 1005.07,
   "text": "به هر حال فردا هم تعطیل هستید و ان شا الله که خدای منان از هممون این قلیل رو بپذیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1005.07,
   "end": 1007.83,
   "text": "و عاقبتمون به برکت همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1007.83,
   "end": 1012.11,
   "text": "کلمات نورانی ختم به خیر بشه ان شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1012.11,
   "end": 1016.81,
   "text": "صلوات. اللهم صل على محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}