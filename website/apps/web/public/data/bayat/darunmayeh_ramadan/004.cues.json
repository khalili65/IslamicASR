 },
 "chapters": [
  {
   "index": 0,
   "title": "## نزول ملائکه در رمضان و گشودن ملکوت",
   "start": 11.06,
   "end": 47.28
  },
  {
   "index": 1,
   "title": "## حدیث المحجة البیضاء؛ شیاطین گرد دل و بسته شدن ملکوت",
   "start": 47.28,
   "end": 67.34
  },
  {
   "index": 2,
   "title": "## نبوت انبایی، الهام اولیا، تعلیم علما",
   "start": 67.34,
   "end": 120.72
  },
  {
   "index": 3,
   "title": "## فاقد شیء نمی‌تواند معطی باشد؛ حلقۀ تعلیم",
   "start": 120.72,
   "end": 255.22
  },
  {
   "index": 4,
   "title": "## ابراهیم/۱؛ مخرج پیامبر با قرآن و وساطت ملائکه",
   "start": 255.22,
   "end": 533.84
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.32,
   "end": 4.92,
   "text": "به نستعین. السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.92,
   "end": 7.06,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.06,
   "end": 10.02,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.02,
   "end": 14.14,
   "text": "بحث ما این بود که در ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.14,
   "end": 19.26,
   "text": "قطعاً نزول ملائکه بیش از ماه‌های پیش است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.26,
   "end": 25.88,
   "text": "لذا دستیابی ما به ملکوت و فهم و چشیدن حقایق بهتر و بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.88,
   "end": 28.38,
   "text": "اتفاق می‌افته از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.38,
   "end": 31.86,
   "text": "الهامات، القاءات و تعلیماتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.86,
   "end": 36.44,
   "text": "خدا به واسطه‌ی ملائکه به ما می‌رسونه غافل نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.44,
   "end": 40.56,
   "text": "شاید بعضیا سندی بر این موضوع می‌خواستن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.56,
   "end": 43.0,
   "text": "حالا ارتباط با ملکوت و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.0,
   "end": 47.14,
   "text": "اصلاً امکانش هست و نیست و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.14,
   "end": 50.38,
   "text": "یه حدیثی که قبلاً در بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.38,
   "end": 54.36,
   "text": "فکر می‌کنم منزل بود اینجا مورد بحث قرار داده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.36,
   "end": 57.4,
   "text": "دو مرتبه براتون می‌خونم. این فرمایش پیغمبره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.4,
   "end": 63.0,
   "text": "حرف من نیست. المحجه البيضه، جلد دو، صفحه صد و بیست و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.0,
   "end": 65.34,
   "text": "ببینید عجب حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.34,
   "end": 69.56,
   "text": "پر مغز و در اون مایه‌ی بسیار عظیمی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.56,
   "end": 72.7,
   "text": "می‌فرماید که \"لولا ان الشياطين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.7,
   "end": 75.8,
   "text": "يحمون على قلوب بني آدم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.8,
   "end": 79.24,
   "text": "اگه اینطور نبود که شیاطین گرداگرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.24,
   "end": 83.02,
   "text": "دل‌های مردم می‌گردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.02,
   "end": 87.74,
   "text": "اگر شیطان فرود نمی‌اومد، وارد نمی‌شد بر دل‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.74,
   "end": 93.8,
   "text": "چه اتفاقی می‌افتاد؟ \"لنذروا الى ملكوت السماء\" لام، اون لام تأکیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.8,
   "end": 99.3,
   "text": "قطعاً این‌ها مردم، همه مردم، همه آدم، عامه، همین بنی‌آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.3,
   "end": 104.96,
   "text": "نظر می‌انداختن یعنی نگاه می‌کردن ملکوت آسمان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.96,
   "end": 107.28,
   "text": "مشکل چیه که نمی‌تونیم نگاه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.28,
   "end": 110.26,
   "text": "پیغمبر داره می‌فرماید، رمزگشایی پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.26,
   "end": 113.5,
   "text": "آقا شیاطین وارد شدن به دل‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.5,
   "end": 120.6,
   "text": "ما اون روز عرض کردیم که اگر ما غافل بشیم از نزول ملائک، ملک بر قلبمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.6,
   "end": 128.32,
   "text": "که در ثقل نفس ما اون تمثلاتی که از حقایق رخ می‌ده، اون چیزی که ما می‌چشیم، می‌رسیم، می‌فهمیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.32,
   "end": 130.28,
   "text": "درک می‌کنیم در درون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.28,
   "end": 132.64,
   "text": "اون کمون ذات خودمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.64,
   "end": 136.64,
   "text": "اون نزول ملکه. وقتی اینو پس بزنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.64,
   "end": 140.48,
   "text": "دنبال فهم و چشیدن و درک و این‌ها نری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.48,
   "end": 144.3,
   "text": "نخوای اونچه که خدا داره به تو تعلیم می‌ده رو اخذ کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.3,
   "end": 148.06,
   "text": "پشت پا بزنی به این تعلیمات، شیاطین میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.06,
   "end": 151.12,
   "text": "شیاطین که اومدن چشمتو از ملکوت باز می‌مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.12,
   "end": 153.26,
   "text": "این فرمایش صریح پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.26,
   "end": 158.26,
   "text": "اتفاقاً در این ماه به جهت تنزل الملائکه والروح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.26,
   "end": 160.46,
   "text": "ارتباط با ملکوت شدت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.46,
   "end": 163.0,
   "text": "یعنی چی ارتباط با ملکوت شدت می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.0,
   "end": 166.38,
   "text": "یعنی ارتباط با ملائکه شدت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 166.38,
   "end": 170.86,
   "text": "اصلاً دائماً ملائکه در حال تنزل‌اند بر ما خصوصاً در این ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 170.86,
   "end": 177.8,
   "text": "حالا در اون مایه‌ی ماه مبارک رمضان به قدریست که ما کل سی روزو بخوایم حرف بزنیم بازم کم میاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.8,
   "end": 181.6,
   "text": "اما حالا یکی دو نکته‌شو ما می‌خوایم یه ذره باز کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.6,
   "end": 183.84,
   "text": "ببینید من مثال می‌زنم. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.84,
   "end": 187.38,
   "text": "عرض کردیم در اِاِاِ اون نبوت انبایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.38,
   "end": 193.26,
   "text": "نه تشریعی، نبوت انبایی یعنی خبر شدن از حقایق عالم که ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.26,
   "end": 196.4,
   "text": "واسطه‌ی فیض حضرت حق به من و شما می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.4,
   "end": 198.8,
   "text": "این راهش برای همه، همه ما بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.8,
   "end": 202.76,
   "text": "بله به نحو ایحاء یعنی وحی فقط مخصوص انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.76,
   "end": 205.36,
   "text": "اونم نه، وحی تشریعی. تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.36,
   "end": 209.62,
   "text": "به نحو الهام برای اولیاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.62,
   "end": 215.7,
   "text": "خب شما می‌تونی ولی الله بشی باز راهش بسته نیست و به نحو تعلیم برای علمائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.7,
   "end": 219.34,
   "text": "بالاخره اخذ علم می‌کنی، از کجا اخذ می‌کنی این رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.34,
   "end": 224.78,
   "text": "علم شما یاد می‌گیری الان اینجا این مجلس الان بین نماز مغرب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.78,
   "end": 227.08,
   "text": "ظهر و عصر اینجا مجلس درسه، بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.08,
   "end": 233.62,
   "text": "خب شما تشریف آوردی اگر به نیت این مجلس درس و بحث اومدی به شما میگن آقا برای چی میری اونجا می‌شینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.62,
   "end": 238.06,
   "text": "خب یه جا دیگه نماز جماعت یا تو دفترت چه می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.06,
   "end": 240.66,
   "text": "خب میگی که آقا اونجا می‌خوام یه چیزی یاد بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.66,
   "end": 244.3,
   "text": "میری یاد می‌گیری. اینو بلد بودی یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.3,
   "end": 251.88,
   "text": "اگر کسی این بحث رو می‌خواد مفصوشو ببینه درس نوزدهم از دروس معرفت نفس علامه الان کتابش اینجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.88,
   "end": 256.9,
   "text": "کنار منه. می‌تونه بیاد ببینه همین بحثو علامه باز کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.9,
   "end": 264.72,
   "text": "آقا شما میری تو درس و بحث می‌شینی بلد بودی اون چیزی که گرفتی، اون تعلیمی که دیدی از معلم و استاد و چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.72,
   "end": 267.4,
   "text": "بلد بودی یا نه؟ میگی نه بلد نبودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.4,
   "end": 272.58,
   "text": "چون اگر بلد بودی که تحصیل حاصل که محاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.58,
   "end": 276.72,
   "text": "بلد بودی؟ خب برای چی نشستی دوباره چیزی که بلد بودی بلد بشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.72,
   "end": 279.9,
   "text": "یعنی چی؟ این چه حرفیه؟ نداشتی پس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.9,
   "end": 282.92,
   "text": "اگر نداشتی خب این از کجا اومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.92,
   "end": 284.74,
   "text": "میگی از استاد به من اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.74,
   "end": 288.12,
   "text": "معلم من اومد. ایشون به من یاد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.12,
   "end": 297.44,
   "text": "خب اون که این کمال رو به رو، به تو داد، تو رو از مخض به کمال، از قوه به فعل، از ضعف به شدت و قوت رسوند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.44,
   "end": 301.3,
   "text": "از جهل به علم رسوند، از خودش داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.3,
   "end": 306.0,
   "text": "میگیم که فاقد شی نمی‌تونه معطي اون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 306.0,
   "end": 310.08,
   "text": "یعنی کسی که چیزی رو نداره نمی‌تونه عطا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.08,
   "end": 313.22,
   "text": "حتماً داشته که یه تعلیمی به من داده معلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.22,
   "end": 319.9,
   "text": "خب آقای معلم شما هم این حقیقتی که انتقال دادی به من، این فهمی که در من ایجاد کردی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.9,
   "end": 322.56,
   "text": "داشتی از قبل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.56,
   "end": 325.1,
   "text": "میگیم نه. معلمم میگه نه منم نداشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.1,
   "end": 328.6,
   "text": "منم اینو فرا گرفتم. خب چگونه فرا گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 328.6,
   "end": 335.24,
   "text": "به دو نحو. یا میگه کسی نشست مثل الان که برای شما داره معلم توضیح میده برای من توضیح داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.24,
   "end": 337.66,
   "text": "یعنی یک کم مسموعی، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 337.66,
   "end": 342.92,
   "text": "صوتی ایجاد شد در عالم مده، ماده من شنیدم علت مؤده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.92,
   "end": 344.78,
   "text": "من رفتم دنبال فهمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.78,
   "end": 350.72,
   "text": "یا نه، اصلاً خودم یه کلماتی رو متوجه شدم نشستم در خلوت خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 350.72,
   "end": 355.08,
   "text": "من از شما سؤال می‌کنم آیا نشده شما در خلوت خودت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.08,
   "end": 360.86,
   "text": "در اون نهان‌خانه خودت یه روزی بدون وجود استاد و معلم چیزی رو بفهمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.86,
   "end": 366.12,
   "text": "چیزی رو درک کنی؟ چیزی رو بچشی، به حقیقتی برسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 366.12,
   "end": 367.76,
   "text": "موضوعی برات متمثل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.76,
   "end": 375.28,
   "text": "اصلاً در خواب خودتی و خودت این همه حقایق برات کشف می‌شه خودتی و خودت در نفس ناطقه خودت رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.28,
   "end": 378.46,
   "text": "معلم کیه اونجا؟ کسی نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.46,
   "end": 386.22,
   "text": "خب این تعلیمی که در درون خودت بود، در خلوتت یه چیزی رو فهمیدی حقیقلی-- حقیقتی برات کشف شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.22,
   "end": 390.5,
   "text": "این از کجا اومد؟ بالاخره یک مخرجی می‌خواد شما رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.5,
   "end": 394.3,
   "text": "جهل به علم برسونه، از مجهول به معلوم برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 394.3,
   "end": 397.16,
   "text": "نمی‌شه بدون مخرج. یکی تو رو خارج کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.16,
   "end": 400.72,
   "text": "چون تو که خودت که نداشتی از بیرونم که نیومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 400.72,
   "end": 402.44,
   "text": "معلم الان نیست به من تعلیم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.44,
   "end": 407.32,
   "text": "الان من یه چیزی رو خودم تعامل کردم، تدبر کردم، تفعل کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.32,
   "end": 409.44,
   "text": "ن-- با این تفکرم فهمیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.44,
   "end": 412.14,
   "text": "این فهم از کجا ایجاد شد؟ بفرمایین ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.14,
   "end": 415.3,
   "text": "علامه تو این درس نوزدهم درس معرفت نفسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.3,
   "end": 418.88,
   "text": "می‌فرما د یه مخرج می‌خواد تو رو خارج کنه، حرکت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 418.88,
   "end": 424.0,
   "text": "حرکت از قوه به فعل، از ضعف به شدت، از نقص به کمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 424.0,
   "end": 430.9,
   "text": "اون مخرج کیه؟ حالا بر اساس آیه اول سوره ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.9,
   "end": 432.84,
   "text": "قرآنی بخوایم بحث کنیم می‌فرما د الف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 432.84,
   "end": 436.02,
   "text": "لام. را. کتاب انزلنا الیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.02,
   "end": 440.1,
   "text": "این کتابی‌ست که قرآن ما بهتون نازل کردیم که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 440.1,
   "end": 446.38,
   "text": "لتخرج پیغمبر تخرج فعل مخاطبه تا تو خارج کنی لتخرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 446.38,
   "end": 449.12,
   "text": "من الظلمات الی النور تا تو خارج کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 449.12,
   "end": 452.72,
   "text": "پس مخرج کی می‌شه؟ پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 452.72,
   "end": 454.7,
   "text": "با چی؟ با قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.7,
   "end": 457.68,
   "text": "وساطت فیض بین پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.68,
   "end": 460.08,
   "text": "و قرآن و حضرت حق هم که ملائکه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.08,
   "end": 462.3,
   "text": "تنزل الملائکه والروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.3,
   "end": 465.5,
   "text": "پس خدا که می‌خواد خارج کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 465.5,
   "end": 470.24,
   "text": "واسطه ف-فیض برای خارج شدن ما از مجهول به معلوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.24,
   "end": 472.8,
   "text": "پیغمبره. به وسیله قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.8,
   "end": 475.84,
   "text": "اون ابزار و لوازم و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.84,
   "end": 481.72,
   "text": "در حقیقت کمک‌های پیغمبر، قوای وجودی عالم که پیغمبر رو کمک می‌دن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.72,
   "end": 487.2,
   "text": "در این که ما خارج بشیم از نفهمی به فهمیدن ملائکه الله‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.2,
   "end": 489.78,
   "text": "که این حدیث پیغمبر داره می‌فرما چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.78,
   "end": 495.1,
   "text": "اگر نذاری ملائکه بیان با شیاطینی که گرد دلتن چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.1,
   "end": 496.98,
   "text": "دیگه چشمت از ملکوت باز می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.98,
   "end": 499.08,
   "text": "دستت از ملائکه باز می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.08,
   "end": 502.82,
   "text": "عزیز دلم هر فهمی ایجاد می‌شه نزول ملکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.82,
   "end": 504.96,
   "text": "در این ماه شدت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.96,
   "end": 508.2,
   "text": "این ماه، ماه فهمه. ماه فهمیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.2,
   "end": 511.3,
   "text": "لذا امیرالمؤمنین می‌فرمود بهترین کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.3,
   "end": 513.82,
   "text": "در این ماه یکی ورع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 513.82,
   "end": 516.56,
   "text": "عن محارم الله یعنی شدت تقوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 516.56,
   "end": 518.98,
   "text": "یکی تعلیم علمه. تعلیم علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 518.98,
   "end": 522.36,
   "text": "اون ورعه باعث می‌شه این شیاطین گورشونو گم کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.36,
   "end": 527.02,
   "text": "که ملائکه بیان و اون تمثلات حاصل بشه تو چشمت و ملکوت باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 527.02,
   "end": 531.68,
   "text": "این درون مایه این ماهه. انشاالله عاقبتمون ختم به خیر بشه و برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 531.68,
   "end": 533.84,
   "text": "صلوات بر محمد و آل محمد. اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}