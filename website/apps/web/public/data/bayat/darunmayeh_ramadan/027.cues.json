 "chapters": [
  {
   "index": 0,
   "title": "## استفتا؛ فرو بردن اخلاط در روزه",
   "start": 11.0,
   "end": 45.12
  },
  {
   "index": 1,
   "title": "## روزه جان را قوی می‌کند",
   "start": 45.12,
   "end": 192.78
  },
  {
   "index": 2,
   "title": "قرآن دو بار بر پیامبر عظیم‌الشأن نازل شد: یک‌بار به صورت دفعی کل قرآن که مقام جمعی دارد:",
   "start": 192.78,
   "end": 295.18
  },
  {
   "index": 3,
   "title": "## جان عالم؛ امام زمان و ریاضات شرعیه",
   "start": 295.18,
   "end": 486.43
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 2.56,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.56,
   "end": 7.9,
   "text": "و به این استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.9,
   "end": 11.0,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.0,
   "end": 14.84,
   "text": "استفتای دیگه ای که از رهبر عزیزمون شده این هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.84,
   "end": 17.98,
   "text": "آیا فرو بردن اخلاط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.98,
   "end": 21.66,
   "text": "گلو و بینی در حالت روزه داری اشکال داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.66,
   "end": 27.42,
   "text": "رهبر عزیز فرمودن که اگر وارد فضای دهان نشه اشکال نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.42,
   "end": 30.14,
   "text": "و اگر وارد فضای دهان شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.14,
   "end": 32.5,
   "text": "احتیاط واجب اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.5,
   "end": 35.08,
   "text": "از فرو بردن اون امتناع کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.08,
   "end": 38.1,
   "text": "در حقیقت ایشون فتوا ندادن، احتیاط کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.1,
   "end": 40.24,
   "text": "میتونید رجوع کنید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 40.24,
   "end": 42.52,
   "text": "نظر مراجع دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 42.52,
   "end": 47.6,
   "text": "در خصوص اسرار روزه دیروز عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 47.6,
   "end": 51.42,
   "text": "بدن انسان با روزه سلامت و صحت پیدا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 51.42,
   "end": 55.66,
   "text": "امروز تبرکاً اثبات میکنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 55.66,
   "end": 58.72,
   "text": "جان انسان هم قوی میشه با روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 58.72,
   "end": 63.5,
   "text": "خیلی راحت دقت بفرمایید با چند تا حدیثی که مرور کردیم قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 63.5,
   "end": 67.16,
   "text": "با توجه به این‌ها کنار هم متوجه میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 67.16,
   "end": 71.72,
   "text": "اگر چنانچه دقت کرده باشید عرض کردیم از حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 71.72,
   "end": 75.34,
   "text": "نبوی عرض کردیم که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.34,
   "end": 79.14,
   "text": "شیاطین گرد قلب انسان نگردند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 79.14,
   "end": 82.68,
   "text": "ااا انسان نظر میندازه به ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 82.68,
   "end": 86.8,
   "text": "و از طرفی عرض کردیم که اون چیزی که مجرای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 86.8,
   "end": 89.22,
   "text": "ورود شیطان به وجود رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 89.22,
   "end": 91.66,
   "text": "میبنده جوع و گرسنگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 91.66,
   "end": 95.42,
   "text": "خب خودتون صغرا کبرا کنید یه قضیه است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 95.42,
   "end": 99.16,
   "text": "اولاً اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 99.16,
   "end": 102.8,
   "text": "شیاطین گرد ما نباشند نظر به ملکوت میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 102.8,
   "end": 106.64,
   "text": "دو؛ اگر اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 106.64,
   "end": 111.6,
   "text": "گرسنگی و جوع و روزه البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 111.6,
   "end": 117.18,
   "text": "صوم القطع دیگه نه صوم الوصل که قبلاً توضیح دادیم داشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 117.18,
   "end": 119.98,
   "text": "باعث میشه که راه نفوذ شیاطین بسته بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 119.98,
   "end": 123.64,
   "text": "اگر راه نفوذ شیاطین بسته بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 123.64,
   "end": 128.86,
   "text": "در حقیقت شیاطین گرد قلب ما نگردند چشم ما به ملکوت باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 128.86,
   "end": 131.38,
   "text": "نتیجه؛ روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 131.38,
   "end": 134.4,
   "text": "سبب باز شدن چشم به ملکوت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 134.4,
   "end": 138.0,
   "text": "کسانی که ام- تمثلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 138.0,
   "end": 143.0,
   "text": "خوبی ندارن، خواب‌های خوبی نمی‌بینن، کشفی ندارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 143.0,
   "end": 146.04,
   "text": "پرده‌ای براشون کنار نمیره هیچ وجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 146.04,
   "end": 150.54,
   "text": "عرض شود نکات معرفتی دقیق و علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 150.54,
   "end": 153.38,
   "text": "عمیق رو هرچی زور می‌زنن متوجه نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 153.38,
   "end": 158.28,
   "text": "این‌ها نشون میده که جانشون عمیق نیست، جانش- جانشون قوی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 158.28,
   "end": 160.48,
   "text": "با چی جان قوی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 160.48,
   "end": 162.16,
   "text": "با صوم، با گرسنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 162.16,
   "end": 167.32,
   "text": "شما دقت بفرمایید ببینید تمام بزرگان اهل معرفت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 167.32,
   "end": 170.88,
   "text": "با همین ریاضات شرعيه، با همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 170.88,
   "end": 178.8,
   "text": "صوم و صلاة، با همین ریاضات شرعيه تونستن به اونجا برسن که مفاخر بزرگ علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 178.8,
   "end": 181.24,
   "text": "و معنوی ما بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 181.24,
   "end": 186.5,
   "text": "خود قرآن رو شما دقت بفرمایید دو بار بر پیغمبر عظیم الشأن اسلام، یه-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 186.5,
   "end": 193.48,
   "text": "یک بار به صورت دفعی کل قرآن که مقام جمعی داره نازل شده \"انا انزلناه في ليلة القدر\" این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 193.48,
   "end": 195.64,
   "text": "انزال دفعی است که حدود سن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 195.64,
   "end": 199.64,
   "text": "سیزده سالگی برای ایشون بعضیا شمردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 199.64,
   "end": 203.6,
   "text": "در تاریخ آوردن. بار دوم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 203.6,
   "end": 207.24,
   "text": "در خب شب بیست و هفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 207.24,
   "end": 211.48,
   "text": "ماه شعبان بوده و عرض شود خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 211.48,
   "end": 214.82,
   "text": "بعد از چهل روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 214.82,
   "end": 218.16,
   "text": "بیتوته پیغمبر در غار حرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 218.16,
   "end": 221.94,
   "text": "و خدمتتون عرض شود روزه گرفتن چهل روزه ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 221.94,
   "end": 224.68,
   "text": "باز ببینید چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 224.68,
   "end": 230.3,
   "text": "انزال دفعی، چه در نزول تدریجی \"تنزل الملائكة والروح\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 230.3,
   "end": 235.38,
   "text": "در هر دو در ایام روزه داری پیغمبر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 235.38,
   "end": 238.86,
   "text": "یعنی روزه چنان جان رو قوی میکنه که میتونه یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 238.86,
   "end": 241.56,
   "text": "وزن سنگینی مثل قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 241.56,
   "end": 244.18,
   "text": "متحمل بشه. و قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 244.18,
   "end": 247.98,
   "text": "مقام جمعی داره، تمام علوم درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 247.98,
   "end": 253.88,
   "text": "فقط مرحوم گنابادی که یک تفسیر خیلی جالبی هم دارن ایشون فقط ایشون میفرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 253.88,
   "end": 260.42,
   "text": "پنج آیه اول سوره بقره رو شما دقت بفرمایید از حیث فقط خوانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 260.42,
   "end": 264.76,
   "text": "ادبیاتی، فعل و فاعل و مفعول و مضاف و نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.76,
   "end": 270.88,
   "text": "مضاف الیه و جار و مجرور و این‌ها به بیش از یازده میلیارد وجه میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.88,
   "end": 275.78,
   "text": "خوند. ببینید این چه جانی بوده که تونسته همچین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 275.78,
   "end": 277.86,
   "text": "باری رو تحمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.86,
   "end": 281.14,
   "text": "یا علمای خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.14,
   "end": 286.76,
   "text": "امثال علامه حسن زاده‌ها که برای یک حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 286.76,
   "end": 289.56,
   "text": "امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 289.56,
   "end": 292.74,
   "text": "که \"من عرف نفسه فقد عرف ربه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 292.74,
   "end": 295.18,
   "text": "صدها وجه رو بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 295.18,
   "end": 299.64,
   "text": "خدا رحمت کنه مرحوم حاجی سبزواری علیه الرحمه رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.64,
   "end": 303.88,
   "text": "میفرماین که اگر عالم رو شما بدن فرض کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 303.88,
   "end": 305.96,
   "text": "یعنی عالم بدن است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 305.96,
   "end": 309.1,
   "text": "جان این عالم نفس ناطقه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 309.1,
   "end": 311.92,
   "text": "بدن امام زمان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 311.92,
   "end": 317.42,
   "text": "در حقیقت اون \"من عرف نفسه فقد عرف ربه\" رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.42,
   "end": 323.32,
   "text": "یه وجهش رو علامه میفرمایند که این nefsi که تو باید بشناسی جان امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 323.32,
   "end": 329.52,
   "text": "هر مقدار که امامت رو بشناسی همون مقدار حق معرفت و توحید رو اد- ادا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 329.52,
   "end": 334.02,
   "text": "حالا این صدها وجه براش هست که من پنج تاشو برای عزیزان عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 334.02,
   "end": 337.14,
   "text": "متحیر شدند گفتند دیگه ادامه نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.14,
   "end": 339.5,
   "text": "تازه ایشون داره ادامه میده وجوه متعدد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.5,
   "end": 341.78,
   "text": "اینا از کجا میاد؟ از همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.78,
   "end": 344.98,
   "text": "ریاضات شرعيه، از همون گرسنگی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 344.98,
   "end": 347.18,
   "text": "از همون سختی‌هایی که به جان خریدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 347.18,
   "end": 349.96,
   "text": "ملاصدراها وقتی میرن در کهک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 349.96,
   "end": 359.7,
   "text": "قم تبعید میشن، اون علومی که در اسفار اربعه ایشون جمع شده و بزرگان میگن ما موندیم این علم از کجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 359.7,
   "end": 364.22,
   "text": "تراوش پیدا کرده. نمی‌دونیم چی به ایشون گفته قسمش داده اسم ما رو نگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.22,
   "end": 371.9,
   "text": "البته بعضیا معتقدند که ایشون می‌رفته محضر برادر حضرت معصومه سلام الله علیها که همونجا دفنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.9,
   "end": 374.76,
   "text": "و اونجا اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.76,
   "end": 381.21,
   "text": "از ایشون به توجه عرفانی علم رو اخذ می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.21,
   "end": 384.91,
   "text": "و در هر حال این هم در تبعید و در سختی و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 384.91,
   "end": 387.87,
   "text": "ناگوارى و در گرسنگی و جو و این‌ها بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.87,
   "end": 392.45,
   "text": "اینطور نبوده که همه چی براشون آماده باشه، هیچ سختی نکشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.45,
   "end": 395.11,
   "text": "هیچ فشاری روشون نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.11,
   "end": 399.39,
   "text": "این که انسان همه-- حالا یه ماه مبارک رمضانی روزه بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.39,
   "end": 406.69,
   "text": "اونم به توسط نه به تف-- افراط و تفریط بعدش رها کنه این جریان رو ادامه نده انسان به جایی نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.69,
   "end": 410.19,
   "text": "ما باید سعی کنیم این راه رو انشاالله ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.19,
   "end": 414.43,
   "text": "خدا رحمت کنه بزرگان اهل معرفت را، علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.43,
   "end": 416.47,
   "text": "حسن زاده‌ها رو حفظ کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.47,
   "end": 424.13,
   "text": "که معتقدن اگر تمام قرآن رو بخوای تو یه جمله جمع کنی همین یک حدیث امیرالمؤمنین علیه الصلاة والسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.13,
   "end": 428.85,
   "text": "اگر تمام هر هفتصد حدود هفتصد و پنجاه جلد کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.85,
   "end": 434.69,
   "text": "محی الدین عربی رو، فصوص الحکم‌شو، شرح قیصری‌شو، نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.69,
   "end": 438.91,
   "text": "كتب اربعه یا ثمانیه شیعه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.91,
   "end": 442.19,
   "text": "نمی‌دونم اصول کافی و استبصار و تهذیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.19,
   "end": 449.35,
   "text": "و ملّا یهزر و مستدرک الوسائل و بهار و همه اینا رو جمع کنی فرمودن شرح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.35,
   "end": 453.27,
   "text": "شرح یک حدیث امیرالمؤمنین علیه الصلاة والسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.27,
   "end": 455.71,
   "text": "در حقیقت این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 455.71,
   "end": 462.53,
   "text": "قدرند و حدیث من عرف نفسه فقد عرف ربه امیرالمؤمنین قضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.53,
   "end": 464.61,
   "text": "خب این‌ها از کجا به دست میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.61,
   "end": 468.43,
   "text": "خود مولا این جان رو از کجا به دست آوردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 468.43,
   "end": 471.83,
   "text": "از همین سختی‌ها، از همین جو و گرسنگی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 471.83,
   "end": 476.71,
   "text": "که امیدوارم تنبه خاطری بشه برای ما و این راه رو به امید خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 476.71,
   "end": 482.13,
   "text": "ادامه بدیم. فقط صرف ماه مبارک رمضان نباشه تا جان‌هامون به امید خدا قوی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 482.13,
   "end": 486.43,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه. به برکت صلوات بر محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}