 },
 "chapters": [
  {
   "index": 0,
   "title": "## آنکه خدا دارد چرا بی‌نواست",
   "start": 0.04,
   "end": 132.6
  },
  {
   "index": 1,
   "title": "## توحیدِ صمدی؛ توجّه به او نه فقط به معنا",
   "start": 132.6,
   "end": 566.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.04,
   "end": 3.82,
   "text": "بحث جدید چیه؟ از نامه دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.82,
   "end": 9.52,
   "text": "نامه‌ها و برنامه‌ها این عبارت رو می‌خواستیم توضیح بدیم که از تو استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.52,
   "end": 13.98,
   "text": "فرمودن که \"آنکه خدا دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.98,
   "end": 19.3,
   "text": "چرا بی‌نواست؟\" بیخود کردی میگی بی‌نوایی وقتی که خدا داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.3,
   "end": 21.56,
   "text": "اینو می‌خواستیم توضیح بدیم به چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.56,
   "end": 23.38,
   "text": "عبارت دیگه که همین مضمون رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.38,
   "end": 29.0,
   "text": "حالا اشاره عزیزم چون فرصت ما خیلی کمه من فقط یه نکته‌ای رو از دیشب عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.0,
   "end": 31.9,
   "text": "که جا موند و عزیزان سوال کردن بعد از منبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.9,
   "end": 34.86,
   "text": "ما یه شعری رو خوندیم، این شعر خیلی معروفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.86,
   "end": 37.84,
   "text": "خیلی هم از، از عالمه شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.84,
   "end": 42.74,
   "text": "این شعر رو جا داره که اون پنجمیش رو، یه نکته‌ای رو پیرامونش بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.74,
   "end": 44.36,
   "text": "بچه‌ها گفتن دیشب نگفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.36,
   "end": 50.8,
   "text": "\"صمت و جو و سحر و خلوت و ذکر بدوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.8,
   "end": 54.34,
   "text": "ناتمامان جهان را کند این پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.34,
   "end": 58.74,
   "text": "تمام\". دیشب پیرامون اهمیت سکوت حرف زدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.74,
   "end": 63.48,
   "text": "که صمت با صاد یعنی سکوت که \"الصمت اول العباده\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.48,
   "end": 67.38,
   "text": "گفتم حال خوش می‌خوای معراج بری تو نماز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.38,
   "end": 71.84,
   "text": "سکوت قبل از نماز و، و، و صحبت‌هایی که کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.84,
   "end": 77.26,
   "text": "اینجا تو این شعر اگر حواست نباشه یه اشکالی پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.26,
   "end": 80.72,
   "text": "که اون دوام رو می‌زنی به پنج تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.72,
   "end": 83.76,
   "text": "یعنی که نه صمت بدوام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.76,
   "end": 88.16,
   "text": "سکوت بدوام، جو گرسنگی بدوام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.16,
   "end": 90.8,
   "text": "سحر بیداری شب بدوام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.8,
   "end": 93.18,
   "text": "خلوت هم بدوام، ذکر هم بدوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.18,
   "end": 95.66,
   "text": "نه این غلطه. این نکته رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.66,
   "end": 98.28,
   "text": "دیشب جا داشت بگیم یادمون رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 98.28,
   "end": 101.46,
   "text": "همه این‌ها هیچ‌کدومشون دوام ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 101.46,
   "end": 104.94,
   "text": "اون دوام می‌خوره به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.94,
   "end": 111.06,
   "text": "احسنت به ذکر. تنها چیزی که حدی براش قائل نشدن ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.06,
   "end": 113.38,
   "text": "\"وذكروا الله ذكراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 113.38,
   "end": 118.36,
   "text": "كثيرا\". تا می‌تونی مشغول ذکر حضرت حق باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.36,
   "end": 120.98,
   "text": "اما حواسمون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 120.98,
   "end": 124.62,
   "text": "که ذکر فرق می‌کنه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 124.62,
   "end": 126.74,
   "text": "اسم. ورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 126.74,
   "end": 129.12,
   "text": "حالا بهتره بگیم ورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 129.12,
   "end": 131.94,
   "text": "شما اسم رو، خوب اینو گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 131.94,
   "end": 136.96,
   "text": "اسم رو اگر بر لسانت جاری کنی تکرارش کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 136.96,
   "end": 139.54,
   "text": "بر اثر تکرار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 139.54,
   "end": 143.98,
   "text": "ورود و خروج به این اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 143.98,
   "end": 148.16,
   "text": "می‌شه ورد. میگن ورد زبانت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 148.16,
   "end": 151.98,
   "text": "خب اسم، اسم خدا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 151.98,
   "end": 155.24,
   "text": "این‌ها رو حالا هر کدوم از اسماء رو شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 155.24,
   "end": 158.32,
   "text": "تکرارش کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 158.32,
   "end": 161.06,
   "text": "که یک اصلی‌ست در عرفان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 161.06,
   "end": 164.46,
   "text": "قبلا یه چیزکی درباره‌ش گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 164.46,
   "end": 168.82,
   "text": "این اصل تکراره در ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 168.82,
   "end": 171.92,
   "text": "رفت و برگشته در ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 171.92,
   "end": 174.2,
   "text": "این یه آثاری داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 174.2,
   "end": 177.16,
   "text": "چون لفظش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 177.16,
   "end": 181.52,
   "text": "از سما-- \"الاسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 181.52,
   "end": 188.08,
   "text": "تنزل من السماء\". اسم‌ها از آسمان نازل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 188.08,
   "end": 190.5,
   "text": "جنسشون آسمونیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 190.5,
   "end": 195.32,
   "text": "حتی اگر بی‌توجه هم بگی چون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 195.32,
   "end": 198.48,
   "text": "نظر حضرت علامه‌ست‌ها البته. چون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 198.48,
   "end": 201.42,
   "text": "عبارت از آسمان نازل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 201.42,
   "end": 204.78,
   "text": "بازم رنگ و بوی ملکوت داره، یه چیزکی اثر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 204.78,
   "end": 207.7,
   "text": "اما باز اسمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 207.7,
   "end": 211.74,
   "text": "ورده، ذکر نیست‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 211.74,
   "end": 214.52,
   "text": "اسم دواست. \"یا من اسمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 214.52,
   "end": 218.3,
   "text": "دواء\". اما معلوم نیست شفا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 218.3,
   "end": 220.76,
   "text": "کی شفا می‌شه؟ آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 220.76,
   "end": 223.08,
   "text": "\"و ذكره شفا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 223.08,
   "end": 226.4,
   "text": "وقتی اسم یا ورد تبدیل شد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 226.4,
   "end": 229.94,
   "text": "ذکر، دوا، شفاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 229.94,
   "end": 232.82,
   "text": "می‌شه آدم مریض شه، دارو بخوره خوب نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 232.82,
   "end": 235.7,
   "text": "نشده تا حالا؟ خیلی‌مون شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 235.7,
   "end": 238.9,
   "text": "کی می‌خوری اون اسم و شفاعت عن هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 238.9,
   "end": 242.4,
   "text": "وقتی تبدیل به ذکر بشه. حالا ذکر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 242.4,
   "end": 246.52,
   "text": "پس الان متوجه شدیم فرق اسم یا ورد با ذکر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 246.52,
   "end": 252.34,
   "text": "ما ورد اعظم یا بهتره بگیم اسم اعظم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 252.34,
   "end": 255.58,
   "text": "زیادن. اسم اعظم زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 255.58,
   "end": 260.26,
   "text": "اما ذکر اعظم یه دونه بیشتر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 260.26,
   "end": 263.5,
   "text": "اون ذکر اعظم حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 263.5,
   "end": 268.84,
   "text": "سطح ابتدایی‌ش رو، دیگه همه فهمش رو بخوایم بگیم یعنی حضور قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 268.84,
   "end": 272.2,
   "text": "یعنی اینکه قلب حاضر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 272.2,
   "end": 280.06,
   "text": "تو خودت رو در محضر حضرت حق ببینی و این اسم رو ببری با همراه با-- اصطلاح میگه همراه با توجه بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 280.06,
   "end": 282.78,
   "text": "به این میگن چی؟ ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 282.78,
   "end": 287.18,
   "text": "که این ذکر ابتداش باز با اسم شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 287.18,
   "end": 290.86,
   "text": "توجه بفرمایید. اسم همراهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 290.86,
   "end": 292.98,
   "text": "خب حالا مخصوصا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 292.98,
   "end": 296.56,
   "text": "برای شروع راه سیر و سلوک از کاری که لب خیلی نمی‌جنبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 296.56,
   "end": 299.54,
   "text": "لا الهه ببین الان لب من تکون نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 299.54,
   "end": 301.68,
   "text": "لا اله الا الله، لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 301.68,
   "end": 304.38,
   "text": "اصلا لب تکون نمی‌خوره. بهترین ذکر برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 304.38,
   "end": 308.08,
   "text": "خلوصه. هیچکس... حالا به قول علامه یه آیه داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 308.08,
   "end": 310.42,
   "text": "\"و امم مم مم معك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 310.42,
   "end": 313.52,
   "text": "می‌فرمود که-- مفسرای old می‌فرمود که بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 313.52,
   "end": 316.14,
   "text": "می‌فتن به ذکر و سیر و سلوک و اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 316.14,
   "end": 319.06,
   "text": "اینجور ذکر‌ها رو دست می‌گیرن \"و امم مم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 319.06,
   "end": 322.64,
   "text": "مم معك\". همش م م م م م",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 322.64,
   "end": 326.3,
   "text": "این لب به هم می‌خوره. بعضیامون اینطوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 326.3,
   "end": 330.84,
   "text": "نه، اون ذکر‌های بدون تکان خوردن لب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 330.84,
   "end": 334.22,
   "text": "ولی با-- اون ذکر هم با اسم ابتدا شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 334.22,
   "end": 336.84,
   "text": "وقتی رفتی جلو کار کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 336.84,
   "end": 340.0,
   "text": "اون سکوت رو، سکوتی که دیشب گفتیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 340.0,
   "end": 343.08,
   "text": "لحاظ کردی در کارت رفتی جلو، خورد خورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 343.08,
   "end": 346.58,
   "text": "چنان قوای وجودیت شدت می‌گیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 346.58,
   "end": 350.38,
   "text": "چنان به وحدت می‌رسی، قوی می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 350.38,
   "end": 354.5,
   "text": "گفتیم از کثرات به وحدت قوته، بالعکسش ضعفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 354.5,
   "end": 357.82,
   "text": "از وحدت به کثرات و کثرت ضعف میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 357.82,
   "end": 363.32,
   "text": "وقتی شما متمرکز می‌شی یعنی به سمت توحید و وحدت حرکت می‌کنی، قوی می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 363.32,
   "end": 375.0,
   "text": "به جایی می‌رسی که اصلا بدون اینکه ذکر بر لسانت، اون اسم بر لسانت جاری بشه قلبت داره ذکر میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 375.0,
   "end": 379.9,
   "text": "و اون حضور قلبیه، اون دیگه ذکر قلبیه همراهته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 379.9,
   "end": 382.06,
   "text": "که اونجا، حالا اینجا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 382.06,
   "end": 384.06,
   "text": "حرف‌هایی داریم الان وقتش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 384.06,
   "end": 386.9,
   "text": "وقت اون البته گذشته و الان هم جاش نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 386.9,
   "end": 389.38,
   "text": "که بالاخره اون حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 389.38,
   "end": 392.12,
   "text": "نهایت ذکر قلبی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 392.12,
   "end": 402.86,
   "text": "حالا ابتدایی‌ترینش یعنی حاضر باشه قلبت به اون چیزی که میگی، متوجه باشی چی داری میگی، غافل نباشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 402.86,
   "end": 405.7,
   "text": "خب اگه اینه، یه سؤال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 405.7,
   "end": 409.74,
   "text": "تو این سؤال بمونید، تو خماریش بمونید بچه‌های نظام آباد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 409.74,
   "end": 417.22,
   "text": "اگر اینه که باید توجه کنه قلب به معنای اسمی که داری میگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 417.22,
   "end": 422.6,
   "text": "چگونه است که حضرت آقای طبا Tabai علیه الرحمه استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 422.6,
   "end": 429.56,
   "text": "شهید مطهری وقتی به شهید مطهری رسید گفت الان نمازاتو چجوری داری می‌خونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 429.56,
   "end": 433.38,
   "text": "گفت طوری که تمام از کار نمازو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 433.38,
   "end": 436.62,
   "text": "می‌خونم توجه به معانیش دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 436.62,
   "end": 441.46,
   "text": "بسم الله الرحمن الرحیم توجه دارم چی دارم می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 441.46,
   "end": 445.16,
   "text": "علامه طباطبایی فرمودن خیلی عقب موندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 445.16,
   "end": 448.6,
   "text": "دیگه الان وقت اون گذشته که دیگه توجه به معانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 448.6,
   "end": 453.1,
   "text": "نکنی، توجه به او کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 453.1,
   "end": 455.94,
   "text": "اصلا دیگه نباید، نباید متوقف بشی تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 455.94,
   "end": 461.72,
   "text": "نه اینم، اینو ببین می‌خوام فقط یه سرنخ بهت بگم بالاخره جواب این سؤال چی می‌شه پس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 461.72,
   "end": 464.74,
   "text": "این چیکار بایدش کرد؟ اینجا دیگه توجه به معنی نکن اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 464.74,
   "end": 467.42,
   "text": "این چه ح-حضور قلبیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 467.42,
   "end": 469.2,
   "text": "این دیگه می‌رسه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 469.2,
   "end": 476.44,
   "text": "توحید صمدی. چه موهبتی هست استاد علامه حسن زاده به شماها کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 476.44,
   "end": 486.12,
   "text": "توحید صمدی یا به معنای همون لقاء الله که کثرت رو در وحدت، وحدت رو در کثرت، حق رو در خلق، خلق رو در حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 486.12,
   "end": 490.3,
   "text": "تفصیل و جمع رو با هم می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 490.3,
   "end": 494.88,
   "text": "اصلا یکپارچه در هیمان و حضوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 494.88,
   "end": 500.8,
   "text": "همه رو به دریا بنگرم، دریات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 500.8,
   "end": 506.08,
   "text": "بینم. علامه میگه این غلطه بگی دریا تو بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 506.08,
   "end": 508.86,
   "text": "دریای تو رو نمی‌بینم. اصلا دریات می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 508.86,
   "end": 513.06,
   "text": "تو رو دریا می‌بینم. نه اینکه همه خدا اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.06,
   "end": 515.2,
   "text": "استغفرالله حلولی باز نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 515.2,
   "end": 519.36,
   "text": "این دریا ظهور توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.36,
   "end": 522.68,
   "text": "این ظهور توئه. محضره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 522.68,
   "end": 525.2,
   "text": "حضرات، حضرات خمس تو لقاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 525.2,
   "end": 529.34,
   "text": "محل حضور خداست. خدا اونجا حاضره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 529.34,
   "end": 530.96,
   "text": "وجود است که مشهود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 530.96,
   "end": 534.4,
   "text": "هرچی می‌بینی حقه. سنریهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 534.4,
   "end": 536.78,
   "text": "آیاتنا في الآفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 536.78,
   "end": 539.64,
   "text": "و في أنفسهم که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 539.64,
   "end": 543.28,
   "text": "حتی یتبین لهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 543.28,
   "end": 548.9,
   "text": "أنه الحق. حق، تو هم حقی، آسمان حقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 548.9,
   "end": 555.66,
   "text": "هو الذي خلق السماوات والأرض بالحق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 555.66,
   "end": 557.58,
   "text": ". والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 557.58,
   "end": 560.88,
   "text": "صلوات فرستادیم. اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 560.88,
   "end": 563.04,
   "text": "على محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 563.04,
   "end": 566.04,
   "text": "آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}