 "chapters": [
  {
   "index": 0,
   "title": "## اربعین کلیمی؛ وعدنا موسی ثلاثین لیلة",
   "start": 0.52,
   "end": 122.32
  },
  {
   "index": 1,
   "title": "## تطابق عالم و آدم؛ تصفیهٔ خون در لیل",
   "start": 122.32,
   "end": 272.3
  },
  {
   "index": 2,
   "title": "## قصص/۷۱–۷۲؛ سمع در لیل و بصر در نهار",
   "start": 272.3,
   "end": 406.58
  },
  {
   "index": 3,
   "title": "## تلویزیون و تخیلات فاسده؛ سبک زندگی",
   "start": 406.58,
   "end": 467.44
  },
  {
   "index": 4,
   "title": "## خلوت و ذکر به دوام؛ مقام محمود",
   "start": 467.44,
   "end": 857.97
  },
  {
   "index": 5,
   "title": "## قدر آنات؛ فیض آنی در شب و روز قدر",
   "start": 857.97,
   "end": 928.77
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 6.82,
   "text": "بعد حضرت استاد دو خط شعر می‌خونن و این آیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.82,
   "end": 10.92,
   "text": "ولی وقتی بحث اربعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.92,
   "end": 14.32,
   "text": "رو مطرح می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.32,
   "end": 17.64,
   "text": "فـ-- ظاهراً ماه ذی القعده بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.64,
   "end": 20.84,
   "text": "یا پیش، پیش رو بوده ذی القعده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.84,
   "end": 25.32,
   "text": "می‌فرماید رندان خدا یک اربعین به زندان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.32,
   "end": 29.48,
   "text": "می‌نشینند؛ یعنی از اول تا دهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.48,
   "end": 31.52,
   "text": "ذی الحجه اربعین کلیمی می‌گیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.52,
   "end": 35.72,
   "text": "اشاره به این آیه می‌کنند. \"و وعدنا موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.72,
   "end": 40.5,
   "text": "اربعین و وعدنا موسی ثلاثین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.5,
   "end": 44.6,
   "text": "سی شب \"ثلاثین ليلة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.6,
   "end": 48.0,
   "text": "اینجا یه نکته‌ای عرض کنیم تو این فرصت ده دقیقه‌ای رو بهمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.0,
   "end": 53.52,
   "text": "\"و وعدنا موسی ثلاثین ليلة وأتممناه بعشر فتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.52,
   "end": 56.32,
   "text": "ميقات ربه أربعين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.32,
   "end": 60.84,
   "text": "ليلة\". سی شب میشه چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.84,
   "end": 64.86,
   "text": "شب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.86,
   "end": 71.48,
   "text": "اینجا به یک معنا داره تصریح می‌کنه جایگاه ليل رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.48,
   "end": 74.5,
   "text": "اینجا می‌تونست خدا بفرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.5,
   "end": 81.7,
   "text": "سی شبانه روز دیگه حضرت موسی که فقط شب نرفته بود به میقات که \"لیلا و نهارا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.7,
   "end": 88.98,
   "text": "یا بگه سی روز، چهل روز \"أربعين نهارا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.98,
   "end": 92.76,
   "text": "اما می‌فرماید \"ليلة\". این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.76,
   "end": 95.48,
   "text": "ارزش و اهمیت ليل رو می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.48,
   "end": 100.18,
   "text": "در حقیقت چکیده و زبده و خلاصه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.18,
   "end": 102.8,
   "text": "میقات رو داره میگه که میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.8,
   "end": 106.72,
   "text": "کأنه می‌خواد بفرماید اصلاً همه اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.72,
   "end": 113.38,
   "text": "مدنظر ما بود و همه اونچه که ما آماده کردیم و همه اونچه که هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.38,
   "end": 121.14,
   "text": "و غم این كليم الله بود تو اون ساعات شب اتفاق افتاده و می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.14,
   "end": 126.56,
   "text": "این جایگاه شبه. اتفاقاً اون ارتباط قصر با دریا که شب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.56,
   "end": 130.18,
   "text": "قدر در خصوصش صحبت کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.18,
   "end": 133.42,
   "text": "این ارتباط قصر با دریا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.42,
   "end": 138.28,
   "text": "در بهترین زمان ممکنش ليل اتفاق می‌افته خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.28,
   "end": 141.6,
   "text": "با آرامش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.6,
   "end": 144.24,
   "text": "ليل قبلاً هم اینجا گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.24,
   "end": 146.46,
   "text": "حضرت استاد می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.46,
   "end": 151.08,
   "text": "در شب یکی از خصوصیات بسیار زیاد شب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.08,
   "end": 157.14,
   "text": "اصلاً خود شب حالا فارغ از نماز شب نه خود شب سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.14,
   "end": 160.76,
   "text": "با هید و چشم یعنی بیداری شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.76,
   "end": 164.42,
   "text": "فرمودند که شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.42,
   "end": 170.2,
   "text": "هرچه به نماز صبح نزدیک‌تر میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.2,
   "end": 174.44,
   "text": "این هوا پاک‌تر می‌شه، تصفیه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.44,
   "end": 180.46,
   "text": "خون انسان حتی. یه رابطه‌ای در بحث تطابق بین عالم و آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.46,
   "end": 183.7,
   "text": "قبلاً عرض کردیم وجود دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.7,
   "end": 189.14,
   "text": "که هر اتفاقی پیرامون ما در طبیعت رخ می‌ده ها نه غیر طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.14,
   "end": 194.02,
   "text": "یعنی مثلاً کسی گناه می‌کنه طبیعت که گناهکار نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.02,
   "end": 197.38,
   "text": "به صورت غیرطبیعی داره گناه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.38,
   "end": 201.54,
   "text": "اون اتفاقات طبیعی پیرامون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.54,
   "end": 208.94,
   "text": "که در آسمان و زمین و کوه و دشت و دمن و فضا و هوا و این‌ها اتفاق می‌افته اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.94,
   "end": 211.16,
   "text": "مثالش در ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.16,
   "end": 214.74,
   "text": "همونطور که عوالمی در بیرون اگر هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.74,
   "end": 217.8,
   "text": "رتبه‌های اون چنینی در ما هست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.8,
   "end": 223.12,
   "text": "مثلاً عالم مثال اگر بیرون هست در ما هم رتبه مثالی هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.12,
   "end": 231.1,
   "text": "این‌ها هم هست. یعنی تصفیه بیرون از ما تصفیه هوا در سحر و در شب و در ليل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.1,
   "end": 233.76,
   "text": "در خون ما هم در درون اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.76,
   "end": 236.68,
   "text": "خون ما هم شب تصفیه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.68,
   "end": 241.22,
   "text": "یعنی می‌خوام بگم این تطابق، تطابق بین عالم و آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.22,
   "end": 244.28,
   "text": "انقدر دقیقه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.28,
   "end": 246.4,
   "text": "این ببینید حیوانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 246.4,
   "end": 253.38,
   "text": "مگر مریض شن یا بمیرن و الا اصلاً ساعت خواب و بیداریشون کاملاً تنظیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.38,
   "end": 257.74,
   "text": "مشخصه که بیدار شن که بخوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.74,
   "end": 262.06,
   "text": "ولی انسان این تطابقو به هم می‌زنه و دچار مشکلات می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.06,
   "end": 267.2,
   "text": "و اینجا نشون میده که شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.2,
   "end": 270.38,
   "text": "ليل به مراتب بالاتر از، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.38,
   "end": 279.0,
   "text": "نهار و روز هست. نکته بعد اگر چنانچه خاطرتون باشه در آیه هفتاد و یک و هفتاد و دو سوره قصص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 279.0,
   "end": 283.04,
   "text": "اونجا که فرمود \"قل أرأيت إن جعل الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.04,
   "end": 289.92,
   "text": "عليكم الليل سرمدا إلى يوم القيامة\" دوباره عین همین در آیه بعدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 289.92,
   "end": 293.08,
   "text": "اما جعل، \"جعل الله عليكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 293.08,
   "end": 297.46,
   "text": "نهارا سرمدا إلى يوم القيامة\" اونجایی که بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 297.46,
   "end": 301.98,
   "text": "ليل بود آخرش فرمود \"أفلا تسمعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.98,
   "end": 304.48,
   "text": "در شب بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.48,
   "end": 306.9,
   "text": "سمع رو مطرح می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 306.9,
   "end": 310.32,
   "text": "و اونجایی که بحث نهار بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.32,
   "end": 312.44,
   "text": "آخرش \"أفلا تبصرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.44,
   "end": 316.7,
   "text": "عرض کردیم که صراحتاً اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.7,
   "end": 320.34,
   "text": "شهود رو به روز می‌زنه این آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.34,
   "end": 323.38,
   "text": "و شنود رو به شب. باز اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.38,
   "end": 328.28,
   "text": "وقتی \"و وعدنا موسی ثلاثین ليلة\" مطرح هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.28,
   "end": 337.46,
   "text": "پیداست که یکی از رموز شب که مهم‌تر شده از روز همون شنوده در شبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.46,
   "end": 344.16,
   "text": "شنود هم شب‌های قدر شب بیست و سوم بود دیگه ظاهراً عرض کردیم که مهم‌تر از شهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 344.16,
   "end": 347.32,
   "text": "شنود مهم‌تره. قرآن اصلاً شنوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 347.32,
   "end": 351.12,
   "text": "قرآن شنود بوده. خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 351.12,
   "end": 354.2,
   "text": "استماع قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 354.2,
   "end": 357.96,
   "text": "یا خود تلقی قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 357.96,
   "end": 363.4,
   "text": "شنود بوده که البته حقایقش به شهود نشسته اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 363.4,
   "end": 367.9,
   "text": "به شنود کسب تلقی شده و اخذ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 367.9,
   "end": 371.88,
   "text": "این نشون میده که شنود چقدر مهمه و شنود مال کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 371.88,
   "end": 378.0,
   "text": "به، بر اساس همین آیه هفتاد و یک سوره قصص مال لیله، مال شبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 378.0,
   "end": 384.3,
   "text": "شنود. پس این نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 384.3,
   "end": 387.58,
   "text": "لیلی مورد نظر قرآنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 387.58,
   "end": 392.06,
   "text": "شنود درش اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 392.06,
   "end": 401.36,
   "text": "اگر غضabأسارکن ترون العجائب چشماتونو ببندید تا عجایب عالم رو ببینید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 401.36,
   "end": 406.58,
   "text": "گوشاتون رو هم ببندید، ببندید تا عجایب عالم رو بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 406.58,
   "end": 415.34,
   "text": "کسی که شب تا سحر پا تلویزیونه و داره این سریالو می‌بینه، اون فیلمو می‌بینه، این برنامه رو می‌بینه، هزاران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 415.34,
   "end": 421.14,
   "text": "چهره عجیب و غریب تو تلویزیون داره می‌بینه، این متخیلات فاسده بیچاره‌ش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 421.14,
   "end": 425.34,
   "text": "مشوش می‌شه قوه خیالش اصلاً دیگه نمی‌تونه با آرامش-- پس شنود چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 425.34,
   "end": 430.56,
   "text": "این حرفا چیه؟ هنر کنه دور کرد نماز شب بزنه به کمرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 430.56,
   "end": 432.8,
   "text": "بعداً ادعا کنه که ما نماز شب خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 432.8,
   "end": 437.22,
   "text": "نه اینطوری نه. شنود وا-- مال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 437.22,
   "end": 439.38,
   "text": "تمرکز قواست. مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 439.38,
   "end": 443.0,
   "text": "تسویه درون، ارتباط درون با بیرونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 443.0,
   "end": 449.28,
   "text": "بیرون تسویه می‌شه، هوای سنگین جاشو به هوای سبک میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 449.28,
   "end": 450.94,
   "text": "درون همین اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 450.94,
   "end": 454.12,
   "text": "اما ما این توازن رو به هم می‌زنیم با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 454.12,
   "end": 460.12,
   "text": "متاسفانه سبک زندگی غیر اسلامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 460.12,
   "end": 467.44,
   "text": "یعنی بسیاری از این برنامه‌ها حتی برنامه‌هایی که ظاهراً خوب هم هستن تو تلویزیون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 467.44,
   "end": 471.74,
   "text": "حالا من خیلی اینو نمی‌خوام توش ورود کنم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 471.74,
   "end": 475.1,
   "text": "ظرفیت و پذیرشش این‌ها شنیدنش تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 475.1,
   "end": 477.86,
   "text": "اکثراً نیست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 477.86,
   "end": 482.24,
   "text": "میگن آقا رسانه رو زد و مثلاً علم روز رو تخته کرد و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 482.24,
   "end": 487.74,
   "text": "نه ما بحث‌های علمی دقیقی می‌کنیم که به دردمون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 487.74,
   "end": 490.82,
   "text": "اکثرهم لا يعقلون. اکثرهم لا يتدبرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 490.82,
   "end": 493.22,
   "text": "اکثرهم لا يفقهون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 493.22,
   "end": 496.72,
   "text": "قرآن میگه صریحاً. حالا دلیل نداره که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 496.72,
   "end": 501.44,
   "text": "مردم جلوی این قاب نشستن پس اگر ما نشستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 501.44,
   "end": 505.64,
   "text": "حالا نه، اصلاً خیال رو فاسد می‌کنه، مشوش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 505.64,
   "end": 509.6,
   "text": "دیدن این چهره‌ها تو تلویزیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 509.6,
   "end": 513.66,
   "text": "من ااا بسیاری از برنامه‌ها البته اصلاً که خیلی کم می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 513.66,
   "end": 520.46,
   "text": "بسیاری برنامه هم که می‌بینم نگاه نمی‌کنم معمولاً فقط می‌شنوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 520.46,
   "end": 523.96,
   "text": "آثار به شدت مخربی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 523.96,
   "end": 527.1,
   "text": "حالا این طرف نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 527.1,
   "end": 529.42,
   "text": "انواع و اقسام چهره‌ها رو دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 529.42,
   "end": 533.4,
   "text": "بعد این چهره‌ها انتقال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 533.4,
   "end": 539.28,
   "text": "موج دارن. حالا این‌ها چیزایی است که من نمی‌خوام خیلی ورود کنم درش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 539.28,
   "end": 542.7,
   "text": "بحث‌های علمی هم از من درآوردی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 542.7,
   "end": 549.2,
   "text": "چشم‌ها حتی از راه دور حتی به وسیله رسانه اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 549.2,
   "end": 555.52,
   "text": "اثر می‌کنن و حتی اون حرف‌هایی که اونو می‌زنن، نیاتی که دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 555.52,
   "end": 560.16,
   "text": "اینکه اصلاً اون برنامه به چه خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 560.16,
   "end": 563.24,
   "text": "ایجاد شده، درست شده، اینا شما که خبر ندارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 563.24,
   "end": 567.0,
   "text": "ما که تو رسانه هستیم می‌دونیم چه وحشتناکه پشت پرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 567.0,
   "end": 574.42,
   "text": "خیلی از این برنامه‌ها. سر دکورش بگیر که دکورهای میلیاردی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 574.42,
   "end": 577.92,
   "text": "چه بخور بخوری توش هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 577.92,
   "end": 582.06,
   "text": "پول کارمندا رو نداره بده سه تا سیما ولی میلیاردی پول دکور میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 582.06,
   "end": 585.48,
   "text": "اون دکورم مثلاً یه میلیارد تموم شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 585.48,
   "end": 588.28,
   "text": "سه میلیارد فاکتور می‌کنه، دو میلیاردش رو می‌ذاره تو جیبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 588.28,
   "end": 590.84,
   "text": "بماند این حرفا ما نباید اینو بگیم بره بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 590.84,
   "end": 593.04,
   "text": "ولی خیلی چیزا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 593.04,
   "end": 599.18,
   "text": "حالا من یه شمه‌ای گفتم که بدونید همینطوری بی‌اطلاع نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 599.18,
   "end": 601.2,
   "text": "و انواع و اقسام مطالبی که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 601.2,
   "end": 605.32,
   "text": "خلاصه بعد ما توقع خیر از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 605.32,
   "end": 608.82,
   "text": "قاب داریم. توقع خیر داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 608.82,
   "end": 616.44,
   "text": "بعدم بعد از اون می‌خوایم بشینیم به سجده و حال خوش و نماز شب و لیل و شاید این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 616.44,
   "end": 621.08,
   "text": "خلوت، عزلت، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 621.08,
   "end": 624.3,
   "text": "سمت و سو، سمت و جو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 624.3,
   "end": 627.64,
   "text": "سحر و خلوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 627.64,
   "end": 631.64,
   "text": "حالا بعضیا گفتن عزلت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 631.64,
   "end": 634.28,
   "text": "عزلت و ذکر به دوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 634.28,
   "end": 635.92,
   "text": "بعضیا گفتن خلوت و ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 635.92,
   "end": 639.0,
   "text": "در هر حال چه عزلت، چه خلوت که بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 639.0,
   "end": 641.44,
   "text": "خلوت رو بهتر می‌پسندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 641.44,
   "end": 644.94,
   "text": "تا عزلت. خلوت و ذکر به دوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 644.94,
   "end": 650.12,
   "text": "می‌شه انسان عزلت بگزیند اما خلوت نداشته باشد باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 650.12,
   "end": 652.4,
   "text": "قوه خیالش مشوش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 652.4,
   "end": 656.62,
   "text": "مملو از صور و اشکال موهشه و مدهشه بیچاره‌ش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 656.62,
   "end": 659.84,
   "text": "ولی خلوت نه. یعنی اصلاً اسمش رو خودش خلوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 659.84,
   "end": 662.76,
   "text": "حتی می‌شه انسان تو جمع هم باشه اما خلوت باشه سرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 662.76,
   "end": 666.2,
   "text": "\"کن في الناس ولا تكن معهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 666.2,
   "end": 670.24,
   "text": "معهم\". این‌ها نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 670.24,
   "end": 675.54,
   "text": "باید عوامل متعددی دست به دست هم بدهند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 675.54,
   "end": 678.0,
   "text": "که \"فصحتج بهي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 678.0,
   "end": 682.22,
   "text": "نافلة الليل. أصى يبعثك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 682.22,
   "end": 686.82,
   "text": "ربك مقاماً محموداً\" بلکه اون مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 686.82,
   "end": 691.04,
   "text": "ستوده شده محمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 691.04,
   "end": 696.04,
   "text": "انشا-- ایجاد بشه. اون توسط حضرت حق هبه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 696.04,
   "end": 704.38,
   "text": "که البته واسطه‌ش هم چون بحث هبه‌ست هبات و منح رو قبلاً گفتیم که هر کجا منح و هبات باشد در سلسله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 704.38,
   "end": 709.42,
   "text": "طولی نزول فیض کی اینجا دستش در کاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 709.42,
   "end": 712.02,
   "text": "حضرت شیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 712.02,
   "end": 716.46,
   "text": "یا شیث نبی. در فس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 716.46,
   "end": 718.86,
   "text": "شیثی، دومین فس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 718.86,
   "end": 724.73,
   "text": "فسوس الحکم، اونجا علامه این رو تشریح می‌کنه که از-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 724.73,
   "end": 728.69,
   "text": "هر کدوم از انبیا یه خصوصیت خاصی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 728.69,
   "end": 734.45,
   "text": "راست شد؟ اون خصوصیت خاص حضرت شیس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 734.45,
   "end": 736.21,
   "text": "اصلاً اسمشم هبت اللهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 736.21,
   "end": 739.21,
   "text": "هبت الله. هبه شده به حضرت آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 739.21,
   "end": 743.59,
   "text": "وقتی از تهابیل توسط قابیل کشته شد، شهید شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 743.59,
   "end": 746.35,
   "text": "سوز دل حضرت آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 746.35,
   "end": 751.53,
   "text": "به قدری شد که این سوختن، سوختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 751.53,
   "end": 757.29,
   "text": "ظرفیت درونی درش ایجاد شد که خدا به او هبه کنه هبت الله و نجت سیر...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 757.29,
   "end": 763.09,
   "text": "تمام انبیا از نسل ایشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 763.09,
   "end": 766.93,
   "text": "اون سوختن که ان الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 766.93,
   "end": 769.53,
   "text": "حالا اعتیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 769.53,
   "end": 773.71,
   "text": "یادتون هست فرمولشو؟ على قدر القابليات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 773.71,
   "end": 779.45,
   "text": "وقتی سوخت قابلیت عطا‌های الهی منح و هبات رو پیدا کرد هبت الله رو بهش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 779.45,
   "end": 781.89,
   "text": "از اون به بعد هر هبه‌ای منحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 781.89,
   "end": 784.57,
   "text": "اینها اتفاق بیفته از ناحیه ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 784.57,
   "end": 790.31,
   "text": "مثل اینکه من یه بار گفتم ما تهرانی‌ها به قول آقا بهجت هرچی می‌گیریم از سیدالکریم می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 790.31,
   "end": 794.51,
   "text": "خبر نداریم. یعنی سر سفره‌ی سیدالکریمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 794.51,
   "end": 800.85,
   "text": "سلسله طولیه‌ فیض هست یعنی امام عصر به ما میده اما از طریق ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 800.85,
   "end": 803.57,
   "text": "اونجا هم اینطوریه هر منح و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 803.57,
   "end": 809.23,
   "text": "و مواهب الهی، اسم الوحا به حضرت حق که می‌خواد پیاده بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 809.23,
   "end": 813.53,
   "text": "یه دستی که تو کاره دست حضرت شیسه حتما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 813.53,
   "end": 816.93,
   "text": "پس اون سوختن به اونجا رسید حضرت آدم و یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 816.93,
   "end": 820.65,
   "text": "حالا اینا هر کدومش یه منبر می‌طلبه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 820.65,
   "end": 822.95,
   "text": "دیگه ما سریع وقتمونم کمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 822.95,
   "end": 829.69,
   "text": "بسه دیگه امشب. یکی دیگه از خصوصیات شب سوختن، انسان رو به سوختن نزدیک می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 829.69,
   "end": 833.71,
   "text": "که روز اینطوری نیست. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 833.71,
   "end": 836.05,
   "text": "یه صلوات بفرستین. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 836.05,
   "end": 839.65,
   "text": "صل على محمد و آل محمد و عجل فرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 839.65,
   "end": 847.67,
   "text": "خیلی کوتاه. نیاز به ساعت دارم که مناجاتمون وقتش بیشتر از یازده نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 847.67,
   "end": 857.97,
   "text": "ببخشید. یه چهل دقیقه وقت داریم ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 857.97,
   "end": 868.27,
   "text": "البته قبلاً توی توی یه جلسه‌ای خیلی گذرا یه چیزی رو ما گفتیم و رد شدیم هیچکس هم توجه نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 868.27,
   "end": 872.77,
   "text": "اونم اینکه گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 872.77,
   "end": 875.95,
   "text": "درسته لیلة القدر بیست و چهار ساعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 875.95,
   "end": 880.05,
   "text": "یعنی کلاً قدر بیست و چهار ساعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 880.05,
   "end": 882.41,
   "text": "شب تا صبح لیله قدر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 882.41,
   "end": 887.23,
   "text": "صبح تا غروبم روز قدر که عین شب قدر قدر و قیمت و اندازه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 887.23,
   "end": 891.31,
   "text": "عین همن هیچ فرقی نمی‌کنه. کسی شب جا مونه روز هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 891.31,
   "end": 897.75,
   "text": "که ما فیض که نازل میشه یه آنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 897.75,
   "end": 903.27,
   "text": "این یه نکته‌ست. آنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 903.27,
   "end": 908.49,
   "text": "لذا قدر آنات رو باید دونست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 908.49,
   "end": 914.19,
   "text": "این که حالا مناجات یک ساعته دو ساعته شش ساعته یا یک لحظه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 914.19,
   "end": 916.75,
   "text": "مهم اون آنیه که فیض می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 916.75,
   "end": 923.23,
   "text": "اونجا آدم باید دامن‌شو پر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 923.23,
   "end": 924.89,
   "text": "یه صلوات دیگه ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 924.89,
   "end": 928.77,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}