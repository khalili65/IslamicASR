 "chapters": [
  {
   "index": 0,
   "title": "## آغاز جلسه و جایگاه معرفت نفس",
   "start": 1.3,
   "end": 36.74
  },
  {
   "index": 1,
   "title": "## ادامهٔ بحث: همه چیز به مزاج مربوط است",
   "start": 36.74,
   "end": 65.44
  },
  {
   "index": 2,
   "title": "اولاً آیاتی از قرآن هست که نشان می‌دهد همه چیز زوج آفریده شده است. مثلاً آیهٔ سی‌وشش سورهٔ یس:",
   "start": 65.44,
   "end": 130.4
  },
  {
   "index": 3,
   "title": "مثلاً آیهٔ چهل‌ونه سورهٔ ذاریات که می‌فرماید:",
   "start": 130.4,
   "end": 163.16
  },
  {
   "index": 4,
   "title": "## مصادیق تناکح و ازدواج در هستی",
   "start": 163.16,
   "end": 217.82
  },
  {
   "index": 5,
   "title": "## روح بخاری؛ برزخ میان ظاهر و باطن",
   "start": 217.82,
   "end": 311.8
  },
  {
   "index": 6,
   "title": "## آباء سبعه، امهات اربعه و موالید ثلاثه",
   "start": 311.8,
   "end": 381.32
  },
  {
   "index": 7,
   "title": "قرآن می‌فرماید:",
   "start": 381.32,
   "end": 443.67
  },
  {
   "index": 8,
   "title": "## از عناصر چهارگانه تا اخلاط اربعه",
   "start": 443.67,
   "end": 511.71
  },
  {
   "index": 9,
   "title": "## روح بخاری؛ مطیّهٔ نفس ناطقه",
   "start": 511.71,
   "end": 574.68
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.3,
   "end": 9.06,
   "text": "بسم الله الرحمن الرحیم و بهین استعین السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.06,
   "end": 13.68,
   "text": "چون ما موضوع‌مون معرفت نفسه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.68,
   "end": 18.96,
   "text": "در حقیقت میشه گفت ما موضوعی مهم‌تر از این موضوع نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.96,
   "end": 27.94,
   "text": "و به درخواست دوستان که این مباحث حفظ بشه و بلکه تو کانال هم بارگذاری بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 27.94,
   "end": 32.92,
   "text": "ما سعی کردیم که حداقل از جلسه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 32.92,
   "end": 36.74,
   "text": "فکر می‌کنم دو جلسه پیش به این ور رو ضبط کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 36.74,
   "end": 40.9,
   "text": "ادامه بحث ما اگر یادتون باشه به کجا رسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.9,
   "end": 45.38,
   "text": "به اینجا که در سیر شناخت خودمون به اینجا رسیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.38,
   "end": 48.66,
   "text": "همه چی به مزاج ربط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.66,
   "end": 52.06,
   "text": "رسیدیم به اینجا که ما یک بدن داریم، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.06,
   "end": 54.28,
   "text": "که مرتبه ظاهر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.28,
   "end": 59.06,
   "text": "یک نفس یا روح داریم که مرتبه باطن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.06,
   "end": 62.68,
   "text": "و گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.68,
   "end": 67.54,
   "text": "اخذ ما، تلقیات ما از بیرون همه بستگی به مزاج ما داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.54,
   "end": 71.46,
   "text": "حالا خود مزاج الا ماشاءالله براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.46,
   "end": 73.17,
   "text": "بزرگان قلم زدن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.17,
   "end": 77.58,
   "text": "مثلا شیخ الرئیس نمت‌های دوم، سوم یا چ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.58,
   "end": 83.16,
   "text": "سوم مخصوصا اشارات رو بخونید چقدر زیبا پیرامون مزاج حرف زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.16,
   "end": 86.76,
   "text": "من امروز به صورت کلی یه نکته‌ای رو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.76,
   "end": 93.34,
   "text": "اولا آیه از-- آیاتی از قرآن هست که نشون میده همه چی زوج آفریده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.34,
   "end": 100.9,
   "text": "مثلا آیه سی و شش سوره یاسین: سبحان الذي خلق الازواج كلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.9,
   "end": 105.94,
   "text": "همه چی. مما از بگیر مما تنبت الارض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.94,
   "end": 108.32,
   "text": "از اون چیزی که از زمین می‌رویه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.32,
   "end": 112.14,
   "text": "و من انفسهم اونکه در جانشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.14,
   "end": 115.76,
   "text": "و مما لا يعلمون حتی چیزایی که نمی‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.76,
   "end": 120.06,
   "text": "اینا نمی‌دونن خبر ندارن هم اینام زوج زوج آفریده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.06,
   "end": 125.18,
   "text": "مثلا آیه چهل و نه سوره ذاریات که می‌فرماید: و من کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.18,
   "end": 130.4,
   "text": "من کل شيء خلقنا زوجين لعلكم تذكرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.4,
   "end": 135.92,
   "text": "همه چیز رو برای شما زوج زوج خلق کردیم بلکه اهل تذکر باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.92,
   "end": 139.1,
   "text": "باز مثلا آیه بیست و یک روم:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.1,
   "end": 147.38,
   "text": "و من آياتهِ أن خلق لكم من أنفسكم أزواجًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 147.38,
   "end": 152.62,
   "text": "که فکر می‌کنم بقیش این باشه که لتسکنوا اليها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 152.62,
   "end": 156.84,
   "text": "خلاصه اینکه این مزاج یعنی ازدواج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 156.84,
   "end": 160.24,
   "text": "زوج زوج بودن همه جا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 160.24,
   "end": 163.16,
   "text": "خدا اینطوری ایجاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 163.16,
   "end": 168.8,
   "text": "البته این تناکح یا نکاح یا ازدواج مصادیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 168.8,
   "end": 174.74,
   "text": "بسیار زیادی داره. چندتاشو من مثلا بگم یه مقدار ذهنتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 174.74,
   "end": 177.96,
   "text": "ذهنتون رو بشورونم با این چند تا نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 177.96,
   "end": 182.24,
   "text": "بعد دوست داشتید حالا این‌ها رو یه مقدار مبسوط‌تر دربارش صحبت کنیم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.24,
   "end": 184.46,
   "text": "مثلا عقل کل و نفس کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.46,
   "end": 188.36,
   "text": "این‌ها با هم ازدواج کردن. ازدواج بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.36,
   "end": 194.32,
   "text": "روح و بدن. ازدواج بین علم و عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 194.32,
   "end": 197.52,
   "text": "ازدواج بین آسمان و زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 197.52,
   "end": 200.1,
   "text": "ازدواج بین وجود و ماهیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.1,
   "end": 206.34,
   "text": "این‌ها هم آیات بر این‌ها داریم، هم روایات، هم گفتار حکما و بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 206.34,
   "end": 212.38,
   "text": "خیلی شیرین بحث‌های جالب و عالی که بعد این‌ها رو می‌بینیم همش در خود ما پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 212.38,
   "end": 217.82,
   "text": "بعدا رفته رفته می‌بینیم اه چه جالب این‌ها همه در ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.82,
   "end": 222.84,
   "text": "یکی از رتبه‌های وجودی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 222.84,
   "end": 230.26,
   "text": "که به یک معنا باز میشه گفت برزخ بین ظاهر و باطن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 230.26,
   "end": 233.02,
   "text": "بهش میگن -سلام علیکم رحمت الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 233.02,
   "end": 236.64,
   "text": "که اون هم در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 236.64,
   "end": 242.84,
   "text": "متولد شده این زوج‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 242.84,
   "end": 246.76,
   "text": "بین بدن و نفس واقع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 246.76,
   "end": 252.44,
   "text": "یعنی انقدر لطیفه، انقدر ظریفه رفته لای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 252.44,
   "end": 256.68,
   "text": "نفس و بدن. خود نفس یه مرتبه از پنهان ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 256.68,
   "end": 259.88,
   "text": "یک جای خاصی قرار گرفته. بهش میگن روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 259.88,
   "end": 262.62,
   "text": "البته خوبه بدونید روح نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 262.62,
   "end": 265.44,
   "text": "جسمه، جنسیتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 265.44,
   "end": 271.8,
   "text": "مادیه. اما انقدر که لطیفه بلکه التفه، لطیف‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 271.8,
   "end": 275.44,
   "text": "اجسامه بهش میگن روح، روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 275.44,
   "end": 280.98,
   "text": "اینو من امروز فقط تو همین فکر می‌کنم سه دقیقه بیشتر وقت نداشته باشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 280.98,
   "end": 283.78,
   "text": "سریع بگم از کجا ایجاد شده، ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 283.78,
   "end": 286.28,
   "text": "حالا بعد خصوصیاتش رو جلسات بعد میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 286.28,
   "end": 289.36,
   "text": "خوبه ما اینا رو بدونیم، به دردمون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 289.36,
   "end": 292.82,
   "text": "خیلی از گیر و گورهای ما به خاطر اینه که این‌ها رو نمی‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.82,
   "end": 297.62,
   "text": "بعدا متوجه می‌شیم چرا؟ اصلا دانستن این‌ها به چه درد ما می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 297.62,
   "end": 301.56,
   "text": "حتی مشکلات اخلاقی و اعتقادی و معنوی که داریم‌ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 301.56,
   "end": 303.68,
   "text": "مثلا نماز به ما حال نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 303.68,
   "end": 308.56,
   "text": "بعدا متوجه می‌شیم که علتش ندانستن این چیزاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 308.56,
   "end": 310.32,
   "text": "ما دنبال چیزای دیگه می‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 310.32,
   "end": 313.16,
   "text": "حالا بماند. ما یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 313.16,
   "end": 314.8,
   "text": "آباء سبعه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.8,
   "end": 317.68,
   "text": "نترسید از این الفاظ و کلمات توضیح میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.68,
   "end": 322.98,
   "text": "یک امهات اربعه داریم یا موالید ثلاثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 322.98,
   "end": 328.82,
   "text": "اینا رو من بگم سریع چی‌ان. ام آباء سبعه یعنی هفت تا پدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 328.82,
   "end": 331.92,
   "text": "هفت فلک. به همین راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 331.92,
   "end": 337.82,
   "text": "هفت تا فلکن. از همین ناهید بگیر از ماه بگیر برو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.82,
   "end": 340.44,
   "text": "افلاک رو که همین هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.44,
   "end": 349.22,
   "text": "کدوم از این سیاره‌ها که خورشید وسطشون واقع شده بگیر تا آخریش که حالا زحل میشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 349.22,
   "end": 353.06,
   "text": "ختم میشه که بعد از اون میشه کرسی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 353.06,
   "end": 355.22,
   "text": "عرش تو همین دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 355.22,
   "end": 365.43,
   "text": "تو همین نشئیت طبیعت کرسی و عرش هم داریم که اون میشه فلک هشتم و نهم و هر کدوم بسیار توضیحات می‌خواد بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 365.43,
   "end": 369.55,
   "text": "اون هفت تا پدرن که محل تاثیرگذاری‌ن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 369.55,
   "end": 374.59,
   "text": "محل دهشن. گیرنده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 374.59,
   "end": 378.71,
   "text": "ماده‌ست. گیرنده مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 378.71,
   "end": 384.37,
   "text": "میگه قرآن می‌فرماید \"زنان شما زمین کشاورز شماست\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 384.37,
   "end": 387.53,
   "text": "دانه‌ها در زمین کاشته می‌شه، زمین این‌ها رو می‌پرورانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 387.53,
   "end": 390.57,
   "text": "میگه برای همین عاشق چشم و ابروی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 390.57,
   "end": 398.43,
   "text": "خانومت نشو. برو از یک زمین مرغوب به دردبخور که می‌خوای دانه رو درش به کا-- بکاری بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 398.43,
   "end": 402.41,
   "text": "که بحث‌های تربیتی پیش میاد بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 402.41,
   "end": 405.61,
   "text": "پس امهات اربعه کیان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 405.61,
   "end": 413.23,
   "text": "چهار تا مادر که اون هفت تا پدر در این تاثیر می‌گذاره در این چهار تا مادر که سه تا فرزند ازش به وجود میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 413.23,
   "end": 415.05,
   "text": "اونا عناصر چهارگانه ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 415.05,
   "end": 417.97,
   "text": "چی‌ان؟ هوا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 417.97,
   "end": 419.79,
   "text": "هوا، همین هوایی که حول شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 419.79,
   "end": 423.41,
   "text": "هوا و آب و خاک و حرارت یا آتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 423.41,
   "end": 426.35,
   "text": "این چهار تا عناصری‌اند که خدا خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 426.35,
   "end": 431.01,
   "text": "اون هفت فلک بر این چهار تا عنصر که ماده‌اند تاثیر می‌گذارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 431.01,
   "end": 441.09,
   "text": "تاثیر کواکب. که نهله‌های بیخودی امروز اومدن از این علوم به حق استفاده‌های نابحق کردن که او تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 441.09,
   "end": 443.49,
   "text": "دلت بخواد بحث اینجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 443.49,
   "end": 449.57,
   "text": "خب حالا اونچه که از این دو تا پدر و مادر به وجود اومده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 449.57,
   "end": 451.95,
   "text": "سه تا بچه به وجود اومده بهش میگن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 451.95,
   "end": 456.89,
   "text": "یه ترتیب بگیم. معدن که همون معدنی‌‌هاست یا درستش معدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.89,
   "end": 461.07,
   "text": "جمادات، جمادات همین سنگ و خاک و گل و این چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 461.07,
   "end": 464.95,
   "text": "بعد نباتات، بعدم حیوانات و ملحقاتشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 464.95,
   "end": 470.09,
   "text": "لواحقشون که انسان ملحق می‌شه به اون حیوانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 470.09,
   "end": 473.03,
   "text": "انسان حیوان ناطقه همینطور لواحق داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 473.03,
   "end": 477.03,
   "text": "این سه تا بچه ها هستن. حالا از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 477.03,
   "end": 479.51,
   "text": "از تاثیر-- چه ربطی به روح بخاری داشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 479.51,
   "end": 485.17,
   "text": "از تاثیرات ازدواج اون عناصر چهارگانه با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 485.17,
   "end": 490.15,
   "text": "که عناصر چهارگانه بر اثر تأثیری که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 490.15,
   "end": 495.23,
   "text": "اون هفت فلک می‌گیرن اینا با هم مزدوج می‌شن، مزاج درست می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 495.23,
   "end": 498.77,
   "text": "از مزاج این عناصر چهارگانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 498.77,
   "end": 501.11,
   "text": "اخلاط اربعه درست می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 501.11,
   "end": 505.33,
   "text": "اخلاط چهارگانه. دم و بلغم و سودا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 505.33,
   "end": 511.71,
   "text": "صفرا. بعد از ازدواج، حالا اینا هر کدوم بحث داره بماند وقت من تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 511.71,
   "end": 514.45,
   "text": "از ازدواج این پنج-- چهار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 514.45,
   "end": 516.97,
   "text": "اخلاط اربعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 516.97,
   "end": 526.09,
   "text": "چی درست می‌شه؟ روح بخاری که در همه ما هست و ر-- خون ما در روح بخاری جریان داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 526.09,
   "end": 530.09,
   "text": "این روح بخاری اثر مستقیم داره بهش میگن متیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 530.09,
   "end": 532.71,
   "text": "متیه اولای نفس ناطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 532.71,
   "end": 537.29,
   "text": "یعنی یک اسب همراه هموار که نفس ناطقه بر او سواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 537.29,
   "end": 541.83,
   "text": "حالا بفرمایید ببینم اگر سوار یک اسب شل بشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 541.83,
   "end": 544.41,
   "text": "یه اسبی که چشم نداره بشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 544.41,
   "end": 549.87,
   "text": "اسبی که جون نداره درست مثلاً غذا نخورده، تشنه شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 549.87,
   "end": 553.55,
   "text": "بیش از حد چاقه، بیش از حد لاغره، مشکلات داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 553.55,
   "end": 556.01,
   "text": "چگونه می‌خوای تو حرکت کنی با این اسب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 556.01,
   "end": 559.99,
   "text": "الان اسب یعنی مرکب نفس ناطقه ما چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 559.99,
   "end": 562.79,
   "text": "تا امروز اینو فهمیدیم. نه، چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 562.79,
   "end": 569.83,
   "text": "روح بخاری. حالا بعداً بفهمیم که چه تاثیراتی در انواع و اقسام عملیات زندگی ما داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 569.83,
   "end": 574.68,
   "text": "بماند طلبتم. والحمد لله رب العالمین. صلوات بفرستید. صلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}