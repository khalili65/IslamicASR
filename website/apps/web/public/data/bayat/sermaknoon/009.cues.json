 ],
 "cues": [
  {
   "i": 0,
   "start": 1.18,
   "end": 4.78,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.78,
   "end": 10.38,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.38,
   "end": 14.02,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.02,
   "end": 19.56,
   "text": "در خصوص یکی از معانی برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.56,
   "end": 23.6,
   "text": "وجودی‌مون که همون به یک معنا روح بخاریه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.6,
   "end": 26.88,
   "text": "نکته دیگری رو عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.88,
   "end": 31.86,
   "text": "وقتی حکیم میگه روح بخاریه منظور نفس ناطقه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.86,
   "end": 35.2,
   "text": "و وقتی طبیب میگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.2,
   "end": 37.82,
   "text": "وقتی حکیم میگه روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.82,
   "end": 40.22,
   "text": "منظور نفس ناطقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.22,
   "end": 43.38,
   "text": "وقتی طبیب میگه روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.38,
   "end": 51.66,
   "text": "منظور روح بخاریه. این‌ها را از حیث اینکه چه کسی میگه اصطلاح قوم به قول علامه باید حفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.66,
   "end": 57.16,
   "text": "که خود روح به معنای حقیقی که داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.16,
   "end": 60.44,
   "text": "که ازش تعبیر به من میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.44,
   "end": 63.76,
   "text": "از حیث اینکه، اینو خوب دقت کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.76,
   "end": 66.74,
   "text": "از حیث اینکه خود روح وقتی تعبیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.74,
   "end": 69.3,
   "text": "به صورت کلی اون روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.3,
   "end": 75.34,
   "text": "«و نفخت فیه من روحی» اون روح به عنوان نفس ناطقه یا هرچی، روح کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.34,
   "end": 85.62,
   "text": "وقتی ازش سخن گفته میشه در حکمت و عرفان از حیث اینکه تدبیر بدن میکنه بهش میگن نفس ناطقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.62,
   "end": 88.02,
   "text": "اینا رو خوبه بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.02,
   "end": 92.42,
   "text": "حالا تو کتابا میخونیم متوجه باشیم منظور چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.42,
   "end": 97.26,
   "text": "از حیث اینکه بدن رو زنده نگه داشته بهش میگن روح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.26,
   "end": 104.3,
   "text": "مطلقا. از حیث اینکه ادراک تفصیلی داره به جزئیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.3,
   "end": 110.5,
   "text": "یعنی ادراک میکنه، درک میکنه جزئیات رو نه فقط کلیات رو بهش میگن قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.5,
   "end": 117.0,
   "text": "همون روح رو بسته به اینکه به کدوم یک از جنبه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.0,
   "end": 124.06,
   "text": "این موهبت الهی که در باطن وجود ماست اشاره میشه، به کدوم توجه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.06,
   "end": 126.54,
   "text": "از حیث اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.54,
   "end": 131.06,
   "text": "کلیات رو درک میکنه، ادراک کلیات میکنه بهش چی میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.06,
   "end": 133.34,
   "text": "چی کلیات رو درک میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 133.34,
   "end": 136.42,
   "text": "عقل. آفرین. به همین راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.42,
   "end": 138.32,
   "text": "حالا وقت-- اینا حکیم و عارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.32,
   "end": 142.5,
   "text": "ولی وقتی طبیب میگه روح منظور روح بخاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.5,
   "end": 149.1,
   "text": "حالا یه فرمایشی از حضرت استاد علامه حائری یزدی علیه الرحمه براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.1,
   "end": 154.46,
   "text": "جالبه. میفرماید روح از الفاظ مشترک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.46,
   "end": 160.98,
   "text": "گاهی مراد از روح همان نفس ناطقه یا روح یا قلب یا عقل است که الان توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.98,
   "end": 166.44,
   "text": "منظورش رو من گفتم. و گاهی مراد از روح همان روح بخاریه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.44,
   "end": 174.22,
   "text": "تفاوت، تفاوت این دو معنا در این است که روح به معنای نفس ناطقه همان موجود مجرد است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 174.22,
   "end": 176.82,
   "text": "که تعلق تدبیری به بدن دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 176.82,
   "end": 179.66,
   "text": "یعنی علقه داره به این بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 179.66,
   "end": 182.78,
   "text": "اگرچه خودش از دل این بدن چون اجسمانیة حدوث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.78,
   "end": 189.4,
   "text": "هستیم به فرمایش ملاصدرا حکمت متعالیه نفس ناطقه از دل این بدن متکون شده، بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.4,
   "end": 193.96,
   "text": "این بدنه اما برعکس میشه بعد خودش مثل حکم پدر و مادر رو پیدا میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 193.96,
   "end": 195.62,
   "text": "بدن رو میکشه بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.62,
   "end": 201.48,
   "text": "چون تعلق داره بالاخره بین بچه و فرزند و پدر و مادر یه تعلق خاطری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.48,
   "end": 203.84,
   "text": "اما تعلق چیه؟ تدبیریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.84,
   "end": 205.98,
   "text": "بخواد بدن رو تدبیر کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.98,
   "end": 207.84,
   "text": "میگه تعلق تدبیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 207.84,
   "end": 210.1,
   "text": "از این حیث. میفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.1,
   "end": 218.2,
   "text": "که وقتی که بحث نفس ناطقه میشه منظور از روح به معنای ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 218.2,
   "end": 222.52,
   "text": "نفس ناطقه ازش برمی‌میشه همان موجود مجردیه که چیکار میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.52,
   "end": 224.2,
   "text": "تعلق تدبیری به بدن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.2,
   "end": 228.3,
   "text": "یعنی بدن رو تدبیر میکنه که اگه این نفس رو برداری چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.3,
   "end": 231.68,
   "text": "بدن متلاشی میشه، موت حاصل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.68,
   "end": 239.96,
   "text": "بعد ایشون ادامه میدن که بدون آنکه در بدن حلول کنه، یعنی نفس ناطقه اینطور نیست که حلول کرده باشه در بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.96,
   "end": 244.5,
   "text": "گفتیم مستقیم نفس با بدن در ارتباط نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.5,
   "end": 247.44,
   "text": "از چه طریقی؟ از طریق روح بخاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.44,
   "end": 252.28,
   "text": "البته از کانال خاف-- از کانال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.28,
   "end": 258.6,
   "text": "از شود قوه خیال که حالا بعداً درباره‌ش صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.6,
   "end": 263.74,
   "text": "خیلی هم اونجا حرف داریم ان‌شاءالله پی-- بزرگان پیاده کردن ما برای شما میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 263.74,
   "end": 268.88,
   "text": "از طریق اون به بدن مرتبط میشه نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 268.88,
   "end": 273.2,
   "text": "بعد ادامه میدن که پس حلولی نیست، نفس ناطقه حلولی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 273.2,
   "end": 277.2,
   "text": "و روح به معنای روح بخاریه همان جسم مادی لطیف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.2,
   "end": 280.26,
   "text": "اینجا رو خوب دیگه وارد بحث خودمون شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 280.26,
   "end": 284.54,
   "text": "روح به معنای روح بخاریه همان جسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.54,
   "end": 286.22,
   "text": "مادی لطیف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.22,
   "end": 289.82,
   "text": "این جسم لطیف و حار یعنی داغ، گرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.82,
   "end": 296.56,
   "text": "در تمام اعضا و جوارح بدنی سرایان دارد و چون شبیه بخاره است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.56,
   "end": 300.14,
   "text": "لطیف گویند. بهش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.14,
   "end": 302.58,
   "text": "جسم لطیف یا روح بخاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.58,
   "end": 306.96,
   "text": "و به خاطر چنین حضوری در بدن موجب حرارت دم می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 306.96,
   "end": 312.04,
   "text": "یعنی گرما اصلاً از اونه. وقتی اون برداشته بشه، گرما از بدن میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 312.04,
   "end": 315.34,
   "text": "و آدم می‌میره. خونش هم لخته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 315.34,
   "end": 321.08,
   "text": "ایشون ادامه میدن و این حرارت خون باعث می‌شود که در رگ‌ها جاری بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 321.08,
   "end": 325.02,
   "text": "و زمانی که این روح بخاریه از کار می‌افتد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 325.02,
   "end": 327.58,
   "text": "خون در بدن لخته می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 327.58,
   "end": 334.72,
   "text": "زیرا روح بخاریه که خون را گرم نگه می‌داشت و نمی‌گذاشت در بدن لخته صورت گیرد، جدا شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 334.72,
   "end": 337.74,
   "text": "پس الان سؤال، کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.74,
   "end": 341.56,
   "text": "خون لخته میشه؟ وقتی که روح بخاریه از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 341.56,
   "end": 347.58,
   "text": "خون جدا میشه. پس اگر داخل بدن بافتی از اعضای بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 347.58,
   "end": 350.82,
   "text": "داخل بدن نه که خونی که ریخت بیرون هیچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 350.82,
   "end": 353.66,
   "text": "داخل بدن لخته شد، چه اتفاقی افتاده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 353.66,
   "end": 356.44,
   "text": "اون بخش فاقد روح بخاریه شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.44,
   "end": 361.22,
   "text": "به همین راحتی حالا بعد ایشون ادامه میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.22,
   "end": 369.1,
   "text": "مثال دل و قلب رو می‌زنن که وقتی طبیب میگه دل یا قلب این بخش صنوبری سمت چپ سینه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 369.1,
   "end": 376.76,
   "text": "ولی وقتی حکیم عارف قرآن اصلاً میگه قلب اون همون نفس ناطقه مجرد روحه به اون معناست که آش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 376.76,
   "end": 379.88,
   "text": "اشاره می‌کنم به آیه \"یوم لا ینفع مال و لا بنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 379.88,
   "end": 382.32,
   "text": "الا من أتى الله بقلب سلیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 382.32,
   "end": 384.84,
   "text": "مگر اینکه با قلب سلیم بیای یعنی همون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.84,
   "end": 393.64,
   "text": "بعد یه فرمایش دیگه هم در خصوص وسط دارن که حضرت علامه می‌فرمایند در سنت الهی این خیلی بعداً به دردمون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 393.64,
   "end": 399.48,
   "text": "این جمله آخر رو توجه کنید. در سنت الهی همواره جریان وسط وجود دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 399.48,
   "end": 401.96,
   "text": "همواره، همیشه برداشته نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 401.96,
   "end": 404.96,
   "text": "مثل جریان بین الطلوعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 404.96,
   "end": 410.66,
   "text": "که در میان ظلمت محض و روشنایی محض قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 410.66,
   "end": 416.82,
   "text": "یا مثل همین روح بخاری که در میان نفس مجرد و ماده محض قرار گرفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 416.82,
   "end": 422.9,
   "text": "این جمله علامه بود. بعد چقدر مهمه این جریان وسط یا سنت وسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 422.9,
   "end": 425.24,
   "text": "یعنی اینو برداری اصلاً نمی‌شه برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 425.24,
   "end": 428.92,
   "text": "برداری ارتباط ظاهر و باطن قطع می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 428.92,
   "end": 434.06,
   "text": "و خیلی ارزشمندند این سنت‌ها یا جریان‌های وسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 434.06,
   "end": 436.6,
   "text": "حالا حوصله نمی‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 436.6,
   "end": 441.48,
   "text": "من تو این چند جلسه متوجه شدم اکثراً بی‌حوصله‌اید نسبت به شنیدن این مسائل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 441.48,
   "end": 445.76,
   "text": "نه حاجی. لذا- علاقه هم ببین جمعیت- بله، بله مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 445.76,
   "end": 452.82,
   "text": "بخارات زده بالا. بعداً اگه حوصله می‌کردید به شما می‌گفتم چه تاثیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 452.82,
   "end": 459.86,
   "text": "مستقیمی روح بخاری در هم نفس ناطقه و هم بدن داره و بسیاری از گرفتاری‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 459.86,
   "end": 467.16,
   "text": "از عدم علم به چگونگی تعادل نفس عرض شود روح بخاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 467.16,
   "end": 469.47,
   "text": "بی‌حوصلگی‌مون، بی ها--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 469.47,
   "end": 472.04,
   "text": "آلزایمرمون یا حافظه کممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 472.04,
   "end": 477.68,
   "text": "حوصله نداشتن برای نماز خوندن، لذت نبردن از حتی روضه سید و شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 477.68,
   "end": 480.5,
   "text": "یه وقت نمی‌تونی اشک بریزی. باور کنید من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 480.5,
   "end": 482.98,
   "text": "حالا حوصله نداشتید تو این جلسات بیاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 482.98,
   "end": 487.18,
   "text": "خصوصی با هم بحث می‌کنیم ثابت می‌کنم که خیلی موقع‌ها چون روح بخاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 487.18,
   "end": 490.72,
   "text": "متعادل نیست نمی‌تونی کربلا رو درک کنی و اشکت جاری نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 490.72,
   "end": 492.56,
   "text": "نه همیشه ها. بعضی موقع‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 492.56,
   "end": 495.56,
   "text": "ان‌شاءالله که خدای متعال عاقبت همه‌مون رو ختم به خیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 495.56,
   "end": 497.25,
   "text": "صلوات بفرستید. اللهم صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}