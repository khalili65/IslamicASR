 "cues": [
  {
   "i": 0,
   "start": 0.02,
   "end": 2.68,
   "text": "اللهم صل على محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.68,
   "end": 6.42,
   "text": "محمد بسم الله الرحمن الرحيم وبه نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.42,
   "end": 11.94,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.94,
   "end": 15.48,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.48,
   "end": 18.3,
   "text": "ما در مسیر بحثمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.3,
   "end": 22.18,
   "text": "پیرامون شناخت خودمون رسیدیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.18,
   "end": 26.92,
   "text": "روح بخاری و عرض کردیم که وقتی روح بخاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.92,
   "end": 31.64,
   "text": "تحلیل میره بر اثر تحرک زیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.64,
   "end": 37.28,
   "text": "و برمی‌گرده به مغز و کبد و قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.28,
   "end": 47.24,
   "text": "البته خوبه بدونید بعضیا معتقدن کلاً از این سه تا جمع میشه تو مغز در نهایت و منجر به خواب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.24,
   "end": 53.96,
   "text": "اونجا گفتیم که به جهت اینکه نفس ناطقه ارتباطش با بدن از طریق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.96,
   "end": 58.06,
   "text": "روح بخاریه، اینجا چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.06,
   "end": 65.98,
   "text": "روح بخاری جمع شده رفته به اصطلاح مثلاً در مغز قرار گرفته و از همه اعضا فارغ شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.98,
   "end": 69.0,
   "text": "دیگه نفس ناطقه توجهش از بدن برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.0,
   "end": 77.28,
   "text": "وقتی روح بخاری در بافت‌ها نیست، توجه نفس ناطقه از بدن برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.28,
   "end": 78.9,
   "text": "برای همین آزاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.9,
   "end": 82.9,
   "text": "برای همین می‌تونه با غیب ارتباط بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.9,
   "end": 84.6,
   "text": "تعلقش برداشته میشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.6,
   "end": 88.62,
   "text": "تعلقش به بدن به حداقل ممکن می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.62,
   "end": 93.14,
   "text": "که اگر کلاً برداشته بشه میشه موت یا مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.14,
   "end": 96.56,
   "text": "حالا چون تعلقش به حداقله می‌تونه با غیب ارتباط بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.56,
   "end": 100.16,
   "text": "اینجا یه نکته‌ای هست که دیروز وقت نشد بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.16,
   "end": 105.68,
   "text": "اونم اینکه خیلی-- اتفاقاً امروز درس چهل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.68,
   "end": 113.16,
   "text": "چهلمین درس شرح اسفار حضرت علامه رو که گوش می‌دادم خیلی ایشون در انتهای درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.16,
   "end": 120.7,
   "text": "تذکر می‌دادن به اینکه تعلقاتتون رو بکنید تا بتونید تعقل داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.7,
   "end": 125.72,
   "text": "عقلتون بارور بشه و بتونه سیر کنید در عوالم قدسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.72,
   "end": 128.1,
   "text": "کسی که تعلق داره نمی‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.1,
   "end": 135.16,
   "text": "شما دقت کنید کسی که خیلی تعلقات یعنی خیلی پراکندگی فکر داره، تمرکز قوا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.16,
   "end": 137.06,
   "text": "تصمیم‌گیر درستی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 137.06,
   "end": 145.7,
   "text": "یه مدیری تصمیم‌گیری خوبی می‌تونه بکنه به صلاح مجموعه که تمرکز قوا داره، تعلقش کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 145.7,
   "end": 148.96,
   "text": "کسی که تعلق به میز و پست و مقام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 148.96,
   "end": 155.44,
   "text": "مدرک و پول و نمی‌دونم این و اون و اینا نمی‌تونه متمرکز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 155.44,
   "end": 158.96,
   "text": "و اصلاً راه کندن از مش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 158.96,
   "end": 165.9,
   "text": "طبیعت و متوجه به عالم قدس شدن، سلام علیکم و رحمة الله، همین تعلق کندنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 165.9,
   "end": 174.32,
   "text": "حالا پس اون چیزی که دیروز گفتیم به صورت سری گفتیم رد شدیم بعداً فاشش می‌کنیم اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 174.32,
   "end": 179.62,
   "text": "حالا وقتی که انسان به خواب میره چون تعلق نفس ناطقه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 179.62,
   "end": 183.5,
   "text": "بدن به حداقل رسیده، نفس ناطقه متوجه عالم قدس میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 183.5,
   "end": 189.02,
   "text": "شما در خواب پیام‌های الهی رو دریافت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 189.02,
   "end": 191.34,
   "text": "حالا بفرمایید ببینم اگر کسی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 191.34,
   "end": 198.98,
   "text": "حالت بیداری بتونه به توجه عرفانی، حالا من یه چیزی میگم و رد میشم ازش، شما یه چیزی می‌شنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 198.98,
   "end": 205.0,
   "text": "عالمی نهفته‌ست در همین بحث توجه عرفانی که اصلاً یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 205.0,
   "end": 208.18,
   "text": "زمان خاص داره، مکان خاص داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 208.18,
   "end": 210.96,
   "text": "یعنی بهترین زمان‌ها، بهترین زمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 210.96,
   "end": 214.32,
   "text": "ز-- مکان‌ها، روش‌های خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 214.32,
   "end": 217.8,
   "text": "ناب به دردبخور که این‌ها رو ما متوجه نیستیم متأسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 217.8,
   "end": 219.42,
   "text": "اهلش دارن استفاده می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 219.42,
   "end": 222.26,
   "text": "اگر کسی به توجه عرفانی برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 222.26,
   "end": 230.12,
   "text": "به گونه‌ای که بتونه روح بخاری رو جمع کنه تو مغز از بافت‌ها و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 230.12,
   "end": 234.06,
   "text": "قسمت‌های مختلف بدن جمع کنه روح بخاری رو توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 234.06,
   "end": 238.02,
   "text": "مغز بتونه یه همچین کاری بکنه که شدنیه، میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 238.02,
   "end": 242.38,
   "text": "چه اتفاقی میفته؟ الان ما میگیم طرف خوابش میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 242.38,
   "end": 246.0,
   "text": "اصطلاحاً الان از جهت علمی میگیم آقا خواب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 246.0,
   "end": 251.7,
   "text": "توجه نفس از بدن به حداقل میرسه، متوجه عالم غیب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 251.7,
   "end": 256.46,
   "text": "به همین راحتی فهمیدیم که توجه عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 256.46,
   "end": 262.2,
   "text": "و خبر گرفتن از عالم غیب به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 262.2,
   "end": 264.32,
   "text": "روشیه که الان گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 264.32,
   "end": 266.12,
   "text": "منتها شدت و ضعف داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 266.12,
   "end": 268.44,
   "text": "تشکیکیه. شدت و ضعف داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 268.44,
   "end": 274.66,
   "text": "حالا اگر چنانچه کسی، ااا کلاً دقت بفرمایید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 274.66,
   "end": 283.04,
   "text": "کلاً روح بخاری از بدنش فارغ بشه، یعنی تحلیل بره، تحلیل بره و این روح بخاری کلاً از مغزشم دیگه خارج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 283.04,
   "end": 288.78,
   "text": "بشه. دیگه در مغز و کبد و قلبش هم دیگه نمونه این بخار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 288.78,
   "end": 290.62,
   "text": "چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 290.62,
   "end": 293.88,
   "text": "کلاً تعلق نفس از بدن برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 293.88,
   "end": 296.12,
   "text": "میشه چی؟ میشه موت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 296.12,
   "end": 300.0,
   "text": "میشه مرگ. اتفاقاً اون جالینوس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 300.0,
   "end": 312.56,
   "text": "حتماً شنیدید در زمان حضرت عیسی روح الله زندگی می‌کرد و چهارصد جلد کتاب در خصوص طب فقط داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 312.56,
   "end": 315.84,
   "text": "طب هم از اسم طبیب حضرت حق گرفته شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 315.84,
   "end": 325.68,
   "text": "کسی که با عالم قدس یا با حضرت حق به اسم طب-- طبیب حق ارتباط پیدا کنه می‌تونه به اون طب حقیقی و واقعی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 325.68,
   "end": 328.78,
   "text": "اطبای امروز رو ول کن اینا پزشکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 328.78,
   "end": 331.8,
   "text": "طب از طبیب، از طبیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 331.8,
   "end": 335.48,
   "text": "حالا اون چرا ایمان آورد به حضرت عیسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 335.48,
   "end": 337.2,
   "text": "اینم بگم برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 337.2,
   "end": 343.56,
   "text": "علتشو فکر می‌کنید چیه؟ چون از جهت علمی می‌دونست ایشون، این علم، علم طبی رو داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 343.56,
   "end": 346.92,
   "text": "که اگر روح بخاری از بدن خارج بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 346.92,
   "end": 355.16,
   "text": "بدن فاسد میشه چون نفس توجهش رو از بدن برمی‌داره و بدن وقتی که منسلخ شد این روح ازش فاسد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 355.16,
   "end": 358.98,
   "text": "دیگه برگشتن این روح بخاری امکان‌پذیر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 358.98,
   "end": 360.92,
   "text": "چون از صافی خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 360.92,
   "end": 364.26,
   "text": "وقتی خون خشک شد دیگه چه برگشتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 364.26,
   "end": 369.02,
   "text": "وقتی متوجه شد حضرت عیسی مرده رو زنده می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 369.02,
   "end": 374.96,
   "text": "یعنی قابلیت اینو داره که اون روح بخاری رو برگردونه که نفس دوباره تعلقش به بدن بیفته، ایمان آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 374.96,
   "end": 378.12,
   "text": "گفت این معلومه که نبوتش به حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 378.12,
   "end": 380.97,
   "text": "ببین از جهت علمی می‌تونه به خدا ایمان بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 380.97,
   "end": 383.74,
   "text": "این جایگاه علمه که مولا فرمود: \"العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 383.74,
   "end": 385.72,
   "text": "سلطان\". سلطنت میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 385.72,
   "end": 387.54,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 387.54,
   "end": 392.4,
   "text": "صلوات ختم کنیم. اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}