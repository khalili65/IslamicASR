  {
   "index": 1,
   "title": "### بدن؛ نشئۀ طبیعت و ناسوت",
   "start": 79.48,
   "end": 146.62
  },
  {
   "index": 2,
   "title": "## معارف به مثابهٔ یادآوری",
   "start": 146.62,
   "end": 166.64
  },
  {
   "index": 3,
   "title": "## اصالت روح به معنای رها کردن بدن نیست",
   "start": 166.64,
   "end": 241.6
  },
  {
   "index": 4,
   "title": "## اعتدال مزاج و رسیدگی به بدن در حد نیاز",
   "start": 241.6,
   "end": 275.42
  },
  {
   "index": 5,
   "title": "## استثنا: وقتی روح احاطه پیدا کند",
   "start": 275.42,
   "end": 337.5
  },
  {
   "index": 6,
   "title": "## جمع‌بندی: بدن مرکب روح است",
   "start": 337.5,
   "end": 363.41
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 5.44,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.44,
   "end": 10.5,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.5,
   "end": 12.15,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.15,
   "end": 15.6,
   "text": "سلام علیکم. دیروز عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.6,
   "end": 19.44,
   "text": "اصل و اصالت وجود انسان به روحشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.44,
   "end": 24.8,
   "text": "و با اون مثالی که عرض کردیم خواستیم ثابت کنیم که اصالت به روح برمی‌گرده نه بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.8,
   "end": 29.7,
   "text": "ما متأسفانه غالباً گرفتار بدن هستیم و از روح غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.7,
   "end": 34.54,
   "text": "این نباید ما رو به اینجا برسه که بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.54,
   "end": 39.04,
   "text": "بی‌اهمیته. در حقیقت یه اصلاحیه ای داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.04,
   "end": 40.84,
   "text": "این منظور این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.84,
   "end": 43.98,
   "text": "فرمودین بدن از تر روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.98,
   "end": 46.02,
   "text": "بله. باید بهش برسیم. احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.02,
   "end": 49.28,
   "text": "که بتونیم پرواز کنیم. بله. اون که میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.28,
   "end": 52.64,
   "text": "عقل سالم در بدن سالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.64,
   "end": 55.56,
   "text": "این البته یه استثنا هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.56,
   "end": 58.54,
   "text": "اگر فرصت باشه استثناش رو عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 58.54,
   "end": 66.04,
   "text": "کلیت نداره. ببینید اون چیزی که ما باید بدونیم امروز اینه که ما یک وجود واحدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.04,
   "end": 68.56,
   "text": "یک وجود واحدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.56,
   "end": 70.8,
   "text": "با مراتب و انواع مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.8,
   "end": 75.44,
   "text": "قرآن هم می‌فرماید و لقد یا قد خلقکم اطوارا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.44,
   "end": 79.48,
   "text": "ما شما رو به طورهای مختلف خلق کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.48,
   "end": 81.6,
   "text": "یک طور ما بدن ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 81.6,
   "end": 89.02,
   "text": "یک طور ما قوه مثال یا برزخ وجودی یا مثال متصل یا قوه خیال هر اسم بخوای بذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.02,
   "end": 92.9,
   "text": "یک رتبه وجودیه، یک قوه است، یک منه است، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.9,
   "end": 96.0,
   "text": "رتبه است، یک عالمه به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.0,
   "end": 103.66,
   "text": "یک طور وجودی ما قوه عقل ماست، رتبه عقلی ماست که مرتبط با عالم جبروت و عالم عقوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.66,
   "end": 106.64,
   "text": "همونطور که بدن ما مرتبط به عالم ماده‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.64,
   "end": 113.12,
   "text": "عالم مثال ما مرتبط به برزخ و عالم مثال بیرون از ماست و اون منفصله، این متصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.12,
   "end": 115.9,
   "text": "رتبه عقلیمون هم متصله با، با عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.9,
   "end": 118.12,
   "text": "عقول و ملائکه. جنسش از اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.12,
   "end": 121.08,
   "text": "عالم جبروت و عالم امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.08,
   "end": 123.34,
   "text": "مثال، ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.34,
   "end": 126.38,
   "text": "ماده، نشئه طبیعت و ناصوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.38,
   "end": 133.64,
   "text": "همونطور ما دو مرتبه رتبه دیگه داریم به نام رتبه قلبی‌مون که مربوط به عالم لاهوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.64,
   "end": 138.1,
   "text": "همینطور میریم تا رتبه روحمون که اون مرتبه احدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.1,
   "end": 142.42,
   "text": "این‌ها واحدیت‌اند، کثرات‌اند، کثرت دارن، اون احدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.42,
   "end": 146.62,
   "text": "هرچی ما داریم جمع الجمع جمع در روح ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.62,
   "end": 149.72,
   "text": "ما حالا داره یادآوری می‌شه برامون علوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.72,
   "end": 154.38,
   "text": "لذا بهش میگن معارف. معارف جنبه یادآوری اون چیزی رو داره که قبلاً داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.38,
   "end": 158.54,
   "text": "حلم مدکر. آیا کسی هست که یادآوری کنه برای من و شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.54,
   "end": 160.66,
   "text": "بماند. پس ما انواع مختلف داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.66,
   "end": 164.8,
   "text": "ما یک وجود واحدیم. بدن ما جدایی از ما که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.8,
   "end": 167.76,
   "text": "بدن ما انزل مراتب وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 167.76,
   "end": 172.84,
   "text": "اشمخش می‌شه روح، انزلش می‌شه بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.84,
   "end": 176.68,
   "text": "این که ما گفتیم اصالت به روحه، نه یعنی بدن رو رها کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.68,
   "end": 181.98,
   "text": "نه. اتفاقاً شما ببینید اینا از هم-- اصلاً از هم تاثیر می‌گیرن، تأثر دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.98,
   "end": 188.04,
   "text": "مثلاً وقتی یه سوزن بره تو دستت، روحت هر چقدرم قوی باشه باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.04,
   "end": 189.88,
   "text": "تأثر-- متأثر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.88,
   "end": 195.04,
   "text": "یعنی می‌گه آقا ولم کن الان نمی‌تونم، الان نمی‌تونم تمرکز کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.04,
   "end": 197.98,
   "text": "بدنم-- سرم درد می‌کنه. نمی‌تونم متمرکز باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.98,
   "end": 202.86,
   "text": "بدنت درد گرفته، روحت نمی‌تونه اون کارکرد درست رو داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.86,
   "end": 207.1,
   "text": "بالعکسش هم هست. یه وقت یه خبر بدی بهت رسیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.1,
   "end": 211.52,
   "text": "مثلاً یه عزیزی دور از جون شما مثلاً از دنیا رفته بهت رسیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.52,
   "end": 217.42,
   "text": "بدنت سالم، ورزشکار، خیلی خوب، اصلاً نمی‌تونی این بدنتو بکشی با خودت ببری جایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.42,
   "end": 220.86,
   "text": "می‌گی، می‌گی ولم کن امروز از من نخوای بیام سر کار آقای لواسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.86,
   "end": 226.16,
   "text": "بی‌خیال ما شو. ما امروز این‌طوری یا اون‌طوری .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.16,
   "end": 228.5,
   "text": "چند تا گفتی عقل سالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.5,
   "end": 231.8,
   "text": "در بدن سالم. بله. خداوند انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.8,
   "end": 234.56,
   "text": "به همه مدیران ما عطا کنه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.56,
   "end": 236.62,
   "text": "ما آخر ما انشاالله .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.62,
   "end": 238.64,
   "text": "پس این دو به هم مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.64,
   "end": 240.32,
   "text": "نمی‌شه شما یکیشو بذاری کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.32,
   "end": 244.02,
   "text": "اما اصل روحه. ما اگر بتوانیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.02,
   "end": 253.77,
   "text": "این استثنا اینجاست، روحمون رو تعالی کنیم و بهش برسیم البته بدن رو هم باید رسیدگی کرد در حد نیاز و متعادل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.77,
   "end": 255.56,
   "text": "باید اعتدالش رو حفظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 255.56,
   "end": 258.26,
   "text": "یه بحث در بحث اعتدال مزاج داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.26,
   "end": 260.32,
   "text": "به وقت دیگه انشاالله براتون می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.32,
   "end": 268.3,
   "text": "خیلی از گیر و گورهای مشکلات معنوی حتی ما، عرفانی و عبادی ما به خاطر مزاجمونه که ربط تو بدنمون داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.3,
   "end": 271.6,
   "text": "مزاج معتدل نیست، من نمی‌تونم چیزی رو حفظ کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.6,
   "end": 275.42,
   "text": "از نمازم بهره معنوی نمی‌برم و به اون بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 275.42,
   "end": 279.44,
   "text": "در هر حال اگر کسی روحش رو تعالی بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.44,
   "end": 282.54,
   "text": "که راهش هم انشاالله بعداً بهتون می‌گیم، بتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.54,
   "end": 290.9,
   "text": "این روح رو قوی کنه، روح احاطه پیدا کنه، احکامش رو در بدن پیاده کنه، برای چنین کسی دیگه استثناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.9,
   "end": 294.44,
   "text": "یعنی اصلاً روح-- جسمش رو تیکه تیکه کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.44,
   "end": 296.68,
   "text": "اصلاً روحش متأثر نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.68,
   "end": 302.22,
   "text": "می‌شه اون فرمایش امام صادق صلوات الله علیه که فرمود شهدای کربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.22,
   "end": 307.52,
   "text": "درد و الم حدید و آهن و ضرب و شتم نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.52,
   "end": 310.64,
   "text": "شمشیر و نیزه رو هیچ احساس نکردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.64,
   "end": 315.82,
   "text": "هیچ. چون غرق در روح و ریحان و تجلیات حضرت حق بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.82,
   "end": 319.54,
   "text": "اصلاً درد نکشیدند شهدای-- امام صادق فرمودند چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.54,
   "end": 322.4,
   "text": "روح اینقدر بزرگ شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 322.4,
   "end": 324.56,
   "text": "بدن تحت تأثیرش قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 324.56,
   "end": 328.76,
   "text": "مثل حضرت موسی که رفت کوه طور چهل شب نه غذا خورد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.76,
   "end": 330.8,
   "text": "نه آب خورد، نه خوابید چهل شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.8,
   "end": 336.1,
   "text": "می‌شه همچ چیزی؟ بله. اگر روح احاطه کلی پیدا کنه بدن رو با خودش می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.1,
   "end": 342.82,
   "text": "اون استثناست. در هر حال این رو امروز بدانیم که باید بدنمون هم بهش برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.82,
   "end": 347.14,
   "text": "مرکب روحه که بتونه روح رو انشاالله به اهداف خودش برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.14,
   "end": 349.4,
   "text": "اشمخ هم بگین که ما هنوز ذهنمون در.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.4,
   "end": 352.2,
   "text": "یعنی شامخ‌تر. بر وزن افعل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.2,
   "end": 354.06,
   "text": "یعنی بالاتر. بالا دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.06,
   "end": 357.64,
   "text": "خودتون نزن به اون راه آقای اصغر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.64,
   "end": 360.92,
   "text": "خدا بده خنده ما کی هستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.92,
   "end": 363.41,
   "text": "سلامت باشید. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}