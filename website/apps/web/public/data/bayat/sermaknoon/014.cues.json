   "start": 191.64,
   "end": 216.7
  },
  {
   "index": 3,
   "title": "## تسلیم قلب و تعریف امیرالمؤمنین علیه‌السلام از اسلام",
   "start": 216.7,
   "end": 358.38
  },
  {
   "index": 4,
   "title": "## عمل صالح به‌مثابهٔ معارف ناب در بیان اهل معرفت",
   "start": 358.38,
   "end": 538.47
  },
  {
   "index": 5,
   "title": "## روش‌های تنظیم و اصلاح خلط دم",
   "start": 538.47,
   "end": 594.07
  },
  {
   "index": 6,
   "title": "### سحرخیزی و تصفیهٔ هوا",
   "start": 594.07,
   "end": 675.21
  },
  {
   "index": 7,
   "title": "### ختم قرآن؛ از باءِ بسم الله تا سینِ ناس",
   "start": 675.21,
   "end": 770.49
  },
  {
   "index": 8,
   "title": "### ترک پرخوری و آستانهٔ سیری",
   "start": 770.49,
   "end": 886.35
  },
  {
   "index": 9,
   "title": "اگرچه تأویلش را امام باقر علیه‌السلام فرمودند:",
   "start": 886.35,
   "end": 930.45
  },
  {
   "index": 10,
   "title": "## غذاهای مفید برای تنظیم خلط دم",
   "start": 930.45,
   "end": 1057.77
  },
  {
   "index": 11,
   "title": "کدو خورشتی برایشان خیلی خوب است.",
   "start": 1057.77,
   "end": 1087.55
  },
  {
   "index": 12,
   "title": "کم‌خوری هم که گفتیم.",
   "start": 1087.55,
   "end": 1143.21
  },
  {
   "index": 13,
   "title": "ماست چکیده خیلی خوب است برایشان.",
   "start": 1143.21,
   "end": 1241.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.9,
   "end": 8.06,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.06,
   "end": 13.86,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.86,
   "end": 17.04,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.04,
   "end": 28.76,
   "text": "ما در جایگاه خلط دم بودیم و می‌خواستیم روش‌های تنظیم و اصلاح خلط دم رو اگر غلبه پیدا کنه و از اعتدال خارج بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 28.76,
   "end": 32.18,
   "text": "رو بگیم که دیگه وقت فرصت اقتضا نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 32.18,
   "end": 41.78,
   "text": "این انقدر این‌ها قبلاً عرض کردیم باز جهت اهمیت بحث عرض می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 41.78,
   "end": 46.26,
   "text": "انقدر این‌ها مهم‌اند. ما گفتیم در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 46.26,
   "end": 51.0,
   "text": "حتی عبادت، اخلاقیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 51.0,
   "end": 56.06,
   "text": "کسب معارف، رسیدن به حقایق، همه‌ی این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 56.06,
   "end": 59.26,
   "text": "ما ناگزیریم از اصلاح مزاج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 59.26,
   "end": 65.94,
   "text": "یعنی چون انقدر ارتباط مستقیم داره با این‌ها و گوشه گوشه‌ش هم بعضاً ما در سیر بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 65.94,
   "end": 68.6,
   "text": "گفتیم خیلی مهمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 68.6,
   "end": 73.64,
   "text": "بر اساس آیه‌ی قرآن هم که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 73.64,
   "end": 76.98,
   "text": "الیه یصعد الكلم الطيب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 76.98,
   "end": 87.94,
   "text": "اون کلمه طيب رو تفاسیر روح مؤمن یا نفس مؤمن برشمردند بر اساس روایات که اون چیزی که صعود می‌کنه بالا میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 87.94,
   "end": 94.76,
   "text": "و صاعده اون در حقیقت معراج میره بالا میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 94.76,
   "end": 103.46,
   "text": "صعود داره روح مؤمنه و البته والعمل الصالح يرفعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 103.46,
   "end": 105.96,
   "text": "اون چیزی که رفعت میده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 105.96,
   "end": 111.34,
   "text": "روح مؤمن عمل صالحشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 111.34,
   "end": 114.14,
   "text": "و عمل صالح در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 114.14,
   "end": 119.72,
   "text": "درجه اون صعود رو مشخص می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 119.72,
   "end": 122.7,
   "text": "که حالا این البته آیه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 122.7,
   "end": 125.6,
   "text": "آیه بسیار پرمغز و کثیر الفروع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 125.6,
   "end": 130.86,
   "text": "خیلی جای بحث داره که حالا این مؤمنی که می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 130.86,
   "end": 140.38,
   "text": "حرکت کنه و صعود کنه بره بالا تا وقتی که مزاجش اصلاح نشده نمی‌تونه صعود کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 140.38,
   "end": 145.98,
   "text": "یعنی هرچی هم هی میره بالا می‌خوره زمین میره بالا می‌خوره زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 145.98,
   "end": 150.36,
   "text": "میفته. سؤال داری شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 150.36,
   "end": 152.96,
   "text": "جان؟ بله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 152.96,
   "end": 157.3,
   "text": "جان سؤال داری بپرس. حاجی- معنی نداره بپرس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 157.3,
   "end": 159.8,
   "text": "ذهن مخاطب رو می‌کنی شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 159.8,
   "end": 162.17,
   "text": "وارش ما. اوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 162.17,
   "end": 164.38,
   "text": "معنی نداره بپرس. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 164.38,
   "end": 166.68,
   "text": "عمل صالح تو چه حوزه‌ایه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 166.68,
   "end": 174.2,
   "text": "یا مثلاً همون تکالیف شرعیه یا مثلاً منظور آیه قرآن چیز دیگه‌ایه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 174.2,
   "end": 180.5,
   "text": "اگر- یعنی همه جای قرآن شما دقت کنید دو تا بال به مؤمن میده برای پروازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 180.5,
   "end": 182.88,
   "text": "یکی ایمانه. الذين آمنوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 182.88,
   "end": 187.48,
   "text": "دیگری عمل صالح. وعمل الصالحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 187.48,
   "end": 191.46,
   "text": "یا إلا الذين آمنوا وعملوا الصالحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 191.46,
   "end": 193.86,
   "text": "خب اینجا الان ایمان هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 193.86,
   "end": 197.2,
   "text": "همین که میگه کلمه طيب جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 197.2,
   "end": 201.56,
   "text": "ایمان هست طيب بودن مطرحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 201.56,
   "end": 204.14,
   "text": "لا یمسه إلا المطهرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 204.14,
   "end": 207.0,
   "text": "جایی که ایمان هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 207.0,
   "end": 211.36,
   "text": "بحث طيب بودن و طهارت مطرحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 211.36,
   "end": 218.5,
   "text": "کلمه طيب که بدون ایمان و بدون ولایت امیرالمؤمنین علیه الصلاة والسلام اصلاً مطرح نیست، موضوعیت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 218.5,
   "end": 223.38,
   "text": "پس وقتی میگه الیه یصعد الكلم الطيب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 223.38,
   "end": 225.04,
   "text": "پیداست که ایمان همراهش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 225.04,
   "end": 228.34,
   "text": "پذیرش ولایت مطلقه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 228.34,
   "end": 230.28,
   "text": "خب؟ پس اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 230.28,
   "end": 234.0,
   "text": "چی باعث می‌شه که این شخص بالا بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 234.0,
   "end": 235.84,
   "text": "والعمل الصالح يرفعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 235.84,
   "end": 238.08,
   "text": "این عمل صالحه که اونو بالا می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 238.08,
   "end": 241.54,
   "text": "حالا باید سؤال کرد که این عمل صالح چه عملیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 241.54,
   "end": 248.74,
   "text": "چون ایمان که اونجا هست. بعد یصعد هم باز داره این رو به ما می‌فهمونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 248.74,
   "end": 256.98,
   "text": "مؤمن مطلقاً همین که ایمان داشت یعنی قلبش رو یعنی قلباً پذیرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 256.98,
   "end": 260.88,
   "text": "قلبش رو تسلیم کرد که الإسلام هوع الدسلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 260.88,
   "end": 266.9,
   "text": "امیرالمؤمنین علیه الصلاة والسلام قربونش بریم یه روز فرمودن که می‌خوام اسلام رو به شما معرفی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 266.9,
   "end": 269.94,
   "text": "در حالی که پیش از من هیچکس چنین معرفی‌ای نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 269.94,
   "end": 273.9,
   "text": "همه متعجب شدند و منتظر بودند که حالا چه خطبه‌ی غرا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 273.9,
   "end": 278.19,
   "text": "بالا و مثلاً بله غرا و بالا هم هست اما خیلی طولانی حضرت می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 278.19,
   "end": 282.8,
   "text": "در صورتی که یه کلمه فرمودن الإسلام هوع الدسلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 282.8,
   "end": 286.22,
   "text": "این قلب وقتی تسلیم شد، دلدادگی صورت گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 286.22,
   "end": 289.82,
   "text": "این ایمانه. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 289.82,
   "end": 291.56,
   "text": "این شروع ایمانه البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 291.56,
   "end": 296.24,
   "text": "که هرچی بیشتر بشه این تسلیم بودن، اون يسلموا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 296.24,
   "end": 301.96,
   "text": "يسلموا تسلیما. هرچی این بیشتر بشه، شدت بگیره، ولایت بیشتر و صعود بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 301.96,
   "end": 304.8,
   "text": "حالا اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 304.8,
   "end": 309.3,
   "text": "مؤمن پس همین که پذیرش ولایت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 309.3,
   "end": 312.2,
   "text": "در حال صعود هست. اما اونی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 312.2,
   "end": 317.9,
   "text": "رفعت میده به این صعود، درجات رو مشخص می‌کنه براش، اون عمل صالحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 317.9,
   "end": 321.11,
   "text": "حالا باید اینو کجا پیدا کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 321.11,
   "end": 324.2,
   "text": "می‌ترسم حالا اینطوری بریم جلو بعد از اصل بحثمون جا بمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 324.2,
   "end": 333.7,
   "text": "بحث دم و اینا. خیلی کلی الان عرض کنم که باید رد پاشو به قول علامه طباطبایی قرآن رو همه رو با هم دید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 333.7,
   "end": 336.36,
   "text": "روحش شاد. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 336.36,
   "end": 338.06,
   "text": "همه رو باید آیات رو با هم دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 338.06,
   "end": 343.28,
   "text": "باید در والذين أوتوا العلم درجات دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 343.28,
   "end": 347.78,
   "text": "اونجا می‌فرماید درجات رو خدا به کی میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 347.78,
   "end": 352.7,
   "text": "أوتوا العلم. کسی که علم بهش داده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 352.7,
   "end": 355.28,
   "text": "پس درجات جاییه که علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 355.28,
   "end": 358.38,
   "text": "حالا تا اینجاش اومدیم تا تمومش کنیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 358.38,
   "end": 366.3,
   "text": "بزرگان اهل معرفت مثل خواجه طوسی، مثل ملا صدرا، مثل خود حضرت علامه حسن زاده علیه الرحمه بنده از ایشون در--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 366.3,
   "end": 370.84,
   "text": "هست توی شرح اسفاتشون این‌ها شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 370.84,
   "end": 374.95,
   "text": "فسوسشون عرض شود مثل با العنسشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 374.95,
   "end": 383.45,
   "text": "اشارات شیخ الرئیس اینا بعضا لا بلای بحث‌ها اشاره به این موضوع داشتن علامه روحشون شاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 383.45,
   "end": 389.11,
   "text": "در اصواتشم الان هست که می‌فرمایند که این عمل صالح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 389.11,
   "end": 392.51,
   "text": "ااا عرض شود خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 392.51,
   "end": 394.23,
   "text": "معارف حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 394.23,
   "end": 402.45,
   "text": "معارف ناب. درس و بحث‌های معرفتی حکمی عرفانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 402.45,
   "end": 412.11,
   "text": "کتب و صحف نوریه حکمیه و عرفانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 412.11,
   "end": 417.65,
   "text": "یه کسی می‌تونه ظاهر قرآن رو، کتاب رو تعلیم ببینه و بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 417.65,
   "end": 421.33,
   "text": "اما به باطن قرآن اگر رسید می‌شه حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 421.33,
   "end": 429.93,
   "text": "این اونه. یعنی که بعد علامه قسم می‌خوره به جان خودش سوگند می‌خوره که تا کسی این کتاب‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 429.93,
   "end": 434.73,
   "text": "که ما هی همش لا بلای بحثامون ارجاع میدیم نخونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 434.73,
   "end": 439.61,
   "text": "به جانم سوگند به باطن قرآن راه پیدا نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 439.61,
   "end": 444.33,
   "text": "اگه اینطوره پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 444.33,
   "end": 451.71,
   "text": "رو نداره. صعود می‌کنه چون مطلقا خب پذیرفته قلبش تسلیم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 451.71,
   "end": 454.97,
   "text": "اما چون به این معارف ناب نمی‌رسه، درجه‌ش پایینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 454.97,
   "end": 460.31,
   "text": "اینطوری بگیم. حالا چرا بحث به اینجا کشیده شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 460.31,
   "end": 466.75,
   "text": "خیلی هم خوب و شیرین بود. ارتباط مزاج رو ما طی بحث در سیر و سلوک گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 466.75,
   "end": 472.13,
   "text": "دیگه چی بستر و پایه‌ی ارتقا و معراج و صعوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 472.13,
   "end": 475.61,
   "text": "خب وقتی مل- مزاج ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 475.61,
   "end": 479.71,
   "text": "معتدل نیست، نمی‌دونه آدم-- اینطوری بگیم همه فهم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 479.71,
   "end": 482.01,
   "text": "آدم نمی‌دونه از کجا داره می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 482.01,
   "end": 485.83,
   "text": "نمی‌دونه چرا تو مسیر بندگی‌ش همش شکست می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 485.83,
   "end": 489.03,
   "text": "چرا موفق نیست. چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 489.03,
   "end": 492.79,
   "text": "حوصله عبادتش هی کم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 492.79,
   "end": 497.73,
   "text": "چرا اینطوری بگیم انقدر نوسان در مسیر بندگی‌ش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 497.73,
   "end": 500.19,
   "text": "یه روز خیلی حالش خوبه، خوب و خوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 500.19,
   "end": 504.35,
   "text": "یه روز خیلی بده. البته حالت ادبار و اقبال در همه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 504.35,
   "end": 512.21,
   "text": "حتی اولیای ال-- اولیاء الله هم چون قلب اسمش رو خودشه متقلبه و خدا م-مقلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 512.21,
   "end": 518.49,
   "text": "این انقلاب در درون هست اما نه این شدت و حدتی که امثال بنده داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 518.49,
   "end": 521.29,
   "text": "یه دفعه می‌افتیم و یه دفعه می‌خوایم اوج بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 521.29,
   "end": 523.53,
   "text": "نه. اینا یکی از علل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 523.53,
   "end": 529.03,
   "text": "مهمش تعادل نداشتن م-مزاج انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 529.03,
   "end": 531.27,
   "text": "به همین جهت ما یه ذره داریم پا فشاری می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 531.27,
   "end": 535.09,
   "text": "بریم سراغ بحثمون که روش‌های اصلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 535.09,
   "end": 538.47,
   "text": "خلط دم رو یا تنظیمش رو عرض کنیم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 538.47,
   "end": 542.93,
   "text": "چند تا از توصیه هایی که بزرگان دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 542.93,
   "end": 546.83,
   "text": "من جمله ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 546.83,
   "end": 551.07,
   "text": "شیخ الرئیس داره و خود حضرت علامه علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 551.07,
   "end": 553.99,
   "text": "بارها داشتن. جالبه که بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 553.99,
   "end": 556.43,
   "text": "ااا دموی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 556.43,
   "end": 558.21,
   "text": "اگر-- سلام علیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 558.21,
   "end": 560.73,
   "text": "دموی‌ها اگر ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 560.73,
   "end": 566.89,
   "text": "از حالت اعتدال خارج بشن، یکی از بهترین روش‌ها برای اصلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 566.89,
   "end": 570.55,
   "text": "مزاجشون سحرخیزی و عبادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 570.55,
   "end": 574.03,
   "text": "اگر یادتون باشه گفتیم مزاج دم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 574.03,
   "end": 577.19,
   "text": "دموی‌ها اینا گرم و ترن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 577.19,
   "end": 581.09,
   "text": "و معادلش در طبیعت، در عناصر اربعه چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 581.09,
   "end": 586.13,
   "text": "هوا بود. هوا. حالا سرش رو من نمی‌خوام اینطوری حرف بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 586.13,
   "end": 594.07,
   "text": "زمان می‌بره. یکی دو تاشو تبرکاً یه چیزی میگیم که بدونیم درون مایه دارن همه اینا بیخود نمیگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 594.07,
   "end": 599.39,
   "text": "علامه حسن زاده علیه الرحمه یادمه که در شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 599.39,
   "end": 604.41,
   "text": "فصوص شرحشون بر شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 604.41,
   "end": 612.47,
   "text": "فصوص علامه قیصری که فصوص ابن عربی رو شرح میده و علامه شرح بر شرح دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 612.47,
   "end": 620.81,
   "text": "اونجا می‌فرمودند که توصیه به سحرخیزی که داشتن یکی از علل علمی خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 620.81,
   "end": 624.41,
   "text": "در خصوص سحرخیزی رو همین تصفیه هوا معرفی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 624.41,
   "end": 627.79,
   "text": "هوا، هوا تصفیه می‌شه سحر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 627.79,
   "end": 631.01,
   "text": "آلودگی‌های هوا از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 631.01,
   "end": 634.37,
   "text": "اتمسفر، اصن هوا تنظیم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 634.37,
   "end": 638.73,
   "text": "یعنی دقیقا اونطور می‌شه که فراخور حال توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 638.73,
   "end": 641.29,
   "text": "اصن دموی‌ها اسمش رو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 641.29,
   "end": 645.87,
   "text": "چون معادل با هواست هوای مناسب خیلی به دردشون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 645.87,
   "end": 649.87,
   "text": "و چون سحر تنظیم هوا صورت می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 649.87,
   "end": 654.95,
   "text": "این‌ها می‌تونن راحت‌تر ارتباط بگیرن با پیرامون خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 654.95,
   "end": 657.29,
   "text": "ببین چقدر جالبه از جهت علمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 657.29,
   "end": 664.21,
   "text": "بعد می‌بینید سح-- این‌ها اگر سحرخیزی داشته باشن جالبه که سحرخیزیشون شاید حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 664.21,
   "end": 667.07,
   "text": "یکی از علت‌هاش می‌تونه این باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 667.07,
   "end": 670.25,
   "text": "بیشتر از اون صاحبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 670.25,
   "end": 675.21,
   "text": "مزاج‌های دیگه بهشون رشد بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 675.21,
   "end": 677.61,
   "text": "به هر حال مطلقا عبادت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 677.61,
   "end": 684.11,
   "text": "اینکه مثلا داریم ختم قرآن، نه جزء خوانی، نه یک سوره خاص تکرارش، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 684.11,
   "end": 689.87,
   "text": "ختم قرآن از باء بسم الله سوره حمد شروع کنی تا سین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 689.87,
   "end": 693.55,
   "text": "و ناس که می‌شه بس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 693.55,
   "end": 695.23,
   "text": "باء بسم الله تا بس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 695.23,
   "end": 697.71,
   "text": "بسه قرآن برای من و شما بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 697.71,
   "end": 702.03,
   "text": "اینو ختم کنی اصلاح مزاج یکی از روش‌هاش اصلاً همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 702.03,
   "end": 704.29,
   "text": "منتها نه یک باره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 704.29,
   "end": 707.77,
   "text": "این برنامه باشه که بزرگان گفتن دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 707.77,
   "end": 709.95,
   "text": "دیره دیرش حداقل ماهی یک بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 709.95,
   "end": 713.15,
   "text": "اصلاح مزاج میاره. چه ربطی داره اینا با هم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 713.15,
   "end": 714.83,
   "text": "حالا این هم خودش جای بحث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 714.83,
   "end": 718.49,
   "text": "دوست داشتید یه روز فرصت بذاریم در خصوصش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 718.49,
   "end": 727.15,
   "text": "که این کلمات و حروف قرآن و ازدواجشون با هم، آیات، سورت، چینش و بافت نظام قرآنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 727.15,
   "end": 729.97,
   "text": "این هندسه قرآن به گونه‌ایست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 729.97,
   "end": 734.93,
   "text": "که اون حروف، حروف عالیات قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 734.93,
   "end": 745.87,
   "text": "تنظیم می‌کنه. در حقیقت حروف رو که این‌ها با هم در وجود ما مزدوج شدن، کلمه وجودی ما رو آفریدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 745.87,
   "end": 752.69,
   "text": "و مرتبطاً در اصل تطبیق آدم و عالم این بحث مطرحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 752.69,
   "end": 754.41,
   "text": "که حالا به جاش باید بگیم رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 754.41,
   "end": 758.05,
   "text": "پس یکی از موضوعات اصلاح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 758.05,
   "end": 763.55,
   "text": "اه، بر-- اصلاح دموی‌ها یا البته غلبه دم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 763.55,
   "end": 768.15,
   "text": "خون یا اصلاح خون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 768.15,
   "end": 774.61,
   "text": "سحرخیزیه. ديک-- دیگرش ترک پرخوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 774.61,
   "end": 780.07,
   "text": "حتماً دموی‌ها نباید پرخوری داشته باشن حتی یه بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 780.07,
   "end": 784.49,
   "text": "باید قبل از اینکه سیر بشن دست از غذا بکشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 784.49,
   "end": 789.31,
   "text": "حالا بعضیا سؤال می‌کنن آقا کی ما بفهمیم بالاخره باید دست از غذا بکشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 789.31,
   "end": 794.21,
   "text": "معلومه. اولین لقمه‌ای که دیدی لذتش کم شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 794.21,
   "end": 801.09,
   "text": "لذت خوردن از اون لقمه قبلی کمتر بود، اونجا آستانه رفتن به سمت سیریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 801.09,
   "end": 804.63,
   "text": "اینم یه کدی بود ما به شما دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 804.63,
   "end": 809.03,
   "text": "بعد دیگری گفتم سعی کنه کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 809.03,
   "end": 812.33,
   "text": "به این شکل، یعنی، اممم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 812.33,
   "end": 817.05,
   "text": "غلبه دم در وجودش ایجاد شده، سعی کنه دو بار در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 817.05,
   "end": 819.65,
   "text": "روز غذا بخوره. صبح و شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 819.65,
   "end": 833.55,
   "text": "نهارشو حذف کنه. بعد سعی کنه جسارتا در مسائل جنسی، در تخلیه جنسی متعارف به صورت صحیح رفتار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 833.55,
   "end": 836.59,
   "text": "خواب قیلوله خیلی به درد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 836.59,
   "end": 839.45,
   "text": "آدم‌ها می‌خوره. به درد همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 839.45,
   "end": 842.69,
   "text": "مزاج‌ها می‌خوره اما برای این مزاج خیلی بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 842.69,
   "end": 845.93,
   "text": "حجامت خیلی براشون خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 845.93,
   "end": 850.21,
   "text": "البته زمان داره و زمانش خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 850.21,
   "end": 856.67,
   "text": "مصرف سرکه و آب لیمو تازه و آب قوره براشون خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 856.67,
   "end": 860.49,
   "text": "شنا کردن خیلی به درد اینا می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 860.49,
   "end": 863.95,
   "text": "و البته اصلاح غذاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 863.95,
   "end": 868.31,
   "text": "اصلاً یکی از بهترین کارها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 868.31,
   "end": 875.57,
   "text": "حالا تو سایر بحث متوجه میشیم که سریعاً هم قرآن می‌فرماید: «فَلْيَنْظُرِ الْإِنْسَانُ إِلَىٰ طَعَامِهِ»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 875.57,
   "end": 880.0,
   "text": "اگرچه تأویلش رو امام باقر علیه السلام فرمود:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 880.0,
   "end": 883.45,
   "text": "«ای الى علمه»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 883.45,
   "end": 892.19,
   "text": "که ՝من میعخذ» اینکه منظور تأویل باطنش یعنی اینکه نگاه کنه به علمش که علمش رو از کجا اخذ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 892.19,
   "end": 900.71,
   "text": "اما ظاهر قرآن، سیاق ظاهریش داره میگه انسان، انسان کسیست که-- چون انسان یه رتبه بالاتر از آدمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 900.71,
   "end": 904.97,
   "text": "چون به هر حال می‌تونی بگی آدم. اما انسان رتبه بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 904.97,
   "end": 909.05,
   "text": "کسی می‌تونی بهش بگی آدم که نگاه کنه به غذا خوردنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 909.05,
   "end": 918.19,
   "text": "و اصلاً یکی از بهترین روش‌ها برای اصلاح مزاج، اصلاح غذاهاست، غذا خوردن‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 918.19,
   "end": 921.09,
   "text": "حالا من چند تاشو به عنوان نمونه برای شما عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 921.09,
   "end": 924.07,
   "text": "برای امروز همین مقدار بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 924.07,
   "end": 926.75,
   "text": "شما وقتو نگرفتی امروزو گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 926.75,
   "end": 929.83,
   "text": "حواست باشه. غذاهای مفید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 929.83,
   "end": 934.25,
   "text": "خب، غذاهای مفید برای تنظیم خلط دم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 934.25,
   "end": 937.79,
   "text": "خلط دم منظم بشه، تنظیم بشه، از اعتدال خارج نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 937.79,
   "end": 942.39,
   "text": "چه غذاهایی خوبه؟ میوه‌جات و سبزیجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 942.39,
   "end": 944.85,
   "text": "البته سعی کنه تازه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 944.85,
   "end": 947.41,
   "text": "مخصوصاً خیار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 947.41,
   "end": 950.53,
   "text": "کاهو، به خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 950.53,
   "end": 954.31,
   "text": "سیب درختی که با پوست خورده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 954.31,
   "end": 957.97,
   "text": "دموی‌ها باید سیب رو با پوست بخورن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 957.97,
   "end": 962.13,
   "text": "و البته سیب رو به همراه پوست که می‌خورن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 962.13,
   "end": 966.01,
   "text": "دونه‌هاشم بخورن. اونای دیگه نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 966.01,
   "end": 967.77,
   "text": "مزاج‌های دیگه نه. اما این با پوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 967.77,
   "end": 972.69,
   "text": "حالا چه ربطی هست بین سیب خوردن با پوست و با دونه‌هاش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 972.69,
   "end": 976.03,
   "text": "اجازه بدید رد شیم. حرف داریم اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 976.03,
   "end": 977.83,
   "text": "ما هم حرفمون فعلاً این چیزا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 977.83,
   "end": 980.29,
   "text": "ما مراتب وجود رو داریم میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 980.29,
   "end": 983.75,
   "text": "مجبور شدیم یه ذره بیشتر توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 983.75,
   "end": 987.73,
   "text": "دیگه حبوبات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 987.73,
   "end": 991.13,
   "text": "غلات جوانه زده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 991.13,
   "end": 993.37,
   "text": "مثل گندم، جو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 993.37,
   "end": 998.89,
   "text": "الان این کتابه حیف یادم رفت که آماده‌ش کنم صفحه‌ش و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 998.89,
   "end": 1002.13,
   "text": "این کتاب قانون ابن سینا سلام پیش من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1002.13,
   "end": 1006.72,
   "text": "اصلاً یه جاش هست همین رو شیخ الرئیس میاد خیلی جالب بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1006.72,
   "end": 1011.65,
   "text": "حالا بعداً با-- از توش براتون نشون میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1011.65,
   "end": 1015.15,
   "text": "مثل گندم، جو دو سر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1015.15,
   "end": 1022.41,
   "text": "ماش، عدس، اینا. دیدی عیدها گندم رو می‌ذارن جوونه می‌زن-- الان جوونه گندم یه ذره مد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1022.41,
   "end": 1027.17,
   "text": "برای دموی‌ها خیلی خوبه. دیگه بذرهای ملینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1027.17,
   "end": 1032.23,
   "text": "البته ناشتا بخورن. مثل خاکشیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1032.23,
   "end": 1035.37,
   "text": "مثل اسفرزه، مثل تخم ریحان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1035.37,
   "end": 1038.11,
   "text": "بالنگو، تخم مل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1038.11,
   "end": 1041.99,
   "text": "قدو مه شیرازی، بارنگ و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1041.99,
   "end": 1046.75,
   "text": "و البته تخم مرغ و عسل با هم به مقدار کم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1046.75,
   "end": 1050.11,
   "text": "دموی‌ها خیلی نباید تخم مرغ بخورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1050.11,
   "end": 1052.49,
   "text": "اما کم با عسل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1052.49,
   "end": 1057.77,
   "text": "همراه عسل براشون خوبه. کدو خورشتی براشون خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1057.77,
   "end": 1062.79,
   "text": "نوشیدن دو تا سه تا لیوان آب زرشک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1062.79,
   "end": 1066.83,
   "text": "که کاری می‌کنه که سریعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1066.83,
   "end": 1069.21,
   "text": "خون رو به حالت طبیعی برمی‌گردونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1069.21,
   "end": 1073.37,
   "text": "اگه یادتون باشه یکی دو جلسه قبل ما گفتیم خون غیرطبیعی هم دارین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1073.37,
   "end": 1078.25,
   "text": "نشانه‌هاشم گفتیم. دو سه تا لیوان آب زرشک طبیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1078.25,
   "end": 1083.91,
   "text": "سریع این خون رو اگر غیرطبیعی شده باشه، فاسد شده باشه به سمت طبیعی می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1083.91,
   "end": 1087.55,
   "text": "خیلی خوبه. کم‌خوری هم که گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1087.55,
   "end": 1093.51,
   "text": "استفاده از غذاهای ساده و کم‌کالری مثل سبزیجات بخارپز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1093.51,
   "end": 1098.25,
   "text": "غذا ساده باشه. سعی کنه تا می‌تونه مرکب نخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1098.25,
   "end": 1101.53,
   "text": "ترشی طبیعی براشون خیلی خوبه مثل شاتوت، زرشک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1101.53,
   "end": 1105.41,
   "text": "اینا طبیعی. لیمو ترش، آب، آب نارنج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1105.41,
   "end": 1107.67,
   "text": "سوپ جو خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1107.67,
   "end": 1117.07,
   "text": "روغن زیتون. سالاد رو به نظر شما دموی‌ها قبل غذا بخورن، وسط غذا بخورن یا بعد از غذا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1117.07,
   "end": 1121.95,
   "text": "سالاد با توجه به اینکه توش سبزیجات و این چیزا داره براشون اولاً خوبه گفتین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1121.95,
   "end": 1124.95,
   "text": "اما دموی‌ها باید قبل از غذا سالاد بخورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1124.95,
   "end": 1128.03,
   "text": "یادشون باشه. شیر گوسفند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1128.03,
   "end": 1133.63,
   "text": "خیلی براشون خوبه. الان این شیرایی که تو مغازه‌ها اینا هست همه شیر گاو و گوساله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1133.63,
   "end": 1136.91,
   "text": "برای دموی‌ها باید بگردن شیر گوسفند پیدا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1136.91,
   "end": 1143.21,
   "text": "کمتره اما هست. ماست چکیده خیلی خوبه براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1143.21,
   "end": 1145.95,
   "text": "ترب‌ها، شلغم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1145.95,
   "end": 1148.49,
   "text": "هویج، خیار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1148.49,
   "end": 1151.69,
   "text": "خیار چنبر البته خیلی خوبه براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1151.69,
   "end": 1154.95,
   "text": "تربچه، لوبیا، آناناس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1154.95,
   "end": 1158.07,
   "text": "انجیر، انگور ترش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1158.07,
   "end": 1161.83,
   "text": "خرما با انار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1161.83,
   "end": 1165.45,
   "text": "خرما با انار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1165.45,
   "end": 1168.61,
   "text": "بی انار نه. زردآلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1168.61,
   "end": 1171.55,
   "text": "سیب با پوست و دونش که گفتیم گلابی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1171.55,
   "end": 1177.85,
   "text": "گیلاس، موز، بادام شیرین، بادام زمینی، کنجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1177.85,
   "end": 1183.51,
   "text": "اینا خیلی براشون خوبه. قابل توجه مرفهین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1183.51,
   "end": 1187.13,
   "text": "انشاالله با دهر نوی درد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1187.13,
   "end": 1192.41,
   "text": "جگر، پاچه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1192.41,
   "end": 1196.31,
   "text": "گوشت گوسفند، مغز، زبان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1196.31,
   "end": 1200.33,
   "text": "میگو، مرغ محلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1200.33,
   "end": 1205.95,
   "text": "مرغ غیرمحلی نه. مرغ‌های ماشینی به شدت مضرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1205.95,
   "end": 1208.43,
   "text": "اصن مزاج رو داغون میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1208.43,
   "end": 1210.75,
   "text": "مرغ‌های محلی پیدا کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1210.75,
   "end": 1214.37,
   "text": "و البته معلیز و گل‌گاو زبان اینها هم که خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1214.37,
   "end": 1216.43,
   "text": "گل‌گاو زبان تو سفره شاهدای ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1216.43,
   "end": 1220.35,
   "text": "نمی‌دونم کی تگ زده قیدش زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1220.35,
   "end": 1223.01,
   "text": "و، و، و، و، و دیگه چون عزیزم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1223.01,
   "end": 1225.45,
   "text": "ساعتو نشون داده فرصتمون گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1225.45,
   "end": 1229.03,
   "text": "هست. زیاد هست. می‌تونید تو کتب مرجع مراجعه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 281,
   "start": 1229.03,
   "end": 1236.31,
   "text": "سلام علیکم و رحمة الله. یکی از کتاب‌های مرجع که ما داریم اصن همین قانون ابن سیناس که خدمتتون داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 282,
   "start": 1236.31,
   "end": 1241.17,
   "text": "نشون میدیم. صلوات بفرستین. اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}