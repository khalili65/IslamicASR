 ],
 "cues": [
  {
   "i": 0,
   "start": 1.2,
   "end": 6.08,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.08,
   "end": 10.48,
   "text": "السلام علیک ای داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.48,
   "end": 14.32,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.32,
   "end": 19.64,
   "text": "بسیار باعث تأسف خبری که شنیدیم دیشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.64,
   "end": 22.6,
   "text": "لبنان رو به اون شکل زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.6,
   "end": 25.34,
   "text": "و البته به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.34,
   "end": 27.48,
   "text": "هدف ترور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.48,
   "end": 30.38,
   "text": "سید حسن نصرالله که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.38,
   "end": 33.22,
   "text": "خود اسرائیل ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.22,
   "end": 35.36,
   "text": "تصریح داره در اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.36,
   "end": 39.76,
   "text": "ترورش موفق بوده. اما امیدواریم چون هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.76,
   "end": 44.5,
   "text": "حزب الله بیانیه‌ای صادر نکرده امیدواریم که غلط بوده باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.5,
   "end": 52.28,
   "text": "اگر چنین باشه خاکی بر سرمون شده که خدا لعنت کنه باعث و بانی‌هاشو و من امروز عرض می‌کنم به ذق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.28,
   "end": 54.34,
   "text": "ثقات اونایی که در این انتخابات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.34,
   "end": 57.36,
   "text": "متأسفانه تف سر بالا هم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.36,
   "end": 67.82,
   "text": "که رئیس جمهور ما به رأی مردمی اومد بالا با این دیپلماسی منفعلانه ای که دارن، با این وادادگی‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.82,
   "end": 70.32,
   "text": "در سفر به نیویورک داشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.32,
   "end": 75.28,
   "text": "اون حرفای سخیف زشت که واقعاً دور از شأن مردم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.28,
   "end": 80.22,
   "text": "نه یکی نه دو تا. اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.22,
   "end": 85.02,
   "text": "ایشون عنوان کرد که آمریکا باید ما رو آدم حساب کنه یا اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.02,
   "end": 89.76,
   "text": "وسط میدان جنگ حرف از خلع سلاح می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.76,
   "end": 92.8,
   "text": "این همه آیات قرآن داریم که \"وَأَعِدُّوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.8,
   "end": 96.62,
   "text": "لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.62,
   "end": 99.68,
   "text": "تا اونجایی که می‌تونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.68,
   "end": 103.66,
   "text": "تا استطاعت دارید بر علیه دشمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.66,
   "end": 105.98,
   "text": "نیرو و لشکر و عده و عده جمع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.98,
   "end": 107.56,
   "text": "این خلع سلاح و این قبیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.56,
   "end": 114.04,
   "text": "یا اون معاونش که هنوز نرفته، این همه ما مشکلات داریم، وسط جنگیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.04,
   "end": 122.36,
   "text": "وسط میدان جنگیم. بحث مذاکره رو مطرح می‌کنه در صورتی که طرف مذاکره ما بی‌میله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.36,
   "end": 126.38,
   "text": "چندین سال کشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.38,
   "end": 130.38,
   "text": "کشور و انقلاب رو متوقف نگه داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.38,
   "end": 134.4,
   "text": "حامیان برجامی ما و این‌ها به همین بهانه‌ها متأسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.4,
   "end": 136.6,
   "text": "این‌ها می‌خوام عرض کنم که کسایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.6,
   "end": 143.3,
   "text": "که چه دانسته چه ندانسته در این انتخابات سهیم بودن و ایشون رو انتخاب کردن باید جوابگو باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.3,
   "end": 147.82,
   "text": "جوابگوی این خون‌های ریخته شده باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.82,
   "end": 158.38,
   "text": "که نذارن حتی انتخاب-- انتقام شهید حنیه گرفته بشه به بهانه نتیجه گرفتن در مذاکرات و چه وچه بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.38,
   "end": 161.6,
   "text": "امیدوارم که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.6,
   "end": 165.12,
   "text": "به قول رهبر عزیزمون که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.12,
   "end": 170.66,
   "text": "عید فطر امسال فرمودن خدایا ملت ایران رو دشمن شاد نکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.66,
   "end": 177.06,
   "text": "به ما رحم کنه و واقعاً دشمن شاد نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.06,
   "end": 179.62,
   "text": "خب برگردیم به موضوعمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.62,
   "end": 187.66,
   "text": "من خواهش می‌کنم، استدعای می‌کنم واقعاً بی‌معرفتیم ما اگر تو این لحظات حساس و این شبانه روز و این سحرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.66,
   "end": 196.14,
   "text": "که ما داره می‌گذره دعا نکنیم، دست دعا برنداریم و متضرعانه برای جبهه مقاومت دعا نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 196.14,
   "end": 198.63,
   "text": "\"الدعاء یرد القضاء المبرم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.63,
   "end": 200.44,
   "text": "\"الدعاء سلاح المومن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.44,
   "end": 202.54,
   "text": "بزرگترین سلاح ما دعاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.54,
   "end": 205.64,
   "text": "قضای محکم الهی رو دعا رفع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 205.64,
   "end": 210.2,
   "text": "لذا خواهش می‌کنم که جدی بگیریم، اهل دعا باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.2,
   "end": 211.97,
   "text": "و اخبار رو پی-- پی بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.97,
   "end": 214.78,
   "text": "ان‌شاءالله که خدای منان خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.78,
   "end": 219.54,
   "text": "به يد قدرت خودش پوزه این ملعون رو به خاک بماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.54,
   "end": 228.48,
   "text": "بحث ما پیرامون معرفت نفس رسیده بود به شناخت یکی از لایه‌های وجودیمون به نام روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.48,
   "end": 237.7,
   "text": "ااا امروز عرض می‌کنیم که هر کجا از بافت‌های بدن ما، اعضای بدن ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.7,
   "end": 244.74,
   "text": "روح بخاری در اون معتدل‌تره، به یک معنا مزاج اعتدال بیشتری داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 244.74,
   "end": 250.8,
   "text": "اتفاقاً روح به، به اون بافت و به اون عضو بیشتر تعلق می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 250.8,
   "end": 253.74,
   "text": "مثلاً شما نوک انگشتاتون رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 253.74,
   "end": 260.4,
   "text": "وقتی می‌خواید یه جایی رو حس کنید، کف دستتون که نمی‌گذارید، با نوک انگشت حس می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 260.4,
   "end": 263.06,
   "text": "سرده، گرمه، به چه شکله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 263.06,
   "end": 266.0,
   "text": "چرا؟ چون نوک انگشت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 266.0,
   "end": 269.93,
   "text": "روح بیشتری بهش تعلق گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 269.93,
   "end": 275.22,
   "text": "از نفس ناطقه یعنی توجه نفس ناطقه به اونجا بیشتره به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.22,
   "end": 281.44,
   "text": "چرا؟ به جهت اینکه روح بخاری در اونجا یا مزاج اونجا معتدل‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 281.44,
   "end": 285.8,
   "text": "حالا باز در میان انگشته شما می‌بینید که انگشت اشاره این انگشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 285.8,
   "end": 288.8,
   "text": "این انگشت اشاره باز می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 288.8,
   "end": 293.06,
   "text": "چرا ما اصلاً فطرتاً با این انگشت اشاره می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 293.06,
   "end": 299.48,
   "text": "به جهت اینکه باز بین این انگشتا، این انگشت اشاره روح بیشتری بهش تعلق گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 299.48,
   "end": 303.88,
   "text": "ظاهراً نتیجه می‌گیریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 303.88,
   "end": 306.88,
   "text": "مزاجش معتدل‌تر از انگشت‌های دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 306.88,
   "end": 312.18,
   "text": "بعد حالا چه سری داره که در دعاهای، دعای بعد از نمازهای واجب ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 312.18,
   "end": 315.16,
   "text": "رجب این انگشت تکون داده می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 315.16,
   "end": 319.98,
   "text": "یا وقتی می‌خوایم به امام معصوم توجه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 319.98,
   "end": 324.92,
   "text": "و سلام بدیم، میگن مستحبه این انگشت رو اینطوری به صورت اشاره نگه‌داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 324.92,
   "end": 327.9,
   "text": "حالا چه سری هست؟ قطعاً اسراری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 327.9,
   "end": 330.9,
   "text": "اهلش یا گفتن یا نه نگفتن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 330.9,
   "end": 333.94,
   "text": "بالاخره هست. اسراری هست بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 333.94,
   "end": 342.12,
   "text": "اینکه نفس ناطقه از طریق این انگشت راحت‌تر می‌تونه ارتباط بگیره با مخاطب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 342.12,
   "end": 348.34,
   "text": "اگر خدا لطف کنه بعضاً حالا چیز، چیزکی بعدها خواهیم گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 348.34,
   "end": 351.38,
   "text": "چون فعلاً موضوع ما چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 351.38,
   "end": 357.9,
   "text": "اتفاقاً حضرت علامه عسگرزاده علیه الرحمه روحش شاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 357.9,
   "end": 365.14,
   "text": "به نقل از علامه شهرانی استاد عزیزشون می‌فرمودن که از ایشون سؤال کردن که اگر این انگشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 365.14,
   "end": 368.58,
   "text": "انگشت اشاره است چرا سبابه هم بهش می‌گن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 368.58,
   "end": 371.94,
   "text": "سب یعنی دشنام می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 371.94,
   "end": 375.2,
   "text": "چرا انگشت سبابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 375.2,
   "end": 379.84,
   "text": "که ربط به دشنام دادن داره و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 379.84,
   "end": 382.8,
   "text": "ایشون فرموده بودند که به جهت اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 382.8,
   "end": 388.82,
   "text": "چه عجیب که آدمی وقتی غضبش رو هم که می‌خواد پیاده کنه با این انگشت اشاره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 388.82,
   "end": 390.4,
   "text": "مثلاً میدونم با تو چیکار کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 390.4,
   "end": 393.24,
   "text": "به این شکل این انگشت رو تکون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 393.24,
   "end": 396.96,
   "text": "این یعنی باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 396.96,
   "end": 400.48,
   "text": "فطرتاً بدون اینکه کسی بخواهد آموزش بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 400.48,
   "end": 408.04,
   "text": "ظاهراً اثر این انگشت رو در برخورد با مخاطب چه از حیث رحمت و رأفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 408.04,
   "end": 412.02,
   "text": "و لطافت و لطف یا از حیث قهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 412.02,
   "end": 415.98,
   "text": "و شدت بیشتر می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 415.98,
   "end": 425.54,
   "text": "حالا نکته‌ای رو که جلسه پیش عرض کردیم پیرامون رعشه در بدن و ربطش با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 425.54,
   "end": 427.5,
   "text": "عدم تعادل روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 427.5,
   "end": 430.3,
   "text": "حالا به خاطر یا شادی یا غم یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 430.3,
   "end": 434.76,
   "text": "عرض شود خبر هولناک یا اون چیزهایی که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 434.76,
   "end": 443.54,
   "text": "که در حقیقت به هم ریختگی یا عدم تعادل روح بخاری حالا یا قبضش، بستش یا مضمحل شدنش هرچی که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 443.54,
   "end": 447.8,
   "text": "شاید بعضیا تو ذهنشون اینطوری متوهم بشه که پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 447.8,
   "end": 451.78,
   "text": "بزرگان اهل معرفتی رو ما سراغ داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 451.78,
   "end": 456.86,
   "text": "خیلی بزرگ بودند. از جهت معنوی استوانه‌ای بودند، استوانه توحید بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 456.86,
   "end": 459.4,
   "text": "بعد چرا اینها رعشه داشت بدنشون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 459.4,
   "end": 460.94,
   "text": "یعنی اینا توجه نداشتند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 460.94,
   "end": 464.44,
   "text": "یعنی اینا روح بخاریشون یا مزاجشون معتدل نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 464.44,
   "end": 469.46,
   "text": "و این سؤالات مثل مثلاً علامه طباطبایی شاهد بودید دیگه ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 469.46,
   "end": 472.88,
   "text": "روحشون شاد، اواخر عمر رعشه داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 472.88,
   "end": 481.32,
   "text": "خب این صرفاً رعشه برنمی‌گرده به اون عواملی که گفتیم ما به عنوان نمونه بعضی از عواملی که شیخ الرئیس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 481.32,
   "end": 489.5,
   "text": "بیان می‌کنه رو گفتیم. اتفاقاً یکی از موارد دیگری که شیخ الرئیس بیان می‌کنه می‌فرماید وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 489.5,
   "end": 493.16,
   "text": "روح به شدت قوی بشه، دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 493.16,
   "end": 500.48,
   "text": "روح خیلی قوی بشه و از اون طرف هم بافت‌های بدن به خصوص عضلات ضعیف بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 500.48,
   "end": 506.12,
   "text": "بالاخره در، در کثرت عبادت و مطالعه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 506.12,
   "end": 511.96,
   "text": "کارهای عبادی و درسی و علمی و معرفتی و اینها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 511.96,
   "end": 514.08,
   "text": "طرف خب فرصت نمی‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 514.08,
   "end": 520.98,
   "text": "ورزش کنه یا به هر دلیلی سنش رفته بالا حتی اگر هم نرمش و ورزش داشته باشه سن که میره بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 520.98,
   "end": 523.86,
   "text": "\"ومن نعمره منعکسه فی الخلق\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 523.86,
   "end": 527.28,
   "text": "منعکس میشه بحث خلق و خلقت و رو به ضعف میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 527.28,
   "end": 530.36,
   "text": "از شدت از اون قوت به سمت ضعف میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 530.36,
   "end": 534.92,
   "text": "بافت‌های بدن وقتی که به سمت ضعف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 534.92,
   "end": 544.06,
   "text": "میرن، روح وقتی خیلی قوی باشه نفس ناطقه قدرت بگیره روح بزرگ بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 544.06,
   "end": 546.76,
   "text": "این تعادل به هم می‌ریزه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 546.76,
   "end": 553.22,
   "text": "در حقیقت نفس و روح انقدر بزرگ شده نمی‌تونه از طریق روح بخاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 553.22,
   "end": 555.56,
   "text": "اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 555.56,
   "end": 560.86,
   "text": "بافت‌ها و اون بدن و بدن ضعیف رو تحت اراده خودش قرار بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 560.86,
   "end": 562.92,
   "text": "یعنی در حقیقت بالعکس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 562.92,
   "end": 570.4,
   "text": "اون بافت، اون بد-- اون قسمت‌های بدن، اون عضلات اونها نمی‌تونند تحت تصرف و اون قوه قرار بگیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 570.4,
   "end": 575.22,
   "text": "مثل یک رعد و برقی که بزنه یه پر کاهی رو جابجا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 575.22,
   "end": 579.8,
   "text": "به این شکله. در هر حال این رو هم گفتم که حالا بعد باز سؤال پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 579.8,
   "end": 583.2,
   "text": "ما هم در خدمتتون هستیم. اتاق ما هم که اینجا همین بغل هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 583.2,
   "end": 590.42,
   "text": "در خدمت هر سوالی، چیزی براتون پیش اومد به جای اینکه این مباحث رو جلوگیری کنید و تخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 590.42,
   "end": 593.88,
   "text": "سینه ما بزنید و بگید آقا ما نمی‌فهمیم و سخته و سنگینه و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 593.88,
   "end": 597.44,
   "text": "اینجور حرفا که مانع خیر بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 597.44,
   "end": 603.88,
   "text": "سوالی پیش میاد بپرسید. بنده هم تا اونجایی که سوادم اقتضا کنه و دسترسی به منابع علمی داشته باشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 603.88,
   "end": 608.88,
   "text": "جوابگو هستم. بیاید بپرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 608.88,
   "end": 611.0,
   "text": "سؤال مثلاً پیش میاد که پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 611.0,
   "end": 617.04,
   "text": "ائمه معصومین علیهم الصلاة والسلام که روح کلیه الهیه بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 617.04,
   "end": 619.76,
   "text": "ولایت کلیه الهیه رو داشتند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 619.76,
   "end": 630.06,
   "text": "روح اعظم بودند. اینها چگونه اون بدن توان کشش و کشش این مثلاً این ظرفیت رو داشت که بتونه اون بار سنگین اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 630.06,
   "end": 632.16,
   "text": "عرض شود روح رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 632.16,
   "end": 634.64,
   "text": "اون روح بلند و بزرگ رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 634.64,
   "end": 640.4,
   "text": "بگیره به خودش. این اولاً اهل بیت علیهم الصلاة والسلام همه ورزشکار بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 640.4,
   "end": 644.1,
   "text": "و بدن‌های به شدت قوی و تنومندی داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 644.1,
   "end": 648.2,
   "text": "مضافاً به اینکه قبلاً ما عرض کردیم یه استثناء وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 648.2,
   "end": 652.74,
   "text": "وقتی که روح خیلی قوی میشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 652.74,
   "end": 655.18,
   "text": "عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 655.18,
   "end": 659.34,
   "text": "انقدر تصرفش در بدن بالا میره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 659.34,
   "end": 662.64,
   "text": "می‌تونه احکام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 662.64,
   "end": 669.12,
   "text": "در حقیقت احکام خودش رو نه از حیث اینکه تحت الامرش بدنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 669.12,
   "end": 674.82,
   "text": "احکام عالم مجردات رو پیاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 674.82,
   "end": 680.16,
   "text": "یعنی بدن رو با خودش بکشه بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 680.16,
   "end": 683.34,
   "text": "دیگه قضیه بعکس میشه. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 683.34,
   "end": 687.6,
   "text": "عرض شود این یه جوابه البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 687.6,
   "end": 690.14,
   "text": "جواب دیگه‌ای هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 690.14,
   "end": 692.34,
   "text": "جواب‌های متعدد. فرصت من گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 692.34,
   "end": 699.4,
   "text": "جواب دیگه‌ای هم هست. اون هم اینکه در مولودنامه پیغمبر عزیز عالم و اهل بیت علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 699.4,
   "end": 702.36,
   "text": "می‌خوانید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 702.36,
   "end": 704.33,
   "text": "بدن اون‌ها هم خاص بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 704.33,
   "end": 705.92,
   "text": "مثلاً در خصوص حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 705.92,
   "end": 707.72,
   "text": "صدیقه شهیده فاطمه زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 707.72,
   "end": 715.32,
   "text": "صلوات الله علیها داریم که چندین برابر دختران روزگار خودشون ایشون رشد داشتند، بنیه جسمی داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 715.32,
   "end": 721.68,
   "text": "اون بنیه محمدی صلی الله علیه وسلم در اینها بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 721.68,
   "end": 728.2,
   "text": "فران داشت، قوت و قدرت داشت و این بنیه مستقیم در بدنشون هم تاثیر می‌ذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 728.2,
   "end": 731.98,
   "text": "ضمن اینکه بدن اصلاً بدن خاص و ویژه‌تری بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 731.98,
   "end": 734.44,
   "text": "خب تا همین مقدار اکتفا می‌کنیم فعلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 734.44,
   "end": 737.0,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 737.0,
   "end": 739.24,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 739.24,
   "end": 741.51,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}