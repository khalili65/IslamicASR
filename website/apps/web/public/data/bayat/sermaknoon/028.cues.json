 ],
 "cues": [
  {
   "i": 0,
   "start": 0.84,
   "end": 5.82,
   "text": "بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.82,
   "end": 9.66,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.66,
   "end": 14.84,
   "text": "آيات. سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.84,
   "end": 18.32,
   "text": "نیت کردیم که با تقاضای خود عزیزان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.32,
   "end": 25.8,
   "text": "ااا بریم این هفته روی همون ادامه مبحث مزاج و روح بخاری کار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.8,
   "end": 31.72,
   "text": "در بین البته تبریک عرض می‌کنم این ایام فرخنده و پر خیر و برکت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.72,
   "end": 34.08,
   "text": "پر نور و پرسرور و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.08,
   "end": 40.12,
   "text": "دیگه ما مسرت بخش‌تر از ماه شعبان نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.12,
   "end": 43.7,
   "text": "شعبه شعبه رحمت حق جاریه و ساریه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.7,
   "end": 49.08,
   "text": "برای موجود هم به هر کس که ماه رجبش رو از دست داده این ماه جبران میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.08,
   "end": 52.8,
   "text": "اگه بتونه این ماه وصل به کاروان جبران میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.8,
   "end": 56.92,
   "text": "ماه شعبان درون مایه اش به مراتب از رجب بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.92,
   "end": 60.82,
   "text": "آره. دیگه این اعیاد هم که نور على نور کرده همه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.82,
   "end": 63.58,
   "text": "امشب هم که دیگه آدم زبانش لاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.58,
   "end": 66.26,
   "text": "چی بگه؟ تولد و میلاد چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.26,
   "end": 71.08,
   "text": "کسیه؟ چه وجود زی جود و آخرین یادگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.08,
   "end": 76.48,
   "text": "حدیث کسا. خامس آل محمد و صلوات الله علیه و آله و sel.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.48,
   "end": 78.76,
   "text": "به هر حال تبریک عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.76,
   "end": 82.34,
   "text": "والا اگر بشه در بین بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.34,
   "end": 84.1,
   "text": "یه ربطی هم به این ایام میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.1,
   "end": 88.82,
   "text": "اون صحبتی که بین دو نماز امروز داشتیم رو یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.82,
   "end": 91.6,
   "text": "در حقیقت تخصصی‌ترش رو شاید براتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.6,
   "end": 98.34,
   "text": "ارائه بدیم. در اینجا بودم اگر چنانچه اشتباه می‌کنم بگید در بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.34,
   "end": 101.2,
   "text": "تغییرات فلسفی حضرت امام علیه الرحمه بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.2,
   "end": 106.02,
   "text": "پیرامون نفس و مزاج و روح بخاری و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.02,
   "end": 108.88,
   "text": "اقوال مختلف رو بررسی میشد و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.88,
   "end": 117.8,
   "text": "حالا به اینجا فکر می‌کنم رسیدیم که حضرت امام فرمودند اگر در ابواب اطعمه و اشربه کتب فقهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.8,
   "end": 126.7,
   "text": "در لسان انبیا و ائمه هدی علیهم الصلاة و السلام از برخی از مواد غذایی انتقاد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.7,
   "end": 131.48,
   "text": "و طباع را یعنی طبع‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.48,
   "end": 134.46,
   "text": "مثلا میگن طبع من با این غذا نمی‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.46,
   "end": 138.5,
   "text": "و طباع را از آنها تنفر داده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.5,
   "end": 143.16,
   "text": "یعنی میگه آقا یه طبع سالم باید متنفر باشه از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.16,
   "end": 146.48,
   "text": "غذا، از این نوع آشامیدنی اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.48,
   "end": 152.84,
   "text": "و طباع را از آنها تنفر داده‌اند و یا به بعضی تحریص و تق-ترغیب نمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.84,
   "end": 157.12,
   "text": "برعکس به بعضی رو اینو، اینو سعی کنید زیاد بخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.12,
   "end": 160.1,
   "text": "تو سبد غذاییتون اصطلاحاً باشه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.1,
   "end": 164.48,
   "text": "و بعضی از مواد را تحریم نمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.48,
   "end": 167.46,
   "text": "بعضی رو گفتند اصلا نخورید مطلقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.46,
   "end": 170.44,
   "text": "و بعضی را مستحب و حالا اقسامش دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.44,
   "end": 174.22,
   "text": "مستحب و مباح اعلام نمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.22,
   "end": 180.44,
   "text": "حالا خواستید رجوع کنید به کتاب وسائل شیعه جلد شونزده و هفده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.44,
   "end": 183.5,
   "text": "اون بخش یا کتاب اطعمه و اشربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.5,
   "end": 187.22,
   "text": "تا دلتون بخواد پیرامون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.22,
   "end": 190.58,
   "text": "قلم زده دیگه روایات رو از اهل بد آورده که چه چیزهایی بخوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.58,
   "end": 194.82,
   "text": "چه چیزهایی نخوری، چه چیزهایی مستحبه، چه چیزهایی مباحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.82,
   "end": 203.18,
   "text": "خیلی شیرینه. امام علیه الرحمه هم می‌فرماید که اگر اینطوری گفتند به بعضیا رو ترغیب کردن، بعضی خوردنی‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.18,
   "end": 209.66,
   "text": "تحریص کردن یا مثلا تحریم کردن و امثالهم نظرشان نظر کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.66,
   "end": 212.28,
   "text": "نظر انبیا، اولیا، ائمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.28,
   "end": 217.58,
   "text": "نظرشان به تحریص بر خوردن و خدمت به بطن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.58,
   "end": 221.32,
   "text": "نه برای شکمه. چون اطباء میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.32,
   "end": 225.12,
   "text": "اینو بخور ویتامین فلانت زیاد شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.12,
   "end": 227.88,
   "text": "مثلا قوه کمرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.88,
   "end": 229.48,
   "text": "بالا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.48,
   "end": 231.88,
   "text": "قوه بینائیت فلان شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.88,
   "end": 236.22,
   "text": "پوستت لطیف شه، سفید شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.22,
   "end": 240.14,
   "text": "نمیدونم ریشات دیرتر سفید شه، دیرتر پیر شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.14,
   "end": 244.1,
   "text": "امثال این چیزا. صورتت چروک نخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.1,
   "end": 248.96,
   "text": "ها؟ و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.96,
   "end": 255.04,
   "text": "اما حضرت امام علیه الرحمه می‌فرمایند که انبیا نظرشون این نیستا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 255.04,
   "end": 260.22,
   "text": "حواستون باشه. زیرا این کار شأن انبیا نمی‌باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.22,
   "end": 263.58,
   "text": "اما اینجا می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.58,
   "end": 268.12,
   "text": "چی؟ این کار شأن انبیا نمی‌باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.12,
   "end": 271.32,
   "text": "شأن انبیا چیه؟ هدایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.32,
   "end": 275.58,
   "text": "هدایت. کار اونا کار هدایتیه، معنویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.58,
   "end": 279.88,
   "text": "بلکه این چیزایی که گفتیم حضرت امام می‌فرماید شأن کیاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.88,
   "end": 282.76,
   "text": "طباخین دنیاییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.76,
   "end": 285.1,
   "text": "اما انبیا چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.1,
   "end": 292.64,
   "text": "روحانیت انسان و صفای ذوات و روحیات و تنویر قلوب و افکار خود را معرفی می‌نماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 292.64,
   "end": 295.9,
   "text": "یعنی اونها بحثشون هدایت بوده، بحث باطن بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 295.9,
   "end": 302.1,
   "text": "مثلا اینکه آقا این غذا رو بخوری لطیفه یعنی نورانیت تو رو، صفای تو رو بیشتر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.1,
   "end": 309.9,
   "text": "این غذا رو بخوری کثیفه یعنی تو رو زمخت می‌کنه، تو رو سنگین می‌کنه، تو رو تاریک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.9,
   "end": 313.06,
   "text": "مرام و منظور خود را تعقیب می‌نمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.06,
   "end": 316.02,
   "text": "کیا؟ انبیا. که من-- منظورشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.02,
   "end": 318.6,
   "text": "تنویر قلوب بود. نورانی کردن دل‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.6,
   "end": 322.26,
   "text": "نه دعوت به دنیا و خوردن و نوشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 322.26,
   "end": 329.82,
   "text": "و در هر حکمی اصل منظور خود را در نظر دارند که توده بشر را به عالم نور گسیل دهند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 329.82,
   "end": 340.98,
   "text": "و قلوب را به مبدا عالم جلب نمایند و صفحه الهی وجود انسانی را صیقل و صاف و زلال نمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 340.98,
   "end": 344.84,
   "text": "و در همان تحریص و ترغیب به اغضیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 344.84,
   "end": 351.4,
   "text": "استکمال وجود بشر و صفای ذات افراد انسان را در نظر دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 351.4,
   "end": 354.44,
   "text": "خیلی جالبه. نگاه رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 354.44,
   "end": 358.58,
   "text": "کی اینطوری نگاه می‌کنه به دین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.58,
   "end": 361.36,
   "text": "که بستر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 361.36,
   "end": 365.38,
   "text": "در حقیقت پایه و جایگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 365.38,
   "end": 369.63,
   "text": "دعوت انبیا و اولیای الهی اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 369.63,
   "end": 374.17,
   "text": "که دل‌ها رو نورانی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 374.17,
   "end": 377.63,
   "text": "به عالم نور گسیل بده توده بشر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 377.63,
   "end": 380.85,
   "text": "میگه اون ذات وجود انسان‌ها رو صیقل بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 380.85,
   "end": 383.63,
   "text": "اگه میگه اینو بخور اونو نخور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.63,
   "end": 388.59,
   "text": "یعنی چی؟ تو اگه اینو بخوری اون ذات وجود انسانیت صیغل میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 388.59,
   "end": 392.21,
   "text": "خیلی جالبه‌ها دقت کنید. مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.21,
   "end": 394.23,
   "text": "الان یه مثال مصداق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 394.23,
   "end": 397.39,
   "text": "آقا عدس زیاد بخورید اشک چشمو زیاد میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 397.39,
   "end": 400.03,
   "text": "ببینید هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 400.03,
   "end": 402.69,
   "text": "طبیبی میاد همچین حرفی بزنه آقا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 402.69,
   "end": 407.79,
   "text": "ع-عدس بخور به جهت اینکه اشکت زیاد شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 407.79,
   "end": 411.21,
   "text": "اتفاقا میگه برو یه چیزی بخور خندت زیاد شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 411.21,
   "end": 417.29,
   "text": "هر و کر بخندی. چرا اشک به جهت اینکه اشک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 417.29,
   "end": 421.05,
   "text": "اون راه ارتباطی ما به ملکوت عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 421.05,
   "end": 424.11,
   "text": "ملاصدرا هم تمام این چیزهای اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 424.11,
   "end": 433.67,
   "text": "حقایق عرشی که تو اسوارش ریخته و همه حکما و عقلا رو حیران خودش کرده فرمود من اینو از اشک سحرم دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 433.67,
   "end": 437.09,
   "text": "اشک سحرم. از سجاده و اشک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 437.09,
   "end": 439.35,
   "text": "آه که در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 439.35,
   "end": 443.55,
   "text": "در زندگی ما متاسفانه خیلی کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 443.55,
   "end": 451.41,
   "text": "ربط ذات وجودی ما، صیغل خوردن باطن آدم‌ها به اغذیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 451.41,
   "end": 455.31,
   "text": "بابا این ماده‌ست. اون مجرده، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 455.31,
   "end": 457.93,
   "text": "باطنه، این ظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 457.93,
   "end": 463.89,
   "text": "این چه ربطی با هم داره؟ وقتی متوجه میشیم که باطن عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 463.89,
   "end": 466.99,
   "text": "در خلقت ظاهر آ-عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 466.99,
   "end": 470.37,
   "text": "چه ربطی به هم دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 470.37,
   "end": 476.21,
   "text": "به اون معنای قبلی که گفتیم وحدت رو در کثرت و کثرت رو در وحدت میبینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 476.21,
   "end": 480.31,
   "text": "این‌ها رو یک نظام واحد میبینی با انواع مختلف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 480.31,
   "end": 482.69,
   "text": "سیر معارف الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 482.69,
   "end": 492.35,
   "text": "شؤون مختلف یک حقیقت کلیه و بسیط الحقیقه در توحید صمدی و در خودتم وقتی اینطوری فکر میکنی اصلاً نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 492.35,
   "end": 495.93,
   "text": "همه با هم مر-مربوطن، مرتبط‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 495.93,
   "end": 500.65,
   "text": "ارتباطات. اصلاً همه خلائق و کثرات عین ربط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 500.65,
   "end": 503.53,
   "text": "به خالقشونن. عین، عین ربطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 503.53,
   "end": 506.03,
   "text": "نه یه چیزی هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 506.03,
   "end": 513.39,
   "text": "که حالا، حالا که هستن یه ربطی هم بین اینا، یه رابطه‌ای هم بین این‌ها و خالقشون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 513.39,
   "end": 515.33,
   "text": "هم چیزی ما تعریفی هم اینچنینی نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 515.33,
   "end": 520.89,
   "text": "این تعریف کبر. علامه میفرمود یه برگ از درخت بیفته تو تمام کائنات تاثیر میگذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 520.89,
   "end": 525.87,
   "text": "چرا ما گناه میکنیم اون سر دنیا امام زمانمون استغفارش رو میکنه، توبه‌ش رو میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 525.87,
   "end": 531.69,
   "text": "چه تاثیری تو انسان کامل هست، تو در جهان هست که میفر-- اون استغفار میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 531.69,
   "end": 534.57,
   "text": "همه عالم به هم عین ربط به ذات غیبی‌n.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 534.57,
   "end": 537.15,
   "text": "عین ربط به خالقشونن کثرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 537.15,
   "end": 540.29,
   "text": "و با هم هم مرتبط‌اند. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 540.29,
   "end": 542.41,
   "text": "یعنی ظاهر و باطن در هم تنیده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 542.41,
   "end": 545.53,
   "text": "ما قبلاً گفتیم تو سیر کتاب الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 545.53,
   "end": 550.75,
   "text": "شما فکر نکنید میری بالا، میری بالا، میری مثل سرت میخوره به سقف آسمان دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 550.75,
   "end": 554.19,
   "text": "حالا از اینجا به بعد برزخ و عالم مثال شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 554.19,
   "end": 559.37,
   "text": "اینطوری نیست. مثل الان حضرت عالی روحت کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 559.37,
   "end": 564.49,
   "text": "روح شما کجاست حسین آقا؟ کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 564.49,
   "end": 567.47,
   "text": "تو وجودته. یعنی جدایی از تو نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 567.47,
   "end": 571.35,
   "text": "درسته؟ اون لایه‌های باطنی خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 571.35,
   "end": 575.77,
   "text": "درست شد؟ یعنی رتبه مثالی که برزخ شماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 575.77,
   "end": 579.35,
   "text": "مثال متصل یا قوه خیالت تو خود شماست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 579.35,
   "end": 581.95,
   "text": "بیرون از شما که، بیرون که نمیگردی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 581.95,
   "end": 585.33,
   "text": "در عین حال که یک وجود واحد، یه ظاهر داره، یه باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 585.33,
   "end": 590.17,
   "text": "حالا عالمم همین شکلیه. عالم هم باطن عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 590.17,
   "end": 594.03,
   "text": "یه رتبه پا-- باطن‌ترش میشه مثال منفصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 594.03,
   "end": 595.69,
   "text": "چون از ما بیرونه میگیم منفصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 595.69,
   "end": 601.27,
   "text": "اون رتبه مثالی عالم برزخ که ارواح الان اونجان فکر میکنید مثلاً یه جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 601.27,
   "end": 604.21,
   "text": "ورای مثلا جدایی از این دنیاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 604.21,
   "end": 607.47,
   "text": "مثل اینکه قوه خیال جدایی از شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 607.47,
   "end": 612.03,
   "text": "رتبه خیال شما، رتبه عقل شما جدایی از وجود شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 612.03,
   "end": 615.65,
   "text": "تو شماست. دیگه چجوری مثال بزنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 615.65,
   "end": 623.77,
   "text": "رتبه برز-- عالم برزخ هم توی همین نشئه طبیعته که الان حضرت عالی تشریف داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 623.77,
   "end": 626.69,
   "text": "خب این نظام گسیخته از هم نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 626.69,
   "end": 631.43,
   "text": "درست شد؟ چشمت اگه باز بشه برزخ رو تو دل همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 631.43,
   "end": 634.61,
   "text": "خاک، همین نشئه و همین طبیعت میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 634.61,
   "end": 641.89,
   "text": "تو دل همین جا. اگر این تاثیر و تاثیرات و این ارتباطات، ارتباطات عینیه و حقیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 641.89,
   "end": 645.37,
   "text": "حقیقیه، این‌ها رو اگه کسی ببینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 645.37,
   "end": 649.47,
   "text": "چشمش باز بشه، ارواح رو، عالم برزخو تو همین دنیا میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 649.47,
   "end": 651.99,
   "text": "همین جا میبینه نه یه جای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 651.99,
   "end": 656.43,
   "text": "منتها در باطن این دنیاست که چشمت باز بشه باطن اینجا رو میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 656.43,
   "end": 662.45,
   "text": "مثل اینکه شما چشمت وقتی میخوابی چشمت به باطن خودت باز میشه، باطن خودت رو داری میبینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 662.45,
   "end": 666.11,
   "text": "تو عالم برزخ. برزخ وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 666.11,
   "end": 673.77,
   "text": "که حالا عرض کردیم ظهرم تو نماز که هر کسی حالا این حالا ادامه‌ش میدیم غصه نخورید چون الان وقت داره میگذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 673.77,
   "end": 675.85,
   "text": "روزای بعد انشاالله این رو بازش میکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 675.85,
   "end": 680.35,
   "text": "هر کسی نسبت به اون صیعه وجودیش، اون برزخ وجودیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 680.35,
   "end": 684.75,
   "text": "اون رتبه‌های باطنش، جایگاه عقلی‌ش، روحی‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 684.75,
   "end": 688.95,
   "text": "صیعه اندازه‌ای که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 688.95,
   "end": 692.27,
   "text": "به میزانی که از اون خزانه پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 692.27,
   "end": 700.85,
   "text": "خب. که که امام عصر از اون سر القدر باخبره، ماها بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 700.85,
   "end": 704.59,
   "text": "به اون اندازه‌ای که پیدا کرده نازل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 704.59,
   "end": 707.27,
   "text": "که و أنزلنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 707.27,
   "end": 713.25,
   "text": "یا أنزل أنزل من السماء ماءً فسالت أودیتن بقدرها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 713.25,
   "end": 720.81,
   "text": "آب بارون که میاد هر وادی به اندازه صیعه وجودی خودش از اون آب بهره میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 720.81,
   "end": 730.35,
   "text": "این فیض که نازل شده هر کسی به قدر خودش گرفته از اندازه وجودی خودش یک وجودی پیدا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 730.35,
   "end": 733.86,
   "text": "که ربط وجودیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 733.86,
   "end": 737.66,
   "text": "ربط وجودیش با ساعات و آنات مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 737.66,
   "end": 740.72,
   "text": "این علم الهیه ماها نداریمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 740.72,
   "end": 745.64,
   "text": "یعنی ربط ما با عالم برزخ، ربط ما با عالم غول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 745.64,
   "end": 748.1,
   "text": "ارواح، مفارقات، مرسلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 748.1,
   "end": 753.0,
   "text": "حتی ربط ما به وجود فیض مامتست که صادر اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 753.0,
   "end": 757.28,
   "text": "هر فیضی از طرف خدا به ما میاد از اونجا نازل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 757.28,
   "end": 762.44,
   "text": "نفس الرحمن. اون نفحه و نفس الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 762.44,
   "end": 764.94,
   "text": "به عنوان یک فیض به ما میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 764.94,
   "end": 770.34,
   "text": "بین ما و این عالم پیرامون یه رابطه‌ای برقراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 770.34,
   "end": 773.14,
   "text": "یک سنخیت و جنسیتی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 773.14,
   "end": 775.54,
   "text": "درست شد؟ تا اینجاش که مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 775.54,
   "end": 786.0,
   "text": "همچنین یکی از اون خلائق و این کثرات و از این عوالم از این رتبه‌ها از این اطوار بیرون از ما هم ساعات و آنات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 786.0,
   "end": 790.24,
   "text": "ساعت، آنی، همین لحظه، همین آن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 790.24,
   "end": 793.02,
   "text": "زمان. اینا موجود زنده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 793.02,
   "end": 796.62,
   "text": "اینام خلق‌اند. بین ما و اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 796.62,
   "end": 799.82,
   "text": "رابطه‌ای هست. نسبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 799.82,
   "end": 803.68,
   "text": "به این رابطه‌ای که بین ما و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 803.68,
   "end": 806.6,
   "text": "زمان و ساعت و اون آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 806.6,
   "end": 809.76,
   "text": "و اون روز و اون شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 809.76,
   "end": 814.94,
   "text": "وجود داره، ما همون موقع از دنیا میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 814.94,
   "end": 818.1,
   "text": "من خیلی سربسته دارم اینو به شما میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 818.1,
   "end": 824.2,
   "text": "این هم، این هم چون اگه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 824.2,
   "end": 832.5,
   "text": "یه مقدار زودتر این چیزا رو متوجه بشه اذیت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 832.5,
   "end": 836.08,
   "text": "به هر حال اجازه بدید ازش فعلا رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 836.08,
   "end": 838.86,
   "text": "حالا دوست داشتید بعدها بازترش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 838.86,
   "end": 843.26,
   "text": "که مثلا چرا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 843.26,
   "end": 848.1,
   "text": "چرا امام حسین صلوات الله علیه باید امشب به دنیا بیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 848.1,
   "end": 850.48,
   "text": "چرا؟ یه ربطی بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 850.48,
   "end": 854.34,
   "text": "امام و این ساعت و اون روز و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 854.34,
   "end": 857.06,
   "text": "لحظه وجود داشته و هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 857.06,
   "end": 862.28,
   "text": "یا بهتره در خصوص انسان کامل بگیم بین اون ساعت و امام یک ربطی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 862.28,
   "end": 870.6,
   "text": "در خصوص ما بلعکسه. خب وقتی می‌فرمود نحن ایام الله بحث که بین دو نماز کردیم الان ربطشو داریم می‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 870.6,
   "end": 874.07,
   "text": "نحن ایام الله. ما روزهای الهی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 874.07,
   "end": 877.0,
   "text": "اون يوم گفتیم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 877.0,
   "end": 881.44,
   "text": "ظرف ظهوره. يوم یعنی ظرف ظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 881.44,
   "end": 887.46,
   "text": "يوم الله یعنی ظرف ظهور الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 887.46,
   "end": 889.44,
   "text": "الان دهه فجره. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 889.44,
   "end": 893.56,
   "text": "دیروز از تهمون تشریف آوردن به نسبت به اقای تاریخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 893.56,
   "end": 896.14,
   "text": "امام در خصوص انقلاب فرمودن انفجار نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 896.14,
   "end": 898.32,
   "text": "این ایام رو فرمودن ایام الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 898.32,
   "end": 900.14,
   "text": "بیست و دو بهمن يوم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 900.14,
   "end": 902.36,
   "text": "یعنی چی؟ همون که از کنارش رد میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 902.36,
   "end": 904.78,
   "text": "ولی رو-- روز خوبیه. روز نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 904.78,
   "end": 906.8,
   "text": "روز پربرکت. اینطوری نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 906.8,
   "end": 911.46,
   "text": "اینا فلسفه خوندن، حکمت خوندن، عارف بودن، کامل بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 911.46,
   "end": 914.12,
   "text": "یعنی الله تو اون روز ظهور کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 914.12,
   "end": 920.54,
   "text": "اون روز ظرفیت اینو پیدا کرده بوده بشه ظرف ظهور اسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 920.54,
   "end": 923.02,
   "text": "بلکه اسم نه، حقیقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 923.02,
   "end": 925.68,
   "text": "یعنی البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 925.68,
   "end": 929.36,
   "text": "اسم متعارفو میگیم و الا درستش بله همون اسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 929.36,
   "end": 931.38,
   "text": "اون کمال ذاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 931.38,
   "end": 936.14,
   "text": "حضرت حق که همش جمع شده تو الله، اسم جامع و به اون میگن اسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 936.14,
   "end": 941.22,
   "text": "اون حقیقت. که اون وقتی ظهور کرده شده این اشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 941.22,
   "end": 944.02,
   "text": "لذا همه این کائنات میشن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 944.02,
   "end": 947.9,
   "text": "همه میشن اسم الاسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 947.9,
   "end": 951.38,
   "text": "بعد یه لفظی رو این قرار گرفته که تو بخونیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 951.38,
   "end": 957.96,
   "text": "رو اون کمال ذاتی حق که اصل اسم اون بود ظهور کرد شد این اشیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 957.96,
   "end": 963.8,
   "text": "و این شد اسم الاسم. یه لفظی گذاشته شده مطابق با اون البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 963.8,
   "end": 969.18,
   "text": "باز ربط هست بین اسم و اسم الاسم و اسم اسم الاسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 969.18,
   "end": 973.91,
   "text": "اسم اون لفظی که گذاشتن روش بهش میگن اسم اسم الاسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 973.91,
   "end": 978.4,
   "text": "یعنی الله. حالا رد شید ازش اذیت نکنید خودتونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 978.4,
   "end": 981.82,
   "text": "رد شید ازش فعلا بحثمون چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 981.82,
   "end": 986.68,
   "text": "خب، الان به کجا رسیدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 986.68,
   "end": 990.92,
   "text": "که امام حسین صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 990.92,
   "end": 993.1,
   "text": "فردا به دنیا اومدن یا امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 993.1,
   "end": 1000.48,
   "text": "تشریف فرما شدن پیداست که این ساعت و این روز خیلی روز پرظهوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1000.48,
   "end": 1005.46,
   "text": "قدرتمندیه. سعه داره و الا انسان کامل اون موقع نمی‌تونه به دنیا بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1005.46,
   "end": 1011.86,
   "text": "حضرت فلسفی. اینکه يوم الله یعنی رو ظرف ظهور الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1011.86,
   "end": 1014.16,
   "text": "نه یک اسم، نه دو اسم، نه سه اسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1014.16,
   "end": 1018.58,
   "text": "این ارتباطات ایام، ساعات، آنات، اشیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1018.58,
   "end": 1023.64,
   "text": "در اح إنشاء روح بخاری چی گفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1023.64,
   "end": 1032.6,
   "text": "بله. إنشاء روح بخاری، ارتباطات و از اون آباء سبعه بگیر تا امهات اربعه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1032.6,
   "end": 1035.4,
   "text": "اولاد ثلاسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1035.4,
   "end": 1038.4,
   "text": "چنانچه خاطرتون باشه. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1038.4,
   "end": 1045.06,
   "text": "از عناصر اربعه، اخلاط اربعه، روح اون کف و اون بخار و روح بخاری و این سلسله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1045.06,
   "end": 1047.8,
   "text": "اطوار. حالا بذارید فردا بگیم. یه یادآوری بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1047.8,
   "end": 1049.4,
   "text": "الان وقتمون دیگه واقعا گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1049.4,
   "end": 1052.0,
   "text": "بچه‌ها هم ساعت رو نشون میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1052.0,
   "end": 1054.72,
   "text": "این ربط بین اینا رو دقت کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1054.72,
   "end": 1056.42,
   "text": "اصلا هیچ چیز اصلا گسیخته نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1056.42,
   "end": 1059.98,
   "text": "پس خیلی مهمه که ما چی بخوریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1059.98,
   "end": 1063.5,
   "text": "چه ساعتی بخوریم، چیو با چی بخوریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1063.5,
   "end": 1069.96,
   "text": "چیو با چی نخوریم، چه ساعتی اصلا نخوریم، چه ساعتی بخوابیم، چه ساعتی نخوابیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1069.96,
   "end": 1072.56,
   "text": "چی بپوشیم، کجا بشینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1072.56,
   "end": 1076.12,
   "text": "بسترمون چی باشه، روپوشمون چی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1076.12,
   "end": 1082.6,
   "text": "اینا خیلی مهمن. مثلا مصافحه رو دقت کردید چرا دو تا مؤمن با هم مصافحه دست میدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1082.6,
   "end": 1084.42,
   "text": "چرا به کافر نباید دست بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1084.42,
   "end": 1088.22,
   "text": "مگه تو اون چیه؟ مگه هر دو دست پوست ندارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1088.22,
   "end": 1091.04,
   "text": "گوشت و-- همین-- جنسش یکیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1091.04,
   "end": 1093.46,
   "text": "اما چرا به اون دست میدی به این نمیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1093.46,
   "end": 1097.28,
   "text": "چرا مصافحه؟ چی تو-- توی ارتباطات چی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1097.28,
   "end": 1101.18,
   "text": "تو خوردن این خوردنی‌جات چی هست که میگه اینو بخور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1101.18,
   "end": 1105.78,
   "text": "اونو نخور. این ارتباطات خیلی عجیبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1105.78,
   "end": 1108.98,
   "text": "حالا انشاالله این بحثو فردا ادامه میدیم در ربط وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1108.98,
   "end": 1111.7,
   "text": "ربط وجودی هر شخصی به ساعت و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1111.7,
   "end": 1118.94,
   "text": "حتی اون شخصی که اون لحظه‌ای که معاویه علیه اللعنة والعذاب الألیم از دنیا رفته یه ربطی بین او و اون روز و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1118.94,
   "end": 1121.3,
   "text": "ساعت و اون لحظه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1121.3,
   "end": 1124.9,
   "text": "اینا رو حالا ب-بعد یه سوالاتی ایجاد میشه با هم انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1124.9,
   "end": 1127.88,
   "text": "دربارش صحبت می‌کنیم. والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1127.88,
   "end": 1129.72,
   "text": "صلوات بفرستیم. الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}