 ],
 "cues": [
  {
   "i": 0,
   "start": 0.9,
   "end": 4.62,
   "text": "بسم الله الرحمن الرحیم و به او نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.62,
   "end": 11.04,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.04,
   "end": 14.96,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.96,
   "end": 17.0,
   "text": "در رابطه با بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.0,
   "end": 20.88,
   "text": "روح بخاری و این تغییرات فلسفی حضرت عمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.88,
   "end": 25.98,
   "text": "دیروز ما مطالبی رو عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.98,
   "end": 30.32,
   "text": "خیلی به درد بخور بود از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.32,
   "end": 34.62,
   "text": "ربط همه‌ی جنا-- جوانب عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.62,
   "end": 38.36,
   "text": "و اطراف عالم به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.36,
   "end": 46.36,
   "text": "هیچ چیزی بی‌ربط و بی‌ارتباط و گسیخته و گسسته نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.36,
   "end": 56.2,
   "text": "و جدایی از حقیقت عالم و بی‌ربط با اجزاء دیگر عالم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.2,
   "end": 64.54,
   "text": "از این حیث این رو ثابت کردیم که به همین جهت انبیا میگن اینو بخور، اونو نخور چون اینا بی‌ربط نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 64.54,
   "end": 67.12,
   "text": "یعنی غذا می‌تونه، یه غذا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.12,
   "end": 70.2,
   "text": "یه آب، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 70.2,
   "end": 75.76,
   "text": "نان می‌تونه ما رو به سمت جهنم ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 75.76,
   "end": 79.72,
   "text": "می‌تونه ما رو به سمت بهشت ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.72,
   "end": 82.06,
   "text": "همین اطعمه و اشربه می‌تونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.06,
   "end": 85.34,
   "text": "ما رو جهنمی کنن، می‌تونن ما رو بهشتی کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.34,
   "end": 93.96,
   "text": "و نکته خیلی قابل تعملی که امروز می‌خوایم بهش بپردازیم اینه که خب این غذا رو که ما می‌خوریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.96,
   "end": 97.62,
   "text": "این اطعمه و اشربه رو که می‌خوریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.62,
   "end": 106.76,
   "text": "ما گمان می‌کنیم که میره میشه گوشت و قدیم‌ها می‌گفتن گوشت بشه بچسبه به رونت مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.76,
   "end": 109.3,
   "text": "حالا به واقع اینطوریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.3,
   "end": 114.74,
   "text": "این چیزی که ما می‌خوریم فقط میشه گوشت و پوست و خون و مثلا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 114.74,
   "end": 117.5,
   "text": "مادیات و ظواهر میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 117.5,
   "end": 120.54,
   "text": "این میشه؟ [پاسخ گوینده ۲] .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.54,
   "end": 126.54,
   "text": "خب اینو اولا حتی اگر هم همین فقط باشه و لاغیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.54,
   "end": 132.74,
   "text": "ما گفتیم که ما یک وجود واحدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 132.74,
   "end": 139.44,
   "text": "و بدن، بدن و نفس دو طور از این وجود واحدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 139.44,
   "end": 145.08,
   "text": "ظاهر و باطن‌مان. هرچی که هستن متعلق به مان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 145.08,
   "end": 149.82,
   "text": "از طرفی عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 149.82,
   "end": 154.24,
   "text": "خود بدن مرتبه نازله نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 154.24,
   "end": 159.48,
   "text": "الان چشم ما یه چشم مستقل از نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 159.48,
   "end": 163.22,
   "text": "یا خود مرتبه نازله نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 163.22,
   "end": 167.3,
   "text": "ان النفس-- النفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 167.3,
   "end": 170.7,
   "text": "في وحدته كل القوى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 170.7,
   "end": 174.22,
   "text": "حکما فرمودن که نفس در عین حال که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 174.22,
   "end": 178.1,
   "text": "في وحدته، در عین حال که یک وجود واحده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 178.1,
   "end": 182.0,
   "text": "توحید وحدت داره این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 182.0,
   "end": 185.66,
   "text": "كل القوى، همه قوای وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 185.66,
   "end": 191.56,
   "text": "آدم، انسان، اینا همه در حقیقت این اطوار، قوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 191.56,
   "end": 194.72,
   "text": "شؤون، ازلال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 194.72,
   "end": 196.66,
   "text": "اینا تجلیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 196.66,
   "end": 203.2,
   "text": "نفسن. یعنی عرض کردیم دیگه قبلاً این چشم ما حالا مثلاً اون آبی که خوردیم بره بشه چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 203.2,
   "end": 208.68,
   "text": "آیا چشم جدایی از نفسه یا شأنی از شؤون نفسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.68,
   "end": 216.62,
   "text": "چشم یکی از شؤون نفسه که اگر چنانچه نفس رو از او بگیری دیگه جایی رو نمی‌تونه ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 216.62,
   "end": 220.04,
   "text": "مثالش مثل کی؟ مثل این که خوابه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 220.04,
   "end": 223.38,
   "text": "نه. اون خوابه چشم‌هاشو بسته ولی باز می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 223.38,
   "end": 225.32,
   "text": "چرا؟ مگه چشمشو نبسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 225.32,
   "end": 229.22,
   "text": "چرا باز تو خواب می‌بینه؟ چون نفس داره می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 229.22,
   "end": 234.16,
   "text": "درست شد؟ قوه باصره یک شأن از شؤون نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 234.16,
   "end": 239.54,
   "text": "ولی وقتی مرد چی؟ اعلام انصراف داد نفس از بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 239.54,
   "end": 243.82,
   "text": "یعنی تعطیل شدن این قوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 243.82,
   "end": 246.4,
   "text": "دیگه شأن او حساب نشدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 246.4,
   "end": 249.38,
   "text": "توجهش رو نفس از این چشم برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 249.38,
   "end": 251.74,
   "text": "یعنی مثلاً دیگه موت حاصل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 251.74,
   "end": 254.32,
   "text": "موت اجباری یا اضطراری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 254.32,
   "end": 257.04,
   "text": "دیگه این چشم نمی‌بینه. این چشم نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 257.04,
   "end": 261.54,
   "text": "نفس هنوز می‌بینه در برزخ با اون چشم برزخیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 261.54,
   "end": 263.68,
   "text": "اما این چشم دیگه نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 263.68,
   "end": 268.6,
   "text": "پس این رو می‌خوایم ثابت کنیم که هرچه هست برگشت می‌کنه به نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 268.6,
   "end": 270.94,
   "text": "درست شد؟ اینا با هم مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.94,
   "end": 273.06,
   "text": "باز تو خود انسان هم همین اصل هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.06,
   "end": 284.06,
   "text": "اصلی که دیروز گفتیم. هیچ جزئی از اجزاء کل عالم و هیچ جزئی اج-- از اجزاء خود پیکره وجود ما، مملکت وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 284.06,
   "end": 288.38,
   "text": "گسیخته و جدایی از هم و بی‌ربط با هم نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 288.38,
   "end": 292.24,
   "text": "نکته بعدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.24,
   "end": 297.18,
   "text": "بالاتر از این رو، بالاتر از این رو شیخ الرئیس می‌فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 297.18,
   "end": 301.08,
   "text": "می‌فرمود که قبلاً هم چندین بار گفتیم که خدای کیمیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 301.08,
   "end": 306.74,
   "text": "ما دنبال کیمیا می‌گردیم در صورت که خدای کیمیایی در وجود ما قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 306.74,
   "end": 310.22,
   "text": "که میته می‌خوریم. حالا یه، یک بار بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 310.22,
   "end": 314.28,
   "text": "عرفانی کردیم که همه چی حیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 314.28,
   "end": 319.9,
   "text": "این فلان اینو کاری نداریم که اون چیزی هم که می‌خوریم از حیث معنوی حیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 319.9,
   "end": 321.44,
   "text": "زنده است. اونو کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 321.44,
   "end": 329.26,
   "text": "ولی از جهت ظاهری و مادی و در نشئ طبیعت این حیوان رو که داره می‌خوری ذبح شده‌ست، میته‌ست، مرده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 329.26,
   "end": 331.92,
   "text": "غ-- گیاه رو کندی از زمین دیگه مرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 331.92,
   "end": 334.56,
   "text": "از جهت دنیویش عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 334.56,
   "end": 336.76,
   "text": "در سطح ظاهر ما میته خواری‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 336.76,
   "end": 340.2,
   "text": "شیخ الرئیس میگه شما دارین مرده خواری می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 340.2,
   "end": 343.34,
   "text": "اما اینا میره تو وجود خودت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 343.34,
   "end": 350.04,
   "text": "میشه تو. آن نان و آب مرده وقتی رفت در وجود تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 350.04,
   "end": 352.92,
   "text": "حیات پیدا می‌کنه، زنده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 352.92,
   "end": 359.58,
   "text": "اون مرده زنده میشه. این مرده‌ای که خوردی چگونه زنده شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 359.58,
   "end": 362.42,
   "text": "به انشای حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 362.42,
   "end": 370.48,
   "text": "و به توجه نفس سلسله طولی هم که الا ماشاالله بینشون وسایل فیض الهی هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 370.48,
   "end": 377.96,
   "text": "این زنده شد. یعنی اون آب و نان مرده رو که خوردی، اون گیاه و گوشت مرده رو که خوردی تو وجود خودت زنده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 377.96,
   "end": 380.7,
   "text": "این چیز کمی نیست. چرا توجه نمی‌کنیم به این؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 380.7,
   "end": 384.94,
   "text": "یعنی این شیمی‌ها تو وجود ما هست که می‌تونیم مرده رو زنده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 384.94,
   "end": 389.38,
   "text": "چرا هی میگی اه حضرت عیسی مرده زنده می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 389.38,
   "end": 391.5,
   "text": "بله حضرت عیسی مرده زنده می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 391.5,
   "end": 395.52,
   "text": "شما هم آنفان داری مرده زنده می‌کنی در وجود خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 395.52,
   "end": 397.58,
   "text": "هر چیزی که می‌خوری داری زنده ش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 397.58,
   "end": 402.5,
   "text": "میشه شما، شما مرده‌ای جسداً یا حیات داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 402.5,
   "end": 406.36,
   "text": "ببین توجه کردی؟ پس اینطوری اگه به قصه نگاه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 406.36,
   "end": 413.46,
   "text": "که یه طور بالاتر از اون حرف قبلیه که دیگه خیلی قصه حساس‌تر میشه و مهم‌تر میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 413.46,
   "end": 418.5,
   "text": "که پس ما همونی هستیم که می‌خوریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 418.5,
   "end": 422.42,
   "text": "درسته؟ چرا ما قبلاً تو مسجد بلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 422.42,
   "end": 427.08,
   "text": "یه سری بحث داشتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 427.08,
   "end": 434.62,
   "text": "چرا انقدر دستور هست که با این آداب غذا رو مثلاً غذا خوردن حداقل یادمه هجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 434.62,
   "end": 439.36,
   "text": "ادب داره. هجده ادب بر سر سفره نشستن و خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 439.36,
   "end": 442.36,
   "text": "حالا اصطلاحاً میگیم مستحبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 442.36,
   "end": 445.94,
   "text": "برای چی؟ چرا باید بسم الله گفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 445.94,
   "end": 452.9,
   "text": "چرا مثلاً آب، چون آب، آب رو سوره قدر رو فرمودن بهش بخ-بخوانید، بدمید، بخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 452.9,
   "end": 455.0,
   "text": "نور بصر رو زیاد می‌کنه. برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 455.0,
   "end": 458.44,
   "text": "چه ربطی داره سوره قدر تو این آب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 458.44,
   "end": 462.2,
   "text": "و اگر حالا اون آب بشه مثلاً جز بدن من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 462.2,
   "end": 464.94,
   "text": "اون سوره قدر چی کاره است؟ چه ربطی به چشم داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 464.94,
   "end": 468.06,
   "text": "ببین اینا رو ارتباطاتی که تو عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 468.06,
   "end": 471.76,
   "text": "مهم اینه اینو ما بفهمیم که اون آبه، اون نونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 471.76,
   "end": 476.04,
   "text": "میشه من. و اگر بدون ذکر، بدون وضو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 476.04,
   "end": 482.48,
   "text": "بدون طهارت غذا بخوری، بدون ذکر غذا بخوری چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 482.48,
   "end": 484.8,
   "text": "یعنی تو داری خودت رو با یک چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 484.8,
   "end": 487.76,
   "text": "دور از خدا پرورش میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 487.76,
   "end": 494.7,
   "text": "چون اون دوره. تو خودت که وضو نداری داری می‌خوری هر چقدر هم پاک بخوری از خدا دوره اون خوردنی‌هات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 494.7,
   "end": 498.52,
   "text": "خوردن‌ها و تو رو از خدا دور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 498.52,
   "end": 501.66,
   "text": "و اگر بدون ذکر هم بخوری همچنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 501.66,
   "end": 505.02,
   "text": "حالا این خودش یه بحثه. بماند به وقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 505.02,
   "end": 507.38,
   "text": "تو اون فعلاً نمی‌خوایم ورود کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 507.38,
   "end": 515.28,
   "text": "پس این رو حواسمون جمع باشه که الان متوجه شدیم که عجب اصلاً ما همونی هستیم که می‌خوریم و می‌آشامیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 515.28,
   "end": 520.32,
   "text": "پس الان متوجه میشیم که تقریرات حضرت امام، حضرت فلسفی ذیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 520.32,
   "end": 524.24,
   "text": "معرفت نفس چقدر اهمیت داره که اینجا فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 524.24,
   "end": 527.9,
   "text": "هدف از انبیا از اینکه اینو بخور اونو نخور چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 527.9,
   "end": 533.1,
   "text": "صیقل دادن وجود و اون ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 533.1,
   "end": 541.56,
   "text": "الهی انسانی رو یادتون باشه، اون رو صیغل بدن به سمت نور گسیل بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 541.56,
   "end": 544.56,
   "text": "با خوردنی و آشامیدنی بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 544.56,
   "end": 546.9,
   "text": "بله خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 546.9,
   "end": 549.2,
   "text": "چیزهایی رو می‌خوره که نباید بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 549.2,
   "end": 552.26,
   "text": "مرکب می‌خوره، بسطی نمیخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 552.26,
   "end": 556.94,
   "text": "ممنوع، اون چیزایی که ممنوع شده یا حتی علیه خدا اینا که حرمت داره می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 556.94,
   "end": 560.32,
   "text": "همینطور در هم می‌خوره. بعد میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 560.32,
   "end": 562.5,
   "text": "نمی‌فهمم این آخوندها چی میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 562.5,
   "end": 567.4,
   "text": "قرآن چیه؟ اینا معرکه گیری راه انداختن از خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 567.4,
   "end": 571.92,
   "text": "توجه کردی چی شد؟ چون حرام خوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 571.92,
   "end": 576.66,
   "text": "لذا بین تو و این حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 576.66,
   "end": 579.56,
   "text": "بعدی ایجاد شده. یعنی اونها به تو حرامن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 579.56,
   "end": 585.0,
   "text": "این حقایق به تو حرامن. اصلاً تو با-- بخوری هم بالا میاری اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 585.0,
   "end": 587.66,
   "text": "شاید یه چند صباحی بیای تو وادی دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 587.66,
   "end": 592.86,
   "text": "اما از اون طرف ببره میره دیگه تا ته خلافشم میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 592.86,
   "end": 598.26,
   "text": "حالا یکی از نکات جالبی که توی این قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 598.26,
   "end": 605.3,
   "text": "خیلی جالبه که بدونیم شیخ الرئیس کتاب قانونش داره و علامه علیه، علیه الرحمه بر رضوان در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 605.3,
   "end": 609.78,
   "text": "نکته بیست و یک آورده تو هزار و یک نکته‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 609.78,
   "end": 616.96,
   "text": "اینه که باز خدای ممنان کاری که انجام میده تقسیم بندی مثل اینکه شما یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 616.96,
   "end": 621.46,
   "text": "چیز رو تهیه می‌کنی، غذایی رو می‌گیری میاری خونه نسبت به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 621.46,
   "end": 625.6,
   "text": "اِاِاِ نیاز بچه ها بهشون رسیدگی می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 625.6,
   "end": 631.96,
   "text": "شما مثلاً اگر بچه شیرخوار داشته باشی تو خونه چلو کباب نمیذاری تو دهنش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 631.96,
   "end": 635.22,
   "text": "نسبت به اون نیاز شیر رو دهانش میذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 635.22,
   "end": 639.78,
   "text": "مثلاً نزدیک یک سالش شد شروع می‌کنی مخلوطی از آب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 639.78,
   "end": 642.64,
   "text": "مثلاً جماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 642.64,
   "end": 649.22,
   "text": "قاطی می‌کنی با هم بهش میدی. اِاِاِ همینطوری هی میره بالا نیازاش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 649.22,
   "end": 656.76,
   "text": "نسبت به نیاز طرف. امکان داره یه جوون رشید داشته باشی تو خونه به سن بلوغ رسیده و خیلی ورزش می‌کنه دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 656.76,
   "end": 660.0,
   "text": "پرس غذا بذاری جلوش، یه دیس بذاری جلوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 660.0,
   "end": 662.16,
   "text": "اما خودت دو تا قاشق بخوری سیر بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 662.16,
   "end": 665.96,
   "text": "این نیاز هاته. این، این نیازها رو همونطوری که شما عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 665.96,
   "end": 673.0,
   "text": "وجود شما این رو تشخیص میده و شما داری نیازسنجی می‌کنی و براساس اون تخصص می‌کنی روزی رو تو خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 673.0,
   "end": 676.72,
   "text": "به کی چه-- چی بدی و به چه دردش می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 676.72,
   "end": 680.16,
   "text": "همینطور خدای ممنان تو وجود ما هم این کارو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 680.16,
   "end": 684.9,
   "text": "ما که می‌خوریم از طریق نفس ناطقه‌مون وقتی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 684.9,
   "end": 688.82,
   "text": "خوردنی‌ها می‌خواد تخش-- تخس بشه تو بدن، یعنی رزقه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 688.82,
   "end": 690.8,
   "text": "این رزقه داری می‌خوری تخس بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 690.8,
   "end": 693.96,
   "text": "آقا این مال دست، این مال چشم، این مال پا، این مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 693.96,
   "end": 700.44,
   "text": "کمر، این مال روده، این مال قلب، این مال شش، این مال کبد، این مال مغز، این مال نخاع، این مال اعصاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 700.44,
   "end": 706.08,
   "text": "همینطور همش رو حسابه. یعنی من و شما فکر می‌کنم همینطوری خوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 706.08,
   "end": 711.26,
   "text": "درست شد؟ خوردیم و بعد در نهایت هم شد مثلاً روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 711.26,
   "end": 715.02,
   "text": "اما این روح بخاری نسبت به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 715.02,
   "end": 719.28,
   "text": "در اولاً تو کجاها متمرکز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 719.28,
   "end": 721.44,
   "text": "تو مغز و کبد و قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 721.44,
   "end": 726.32,
   "text": "اینا همش حساب شده‌ست. از طریق اونها به کجاها گسیل داده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 726.32,
   "end": 729.28,
   "text": "باز حساب شده‌ست. چه میزان بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 729.28,
   "end": 732.02,
   "text": "مثلاً ما قبلاً گفتیم خواب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 732.02,
   "end": 735.6,
   "text": "جمع شدن تجمع روح بخاری تو مغزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 735.6,
   "end": 738.0,
   "text": "از اون اعصاب همه جمع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 738.0,
   "end": 741.44,
   "text": "اصلا جمع میشه میاد تو مغز خوابت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 741.44,
   "end": 745.42,
   "text": "روح بخاری جمع میشه از اعضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 745.42,
   "end": 752.44,
   "text": "حالا اگر روح بخاری از مغز و از کبد و از قلب خارج شد چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 752.44,
   "end": 757.62,
   "text": "مرگ. آفرین. دیگه چرا نفس نمی‌تونه ارتباط با بدن بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 757.62,
   "end": 759.48,
   "text": "درست شد؟ به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 759.48,
   "end": 765.4,
   "text": "پس حتی اینکه روح بخاری تو کدوم قسمت از بدن باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 765.4,
   "end": 769.72,
   "text": "چه به نحو تجمع، چه به نحو انتشار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 769.72,
   "end": 773.3,
   "text": "یک. دو، اینکه چه میزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 773.3,
   "end": 776.94,
   "text": "اونجا تجمع کنه یا منتشر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 776.94,
   "end": 781.1,
   "text": "سه، چه زمانی این روح بخاری اونجا تردد داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 781.1,
   "end": 783.58,
   "text": "چون موندنی نیست که. هی جمع میشه دوباره پس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 783.58,
   "end": 785.76,
   "text": "هی توسط کبد تولید میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 785.76,
   "end": 790.06,
   "text": "این هم به انشای نفس به عنایت الهی صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 790.06,
   "end": 792.8,
   "text": "این نفس شهی که نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 792.8,
   "end": 795.08,
   "text": "اصلا نفس نیاز به خواب نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 795.08,
   "end": 797.16,
   "text": "نفس خسته نمیشه که مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 797.16,
   "end": 798.86,
   "text": "بدن خسته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 798.86,
   "end": 800.94,
   "text": "هرچی هست تو اون جلسه گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 800.94,
   "end": 805.2,
   "text": "هرچی هست سر این بدنه. این بدن به نفس غر می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 805.2,
   "end": 807.62,
   "text": "خسته‌م، گشنمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 807.62,
   "end": 811.09,
   "text": "خوابم میاد، لم بدم، بذار من لم بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 811.09,
   "end": 814.16,
   "text": "نفس می‌خوابونه بدن رو. بدن که از خودش اراده‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 814.16,
   "end": 816.38,
   "text": "همش زیر دهن-- سر نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 816.38,
   "end": 821.3,
   "text": "اما کارها، اما خواستگاه بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 821.3,
   "end": 823.4,
   "text": "بدن نیاز داره بخوابه. نفس که نمی‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 823.4,
   "end": 826.1,
   "text": "اگر کسی قدرت نفس پیدا کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 826.1,
   "end": 835.82,
   "text": "تونست مثل حضرت موسی به جایگاهی برسه که استیلای بر بدنش پیدا کنه، نفسش انقدر قوی بشه که حاکم بر بدنش بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 835.82,
   "end": 837.74,
   "text": "دیگه بدن حتی می‌تونه اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 837.74,
   "end": 844.74,
   "text": "نخوابه، اصلا نخوره. چهل شبانه روز تو کوه طور مناجات کنه، نخوابه و نخوره زنده هم بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 844.74,
   "end": 848.54,
   "text": "هیچ اتفاقی نمیفته. این، این هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 848.54,
   "end": 854.68,
   "text": "این امکانش هست، وجود داره و یکی از مثل این موبایل که امکاناتی درشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 854.68,
   "end": 862.08,
   "text": "اپلیکیشن‌هایی درش طراحی شده، خدا اینا رو تو وجود ما قرار داده، ما بهش دسترسی نداریم، خبر نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 862.08,
   "end": 869.02,
   "text": "یکی از اون موارد خیلی شیرینی که اینو بگم و دیگه بحث رو تموم کنم از تعلیمه اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 869.02,
   "end": 870.86,
   "text": "از رو براتون بخونم چقدر شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 870.86,
   "end": 875.72,
   "text": "حکمت الهی رو ببینید. روح محرکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 875.72,
   "end": 882.0,
   "text": "در پای قوی‌تر است و روح حساسه در دست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 882.0,
   "end": 884.32,
   "text": "میگه ما یه روح محرکه داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 884.32,
   "end": 888.42,
   "text": "یه روح حساسه. روح محرکه تو رو به حرکت وامی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 888.42,
   "end": 891.84,
   "text": "باید حرکت کنی، راه بری، تلاش کنی، بدوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 891.84,
   "end": 894.84,
   "text": "اون تو کجا بیشتره؟ توی پا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 894.84,
   "end": 901.98,
   "text": "روح حساسه که این دست می‌خواد باید حساس باشه، به همه چی می‌خواد برخورد کنه، با همه چیو لمس کنه، برداشت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 901.98,
   "end": 906.0,
   "text": "بذاره، نمی‌دونم حس کنه این داغه، گرمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 906.0,
   "end": 910.28,
   "text": "خوبه، بده. روح حساسه تو دست قویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 910.28,
   "end": 918.02,
   "text": "اون تکس رزق رو نفس به انشای نفس خدای منان داره عنایت می‌کنه به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 918.02,
   "end": 919.84,
   "text": "حالا ادامه این بحث تعلیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 919.84,
   "end": 922.02,
   "text": "چون دست، چرا؟ چرا اینطوریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 922.02,
   "end": 924.56,
   "text": "چرا تو دست روح حساسه بیشتره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 924.56,
   "end": 928.06,
   "text": "چون دست به حس محتاج‌تر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 928.06,
   "end": 931.44,
   "text": "پا خیلی نیاز به حس نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 931.44,
   "end": 936.42,
   "text": "و پای به حرکت. پای نیاز به حرکت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 936.42,
   "end": 940.42,
   "text": "لذا روح محرکه توش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 940.42,
   "end": 947.42,
   "text": "خ- و خداوند اعصاب حس را از اعصاب حرکت جدا خلق کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 947.42,
   "end": 950.8,
   "text": "جلّت قدرته و عظمت حکمتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 950.8,
   "end": 953.32,
   "text": "یعنی این اعصابی هم که از اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 953.32,
   "end": 955.54,
   "text": "میرن تا مغز، این‌ها رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 955.54,
   "end": 963.26,
   "text": "جدا خ-- انشا کرده، ایجاد کرده در بدن که اون روحی که به اینا تعلق می‌گیره متفاوت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 963.26,
   "end": 969.18,
   "text": "خیلی عجیبه. حالا اینجا حضرت علامه می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 969.18,
   "end": 975.1,
   "text": "دقت کنید تو قان-- کتاب قانون که من اینجا دارمش خواستید کتاب اینجا هست، کتاب قانون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 975.1,
   "end": 981.82,
   "text": "شیخ الرئیس اینجا می‌فرماید گاه باشد که لرزه در دست افتد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 981.82,
   "end": 989.82,
   "text": "یادتونه اون اوایل شروع بحث روح بخاری که اون موقع تو نمازخونه شروع کردیم در ارتباط با رعشه چند تا دلیل آوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 989.82,
   "end": 991.84,
   "text": "لرزه ای که می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 991.84,
   "end": 995.14,
   "text": "گاه باشد که لرزه در دست افتد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 995.14,
   "end": 997.6,
   "text": "نه در پای‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 997.6,
   "end": 1008.02,
   "text": "چرا اینطوری میشه؟ شیخ الرئیس میگه برای آنکه روح محرکه در پای بیشتر از دست است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1008.02,
   "end": 1016.36,
   "text": "چون پای‌ها به حرکت و روح مت-- محتاج‌ترند و چون روح محرکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1016.36,
   "end": 1021.04,
   "text": "محرکه در پای قوی‌تر است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1021.04,
   "end": 1029.44,
   "text": "از عوارض و اسباب غریبه که چندان قوی نباشد متأثر نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1029.44,
   "end": 1032.48,
   "text": "یعنی اون دلیلی که باعث شد دست بلرزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1032.48,
   "end": 1037.44,
   "text": "اون زورش به پا نه-- به روح پا نمی‌رسه که پا رو بلرزونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1037.44,
   "end": 1040.86,
   "text": "چون روح محرکه‌ش اونجا قوی‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1040.86,
   "end": 1043.68,
   "text": "بعد ادامه میده شیخ الرئیس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1043.68,
   "end": 1048.78,
   "text": "و روح و روح قوی بر آن زود غالب می‌گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1048.78,
   "end": 1050.76,
   "text": "روح قوی تو کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1050.76,
   "end": 1053.0,
   "text": "نسبت بین دست و پا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1053.0,
   "end": 1057.04,
   "text": "توی پا. لذا پا خیلی به ندرت میشه بلرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1057.04,
   "end": 1060.62,
   "text": "حتی آدم بل-- بترسه از چیزی دستش شروع می‌کنه به لرزیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1060.62,
   "end": 1067.22,
   "text": "تا پاش. مگر خیلی دیگه پاش ضعف داشته باشه یا نفسش ضعیف باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1067.22,
   "end": 1069.0,
   "text": "و اثر آن را نابود می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1069.0,
   "end": 1072.28,
   "text": "اما دست چنین نیست. میگه دست وقتی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1072.28,
   "end": 1076.34,
   "text": "عارضه‌ای از بیرون مثل مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1076.34,
   "end": 1079.06,
   "text": "ضربه‌ای مثل ت-- مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1079.06,
   "end": 1082.88,
   "text": "خبر روباوری، ترسی، چیزی عارض شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1082.88,
   "end": 1086.24,
   "text": "دست شروع می‌کنه به لرزیدن. چون قدرت مقاومت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1086.24,
   "end": 1091.16,
   "text": "نیروی اون روح محرکه، محرکه توش قوی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1091.16,
   "end": 1094.38,
   "text": "روح حساسه توش قویه. حساسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1094.38,
   "end": 1097.34,
   "text": "اسمش رو خودشه. تا ضربه خورد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1097.34,
   "end": 1102.68,
   "text": "تا سردش شد، تا خبر بدی بهش رسید، تا از چیزی ترسید دست شروع می‌کنه به لرزیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1102.68,
   "end": 1105.44,
   "text": "چون روح حساسه توش قویه دیگه. حساسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1105.44,
   "end": 1109.5,
   "text": "اما پا نه. پا چون روح ح-- محرکه توش حساسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1109.5,
   "end": 1112.66,
   "text": "هرچی بترسه اون طرفو، هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1112.66,
   "end": 1114.64,
   "text": "بندازش تو سرما، چی، چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1114.64,
   "end": 1118.7,
   "text": "نه. خیلی پا می‌دونی کم پیش میاد که پای کسی به رعشه بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1118.7,
   "end": 1122.52,
   "text": "تا حالا دیدی کسی پاش به رع-- رعشه بیفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1122.52,
   "end": 1125.2,
   "text": "رعشه به پای کسی تا حالا دیدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1125.2,
   "end": 1128.96,
   "text": "اگه باشه خیلی به ندرت. الحمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1128.96,
   "end": 1133.2,
   "text": "تو پیشون دیدی؟ والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1133.2,
   "end": 1136.86,
   "text": "صلوات بفرستید. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}