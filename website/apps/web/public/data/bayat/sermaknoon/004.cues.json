 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 4.32,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.32,
   "end": 9.78,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.78,
   "end": 11.69,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.69,
   "end": 20.34,
   "text": "السلام علیکم. چنانچه خاطرتون باشه در سیره معرفت نفس رسیدیم به روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.34,
   "end": 23.08,
   "text": "ببینید عزیزان ما چهار نوع هضم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.08,
   "end": 29.96,
   "text": "اولین هضم در دهان با بزاغ اتفاق میفته، بعد در معده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.96,
   "end": 34.74,
   "text": "بعد در کبد. چهارمین هضم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.74,
   "end": 40.4,
   "text": "، که ظاهراً اولین کسی که ازش پرده‌برداری کرد حضرت ارسطو بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.4,
   "end": 42.84,
   "text": "در تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.84,
   "end": 53.36,
   "text": "بافت‌ها و سلول‌های بدن که زبده‌ترین، خلاصه‌ترین و مغذی‌ترین مواد از اون‌ها جمع میشه چکیدش میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.36,
   "end": 59.72,
   "text": "نطفه رو تشکیل میده. لذا چون از تمام بافت‌ها و سلول‌ها رفته بچه شبیه پدر و مادرش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 59.72,
   "end": 66.76,
   "text": "و شاید از این جهت پیغمبر فرمود از سعادت پدر و مادر اینه که بچه شبیه به اون‌ها میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 66.76,
   "end": 71.1,
   "text": "یعنی حلالن. که بماند بحث ما فعلاً این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 71.1,
   "end": 75.6,
   "text": "یکی از مهم‌ترین قسمت‌های هضم در کبده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 75.6,
   "end": 78.67,
   "text": "بحث ما به اینجا کشید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 78.67,
   "end": 84.37,
   "text": "، اون عناصر اربعه وقتی با هم ممزوج میشن و مزاج رو تشکیل میدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 84.37,
   "end": 89.7,
   "text": "، وقتی هضم در کبد صورت می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 89.7,
   "end": 93.18,
   "text": "از این، در حقیقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 93.18,
   "end": 96.88,
   "text": "ااا غذایی که ما خوردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 96.88,
   "end": 100.84,
   "text": "یه خروجی به وجود میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.84,
   "end": 103.28,
   "text": "یعنی در حقیقت دو نوع محصول میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.28,
   "end": 109.02,
   "text": "یکیش بهش میگن غذای کثیف، یکیش غذای لطیف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.02,
   "end": 112.5,
   "text": "کثیف منظور از کثیف میکروبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.5,
   "end": 118.1,
   "text": "از حیث لطافت و غیر لطیف بودن و التف و این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.1,
   "end": 123.72,
   "text": "که اون چهار تا اخلاطي که گفتیم دم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 123.72,
   "end": 126.66,
   "text": "بلغم و سودا و صفرا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.66,
   "end": 134.77,
   "text": "این‌ها به میزانی که با هم ممزوج میشن از حیث اینکه کدومشون غالب میشه بر اون یکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 134.77,
   "end": 141.3,
   "text": "، این‌ها از خودشون یه بخاری رو تولید-- البته، البته اول به صورت یه کفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 141.3,
   "end": 145.86,
   "text": "یعنی از امتزاج اون اخلاط اربعه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 145.86,
   "end": 147.98,
   "text": "، ه-ماحصل چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 147.98,
   "end": 155.98,
   "text": "امتزاج اون عناصر اربعه که از غذا به ما میرسه و در غذا اون هر، هر چهار تا عنصر وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 155.98,
   "end": 161.1,
   "text": "این‌ها غذایی ازش بیرون میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 161.1,
   "end": 168.9,
   "text": "به صورت کفه. این کف میره در دهلیز راست قلب قرار می‌گیره چون در دهلیز راست قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 168.9,
   "end": 173.55,
   "text": "خیلی داغه و دائم قلب داره پمپاژ می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 173.55,
   "end": 175.98,
   "text": "اون کف رو تبدیل به بخار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 175.98,
   "end": 179.28,
   "text": "از این حیث بهش میگن روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 179.28,
   "end": 186.46,
   "text": "و الا جنسش مادیه. منتها چون خیلی لطیفه، التفه، التف اجسام بهش میگن روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 186.46,
   "end": 189.02,
   "text": "این بخار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 189.02,
   "end": 195.66,
   "text": "، از دهلیز راست قلب پمپاژ میشه میره به دو مرتبه در سه بخش قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 195.66,
   "end": 197.74,
   "text": "یکی خود کبده دوباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 197.74,
   "end": 201.2,
   "text": "که از کبد اومده بود اینجا دوباره بر می‌گرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 201.2,
   "end": 212.04,
   "text": "به صورت کف وارد قلب میشه، از سمت راست دو مرتبه بخار میشه، بخشیش میره به کبد، بخشیش میره به مغز، بخشیش میره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 212.04,
   "end": 216.3,
   "text": "قلب. در این سه-- در قسمت چپ این دفعه قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 216.3,
   "end": 220.22,
   "text": "حالا از طریق این‌ها به تمام اعضای بدن سرایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 220.22,
   "end": 225.6,
   "text": "چی؟ این بخار. که از اون چهار تا اخلاط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 225.6,
   "end": 231.92,
   "text": "بر گرفته شده نسبت به اینکه کدومشون غالب شده خصوصیات این بخار فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 231.92,
   "end": 239.54,
   "text": "یعنی اون بخاری که در شما تولید میشه توسط چ-کبد شما، مطمئناً با اون که در بدن من تولید میشه متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 239.54,
   "end": 247.96,
   "text": "لذا خلق و خوی ما، قیافه ما، هوش و استعداد ما، همه چیمون با هم متفاوته که حالا بعداً دربارش صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 247.96,
   "end": 253.22,
   "text": "بعد از طریق مغز به اعصاب و تمام اعضا میره که حرکت کنن اعضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 253.22,
   "end": 259.98,
   "text": "از طریق کبد به روده کوچک و بزرگ و اثنا عشر و این‌ها میره که بتونن غذا رو دو مرتبه هضم کنن، رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 259.98,
   "end": 261.72,
   "text": "چرخه قرار بگیره و از طریق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 261.72,
   "end": 267.46,
   "text": "قلب به عروق و رگ‌ها که به همه بافت‌های بدن خون‌رسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 267.46,
   "end": 270.38,
   "text": "صورت بگیره. خب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 270.38,
   "end": 276.54,
   "text": "وقتی که انسان حرکت می‌کنه، کار می‌کنه، تلاش می‌کنه، این بخاری که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 276.54,
   "end": 280.48,
   "text": "اعضای بدن وجود دارن رفته، رفته تحلیل میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 280.48,
   "end": 284.22,
   "text": "وقتی که اینا تحلیل میرن دقت کنید چه اتفاقی می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 284.22,
   "end": 286.78,
   "text": "یعنی ما تلاش می‌کنیم، حرکت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 286.78,
   "end": 294.08,
   "text": "حالا دلایل دیگه‌ای هم داره که فعلاً ما بحثمون طب نیست که فعلاً می‌خوایم خودمون رو مقدار بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 294.08,
   "end": 297.16,
   "text": "این بخار وقتی تحلیل میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 297.16,
   "end": 303.28,
   "text": "در حقیقت حالت خواب به انسان عارض میشه، خستگی و خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 303.28,
   "end": 307.74,
   "text": "کیه؟ این بخار در اعضای بدن بر اثر تحرکات مختلف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 307.74,
   "end": 312.52,
   "text": "این بخار کم میشه، کم میشه تحلیل میره و خواب به انسان عارض میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 312.52,
   "end": 320.66,
   "text": "دو مرتبه هرچی که این بخار تحلیل میره جمع میشه، اون مقداری که باقی مونده جمع میشن در دوباره اون سه بخش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 320.66,
   "end": 323.9,
   "text": "قلب و کبد و مغز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 323.9,
   "end": 326.1,
   "text": "اینجا دیگه خواب قشنگ حاصل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 326.1,
   "end": 330.1,
   "text": "یعنی دیگه خواب عمیقه. که این‌ها برگشتن به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 330.1,
   "end": 333.54,
   "text": "سه بخش. چرا؟ که سه تا اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 333.54,
   "end": 338.14,
   "text": "یک، اعضای بدن ما استراحت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 338.14,
   "end": 341.66,
   "text": "دو، روح بخاری تقویت بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 341.66,
   "end": 343.74,
   "text": "برای فلان و این فلانات بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 343.74,
   "end": 347.4,
   "text": "سه، که از همه مهم‌تره و ما ازش غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 347.4,
   "end": 351.7,
   "text": "برای اینکه نفس ناطقه با غیب ارتباط بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 351.7,
   "end": 356.06,
   "text": "چرا؟ این قسمت، قسمت سوم چه ربطی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 356.06,
   "end": 360.54,
   "text": "به جهت اینکه ما گفتیم مطیه اولای نفس ناطقه روح بخاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 360.54,
   "end": 365.01,
   "text": "یعنی چی؟ یعنی روح بخاری با گوشت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 365.01,
   "end": 367.33,
   "text": "ببخشید نفس ناطقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 367.33,
   "end": 370.45,
   "text": "یعنی حالا شما بگید اون روح اصلی من نفخت فیه من روحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 370.45,
   "end": 377.25,
   "text": "نفس ناطقه ما مستقیماً با گوشت و پوست و خون و گوشت ما اینها ارتباط نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 377.25,
   "end": 381.39,
   "text": "از طریق روح بخاری ارتباط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 381.39,
   "end": 386.51,
   "text": "یعنی مستقیم از طریق عقل نمی‌تونه با بدن ارتباط بگیره نفس ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 386.51,
   "end": 390.75,
   "text": "باید بیاد پیاده بشه در جایی به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 390.75,
   "end": 397.27,
   "text": "وهم و قوه خیال از قوه خیال ما ارتباط بگیره با روح بخاری که اونجا وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 397.27,
   "end": 401.37,
   "text": "برای همین روح بخاری یه بخشش، یه نیمچه، نیمچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 401.37,
   "end": 403.93,
   "text": "مجرد نیمچه مادیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 403.93,
   "end": 406.11,
   "text": "برای همین بهش میگن روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 406.11,
   "end": 407.95,
   "text": "نفس ناطقه مطلقاً مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 407.95,
   "end": 410.03,
   "text": "نمی‌تونه اصلاً با بدن ارتباط بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 410.03,
   "end": 413.45,
   "text": "از طریق روح بخاری با بدن ارتباط می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 413.45,
   "end": 417.93,
   "text": "وقتی روح بخاری سرکیف اصطلاحاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 417.93,
   "end": 425.57,
   "text": "قشنگ پمپاژ شده پر شده تو اعضای بدن نفس ناطقه قشنگ می‌تونه ارتباط بگیره با بدن و بدن رو حرکت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 425.57,
   "end": 434.37,
   "text": "حالا تعلق نفس وقتی به بدنه از طریق روح بخاری از غیب تا حدودی غافل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 434.37,
   "end": 437.51,
   "text": "توجهش به بدنه دیگه نفس از طریق روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 437.51,
   "end": 439.97,
   "text": "حالا وقتی روح بخاری تحلیل رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 439.97,
   "end": 451.35,
   "text": "برگشت به اون سه تا منبع و ارتباط نفس با بدن از بین رفت اصطلاحاً اگر کلاً از بین بره میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 451.35,
   "end": 454.47,
   "text": "مرگ و اگر به حداکثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 454.47,
   "end": 457.65,
   "text": "برسه این قطع ارتباط میشه خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 457.65,
   "end": 464.5,
   "text": "اون لحظه چون نفس ناطقه ارتباطش با بدن به حد عقل رسیده دیگه آزاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 464.5,
   "end": 468.39,
   "text": "اصلاً دیگه چون دیگه تعلقش به بدن به حد عقل رسیده دیگه کاری به بدن نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 468.39,
   "end": 471.53,
   "text": "بدن هم داره استراحت می‌کنه. متوجه چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 471.53,
   "end": 474.69,
   "text": "عالم غیب. حالا نقطه سر خط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 474.69,
   "end": 479.83,
   "text": "انشاالله روزهای بعد. چه کنیم که با عالم غیب راحت ارتباط بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 479.83,
   "end": 482.55,
   "text": "ما به صورت سری تو صحبتمون اینو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 482.55,
   "end": 484.64,
   "text": "انشاالله بعداً فاش میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 484.64,
   "end": 489.01,
   "text": "انشاالله عاقبت همگی ختم بخیر باشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 489.01,
   "end": 493.3,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}