 ],
 "cues": [
  {
   "i": 0,
   "start": 5.42,
   "end": 9.62,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.62,
   "end": 14.74,
   "text": "السلام علیک ای داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.74,
   "end": 17.66,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.66,
   "end": 23.62,
   "text": "در ادامه بحث جایگاه روح بخاری که در ما هست و اهمیتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.62,
   "end": 32.38,
   "text": "چند تا جمله دیگه نسبت به ابتداء وقت از حضرت علامه حسن زاده علیه الرحمه از کتاب معرفت نفسشون و سرالایونشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 32.38,
   "end": 38.6,
   "text": "براتون بخونم. بعدم از اسفار ملاصدرا و اگر وقت شد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 38.6,
   "end": 44.9,
   "text": "کتاب شیخ الرئیس. یه چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 44.9,
   "end": 47.3,
   "text": "خصوصیات روح بخاری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.3,
   "end": 51.9,
   "text": "که بعضیاشو توضیح دادم به صورت جمله براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 51.9,
   "end": 56.28,
   "text": "روح بخاری علت غریب و نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 56.28,
   "end": 60.64,
   "text": "علت بعید برای حیات بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 60.64,
   "end": 63.48,
   "text": "اینکه بدن حیات داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.48,
   "end": 66.84,
   "text": "علت غریبش روح بخاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.84,
   "end": 72.32,
   "text": "دو، بدن روح بخاری را احاطه کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.32,
   "end": 77.16,
   "text": "اما در مورد نفس اینگونه باید گفت که بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.16,
   "end": 79.52,
   "text": "مرتبه نازله نفس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.52,
   "end": 81.94,
   "text": "یعنی بدن جدایی از نفس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.94,
   "end": 88.16,
   "text": "شما یک شخص واحدی مرتبه انزل وجودت میشه بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.16,
   "end": 91.9,
   "text": "سه، روح بخاری اگر از بدن مفارقت کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.9,
   "end": 94.66,
   "text": "باطل و فاسد میشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.66,
   "end": 99.24,
   "text": "اما نفس ناطقه دائما باقی و زنده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.24,
   "end": 102.46,
   "text": "و با مفارقت از بدن از بین نمیرود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.46,
   "end": 108.2,
   "text": "و فقط بعضی از افعال آن که به واسطه بدن عنصری انجام میشود باطل میشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.2,
   "end": 113.5,
   "text": "اینا رو دیگه همه گفتیم دیگه. اصلا مرگ چگون-چگونه حاصل میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.5,
   "end": 117.54,
   "text": "چهار، مخصوصا دارم از رو فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.54,
   "end": 122.0,
   "text": "حضرت علامه رو میخونم که اینا از ما نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 122.0,
   "end": 125.1,
   "text": "روح بخاری لطیف‌ترین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.1,
   "end": 132.2,
   "text": "دقیق‌ترین و پاک‌ترین اجسام از اجزاء بدن است و ما ازش غافلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.2,
   "end": 138.7,
   "text": "و به همین دلیل است که بهتر از سایر اجزاء بدن افعال نفس را قبول می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.7,
   "end": 144.86,
   "text": "یعنی نفس انگار که روح بخاری رو گیر آورده از طریق این آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 144.86,
   "end": 146.9,
   "text": "احکامشو در بدن پیاده میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.9,
   "end": 154.78,
   "text": "انقدر که لطیفه. پنج، هر چه روح بخاری اینجا خیلی مهمه اینجا ما حرف داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 154.78,
   "end": 162.7,
   "text": "هر چه روح بخاری از درجه اعتدال مزاجی بیشتری برخوردار باشد، بحث مزاج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 162.7,
   "end": 169.8,
   "text": "اعتدال مزاج، افعال نفس ناطقه بیشتر و قوی‌تر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 169.8,
   "end": 174.48,
   "text": "و از جهت اعتدال و اسب‌سواری از درجه بالاتری برخوردار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 174.48,
   "end": 179.3,
   "text": "پس بفرمایید اونایی که نفس قوی‌ای دارن علتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 179.3,
   "end": 182.34,
   "text": "روح بخاری‌شون یا مزاج‌شون به سمت اعتدال رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 182.34,
   "end": 186.02,
   "text": "اون که تو نود و سوم اشارات شیخ الرئیس فرمود چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 186.02,
   "end": 191.02,
   "text": "انسان کامل چرا همه حقایق رو در خودش جمع می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 191.02,
   "end": 192.96,
   "text": "چون عدل امزجه رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 192.96,
   "end": 195.14,
   "text": "یعنی معتدل‌ترین مزاج رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 195.14,
   "end": 198.18,
   "text": "انقدر مهمه مزاج و ما ازش بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 198.18,
   "end": 201.08,
   "text": "بخوای به زور نماز بهمون بچسبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 201.08,
   "end": 207.5,
   "text": "خب نمی‌چسبه وقتی مت-- مزاج انسان از اعتدال خارج شده نمی‌چسبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 207.5,
   "end": 210.5,
   "text": "یه فرمایشی هم از حضرت ملاصدرا براتون بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 210.5,
   "end": 214.98,
   "text": "به به. از اسفار جلد هشت صفحه دویست پنجاه و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 214.98,
   "end": 218.68,
   "text": "که به قول علامه شهرانی ایشون لطف خدا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 218.68,
   "end": 220.33,
   "text": "قاعده لطفو میدونید دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 220.33,
   "end": 222.12,
   "text": "به ولی خدا میگن لطف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 222.12,
   "end": 226.08,
   "text": "لطف خدا بوده به مردم زمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 226.08,
   "end": 232.88,
   "text": "یه بخشی از فرمایش‌شون. روح بخاری به لحاظ پاکی و لطافت جسمی از قبیل اجر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 232.88,
   "end": 239.44,
   "text": "اجرام فلکی‌ست. حالا اینو بعدا توضیح میدیم اجرام فلکی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 239.44,
   "end": 241.96,
   "text": "یعنی از میان اجسام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 241.96,
   "end": 245.9,
   "text": "جزء اجسامی‌ست که در نهایت لطافت و پاکی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 245.9,
   "end": 248.48,
   "text": "این روح جانشین نفس در بدن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 248.48,
   "end": 253.1,
   "text": "توجه داشته باشید جانشین نفس تو بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 253.1,
   "end": 255.96,
   "text": "اگر خلیفه ادول کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 255.96,
   "end": 259.42,
   "text": "وا مصیبتا. جانشین نفس یعنی خلیفه نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 259.42,
   "end": 264.76,
   "text": "انقدر مهمه. و به تعبیر دیگری می‌گویند که خلیفه نفس در بدن طبیعی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 264.76,
   "end": 272.3,
   "text": "اعتدال روح بخاری به وسیله نفس حفظ می‌شود و به واسطه هوا تغذیه می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 272.3,
   "end": 275.8,
   "text": "حالا اگر هوا ناپاک شد چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.8,
   "end": 278.24,
   "text": "اگر هوا آلوده بود چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 278.24,
   "end": 281.12,
   "text": "اگر هوا ناجور بود چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.12,
   "end": 284.72,
   "text": "بفرمایید. روح بخاری از اعتدالش خارج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.72,
   "end": 286.84,
   "text": "در نتیجه مزاج رو داغون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.84,
   "end": 289.61,
   "text": "بیا حالا رابطه نفسو با بدن برقرار کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.61,
   "end": 291.84,
   "text": "نمیشه. اراده نیست اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.84,
   "end": 295.06,
   "text": "هرچی بخواد جون بکنه از نماز از خواب-- به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.06,
   "end": 300.02,
   "text": "سر خواب پاشه برای نماز شب ساعت کوک کرده ده بار میزنه تو سر ساعت می‌خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.02,
   "end": 302.38,
   "text": "خودت کوک کردی چرا پا نمیشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.38,
   "end": 306.82,
   "text": "چرا؟ نفس ناط-- این مزاج از اعتدال خارج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 306.82,
   "end": 309.9,
   "text": "روح بخاری یا منقبض شده یا منبسط شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 309.9,
   "end": 314.86,
   "text": "این رابطه مستقیم. حالا ه-- یکی از مهم‌ترین‌هاشم هواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.86,
   "end": 317.04,
   "text": "که حالا من نمی‌خوام ورود کنم به این بحث‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 317.04,
   "end": 320.14,
   "text": "یک کلیتی می‌خوایم بگیم شما تشنه بشید رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.14,
   "end": 325.3,
   "text": "بخوایم ورود کنیم به اینا دیگه تا آخر سال باید ما فقط در خصوص روح بخاری حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.3,
   "end": 329.68,
   "text": "یه فرمایشی هم از شیخ الرئیس بخونم کیف کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.68,
   "end": 334.5,
   "text": "رهبر عزیزمون اخیرا فرمودن که از عظمت این مرد این که بعد از هزار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.5,
   "end": 337.7,
   "text": "صد سال هنوز کتاب‌هاش داره تدریس میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.7,
   "end": 341.54,
   "text": "کشورهای به قول خودشون غربی، شرقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.54,
   "end": 347.3,
   "text": "ایشون می‌فرمود که مثلا می‌فرما چه چیزهایی در بدن باعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 347.3,
   "end": 353.66,
   "text": "رعشه میشه. ترس، شادی و غم، ات-اتفاق بزرگ وحشتناک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.66,
   "end": 357.54,
   "text": "غضب، نزدیکی کردن زیاد مخصوصا با شکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.54,
   "end": 359.52,
   "text": "سیر اینا رعشه میاره. و و و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 359.52,
   "end": 362.64,
   "text": "بعد این-- ایشون میاد توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.64,
   "end": 366.9,
   "text": "مباحثشون ربطش میدن همه اینا رو به روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 366.9,
   "end": 368.56,
   "text": "ولی یه بخشش رو من برای شما می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.56,
   "end": 370.62,
   "text": "می‌فرماید ترس از معانی وهمی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.62,
   "end": 376.24,
   "text": "یادتونه گفتم روح بخ-- اِاِاِ نفس مستقیم با بدن مرتبط نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.24,
   "end": 381.76,
   "text": "از طریق قوه وهم و خیال مرتبط به روح بخاریه و روح بخاری هم به بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.76,
   "end": 384.76,
   "text": "اینجا می‌فرماید ترس از معانی وهمی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 384.76,
   "end": 391.66,
   "text": "بدین جهت از تصورات نفسانی انسانی حاصل می‌گردد و تاثیرات خاص خودش را در بدن نیز می‌گذارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.66,
   "end": 398.58,
   "text": "چی؟ ترس. اصولا ترس داشتن بر برودت و یبوست قلب دلالت می‌نماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 398.58,
   "end": 400.86,
   "text": "حالا شاید یه وقتی اینو توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 400.86,
   "end": 403.72,
   "text": "یعنی چی برودت و یبوست قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 403.72,
   "end": 409.28,
   "text": "ترس سبب به وجود آمدن برودت شدیدی در بدن و روح بخاری می‌گردد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 409.28,
   "end": 413.04,
   "text": "به گونه‌ای که حتی ممکن است منجر به مرگ و هلاکت گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 413.04,
   "end": 416.72,
   "text": "بدین نظر رابطه‌ی تدبیری نفس ناطقه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 416.72,
   "end": 423.96,
   "text": "اعضای بدنی یا برخی از آنها موقتا یا دائما ضعیف می‌گردد و از اعتدال، از حالت اعتدال خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 423.96,
   "end": 427.34,
   "text": "یعنی ترس باعث می‌شه رابطه‌ی نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 427.34,
   "end": 429.86,
   "text": "اون مزاج یا روح بخاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 429.86,
   "end": 434.5,
   "text": "از اعتدال خارج بشه. نفس ارتباط نمی‌تونه با بدن بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 434.5,
   "end": 437.46,
   "text": "بعد وقتی ارتباط نمی‌تونه بگیره، نمی‌تونه به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 437.46,
   "end": 442.54,
   "text": "به اون عضلات بدن بگه آقا تو ساکت باش یا تکون بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 442.54,
   "end": 448.78,
   "text": "توجه کردید چی شد؟ این هی تکون می‌خوره ساکنه، تکون می‌خوره ساکن می‌شه، تکون می‌خوره ساکن می‌شه رهاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 448.78,
   "end": 453.08,
   "text": "چرا؟ چون نفس ارتباطش از بدن برداشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 453.08,
   "end": 455.5,
   "text": "یعنی ارتباط خیلی ضعیف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 455.5,
   "end": 460.78,
   "text": "حاصل این ترس سبب، سبب اشتغال و غفلت نفس ناطقه از سایر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 460.78,
   "end": 470.48,
   "text": "از سایر امور ادراکی می‌گردد و سبب انقباض شدید و در برخی از موارد انبساط بیش از اندازه‌ی روح بخاری می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 470.48,
   "end": 476.66,
   "text": "طبیبان حرکت‌های ناشی از ترس و خشم را به این نیرو یعنی روح بخاری نسبت می‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 476.66,
   "end": 484.56,
   "text": "بعد توضیح می‌ده مفصل وقت من گذشته که مثلاً وقتی که س-- یه نفر یه دفعه می‌ترسه یا غضبناک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 484.56,
   "end": 489.04,
   "text": "وقتی که غضبناک می‌شه، اگه داره غذا می‌خوره دیگه مزه‌ی غذا حالیش نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 489.04,
   "end": 494.3,
   "text": "چرا؟ چون تمام توجه نفس به غضبهشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 494.3,
   "end": 499.34,
   "text": "به قوه غضبه. توجهش از معده و اون ه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 499.34,
   "end": 502.02,
   "text": "مزه‌ی غذا برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 502.02,
   "end": 504.32,
   "text": "یا کسی که مثلاً ترسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 504.32,
   "end": 508.98,
   "text": "به این شکل. نفس توجهش از اعضای دیگه برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 508.98,
   "end": 515.72,
   "text": "چرا؟ چون روح بخاری از اعتدال خارج شده یا منقبض شده یا منبسط شده یا مذهل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 515.72,
   "end": 518.28,
   "text": "یه دفعه تو بعضی از بافت‌ها روح بخاری از بین رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 518.28,
   "end": 522.76,
   "text": "اصلاً نفس دیگه نمی‌تونه حکمی رو در خصوص اون بافت پیاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 522.76,
   "end": 529.16,
   "text": "می‌زنه می‌بینی یه مریضی از یه جای غده‌ای یه چیزی زد بیرون سرطان و بدبخت و سرف افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 529.16,
   "end": 531.28,
   "text": "انا لله و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 531.28,
   "end": 535.72,
   "text": "خب با اون مزاجت رو رعایت کن. حالا این دیگه وقت گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 535.72,
   "end": 537.88,
   "text": "بریم جلوتر. شما حوصله کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 537.88,
   "end": 540.74,
   "text": "می‌بینید که رابطه مستقیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 540.74,
   "end": 548.74,
   "text": "حال خوش در نماز با خوردن و خوابیدن و لباس درست پوشیدن و اینا همه اینا با هم مرتبطند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 548.74,
   "end": 552.71,
   "text": "والحمد لله رب العالمين وصلى الله عليه وسلم. الله الصلاة على محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}