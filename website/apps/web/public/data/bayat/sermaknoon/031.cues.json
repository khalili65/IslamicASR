 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 3.56,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.56,
   "end": 9.18,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.18,
   "end": 11.54,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.54,
   "end": 17.94,
   "text": "توی این قسمت از تقریرات فلسفی حضرت امام علیه الرحمه ذیل مبحث نفس بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.94,
   "end": 20.54,
   "text": "و مزاج روح بخاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.54,
   "end": 25.14,
   "text": "که یه جمله بسیار عالی فرمودن که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.14,
   "end": 30.9,
   "text": "ااا اون دستورات حالا تحریک و ترغیب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.9,
   "end": 33.66,
   "text": "ااا اعم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.66,
   "end": 37.12,
   "text": "حالا منع یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.12,
   "end": 42.36,
   "text": "منع می‌کنند انبیا از خوردن چیزی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.36,
   "end": 45.86,
   "text": "ترغیب می‌کنند، تحریک می‌کنند به خوردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.86,
   "end": 51.3,
   "text": "همش فرمودن که علت اصلیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.3,
   "end": 58.14,
   "text": "اینه که اون‌ها در نظر دارن که توده بشر رو به عالم نور وصل بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.14,
   "end": 67.82,
   "text": "اصلاً پایه دعوت‌شون حتی به سمت خوردنی‌ها این بود و قلوب رو به مبدأ عالم جلب نمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.82,
   "end": 71.3,
   "text": "بعد چقدر ما بی‌خبریم از مبدأ عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.3,
   "end": 74.62,
   "text": "متأسفانه. صرفاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.62,
   "end": 83.8,
   "text": "توجهمون به این مادونه، به این ادنا مرتبه دنی دنیا پست فلسفی، این ادنا مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.8,
   "end": 89.22,
   "text": "عالم سفلی. اون عالم علوی کجا ما، نگاه ما کجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.22,
   "end": 95.26,
   "text": "و صفحه الهی وجود انسانی رو صیغل و صاف و زلال نمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 95.26,
   "end": 97.92,
   "text": "که اینجا بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.92,
   "end": 102.76,
   "text": "توجه خودمون رو جلب کردیم به بحث ذات انسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.76,
   "end": 108.16,
   "text": "چون می‌فرماید و در همون تحریک و ترغیب به اغذیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.16,
   "end": 111.8,
   "text": "انبیا تحریک و ترغیب می‌کنند به اغذیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 111.8,
   "end": 114.92,
   "text": "استکمال وجود بشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 114.92,
   "end": 118.56,
   "text": "و صفای ذات افراد انسان را در نظر دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 118.56,
   "end": 121.12,
   "text": "صفای ذات افراد انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.12,
   "end": 125.02,
   "text": "که بعد این بحث پیش اومد که مگر خوردنی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.02,
   "end": 130.88,
   "text": "ربطی هم با ذات دارن که بخواهند صفای ذات بیارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.88,
   "end": 134.1,
   "text": "که رفتیم رو این کار کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.1,
   "end": 136.76,
   "text": "ربط بین اجزاء عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.76,
   "end": 143.34,
   "text": "اشیاء عالم که هیچ چیزی در دنیا بی‌ارتباط با هم نیستن، همه با هم مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 143.34,
   "end": 147.0,
   "text": "این بحث پیش اومد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.0,
   "end": 152.32,
   "text": "چقدر حالا مهمه اون روح بخاری‌ای که با اون سلسله بحث‌هایی که داشتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.32,
   "end": 157.56,
   "text": "اون روح بخاری‌ای که می‌خوام توجه شما رو امروز به این نکته جلب کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.56,
   "end": 171.36,
   "text": "روح بخاری‌ای که در اثر تاثیرات آبا سبعه بر أمهات أربعه در نتیجه تشکیل اون موالید ثلاثه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 171.36,
   "end": 178.62,
   "text": "و اون تاثیر و تأثیراتی که در هم می‌گذارند همه و همه منجر بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 178.62,
   "end": 182.44,
   "text": "به امتزاج عناصر أربعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 182.44,
   "end": 186.26,
   "text": "و از اون‌ها اخلاط أربعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 186.26,
   "end": 188.8,
   "text": "و از اون‌ها اون کف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 188.8,
   "end": 191.14,
   "text": "و از کف تولید بخار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 191.14,
   "end": 194.22,
   "text": "این سلسله تولیدات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 194.22,
   "end": 198.28,
   "text": "این بخار در نهایت می‌خواد بشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 198.28,
   "end": 203.58,
   "text": "که التف اجسامه و متعه اولی نفس ناطقه است به قول علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 203.58,
   "end": 210.58,
   "text": "یعنی اولین مرکبی که نفس بر اون سوار میشه تا احکامش رو پیاده کنه می‌خواد بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 210.58,
   "end": 216.24,
   "text": "محلی برای ارتباط نفس با بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 216.24,
   "end": 219.48,
   "text": "خب اگر اون محلی که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 219.48,
   "end": 222.0,
   "text": "اون بابی که حالا بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 222.0,
   "end": 224.64,
   "text": "مدخلی که می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 224.64,
   "end": 227.8,
   "text": "ارتباط بده بین دو چیز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 227.8,
   "end": 231.34,
   "text": "اون محل خراب باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 231.34,
   "end": 238.98,
   "text": "اون محل مصالح خوبی درش استفاده، اون مدخل، اون در، اون باب مصالح خوبی درش استفاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 238.98,
   "end": 242.6,
   "text": "کسی جرات نمی‌کنه از زیر اون طاق و اون در رد شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 242.6,
   "end": 245.24,
   "text": "قدیم‌ها به در منزلشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 245.24,
   "end": 249.4,
   "text": "به دروازه شهرشون خیلی اهمیت می‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 249.4,
   "end": 254.96,
   "text": "اصلاً معمولاً دوستام میام شما میگم مثلاً یه خونه‌ای خریدیم اومد نداشت برای ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 254.96,
   "end": 262.68,
   "text": "خیر نداشت فلان. میگم اول کاری که می‌کنی اگر برات مقدوره چهارچوب درو عوض کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 262.68,
   "end": 265.74,
   "text": "انقدر مهمه که اون چهارچوبو کی گذاشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 265.74,
   "end": 271.9,
   "text": "کی بناش رو گذاشته؟ و اون لحظه که داشته این رو می‌ساخته اولاً با چه مصالحی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 271.9,
   "end": 273.6,
   "text": "ثانیاً با چه نیتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 273.6,
   "end": 275.24,
   "text": "آیا طهارت نفس داشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 275.24,
   "end": 280.23,
   "text": "نداشته؟ معذرت می‌خوام از خدا دور بوده، جنوب بوده، داشته این کارو می‌کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 280.23,
   "end": 282.76,
   "text": "اصلاً یه حسینیه‌ای بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 282.76,
   "end": 286.18,
   "text": "که من نرفتم فقط تعریفش رو شنیدم از دوستان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 286.18,
   "end": 293.52,
   "text": "تمام کسانی که اینجا کار کردن با وضو کار کردن، روضه خونده شده از عمده و بنا و مهندس و همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 293.52,
   "end": 297.14,
   "text": "دائماً مشغول ذکر امام حسین و با وضو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 297.14,
   "end": 299.52,
   "text": "و هرکی وارد اونجا میشه حالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 299.52,
   "end": 304.46,
   "text": "منقلب میشه. این مدخل و باب خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 304.46,
   "end": 306.74,
   "text": "چرا باب پیغمبر امیرالمؤمنینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 306.74,
   "end": 308.58,
   "text": "چرا باب الحسین ابالفضله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 308.58,
   "end": 310.9,
   "text": "اینا خ-- خیلی مهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 310.9,
   "end": 314.1,
   "text": "هرکسی نمی‌تونه باب سیدالشهدای باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 314.1,
   "end": 318.82,
   "text": "هرکسی نمی‌تونه باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 318.82,
   "end": 320.74,
   "text": "پیغمبر عزیز عالم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 320.74,
   "end": 326.78,
   "text": "حالا نیمه شعبان هم داره میاد و در بهترین ایام هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 326.78,
   "end": 329.36,
   "text": "هرکسی نمی‌تونه باب امام عصر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.36,
   "end": 331.96,
   "text": "اون نوواب أربعه ببین کی بودند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 331.96,
   "end": 337.92,
   "text": "چی بودند؟ یا حتی نواب عام امام عصر که علما هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.92,
   "end": 346.92,
   "text": "فقها هستند که بنا به فرمایش خود حضرت صاحب الأمر علیه الصلاة والسلام که فرمودن \"فأما الحدا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.92,
   "end": 352.88,
   "text": "حوادث الواقعة فارجعوا فيها إلى رباط أحادیثنا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 352.88,
   "end": 355.66,
   "text": "این‌ها مشخصاتشون رو بیان کردن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 355.66,
   "end": 362.22,
   "text": "مخالف الهوی، صانع النفس، مطیع لأمر مولا و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 362.22,
   "end": 364.54,
   "text": "هرکسی نمی‌تونه باب امام عصر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 364.54,
   "end": 367.1,
   "text": "حالا اینطوری می‌خوام عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 367.1,
   "end": 371.14,
   "text": "باب مدخل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 371.14,
   "end": 374.36,
   "text": "ارتباط نفس ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 374.36,
   "end": 377.88,
   "text": "با بدن ما، اون میشه روح بخاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 377.88,
   "end": 381.14,
   "text": "شما بگیریدش باب، بگیریدش مدخل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 381.14,
   "end": 383.98,
   "text": "برزخه دیگه. محل ارتباط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.98,
   "end": 387.14,
   "text": "که اگر اون نباشه گفتیم نفس ناطقه نمی‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.14,
   "end": 388.92,
   "text": "البته قبلش از کجا میومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 388.92,
   "end": 393.52,
   "text": "نفس ناطقه توجهش از کجا می‌افتاد به روح بخاری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.52,
   "end": 395.8,
   "text": "از قوه وهم و خیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 395.8,
   "end": 401.74,
   "text": "از اونجا. پس قوه خیال هم خیلی مهمه که حالا ما بهش نرسیدیم هنوز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 401.74,
   "end": 405.08,
   "text": "خب این نشون میده که اولا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 405.08,
   "end": 407.98,
   "text": "روح بخاری با چه مصالحی ایجاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 407.98,
   "end": 411.72,
   "text": "شده، ایجاد شده، اصطلاحا درست شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 411.72,
   "end": 415.42,
   "text": "خیلی مهمن این مصالح از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 415.42,
   "end": 419.36,
   "text": "مادی. ثانیا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 419.36,
   "end": 425.1,
   "text": "موادی که این روح بخاری رو تشکیل دادن، اون لحظه این مواد پاک بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 425.1,
   "end": 429.34,
   "text": "در معرض نور بودن، اون شخص داشت اینا رو می‌خورد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 429.34,
   "end": 437.32,
   "text": "ذاکر بود، وضو داشت، طهارت داشت، تو غفلت بود، در حین گناه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 437.32,
   "end": 440.62,
   "text": "اینا همش تاثیرگذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 440.62,
   "end": 444.8,
   "text": "اینا همش در واردات انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 444.8,
   "end": 450.4,
   "text": "و تمسلات چه نوعی برزخی، چه تمسلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 450.4,
   "end": 452.58,
   "text": "در بیداری و هوش-هوشیاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 452.58,
   "end": 462.62,
   "text": "اینا همه تاثیرگذارن تا وقتی که این نفس می‌خواد از طریق این روح بخاری به بدن ارتباط بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 462.62,
   "end": 471.34,
   "text": "چرا مثلا فرمودن کسی که ااا اون زهر ماری رو بخوره تا چهل روز نمازش بالا نمی ره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 471.34,
   "end": 474.78,
   "text": "چرا گفتن؟ چه ربطی داره تا چهل روز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 474.78,
   "end": 480.42,
   "text": "برا همین روح بخاریه. یعنی نفس اصلا نمی‌تونه ارتباط با بدن بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 480.42,
   "end": 484.28,
   "text": "وقتی ارتباط با بدن نتونه به حد اقل رسید یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 484.28,
   "end": 486.58,
   "text": "بدن نمی‌تونه معنایی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 486.58,
   "end": 488.92,
   "text": "بدن نمی‌تونه با ماورا ارتباط بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 488.92,
   "end": 491.04,
   "text": "بدن صرفا بدن حیوانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 491.04,
   "end": 492.78,
   "text": "حیوانی و نباتی زندگی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 492.78,
   "end": 497.66,
   "text": "جمادی زندگی می‌کنه. صعودیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 497.66,
   "end": 499.24,
   "text": "وحشی‌گری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 499.24,
   "end": 501.84,
   "text": "نمی‌تونه با، با عالم بالا ارتباط بگیره چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 501.84,
   "end": 504.22,
   "text": "مرتبه مافوق نفسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 504.22,
   "end": 508.0,
   "text": "همینطوری حالا من دارم ذهنتونو می‌شumiem اسرارشو خودتون پیدا می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 508.0,
   "end": 509.96,
   "text": "عجب! چه اهمیتی، چه جایگاهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 509.96,
   "end": 512.14,
   "text": "مخصوصا تو واردات خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 512.14,
   "end": 515.88,
   "text": "ما کی می‌خوایم دارای واردات قلبی باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 515.88,
   "end": 520.34,
   "text": "واردات درست. این همه زیارتگاه‌ها میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 520.34,
   "end": 523.66,
   "text": "البته که باید دهان ببندیم و به اهدی نگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 523.66,
   "end": 527.48,
   "text": "مگر به مثلا یک نفر خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 527.48,
   "end": 532.94,
   "text": "علیه السلام که محل سررمونه که خالی بشیم و الا نه تو بقعه کربلای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 532.94,
   "end": 537.34,
   "text": "ولی بالاخره این همه کربلا، مشهد و رقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 537.34,
   "end": 544.12,
   "text": "این همه هیئت‌ها که محل تجلیات سید و شهداست اینا هیچ وارداتی به ما دست نداد بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 544.12,
   "end": 549.54,
   "text": "این چه وضعشه؟ معلومه روح بخاری خیلی تعطیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 549.54,
   "end": 551.4,
   "text": "این خودش یه نشانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 551.4,
   "end": 562.08,
   "text": "برای همین به همین مناسبت اجازه بدید که چون تو ایام خاصی هم هستیم من یه بخشی از نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 562.08,
   "end": 567.48,
   "text": "ششصد و نود و هشت حضرت استاد رو براتون بخونم از کتاب هزار و یک نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 567.48,
   "end": 575.76,
   "text": "صفحه پونصد و نوزده. ایشون می‌فرماید که شب جمعه هفتم ماه شعبان تو همچین شب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 575.76,
   "end": 582.2,
   "text": "تو همچین ماهی میرن به محضر استادشون حضرت علامه طباطبایی علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 582.2,
   "end": 587.9,
   "text": "بعد ایشون ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 587.9,
   "end": 595.94,
   "text": "به حضرت علامه توصیه می‌کنند که حضرت آقا امشب شب جمعه و شب عید است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 595.94,
   "end": 604.5,
   "text": "علامه طب-- علامه حسن زاده به علامه طباطبایی میگن که امشب حضرت آقا شب عیده، شب جمعه‌ست، ماه شعبانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 604.5,
   "end": 607.92,
   "text": "لطفی بفرمایید. چقدر خوبه آدم پیش یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 607.92,
   "end": 611.42,
   "text": "حکیمی، یه حکیم متألهی میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 611.42,
   "end": 614.42,
   "text": "یه عارف میره چیزی بگیره ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 614.42,
   "end": 625.74,
   "text": "علامه چی فرمودن؟ فرمودن سوره مبارکه صad «والقرآن للذكر» را در نمازهای وتر بعد از حمد بخوانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 625.74,
   "end": 629.54,
   "text": "وتر همون نماز دو، دو رکعت نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 629.54,
   "end": 636.68,
   "text": "نافله عشا است. که در حدیث است سوره صad از ساق عرش نازل شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 636.68,
   "end": 645.74,
   "text": "تا اینکه نامه‌ای به آن جناب ارسال داشتند که سؤالاتی از تعیین خط زوال و خط سمت قبله به طریق دایره هندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 645.74,
   "end": 647.8,
   "text": "بوده است. تا اینا رو یه نامه‌ای نوشته بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 647.8,
   "end": 651.34,
   "text": "سؤالی در خصوص این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 651.34,
   "end": 655.68,
   "text": "خط زوال و سمت قبله اینا از حضرت علامه طباطبایی پرسیده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 655.68,
   "end": 660.92,
   "text": "علامه این نامه رو داد به شاگردشون علامه حسن زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 660.92,
   "end": 664.9,
   "text": "وقت گذاشتن و اینو خیلی عالمانه جواب نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 664.9,
   "end": 670.76,
   "text": "بعد می‌فرمایند که حالا این من الان به شما بگم چون به آخرش نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 670.76,
   "end": 672.8,
   "text": "موجب واردات قلبی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 672.8,
   "end": 674.9,
   "text": "اگه کسی دنبال وا-- بحث ما این بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 674.9,
   "end": 678.7,
   "text": "واردات قلبی. صاف بشه، می‌خواد زلال بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 678.7,
   "end": 686.26,
   "text": "این سوره صad خیلی خوبه. که انَّ این سوره صad تاثیر مستقیم در روح بخاری و مزاج انسان داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 686.26,
   "end": 688.46,
   "text": "اینا تعجب نکنیم. اینا در هم تنیده‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 688.46,
   "end": 691.98,
   "text": "ما بحث کردیم دیگه ظاهر و باطن عالم در هم تنیده‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 691.98,
   "end": 694.48,
   "text": "یک حقیقتن با دوشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 694.48,
   "end": 699.8,
   "text": "که حتی قبلا بحث کردیم ختم قرآن هم تعدیل مزاج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 699.8,
   "end": 703.92,
   "text": "حالا تو قرآن چه خبره؟ یکی از مهماتش همین سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 703.92,
   "end": 707.12,
   "text": "صاده. در س-- کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 707.12,
   "end": 710.6,
   "text": "س-- در نماز وتر خاصه بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 710.6,
   "end": 715.48,
   "text": "خلاصه نامه رو حضرت استاد میگن من جوابشو دادم و پس از تقدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 715.48,
   "end": 721.18,
   "text": "جواب که حالا میگن که قریب یک سال طول کشید این نامه رو من تنظیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 721.18,
   "end": 723.66,
   "text": "نامه خیلی نیاز داشت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 723.66,
   "end": 731.52,
   "text": "شرح و تعدیل و چی و اینا. خلاصه مفصل عالمانه نوشتم آوردم دادم خدمت ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 731.52,
   "end": 737.33,
   "text": "و علامه طباطبایی وقتی نامه رو ار-دادم خدمتشون عرض کردم جناب آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 737.33,
   "end": 739.97,
   "text": "به حمدالله تعالی وارداتی روی آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 739.97,
   "end": 746.01,
   "text": "یعنی اون کارو انجام دادم سوره صاد رو خوندم در وتیره وارداتی روی آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 746.01,
   "end": 748.85,
   "text": "ملاک تمیز حق از باطل چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 748.85,
   "end": 751.47,
   "text": "حالا من چجوری بفهمم این واردات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 751.47,
   "end": 756.13,
   "text": "این کشف و مکاشفات و اینا و کرا-- اینا حقه، باطله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 756.13,
   "end": 758.81,
   "text": "در جواب فرمودند یک سلسله کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 758.81,
   "end": 762.23,
   "text": "اصلاً تردید بردار نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 762.23,
   "end": 770.81,
   "text": "که محض ایان است مثل آن کشف ایانی که پیغمبر اکرم صلی الله علیه و آله و سلم برای شما اذان می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 770.81,
   "end": 776.69,
   "text": "یه کشفی برای حضرت علامه پیش میاد که پیغمبر برایشون اذان می‌گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 776.69,
   "end": 784.31,
   "text": "برای مکاشف احوالی پیش می‌آید که معیار تمیز و میزان صحت و ثقل به دست می‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 784.31,
   "end": 787.54,
   "text": "باید عقل و قرآن را ضابطه قرار دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 787.54,
   "end": 789.45,
   "text": "این دو تا ضابطه‌اند. عقل و قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 789.45,
   "end": 792.73,
   "text": "یه جای دیگه خود علامه فرمود نفس خودت ملاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 792.73,
   "end": 795.15,
   "text": "آیا این-- قبلاً هم تو درس و بحث‌ها گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 795.15,
   "end": 800.55,
   "text": "آیا اینو دیدی این واردات که به قلبت وارد شد انبساط خاطر به دست داد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 800.55,
   "end": 804.03,
   "text": "احساس انشراح قلبی پیدا کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 804.03,
   "end": 806.41,
   "text": "شرح صدر پیدا کردی؟ به خدا نزدیک شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 806.41,
   "end": 808.93,
   "text": "حقه. اگر نه بدتر. تاریکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 808.93,
   "end": 811.81,
   "text": "ضیقت کرد. اینها اذیتت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 811.81,
   "end": 814.63,
   "text": "مضطربت کرد. نه اون حق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 814.63,
   "end": 818.99,
   "text": "سپس فرمود من در مس-- حالا علامه طباطبایی داره می‌فرمود یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 818.99,
   "end": 824.17,
   "text": "مکاشفات خودشو داره میگه. من در مسجد سهله در مقام ادریس نماز می‌خواندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 824.17,
   "end": 833.53,
   "text": "در نماز وتیره سوره مبارکه صاد را قرائت می‌کردم که ناگهان دیدم از جای خود حرکت کردم ولی بدنم در زمین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 833.53,
   "end": 840.45,
   "text": "به قدری با بدنم فاصله گرفتم که او را از دورترین نقطه مشاهده می‌کردم تا پس از شندی به حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 840.45,
   "end": 843.45,
   "text": "اول خود برگشتم. یعنی برگشتم تو بدنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 843.45,
   "end": 845.83,
   "text": "و وقت دیگر نهر آب دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 845.83,
   "end": 849.49,
   "text": "یه، یه وقت یه چند وقتی گذشت لحظاتی گذشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 849.49,
   "end": 856.81,
   "text": "دو مرتبه نهر آب دیدم که در روایت آمده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 856.81,
   "end": 860.07,
   "text": "که هرکی اینو بخونه ظاهراً از اون به، از اون نهر می،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 860.07,
   "end": 862.15,
   "text": "می‌نوشانند به او. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 862.15,
   "end": 871.27,
   "text": "حقیر گوید یعنی علامه خودشو می‌شکنه اینجا می‌فرماید حقیر گوید که چون در مقام ادریس نبی علیه السلام نماز می‌خواند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 871.27,
   "end": 877.35,
   "text": "و خدای متعال در شأن وی فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 877.35,
   "end": 880.27,
   "text": "آن رفعت و صعود روی آورده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 880.27,
   "end": 887.63,
   "text": "بعد ربطش میده به مناسبات زمانی و مکانی همون نفس کینونه از من و امکنه که قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 887.63,
   "end": 899.13,
   "text": "که حالا انشاالله جلسه بعد بقیه همین نکته رو می‌خونیم که اهمیت استفاده از مکان‌ها و زمان‌ها برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 899.13,
   "end": 903.27,
   "text": "ارتقاء وجودی. حالا این یک سیر بود، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 903.27,
   "end": 907.29,
   "text": "گفتمانی بود بین استاد و شاگرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 907.29,
   "end": 910.17,
   "text": "ایشون میگه وارداتی به من دست داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 910.17,
   "end": 914.39,
   "text": "ایشون ملاک میده. بعد استاد از واردات خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 914.39,
   "end": 918.15,
   "text": "نکته‌ای مثلاً میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 918.15,
   "end": 921.19,
   "text": "که چی؟ اِممم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 921.19,
   "end": 926.33,
   "text": "شاگرد بدونه نه راه بسته نیست، راه بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 926.33,
   "end": 930.93,
   "text": "که قرآن هم می‌فرماید فحدث فیه حدیث کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 930.93,
   "end": 933.39,
   "text": "از آنچه که به تو عطا می‌شه حدیث کن، بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 933.39,
   "end": 938.25,
   "text": "البته به اهلش. حالا گفتمان‌های ما چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 938.25,
   "end": 941.47,
   "text": "گفتمان‌های ما با عزیزترین کسانمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 941.47,
   "end": 948.97,
   "text": "خلاصه شده تو مسائل معذرت می‌خوام دنیوی و شهوی و شکمی و پا و خوراک و دنیا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 948.97,
   "end": 953.99,
   "text": "یه دم که دیگه نوسان دلار و سکه و بازار و بورس و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 953.99,
   "end": 958.89,
   "text": "این چیزا. دیگه تو خود حدیث مفصل بخوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 958.89,
   "end": 961.75,
   "text": "از این مجمل. بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 961.75,
   "end": 970.41,
   "text": "عید بزرگ نیمه شعبان نزدیکه و انشاالله امیدواریم که ما از این جور رابطه‌ها با آقامون پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 970.41,
   "end": 974.19,
   "text": "بتونیم با آقامون از این جور رابطه‌ها-- هست، راهش بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 974.19,
   "end": 976.57,
   "text": "اون مدخل و اون باب بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 976.57,
   "end": 980.17,
   "text": "باید از تصفیه روح بخاری شروع کنیم بریم تا بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 980.17,
   "end": 983.45,
   "text": "قوه خیال رو تصفیه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 983.45,
   "end": 988.13,
   "text": "همین طوری تا انشاالله این مدخل‌ها و این باب‌ها به روی ما هم باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 988.13,
   "end": 993.24,
   "text": "نوش جونتون انشاالله. والحمد لله رب العالمين صلوات بفرستین. اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}