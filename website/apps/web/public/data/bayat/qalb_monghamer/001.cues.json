   "start": 0.62,
   "end": 109.7
  },
  {
   "index": 1,
   "title": "## ورود به قلب منغمر؛ آیهٔ شصت‌وسهٔ مؤمنون",
   "start": 109.7,
   "end": 342.12
  },
  {
   "index": 2,
   "title": "## اقسام خبر در قرآن؛ خام و تحلیلی",
   "start": 342.12,
   "end": 511.59
  },
  {
   "index": 3,
   "title": "## هدهد؛ خبر حسّی و خطای حدسی",
   "start": 511.59,
   "end": 731.63
  },
  {
   "index": 4,
   "title": "## آصف بن برخیا و شؤونات آوردن تخت",
   "start": 731.63,
   "end": 757.15
  },
  {
   "index": 5,
   "title": "## بلقیس؛ تخت و آبگینه و عبور به ملکوت",
   "start": 757.15,
   "end": 1074.67
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.62,
   "end": 3.56,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.56,
   "end": 7.58,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.58,
   "end": 12.82,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.82,
   "end": 20.6,
   "text": "صبر کنید، مخلصم. آیا قرائت صحیح نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.6,
   "end": 24.42,
   "text": "مانع از اینه که کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.42,
   "end": 27.88,
   "text": "امام باشه یا فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.88,
   "end": 32.16,
   "text": "در مأموم بودن یا هر دو یا کدومش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.16,
   "end": 35.34,
   "text": "آیا در هر دو باید لحاظ شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.34,
   "end": 39.58,
   "text": "قرائت صحیح؟ حکمش کجا پیاده میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.58,
   "end": 42.58,
   "text": "در مأموم یعنی در نماز فرادا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.58,
   "end": 45.34,
   "text": "یا جماعت یا امام بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.34,
   "end": 48.96,
   "text": "رهبر اعظم می‌فرمایند که فرق نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.96,
   "end": 51.88,
   "text": "بایستی که اینجا دقت داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.88,
   "end": 56.14,
   "text": "همه کسانی که به کسی اقتدا می‌کنند اینو بدونند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.14,
   "end": 58.72,
   "text": "اولا قرائت باید برای همه صحیح باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.72,
   "end": 61.32,
   "text": "همه باید قرائتشون صحیح باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.32,
   "end": 66.8,
   "text": "و اگر کسی تلاشش رو بکنه برای اینکه قرائتش رو درست کنه اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.8,
   "end": 70.48,
   "text": "نتونه به هر دلیلی موفق نشه، تلاش کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.48,
   "end": 73.98,
   "text": "نتونست قرائتش رو درست کنه، این نمازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.98,
   "end": 77.22,
   "text": "درسته. اما نکته اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.22,
   "end": 78.8,
   "text": "نمی‌تونه امام بایسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.8,
   "end": 81.48,
   "text": "یعنی نمی‌تونم بهش اقتدا کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 81.48,
   "end": 89.22,
   "text": "پس اگر خواستی به رفیقت اقتدا کنی که او عادل است برای تو از منظر نگاه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.22,
   "end": 94.06,
   "text": "باید یقین داشته باشی که قرائتش هم درسته عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.06,
   "end": 97.5,
   "text": "می‌خواد واسطه‌ی فیض تو بین آسمون و زمین بشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.5,
   "end": 101.8,
   "text": "قرائت اینجا خیلی مهمه. باید بالاخره دلسوز باشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.8,
   "end": 106.26,
   "text": "زحمت کشیده باشه رو قرائتش کار کرده باشه مهم باشه براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.26,
   "end": 109.7,
   "text": "مهم نیست که هیچی دیگه. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.7,
   "end": 112.78,
   "text": "به فضل الهی بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.78,
   "end": 116.36,
   "text": "منزل رو سفره‌ش رو جمع می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.36,
   "end": 121.7,
   "text": "و اگرچه خیلی مباحثمون صحبت‌ها پیرامون قلب منزل موند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.7,
   "end": 124.18,
   "text": "دیگه به اهلش واگذار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.18,
   "end": 129.32,
   "text": "به امید خدا ورود می‌کنیم به بیست و دومین نوع از قلب در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.32,
   "end": 132.32,
   "text": "که انتخاب بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.32,
   "end": 136.66,
   "text": "نسبت به سیر بحث قلب منغمر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.66,
   "end": 143.52,
   "text": "منغمر با غین. قلب منغمر رو از کجا درآوردی حاج آقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.52,
   "end": 148.56,
   "text": "آیه رو دقت بفرمایید. آیه شصت و سه سوره مؤمنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.56,
   "end": 151.24,
   "text": "می‌فرماید \"بل قلوبهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.24,
   "end": 154.32,
   "text": "بل قلوبهم\" بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.32,
   "end": 157.76,
   "text": "قلوبهم دلهای این‌ها \"فی غمرة،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.76,
   "end": 161.1,
   "text": "غمرة، فی غمرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.1,
   "end": 170.2,
   "text": "من هذا، بل قلوبهم من غمرة من هذا ولهم أعمال من دون ذلك هم لها عاملون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.2,
   "end": 174.0,
   "text": "ترجمه‌ش اینه که بلکه این دل‌های کفار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.0,
   "end": 178.72,
   "text": "و کافران در جهل و غفلت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.72,
   "end": 180.44,
   "text": "از این در جهل و غفلت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.44,
   "end": 184.2,
   "text": "حالا باید بحث بشه که از چی در غفلت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.2,
   "end": 189.9,
   "text": "و اعمالی که این کافران عامل آن‌اند غیر اعمال آن اهل ایمان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.9,
   "end": 192.96,
   "text": "چون در آیات قبل پیرامون اعمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.96,
   "end": 196.16,
   "text": "اهل ایمان سخن گفته و صحبت کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.16,
   "end": 203.06,
   "text": "اینجا می‌فرماید که اعمال این‌ها یعنی کفار غیر اعمال اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.06,
   "end": 205.04,
   "text": "بله دیگه غمرة بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.04,
   "end": 207.36,
   "text": "اینجا در تفاسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.36,
   "end": 211.78,
   "text": "مثل آقای قرائتی تو تفسیر نورش می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.78,
   "end": 215.36,
   "text": "به یک معنا غرق شدن در یک گردابیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.36,
   "end": 219.28,
   "text": "کسی که میفته در یک گردابی و غرق میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.28,
   "end": 222.5,
   "text": "اون ریش-- این معنای ریشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.5,
   "end": 226.06,
   "text": "غمرة است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.06,
   "end": 228.12,
   "text": "اینجا میگه غمرة دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.12,
   "end": 232.72,
   "text": "بله. غرق شدن در بلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.72,
   "end": 236.32,
   "text": "نه اینجا منظور غرق شدن در بلا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.32,
   "end": 240.38,
   "text": "میش- می‌تونه یک نوع بلا باشه این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.38,
   "end": 242.9,
   "text": "اما این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 242.9,
   "end": 245.38,
   "text": "این نوع بلا از چه نوعیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 245.38,
   "end": 250.54,
   "text": "اینجا قرآن می‌فرماید که در بی‌خبریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.54,
   "end": 256.34,
   "text": "چرا؟ چون می‌فرماید که \"بل قلوبهم فی غمرة من هذا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.34,
   "end": 259.64,
   "text": "در یک بی‌خبری‌ایست از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.64,
   "end": 263.08,
   "text": "حالا این هذا رو باید بعداً ببینیم به چی باید زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.08,
   "end": 271.94,
   "text": "پس غمرة یا قلب منغمر می‌شود قلبی که در بی‌خبری غرق شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.94,
   "end": 277.16,
   "text": "هیچ خبر نداره از حقایق عالم، از اخبار عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.16,
   "end": 280.0,
   "text": "بی‌خبر است، غرق شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.0,
   "end": 283.3,
   "text": "و حالا ظاهر آیه و این چیزی که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.3,
   "end": 288.04,
   "text": "حالا معنایی که اهل لغت من بررسی کردم یا مفسرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.04,
   "end": 291.46,
   "text": "این‌ها حضرت علامه طباطبایی علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.46,
   "end": 293.18,
   "text": "یا تفسیر نور الفقلین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.18,
   "end": 296.28,
   "text": "این‌ها تفاسیر خوب ما، مجمع البیان شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.28,
   "end": 299.24,
   "text": "مر- مرحوم طبری این‌ها دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.24,
   "end": 302.14,
   "text": "اینطور که آدم متوجه می‌شه یعنی اصلاً دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.14,
   "end": 306.14,
   "text": "غرقه دیگه غرق شده. مثل آدمی که میگن غرق شد تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.14,
   "end": 309.5,
   "text": "انقدر از در بی‌خبری غرق شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.5,
   "end": 314.64,
   "text": "هیچ خبری که نه، میگن فلانی رو اگه عالم آب ببره این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.64,
   "end": 318.04,
   "text": "خواب می‌برش، عالم آب ببره اینو خواب می‌برش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.04,
   "end": 325.06,
   "text": "یعنی دیگه تو یه گردابی، غرقابی از آب مثلا آب بی‌خبری گرفتار شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.06,
   "end": 329.34,
   "text": "و تمام وجودش رو فرا گرفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.34,
   "end": 333.34,
   "text": "حالا نکته‌هایی در ذیل این آیه داریم که این رو مسلخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.34,
   "end": 336.26,
   "text": "بحث ما این آیه رو قرار دادیم به مرور انشاالله میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.26,
   "end": 339.54,
   "text": "امروز اجازه بفرمایید تبرکاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.54,
   "end": 342.12,
   "text": "پیرامون موضوع خبر اصلاً صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.12,
   "end": 344.3,
   "text": "خبر در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 344.3,
   "end": 348.32,
   "text": "کلاً خبر، خبر به این صورت اومده یا خبر خامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 348.32,
   "end": 354.62,
   "text": "تو قرآن هم ما زیاد می‌بینیم خبرهایی که خامن هیچ تحلیلی همراه خودشون ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.62,
   "end": 359.04,
   "text": "خامن مثل اخباری که خدای منان پیرامون قیامت مثلا بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.04,
   "end": 362.2,
   "text": "\"اقترب الساعة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.2,
   "end": 364.67,
   "text": "ساعت نیا-- قیامت نزدیک شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.67,
   "end": 367.61,
   "text": "اینچنین شد. \"إذا زلزلت الأرض زلزالها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.61,
   "end": 371.03,
   "text": "اینا \"إذا الشمس كورت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.03,
   "end": 373.55,
   "text": "و \"ويوم تقوم الساعة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.55,
   "end": 377.81,
   "text": "این‌ها آیاتی که اخ-اخبار می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.81,
   "end": 383.29,
   "text": "خبر میدن از یک حقایق کلیه قطعیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.29,
   "end": 386.57,
   "text": "که دیگه تحلیلی براش ارائه نمیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 386.57,
   "end": 391.85,
   "text": "ظاهراً. البته تحلیل داریم و دارد اما من به صورت کلی دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.85,
   "end": 394.71,
   "text": "حالا ظاهراً ارائه نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.71,
   "end": 400.41,
   "text": "اما خ-- قسمت دوم خبرها، خبر با چاشنی تحلیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 400.41,
   "end": 403.51,
   "text": "سومین نوع خبر، خبر تحلیلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 403.51,
   "end": 406.43,
   "text": "خبر تحلیلی یعنی بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.43,
   "end": 409.51,
   "text": "دیده‌ها و شنیده‌های قطعیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 409.51,
   "end": 412.77,
   "text": "یعنی خبر بر اساس یک علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.77,
   "end": 415.27,
   "text": "حسی و یقینی و علمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.27,
   "end": 420.55,
   "text": "این تحلیل داره که تو قرآن زیاد از این نوع اخبار می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.55,
   "end": 425.27,
   "text": "که تحلیل ارائه میده. مثلاً اخبار اقوام پیشینیان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 425.27,
   "end": 432.99,
   "text": "که خبره که قوم لوط چجوری گرفتار شد، قوم عاد چجوری گرفت-- قوم حضرت نوح چطوری داره گرفتار شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.99,
   "end": 435.55,
   "text": "و این‌ها خبرن اما تحلیل دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.55,
   "end": 438.97,
   "text": "یعنی چی تحلیل دارن؟ بل-- بالقطع میاد میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.97,
   "end": 441.75,
   "text": "علته یعنی چرایی، واکاوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.75,
   "end": 447.05,
   "text": "واکاوی می‌کنه چرا اینا گرفتار عذاب شدن و تحلیلشون هم قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 447.05,
   "end": 450.23,
   "text": "یعنی ه-حدسی نیست، حسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.23,
   "end": 454.03,
   "text": "حس شده بزرگان، انبیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 454.03,
   "end": 457.81,
   "text": "این‌هایی که یا ملائکت الله این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.81,
   "end": 462.07,
   "text": "که بین آسمان و زمین در تردید بودند، این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.07,
   "end": 466.07,
   "text": "حس کردن نه که فقط حدس بزنن، دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 466.07,
   "end": 470.29,
   "text": "به شهود نشستن. اینم خبر تحلیلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.29,
   "end": 473.59,
   "text": "اما یه خبر داریم که خبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 473.59,
   "end": 476.11,
   "text": "با چاشنی تحلیله. اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 476.11,
   "end": 480.89,
   "text": "بیشتر الان خبرهای رسانه‌ای ما بیشترش از این نوعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 480.89,
   "end": 483.65,
   "text": "که همراه خودش گمانه‌زنی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 483.65,
   "end": 486.95,
   "text": "یعنی یقینی، خبر یقینی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 486.95,
   "end": 489.05,
   "text": "اگرچه شاید بالقطع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 489.05,
   "end": 492.53,
   "text": "داره بیانش می‌کنه اما گمانه‌زنیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 492.53,
   "end": 495.67,
   "text": "و متاسفانه دروغ پراکنیه و داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 495.67,
   "end": 497.79,
   "text": "مخاطب خودش رو به بیراهه می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 497.79,
   "end": 503.29,
   "text": "از این قبیل اخبار توسط حضرت حق تو قرآن ما نداریم مطلقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 503.29,
   "end": 508.39,
   "text": "اما نمونه‌هاییش در داستان‌های قرآنی دیده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 508.39,
   "end": 511.59,
   "text": "مثلاً در اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 511.59,
   "end": 513.79,
   "text": "حضرت سلیمان نبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.79,
   "end": 517.41,
   "text": "میان می‌بینن که حالا اون پرندگان سان میدید از همه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 517.41,
   "end": 519.35,
   "text": "جنود و لشکریانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.35,
   "end": 523.49,
   "text": "در میان پرنده‌هایی که حالا باید به صف و به خط وایمیستادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 523.49,
   "end": 525.85,
   "text": "دید هدهد نیست. شنیدید دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 525.85,
   "end": 530.11,
   "text": "در آیات سوره سبع باید باشه، صبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 530.11,
   "end": 534.75,
   "text": "اینجا هست که میگه دید هدهد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 534.75,
   "end": 537.91,
   "text": "اگر برید بررسی کنید آیات رو داستانش مفصل هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 537.91,
   "end": 541.71,
   "text": "تو تفاسیر هم آمده. حالا ما قصد به داستان‌گویی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 541.71,
   "end": 544.27,
   "text": "می‌خوایم مطلبی رو عرض کنیم. دید هدهد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 544.27,
   "end": 546.53,
   "text": "خبر گرفت. چرا هدهد کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 546.53,
   "end": 553.93,
   "text": "که اگر علت خاصی توجیه درستی بر این غیبتش نداشته باشه، هر آینه به اشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 553.93,
   "end": 556.97,
   "text": "وجه عذابش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 556.97,
   "end": 558.51,
   "text": "این باید سر پستش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 558.51,
   "end": 561.63,
   "text": "الان چرا اینجا نیست؟ یعنی این‌ها خیلی نکات عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 561.63,
   "end": 566.39,
   "text": "مفسرین پیرامون تک‌تک این م-مطالبی که تو این آیات اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 566.39,
   "end": 569.15,
   "text": "گفتن که حالا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.15,
   "end": 571.85,
   "text": "قصد تفصیل نداریم اجمالاً عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 571.85,
   "end": 576.05,
   "text": "خب هدهد حاضر شد، حاضرش کردن اومد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 576.05,
   "end": 578.55,
   "text": "بگو ببینم توجیهت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 578.55,
   "end": 584.29,
   "text": "خبر داد. هدهد خبر داد از ملکه بلقیس و که تو یمنن و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 584.29,
   "end": 587.29,
   "text": "و خب این‌ها تو فلسطین بودند. حضرت سلیمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.29,
   "end": 590.93,
   "text": "تو یمن هستن و بعد این‌ها داشت اول از چی می‌گفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 590.93,
   "end": 594.01,
   "text": "خبر قطعی می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 594.01,
   "end": 597.99,
   "text": "خبر خام هم نبود. خبر قطعی می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 597.99,
   "end": 600.09,
   "text": "چرا؟ داشت می‌گفت به یقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 600.09,
   "end": 603.57,
   "text": "هدهد می‌گفت به یقین یعنی به علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 603.57,
   "end": 608.13,
   "text": "حسی‌ش و قطعی‌ش و دیده‌هاش دیده بود به شهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 608.13,
   "end": 610.69,
   "text": "که این‌ها ستاره رو سجده می‌کنند، چرا آ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 610.69,
   "end": 614.61,
   "text": "خورشیدو سجده می‌کنند. شیطان این‌ها رو به اق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 614.61,
   "end": 616.53,
   "text": "مثلاً بیراهه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 616.53,
   "end": 618.63,
   "text": "انحراف کشونده و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 618.63,
   "end": 622.05,
   "text": "خدای احد و واحد رو پرستش نمی‌کنند و این و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 622.05,
   "end": 624.29,
   "text": "گفت چیزایی که دیده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 624.29,
   "end": 627.41,
   "text": "و اما یه دفعه زدش به یک خبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 627.41,
   "end": 630.79,
   "text": "حدسی. این خبر وقتی حدسی شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 630.79,
   "end": 633.71,
   "text": "دیگه میره تو نوع تحلیل، حدس زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 633.71,
   "end": 639.95,
   "text": "بالقطع و اليقین اگرچه داشت می‌گفت من خبرم قطعیه اما از اینکه حضرت سلیمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 639.95,
   "end": 646.97,
   "text": "علی نبينا و آله و عليه الصلاة والسلام خبر ایشون رو ابتدا نپذیرفت فرمود باید بررسی کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 646.97,
   "end": 653.21,
   "text": "ببینم آیا، آیا تو جزو صادقین هستی یا کاذبین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 653.21,
   "end": 655.97,
   "text": "ببینم تو راست میگی یا دروغ. این پیداست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 655.97,
   "end": 658.51,
   "text": "این خبر از نوع خبر تحلیلی بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 658.51,
   "end": 661.29,
   "text": "کما اینکه همینم شد با چاشنی تحلیل البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 661.29,
   "end": 666.15,
   "text": "چطور؟ توی صحبت‌هاش هدهد وقتی این‌ها رو معرفی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 666.15,
   "end": 669.21,
   "text": "بلقیس و دار و دسته‌شو میگه این ع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 669.21,
   "end": 673.61,
   "text": "هیچک-- این‌ها هدایت نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 673.61,
   "end": 678.07,
   "text": "مطلقاً این‌ها هدایت‌پذیر نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 678.07,
   "end": 683.61,
   "text": "همین که میگه این‌ها هدایت‌پذیر نیستن حضرت سلیمانه دیگه باخبره از عالم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 683.61,
   "end": 685.61,
   "text": "میدونه که اینچنین نیست، داستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 685.61,
   "end": 688.63,
   "text": "به گونه‌ی دیگریست. می‌فرماید که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 688.63,
   "end": 690.31,
   "text": "باید خبر تو رو چیکار کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 690.31,
   "end": 695.47,
   "text": "بررسی کنم. خب این چاشنی تحلیل رو چون از روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 695.47,
   "end": 698.59,
   "text": "حدس گفت نه از روی حس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 698.59,
   "end": 701.97,
   "text": "رفت جزو چی؟ اخباری که تحلیلی‌ان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 701.97,
   "end": 705.79,
   "text": "چاشنی تحلیلن باید بررسی بشه که اشتباه هم کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 705.79,
   "end": 710.25,
   "text": "هدهد اینجا اشتباه کرده بود در خبرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 710.25,
   "end": 713.13,
   "text": "که بعداً حالا داستانشو می‌دونید که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 713.13,
   "end": 717.15,
   "text": "تاریخ ذکر کرده. اگرچه هدهد گفت \"فَهَمَ لا يَهْتَدُونَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 717.15,
   "end": 719.75,
   "text": "\"فَهَمَ لا يَهْتَدُونَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 719.75,
   "end": 722.77,
   "text": "سلیمان بدون که این‌ها هدایت‌پذیر نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 722.77,
   "end": 725.49,
   "text": "اما سلیمان کارهایی که کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 725.49,
   "end": 729.33,
   "text": "این‌ها رو اتفاقاً به نحو احسن به هدایت گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 729.33,
   "end": 731.63,
   "text": "و هادی اون‌ها شد. جالبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 731.63,
   "end": 735.21,
   "text": "در قصه بلقیس که تشریف آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 735.21,
   "end": 738.19,
   "text": "از، اه، عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 738.19,
   "end": 742.25,
   "text": "از یمن اومدن به فلسطین اول کاری که کرد می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 742.25,
   "end": 750.29,
   "text": "اونجا حالا آصف درست بشه آصف ابن برخیا که بعضیا میگن وصی از سلیمان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 750.29,
   "end": 753.89,
   "text": "حالا معاون ایشون بود، جانشینش بود، هرچی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 753.89,
   "end": 756.87,
   "text": "این بزرگوار اول یه افریتی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 756.87,
   "end": 758.75,
   "text": "جن وقتی حضرت سلیمان گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 758.75,
   "end": 761.19,
   "text": "کی می‌تونه تخت بلقیس رو بیاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 761.19,
   "end": 763.21,
   "text": "یه افریته از جن گفت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 763.21,
   "end": 766.23,
   "text": "قبل از اینکه بلند شی از جات آوردمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 766.23,
   "end": 771.85,
   "text": "بعد آصف ابن برخیا گفت قبل از اینکه چشم به هم بزنی میارمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 771.85,
   "end": 775.29,
   "text": "و حضرت سلیمان سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 775.29,
   "end": 777.15,
   "text": "هنوز چشم نزده دید اونجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 777.15,
   "end": 779.09,
   "text": "حالا اینجا بحث‌ها هست از تعلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 779.09,
   "end": 784.13,
   "text": "حسن زاده علیه الرحمه می‌فرمایند خب سلیمان که خودش قدرت داشت بیاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 784.13,
   "end": 788.17,
   "text": "چرا خودش نیاورد؟ این می-میره توی اون بحث شؤونات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 788.17,
   "end": 791.83,
   "text": "که گفتیم هر چیزی رو نباید از امام معصوم خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 791.83,
   "end": 796.73,
   "text": "اینجا اما حضرت سلیمان آیا قدرت اینو نداشت خودش تختو بیاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 796.73,
   "end": 799.41,
   "text": "چرا. اما شؤونات باید حس بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 799.41,
   "end": 802.45,
   "text": "سپرد به معاونش. سپرد به زیردستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 802.45,
   "end": 805.87,
   "text": "گفت کی می‌تونه بیاره؟ اونم یک چشم به هم زدن تختو آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 805.87,
   "end": 807.79,
   "text": "اینا ببین نکته‌ست خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 807.79,
   "end": 811.31,
   "text": "حالا بعد وقتی هم که آورد و بلقیس که اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 811.31,
   "end": 818.93,
   "text": "چند تا چیزو دید. عبور کرد از ظاهر به باطن و از ناسوت و ملک حرکت کرد، سفر کرد به ملکوت که ایمان آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 818.93,
   "end": 822.45,
   "text": "اول وقتی این تختو دید گفت این کار عادی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 822.45,
   "end": 827.03,
   "text": "متوجه شد که به آنی این تخت زودتر از خودش اومده متوجه شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 827.03,
   "end": 830.25,
   "text": "که بحث، بحث ملکوتی است، ملکی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 830.25,
   "end": 833.03,
   "text": "این قدرت ملکی و دنیوی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 833.03,
   "end": 835.45,
   "text": "سرور مومنین قربونش بریم که فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 835.45,
   "end": 839.05,
   "text": "وقتی دروازه‌ی خیبرو کندم از جا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 839.05,
   "end": 844.19,
   "text": "مطلقا هیچ‌کدوم از اعضای بدن من دروازه رو حس نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 844.19,
   "end": 848.15,
   "text": "یعنی با قدرت پروردگارم کندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 848.15,
   "end": 853.45,
   "text": "با اون قدرت یقینم، نه با قدرت جسمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 853.45,
   "end": 857.43,
   "text": "بالقدرة الربانية لا بالقدرة الجسمانية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 857.43,
   "end": 859.45,
   "text": "حالا اینجا اینم همچین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 859.45,
   "end": 861.59,
   "text": "فهمید که قصه، قصه ملکوتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 861.59,
   "end": 867.49,
   "text": "بعد اومد اونجا وارد قصر بشه، قصر حضرت سلیمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 867.49,
   "end": 871.21,
   "text": "آبگینه‌ای که بود. حالا ایشون فکر کرد روده، نهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 871.21,
   "end": 873.87,
   "text": "کی؟ بلقیس فکر کرد اینجا نهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 873.87,
   "end": 876.27,
   "text": "این روایت میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 876.27,
   "end": 881.17,
   "text": "این حالا به قول ما پاچه‌هاشو مثلا دامنشو بالا گرفت که خیس نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 881.17,
   "end": 885.39,
   "text": "نه گفت آبگینه‌ایه. یعنی اونجا گمان می‌کنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 885.39,
   "end": 888.91,
   "text": "روده. روش حضرت سلیمان گفت حرکت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 888.91,
   "end": 890.89,
   "text": "تو چی-- خیس نمی‌شی، حرکت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 890.89,
   "end": 897.75,
   "text": "این حرکت کرد. عجیبه. اصلا داره حرکت می‌کنه روی آب و اینجا آبگینه است اصلا یک عظمتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 897.75,
   "end": 902.03,
   "text": "باز متوجه شد که اینجا سفر کرده از ملک به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 902.03,
   "end": 905.73,
   "text": "یعنی این عبور کردن‌ها خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 905.73,
   "end": 910.13,
   "text": "رفقا من همه‌ی این زورو زدم که هم یک کلیتی پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 910.13,
   "end": 913.83,
   "text": "خبر، موضوع خبر و اقسامش عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 913.83,
   "end": 919.35,
   "text": "که برگردیم به آیه که این قلب منغمر که بی‌خبر است از چی بی‌خبر است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 919.35,
   "end": 921.47,
   "text": "از چه اخباری بی‌خبر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 921.47,
   "end": 923.39,
   "text": "که حالا انشاالله یک یک عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 923.39,
   "end": 931.47,
   "text": "دو اینکه متوجه باشیم تا از ظاهر به باطن، چقدر ما اینو تاکید کردیم بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 931.47,
   "end": 934.81,
   "text": "آموزه‌ها و مشرب از تعلم حسن زاده علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 934.81,
   "end": 938.67,
   "text": "تا از ظاهر به باطن سفر نکنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 938.67,
   "end": 942.83,
   "text": "ما بی‌خبریم از اون خبرهای عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 942.83,
   "end": 945.21,
   "text": "خبرهای قطعی اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 945.21,
   "end": 948.61,
   "text": "بله. شرع دین پوسته دینه، ظاهر دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 948.61,
   "end": 952.01,
   "text": "اینم خبر میده. خبر میده اما این خبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 952.01,
   "end": 954.41,
   "text": "قطعی هست لکن عمیق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 954.41,
   "end": 957.37,
   "text": "اگرچه همه‌ی معارف در طول هم‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 957.37,
   "end": 959.99,
   "text": "اونام زیربناشون همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 959.99,
   "end": 962.81,
   "text": "عرفان زیربناش همینه. عرفان از قرآن دراومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 962.81,
   "end": 964.93,
   "text": "قرآن از قرآن دراومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 964.93,
   "end": 967.15,
   "text": "چیزی جو-- اینا یک حقیقتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 967.15,
   "end": 969.39,
   "text": "اما تا از ظاهر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 969.39,
   "end": 973.99,
   "text": "باطن سفر نکنی، از-- یعنی در حقیقت حضرت سلیمان در این قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 973.99,
   "end": 978.29,
   "text": "داره بلقیس رو همون ابتدا عبورش میده از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 978.29,
   "end": 980.65,
   "text": "توجه کردی چی شد؟ که باخبر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 980.65,
   "end": 983.79,
   "text": "تا باخبر نشی به یقین نمی‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 983.79,
   "end": 988.31,
   "text": "لذا یقین و اون برد الیقین که از تعلم میگه خنک شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 988.31,
   "end": 992.47,
   "text": "وجود به یقین، اولش از علم الیقین شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 992.47,
   "end": 995.13,
   "text": "از باخبری شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 995.13,
   "end": 997.29,
   "text": "علم الیقین می‌شه عين الیقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 997.29,
   "end": 999.81,
   "text": "بعد حق الیقین. بعد برد الیقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 999.81,
   "end": 1002.25,
   "text": "از باخبری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1002.25,
   "end": 1005.91,
   "text": "امروز داشتم درس چهل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1005.91,
   "end": 1009.77,
   "text": "سوم از دروس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1009.77,
   "end": 1012.49,
   "text": "ممتد الهمم از تعلم حسن زاده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1012.49,
   "end": 1016.21,
   "text": "با بیان شریف خودشون گوش می‌دادم صبح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1016.21,
   "end": 1020.89,
   "text": "ایشون فرمودن که از مشایخ‌شون-- از م-مشایخمون براتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1020.89,
   "end": 1023.75,
   "text": "هدیه‌ای تقدیم کنم. خیلی شیرین بود برام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1023.75,
   "end": 1029.27,
   "text": "فرمود مشایخ ما گفتن ابن عربی علیه الرحمه در فسوسش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1029.27,
   "end": 1040.17,
   "text": "در این فسوس باعظمتش که واقعا اندیشمندان عالم رو متحیر خودش کرده و هشتصد میلیون مرید الان تو دنیا داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1040.17,
   "end": 1043.41,
   "text": "مشت مشت، مشت مشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1043.41,
   "end": 1048.25,
   "text": "عرفان رو، مشت مشت علم رو، مشت مشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 281,
   "start": 1048.25,
   "end": 1052.01,
   "text": "حقیقت رو آورده ریخت می‌ریزه تو کام شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 282,
   "start": 1052.01,
   "end": 1055.99,
   "text": "در فتوحاتش دامن دامن آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 283,
   "start": 1055.99,
   "end": 1059.35,
   "text": "حالا ما چقدر بی‌خبریم از اون مشت مشتش هم بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 284,
   "start": 1059.35,
   "end": 1064.71,
   "text": "چه برسه دامن به دامن. انشاالله بحث رو ادامه می‌دیم که ببینیم چه خبره تو این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 285,
   "start": 1064.71,
   "end": 1069.83,
   "text": "عاقبتمون انشاالله ختم بخیر باشد به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 286,
   "start": 1069.83,
   "end": 1074.67,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}