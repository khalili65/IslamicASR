 "chapters": [
  {
   "index": 0,
   "title": "## استفتاء؛ حضور زنان در جماعت و جمعه",
   "start": 0.68,
   "end": 227.26
  },
  {
   "index": 1,
   "title": "## شعور عالم و حروف به‌مثابه موهبت",
   "start": 227.26,
   "end": 327.66
  },
  {
   "index": 2,
   "title": "## کلمهٔ یازدهم؛ معاش وسیلهٔ مقامات معنوی",
   "start": 327.66,
   "end": 731.86
  },
  {
   "index": 3,
   "title": "## آیهٔ عبث نبودن خلقت",
   "start": 731.86,
   "end": 832.65
  },
  {
   "index": 4,
   "title": "## مسافر ایم نه مقیم؛ از داری به دار",
   "start": 832.65,
   "end": 1020.37
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.68,
   "end": 4.86,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.86,
   "end": 8.9,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.9,
   "end": 12.34,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.34,
   "end": 16.84,
   "text": "آیا شارع مقدس زنان رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.84,
   "end": 22.34,
   "text": "مثل مردان به شرکت در نماز جماعت و مساجد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.34,
   "end": 28.16,
   "text": "یا نمازهای جمعه و اینها تشویق کرده یا اینکه نماز خوندن اون‌ها در خونه بهتره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.16,
   "end": 31.4,
   "text": "چون مرسوم بین مردم و تعارف است که میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.4,
   "end": 35.88,
   "text": "زن باید در خانه نماز بخونه و مسجدش خانه است و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.88,
   "end": 44.9,
   "text": "رهبر عزیزمون فرمودن که شرکت زنان در نماز جمعه و جماعت اشکال ندارد و ثواب جماعت دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.9,
   "end": 49.18,
   "text": "اما خدای منّان رو شاکرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.18,
   "end": 55.46,
   "text": "تفضل فرمودن و به بنده حقیر این فرصت و توفیق رو دادن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.46,
   "end": 60.84,
   "text": "در ادامه مبحث قلب در قرآن در محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.84,
   "end": 63.7,
   "text": "عزیزانی باشم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.7,
   "end": 66.9,
   "text": "غالباً اهل علم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.9,
   "end": 70.46,
   "text": "دانش و فضیلت‌اند یا دانشگاه خوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.46,
   "end": 75.62,
   "text": "یا حوزه خوندن یا مشغول‌اند یا فارغ التحصیل شدن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.62,
   "end": 80.4,
   "text": "بله؟ بعضی هم هر دو تا رو خوندن استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.4,
   "end": 84.14,
   "text": "بله. می فرمایند که بعضی هم هر دو تا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.14,
   "end": 86.5,
   "text": "یعنی هم حوزه درس خوندن هم دانشگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.5,
   "end": 90.14,
   "text": "در هر حال خدای منّان رو شاکریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.14,
   "end": 97.88,
   "text": "از اینکه یه همچین سفره‌ای پهن شده و امیدواریم که شما هم اهل تحقیق و پژوهش باشید هممون و صرفاً نشنویم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.88,
   "end": 100.86,
   "text": "از این گوش بشنویم و از اون گوش به در کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.86,
   "end": 103.08,
   "text": "و وقت خودمون و دیگران رو تلف کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.08,
   "end": 110.42,
   "text": "بحث ما در جایی که متوقف شده بودیم پیرامون قلب منغمر بود، قلب بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.42,
   "end": 113.22,
   "text": "و اونجا عرض شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.22,
   "end": 116.26,
   "text": "یکی از خطرات جدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.26,
   "end": 122.18,
   "text": "و بسیار متأسفانه امروزه پررنگی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.18,
   "end": 126.88,
   "text": "جامعه بشری وجود دارد بی‌خبری از خود، از عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.88,
   "end": 129.92,
   "text": "پیرامون خود، از درون خود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.92,
   "end": 133.96,
   "text": "اصلاً از این نظام هستی، از خود دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.96,
   "end": 138.44,
   "text": "و اینکه اصلاً اینجا کجا هست که ما آمدیم و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.44,
   "end": 143.04,
   "text": "که اجمالاً به صورت سر فصلی و کلی مطالبی قبلاً عرض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.04,
   "end": 147.44,
   "text": "عزیزان که نبودن پیگیر باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.44,
   "end": 151.46,
   "text": "خب یکی از چیزهایی که بسیار می‌طلبه که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.46,
   "end": 153.7,
   "text": "از اون باخبر باشیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.7,
   "end": 158.96,
   "text": "قلبمون رو از غفلت نسبت به اون و بی‌خبری نسبت به اون حفظ کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.96,
   "end": 163.24,
   "text": "اصلاً خود همین دنیا معاش مادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.24,
   "end": 166.58,
   "text": "و آنچه که به عنوان رزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.58,
   "end": 174.94,
   "text": "دنیوی نصیب ما شده، اصلاً حیات دنیوی ما، حیات ذاتی ما، حیات مزاجی ما، صرف حیات ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.94,
   "end": 179.08,
   "text": "اینکه ما در این دنیا اومدیم، اصلاً در این نشئہ طبیعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.08,
   "end": 184.22,
   "text": "این کثرات اینها همه که روایات می‌فرماید که همه اینها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.22,
   "end": 188.48,
   "text": "برای انسان خلق کردم یا قرآن می‌فرماید و هو الذي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.48,
   "end": 192.18,
   "text": "هو الذي سخر لکم ما فی الارض جمیعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.18,
   "end": 197.14,
   "text": "خب اینها اگر بر تسخیر دست ماست و اینها برای ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.14,
   "end": 199.5,
   "text": "خب نگاه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.5,
   "end": 205.72,
   "text": "به این مع-- عذر شود معاش مادی، نگاه ما به این دنیا، به این کثرات، به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.72,
   "end": 209.28,
   "text": "مواهب الهی، اینها چگونه باید باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.28,
   "end": 214.1,
   "text": "یعنی ما خبری که از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.1,
   "end": 219.7,
   "text": "پیرامون خودمون، دنیایی که درش زندگی می‌کنیم می‌گیریم، این خبر چگونه باید باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 219.7,
   "end": 222.36,
   "text": "ما از این در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.36,
   "end": 224.9,
   "text": "وسائل چگونه بهره بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.9,
   "end": 226.8,
   "text": "اینها را چگونه ببینیم اصلاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.8,
   "end": 234.08,
   "text": "اولاً به یک معنا که أم من شيء إلا یسبح بحمده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.08,
   "end": 238.66,
   "text": "قرآن می‌فرماید هیچ چیزی نیست مگر اینکه تسبیح حق می‌گوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 238.66,
   "end": 245.1,
   "text": "یا و کل فی فلك یسبحون همه چی در یک مدار خاصی، در یک جریان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.1,
   "end": 248.7,
   "text": "یک ریل‌گذاری و طریق و سبیل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.7,
   "end": 252.42,
   "text": "به‌هرحال یک مدار خاصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.42,
   "end": 255.12,
   "text": "شناگر است. پس همه چی شعور دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.12,
   "end": 257.92,
   "text": "جهان پیرامون ما هم شعور دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.92,
   "end": 264.0,
   "text": "حتی همین حروفی که حالا در بحث لقاء الله اونجا شب‌های جمعه در یا زهراي شرق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.0,
   "end": 267.46,
   "text": "عرض شد و هنوز هم مشغولیم به فضل الهی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.46,
   "end": 272.92,
   "text": "حتی این حروفی هم که می‌بینیم اینها هم نازل شده‌اند و اینها هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.92,
   "end": 280.66,
   "text": "در خودشون معانی رو در بر دارن که برای ما موهبت، موهبت الهی حتی این حروف موهبت الهی هستند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 280.66,
   "end": 284.24,
   "text": "از ازدواجشون کلمات و از ازدواج اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.24,
   "end": 289.96,
   "text": "که و خلقکم ازواجا یا سبحان الذي خلق الازواج کلها همه اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 289.96,
   "end": 296.08,
   "text": "مزدوج‌اند. از ازدواج کلمات، جملات، مفاهیم، موضوعات بی‌نهایت الا ماشاءالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 296.08,
   "end": 298.18,
   "text": "تسهیل فهم ما بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 298.18,
   "end": 304.64,
   "text": "همه اینها آیاتند مجالی أنذالاً به یک معنا تشؤناتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 304.64,
   "end": 306.7,
   "text": "تعیینات حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 306.7,
   "end": 310.6,
   "text": "حق‌اند. انه الحق اینا همه یتبین حتى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 310.6,
   "end": 315.04,
   "text": "یتبین لهم انه الحق همون آیه پنجاه و سه سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 315.04,
   "end": 318.42,
   "text": "فصلت است که بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 318.42,
   "end": 321.26,
   "text": "خیلی مورد دقت بزرگان قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 321.26,
   "end": 326.16,
   "text": "توصیه می‌کنم به این آیه. حالا به هر حال اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 326.16,
   "end": 328.3,
   "text": "اتفاقاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 328.3,
   "end": 335.78,
   "text": "کلمه یازده یادم هست در کلمه یازده صد کلمه در معرفت نفس از علامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 335.78,
   "end": 345.48,
   "text": "اونجا می‌شون می‌فرمودند که اون کسی که معاش مادی رو وسیله مقامات معنوی نگیره سخت در خطاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 345.48,
   "end": 349.7,
   "text": "یعنی اصلاً این معاش مادی، این زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 349.7,
   "end": 356.82,
   "text": "عیش دنیوی، این معایش ما همه وسیله‌اند برای مقامات معنوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 356.82,
   "end": 362.8,
   "text": "و نگاهی که ما به این دنیا داریم یعنی اون خبری که ما از پیرامون خودمون می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 362.8,
   "end": 368.28,
   "text": "باید خبری باشد این، این خبر را عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 368.28,
   "end": 371.44,
   "text": "خبری که از دنیای پیرامونمون رو می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 371.44,
   "end": 374.8,
   "text": "که به عنوان وسیله‌ای در خدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 374.8,
   "end": 377.3,
   "text": "مقامات معنوی قرار بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 377.3,
   "end": 381.12,
   "text": "که اتفاقاً اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 381.12,
   "end": 386.18,
   "text": "یه فرمایشی مولامون علی علیه الصلاة والسلام دارن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 386.18,
   "end": 390.92,
   "text": "خطبه‌ی هشتاد و دو نهج‌البلاغه اگر اشتباه نکنم، اونجا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 390.92,
   "end": 395.24,
   "text": "بفرمایین ببینید بررسی کنید که حضرت می‌فرمودند که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 395.24,
   "end": 400.18,
   "text": "و من أبصر بها بصرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 400.18,
   "end": 408.16,
   "text": "بحث دنیا رو که حضرت مطرح می‌کنند می‌فرمایند که کسی که دنیا رو وسیله‌ی بصیرتش قرار بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 408.16,
   "end": 410.48,
   "text": "بینا می‌شه. بینا می‌سازتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 410.48,
   "end": 415.06,
   "text": "چی؟ این دنیا اگر وسیله باشد اینجا رو دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 415.06,
   "end": 418.06,
   "text": "و من أبصر إليها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 418.06,
   "end": 420.04,
   "text": "إليها أعمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 420.04,
   "end": 422.64,
   "text": "الله اکبر از این فرمایش مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 422.64,
   "end": 430.42,
   "text": "که کسی که إليها أبصر إليها به دنیا نگاه کنه یعنی دنیا بشه هدفش نابیناش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 430.42,
   "end": 432.2,
   "text": "أعمته کورش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 432.2,
   "end": 434.72,
   "text": "که اتفاقاً سید رضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 434.72,
   "end": 438.52,
   "text": "علیه رحمة در شرح این کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 438.52,
   "end": 444.2,
   "text": "شگرف امیرالمؤمنین صلی الله علیه می‌فرمود که و إذا تأمل المتأمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 444.2,
   "end": 448.74,
   "text": "قوله علیه السلام یعنی اگر اهل تأمل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 448.74,
   "end": 451.74,
   "text": "تأمل کنند، دقت کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 451.74,
   "end": 457.6,
   "text": "ذره‌بین بذارن، عمیق بشن در این کلام مولا که فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 457.6,
   "end": 462.26,
   "text": "و من أبصر بها بصرته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 462.26,
   "end": 464.9,
   "text": "فرمود، فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 464.9,
   "end": 471.86,
   "text": "سید رضی وجد تحته من المعنی العجيب والغرض البعید میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 471.86,
   "end": 475.04,
   "text": "پیدا می‌کنه در ذیل این جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 475.04,
   "end": 478.2,
   "text": "یه معنای عجیب و یک غرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 478.2,
   "end": 482.0,
   "text": "بسیار بعید و دور از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 482.0,
   "end": 484.58,
   "text": "فهم ما رو که لا تبلغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 484.58,
   "end": 488.74,
   "text": "غايته ولا يدرك غوره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 488.74,
   "end": 494.08,
   "text": "نمی‌شه اون انتهاش و و اون عمقش رو درک کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 494.08,
   "end": 499.62,
   "text": "لا سيما إذا قرن إليه قوله مخصوصاً وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 499.62,
   "end": 504.58,
   "text": "نزدیک بشی به این قول که و من أبصر إليها أعمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 504.58,
   "end": 510.6,
   "text": "اینجا دیگه اگر کسی می‌فرمود اگر کسی نگاهش دنیا بشه یعنی نگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 510.6,
   "end": 512.46,
   "text": "دنیا بشه هدفش نه وسیله‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 512.46,
   "end": 519.9,
   "text": "این دیگه سید رضی می‌فرمود فإنه يجد الفرق بين أبصر بها و أبصر إليها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 519.9,
   "end": 521.86,
   "text": "دیگه وقتی که مخصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 521.86,
   "end": 528.0,
   "text": "وقتی توجه می‌کنی به فرقی که اینجا مولا با این عبارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 528.0,
   "end": 534.18,
   "text": "بیان کردن أبصر بها تو جمله‌ی اول و أبصر إليها جمله‌ی دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 534.18,
   "end": 539.96,
   "text": "أبصر بها یعنی به اون نگاه کنی یعنی دن-- با دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 539.96,
   "end": 543.82,
   "text": "آخرت رو نگاه کنی. یعنی دنیا وسیله بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 543.82,
   "end": 545.94,
   "text": "أبصر إليها یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 545.94,
   "end": 548.66,
   "text": "به اون، به اون سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 548.66,
   "end": 553.4,
   "text": "نگاه کنی. أبصر بها با دنیا آخرت رو نگاه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 553.4,
   "end": 557.96,
   "text": "أبصر إليها به دنیا نگاه کنی دنیا بشه هدف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 557.96,
   "end": 565.08,
   "text": "بعد سید رضی می‌فرمود واضحا نيرا وعجيبا باهرا صلوات الله وسلامه عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 565.08,
   "end": 567.46,
   "text": "یعنی حیرت، احساس حیرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 567.46,
   "end": 571.78,
   "text": "اقرار به حیرت می‌کنه نسبت به این کلام مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 571.78,
   "end": 575.18,
   "text": "که واقعاً عجيبا غريباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 575.18,
   "end": 578.88,
   "text": "قربان این دهان پاک مولامون علی امیر بیان برویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 578.88,
   "end": 583.6,
   "text": "بله که اینجا مشخص می‌کنه دیگه نگاه ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 583.6,
   "end": 588.26,
   "text": "به دنیا که ما قلبمون بی‌خبر نباشد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 588.26,
   "end": 593.58,
   "text": "این دنیا که اصلاً و اساساً این دنیا برای چه خلق شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 593.58,
   "end": 595.58,
   "text": "این دنیای پیرامون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 595.58,
   "end": 597.88,
   "text": "و ما چرا در این نشئه قرار گرفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 597.88,
   "end": 603.18,
   "text": "مثل بچه‌ای که تصور بفرمایید در رحم مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 603.18,
   "end": 605.78,
   "text": "خب دست داره، گوش داره، پا داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 605.78,
   "end": 611.08,
   "text": "نمی‌دونم چشم داره، خب اینا زبان داره، اینا قواش اگرچه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 611.08,
   "end": 620.4,
   "text": "حالت منه‌ند، استعدادند هنوز بالفعل نشده اما بالاخره داره این اش-- این عرض شود اعضا رو جوارح و جوانح رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 620.4,
   "end": 623.08,
   "text": "خب ایشون اگر بی‌خبره از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 623.08,
   "end": 626.3,
   "text": "آخرتش که به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 626.3,
   "end": 630.92,
   "text": "نشئه طبیعت برای بچه‌ای که در رحمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 630.92,
   "end": 634.01,
   "text": "مرحله‌ی بعدیش می‌شود نشئه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 634.01,
   "end": 637.04,
   "text": "اگر بی‌خبر باشه از نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 637.04,
   "end": 645.12,
   "text": "احساس پوچی نمی‌کنه؟ نمیگه خب این دست و پا و چشم و گوش و اینا به چه درد من می‌خوره الان در این تنگنای رحم مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 645.12,
   "end": 648.02,
   "text": "که از طریق بند ناف هم دارم تزریق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 648.02,
   "end": 651.4,
   "text": "ارتزاق می‌کنم و خون مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 651.4,
   "end": 654.08,
   "text": "به قولی رزق من شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 654.08,
   "end": 657.66,
   "text": "خب دیگه این اعضا و جوارح من به چه درد من می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 657.66,
   "end": 660.54,
   "text": "چون بی‌خبر از این نشئه طبیعته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 660.54,
   "end": 664.0,
   "text": "و ناشکری می‌کنه و توجه به این آیات نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 664.0,
   "end": 668.6,
   "text": "به این‌هایی که بعداً چه وسائط و وسائل فیضی‌اند براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 668.6,
   "end": 673.02,
   "text": "و این چنین. دقیقاً همچین چیزی اگر ما خبر نداشته باشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 673.02,
   "end": 678.96,
   "text": "این اعضا و جوارح خود ما و اعضا و جوارح دنیای پیرامون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 678.96,
   "end": 682.12,
   "text": "برای چه تعبیه شده، این‌ها در آینده به چه کار میان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 682.12,
   "end": 685.3,
   "text": "این‌ها وسیله‌هایی هستند که ما در آینده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 685.3,
   "end": 687.76,
   "text": "با این‌ها به سمت حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 687.76,
   "end": 690.6,
   "text": "حرکت می‌کنیم. یعنی الان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 690.6,
   "end": 693.24,
   "text": "ال-الان با این وسایل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 693.24,
   "end": 695.84,
   "text": "حرکت می‌کنیم به سمت حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 695.84,
   "end": 698.48,
   "text": "و این‌ها رو فدا میدیم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 698.48,
   "end": 701.18,
   "text": "مقامات معنوی به قول استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 701.18,
   "end": 703.52,
   "text": "و اگر این بی‌خبری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 703.52,
   "end": 706.48,
   "text": "در وجود ما باشه که بیچاره می‌کنه ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 706.48,
   "end": 712.56,
   "text": "سوره صد و-- سوره مؤمنون آیه صد و پونزده می‌فرماید أفحسبتم أنما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 712.56,
   "end": 716.34,
   "text": "أفحسبتم آیا گمان می‌کنید شما که أنما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 716.34,
   "end": 720.54,
   "text": "خلقناکم عبثا که ما شما رو بیهوده آفریدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 720.54,
   "end": 723.3,
   "text": "وأنكم إلينا لا ترجعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 723.3,
   "end": 727.14,
   "text": "و شما گمان می‌کنید که شما به سوی ما رجعت نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 727.14,
   "end": 729.64,
   "text": "یعنی إنا إليه راجعون بی‌خوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 729.64,
   "end": 735.72,
   "text": "والعياذ بالله که واقعاً بزرگان ذیل این آیه فرمودند که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 735.72,
   "end": 738.08,
   "text": "حالا همین آیه کوتاه یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 738.08,
   "end": 743.02,
   "text": "مبرهن‌ترین آیات و مشخص‌ترین و آشکارترین آیات بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 743.02,
   "end": 747.0,
   "text": "پیرامون حیات اخروی، صره بحث رجعت رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 747.0,
   "end": 754.53,
   "text": "اما می‌فرمایند که همین آیه داره نشون میده که اگر آخرتی نبود، قيامتی نبود، دنیای پس از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 754.53,
   "end": 759.91,
   "text": "دو-دنیا هم برزخ و قیامت و آخرتی پس از این دنیا نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 759.91,
   "end": 762.93,
   "text": "خب زندگی پوچ بود، عبث بود، بیهوده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 762.93,
   "end": 771.17,
   "text": "اما هست که بیهوده نیست و قرآن می‌فرماید که شما فکر می‌کنید بیهوده است \"وأنكم إلينا لاترجعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 771.17,
   "end": 774.03,
   "text": "خب این نگاه رو دقت بفرمایید اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 774.03,
   "end": 779.63,
   "text": "یه وقت انسان غافل باشه از این نگاه و متوجه نباشه به حقیقت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 779.63,
   "end": 781.87,
   "text": "دنیای پیرامونی خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 781.87,
   "end": 784.89,
   "text": "چقدر گرفتار میشه، چقدر بیچاره میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 784.89,
   "end": 789.17,
   "text": "در حقیقت از دنیا مزرعه الآخره رو وقتی نفهمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 789.17,
   "end": 793.83,
   "text": "وقتی غافل باشه، بی‌خبر باشه از اینکه الان در مزرعه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 793.83,
   "end": 798.93,
   "text": "و شخم نزنه زمین رو، بذر رو نپاشه یا اگر می‌پاشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 798.93,
   "end": 801.87,
   "text": "عرض شود براش کود نریزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 801.87,
   "end": 808.01,
   "text": "این‌ها رو بهش رسیدگی نکنه، آفت‌زدایی نکنه، سم نزنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 808.01,
   "end": 810.99,
   "text": "نمی‌دونم این‌ها رو رسیدگی نکنه به این مزرعه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 810.99,
   "end": 816.03,
   "text": "بعد آخرت می‌خواد برداشت کنه این با مواجه با چه برداشتی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 816.03,
   "end": 818.79,
   "text": "یعنی اون برداشتی که می‌خواد بکنه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 818.79,
   "end": 822.43,
   "text": "پوچ، هیچ و یه سرابی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 822.43,
   "end": 826.59,
   "text": "یک خطر جدی‌ست که اگر ما ابد در پیش داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 826.59,
   "end": 829.95,
   "text": "عزیزان دلم وقتی ابد در پیش داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 829.95,
   "end": 832.65,
   "text": "باید به فکر باشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 832.65,
   "end": 836.77,
   "text": "متأسفانه غالب انسان‌ها حتی ما هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 836.77,
   "end": 840.81,
   "text": "اگر خیلی دقت کنیم می‌بینیم اینطوری هستیم بعضاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 840.81,
   "end": 847.27,
   "text": "که غالب انسان‌ها بنا به فرمایش مولامون علی علیه الصلاة و السلام گرفتار همون ظواهر دنیا هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 847.27,
   "end": 849.87,
   "text": "حتی حضرت استاد همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 849.87,
   "end": 856.57,
   "text": "در اون کلمه یازدهم می‌فرماید که این معاش مادی باید وسیله مقامات معنوی بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 856.57,
   "end": 859.27,
   "text": "مقامات معنوی. در حالی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 859.27,
   "end": 865.49,
   "text": "مقامات دنیایی رو تازه بحث حالات رو هم نه، بلکه مقامات دنیایی رو پیش می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 865.49,
   "end": 870.13,
   "text": "انگار که ما قراره در این دنیا مستقر باشیم و برای همیشه اینجا بمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 870.13,
   "end": 872.75,
   "text": "در حالی که مسافریم. یک پلی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 872.75,
   "end": 875.93,
   "text": "پل ارتباطی‌ست. \"إنما تنتقلون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 875.93,
   "end": 878.89,
   "text": "من دارٍ إلى دار\". ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 878.89,
   "end": 882.29,
   "text": "یعنی منتقل می‌شیم، ما رو منتقل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 882.29,
   "end": 887.31,
   "text": "اون ملائکه نقاله به قولی ما رو منتقل می‌کنند از یک داری به دار دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 887.31,
   "end": 890.03,
   "text": "همونطور که از نشئه مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 890.03,
   "end": 893.93,
   "text": "که رحم مادر بود منتقل شدیم به این نشئه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 893.93,
   "end": 898.53,
   "text": "به همین وضع هم ما منتقل می‌شیم از این نشئه، از نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 898.53,
   "end": 900.71,
   "text": "عرض شود ملک به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 900.71,
   "end": 903.35,
   "text": "همینطور نشئه پشت نشئه ما منتقل می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 903.35,
   "end": 906.17,
   "text": "حالا برای این انتقال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 906.17,
   "end": 908.59,
   "text": "چگونه خودمون رو آماده کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 908.59,
   "end": 911.83,
   "text": "و این عدم آمادگی ما عزیزان به جهت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 911.83,
   "end": 914.65,
   "text": "بی‌خبری ما، بی‌خبری ما از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 914.65,
   "end": 922.83,
   "text": "عرض شود دنیای پیرامون خودمون و از این دنیایی که ابزار و وسیله رشد و ارتقای وجودی ما هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 922.83,
   "end": 926.03,
   "text": "قرآن هی ندای تعال و سر می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 926.03,
   "end": 927.61,
   "text": "اقرأ و اقرأ سر می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 927.61,
   "end": 930.77,
   "text": "اما اهل بیت علیهم الصلاة و السلام می‌فرمایند بخوان بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 930.77,
   "end": 934.51,
   "text": "اما چه کنیم که ما وقتی بی‌خبریم چه بخوانیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 934.51,
   "end": 937.15,
   "text": "چه بخوانیم وقتی بی‌خبریم؟ اقرأ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 937.15,
   "end": 941.21,
   "text": "بخوان. چه بخوانم؟ \"بسم ربك الذي خلق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 941.21,
   "end": 943.33,
   "text": "وقتی من اسم خدا رو نمی‌دونم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 943.33,
   "end": 946.07,
   "text": "پروردگار خودم رو نمی‌شناسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 946.07,
   "end": 951.29,
   "text": "و اصلاً خبری از خلقت و مبنای خلقت ندارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 951.29,
   "end": 954.37,
   "text": "چگونه بخوانم؟ چی رو اصلاً بخوانم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 954.37,
   "end": 956.67,
   "text": "کتاب وجودی خودم رو چگونه بخوانم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 956.67,
   "end": 960.27,
   "text": "کتاب وجودی و کتاب آفاقی رو چگونه بخوانم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 960.27,
   "end": 964.91,
   "text": "کتاب کسب شده قرآن رو چگونه بخوانم وقتی خبری ندارم و بی‌خبرم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 964.91,
   "end": 968.47,
   "text": "حالا انشاالله به وقتش عرض می‌کنیم یک یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 968.47,
   "end": 970.25,
   "text": "انشاالله خدا به ما رحم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 970.25,
   "end": 972.11,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 972.11,
   "end": 975.13,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 975.13,
   "end": 984.51,
   "text": "محمد. اللهم صل و سلم على الرسول و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 984.51,
   "end": 987.65,
   "text": "آل النبي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 987.65,
   "end": 990.25,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 990.25,
   "end": 992.37,
   "text": "و سلم على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 992.37,
   "end": 994.97,
   "text": "الرسول و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 994.97,
   "end": 999.33,
   "text": "آل النبي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 999.33,
   "end": 1004.43,
   "text": "اللهم صل و سلم على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
