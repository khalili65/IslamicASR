 ],
 "cues": [
  {
   "i": 0,
   "start": 0.58,
   "end": 4.56,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.56,
   "end": 9.56,
   "text": "السلام علیک یا داعی الله و ربانیة آیاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.56,
   "end": 11.34,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.34,
   "end": 15.6,
   "text": "شرکت زنان مثل مردان در نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.6,
   "end": 19.82,
   "text": "پرسیدن که از جهت استحباب و کراهت چه حکمی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.82,
   "end": 22.84,
   "text": "رهبر عزیزمون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.84,
   "end": 27.1,
   "text": "بی اشکال است یعنی کراهت هم ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.1,
   "end": 33.66,
   "text": "همچنین پرسیدن که شرکت اون‌ها در صورتی که پشت سر مردان بایستند چه حکمی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.66,
   "end": 37.22,
   "text": "آیا در حالی که پشت سر مردان هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.22,
   "end": 41.64,
   "text": "برای نماز جماعت ایستادن احتیاج به پرده و ساتر هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.64,
   "end": 46.42,
   "text": "رهبر عزیزمون فرمودن اگر پشت سر مردان بایستند احتیاجی به حائل و پرده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.42,
   "end": 50.12,
   "text": "ولی اگه کنار مردان بایستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.12,
   "end": 54.54,
   "text": "سزاواره که حائلی بین اون‌ها باشه تا کراهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.54,
   "end": 57.18,
   "text": "کنار هم ایستادن مردان و زنان در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.18,
   "end": 60.66,
   "text": "هم-- مردان و زنان در نماز جماعت برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.66,
   "end": 64.7,
   "text": "اینا وقتی کنار هم بایستن شونه به شونه اینا دیگه کراهت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.7,
   "end": 69.58,
   "text": "اینجا باید سزاوار اینه که پرده بخوره که اون کراهت برداشته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.58,
   "end": 75.06,
   "text": "خب بحث ما در قلب منغمر بود و داشتیم عرض می‌کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.06,
   "end": 81.92,
   "text": "چقدر مهم است که انسان باخبر باشد از این نظام آفاقی و هستی و دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.92,
   "end": 87.64,
   "text": "حالا این بحث باخبر شدن از خودش، کتاب وجودی خودش یه بحثه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.64,
   "end": 90.56,
   "text": "که انشاالله بحثش خواهد آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.56,
   "end": 97.34,
   "text": "اما باخبر شدنش از دنیای پیرامونش، این نظام آفاقی که به یک معنا عرض شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.34,
   "end": 101.88,
   "text": "یکی از اون تجلیات حضرت حق به نحو قرآن آفاقی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.88,
   "end": 111.32,
   "text": "قرآن هستی است که و فی الارض آیات للمؤمنین للمؤمنین و فی انفسکم افلا تبصرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.32,
   "end": 114.96,
   "text": "آیات فکر می‌کنم بیست و بیست و یک واقعه باشه اگر اشتباه نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.96,
   "end": 118.02,
   "text": "همونجا می‌فرماید و فی الارض آیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.02,
   "end": 123.26,
   "text": "آیات البته للمؤمنین برای اهل یقین در زمین آیات هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.26,
   "end": 130.98,
   "text": "آیات این ان فی خلق السماوات والارض واختلاف الليل والنهار لآيات لاولى الالباب این آیه هان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.98,
   "end": 136.06,
   "text": "سنريهم آياتنا آياتنا في الآفاق في الآفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.06,
   "end": 139.76,
   "text": "و في انفسهم حتى يتبين لهم انه الحق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.76,
   "end": 142.44,
   "text": "ببین همه آیات، آیات نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.44,
   "end": 144.66,
   "text": "پس این نظام هم نظام آ–",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.66,
   "end": 149.46,
   "text": "آیاتند. آیه فقط آیه اونی نیست که در قرآن کتب شده می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.46,
   "end": 153.98,
   "text": "این‌ها هم آیات‌اند. لذا اگر حکما و عرفا فرمودن این هم قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.98,
   "end": 157.04,
   "text": "آفاقی‌ست یا به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.04,
   "end": 162.12,
   "text": "شرح عینی انسان کامل است که قرآن ناطق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.12,
   "end": 164.44,
   "text": "این می‌شود شرح عینی‌ش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.44,
   "end": 170.34,
   "text": "عرض شود قرآن می‌شود شرح کتبی انسان کامل که اون قرآن ناطق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.34,
   "end": 172.02,
   "text": "این پس این هم قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.02,
   "end": 173.76,
   "text": "این قرآن عینی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.76,
   "end": 176.26,
   "text": "قرآن عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.26,
   "end": 178.0,
   "text": "ایان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.0,
   "end": 179.74,
   "text": "قرآن اعیان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.74,
   "end": 181.58,
   "text": "قرآن آفاقی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.58,
   "end": 185.62,
   "text": "قرآن هستی‌ست. خب ما اگر بی‌خبر باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.62,
   "end": 190.9,
   "text": "میشه همون به یک معنا بی‌خبری از قرآن به نحو آفاقیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.9,
   "end": 196.44,
   "text": "و عرض شد که چقدر بده. ما باید بدونیم که اصلاً چرا اومدیم به این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.44,
   "end": 199.52,
   "text": "سر بودن ما در این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.52,
   "end": 203.22,
   "text": "و نحوه بهره‌برداری ما از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.22,
   "end": 206.7,
   "text": "آلات و ابزار و وسایل چگونه باید باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.7,
   "end": 211.98,
   "text": "که امیرالمؤمنین علیه الصلاة والسلام فرمودند در نهج البلاغه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.98,
   "end": 218.46,
   "text": "از دنیا خلق برای غیر ها چقدر این حدیث شریفه، چقدر این فرمایش مولامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.46,
   "end": 221.44,
   "text": "جای بحث و کار داره. من به شما اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.44,
   "end": 230.18,
   "text": "خبره، اهل علم، اهل فضل، دانشجویان و طلاب عزیزی که اینجا حضور دارید توصیه می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.18,
   "end": 233.86,
   "text": "روی این احادیث کار کنید، شخم بزنید به باطنش پی ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.86,
   "end": 237.3,
   "text": "صرفاً به بدن این احادیث توجه نکنید فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.3,
   "end": 241.84,
   "text": "از دنیا خلق برای غیر ها ولم تخلق لنفسها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.84,
   "end": 245.22,
   "text": "مولا علیه الصلاة والسلام فرمودند که دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.22,
   "end": 248.88,
   "text": "برای حقیقت دیگری آفریده شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.88,
   "end": 252.46,
   "text": "خلق برای غیر ها برای غیر از خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.46,
   "end": 255.66,
   "text": "برای غیر از این حقیقت خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.66,
   "end": 259.48,
   "text": "که شما می‌بینید آفریده شده نه برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.48,
   "end": 262.82,
   "text": "خویشتن. یعنی ولم تخلق لنفسها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.82,
   "end": 266.6,
   "text": "یعنی دنیا برای نفس خودش، برای خودش خلق نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.6,
   "end": 269.34,
   "text": "پیداست که دنیا یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.34,
   "end": 271.98,
   "text": "عرض شود وسیله‌ایه، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.98,
   "end": 277.98,
   "text": "وسیله‌ای برای یک پلی‌ست که انسان از روش رد شه از وسایلش استفاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.98,
   "end": 282.5,
   "text": "رو پل رد میشی، رد شی بتونی از روی این پل رد شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.5,
   "end": 286.26,
   "text": "دستتو بگیری به این مثلاً دیواره‌های پل این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.26,
   "end": 288.8,
   "text": "با آرامش و استحکام البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.8,
   "end": 291.78,
   "text": "با استقامت حرکت کنی، رد شی پرت نشی از پل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.78,
   "end": 296.58,
   "text": "اینا بالاخره نگاه ما به این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.58,
   "end": 303.9,
   "text": "ابد ما رو می‌سازه که ما نگاهمون خیلی مهمه که اگر ما به این دنیا نگاهمون متفاوت بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.9,
   "end": 305.9,
   "text": "به نسبت تفاوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.9,
   "end": 310.0,
   "text": "نگاه ما از اون معیار، از اون شاخص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.0,
   "end": 315.28,
   "text": "که اهل بیت علیهم الصلاة والسلام مشخص کردن به نسبت انحراف و اعوجاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.28,
   "end": 319.32,
   "text": "نگاه ما از اون شاخص و از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 319.32,
   "end": 325.78,
   "text": "طریق و از اون نگاهی که باید به این دنیا داشته باشیم، به همون نسبت اب-ابد ما دستخوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.78,
   "end": 331.28,
   "text": "متأسفانه غرامت‌های سنگین قرار می‌گیره و اعوجاج و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.28,
   "end": 335.78,
   "text": "دوری از حضرت حق. که به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 335.78,
   "end": 339.22,
   "text": "ما در اینجا دائماً آن به آن در حال آزمایشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.22,
   "end": 344.66,
   "text": "اگر کسی بی‌خبر باشد که در حال آزمایش و امتحان است خب امتحانش رو بد میده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.66,
   "end": 347.68,
   "text": "یه مثلاً یه پ-- چیزی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 347.68,
   "end": 350.5,
   "text": "آزمونی رو تصور کنید گذاشتن جلوی شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.5,
   "end": 354.84,
   "text": "شما بی‌خبری که این آزمونه همینجوری داری می‌خونی رد میشی اصلاً جوابی هم نمیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.84,
   "end": 358.9,
   "text": "پرت و پلا می‌نویسی. اصلاً توا-توجهت به این آزمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.9,
   "end": 361.56,
   "text": "با کسی دیگه صحبت می‌کنی. اصلاً حواست به آزمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.56,
   "end": 365.0,
   "text": "بعد میگه آقا وقت آزمون تموم شد برگه‌ها رو تحویل بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.0,
   "end": 368.7,
   "text": "خب من اصلاً نمی‌دونستم باید اینجا چی می‌نوشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.7,
   "end": 371.38,
   "text": "اصلاً این‌ها چی بود ها بی خبریه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.38,
   "end": 374.82,
   "text": "این چه کاریه انسان من مثال می‌زنم برای سهولت فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.82,
   "end": 377.84,
   "text": "که اتفاقاً در خطبه دویست و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.84,
   "end": 381.52,
   "text": "نهج‌البلاغه مولامون علی علیه الصلاة والسلام فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.52,
   "end": 383.98,
   "text": "\"ففیها اختبرتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.98,
   "end": 385.98,
   "text": "ولغیرها خلقتم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.98,
   "end": 388.7,
   "text": "چقدر شیرین، چقدر عالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.7,
   "end": 392.14,
   "text": "که می‌فرماید شما در دنیا آزمایش می‌شوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.14,
   "end": 394.94,
   "text": "\"ففیها اختبرتم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.94,
   "end": 399.12,
   "text": "اینجا آزمایش می‌شوید \"ولغیرها خلقتم\" در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.12,
   "end": 401.16,
   "text": "برای غیر اون آفریده شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.16,
   "end": 404.76,
   "text": "یعنی قراره که اینجا آزمونی بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 404.76,
   "end": 408.14,
   "text": "نسبت به نمره هم ب-تون برید تو اون رتبه‌ها قرار بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.14,
   "end": 411.44,
   "text": "قرار شما جای دیگه‌ست. آسایش شما جای دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.44,
   "end": 413.9,
   "text": "در یک حدیث قدسی م-مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.9,
   "end": 416.6,
   "text": "شیخ حر عاملی علیه الرحمه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.6,
   "end": 420.5,
   "text": "اگر در خاطرم مونده باشه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.5,
   "end": 424.86,
   "text": "جواهر السنیه فی احادیث قدسیه ایشون خیلی سال‌های پیش دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.86,
   "end": 429.04,
   "text": "که خدای منان به حضرت موسی کلیم الله صلی الله علیه می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 429.04,
   "end": 431.92,
   "text": "من پنج چیز رو در پنج جا قرار دادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.92,
   "end": 436.44,
   "text": "در حالی که مردم در پنج جای دیگه به دنبال این پنج چیزن و هیچ‌وقت به این‌ها نمی‌رسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 436.44,
   "end": 440.0,
   "text": "یکیش فرمود آسایش و آرامش رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.0,
   "end": 446.7,
   "text": "بعد از مرگ در آخرت و قیامت و این‌ها قرار دادم در حالی که مردم در دنیا دنبالش می‌گردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.7,
   "end": 449.52,
   "text": "و این خیلی بده که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.52,
   "end": 451.94,
   "text": "متأسفانه اینچنین شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.94,
   "end": 457.9,
   "text": "و همون بحثی که عرض شد که نگاه ما، نگاه ما وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.9,
   "end": 461.56,
   "text": "اشتباه شد این مشکلات پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.56,
   "end": 463.92,
   "text": "خیلی مهمه که نگاه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 463.92,
   "end": 465.98,
   "text": "به این پیرامون خودمون چگونه باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 465.98,
   "end": 471.72,
   "text": "اتفاقاً در-- ببینید نگاهی که مثلاً خدای منان در حدیث معراجیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.72,
   "end": 477.06,
   "text": "در اون حدیث شریف معراجیه در بحار مرحوم مجلسی علیه الرحمه آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.06,
   "end": 485.42,
   "text": "نگاهی رو که خدای منان، خدای تبارک و تعالی به پیغمبر عزیزش میده که اونجا در اون متن حدیث می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 485.42,
   "end": 490.82,
   "text": "\"روی فی حدیث المعراج قال الله تبارک وتعالی یا احمد هل اد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 490.82,
   "end": 494.0,
   "text": "هل تدری ای عیش ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 494.0,
   "end": 496.86,
   "text": "ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.86,
   "end": 499.02,
   "text": "عیش اهنع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.02,
   "end": 502.56,
   "text": "وای حیاة ابقی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.56,
   "end": 507.5,
   "text": "دقت بفرمایید خدا داره به پیغمبر چه نگاهی میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.5,
   "end": 510.38,
   "text": "آیا می‌دونی که کدوم زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.38,
   "end": 514.9,
   "text": "و کدوم حیات باقی و بهتر و برترند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.9,
   "end": 518.58,
   "text": "قال اللهم پیغمبر فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 518.58,
   "end": 521.9,
   "text": "عرض کردند که اللهم لا خدایا نه من نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 521.9,
   "end": 526.14,
   "text": "ادب فرمودند. قال الله تبارک وتعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.14,
   "end": 529.34,
   "text": "تبارک وتعالی. خدا فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.34,
   "end": 532.42,
   "text": "خدای تبارک و تعالی فرمودند که \"اما العیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.42,
   "end": 538.48,
   "text": "الحنیع\" اون عیشی گواراست \"فهو الذي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.48,
   "end": 541.5,
   "text": "لا یغتر صاحبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 541.5,
   "end": 544.5,
   "text": "عن ذکری و لا ینسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 544.5,
   "end": 548.26,
   "text": "نعمتی\". می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 548.26,
   "end": 554.32,
   "text": "اون زیستی پایدارتره، اون زیستی خوشگوارتره، اون زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 554.32,
   "end": 556.46,
   "text": "شیرین‌تره به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 556.46,
   "end": 559.26,
   "text": "که هیچگاه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.26,
   "end": 562.8,
   "text": "ذکر و یاد من سست نشه بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 562.8,
   "end": 566.24,
   "text": "و البته و هیچگاه نعمت منو فراموش نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 566.24,
   "end": 573.72,
   "text": "\"لا ینسی نعمتی\" نعمت منو فراموش نکنه \"و لا یجهل حقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 573.72,
   "end": 576.46,
   "text": "یطلب الرضای فی لیلة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.46,
   "end": 578.94,
   "text": "فی لیله و نهاره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 578.94,
   "end": 581.18,
   "text": "و فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 581.18,
   "end": 585.76,
   "text": "اون زندگی شیرین‌تره در ادامه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.76,
   "end": 591.02,
   "text": "هیچگاه نسبت به حق من جاهلی و نادانی نکنه بنده هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 591.02,
   "end": 598.32,
   "text": "و البته شب و روزش اون شب و روزی که وقتی داره به بنده می‌گذره پی چی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 598.32,
   "end": 604.0,
   "text": "در اون شب و روز؟ فرمودند که \"یطلب الرضای\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 604.0,
   "end": 611.24,
   "text": "که این حق من بر بندگانمه که در شب و روز رضایت منو تجسس کنند، تفحص کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 611.24,
   "end": 617.94,
   "text": "\"و اما الحیاة الباقیه فهي التي يعمل لنفسه حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 617.94,
   "end": 623.46,
   "text": "تهون علیه الدنيا و تسخر في عینه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.46,
   "end": 627.1,
   "text": "تأظم الآخرة عنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 627.1,
   "end": 629.62,
   "text": "و يؤثر هواء على هواه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 629.62,
   "end": 638.22,
   "text": "الله اکبر. \"و یبتغي مرضاتی و یعظم حق عظمتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 638.22,
   "end": 642.12,
   "text": "و یذكر علمي به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 642.12,
   "end": 649.1,
   "text": "و یراقبني بالليل و النهار عند کل سیئة أو معصیة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 649.1,
   "end": 651.14,
   "text": "حالا این مرحوم مجلسی شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 651.14,
   "end": 653.12,
   "text": "حدیث رو مفصل آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 653.12,
   "end": 659.82,
   "text": "که اونجا حضرت حق می‌فرماید که در این مسیری که داره میره برای کسب رضایت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 659.82,
   "end": 662.36,
   "text": "دیگه حواسش باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 662.36,
   "end": 664.92,
   "text": "دنیا تو چشمش کوچیک باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.92,
   "end": 667.04,
   "text": "\"تسخر فی عینه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 667.04,
   "end": 671.2,
   "text": "دنیا در چشمش کوچیک باشه البته و \"تأظم الآخرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 671.2,
   "end": 673.74,
   "text": "عنده\" این آخرت نزدش چی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 673.74,
   "end": 677.3,
   "text": "عظیم باشه. \"یؤثر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 677.3,
   "end": 679.58,
   "text": "يؤثر هواء على هواه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 679.58,
   "end": 682.0,
   "text": "این هوای من و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 682.0,
   "end": 691.7,
   "text": "هوای من و اتفاقاً چه جالب و شیرین که تنها جایی که قرآن هوا رو هوا میگیم هوای نفس هوا رو جایز دونسته هوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 691.7,
   "end": 699.3,
   "text": "الهی رو. یعنی میگی دلم هوای کربلا کرده مثلاً هوس کربلا به سرم زده اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 699.3,
   "end": 702.72,
   "text": "اینجا خدا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 702.72,
   "end": 709.62,
   "text": "پی چی باشه؟ این هوای من، هوای من رو بر هوای خودش ترجیح بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 709.62,
   "end": 712.34,
   "text": "و حالا دنبال رضایت من باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 712.34,
   "end": 715.66,
   "text": "عظمت من رو ببینه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 715.66,
   "end": 718.16,
   "text": "علم من رو متذکر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 718.16,
   "end": 722.96,
   "text": "یاد من کنه، مراقب باشه شب و روز مخصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 722.96,
   "end": 730.18,
   "text": "کی مراقبت کنه؟ \"عند کل سیئة أو معصیة\" وقتی معصیتی پیش میاد، گناهی پیش میاد، اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 730.18,
   "end": 732.54,
   "text": "خیلی اهل مراقبه باشه. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 732.54,
   "end": 737.58,
   "text": "شما همینجا الان متوجه می‌شید اگر کسی این نگاه رو نداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 737.58,
   "end": 740.26,
   "text": "این نگاه رو نداشت که دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 740.26,
   "end": 743.68,
   "text": "این چنین است. دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 743.68,
   "end": 746.14,
   "text": "یا نگاهش به دنیا باید چگونه باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 746.14,
   "end": 749.22,
   "text": "باید ببینید چه اتفاقی میفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 749.22,
   "end": 751.9,
   "text": "چه دگرگونی‌ای رخ میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 751.9,
   "end": 757.9,
   "text": "و چه کلاهی سر بنده میره و این اصلا دیگه قابل جبران نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 757.9,
   "end": 760.74,
   "text": "یعنی این بی‌خبریه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 760.74,
   "end": 766.16,
   "text": "اینکه این دنیا وسیله است و ما باید از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 766.16,
   "end": 773.92,
   "text": "برا-- در خدمت آخرت بگیریمش و از اون در مسیر رشد و تعالی خودمون استفاده کنیم بیچاره کننده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 773.92,
   "end": 778.22,
   "text": "یعنی واقعاً انسان اگر توجه به این نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 778.22,
   "end": 780.4,
   "text": "و واقعاً قابل جبران نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 780.4,
   "end": 782.72,
   "text": "واقعاً قابل جبران نیست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 782.72,
   "end": 786.28,
   "text": "معمولاً آدم‌هایی هم که گرفتار شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 786.28,
   "end": 789.46,
   "text": "توجه به این دنیا نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 789.46,
   "end": 791.8,
   "text": "حالا همون لب مطلب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 791.8,
   "end": 794.46,
   "text": "توجه نگاهشون به دنیا اشتباه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 794.46,
   "end": 797.24,
   "text": "لب مطلب اون که مولا فرمود دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 797.24,
   "end": 801.76,
   "text": "که دنیا رو وسیله ندونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 801.76,
   "end": 804.92,
   "text": "و این رو در حقیقت بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 804.92,
   "end": 806.88,
   "text": "برای آخرتت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 806.88,
   "end": 809.1,
   "text": "پایه‌ی آخرتت. اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 809.1,
   "end": 813.26,
   "text": "حالا در خاطرم اومد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 813.26,
   "end": 819.76,
   "text": "روزی حضرت موسی علی نبی و نوح آله و علیه الصلاة والسلام محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 819.76,
   "end": 824.72,
   "text": "خدای منان راز و نیاز می‌کردند و این‌ها بعد فارغ شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 824.72,
   "end": 828.5,
   "text": "ایشون رسیدند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 828.5,
   "end": 830.22,
   "text": "دربار یکی از پادشاهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 830.22,
   "end": 831.92,
   "text": "می‌خواستند ایشون رو موعظه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 831.92,
   "end": 836.28,
   "text": "حالا یادم نیست اون فرعون از اون فراعنه کدوم یکیشون بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 836.28,
   "end": 841.4,
   "text": "به هر حال به ایشون گفتند که اگر شما ببینید تمثیل و جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 841.4,
   "end": 847.16,
   "text": "اینکه بخواد تنبه خاطر در یک فرعونی ایجاد کنه، در یک پادشاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 847.16,
   "end": 851.34,
   "text": "زورمندی مثلاً. فرمودند که شما اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 851.34,
   "end": 854.5,
   "text": "به گونه‌ای تشنه بشی که به حال مرگ بیفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 854.5,
   "end": 860.26,
   "text": "بعد چقدر حاضری بدی که یه جرعه، یه نیم جرعه آب، یه نیم جرعه آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 860.26,
   "end": 863.9,
   "text": "بیاشامی. اون پادشاه، اون فرعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 863.9,
   "end": 867.7,
   "text": "عرض کرد که حاضرم نصف پادشاهیم رو بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 867.7,
   "end": 871.7,
   "text": "که یک جرعه، نیم جرعه آب بخورم از مرگ نجات پیدا کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 871.7,
   "end": 876.38,
   "text": "حضرت فرمود خب نصف پادشاهیتو دادی نیم جرعه آب رو خوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 876.38,
   "end": 879.62,
   "text": "بعد خب اقتضای وجود انسانه، بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 879.62,
   "end": 881.98,
   "text": "شما نیاز به تخلیه پیدا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 881.98,
   "end": 884.34,
   "text": "نیاز به مستراح پیدا کردی جسارتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 884.34,
   "end": 886.6,
   "text": "خب حالا هرچه می‌خوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 886.6,
   "end": 889.08,
   "text": "تخلی صورت بگیره نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 889.08,
   "end": 891.48,
   "text": "بعضاً هستن بعضی همچین مریضی می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 891.48,
   "end": 893.96,
   "text": "یکی از دوستان ما بود خدا شفا بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 893.96,
   "end": 895.68,
   "text": "از جانبازای جنگ بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 895.68,
   "end": 898.58,
   "text": "طفلی این مشکل رو بر اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 898.58,
   "end": 900.96,
   "text": "اون ار-- عارضه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 900.96,
   "end": 903.98,
   "text": "جنگی که براش در بدنش ایجاد شده بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 903.98,
   "end": 908.36,
   "text": "موج و این‌ها موج گرفته بودش، موج انفجار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 908.36,
   "end": 912.54,
   "text": "ایشون اینطوری شده بود بعضی موقع‌ها طفلی نمی‌تونست تخلیه انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 912.54,
   "end": 914.88,
   "text": "اون نجاسات از بدنش خارج نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 914.88,
   "end": 918.02,
   "text": "درد وحشتناکی به حد مرگ می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 918.02,
   "end": 921.78,
   "text": "واقعاً ما نمی‌دونیم خدا چه نعمت‌هایی به ما داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 921.78,
   "end": 926.16,
   "text": "چقدر به ما لطف کرده و همین معذرت می‌خوام همین که راه است راحت می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 926.16,
   "end": 928.42,
   "text": "همین. این‌ها به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 928.42,
   "end": 932.78,
   "text": "همین‌ها رو همین شئونات پس رو اگر دقت کنی برای خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 932.78,
   "end": 935.78,
   "text": "جایگاهی دارن. به هر حال فرمودند که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 935.78,
   "end": 939.38,
   "text": "شما این نیم جرعه آب رو خوردی دیگه نمی‌تونی تخلیه انجام بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 939.38,
   "end": 942.7,
   "text": "چقدر دیگه حاضری بدی که راحت شی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 942.7,
   "end": 948.28,
   "text": "اون فرعون گفت یا موسی حاضرم نصف دیگه پادشاهیم و بدم و راحت شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 948.28,
   "end": 953.2,
   "text": "بعد حضرت موسی چه شیرین فرمودند پس به پادشاهی این دنیا دل نبند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 953.2,
   "end": 955.94,
   "text": "که به یک نیم جرعه آب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 955.94,
   "end": 958.52,
   "text": "به یک راحت شدن می‌ارزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 958.52,
   "end": 962.28,
   "text": "الله اکبر. ببینید تنبه خاطر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 962.28,
   "end": 965.5,
   "text": "نه چوب و چماق گرفت بالا سر این فرعون نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 965.5,
   "end": 967.68,
   "text": "با تنبه خاطر با ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 967.68,
   "end": 973.42,
   "text": "یعنی با حکمت، با تمثیل که سرتاسر قرآن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 973.42,
   "end": 976.8,
   "text": "همین چنینه دیگه. \"تلک الامثال نضربها للناس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 976.8,
   "end": 979.6,
   "text": "البته \"لا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 979.6,
   "end": 983.0,
   "text": "يعقلها الا العالمون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 983.0,
   "end": 986.72,
   "text": "اون رو هم تا-تازه همین تمثیلات الهی رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 986.72,
   "end": 990.32,
   "text": "مثال‌هایی هم که خدا در قرآن می‌زنه کسی نمی‌فهمه مگر کیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 990.32,
   "end": 992.2,
   "text": "علما. اونایی که اهل علمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 992.2,
   "end": 994.48,
   "text": "به هر حال هستیتون نکنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 994.48,
   "end": 1000.4,
   "text": "پس این بی‌خبری از دنیا چنین کاری دست ما می‌ده و خیلی خطرناک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1000.4,
   "end": 1009.32,
   "text": "توصیه می‌کنم نگاهمون رو به دنیا دقیق کنیم بر اساس آیات و روایات نگاهمون رو به پیرامونمون و به این آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1009.32,
   "end": 1011.98,
   "text": "نظام هستی، نظام آفاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1011.98,
   "end": 1015.04,
   "text": "دقیق کنیم. خداوند به هممون رحم کنه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1015.04,
   "end": 1016.92,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}