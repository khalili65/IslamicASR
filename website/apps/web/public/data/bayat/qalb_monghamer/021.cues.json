 "chapters": [
  {
   "index": 0,
   "title": "## استفتاء نماز جمعه و اول وقت ظهرین",
   "start": 11.3,
   "end": 52.74
  },
  {
   "index": 1,
   "title": "## سورهٔ توحید و گسترهٔ معانی صمد",
   "start": 52.74,
   "end": 182.44
  },
  {
   "index": 2,
   "title": "## حدیث امیرالمؤمنین در تأویل صمد",
   "start": 182.44,
   "end": 297.7
  },
  {
   "index": 3,
   "title": "## ربط علمی؛ اتم اجوف و خدای صمد",
   "start": 297.7,
   "end": 682.6
  },
  {
   "index": 4,
   "title": "## ابجد سورهٔ اخلاص و مداومت بر الله الصمد",
   "start": 682.6,
   "end": 985.0
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 3.5,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.5,
   "end": 6.74,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.74,
   "end": 9.5,
   "text": "و ربانی آیاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.5,
   "end": 11.3,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.3,
   "end": 15.8,
   "text": "استفتاء دیگری که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.8,
   "end": 19.7,
   "text": "نماز جمعه شده از رهبر عزیزمون فر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.7,
   "end": 24.66,
   "text": "سؤال شده که کسی که توانایی رفتن به نماز جمعه رو نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.66,
   "end": 29.54,
   "text": "آیا می‌تونه نماز ظهر و عصرش رو اول وقت بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.54,
   "end": 34.76,
   "text": "یا اینکه باید صبر کنه تا نماز جمعه تموم بشه و بعد نماز ظهر و عصرش رو بخونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.76,
   "end": 37.2,
   "text": "چون مرسومه تو عموم مردم اینطوری میگن؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.2,
   "end": 40.04,
   "text": "میگن باید صبر کنین تا نماز جمعه تموم شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.04,
   "end": 42.38,
   "text": "رهبر عزیز فرمودن که ره--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 42.38,
   "end": 46.4,
   "text": "صبر کردن بر او واجب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.4,
   "end": 51.64,
   "text": "واجب نیست صبر کنه و می‌تونه نماز ظهر و عصرش رو اول وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.64,
   "end": 55.44,
   "text": "بخونه. در ادامه بحث قلب منقمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.44,
   "end": 58.38,
   "text": "می‌رسیم به یکی دیگه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 58.38,
   "end": 63.34,
   "text": "معجزات علمی قرآن که من خیلی دوست دارم این نکته رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.34,
   "end": 66.88,
   "text": "به جهت ارتباطش با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.88,
   "end": 72.78,
   "text": "آیه شریفه الله الصمد و این سوره خیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.78,
   "end": 78.48,
   "text": "خیلی شیرینه. سوره بسیار عجیبیه، پر رمز و رازیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.48,
   "end": 82.3,
   "text": "که حالا توجه داشته باشید عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.3,
   "end": 89.76,
   "text": "اولاً در روایات و کلمات مفسران و ارباب لغات و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.76,
   "end": 94.72,
   "text": "معانی زیادی پی ذیل صمد یا از صمد نقل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.72,
   "end": 98.44,
   "text": "مثلاً مرحوم راغب در المفرداتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.44,
   "end": 103.06,
   "text": "فرموده که صمد به معنی آقا و بزرگیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.06,
   "end": 106.6,
   "text": "برای انجام کارها به سوی او میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.6,
   "end": 111.98,
   "text": "بعضی‌ها دیگه گفتن که صمد به معنی چیزی که، چیزی‌ست که توخالی نیست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.98,
   "end": 115.92,
   "text": "کلاً پره. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.92,
   "end": 117.84,
   "text": "کتاب‌های لغت دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.84,
   "end": 120.24,
   "text": "گفتن صمد از دو ریشه اصلیه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.24,
   "end": 127.44,
   "text": "یکی به معنی قصد و دیگری به معنی صلابت و استحکامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.44,
   "end": 132.02,
   "text": "و اینکه به خدا صمد گفته می‌شه به خاطر اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.02,
   "end": 135.3,
   "text": "خب خ-- بندگان خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.3,
   "end": 137.42,
   "text": "قصد درگاه او رو می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.42,
   "end": 140.74,
   "text": "شاید به همین مناسبت هستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.74,
   "end": 152.98,
   "text": "معانی متعدد زیادی در کتب لغت بر صمد ذکر شده چون بندگان خدا در هر حال قصد حضرت حق رو می‌کنند و حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.98,
   "end": 155.52,
   "text": "اسامی متعددی دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.52,
   "end": 160.92,
   "text": "و شخص بزرگی که در منتهی عظمت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.92,
   "end": 165.8,
   "text": "و همچنین این‌ها معانی‌ایه که براش نقل شده تو کتب لغت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.8,
   "end": 172.06,
   "text": "یا کسی که مردم در حوائجشون به سوی اون میرن، حاجتشون به سمت اوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.06,
   "end": 175.78,
   "text": "یا کسی که برتر از او چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.78,
   "end": 182.44,
   "text": "یا کسی که دائم و باقی‌ست بعد از فنای همه خلائق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.44,
   "end": 186.56,
   "text": "اتفاقاً در حدیث جالبی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.56,
   "end": 191.96,
   "text": "محمد بن حنفیه هست که از امیرالمؤمنین علی علیه الصلاة والسلام در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.96,
   "end": 196.96,
   "text": "صمد سؤال کرد و حضرت چنین جواب دادند که تأویل صمد آن است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.96,
   "end": 199.7,
   "text": "او نه اسم است و نه جسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.7,
   "end": 204.86,
   "text": "نه مانند و نه شبیه دارد و نه صورت و نه تمثال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.86,
   "end": 207.12,
   "text": "نه حد و حدود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.12,
   "end": 209.42,
   "text": "نه محل و مکان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.42,
   "end": 213.26,
   "text": "نه کیف و نه اینجا و نه آنجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.26,
   "end": 217.86,
   "text": "نه پر است و نه خالی، نه ایستاده است و نه نشسته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.86,
   "end": 223.02,
   "text": "نه سکون دارد و نه حرکت، نه ظلمانی‌ست، نه نورانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.02,
   "end": 229.2,
   "text": "نه روحانی‌ست و نه نفسانی و در عین حال هیچ محلی از او خالی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.2,
   "end": 232.04,
   "text": "و هیچ مکانی گنجایش او را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.04,
   "end": 238.56,
   "text": "ندارد، نه رنگ دارد و نه بر قلب انسانی خطور کرده و نه بو برای او موجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.56,
   "end": 241.28,
   "text": "همه این‌ها از ذات پاکش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.28,
   "end": 244.88,
   "text": "منتفی‌ست. خب این فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.88,
   "end": 248.38,
   "text": "بسیار عالی مولامون علی امیر بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.38,
   "end": 256.12,
   "text": "صلوات الله علیه که به خوبی نشون می‌ده که صمد مفهوم بسیار جامع و وسیعی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.12,
   "end": 264.26,
   "text": "و البته هر گونه صفات مخلوقات رو از ساحت مقدس خدا نفی می‌کنه این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.26,
   "end": 275.84,
   "text": "چرا که خب اسم‌های مشخص و محدود و همچنین جسمیت مثل رنگ، بو، مکان، سکون، حرکت، کیفیت، حد، حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.84,
   "end": 277.56,
   "text": "و مانند اینا، اینا همه چی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.56,
   "end": 280.06,
   "text": "از صفات ممکنات و مخلوقاتن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 280.06,
   "end": 289.9,
   "text": "پس غالباً اوصاف جهان ماده و این‌ها می‌دونیم که از خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 289.9,
   "end": 294.14,
   "text": "به دور است و خدا برتر و بالاتر از این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 294.14,
   "end": 296.42,
   "text": "حالا چه بحثی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 296.42,
   "end": 303.24,
   "text": "اجازه، چه ربطی تو مبحث اجازه علمیمون می‌تونیم بدیم و بزرگان دادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 303.24,
   "end": 307.5,
   "text": "ببینید عزیزان در اکتشافاتی که رخ داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 307.5,
   "end": 314.52,
   "text": "تمام اشیای جهان ماده رو از ذرات بسیار کوچکی می‌دونید به نام اتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 314.52,
   "end": 319.24,
   "text": "گفتن تشکیل شده. خب این یکی از قطعیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 319.24,
   "end": 323.88,
   "text": "علمی‌ست دیگه که اتم هم خودش مرکب از دو قسمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 323.88,
   "end": 331.66,
   "text": "عمده‌ست البته. مثلاً هسته مرکزی و الکترون‌هایی که به دور اون هسته می‌چرخن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 331.66,
   "end": 338.76,
   "text": "عجیب اینجاست که بین اون هسته و الکترون‌ها فاصله زیادی وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 338.76,
   "end": 342.06,
   "text": "البته منظور از این فاصله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 342.06,
   "end": 344.2,
   "text": "فاصله زیاد که می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 344.2,
   "end": 347.54,
   "text": "در مقایسه با حجم اتمه توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 347.54,
   "end": 351.6,
   "text": "در مقایسه با حجمی که اتم داره این فاصله بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 351.6,
   "end": 354.74,
   "text": "الکترون‌ها و هسته خیلی زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 354.74,
   "end": 357.8,
   "text": "طوری که حالا اگر این فاصله رو بردارید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 357.8,
   "end": 363.26,
   "text": "این تصور کنید فاصله بین هسته ها و الکترون‌ها در اتم برداشته بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 363.26,
   "end": 369.12,
   "text": "اون موقع اجسام به قدری کوچک می‌شن که برای ما حیرت‌آورن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 369.12,
   "end": 377.06,
   "text": "که علم ثابت کرده که فاصله‌های اتمی ذرات وجود یک انسان را اگه برداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 377.06,
   "end": 382.6,
   "text": "و کاملاً به قولی فشرده‌اش کنی به قول امروزی‌ها کمپیتیش کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 382.6,
   "end": 386.2,
   "text": "ممکنه به صورت ذره‌ای در بیاد که حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 386.2,
   "end": 389.44,
   "text": "دیدنش با چشم مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 389.44,
   "end": 397.44,
   "text": "خب ولی با این حال میدونیم که تمام وزن بدن یک انسان رو در عین حال که کوچیک شده و دیدنش مشکله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 397.44,
   "end": 400.24,
   "text": "تمام وزن بدن یک انسان رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 400.24,
   "end": 403.46,
   "text": "مثلاً شصت کیلو وزن داره همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 403.46,
   "end": 406.74,
   "text": "ذره‌ای که غیر قابل دیدن میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 406.74,
   "end": 414.12,
   "text": "حالا بعضیا اومدن با استفاده از این اکتشاف علمی و با توجه به اینکه یکی از معانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 414.12,
   "end": 417.96,
   "text": "صمد وجودیه که توخالی و اجوف نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 417.96,
   "end": 421.04,
   "text": "چنین نتیجه گرفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 421.04,
   "end": 426.0,
   "text": "قرآن میخواد به این تعبیر هر گونه جسمانیتی رو از خدا نفی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 426.0,
   "end": 430.42,
   "text": "چرا که تمام اجسام از اتم تشکیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 430.42,
   "end": 433.76,
   "text": "یافتن و اتم هم که توخالیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 433.76,
   "end": 436.68,
   "text": "و به این ترتیب به این معنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 436.68,
   "end": 439.6,
   "text": "آیه میتونه یکی از معجزات علمی قرآن باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 439.6,
   "end": 444.3,
   "text": "چرا؟ به جهت اینکه صمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 444.3,
   "end": 446.32,
   "text": "در لغت به معنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 446.32,
   "end": 448.42,
   "text": "هم شخص بزرگیست که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 448.42,
   "end": 452.5,
   "text": "نیازمند به سوی او هستند و به سوی او میرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 452.5,
   "end": 457.22,
   "text": "و همچنین از هر نظر پر و کامله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 457.22,
   "end": 460.1,
   "text": "و همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 460.1,
   "end": 462.52,
   "text": "تعا-- ترجمه و معانی دیگه‌ای که گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 462.52,
   "end": 468.22,
   "text": "حالا شما اینو خودتون بیارید آنچه که ما الان عرض کردیم رو با توجه به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 468.22,
   "end": 474.68,
   "text": "موضوعی که پیرامون عرض شود اتم عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 474.68,
   "end": 478.28,
   "text": "خب بعضیا اینجا معتقدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 478.28,
   "end": 481.42,
   "text": "همین که عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 481.42,
   "end": 490.58,
   "text": "اتم از ذرات کوچک‌تری تشکیل شده که حداقل دو قسمت عمده داره بین هست-- مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 490.58,
   "end": 493.14,
   "text": "هسته مرکزی و الکترون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 493.14,
   "end": 495.88,
   "text": "و بین این‌ها فاصله زیاد هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 495.88,
   "end": 499.76,
   "text": "و اجوف هست. دقت بفرمایید چی عرض می‌کنم عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 499.76,
   "end": 504.58,
   "text": "اونایی که دارن مینویسن. اجوف هست، توخالی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 504.58,
   "end": 509.98,
   "text": "و خصوصا اینکه تمام این دایره امکانی و خلائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 509.98,
   "end": 513.66,
   "text": "از همین ذرات کوچک یعنی اتم‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 513.66,
   "end": 519.5,
   "text": "تشکیل شدن. پس همه این ذرات توخالی‌ان، اجوفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 519.5,
   "end": 522.78,
   "text": "حالا شما ببینید که خدا در این سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 522.78,
   "end": 525.9,
   "text": "چگونه خودش رو با اعجاز علمیش مطرح کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 525.9,
   "end": 529.0,
   "text": "خب اون موقع کسی نمی‌دونست که اتم چیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 529.0,
   "end": 535.06,
   "text": "این ذرات داخلش چین که حالا بینشون فاصله باشه، اجوف باشه، توخالی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 535.06,
   "end": 539.16,
   "text": "که اون ماده اولیه‌ای که جهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 539.16,
   "end": 544.34,
   "text": "خلقت ازش آفریده شدن همه توخالی هستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 544.34,
   "end": 549.58,
   "text": "همه اجوفن. همه ماد-مادیات، همه این کائنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 549.58,
   "end": 553.0,
   "text": "اینا همه به این شکلن. در نشئه طبیعت شما نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 553.0,
   "end": 558.54,
   "text": "بعد حالا خدای منان اومده خودش رو از صمد معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 558.54,
   "end": 561.28,
   "text": "یعنی پرپر که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 561.28,
   "end": 567.6,
   "text": "امام معصوم صلوات الله عليه پرسیدن در رساله اسم اعظم هست استاد علامه حسن زاده هم اومده این موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 567.6,
   "end": 570.64,
   "text": "که پرسیدن از صمد یعنی چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 570.64,
   "end": 576.0,
   "text": "اونجا حضرت فرمودن در ترجمه شریفی که \"الصمد الذي لا جوف له\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 576.0,
   "end": 579.68,
   "text": "صمد کسیه که توخالی نیست، پره پره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 579.68,
   "end": 581.7,
   "text": "و همه جا رو پر کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 581.7,
   "end": 584.14,
   "text": "مثلا جایی نیست که او نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 584.14,
   "end": 591.88,
   "text": "که اگر شما اپسیلون جایی رو پیدا کنید، کوچک‌ترین جایی رو پیدا کنید که ب-بگیم خدا اونجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 591.88,
   "end": 597.44,
   "text": "ها دیگه اینجا خدا از صمد نیست چون یه جایی رو پیدا کردید که خدا اونجا رو پر نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 597.44,
   "end": 602.0,
   "text": "پس خیلی شیرین متوجه میشیم که اون موقع خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 602.0,
   "end": 612.66,
   "text": "داره توجه خلائق همون موقع رو هم جلب میکنه به این موضوع که خدا اجوف نیست، توخالی نیست، پره پر است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 612.66,
   "end": 616.0,
   "text": "از صمد است و بلکه همه جا را پر کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 616.0,
   "end": 619.04,
   "text": "در مقایسه با این خلائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 619.04,
   "end": 623.5,
   "text": "که در حدیث شریف امیرالمؤمنین صلوات الله علیه خدای منان از همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 623.5,
   "end": 630.44,
   "text": "حد و حدود و اوو صفات خلائق دور و بری و خالی و برتر و بالاتر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 630.44,
   "end": 636.22,
   "text": "پس خدای منان داره اشاره به این میکنه که شما در ذرات پیرامونتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 636.22,
   "end": 643.14,
   "text": "اشیاء پیرامونتون، جهان پیرامونتون حتی در خودتون نگاه کنید همه و همه اجوفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 643.14,
   "end": 651.08,
   "text": "همه از اتم تشکیل شدن که درش ذرات فاصله زیادی نسبت به حجم اتم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 651.08,
   "end": 653.56,
   "text": "در حالی که خدا این چنین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 653.56,
   "end": 656.5,
   "text": "به همین زیبایی اینم یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 656.5,
   "end": 666.58,
   "text": "عرض شود. میشه گفت اعجاز علمی قرآن که انسان رو محکم میکنه که \"إن هذا القرآن\" این قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 666.58,
   "end": 669.42,
   "text": "\"يهدي للتي هي أقوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 669.42,
   "end": 676.48,
   "text": "أقوم. أقوم هدایت میکنه به سمت راهی که أقوم بر وزن افعل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 676.48,
   "end": 680.18,
   "text": "که همه کائنات به قیام او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 680.18,
   "end": 683.5,
   "text": "قائم‌اند. خب این البته در سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 683.5,
   "end": 693.0,
   "text": "اخلاص عرض شود بزرگان اهل معرفت و حالا محققین اینها نکات بسیار شیرینی خصوصا در بحث علم ارسماتیقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 693.0,
   "end": 697.12,
   "text": "و ابجد و اینها گفتن که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 697.12,
   "end": 701.04,
   "text": "الان دیگه فرصت نیست بنده بخوام بگم شاید تو یه جلسه جداگانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 701.04,
   "end": 704.58,
   "text": "عرض کردیم خدمتتون. چه شیرین، چه عجیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 704.58,
   "end": 707.68,
   "text": "که عهدی نمیتونه انکار کنه این‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 707.68,
   "end": 709.84,
   "text": "مثلا بگه نه این‌ها نیست چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 709.84,
   "end": 713.34,
   "text": "در تحقیقی که بزرگان کردن به چیزهای عجیبی رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 713.34,
   "end": 717.14,
   "text": "به هر حال سوره بسیار با عظمتی‌ست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 717.14,
   "end": 719.92,
   "text": "هنوزم که هنوزه برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 719.92,
   "end": 723.9,
   "text": "ما مکشوف نشده عظمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 723.9,
   "end": 728.5,
   "text": "درون مایه این سوره عجیب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 728.5,
   "end": 733.32,
   "text": "سوره قل هو الله احد که شناسنامه خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 733.32,
   "end": 735.96,
   "text": "حالا بعضی بزرگان فرمودن که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 735.96,
   "end": 742.3,
   "text": "کسی ناامید بود، هیچ امیدی به عملی شدن یه کاری نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 742.3,
   "end": 747.02,
   "text": "هزار بار بگه الله الصمد و به اذن خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 747.02,
   "end": 750.28,
   "text": "برگشت نداره، اجابت میشه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 750.28,
   "end": 753.02,
   "text": "یا مثلا امام باقر علیه السلام در یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 753.02,
   "end": 755.94,
   "text": "روایت خیلی عجیبی فرمودن که اگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 755.94,
   "end": 759.74,
   "text": "برای علمی که خدای متعال به من عطا کرده، یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 759.74,
   "end": 763.16,
   "text": "علمی که خدا به امام معصوم عطا کرده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 763.16,
   "end": 765.48,
   "text": "حضرت فرمودن اگه بخوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 765.48,
   "end": 768.04,
   "text": "یعنی جمله‌ای رو پیدا می‌کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 768.04,
   "end": 776.18,
   "text": "یعنی کسی بتونه بفهمه و تحمل کنه یعنی جمله‌ای رو می‌داشتم که کسی بتونه تحملش بکنه این علم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 776.18,
   "end": 779.62,
   "text": "یعنی این علمی که خدا به من داده در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 779.62,
   "end": 783.06,
   "text": "جمع شده باشه و مندمج شده هر آینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 783.06,
   "end": 788.42,
   "text": "منتشر می‌کردم. تمام خلائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 788.42,
   "end": 793.88,
   "text": "توحید و اسلام و ایمان و دین و شرائع رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 793.88,
   "end": 798.08,
   "text": "از الصمد از اسم الصمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 798.08,
   "end": 801.32,
   "text": "این رو یعنی بیان می‌کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 801.32,
   "end": 805.58,
   "text": "این، این جمله رو منتشر می‌کردم برای همه خلائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 805.58,
   "end": 807.8,
   "text": "که الصمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 807.8,
   "end": 812.2,
   "text": "همه علم درشه. حالا این هم رمز و رموزی داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 812.2,
   "end": 815.6,
   "text": "البته فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 815.6,
   "end": 818.88,
   "text": "مداومت بر اسم الصمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 818.88,
   "end": 820.98,
   "text": "به هر حال آثار تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 820.98,
   "end": 826.32,
   "text": "صمدانی حضرت حق رو داره که ظاهر میشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 826.32,
   "end": 832.04,
   "text": "فرمودن که از مرض جوع و گرسنگی و این‌ها انسان رو خلاص می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 832.04,
   "end": 836.76,
   "text": "و حالا عدد مکتوبه اش هم برای تکرار فرمودن صد و سی و چهار هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 836.76,
   "end": 841.2,
   "text": "اینها به هر حال رمز و رموزی، کنوزی، اسراری در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 841.2,
   "end": 845.64,
   "text": "این سر الصمد وجود داره و در این سوره عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 845.64,
   "end": 849.66,
   "text": "خیلی سوره عجیبیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 849.66,
   "end": 856.78,
   "text": "عرض شود گفتن شناسنامه خداست و چه شیرین که شصت و شش حرف داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 856.78,
   "end": 861.32,
   "text": "و جالب که ارزش ابجدی اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 861.32,
   "end": 865.16,
   "text": "جلاله الله هم شصت و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 865.16,
   "end": 869.36,
   "text": "و خب الله رو وقتی شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 869.36,
   "end": 873.06,
   "text": "این ارزش عددی شو به دست بیاری میشه پنج و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 873.06,
   "end": 875.28,
   "text": "سی و سی و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 875.28,
   "end": 878.1,
   "text": "اینا مجموعا میشه شصت و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 878.1,
   "end": 880.38,
   "text": "و خیلی عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 880.38,
   "end": 883.98,
   "text": "حالا اون نظم انباشتی حروف سوره توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 883.98,
   "end": 888.3,
   "text": "که عددش به دست بیاد مثلا یا خود سوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 888.3,
   "end": 890.86,
   "text": "حروف سوره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 890.86,
   "end": 900.9,
   "text": "عددی چهل رقمی میشه که حالا این عدد چهل رقمی به هفت قابل تقسیمه و الا ماشاءالله از این صحبت‌های عجیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 900.9,
   "end": 904.78,
   "text": "که حالا صد و چهارده سوره هم ما داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 904.78,
   "end": 907.56,
   "text": "که خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 907.56,
   "end": 912.82,
   "text": "صد و چهارده رو شما بخواهی بر هفت تقسیم کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 912.82,
   "end": 917.26,
   "text": "نوزده بار میشه. ببینید این ارتباطات اینا رو داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 917.26,
   "end": 923.48,
   "text": "نوزده بار بر هفت تقسیم میشه صد و چهارده که حالا این نوزده باز میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 923.48,
   "end": 928.12,
   "text": "تعداد حروف بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 928.12,
   "end": 930.68,
   "text": "که خیلی عجیب. چه عرض کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 930.68,
   "end": 936.02,
   "text": "انشاالله که خدای ممنون ما را از این قلب بی‌خبر، قلب منغمس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 936.02,
   "end": 941.36,
   "text": "بی‌خبر از باطن قرآن نجات بده که قبل از اینکه از این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 941.36,
   "end": 947.54,
   "text": "سفر کنیم به حقایقی از قرآن انشاالله آگاه بشیم، بچشیم، برسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 947.54,
   "end": 951.56,
   "text": "که اون دنیا فریاد واحسرتها سر ندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 951.56,
   "end": 955.18,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 955.18,
   "end": 963.46,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 963.46,
   "end": 970.72,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 970.72,
   "end": 979.08,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 979.08,
   "end": 985.0,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}