 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتا دربارهٔ نماز جمعه در عصر غیبت",
   "start": 16.84,
   "end": 74.3
  },
  {
   "index": 1,
   "title": "## قلب منغمر؛ بی‌خبری از قرآن",
   "start": 74.3,
   "end": 104.26
  },
  {
   "index": 2,
   "title": "## حرکت زمین و افق علمی عصر نزول",
   "start": 104.26,
   "end": 297.78
  },
  {
   "index": 3,
   "title": "## تاریخ بازکشف حرکت زمین",
   "start": 297.78,
   "end": 330.3
  },
  {
   "index": 4,
   "title": "## پیوند با قلب منغمر",
   "start": 330.3,
   "end": 351.5
  },
  {
   "index": 5,
   "title": "## خبیر بودن و مسئولیت عمل",
   "start": 351.5,
   "end": 973.59
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 4.98,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.98,
   "end": 9.02,
   "text": "السلام علیک ای داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.02,
   "end": 12.94,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.94,
   "end": 16.84,
   "text": "بریم سراغ استفتاهایی که پیرامون نماز جمعه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.84,
   "end": 19.9,
   "text": "از رهبر عزیزمون پرسیدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.9,
   "end": 22.48,
   "text": "نظر جناب عالی در رابطه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.48,
   "end": 29.32,
   "text": "شرکت در نماز جمعه با توجه به اینکه در عصر غیبت حضرت حجت هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.32,
   "end": 32.96,
   "text": "چیه؟ نظر شما چیه در این رابطه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.96,
   "end": 38.06,
   "text": "و همچنین اگر افرادی اعتقاد به عدالت امام جمعه ندارند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.06,
   "end": 43.54,
   "text": "آیا تکلیف شرکت در نماز جمعه از اونها ساقط میشه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.54,
   "end": 48.9,
   "text": "اینجا رهبر عزیزمون در جواب فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.9,
   "end": 54.02,
   "text": "هر چند نماز جمعه در عصر حاضر واجب تخییری است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.02,
   "end": 60.7,
   "text": "و حضور در اون واجب نیست، ولی با توجه به فواید و آثار شرکت در اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.7,
   "end": 69.66,
   "text": "سزاوار نیست که مؤمنین خودشونو از برکات حضور در نماز به مجرد تشکیک در عدالت امام جمعه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.66,
   "end": 73.46,
   "text": "عذرهای واهی دیگه محروم سازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.46,
   "end": 78.82,
   "text": "اما ادامه بحث قلب منغمر و بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.82,
   "end": 86.64,
   "text": "در بحث قرآن بودیم به جهت اینکه در آیه شصت و سه سوره مؤمنون تنها آیه‌ای که پیرامون قلب منغمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 86.64,
   "end": 92.3,
   "text": "سخن می‌گفت، بر اساس تفاسیر عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 92.3,
   "end": 94.74,
   "text": "معنوز-- منظور از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.74,
   "end": 100.56,
   "text": "چیزی که خدا در قرآن اشاره می‌کنه که قلوب اینها ازش بی‌خبره، قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.56,
   "end": 107.36,
   "text": "لذا اشاره کردیم به ظاهر و باطن قرآن و رسیدیم به بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 107.36,
   "end": 112.9,
   "text": "اعجازی که در ظاهر قرآن حتی دیده میشه به عنوان اعجاز علمی قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 112.9,
   "end": 119.06,
   "text": "البته نکته‌ای که امروز می‌خوایم عرض کنیم پیرامون حرکت زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 119.06,
   "end": 122.28,
   "text": "که صریحاً در قرآن اومده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 122.28,
   "end": 126.54,
   "text": "شاید از نظر بعضیا این اعجاز قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 126.54,
   "end": 131.1,
   "text": "حساب نشه چون اعجاز اون چیزیست که هیچکس نگفته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 131.1,
   "end": 133.08,
   "text": "در حالی که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 133.08,
   "end": 135.7,
   "text": "همین موضوع حرکت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.7,
   "end": 142.1,
   "text": "می‌دونیم که بعضیا قبل از اسلام هم گفته بودن اگرچه این فرضیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 142.1,
   "end": 145.34,
   "text": "از ذهن‌ها زائل شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 145.34,
   "end": 147.8,
   "text": "و اون نظریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 147.8,
   "end": 151.8,
   "text": "سکون زمین توسط بطلمیوس، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.8,
   "end": 154.9,
   "text": "خیلی ظهور کرده بود و اون مورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 154.9,
   "end": 158.32,
   "text": "اقبال واقع شده بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.32,
   "end": 162.86,
   "text": "در حقیقت اون نظریه حرکت زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.86,
   "end": 165.24,
   "text": "که قبل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.24,
   "end": 167.68,
   "text": "نظریه بطلمیوس بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.68,
   "end": 175.12,
   "text": "اون مغلوب شده بود به یک معنا که حالا خیلیا به اون تصریح داشتن مثل مثلاً فیثاغورس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.12,
   "end": 178.86,
   "text": "یا مثلاً فلوطخوس یا ارشمیدس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.86,
   "end": 181.7,
   "text": "استرخوس یا ساموسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.7,
   "end": 185.3,
   "text": "ایناها کلیانتن آسوسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.3,
   "end": 189.48,
   "text": "اینا بودن قبل از-- حالا دانشمندانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 189.48,
   "end": 194.44,
   "text": "قبل از فرضیه بطلمیوس قائل به حرکت بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.44,
   "end": 197.06,
   "text": "و اینا مربوط قبل از اسلام‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.06,
   "end": 201.92,
   "text": "این دو دیدگاهی که وجود داشت در محا-محاف-محافل علمی جهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.92,
   "end": 209.24,
   "text": "حالا که اونها قائل بودند به حرکت زمین اما بطلمیوس قائل بود به سکون زمین که مرکز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 209.24,
   "end": 213.42,
   "text": "جهان رو زمین فرض کرده بود که در سکون هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 213.42,
   "end": 218.08,
   "text": "اما خب اون دیدگاه حكما و علما و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 218.08,
   "end": 227.28,
   "text": "مغلوب شده بود و در اون زمانی که قرآن این نظریه رو داره بریا-- بیان می‌کنه و چنین آیاتی نازل میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 227.28,
   "end": 230.62,
   "text": "در حقیقت اون نظریه بطلمیوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 230.62,
   "end": 233.16,
   "text": "غالب شده بود و مشهور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 233.16,
   "end": 238.48,
   "text": "لذا قرآن خیلی شجاعانه و با صراحت برخلاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 238.48,
   "end": 242.18,
   "text": "اون نظریه غالب اون روز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 242.18,
   "end": 248.36,
   "text": "مطلب علمی و به حقی رو بیان می‌کنه که صدق این مطلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 248.36,
   "end": 252.62,
   "text": "بعدها به اثبات می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 252.62,
   "end": 255.7,
   "text": "لذا این خودش یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 255.7,
   "end": 258.6,
   "text": "در حقیقت همون حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 258.6,
   "end": 260.76,
   "text": "علمی قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.76,
   "end": 265.46,
   "text": "حالا به یک وجه حتی شاید بشه گفت اعجاز علمی قرآن باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 265.46,
   "end": 271.06,
   "text": "با توجه به وضع اون زمان، وضع حاکم بر اون زمان که در تاخ-تاریخ نقل می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 271.06,
   "end": 274.4,
   "text": "حالا بریم سراغ آیه. آیه هشتاد و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 274.4,
   "end": 277.36,
   "text": "سوره نمر و چه آیه زیبائیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.36,
   "end": 282.88,
   "text": "فرمود \"و تَرَى الْجِبَالَ تَحْسَبُهَا جَامِدَةً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 282.88,
   "end": 285.5,
   "text": "وَ هِيَ تَمُرُّ مَرَّ السَّحَابِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 285.5,
   "end": 289.52,
   "text": "خب مشخصه ظاهراً می‌فرماید شما کوه‌ها رو ساکن می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 289.52,
   "end": 292.12,
   "text": "تَرَى الْجِبَالَ، تَرَى الْجِبَالَ این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 292.12,
   "end": 296.84,
   "text": "کوه‌ها رو می‌بینید تَحْسَبُهَا جَامِدَةً گمان می‌کنید که اینا ساکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.84,
   "end": 303.68,
   "text": "وَ هِيَ تَمُرُّ در حالی که اینا حرکت می‌کنند مَرَّ السَّحَابِ مثل حرکت سحاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 303.68,
   "end": 309.7,
   "text": "یعنی ابر. این ابرهایی که در آسمان در حرکتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 309.7,
   "end": 313.58,
   "text": "خیلی جالبه که شما وقتی ابر رو نگاه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 313.58,
   "end": 318.76,
   "text": "گمان می‌کنی ثابته. اما وقتی دقت بهش می‌کنی می‌بینی نه، یه حرکت ریزی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 318.76,
   "end": 323.82,
   "text": "بعد که از نزدیک فیلم‌برداری کردن به چه سرعتی در حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 323.82,
   "end": 326.84,
   "text": "و جالبه که اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 326.84,
   "end": 329.8,
   "text": "خب کسی نرفته بود از نزدیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 329.8,
   "end": 335.26,
   "text": "ابرها رو ببینه که حرکت دارن، به سرعت دارن، ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 335.26,
   "end": 338.48,
   "text": "یا که اینطوری مثال بزنه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 338.48,
   "end": 342.0,
   "text": "یا عرض شود کوه‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 342.0,
   "end": 349.46,
   "text": "چه کسی مثلاً توجه داشت اصلاً به حرکت زمین که بخواد کوه همراه زمین حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 349.46,
   "end": 355.0,
   "text": "و ادامه آیه می‌فرماید \"صُنْعَ اللَّهِ الَّذِي أَتْقَنَ كُلَّ شَيْءٍ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 355.0,
   "end": 359.28,
   "text": "إِنَّهُ خَبِيرٌ بِمَا تَفْعَلُونَ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 359.28,
   "end": 364.31,
   "text": "که اشاره به صنعه محکم و قاطع الهی می‌کند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 364.31,
   "end": 367.39,
   "text": "باخبر بودن از آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 367.39,
   "end": 371.83,
   "text": "شما انجام می‌دهید. حالا اینا نکاتی داره که عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 371.83,
   "end": 376.31,
   "text": "خب در این آیه همونطور که مشاهده می‌کنید، قرآن در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 376.31,
   "end": 380.35,
   "text": "آیه به مسئله مبدا و معاد و نشانه‌های قدرت و عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 380.35,
   "end": 386.77,
   "text": "خدا در عالم هستی و اینها و همچنین حالا ظاهراً همونطور که اکثر تفاسیر میگن به حوادث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 386.77,
   "end": 391.11,
   "text": "مربوط به روز قیامت و اینها پرداخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 391.11,
   "end": 394.81,
   "text": "خیلی از مفسرین معتقدند که این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 394.81,
   "end": 397.03,
   "text": "مربوط به آستانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 397.03,
   "end": 400.55,
   "text": "رستاخیز و روز قیامت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 400.55,
   "end": 404.69,
   "text": "حالا معتقدند که به نظر و به د-- به زعم آنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 404.69,
   "end": 409.99,
   "text": "و به دلایل و براهینی که دارند معتقدند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 409.99,
   "end": 418.25,
   "text": "اون روز یعنی روز قیامت، زلزله‌ها، انفجارها و دگرگونی‌های عظیمی واقع میشه، کوه‌ها از هم متلاشی میشن و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 418.25,
   "end": 421.89,
   "text": "که در بسیاری از سور قرآن هم البته این صریحاً اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 421.89,
   "end": 427.03,
   "text": "اگرچه در حکمت متعالیه برای همه اینها تأویل دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 427.03,
   "end": 433.49,
   "text": "مثلاً ارز رو اینا رو زمین وجود انسان می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 433.49,
   "end": 435.81,
   "text": "حالا ما ورود به اون فعلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 435.81,
   "end": 439.95,
   "text": "ف-خیلی نمی‌کنیم و ما معتقدیم که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 439.95,
   "end": 442.21,
   "text": "زمین و زمان این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 442.21,
   "end": 444.13,
   "text": "برقرار خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 444.13,
   "end": 451.91,
   "text": "چرا که اینا به حق آفریده شدن لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 451.91,
   "end": 453.57,
   "text": "از بین رفتنی نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 453.57,
   "end": 456.87,
   "text": "چه لزومی داره اینها منفجر بشن، از بین برن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.87,
   "end": 460.65,
   "text": "تخریب بشن که مثلاً قراره حساب کتاب یه عده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 460.65,
   "end": 464.01,
   "text": "رخ بده. نه، این رو ما در حکمت این رو نمی‌پذیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 464.01,
   "end": 466.97,
   "text": "اما حالا بر اساس تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 466.97,
   "end": 470.45,
   "text": "اکثر مفسرین این مربوط به اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 470.45,
   "end": 475.81,
   "text": "حالا با د-دلایلی ما ثابت می‌کنیم که نه، مربوط به، به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 475.81,
   "end": 479.13,
   "text": "به روز رستاخیز و اینها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 479.13,
   "end": 488.33,
   "text": "که در خود همین آیه‌ای که مورد بحث ماست، آیه هشتاد و هشت سوره نمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 488.33,
   "end": 494.43,
   "text": "دلایلی وجود داره که تأیید می‌کنه تفسیر دیگری رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 494.43,
   "end": 501.09,
   "text": "که در حقیقت در این آیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 501.09,
   "end": 506.79,
   "text": "آیه توحیدی‌ست و نشانه‌های عظمت خدا رو در همین دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 506.79,
   "end": 510.03,
   "text": "داره بیان می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 510.03,
   "end": 515.09,
   "text": "اینکه حرکت کره زمین برای ما محسوس نیست، اشاره داره به همین موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 515.09,
   "end": 523.09,
   "text": "حالا مثلاً نکته اولی که در آیه بیان شده اینکه می‌فرماید گمان می‌کنید کوه‌ها جامدن و ساکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 523.09,
   "end": 526.43,
   "text": "در حالی که همچون ابر در حرکتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 526.43,
   "end": 529.67,
   "text": "معلومه که این تعبیر با حوادث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 529.67,
   "end": 533.25,
   "text": "آغاز روز قیامت سازگار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 533.25,
   "end": 535.37,
   "text": "چرا؟ به این جهت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 535.37,
   "end": 539.69,
   "text": "اگر حالا بپذیریم نظرات مفسرین رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 539.69,
   "end": 545.07,
   "text": "روز قیامت قراره یه همچو اتفاق عجیب و سهمگینی رخ بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 545.07,
   "end": 552.51,
   "text": "خب به قدری اون حوادث آشکاره به تعبیر قرآن که می‌فرماید مادران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 552.51,
   "end": 558.21,
   "text": "کودکان شیرخوار خودشونو فراموش می‌کنند، زنان باردار سقط جنین می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 558.21,
   "end": 562.43,
   "text": "مردم از شدت وحشت مثل آدمای مست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 562.43,
   "end": 565.37,
   "text": "و حیران این ور اون ور تلوتلو می‌خورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 565.37,
   "end": 569.77,
   "text": "خب این سازگار نیست با اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 569.77,
   "end": 574.29,
   "text": "بگیم که شما مثلاً گمان می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 574.29,
   "end": 578.35,
   "text": "کوه‌ها ساکنن در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 578.35,
   "end": 582.15,
   "text": "یعنی یه امر مبهمی باشه قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 582.15,
   "end": 585.73,
   "text": "این حرکت کوه‌ها مبهم باشه برای عده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 585.73,
   "end": 589.35,
   "text": "باید دقت کنن تا متوجه حرکت کوه‌ها بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 589.35,
   "end": 591.75,
   "text": "پس مربوط به لحظه قیامت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 591.75,
   "end": 595.05,
   "text": "همین الان همین قصه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 595.05,
   "end": 600.29,
   "text": "و نکته بعدی تشبیه به حرکت ابرها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 600.29,
   "end": 602.53,
   "text": "این هم متناسب با یک حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 602.53,
   "end": 605.61,
   "text": "نرم و بدون سر و صدا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 605.61,
   "end": 609.93,
   "text": "به تعبیر تفسیر نمونه آقای مکارم یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 609.93,
   "end": 614.25,
   "text": "متناسب با یک حرکت یکنواخته، نه انفجارهای عظیمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 614.25,
   "end": 619.63,
   "text": "شما قائل هستید که صدای رعدآساش گوش رو کر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 619.63,
   "end": 622.09,
   "text": "و دلیل بعدی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 622.09,
   "end": 624.71,
   "text": "تعبیری که در این آیه اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 624.71,
   "end": 627.13,
   "text": "در عین اینکه کوه‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 627.13,
   "end": 629.47,
   "text": "ظاهراً ساکن می‌دونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 629.47,
   "end": 633.77,
   "text": "یا شما ظاهراً اینو ساکن می‌دونید، در واقع تو همون حال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 633.77,
   "end": 639.27,
   "text": "در همون حالتی که شما ساکن می‌دونید میگه به سرعت در حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 639.27,
   "end": 642.33,
   "text": "یعنی دو حالت از یک شی رو داره بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 642.33,
   "end": 646.57,
   "text": "دو تا حالته. دو تا حالت از یک شیئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 646.57,
   "end": 652.55,
   "text": "باز دلیل بعدی تعبیر به اتقانه که به معنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 652.55,
   "end": 655.67,
   "text": "منظم ساختن و محکم کردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 655.67,
   "end": 659.33,
   "text": "اینم تناسب با زمان برقراری نظام جهان داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 659.33,
   "end": 668.31,
   "text": "یعنی اگر شما قائلیت که قراره متلاشی شدن و فروپاشی عظیمی از این نظام رخ بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 668.31,
   "end": 673.95,
   "text": "خب این بحث نظام اتقان چیه اینجا خدا بیان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 673.95,
   "end": 681.09,
   "text": "که چه در آیه می‌فرماید که اینم یک نکته‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 681.09,
   "end": 688.17,
   "text": "و مطلب بعدی، دلیل بعدی اینکه در این آیه انتهاش می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 688.17,
   "end": 691.51,
   "text": "مخصوصاً اینکه تفعلون فعل مضارعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 691.51,
   "end": 697.25,
   "text": "و این داره نشان میده که دلالت بر این می‌کنه که مربوط به همین دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 697.25,
   "end": 700.23,
   "text": "چون می‌فرماید که از اعمال شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 700.23,
   "end": 706.21,
   "text": "در حال آینده، حالا اون اعمالی که چه الان، چه آینده انجام میدید باخبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 706.21,
   "end": 708.49,
   "text": "و حال اینکه اگر قرار بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 708.49,
   "end": 713.19,
   "text": "ناظر به موضوع قیامت باشه و تمام شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 713.19,
   "end": 715.69,
   "text": "زمان و مدت و عمر زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 715.69,
   "end": 717.73,
   "text": "باید می‌فرمود ما فعلتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 717.73,
   "end": 720.61,
   "text": "نه ما تفعلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 720.61,
   "end": 724.21,
   "text": "به ما فعلتم باید می‌فرمود، نه به ما تفعلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 724.21,
   "end": 728.41,
   "text": "یعنی کاری که انجام دادید، خدا به کاری که انجام دادید آگاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 728.41,
   "end": 732.81,
   "text": "خب از مجموع این قرائن و این‌ها این مشخص میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 732.81,
   "end": 735.07,
   "text": "پس این هم یکی دیگه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 735.07,
   "end": 740.29,
   "text": "عجایب آفرینشه که خدای منان در این آیه به زیبایی تمام ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 740.29,
   "end": 748.01,
   "text": "سخن گفته. حالا نتیجه‌ای که اینجا می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 748.01,
   "end": 751.47,
   "text": "که قابل تأمل هست اونم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 751.47,
   "end": 755.87,
   "text": "مسلماً چون اینجا بحث کوه‌ها رو خدا مطرح میکنه در قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 755.87,
   "end": 763.55,
   "text": "مسلماً حرکت کوه‌ها بدون حرکت زمین امکانش نیست که الان ما میدونیم خب این کوه‌ها متصله به زمینن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 763.55,
   "end": 766.19,
   "text": "و وقتی کوه‌ها رو خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 766.19,
   "end": 772.19,
   "text": "در قرآن در حال حرکت میشمره پس زمین هم حرکت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 772.19,
   "end": 774.25,
   "text": "مثل اونم حرکت ابرها. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 774.25,
   "end": 780.79,
   "text": "طبق محاسبات که دانشمندان انجام داده‌اند سرعت سیر حرکت زمین به دور خودش تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 780.79,
   "end": 784.09,
   "text": "نزدیک کمترین حالا س-سرعت رو داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 784.09,
   "end": 787.11,
   "text": "نزدیک به سی کیلومتر در هر دقیقه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 787.11,
   "end": 791.67,
   "text": "که حالا هرچی سر-- مثلاً در حرکت انتقالی خیلی بیشتره همچنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 791.67,
   "end": 795.45,
   "text": "حالا در هر حال اینکه چرا قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 795.45,
   "end": 800.33,
   "text": "اشاره به کوه‌ها داره نه به خود زمین در بحث حرکت تو این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 800.33,
   "end": 806.77,
   "text": "شاید حالا در تفسیر نمونه میفرماید شاید به جهت عظمت کوه‌ها باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 806.77,
   "end": 809.35,
   "text": "که به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 809.35,
   "end": 813.29,
   "text": "اون سنگینی و وزن کوه‌ها اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 813.29,
   "end": 820.03,
   "text": "که در عین اینکه این کوه‌ها سنگینن، باعظمتن اینها باز در حرکتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 820.03,
   "end": 824.57,
   "text": "میخواد یه اشاره‌ای باشد به ید قدرت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 824.57,
   "end": 827.33,
   "text": "یه نمونه خوبی از این جهت باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 827.33,
   "end": 832.51,
   "text": "که وقت-- البته باید در نظر داشت که وقتی کوه در حرکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 832.51,
   "end": 834.45,
   "text": "پس زمین هم قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 834.45,
   "end": 840.43,
   "text": "در حرکته که اینجا قدرت حضرت حق به ثبوت میرسه در اذهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 840.43,
   "end": 842.85,
   "text": "در هر حال میدونیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 842.85,
   "end": 845.13,
   "text": "ما این رو متوجه هستیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 845.13,
   "end": 848.95,
   "text": "وقتی تاریخ رو، تاریخ علمی رو بررسی می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 848.95,
   "end": 851.79,
   "text": "می‌بینیم نخستین دانشمندانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 851.79,
   "end": 854.49,
   "text": "حرکت زمین رو کشف کردن گالیله‌ای--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 854.49,
   "end": 856.63,
   "text": "حالا اونطور که به روایت تاریخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 856.63,
   "end": 861.25,
   "text": "گالیله ایتالیایی بود و کوپرنیک لهستانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 861.25,
   "end": 867.75,
   "text": "خب این‌ها مال کی‌ان؟ اینا مال اواخر قرن شونزده و اوایل قرن هفده میلادی‌ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 867.75,
   "end": 870.55,
   "text": "که این عقیده رو برملا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 870.55,
   "end": 878.61,
   "text": "حالا شما دقت بفرمایید که اگرچه حالا اون موقع ارباب کلیسا به شدت با اونا برخورد کرد، تحت فشار قرارشون داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 878.61,
   "end": 880.79,
   "text": "محکومشون کرد و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 880.79,
   "end": 885.81,
   "text": "اما شما می‌بینید که حدود هزار سال پیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 885.81,
   "end": 888.13,
   "text": "پیش از این‌ها، پیش از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 888.13,
   "end": 891.65,
   "text": "حالا برملا کردن این‌ها این حقیقت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 891.65,
   "end": 899.37,
   "text": "قرآن تصریحاً این موضوع رو برملا کرده و پرده از روی این حرکت برداشته در این آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 899.37,
   "end": 902.45,
   "text": "اینه که این هم خودش یک نشانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 902.45,
   "end": 905.65,
   "text": "توحیدی و علمی قرآن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 905.65,
   "end": 909.15,
   "text": "امیدواریم که خدای منان بیش از پیش ما رو با حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 909.15,
   "end": 912.97,
   "text": "قرآنی اعم از ظاهر و باطن آشنا کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 912.97,
   "end": 916.09,
   "text": "انشاالله که قلب ما رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 916.09,
   "end": 920.67,
   "text": "ظرف وجودی ما رو وعاء پاک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 920.67,
   "end": 924.37,
   "text": "انشاالله برقراری از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 924.37,
   "end": 931.19,
   "text": "انوار قدسی‌ش ذیل آیات قرآن قرار بده و ما بیش از پیش بفهمیم در این قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 931.19,
   "end": 937.73,
   "text": "عظیم الشأن خدا چه معدوه‌ای آماده کرده و چه طعامی بر سر این سفره برای قلوب ما قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 937.73,
   "end": 940.29,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 940.29,
   "end": 943.23,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 943.23,
   "end": 946.13,
   "text": "على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 946.13,
   "end": 949.01,
   "text": "وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 949.01,
   "end": 951.77,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 951.77,
   "end": 954.49,
   "text": "على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 954.49,
   "end": 957.15,
   "text": "وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 957.15,
   "end": 960.09,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 960.09,
   "end": 962.99,
   "text": "على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 962.99,
   "end": 965.87,
   "text": "وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 965.87,
   "end": 968.61,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 968.61,
   "end": 971.37,
   "text": "على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 971.37,
   "end": 973.59,
   "text": "وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}