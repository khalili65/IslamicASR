 "chapters": [
  {
   "index": 0,
   "title": "## اقتدای مسافر به نماز جمعه",
   "start": 11.82,
   "end": 108.28
  },
  {
   "index": 1,
   "title": "### برداشت عام؛ مرخ و عفار",
   "start": 108.28,
   "end": 412.92
  },
  {
   "index": 2,
   "title": "### رستاخیز انرژی‌ها",
   "start": 412.92,
   "end": 744.59
  },
  {
   "index": 3,
   "title": "## اشاره‌ی انفسی؛ شمس نبوت و حرارت ولایت",
   "start": 744.59,
   "end": 765.23
  },
  {
   "index": 4,
   "title": "## سطوح فهم آیه در طول تاریخ",
   "start": 765.23,
   "end": 901.49
  },
  {
   "index": 5,
   "title": "## سرسبزی شرط ذخیره انرژی",
   "start": 901.49,
   "end": 960.59
  },
  {
   "index": 6,
   "title": "## اشاره‌ی انفسی شمس و ولایت",
   "start": 960.59,
   "end": 1131.05
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.68,
   "end": 4.74,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.74,
   "end": 7.56,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.56,
   "end": 9.86,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.86,
   "end": 11.82,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.82,
   "end": 19.86,
   "text": "آیا اه کسی که نمازش شکسته است می‌تونه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.86,
   "end": 24.3,
   "text": "صورت جماعت پشت سر امام جمعه نماز بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.3,
   "end": 28.14,
   "text": "و اقتدا کنه به اه امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.14,
   "end": 31.38,
   "text": "جماعت نماز جمعه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.38,
   "end": 34.96,
   "text": "رهبر عزیزمون فرمودن بله اشکال نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.96,
   "end": 40.78,
   "text": "و نماز جمعه از مأموم مسافر صحیحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.78,
   "end": 45.28,
   "text": "و کفایت از نماز ظهرش هم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.28,
   "end": 49.3,
   "text": "اما بریم سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.3,
   "end": 51.8,
   "text": "ادامه بحث قلب منغمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.8,
   "end": 57.26,
   "text": "یکی دیگه از آیاتی که خیلی زیبا پیرامون معجزات علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.26,
   "end": 60.42,
   "text": "قرآن سخن گفته است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.42,
   "end": 62.94,
   "text": "آیه هشتاد سوره یاسین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.94,
   "end": 67.02,
   "text": "الذي جعل لكم من الشجر الأخضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.02,
   "end": 71.48,
   "text": "نارا فإذا أنتم منه توقدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.48,
   "end": 80.54,
   "text": "یعنی اون کسی که الذي کسی که جعل لكم برای شما قرار داد من الشجر الأخضر نارا از درخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.54,
   "end": 84.9,
   "text": "سرسبز آتش رو قرار داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.9,
   "end": 90.36,
   "text": "فإذا أنتم منه توقدون و شما در اون هنگام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.36,
   "end": 94.0,
   "text": "اه از اون آتش می‌افروزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.0,
   "end": 96.9,
   "text": "یعنی به هنگام نیازتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.9,
   "end": 101.68,
   "text": "از اون درخت سرسبز آتش می‌افروزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.68,
   "end": 108.28,
   "text": "خب یه چند تا نکته عرض کنم که به ترتیب اهمیت و اولویتش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.28,
   "end": 114.82,
   "text": "در تفاسیر نخستین ما متقدمین اشاره کردن در این مورد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.82,
   "end": 120.52,
   "text": "معنی ساده و روشنی که برای همه عموم مردم قابل فهم بوده و هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.52,
   "end": 122.98,
   "text": "که در اعصار قدیم هم بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.98,
   "end": 126.18,
   "text": "عرب‌ها و خصوصاً این امر رایج بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.18,
   "end": 129.98,
   "text": "اونم برای آتش بر افروختن از چوب درختان مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.98,
   "end": 132.66,
   "text": "اه دو نوع چوب مخصوصی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.66,
   "end": 138.56,
   "text": "یکی به نام مرخ که زیر قرار می‌دادن و یکی افار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.56,
   "end": 142.46,
   "text": "رو قرار می‌دادن. در بیابان‌های حجاز این دو نوع چوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.46,
   "end": 145.5,
   "text": "رویش می‌کرده. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.5,
   "end": 149.16,
   "text": "این دو رو که روی هم قرار می‌دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.16,
   "end": 153.74,
   "text": "اه اصطلاحاً بهشون می‌گفتن دو نوع چوب آتش‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.74,
   "end": 155.78,
   "text": "و مثل یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.78,
   "end": 158.98,
   "text": "سنگ آتش‌زنه اینا رو وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.98,
   "end": 164.76,
   "text": "روی هم قرار می‌دادن بر اثر تماس و برخورد و اتصال و ارتباط این دو با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.76,
   "end": 169.06,
   "text": "مثل کبریت امروز جرقه ای حاصل می‌شده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.06,
   "end": 174.04,
   "text": "آتش روشن می‌شده. دیگه ساده‌ترین وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.04,
   "end": 181.68,
   "text": "برداشت عموم مردم از این آیه و این دست آیات چنین مفاهیم و مضامینی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.68,
   "end": 185.88,
   "text": "که بعد نتیجه گرفته می‌شود که آن خدایی که می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.88,
   "end": 189.52,
   "text": "درختان سرسبز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.52,
   "end": 194.72,
   "text": "اینچنین ازشون آتش بیرون بفرسته، پس قدرت داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.72,
   "end": 196.98,
   "text": "به مردگان لباس حیات بپوشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.98,
   "end": 204.0,
   "text": "یک آیه ایست که ماحصل و نتیجه‌اش باز بوی معاد می‌دهد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.0,
   "end": 208.14,
   "text": "باز توجه به حضرت حق و توحید و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.14,
   "end": 213.18,
   "text": "که با اینکه آب و آتش دو چیز متضادند در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.18,
   "end": 218.34,
   "text": "در سطح ظاهره این دو، دو چیز متضادند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.34,
   "end": 224.08,
   "text": "و کسی که اون‌ها رو بتونه کنار هم قرار بده دو چیز متضاد رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.08,
   "end": 227.08,
   "text": "پس چنین کسی قدرت داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.08,
   "end": 230.6,
   "text": "حیات و مرگ رو هم کنار هم قرار بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.6,
   "end": 232.84,
   "text": "و چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.84,
   "end": 239.84,
   "text": "عظمتی رو بیافرینه که مسلماً برای اون هم پوشاندن لباس زندگی به اندام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.84,
   "end": 242.3,
   "text": "انسان‌های مرده کار مشکلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.3,
   "end": 244.02,
   "text": "این یک برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.02,
   "end": 246.3,
   "text": "اما برداشت و تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.3,
   "end": 249.12,
   "text": "دقیق‌تری که بعضی از مفسرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.12,
   "end": 254.94,
   "text": "اشاره کردن اون برمی‌گرده به خاصیت آتش افروزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.94,
   "end": 257.4,
   "text": "به وسیله چوب درختان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.4,
   "end": 261.48,
   "text": "منحصر به فرد مرخ و افا-- افار نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.48,
   "end": 269.12,
   "text": "بلکه اه این یه خاصیته تو همه درختان و همه اجسام عالم حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.12,
   "end": 274.44,
   "text": "که هر چند دو تا چوب مذبور که عرض کردیم بر اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 274.44,
   "end": 278.9,
   "text": "حالا اون مواد و و-وضع مخصوصشون آمادگی بیشتری دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.9,
   "end": 282.94,
   "text": "یعنی مرخ و افار آفادگی-- آمادگی بیشتری دارن برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.94,
   "end": 285.34,
   "text": "اینکه آتش رو بروز بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.34,
   "end": 290.84,
   "text": "اما توجه داشته باشید که این نکته دوم که داریم عرض می‌کنیم یک خاصیتی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.84,
   "end": 293.48,
   "text": "خاصیت آتش افروزی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.48,
   "end": 297.98,
   "text": "همه درختان و همه حتی اجسام عالم موجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.98,
   "end": 301.74,
   "text": "چگونه؟ خلاصه به این شکله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 301.74,
   "end": 303.84,
   "text": "اولاً تمام چوب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.84,
   "end": 310.98,
   "text": "درختان اگر محکم به همدیگه بخورن و لو مرخ و افار نباشند جرقه می‌زنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.98,
   "end": 314.02,
   "text": "و حتی چوب درختان سرسبز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 314.02,
   "end": 317.46,
   "text": "اصلاً علت اینکه معمولاً تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.46,
   "end": 323.6,
   "text": "جنگل‌ها اینا می‌بینید آتش سوزی‌های وسیع و وحشتناکی رخ میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.6,
   "end": 326.16,
   "text": "یکی از عوامل عمده‌اش همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.16,
   "end": 328.58,
   "text": "یعنی عامل انسانی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 328.58,
   "end": 333.8,
   "text": "بلکه بادها به شدت وزش می‌گیره، طوفان میاد اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.8,
   "end": 339.42,
   "text": "شاخه‌های درختان محکم به هم برخورد می‌کنند و بینشون جرقه زده میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 339.42,
   "end": 342.66,
   "text": "و این جرقه‌ها برگ‌های خشک رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.66,
   "end": 347.68,
   "text": "به آتش می‌کشه و بعد باد میاد این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 347.68,
   "end": 352.58,
   "text": "این آتش رو گسترش میده و عامل اصلی آتش سوزی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 352.58,
   "end": 360.78,
   "text": "این به یک معنا همون جرقه الکتریسیته است که بر اثر اک-- اصطکاک و مالش آشکار میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 360.78,
   "end": 363.7,
   "text": "و توجه داشته باشن عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 363.7,
   "end": 366.08,
   "text": "که این همون آتشی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 366.08,
   "end": 370.6,
   "text": "در دل همه ذرات موجودات جهان نهفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.6,
   "end": 375.4,
   "text": "حالا که حالا به، به هنگام اصطکاک و مالش خودشو نشون میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 375.4,
   "end": 378.14,
   "text": "و از شجر اخضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 378.14,
   "end": 381.82,
   "text": "خیلی شیرین و زیبا از درخت سرسبز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.82,
   "end": 385.7,
   "text": "نار می‌آفرینه، آتش می‌آفرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 385.7,
   "end": 389.4,
   "text": "این تفسیر، تفسیر خب وسیع‌تری و چشم‌انداز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.4,
   "end": 393.34,
   "text": "بالاتری‌ست از جمع ازدادی که در آفرینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.34,
   "end": 403.24,
   "text": "گسترده‌تری حکایت می‌کنه و به یک معنا حتی عمیق‌تر میشه گفت بقا رو در فنا واضح‌تر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 403.24,
   "end": 406.72,
   "text": "جمع ازداد بقا در کنار فنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 406.72,
   "end": 410.6,
   "text": "اینم یک معنا. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 410.6,
   "end": 412.92,
   "text": "در تفسیر دیگری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 412.92,
   "end": 418.86,
   "text": "نگاه عمیق‌تر است، اون هم البته به کمک دانش‌های امروزی عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.86,
   "end": 423.04,
   "text": "و بهش مردم دست یافتن، اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 423.04,
   "end": 426.32,
   "text": "تفسیر دقیق‌تر بهش دست یافتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 426.32,
   "end": 432.24,
   "text": "اصطلاحاً اگر اهل مطالعه بوده باشید بهش رستاخیز انرژی‌ها هم میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 432.24,
   "end": 434.68,
   "text": "خصوصاً در تفسیر نمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 434.68,
   "end": 438.78,
   "text": "آقای مکارم و گروهشون بهش اشاره کردن اونجا مبسوطاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 438.78,
   "end": 441.16,
   "text": "حالا این به چه شکله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 441.16,
   "end": 445.78,
   "text": "اینکه یکی از کارهای توجه داشته باشید این خیلی به دردتون می‌خوره، مخصوصاً برای بچه‌هاتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 445.78,
   "end": 448.5,
   "text": "اینا نوجوونا بگید شیرینه براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.5,
   "end": 453.9,
   "text": "یکی از کارهای مهم گیاه‌ها مسئله کربن‌گیری از هوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 453.9,
   "end": 457.7,
   "text": "و ساختن سلولز نباتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 457.7,
   "end": 461.2,
   "text": "خب اینو در علوم و این‌ها بچه‌ها تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 461.2,
   "end": 463.26,
   "text": "مقاطع درسی‌شون می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 463.26,
   "end": 466.46,
   "text": "سلولز اون جرم درختانه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 466.46,
   "end": 473.02,
   "text": "ع-- میشه گفت اجزاء عمده اون کربن و اکسیژن و هیدروژن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 473.02,
   "end": 478.0,
   "text": "حالا این کربن و اکسیژن و هیدروژن که اینا مجموعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 478.0,
   "end": 481.3,
   "text": "سلولز یا جرم درختان رو تشکیل داده‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 481.3,
   "end": 484.94,
   "text": "ببینیم که چگونه خود این‌ها حاصل می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 484.94,
   "end": 488.98,
   "text": "اولاً یاخته‌های درختان و گیاهان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 488.98,
   "end": 492.04,
   "text": "این‌ها میان گاز کربن رو از هوا می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 492.04,
   "end": 494.76,
   "text": "بعد تجزیه‌ش می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 494.76,
   "end": 500.94,
   "text": "اکسیژن رو از اون آزاد می‌کنن وقتی که تجزیه‌ش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 500.94,
   "end": 508.04,
   "text": "چی رو؟ کربن رو، گاز کربن رو که از هوا گرفتن تجزیه کردن، اکسیزن-- اکسیژن‌ش رو آزاد می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 508.04,
   "end": 512.28,
   "text": "و کربن رو تو وجود خودشون نگه می‌دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 512.28,
   "end": 515.12,
   "text": "اونا با این ترکیب، با این عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 515.12,
   "end": 521.22,
   "text": "ترکیبی در حقیقت چوب درختان رو می‌سازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 521.22,
   "end": 523.96,
   "text": "این عمل اصلاً عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 523.96,
   "end": 528.44,
   "text": "ساخت چوب درختان، نوع و جنس چوب درختانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 528.44,
   "end": 532.82,
   "text": "اما اونچه که مهمه و مهم‌تر از همه ایناست، اینه که طبق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 532.82,
   "end": 535.16,
   "text": "گواهی علوم طبیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.16,
   "end": 539.0,
   "text": "هر ترکیب شیمیایی که انجام میشه باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 539.0,
   "end": 541.96,
   "text": "توأم با جذب انرژی خاصی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 541.96,
   "end": 546.02,
   "text": "یا اینکه با آزاد شدن انرژی خاصی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 546.02,
   "end": 551.7,
   "text": "پس بنابراین وقتی که درختان به عمل کربن‌گیری مشغولند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 551.7,
   "end": 556.26,
   "text": "طبق این قانون احتیاج به وجود یک انرژی دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 556.26,
   "end": 561.44,
   "text": "برای اینکه کربن رو بگیرند. خب تو همین جا از گرما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 561.44,
   "end": 567.7,
   "text": "و نور آفتاب به عنوان یک انرژی فعال استفاده می‌کنند، این نیازشون رو برطرف می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 567.7,
   "end": 570.98,
   "text": "به همین ترتیب وقت تشکیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 570.98,
   "end": 575.08,
   "text": "چوب‌های درختان مقداری از انرژی آفتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 575.08,
   "end": 577.36,
   "text": "تو دل اونا ذخیره میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 577.36,
   "end": 580.88,
   "text": "خب این آفتاب، انرژی آفتاب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 580.88,
   "end": 586.38,
   "text": "ذخیره شده در دل این چوب‌های ساخته شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.38,
   "end": 590.04,
   "text": "همین انرژی ذخیره شده و آفتاب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 590.04,
   "end": 594.62,
   "text": "که به موقع چوب‌ها رو اصطلاحاً میگیم می‌سوزانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 594.62,
   "end": 598.7,
   "text": "همین انرژی آفتابه که آزاد میشه بعداً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 598.7,
   "end": 602.94,
   "text": "یعنی همون انرژی ذخیره شده آفتاب وقتی آزاد میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 602.94,
   "end": 606.7,
   "text": "اصطلاحاً میگیم سوخته شد، آتش گرفته شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 606.7,
   "end": 613.32,
   "text": "که حالا اه چون که کربن با اکسیژن هوا ترکیب شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 613.32,
   "end": 617.6,
   "text": "و گاز کربن رو تشکیل میده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 617.6,
   "end": 620.12,
   "text": "اکسیژن و هیدروژن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 620.12,
   "end": 623.78,
   "text": "که اون مقداری آبه دیگه، آزاد می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 623.78,
   "end": 627.22,
   "text": "وقتی اکسیژن و هیدروژن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 627.22,
   "end": 630.94,
   "text": "آزاد شدن، چنین اتفاقی می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 630.94,
   "end": 634.14,
   "text": "و از این تعبیرات اصطلاحاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 634.14,
   "end": 638.54,
   "text": "وقتی حالا بگذریم از این تعبیرات اصطلاحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 638.54,
   "end": 641.74,
   "text": "به عبارت ساده بخوایم بهش بپردازیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 641.74,
   "end": 644.98,
   "text": "می‌گیریم که این موضوع رو دقت بفرمایید شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 644.98,
   "end": 648.94,
   "text": "که این نور و حرارت مطبوعی که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 648.94,
   "end": 656.66,
   "text": "می‌بینید مثلاً توی زمستان، توی هوای سرد، داخل یه کلبه روستایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 656.66,
   "end": 660.2,
   "text": "یا مثلاً کرسی زغالی تو شهر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 660.2,
   "end": 664.58,
   "text": "می‌بینید گرما تولید می‌کنه و روشن می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 664.58,
   "end": 670.34,
   "text": "و در حقیقت هم گاهاً نور میده هم گرما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 670.34,
   "end": 677.74,
   "text": "همون نور و حرارت آفتابه که چند سال یا حتی بعضاً ده‌ها سال طول کشیده در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 677.74,
   "end": 681.08,
   "text": "دل این چوب ذخیره شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 681.08,
   "end": 683.34,
   "text": "و اونچه که درخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 683.34,
   "end": 686.98,
   "text": "در طول یک عمر به صورت تدریج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 686.98,
   "end": 691.68,
   "text": "از آفتاب گرفته بدون هیچگونه کم و کاستی پس میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 691.68,
   "end": 696.7,
   "text": "که حالا این آزاد شدن انرژی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 696.7,
   "end": 700.76,
   "text": "اینکه میگن همه انرژی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 700.76,
   "end": 705.2,
   "text": "تو کره زمین به انرژی آفتاب برمی‌گرده، یک معناش همینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 705.2,
   "end": 708.16,
   "text": "حالا یکی از شیوه‌هاش همینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 708.16,
   "end": 712.88,
   "text": "که اینجا اصطلاحاً به این چیزی که به این معنایی که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 712.88,
   "end": 715.5,
   "text": "عرض کردیم خدمت شما عزیزان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 715.5,
   "end": 718.22,
   "text": "بهش میگن رستاخیز انرژی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 718.22,
   "end": 726.68,
   "text": "می‌رسیم به این موضوع و می‌بینیم که نور و حرارتی که اینجا تو فضا پراکنده میشه و برگ درخت‌ها و چوب‌های اون‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 726.68,
   "end": 728.9,
   "text": "نوازش و پرورش میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 728.9,
   "end": 731.41,
   "text": "اینا همه هیچ کدوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 731.41,
   "end": 733.91,
   "text": "نابود شدنی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 733.91,
   "end": 737.39,
   "text": "که ما گمان کنیم این نور از بین رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 737.39,
   "end": 741.17,
   "text": "بلکه یه نوع تغییر چهره است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 741.17,
   "end": 750.81,
   "text": "و در حقیقت دور از چشم ما انسان‌ها در درون اون ذرات چوب و شاخه‌ها و برگ‌های درخت و این‌ها پنهان شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 750.81,
   "end": 753.87,
   "text": "و وقتی که یه شعله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 753.87,
   "end": 756.67,
   "text": "آتش به چوب خشک می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 756.67,
   "end": 758.97,
   "text": "رستاخیزش شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 758.97,
   "end": 761.97,
   "text": "تمام اونچه که از انرژی آفتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 761.97,
   "end": 765.23,
   "text": "در دل اون پنهان بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 765.23,
   "end": 767.21,
   "text": "به یک آن می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 767.21,
   "end": 770.51,
   "text": "تو اون لحظه حشر و نشرش آغاز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 770.51,
   "end": 772.69,
   "text": "حالا حشر، حشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 772.69,
   "end": 778.01,
   "text": "معنا جمع کننده است که اینا جمع شد، این انرژی جمع شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 778.01,
   "end": 782.69,
   "text": "حشرشه. بعد نشر یعنی پخش کننده، نشر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 782.69,
   "end": 785.29,
   "text": "چی می‌شه؟ همون انرژی پخش می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 785.29,
   "end": 793.93,
   "text": "بدون اینکه مثل مثلا روشنایی یک شمع که تو یه زمان کوتاه می‌بینی ازش کم می‌شه، چجوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 793.93,
   "end": 797.35,
   "text": "شمع ظاهرا داره ازش کم می‌شه تا روشنی بده؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 797.35,
   "end": 800.93,
   "text": "بدون اینکه اون نوری که از آفتاب ذخیره شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 800.93,
   "end": 805.97,
   "text": "اون انرژی و اون حرارتی که از آفتاب ذخیره شده در این‌ها کم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 805.97,
   "end": 812.81,
   "text": "خب. خب شما توجه دارید که قطعاً و بدون شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 812.81,
   "end": 819.89,
   "text": "این معنی که ما الان عرض کردیم در زمان نزول آیه‌ای که عرض کردیم از آیه هشتاد و دو سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 819.89,
   "end": 821.87,
   "text": "یاسین برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 821.87,
   "end": 824.37,
   "text": "عموم مردم روشن نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 824.37,
   "end": 827.25,
   "text": "خب همونطور که ما گفتیم موضوع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 827.25,
   "end": 831.09,
   "text": "اه، مشکلی هم ایجاد نمی‌کنه که بخوایم بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 831.09,
   "end": 833.07,
   "text": "این آیات قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 833.07,
   "end": 836.15,
   "text": "خب اگر اون موقع نازل شده چرا الان داره کشف می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 836.15,
   "end": 838.53,
   "text": "اینا برای سطوح مختلفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 838.53,
   "end": 840.73,
   "text": "آیات قرآن اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 840.73,
   "end": 846.75,
   "text": "یکی از معجزات قرآن همینه که برای سطوح مختلف با استعدادهای متفاوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 846.75,
   "end": 850.81,
   "text": "معانی چند مرحله‌ای در خودشون دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 850.81,
   "end": 857.51,
   "text": "یک روز مثلا از این آیه همون تفاسیر ابتدایی رو متوجه می‌شدن، معانی ابتدایی رو متوجه می‌شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 857.51,
   "end": 860.35,
   "text": "امروز چیز بیشتری دارن می‌فهمن حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 860.35,
   "end": 863.79,
   "text": "قطعاً آیندگان با پیشرفت علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 863.79,
   "end": 869.37,
   "text": "حقایقی رو از قرآن کشف خواهند کرد که اصلاً به مخیله ما و امروزی‌ها نمی‌گنجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 869.37,
   "end": 872.09,
   "text": "و یکی از افسوس‌های ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 872.09,
   "end": 878.11,
   "text": "که خوشا به حال اونهایی که در آینده‌ها باشن و فراتر از این رو درک کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 878.11,
   "end": 882.39,
   "text": "و خصوصا محضر حضرت حجت رو درک کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 882.39,
   "end": 885.51,
   "text": "که آقا از اون بیست و هفت حرف علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 885.51,
   "end": 893.97,
   "text": "از زمان آدم تا ظهور حضرت دو حرف علم رو همه مردم با این همه کشف اختراعات و اکتشافات و علوم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 893.97,
   "end": 899.33,
   "text": "این‌ها بهش می‌رسن. بیست و پنج حرف علم در دل حضرت خوشا به سعادت اونهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 899.33,
   "end": 902.35,
   "text": "باشن و درک کنن. حالا گاهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 902.35,
   "end": 910.65,
   "text": "البته این به ذهن هم متبادر می‌شه که چرا قرآن اومده اینجا به تعبیر مثلا شجر اخضر نام کرده درخت سبز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 910.65,
   "end": 916.01,
   "text": "در حالی که خب، اه، این افروخته شدن آتش با چوبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 916.01,
   "end": 919.01,
   "text": "تر یه مقدار مشکله تو ذهن جمع کردنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 919.01,
   "end": 922.57,
   "text": "چه بهتر بود مثلا به قول مفسرین میان اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 922.57,
   "end": 931.75,
   "text": "مثلا میگن شاید بعضیا فکر کنن که چه بهتر بود قرآن می‌فرمود الشجر الیابس مثلا چوب خشک چون بحث حرارت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 931.75,
   "end": 934.23,
   "text": "آتش و اینجور چیزاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 934.23,
   "end": 937.35,
   "text": "مثلا شاید با اون سازگارتر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 937.35,
   "end": 941.37,
   "text": "اینجا اتفاقا اونا میگن نکته، نکته جالب اینجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 941.37,
   "end": 945.97,
   "text": "فقط اون درختان سبزن که می‌تونن عمل کربن‌گیری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 945.97,
   "end": 948.07,
   "text": "ذخیره نور آفتاب رو انجام بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 948.07,
   "end": 953.69,
   "text": "عزیزان الحمد لله همه اهل علمید، اهل تحقیق و پژوهش و قلم به دستید می‌دونید دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 953.69,
   "end": 956.73,
   "text": "که من خیلی گذرها عرض می‌کنم و رد می‌شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 956.73,
   "end": 959.29,
   "text": "همین ببینید خب درختان خشک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 959.29,
   "end": 964.51,
   "text": "که صدها سال در معرض تابش آفتاب هم اگر قرار بگیرن ذره‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 964.51,
   "end": 967.97,
   "text": "ذخیره انرژی حرارتی در اون‌ها صورت نمی‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 967.97,
   "end": 973.33,
   "text": "بلکه موقعی قادر به این کارن که سرسبز باشن، زنده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 973.33,
   "end": 978.61,
   "text": "پس بنابراین این که قرآن فرموده شجر اخضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 978.61,
   "end": 982.45,
   "text": "و درخت سرسبز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 982.45,
   "end": 985.89,
   "text": "بله در این صورت است که می‌تواند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 985.89,
   "end": 992.95,
   "text": "گرما و نور رو اونم به یک شکل مرموزی به قول تفسیر نمونه به شکل مرموزی تو چوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 992.95,
   "end": 996.39,
   "text": "سرد و مرطوب و سرسبز خودش نگه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 996.39,
   "end": 999.55,
   "text": "خب زنده باید باشه، نمی‌تونه که مرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 999.55,
   "end": 1001.83,
   "text": "اما به محض اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1001.83,
   "end": 1006.39,
   "text": "خشک شد عمل کربن‌گیری و ذخیره انرژی آفتاب تعطیل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1006.39,
   "end": 1010.05,
   "text": "دیگه هم چیزی نیست. خب با توجه به این اصلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1010.05,
   "end": 1013.97,
   "text": "عرض کردیم، می‌بینیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1013.97,
   "end": 1020.37,
   "text": "چه ترسیم زیبایی از چهره رستاخیز انرژی‌ها اینجا صورت گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1020.37,
   "end": 1023.77,
   "text": "و همچنین یک معجزه علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1023.77,
   "end": 1026.33,
   "text": "از قرآن جاویدان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1026.33,
   "end": 1028.43,
   "text": "خودش دو مرتبه نشون داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1028.43,
   "end": 1033.11,
   "text": "از این گذشته حالا شما اگر به تفسیرهای دیگری هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1033.11,
   "end": 1039.97,
   "text": "حالا اصطلاحا ما می‌گیم تفسیرهای انفسi، به اون‌ها هم که اگر برگردید و توجه کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1039.97,
   "end": 1043.87,
   "text": "می‌بینید که خب حالا، حالا اینجا دیگه فرصت نیست وقت ما هم گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1043.87,
   "end": 1046.93,
   "text": "اگر رجوع کنید به تفسیرهای انفسi",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1046.93,
   "end": 1050.89,
   "text": "اونجا که دیگه غوغاست. این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1050.89,
   "end": 1056.93,
   "text": "حالا ذخیره شدن انرژی آفتاب، اگر این آفتاب رو شما بیایید از شمس رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1056.93,
   "end": 1060.95,
   "text": "از شمس رو وجود مقدس پیغمبر بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1060.95,
   "end": 1064.73,
   "text": "و اون حرارتی که ذخیره می‌شود رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1064.73,
   "end": 1067.27,
   "text": "پرتو ولایت بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1067.27,
   "end": 1071.23,
   "text": "این‌ها بعد حشرش تجمعش یک معنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1071.23,
   "end": 1074.75,
   "text": "نشرش یعنی، اه، پخشش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1074.75,
   "end": 1077.65,
   "text": "یا بیرون ریختن این نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1077.65,
   "end": 1079.49,
   "text": "و تجلیش به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1079.49,
   "end": 1085.19,
   "text": "اینا همه در بحث‌های تفسیر انفسi رستاخیز، قیامت این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1085.19,
   "end": 1087.63,
   "text": "تاثیرگذارن که حالا انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1087.63,
   "end": 1090.81,
   "text": "به موقعش و به اهلش به وقتش به قول استاد علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1090.81,
   "end": 1095.55,
   "text": "انشاالله که عاقبت همه ما ختم به خیر بشه و خدای منان به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1095.55,
   "end": 1099.71,
   "text": "اسم ارحم الراحمینش ما رو از قلب بی‌خبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1099.71,
   "end": 1103.09,
   "text": "ناآگاه از این همه عظمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1103.09,
   "end": 1107.27,
   "text": "عظمت در آفرینش پیرامونیمون که ما بهش بی‌توجهیم نجات بدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1107.27,
   "end": 1109.47,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1109.47,
   "end": 1112.35,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1112.35,
   "end": 1117.85,
   "text": "على محمد يا رب صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1117.85,
   "end": 1120.71,
   "text": "عليه وآله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1120.71,
   "end": 1123.43,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1123.43,
   "end": 1127.47,
   "text": "على محمد يا رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1127.47,
   "end": 1131.05,
   "text": "صل عليه وآله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}