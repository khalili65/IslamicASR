 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 4.18,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.18,
   "end": 8.3,
   "text": "السلام علیک یا داعی الله و ربانی یا آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.3,
   "end": 10.5,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.5,
   "end": 13.28,
   "text": "بعضیا گمان می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.28,
   "end": 16.04,
   "text": "وقتی می‌دونن امام جماعتی یا امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.04,
   "end": 24.02,
   "text": "جمعه‌ای حتی در بعضی از استفتائات اومده که مثلاً تلفظش صحیح نیست و بعضی از مخارج رو درست ادا نمی‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.02,
   "end": 31.04,
   "text": "میشه بهش اقتدا کرد و بعداً مثلاً به ثواب نماز جماعت رسید و بعداً اعاده کرد نماز رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.04,
   "end": 34.74,
   "text": "یا اینکه بهش اقتدا کرد و چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.74,
   "end": 38.78,
   "text": "مثلاً تلفظش صحیح نیست حمد و سوره رو خودت بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.78,
   "end": 41.34,
   "text": "اینا اشتباه محض. همه اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.34,
   "end": 43.46,
   "text": "اینا رو اشتباه می‌کنند مردم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.46,
   "end": 47.06,
   "text": "قبیل چیزا رو میگن و اصلاً ما در همچین چیزی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.06,
   "end": 53.5,
   "text": "رهبر عزیرمون هم اینو رد می‌کنه و می‌فرماید که اصلاً جایز نیست اقتدا کردن به امامی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.5,
   "end": 56.68,
   "text": "تلفظش صحیح نیست و مخارج حروف رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.68,
   "end": 61.16,
   "text": "بیان نمی‌کنه اینطور که باید بگه به لسان عرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.16,
   "end": 63.42,
   "text": "و اصلاً نمیشه به اون اقتدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.42,
   "end": 66.4,
   "text": "بحث ما بحث قلب منغمر بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.4,
   "end": 72.84,
   "text": "که و هرچه می‌کشیم متأسفانه از همین قلب منغمر است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.84,
   "end": 78.16,
   "text": "متأسفانه ما در هر چیزی عرض که عرض شد که وقت می‌گذاریم به جز در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.16,
   "end": 83.78,
   "text": "خبر گرفتن از حقایق نظام هستی که اصلاً برای این اومدیم که بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.78,
   "end": 86.66,
   "text": "ما برای معرفت آمدیم، برای اخذ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.66,
   "end": 91.94,
   "text": "معرفت آمدیم، برای اخذ علم آمدیم، برای تلقی حقایق از نظام هستی آمدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.94,
   "end": 95.76,
   "text": "اصلاً قرآن اومده که القا کنه به ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.76,
   "end": 100.38,
   "text": "علم اول و آخر رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.38,
   "end": 104.92,
   "text": "خدای منان خواست از علم لدنیه خودش در اختیار ما قرار بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.92,
   "end": 107.88,
   "text": "ما را از بی‌خبری و غفلت بیرون بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.88,
   "end": 111.9,
   "text": "لذا قرآن رو نازل کرد، ارسال رسل، انزال كتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.9,
   "end": 114.4,
   "text": "و امامان رو یک به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.4,
   "end": 116.5,
   "text": "برای ما فرستاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.5,
   "end": 119.32,
   "text": "اما متأسفانه ما غفلت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.32,
   "end": 121.94,
   "text": "این و غ و این غفلت کار دست ما داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.94,
   "end": 125.06,
   "text": "اصلاً اینکه ما به تدریج همونطور که در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.06,
   "end": 133.52,
   "text": "آیه ثمه ثمه استدراج در خلقت عرض شد اینکه به تدریج اومدیم تو این دنیا و اصلاً نظام دنیا نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.52,
   "end": 136.14,
   "text": "تدریجه برای اینکه ما به تدریج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.14,
   "end": 138.4,
   "text": "دقت بفرمایید چی عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.4,
   "end": 141.74,
   "text": "و با استدراج و ثمه ثمه هی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.74,
   "end": 147.7,
   "text": "اشتداد وجودی پیدا کنیم از قوه به فعل، از مجهول به معلوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.7,
   "end": 152.66,
   "text": "که یعنی به معرفت دست پیدا کنیم که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.66,
   "end": 166.6,
   "text": "بستر عبادت معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.6,
   "end": 172.86,
   "text": "و یا احببت ان چی؟ اعرف، شناخته بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.86,
   "end": 175.72,
   "text": "یعنی اینکه شناخته بشم خلق رو ایجاد کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.72,
   "end": 180.74,
   "text": "اینم حرکت هبی ازش در حقیقت اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.74,
   "end": 184.56,
   "text": "حکما و عرفا از حرکت هبی ازش یاد می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.56,
   "end": 187.28,
   "text": "که به هب نه به احتیاج ما را آفرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.28,
   "end": 191.0,
   "text": "خب به چی؟ برای چی؟ اعرف برای اینکه شناخته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.0,
   "end": 192.9,
   "text": "برای اینکه خدا شناخته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.9,
   "end": 194.98,
   "text": "این شناخت یعنی از ناحیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.98,
   "end": 197.58,
   "text": "قلب آگاه رخ میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.58,
   "end": 200.22,
   "text": "نه از ناحیه قلب منغمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.22,
   "end": 204.08,
   "text": "قلبی که در اجاب و در یک بی‌خبری قرار گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.08,
   "end": 206.26,
   "text": "و بی‌خبر از همه جاست. اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.26,
   "end": 211.62,
   "text": "اینکه لذا مرحوم حاجی سبزواری علیه الرحمه در حاشی، حاشیه منظومه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.62,
   "end": 214.98,
   "text": "می‌فرماید که اگر ابداعاً و پیش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.98,
   "end": 219.36,
   "text": "آشنایی با این عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.36,
   "end": 225.6,
   "text": "مثلاً اصطلاحات مثل جوهر و عرض و ظاهر و باطن و جماد و نبات و چه و چه و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.6,
   "end": 229.22,
   "text": "به یک باره با همین هوش و استعداد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.22,
   "end": 235.52,
   "text": "بالفعل اینا می‌اومدیم آفریده می‌شدیم و بحث استدراج و متدرجاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.52,
   "end": 239.04,
   "text": "در کار نبود و یعنی اون آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.04,
   "end": 244.3,
   "text": "که بحثش گذشت اگر این چنین نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.3,
   "end": 248.06,
   "text": "یعنی همینطور که هستی به عینه در متن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.06,
   "end": 250.2,
   "text": "خارج پیاده می‌شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.2,
   "end": 255.76,
   "text": "با همین هوش و هواس و استعداد و این فعلیت که الان داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.76,
   "end": 257.66,
   "text": "اصلاً ببین چقدر مشکل میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.66,
   "end": 265.22,
   "text": "در یک میشه گفت بهت عجیب قرار می‌گرفتی و نجاتتو در این، از این بهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.22,
   "end": 267.06,
   "text": "شاید اصلاً ناممکن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.06,
   "end": 269.62,
   "text": "یه استدراجی خدا قرار داد که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.62,
   "end": 274.8,
   "text": "فلسفه این استدراج مثل بچه‌ای که اول میره کلاس آمادگی بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 274.8,
   "end": 282.84,
   "text": "عرض شود ابتدایی همینطور دوره متوسطه اول، دوم همینطور تا سطح پیشرفته و تخصصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.84,
   "end": 286.36,
   "text": "و چه جالب که میگیم مهد، مهد کودک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.36,
   "end": 289.68,
   "text": "قرآن هم زمین رو مهد میگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.68,
   "end": 292.84,
   "text": "و خلقت زمین رو بر اساس مهد میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.84,
   "end": 298.28,
   "text": "یعنی آمادگی. یک آمادگیه، یه آمادستانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.28,
   "end": 303.46,
   "text": "یه کودکستانه. آمادگیه برای اینکه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.46,
   "end": 309.62,
   "text": "غذای عقلی برداره، هی از ضعف به قوت بره، از مجهول به معلوم حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.62,
   "end": 312.34,
   "text": "اصلاً حرکت نفس یعنی همین دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.34,
   "end": 318.16,
   "text": "تا جایی پیش بره که بتونه تصرف در ماده کائنات کنه که دیگه این سعادت نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.16,
   "end": 320.9,
   "text": "خب این فلسفه خلقت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 320.9,
   "end": 323.2,
   "text": "خب چگونه ما از فلسفه خ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.2,
   "end": 328.54,
   "text": "خلقتمون غافل باشیم؟ بعد خدا در خلقت ما به خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.54,
   "end": 333.22,
   "text": "بارک الله بگه، تبریک به خودش بگه، آفرین و احسن بگه بعد ما بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.22,
   "end": 335.44,
   "text": "چقدر زشت باشه این چنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.44,
   "end": 341.2,
   "text": "و اونجا اون فرمایش مولامون علی علیه الصلاة والسلام که عرض شد در یک جلسه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.2,
   "end": 345.42,
   "text": "سید رضی علیه الرحمه فرمود دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 345.42,
   "end": 347.78,
   "text": "مثل این کلمه مولا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.78,
   "end": 353.66,
   "text": "هم‌قیمت این مولا اصلاً نمیشه تصور کرد هر ق， هم‌قیمت این کلمه مولا علی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 353.66,
   "end": 359.84,
   "text": "یا مثلاً اینکه فرمود هیچ سخن حکیمایی به هم وزن، حکیمانه‌ای به هم وزن اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 359.84,
   "end": 365.16,
   "text": "یعنی هی، این همه حکما سخن گفتن هیچکدوم هم وزن این جمله مولا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.16,
   "end": 367.92,
   "text": "هیچ سخنی نمی‌تونه هم ردیف اون قرار بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 367.92,
   "end": 370.62,
   "text": "اونم یکی از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.62,
   "end": 373.54,
   "text": "اه، وجوهش هم اون حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.54,
   "end": 375.28,
   "text": "هشتاد و یک نهج البلاغه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.28,
   "end": 378.96,
   "text": "یادتونه دیگه؟ \"قیمة کل امر امایحسن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.96,
   "end": 381.54,
   "text": "حالا دو جور این روایت اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.54,
   "end": 386.4,
   "text": "اونجا گفتیم به میزانی که به بهترین وجه ممکن کاری رو انجام بده قیمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.4,
   "end": 390.22,
   "text": "هر کسی به اون بهترین وجه ممکنیه که کارو انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 390.22,
   "end": 394.88,
   "text": "اینجا مثلا به این معنی دیگه‌ای هم گفتن، گرفتن به این معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.88,
   "end": 398.56,
   "text": "که فرمودن که ارزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.56,
   "end": 403.58,
   "text": "هر کسی یعنی اون چیزی که ارزش تو رو در نهایت نشون میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.58,
   "end": 405.8,
   "text": "ارزش چیزاییه که بهش دل بستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.8,
   "end": 412.34,
   "text": "تو به چی دل بستی؟ ارزش اون چیزی که بهش دل بستی \"مایحسن\" و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 412.34,
   "end": 415.66,
   "text": "براش یعنی اون نزد تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 415.66,
   "end": 421.22,
   "text": "اه، قیمت داره \"احسن وجهه\"، نیکوترین چیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.22,
   "end": 423.84,
   "text": "ارزش اون چ-چی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.84,
   "end": 426.34,
   "text": "که تو به اون ارزش دادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.34,
   "end": 428.04,
   "text": "قیمت و، قیمت تو همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.04,
   "end": 430.22,
   "text": "به چی دل بستی به یک معنا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 430.22,
   "end": 433.54,
   "text": "به چی ارزش دادی بیشتر از هر چیزی به چی ارزش دادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.54,
   "end": 437.26,
   "text": "ارزش تو همونه. ببین چقدر زیبا برداشت‌هایی که می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 437.26,
   "end": 441.5,
   "text": "البته می‌تونه یک حدیث مولا هزاران هزار بسط و معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 441.5,
   "end": 443.54,
   "text": "این‌ها داشته باشه و ما بی‌خبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.54,
   "end": 449.2,
   "text": "همه در طول هم. و این نشون میده که ما چقدر دوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.2,
   "end": 451.7,
   "text": "حالا یک محک دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.7,
   "end": 453.84,
   "text": "خودمون رو، یه محک خودمون رو بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.84,
   "end": 457.6,
   "text": "الان بیشترین چیزی که برای ما ارزشمنده در این نشئه طبیعت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.6,
   "end": 460.1,
   "text": "به چی دل بستیم؟ اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.1,
   "end": 462.94,
   "text": "همونه. ما ارزش ما همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.94,
   "end": 469.42,
   "text": "همون مقدار ارزش داریم. چقدر ما برای علم که باارزش‌ترین چیزیست که خدا خلق کرده و براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 469.42,
   "end": 473.6,
   "text": "عقلی رو قرار داده که بتونی با سیر عقلی غذا برداری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.6,
   "end": 479.7,
   "text": "غذای عقلت، غذای عقلت که بشه همون علم که بتونی رشد کنی به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 479.7,
   "end": 485.32,
   "text": "برگشت کنی در \"انا الیه راجعون\" رجعت کنی بری به اون مبدأ خودت برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 485.32,
   "end": 487.72,
   "text": "اون غذای عقلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.72,
   "end": 491.72,
   "text": "که میشه گفت مقدس‌ترین وجود نظامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.72,
   "end": 494.68,
   "text": "موجود نظامه، خلق نظامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 494.68,
   "end": 496.96,
   "text": "اون غذاش چیه؟ علمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.96,
   "end": 499.2,
   "text": "غذای عقل علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.2,
   "end": 502.6,
   "text": "حالا چقدر غذای، چقدر به عقلت غذا دادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.6,
   "end": 504.82,
   "text": "چقدر عقل ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.82,
   "end": 507.08,
   "text": "غذا برداشته از این عالم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.08,
   "end": 514.64,
   "text": "همون مقدار وزن و اندازه‌ی عقل ما محاسبه می‌شه و ما هم اون دنیا با عقلمون محاسبه می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.64,
   "end": 519.44,
   "text": "بازخواست می‌شیم. حساب و کتاب اصلاً نظام ثواب و عقاب بر اساس عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.44,
   "end": 522.48,
   "text": "چقدر عقلت تا به کجا رسیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 522.48,
   "end": 524.62,
   "text": "اصلاً بهشت جایگاه عقلاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.62,
   "end": 527.68,
   "text": "حالا این عقل رو همون وجود نفس بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.68,
   "end": 531.48,
   "text": "که حالا تو دلش قلب هست، روح هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 531.48,
   "end": 534.14,
   "text": "وهم هست، خیال هست. همه حواس قوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.14,
   "end": 536.62,
   "text": "\"النفس في وحدتها کل القوی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 536.62,
   "end": 539.82,
   "text": "همه‌ی قوا درشن. این‌ها رو دادن به ما که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 539.82,
   "end": 545.72,
   "text": "این غذاها رو برداریم برای اینکه بریم به بهترین وجه ممکن پرواز کنیم، عروج کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 545.72,
   "end": 550.9,
   "text": "نمیشه ما در دعا طلب کنیم که الهی مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.9,
   "end": 556.84,
   "text": "\"الحقنا بعبادک الذین هم بالبدارة الیک یسارعون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 556.84,
   "end": 560.14,
   "text": "که مثلاً خدایا ما رو ملحق کن به اون بندگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 560.14,
   "end": 568.34,
   "text": "خودت که سرعت گرفتن \"بالبدارة الیک یسارعون\" به سمت تو به سوی تو سرعت گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 568.34,
   "end": 570.82,
   "text": "و \"بابک علی الدوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 570.82,
   "end": 579.8,
   "text": "یطرقون\" دائم در خونه‌ی تو رو کوبیدن \"و ایاک فی الیل و النهار یعبدون\" دائم در شب و روز در عبادت تو بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 579.8,
   "end": 581.58,
   "text": "که حالا این عبادت چی معنا شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 581.58,
   "end": 587.26,
   "text": "\"ای ليعرفون\" یعنی دائماً در سیر معرفتی بودن، غذای علمی برداشت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 587.26,
   "end": 591.72,
   "text": "به تک تک کلمات وجودی نظام هستی توجه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.72,
   "end": 597.4,
   "text": "اهل توجه عرفانی بودن خصوصاً به خودشون که عالم اینجا نهفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.4,
   "end": 600.44,
   "text": "مولامون علی علیه‌السلام مگر نفرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.44,
   "end": 604.42,
   "text": "\"ان انک اتظن انک جرم صغیر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 604.42,
   "end": 605.68,
   "text": "تو گمان می‌کنی یه جرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 605.68,
   "end": 612.9,
   "text": "کوچکی هستی \"وفیک tombol العالم الاکبر\" در حالی که عالم اکبر اون بزرگ‌ترین عالمی که نمیشه وصفش کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 612.9,
   "end": 617.84,
   "text": "در وجود توست. فیکه \"وفیک tombol العالم الاکبر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 617.84,
   "end": 623.06,
   "text": "حالا اینطوری باشی بعد مثلاً غافل باشی در درون خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.06,
   "end": 626.36,
   "text": "سال‌ها دل طلب جام جم از ما می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 626.36,
   "end": 629.82,
   "text": "آن که خود داشت ز بیگانه تمنا می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 629.82,
   "end": 632.34,
   "text": "آنچه در درون خودت بود غافل بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 632.34,
   "end": 634.76,
   "text": "سر در گریبان فرو نبردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 634.76,
   "end": 639.2,
   "text": "به سر قلب عبارتی قرآن که \"و лиتلقف\" هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 639.2,
   "end": 642.34,
   "text": "د-- نرسیدی که تلطیف سر کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 642.34,
   "end": 644.82,
   "text": "سر در گریبان خودت فرو ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 644.82,
   "end": 651.84,
   "text": "خودت رو بشناسی که علامه می‌فرماید این \"ولیتلقف\" ای یتعقل، ای یتعمل، ای یتدبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.84,
   "end": 660.2,
   "text": "ای يتفکر. اهل تأمل و تعقل و تفکر و تدبر این‌ها باشی به تلطیف سر می‌رسی، به حقایق می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 660.2,
   "end": 667.34,
   "text": "اینطوری نباشی بعد بیای به خدا بگی خدایا ما رو \"الحقنا بعبادک الذین هم بالبدارة الیک یسارعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 667.34,
   "end": 670.16,
   "text": "اونایی که سرعت گرفتن به سوی تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 670.16,
   "end": 672.6,
   "text": "دائم در خونه تو رو کوبیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 672.6,
   "end": 674.84,
   "text": "شب و روز در عبادت بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.84,
   "end": 680.92,
   "text": "به جایی رسیدن چنان حیرت کردن \"رب زدنی فیک تحیرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 680.92,
   "end": 686.78,
   "text": "رب زدنی علما رب زدنی فیک تحیرا و هم من هیبتک مشفقون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 686.78,
   "end": 690.36,
   "text": "اینا به گونه‌ای به حیرت افتادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 690.36,
   "end": 694.64,
   "text": "به علم دسترسی پیدا کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 694.64,
   "end": 699.3,
   "text": "از عظمت تو ترسان شدن، خاشع شدن، مشفق شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 699.3,
   "end": 704.18,
   "text": "حیران شدن. بعد حالا ما تقاضا کنیم \"الحقنا\" بعد خودمون هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 704.18,
   "end": 708.04,
   "text": "تقلایی نداشته باشیم. نمیشه عزیزان اصلاً راه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 708.04,
   "end": 715.5,
   "text": "هی بشینیم تنبلی کنیم بگیم ما جزو استثنائات روزگار باشیم یک شبه از صد ساله بریم هیچ تلاشی هم نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 715.5,
   "end": 722.58,
   "text": "این چنین نمیشه. اصلاً اینطوری راه نداره که ما گمان کنیم دست رو دست بگذاریم تنبلی کنیم ساعت و روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 722.58,
   "end": 724.94,
   "text": "و شبانه روز ما همینجوری به غفلت بگذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 724.94,
   "end": 729.94,
   "text": "حالا یه آقایی بیاد با یک القا، به یک نفس، به یک بسم الله الرحمن الرحیم تو گوشمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 729.94,
   "end": 731.64,
   "text": "همه حقایق رو بریزه تو وجود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 731.64,
   "end": 734.36,
   "text": "حالا اون کل احمد ببخشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 734.36,
   "end": 736.28,
   "text": "آست مم کاظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 736.28,
   "end": 739.92,
   "text": "کربلایی خب ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 739.92,
   "end": 746.68,
   "text": "بله به یک القا کل قرآن تو وجودش ریخت اما لفظ قرآن ریخت نه حقایق و باطن قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 746.68,
   "end": 750.82,
   "text": "بالاخره مراتب محفوظ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 750.82,
   "end": 756.96,
   "text": "فرق میکنه بین ما و اون علما، فقها، حکما، بزرگان، عرفایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 756.96,
   "end": 762.36,
   "text": "یک عمر اهل تلاش و کوشش بودند فرق میکنه و فرق است بین من و از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 762.36,
   "end": 766.62,
   "text": "اصلاً قیاسش هم آدم احساس خجالت میکنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 766.62,
   "end": 776.18,
   "text": "خودش رو بخواد مثلاً قیاس بگیره با یه بزرگی مثل حضرت علامه حسن زاده که شب و روزشه بیشترین کار ایشون در طول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 776.18,
   "end": 779.18,
   "text": "شبانه روز مثلاً هجده سال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 779.18,
   "end": 785.06,
   "text": "هجده ساعت ببخشید. هجده ساعت در بیست و چهار ساعتشون تلاش علمی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 785.06,
   "end": 787.4,
   "text": "آخه من چی بگم؟ چه عرض کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 787.4,
   "end": 792.84,
   "text": "آدم خجالت میکشه. یا محی الدین عربی که خب از خود حضرت علامه شنیدم فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 792.84,
   "end": 796.02,
   "text": "بیش از هشتصد و پنجاه تا هشتصد و شصت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 796.02,
   "end": 800.84,
   "text": "عنوان که معنون شده یعنی عنوان بندی شده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 800.84,
   "end": 802.98,
   "text": "مجلدات کتب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 802.98,
   "end": 806.6,
   "text": "رسالات ایشون مثلاً دست به قلم بشه بنویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 806.6,
   "end": 810.62,
   "text": "یکیش فتوحات یکیش فسوس که عالمو بریزه به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 810.62,
   "end": 813.46,
   "text": "هشتصد میلیون مرید سر سفره‌ش باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 813.46,
   "end": 819.56,
   "text": "بعد حالا من بیام اینجا بگم خدایا الحقنا بعباده الذین هم ببدار لک یسارعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 819.56,
   "end": 824.08,
   "text": "اینایی که امثال محی الدین عربی‌ها، شیخ الرئیس‌ها، ملا صدراها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 824.08,
   "end": 827.94,
   "text": "شیخ طوسی‌ها، علامه حلی‌ها، علامه حسن زاده‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 827.94,
   "end": 830.56,
   "text": "اینا یسارعون سرعت گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 830.56,
   "end": 834.04,
   "text": "علی الدوام یطرقون دائماً در کوبیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 834.04,
   "end": 839.4,
   "text": "شب و روز یعبدون در حال عبادت تو بودن به مقام حیرت رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 839.4,
   "end": 841.6,
   "text": "حالا الحقنا ما رو به اون‌ها ملحق کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 841.6,
   "end": 843.58,
   "text": "این خیلی درخواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 843.58,
   "end": 846.86,
   "text": "سخیف و زشتیه. اصلاً اهانته به مقام اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 846.86,
   "end": 850.64,
   "text": "باید تلاش کرد. باید تلاش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 850.64,
   "end": 853.36,
   "text": "أليس للإنسان لما سعى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 853.36,
   "end": 857.82,
   "text": "بله در پس تلاش تو البته اون‌ها معرفت محبت می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 857.82,
   "end": 860.58,
   "text": "مرام می‌گذارند و به اس الحاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 860.58,
   "end": 865.5,
   "text": "انشاالله اگر به شفع و هم جنسی و هم سنخی رسیدیم ملحقت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 865.5,
   "end": 873.6,
   "text": "اما اینکه ما با تن، تنبلی و بی‌خبری و قلب منغمر بی‌خبری و غفلت بخواهیم به اونجا برسیم محال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 873.6,
   "end": 876.46,
   "text": "مطلقا راه نداره به قول علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 876.46,
   "end": 878.88,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 878.88,
   "end": 888.36,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 888.36,
   "end": 890.58,
   "text": "صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 890.58,
   "end": 894.7,
   "text": "و آله. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 894.7,
   "end": 898.96,
   "text": "صل على محمد و آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 898.96,
   "end": 904.3,
   "text": "اللهم صل على محمد و آله. اللهم صل على محمد و آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}