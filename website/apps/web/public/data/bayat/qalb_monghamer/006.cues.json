  {
   "index": 1,
   "title": "## فلسفهٔ چشم و گوش؛ بازگشت به قلب منغمر",
   "start": 51.82,
   "end": 71.86
  },
  {
   "index": 2,
   "title": "## چهار چشمِ بنده در حدیث امام سجاد",
   "start": 71.86,
   "end": 191.5
  },
  {
   "index": 3,
   "title": "## ارادهٔ خیر و گشودن چشم قلب",
   "start": 191.5,
   "end": 320.84
  },
  {
   "index": 4,
   "title": "## بی‌خبری از آخرت و مکث دنیا",
   "start": 320.84,
   "end": 401.33
  },
  {
   "index": 5,
   "title": "حدیث شریف نبوی در احیاء العلوم، جلد یک، صفحهٔ صد و سی و چهار، بسیار زیبا است:",
   "start": 401.33,
   "end": 586.83
  },
  {
   "index": 6,
   "title": "## شهادت، معرفت و آغاز تعلیم پس از مرگ",
   "start": 586.83,
   "end": 713.55
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.54,
   "end": 3.54,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.54,
   "end": 8.46,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.46,
   "end": 10.6,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.6,
   "end": 17.94,
   "text": "اه استفتاهی شده از رهبر عزیزمون که خب قبلاً ما عرض کردیم برام به فتوای همه مراجع تا رهبری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.94,
   "end": 20.74,
   "text": "کسی که تلفظش صحیح نیست نمیشه بهش اقتدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.74,
   "end": 24.74,
   "text": "حالا سؤال اینه امام جماعت در اثنای نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.74,
   "end": 27.42,
   "text": "تو کیفیت تلفظ یه کلمه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.42,
   "end": 35.68,
   "text": "شک می‌کنه و رد می‌شه ازش که حالا اینو درست تلفظ کرد یا نه و رد می‌شه بعد از نماز متوجه می‌شه که اشتباه تلفظ کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.68,
   "end": 40.4,
   "text": "تأمل می‌کنه متوجه می‌شه و اونجا فکر می‌کرد درست بوده یا شک داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.4,
   "end": 44.22,
   "text": "اینجا نماز خودش و دیگر مأمومین چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.22,
   "end": 49.38,
   "text": "رهبر عزیزمون فرمودند که نماز محکوم به صحته یعنی درسته مشکلی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.38,
   "end": 54.1,
   "text": "ما عرض کرده بودیم که اونجایی که متوقف شدیم در جلسه قبل منغمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.1,
   "end": 62.0,
   "text": "جلسه پیش روی بحث چشم و حساسیت اون و فلسفه ایجاد چشم در وجود انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.0,
   "end": 66.82,
   "text": "یه عرض شود تذکر کوچولویی دادیم و رد شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.82,
   "end": 75.4,
   "text": "گفتیم حالا بعدا عرض می‌کنیم در بحث اینکه چرا ما بی‌خبریم و اصلاً چشم رو خدای منان داده برای خبر گرفتن از عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 75.4,
   "end": 78.38,
   "text": "قوای سامعه برای خبر گرفتن شنودی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.38,
   "end": 81.04,
   "text": "قوای باصره برای خبر گرفتن شهودی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.04,
   "end": 88.3,
   "text": "همش برای خبر گرفتنه. قلب منغمر کسیه که چشم و گوشش رو بسته به روی حقایق هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.3,
   "end": 91.22,
   "text": "که حالا یادمه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.22,
   "end": 95.3,
   "text": "در اون جلسات خیلی شاید مثلاً یک سال پیش بود حدوداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.3,
   "end": 100.54,
   "text": "این حدیث رو ما با هم روش بحث کردیم که تفسیر صافی جلد دو صفحه صد و بیست و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.54,
   "end": 106.1,
   "text": "از امام سجاد سلام الله علیه پیرامون همین بحث چشم و این‌ها یه حدیث شریفی بیان کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 106.1,
   "end": 112.3,
   "text": "که می‌فرماید الا آگاه باشید بدونید ان للعبد اربع اعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.3,
   "end": 114.74,
   "text": "خدای منان برای بنده‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 114.74,
   "end": 116.96,
   "text": "چهار تا چشم قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.96,
   "end": 120.66,
   "text": "اربع اعین. حالا ببینیم این چهار تا چشم چگونه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.66,
   "end": 123.44,
   "text": "که خدا این‌ها رو داده ما باهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.44,
   "end": 125.84,
   "text": "خبر بگیریم از عالم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.84,
   "end": 128.18,
   "text": "عینان این تصنیع است یعنی دو تا چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.18,
   "end": 130.36,
   "text": "عینان يبصر بها امر دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.36,
   "end": 134.48,
   "text": "دو تا چشم هست که با این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.48,
   "end": 138.24,
   "text": "نسبت به امر دینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.24,
   "end": 143.38,
   "text": "آگاهی پیدا می‌کنه. امر دینش رو با این‌ها می‌پاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.38,
   "end": 147.56,
   "text": "امر دینه و دنياو دین و دنیاش رو با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.56,
   "end": 151.9,
   "text": "یعنی این دو تا چشم ظاهری در حقیقت به همون ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.9,
   "end": 155.28,
   "text": "دنیا و ظاهر دین می‌پردازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.28,
   "end": 158.12,
   "text": "و عینان يبصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.12,
   "end": 160.82,
   "text": "يبصر بها امر آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.82,
   "end": 165.08,
   "text": "دو تا چشم هم هستش که با این‌ها بصیرت پیدا می‌کنه بنده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.08,
   "end": 170.44,
   "text": "به امر آخرتش. فإذا أراد الله بعبد خيرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.44,
   "end": 178.68,
   "text": "خب این دو تا چشم ظاهر رو که همه دارن همه هم متوجه هستند و اما اینکه با چه نگاهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.68,
   "end": 181.82,
   "text": "پیرامون خودشون رو نگاه کنن این مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.82,
   "end": 184.56,
   "text": "یعنی این دو تا چشم در طول اون دو تا چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.56,
   "end": 194.26,
   "text": "باطن قرار بگیره یا نه. فإذا أراد الله بعبد خيرا وقتی خدا اراده خیر در رابطه با بنده‌ش می‌کنه فتح له العينین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.26,
   "end": 197.88,
   "text": "خدا برای چنین کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.88,
   "end": 201.22,
   "text": "یه دو تا چشم دیگه رو باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.22,
   "end": 204.62,
   "text": "فتح یعنی پیداست که دو تا چشم رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.62,
   "end": 207.76,
   "text": "خب اون بالا فرمود داره دیگه. اما اینجا فتح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.76,
   "end": 212.92,
   "text": "دیگه خدا بازش می‌کنه. التین فی قلبی کجاست جای این دو تا چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.92,
   "end": 214.7,
   "text": "که خدا بخواد بازشون کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.7,
   "end": 218.74,
   "text": "در قلبشه یعنی در الهیت وجودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.74,
   "end": 222.3,
   "text": "پیداست که با اونا باید باطن رو بپاید، غیب رو بپاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.3,
   "end": 226.44,
   "text": "فابصر فابصر بهم الغیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.44,
   "end": 229.44,
   "text": "فابصر بهم الغیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.44,
   "end": 231.84,
   "text": "و پس با این دو تا چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.84,
   "end": 234.58,
   "text": "بهما تصنیه با این دو تا چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.58,
   "end": 240.28,
   "text": "غیب رو بصیرت پیدا می‌کنه، آگاهی پیدا می‌کنه و امر آخرته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.28,
   "end": 244.1,
   "text": "امری که مربوط به آخرتشه، قیامتشه، بعد از مرگشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.1,
   "end": 251.42,
   "text": "و إذا أراد الله به غير ذلك یعنی اگر چنانچه خدا اراده‌اش بر این تعلق گرفت که حالا خیر این بنده نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.42,
   "end": 254.84,
   "text": "که البته در طول خود اراده عبد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.84,
   "end": 257.3,
   "text": "بنده به سمت شر بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.3,
   "end": 264.7,
   "text": "کلاً نمدها أولا بها أولا قرآن می‌فرماید ما اون رو برو هرچی بخوان همون ور بهشون امداد میدیم دنیایی‌ها رو بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.7,
   "end": 269.24,
   "text": "بحث دنیاشون امداد میدیم می‌کشیم براشون امداد مد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.24,
   "end": 273.96,
   "text": "نمدو. آخرتی‌ها رم اینایی که دنبال آخرتشون نمدو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.96,
   "end": 278.7,
   "text": "بهشون یعنی کمکشون می‌کنیم امداد می‌رسونیم بهشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.7,
   "end": 284.98,
   "text": "اگر غیر از این اراده شد یعنی اراده خیر نشد ترك القلب بما فيه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.98,
   "end": 288.78,
   "text": "اینجا در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 288.78,
   "end": 293.42,
   "text": "اون چشم اون دو تا چشم‌هایی که در درون خودش بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.42,
   "end": 296.32,
   "text": "دیگه چیزی نمی‌بینن. اونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 296.32,
   "end": 298.48,
   "text": "ترك القلب بما فيه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 298.48,
   "end": 304.68,
   "text": "یعنی اون دو تا چشمی که در درون قلب قرار گرفتن ترکش می‌کنن که اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.68,
   "end": 307.1,
   "text": "چون مربوط به نظام اقدس‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.1,
   "end": 309.46,
   "text": "ترک می‌کنند. دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.46,
   "end": 314.02,
   "text": "قهر می‌کنند. ذیل اسم القهار خدا تعریف میشن اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 314.02,
   "end": 318.24,
   "text": "دیگه با بنده قهر می‌کنن. دیگه چشم باطن طرف کور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.24,
   "end": 320.1,
   "text": "یعنی دیگه بی‌خبر می‌شه از آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.1,
   "end": 326.8,
   "text": "حالا کسی که از آخرتش بی‌خبره، از جایی که می‌خواد بره بی‌خبره، از حساس‌ترین لحظات زندگیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.8,
   "end": 333.02,
   "text": "خب این دنیا یک مکثه. قرآن میگه از ملائکه می‌پرسه که قیامت می‌پرسن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.02,
   "end": 335.82,
   "text": "یا ملائکه از انسان‌ها می‌پرسند آقا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.82,
   "end": 338.46,
   "text": "چقدر در دنیا مکث داشتید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.46,
   "end": 341.82,
   "text": "چقدر در دنیا بودید؟ میگن لحظاتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.82,
   "end": 345.46,
   "text": "میگه مکث داشتیم ما اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 345.46,
   "end": 350.54,
   "text": "آنی کمتر از آنی یه همچین عبارتی یه همچین مضمونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 350.54,
   "end": 353.32,
   "text": "بعد حالا اینو بفروشی به ابد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.32,
   "end": 355.04,
   "text": "چی می‌شه که بفروشی به ابد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.04,
   "end": 360.06,
   "text": "اینکه چشمت رو ببندی. یکی از ابزار آگاهی از نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.06,
   "end": 362.48,
   "text": "از درون و بیرون خودت همون چشم‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.48,
   "end": 365.54,
   "text": "چشم‌های ظاهر، چشم‌های باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.54,
   "end": 369.23,
   "text": "خب اینا رو وقتی بستی و کور کردی دیگه چی می‌خوای ببینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 369.23,
   "end": 372.97,
   "text": "چگونه باخبر بشی از این حقایق نظام هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 372.97,
   "end": 376.15,
   "text": "چگونه میخوای خبر بگیری از عوالم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.15,
   "end": 379.87,
   "text": "چگونه میخوای باخبر بشی از علوم و معارف؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.87,
   "end": 388.39,
   "text": "که حالا این حدیث شریف نبوی که در احياء العلوم بود قبلاً عرض کردیم جلد یک صفحه صد و سی و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 388.39,
   "end": 394.31,
   "text": "که ان لربکم فی ایام دهرکم خیلی زیبا لربکم فی ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 394.31,
   "end": 396.87,
   "text": "تو به این لربکم توجه بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 396.87,
   "end": 399.37,
   "text": "فی ایام دهرکم نفحات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 399.37,
   "end": 404.35,
   "text": "فتعرضوا لها یا الام بعضی روایات داره الا فتعرضوا لها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.35,
   "end": 407.27,
   "text": "خودتون رو در معرض این نفحات و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 407.27,
   "end": 413.17,
   "text": "دمیدن‌ها و وزیدن‌های از روی رحمت خدا قرار بدید در ایام روزگار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.17,
   "end": 416.25,
   "text": "روزگار شما اینم لربکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.25,
   "end": 420.15,
   "text": "یعنی از سمت و ناحیه رب خودتون این نفحات صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 420.15,
   "end": 423.17,
   "text": "چرا رب؟ چون می‌خواد شما رو پرورش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.17,
   "end": 427.23,
   "text": "چون می‌خواد شما رو بالا ببره. چون می‌خواد شما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 427.23,
   "end": 429.19,
   "text": "رشد بده، ارتقای وجودی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 429.19,
   "end": 432.83,
   "text": "دائماً تعالی و تعالی سر میده بر شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.83,
   "end": 435.73,
   "text": "لعلّه ان يصیبکم نفحة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.73,
   "end": 439.69,
   "text": "منها فلا تذوقونا بعدها ابدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.69,
   "end": 444.95,
   "text": "که اگر شما خودتون رو در معرض این نفحه‌ها قرار ندید فلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.95,
   "end": 447.05,
   "text": "تذوقونا بعدها ابدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.05,
   "end": 449.77,
   "text": "دیگه بعداً هیچ فایده‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 449.77,
   "end": 451.41,
   "text": "برای شما فایده‌ای بعداً نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.41,
   "end": 452.99,
   "text": "الان باید چشمتون رو باز کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.99,
   "end": 455.73,
   "text": "الان در معرض این نفحات قرار بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.73,
   "end": 457.75,
   "text": "این نفحات همون بیداریه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.75,
   "end": 464.37,
   "text": "همون يقظه است، همون آگاهیه، همون باخبر شدن از حقایقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.37,
   "end": 466.09,
   "text": "اصلاً چرا بهش میگن نبی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 466.09,
   "end": 468.79,
   "text": "چون باخبره. چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 468.79,
   "end": 474.05,
   "text": "امامت، ولایت، خلافت همه در طول او هستند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 474.05,
   "end": 477.47,
   "text": "حالا رتبه بندی که بکنی بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.47,
   "end": 480.17,
   "text": "ولایت اون در همه جاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.17,
   "end": 483.09,
   "text": "امامت میشه مرتبه عالیه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.09,
   "end": 486.99,
   "text": "همینطور حالا بخوای از ابتدا بش بچینی بری جلو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.99,
   "end": 490.31,
   "text": "سیر صعودی بگیری اول عبده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.31,
   "end": 493.57,
   "text": "بعد میشه نبی، بعد رسوله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.57,
   "end": 496.23,
   "text": "بعد به یه معنا خلیله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.23,
   "end": 498.17,
   "text": "بعد میشه امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.17,
   "end": 502.39,
   "text": "که همه معنای ولایت رو دارند و همه معنای خلاف-خلافت رو دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 502.39,
   "end": 505.29,
   "text": "خلیفه خدا روی زمینه حالا با رتبه های متعدد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 505.29,
   "end": 508.47,
   "text": "همه این‌ها به میزانی که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 508.47,
   "end": 511.99,
   "text": "یعنی آگاهی پیدا کردن از عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.99,
   "end": 515.47,
   "text": "از علم الهی بهره جستن به همان میزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.47,
   "end": 524.67,
   "text": "رتبه می‌گیرن در خلافت‌شون، در ولایت‌شون، در امامت‌شون، در نبوت‌شون، در رسالت‌شون، در عبادیت‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.67,
   "end": 527.73,
   "text": "اصلاً چیزی جز این نیست عزیز دلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.73,
   "end": 530.17,
   "text": "هرچی که خبر گرفتی، باخبر شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 530.17,
   "end": 532.83,
   "text": "اگر قلب بی‌خبر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.83,
   "end": 536.49,
   "text": "قلب به مقام خلافت، به مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 536.49,
   "end": 538.67,
   "text": "عرض شود نبوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 538.67,
   "end": 544.47,
   "text": "رسالت، خلت، امامت، ولایت نخواهد رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 544.47,
   "end": 548.03,
   "text": "به هر میزان که باخبر است رسیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 548.03,
   "end": 552.05,
   "text": "این حالا اون معنای قربتاً الی الله رو بهتر دارین می‌فهمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 552.05,
   "end": 556.85,
   "text": "قربتاً الی الله یعنی که چشیدن، یعنی رسیدن، یعنی دارا شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 556.85,
   "end": 559.53,
   "text": "تلبس به اسماء الله، چشیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.53,
   "end": 567.71,
   "text": "حقایق اصلی، باخبر شدن از علوم، علم به احوال اعیان موجودات، حکمت، حکمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 567.71,
   "end": 573.33,
   "text": "حکمت متعالی همین که بالاترین حدشه که یٰس وَالْقُرْآنِ الْحَكِیمِ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 573.33,
   "end": 576.07,
   "text": "یُعَلِّمُهُمُ الْكِتٰابَ وَالْحِكْمَةَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.07,
   "end": 580.37,
   "text": "اگر غیر از این باشد در بی‌خبری خواهیم مرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 580.37,
   "end": 583.59,
   "text": "و در بی‌خبری محشور خواهیم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.59,
   "end": 586.67,
   "text": "و در بی‌خبری خواهیم ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 586.67,
   "end": 592.73,
   "text": "و چه شیرین که بالاترین نعمت‌های بهشتی که در مقام شهادت رخ می‌دهد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 592.73,
   "end": 596.61,
   "text": "شهود و شهدا عند ربهم یرزقون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 596.61,
   "end": 599.83,
   "text": "سید بحر العلوم بارها عرض کردیم در رساله شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 599.83,
   "end": 603.71,
   "text": "می‌فرمایند که مقام علم و معرفت است، مقام آگاهی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 603.71,
   "end": 607.93,
   "text": "حقایق عالم است و وقتی مؤمن از دنیا میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 607.93,
   "end": 613.55,
   "text": "اینقدر حرمت داره مؤمن یعنی محب علی که از اونجا به بعد شروع به تعلیم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 613.55,
   "end": 616.39,
   "text": "شروع از مرگ مؤمن با تعلیم شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 616.39,
   "end": 619.35,
   "text": "مرگ مؤمن موت مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 619.35,
   "end": 621.69,
   "text": "محب علی موتش با تعلیم شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 621.69,
   "end": 623.41,
   "text": "یُعَلِّمُهُمُ الْكِتٰابَ وَالْحِكْمَةَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.41,
   "end": 627.25,
   "text": "کسری‌هاش باید جبران بشه. هی به تعالی وجودی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.25,
   "end": 629.71,
   "text": "ببین چقدر جایگاه علم و معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 629.71,
   "end": 632.91,
   "text": "مهم و والا است که از اونجا تازه شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 632.91,
   "end": 636.53,
   "text": "حالا بی‌خبری رو بگیر. به همان میزان که آگاهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 636.53,
   "end": 638.85,
   "text": "داشتن، باخبر شدن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 638.85,
   "end": 640.89,
   "text": "حقایق نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 640.89,
   "end": 644.19,
   "text": "به یک معنا سیر حکمتی و عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 644.19,
   "end": 653.61,
   "text": "از حیث نظر و عمل مهم است و در اعلی مرتبه قرار دارد به همان مقدار بی‌خبری در پست‌ترین و مادون قرار دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 653.61,
   "end": 659.79,
   "text": "لذا کسی که بی‌خبر است میگن تو دنیامون دنیایی زندگی کرد، دنیوی بود، پست بود، پست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 659.79,
   "end": 663.19,
   "text": "پست زندگی کرد. دنیا دنی پست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 663.19,
   "end": 666.13,
   "text": "در انزل مراتب. گیر کرده تو اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.13,
   "end": 670.57,
   "text": "گرفتار اینجاست. به سایه توجه داره، به اصل توجه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 670.57,
   "end": 673.09,
   "text": "ان‌شاءالله خدا هممون رو حفظ کنه از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 673.09,
   "end": 674.91,
   "text": "گرفتاری‌ها و بی‌خبری‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 674.91,
   "end": 677.77,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 677.77,
   "end": 680.87,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 680.87,
   "end": 684.41,
   "text": "على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 684.41,
   "end": 689.17,
   "text": "و آله. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 689.17,
   "end": 691.43,
   "text": "صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 691.43,
   "end": 694.43,
   "text": "محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 694.43,
   "end": 698.29,
   "text": "آله. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 698.29,
   "end": 700.65,
   "text": "صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 700.65,
   "end": 703.63,
   "text": "محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 703.63,
   "end": 707.67,
   "text": "آله. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 707.67,
   "end": 709.93,
   "text": "صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 709.93,
   "end": 713.55,
   "text": "محمد و آله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}