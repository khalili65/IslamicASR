   "start": 616.0,
   "end": 806.7
  },
  {
   "index": 6,
   "title": "## صد و بیست و چهار هزار نبی؛ نبأ عظیم",
   "start": 806.7,
   "end": 1027.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.82,
   "end": 4.42,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.42,
   "end": 9.54,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.54,
   "end": 11.58,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.58,
   "end": 15.14,
   "text": "در خصوص نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.14,
   "end": 20.42,
   "text": "اقتدای اون خواهرها به آقایون که حکم دیگه عرض کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.42,
   "end": 25.76,
   "text": "سؤال کردن کیفیت اتصال و عدم اتصال صفوف زنان و مردان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.76,
   "end": 30.38,
   "text": "در نماز در صورت نبودن پرده و حائل چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.38,
   "end": 32.5,
   "text": "حالا پرده حائل نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.5,
   "end": 34.88,
   "text": "خانم‌ها می‌خواهند متصل شوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.88,
   "end": 39.46,
   "text": "چگونه است کیفیت اتصال یا عدم اتصال؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.46,
   "end": 41.82,
   "text": "یعنی فاصله شرعی چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.82,
   "end": 44.2,
   "text": "لحاظ می‌شود وقتی پرده نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.2,
   "end": 52.78,
   "text": "شاید منظورشون اینه که می‌توانند مثلاً فاصله بیشتری از حد شرعی بگیرند که حالا حدود یک متر هست الان فرمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.78,
   "end": 55.34,
   "text": "مثلاً بیشتر از این به جهت که نبودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.34,
   "end": 57.84,
   "text": "پرده هست مثلاً خانم‌ها بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.84,
   "end": 60.18,
   "text": "از حد فاصله شرعی اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.18,
   "end": 66.6,
   "text": "فاصله بگیرند. رهبر عزیزمون فرمودند زنان می‌توانند پشت سر مردان بدون فاصله بایستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.6,
   "end": 69.04,
   "text": "یعنی باید اون فاصله شرعی حفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.04,
   "end": 73.82,
   "text": "دقت بشه عزیزان. اما بریم سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.82,
   "end": 75.68,
   "text": "بحث قلب منغمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.68,
   "end": 80.7,
   "text": "آیه شصت و سه سوره مؤمنون بود که چقدر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.7,
   "end": 83.38,
   "text": "این آیه پرحرف هستش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.38,
   "end": 91.1,
   "text": "که می‌فرماید بل قلوبهم فی غمرة من هذا ولهم اعمال من دون ذلک هم له عاملون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.1,
   "end": 95.36,
   "text": "اینا در یک بی‌خبری هست قلوبهم قلب‌هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.36,
   "end": 96.98,
   "text": "در یک بی‌خبری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.98,
   "end": 100.02,
   "text": "در کتاب اجازه بدید تقدیم کنیم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 100.02,
   "end": 102.34,
   "text": "تفسیری رو که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.34,
   "end": 104.76,
   "text": "یک وجه باطن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.76,
   "end": 108.58,
   "text": "آیه دو مرتبه پرده‌برداری کرده برای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 108.58,
   "end": 116.72,
   "text": "که از کتاب شریف تفسیر اهل بیت علیهم السلام جلد ده صفحه هشتاد و هشت البته همین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.72,
   "end": 121.82,
   "text": "همین روایت رو در کتاب شریف بهار جلد نه صفحه دویست و بیست و پنج هم می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.82,
   "end": 126.38,
   "text": "اونجا می‌فرماید که قال علی ابن ابراهیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 126.38,
   "end": 134.62,
   "text": "علی ابن ابراهیم گفته فی قوله هو لدینا کتاب ینتقم بالحق ای عليكم ثم قال بل قلوبهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.62,
   "end": 140.18,
   "text": "فی غمرة من هذا ای فی شک مما یقولون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.18,
   "end": 143.36,
   "text": "اینجا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.36,
   "end": 148.3,
   "text": "این هو لدینا کتاب ینتقم بالحق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.3,
   "end": 151.84,
   "text": "یعنی به زبان شما به حق شهادت می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.84,
   "end": 153.82,
   "text": "این کتاب به زبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.82,
   "end": 157.06,
   "text": "حق شهادت می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.06,
   "end": 163.12,
   "text": "به زبان خودتون. به حق شهادت می‌دهد اما به زبان خودتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.12,
   "end": 168.8,
   "text": "خب اما بل قلوبهم فی غمرة من هذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.8,
   "end": 171.7,
   "text": "یعنی قلوب این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.7,
   "end": 174.24,
   "text": "در یک بی‌خبری‌ست از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.24,
   "end": 179.3,
   "text": "حالا این بی‌خبری رو اینجا گرفته یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.3,
   "end": 184.36,
   "text": "اون‌ها به گفته پیغمبران در یک شکی قرار دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.36,
   "end": 188.24,
   "text": "مما فی شک مما یقولون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.24,
   "end": 192.82,
   "text": "یعنی اینکه به حق شهادت نمی‌دن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.82,
   "end": 196.08,
   "text": "به جهت اون بی‌خبر بودنشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.08,
   "end": 200.16,
   "text": "به یک معنا از حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.16,
   "end": 203.52,
   "text": "طریق انبیا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.52,
   "end": 206.22,
   "text": "اون‌ها یک حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.22,
   "end": 209.48,
   "text": "در طول ولایت کلی هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.48,
   "end": 212.82,
   "text": "که فرمودند اگر همه انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.82,
   "end": 215.74,
   "text": "بلا اتفاق در یک سرزمینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.74,
   "end": 220.2,
   "text": "تجمع کنند هیچگونه اختلافی بین این‌ها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.2,
   "end": 221.86,
   "text": "چگونه می‌شود که اینطوری باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.86,
   "end": 225.42,
   "text": "چون وحدت رویه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.42,
   "end": 229.04,
   "text": "اون‌ها به توحید محض رسیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.04,
   "end": 231.92,
   "text": "به توحید اصمد رسیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.92,
   "end": 235.9,
   "text": "چگونه است که خانم زینب سلام الله علیها در کربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.9,
   "end": 238.56,
   "text": "می‌فرماید ما رأیت الا جمیلا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.56,
   "end": 241.8,
   "text": "اون همه بلا و مصیبت مگه شوخیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.8,
   "end": 244.94,
   "text": "اصلاً قابل احصا و بیان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.94,
   "end": 249.5,
   "text": "ولی بی‌جهت خانم مدعی نشده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 249.5,
   "end": 254.44,
   "text": "شعار نداده خانم که دختر امیرالمؤمنین عقیلت العربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.44,
   "end": 257.42,
   "text": "هرچه می‌گوید بر اساس عقل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.42,
   "end": 264.48,
   "text": "و اونجا که امام سجاد علیه السلام در خصوص ایشون فرمود أنت بحمدالله فهمت غیر مفهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.48,
   "end": 271.02,
   "text": "وعالمة غیر معلمة یعنی علم لدنی داره حضرت بهره برده از علم لدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.02,
   "end": 274.7,
   "text": "من لدن حکیم علیم. قرآن هم علم لدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.7,
   "end": 282.12,
   "text": "یعنی به یک معنا خانم که با عقلش و حتی فوق طور عقلش عقیله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.12,
   "end": 287.86,
   "text": "به یک معنا مبالغه است دیگه عقیله یعنی به شدت عاقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.86,
   "end": 291.06,
   "text": "یعنی به یک معنا حتی فوق طور عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.06,
   "end": 294.5,
   "text": "یعنی به جایی دسترسی پیدا کرده که تونسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.5,
   "end": 301.76,
   "text": "من لدن از حضرت حق علم رو اخذ کنه و دریافت کنه بدون معلم و بدون کسی که بخواد بهش بفهمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.76,
   "end": 306.42,
   "text": "این شوخی نیست این مقام. خب یعنی آنچه که بر لسان مبارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 306.42,
   "end": 311.2,
   "text": "ایشون جاری می‌شه از جنس وحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.2,
   "end": 313.76,
   "text": "این دهان، دهان معصومه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.76,
   "end": 320.16,
   "text": "وقتی می‌فرماید ما رأیت الا جمیلا با این همه این سختی‌ها رو زیبا می‌بینه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.16,
   "end": 324.26,
   "text": "جز رسیدن به توحید اصمد نمی‌شه این حرفو زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.26,
   "end": 328.8,
   "text": "که همه عالم رو یک حقیقت، یک حقیقت کلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.8,
   "end": 332.0,
   "text": "ذات حالا بنا به اختلافاتی که بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.0,
   "end": 335.5,
   "text": "حکما و عرفا اینا هست حالا یا ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.5,
   "end": 337.7,
   "text": "شعون یا ذات عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 337.7,
   "end": 342.66,
   "text": "مراتب یا ذات شعون یعنی ذات مظاهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.66,
   "end": 345.62,
   "text": "همه این‌ها رو ظهور حق ببیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.62,
   "end": 349.98,
   "text": "در شدت و ضعف یا در صعه و ضیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.98,
   "end": 353.2,
   "text": "شعون حق یا مراتب حق ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.2,
   "end": 355.74,
   "text": "همه رو کلمات وجودی نظام هستی ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.74,
   "end": 359.6,
   "text": "این فلسفه بعثت انبیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.6,
   "end": 364.02,
   "text": "که یتلو عليهم آياته که در آیه دو سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.02,
   "end": 367.72,
   "text": "جمعه می‌خونیم \"یتلو عليهم آياته\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.72,
   "end": 371.94,
   "text": "آیات رو اینا اصن انبیا اومدن که تلاوت کنن آیات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.94,
   "end": 380.38,
   "text": "خب آیات رو که برا وقتی شما دقت می‌کنید به قرآن که اصن فلسفه بعثت انبیا که \"هو الذي بعث في الأميين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.38,
   "end": 383.76,
   "text": "رسولا منهم يتلو عليهم آياته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.76,
   "end": 386.38,
   "text": "اومدن که آیات رو تلاوت کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.38,
   "end": 390.14,
   "text": "که در پس تلاوت این آیات من و شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.14,
   "end": 396.48,
   "text": "ااا ملهم بشیم به اینکه دو تا وظیفه داریم \"یزكيهم و يعلمهم الكتاب و الحكمة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.48,
   "end": 399.24,
   "text": "در تحت تعالیم و تلاوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.24,
   "end": 403.4,
   "text": "حقایق و قرآن جمعی توسط انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.4,
   "end": 406.38,
   "text": "تزکیه نفس کنیم و تعلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.38,
   "end": 410.92,
   "text": "علوم، تعلیم کتاب و حکمت یعنی ادب‌آموزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 410.92,
   "end": 413.22,
   "text": "خب این تلاوت، تلاوت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 413.22,
   "end": 415.54,
   "text": "\"یتلو عليهم آياته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.54,
   "end": 419.32,
   "text": "آیات. خب وقتی شما به قرآن دقت می‌کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.32,
   "end": 426.64,
   "text": "می‌بینیم که این آیات سر تا سر نظام هستی رو پر کرده تا جایی که قبلاً عرض شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.64,
   "end": 433.86,
   "text": "در اون بحث مفصل و مبسوطه که البته ما بحث مبسوط بود اما اجمالاً گفتیم و رفتیم تو شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.86,
   "end": 437.02,
   "text": "مثلاً پونزده شونزده جلسه. در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.02,
   "end": 440.16,
   "text": "طرق عبور از ظاهر به باطن قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 440.16,
   "end": 443.1,
   "text": "حالا نمی‌دونم دوستان نگه داشتند این مباحث رو و پیگیر بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.1,
   "end": 445.88,
   "text": "در هر حال اونجا گفتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 445.88,
   "end": 450.12,
   "text": "سه شکل قرآن، اون تجلی اعظم حضرت حق، القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.12,
   "end": 458.3,
   "text": "یک شکلش قرآن کتبی بود، یک شکلش قرآن آفاقی و هستی بود و یکی هم قرآن انفسi انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 458.3,
   "end": 462.6,
   "text": "که عرض شد باز این انسان کامل می‌شود اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 462.6,
   "end": 465.94,
   "text": "و قضا و لفظ و به هم پیچیده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 465.94,
   "end": 471.14,
   "text": "و مندمج شده اون حقایق که \"کُلَّ شَيْءٍ عَلَّمْنَاهُ فِي إِمَامٍ مُبِينٍ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 471.14,
   "end": 473.92,
   "text": "بعد صورت کتبیه او می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 473.92,
   "end": 476.52,
   "text": "همین قرآنی که در دسترس ماست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.52,
   "end": 481.8,
   "text": "صورت آفاقی و باز شده‌ش و عینی‌ش، کتاب عینی‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.8,
   "end": 487.32,
   "text": "در متن خارج می‌شود همین عالم آفاقی، نظام آفاقی، آسمان و زمین و ما فیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 487.32,
   "end": 492.34,
   "text": "خب همه اینا آیات‌اند. \"سنريهم آياتنا في الآفاق و في أنفسهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 492.34,
   "end": 495.9,
   "text": "حتى يتبين لهم أنه الحق\" آیات در کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 495.9,
   "end": 503.26,
   "text": "در آفاق، در أنفس. \"و في الأرض آيات للموقنين.\" \"و في أنفسهم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 503.26,
   "end": 508.04,
   "text": "یا \"و في أنفسکم.\" هم در ارض آیات هست هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.04,
   "end": 511.94,
   "text": "جان‌ها، نفوس شما، \"و في أنفسکم أفلا تبصرون.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.94,
   "end": 515.62,
   "text": "آیا نگاه نمی‌کنید؟ چون نگاه نمی‌کنید بی‌خبرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.62,
   "end": 519.1,
   "text": "رمز رو اونجا قرآن داده. \"أفلا تبصرون.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 519.1,
   "end": 520.98,
   "text": "چون نگاه نمی‌کنید بی‌خبرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 520.98,
   "end": 525.76,
   "text": "خب همه اینا آیات‌اند. پس انبیا بحث رو گم نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 525.76,
   "end": 529.14,
   "text": "انبیا تشریف آوردند که تلاوت قرآن آیات کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 529.14,
   "end": 531.66,
   "text": "تلاوت آیات، کدوم آیات؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.66,
   "end": 534.04,
   "text": "آیات کتبیه، عینیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.04,
   "end": 538.04,
   "text": "نفسیه. همه اینا آیات الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 538.04,
   "end": 544.46,
   "text": "یعنی وقتی که انبیا همه این کلمات وجودی نظام هستی رو آیات دیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 544.46,
   "end": 547.24,
   "text": "دیگه این‌ها می‌آرمند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 547.24,
   "end": 550.48,
   "text": "به اون آرامش و سکون لازم می‌رسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.48,
   "end": 555.82,
   "text": "به توحید محضه و توحید اصمد و اون وحدت وجودی می‌رسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 555.82,
   "end": 558.2,
   "text": "یعنی یک حقیقت می‌بینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 558.2,
   "end": 560.7,
   "text": "عالم رو که خداست و خدایی داره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 560.7,
   "end": 562.98,
   "text": "دیگه حرفی برای گفتن ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 562.98,
   "end": 566.2,
   "text": "همه در طول اوامر الهی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 566.2,
   "end": 573.36,
   "text": "\"يا أيها الذين آمنوا أطيعوا الله و أطيعوا الرسول و أولي الأمر منكم.\" تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.36,
   "end": 576.18,
   "text": "همه در طول اون امر‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 576.18,
   "end": 581.94,
   "text": "بحث حالا عالم امر و این‌ها که حضرات خمسه که انشاالله خواهد آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 581.94,
   "end": 585.74,
   "text": "که امر دست خداست حتی روح ما هم از امره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 585.74,
   "end": 589.82,
   "text": "\"يسألونك عن الروح قل الروح من أمر ربي.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 589.82,
   "end": 593.02,
   "text": "\"و ما أمرنا إلا واحدة.\" اصلاً امر ما یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 593.02,
   "end": 596.76,
   "text": "یک حقیقت واحده بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 596.76,
   "end": 599.38,
   "text": "دیگران کثرت بهش دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 599.38,
   "end": 602.96,
   "text": "و کثرت دیدن. حالا در عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 602.96,
   "end": 607.8,
   "text": "مظاهر اگر شما دقت کنید و مراتب بله خورده به کثرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 607.8,
   "end": 615.06,
   "text": "اما اینا رو ما نباید وجود حالا توحید عددی به قول بعضیا بهش بدیم و وجود جدایی از هم و مستقل از هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 615.06,
   "end": 619.28,
   "text": "به قول حضرت استاد علامه حسن زاده علیه الرحمه یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 619.28,
   "end": 625.38,
   "text": "خردرد در این دنیا جدا و منفصل از بقیه اشیاء نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 625.38,
   "end": 631.8,
   "text": "همه اشیاء به هم مرتبط‌اند چون همه اسماء در هم تنیده شده و به هم مرتبط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 631.8,
   "end": 635.94,
   "text": "مگر نه این است که \"و علم آدم الأسماء كلها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 635.94,
   "end": 640.98,
   "text": "و علامه بخواد برای اینکه سهولت فهم ایجاد کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 640.98,
   "end": 648.96,
   "text": "حقیقت مطلب رو به ما بچشونه فرمود بگید \"و علم آدم الأشیاء كلها\" درسته، معنای همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 648.96,
   "end": 651.88,
   "text": "یعنی اسماء مگر باز مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 651.88,
   "end": 660.38,
   "text": "علامه رفیع قزوینی، استاد علامه نفرمودن که هر کجا که سلطان وجود قدم نهاد اساکر اسماء موجودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 660.38,
   "end": 663.56,
   "text": "یعنی همه اسماء اونجا هستند، حاضرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 663.56,
   "end": 665.8,
   "text": "اما نسبت به اینکه دولت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 665.8,
   "end": 676.4,
   "text": "سلطان کدوم اسم قیام کند مثلاً شیئیت اون شی و صورتش و آثارش اینا متفاوت شده و الا در همه، همه اسماء هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 676.4,
   "end": 681.98,
   "text": "خب اگر همه اسماء هستند پس همه اشیاء هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 681.98,
   "end": 684.16,
   "text": "همه و همه هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 684.16,
   "end": 686.58,
   "text": "و در عین حال نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 686.58,
   "end": 689.08,
   "text": "هستند چون عالم کثرت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 689.08,
   "end": 693.3,
   "text": "واحدیت نظام هستی، تنزل اون حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 693.3,
   "end": 697.24,
   "text": "کلیه بسيط الحقیقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 697.24,
   "end": 700.86,
   "text": "نیستند از این حیث که به خودی خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 700.86,
   "end": 710.2,
   "text": "چیزی نیستند. \"إم من شيء إلا عندنا خزائنه و ما ننزله إلا بقدر معلوم.\" ننزله ما نازل کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 710.2,
   "end": 713.0,
   "text": "از اون خزانه. اونم چه شیرین که جمع می‌بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 713.0,
   "end": 717.26,
   "text": "خزائن و می‌گه خزیونه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 717.26,
   "end": 721.02,
   "text": "یعنی اینا از خزانه‌های متعددی نازل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 721.02,
   "end": 728.08,
   "text": "یه خزینه عالم مثال است که اومده به شهود مطلق که همین ملک است و ناصوت و دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 728.08,
   "end": 732.46,
   "text": "یه خزینه یا خزانه‌ها می‌تواند عالم عقل باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 732.46,
   "end": 737.46,
   "text": "که او به منزله‌ی روح است برای بدن عالم مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 737.46,
   "end": 740.88,
   "text": "عالم مثال روح است برای بدن عالم طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 740.88,
   "end": 744.5,
   "text": "همین‌طور خزینه‌ی فوق طور عقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 744.5,
   "end": 751.42,
   "text": "خزانه‌های اونجا، عرش، فوق عرش، اینا لاهوت اینا هرچی که شما بگیری بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 751.42,
   "end": 756.1,
   "text": "تا ثغی ذات حضرت حق همینطوری خزانه‌ها پشت خزانه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 756.1,
   "end": 760.42,
   "text": "همه‌ی اینا در طول هم اما یک وجود واحد الصمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 760.42,
   "end": 765.62,
   "text": "وقتی شما اینطوری دیدی بله \"و ما رأيت إلا جمیلا\" جز زیبایی چیزی نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 765.62,
   "end": 768.28,
   "text": "هر کجا که جلال است جمال هم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 768.28,
   "end": 770.6,
   "text": "هر کجا که جمال است جلال هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 770.6,
   "end": 773.64,
   "text": "ذو الجلال والاكرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 773.64,
   "end": 775.88,
   "text": "جزر و مد با هم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 775.88,
   "end": 781.82,
   "text": "که به یک معنا خدا هم جزر و مد داره، شب و روز هم جزر و مد داره، دریا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 781.82,
   "end": 785.82,
   "text": "آسمان و زمین هم جزر و مد دارن، انسان هم جزر و مد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 785.82,
   "end": 791.9,
   "text": "به یک معنا حقیقت جزر و مد در حضرت حق می‌شود جلال و جمال حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 791.9,
   "end": 796.22,
   "text": "جزرش بشود جلال و مدش بشود جمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 796.22,
   "end": 799.46,
   "text": "عزیزان دل که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 799.46,
   "end": 805.8,
   "text": "ما متأسفانه حالا بحث به اینجا کشیده شد خواستیم این رو عرض کنیم از کجا بحث به اینجا کشیده شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 805.8,
   "end": 808.96,
   "text": "این حقیقت که این روایت داره می‌فرماید اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 808.96,
   "end": 813.28,
   "text": "باور نکردن حرف عمرهاشون رو، حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 813.28,
   "end": 818.28,
   "text": "انبیاشون رو، این همه انزال كتب و ارسال رسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 818.28,
   "end": 820.34,
   "text": "صد و بیست و چهار هزار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 820.34,
   "end": 823.04,
   "text": "یعنی تا دلت بخواد ما هرچی-- هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 823.04,
   "end": 825.26,
   "text": "دوره‌ای رو شما حساب کنید ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 825.26,
   "end": 829.32,
   "text": "بدون نبی نگذاشتیم، بدون حجت نگذاشتیم که حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 829.32,
   "end": 832.42,
   "text": "رمزه دیگه. یک رو دو برابر کن می‌شه دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 832.42,
   "end": 834.16,
   "text": "دو رو دو برابر کن می‌شه چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 834.16,
   "end": 836.62,
   "text": "بعدش بزنش به هزار که عدد کثرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 836.62,
   "end": 840.5,
   "text": "صد و بیست و چهار هزار نه یعنی صد و بیست و چهار هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 840.5,
   "end": 843.36,
   "text": "نه منهای یک نه به علاوه‌ی یک، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 843.36,
   "end": 846.64,
   "text": "یعنی تا دلت بخواد ما نبی فرستادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 846.64,
   "end": 849.7,
   "text": "اما این انبیا همه در طول هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 849.7,
   "end": 853.8,
   "text": "لا نفرق بین احد من رسله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 853.8,
   "end": 857.76,
   "text": "دقت بفرمایید آیه‌ی قرآن. لا نفرق بین احد من رسله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 857.76,
   "end": 860.28,
   "text": "هیچ فرقی بین این‌ها از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 860.28,
   "end": 864.82,
   "text": "حالا اون \"تِلْكَ الرُّسُلْ فَأَوَّلْنَا بَعْضَهُمْ عَلَى بَعْضٍ\" هست بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 864.82,
   "end": 868.72,
   "text": "فضیلت و برتری بر همدیگه دارن اما راه یکی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 868.72,
   "end": 873.04,
   "text": "اصلاً همشون در طول ولایت کلیه‌ی الهی هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 873.04,
   "end": 879.64,
   "text": "و هر مقدار که متلبس به اسما پیدا کرد، اِاِاِ متلبس به اسماء الهی شدن و شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 879.64,
   "end": 883.92,
   "text": "وجودی بر اثر پیاده شدن این اسما در وجودشون حاصل شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 883.92,
   "end": 886.82,
   "text": "به یک معنا به ولایت رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 886.82,
   "end": 890.06,
   "text": "یعنی به همون میزانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 890.06,
   "end": 893.7,
   "text": "به ولایت رسیدن نبوت گرفتن و خبر گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 893.7,
   "end": 897.52,
   "text": "نبی، نابع، باخبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 897.52,
   "end": 899.92,
   "text": "مشبهه‌ش یا مثلاً مبالغه ‌ش می‌شه نبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 899.92,
   "end": 903.46,
   "text": "نابع، باخبر. از چی خبر دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 903.46,
   "end": 909.22,
   "text": "\"أَمَّ یَتَسَاءَلُونَ عَنِ النَّبَإِ الْعَظِيمِ\" اون نبأ عظیم، اون خبر بزرگ عالم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 909.22,
   "end": 911.46,
   "text": "تمام تفاسیر فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 911.46,
   "end": 917.96,
   "text": "ولایت امیرالمؤمنین، تفاسیر شیعه فرمودن مولامون علی علیه‌السلام صاحب ولایت کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 917.96,
   "end": 920.1,
   "text": "اون سلطان اول و آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 920.1,
   "end": 929.54,
   "text": "علی الاطلاق که به اذن الله به این سلطنت رسیدن که همه‌ی علم و حکمت نزد اوست که العلم سلطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 929.54,
   "end": 933.22,
   "text": "بله. چه جالب که امام رضا هم شدن سلطان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 933.22,
   "end": 936.5,
   "text": "سلطان صریر الارتضاء اینا بی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 936.5,
   "end": 939.3,
   "text": "بدون حساب نیست. العلم سلطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 939.3,
   "end": 943.12,
   "text": "اونم که عالم آل محمد صلی الله علیه و آسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 943.12,
   "end": 945.3,
   "text": "تو دلتون صلوات بفرستید که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 945.3,
   "end": 948.84,
   "text": "بحث قطع نشه، منم حواسم پرت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 948.84,
   "end": 952.14,
   "text": "بله. پس انبیا اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 952.14,
   "end": 955.8,
   "text": "تماماً یکجا جمع شن حرفشون یکی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 955.8,
   "end": 958.46,
   "text": "\"و ما امرنا إلا واحدة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 958.46,
   "end": 963.84,
   "text": "التوحید تمام. \"قل هو الله أحد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 963.84,
   "end": 966.36,
   "text": "الله الصمد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 966.36,
   "end": 971.24,
   "text": "تمام شد. دیگه اینجا اگر کسی به اینجا رسید و توجه داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 971.24,
   "end": 974.9,
   "text": "دیگه شک و تردیدی نسبت به گفتار اولیا و ائمه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 974.9,
   "end": 977.36,
   "text": "می‌بینه همه یک حرف می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 977.36,
   "end": 982.78,
   "text": "همه در مملکت وجود تجمع کنن همه‌شون دارای یک امرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 982.78,
   "end": 986.3,
   "text": "ان‌شاءالله که خدا به هممون رحم کنه و در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 986.3,
   "end": 991.74,
   "text": "هممون رو، همه‌ی ارکان وجودمون، ظاهر و باطنمون رو در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
