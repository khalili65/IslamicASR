 "chapters": [
  {
   "index": 0,
   "title": "## بازگشت به قلب منغمر و اعجاز علمی قرآن",
   "start": 13.04,
   "end": 134.52
  },
  {
   "index": 1,
   "title": "آیه‌ای که در قرآن دربارهٔ زنبور آمده، آیهٔ شصت‌وهشت و شصت‌ونه سورهٔ نحل است:",
   "start": 134.52,
   "end": 272.4
  },
  {
   "index": 2,
   "title": "## معانی وحی؛ الهام خودآگاه و غریزی",
   "start": 272.4,
   "end": 484.63
  },
  {
   "index": 3,
   "title": "## خانه‌های شش‌ضلعی، ملکه و تقسیم کار",
   "start": 484.63,
   "end": 504.75
  },
  {
   "index": 4,
   "title": "## رنگ، شفا، عناصر و فسادناپذیری",
   "start": 504.75,
   "end": 806.86
  },
  {
   "index": 5,
   "title": "## عشق به کار، خدمت، گرده‌افشانی و نظافت",
   "start": 806.86,
   "end": 1005.94
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.5,
   "end": 5.42,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.42,
   "end": 8.26,
   "text": "السلام علیک ای داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.26,
   "end": 13.04,
   "text": "و ربانی ایات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.04,
   "end": 15.84,
   "text": "مدتی بود که توفیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.84,
   "end": 20.72,
   "text": "شامل حال ما نبود در خدمت شما پیرامون بحث قلب در قرآن باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.72,
   "end": 27.04,
   "text": "متأسفانه به کرونا که خوردیم تعطیل شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.04,
   "end": 29.28,
   "text": "لیاقت از ما سلب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.28,
   "end": 38.5,
   "text": "اه به فضل الهی اگر خدای منّان عنایت کنند به فضل الهی ادامه بدیم بحث رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.5,
   "end": 45.36,
   "text": "اه اگر چنانچه خاطرتون باشه رسیده بودیم به قلب منغمر در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.36,
   "end": 52.54,
   "text": "و امروز ظاهراً جلسه چهارصد و سی و چهار این حدودا باید باشیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.54,
   "end": 59.44,
   "text": "که ما قلب منغمر رو یعنی بی‌خبر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 59.44,
   "end": 64.42,
   "text": "به جایی رسونده بودیم که داشتیم از اعجاز قرآن سخن می‌گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 64.42,
   "end": 76.08,
   "text": "که علت بی‌خبری ما، بی‌توجهی ما به قرآن و اعجاز علمی قرآن است که اگر کسی متوجه اعجاز علمی قرآن بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 76.08,
   "end": 80.26,
   "text": "و درون مایه علمی قرآن رو متوجه بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 80.26,
   "end": 83.2,
   "text": "قطعاً نهیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 83.2,
   "end": 85.88,
   "text": "سنگینی به او خواهد خورد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 85.88,
   "end": 89.9,
   "text": "مسلماً از این بی‌خبری قلبش بیرون خواهد آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 89.9,
   "end": 93.06,
   "text": "به عنوان نمونه از تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 93.06,
   "end": 98.88,
   "text": "معتبر و مهم و گران‌سنگ نمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 98.88,
   "end": 102.24,
   "text": "داشتیم نکاتی رو بیان می‌کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 102.24,
   "end": 105.44,
   "text": "و امروز به امید خدا پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 105.44,
   "end": 111.3,
   "text": "زنبور عسل نکاتی رو عرض می‌کنیم خدمت شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 111.3,
   "end": 116.66,
   "text": "آیه‌ای که در قرآن پیرامون زنبور عسل آمده آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 116.66,
   "end": 118.86,
   "text": "شصت و هشت و شصت و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.86,
   "end": 128.04,
   "text": "سوره نحل هست که \"و أوحي ربك إلى النحل أن اتخذي من الجبال بيوتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 128.04,
   "end": 132.48,
   "text": "و من الشجر و مما يعرشون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 132.48,
   "end": 139.26,
   "text": "این نشون میده که این وحی که در اینجا به، از طرف پروردگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 139.26,
   "end": 144.54,
   "text": "به زنبور عسل می‌شود که یک نوع الهام غریزی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 144.54,
   "end": 147.58,
   "text": "اه محاکات از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 147.58,
   "end": 150.1,
   "text": "اه خانه گزینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 150.1,
   "end": 156.32,
   "text": "زنبور عسل دارد در جاهای مرتفع بلند \"مما يعرشون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 156.32,
   "end": 161.54,
   "text": "و همچنین درخت‌ها و کوه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 161.54,
   "end": 167.22,
   "text": "بعد می‌فرماید که \"ثم كلي من كل الثمرات فاسلكي سبل ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 167.22,
   "end": 172.52,
   "text": "ذللا يخرج من بطونها شراب مختلف ألوانه فيه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 172.52,
   "end": 180.44,
   "text": "شفاء للناس\". که بعد خدای منّان می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 180.44,
   "end": 183.16,
   "text": "از همه محصولات بخور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 183.16,
   "end": 191.04,
   "text": "و این الهامی که خدا به زنبور می‌کنه و راه‌های پروردگارت رو به صورت فروترانه بپیما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 191.04,
   "end": 195.62,
   "text": "و خدا می‌فرماید که در ادامه از شکم‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 195.62,
   "end": 202.64,
   "text": "این زنبورها نوشیدنی که منظور همون عسل هست بیرون میاد که \"فيه شفاء للناس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 202.64,
   "end": 208.84,
   "text": "که حالا اول می‌فرمود مختلف الألوان این رنگ‌هاشون متفاوت‌اند به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 208.84,
   "end": 213.22,
   "text": "تنوع گیاهی البته و همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 213.22,
   "end": 216.72,
   "text": "خاصیت درمانی عسل رو \"فيه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 216.72,
   "end": 219.46,
   "text": "می‌فرماید \"فيه شفاء للناس\" بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 219.46,
   "end": 224.86,
   "text": "\"إن في ذلك لآية\" قطعاً در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 224.86,
   "end": 231.94,
   "text": "یعنی در زندگی زنبور عسل \"لآية\" باز تأکید می‌کنه که قطعاً نشانه‌ایست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 231.94,
   "end": 239.7,
   "text": "البته \"لقوم يتفكرون\" برای قومی که اهل تفکر باشند، اهل تعقل باشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 239.7,
   "end": 243.1,
   "text": "خب ما می‌بینیم که در میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 243.1,
   "end": 247.02,
   "text": "موجودات نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 247.02,
   "end": 249.72,
   "text": "خدای منّان چطور شده که دست رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 249.72,
   "end": 253.08,
   "text": "زنبور و عسل اون گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 253.08,
   "end": 256.04,
   "text": "این نشون میده که اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 256.04,
   "end": 259.68,
   "text": "آفرینش در زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 259.68,
   "end": 261.88,
   "text": "زنبور و البته در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 261.88,
   "end": 265.02,
   "text": "کی-کیفیت عسل سازی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 265.02,
   "end": 270.0,
   "text": "خیلی هست که خدای منّان توجه ما رو به اون جلب کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 270.0,
   "end": 272.4,
   "text": "حالا اینجا بحث وحی هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 272.4,
   "end": 276.32,
   "text": "در مفردات مرحوم راغب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 276.32,
   "end": 284.06,
   "text": "وحی رو گاهی به اشاره سریع ازش یاد می‌کنه، گاهی به القا کردن مخفیانه سخنی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 284.06,
   "end": 288.42,
   "text": "ازش یاد می‌کنه و این‌ها. ولی در قرآن مجید وحی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 288.42,
   "end": 291.62,
   "text": "معانی مختلفی به کار رفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 291.62,
   "end": 296.72,
   "text": "اه من جمله مثلاً وحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 296.72,
   "end": 299.78,
   "text": "الهامی، وحی به معنای الهام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 299.78,
   "end": 305.74,
   "text": "که حالا وقتی این وحی رو خودآگاه بگیریم در مورد انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 305.74,
   "end": 309.62,
   "text": "قرآن می‌فرماید \"و أوحينا إلى أم موسى أن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 309.62,
   "end": 313.92,
   "text": "أرضعيه فإذا خفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 313.92,
   "end": 317.7,
   "text": "عليه فألقيه في اليم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 317.7,
   "end": 319.82,
   "text": "این آیه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 319.82,
   "end": 323.72,
   "text": "داره صریحاً در آیه هفت قصص باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 323.72,
   "end": 328.06,
   "text": "در خصوص وحی، اون الهام خودآگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 328.06,
   "end": 332.24,
   "text": "حضرت مادر حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 332.24,
   "end": 334.4,
   "text": "مطلب بیان می‌کنه. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 334.4,
   "end": 337.02,
   "text": "گاهی اوقات به صورت ناخودآگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 337.02,
   "end": 339.52,
   "text": "بیان می‌شه، ناآگاه بهتره بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 339.52,
   "end": 343.98,
   "text": "ناآگاه بیان می‌شه که همون الهام غریزی‌ست که اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 343.98,
   "end": 348.6,
   "text": "در خصوص زنبور عسل بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 348.6,
   "end": 351.2,
   "text": "حالا اینجا یه سوالی پیش میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 351.2,
   "end": 355.36,
   "text": "بالاخره این غرائز و الهامات غریزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 355.36,
   "end": 358.2,
   "text": "منحصر به زنبوران عسله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 358.2,
   "end": 360.8,
   "text": "که نیست. اگر این چنین نیست پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 360.8,
   "end": 367.3,
   "text": "چ-چگونه‌ست که اینجا وحی رو به زنبور عسل خدا در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 367.3,
   "end": 370.51,
   "text": "اشاره کرده و بیان کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 370.51,
   "end": 373.73,
   "text": "نکته‌ای رو وقتی بهش توجه کنیم سؤال ما جواب داده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 373.73,
   "end": 376.95,
   "text": "اونم اینه که امروزه دانشمندان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 376.95,
   "end": 382.11,
   "text": "وقتی توجه به زندگی زنبور خصوصاً به صورت اجتماعی کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 382.11,
   "end": 384.19,
   "text": "آنقدر به نکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 384.19,
   "end": 386.69,
   "text": "شگفت‌انگیزی رسیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 386.69,
   "end": 392.89,
   "text": "که اساساً زندگی خصوصاً اجتماعی زنبور عسل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 392.89,
   "end": 398.59,
   "text": "از حیث تمدن و اون پیچیدگی‌های اجتماعیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 398.59,
   "end": 403.53,
   "text": "بسیار بالاتر از تمدن انسانی حتی برشمردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 403.53,
   "end": 407.15,
   "text": "و وقتی این چنین نگاه می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 407.15,
   "end": 410.43,
   "text": "این سؤال جوابش داده میشه که چرا خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 410.43,
   "end": 413.21,
   "text": "در قرآن دست گذاشته روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 413.21,
   "end": 416.85,
   "text": "زنبور عسل و عسل اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 416.85,
   "end": 420.71,
   "text": "و اون موقع است که ما متوجه اعجاب علمی قرآن میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 420.71,
   "end": 425.39,
   "text": "خب بخشی از این پیچیدگی‌ها و از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 425.39,
   "end": 430.29,
   "text": "شگفتی‌های در زندگی زنبور عسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 430.29,
   "end": 438.21,
   "text": "و خود به وجود آمدن عسل قبلاً در زمان مثلاً نزول قرآن خیلی به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 438.21,
   "end": 440.63,
   "text": "کم و به ندرت وجود داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 440.63,
   "end": 443.87,
   "text": "مردم آگاهی داشتن اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 443.87,
   "end": 446.51,
   "text": "نه به این صورت، نه به این حد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 446.51,
   "end": 452.79,
   "text": "این یکی از اعجاز بلکه یکی از بهترین اعجاز علمی قرآن هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 452.79,
   "end": 458.15,
   "text": "عظمت و قدرت آفریدگارش رو می‌رسونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 458.15,
   "end": 462.31,
   "text": "یه چنین حشره‌ی عجیبی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 462.31,
   "end": 468.85,
   "text": "خدای منّان خلق کرده و اسرارش رو این چنین گوشزد می‌کنه در قرآن به اهلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 468.85,
   "end": 476.09,
   "text": "البته اهل فکر. حالا اجازه بدید برای اینکه کامتون شیرین‌تر باشه من بعضی از نکات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 476.09,
   "end": 478.95,
   "text": "در خصوص زنبور عسل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 478.95,
   "end": 483.09,
   "text": "زندگی اجتماعیشون برای شما عرض کنم ببینید چقدر جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 483.09,
   "end": 487.97,
   "text": "خب می‌دونید که نخستین ماموریت زنبور عسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 487.97,
   "end": 490.03,
   "text": "خانه‌سازی اونه به شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 490.03,
   "end": 498.21,
   "text": "شش ضلعی. اتفاقاً در یک روایتی دیدم امام صادق صلی الله علیه توصیه می‌کنند به توجه به همین شش ضلعی بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 498.21,
   "end": 501.39,
   "text": "خانه‌های زنبور عسل و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 501.39,
   "end": 503.39,
   "text": "که بعد حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 503.39,
   "end": 505.63,
   "text": "ادامه میدن در انتها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 505.63,
   "end": 510.93,
   "text": "این موجود، این موجود عجیب و غریب خودش هم بی‌اطلاع است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 510.93,
   "end": 518.49,
   "text": "از وضعیت خودش، جایگاه خودش و کارهایی که انجام میده همه به الهام خدای دانا و تواناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 518.49,
   "end": 523.89,
   "text": "خب این خانه‌های شش ضلعی که زنبور عسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 523.89,
   "end": 530.49,
   "text": "به ظرافت و مهندسی خاصی ایجاد می‌کنه با یک زوایای دقیق و یکسان یک شکل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 530.49,
   "end": 532.43,
   "text": "یک استحکام خاصی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 532.43,
   "end": 535.15,
   "text": "جالبه که مصالح ساختمانیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 535.15,
   "end": 538.57,
   "text": "برای ساختن این خانه‌های شش ضلعی مومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 538.57,
   "end": 541.41,
   "text": "یکی از دانشمندان زیست‌شناسی به نام موریس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 541.41,
   "end": 548.35,
   "text": "مترلینک میگه برای ما مشکله که بدونیم این موم چگونه و به چه ترتیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 548.35,
   "end": 552.53,
   "text": "میان زنبورها، زنبوران عسل تراوش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 552.53,
   "end": 555.71,
   "text": "یعنی واقعاً اهلش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 555.71,
   "end": 559.41,
   "text": "همین موجود کوچک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 559.41,
   "end": 563.37,
   "text": "به تعجب وا داشته. حالا در میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 563.37,
   "end": 570.05,
   "text": "زنبورها یک زنبور ویژه‌ای هست به نام ملکه که تخم‌ریزی می‌کنه، جثه‌اش درشت‌تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 570.05,
   "end": 574.17,
   "text": "بزرگ‌تره، موقعیت خاصی داره، غذای مخصوصی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 574.17,
   "end": 576.67,
   "text": "جالبه که تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 576.67,
   "end": 581.87,
   "text": "زنبورها خودشون رو فدای او می‌کنند، از او مراقبت و محافظت می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 581.87,
   "end": 587.41,
   "text": "که حالا برداشت‌های خیلی شیرینی پیرامون علم جامعه‌شناسی از اینجا میشه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 587.41,
   "end": 590.29,
   "text": "بماند. برخی‌شون مامور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 590.29,
   "end": 594.21,
   "text": "حفظ درجه حرارت کندو هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 594.21,
   "end": 598.23,
   "text": "برخی‌شون مامور ساخت و مرمت کندو هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 598.23,
   "end": 602.51,
   "text": "برخی مامور کنترل ورود و خروج هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 602.51,
   "end": 606.39,
   "text": "که حالا عرض می‌کنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 606.39,
   "end": 610.53,
   "text": "جالبه که وقتی این‌ها خب میخوان برن شهد گل رو این‌ها رو بردارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 610.53,
   "end": 613.73,
   "text": "راه بسیار طولانی رو بعضاً چند فرسخ طی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 613.73,
   "end": 616.35,
   "text": "چگونه است این‌ها گم نمیشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 616.35,
   "end": 626.45,
   "text": "دانشمندان کشف کردن که این‌ها نشانه‌گذاری می‌کنند از طریق پراکندن بوهای مختلف تو مسیر راهشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 626.45,
   "end": 631.11,
   "text": "عرض شود این‌ها اون شیره گل‌ها رو وقتی برمی‌دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 631.11,
   "end": 636.71,
   "text": "خیلی جالبه که این‌ها رو در بعضی از حفره‌های داخل بدن خودشون می‌فرستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 636.71,
   "end": 640.53,
   "text": "این حفره‌ها رو دانشمندا گفتن مثل یک کارخونه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 640.53,
   "end": 646.19,
   "text": "کوچک شیمیاییه که فعل و انفعالات شیمیایی در اون حفره‌ها رخ میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 646.19,
   "end": 649.49,
   "text": "و از این شهد گل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 649.49,
   "end": 653.29,
   "text": "یک به قول قرآن عسل مصفایی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 653.29,
   "end": 656.85,
   "text": "ایجاد می‌کنند در این حفره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 656.85,
   "end": 662.03,
   "text": "یعنی در پی اون تحولات مختلفی که بر شهد ایجاد میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 662.03,
   "end": 666.61,
   "text": "تبدیل به عسل میشه. البته در بعضی روایات پیامبر فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 666.61,
   "end": 671.23,
   "text": "این عسل تل-- این شهد، شهد گل خیلی تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 671.23,
   "end": 677.27,
   "text": "به عسل وحی میشه که صلوات بر من و آلَم بفرسته و بر اثر صلواتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 677.27,
   "end": 679.63,
   "text": "زنبور می‌فرسته چنین شیرین میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 679.63,
   "end": 683.01,
   "text": "اینم خودش سرّ است که اگر کسی می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 683.01,
   "end": 687.19,
   "text": "شیرین بشه زندگیش، زندگیش عسلی بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 687.19,
   "end": 692.51,
   "text": "باید کثرت صلوات داشته باشه و البته حقیقت صلوات در او پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 692.51,
   "end": 697.89,
   "text": "بماند. رنگ عسل نکته جالبیه که قرآن هم می‌فرمود مختلفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 697.89,
   "end": 702.55,
   "text": "این اختلاف رنگ‌ها به اون گل و گیاه و میوه‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 702.55,
   "end": 706.15,
   "text": "این‌هایی است که هر کدوم یک خاصیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 706.15,
   "end": 708.99,
   "text": "دارویی و درمانی ویژه‌ای دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 708.99,
   "end": 713.53,
   "text": "که عسل-- زنبور رفته از اون‌ها شهد رو برداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 713.53,
   "end": 716.55,
   "text": "لذا متعددند. این خودش باعث میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 716.55,
   "end": 720.13,
   "text": "اون خاصیت‌های دارویی و درمانی عسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 720.13,
   "end": 724.47,
   "text": "بیاد و گیاه‌ها، بیاد در قالب عسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 724.47,
   "end": 730.11,
   "text": "و در بین مردم پخش بشه که قرآن از او به شفا یاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 730.11,
   "end": 733.17,
   "text": "نکات بسیار زیادی هست حالا وقتتون رو خیلی نگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 733.17,
   "end": 736.16,
   "text": "مثلاً فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 736.16,
   "end": 739.48,
   "text": "عسل خیلی زود جذب خون میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 739.48,
   "end": 744.04,
   "text": "و به جهت همین سرعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 744.04,
   "end": 748.22,
   "text": "ورودش به مرحله ساخت و ساز خیلی انرژی زاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 748.22,
   "end": 750.18,
   "text": "جالبه که بدونید از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 750.18,
   "end": 754.98,
   "text": "ایجاد عفونت جلوگیری میکنه خصوصا در معده و روده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 754.98,
   "end": 757.68,
   "text": "ترمیم قوای بدن رو میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 757.68,
   "end": 760.74,
   "text": "بی جهت نیست قرآن اون رو شفایاب کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 760.74,
   "end": 765.54,
   "text": "درش آهن هست، منیزیم هست، پتاسیم هست، عناصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 765.54,
   "end": 772.52,
   "text": "مورد نیاز بدن هست به مقدار قابل ملاحظه، مخصوصا ویتامین‌هایی مثل A، B، T، K و و و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 772.52,
   "end": 775.98,
   "text": "جالبه که هرگز فاسد نمیشه عسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 775.98,
   "end": 778.96,
   "text": "البته در درون ظرف فلزی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 778.96,
   "end": 782.52,
   "text": "اَل-- دانشمندا گفتن نریزید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 782.52,
   "end": 788.14,
   "text": "که اون خاصیتش از بین میره و چه شیرین که در قرآن هم در اونجاهایی که قر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 788.14,
   "end": 791.78,
   "text": "خدا دستور داده، وحی میکنه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 791.78,
   "end": 794.82,
   "text": "زنبور که خانه اختیار کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 794.82,
   "end": 797.44,
   "text": "در کوه و درخت و اینهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 797.44,
   "end": 800.94,
   "text": "یعنی جاهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 800.94,
   "end": 804.7,
   "text": "سنگ و چوب هست، نه فلز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 804.7,
   "end": 811.82,
   "text": "خیلی عجیبش عشق بسیار زیاد زنبورها به کار و فعالیت خستگی ناپذیرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 811.82,
   "end": 814.52,
   "text": "صبح تا شب اون طوری فعالیت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 814.52,
   "end": 820.84,
   "text": "حالا اگر بگیم که برای مثلا آذوقه خودشون زحمت می‌کشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 820.84,
   "end": 823.16,
   "text": "که گفتن دو سه تا گل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 823.16,
   "end": 828.36,
   "text": "برای آذوقه صبح تا شب یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 828.36,
   "end": 831.9,
   "text": "مثلا یه دونه از این زنبورا کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 831.9,
   "end": 839.26,
   "text": "در حالی که بیش از سیصد گل رو این‌ها شهد برداری می‌کنن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 839.26,
   "end": 844.0,
   "text": "خودش میشه آذوقه چند هفته و بعضا چند ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 844.0,
   "end": 848.16,
   "text": "این نشون میده که خدمت به دیگران از عشق اوناست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 848.16,
   "end": 854.02,
   "text": "و حتی ب-- از بعضی از کندوها تا چهل کیلو عسل گفتن برداشت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 854.02,
   "end": 857.44,
   "text": "حالا و چه شیرین که در میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 857.44,
   "end": 864.1,
   "text": "گفتار اهل بیت علیهم الصلاة والسلام بر می‌خوریم به اینکه شیعیان ما مثل زنبور عسل هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 864.1,
   "end": 865.88,
   "text": "اینم خودش نکته شیرینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 865.88,
   "end": 870.24,
   "text": "خودتون دیگه به-- اِاِاِ عرض شود اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 870.24,
   "end": 875.26,
   "text": "اجتهاد فکریتون این را اینج-- اینجا با توجه به این نکاتی که داریم عرض می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 875.26,
   "end": 878.06,
   "text": "متوجه اون عمق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 878.06,
   "end": 881.68,
   "text": "صحبت اهل بیت می‌شید. گرد‌افشانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 881.68,
   "end": 886.44,
   "text": "عسل‌ها خیلی جالبه که تکثیر گیاهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 886.44,
   "end": 889.74,
   "text": "بر اثر این گرد‌افشانی‌ها بیشتر از هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 889.74,
   "end": 891.44,
   "text": "حشره دیگه‌ای صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 891.44,
   "end": 897.24,
   "text": "در، در صورتی که حتی تا اونجایی که گفتن اگر زنبور عسل از بین بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 897.24,
   "end": 903.96,
   "text": "هزاران نوع گیاه و گل و میوه و این‌ها از بین میرن و ما از این‌ها و از این وابستگی بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 903.96,
   "end": 906.24,
   "text": "مخلوقات الهی بی‌توجهیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 906.24,
   "end": 910.14,
   "text": "بی‌خبریم، دچار قلب منغمسریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 910.14,
   "end": 913.42,
   "text": "نظافت اون‌ها خیلی عجیبه، پاکیزگیشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 913.42,
   "end": 916.62,
   "text": "بسیار حساسن به پاکیزگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 916.62,
   "end": 920.78,
   "text": "و مطلقا جای آلوده و کثیف نمی‌شینن که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 920.78,
   "end": 925.08,
   "text": "شهد مسمومی، آلوده‌ای، چیزی با خودشون داشته باشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 925.08,
   "end": 928.86,
   "text": "همون زنبورهایی که عرض کردم به عنوان مأمور و کنترل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 928.86,
   "end": 931.72,
   "text": "ورود و خروجن، محافظ کندون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 931.72,
   "end": 937.2,
   "text": "بو می‌کنن این‌ها رو. اگر این‌ها آلوده باشن یا شهد مسموم باهاشون باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 937.2,
   "end": 939.44,
   "text": "اِاِاِ این‌ها رو دو نیم می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 939.44,
   "end": 943.06,
   "text": "با یه خشونت خاصی با این‌ها برخورد می‌کنن و این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 943.06,
   "end": 946.94,
   "text": "می‌کشن، از بین می‌برن. خیلی عجیب واقعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 946.94,
   "end": 950.42,
   "text": "اون خرتوم‌هاشون در گرمای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 950.42,
   "end": 952.72,
   "text": "زیاد مثلا تابستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 952.72,
   "end": 954.98,
   "text": "با اون خرتوم‌ها آب برمی‌دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 954.98,
   "end": 962.48,
   "text": "می‌برن داخل کندو یکجا مج-- مجتمع می‌کنن این آب رو بعد بالا سر این آب‌ها بال و پر می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 962.48,
   "end": 970.88,
   "text": "مثل کولر آبی و هوای کندو رو خنک نگه می‌دارن برای ملکه و دیگر زنبورها و برای همچنین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 970.88,
   "end": 973.1,
   "text": "عسل حفظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 973.1,
   "end": 974.82,
   "text": "به هر حال این زیاد هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 974.82,
   "end": 983.48,
   "text": "بخوایم اینطوری بگیم باید تازه اونچه که کشف کردن و متوجه شدن تا شب حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 983.48,
   "end": 987.48,
   "text": "همین مقدار رو بسنده می‌کنم و واقعا سبحان الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 987.48,
   "end": 990.56,
   "text": "سبحان الله، سبحان الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 990.56,
   "end": 995.54,
   "text": "که خدا چه کرده و چقدر ما بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 995.54,
   "end": 999.5,
   "text": "خدا ما را از شر قلب بی‌خبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 999.5,
   "end": 1003.84,
   "text": "خلاصی مرحمت کنه. انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1003.84,
   "end": 1005.94,
   "text": "به برکت صلوات بر محمد و آل-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}