   "start": 0.44,
   "end": 20.48
  },
  {
   "index": 1,
   "title": "## صد کلمه و هشدار از غفلت از خطاب محمدی",
   "start": 20.48,
   "end": 242.68
  },
  {
   "index": 2,
   "title": "## معجزات علمی قرآن و دل سپردن",
   "start": 242.68,
   "end": 273.08
  },
  {
   "index": 3,
   "title": "آیهٔ دوم سورهٔ رعد را بنگرید:",
   "start": 273.08,
   "end": 293.6
  },
  {
   "index": 4,
   "title": "## عبادت تا یقین؛ و معنای موت",
   "start": 293.6,
   "end": 485.8
  },
  {
   "index": 5,
   "title": "## جاذبه و ستون‌های نامرئی",
   "start": 485.8,
   "end": 629.08
  },
  {
   "index": 6,
   "title": "## حدیث امیرالمؤمنین: شهرها و عمود نور",
   "start": 629.08,
   "end": 930.0
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 4.32,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.32,
   "end": 8.08,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.08,
   "end": 11.26,
   "text": "آياته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.26,
   "end": 15.74,
   "text": "بعضی پرسیدن که شما در خصوص نماز جمعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.74,
   "end": 19.3,
   "text": "اه، اصطلاح وجوب تخیری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.3,
   "end": 22.8,
   "text": "بیان کردید یعنی چی؟ وجوب تخیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.8,
   "end": 27.88,
   "text": "یعنی مکلف در ادای وریز-- فریضه واجب ظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.88,
   "end": 33.4,
   "text": "در روز جمعه بین خواندن نماز جمعه یا نماز ظهر مخیر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.4,
   "end": 36.34,
   "text": "می‌تواند اختیار کنه نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.34,
   "end": 38.68,
   "text": "جمعه رو به جای نماز ظهر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.68,
   "end": 41.6,
   "text": "می‌تونه نه، نماز ظهر رو هم بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.6,
   "end": 44.46,
   "text": "در کنار نماز جمعه. این یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.46,
   "end": 48.12,
   "text": "وجوب تخیری. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.12,
   "end": 52.6,
   "text": "بحث قلب منغمر رو به فضل الهی ادامه میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.6,
   "end": 57.9,
   "text": "اتفاقا، اه، انشاالله سر سفره‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.9,
   "end": 60.42,
   "text": "صد کلمه در معرفت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.42,
   "end": 63.2,
   "text": "حضرت استاد که بنشینیم، اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.2,
   "end": 66.5,
   "text": "نه به تفصیل، ابتدا به اجمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.5,
   "end": 70.76,
   "text": "بیان خواهیم کرد. بسیاری از کلماتی که حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.76,
   "end": 75.8,
   "text": "در صد کلمه آوردند همش نهیبه بر همین موضوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.8,
   "end": 79.68,
   "text": "اینه که نکنه جا بمونید و بی‌خبر بمونید از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.68,
   "end": 82.02,
   "text": "خطاب محمدی که همان قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.02,
   "end": 88.04,
   "text": "نکنه بی‌خبر بمونید و جا بمونید، غافل بمونید از حقیقت قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.04,
   "end": 91.42,
   "text": "اتفاقا مثلا در کلمه‌ی بیستش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.42,
   "end": 96.14,
   "text": "در کلمه‌ی بیست صد کلمه در معرفت نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.14,
   "end": 100.14,
   "text": "اونجا حضرت استاد می‌فرمایند اون که، اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 100.14,
   "end": 104.38,
   "text": "از اطلاع فهم خطاب محمدی سرباز زده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 104.38,
   "end": 107.4,
   "text": "منظور از خطاب محمدی هم قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.4,
   "end": 110.16,
   "text": "می‌فرماید کسی که سرباز زده از اطلاع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.16,
   "end": 114.64,
   "text": "فهم این قرآن خود را به مفت باخته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.64,
   "end": 118.74,
   "text": "که حالا این بعضیا گمان می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.74,
   "end": 122.1,
   "text": "فهم خطاب یا فهم قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.1,
   "end": 129.0,
   "text": "یعنی همین که قرآن رو بخونن، ترجمه زیر آیات رو بخونن و مثلا قرآن رو حفظ کنن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.0,
   "end": 131.18,
   "text": "حالا به یک صوت جمیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.18,
   "end": 133.82,
   "text": "به صورت مجلسی مثلا قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 133.82,
   "end": 136.0,
   "text": "تلاوت کنن، قرائت کنن اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 136.0,
   "end": 139.96,
   "text": "نه، اینها انزل مراتبشه و اینها اون اصل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 139.96,
   "end": 143.4,
   "text": "اگرچه رهبر عزیزمون فرمودن اینا پایه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 143.4,
   "end": 148.78,
   "text": "و بستر و مقدمه اون فهم قرآنی و عمل به اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 148.78,
   "end": 151.72,
   "text": "اما اینا انزله، نباید اینها با هم خلط بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 151.72,
   "end": 156.98,
   "text": "اتفاقا چه عجیب که وقتی شما در بحث فهم و حفظ رجوع می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 156.98,
   "end": 160.52,
   "text": "به بحث مزاج شناسی، حالا یه پرانتز باز کنیم اینجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 160.52,
   "end": 164.28,
   "text": "اونجا می‌بینید که اصلا فهم عمیق در رطوبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.28,
   "end": 168.38,
   "text": "یعنی مزاجی که رطوبت داره فهم عمیقی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.38,
   "end": 176.04,
   "text": "اصولا آدم‌هایی که مزاجشون رطوبت داره یعنی رطوبت، اون رط به وجودیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.04,
   "end": 181.38,
   "text": "استیلا داره و غالبه اونا فهم عمیق‌تری دارن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.38,
   "end": 185.38,
   "text": "همش-- و همین‌ها حفظ زیادشون خیلی خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.38,
   "end": 188.02,
   "text": "چرا؟ چون حفظ در یبوسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.02,
   "end": 192.36,
   "text": "در آدم‌هایی که یابس هستن، خشکه، مزاجشون خشکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 192.36,
   "end": 195.28,
   "text": "اونا اتفاقا حفظ خیلی خوبی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 195.28,
   "end": 200.2,
   "text": "و فهمشون، فهم عمیقشون البته ضعیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.2,
   "end": 201.88,
   "text": "لذا اینها باید مقدمه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.88,
   "end": 205.62,
   "text": "اینکه ما صرفا بخواهیم از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.62,
   "end": 210.7,
   "text": "اه، حفظ بریم صرف حفظ بریم مثلا به فهم برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 210.7,
   "end": 212.48,
   "text": "صرف حفظ خالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 212.48,
   "end": 216.04,
   "text": "یعنی بدونیم که خب ما هم که حفظ کردیم آیات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.04,
   "end": 221.98,
   "text": "مثلا در ز-- جمله کسانی هستیم که حافظ قرآنیم یا حافظ روایاتیم، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 221.98,
   "end": 225.4,
   "text": "اون حفظ کردن یعنی در درون خودت پیاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 225.4,
   "end": 227.56,
   "text": "اون معنای ارشیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 227.56,
   "end": 231.1,
   "text": "و الا خب حالا این حسب ظاهرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 231.1,
   "end": 236.86,
   "text": "اه، بله از-- به هر حال انسان باید از همین ابتدا و از این گام‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.86,
   "end": 238.66,
   "text": "جلوی پای خودش شروع کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 238.66,
   "end": 241.7,
   "text": "و الا زمین می‌خوره. مخصوصا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 241.7,
   "end": 244.92,
   "text": "حیث حالا اینکه ما در بحث قلب منغمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 244.92,
   "end": 249.8,
   "text": "یه چند جلسه‌ای هست که پیرامون معجزات علمی قرآن داریم بحث می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.8,
   "end": 252.3,
   "text": "یه حسبش همینه که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 252.3,
   "end": 258.82,
   "text": "از این حیث به عظمت و حقانیت قرآن که پی ببریم اون موقع دل میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 258.82,
   "end": 265.14,
   "text": "وقتی متزلزلیم متاسفانه نسبت به حقانیت قرآن دل هم نمیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.14,
   "end": 269.46,
   "text": "مثلا شما ببینید آیه دو سوره رعد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.46,
   "end": 271.82,
   "text": "ببینید اونجا براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 271.82,
   "end": 276.46,
   "text": "ببینید این همه خدا عظمت رو آفریده صرفا به خاطر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 276.46,
   "end": 283.66,
   "text": "آ-- انتهای آیه میگه برای چی؟ الله الذي رفع السماوات بغير عمد ترونها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.66,
   "end": 287.76,
   "text": "خدا کسیه که آسمان رو، آسمان‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.76,
   "end": 290.8,
   "text": "بدون ستون‌هایی که اونا رو ببینید برافراشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.8,
   "end": 293.6,
   "text": "یعنی ستون‌ها هستن. نه اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.6,
   "end": 296.86,
   "text": "ستون‌ها نیستن، هستن اما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 296.86,
   "end": 299.9,
   "text": "اه، نمی‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.9,
   "end": 301.54,
   "text": "ثم استوی علی العرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 301.54,
   "end": 306.72,
   "text": "سپس بر تخت فرمانروایی خودش، خداست و خدایی می‌کنه دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.72,
   "end": 311.02,
   "text": "تسلط پیدا کرد. وسخر الشمس والقمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.02,
   "end": 314.18,
   "text": "و اینجا رام کرد، تسخیر کرد برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 314.18,
   "end": 316.52,
   "text": "چی رو؟ خورشید و ماه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 316.52,
   "end": 319.22,
   "text": "کل یجري لاجل مسمى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 319.22,
   "end": 323.68,
   "text": "حالا همین خورشید و ماه به این عظمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 323.68,
   "end": 328.78,
   "text": "اینها در یک مدار معینی و یک سرامدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.78,
   "end": 332.54,
   "text": "روانن و البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.54,
   "end": 336.02,
   "text": "کل یجري لاجل مسمى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.02,
   "end": 338.58,
   "text": "توی وقتی، وقت معینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.58,
   "end": 341.04,
   "text": "خب یدبر الامر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.04,
   "end": 344.34,
   "text": "که خدا اینجا همه کارها رو تدبیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 344.34,
   "end": 347.62,
   "text": "یفصل الآیات نشانه‌های خودش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 347.62,
   "end": 350.78,
   "text": "همین آیات خودش رو شرح میده به تفصیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.78,
   "end": 353.0,
   "text": "که چی بشه این همه عظمت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.0,
   "end": 355.86,
   "text": "لعلکم بلکه شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 355.86,
   "end": 359.34,
   "text": "شاید شما بلقاء ربکم توقنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 359.34,
   "end": 364.72,
   "text": "عجب! بلکه شما به لقاء پروردگار خودتون، ربکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 364.72,
   "end": 366.88,
   "text": "طوقنون به یقین برسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 366.88,
   "end": 370.06,
   "text": "ببینید این همه عظمت رو خدا آفریده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 370.06,
   "end": 372.22,
   "text": "که به یقین برسونه من و شما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 372.22,
   "end": 374.94,
   "text": "و وقتی ما به یقین رسیدیم اون موقع دل میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 374.94,
   "end": 377.9,
   "text": "تا وقتی که یقین نیست دل نمیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 377.9,
   "end": 382.94,
   "text": "وقتی یقین آمد \"واعبد ربک حتى یأتیک الیقین\" یه معناش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 382.94,
   "end": 385.36,
   "text": "انقدر عبادت خدا تو بکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 385.36,
   "end": 388.46,
   "text": "انجام بده، اهل عبادت باش تا یقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 388.46,
   "end": 391.66,
   "text": "بر تو بیاد. حالا یک معناش هم موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 391.66,
   "end": 395.32,
   "text": "خود موت یعنی ر-- سفر کردن از ظاهر به باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 395.32,
   "end": 400.56,
   "text": "به انسان یقین میده. یکی از معانی که ذیل این آیه ای که قرائت کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 400.56,
   "end": 405.88,
   "text": "هست همون موت هست که اون یقین یعنی موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 405.88,
   "end": 409.12,
   "text": "هنگام موت انسان به یقین میرسه اما دیگه اون موقع چه فایده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 409.12,
   "end": 410.94,
   "text": "به چه درد میخوره اون موقع یقین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 410.94,
   "end": 413.72,
   "text": "همه میرسن. ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 413.72,
   "end": 418.44,
   "text": "خوبیش اینه که انسان قبلش به مرگ اختیاری به اون یقین برسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 418.44,
   "end": 424.46,
   "text": "حالا شما اگر کسی این بحث لقاء رو، این‌ها رو خواست پیگیری کنه فکر می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 424.46,
   "end": 427.3,
   "text": "قریب به سی جلسه‌ای تا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 427.3,
   "end": 430.84,
   "text": "ااا نه کمتر بیست و خورده‌ای جلسه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 430.84,
   "end": 434.28,
   "text": "پیرامون لقاء الله سخن گفتیم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 434.28,
   "end": 436.82,
   "text": "به فضل الهی بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 436.82,
   "end": 441.28,
   "text": "ااا مشرب علامه و آیات و روایات در یا زهرا شرقی تهران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 441.28,
   "end": 446.16,
   "text": "اون رو در کانال گذاشتن عزیزان میتونن رجوع کنن تا پاک نشده از سرور ایتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 446.16,
   "end": 449.7,
   "text": "حالا اونجا ببینید بعد اینجا همه عظمت رو خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 449.7,
   "end": 453.9,
   "text": "آفریده برای اینکه چی؟ شما یقین کنید به لقاء پروردگار خودتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 453.9,
   "end": 456.98,
   "text": "اتفاقاً این آیه ای که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 456.98,
   "end": 460.54,
   "text": "سرمنشاء یقین و یقین به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 460.54,
   "end": 463.46,
   "text": "لقاء پروردگار خودمون قرار داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 463.46,
   "end": 466.2,
   "text": "ه-- یکی از آیاتی است که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 466.2,
   "end": 468.86,
   "text": "اعجاز علمی قرآن بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 468.86,
   "end": 474.8,
   "text": "حالا ببینید این خودش یه تأکیدی بر اینکه اگر می‌خواید به یقین برسید، می‌خواید از قلب منغمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 474.8,
   "end": 477.62,
   "text": "فارغ بشید و انشاالله قلب باخبر بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 477.62,
   "end": 480.34,
   "text": "با یقین داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 480.34,
   "end": 483.56,
   "text": "ااا به همین معجزات علمی قرآن توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 483.56,
   "end": 489.34,
   "text": "بحث جاذبه است اینجا. بحث جاذبه در این آیه خیلی شریف و شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 489.34,
   "end": 493.22,
   "text": "مطرح شده. همینطور که میدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 493.22,
   "end": 496.62,
   "text": "ااا با توجه البته به احادیثی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 496.62,
   "end": 503.5,
   "text": "در تفاصيل ذیل این آیه شریفه اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 503.5,
   "end": 511.16,
   "text": "ااا و پرده از روی یک حقیقت علمی برداشته شده، اونم در زمان نزول این آیات هزار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 511.16,
   "end": 514.34,
   "text": "چند صد سال پیش. اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 514.34,
   "end": 517.3,
   "text": "خب بر کسی آشکار نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 517.3,
   "end": 521.28,
   "text": "این حقایق. اون موقع گمان می‌کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 521.28,
   "end": 527.04,
   "text": "گمانشون این بود مردم اون زمان که آسمان‌ها به صورت کراتی تو در تواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 527.04,
   "end": 530.66,
   "text": "مثل طبقات پیاز روی هم قرار گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 530.66,
   "end": 533.18,
   "text": "و خب طبعا چنین کراتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 533.18,
   "end": 536.62,
   "text": "هیچ کدومشون معلق و بی ستون نیستن که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 536.62,
   "end": 543.02,
   "text": "بر هم تکیه دارن. ولی خب وقتی این آیات نازل شد و همه بی‌خبر بودن حدود هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 543.02,
   "end": 546.2,
   "text": "سال بعد از نزول این آیات بود که علم بشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 546.2,
   "end": 548.98,
   "text": "به اینجا رسید که نخیر این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 548.98,
   "end": 551.68,
   "text": "افلاک پوست پیازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 551.68,
   "end": 556.78,
   "text": "به کلی موهومه و آنچه که واقعیت داره بر اساس اینچه که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 556.78,
   "end": 563.1,
   "text": "ما الان داریم تو قرآن می‌بینیم اما هزار و چهارصد سال پیش نازل شده و بعداً حدود هزار سال بعد از نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 563.1,
   "end": 567.12,
   "text": "قرآن مردم بهش رسیدن، دانشمندان البته بهش رسیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 567.12,
   "end": 574.18,
   "text": "دیدن که نخیر کرات آسمان هر کدوم توی مدار و جایگاه خودشون معلق و ثابتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 574.18,
   "end": 578.2,
   "text": "بدون اینکه تکیهگاهی داشته باشن در حسب ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 578.2,
   "end": 583.48,
   "text": "و تنها چیزی که اونا رو در جای خودش ثابت نگه داشته تعادله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.48,
   "end": 588.36,
   "text": "دقت بفرمایید چی عرض می‌کنم. تعادل بین قوه جاذبه و دافعه شونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 588.36,
   "end": 591.06,
   "text": "این اصل علمیه که بعدا ثابت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.06,
   "end": 593.88,
   "text": "که البته یکی از اینا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 593.88,
   "end": 597.48,
   "text": "جرم این کرات ارتباط داره و دیگری به حرکت اونها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 597.48,
   "end": 605.72,
   "text": "در هر حال تعادل جاذبه و دافعه به صورت یک ستون نامرئی کرات آسمان رو در جای خودش نگه داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 605.72,
   "end": 610.86,
   "text": "حالا شما ببینید ما نمی‌خوایم اینجا ادعا کنیم که منظور از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 610.86,
   "end": 614.2,
   "text": "ستون‌های نامرئی که ما نمی‌بینیم صرفاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 614.2,
   "end": 619.76,
   "text": "همین مثلاً تعادل جاذبه و دافعه بین کرات هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 619.76,
   "end": 622.28,
   "text": "نمیگیم صرفاً اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 622.28,
   "end": 624.6,
   "text": "اما این هم قطعاً هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 624.6,
   "end": 627.54,
   "text": "یکی از اون ستونه‌ها قطعاً همین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 627.54,
   "end": 630.48,
   "text": "اتفاقاً چه جالب که در حدیثی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 630.48,
   "end": 632.46,
   "text": "یه حدیث بسیار با عظمتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 632.46,
   "end": 638.74,
   "text": "آقامون امیرالمؤمنین علیه الصلاة والسلام این امیر بیان که خودشون فرمودن \"نحن امراء البيان\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 638.74,
   "end": 644.42,
   "text": "ما امیران، اصلاً بیان و کلام تحت امر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 644.42,
   "end": 651.12,
   "text": "ااا ایشون فرمودن حالا اصل حدیث رو خواستید ببینید در کتاب بحار مرحوم مجلسی علیه الرحمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 651.12,
   "end": 658.66,
   "text": "جلد پنجاه و پنج، صفحه نود و یک، اونجا امیرالمؤمنین علیه الصلاة والسلام فرمودن \"هذه النجوم التي في السماء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 658.66,
   "end": 663.66,
   "text": "این ستاره‌هایی که می‌بینید تو آسمون \"مدائن\" اینا شهرهاین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 663.66,
   "end": 666.22,
   "text": "حضرت مثل شهر رو زدن برای این ستاره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 666.22,
   "end": 672.5,
   "text": "\"مثل المدائن التي في الأرض\" مثل اون شهر‌هایی که روی زمینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 672.5,
   "end": 675.98,
   "text": "یا چه جالب فرمودن \"مربوطة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 675.98,
   "end": 678.3,
   "text": "کل مدينة إلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 678.3,
   "end": 681.1,
   "text": "عمود من نور\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 681.1,
   "end": 685.92,
   "text": "که اینا این شهرها مثل این حالا این ستاره‌ها مثل شهر‌هایی که روی زمینن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 685.92,
   "end": 688.66,
   "text": "هر شهری با شهر دیگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 688.66,
   "end": 691.42,
   "text": "مرتبط‌اند. چگونه؟ با ستونی از نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 691.42,
   "end": 693.72,
   "text": "\"عمود من نور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 693.72,
   "end": 696.18,
   "text": "\"مربوطة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 696.18,
   "end": 699.6,
   "text": "کل مدينة إلى عمود من نور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 699.6,
   "end": 702.16,
   "text": "با یه عمودی از نور. حالا شما ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 702.16,
   "end": 706.08,
   "text": "به نظر شما در افق ادبیات وقتی بنگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 706.08,
   "end": 709.94,
   "text": "در اون زمان، در اون زمان خفقان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 709.94,
   "end": 712.98,
   "text": "جهل و بی‌خردی و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 712.98,
   "end": 714.96,
   "text": "در اون زمان آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 714.96,
   "end": 718.72,
   "text": "تعبیری شیرین‌تر و رساتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 718.72,
   "end": 726.64,
   "text": "و روشن‌تر از این تعبیری که امیرالمؤمنین علیه الصلاة والسلام آوردن بر ستون‌های نامرئی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 726.64,
   "end": 730.14,
   "text": "آیا می‌شد بیان کرد؟ برای ذکر همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 730.14,
   "end": 734.4,
   "text": "امواج جاذبه و تعادل اون با نیروی دافعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 734.4,
   "end": 738.32,
   "text": "به حق امیر بیانم که اون مطالب عرشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 738.32,
   "end": 741.08,
   "text": "و عالیه رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 741.08,
   "end": 746.94,
   "text": "جملات و الفاظ و حالا این کلمات خاکی به گونه‌ای بیان فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 746.94,
   "end": 750.46,
   "text": "که حالا صاحبان کمترین فهم بفهمند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 750.46,
   "end": 756.0,
   "text": "و اون‌هایی هم که بیشترین حظ و بهره را از عقل بردن هم اونا هم بفهمند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 756.0,
   "end": 758.98,
   "text": "که حالا بعد حضرت همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 758.98,
   "end": 765.3,
   "text": "ادامه در ادامه می‌فرماید که خداوند بعد از آفرینش این آسمان‌های بی ستون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 765.3,
   "end": 769.2,
   "text": "که نشانه بارز عظمت و قدرت بی‌انتها اوست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 769.2,
   "end": 771.6,
   "text": "بر عرش استیلا یافت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 771.6,
   "end": 775.26,
   "text": "یعنی حکومت عالم هستی را به دست گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 775.26,
   "end": 779.06,
   "text": "که حالا به تفصیل اگه دوست داشتید در جلد ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 779.06,
   "end": 782.14,
   "text": "تفسیر نمونه آقای مکارم و گروه عزیزشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 782.14,
   "end": 786.16,
   "text": "صفحه صد و یازده می‌تونید این رو که الان ما عرض کردیم ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 786.16,
   "end": 790.56,
   "text": "و همچنین البته آیات دیگه‌ای هست در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 790.56,
   "end": 793.32,
   "text": "جاذبه و مثلا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 793.32,
   "end": 796.1,
   "text": "آیه ده سوره لقمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 796.1,
   "end": 800.04,
   "text": "«خَلَقَ السَّمَاوَاتِ بِغَيْرِ عَمَدٍ تَرَوْنَهَا».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 800.04,
   "end": 802.5,
   "text": "خب اونجا هم اگر دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 802.5,
   "end": 809.12,
   "text": "در اون آیات هم حالا متاسفانه فرصت امروزمون دیگه ایجاب نمی‌کنه ورود کنیم به این آیه جلسه بعد انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 809.12,
   "end": 814.02,
   "text": "اما یک یک این آیات رو وقتی بررسی می‌کنی به عظمت علمی قرآن پی می‌بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 814.02,
   "end": 817.22,
   "text": "بعد آه حسرت می‌کشی که افسوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 817.22,
   "end": 824.28,
   "text": "که چرا ما و جوون‌های ما به جای اینکه شب و روزشون رو سر این سفره و مَعده بی الهی بگذارند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 824.28,
   "end": 827.08,
   "text": "این سفره رو برچیدند و جمع کردند از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 827.08,
   "end": 832.24,
   "text": "جلوی خودشون و به چیزهای دیگه‌ای پرداختند که هیچ تعالی‌ای براشون نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 832.24,
   "end": 839.02,
   "text": "اتفاقاً اضمحلال وجودی میاره براشون و مزمحل می‌کنه استعدادهاشون رو از بین می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 839.02,
   "end": 842.4,
   "text": "و چه خطر بزرگی که ما با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 842.4,
   "end": 845.4,
   "text": "از بین بردن استعداد از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 845.4,
   "end": 847.42,
   "text": "نش سفر کنیم و بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 847.42,
   "end": 850.6,
   "text": "دیگه خطری بالاتر از این نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 850.6,
   "end": 855.1,
   "text": "که اون مقام شفاعت بارها عرض شده و مقام استعداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 855.1,
   "end": 861.14,
   "text": "کسی بتونه استعدادش رو حداقل با گناه مزمحل نکنه، از بین نبره، با خودش ببره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 861.14,
   "end": 864.62,
   "text": "و کسی بتونه این استعداد رو شکوفا کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 864.62,
   "end": 868.26,
   "text": "نور على نور. دیگه خودش صاحب شفاعت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 868.26,
   "end": 873.1,
   "text": "اما چه کنیم که متاسفانه این بی‌خبری، این قلب بی‌خبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 873.1,
   "end": 876.52,
   "text": "بیچاره کرده ما رو. انشاالله خدا بر ما رحم کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 876.52,
   "end": 879.12,
   "text": "و ما رو از این بی‌خبری بیرون بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 879.12,
   "end": 883.46,
   "text": "به برکت قرآن، به برکت معصومین که روایات‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 883.46,
   "end": 886.54,
   "text": "به قول استد استاد به منزله بدن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 886.54,
   "end": 892.68,
   "text": "روایات اهل بیت نسبت به قرآن به منزله بدن است نسبت به روح و نفس قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 892.68,
   "end": 896.2,
   "text": "والحمد-- انشاالله که خدای منان به هممون رحم کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 896.2,
   "end": 898.58,
   "text": "و از قلب بی‌خبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 898.58,
   "end": 901.7,
   "text": "اون قلب منقبه همه ما رو نجات بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 901.7,
   "end": 904.12,
   "text": "والحمد لله. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 904.12,
   "end": 909.06,
   "text": "صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 909.06,
   "end": 915.22,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 915.22,
   "end": 919.38,
   "text": "اللهم صل على محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 919.38,
   "end": 921.3,
   "text": "آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 921.3,
   "end": 928.0,
   "text": "اللهم صل على محمد و آل محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 928.0,
   "end": 930.0,
   "text": "آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}