   "title": "## نماز جماعت پشت سر اهل سنت",
   "start": 0.52,
   "end": 31.86
  },
  {
   "index": 1,
   "title": "## قلبِ منغمر و بی‌خبری از قرآن",
   "start": 31.86,
   "end": 235.06
  },
  {
   "index": 2,
   "title": "مؤلف محترم تفسیر نمونه، آیت‌الله مکارم، به اتفاق همکارانشان ذیل آیهٔ شریفه می‌نویسند:",
   "start": 235.06,
   "end": 257.5
  },
  {
   "index": 3,
   "title": "ایشان ادامه می‌دهند در بحث اسرار و اعجاز علمی قرآن ذیل آیهٔ هشتاد و نه سورهٔ اسراء:",
   "start": 257.5,
   "end": 277.86
  },
  {
   "index": 4,
   "title": "## قلبِ بی‌خبر؛ پوشاندن حقیقت",
   "start": 277.86,
   "end": 605.98
  },
  {
   "index": 5,
   "title": "## تزیینِ سماء دنیا خلافِ فرضیهٔ بطلمیوس",
   "start": 605.98,
   "end": 744.83
  },
  {
   "index": 6,
   "title": "## چشمکِ ستارگان و قشر هوا؛ ذخیرهٔ عقول آخرالزمان",
   "start": 744.83,
   "end": 848.33
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.52,
   "end": 4.46,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.46,
   "end": 8.2,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.2,
   "end": 12.28,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.28,
   "end": 16.58,
   "text": "استفسار شده از رهبر عزیزمون که آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.58,
   "end": 19.34,
   "text": "نماز جماعت پشت سر اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.34,
   "end": 22.82,
   "text": "سنت جایز است یا خیر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.82,
   "end": 30.82,
   "text": "رهبر عزیز فرمودند که نماز جماعت برای حفظ وحدت اسلامی جایز و صحیح هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.82,
   "end": 37.78,
   "text": "اما ادامه بحث قلب منغمه رو رسیده بودیم به جایی که عرض شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.78,
   "end": 44.26,
   "text": "اون چیزی رو که در آیه شصت و سه سوره مؤمنون خدا می فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.26,
   "end": 46.96,
   "text": "قل قلوب اینها دلهای اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.96,
   "end": 50.08,
   "text": "بی‌خبر است از این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.08,
   "end": 54.7,
   "text": "این رو عرض کردیم بنا به تفاسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.7,
   "end": 63.54,
   "text": "منظور قرآن است و عرض شد که ما از ظاهر قرآن هم بی‌خبریم چه برسه از باطن قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.54,
   "end": 67.28,
   "text": "و امروزه که به فضل الهی بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.28,
   "end": 72.7,
   "text": "اکتشاف و اختراعات گوناگونی که رخ می‌دهد در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.7,
   "end": 75.32,
   "text": "مباحث و مطالب علمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.32,
   "end": 79.5,
   "text": "تازه اگر کسی اهل تدقق باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.5,
   "end": 82.52,
   "text": "و با دقت نظر این‌ها رو بررسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.52,
   "end": 87.38,
   "text": "کنه متوجه اون عظمت و شگرفی قرآن و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.38,
   "end": 89.58,
   "text": "اعجاز علمی قرآن خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.58,
   "end": 93.32,
   "text": "یکی از راه‌هایی که ما می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.32,
   "end": 96.14,
   "text": "متوجه عظمت قرآن بشویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.14,
   "end": 99.54,
   "text": "در خصوص همین علوم ظاهری قرآن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.54,
   "end": 103.76,
   "text": "به عبارتی اعجاز علمی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.76,
   "end": 106.62,
   "text": "بنده حقیر توصیه می‌کنم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.62,
   "end": 114.48,
   "text": "مواردی که خصوصاً در تفسیر نمونه حضرت آقای مکارم و همکارانشون آوردند پیرامون اعجاز علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.48,
   "end": 118.98,
   "text": "که اونجا مطالب خوبی رو این بزرگواران دسته‌بندی کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.98,
   "end": 122.94,
   "text": "مثلاً پیرامون تزیین آسمان با ستارگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.94,
   "end": 127.1,
   "text": "یا جایگاه و مسیر مشخص ستارگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.1,
   "end": 131.46,
   "text": "یا حرکت دورانی و جریانی خورشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.46,
   "end": 134.88,
   "text": "حرکت زمین، قانون جاذبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.88,
   "end": 138.94,
   "text": "آماده شدن زمین برای زراعت به وسیله باران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.94,
   "end": 143.96,
   "text": "زوجیت در گیاهان، رستاخیز انرژی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.96,
   "end": 146.26,
   "text": "یا مثلاً تشکیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.26,
   "end": 149.18,
   "text": "تمام اجسام از اتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.18,
   "end": 152.1,
   "text": "زندگی اجتماعی زنبور عسل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.1,
   "end": 154.74,
   "text": "آفرینش انسان از علق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.74,
   "end": 158.88,
   "text": "یا شکل‌گیری استخوان‌ها در جنین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.88,
   "end": 165.16,
   "text": "همچنین رقیق‌تر بودن هوا در ارتفاعات و بریدگی میان رشته کوه‌ها و چه و چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.16,
   "end": 172.28,
   "text": "این‌ها ذیل آیات بررسی شده و خب اون موقع که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.28,
   "end": 175.58,
   "text": "نبوده در زمانی که این آیات نازل شده، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.58,
   "end": 179.78,
   "text": "کشف‌های حقیقی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.78,
   "end": 184.36,
   "text": "میشه گفت این قرآن آفاقی و قرآن هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.36,
   "end": 188.26,
   "text": "آیات الهی در نظام آفاقی نبوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.26,
   "end": 190.26,
   "text": "الان این‌ها د",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.26,
   "end": 193.18,
   "text": "بعد از این جریانات علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.18,
   "end": 198.08,
   "text": "خودش رو نشون میده. وقتی توجه داشته باشیم که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.08,
   "end": 202.42,
   "text": "که اون زمان خبری از این علوم نبوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.42,
   "end": 206.66,
   "text": "و با این حال در قرآن به اون‌ها اشاره شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.66,
   "end": 212.72,
   "text": "نشان دهنده اعجاز علمی قرآن و اخبار از غیب است به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.72,
   "end": 221.86,
   "text": "و چه جالب که مؤلف محترم همین تفسیر نمونه یعنی آقای مکارم به اتفاق همکارانشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.86,
   "end": 224.48,
   "text": "اونجا در ذیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.48,
   "end": 233.0,
   "text": "آیه شریفه \"و الک کتاب لا ریب فیه هدى للمتقین\" در آیه دو سوره بقره، اونجا می‌نویسند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.0,
   "end": 235.06,
   "text": "جالب این که گذشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.06,
   "end": 239.36,
   "text": "گذشت زمان نه تنها طراوت قرآن را نمی‌کاهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.36,
   "end": 245.24,
   "text": "بلکه با پیشرفت علوم و برداشته شدن پرده از روی اسرار کائنات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.24,
   "end": 251.16,
   "text": "حقایق قرآن روشن‌تر می‌گردد و هر قدر علم به سوی تکامل پیش می‌رود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.16,
   "end": 253.42,
   "text": "درخشش این آیات بیشتر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.42,
   "end": 256.66,
   "text": "این یک ادعا نیست، واقعیتی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.66,
   "end": 262.5,
   "text": "که به خواست خدا در لایه‌های همین کتاب تفسیر به آن پی خواهیم برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.5,
   "end": 265.76,
   "text": "و حالا جلده یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.76,
   "end": 268.0,
   "text": "جلده یک تفسیر نمونه شصت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.0,
   "end": 271.62,
   "text": "صفحه شصت و شش می‌تونید این فرمایش رو اونجا ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.62,
   "end": 274.88,
   "text": "که بعد ایشون ادامه میدن مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 274.88,
   "end": 278.64,
   "text": "در همین بحث عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.64,
   "end": 282.36,
   "text": "اسرار و اعجاز علمی قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.36,
   "end": 286.42,
   "text": "در ذیل آیه هشتاد و نه سوره اسرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 286.42,
   "end": 289.62,
   "text": "که خدا می فرماید \" و لقد صرفنا للناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 289.62,
   "end": 292.8,
   "text": "فی هذا القرآن من کل مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.8,
   "end": 295.18,
   "text": "فابى اکثر الناس الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.18,
   "end": 298.7,
   "text": "کفورا\". اونجا که حالا خدا در این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.7,
   "end": 303.12,
   "text": "فرمودند که در، توی این قرآن همانا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.12,
   "end": 305.38,
   "text": "و لقد صرفنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.38,
   "end": 307.62,
   "text": "ما تصریف کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 307.62,
   "end": 309.74,
   "text": "تصریف یعنی دگرگونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.74,
   "end": 314.74,
   "text": "یعنی مثل مثلاً صراف رو چرا بهش میگن صراف که میری صرافی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.74,
   "end": 319.78,
   "text": "پول میدی مثلاً از یه واحد پول یه کشوری میدی واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 319.78,
   "end": 322.26,
   "text": "کشور دیگه‌ای رو دریافت می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 322.26,
   "end": 325.32,
   "text": "یا پول ریز میدی درشت می‌گیری، درشت میدی ریز می‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 325.32,
   "end": 328.26,
   "text": "تصریف می‌کنه، دگرگونی ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.26,
   "end": 331.44,
   "text": "خدا هم اینجا خودش رو صراف معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.44,
   "end": 334.88,
   "text": "در آیات قرآن فرموده \"صرفنا للناس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.88,
   "end": 340.14,
   "text": "ما مثال‌های مختلفی برای مردم از هر گونه، از هر گونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.14,
   "end": 346.68,
   "text": "بیان کردیم. اما \"من کل مثل\" از هر مثالی، از هر مثلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.68,
   "end": 349.5,
   "text": "\"فابى اکثر الناس الا کفورا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.5,
   "end": 352.62,
   "text": "متأسفانه قرآن می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.62,
   "end": 357.02,
   "text": "اکثر مردم به جز از کفر و عناد از هر چیزی امتناع کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.02,
   "end": 360.18,
   "text": "یعنی فقط به سمت کفر و عناد و این‌ها رفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.18,
   "end": 362.14,
   "text": "رو حقایق رو پوشوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 362.14,
   "end": 365.56,
   "text": "ذیل این آیه شریفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 365.56,
   "end": 373.02,
   "text": "تفسیر نمونه می‌فرماید این آیه در واقع بیان یکی از جنبه‌های اعجاز قرآن یعنی جامعیت آن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.02,
   "end": 379.4,
   "text": "به راستی این تنوع محتویات قرآن چون اونجا قرآن می‌فرماید صرافنا دیگه تصریف می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.4,
   "end": 381.98,
   "text": "و ما هم صرافیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.98,
   "end": 385.36,
   "text": "به، به همه مثل‌ها ما با شما سخن گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.36,
   "end": 388.22,
   "text": "درسته؟ برای همین خاطر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 388.22,
   "end": 391.68,
   "text": "خب تفسیر نمونه هم داره همین رو بیان می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.68,
   "end": 395.18,
   "text": "می‌فرماید: به راستی این تنوع محتویات قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.18,
   "end": 398.44,
   "text": "آن هم از انسانی درس نخوانده عجیب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.44,
   "end": 403.38,
   "text": "چرا که در این کتاب آسمانی هم دلایل متین عقلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.38,
   "end": 406.6,
   "text": "با ریزه‌کاری‌های مخصوصش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.6,
   "end": 415.0,
   "text": "در زمینه عقاید آمده و هم بیان احکام متین و استوار بر اساس نیازمندی‌های بشر در همه زمینه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 415.0,
   "end": 421.82,
   "text": "هم بحث‌های تاریخی قرآن در نوع خود بی‌نظیر، هیجان‌انگیز، بیدارگر، دل‌چسب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.82,
   "end": 425.32,
   "text": "تکان‌دهنده و خالی از هر گونه خرافه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.32,
   "end": 429.36,
   "text": "و هم مباحث اخلاقیش که با دل‌های آماده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 429.36,
   "end": 434.46,
   "text": "همان کار را می‌کند که بها-باران بهار با زمینه‌های مرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 434.46,
   "end": 437.8,
   "text": "مسائل علمی که در قرآن مطرح شده پرده از روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.8,
   "end": 443.5,
   "text": "حوائقی برمی‌دارد که حداقل در آن زمان برای هیچ دانشمندی شناخته نشده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 443.5,
   "end": 446.14,
   "text": "این مطلبی هم که الان خوندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 446.14,
   "end": 452.8,
   "text": "از جلد دوازده تفسیر نمونه صفحه دویست و هفتاد و شش می‌تونید اونجا ملاحظه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 452.8,
   "end": 455.52,
   "text": "همچنین در جلد یازده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.52,
   "end": 458.34,
   "text": "همین تفسیر نمونه صفحه هشتاد و یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.34,
   "end": 462.68,
   "text": "اونجا می‌فرماید می‌دانیم قرآن یک کتاب علوم طبیعی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 462.68,
   "end": 465.22,
   "text": "بلکه یک کتاب انسان‌سازی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.22,
   "end": 472.34,
   "text": "و بنابراین نباید انتظار داشت که جزئیات این علوم از قبیل مسائل مربوط به تکامل، تشریح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 472.34,
   "end": 476.18,
   "text": "جنین‌شناسی، گیاه‌شناسی و مانند آن در قرآن مطرح شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 476.18,
   "end": 478.72,
   "text": "ولی این مانع از آن نخواهد بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.72,
   "end": 485.34,
   "text": "به تناسب بحث‌های تربیتی، اشاره کوتاهی به قسمت‌هایی از این علوم در قرآن بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.34,
   "end": 490.76,
   "text": "خب اینا به صورت کلی البته این رو توجه داشته باشید که قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 490.76,
   "end": 494.12,
   "text": "ظاهرش این علومی که حالا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 494.12,
   "end": 499.42,
   "text": "تفسیر نمونه مدعی شده به نحو تفصیل نیامده این علوم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.42,
   "end": 503.52,
   "text": "چون مثلا این یک کتاب طبیعی نیست لذا علوم طبیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.52,
   "end": 510.8,
   "text": "مثلا گیاه‌شناسی، جنین‌شناسی اینها توش به نحو تفصیل نیامده، اشاراتی شده به، به جهت مسائل تربیتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 510.8,
   "end": 516.38,
   "text": "اما توجه داشته باشید که بنا به فرمایش امام سجاد علیه السلام که بارها عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 516.38,
   "end": 519.84,
   "text": "امه-- اونجا فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 519.84,
   "end": 523.38,
   "text": "من اراد علم الاولین والاخرین ولی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 523.38,
   "end": 530.46,
   "text": "فلی-فلیطور القرآن. هر کس که اراده کرده علم اول و آخر رو برداره قرآن رو شخم بزنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 530.46,
   "end": 537.6,
   "text": "عمیق بشه در قرآن. خب پس پیداست که در باطن قرآن این علوم هست منتها خب اهلش بهش می‌رسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 537.6,
   "end": 543.26,
   "text": "حالا در هر حال بحث ما این هستش که چگونه است که با اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 543.26,
   "end": 547.0,
   "text": "قرآن به این زیبایی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 547.0,
   "end": 550.9,
   "text": "اعجاز یعنی داره به خودش با اعجازی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 550.9,
   "end": 553.82,
   "text": "فن بیان خودش مطرح کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 553.82,
   "end": 557.92,
   "text": "ما رو دعوت می‌کنه به حق بودن این طریق و این دین و این راه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 557.92,
   "end": 562.16,
   "text": "و باز متأسفانه بر اساس همون آیه هشتاد و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 562.16,
   "end": 566.98,
   "text": "سوره اسراء اکثر مردم فابعض اکثر الناس الکفورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 566.98,
   "end": 568.82,
   "text": "خب این یعنی همون قلب بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 568.82,
   "end": 575.82,
   "text": "یعنی قلب بی‌خبر کاری می‌کنه، یه بلایی سر مردم آورده که فابعض اکثر الناس الکفورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 575.82,
   "end": 579.02,
   "text": "به جهت اون کفر و پوشوندن کفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 579.02,
   "end": 580.64,
   "text": "از پوشاندن میاد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 580.64,
   "end": 583.5,
   "text": "کفر عنا سیئاتنا بپوشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 583.5,
   "end": 586.14,
   "text": "از ما زشتی‌های ما رو، گناهان ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 586.14,
   "end": 590.02,
   "text": "خب این، اینا یعنی روی حقیقت رو می‌پوشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 590.02,
   "end": 594.4,
   "text": "در حالی که حقیقت از خورشید آشکار، آشکارتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 594.4,
   "end": 597.96,
   "text": "حالا ما داریم به لایه‌های ظاهری قرآن الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 597.96,
   "end": 602.5,
   "text": "توجه می‌کنیم. یعنی می‌گیم آقا تو ظاهر قرآن شما بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 602.5,
   "end": 605.56,
   "text": "سر سفره ظاهری قرآن ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 605.56,
   "end": 613.18,
   "text": "مثلا در آیه شش سوره صافات ببینید چقدر زیبا خدای منان فرموده که انا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 613.18,
   "end": 617.26,
   "text": "زینا السماء الدنيا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 617.26,
   "end": 620.62,
   "text": "قطعاً ما در حقیقت ما آسمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 620.62,
   "end": 624.74,
   "text": "دنیا رو یعنی این آسمان نزدیک به ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 624.74,
   "end": 629.88,
   "text": "بزینه تنل کواکب با زیور سیارات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 629.88,
   "end": 631.92,
   "text": "آراستیم، زینت بخشیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 631.92,
   "end": 640.18,
   "text": "زینا. السماء الدنيا این آسمان نزدیک و پایین و پایین دستی و دم دست رو حالا به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 640.18,
   "end": 644.38,
   "text": "ما زینت کردیم. به چی؟ بزینه تنل کواکب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 644.38,
   "end": 647.6,
   "text": "به زیور سیارات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 647.6,
   "end": 650.48,
   "text": "حالا اینجا ببینید خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 650.48,
   "end": 655.0,
   "text": "آسمان پایین رو فرموده با کواکب تزئین کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 655.0,
   "end": 662.46,
   "text": "در حالی که اون فرضیه‌ای که در اون زمان بر افکار دانشمندان اون زمان حاکم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 662.46,
   "end": 666.98,
   "text": "می‌گفت که آسمان بالا یعنی اون آسمان هشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 666.98,
   "end": 670.06,
   "text": "، آسمان ستارگان ثوابته و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 670.06,
   "end": 677.26,
   "text": "و حالا طبق فرضیه بطلمیوس که اهل علم هستید همه الحمد لله اهل فضل و تحقیقید و ما گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 677.26,
   "end": 679.36,
   "text": "عزیزانی که در محضرشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 679.36,
   "end": 682.28,
   "text": "این مباحث رو داریم اخیراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 682.28,
   "end": 687.6,
   "text": "بیان می‌کنیم حله-همه الحمد لله دست به قلم، دست به تحقیق و تفحصند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 687.6,
   "end": 690.54,
   "text": "حالا خب کار ما هم الحمد لله آسون‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 690.54,
   "end": 694.86,
   "text": "اونجا اون فرضیه بطلمیوس در اون زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 694.86,
   "end": 699.48,
   "text": "می‌گفتش که اون آسمان‌های بالا دستی، آسمان هشتم و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 699.48,
   "end": 703.0,
   "text": "آسمان چی هستن؟ ستارگان ثوابت و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 703.0,
   "end": 706.8,
   "text": "ولی بعدا می‌بینید که این فرضیه باطل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 706.8,
   "end": 715.4,
   "text": "و چه جالب که قرآن مطلقاً از این فرضیه نادرست اون زمان با اینکه افکار دانشمندان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 715.4,
   "end": 721.98,
   "text": "تازه اون زمان این چنین بود اما قرآن از اون فرضیه تبعیت نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 721.98,
   "end": 724.52,
   "text": "و این خودش یه معجزه زنده‌ایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 724.52,
   "end": 726.44,
   "text": "از اینکه این کتاب آسمانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 726.44,
   "end": 733.22,
   "text": "اون پیغمبر عزیز که حالا اون رو امّی فرض می‌کنند و درس نخوانده و ننوشته چگونه اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 733.22,
   "end": 735.88,
   "text": "می‌دانسته؟ اینا خودش اعجاز نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 735.88,
   "end": 739.42,
   "text": "و ما بی‌خبر باشیم از این حوائق و حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 739.42,
   "end": 742.85,
   "text": "ظاهریه که به نوبه خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 742.85,
   "end": 744.61,
   "text": "عظمتی دارد همین حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 744.61,
   "end": 746.87,
   "text": "حالا نکته جالب‌تر از این اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 746.87,
   "end": 750.67,
   "text": "باز عرض کنیم خدمتتون که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 750.67,
   "end": 754.01,
   "text": "نظر علم امروز بخواهی شما بررسی کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 754.01,
   "end": 757.61,
   "text": "این دیگه مسلم شده که این چشمک زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 757.61,
   "end": 760.39,
   "text": "ز-ز-- بسیار زیبای ستاره‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 760.39,
   "end": 762.19,
   "text": "وقتی نگاه می‌کنی چشمک می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 762.19,
   "end": 764.77,
   "text": "اینا به خاطر قشر هواییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 764.77,
   "end": 768.51,
   "text": "اطراف زمینو گرفته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 768.51,
   "end": 772.51,
   "text": "اونها رو به این حالت چشمک زدن وادار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 772.51,
   "end": 774.85,
   "text": "و این خیلی جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 774.85,
   "end": 778.83,
   "text": "بحث زینت بخشی آسمان دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 778.83,
   "end": 782.03,
   "text": "از سما دنیا اونا-- یعنی آسمان پایین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 782.03,
   "end": 784.87,
   "text": "بسیار مناسبه با همین بحث چشمک زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 784.87,
   "end": 789.15,
   "text": "چرا؟ چون وقتی بیرون از جو زمین میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 789.15,
   "end": 794.09,
   "text": "حرکت می‌کنی و خارج میشی از جو زمین دیگه ستاره‌های اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 794.09,
   "end": 799.01,
   "text": "دیگه حالت این زیبایی چشمک زدن رو ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 799.01,
   "end": 803.57,
   "text": "که اونجا دیگه این حالت زینت بخشی چشمک زدن ازشون گرفته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 803.57,
   "end": 807.95,
   "text": "چرا؟ به جهت قشر هواییه که اینجا اطراف زمین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 807.95,
   "end": 811.43,
   "text": "اینو ببینید. خب اون موقع کی اینا رو متوجه میشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 811.43,
   "end": 818.99,
   "text": "و چقدر زشته که ما که الان در عصر اطلاعات و تکنولوژی و پیشرفت و توسعه و این حرفا هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 818.99,
   "end": 826.17,
   "text": "و چه شیرین که امام صادق صلوات الله علیه فرمود بعضی از آیات قرآن ذخیره عقول آخرالزمانی‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 826.17,
   "end": 830.73,
   "text": "مثل شش‌های اول سوره حدید و سوره قل هوالله احد اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 830.73,
   "end": 833.99,
   "text": "بعد ما بی‌خبر باشیم و دچار قلب منغمس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 833.99,
   "end": 837.29,
   "text": "خدا انشاالله ما رو از این بی‌خبری نجات بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 837.29,
   "end": 846.45,
   "text": "و وجود ما رو هم قلب ما رو هم تزیین کنه انشاالله به این حقایق و این معارف و فهم اونها و چشیدن اونها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 846.45,
   "end": 848.33,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}