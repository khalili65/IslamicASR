 "chapters": [
  {
   "index": 0,
   "title": "## استفتاء دربارهٔ حائل میان زنان و مردان",
   "start": 13.2,
   "end": 106.94
  },
  {
   "index": 1,
   "title": "بحث قلب منغمر ادامه می‌یابد. پیش‌تر آیهٔ شصت‌وسهٔ سورهٔ مؤمنون محل تأمل بود که صریحاً از قلب بی‌خبر سخن می‌گوید:",
   "start": 106.94,
   "end": 152.46
  },
  {
   "index": 2,
   "title": "## روایت امام باقر؛ هذا یعنی من القرآن",
   "start": 152.46,
   "end": 272.8
  },
  {
   "index": 3,
   "title": "## غفلت از قرآن؛ صورت کتبیهٔ انسان کامل",
   "start": 272.8,
   "end": 407.08
  },
  {
   "index": 4,
   "title": "## لوح محفوظ و قاعدهٔ لطف",
   "start": 407.08,
   "end": 554.68
  },
  {
   "index": 5,
   "title": "## مراتب نزول قرآن؛ هزار و یک کلمه",
   "start": 554.68,
   "end": 684.86
  },
  {
   "index": 6,
   "title": "## بی‌خبری از ظاهر قرآن؛ ام‌الکتاب و قرآن مبین",
   "start": 684.86,
   "end": 1041.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.58,
   "end": 3.84,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.84,
   "end": 11.1,
   "text": "و بهین استعین. السلام علیک یا داعی الله و ربانی یا آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.1,
   "end": 12.96,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.96,
   "end": 19.28,
   "text": "یک بخشی از یک استفتایی‌ست که ظاهراً خواهرها پرسیدند از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.28,
   "end": 23.52,
   "text": "مثلاً وقتی خانم‌ها پشت پرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.52,
   "end": 29.36,
   "text": "هنگام نماز جماعت یا سخنرانی‌ها و مراسمای دیگه می‌ایستن و اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.36,
   "end": 34.38,
   "text": "این که پرده زده می‌شه بینشون موجب تحقیر و اهانت به اون‌ها می‌شه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.38,
   "end": 37.46,
   "text": "بعد رهبر اینو رد کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.46,
   "end": 40.66,
   "text": "و فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.66,
   "end": 48.74,
   "text": "این که وجود حائل بین زنان و مردان در نماز موجب تحقیر و توهین به شأن و کرامت زنان نمی‌ش- می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.74,
   "end": 52.64,
   "text": "این چیزی که اینا میگن توهم و خیالی بیش نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.64,
   "end": 58.74,
   "text": "و اساسی نداره. به علاوه دخالت دادن نظرات شخصی در فقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.74,
   "end": 61.92,
   "text": "صحیح نیست. این نظر شخصیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.92,
   "end": 64.2,
   "text": "متخصص این حرف رو نزده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.2,
   "end": 69.08,
   "text": "متأسفانه امروزه بسیاری از این حرف‌ها در دین وارد شده و در احکام شرعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.08,
   "end": 75.28,
   "text": "یک انسان باید اون حکم دین رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.28,
   "end": 78.2,
   "text": "کارشناس دین اخذ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.2,
   "end": 81.3,
   "text": "اما بحث قلب منغمر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.3,
   "end": 84.44,
   "text": "به فضل الهی ادامه میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.44,
   "end": 86.84,
   "text": "چنانچه خاطرتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.84,
   "end": 91.08,
   "text": "آیه شصت و سه سوره مؤمنون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.08,
   "end": 102.32,
   "text": "مورد بحث قرار داده بودیم که صراحتاً درش از قلب بی‌خبر سخن گفته که \"بل قلوبهم فی غمرة من هذا، فی غمرة من هذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.32,
   "end": 106.94,
   "text": "ولهم اعمال من دون ذلک هم لها عاملون\" که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.94,
   "end": 110.94,
   "text": "می‌فرماید بلکه دل‌های اون‌ها از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.94,
   "end": 112.96,
   "text": "در بی‌خبری فرو رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.96,
   "end": 116.36,
   "text": "\"من هذا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.36,
   "end": 119.7,
   "text": "یعنی حالا این، این چی هست رو باید الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.7,
   "end": 122.36,
   "text": "بررسی کنیم. از چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.36,
   "end": 125.26,
   "text": "در بی‌خبری فرو رفته؟ \"من هذا\" به کجا می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.26,
   "end": 131.4,
   "text": "\"ولهم اعمال من دون ذلک هم لها عاملون\" جز این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.4,
   "end": 136.78,
   "text": "چیزی که این حالا این عملی که دارن اینا انجام میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.78,
   "end": 140.1,
   "text": "جز به جز اون اعمال اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.1,
   "end": 143.24,
   "text": "یعنی عمل این‌ها با اعمال اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.24,
   "end": 147.94,
   "text": "ایمان متفاوته، فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.94,
   "end": 152.46,
   "text": "خب اجازه بفرمایید که رجوع کنیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.46,
   "end": 157.4,
   "text": "روایت شریفی از امام باقر صلوات الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.4,
   "end": 161.36,
   "text": "برامون مکشوف می‌کنه که منظور از این \"هذا\" در این آیه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.36,
   "end": 167.42,
   "text": "ما از چی بی‌خبریم؟ آیه داره نهیب می‌زنه از بی‌خبری نسبت به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.42,
   "end": 175.48,
   "text": "در کتاب شریف تفسیر اهل بیت علیهم الصلاة و السلام، جلد یک، صفحه هشتاد و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.48,
   "end": 177.58,
   "text": "البته در کتاب شریف بهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.58,
   "end": 183.52,
   "text": "مرحوم مجلسی علیه الرحمة، جلد نه، صفحه دویست و بیست و پنج هم می‌تونین روایت رو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.52,
   "end": 187.48,
   "text": "که حضرت باقر ذیل این آیه فرمودن \"قوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.48,
   "end": 191.18,
   "text": "بل قلوبهم فی غمرة من هذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.18,
   "end": 195.1,
   "text": "یعنی\" داره ترجمه می‌کنه حضرت که معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.1,
   "end": 198.16,
   "text": "یعنی یک معنا، یک وجه این آیه، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.16,
   "end": 202.34,
   "text": "تأویلش چیست؟ \"یعنی من القرآن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.34,
   "end": 204.84,
   "text": "یعنی که از قرآن این‌ها بی‌خبرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.84,
   "end": 209.36,
   "text": "\"ولهم اعمال من دون ذلک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.36,
   "end": 211.94,
   "text": "يقول ما كتب عليهم في",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.94,
   "end": 217.0,
   "text": "اللوح ما هم لها عاملون قبل ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.0,
   "end": 221.6,
   "text": "یخلقوهم لذلك الأعمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.6,
   "end": 224.98,
   "text": "المکتوبة عاملون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.98,
   "end": 229.22,
   "text": "بله که داره تصریح می‌کنه به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.22,
   "end": 233.96,
   "text": "آنچه که این‌ها اعمال که انجام میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.96,
   "end": 241.58,
   "text": "\"ولهم اعمال من دون ذلک\" آنچه قبل از اینکه آفریده بشن، امام باقر صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.58,
   "end": 245.78,
   "text": "داره می‌فرماید که قبل از اینکه آفریده بشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.78,
   "end": 250.42,
   "text": "آنچه که الان دارن اعمال انجام میدن در لوحی نوشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.42,
   "end": 256.98,
   "text": "در اون لوح ماقبل نوشته شده، در اون لوح محفوظ ثبت شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.98,
   "end": 263.6,
   "text": "که اون‌ها این اعمال رو اعم-- انجام خواهند داد و عامل این اعمال خواهند بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 263.6,
   "end": 267.6,
   "text": "حالا وجه، یه وجهش که حالا برمی‌گرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 267.6,
   "end": 272.8,
   "text": "بحث قرآن این رو عرض کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 272.8,
   "end": 275.62,
   "text": "چقدر ما از این قرآن غافل هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 275.62,
   "end": 281.66,
   "text": "صریح اینجا امام باقر صلوات الله علیه اشاره دارن به بی‌خبری ما از این یعنی از قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.66,
   "end": 288.66,
   "text": "\"قلوبهم فی غمرة من هذا\" این \"هذا\" رو زدن به قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 288.66,
   "end": 291.2,
   "text": "از قرآن \"یعنی من القرآن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 291.2,
   "end": 294.28,
   "text": "از القرآن غافل هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 294.28,
   "end": 297.9,
   "text": "قرآن می‌دونید مقامش مقام جمعی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 297.9,
   "end": 302.7,
   "text": "به یک معنا همون‌طوری که قبلاً عرض شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 302.7,
   "end": 307.4,
   "text": "، اون صورت کتبیه انسان کامل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 307.4,
   "end": 311.9,
   "text": "خب انسان کامل هم که کون جامع بود و برزخ جامع بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 311.9,
   "end": 316.84,
   "text": "همه اکوان، همه اشیا، همه اسماء درش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 316.84,
   "end": 319.2,
   "text": "در او هستند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 319.2,
   "end": 324.24,
   "text": "\"و کل شیء احصیناه فی امام مبین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 324.24,
   "end": 326.62,
   "text": "وقتی قرآن می‌شود صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 326.62,
   "end": 331.26,
   "text": "کتبیه انسان کامل و اون امام مبین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 331.26,
   "end": 335.1,
   "text": "پس این قرآن هم همه چی در او درد شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 335.1,
   "end": 340.58,
   "text": "چگونه است که ما کتابی از سمت ناحیه مقدسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 340.58,
   "end": 343.34,
   "text": "خدای منان برای ما نازل شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 343.34,
   "end": 346.44,
   "text": "اونم از اون اعلی مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 346.44,
   "end": 350.56,
   "text": "از اون بالاترین مراتب نازل شده اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 350.56,
   "end": 358.54,
   "text": "در حد فهم و شعور و درک ما نازل شده، تنزل پیدا کرده که عموم مردم بتونن باهاش مرتبط بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.54,
   "end": 363.46,
   "text": "و ما مدعی هستیم که همه چی در او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 363.46,
   "end": 366.86,
   "text": "تجمع کرده، مقام جمعی دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 366.86,
   "end": 373.72,
   "text": "درد و درمان ما در قرآن است و ما این همه درد داریم و بی درمان موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 373.72,
   "end": 378.52,
   "text": "چگونه است که ما بی‌خبریم و این همه اخبار که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 378.52,
   "end": 382.38,
   "text": "\"من اراد علم الاول-- علم الاولین والآخرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 382.38,
   "end": 392.18,
   "text": "فلیتفكر القرآن\". علم اول و آخر به فرمایش امام سجاد صلی الله علیه در قرآن تجمع کرده و ما اینقدر بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 392.18,
   "end": 396.3,
   "text": "خب علتش اینه که متأسفانه از قرآن دور بودیم یا اگر بر حسب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 396.3,
   "end": 401.7,
   "text": "ظاهر با قرآن مأنوس بودیم البته \"لا یمسه إلا المطهرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 401.7,
   "end": 405.86,
   "text": "ما مس نکردیم حقایق قرآنی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 405.86,
   "end": 408.84,
   "text": "و چه جالب که در همین بقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 408.84,
   "end": 413.82,
   "text": "این حدیث امام باقر صلی الله علیه می‌فرماید اعمال این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 413.82,
   "end": 418.48,
   "text": "در اون لوح ثبت شده در لوحی که قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 418.48,
   "end": 421.66,
   "text": "از قبل این لوح، لوح محفوظ لوح حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 421.66,
   "end": 424.4,
   "text": "هر لوحی که بگیری به هر حال لوح، لوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 424.4,
   "end": 429.32,
   "text": "محفوظ است که اونجا این‌ها اعمالشون ثبت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 429.32,
   "end": 432.36,
   "text": "بعضی از بزرگان نظرشون این هستش که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 432.36,
   "end": 436.22,
   "text": "لوحی که اینجا امام باقر صلی الله علیه می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 436.22,
   "end": 440.98,
   "text": "با کمی تدقق هم متوجه این دقت می‌شیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 440.98,
   "end": 443.32,
   "text": "همون منظور علم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 443.32,
   "end": 447.6,
   "text": "یعنی در علم حضرت حق در همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 447.6,
   "end": 452.84,
   "text": "صور علمیه یا ماهیات یا ایان ثابت در ثقل ذات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 452.84,
   "end": 456.72,
   "text": "این‌ها بوده که هر کسی در آینده چه خواهد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.72,
   "end": 461.58,
   "text": "حالا پس چرا ما تو این دنیا اومدیم در حالی که خدا می‌دونست علم داشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 461.58,
   "end": 467.32,
   "text": "اینا دیگه برمی‌گرده به حکمت‌هایی که همه بر اساس لطف، قاعده لطف خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 467.32,
   "end": 469.86,
   "text": "دو مرتبه خدا مهلت داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 469.86,
   "end": 476.22,
   "text": "دنیایی رو انشا کرده که بیاییم اینجا با انزال كتب و ارسال رسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 476.22,
   "end": 481.84,
   "text": "ما رو متنبّه کنند بلکه یه نفرمون شده نجات پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 481.84,
   "end": 488.42,
   "text": "مثلی که دارد مثلاً ابا عبدالله صلی الله علیه در کربلا همه هستیش رو ریخت پای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 488.42,
   "end": 491.38,
   "text": "دین حتی شش ماهه‌شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 491.38,
   "end": 494.12,
   "text": "خب شش ماهه‌شو چرا قربانی داد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 494.12,
   "end": 496.82,
   "text": "برای اینکه شده دل یه-- یه وجهش البته اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 496.82,
   "end": 501.68,
   "text": "دل یک نفرم که شده از اون قسی القلب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 501.68,
   "end": 506.34,
   "text": "مقابل آقا تکون بخوره، بلرزه کما این که این اتفاق هم افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 506.34,
   "end": 510.12,
   "text": "و اون برگ برنده ایست برای قیام عاشورا، نجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 510.12,
   "end": 515.44,
   "text": "این‌ها به هر حال اسماء الهی به نحو اعظم در این‌ها پیاده شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 515.44,
   "end": 517.6,
   "text": "این‌ها هم لطیف‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 517.6,
   "end": 520.8,
   "text": "این‌ها هم لطف حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 520.8,
   "end": 524.48,
   "text": "این‌ها هم بر اساس قاعده لطف تشریف آوردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 524.48,
   "end": 527.26,
   "text": "که بتوانند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 527.26,
   "end": 529.88,
   "text": "دستگیری کنند از جا مانده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 529.88,
   "end": 533.1,
   "text": "لذا کشتی نجات شدند. حالا این قرآن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 533.1,
   "end": 538.14,
   "text": "به تسری این فرمایش امام باقر صلی الله علیه در این روایت شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 538.14,
   "end": 544.86,
   "text": "از اون تفسیر علی بن ابراهیم یعنی معروف به تفسیر اهل بیت علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 544.86,
   "end": 549.06,
   "text": "اونجا فرمودم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 549.06,
   "end": 551.9,
   "text": "این بی‌خبری ما به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 551.9,
   "end": 554.26,
   "text": "بی‌خبری از قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 554.26,
   "end": 559.44,
   "text": "حالا این قرآن از اون مراتب عالیه تنزل پیدا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 559.44,
   "end": 562.62,
   "text": "و آمده به مراتب نازله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 562.62,
   "end": 570.66,
   "text": "که اتفاقاً در همین خصوص حضرت استاد کل علامه سنزدی الله رحمة در کتاب شریف هزار و یک کلمه‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 570.66,
   "end": 577.68,
   "text": "اونجا می‌فرمایند که بدان که قرآن اگرچه یک حقیقت است، یک حقیقت جمعی دارد دیگه محل جمع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 577.68,
   "end": 587.06,
   "text": "مثلاً مقام، مقام جمعیست. اما آن را به حسب نزول مراتب بسیار است و به لحاظ مراتب اسامی گوناگون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 587.06,
   "end": 591.46,
   "text": "یعنی در هر مرتبه‌ای و هر نشئه ای قرآن اسمش متفاوت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 591.46,
   "end": 595.06,
   "text": "اینکه می‌بینید اسامی هم خود قرآن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 595.06,
   "end": 600.6,
   "text": "متن خودش اسم‌های مختلف از خودش بیان می‌کنه به جهت همین مراتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 600.6,
   "end": 604.38,
   "text": "حالا و ادامه آقا می‌فرمایند که و در هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 604.38,
   "end": 608.64,
   "text": "نشئه اسمی خاص مطابق آن نشئه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 608.64,
   "end": 611.78,
   "text": "چنانکه انسان کامل یک حقیقت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 611.78,
   "end": 614.24,
   "text": "ببینید تطبیق بین انسان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 614.24,
   "end": 619.74,
   "text": "قرآن و آن را اطوار و مقامات و درجات بسیار است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 619.74,
   "end": 623.08,
   "text": "و در هر طور و مقام اسمی خاص دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 623.08,
   "end": 627.65,
   "text": "یعنی انسان، انسان هم در هر طوری اسم خاصی پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 627.65,
   "end": 633.26,
   "text": "قرآن در عالمی مجید نامیده می‌شود و در عالمی عزیز و در عالمی علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 633.26,
   "end": 641.78,
   "text": "حکیم و در عالمی کریم و در عالمی مبین و در عالمی حکیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 641.78,
   "end": 645.5,
   "text": "و این‌ها اسامی‌ای است که در قرآن از آنها اسم برده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 645.5,
   "end": 651.36,
   "text": "یعنی خود قرآن خودش رو این چنین یاد کرده و آن را هزاران اسم است که شنیدن آنها با این گوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 651.36,
   "end": 653.28,
   "text": "سر امکان ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 653.28,
   "end": 656.68,
   "text": "وانگهی معانی هرگز اندر حرف نیاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 656.68,
   "end": 659.98,
   "text": "که بحر غزل اندر ظرف نیاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 659.98,
   "end": 662.42,
   "text": "و اگر در عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 662.42,
   "end": 665.82,
   "text": "عشق حقیقی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 665.82,
   "end": 668.24,
   "text": "محبت الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 668.24,
   "end": 670.86,
   "text": "دارای گوش باطنی هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 670.86,
   "end": 675.66,
   "text": "یعنی گوش دل داری توانی آن نام‌ها را بشنوی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 675.66,
   "end": 678.72,
   "text": "آن اطوار را بنگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 678.72,
   "end": 683.06,
   "text": "که نظر بندازی به ملکوت، اون تنزل رو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 683.06,
   "end": 688.66,
   "text": "خب وقتی حضرت علامه این چنین می‌فرماید پس قابل رؤیت است، قابل شنود است، قابل شهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 688.66,
   "end": 691.16,
   "text": "است. چرا ما شنود و شهود در این جهت نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 691.16,
   "end": 693.78,
   "text": "چرا بی‌خبریم؟ خب معلومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 693.78,
   "end": 696.82,
   "text": "کار نکردیم، زحمت نکشیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 696.82,
   "end": 699.18,
   "text": "و قوای خودمون رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 699.18,
   "end": 701.92,
   "text": "طهارت قوا رو در خودمون ایجاد نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 701.92,
   "end": 707.26,
   "text": "مزاج بر سر سبک غلط زندگی همینطور که قبلاً عرض شد از اعتدال خارج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 707.26,
   "end": 709.66,
   "text": "حوصله قرآن خوندن نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 709.66,
   "end": 712.86,
   "text": "توجه به باطن قرآن نداریم و مریضیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 712.86,
   "end": 715.98,
   "text": "اون مریضی بولیموس که عرض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 715.98,
   "end": 720.48,
   "text": "مرحوم فارابی می‌فرماید طرف گشنه است اما نمی‌دونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 720.48,
   "end": 723.82,
   "text": "جهاز هاضمه‌ش و اینا ریخته به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 723.82,
   "end": 726.02,
   "text": "حس گرسنگی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 726.02,
   "end": 730.28,
   "text": "ما هم از درون روحمون گرسنه است اما خبر نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 730.28,
   "end": 732.48,
   "text": "احساس سیری می‌کنیم. چرا احساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 732.48,
   "end": 738.68,
   "text": "سیری می‌کنیم؟ مگر این نیست که \"یا ایها الناس انتم الفقراء الى الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 738.68,
   "end": 741.1,
   "text": "والله هو الغني الحمید\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 741.1,
   "end": 744.98,
   "text": "مگر این نیست که عطش وجودی ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 744.98,
   "end": 748.9,
   "text": "با دریای یت-- لایتناهی و بی‌انتهاي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 748.9,
   "end": 752.18,
   "text": "الله و اون الوهیت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 752.18,
   "end": 755.76,
   "text": "مجمع جمع اسم و صفات است برطرف می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 755.76,
   "end": 760.38,
   "text": "پس چگونه است که ما به اون دریا نرسیده احساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 760.38,
   "end": 766.82,
   "text": "سیری می‌کنیم؟ در حالی که عطش ما، اون فقر ما با الله باید برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 766.82,
   "end": 771.8,
   "text": "یعنی الله که لایتناهی است پس عطش ما اصلاً رفع نشدنی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 771.8,
   "end": 775.76,
   "text": "ما باید با اون لای روحی کانال وجودی‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 775.76,
   "end": 780.88,
   "text": "از اون ربمون که فملاقی قرار ریا-- لیاقتش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 780.88,
   "end": 783.78,
   "text": "لیاقت زیارتش رو پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 783.78,
   "end": 787.9,
   "text": "چه کنیم؟ با عمل صالح و دوری از شرک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 787.9,
   "end": 792.08,
   "text": "باید از طریق اون رب برسیم که کانال وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 792.08,
   "end": 795.3,
   "text": "منت-- اولین اسمی‌ست که منتشر شده از اسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 795.3,
   "end": 800.92,
   "text": "برسیم به اسم الله و برسیم به اون اقیانوس لایتناهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 800.92,
   "end": 803.54,
   "text": "چگونه است که احساس سیری داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 803.54,
   "end": 808.28,
   "text": "به جهت اینکه دستمون به اون اقیانوس نرسیده یا اگر رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 808.28,
   "end": 812.24,
   "text": "در درون اون بولیموس مریضی رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 812.24,
   "end": 818.58,
   "text": "یعنی مریضی روحی، قلبمون مریض شده، احساس گرسنگی نداریم، احساس عطش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 818.58,
   "end": 822.48,
   "text": "بسنده می‌کنیم به چهار تا لفظ و کتاب و شنیده‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 822.48,
   "end": 825.02,
   "text": "چهار تا درس و بحث و چهار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 825.02,
   "end": 828.78,
   "text": "رکعت عبادت و چهار تا زیارت و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 828.78,
   "end": 831.92,
   "text": "در حالی که عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 831.92,
   "end": 838.44,
   "text": "إنا أنزلناه في ليلة القدر فعلاً تمام حقایق امکانی در قلبش نازل میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 838.44,
   "end": 841.6,
   "text": "باز صدا میزنه که هل من مزید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 841.6,
   "end": 848.1,
   "text": "آیا باز هم هست؟ که به سمت اسم مستعصي حضرت حق حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 848.1,
   "end": 851.54,
   "text": "پس این دردی‌ست که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 851.54,
   "end": 856.1,
   "text": "ما از همین مرتبه نازله قرآن هم بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 856.1,
   "end": 860.28,
   "text": "واقعاً از همین حروف و کلمات و چینش و بافت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 860.28,
   "end": 862.92,
   "text": "مزاج قرآن در حسب ظاهر هم بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 862.92,
   "end": 865.96,
   "text": "چه برسه به باطن و بواتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 865.96,
   "end": 871.78,
   "text": "تأویل و اون حالا عمق‌هایی که براش مطرح کردن که بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 871.78,
   "end": 876.84,
   "text": "حالا اون إنك لَتلقى القرآن من لدن حكيم عليم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 876.84,
   "end": 880.98,
   "text": "که علامه فرمودن در حال عالمی یک اسمی داره توی عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 880.98,
   "end": 884.9,
   "text": "حکیم علیمه. کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 884.9,
   "end": 889.4,
   "text": "اون تل-- من لدن، اون مربوط به ذات حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 889.4,
   "end": 892.44,
   "text": "وقتی در ذات این علم، علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 892.44,
   "end": 897.06,
   "text": "و علم علوم قرآنی، خود قرآن در ذاتش میشه علیم حکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 897.06,
   "end": 900.84,
   "text": "قرآن حکیم میشه، قرآن، قرآن علیم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 900.84,
   "end": 903.4,
   "text": "وقتی که مثلاً در مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 903.4,
   "end": 907.9,
   "text": "عقل کل قرار می‌گیره میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 907.9,
   "end": 910.74,
   "text": "می‌شود قرآن، قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 910.74,
   "end": 913.32,
   "text": "ام الکتاب، ام الکتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 913.32,
   "end": 917.6,
   "text": "وقتی نفس کل می‌شود، می‌شود قرآن مبین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 917.6,
   "end": 922.26,
   "text": "که حالا این‌ها بعداً باید مورد بحث قرار بگیره که فرق این‌ها چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 922.26,
   "end": 926.46,
   "text": "عزیزان می‌تونند رجوع کنند به کتاب شریف و بی‌نظیر فس اسمیه از علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 926.46,
   "end": 930.66,
   "text": "اونجا بیان می‌کنه که فرق نفس کل با عقل کل چیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 930.66,
   "end": 934.46,
   "text": "و حالا عقل به صورت کلی‌تر و جمع الجمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 934.46,
   "end": 936.3,
   "text": "به یک معنا نسبتش به نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 936.3,
   "end": 939.88,
   "text": "نفس کل مقام کثرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 939.88,
   "end": 942.14,
   "text": "مقام پرورش مادونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 942.14,
   "end": 948.96,
   "text": "نفس کل که مقام حضرت صدیقه طاهره سلام الله علیها و عقل کل هم مقام حضرت امیرالمؤمنین علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 948.96,
   "end": 951.7,
   "text": "خب این بی‌خبری چه کرده با ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 951.7,
   "end": 954.9,
   "text": "که از لفظ قرآن هم از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 954.9,
   "end": 958.04,
   "text": "ظاهر قرآن هم که ملاصدرا علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 958.04,
   "end": 961.28,
   "text": "در کتاب شریف مفاتیح الغیبش می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 961.28,
   "end": 967.8,
   "text": "در اون مفتاح دوم فاتحه دوم می‌فرماید فهم عظمت القرآن و تصریح می‌کنه که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 967.8,
   "end": 970.48,
   "text": "ظاهر قرآن هم لمعات اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 970.48,
   "end": 972.66,
   "text": "انوار جمال خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 972.66,
   "end": 977.58,
   "text": "هویداست. ولی همه نمی‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 977.58,
   "end": 983.12,
   "text": "ما متأسفانه از همین عظمت ظاهری قرآن هم بی‌خبریم، بی‌بهره‌ایم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 983.12,
   "end": 987.84,
   "text": "متوجه نیستیم. به راحتی در محضر قرآن پامونو دراز می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 987.84,
   "end": 991.22,
   "text": "می‌خوابیم در حالی که قرآن رو طاقچه پایین پامونه و، و، و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 991.22,
   "end": 994.04,
   "text": "به همین ظاهر قرآن هم متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 994.04,
   "end": 997.94,
   "text": "نرسیدیم. ان‌شاءالله خدای منان به هممون رحم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 997.94,
   "end": 1000.24,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1000.24,
   "end": 1011.88,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1011.88,
   "end": 1015.82,
   "text": "صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
