 "chapters": [
  {
   "index": 0,
   "title": "## مواقع النجوم و اعجاز علمی قرآن",
   "start": 65.16,
   "end": 268.24
  },
  {
   "index": 1,
   "title": "امروز که خدا لطف کرده در عصر اطلاعات و گسترش علم قرار گرفته‌ایم متوجه این جایگاهیم که قرآن باز در جای دیگر می‌فرماید:",
   "start": 268.24,
   "end": 360.44
  },
  {
   "index": 2,
   "title": "## طهارت نفس؛ رمز مسّ کتاب مکنون",
   "start": 360.44,
   "end": 441.19
  },
  {
   "index": 3,
   "title": "## معرفت نفس؛ کانال اتصال به قرآن",
   "start": 441.19,
   "end": 761.36
  },
  {
   "index": 4,
   "title": "## سه قرآن و روزنه‌های وجود؛ حسرت جنب الله",
   "start": 761.36,
   "end": 905.24
  },
  {
   "index": 5,
   "title": "چقدر وقتی آه حسرت سر دهیم:",
   "start": 905.24,
   "end": 1007.28
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 5.52,
   "text": "بسم الله الرحمن الرحيم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.52,
   "end": 9.34,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.34,
   "end": 12.58,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.58,
   "end": 19.44,
   "text": "استفسار دیگری که در خصوص نماز جماعت در مراکز من-- حالا مناطقی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.44,
   "end": 21.9,
   "text": "بیشتر امم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.9,
   "end": 28.74,
   "text": "ائمه جمعه و جماعتشون اهل تسنن هستند از رهبر عزیزمون شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.74,
   "end": 38.92,
   "text": "پرسیدن محل کار من در یکی از مناطق کردنشینه اکثر ائمه جمعه و جماعت اونجا اهل تسننند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.92,
   "end": 40.58,
   "text": "اقتدا با اون‌ها چه حکمی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.58,
   "end": 43.6,
   "text": "و آیا غیبت آنان جایز است یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.6,
   "end": 46.46,
   "text": "رهبر عزیز فرمودند که مشارکت با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.46,
   "end": 49.46,
   "text": "آنان در نماز جمعه و جماعتشان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.46,
   "end": 52.48,
   "text": "از جهت حفظ وحدت اشکال ندارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.48,
   "end": 56.14,
   "text": "و بعد می فرمایند که از غیبت اون‌ها هم باید پرهیز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.14,
   "end": 60.2,
   "text": "یعنی دلیل نمیشه که حالا این اهل چون اهل تسنن هستند الآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.2,
   "end": 63.44,
   "text": "مثلاً به جواز بر غیبتشون بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.44,
   "end": 68.14,
   "text": "اما ادامه بحث قلب من ومر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.14,
   "end": 75.6,
   "text": "موضوع قرآن و بی‌خبری ما حداقل حتی از ظاهر قرآن بود و از اخبار قرآنی، علوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.6,
   "end": 79.82,
   "text": "و اعجاز علمی قرآن و این‌ها بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.82,
   "end": 85.08,
   "text": "یکی دیگه از آیاتی که به زیبایی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.08,
   "end": 89.1,
   "text": "به این اعجاز علمی قرآن اشاره کرده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.1,
   "end": 95.22,
   "text": "آیه هفتاد و پنج به بعد سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.22,
   "end": 98.32,
   "text": "واقعه است. اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.32,
   "end": 104.38,
   "text": "خدای منان در سوره واقعه می‌فرماید \"فلا اقسم بمواقع النجوم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.38,
   "end": 106.8,
   "text": "که قسم می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.8,
   "end": 109.0,
   "text": "اینجا خدای منان در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.0,
   "end": 111.14,
   "text": "به مواقع نجوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.14,
   "end": 116.52,
   "text": "در اون محلی که ستارگان رفت و آمد می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.52,
   "end": 119.76,
   "text": "خب که البته بعدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.76,
   "end": 127.72,
   "text": "می‌فرماید و \"إنه لقسم لو تعلمون عظيم\" اگر شما بدونید \"لو تعلمون\" اگر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.72,
   "end": 130.6,
   "text": "می‌دونستید \"إنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.6,
   "end": 133.72,
   "text": "لقسم عظيم\" یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.72,
   "end": 136.96,
   "text": "قطعاً، قطعاً تاکید می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.96,
   "end": 140.08,
   "text": "که این قسم بزرگی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.08,
   "end": 143.94,
   "text": "خب اون موقع که کسی باخبر نبود از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.94,
   "end": 146.6,
   "text": "وضعیت کائنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.6,
   "end": 151.04,
   "text": "و کهکشان‌ها و کرات و ستارگان و اینا فوقش اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.04,
   "end": 160.36,
   "text": "در اون زمان گمان می‌کردند ستارگان یه میخ‌های نقره‌ای هستند که به سقف آسمان کوبیده شدن برای همین حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.36,
   "end": 163.66,
   "text": "و کسی خبر نداشت از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.66,
   "end": 168.52,
   "text": "مواقع و اون مداری که ستارگان درش قرار گرفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.52,
   "end": 176.2,
   "text": "خیلی جالبه که قرآن تصریح می‌کنه اگه می‌دونستید \"لو تعلمون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.2,
   "end": 180.56,
   "text": "که این چه قسم بزرگیه یعنی الان شما نمی‌دونید بعدها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.56,
   "end": 183.14,
   "text": "حالا بعضی از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.14,
   "end": 186.76,
   "text": "عظمت کرات در اکتشافات و اختراعات اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.76,
   "end": 190.1,
   "text": "مکشوف بشه، مشخص بشه متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.1,
   "end": 196.42,
   "text": "عظمت این قسم می‌شید که بعد حالا این قسم رو خدا مقدمه کرده برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.42,
   "end": 198.62,
   "text": "که \"إنه لقرآن کریم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.62,
   "end": 202.76,
   "text": "باز تاکید دو تا تاکید \"إنه\" یکم \"ل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.76,
   "end": 204.28,
   "text": "لام تأکید \"قرآن کریم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.28,
   "end": 207.72,
   "text": "حالا قرآن کریمه، کریم دستش بازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.72,
   "end": 212.38,
   "text": "سفره پهنه \"معدبت الله\" بفرمایید بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.38,
   "end": 214.8,
   "text": "سفره کریمانه پهن شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.8,
   "end": 218.44,
   "text": "گر گدا کاهل بود تقصیر صاحب‌خانه چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.44,
   "end": 222.0,
   "text": "اگر ما دست دراز نمی‌کنیم و خرشه نمی‌چینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.0,
   "end": 227.22,
   "text": "و غذا بر نمی‌داریم، تقصیر صاحب‌خانه چیست که این معدو برو پهن کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.22,
   "end": 231.9,
   "text": "القرآن معدبت الله دیگه سفره‌ایست که طعام در او حاضره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.9,
   "end": 235.02,
   "text": "نسبت به سعای وجودی هر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.02,
   "end": 239.24,
   "text": "حاضر غذا درش. متأسفانه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.24,
   "end": 243.28,
   "text": "نرفتیم و غذا بر نداشتیم رضا گرسنه موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.28,
   "end": 246.72,
   "text": "حالا امروزه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.72,
   "end": 250.6,
   "text": "خدا لطف کرده و ما در عصر اطلاعات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.6,
   "end": 260.54,
   "text": "و گسترش این اطلاعات و توسعه علمی و تولید علم و این‌ها قرار گرفتیم، متوجه این جایگاه هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.54,
   "end": 265.08,
   "text": "که همونطور که قرآن باز در جای دیگه می‌فرماید و \"کلن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.08,
   "end": 268.24,
   "text": "کلن فی فلک یسبحون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.24,
   "end": 272.98,
   "text": "کل دیگه همه و همه در یک فلکی‌اند در یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 272.98,
   "end": 279.52,
   "text": "مداری‌اند \"یسبحون\" شناگرند در اون مدار خودشون که مطلقا یک اپسیلون، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.52,
   "end": 282.06,
   "text": "میکرون اعوجاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.06,
   "end": 286.86,
   "text": "در این مدارات وجود ندارد که اگر وجود داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 286.86,
   "end": 289.42,
   "text": "به هم می‌خوردند زمین و زمان به هم می‌ریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 289.42,
   "end": 291.74,
   "text": "و این یکی از اعجاز علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 291.74,
   "end": 295.24,
   "text": "از مهم‌ترین اعجاز علمی قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.24,
   "end": 300.8,
   "text": "که وقتی توجه کنیم طبق گواهی دانشمندا می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 300.8,
   "end": 306.0,
   "text": "حالا اونچه که در تفسیر نمونه هم که حالا من مطلب بحثمون در تس-تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 306.0,
   "end": 310.12,
   "text": "نمونه بود، او خیلی سال‌های پیش در تفسیر نمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.12,
   "end": 312.94,
   "text": "فرموده بودند که دانشمندان روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.94,
   "end": 317.74,
   "text": "بیش از یک هزار میلیون یعنی بیش از میلیارد ستاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.74,
   "end": 320.36,
   "text": "کشف کردن که گفتند وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.36,
   "end": 326.76,
   "text": "و به جز این ستارگان‌ها کشف کهکشان‌های زیادی هم موجود هستند که هر کدومشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.76,
   "end": 329.38,
   "text": "توی مسیر خاصی هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.38,
   "end": 334.4,
   "text": "که این نشون میده این سوگند قرآنی چقدر عظمت داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.4,
   "end": 338.7,
   "text": "شما اینا رو همونطور که دارید می‌شنوید توجه داشته باشید عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.7,
   "end": 341.64,
   "text": "که با اون وضعیت اون روز، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.64,
   "end": 346.16,
   "text": "جهل و نادانی که در محیط اون روز حاکم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 346.16,
   "end": 349.66,
   "text": "که دانشمندان اون روز تازه فکر می‌کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.66,
   "end": 354.52,
   "text": "ستاره‌های میخ‌های نقره‌ای‌اند کوبیده شده به سقف آسمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 354.52,
   "end": 358.88,
   "text": "ببینید این قرآن اون موقع پرده‌برداری از چه عظمت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 358.88,
   "end": 363.58,
   "text": "و می‌فرماید میخواد همه این قسم‌ها رو مقدمه بشینه به اینکه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 363.58,
   "end": 366.01,
   "text": "\"إنه لقرآن کریم\" این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 366.01,
   "end": 369.85,
   "text": "سفره گسترده‌ست. البته فی کتاب مکنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 369.85,
   "end": 372.55,
   "text": "این قرآن در یک کنی هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 372.55,
   "end": 375.27,
   "text": "در یک پرده‌ای هست، مکنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 375.27,
   "end": 378.97,
   "text": "باطنه که \"لا یمسهُ الا المطهرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 378.97,
   "end": 381.31,
   "text": "همه اون‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 381.31,
   "end": 387.49,
   "text": "هی دنبال این عالم و اون عالم و این کتاب و اون کتاب و از این درس و مکتب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 387.49,
   "end": 390.51,
   "text": "نمی‌دونم به اون درس و مکتب و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.51,
   "end": 392.57,
   "text": "از این استاد به اون استاد که آقا چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 392.57,
   "end": 394.15,
   "text": "چه کنیم؟ چه کنیم؟ بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.15,
   "end": 397.95,
   "text": "بفرمایید آقا جان. این سط-- این سفره، این معدوبت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 397.95,
   "end": 402.05,
   "text": "رمزشم \"لا یمسهُ الا المطهرون\" تموم شد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.05,
   "end": 405.01,
   "text": "هی نشینیم به این گیر بدیم، به اون اصرار کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.01,
   "end": 409.85,
   "text": "به اون التجا کنیم، به اون پافشاری کنیم که آقا یه راهی جلوی ما بگذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.85,
   "end": 412.55,
   "text": "نمی‌دونم من چگونه آدم موفقی باشم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.55,
   "end": 415.13,
   "text": "چگونه از ظاهر قرآن به باطنش عبور کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.13,
   "end": 417.99,
   "text": "چگونه از این بی‌خبری نسبت به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.99,
   "end": 419.67,
   "text": "معدوبت الله نجات پیدا کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.67,
   "end": 422.23,
   "text": "بسم الله رمز و کد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.23,
   "end": 425.25,
   "text": "اون عمحات و اصول مهمه رو قرآن بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.25,
   "end": 427.79,
   "text": "\"لا یمسهُ الا المطهرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.79,
   "end": 431.87,
   "text": "آقا جان با طهارت میشه به اونجا رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.87,
   "end": 435.77,
   "text": "یزکیه اون تزکیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.77,
   "end": 437.73,
   "text": "زکات هم از همین ریشه است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.73,
   "end": 442.63,
   "text": "رشد و نموه. یعنی رشد و نمو شما در پس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.63,
   "end": 448.39,
   "text": "طهارت نفسه. یعنی اگر شما می‌خواید رشد کنید، نمو پیدا کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 448.39,
   "end": 452.19,
   "text": "با طهارت نفس برید سر سفره قرآن بشینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.19,
   "end": 456.95,
   "text": "که متأسفانه این بی‌خبری شما از قرآن کار داده دست شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 456.95,
   "end": 467.23,
   "text": "حالا شما ببینید که این دانشمندان فلکی فعلاً این ستارگانی که بیش از یک مثلاً میلیاردها عدد الان که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.23,
   "end": 472.31,
   "text": "قبلاً می‌گفتن مثلاً یک هزار میلیون ستاره اینا الان که میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.31,
   "end": 477.97,
   "text": "در آسمان‌ها میلیاردها به توان میلیارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 477.97,
   "end": 487.87,
   "text": "عرض شود ترمینال وجود داره که در هر ترمینالی میلیارد به توان میلیارد یعنی عدد نتونستن بدن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 487.87,
   "end": 495.29,
   "text": "میلیارد به توان میلیارد کهکشان و منظومه شمسی که درون اون‌ها س-ستارگان متعدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 495.29,
   "end": 496.93,
   "text": "الی ماشاءالله وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.93,
   "end": 499.95,
   "text": "همه هم در یک مداری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 499.95,
   "end": 502.63,
   "text": "همه در مداری در حرکتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 502.63,
   "end": 505.05,
   "text": "شما این عظمت رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.05,
   "end": 511.31,
   "text": "کی می‌تونه اون موقع این عظمت رو ببینه و بهش قسم بخوره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.31,
   "end": 515.67,
   "text": "این قسم رو پایه تعظیم قرآن قرار بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.67,
   "end": 521.27,
   "text": "و توجه مردم رو جلب کنه به سفره گسترده معدوبت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.27,
   "end": 527.65,
   "text": "و بگه که رمز و راز رسیدن به این کتاب مکنون هم چیزی نیست جز طهارت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 527.65,
   "end": 532.65,
   "text": "یعنی از درون خودت هرچه تجسس می‌کنی، تفحص می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 532.65,
   "end": 535.23,
   "text": "می‌بینی که هرچه هست در درون خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 535.23,
   "end": 537.83,
   "text": "همه از درون خودت اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 537.83,
   "end": 540.87,
   "text": "باید از درون خودت بری برسی به این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.87,
   "end": 546.15,
   "text": "این‌هایی که از بیرون می‌گردن و از درون غافلن به جایی نمی‌رسن عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 546.15,
   "end": 548.45,
   "text": "اینکه حالا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.45,
   "end": 552.73,
   "text": "حالا اون کتاب شریف صد کلمه در معرفت نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 552.73,
   "end": 563.01,
   "text": "اونجا در کلمه نوزدهم باید باشه که از تعالم فرمودن «آنکه در وادی مقدس من کیستم قدم ننهاده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 563.01,
   "end": 568.01,
   "text": "خرواری به خردلی». مثل اینکه حالا این خروار خرده رو باید تعبیر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 568.01,
   "end": 573.65,
   "text": "منظور علامه احتمال این باشه که شما یه خروار سکه رو مثلاً بدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 573.65,
   "end": 577.25,
   "text": "یه خرده مثلاً یه دانه خردل بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 577.25,
   "end": 581.81,
   "text": "انقدر ضرر درشه. اونم وادی مقدس من کیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 581.81,
   "end": 588.13,
   "text": "یعنی معرفت نفس مقدسه، بلکه مقدس‌ترین‌هاست، بلکه اقدسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 588.13,
   "end": 592.69,
   "text": "که می‌دونید دیگه در رس-- در اون رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 592.69,
   "end": 596.13,
   "text": "عن نهض الحق که سفارش کردیم عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 596.13,
   "end": 604.61,
   "text": "پیگیرش باشن، اونجا حضرت استاد می‌فرمود هیچ معرفتی چون معرفت نفس به کار انسان نمیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 604.61,
   "end": 608.57,
   "text": "و سرمایه همه سعادت‌ها این معرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 608.57,
   "end": 616.77,
   "text": "و اون که خودش رو نشناخت عاتل و باطل زیست و گوهر ذاتش رو تباه کرد و برای همیشه بی‌بهره ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 616.77,
   "end": 619.33,
   "text": "یعنی حتی کانال وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 619.33,
   "end": 625.97,
   "text": "ارتباط با دریای بیکران قرآن این معدوبت الله اللا یتناهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 625.97,
   "end": 627.89,
   "text": "باز کانال وجودی خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 627.89,
   "end": 632.33,
   "text": "از درون خودمون باید پل بزنیم به اونجا برسیم عزیزان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 632.33,
   "end": 636.93,
   "text": "به قرآن برسیم. که هرکس که این رو توجه کرد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 636.93,
   "end": 644.25,
   "text": "رفت رسید و چشید و دید که این دریا و مخصوصاً اون‌هایی که ساحل‌پیمایی نمی‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 644.25,
   "end": 650.03,
   "text": "صرفاً هم در کنار قرآن به ظاهر قرآن بسنده نمی‌کنن، بلکه به قول حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 650.03,
   "end": 654.89,
   "text": "میرن به لجه، میرن قدم می‌گذارن به لجه در عمق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 654.89,
   "end": 659.01,
   "text": "در اون، اون لجه عرض شود عمیق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 659.01,
   "end": 661.01,
   "text": "اون بطن عمیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 661.01,
   "end": 663.37,
   "text": "آیات و روایات، آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 663.37,
   "end": 666.17,
   "text": "و این سوره قرآن و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 666.17,
   "end": 672.97,
   "text": "این چه عظمتی！ یعنی واقعاً انسان دچار حیرت می‌شود وقتی که ورود می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 672.97,
   "end": 680.35,
   "text": "حالا شما این ظاهر قرآن رو که ما بحث معجزه علمی رو داریم مطرح می‌کنیم، هر عقل سلیمی و سالمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 680.35,
   "end": 682.59,
   "text": "اقرار می‌کنه که واقعاً معجزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 682.59,
   "end": 689.31,
   "text": "اونم اون موقع که همه بی‌خبر بودند چگونه است که یک انسانی که نخوانده است، ننوشته است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 689.31,
   "end": 693.05,
   "text": "توانسته یک همچ عظمت از خودش بیافریند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 693.05,
   "end": 698.65,
   "text": "و اینچنین انسان‌ها رو با باطن قرآن و این معدوبت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 698.65,
   "end": 702.01,
   "text": "آشنا کند که محل تأدیب هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 702.01,
   "end": 705.53,
   "text": "اگر معدبه بگیرید بحثش قبلاً گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 705.53,
   "end": 708.73,
   "text": "که محل ادبستانه. قرآن ادبستان الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 708.73,
   "end": 711.89,
   "text": "می‌خوای مؤدب بشی؟ بسم الله قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 711.89,
   "end": 716.11,
   "text": "و این‌ها نشون میده عزیزان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 716.11,
   "end": 719.67,
   "text": "ما چقدر متأسفانه عقب هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 719.67,
   "end": 726.26,
   "text": "و چقدر از اون کلید جنگ یا گنج سعادتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 726.26,
   "end": 730.94,
   "text": "خدای منان در درون خودمون قرار داده که با اون از خوانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 730.94,
   "end": 737.34,
   "text": "سطر سطر کتاب وجود خودمون، قرآن درون خودمون پی ببریم به این قرآن بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 737.34,
   "end": 741.2,
   "text": "بی‌خبریم که مفتاح سعادت جاودانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 741.2,
   "end": 744.46,
   "text": "و معراج سرای دو جهانی در معرت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 744.46,
   "end": 747.62,
   "text": "معرفت نفس جمع آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 747.62,
   "end": 751.44,
   "text": "او مفتاح مظهر مدینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 751.44,
   "end": 755.58,
   "text": "گوهرهای رازه دیگه که از این میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 755.58,
   "end": 759.4,
   "text": "پی برد. یا حالا اون قرآن رو که قبلاً بحثش گذشته بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 759.4,
   "end": 762.96,
   "text": "این قرآن رو حالا ما در ظاهر قرآن کتبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 762.96,
   "end": 767.12,
   "text": "داریم بحث می‌کنیم. بعد متوجه میشید که عجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 767.12,
   "end": 769.72,
   "text": "این قرآن کتبی کتب شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 769.72,
   "end": 772.5,
   "text": "قرآن آفاقی هست شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 772.5,
   "end": 775.9,
   "text": "و قرآن انفسi نفس شده در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 775.9,
   "end": 779.58,
   "text": "درون خودمون که تا این کانال رای-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 779.58,
   "end": 787.04,
   "text": "لای روبی نشه اتصال و ارتباط با اون قرآن بر اساس لا یمسّه إلا المتهرون رخ نخواهد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 787.04,
   "end": 793.38,
   "text": "که حالا طبق ممت الهمم از تو استاد اگر کسی بعد اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 793.38,
   "end": 800.96,
   "text": "در اون مداخل دوازده گانه‌ای که علامه قیسری برای شرح fusūs دارند و علامه توضیح میدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 800.96,
   "end": 804.4,
   "text": "اونجا میفرمایند که بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 804.4,
   "end": 808.8,
   "text": "مثل یه روزنه‌ای کانال وجودیشون ارتباط داره با اون دریای بیکران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 808.8,
   "end": 812.94,
   "text": "بعضیا هم مشب- شبکه شبکه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 812.94,
   "end": 817.16,
   "text": "یعنی اون روزنه هم منظور درستش روزنه دیگه روزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 817.16,
   "end": 820.64,
   "text": "اون تایی که آخرش اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 820.64,
   "end": 823.56,
   "text": "مثلا ما در فارسی میگیم روزن یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 823.56,
   "end": 828.94,
   "text": "منفذ، یک سوراخ اینا وقتی می‌خوایم بگیم خیلی کوچکه میگیم روزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 828.94,
   "end": 831.86,
   "text": "اونجا هم روازن رو وقتی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 831.86,
   "end": 838.5,
   "text": "از ته علامه قیسری میاره وسط استاد در ممت الهمم بحث میکنه روازن رو اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 838.5,
   "end": 841.02,
   "text": "یا عرض شود روزنه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 841.02,
   "end": 843.28,
   "text": "اونجا بیان میکنه که بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 843.28,
   "end": 846.58,
   "text": "خیلی راه ارتباطیشون از درون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 846.58,
   "end": 850.38,
   "text": "یه-- یعنی اون جدول وجودیشون خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 850.38,
   "end": 853.96,
   "text": "کوچیکه. یک مثلاً نهر کوچیکه، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 853.96,
   "end": 855.62,
   "text": "جدول خیلی زیغیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 855.62,
   "end": 858.24,
   "text": "بعضیا نه رود نیل میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 858.24,
   "end": 863.34,
   "text": "نمی‌دونم شبکه‌های ارتباطی با اون دریای لایتناهی پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 863.34,
   "end": 866.22,
   "text": "که این حالا ما میگیم لایتناهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 866.22,
   "end": 869.06,
   "text": "همون به زبان قرآن از سمت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 869.06,
   "end": 871.76,
   "text": "یا مثلاً ببین در فلسفه یه چیزی میگن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 871.76,
   "end": 875.04,
   "text": "عرفان یه چیز، قرآن. اما همش یک حقیقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 875.04,
   "end": 881.22,
   "text": "قرآن میگه از سمت لایتناهی سر فلسفه و عرفان لایتناهیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 881.22,
   "end": 886.3,
   "text": "عرض شود وجود واحد اون بسیط الحقایق کل الأشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 886.3,
   "end": 889.48,
   "text": "بسیط الحقایق کل الأشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 889.48,
   "end": 893.28,
   "text": "جوهر الجواهر. حقیقت الحقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 893.28,
   "end": 895.2,
   "text": "اینا همه یک حقیقت کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 895.2,
   "end": 902.62,
   "text": "یک، یک دریای لایتناهی بی‌انتها که ما باید از این جدول وجودیمون به اون مرتبط بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 902.62,
   "end": 907.46,
   "text": "و چقدر وقتی که آه حسرت سر بدیم که وا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 907.46,
   "end": 910.56,
   "text": "یا حسرتا علی ال--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 910.56,
   "end": 913.36,
   "text": "وا یا حسرتا علی ما فرطت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 913.36,
   "end": 919.52,
   "text": "فی جنب الله. اونجایی که قرآن می‌فرماید حسرت می‌خورند از جنب الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 919.52,
   "end": 922.36,
   "text": "اون جنب الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 922.36,
   "end": 926.22,
   "text": "یعنی اون اسم اعظمی که جنب الله بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 926.22,
   "end": 928.16,
   "text": "اون حالا به یک معنا ام-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 928.16,
   "end": 930.54,
   "text": "انسان کامله. به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 930.54,
   "end": 932.82,
   "text": "قرآن کتبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 932.82,
   "end": 935.12,
   "text": "اینا همه یک حقیقتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 935.12,
   "end": 937.84,
   "text": "که حالا این‌ها البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 937.84,
   "end": 940.3,
   "text": "شرح اون انسان کامل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 940.3,
   "end": 943.5,
   "text": "این نظام آفاقی قرآنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 943.5,
   "end": 946.86,
   "text": "عرض شود عینی، قرآن کتبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 946.86,
   "end": 950.04,
   "text": "قرآن کتب شده و نوشته شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 950.04,
   "end": 952.1,
   "text": "و شرح کتبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 952.1,
   "end": 956.76,
   "text": "و اون هم که متنه و اصله و غذا و لفظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 956.76,
   "end": 962.12,
   "text": "وجود انسان کامل. که ما از طریق خودمون باید متصل بشیم به این از، به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 962.12,
   "end": 965.52,
   "text": "از این شبکه‌های درون خودمون متصل بشویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 965.52,
   "end": 968.0,
   "text": "و متأسفانه این بی‌خبری ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 968.0,
   "end": 971.54,
   "text": "غافل کرده، دور کرده. انشاالله که خدا به هممون رحم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 971.54,
   "end": 978.24,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 978.24,
   "end": 981.28,
   "text": "اللهم صل على محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 981.28,
   "end": 988.08,
   "text": "اللهم صل وسلم وزد وبارك على رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 988.08,
   "end": 991.34,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 991.34,
   "end": 997.96,
   "text": "صل وسلم وزد وبارك على رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 997.96,
   "end": 1001.32,
   "text": "وآله الأطهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1001.32,
   "end": 1004.58,
   "text": "وآله الأطهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1004.58,
   "end": 1007.28,
   "text": "وآله الأطهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}