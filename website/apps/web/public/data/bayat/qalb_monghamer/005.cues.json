 "chapters": [
  {
   "index": 0,
   "title": "## تیمم بدل از غسل برای امام جماعت معذور",
   "start": 0.78,
   "end": 48.14
  },
  {
   "index": 1,
   "title": "## تناقض توجه به پست‌ترین امور و غفلت از آیات خلقت",
   "start": 48.14,
   "end": 149.02
  },
  {
   "index": 2,
   "title": "## آیات خلقت انسان در سورهٔ مؤمنون",
   "start": 149.02,
   "end": 199.22
  },
  {
   "index": 3,
   "title": "## سایه و اصل؛ مراتب هستی و رزق آسمانی",
   "start": 199.22,
   "end": 259.3
  },
  {
   "index": 4,
   "title": "## قبر برزخی و خطاب «اسمع افهم»",
   "start": 259.3,
   "end": 279.3
  },
  {
   "index": 5,
   "title": "## دعای عرفه؛ متى غبت و متى بعدت",
   "start": 279.3,
   "end": 746.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.78,
   "end": 4.78,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.78,
   "end": 8.6,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.6,
   "end": 12.3,
   "text": "آياته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.3,
   "end": 18.6,
   "text": "آیا تيمم بدل از غسل نسبت به امام جماعتی که معذور است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.6,
   "end": 21.54,
   "text": "برای اقامه نماز جماعت کافی است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.54,
   "end": 24.12,
   "text": "یعنی آن امام جماعتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.12,
   "end": 33.76,
   "text": "حالا مثلاً غسل بر او واجب شده اما نمی‌تواند غسل کند، تيمم بدل از غسل کند، می‌تواند اقامه جماعت کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.76,
   "end": 38.54,
   "text": "رهبر عزیزمون فرمودند که اگر شرعاً معذور باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.54,
   "end": 43.38,
   "text": "یعنی عذر داشته باشد از اینکه غسل کند می‌تواند با تيمم بدل از غسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.38,
   "end": 48.14,
   "text": "امام جماعت بشود و اقتداء به او هم اشکالی ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.14,
   "end": 51.88,
   "text": "در خصوص قلب منغمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.88,
   "end": 55.42,
   "text": "عرض می‌کنیم چگونه است که ما نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.42,
   "end": 66.54,
   "text": "حسیاتمون و آنچه که در دنیا در پست‌ترین حالت قرار گرفته است و هیچ خیری برای ما حتی در دنیا و آخرت هم ندارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.54,
   "end": 69.42,
   "text": "پیگیریم، متوجهیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.42,
   "end": 72.26,
   "text": "کنکاش می‌کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.26,
   "end": 75.26,
   "text": "ساعت‌ها و روزها حتی سال‌ها وقت می‌گذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.26,
   "end": 77.4,
   "text": "به وقت یک سریالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.4,
   "end": 80.0,
   "text": "صرفاً قوه خیال ما را به بازی گرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.0,
   "end": 86.06,
   "text": "ساعت‌ها، روزها، سال‌ها وقت می‌گذاریم، چندین بار پشت سر هم این را نگاه می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.06,
   "end": 90.62,
   "text": "حالا عرض شود فارغ از آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.62,
   "end": 95.44,
   "text": "سریال‌هایی که درش پیام‌ها و محتواهای عالیه دارد، آنها را کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.44,
   "end": 98.48,
   "text": "ولی بسیاری از این سریال‌ها صرفاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.48,
   "end": 101.94,
   "text": "خیال ما را مشوش می‌کند. چگونه است که اینجور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.94,
   "end": 107.18,
   "text": "خبرهای پیش پا افتاده و پست و دنی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.18,
   "end": 110.4,
   "text": "که صرفاً در همین مقطع دنیوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.4,
   "end": 112.7,
   "text": "و دنیاوی در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.7,
   "end": 115.42,
   "text": "مرتبه پست و مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.42,
   "end": 120.94,
   "text": "وقت ما را می‌گیرد و سرگرم‌مان می‌کند و مشغول‌مان می‌کند، توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.94,
   "end": 125.52,
   "text": "ویژه داریم و پیگیر آنها هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.52,
   "end": 127.62,
   "text": "این سریال‌ها مخصوصاً چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.62,
   "end": 131.42,
   "text": "یکی از آیات قرآن را می‌خواهم مورد مداقه‌ قرار بدهم، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.42,
   "end": 135.46,
   "text": "پیگیری سریال‌ها چون پی در پی‌اند، ثم ثم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.46,
   "end": 140.66,
   "text": "سپس این قسمتش، سپس قسمت بعدی همچنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.66,
   "end": 143.56,
   "text": "یک روز نبینیم پرس‌وجو می‌کنیم چه خبر شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.56,
   "end": 146.68,
   "text": "چی شد؟ بعد مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.68,
   "end": 153.48,
   "text": "توجه نمی‌کنیم به آیاتی که چقدر این آیات ثم ثم کار می‌رسد به قول اعلی الله مرزقنی رحمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.48,
   "end": 158.12,
   "text": "مثلاً آیات دوازده بعد سوره مؤمنون را دقت کنید و لقد خلقنا الانسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.12,
   "end": 161.16,
   "text": "این پیرامون خود ماست. خلقت خود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.16,
   "end": 165.52,
   "text": "که ای خدایی که ما را خلق کردی چگونه ما را خلق کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.52,
   "end": 168.86,
   "text": "چگونه به چه استدراجی ما را خلق کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.86,
   "end": 172.38,
   "text": "از چه ما را خلق کردی که به خودت آفرین گفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.38,
   "end": 176.92,
   "text": "و لقد خلقنا الانسان من سلاله من طین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.92,
   "end": 181.7,
   "text": "خب نباید برویم ببینیم مثلاً طین چی هست که سلاله‌ش چی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.7,
   "end": 183.96,
   "text": "که خدا ما را از آن خلق کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.96,
   "end": 186.92,
   "text": "ثم جعلناه این ثم استدراج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.92,
   "end": 190.8,
   "text": "ثم. سپس. گمان کنید مثلاً قسمت بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.8,
   "end": 196.62,
   "text": "سریال است. ثم جعلناه نطفه في قرار مكین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.62,
   "end": 201.7,
   "text": "سپس او را قرار دادیم نطفه‌ای در قرار مكین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.7,
   "end": 206.14,
   "text": "در آن قرارگاهی که پنهان است، کن دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.14,
   "end": 209.68,
   "text": "در آنجا قرارش دادیم، از نگاه‌ها پوشیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.68,
   "end": 213.9,
   "text": "ثم دوباره ثم خلقنا النطفه علقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.9,
   "end": 217.06,
   "text": "ف دوباره این ف، فای پس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.06,
   "end": 220.26,
   "text": "معنای همان ثم را می‌دهد به یک عبارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.26,
   "end": 223.8,
   "text": "ثم خلقنا النطفه علقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.8,
   "end": 226.1,
   "text": "ف خلقنا العلقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.1,
   "end": 229.42,
   "text": "مضغه. اصلاً نطفه چیست که علقه چی باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.42,
   "end": 231.96,
   "text": "علقه چیست که مضغه چی باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.96,
   "end": 235.82,
   "text": "ف دوباره فخلقنا المضغه عظاما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.82,
   "end": 240.82,
   "text": "آخه چگونه است که عظام، استخوان از این مضغه به وجود می‌آید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.82,
   "end": 243.66,
   "text": "فكسبنا باز دوباره ف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.66,
   "end": 246.84,
   "text": "پس یعنی ثم، سپس، استدراج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.84,
   "end": 249.4,
   "text": "فكسبنا العظام لحما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.4,
   "end": 254.54,
   "text": "روی این استخوان‌ها گوشت چگونه پوشیده می‌شود و این گوشت‌ها اصلاً از کجا می‌آیند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.54,
   "end": 259.3,
   "text": "ثم انشأنا، ثم انشأناه خلقا آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.3,
   "end": 261.86,
   "text": "دیگه آن رتبه انتهایی آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.86,
   "end": 266.34,
   "text": "خلقت ما در خصوص انسان به جایی کشیده می‌شود، انشائات ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.34,
   "end": 270.52,
   "text": "انشائ ما که فتبارك الله احسن الخالقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.52,
   "end": 275.26,
   "text": "احسن الخالقین به خودش تبارک بگوید، باریکلا بگوید به قول ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.26,
   "end": 278.18,
   "text": "به خودش تبریک بگوید. ثم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.18,
   "end": 280.08,
   "text": "دو مرتبه دارد تموم شد استدراج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.08,
   "end": 283.24,
   "text": "نخیر ادامه دارد. ما ابد در پیش داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.24,
   "end": 287.58,
   "text": "ثم انكم بعد ذلك لمیتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.58,
   "end": 291.72,
   "text": "حالا اینجا چی شد که حالا بعد ذلك، بعد از آن می‌خواهد چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.72,
   "end": 296.74,
   "text": "لمیتون قطعاً میت خواهید شد، به موت خواهید رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.74,
   "end": 298.66,
   "text": "خب موت چیه؟ حقیقت موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.66,
   "end": 302.84,
   "text": "آها این‌ها چیزهایی است که ما باید قراره این‌ها را سیر کنیم، طی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.84,
   "end": 304.96,
   "text": "از آنچه که سیر کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.96,
   "end": 308.14,
   "text": "طی کردیم، رد شدیم که بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.14,
   "end": 313.0,
   "text": "از این وضعیت که الان فی الحال فی المجلس درش قرار گرفتیم، بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.0,
   "end": 315.48,
   "text": "از سیری که قراره برویم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.48,
   "end": 321.28,
   "text": "بعد ذلك، بعد از اونی که گذشت قراره برویم لمیتون، بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.28,
   "end": 323.92,
   "text": "باز هم ادامه دارد. بله ثم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.92,
   "end": 327.52,
   "text": "ثم انكم يوم القيامه تبعثون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 327.52,
   "end": 332.9,
   "text": "دو مرتبه آن روزی که قیامت به پا بشه تبعثون شما را برمی‌انگیزانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.9,
   "end": 338.04,
   "text": "آخه این قیامت چی هست که یومش که ظهور اون چی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.04,
   "end": 341.52,
   "text": "که بعثت ما در آنجا چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.52,
   "end": 348.6,
   "text": "و لقد خلقنا فوقكم سبع طرائق و ما كنا عن الخلق غافلين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.6,
   "end": 353.26,
   "text": "حالا ما بالا سر شما هفت تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.26,
   "end": 359.26,
   "text": "لایه بلایه همینطور طبقات آسمان را قرار دادیم و ما از خلق غافل نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.26,
   "end": 366.38,
   "text": "خب این که خدا از خلق غافل نیست چرا رفته به این هفت تا طبقه لایه بلایه داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 366.38,
   "end": 369.28,
   "text": "چرا فوق ماست؟ خب مگه ما تحت نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.28,
   "end": 371.46,
   "text": "تحت ما آیا آسمان نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.46,
   "end": 377.41,
   "text": "الان اینجا که ما ایستادیم زیر پای ما زمینه برو تا اون سر زمین دو مرتبه زیرش آسمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.41,
   "end": 380.79,
   "text": "در ح-- علم حیات اینا رو چگونه پاسخگو باشیم، جوابگو باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.79,
   "end": 384.17,
   "text": "ببین یک آیه دو سه تا آیه ببین چقدر چرا، چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.17,
   "end": 386.41,
   "text": "و چقدر سؤال. خب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.41,
   "end": 393.07,
   "text": "مگر بیکاریم بریم سراغ چیزهایی که نه به درد دنیای ما میخورن نه آخرت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.07,
   "end": 398.29,
   "text": "نه مگر بیکاریم که بریم سراغ چیزهایی که صرفاً در دنیا دنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.29,
   "end": 403.19,
   "text": "پست فقط اینجا به کار میان و اونجا هیچ فایده‌ای ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.19,
   "end": 406.19,
   "text": "اینجا اعتباریات دنیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.19,
   "end": 407.85,
   "text": "این‌ها اینجا اعتبار شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 407.85,
   "end": 410.05,
   "text": "اونجا وقتی ما رو گذاشتن تو خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 410.05,
   "end": 413.27,
   "text": "از ما در خصوص مدرک تحصیلیمون میپرسن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.27,
   "end": 416.31,
   "text": "در خصوص اه عناوین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.31,
   "end": 418.43,
   "text": "شغل و چه میدونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.43,
   "end": 421.65,
   "text": "انساب و این‌هامون میپرسن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.65,
   "end": 425.39,
   "text": "در خصوص مثلاً اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.39,
   "end": 431.65,
   "text": "عرض شود خدمت شما که چه مقدار در این دنیا مثلاً تو بورس فعالیت داشتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.65,
   "end": 434.17,
   "text": "به روز بودیم تو سکه و دلار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.17,
   "end": 438.27,
   "text": "نمی‌دونم به روز بودیم تو علوم روز و متعارف و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.27,
   "end": 443.59,
   "text": "نمی‌دونم از مد جا نموندیم، از مردم جا-- این حرفا آخه به کجای کار ما میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.59,
   "end": 447.43,
   "text": "تو همین دنیاش. جز اینکه ما سرگرم خودش کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 447.43,
   "end": 451.07,
   "text": "و لهو و لعب باشه مثل آب دهان و جاری بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 451.07,
   "end": 454.33,
   "text": "و ما رو به پستی بگراید. اینا به چه درد ما میخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 454.33,
   "end": 456.81,
   "text": "در حالی که ما ابد در پیش داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 456.81,
   "end": 459.23,
   "text": "و قلبی که منغمره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.23,
   "end": 465.87,
   "text": "از همه این‌ها بی‌خبره چگونه میخواد سیر کنه به جایی برسه که همه خبرها از اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 465.87,
   "end": 470.33,
   "text": "اینجا سایه‌ست دیگه باید از سایه خبر بگیری از اون اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.33,
   "end": 477.63,
   "text": "که از اون اصل اون شاخسی که نور حضرت حق تجلی کرده زده به اون شاخه سایه ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.63,
   "end": 484.31,
   "text": "به هر حال اون نشئه ملکوت حالا به عبارتی بگیم جبروت، جبروت سایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.31,
   "end": 486.85,
   "text": "لاهوته. باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 486.85,
   "end": 491.79,
   "text": "یعنی خود لاهوت سایه فوق لاهوت و فوق عرشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.79,
   "end": 494.09,
   "text": "و ملکوت سایه جبروته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 494.09,
   "end": 496.31,
   "text": "دنیا سایه ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.31,
   "end": 501.47,
   "text": "ما تو این انزل و پست‌ترین مراتب حالا پست فلسفی عرض می‌کنم نه اخلاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.47,
   "end": 503.39,
   "text": "پست‌ترین مراتب گیر کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.39,
   "end": 505.75,
   "text": "توجه صرفاً به همین جاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.75,
   "end": 512.91,
   "text": "در حالی که قرآن دائماً میگه \"وفی السماء رزقكم وما توعدون\" اونچه که دنبالشی تو آسمونه سرتو بیار بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.91,
   "end": 515.11,
   "text": "هرچه هست زیر سر لوح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 515.11,
   "end": 519.01,
   "text": "زیر سر قلمه. اونچه که در سینه لوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.01,
   "end": 524.21,
   "text": "که مقام مادونه، کتاب وجودی خودت یا همین اشیا طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 524.21,
   "end": 528.63,
   "text": "زیر سر هرچی که اینجا داره صد صد نوشته میشه زیر سر قلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 528.63,
   "end": 532.21,
   "text": "خب ببین قلم چیه؟ ببین ما فوق قلم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 532.21,
   "end": 536.27,
   "text": "اون رقع منشور چیه؟ ما فوق رقع منشور مقام اهدیه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 536.27,
   "end": 539.27,
   "text": "ما فوق اون امهات اسماء چین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.27,
   "end": 541.09,
   "text": "مفاتح غیب چین؟ ذات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 541.09,
   "end": 546.87,
   "text": "این‌ها خب کی میخوای خبر داشته باشی در حالی که این سیر رو داری میری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 546.87,
   "end": 552.47,
   "text": "میخوای تو قبر که گذاشتنت شونه‌هاتو تکون بدن باخبرت کنن که \"اسمع افهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 552.47,
   "end": 557.99,
   "text": "بشنو و بفهم یا عبد الله نه عبد الله که اگر ما عبد الله باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 557.99,
   "end": 562.97,
   "text": "که بعضی روایات میفرمایند وقتی در قبر بسته شد نه منظور این قبر خاکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 562.97,
   "end": 565.79,
   "text": "نه اون قبر فقهی رو نمیگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 565.79,
   "end": 569.03,
   "text": "قبر عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 569.03,
   "end": 571.59,
   "text": "برزخی، اون قبر اصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 571.59,
   "end": 575.01,
   "text": "که بدن ما میشود قبر اون نفس ناطقمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 575.01,
   "end": 578.21,
   "text": "اونجا میشه عبد الله ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 578.21,
   "end": 581.77,
   "text": "عبد الله بن عبد الله. اما اگر عبد الله نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 581.77,
   "end": 583.39,
   "text": "میگن روشو از خدا برگردونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.39,
   "end": 586.25,
   "text": "حالا این روشو از خدا برگردونید یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 586.25,
   "end": 589.85,
   "text": "و این مگر این نیست که \"فأینما تولوا فثم وجه الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 589.85,
   "end": 592.49,
   "text": "به هر طرف رو کنید رو به وجه خدا کرده‌اید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 592.49,
   "end": 595.65,
   "text": "چگونه از خدا روشو برمی‌گردونن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 595.65,
   "end": 598.13,
   "text": "خب اینا سؤالاتی که باید جواب داده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 598.13,
   "end": 601.77,
   "text": "چگونه‌ست که آقامون سید الشهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 601.77,
   "end": 608.41,
   "text": "قربان دهان پاک معصوم برویم هممون در اونجا در اون زیارت در دعای شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 608.41,
   "end": 611.93,
   "text": "و بی‌نظیر عرفه در اون انتهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 611.93,
   "end": 614.51,
   "text": "که میفرماید \"متى بعدت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 614.51,
   "end": 617.55,
   "text": "تو اصلاً کی دور بودی؟ محا-- \"متى غبت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 617.55,
   "end": 622.33,
   "text": "تو کی غائب بودی؟ خب این‌ها نباید مورد بررسی قرار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 622.33,
   "end": 625.67,
   "text": "مگر خدا علام الغیوب نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 625.67,
   "end": 629.83,
   "text": "خبر از غیب ندارد. چگونه میگیم ما \"متى غبت\" تو کی غائب بودی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 629.83,
   "end": 632.95,
   "text": "کسی که غائب نبوده چگونه خبر از غیب نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 632.95,
   "end": 638.09,
   "text": "چگونه خبر از غیب داره که علام بر وزن فعال به شدت باخبر از غیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 638.09,
   "end": 640.43,
   "text": "اصلاً غیب چی هست که علام چی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 640.43,
   "end": 644.35,
   "text": "\"متى غبت حتى تحتاج الى دليل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 644.35,
   "end": 648.51,
   "text": "يدل عليك\" تو کی غائب بودی که بخوام برا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 648.51,
   "end": 652.97,
   "text": "تو دلیلی بیارم، دلالتی بتراشم بر تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 652.97,
   "end": 656.03,
   "text": "که دلالت بر تو بکنه و \"متى بعدت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 656.03,
   "end": 664.37,
   "text": "تو کی دور بودی؟ اگه خدا دور نیست که اب-- سید الشهدا اینجا میفرماید پس ما چگونه میگیم قربتاً الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 664.37,
   "end": 666.89,
   "text": "نماز میخوانم برای نزدیکی به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.89,
   "end": 673.05,
   "text": "ب-- سید الشهدا داره تفهیم میکنه به ما می فهمونه که بدانید \"متى بعدت\" خدا کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 673.05,
   "end": 681.07,
   "text": "تو دور بودی \"حتى يكون الآثار هي التي توصل اليك\" که بخوام از ناحیه آثار به تو وصل بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 681.07,
   "end": 685.39,
   "text": "الله اکبر. \"عميت عين الله تراك عليها رقيبا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 685.39,
   "end": 688.65,
   "text": "کور باد اون چشمی که نبینه تو رقیب شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 688.65,
   "end": 693.31,
   "text": "خب این چشمی که کور شد دیگه چگونه میخواد ببینه این چشم، چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 693.31,
   "end": 695.61,
   "text": "الله اکبر از این چشم، چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 695.61,
   "end": 697.49,
   "text": "چشم و ما غافلیم از این چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 697.49,
   "end": 699.59,
   "text": "چشم ظاهر، چشم باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 699.59,
   "end": 702.61,
   "text": "اصلاً خدا اینا رو برای چی به ما داده این چشم‌ها رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 702.61,
   "end": 704.89,
   "text": "برای چی به ما داده چشم‌ها رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 704.89,
   "end": 707.41,
   "text": "حالا اجازه بدید ان‌شاءالله جلسات بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 707.41,
   "end": 709.97,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 709.97,
   "end": 712.27,
   "text": "صلى الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 712.27,
   "end": 716.93,
   "text": "على محمد صلى الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 716.93,
   "end": 721.67,
   "text": "على النبي صلى الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 721.67,
   "end": 726.61,
   "text": "على محمد و على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 726.61,
   "end": 730.19,
   "text": "آل النبي. صلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 730.19,
   "end": 735.67,
   "text": "الله على محمد صلى الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 735.67,
   "end": 740.29,
   "text": "على النبي صلى الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 740.29,
   "end": 746.17,
   "text": "على محمد و على آل النبي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}