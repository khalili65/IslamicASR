 "chapters": [
  {
   "index": 0,
   "title": "## نصب امام جماعت و جمعه و مسئلهٔ عدالت",
   "start": 12.98,
   "end": 152.2
  },
  {
   "index": 1,
   "title": "ادامهٔ بحث قلب منغمر: بی‌خبری از قرآن خطر بزرگ است. در آیات هفت و هشت سورهٔ یونس خدا می‌فرماید:",
   "start": 152.2,
   "end": 225.92
  },
  {
   "index": 2,
   "title": "## دنیا آرامش کاذب غافلان",
   "start": 225.92,
   "end": 331.68
  },
  {
   "index": 3,
   "title": "## گسترهٔ آیات؛ اهل‌بیت آیهٔ کبرا",
   "start": 331.68,
   "end": 417.83
  },
  {
   "index": 4,
   "title": "## برون‌رفت؛ اعجاز علمی و عبس",
   "start": 417.83,
   "end": 827.32
  },
  {
   "index": 5,
   "title": "## تمثیل درخت و دستور آویخته",
   "start": 827.32,
   "end": 957.7
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.88,
   "end": 5.2,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.2,
   "end": 8.08,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.08,
   "end": 12.98,
   "text": "و ربانی ایه آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.98,
   "end": 15.38,
   "text": "استفتای دیگری پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.38,
   "end": 20.48,
   "text": "ائمه جماعت و جمعه و این‌ها از رهبر عزیز شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.48,
   "end": 31.64,
   "text": "پرسیدند آیا تعیین امام جماعت برای مساجد از طرف علمای مورد اطمینان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.64,
   "end": 34.74,
   "text": "یا تعیین ائمه جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.74,
   "end": 37.9,
   "text": "از طرف ولی امر مسلمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.9,
   "end": 45.84,
   "text": "نوعی شهادت بر عدالت آنان محسوب می‌شود یا اینکه باید درباره عدالت آنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.84,
   "end": 51.36,
   "text": "تحقیق شود؟ چون می‌دونید یکی از شروط اینکه شما می‌توانید به کسی اقتدا کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.36,
   "end": 53.7,
   "text": "احراز عدالت ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.7,
   "end": 63.52,
   "text": "حالا سؤال اینه که آیا صرفاً اینکه علمایی امامی رو منصوب کردن یا رهبر عزیزون مثلا یا ولی امر مسلمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.52,
   "end": 69.8,
   "text": "امام جمعه‌ای رو منصوب کردن این صرفاً همین کفایت می‌کنه بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 69.8,
   "end": 77.82,
   "text": "احراز عدالت؟ رهبر عزیز فرمودند که اگه نصب امام جمعه یا جماعت یعنی امام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 77.82,
   "end": 81.62,
   "text": "موجب اطمینان به عدالت وی بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 81.62,
   "end": 83.52,
   "text": "اقتداد به او جایزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 83.52,
   "end": 87.6,
   "text": "یعنی به شما بستگی داره که از اینکه فلان عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.6,
   "end": 90.8,
   "text": "یا مثلا رهبر اینا ولی امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 90.8,
   "end": 92.88,
   "text": "فلانی رو منصوب کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.88,
   "end": 96.48,
   "text": "پس عادله. یعنی اگر این چنینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.48,
   "end": 101.7,
   "text": "خب برای شما محرز شده و اقتدا به او جایز هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.7,
   "end": 104.22,
   "text": "یعنی به خود شما برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.22,
   "end": 108.24,
   "text": "اما ادامه بحث قلب منغمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.24,
   "end": 110.22,
   "text": "نکته دیگری رو عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.22,
   "end": 115.6,
   "text": "پیرامون عرض شود خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.6,
   "end": 120.46,
   "text": "بی‌خبری از قرآن که عرض شد اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.46,
   "end": 126.9,
   "text": "چیزی که ما این آیه بیشتر مد نظرش هست با توجه به اون روایت که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.9,
   "end": 129.16,
   "text": "که قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.16,
   "end": 133.56,
   "text": "شخص بی‌خبر می‌شود، از چی بی‌خبر می‌شود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 133.56,
   "end": 136.12,
   "text": "از این قرآن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.12,
   "end": 137.78,
   "text": "خطر بزرگی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.78,
   "end": 145.98,
   "text": "اتفاقاً در بحث غفلت و این‌ها آیات زیادی ما داریم در قرآن که مثلا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.98,
   "end": 151.08,
   "text": "آیات هفت تا هشت سوره یونس اگر دقت بفرمایید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.08,
   "end": 156.26,
   "text": "اونجا خدا می‌فرماید إن الذين لا يرجون لقاءنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.26,
   "end": 158.96,
   "text": "قطعاً اون کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.96,
   "end": 162.32,
   "text": "ایمان ندارند به ملاقات ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.32,
   "end": 164.66,
   "text": "لا يرجون لقاءنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.66,
   "end": 170.54,
   "text": "حالا چه جالب که بحث شب‌های جمعه ما هم که خب لقاء الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.54,
   "end": 172.58,
   "text": "خب این اصلاً یه آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.58,
   "end": 175.42,
   "text": "خیلی به درد بخوره پیرامون همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.42,
   "end": 180.86,
   "text": "مباحث که یه روزی انشاالله در دل این آیه با همدیگه سفره پهن کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.86,
   "end": 182.82,
   "text": "غذا بخوریم انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.82,
   "end": 185.6,
   "text": "ورضوا بالحياة الدنيا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.6,
   "end": 189.48,
   "text": "اولین خصوصیت اینه که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.48,
   "end": 193.02,
   "text": "به ملاقات خدا ایمان ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.02,
   "end": 196.9,
   "text": "ورضوا بالحياة الدنيا این‌ها به زندگی دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.9,
   "end": 199.46,
   "text": "رضوا راضی شدند، خشنود شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.46,
   "end": 206.1,
   "text": "وطمعن بها تکیه کردند، اطمینان پیدا کردند، آرامش پیدا کردند به همان دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.1,
   "end": 212.44,
   "text": "والذين هم عن آياتنا غافلون حالا کسایی که این شکلی هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.44,
   "end": 216.24,
   "text": "مشخصاتشون مختصات اون‌ها این شکلی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.24,
   "end": 221.58,
   "text": "هرم وجودیشون بر اساس این مختصات شکل گرفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.58,
   "end": 223.6,
   "text": "والذين هم این‌ها کی‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.6,
   "end": 228.54,
   "text": "عن آياتنا غافلون این‌ها غافلن از آیات ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.54,
   "end": 231.52,
   "text": "که البته أولئك مأواهم النار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.52,
   "end": 233.74,
   "text": "قطعاً این‌ها جایگاهشون آتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.74,
   "end": 237.62,
   "text": "النار که مقابل النور قرار داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.62,
   "end": 241.92,
   "text": "بما كانوا يكسبون به خاطر اون کارهایی که کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.92,
   "end": 248.52,
   "text": "خدا به کسی ظلم نمی‌کنه. کارهایی که این‌ها کردن اون‌ها رو یعنی غفلت، غفلتی که داشتن، این بی‌خبری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.52,
   "end": 252.54,
   "text": "این بی‌خبری و غفلت این بلا رو سرشون آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.54,
   "end": 256.14,
   "text": "الذين هم عن آياتنا غافلون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.14,
   "end": 260.56,
   "text": "حالا غفلت از آیات ما که یعنی میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.56,
   "end": 263.1,
   "text": "این چنین نتیجه گرفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.1,
   "end": 267.46,
   "text": "این‌ها از همون می‌شود گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.46,
   "end": 274.04,
   "text": "بی‌اعتمادی یا بی‌ایمانی به ملاقات به خدا و توجه به دنیا و دلخوش کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 274.04,
   "end": 279.4,
   "text": "و تکیه کردن به دنیا و جذابیت دنیا به اینجا کشیده شدن که غافل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.4,
   "end": 283.46,
   "text": "شدند. یعنی آیات رو غفلت کردن ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 283.46,
   "end": 288.26,
   "text": "که به قول آقای قرائتی خدا حفظشون کنه در تفسیر نورشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 288.26,
   "end": 295.48,
   "text": "می‌فرمایند که هرچه بیشتر از قیامت بر اساس این آیه البته که می‌فرماید لا يرجون لقاءنا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.48,
   "end": 301.22,
   "text": "لا يرجون لقاءنا و بلافاصله می‌فرماید ورضوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.22,
   "end": 303.14,
   "text": "ورضوا بالحياة الدنيا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 303.14,
   "end": 308.56,
   "text": "اونجا لذا از همین نکته آقای قرائتی استفاده می‌کنند می‌فرماید که هرچه بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.56,
   "end": 311.06,
   "text": "از قیامت غافل بشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.06,
   "end": 314.54,
   "text": "و مأیوس بشی، دنیاگراتری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.54,
   "end": 319.82,
   "text": "یا به عبارتی دنیا آرامش بخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.82,
   "end": 321.64,
   "text": "کاذبیه برای غافلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.64,
   "end": 324.22,
   "text": "چون وطمعن بها دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 324.22,
   "end": 326.1,
   "text": "آرامش پیدا می‌کنند به اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.1,
   "end": 329.44,
   "text": "اما این‌ها کی‌اند؟ غافلان هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.44,
   "end": 337.62,
   "text": "هم عن آياتنا غافلون که حالا این غفلت رو شما از ابتدایی‌ترین نعمت‌های الهی بگیر برو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.62,
   "end": 341.56,
   "text": "آیات الهی بگیر برو تا با بزرگ‌ترین آیات که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.56,
   "end": 351.46,
   "text": "در تفسیر روایی اهل بیت از علی ابن ابراهیم اونجا روایت هستش که مراد از این آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.46,
   "end": 360.48,
   "text": "یعنی اون بزرگ‌ترین آیات الهی اهل بیت علیهم الصلاة والسلام هستند که در حقیقت غفلت از اون آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 360.48,
   "end": 363.35,
   "text": "این بلا رو سر ما میاره که اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 363.35,
   "end": 367.57,
   "text": "می‌شود گفت که قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 367.57,
   "end": 370.65,
   "text": "صا-- ناطق‌اند. قرآن ناطق که باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 370.65,
   "end": 378.21,
   "text": "همین وجهه یعنی همین غفلت از همین قرآن که این قرآن کتبی، اون قرآن انفسی، جان انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 378.21,
   "end": 380.43,
   "text": "و البته این قرآن آفاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 380.43,
   "end": 386.55,
   "text": "که حالا بر اساس همون فرمایش مولامون علی علیه الصلاة والسلام که فرمودن چه شیرین، چه جالب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 386.55,
   "end": 389.95,
   "text": "فرمودن \"مال الله آیتون اکبر منّی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 389.95,
   "end": 392.31,
   "text": "به به، به به. اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.31,
   "end": 396.17,
   "text": "بزرگتر از من خدا آیه‌ای ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 396.17,
   "end": 402.27,
   "text": "خب ببینید خ-- پس اینجا که می‌فرماید \"والذین هم عن آياتنا غافلون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 402.27,
   "end": 408.39,
   "text": "می‌خوره به آیه وجودی کبرای اهل بیت علیهم الصلاة والسلام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 408.39,
   "end": 415.61,
   "text": "حضرت امیرالمؤمنین و بالطبع همین الان امام عصر ما کسی غافل باشه از امام عصرش این بلاها سرش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 415.61,
   "end": 422.13,
   "text": "خیلی خطرناکه. که حالا ما برای برون رفت از این غفلت‌هایی از آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 422.13,
   "end": 426.45,
   "text": "عرض کردیم که یکی از بهترین راه‌هاش توجه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 426.45,
   "end": 430.15,
   "text": "از همین مثلاً اعجاز علمی قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 430.15,
   "end": 437.59,
   "text": "به هر حال بحث منطقی‌ست، بحث، بحث عقلی‌ست، بحث حتی طبیعی و تجربی‌ست که در قرآن فراوان هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 437.59,
   "end": 439.45,
   "text": "نکاتی رو داشتیم عرض می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 439.45,
   "end": 441.65,
   "text": "این جلسه به فضل الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 441.65,
   "end": 443.89,
   "text": "تو همین زیغ وقت اشاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 443.89,
   "end": 447.63,
   "text": "می‌کنیم به آیات بیست و چهار تا بیست و هشت سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 447.63,
   "end": 451.59,
   "text": "شریف عبس. اونجا اگر دقت فرموده باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 451.59,
   "end": 455.09,
   "text": "در اونجا خدا می‌فرماید \"فلينظر الإنسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 455.09,
   "end": 460.59,
   "text": "إلى طعامه\". پس باید که انسان به غذاش نظر کنه، به طعامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 460.59,
   "end": 465.55,
   "text": "حالا اینجا باید توجه کرد که البته بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 465.55,
   "end": 470.03,
   "text": "روایات که حالا در تفسیر برهان و دیگر تفاسیر هست، اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 470.03,
   "end": 478.61,
   "text": "زید ابن شهام اونجا می‌فرماد که البته از امام صادق صلوات الله علیه که این طعامه منظور اینکه علمت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 478.61,
   "end": 486.73,
   "text": "انسان باید نگاه کنه به علمش که این علم رو از کجا اخذ می‌کنه، از سرچشمه باید اخذ کنه، از منبع و سرچشمه علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 486.73,
   "end": 491.61,
   "text": "که خزانه علم نزد آل الله هست، او-- از اونجا اخذ کنه، نه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 491.61,
   "end": 494.97,
   "text": "جاهای دیگه. حالا بحث ما فعلاً چیز دیگریست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 494.97,
   "end": 496.69,
   "text": "\"إنا صبب\" بقیه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 496.69,
   "end": 499.67,
   "text": "\"إنا صببنا الماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 499.67,
   "end": 505.59,
   "text": "صبا\" می‌فرماید ما آب رو با بارشی فرو ریختیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 505.59,
   "end": 507.85,
   "text": "\"ثم شققنا الأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 507.85,
   "end": 512.13,
   "text": "شقا\". انشقاق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 512.13,
   "end": 516.31,
   "text": "منشق کردن. \"ثم شققنا الأرض شقا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 516.31,
   "end": 518.71,
   "text": "سپس زمین رو کاملاً شکافتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 518.71,
   "end": 521.87,
   "text": "در پس چی؟ پس بارش باران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 521.87,
   "end": 526.29,
   "text": "فرو ریختن با اون باران‌های سیل آسای اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 526.29,
   "end": 529.03,
   "text": "شقا، چه شکافتنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 529.03,
   "end": 531.97,
   "text": "فأنبت حالا در نتیجه شکافتن زمین چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 531.97,
   "end": 536.17,
   "text": "\"فأنبتنا فيها حبا وعنبا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 536.17,
   "end": 541.79,
   "text": "و این چنین شد که \"وعنبا وقضبا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 541.79,
   "end": 543.99,
   "text": "اشاره دارد به انگور و سبزی و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 543.99,
   "end": 549.33,
   "text": "این دانه‌ها، حبا، این دانه‌ها رو، انگور و سبزی و این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 549.33,
   "end": 553.25,
   "text": "ما در دل این شکاف‌های زمین رویاندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 553.25,
   "end": 556.03,
   "text": "ببینید یکی از معجزات زیبای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 556.03,
   "end": 561.25,
   "text": "قرآن از جهت علمی تو اون زمان خفقان و جها-جهالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 561.25,
   "end": 564.53,
   "text": "و بی‌خبری مردم اون زمان چه زیبا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 564.53,
   "end": 567.05,
   "text": "خب کسی اون موقع نمی‌دونست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 567.05,
   "end": 569.71,
   "text": "این خاک اصلاً از کجا ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 569.71,
   "end": 572.47,
   "text": "خاک و این شکاف‌هایی که در دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 572.47,
   "end": 576.93,
   "text": "زمین، سنگ‌ها ایجاد شده، چی اصلاً از ابتدا این رو ایجاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 576.93,
   "end": 579.41,
   "text": "الان علم تجربی اینو ثابت کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 579.41,
   "end": 585.29,
   "text": "که در آغاز سطح زمین رو یه قشر عظیمی از سنگ‌ها پوشونده بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 585.29,
   "end": 590.21,
   "text": "این باران‌های سیل آسایی که پی در پی فرو ریختند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 590.21,
   "end": 595.53,
   "text": "و سنگ‌ها رو شکافتند بر اساس همین آیه هم داره می‌فرماید و تصریح می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 595.53,
   "end": 603.01,
   "text": "و این شکافتنی که در سنگ‌های سخت ایجاد شد، ذره ذره اون‌ها رو جدا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 603.01,
   "end": 605.31,
   "text": "و پراکنده کرد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 605.31,
   "end": 610.65,
   "text": "ذرات سنگ‌ها رو که بدل شدند به خاک در قسمت‌های گود زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 610.65,
   "end": 613.51,
   "text": "حالا که اون موقع مثلاً دره بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 613.51,
   "end": 618.37,
   "text": "به همین وضعیت و به همین شکل و همین طور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 618.37,
   "end": 622.87,
   "text": "دیگه رفته رفته توده خاک قابل زراعت تشکیل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 622.87,
   "end": 626.75,
   "text": "که حالا همین فعلاً هم-- فعلاً هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 626.75,
   "end": 630.69,
   "text": "سیلاب‌ها می‌بینید پی در پی قسمتی از اون‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 630.69,
   "end": 633.47,
   "text": "در خودش حل می‌کنه. همینطور به مرور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 633.47,
   "end": 636.77,
   "text": "این سنگ‌ها و این‌ها سیلاب‌ها میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 636.77,
   "end": 641.87,
   "text": "می‌زنه، سنگ‌ها رو در خودش حل می‌کنه، بعضیشو به دریا می‌بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 641.87,
   "end": 645.69,
   "text": "و بعضیش رو توسط رودخانه‌ها اینا می‌بره در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 645.69,
   "end": 650.03,
   "text": "مراتع و این‌ها بالاخره پخش و پلا می‌کنه این ور اون ور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 650.03,
   "end": 654.41,
   "text": "البته وقت-- چندین میلیون سال طول کشیده تا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 654.41,
   "end": 656.33,
   "text": "آماده سازیش رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 656.33,
   "end": 659.77,
   "text": "اما خب فعلاً هم این هست، دیده می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 659.77,
   "end": 664.47,
   "text": "خاک‌های جدیدی که به وسیله برف و بارون مجدداً تشکیل می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 664.47,
   "end": 666.81,
   "text": "و جای اونو می‌گیرن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 666.81,
   "end": 668.97,
   "text": "وگرنه اگر غیر از این بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 668.97,
   "end": 674.43,
   "text": "و این معجزه الهی نبود، این امداد الهی در حقیقت نبود، خب انسان دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 674.43,
   "end": 677.99,
   "text": "کمبود خاک زراعتی می‌شد به قول تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 677.99,
   "end": 680.43,
   "text": "نمونه آقای مکارم. به این--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 680.43,
   "end": 687.47,
   "text": "به همین وضعیت شما دقت بفرمایید این آیه رو ببینید که اشاره داره به یکی از معجزات علمی قشنگ قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 687.47,
   "end": 695.33,
   "text": "که اول بارون‌ها فرو باریدن، بعد زمین شکافته شد، آماده زراعت شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 695.33,
   "end": 702.31,
   "text": "و نه تنها تو روزای نخست این امر صورت گرفته که همینطور می‌بینید امروز هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 702.31,
   "end": 706.47,
   "text": "ادامه دارد. البته خب این ظاهره، یه وجه ظاهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 706.47,
   "end": 709.47,
   "text": "قرآن هست عرض کر-کردیم ارتباط با علم تجربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 709.47,
   "end": 718.41,
   "text": "و الا خب تعویل و باطن این آیات چیز دیگریست که از همین ابتدا باید شروع کرد تا به انشاالله اون تعالی رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 718.41,
   "end": 727.98,
   "text": "البته این آب رو شما اگر بخواید تعویل رو در نظر بگیرید، تعویل‌های زیبا و بسیار عالی شده فعلاً مورد بحث ما نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 727.98,
   "end": 733.94,
   "text": "اما خیلی شیرین که حالا مثلا این آب رو آب علم بگیرید، آب حکمت بگیرید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 733.94,
   "end": 741.42,
   "text": "آب زلال ولایت و قرآن بگیرید، علم اهل بیت علیهم الصلاة والسلام اینها بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 741.42,
   "end": 743.46,
   "text": "که اینها می‌ریزند بر اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 743.46,
   "end": 746.76,
   "text": "سنگ‌ها و صخره‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 746.76,
   "end": 750.66,
   "text": "دل سنگ و وجود سخت و سنگ انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 750.66,
   "end": 754.06,
   "text": "و بالاخره این آیات و این آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 754.06,
   "end": 756.6,
   "text": "و ماء زلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 756.6,
   "end": 760.68,
   "text": "علم اهل بیت و معارف آل الله و علوم قرآنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 760.68,
   "end": 765.18,
   "text": "این دل‌های سنگ رو می‌شکافه و اونها رو خرد می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 765.18,
   "end": 767.48,
   "text": "شکننده می‌کنه، می‌شکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 767.48,
   "end": 773.02,
   "text": "و اون خاک زراعت و حاصلخیز رو درست می‌کنه در وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 773.02,
   "end": 780.22,
   "text": "که اون دانه‌ها و بذرها و تخم‌های سعادت یعنی اون معارف کاشته بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 780.22,
   "end": 787.16,
   "text": "اینها که کاشته شدن بعد می‌بینی به مرور در وجود انسان به تدریج، به تدریج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 787.16,
   "end": 791.88,
   "text": "اینها چی می‌شه؟ تبدیل می‌شه به اون نهال‌ها، به اون ثمرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 791.88,
   "end": 796.08,
   "text": "حالا اینجا قرآن در این آیه به انگور و سبزی و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 796.08,
   "end": 799.36,
   "text": "اشاره کرده‌ست که اینها هم البته هر کدوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 799.36,
   "end": 803.88,
   "text": "اسراری دارند که انشاالله به وقتش به قول علامه علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 803.88,
   "end": 809.44,
   "text": "خب تا همینجا فعلا در این جلسه بسنده کنیم اگرچه جای بیشتر از این بحث داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 809.44,
   "end": 811.14,
   "text": "فرصت ما هم ضیق هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 811.14,
   "end": 815.4,
   "text": "بیشتر سعی می‌کنیم تبرکا و اجمالا صحبت بکنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 815.4,
   "end": 819.3,
   "text": "حرص بیشتری، طمع بیشتری عزیزان داشته باشن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 819.3,
   "end": 821.14,
   "text": "پیگیری این معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 821.14,
   "end": 824.44,
   "text": "بعضیا حوصله مباحث طولانی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 824.44,
   "end": 827.32,
   "text": "خورد خورد انشاالله اینها پیاده بشه در وجود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 827.32,
   "end": 832.14,
   "text": "در شرح فسوس حضرت علامه استاد کل می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 832.14,
   "end": 840.52,
   "text": "اینکه انسان صرفا به بدن آیات و روایات توجه کنه و وارد باطن اونها نشه یا به عبارتی این شکلی می‌فرمودن که آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 840.52,
   "end": 843.86,
   "text": "در وجود انسان پیاده نشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 843.86,
   "end": 847.92,
   "text": "فایده‌ش نه که بی‌فایده باشه، خیلی کمه، خیلی به درد بخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 847.92,
   "end": 854.14,
   "text": "مثل اینکه بری دستورالعمل بار آمدن یک درخت رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 854.14,
   "end": 858.52,
   "text": "یک نبات رو که می‌تونه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 858.52,
   "end": 861.2,
   "text": "مثلا سرسبزش کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 861.2,
   "end": 868.52,
   "text": "بارورش کنه، به ثمر بنشونتش و به عبارتی به کمال وجودیش برسونش و به سعادت برسونتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 868.52,
   "end": 871.16,
   "text": "اینو آویزون کنی به گردن این درخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 871.16,
   "end": 874.96,
   "text": "کسایی که صرفا به علم فکری قرآنی می‌پردازن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 874.96,
   "end": 878.6,
   "text": "و فقط علم فکری حفظ می‌کنن، آیات رو حفظ می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 878.6,
   "end": 884.44,
   "text": "اینا فوقش حالا یه ترجمه‌ای می‌خوان، خیلی این قرآن در وجودشون پیاده نشده مثل اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 884.44,
   "end": 889.04,
   "text": "یعنی در حقیقت اگرچه خب خود علامه تصریح می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 889.04,
   "end": 892.52,
   "text": "بله در ظاهر قرآن هم سود هست، نور هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 892.52,
   "end": 897.04,
   "text": "و به قول ملاصدرا ظاهر قرآن هم همون لمعات و نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 897.04,
   "end": 899.62,
   "text": "جمال حضرت حق رو دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 899.62,
   "end": 903.36,
   "text": "اما تا چه دلی باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 903.36,
   "end": 909.24,
   "text": "و چه وجودی باشد که این دانه‌ها در، در او کاشته بشود و سرسبز بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 909.24,
   "end": 914.88,
   "text": "و الا بله برکت قرآن که همه جا همه عوالم هستی رو فرا گرفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 914.88,
   "end": 921.38,
   "text": "انشاالله که خدا به ما رحم کنه و از بی‌خبری نجاتمون بده به اسم ارحم الراحمین خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 921.38,
   "end": 923.94,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 923.94,
   "end": 926.48,
   "text": "اللهم صلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 926.48,
   "end": 930.82,
   "text": "علی محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 930.82,
   "end": 933.08,
   "text": "آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 933.08,
   "end": 946.14,
   "text": "اللهم صلی علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 946.14,
   "end": 947.82,
   "text": "محمد و آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 947.82,
   "end": 951.92,
   "text": "اللهم صلی علی محمد و آله. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 951.92,
   "end": 957.7,
   "text": "صلی علی محمد و آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}