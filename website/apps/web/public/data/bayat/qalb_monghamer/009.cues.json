 "chapters": [
  {
   "index": 0,
   "title": "## جهل و قلبِ منغمر در پستی",
   "start": 0.62,
   "end": 198.04
  },
  {
   "index": 1,
   "title": "## رفیق، مسیر و طولِ موج",
   "start": 198.04,
   "end": 297.78
  },
  {
   "index": 2,
   "title": "## قوسِ نزول و قوسِ صعود",
   "start": 297.78,
   "end": 530.32
  },
  {
   "index": 3,
   "title": "## اطوارِ خلق و زیارتِ خود",
   "start": 530.32,
   "end": 798.1
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.62,
   "end": 3.9,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.9,
   "end": 9.34,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.34,
   "end": 11.3,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.3,
   "end": 18.82,
   "text": "پرسیدن از رهبر عزیزمون که اگر چنانچه ما نماز جماعت اقامه می‌کردیم یعنی امام جماعت بودیم بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.82,
   "end": 25.2,
   "text": "بر اثر سانحه‌ای مثلا دستمون قطع شد این‌ها جراحی کردن دستمون رو قطع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.2,
   "end": 30.26,
   "text": "نمی‌دونستیم این حکم رو جاهل بودیم که امام جماعت نباید ناقص باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.26,
   "end": 37.14,
   "text": "از حیث جوارح و بالاخره به امام جماعت بودنمون ادامه دادیم بعدا متوجه شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.14,
   "end": 40.52,
   "text": "حالا حکم نمازهایی که اون وقت اقامه شده چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.52,
   "end": 46.16,
   "text": "رهبر عزیزمون می‌فرمایند که نماز مأمومینی که در گذشته بر اثر جهل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.16,
   "end": 51.14,
   "text": "جهل به حکم شرعی به شما اقامه کردن محکوم به صحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.14,
   "end": 54.36,
   "text": "و اعاده و قضا بر آنها واجب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.36,
   "end": 57.2,
   "text": "اما بحث قلب منغمس رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.2,
   "end": 60.38,
   "text": "در زشتی و پستی و پلیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.38,
   "end": 63.5,
   "text": "جهل و نادانی و بی‌خبری و بیخ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.5,
   "end": 66.76,
   "text": "بی‌خردی و اینکه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.76,
   "end": 70.6,
   "text": "دور باشه از علم و معرفت پیش می‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.6,
   "end": 78.08,
   "text": "که چه شیرین که امام صادق صلوات الله علیه در همین خصوص فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.08,
   "end": 81.36,
   "text": "اذا اراد الله بعبد خيرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.36,
   "end": 84.94,
   "text": "وقتی خدای منان اراده خیر کنه در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.94,
   "end": 88.52,
   "text": "کسی برای بنده‌ش اراده خیر کنه چه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.52,
   "end": 91.14,
   "text": "فقهه في الدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.14,
   "end": 95.66,
   "text": "او را در دینش دارای فهم عمیق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.66,
   "end": 104.08,
   "text": "فهم عمیق یعنی باخبر شدن از درون مایه دین که جلسه پیش پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.08,
   "end": 108.12,
   "text": "اون مقدمه کتاب کشف المراد که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.12,
   "end": 114.8,
   "text": "علامه شهرانی فرموده بودند سخن گفتیم که ایشان چقدر اصرار داشتند به رسیدن به باطن دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.8,
   "end": 119.02,
   "text": "نه اکتفا کردن به ظاهر و پوسته دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.02,
   "end": 122.3,
   "text": "که حالا این حدیثی که خوندیم اگر خواستید ببینید در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.3,
   "end": 128.36,
   "text": "شریف کافی مرحوم کلینی اعلا مقامه الشریف جلد یک صفحه چهل و هشت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.36,
   "end": 133.66,
   "text": "دوباره تو همین مدرکی که عرض کردیم از امام باقر صلوات الله علیه هم هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 133.66,
   "end": 136.32,
   "text": "الكمال کل الكمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.32,
   "end": 140.06,
   "text": "حضرت دارن کل کمال رو بر می‌شمارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.06,
   "end": 142.28,
   "text": "التفقه في الدين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.28,
   "end": 145.04,
   "text": "یکی عمیق شدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.04,
   "end": 147.38,
   "text": "خبر دقیق و عمیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.38,
   "end": 153.32,
   "text": "و اه خبر گرفتن از باطن عمیق دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.32,
   "end": 158.18,
   "text": "به این معنا. و صبر علی النائبه بر اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.18,
   "end": 162.5,
   "text": "ناگواری‌هایی که بر انسان عارض میشه صبر کردن و تقدیر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.5,
   "end": 166.4,
   "text": "معیشه اندازه گیری معیشت نه افراط نه تفریط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.4,
   "end": 169.08,
   "text": "این‌ها کل کمال‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.08,
   "end": 174.92,
   "text": "یعنی کسی بخواد به سمت کمال حرکت کنه چاره‌ای از این‌ها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.92,
   "end": 179.32,
   "text": "و چقدر شیرین که انسان سعی کنه با کمالین بنشینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.32,
   "end": 182.86,
   "text": "بلند شه. اون‌ها مکمل‌های ما هستند در کمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.86,
   "end": 192.08,
   "text": "در سیر استکمالی نفس ناطقه همون ما چاره‌ای جز نشست و برخاست با انسان‌های عاقل، انسان‌های عالم و عارف نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.08,
   "end": 196.78,
   "text": "کسانی که با جهال می‌شینن، با جاهل می‌شینن این‌ها مثل همون می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.78,
   "end": 199.26,
   "text": "اخیراً در علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.26,
   "end": 202.82,
   "text": "تجربی آزمایشی انجام داده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.82,
   "end": 206.2,
   "text": "خیلی جالب بود که حالا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.2,
   "end": 212.72,
   "text": "دستگاه‌هایی رو در کنار هم قرار داده بودند با طول موج‌های مختلفی این‌ها حرکت می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.72,
   "end": 220.34,
   "text": "مثل عقربه ساعت که حرکت می‌کنه نوسان داره رفت و برگشت داشت البته این عقربه‌ها می‌رفت و برمی‌گشت با طول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.34,
   "end": 223.56,
   "text": "موج‌های مختلف این‌ها رو کنار هم گذاشتند بر اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.56,
   "end": 228.1,
   "text": "قرابت همدیگه و نزدیکی به هم بودن این‌ها به مرور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.1,
   "end": 232.28,
   "text": "طول موج‌شون به شکل هم شد در هم تأثیر و تأثر داشتند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.28,
   "end": 234.16,
   "text": "مثل هم شد طول موج‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.16,
   "end": 236.7,
   "text": "لذا فرمودند الطریق ثم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.7,
   "end": 238.92,
   "text": "الرفيق ثم الطريق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.92,
   "end": 240.62,
   "text": "الرفيق ثم الطريق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.62,
   "end": 244.26,
   "text": "اول رفیقت و هم نشینت رو پیدا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.26,
   "end": 247.98,
   "text": "هم مسلک تو پیدا کن بعد راه رو پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.98,
   "end": 253.32,
   "text": "اینی که حضرت عیسی علی نبينا و آله و علیه الصلاة والسلام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 253.32,
   "end": 256.7,
   "text": "به ایشون عرض کردن که یا رسول الله ما با کی بشینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.7,
   "end": 258.94,
   "text": "با کی مجالست و مهانست کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.94,
   "end": 265.68,
   "text": "مصاحبت کنیم؟ فرمودند که با کسی که دیدارش شما را به یاد خدا بندازه و سخنش دانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.68,
   "end": 268.46,
   "text": "شما رو زیاد کنه و البته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.46,
   "end": 271.54,
   "text": "کردارش هم شما را به آخرت تشویق کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.54,
   "end": 275.46,
   "text": "یعنی شما رو ببر به یک معنا شما رو ببره به باطن عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 275.46,
   "end": 277.44,
   "text": "سخنش دانش شما رو زیاد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.44,
   "end": 283.64,
   "text": "وقتی حرف می‌زنه شما باخبر بشی نه اینکه بدتر در بی‌خبری فرو بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 283.64,
   "end": 288.74,
   "text": "این باخبر شدن از عالم یکی از مهمات بلکه اصل مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.74,
   "end": 291.4,
   "text": "و اهم بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 291.4,
   "end": 295.7,
   "text": "مهمات زندگی ماست که متاسفانه از اون بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.7,
   "end": 303.06,
   "text": "حالا ما از اینکه در قوس نزول ان الله اومدیم همه تشریف آوردید به این نشئه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.06,
   "end": 310.14,
   "text": "خب دست خودمون نبود. شکلمون، ظاهر و باطنمون، همه شکل و وضعیت و شاکلمون دست خدا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.14,
   "end": 312.16,
   "text": "ظاهرمون دست نشئه طبیعت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.16,
   "end": 314.5,
   "text": "نان و آبی که پدر مادر خوردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 314.5,
   "end": 318.86,
   "text": "در اصلاب و ارحام بدل به نطفه شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.86,
   "end": 326.92,
   "text": "حالا عرض شود این سیر استدراجی نطفه اومد تا گوشت و پوست و خون و این‌ها به این شکل دراومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.92,
   "end": 331.04,
   "text": "دست ما نبود. خبر نداشتیم از این سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.04,
   "end": 336.76,
   "text": "و حتی باطنمون و نفخت فیه من روحه اون نفس ناطقمون هم همچنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 336.76,
   "end": 339.28,
   "text": "اون هم دست ما نبود شکل‌یش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 339.28,
   "end": 345.02,
   "text": "شاکله‌ش. اما از اینجا به بعد در قوس صعود وظیفه داریم که بسازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 345.02,
   "end": 351.62,
   "text": "ما باطن خودمون رو و ظاهر خودمون رو به یک معنا بدنمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.62,
   "end": 355.46,
   "text": "و نفسمون رو داریم از الان می‌سازیم الی الابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 355.46,
   "end": 358.32,
   "text": "لذا مرحوم علامه علیه الرحمه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.32,
   "end": 363.92,
   "text": "هزار و یک نکته‌شون از قول مرحوم دهدار علیه الرحمه اونجا نقل می‌کنند که علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.92,
   "end": 366.8,
   "text": "علم انسان مشخص روح است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.8,
   "end": 369.66,
   "text": "یعنی اون روح انسان به چه شکله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 369.66,
   "end": 373.48,
   "text": "شاکله‌ش چگونه است بعد از مرگ نفس انسان به چه شکله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 373.48,
   "end": 379.2,
   "text": "می‌فرماید به شکل علمته باورها و اعتقادات و معارفی که کسب می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 379.2,
   "end": 386.08,
   "text": "اگر بی‌خبری به زشت‌ترین و کریه‌ترین وجه ممکن باطنت رو داری می‌سازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 386.08,
   "end": 388.6,
   "text": "حالا اگر ما بی‌خبر باشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 388.6,
   "end": 391.18,
   "text": "خبر نداشته باشیم از همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 391.18,
   "end": 398.82,
   "text": "علم، از همین موضوعی که الان عرض کردیم به سمع مبارک شما رسوندیم و بارها درباره‌ش سخن گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 398.82,
   "end": 402.4,
   "text": "بی‌خبر باشیم. خب خودمون داریم باطن خودمون رو می‌سازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 402.4,
   "end": 404.9,
   "text": "چه بلایی سر خودمون داریم میاریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 404.9,
   "end": 407.5,
   "text": "بعدها چه اتفاقی قراره بیفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 407.5,
   "end": 410.86,
   "text": "مواجه با خودمون می‌شیم، با خودمون محشور می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 410.86,
   "end": 413.82,
   "text": "می‌بینیم چه کردیم با خودمون، چه ساختیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 413.82,
   "end": 418.66,
   "text": "و همچنین فرمودند و عملش مشخص بدن او در نشئه اخروی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.66,
   "end": 421.92,
   "text": "یعنی آنچه که مشخص می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 421.92,
   "end": 424.7,
   "text": "شکل میده بدن ما رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 424.7,
   "end": 428.58,
   "text": "اون عمل ماست. که حالا اون عمل هم قطعاً بر اساس باورهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.58,
   "end": 431.28,
   "text": "هر کسی نسبت به باورها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 431.28,
   "end": 434.6,
   "text": "اون دانش و معرفتی که دارد عمل می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.6,
   "end": 436.86,
   "text": "گفت این دو توأمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.86,
   "end": 439.9,
   "text": "لذا علم و عمل جوهرند و انسان‌ساز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.9,
   "end": 441.52,
   "text": "دارند آینده ما رو می‌سازند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 441.52,
   "end": 446.38,
   "text": "در قوس صعود اگر ما بی‌خبر باشیم-- عرض شد در قوس نزول این بی‌خبری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.38,
   "end": 455.76,
   "text": "مشکلی ایجاد نکرده. به بهترین وجه ممکن تکوین نظام هستی و دست غیبی حضرت حق، ظاهر و باطن ما را آراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 455.76,
   "end": 460.12,
   "text": "فإذا سویت و به بهترین وجه ممکن نیکوترین حالت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 460.12,
   "end": 462.44,
   "text": "معتدل‌ترین وضعیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 462.44,
   "end": 465.66,
   "text": "این چی شد؟ ما سرشته شدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 465.66,
   "end": 469.02,
   "text": "إنشاء شدیم. و نفخ الله فیه من روحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 469.02,
   "end": 470.78,
   "text": "فقع له ساجدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.78,
   "end": 473.76,
   "text": "انقدر به شرافت و به عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 473.76,
   "end": 477.74,
   "text": "این ساخته شد که دستور سجده به ملائکه داده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.74,
   "end": 479.94,
   "text": "اما از اینجا به بعد چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 479.94,
   "end": 483.84,
   "text": "آیا خودمان را به گونه‌ای می‌سازیم که بعد از مرگمان دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 483.84,
   "end": 486.82,
   "text": "دستور سجده به ملائکه داده بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 486.82,
   "end": 492.96,
   "text": "آیا این چنین خواهد بود؟ خب این بی‌خبری کار دست ما می‌ده ابد ما رو خراب می‌کنه بی‌خبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 492.96,
   "end": 498.48,
   "text": "ببینید ابد ما رو داره بالاخره علم مشخص روح انسانه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 498.48,
   "end": 502.38,
   "text": "عمل ما، اون علم و عمل ما داره آینده ما رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 502.38,
   "end": 507.14,
   "text": "وقتی بی‌خبر باشی باعث می‌شه که چه، چه اتفاقی بیفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 507.14,
   "end": 510.24,
   "text": "ما در اون طورهایی که بعدها خواهیم داشت، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 510.24,
   "end": 512.6,
   "text": "طورهای ما صرفاً در این نشئه نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 512.6,
   "end": 516.48,
   "text": "و خلقکم و لقد خلقکم اطوارا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 516.48,
   "end": 519.36,
   "text": "این کریمه خیلی درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 519.36,
   "end": 521.72,
   "text": "باید دقت بشه این کریمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 521.72,
   "end": 527.26,
   "text": "که و خلق و لقد خلقکم اطوارا در سوره مریم سلام الله علیها باید باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 527.26,
   "end": 530.08,
   "text": "که ما شما رو به طورهای مختلف خلق کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 530.08,
   "end": 532.94,
   "text": "خب از اینجا به بعد دست خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 532.94,
   "end": 537.68,
   "text": "من خودم رو به اطوار مختلف دارم إنشاء می‌کنم و می‌سازم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 537.68,
   "end": 541.42,
   "text": "خودم دارم خودم رو-- یعنی مشخص خودم هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.42,
   "end": 544.0,
   "text": "خودم دارم اگر بی‌خبری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 544.0,
   "end": 550.1,
   "text": "داری بلایی سر خودت میاری که بعداً با دیدن خودت وحشت‌زده می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 550.1,
   "end": 552.84,
   "text": "دهشت می‌گیرد، وحشت می‌گیردت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.84,
   "end": 556.02,
   "text": "این یکی از معانی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.02,
   "end": 560.22,
   "text": "ظلمت و سختی و تنگی و ترس، ترس، خوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.22,
   "end": 564.12,
   "text": "هنگام مرگ. این‌ها چون از ظاهر به باطن عبور می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 564.12,
   "end": 570.22,
   "text": "خودت با خودت محشور می‌شی و هم‌نشین خودت، خودت رو زیارت می‌کنی و به لقاء خودت میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 570.22,
   "end": 576.66,
   "text": "که سنریهم آیاتنا في الآفاق و في أنفسهم حتى یتبین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 576.66,
   "end": 584.12,
   "text": "لهم أنه الحق. این حق رو در آینه و مرآت وجود خودت می‌خوای بیا و ببینی، نمی‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 584.12,
   "end": 587.0,
   "text": "و اونجا نمی‌بینی و وحشت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 587.0,
   "end": 592.7,
   "text": "اونجا یا در آینه‌ وجودی خودت وقتی آینه کج و معوج باشه، حق رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 592.7,
   "end": 596.44,
   "text": "زشت نشون میده. اون موقع هرچی می‌بینی زشت می‌بینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 596.44,
   "end": 598.94,
   "text": "بد می‌بینی، خودت رو بد می‌بینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 598.94,
   "end": 602.58,
   "text": "خودت از خودت منزجری، خودت از خودت بدت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 602.58,
   "end": 605.8,
   "text": "خودمون با خودمون هم‌نشین هستیم تا ابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 605.8,
   "end": 609.98,
   "text": "چه کردیم با خودمون؟ اینا همش دستخوش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 609.98,
   "end": 612.38,
   "text": "دستخوش باخبر شدن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 612.38,
   "end": 617.62,
   "text": "خصوصاً از باطن. اگر از باطن بی‌خبر باشیم چگونه بیارائیم خودمون رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 617.62,
   "end": 621.12,
   "text": "کسی که علم به نفس ندارد، خودش رو نمی‌شناسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 621.12,
   "end": 624.76,
   "text": "نیازهاشو، احتیاجاتشو خبر نداره، چگونه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 624.76,
   "end": 627.5,
   "text": "پی احتیاجات و نیازهای خودش بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 627.5,
   "end": 630.88,
   "text": "لذا قطعاً در یک بی‌خبری به سر می‌بره و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 630.88,
   "end": 632.52,
   "text": "و به انحطاط خواهد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 632.52,
   "end": 635.2,
   "text": "و خدا به فریاد ما برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 635.2,
   "end": 638.88,
   "text": "از وقتی که باخبر می‌شیم که با خودمون چه کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 638.88,
   "end": 642.6,
   "text": "وا حسرتا یا حسرتا برآیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 642.6,
   "end": 645.9,
   "text": "یا حسرتا علی ما فرطت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 645.9,
   "end": 650.32,
   "text": "فی جنب الله از اون کوتاهی‌هایی که پیرامون جنب الله کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 650.32,
   "end": 655.12,
   "text": "جنب الله اون نفس کل است، اون عقل کل است، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 655.12,
   "end": 662.68,
   "text": "آدم، آدم اهل بیت علیهم الصلاة والسلام است که و علم آدم الاسماء كلها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 662.68,
   "end": 665.16,
   "text": "تعلیم داد خدا به آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 665.16,
   "end": 667.12,
   "text": "همه اسماء رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 667.12,
   "end": 669.32,
   "text": "اون انسان کامل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 669.32,
   "end": 671.18,
   "text": "خب ما هم یک جزئی از اون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 671.18,
   "end": 674.18,
   "text": "ما نفس جزئی هستیم، اون نفس کل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.18,
   "end": 677.44,
   "text": "ما به اون سمت حرکت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 677.44,
   "end": 680.48,
   "text": "وقتی رفتیم در قیاس دیدی خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 680.48,
   "end": 685.56,
   "text": "اصلاً نمی‌شه خودت رو، این نفس جزئی رو کنار اون نفس کلی گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 685.56,
   "end": 690.12,
   "text": "یعنی شفعی رخ نداده، سنخیتی و شفع اول وثل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 690.12,
   "end": 694.64,
   "text": "این سنخیت رخ نداده، این جنس هم‌جنسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 694.64,
   "end": 699.0,
   "text": "کبوتر با کبوتر، باز با باز کند هم‌جنس با هم‌جنس پرواز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 699.0,
   "end": 704.16,
   "text": "وقتی هم‌جنسی و هم‌سنخی رخ نداد، دیگه شفاعتی در کار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 704.16,
   "end": 706.92,
   "text": "انسان غریب می‌مونه و تک و تنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 706.92,
   "end": 712.72,
   "text": "و در اون غربت و بیچارگی خودش علی الدوام معذب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 712.72,
   "end": 719.84,
   "text": "است. یکی از معانی تعذیب و عقاب این‌ها اینجا خودش رو این چنین نشون میده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 719.84,
   "end": 728.06,
   "text": "دور از حجت خدا، دور از اون نفس کل، دور از اون عقل کل، دور از انسان کامل و این فراق بیچارش می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 728.06,
   "end": 733.2,
   "text": "اللهم انا نشکو الیک فقد نبیانا و غیبت ولینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 733.2,
   "end": 738.48,
   "text": "اینجا به یک معنا غیبت رخ میده، فقدان رخ میده، رخ داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 738.48,
   "end": 742.42,
   "text": "اونجا به گونه‌ای. اینجا مقطعی است، اونجا همیشگی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 742.42,
   "end": 748.64,
   "text": "پس چقدر خطرناک بیخبری، بی‌خبر بودن از خود، از نظام هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 748.64,
   "end": 753.04,
   "text": "از آنچه که خدا از ما توقع دارد، مسیری که قرار است برویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 753.04,
   "end": 756.92,
   "text": "الا لا یتنهای و حد یقف نداریم دیگه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 756.92,
   "end": 759.68,
   "text": "دیگه خدا به فریاد برسه از کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 759.68,
   "end": 761.34,
   "text": "خصوصاً از خودش بی‌خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 761.34,
   "end": 766.26,
   "text": "حالا انشاالله در همه خصوص حرف می‌زنیم با همدیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 766.26,
   "end": 768.26,
   "text": "انشاالله که خدا به ما رحم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 768.26,
   "end": 771.0,
   "text": "یا دلیلی المتخیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 771.0,
   "end": 773.22,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 773.22,
   "end": 781.16,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 781.16,
   "end": 785.9,
   "text": "صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 785.9,
   "end": 790.74,
   "text": "اللهم صل على محمد يا رب صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 790.74,
   "end": 793.56,
   "text": "و آله يا رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 793.56,
   "end": 798.1,
   "text": "صل على محمد و آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}