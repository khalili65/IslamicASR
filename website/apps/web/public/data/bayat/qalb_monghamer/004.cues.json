 "chapters": [
  {
   "index": 0,
   "title": "## قلب منغمر؛ بی‌خبری زشت",
   "start": 12.1,
   "end": 141.66
  },
  {
   "index": 1,
   "title": "## سکرات مرگ؛ میوهٔ بی‌خبری",
   "start": 141.66,
   "end": 161.92
  },
  {
   "index": 2,
   "title": "## قرآن و پیامبر و علی؛ علمی که در دسترس است",
   "start": 161.92,
   "end": 210.14
  },
  {
   "index": 3,
   "title": "## سه کتاب؛ و حیرت بی‌خبر",
   "start": 210.14,
   "end": 659.21
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.84,
   "end": 4.92,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.92,
   "end": 8.74,
   "text": "السلام علیک ای داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.74,
   "end": 12.1,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.1,
   "end": 16.98,
   "text": "بحث ما قلب منغمر بود قلبی که بی‌خبر است و چه زشت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.98,
   "end": 19.94,
   "text": "که انسان دچار بی‌خبری، غفلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.94,
   "end": 23.7,
   "text": "و بی‌توجهی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.7,
   "end": 28.08,
   "text": "علم و معرفت باشد. بی‌خبر باشد از این عالمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.08,
   "end": 33.84,
   "text": "به نحو لا یتناهی خدای منان همه اون رو قضای وجودی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.84,
   "end": 40.74,
   "text": "قرار داده است تا جایی که هو الذي فرمود هو الذي هو اون هو خودش رو این چنین معرفی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.74,
   "end": 47.08,
   "text": "هو الذي سخر لكم ما في الأرض جميعا هرچی که هست جمعاً برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.08,
   "end": 51.3,
   "text": "شما مسخر شما شده که این قضای عقلی شما باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.3,
   "end": 54.08,
   "text": "شما خبر بگیرید از این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.08,
   "end": 61.2,
   "text": "و علم و قضای عقلی برداشت کنید، معرفت اخذ کنید که پایه بندگی‌ست، اصل بندگی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.2,
   "end": 63.9,
   "text": "محتوا و مغزای بندگی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.9,
   "end": 67.6,
   "text": "بعد شما بی‌خبر باشید از این عالمی که برای شماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.6,
   "end": 69.86,
   "text": "که بعد شما رو برا خودش خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.86,
   "end": 73.32,
   "text": "انسان بی‌خبر، بی‌خبره از خود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.32,
   "end": 76.58,
   "text": "بی‌خبره از خالق خود، بی‌خبره از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.58,
   "end": 79.88,
   "text": "دنیا و مابعدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.88,
   "end": 83.56,
   "text": "این به چه درد مسیر بندگی میخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.56,
   "end": 86.84,
   "text": "به چه کار میاد چنین کسی؟ کسی که از خودش بی‌خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.84,
   "end": 89.96,
   "text": "اوه، اوه بی‌خبری از خود چه عرض کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.96,
   "end": 92.8,
   "text": "بی‌خبری از خود چه عالمی‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.8,
   "end": 96.28,
   "text": "چه عالم تاریکی‌ست بی‌خبری از خود که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.28,
   "end": 98.48,
   "text": "عرض خواهد شد که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.48,
   "end": 102.86,
   "text": "یک معنای قلب منغمر برمی‌گرده به بی‌خبری از خود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.86,
   "end": 105.32,
   "text": "نداشتن معرفت نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.32,
   "end": 107.84,
   "text": "بی‌خبری از دنیای پیرامونمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.84,
   "end": 110.6,
   "text": "اینکه از کجا اومدیم؟ انا لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.6,
   "end": 113.02,
   "text": "بی‌خبر باشیم از الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 113.02,
   "end": 116.36,
   "text": "از اون عوالمی که ازش نازل شدیم چگونه نازل شدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.36,
   "end": 119.28,
   "text": "بی‌خبر باشیم از جایی که اومدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.28,
   "end": 122.3,
   "text": "از این نشئه طبیعت نسبتش با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 122.3,
   "end": 124.46,
   "text": "نشأت دیگه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 124.46,
   "end": 129.18,
   "text": "این عرض شود رتبه‌های دیگر وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 129.18,
   "end": 134.22,
   "text": "بی‌خبر از اینکه برای چی اومدیم اصلاً اینجا و بی‌خبر از اینکه به کجا می‌رویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 134.22,
   "end": 136.68,
   "text": "بی‌خبر ازعود و معاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 136.68,
   "end": 140.7,
   "text": "به کجا می‌رویم. مثل انسان هاج و واجی که نمی‌دونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 140.7,
   "end": 143.92,
   "text": "چه بکنه. خب چنین کسی وقت مرگش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 143.92,
   "end": 150.54,
   "text": "وقتی از این بی‌خبری می‌رود در اون بی‌خبری بزرگتر که اونجا خبرهاست، اینجا سایه اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 150.54,
   "end": 154.96,
   "text": "در اون بی‌خبری بزرگتر که میره بی‌خبر کامل از اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 154.96,
   "end": 158.4,
   "text": "یک معنای سکره یا سکرات مرگ همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 158.4,
   "end": 164.2,
   "text": "هاج و واج می‌شه. متعجب و حیرت‌زده و انگشت به دهان می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.2,
   "end": 168.5,
   "text": "این دنیا که نسبت به اونجا مثل حلقه‌ایست در یک بیابان بی‌خبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.5,
   "end": 171.38,
   "text": "بعد بره اونجا از اونجا باخبر بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 171.38,
   "end": 175.4,
   "text": "که این کسی قطعاً از بزرگ‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 175.4,
   "end": 179.34,
   "text": "دردها و زجرها و عذاب‌هایی که براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.34,
   "end": 181.82,
   "text": "مترتبه همه بی‌خبریشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 181.82,
   "end": 185.78,
   "text": "و اصلاً هم‌نشیناش هم بیشتر از خودش زجر می‌کشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 185.78,
   "end": 189.66,
   "text": "داریم بدترین هم‌نشین جاهله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 189.66,
   "end": 192.6,
   "text": "اصلاً بدتر از جهل ما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 192.6,
   "end": 196.16,
   "text": "اون جهلی که آدم بی‌خبر باشد البته خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 196.16,
   "end": 200.02,
   "text": "یه معناش عرض شود حالا یا جاهل دو گونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 200.02,
   "end": 203.08,
   "text": "می‌دونید دیگه یا قاصر یا مقصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 203.08,
   "end": 208.78,
   "text": "اون جهلی که از روی کوتاهی‌ه، طرف کوتاهی کرده مقصره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 208.78,
   "end": 214.16,
   "text": "خودش نرفته پی‌ش. و الا پیرامونش تا دلت بخواد علم و معرفت بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 214.16,
   "end": 218.76,
   "text": "راه‌های ارتباطی با علم و معرفت علما و این‌ها بوده نرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 218.76,
   "end": 221.56,
   "text": "خب این خیلی دیگه شدیدترین حالتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 221.56,
   "end": 224.12,
   "text": "اون انزل مراتبش می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 224.12,
   "end": 227.26,
   "text": "جهل عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 227.26,
   "end": 231.22,
   "text": "بر-- که قاصره. کوتاهی نکرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 231.22,
   "end": 234.94,
   "text": "مقصر نیست. دیگران در حقش کوتاهی کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 234.94,
   "end": 238.26,
   "text": "این انزل مرتب-- در هر حال می‌شود بی‌خبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 238.26,
   "end": 240.78,
   "text": "اون شدتشه، این حدتشه، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 240.78,
   "end": 242.68,
   "text": "بی‌خبریه از عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 242.68,
   "end": 246.38,
   "text": "وقتی که نگاه می‌کنه می‌بینه خدای منان آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.38,
   "end": 250.94,
   "text": "من اراد علم الاولین والاخرین فليصور القرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 250.94,
   "end": 255.56,
   "text": "همه این علم امکانی رو، علم امکانی رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 255.56,
   "end": 260.0,
   "text": "ظرف قرآن ریخته و اون رو به قلب پیغمبرش نازل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 260.0,
   "end": 270.46,
   "text": "پیغمبری که فرمودن و ما ارسلناک الا کافه للناس برای همه مردم بشیر و نذيرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.46,
   "end": 276.3,
   "text": "یا خدا بفرما تبارک الذي به عظمت از خودش یاد کنه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 276.3,
   "end": 285.8,
   "text": "نزل الفرقان على عبده لیکون للعالمین نذيرا للعالمین نذيرا و ما ارسلناک الا رحمة للعالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.8,
   "end": 289.42,
   "text": "این پیغمبر با همه این علوم بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.42,
   "end": 292.0,
   "text": "وصی عزیز پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.0,
   "end": 296.1,
   "text": "امام کوین مولامون علی علیه صلوة السلام بفرماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.1,
   "end": 301.72,
   "text": "\"من به راه‌های آسمان واقف‌ترم تا راه‌های آسمان تا راه‌های زمین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 301.72,
   "end": 305.0,
   "text": "به یک معنا یعنی راغب‌ترم نه که یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.0,
   "end": 307.98,
   "text": "اونجا رو بهتر بلدم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.98,
   "end": 310.9,
   "text": "زمین و آسمون در برابر حضرت یک معناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.9,
   "end": 313.3,
   "text": "یک حقیقت کلیه است. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.3,
   "end": 316.58,
   "text": "اشراف کامل به همه جزئیات و کلیات داره حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 316.58,
   "end": 319.66,
   "text": "یعنی به اونجا راغب‌ترم. یه معناش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 319.66,
   "end": 326.12,
   "text": "که از من بپرسید سلونی قبل ان تفقدونی قبل از اینکه منو از دست بدید از من سؤال کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.12,
   "end": 328.06,
   "text": "که به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.06,
   "end": 333.56,
   "text": "بعد ما بیایم بیفتیم به این درد که اللهم انا نشکو الیک فقد نبینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.56,
   "end": 338.08,
   "text": "نبینا ما دچار فقدان پیغمبر شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.08,
   "end": 342.04,
   "text": "و غیبت ولینا دور افتادیم از اماممون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.04,
   "end": 344.36,
   "text": "از اماممون که امام کل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 344.36,
   "end": 351.56,
   "text": "همه علم پیششه. سلطنت به همه عوالم داره چون العلم سلطان همه علم ازده اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.56,
   "end": 355.52,
   "text": "بعد بریم چیزهای متعارف و دنیایی و زودگذر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.52,
   "end": 357.6,
   "text": "حسی و احساسی ازش طلب کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.6,
   "end": 363.85,
   "text": "اینا زشته. بی‌خبری پدر آدمو درمیاره، بیچاره می‌کنه بی‌خبری آدم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.85,
   "end": 370.99,
   "text": "خاتم. حالا خاتم النبیین که فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.99,
   "end": 374.81,
   "text": "پیامبر عزیز عالم خاتم الانبیا دیگه این خاتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.81,
   "end": 379.91,
   "text": "حالا یا اگه فعل ماضی بگیریش باب مفاعله میشه ختم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.91,
   "end": 382.27,
   "text": "اسم بگیریش به معنای مهر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.27,
   "end": 384.55,
   "text": "حالا اون آخرین پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 384.55,
   "end": 388.35,
   "text": "خاتم بگیری اسم فاعل ختم کننده پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.35,
   "end": 391.81,
   "text": "حالا هرچی که باشه ختم دیگه آخرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.81,
   "end": 395.05,
   "text": "تموم. یعنی چون که صد آیه نود هم پیش ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.05,
   "end": 403.17,
   "text": "تمام انبیا، تمام اولیا حتی اهل بیت عصمت و طهارت حتی امیرالمؤمنین سر سفره او هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.17,
   "end": 405.91,
   "text": "که حتی امیرالمؤمنین می فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.91,
   "end": 412.31,
   "text": "من هم بنده ای ام \"عبد من عبید\" یعنی بنده ای ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 412.31,
   "end": 414.75,
   "text": "بعد مبالغه میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.75,
   "end": 417.07,
   "text": "عبید از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.07,
   "end": 421.91,
   "text": "شدت بندگان، بندگانی که به شدت بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.91,
   "end": 424.73,
   "text": "او هستند، بنده پیغمبرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.73,
   "end": 434.91,
   "text": "این ببینید جایگاه پیغمبر چگونه است که او بالاصاله بقیه به تبعش این سیر صعودی رو رفتند و به فراز رسیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 434.91,
   "end": 438.45,
   "text": "حالا یه همچه عزیزی پیغمبر ما باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.45,
   "end": 442.67,
   "text": "یه همچه کتابی قرآن ما باشد، کتاب ما باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.67,
   "end": 449.21,
   "text": "یه همچه امامی پیشوا و امام ما و زعیم ما و بزرگ ما و پدر ما باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.21,
   "end": 453.07,
   "text": "بعد این وضع ما از بی خبری از نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.07,
   "end": 457.29,
   "text": "پس چقدر بده که ما بی خبر باشیم از این کتاب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.29,
   "end": 459.71,
   "text": "کتبی، قرآن کتبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.71,
   "end": 463.71,
   "text": "کتاب آفاقی، قرآن هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 463.71,
   "end": 467.19,
   "text": "کتاب انسی، سیر معرفت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.19,
   "end": 475.13,
   "text": "که این‌ها سبب میشه که انسان در مسیر سیر و سلوکش دچار حیرت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.13,
   "end": 477.89,
   "text": "حیرت زده بشه. ندونه چه کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.89,
   "end": 480.35,
   "text": "از کجا شروع کنه به کجا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 480.35,
   "end": 484.37,
   "text": "آدمی که حیرانه، سرگشته است، سرگردانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.37,
   "end": 486.79,
   "text": "بی سر و سامانه. این به چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 486.79,
   "end": 490.31,
   "text": "چیزی امید ببنده؟ به چه امیدی نفس بکشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 490.31,
   "end": 493.47,
   "text": "بی خبری بدترین درد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 493.47,
   "end": 496.85,
   "text": "روزگاره. بی خبری. حالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.85,
   "end": 500.81,
   "text": "حالا یا انسان میگیم بی خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 500.81,
   "end": 505.05,
   "text": "اما خب وقتی هم که میره خبر بگیره درست خبر نمیگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 505.05,
   "end": 508.37,
   "text": "اینکه از طه علیه الرحمه فکر می‌کنم در درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.37,
   "end": 513.77,
   "text": "سیزدهم دروس معرفت نفسشون اونجا می‌فرمود هرچه نگاه کردم به این عوالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 513.77,
   "end": 518.33,
   "text": "هستی به این رسیدم که همه علم انباشته شده روی همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 518.33,
   "end": 524.31,
   "text": "گفت بسم الله. علم فقط در دانشگاه و حوزه و کتاب همه کتاب کتب شده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 524.31,
   "end": 526.65,
   "text": "هر طرف رو کنی علمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.65,
   "end": 529.21,
   "text": "آگاهی پیدا کن باخبر شو از عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 529.21,
   "end": 532.19,
   "text": "ببین همه نورند همه یک پارچه نورند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 532.19,
   "end": 535.67,
   "text": "الله نور السماوات والارض نور بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.67,
   "end": 539.23,
   "text": "نور بگیر تا از ظلمت اخراجت کنه این نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.23,
   "end": 545.81,
   "text": "که الله ولی الذین آمنوا یخرجهم من الظلمات الی النور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 545.81,
   "end": 551.55,
   "text": "و اون الله نور السماوات والارض که تو رو اخراج میکنه از ظلمت به سمت نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.55,
   "end": 554.19,
   "text": "این نور، نور وجوده. نور علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 554.19,
   "end": 556.55,
   "text": "علم عین وجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 556.55,
   "end": 559.25,
   "text": "علم عین ذات حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.25,
   "end": 564.89,
   "text": "حالا در خصوص این تحصیل علم انسان باید به نحو احسن حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 564.89,
   "end": 568.75,
   "text": "یک آن غافل نباشه. شما در حالات بزرگان ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 568.75,
   "end": 576.03,
   "text": "بیشترین وقتی که در عمرشون گذاشتن برای تحصیل علم و معارف و خبر گرفتن از عوالم هستی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 576.03,
   "end": 581.23,
   "text": "خبر گرفتن از درون و بیرون خودشون از باطن و ظاهر خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 581.23,
   "end": 583.47,
   "text": "باخبر بشن. صرفا اینکه حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 583.47,
   "end": 586.37,
   "text": "مثلا علم طب بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 586.37,
   "end": 590.77,
   "text": "خب خیلی خوب. علم خوب. اما این ظاهر پیرامون ظاهر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 590.77,
   "end": 596.61,
   "text": "ظاهر ما که البته اصلش ذیل اسم طبيب حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 596.61,
   "end": 600.11,
   "text": "تعریف میشه که قبلاً گفتیم یعنی ظاهر و باطن در هم تنیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.11,
   "end": 607.29,
   "text": "اما امروز طب حالا پزشک گرامی که فقط به ظاهر پرداخته این هم یک بخش یک جزئی از علمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 607.29,
   "end": 610.23,
   "text": "که انسان نباید متوقف بشه، باید حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 610.23,
   "end": 612.59,
   "text": "شرع پوسته و ظاهر دینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 612.59,
   "end": 616.77,
   "text": "باید حرکت کرد. دنیا ظاهر عوالم هستیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 616.77,
   "end": 619.43,
   "text": "باید حرکت کرد. بدن ظاهر نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 619.43,
   "end": 622.81,
   "text": "باید حرکت کرد. باید حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 622.81,
   "end": 627.17,
   "text": "از ظاهر به باطن سفر کرد تا خبرها گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 627.17,
   "end": 629.39,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 629.39,
   "end": 633.95,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 633.95,
   "end": 637.69,
   "text": "وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 637.69,
   "end": 644.95,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 644.95,
   "end": 649.41,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 649.41,
   "end": 653.29,
   "text": "وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 653.29,
   "end": 659.21,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
