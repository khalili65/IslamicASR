 "chapters": [
  {
   "index": 0,
   "title": "## اقتدا به معلول؛ شرایط امام جماعت",
   "start": 0.72,
   "end": 97.08
  },
  {
   "index": 1,
   "title": "## کشف المراد؛ از تجرید تا شرح شعرانی",
   "start": 97.08,
   "end": 117.16
  },
  {
   "index": 2,
   "title": "## افتخار به جهل و حرص دنیا در انتخاب علوم",
   "start": 117.16,
   "end": 420.7
  },
  {
   "index": 3,
   "title": "## اصول دین از روی دلیل؛ نه همهٔ فروع",
   "start": 420.7,
   "end": 596.9
  },
  {
   "index": 4,
   "title": "## فقه آثار این‌جهانی؛ وظیفهٔ غیر فقه",
   "start": 596.9,
   "end": 991.05
  },
  {
   "index": 5,
   "title": "## فصل الخطاب؛ فهم اینجا آسان‌تر از برزخ",
   "start": 991.05,
   "end": 1144.01
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.72,
   "end": 7.08,
   "text": "بسم الله الرحمن الرحیم و به نستعین السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.08,
   "end": 10.92,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.92,
   "end": 16.2,
   "text": "یه سؤال استفتای مشروحی شده از رهبر عزیرمون پیراهون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.2,
   "end": 19.38,
   "text": "اینکه آیا به معلول میشه اقتدا کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.38,
   "end": 21.84,
   "text": "حالا معلول اینه که توضیح دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.84,
   "end": 24.2,
   "text": "تفصیلن که حالا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.2,
   "end": 28.92,
   "text": "یه پای یا یه دست ندارن یا یه انگشت ندارن یا بند انگشت ندارن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.92,
   "end": 34.96,
   "text": "حالا یه عضوی از اعضای بدن رو ندارن لذا مثلاً برای گرفتن وضو نایب میگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.96,
   "end": 41.4,
   "text": "یا مثلاً به جهت اینکه عضوی از اعضای بدن ندارن به دیوار یا عصا تکیه میکنن و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.4,
   "end": 44.52,
   "text": "رهبر عزیرمون فرمودن که به طور کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.52,
   "end": 50.36,
   "text": "اگر استقرار و آرامش در قیام به صورت طبیعی وجود داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.36,
   "end": 55.26,
   "text": "و بتو-بتواند آن را در حال قرائت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.26,
   "end": 59.36,
   "text": "در حال قرائت چی؟ حمد و سوره و ذکرای نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.36,
   "end": 61.28,
   "text": "و انجام افعال آن حفظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.28,
   "end": 68.68,
   "text": "یعنی در حالی که داره قرائت و افعال نماز انجام میده، اون آرامش رو بتونه حفظ کنه، استقرار رو بتونه حفظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.68,
   "end": 75.98,
   "text": "همچنین قدرت بر رکوع و سجود کامل داشته باشه، اونم با گذاشتن هفت عضو بدن بر زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.98,
   "end": 79.32,
   "text": "همچنین اینکه بتونه وضو صحیح بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.32,
   "end": 84.86,
   "text": "اگر اینها هست اقتدای دیگران به او در نماز بعد از احراز شر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.86,
   "end": 87.92,
   "text": "سایر شرایط امام جماعت صحیح هست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.92,
   "end": 95.32,
   "text": "یعنی همون مثلاً تلفظ صحیح و عدالتش و غ-- در غیر این صورت صحیح و مرزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.32,
   "end": 99.6,
   "text": "اما بحث قلب منغمه رو ادامه میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.6,
   "end": 103.96,
   "text": "کتاب شریف کشف المراد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.96,
   "end": 110.48,
   "text": "مرحوم حضرت علامه شعرانی، آشیخ ابوالحسن شعرانی علیه الرحمة، استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.48,
   "end": 116.16,
   "text": "توانمند حضرت علامه حسن زاده علیهم الرحمة رو میخوندم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.16,
   "end": 120.32,
   "text": "دقت میکردم. حالا این کتاب که البته میدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.32,
   "end": 127.42,
   "text": "خود کشف المراد در حقیقت میشه گفت این شرح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 127.42,
   "end": 130.68,
   "text": "شرح علامه حلی بر کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.68,
   "end": 133.44,
   "text": "تجرید الاعتقاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 133.44,
   "end": 136.78,
   "text": "خواجه نصیره، خواجه نصیرالدین توسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.78,
   "end": 140.98,
   "text": "یعنی این کتاب اصلش تجرید الاعتقاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.98,
   "end": 144.42,
   "text": "مال مرحوم خواجه نصیرالدین توسیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.42,
   "end": 149.98,
   "text": "بعد علامه حلی بزرگوار شرح براش مینویسه، اسمشو میذاره کشف المراد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 149.98,
   "end": 153.3,
   "text": "بعد علامه شعرانی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.3,
   "end": 155.72,
   "text": "شرح میده شرح علامه حلی رو؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.72,
   "end": 157.46,
   "text": "یعنی شرح در شرح میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.46,
   "end": 160.36,
   "text": "به عبارتی نور on، الا نور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.36,
   "end": 163.82,
   "text": "اونجا حالا مقدمه کتاب رو که اگر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.82,
   "end": 171.04,
   "text": "دقت کرده باشید خیلی دردمند حضرت علامه شعرانی علیه الرحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.04,
   "end": 176.16,
   "text": "که خیلی به عظمت حضرت استاد از ایشون یاد میکردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.16,
   "end": 180.16,
   "text": "اونجا در زمانه خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.16,
   "end": 186.3,
   "text": "می فرمودن که حالا تو مقدمه کتاب نوشتن به قلم خودشون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.3,
   "end": 189.12,
   "text": "عرض شود که ایشون مینویسن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 189.12,
   "end": 196.26,
   "text": "مردم به جهل افتخار میکنن تو اون زمانه خودشون و به ندانستن معارف الهی مباهات مینمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 196.26,
   "end": 200.26,
   "text": "دقیقاً الانم هم چنینه. مثلاً شما حتی به بچه حزب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.26,
   "end": 206.4,
   "text": "ببخشید جسارت میکنم اینطوری، به بچه مذهبی‌ها، حزب الله‌ها شما در مورد مسائل عقلی رو میگی فرار میکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 206.4,
   "end": 208.76,
   "text": "و به اینکه نمیدونه این‌ها رو مباهات میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.76,
   "end": 210.68,
   "text": "میگه الحمد لله ما از این چیزا به دوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.68,
   "end": 213.04,
   "text": "ما سراغ عقل و مسائل عقلی نرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.04,
   "end": 217.12,
   "text": "افتخار هم میکنن. حالا خ-- دست خط خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.12,
   "end": 222.5,
   "text": "حضرت علامه شعرانی رو دارم براتون میخونم که مردم به جهل افتخار میکنن و به دا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.5,
   "end": 226.58,
   "text": "به ندانستن معارف الهی مباهات مینمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 226.58,
   "end": 231.44,
   "text": "هتام دنیا به نظر آنها امر محقق و معلوم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.44,
   "end": 236.32,
   "text": "و غیر از آنچه تعلق به دنیا دارد ناچیز و موهوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.32,
   "end": 242.26,
   "text": "حرص دنیا در انتخاب علوم نیز تأثیر کرده و آن علم، دقت کنین اینجا رو عجیبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 242.26,
   "end": 248.18,
   "text": "و آن علم را میپسندند که بیشتر مال از آن به دست آید و هر علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 248.18,
   "end": 255.72,
   "text": "لازم و واجب، هر علمی که حتی واجب باشه لازم باشه که فایده دنیا ندارد متروک مانده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 255.72,
   "end": 261.24,
   "text": "تا اینکه شنیدم مردم دنیا یکدیگر را منع میکنن از خواندن تفسیر قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 261.24,
   "end": 264.98,
   "text": "که اعتبار و شهرت انسان را زیان دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 264.98,
   "end": 270.32,
   "text": "و هر که مشهور شود به دانستن تفسیر بلکه حدیث و سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 270.32,
   "end": 276.46,
   "text": "پیغن-- سیر پیغمبر و ائمه علیهم الصلاة والسلام ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 276.46,
   "end": 279.32,
   "text": "میان علما قدر و منزلت ندارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 279.32,
   "end": 282.74,
   "text": "و آن علم قدر و منزلت دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 282.74,
   "end": 290.84,
   "text": "کدوم علم؟ مانند علم اصول فقه که هر کس در آن تفوق یابد جاه و مال او افزون شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 290.84,
   "end": 294.06,
   "text": "الانم مرسومه بین علما تو قم مخصوصاً اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 294.06,
   "end": 300.38,
   "text": "اینایی که بیشتر سمت فقه و اصول، حالا نه مطلقاً اما غالباً میرن به جهت که درش پول هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 300.38,
   "end": 305.28,
   "text": "دنیا درش هست. دفتر و دستک و چه می دونم این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 305.28,
   "end": 311.46,
   "text": "بعد ایشون می فرمایند که اینجا رو توجه داشته باشید متن کتاب، کتابی که دست بنده است همین کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 311.46,
   "end": 315.66,
   "text": "کشف المراد که شرح تجرید الاعتقاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 315.66,
   "end": 325.16,
   "text": "می فرمایند فقه علم فروع است و حاجت مسلمانان بدان بسیار است اما پس از مسلمان بودن علم فقه در مسلمان شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 325.16,
   "end": 329.52,
   "text": "کسی و یا رسوخ ایمان او اثر ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 329.52,
   "end": 333.66,
   "text": "اما اگر مسلمانی باشد با عقیده راسخ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 333.66,
   "end": 336.94,
   "text": "علم فقه بیش از همه علوم به کار او می آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 336.94,
   "end": 339.4,
   "text": "یعنی می-- صرف علم فقه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 339.4,
   "end": 342.44,
   "text": "همین ظاهر و پوسته دینه به درد کسی نمیخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 342.44,
   "end": 345.66,
   "text": "این باعث نمیشه ایمان رسوخ کنه در وجود انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 345.66,
   "end": 349.56,
   "text": "اما اگر کسی ایمانش راسخ شده اون موقع فقه به دردش میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 349.56,
   "end": 353.34,
   "text": "یعنی داره میگه سراغ علوم باطنی برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 353.34,
   "end": 357.28,
   "text": "ما علم دیگری غیر علم فقه یعنی علم فروع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 357.28,
   "end": 362.8,
   "text": "فروע لازم داریم که اهل شک و تردید را در دین راسخ کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 362.8,
   "end": 367.38,
   "text": "و مسلمانان سست را در مسلمانی قوی گرداند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 367.38,
   "end": 370.48,
   "text": "وگرنه کسانی بودند در علم فروع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 370.48,
   "end": 373.98,
   "text": "کامل تا در محیط دینداران بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 373.98,
   "end": 378.9,
   "text": "در علم فروع کامل یعنی کامل بودند علم فروع‌شون در فقهشون کامل بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 378.9,
   "end": 384.12,
   "text": "اما میف-- ایشون می فرما تا در محیط دیدا- دینداران بودند بین اهل دین بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 384.12,
   "end": 391.34,
   "text": "در محیط دینداران بودند دیندار می‌نمودند و چون از آن محیط و جامعه خارج شدند فقه را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 391.34,
   "end": 395.6,
   "text": "همراه خود آوردند. در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 395.6,
   "end": 398.08,
   "text": "در حالتی که به عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 398.08,
   "end": 401.16,
   "text": "غیب و آخرت و خدا و ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 401.16,
   "end": 405.66,
   "text": "و هر چیز نادیده اعتقاد نداشتند و مانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 405.66,
   "end": 408.28,
   "text": "حالا می‌فرمود همین مادیون اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 408.28,
   "end": 413.36,
   "text": "که حالا پیرامون روح و عقاب و ثواب اخروی و اینها، اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 413.36,
   "end": 416.82,
   "text": "پیششون این چنین امور موهومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 416.82,
   "end": 419.1,
   "text": "بعد ادامه میدن که با آن که مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 419.1,
   "end": 424.34,
   "text": "فروع فقه را با کمال دقت و استدلال می‌دانستند و بسیار چنین اشخاص را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 424.34,
   "end": 430.14,
   "text": "خود دیدم و من یقین دارم اگر راسخان در عقاید معتقدان عالم غیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 430.14,
   "end": 433.68,
   "text": "از محیط اسلامی خارج می‌شدند و شصت سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 433.68,
   "end": 438.14,
   "text": "در کفرستان زندگی می‌کردند هرگز خللی در اعتقاد آنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 438.14,
   "end": 444.38,
   "text": "به بقای روح و ثواب و عقاب آخرت پیدا نمی‌شد، چون به عالم غیب عقیده داشتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 444.38,
   "end": 448.58,
   "text": "و اهل ظاهر به عالم غیب عقیده ندارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 448.58,
   "end": 452.64,
   "text": "و شرط اول ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 452.64,
   "end": 458.9,
   "text": "است. ایشان می‌فرماید که دیدم زیاد آدم‌هایی که به پوسته و ظاهر دین توجه دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 458.9,
   "end": 461.92,
   "text": "صرفاً به خم و راست شدن و به باطن دین توجه ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 461.92,
   "end": 464.84,
   "text": "اینها وقتی از بین دینداران فارغ می‌شوند چی میشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 464.84,
   "end": 470.62,
   "text": "توخالی میشن. و این حقایق مثلا روح و عقاب و ثواب و اینها رو موهوم می‌پندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 470.62,
   "end": 473.74,
   "text": "در حالی که اون کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 473.74,
   "end": 477.56,
   "text": "اعتقاد راسخ به مسائل دینی دارند اینها قصه‌شون فرق می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 477.56,
   "end": 481.74,
   "text": "اینها اول به غیب ایمان آوردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 481.74,
   "end": 488.56,
   "text": "بعد ایشون ادامه میدن. واجب است مسلمانان همه مطالب اصول دین را از روی دلیل بدانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 488.56,
   "end": 492.14,
   "text": "عجب! اینو دقت کنید تو رو خدا ببینید همین ماحصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 492.14,
   "end": 495.28,
   "text": "جلسه امروز ما همین باشه فکر می‌کنم بس باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 495.28,
   "end": 505.42,
   "text": "واجب است مسلمانان همه مطالب اصول دین را از روی دلیل بدانند اما واجب نیست همه مسائل فروع را بدانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 505.42,
   "end": 508.98,
   "text": "حالا به یک اعتبار ایشون می‌فرمایند که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 508.98,
   "end": 513.1,
   "text": "دلایل بر مسائل فقهی رو کسی ندونه، اوه مشکلی براش وارد نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 513.1,
   "end": 515.66,
   "text": "تقلید می‌کنه از یک مجتهدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 515.66,
   "end": 517.98,
   "text": "مجتهد عادلی، اعلمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 517.98,
   "end": 528.22,
   "text": "اما ایشون ادامه میدن که اما اگر نداند خدا عادل است یا امام معصوم است و قولش حجت است، دین او را ضرر دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 528.22,
   "end": 535.72,
   "text": "زیرا که وقتی امام را معصوم ندانست و خدا را عادل نشمرد، به فرمان معصوم عمل نمی‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 535.72,
   "end": 539.22,
   "text": "و به ثواب خدا هم اطمینان ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 539.22,
   "end": 543.34,
   "text": "لذا همه اعمال او متزلزل می‌گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 543.34,
   "end": 549.12,
   "text": "با این مسلمانان که بر حسب ظاهر شرع مسلمانند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 549.12,
   "end": 554.44,
   "text": "اما در دل شک در اصول عقاید دین دارند اگر بگویی روزه بدارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 554.44,
   "end": 556.74,
   "text": "نمی‌دانند چرا خود را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 556.74,
   "end": 559.8,
   "text": "رنج دهند و از غذا خوردن امتناع کنند؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 559.8,
   "end": 562.72,
   "text": "چون به عذاب آخرت معتقد نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 562.72,
   "end": 570.28,
   "text": "از این جهت می‌بینی اکثر مردم روزه می‌خورند و دینداران راضی هستند که تظاهر نکنند اما اندیشه نمی‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 570.28,
   "end": 575.98,
   "text": "که چرا اصلا خود آنها بینه دارند با آن که مسلمان‌اند چرا مخالفت امر خدا می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 575.98,
   "end": 583.06,
   "text": "و جواب، جواب آن است که ظاهر اسلام غیر اعتقاد یقینی به آتش دوزخ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 583.06,
   "end": 587.66,
   "text": "الله اکبر. و اینان در باطن مسلمان نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 587.66,
   "end": 596.9,
   "text": "اگر همه رسائل علم عملیه هم فتوا به چیزی داده باشند در عقیده آنها تأثیر ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 596.9,
   "end": 599.98,
   "text": "بعضی علم فقه را از علوم دنیا شمرده‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 599.98,
   "end": 606.3,
   "text": "به این معنی که فقه نظر می‌کند در آثار این جهانی اعمال شرع و تبعات این جهانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 606.3,
   "end": 614.24,
   "text": "اینها مثلا با وضو باطل در این جهان نماز باطل است و عبادت صح-- عبادت صحیح در این جهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 614.24,
   "end": 618.52,
   "text": "قضا را ساقط می‌کند و باطل ساقط نمی‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 618.52,
   "end": 622.54,
   "text": "و بیع باطل در این جهان سبب مالکیت نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 622.54,
   "end": 627.6,
   "text": "اما عذاب ترک اعمال در آخرت چیست و ثواب آن چقدر است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 627.6,
   "end": 634.56,
   "text": "شکاک و مرددین را به دلیل ملزم لاس-- به دلیل ملزم سازد که حتما این ثواب و عقاب هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 634.56,
   "end": 636.18,
   "text": "وظیفه علم فقه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 636.18,
   "end": 639.58,
   "text": "برای این مردم این قسمت اخیر بسیار لازم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 639.58,
   "end": 641.86,
   "text": "و نیز در فقه بحث می‌شود چنین و چنان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 641.86,
   "end": 646.32,
   "text": "بحث ایشون اینه که اهمیت علوم باطنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 646.32,
   "end": 648.86,
   "text": "اعتقادات، بحث اعتقاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 648.86,
   "end": 652.14,
   "text": "چون این رساله، این کتاب شریف و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 652.14,
   "end": 656.16,
   "text": "گران سنگ به یک معنا بی‌بدیل پیرامون اعتقاداته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 656.16,
   "end": 659.46,
   "text": "صرفاً قضای عقلایی. حتی ایشون در سیر بحثشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 659.46,
   "end": 666.6,
   "text": "خیلی کم پیش میاد از علوم نقلی یعنی از آیات و روایات بهره بگیره چون صرفاً کار عقلی انجام میده ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 666.6,
   "end": 669.26,
   "text": "بعد توصیه میشه این کتاب رو بخونیم هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 669.26,
   "end": 674.64,
   "text": "ایشون یه در حقیقت قیاسی می‌کنه بر ظاهر دین و باطن دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 674.64,
   "end": 679.9,
   "text": "میگه خب اکثر اینایی هم که به ظاهر دین مشغولند از باطن دین بی‌خبرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 679.9,
   "end": 682.82,
   "text": "روچهار غرب منغمرند، بی‌خبرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 682.82,
   "end": 686.7,
   "text": "و همین کار داد- داده دستشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 686.7,
   "end": 692.32,
   "text": "بعد ایشون ادامه میدن که امروز مادیین بر عقول غالب مردم مسلط گردیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 692.32,
   "end": 705.9,
   "text": "کسانی که نه به آخرت و نه به خدا عقیده ندارند و عالمی غیر از همین جهان که می‌بینیم باور ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 705.9,
   "end": 711.06,
   "text": "ایشون اشاره به این آیه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 711.06,
   "end": 713.22,
   "text": "واجب اهم از برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 713.22,
   "end": 720.26,
   "text": "علما و متعلمین در زمان ما آن است که ثابت کنند موجود دیگری بلکه عالم دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 720.26,
   "end": 727.15,
   "text": "غیر مرئی اونند که خدا و روح و برزخ و ملائکه و امثال آن از آن عالماند هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 727.15,
   "end": 734.59,
   "text": "و تا کسی به این عالم معتقد نباشد محال است مسلمان باشد و محال است هیچ مسئله از مسائل اصول دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 734.59,
   "end": 737.17,
   "text": "یا فروعه دین را به او آموخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 737.17,
   "end": 741.31,
   "text": "توجه کردی چی شد؟ بعد ایشون ادامه میدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 741.31,
   "end": 743.37,
   "text": "صراحتاً می‌فرمایند که اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 743.37,
   "end": 750.49,
   "text": "واجب عینی است دوره‌ی اعتقادات دیدن یعنی باخبر شدن از باطن عالم اعتقادات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 750.49,
   "end": 752.97,
   "text": "همون گره‌های وجودی که انسان ا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 752.97,
   "end": 755.45,
   "text": "به ع-به عقل بنشینه، قلبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 755.45,
   "end": 758.51,
   "text": "گره بخوره با باورها و عقایدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 758.51,
   "end": 761.47,
   "text": "باطن دین رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 761.47,
   "end": 765.35,
   "text": "متأسفانه درد ایشون در ابتدای رساله اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 765.35,
   "end": 769.07,
   "text": "که اکثر مردم حتی مسلمونا گرفتار ظواهر دین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 769.07,
   "end": 772.53,
   "text": "واقعا هم اینطوری هست. گرفتار ظواهر دین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 772.53,
   "end": 774.23,
   "text": "خبر نداره. بی‌خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 774.23,
   "end": 776.63,
   "text": "نمی‌دونه چرا اصلا داره نماز می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 776.63,
   "end": 778.73,
   "text": "نمی‌دونه چرا باید از امامت دم بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 778.73,
   "end": 783.07,
   "text": "نمی‌دونه چرا باید اصلا برای امام حسین خوب عزاداری کنه، گریه کنه، سینه بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 783.07,
   "end": 785.15,
   "text": "چرا حج میره؟ چرا این شکلیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 785.15,
   "end": 788.69,
   "text": "چرا اجتماعات؟ چرا مثلا نماز جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 788.69,
   "end": 794.65,
   "text": "ارجح است بر فرادا؟ اینا همینطوری صرفا مثل کلاغ نوک می‌زنه جسارتاً به زمین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 794.65,
   "end": 802.17,
   "text": "هیچ خبری نداره از باطن دین، باطن دین، باطن دین رو اگر شما ورداری اسم شریف الباطن خدا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 802.17,
   "end": 806.89,
   "text": "برداشتی و اصلا این امکان نداره یعنی یکی از اسمای خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 806.89,
   "end": 810.05,
   "text": "معطل بمونه. اسم الباطن خدا معطل بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 810.05,
   "end": 814.07,
   "text": "نمیشه. یعنی دو تاش توأمان در هم پیچیده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 814.07,
   "end": 817.11,
   "text": "هم ظاهر رو باید حفظ کرد هم باطن رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 817.11,
   "end": 821.45,
   "text": "مشکلاتی که پیش اومده عزیزان دلم اینه که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 821.45,
   "end": 824.13,
   "text": "یا دچار ظاهریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 824.13,
   "end": 828.71,
   "text": "که حالا مسلمان‌های دو آتیشه مقدس‌نما و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 828.71,
   "end": 834.43,
   "text": "و باطن رو تعطیل کردیم یعنی کار عقلی نمی‌کنیم، دنبال علوم معارف نمی‌ریم یا صرفا دچار باطنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 834.43,
   "end": 836.85,
   "text": "القا-- عرفان‌های حلقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 836.85,
   "end": 844.33,
   "text": "عرفان‌های حلقه، عرفان‌های نوظهور، ادعاهای آنچنانی به بیراهه کشوندن جوون‌ها خصوصا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 844.33,
   "end": 850.17,
   "text": "که نفس ناطقه خصوصا تو جوونی یه مقدار بهش سختی بگیری سریع جرقه می‌خوره، آتش می‌گیره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 850.17,
   "end": 854.89,
   "text": "شعله‌ور می‌شه. از خودش یه حقایقی بروز می‌ده گول می‌خورن سریع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 854.89,
   "end": 858.53,
   "text": "یا اینکه نه هر دو تاش تعطیله. نه باید هر دو باید با هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 858.53,
   "end": 860.21,
   "text": "هم ظاهر دین، هم باطن دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 860.21,
   "end": 863.99,
   "text": "لکن اونچه که پایه‌ی ظاهر دینه، باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 863.99,
   "end": 867.21,
   "text": "این ظاهر از دل باطن ظهور کرده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 867.21,
   "end": 870.47,
   "text": "اصلا این ظاهر ظهور باطنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 870.47,
   "end": 875.95,
   "text": "و اگر کسی باطن رو توجه نکنه یعنی قلبش منغمر باشه، بی‌خبر باشه از باطن عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 875.95,
   "end": 878.59,
   "text": "ظاهرش هم توخالیه، ظاهرش هم به درد نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 878.59,
   "end": 882.15,
   "text": "یک مسلمان توخالی، بی‌اندیشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 882.15,
   "end": 885.11,
   "text": "بی‌عقل، بی‌لب، بی‌مغز به چه درد می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 885.11,
   "end": 889.31,
   "text": "إن في خلق السماوات والأرض واختلاف الليل والنهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 889.31,
   "end": 892.73,
   "text": "لآيات اینا قطعاً آیات الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 892.73,
   "end": 896.93,
   "text": "لأولي الألباب برای اونایی که لب دارن، مغز دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 896.93,
   "end": 899.83,
   "text": "و همینان که الذين يذكرون الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 899.83,
   "end": 902.81,
   "text": "قيما وقعودا وعلى جنوبهم اینا اهل ذکر‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 902.81,
   "end": 906.13,
   "text": "نه اونی که تسبیح دستشونه مقدس مقابی راه می‌ندازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 906.13,
   "end": 912.61,
   "text": "جسارت نشه. اون‌هایی که از فکر به ذکر می‌رسن به قول علامه اونا به اصل ذکر رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 912.61,
   "end": 915.37,
   "text": "اونا به اصل علم و معرفت دسترسی پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 915.37,
   "end": 921.97,
   "text": "بعد دوباره تصریح می‌کنه همینا که يذكرون الله هستند و يتفكرون في خلق السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 921.97,
   "end": 929.27,
   "text": "حالا شما ببینید متأسفانه هرچی اهل ذکر رو ما دور و برمون می‌بینیم از همین بچه‌های مرسوم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 929.27,
   "end": 933.11,
   "text": "حالا چه عرض کنم متعارف به مذهبیون این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 933.11,
   "end": 938.39,
   "text": "اصلا عقل رو تعطیل کردن. تا دو کلمه حرف عقلی و سنگین و وزین می‌زنی د فرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 938.39,
   "end": 940.49,
   "text": "الفرار. خب به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 940.49,
   "end": 945.53,
   "text": "فرار به کجا؟ ففر الى الله به سمت الله حرکت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 945.53,
   "end": 948.39,
   "text": "الله حالا چیه؟ یه رساله‌ی سه جلدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 948.39,
   "end": 951.97,
   "text": "کتاب سه جلدیه. الله شناسی علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 951.97,
   "end": 957.43,
   "text": "آستاد محمد حسین ت-- حسینی تهرانی باید بخونی تا بشناسی الله چی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 957.43,
   "end": 961.17,
   "text": "همین. حالا بعد از الله بی‌خبری بعد میگی الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 961.17,
   "end": 963.81,
   "text": "خب چه فهمیدی؟ چی گفتی؟ الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 963.81,
   "end": 966.91,
   "text": "کیست؟ چیست؟ اون اولین اسمی که منتشر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 966.91,
   "end": 971.11,
   "text": "بعد از اون کانال وجودی رب انتشار پیدا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 971.11,
   "end": 975.43,
   "text": "که تو از همون طریق ارتزاق می‌کنی رزقت رو از الله می‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 975.43,
   "end": 982.23,
   "text": "مرتبه الوهیت وجود است و بدون ارتباط با او امکان نداره انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 982.23,
   "end": 984.69,
   "text": "به-- با ذات خدا مرتبط بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 984.69,
   "end": 987.77,
   "text": "بت-بتوان با باطن عالم ارتباط گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 987.77,
   "end": 991.05,
   "text": "حالا بحث‌هایی که گذشته و خواهد گذشت انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 991.05,
   "end": 993.59,
   "text": "پس قلب منغرب-- منغمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 993.59,
   "end": 997.93,
   "text": "قلبی که بی‌خبر است به شدت خطرناک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 997.93,
   "end": 1004.81,
   "text": "متأسفانه اکثر ضرباتی که اهل ایمان خوردن از جهال و مقدسین می‌خوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1004.81,
   "end": 1006.81,
   "text": "که فارغ از باطن دین شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1006.81,
   "end": 1012.13,
   "text": "اینو یادمون باشه. امروز درسی که گرفتیم از حضرت علامه علیزاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1012.13,
   "end": 1014.77,
   "text": "استاد استاد بزرگ ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1014.77,
   "end": 1018.35,
   "text": "علامه شهرانی این بود که به باطن دین رجوع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1018.35,
   "end": 1022.61,
   "text": "اهل کار عقلی باشیم. غذای عقلی برداریم از نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1022.61,
   "end": 1025.33,
   "text": "در هر چیزی تأمل و تفکر کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1025.33,
   "end": 1028.65,
   "text": "که اگر بی‌خبر باشیم باختیم عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1028.65,
   "end": 1032.83,
   "text": "و هر مقدار که ما بی‌خبریم بعد از مرگ میخوان ما رو باخبر کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1032.83,
   "end": 1036.63,
   "text": "این باخبر کردن ما پس از مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1036.63,
   "end": 1039.27,
   "text": "الا ماشاءالله مواقف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1039.27,
   "end": 1043.71,
   "text": "مواقف که حالا همون سیر برزخی، سیر تکامل برزخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1043.71,
   "end": 1045.73,
   "text": "و حالا به یک معنا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1045.73,
   "end": 1048.25,
   "text": "می‌شود عذاب برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1048.25,
   "end": 1051.39,
   "text": "سختی-- پوستت کنده میشه تا اینا رو اونجا متوجه بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1051.39,
   "end": 1057.91,
   "text": "اینجا خیلی راحت‌تره. عزیزان فصل الخطاب امروز این باشه همینطور که اگر اینجا مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1057.91,
   "end": 1065.75,
   "text": "یک در-- یک رکعت نماز هزار درجه بالا ببرد، اونور هزار رکعت نماز یک درجه بالا می‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1065.75,
   "end": 1069.99,
   "text": "اینجا هم همینطور یک فهم علمی، یک درک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1069.99,
   "end": 1077.05,
   "text": "یک کشف علمی و چشیدن حقایق اینجا اگر هزار درجه بالا ببرد، اون طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1077.05,
   "end": 1082.13,
   "text": "باید چه کنی؟ هزاران کلمه‌ی وجودی رو پوستت کنده بشه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1082.13,
   "end": 1085.51,
   "text": "هزاران بار با اصرار و التجا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1085.51,
   "end": 1090.55,
   "text": "با سختی و عذاب بچشی و بفهمی تا یک درجه بالا بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1090.55,
   "end": 1092.69,
   "text": "انشاالله که خدا به ما رحم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1092.69,
   "end": 1098.51,
   "text": "یا ارحم الراحمین، يا دليل المتحيرين، يا غياث المستغيثين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1098.51,
   "end": 1100.67,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1100.67,
   "end": 1116.13,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1116.13,
   "end": 1118.99,
   "text": "على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1118.99,
   "end": 1122.93,
   "text": "وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1122.93,
   "end": 1126.15,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1126.15,
   "end": 1129.05,
   "text": "على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1129.05,
   "end": 1134.93,
   "text": "وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1134.93,
   "end": 1137.07,
   "text": "اللهم صل على محمد وآل محمد. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1137.07,
   "end": 1139.49,
   "text": "صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1139.49,
   "end": 1144.01,
   "text": "محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}