 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 4.9,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.9,
   "end": 9.52,
   "text": "السلام علیک یا داعی الله و ربانیة آiate.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.52,
   "end": 11.6,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.6,
   "end": 17.42,
   "text": "استفتای دیگری که پیرامون نماز جماعت البته در اقتداء به اهل تسنن هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.42,
   "end": 23.6,
   "text": "اینه که پرسیدن وقتی تو نمازهای اونها شرکت می‌کنیم تو نماز جماعتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.6,
   "end": 29.82,
   "text": "اگه در بعضی از موارد مثل اونا عمل کنیم مثلا دست بسته نماز بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.82,
   "end": 35.4,
   "text": "یا رعایت وقت رو دقیق نکنیم یا بر فرش سجده کنیم و اینها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.4,
   "end": 39.12,
   "text": "آیا این نمازها احتیاج دارند به اعاده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.12,
   "end": 42.34,
   "text": "رهبر عزیز فرمودن که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.34,
   "end": 46.0,
   "text": "حفظ وحدت ایجاب کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.0,
   "end": 51.56,
   "text": "اون کارها رو انجام بدید، مقتضای این عمل باشه، فرمودن نماز صحیحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.56,
   "end": 56.04,
   "text": "و اجازه‌ش هست حتی اگر سجده بر فرش و مانند اونها باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.04,
   "end": 58.04,
   "text": "ولی دست بسته خوندن جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.04,
   "end": 62.4,
   "text": "اونم باز فرمودن مگر اینکه ضرورت اون رو اقتضا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.4,
   "end": 65.54,
   "text": "ضرورت حالا حفظ وحدت و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.54,
   "end": 68.12,
   "text": "اما بحث ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.12,
   "end": 70.76,
   "text": "ادامه‌ی بحث قلب منغمر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.76,
   "end": 75.62,
   "text": "قلب بی‌خبر؛ رسیده بودیم به اینجا که عرض کردیم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.62,
   "end": 83.04,
   "text": "از ظاهر قرآن هم بی‌خبریم چه برسه به باطن قرآن و البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.04,
   "end": 90.36,
   "text": "به عنوان نمونه از تفسیر نمونه‌های مکارم و گروه عزیزشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.36,
   "end": 94.38,
   "text": "مطالبی رو پیرامون اعجاز از قرآن، اعجاز علمی قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.38,
   "end": 102.92,
   "text": "بیان می‌کردیم. سومین نکته‌ای که پیرامون اعجاز علمی قرآن میگیم که ما بی‌خبر هستیم ازش متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.92,
   "end": 105.68,
   "text": "و جالبه که شما بدونید اخیراً با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.68,
   "end": 109.16,
   "text": "بعضی جوونایی که اصلاً نماز رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.16,
   "end": 117.82,
   "text": "نماز نمی‌خوندن و افکارشون متأسفانه به سمت ماده‌گری و ماده‌گرایی و ماتریالیسم و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.82,
   "end": 120.84,
   "text": "با اینکه ظاهراً مسلمونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.84,
   "end": 122.8,
   "text": "متوجه شده بود و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.8,
   "end": 125.92,
   "text": "از همین اعجاز علمی قرآن چند تا گفتم انقدر براشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.92,
   "end": 131.62,
   "text": "شیرین بود که گفتن حاجی هرچی از این مسائل داری بیا برای ما رو کن خیلی برامون جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.62,
   "end": 134.48,
   "text": "حالا انشاالله ما بی‌خبر نمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.48,
   "end": 139.3,
   "text": "یکی دیگه از اون آیاتی که از قرآن در قرآن عزیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.3,
   "end": 143.44,
   "text": "پیرامون اعجاز علمی قرآن الان مشخص شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.44,
   "end": 148.12,
   "text": "و اون موقع بی‌خبر بودند مردم، آیات سی و هشت تا چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.12,
   "end": 152.26,
   "text": "Surah شریف یسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.26,
   "end": 157.5,
   "text": "اونجا می‌فرماید \"والشمس تجری لمستقر لها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.5,
   "end": 165.64,
   "text": "که این خورشید رو داره بیان خورشید رو می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.64,
   "end": 167.62,
   "text": "یه در، در یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.62,
   "end": 170.72,
   "text": "مداری، یک استقراری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.72,
   "end": 172.66,
   "text": "تو یه قرارگاهی روانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.66,
   "end": 175.6,
   "text": "\"لمستقر لها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.6,
   "end": 179.42,
   "text": "خورشید که تا قرارگاهش روانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.42,
   "end": 182.96,
   "text": "\"ذلك تقدير العزيز العليم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.96,
   "end": 187.52,
   "text": "می‌فرماید این تقدیر خدای عزیز و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.52,
   "end": 190.68,
   "text": "داناست. یعنی این اندازه‌گیری خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.68,
   "end": 193.78,
   "text": "چه شیرین، چه جالب. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.78,
   "end": 199.24,
   "text": "ادامه که \"والقمر قدرناه منازلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.24,
   "end": 202.26,
   "text": "حتى کل العرجون القديم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.26,
   "end": 209.22,
   "text": "و بحث ماه رو مطرح می‌کنه که ما هم براش منزلگاه‌هایی قرار دادیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.22,
   "end": 214.6,
   "text": "که تا اینکه مثل شاخک دیرینه یا اون قوس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.6,
   "end": 218.56,
   "text": "قوسی شکل زرد رنگ به اون، به اون حالت بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.56,
   "end": 222.74,
   "text": "\"کل العرجون القديم لا الشمس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.74,
   "end": 231.24,
   "text": "ينبغي لها ان تدرک القمر ولا الليل سابق النهار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.24,
   "end": 235.72,
   "text": "یعنی نه خورشید براش سزاواره که ماه رو در بیابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 235.72,
   "end": 239.08,
   "text": "و نه شب بر روز پیشی می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.08,
   "end": 241.96,
   "text": "و البته \"و کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.96,
   "end": 244.9,
   "text": "فی فلك یسبحون\". به به، به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.9,
   "end": 247.56,
   "text": "در حالی که هر یک در مداری شناورند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.56,
   "end": 251.96,
   "text": "الله اکبر از این عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.96,
   "end": 254.84,
   "text": "حتی در حسب ظاهر این آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.84,
   "end": 257.26,
   "text": "حالا دقت بفرمید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.26,
   "end": 264.34,
   "text": "نکته علمی که اینجا حالا در حد وسع جلسه ما اقتضا می‌کنه عرض کنیم چه شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.34,
   "end": 273.58,
   "text": "اون روزی که این آیات نازل شد بازم عرض می‌کنیم که فرضیه هیت بطلمیوس با قدرت هرچه تمام بر همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.58,
   "end": 276.64,
   "text": "مفا-- محافل علمی اون موقع حاکم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.64,
   "end": 279.2,
   "text": "خب طبق این فرضیه بطلمیوس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.2,
   "end": 285.62,
   "text": "اجرام آسمانی به خودی خودشون گردشی نداشتند بلکه در دل افلاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.62,
   "end": 291.74,
   "text": "که اجسامی بلورین و اینها بودند و مثل طبقات پوست پیازی رو هم متمارک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.74,
   "end": 294.24,
   "text": "متراکم شده بودند اینها میخ‌کوب شده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 294.24,
   "end": 297.26,
   "text": "این‌ها رو که حالا اجمالاً قبلاً گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.26,
   "end": 306.2,
   "text": "و همچنین حرکت اون‌ها تابع حرکت افلاک‌شون بوده که در علم نجوم هیت اینا مورد بررسی قرار گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 306.2,
   "end": 308.92,
   "text": "و اون فرضیه‌های اون موقع هم بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.92,
   "end": 311.8,
   "text": "در رابطه باهاش خیلی بحث شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 311.8,
   "end": 319.44,
   "text": "حالا بنابراین اون روز نه شناور بودن خورشید مفهومی داشت، نه حرکت طولی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 319.44,
   "end": 322.28,
   "text": "نه حرکت جریانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 322.28,
   "end": 327.76,
   "text": "اما بعد از اینکه این حالا پایه‌های فرضیه بطلمیوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 327.76,
   "end": 329.9,
   "text": "البته اونم در پرتو کشفیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.9,
   "end": 336.08,
   "text": "قرون اخیر و این آزاد شدن اجرام آسمانی از قید و بند افلاک بلورین و اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 336.08,
   "end": 342.26,
   "text": "اون فرضیه بطلمیوس فروپاشی براش رخ داد و فروریخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 342.26,
   "end": 346.54,
   "text": "این نظریه قدرت گرفت که خورشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.54,
   "end": 350.56,
   "text": "در مرکز منظومه شمسی ثابت و بی‌حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 350.56,
   "end": 354.76,
   "text": "یعنی بعد از اون به این سمت رفتن اندیشمندان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 354.76,
   "end": 357.46,
   "text": "در علم نجوم و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 357.46,
   "end": 361.5,
   "text": "که گمان کردند که نه خورشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 361.5,
   "end": 368.04,
   "text": "ثابت و بی‌حرکته و تمام منظومش، منظومه شمسی پروانه‌وار دارن به دورش می‌چرخن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 368.04,
   "end": 370.74,
   "text": "و اینجا بود که باز مفهوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 370.74,
   "end": 374.96,
   "text": "حالا مثلا اون تعبیرات آیات فوق که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 374.96,
   "end": 379.1,
   "text": "که حرکت طولی و دَورانی رو به خورشید نسبت میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 379.1,
   "end": 382.2,
   "text": "باز اونجا روشن نبود. با اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 382.2,
   "end": 385.92,
   "text": "چهارچوب فرض، فرضیه بطلمیوس ریخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 385.92,
   "end": 387.94,
   "text": "پایه‌هاش ریخت اما باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.94,
   "end": 392.68,
   "text": "یه اشتباه فاحشی داشتن اهل هیئت و نجوم به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.68,
   "end": 397.76,
   "text": "ولی روشن نبود تا اینکه باز علم که پیشرفت کرد ادامه داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 397.76,
   "end": 399.72,
   "text": "اکتشافات، اختراعات اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 399.72,
   "end": 402.02,
   "text": "خصوصا در علم نجوم و هیئت؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 402.02,
   "end": 405.58,
   "text": "اون موقع حرکت‌هایی برای خورشید ثابت شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 405.58,
   "end": 409.3,
   "text": "از قبیل مثلا حرکت وضعی اون به دور خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.3,
   "end": 414.68,
   "text": "که اینا اون موقع که ثابت نشده بود مثلا اون موقع دربارش حرفی زده نشده بود جز در این آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 414.68,
   "end": 418.5,
   "text": "یا مثلا حرکت طولی اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 418.5,
   "end": 427.36,
   "text": "طولی خورشید همراه منظومه شمسی که به سوی یه نقطه مشخصی از آسمونه بهش میگن حرکت طولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 427.36,
   "end": 431.9,
   "text": "یا مثلا حرکت دَورانی خورشید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 431.9,
   "end": 437.74,
   "text": "این حرکت دَورانی همراه مجموعه کهکشانیه که جزئی از اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 437.74,
   "end": 441.24,
   "text": "همین‌طور بعد از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 441.24,
   "end": 448.06,
   "text": "حالا کشف حرکت‌های عجیب و غریب و جدید، وضعی، طولی، دَورانی اینها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 448.06,
   "end": 451.98,
   "text": "معجزات علمی قرآن بیشتر به اثبات رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 451.98,
   "end": 458.46,
   "text": "حالا برای اینکه این اعجاز علمی اینجا تا همین جایی که عرض کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 458.46,
   "end": 461.58,
   "text": "تا همین جای بحث بهتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 461.58,
   "end": 464.5,
   "text": "مورد توجه شما قرار بگیره عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 464.5,
   "end": 471.5,
   "text": "که الحمد لله دست به قلم و تحقیق و اینا هم هستید که م-ما منابع رو هم عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 471.5,
   "end": 474.0,
   "text": "آنچه که داریم عرض می‌کنیم فعلاً از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 474.0,
   "end": 477.22,
   "text": "تفسیر نمونه و موارد مشابه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 477.22,
   "end": 481.88,
   "text": "لکن اجازه بفرمایید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 481.88,
   "end": 490.06,
   "text": "ما از یه دایرة المعارفی پیرامون حرکت خورشید برای شما چند تا جمله از رو بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 490.06,
   "end": 496.06,
   "text": "که مطالب ارزشمند و جالبی در این دایرة المعارف هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 496.06,
   "end": 499.84,
   "text": "مثلا یک بخشیش رو براتون بخونم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 499.84,
   "end": 503.86,
   "text": "می‌فرماید خورشید دارای حرکات ظاهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 503.86,
   "end": 507.82,
   "text": "یعنی همون حرکت یومی و حرکت سالیانه منظورش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 507.82,
   "end": 511.48,
   "text": "و حرکت یا حرکات واقعی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 511.48,
   "end": 518.76,
   "text": "خورشید در حرکت یومی و حرکت ظاهری کره آسمان شرکت دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 518.76,
   "end": 520.62,
   "text": "یعنی یه چیز مجزایی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 520.62,
   "end": 523.64,
   "text": "در نیم‌کره ما از مشرق طلوع می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 523.64,
   "end": 530.26,
   "text": "در طرف جنوب از نصف النهار محل می‌گذرد و در مغرب غروب می‌نماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 530.26,
   "end": 532.62,
   "text": "عبور آن از نصف النهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 532.62,
   "end": 537.72,
   "text": "یعنی همون ظهر حقیقی رو مشخص می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 537.72,
   "end": 542.78,
   "text": "خورشید حرکت ظاهری یعنی همون سالیانه‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 542.78,
   "end": 552.4,
   "text": "حرکت ظاهری سالیانه‌ای به دور زمین نیز دارد که هر روز آن را نزدیک یک درجه از مغرب به طرف مشرق می‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 552.4,
   "end": 558.26,
   "text": "در این حرکت خورشید سالی یک بار از مقابل برج‌ها می‌گذرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 558.26,
   "end": 562.12,
   "text": "مدار این حرکت در صفحه دایرة البروج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 562.12,
   "end": 568.8,
   "text": "واقع است. این حرکت در تاریخ نجوم اهمیت فراوان داشته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 568.8,
   "end": 571.88,
   "text": "اعتدالین و انقلاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 571.88,
   "end": 577.96,
   "text": "میل کلی مربوط اون، به اونه و سال شمسی هم مبترین برای همون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 577.96,
   "end": 580.32,
   "text": "علاوه بر این حالا ادامه همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 580.32,
   "end": 582.04,
   "text": "متن دایرة المعارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 582.04,
   "end": 585.24,
   "text": "علاوه بر این حرکات ظاهری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 585.24,
   "end": 588.46,
   "text": "حرکت دَورانی کهکشان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 588.46,
   "end": 596.46,
   "text": "خورشید را با سرعت حدود یک میلیون و یکصد و سی هزار کیلومتر در ساعت در فضا می‌گرداند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 596.46,
   "end": 598.84,
   "text": "چی؟ همون حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 598.84,
   "end": 602.6,
   "text": "دَورانی کهکشان یا همون حرکت ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 602.6,
   "end": 605.64,
   "text": "اما در داخل کهکشان ثابت نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 605.64,
   "end": 610.86,
   "text": "بلکه با سرعتی قریب هفتاد و دو هزار و چهارصد کیلومتر در ساعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 610.86,
   "end": 613.28,
   "text": "به جانب صورت فلکی حرکت می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 613.28,
   "end": 618.54,
   "text": "و اینکه ما از این حرکت سریع خورشید در فضا بی‌خبریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 618.54,
   "end": 626.24,
   "text": "به سبب دوری اجرام فلکی‌ست که مأخذ تشخیص این حرکت وضعی خاص نیز هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 626.24,
   "end": 629.04,
   "text": "دوره حرکت وضعی خورشید در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 629.04,
   "end": 633.08,
   "text": "استوای آن حدود بیست و پنج شبانه روز می‌باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 633.08,
   "end": 635.54,
   "text": "حالا تو همون مدرک که عرض کردیم این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 635.54,
   "end": 639.92,
   "text": "الان براتون خوندیم. اما یه بررسی داشته باشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 639.92,
   "end": 642.72,
   "text": "ببینید عزیزان چند تا نکته عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 642.72,
   "end": 651.66,
   "text": "اولا در خصوص انطباق حرکت‌های خورشید با آیات مورد بحث چند تا تذکر لازمه که بدونید عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 651.66,
   "end": 657.22,
   "text": "نکته اول. سه تا احتمال در کلمه مستقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 657.22,
   "end": 662.5,
   "text": "وجود داره. حالا مَضرِ میمی اسم مکان و اسم زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 662.5,
   "end": 667.46,
   "text": "همچنین چند احتمال هم در معنای لام در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 667.46,
   "end": 669.6,
   "text": "لمستقر وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 669.6,
   "end": 674.54,
   "text": "تو همون آیاتی که عرض کردیم. به معنی الا، فی و به معنی غایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 674.54,
   "end": 678.3,
   "text": "همچنین در مورد کلمه جریان هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 678.3,
   "end": 684.62,
   "text": "چهار احتمال وجود داره. حرکت انتقالی طولی، حرکت وضعی، ادامه حیات زمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 684.62,
   "end": 686.28,
   "text": "و حرکت درونی خورشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 686.28,
   "end": 688.62,
   "text": "حالا اینا رو شما ضرب در هم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 688.62,
   "end": 692.46,
   "text": "اون سه تا احتمال، اونم سه تا احتمال، اینم چهار تا احتمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 692.46,
   "end": 699.06,
   "text": "مجموعا ترکیب، حالا با ترکیبات که بین این احتمالات رخ میده سی و شش احتمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 699.06,
   "end": 703.42,
   "text": "در معنای آیه که مورد بحث بود متصور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 703.42,
   "end": 706.4,
   "text": "که ممکنه همه این احتمال‌ها هم مورد آیه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 706.4,
   "end": 711.18,
   "text": "مراد آیه همه اینا باشه. الله اعلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 711.18,
   "end": 714.8,
   "text": "پس این احتمال هم وجود داره که این جریان یا اون حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 714.8,
   "end": 720.34,
   "text": "دیگری هم که برای خورشید وجود داشته باشه و ما بی‌خبریم و هنوز کشف نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 720.34,
   "end": 723.64,
   "text": "این احتمال هم وجود داره و اون هم مراد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 723.64,
   "end": 728.44,
   "text": "همونطور که امیرالمؤمنین یا پیغمبر فرمودن یا امام صادق، امام باقر بارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 728.44,
   "end": 736.86,
   "text": "به الفاظ مختلف اما با یک مضامین که حالا هر آیه، هر حرف آیات قرآن هفتاد هزار معنا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 736.86,
   "end": 740.82,
   "text": "می‌تونه این آیات هم به حرکت‌های گسترده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 740.82,
   "end": 744.88,
   "text": "ااا ما-ما رو متوجه کرده باشه و اشاره به اون‌ها باشه و ما بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 744.88,
   "end": 748.62,
   "text": "چگونه‌ست که اون موقع از این حرکت‌های فعلی که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 748.62,
   "end": 753.66,
   "text": "کشف شده همه بی‌خبر بودن اما اون موقع قرآن ازش حرف زده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 753.66,
   "end": 758.08,
   "text": "البته نمی‌شه به طور قطعی گفت که مقصود آیه یکی از این احتمالاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 758.08,
   "end": 761.4,
   "text": "نمی‌شه قطعاً گفت و مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 761.4,
   "end": 766.54,
   "text": "دیگر احتمالات شناخته شده یا مثلاً نشده یا کشف شده یا نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 766.54,
   "end": 768.78,
   "text": "یا مثلاً اونا رو بگیم که نفی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 768.78,
   "end": 771.32,
   "text": "بگیم مثلاً اینا نیست یا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 771.32,
   "end": 778.06,
   "text": "در صورت کلی حالا ظاهر آیات آیه سی و هفت تا چهل سوره یس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 778.06,
   "end": 781.08,
   "text": "می‌شه گفت به این معنا که همه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 781.08,
   "end": 784.88,
   "text": "همشون همون معنای حرکت دورانی خورشید رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 784.88,
   "end": 787.04,
   "text": "توی مدار ثابت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 787.04,
   "end": 789.82,
   "text": "دارن بیان می‌کنند با تأکید بر چه واژه‌ای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 789.82,
   "end": 792.6,
   "text": "یسبحون. کل فی فلاک یسبحون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 792.6,
   "end": 796.18,
   "text": "این یه نکته. نکته دوم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 796.18,
   "end": 803.64,
   "text": "حرکت انتقالی خورشید عزیزان توجه بکنن به طرف یک مکان نامعلومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 803.64,
   "end": 806.02,
   "text": "و می‌شه از کلمه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 806.02,
   "end": 809.26,
   "text": "لمستقر لها استفاده کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 809.26,
   "end": 816.9,
   "text": "که حالا این بالاخره به یک مکانی هست، به یک سمتی هست، به یک طرفی هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 816.9,
   "end": 820.12,
   "text": "به یک قرارگاه و مستق-- جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 820.12,
   "end": 823.5,
   "text": "استقراری هست که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 823.5,
   "end": 828.18,
   "text": "ااا ما نمی‌تونیم این رو تحمیل بر آیه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 828.18,
   "end": 830.86,
   "text": "که بگیم مثلاً اون مکان کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 830.86,
   "end": 834.84,
   "text": "کجای آسمونه اینا. ولی قطعاً به یک مکانی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 834.84,
   "end": 840.16,
   "text": "اما توجه داشته باشید ما نمی‌تونیم مکان‌های حدسی خودمون رو به قرآن نسبت بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 840.16,
   "end": 847.58,
   "text": "مهم اینجاست که بدونیم بالاخره مکان‌هایی هست، یک محل استقراری هست که لمستقر-لمستقر لها می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 847.58,
   "end": 851.0,
   "text": "نکته بعدا-بعدی یا سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 851.0,
   "end": 859.12,
   "text": "توجه به این موضوعه که ااا اونم اشارات صریح قرآن به حرکت خورشیده که البته هر کدومش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 859.12,
   "end": 862.88,
   "text": "از یک معنی و معانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 862.88,
   "end": 866.56,
   "text": "حرکت و جریان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 866.56,
   "end": 871.76,
   "text": "بخواهیم اونو در نظر بگیریم از مطالب علمی قرآن و نوعی رازگویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 871.76,
   "end": 874.9,
   "text": "پرده‌برداری کرده. یعنی بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 874.9,
   "end": 878.2,
   "text": "از اون معانی حرکت و جریان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 878.2,
   "end": 882.16,
   "text": "در حرکت خورشید داره پرده‌برداری می‌کنه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 882.16,
   "end": 890.18,
   "text": "لذا قرآن تو زمانی اینو توجه بکنید تو زمانی از مدار یا همون فلک خورشید و جریان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 890.18,
   "end": 892.98,
   "text": "و حرکت واقعی سخن گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 892.98,
   "end": 897.36,
   "text": "که عرض شد هیئت بطلمیوسی فقط همین حرکت کاذب رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 897.36,
   "end": 906.14,
   "text": "رسمیت می‌شناخت و این مطلب عظمت علمی قرآن و البته آورنده او رو یعنی نبی اکرم اسلام رو می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 906.14,
   "end": 909.38,
   "text": "نکته دیگه هم توجه بکنیم. اونم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 909.38,
   "end": 915.24,
   "text": "در مورد اینکه آیا این اشارات علمی قرآن اعجاز علمی اونو ثابت می‌کنند یا خیر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 915.24,
   "end": 918.0,
   "text": "میشه به تفصیل قائل شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 918.0,
   "end": 924.54,
   "text": "بالاخره به این معنی که بگیم بخشی از این حرکت‌ها قبلاً توسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 924.54,
   "end": 927.1,
   "text": "کتاب مقدس گزارش نشده بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 927.1,
   "end": 932.74,
   "text": "بله، در کتاب‌های مقدس قدیم اشاراتی شده بوده اما نه به همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 932.74,
   "end": 935.24,
   "text": "و قرآن اومده همه رو گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 935.24,
   "end": 939.24,
   "text": "مثلاً ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 939.24,
   "end": 944.16,
   "text": "اونچه که مثلاً در کتاب مقدس ازش خبر داده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 944.16,
   "end": 946.5,
   "text": "همون جمله‌ایه که میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 946.5,
   "end": 949.12,
   "text": "و خورشید پهل ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 949.12,
   "end": 953.5,
   "text": "و خورشید مثل پهلوان از دویدن در میدان شادی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 953.5,
   "end": 956.72,
   "text": "این تو کتاب مقدس، همون کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 956.72,
   "end": 959.72,
   "text": "مزامیر اومده اونجا این جمله که میگه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 959.72,
   "end": 962.84,
   "text": "خورشید مثل پهلوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 962.84,
   "end": 964.86,
   "text": "از دویدن در میدان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 964.86,
   "end": 967.34,
   "text": "شادی می‌کند. خب از این جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 967.34,
   "end": 971.92,
   "text": "فقط حرکت انتقالی دورانی خورشید رو می‌شه استفاده کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 971.92,
   "end": 976.28,
   "text": "چرا؟ خب معلومه که پهلوونا تو میدان به طرف جلو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 976.28,
   "end": 978.58,
   "text": "و به صورت دورانی می‌دوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 978.58,
   "end": 983.76,
   "text": "همین یک حرکت ازش می‌شه برداشت بشه، نه حرکت‌های دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 983.76,
   "end": 991.74,
   "text": "خب اما حرکتای دیگه مثل حرکت انتقالی طولی، حرکت وضعی، حرکت زمانی، حرکت دورانی خورشید و اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 991.74,
   "end": 994.74,
   "text": "اینا همه از ابتکارات قرآنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 994.74,
   "end": 997.76,
   "text": "عرض شد که اینها همه با همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 997.76,
   "end": 1001.56,
   "text": "نگاهی که داریم اعجاز علمی قرآن رو ثابت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1001.56,
   "end": 1007.78,
   "text": "خب. اما تو همین حالا نکات دیگه‌ای هم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1007.78,
   "end": 1010.16,
   "text": "اجازه بدید که جلسات بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1010.16,
   "end": 1015.36,
   "text": "تا همین مقدار بسنده می‌کنیم در این جلسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1015.36,
   "end": 1020.08,
   "text": "تازه این‌ها اون علومی‌ست که به دست ما رسیده و علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1020.08,
   "end": 1024.58,
   "text": "فعلی به این‌ها دسترسی پیدا کرده بخشی از اون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1024.58,
   "end": 1028.44,
   "text": "و الا حالا شما ببینید تا وقتی که امام عصر عجل الله تعالی تشریف بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1028.44,
   "end": 1031.56,
   "text": "اگرچه انهم یره عموه بعیدا ونراه قریبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1031.56,
   "end": 1033.94,
   "text": "اونا دور می‌دونن ما نزدیک. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1033.94,
   "end": 1037.48,
   "text": "بالاخره تا وقتی که آقا بیاد با این همه پیشرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1037.48,
   "end": 1040.02,
   "text": "و توسعه علمی و تولید علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1040.02,
   "end": 1046.58,
   "text": "باز دیگه حدیث شریف رو می‌دونید بیست و هفت حرف علم رو در نظر بگیرید، همه علوم رو جمع کنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1046.58,
   "end": 1053.68,
   "text": "تا اون موقع که حضرت بیاد از اول آدم تا اون موقع کلاً به دو حرف از این حروف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1053.68,
   "end": 1058.4,
   "text": "دسترسی پیدا می‌کنند که بیست و پنج حرف علم در سینه مبارک حضرت خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1058.4,
   "end": 1061.16,
   "text": "ببینید چه خبر و چه غوغایی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1061.16,
   "end": 1063.26,
   "text": "که وقتی حضرت تشریف بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1063.26,
   "end": 1069.44,
   "text": "یا حالا خیلی زشته که ما در یه همچین دینی و با داشتن یه همچین آقایی و یه همچین کتابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1069.44,
   "end": 1072.1,
   "text": "که صورت کتبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1072.1,
   "end": 1078.32,
   "text": "انسان کامل است بی‌خبر باشیم حداقل از این علوم ظاهری و اعجاز قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1078.32,
   "end": 1080.34,
   "text": "انشاالله خدا همه ما رو آگاه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1080.34,
   "end": 1083.0,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1083.0,
   "end": 1085.86,
   "text": "اللهم صل على،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1085.86,
   "end": 1088.4,
   "text": "على رسول الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1088.4,
   "end": 1093.08,
   "text": "على رسول الله وآله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1093.08,
   "end": 1095.88,
   "text": "اللهم صل على،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1095.88,
   "end": 1101.14,
   "text": "على رسول الله، على رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1101.14,
   "end": 1103.22,
   "text": "وآله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
