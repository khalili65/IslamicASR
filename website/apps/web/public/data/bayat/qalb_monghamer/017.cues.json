   "start": 12.38,
   "end": 62.5
  },
  {
   "index": 1,
   "title": "## ادامهٔ قلبِ منغمر؛ معدودة‌الله و قرآن",
   "start": 62.5,
   "end": 95.32
  },
  {
   "index": 2,
   "title": "## آیهٔ دهمِ لقمان؛ ستون‌های نادیدنی",
   "start": 95.32,
   "end": 192.62
  },
  {
   "index": 3,
   "title": "## حدیثِ امام رضا؛ ثَمَّ عَمَدٌ وَلَکِنْ لَا تَرَوْنَهَا",
   "start": 192.62,
   "end": 281.12
  },
  {
   "index": 4,
   "title": "## دو نکته در تفسیرِ بغیر عمد ترونها",
   "start": 281.12,
   "end": 448.93
  },
  {
   "index": 5,
   "title": "ادامهٔ آیه چنین است:",
   "start": 448.93,
   "end": 468.93
  },
  {
   "index": 6,
   "title": "## آیهٔ رعد و قدرِ متیقنِ آسمانِ مادی",
   "start": 468.93,
   "end": 548.05
  },
  {
   "index": 7,
   "title": "## آیهٔ چهل‌ویکمِ فاطر؛ إمساكِ آسمان و زمین",
   "start": 548.05,
   "end": 766.87
  },
  {
   "index": 8,
   "title": "## منبعِ تکمیلی",
   "start": 766.87,
   "end": 851.07
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.92,
   "end": 4.84,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.84,
   "end": 8.62,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.62,
   "end": 12.38,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.38,
   "end": 18.34,
   "text": "آیا بر امام جمعه کسب اجازه از حاکم شهر واجبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.34,
   "end": 22.52,
   "text": "و مورد از حاکم شهر چه کسیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.52,
   "end": 28.1,
   "text": "و آیا این حکم در شهرهای دوردست هم جاریه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.1,
   "end": 37.68,
   "text": "رهبر عزیز فرمودند که اصل جواز امامت برای اقامه نما-- اقامه نماز جمعه متوقف بر این اجازه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.68,
   "end": 41.36,
   "text": "ولی ترتب احکام نصب وی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.36,
   "end": 44.12,
   "text": "یعنی نصب امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.12,
   "end": 52.96,
   "text": "جمعه برای امام جمعه متوقف بر این است که منسوب از طرف ولی امر مسلمین باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.96,
   "end": 59.2,
   "text": "و این حکم شامل هر سرزمین و شهری که ولی امر مسلمین در آن حاکم و متصاح است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 59.2,
   "end": 61.92,
   "text": "می‌شود. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.92,
   "end": 65.9,
   "text": "ادامه بحث قلب منغمس رو به فضل الهی داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.9,
   "end": 73.24,
   "text": "رسیده بودیم به اینکه باید توجه کرد به معدوبت الله تا بی‌خبر نمانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.24,
   "end": 80.26,
   "text": "معدوبت الله هم که قرآن است و این قرآن کتر شده را حداقل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 80.26,
   "end": 86.14,
   "text": "اعجاز علمی درون اون توجه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 86.14,
   "end": 91.04,
   "text": "که خود و شما رو توصیه می‌کنم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 91.04,
   "end": 96.82,
   "text": "توجه دقیق به معجزات علمی قرآنی که خیلی به انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 96.82,
   "end": 105.88,
   "text": "آرامش می‌بخشه و انسان رو به یقین نزدیک می‌کنه و به آیه ده سوره لقمان در جلسه پیش یادم اشاره کردیم و نشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 105.88,
   "end": 108.44,
   "text": "پیرامونش بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 108.44,
   "end": 112.64,
   "text": "آیه ده سوره لقمان چه شیرین می‌فرماید خلق السماوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 112.64,
   "end": 115.6,
   "text": "بغير عمد ترونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 115.6,
   "end": 118.78,
   "text": "یعنی آسمان‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 118.78,
   "end": 121.2,
   "text": "خلق کرده خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 121.2,
   "end": 123.74,
   "text": "بدون ستون عمد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 123.74,
   "end": 126.0,
   "text": "بدون ستونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.0,
   "end": 128.8,
   "text": "که ترونه‌ها شما ببینیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.8,
   "end": 132.68,
   "text": "یعنی ستون دارد. ستون هست شما نمی‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.68,
   "end": 136.48,
   "text": "ستون‌های نوری‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.48,
   "end": 138.6,
   "text": "که حالا اینجا باید بحث کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.6,
   "end": 142.82,
   "text": "ببینید عمد جمع عمود است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.82,
   "end": 145.04,
   "text": "به معنی ستون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.04,
   "end": 147.82,
   "text": "البته اینکه تو این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.82,
   "end": 153.76,
   "text": "این عمد یعنی ستون‌ها مقید شدند به ترونه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.76,
   "end": 158.52,
   "text": "این خودش دلیله بر اینه که آسمان ستون‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.52,
   "end": 161.88,
   "text": "مرئی نداره. یعنی دیده نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.88,
   "end": 167.4,
   "text": "خب یعنی در حقیقت ستون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.4,
   "end": 172.16,
   "text": "مفهوم این سخن اینه که ستون‌هایی دارد اما غیر قابل رؤیت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.16,
   "end": 176.54,
   "text": "تعبیری که در این آیه به کار رفته اشاره لطیفیه به قانون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.54,
   "end": 181.36,
   "text": "جاذبه و دافعه که مثل ستونی بسیار نیرومند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.36,
   "end": 185.86,
   "text": "اما نامرئی کرات آسمانی رو در جای خودش نگه داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.86,
   "end": 189.24,
   "text": "اشاره می‌کنیم به حدیث بسیار زیبایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 189.24,
   "end": 195.02,
   "text": "از آقامون علی ابن موسی الرضا علیهم الصلاة والسلام که حسین ابن خالد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.02,
   "end": 197.34,
   "text": "نقل کرده این حدیث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.34,
   "end": 200.86,
   "text": "که حضرت فرمودند سبحان الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.86,
   "end": 204.7,
   "text": "أليس الله یقول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.7,
   "end": 208.28,
   "text": "بغير عمد ترونها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.28,
   "end": 216.44,
   "text": "امام رضا تسبیح الهی رو میگن منزه از خدا پیداست که حرف مهمی میخوان بزنن سبحان الله میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 216.44,
   "end": 223.6,
   "text": "که آیا خداوند نمی‌فرماید بدون ستونی که اون را مشاهده کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 223.6,
   "end": 231.34,
   "text": "أليس الله یقول آیا خدا نمی‌گوید بغير عمد ترونها اشاره هست به همین آیه ده سوره لقمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 231.34,
   "end": 237.56,
   "text": "آیا خدا نفرموده که بدون ستونی که اون رو مشاهده کنید، راوی میگه که عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 237.56,
   "end": 240.82,
   "text": "قلت گفتم بله، بله همینطوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 240.82,
   "end": 244.24,
   "text": "فقال حضرت فرمودند ثمه عمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 244.24,
   "end": 247.06,
   "text": "ولاکل ترونها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 247.06,
   "end": 249.6,
   "text": "پس ستون‌هایی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 249.6,
   "end": 256.02,
   "text": "ثمه عمد ستون‌هایی است ولاکل ترونها ولی شما اون‌ها رو نمی‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 256.02,
   "end": 262.0,
   "text": "این روایت در تفسیر قمی جلد دو صفحه صد و بیست و پنج می‌تونید ملاحظه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 262.0,
   "end": 266.28,
   "text": "پس این مشخصه که با توجه به این حدیث منظور از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 266.28,
   "end": 269.16,
   "text": "اون قرآن در اون آیه صد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 269.16,
   "end": 271.98,
   "text": "آیه ده سوره لقمان چه چیزیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 271.98,
   "end": 275.58,
   "text": "و منظور از این ستون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.58,
   "end": 278.82,
   "text": "چه ستون‌هایی است که به چشم دیده نمی‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 278.82,
   "end": 285.24,
   "text": "حالا اینم خودش دو تا نکته رو باید در تفسیر بغير عمد ترونها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 285.24,
   "end": 287.16,
   "text": "مورد دقت قرار بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 287.16,
   "end": 291.0,
   "text": "اول اینکه عمد جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 291.0,
   "end": 294.54,
   "text": "یعنی ستون‌ها. پس هر چند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 294.54,
   "end": 298.08,
   "text": "تفسیر اون به، به نیرو جاذبه ممکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 298.08,
   "end": 301.4,
   "text": "میشه تفسیر کرد از اون به نیرو جاذبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.4,
   "end": 306.84,
   "text": "اما امکان داره که مقصود از این ستون‌ها چندین نیرو متفاوت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 306.84,
   "end": 311.2,
   "text": "چون اگر صرفاً نیرو جاذبه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 311.2,
   "end": 314.58,
   "text": "خب حرف از عمود زده میشد مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 314.58,
   "end": 319.38,
   "text": "مفسرین فرمودند همین که عمد اومده جمع اومده، يحتمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 319.38,
   "end": 324.16,
   "text": "میشه اینطوری برداشت کرد که نیروهای متفاوتی هستند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 324.16,
   "end": 328.92,
   "text": "نگه داشته‌اند. چه بسا حالا ما بی‌خبر باشیم و آینده‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 328.92,
   "end": 331.74,
   "text": "با پیشرفت علم اون رو کشف کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 331.74,
   "end": 337.44,
   "text": "که اما اینکه خب قبلاً همچنین بود اصلاً از همین نیرو جاذبه فعلی هم کسی خبر نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 337.44,
   "end": 340.14,
   "text": "اونجا نیرو جاذبه و دافعه‌ای که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 340.14,
   "end": 342.6,
   "text": "نگه می‌دارند آسمان‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 342.6,
   "end": 346.02,
   "text": "پس حصر عمد یعنی ستون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 346.02,
   "end": 352.34,
   "text": "به نیرو جاذبه صحیح به نظر نمی‌رسه که بگیم صرفاً همین نیروست و ولا غیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 352.34,
   "end": 355.28,
   "text": "نکته دوم اتفاقاً بحث سماواته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 355.28,
   "end": 358.78,
   "text": "در قرآن سماوات معانی متعددی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 358.78,
   "end": 361.58,
   "text": "می‌دونید مثلاً جهت بالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.58,
   "end": 364.6,
   "text": "اون ما فوق رو نسبت به مادون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 364.6,
   "end": 367.97,
   "text": "مثلاً الان نفس ناطقه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 367.97,
   "end": 374.03,
   "text": "سماء. ز-- انزل مراتبش که بدنه حکم عرض رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 374.03,
   "end": 376.65,
   "text": "مثلاً جو زمین در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.65,
   "end": 378.63,
   "text": "بعضی آیات اشاره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 378.63,
   "end": 387.93,
   "text": "همین سماوات که تو قرآن اومده اشاره به جو زمینه یا کرات آسمانی یا مثلاً آسمان‌های معنوی مثل نفس انسان مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.93,
   "end": 391.33,
   "text": "یا ستارگان، سیارات و، و، و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 391.33,
   "end": 395.57,
   "text": "تعابیری که تعابیر بسیار گسترده‌ای که از سماوات در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 395.57,
   "end": 398.35,
   "text": "قرآن شده. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 398.35,
   "end": 406.03,
   "text": "اینجا در صورتی تفسیر آیه به نیرو جاذبه صحیحه که آسمان رو به معنای کرات آسمانی معنا کنیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 406.03,
   "end": 409.25,
   "text": "نه اون معانی دیگه‌ای مثل مثلاً آسمان‌های معنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 409.25,
   "end": 412.21,
   "text": "اینم نکته قابل تأملی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 412.21,
   "end": 419.83,
   "text": "اما وقتی شما سیاق آیه ده سوره لقمان رو مورد بررسی قرار میدید، اجازه بدید بقیه آیه رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 419.83,
   "end": 424.15,
   "text": "\"خَلَقَ السَّمَاوَاتِ بِغَيْرِ عَمَدٍ تَرَونَهَا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 424.15,
   "end": 427.03,
   "text": "که توجه بهش کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 427.03,
   "end": 431.33,
   "text": "ادامه آیه اینه \"وَأَلْقَىٰ فِي الْأَرْضِ رَوَاسِيَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 431.33,
   "end": 433.45,
   "text": "أَن تَمِيدَ بِكُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 433.45,
   "end": 439.87,
   "text": "وَبَثَّ فِيهَا مِن كُلِّ دَابَّةٍ وَأَنزَلْنَا مِنَ السَّمَاءِ مَاءً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 439.87,
   "end": 442.69,
   "text": "فَأَنبَتْنَا فِيهَا مِن كُلِّ زَوْجٍ كَرِيمٍ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 442.69,
   "end": 446.95,
   "text": "چه زی-- شیرین و زیبا اینجا زوج کریم رو خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 446.95,
   "end": 451.23,
   "text": "مطرح کرده. \"وَأَنزَلْنَا مِنَ السَّمَاءِ مَاءً\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 451.23,
   "end": 454.25,
   "text": "خب اینجا دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 454.25,
   "end": 459.67,
   "text": "که نزول باران رو از آسمان بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 459.67,
   "end": 463.31,
   "text": "یعنی اشاره کرده اینجا قرآن به نزول باران از آسمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 463.31,
   "end": 467.71,
   "text": "و آسمان‌ها رو در مقابل زمین به کار برده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 467.71,
   "end": 470.67,
   "text": "درسته؟ \"وَأَلْقَىٰ فِي الْأَرْضِ رَوَاسِيَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 470.67,
   "end": 473.19,
   "text": "بعد \"وَأَنزَلْنَا مِنَ السَّمَاءِ مَاءً\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 473.19,
   "end": 476.95,
   "text": "یعنی آسمان رو مقابل زمین مطرح کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 476.95,
   "end": 478.97,
   "text": "تو آیه دو، سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 478.97,
   "end": 485.07,
   "text": "سوره رعد هم شما دقت بفرمایید به دنبال ذکر آسمون‌ها از خورشید و ماه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 485.07,
   "end": 487.93,
   "text": "بعدش هم زمین و اینا سخن میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 487.93,
   "end": 491.99,
   "text": "و آیه‌ای که جلسه پیش عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 491.99,
   "end": 495.85,
   "text": "\"اللَّهُ الَّذِي رَفَعَ السَّمَاوَاتِ بِغَيْرِ عَمَدٍ تَرَونَهَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.85,
   "end": 499.53,
   "text": "ثُمَّ اسْتَوَىٰ عَلَى الْعَرْشِ وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 499.53,
   "end": 503.77,
   "text": "ببینید بعد از ذکر آسمان‌ها، از عرش، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 503.77,
   "end": 507.45,
   "text": "خورشید و ماه و بعد می‌فرماید \"كُلٌّ يَجْرِي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 507.45,
   "end": 511.41,
   "text": "لِأَجَلٍ مُّسَمًّىٰ يُدَبِّرُ الْأَمْرَ يُفَصِّلُ الْآيَاتِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 511.41,
   "end": 513.93,
   "text": "لَعَلَّكُمْ بِلِقَاءِ رَبِّكُمْ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 513.93,
   "end": 517.69,
   "text": "تو غنون همینطور و، و آیه بعد که به زمین اشاره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 517.69,
   "end": 520.73,
   "text": "این‌ها مجموعاً که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 520.73,
   "end": 525.11,
   "text": "حالا به ذکر به دنبال ذکر آسمون‌ها از خورشید و ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 525.11,
   "end": 531.35,
   "text": "و این‌ها و زمین و اینا سخن میگه، معلوم می‌شه که قدر متقین از آسمون تو این موارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 531.35,
   "end": 538.85,
   "text": "همون آسمان مادیه. یعنی کرات آسمانی یا طبقات جو زمین و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 538.85,
   "end": 541.13,
   "text": "اینم توجه داشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 541.13,
   "end": 548.05,
   "text": "که باز وقتی شما مثلاً به یه آیه دیگه مثل آیه چهل و یک سوره فاطر دقت می‌کنید، میگم اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 548.05,
   "end": 551.33,
   "text": "این بحث انقدر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 551.33,
   "end": 555.65,
   "text": "جای جای قرآن در آیات بیان شده پیداست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 555.65,
   "end": 558.49,
   "text": "خدای منظور خاصی رو از این بحث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 558.49,
   "end": 566.23,
   "text": "خب اعجاز علمیه دیگه. الانم که انفجار علمه، تولید علمه، عصر اطلاعات و توسعه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 566.23,
   "end": 572.15,
   "text": "خب وقتی ما مذهبیون از این اعجاز علمی قرآن بی‌خبر باشیم چگونه می‌خوایم بریم تو دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 572.15,
   "end": 576.19,
   "text": "مثلاً کسایی که مدعی علمند امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 576.19,
   "end": 581.01,
   "text": "اینا خودش باور کنید وقتی این‌ها رو مطرح می‌کنی برای کسایی که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 581.01,
   "end": 584.55,
   "text": "مثلاً حتی ماده‌گرا هستند، نگاه می‌بینی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 584.55,
   "end": 587.83,
   "text": "تکون می‌خوره وجودشون. اون موقع این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 587.83,
   "end": 591.77,
   "text": "آیات نازل شده که کسی اصلاً توجهی به این مسائل نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 591.77,
   "end": 594.93,
   "text": "پیغمبرi که نه درس خونده، نه مکتب رفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 594.93,
   "end": 599.75,
   "text": "چگونه این حقایق علمی سنگینی که بعد هزار سال کشف شده رو بیان کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 599.75,
   "end": 602.21,
   "text": "مثلاً آیه چهل و یک سوره فاطر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 602.21,
   "end": 604.95,
   "text": "می‌فرمایدش نکاتی که در اینجا هست رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 604.95,
   "end": 610.21,
   "text": "\"إِنَّ اللَّهَ يُمْسِكُ السَّمَاوَاتِ وَالْأَرْضَ أَن تَزُولَا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 610.21,
   "end": 616.45,
   "text": "خداست که اون آسمون‌ها و زمین رو از اینکه از جای خودشون بلغزن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 616.45,
   "end": 620.59,
   "text": "منحرف بشن دو-- نگه داشته، نگه می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 620.59,
   "end": 624.07,
   "text": "\"لَئِن زَالَتَا\" که اگر از رو انحراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 624.07,
   "end": 632.09,
   "text": "حالا منحرف بشن از مسیر خودشون \"أَنْ أَمْسَكَهُمَا مِن أَحَدٍ مِّن بَعْدِهِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 632.09,
   "end": 635.45,
   "text": "هیچکس به جز خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 635.45,
   "end": 638.27,
   "text": "نمی‌تونه اون‌ها رو حفظ کنه تو این مدارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 638.27,
   "end": 642.25,
   "text": "\"إِنَّهُ كَانَ حَلِيمًا غَفُورًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 642.25,
   "end": 644.71,
   "text": "دقت بفرمایید شما خودتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 644.71,
   "end": 647.85,
   "text": "اول اینکه اینجا هم دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 647.85,
   "end": 654.15,
   "text": "وقتی دقت می‌کنید آسمان‌ها رو به معنای کرات آسمانی فرض کردیم، فرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 654.15,
   "end": 657.57,
   "text": "توی این آیه، تو همین آیه چهل و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 657.57,
   "end": 661.03,
   "text": "و نکته دیگه اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 661.03,
   "end": 665.01,
   "text": "نگهداری آسمان و زمین توی این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 665.01,
   "end": 671.83,
   "text": "توسط خود خدا به معنای نگهداری اون توسط نیروی جاذبه می‌تونه باشه باز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 671.83,
   "end": 676.67,
   "text": "چرا؟ چون خدای منان سنتش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 676.67,
   "end": 678.91,
   "text": "از مسیر اسباب فیض رو برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 678.91,
   "end": 683.27,
   "text": "اصلاً سنت الهیه. \"فَلَن تَجِدَ لِسُنَّةِ اللَّهِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 683.27,
   "end": 686.93,
   "text": "تَبْدِيلًا وَلَن تَجِدَ لِسُنَّةِ اللَّهِ تَحْوِيلًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 686.93,
   "end": 691.59,
   "text": "اصلاً سنت ال-- الهی تبدیل و تحویل‌بردار هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 691.59,
   "end": 694.81,
   "text": "یعنی خدا نگه می‌داره اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 694.81,
   "end": 698.81,
   "text": "از کانال این نیروی جاذبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 698.81,
   "end": 701.79,
   "text": "حالا ممکنه که خداوند توسط البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 701.79,
   "end": 706.23,
   "text": "باز عرض می‌کنیم یه وسایل و نیروهای متعدد دیگری هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 706.23,
   "end": 709.05,
   "text": "آسمان‌ها و زمین رو نگه داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 709.05,
   "end": 715.49,
   "text": "تا منحرف نشود. که مثلاً نیروی جاذبه یکی از اون‌ها باشه، نه به تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 715.49,
   "end": 719.85,
   "text": "که حالا باز باید عرض می‌کنیم اینجا که انحصار معنای آیه فوق تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 719.85,
   "end": 721.93,
   "text": "نیروی جاذبه صحیح نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 721.93,
   "end": 724.71,
   "text": "این آیه‌ای که عرض کردیم. اما باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 724.71,
   "end": 732.11,
   "text": "می‌تونه خب نیروهای دیگری هم باشد که در مسیر و طول اراده حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 732.11,
   "end": 735.55,
   "text": "که اما نکته مهم اینه که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 735.55,
   "end": 740.89,
   "text": "آیه، این آیه‌ای که عرض کردیم دو تا تفسیر داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 740.89,
   "end": 744.17,
   "text": "که بر اساس یکی از اون‌ها حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 744.17,
   "end": 748.33,
   "text": "بر اساس یکی از اون تفاسیر قابل انطباق با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 748.33,
   "end": 750.55,
   "text": "نیروی جاذبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 750.55,
   "end": 762.01,
   "text": "خب نتیجه اون که احتمال دلالت آیه ده سوره لقمان و آیه دو سوره رعد و اینا به نیروی جاذبه خیلی قویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 762.01,
   "end": 766.13,
   "text": "ولی باز عرض می‌کنیم که انحصار بردار هم البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 766.13,
   "end": 773.23,
   "text": "نیست. خب اینها از اعجاز علمی قرآن در بحث جاذبه که باز میشه به آیات دیگری هم استناد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 773.23,
   "end": 776.99,
   "text": "حالا اگه کسی خواست تفسیر بهتری تو این زمینه ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 776.99,
   "end": 781.03,
   "text": "می‌تونه رجوع کنه به کتاب قش-- زیبا و خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 781.03,
   "end": 784.61,
   "text": "پژوهشی در اعجاز علمی قرآن به قلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 784.61,
   "end": 791.79,
   "text": "آقای رضایی اصفهانی. اون کتاب خوبیه که جلد یک صفحه صد و پنجاه و پنج پیرامون همین موضوع جاذبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 791.79,
   "end": 794.53,
   "text": "می‌تونید مطالبی رو اونجا ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 794.53,
   "end": 801.03,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 801.03,
   "end": 803.61,
   "text": "اللهم صلّ و سلّم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 803.61,
   "end": 811.49,
   "text": "و زد و بارک على رسول الله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 811.49,
   "end": 815.23,
   "text": "آله الأطهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 815.23,
   "end": 819.69,
   "text": "على رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 819.69,
   "end": 824.51,
   "text": "و آله الأطهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 824.51,
   "end": 827.91,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 827.91,
   "end": 830.95,
   "text": "صلّ و سلّم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 830.95,
   "end": 838.05,
   "text": "و زد و بارک على رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 838.05,
   "end": 842.63,
   "text": "و آله الأطهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 842.63,
   "end": 847.07,
   "text": "على رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 847.07,
   "end": 851.07,
   "text": "و آله الأطهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}