 "chapters": [
  {
   "index": 0,
   "title": "خودسازی و فرج فردی",
   "start": 2.44,
   "end": 28.48
  },
  {
   "index": 1,
   "title": "ــ سنن ابی‌داود، کتاب المهدی، حدیث ۴۲۸۲",
   "start": 28.48,
   "end": 66.02
  },
  {
   "index": 2,
   "title": "مهم‌ترین کار انسان: خودسازی",
   "start": 66.02,
   "end": 141.28
  },
  {
   "index": 3,
   "title": "معرفت نفس؛ کلید طلایی معرفت‌الله",
   "start": 141.28,
   "end": 222.54
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.44,
   "end": 6.1,
   "text": "آقای بهجت فرمودن که دعا برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.1,
   "end": 9.26,
   "text": "خودسازی خودت، تهذیب نفس خودت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.26,
   "end": 13.68,
   "text": "اهمه. مهم‌تر است از دعا برای ظهور آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.68,
   "end": 19.68,
   "text": "اصلاً حضرت بالاخره تشریف خواهند آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.68,
   "end": 21.98,
   "text": "چه ما باشیم، وعده‌ی الهیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.98,
   "end": 28.48,
   "text": "روایت داریم که اگر یک روز از عمر دنیا باقی مونده باشه تو همون روز آقا ظهور می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.48,
   "end": 31.34,
   "text": "این یعنی چی؟ یعنی نگران نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.34,
   "end": 34.82,
   "text": "میاد آقا، اون وعده‌ی الهیه. خدا هم که صادق الوعده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.82,
   "end": 41.04,
   "text": "تو نگران خودت باش. نگران باش که ظهور فردی برات اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.04,
   "end": 44.02,
   "text": "نگران این باش که نکنه اتفاق نیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.02,
   "end": 48.45,
   "text": "فرج فردی که عزیزم فرمودن الان، این برات اتفاق نیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.45,
   "end": 54.5,
   "text": "فرج فردی، ظهور آقا برای شما یعنی خودسازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.5,
   "end": 61.54,
   "text": "این اهمه. آقای بهجت فرمودن ما نمیگیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.54,
   "end": 66.02,
   "text": "اصلاً بارها و بارها گفتیم بازم بگیم هرچی هم بگیم کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.02,
   "end": 71.14,
   "text": "حضرت استاد چقدر تأکید داشتن که ما کاری...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.14,
   "end": 76.54,
   "text": "ما، من و شما که اینجا نشستیم الان این همه زار می‌زدیم به خاطر چی زار می‌زدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.54,
   "end": 78.94,
   "text": "من چه می‌دونم. برای هرچی می‌زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.94,
   "end": 83.62,
   "text": "کاری مهم‌تر از خودسازی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.62,
   "end": 86.36,
   "text": "خودسازی هم فرمودن مبتنی است بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.36,
   "end": 90.58,
   "text": "چی؟ بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.58,
   "end": 96.78,
   "text": "معرفت نفس. این جایگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.78,
   "end": 101.18,
   "text": "سلسله بحث‌های معرفت نفسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.18,
   "end": 105.76,
   "text": "اینه که مثلاً مسجد بلال اون جماعت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.76,
   "end": 110.12,
   "text": "دورترین جاهای کشور پا میشن بعضاً میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.12,
   "end": 112.16,
   "text": "حالا ما خانوم‌ها رو نهی کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.16,
   "end": 114.5,
   "text": "خانومن بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.5,
   "end": 117.44,
   "text": "اذیت میشن تو راه، نهایتش آقا هم همراهشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.44,
   "end": 122.84,
   "text": "اونا گفتیم نیا. ولی آقایون نه چرا نیاین، بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.84,
   "end": 127.76,
   "text": "اونا حجت میشن برای من. بعد کسایی که این بغل گوششونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.76,
   "end": 131.28,
   "text": "جلسه بغل گوششونه تو همین تهرانم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.28,
   "end": 141.28,
   "text": "غافلن. اگر یه جا باشه برن معرفت نفس کسب کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.28,
   "end": 144.38,
   "text": "اگر کسی تو این جلسه نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.38,
   "end": 147.04,
   "text": "و احتمامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.04,
   "end": 151.06,
   "text": "به معرفت نفس و کسب این کلید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.06,
   "end": 158.6,
   "text": "کلید طلایی معرفت الله نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.6,
   "end": 160.82,
   "text": "به نظر من از رحمت خدا به دوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.82,
   "end": 164.0,
   "text": "هرکی هست .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.0,
   "end": 169.92,
   "text": "کسی که حتی اینجا الان نشسته اما احتمالی به معرفت نفس نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.92,
   "end": 175.04,
   "text": "اصلاً هیچ راه دیگه‌ای نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.04,
   "end": 182.2,
   "text": "هیچ راه دیگه‌ای نیست. تو باید زار رو بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.2,
   "end": 185.36,
   "text": "الحمد لله تنها عالمی هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.36,
   "end": 189.04,
   "text": "چقدرم-- چه عالمی، چه جامع الاطرافی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 189.04,
   "end": 194.34,
   "text": "که این مباحثو نشسته درس به درس دستتو گرفته مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.34,
   "end": 198.8,
   "text": "پدر و مادرای قدیم یادتونه تاتی تاتی می‌کردن بچه رو با خودشون می‌کشوندن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.8,
   "end": 205.06,
   "text": "همین طور درس به درس، قدم به قدم تو این صد و پنجاه و سه درس تو رو برده جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.06,
   "end": 212.6,
   "text": "معرفت نفس. یه طوری هم درسو پی-پیاده کرده نیاز نداره تو حتما منطق خونده باشی، فقه و اصول خونده باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 212.6,
   "end": 217.4,
   "text": "نه. ب-بدایه و هدایه خون-- نوایا خونده باشی، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.4,
   "end": 222.54,
   "text": "نه، اصلا نیازی نیست. البته اونا رو خونده باشی بهتر متوجه میشی اما نیازی هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}