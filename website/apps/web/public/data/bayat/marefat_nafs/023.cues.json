   "start": 55.54,
   "end": 96.64
  },
  {
   "index": 2,
   "title": "انسان یک مرتبه باطنی‌تر و کلی‌تر می‌رود و می‌گوید: «من عقل دارم؛ انسانی عاقل هستم که می‌توانم کلیات را بفهمم.»",
   "start": 96.64,
   "end": 232.16
  },
  {
   "index": 3,
   "title": "مرتبهٔ قلب",
   "start": 232.16,
   "end": 640.12
  },
  {
   "index": 4,
   "title": "«هُوَ» و مرتبهٔ پنهان حقیقت",
   "start": 640.12,
   "end": 786.18
  },
  {
   "index": 5,
   "title": "حدود وصول به اسماء الهی",
   "start": 786.18,
   "end": 823.24
  },
  {
   "index": 6,
   "title": "اسماء الهی و اطلاق آنها",
   "start": 823.24,
   "end": 888.9
  },
  {
   "index": 7,
   "title": "اسماء مستأثره در مصباح الأنس",
   "start": 888.9,
   "end": 914.08
  },
  {
   "index": 8,
   "title": "ترجمهٔ فارسی (توسط مدل، نه استاد): آن‌گونه که در علم حق تعیّن دارد.",
   "start": 914.08,
   "end": 1059.13
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.28,
   "end": 4.44,
   "text": "اجباری نیست سؤال بپرسید‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.44,
   "end": 8.08,
   "text": "اگر واقعاً سوالی هست اجباری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.08,
   "end": 10.48,
   "text": "حاج آقا باز هم تسلیت عرض می‌کنیم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.48,
   "end": 13.6,
   "text": "خدا بیامرزد پدر بزرگوارتون رو انشاالله که- دم شما گرم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.6,
   "end": 15.8,
   "text": "امیرالمؤمنین محشور بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.8,
   "end": 21.02,
   "text": "حاج آقا ببخشید من در مورد نفس یه سؤال قبلاً هم پرسیدم ولی هنوز برای من جای سواله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.02,
   "end": 24.0,
   "text": "ما این نفس رو میگیم خب به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.0,
   "end": 27.66,
   "text": "شؤون متفاوتی داره. یه جایی بهش میگیم روح، یه جایی میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.66,
   "end": 29.66,
   "text": "حالا شأن‌های متفاوتش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 29.66,
   "end": 35.78,
   "text": "الان ما وقتی میگیم من عرف نفسه بالاخره اون منی که نفس رو می‌شناسه، اون روحه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.78,
   "end": 37.56,
   "text": "شأنی باز از خود همین نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 37.56,
   "end": 41.16,
   "text": "این تفاوت‌ها چجوری میشه در نهایت اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.16,
   "end": 43.82,
   "text": "آخر آخرش، این چه حالتیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 43.82,
   "end": 46.3,
   "text": "چه شکلی بهش- خیلی سؤال خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 46.3,
   "end": 48.26,
   "text": "خیلی سؤالتون خوبه. خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 48.26,
   "end": 55.16,
   "text": "احسنت. البته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 55.16,
   "end": 57.88,
   "text": "دقت کنین سؤالتون خیلی سؤال عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 57.88,
   "end": 62.26,
   "text": "من دوباره می‌پرسم. آقا من عرف نفسه اول عرف ربّ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 62.26,
   "end": 67.12,
   "text": "کسی که نفس خودش رو بشناسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 67.12,
   "end": 70.52,
   "text": "خب کی می‌خواد نفس خودش رو بشناسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 70.52,
   "end": 73.36,
   "text": "نفس، نفس رو می‌شناسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 73.36,
   "end": 79.2,
   "text": "یعنی نفس شما خودش رو می‌شناسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 79.2,
   "end": 83.14,
   "text": "کی، کی رو می‌شناسه؟ اولاً میگه من عرف نفسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 83.14,
   "end": 86.58,
   "text": "یعنی نفس، نفس باید شناخته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 86.58,
   "end": 88.56,
   "text": "این یک، که حالا نفس چی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 88.56,
   "end": 90.66,
   "text": "دو، این من کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 90.66,
   "end": 96.06,
   "text": "نفسه؟ یعنی نفس خودش رو بشناسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 96.06,
   "end": 99.46,
   "text": "یا روح مثلاً نفسش رو بشناسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 99.46,
   "end": 103.58,
   "text": "سؤال خیلی خوبیه. این رو البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 103.58,
   "end": 107.02,
   "text": "فکر می‌کنم مثلاً حداقل یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 107.02,
   "end": 113.22,
   "text": "هفتاد هشتاد جلسه از همین جلسات سیر معرفت نفس کتاب علامه را که بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 113.22,
   "end": 116.52,
   "text": "متوجه میشیم جواب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 116.52,
   "end": 120.62,
   "text": "یه جواب کوچیکی بدم تا حالا در، تا سیر بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 120.62,
   "end": 122.6,
   "text": "ببینید من قبلاً هم عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 122.6,
   "end": 125.82,
   "text": "ما یک حقیقت کلی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 125.82,
   "end": 128.22,
   "text": "که ذات وجودی ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 128.22,
   "end": 130.66,
   "text": "اون سرشت اصلی ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 130.66,
   "end": 134.04,
   "text": "که اون رو ما ازش بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 134.04,
   "end": 138.42,
   "text": "مثل اینکه الان من از شما می‌پرسم آقای روحانی شما چ-کی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 138.42,
   "end": 143.52,
   "text": "خودتو برای من، میگی من اسمم رو، میگم من با اسم شما کاری ندارم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 143.52,
   "end": 145.2,
   "text": "شما خودتو برای من تشریح کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 145.2,
   "end": 149.38,
   "text": "میگی من این علم رو دارم، این تخصص، میگم آقا من کاری به علم شما ندارم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 149.38,
   "end": 151.36,
   "text": "خودتو برای، به من بشناسون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 151.36,
   "end": 155.6,
   "text": "کی هستی؟ چی هستی؟ میگه آقا نگاه کن قد و وزن و شکلمو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 155.6,
   "end": 158.12,
   "text": "میگم آقا من با اینا کاری ندارم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 158.12,
   "end": 162.34,
   "text": "خود اون چیزی که هستی، حقیقت وجودی‌ت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 162.34,
   "end": 166.76,
   "text": "میگه آهان اونو می‌خوای؟ خب من حقیقت وجودی‌م اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 166.76,
   "end": 170.66,
   "text": "ب-ظاهر دارم، باطن دارم، بدن دارم مثلاً بعد قوות.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 170.66,
   "end": 173.96,
   "text": "میگم آقا من با اینا، اینا شؤون شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 173.96,
   "end": 176.78,
   "text": "اطوار وجودی شما. من با اینا کاری ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 176.78,
   "end": 179.64,
   "text": "حقیقت وجودی خودت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 179.64,
   "end": 183.62,
   "text": "درسته؟ مثلاً میگه آقا من اونی‌ام که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 183.62,
   "end": 191.4,
   "text": "می‌تونم به طریق قوه خیال که قوه یا دوربین عکس‌برداری نفس ناطقمه از بیرون عکس‌برداری کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 191.4,
   "end": 194.4,
   "text": "درک کنم. این من مدرک هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 194.4,
   "end": 196.18,
   "text": "بیرون از من مدرک منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 196.18,
   "end": 198.94,
   "text": "من مدرکات خودم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 198.94,
   "end": 202.13,
   "text": "درک کنم. از طریق قوه خیال ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 202.13,
   "end": 209.06,
   "text": "اینا رو صورت و اشکال در خودم از اونا ایجاد کنم، ببزان اونها ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 209.06,
   "end": 211.28,
   "text": "یعنی اونا باشن معلوم به ذات من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 211.28,
   "end": 214.28,
   "text": "این که تو قوه خیالم هست. بیرون می‌شه معلوم در عرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 214.28,
   "end": 220.24,
   "text": "کاری به اون ندارم. من اصلاً کاری-- میگه آقا من به این کار، من-- این، اینم یک شأنی از شعون وجود شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 220.24,
   "end": 222.44,
   "text": "حقیقت وجودی شما که چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 222.44,
   "end": 229.12,
   "text": "اونو به من بگو. دوباره میره باطن‌تر از رتبه باطن‌تر و کلی‌تر از خودش میگه من عقلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 229.12,
   "end": 234.28,
   "text": "من عقل دارم. من انسان عاقلی هستم که کلیات رو می‌تونم بفهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 234.28,
   "end": 236.18,
   "text": "وقتی میگن زیبایی خوبه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 236.18,
   "end": 239.01,
   "text": "میگم بله. کلیت زیبایی رو می‌فهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 239.01,
   "end": 243.4,
   "text": "میگم باز دوباره دست گذاشتی رو یکی از شعون وجودی خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 243.4,
   "end": 247.04,
   "text": "اون حقیقت کلیت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 247.04,
   "end": 250.5,
   "text": "میگه مثل اینکه باید کلی‌تر از این نگاه کنما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 250.5,
   "end": 252.94,
   "text": "بعد میگه خب من یه قلبی هم دارم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 252.94,
   "end": 256.52,
   "text": "همه حقایق اونجا sand دیده میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 256.52,
   "end": 261.54,
   "text": "باز میشن، انبساط پیدا می‌کنند، درک اونجا اتفاق می‌افته اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 261.54,
   "end": 265.2,
   "text": "میگم آقا من با اون هم کاری ندارم عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 265.2,
   "end": 272.0,
   "text": "یاد روحش می‌افته. میگه خب این که میاد تو قلب من مثلاً من الان دارم دو دو تا چهارتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 272.0,
   "end": 275.0,
   "text": "اما الان توجه به ریاضی ندارم، دارم نقاشی می‌کشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 275.0,
   "end": 279.88,
   "text": "این الان کجاست؟ تو روح منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 279.88,
   "end": 289.78,
   "text": "وقتی نیاز دارم توجه کنم به اون دانسته‌ی خودم که ملکه وجودمه و اصلاً اسم یکی از معانی اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 289.78,
   "end": 292.94,
   "text": "همینه. کمالات وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 292.94,
   "end": 296.38,
   "text": "من یکی از کمالات وجودی من اینه که ریاضی بلدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 296.38,
   "end": 299.01,
   "text": "خب این کجاست الان؟ این کمال کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 299.01,
   "end": 301.7,
   "text": "تو روحمه. وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 301.7,
   "end": 304.1,
   "text": "وارد حوزه قلب می‌شه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 304.1,
   "end": 305.8,
   "text": "یادم میاد دو دو تا چهار تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 305.8,
   "end": 308.1,
   "text": "توجه کردید؟ حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 308.1,
   "end": 313.28,
   "text": "من اونی‌ام که این‌ها، این دانسته‌هام، داشته‌هام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 313.28,
   "end": 316.92,
   "text": "دارایی خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 316.92,
   "end": 320.26,
   "text": "این به یک معنا کمالاتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 320.26,
   "end": 323.76,
   "text": "تو روحم جمع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 323.76,
   "end": 327.48,
   "text": "میگم آقا دوباره دست گذاشتی تو یکی از شعون وجودی خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 327.48,
   "end": 329.68,
   "text": "که درسته اون دیگه خیلی کلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 329.68,
   "end": 333.18,
   "text": "همه زیر و بالا پره اونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 333.18,
   "end": 335.82,
   "text": "اما من با اونم کاری ندارما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 335.82,
   "end": 338.35,
   "text": "میگه عجب! کلی‌تر از اون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 338.35,
   "end": 342.88,
   "text": "یه ذره فکر می‌کنه، بررسی می‌کنه میگه آقا آها راستی من یک سری هم دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 342.88,
   "end": 346.48,
   "text": "که مافوق روحه. سر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 346.48,
   "end": 351.02,
   "text": "سر دیگه می‌شه گفت مدیر روح منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 351.02,
   "end": 355.78,
   "text": "اون، اونه که آنچه که روح داره بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 355.78,
   "end": 358.62,
   "text": "در حقیقت رازق روح منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 358.62,
   "end": 365.22,
   "text": "روح من قدرش اندازه‌ش، سه‌اش، ضیقش هرچی که هست تحت‌الامر سره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 365.22,
   "end": 367.92,
   "text": "سر اندازه‌شو مشخص می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 367.92,
   "end": 374.16,
   "text": "سر منه که هو الله الخالق البارع المصور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 374.16,
   "end": 376.84,
   "text": "خالق یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 376.84,
   "end": 379.44,
   "text": "نقشه می‌کشه، الگو می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 379.44,
   "end": 382.06,
   "text": "بارع برش میده. مصور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 382.06,
   "end": 386.18,
   "text": "می‌دوزه. اینا کار سر منه که روح منو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 386.18,
   "end": 390.28,
   "text": "نقشه‌شو معلوم کرده، می‌برش، می‌دوزش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 390.28,
   "end": 393.96,
   "text": "هو الله الخالق. آقا من با اونم دوباره کاری ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 393.96,
   "end": 397.76,
   "text": "شما دوباره داری یکی از اطوار وجودیه کارایی داره انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 397.76,
   "end": 407.06,
   "text": "من کاری با اون ندارم. اون حقیقت کلی وجودیت که سرت زیر نظر اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 407.06,
   "end": 408.94,
   "text": "اصلاً اسمشو بذار سر روی سر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 408.94,
   "end": 415.84,
   "text": "بذار اخفا. اینجا چی باید گفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 415.84,
   "end": 420.6,
   "text": "چی باید گفت آقای روحانی؟ میشه اصلاً حرفی زد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 420.6,
   "end": 422.78,
   "text": "لالیم. میگیم نمی‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 422.78,
   "end": 425.08,
   "text": "خب بالاخره من چجوری بگم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 425.08,
   "end": 427.72,
   "text": "میگم اون، اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 427.72,
   "end": 430.16,
   "text": "اون چیه آقا؟ میگه من شما کی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 430.16,
   "end": 432.7,
   "text": "چی هستی؟ میگی من اونم، اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 432.7,
   "end": 436.7,
   "text": "خب یعنی چی اونم؟ نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 436.7,
   "end": 440.66,
   "text": "چون شما اون حقیقت اصلی رو خواستی من بی‌خبرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 440.66,
   "end": 446.28,
   "text": "در خصوص حضرت حق این همه اسماء ازش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 446.28,
   "end": 449.32,
   "text": "و هر تل موجودات عن بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 449.32,
   "end": 453.2,
   "text": "даже خود بسم الله هم فرمود در اصول کافی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 453.2,
   "end": 463.28,
   "text": "از امام صادق، کشاف احوال، امام حق ناطق روایت داریم که اولین اسمی که از خدا منتشر شد الله و تبارک و تعالی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 463.28,
   "end": 467.3,
   "text": "که علامه هم دیروز من داشتم جلسه هفتاد و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 467.3,
   "end": 470.52,
   "text": "شرح، شرح اسفار علامه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 470.52,
   "end": 474.58,
   "text": "گوش می‌دادم. ایشون برای چندمین بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 474.58,
   "end": 478.46,
   "text": "ایشون تو همه درس و بحث‌هاش فرموده اینو آه می‌کشه میگه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 478.46,
   "end": 483.44,
   "text": "شرح اون، اون اصول کافی که ما معربش کردیم اعراب‌بند خیلی سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 483.44,
   "end": 486.2,
   "text": "شما روایات رو اعراب درست بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 486.2,
   "end": 492.9,
   "text": "ما اعراب‌بندی کردیم با اینکه اعراب درست نوشته بودیم تو چاپ رفته خورده اولین اسمی که از حق منتشر شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 492.9,
   "end": 496.0,
   "text": "الله تبارک و تعالی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 496.0,
   "end": 500.46,
   "text": "یعنی تبارک و تعالی رو صفت گرفتن بر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 500.46,
   "end": 504.22,
   "text": "الله شده موصوف. در صورتی که علامه میگن اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 504.22,
   "end": 506.82,
   "text": "اشتباه چاپ شده. الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 506.82,
   "end": 513.14,
   "text": "و تبارک و تعالی یعنی این سه اسم اولین اسم‌هایی بودند که از خدا منتشر شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 513.14,
   "end": 516.52,
   "text": "خب یعنی خدا الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 516.52,
   "end": 522.06,
   "text": "به نظر شما خدا الله؟ دقیقاً مثل اینه که شما بگی من روحم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 522.06,
   "end": 527.22,
   "text": "کی گفته شما روحی؟ روح یک جلوه‌ای از شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 527.22,
   "end": 531.24,
   "text": "خدا الله نیست. خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 531.24,
   "end": 535.96,
   "text": "یعنی اون حقیقت، اون ذات واجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 535.96,
   "end": 539.46,
   "text": "اون چی اسمشو چی بذاریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 539.46,
   "end": 545.74,
   "text": "میگه آقا خب الله اگه نیست، اگه الله اسم جامعه، همه اسمای زیر بال و پرشن پس اون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 545.74,
   "end": 549.28,
   "text": "چجوری بخونیمش؟ میگه بگو هو و او،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.28,
   "end": 552.46,
   "text": "او. برای همین میگن اسم اعظم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 552.46,
   "end": 558.06,
   "text": "شما کتاب، همون کتاب معرفت نفس علامه طباطبایی رو اگه تهیه کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 558.06,
   "end": 560.09,
   "text": "تو مقدمش با چی شروع شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.09,
   "end": 564.4,
   "text": "هو با هو. اینا اسرار داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 564.4,
   "end": 568.66,
   "text": "زده‌ش به اونجا. می‌خوای در خصوص خدا چی بگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 568.66,
   "end": 570.27,
   "text": "خدا چیه؟ نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 570.27,
   "end": 574.52,
   "text": "هو او. در خصوص خودتم همین رو میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 574.52,
   "end": 577.74,
   "text": "اصلا اسم اعظم وجودی ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 577.74,
   "end": 579.98,
   "text": "اون سر مکنون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 579.98,
   "end": 583.06,
   "text": "اون رتبه اخفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.06,
   "end": 585.1,
   "text": "همونه. اونه، او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 585.1,
   "end": 589.84,
   "text": "خودتو هم‌ها خودت. یک جلوه‌ای هستی از هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 589.84,
   "end": 593.3,
   "text": "ما بی‌خبریم. حالا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 593.3,
   "end": 595.3,
   "text": "باهاش، بهش میگن چی آقای روحانی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 595.3,
   "end": 599.48,
   "text": "او، او قراره نفس رو بشناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 599.48,
   "end": 602.18,
   "text": "او که از، ما ازش بی‌خبریم یعنی از خود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 602.18,
   "end": 607.42,
   "text": "اتفاقا خوبه بدونید سؤال خیلی قشنگ و جدیه، اینچه شاخ و برگ پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 607.42,
   "end": 611.7,
   "text": "یه بار هم عرض کردم علامه یه رساله‌ای داره در خصوص من عرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 611.7,
   "end": 618.6,
   "text": "رساله من عرف صد وجه از معانی‌ای که ترجمه‌هایی که از این روایت شده رو نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 618.6,
   "end": 622.72,
   "text": "عربی هم هست. اتفاقا یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 622.72,
   "end": 624.72,
   "text": "ترجمه ها که اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 624.72,
   "end": 628.18,
   "text": "آورده علامه از اون صد وجه، یه وجهش می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 628.18,
   "end": 633.0,
   "text": "یعنی چون کسی که بشناسد او را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 633.0,
   "end": 634.68,
   "text": "خب اون کیه که می‌خواد بشناسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 634.68,
   "end": 640.12,
   "text": "نمی‌دونم. پس نمی‌تونی بشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 640.12,
   "end": 644.72,
   "text": "اگر او را شناختی پروردگارتو می‌شناسی یعنی تو این کوچولوش موندی می‌خوای اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 644.72,
   "end": 648.2,
   "text": "اون تو جزءش موندی تو اصلش می‌خوای بشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 648.2,
   "end": 650.18,
   "text": "یکی از وجوه علامه اصلا همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 650.18,
   "end": 653.24,
   "text": "میگه پس یکی از معانی این من عرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 653.24,
   "end": 657.62,
   "text": "یعنی آقا نمیشه شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 657.62,
   "end": 661.24,
   "text": "این معنیش اینه. اما خب حاق قضیه رو نمیشه شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 661.24,
   "end": 664.8,
   "text": "اون اصل و اون لب و اون مغز و اون، اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 664.8,
   "end": 669.98,
   "text": "اون نمی‌دونیم چی بگیم. حالا او قراره بشناسه نفس رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 669.98,
   "end": 673.28,
   "text": "نفس چیه؟ الان باید حاضر جواب باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 673.28,
   "end": 678.4,
   "text": "نفس گفتیم رتبه تعلقیه، باطن ظاهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 678.4,
   "end": 680.94,
   "text": "یعنی اون او. حالا بگیم روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 680.94,
   "end": 684.12,
   "text": "که بشه صحبت کرد. اون روح، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 684.12,
   "end": 687.5,
   "text": "وجهه اصلی شما از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 687.5,
   "end": 691.02,
   "text": "یعنی اون رتبه‌ای که تعلق خاطر داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 691.02,
   "end": 701.5,
   "text": "به بدن که می‌خواد بدن رو با خودش بکشه بالا، رتق و فتق کنه به اون رتبه که تعلق به بدن داره میگن نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 701.5,
   "end": 703.88,
   "text": "حالا شما این بدن جسمی رو ازش بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 703.88,
   "end": 708.18,
   "text": "موت اصطلاحا حاصل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 708.18,
   "end": 712.62,
   "text": "نفس داری یا نداری؟ اینو برداری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 712.62,
   "end": 718.0,
   "text": "این بدن رو برداری، روحت تعلق به این بدن دیگه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 718.0,
   "end": 721.76,
   "text": "یعنی این بدن می‌شه بدون نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 721.76,
   "end": 723.76,
   "text": "اما نفس دوباره داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 723.76,
   "end": 727.0,
   "text": "چرا؟ چون بدن برزخی داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 727.0,
   "end": 732.86,
   "text": "روح شما تعلق یا توجه به بدن برزخی شما مثل اینکه تو خواب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 732.86,
   "end": 737.16,
   "text": "تو خواب توجه نفس شما یا به عبارتی روح شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 737.16,
   "end": 741.12,
   "text": "از این بدن برداشته میشه میفته به بدن برزخیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 741.12,
   "end": 743.38,
   "text": "لذا این بیحال میشه میفته اصطلاحا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 743.38,
   "end": 749.34,
   "text": "میمیره شبیه میت میشه اون بدن برزخی فعال میشه با اون تو خواب این ور اون ور میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 749.34,
   "end": 752.56,
   "text": "باز اینجا نفس داری. نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 752.56,
   "end": 755.74,
   "text": "رتبه تعلق ظاهر به باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 755.74,
   "end": 759.98,
   "text": "خب اون رتبه تعلق ظاهر به باطن رو ما باید بشناسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 759.98,
   "end": 764.1,
   "text": "که اطوار وجودیش این همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 764.1,
   "end": 769.04,
   "text": "امیدوارم که تونسته باشم جواب قانع‌کننده‌ای داده باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 769.04,
   "end": 774.94,
   "text": "جانم. صحبت که می‌کنیم با این صحبت‌هایی که فرمودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 774.94,
   "end": 780.46,
   "text": "خدا تو قرآن به اون مضمونی میگه که پیامبر دید اون چیزی رو که چشمش رو هم بهش دروغ نگفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 780.46,
   "end": 787.88,
   "text": "یعنی پیامبر دید اسم جامع الله رو و حرکت کرد بعد از این شناخت به سمت هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 787.88,
   "end": 790.2,
   "text": "این درسته برداشت ما؟ دو تا معنا هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 790.2,
   "end": 794.16,
   "text": "سوال دومت هم قشنگه. دو تا معنا از این بزرگان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 794.16,
   "end": 799.74,
   "text": "یکی اینکه تمام اسماء رو اینکه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 799.74,
   "end": 806.5,
   "text": "من رأنی فقد رأى الله هر کس من را دید پس به تحقیق الله رو دیده پیغمبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 806.5,
   "end": 811.0,
   "text": "یعنی چون خودش الله رو دید مستجمع جميع اسماء و صفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 811.0,
   "end": 812.76,
   "text": "حسنی و الیاه الهی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 812.76,
   "end": 816.32,
   "text": "اما آیا پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 816.32,
   "end": 817.94,
   "text": "به اون هو رسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 817.94,
   "end": 820.89,
   "text": "یعنی هو رو دید؟ نه، اینطور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 820.89,
   "end": 824.92,
   "text": "الله رو دید و الله در او پیاده شد، نه هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 824.92,
   "end": 832.04,
   "text": "این یک معناست. یه معناش دیگه میگه آقا اصلاً خود الله خود الکریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 832.04,
   "end": 835.5,
   "text": "العلیم، الاستار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 835.5,
   "end": 845.16,
   "text": "الغفور، الودود، الرحمن اینها هم الف و رام که سرش میاد یعنی همه رحمت عام، همه رحمت خاص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 845.16,
   "end": 848.16,
   "text": "همه رأفت خاص، همه علم خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 848.16,
   "end": 852.12,
   "text": "پیغمبر که به همه علم ذاتی خدا نرسید که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 852.12,
   "end": 856.58,
   "text": "به اون مقداری رسید که امکان ظهورش بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 856.58,
   "end": 859.24,
   "text": "امکان خروجش از ذات الهی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 859.24,
   "end": 861.9,
   "text": "اینطوری بگیم همه فهم بشه. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 861.9,
   "end": 868.74,
   "text": "برای همین میگن تمام اسماء الهی اسماء مستثنیه حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 868.74,
   "end": 871.32,
   "text": "فکر کنم مثلا الان همرام باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 871.32,
   "end": 876.34,
   "text": "من امروز داشتم مسبار الأنس رو می‌خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 876.34,
   "end": 882.16,
   "text": "فکر می‌کنم به همچین چیزی تو همین مسبار الأنس، این همون کتابی که دستمونه مسبار الأنس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 882.16,
   "end": 890.4,
   "text": "بله. احسنت بله همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 890.4,
   "end": 893.44,
   "text": "اجازه بدید از همین جا براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 893.44,
   "end": 895.88,
   "text": "اسماء مستثنیه الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 895.88,
   "end": 903.8,
   "text": "حق تعالی خواست علم مختص به قسم ثانی را به کمال رساند و برخی از بندگان خویش را به علم کامل گرداند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 903.8,
   "end": 907.18,
   "text": "مراد از قسم ثانی در رساله مصحف این بوده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 907.18,
   "end": 912.48,
   "text": "قسمی که لا یستقل الانسان مطلقاً بادراکه و این قسم را علی نحو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 912.48,
   "end": 921.08,
   "text": "تعینه فی علم الحق یعنی آنگونه که واقع علم به اندازه طاقت بشری است، به اندازه طاقت بشری است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 921.08,
   "end": 925.76,
   "text": "بفهمد. هرکسی به اندازه طاقتش علم الهی را احص کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 925.76,
   "end": 936.66,
   "text": "البته بشر چون محدودیت دارد نمی‌تواند هیچ حقیقتی را به صورت اطلاقی و مرسله و اکناهی و بی‌نهایت تحصیل کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 936.66,
   "end": 939.94,
   "text": "رسیدن به قدرت و علم و ادراکات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 939.94,
   "end": 947.72,
   "text": "ادراکات و دیگر صفات کمالیه به طور اطلاقی بدون تق-تقید به مجالس و مظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 947.72,
   "end": 952.54,
   "text": "برای بشر ممکن نیست و تنها این صفات برای پروردگار حاصل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 952.54,
   "end": 955.3,
   "text": "این صفات مطلقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 955.3,
   "end": 957.9,
   "text": "فقط برای پروردگار حاصل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 957.9,
   "end": 959.98,
   "text": "پس به اندازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 959.98,
   "end": 962.9,
   "text": "سعه وجودی خویش به آنها دست پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 962.9,
   "end": 970.14,
   "text": "مظاهر آنها و شمه‌ای از آنها را می‌توانیم ادراک کنیم و به طور مطلق همه اینجا این همه حرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 970.14,
   "end": 972.86,
   "text": "همه اسماء حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 972.86,
   "end": 977.36,
   "text": "همه اسماء. نه اینکه بگیم خدا یک اسم مستعصره داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 977.36,
   "end": 979.38,
   "text": "یه معنا از این فرمایش شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 979.38,
   "end": 987.68,
   "text": "اینه که همه اسماء رو رسید به الله هم رسید اما اسم مستعصره رو هون که ما ازش بی‌خبریم اون رو نرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 987.68,
   "end": 990.04,
   "text": "یه معناست. اما علامه اینجا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 990.04,
   "end": 992.32,
   "text": "منظر جدیدی رو به رویمون باز می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 992.32,
   "end": 997.6,
   "text": "که الان داشتیم بحث می‌کردیم. همه اسماء حق مستعصره‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 997.6,
   "end": 1003.74,
   "text": "و مختص به اویند و حق آنها را برای خویش برگزیده و دیگری نمی‌تواند آنها را داشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1003.74,
   "end": 1007.82,
   "text": "همان‌طور که وجود بذات از اسماء مستعصره الهی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1007.82,
   "end": 1018.62,
   "text": "و در دعا هم اسماء مستعصره را استثنا کرده یا سوگند به آنها داده و فرموده است به اسماء التي است-استسرتهَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1018.62,
   "end": 1020.68,
   "text": "بقیه دعا همینطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1020.68,
   "end": 1022.96,
   "text": "که الان داره همین، همین حرفو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1022.96,
   "end": 1026.4,
   "text": "یا العلیم خود خداست فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1026.4,
   "end": 1028.96,
   "text": "علیم اهل بیت هستند اما العلیم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1028.96,
   "end": 1033.5,
   "text": "اگه اینطوری نگاه کنیم پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1033.5,
   "end": 1038.58,
   "text": "باز به قدر طاقت خودش اسماء الهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1038.58,
   "end": 1041.94,
   "text": "احص کرد. نه به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1041.94,
   "end": 1049.36,
   "text": "اسماء مستعصره. دیگه دو دقیقه سه دقیقه هم تقریباً از وقت گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1049.36,
   "end": 1052.56,
   "text": "ببخشید انشاالله که همه‌تون موفق باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1052.56,
   "end": 1055.84,
   "text": "والحمد لله رب العالمين صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1055.84,
   "end": 1059.13,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}