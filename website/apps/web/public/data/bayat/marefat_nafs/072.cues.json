 },
 "chapters": [
  {
   "index": 0,
   "title": "برکتِ سفرهٔ معارف علامه حسن‌زاده آملی",
   "start": 2.44,
   "end": 144.0
  },
  {
   "index": 1,
   "title": "الله‌اکبر! باید در این تعبیر دقت کرد: اثر این اجتماع، یک نفس است.",
   "start": 144.0,
   "end": 214.0
  },
  {
   "index": 2,
   "title": "مرتبهٔ الهیت و واحدیت",
   "start": 214.0,
   "end": 257.08
  },
  {
   "index": 3,
   "title": "«اثرِ یک نفسِ کلیِ الهیِ قوی است.»",
   "start": 257.08,
   "end": 356.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.44,
   "end": 5.74,
   "text": "ما در این حسینیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.74,
   "end": 11.32,
   "text": "نورانی چندین ساله که سر سفره معارف استاد کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.32,
   "end": 19.66,
   "text": "حضرت علامه حسن زاده علیه الرحمه والرضوان نشستیم و این برکتی که داره روز به روز مضاعف میشه سر این سفره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.66,
   "end": 24.14,
   "text": "قطعاً از اشراقات و عنایات و هدایت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.14,
   "end": 27.16,
   "text": "ایشون هست. از لسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.16,
   "end": 30.7,
   "text": "پاک ایشون، اون دهان پاک ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.7,
   "end": 32.94,
   "text": "یه جمله تقدیم کنم کیف کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.94,
   "end": 35.58,
   "text": "البته دیدم الحمد لله این جمله رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.58,
   "end": 40.92,
   "text": "عزیزان دلم در کانال فلیرحل معنى گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.92,
   "end": 48.14,
   "text": "حالا اینجا سؤالاتی که ما ج-- وقت کردیم جواب بدیم تو اون کانال میذارم یا دلگویه های شما رو میذارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.14,
   "end": 50.9,
   "text": "یه جمله داره علامه می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.9,
   "end": 53.62,
   "text": "نفوس-- دقت بفرمایید چه کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.62,
   "end": 56.86,
   "text": "می‌خوام ارزش این جلسه رو متوجه بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.86,
   "end": 61.16,
   "text": "نفوس این تک تک این جان‌ها، این نفس‌ها که اینجان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.16,
   "end": 63.24,
   "text": "نفوس مجتمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.24,
   "end": 66.82,
   "text": "مت-متحد را این نفوسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.82,
   "end": 69.4,
   "text": "یک مجتمع شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.4,
   "end": 72.58,
   "text": "نه از راه دور فقط، مجتمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.58,
   "end": 77.24,
   "text": "جمع کردن. دو متحد شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.24,
   "end": 80.28,
   "text": "یک بار عرض کردم در ادب مع الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.28,
   "end": 86.7,
   "text": "اون نمازی که می‌فرمود اگر به ده نفر برسه جز خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.7,
   "end": 89.26,
   "text": "نمی‌تونه ثوابشو بشماره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.26,
   "end": 94.6,
   "text": "حضرت استاد فرمودن نمازی‌ست که قلوب متشتت نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.6,
   "end": 98.52,
   "text": "قلوب متحدن. ده نفر رو پیدا کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.52,
   "end": 103.6,
   "text": "نماز جماعت بخونن که دل‌هاشون همه یکی باشه، متحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.6,
   "end": 106.28,
   "text": "اون جز خدا ثوابشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.28,
   "end": 110.12,
   "text": "نه اینکه هر دلی یه طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.12,
   "end": 112.02,
   "text": "همان از هیئت که اینطوری باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.02,
   "end": 114.98,
   "text": "تشتت. و این یک شرط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.98,
   "end": 118.06,
   "text": "دو شرط یعنی اجتماع بعد متحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.06,
   "end": 120.04,
   "text": "چه اثری داره همچین جلساتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.04,
   "end": 127.1,
   "text": "اینو هیئت‌ها، جلسات معارفی باید با اب-- آبتلا بنویسن سر در جلساتشون بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.1,
   "end": 129.9,
   "text": "یا این اجتماعات این شب‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.9,
   "end": 134.56,
   "text": "می‌خواید بدونید اثر-- یک اثر این اجتماعات، این شب‌ها چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.56,
   "end": 139.42,
   "text": "یه خروجی‌شو از قول حضرت استاد بشنوید، نه من بی‌سواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.42,
   "end": 142.14,
   "text": "خب حالا اثرش چیه؟ اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.14,
   "end": 145.34,
   "text": "یک نفس کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.34,
   "end": 148.04,
   "text": "الهی قوی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.04,
   "end": 153.2,
   "text": "الله اکبر. دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.2,
   "end": 155.6,
   "text": "اثر چی؟ یک نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.6,
   "end": 160.02,
   "text": "نفس مقامش چیه رفقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.02,
   "end": 161.98,
   "text": "عقل مقامش تدبیر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 161.98,
   "end": 164.74,
   "text": "تدبیر عالم. نفس چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.74,
   "end": 169.42,
   "text": "پرورش بود. عقل کل امیرالمؤمنین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 169.42,
   "end": 172.32,
   "text": "نفس کل کی بود؟ حضرت زهرا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 172.32,
   "end": 175.44,
   "text": "اولاً یعنی مقام پرورش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 175.44,
   "end": 177.18,
   "text": "پرورش میده آدم‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 177.18,
   "end": 180.16,
   "text": "مربی میشه و شما میشید مرباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 180.16,
   "end": 183.64,
   "text": "دو، اینو باید دقت کرد. این باید بازه همین یه جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 183.64,
   "end": 188.92,
   "text": "باز بشه، عزیزان دلم سروران بزرگوارم اینجا تشریف دارن، نه من بی‌سواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 188.92,
   "end": 195.9,
   "text": "باور کنید چهل جلسه کمه تا درون مایه همین یه جمله استاد باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 195.9,
   "end": 200.08,
   "text": "پس اول اثر یک نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 200.08,
   "end": 202.94,
   "text": "چه nefsi؟ نفس کلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 202.94,
   "end": 207.82,
   "text": "الله اکبر. نفس کل حضرت زهرا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 207.82,
   "end": 212.12,
   "text": "نفس کلی. خب چه نفس کلی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 212.12,
   "end": 217.2,
   "text": "الهی. الهیت نظام کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 217.2,
   "end": 220.68,
   "text": "عالم اله کجا بود؟ عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.68,
   "end": 224.96,
   "text": "واحدیت بود. مادون احدیت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 224.96,
   "end": 228.08,
   "text": "مافوق جبروت و عالم عقول بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 228.08,
   "end": 230.96,
   "text": "مافوق عالم جبروت که میشه ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 230.96,
   "end": 238.9,
   "text": "عالم امیرالمؤمنین یا عقل و عقول، ارواح، مرسلات، مفارقات اینا مافوقش میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.9,
   "end": 244.36,
   "text": "الهیت یا ربوبیت یا واحدیت یا قلب عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.36,
   "end": 247.48,
   "text": "قَلبُ المؤمن على اشد الرمه، اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.48,
   "end": 251.02,
   "text": "الله اکبر. از اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 251.02,
   "end": 256.42,
   "text": "فکر پرورش من و شما رو میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.42,
   "end": 258.28,
   "text": "اثری که این اجتماعات داره--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.28,
   "end": 261.34,
   "text": "خدا ببین چه میکنه. یک اجتماع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.34,
   "end": 263.24,
   "text": "یک مجمع متحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.24,
   "end": 266.18,
   "text": "الله اکبر. دیدی چه نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.18,
   "end": 269.98,
   "text": "نوری میگیری، چه شور و نشاطی میگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 269.98,
   "end": 273.9,
   "text": "حالا نگفتی چند تا که، نگفتی عدد ندادی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 273.9,
   "end": 278.26,
   "text": "کمترین عددی که کثرت میشه چند تاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 278.26,
   "end": 281.96,
   "text": "آفرین، آفرین به اینایی که درس و بحث‌ها رو خوب گوش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.96,
   "end": 285.64,
   "text": "این کمترین عددی که رایحه کثرت داره سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 285.64,
   "end": 287.6,
   "text": "دیگه کمتر از اون دیگه کثرت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 287.6,
   "end": 291.42,
   "text": "یعنی سه نفر حتی اگر متحد بشوند این اثرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 291.42,
   "end": 294.18,
   "text": "چه برسه بشه سی نفر، بشه سیصد نفر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 294.18,
   "end": 297.18,
   "text": "بشه همین طوری هی برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 297.18,
   "end": 304.6,
   "text": "جمعیت‌های میلیونی اصلاً اثرش دیگه میشه نفس کلیه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.6,
   "end": 306.24,
   "text": "خب الهی دیگه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 306.24,
   "end": 311.16,
   "text": "قوی. شما دیگه برید بو کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.16,
   "end": 313.86,
   "text": "این فرمایشو بو کنید ببینید چیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 313.86,
   "end": 318.72,
   "text": "این اثر از کیه، از کجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
