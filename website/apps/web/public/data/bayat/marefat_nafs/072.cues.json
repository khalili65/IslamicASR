 },
 "chapters": [
  {
   "index": 0,
   "title": "متن کامل (پاکسازی‌شده)",
   "start": 2.44,
   "end": 356.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.44,
   "end": 14.84,
   "text": "ما در این حسینیهٔ نورانی، چندین ساله که سر سفرهٔ معارف استادِ کل حضرت علامه حسن‌زاده علیه الرحمة والرضوان نشسته‌ایم؛",
   "kind": "speech",
   "chapter": 0,
   "block": 5
  },
  {
   "i": 1,
   "start": 14.84,
   "end": 26.0,
   "text": "و این برکتی که روزبه‌روز مضاعف می‌شود سر این سفره، قطعاً از اشراقات و عنایات و هدایت‌های ایشان است.",
   "kind": "speech",
   "chapter": 0,
   "block": 5
  },
  {
   "i": 2,
   "start": 26.0,
   "end": 32.22,
   "text": "از لسان پاک ایشان از آن دهان پاک ایشان یک جمله تقدیم کنم؛",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 3,
   "start": 32.22,
   "end": 40.92,
   "text": "کیف کنید. البته دیدم الحمد لله این جمله را عزیزان دلم در کانال «فَلْيَرْحَلْ مَعِي» گذاشته‌اند.",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 4,
   "start": 40.92,
   "end": 45.1,
   "text": "حالا اینجا سؤالاتی که ما وقت کردیم جواب بدهیم، در آن کانال می‌گذارم؛",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 5,
   "start": 45.1,
   "end": 47.567,
   "text": "یا دلگویه‌های شما را می‌گذارم.",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 6,
   "start": 47.567,
   "end": 49.43,
   "text": "یک جمله دارد علامه؛",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 7,
   "start": 49.43,
   "end": 53.62,
   "text": "می‌فرماید «نفوس…» دقت بفرمایید چه کرده؟",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 8,
   "start": 53.62,
   "end": 56.86,
   "text": "می‌خواهم ارزش این جلسه را متوجه بشوید.",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 9,
   "start": 56.86,
   "end": 71.22,
   "text": "نفوس این تک‌تک این جان‌ها، این نفس‌ها «نفوس مجتمعة متحد»: این نفوسی که یک، مجتمع شده‌اند نه از راه دور فقط؛",
   "kind": "speech",
   "chapter": 0,
   "block": 9
  },
  {
   "i": 10,
   "start": 71.22,
   "end": 77.24,
   "text": "مجتمع یعنی جمع کردن و دو، متحد شده‌اند.",
   "kind": "speech",
   "chapter": 0,
   "block": 9
  },
  {
   "i": 11,
   "start": 77.24,
   "end": 89.26,
   "text": "یک بار عرض کردم در ادب مع الله: آن نمازی که می‌فرمود اگر به ده نفر برسد جز خدا نمی‌تواند ثوابش را بشمارد.",
   "kind": "speech",
   "chapter": 0,
   "block": 10
  },
  {
   "i": 12,
   "start": 89.26,
   "end": 94.6,
   "text": "حضرت استاد فرمودند: نمازی است که قلوب متشتت نیستند؛",
   "kind": "speech",
   "chapter": 0,
   "block": 10
  },
  {
   "i": 13,
   "start": 94.6,
   "end": 103.6,
   "text": "قلوب متحدند. ده نفر را پیدا کن نماز جماعت بخوانند که دل‌هایشان همه یکی باشد، متحد؛",
   "kind": "speech",
   "chapter": 0,
   "block": 10
  },
  {
   "i": 14,
   "start": 103.6,
   "end": 110.12,
   "text": "آن جز خدا ثوابش را نمی‌شمارد نه اینکه هر دلی یک طرف باشد.",
   "kind": "speech",
   "chapter": 0,
   "block": 10
  },
  {
   "i": 15,
   "start": 110.12,
   "end": 113.14,
   "text": "همان از هیئت که این‌طوری باشد، تشتت است.",
   "kind": "speech",
   "chapter": 0,
   "block": 10
  },
  {
   "i": 16,
   "start": 113.14,
   "end": 114.98,
   "text": "و این یک شرط است؛",
   "kind": "speech",
   "chapter": 0,
   "block": 10
  },
  {
   "i": 17,
   "start": 114.98,
   "end": 118.06,
   "text": "دو شرط یعنی اجتماع بعد اتحاد.",
   "kind": "speech",
   "chapter": 0,
   "block": 10
  },
  {
   "i": 18,
   "start": 118.06,
   "end": 120.04,
   "text": "چه اثری دارد همچین جلساتی؟",
   "kind": "speech",
   "chapter": 0,
   "block": 12
  },
  {
   "i": 19,
   "start": 120.04,
   "end": 129.9,
   "text": "این را هیئت‌ها و جلسات معارفی باید با آب طلا بنویسند سر در جلساتشان بزنند یا این اجتماعات این شب‌ها.",
   "kind": "speech",
   "chapter": 0,
   "block": 12
  },
  {
   "i": 20,
   "start": 129.9,
   "end": 134.78,
   "text": "می‌خواهید بدانید یک اثر این اجتماعات این شب‌ها چیست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 13
  },
  {
   "i": 21,
   "start": 134.78,
   "end": 140.86,
   "text": "یک خروجی‌اش را از قول حضرت استاد بشنوید، نه منِ بی‌سواد. خب حالا اثرش چیست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 13
  },
  {
   "i": 22,
   "start": 140.86,
   "end": 150.4,
   "text": "اثر: **یک نفس کلی الهی قوی است.** الله اکبر.",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 23,
   "start": 150.4,
   "end": 155.6,
   "text": "دقت بفرمایید. اثر چیست؟ یک نفس است.",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 24,
   "start": 155.6,
   "end": 160.02,
   "text": "نفس مقامش چیست رفقا؟",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 25,
   "start": 160.02,
   "end": 163.04,
   "text": "عقل مقامش تدبیر بود تدبیر عالم.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 26,
   "start": 163.04,
   "end": 166.74,
   "text": "نفس چه بود؟ پرورش بود.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 27,
   "start": 166.74,
   "end": 169.42,
   "text": "عقل کل امیرالمؤمنین بود؛",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 28,
   "start": 169.42,
   "end": 172.32,
   "text": "نفس کل کی بود؟ حضرت زهرا بود.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 29,
   "start": 172.32,
   "end": 175.44,
   "text": "اولاً یعنی مقام پرورش دارد؛",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 30,
   "start": 175.44,
   "end": 177.18,
   "text": "پرورش می‌دهد آدم‌ها را؛",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 31,
   "start": 177.18,
   "end": 180.16,
   "text": "مربی می‌شود و شما می‌شوید مربّایش.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 32,
   "start": 180.16,
   "end": 182.34,
   "text": "دو، این را باید دقت کرد. این باید باز شود؛",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 33,
   "start": 182.34,
   "end": 184.74,
   "text": "همین یک جمله باید باز شود.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 34,
   "start": 184.74,
   "end": 188.92,
   "text": "عزیزان دلم، سروران بزرگوارم اینجا تشریف دارند نه منِ بی‌سواد.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 35,
   "start": 188.92,
   "end": 195.9,
   "text": "باور کنید چهل جلسه کم است تا درون‌مایهٔ همین یک جملهٔ استاد باز شود.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 36,
   "start": 195.9,
   "end": 200.08,
   "text": "پس اول: اثر یک نفس.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 37,
   "start": 200.08,
   "end": 202.94,
   "text": "چه نفسی؟ نفس کلی.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 38,
   "start": 202.94,
   "end": 207.82,
   "text": "الله اکبر. نفس کل حضرت زهرا بود؛",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 39,
   "start": 207.82,
   "end": 214.0,
   "text": "نفس کلی. خب چه نفس کلی؟ الهی.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 40,
   "start": 214.0,
   "end": 217.2,
   "text": "الهیت نظام کجاست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 19
  },
  {
   "i": 41,
   "start": 217.2,
   "end": 224.96,
   "text": "عالم اله کجا بود؟ عالم واحدیت بود مادون احدیت بود؛",
   "kind": "speech",
   "chapter": 0,
   "block": 19
  },
  {
   "i": 42,
   "start": 224.96,
   "end": 228.08,
   "text": "مافوق جبروت و عالم عقول بود.",
   "kind": "speech",
   "chapter": 0,
   "block": 19
  },
  {
   "i": 43,
   "start": 228.08,
   "end": 244.36,
   "text": "مافوق عالم جبروت که می‌شود عالم امیرالمؤمنین یا عقل و عقول، ارواح، مرسلات، مفارقات مافوقش می‌شود الهیت یا ربوبیت یا واحدیت یا قلب عالم.",
   "kind": "speech",
   "chapter": 0,
   "block": 19
  },
  {
   "i": 44,
   "start": 244.36,
   "end": 249.16,
   "text": "«قَلْبُ الْمُؤْمِنِ عَرْشُ الرَّحْمَٰنِ» (حدیث؛ مضمون مشهور)",
   "kind": "quote",
   "chapter": 0,
   "block": 20,
   "translation": "دل مؤمن عرشِ رحمان است."
  },
  {
   "i": 45,
   "start": 249.16,
   "end": 256.42,
   "text": "از آنجا فکر پرورش من و شما را می‌کند.",
   "kind": "speech",
   "chapter": 0,
   "block": 22
  },
  {
   "i": 46,
   "start": 256.42,
   "end": 263.24,
   "text": "اثری که این اجتماعات دارد خدا ببین چه می‌کند: یک اجتماع، یک مجمع متحد.",
   "kind": "speech",
   "chapter": 0,
   "block": 22
  },
  {
   "i": 47,
   "start": 263.24,
   "end": 266.96,
   "text": "الله اکبر. دیدی چه نور، نوری می‌گیری؛",
   "kind": "speech",
   "chapter": 0,
   "block": 22
  },
  {
   "i": 48,
   "start": 266.96,
   "end": 269.98,
   "text": "چه شور و نشاطی می‌گیری.",
   "kind": "speech",
   "chapter": 0,
   "block": 22
  },
  {
   "i": 49,
   "start": 269.98,
   "end": 273.9,
   "text": "حالا نگفتی چند تا؛ نگفتی عدد ندادی.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 50,
   "start": 273.9,
   "end": 278.26,
   "text": "کمترین عددی که کثرت می‌شود چند تاست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 51,
   "start": 278.26,
   "end": 281.96,
   "text": "آفرین، آفرین به این‌هایی که درس و بحث‌ها را خوب گوش داده‌اند.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 52,
   "start": 281.96,
   "end": 285.64,
   "text": "این کمترین عددی که رایحهٔ کثرت دارد: **سه**.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 53,
   "start": 285.64,
   "end": 287.6,
   "text": "دیگر کمتر از آن دیگر کثرت نیست.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 54,
   "start": 287.6,
   "end": 291.42,
   "text": "یعنی سه نفر حتی اگر متحد بشوند این اثرش هست؛",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 55,
   "start": 291.42,
   "end": 297.18,
   "text": "چه برسد بشود سی نفر، بشود سیصد نفر، بشود همین‌طوری هی برو.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 56,
   "start": 297.18,
   "end": 304.6,
   "text": "جمعیت‌های میلیونی اصلاً اثرش دیگر می‌شود نفس کلیهٔ الهیه.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 57,
   "start": 304.6,
   "end": 306.24,
   "text": "خب الهی دیگر چیست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 25
  },
  {
   "i": 58,
   "start": 306.24,
   "end": 311.16,
   "text": "قوی. شما دیگر بروید بو کنید؛",
   "kind": "speech",
   "chapter": 0,
   "block": 25
  },
  {
   "i": 59,
   "start": 311.16,
   "end": 313.86,
   "text": "این فرمایش را بو کنید ببینید چیست؛",
   "kind": "speech",
   "chapter": 0,
   "block": 25
  },
  {
   "i": 60,
   "start": 313.86,
   "end": 318.72,
   "text": "این اثر از کیست، از کجاست.",
   "kind": "speech",
   "chapter": 0,
   "block": 25
  },
  {
   "i": 61,
   "start": 318.72,
   "end": 326.54,
   "text": "این در حقیقت خروجی این جلسات است. الله اکبر.",
   "kind": "speech",
   "chapter": 0,
   "block": 25
  },
  {
   "i": 62,
   "start": 326.54,
   "end": 337.04,
   "text": "واقعاً من که زبانم واقعاً قاصر است از بیان عظمت.",
   "kind": "speech",
   "chapter": 0,
   "block": 27
  },
  {
   "i": 63,
   "start": 337.04,
   "end": 339.972,
   "text": "عظمت که می‌گویم نمی‌گویم «عظمت» به معنی معمولی.",
   "kind": "speech",
   "chapter": 0,
   "block": 27
  },
  {
   "i": 64,
   "start": 339.972,
   "end": 347.3,
   "text": "بعضی‌ها می‌گویند این عظمت چیست؟ بر وزن فَعَلوت: جبروت، ملکوت، عظمت.",
   "kind": "speech",
   "chapter": 0,
   "block": 27
  },
  {
   "i": 65,
   "start": 347.3,
   "end": 350.61,
   "text": "یعنی چه؟ خیلی زیاد؛",
   "kind": "speech",
   "chapter": 0,
   "block": 27
  },
  {
   "i": 66,
   "start": 350.61,
   "end": 356.46,
   "text": "مبالغه است. بسیار معظّمت این اجتماعات شب‌ها.",
   "kind": "speech",
   "chapter": 0,
   "block": 27
  }
 ]
}