 },
 "chapters": [
  {
   "index": 0,
   "title": "متن کامل جلسه (پاکسازی‌شده)",
   "start": 0.06,
   "end": 1179.48
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 9.75,
   "text": "عذرخواهی؛ چون وقت ما تمام شده، فقط اجازه بدهید ده دقیقه سؤال‌جواب بدهیم که جواب چند تا سؤال هم داده باشیم.",
   "kind": "speech",
   "chapter": 0,
   "block": 4
  },
  {
   "i": 1,
   "start": 9.75,
   "end": 28.38,
   "text": "جانم، سلام بفرمایید.",
   "kind": "speech",
   "chapter": 0,
   "block": 4
  },
  {
   "i": 2,
   "start": 28.38,
   "end": 43.26,
   "text": "احسن.",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 3,
   "start": 43.26,
   "end": 47.7,
   "text": "نه تابعیت خدا، تابعیت **علم** خدا.",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 4,
   "start": 47.7,
   "end": 50.04,
   "text": "نه خودش؛ ذات غیبی نه.",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 5,
   "start": 50.04,
   "end": 53.43,
   "text": "علم خدا اسم الله است؛ العلیم.",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 6,
   "start": 53.43,
   "end": 60.04,
   "text": "اولاً این یک نکته: علم خدا تابعیت با اشخاص و افراد و زبان حالشان دارد. این یک.",
   "kind": "speech",
   "chapter": 0,
   "block": 7
  },
  {
   "i": 7,
   "start": 60.04,
   "end": 70.0,
   "text": "نکتهٔ بعدی اینکه وقتی می‌گوییم خدا تابع علم اشخاص است، نه یعنی اینکه در حرکت به سمت آن‌هاست.",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 8,
   "start": 70.0,
   "end": 73.88,
   "text": "نه؛ آن شخص به سمت خدا حرکت می‌کند.",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 9,
   "start": 73.88,
   "end": 77.46,
   "text": "اصلاً آن شخص چیست؟ هر شیء چیست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 10,
   "start": 77.46,
   "end": 87.52,
   "text": "ظهور اسم الله دیگر. و «وهرعت الموجودات عن بسم الله الرحمن الرحیم» بسم الله الرحمن الرحیم که اسم خداست ظهور کرده شده این شخص.",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 11,
   "start": 87.52,
   "end": 91.244,
   "text": "پس این شخص «إنا لله» که آمد، حالا «إنا إليه راجعون» به سمت او برمی‌گردد.",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 12,
   "start": 91.244,
   "end": 92.14,
   "text": "«إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ» (بقره/۲:۱۵۶)",
   "kind": "quote",
   "chapter": 0,
   "block": 9,
   "translation": "ما از آنِ خداییم و به سوی او بازمی‌گردیم."
  },
  {
   "i": 13,
   "start": 92.14,
   "end": 102.9,
   "text": "منتها اسباب و لوازمی که آن نفسِ کینونه از من و اَمکِنه زمان و مکانی که خدا برایش قرار می‌دهد مطابق با خواست درونی آن شخص است.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 14,
   "start": 102.9,
   "end": 105.54,
   "text": "این حرکت خدا نیست؛",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 15,
   "start": 105.54,
   "end": 110.62,
   "text": "این لطف خداست به آن شخص.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 16,
   "start": 110.62,
   "end": 116.06,
   "text": "البته می‌شود گفت حرکت اسباب هست.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 17,
   "start": 116.06,
   "end": 121.58,
   "text": "یعنی گفتیم کل ممکن زوج ترکیبی است؛",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 18,
   "start": 121.58,
   "end": 126.48,
   "text": "هر ممکنی زوجی است از وجود و ماهیت و حرکت دارد.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 19,
   "start": 126.48,
   "end": 130.34,
   "text": "خب اسباب و لوازم باید به سوی آن شخص حرکت کنند.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 20,
   "start": 130.34,
   "end": 132.16,
   "text": "خدا حرکت نمی‌کند.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 21,
   "start": 132.16,
   "end": 138.68,
   "text": "ملائکه به سمت او حرکت می‌کنند ملائکه گاهی ارضی، گاهی سماوی.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 22,
   "start": 138.68,
   "end": 144.6,
   "text": "حتی امام عصر. امام عصر که انسان کامل است و مدبّر تمام ملائکه؛",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 23,
   "start": 144.6,
   "end": 147.26,
   "text": "سدنه و خدمهٔ او هستند.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 24,
   "start": 147.26,
   "end": 152.92,
   "text": "او به سمت شما به واسطهٔ زبان حالتان حرکت می‌کند.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 25,
   "start": 152.92,
   "end": 155.66,
   "text": "آیا امام عصر محتاج شماست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 26,
   "start": 155.66,
   "end": 159.2,
   "text": "نه. این حرکت را از روی احتیاج نباید بگیریم.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 27,
   "start": 159.2,
   "end": 161.84,
   "text": "شاید بهتر باشد این مثال را بزنم.",
   "kind": "speech",
   "chapter": 0,
   "block": 12
  },
  {
   "i": 28,
   "start": 161.84,
   "end": 169.64,
   "text": "بارها عرض کردیم و حدیث قدسی که مرحوم خدا رحمتشان کند میرداماد در کتاب کامل بهائی آورده‌اند:",
   "kind": "speech",
   "chapter": 0,
   "block": 12
  },
  {
   "i": 29,
   "start": 169.64,
   "end": 174.16,
   "text": "«كُنْتُ كَنْزًا مَخْفِيًّا فَأَحْبَبْتُ أَنْ أُعْرَفَ فَخَلَقْتُ الْخَلْقَ لِكَيْ أُعْرَفَ»",
   "kind": "quote",
   "chapter": 0,
   "block": 13,
   "translation": "گنجِ پنهان بودم؛ دوست داشتم شناخته شوم؛ پس خلق را آفریدم تا شناخته شوم."
  },
  {
   "i": 30,
   "start": 174.16,
   "end": 177.52,
   "text": "من گنج مخفی بودم؛ دوست داشتم آشکار شوم.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 31,
   "start": 177.52,
   "end": 179.42,
   "text": "خب خدا چه کردی که آشکار بشوی؟",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 32,
   "start": 179.42,
   "end": 186.16,
   "text": "«فخلقت» خلق را خلق کردم تا شناخته بشوم.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 33,
   "start": 186.16,
   "end": 189.8,
   "text": "آیا خدا محتاج شناخت‌شدن است؟",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 34,
   "start": 189.8,
   "end": 194.12,
   "text": "خدا محتاج نیست. فرمود «احببت» دوست دارم.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 35,
   "start": 194.12,
   "end": 199.38,
   "text": "پس اگر حرکت بگیریم، عالم در حرکت است، در حرکتِ حُبّی الهی؛",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 36,
   "start": 199.38,
   "end": 204.06,
   "text": "اما اسباب و لوازم در حرکت‌اند نه حضرت حق.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 37,
   "start": 204.06,
   "end": 208.1,
   "text": "اسباب و لوازم به سمت بنده حرکت می‌کنند.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 38,
   "start": 208.1,
   "end": 214.68,
   "text": "اصلاً شاید جواب شما باز تو این باشد: خدا «قوله فعل».",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 39,
   "start": 214.68,
   "end": 216.54,
   "text": "قول خدا چیست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 40,
   "start": 216.54,
   "end": 219.76,
   "text": "فعلش. یعنی چه؟",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 41,
   "start": 219.76,
   "end": 223.6,
   "text": "یعنی اتفاقی که افتاد قول خداست.",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 42,
   "start": 223.6,
   "end": 230.0,
   "text": "اگر در مسیر حق قدم برداشتی، این را فعل خدا بدان؛",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 43,
   "start": 230.0,
   "end": 232.06,
   "text": "قول خدا یعنی از تو راضی است یا نه؟",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 44,
   "start": 232.06,
   "end": 234.1,
   "text": "می‌خواهد به تو بگوید من از تو راضیم یا نه.",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 45,
   "start": 234.1,
   "end": 237.82,
   "text": "اگر تو مسیر حق داری حرکت می‌کنی، قوله فعل.",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 46,
   "start": 237.82,
   "end": 251.0,
   "text": "این فعلیتِ «لا حول و لا قوة إلا بالله العلی العظیم» به حول و قوة الهی می‌شود رضایت خاطر الهی.",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 47,
   "start": 251.0,
   "end": 253.6,
   "text": "کلام خدا فعلش است.",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 48,
   "start": 253.6,
   "end": 255.847,
   "text": "آن فعل در حرکت است؛",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 49,
   "start": 255.847,
   "end": 267.62,
   "text": "آن اسباب، آن لوازم نه خود حضرت حق.",
   "kind": "speech",
   "chapter": 0,
   "block": 16
  },
  {
   "i": 50,
   "start": 267.62,
   "end": 271.44,
   "text": "یک شأنی از حضرت حق حرکت؟",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 51,
   "start": 271.44,
   "end": 274.82,
   "text": "بله؛ در مرتبهٔ مادون بله.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 52,
   "start": 274.82,
   "end": 285.52,
   "text": "بله احسن. آن هم باز چون ما شأنی از شئون حضرت حق هستیم و در حرکت هستیم، شئون حق در حرکت‌اند هم عرض کردم که لوازم، اسباب، اسماء؛",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 53,
   "start": 285.52,
   "end": 290.62,
   "text": "اسماء در حرکت هستند اما خود ذات غیبی نه.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 54,
   "start": 290.62,
   "end": 292.15,
   "text": "ذات غیبی ثابت است.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 55,
   "start": 292.15,
   "end": 300.54,
   "text": "اسماء خدا فعال‌اند.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 56,
   "start": 300.54,
   "end": 302.3,
   "text": "خدا فعال لما یشاء است.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 57,
   "start": 302.3,
   "end": 306.68,
   "text": "بچه‌ها می‌فهمید مثل کلک و این اختیار ما و غیره.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 58,
   "start": 306.68,
   "end": 310.28,
   "text": "باز همهٔ این‌ها را ما می‌آوریم داخل علم خدا.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 59,
   "start": 310.28,
   "end": 324.52,
   "text": "چیزی خارج از حیطهٔ علم الهی نیست؛",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 60,
   "start": 324.52,
   "end": 328.38,
   "text": "همان‌طور که حرکت ما خارج از حیطهٔ قدرت الهی نیست.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 61,
   "start": 328.38,
   "end": 330.96,
   "text": "ببینید شما به نظرم دارید قاطی می‌کنید؛",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 62,
   "start": 330.96,
   "end": 333.44,
   "text": "یک چیزی خلط بحث شده.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 63,
   "start": 333.44,
   "end": 337.18,
   "text": "ذات غیبی را با اسماء دارید قاطی می‌کنید.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 64,
   "start": 337.18,
   "end": 340.8,
   "text": "ذات غیبی درست است اسمائش عین ذات‌اند؛",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 65,
   "start": 340.8,
   "end": 347.72,
   "text": "اما آن ذات خواسته ظهور کند شده اسماء، شده این کائنات، شده خلائق، شده کثرات.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 66,
   "start": 347.72,
   "end": 349.72,
   "text": "این کثرات در حرکت‌اند.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 67,
   "start": 349.72,
   "end": 355.2,
   "text": "این اسماء این خارج از ذات در حرکت‌اند.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 68,
   "start": 355.2,
   "end": 364.0,
   "text": "اما ذات غیبی که حرکت ندارد. جانم.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 69,
   "start": 364.0,
   "end": 375.96,
   "text": "بله. «کل یوم هو فی شأن» با علم الهی.",
   "kind": "speech",
   "chapter": 0,
   "block": 20
  },
  {
   "i": 70,
   "start": 375.96,
   "end": 381.62,
   "text": "کل یوم هو فی شأن.",
   "kind": "speech",
   "chapter": 0,
   "block": 20
  },
  {
   "i": 71,
   "start": 381.62,
   "end": 383.96,
   "text": "الیوم چی بود رفقا؟",
   "kind": "speech",
   "chapter": 0,
   "block": 20
  },
  {
   "i": 72,
   "start": 383.96,
   "end": 386.44,
   "text": "بچه‌های مسجد بلال بگویند ببینم.",
   "kind": "speech",
   "chapter": 0,
   "block": 20
  },
  {
   "i": 73,
   "start": 386.44,
   "end": 390.84,
   "text": "یوم چی بود؟ یوم یعنی نه.",
   "kind": "speech",
   "chapter": 0,
   "block": 20
  },
  {
   "i": 74,
   "start": 390.84,
   "end": 393.9,
   "text": "آفرین به خواهرها: **ظرف ظهور اشیا**.",
   "kind": "speech",
   "chapter": 0,
   "block": 20
  },
  {
   "i": 75,
   "start": 393.9,
   "end": 398.1,
   "text": "این‌ها را باید بدانیم دیگر. ظرف ظهور بهش می‌گویند یوم.",
   "kind": "speech",
   "chapter": 0,
   "block": 20
  },
  {
   "i": 76,
   "start": 398.1,
   "end": 409.94,
   "text": "این را یادتان باشد. کل یوم یعنی در هر ظرف ظهوری، هو آن هویی که الان عرض کردیم فی شأن؛ توی شأن است.",
   "kind": "speech",
   "chapter": 0,
   "block": 20
  },
  {
   "i": 77,
   "start": 409.94,
   "end": 410.58,
   "text": "قبلش می‌گوید:",
   "kind": "speech",
   "chapter": 0,
   "block": 21
  },
  {
   "i": 78,
   "start": 410.58,
   "end": 416.88,
   "text": "«يَسْأَلُهُ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِي شَأْنٍ» (رحمن/۵۵:۲۹)",
   "kind": "quote",
   "chapter": 0,
   "block": 22,
   "translation": "هر که در آسمان‌ها و زمین است از او می‌خواهد؛ هر روز او در کاری است."
  },
  {
   "i": 79,
   "start": 416.88,
   "end": 419.26,
   "text": "«یسأله» فعل مضارع است دیگر.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 80,
   "start": 419.26,
   "end": 425.37,
   "text": "دائماً آن‌به‌آن، من فی السماوات والأرض آنچه در آسمان و زمین است یسأله؛",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 81,
   "start": 425.37,
   "end": 428.0,
   "text": "دارند گدایی می‌کنند از خدا.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 82,
   "start": 428.0,
   "end": 431.28,
   "text": "همان زبان حالشان است. طلب می‌کنند از خدا.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 83,
   "start": 431.28,
   "end": 439.04,
   "text": "خدا چگونه جواب می‌دهد؟ کل یوم در این ظرفی که دارد ظهور می‌کند یعنی اندازهٔ هر شیء؛",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 84,
   "start": 439.04,
   "end": 441.8,
   "text": "هر به یک معنا بگیریم اسم الله.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 85,
   "start": 441.8,
   "end": 451.08,
   "text": "شما اگر اسم الله باشی، آیت الله باشی، یک ظرف ظهوری داری که در این ظرف وجودی شما، صاع وجودی شما دارد ظهور می‌کند، آشکار می‌شود.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 86,
   "start": 451.08,
   "end": 454.5,
   "text": "این چیست که دارد آشکار می‌شود؟",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 87,
   "start": 454.5,
   "end": 456.83,
   "text": "شما به خودی خود داری آشکار می‌شوی؟",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 88,
   "start": 456.83,
   "end": 459.84,
   "text": "آن تجلیات الهیه است.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 89,
   "start": 459.84,
   "end": 469.58,
   "text": "خدا دارد تجلی می‌کند آن‌به‌آن در وجود تمام خلائق و کثراتی که هستند، موجودند و در حال ظهور و بروزند.",
   "kind": "speech",
   "chapter": 0,
   "block": 24
  },
  {
   "i": 90,
   "start": 469.58,
   "end": 473.22,
   "text": "خدا چگونه ظهور می‌کند؟ اصلاً همان که می‌گوییم ظهور مرتبه چیست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 25
  },
  {
   "i": 91,
   "start": 473.22,
   "end": 476.44,
   "text": "اسماء با اسمائش. لذا فرمود:",
   "kind": "speech",
   "chapter": 0,
   "block": 25
  },
  {
   "i": 92,
   "start": 476.44,
   "end": 479.4,
   "text": "«وَعَلَّمَ ءَادَمَ ٱلْأَسْمَآءَ كُلَّهَا» (بقره/۲:۳۱)",
   "kind": "quote",
   "chapter": 0,
   "block": 26,
   "translation": "و به آدم همهٔ نام‌ها را آموخت."
  },
  {
   "i": 93,
   "start": 479.4,
   "end": 484.6,
   "text": "حضرت استاد فرمودند می‌توانید بگویید «أی الأشیاء کلها» اشیاء اسم الله‌اند؛",
   "kind": "speech",
   "chapter": 0,
   "block": 28
  },
  {
   "i": 94,
   "start": 484.6,
   "end": 488.52,
   "text": "اسماء الهی‌اند. مرتبهٔ ظهور می‌شود اسماء.",
   "kind": "speech",
   "chapter": 0,
   "block": 28
  },
  {
   "i": 95,
   "start": 488.52,
   "end": 491.64,
   "text": "می‌شود خود حضرت عالی. خدا ظهور کرده.",
   "kind": "speech",
   "chapter": 0,
   "block": 28
  },
  {
   "i": 96,
   "start": 491.64,
   "end": 494.02,
   "text": "خدا با چی ظهور می‌کند؟ با اسمائش.",
   "kind": "speech",
   "chapter": 0,
   "block": 28
  },
  {
   "i": 97,
   "start": 494.02,
   "end": 497.58,
   "text": "آیا یکی از اسماء خدا العلیم هست یا نه؟",
   "kind": "speech",
   "chapter": 0,
   "block": 28
  },
  {
   "i": 98,
   "start": 497.58,
   "end": 505.86,
   "text": "ها؟ خب برای همین حضرت استاد می‌فرمایند عالم، علمِ انباشته‌شدهٔ روی هم است.",
   "kind": "speech",
   "chapter": 0,
   "block": 28
  },
  {
   "i": 99,
   "start": 505.86,
   "end": 510.0,
   "text": "در حقیقت همهٔ عوالم هستی تجلیات الهی‌اند.",
   "kind": "speech",
   "chapter": 0,
   "block": 28
  },
  {
   "i": 100,
   "start": 510.0,
   "end": 517.2,
   "text": "خدا دارد آن‌به‌آن ظهور می‌کند، بروز می‌کند، تجلی می‌کند که هر شیء موجود است آن‌به‌آن.",
   "kind": "speech",
   "chapter": 0,
   "block": 28
  },
  {
   "i": 101,
   "start": 517.2,
   "end": 519.24,
   "text": "«هُوَ يُحْيِي وَيُمِيتُ»",
   "kind": "quote",
   "chapter": 0,
   "block": 29,
   "translation": "او زنده می‌کند و می‌میراند. *(مضمون مکرر قرآن؛ مثلاً بقره/۲:۲۵۸، آل عمران/۳:۱۵۶ و …)*"
  },
  {
   "i": 102,
   "start": 519.24,
   "end": 524.74,
   "text": "آن تجلی قبلی یمیت مرد، می‌میرد.",
   "kind": "speech",
   "chapter": 0,
   "block": 31
  },
  {
   "i": 103,
   "start": 524.74,
   "end": 528.3,
   "text": "تجلی جدید یحیی زنده می‌شود.",
   "kind": "speech",
   "chapter": 0,
   "block": 31
  },
  {
   "i": 104,
   "start": 528.3,
   "end": 530.06,
   "text": "دوباره یمیت و یحیی؛",
   "kind": "speech",
   "chapter": 0,
   "block": 31
  },
  {
   "i": 105,
   "start": 530.06,
   "end": 534.26,
   "text": "یحیی و یمیت. هی دائماً آدم جدیدی هستیم.",
   "kind": "speech",
   "chapter": 0,
   "block": 31
  },
  {
   "i": 106,
   "start": 534.26,
   "end": 536.34,
   "text": "با چی آدم جدیدی هستیم؟",
   "kind": "speech",
   "chapter": 0,
   "block": 31
  },
  {
   "i": 107,
   "start": 536.34,
   "end": 538.14,
   "text": "با تجلیات الهی. آن‌ها چیستند؟",
   "kind": "speech",
   "chapter": 0,
   "block": 31
  },
  {
   "i": 108,
   "start": 538.14,
   "end": 540.645,
   "text": "اسماء الهی‌اند که در ما دارند ظهور می‌کنند.",
   "kind": "speech",
   "chapter": 0,
   "block": 31
  },
  {
   "i": 109,
   "start": 540.645,
   "end": 551.1,
   "text": "هرچه ما طهارت نفسمان بیشتر می‌شود، شدت ظهور اسماء در ما بیشتر می‌شود و به این می‌گویند مقام قرب قربتاً إلی الله.",
   "kind": "speech",
   "chapter": 0,
   "block": 31
  },
  {
   "i": 110,
   "start": 551.1,
   "end": 555.14,
   "text": "بهش می‌گویند ولایت؛ بهش می‌گویند علم.",
   "kind": "speech",
   "chapter": 0,
   "block": 31
  },
  {
   "i": 111,
   "start": 555.14,
   "end": 559.22,
   "text": "همهٔ اسماء به یک معنا برگشت به علم می‌کنند.",
   "kind": "speech",
   "chapter": 0,
   "block": 31
  },
  {
   "i": 112,
   "start": 559.22,
   "end": 563.26,
   "text": "«الْعِلْمُ نُورٌ يَقْذِفُهُ اللَّهُ فِي قَلْبِ مَنْ يَشَاءُ»",
   "kind": "quote",
   "chapter": 0,
   "block": 32,
   "translation": "علم نوری است که خدا در قلب هر که بخواهد می‌افکند. *(مأثور مشهور؛ در منابع شیعی از جمله مصباح الشریعه / منیة المرید و نقل علامه طباطبایی)*"
  },
  {
   "i": 113,
   "start": 563.26,
   "end": 566.16,
   "text": "یا «فی قلب من أراد أن یهدیه». و:",
   "kind": "speech",
   "chapter": 0,
   "block": 34
  },
  {
   "i": 114,
   "start": 566.16,
   "end": 570.245,
   "text": "«ٱللَّهُ نُورُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ» (نور/۲۴:۳۵)",
   "kind": "quote",
   "chapter": 0,
   "block": 35,
   "translation": "خدا نور آسمان‌ها و زمین است."
  },
  {
   "i": 115,
   "start": 570.245,
   "end": 579.82,
   "text": "یک روایتیتان باشد؛ عرض کردم خدمتتان حضرت آقای جوادی آملی در شرح اسفارشان فرمودند همان جلسهٔ اول شرح اسفار آقای جوادی را گوش بدهید؛",
   "kind": "speech",
   "chapter": 0,
   "block": 37
  },
  {
   "i": 116,
   "start": 579.82,
   "end": 588.2,
   "text": "همین را می‌فرمایند. خدا اسمش در عالم أدنی یعنی اینجا دانی، اینجا پایین‌ترین رتبه هست العلیم.",
   "kind": "speech",
   "chapter": 0,
   "block": 37
  },
  {
   "i": 117,
   "start": 588.2,
   "end": 596.04,
   "text": "در مرتبهٔ مافوق هست أعلم.",
   "kind": "speech",
   "chapter": 0,
   "block": 37
  },
  {
   "i": 118,
   "start": 596.04,
   "end": 599.14,
   "text": "در خود ذات چیست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 37
  },
  {
   "i": 119,
   "start": 599.14,
   "end": 602.92,
   "text": "خدا خود نترسید بگویید آفرین؛",
   "kind": "speech",
   "chapter": 0,
   "block": 37
  },
  {
   "i": 120,
   "start": 602.92,
   "end": 607.46,
   "text": "خود علم است. خدا خود علم است.",
   "kind": "speech",
   "chapter": 0,
   "block": 37
  },
  {
   "i": 121,
   "start": 607.46,
   "end": 614.16,
   "text": "هر چیزی نسبت به سعهٔ وجودیش اسم الهی درش ظهور پیدا کرده.",
   "kind": "speech",
   "chapter": 0,
   "block": 38
  },
  {
   "i": 122,
   "start": 614.16,
   "end": 618.08,
   "text": "هرکی وسیع‌تر، اسماء شدیدتر.",
   "kind": "speech",
   "chapter": 0,
   "block": 38
  },
  {
   "i": 123,
   "start": 618.08,
   "end": 620.84,
   "text": "شدت اسماء یعنی ولایت.",
   "kind": "speech",
   "chapter": 0,
   "block": 38
  },
  {
   "i": 124,
   "start": 620.84,
   "end": 622.6,
   "text": "چقدر شما ولایت داری؟",
   "kind": "speech",
   "chapter": 0,
   "block": 38
  },
  {
   "i": 125,
   "start": 622.6,
   "end": 627.68,
   "text": "بعد و قربت به امیرالمؤمنین که صاحب ولایت کلیه است چقدر است؟",
   "kind": "speech",
   "chapter": 0,
   "block": 38
  },
  {
   "i": 126,
   "start": 627.68,
   "end": 633.22,
   "text": "نسبت به اینکه چقدر از اسماء الهی در تو پیاده شده، این بعد و قرب شماست.",
   "kind": "speech",
   "chapter": 0,
   "block": 38
  },
  {
   "i": 127,
   "start": 633.22,
   "end": 638.1,
   "text": "اصلاً معنای قربتاً إلی الله یعنی این دیگر إلی الله یعنی علم، یعنی ولایت، یعنی قرب؛",
   "kind": "speech",
   "chapter": 0,
   "block": 38
  },
  {
   "i": 128,
   "start": 638.1,
   "end": 640.98,
   "text": "همه‌اش یک حقیقت است. اصلاً یعنی چه؟",
   "kind": "speech",
   "chapter": 0,
   "block": 38
  },
  {
   "i": 129,
   "start": 640.98,
   "end": 646.92,
   "text": "یعنی خدا چقدر در وجود حضرت عالی خودش را نشان داد.",
   "kind": "speech",
   "chapter": 0,
   "block": 38
  },
  {
   "i": 130,
   "start": 646.92,
   "end": 649.88,
   "text": "حالا این دو جور است، دو طور.",
   "kind": "speech",
   "chapter": 0,
   "block": 40
  },
  {
   "i": 131,
   "start": 649.88,
   "end": 659.72,
   "text": "طور أنزلش قرب نافله است که تو سعی می‌کنی یک کارهایی بکنی که خدا به سمت تو نازل بشود:",
   "kind": "speech",
   "chapter": 0,
   "block": 40
  },
  {
   "i": 132,
   "start": 659.72,
   "end": 661.98,
   "text": "«تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ» (قدر/۹۷:۴)",
   "kind": "quote",
   "chapter": 0,
   "block": 41,
   "translation": "فرشتگان و روح فرود می‌آیند."
  },
  {
   "i": 133,
   "start": 661.98,
   "end": 666.64,
   "text": "خدا نازل می‌شود. تو این جرأت و این جسارت را داری انقدر پررویی؛",
   "kind": "speech",
   "chapter": 0,
   "block": 43
  },
  {
   "i": 134,
   "start": 666.64,
   "end": 673.12,
   "text": "خودم را می‌گویم که حق را نازل می‌کنی که بیاید در تو تجلی کند.",
   "kind": "speech",
   "chapter": 0,
   "block": 43
  },
  {
   "i": 135,
   "start": 673.12,
   "end": 676.48,
   "text": "این می‌شود أنزل مراتب.",
   "kind": "speech",
   "chapter": 0,
   "block": 43
  },
  {
   "i": 136,
   "start": 676.48,
   "end": 680.24,
   "text": "اما بهترش کاری است که اهل‌بیت کردند:",
   "kind": "speech",
   "chapter": 0,
   "block": 43
  },
  {
   "i": 137,
   "start": 680.24,
   "end": 683.26,
   "text": "«صَلُّوا كَمَا رَأَيْتُمُونِي أُصَلِّي»",
   "kind": "quote",
   "chapter": 0,
   "block": 44,
   "translation": "چنان نماز بخوانید که مرا دیدید نماز می‌خوانم. *(حدیث مشهور نبوی)*"
  },
  {
   "i": 138,
   "start": 683.26,
   "end": 685.15,
   "text": "آن‌طوری نماز بخوان که ما خواندیم.",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 139,
   "start": 685.15,
   "end": 687.96,
   "text": "اهل‌بیت اجازه ندادند حق نازل بشود؛",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 140,
   "start": 687.96,
   "end": 689.72,
   "text": "خودشان معراج رفتند.",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 141,
   "start": 689.72,
   "end": 691.63,
   "text": "«الصلاة معراج المؤمن».",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 142,
   "start": 691.63,
   "end": 693.34,
   "text": "آن‌ها رفتند بالا؛",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 143,
   "start": 693.34,
   "end": 697.32,
   "text": "خودشان آن‌ها شدند ید الله، عین الله، أذن الله.",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 144,
   "start": 697.32,
   "end": 701.13,
   "text": "خب؟ به این می‌گویند قرب فریضه.",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 145,
   "start": 701.13,
   "end": 705.12,
   "text": "اما در قرب نافله به عکس است: خدا نازل می‌شود، می‌شود چشم تو، می‌شود زبانت؛",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 146,
   "start": 705.12,
   "end": 712.78,
   "text": "و این هم خوب است. اما این مرتبهٔ نازله است که یادتان باشد در بحث اربعین تو مسجد بلال چه گفتید؟",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 147,
   "start": 712.78,
   "end": 714.55,
   "text": "یادگاری در گوشی گفتید؛",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 148,
   "start": 714.55,
   "end": 717.22,
   "text": "گفتید اربعین قرب فریضه است.",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 149,
   "start": 717.22,
   "end": 719.84,
   "text": "این‌قدر هم تأکید روش شده: قرب فریضه، فریضه.",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 150,
   "start": 719.84,
   "end": 723.46,
   "text": "شما حرکت می‌کنی به سمت سیدالشهدا.",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 151,
   "start": 723.46,
   "end": 730.96,
   "text": "اما در شب قدر حضرت زهرا نازل می‌شود به واسطهٔ الهی «تنزل الملائکة والروح» آن روح، روح اعظم حضرت زهرا بود.",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 152,
   "start": 730.96,
   "end": 732.8,
   "text": "می‌آید همهٔ ملائکه به همراهش می‌آیند.",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 153,
   "start": 732.8,
   "end": 734.36,
   "text": "آنان و حق نازل می‌شود.",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 154,
   "start": 734.36,
   "end": 740.2,
   "text": "تنزل الملائکه. این قرب نافله است.",
   "kind": "speech",
   "chapter": 0,
   "block": 46
  },
  {
   "i": 155,
   "start": 740.2,
   "end": 742.68,
   "text": "ده دقیقه فکر کنم بیشتر هم شد؛",
   "kind": "speech",
   "chapter": 0,
   "block": 47
  },
  {
   "i": 156,
   "start": 742.68,
   "end": 747.87,
   "text": "یازده دقیقه شد. شما هم سؤالت را بپرس دیگر؛ بس است.",
   "kind": "speech",
   "chapter": 0,
   "block": 47
  },
  {
   "i": 157,
   "start": 747.87,
   "end": 754.995,
   "text": "آقای دکتر: این تبعیت دل خدا از ما همان فیض و علم الهی که دائماً هست نمی‌شود به ظرف ما مربوط باشد؟",
   "kind": "speech",
   "chapter": 0,
   "block": 49
  },
  {
   "i": 158,
   "start": 754.995,
   "end": 757.495,
   "text": "همه‌چیز به ظرف ما مربوط است.",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 159,
   "start": 757.495,
   "end": 762.06,
   "text": "همه‌چیز. آن علمی که دائماً هست با ظرف خودمان که دیگر هست و محدود.",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 160,
   "start": 762.06,
   "end": 764.26,
   "text": "بله دیگر. خدا را می‌شود بازتعریف کرد؛",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 161,
   "start": 764.26,
   "end": 766.74,
   "text": "با آن ظرف خودمان مربوط می‌شود دیگر در حقیقت.",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 162,
   "start": 766.74,
   "end": 771.58,
   "text": "آن علمی که دائماً در جریان است، آن علم نازل دارد می‌شود.",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 163,
   "start": 771.58,
   "end": 777.34,
   "text": "سؤال، سؤال خوبی است. دائماً علم الهی در فیضان است.",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 164,
   "start": 777.34,
   "end": 779.312,
   "text": "رشح، رشح مثل باران.",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 165,
   "start": 779.312,
   "end": 781.148,
   "text": "باران دارد می‌ریزد.",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 166,
   "start": 781.148,
   "end": 788.6,
   "text": "یادتان هست عرض کردم خدمتتان: فیض الهی همان‌قدر که به سر اولیای خدا دارد می‌ریزد، سر ما هم دارد می‌ریزد.",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 167,
   "start": 788.6,
   "end": 790.94,
   "text": "این فیض چیست؟ اسماء الهیه.",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 168,
   "start": 790.94,
   "end": 793.42,
   "text": "خب حالا بگویید شما علم.",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 169,
   "start": 793.42,
   "end": 795.68,
   "text": "اما هر کسی چقدر برمی‌دارد؟",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 170,
   "start": 795.68,
   "end": 800.02,
   "text": "ظرف وجودیش. یعنی اندازهٔ وجودی شما چقدر است؟",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 171,
   "start": 800.02,
   "end": 803.74,
   "text": "همان‌قدر بهره می‌برد. بله، همین‌طور.",
   "kind": "speech",
   "chapter": 0,
   "block": 50
  },
  {
   "i": 172,
   "start": 803.74,
   "end": 810.42,
   "text": "یک سؤالی هم خواهرها نوشته‌اند؛ اجازه بدهید به حرمت حضور خواهرها که به هر حال سؤالات آن‌ها را هم جواب داده باشیم.",
   "kind": "speech",
   "chapter": 0,
   "block": 52
  },
  {
   "i": 173,
   "start": 810.42,
   "end": 819.01,
   "text": "با عرض سلام: انتخاب ما در عین ثابت چه ظرفی بوده؟",
   "kind": "speech",
   "chapter": 0,
   "block": 53
  },
  {
   "i": 174,
   "start": 819.01,
   "end": 822.48,
   "text": "بر چه اساسی خواستیم این شویم؟",
   "kind": "speech",
   "chapter": 0,
   "block": 53
  },
  {
   "i": 175,
   "start": 822.48,
   "end": 831.18,
   "text": "آیا هر لحظه ما و عین ثابته در حال انتخاب نیست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 53
  },
  {
   "i": 176,
   "start": 831.18,
   "end": 836.22,
   "text": "پس هر لحظه تغییر و هر لحظه عین متغیر می‌باشند.",
   "kind": "speech",
   "chapter": 0,
   "block": 53
  },
  {
   "i": 177,
   "start": 836.22,
   "end": 840.24,
   "text": "بله، دقیقاً. شما سؤالتان را خودتان جواب دادید.",
   "kind": "speech",
   "chapter": 0,
   "block": 54
  },
  {
   "i": 178,
   "start": 840.24,
   "end": 845.66,
   "text": "عین ثابت ما قابل تغییر هست یا نیست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 54
  },
  {
   "i": 179,
   "start": 845.66,
   "end": 847.22,
   "text": "درست است ثابت است؛",
   "kind": "speech",
   "chapter": 0,
   "block": 54
  },
  {
   "i": 180,
   "start": 847.22,
   "end": 859.64,
   "text": "اما به عنایت حضرت حق با وساطت وسایل فیض الهی که اولیای خدا، ائمهٔ هدی علیهم الصلاة والسلام هستند، به میزانی که چه مقدار از قرآن در ما پیاده",
   "kind": "speech",
   "chapter": 0,
   "block": 54
  },
  {
   "i": 181,
   "start": 859.64,
   "end": 865.56,
   "text": "بشود قابل چیست؟ اتساع وجودی.",
   "kind": "speech",
   "chapter": 0,
   "block": 54
  },
  {
   "i": 182,
   "start": 865.56,
   "end": 867.76,
   "text": "اتساع وجودی با چی حاصل می‌شود؟",
   "kind": "speech",
   "chapter": 0,
   "block": 54
  },
  {
   "i": 183,
   "start": 867.76,
   "end": 869.9,
   "text": "معاشرت با اولیا.",
   "kind": "speech",
   "chapter": 0,
   "block": 54
  },
  {
   "i": 184,
   "start": 869.9,
   "end": 874.08,
   "text": "عاشورا. معاشرت با عاشورا اتساع می‌آورد.",
   "kind": "speech",
   "chapter": 0,
   "block": 54
  },
  {
   "i": 185,
   "start": 874.08,
   "end": 879.04,
   "text": "یعنی در حقیقت این‌طوری می‌شود: زبان حالت را عوض می‌کند.",
   "kind": "speech",
   "chapter": 0,
   "block": 54
  },
  {
   "i": 186,
   "start": 879.04,
   "end": 882.58,
   "text": "اصلاً آیا می‌شود به عین ثابت رسید؟",
   "kind": "speech",
   "chapter": 0,
   "block": 55
  },
  {
   "i": 187,
   "start": 882.58,
   "end": 885.28,
   "text": "می‌شود آدم بفهمد عین ثابتش چی بوده؟",
   "kind": "speech",
   "chapter": 0,
   "block": 55
  },
  {
   "i": 188,
   "start": 885.28,
   "end": 894.293,
   "text": "اصلاً زبان حالش چی بوده؟ حضرت علامه در شرح مصباح الأنس ابن فناری می‌فرماید بله شدنی است اما بسیار سخت است.",
   "kind": "speech",
   "chapter": 0,
   "block": 55
  },
  {
   "i": 189,
   "start": 894.293,
   "end": 900.16,
   "text": "آحاد از اولیاء الله می‌توانند برسند به اینکه آن زبان حال اولی‌شان را پیدا کنند.",
   "kind": "speech",
   "chapter": 0,
   "block": 55
  },
  {
   "i": 190,
   "start": 900.16,
   "end": 908.78,
   "text": "خب به چه درد می‌خورد؟ وقتی شما بدانی اساساً برای چی نازل شدی، زبان حال خودت را بدانی، در آن مسیر حرکت می‌کنی دیگر.",
   "kind": "speech",
   "chapter": 0,
   "block": 56
  },
  {
   "i": 191,
   "start": 908.78,
   "end": 911.02,
   "text": "دیگر وقتت را مضمحل نمی‌کنی جاهای دیگر.",
   "kind": "speech",
   "chapter": 0,
   "block": 56
  },
  {
   "i": 192,
   "start": 911.02,
   "end": 913.16,
   "text": "از این شاخه به آن شاخه نمی‌پری.",
   "kind": "speech",
   "chapter": 0,
   "block": 56
  },
  {
   "i": 193,
   "start": 913.16,
   "end": 923.64,
   "text": "یک. دو: می‌توانی تشخیص بدهی که زبان حالت اشتباه بود یا نبود و به اسم الجابر حضرت حق پناه ببری تا خدا جبران کند برایت.",
   "kind": "speech",
   "chapter": 0,
   "block": 56
  },
  {
   "i": 194,
   "start": 923.64,
   "end": 925.5,
   "text": "اصلاً چرا آمدیم تو این دنیا؟",
   "kind": "speech",
   "chapter": 0,
   "block": 57
  },
  {
   "i": 195,
   "start": 925.5,
   "end": 927.8,
   "text": "یک وجهش این است برای جبران؛",
   "kind": "speech",
   "chapter": 0,
   "block": 57
  },
  {
   "i": 196,
   "start": 927.8,
   "end": 938.35,
   "text": "برای اینکه پناه ببریم در سایهٔ اسم الجابر حضرت حق جبران کنیم زیاده‌خواهی‌مان را، اشتباه‌خواهی را. اصلاً در عالم ذر:",
   "kind": "speech",
   "chapter": 0,
   "block": 57
  },
  {
   "i": 197,
   "start": 938.35,
   "end": 940.18,
   "text": "«أَلَسْتُ بِرَبِّكُمْ ۖ قَالُوا۟ بَلَىٰ» (اعراف/۷:۱۷۲)",
   "kind": "quote",
   "chapter": 0,
   "block": 58,
   "translation": "آیا من پروردگار شما نیستم؟ گفتند: آری."
  },
  {
   "i": 198,
   "start": 940.18,
   "end": 944.9,
   "text": "همه گفتند بله. چرا پس الان این‌همه مشرک و منافق و کفار داریم؟",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 199,
   "start": 944.9,
   "end": 947.78,
   "text": "این کفر از کجا شروع شد؟",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 200,
   "start": 947.78,
   "end": 955.52,
   "text": "از اینکه بعد نبوت خاتم الانبیا را تعهد گرفت خدا آنجا در عالم عهد.",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 201,
   "start": 955.52,
   "end": 958.06,
   "text": "یک مکثی اتفاق افتاد.",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 202,
   "start": 958.06,
   "end": 968.22,
   "text": "بعد به ولایت امیرالمؤمنین که رسید حالا مکث کردن بعد همه پذیرفتند خاتم الانبیا را، نبوت خاتم ایشان را؛",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 203,
   "start": 968.22,
   "end": 972.04,
   "text": "اما در خصوص ولایت امیرالمؤمنین مکث شد و ماندند.",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 204,
   "start": 972.04,
   "end": 974.64,
   "text": "یعنی بسیاری اصلاً قبول نکردند.",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 205,
   "start": 974.64,
   "end": 981.3,
   "text": "برای همین سر خوردیم، هبوط پیدا کردیم به عالم دنیا که بیاییم اینجا باز لطف خدا بود، نبود؟",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 206,
   "start": 981.3,
   "end": 983.78,
   "text": "نمی‌شد همان‌جا کار تمام شود بگوید خب دیگر تمام شد؛",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 207,
   "start": 983.78,
   "end": 986.58,
   "text": "بفرمایید به جهنم، بفرمایید به بهشت.",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 208,
   "start": 986.58,
   "end": 992.36,
   "text": "خدا فرمود بروید تو دنیا تا من ارسال رسل و انزال کتب کنم؛",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 209,
   "start": 992.36,
   "end": 995.64,
   "text": "بتوانید انتخاب اشتباهتان را جبران کنید.",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 210,
   "start": 995.64,
   "end": 1002.29,
   "text": "به چه واسطه‌ای؟ به اسم الجابر بلکه الجبار حضرت حق. به شدت جبران‌کننده است:",
   "kind": "speech",
   "chapter": 0,
   "block": 60
  },
  {
   "i": 211,
   "start": 1002.29,
   "end": 1004.92,
   "text": "«يَا جَابِرَ الْعَظْمِ الْكَسِيرِ»",
   "kind": "quote",
   "chapter": 0,
   "block": 61,
   "translation": "ای جوش‌دهندهٔ استخوان شکسته. *(فرازی از ادعیه)*"
  },
  {
   "i": 212,
   "start": 1004.92,
   "end": 1006.6,
   "text": "ما در انتخابمان اشتباه هم کردیم.",
   "kind": "speech",
   "chapter": 0,
   "block": 63
  },
  {
   "i": 213,
   "start": 1006.6,
   "end": 1015.68,
   "text": "این سرِ انتخاب یعنی اینکه انسان با تلاشش برسد به عین ثابتش این حسن را دارد، این رشد را دارد.",
   "kind": "speech",
   "chapter": 0,
   "block": 63
  },
  {
   "i": 214,
   "start": 1015.68,
   "end": 1021.5,
   "text": "حالا بیا تا نرسیده؛ ما که می‌دانیم اشتباه کردیم تو خیلی جاها، خب؟",
   "kind": "speech",
   "chapter": 0,
   "block": 63
  },
  {
   "i": 215,
   "start": 1021.5,
   "end": 1024.7,
   "text": "جبرانش کنیم. کجا جبران هست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 63
  },
  {
   "i": 216,
   "start": 1024.7,
   "end": 1027.38,
   "text": "کجا شدت نزول اسماء هست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 63
  },
  {
   "i": 217,
   "start": 1027.38,
   "end": 1029.58,
   "text": "در دامن اولیا، در امیرالمؤمنین.",
   "kind": "speech",
   "chapter": 0,
   "block": 63
  },
  {
   "i": 218,
   "start": 1029.58,
   "end": 1033.64,
   "text": "همهٔ ولایت را برداشته؛ یعنی همهٔ اسماء را برداشته.",
   "kind": "speech",
   "chapter": 0,
   "block": 63
  },
  {
   "i": 219,
   "start": 1033.64,
   "end": 1035.19,
   "text": "لذا فرمود؛ پیغمبر فرمود:",
   "kind": "speech",
   "chapter": 0,
   "block": 63
  },
  {
   "i": 220,
   "start": 1035.19,
   "end": 1038.2,
   "text": "«مَنْ رَآنِي فَقَدْ رَأَى اللَّهَ»",
   "kind": "quote",
   "chapter": 0,
   "block": 64,
   "translation": "هر که مرا دید، خدا را دیده است. *(ASR: «فقط رأی الله»؛ صورت رایج‌تر در بعضی نقل‌ها «فقد رأى الحق»؛ اینجا مطابق مضمون جلسه دربارهٔ انسان کامل و پیاده‌شدن همهٔ اسماء)*"
  },
  {
   "i": 221,
   "start": 1038.2,
   "end": 1040.26,
   "text": "الله را دیدی اگر منو دیدی.",
   "kind": "speech",
   "chapter": 0,
   "block": 66
  },
  {
   "i": 222,
   "start": 1040.26,
   "end": 1042.84,
   "text": "عجب! چون همهٔ اسماء آنجا پیاده شدند.",
   "kind": "speech",
   "chapter": 0,
   "block": 66
  },
  {
   "i": 223,
   "start": 1042.84,
   "end": 1045.23,
   "text": "با او جبران می‌شود.",
   "kind": "speech",
   "chapter": 0,
   "block": 66
  },
  {
   "i": 224,
   "start": 1045.23,
   "end": 1053.84,
   "text": "آنجا که امام رضا فرمود «معنا فی درجاتنا» همراه ما، هم‌درجهٔ ما کی‌اند؟",
   "kind": "speech",
   "chapter": 0,
   "block": 67
  },
  {
   "i": 225,
   "start": 1053.84,
   "end": 1063.46,
   "text": "کسی که جلسه‌ای را به پا کند در آن جلسه ذکر ما گفته شود به گونه‌ای که «احیا امرنا» امر ما احیا بشود.",
   "kind": "speech",
   "chapter": 0,
   "block": 67
  },
  {
   "i": 226,
   "start": 1063.46,
   "end": 1067.98,
   "text": "امر ولایت ما تو آن جلسه احیا بشود مثل این جلسات.",
   "kind": "speech",
   "chapter": 0,
   "block": 67
  },
  {
   "i": 227,
   "start": 1067.98,
   "end": 1070.94,
   "text": "این‌ها «معنا فی درجاتنا».",
   "kind": "speech",
   "chapter": 0,
   "block": 67
  },
  {
   "i": 228,
   "start": 1070.94,
   "end": 1073.8,
   "text": "الله اکبر. این همان اسم جابر حضرت حق است؛",
   "kind": "speech",
   "chapter": 0,
   "block": 67
  },
  {
   "i": 229,
   "start": 1073.8,
   "end": 1075.833,
   "text": "بلکه جبار است. جبران می‌کند.",
   "kind": "speech",
   "chapter": 0,
   "block": 67
  },
  {
   "i": 230,
   "start": 1075.833,
   "end": 1076.189,
   "text": "*(نقل نزدیک در روایات رضا علیه‌السلام: من تذکر مصابنا کان معنا فی درجتنا یوم القیامة؛ و من جلس مجلساً یحیی فیه أمرنا و نیز «رحم الله عبداً أحیا",
   "kind": "speech",
   "chapter": 0,
   "block": 68
  },
  {
   "i": 231,
   "start": 1076.189,
   "end": 1076.96,
   "text": "أمرنا» عیون معانی الأخبار.)*",
   "kind": "speech",
   "chapter": 0,
   "block": 68
  },
  {
   "i": 232,
   "start": 1076.96,
   "end": 1080.76,
   "text": "خب کجا جلسه بگذارم؟ تو عالم ذر؟",
   "kind": "speech",
   "chapter": 0,
   "block": 69
  },
  {
   "i": 233,
   "start": 1080.76,
   "end": 1085.14,
   "text": "تو بهشت و جهنم؟ آنجا که کار تمام شده فصل‌الخطاب می‌گوید برو تو دنیا.",
   "kind": "speech",
   "chapter": 0,
   "block": 69
  },
  {
   "i": 234,
   "start": 1085.14,
   "end": 1091.84,
   "text": "حالا می‌فهمید چرا حبیب می‌گوید بگذارید من دوباره بروم تو دنیا تو جلسهٔ ذکر امام حسین بنشینم و لو یک بار، یک لحظه؛",
   "kind": "speech",
   "chapter": 0,
   "block": 69
  },
  {
   "i": 235,
   "start": 1091.84,
   "end": 1097.52,
   "text": "یک یا حسین بگویم. اینجا اسم الجبار پیاده می‌شود.",
   "kind": "speech",
   "chapter": 0,
   "block": 69
  },
  {
   "i": 236,
   "start": 1097.52,
   "end": 1099.94,
   "text": "جبران الهی به داد ما می‌رسد.",
   "kind": "speech",
   "chapter": 0,
   "block": 69
  },
  {
   "i": 237,
   "start": 1099.94,
   "end": 1104.34,
   "text": "بگذارید ملکوت این جلسه باز بشود برایتان.",
   "kind": "speech",
   "chapter": 0,
   "block": 70
  },
  {
   "i": 238,
   "start": 1104.34,
   "end": 1110.28,
   "text": "ما هیچ‌وقت به قول علامه طباطبایی دنبال کشف و کرامت نباید باشیم که اگر باشیم مشرکیم.",
   "kind": "speech",
   "chapter": 0,
   "block": 70
  },
  {
   "i": 239,
   "start": 1110.28,
   "end": 1113.8,
   "text": "مشرک است کسی که به خاطر طی‌الارض عبادت کند؛",
   "kind": "speech",
   "chapter": 0,
   "block": 70
  },
  {
   "i": 240,
   "start": 1113.8,
   "end": 1117.26,
   "text": "به خاطر کشف و کرامت این راه سیر و سلوک را برود.",
   "kind": "speech",
   "chapter": 0,
   "block": 70
  },
  {
   "i": 241,
   "start": 1117.26,
   "end": 1122.04,
   "text": "اما بیاییم از خدا درخواست کنیم برای اینکه ما تو را بهتر پیدا کنیم و ببینیم؛",
   "kind": "speech",
   "chapter": 0,
   "block": 70
  },
  {
   "i": 242,
   "start": 1122.04,
   "end": 1125.26,
   "text": "یک بار شده ملکوت این جلسات را به ما نشان بده.",
   "kind": "speech",
   "chapter": 0,
   "block": 70
  },
  {
   "i": 243,
   "start": 1125.26,
   "end": 1128.47,
   "text": "یک بار بخواهید نشانتان بدهد ببین چه بلایی سرت می‌آید.",
   "kind": "speech",
   "chapter": 0,
   "block": 70
  },
  {
   "i": 244,
   "start": 1128.47,
   "end": 1142.42,
   "text": "همین‌جا خیمه می‌زنی. اصلاً زندگی‌ات را کوک می‌کنی با ساعت کوکی این جلسات، با حرم‌های اهل‌بیت، با جلساتی که منتسب به آن‌هاست، با جلسات درس و بحث و علم",
   "kind": "speech",
   "chapter": 0,
   "block": 70
  },
  {
   "i": 245,
   "start": 1142.42,
   "end": 1144.4,
   "text": "ورزش فکری که علامه فرمودند:",
   "kind": "speech",
   "chapter": 0,
   "block": 70
  },
  {
   "i": 246,
   "start": 1144.4,
   "end": 1149.3,
   "text": "«يُعَلِّمُهُمُ ٱلْكِتَٰبَ وَٱلْحِكْمَةَ» (جمعه/۶۲:۲؛ نیز بقره/۲:۱۲۹)",
   "kind": "quote",
   "chapter": 0,
   "block": 71,
   "translation": "کتاب و حکمت را به آنان می‌آموزد."
  },
  {
   "i": 247,
   "start": 1149.3,
   "end": 1151.18,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": 0,
   "block": 73
  },
  {
   "i": 248,
   "start": 1151.18,
   "end": 1158.36,
   "text": "صلوات ختم کنید. اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": 0,
   "block": 73
  },
  {
   "i": 249,
   "start": 1158.36,
   "end": 1163.67,
   "text": "ببخشید؛ بچه‌ها خیلی تلاش کردند که صندلی قرض کنند از یک جایی که شما روی زمین ننشینید؛",
   "kind": "speech",
   "chapter": 0,
   "block": 75
  },
  {
   "i": 250,
   "start": 1163.67,
   "end": 1170.36,
   "text": "روی صندلی بنشینید. انتهای جلسه بنده تشخیص دادم این کار صورت نگیرد بهتر است بنا به دلایلی.",
   "kind": "speech",
   "chapter": 0,
   "block": 75
  },
  {
   "i": 251,
   "start": 1170.36,
   "end": 1175.16,
   "text": "ببخشید؛ عذرخواهی می‌کنم اگر اذیت شدید، پایتان درد گرفت.",
   "kind": "speech",
   "chapter": 0,
   "block": 75
  },
  {
   "i": 252,
   "start": 1175.16,
   "end": 1177.7,
   "text": "ما نشستیم روی صندلی؛ شما همه روی زمین بودید.",
   "kind": "speech",
   "chapter": 0,
   "block": 75
  },
  {
   "i": 253,
   "start": 1177.7,
   "end": 1179.48,
   "text": "عذرخواهی می‌کنم. ببخشید.",
   "kind": "speech",
   "chapter": 0,
   "block": 75
  }
 ]
}