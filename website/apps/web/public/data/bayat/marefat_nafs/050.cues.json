   "start": 23.32,
   "end": 149.2
  },
  {
   "index": 1,
   "title": "خاطره‌ای دربارهٔ مادرم",
   "start": 149.2,
   "end": 184.42
  },
  {
   "index": 2,
   "title": "تفاوت نفوس اولیای الهی",
   "start": 184.42,
   "end": 213.58
  },
  {
   "index": 3,
   "title": "ملکات نفسانی و استعدادِ سیر برزخی",
   "start": 213.58,
   "end": 399.6
  },
  {
   "index": 4,
   "title": "قرین انسان؛ خودِ عمل او",
   "start": 399.6,
   "end": 668.84
  },
  {
   "index": 5,
   "title": "خواب‌ندیدن و نسبت آن با عالم عقل",
   "start": 668.84,
   "end": 689.64
  },
  {
   "index": 6,
   "title": "تفاوت عالم برزخ و عالم عقول",
   "start": 689.64,
   "end": 983.6
  },
  {
   "index": 7,
   "title": "خواب؛ نمونه‌ای برای فهم «قیامت صغری»",
   "start": 983.6,
   "end": 1122.44
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.1,
   "end": 5.88,
   "text": "این میکروفون رو ببین آقای علیزاده کار می‌کنه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.88,
   "end": 12.29,
   "text": "کار می‌کنه بده. اگه کسی می‌خواد تشریف ببره بفرمایین خدا به همراهتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.29,
   "end": 14.7,
   "text": "ارادت. یه سؤال بپرسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.7,
   "end": 16.28,
   "text": "بفرمایید. استاد ببخشید خسته نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.28,
   "end": 18.3,
   "text": "دستتون هم درد نکنه. سلامت باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.3,
   "end": 25.32,
   "text": "صحبت و فرموده جناب ملاصدرا که در مورد که یک چیزکی می‌مونه از نفس در بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.32,
   "end": 31.27,
   "text": "الان ما حدیثی داریم که ف-- از ظاهراً از پیامبری که فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.27,
   "end": 33.84,
   "text": "نفس که خا-- روحی که خواب هست رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.84,
   "end": 39.2,
   "text": "خدا زمان مرگش نرسیده برمی‌گردونه و اگر زمان موتش باشه کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.2,
   "end": 45.46,
   "text": "تفا می‌کنه. این با این چجوری جور در میاد که ایشون می‌فرمایین یک چیزی می‌مونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.46,
   "end": 50.5,
   "text": "اونجا اون حدیث ظاهراً- کامل، طرف کامل گرفته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.5,
   "end": 52.82,
   "text": "چجوری با هم جور در میاد؟ چجوری تع-- می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.82,
   "end": 59.31,
   "text": "حکمتش چیه؟ ببینید نفس به طور کامل گرفته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.31,
   "end": 63.02,
   "text": "عرض کردم برای اینکه الان این سؤال برای شما پیش نیاد، من گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.02,
   "end": 65.76,
   "text": "اثر نفس در بدن دنیایی می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.76,
   "end": 71.16,
   "text": "یادتونه؟ همین الان گفتم جای پای نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.16,
   "end": 77.92,
   "text": "شنیدید اینو دیگه. اون قوه خیالی که ملاصدرا قائله که در بدن تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.92,
   "end": 82.14,
   "text": "دنیایی بدن مقبور شده تو قبر شده می‌مونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.14,
   "end": 84.96,
   "text": "اثر نفس در اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.96,
   "end": 91.82,
   "text": "یک عمر با هم خو کردن، یک رشه ای از اون قوه خیاله، نه همه قوه خیال، نه همه نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.82,
   "end": 96.68,
   "text": "کل نفس تفویض می‌شه و میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.68,
   "end": 102.36,
   "text": "اما شما برای فهمش یک، اینطوری بگیم که اثری از نفس هنوز تو این بدن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.36,
   "end": 104.76,
   "text": "این نفس یک عمر با این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.76,
   "end": 108.5,
   "text": "این بدن با هم خو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.5,
   "end": 111.6,
   "text": "احسنت. یه خاطره‌ای داشته، خاطرات داشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.6,
   "end": 117.82,
   "text": "این یک. دو، توجه اون نفس، اون نفس کلی که رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.82,
   "end": 120.86,
   "text": "توجه اون هنوز به این بدن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.86,
   "end": 124.52,
   "text": "اینطوری ببینید برای اینکه سهولت فهم ایجاد شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.52,
   "end": 130.2,
   "text": "اصلاً چرا بدن بعضیا سالم می‌مونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.2,
   "end": 138.16,
   "text": "توجه. آفرین به خواهرها. توجه نفس هنوز کامل از این بدن برداشته نشده و الا متلاشی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.16,
   "end": 141.18,
   "text": "جمله‌ای که انجام می‌دیم سالم می‌مونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.18,
   "end": 143.66,
   "text": "بعد دیگه هم توجه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.66,
   "end": 146.42,
   "text": "بله اتفاقاً من یه چیزی به شما بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.42,
   "end": 149.2,
   "text": "مادر ما-- خدا روح شما رحمت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.2,
   "end": 152.32,
   "text": "مادر بنده اصلاً غسل جمعه‌ش ترک نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.32,
   "end": 156.68,
   "text": "یه سری کاراش ترک نمی‌شد. شب‌زنده‌داریش، نماز زیارت عاشورای هر روزش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.68,
   "end": 160.24,
   "text": "ختم قرآنش و. بعد من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.24,
   "end": 167.46,
   "text": "یقین داشتم که مادرم وقتی قبرش شکافته بشه بدنش سالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.46,
   "end": 170.2,
   "text": "چون دیدم یک عمر باهاش بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.2,
   "end": 172.72,
   "text": "از بچگی می‌دیدم غسل جمعه‌ش ترک نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.72,
   "end": 175.4,
   "text": "به ما هم همش می‌گفت. می‌گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.4,
   "end": 179.2,
   "text": "غسل جمعه‌تونو-- من از بچگی اینو هدیه از مادر داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.2,
   "end": 185.22,
   "text": "و چه عجیب که من حالا آقا محسن نمی‌دونم خاطرش باشه یا نه، لحظه‌ای که خب بدن ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.22,
   "end": 193.72,
   "text": "مادر ما تقریباً نزدیک چهل سال از وفاتش گذشته بود، پدرم رو همونجا خواستن دفن کنن، اینطوریه دیگه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.72,
   "end": 197.36,
   "text": "فرمودیم که من مشغول کارهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.36,
   "end": 199.68,
   "text": "اداری تدفین بودم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.68,
   "end": 208.16,
   "text": "دل تو دلم نبود. به بچه‌های هیئتمون که بالاسر قبر مادرم بودن چند بار زنگ زدم گفتم تو رو خدا مدیون منی دا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.16,
   "end": 211.44,
   "text": "چند نفر نه یه نفر فیلم بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.44,
   "end": 216.62,
   "text": "انقدر که مطمئن بودم بدن مادر من سالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.62,
   "end": 223.44,
   "text": "و وقتی مواجه شدم با استخون‌های پوسیده‌ی مادر اصلاً انگار دنیا تو سرم خراب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.44,
   "end": 228.26,
   "text": "خب الان روایت که شما فرمودید روایت صحیحیه، مرحوم مجلسی میارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.26,
   "end": 233.38,
   "text": "بسیاری از بزرگان تو کتاب‌هاشون آوردن که چهل روز کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 233.38,
   "end": 238.76,
   "text": "پشت سر هم البته ختم و قسمل جامع کنه بدنش داخل قبر نمی‌پوسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 238.76,
   "end": 241.06,
   "text": "ولی مادر ما این کارو کرد و پوسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.06,
   "end": 244.86,
   "text": "اینجا چیکار باید کرد؟ باید گفت این حدیث اشتباهه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.86,
   "end": 247.72,
   "text": "العیاذ بالله حدیث که درست فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.72,
   "end": 251.06,
   "text": "این یه اصلیه اینو یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.06,
   "end": 253.92,
   "text": "من اتفاقاً اولش خیلی به هم ریختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.92,
   "end": 260.76,
   "text": "دیگه بچه‌ها بودن دیگه اصلاً جونم داشت از تنم بیرون میومد سر مادرم لحظه دفن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.76,
   "end": 265.76,
   "text": "حالا پدرم رو آوردیم دفن کنیم اما مادرم جون ما رو داشت می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.76,
   "end": 270.26,
   "text": "بعداً آرامش خاطر گرفتم به خاطر فهم یه موضوعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.26,
   "end": 279.46,
   "text": "اون چیه؟ اونم اینه که بعضیا انقدر بزرگ میشن که خودشون توجهشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 279.46,
   "end": 283.86,
   "text": "اختیاریاً از بدنشون کاملاً برمی‌دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 283.86,
   "end": 291.5,
   "text": "می‌خواید اثباتش کنم؟ مگر ما قائل نیستیم که این زمین، همین زمین دوره به دوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 291.5,
   "end": 297.76,
   "text": "الف، الف، الف همینطور هزار، هزار، هزار دوره آدم اومده و رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 297.76,
   "end": 304.92,
   "text": "بدناشون کو؟ این همه دوره اصلاً نهایت نداره‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 304.92,
   "end": 308.08,
   "text": "و نخواهد داشت. پس این بدن‌ها چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 308.08,
   "end": 310.9,
   "text": "بالاخره اولیای خدا بودن، انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 310.9,
   "end": 313.62,
   "text": "دوره ما صد و بیست و چهار هزار تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 313.62,
   "end": 320.06,
   "text": "کو بدن‌های اینا؟ این همون جوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 320.06,
   "end": 326.9,
   "text": "خودشون انقدر از دنیا دل کندن اصلاً خوششون نمیاد از دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 326.9,
   "end": 329.52,
   "text": "توجهشون رو کلاً از بدن برمی‌دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 329.52,
   "end": 332.0,
   "text": "تموم می‌شه، بدن می‌پوسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 332.0,
   "end": 336.92,
   "text": "اما اگر هنوز توجهی دارن اون هم باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 336.92,
   "end": 341.18,
   "text": "ملحوظاتی داره. یه یعنی یه لحظاتی داره که آقا چرا این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 341.18,
   "end": 346.0,
   "text": "این ولی خدا دوست داشت توجهش رو برداره، اون یکی دوست نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 346.0,
   "end": 348.42,
   "text": "دیگه به ما ربط نداره. من چه می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 348.42,
   "end": 352.74,
   "text": "ما که تو دل اونا نیستیم. مثل اینکه بگی چرا آقای قاضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 352.74,
   "end": 357.58,
   "text": "یا آقای الهی طه طبعی برادر علامه‌طه طبعی با ارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 357.58,
   "end": 362.5,
   "text": "اولیای خدا همش مباحثات علمی داشت اینا رو نوشت بعد همه رو سوزوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 362.5,
   "end": 365.12,
   "text": "برای چی سوزوندی آخه؟ می‌ذاشتی برسه به دست ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 365.12,
   "end": 370.54,
   "text": "من بارها این دادو سر اونا زدم تو خلوت خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 370.54,
   "end": 373.1,
   "text": "خب اون یه آدم دیگه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 373.1,
   "end": 377.92,
   "text": "یکی دیگه هم مثل آقای جوادی آملی یا مثل خدا علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 377.92,
   "end": 383.26,
   "text": "تو مطلق علوم دست به قلم میشه، آثارش هم نگه میداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 383.26,
   "end": 385.38,
   "text": "طوری که هوش مصنوعی هنگ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 385.38,
   "end": 389.32,
   "text": "وقتی شما یه مطلبی رو به هوش مصنوعی بدی بگی تو کدوم کتاب علامه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 389.32,
   "end": 393.18,
   "text": "هنگ می‌کنه. تنها عالمیه که هوش مصنوعی جلوش هنگ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 393.18,
   "end": 403.08,
   "text": "میگه من نمی‌تونم انقدر ایشون آثار و تألیفات داره نمی‌تونم PDF کتاب رو به من بده من از تو کتاب در میارم برات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 403.08,
   "end": 406.62,
   "text": "برید امتحان کنید. ولی بقیه رو راحت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 406.62,
   "end": 410.48,
   "text": "خب این یه نفسه، اون یه نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 410.48,
   "end": 413.28,
   "text": "دیگه سؤال؟ بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 413.28,
   "end": 419.08,
   "text": "ملکات نفسانی- لطفاً با میکروفن بگید که ضبط شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 419.08,
   "end": 421.5,
   "text": "ملکات نفسانی روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 421.5,
   "end": 425.02,
   "text": "جسم دنیایی ما تاثیر داره و اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 425.02,
   "end": 428.96,
   "text": "همون قرین توی برزخ، همون ملکات نفسانیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 428.96,
   "end": 433.46,
   "text": "بله دیگه. ما گفتیم اون منه، اون استعداد، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 433.46,
   "end": 440.04,
   "text": "هیولایی که می‌خواد در برزخ ما رو سیر بده بکشونه بالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 440.04,
   "end": 443.68,
   "text": "اونجا که دیگه ماده نیست که اونجا تجرد برزخیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 443.68,
   "end": 446.68,
   "text": "اونجا میشه همین، یعنی استعداد اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 446.68,
   "end": 449.02,
   "text": "چون استعداد جاییه که ماده هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 449.02,
   "end": 453.18,
   "text": "درسته؟ ولی اونجا چطور میگیم بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 453.18,
   "end": 456.94,
   "text": "مثلاً هیولایی که الان ملک صدرا گفت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.94,
   "end": 459.96,
   "text": "یا اونجا یه منه و استعدادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 459.96,
   "end": 465.64,
   "text": "همین اصلا میگیم اونجا سیر می‌کنه، سیر استکمال برزخی همین که سیر می‌کنه، حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 465.64,
   "end": 470.06,
   "text": "حرکت یعنی چی؟ یعنی یه استعدادی هست که به فعالیت نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 470.06,
   "end": 475.1,
   "text": "چجوری جواب بدیم؟ حضرت علامه حسن زاده علیه الرحمة والرضا می‌فرمایند همون ملکات نفسند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 475.1,
   "end": 478.64,
   "text": "که میشن استعداد به منزله استعداد برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 478.64,
   "end": 480.68,
   "text": "یه شخصی میشن یعنی قرین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 480.68,
   "end": 483.16,
   "text": "نه، نه خودت میشن، خود شمایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 483.16,
   "end": 486.36,
   "text": "پیغمبر عزیز عالم فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 486.36,
   "end": 492.98,
   "text": "به یکی از صحابی روایتش هم اینجا آوردیم از رو خوندیم که اینم حضرت علامه خیلی تأکید داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 492.98,
   "end": 501.4,
   "text": "عین این روایتو در هزار و یک نکته میارن که شخصی از پیغمبر سؤال کرد اون کیه که قرین ما میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 501.4,
   "end": 506.28,
   "text": "تا قیامت شما می‌فرمایید یه همراهی هست که تا قیام قیامت همراه شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 506.28,
   "end": 510.32,
   "text": "اون چیه؟ پیغمبر فرمود \"وهو فعلك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 510.32,
   "end": 516.7,
   "text": "عملته. حالا تو قرآن می‌فرماید \"فمن يعمل مثقال ذرة خيرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 516.7,
   "end": 520.78,
   "text": "يره\". این ضمیر هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 520.78,
   "end": 523.42,
   "text": "\"يرَه\" می‌بینی اونو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 523.42,
   "end": 528.14,
   "text": "چیو می‌بینی؟ ثوابشو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 528.14,
   "end": 532.28,
   "text": "\"فمن يعمل مثقال ذرة خيرا يره\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 532.28,
   "end": 535.36,
   "text": "\"فمن يعمل\"، \"يعمل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 535.36,
   "end": 540.46,
   "text": "به عمل می‌خوره. چه شر باشه چه خیر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 540.46,
   "end": 543.18,
   "text": "عملت همراهته. یعنی اینطوری بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 543.18,
   "end": 546.2,
   "text": "عزیز دلم اصرار بر امور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 546.2,
   "end": 548.76,
   "text": "چه خیر باشه چه شر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 548.76,
   "end": 552.38,
   "text": "ملکاتی رو در شما ایجاد می‌کنه، اصرار بر کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 552.38,
   "end": 557.92,
   "text": "یه بار دو بار نه. اون ملکات می‌شن بستر سیر برزخی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 557.92,
   "end": 562.86,
   "text": "ما بر اساس اونو میشه منّت و استعداد برزخی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 562.86,
   "end": 567.58,
   "text": "ما بر اساس اون میریم. حالا این ملکات به گونه‌ایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 567.58,
   "end": 576.96,
   "text": "که اون بدنی که تو خ-- ب-به نظر ملاصدرا بدنی هم که تو این دنیا مقبور شده اون هم متأثر از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 576.96,
   "end": 581.86,
   "text": "ملکات میشه. چون قوه خیال توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 581.86,
   "end": 587.76,
   "text": "یعنی مثلاً اگه تو برزخ اون ملکات شر تو رو اذیت بکنه امکان داره تو همین دنیا هم اذیت بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 587.76,
   "end": 589.98,
   "text": "امکان نه صد درصد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 589.98,
   "end": 592.96,
   "text": "امکان نه. گفتیم تو خواب می‌تونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 592.96,
   "end": 595.46,
   "text": "چرا یکی خواب حرم می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 595.46,
   "end": 598.88,
   "text": "مثلاً یکی خواب مشروب خونه می‌بینه عجزالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 598.88,
   "end": 602.44,
   "text": "اینا با چی حشر و نشر داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 602.44,
   "end": 605.92,
   "text": "اصلاً چرا ما تو خواب صورت و شکل می‌بینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 605.92,
   "end": 611.36,
   "text": "مگر اونور که میریم، اونور مجرد نیست، خالی از ماده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 611.36,
   "end": 614.56,
   "text": "ولی تو خواب شما همش صورت و شکل می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 614.56,
   "end": 618.5,
   "text": "چون دائماً با اینا محشوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 618.5,
   "end": 623.68,
   "text": "خوشا به حال کسی که در خواب صورت و شکل نبینه، شنود کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 623.68,
   "end": 627.78,
   "text": "تو بحث شنود و شهود عرض کردیم کدوم بالاتر بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 627.78,
   "end": 633.34,
   "text": "شنود. آفرین. شن-- قرآن شنود بود یا شهود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 633.34,
   "end": 638.96,
   "text": "قرآن شنود بود. پیغمبر شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 638.96,
   "end": 641.58,
   "text": "کشف تام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 641.58,
   "end": 645.5,
   "text": "پیغمبر عزیز عالم بود که به لفظ بود، لفظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 645.5,
   "end": 650.82,
   "text": "صورت نبود. بعد سیر تدریجیش چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 650.82,
   "end": 656.56,
   "text": "سیر تدریجیش دیگه با واسطه جبرائیل شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 656.56,
   "end": 660.77,
   "text": "دیگه اومد و صورت هم پیدا کرد و نوشته شد و کتب شد و به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 660.77,
   "end": 666.76,
   "text": "کسی که اصلاً خواب نمی‌بینه یعنی وارد عالم عقل شده یا اینکه یاغی نمی‌بینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 666.76,
   "end": 676.5,
   "text": "دو صورت داره. قبلاً هم عرض کردیم کسی که خواب نمی‌بینه دو صورت داره یا اینکه جسارت می‌کنم می‌بینه یادش میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 676.5,
   "end": 679.76,
   "text": "که این دلالت بر چی می‌کرد آقا محسن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 679.76,
   "end": 682.22,
   "text": "آفرین یادت مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 682.22,
   "end": 688.06,
   "text": "نقصان عقل. نقصان عقل دلالت بر چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 688.06,
   "end": 695.94,
   "text": "آفرین گناه. پیغمبر فرمود با هر گناهی که می‌کنید بخشی از عقلتون رو می‌گیرن، امانته، می‌گیرن، دیگه هم نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 695.94,
   "end": 699.22,
   "text": "پس سعی کن گناه نکنی که توبه کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 699.22,
   "end": 702.2,
   "text": "یک. اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 702.2,
   "end": 706.52,
   "text": "نه اصلاً نمی‌بینه، اینجوری نیست که ببینه و یادش بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 706.52,
   "end": 712.3,
   "text": "کلاً نمی‌بینه بله، چنین کسی باید به خودش باریکلا بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 712.3,
   "end": 715.44,
   "text": "کلاً نمی‌بینه. یعنی عالم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 715.44,
   "end": 720.36,
   "text": "میشه گفت یا دسترسی به عالم عقل پیدا کرده یا خیلی نزدیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 720.36,
   "end": 722.5,
   "text": "چون اونجا دیگه اصلاً هیچ صورت و شکلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 722.5,
   "end": 725.78,
   "text": "باز تو برزخ یه صورت و شکل برزخی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 725.78,
   "end": 728.2,
   "text": "برزخ بهش میگن برزخ چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 728.2,
   "end": 732.38,
   "text": "چون یه مثلی از دنیا با خودش داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 732.38,
   "end": 734.32,
   "text": "شکل داره، صورت داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 734.32,
   "end": 738.9,
   "text": "درسته؟ یه مثلی هم از عالم عقول داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 738.9,
   "end": 742.22,
   "text": "یعنی ماده نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 742.22,
   "end": 744.52,
   "text": "وزن نداره، کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 744.52,
   "end": 747.6,
   "text": "ولی وقتی رفتی به عالم عقول چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 747.6,
   "end": 751.04,
   "text": "کلاً دیگه صورت هم برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 751.04,
   "end": 753.54,
   "text": "اون شکل هم به اون صورت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 753.54,
   "end": 757.04,
   "text": "اونجا دیگه کلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 757.04,
   "end": 760.54,
   "text": "ث-- وجود ثعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 760.54,
   "end": 767.36,
   "text": "حالا باز اونجا هم یه ذیقی داره که در شرح عالم عقول باید درباره‌ش حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 767.36,
   "end": 769.48,
   "text": "باز اونجا هم میگیم ملائکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 769.48,
   "end": 772.46,
   "text": "اگه کلیه تعدد ملائکه قصه‌ش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 772.46,
   "end": 775.76,
   "text": "ملائکه مال عالم عقولن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 775.76,
   "end": 779.46,
   "text": "پس پیداست که اونجا هم یک ضعفی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 779.46,
   "end": 782.28,
   "text": "چون کثرت نشان‌دهنده‌ی ضعفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 782.28,
   "end": 784.3,
   "text": "هرچی میای به پایین، ضعفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 784.3,
   "end": 787.82,
   "text": "هرچی میری بالا، قدرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 787.82,
   "end": 794.06,
   "text": "اونی که یکپارچه قدرته، قوت محض است، هیچ ضعفی درش نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 794.06,
   "end": 797.0,
   "text": "تور فوق عقل ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 797.0,
   "end": 799.62,
   "text": "به یک معنا قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 799.62,
   "end": 804.44,
   "text": "عالم نبی اکرم. اون دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 804.44,
   "end": 806.48,
   "text": "عقل رو از طریق قلب درک می‌کنه یا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 806.48,
   "end": 810.5,
   "text": "آفرین از طریق عقل-- قلب بله، از طریق قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 810.5,
   "end": 813.02,
   "text": "قلب اونا رو درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 813.02,
   "end": 821.02,
   "text": "عقل یه صورت کلی ازش استیضاح می‌کنه، برداشت می‌کنه، قوه خیال صورت ازش انشاء می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 821.02,
   "end": 825.94,
   "text": "وهم هم که جزئی‌سازیش می‌کنه که بتونه صورت بهش بده اون کلی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 825.94,
   "end": 828.54,
   "text": "ولی اون چیزی که کلاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 828.54,
   "end": 833.38,
   "text": "کلاً درک میشه در حوزه قلب درک میشه، ادراکات ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 833.38,
   "end": 836.4,
   "text": "لذا حوزه تعلقات ما هم قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 836.4,
   "end": 842.4,
   "text": "خوشا به حال کسی که قلباً تعلق به سید الشهدا پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 842.4,
   "end": 845.66,
   "text": "تعلق قلبی پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 845.66,
   "end": 848.64,
   "text": "بیفته به شهود قلبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 848.64,
   "end": 853.0,
   "text": "نه صرفاً عقلی. این عقلی‌ها می‌لقزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 853.0,
   "end": 858.44,
   "text": "استاد امکان داره یه نفر یعنی قلباً انتخاب داشته باشه ولی عقلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 858.44,
   "end": 861.44,
   "text": "ضعیف باشه؟ نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 861.44,
   "end": 863.5,
   "text": "اون اصلاً قلب نیست، اون یه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 863.5,
   "end": 867.0,
   "text": "اون وهمه. اون وهمه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 867.0,
   "end": 871.88,
   "text": "به-- اگر بپذیریم که عقلش ضعیفه، اون دیگه وهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 871.88,
   "end": 874.48,
   "text": "هنوز به حوزه قلبش نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 874.48,
   "end": 876.76,
   "text": "چون وهم ذیل عقله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 876.76,
   "end": 885.92,
   "text": "قلب ما فوق عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 885.92,
   "end": 897.74,
   "text": "تکلیف این صورت‌هایی که خداوند توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 897.74,
   "end": 900.4,
   "text": "قرآن آوردن مثل اینکه بهشت ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 900.4,
   "end": 902.42,
   "text": "این شکلیه، جهنم این شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 902.42,
   "end": 904.98,
   "text": "اینا تکلیفش چجوری میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 904.98,
   "end": 912.86,
   "text": "بله این کاملاً مشخصه. قرآن می‌فرماید \"تِلْكَ الْأَمْثَالُ نَضْرِبُهَا لِلنَّاسِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 912.86,
   "end": 921.1,
   "text": "مثله، مثاله. الان شما بخواید به بچه‌تون خدا رو بش-- بچه، یکی از سؤالات همه بچه‌ها اینه خدا چه شکلیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 921.1,
   "end": 923.46,
   "text": "خب می‌خوای چی بهش بگی؟ یه مثالی می‌زنی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 923.46,
   "end": 926.5,
   "text": "مثال چیو می‌زنی؟ معمولاً مثال نورو می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 926.5,
   "end": 931.24,
   "text": "می‌گه خدا نوره. بعد می‌گه خدا یعنی اینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 931.24,
   "end": 933.32,
   "text": "می‌گیم این، اینم پرتو به نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 933.32,
   "end": 935.7,
   "text": "اون خورشید اصلی اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 935.7,
   "end": 940.38,
   "text": "اینا همه پرتوئه. بالاخره یه مثالی می‌خوای پیدا کنی که به بچه یاد بدی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 940.38,
   "end": 948.12,
   "text": "خدا هم چون ما بچه‌های، بچه‌های دنیاییم مثال‌های دنیایی می‌زنه برای اینکه ما بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 948.12,
   "end": 950.4,
   "text": "می‌گه حورالعین اینا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 950.4,
   "end": 956.2,
   "text": "نمی‌دونم چشما شبیه آهو مشکین و چشم مشکین آهو و امثال اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 956.2,
   "end": 961.22,
   "text": "حالا من خیلی تو این وادی‌ها نرفتم غر کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 961.22,
   "end": 964.44,
   "text": "خیلی هم دوست ندارم تمرکز رو این حرفا بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 964.44,
   "end": 969.1,
   "text": "یا و امثالهم. یا جهنمو بخواد بگه می‌گه ملائکه غلاظ و شداد با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 969.1,
   "end": 978.38,
   "text": "پتک و با نمی‌دونم بمب هسته‌ای میان سراغت و چشمات پر آتش و چشم‌های طرف پر آتش و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 978.38,
   "end": 983.2,
   "text": "دیو دو سر میاد. اینا خب بالاخره ما تو دنیا این چیزا رو معنوسیم با همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 983.2,
   "end": 987.2,
   "text": "همونطور که وقتی می‌خوابیم همین الان متوجه کردیم، می‌ریم می‌خوابیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 987.2,
   "end": 990.02,
   "text": "یه قیامت صغری‌ای رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 990.02,
   "end": 992.9,
   "text": "تو اون قیامت صغری خواب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 992.9,
   "end": 994.64,
   "text": "چرا این صورت و شکل‌ها رو می‌بینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 994.64,
   "end": 998.86,
   "text": "چون با اینا محشوریم. ولی حقیقت اون یه چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 998.86,
   "end": 1002.52,
   "text": "بارها مثال زدم مثل بچه‌ای که در رحم مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1002.52,
   "end": 1005.4,
   "text": "شما چجوری می‌خوای این دنیا رو بهش بفهمونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1005.4,
   "end": 1009.2,
   "text": "چی می‌خوای بهش بگی؟ باید از رحم مادر مثال بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1009.2,
   "end": 1013.32,
   "text": "می‌خوای بگی غذای دنیایی چلو کباب، شیشلیک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1013.32,
   "end": 1019.08,
   "text": "استرگاوانو چیه؟ از این چیزا چی می‌خوای بگی به بچه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1019.08,
   "end": 1024.38,
   "text": "شما بگید تو رحم مادر به بچه چی بگی که بفهمه چلو کباب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1024.38,
   "end": 1029.24,
   "text": "جوجه کباب چیه؟ بگیم، چی بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1029.24,
   "end": 1032.0,
   "text": "با اون چیزی که بچه باهاش محشوره باید بگیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1032.0,
   "end": 1033.76,
   "text": "باید بگیم یه خون پیشرفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1033.76,
   "end": 1037.62,
   "text": "بچه خونخوره، خون می‌خوره، خون مادرشو می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1037.62,
   "end": 1040.2,
   "text": "درسته؟ خدا هم دقیقاً همین کارو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1040.2,
   "end": 1042.98,
   "text": "از دنیا مثال زده. اشجار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1042.98,
   "end": 1045.7,
   "text": "انهار و قصور و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1045.7,
   "end": 1049.58,
   "text": "خور و همش مثال‌هایی که چشم همه رو پر کرده تو دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1049.58,
   "end": 1052.7,
   "text": "ولی اونا حقیقت‌شون ماورای ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1052.7,
   "end": 1060.64,
   "text": "اصلاً اینا نیست. فک کنم از فردا دیگه بی‌خیال عبادت و بندگی بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1060.64,
   "end": 1066.62,
   "text": "اِ اینا نیست؟ از تا حالا سر ما شما آخوندا کلاه می‌ذاشتین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1066.62,
   "end": 1069.8,
   "text": "الحمد لله رب العالمين صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1069.8,
   "end": 1075.16,
   "text": "اللهم صل على محمد آله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1075.16,
   "end": 1082.22,
   "text": "خواهشا کسی نزدیک ما نیاد سرما خوردم نگیرید از من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1082.22,
   "end": 1090.6,
   "text": "بفرمایید بلند بگید. من احساس کردم که آقای رحمان رسید قبل از اینکه ما محصل تو فرمایشات شما بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1090.6,
   "end": 1093.74,
   "text": "مرگ بشماریم، این به ذهنم رسید که میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1093.74,
   "end": 1097.4,
   "text": "ای برادر! ما همه همیشه این و آن فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1097.4,
   "end": 1099.74,
   "text": "گفتگامون به شکل دیگه همینجوری بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1099.74,
   "end": 1102.16,
   "text": "بله دیگه. یعنی کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1102.16,
   "end": 1104.68,
   "text": "بحث همون اندیشه است. بله احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1104.68,
   "end": 1108.36,
   "text": "شهید مطهری می‌فرمود اسلام در اندیشه‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1108.36,
   "end": 1111.34,
   "text": "بله. درست متوجه شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1111.34,
   "end": 1113.48,
   "text": "دقیقاً. احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1113.48,
   "end": 1115.36,
   "text": "زنده باشید. خدا با همه‌ی همگیتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1115.36,
   "end": 1118.1,
   "text": "زنده باشید. خدا نگهدار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1118.1,
   "end": 1122.44,
   "text": "آقای علیزاده عزیز. جلسه من نبود. چرا؟ چقدر استفاده کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}