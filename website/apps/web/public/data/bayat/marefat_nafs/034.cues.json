 "chapters": [
  {
   "index": 0,
   "title": "چراییِ حضور بر سر قبر اموات",
   "start": 48.32,
   "end": 83.84
  },
  {
   "index": 1,
   "title": "وجه دیگری از این مسئله به سکرات موت بازمی‌گردد.",
   "start": 83.84,
   "end": 217.42
  },
  {
   "index": 2,
   "title": "روایات را نیز باید همین‌گونه، در کنار یکدیگر، دید.",
   "start": 217.42,
   "end": 237.46
  },
  {
   "index": 3,
   "title": "تجرد، روح و مسئلهٔ جنسیت",
   "start": 237.46,
   "end": 322.28
  },
  {
   "index": 4,
   "title": "بدن‌های انسان در عوالم مختلف",
   "start": 322.28,
   "end": 655.46
  },
  {
   "index": 5,
   "title": "حورالعین و حقیقت جنسیت در عالم دیگر",
   "start": 655.46,
   "end": 757.2
  },
  {
   "index": 6,
   "title": "اعتدال مزاج و آمادگی برای دریافت حقایق",
   "start": 757.2,
   "end": 1159.48
  },
  {
   "index": 7,
   "title": "ترجمهٔ فارسی (توسط مدل، نه استاد): معتدل‌ترینِ مزاج‌ها.",
   "start": 1159.48,
   "end": 1199.72
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.34,
   "end": 5.04,
   "text": "بفرمایید. بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.04,
   "end": 8.92,
   "text": "اول تشکر می‌کنیم از کلاس قربانتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.92,
   "end": 11.54,
   "text": "لم يشکر الخالق لم يشکر المخلوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.54,
   "end": 14.22,
   "text": "ما باید تشکر کنیم که شما این کلاس را برقرار کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.22,
   "end": 16.4,
   "text": "ما استفاده داریم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.4,
   "end": 19.08,
   "text": "سلامت باشین. سوال من اینه که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.08,
   "end": 21.88,
   "text": "بیان کردید که شهود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 21.88,
   "end": 27.48,
   "text": "اه بریم سر قبر پدر و مادرمون یا اموات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.48,
   "end": 30.58,
   "text": "اونا طول عين این کار رو انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.58,
   "end": 35.02,
   "text": "خب اگه اونا شهود دارن و می‌تونن به ما پاسخ بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.02,
   "end": 39.64,
   "text": "این جمله پیش میاد که خب ما تو خونه هم می‌تونیم این کار رو انجام بدیم قبل از طول عين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.64,
   "end": 43.28,
   "text": "آیا این درسته یا نه؟ احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.28,
   "end": 48.32,
   "text": "بله سوال خوبه. بفرمایید آقای جان بفرمایید، بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.32,
   "end": 50.84,
   "text": "اینکه چه سری داره ما بریم سر خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.84,
   "end": 53.36,
   "text": "اشخاص. چرا مثلا تو خونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.36,
   "end": 56.8,
   "text": "بله همینطور که ما عرض کردیم تو سیر بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 56.8,
   "end": 63.94,
   "text": "این اثبات شده است که ما هر کجا-- چون اونجا اشراف ان، اشراف، اشراف دارن به عالم ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.94,
   "end": 69.46,
   "text": "چون اونجا مثل اینکه بچه‌ای که در رحم مادره، مادر بهش اشراف داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.46,
   "end": 72.56,
   "text": "اصلا تو دله. اون محاط بر مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.56,
   "end": 76.14,
   "text": "مدی-- مادر محیط بر فرزندشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.14,
   "end": 78.16,
   "text": "اون در رحم مادره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.16,
   "end": 80.54,
   "text": "ما هم الان در رحم عالمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 80.54,
   "end": 90.38,
   "text": "در رحم طبیعتیم. این عالم نسبت به عالم علوی یا حالا یه رتبه اول بالاترش که یا باطن‌تر بهتره بگیم برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.38,
   "end": 92.18,
   "text": "میشه رحم نسبت به اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.18,
   "end": 96.1,
   "text": "اون‌ها اش-- احاطه دارن به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.1,
   "end": 101.92,
   "text": "خب؟ منتها این احاطه نسبت باز عرض کنم صعه وجودی اشخاص و افراده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.92,
   "end": 106.34,
   "text": "نه اینکه به همه چی ما احاطه داشته باشن اما در خصوص صوت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.34,
   "end": 112.32,
   "text": "پس هر کجا ما حرف بزنیم، کلامی از لسان ما خارج بشه اونا میشنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.32,
   "end": 115.5,
   "text": "سر اینکه ما میریم سر قبرشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.5,
   "end": 118.1,
   "text": "یه سرش برمی‌گرده مثل اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.1,
   "end": 122.42,
   "text": "چیزی که گفتم تلقینی که میت رو میدی تکونش میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.42,
   "end": 125.56,
   "text": "این تکون دادن خودش موضوعیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.56,
   "end": 128.42,
   "text": "یک وجهش به خود شما برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.42,
   "end": 131.66,
   "text": "میگه یه چیزی به شما بگم تکون بخورین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.66,
   "end": 138.34,
   "text": "میگه این شونه‌های میت رو بگیرین لمسش که از کار افتاده بیخیال که اصلا چی برای چی تکون بدین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.34,
   "end": 140.66,
   "text": "خودت رو داری تکون میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.66,
   "end": 144.82,
   "text": "شما در این تلقین خودت رو داری تکون میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.82,
   "end": 148.66,
   "text": "در حقیقت حتی میگه که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.66,
   "end": 152.36,
   "text": "در تلقین دوم که مهم‌تر از تلقین اوله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 152.36,
   "end": 157.94,
   "text": "همه که رفتن دوباره نزدیکان برگردن فرموده دو تا کف دستو بذار روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.94,
   "end": 163.14,
   "text": "بالا سر میت دهانتو نزدیک قبر کنی بلند فریاد بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.14,
   "end": 165.8,
   "text": "مگر اون اشراف نداره؟ مگه صدا نمیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.8,
   "end": 169.46,
   "text": "مگه نمیشنوه؟ چرا میگه دهانتو نزدیک قبر کن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.46,
   "end": 171.1,
   "text": "چرا میگه فریاد بزن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.1,
   "end": 174.76,
   "text": "اینا یه وجهش برمی‌گرده به خود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 174.76,
   "end": 176.4,
   "text": "یه وجهش به ما برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 176.4,
   "end": 178.32,
   "text": "میگه سر خودت داد بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 178.32,
   "end": 180.9,
   "text": "فریاد بزن همه بشنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 180.9,
   "end": 183.64,
   "text": "تکون بده که الان خودت رو داری تکون میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 183.64,
   "end": 187.0,
   "text": "اصلا تلقین یه وجهش به خود ما برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 187.0,
   "end": 189.16,
   "text": "خودت رو تلقین داری میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 189.16,
   "end": 193.98,
   "text": "خودت حواست باشه که تا امروزی‌ت میشه و باید بری همچین جایی، یه وجهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 193.98,
   "end": 199.16,
   "text": "یه ج-- یه وجه دیگرش برمی‌گرده به سکرات موت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 199.16,
   "end": 203.86,
   "text": "این رو ببینید به قول علامه طباطبایی علیه الرحمة والرضوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 203.86,
   "end": 206.86,
   "text": "باید آیات قرآن رو همه رو با هم دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 206.86,
   "end": 209.72,
   "text": "و الا \"ولا يزيد الظالمين الا خسارا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 209.72,
   "end": 214.88,
   "text": "کسی که ظلم کنه به قرآن یعنی پاره پاره کنه قرآن رو خسارت می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 214.88,
   "end": 217.24,
   "text": "روایات رو همچنین باید همه رو با هم دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 217.24,
   "end": 222.66,
   "text": "من عرض کردم امروز حرف ما پخته نشد دقیقاً یعنی به قله نرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 222.66,
   "end": 232.12,
   "text": "چه کنیم؟ وقت زیاده. انشاالله به جلسات دیگه‌ای چه عرض کنم اینجا نشد انشاالله در عالم برزخ گرد هم باشیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 232.12,
   "end": 234.16,
   "text": "خود حضرت استاد برای ما سخن بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 234.16,
   "end": 236.8,
   "text": "ها؟ ما قرار نیست اینجا بمونیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 236.8,
   "end": 239.52,
   "text": "یه وجهش برمی‌گرده به سکرات مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 239.52,
   "end": 246.86,
   "text": "یعنی چی؟ یعنی میت درسته که اون‌ها می‌شنوند اما یه لحظاتی به اون‌ها می‌گذره که تب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.86,
   "end": 253.08,
   "text": "مرگ بر اون‌ها عارض شده و هنوز تب مرگ از این‌ها زایل نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.08,
   "end": 257.86,
   "text": "تب مرگ چیه؟ حالا اصطلاحاً میگیم داغیه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.86,
   "end": 268.02,
   "text": "عرق، عرق مرگه هرچی که هست یعنی اون لحظه طرف به یکباره از یک عالم مادون وارد بر یک عالم مافوق شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.02,
   "end": 271.32,
   "text": "از عالم سفلی رفته به عالم علوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.32,
   "end": 274.64,
   "text": "و چشمش و سر و کل یوم حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.64,
   "end": 281.7,
   "text": "اونم یوم ظرف ظهور اشیا ظهور کردن براش حقیقت و باطن اشیا رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.7,
   "end": 284.7,
   "text": "از جهت تمثلات ملکوتی فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.7,
   "end": 288.32,
   "text": "نه عقلی و قلبی و مراتب مافوق نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.32,
   "end": 292.34,
   "text": "و حقیقت عالم رو درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.34,
   "end": 294.64,
   "text": "آخر سوره واقعه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.64,
   "end": 303.8,
   "text": "ان هذا لفی... نه ان هذا آخرش که آخرین آیات سوره واقعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.8,
   "end": 306.14,
   "text": "لهو حق اليقين احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.14,
   "end": 310.38,
   "text": "حق اليقين. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.38,
   "end": 314.46,
   "text": "در بعد از که-- چی رو به کار می‌بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.46,
   "end": 318.58,
   "text": "بعد از اینکه میگه از خواب شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.58,
   "end": 322.28,
   "text": "از خواب مشامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.28,
   "end": 325.28,
   "text": "وقتی از اون‌ها سخن میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.28,
   "end": 328.58,
   "text": "که اینا تو جا، جایگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.58,
   "end": 332.52,
   "text": "پایینی قرار دارن. بعد میگه اینا حق یقینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.52,
   "end": 334.46,
   "text": "یعنی اون‌ها متوجه حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.46,
   "end": 341.8,
   "text": "مگه پیغمبر به کفار بعد از جنگ بدر نفرمود پیدا کرد فهمیدید بالاخره حرف حق رو درک کردید یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.8,
   "end": 345.52,
   "text": "خب حالا اونجا وقتی طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.52,
   "end": 349.08,
   "text": "تازه وارد اون عالم شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.08,
   "end": 352.26,
   "text": "اصطلاحاً بهش میگن سکرات مرگ، یه حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.26,
   "end": 355.7,
   "text": "بیهوشی. چی بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.7,
   "end": 360.56,
   "text": "لفظ خاکیه باز نمی‌تونیم رو تداعی کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.56,
   "end": 364.42,
   "text": "بهش دست میده داغی موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.42,
   "end": 368.36,
   "text": "تازه وارد اون عالم شده، لال شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.36,
   "end": 372.57,
   "text": "بهت زده‌ست. اصلاً آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.57,
   "end": 375.34,
   "text": "сейчас دنبال یه لفظ می‌گردم بهتر جوابش رو بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.34,
   "end": 383.1,
   "text": "شوک بهش وارد شده. دقت نکردی یه کسی یه دفعه شوک بهش وارد می‌شه تکونش میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.1,
   "end": 387.12,
   "text": "یه وقت چیش برمی‌گرده به این. که حالا شما میگی آقا خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.12,
   "end": 392.88,
   "text": "ممنونم عزیزم. لحظه‌ای که طرف تازه از این دنیا رفته این هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.88,
   "end": 396.8,
   "text": "خب ما فقط اون موقع بریم سر قبرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.8,
   "end": 401.6,
   "text": "داد بزنیم. مثل تلقین میگه داد بزن چون تو اون حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.6,
   "end": 407.2,
   "text": "تب موته. مثلاً در حالی که تب موت ازش برداشته شد دیگه نریم سر قبرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.2,
   "end": 412.04,
   "text": "مگه شما می‌تونی تشخیص بدی تب موت کی از اون برداشته می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.04,
   "end": 414.12,
   "text": "من و شما نمی‌تونیم تشخیص بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 414.12,
   "end": 417.92,
   "text": "لذا فرمود برای بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.92,
   "end": 420.36,
   "text": "اون لحظه موت‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 420.36,
   "end": 426.02,
   "text": "یک آنه برای بعضیا هفتصد سال طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.02,
   "end": 429.0,
   "text": "من و شما یک آن می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.0,
   "end": 434.22,
   "text": "پیغمبر از این عالم رفت معراج برگشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 434.22,
   "end": 440.2,
   "text": "همه عوالم رو زیارت کرد و برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 440.2,
   "end": 446.16,
   "text": "چقدر طول کشید؟ تو روایت هست دیگه وقتی داشت می‌رفت عبای مبارکش اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 446.16,
   "end": 451.66,
   "text": "گیر کرد به اون ابریق. افتاد اون آب ظرف آب افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.66,
   "end": 454.38,
   "text": "وقتی برگشت هنوز آب اون ظرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 454.38,
   "end": 457.72,
   "text": "داشت می‌ریخت. یعنی انقدر طول کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.72,
   "end": 461.52,
   "text": "ولی اون همه عوالم رو رفت دید و برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 461.52,
   "end": 469.96,
   "text": "ماها نمی‌دونیم تب مرگ از اون میت کی ظاهر می‌شه که از اون حالت گیج و گنگی بیاد بیرون و گوشمون صدای ما رو بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.96,
   "end": 477.1,
   "text": "برای همین میگه تلقین دوم رو دهانتو نزدیک قبر کن فریاد بزن که اون تو شوکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.1,
   "end": 483.52,
   "text": "داد بزن. بغل گوش میت تلقین اول رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 483.52,
   "end": 487.22,
   "text": "بگو. به جهت اینکه اون تو شوکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.22,
   "end": 491.16,
   "text": "\"فکشفنا عنک غطاءک فبصرک اليوم حدید.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.16,
   "end": 493.16,
   "text": "حدید چشم تیز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.16,
   "end": 497.34,
   "text": "اون ما رو داره می‌بینه. اصلاً غافله از همه چی از مرگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 497.34,
   "end": 503.4,
   "text": "حالا تا این تب ظاهر بشه رو دمر مثلاً برگشت کنه به دنیا و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.4,
   "end": 506.62,
   "text": "حالا وجوه دیگری هم داره. فرصت اجازه نمی‌کنه ما بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 506.62,
   "end": 512.01,
   "text": "دیگه سؤال؟ اگه کسی سؤال داره میکروفن رو برسونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.01,
   "end": 515.88,
   "text": "بفرمایید. استاد ببخشین اینو بارها و من شنیدم توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 515.88,
   "end": 519.26,
   "text": "صحبت‌های دیگر آقایون هم برام سؤال بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 519.26,
   "end": 522.98,
   "text": "اینکه میگیم نفس مجرد، روح مجرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.98,
   "end": 529.12,
   "text": "عالم تجرد، این یعنی مثلاً اونور جنسیتی وجود نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 529.12,
   "end": 532.2,
   "text": "جنسیت زن و مردی وجود نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 532.2,
   "end": 536.08,
   "text": "یا مثلاً جاهایی که میگه ازدواج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 536.08,
   "end": 540.34,
   "text": "اونور مثلاً آیاتی که راجع بهش هست و اینا به چه حالت می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 540.34,
   "end": 542.64,
   "text": "تجرد اصلاً مجرد بودن-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 542.64,
   "end": 545.08,
   "text": "جنسیّت- به جنسیّت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 545.08,
   "end": 548.54,
   "text": "ربطی داره؟ یعنی جنسیتی وجود نداره اونجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.54,
   "end": 551.7,
   "text": "نه جنسیّت که اولاً مال بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 551.7,
   "end": 555.88,
   "text": "خب؟ روح جنسیّت نداره، روح کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 555.88,
   "end": 559.22,
   "text": "و نفخت فیهم الروح. روح اعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 559.22,
   "end": 563.18,
   "text": "دخل و تصرف کرده. واسطه فیض حضرت حق شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.18,
   "end": 566.58,
   "text": "روح الهی رو آورده که بحث‌هاش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 566.58,
   "end": 570.14,
   "text": "هرکسی نسبت به اندازه و قدر خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 570.14,
   "end": 574.64,
   "text": "سر القدرش رو امام عصر دیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 574.64,
   "end": 579.38,
   "text": "، فقط کمالین می‌تونن سر القدر رو ببینن در خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 579.38,
   "end": 588.26,
   "text": "سر القدر طرف رو دیده به میزان اندازه‌ش صعه وجودیش و ظرف وجودیش، این وعاء وجودیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 588.26,
   "end": 592.62,
   "text": "برخوردارش کرده از فیض وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 592.62,
   "end": 596.2,
   "text": "حالا ، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 596.2,
   "end": 601.56,
   "text": "فیض وجود رو بگیرید روح. پس اون کلیه، اون اصلاً جنسیّت بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 601.56,
   "end": 604.2,
   "text": "جنس برمی‌گرده به بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 604.2,
   "end": 607.0,
   "text": "بدن نفس، بدن روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 607.0,
   "end": 610.48,
   "text": "حالا شما سؤال منو جواب بده ببینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 610.48,
   "end": 614.38,
   "text": "وقتی از این عالم بریم بدن داریم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 614.38,
   "end": 620.16,
   "text": "یک فرمایشی داشتین من صحبتون رو دنبال می‌کردم که- میکروفن بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 620.16,
   "end": 623.96,
   "text": "اعمال ما تبدیل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 623.96,
   "end": 629.08,
   "text": "جسم برزخی ما میشه و افکار و اعتقادات ما تبدیل به نفس برزخی ما میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 629.08,
   "end": 630.74,
   "text": "عالی جواب دادین. آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 630.74,
   "end": 639.24,
   "text": "یکی از فرمایشات عالی حضرت استاد هم در صد کلمه در معرفت نفسشون دارن هم در انسان در عرفانشون دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 639.24,
   "end": 644.24,
   "text": "بارها اینو فرمودن که اعمال ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 644.24,
   "end": 647.02,
   "text": "میشه بدن برزخی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 647.02,
   "end": 650.52,
   "text": "باورها، اعتقادات و علوم ما میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 650.52,
   "end": 654.12,
   "text": "باطن برزخی ما. و اصلاً یه اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 654.12,
   "end": 661.98,
   "text": "توی صد کلمه در معرفت نفس حضرت استاد فرمودن که ما در هر عالمی که از اینجا فارغ میشیم میریم در هر عالمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 661.98,
   "end": 664.42,
   "text": "بدنی داریم متناسب با اون عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 664.42,
   "end": 667.32,
   "text": "ابدان در طول همند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 667.32,
   "end": 674.98,
   "text": "مثل اینکه الان شما اینجا نشستی بدن جسمانی و مادی داری آیا بدن مثالی داری یا نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 674.98,
   "end": 677.76,
   "text": "داری که وقتی می‌خوابی با اون بدن حرکت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 677.76,
   "end": 680.88,
   "text": "این پس در طول همند یعنی همین الان هم حاضرند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 680.88,
   "end": 686.78,
   "text": "اون ابدان دیگه. در طول همند تفاوتشون به نقص و کماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 686.78,
   "end": 690.36,
   "text": "بدن برزخی کامل‌تر از بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 690.36,
   "end": 692.9,
   "text": "مادیه. همینطور به مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 692.9,
   "end": 695.6,
   "text": "پس چون بدن داریم سؤال شما جواب داده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 695.6,
   "end": 700.4,
   "text": "چون بدن داریم و جنسیّت به بدن برمی‌گرده، اونجا هم جنسیّت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 700.4,
   "end": 702.62,
   "text": "زن و مرد متمایزن از هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 702.62,
   "end": 711.5,
   "text": "اصلاً وجود حور، حور رو نمی‌دونم تو این جلسه بود یا تو بحث قلب مؤمن بود توضیح دادیم که حور-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 711.5,
   "end": 713.82,
   "text": "زن و مرد- همینجا بود فکر کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 713.82,
   "end": 716.76,
   "text": "احسن سیاه چشم یا آهو چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 716.76,
   "end": 719.74,
   "text": "اینا هم به زن برمی‌گرده هم به مرد بهشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 719.74,
   "end": 726.1,
   "text": "هم این- این همسر. پس وجود اون نشون میده که جنسیت وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 726.1,
   "end": 731.76,
   "text": "منتها اینکه آیا جنسیت اگر وجود داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 731.76,
   "end": 734.22,
   "text": "غریزه جنسی هم وجود داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 734.22,
   "end": 739.46,
   "text": "اونجا فیه تأمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 739.46,
   "end": 745.88,
   "text": "که این خودش یه جلسه میخواد باز بشه و خیلی هم به دردتون میخوره در سیر معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 745.88,
   "end": 753.3,
   "text": "که بالاخره اونجا حورالعین هست یا اگر هست که هست که قرآن میفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 753.3,
   "end": 756.24,
   "text": "و حورالعین. اتفاقاً تو کجا اینو میاره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 756.24,
   "end": 764.14,
   "text": "تو surه واقعه در خصوص مقربین و از سابقون میاره که از سابقون اولیای کرم مقربون اینا دیگه عالی‌ترین مراتبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 764.14,
   "end": 769.42,
   "text": "به یک بعضی از روایات فرمودن اهل بیتن، بعضی از روایات فرمودن انبیائن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 769.42,
   "end": 772.72,
   "text": "اونا در عالی‌ترین مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 772.72,
   "end": 777.84,
   "text": "یعنی خواستگاهشون زن بهشتیه، همسر بهشتیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 777.84,
   "end": 780.14,
   "text": "حورالعینه، ولی اونجا میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 780.14,
   "end": 787.24,
   "text": "پس پیداست که باید نگاه متفاوت بشه در خصوص خود حور، حقیقت حورالعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 787.24,
   "end": 790.76,
   "text": "اینجا حضرت استاد نظرشون اینه که این حورالعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 790.76,
   "end": 794.14,
   "text": "که اونجا داره بیان میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 794.14,
   "end": 800.72,
   "text": "منظور این اه عجین شده با غریزه جنسی دنیوی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 800.72,
   "end": 807.14,
   "text": "این نیست. اون ملکات نفس انسانه که هو فعلک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 807.14,
   "end": 811.46,
   "text": "پیغمبر عزیز عالم فرمودن هو فعلک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 811.46,
   "end": 814.86,
   "text": "اون فعل توئه. فعل تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 814.86,
   "end": 817.64,
   "text": "عمل تو، اعمال تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 817.64,
   "end": 820.34,
   "text": "علم و عمل جوهر اندوه انسان‌ساس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 820.34,
   "end": 822.96,
   "text": "این دو ملکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 822.96,
   "end": 828.22,
   "text": "نفس تو رو تشکیل میدن و اونچه که ما باهاشون عجینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 828.22,
   "end": 832.16,
   "text": "تا قیام قیامت باهاشون هم‌نشینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 832.16,
   "end": 836.34,
   "text": "و سرمون با اونا یکی میشه و همسرمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 836.34,
   "end": 844.82,
   "text": "اونا میشن چی؟ صور و اشکالی که ملاط‌شون همین ملکات نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 844.82,
   "end": 848.0,
   "text": "یعنی شما تو نفس چی کاشتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 848.0,
   "end": 849.9,
   "text": "کتاب وجودیت الان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 849.9,
   "end": 854.64,
   "text": "همون ظهور میکنه، همون بروز میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 854.64,
   "end": 859.12,
   "text": "دیگه حالا میشه اینطوری گفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 859.12,
   "end": 863.24,
   "text": "همه فهمش اینطوری میشه که یه وقت کسی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 863.24,
   "end": 867.12,
   "text": "ااا فرار نکنه از جلسات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 867.12,
   "end": 872.08,
   "text": "یه مقدار نازله بحث، مرتبه نازله بحثو میشه اینطوری ارائه داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 872.08,
   "end": 874.74,
   "text": "که ما قائل به این نیستیم. ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 874.74,
   "end": 878.5,
   "text": "مرتبه نازله بحث برای مبتدی‌ها اینه که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 878.5,
   "end": 886.76,
   "text": "نسبت به سعه وجودی و رتبه طرف حورالعین تعریف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 886.76,
   "end": 890.24,
   "text": "برای اونهایی که چیپس و پفک بهشت رو میخوان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 890.24,
   "end": 900.08,
   "text": "چیپس و پفک مراتب سلوک رو و إنا إليه راجعون رو میخوان، بله حورالعین به اون معنا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 900.08,
   "end": 903.94,
   "text": "که تزویر میشن و رابطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 903.94,
   "end": 906.96,
   "text": "عاشقانه هم با هم دارند و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 906.96,
   "end": 912.8,
   "text": "اما برای کسی که اوج میگیره چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 912.8,
   "end": 917.62,
   "text": "یا ایته النفس المطمئنة ارجعي إلى ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 917.62,
   "end": 923.98,
   "text": "راضية مرضية فادخلي في عبادي وادخلي جنتي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 923.98,
   "end": 925.6,
   "text": "این جنت فرق میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 925.6,
   "end": 932.06,
   "text": "این بهشت فرق میکنه با اون بهشت بخور و بخوابی که حضرت آدم توش بود و حضرت حوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 932.06,
   "end": 936.5,
   "text": "اینجا فرمود اسکن انت وزوجک الجنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 936.5,
   "end": 939.68,
   "text": "ساکن بشید تو با همسرت حوا تو بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 939.68,
   "end": 942.4,
   "text": "اینجا فوق نهایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 942.4,
   "end": 946.84,
   "text": "عشق و حالی که دارید چیه؟ کلوا منها حيث رغدتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 946.84,
   "end": 949.62,
   "text": "هرچی دوست دارید بخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 949.62,
   "end": 952.42,
   "text": "اونجا بهشت سیب و گلابی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 952.42,
   "end": 955.38,
   "text": "حور و قصر و نهر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 955.38,
   "end": 961.42,
   "text": "تو همین دنیا هم بود. تو همین دنیا بود نه جای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 961.42,
   "end": 963.4,
   "text": "خب بود یعنی از اونجا بیرون اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 963.4,
   "end": 968.28,
   "text": "نه اینکه از یه عالم بالایی اومدن به عالم رتبه مادون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 968.28,
   "end": 973.18,
   "text": "نه همینجا بود. این بهشت کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 973.18,
   "end": 980.12,
   "text": "که اگه حضرت آدم از اون درخت ممنوعه و شجره به یک معنا بگیم طیبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 980.12,
   "end": 982.31,
   "text": "که شجره ولایت بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 982.31,
   "end": 985.1,
   "text": ". أصلها ثابت وفرعها في السماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 985.1,
   "end": 987.92,
   "text": "اگر از اون نمیخو-- نمیخورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 987.92,
   "end": 995.0,
   "text": "من و شما تا ابد گرفتار شکم و بطن و فرج بودیم جسدتا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 995.0,
   "end": 997.22,
   "text": "اما او خورد که ما به چی برسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 997.22,
   "end": 1000.0,
   "text": "جنتی یعنی جنت ذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1000.0,
   "end": 1004.02,
   "text": "جنت ذات دیگه حورالعینش جور دیگه‌ای تعریف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1004.02,
   "end": 1010.74,
   "text": "نور چشم مؤمن اونجا تو اون مراتب انوار و لمعات جمال حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1010.74,
   "end": 1012.54,
   "text": "حورالعین به این معنا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1012.54,
   "end": 1022.34,
   "text": "با چه بازی‌ها چیه؟ خب سؤال دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1022.34,
   "end": 1026.24,
   "text": "الحمدلله که سؤال ندارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1026.24,
   "end": 1029.82,
   "text": "ما هم میتونیم فرصت میکنیم شاید اینو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1029.82,
   "end": 1032.74,
   "text": "الحمدلله رب العالمين صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1032.74,
   "end": 1036.76,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1036.76,
   "end": 1047.22,
   "text": "محمد و آل محمد. سؤال هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1047.22,
   "end": 1050.7,
   "text": "یا زهرا .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1050.7,
   "end": 1053.12,
   "text": "سلام علیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1053.12,
   "end": 1056.92,
   "text": "در مورد این قسمتی که فرمودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1056.92,
   "end": 1060.64,
   "text": "نفس جمع بشه در مورد اون سری که فرمودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1060.64,
   "end": 1063.18,
   "text": "با توجه به اون سی و یک جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1063.18,
   "end": 1067.94,
   "text": "سر مکنون منظور این هستش که برداشت من اینه که آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1067.94,
   "end": 1069.8,
   "text": "نهایت اعتدال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1069.8,
   "end": 1072.02,
   "text": "مزاج رو اگر داشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1072.02,
   "end": 1074.18,
   "text": "میتونیم به این مرحله برسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1074.18,
   "end": 1083.08,
   "text": "مزاج معتدل بشه اون موارد رو رعایت بکنیم یا اینکه نه موارد علاوه بر اون اون هست که باید توجه داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1083.08,
   "end": 1085.48,
   "text": "بله شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1085.48,
   "end": 1088.66,
   "text": "یه در حقیقت پرانتز باز کردید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1088.66,
   "end": 1094.6,
   "text": "سنجاب کردید، یه تتمه‌ای رو به بحث ما که کامل‌ترش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1094.6,
   "end": 1099.54,
   "text": "بله. تو اونجا تو بحث سر مکنون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1099.54,
   "end": 1102.8,
   "text": "تو عنوان سکر-- سر مکنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1102.8,
   "end": 1105.36,
   "text": "که ما قصد داشتیم البته ادامه بدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1105.36,
   "end": 1110.0,
   "text": "سیر معرفت نفس رو، روانشناسی معرفت نفس رو بریم جلو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1110.0,
   "end": 1113.62,
   "text": "که دیگه تو همون روح بخاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1113.62,
   "end": 1117.58,
   "text": "متوقف شدیم و به هر-- به دلایلی جمع شد جلسه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1117.58,
   "end": 1119.94,
   "text": "اونجا عرض کردیم که بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1119.94,
   "end": 1132.2,
   "text": "منظور از این، ااا مزاج صحیح مزاجی که آماده میشه برای دریافت حقایق عالیه، مزاجی که می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1132.2,
   "end": 1141.88,
   "text": "تمام کلمات وجودی نظام هستی رو به خوبی بخونه و احوالات اون‌ها رو دریابه که این معنای حکمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1141.88,
   "end": 1147.52,
   "text": "علم به احوال اعیان موجودات، موجودات بر طاقت بشریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1147.52,
   "end": 1153.26,
   "text": "این در اعتدال نفس یا در اعتدال مزاج اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1153.26,
   "end": 1159.48,
   "text": "وقتی که شیخ الرئیس در نوط اشاراتش می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1159.48,
   "end": 1170.52,
   "text": "انسان کامل چون اعدل امزجه رو داره یعنی مزاجش مزاج معتدل‌ترین مزاجه می‌تونه همه حقایق عالم رو دریافت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1170.52,
   "end": 1175.74,
   "text": "پس هرچی مزاج به سمت اعتدال بره واردات قلبی‌ش درست‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1175.74,
   "end": 1178.26,
   "text": "ارتباط با عالم غیب در او بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1178.26,
   "end": 1188.5,
   "text": "این مثالی که ما الان از جهت عملیاتی در سیر بحث زدیم دقیقاً مرتبط با همون اصلاح مزاج و اعتدال مزاجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1188.5,
   "end": 1195.56,
   "text": "بله. دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1195.56,
   "end": 1199.72,
   "text": "خب دیگه به واقع والحمد لله رب العالمين. سلامات خطای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}