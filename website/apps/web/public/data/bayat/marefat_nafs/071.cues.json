 "chapters": [
  {
   "index": 0,
   "title": "آداب حضور در جلسهٔ معارف",
   "start": 0.98,
   "end": 145.32
  },
  {
   "index": 1,
   "title": "ذکر در مسیر جلسه",
   "start": 145.32,
   "end": 193.92
  },
  {
   "index": 2,
   "title": "تأثیر حال شاگرد بر گوینده",
   "start": 193.92,
   "end": 289.06
  },
  {
   "index": 3,
   "title": "معارف دشوار را پس نزنید",
   "start": 289.06,
   "end": 337.38
  },
  {
   "index": 4,
   "title": "ضرورت حفظ یک سیر مطالعاتی منظم",
   "start": 337.38,
   "end": 436.84
  },
  {
   "index": 5,
   "title": "مستند بودن مباحث و آمادگی برای ورود به متن",
   "start": 436.84,
   "end": 556.34
  },
  {
   "index": 6,
   "title": "مرحلهٔ اول: ورزیدگی عقل",
   "start": 556.34,
   "end": 682.22
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.5,
   "end": 3.68,
   "text": "خب توقع دارم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.68,
   "end": 7.22,
   "text": "مثل دیشب خیلی الحمد لله خوب و وزین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.22,
   "end": 13.0,
   "text": "بچه‌ها خادما همه بیان جلو دیگه بقیه هر جا عشقشونه بشینن کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.0,
   "end": 15.56,
   "text": "خادم‌هایی که ثبت‌نام داشتن بیان جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.56,
   "end": 20.74,
   "text": "تو خانوما هم همون مثل دیشب به وزان دیشب خیلی خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.74,
   "end": 24.86,
   "text": "همه نشستن سلام علیک‌هاشون رو بشینن آخر جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.86,
   "end": 29.62,
   "text": "کسی هم وارد شد سلام علیک هم حتی نکنه بشینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.62,
   "end": 34.76,
   "text": "همه رو بذارید انتهای جلسه. بچه‌ها رو هم دیگه هرکی آروم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.76,
   "end": 39.18,
   "text": "انشاالله یه نیم ساعتی در خدمت شما خوبان باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.18,
   "end": 41.74,
   "text": "جانتون رو در اختیار این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.74,
   "end": 45.3,
   "text": "آیات و روایات و نورانیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.3,
   "end": 48.14,
   "text": "بحث قرار بدید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.14,
   "end": 51.0,
   "text": "قبل از اینکه شروع به بحث کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.0,
   "end": 53.82,
   "text": "دوستان تذکر عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.82,
   "end": 59.78,
   "text": "یکی اینکه سعی کنیم انشاالله اهل سحر باشید، اهل طهارت باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.78,
   "end": 63.2,
   "text": "هر چقدر که شما عزم‌تون جدی‌تر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.2,
   "end": 66.86,
   "text": "سحر مخصوصاً از سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.86,
   "end": 69.48,
   "text": "کمک و مدد بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.48,
   "end": 71.82,
   "text": "برای فهم این حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.82,
   "end": 74.84,
   "text": "کمک‌حالتونه. چقدر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.84,
   "end": 81.06,
   "text": "در خونه اهل بیت خدا گریه کردیم، سوختیم، داد زدیم که اینو میخوام، اونو میخوام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.06,
   "end": 84.1,
   "text": "این مریضی رو بگیر، اونو بهم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.1,
   "end": 91.88,
   "text": "یک بار شد که در خونه اهل بیت داد بزنیم، بسوزیم، اشک بریزیم که ما چرا نمی‌فهمیم حقایق رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.88,
   "end": 94.72,
   "text": "چرا بعضی معارف رو تو کله‌ی ما نمیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.72,
   "end": 98.9,
   "text": "چرا عقل ما ورزیده نیست؟ خب چرا ما نسوختیم برای این؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.9,
   "end": 103.58,
   "text": "چرا؟ خب بیایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.58,
   "end": 108.96,
   "text": "شیوه‌مون رو عوض کنیم. اصلاً یه بار بریم حرم امام رضا ده بار بریم حرم امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.96,
   "end": 111.36,
   "text": "هیچی نخوایم جز فهم معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.36,
   "end": 114.04,
   "text": "مگر حقیقت همین نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.04,
   "end": 117.3,
   "text": "ولا غیر. بقیه بازی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.3,
   "end": 122.38,
   "text": "خب بسوزیم، گریه کنیم، خواهش کنیم، سحر پاشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.38,
   "end": 127.62,
   "text": "احترام قائل بشیم، ارزش قائل بشیم برای این حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.62,
   "end": 130.6,
   "text": "اینکه بزرگان مثل علامه حسن زاده میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.6,
   "end": 135.62,
   "text": "هیچکس حق نداره جز دو زانو تو جلسه درس معارف بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.62,
   "end": 145.32,
   "text": "این دیگه ما هستیم که نمیگیم اون بزرگان میگن به جهت وزانت اون معارف، اون حقایق و عظمت کلاس درس، کلاس بحث، کلاس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.32,
   "end": 151.7,
   "text": "عرض شود دنیا که نیست کلاس معارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.7,
   "end": 156.22,
   "text": "حالا منظور از دو زانو الان نمی‌خواد الان یه دفعه همه دو زانو بشید یعنی با ادب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.22,
   "end": 160.04,
   "text": "این یک مثال مصداقیه که با ادب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.04,
   "end": 162.94,
   "text": "ولو نباشید، تکیه ندی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.94,
   "end": 165.62,
   "text": "ارزش قائل بشی برای معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.62,
   "end": 167.96,
   "text": "و کسی که می‌خواد استفاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.96,
   "end": 171.17,
   "text": "کسی که نمی‌خواد ما کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.17,
   "end": 175.62,
   "text": "یه نکته. پس از سحر انشاالله استفاده بگیرید با طهارت بیاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.62,
   "end": 180.5,
   "text": "میشه یه دوره تسبیح استغفار کنید بیاید اون ذکر‌ها رو بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.5,
   "end": 185.3,
   "text": "با ماشین که با خونواده دارید میاد همه خونواده با همون نوزده تا بسم الله رو بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.3,
   "end": 188.12,
   "text": "اون چهارده تا یا واسعه رو بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.12,
   "end": 192.68,
   "text": "ببینید تاثیرش رو برکتش رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.68,
   "end": 195.64,
   "text": "این یه نکته. نکته بعد این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.64,
   "end": 200.16,
   "text": "شما هر طور که اینجا حاضر باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.16,
   "end": 207.66,
   "text": "در انشراح قلبی گوینده‌تون و به ظاهر معلم‌تون تاثیر گذارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.66,
   "end": 210.4,
   "text": "یعنی هرچی شما تشنه‌تر باشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.4,
   "end": 217.04,
   "text": "جان وجود شما تشنه‌تر باشه و عطش داشته باشه چون اون حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.04,
   "end": 224.2,
   "text": "علم از ملکوت نازل میشه و تنزل پیدا می‌کنه میاد در سرشت و جان شما می‌نشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.2,
   "end": 227.08,
   "text": "ما یک وسیله‌ایم. خود منم همینطور هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.08,
   "end": 235.76,
   "text": "جان هممون داره تغذیه می‌کنه و اون علم هم که قبلاً گفتیم نور است و مسترش ذات خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.76,
   "end": 242.18,
   "text": "لذا هرچی شما آماده‌تر باشی می‌بینی زبان گوینده‌ات بدون لکنت‌تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.18,
   "end": 244.36,
   "text": "شرح صدرش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.36,
   "end": 251.0,
   "text": "بعد می‌بینی گوینده‌اش در جان تو نگاه می‌کنه، طلب تو رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.0,
   "end": 255.86,
   "text": "توجه کردی عزیزم؟ ت-- بعد اون موقع می‌بینی اصلاً گوینده خودتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 255.86,
   "end": 257.82,
   "text": "تو داری طلب می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.82,
   "end": 269.02,
   "text": "گوینده در جان وجود تو می‌بینه طلبت رو خدا تو وجود او-- خدا به او القا می‌کنه طلب تو رو و او بیان می‌کنه برای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.02,
   "end": 273.74,
   "text": "باز می‌بینی گوینده تویی، شنونده تویی، همه چی تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.74,
   "end": 276.22,
   "text": "همه چی جانه، همه چی نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.22,
   "end": 279.9,
   "text": "این‌ها جز حقایق کلاس‌های درسی و معارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.9,
   "end": 282.74,
   "text": "کلاس اونطور که دانشگاه هست و این‌ها که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 282.74,
   "end": 285.22,
   "text": "سرشت ما میگیم آقا نمره میدیم، امتحان می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.22,
   "end": 287.78,
   "text": "اون برای اهمیت کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.78,
   "end": 290.82,
   "text": "اینم یه نکته. نکته سوم این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.82,
   "end": 298.06,
   "text": "پس نزنید. می‌دونم بعضی از مواردی که دا-- ما داریم میگیم البته من همه رو مزه مزه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.06,
   "end": 301.24,
   "text": "خدا الحمدالله لطف کرده یه مقداری اینو نرم‌ترش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.24,
   "end": 307.28,
   "text": "می‌کنم، رقیق‌ترش می‌کنم از اون غلظت و پیچیدگی و سختی تو کام شما میذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.28,
   "end": 311.72,
   "text": "اگر بعضیاش پیچیده‌ست بعداً این گره‌ها وا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.72,
   "end": 317.28,
   "text": "صبور باشید. الان اگر می‌شنوی این اشتباه به ما برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.28,
   "end": 321.0,
   "text": "این مشکل تو وجود ماست که چرا این حرفا رو نشنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 321.0,
   "end": 324.1,
   "text": "عده‌ای میگن آقا الان این حرفا به چه درد ما می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 324.1,
   "end": 328.2,
   "text": "الان بیایید مثلاً مبحث گناه شناسی بذارید ما تو گناه گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.2,
   "end": 331.24,
   "text": "یعنی انقدر انسان لول خودشو بیاره پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.24,
   "end": 333.42,
   "text": "گناهی که یه چیز فطریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.42,
   "end": 338.22,
   "text": "کدوم یکی از ما فطرتا نمی‌دونیم دروغ بده، نمی‌دونیم غیبت بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.22,
   "end": 340.9,
   "text": "علمشو نداریم. هممون عالمیم تو این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 340.9,
   "end": 343.16,
   "text": "هممون می‌دونیم گناه چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 343.16,
   "end": 346.06,
   "text": "هممونم دیدیم، شنیدیم، خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 346.06,
   "end": 352.88,
   "text": "اون چیزی که ما نشنیدیم، ندیدیم، به ذهنمون برخورد نکرده این حقایق و حکمت‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 352.88,
   "end": 355.5,
   "text": "این به قول یونانی‌ها فلسفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 355.5,
   "end": 358.34,
   "text": "به قول ما بچه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 358.34,
   "end": 361.36,
   "text": "مکتبی و مذهبی حکمت عرفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.36,
   "end": 368.38,
   "text": "اینو ما نشنیدیم. این به ذهن ما برخورد نکرده، عقل ما ورزیده نیست لذا پس میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.38,
   "end": 371.42,
   "text": "اون کاری نداره گناه شناسی، یه کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 371.42,
   "end": 374.82,
   "text": "اخلاق علامه شب‌براور رو بخون بفهم چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 374.82,
   "end": 379.32,
   "text": "گناه شناسی، نمیدونم گناهان کبیره شهید دستغیب رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 379.32,
   "end": 382.9,
   "text": "چهل تا گناه رو بررسی کرده قشنگ مبسوط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 382.9,
   "end": 386.9,
   "text": "نمیدونم مراج السائل مرحوم نراقی رو بخون قشنگ توضیح داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 386.9,
   "end": 389.15,
   "text": "همه فهم هم هستن اون کتابا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.15,
   "end": 391.74,
   "text": "اون سیر مطالعاتی رو خودت داشته باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 391.74,
   "end": 395.36,
   "text": "اگرچه ما تو دل بحث به یه جایی بر می‌خوریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 395.36,
   "end": 402.92,
   "text": "که اصلا لاجرم ناگزیریم اونجا برنامه سیر مطالعاتی بدیم و الا نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 402.92,
   "end": 408.5,
   "text": "نمیشه ما گیر می‌کنیم. یکیش همین مطالعه در خصوص موانع رشد و سیر و سلوک خوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.5,
   "end": 412.84,
   "text": "خودمونه که همون مثلاً کـ، مثلاً کتاب گناه شناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.84,
   "end": 415.02,
   "text": "اما تا ما نفسمونو نشناسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.02,
   "end": 421.0,
   "text": "تا جانمونو نشناسیم، این سیر مطالعاتی هم به دردمون نمی‌خوره، خسته‌مون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.0,
   "end": 424.66,
   "text": "بگذارید یه ذره یه چیزکی از خودمون حالیمون بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 424.66,
   "end": 429.14,
   "text": "از درون خودمون خبر بگیریم، این دفینه‌های وجودمونو بریزیم بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 429.14,
   "end": 434.28,
   "text": "ببینیم عجب چه گنجینه‌ای در درون ما نهفته بوده و ما بی‌خبر بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.28,
   "end": 438.3,
   "text": "اون موقع متوجه میشیم از کجا باید شروع کنیم و به کجا ختم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.3,
   "end": 441.42,
   "text": "یکی از خ، دوستان خوبمون که الان اینجا نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 441.42,
   "end": 445.64,
   "text": "سوار ماشینش بودیم. یه بحث خیلی خوبی، یه کارشناسی داشت ارائه میداد قرآنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 445.64,
   "end": 451.26,
   "text": "خوب بود، بحث قشنگی بود. بعضی مطالبی که می‌گفت من خودم توجه نداشتم پیش از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 451.26,
   "end": 456.2,
   "text": "گفتم ایشون کیه؟ بعد راهنمایی کرد مثلاً معرفی کرد بعد گفت ببر حاجی ببرم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 456.2,
   "end": 458.56,
   "text": "میخوای گوش بدی دوست داری؟ گفتم نه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 458.56,
   "end": 462.32,
   "text": "این که من خوشم اومد دلیل نداره من الان برم اینو گوش بدم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 462.32,
   "end": 465.76,
   "text": "الان گذری از مـ، ماشین شما شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 465.76,
   "end": 468.94,
   "text": "اما من سیر مطالعاتی برای خودم الان دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 468.94,
   "end": 473.34,
   "text": "اینو اگه بردارم بخونم اون سیر خراب میشه، پاره میشه رشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 473.34,
   "end": 476.62,
   "text": "اصلاً ذهن من مشوش میشه، مشوب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 476.62,
   "end": 479.14,
   "text": "اونو ولش کن الان اون به درد من نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 479.14,
   "end": 481.32,
   "text": "سیر رو باید درست بری جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 481.32,
   "end": 485.92,
   "text": "هی بخواه قطع و وصلی از این کتاب به اون کتاب، از این استاد به اون استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.92,
   "end": 490.46,
   "text": "کاری که من یه زمانی خودم غلط کاری کردم و اشتباه کردم رو شما نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 490.46,
   "end": 493.72,
   "text": "یه ذره تحمل کنید، یه ذره که البته بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.72,
   "end": 496.62,
   "text": "البته من مطمئنم ریزش خواهیم داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.62,
   "end": 500.6,
   "text": "بعضیا به بهانه خادمی فرم فقط پر کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 500.6,
   "end": 505.2,
   "text": "حالا کلاس درس و بحث هم نرفتیم، نرفتیم دیگه حاج آقا مهربونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 505.2,
   "end": 507.64,
   "text": "نخیر این حرفا نیست، این خبرا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 507.64,
   "end": 510.94,
   "text": "لذا ما اینو کلاسو گذاشتیم هرکی دوست داره بیاد استفاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 510.94,
   "end": 514.14,
   "text": "به بهانه این نخواد بیاد تو شاخکلاخ خادمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.14,
   "end": 516.16,
   "text": "هرکی بخواد استفاده بکنه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 516.16,
   "end": 524.12,
   "text": "اما اونکه خادمه باید اینجا جوابگو باشه، پاسخگو باشه و باید ببینیم تو هم، تو آینه وجود هم اثر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.12,
   "end": 526.24,
   "text": "بحث‌ها رو داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 526.24,
   "end": 530.16,
   "text": "من به شما عرض کنم خودم ملتزمم هرچی میگم لحاظ کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 530.16,
   "end": 532.88,
   "text": "گفتم با همسرانتون مباحثه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 532.88,
   "end": 536.24,
   "text": "من با خانم خودم شروع کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 536.24,
   "end": 540.22,
   "text": "و جالبه وقتی با هم گفت‌وگو می‌کنید می‌بینید اِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 540.22,
   "end": 544.96,
   "text": "حاجی که می‌گفت نفهمیدم. الان که با هم مباحثه می‌کنیم دارم می‌فهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 544.96,
   "end": 549.86,
   "text": "یه بار، دو بار، سه بار باورتون نمی‌شه امروز یک درس استاد رو من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.86,
   "end": 553.8,
   "text": "گوش می‌دادم شاید بار شاید مثلاً دهم بود نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 553.8,
   "end": 558.08,
   "text": "خیلی گوش دادم خیلی. فکر می‌کنم امروز در دهم، پونزدهم اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 558.08,
   "end": 561.1,
   "text": "امروز اصلاً انگار یه چیزایی که نشنیده بودم تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 561.1,
   "end": 563.68,
   "text": "تو صحبت‌های استاد، عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.68,
   "end": 569.96,
   "text": "گره‌ها اونجا باز شد. به این-- اصلاً اینا به گوشم انگار نخورده بود دفعه قبل که گوش می‌دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 569.96,
   "end": 572.23,
   "text": "باید بارها گوش بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.23,
   "end": 575.78,
   "text": "این مباحث کلیدی‌ان، علمی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 575.78,
   "end": 582.58,
   "text": "اینم یه نکته دیگه. بعضیا دلسوزن خب بالاخره دوست دارن ما رو ما هم شما رو دوست داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 582.58,
   "end": 587.9,
   "text": "گفت حاجی ما می‌ترسیم این حرف‌هایی که داری می‌زنی برات حرف درست شه، تهمت بخوری و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 587.9,
   "end": 590.92,
   "text": "اولاً ما هرچی داریم می‌گیم با سند و مدرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 590.92,
   "end": 593.36,
   "text": "یعنی هر-- حالا شما تأمل کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 593.36,
   "end": 596.08,
   "text": "تأمل کنید. نمی‌خواستم الان بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 596.08,
   "end": 598.12,
   "text": "می‌خواستم آخر بحث بگم شیرین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 598.12,
   "end": 601.84,
   "text": "کتابو رو کنی بگی اِاِاِ ما اینو داشتیم سیر این کتابو رو می‌رفتیم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 601.84,
   "end": 604.52,
   "text": "چه قشنگ. حاجی کتاب سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 604.52,
   "end": 606.72,
   "text": "شما می‌گیری دستت خیلی سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.72,
   "end": 610.78,
   "text": "متوجه این کلمات نمی‌شی. ما داریم این کلماتو با شما کار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 610.78,
   "end": 615.26,
   "text": "بعد کتابو باز کردی میگی اِاِاِ داری سیر دروس معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 615.26,
   "end": 621.9,
   "text": "مثلاً نهج‌البلغه علامه حسن‌زاده آملی رو داری دستت گرفتی داری می‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 621.9,
   "end": 628.55,
   "text": "مباحثی که این مثلاً دو سه شب شروع کردیم همون شرح نهج‌البلغه علامه حسن‌زاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 628.55,
   "end": 632.44,
   "text": "البته من نباید اینو الان به شما می‌گفتم از جهت اصول درسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 632.44,
   "end": 635.92,
   "text": "اون مال مرحله دوم بود که گفتم ما سه تا سیر داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 635.92,
   "end": 639.26,
   "text": "اول فقط کار می‌کنیم یه ذره عقلمون ورزیده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 639.26,
   "end": 645.64,
   "text": "مرحله دوم کتابو می‌گیریم دست همه میدیم از رو کتاب شروع می‌کنیم پیاده کردن کلمات پیچیده رو می‌خونیم می‌ریم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 645.64,
   "end": 649.84,
   "text": "مرحله سوم تخصص، تخصصی‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 649.84,
   "end": 654.02,
   "text": "که حالا شما کمک کنید به من متوقف نشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 654.02,
   "end": 658.72,
   "text": "پشت هم باشید. انشاالله با اخلاق خوب و خوش شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 658.72,
   "end": 662.38,
   "text": "من مطمئنم ریزش داریم اما بذارید شده پنج نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 662.38,
   "end": 670.74,
   "text": "آخر بارها گفتم بمونین ولی بدونین که این سیر رو رفتین بعد آثار و برکاتش رو خودتون متوجه می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 670.74,
   "end": 674.38,
   "text": "زحمت باید براش بکشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 674.38,
   "end": 677.4,
   "text": "خب جانم. نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 677.4,
   "end": 682.22,
   "text": "نه. یه صلوات بفرستین. اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}