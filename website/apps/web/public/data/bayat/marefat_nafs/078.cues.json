   "start": 0.86,
   "end": 21.26
  },
  {
   "index": 1,
   "title": "## خطاب به جمع دوستان",
   "start": 21.26,
   "end": 49.44
  },
  {
   "index": 2,
   "title": "## فریاد به امت فرشتگان",
   "start": 49.44,
   "end": 109.38
  },
  {
   "index": 3,
   "title": "آن‌گاه به خداوند تعالی عرض می‌کند:",
   "start": 109.38,
   "end": 167.3
  },
  {
   "index": 4,
   "title": "## پناه در گشایش و گرفتاری",
   "start": 167.3,
   "end": 235.62
  },
  {
   "index": 5,
   "title": "## حیرت در اطوار نفس: اوج و حضیض",
   "start": 235.62,
   "end": 323.7
  },
  {
   "index": 6,
   "title": "الله اکبر از این آیه؛ بیچاره‌کننده است.",
   "start": 323.7,
   "end": 347.16
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.68,
   "end": 7.72,
   "text": "یه جمله‌ای براتون اشک من رو درآورد وقتی، اصلاً خدا شاهده اصلاً تا این جمله رو من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.72,
   "end": 9.78,
   "text": "دیدم از حضرت استاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.78,
   "end": 13.5,
   "text": "کتابو گذاشتم زمین های های گریه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.5,
   "end": 17.36,
   "text": "جلسه چیه امروز؟ چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.36,
   "end": 21.26,
   "text": "معرفت نفس. این رساله که دست منه یمبوع الحیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.26,
   "end": 28.0,
   "text": "قصیده مخصوص خود حضرت استاد فرمودن قصیده حائره یمبوع الحیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.0,
   "end": 30.44,
   "text": "عربیه البته قصیده. منم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.44,
   "end": 33.16,
   "text": "خستتون نمی‌کنم ترجمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.16,
   "end": 37.66,
   "text": "یه دو سه بیتش رو براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.66,
   "end": 41.06,
   "text": "ایشون می‌فرماید که ای جمع دوستان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.06,
   "end": 44.36,
   "text": "رفقا علامه با شما داره امشب حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.36,
   "end": 46.4,
   "text": "ای جمع دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.4,
   "end": 49.22,
   "text": "چه کسی در بین شما هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.22,
   "end": 55.08,
   "text": "که جانم را به من معرفی کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.08,
   "end": 59.44,
   "text": "تا آن هیجان و جوشش من آرام گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.44,
   "end": 65.66,
   "text": "کیه؟ هیجان و جوشش من درخواست خودم آرام بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.66,
   "end": 70.94,
   "text": "و ای امت و جمع فرشتگان در زمین و آسمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.94,
   "end": 82.28,
   "text": "حله رو ببین. انقدر تشنه خودشناسیه فریاد می‌زنه به آسمان و زمین و آنچه که در آسمان و زمینه به همه فریاد می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.28,
   "end": 88.34,
   "text": "ای امت و جمع فرشتگان در زمین و آسمان .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.34,
   "end": 91.44,
   "text": "یعنی همه طبقات فرشتگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.44,
   "end": 93.76,
   "text": "آیا یکی از شما هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.76,
   "end": 103.84,
   "text": "که به این پرسش من کیستم به من جواب بدهد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.84,
   "end": 114.08,
   "text": "حال به خداوند، به خداوند تعالی عرض می‌کنم که ای خدایی که مالک و پادشاه فرشتگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 114.08,
   "end": 117.14,
   "text": "در زمین و آسمان هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 117.14,
   "end": 121.92,
   "text": "و ای کسی که فریاد و زجه من به تو می‌رسد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 121.92,
   "end": 124.18,
   "text": "فریاد و زجه من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.18,
   "end": 128.64,
   "text": "کی تا حالا فریاد و زجه زده برای شناخت خودش که آقا من کیم آخه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.64,
   "end": 135.88,
   "text": "من کیم؟ من چیم؟ و ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.88,
   "end": 142.3,
   "text": "کسی که آفریدن مرا دوست داشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 142.3,
   "end": 145.14,
   "text": "و چه نیکو دوست داشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 145.14,
   "end": 151.16,
   "text": "و ای کسی که مرا به صورت پیهم به تجدد امثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 151.16,
   "end": 154.84,
   "text": "و حرکت جوهری خلعَت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 154.84,
   "end": 158.62,
   "text": "خلعت کردی با عین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 158.62,
   "end": 162.56,
   "text": "و پوشاندی. یکی یکی اینا رو توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 162.56,
   "end": 165.05,
   "text": "تجدد امثال چیه؟ حرکت جوهری چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 165.05,
   "end": 172.76,
   "text": "الان باید بگیریم. و ای کسی که همگان به تو مأوا می‌گیرند و پناه می‌آورند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 172.76,
   "end": 175.52,
   "text": "من هم به تو پناه می‌آورم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 175.52,
   "end": 181.22,
   "text": "در گشایش و فراخی و در شدت و گرفتاری و اکنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 181.22,
   "end": 184.68,
   "text": "آخه گرفتاری و شدت من و شما چیه رفقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 184.68,
   "end": 187.56,
   "text": "زمین تا آسمان فاصله نوریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 187.56,
   "end": 190.54,
   "text": "با این شدت و گرفتاری ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 190.54,
   "end": 197.64,
   "text": "اصلاً کسی باورش نمی‌شه. یه کسی در درگاه خدا زجه بزنه به زمین و آسمان بگه من این گرفتاری رو دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 197.64,
   "end": 206.08,
   "text": "کی رو سراغ دارید تو، تو رو خدا یه نفرو رو کنید جز ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 206.08,
   "end": 209.94,
   "text": ". من هم به تو پناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 209.94,
   "end": 221.22,
   "text": "می‌آورم در گشایش و فراخی و در شدت و گرفتاری و اکنون در این شدت و سختی و انقلاب من کیستم به تو پناه آورده‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 221.22,
   "end": 227.24,
   "text": "ای وای من که نتوانستم بدانم من کیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 227.24,
   "end": 234.42,
   "text": "و تن نتوانستم کتاب وجودم را از طبیعت و ادراک خودم بفهمم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 234.42,
   "end": 238.74,
   "text": ". اینک در اطوار نفسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 238.74,
   "end": 242.0,
   "text": "که پی در پی در رفت و آمده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 242.0,
   "end": 248.42,
   "text": "و شب و روز می‌کند و در اوج و حزیص است، اوج و حزیص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 248.42,
   "end": 252.22,
   "text": "هی بالا پایین، بالا پایین، هی بالا پایین میشه، هی نوسان داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 252.22,
   "end": 257.08,
   "text": "در اوج و حز-حزیص است به حیرت افتاده‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 257.08,
   "end": 260.6,
   "text": "من کیم آخه؟ یه بار خاک نشینم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 260.6,
   "end": 265.64,
   "text": "یه بار آسمان نشینم. اینطور نیستیم ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 265.64,
   "end": 268.6,
   "text": "نفس در نقطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 268.6,
   "end": 271.62,
   "text": "اوجش الله اکبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 271.62,
   "end": 276.3,
   "text": "در نقطه اوجش شما رو داره تو اوج نشون خودت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 276.3,
   "end": 280.98,
   "text": "طوری‌ست که اسماء روز قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 280.98,
   "end": 283.44,
   "text": "برایش تجلی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 283.44,
   "end": 286.24,
   "text": "یعنی اونجا تو قیامت چی تجلی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 286.24,
   "end": 290.48,
   "text": "حضرت حق با اسماش. یوم تبلى السرائر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 290.48,
   "end": 295.46,
   "text": "این اسما چگونه ت-تجلی می‌کنند که باطنت آشکار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 295.46,
   "end": 298.72,
   "text": "خب. میگه نقطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 298.72,
   "end": 303.82,
   "text": "اوج نفس اونجاست و از غیب ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 303.82,
   "end": 307.08,
   "text": "هویت روشن می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 307.08,
   "end": 309.4,
   "text": "روشنایی نفس، اون نورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 309.4,
   "end": 315.96,
   "text": "میگه آها روشن شدم. این چراغ دلت از غیب ذات هویت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 315.96,
   "end": 319.74,
   "text": "قل هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 319.74,
   "end": 323.7,
   "text": "الله اکبر از این آیه. بیچاره کننده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 323.7,
   "end": 328.86,
   "text": "و در سیر عروجی‌اش از آن غیب ذات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 328.86,
   "end": 331.88,
   "text": "از آن غیب ذات هویت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 331.88,
   "end": 336.0,
   "text": "باهر می‌گردد. روشناییش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 336.0,
   "end": 338.5,
   "text": "اون در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 338.5,
   "end": 342.42,
   "text": "فروغش، درخششش، خودنمایی‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 342.42,
   "end": 347.16,
   "text": "باهر شدنش از غیب ذاته و روشنایی می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}