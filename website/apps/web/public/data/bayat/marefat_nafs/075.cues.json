 },
 "chapters": [
  {
   "index": 0,
   "title": "اثر محضر و تصرف انسان الهی",
   "start": 1.66,
   "end": 89.4
  },
  {
   "index": 1,
   "title": "دستورالعملی برای طلب علم",
   "start": 89.4,
   "end": 152.22
  },
  {
   "index": 2,
   "title": "خاطره‌ای از محضر علامه",
   "start": 152.22,
   "end": 172.56
  },
  {
   "index": 3,
   "title": "اثر لطف استاد در فهم حکمت و عرفان",
   "start": 172.56,
   "end": 289.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.66,
   "end": 7.74,
   "text": "محضر یک انسان الهی، دهن یک انسان الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.74,
   "end": 12.38,
   "text": "و یک آدم کامل متصرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.38,
   "end": 14.66,
   "text": "این‌ها خیلی کار میدسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.66,
   "end": 22.0,
   "text": "بعضی از نفوس که مستعد باشند، زحمت کشیده باشند، تشنه و طالب باشند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.0,
   "end": 27.14,
   "text": "به معیار و ملاکی را که اولیا در دست دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.14,
   "end": 31.64,
   "text": "این‌ها را به تصرفی دگرگون می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.64,
   "end": 38.52,
   "text": "یکی از اساتید خیلی به نام و بزرگی که ما درکشان کردیم یک هدیه‌ای به ما تقدیم کردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.52,
   "end": 43.82,
   "text": "که ایشان ارتباط با امام عصر هم داشتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.82,
   "end": 46.98,
   "text": "و نوزده سال هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.98,
   "end": 51.82,
   "text": "پیش امام جماعت حرم حضرت ابالفضل صلوات الله علیه بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.82,
   "end": 57.56,
   "text": "قریب به بیست سال. خیلی ما از ایشون بهره بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.56,
   "end": 60.66,
   "text": "من حدودا بیست سالم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.66,
   "end": 72.6,
   "text": "از ایشون خودم بودم و ایشون از ایشون خواهش کردم که یک راهی به بنده یاد بدید خدا به زور به من علم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 72.6,
   "end": 76.58,
   "text": "شما دوست دارید نه؟ دوست دارید نه واقعا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 76.58,
   "end": 78.78,
   "text": "به زور خدا بهت علم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 78.78,
   "end": 82.41,
   "text": "یعنی خودت یهو به خودت ببینی اِاِاِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.41,
   "end": 89.4,
   "text": "اصن شاید خودتم استنکاف می‌کردی اما خدا داره تزریق می‌کنه بهت از در و دیوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 89.4,
   "end": 93.6,
   "text": "این دستورالعمل رو از حدود سی سال پیش بنده انجام دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 93.6,
   "end": 97.98,
   "text": "خیلی هم آسونه و همه هم شاید دارید انجام میدید ولی بی‌خبرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.98,
   "end": 101.12,
   "text": "شاید یک سر از این جلسه همون باشه اصن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.12,
   "end": 108.46,
   "text": "شما دارید انجام میدید این جلسه رو گذاشتن که به شما تزریق علم کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 108.46,
   "end": 111.72,
   "text": "ما انجام دادیم و خودم تجربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 111.72,
   "end": 115.44,
   "text": "در تجربه شخصی خودم دیدم این رو واقعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 115.44,
   "end": 121.62,
   "text": "چشیدم بهش رسیدم. لذا چیزی که خودم چشیدم چرا از شما دریغ کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 121.62,
   "end": 126.14,
   "text": "فرمودند که بعد از هر نماز واجب‌تون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 126.14,
   "end": 131.06,
   "text": "بعد از تسبیحات حضرت صدیقه شهیده سلام الله علیها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 131.06,
   "end": 134.36,
   "text": "آیه الکرسی رو قرائت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 134.36,
   "end": 140.82,
   "text": "به همین راحتی. کسی که این کار رو مداومت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 140.82,
   "end": 144.06,
   "text": "خدا ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 144.06,
   "end": 147.78,
   "text": "کفیل او میشه از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 147.78,
   "end": 152.06,
   "text": "تعلیم علم. ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 152.06,
   "end": 155.22,
   "text": "یه خاطره کوچولو بگم که نیمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 155.22,
   "end": 163.22,
   "text": "نیمچه این خاطره رو فعلا نصفش طلب‌تون که انشاالله با هم رفیق‌تر شدیم کاملش رو براتون میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 163.22,
   "end": 165.2,
   "text": "محضر علامه بودیم یه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 165.2,
   "end": 167.32,
   "text": "در اتاق شخصیشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 167.32,
   "end": 172.56,
   "text": "اون اتاقی که شاید رفتید یا نه دور تا دورش با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 172.56,
   "end": 176.68,
   "text": "کتاب‌های دست‌نویس دست‌نویس خودشان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 176.68,
   "end": 180.84,
   "text": "ما یه سه چهار تا طلبه و دانشجو معتمد رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 180.84,
   "end": 184.9,
   "text": "همه حرف می‌زدن. همه سؤال می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 184.9,
   "end": 188.96,
   "text": "همه مزاحم علامه بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 188.96,
   "end": 191.86,
   "text": "تنها کسی که ساکت بود بنده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 191.86,
   "end": 194.92,
   "text": "من فقط ایشونو نگاه می‌کردم و لذت می‌بردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 194.92,
   "end": 198.38,
   "text": "هیچی، هیچی. فقط اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 198.38,
   "end": 200.66,
   "text": "از من ظهور می‌کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.66,
   "end": 205.66,
   "text": "عطش وجودی بود. با تشنگی علامه رو نگاه می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.66,
   "end": 211.28,
   "text": "سر تا پای علامه رو مثل یه آدم تشنه‌ای که به آب رسیده نگاه می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 211.28,
   "end": 212.88,
   "text": "شاید ایشون اینو درک کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 212.88,
   "end": 220.12,
   "text": "نمی‌دونم. دست منو ایشون گرفت گفت یه کاری باهات می‌کنم نری کسی رو ورداری بیاری بگی این کارو باهاش بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 220.12,
   "end": 224.92,
   "text": "گفتم چشم. رنگم هم پرید و خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 224.92,
   "end": 228.8,
   "text": "یه کاری با ما کرد ایشون. اون کارا بماند فعلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.8,
   "end": 232.28,
   "text": "هدیه شما باشه فعلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 232.28,
   "end": 237.86,
   "text": "اون در اد-- اون کاری که علامه کرد و بعد از اون لطف ایشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 237.86,
   "end": 245.4,
   "text": "من یه چیزکی دیدم دارم می‌فهمم از همین مباحث سنگین و پیچیده‌ی حکمت و عرفان رو و شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 245.4,
   "end": 253.7,
   "text": "یه وجه اینکه بعضیا به من میگن شما اون مسائل خیلی سنگین و عرشی رو که ما از هر کی می‌شنویم گیج می‌شیم و به زبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 253.7,
   "end": 257.72,
   "text": "ساده بیان می‌کنی و اون لطف علامه بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 257.72,
   "end": 260.44,
   "text": "اون در ادامه‌ی همین بود، همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 260.44,
   "end": 263.62,
   "text": "همین دستورالعملی که الان به شما عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 263.62,
   "end": 266.66,
   "text": "یعنی برکت این بود. نترسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 266.66,
   "end": 270.94,
   "text": "همین. شما این کارو انجام بده بعد ببین خدا باهات چیکار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 270.94,
   "end": 273.62,
   "text": "یه علامه‌ای رو پیدا می‌کنه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 273.62,
   "end": 279.84,
   "text": "که دستتو بگیره همون بلا رو سرت بیاره که سر ما آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 279.84,
   "end": 282.02,
   "text": "ها؟ این هدیه خیلی هدیه قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 282.02,
   "end": 284.82,
   "text": "کم نگیرید اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 284.82,
   "end": 289.17,
   "text": "یه صلوات هدیه کنید. اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}