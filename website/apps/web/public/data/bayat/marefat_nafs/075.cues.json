 },
 "chapters": [
  {
   "index": 0,
   "title": "متن کامل (پاکسازی‌شده)",
   "start": 1.66,
   "end": 289.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.66,
   "end": 14.66,
   "text": "محضر یک انسان الهی، دهان یک انسان الهی، و یک آدم کاملِ متصرّف این‌ها خیلی کار می‌دهد.",
   "kind": "speech",
   "chapter": 0,
   "block": 5
  },
  {
   "i": 1,
   "start": 14.66,
   "end": 31.64,
   "text": "بعضی از نفوس که مستعد باشند، زحمت کشیده باشند، تشنه و طالب باشند، به معیار و ملاکی که اولیاء در دست دارند، این‌ها را به تصرّفی دگرگون می‌کنند.",
   "kind": "speech",
   "chapter": 0,
   "block": 5
  },
  {
   "i": 2,
   "start": 31.64,
   "end": 47.86,
   "text": "یکی از اساتید خیلی به‌نام و بزرگی که ما درکشان کردیم، هدیه‌ای به ما تقدیم کردند که ایشان ارتباط با امام عصر هم داشتند و نوزده سال هم پیش‌نمازِ",
   "kind": "speech",
   "chapter": 0,
   "block": 7
  },
  {
   "i": 3,
   "start": 47.86,
   "end": 51.82,
   "text": "جماعتِ حرم حضرت اباالفضل صلوات‌الله‌علیه بودند؛",
   "kind": "speech",
   "chapter": 0,
   "block": 7
  },
  {
   "i": 4,
   "start": 51.82,
   "end": 57.56,
   "text": "قریب به بیست سال. خیلی ما از ایشان بهره بردیم.",
   "kind": "speech",
   "chapter": 0,
   "block": 7
  },
  {
   "i": 5,
   "start": 57.56,
   "end": 60.66,
   "text": "من حدوداً بیست سالم بود؛",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 6,
   "start": 60.66,
   "end": 72.6,
   "text": "از ایشان خواهش کردم که یک راهی به بنده یاد بدهید خدا به زور به من علم بدهد.",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 7,
   "start": 72.6,
   "end": 76.58,
   "text": "شما دوست دارید نه؟ دوست دارید نه واقعاً؟",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 8,
   "start": 76.58,
   "end": 78.78,
   "text": "به زور خدا بهت علم بدهد.",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 9,
   "start": 78.78,
   "end": 82.115,
   "text": "یعنی خودت یک‌هو به خودت ببینی: اِ اِ اِ.",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 10,
   "start": 82.115,
   "end": 84.62,
   "text": "اصلاً شاید خودت هم استنکاف می‌کردی؛",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 11,
   "start": 84.62,
   "end": 89.4,
   "text": "اما خدا دارد تزریق می‌کند بهت از در و دیوار.",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 12,
   "start": 89.4,
   "end": 93.6,
   "text": "این دستورالعمل را از حدود سی سال پیش بنده انجام دادم.",
   "kind": "speech",
   "chapter": 0,
   "block": 9
  },
  {
   "i": 13,
   "start": 93.6,
   "end": 97.98,
   "text": "خیلی هم آسان است و همه هم شاید دارید انجام می‌دهید ولی بی‌خبرید.",
   "kind": "speech",
   "chapter": 0,
   "block": 9
  },
  {
   "i": 14,
   "start": 97.98,
   "end": 101.12,
   "text": "شاید یک سرّ از این جلسه همان باشد اصلاً.",
   "kind": "speech",
   "chapter": 0,
   "block": 9
  },
  {
   "i": 15,
   "start": 101.12,
   "end": 108.46,
   "text": "شما دارید انجام می‌دهید؛ این جلسه را گذاشته‌اند که به شما تزریق علم کنند.",
   "kind": "speech",
   "chapter": 0,
   "block": 9
  },
  {
   "i": 16,
   "start": 108.46,
   "end": 114.42,
   "text": "ما انجام دادیم و خودم تجربه در تجربهٔ شخصی خودم دیدم این را؛",
   "kind": "speech",
   "chapter": 0,
   "block": 9
  },
  {
   "i": 17,
   "start": 114.42,
   "end": 116.03,
   "text": "واقعاً چشیدم؛",
   "kind": "speech",
   "chapter": 0,
   "block": 9
  },
  {
   "i": 18,
   "start": 116.03,
   "end": 121.62,
   "text": "بهش رسیدم. لذا چیزی که خودم چشیدم چرا از شما دریغ کنم.",
   "kind": "speech",
   "chapter": 0,
   "block": 9
  },
  {
   "i": 19,
   "start": 121.62,
   "end": 134.36,
   "text": "فرمودند که بعد از هر نماز واجب‌تان، بعد از تسبیحات حضرت صدیقهٔ شهیده سلام‌الله‌علیها، آیة‌الکرسی را قرائت کنید.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 20,
   "start": 134.36,
   "end": 151.64,
   "text": "به همین راحتی. کسی که این کار را مداومت کند، خدا کفیل او می‌شود از حیث تعلیم علم.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 21,
   "start": 151.64,
   "end": 158.17,
   "text": "یک خاطرهٔ کوچولو بگویم که نیمهٔ نیمچهٔ این خاطره را فعلاً نصفش طلب‌تان؛",
   "kind": "speech",
   "chapter": 0,
   "block": 13
  },
  {
   "i": 22,
   "start": 158.17,
   "end": 163.22,
   "text": "ان‌شاءالله با هم رفیق‌تر شدیم کاملش را برایتان می‌گویم.",
   "kind": "speech",
   "chapter": 0,
   "block": 13
  },
  {
   "i": 23,
   "start": 163.22,
   "end": 169.5,
   "text": "محضر علامه بودیم یک روز در اتاق شخصی‌شان آن اتاقی که شاید رفته‌اید یا نه؛",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 24,
   "start": 169.5,
   "end": 176.68,
   "text": "دور تا دورش با کتاب‌های دست‌نویسِ خودشان بود.",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 25,
   "start": 176.68,
   "end": 180.84,
   "text": "ما یک سه‌چهار تا طلبه و دانشجوی معتمد رفتیم.",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 26,
   "start": 180.84,
   "end": 184.9,
   "text": "همه حرف می‌زدند؛ همه سؤال می‌کردند؛",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 27,
   "start": 184.9,
   "end": 188.96,
   "text": "همه مزاحم علامه بودند.",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 28,
   "start": 188.96,
   "end": 191.86,
   "text": "تنها کسی که ساکت بود بنده بودم.",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 29,
   "start": 191.86,
   "end": 194.92,
   "text": "من فقط ایشان را نگاه می‌کردم و لذت می‌بردم.",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 30,
   "start": 194.92,
   "end": 202.1,
   "text": "هیچی، هیچی. فقط آنچه از من ظهور می‌کرد، عطش وجودی بود.",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 31,
   "start": 202.1,
   "end": 205.66,
   "text": "با تشنگی علامه را نگاه می‌کردم.",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 32,
   "start": 205.66,
   "end": 211.28,
   "text": "سر تا پای علامه را مثل یک آدم تشنه‌ای که به آب رسیده نگاه می‌کردم.",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 33,
   "start": 211.28,
   "end": 214.56,
   "text": "شاید ایشان این را درک کرد؛ نمی‌دانم.",
   "kind": "speech",
   "chapter": 0,
   "block": 14
  },
  {
   "i": 34,
   "start": 214.56,
   "end": 217.56,
   "text": "دست مرا ایشان گرفت؛ گفت: یک کاری باهات می‌کنم؛",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 35,
   "start": 217.56,
   "end": 220.12,
   "text": "نروی کسی را برداری بیاوری بگویی این کار را باهاش بکن.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 36,
   "start": 220.12,
   "end": 226.347,
   "text": "گفتم چشم. رنگم هم پرید و خلاصه یک کاری با ما کرد ایشان.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 37,
   "start": 226.347,
   "end": 228.8,
   "text": "آن کارها بماند فعلاً؛",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 38,
   "start": 228.8,
   "end": 232.28,
   "text": "هدیهٔ شما باشد فعلاً.",
   "kind": "speech",
   "chapter": 0,
   "block": 15
  },
  {
   "i": 39,
   "start": 232.28,
   "end": 239.24,
   "text": "آن کاری که علامه کرد و بعد از آن لطف ایشان، من یک چیزکی دیدم؛",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 40,
   "start": 239.24,
   "end": 244.24,
   "text": "دارم می‌فهمم از همین مباحث سنگین و پیچیدهٔ حکمت و عرفان را.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 41,
   "start": 244.24,
   "end": 256.06,
   "text": "و شاید یک وجه اینکه بعضی‌ها به من می‌گویند شما آن مسائل خیلی سنگین و عرشی را که ما از هرکی می‌شنویم گیج می‌شویم، به زبان ساده بیان می‌کنی و آن لطف",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 42,
   "start": 256.06,
   "end": 259.8,
   "text": "علامه بود؛ آن در ادامهٔ همین بود؛",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 43,
   "start": 259.8,
   "end": 265.6,
   "text": "همین. همین دستورالعملی که الان به شما عرض کردم. یعنی برکت این بود.",
   "kind": "speech",
   "chapter": 0,
   "block": 17
  },
  {
   "i": 44,
   "start": 265.6,
   "end": 268.94,
   "text": "نترسید. همین. شما این کار را انجام بده؛",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 45,
   "start": 268.94,
   "end": 270.62,
   "text": "بعد ببین خدا باهات چیکار می‌کند.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 46,
   "start": 270.62,
   "end": 274.67,
   "text": "یک علامه‌ای را پیدا می‌کند خدا که دستت را بگیرد؛",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 47,
   "start": 274.67,
   "end": 280.64,
   "text": "همان بلا را سرت بیاورد که سر ما آورد.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 48,
   "start": 280.64,
   "end": 284.19,
   "text": "این هدیه خیلی هدیهٔ قشنگی است. کم نگیرید این را.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 49,
   "start": 284.19,
   "end": 286.2,
   "text": "یک صلوات هدیه کنید.",
   "kind": "speech",
   "chapter": 0,
   "block": 18
  },
  {
   "i": 50,
   "start": 286.2,
   "end": 289.17,
   "text": "اللهمّ صلّ علی محمد و آل محمد",
   "kind": "quote",
   "chapter": 0,
   "block": 19,
   "translation": "خدایا بر محمد و خاندان محمد درود فرست."
  }
 ]
}