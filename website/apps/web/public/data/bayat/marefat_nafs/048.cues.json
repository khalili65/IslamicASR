   "start": 333.36,
   "end": 500.66
  },
  {
   "index": 4,
   "title": "ضرورت حرکت در مسیر یک انسان جامع",
   "start": 500.66,
   "end": 563.46
  },
  {
   "index": 5,
   "title": "تفاوت «اعلام و القا» با «الهام»",
   "start": 563.46,
   "end": 611.82
  },
  {
   "index": 6,
   "title": "الهام و شدت محبت",
   "start": 611.82,
   "end": 632.54
  },
  {
   "index": 7,
   "title": "ملاک تشخیص رحمانی یا شیطانی بودن واردات",
   "start": 632.54,
   "end": 958.22
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.06,
   "end": 4.02,
   "text": "کسی می‌خواد تشریف ببره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.02,
   "end": 9.52,
   "text": "خدا پشت و پناهش باشه. یه بیست دقیقه‌ای اگر سوالی باشه، اگر نباشه که هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.52,
   "end": 13.88,
   "text": "میکروفون هم اینجا هست دوستان هر کس سوال داره خواهشا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.88,
   "end": 19.0,
   "text": "بدون م-میکروفون مطرح نشه که چون می‌مونه سال‌ها تو صوت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.0,
   "end": 20.68,
   "text": "خدا خیر به همتون بده. ارادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.68,
   "end": 24.44,
   "text": "خدانگهدار. سلام حاج آقا خسته نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.44,
   "end": 29.5,
   "text": "سلام علیک. حاج آقا در مورد اق-اغرار و الهامات پایه‌اش عشقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.5,
   "end": 36.14,
   "text": "درسته؟ حالا ما یک احادیثی هم هست و هم آیه قرآن هست که \"ليس للانسان الا ما سعى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.14,
   "end": 38.56,
   "text": "یعنی پای عشق هم سعى انسان می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.56,
   "end": 40.84,
   "text": "حالا تو شروع عشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.84,
   "end": 44.86,
   "text": "الان ما بزرگواری رو داریم مثل علامه حسن‌زاده یا یک شخص دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.86,
   "end": 49.62,
   "text": "آیا خدا با علمش آینده این بزرگواران رو می‌دونست از همون اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.62,
   "end": 51.96,
   "text": "به این سعى ایشون برکت می‌ده یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.96,
   "end": 54.84,
   "text": "تفاوت نداره شروعشون یکیه این‌ها با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.84,
   "end": 58.68,
   "text": "شروع این علامه حسن‌زاده با یک نفر دیگه این‌ها یکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.68,
   "end": 60.28,
   "text": "عشقشون از صفر شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.28,
   "end": 63.44,
   "text": "چجوری هستش این؟ آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.44,
   "end": 68.06,
   "text": "باز مثل طبق معمول سوالات آقای روحاني زیبا و باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.06,
   "end": 73.86,
   "text": "بله \"ليس للانسان الا ما سعى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.86,
   "end": 76.85,
   "text": "هرچی که بر-- اصلا چیزی بر انسان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.85,
   "end": 78.92,
   "text": "\"ليس\" نفيه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.92,
   "end": 80.86,
   "text": "نیست مگر اون سعيي که می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 80.86,
   "end": 88.18,
   "text": "حالا آیا می‌شه کسی سعى و تلاش بکنه در جهتی که به اون علاقه نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.18,
   "end": 92.62,
   "text": "اساسا انسان سعى و تلاشش به سمت علاقه‌هاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.62,
   "end": 95.82,
   "text": "حتی اگر در صورت ظاهر دیده نشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.82,
   "end": 100.91,
   "text": "در نیتش هست. به چه خاطر شما نماز خوندین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 100.91,
   "end": 106.32,
   "text": "اون نیته مهمه دیگه. شاید یه کسی نماز بخونه برای اینکه چک‌ش پاس بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.32,
   "end": 109.16,
   "text": "یه کسی نماز بخونه برای اینکه خدا رو در آغوش بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.16,
   "end": 113.74,
   "text": "این‌ها خیلی با هم متفاوت‌اند. هر دوتاشون ظاهرا یه کار کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.74,
   "end": 123.36,
   "text": "اما اینکه این سعی و این تلاش به چه خاطر انجام شد، به اون انگیزه، به اون نیت برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.36,
   "end": 127.82,
   "text": "هر دو به خاطر اون نیت و انگیزه‌شون تلاش رو انجام میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.82,
   "end": 131.38,
   "text": "خب این عشق به این داره که دنیاش پاس بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.38,
   "end": 135.24,
   "text": "اون عشق به این داره که اصلا چیزی از خدا جز خدا، خدا رو نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.24,
   "end": 138.9,
   "text": "می‌خواد خدا رو در آغوش بکشه، معانقه با خدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.9,
   "end": 143.72,
   "text": "درسته؟ صورت ظاهر یکیه اما زمین تا آسمون متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.72,
   "end": 148.44,
   "text": "اتفاقا این برکتی که شما برمی‌گردی برمی‌گرده به اون انگیزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.44,
   "end": 151.7,
   "text": "نه به صورت ظاهر. به اون نیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.7,
   "end": 154.46,
   "text": "به چه خاطر این کار رو انجام داد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.46,
   "end": 161.72,
   "text": "اگر کسی می‌بینید سیر زندگیش برکت پیدا می‌کنه، صد درصد بدونید نیتش خالص بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.72,
   "end": 164.58,
   "text": "نیتش الهی‌تر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.58,
   "end": 167.76,
   "text": "اگر موفق می‌شه نیتش درست بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.76,
   "end": 169.76,
   "text": "صورت که برای همه یکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.76,
   "end": 176.3,
   "text": "شما نماز حضرت امام رو دیدید تو ماه مبارک رمضان می‌خونه و معمولا تو تلویزیون هم پخش می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.3,
   "end": 178.16,
   "text": "دیدید؟ چقدر ساده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.16,
   "end": 180.52,
   "text": "اون شبی که مهمانی افطاری دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.52,
   "end": 185.62,
   "text": "در جمکران. اصلاً نماز من از حضرت امام نمازم طولانی‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.62,
   "end": 189.38,
   "text": "نماز مغرب و عشای ایشون می‌خونه بعد می‌شینه منتظر رهبر عزیزمون می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.38,
   "end": 192.36,
   "text": "دیدید دیگه. چقدر ساده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.36,
   "end": 196.46,
   "text": "حتی مثلاً تسبیحات چیز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.46,
   "end": 198.36,
   "text": "حتی سلام آخر رو فقط میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.36,
   "end": 200.02,
   "text": "دقت کردید اصلاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.02,
   "end": 203.02,
   "text": "دو تا سلام اول که مستحبه نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.02,
   "end": 210.82,
   "text": "یه روزی من این نماز امامو دیدم ادای ایشونو در آوردم تو یه نماز جماعتی فقط سلام سوم، گفتن نماز سلام سوم واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.82,
   "end": 214.4,
   "text": "اون دو تا اول مستحبه. فقط سلام سومو دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.4,
   "end": 217.2,
   "text": "یکی از مداح‌های خیلی هم دوسش داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.2,
   "end": 218.72,
   "text": "جمکران اومد به من تشر زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 218.72,
   "end": 220.9,
   "text": "حاجی این چه نمازو خراب کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.9,
   "end": 225.58,
   "text": "این چه وضعشه؟ چرا فقط نماز سلام آخرو دادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 225.58,
   "end": 227.34,
   "text": "اصلاً نوندم بهش چی بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 227.34,
   "end": 230.28,
   "text": "یعنی نماز خراب شد؟ یعنی حضرت امام نمازو خراب کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 230.28,
   "end": 233.1,
   "text": "سلام آخر، این چه تفکریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 233.1,
   "end": 239.96,
   "text": "اون چیزی که برکت میده یعنی منجر می‌شه به اینکه خدا به یه کسی به قول شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 239.96,
   "end": 243.62,
   "text": "برکت بیشتری میده، نیت طرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.62,
   "end": 245.32,
   "text": "به نیت‌ها نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 245.32,
   "end": 251.16,
   "text": "حالا این هم درسته که بگیم خدا که آگاه بود به نیت پاک این شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 251.16,
   "end": 259.06,
   "text": "بله از ابتدای بچگیش هم کمکش می‌کنه که نیت‌هاش رو زودتر پاک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.06,
   "end": 263.62,
   "text": "خب بالاخره صیره. پاک‌سازی نیت هم خودش یک حرکته، یک صیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.62,
   "end": 268.64,
   "text": "هم اینکه استاد ببینه همینطوری باری به هرجت نره جلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.64,
   "end": 273.64,
   "text": "تربیتش می‌کنه کارشو-- مثل حضرت صدیقه شهیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 273.64,
   "end": 275.24,
   "text": "دیگه. امتحان پس دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 275.24,
   "end": 282.24,
   "text": "البته بعضی از عرفا خیلی کم‌ان البته اما معتقدند که خدا فقط حضرت زهرا رو امتحان کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 282.24,
   "end": 288.32,
   "text": "قبل از خلقت. ما نداریم مثلاً نسبت به پیغمبر و امیرالمؤمنین و امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.32,
   "end": 291.74,
   "text": "عصر و اینا مثلاً امام حسین حتی اینا که مثلاً خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.74,
   "end": 295.16,
   "text": "شما رو یا امام حسین قبل از خلقت امتحان کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 295.16,
   "end": 302.86,
   "text": "فقط در خصوص حضرت زهرا در زیارت داریم که تو ممتحنی، امتحان پس دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.86,
   "end": 306.3,
   "text": "اون کسی که تو رو خلق کرد امتحانت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.3,
   "end": 309.94,
   "text": "قبل از اینکه خلقت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.94,
   "end": 314.12,
   "text": "این یعنی چی؟ یعنی خدا از قبل می‌دونست شماره حضرت زهرا بیسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.12,
   "end": 318.4,
   "text": "لذا خلقتش رو ممتاز قرار داد و به سیرش برکت داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.4,
   "end": 323.52,
   "text": "بله این هم درسته. اما برکت بر چی بار می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.52,
   "end": 325.84,
   "text": "بر چی؟ آفرین نیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.84,
   "end": 328.64,
   "text": "این نشون میده که چقدر نیت مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.64,
   "end": 333.36,
   "text": "خیر الأمور فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.36,
   "end": 335.14,
   "text": "اصلاً اعمال در گرو نیتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.14,
   "end": 336.4,
   "text": "اگه کسی می‌خواد این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.4,
   "end": 342.96,
   "text": "چیزی که الان عزیزم آقای روحانی فرمودن بار بشه یعنی برکت الهی بار بشه برای اعمالش، نیت‌هاشو باید پاک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.96,
   "end": 347.02,
   "text": "البته یه کار کوچیک انجام میده چنان برکت پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.02,
   "end": 356.36,
   "text": "البته این رو هم بگم لای پرانتز که لاجرم برکت صرفاً یعنی فقط و فقط در کثرت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.36,
   "end": 361.2,
   "text": "گاهی اوقات دیده می‌شه یه آدمی که چیزی برای گفتن نداره داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.2,
   "end": 367.44,
   "text": "چیزی مایه ای نداره. ولی هزار نفر آدم برن پا درسشو پا منبرشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.44,
   "end": 371.28,
   "text": "یکی هم این پنج نفرن مثل آقای بهادینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.28,
   "end": 373.68,
   "text": "پنج نفر می‌رفتن پا درسشون اواخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.68,
   "end": 378.0,
   "text": "دیگه جلساتشو اول تعطیل کرده ولی چنان درون مایه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.0,
   "end": 380.1,
   "text": "حواسمون باشه گول این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.1,
   "end": 383.32,
   "text": "ظواهر رو بعضی موقع‌ها نخوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.32,
   "end": 387.24,
   "text": "بگیم چون این دوره شلوغ‌تره مثلاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.24,
   "end": 392.8,
   "text": "چون یه بنده خدایی می‌گفت نمی‌دونم تشییع جنازه نمی‌دونم هیتلر رو می‌گفت کیو الآن یادم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.8,
   "end": 394.64,
   "text": "خیلی شلوغ‌تر از امام خمینی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.64,
   "end": 397.96,
   "text": "گفتم خب یعنی چی مثلاً؟ میخوای به چی برسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.96,
   "end": 401.22,
   "text": "میخوای بگی چون اون شلوغ‌تر بوده به حق بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.22,
   "end": 405.0,
   "text": "دهنشو بست. یعنی مراقب این قصه هم باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.0,
   "end": 408.8,
   "text": "سؤال دیگه. سلام علیکم حاج آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.8,
   "end": 411.62,
   "text": "سلام علیکُم. حاج آقا یک سؤال داشتم ما الآن آخرش جواب بدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.62,
   "end": 413.44,
   "text": "آخر سؤالم، صحبتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.44,
   "end": 415.96,
   "text": "ما الآن سنم به هفتاد و بالایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.96,
   "end": 420.36,
   "text": "از بچگی هم خیلی علاقه به اهل بیت و قرآن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.36,
   "end": 424.26,
   "text": "منبری و اینا. پای منبرها خیلی نشستم پای--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.26,
   "end": 429.14,
   "text": "از روزی که بعد انقلاب تلویزیون گذاشتن تا هنوز، هنوزم پای منبرهایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 429.14,
   "end": 432.76,
   "text": "ولی با همین حرفا که شما گفتین به آدم الهام میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.76,
   "end": 435.38,
   "text": "یه وقتی یک چیزایی بهم مثلا الهام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.38,
   "end": 437.22,
   "text": "خودم سؤال می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.22,
   "end": 443.78,
   "text": "خودمم جوابم می‌گیرم. بعد می‌خواستم بگم تو این برنامه‌ها که اینقدر ما مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 443.78,
   "end": 446.18,
   "text": "اعتقاد دارم و خیلی هم بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.18,
   "end": 450.32,
   "text": "خیلی پا هستم. وقتی میگن بعضی وقت‌ها میگن این الهام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.32,
   "end": 453.26,
   "text": "یا ما یا کس دیگه از طرف شیطان میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.26,
   "end": 459.76,
   "text": "شیطان از طرف عبادت هم یعنی آدم‌هایی که عبادت می‌کنند به طریق عبادت شیطان سراغ آدم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.76,
   "end": 461.78,
   "text": "همین سؤالو می‌خواستم بکنم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 461.78,
   "end": 467.74,
   "text": "احسن برای مادرمون با این سن بنده خدا دو ساعت نشسته اینجا تحمل کرده واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.74,
   "end": 472.52,
   "text": "حاج آقا منبری‌م حاج آقا عمریه دیگه پای منبرا می‌شینم خیلی دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.52,
   "end": 477.78,
   "text": "بعدم نشاطم فقط از اهل بیت و روضه و زیارت و اینا می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.78,
   "end": 480.38,
   "text": "اگر هر جور بالا و پایین داشت زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.38,
   "end": 482.06,
   "text": "باز نشاطم رو از اینا می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.06,
   "end": 486.88,
   "text": "اینا که می‌شینم پای منبر یا گریه یا هرچی انگار نشاط می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.88,
   "end": 490.52,
   "text": "یعنی زنده میشم دوباره پا میشم- این‌ها برای ما حجتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 490.52,
   "end": 492.61,
   "text": "این جسارت می‌کنم ببخشید- سلام علیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 492.61,
   "end": 494.38,
   "text": "لفظ پیرزن استفاده می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 494.38,
   "end": 497.36,
   "text": "اشکال نداره. خودم گفتم حاج آقا هفتاد سال به بالایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 497.36,
   "end": 500.66,
   "text": "مادر مای. ایشون با این سن حجته بر همه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 500.66,
   "end": 503.66,
   "text": "من معتقدم یکی از-- حالا می‌دونم می‌خوای هرچی بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 503.66,
   "end": 508.84,
   "text": "میخوای بحث علمی بگیری، ذوق بگیری، بگی حاجی یه چیزی گفت انکار کن منو هرچی دوست--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 508.84,
   "end": 517.62,
   "text": "معتقدم کسی که دم از امام خمینی و رهبر و انقلاب، انقلابی بودن می‌زنه اما خبری از fusus و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 517.62,
   "end": 521.88,
   "text": "asfar و تمهید القواعد و اشارات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 521.88,
   "end": 524.94,
   "text": "شیخ الرئیس و فتوحات و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 524.94,
   "end": 528.14,
   "text": "نداره مثل باقل انس ابن فنار اینا نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 528.14,
   "end": 532.56,
   "text": "بی‌خود داره دم می‌زنه. ساکت باشه هرکی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.56,
   "end": 536.92,
   "text": "وقتی گنده ما عقلا رو دعوت کرده ما هم باید بریم اون سمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 536.92,
   "end": 541.1,
   "text": "الآن خ-وجود این خانممون اینجا حج-- این مادر اینجا حجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.1,
   "end": 545.14,
   "text": "سر سفره‌ی علامه چقدر از فصوص گفتیم، از فتوحات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 545.14,
   "end": 550.11,
   "text": "از، از مفار گفتیم، از فرمایشات حضرت استاد، از مصباح الانس گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.11,
   "end": 555.4,
   "text": "ایشون نشسته پای درس این‌ها. حالا سؤال ایشون هم جواب بدم سؤال قشنگی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 555.4,
   "end": 560.26,
   "text": "ببینید عزیزان ما اگر خوب درس و بحث‌ها رو با همدیگه بریم جلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 560.26,
   "end": 564.74,
   "text": "پشت سر انسان جامع و اطرافی الحمد لله مثل علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 564.74,
   "end": 571.04,
   "text": "قرار بگیریم. بنده معتقدم جامع‌تر از ایشون ما نداشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 571.04,
   "end": 573.02,
   "text": "و الا من انقدر وقت شما رو نمی‌گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 573.02,
   "end": 576.5,
   "text": "انقدر قاطعانه از ایشون دم نمی‌زدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.5,
   "end": 581.56,
   "text": "ما دستمون کوتاهه. باید دستمون رو بدیم به دست آدمی که کامل جامع‌تر از همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 581.56,
   "end": 584.64,
   "text": "بحث علمیت. ما جامع‌تر از ایشون--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 584.64,
   "end": 589.06,
   "text": "تنها کسی که رهبر عزیزون لقب ذو فنون رو داد به ایشون یعنی علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 589.06,
   "end": 591.26,
   "text": "ذو فنون یعنی علامه، ایشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 591.26,
   "end": 594.26,
   "text": "حجت تمومه دیگه. خب بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 594.26,
   "end": 597.02,
   "text": "حالا شاید علامه یه جاهایی هم اشکال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 597.02,
   "end": 598.84,
   "text": "بهش وارد باشه. به من چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 598.84,
   "end": 601.92,
   "text": "مگه من می‌فهمم این چیزا رو؟ اهلش بگن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 601.92,
   "end": 604.38,
   "text": "در تراز علامه بگن، نه من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 604.38,
   "end": 606.98,
   "text": "من باید بگم چشم. سمعنا واطاعنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.98,
   "end": 611.48,
   "text": "درست شد؟ علامه تو درس و بحثش که امروز هم یه چیزکی گفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 611.48,
   "end": 616.22,
   "text": "اگر دقت کنید بیایید جلو این سؤالات همش جواب داده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 616.22,
   "end": 621.4,
   "text": "فرمودم قبلاً هم گفتم در اعلام، در نحوه تجلیات حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 621.4,
   "end": 627.74,
   "text": "در اعلام و القا شیطان می‌تونه دخالت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.74,
   "end": 630.84,
   "text": "می‌تونه تصرف کنه. یعنی شما یه چیزی رو ببینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 630.84,
   "end": 634.38,
   "text": "یه چیزی رو بشنوی، اعلام بشه به شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 634.38,
   "end": 637.42,
   "text": "خواب ببینی تو خواب بگی-- بهت بگن این کارو بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.42,
   "end": 645.78,
   "text": "مثل اون عالمی که خواب دید فرمود اولین چیزی که فردا هر-- اولین کسی که اومد وارد مسجد شد احترامش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 645.78,
   "end": 647.56,
   "text": "اولین موجودی که وارد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 647.56,
   "end": 649.28,
   "text": "بعد سه بار این خوابو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 649.28,
   "end": 652.24,
   "text": "هر سه بار سگ وارد مسجد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 652.24,
   "end": 653.96,
   "text": "گفت خب من باید سگ رو احترام کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 653.96,
   "end": 656.92,
   "text": "گفت شریعت مقدس ما گفته سگ رو از مسجد بیرون کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 656.92,
   "end": 659.92,
   "text": "چه خبر؟ بیرون کرد. شب بهش تشر زدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 659.92,
   "end": 662.78,
   "text": "مگه ما به شما نگفتیم اولین کسی که اومد احترام کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 662.78,
   "end": 666.5,
   "text": "چرا بیرونش کردی؟ فردا اومد هرکی اومد احترام می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 666.5,
   "end": 668.6,
   "text": "حالا اسم اون عالم یادم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 668.6,
   "end": 670.6,
   "text": "این اعلامه. اعلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 670.6,
   "end": 675.28,
   "text": "تو رتبه مثالی‌ش در خواب بهش اعلام شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 675.28,
   "end": 678.36,
   "text": "بعد هر سه بار عکسشو عمل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 678.36,
   "end": 681.4,
   "text": "این اعلام شیطانیه. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 681.4,
   "end": 684.68,
   "text": "چون مطابق با شریعت مقدس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 684.68,
   "end": 688.92,
   "text": "شب چهارم تحویلش گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 688.92,
   "end": 692.52,
   "text": "حالا این دیگه شد الهام. شب چهارم اومدن سراغش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 692.52,
   "end": 696.68,
   "text": "آفرین به شما که اعلام شیاطین رو پس زدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 696.68,
   "end": 699.74,
   "text": "حالا تو آماده‌ای که ما به تو افاضه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 699.74,
   "end": 703.56,
   "text": "این شکلی می‌شه. اعلام رو شیاطین می‌تونن باید مراقب باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 703.56,
   "end": 707.06,
   "text": "القا رو هم شیاطین می‌تونن باید مراقب باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 707.06,
   "end": 709.26,
   "text": "این همه وجوه قرآنی داره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 709.26,
   "end": 711.18,
   "text": "الان برید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 711.18,
   "end": 713.56,
   "text": "بررسی کنید تو قرآن آیاتش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 713.56,
   "end": 716.6,
   "text": "علامه فرمودن چی شیطان نمی‌تونه درش نفوذ کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 716.6,
   "end": 719.7,
   "text": "دو چیز. الهام و ایها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 719.7,
   "end": 722.2,
   "text": "الهام رو امروز بحث کردیم. الهام از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 722.2,
   "end": 723.94,
   "text": "شدت محبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 723.94,
   "end": 732.66,
   "text": "عاشق اهل بیت باشی، عاشق نماز باشی، عاشق خدا باشی، سیر حبّی داشته باشی که یه چیزکیشو امروز عرض کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 732.66,
   "end": 736.76,
   "text": "می‌کشاند به نحو الهام. بعد حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 736.76,
   "end": 739.56,
   "text": "نکته آخر در جواب مادر عزیزمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 739.56,
   "end": 743.52,
   "text": "از کجا بفهمیم که این الهامه یا القائه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 743.52,
   "end": 746.72,
   "text": "یا اعلامه یا ایحاءئه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 746.72,
   "end": 748.7,
   "text": "یا نه، یه طور دیگه سؤال رو مطرح کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 748.7,
   "end": 752.76,
   "text": "از کجا بفهمیم این اصلاً رحمانیه یا شیطانیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 752.76,
   "end": 755.4,
   "text": "یه بار جواب دادم. ببینم کی حاضر جوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 755.4,
   "end": 758.8,
   "text": "همینو گفتم. .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 758.8,
   "end": 760.76,
   "text": "آفرین به اون آقایی که لهجه اصفهانی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 760.76,
   "end": 764.2,
   "text": "اسمشو یادم... آقای فاطمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 764.2,
   "end": 768.7,
   "text": "کاظمی. یادم باشه آقای کاظمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 768.7,
   "end": 775.96,
   "text": "علامه باز الحمد لله خدا ya چجوری تو رو شکر بگم که هر سؤالی، هر مطلبی، یه چیزی از علامه تو ذهن من میاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 775.96,
   "end": 778.54,
   "text": "علامه عل-- خدا روحشو شاد کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 778.54,
   "end": 783.0,
   "text": "فرمودن که من به شما بگم، یه محک دست شما، ملاک دست شما بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 783.0,
   "end": 790.68,
   "text": "چه در خواب، چه در تمسلات، چه در شنود، چه در شهود، چه در اعلان، چه در القا، چه در الهام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 790.68,
   "end": 793.46,
   "text": "چه در ایحاء. اصلاً تشخیص نمیدی کدومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 793.46,
   "end": 796.08,
   "text": "هرچی. هر کدوم که دیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 796.08,
   "end": 798.36,
   "text": "م-ملاک اصلی نفس خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 798.36,
   "end": 801.92,
   "text": "اگر دیدی نفست منبسط شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 801.92,
   "end": 807.44,
   "text": "حال خوبی پیدا کردی، احساس خوبی داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 807.44,
   "end": 810.94,
   "text": "روشن شدی، نورانی شدی، منبسط شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 810.94,
   "end": 813.6,
   "text": "چی بگم دیگه. این فرمایشات حضرت استاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 813.6,
   "end": 822.82,
   "text": "همین ال-همین الفاظ رو. یعنی حالت خوب شد از دیدن این، از چشیدن این، از خواب، از این خواب، از این تمسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 822.82,
   "end": 826.54,
   "text": "اون به حقه. اون رؤیا صادقه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 826.54,
   "end": 829.66,
   "text": "اون شنود صادق‌ست. اون شهود صادق‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 829.66,
   "end": 833.8,
   "text": "اما اگر به عکس، حالا اون اولیه رشحه ای از چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 833.8,
   "end": 836.76,
   "text": "بهشته. حالت رو خوب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 836.76,
   "end": 839.22,
   "text": "نفست رو منبسط می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 839.22,
   "end": 845.46,
   "text": "نشاط پیدا می‌کنی. نشاط در عبادت، نشاط در ذکر خدا، نشاط در جهاد در راه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 845.46,
   "end": 847.7,
   "text": "بخوای جان بدی. از گناه بدت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 847.7,
   "end": 853.52,
   "text": "اینا نشانه هاشه. اما اگه بالعکس حالت بد شد، منقبض شدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 853.52,
   "end": 857.26,
   "text": "دیدی اصلاً حال عبادت نداری، اعصابت خورد شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 857.26,
   "end": 864.1,
   "text": "بلد نیستی با زنت آروم با عطوفت رفتار کنی، حوصله زنت رو نداری، حوصله بچت رو نداری، اینا همش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 864.1,
   "end": 865.84,
   "text": "رشحه‌های جهنمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 865.84,
   "end": 868.18,
   "text": "رد پای شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 868.18,
   "end": 875.14,
   "text": "رژیمه دیگه. اینم یه جواب قانع‌کننده عالی از سمت آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 875.14,
   "end": 878.32,
   "text": "حضرت علامه به مادر عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 878.32,
   "end": 879.92,
   "text": "انشاالله خدا همتون رو حفظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 879.92,
   "end": 883.32,
   "text": "جلسه خیلی خوبی بود هم بحثش خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 883.32,
   "end": 885.68,
   "text": "هیجانی شد و تقریباً چالشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 885.68,
   "end": 888.66,
   "text": "ای کاش آقای کاظمی هم می‌اومد تو بحث، اون ادامه می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 888.66,
   "end": 891.88,
   "text": "من دوست دارم چالشی بشه بحث‌ها شیرین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 891.88,
   "end": 894.6,
   "text": "یه ذره اومدی جلو باز عقب کشیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 894.6,
   "end": 899.56,
   "text": "و دیگران هم همینطور. خواهرها و برادرها بحث‌ها رو چالشی کنید با حفظ حرمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 899.56,
   "end": 903.48,
   "text": "هم درس نسمون خیلی خوب بود. الحمد لله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 903.48,
   "end": 906.22,
   "text": "باز هم قبول دارید که جای خیلیا خالی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 906.22,
   "end": 909.92,
   "text": "امروز؟ برای سلامتی اون‌ها هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 909.92,
   "end": 913.2,
   "text": "و سلامتی خودتون و خانواده‌هاتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 913.2,
   "end": 917.84,
   "text": "باز هم مثل حضرت استاد علامه حسن زاده صلوات قشنگ ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 917.84,
   "end": 920.32,
   "text": "اللهم صل علی محمد و آل محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 920.32,
   "end": 924.3,
   "text": "عجل فرجهم. دعامون یادمون نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 924.3,
   "end": 929.3,
   "text": "دعا. اللهم باریک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 929.3,
   "end": 931.38,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 931.38,
   "end": 933.82,
   "text": "صلوات. اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 933.82,
   "end": 940.94,
   "text": "محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 940.94,
   "end": 943.78,
   "text": "جانم؟ آقای رنجبر منتظر شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 943.78,
   "end": 946.1,
   "text": "کی؟ آقای رنجبر منتظر شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 946.1,
   "end": 947.9,
   "text": "چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 947.9,
   "end": 950.46,
   "text": "اینا مخلص آقای رنجبرن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 950.46,
   "end": 954.2,
   "text": "ضربه پروری می‌کنن. با اجازتون من فارغ شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 954.2,
   "end": 957.06,
   "text": "سوالی چیزی داشتید باشه وقته دیگه آقای رنجبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 957.06,
   "end": 958.22,
   "text": "نیست. آقای رنجبر فارغ شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}