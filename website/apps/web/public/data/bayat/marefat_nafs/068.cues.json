 "chapters": [
  {
   "index": 0,
   "title": "خاطره‌ای از محضر علامه حسن‌زاده آملی دربارهٔ رهبر انقلاب",
   "start": 2.68,
   "end": 22.72
  },
  {
   "index": 1,
   "title": "«جانم به فدایش، جانم به فدایش، جانم به فدایش.»",
   "start": 22.72,
   "end": 42.76
  },
  {
   "index": 2,
   "title": "«به جانم سوگند، ایشان تنها عالمی است که گرد و غبار دنیا روی عبای مبارکش ننشسته است.»",
   "start": 42.76,
   "end": 103.06
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.68,
   "end": 7.4,
   "text": "محضر حضرت علامه حسن زاده علیه الرحمه و الرضوان بودند در اتاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.4,
   "end": 14.16,
   "text": "شخصی خودشون و حرف از رهبر به میان اومد و بنده از ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.16,
   "end": 16.83,
   "text": "سؤال کردم نظرتون در خصوص آقا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.83,
   "end": 19.53,
   "text": "ایشون خیلی برام شیرین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.53,
   "end": 22.72,
   "text": "اینکه تکیه داده بودن عصای مبارک به سینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.72,
   "end": 29.24,
   "text": "چسبونده بودن. تا من اسم آقا رو آوردم رهبر عزیزمون رو، ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.24,
   "end": 33.42,
   "text": "سه مرتبه مثل رکوع خم شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.42,
   "end": 36.7,
   "text": "در حالی که نشسته بودند خم شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.7,
   "end": 42.76,
   "text": "سه مرتبe فرمودند جانم به فدایش، جانم به فدایش، جانم به فدایش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.76,
   "end": 48.92,
   "text": "بعد رو کردند به بنده فرمودند یه جمله طلایی و کلیدی که همیشه تو گوشم زنگ می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.92,
   "end": 56.78,
   "text": "بارها خدمت شما عرض کردم باز هم تبرّکاً عرض می‌کنم جایی داره که با آب طلا نوشته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.78,
   "end": 67.86,
   "text": "فرمودند که در خصوص آقا که فرمودند به جانم سوگند ایشون تنها عالمی است که گرد و غبار دنیا روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 67.86,
   "end": 69.88,
   "text": "عبای مبارکش ننشسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 69.88,
   "end": 76.44,
   "text": "بالای منبر در یادمان شهید حججی دهه محرمی بود این رو عرض کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 76.44,
   "end": 83.06,
   "text": "در اصل باعث تعجبشون شده بود و سبک و سیاق و کلمات و جمله رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 83.06,
   "end": 87.64,
   "text": "اینا ذوفنونن همینطوری مثل ما دهان باز نمی‌کنن حرف بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 87.64,
   "end": 94.08,
   "text": "حساب شده سخن میگن. گرد و غبار دنیا روی عبا، نه اونم قبا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 94.08,
   "end": 98.62,
   "text": "لایه زیرینه، رو اون لایه روین که عبا هم هست نشسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 98.62,
   "end": 100.9,
   "text": "خیلی حرفا اینجا بگو بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 100.9,
   "end": 103.06,
   "text": "ما قدر آقا رو نمی‌دونستیم و نمی‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}