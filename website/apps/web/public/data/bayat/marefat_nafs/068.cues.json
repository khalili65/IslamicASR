 "chapters": [
  {
   "index": 0,
   "title": "متن کامل (پاکسازی‌شده)",
   "start": 2.68,
   "end": 103.06
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.68,
   "end": 12.78,
   "text": "محضر حضرت علامه حسن‌زاده علیه الرحمة و الرضوان بودند، در اتاق شخصی خودشان، و حرف از رهبر به میان آمد.",
   "kind": "speech",
   "chapter": 0,
   "block": 5
  },
  {
   "i": 1,
   "start": 12.78,
   "end": 16.8,
   "text": "بنده از ایشان سؤال کردم: نظرتان در خصوص آقا چیست؟",
   "kind": "speech",
   "chapter": 0,
   "block": 5
  },
  {
   "i": 2,
   "start": 16.8,
   "end": 24.82,
   "text": "ایشان خیلی برایم شیرین بود تکیه داده بودند و عصای مبارک را به سینه چسبانده بودند.",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 3,
   "start": 24.82,
   "end": 33.42,
   "text": "تا من اسم آقا را آوردم، رهبر عزیزمان را، ایشان سه مرتبه مثل رکوع خم شدند؛",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 4,
   "start": 33.42,
   "end": 36.7,
   "text": "در حالی که نشسته بودند خم شدند.",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 5,
   "start": 36.7,
   "end": 42.76,
   "text": "سه مرتبه فرمودند: «جانم به فدایش، جانم به فدایش، جانم به فدایش.»",
   "kind": "speech",
   "chapter": 0,
   "block": 6
  },
  {
   "i": 6,
   "start": 42.76,
   "end": 48.92,
   "text": "بعد رو کردند به بنده و فرمودند یک جملهٔ طلایی و کلیدی که همیشه توی گوشم زنگ می‌خورد.",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 7,
   "start": 48.92,
   "end": 50.78,
   "text": "بارها خدمت شما عرض کردم؛",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 8,
   "start": 50.78,
   "end": 52.84,
   "text": "باز هم تبرّکاً عرض می‌کنم؛",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 9,
   "start": 52.84,
   "end": 56.78,
   "text": "جایی دارد که با آب طلا نوشته شود.",
   "kind": "speech",
   "chapter": 0,
   "block": 8
  },
  {
   "i": 10,
   "start": 56.78,
   "end": 69.88,
   "text": "فرمودند در خصوص آقا به جانم سوگند، ایشان تنها عالمی است که گرد و غبار دنیا روی عبای مبارکش ننشسته.",
   "kind": "speech",
   "chapter": 0,
   "block": 9
  },
  {
   "i": 11,
   "start": 69.88,
   "end": 76.44,
   "text": "بالای منبر، در یادمان شهید حججی، دههٔ محرمی بود این را عرض کردند.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 12,
   "start": 76.44,
   "end": 78.98,
   "text": "در اصل باعث تعجب‌شان شده بود؛",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 13,
   "start": 78.98,
   "end": 83.06,
   "text": "و سبک و سیاق و کلمات و جمله را ببینید.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 14,
   "start": 83.06,
   "end": 90.2,
   "text": "این‌ها ذوفنون‌اند؛ همین‌طوری مثل ما دهان باز نمی‌کنند حرف بزنند؛ حساب‌شده سخن می‌گویند.",
   "kind": "speech",
   "chapter": 0,
   "block": 11
  },
  {
   "i": 15,
   "start": 90.2,
   "end": 95.0,
   "text": "گرد و غبار دنیا روی عبا نه آن‌هم قبا که لایهٔ زیرین است؛",
   "kind": "speech",
   "chapter": 0,
   "block": 12
  },
  {
   "i": 16,
   "start": 95.0,
   "end": 98.62,
   "text": "روی آن لایهٔ رویین که عبا هم هست ننشسته.",
   "kind": "speech",
   "chapter": 0,
   "block": 12
  },
  {
   "i": 17,
   "start": 98.62,
   "end": 100.9,
   "text": "خیلی حرف‌ها اینجا بگو و بماند.",
   "kind": "speech",
   "chapter": 0,
   "block": 12
  },
  {
   "i": 18,
   "start": 100.9,
   "end": 103.06,
   "text": "ما قدر آقا را نمی‌دانستیم و نمی‌دانیم.",
   "kind": "speech",
   "chapter": 0,
   "block": 12
  }
 ]
}