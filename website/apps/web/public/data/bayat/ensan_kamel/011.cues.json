   "title": "## تقدیم سوره‌ی قدر در ظهر عاشورا",
   "start": 9.24,
   "end": 248.16
  },
  {
   "index": 1,
   "title": "## باب یازدهم انسان کامل؛ قلب محل تجمع حقایق",
   "start": 248.16,
   "end": 534.48
  },
  {
   "index": 2,
   "title": "## قلب مهدی و دگرگونی عالم در عاشورا",
   "start": 534.48,
   "end": 687.44
  },
  {
   "index": 3,
   "title": "## من کان باذلا فینا مهجته",
   "start": 687.44,
   "end": 1187.76
  },
  {
   "index": 4,
   "title": "## انسان‌العین؛ مردمک چشم عالم",
   "start": 1187.76,
   "end": 1313.34
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 3.46,
   "text": "بسم الله و بالله و على ملة رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.46,
   "end": 6.98,
   "text": "سلامٌ عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.98,
   "end": 10.8,
   "text": "همه با هم در این ظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.8,
   "end": 17.22,
   "text": "پر از اندوه و حزن و غم و اشک و آه و بلا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.22,
   "end": 24.66,
   "text": "سوره قدر رو به قلب مقدس آقامون امام عصر تقدیم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.66,
   "end": 28.84,
   "text": "أعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.84,
   "end": 34.24,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.24,
   "end": 41.14,
   "text": "إنا أنزلناه في ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.14,
   "end": 46.8,
   "text": "وما أدراك ما ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.8,
   "end": 52.02,
   "text": "ليلة القدر خير من ألف شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.02,
   "end": 63.52,
   "text": "تنزل الملائكة والروح فيها بإذن ربهم من كل أمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 63.52,
   "end": 67.92,
   "text": "سلامٌ هي حتى مطلع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 67.92,
   "end": 70.3,
   "text": "الفجر. صدق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 70.3,
   "end": 73.96,
   "text": "الله العلي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.96,
   "end": 81.04,
   "text": "صلوات الله وسلامه عليه وآله وصحبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 81.04,
   "end": 87.68,
   "text": "أجمعين. يا رب أعوذ بك من همزات الشياطين ومن شر نفسي ومن شر خلقك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 87.68,
   "end": 89.78,
   "text": "خلقك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 89.78,
   "end": 91.84,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.84,
   "end": 96.2,
   "text": "لا حول ولا قوة إلا بالله العلي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 96.2,
   "end": 101.74,
   "text": "اللهم إياك نعبد وإياك نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.74,
   "end": 108.5,
   "text": "الحمد لله على كل نعمته وأسأل الله من فضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 108.5,
   "end": 115.82,
   "text": "اللهم صلِّ وسلِّم وزد وبارك على صاحب الدعوة النبوية،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 115.82,
   "end": 122.64,
   "text": "والسلطة الحيدرية، والعصمة الفاطمية، والحلم الحسنية،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 122.64,
   "end": 131.98,
   "text": "والشجاعة الحسينية، والعبادة السجادية، والمآثر الباقرية، والآثار الجعفرية،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 131.98,
   "end": 145.1,
   "text": "والعلوم الكاظمية، والحجج الرضوية، والجود التقوية، والنقاوة النقوية، والهيبة العسكرية، والغيبة الإلهية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 145.1,
   "end": 149.24,
   "text": "اللهم عجل فرجه وسهل مخرجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 149.24,
   "end": 153.34,
   "text": "واجعلنا من خير أعوانه وأنصاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 153.34,
   "end": 158.1,
   "text": "وشيعته والمستشهدين بين يديه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 158.1,
   "end": 165.9,
   "text": "المستغاث بك يا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 165.9,
   "end": 170.28,
   "text": "المستغاث بك يا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 170.28,
   "end": 174.36,
   "text": "المستغاث بك يا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 174.36,
   "end": 177.88,
   "text": "السلام عليك يا داعي الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 177.88,
   "end": 182.54,
   "text": "ورباني آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 182.54,
   "end": 184.68,
   "text": "السلام عليك حين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 184.68,
   "end": 188.86,
   "text": "تحمد وتستغفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 188.86,
   "end": 194.86,
   "text": "السلام عليك حين تصلي وتغنوط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 194.86,
   "end": 201.14,
   "text": "سلامٌ عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 201.14,
   "end": 207.42,
   "text": "السلام عليك يا مظلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 207.42,
   "end": 211.28,
   "text": "يا باب الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 211.28,
   "end": 229.34,
   "text": "حسین جان. السلام عليك يا غريب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 229.34,
   "end": 234.58,
   "text": "السلام عليك يا شهيد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 234.58,
   "end": 247.18,
   "text": "السلام عليك يا عطشان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 247.18,
   "end": 254.18,
   "text": "خیلی دوست دارم الان روضه بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 254.18,
   "end": 257.28,
   "text": "اما آقامون به ما یاد داده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 257.28,
   "end": 263.3,
   "text": "با معارف بریم جلو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 263.3,
   "end": 277.96,
   "text": "فاصله‌مون رو با حجت خدا حفظ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 277.96,
   "end": 286.5,
   "text": "باب یازدهم از کتاب شریف انسان کامل از دیدگاه نهج البلاغه حضرت علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 286.5,
   "end": 288.86,
   "text": "علیه الرحمة در روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 288.86,
   "end": 293.78,
   "text": "عاشورا و یازدهمین جلسه ما که ختم این کتاب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 293.78,
   "end": 299.38,
   "text": "می‌فرماید انسان کامل صاحب مرتبه قلب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 299.38,
   "end": 304.7,
   "text": "یادش بخیر شهدا می‌گفتند وقتی در جلسات روضه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 304.7,
   "end": 309.84,
   "text": "این‌ها می‌شینی در قلب مقدسه حضرت زهرا قرار می‌گیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 309.84,
   "end": 313.02,
   "text": "و کأنَّ در خون خانم جریان پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 313.02,
   "end": 318.08,
   "text": "حرف‌های عجیبی می‌زدند. ای خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 318.08,
   "end": 321.12,
   "text": "قلب از این حیث که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 321.12,
   "end": 326.06,
   "text": "جایگاه تقلب است، انقلاب است، دائماً دگرگونی دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 326.06,
   "end": 330.82,
   "text": "بهش میگن قلب. البته عزیزانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 330.82,
   "end": 338.18,
   "text": "اون مبحث قلب مصطفات رو گوش دادن ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 338.18,
   "end": 342.54,
   "text": "باب نهم بود به گمانم قلب مصطفات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 342.54,
   "end": 347.34,
   "text": "در حکمت همون قلب مصطفادی رو که گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 347.34,
   "end": 349.8,
   "text": "در عرفان بهش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 349.8,
   "end": 355.2,
   "text": "قلب. یعنی همون قلب مصطفى در حکمت و فلسفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 355.2,
   "end": 357.76,
   "text": "در عرفان بهش میگن قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 357.76,
   "end": 360.74,
   "text": "قلب محل تجمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 360.74,
   "end": 365.0,
   "text": "و محل شهود همه حقایق عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 365.0,
   "end": 371.36,
   "text": "اینکه به یاسین، سوره یاسین میگن قلب قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 371.36,
   "end": 375.94,
   "text": "همه حقایق قرآنی که عن نه در سوره یاسین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 375.94,
   "end": 383.2,
   "text": "اینکه به قلب عبارتی قرآن \"وليتلفف\" میگن قلب عبارتی نه فقط یعنی اینکه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 383.2,
   "end": 386.44,
   "text": "مرکز قرآن قرار گرفته بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 386.44,
   "end": 390.86,
   "text": "یک لفظی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 390.86,
   "end": 395.94,
   "text": "در پس این لفظ، در پشت این ظاهر، در باطن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 395.94,
   "end": 400.82,
   "text": "\"وليتلفف\" حقایق تجمع پیدا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 400.82,
   "end": 404.36,
   "text": "لذا قلب شده .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 404.36,
   "end": 408.68,
   "text": "قلب محل جمع است، روح محل جمع الجمع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 408.68,
   "end": 413.28,
   "text": "روح، تجمیع همه حقایق در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 413.28,
   "end": 416.36,
   "text": "اون وجود منبسط ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 416.36,
   "end": 419.04,
   "text": "که همه حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 419.04,
   "end": 425.32,
   "text": "مندمجن، مندرجن، متنقشن در روح ما که جنسش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 425.32,
   "end": 430.76,
   "text": "مرتبه احدیت نظام هستی است که والا‌ترین مرتبه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 430.76,
   "end": 438.22,
   "text": "و قلب، قلب ما از مرتبه واحدیت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 438.22,
   "end": 440.8,
   "text": "شروع کثرات است. قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 440.8,
   "end": 445.54,
   "text": "می‌شود محل جمع، روح می‌شود محل جمع الجمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 445.54,
   "end": 448.38,
   "text": "قلب میشه محل شهود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 448.38,
   "end": 455.86,
   "text": "دقت بفرمایید که اگر کسی هم مباحث پیش این رو نبوده، این سیر رو طی نکرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 455.86,
   "end": 458.64,
   "text": "یه چیزی امشب متوجه بشه امروز ظهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 458.64,
   "end": 463.04,
   "text": "اونم اینکه یعنی چی قلب محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 463.04,
   "end": 466.8,
   "text": "شهوده؟ یعنی هرچی شما درک کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 466.8,
   "end": 473.14,
   "text": "به قولی با چشم دلت ببینی تو مرحله قلبت اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 473.14,
   "end": 476.88,
   "text": "شما امروز اینجا در خیمه سید و شهدا نشستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 476.88,
   "end": 482.56,
   "text": "الان تا من هنوز نه روضه خوندم تا السلام علیک یا مظلوم گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 482.56,
   "end": 485.08,
   "text": "گریان شدی، تنت لرزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 485.08,
   "end": 487.66,
   "text": "چی شد که تنت لرزید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 487.66,
   "end": 491.2,
   "text": "چی دیدی که گریان شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 491.2,
   "end": 497.33,
   "text": "من نه نوایی گفتم که بگی اون نوا و اون نغمه دلت رو عوض کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 497.33,
   "end": 502.94,
   "text": "نه روضه خوندم و رفتم تو گودی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 502.94,
   "end": 505.72,
   "text": "یا روضه ای خوندم که خاطرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 505.72,
   "end": 508.66,
   "text": "کربلایی-- اصلاً هی-- اینا زنده بشه هیچ کدوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 508.66,
   "end": 511.16,
   "text": "یه اسم ارباب رو بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 511.16,
   "end": 513.42,
   "text": "چی شد که منقلب شدی؟ این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 513.42,
   "end": 516.7,
   "text": "منقلب شدن که از انقلابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 516.7,
   "end": 520.96,
   "text": "جاش تو قلبه. دگرگونیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 520.96,
   "end": 525.26,
   "text": "الان یک دگرگونی عجیبی در عالم امکانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 525.26,
   "end": 528.52,
   "text": "رخ داده. چرا؟ بفرمایید چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 528.52,
   "end": 531.34,
   "text": "چرا در عالم قهراً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 531.34,
   "end": 534.3,
   "text": "قطعاً، یقیناً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 534.3,
   "end": 536.38,
   "text": "با براهین عقلی حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 536.38,
   "end": 539.22,
   "text": "انقلابی در عالم به پا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 539.22,
   "end": 541.76,
   "text": "ما وقتی بحث عشق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 541.76,
   "end": 546.38,
   "text": "این‌ها رو می‌کنیم، با تو خونه من امروز صبح داشتم فکر می‌کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 546.38,
   "end": 549.32,
   "text": "الان این وضعیتی که در ایران اسلامی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 549.32,
   "end": 552.92,
   "text": "هیچکس قرار نداره، بی‌قراره، مضطربن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 552.92,
   "end": 556.9,
   "text": "اضطراب دایم، حالت عجیبی دارن همه، به هم ریختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 556.9,
   "end": 559.92,
   "text": "اگر دیروز خوشتیپ می‌کردیم می‌اومدیم هیئت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 559.92,
   "end": 564.32,
   "text": "عطر و نمی‌دونم موهامونو امروز همینطوری ژولیده پولیده، درب و داغون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 564.32,
   "end": 567.6,
   "text": "اصلاً حوصله کسی نداشت به خودش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 567.6,
   "end": 574.84,
   "text": "چرا؟ قهراً با این، با توجه به اینچه که الان گفتیم من داشتم فکر می‌کردم خب ایران اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 574.84,
   "end": 582.06,
   "text": "آیا جاهای دیگه که آدم‌های بی‌خدا، بی‌حسین زندگی می‌کنند همین‌چنین هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 582.06,
   "end": 586.1,
   "text": "با براهین قطعیه که این چند شب گفتیم باید بگید بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 586.1,
   "end": 588.52,
   "text": "همه عالم دگرگونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 588.52,
   "end": 591.28,
   "text": "چرا؟ چون قلب عالم گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 591.28,
   "end": 594.24,
   "text": "قلب، قلب مهدی دگرگونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 594.24,
   "end": 596.84,
   "text": "قلب مهدی که به هم می‌ریزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 596.84,
   "end": 602.5,
   "text": "عالم دگرگون میشه .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 602.5,
   "end": 607.32,
   "text": "قلب است. همه حقایق عالم در او تجمع کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 607.32,
   "end": 613.42,
   "text": "لذا همه ال- عوالم هستی و همه اسماء که جمع‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 613.42,
   "end": 615.78,
   "text": "و آقا در مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 615.78,
   "end": 621.0,
   "text": "قلب همه این‌ها رو شاهده و به شهود این‌ها نشسته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 621.0,
   "end": 627.41,
   "text": "نگاه می‌کنه به عالم. تو رو هم آقا با قلبش می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 627.41,
   "end": 629.46,
   "text": "لذا می‌بینی که همه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 629.46,
   "end": 632.0,
   "text": "همه چی یه طوریه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 632.0,
   "end": 634.12,
   "text": "که امام صادق فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 634.12,
   "end": 637.12,
   "text": "روز عاشورا سنگ می‌جوشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 637.12,
   "end": 641.68,
   "text": "سنگ می‌لرزه، ماهی گریه می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 641.68,
   "end": 644.6,
   "text": "وحوش به هم ریختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 644.6,
   "end": 649.46,
   "text": "چه خبره آخه؟ آخه ماهی که تو آبه چجوری گریه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 649.46,
   "end": 651.46,
   "text": "سنگ چجوری گریه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 651.46,
   "end": 654.5,
   "text": "ما نمی‌فهمیم. خودتو فقط بپا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 654.5,
   "end": 657.78,
   "text": "کاری به سنگ و ماهی و وحوش نداشته باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 657.78,
   "end": 661.72,
   "text": "خودت ببین قلبت دگرگونه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 661.72,
   "end": 667.02,
   "text": "هرچی این قلب دگرگونه مورد نگاه بیشتر مهدی قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 667.02,
   "end": 671.78,
   "text": "اونم با قلبش آقا نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 671.78,
   "end": 677.1,
   "text": "الحمد لله که یازده شب اومدیم نفوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 677.1,
   "end": 679.32,
   "text": "تطهیر پیدا کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 679.32,
   "end": 682.74,
   "text": "مطهر شدن با ذکر حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 682.74,
   "end": 687.44,
   "text": "حالا امروز روزیست که اومدی خودتو برسونی و دیگه هم برنگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 687.44,
   "end": 689.48,
   "text": "در خطبه ای که حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 689.48,
   "end": 693.94,
   "text": "تشریف می‌بردند می‌خواستن تازه بیان به سمت کربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 693.94,
   "end": 702.12,
   "text": "ریل‌گذاری کردن، خط‌کشی کردن که چه کسانی پشت سر من و دنبال من و به معیت من باید بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 702.12,
   "end": 706.88,
   "text": "ببینید فرمود ابو عبدالله فرمود \"من کان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 706.88,
   "end": 712.88,
   "text": "باذلا فينا مهجته\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 712.88,
   "end": 715.54,
   "text": "هرکس که اهل بذل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 715.54,
   "end": 718.78,
   "text": "اونم فی سبيلنا نه، فينا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 718.78,
   "end": 724.94,
   "text": "یه شب تو زمین چمن پارک فدک که بودیم اینو بازش کردیم و یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 724.94,
   "end": 730.39,
   "text": "ابو عبدالله میگه در ما یعنی هیچ حجابی بین خودش و ما نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 730.39,
   "end": 734.21,
   "text": "نیومده باشه تو راه ما که یه چیزی گیرش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 734.21,
   "end": 737.65,
   "text": "فینا. اومده خودش رو بذل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 737.65,
   "end": 741.67,
   "text": "چیه خودش رو بذل کنه؟ جانش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 741.67,
   "end": 745.09,
   "text": "مالش رو، بچه هاشو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 745.09,
   "end": 747.27,
   "text": "چی رو؟ فرهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 747.27,
   "end": 749.57,
   "text": "مهجته. تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 749.57,
   "end": 751.75,
   "text": "سجده عاشورا میگه الذين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 751.75,
   "end": 753.73,
   "text": "بذلوا بذلوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 753.73,
   "end": 755.39,
   "text": "اینجا باذلن اونجا بذلوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 755.39,
   "end": 758.63,
   "text": "مهجهم دونک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 758.63,
   "end": 761.27,
   "text": "مهجهم بذل کردن مهجه‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 761.27,
   "end": 767.15,
   "text": "مهجه چیه؟ من كان باذلا فینا مهجته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 767.15,
   "end": 769.75,
   "text": "مهجه آخرین قطره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 769.75,
   "end": 775.31,
   "text": "خونیه که وقتی گوسفند رو ذبح میکنن همه خونش رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 775.31,
   "end": 783.97,
   "text": "تموم شد، جون داد، پوستشو کندن، اون آخرین قطره خونی که تو قلب گوسفند مونده میگن عرب بهش میگه مهجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 783.97,
   "end": 786.81,
   "text": "میگه کسی که آخرین قطره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 786.81,
   "end": 790.65,
   "text": "خونش رو حاضره به من بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 790.65,
   "end": 794.21,
   "text": "نه برای مقامات در راه من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 794.21,
   "end": 799.13,
   "text": "درجات در راه من، طمع به بهشته در راه من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 799.13,
   "end": 800.91,
   "text": "ترس از جهنمه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 800.91,
   "end": 807.49,
   "text": "فینا. یعنی هرکس اومده بشه حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 807.49,
   "end": 811.37,
   "text": "چنین کسی دار و ندارش رو اومده بریزه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 811.37,
   "end": 815.47,
   "text": "مگر خودش تو کربلا دامن ن تکوند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 815.47,
   "end": 817.53,
   "text": "تو کربلا تو گودی قتلگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 817.53,
   "end": 824.65,
   "text": "یعنی تمام رفیق تماممم این دویست تا مقتل رو که یه شب عرض کردم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 824.65,
   "end": 831.17,
   "text": "جمع کنی رو تو یه جمله عارفی گفته فرمود ابی عبدالله تو گودی قتلگاه دامن تکوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 831.17,
   "end": 838.23,
   "text": "تموم کرد. هرچی داشت و نداشت داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 838.23,
   "end": 843.45,
   "text": "این یعنی من كان باذلا فینا مهجته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 843.45,
   "end": 846.63,
   "text": "حالا فلیرحل معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 846.63,
   "end": 851.41,
   "text": "عجب! حالا میخواد به معیت ما برسه قصد رحل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 851.41,
   "end": 856.39,
   "text": "راهل باید باشه. راهل فرقش با مسافر قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 856.39,
   "end": 859.11,
   "text": "مسافر میره که برگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 859.11,
   "end": 862.71,
   "text": "مرخصی میگیره، کاراشو رد و فتح میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 862.71,
   "end": 864.95,
   "text": "برنامه ریزی میکنه برای روز برگشتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 864.95,
   "end": 867.87,
   "text": "قصد توقف در مقصد نمیکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 867.87,
   "end": 871.95,
   "text": "اما راهل چیه؟ و ان الراحل قريب المسافة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 871.95,
   "end": 875.85,
   "text": "امام سجاد تو مناجاتش میگه راهل راهش به تو نزدیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 875.85,
   "end": 881.11,
   "text": "راهل یعنی کسی که قصد کرده بره دیگه برنگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 881.11,
   "end": 883.97,
   "text": "حالا اباعبدالله ببینید چگونه ریل‌گذاری کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 883.97,
   "end": 885.99,
   "text": "این تازه یه جمله از خطبه حضرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 885.99,
   "end": 891.07,
   "text": "می فرماید کسی که اومده دار و ندارش رو به حسین بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 891.07,
   "end": 894.27,
   "text": "یعنی بشه خود من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 894.27,
   "end": 896.65,
   "text": "معیت با من پیدا کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 896.65,
   "end": 901.31,
   "text": "قصد کنه که اومده دیگه برنگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 901.31,
   "end": 905.85,
   "text": "اگر امروز با این نیت اومدی هیئت درست اومدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 905.85,
   "end": 911.17,
   "text": "اگر غیر از این بوده سریع تجدید نظر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 911.17,
   "end": 916.89,
   "text": "یعنی اون نگاه آقا، اون نگاه خاص از قلب آقا که تو رو نگاه میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 916.89,
   "end": 923.35,
   "text": "اون نگاه خاص وقتی بهت میفته که تو این نیتو داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 923.35,
   "end": 926.25,
   "text": "حالا زشت نیست امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 926.25,
   "end": 930.17,
   "text": "مسیحی اومد با آقا ملحق شد برنگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 930.17,
   "end": 933.73,
   "text": "وهب. عثمانی مذهب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 933.73,
   "end": 935.81,
   "text": "ببخشه ارباب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 935.81,
   "end": 940.37,
   "text": "ببخشه زهیر که میگم اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 940.37,
   "end": 947.87,
   "text": "عس-عثمانی یکی اومد به من گفت عثمانی مسلک به گفتم نه مسلک نه مذهب یعنی مذهبش شیعه نبوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 947.87,
   "end": 952.95,
   "text": "حتی العیاذ بالله لعن میکرد بنا به بعضی روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 952.95,
   "end": 959.99,
   "text": "مولا رو بعضیا اینو میگن حالا ما کاری به اون راهش به کج رفته بود هرچی که بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 959.99,
   "end": 963.05,
   "text": "اما اون هم اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 963.05,
   "end": 967.71,
   "text": "ملحق شد به حسین و آقا خریدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 967.71,
   "end": 970.05,
   "text": "خب رفت دیگه هم برنگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 970.05,
   "end": 976.59,
   "text": "خیلی زشته امروز تموم شه ما جا بمونیم بچه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 976.59,
   "end": 979.37,
   "text": "یعنی تحت اون نگاه خاص قرار نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 979.37,
   "end": 986.87,
   "text": "حالا این، این مرتبه از کتاب که انسان کامل صاحب مرتبه، مرتبه قلب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 986.87,
   "end": 990.59,
   "text": "رو به یک وجه دیگری براتون بازش کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 990.59,
   "end": 995.41,
   "text": "که اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 995.41,
   "end": 1000.67,
   "text": "آقامون امیرالمؤمنین علیه الصلاة والسلام در نهج فرمودند ان هذه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1000.67,
   "end": 1005.55,
   "text": "قلوب أوعية",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1005.55,
   "end": 1008.99,
   "text": "فخيرها أوعاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1008.99,
   "end": 1013.67,
   "text": "یعنی این قلب ها ظرف‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1013.67,
   "end": 1015.77,
   "text": "این قلب ها مثل ظرف‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1015.77,
   "end": 1019.21,
   "text": "الان تو اومدی گدایی کنی از آقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1019.21,
   "end": 1023.79,
   "text": "هرچی آقا بهت بده تو ظرف قلب، قلبت میریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1023.79,
   "end": 1027.47,
   "text": "هرچی قلب پاک تره آقا بیشتر پرش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1027.47,
   "end": 1032.97,
   "text": "این یک وجه. هرچی سعه وجودی بیشتر آقا بیشتر بهت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1032.97,
   "end": 1037.59,
   "text": "بیشتر اجازه میده نزدیک به گودی بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1037.59,
   "end": 1040.77,
   "text": "عزیز دلم یک سال باید جون بکنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1040.77,
   "end": 1045.35,
   "text": "تا ظهر عاشورا یه چیزکی درک کنی، یه چیزی بفهمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1045.35,
   "end": 1049.15,
   "text": "یه دلی ازت بلرزه، سنگ نشی، خشک نشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1049.15,
   "end": 1054.23,
   "text": "یه سال باید نزدیک حجت خدا بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1054.23,
   "end": 1057.19,
   "text": "امام مجتبی صلوات الله علیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1057.19,
   "end": 1061.37,
   "text": "اصلاً اینکه تمام قرآن که علم ذاتی حضرت حق است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1061.37,
   "end": 1065.01,
   "text": "که إنک لَتلقى القرآن من لدن حكيم عليم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1065.01,
   "end": 1068.67,
   "text": "بر قلب مقدس نبی اکرم نازل شده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1068.67,
   "end": 1072.51,
   "text": "چون أوسع قلوب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1072.51,
   "end": 1079.41,
   "text": "این دل وسیع‌ترین دل‌ها بود قرآن بهش نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1079.41,
   "end": 1082.17,
   "text": "حالا دل من و شما چقدر وسعت داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1082.17,
   "end": 1086.91,
   "text": "همون مقدار اجازه میدن تو سرزمین کربلا امروز حیران باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1086.91,
   "end": 1093.5,
   "text": "تا کجا اجازه داری بری؟ یه شب گفتم شب جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1093.5,
   "end": 1102.68,
   "text": "که گفتم ارواح نه فقط انبیا و اولیا بلکه مؤمنین هم شبای جمعه میرن کربلا و به میزان این که چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1102.68,
   "end": 1106.68,
   "text": "سعه وجودی داشتن اجازه دارن نزدیک گودی بشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1106.68,
   "end": 1110.42,
   "text": "که اونجا اصل روضه است و مادر اونجا روضه میخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1110.42,
   "end": 1113.72,
   "text": "چه میزان نزدیک میشن؟ به میزان سعه وجودیشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1113.72,
   "end": 1116.58,
   "text": "چه میزان درک میکنن روضه خوانی حضرت زهرا رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1116.58,
   "end": 1119.74,
   "text": "به میزان قلبشون. چقدر سعه داره قلبشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1119.74,
   "end": 1122.04,
   "text": "قلب خیلی چیز مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1122.04,
   "end": 1126.3,
   "text": "اصلاً امام عصر همه عالم رو با قلبش به شهود مینشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1126.3,
   "end": 1131.9,
   "text": "اون محل جمع همه اسماء دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1131.9,
   "end": 1135.2,
   "text": "اجازه بدید که نکته خیلی شیرین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1135.2,
   "end": 1140.2,
   "text": "علمی و عرفانی بسیار به دردبخوری رو تقدیم کنم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1140.2,
   "end": 1145.44,
   "text": "همونطور که در عرب به مردمک چشم میگن انسان العين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1145.44,
   "end": 1147.58,
   "text": "این انسان العين یعنی مردمک چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1147.58,
   "end": 1151.54,
   "text": "یعنی هرچه که میبینی با مردمک چشمت میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1151.54,
   "end": 1156.58,
   "text": "چشم میبینه ظاهراً اما چشم از طریق مردمک میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1156.58,
   "end": 1159.18,
   "text": "بهش میگن انسان العين به مردمک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1159.18,
   "end": 1165.18,
   "text": "در سـ-- در قرآن هم یه سوره داریم که ملا صدرا علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1165.18,
   "end": 1169.06,
   "text": "در شرح اصول کافی‌ش حدود بیست اسم بر این سوره میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1169.06,
   "end": 1172.18,
   "text": "یکیش سوره نسبته، توحیده، اخلاصه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1172.18,
   "end": 1176.14,
   "text": "نوره، نور. یکیشم انسان العينه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1176.14,
   "end": 1178.9,
   "text": "مردمک چشم قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1178.9,
   "end": 1182.56,
   "text": "کدوم سوره؟ سوره توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1182.56,
   "end": 1184.4,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1184.4,
   "end": 1187.12,
   "text": "قل هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1187.12,
   "end": 1191.44,
   "text": "که عجیبه امروز هزار بار این سوره وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1191.44,
   "end": 1196.26,
   "text": "امروز. خیلی سوره عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1196.26,
   "end": 1198.96,
   "text": "حالا چرا امروز وارد شده؟ خودش یه منبر می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1198.96,
   "end": 1203.02,
   "text": "چرا امروز هزار تا قل هو الله... این مردمک چشم قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1203.02,
   "end": 1205.44,
   "text": "همینطور به انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1205.44,
   "end": 1211.16,
   "text": "که این قلب اوسع رو داره و محل جمع است و همه حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1211.16,
   "end": 1214.4,
   "text": "و همه اشیا و همه اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1214.4,
   "end": 1217.86,
   "text": "و همه آنچه حق است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1217.86,
   "end": 1220.86,
   "text": "جمعاً در قلب او،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1220.86,
   "end": 1224.44,
   "text": "به او هم میگویند انسان العين عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1224.44,
   "end": 1226.54,
   "text": "یعنی مردمک چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1226.54,
   "end": 1233.26,
   "text": "یعنی چی؟ یعنی حضرت حق که میبیند، خیلی حرف سنگینه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1233.26,
   "end": 1235.7,
   "text": "حضرت حق سبحانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1235.7,
   "end": 1239.64,
   "text": "و تعالی عما یصفون که میبیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1239.64,
   "end": 1244.28,
   "text": "از مردمک چشم مهدی میبیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1244.28,
   "end": 1248.16,
   "text": "این انسان العينه. خدا میخواد تو رو نگاه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 281,
   "start": 1248.16,
   "end": 1252.9,
   "text": "با چی نگاه میکنه؟ با مردمک چشم مهدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 282,
   "start": 1252.9,
   "end": 1254.46,
   "text": "یعنی با مهدی اینطوری بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 283,
   "start": 1254.46,
   "end": 1257.2,
   "text": "او خودش چی؟ او خودش انسان العينه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 284,
   "start": 1257.2,
   "end": 1262.3,
   "text": "مردمک چشم عالمه. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 285,
   "start": 1262.3,
   "end": 1266.68,
   "text": "یعنی خدا اگر میخواد نگاه کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 286,
   "start": 1266.68,
   "end": 1270.64,
   "text": "تو رو مهدی فاطمه نگاه میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 287,
   "start": 1270.64,
   "end": 1272.66,
   "text": "اینه که میگن چه-چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 288,
   "start": 1272.66,
   "end": 1275.86,
   "text": "تموم شد آقا تموم شد. سؤال همه رو جواب دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 289,
   "start": 1275.86,
   "end": 1280.28,
   "text": "چگونه است که بدترین‌ها یه دفعه عوض شدن اومدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 290,
   "start": 1280.28,
   "end": 1283.62,
   "text": "خب امام حسین نگاشون کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 291,
   "start": 1283.62,
   "end": 1285.34,
   "text": "آقا یعنی چی امام حسین نگاشون کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 292,
   "start": 1285.34,
   "end": 1287.72,
   "text": "یعنی خدا نگاشون کرد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 293,
   "start": 1287.72,
   "end": 1292.16,
   "text": "به این وجهی که الان ما عرض کردیم. حالا بریم کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 294,
   "start": 1292.16,
   "end": 1294.44,
   "text": "الان سؤال‌ها رو جواب دادیم. البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 295,
   "start": 1294.44,
   "end": 1297.54,
   "text": "مثل رساله مطالبی آماده کرده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 296,
   "start": 1297.54,
   "end": 1301.86,
   "text": "خیلی عالی از هزار و یک نکته علامه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 297,
   "start": 1301.86,
   "end": 1305.24,
   "text": "کتاب‌های مثلاً نقد و نقود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 298,
   "start": 1305.24,
   "end": 1313.34,
   "text": "سید حیدر آملی که اطوار وجودی انسان من جمله قلبش رو بررسی میکنه بماند برای یک جلسه دیگه. بریم کربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}