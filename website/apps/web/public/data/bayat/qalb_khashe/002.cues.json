 "chapters": [
  {
   "index": 0,
   "title": "## عدول نیت در قضای نمازهای پیاپی",
   "start": 14.26,
   "end": 69.48
  },
  {
   "index": 1,
   "title": "## قلب خاشع وقت ذکر؛ نماز ذکر اکبر و محک",
   "start": 69.48,
   "end": 156.86
  },
  {
   "index": 2,
   "title": "## انوار نعمانیه؛ نیت حضور و منارهٔ کوفه",
   "start": 156.86,
   "end": 176.88
  },
  {
   "index": 3,
   "title": "## آقای شاهرودی؛ مار بر سجاده و استمرار حضور",
   "start": 176.88,
   "end": 197.06
  },
  {
   "index": 4,
   "title": "## محک نماز در سجده؛ رکوع آمادگی فدا",
   "start": 197.06,
   "end": 476.4
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.82,
   "end": 6.84,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.84,
   "end": 10.24,
   "text": "السلام علیک یا دعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.24,
   "end": 14.26,
   "text": "آیا ص سلامٌ علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.26,
   "end": 17.16,
   "text": "یکی از دیگر جاهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.16,
   "end": 20.8,
   "text": "انسان می‌تونه عدول در نیت کنه و این رو ما نگفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.8,
   "end": 26.24,
   "text": "وقتیه که نمازهایی ازش قضا شده که اینا پشت سر هم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.24,
   "end": 32.54,
   "text": "مثلاً نماز مغرب و عشاش خواب مونده از اول اذان خواب مونده دیگه اصلاً نخونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.54,
   "end": 36.24,
   "text": "دیشب مثلاً نماز مغرب و عشاش با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.24,
   "end": 38.14,
   "text": "فوت شده. بعد میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.14,
   "end": 41.98,
   "text": "قضا بخونه حواسش نیست عشا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.98,
   "end": 47.28,
   "text": "اول می‌خونه. چون این وقتی که نماز پشت سر هم قضا شده باید اداش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.28,
   "end": 50.1,
   "text": "یعنی قضا که بخوای به جا بیاری ادا کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.1,
   "end": 52.26,
   "text": "باید همونطوری پشت سر هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.26,
   "end": 55.22,
   "text": "عشا رو می‌خونه یادش میفته اینجا می‌تونه عدول کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.22,
   "end": 61.14,
   "text": "قبل از اینکه به رکوع رکعت چهارم برسه می‌تونه نیت نماز مغربو برگردونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.14,
   "end": 63.78,
   "text": "و نیت نماز مغرب کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.78,
   "end": 65.8,
   "text": "مغربو اول قضا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.8,
   "end": 69.48,
   "text": "یا حالا هر نمازی که پشت سر هم باشه به این صورت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.48,
   "end": 73.46,
   "text": "در خصوص قلوب ما به قلب خاشع رسیده بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.46,
   "end": 77.38,
   "text": "و عرض کردیم که قلب خاشع وقت ذکر مشخص می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.38,
   "end": 81.56,
   "text": "البته مقدمه رسیدن به خشوع ذکر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.56,
   "end": 84.22,
   "text": "و مانع جدی و اصلی اون غفلت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.22,
   "end": 88.6,
   "text": "اینو دیروز عرض کردیم و مثالی هم زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.6,
   "end": 92.7,
   "text": "یکی از بهترین جاهایی که انسان می‌تونه حد و حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.7,
   "end": 95.84,
   "text": "خشوع قلبیش رو بسنجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.84,
   "end": 103.56,
   "text": "وقت نمازه. به هر حال ما می‌دونیم که ولذكر الله الاكبر این ذکر بزرگ‌تر نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.56,
   "end": 109.04,
   "text": "اینم باز ذکره دیگه. اونجایی که تو قرآن می‌فرماید \"ألم ينل الذين آمنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.04,
   "end": 112.1,
   "text": "أن تخشع قلوبهم لذكر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.1,
   "end": 118.5,
   "text": "بذكر الله\" یعنی همین. اونجایی که می‌فرماید آیا وقت اون نرسیده که اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.5,
   "end": 121.06,
   "text": "قلبشون رو خاشع کنن به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.06,
   "end": 125.5,
   "text": "به ذکر. این نشون میده که قلب با ذکر خاشع می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.5,
   "end": 127.52,
   "text": "با یاد خدا خاشع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.52,
   "end": 131.82,
   "text": "حالا بهترین و بزرگ‌ترین ذکر هم که فرمودن نماز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.82,
   "end": 139.82,
   "text": "وقت نماز می‌تونه انسان مهک بزنه به قول آقای بهجت که تو وضعیت خشوع قلبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.82,
   "end": 142.64,
   "text": "تو چه حالتی‌ست؟ بهترین مهکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.64,
   "end": 145.52,
   "text": "این‌ها خیلی راحت انسان می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.52,
   "end": 148.28,
   "text": "خودش رو مهک بزنه که تو این نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.28,
   "end": 151.54,
   "text": "اگه مثل منه تو الله اکبر رو گفت تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.54,
   "end": 154.08,
   "text": "گم شده‌هاشو پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.08,
   "end": 156.86,
   "text": "یعنی اینکه دیگه این نماز تعطیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.86,
   "end": 163.9,
   "text": "به قول خدا رحمت کنه سید نعمت الله جزایری در کتاب انوار نعمانیه‌ش میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.9,
   "end": 169.5,
   "text": "یه کسی شنیده بود که پیغمبر فرموده اگه کسی دو رکعت نماز بتونه با حضور قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.5,
   "end": 172.74,
   "text": "یعنی اصلاً دلش هیچ جا جز خدا نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.74,
   "end": 176.02,
   "text": "بتونه دو رکعت نماز ب-با حضور قلب بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.02,
   "end": 182.58,
   "text": "اینم زرنگی کنین‌ها. نفهمیده دو رکعت نماز طویل و مثلاً خیلی طول بکشه و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.58,
   "end": 184.76,
   "text": "نه دو رکعت نماز و لو به سرعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.76,
   "end": 189.58,
   "text": "مثلاً عمار یاسر دو رکعت نماز یه روز خوند خیلی تند خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.58,
   "end": 192.58,
   "text": "بهش گفتن عمار از تو بعیده انقدر تند نماز خوندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.58,
   "end": 197.06,
   "text": "گفت می‌خواستم به اون دو رکعت نمازی که پیغمبر فرموده بوده برسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.06,
   "end": 201.44,
   "text": "گفت می‌دونم که شیطان میاد یه کاری بالاخره می‌کنه نماز لکه‌دار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.44,
   "end": 203.54,
   "text": "سریع خوندم که برسم به اون حال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.54,
   "end": 207.82,
   "text": "مثلاً دو رکعت نماز ذخیره داشته باشم با حضور قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.82,
   "end": 212.8,
   "text": "حالا این سید نعمت‌الله میگه که یکی نیت کرد که دو رکعت نماز با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.8,
   "end": 215.9,
   "text": "حضور قلب بخونه. گفت بهترین جا مسجد کوفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.9,
   "end": 220.72,
   "text": "رفت مسجد کوفه و با یه حالی الله اکبر گفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.72,
   "end": 225.84,
   "text": "یه دفعه در بین نماز متوجه شد که مسجد کوفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.84,
   "end": 228.5,
   "text": "مناره نداره. اون قدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.5,
   "end": 233.56,
   "text": "مناره نداره. پیش خودش گفت خب آخه چرا مسجد کوفه مناره نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.56,
   "end": 239.94,
   "text": "فکر-- بالاخره مسجد کوفه است قراره انشاالله دولتسرای امام عصر بشه و نمی‌شه زشته و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.94,
   "end": 244.48,
   "text": "داشت فکر می‌کرد که خب حالا براش مناره بسازیم بخوایم بسازیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.48,
   "end": 249.3,
   "text": "باید بانی گیر بیاریم. خب حالا بانی گیر آوردیم چقدر خشت و گل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.3,
   "end": 252.66,
   "text": "نمی‌دونم این‌ها می‌خواد. خب بعدش بناش کی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.66,
   "end": 254.36,
   "text": "بعد نقشش چجوری باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.36,
   "end": 256.52,
   "text": "دید دارم میگه السلام علیکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.52,
   "end": 259.88,
   "text": "و رحمت الله. دید عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.88,
   "end": 265.24,
   "text": "واقعاً؟ اینطوری نیست که بگیم خب حالا من می‌خوام با حضور قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.24,
   "end": 269.58,
   "text": "اگر انسان اعمالش رو تصفیه کرد و درست کرد، نمازش خود به خود درست می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.58,
   "end": 272.14,
   "text": "آقای بهجت فرمودن بارها عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.14,
   "end": 274.52,
   "text": "اگر می‌خوای نماز بخونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.52,
   "end": 276.88,
   "text": "حواست باشه نماز نخون که حال کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.88,
   "end": 281.34,
   "text": "اصلاً نمی‌شه. نماز بخون مهکت باشه که تا حالا اعمالت چجوری بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.34,
   "end": 287.28,
   "text": "اگه اعمالت صبح تا حالا خوب بوده، نماز ظهر و عصرت اتوماتیک خوب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.28,
   "end": 291.62,
   "text": "آره عزیز دلم. اینطوریه که البته بودن بعضیا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.62,
   "end": 295.42,
   "text": "نماز خیلی خوبی هم داشتن. مرحوم آقای شاهرودی رحمة الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 295.42,
   "end": 300.42,
   "text": "حالا دیروز ما آقا میرزا جواد آقا ملکی رو گفتیم، مرحوم آقای شاهرودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 300.42,
   "end": 302.48,
   "text": "اینا داستان نیست، قصه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.48,
   "end": 305.56,
   "text": "اینا اتفاق افتاده حقیقت داره بغل گوش ما رخ داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.56,
   "end": 309.62,
   "text": "الآنم هستن. خیلی کم هستن کسایی که تو نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.62,
   "end": 314.7,
   "text": "واقعاً اینجا نیستن. البته منم تو نماز اینجا نیستما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.7,
   "end": 318.62,
   "text": ". اما اون کجا این کجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.62,
   "end": 325.6,
   "text": ". مرحوم آقای شاهرودی بازار بزرگ تهر-- مسجد بازار بزرگ تهران که نماز می‌خوند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.6,
   "end": 329.0,
   "text": "استاد اسد امام رحمة الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.0,
   "end": 330.72,
   "text": "خادم اون مسجد نقل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.72,
   "end": 335.4,
   "text": "فرمود که یه روز-- اصلاً شاهد بوده این خادم میگفت من اونجا بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.4,
   "end": 339.98,
   "text": "وسط نماز یه پنجره کوچولویی بالای محراب مسجد بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.98,
   "end": 343.26,
   "text": "آقای شاهرودی مشغول نماز ظهر و عصر بازار بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.26,
   "end": 350.76,
   "text": "این پنجره باز بوده. یه مار خیلی بزرگ حالا از کجا اومده بوده الله اعلم از اونجا پرت می‌شه پایین جلوی سجاده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.76,
   "end": 356.84,
   "text": "سجاده آقای شاهرودی. خدایی اگه من سوسک از بغلم رد شه وقت نماز دونت می‌پرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 356.84,
   "end": 360.28,
   "text": "نما-- وقت نماز مار به چه بزرگی میفته رو سجاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.28,
   "end": 362.84,
   "text": "بعد می‌گفت من دیدم که مردم فرار کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.84,
   "end": 366.24,
   "text": "مردمی که اقتدا کرده بودن با آقای شاهرودی فرار کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.24,
   "end": 369.38,
   "text": "رفتن. ولی آقای شاهرودی تکون نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 369.38,
   "end": 372.62,
   "text": "من همینطوری نشس-- وایستاده بودم حالا تکبیر می‌گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.62,
   "end": 375.66,
   "text": "ببینم چیکار می‌کنه این مرد. اصلاً متوجه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.66,
   "end": 378.84,
   "text": "اصلاً انگار نه انگار ماری چیزی دیده ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 378.84,
   "end": 382.12,
   "text": "عین همون حال خوشی که داشت نمازش تموم می‌شده الان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.12,
   "end": 389.02,
   "text": "البته نمازشو ادامه داد. بعد جالب اینه که می‌گفت هنوز دیگه سلام نماز رو هم نداده بود ماره راهشو کج کرد و رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.02,
   "end": 391.92,
   "text": "این نمازش هم تموم شد. اصلاً متوجه هیچی نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 391.92,
   "end": 394.5,
   "text": "ماری اومده رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.5,
   "end": 399.64,
   "text": "هستن این‌ها اینطوری. ولی خب با مراقبه دیگه، مراقب کارهاشونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.64,
   "end": 401.64,
   "text": "مواظب کارهاش... حالا س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.64,
   "end": 403.38,
   "text": "نماز پس مهک اعماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 403.38,
   "end": 406.7,
   "text": "ذکر الله الاکبره برای خشوع قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.7,
   "end": 408.86,
   "text": "قلب خاشع رو ما داریم می‌گیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 408.86,
   "end": 412.92,
   "text": "خود ن-نماز رو چجوری می‌شه مهک زد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 412.92,
   "end": 415.62,
   "text": "نماز مهک اعماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 415.62,
   "end": 417.6,
   "text": "مهک نماز کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 417.6,
   "end": 420.36,
   "text": "بزرگان فرمودن در-- اینا اسراره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.36,
   "end": 422.82,
   "text": "فرمودن در سجده نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.82,
   "end": 425.34,
   "text": "سجده نماز مهک نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.34,
   "end": 427.86,
   "text": "اگه تو سجده حال خوبی داشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 427.86,
   "end": 431.58,
   "text": "قلبت خاشع بود، متوجه بودی در برابر چه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 431.58,
   "end": 435.24,
   "text": "سرت رو روی خاک گذاشتی، اون موقع معلومه که نمازت درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 435.24,
   "end": 442.12,
   "text": "وقتی رکوع میری دیدی می‌خوان این داعشیای ملعون می‌خواستن گردن بزنن طرفو حالت رکوع می‌گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 442.12,
   "end": 447.16,
   "text": "بزرگان گفتن تو حالت رکوع یعنی آماده باش که سرت رو در راه خدا می‌خوای بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.16,
   "end": 450.78,
   "text": "تو این حالت آماده باشی. جان بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.78,
   "end": 454.3,
   "text": "وقت در حالت سجده دیگه خاک میشی یعنی هیچ میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.3,
   "end": 456.8,
   "text": "اصلاً میگی چیزی ندارم من تقدیم تو کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 456.8,
   "end": 458.9,
   "text": "هیچی نیستم. همه چی تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.9,
   "end": 462.92,
   "text": "فنای مطلبه. انشاالله که عاقبت from الخط بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.92,
   "end": 465.42,
   "text": "به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 465.42,
   "end": 468.86,
   "text": "اللهم صل علی- اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 468.86,
   "end": 471.34,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 471.34,
   "end": 476.4,
   "text": "محمد و عجل فرجهم. اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}