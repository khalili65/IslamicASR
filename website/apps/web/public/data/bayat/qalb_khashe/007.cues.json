 "chapters": [
  {
   "index": 0,
   "title": "## جمعِ دو نمازِ مستحب در یک دو رکعت",
   "start": 10.8,
   "end": 31.1
  },
  {
   "index": 1,
   "title": "## اهمیتِ نکاتِ قلوب در زندگیِ روزمره",
   "start": 31.1,
   "end": 115.54
  },
  {
   "index": 2,
   "title": "## حدیث قدسی؛ چهار نشانهٔ هم‌زمان",
   "start": 115.54,
   "end": 136.48
  },
  {
   "index": 3,
   "title": "آن چهار اتفاق چنین است:",
   "start": 136.48,
   "end": 174.5
  },
  {
   "index": 4,
   "title": "## زبان؛ مارِ افعی و صد و هشتاد گناه",
   "start": 174.5,
   "end": 419.06
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.74,
   "end": 3.78,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.78,
   "end": 8.08,
   "text": "السلام علیک یا داعی الله و ربانی یا آیاسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.08,
   "end": 10.8,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.8,
   "end": 15.72,
   "text": "از رهبر عزیزمون عالم به فرداش استفتاء شده که آیا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.72,
   "end": 18.64,
   "text": "مثلا نماز غفیله رو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.64,
   "end": 21.42,
   "text": "نافله مغرب با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.42,
   "end": 23.62,
   "text": "قاطی کردی یه دو رکعتی خوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.62,
   "end": 27.38,
   "text": "بدون نیت؟ چون بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.38,
   "end": 30.3,
   "text": "علما بعضی از مراجع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.3,
   "end": 36.1,
   "text": "ااا اجازه دادن که دو تا نماز مستحبی رو تو یه دو رکعت جمع کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.1,
   "end": 40.22,
   "text": "مثلا میری نماز-- مثلا میری زیارت امام رضا علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.22,
   "end": 47.16,
   "text": "نماز زیارت رو دو رکعت نماز والدین می‌خونی هم زیارت هم وال-- بعضی از مراجع اجازه دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.16,
   "end": 51.0,
   "text": "حالا چون اون حکم رو من خودم دیدم یه ذره برام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.0,
   "end": 58.46,
   "text": "جوری جواب استفتاء جوری بود که خودم شک کردم باز دارم میگ-- زنگ زدم دفتر آقا برای اطمینان، ایشون اجازه ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.46,
   "end": 60.76,
   "text": "آقا فرمودن نه مثلا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.76,
   "end": 67.96,
   "text": "دو رکعت نماز غفیله رو که می‌خونی غفیله‌ست دیگه جای نافله مغرب رو نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.96,
   "end": 71.74,
   "text": "یا هر طور دیگه اینکه مثلا نماز زیارت رو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.74,
   "end": 76.52,
   "text": "مثلا والدین یکی کنی. نه حضرت اجازه ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.52,
   "end": 80.62,
   "text": "حالا شما اگر مرجع‌تون کسی دیگه است باید بپرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.62,
   "end": 83.92,
   "text": "خب یه نکته دیگه خیلی مهم، من خیلی نمی‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.92,
   "end": 92.8,
   "text": "بحث قلوب طول بکشه اما چه کنم وقتی بعضی از نکاتش دست پیدا می‌کنم و می‌بینم بسیار مهمه و مهم-- کلیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.8,
   "end": 96.84,
   "text": "به قول بعضیا کاربردیه تو زندگی‌مون حیفم میاد اینا رو نگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.84,
   "end": 99.18,
   "text": "به هر حال کسایی که دارن گوش میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.18,
   "end": 102.2,
   "text": "اینا خیلی شاید به دردشون بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.2,
   "end": 107.76,
   "text": "بعضی از این فایل‌هایی که تو مرام گذاشتن من دیدم تا هشتاد هزار نفر آدم این رو دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.76,
   "end": 114.44,
   "text": "خب چقدر م-- خوبه که این‌ها بالاخره یه دونه از اینا اگر تو زندگی‌شون به دردشون خورده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.44,
   "end": 120.28,
   "text": "خوبه دیگه. یکی از نکات خیلی مهم در قالب یک حدیث قدسی بهتون بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.28,
   "end": 124.82,
   "text": "که این حدیث قدسی عجیبیه و چند روز فکر منو مشغول کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.82,
   "end": 128.0,
   "text": "خدای مننان فکر می‌کنم در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.0,
   "end": 133.66,
   "text": "مجموعه احادیث قدسی شیخ صدوق آملی باشه که اصلش احادیث القدس است یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.66,
   "end": 140.92,
   "text": "جواهر الثنیه. خدای مننان به حضرت موسی علیه النبيین و آله و علیه السلام فرمود که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.92,
   "end": 144.76,
   "text": "چهار تا اتفاق با هم افتاد، این با همش مهمه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.76,
   "end": 146.38,
   "text": "جدا، جدا، اون بحث دیگه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.38,
   "end": 150.24,
   "text": "اگر چهار تا اتفاق دیدی برات افتاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.24,
   "end": 154.14,
   "text": "یه پیامدی داشته که خدا می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.14,
   "end": 157.86,
   "text": "یه دلیل اصلی داشته که خدا می‌فرم- اون چهار اتفاق رو اول بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.86,
   "end": 160.46,
   "text": "اول اینکه دلت سخت شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.46,
   "end": 162.92,
   "text": "یعنی از اون حالت خشوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.92,
   "end": 167.98,
   "text": "خارج شدی. یعنی خشوع قلب ما بحث قلب خاشع رو داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.98,
   "end": 173.92,
   "text": "از حالت قلب خاشع خارج شدی و دلت سنگ شد، حالت قبض پیدا کرد دلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.92,
   "end": 176.42,
   "text": "خب؟ این یک. اینا باید با هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.42,
   "end": 178.44,
   "text": "دو، بدنت مریض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.44,
   "end": 182.92,
   "text": "دچار مریضی شدی که نمی‌دونی چی شده از کجا این مریضی اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.92,
   "end": 187.36,
   "text": "سه، نقصان مالی پیدا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.36,
   "end": 190.14,
   "text": "چهار، مانعی برای رزقت ایجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.14,
   "end": 192.22,
   "text": "حالا این رزق همه چی می‌تونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.22,
   "end": 194.92,
   "text": "هر چیزی که به ما می‌رسه رزق ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.92,
   "end": 199.22,
   "text": "ولو شما حتی مثلا با یکی از اولیای خدا، یکی از اهل ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.22,
   "end": 201.48,
   "text": "وعده ملاقات داری میری نمی‌بینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.48,
   "end": 206.06,
   "text": "اینم مانع رزق شده. رزقتو دیدن یکی از اولیا خدا بوده منع ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.06,
   "end": 209.16,
   "text": "این چهار تا وقتی با هم اتفاق افتاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.16,
   "end": 212.74,
   "text": "خدا به پیغمبرش فرمود قطعا بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.74,
   "end": 215.7,
   "text": "حرفی رو زدی که به تو مربوط نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.7,
   "end": 218.56,
   "text": "عجب! خیلی نکته عجیبیه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 218.56,
   "end": 221.26,
   "text": "تاثیر حرف بیجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.26,
   "end": 223.5,
   "text": "در از بین رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.5,
   "end": 226.54,
   "text": "خشوع قلب، مریضی جسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.54,
   "end": 229.44,
   "text": "نقصان مالی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.44,
   "end": 231.48,
   "text": "منع روزی، منع رزق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.48,
   "end": 237.14,
   "text": "این حرف کلمه‌ای که از زبان جاری میشه، از زبان جاری میشه از دهان خارج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.14,
   "end": 240.18,
   "text": "چقدر تاثیرگذاره و ما بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.18,
   "end": 247.6,
   "text": "به قول یکی از بزرگان می‌فرمود: چه بسا به جهت یک کلمه حرف قیامت صد سال انسان رو نگه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.6,
   "end": 251.18,
   "text": "یه کلمه حرف زدی فتنه ایجاد کرد ریخت به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.18,
   "end": 256.34,
   "text": "مثلا حضرت یوسف فکر می‌کنید چرا هفت سال تو زندان بیشتر موند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.34,
   "end": 258.88,
   "text": "قرار بود یه سال بمونه آزاد شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.88,
   "end": 261.16,
   "text": "مقدر الهی اینطوری بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.16,
   "end": 266.72,
   "text": "اما همه می‌دونید تو سریال‌هاشم اومده بسیاری از مفسرین هم اینو پذیرفتن بعضیا البته قبول نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.72,
   "end": 271.02,
   "text": "حالا به هر حال اگر درست بوده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.02,
   "end": 274.34,
   "text": "علت اصلیش زبان حضرت یوسف بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.34,
   "end": 281.44,
   "text": "یه وقتی به لسان خودش حرکت داد و حرفی رو زد که نب-- خدا توقع نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.44,
   "end": 285.14,
   "text": "با اون زندانی که داشت آزاد میشد گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.14,
   "end": 289.22,
   "text": "حکایت منو برای عزیز مصر بگو، برای پادشاه بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.22,
   "end": 291.6,
   "text": "و بگو که من بی‌گناه در زندانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.6,
   "end": 296.42,
   "text": "بعد به خ-- تازه برگشت و توبه کرد و گریه و زاری در درگاه خدا که خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.42,
   "end": 299.22,
   "text": "عجبش تا من تو رو دارم چرا به دیگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 299.22,
   "end": 304.44,
   "text": "رو انداختم؟ همین، یه کلمه‌ای که بر لسانش جاری شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.44,
   "end": 307.76,
   "text": "اشتباه بود، خدا ازش توقع نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.76,
   "end": 310.62,
   "text": "این لسان می‌خوام عرض کنم خدمتتون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.62,
   "end": 314.4,
   "text": "خیلی از موقع‌ها دلیل خروج ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.4,
   "end": 317.72,
   "text": "از حالت خشیت قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.72,
   "end": 320.44,
   "text": "این لسانه، این زبانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 320.44,
   "end": 322.2,
   "text": "چی بگم، چی بهش بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 322.2,
   "end": 326.72,
   "text": "این زبانی که خدا لعنت کنه این زبونو اگر بی‌مورد بخواد به جا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.72,
   "end": 330.02,
   "text": "به حرکت دربیاد. خیلی مار افعیه واقعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 330.02,
   "end": 334.72,
   "text": "یه کتاب دیدم صد و هشتاد گناه زبان عجیب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.72,
   "end": 338.9,
   "text": "صد و هشتاد گناه که از زبان سر می‌زنه رو نوشته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.9,
   "end": 341.98,
   "text": "این زبان رو شما امتحان کنین، برید امتحان کنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.98,
   "end": 345.06,
   "text": "یه روز کم حرف بزنید انقدر حال خوشی دارین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 345.06,
   "end": 347.6,
   "text": "باور کن تو یه جمع بشین سکوت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 347.6,
   "end": 350.34,
   "text": "چرا؟ چون عقل انسان باور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 350.34,
   "end": 354.72,
   "text": "حدیث داریم همینطور که روح غذاش حرف خوب زدنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 354.72,
   "end": 358.48,
   "text": "قبلاً براتون عرض کردم، عقل غذاش سکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 358.48,
   "end": 364.3,
   "text": "کسی که سکوت می‌کنه-- چرا اینایی که منبر میرن حرف می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.3,
   "end": 368.04,
   "text": "بعضی موقع‌ها حرفشون به دل می‌شینه بعضی موقع‌ها حرفشون به دل نمی‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.04,
   "end": 370.16,
   "text": "وقتی حرفشون به دل می‌شینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 370.16,
   "end": 373.58,
   "text": "قبل از منبرشون نشستن فکر کردن که چی میخوان بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.58,
   "end": 375.82,
   "text": "چون فکر کردن عقلشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 375.82,
   "end": 379.08,
   "text": "غذا خورده، می‌فهمن چی دارن میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.08,
   "end": 382.68,
   "text": "اما نه وقتی همینطوری میرن رو منبرشون می‌کنن صحبت کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 382.68,
   "end": 389.2,
   "text": "عقل قبلشون-- عقلشون غذا نخورده، گشنه است، نمی‌فهمه چرا هرچی داره میگه خودش نمی‌فهمه چی داره میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.2,
   "end": 392.06,
   "text": "لذا به دلا نمی‌شینه. خیلی این نکته مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.06,
   "end": 394.54,
   "text": "پس اگر خواستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 394.54,
   "end": 399.06,
   "text": "قلبمون در حالت خشوع باقی بمونه مراقب زبانمون باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 399.06,
   "end": 405.06,
   "text": "همین خسته‌تون نکنم مراقب زبان باشیم که ولش کنی افعیه، افعیه خطرناکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 405.06,
   "end": 410.28,
   "text": "خدا عاقبتمون رو بخ-- ختم بخیر کنه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 410.28,
   "end": 413.6,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 413.6,
   "end": 419.06,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}