 },
 "chapters": [
  {
   "index": 0,
   "title": "## نماز آیات؛ ادا بدون تأخیر",
   "start": 11.46,
   "end": 70.72
  },
  {
   "index": 1,
   "title": "## پس‌لرزه و زلزلهٔ مستقل؛ فتوای رهبری",
   "start": 70.72,
   "end": 199.14
  },
  {
   "index": 2,
   "title": "## القلب حرم الله؛ خشوع نگهبان حرم",
   "start": 199.14,
   "end": 252.26
  },
  {
   "index": 3,
   "title": "## جنگ جوارحی و جوانحی؛ سلاح دعا و بکاء",
   "start": 252.26,
   "end": 590.16
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.86,
   "end": 4.06,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.06,
   "end": 8.64,
   "text": "السلام علیک یا داعی الله و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.64,
   "end": 11.46,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.46,
   "end": 15.34,
   "text": "از رهبر عزیزمون جانم به فداش سؤال شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.34,
   "end": 20.24,
   "text": "اگر این نماز آیاتی که واجب میشه به هر دلیلی واجب شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.24,
   "end": 24.36,
   "text": "مثلا نماز زلزله واجب میشه این رو خب ما می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.36,
   "end": 27.78,
   "text": "همیشه که چی بخونیم به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.78,
   "end": 30.72,
   "text": "ادا بخونیم. قضا نداره برای زلزله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.72,
   "end": 32.9,
   "text": "در خصوص زلزله و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.9,
   "end": 35.6,
   "text": "قضا نداره همیشه اداست. خب حالا ما می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.6,
   "end": 38.96,
   "text": "و betweenش وقفه بندازیم، دیرتر بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.96,
   "end": 46.7,
   "text": "الان زلزله اومده، حالا الانم بیکارم کار خاصی هم ندارم بگم حالا فردا می‌خونم پس فردا می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.7,
   "end": 49.36,
   "text": "آقا فرمودن که این معصیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.36,
   "end": 53.64,
   "text": "اینو خیلیا نمی‌دونن. میگن خب حالا که اداست دیگه هر وقت بخونیم خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.64,
   "end": 56.52,
   "text": "حالا یه وقت دیگه می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.52,
   "end": 60.14,
   "text": "هرچی که به تأخیر بیفته معصیت حساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.14,
   "end": 62.2,
   "text": "اینو باید ما حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.2,
   "end": 65.18,
   "text": "اگرچه قضا نیست و اداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 65.18,
   "end": 67.78,
   "text": "اما نباید به تأخیر بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 67.78,
   "end": 70.72,
   "text": "در اولین فرصت باید خونده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 70.72,
   "end": 73.52,
   "text": "در خصوص قلب خاشع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 73.52,
   "end": 77.44,
   "text": "نکته‌ای مونده جانم؟ خواهش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 77.44,
   "end": 82.02,
   "text": "پس لرزه هم اتفاقا من امروز بررسی کردم چون اون روز یادتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 82.02,
   "end": 84.34,
   "text": "همون شب تو شبکه خبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 84.34,
   "end": 90.52,
   "text": "یه عزیزی از وعاظ خیلی خوب و محترم اعلام کرد که بابت هر پس لرزه یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 90.52,
   "end": 93.72,
   "text": "نماز واجب باید نماز آیات باید خونده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 93.72,
   "end": 97.72,
   "text": "من امروز استفتائات آقا رو بررسی کردم اتفاقا در این خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 97.72,
   "end": 101.78,
   "text": "آقا می‌فرمایند که اگر زمان زلزله، زمان این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 101.78,
   "end": 104.12,
   "text": "پس لرزه‌هایی که داره بعدش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 104.12,
   "end": 108.44,
   "text": "متصل نباشه به اون زل-- به اون زلزله اولیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 108.44,
   "end": 113.8,
   "text": "در حقیقت به نوعی میشه گفت یک زلزله مستقل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 113.8,
   "end": 117.02,
   "text": "اون‌ها هم اگرچه خفیف باشن نماز آیات دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 117.02,
   "end": 121.32,
   "text": "یعنی زلزله مستقل حساب بشن نه پس لرزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 121.32,
   "end": 128.66,
   "text": "و اما اگر نه، پس لرزه باشه حالا به هر دلیلی و خفیف هم باشه، حس هم خیلی نشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 128.66,
   "end": 132.62,
   "text": "این نماز آیات نداره. اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 132.62,
   "end": 134.98,
   "text": "اِاِاِ اینو حکم صریح آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 134.98,
   "end": 139.92,
   "text": "اگر مت-- از جهت زمانی متصل به زلزله اولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 139.92,
   "end": 143.0,
   "text": "نباشه یعنی مستقل باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 143.0,
   "end": 148.5,
   "text": "و اِاِاِ خفیف هم نباشه حتما باید نماز آیات براش خونده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 148.5,
   "end": 150.78,
   "text": "حالا البته اگر این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 150.78,
   "end": 153.58,
   "text": "زلزله خفیف باشه توی شهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 153.58,
   "end": 157.0,
   "text": "همه متوجه نشن. بعدا مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 157.0,
   "end": 161.5,
   "text": "زلزله‌نگاری اعلام کنه که آقا زلزله اومده متوجه هم نشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 161.5,
   "end": 165.18,
   "text": "اما چون زلزله مستقل بوده این نماز آیات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 165.18,
   "end": 167.58,
   "text": "ولو شما متوجه نشده باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.58,
   "end": 170.9,
   "text": "توجه کردید؟ اما اگر نماز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 170.9,
   "end": 173.48,
   "text": "اِاِاِ ببخشید اگر زلزله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 173.48,
   "end": 175.74,
   "text": "مستقل نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 175.74,
   "end": 180.48,
   "text": "یعنی وصل بود به یه زلزله‌ای که این بعدش اومده و خفیف هم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 180.48,
   "end": 183.48,
   "text": "در این صورت نماز آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 183.48,
   "end": 190.46,
   "text": "نداره. حالا اون عزیزی که تو تلویزیون اعلام کرد نگفت به چه مبنایی داره اینو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 190.46,
   "end": 194.58,
   "text": "چون ایشون به هر حال واعظ محترم و عالم و دانشمندیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 194.58,
   "end": 196.3,
   "text": "حالا نگفتن به فتوای کی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 196.3,
   "end": 203.14,
   "text": "فتوای آقا اینه. خب در خصوص قلب خاشع نکته‌ای رو من سریع عرض کنم احکام طول کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 203.14,
   "end": 205.84,
   "text": "اینو خوب توجه باش بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 205.84,
   "end": 208.18,
   "text": "من فقط با یکی دو تا مصداق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 208.18,
   "end": 211.34,
   "text": "خودم رو متوجه قضیه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 211.34,
   "end": 217.54,
   "text": "اونم این که ما گفتیم که \"القلب حرم الله ولا تسکن حرم الله غير الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 217.54,
   "end": 220.28,
   "text": "این حدیثی‌ست که بسیار حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 220.28,
   "end": 225.72,
   "text": "خوب و متقن و محکم و مستندی‌ست که علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 225.72,
   "end": 229.16,
   "text": "خدمتتون عرض کردم من محضرشون که بودم گفتم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 229.16,
   "end": 234.88,
   "text": "حدیثی برای ما بنویسید، یه چیزی به ما بگید تا آخر عمر دستمون باشه، اینو نوشت برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 234.88,
   "end": 238.62,
   "text": "قلب حرم خداست. در حرم خدا غیر خدا رو جا نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 238.62,
   "end": 241.56,
   "text": "ما گفتیم قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 241.56,
   "end": 244.92,
   "text": "قلب مؤمن از نشانه‌هاش اینه که خاشعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 244.92,
   "end": 249.3,
   "text": "ترسانه، در برابر خدا ترسان است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.3,
   "end": 251.8,
   "text": "خشوع دارد، افتاده حال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 251.8,
   "end": 256.36,
   "text": "اگر قلب دقت کنید، اگر قلب حرم خداست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 256.36,
   "end": 259.64,
   "text": "این خشوعش چیه؟ آیا حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 259.64,
   "end": 263.28,
   "text": "باید ترسان باشه؟ لرزان باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 263.28,
   "end": 267.7,
   "text": "با یه مثال خیلی خوب جا میفته، اونم همین حرم‌های اهل بیت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 267.7,
   "end": 270.7,
   "text": "چقدر ما شهید دادیم تا حفظش کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 270.7,
   "end": 273.2,
   "text": "از دستر-- از دسترس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 273.2,
   "end": 279.4,
   "text": "دشمن و بیگانه از اینکه بیگانه نتونه درش نفوذ پیدا کنه و اون رو تخریب کنه، چقدر ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 279.4,
   "end": 281.72,
   "text": "مدافعین حرم چقدر شهید دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 281.72,
   "end": 284.76,
   "text": "اسمش هم رو خودشه دیگه مدافع حرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 284.76,
   "end": 288.32,
   "text": "اگر قلب مؤمن حرم الهی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 288.32,
   "end": 292.48,
   "text": "باید دائما در یک ترسی قرار داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 292.48,
   "end": 301.1,
   "text": "یک خشوعی، یک لرزشی در درونش باشه، نگرانی‌ای باشه که مبادا تحت نفوذ بیگانه قرار بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 301.1,
   "end": 303.02,
   "text": "لذا باید این حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 303.02,
   "end": 307.64,
   "text": "حراست بشه. باید حارس داشته باشه، نگهبان داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 307.64,
   "end": 310.04,
   "text": "همینطوری رها باشه که نمیشه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 310.04,
   "end": 316.22,
   "text": "حالا این که ما در این درون خودمون، در قلب حرم درون خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.22,
   "end": 322.38,
   "text": "چگونه نگهبان‌هایی باید داشته باشیم و چگونه باید بجنگیم بحث مفصل و مبثوتیه ما واردش نمی‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 322.38,
   "end": 329.88,
   "text": "فقط اصطلا-- اِاِاِ تبرکا عرض می‌کنم علامه جوادی آملی حفظه الله تعالی این عالم جامع الاسراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 329.88,
   "end": 331.66,
   "text": "فرمودن ما دو نوع جنگ داریم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.66,
   "end": 334.2,
   "text": "جنگ بیرونی که بهش میگن جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 334.2,
   "end": 340.26,
   "text": "جواره‌هی که قرآن می‌فرماید \"و اعدوا لهم ما استطعتم من قوة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.26,
   "end": 344.7,
   "text": "و یک جنگ درونی که بهش میگن جنگ جوانحی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.7,
   "end": 346.8,
   "text": "جوانح، قوای درونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 346.8,
   "end": 349.4,
   "text": "ما باید مشغول جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.4,
   "end": 352.48,
   "text": "در درون خودمون باشیم و الا قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 352.48,
   "end": 355.52,
   "text": "ما که حرم الهیه تحت تسخیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 355.52,
   "end": 360.32,
   "text": "داعشی‌های درونمون قرار می‌گیره و حرم رو بمب‌گذاری می‌کنن و منفجرش می‌کنن و ما هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.32,
   "end": 363.8,
   "text": "خواب و غافل می‌بینیم بعد دیگه حرمی در وجودمان نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 363.8,
   "end": 366.88,
   "text": "قلبی وجود نداره که بخواد خاشع باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 366.88,
   "end": 370.14,
   "text": "حالا این سلاحش چیه جنگ درونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 370.14,
   "end": 372.72,
   "text": "جنگ بیرونی که سلاحش معلومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 372.72,
   "end": 375.34,
   "text": "جنگ جوانحی یا درونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 375.34,
   "end": 377.96,
   "text": "سلاحش تو خود کمیل ولا فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.96,
   "end": 382.08,
   "text": "اولا حدیث داریم \"الدعا سلاح المؤمن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 382.08,
   "end": 385.12,
   "text": "در کمیل هم امیرالمؤمنین میفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 385.12,
   "end": 387.42,
   "text": "و سلاحه البکا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 387.42,
   "end": 393.28,
   "text": "تمام. سلاح، سلاح یک مؤمن دعا و اشکشه، آه و زاریشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 393.28,
   "end": 396.72,
   "text": "نیمه‌شبشه، سحرشه، عبادتشه، بندگیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 396.72,
   "end": 404.22,
   "text": "این باعث میشه که سلاح داشته باشه بتونه در برابر جنگ، اون جنگ درونی در برابر دشمن درونیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 404.22,
   "end": 410.18,
   "text": "پیروز بشه، مواف-- موف-- موفق بشه و اجازه نده داعشی‌های درونش حرم وجودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 410.18,
   "end": 412.52,
   "text": "تسخیر کنن. و این البته مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 412.52,
   "end": 415.46,
   "text": "بعضیا به یه نافله بسنده می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 415.46,
   "end": 419.14,
   "text": "یه دو رکعت نماز نافله عشاء و طهری نشسته رو می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 419.14,
   "end": 423.36,
   "text": "میگن حدیث داریم به جای نماز شب حساب میشه دیگه سحر تا صبح می‌خوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 423.36,
   "end": 426.48,
   "text": "عده‌ای هم نه اینطوری نیستن مثل آقای بهجت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 426.48,
   "end": 431.22,
   "text": "که شب‌ها میگن خصوصا شب‌های جمعه تا صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.22,
   "end": 436.6,
   "text": "بدون استثنا تو کل عمرش ایشون بیدار بود در سجده بود و دائما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 436.6,
   "end": 443.46,
   "text": "اونایی که نزدیکش بودند می‌گفتن این صدا ازش بلند بود با حالت گریه که \"الهی و ربی ما لی غیرک اسأله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 443.46,
   "end": 446.42,
   "text": "كشف الضرر و النذر فی امری\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 446.42,
   "end": 449.32,
   "text": "از فرازهای کمیل و تا صبح تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 449.32,
   "end": 452.88,
   "text": "سجده حضرت آقای بهجت می‌خوند گریه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 452.88,
   "end": 457.08,
   "text": "بعضیاشون که دیگه انقدر بالا رفتن چون هرچی حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 457.08,
   "end": 463.28,
   "text": "گسترش پیدا می‌کنه هم مورد هجمه بیشتری قرار می‌گیره هم کنترلش مشکل‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 463.28,
   "end": 465.36,
   "text": "لذا باید سلاحشون بیشتر باشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 465.36,
   "end": 468.76,
   "text": "وقتی حرم گسترش پیدا کرد سلاح بیشتری هم می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 468.76,
   "end": 471.88,
   "text": "نشون میده حرم وجودش گسترش پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 471.88,
   "end": 477.08,
   "text": "الان نگهداری یه حرم امام رضا با اون همه وسعت خیلی سخت‌تره تا اون حرم مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.08,
   "end": 480.1,
   "text": "دویست سال پیش یه بق-- بارگاه کوچولویی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.1,
   "end": 483.12,
   "text": "و این سلاح بیشتری می‌خواد، اشک و آه بیشتری می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 483.12,
   "end": 486.46,
   "text": "تا جایی که امثال کمپانی‌ها، مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 486.46,
   "end": 490.94,
   "text": "اه آقای غروی اصفهانی که معروفه به مرحوم کمپانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 490.94,
   "end": 495.58,
   "text": "روبروی ایوان طلا امیرالمؤمنین انشاالله قسمتشو به زودی بریم، وایستید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.58,
   "end": 502.48,
   "text": "مناره‌ی سمت راست زیر مناره‌ی در چوبی داخل تو، تو خود مناره یه اتاقکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 502.48,
   "end": 506.34,
   "text": "دقیقا بغل آست مستشهد سید مصطفی خمینی دفن ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 506.34,
   "end": 508.38,
   "text": "آقای کمپانی استاد آقای بهجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 508.38,
   "end": 510.58,
   "text": "حضرت آیت الله العظمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 510.58,
   "end": 516.56,
   "text": "کشمیری در خصوص آقای کمپانی می‌گفت من می‌دیدم هر روز می‌اومد رو به روی حرم علی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 516.56,
   "end": 519.84,
   "text": "رو به روی ضریح علی علیه الصلاة والسلام می‌ایستاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.84,
   "end": 524.86,
   "text": "چند دقیقه اه مشغول ذکر بود و من می‌دیدم که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 524.86,
   "end": 531.98,
   "text": "چند دقیقه هزار مرتبه سوره قدر می‌خوند و این برای شما غامض و پیچیده است آقای کشمیری می‌فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 531.98,
   "end": 535.52,
   "text": "اما ایشون به طی زمان و طی اللسان رسیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 535.52,
   "end": 537.74,
   "text": "اگه عده‌ای به طی الارض رسیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 537.74,
   "end": 543.08,
   "text": "آقای کمپانی بر اثر شدت مراقبه قلبش و حرم وجودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 543.08,
   "end": 549.68,
   "text": "حرم قلبش یا و عبادت و کثرت خشوعش به طی اللسان و طی الزمان رسیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 549.68,
   "end": 552.0,
   "text": "یعنی در عرض چند دقیقه می‌تونست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 552.0,
   "end": 556.84,
   "text": "وارد یه عالم مثلا زمان رو طی کنه و حسا-- هزار سوره قدر بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 556.84,
   "end": 559.9,
   "text": "این ببینید به کجا رسیده. چرا اینطوری شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 559.9,
   "end": 565.4,
   "text": "قلبش وسعت پیدا کرده، عالمگیر شده لذا اشک و آه و سلاح بیشتری می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 565.4,
   "end": 567.44,
   "text": "این‌ها رو ما یه ذره به گوشمون بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 567.44,
   "end": 570.46,
   "text": "یه وقت خدایی نکرده به یه دو رکعت نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 570.46,
   "end": 575.76,
   "text": "نافله‌ای که بعضا به کمرم من می‌زنم دلم خشک نشه و بسنده نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 575.76,
   "end": 580.5,
   "text": "انشاالله عاقبتمون ختم بخیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.5,
   "end": 582.94,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 582.94,
   "end": 586.6,
   "text": "على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 586.6,
   "end": 590.16,
   "text": "محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}