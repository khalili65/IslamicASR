   "start": 14.56,
   "end": 88.36
  },
  {
   "index": 1,
   "title": "## تمثیل زلزله؛ سیلی بیداری",
   "start": 88.36,
   "end": 121.9
  },
  {
   "index": 2,
   "title": "## قلب خاشع؛ آمادگی برای رجعت",
   "start": 121.9,
   "end": 165.26
  },
  {
   "index": 3,
   "title": "آیهٔ بعد خاشعین را معرفی می‌کند:",
   "start": 165.26,
   "end": 214.72
  },
  {
   "index": 4,
   "title": "## علامه حسن‌زاده؛ کارخانهٔ هستی",
   "start": 214.72,
   "end": 301.92
  },
  {
   "index": 5,
   "title": "## دو راهکار بزرگان برای تنبه",
   "start": 301.92,
   "end": 322.64
  },
  {
   "index": 6,
   "title": "## احوال مرگ قدرتمندان تاریخ",
   "start": 322.64,
   "end": 687.8
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.2,
   "end": 5.56,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.56,
   "end": 9.26,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.26,
   "end": 13.3,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.3,
   "end": 18.22,
   "text": "باز برای اطمینان من از دفتر آقا امروز سؤال کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.22,
   "end": 21.88,
   "text": "آیا پس لرزه‌ها بالاخره چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.88,
   "end": 24.96,
   "text": "پس لرزه‌ها نماز آیات داره یا نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.96,
   "end": 28.64,
   "text": "فرمودن، ایشون فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.64,
   "end": 34.82,
   "text": "پس لرزه نماز آیات نداره مگر اینکه زلزله‌ی مستقلی حساب بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.82,
   "end": 38.9,
   "text": "و شما متوجه ز-- لرزش بشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.9,
   "end": 42.02,
   "text": "یا اگر هم متوجه لرزش نشدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.02,
   "end": 46.34,
   "text": "زمانش متصل باشه. یعنی همین الان پیچ تلویزیون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.34,
   "end": 51.0,
   "text": "باز کنی ببینی که بگه همین الان زلزله اومده یعنی زمان متصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.0,
   "end": 53.32,
   "text": "اون موقع به شما چیه؟ واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.32,
   "end": 59.36,
   "text": "اما اگر زلزله مستقل نباشه و خ-- شما هم متوجه زلزله نشدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.36,
   "end": 68.58,
   "text": "واجب نیست. اما کسایی که حالا در خوابن یا در بیهوشی‌اند، توی مریضی مثلاً کما، یه توی وضعیتی هستن که اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.58,
   "end": 70.4,
   "text": "اصلاً متوجه زلزله نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.4,
   "end": 76.06,
   "text": "اگر چه حتی ده ریش دارن باشه مثلاً یه جا خوابه یا بیهوشه اصلاً هیچی نفهمیده، این چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.06,
   "end": 82.22,
   "text": "آقا فرمودن واجب نیست براش اما احتیاط اینه که بخونه یعنی از رو احتیاط بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.22,
   "end": 85.94,
   "text": "فتوا ندادن آقا. اما در خصوصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.94,
   "end": 90.86,
   "text": "به هر حال این زلزله‌هام اینو به خدا رحمت کن سید الله خائری شیرازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.86,
   "end": 93.58,
   "text": "که اخیراً از دنیا رفتن روحشون شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.58,
   "end": 96.98,
   "text": "ایشون می‌فرمودن که یه تمثیل جالبی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.98,
   "end": 99.08,
   "text": "می‌فرمودن که چطور آدم توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.08,
   "end": 101.4,
   "text": "جای یخ بندان تو قطب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.4,
   "end": 105.26,
   "text": "کسی خوابش می‌بره می‌زنن تو گوشش که بیدار شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.26,
   "end": 110.64,
   "text": "اگر بخوابه می‌میره. تو سرمای زم-- مثلاً زمستان تو قطب یا هر جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.64,
   "end": 112.42,
   "text": "ایشون تعبیرش از زلزله این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.42,
   "end": 116.14,
   "text": "می‌فرمود که نواختن سیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.14,
   "end": 119.0,
   "text": "سیلی خدا به گوش بندگانشه زلزله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.0,
   "end": 122.6,
   "text": "که خوابت نبره. مثل اون یخ زده‌ای که در ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.6,
   "end": 124.88,
   "text": "تو یخ، سرما بخوابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.88,
   "end": 130.32,
   "text": "می‌میره، خدا تو س-- گوش ما می‌زنه که از ها-- خواب غفلت بیدار شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.32,
   "end": 135.04,
   "text": "تا حالا اون همه آدم اون شب ریخت بیرون، کدومشون نماز آیات خوند یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.04,
   "end": 138.24,
   "text": "الله اعلم. خب قلب خاشع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.24,
   "end": 144.4,
   "text": "یه نکته دیگه‌ای ازش مونده که این البته نکات بسیار زیادی می‌مونه اما ما تبرکاً عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.4,
   "end": 149.2,
   "text": "اگر آیه چهل و پنج و چهل و شش بقره رو دقت کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.2,
   "end": 155.14,
   "text": "آیه چهل و پنج رو مختصراً عرض کردیم \"واستعینوا بالصبر والصلاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.14,
   "end": 158.78,
   "text": "وإنها لكبيرة إلا على الخاشعين\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.78,
   "end": 162.04,
   "text": "این خاشعين رو آیه بعدش توضیح میده چه کسایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.04,
   "end": 164.54,
   "text": "ما قلب خاشع رو چند جلسه بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.54,
   "end": 169.42,
   "text": "حالا ببینیم از نظر قرآن یکی از مشخصات خاشعين چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.42,
   "end": 176.88,
   "text": "می‌فرماید \"الذین یذ النون أنهم ملاقوا ربهم وأنهم إليه راجعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.88,
   "end": 180.08,
   "text": "الذین کسانی که یعنی خاشعين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.08,
   "end": 183.5,
   "text": "این‌هایی که از نظر قرآن خاشع حساب میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.5,
   "end": 185.32,
   "text": "کسایین که آماده مرگ‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.32,
   "end": 188.28,
   "text": "همیشه متوجه و به یاد مرگ‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.28,
   "end": 191.96,
   "text": "\"و أنهم إليه راجعون\" خودشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.96,
   "end": 194.32,
   "text": "در حال رجعت به خدا می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.32,
   "end": 196.46,
   "text": "یعنی همین الان آماده رفتن‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.46,
   "end": 200.28,
   "text": "بهش بگی حاضری؟ بله. در هر رکوعم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.28,
   "end": 204.26,
   "text": "سرم رو دراز کردم که خدا سرمو بزنه و فدای در راه او بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.26,
   "end": 208.04,
   "text": "این معنای حقیقی رکوع است که عرض کردیم قبلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.04,
   "end": 214.56,
   "text": "یعنی آمادگی برای آدم شخص خاشع و قلب خاشع آماده‌ست برای رجعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.56,
   "end": 220.64,
   "text": "این کلام علامه حسن زاده خیلی عالیه در خصوص فهم این قضیه ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.64,
   "end": 225.5,
   "text": "می‌فرماید انسان بیدار همواره کشیک نفس می‌دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.5,
   "end": 231.78,
   "text": "و پاسبان حرم دل است و واردات و صادرات دهان خود را می‌یابد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.78,
   "end": 237.52,
   "text": "و دار هستی را کارخانه‌ای بزرگ می‌یابد که با امّال بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.52,
   "end": 241.7,
   "text": "بعد اشاره می‌کند به آیه سی و یک مدثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 241.7,
   "end": 249.56,
   "text": "که \"وما يعلم جنود ربك إلا هو\" این امّال و جنود خدا رو فقط خدا میدونه کیان و چقدرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.56,
   "end": 253.6,
   "text": "فرمود که با امّال بی‌شمار تو این کارخانه بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.6,
   "end": 263.08,
   "text": "دستهم گرفته‌اند، در کارند تا انسان بسازند، اینجا رو دقت کنید، و از عالمی تحویل به عالم دیگر بدهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.08,
   "end": 267.96,
   "text": "ما قراره که همینجوری عالم به عالم طی کنیم و سیر کنیم و بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.96,
   "end": 274.28,
   "text": "یعنی تمومی نداره. اینطوری نیست که شما بگید خب ما مردیم تموم شد یا اصلاً حتی رسیدیم قیامت تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.28,
   "end": 276.74,
   "text": "نه همینطوری عوالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.74,
   "end": 280.56,
   "text": "پشت عوالم ماها رو تحویل میدن به همدیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 280.56,
   "end": 284.12,
   "text": "هی میریم سیر، یه سیریه، داریم حرکت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.12,
   "end": 287.54,
   "text": "نباید متوقف شد. که حالا در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.54,
   "end": 292.24,
   "text": "آمادگی ما برای حرکت توی این عالم به عالم بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 292.24,
   "end": 296.2,
   "text": "قلب خاشع است که کاملاً آماده‌ست برای حرکتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 296.2,
   "end": 299.9,
   "text": "از این عالم سفرش از این عالم به عالم بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 299.9,
   "end": 304.3,
   "text": "کاملاً آماده‌ست. که حالا بزرگان دو تا راهکار دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.3,
   "end": 307.32,
   "text": "فرمودن که این دو تا کا-- راهکار رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.32,
   "end": 310.62,
   "text": "توجه بهش بکنید بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.62,
   "end": 313.64,
   "text": "متوجه بشید یعنی مت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.64,
   "end": 318.12,
   "text": "به قولی یه سیلی خودتون تو گوش خودتون بزنید از اون غفلت بیدار بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.12,
   "end": 322.64,
   "text": "یکی گفتن برید قبرستان‌های مخروب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.64,
   "end": 329.08,
   "text": "جاهایی که قبرهای خراب شده هست، مخصوصاً اینایی که اتاقک داره مثل ابن بابویه اینا بعضیاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.08,
   "end": 331.9,
   "text": "مثلاً آینه‌کاری شده بعد یهو تبله زده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.9,
   "end": 333.96,
   "text": "سقفش داره می‌ریزه، دیوارهاش مخروبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.96,
   "end": 336.18,
   "text": "هیچکس اصلاً نمیاد درست کنه این قبرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.18,
   "end": 341.4,
   "text": "یه زمانی واسه خودش دبدبه کبکبه‌ای داشته صاحب قبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.4,
   "end": 346.32,
   "text": "الان اون آینه‌کاری‌های قبرش داره می‌ریزه کسی نیست بره درستش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 346.32,
   "end": 349.26,
   "text": "یعنی اصلاً هیچکس دیگه اصلاً یاد این شخص نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.26,
   "end": 355.32,
   "text": "تمام. میگه برید ببینید قبرستان‌های مخروبو مخصوصاً نه این قبرهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 355.32,
   "end": 359.64,
   "text": "آنچنان مثلاً سنگ‌هایی روش انداختن که میلیون‌ها تومن پول این سنگ‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 359.64,
   "end": 361.64,
   "text": "اینا خیلی تنبّه نمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.64,
   "end": 365.98,
   "text": "اینجاهایی که خراب شده. دو فرمودن برید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.98,
   "end": 372.56,
   "text": "دقت کنید تو احوالات پیرمرد، پیرزن‌ها اینا کمتر ما اصلا کاری با پیرزن، پیرمردها نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.56,
   "end": 376.38,
   "text": "من همین چند روز پیش پیش مادر بزرگ خانمم بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.38,
   "end": 380.64,
   "text": "که حالا الحمد لله مادر، مادر، مادرش هم هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.64,
   "end": 383.32,
   "text": "یعنی مادر بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.32,
   "end": 387.42,
   "text": "مادر میشه مادر مادر بزرگ خانمم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.42,
   "end": 392.16,
   "text": "که مثلا با اون سن نزدیک صد سال روزی پنج تا زیارت عاشورا می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.16,
   "end": 395.24,
   "text": "یه آدم عجیبیه. ما رفتیم محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 395.24,
   "end": 397.56,
   "text": "مادر، مادر، مادرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 397.56,
   "end": 405.04,
   "text": "ایشون یه و-- اصلا چهره‌شو که من دیدم یاد مرگ افتادم خدا شاهده چهره‌شو که دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.04,
   "end": 408.38,
   "text": "دیدی این پیرزن، پیر-- بعد حالات عجیبی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.38,
   "end": 411.02,
   "text": "کاملا دل کندن از این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.02,
   "end": 414.14,
   "text": "این حالاتشونو میگه شما توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 414.14,
   "end": 417.22,
   "text": "حالات این پیرمرد، پیرزن‌ها مخصوصا این‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.22,
   "end": 421.52,
   "text": "یه ذره معنوی هم هستنو اصلا هیچ دل سر سوزنی دل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 421.52,
   "end": 424.06,
   "text": "دنیا خوش ندارن. آماده‌ن برای رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.06,
   "end": 426.36,
   "text": "حتی کفن‌شونو آماده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.36,
   "end": 428.66,
   "text": "میگه به اینا توجه کنید شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.66,
   "end": 432.36,
   "text": "شما هم اینطوری باشید. چند نفر از ما کفن داریم کفن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.36,
   "end": 437.14,
   "text": "مثلا بعضی از بزرگان هر شب رو کفن‌شون نمازشون رو می‌خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.14,
   "end": 440.72,
   "text": "هر شب با کفن‌شون می‌خوابیدن، با کفن نجوا می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.72,
   "end": 446.44,
   "text": "کدوم یکی از ما تو این دار دنیاى فعلی از این کارا اصلا، اصلا کفن تو کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 446.44,
   "end": 449.96,
   "text": "واقعاً آمادگی، نگاه کردن به این احوالات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.96,
   "end": 456.3,
   "text": "بعد حالا اونایی که خیلی گنده، گنده، گنده تاریخ بودن شما نگاه کن اونایی که از دنیا رفتن یه بررسی بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 456.3,
   "end": 458.34,
   "text": "من بررسی می‌کردم حالات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.34,
   "end": 466.68,
   "text": "مرگ آدم بدها رو، آدم بدای گنده‌هاشونو مثلا مثل معاویه، هارون الرشید، عبدالملک مروان اینا خیلی عجیب بود برام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 466.68,
   "end": 471.32,
   "text": "واقعاً عجیب آدم اینا رو دقت کنه به خدا همین فرعون با اون همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 471.32,
   "end": 475.06,
   "text": "مثلا دبدبه و کبکبه وقتی می‌رفت هی موسی رو صدا می‌زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 475.06,
   "end": 477.7,
   "text": "داشت فرو می‌رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.7,
   "end": 484.16,
   "text": "داشت می‌مرد هی موسی رو که خدا گفت موسی این همه صدات زد اگه یه بار منو صدا زده بود دستشو گرفته بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 484.16,
   "end": 487.42,
   "text": "فرعون با اون عظمتش داشت هی فرو می‌رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.42,
   "end": 491.52,
   "text": "هی موسی رو صدا می‌زد تو زمین که فرو می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.52,
   "end": 494.36,
   "text": "یا مثلا معاویه ما این همه درباره‌ش شنیدیم ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 494.36,
   "end": 499.9,
   "text": "معاویه ملعون لعنت الله و خیلی عجیبه در حال مرگ وقتی داشت می‌مرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.9,
   "end": 503.72,
   "text": "یه دفعه یه کلامی از لس-لسانش خارج شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.72,
   "end": 506.4,
   "text": "آهی کشید گفت ای کاش من هیچ کاره بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 506.4,
   "end": 509.02,
   "text": "یه آدم معمولی تو قریش بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 509.02,
   "end": 510.9,
   "text": "هیچ مسئولیتی رو دوشم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 510.9,
   "end": 514.04,
   "text": "چه کردم؟ این کلام معاویه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.04,
   "end": 516.56,
   "text": "با اون همه جایگاهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 516.56,
   "end": 520.4,
   "text": "یا عبدالملک مروان وقتی داشت به درک وصل می‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 520.4,
   "end": 523.58,
   "text": "یه نگاه کرد به، به این ابو هاظم رختشور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.58,
   "end": 525.48,
   "text": "اون موقع مثل الان نبود ماشین لباسشویی و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 525.48,
   "end": 527.08,
   "text": "پول می‌دادن یه چیز رخت می‌شست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.08,
   "end": 532.32,
   "text": "اصلا یه شغل بود. نگاهش کرد گفت ای کاش من رختشور بودم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 532.32,
   "end": 534.02,
   "text": "این کاره نبودم، مسئولیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 534.02,
   "end": 539.78,
   "text": "کسی رو به دوش نمی‌کشیدم که اینطوری خراب کاری کنم که حالا می‌خوام برم از این دنیا با دست خالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 539.78,
   "end": 543.72,
   "text": "عبدالملک مروان از سخت‌ترین دشمنان اهل بیت بود اینطوری گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 543.72,
   "end": 547.26,
   "text": "جالبه وقتی خبر رسید به ابو هاظم رختشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 547.26,
   "end": 556.1,
   "text": "خندید گفتش که خدایا شکرت که شغل ما رو به گونه‌ای قرار دادی که امرای عالم وقت مرگ آرزوی شغل ما رو می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.1,
   "end": 561.16,
   "text": "اما ما هیچ‌وقت آرزوی شغل و جایگاه اونا رو نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 561.16,
   "end": 564.66,
   "text": "یا مثلا عمر بن عبدالعزیز تازه خوبه‌شون بوده مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 564.66,
   "end": 567.0,
   "text": "عمر بن عبدالعزیز داشت می‌رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.0,
   "end": 570.6,
   "text": "از دنیا. بهش گفتن این مسموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.6,
   "end": 572.9,
   "text": "خب اول کسی بود که ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.9,
   "end": 577.26,
   "text": "اهل بیت و بیان احادیث رو آزاد کرد بعد حدود نود سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.26,
   "end": 578.86,
   "text": "یه خیراتی ازش سر زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 578.86,
   "end": 582.26,
   "text": "زیارت قبور اهل بیت رو جایز دونست و چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.26,
   "end": 587.36,
   "text": "سمش دادن وقتی طبیب گفت آقا این مسمومه دیگه گریزی از مرگ ازش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.36,
   "end": 589.96,
   "text": "فریادش بلند شد گفت چی داری میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 589.96,
   "end": 593.56,
   "text": "برای هیچ کسی از مرگ گریزی نیست، نه فقط من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 593.56,
   "end": 597.3,
   "text": "بعد آه کشید گفت خدایا چقدر اوامر تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.3,
   "end": 600.52,
   "text": "کنار گذاشتم و چقدر نواهی‌ت رو انجام دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.52,
   "end": 602.62,
   "text": "با این آه حسرت از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 602.62,
   "end": 606.2,
   "text": "هارون الرشید وقتی کفن‌شو دید، اون هارون الرشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 606.2,
   "end": 610.06,
   "text": "ملعون خبیث که حدود هجده بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 610.06,
   "end": 616.72,
   "text": "بعضی تاریخ میگه هجده بار قبر ابا عبدالله رو به شخم کشید و خر-- تخریب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 616.72,
   "end": 624.92,
   "text": "خدا لعنتش کنه. یکی از دلایل عظمت حضرت عبدالعظیم حسنی اصلا فکر کردید چرا زیارت حضرت عبدالعظیم حسنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 624.92,
   "end": 628.18,
   "text": "مساوی-- زیارتش مساوی‌ست با امام حسین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 628.18,
   "end": 630.12,
   "text": "چرا؟ سؤال شده اصلاً برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 630.12,
   "end": 635.06,
   "text": "خب منم نمی‌دونستم تا از یه بزرگی شنیدم که عجب جالبه که ایشون هر با--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 635.06,
   "end": 642.2,
   "text": "هر هجده باری که هارون ملعون قبر ابا عبدالله رو شخم زد و تخریب کرد، هر بار ایشون ساخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 642.2,
   "end": 645.04,
   "text": "هجده بار حرم ابا عبدالله رو ساخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 645.04,
   "end": 647.46,
   "text": "آخر هم اومد فرار کرد اینجا توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.46,
   "end": 654.8,
   "text": "سردابی بوده حرم ایشون تو اون سرداب بعد دفنش کردن زنده زنده اونجا زنده به گور کردن حضرت عبدالعظیم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 654.8,
   "end": 656.5,
   "text": "و از این جهت ببین خ-خدمتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 656.5,
   "end": 658.6,
   "text": "حالا اونور نریم بحث طول کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 658.6,
   "end": 663.46,
   "text": "هارون الرشید وقتی داشت می‌مرد اون ملعون خبیث که هجده بار قبر ابا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 663.46,
   "end": 668.66,
   "text": "وقتی کفن‌شو دید آه کشید گفت نه مالم به سودم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 668.66,
   "end": 671.76,
   "text": "برا مون، نه پادشاهی و جایگاهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 671.76,
   "end": 674.08,
   "text": "آه کشید و به درک وصل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.08,
   "end": 678.7,
   "text": "خدا عاقبتمون رو ختم بخیر کنه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 678.7,
   "end": 682.16,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 682.16,
   "end": 684.22,
   "text": "محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 684.22,
   "end": 687.8,
   "text": "آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}