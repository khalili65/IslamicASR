 "chapters": [
  {
   "index": 0,
   "title": "## جهر و اخفات در قضای نماز",
   "start": 11.68,
   "end": 208.32
  },
  {
   "index": 1,
   "title": "### تمثیلِ غذای ناسازگار",
   "start": 208.32,
   "end": 292.34
  },
  {
   "index": 2,
   "title": "## تجربهٔ شخصی در لذتِ نماز و از دست رفتنِ حال",
   "start": 292.34,
   "end": 316.28
  },
  {
   "index": 3,
   "title": "## آیهٔ سی و نه فصلت؛ زمینِ خاشع",
   "start": 316.28,
   "end": 422.94
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.7,
   "end": 4.96,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.96,
   "end": 8.36,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.36,
   "end": 11.68,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.68,
   "end": 16.06,
   "text": "از مقام معظم رهبری جانم به فداش استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.06,
   "end": 24.7,
   "text": "خب ما میدونیم که نمازهای صبح و مغرب و عشا رو باید همداسورشو بلند خوند و ظهر و عصر رو آهسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.7,
   "end": 28.62,
   "text": "قضاشو چطور؟ اگر خواستیم مثلا روز بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.62,
   "end": 33.14,
   "text": "نماز مغرب و عشا رو که شب خونده میشه قضاشو روز بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.14,
   "end": 36.74,
   "text": "باز باید بلند بخونیم اما یا چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.74,
   "end": 41.28,
   "text": "ظهر که مثلا ما میخونیم ظهر رو آهسته میخونیم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.28,
   "end": 44.96,
   "text": "عصر رو آهسته میخونیم. حالا میخوایم مغرب و عشا قضاشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.96,
   "end": 47.9,
   "text": "ظهر بخونیم باید آهسته بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.9,
   "end": 50.26,
   "text": "یا اگر آهسته بخونیم چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.26,
   "end": 54.9,
   "text": "استفتائه اینجا دو سه تا استفتاء هست من همه رو با هم دارم جمع می‌کنم جواب میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.9,
   "end": 59.88,
   "text": "آقا فرمودن که فرقی نمی‌کنه چه قضا باشه چه ادا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.88,
   "end": 67.4,
   "text": "نماز صبح و مغرب و عشا چه قضا باشه چه ادا، چه هر وقتی بخوای قضاشو بخونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.4,
   "end": 71.3,
   "text": "یا خود اداش رو باید همداسورشو بلند بخونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.3,
   "end": 74.46,
   "text": "و ظهر و عصر رو باید آهسته بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.46,
   "end": 78.56,
   "text": "اگر کسی اینجا رو دقت کنید اگر کسی سهوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.56,
   "end": 81.94,
   "text": "یا جهلا، اینا با هم فرق می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.94,
   "end": 93.62,
   "text": "به هر دلیلی یا سهوا یا جهلا باشه این کارو انجام نده نمازش اشکال نداره و نیاز به قضا هم دوباره نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.62,
   "end": 98.9,
   "text": "سهوا یعنی چی؟ یعنی حواسش-- حکم رو بلد بوده حواسش نبوده یادش نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.9,
   "end": 102.94,
   "text": "جهلا یعنی چی؟ یعنی حکم رو بلد نبوده، نمی‌دونسته اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.94,
   "end": 108.8,
   "text": "یه عمر اینطوری نخوانده مثلا نماز ظهر هر طور دوست داشته بالا یه بار بلند خونده یه بار آهسته خونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.8,
   "end": 111.92,
   "text": "حکم رو رعایت نکرده آقا فرموده اشکالی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.92,
   "end": 116.38,
   "text": "اما اگر عمدا بلند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.38,
   "end": 120.48,
   "text": "جایی که باید آهسته بخونه بلند بخونه یا بالعکس باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.48,
   "end": 122.92,
   "text": "حالا چه اون قضا باشه چه ادا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.92,
   "end": 127.2,
   "text": "یه نکته خیلی، خیلی، خیلی مهمی هست این رو خواهش می‌کنم خوب توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.2,
   "end": 129.64,
   "text": "من کوتاه میگم خیلی کوتاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.64,
   "end": 135.52,
   "text": "مثلا هر روز هفت هشت ده دقیقه هم نشه چهار پنج دقیقه خوب گوش بدید دیگه خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.52,
   "end": 139.4,
   "text": "خدا رحمت کنه مرحوم آیت الله عائلی شیرازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.4,
   "end": 142.92,
   "text": "البته رهبر عزیزمون به هر حال جانم به فداش، ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.92,
   "end": 147.46,
   "text": "علمدار اسلام و انقلاب به ایشون لفظ حجت الاسلام دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.46,
   "end": 154.02,
   "text": "همین عزیزی که اخیرا از دنیا رفتن و خود آقایشون رو دعوت کردن به عنوان معلم اخلاق تشریف بیارن تهران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.02,
   "end": 160.12,
   "text": "ایشون یه تمثی-تمثیلات زیبا و عالی ای دارن توصیه می‌کنم تمثیلات ایشون رو بخونید، کتاب هم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.12,
   "end": 163.02,
   "text": "یکی از تمثیلاتش در رابطه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.02,
   "end": 170.28,
   "text": "اینه که اِاِاِ یکی از کارهایی که باعث میشه انسان از حالت خشوع خارج بشه، ما بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.28,
   "end": 173.08,
   "text": "قلب خاشع رو داشتیم دیگه انتهای بحث هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.08,
   "end": 178.36,
   "text": "اینه که حرفی رو که نباید بزنه میزنه یا سهمیه ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.36,
   "end": 182.06,
   "text": "حالا من اون تمثیل رو هنوز نگفتما مقدمش بشینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.06,
   "end": 186.54,
   "text": "سهمیه ای که خدا براش قرار داده رو به دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.54,
   "end": 192.76,
   "text": "القا میده یا سری که خدا زر تو ظرف دل این قرار داده رو به دیگران افشا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.76,
   "end": 197.22,
   "text": "در هر حال چیزی که نباید بگه رو میگه، مخصوصا از کرامات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 197.22,
   "end": 199.72,
   "text": "اکتشافات درونیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.72,
   "end": 203.04,
   "text": "مسائل عرفانی و ذوقی که مخصوص خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.04,
   "end": 207.22,
   "text": "یا حتی یه عالمی یه ذکری داده برای خود ایشون میره همه جا جار میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.22,
   "end": 213.76,
   "text": "ف یه تمثیل زیبایی که ایشون دارن میفرماید دیدید خیلی قشنگ فرمودن دیدید بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 213.76,
   "end": 218.96,
   "text": "یه چیزی رو میخورن با وجودشون سازگاری نداره به هر دلیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 218.96,
   "end": 223.86,
   "text": "چی، چی میشه؟ این غذایی که خورد وقتی با وجودش سازگاری نداره چیکار میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 223.86,
   "end": 226.8,
   "text": "بالا میاره. اصطلاحا استفراغ میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 226.8,
   "end": 229.16,
   "text": "گلاب به روح همتون بالا میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 229.16,
   "end": 234.1,
   "text": "ایشون میفرماید آدم‌هایی که توده ای نیستن، ظرفیت ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 234.1,
   "end": 236.36,
   "text": "و سر نگهدار و راز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.36,
   "end": 238.72,
   "text": "نگهدار نیستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 238.72,
   "end": 241.3,
   "text": "خیلی راحت به باد میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.3,
   "end": 243.48,
   "text": "قلب خودشونو همینه وضعیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.48,
   "end": 251.08,
   "text": "چرا؟ بخاطر اینکه با وجودشون اون کاری که صورت گرفته سنخیت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.08,
   "end": 254.96,
   "text": "یه خواب خوب دیده از امام زمان از کربلا فلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.96,
   "end": 260.34,
   "text": "چون با وجودش سنخیت نداشته میریزش بیرون سریع میگه توتی صفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.34,
   "end": 267.66,
   "text": "خیلی نکته مهمیه‌ها. اما اگر کسی این با وجودش سنخیت داشته باشه، اصلا با خود ارتباط با امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 267.66,
   "end": 270.28,
   "text": "عصر هم برسه دم نمیزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.28,
   "end": 275.16,
   "text": "چون این کسی ظرفیت داره. سعه وجودیش بزرگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 275.16,
   "end": 278.04,
   "text": "کاسه‌ش بزرگه، زود لبریز نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.04,
   "end": 281.64,
   "text": "این نکته خیلی مهمه. بسیاری از خروج ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 281.64,
   "end": 284.78,
   "text": "از حالت خشوع قلب امتحان کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.78,
   "end": 289.1,
   "text": "به خاطر نگفت-- به خاطر گفتن حرف‌هاییه که جاش نیست، نباید بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.1,
   "end": 292.34,
   "text": "اصلا مال من بوده، نباید افشا می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.34,
   "end": 295.54,
   "text": "یکی از عزیزانی که اخیرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.54,
   "end": 297.9,
   "text": "با گفت‌وگو داشتیم تو بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.9,
   "end": 301.38,
   "text": "لذت بردن از نماز یه راهکاری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.38,
   "end": 305.92,
   "text": "ارائه داد، خیلی راهکار قشنگی بود در رابطه با لذت بردن از نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 305.92,
   "end": 307.84,
   "text": "من خیلی استفاده کردم واقعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.84,
   "end": 315.34,
   "text": "حالا یه روز براتون میگم. ایشون اشتباه کرد در میان ارائه این راهکار تجربه شخصی خودشم یه دفعه گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.34,
   "end": 318.92,
   "text": "گفت از وقتی من این کارو می‌کنم نمازهام خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.92,
   "end": 320.82,
   "text": "مثل نمازهای آقای بهجت یادته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.82,
   "end": 322.84,
   "text": "یه حالت اینطوری پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.84,
   "end": 325.44,
   "text": "تمام. ازش گرفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.44,
   "end": 331.64,
   "text": "و الان بدبخت به دست و پا داره می‌زنه یعنی افتاده به چه کنم، چه نکنم که رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.64,
   "end": 334.2,
   "text": "من با همون حرف، اون حالاتم رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.2,
   "end": 336.94,
   "text": "خب بابا این ماله راهکار ارائه دادن اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.94,
   "end": 341.54,
   "text": "اما اینکه بیای بگی منم از وقتی این میگیرم ازت تو نباید خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 341.54,
   "end": 344.24,
   "text": "چون سنخیته مثل آدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.24,
   "end": 348.72,
   "text": "وجودش دقیقا با این غذا سازگاری نداره لذا نمی‌تونه نگه داره میریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.72,
   "end": 351.52,
   "text": "مال تو نیست لذا میریزیش بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.52,
   "end": 357.9,
   "text": "باید به قدری ما عجین بشیم با معارف که در درون سنخیت پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.9,
   "end": 361.88,
   "text": "اون موقع است که قلبمون همیشه خاشعه، همیشه افتاده حاله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.88,
   "end": 363.6,
   "text": "و این آیه رو هم یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.6,
   "end": 366.8,
   "text": "من خواهش می‌کنم این گراه‌هایی که میدم بررسی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.8,
   "end": 370.14,
   "text": "آیه سی و نه سوره فصلت رو یه بارم توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.14,
   "end": 378.3,
   "text": "علامه جواد-جهاد امولی حفظه الله تعالی این آیه رو باز کرده بسیار زیبا برید بخونید میفرماید و من آیاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 378.3,
   "end": 381.1,
   "text": "انک ترى الارض خاشعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 381.1,
   "end": 387.34,
   "text": "تو زمین رو خاشع میبینی افتاده حال و پست و بی زبان و در سکوت میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.34,
   "end": 392.94,
   "text": "این که بود فإذا انزلنا عليها الماء اهتزت و ربَت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.94,
   "end": 396.22,
   "text": "چون سکوت داره، چون دم نمیزنه، چون تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.22,
   "end": 398.9,
   "text": "تو، تو خودش نگه داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.9,
   "end": 404.3,
   "text": "لذا ما آب ظرفیت پذیرش ما الهی رو داره میگیره و سرسبز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 404.3,
   "end": 407.38,
   "text": "اما اگه وقتی کسی بی ظرفیت شد چیزی هم بهش نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.38,
   "end": 411.08,
   "text": "انشاالله خدا ظرفیتمون زیاد کنه و عاقبتمون و ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.08,
   "end": 413.92,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.92,
   "end": 416.2,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.2,
   "end": 422.94,
   "text": "صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}