 },
 "chapters": [
  {
   "index": 0,
   "title": "## نافله پس از وقت؛ احتیاط واجب رهبری",
   "start": 11.92,
   "end": 126.28
  },
  {
   "index": 1,
   "title": "## آیهٔ حدید؛ عتاب خشوع دیرهنگام",
   "start": 126.28,
   "end": 260.0
  },
  {
   "index": 2,
   "title": "## زمین خاشعه؛ آب رحمت",
   "start": 260.0,
   "end": 414.99
  },
  {
   "index": 3,
   "title": "## استثنای فضیل و قاعدهٔ خشوع امام",
   "start": 414.99,
   "end": 650.03
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.8,
   "end": 5.26,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.26,
   "end": 8.62,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.62,
   "end": 11.92,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.92,
   "end": 16.7,
   "text": "از مقام معظم رهبری جانم به فداش استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.7,
   "end": 18.94,
   "text": "اگر چنانچه نافله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.94,
   "end": 24.84,
   "text": "نمازها رو بعد از نماز اونجایی که باید قبل بخونیم بعدا بخونیم در وقتش نخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.84,
   "end": 27.84,
   "text": "آیا اجازه‌ش رو داریم؟ چون یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.84,
   "end": 33.18,
   "text": "تو احادیث داریم یکی از چیزهایی که نماز رو ترمیم میکنه یعنی نماز واجب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.18,
   "end": 35.74,
   "text": "ترمیم میکنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.74,
   "end": 40.8,
   "text": "ااا عرض کنم حالا کثری‌هاشو جبران میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.8,
   "end": 43.44,
   "text": "هم نمازهای نافله است که خیلی هم مهمند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.44,
   "end": 51.34,
   "text": "حالا ما با توجه به نمازهای اداری و چه میدونم با سرعتی که میخونیم یا تو مساجد خیلی سریع بعضیا نمیرسن نافله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.34,
   "end": 58.38,
   "text": "سؤال شده که میشه این نافله رو خب ظهر رو باید قبل ظهر بخون-- قبل نماز ظهر بخون عصر رو قبل نماز عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.38,
   "end": 64.46,
   "text": "سؤال شده که میشه بعد از نماز ظهر و عصر این‌ها رو خوند نافله‌ها رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.46,
   "end": 72.62,
   "text": "آقا فرمودن که احوط این است وقتی که فتوا نداده یه دفعه فرموده احوط یعنی احتیاط کرده، این احتیاطش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.62,
   "end": 76.1,
   "text": "بدون فتوا احتیاط واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.1,
   "end": 79.44,
   "text": "یعنی میتونی به یه مجتهد دیگه رجوع کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.44,
   "end": 82.08,
   "text": "میتونی همین احتیاط آقا رو عمل کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.08,
   "end": 85.92,
   "text": "ایشون فتوا ندادن. فرمودن احتیاط این هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.92,
   "end": 88.5,
   "text": "اگر خوندی به نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.5,
   "end": 92.82,
   "text": "نه ادا نه قضا بخونی بلکه قربتا الی الله بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.82,
   "end": 97.44,
   "text": "یعنی نیتت نه قضا باید باشه قضای نافله، نه ادا نافله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.44,
   "end": 104.12,
   "text": "قربتا الی الله. حالا دوست داشتی میتونی رجوع کنی به حکم مراجع دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.12,
   "end": 109.62,
   "text": "ولی اگر فتوا میداد آقا بعد می‌فرمود احوط، احوط یعنی بنا به احتیاط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.62,
   "end": 113.36,
   "text": "بعد از فتوا می‌فرمود احوط این میشد احتیاط مستحب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.36,
   "end": 116.8,
   "text": "یا باید فتوای خود آقا رو عمل می‌کردیم یا احتیاطشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.8,
   "end": 121.84,
   "text": "اینجا چون بدون فتوا اح-احوط اومده یعنی بنا به احتیاط میشه احتیاط واجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.84,
   "end": 126.1,
   "text": "یا همین رو باید راض-- لحاظ کنی یا بری به مجتهد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.1,
   "end": 127.98,
   "text": "خب حالا شاید امروز آخرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.98,
   "end": 130.64,
   "text": "روزی باشه که ما پیرامون قلب خاشع صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.64,
   "end": 135.78,
   "text": "نکته‌ای که خیلی مهم هست از تاریخ درآوردم در ذیل آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.78,
   "end": 138.18,
   "text": "شانزده سوره حدید که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.18,
   "end": 143.72,
   "text": "\"الم یأن للذین آمنوا ان تخشع قلوبهم لذكر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.72,
   "end": 148.68,
   "text": "وما نزل من الحق\" که داستان‌های زیادی هم پیرامون این آیه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.68,
   "end": 151.3,
   "text": "ابن مسعود که از روات احادیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.3,
   "end": 153.82,
   "text": "شیعه هم هست میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.82,
   "end": 156.96,
   "text": "این آیه رو خدا آیه عطابشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.96,
   "end": 163.28,
   "text": "یعنی اگر دقت کنید بعد میگه ما چهار، من چهار سال بود که مسلمون شده بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.28,
   "end": 169.36,
   "text": "که انّ الله خدا با این آیه به ما عطاب کرد چون ابتدا میگه \"ای ایها الذین آمنوا\" کسی که ایمان آوردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.36,
   "end": 173.5,
   "text": "ان تخ-- میگه آیا وقت اون نرسیده که \"ان تخشع قلوبهم\"؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.5,
   "end": 177.62,
   "text": "خدا داره تشر میزنه که الان داره عطاب میکنه که آیا دیگه کی دیگه چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.62,
   "end": 181.56,
   "text": "ساله مثلا تو ابن مسعود در مورد خودش میگه چهار ساله تو مسلمون شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.56,
   "end": 185.44,
   "text": "هنوز قلبت خاشع نشده؟ از این بدتر ابن عباس میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.44,
   "end": 188.18,
   "text": "میگه پو-- این آیه حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.18,
   "end": 190.32,
   "text": "سال سیزده هجری ظاهرا نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.32,
   "end": 194.8,
   "text": "ابن عباس میگه سیزده سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.8,
   "end": 197.36,
   "text": "بعد از نزول آیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.36,
   "end": 200.06,
   "text": "خدا با این آیه‌ش عطاب کرده همه ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.06,
   "end": 202.52,
   "text": "دید که مسلمونا کندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.52,
   "end": 206.1,
   "text": "کلام خود ایشونه و عطاب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.1,
   "end": 210.0,
   "text": "تشر زد خدا که کی، کی میخواید دیگه خاشع بشید شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.0,
   "end": 212.28,
   "text": "در حقیقت این آیه، آیه‌ای که ما باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.28,
   "end": 216.32,
   "text": "خودمون رو باهاش عطاب کنیم، سرزنش کنیم که آقا بسه دیگه ریشات سفید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.32,
   "end": 218.96,
   "text": "چهل سال، پنجاه سال، سی سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 218.96,
   "end": 222.84,
   "text": "دیگه کی؟ این خشوع کی میخواد بیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.84,
   "end": 225.12,
   "text": "و تا خشوع نیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.12,
   "end": 227.54,
   "text": "اون زیبایی‌ها خودشو نشون نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.54,
   "end": 229.8,
   "text": "واقعا در دین ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.8,
   "end": 233.34,
   "text": "خشوع یعنی حالت شکستگی و افتاده حالی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.34,
   "end": 240.16,
   "text": "ضعف درون و ذلت درون که در درگاه خدا عظمت برای خدا قائل بشی و ذلت محض برای خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 240.16,
   "end": 245.54,
   "text": "و تا این حالت ایجاد نشه لذتی از عبادت حاصل نمیشه و در ارتباط با خدا انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.54,
   "end": 250.2,
   "text": "لذت نمی‌بره. وقتی لذت از عبادت نبرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.2,
   "end": 254.18,
   "text": "رفته رفته عبادتش کمرنگ میشه، بی حال میشه، بی‌توجه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.18,
   "end": 257.4,
   "text": "اصلا دیگه یواش یواش به سمت معاصی کشیده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.4,
   "end": 260.0,
   "text": "خیلی خطره. خطر بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.0,
   "end": 266.92,
   "text": "شما این آیه سی و نه فصلت رو دیدید می فرماید \"ومن آياته أنك ترى الأرض خاشعة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.92,
   "end": 269.82,
   "text": "خاشعة خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.82,
   "end": 272.7,
   "text": "میگه از نشانه‌های خدا اینه که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.7,
   "end": 274.88,
   "text": "زمین رو خاشعه می-- خاشعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.88,
   "end": 277.16,
   "text": "میبینی که این زمین افتاده حاله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 277.16,
   "end": 279.88,
   "text": "خشک برهوته، افتاده حاله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.88,
   "end": 283.4,
   "text": "خاشعة. تو اینو که دیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.4,
   "end": 285.92,
   "text": "\"فإذا\" فا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.92,
   "end": 292.06,
   "text": "پس هنگامی که \"أنزلنا\" حالا نوبت من خداست \"أنزلنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.06,
   "end": 295.76,
   "text": "عليه الماء\" اون موقع من آب میفرستم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.76,
   "end": 299.2,
   "text": "آب احیاگر \"اهتزت وربت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.2,
   "end": 302.06,
   "text": "که این به جنبش در میاد این خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.06,
   "end": 306.14,
   "text": "و آماسیده میشه، آماده میشه برای اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.14,
   "end": 309.1,
   "text": "گل‌ها و گیاهان و ثمرات مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.1,
   "end": 315.36,
   "text": "در حقیقت میگه افتادگی آموز اگر طالب فیضی هرگز نخورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.36,
   "end": 317.1,
   "text": "آب زمینی که بلند است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.1,
   "end": 323.76,
   "text": "یعنی زمین چون خاشعة چون پسته، چون افتاده حال شده خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.76,
   "end": 326.68,
   "text": "آب رحمتشو براش نازل میکنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.68,
   "end": 331.06,
   "text": "پیدایش نباتات و این‌ها درش ایجاد بشه و ثمرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.06,
   "end": 336.36,
   "text": "اگه کسی اون افتادگی رو نداشته باشه هرچی هم تو بیای آیات الهی رو براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.36,
   "end": 340.02,
   "text": "بخون، هرچی هم آب بریز فایده‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 340.02,
   "end": 344.8,
   "text": "بعد اون خاک-- ببین خیلی جالبه ها چقدر قشنگ این نکته تو این آیه اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.8,
   "end": 348.14,
   "text": "\"ومن آياته أنك ترى الأرض خاشعة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.14,
   "end": 353.56,
   "text": "أرض خاشعة این خشوع زمین، این افتادگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.56,
   "end": 359.22,
   "text": "که در زمین هست باعث میشه که به اون آب برسه و به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.22,
   "end": 367.69,
   "text": "اهتزت وربت. و اگه این در انسان هم حالا الحمد لله ما هم از خاک آفریده شدیم یعنی باید این حالت رو داشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.69,
   "end": 369.69,
   "text": "قیامت هم میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 369.69,
   "end": 371.85,
   "text": "محش-- وقتی که مردم محشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.85,
   "end": 374.85,
   "text": "می‌بینن صحنه محشر رو میگن یا لیتنی کنت ترابا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.85,
   "end": 379.01,
   "text": "ای کاش ما خاک بودیم. روایات متعددی زیر این آیه اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.01,
   "end": 384.07,
   "text": "این ای کاش ما خاک بودیم قبلاً گفتیم یعنی وقتی می‌بینن خدا با ابوتراب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 384.07,
   "end": 387.27,
   "text": "و شیعیانش چه میکنه با پدر خاک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 387.27,
   "end": 390.71,
   "text": "خاک نشین بودن، خاشع بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.71,
   "end": 395.55,
   "text": "بالا نشین نبودن، نگاه بالا به پایین نداشتن، خاشع بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.55,
   "end": 400.81,
   "text": "خب بعد اینها چه عزت و عظمتی خدا قیامت به این‌ها میده میگه یا لیتنی کنت ترابا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.81,
   "end": 403.73,
   "text": "ای کاش ما خاک بودیم که علی پدر خاک بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.73,
   "end": 407.25,
   "text": "یعنی پدر ما بود. دست ما رو هم خدا اینطوری می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.25,
   "end": 410.53,
   "text": "یعنی خاکی بودن خلاصه‌ش اینه که خاکی بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.53,
   "end": 414.99,
   "text": "خصوصاً در، در ارتباط با خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.99,
   "end": 418.33,
   "text": "ما متاسفانه میایم حالا داستان‌هایی که استثنائه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.33,
   "end": 426.11,
   "text": "پیرامون امثال این آیات رخ داده، اتفاق تاریخی رخ داده، این استثنائات رو گاهی اوقات توجه می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 426.11,
   "end": 429.85,
   "text": "و غیر استثنائات که بیشتر به درد ما می‌خوره رو توجه نک-نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.85,
   "end": 435.85,
   "text": "چطور؟ اینو خوب دقت کنید مخصوصاً اینایی که منبری هستن، سخنرانن تو این جمع مداحن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.85,
   "end": 442.29,
   "text": "خیلی توجه کنید مثلاً همیشه تا این آیه من از بچگی دیدم خونده میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.29,
   "end": 444.35,
   "text": "که ما داریم عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.35,
   "end": 452.39,
   "text": "معمولاً میرن سراغ فضیل ایاض که یه دزدی بود و فلان و اینا داستانشو می‌دونید مفصل انقدر گفتن بالا منبر و مداح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 452.39,
   "end": 455.95,
   "text": "که می‌رفت بالا یه پیرمردی دل شب این آیه رو می‌خوند دلش لرزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 455.95,
   "end": 459.05,
   "text": "داشت می‌رفت بالا از دیوار می‌رفت بالا دزدی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.05,
   "end": 464.51,
   "text": "دلش لرزید گفت آره وقتش شده، وقتش شده من خاشع-- بعد توبه کرد و از اولیاء خدا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 464.51,
   "end": 467.77,
   "text": "بعد ما با این حرف دست دزدامونو باز میذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.77,
   "end": 471.61,
   "text": "خب دیگه پس میشه تو هم دزد باشی، یه عمر جنایتکار باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.61,
   "end": 475.09,
   "text": "راه مردمو ببندی، اهل خلاف و فجور باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.09,
   "end": 480.25,
   "text": "خب بعد انشاالله یه روزی، یه نیمه شبی، یه آیه یکی می‌خونه تو دلت-- این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 480.25,
   "end": 482.43,
   "text": "این استثناء الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 482.43,
   "end": 485.85,
   "text": "یعنی کسی یه عمر جنایت کنه که چجوری مهر می‌خوره اصلاً به دلش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 485.85,
   "end": 489.59,
   "text": "حالا این یه دونه استثناء تو تاریخ پیش اومده، دو تا پیش اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 489.59,
   "end": 492.27,
   "text": "قرار نیست ما دنبال این استثنائات باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.27,
   "end": 495.41,
   "text": "چرا نمیایم بگیم امام معصوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.41,
   "end": 499.27,
   "text": "ازش سؤال کردن آقا شما کی می‌فهمی، چجوری می‌فهمی امام شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 499.27,
   "end": 503.53,
   "text": "کی امام شدی؟ خب حضرت سجاد تو خیمه بود امام حسین تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 503.53,
   "end": 505.19,
   "text": "گودی قتلگاه شهید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 505.19,
   "end": 510.31,
   "text": "امام سجاد لحظه‌ای که امامت بر دوشش قرار گرفت چجوری متوجه شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 510.31,
   "end": 514.17,
   "text": "امام جواد مدینه بود. امام رضا خراسان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 514.17,
   "end": 516.91,
   "text": "بحث طی الارض و این‌ها به کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.91,
   "end": 521.65,
   "text": "اما کی متوجه شد؟ خیلی جواب امام صادق غوغاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.65,
   "end": 528.87,
   "text": "می‌فرماید وقتی می‌فهمیم امام شدیم که یک خشوعی در قلب ما ایجاد میشه، یک انکسار و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 528.87,
   "end": 534.01,
   "text": "ذلتی در برابر عظمت خدای منان که پیش از این نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 534.01,
   "end": 537.43,
   "text": "احساس خاری و ذلت محض در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 537.43,
   "end": 542.31,
   "text": "عظمت الهی. ببینید این یعنی شروع امامتش با خشوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 542.31,
   "end": 545.39,
   "text": "والله کاری نداره خدا با کسی که خشوع نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 545.39,
   "end": 548.63,
   "text": "شروع امامتش با خشوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 548.63,
   "end": 552.69,
   "text": "علیرغم این م-مجالس توديع معارفه که میاریم یکیو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 552.69,
   "end": 559.01,
   "text": "مثلاً مدیرکلش کنیم چه می‌دونم شروع می‌کنیم از عظمتش، از جایگاهش، از سوابقش، از رزومه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 559.01,
   "end": 562.65,
   "text": "اونم بادی به غبغب میندازه و بله دیگه ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 562.65,
   "end": 568.25,
   "text": "درصورتی‌که امام وقتی می‌خواد منصب و جایگاه امامت بگیره، خدا می‌شکونش از درون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 568.25,
   "end": 570.61,
   "text": "حواست باشه هیچی نیستی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 570.61,
   "end": 574.33,
   "text": "هرچی هست خداست. لا حول ولا قوه الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 574.33,
   "end": 576.93,
   "text": "هرچی بیشتر اینو درک کنه جایگاهش میره بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 576.93,
   "end": 579.23,
   "text": "این خیلی نکته مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 579.23,
   "end": 584.69,
   "text": "چرا اینا رو توجه نمی‌کنیم؟ چرا اینو توجه نمی‌کنیم که همین امامی که ما پشت سرش راه افتادیم انقلاب کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 584.69,
   "end": 586.63,
   "text": "خودمون رو بسیجیش می‌دونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 586.63,
   "end": 589.03,
   "text": "حاج آقا احمد می‌گفت شب‌ها دیگه روز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 589.03,
   "end": 592.65,
   "text": "سال‌های آخر عمر امام دیگه دستمال کفاف نمی‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.65,
   "end": 596.55,
   "text": "حوله می‌دادیم که اشکشو پاک کنه، حوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 596.55,
   "end": 599.97,
   "text": "چرا اینا رو ما توجه نمی‌کنیم که هر شب برای امام--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 599.97,
   "end": 602.45,
   "text": "دیگه شب‌هایی که عملیات بود می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.45,
   "end": 604.93,
   "text": "فرش رو می‌داد کنار صورت به خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 604.93,
   "end": 610.25,
   "text": "حجره‌اش می‌ذاشت امام. زار می‌زد شب تا صبح که خدایا رزمنده‌ها رو کمک کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 610.25,
   "end": 615.35,
   "text": "اینا رو ما چرا نشنویم؟ بیایم حالا یه فضیل ایاض از دیوار رفته بالا اونم دزدی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 615.35,
   "end": 622.61,
   "text": "یهو یه دفعه دلش شکست و از اولیاء خدا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 622.61,
   "end": 627.79,
   "text": "پس ما منتظر باشیم یه روزی یه پیرمرد صاحب نفسی یه نفسی بزنه ما دلمون...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 627.79,
   "end": 632.33,
   "text": "این حرفا چیه؟ اینا استثناءته بزن کنار اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 632.33,
   "end": 637.39,
   "text": "حقیقتو ببین. امام ما وقتی به شدت می‌شکنه امام میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.39,
   "end": 640.53,
   "text": "این‌ها رو نگاه کنید. خیلی نکته مهمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 640.53,
   "end": 645.55,
   "text": "انشاالله که عاقبتمون ختم بخیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 645.55,
   "end": 650.03,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}