 "chapters": [
  {
   "index": 0,
   "title": "## نماز مستحبی و قبله به فتوای رهبری",
   "start": 12.46,
   "end": 32.48
  },
  {
   "index": 1,
   "title": "بحث قلب خاشع بود. نکته‌ای بسیار مهم که جا مانده بود: اگر آیهٔ",
   "start": 32.48,
   "end": 161.82
  },
  {
   "index": 2,
   "title": "## تمثیل جنین و مراقبت از ایمان",
   "start": 161.82,
   "end": 220.86
  },
  {
   "index": 3,
   "title": "## کرم الله وجهه و رضی الله عنه",
   "start": 220.86,
   "end": 307.42
  },
  {
   "index": 4,
   "title": "## سم‌پاشی علیه ابوطالب",
   "start": 307.42,
   "end": 342.6
  },
  {
   "index": 5,
   "title": "## بسیج بنی‌هاشم و شعب ابی‌طالب",
   "start": 342.6,
   "end": 553.02
  },
  {
   "index": 6,
   "title": "## خروجی ایمان خشوع است",
   "start": 553.02,
   "end": 580.02
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.72,
   "end": 5.26,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.26,
   "end": 8.6,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.6,
   "end": 12.46,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.46,
   "end": 17.62,
   "text": "از مقام معظم رهبری جانم به فداش استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.62,
   "end": 20.78,
   "text": "در نماز مستحبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.78,
   "end": 23.76,
   "text": "در سه حالت، در حال حرکت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.76,
   "end": 27.64,
   "text": "در سواره بودن یعنی سوار مرکب بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.64,
   "end": 29.68,
   "text": "و در حالت استقرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.68,
   "end": 37.32,
   "text": "در این سه حالت، در هر سه حالتش هم میشه انسان جهت قبله رو رعایت نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.32,
   "end": 42.18,
   "text": "و رکوع و سجود رو با ایماء و اشاره انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.18,
   "end": 47.28,
   "text": "مقام معظم، ما معمولا اینطوری شنیدیم که در هر وضعیتی میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.28,
   "end": 50.34,
   "text": "انسان با ایماء و اشاره و رکوع و سجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.34,
   "end": 52.7,
   "text": "انجام بده و جهت قبله رو هم رعایت نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.7,
   "end": 58.72,
   "text": "لکن مقام معظم رهبری در جواب این استفتاء فرمودن که در صورتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.72,
   "end": 67.18,
   "text": "سواره باشه یا در حال راه رفتن و حرکت باشه، در این دو صورت اشکال نداره که انسان جهت قبله رو رعایت نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.18,
   "end": 69.42,
   "text": "و رکوع و سجود رو با اشاره بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.42,
   "end": 73.78,
   "text": "اما اگر مستقره یعنی یه جایی استقرار داره نشسته، یه جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.78,
   "end": 81.04,
   "text": "هست که در حال حرکت نیست یا سواره نیست حتما باید جهت قبله رعایت بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.04,
   "end": 84.34,
   "text": "و رکوع و سجود هم تمام انجام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.34,
   "end": 88.74,
   "text": "اینو حواسمون باشه. حالا نشسته اشکال نداره انسان وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.74,
   "end": 92.08,
   "text": "مستقر هم هست نماز مستحبی رو میتونه نشسته هم بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.08,
   "end": 94.38,
   "text": "اما جهت قبله باید رعایت شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.38,
   "end": 97.06,
   "text": "رکوع و سجود هم باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.06,
   "end": 102.08,
   "text": "تمام انجام شه. این البته نظر رهبری است و فتوا هم هست، احتیاط نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.08,
   "end": 105.74,
   "text": "خب بحث ما قلب خاشع بود. نکته‌ای هم امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.74,
   "end": 109.64,
   "text": "که بسیار بسیار این نکته مهمه و جا مونده بود عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.64,
   "end": 116.34,
   "text": "که اگر شما آیه همون آیه‌ای که چند روز درباره‌ش بحث کردیم \"أَلَمْ يَأْنِ لِلَّذِينَ آمَنُوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.34,
   "end": 124.1,
   "text": "أَن تَخْشَعَ قُلُوبُهُمْ لِذِكْرِ اللَّهِ\" رو خودتون دقت کنید، متوجه میشید که مقدمه خشوع چی اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.1,
   "end": 131.7,
   "text": "ایمان. این عطاء خدا که ابن عباس می‌گفت، ابن مسعود می‌گفت اینا عطاء خدا بوده به کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.7,
   "end": 140.54,
   "text": "به اهل ایمان. یعنی اصلاً کأنهم محال کسی ایمان تو قلبش تثبیت بشه و به خشوع نیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.54,
   "end": 146.56,
   "text": "همچنین محال کسی خشوع نداشته باشه و ایمان تو وجودش تثبیت شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.56,
   "end": 150.5,
   "text": "اگر کسی حالا خشوع رو ما قبلاً تعریف کردیم دیگه، اگر کسی خشوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 150.5,
   "end": 156.7,
   "text": "قلبی در وجودش نیست باید بترسه از اینکه ایمانش تثبیت نشده و متزلزله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 156.7,
   "end": 160.3,
   "text": "این خطر بزرگیه و ایمان هم بسیار مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 160.3,
   "end": 162.84,
   "text": "مثلاً اگه ایمان نداشته باشیم به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.84,
   "end": 165.72,
   "text": "حضرت آیت الله عراقی شیرازی یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.72,
   "end": 169.32,
   "text": "تمثیلی دارن خیلی زیبا پیرامون اهمیت ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.32,
   "end": 177.22,
   "text": "میگن باید شما ایمانتون رو به نحوی باهاش رفتار کنید مثل یک زن باردار نسبت به جنین در رحمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 177.22,
   "end": 185.58,
   "text": "چطوری یه زن باردار خیلی محتاطه، هر کاری رو نمیکنه، هر بار سنگینی برنمیداره، زیاد راه نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 185.58,
   "end": 189.8,
   "text": "خیلی محتاطانه عمل میکنه به خاطر اینکه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 189.8,
   "end": 191.98,
   "text": "س-- این جنینی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 191.98,
   "end": 194.4,
   "text": "رحم داره سقط نشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 194.4,
   "end": 198.44,
   "text": "ساقط نشه. شما هم میگه که باید خیلی مراقب باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 198.44,
   "end": 201.96,
   "text": "ایمان‌تون مثل اون جنینی است که در وجود شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.96,
   "end": 204.76,
   "text": "مستقر شده باید حفظش کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.76,
   "end": 209.1,
   "text": "و هر کاری هر باری رو برندارید، هر کاری رو نکنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 209.1,
   "end": 217.88,
   "text": "هر جایی نرید که سبب بشه ایمان-- اگر ایمان ساقط شد قطعاً خشوع دیگه وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 217.88,
   "end": 220.18,
   "text": "و اگه ایمان متزلزل بشه این خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 220.18,
   "end": 224.66,
   "text": "شما هیچ‌وقت فکر کردید که چرا در منابع اهل تسنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 224.66,
   "end": 228.6,
   "text": "البته بیشتر تو علما و زعماى پیشین‌شون، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.6,
   "end": 231.5,
   "text": "جدیداشون نیست خیلی، هست اما کمتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 231.5,
   "end": 235.42,
   "text": "پیشینی‌هاشون همشون اینطوری بودن، مخصوصا بزرگانشون که بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 235.42,
   "end": 238.16,
   "text": "علما اهل تسنن وقتی به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 238.16,
   "end": 241.76,
   "text": "خلفا به غیر علی علیه الصلاة والسلام می‌رسیدند یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.76,
   "end": 244.72,
   "text": "تو منابع‌شون دقت کنید چی می‌نویسن بعد از اسم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.72,
   "end": 247.36,
   "text": "می‌نویسن رضي الله عنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.36,
   "end": 251.96,
   "text": "اما وقتی به نام علی علیه الصلاة والسلام می‌رسن می‌نویسن کرم الله وجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.96,
   "end": 256.84,
   "text": "چرا؟ برای خود من سؤال بود و از یکی از محققین شنیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.84,
   "end": 263.1,
   "text": "فرمودن که نظر خود علمای اهل تسنن و اون علمای پیشین و کبارشون اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 263.1,
   "end": 265.62,
   "text": "که به جهت اینکه در سابقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.62,
   "end": 270.5,
   "text": "همه خلفای اون‌ها بت پرستی وجود داشته، عدم ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.5,
   "end": 274.5,
   "text": "وجود داشته. لذا میگن رضي الله عنه یعنی خدا ازش راضی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 274.5,
   "end": 276.58,
   "text": "یه زمانی بت پرستی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.58,
   "end": 280.34,
   "text": "اما تنها کسی که در میان خلفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.34,
   "end": 283.4,
   "text": "علی علیه الصلاة والسلام هست که تنها کسی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.4,
   "end": 286.34,
   "text": "در سابقه و پیشینه او چی وجود نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.34,
   "end": 289.0,
   "text": "بت پرستی یعنی ایمان محض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.0,
   "end": 292.76,
   "text": "ایمان انقدر اهمیت داره که اون‌ها هم به اهمیتش پی می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 292.76,
   "end": 297.0,
   "text": "لذا نام علی علیه الصلاة والسلام رو که میارن میگن کرم الله وجهه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.0,
   "end": 299.86,
   "text": "خدا وجهش رو گرامی‌تر بدارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 299.86,
   "end": 301.72,
   "text": "یعنی مثلاً مقامش رو بالاتر ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 301.72,
   "end": 306.26,
   "text": "او سابقه بی‌ایمانی نداشته، از بچگی اهل ایمان بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 306.26,
   "end": 310.88,
   "text": "هیچ-- اصلاً یکی از دلایل اینا حالا رسیدیم به اینجا خیلی خوبه شماها اینو بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.88,
   "end": 317.44,
   "text": "مخصوصاً این‌هایی که اهل سخنوری و تریبون در اختیارشونه، قلم به دستند یا اهل پژوهش‌اند اینا رو بدونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 317.44,
   "end": 320.66,
   "text": "نکات خیلی مهمیه. یکی از دلایلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.66,
   "end": 322.38,
   "text": "چرا اینقدر به عبد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.38,
   "end": 331.08,
   "text": "ابو طالب، حضرت ابی طالب، پدر امیرالمؤمنین گیر میدن تو تاریخ و انقدر بر علیه ایشون سم پاشی تاریخی می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.08,
   "end": 335.8,
   "text": "برای همینه که زورشون به علی علیه الصلاة والسلام نرسیده که سابقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 335.8,
   "end": 339.54,
   "text": "بت پرستی براش گیر بیارن، گیر میدن به پدر ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 339.54,
   "end": 341.88,
   "text": "که میگن نه پدر ایشون بت پرست بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.88,
   "end": 345.62,
   "text": "توجه کردید چرا به عباس ابن عبدالمطلب گیر نمیدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.62,
   "end": 350.94,
   "text": "عباس عموی پیغمبر روایاتی داریم متأسفانه که ایشون حتی در جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 350.94,
   "end": 355.9,
   "text": "بدر در صف مشرکین بوده یعنی مقابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 355.9,
   "end": 359.26,
   "text": "حضرت رسول بوده. در فتح مکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 359.26,
   "end": 362.8,
   "text": "ایشون مش-- هنوز بت پرست بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.8,
   "end": 365.44,
   "text": "یه روایاتی ما داریم عباس ابن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 365.44,
   "end": 367.02,
   "text": "از-- چیزی که در بقیع دفنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.02,
   "end": 370.9,
   "text": "البته ما معتقدیم که ایشون موحد شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.9,
   "end": 373.92,
   "text": "اما سابقه اینطوری داره. چرا به ایشون هیچی نمیگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.92,
   "end": 377.88,
   "text": "چرا به نظر شما؟ چون پسرش علی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.88,
   "end": 381.02,
   "text": "چون پسر ابی طالب علیس میخوان علی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 381.02,
   "end": 382.72,
   "text": "به نوعی تخریب کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 382.72,
   "end": 385.08,
   "text": "زورشون نمیرسه گیر میدن به پدر ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 385.08,
   "end": 388.56,
   "text": "اگرچه ما در خصوص پدر ایشون منابع زیادی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.56,
   "end": 391.58,
   "text": "که ایشون هم موحد بودن، با ایمان بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.58,
   "end": 393.18,
   "text": "یه برهه ای تقیه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.18,
   "end": 396.04,
   "text": "اصلاً یه دیوانی وجود داره به نام دیوان ابی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.04,
   "end": 399.66,
   "text": "ابی ط-- علی-- عذر میخوام ابا-- اِاَاَ ابی طالب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.66,
   "end": 402.76,
   "text": "دیوان ابی طالب. این دیوان رو بگیرید اگر عربیتون خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.76,
   "end": 409.0,
   "text": "متأسفانه فارسیشو من ندیدم. اشعاری که حضرت ابی طالب علیه السلام پدر امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.0,
   "end": 412.0,
   "text": "در رابطه با ایمان، در رابطه با پیغمبر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.0,
   "end": 419.0,
   "text": "اشعاری که در رابطه با پیغمبر حالا اگه اشتباه نکنم عربیشو مثلاً و نامه ای که مینویسه به پادشاه حبشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.0,
   "end": 422.68,
   "text": "رو نصيحت کنه مینویسه \"تعلم\" به پادشاه حبشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.68,
   "end": 427.92,
   "text": "میگه بدان \"ان محمداً صلّی الله علیه و آله و sel\" اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 427.92,
   "end": 430.18,
   "text": "صل علی محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.18,
   "end": 439.32,
   "text": "عیسی و موسی. اون هم مثل عیسی و موسی صاحب دین و شریعت است و لازمه که بهش ایمان بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.32,
   "end": 441.98,
   "text": "به اون تو ما-- تو شعر عربیش میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.98,
   "end": 444.34,
   "text": "یا اینکه مثلاً میگن چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.34,
   "end": 448.32,
   "text": "ایشون اِاَاَ بنی هاشم رو جمع کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.32,
   "end": 451.12,
   "text": "اصلاً ابی طالب این رو هم خوبه بدونید حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.12,
   "end": 453.9,
   "text": "ابی طالب وقتی اومدن بهش گفتن پسر برادرت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 453.9,
   "end": 460.2,
   "text": "جمع کن و الا میکشیمش که اون جمله معروفو پیغمبر فرمود اگه خورشید رو در دست راستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 460.2,
   "end": 464.76,
   "text": "ماه رو در چپ، دست چپم قرار بدین، من دست از دعوت برنمی‌دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 464.76,
   "end": 466.66,
   "text": "دیگه حضرت ابی طالب اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.66,
   "end": 472.56,
   "text": "وقتی متوجه شد چون ایمان هم آورده بود گفت پس منم دیگه پشتتم بنی هاشم رو بسیج کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 472.56,
   "end": 475.48,
   "text": "اینجا اعلام ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 475.48,
   "end": 477.5,
   "text": "ظاهراً نکرد حضرت ابی طالب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 477.5,
   "end": 481.9,
   "text": "به چه خاطر؟ به خاطر اینکه اون بحث قومیتی از بین نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.9,
   "end": 487.84,
   "text": "ی-یعنی اونا اگر حضرت ابی طالب متوجه میشدن که ایشون هم ایمان آورده مثل پیغمبر باهاش رفتار میکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 487.84,
   "end": 494.12,
   "text": "اما همون حالت قبیله‌ای رو نگه داشت که چون اینا بحث‌های قبیله‌ای داشتن می‌ترسیدن یه قبیله با قبیله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 494.12,
   "end": 495.64,
   "text": "بنی هاشم درگیر شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 495.64,
   "end": 498.1,
   "text": "به خصوص اینکه حضرت ابی طالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.1,
   "end": 505.94,
   "text": "بنی هاشم که حتی بعضیاشون هنوز بت پرست بودن رو به نفع پیغمبر بسیج کرد و حتی در شعب ابی طالب تو اون سه سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.94,
   "end": 508.82,
   "text": "یه عده بنی هاشم بودن که بت پرست بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 508.82,
   "end": 515.8,
   "text": "هنوز اونجا تو شعب بت پرست بودن اما به حرمت حضرت ابی طالب، پدر امیرالمؤمنین طرفداری پیغمبر رو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.8,
   "end": 521.32,
   "text": "لذا تو نامه ای که امیرالمؤمنین به معاویه بن ابد نوشت اینو قید کرده فرموده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.32,
   "end": 529.88,
   "text": "کجا بودی تو اون لحظه ای که تو شعب یه عده به خاطر اسلامشون پای پیغمبر وایسادن از بنی هاشم و عده قلیلی هم البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 529.88,
   "end": 532.22,
   "text": "به خاطر فامیلیشون با پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 532.22,
   "end": 541.04,
   "text": "یعنی این کارو ابی طالب کرد. اما برای اینکه اون، اونا هراس کنن از بحث قومیتی اگر متوجه میشدن همون ابتدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 541.04,
   "end": 545.0,
   "text": "که ایشون اسلام آورده عبدالمطلبم از روش رد میشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 545.0,
   "end": 551.74,
   "text": "اما مگه میشه ده سال ایشون بخواد مثلاً تقیه کنه در حالی که در سخت‌ترین شرایط با کی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 551.74,
   "end": 557.54,
   "text": "با پیغمبر بود. این اهمیت ایمان رو میرسونه که خروجی ایمان میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 557.54,
   "end": 560.86,
   "text": "خشوع. اگر کسی ایمانش رو مثل ر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 560.86,
   "end": 565.7,
   "text": "بچه در رحم مراقبت نکنه، خشوع قلبشو از دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 565.7,
   "end": 569.9,
   "text": "نماز بهش حال نمیده، ذکر خدا بهش حال نمیده و این خطر عظیمی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 569.9,
   "end": 571.72,
   "text": "انشاالله عاقبتمون خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 571.72,
   "end": 574.9,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 574.9,
   "end": 580.02,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}