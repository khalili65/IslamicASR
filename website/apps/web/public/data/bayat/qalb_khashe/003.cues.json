 },
 "chapters": [
  {
   "index": 0,
   "title": "## نافلهٔ نشسته و تمام ثواب",
   "start": 11.94,
   "end": 94.14
  },
  {
   "index": 1,
   "title": "بحث قلب خاشع بود. در خصوص قلوب سخن می‌گفتیم. سومین قلب قرآن قلب خاشع بود. جمله‌ای ذیل آیۀ صدوهشت طه از مفسران شیعه:",
   "start": 94.14,
   "end": 141.24
  },
  {
   "index": 2,
   "title": "## ربیع ابن خثیم؛ غش از آتش کوره",
   "start": 141.24,
   "end": 281.22
  },
  {
   "index": 3,
   "title": "## خشوع در نماز؛ اولین نشانۀ رستگاری",
   "start": 281.22,
   "end": 343.36
  },
  {
   "index": 4,
   "title": "## سید هاشم و پیرمرد روستایی؛ محک نماز",
   "start": 343.36,
   "end": 508.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 4.08,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.08,
   "end": 8.06,
   "text": "السلام علیک یا داعی الله و ربانی ایه آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.06,
   "end": 11.26,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.26,
   "end": 15.3,
   "text": "خب میدونید که نماز مستحبی رو میشه نشسته هم خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.3,
   "end": 19.6,
   "text": "بعضیا خب میگن حالا که میشه نشسته خوند خب ما هم نشسته میخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.6,
   "end": 22.68,
   "text": "توجه ندارن که همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.68,
   "end": 25.8,
   "text": "طور که نماز نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.8,
   "end": 28.56,
   "text": "اجازش هست اما همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.56,
   "end": 35.68,
   "text": "ثواب رو نداره. یعنی وقتی شما میشینی تمام مراجع گفتن ثوابش نصف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.68,
   "end": 42.86,
   "text": "حالا اگه کسی بخواد به همه نماز ثواب نماز مستحبی نشسته که میخونه برسه چه باید بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.86,
   "end": 48.66,
   "text": "از رهبری استفتاء کردن فرموده که دو بار باید بخ-- دو بار نشسته بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.66,
   "end": 52.2,
   "text": "مثلا نافله رو میخواد بخونه، میخواد نشسته بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.2,
   "end": 54.7,
   "text": "اما میخواد تمام ثواب رو ببره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.7,
   "end": 57.7,
   "text": "دو تا دو رکعتی نشسته باید بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.7,
   "end": 59.96,
   "text": "تا تمام ثواب رو ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.96,
   "end": 66.5,
   "text": "اما اگر یک بار دو رکعت نشسته بخونه نصف ثواب رو برده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.5,
   "end": 68.58,
   "text": "خب بحث ما قلب خاشع بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.58,
   "end": 70.38,
   "text": "در خصوص قلوب صحبت می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.38,
   "end": 74.36,
   "text": "سومین قلب قرآن قلب خاشع بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.36,
   "end": 79.18,
   "text": "و یک جمله‌ای رو ذیل آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.18,
   "end": 82.78,
   "text": "صد و هشت طه ها براتون عرض کنم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.78,
   "end": 86.14,
   "text": "مفسرین، مفسرین شیعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.14,
   "end": 94.14,
   "text": "خب س-- آیه صد و هشت طه می فرماید و خشعت الأصوات للرحمن و خشعت الأصوات للرحمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.14,
   "end": 96.92,
   "text": "یعنی اینکه همه صداها برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.92,
   "end": 99.0,
   "text": "خدای رحمان فروکش می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.0,
   "end": 106.36,
   "text": "خشعت الأصوات. ذیل این آیه مفسرین یه جمله خیلی جالبی آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.36,
   "end": 115.3,
   "text": "اینو دقت کنید در خصوص معنای خشوع فرمودن خشوع به معنای تاثیر خاصی است که به افراد مقهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.3,
   "end": 118.06,
   "text": "دست می‌دهد. افرادی که در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.06,
   "end": 126.54,
   "text": "سلطانی قاهر قرار گرفته‌اند به طوری که تمام توجه آنان معطوف او گشته و از جاهای دیگر قطع می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.54,
   "end": 129.42,
   "text": "به این میگن معنای خشوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.42,
   "end": 134.56,
   "text": "خشوع قلب پس میشه قطع از همه جا و توجه کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.56,
   "end": 137.7,
   "text": "به خدای متعال در هر حالتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.7,
   "end": 141.24,
   "text": "البته در نماز اوج اونه اما در هر حالتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.24,
   "end": 144.5,
   "text": "مثلا ربیع ابن خثیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.5,
   "end": 147.02,
   "text": "یکی از صحابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.02,
   "end": 149.64,
   "text": "زمان پیغمبر بود که ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.64,
   "end": 156.62,
   "text": "میگن که خیلی اهل مراقبه بود و خیلی مرا-- مواظب بود و قلب خاشعی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.62,
   "end": 160.28,
   "text": "به گونه‌ای که همیشه سرش پایین بود از ترس خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.28,
   "end": 163.78,
   "text": "ما داریم بعضی از بزرگانمون حتی معاصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.78,
   "end": 167.38,
   "text": "که هیچکس ندید این‌ها آسمونو نگاه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.38,
   "end": 171.88,
   "text": "شما کتاب المراقبات امیر جواد آقا ملکی تبریزی رو حتما خوندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.88,
   "end": 175.98,
   "text": "حالات بسیاری از عرفا رو اونجا اینچنین نقل می‌کنه که آدم باعث تعجبشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.98,
   "end": 178.1,
   "text": "حداقل یه بار اینا رو آدم بخونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.1,
   "end": 183.58,
   "text": "به گوشش بخوره. گمان نکنه اگه یه وقت یه حال خوشی بهش دست داد کوه کنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.58,
   "end": 191.08,
   "text": "کسایی که هیچوقت تو آینه صورتشونو با دقت نگاه نمی‌کردن، می‌ترسیدن نکنه سیاه شده باشن و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.08,
   "end": 199.38,
   "text": "یه گوشه دنیا زلزله می‌اومد گریه می‌کردن شب تا صبح می‌گفتن به خاطر گناه من و واقعا نه که الکی حس بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.38,
   "end": 203.88,
   "text": "اینطور بوده. تو اون کتاب اینها می-- حالا ربیع ابن خثیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.88,
   "end": 208.12,
   "text": "از جمله این‌ها بوده به طوری که اصلا می‌گفتن این شاید نابینا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.12,
   "end": 213.24,
   "text": "اینقدر سر به زیر و جلو پاشو نگاه می‌کرد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.24,
   "end": 215.06,
   "text": "به کسی نگاه نمی‌کرد و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.06,
   "end": 219.82,
   "text": "ابن مسعود میگه من یه روز با ایشون رفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.82,
   "end": 221.62,
   "text": "، تو بازار، بازار آهنگرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.62,
   "end": 224.28,
   "text": "اونجا کوره روشن بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.28,
   "end": 226.98,
   "text": "آهنگرا خب یه کوره ای دارن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.98,
   "end": 230.52,
   "text": "آهن میذارن توش تفتیده بشه، نرم شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.52,
   "end": 232.98,
   "text": "تا این چشمش افتاد به آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.98,
   "end": 240.16,
   "text": "کوره یه سیهه‌ای زد، برق از چشماش پرید و سیه زد و افتاد غش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.16,
   "end": 244.02,
   "text": "از خوف خدا و یاد آتش جهنم افتاده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.02,
   "end": 249.16,
   "text": "غش کرد. میگه من بر-- هرچی نشستم کنارش دم اذان شد دیدم به هوش نیومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.16,
   "end": 252.96,
   "text": "ورداشتم بردمش خونه. بیست و چهار ساعت ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.96,
   "end": 255.2,
   "text": "در حالت غش بود. بیهوش شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.2,
   "end": 258.08,
   "text": "بیست و چهار ساعت از خوف خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.08,
   "end": 260.92,
   "text": "پنج وعده نمازاش قضا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 260.92,
   "end": 266.86,
   "text": "وقتی به هوش اومد قضا خوند. بعد می‌گفتش که بهش-- ابن مسعود میگن بهش می‌گفتم اگه تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.86,
   "end": 268.78,
   "text": "پیغمبر تو رو ببینه عاش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.78,
   "end": 271.4,
   "text": "با تو دوست میشه یا با تو دوست میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.4,
   "end": 273.38,
   "text": "ظاهرا بعد از پیغمبرشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.38,
   "end": 278.46,
   "text": "صحابی اواخر عمر پیغمبر و امیرالمؤمنین بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.46,
   "end": 281.92,
   "text": ". در هر حال بودن کسایی که اینجوری اما این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.92,
   "end": 284.3,
   "text": "اوجش رو البته در نماز نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.3,
   "end": 287.32,
   "text": "شما آیه یک و دو سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.32,
   "end": 290.34,
   "text": "مؤمنون رو بخونید. قد أفلح المؤمنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.34,
   "end": 293.62,
   "text": "الذين هم في صلاتهم خاشعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.62,
   "end": 299.16,
   "text": "اولین صفت که بر مؤمنون می‌شه مال خ-خشوعه در نمازشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.16,
   "end": 301.36,
   "text": "که ما توضیح دادیم دیروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.36,
   "end": 303.82,
   "text": "خب باید ببینیم تو نماز چه حالتی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 303.82,
   "end": 306.38,
   "text": "دیگه این اوجشه در نماز دیگه اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 306.38,
   "end": 310.24,
   "text": "کسی در نماز حالت خشوع نداشته باشه، اون حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.24,
   "end": 315.8,
   "text": "مقهوریت در برابر خدای قهار رو نداشته باشه خیلی خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.8,
   "end": 321.1,
   "text": "یعنی زنگ خطر بزرگیه. اگه کسی دیگه نمازشم بخواد خشوع نداشته باشه خیلی خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.1,
   "end": 327.58,
   "text": "خیلیا یعنی قلب مریض شده باید بره به سمت مداوای قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 327.58,
   "end": 330.32,
   "text": ". و این چیزی بوده که بزرگان مراقبت می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.32,
   "end": 333.6,
   "text": "اگه یه نمازشون مشکل پیدا می‌کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.6,
   "end": 335.3,
   "text": "شب تا صبح اون شب نمی‌خوابیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.3,
   "end": 337.06,
   "text": "چی شد که بعد نمازم اینطوری شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.06,
   "end": 343.36,
   "text": "امروز حال نداشتم، توجه نداش-- این محکیه دیگه دیروز عرض کردیم خدا گذاشته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.36,
   "end": 348.46,
   "text": "خدا رحمت کنه سید هاشم نامی که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.46,
   "end": 352.08,
   "text": "اه کنیه‌شون یا فامیلیشون یادم نیست از علما بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.08,
   "end": 358.92,
   "text": "در مسجد نماز می‌خوندن. در حالاتش نقل می‌کنند که خب نمازهای خوبی می‌خوند اما یه روز غافل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.92,
   "end": 364.26,
   "text": "یه روز. و خدا همون موقع پس گردنی بهش زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.26,
   "end": 367.54,
   "text": "مثل من نیست که همه نمازاش همینطوری بره هیچ خبری هم نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.54,
   "end": 372.8,
   "text": "یکی از-- وقتی اولیای خداییه خطایی ازشون سر بزنه سریع خدا حالیشون میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 372.8,
   "end": 377.28,
   "text": "چی شد؟ همه دیدن که سید هاشم مشغول نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.28,
   "end": 382.42,
   "text": "اقامه میگه. یه پیرمرد دهاتی اومد صاف اومد پشت سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.42,
   "end": 385.18,
   "text": "سید هاشم بهش افتدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.18,
   "end": 390.82,
   "text": "پشت سر امام جماعت وایساد. قیافه خیلی در و داغون و خاک آلود و همه چپ چپ نگاش می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.82,
   "end": 393.16,
   "text": "بعضی مساجد هم اینجوری‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.16,
   "end": 396.62,
   "text": "عده‌ای که صف اول دوم‌ان انگار خریدن اینجا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.62,
   "end": 399.22,
   "text": "سر قفلیشونه. کسی حق نداره جاشون بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.22,
   "end": 406.76,
   "text": "یه چپ چپ نگاه کردن انگار مثلاً صف اول ما رو مثلاً فقط علما و اعاظم و مدیرکلا و چه می‌دونم ایناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.76,
   "end": 415.48,
   "text": "نه بر наоборот من. اومد هی چپ چپ نگاش کردن هیچی نماز و خوندن و آقا رکعت دوم نماز این آقای روستایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 415.48,
   "end": 421.98,
   "text": "نیت فراد-- فراده کرد نماز و تمام کرد و بعد یه بقچه باز کرد و شروع کرد نون خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.98,
   "end": 424.48,
   "text": "دیگه همه شاکی شدن شروع کردن داد و بیداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 424.48,
   "end": 426.12,
   "text": "این بعد از نماز این چه وضعشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.12,
   "end": 431.88,
   "text": "این چه کاره؟ آقا سید هاشم برگشت اون پیرمردو نگاه کرد، این آدم روستاییو گفت چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.88,
   "end": 434.62,
   "text": "چرا اینقدر سر و صدا می‌کنید؟ جریان رو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.62,
   "end": 439.7,
   "text": "آقا سید هاشم بهش گفت خب ت-- دلیلت چیه که نماز رو فراده کردی اینطوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.7,
   "end": 441.72,
   "text": "گفت اجازه بدید به خودتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.72,
   "end": 444.76,
   "text": "گفت نه، اینجا همه محرم‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 444.76,
   "end": 451.5,
   "text": "بگو اشکال نداره. اونم گفتش که راستش من به شما که افتدا کردم رکعت اول دیدم رفتی تو فکر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.5,
   "end": 458.0,
   "text": "داری میگی ya من دیگه پیر شدم می‌خوام بیام مسجد نمی‌تونم یا برم یه الاغ تهیه کنم با الاغ بیام مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.0,
   "end": 461.68,
   "text": "رکعت دوم دیدم داری فکر می‌کنی که خب این الاغو کجا بذارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.68,
   "end": 463.22,
   "text": "غذا چی براش تهیه کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 463.22,
   "end": 465.52,
   "text": "دیدم نه فایده نداره این نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 465.52,
   "end": 469.48,
   "text": "من نیت فراده کردم تموم کردم خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.48,
   "end": 475.74,
   "text": "بعد سید هاشم زد تو سر خودش و شروع کرد زار زار گریه کردن که عجب یه روز حالا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 475.74,
   "end": 479.26,
   "text": "قلبمون رفت. خدا هم چجوری پس گردوند ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 479.26,
   "end": 484.72,
   "text": "اینجوریه. آدم مثل من اگه رها باشه طرف که هیچی نمازش میشه نماز بازاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 484.72,
   "end": 489.7,
   "text": "اما اگه کسی مراقبت کنه نماز بهترین محکه برای خشوع قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 489.7,
   "end": 493.28,
   "text": "اگر می‌خوایم رستگار باشیم چاره‌ای جز خشوع نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.28,
   "end": 495.52,
   "text": "باید مراقبت کنیم از قلبمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 495.52,
   "end": 500.8,
   "text": "ان شا الله که عاقبتمون خیر شود به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 500.8,
   "end": 504.46,
   "text": "الله- الله صلي علي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 504.46,
   "end": 508.96,
   "text": "محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}