 "chapters": [
  {
   "index": 0,
   "title": "## تسهیل در نماز مستحب",
   "start": 13.6,
   "end": 79.52
  },
  {
   "index": 1,
   "title": "## سه سلام و ایوان طلا",
   "start": 79.52,
   "end": 136.3
  },
  {
   "index": 2,
   "title": "## میلاد عبدالعظیم و پیام امام رضا",
   "start": 136.3,
   "end": 156.52
  },
  {
   "index": 3,
   "title": "## خشوع و آیهٔ استعانت",
   "start": 156.52,
   "end": 207.4
  },
  {
   "index": 4,
   "title": "## تفصیل عهد امام رضا",
   "start": 207.4,
   "end": 671.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.98,
   "end": 4.1,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.1,
   "end": 12.72,
   "text": "السلام علیک یا داعی الله و ربانی ایاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.72,
   "end": 16.4,
   "text": "استفتاء شده از رهبر عزیزمون، جانم فدایش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.4,
   "end": 19.4,
   "text": "آیا در نمازهای مستحبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.4,
   "end": 23.98,
   "text": "میشه فقط حمد رو کفایت کرد دیگه سوره نخوند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.98,
   "end": 26.82,
   "text": "و آیا میشه در رکوع و سجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.82,
   "end": 29.28,
   "text": "یه دونه سبحان الله گفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.28,
   "end": 32.38,
   "text": "و آیا میشه قنوت نگرفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.38,
   "end": 38.64,
   "text": "و آیا میشه از سه تا سلام انتهای نماز فقط اون سلام آخر رو گفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.64,
   "end": 41.04,
   "text": "همه جواب‌ها آری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.04,
   "end": 44.68,
   "text": "میشه در نماز مستحبی این کارها رو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.68,
   "end": 47.64,
   "text": "اما توجه داشته باشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.64,
   "end": 53.3,
   "text": "رهبر تذکر دادن که ثوابش هم به همون مقدار کم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.3,
   "end": 62.16,
   "text": "شرعا یعنی شرع میگه اشکال نداره تو نماز مستحبی شما به جای سبحان ربی الاعلى و بحمده، یه سبحان الله بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.16,
   "end": 64.82,
   "text": "که تو نماز واجب حق نداری این کارو بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.82,
   "end": 66.76,
   "text": "اما همون مقدار ثوابش کم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.76,
   "end": 71.76,
   "text": "یادم نیست یکی از بزرگان فکر می‌کنم مرحوم آخوند رحمت الله علیه بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.76,
   "end": 74.86,
   "text": "عادت داشتن ایشون نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.86,
   "end": 79.14,
   "text": "که مخصوصا نمازهای مستحبی‌شونو سلام آخر رو میدادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.14,
   "end": 84.2,
   "text": "می‌دونید سلام آخر واجبه، دو تا سلام اول مستحبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.2,
   "end": 87.92,
   "text": "بعد همیشه می‌دیدن مردم از ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.92,
   "end": 94.44,
   "text": "حتی تو نمازهای جماعت‌شون برای اینکه کوتاه کنن نماز جماعتو سلام آخر رو فقط می‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.44,
   "end": 98.46,
   "text": "یه دفعه دیدن که ایشون روالش عوض شده دیگه سلام هر سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.46,
   "end": 100.68,
   "text": "تا سلامو دو مرتبه میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.68,
   "end": 104.3,
   "text": "ازشون سؤال کردن گفتن تو ایوان طلاى مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.3,
   "end": 107.96,
   "text": "مشغول نماز بودم وقتی که سلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.96,
   "end": 110.76,
   "text": "آخر رو دادم سه تا سلامو ندادم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.76,
   "end": 117.02,
   "text": "پرده‌ها برام کنار رفت و بهم نشون دادن که به جهت نگفتن اون دو تا سلام اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.02,
   "end": 119.34,
   "text": "چه فیوضاتی از تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.34,
   "end": 126.38,
   "text": "منع شده. دیدم انقدر نور و عظمت و رحمت و نعمت خدا از من سلب شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.38,
   "end": 131.94,
   "text": "به جهت همون دو تا سلام اول به من حیفم اومد که دیگه این کارو انجام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.94,
   "end": 136.1,
   "text": "خب موضوع ما بحث قلب خاشع بود و البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.1,
   "end": 144.22,
   "text": "چون روز میلاد حضرت عبدالعظیم حسنی سلام الله علیه هست و ما تبریک عرض می‌کنیم محضر امام عصر و شما خوبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.22,
   "end": 148.26,
   "text": "بی‌ارتباط هم نیست یک حدیث بسیار زیبا و جامع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.26,
   "end": 154.4,
   "text": "و آموزن، آموزنده از آقا علی بن موسی الرضا علیهم الصلاة والسلام هست که ایشون نقل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.4,
   "end": 159.06,
   "text": "کتابی هست جامع اخباری‌ست که مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.06,
   "end": 167.02,
   "text": "حضرت عبدالعظیم حسنی نقل کردن از امامان چون ایشون معاصر با چهار امام بودن از موسی بن جعفر تا امام هادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.02,
   "end": 170.32,
   "text": "لکن در اینکه امام موسی رو هم درک کرده باشن تشکیک هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.32,
   "end": 176.2,
   "text": "اما سه امام بعدی رو درک کردن و وکالت داشتن از امام هادی رو می‌دونید دیگه همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.2,
   "end": 180.64,
   "text": "نائب امام عصرشون بودن ایشون، نائب خاص هم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.64,
   "end": 187.54,
   "text": "به هر حال این روایتی که ایشون نقل کرده و بسیار زیباست که مرحوم شیخ مفید در کتاب اختصاصش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 187.54,
   "end": 193.76,
   "text": "نقل کرده و مرتبط هم هست بخشیش با موضوع قلب خاشع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 193.76,
   "end": 200.4,
   "text": "من عرض می‌کنم همون نکته‌ای که مرتبط هست و الا توضیحش رو دیگه از اهلش بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 200.4,
   "end": 205.24,
   "text": "روی عن عبد العظیم عن ابی الحسن الربا علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 205.24,
   "end": 215.76,
   "text": "قال. ایشون نقل می‌کنه از امام رضا که حضرت فرمودن یا عبد العظیم أبلغ أني أولياء السلام أولياء السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 215.76,
   "end": 218.64,
   "text": "سلام من امام رضا رو به دوستانم برسون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 218.64,
   "end": 222.8,
   "text": "الان شما باید چی بگید؟ چی باید بگید الان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 222.8,
   "end": 225.14,
   "text": "باید بگید و علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 225.14,
   "end": 228.18,
   "text": "امام رضا داره به شما سلام می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 228.18,
   "end": 230.7,
   "text": "و قل هم به ایشان بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 230.7,
   "end": 235.52,
   "text": "الا يجعل للشيطان على انفسهم سبيلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 235.52,
   "end": 242.9,
   "text": "مراقب باشن که به جانشون که منظور همون قلب هست راهی برای نفوذ شیطان قرار ندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 242.9,
   "end": 248.94,
   "text": "این سر فصل حدیث روایتیه که نشون میده اگر کسی راهی برای نفوذ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 248.94,
   "end": 254.48,
   "text": "شیطان قرار داد اتفاقات بعدی پیامدشه که بعد حضرت ادامه میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 254.48,
   "end": 257.18,
   "text": "و مرهم بصدق في الحديث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 257.18,
   "end": 264.18,
   "text": "به این‌ها امر کن که به راستگویی کلام، کلامشون راست باشه که اگر شیطان راه پیدا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 264.18,
   "end": 267.48,
   "text": "دچار کذب در کلام میشن، عکسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 267.48,
   "end": 274.2,
   "text": "و ادا الأمانة ادای امانت داشته باشن که بزرگترین امانت خودشونن، نفس خودشونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 274.2,
   "end": 276.86,
   "text": "وجود خودشونه، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 276.86,
   "end": 278.5,
   "text": "فطرت وجودیشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 278.5,
   "end": 281.54,
   "text": "این امانت الهی رو باید ادا کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 281.54,
   "end": 284.5,
   "text": "و مرهم بالسكوت این‌ها رو امر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 284.5,
   "end": 286.86,
   "text": "این نشون میده چقدر مهمه این مهم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 286.86,
   "end": 289.28,
   "text": "مسائل برای اماممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 289.28,
   "end": 294.86,
   "text": "امرشون کن به سکوت و ترک الجلا-- جدال فيما لا يعنيهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 294.86,
   "end": 299.74,
   "text": "بهشون بگو بگو مگو نکنن در چیزای بی‌فایده جدال نکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 299.74,
   "end": 304.36,
   "text": "و اقبال بعضهم إلى بعض این‌ها به هم توجه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 304.36,
   "end": 307.32,
   "text": "دوستان ما متوجه هم باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 307.32,
   "end": 310.72,
   "text": "اقبال یعنی توجه، توجه ویژه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 310.72,
   "end": 314.04,
   "text": "و المزاورة به زیارت همدیگه برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 314.04,
   "end": 321.64,
   "text": "خیلی این تیکش عجیبه. دقت کنید وقتی می‌فرماید که بگو به زیارت هم برن و به هم توجه کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 321.64,
   "end": 325.66,
   "text": "جبهه گیری امام رضا در این خصوص رو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 325.66,
   "end": 328.44,
   "text": "یا عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 328.44,
   "end": 330.4,
   "text": "وجه حضرت اینجا چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 330.4,
   "end": 332.24,
   "text": "فإن ذلک قربة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 332.24,
   "end": 334.3,
   "text": "إلي الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 334.3,
   "end": 337.78,
   "text": "فرمود این سبب میشه که به من نزدیک بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.78,
   "end": 341.9,
   "text": "یعنی اگه برن به زیارت هم و به هم توجه کنن به من نزدیک میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 341.9,
   "end": 344.64,
   "text": "ولا یشتغلوا انفسهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 344.64,
   "end": 349.3,
   "text": "بتمزیغ بعضهم بعضا بهشون بگو مراقب باشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.3,
   "end": 353.04,
   "text": "مشغول نشن به اینکه آبروی همدیگه رو بریزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 353.04,
   "end": 356.88,
   "text": "فإني علیت على نفسي انه من فعل ذلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.88,
   "end": 362.32,
   "text": "اسخط ولیا من اولیائی من با خودم عهد کردم که اگه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 362.32,
   "end": 366.34,
   "text": "این کارو بکنه یعنی بخواد آبرویی از دوستان ما ببره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.34,
   "end": 371.06,
   "text": "و دوستا یکی از دوستان منو به خشم بیاره، دعوت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 371.06,
   "end": 375.3,
   "text": "از خدا بخوام دعا کنم از خدا بخوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 375.3,
   "end": 382.62,
   "text": "\"لیعذبه في الدنيا أشد العذاب\" قطعا او رو تو دنیا به شدیدترین عذاب‌ها دچار کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 382.62,
   "end": 384.96,
   "text": "\"و كان في الآخرة من الخاسرين\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.96,
   "end": 389.96,
   "text": "و تازه عذاب آخرت هم سر جاشه که اونجا خسران زده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 389.96,
   "end": 398.94,
   "text": "عبدالعظیم بهشون بگو \"عرفهم\" آگاهشون کن \"أن الله قد غفر لمحسنهم لمحسنهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 398.94,
   "end": 402.54,
   "text": "خدا قطعا نیکوکاراشونو می‌بخشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 402.54,
   "end": 405.76,
   "text": "\"وتجاوز عن مسیئهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 405.76,
   "end": 410.92,
   "text": "این گناهان اهل نیکوکاری رو یا حالا یه گناهی هم ازشون سر زد، خدا اینا رو هم می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 410.92,
   "end": 414.5,
   "text": "\"إلا من أشرك به\" مگر بیفتن به شرک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 414.5,
   "end": 418.18,
   "text": "که این دیگه بخشیدنی نیست و \"أو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 418.18,
   "end": 421.46,
   "text": "أذى أو آذى وليا من أوليائي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 421.46,
   "end": 427.64,
   "text": "بهشون آگاه کن که اگر اذیت کنند یکی از دوستان منو رنجی برسونن به یکی از دوستان من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 427.64,
   "end": 430.52,
   "text": "این انتهای حدیث خیلی نهیب داره دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 430.52,
   "end": 432.72,
   "text": "\"أو أضمر له سوءا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 432.72,
   "end": 435.46,
   "text": "یا اینکه تو دلشون تو ضمیرشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 435.46,
   "end": 438.08,
   "text": "نیت بدی در خصوص کسی بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 438.08,
   "end": 441.4,
   "text": "اندیشه و نقشه بدی در خصوص کسی بکشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 441.4,
   "end": 445.44,
   "text": "\"فإن الله لا يغفر له حتى يرجع\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 445.44,
   "end": 450.8,
   "text": "خدا نمی‌بخشش مگر اینکه از این نیت سوء نسبت به دوست ما برگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 450.8,
   "end": 461.94,
   "text": "\"فإن رجع وإلا\" که اگر برنگرده همچنان تو دلش نیت سوء رو نسبت به دوست ما نگه داره، \"نزع\" خیلی خطرناکه این جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 461.94,
   "end": 468.14,
   "text": "\"نزع روح الإيمان عن قلبه\" روح ایمان از قلبش خارج می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 468.14,
   "end": 472.44,
   "text": "\"وخرج عن ولايتي\" خارج می‌شه از ولایت من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 472.44,
   "end": 475.0,
   "text": "الله اکبر. دو مرتبه تک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 475.0,
   "end": 480.08,
   "text": "حضرت تاکید می‌کنه \"ولم يكن له نصيبا في ولايتنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 480.08,
   "end": 483.62,
   "text": "و چنین کسی هیچ نصیبی از ولایت ما نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 483.62,
   "end": 485.9,
   "text": "\"وأعوذ بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 485.9,
   "end": 488.22,
   "text": "من ذلك\" ختم کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 488.22,
   "end": 492.64,
   "text": "حضرت می‌فرماید پناه می‌برم به خدا از چنین چیزی، از اینکه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 492.64,
   "end": 496.16,
   "text": "ببینم کسی از ولایت ما خارج بشه و هیچ نصیبی نیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 496.16,
   "end": 498.78,
   "text": "حالا چه ارتباطی با قلب خاشع داشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 498.78,
   "end": 505.42,
   "text": "اون آیه چهل و پنج سوره بقره رو دقت کنید بذارید کنار این حدیث زیبا که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 505.42,
   "end": 508.68,
   "text": "\"استعينوا بالصبر والصلاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 508.68,
   "end": 512.3,
   "text": "وإنها لكبيرة إلا على الخاشعين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 512.3,
   "end": 516.08,
   "text": "استعانت بجویید از صبر و نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 516.08,
   "end": 518.28,
   "text": "ظاهرش یعنی صبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 518.28,
   "end": 521.5,
   "text": "و نماز. بعضیا صبر و روزه هم معنی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 521.5,
   "end": 525.82,
   "text": "ظاهرش یعنی استعانه، کمک بگیرید از روزه و نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 525.82,
   "end": 531.06,
   "text": "اما باطنش رو روایات بسیاری داریم که صبر وجود مقدس پیغمبر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 531.06,
   "end": 533.78,
   "text": "نماز وجود مقدس امیرالمؤمنین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 533.78,
   "end": 537.98,
   "text": "یعنی کمک بگیرید از ولایت پیغمبر و علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 537.98,
   "end": 545.18,
   "text": "اما دقت کنید \"وإنها لكبيرة\" قطعا این سخته، سنگینه \"إلا على الخاشعين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 545.18,
   "end": 551.66,
   "text": "قلب خاشع یادتون باشه. این سخته مگر برای کسایی که دلشون خاشعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 551.66,
   "end": 559.52,
   "text": "پس اگر کسی قلبش خاشع نباشه سختشه ارتباط بگیره با پیغمبر و امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 559.52,
   "end": 563.94,
   "text": "آیه قرآن داره می‌فرماد \"وإنها لكبيرة\" قطعا سختشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 563.94,
   "end": 569.48,
   "text": "که مرتبط بشه. حالا متوجه بشه، متصل بشه، متوصل بشه، حرمش بره یا التزام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 569.48,
   "end": 572.5,
   "text": "عملی به دستورات اونا داشته باشه، از هر وجهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 572.5,
   "end": 575.54,
   "text": "سخت و سنگینه براش. مرتبط بشه با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 575.54,
   "end": 584.12,
   "text": "با ولایت آل الله. خب اینجا میگه اگر کسی سخت شد مرتبط بشه با ولایت آل الله خشوع قلبیش رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 584.12,
   "end": 589.06,
   "text": "توی این حدیث آخرش گفت چی باعث می‌شه هیچ نصیبی از ولایت ما نبره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 589.06,
   "end": 593.44,
   "text": "و از ولایت ما خارج بشه و روح ایمان ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 593.44,
   "end": 598.8,
   "text": "قبض بشه؟ اینکه بخواد نسبت به دوست ما نیت بد ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 598.8,
   "end": 601.5,
   "text": "این زیرآب‌زنی‌هایی که خیلی جاها هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 601.5,
   "end": 606.62,
   "text": "زیر آب همدیگه رو می‌زنن، به راحتی میرن برای هم بدگویی می‌کنن، آبروی همدیگه رو می‌برن، انگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 606.62,
   "end": 608.82,
   "text": "نونش مثلا دست فلانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 608.82,
   "end": 611.28,
   "text": "آها می‌خواد پیش فلان مدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 611.28,
   "end": 616.02,
   "text": "خودش رو مثلا یک جلوه‌ای بده میره فلانی رو خراب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 616.02,
   "end": 620.0,
   "text": "این‌ها مصداق خیلی خطرناکه، مصداق این حدیثه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 620.0,
   "end": 622.44,
   "text": "و خشوع قلب انسان رو می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 622.44,
   "end": 632.48,
   "text": "ارراه پل ارتباطی ما با ولایت را از بین می‌بره تا جایی که ختم کلام امام رضا می‌فرماید \"أعوذ بالله من ذلك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 632.48,
   "end": 635.6,
   "text": "من به خدا پناه می‌برم از چنین چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 635.6,
   "end": 641.4,
   "text": "اون موقع سختش می‌شه نماز، روزه، ارتباط با امیرالمؤمنین، ارتباط با پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 641.4,
   "end": 644.46,
   "text": "سختش می‌شه وقتی خشوع قلبیش رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 644.46,
   "end": 650.9,
   "text": "دیگه خارج می‌شه کلا از ولایت اهل بیت و خدایی نکرده عاقبتش به خیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 650.9,
   "end": 657.76,
   "text": "نخواهد شد. حالا ما هم امروز بگیم \"أعوذ بالله من ذلك\" واقعا پناه می‌بریم به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 657.76,
   "end": 660.18,
   "text": "عاقبتمون انشاالله به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 660.18,
   "end": 663.34,
   "text": "به برکت صلوات بر محمد آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 663.34,
   "end": 665.74,
   "text": "الله- اللهُم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 665.74,
   "end": 671.3,
   "text": "صَلّ عَلَى مُحَمَّد وَآلِ مُحَمَّد وَعَجِّل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}