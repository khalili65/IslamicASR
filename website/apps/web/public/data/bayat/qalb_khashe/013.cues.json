 "chapters": [
  {
   "index": 0,
   "title": "## بستن پروندهٔ قلب خاشع؛ اکتفا به ظاهر",
   "start": 11.88,
   "end": 84.48
  },
  {
   "index": 1,
   "title": "### نصیحت خضر به موسی",
   "start": 84.48,
   "end": 202.56
  },
  {
   "index": 2,
   "title": "بعد حضرت خضر این را به حضرت موسی فرمودند:",
   "start": 202.56,
   "end": 298.98
  },
  {
   "index": 3,
   "title": "### خطر اهل قلم و منبر و مداحی",
   "start": 298.98,
   "end": 377.8
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.38,
   "end": 4.9,
   "text": "بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.9,
   "end": 8.52,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.52,
   "end": 11.88,
   "text": "آiate. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.88,
   "end": 16.32,
   "text": "موضوع قلب خاشع رو یه نکته‌ی دیگه عرض کنیم و دیگه پرونده‌ش رو ببندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.32,
   "end": 20.02,
   "text": "تبرکاً ما عرض می‌کنیم و الا مطلب بسیار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.02,
   "end": 22.8,
   "text": "یکی از دلایل مهمی که ما معمولاً از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.8,
   "end": 26.32,
   "text": "وادی خشوع قلب خارج می‌شیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.32,
   "end": 30.76,
   "text": "به گفته‌ی بزرگان وقتی‌ست که به ظاهر اکتفا می‌کنیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.76,
   "end": 33.68,
   "text": "ظاه-- وارد باطن نمی‌شیم و باطن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.68,
   "end": 38.0,
   "text": "و تاثیرات دریافت‌هامون رو در باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.0,
   "end": 42.7,
   "text": "بررسی، مورد بررسی و کنکاو قرار نمی‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.7,
   "end": 48.1,
   "text": "در حقیقت حتی علوم رو گاهاً می‌شه که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.1,
   "end": 51.04,
   "text": "صرفاً برای اینکه برای دیگران بیان کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.04,
   "end": 56.32,
   "text": "جمع‌آوری می‌کنیم و اون رو در قلبمون وارد نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.32,
   "end": 61.5,
   "text": "صرفاً جهت مفروضاتی که در حواجس افکار و ذهنیات‌مون جمع بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.5,
   "end": 66.42,
   "text": "و با اون بعضاً ظاهری نشون بدیم و ظاهری ایجاد کنیم و درست کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.42,
   "end": 70.12,
   "text": "و حتی بعضاً به تفاخر این‌ها کشیده بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.12,
   "end": 72.04,
   "text": "بهش چنگ می‌ندازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.04,
   "end": 76.2,
   "text": "تا جایی که حضرت امام رحمت‌الله علیه فرمودن که این خود حجاب اکبره؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.2,
   "end": 79.42,
   "text": "این بخش از علم. در حقیقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.42,
   "end": 84.48,
   "text": "اه، دانسته‌هامون بدل به یافته نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.48,
   "end": 91.84,
   "text": "در این خصوص روایتی رو مرحوم مجلسی رحمت‌الله علیه در جلد یک، صفحه دویست و بیست و شش آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.84,
   "end": 97.06,
   "text": "که پیرامون آداب طلب العلم و احکامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.06,
   "end": 102.22,
   "text": "مرحوم حضرت استاد حق‌شناس هم در کتاب موعظه‌شون آورده که کتاب بسیار خوبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.22,
   "end": 105.94,
   "text": "عرض کردیم این کتاب نفس می‌زنه با شما و زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.94,
   "end": 109.44,
   "text": "مجموعه‌ای از سخنرانی‌های ایشون رو جمع‌بندی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.44,
   "end": 112.6,
   "text": "اونجا وقتی که حضرت خضر علی‌نبی‌نواحی و علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.6,
   "end": 115.96,
   "text": "الصلاة والسلام از حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.96,
   "end": 119.68,
   "text": "علی‌نبی‌نواحی و علیه الصلاة والسلام جدا می‌شن، اونجا حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.68,
   "end": 126.22,
   "text": "موسی خب وقتی هذا فراقٌ بينی و بينک گفته می‌شه، حضرت موسی زرنگی می‌کنند و سؤال می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.22,
   "end": 132.84,
   "text": "حالا که دارید از ما جدا می‌شید به استادشون حضرت خضر که یک نصیحتی بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.84,
   "end": 137.48,
   "text": "این یک درس عبرتی‌ست برای ماها که معمولاً از بزرگان جدا می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.48,
   "end": 139.1,
   "text": "بدون بهره جدا نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.1,
   "end": 144.8,
   "text": "آخر یه نصیحتی بگیریم و بریم و لو در یک سلام علیکم معمولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.8,
   "end": 148.48,
   "text": "اینجا حضرت خضر، اه، حکمتی رو بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.48,
   "end": 150.82,
   "text": "فرمودن \"أعرف الدنيا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.82,
   "end": 153.9,
   "text": "و انبدها وراك.\" فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.9,
   "end": 160.28,
   "text": "دنیا رو خوب بشناس و اون رو پشت سرت بنداز چرا که دنیا برای تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.28,
   "end": 165.92,
   "text": "\"فإنها ليست لك بدار.\" دنیا برای تو محل قرار و آرامش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.92,
   "end": 168.36,
   "text": "\"ولالک فیها محل قرار.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.36,
   "end": 172.62,
   "text": "قرار نیست اونجا بمونی و قرار داشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.62,
   "end": 177.16,
   "text": "\"وإنها جعلت بلغة للعباد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.16,
   "end": 183.3,
   "text": "و اَ-- بلغة للعباد لتزود منها للمعد.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.3,
   "end": 185.96,
   "text": "فرمودن که خدا این دنیا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.96,
   "end": 188.34,
   "text": "وسیله‌ای قرار داده برای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.34,
   "end": 192.64,
   "text": "اه، بندگانش تا معاش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.64,
   "end": 195.18,
   "text": "اه، معادشون رو فراهم کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.18,
   "end": 198.58,
   "text": "در حقیقت از دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.58,
   "end": 202.56,
   "text": "زاد آخرتشون رو فراهم کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.56,
   "end": 204.4,
   "text": "بسیار جمله قابل تأملی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.4,
   "end": 208.14,
   "text": "یعنی هرچی تو این دنیا ما اخذ می‌کنیم حتی از ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.14,
   "end": 210.44,
   "text": "معارف و عباديات و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.44,
   "end": 216.06,
   "text": "اگر اخروی شد و موندنی شد، اگر تثبیت شد در وجود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.06,
   "end": 223.96,
   "text": "و منجر به خشوع قلب شد، منجر به شکستگی و ذلت درون در برابر خدای بزرگ شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.96,
   "end": 228.64,
   "text": "منجر به تقوا شد، منجر به خود نگهداری شد و این‌ها خب خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.64,
   "end": 230.84,
   "text": "این زاد و توشه ای‌ست برای آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.84,
   "end": 234.38,
   "text": "و الا بدتر سبب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.38,
   "end": 238.86,
   "text": "خود برتربینی و خودشیفتگی و خروج وجود انسان از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.86,
   "end": 244.72,
   "text": "حالت خشیت می‌شه. مثل نمازی که انسان فقط به ظاهرش اکتفا کنه و وارد باطنش نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.72,
   "end": 247.48,
   "text": "بعد، اه، حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.48,
   "end": 256.96,
   "text": "بعد از این قضیه این رو فرمودن به حضرت موسی که \"یا موسی تعلم ما تعلم لتعلم به ولا تعلم لتحدث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.96,
   "end": 259.68,
   "text": "لتحدث به.\" خیلی زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.68,
   "end": 264.48,
   "text": "فرمودن که علم رو برای این یاد بگیر که تو خودت پیاده‌ش کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.48,
   "end": 269.36,
   "text": "نه اینکه لتحدث به، فقط حدیثش کنی برای دیگران نقل کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.36,
   "end": 274.8,
   "text": "گاهی اوقات ما یه موضوع خیلی مهمی رو تا کشف می‌کنیم همون آن می‌گیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.8,
   "end": 279.14,
   "text": "بچه مورد خوبی مثلاً بریم برای دیگران بگیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.14,
   "end": 282.7,
   "text": "قبل از اون به درد خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.7,
   "end": 285.16,
   "text": "نمی‌خوره آیا؟ آیا واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.16,
   "end": 288.28,
   "text": "وجود ما تشنه همچین چیزی نبوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.28,
   "end": 291.88,
   "text": "یعنی ما مثلاً طبیب دواری شدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.88,
   "end": 296.46,
   "text": "خودمون به کل رسیدیم و برای دستگیری دیگران فقط وظیفه داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.46,
   "end": 298.98,
   "text": "در صورتی اول باید خودمون رو بسازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.98,
   "end": 304.48,
   "text": "به هر حال یکی از خطرات این راه عزیزان دلم مخصوصاً کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 304.48,
   "end": 306.78,
   "text": "قلم به دست‌اند یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.78,
   "end": 310.76,
   "text": "تری‌فون دستشونه، منبری هستند، واعظ‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.76,
   "end": 316.36,
   "text": "ذاکر و مداح‌اند، جمعیتی پای منبرشونه، این‌ها این خطر جدی تهدیدشون می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.36,
   "end": 318.52,
   "text": "که خیلی از موارد می‌بینیم همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.52,
   "end": 325.06,
   "text": "حدیث کردن‌ها و بیان‌ها اگرچه بسیار فضیلت بزرگی‌ست در جامعه کبیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.06,
   "end": 328.26,
   "text": "اه، ما آرزو می‌کنیم که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.26,
   "end": 331.06,
   "text": "اه، و يختص آثارکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.06,
   "end": 336.66,
   "text": "ما از جمله کسانی باشیم که قصه می‌کنیم آثار شما اهل بیت رو برای دیگران بیان می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 336.66,
   "end": 344.92,
   "text": "لکن این، اه، گاهی اوقات باعث می‌شه که ما اکتفا کنیم به همین و از خودسازی از درون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.92,
   "end": 349.24,
   "text": "و بررسی وجود خودمون غافل بشیم و همین که عده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.24,
   "end": 353.56,
   "text": "استفاده ببرن و سود ببرن بسنده می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.56,
   "end": 356.58,
   "text": "لذا از خودمون غافل می‌شیم و گمان می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.58,
   "end": 358.86,
   "text": "دیگه همین که، اه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.86,
   "end": 362.22,
   "text": "مثلاً این چیزا رو ما بلدیم و به دیگران انتقال دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.22,
   "end": 365.22,
   "text": "دیگه کفایت می‌کنه. نیاز به تهذیب نفس و خودسازی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.22,
   "end": 369.08,
   "text": "خطر بزرگی‌ست که انشاالله خدا ما رو از این حالت نگه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 369.08,
   "end": 371.8,
   "text": "و بلکه مانع جدی برای خشوع ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.8,
   "end": 374.68,
   "text": "ایجاد نشه. امیدوارم که عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.68,
   "end": 377.8,
   "text": "ذ-- به ذکر صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}