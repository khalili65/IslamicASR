 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 2.38,
   "end": 63.78
  },
  {
   "index": 1,
   "title": "## قلبِ خاشع",
   "start": 63.78,
   "end": 160.12
  },
  {
   "index": 2,
   "title": "## خضوع و خشوع",
   "start": 160.12,
   "end": 380.9
  },
  {
   "index": 3,
   "title": "## نمونه‌هایِ خشوع",
   "start": 380.9,
   "end": 481.02
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.38,
   "end": 6.56,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.56,
   "end": 10.32,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.32,
   "end": 13.98,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.98,
   "end": 18.32,
   "text": "در خصوص عدول از نیت یه نکته باقی مونده، اون اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.32,
   "end": 27.54,
   "text": "یادتون باشه عرض کردیم به فتوای رهبر عزیزمون جانم فداش شما می‌تونید اگر در نماز دوم یادتون اومد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.54,
   "end": 29.98,
   "text": "نماز اول رو نخوندید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.98,
   "end": 35.46,
   "text": "عدول کنید نیت رو برگردونید به نماز اول در صورتی که البته وقت ضیق نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.46,
   "end": 41.24,
   "text": "مثلا وقت مخصوص نماز دوم نباشه که دیگه نتونید برگردید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.24,
   "end": 47.76,
   "text": "نماز اول. بالعکسش از رهبر سؤال شده، استفتاء شده که بالعکسش چطور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.76,
   "end": 51.6,
   "text": "میشه در نماز اول باشی نیت کنی نماز دوم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.6,
   "end": 55.98,
   "text": "مثلا شما یهو یادت میاد که نماز اول تو خونده بودی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.98,
   "end": 59.14,
   "text": "می‌تونی؟ آقا فرمودن نخیر جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.14,
   "end": 63.78,
   "text": "از نماز اول به نماز دوم عدول نیت جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.78,
   "end": 66.08,
   "text": "موضوع ما قلب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.08,
   "end": 68.72,
   "text": "قلب مطمئن رو مختصر توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.72,
   "end": 71.0,
   "text": "قلب مطبوع یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.0,
   "end": 73.56,
   "text": "خورده رو مختصر توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.56,
   "end": 83.84,
   "text": "امروز هم مختصری پیرامون سومین نوع قلب از قرآن که حدود شصت نوع قلب عرض کردیم داریم به نام قلب خاشع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.84,
   "end": 87.86,
   "text": "صحبت کنیم. آیاتی که پیرامون قلب خاشع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.86,
   "end": 92.3,
   "text": "در قرآن هست یکی آیه پنجاه و چهار سوره حجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.3,
   "end": 95.94,
   "text": "دیگه من آیات رو نمی‌خونم شماره میدم برید ملاحظه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.94,
   "end": 98.28,
   "text": "آیه بیست و سه زمره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.28,
   "end": 102.28,
   "text": "و آیه شانزده سوره حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.28,
   "end": 112.54,
   "text": "این قلب اگر چنانچه با ذکر خدا، با یاد خدا و با محبت خدا عجین بشه البته ذکر مقدمه محبت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.54,
   "end": 116.2,
   "text": "یاد کردن محبت، مقدمه محبت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.2,
   "end": 121.36,
   "text": "اگر کسی یاد کنه بسیار از خدا رفته رفته او عاشق میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.36,
   "end": 124.72,
   "text": "اگر کسی یاد نکنه غافل باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.72,
   "end": 127.42,
   "text": "اون محبتی هم که داره رفته رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.42,
   "end": 135.76,
   "text": "از بین میره. یاد خدا محبت میاره طوری که خدا به موسی فرمود در کتاب جواهر الثنیه فی احادیث القدسیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.76,
   "end": 138.06,
   "text": "شیخ حر عاملی هست که موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.06,
   "end": 141.38,
   "text": "بندگان منو عاشق من کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.38,
   "end": 143.6,
   "text": "بعد موسی گفت چطور آخه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.6,
   "end": 146.94,
   "text": "چطور اینا رو عاشق تو کنم؟ خدا فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.94,
   "end": 149.44,
   "text": "یادشون بنداز، منو به یاد اون‌ها بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.44,
   "end": 152.5,
   "text": "باز گفت چطور؟ فرمود نعمت‌ها رو به رخشون بکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.5,
   "end": 155.22,
   "text": "این همه لطفی که من بهشون داشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.22,
   "end": 158.28,
   "text": "یاد کنن از من. این یاد، ذکر، یاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.28,
   "end": 160.94,
   "text": "سبب میشه که انسان عاشق بشه و خشوع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.94,
   "end": 162.48,
   "text": "خشوع هم امر قلبی‌ست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.48,
   "end": 165.1,
   "text": "می‌دونید ما یه خضوع داریم، یه خشوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.1,
   "end": 169.02,
   "text": "خضوع یعنی ظاهر افتاده حالت خشوع یعنی باطنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.02,
   "end": 176.54,
   "text": "افتاده حالت. اگر کسی دچار اینو دقت کنید، دچار محبت خدا بشه بیچاره میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.54,
   "end": 181.04,
   "text": "یعنی واقعا ما بعضا دچار نشدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.04,
   "end": 185.24,
   "text": "راحت داریم از کنار خدا و اسم خدا اینا می‌گذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.24,
   "end": 192.5,
   "text": "من دیدم آدمایی که مدتی دچار عشق و محبت خدا شدن شب و روزشون یکی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.5,
   "end": 196.46,
   "text": "من دیدم به شما عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.46,
   "end": 200.5,
   "text": "در یکی از روایات دیدم تو همون کتاب شیخ حر عاملی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.5,
   "end": 204.94,
   "text": "جواهر الثنیه که شاید شنیده باشید حضرت شعیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.94,
   "end": 210.28,
   "text": "خب پیغمبر بود از طرف خدا اومده بود اما انقدر عاشق خدا شده بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.28,
   "end": 215.22,
   "text": "به قدری از عشق و محبت خدا، میگم دچار شده ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.22,
   "end": 223.32,
   "text": "به قدری از عشق و محبت خدا قلبش لبریز شده، انقدر گریه کرد تا نابینا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.32,
   "end": 227.08,
   "text": "ما کدوممون اصلاً سوی چشممون از شدت گریه کم شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.08,
   "end": 231.88,
   "text": "نمیگم نابینا. بار دوم خدا به، بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.88,
   "end": 235.6,
   "text": "چی داد؟ چشم داد. وقتی نابینا شد دوباره بهش چشم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.6,
   "end": 238.26,
   "text": "دوباره انقدر گریه کرد تا نابینا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.26,
   "end": 243.22,
   "text": "دوباره خدا بهش چشم داد. به قدری گریه کرد باز نابینا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.22,
   "end": 247.38,
   "text": "سه بار نابینا شد خدا مرتبه چهارم دوباره بهش چشم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.38,
   "end": 249.84,
   "text": "باز شروع کرد به گریه کردن. خدا گفت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.84,
   "end": 252.72,
   "text": "اگه از ترس جهنمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.72,
   "end": 254.64,
   "text": "من جهنم رو به تو حرام کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.64,
   "end": 258.5,
   "text": "اگه به عشق و شوق بهشته اونم حلالت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.5,
   "end": 263.5,
   "text": "چته؟ شعیب عرض کرد ای خدا اصلاً این حرفا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.5,
   "end": 265.6,
   "text": "من دلم عاشق تو شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.6,
   "end": 268.64,
   "text": "طاقت دوری تو رو ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.64,
   "end": 270.66,
   "text": "م-- کدوم یکی از ما اینطوری هستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.66,
   "end": 276.3,
   "text": "اصلاً وقت نماز پر پر می‌زنیم می‌خواد وقت نماز برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.3,
   "end": 279.54,
   "text": "آخر اینطوری که شد خدا این شوقش رو دید چیکار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.54,
   "end": 283.12,
   "text": "این کاری که خدا باهاش کرده خیلی مهمه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.12,
   "end": 286.92,
   "text": "به موسی کلیم الله گفت برو باهاش همنشین شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.92,
   "end": 291.7,
   "text": "این خودش سری براشه. یعنی اگر کسی دید واقعاً دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.7,
   "end": 298.16,
   "text": "خیلی به خدا نزدیک شده، قطعاً خدا یه همنشینی براش قرار میده که آرومش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.16,
   "end": 301.6,
   "text": "وقتی او رو دید یاد خدا بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.6,
   "end": 309.38,
   "text": "او آرامش بهش میده. یعنی حتی میشه انسان با دیدن اهل ایمان خاشع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.38,
   "end": 312.32,
   "text": "حضرت امام رحمت الله علیه جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.32,
   "end": 314.94,
   "text": "اخیرا من اینو شنیدم یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 314.94,
   "end": 319.18,
   "text": "فامیل‌هاشون نزدیکان و آشناهاشون می‌گفتش که شب سه شنبه‌ای بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.18,
   "end": 321.18,
   "text": "وقتی بود که امام حالش خراب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 321.18,
   "end": 322.78,
   "text": "آزمایشای مختلف ازش می‌گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 322.78,
   "end": 327.12,
   "text": "چشمش، سوز کم شده بود و نمی‌دونم قلبش و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 327.12,
   "end": 330.56,
   "text": "بهش گفته بودند دیگه یه مدت حق نداری گریه کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 330.56,
   "end": 336.16,
   "text": "به ام-- حضرت امام. مخصوصا امشب چون فردا آزمایش می‌خوان ازت بگیریم و چه وچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 336.16,
   "end": 341.86,
   "text": "اتفاقا خانم امام میگه اون شب تا صبح امام زجه زده گریه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.86,
   "end": 345.08,
   "text": "برعکس همیشه اگه مثلا یه دو ساعت، سه ساعت می‌خوابید پا می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 345.08,
   "end": 347.12,
   "text": "اون شب، شب تا صبح نخوابید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.12,
   "end": 349.28,
   "text": "تا صبح ناله امام بلند شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.28,
   "end": 352.32,
   "text": "بلند بود. وقتی به دکترش گفتیم ناراحت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.32,
   "end": 356.04,
   "text": "اومد پیش حضرت امام گفت مگه من به شما عرض نکرده بودم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.04,
   "end": 363.3,
   "text": "چرا شما جدی نمی‌گیرید؟ امام خندید فرمود خدا می‌دونه من اصلاً دیشب در اختیار خودم، اصلاً دست خودم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 363.3,
   "end": 366.02,
   "text": "دیشب خودمم نمی‌دونم چم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 366.02,
   "end": 370.04,
   "text": "دست خودم نبود دیشب تا صبح اینطوری این وضعیتو داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.04,
   "end": 372.66,
   "text": "این یعنی دچار شدن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.66,
   "end": 376.0,
   "text": "واقعا بخوایم یه مدتی اولاً شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.0,
   "end": 378.84,
   "text": "موقت بچشیم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.84,
   "end": 385.46,
   "text": "حالت رو ببینیم چی بشه. خدا رحمت کن مرحوم آمیز جواد آقای ملکی تبریزی این حالاتو همیشه داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.46,
   "end": 388.56,
   "text": "از خواب که بیدار میشد تو رختخواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 388.56,
   "end": 391.26,
   "text": "آیه قرآن میخوند گریه میکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.26,
   "end": 392.82,
   "text": "پا میشد میرفت وضو میگرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.82,
   "end": 396.96,
   "text": "در حین وضو گرفتن بغل حوض تو ها-حیاط گریه میکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.96,
   "end": 399.36,
   "text": "آسمانو نگاه میکرد گریه میکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.36,
   "end": 404.98,
   "text": "خیلی عجیبه. میگن انقدر گریه میکرد دیگه جزو برکه‌ها بود ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.98,
   "end": 408.5,
   "text": "خیلی گریه میکرد. الله اکبر نمازش دیگه سیر گریه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 408.5,
   "end": 411.16,
   "text": "نماز ایشون نماز صبحشو میدونید همه ندونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 411.16,
   "end": 414.94,
   "text": "یه عده قلیلی از دوستاشو فقط میگفت بیان ابتداء کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 414.94,
   "end": 418.0,
   "text": "کشششو نداشتن. زجه‌ها بلند بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.0,
   "end": 424.18,
   "text": "میگفتن وقتی ایشون الله اکبر میگفت هم خودش هم مریدهاش زجه‌ها بلند بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 424.18,
   "end": 427.3,
   "text": "حالا اینجا میشه ما این کارو بکنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.3,
   "end": 431.15,
   "text": "یه زجه‌ای ما بزنیم و شما هم پشت بندشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.15,
   "end": 434.84,
   "text": "اصلاً فیلم نمیشه بازی کرد واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 434.84,
   "end": 438.32,
   "text": "بعد میگن، میگن که از موقع اذان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.32,
   "end": 444.52,
   "text": "یه مثلاً چند دقیقه بعد اذان الله اکبرش شروع میشد چند دقیقه مونده به قضا شدن نماز صبح تموم میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.52,
   "end": 447.78,
   "text": "السلام علیکم. این حالاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.78,
   "end": 449.52,
   "text": "بعد ایشون میشه استاد از تهران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.52,
   "end": 452.9,
   "text": "بعد از همچین اس-استادی همچین شاگردی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.9,
   "end": 458.52,
   "text": "بیرون میاد. اینا رو من دارم میگم یه ذره مزه مزه کنیم ببینیم عجب کجای کاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.52,
   "end": 461.86,
   "text": "گمان نکنیم ما دو کرد دوری کرد نماز مثلاً نیمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 461.86,
   "end": 466.6,
   "text": "نصفه نیمه صبحمونو به به من صبح نماز صبح خوندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 466.6,
   "end": 471.1,
   "text": ". ایشالله عاقبتمون ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.1,
   "end": 473.98,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.98,
   "end": 481.02,
   "text": "محمد و آل محمد آجه. اللهم صل علی محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}