 "chapters": [
  {
   "index": 0,
   "title": "## وقت نماز عشا تا نیمه‌شب شرعی",
   "start": 11.74,
   "end": 69.4
  },
  {
   "index": 1,
   "title": "## احسن عملا در آیۀ موت و حیات",
   "start": 69.4,
   "end": 303.08
  },
  {
   "index": 2,
   "title": "## زبان دشمن خشیت؛ استقامت قلب",
   "start": 303.08,
   "end": 408.55
  },
  {
   "index": 3,
   "title": "## دو جملۀ فنا از شیخ رجب‌علی خیاط",
   "start": 408.55,
   "end": 534.31
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.76,
   "end": 5.1,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.1,
   "end": 8.4,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.4,
   "end": 11.74,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.74,
   "end": 15.62,
   "text": "از رهبر عزیزمون جانم به فداش سؤال شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.62,
   "end": 18.12,
   "text": "نماز عشا تا کی وقت داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.12,
   "end": 21.02,
   "text": "آیا تا دم نیمه شر-- نیمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.02,
   "end": 25.74,
   "text": "شب شرعی که معمولا هم اخبار اعلام می‌کنن مثلا یازده و دوازده دقیقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.74,
   "end": 28.14,
   "text": "اینا نیمه شب شرعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.14,
   "end": 30.94,
   "text": "آیا تا اون موقع وقت داریم یا تا اذان صبح؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.94,
   "end": 33.2,
   "text": "تو عامه مردم پیچیده تا اذان صبح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 33.2,
   "end": 39.96,
   "text": "حالا رهبر جوابشون چیه؟ فرمودن که تا نیمه شب شرعی باید خونده بشه نماز عشا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.96,
   "end": 46.06,
   "text": "اگر کسی به نیمه شب شرعی رسید و نماز عشاş به هر دلیلی هنوز خونده نشده تا صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.06,
   "end": 53.08,
   "text": "می‌تونه بخونه اما به نیت نه ادا نه قضا فقط قربتا الی الله تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.08,
   "end": 55.7,
   "text": "یعنی پس اگر تا حالا هر شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.7,
   "end": 60.82,
   "text": "که اخبار اعلام می‌کنه ساعت نیمه شرعی رو، نیمه شب شرعی رو داشتید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.82,
   "end": 68.7,
   "text": "باید عشا خونده بشه. اگه نخوندید تا صبح تا اذان صبح می‌تونید بخونید اما قربتا الی الله نه ادا و نه قضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.7,
   "end": 71.12,
   "text": "خب موضوع قلب خاشع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.12,
   "end": 75.2,
   "text": "از اون جهت مورد اهمیت بیشتری واقع میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.2,
   "end": 77.94,
   "text": "که ما توجه کنیم به آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.94,
   "end": 83.72,
   "text": "دو سوره ملک. آیه خیلی عجیبیه و خیلی هم درباره‌ش صحبت‌ها شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.72,
   "end": 86.02,
   "text": "دقت کنید که خدای متعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.02,
   "end": 91.24,
   "text": "در این آیه می‌فرماید الذي خلق الموت والحياة،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.24,
   "end": 93.52,
   "text": "خدا خودش رو چنین معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.52,
   "end": 97.2,
   "text": "او خدا کسی‌ست که خلق کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.2,
   "end": 99.34,
   "text": "موت و حیات رو برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.34,
   "end": 102.72,
   "text": "لیبلوکن ایکم احسن عملا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.72,
   "end": 105.28,
   "text": "برای اینکه شما رو بیازماید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.28,
   "end": 108.84,
   "text": "دچار امتحان و ابتلا بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.84,
   "end": 112.18,
   "text": "که ببینه کدومتون احسن عمل رو دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.18,
   "end": 114.92,
   "text": "وهو العزيز الغفور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.92,
   "end": 117.26,
   "text": "این آیه خیلی آیه عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.26,
   "end": 121.72,
   "text": "حالا بعد ذیل این آیه حالا چه ربطی به بحث قلب خاشع داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 121.72,
   "end": 127.96,
   "text": "اینکه خدای منان از ما اینجا خواسته احسن عمل رو به هر حال این دوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 127.96,
   "end": 131.46,
   "text": "عمر ما از وقتی که زنده شدیم به این دنیا اومدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.46,
   "end": 138.16,
   "text": "تا وقتی می‌میریم پرونده عملمون به دنبال احسن سازی اعماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.16,
   "end": 141.6,
   "text": "حالا این احسن سازی اعمال باید دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.6,
   "end": 145.04,
   "text": "منظور خدا از این احسن سازی اعمال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.04,
   "end": 149.86,
   "text": "که خدا همون رو منظور آوردن ما تو این دنیا قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.86,
   "end": 153.64,
   "text": "منظور از مرگ و حیات ما رو این رو قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.64,
   "end": 161.78,
   "text": "خب از اهل بیت معمولا از بسیاری از اهل بیت این پرسیده شده از پیغمبر، از امام صادق، از امام سجاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.78,
   "end": 166.14,
   "text": "از امام صادق صلوات الله علیه سؤال کردن حضرت این چنین فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.14,
   "end": 169.56,
   "text": "این سند هم در جلد پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.56,
   "end": 173.64,
   "text": "تفسیر برهان است. البرهان في تفسير القرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.64,
   "end": 175.78,
   "text": "صفحه سیصد و پنجاه و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.78,
   "end": 178.32,
   "text": "حضرت فرمودن معنای آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.32,
   "end": 181.34,
   "text": "آن نیست که چه کسی بیشتر عمل کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.34,
   "end": 188.54,
   "text": "نه فرموده اكثر عملا بلکه به معنای آن است که چه کسی درست‌تر عمل کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.54,
   "end": 191.7,
   "text": "احسن یعنی درست‌تر. حالا بعد حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.7,
   "end": 194.08,
   "text": "توضیح میده این درست‌تر یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.08,
   "end": 199.72,
   "text": "کار ما رو آسون کرده حضرت. بعد ادامه حضرت فرمودن که و درستی عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.72,
   "end": 202.44,
   "text": "با دو تا خصلته که اینجا حضرت فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.44,
   "end": 205.9,
   "text": "با ترس از خدا یعنی همون خشیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.9,
   "end": 208.78,
   "text": "و نیت صادق تحقق می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 208.78,
   "end": 213.08,
   "text": "ببینید انتهای حدیث رو. درستی عمل با ترس از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.08,
   "end": 215.12,
   "text": "و نیت صادق تحقق می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.12,
   "end": 218.38,
   "text": "پس بنابراین اعمالی از ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 218.38,
   "end": 224.56,
   "text": "پیش خدا مقبول واقع میشه و اون‌ها ثبت میشه و می‌مونه و عمل آخرتی ما رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.56,
   "end": 227.76,
   "text": "مراتب بهشتی و قربمونو می‌سازه که دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.76,
   "end": 234.3,
   "text": "ویژگی داشته باشه. یکی خشیت درش باشه که ما توضیح دادیم خشیت یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.3,
   "end": 239.92,
   "text": "یعنی ترس توأم با عظمت برای خدا، تعظیم الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.92,
   "end": 244.38,
   "text": "دو، خلوص. صرف خدا این کار انجام بشه اعمال ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.38,
   "end": 247.26,
   "text": "اگر این دو ویژگی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.26,
   "end": 249.84,
   "text": "این عمل مورد قبول درگاه خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.84,
   "end": 253.58,
   "text": "اگر نبود رد میشه و اون چیزی نیست که منظور خلقت ما بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.58,
   "end": 257.56,
   "text": "بعضیا مثلا از رسول خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.56,
   "end": 263.06,
   "text": "روایات آوردن که سؤال شد از حضرت، حضرت فرمود معرفت و خلوص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.06,
   "end": 265.5,
   "text": "خب معرفت هم قابل جمع با خشیت‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 265.5,
   "end": 269.62,
   "text": "چطور؟ چون اصلا خشیت خروجی معرفت‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.62,
   "end": 276.04,
   "text": "تا کسی نشناسه درست خدا رو پیدا نکنه و نشناسه خشیتی در دلش به کار نمیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.04,
   "end": 278.94,
   "text": "پس اینم همون میشه، خشیت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.94,
   "end": 284.04,
   "text": "خب این خشیت پس نشون میده که اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.04,
   "end": 291.0,
   "text": "میشه گفت ملائکه قلم به دست و کرامل کاتبین منتظرن همچین چیزی از ما سر بزنه تا ثبت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.0,
   "end": 293.86,
   "text": "انقدر مهمه. مساویه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.86,
   "end": 296.58,
   "text": "خلقت ما و اومدن ما به این دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.58,
   "end": 301.38,
   "text": "چیز کمی نیست. بهش باید خیلی توجه کنیم و البته ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.38,
   "end": 307.72,
   "text": "عرض کردیم که یکی از مهم‌ترین چیزهایی که خشیت رو از بین می‌بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.72,
   "end": 311.24,
   "text": "چی بود؟ جلسه پیش عرض کردیم زبان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.24,
   "end": 315.0,
   "text": "اینکه زبان درست و به موقع به کار نیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.0,
   "end": 317.7,
   "text": "یه حدیث خیلی عجیبی من از امیرالمؤمنین دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.7,
   "end": 322.6,
   "text": "خیلی ندیده بودم تا حالا این حدیث رو اگر دیده بودم بهش توجه نداشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.6,
   "end": 325.26,
   "text": "این حدیث البته دیدم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.26,
   "end": 329.34,
   "text": "ما نهج البلاغه رو چند دوره خوندیم حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.34,
   "end": 331.82,
   "text": "ت-- پیش استاد درس گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.82,
   "end": 335.76,
   "text": "ولی خب توجه گاهی اوقات دیدید یه چیزیه اصلا توجه بهش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.76,
   "end": 338.62,
   "text": "حالا که مرتبط به بحثه خیلی توجه‌م رو جلب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.62,
   "end": 342.82,
   "text": "امیرالمؤمنین علیه السلام در خطبه صد و هفتاد و پنج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.82,
   "end": 347.28,
   "text": "در خطبه صد و هفتاد و پنج از نهج البلاغه این چنین فرمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.28,
   "end": 352.98,
   "text": "اون نهج البلاغه‌هایی که خیلی بیشتر چاپ شده صفحه پونصد و هفتاد و یکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.98,
   "end": 356.06,
   "text": "که فکر می‌کنم مرحوم دشتی ترجمه کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.06,
   "end": 359.9,
   "text": "مولا این چنین فرمودند لا یستقیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.9,
   "end": 363.57,
   "text": "قلب عبد خیلی عجیبه جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.57,
   "end": 365.95,
   "text": "یعنی قلب آدمی در راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.95,
   "end": 372.13,
   "text": "مستقیم و استوار قرار نمیگیره حتی یستقیم لسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.13,
   "end": 376.49,
   "text": "تا وقتی که زبانش تو این راه استوار بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 376.49,
   "end": 384.45,
   "text": "یعنی تا وقتی زبان استوار نیست، زبان اصلاح نشده و محکم نیست و درست به کار نگرفته شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.45,
   "end": 392.43,
   "text": "دل مستقیم در راه مستقیم-- این همون در نماز هر روز از خدا میخوایم \"اهدنا الصراط المستقيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.43,
   "end": 398.13,
   "text": "این راه مستقیم که باید قلب اون رو مدیریت کنه در وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.13,
   "end": 402.59,
   "text": "به تثبیت نمیرسه مگر اینکه لسان در راه مستقیم و استوار قرار بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.59,
   "end": 404.45,
   "text": "یعنی لسان پاکسازی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.45,
   "end": 407.31,
   "text": "لسان بدونه کجا باید ساکت باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.31,
   "end": 414.75,
   "text": "کجا باید حرف بزنه. در حالات مرحوم شیخ رجب علی خیاط هم یه جمله پیدا کردم خیلی باز برام عجیب بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 414.75,
   "end": 423.43,
   "text": "که ایشون میفرماید شبی دو فرشته با دو جمله به من راه فنا رو، فنا رو آموختند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.43,
   "end": 427.73,
   "text": "یه شبی دو تا فرشته رو ایشون ملاحظه میکنه، زیارت میکنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 427.73,
   "end": 435.01,
   "text": "راه فنا رو تو دو جمله به شیخ رجب علی خیاط که بسیاری از علمای ما جلو ایشون زانو زدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 435.01,
   "end": 438.89,
   "text": "میآموزه و اون دو جمله رو الحمدالله شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 438.89,
   "end": 441.47,
   "text": "پرده‌برداری کردن. ببینید چقدر عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 441.47,
   "end": 446.01,
   "text": "فرمودن جمله اول \"از پیش خود هیچ مگو.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.01,
   "end": 449.97,
   "text": "دوم فرمود \"و غیر از خدا هیچ مخواه.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.97,
   "end": 454.53,
   "text": "از پیش خود هیچ مگو یعنی پاکسازی زبان، زبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 454.53,
   "end": 457.91,
   "text": "که ما متاسفانه غالباً کارشناسیم تو همه موارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 457.91,
   "end": 461.17,
   "text": "در خیلی جاهایی که اشکال کار ما اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.17,
   "end": 466.23,
   "text": "متخصص نیستیم، رای میدیم، نظر میدیم تو بحث‌های مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 466.23,
   "end": 471.27,
   "text": "و دومی‌شم که و غیر از خدا هیچ مخواه هم که میشه همون اخلاص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 471.27,
   "end": 478.35,
   "text": "خلوص. ببینید دو تا جمله‌ست میگه فرشته به ما راه فناءالله که بالاترین مراتب قرب هست رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 478.35,
   "end": 480.17,
   "text": "به ما یاد داده شیخ رجب علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 480.17,
   "end": 482.25,
   "text": "اینا پرده‌برداری‌هایی که ببینید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.25,
   "end": 491.27,
   "text": "می‌بینید یه حدیثو میذاری کنار آیه قرآن، تفسیر قرآن، کلمات بزرگان همه با هم چفت میشه، همه با هم جوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 491.27,
   "end": 493.85,
   "text": "منم که متاسفانه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 493.85,
   "end": 496.47,
   "text": "اِاِاِ پازل رو درست نچیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 496.47,
   "end": 500.57,
   "text": "تو وجودم و تو زندگیم برای همین همیشه دچار سردرگمی‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 500.57,
   "end": 504.83,
   "text": "یه نکته خیلی مهمی دیگه میمونه که اگه توفیق شد فردا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 504.83,
   "end": 506.97,
   "text": "آـ اگر این قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 506.97,
   "end": 510.21,
   "text": "کارکردش باید خشیت باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 510.21,
   "end": 513.23,
   "text": "خب ما داریم که \"القلب حرم الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 513.23,
   "end": 515.59,
   "text": "قلب حرم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.59,
   "end": 518.13,
   "text": "حرم خدا یعنی باید دچار خشیت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.13,
   "end": 520.31,
   "text": "این رو باید توضیح بدیم انشاالله فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 520.31,
   "end": 525.59,
   "text": "عاقبتمون به امید خدا به ختم بخیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 525.59,
   "end": 527.97,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 527.97,
   "end": 534.31,
   "text": "صل على محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}