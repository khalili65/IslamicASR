 "chapters": [
  {
   "index": 0,
   "title": "## سوره در نافله؛ استثناهای نماز خاص",
   "start": 0.12,
   "end": 75.94
  },
  {
   "index": 1,
   "title": "## فرق خشیت و خوف",
   "start": 75.94,
   "end": 117.88
  },
  {
   "index": 2,
   "title": "## خشوع باطن و خضوع ظاهر",
   "start": 117.88,
   "end": 200.84
  },
  {
   "index": 3,
   "title": "## خوف انبیا غیر از خشیت",
   "start": 200.84,
   "end": 440.51
  },
  {
   "index": 4,
   "title": "## حکایت منصور عمار و جوان خائف",
   "start": 440.51,
   "end": 580.71
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 5.5,
   "text": "خبره عزیزمون جانم به فرداش استفتاء شده که آیا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.5,
   "end": 8.46,
   "text": "سوره رو نخوند در نماز مستحبی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.46,
   "end": 11.68,
   "text": "آقا فرمودن که همونطور که همه مراجع فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.68,
   "end": 14.5,
   "text": "بله میشه سوره رو به جز حمد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.5,
   "end": 17.06,
   "text": "سوره رو نخوند. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.06,
   "end": 26.06,
   "text": "یه اما رهبر دارن. اونم اینکه وقتی بعضی از نمازهای مستحبی رو که یه سوره خاصی درش خونده میشه رو وقتی نیت می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.06,
   "end": 29.04,
   "text": "باید اون سوره رو بخونی و الا دیگه اون نماز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.04,
   "end": 33.32,
   "text": "مثلا ش-- اینو خود رهبر می فرمایند مثالم مال رهبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.32,
   "end": 38.3,
   "text": "اینکه اگر شما مثلا نیت کنی نماز حضرت جعفر طیار علیه السلام بخونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.3,
   "end": 41.98,
   "text": "خب اگر سوره نخونی که دیگه نماز جعفر طیار نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.98,
   "end": 47.02,
   "text": "رکعت اول باید زلزال بخونی، دوم عادیات بخونی، سوم نص بخونی، چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.02,
   "end": 50.0,
   "text": "چی اون دو تا رکعت بعدی؟ حمد چه قل هوالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.0,
   "end": 56.64,
   "text": "اگه اینا رو نخونی یا نماز امیرالمؤمنین هر چهار رکعت، هر رکعت پنجاه تا قل هوالله داره بعد از حمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.64,
   "end": 60.62,
   "text": "شما دلت خوش باشه که نماز امیرالمؤمنین نیت کردم ولی فقط حمد خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.62,
   "end": 64.52,
   "text": "نمیشه که پنجاه تا قل هوالله داره هر رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.52,
   "end": 67.32,
   "text": "پس اون نمازهای خاص باید سورش خونده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.32,
   "end": 69.7,
   "text": "در غیر این صورت اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.7,
   "end": 72.7,
   "text": "یعنی یه نماز دیگه‌ای میشه اگه شما سورش رو نخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.7,
   "end": 75.94,
   "text": "اصلا دیگه اون فضیلت رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.94,
   "end": 84.86,
   "text": "موضوع ما قلب خاشع بود و انقدر این موضوع مهمه من یه ذره بیشتر روش توقف کردم مثل قلب مطمئن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.86,
   "end": 88.74,
   "text": "یه نکته‌ای رو امروز بگم شاید توجه نکردیم این چند روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.74,
   "end": 91.96,
   "text": "فرق خشیت با خوف چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.96,
   "end": 95.9,
   "text": "ما می‌شنویم خشیت از خدا، خوف از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.9,
   "end": 98.26,
   "text": "این دو تا با هم چه فرقی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.26,
   "end": 103.76,
   "text": "آیا قلب خاشع لاجرم قلب خائف هم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.76,
   "end": 109.72,
   "text": "که در قرآن می‌فرماید؟ مرحوم راغب اصفهانی در کتاب مفرداتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.72,
   "end": 113.88,
   "text": "فرق خشیت و خوف رو اینچنین بیان می‌کنه که خشیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.88,
   "end": 117.16,
   "text": "خوف توأم با تعظیم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.16,
   "end": 121.06,
   "text": "و بیشتر از دانایی ناشی می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.06,
   "end": 125.28,
   "text": "و اشاره می‌کنه به آیه بیست و هشت سوره فاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.28,
   "end": 129.2,
   "text": "که من دیدم علامه طباطبایی هم در الکفایه همین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.2,
   "end": 132.26,
   "text": "استناد کردن و همین نظر رو پذیرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.26,
   "end": 137.64,
   "text": "استناد کردن به این آیه که \"إنما يخشى الله من عباده العلماء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.64,
   "end": 140.68,
   "text": "خشیت توأم با تعظیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.68,
   "end": 144.34,
   "text": "یعنی شما برای اون چیزی که ازش ترس کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.34,
   "end": 146.92,
   "text": "خوف کردی، عظمت قائلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.92,
   "end": 151.64,
   "text": "حالا احتمال داره انسان از مریضی هم بترسه اما برای مریضی که تعظیم قائل ني--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.64,
   "end": 156.64,
   "text": "تعظیم نمی‌کنه که. عظمت قائل نیست که، مهابت قائل نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.64,
   "end": 162.28,
   "text": "شاید انسان یه دفعه یه صدای ترسناکی بشنوه، یه سگی از کنارش رد بشه پارس بکنه بترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.28,
   "end": 167.6,
   "text": "اینکه خشیت نمیشه چون برای اون سگ عظمت اعوذ بالله عظمت قائل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.6,
   "end": 170.66,
   "text": "خشیت برخاسته از قلب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.66,
   "end": 174.68,
   "text": "و ناگهانی نیست، نا خصوصیت باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.68,
   "end": 177.08,
   "text": "و خاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.08,
   "end": 181.0,
   "text": "به طور اختصاص که این آیه می‌فرماید مخصوص علم و دانشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.0,
   "end": 185.1,
   "text": "یعنی محال کسی به خشیت رسیده باشه اما معرفت نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.1,
   "end": 189.66,
   "text": "محال کسی معرفت نداره به علم و دانش دست پیدا نکرده و خشیت داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.66,
   "end": 192.88,
   "text": "اصلا نمیشه. و از خصوصیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.88,
   "end": 197.86,
   "text": "خود بارز مثلاً انبیا همین خشوع، خشوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.86,
   "end": 199.96,
   "text": "البته خشوع در غیب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.96,
   "end": 204.98,
   "text": "مثلاً علامه طباطبایی در تفسیر المیزان می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.98,
   "end": 211.16,
   "text": "اونجا که می‌فرماد بحث خشیت مربوط به نه-نهانه است به قلب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.16,
   "end": 217.96,
   "text": "بعد می‌فرماید که البته این نهان هست که به خشیت میفته نه ظاهر انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.96,
   "end": 221.42,
   "text": "ما قبلا گفتیم خضوع مربوط به ظاهره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.42,
   "end": 223.76,
   "text": "خشوع مربوط به باطنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.76,
   "end": 232.68,
   "text": "و در پنهان و در علن یعنی در نهان و در آشکار طرف به خشیت و ترس از خدا میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.68,
   "end": 236.6,
   "text": "نمیشه کسی خودش رو ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.6,
   "end": 238.96,
   "text": "مثلاً دچار خشیت نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.96,
   "end": 243.28,
   "text": "مثلا سرش رو بذاره پایین و یه حالتی مثلا سرکج نماز بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.28,
   "end": 248.6,
   "text": "و بگیم این خشیت داره در حالی که در نهان و در غیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.6,
   "end": 253.76,
   "text": "و در جایی که از چشم‌ها پنهانه گناه بکنه راحت و از خدا نترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.76,
   "end": 256.0,
   "text": "نمیشه این دو تا باید با هم جمع شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.0,
   "end": 258.82,
   "text": "علامه طباطبایی اینجا که میفرع-- میف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.82,
   "end": 261.38,
   "text": "میرسه توصیه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.38,
   "end": 263.28,
   "text": "و به آیه اه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.28,
   "end": 266.28,
   "text": "سی و نه سوره احزاب اشاره می‌کنه علامه طباطبایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.28,
   "end": 268.64,
   "text": "می‌فرماید \"و لا يخشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.64,
   "end": 272.1,
   "text": "أحدا إلا الله\" که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.1,
   "end": 275.26,
   "text": "خشیت توصیف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.26,
   "end": 280.16,
   "text": "انبیاست در قرآن. اینا انبیا فقط از خدا می‌ترسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.16,
   "end": 283.08,
   "text": "این فقط از خدا ترسیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.08,
   "end": 286.5,
   "text": "نه از هیچ چیز دیگه‌ای. اولا نشون میده خشیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.5,
   "end": 293.42,
   "text": "مخصوص خداست. شما از چیز دیگه‌ای خشیت نداری، از مریضی خشیت نداری، از حیوان خشیت نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.42,
   "end": 296.74,
   "text": "دوما اینکه این خشیت قلبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.74,
   "end": 300.18,
   "text": "سوما اینکه در نهان و آشکار هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.18,
   "end": 302.2,
   "text": "که حالا آیه دیگه‌ای رو میاره من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.2,
   "end": 305.92,
   "text": "فعلا این بحث رو پختش کنم با دو تا آیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.92,
   "end": 310.66,
   "text": "مثلا علامه می‌فرماید که اینجا که می‌فرمود خشیت مخصوص خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.66,
   "end": 313.78,
   "text": "و خوف از چیزای دیگه‌ای هم هست این آیات رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.78,
   "end": 320.96,
   "text": "ببینید آیه شصت و هفت سوره طه رو ببینید \"فأوجس في نفسه خيفة موسى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.96,
   "end": 324.7,
   "text": "میگه موسی تو خودش احساس ترس کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.7,
   "end": 328.82,
   "text": "یا آیه پنجاه و هشت انfal رو می‌فرماید \"و أما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 328.82,
   "end": 334.4,
   "text": "و أما تخافن من قوم خيانة\" میگه اگه ترس خیانت داشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.4,
   "end": 336.72,
   "text": "ببین ترس خوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.72,
   "end": 340.1,
   "text": "خیانت. اینجا داره به پیغمبرش نسبت میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.1,
   "end": 343.1,
   "text": "یا به حضرت موسی نسبت خوف میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.1,
   "end": 347.4,
   "text": "خائف از طرف حضرت موسی خیلی می‌ترسید اما این ترس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 347.4,
   "end": 351.7,
   "text": "نه ترس منظور خشیت، ترسه از چیزهای مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 351.7,
   "end": 355.68,
   "text": "حتی وقتی خواست بره پیش فرعون می‌ترسید تنها بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.68,
   "end": 359.58,
   "text": "گفت من زبانم مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.58,
   "end": 365.11,
   "text": "لکنت داشت حضرت موسی لکنت زبان داشت برادرم هارون رو با من همراه کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 365.11,
   "end": 370.97,
   "text": "اینا خ-خوف از چیز دیگه‌ای میشه اتفاق بیفته اما خشیت فقط از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 370.97,
   "end": 373.45,
   "text": "بعد اشاره میکنه علاوه به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.45,
   "end": 379.25,
   "text": "خشیت مربوط به ظاهر و باطن است به این آیه، دیگه این دیگه آخرشه دیگه این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.25,
   "end": 382.23,
   "text": "خیلی قشنگ اِاِاِ مقصود رو بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.23,
   "end": 387.25,
   "text": "آیه هجده سوره فاطر فرمود \"إنما تنذر الذين يخشون ربهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.25,
   "end": 390.85,
   "text": "بالغيب\". این إنما هم هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.85,
   "end": 393.93,
   "text": "میدونید عربیتون خوبه دیگه. یعنی فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.93,
   "end": 396.99,
   "text": "کسانی رو انذار میکنی یا رسول الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.99,
   "end": 399.59,
   "text": "که پروردگار خودشون رو از در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.59,
   "end": 402.39,
   "text": "پنهانی میترسن از پروردگارشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.39,
   "end": 405.21,
   "text": "یعنی میشه نشون میده که انذار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.21,
   "end": 412.57,
   "text": "انبیا فقط به دل کسایی تاثیر میکنه که خدا رو در آشکار و پنهانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.57,
   "end": 415.51,
   "text": "ملاحظه میکنن و میترسن از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.51,
   "end": 421.29,
   "text": "اینکه موعظه پیغمبر در دل یه عده تاثیر نمیکنه چون این‌ها خشیت ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 421.29,
   "end": 423.49,
   "text": "یعنی در باطن از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 423.49,
   "end": 427.51,
   "text": "نمیترسن در نهان یا از صفت بهشتیان آیه سی و سه قاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.51,
   "end": 429.81,
   "text": "فرمود \"من خشي الرحمان بالغيب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.81,
   "end": 432.09,
   "text": "بهشتی‌ها کسانی‌اند که بالغیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.09,
   "end": 435.27,
   "text": "تو پنهانی و در ق-قیاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.27,
   "end": 437.35,
   "text": "از خدا می‌ترسن، خشیت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.35,
   "end": 440.51,
   "text": "یعنی ظاهر و باطن‌شون این‌ها یکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.51,
   "end": 443.55,
   "text": "منصور عمار یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 443.55,
   "end": 447.95,
   "text": "حکایتی هست خیلی عجیبه بالاخره این‌ها به گوش ما یه ذره بخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.95,
   "end": 455.15,
   "text": "یه تلنگری شاید ایجاد کرد. میگه که منصور عمار میگفتم، \"می‌رفتم خانه خدا رو زیارت کنم تو راه از کوفه رد می‌شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 455.15,
   "end": 457.49,
   "text": "سحری نصف شب اومدم بیرون دیدم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.49,
   "end": 462.65,
   "text": "صدای مناجاتی از یه جوانی از خانه‌ای بلند گوش دادم دیدم داره با خدا مناجات می‌کنه.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.65,
   "end": 465.51,
   "text": "مناجاتش هم آورده تو حکایتش که چیا می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 465.51,
   "end": 470.75,
   "text": "خلاصه‌ش این بود که به خدا تضرع و زاری می‌کرد که خدایا من از رو عمد گناهت رو نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.75,
   "end": 472.61,
   "text": "اگه تو نبخشی کی به داد من برسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.61,
   "end": 475.73,
   "text": "کی منو از، از عذاب جهنم نجات بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.73,
   "end": 477.31,
   "text": "میگه من اومدم امتحانش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.31,
   "end": 481.65,
   "text": "این آیه س-- شش سوره تحریم و خوندم بلند، بلند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 481.65,
   "end": 484.95,
   "text": "بی انصاف چه آیه‌ای هم برای همچین کسی اون لحظه خونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 484.95,
   "end": 489.71,
   "text": "که \"يا أيها الذين آمنوا قوا أنفسكم وأهليكم نارا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.71,
   "end": 491.95,
   "text": "وقود الناس والحجارة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.95,
   "end": 494.81,
   "text": "عليها ملائكة شداد غلاظ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 494.81,
   "end": 498.11,
   "text": "آیه عذاب و جهنم و آتش و این‌ها رو براش میخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 498.11,
   "end": 501.21,
   "text": "میگه من تا این آیه رو خوندم دیدم صدای ناله‌ش بلند شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 501.21,
   "end": 504.13,
   "text": "یک ساعت داد زد و صداش خاموش شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 504.13,
   "end": 507.95,
   "text": "خونه رو نشون کردن. رفتم صبح برگشتم دیدم یه زنی هی میره داخل میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 507.95,
   "end": 509.61,
   "text": "گفتم چی شده؟ گفت مادرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.61,
   "end": 516.61,
   "text": "گفت آره این یکی از فرزندان رسول خدا که خیلی از خدا خائف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 516.61,
   "end": 519.63,
   "text": "دیشب یه آقایی رد میشد آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.63,
   "end": 526.67,
   "text": "شداد و غلاظ براش خوند و اینم از ترس و مهابت الهی و خشیت غش کرد و بعدم مرد از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.67,
   "end": 529.53,
   "text": "گفت خوش به حالش. گفتم تو دلم خوش به حالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 529.53,
   "end": 532.93,
   "text": "خوش به حالش چیه؟ پدرشو درآوردی با این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 532.93,
   "end": 539.63,
   "text": "میخوام بگم ببینید یه آیه چجوری تاثیر میکنه در دل انسان خائف در س-- دل انسان خاشع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 539.63,
   "end": 545.65,
   "text": "اگر قلم ما آیات الهی درش تاثیر نمی‌کنه علت اصلیش خلاصه بحث اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 545.65,
   "end": 548.99,
   "text": "اولا یخش-- اِاِاِ بخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 548.99,
   "end": 551.21,
   "text": "بحث خشیت الهی ما رو کیا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 551.21,
   "end": 555.43,
   "text": "علما. \"إنما يخش الله من عباده العلماء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.43,
   "end": 558.37,
   "text": "اولا عالم نیستیم. عن-- معرفتمون کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 558.37,
   "end": 562.45,
   "text": "دوما پنهان و آشکارمون با هم متفاوت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 562.45,
   "end": 566.95,
   "text": "اگر در آشکار می‌ترسیم، در پنهان نمی‌ترسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 566.95,
   "end": 569.25,
   "text": "این دو تا اشکال اصلی کار ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 569.25,
   "end": 573.79,
   "text": "انشاالله که عاقبت ما ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 573.79,
   "end": 580.71,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}