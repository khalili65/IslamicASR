 "chapters": [
  {
   "index": 0,
   "title": "## نذر؛ جریان صیغه بر زبان",
   "start": 1.4,
   "end": 54.96
  },
  {
   "index": 1,
   "title": "## امتحان الهی پیرامون فرزندان و نسل",
   "start": 54.96,
   "end": 212.76
  },
  {
   "index": 2,
   "title": "## شهید مصطفی خمینی و آه مادر انقلاب",
   "start": 212.76,
   "end": 233.48
  },
  {
   "index": 3,
   "title": "## ذریهٔ طیبه و نیت خواستن فرزند",
   "start": 233.48,
   "end": 619.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.4,
   "end": 4.58,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.58,
   "end": 8.12,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.12,
   "end": 12.76,
   "text": "آياته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.76,
   "end": 21.02,
   "text": "تو احکام وقف و نذر و این‌ها هستیم که از دیروز شروع کردیم چون خیلی مورد ابتلا و سؤال هست عرض می‌کنم که تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.02,
   "end": 26.86,
   "text": "صیغه نذر بر لسان کسی جاری نشه ادای اون نذر واجب نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.86,
   "end": 30.28,
   "text": "که عربیش لله علي است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.28,
   "end": 34.22,
   "text": "یعنی برای خداست بر من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.22,
   "end": 40.72,
   "text": "فارسیش هم همینه که ب-- مثلا خدایا اگر این حاجت منو دادی این کارو می‌کنم یا اگر این شد من این کارو می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.72,
   "end": 44.92,
   "text": "من به تو قول میدم. به هر حال در بر لسان انسان اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.92,
   "end": 48.0,
   "text": "اون صیغه نذر و نیت جاری شد واجب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.0,
   "end": 51.88,
   "text": "اگر جاری نشد بر لسان واجب نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.88,
   "end": 59.58,
   "text": "ادای اون نذر. نکته‌ای که دیروز گفتیم خیلی به جا و مهم بود پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.58,
   "end": 62.8,
   "text": "اهمیت امتحان الهی پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.8,
   "end": 68.34,
   "text": "بچه‌هامون، در خصوص فرزندانمون، در خصوص نسل‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.34,
   "end": 74.96,
   "text": "قطعاً و قطعاً و قطعاً خدای منان همه ما رو نسبت به فرزندان و نسل‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.96,
   "end": 77.7,
   "text": "مورد امتحان قرار می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.7,
   "end": 84.96,
   "text": "چه اینکه انبیا گذشته ما رو هم علیهم الصلاة والسلام رو مورد ابتلا و امتحان قرار داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.96,
   "end": 86.96,
   "text": "اعم از حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.96,
   "end": 90.46,
   "text": "پیرامون اون امتحان سنگینی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.46,
   "end": 92.9,
   "text": "باید اسماعیلش رو قربونی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.9,
   "end": 97.88,
   "text": "واقعاً تصورش عجیبه که یک پدر به دست خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.88,
   "end": 105.2,
   "text": "اگرچه به امر خداست اما به دست خودش بخواد جوان رشیدش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.2,
   "end": 108.44,
   "text": "اون چنین ذبح کنه، ذبح کنه این خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.44,
   "end": 110.5,
   "text": "امتحان بسیار سنگینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.5,
   "end": 114.74,
   "text": "شوخی نیست. واقعاً این پدر و مادرای شهدا امتحان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.74,
   "end": 122.08,
   "text": "عجیبی پس دادن. ما نجف آباد که بودیم خانواده‌های چند شهید عجیب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 122.08,
   "end": 123.76,
   "text": "با این‌ها شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.76,
   "end": 126.16,
   "text": "آدم تصورش رو می‌کنه تازه مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.16,
   "end": 130.22,
   "text": "یه سوزن تو دست بچه‌ت میره اذیت میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.22,
   "end": 132.1,
   "text": "یا مثلا به انواع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.1,
   "end": 136.84,
   "text": "انواعش دیگه یا بعضی از انبیا رو اصلاً بچه نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.84,
   "end": 142.88,
   "text": "پیر شدن بچه داد. خود حضرت ابراهیم رو در پیری حدوداً میگن هفتاد سالگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.88,
   "end": 147.16,
   "text": "یا حضرت زکریا رو که یحیی رو بهش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.16,
   "end": 152.24,
   "text": "و جالبه که باز خود یحیی رو همون جوونی از زکریا گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.24,
   "end": 157.22,
   "text": "مثل حضرت علی اکبر که خدا فرمود اگر از همه عالم بگذرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.22,
   "end": 159.2,
   "text": "از قاتل دو کس نمی‌گذرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.2,
   "end": 163.82,
   "text": "یکی حسین ابن علی، یکی هم حضرت یحیی ابن زکریا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.82,
   "end": 167.98,
   "text": "یک جوان رشید که داستانش مفصل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.98,
   "end": 171.98,
   "text": "امتحان دادن یا حتی در خصوص حضرت ایوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.98,
   "end": 180.74,
   "text": "فرزندانشو گرفت. می‌دونید دیگه حضرت ایوب به یک باره تم-- خیلی وا-- وضع مالیش خوب بوده، تمکن داشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.74,
   "end": 185.18,
   "text": "خدم و حشم داشته، چقدر گله گوسفند و گاو و شتر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.18,
   "end": 188.28,
   "text": "و چقدر بچه‌های خوب و سرحال و باایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.28,
   "end": 190.16,
   "text": "همه رو یه شبه خدا گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.16,
   "end": 195.4,
   "text": "بعد خودشم بدنش به فیضی افتاد طوری که کرم‌ها رو بدنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.4,
   "end": 200.82,
   "text": "حرکت می‌کردن. این کرم‌ها می‌افتاد می‌ذاشت رو زخم‌هاش می‌گفت رزق شما رو خدا اینجا قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.82,
   "end": 203.08,
   "text": "هرچی زور زد شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.08,
   "end": 205.66,
   "text": "که اینو به ناشکری بندازه نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 205.66,
   "end": 209.82,
   "text": "ببینید خیلی نمونه‌های زیادی در تاریخ هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.82,
   "end": 212.76,
   "text": "در تاریخ انبیا بگیر تو برو تا جاهای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.76,
   "end": 216.4,
   "text": "خود حضرت امام ما وقتی شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.4,
   "end": 219.22,
   "text": "مصطفی خمینی رو که شهید کردن امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.22,
   "end": 222.76,
   "text": "فرمودن از الطاف خفیه الهیه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.76,
   "end": 225.04,
   "text": "در حالی که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.04,
   "end": 228.4,
   "text": "امام دوست داشته ایشون رو در تاریخ می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.4,
   "end": 236.12,
   "text": "خدا رحمت کنه مادر انقلاب رو، همسر امام رو که هیچ‌وقت من این آه دل ایشون یادم نمیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.12,
   "end": 243.34,
   "text": "که تا آخرین لحظات عمرش هر ساله سالگرد شهید مصطفی خمینی تو انقلاب خودمون بدبختی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.34,
   "end": 251.2,
   "text": "که می‌رسید هیچ خبری تو رسانه از شهید مصطفی خمینی نبود که امام می‌فرمود اون ذخیره انقلاب و اسلام بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.2,
   "end": 255.38,
   "text": "می‌دونستن کیو بگیرن. ایشون آه می‌کشید مادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.38,
   "end": 257.82,
   "text": "شهید خمینی، همسر امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.82,
   "end": 260.04,
   "text": "که باز هم سالگرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.04,
   "end": 263.72,
   "text": "پسر ما رسید و گذشت و خبری از او تو رسانه‌ها نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.72,
   "end": 266.18,
   "text": "خب این آه، این درده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 266.18,
   "end": 269.5,
   "text": "حالا امتحانات سنگینی گرفته شده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.5,
   "end": 275.14,
   "text": "حتی در ندادنش یعنی بعضیا در نداشتن فرزند امتحان میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.14,
   "end": 284.1,
   "text": "و بعضیا در داشتن. یعنی در حقیقت کلاً یکی از امتحانات سنگین الهی پیرامون داشتن و نداشتن فرزند است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 284.1,
   "end": 287.74,
   "text": "انقدر هم مهمه. اولاً موضوع بقای نسل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 287.74,
   "end": 290.1,
   "text": "یعنی همونطور که علامه فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 290.1,
   "end": 296.24,
   "text": "غریزه شهوت جهت انشای صورت انسانیست، نه اطفاء شهوت حیوانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 296.24,
   "end": 299.28,
   "text": "بقای نسل. اصلاً موضوع بقا خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 299.28,
   "end": 302.92,
   "text": "اینکه انسان نسلی از خودش باقی بگذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.92,
   "end": 307.36,
   "text": "باقی یعنی مظهر اسم باقی خدا بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.36,
   "end": 310.94,
   "text": "بقیت الله مظهر اسم باقی خداست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.94,
   "end": 314.14,
   "text": "خب این فرزند حضرت زهرا سلام الله علیهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.14,
   "end": 318.42,
   "text": "اینکه انس-- این همه دعا ما در قرآن داریم رب اجعلنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.42,
   "end": 325.0,
   "text": "مقیم الصلاة ومن ذریتی ربنا وتقبل دعاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.0,
   "end": 328.56,
   "text": "خدای منو و ذریه‌امو اهل نماز قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.56,
   "end": 332.52,
   "text": "یعنی شما از خدا ذریه داری می‌خوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 332.52,
   "end": 338.0,
   "text": "یا رب هب لی حضرت زکریا عرض کرد به خدا رب هب لی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 338.0,
   "end": 339.96,
   "text": "من لدنک ذریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 339.96,
   "end": 343.26,
   "text": "طیبه إنك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.26,
   "end": 348.48,
   "text": "سميع الدعاء. اینکه من از تو می‌خوام چون اصلاً تو شنوایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 348.48,
   "end": 354.44,
   "text": "ذات تو شنواست. برای همین دارم با تو گفتگو و نجوا می‌کنم و من از تو ذریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 354.44,
   "end": 356.88,
   "text": "طیبه می‌خوام. ذریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 356.88,
   "end": 360.02,
   "text": "طیبه، ذریه مقیم صلات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 360.02,
   "end": 365.1,
   "text": "ربنا تو اون دعایی که عرض کردیم تو سوره فرقان باید باشه اگه اشتباه نکنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.1,
   "end": 371.06,
   "text": "که حضرت امیرالمؤمنین علیه الصلاة والسلام حضرت وصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.06,
   "end": 375.04,
   "text": "هر-همیشه در قرائت نمازش این دعا رو می‌خونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.04,
   "end": 383.32,
   "text": "غالبا تو قرائت نمازش \"ربنا هب لنا من ازواجنا و ذریاتنا قرة اعین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.32,
   "end": 387.6,
   "text": "عجب \"واجعلنا للمتقین اماما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.6,
   "end": 390.36,
   "text": "خدایا فرزندانی به من بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.36,
   "end": 392.68,
   "text": "همسران و فرزندانی به من بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 392.68,
   "end": 394.56,
   "text": "این ذریه من چی باشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 394.56,
   "end": 400.76,
   "text": "نور چشم من باشن و از اون عجیب‌تر \"واجعلنا للمتقین اماما\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 400.76,
   "end": 406.32,
   "text": "برای اهل تقوا پرچمدار و جلودار و امام باشن، پیشوا باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 406.32,
   "end": 409.42,
   "text": "اساسا خواستن فرزند هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.42,
   "end": 413.12,
   "text": "سر دارد، رمز دارد که انسان برای چی فرزند بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.12,
   "end": 414.88,
   "text": "اصلا فرزند بخواد فدا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 414.88,
   "end": 417.28,
   "text": "جالبه که حضرت زکریا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 417.28,
   "end": 420.58,
   "text": "وقتی قصه امام حسین رو توی تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 420.58,
   "end": 424.62,
   "text": "روایت امام عصر سلام الله علیه کاف ها یا عین صاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 424.62,
   "end": 427.54,
   "text": "همه شنیدید که تفسیر کربلاش شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.54,
   "end": 430.4,
   "text": "انقدر سه شبانه روز گریه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.4,
   "end": 433.82,
   "text": "برای ابی عبدالله و از علی اکبرش و بچه‌هاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.82,
   "end": 440.02,
   "text": "تا خدا بهش گفت چی می‌خوای؟ حضرت زکریا چی می‌خوای تو آخه انقدر گریه می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 440.02,
   "end": 444.84,
   "text": "حضرت زکریا گفت می‌خوام به من فرزندی بدی مثل علی اکبر، امام حسین از من بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 444.84,
   "end": 448.08,
   "text": "من یه ذره بچشم درد حسین بن علی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.08,
   "end": 451.06,
   "text": "ببینید د-نیت رو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 451.06,
   "end": 454.66,
   "text": "و خدا زک-حضرت یحیی رو به او میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 454.66,
   "end": 459.72,
   "text": "می‌خوام عرض کنم که آدم باید بدونه اصلا بچه برای چی می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 459.72,
   "end": 462.0,
   "text": "صرفا اینکه پز بده بهش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 462.0,
   "end": 466.3,
   "text": "بچه‌ت جلوت راه بره و قد و بالاشو ببینی و خب که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 466.3,
   "end": 472.7,
   "text": "حتی بقای نسل هم باید مبنا داشته باشد، معیار داشته باشد، هدفمند باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 472.7,
   "end": 474.98,
   "text": "تو برای چی بچه دار میشی؟ همینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 474.98,
   "end": 478.5,
   "text": "بچه بریز تو صحنه اجتماع و نه تربیتی نه هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 478.5,
   "end": 482.7,
   "text": "باید برای اونم هدف داشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 482.7,
   "end": 485.08,
   "text": "البته بقا خودش خیلی من-مهم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 485.08,
   "end": 487.52,
   "text": "عرض کردیم که اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.52,
   "end": 496.4,
   "text": "حالا متاسفانه روی عرض شود این آگهی‌های فوت می‌نویسن این آیه رو که \"کل من علیها فان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 496.4,
   "end": 498.96,
   "text": "و يبقى وجه ربک ذو الجلال والاکرام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 498.96,
   "end": 501.6,
   "text": "این اصلا بحث مرگ نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 501.6,
   "end": 506.46,
   "text": "اصلا هم شما به من بگید آیا کسی میمیره فانی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 506.46,
   "end": 508.58,
   "text": "اصلا کسی میمیره فانی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 508.58,
   "end": 511.96,
   "text": "اگه اینطور مرگ رو ما شناختیم که خیلی بیچاره‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 511.96,
   "end": 513.64,
   "text": "کی گفته کسی میمیره فانی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 513.64,
   "end": 516.28,
   "text": "تازه میره به یک مرتبه بالاتر و نورانی‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 516.28,
   "end": 521.3,
   "text": "به یک جهان از حرم نش شمس تر از این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.3,
   "end": 522.88,
   "text": "و این ب-فانی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 522.88,
   "end": 527.34,
   "text": "میگه و هو بکل شیء محیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 527.34,
   "end": 530.1,
   "text": "خدا به همه چی احاطه کامل دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 530.1,
   "end": 534.32,
   "text": "محیت است. محاط در محیط همیشه فانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 534.32,
   "end": 538.42,
   "text": "نه یعنی کلا از بین می‌رود، نه مثل شکری که تو آب به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 538.42,
   "end": 540.88,
   "text": "حکما شکری که تو آب حل بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 540.88,
   "end": 546.38,
   "text": "فانی شده. نه از بین بره یعنی در تحت اراده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 546.38,
   "end": 549.5,
   "text": "محیط قرار می‌گیره، محاط شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.5,
   "end": 553.66,
   "text": "یعنی میره محو میشه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 553.66,
   "end": 560.18,
   "text": "محیط. این \"کل من علیها فان\" یعنی تو محو اراده خدا بشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 560.18,
   "end": 565.58,
   "text": "در مسیر ادا-- اراده و خواست و مشیت خدا حرکت کنی، بچه‌هاتم اینطوری بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 565.58,
   "end": 568.14,
   "text": "اون موقع است که باقی میشی. اصلا فنا عین بقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 568.14,
   "end": 572.6,
   "text": "کی گفته از بین رفتنه؟ و این با نسل صالح و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 572.6,
   "end": 574.6,
   "text": "ذریه طیبه امکان‌پذیر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 574.6,
   "end": 580.14,
   "text": "از خدا بخواهیم. ختم کلام توصیه می‌کنم دو مرتبه یکی با این دعاها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 580.14,
   "end": 582.8,
   "text": "یکی هم با اون نماز والدین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 582.8,
   "end": 587.34,
   "text": "قبلا عرض شده خدمتتون آقای بهجت سفارش کردن کتاب بهجت و دعا هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 587.34,
   "end": 589.92,
   "text": "نماز والدین در حق فرزند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 589.92,
   "end": 592.36,
   "text": "نماز هدایت فرزند بر گردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 592.36,
   "end": 596.4,
   "text": "پدر. خیلی نماز قشنگیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 596.4,
   "end": 600.12,
   "text": "که آقای بهجت سفارش می‌کردن حتی به جای نماز شبتون اینو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 600.12,
   "end": 602.46,
   "text": "کتاب چی؟ بهجت و دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 602.46,
   "end": 604.4,
   "text": "اگه کسی خواست من عکسشو دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 604.4,
   "end": 606.44,
   "text": "عکس این نماز رو تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.44,
   "end": 612.72,
   "text": "گوشیم هست بهش بدم. انشاالله عاقبت ما ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 612.72,
   "end": 619.3,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}