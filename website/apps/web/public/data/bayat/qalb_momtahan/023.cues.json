 },
 "chapters": [
  {
   "index": 0,
   "title": "## نذر زن و اذن شوهر؛ تفکیک از تصرف مال",
   "start": 0.34,
   "end": 62.14
  },
  {
   "index": 1,
   "title": "## قلب ممتحن و تقوا؛ خروجیِ برکت",
   "start": 62.14,
   "end": 661.69
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 4.16,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.16,
   "end": 12.4,
   "text": "السلام علیک یا داعی الله و ربانی ایاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.4,
   "end": 17.46,
   "text": "آیا زن اجازه دارد که بدون اذن شوهر نذر کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.46,
   "end": 20.0,
   "text": "ولو از اموال خودش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.0,
   "end": 25.18,
   "text": "سوالی که از رهبر عزیزمون شده حضرت فرمودند که نه خیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.18,
   "end": 28.1,
   "text": "نمی‌تونه نذر بدون اذن شوهر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.1,
   "end": 30.2,
   "text": "البته این به معنای عدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.2,
   "end": 32.64,
   "text": "اذن تصرفه یعنی این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.64,
   "end": 36.58,
   "text": "این معنا نیست که اذن تصرف در مال خودش رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.58,
   "end": 40.66,
   "text": "زن می‌تونه در تس، در مال خودش تصرف بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.66,
   "end": 47.64,
   "text": "لکن اینکه فرمودند بدون اذن شوهر حتی از مال خودش هم نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.64,
   "end": 51.68,
   "text": "نذر کنه یعنی این نذر واجب الوفا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.68,
   "end": 57.28,
   "text": "این نکته‌ست. و الا خب در اموال خودش که می‌تونه تصرف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.28,
   "end": 60.62,
   "text": "خب بحث ما پیرامون قلب ممتحن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.62,
   "end": 65.84,
   "text": "هرچی من می‌خوام بحث این بحث قلب ممتحن رو جمع کنم سفره‌ش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.84,
   "end": 69.88,
   "text": "نکاتی به ذهن متبادر می‌شه و مهم دلم نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.88,
   "end": 73.44,
   "text": "نکته دیگری رو امروز عرض کنم بر اساس همون آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.44,
   "end": 76.48,
   "text": "اولی که روز اول ما شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.48,
   "end": 79.36,
   "text": "حدود بیست جلسه پیش بود یادم نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.36,
   "end": 85.42,
   "text": "بحث کردیم پیرامون قلب ممتحن که می‌فرمود \"الذي امتحن الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.42,
   "end": 88.08,
   "text": "قلوبهم للتقوی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.08,
   "end": 91.12,
   "text": "اصلاً اساس امتحان ما از این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.12,
   "end": 95.28,
   "text": "از قلب‌ها و دل‌ها و جان‌های این‌ها پیرامون تقواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.28,
   "end": 99.36,
   "text": "حول تقواست. تقوی درست باید معنا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.36,
   "end": 103.12,
   "text": "تقوی اگر تقوی باشد خروجی‌ش برکت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.12,
   "end": 105.76,
   "text": "و اگر تقوی نباشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.76,
   "end": 109.22,
   "text": "بی‌برکتی‌ست. این قطعی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.22,
   "end": 115.82,
   "text": "و بر اساس همون آیه‌ای که همه هم حفظید \"و من یتق الله\" متاسفانه اکثراً با،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.82,
   "end": 118.5,
   "text": "با دید پول و دنیا به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.5,
   "end": 120.9,
   "text": "آیه شریف نگاه می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.9,
   "end": 124.38,
   "text": "که \"و من یتق الله يجعل له مخرجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.38,
   "end": 127.52,
   "text": "و يرزقه من حيث لا يحتسب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.52,
   "end": 132.14,
   "text": "خیلی عجیب است این دو تا نکته که خروج از بن‌بست‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.14,
   "end": 134.62,
   "text": "در نتیجه تقوی. یکی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.62,
   "end": 139.9,
   "text": "رزق حيث لا يحتسب جایی که طرف گمان نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.9,
   "end": 142.16,
   "text": "از امام صادق صلوات الله علیه فرمود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.16,
   "end": 144.9,
   "text": "سؤال کردن که آیا این رزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.9,
   "end": 148.26,
   "text": "جای، از جایی که گمانش رو نمی‌بره یعنی پولش زیاد می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.26,
   "end": 151.2,
   "text": "حضرت اینجا نکته بسیار ظریفی رو فرمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.2,
   "end": 154.54,
   "text": "نه خیر، بلکه برکت پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 154.54,
   "end": 158.88,
   "text": "شاید رزقش ظاهراً کمه اما میگه نمی‌دونم اصلاً از کجا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.88,
   "end": 162.92,
   "text": "درسته؟ توجه کردی آدمی که برکت نداره تو عمرش شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.92,
   "end": 165.5,
   "text": "ماهی ده میلیون هم مثل بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.5,
   "end": 171.1,
   "text": "مدیران بیکار ما حقوق می‌گیرن اما میگن نمی‌دونم کجا میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.1,
   "end": 174.04,
   "text": "این پولا نمی‌دونم کجا میره، کجا خرج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 174.04,
   "end": 178.96,
   "text": "اما بعضی از کارمندای پرکار ما که مسئولیت خاصی هم می‌بینن و ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 178.96,
   "end": 181.82,
   "text": "اینا میگن نمی‌دونم از کجا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.82,
   "end": 185.5,
   "text": "چرا؟ این برکته دیگه. حالا این معنای برکت خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 185.5,
   "end": 187.74,
   "text": "اصلاً خود تقوی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 187.74,
   "end": 192.68,
   "text": "نه یعنی صرفاً ترک از گن، ترک گناه و از-- معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 192.68,
   "end": 197.66,
   "text": "تقوی ترجمه‌ای که ازش متاسفانه به صورت دبستانی می‌شه میگن ترکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.66,
   "end": 201.0,
   "text": "در حالی که هم ترک رو تشکیل میده هم فعل رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.0,
   "end": 207.68,
   "text": "زیباترین ترجمه رو هم به نظرم علامه جوادی آملی کردن بارها عرض کردیم خدمتتون که فرمودند رعایت حدود الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 207.68,
   "end": 210.12,
   "text": "این حدود می‌تون، می‌تونه واجبات باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 210.12,
   "end": 213.24,
   "text": "حتی می‌تونه تو حوزه مستحبات باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.24,
   "end": 216.04,
   "text": "اساساً اینو من به شما عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.04,
   "end": 220.02,
   "text": "که هر امتحانی که خدا این جان مطلبه دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.02,
   "end": 224.66,
   "text": "کلید مطلبه. هر امتحانی خدا از ما می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 224.66,
   "end": 227.8,
   "text": "مترصد بر این هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 227.8,
   "end": 235.14,
   "text": "کنش یا واکنش یا به عبارتی بهتره بگیم عمل و عکس العمل یا ترک و فعل ما اونجا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.14,
   "end": 237.52,
   "text": "هر امتحانی از ما می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.52,
   "end": 242.08,
   "text": "هرچی ببینه ما ترک یا فعل‌مون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 242.08,
   "end": 244.48,
   "text": "این کل ما مخلص امتحان ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 244.48,
   "end": 247.06,
   "text": "خلاصه امتحان ماست که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 247.06,
   "end": 249.58,
   "text": "ترکمون چیه؟ فعل‌مون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.58,
   "end": 255.4,
   "text": "مثالی که بعد البته اگر این ترک و فعل بر اساس حدود الهی یعنی تقوی بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.4,
   "end": 258.1,
   "text": "برکت میاد. قطعاً برکت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 258.1,
   "end": 262.3,
   "text": "اما اگر کسی بر اساس حدود الهی ترک و فعل نداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.3,
   "end": 264.84,
   "text": "در امتحانات برکت میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.84,
   "end": 267.28,
   "text": "قطعاً میره. تو هر قصه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 267.28,
   "end": 270.7,
   "text": "اینکه اون پسری که جریانش توی هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 270.7,
   "end": 277.42,
   "text": "سوره بقره اومده که گاو بنی اسرائیل و خدا چطور گاو این پسر رو و این پدر رو اختیار می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.42,
   "end": 283.12,
   "text": "که آخر سر ب-- مجبور می‌شن بنی اسرائیل به وزن این گاو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.12,
   "end": 288.52,
   "text": "سکه بهش بدن که دیگه تا آخر عمرش بسه دیگه میلیاردی به قول ما بهش ثروت می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.52,
   "end": 290.78,
   "text": "چرا؟ فکر می‌کنید دلیل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.78,
   "end": 294.88,
   "text": "یک آن مواجه می‌شه با یه امتحان الهی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 294.88,
   "end": 298.32,
   "text": "این کلیدهای قدیم هم مثل الان کوچک نبوده کامپیوتری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 298.32,
   "end": 302.02,
   "text": "که کلیدهای بزرگ زیر متکای باباش خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.02,
   "end": 307.64,
   "text": "یه حالا توی انبار پر گندم آماده خرید و فروشه که میاد یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.64,
   "end": 311.76,
   "text": "به هر حال بار خوبی ازش بخره سود کلانی بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.76,
   "end": 313.7,
   "text": "اما می‌بینه بابا خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.7,
   "end": 317.62,
   "text": "دقت کنید این نکته‌ست. بیدار نمی‌کنه بابا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 317.62,
   "end": 320.88,
   "text": "این ترکه. ترک می‌کنه عمل رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 320.88,
   "end": 323.8,
   "text": "چون کاری می‌کنه که تو چشم خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 323.8,
   "end": 328.52,
   "text": "عزیزه، عاشق می‌شه به قول شهید حججی خدا عاشقش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.52,
   "end": 330.94,
   "text": "به خاطر این کارش برکت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 330.94,
   "end": 334.18,
   "text": "به این میگن برکت. اصلاً زایده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 334.18,
   "end": 339.24,
   "text": "نمره بیست در امتحان الهی چه در ترک چه در فعل برکت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.24,
   "end": 340.98,
   "text": "شک نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.98,
   "end": 344.48,
   "text": "یا فعلش مثلاً فعلش رو مثال بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 344.48,
   "end": 348.24,
   "text": "عرض کنم خدمتتون مثل قصه حضرت س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.24,
   "end": 352.78,
   "text": "حضرت اسماعیل که بابا وقتی گفت من خواب دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 352.78,
   "end": 356.86,
   "text": "انی اران عرض شود ارانی في المنام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 356.86,
   "end": 362.52,
   "text": "از بهک من خواب دیدم در، که تو رو ذبح کردم حضرت اسماعیل بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 362.52,
   "end": 365.85,
   "text": "درنگ بابا جان هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.85,
   "end": 370.49,
   "text": "اف alma tu أمر هرچی که به تو امر شده همونو انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.49,
   "end": 372.03,
   "text": "اصلاً ترک در کار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.03,
   "end": 374.99,
   "text": "میگه هر فعل رو انجام بده هرچی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 374.99,
   "end": 376.71,
   "text": "کاملاً در خدمت باباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 376.71,
   "end": 383.57,
   "text": "یه کاری میکنه خدا که تا قیام قیامت حتی امام زمان ما میخواد بره طواف کنه باید دور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 383.57,
   "end": 386.29,
   "text": "حجره اسماعیل بگرده. دور قبر حضرت اسماعیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 386.29,
   "end": 393.03,
   "text": "اگه پاشو، امام ما پاشو بذاره رو قبر اسماعیل رو قبر ایشون طواف باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 393.03,
   "end": 397.25,
   "text": "یعنی این‌ها اسراری‌ست که یک فعل یا قصه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 397.25,
   "end": 405.23,
   "text": "یکی از شاگردان یکی از علمای بسیار بزرگ مطرح کردن که برای من همیشه سؤال بود این برکت عمر این عالم چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 405.23,
   "end": 407.61,
   "text": "از شاگردان حضرت آیت الله بهلول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.61,
   "end": 411.37,
   "text": "گفت برای من سؤال بود. دیدید بعضی چه عمر بابركتی دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 411.37,
   "end": 414.41,
   "text": "شاید یه کتاب نوشته ولی همه جا کتابش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 414.41,
   "end": 417.25,
   "text": "همه جا خونده میشه. یه جمله گفته همه جا اینک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.25,
   "end": 422.83,
   "text": "نوشته شده. کتاب زیاد، کتاب دعا زیاد نوشته چرا مفاتیح همش بغل قرآنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.83,
   "end": 425.75,
   "text": "این برکته دیگه. سخنران زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.75,
   "end": 429.27,
   "text": "مداح زیاد داریم. چرا یهو یه مداح گل می‌کنه، یه سخنران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.27,
   "end": 433.01,
   "text": "اینا برکت خداست. همش قاعده دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.01,
   "end": 438.91,
   "text": "البته این هم نیست که اگر کسی گمنا، گما، گمنام مونده حالا مثلاً اسمش مطرح نبود برکت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 438.91,
   "end": 442.51,
   "text": "نه. هر چیزی بر-- ترک و فعلی یه قاعده‌ای دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 442.51,
   "end": 444.87,
   "text": "اونم قواعد خاص خودش رو داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 444.87,
   "end": 447.93,
   "text": "که من حدیث دیدم که این حدیث کمتر گفته میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 447.93,
   "end": 453.43,
   "text": "که خدای منان فرمود بهترین بندگان من و اخص اولیاء من اونیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 453.43,
   "end": 456.21,
   "text": "در حین اینکه پیش من خیلی عزیزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 456.21,
   "end": 461.25,
   "text": "غریبانه زندگی می‌کنه و به گونه‌ای از دنیا میره که اهدی نمیره تشییعش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 461.25,
   "end": 464.07,
   "text": "یه همچین. یعنی اینطوریه. اصلاً قاعده‌ها رو خدا میدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.07,
   "end": 468.05,
   "text": "اما در هر حال برکت هم قاعده دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 468.05,
   "end": 473.17,
   "text": "میگه که من سؤال کردم از این استادمون که شما چگونه انقدر برکت عمر پیدا کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 473.17,
   "end": 475.21,
   "text": "گفت برمی‌گرده به یه کارم، یه کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.21,
   "end": 476.77,
   "text": "ببینید یه کار عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 476.77,
   "end": 479.33,
   "text": "بعد برکت خدا می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 479.33,
   "end": 483.77,
   "text": "اون لحظه در آن، در لحظه باید تصمیم بگیره چه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 483.77,
   "end": 489.53,
   "text": "که میگن حضرت آیت الله بهلول اومد یادش بخیر اصفهان ما پای منبرش که می‌شستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 489.53,
   "end": 495.35,
   "text": "چندین هزار نفر جمعیت می‌اومد در حالی که ایشون دندون نداشت حرف می‌زد خیلی حرفاشو نمی‌فهمیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 495.35,
   "end": 499.69,
   "text": "فقط برای نفسش بر-- مردم می‌اومدن می‌نشستن پای منبرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 499.69,
   "end": 505.85,
   "text": "میگفت شروع کرد بالا منبر حرف بزنه عطسش گرفت آب بینیش ریخت رو ریشش حضرت آیت الله بهلول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.85,
   "end": 509.21,
   "text": "هی اینور اونور نگاه کرد یه دستمالی پیدا کنه، پیدا نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.21,
   "end": 516.13,
   "text": "این بنده خدا میگش یه کلاهی من تازه خریده بودم از این پوستی‌های گرون قیمت رو سرم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 516.13,
   "end": 519.97,
   "text": "یک آن خدا به دلم انداخت من کلاهمو بهش بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.97,
   "end": 521.35,
   "text": "کی این کارو می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.35,
   "end": 526.21,
   "text": "مثلاً من اگه اونجا بودم یهو اصلاً به ذهنم می‌اومد عماممو بردارم بهش بدم با عمامه من پاک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 526.21,
   "end": 530.51,
   "text": "میگم نه کسر شأنه استغفرالله کچلی معلوم میشه نمی‌دونم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 530.51,
   "end": 532.77,
   "text": "عمامه شأن داره. اصلاً این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.77,
   "end": 535.65,
   "text": "سریع کلاشو میگه و کلاهمو برداشتم دادم بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 535.65,
   "end": 541.93,
   "text": "آقای بهلول هم پاک کرد آب دهان، بینیشو از ریشش و وقتی که پاک کرد نگاه کرد دید کلاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 541.93,
   "end": 544.35,
   "text": "به من یه خنده معناداری کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.35,
   "end": 549.55,
   "text": "تموم شد اومد خونه ما. هر شب جمعه می‌اومد اصفهان سخنرانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 549.55,
   "end": 553.29,
   "text": "دیگه بعدش می‌اومد خونه ما. اون روز دست منو گرفت اومد خونه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 553.29,
   "end": 557.39,
   "text": "گفت تو حاجتی هم داری؟ اون موقع هم خب کربلا اینا راهش بسته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 557.39,
   "end": 559.85,
   "text": "آرزو مند بود. گفت آرای به ذهنم اومد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 559.85,
   "end": 563.49,
   "text": "ن-- خیلی دوست دارم برم نجف، کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 563.49,
   "end": 565.75,
   "text": "گفت دستتو بده من یه ذکر و چشماتو ببند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 565.75,
   "end": 567.65,
   "text": "چند قدم رفتیم و یه ذکری گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 567.65,
   "end": 571.37,
   "text": "گفت چشماتو وا کن. دیدم اه جلوی ایوان طلا امیرالمؤمنینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 571.37,
   "end": 573.83,
   "text": "زیارت کردیم. باورم نمیشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 573.83,
   "end": 575.97,
   "text": "زیارت کردیم. اومدیم بیرون گفت دیگه چی میخوای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 575.97,
   "end": 578.17,
   "text": "گفتم کربلا. چشمتو ببند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 578.17,
   "end": 583.89,
   "text": "یه ذکر. چند قدم دیدیم جلوی ایوان طلا ابی عبدالله، حضرت آیت الله بهلول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.89,
   "end": 586.17,
   "text": "صد و ده سال حدوداً عمر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 586.17,
   "end": 589.33,
   "text": "زیارت کردیم. مات اومد. می‌گفت من فکر می‌کردم خوابم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 589.33,
   "end": 593.31,
   "text": "دارم خواب می‌بینم. بعد که حالا از اون حالت اومدیم بیرون گفت دیگه چی میخوای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 593.31,
   "end": 596.33,
   "text": "گفتم دیگه بریم خونه. دستمو گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 596.33,
   "end": 600.31,
   "text": "ذکر چشمارو ببند. باز کن دیدیم تو خونه‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 600.31,
   "end": 603.73,
   "text": "یه لحظه بهش گفتم آقای بهلول چرا مشهد ما رو نبردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 603.73,
   "end": 607.59,
   "text": "با اون لهجه مشهدیش گفت نافهم نخواستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 607.59,
   "end": 609.97,
   "text": "خودت نخواستی. اگه می‌خواستی می‌رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 609.97,
   "end": 612.67,
   "text": "میگه این حالا این هدیه ایشون به ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 612.67,
   "end": 617.53,
   "text": "یه لبخندی که حالا معناداری که کلا، میگه یه کلاه بخشیدیم در راه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 617.53,
   "end": 621.99,
   "text": "چیزی نبود که. در آن، در لحظه تصمیم بگیره چگونه عمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 621.99,
   "end": 624.97,
   "text": "ترک و فعلش چگونه است، اون امتحان ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 624.97,
   "end": 627.29,
   "text": "ولی برکت، میگه بعد از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 627.29,
   "end": 632.17,
   "text": "من چنان عمرم برکت کرده، شب‌ها چند ساعت مطالعه، کتاب می‌نویسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 632.17,
   "end": 634.45,
   "text": "نماز شبام نماز شبای امام رضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 634.45,
   "end": 637.85,
   "text": "نماز شب امام رضا دیگه می‌دونید چقدر خاص الخاص بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 637.85,
   "end": 641.29,
   "text": "نمی‌دونم ح-- تع-- مثلاً موندم این برکت از کجا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 641.29,
   "end": 646.65,
   "text": "همش به خاطر همون یک باره که آبروی یک عالم رو در لحظه خریدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 646.65,
   "end": 649.23,
   "text": "در همه ما هم این اتفاقات پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 649.23,
   "end": 661.69,
   "text": "ترک و فعلش مهمه. انشاالله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد. سلام بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}