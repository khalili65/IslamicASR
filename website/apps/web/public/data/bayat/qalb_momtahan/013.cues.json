 "chapters": [
  {
   "index": 0,
   "title": "## وقف با اکراه؛ شرط رضایت قلبی",
   "start": 13.04,
   "end": 68.24
  },
  {
   "index": 1,
   "title": "## قلب ممتحن و سنت فتنه؛ عنکبوت/۲",
   "start": 68.24,
   "end": 218.28
  },
  {
   "index": 2,
   "title": "## حدیث ریان بن شبیب؛ فبک للحسین",
   "start": 218.28,
   "end": 282.3
  },
  {
   "index": 3,
   "title": "## بکی و أبکی و تباکی؛ سه بهشت",
   "start": 282.3,
   "end": 782.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.12,
   "end": 4.54,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.54,
   "end": 8.2,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.2,
   "end": 13.04,
   "text": "آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.04,
   "end": 19.02,
   "text": "یکی از افت-- استفساراتی که از رهبر عزیزمون پیرامون وقف و نذر و این‌ها شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.02,
   "end": 26.26,
   "text": "این هستش که آیا اگر کسی هنگام وقف کردن چیزی اکراه داشته باشه از این وقف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.26,
   "end": 32.36,
   "text": "آیا اون وقفش درسته؟ هر چیزی رو می‌خواد وقف کنه به یه هیئتی، مسجدی، موقوفه‌ای، جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.36,
   "end": 36.7,
   "text": "می‌خواد ه-- وقف کنه از تصرف خودش خارج کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.7,
   "end": 41.84,
   "text": "آیا اگر قلباً اکراه داشته باشه این وقف درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.84,
   "end": 44.16,
   "text": "آقا فرمودن نخیر، این وقف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.16,
   "end": 49.4,
   "text": "اشکال داره و وقف محقق نشده اگر قلباً اکراه داره باید با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.4,
   "end": 55.62,
   "text": "رضایت کامل باشه و در صورتی وقف اینجا درست می‌شه که اجازه لاحق بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.62,
   "end": 63.14,
   "text": "یعنی اجازه‌ای ایشون ملحق کنه از سر رضایت قلبی اجازه‌ای مکتوب کنه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.14,
   "end": 68.02,
   "text": "بیان کنه که اون وقف از اشکال خارج بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.02,
   "end": 76.58,
   "text": "خب بحث ما پیرامون قلب ممتحن بود و قلبی که از سمت خدای منان قلباً مر-- قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 76.58,
   "end": 80.4,
   "text": "مورد امتحان الهی قرار خواهد گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 80.4,
   "end": 84.52,
   "text": "حالا اگر ج-- چنانچه شما دقت فرموده باشید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 84.52,
   "end": 87.42,
   "text": "آیه دو سوره عنکبوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.42,
   "end": 90.28,
   "text": "می‌فرماید که بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 90.28,
   "end": 93.72,
   "text": "الف. لام. میم. أحسب الناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.72,
   "end": 97.02,
   "text": "گمان مردم این هستش که ای ترکوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.02,
   "end": 100.44,
   "text": "که ولشون کرده خدا یا رهاشون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.44,
   "end": 105.04,
   "text": "ایقول آمننا در حالی که اینا میگن ما ایمان آوردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.04,
   "end": 110.18,
   "text": "و هم لا یفتنون. آیا این چنین گمان، گمان می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.18,
   "end": 113.52,
   "text": "و لقد فتننا الذين من قبلهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.52,
   "end": 117.16,
   "text": "اتفاقاً قبل از این‌ها هم خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.16,
   "end": 120.86,
   "text": "فتننا ما این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.86,
   "end": 124.26,
   "text": "مورد امتحان قرار دادیم، مورد فتنه قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.26,
   "end": 127.7,
   "text": "اصلاً این چنین نیست، سنت الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.7,
   "end": 131.92,
   "text": "همین که تو خلق شدی انا خلقنا الانسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.92,
   "end": 134.68,
   "text": "من قطرة امشاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.68,
   "end": 137.98,
   "text": "آیه دو سوره انسان نبتلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.98,
   "end": 142.46,
   "text": "تمام. ما قطعاً همین که اصلاً تو خلقت پیدا کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.46,
   "end": 149.78,
   "text": "تو رو امتحان خواهیم کرد. یکی از اینجا می‌خوام این رو عرض کنم چون اینجا می‌فرماید ایقول آمننا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.78,
   "end": 153.82,
   "text": "میگن ایمان آوردیم. نمی‌فرماید که این‌ها به واقع ایمان آوردن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.82,
   "end": 157.94,
   "text": "حواستون باشه‌ها. می‌فرماید ایقولوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.94,
   "end": 159.7,
   "text": "به زبانشون جاری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.7,
   "end": 164.34,
   "text": "اینا رو باید دقت کنیم تو عبارات و کلمات قرآن و اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.34,
   "end": 168.68,
   "text": "کلمه به کلمه بلکه حرف به حرف حساب شده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.68,
   "end": 173.54,
   "text": "این میگه همین که به زبانشون جاری می‌شه تمام، مورد امتحان قرار می‌گیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.54,
   "end": 180.44,
   "text": "پس نتیجه ما نسبت به اون ادعاهایی که بر لسانمون جاری می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.44,
   "end": 185.24,
   "text": "قطعاً امتحان می‌شیم. خیلی از موقع‌ها ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.24,
   "end": 190.64,
   "text": "گرفتاری‌هایی که تو زندگیمون برامون پیش میاد به جهت ادعاهاییه که کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 190.64,
   "end": 193.66,
   "text": "اون چیزیه که به زبانمون جاری کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.66,
   "end": 195.58,
   "text": "من نوکر امام حسینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.58,
   "end": 200.62,
   "text": "خب بسم الله. نوکر امام حسین خصوصیت‌هایی داره نسبت به همون نوکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.62,
   "end": 204.12,
   "text": "بود، نوکر امام حسین علیه السلام بودن تو رو امتحان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.12,
   "end": 209.4,
   "text": "آقا جان یا ادعا نکن یا پای امتحانش وایستا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.4,
   "end": 212.18,
   "text": "میگه من گریه کن امام حسینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.18,
   "end": 214.3,
   "text": "عزیز دلم گریه کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.3,
   "end": 217.38,
   "text": "آخه ببینید بحث گریه که پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.38,
   "end": 220.08,
   "text": "خب این ایام هم ایام گریه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.08,
   "end": 225.72,
   "text": "حالا به اللی خوشبختانه از جهتی هم خب متأسفانه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.72,
   "end": 228.3,
   "text": "حدیث عجیب و پو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.3,
   "end": 230.74,
   "text": "گران سنگ امام رضا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.74,
   "end": 235.04,
   "text": "ریان بن شبيب همین‌طوری لغلغه زبان مداح‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.04,
   "end": 238.6,
   "text": "در صورتی که خب از جهتی خوبه اما از جهتی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.6,
   "end": 240.84,
   "text": "دیده نمی‌شه مورد دقت قرار بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.84,
   "end": 245.32,
   "text": "همین حدیث رو برید تو تنهاییتون این حدیث رو پیدا کنید کلشو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.32,
   "end": 252.76,
   "text": "اولاً ریان چه عظمت وجودی داشته که این همه القاءات توسط امام رعوف بهش شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.76,
   "end": 256.9,
   "text": "القاءات عجیبیه. فقط اون بحث فبکی للحسینش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.9,
   "end": 265.32,
   "text": "همون رو هم اگر شما دقت بفرمایید همینطور که عرض کردم بخواید ریز بشید تو حروف حتی می‌فرماید إن كنت باكیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.32,
   "end": 269.88,
   "text": "لشیء برای هر چیزی خواستی باکی باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.88,
   "end": 272.92,
   "text": "باکی از ایفعل نه انفعال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 272.92,
   "end": 275.56,
   "text": "دقت بفرمایید چی دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.56,
   "end": 279.7,
   "text": "یعنی فعلیت داره درش، انفعال نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.7,
   "end": 284.34,
   "text": "حالا اینو توضیح میدم. بعد میگه فبکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.34,
   "end": 286.42,
   "text": "للحسین علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 286.42,
   "end": 290.32,
   "text": "نمی‌فرماید فبکی علی الحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.32,
   "end": 293.22,
   "text": "این خودش مطلبه، خودش نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.22,
   "end": 296.06,
   "text": "میگه فبکی ل-- اینجا لام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 296.06,
   "end": 299.76,
   "text": "اهلش فرمودن که لام، لام ملکیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 299.76,
   "end": 304.1,
   "text": "یعنی اصلاً گریه در تملک سید و شهداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 304.1,
   "end": 306.38,
   "text": "اولاً خب خیلی اینجا نکات استخراج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.38,
   "end": 312.82,
   "text": "اولاً فکر نکن هنر کردی که برای امام حسین علیه الصلاة والسلام گریه کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.82,
   "end": 314.9,
   "text": "السلام على من بكت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 314.9,
   "end": 317.8,
   "text": "عليه ملائكة السماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 317.8,
   "end": 320.16,
   "text": "والأرض یا والأرضون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 320.16,
   "end": 323.18,
   "text": "اون کسی‌ست که ملائکه آسمان‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.18,
   "end": 327.42,
   "text": "نمی‌دونم طیر، پرنده في السماء در آسمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 327.42,
   "end": 329.48,
   "text": "جن و انس في الأرض در ارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.48,
   "end": 331.86,
   "text": "جالبه میگه پرنده تو آسمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.86,
   "end": 337.2,
   "text": "جن و انس تو زمین یعنی پرنده که تو آسمونه مشغول فعالیتشه داره پر میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.2,
   "end": 343.7,
   "text": "نرفته یه لونه کنج از لونه‌ش، آشیونه‌ش بشینه زانو و غم بغل بگیره که لاجرم گریان بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.7,
   "end": 347.98,
   "text": "نه، میگه مشغول پرواز و کارشه گریانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.98,
   "end": 351.84,
   "text": "جن و انس تو زمین در حالی که في الأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.84,
   "end": 355.88,
   "text": "اینا همش نکته‌ست. مشغولاً گریانن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.88,
   "end": 359.16,
   "text": "هنر نکردی، سنگ گریه کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 359.16,
   "end": 361.46,
   "text": "و مهم‌تر از اون اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.46,
   "end": 365.08,
   "text": "میگه فبکی للحسین. اصلاً گریه مال امام حسینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.08,
   "end": 368.46,
   "text": "تو اگر گریه‌ای به غیر از برای امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.46,
   "end": 370.42,
   "text": "بکنی باختی، سوختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 370.42,
   "end": 375.72,
   "text": "لذا بعضی از مراجع بعضی از البته در مسئله فقهی گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 375.72,
   "end": 380.14,
   "text": "اگر در نماز برای هر چیز غیر از خدا گریه کنی نماز باطل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.14,
   "end": 383.68,
   "text": "بعضیا گفتن الا برای امام حسین هم اینها اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.68,
   "end": 386.4,
   "text": "دیگه اختصاص خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.4,
   "end": 390.24,
   "text": "عجب! مثلا تو قنوت نمازت برای امام حسین علیه السلام گریه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.24,
   "end": 392.48,
   "text": "اصلا گریه مال امام حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.48,
   "end": 395.1,
   "text": "بعد اونجا که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.1,
   "end": 401.18,
   "text": "این حدیثی که مرحوم شیرازی بزرگ در وهزه‌ای که تو بیمارستان داشت از دنیا می‌رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.18,
   "end": 404.6,
   "text": "رو کرد به همه گفت برید به همه بگید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.6,
   "end": 409.82,
   "text": "سه بار قسم یاد کرد که این حدیث از أصح أحاديث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.82,
   "end": 415.98,
   "text": "شیعه است که من بکى أو أبکى أو تباکى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.98,
   "end": 419.38,
   "text": "للحسین علیه السلام وجبت له الجنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.38,
   "end": 426.94,
   "text": "این رو دقت بفرمایید. این که سه قسمت کرده است آقا اینجا امام صادق صلوات الله علیه خودش سره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.94,
   "end": 429.44,
   "text": "بکى مقام ای افعل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 429.44,
   "end": 431.86,
   "text": "فعلیت داره. یعنی خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 431.86,
   "end": 434.8,
   "text": "ذاتاً گریه می‌کنی نه این که تو رو بگریونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 434.8,
   "end": 437.34,
   "text": "دقت بفرمایید اینا با هم فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 437.34,
   "end": 439.76,
   "text": "مقام انفعال نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.76,
   "end": 444.82,
   "text": "بکى اصلاً آدم باکی تا بهش میگی امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.82,
   "end": 446.74,
   "text": "ما فذمیرش منقلب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.74,
   "end": 449.64,
   "text": "اصلاً نمی‌خواد تو، تو اونو به گریه بندازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.64,
   "end": 453.46,
   "text": "گریه‌ش می‌گیره. این مقام گریه کردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.46,
   "end": 457.06,
   "text": "میگه فبک یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.06,
   "end": 463.26,
   "text": "ابک یعنی گریان خودت گریان باش للحسین علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 463.26,
   "end": 466.38,
   "text": "حالا خدا من باب ترحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 466.38,
   "end": 470.44,
   "text": "اونجا فرموده که أو أبکى أو تباکى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.44,
   "end": 472.9,
   "text": "أبکى اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.9,
   "end": 476.14,
   "text": "مقام ابکى یا أبکى مقامیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 476.14,
   "end": 478.18,
   "text": "حالا کسی تو رو به گریه بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.18,
   "end": 481.38,
   "text": "تو خودت گریه‌ات نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.38,
   "end": 485.54,
   "text": "یا تو می‌خونی دیگری رو به گریه میندازی باز خودت گریه‌ات نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.54,
   "end": 487.8,
   "text": "یا اونکه داره می‌شنوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.8,
   "end": 490.08,
   "text": "تو مقام أبکى است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 490.08,
   "end": 494.22,
   "text": "یعنی اون منفعل شده از خوندن تو داره گریه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 494.22,
   "end": 496.94,
   "text": "اینا با هم فرق می‌کنه. این با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.94,
   "end": 500.24,
   "text": "باکی فرق می‌کنه. این یعنی منفعل شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 500.24,
   "end": 503.78,
   "text": "فعلیت تو وجودت پیدا نکرده قصه کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 503.78,
   "end": 509.08,
   "text": "ببین اینا با هم فرق دارن. بعد می‌فرماید تازه باز خدا رحم می‌کنه میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.08,
   "end": 513.66,
   "text": "أو تباکى یعنی خودت رو شبیه این که دیگه اصلاً نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 513.66,
   "end": 515.32,
   "text": "فعلیته، نه انفعاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.32,
   "end": 518.38,
   "text": "عجب! نه فعلیته، نه انفعاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 518.38,
   "end": 523.9,
   "text": "یعنی نه تو وجودت حسین ابن علی و مصیبت‌هاش جا گرفته و ریشه انداخته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 523.9,
   "end": 526.3,
   "text": "ردپایی داره، نه این که تونست--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.3,
   "end": 528.6,
   "text": "دیگری تونسته تو رو منفعل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 528.6,
   "end": 532.3,
   "text": "هیچ‌کدوم از اینا نیست. کسی هم نتونسته تو رو به گریه بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 532.3,
   "end": 536.2,
   "text": "میگه لاأقل از عزیز خداست امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 536.2,
   "end": 539.1,
   "text": "غیرت نسبت به عزیز خدا نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 539.1,
   "end": 544.08,
   "text": "سرتو بنداز پایین زمزمه‌ای، ناله‌ای همینطوری بر رو بر نگاه نکن بی‌ادب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 544.08,
   "end": 552.16,
   "text": "بعضیا اینطورین. اینجا حالا قسمت درسته میگه وجبت له الجنة هر سه بهشت براشون واجب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 552.16,
   "end": 557.12,
   "text": "این اولاً رحم خداست، لطف خداست، مرحمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.12,
   "end": 561.1,
   "text": "ثانیا این بهشت فرق می‌کنه برای هر سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.1,
   "end": 564.74,
   "text": "بهشت باکی با بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 564.74,
   "end": 568.58,
   "text": "تباکی یا بهشت کسی که ابکا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 568.58,
   "end": 573.24,
   "text": "أب أو أبکى یا ابکا یا أبکى فرق نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 573.24,
   "end": 575.34,
   "text": "چه بگریونی، چه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 575.34,
   "end": 578.52,
   "text": "تو رو بگریونه. کسی تو رو بگریونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 578.52,
   "end": 583.26,
   "text": "تو خودت گریان نشدی. اینا بهشت‌هاشون با هم فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 583.26,
   "end": 586.72,
   "text": "اون کسی که بهشتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 586.72,
   "end": 595.36,
   "text": "به وسیله باکی صورت گرفته وجبه لل وجبت له الجنة اون جنته بر اثر باکیه برای امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 595.36,
   "end": 599.26,
   "text": "بکى اون بهشت ذاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 599.26,
   "end": 603.02,
   "text": "بهشتی که می‌خواد منفعل باشی از دیگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 603.02,
   "end": 606.86,
   "text": "غالباً ببخشید دیگه رک میگم اکثراً ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 606.86,
   "end": 611.54,
   "text": "منقلب می‌شیم، منفعل می‌شیم از خوندن دیگری گریه‌مون می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 611.54,
   "end": 614.98,
   "text": "اون، اون وسطی هست. اون می‌شه بهشت وسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 614.98,
   "end": 618.12,
   "text": "یه بهشتی‌ست حالا. دیگه اون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 618.12,
   "end": 620.84,
   "text": "أبکى ببخشید تباکى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 620.84,
   "end": 624.39,
   "text": "اون که اصلاً نه منفعله، نه فعلیت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 624.39,
   "end": 626.08,
   "text": "خودشو شبیه گریه کننده کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 626.08,
   "end": 629.06,
   "text": "اصلاً گریه‌ای نداره. نه کسی تونسته بگریونش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 629.06,
   "end": 632.5,
   "text": "نه خودش گریه کرده. اون که دیگه بهشت سیب و گلابی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 632.5,
   "end": 634.4,
   "text": "اینا بهشت‌هاشونم با هم فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 634.4,
   "end": 637.74,
   "text": "قربونت برم. حالا بحث به این سمت‌ها نره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 637.74,
   "end": 641.12,
   "text": "خیلی طولانی می‌شه. خلاصه‌ش این که حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 641.12,
   "end": 646.38,
   "text": "تو اگر ادعا کنی من گریه کننده امام حسین هستم نسبت به اون ادعات امتحانت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 646.38,
   "end": 648.8,
   "text": "خب بسم الله چه نوع گریه‌ای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 648.8,
   "end": 654.28,
   "text": "کدوم گریه‌ست؟ حالا در خصوص ملائکه میگه علی علی حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 654.28,
   "end": 656.96,
   "text": "میگه نمی‌گه للحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 656.96,
   "end": 660.42,
   "text": "السلام على من بكت ملائكة السماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 660.42,
   "end": 664.12,
   "text": "من بکت علیه ملائكة السماء والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 664.12,
   "end": 667.74,
   "text": "ولی به من و تو که می‌رسه میگه فبک للحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 667.74,
   "end": 670.32,
   "text": "اصلاً خودت رو وقف امام حسین کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 670.32,
   "end": 673.74,
   "text": "طوری که گریه‌تم مال امام حسین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 673.74,
   "end": 675.64,
   "text": "در غیر این صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 675.64,
   "end": 679.26,
   "text": "تو به بهشت ذات که جنتی‌ست نخواهی رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 679.26,
   "end": 681.48,
   "text": "فادخلی عبادی وادخلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 681.48,
   "end": 683.98,
   "text": "جنتی. بی‌خود سر خودتم کلاه نذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 683.98,
   "end": 685.92,
   "text": "ادعای نوکری و این‌ها هم نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 685.92,
   "end": 688.84,
   "text": "این که امام رضاست شصت روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 688.84,
   "end": 696.62,
   "text": "یا به روایتی سی روز اونایی که اومدن ادعا کردن ما شیعیان امام رضاییم توش نیشابور پشت در نگه داشت برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 696.62,
   "end": 700.16,
   "text": "بیکار بود آقا؟ امام الرؤوفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 700.16,
   "end": 702.06,
   "text": "بعد گنده‌های قم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 702.06,
   "end": 705.96,
   "text": "زعماء قم بودن. شصت روز نگهشون داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 705.96,
   "end": 708.56,
   "text": "شصت و یک روز پشت در نگهشون داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 708.56,
   "end": 711.02,
   "text": "گفت شما ادعا کردید شیعه‌اید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 711.02,
   "end": 713.42,
   "text": "در حالی که شیعه نیستید. این امتحانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 713.42,
   "end": 715.34,
   "text": "این هم خودش یه نوع امتحانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 715.34,
   "end": 718.08,
   "text": "اگه شیعه بودن جزر فزر نمی‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 718.08,
   "end": 721.46,
   "text": "تا قیام قیامت پشت در امام رضا می‌موندن جزر نمی‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 721.46,
   "end": 723.66,
   "text": "همون روز شصت و یکم جزر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 723.66,
   "end": 726.68,
   "text": "گفتن آقا این چه خبره آخه ما موال، موالیان شمایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 726.68,
   "end": 728.76,
   "text": "گفت آها حالا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 728.76,
   "end": 733.0,
   "text": "حالا که گفتید موالیان و محبین ما هستید بسم الله بیاید تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 733.0,
   "end": 736.26,
   "text": "اگر شیعه بودن اینم خودش یه امتحانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 736.26,
   "end": 739.4,
   "text": "نگهشون گفت شیعه‌ایم. گفتن ما شیعیان امام رضاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 739.4,
   "end": 741.92,
   "text": "گفت خب نگهشون دارید. این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 741.92,
   "end": 745.42,
   "text": "به لسان جاری شد أن يقولوا آمنوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 745.42,
   "end": 748.36,
   "text": "گفتن ما امام رضا رو ما شیعه امام رضاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 748.36,
   "end": 750.36,
   "text": "خب نگهشون دارید ببینم شیعه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 750.36,
   "end": 753.1,
   "text": "لام تا کام کوچک‌ترین اعتراضی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 753.1,
   "end": 756.9,
   "text": "نگه دارید پشت در ببینم. شصت و یک روز بیشتر تحمل نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 756.9,
   "end": 758.84,
   "text": "گفتن پس شما دوستید، محبید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 758.84,
   "end": 761.46,
   "text": "بی‌خود چاخان نکنید ما شیعه‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 761.46,
   "end": 766.88,
   "text": "و اینا همش سر داره. اونچه که بر لسان جاری می‌شه نسبتش به امتحان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 766.88,
   "end": 770.14,
   "text": "با امتحان کاملاً دو کفه ترازوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 770.14,
   "end": 773.24,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 773.24,
   "end": 776.34,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 776.34,
   "end": 782.9,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}