 "chapters": [
  {
   "index": 0,
   "title": "## سفر شغلی و ساعات شخصی",
   "start": 11.2,
   "end": 76.32
  },
  {
   "index": 1,
   "title": "## چرا خدا امتحان می‌کند؟ خودشناسی نه افزایش علم حق",
   "start": 76.32,
   "end": 347.84
  },
  {
   "index": 2,
   "title": "## صد وجه من عرف نفسه؛ ظرفیت پایین",
   "start": 347.84,
   "end": 452.24
  },
  {
   "index": 3,
   "title": "## انسان مثل خدا در ذات و صفات و افعال",
   "start": 452.24,
   "end": 498.52
  },
  {
   "index": 4,
   "title": "## داستان شاگرد امام صادق و اسم اعظم در آب",
   "start": 498.52,
   "end": 690.24
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.76,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.76,
   "end": 7.28,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.28,
   "end": 11.2,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.2,
   "end": 16.02,
   "text": "در سفر شغلی حالا چه طلبه باشه که مبلغ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.02,
   "end": 19.02,
   "text": "استاد دانشگاه حالا یا کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.02,
   "end": 25.26,
   "text": "برای بورسیه تحصیلی به جایی میره یا مأموریت اداری داره همه اینا رو توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.26,
   "end": 28.2,
   "text": "در هر حال سفر، سفر شغلی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.2,
   "end": 32.22,
   "text": "حالا سؤال اینه که این‌هایی که رفتن به سفر شغلی‌شون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.22,
   "end": 38.52,
   "text": "اونجا عین اون ایام و اون ساعات رو باید مشغول به اون مأموریت‌شون باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.52,
   "end": 41.42,
   "text": "تا این سفر، سفر شغلی حساب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.42,
   "end": 47.56,
   "text": "نمی‌تونن مثلا رفتن سفر شغلی از اونجا برن خونه مثلا فامیلشون یه سری بزنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.56,
   "end": 51.08,
   "text": "یا برن یه جای دیدنی با خونواده دیدن کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.08,
   "end": 53.92,
   "text": "خلاصه امورات شخصی خودشون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.92,
   "end": 56.14,
   "text": "رهبر عزیزمون فرمودن نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.14,
   "end": 62.9,
   "text": "اونچه که محول شده وظیفه‌شون هرچی که هست شاید حتی یک ساعت، شاید طرف یک ساعت یه جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.9,
   "end": 69.3,
   "text": "مثلا سفر شغلی‌ش اقتضا می‌کنه بره مثلا یه جایی یک ساعت اونجا برنامه داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.3,
   "end": 76.32,
   "text": "بقیه ساعاتش رو به شئونات شخصی خودش و خونواده‌ش برسه هیچ اشکالی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.32,
   "end": 79.62,
   "text": "در خصوص قلب ممتhen.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.62,
   "end": 82.04,
   "text": "یه دو روزی هست یه مقدار بحث ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.04,
   "end": 84.82,
   "text": "عرض شود فلسفی و حکمی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.82,
   "end": 88.16,
   "text": "شاید بعضیا رو اذیت کرده باشه اما چاره‌ای جز این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.16,
   "end": 91.26,
   "text": "امروز متوجه می‌شیم چرا، چرایش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.26,
   "end": 95.42,
   "text": "ببینید سؤال، اصلاً چرا خدا ما رو امتحان می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.42,
   "end": 97.06,
   "text": "اصلاً برای چی ما رو آورد این دنیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.06,
   "end": 101.38,
   "text": "اگر این دنیا دار ابتلا و امتحان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.38,
   "end": 108.32,
   "text": "چرا خدا ما را آورده اینجا؟ مگر او باخبر نبود که انتهای کار ما به کجا خواهد رسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.32,
   "end": 111.86,
   "text": "مگر خدا باخبر نیست؟ مگر همه علم از او نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.86,
   "end": 115.34,
   "text": "اصلاً قبل خلقت همه مخلوقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.34,
   "end": 117.98,
   "text": "در علم خدا بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.98,
   "end": 120.78,
   "text": "هر کسی الی الابد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.78,
   "end": 123.4,
   "text": "چه کاره‌ست. خب و برای چی ما رو آورد این دنیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.4,
   "end": 130.46,
   "text": "این سؤال اساسی‌یه دیگه. خلاصه‌ش اینه که برای اینکه ما خودمون رو بشناسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.46,
   "end": 134.38,
   "text": "ما خودمون رو بسنجیم. در این امتحانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.38,
   "end": 137.88,
   "text": "خدا به علمش اضافه نمی‌شه که عجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.88,
   "end": 141.84,
   "text": "مثلاً تویی که اومدی تو این دنیا من خدا فکر می‌کردم تو یه جور دیگه باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.84,
   "end": 148.52,
   "text": "اینطوری نیست که. اصلاً سر نه خدا به علمش اضافه می‌شه نه حجت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.52,
   "end": 150.58,
   "text": "پس کی به علمش اضافه می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.58,
   "end": 153.34,
   "text": "کی می‌شناسه اتفاقات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.34,
   "end": 156.98,
   "text": "بررسی می‌کنه و یک حالا علوم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.98,
   "end": 161.0,
   "text": "اِ-- معارف جدیدی رو کسب می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.0,
   "end": 162.68,
   "text": "خود ما نسبت به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.68,
   "end": 168.02,
   "text": "به خودمون. یعنی در حقیقت ما اومدیم اینجا که خودمون رو بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.02,
   "end": 170.4,
   "text": "البته بعضیا گفتن اگر اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 170.4,
   "end": 174.98,
   "text": "یک سرش هم می‌تونه البته این باشه اگر قیامت خدا همونجا می‌گفت آقا بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 174.98,
   "end": 177.38,
   "text": "اصلاً قیامت قبل از این دنیا واقع می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.38,
   "end": 179.88,
   "text": "آقا من خدا تو رو خلق کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 179.88,
   "end": 182.42,
   "text": "می‌دونم چه کاره‌ای برو جهنم تو هم برو بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 182.42,
   "end": 185.02,
   "text": "همه می‌تونستن اعتراض کنن. کو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 185.02,
   "end": 188.0,
   "text": "کجا؟ کی گفته؟ من کی این کارو کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 188.0,
   "end": 192.5,
   "text": "خب یه سرش هم این هست که ما بیاییم اینجا اعمال خودمون رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 192.5,
   "end": 194.7,
   "text": "اما خدا نیاز به این کار نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 194.7,
   "end": 197.24,
   "text": "ضمن اینکه خدا قدرتشو داشت همونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 197.24,
   "end": 199.2,
   "text": "فیلم اعمال ما رو به ما نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 199.2,
   "end": 202.06,
   "text": "لکن مهم اینجاست که ما خودمون رو بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 202.06,
   "end": 205.78,
   "text": "اصلاً سر اومدن اینجا خودشناسی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 205.78,
   "end": 210.42,
   "text": "نفس‌شناسی‌ست. حتما شنیدید اگه کار اخلاقی حتما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 210.42,
   "end": 216.84,
   "text": "به صورت دقیق انجام داده باشید چه عملی، چه نظری می‌دونید مهم‌ترین کار من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 216.84,
   "end": 223.38,
   "text": "خودسازی‌ست. به قول حضرت امام رحمت الله علیه کاری ما بالاتر از این نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.38,
   "end": 227.08,
   "text": "اصلاً غلط می‌کنه به قول امام کسی خودش رو نساخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 227.08,
   "end": 232.2,
   "text": "بیاد وسط گود. وسط هر گودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 232.2,
   "end": 238.78,
   "text": "می‌خواد امام جماعت بشه، می‌خواد مدیر یه جا باشه، می‌خواد مسئول یک کانون یک هیئتی هرچی، اول خودسازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.78,
   "end": 241.7,
   "text": "خب خودسازی بر اساس چی شکل می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.7,
   "end": 246.46,
   "text": "خودشناسی. تا کسی خودش رو نشناسه، نفس خودش رو نشناسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 246.46,
   "end": 250.58,
   "text": "نمی‌تونه خودسازی کنه. آقا من کیم که خودم رو چگونه بسازم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.58,
   "end": 254.94,
   "text": "لذا امیرالمؤمنین علیه أفضل صلوات المسلل فرمودن این حدیث رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.94,
   "end": 260.4,
   "text": "می‌فرمود معرفة النفس أنفع المعارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.4,
   "end": 264.68,
   "text": "آقا با منفعت‌ترین، پرسودترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.68,
   "end": 267.84,
   "text": "معارف و علوم شناخت خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.84,
   "end": 269.86,
   "text": "چقدر ما برای این قدم برداشتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.86,
   "end": 273.0,
   "text": "چقدر وقت گذاشتیم برای خوندن ریاضیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.0,
   "end": 278.62,
   "text": "شیمی، فیزیک، ادبیات، زبان، برای مسائل سیاسی، روزنامه خوندن که--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.62,
   "end": 283.86,
   "text": "ولی برای خودمون چقدر؟ خودمون حتی برای شناخت دیگران چقدر قدم برداشتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.86,
   "end": 286.94,
   "text": "تحقیق کردیم فلانی واقعاً چه جور آدمه، خودت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.94,
   "end": 292.58,
   "text": "خودم چی؟ جالبه که پیغمبر یه سری رو توی یک روایت نب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.58,
   "end": 296.78,
   "text": "یه حدیث نبوی‌ست واقعاً سر عجیبی رو پیغمبر اینجا فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.78,
   "end": 299.38,
   "text": "عن می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.38,
   "end": 302.44,
   "text": "اَعْلَمُکُمْ لِنَفْسِهِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.44,
   "end": 304.02,
   "text": "أَعْلَمُکُمْ لِرَبِّهِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 304.02,
   "end": 310.38,
   "text": "الله اکبر. هرکس نسبت به خودش هر مقدار عالم‌تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.38,
   "end": 313.4,
   "text": "همون مقدار به پروردگارش عالم‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.4,
   "end": 316.22,
   "text": "عجب! پیداست یه ربطی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 316.22,
   "end": 318.44,
   "text": "بین ما و خدا وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 318.44,
   "end": 322.72,
   "text": "یعنی اگر که اون که فرمود که حدیث شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.72,
   "end": 329.54,
   "text": "مولا که من عرف نفسه فقد عرف ربه که علامه حسن زاده می‌فرما تمام کتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.54,
   "end": 333.88,
   "text": "معارف الهی همه رو بریزی رو هم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.88,
   "end": 337.28,
   "text": "همه رو بریزی رو هم شرح این حدیث مولاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.28,
   "end": 340.54,
   "text": "حتی ایشون می‌فرمایند که کل قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 340.54,
   "end": 345.78,
   "text": "اگر بخوای کل قرآن رو تو یکی جمله جمع کنی همین حدیث مولا کل قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 345.78,
   "end": 347.84,
   "text": "من عرف نفسه فقد عرف ربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 347.84,
   "end": 351.48,
   "text": "هرکس خودشو شناخت، پروردگارشو می‌شناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 351.48,
   "end": 353.32,
   "text": "خب آیا ما چقدر خودمون رو شناختیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 353.32,
   "end": 356.9,
   "text": "جالبه که اگر شما از ظریف‌تر-- یک بار اینجا ما یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 356.9,
   "end": 358.94,
   "text": "شاید سه ساعت یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.94,
   "end": 362.66,
   "text": "شاید هم بیشتر با چند تا بچه‌ها دیدید بعد از عصر ما می‌شینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 362.66,
   "end": 366.28,
   "text": "بحث کردیم دیگه آخر گفتن حاجی ادامه نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 366.28,
   "end": 368.66,
   "text": "عقلای جمع شما گفتن دیگه جلوتر نرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 368.66,
   "end": 375.42,
   "text": "داشتیم صد وجهی که علامه حسن زاده از این من عرف نفسه فقط عرف ربه استخراج کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 375.42,
   "end": 380.32,
   "text": "می‌گفتیم. شاید پنج تا شما گفتیم دیگه نتونستن تحمل کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.32,
   "end": 383.48,
   "text": "خب چرا؟ ظرف ما پایینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.48,
   "end": 387.56,
   "text": "حالا یه دونه‌ش رو من عرض کنم. قرآنی هم هست همه معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.56,
   "end": 390.28,
   "text": "که من عرف نفسه فقط عرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 390.28,
   "end": 394.78,
   "text": "ربه. این رب کیه؟ این رب کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 394.78,
   "end": 397.26,
   "text": "جالبه که تو قرآن میگه اقرأ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 397.26,
   "end": 402.34,
   "text": "باسم ربک، پروردگار تو قبلاً بحثش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 402.34,
   "end": 410.6,
   "text": "این رب کیه؟ می‌فرمود یکی از آیات قرآن هست اونجا که می‌فرمود یومتا-- یوم تبدل الارض بغير الارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 410.6,
   "end": 414.14,
   "text": "وقتی که زمین عوض می‌شه به یک زمین دیگه‌ای تبدیل می‌شه و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 414.14,
   "end": 416.56,
   "text": "بعد می‌فرمود که قرآن می‌فرما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 416.56,
   "end": 419.62,
   "text": "و اشرقت الارض بنور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 419.62,
   "end": 423.28,
   "text": "ربها. روزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 423.28,
   "end": 427.5,
   "text": "زمین روشن می‌شه به نور پروردگارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.5,
   "end": 431.0,
   "text": "مگه الان زمین به نور پر-- غیر پروردگار روشنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.0,
   "end": 433.98,
   "text": "این چیه؟ این چه نوریه؟ اصلاً این رب چیه اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.98,
   "end": 435.94,
   "text": "باید دید کارشناس چی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 435.94,
   "end": 439.86,
   "text": "مفسرین شیعه ذیل این آیه روایات جالبی آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.86,
   "end": 443.4,
   "text": "که به نور ربها ای به نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 443.4,
   "end": 447.22,
   "text": "امامها. عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 447.22,
   "end": 450.28,
   "text": "یه پرده رفت کنار. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 450.28,
   "end": 453.7,
   "text": "رب من و تو امام عصر من و توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 453.7,
   "end": 457.82,
   "text": "پرورش دهنده ماست. اوست ها که داره ما رو پرورش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 457.82,
   "end": 459.38,
   "text": "توجه کردید به یک معنا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 459.38,
   "end": 464.72,
   "text": "این تازه یک وجهشه. پس من عرف نفسه هر کس خودش رو شناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 464.72,
   "end": 467.9,
   "text": "قطعاً کیو شناخته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 467.9,
   "end": 471.08,
   "text": "عرف امام، امام یا ولیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 471.08,
   "end": 475.78,
   "text": "مرحوم گنابادی اصلاً صراحتاً میاره میگه آقا بگید، بگید ولیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 475.78,
   "end": 478.42,
   "text": "بگید امامه. اصلاً. همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 478.42,
   "end": 484.88,
   "text": "امامش رو شناخته. خب اگر ما اماممون رو نشناختیم گیر کجاست تو نشناختن نفسمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 484.88,
   "end": 488.42,
   "text": "خدا این امتحانات و ابتلاءات رو سر، سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 488.42,
   "end": 492.1,
   "text": "مسیر زندگی ما قرار داده تا ما امام رو بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 492.1,
   "end": 494.76,
   "text": "که حالا این چگونه است خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 494.76,
   "end": 500.6,
   "text": "قص على هذا. یعنی انقدر تو خود بخوان حدیث مفصل از این مجمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 500.6,
   "end": 504.7,
   "text": "اصلاً عزیزان دلم امام عصر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.7,
   "end": 508.38,
   "text": "استشد جلوه تام همه اسماء و صفات خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 508.38,
   "end": 511.56,
   "text": "اصلاً انسان تنها موجودی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 511.56,
   "end": 516.1,
   "text": "دقت کنید این کلمه رو که یک باب جدیدی رو باز می‌کنه به روی ذهن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 516.1,
   "end": 519.94,
   "text": "اما- انسان تنها موجودی‌ست که در ذات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.94,
   "end": 524.14,
   "text": "در صفات و افعال مثل خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 524.14,
   "end": 528.62,
   "text": "لذا خدا جماد رو که خلق کرد، نبات رو که خلق کرد، حیوان رو که خلق کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 528.62,
   "end": 535.48,
   "text": "زمین و آسمان هرچی خلق کرد حتی ملائکه رو هیچ اصلاً نگفت تبارک الله احسن الخالقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 535.48,
   "end": 537.78,
   "text": "انسان رو که خلق کرد گفت فتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 537.78,
   "end": 539.76,
   "text": "هیچ کس هم نبود بهش بارک الله بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 539.76,
   "end": 542.96,
   "text": "چون همه دون ما، دون انسانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 542.96,
   "end": 547.3,
   "text": "تحت انسان تعریف میشن. همه جماد می‌خواد بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 547.3,
   "end": 548.84,
   "text": "به جماد بگو تو میخوای چی بشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 548.84,
   "end": 551.8,
   "text": "میگه اوج عشق من اینه که بشم نبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 551.8,
   "end": 553.78,
   "text": "آقای نبات تو، تو چی میخوای بشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 553.78,
   "end": 555.86,
   "text": "همه آرزوم اینه حیوان بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 555.86,
   "end": 559.1,
   "text": "آقای حیوان همه عشقم اینه انسان بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 559.1,
   "end": 561.1,
   "text": "انسان تو چی میخوای بشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 561.1,
   "end": 563.68,
   "text": "میگه غایت آرزوم اینه که چی بشم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 563.68,
   "end": 566.52,
   "text": "خدا بشم. برسم به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 566.52,
   "end": 570.66,
   "text": "هیچ‌کدومشون خدایی نمی‌تونن بشن جز انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 570.66,
   "end": 573.02,
   "text": "حالا این انسان قدرت خدا رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 573.02,
   "end": 577.76,
   "text": "اصلاً اسم اعظم که در درون هر انسانی تعبیه شده همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.76,
   "end": 580.44,
   "text": "همین فهم این حقیقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 580.44,
   "end": 584.24,
   "text": "که جالبه یکی رو هی گیر داده بود از شاگردان امام صادق .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 584.24,
   "end": 587.66,
   "text": "اینم بشنوید بحث دیگه حالا بحث ادامه داره انشاالله بعدها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 587.66,
   "end": 591.24,
   "text": "تازه ما سر فصل خ-- نقطه سر خطیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 591.24,
   "end": 593.48,
   "text": "گفت آقا جان اسم اعظم آخه این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 593.48,
   "end": 599.44,
   "text": "من نمی‌فهمم. حضرت فرمود که امام صادق علیه السلام چون شاگرد خوبی بود با هر کسی همینطور رفتار نمی‌کنه حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 599.44,
   "end": 601.6,
   "text": "فرمود بندازیدش توی آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 601.6,
   "end": 604.66,
   "text": "یه آب-- جای حالا حوض عمیقی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 604.66,
   "end": 609.32,
   "text": "انداختنش. هرچی هی دست و پا، شنا هم بلد نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 609.32,
   "end": 613.12,
   "text": "دست پا می‌زد بیاد بیرون. تا می‌خواست بیاد بیرون می‌گفت بزنید بندازیدش داخل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 613.12,
   "end": 616.06,
   "text": "انقدر انداختن دیگه به حال غرق شدن افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 616.06,
   "end": 620.74,
   "text": "دیگه کارتم-- فکر کرد دیگه کارتمومه و حضرت داره می‌کشتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 620.74,
   "end": 628.38,
   "text": "اون لحظه از ته وجودش حالا آبم تو دهانه که لفظی هم نمی‌تونه به زبان جاری کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 628.38,
   "end": 630.76,
   "text": "در-- از ته وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 630.76,
   "end": 635.96,
   "text": "خدا، اون پروردگار و خذ-- اون کسی که از ذات او جدا شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 635.96,
   "end": 640.06,
   "text": "او رو صدا زد. یعنی خدای خودش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 640.06,
   "end": 644.44,
   "text": "تا از درون وجودش اون خدا رو صدا زد فرمود بیاریدش بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 644.44,
   "end": 647.46,
   "text": "اجادش کردن. فرمود فهمیدی اسم اعظم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 647.46,
   "end": 649.06,
   "text": "اون یقین وجودیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 649.06,
   "end": 655.2,
   "text": "اون یقینی که در ذات وجود تو نهفته‌ست و این وقت مشکل پیداش کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 655.2,
   "end": 657.96,
   "text": "اصلاً این مشکلات برای اینه که اون رو پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 657.96,
   "end": 659.94,
   "text": "همه ما اسم اعظم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 659.94,
   "end": 662.16,
   "text": "اسم اعظم ما هم در درون ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 662.16,
   "end": 665.12,
   "text": "وقتی مضطر می‌شیم متأسفانه پیداش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 665.12,
   "end": 671.36,
   "text": "اینا همش وجوه شناخت در درون ماست و راه رسیدن به خدا و امام عصر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 671.36,
   "end": 675.14,
   "text": "اصلاً مشکلات، این امتحانات الهی برای اینه که اینو پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 675.14,
   "end": 677.68,
   "text": "و الا اونور کار مشکل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 677.68,
   "end": 680.06,
   "text": "قص على هذا. انشاالله عاقبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 680.06,
   "end": 684.12,
   "text": "بخیر بشه به برکت صلوات در محمد آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 684.12,
   "end": 690.24,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}