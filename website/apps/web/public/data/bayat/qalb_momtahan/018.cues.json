   "title": "## شب شهادت رضا؛ قلب ممتحن و تملکات",
   "start": 12.86,
   "end": 38.38
  },
  {
   "index": 1,
   "title": "## سه نظریهٔ مالکیت و نظریهٔ دینی رضا",
   "start": 38.38,
   "end": 87.96
  },
  {
   "index": 2,
   "title": "## پس از ایمان و ولایت؛ قیام برای مبتلایان",
   "start": 87.96,
   "end": 114.92
  },
  {
   "index": 3,
   "title": "## برداشتن قید تملک مطلقه",
   "start": 114.92,
   "end": 246.58
  },
  {
   "index": 4,
   "title": "## همکاران به مثابهٔ ارحام",
   "start": 246.58,
   "end": 497.08
  },
  {
   "index": 5,
   "title": "## خروج از ولایت با بی‌توجهی",
   "start": 497.08,
   "end": 576.66
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.48,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.48,
   "end": 7.14,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.14,
   "end": 12.64,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.64,
   "end": 17.78,
   "text": "خب شب شهادت آقامون علی ابن موسی الرضا علیهم الصلاة والسلام هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.78,
   "end": 22.34,
   "text": "خب چون صبح زیاد عاشورا داشتید و روضه خوندید ما دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.34,
   "end": 29.02,
   "text": "روضه نخوندیم و صرفا نکته‌ای رو عرض می‌کنیم تبرکاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.02,
   "end": 30.74,
   "text": "از فرمایشات حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.74,
   "end": 35.56,
   "text": "البته برای اینکه مرتبط با بحث ما باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.56,
   "end": 38.0,
   "text": "چون سلسله بحث ما پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.0,
   "end": 42.26,
   "text": "قلب در قرآن بود و رسیده بودیم به قلب ممتحن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.26,
   "end": 44.7,
   "text": "قلبی که توسط خدا امتحان می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.7,
   "end": 49.38,
   "text": "یکی از جاهایی که ما مورد امتحان و ابتلا قرار می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.38,
   "end": 56.66,
   "text": "مالکیت‌های ماست تملکات ما در هر نکته‌ای البته قبلاً تو شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.66,
   "end": 64.08,
   "text": "اون حدیث مبثوت امام الرؤوف صلی الله علیه به ريان بن شبيب که می‌فرماید ان کنت باکی للشي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.08,
   "end": 72.98,
   "text": "فبک للالحسین ابن علی ابن ابی طالب عرض شد که اون لام، لام مالکیت است فبک للالحسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.98,
   "end": 75.58,
   "text": "لام مالکیت یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.58,
   "end": 82.48,
   "text": "همه وجودت تحت تملک ابی عبدالله و ای یفعل و به فعلیت برسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.48,
   "end": 87.96,
   "text": "یعنی اینکه گریه تو نه فقط همه اشک و آه و گریه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.96,
   "end": 91.98,
   "text": "در تملک سید الشهدا باشد و باکی برای حسین باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.98,
   "end": 96.06,
   "text": "همه وجودت تحت تملک سید الشهدا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.06,
   "end": 103.14,
   "text": "قوای وجودیت همه در تصرف و تملک آقا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.14,
   "end": 105.84,
   "text": "خب پس آنچه که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.84,
   "end": 114.36,
   "text": "در تحت تملک خودمون داریم از قواهای وجودیمون، ظاهر و باطنمون، داشته‌ها و حتی نداشته‌هامون همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 114.36,
   "end": 116.98,
   "text": "به نوعی امتحان الهی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.98,
   "end": 121.18,
   "text": "که خدا داره ما رو امتحان می‌کنه در این تملک‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 121.18,
   "end": 123.56,
   "text": "یا عدمش چگونه رفتار می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.56,
   "end": 130.18,
   "text": "مهم رفتار ماست. در خصوص قاعده مالکیت که از اصول اساسی و بنیادین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.18,
   "end": 134.88,
   "text": "اقتصاد هست، می‌دونید که سه تا نظریه وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 134.88,
   "end": 138.26,
   "text": "یکی نظریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.26,
   "end": 141.54,
   "text": "آزادی مالکیت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.54,
   "end": 145.62,
   "text": "براش فرقی نمی‌کنه از کجا درآره یا کجا خرج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.62,
   "end": 149.98,
   "text": "آزاده، کامل از هر جا دوست‌داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 149.98,
   "end": 155.08,
   "text": "کسب درآمد می‌کنه به هر روشی و به هر روش و هر جایی دوست‌داشت خرج می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 155.08,
   "end": 158.34,
   "text": "این آزادی کامل در مالکیت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.34,
   "end": 161.46,
   "text": "که اصطلاحاً همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.46,
   "end": 167.9,
   "text": "ااah احسنت بهش میگن که همین لیبرالیسم اقتصادی که نوع دومش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 167.9,
   "end": 170.62,
   "text": "محدودیت در مالکیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.62,
   "end": 173.78,
   "text": "حالا اصطلاحاً سوسیالیسم اقتصادی بهش میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.78,
   "end": 176.22,
   "text": "محدودیت در اقتصاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.22,
   "end": 178.34,
   "text": "در مالکیت یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.34,
   "end": 185.24,
   "text": "یک قوانین رو می‌گذارند که حالا قاد-غالباً هم این قوانین دست و پاگیر هست و وحی منزل هم نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.24,
   "end": 187.56,
   "text": "و طبق اون باید چه کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.56,
   "end": 191.86,
   "text": "باید عمل کنه. حق نداره از هر راهی کسب درآمد کنه و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.86,
   "end": 194.78,
   "text": "هر راهی خرج کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.78,
   "end": 199.16,
   "text": "اصطلاح سوم کمونیسم اقتصادیه که اصطلاحاً میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.16,
   "end": 201.72,
   "text": "مالکیت مطلق دست دولته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.72,
   "end": 205.02,
   "text": "هرچی که حکومت و دولت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 205.02,
   "end": 209.3,
   "text": "امر کرد همونه. یعنی همه چی تحت تملک دولته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.3,
   "end": 216.52,
   "text": "هیچ کسی برای خودش عهدی مالکیتی نداره حتی اگر خودش تملکی داشته یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.52,
   "end": 219.0,
   "text": "از شود از طریق اقتصادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.0,
   "end": 223.2,
   "text": "مالی رو جمع کرده. اما در میان همه این نظریه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.2,
   "end": 229.22,
   "text": "جالبه که بدونید آقامون علی ابن موسی الرضا که معروف است به عالم آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.22,
   "end": 234.74,
   "text": "صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.74,
   "end": 238.96,
   "text": "نظریه دینی رو اینجا مطرح می‌کنند پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 238.96,
   "end": 241.8,
   "text": "مالکیت مطلقه الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.8,
   "end": 251.5,
   "text": "و می‌فرماید ضمن ارزشی که برای تملک مردم قائل است، امام رضا می‌فرماید اون مالکیت مطلقه صرفاً مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 251.5,
   "end": 257.74,
   "text": "خداست و آنچه که تو داری و ت-- در تملک تو حتی خود تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 257.74,
   "end": 259.84,
   "text": "این‌ها همه عاریه‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 259.84,
   "end": 261.92,
   "text": "مجازی‌اند به قول امام رضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 261.92,
   "end": 265.82,
   "text": "یه جا می‌فرماید مزا-مجازی‌اند، یه جا می‌فرماید عاریتی‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.82,
   "end": 270.82,
   "text": "و حتی سودی که تو از تجارت به دست میاری می‌فرماید این هم غنیمت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 270.82,
   "end": 274.06,
   "text": "مال خودت نیست، مال غیر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 274.06,
   "end": 277.96,
   "text": "در فعلاً امانت به دست تو سپرده‌ست که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 277.96,
   "end": 283.1,
   "text": "برای چی امانته؟ برای چی مالکیت من امانت است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.1,
   "end": 286.04,
   "text": "برای اینکه ما در معرض امتحانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.04,
   "end": 288.8,
   "text": "همه رو هم قراره بذاریم و بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.8,
   "end": 292.68,
   "text": "ما د-- حتی در تملکات علمیه خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.68,
   "end": 297.2,
   "text": "اونچه که از علم و معرفت تملک پیدا کردیم در وجودمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.2,
   "end": 301.22,
   "text": "در موطن وجود خودمون، اون هم به نوعی امتحانه‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.22,
   "end": 303.74,
   "text": "که تو نسبت به داشته‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 303.74,
   "end": 307.38,
   "text": "علمی و دانش و معرفت درونی‌ت چگونه رفتار کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.38,
   "end": 313.34,
   "text": "تا بگیری مسائل اقتصادی و همه ز-- لذا زکات فقط تو بحث اقتصادی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.34,
   "end": 315.8,
   "text": "حتی میگه زکات العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.8,
   "end": 318.08,
   "text": "نشرهُ یا زکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.08,
   "end": 319.96,
   "text": "بدن میگه صوم است، روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.96,
   "end": 322.12,
   "text": "همه چی زکات داره. البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.12,
   "end": 328.9,
   "text": "در یک فرمایشی شخصی از امام الرؤوف این در این روایت که عرض می‌کنم تفسیر نور الثقلین، جلده دو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 328.9,
   "end": 331.16,
   "text": "صفحه چهارصد و نود و پنج هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.16,
   "end": 334.92,
   "text": "یکی از امام رضا علیه الصلاة والسلام می‌پرسه آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.92,
   "end": 337.64,
   "text": "در مال ما تکلیفی به جز زکات هم هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.64,
   "end": 340.04,
   "text": "یعنی ما زکات رو دادیم تموم شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.04,
   "end": 342.22,
   "text": "تکلیف مالی ما ادا شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.22,
   "end": 344.68,
   "text": "حضرت می‌فرماید نخیر، کی اینو حرفو زده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 344.68,
   "end": 347.78,
   "text": "اصا-اشاره می‌کنند به اون آیه صلة الرحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.78,
   "end": 351.64,
   "text": "و می‌فرماید اتفاقاً شما باید با آنچه که خدا به شما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.64,
   "end": 355.36,
   "text": "تملک شما قرار داده، در حقیقت به صورت مجازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.36,
   "end": 361.82,
   "text": "و به شما این‌ها رو امانت سپرده، برسید به ارحامتون، به نزدیکانتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.82,
   "end": 367.74,
   "text": "اینکه زکات فطره رو میگه اگر تو شهر خودت، فامیل خودت، خونواده و نزدیکانت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 367.74,
   "end": 370.8,
   "text": "فقیر است حق نداری بدی به جای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.8,
   "end": 373.36,
   "text": "امام رضا صلوات الله علیه می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.36,
   "end": 376.66,
   "text": "اصلاً تو باید اول با اونچه که داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.66,
   "end": 382.96,
   "text": "برسی به داد اون کسایی که دور و برتن، رحمتن به نوعی حتی همکارهای اداره شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 382.96,
   "end": 387.44,
   "text": "اینا هم به نوعی ره، روحمای شما میشن ارهام شما میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 387.44,
   "end": 389.76,
   "text": "اینها هم باید اول اگر کسی همکار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 389.76,
   "end": 392.42,
   "text": "مشکل‌داری داره قیام کنه براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 392.42,
   "end": 395.34,
   "text": "در روایت دیگری در کتاب عیون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.34,
   "end": 399.48,
   "text": "اخبار الرضا جلد دو صفحه صد و شصت و نه این رو هم بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.48,
   "end": 403.36,
   "text": "و بحث تمام. حضرت در خصوص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.36,
   "end": 405.22,
   "text": "چون حضرت وقتی عوامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.22,
   "end": 410.58,
   "text": "فقر رو می‌شمارن یکی از عوامل فقر و گرفتاری‌های اقتصادی جامعه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.58,
   "end": 416.02,
   "text": "بی‌توجهی به گرفتار‌ها و مددکاری اجتماعی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.02,
   "end": 417.98,
   "text": "بی‌توجهی به این قصه بر می‌شمارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 417.98,
   "end": 420.74,
   "text": "خیلی جالبه حضرت ببینید می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.74,
   "end": 424.66,
   "text": "بدانید که پس از ایمان به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 424.66,
   "end": 431.08,
   "text": "و اعتراف به حقوق اهل بیت علیهم الصلاة والسلام این دو تا وزنه سنگین میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.08,
   "end": 433.5,
   "text": "ایمان، ولایت اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.5,
   "end": 436.54,
   "text": "این دو تا میگه پس از این دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.54,
   "end": 439.54,
   "text": "بلافاصله وظیفه ما رو چگونه می‌شماره حضرت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.54,
   "end": 442.28,
   "text": "می‌فرماید توانمندان را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.28,
   "end": 444.7,
   "text": "مکلف کرده است خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.7,
   "end": 449.12,
   "text": "حالا هرچی، هر مقدار که در تملکته، هرچی هست آبروعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.12,
   "end": 451.94,
   "text": "پوله، ماله. چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.94,
   "end": 454.7,
   "text": "از جهت علمی قدرت داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.7,
   "end": 456.9,
   "text": "علم تو وجودته. هرچی که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 456.9,
   "end": 463.06,
   "text": "میگه مکلف کرده است تا برای اداره امور بیماران زمین‌گیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 463.06,
   "end": 466.68,
   "text": "و دیگر مبتلایان قیام کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 466.68,
   "end": 473.4,
   "text": "قیام. امول الله مثنی و فرادی که قرآن میگه یا تک تک یا دو دو تا دو تا قیام کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 473.4,
   "end": 475.28,
   "text": "امام رضا میگه اصلاً بر شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.28,
   "end": 477.8,
   "text": "جالبه بعد از ایمان و ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.8,
   "end": 482.74,
   "text": "میگه شما مکلفید اصلاً وظیفه شماست قیام کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 482.74,
   "end": 486.3,
   "text": "حالا می‌دونید احادیث اهل بیت هم مثل آیات قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 486.3,
   "end": 493.14,
   "text": "کلمه به کلمه بلکه حرف به حرفش هفتاد تا عمق و معنا بلکه به یک روایت هفتاد هزار معنا دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 493.14,
   "end": 498.54,
   "text": "این که میگه مبتلایان نه یعنی فقط اون کسی که فلجه یا افلیجه چه می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.54,
   "end": 501.16,
   "text": "نه، مبتلا به هر مشکلی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 501.16,
   "end": 505.18,
   "text": "هر قسمی از اقسام گرفتاری‌های روز هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.18,
   "end": 507.74,
   "text": "یا میگه مثلاً بیماران زمین‌گیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 507.74,
   "end": 511.02,
   "text": "این بیمار نه فقط بیمار جسمی، بیمار روحی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 511.02,
   "end": 514.84,
   "text": "بیمار عرض شود اخلاقی، بیمار اعتقادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 514.84,
   "end": 520.64,
   "text": "همه این‌ها رو شامل میشه. میگه قیام کنید و این امتحان من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 520.64,
   "end": 526.94,
   "text": "اگر کسی به فرمایش امام رضا صلوات الله علیه بی‌توجه به گرفتاران از هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 526.94,
   "end": 531.32,
   "text": "قسمش که باشد در اجتماع در نزدیک و دور خودش باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.32,
   "end": 534.7,
   "text": "چنین کسی از ولایت اهل بیت و خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 534.7,
   "end": 538.5,
   "text": "خارج شده است. لذا یکی از امتحانات اساسی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.5,
   "end": 542.42,
   "text": "اینه که این قید رو اول از تملک خودمون برداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 542.42,
   "end": 544.58,
   "text": "این قید که برداشته شد راحت می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.58,
   "end": 547.06,
   "text": "چی؟ قید تملک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.06,
   "end": 550.24,
   "text": "مطلقه. نه، تملک مطلقه مال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.24,
   "end": 553.2,
   "text": "وقتی فهمیدی هیچی از تو نیست راحت میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 553.2,
   "end": 555.74,
   "text": "راحت می‌بخشی چون مال تو نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 555.74,
   "end": 559.66,
   "text": "گرفتاری اینجاست که تو مال خودت می‌دونی که به سختی می‌بخشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.66,
   "end": 563.66,
   "text": "این قید رو برداشتی تو امتحانات سر بلند میشی به فکر دیگران هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.66,
   "end": 566.98,
   "text": "اون موقع اگه ده تومن بخشیدی نمیگی ای کاش پنج تومن می‌بخشیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 566.98,
   "end": 569.22,
   "text": "بس که پنج تومن اضافه دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.22,
   "end": 571.36,
   "text": "ان شا الله که هافتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 571.36,
   "end": 576.66,
   "text": "به برکت صلوات بر محمد و آل محمد. الله الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}