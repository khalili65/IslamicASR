   "title": "## قصدِ اقامتِ ده روز و خروجِ ضروری",
   "start": 1.52,
   "end": 22.56
  },
  {
   "index": 1,
   "title": "## قلبِ ممتحَن و اصلِ خودشناسی",
   "start": 22.56,
   "end": 232.32
  },
  {
   "index": 2,
   "title": "## قرآن بس است؛ یاسین جانِ قرآن",
   "start": 232.32,
   "end": 357.72
  },
  {
   "index": 3,
   "title": "## نفوس و نگاه به نظامِ تکوین",
   "start": 357.72,
   "end": 436.39
  },
  {
   "index": 4,
   "title": "قرآن دربارهٔ خدا می‌فرماید:",
   "start": 436.39,
   "end": 602.19
  },
  {
   "index": 5,
   "title": "## عقل امّ الطیّبات؛ جهل امّ الخبیثات",
   "start": 602.19,
   "end": 790.41
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.52,
   "end": 6.46,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.46,
   "end": 10.22,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.22,
   "end": 15.42,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.42,
   "end": 22.56,
   "text": "خب قبلاً ما این حکم رو عرض کردیم که اگر چنانچه جایی قصد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.56,
   "end": 26.34,
   "text": "اقامت ده روزه بخوای بکنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.34,
   "end": 33.96,
   "text": "نمی‌تونی در حینی که می‌خوای قصد اقامت کنی قصد داشته باشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.96,
   "end": 39.0,
   "text": "در ای-- در حین اون ده روز شما از محل اقامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.0,
   "end": 43.6,
   "text": "ده روزت قصد کنی مثلا روز چهارم، پنجم یا هر روزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.6,
   "end": 45.76,
   "text": "بری مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.76,
   "end": 50.7,
   "text": "خارج بشی از این البته نه به قصد مسافت شرعی که ایشون که اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.7,
   "end": 53.8,
   "text": "ولی حالا به مسافتی بری که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.8,
   "end": 56.14,
   "text": "مسافت اگرچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.14,
   "end": 58.56,
   "text": "مسافت شرعی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.56,
   "end": 63.06,
   "text": "اما بیرون از اون مثلا محل شماست، بیرون از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.06,
   "end": 68.58,
   "text": "جاییه که شما هستی. مثل مثالی که قبلاً زدیم مد-- نجف و کوفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.58,
   "end": 72.08,
   "text": "مثلا شما تو نجف مستقری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.08,
   "end": 75.94,
   "text": "قبل از اینکه قصد ده روز کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.94,
   "end": 82.5,
   "text": "اگر در عرف اونجا کوفه رو جدای از شهر نجف بدونن شما نمی‌تونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.5,
   "end": 85.38,
   "text": "وقتی می‌خوای قصد ده روزه بکنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.38,
   "end": 89.44,
   "text": "بگی خب حالا یه بارم تو این ده روز میرم کوفه و برمی‌گردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.44,
   "end": 92.86,
   "text": "نمی‌تونی. اگر عرف اونجا کوفه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.86,
   "end": 95.18,
   "text": "جزء شهر نجف ندونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.18,
   "end": 101.12,
   "text": "حالا سؤال اینه، اینی که قبلاً گفتیم، سؤال اینه که اگر بعد از قصدت این اتفاق افتاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.12,
   "end": 107.52,
   "text": "یعنی شما قصد کردی ده روزه جا بمونی قصد هم نداری بین این ده روز خارج بشی از اون محل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.52,
   "end": 113.14,
   "text": "یه اتفاق ضروری، یه مسئله‌ای پیش اومد ضرورتا شما باید بری خارج شی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.14,
   "end": 116.98,
   "text": "زیر مسافت شرعی یعنی به بیست کیلومتر و نیم نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.98,
   "end": 120.22,
   "text": "بری مثلا یه جایی و برگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.22,
   "end": 122.8,
   "text": "آیا می‌تونی این کارو بکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.8,
   "end": 126.0,
   "text": "رهبر عزیزمون فرمودن که جایزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.0,
   "end": 129.2,
   "text": "اگر بعد از قصد ده روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.2,
   "end": 133.88,
   "text": "و حداقل خوندن یک نماز چهار رکعتی این اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.88,
   "end": 136.16,
   "text": "یعنی شما قصد ده روزت رو کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.16,
   "end": 145.28,
   "text": "حداقل یک نماز چهار رکعتی هم خوندی، یه دفعه یه اتفاقی ضرورتا پیش اومد که شما باید خارج بشی از محل اقامتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.28,
   "end": 148.02,
   "text": "بری زیر مسافت شرعی، بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.02,
   "end": 151.84,
   "text": "مثلا یک ساعت دو ساعت بری برگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.84,
   "end": 157.48,
   "text": "اشکالی نداره. در صورتی که قبلاً اینو قصد نکرده باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.48,
   "end": 164.8,
   "text": "ما بحثمون قلب ممتhen بود، قلبی که از سمت خدای منان مورد امتحان واقع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.8,
   "end": 170.34,
   "text": "رسیدیم به اینجا که اصل و اساس این امتحانات و ابتلاءات الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.34,
   "end": 172.94,
   "text": "شناخت ما نسبت به خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.94,
   "end": 175.06,
   "text": "اینه که ما خودمون رو بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.06,
   "end": 179.3,
   "text": "در حقیقت خودشناسی یا نفس‌شناسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.3,
   "end": 182.02,
   "text": "اصل و اساس این امتحانات است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.02,
   "end": 186.12,
   "text": "که ما خودمون رو برانداز کنیم که چه کاره هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.12,
   "end": 191.36,
   "text": "و بتونیم جبران کنیم. اون که امیرالمؤمنین علیه الصلاة والسلام فرمود إنك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.36,
   "end": 194.16,
   "text": "یا أتظن أنك جرم صغير",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.16,
   "end": 196.62,
   "text": "وفيك تبل العالَم الأكبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.62,
   "end": 201.24,
   "text": "تو گمان می‌کنی یک جرم کوچکی هستی در حالی که عالم بزرگی، اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.24,
   "end": 205.2,
   "text": "نگ-- نمیگه عالم کبیر. عالمی بزرگتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.2,
   "end": 209.3,
   "text": "همه چی. اصلاً اون بزرگ‌ترین عالم خود تو هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.3,
   "end": 215.46,
   "text": "که در خود تو نهاد، نهادینه شده، در نهاد وجود تو قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.46,
   "end": 220.86,
   "text": "این رو ما باید بشناسیم. اینکه در قرآن می‌فرماید یاسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.86,
   "end": 223.42,
   "text": "قرآن بسه دیگه برای ما به قول علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.42,
   "end": 228.3,
   "text": "اول بسم-- اول قرآن با با شروع میشه بسم الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.3,
   "end": 230.4,
   "text": "آخرش هم با سین و الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.4,
   "end": 237.4,
   "text": "علامه چه شیرین علامه حائری یزدی حفظه الله تعالی می‌فرمود که این با به اون سین بچسبه میشه بس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 237.4,
   "end": 242.96,
   "text": "یعنی اصلاً قرآن برای تو بسه. حالا این قرآن قلبش کدوم سوره است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.96,
   "end": 245.18,
   "text": "قلب قرآن، جان قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.18,
   "end": 249.78,
   "text": "تو می‌خوای دنبال جان خودت بگردی، جان خودت رو می‌خوای بشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.78,
   "end": 253.3,
   "text": "قلب وجود انسان، محصل وجود انسان و ق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 253.3,
   "end": 255.46,
   "text": "جان وجود ماست، سر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.46,
   "end": 259.34,
   "text": "میگه سر قرآن، قلب قرآن، جان قرآن سوره یا سین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.34,
   "end": 262.64,
   "text": "یا سین. چه گفتن مفسرین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.64,
   "end": 266.16,
   "text": "حرف‌های بسیار عجیب و سنگینی زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.16,
   "end": 269.16,
   "text": "یکی از اون‌ها که مرتبط با بحث ماست میگن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.16,
   "end": 272.44,
   "text": "سین خود نفس ناطقه انسانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.44,
   "end": 276.08,
   "text": "یعنی همون البته میگه ای سید بشر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.08,
   "end": 279.46,
   "text": "خطاب به پیغمبر ظاهر قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.46,
   "end": 283.5,
   "text": "اما بزرگان فرمودن همون نفس ناطقه انسانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.5,
   "end": 286.16,
   "text": "اصلاً پیغمبر چرا اینقدر عظمت پیدا کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.16,
   "end": 290.26,
   "text": "به واسطه همون نفس ناطقه انسانیه که خدا به او داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.26,
   "end": 292.72,
   "text": "و این سعه‌ای که در پیغمبر، در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.72,
   "end": 295.16,
   "text": "وجود پیغمبر وجود داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.16,
   "end": 301.12,
   "text": "این اجتهاد وجودی، این س-- وسعت وجودی، همون نفس ناطقه پیغمبره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.12,
   "end": 307.16,
   "text": "که خدا به همه داده. ما متأسفانه زیر خروارها خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 307.16,
   "end": 310.98,
   "text": "این رو خفه‌ش کردیم و چال‌ش کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.98,
   "end": 312.98,
   "text": "پیغمبر بهش رسید. یاسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.98,
   "end": 315.46,
   "text": "ای-- وقتی می‌خونی داره به تو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.46,
   "end": 318.7,
   "text": "میگه ای نفس ناطقه انسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.7,
   "end": 322.18,
   "text": "والقرآن الحکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.18,
   "end": 324.4,
   "text": "اصلاً قرآن تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.4,
   "end": 326.84,
   "text": "قرآن در وجود تو نهفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.84,
   "end": 330.7,
   "text": "تو برای اینکه خودت رو بشناسی اومدی باید قرآن رو بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.7,
   "end": 333.78,
   "text": "قرآن کتاب خودشناسی توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.78,
   "end": 337.64,
   "text": "می‌خوای خودت رو ببینی؟ کتاب قرآن رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.64,
   "end": 341.58,
   "text": "کمک حال می‌خوای؟ جالبه که خدا کمک درسی هم گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.58,
   "end": 344.56,
   "text": "یه کتاب کمکی می‌خوای برات بذاریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.56,
   "end": 347.52,
   "text": "نظام تکوین عالم. کتاب بیرون از تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.52,
   "end": 351.18,
   "text": "اون کتاب تکوین است و این کتاب تدوین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.18,
   "end": 353.38,
   "text": "که ب-- قبلاً بحثش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.38,
   "end": 355.66,
   "text": "بیرون رو نگاه کن. نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.66,
   "end": 358.78,
   "text": "اصلاً حیوانات رو نگاه کن. ببینید ما چند تا نفس داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 358.78,
   "end": 363.2,
   "text": "البته قرآن می‌فرمود حداقل بیست و سه تا نفس تو قرآن اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.2,
   "end": 370.45,
   "text": "لکن به صورت کلی تقسیم میشه به همون نفس نباتی و نفس حیوانی و نفس انسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.45,
   "end": 373.01,
   "text": "که از همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.01,
   "end": 375.53,
   "text": "وسیع‌تر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.53,
   "end": 380.89,
   "text": "شدیدتر نفس ناطقه انسانیه و مورد بحث ما هم همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.89,
   "end": 386.45,
   "text": "لکن برای اینکه این نفس شناسایی بشه اشکال نداره انسان به حیوانات هم نگاه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 386.45,
   "end": 395.25,
   "text": "جالبه من کمتر سخنرانی از علامه حسن زاده و شاگرداش دیدم که در بین صحبتش اشاره‌ای به نظام تکوین نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.25,
   "end": 399.41,
   "text": "اصا-- اشاره‌ای به سیر انفسی و سیر افقی نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.41,
   "end": 401.69,
   "text": "میگه آقا نگاه کن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.69,
   "end": 405.41,
   "text": "درختو ببین، این حیوان رو ببین، اون دانشگاه، اون دا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.41,
   "end": 410.07,
   "text": "عرض شود دانشمند فرانسوی خودش میگه حالا اسمش یادم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 410.07,
   "end": 413.15,
   "text": "شصت سال عمر از خدا گرفتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.15,
   "end": 417.19,
   "text": "بیست جلد کتاب نوشتم در خصوص یک عنکبوت فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 417.19,
   "end": 421.77,
   "text": "بعد تازه میگه نفهمیدم آخر، آخرشم نفهمیدم این چه موجودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.77,
   "end": 426.59,
   "text": "شصت سال عمر یک دانشمند رو یک عنکبوت خدا گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 426.59,
   "end": 430.91,
   "text": "خب ببینید نظام خلقت رو. قرآن می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 430.91,
   "end": 435.93,
   "text": "لا تا-- در خصوص خدا می‌فرماید \"لا تَأْخُذُهُ سِنَةٌ وَلا نَوْمٌ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.93,
   "end": 440.23,
   "text": "لکن ما دیروز عرض کردیم نفس ناطقه انسانی به وزان خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.23,
   "end": 447.05,
   "text": "یعنی انسان تنها موجودی‌ست که هم در ذات، هم در صفات و هم در افعال مثل خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.05,
   "end": 448.65,
   "text": "و می‌تونه مثل خدا عمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.65,
   "end": 451.17,
   "text": "\"عبدی اطعنی حتی اجعلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.17,
   "end": 452.85,
   "text": "مثلی او مثلی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.85,
   "end": 457.67,
   "text": "اینم سرشه. فقط سرش در عبودیته، اطاعت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.67,
   "end": 460.33,
   "text": "بعد مثل خدا می‌تونی عمل کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.33,
   "end": 464.65,
   "text": "می‌تونی عمل کنی. میگه \"لا تَأْخُذُهُ سِنَةٌ وَلا نَوْمٌ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.65,
   "end": 467.85,
   "text": "لطیفه‌ای اینجا هست به قول بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.85,
   "end": 471.09,
   "text": "سنه و نوم چیه؟ در عربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 471.09,
   "end": 474.49,
   "text": "خواب و در عربی چرت رو میگن سنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 474.49,
   "end": 478.65,
   "text": "در حالی که سر پایینه. دیدی چرتت می‌گیره سرت میفته پایین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.65,
   "end": 486.15,
   "text": "اینو میگن سنه. وقتی سرت بالاست مثلاً تکیه کردی سرت بالاست خوابت میره به این میگن نوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 486.15,
   "end": 489.19,
   "text": "اون نومه، اون خوابه، این چرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.19,
   "end": 491.75,
   "text": "میگه \"لا تَأْخُذُهُ سِنَةٌ وَلا نَوْمٌ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.75,
   "end": 495.13,
   "text": "انسان هم این چنینه. اصلاً خواب انسان این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 495.13,
   "end": 499.35,
   "text": "اصلاً اون خوابی که در قرآن با لطافت بیان شده این نوع خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.35,
   "end": 501.61,
   "text": "نه خوابی که به پشت بخوابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 501.61,
   "end": 508.07,
   "text": "پاشو بده هوا و لم بده و به چ-- به غلت از اینور به-- کدوم حیوان تا حالا دیدید حتی اینطوری بخوابه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.07,
   "end": 511.03,
   "text": "تا حالا حیوونو دیدید شما مثل انسان بخوابه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 511.03,
   "end": 514.69,
   "text": "اکثراً خود حیوانات نشسته خوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 514.69,
   "end": 517.71,
   "text": "پاشونم جمع کردن و نشسته خوابیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.71,
   "end": 520.21,
   "text": "من ندیدم اگه شما دیدید به من بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 520.21,
   "end": 526.25,
   "text": "یا جالب از، جالب‌تر از نه، خا-- اتفاقاً جالبه مار هم می‌خواد بخوابه چمباتمه می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.25,
   "end": 529.47,
   "text": "خودشو ول نمی‌کنه مثل انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.47,
   "end": 533.35,
   "text": "مثلاً خوابی که در لطافت قرآن اومده نوم اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 533.35,
   "end": 537.85,
   "text": "بعد اونجا غوغاست. توی اینجور خواب‌ها که جالبه شما این رو کجا تجربه می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 537.85,
   "end": 544.31,
   "text": "هر کی گفت این نوع خواب که اصل خوابه به لطافت آیات قرآنی کجا تجربه می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 544.31,
   "end": 547.25,
   "text": "پا منبر ما آخوندا .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 547.25,
   "end": 549.99,
   "text": "اکثراً اینطوری سرشونو آاا رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 549.99,
   "end": 553.25,
   "text": "حالا چه سنش باشه، چه نوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 553.25,
   "end": 555.23,
   "text": ". آقا لطافت‌ها اونجا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 555.23,
   "end": 559.91,
   "text": "چیزها دیده می‌شه که بعضی از شما به حقایقی دست پیدا کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.91,
   "end": 562.27,
   "text": "پا منبر ما با اینجور خواب‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 562.27,
   "end": 566.91,
   "text": "البته ج-- میگه حالا نگاه کن شما ببین آقا بعضی از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 566.91,
   "end": 571.93,
   "text": "حیوانات جالب مثلاً با بی-- پاش آویزون شده به شاخه درخت خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 571.93,
   "end": 574.11,
   "text": "آخه این چه جور دیگه خوابیه دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 574.11,
   "end": 579.29,
   "text": "من نمی‌فهمم این دیگه. یا یه پا-- روی یه پاش وایساده خوابه حیوان بعضی پرنده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 579.29,
   "end": 583.99,
   "text": "اصلاً خوابشون این شکلیه. انسان آدم دقت می‌کنه آخه این چه نظامیه، این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.99,
   "end": 585.71,
   "text": "همش سر در سره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.71,
   "end": 588.73,
   "text": "به قول علامه تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 588.73,
   "end": 596.31,
   "text": "جز به جز این عالم خلقت از جماد بگیر تا نبات و حیوان و انسان همه و همه علم انباشته روی همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 596.31,
   "end": 601.35,
   "text": "و تو باید به این حقایق دست پیدا کنی که خودت رو بشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 601.35,
   "end": 606.79,
   "text": "جالبه. خدا رحمت کنه مرحوم حاجی سبزواری علیه الرحمه یه جمله کلیدی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 606.79,
   "end": 610.79,
   "text": "می‌فرماید العقل ام الطيبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 610.79,
   "end": 615.01,
   "text": "والجهل ام الخبیثات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 615.01,
   "end": 619.07,
   "text": "عجب! میگه عقل مادر همه پاکی‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 619.07,
   "end": 627.99,
   "text": "هرکس از این عالم غذای عقلی برداره و بر اساس عقلش رفتار کنه، نه وهم و خیالش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 627.99,
   "end": 630.49,
   "text": "نه وهم و، وهمی که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 630.49,
   "end": 633.03,
   "text": "خیالی که مشوب یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 633.03,
   "end": 637.95,
   "text": "عرض شود عقلی که مشوب به وهم شده، عقلی که مشوب به خیال شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 637.95,
   "end": 641.95,
   "text": "نه، عقل محض. این مادر همه پاکی‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 641.95,
   "end": 645.11,
   "text": "هرکس پاک زندگی می‌کنه بدونید عاقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 645.11,
   "end": 648.01,
   "text": "والجهل ام الخبیثات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 648.01,
   "end": 653.31,
   "text": "هرکس که به نا-- زشتی و ناپاکی میفته این آدم جاهلیه، نادونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 653.31,
   "end": 657.23,
   "text": "ما باید از این عالم غذای عقلی برداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 657.23,
   "end": 660.93,
   "text": "از سفره عالم تا بتونیم خودمون رو بشناسیم و الا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 660.93,
   "end": 663.15,
   "text": "هیچی نمی‌رسیم. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 663.15,
   "end": 667.81,
   "text": "صرفاً بزرگ شدن ما، بزرگ شدن نباتی باید باشه یا انسانی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 667.81,
   "end": 671.23,
   "text": "بزرگ شدن حیوانی اینکه جثه‌مون بزرگ باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 671.23,
   "end": 676.87,
   "text": "یا اینکه انسانیت وجودمون، اون نفس ناطقه‌مون در اشتداد، اشتداد وجودیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 676.87,
   "end": 680.09,
   "text": "وسعت پیدا کنه، شدت بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 680.09,
   "end": 685.57,
   "text": "همه حقایق عالم به یک باره درش قرار بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 685.57,
   "end": 689.35,
   "text": "که اون تا جایی که امیرالمؤمنین علیه السلام اشاره به سینش کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 689.35,
   "end": 692.37,
   "text": "بفرماید ان هاؤلا هاؤلاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 692.37,
   "end": 695.57,
   "text": "ها هنا لعلم جمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 695.57,
   "end": 697.77,
   "text": "این، اینو می‌بینید؟ این سینه رو می‌بینید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 697.77,
   "end": 700.03,
   "text": "علم جمعی خ-- جمع خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 700.03,
   "end": 702.05,
   "text": "میگه جام جمع، جمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 702.05,
   "end": 705.25,
   "text": "لعلم جمع. جمع چرا میگن جام جمع؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 705.25,
   "end": 707.75,
   "text": "الان شما تو جام جمعید مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 707.75,
   "end": 711.51,
   "text": "جام جمع چرا؟ چون همه مثلاً عالم توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 711.51,
   "end": 714.55,
   "text": "جامیه که همه چی توش جمع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 714.55,
   "end": 716.83,
   "text": "این کجاش جام جمعه اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 716.83,
   "end": 719.57,
   "text": "این جمع-- جام جهله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 719.57,
   "end": 724.07,
   "text": "جسارت به شما نشه. امیرالمؤمنین میگه سینه من جام جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 724.07,
   "end": 728.27,
   "text": "همه چی توش جمعه. ب-- چطور می‌شه به اینجا می‌رسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 728.27,
   "end": 732.53,
   "text": "خب این، این اشت-- اینها، این استعداد رو خدا به من و تو داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 732.53,
   "end": 736.19,
   "text": "قربونت برم. و الا ملاصدرا تو اسفار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 736.19,
   "end": 738.41,
   "text": "می‌فرمود که فکر می‌کنم جلده هشت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 738.41,
   "end": 742.77,
   "text": "می‌فرمود که اکثریت مردم سبیان العقولن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 742.77,
   "end": 746.27,
   "text": "سبیان با صاد. میگه عقلشون بچه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 746.27,
   "end": 748.09,
   "text": "اصلاً رشد ندادن به عقلشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 748.09,
   "end": 752.27,
   "text": "فقط جسمشون رشد نباتی و حیوانی پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 752.27,
   "end": 756.63,
   "text": "اساس وجود ما، اون علم و آگاهی و معرفت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 756.63,
   "end": 759.05,
   "text": "اندیشه ماست به قول شهید مطهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 759.05,
   "end": 765.99,
   "text": "اونه که عمل‌زاست و ما اصلاً اومدیم مورد امتحان قرار بگیریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 765.99,
   "end": 768.37,
   "text": "اون ذات وجودی خودمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 768.37,
   "end": 773.05,
   "text": "اون نفس ناطقه خودمون رو و قواش رو بشناسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 773.05,
   "end": 778.03,
   "text": "و با و-- به وسیله عقل به قلب که حضور محض است برسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 778.03,
   "end": 781.59,
   "text": "که قلب قرآن است. ان شا الله عاقبت ما ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 781.59,
   "end": 784.87,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 784.87,
   "end": 790.41,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}