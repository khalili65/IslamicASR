   "start": 12.44,
   "end": 73.46
  },
  {
   "index": 1,
   "title": "## فلسفهٔ امتحانات؛ تمیز خبیث از طیب",
   "start": 73.46,
   "end": 189.6
  },
  {
   "index": 2,
   "title": "## حدیث ابتلا؛ محبت و ایذلال",
   "start": 189.6,
   "end": 290.0
  },
  {
   "index": 3,
   "title": "## چشم زدن خدا؛ نگاه ما و نگاه پیامبر",
   "start": 290.0,
   "end": 324.24
  },
  {
   "index": 4,
   "title": "## وجوه متعدد اخذ مال و فرزند",
   "start": 324.24,
   "end": 433.78
  },
  {
   "index": 5,
   "title": "## مصرف در راه خدا؛ معنایی دیگر",
   "start": 433.78,
   "end": 492.36
  },
  {
   "index": 6,
   "title": "## برگشت به ازل؛ غفر ماضی در حدیث گریه",
   "start": 492.36,
   "end": 666.98
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.56,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.56,
   "end": 7.2,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.2,
   "end": 11.28,
   "text": "آیات سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.28,
   "end": 14.36,
   "text": "می‌دونید صیغه نذر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.36,
   "end": 17.5,
   "text": "صرفا با نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.5,
   "end": 20.46,
   "text": "جدا‌اند این‌ها با هم. اینطور نیستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.46,
   "end": 25.6,
   "text": "اگر کسی نیت نزری رو کرد بر گردنش واجب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.6,
   "end": 29.78,
   "text": "باید حتما صیغه رو بر لسان جاری کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.78,
   "end": 38.78,
   "text": "یعنی صیغه نذر اگر بر لسان جاری نشد حتی اگر طرف نیت نذر رو کرده این نیت اداش دیگه واجب نیست به گردنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.78,
   "end": 42.56,
   "text": "اما اگر به زبان جاری شد واجب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.56,
   "end": 50.22,
   "text": "حالا استفتاء شده از رهبر عزیزمون که اگر کسی شک داره که آیا به زبان جاری کرده یا نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.22,
   "end": 55.44,
   "text": "این نذرش رو به زبان در کنار نیت که داشته به زبان هم جاری کرده یا نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.44,
   "end": 59.14,
   "text": "شک داره. رهبر عزیزمون فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.14,
   "end": 62.76,
   "text": "اگر فرض این است یعنی اگه این فرض درست باشه که واقعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.76,
   "end": 66.14,
   "text": "شک کرده، یادش نمیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.14,
   "end": 67.92,
   "text": "فرمودن دیگه وظیفه ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.92,
   "end": 73.46,
   "text": "یعنی واجب نیست به گردنش که حتما اون نذر رو انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.46,
   "end": 75.82,
   "text": "در خصوص قلب ممتحن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.82,
   "end": 79.84,
   "text": "اشاره می‌کنیم به یکی دیگه از آیاتی که به زیبایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.84,
   "end": 85.8,
   "text": "قصه فلسفه این امتحانات الهی رو از ما بندگان خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.8,
   "end": 94.72,
   "text": "بیان کرده. آیه صد و هفتاد و نه سوره آل عمران که می‌فرماید \"و ما کان الله لیذر المؤمنین علی ما کنتم علیه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.72,
   "end": 98.7,
   "text": "یعنی این چنین نبود که خدا مؤمنان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.7,
   "end": 103.28,
   "text": "به ها-- همون گونه‌ای که شما هستید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.28,
   "end": 107.44,
   "text": "وا بگذاره، اینا رو رهاشون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.44,
   "end": 112.44,
   "text": "که چی بشه؟ \"حتی یميز الخبیث من الطیب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.44,
   "end": 116.74,
   "text": "تا وقتی که خبیث از طيب جدا نشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.74,
   "end": 120.32,
   "text": "امتحانات الهی همینطور پشت سر هم جاری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.32,
   "end": 125.0,
   "text": "پس بر اساس این آیه نشون داده میشه که اِ-- یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.0,
   "end": 129.1,
   "text": "دل-- علت‌ها و دلایل امتحانات الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.1,
   "end": 131.98,
   "text": "این هستش که خوب و بد از هم جدا بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.98,
   "end": 134.7,
   "text": "حالا این می‌تونه به یک وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.7,
   "end": 139.62,
   "text": "این باشه که آدم‌های خوب از آدم‌های بد جدا بشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.62,
   "end": 142.28,
   "text": "تمیز داده باشن. این یه مسئله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.28,
   "end": 146.1,
   "text": "یه مسئله این است که نه، در وجود هر شخصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.1,
   "end": 149.64,
   "text": "خوبی‌ها و بدی‌ها از هم منفک‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.64,
   "end": 153.66,
   "text": "تو وجود هر کسی بالاخره مجموعه‌ای از خیرات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.66,
   "end": 156.22,
   "text": "حسنات و سیئات جمع‌اند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.22,
   "end": 158.14,
   "text": "در وجود هر کسی سیئه ای هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.14,
   "end": 162.96,
   "text": "کسی که معصوم نیست که. سیئه ای هم هست کنار حسنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.96,
   "end": 165.54,
   "text": "این حسنات باید جدا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.54,
   "end": 167.62,
   "text": "به غیر از این اصلا نمیشه راه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.62,
   "end": 170.34,
   "text": "حالا چون اهل ایمان هستی، خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.34,
   "end": 173.1,
   "text": "امتحانات رو به گونه‌ای قرار میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.1,
   "end": 175.8,
   "text": "که ان شا الله اون سیئات مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.8,
   "end": 182.76,
   "text": "مثالی که شیخ طبرسی رحمة الله علیه زده در مجمع البیان که دیروز عرض کردیم مثل سوزاندن طلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.76,
   "end": 187.06,
   "text": "در بوته آتش. برای اینکه اون سیئات از بین بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.06,
   "end": 189.46,
   "text": "و حسناتت قوت بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.46,
   "end": 193.3,
   "text": "که البته این نشانه هم دارد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.3,
   "end": 197.02,
   "text": "یه حدیثی در عرض شود خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.02,
   "end": 199.64,
   "text": "بحارالانوار دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.64,
   "end": 207.0,
   "text": "که مرحوم مجلسی رحمة الله علیه آورده پیامبر عظیم الشأن اسلام جمله خیلی جالبی داره که البته قابل بحثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.0,
   "end": 209.96,
   "text": "یعنی این، این حدیث پیغمبر خیلی قابل بحثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.96,
   "end": 215.98,
   "text": "می‌فرماید اگر خ-- در جمع اصحابشون پیغمبر فرمودن اگر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.98,
   "end": 220.0,
   "text": "کسی رو دوست داشته باشه مبتلاش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.0,
   "end": 222.66,
   "text": "یعنی اگر کسی مبتلا نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.66,
   "end": 225.86,
   "text": "دچار بلا و امتحان و فتنه و این‌ها نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.86,
   "end": 232.6,
   "text": "معلومه خدا ولش کرده. اونجا هم تو اون آیه هم می‌فرماید شما فکر نکنید مثل شما ول می‌کنم اهل ایمانو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.6,
   "end": 235.34,
   "text": "پیداست خدا هرکیو دوست نداره ولش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.34,
   "end": 238.28,
   "text": "به، به قاعده ایذلال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.28,
   "end": 240.18,
   "text": "ایذلال الهی یعنی رها شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 240.18,
   "end": 243.9,
   "text": "رهاش می‌کنه، کاری باهاش نداره. هر کاری بخواد بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.9,
   "end": 246.06,
   "text": "همشو حساب کتابشو میذاره اون دنیا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.06,
   "end": 248.42,
   "text": "سخت بشه. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.42,
   "end": 252.92,
   "text": "پیغمبر ادامه میده حالا اگر کسی رو خیلی دوست داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.92,
   "end": 256.82,
   "text": "ببینید اگر کسی رو دوست داشت پیغمبر فرمود اونو چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.82,
   "end": 260.5,
   "text": "مبتلا می‌کنه. اگر خیلی کسی رو دوست داشت چه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.5,
   "end": 263.08,
   "text": "جالبه این سنت‌ها و قواعد الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.08,
   "end": 265.04,
   "text": "کاملا برعکس امثال ماهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.04,
   "end": 269.18,
   "text": "اصلا کاملا برعکس قواعد نشئه طبیعت ما انسان‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.18,
   "end": 274.5,
   "text": "می‌فرماید کسی که خیلی دوسش داره برای خودش انتخابش می‌کنه، مال خودش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.5,
   "end": 277.98,
   "text": "بعد اینجا صحابه زرنگ گفتن خب یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.98,
   "end": 282.04,
   "text": "چطور؟ این نشونه‌ش چیه که چجوری خدا یکی رو برای خودش انتخاب می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.04,
   "end": 289.5,
   "text": "خیلی عجیبه. خ-- پیغمبر فرمود مال و فرزندانش رو میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.5,
   "end": 291.98,
   "text": "مال و فر-- حالا الان ما یه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.98,
   "end": 295.02,
   "text": "عزیزشو از دست بده یا او فقیر بشه چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.02,
   "end": 298.02,
   "text": "ما به چشم حقارت و استغفرالله زلت نگاش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 298.02,
   "end": 302.14,
   "text": "میگیم خدا زدش. در صورتی که پیغمبر داره جور دیگه‌ای می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.14,
   "end": 307.32,
   "text": "میگه اگر کسی رو خیلی خدا خواسته شا، برای خودش انتخابش کرده شا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.32,
   "end": 309.52,
   "text": "اینطوری چشمش می‌زنه، می‌دونید کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 309.52,
   "end": 314.14,
   "text": "میگن چشم زرت-- مرحوم دولابی می‌فرمود حواستون جمع باشه خدا هم چشم می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.14,
   "end": 316.42,
   "text": "خدا هم عاشق یه بنده ای باشه چشم می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 316.42,
   "end": 318.2,
   "text": "چشم، چشمش-- یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 318.2,
   "end": 321.52,
   "text": "یعنی مثل همین. یعنی بنده بچه‌هاشو می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 321.52,
   "end": 324.12,
   "text": "مالشم می‌گیره. حالا اینجا جای بحث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 324.12,
   "end": 326.4,
   "text": "من امروز داشتم به این فکر می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 326.4,
   "end": 328.4,
   "text": "حالا شما برید دنبالش من فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 328.4,
   "end": 330.74,
   "text": "یه چند تا سرفصل عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 330.74,
   "end": 338.08,
   "text": "مثلا آیا از نظر شما نیستن آدم‌هایی که خیلی پیش خدا عزیزن، واقعا مشخصه که خیلی عزیزن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.08,
   "end": 340.52,
   "text": "اما مال دارن، فرزندم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.52,
   "end": 342.78,
   "text": "می‌گیم چگونه با این حدیث جمع میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 342.78,
   "end": 345.58,
   "text": "ما هم زیاد می‌بینیم، دور و برمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 345.58,
   "end": 348.72,
   "text": "مشخصه خدا طرف رو خیلی دوست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 348.72,
   "end": 354.36,
   "text": "هم مال داره هم فرزند داره. پس پیداست که قضایای دیگری هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 354.36,
   "end": 357.24,
   "text": "می‌تونه این هم باشه در کنارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 357.24,
   "end": 360.02,
   "text": "نه اینو حذف کنیم، منها کنیم، نفی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 360.02,
   "end": 362.12,
   "text": "در کنارش این هم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 362.12,
   "end": 366.64,
   "text": "شاید منظور این است که خدا اگر کسی رو خیلی دوسش داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 366.64,
   "end": 371.06,
   "text": "محبت یا علقه مال و فرزندو از دلش میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 371.06,
   "end": 373.5,
   "text": "این رو من خودم دارم بهش فکر می‌کنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 373.5,
   "end": 377.76,
   "text": "جایی رو ندیدم. شما می‌تونید رد کنید بگید حاج آقا استنباطت اشتباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.76,
   "end": 380.08,
   "text": "چون می‌بینیم موارد نقضشو پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 380.08,
   "end": 382.18,
   "text": "پس این احتمال وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 382.18,
   "end": 385.88,
   "text": "که اگر خدا خیلی کسی رو دوست داشت این باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 385.88,
   "end": 387.96,
   "text": "نه که اونم نباشه ها. چرا، اونم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 387.96,
   "end": 392.48,
   "text": "ببینید از خود پیغمبر اولین کسی بود که عزیزش حضرت ابراهیمو گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 392.48,
   "end": 398.18,
   "text": "حضرت زهرا بچه‌هاشو. اصلاً چند تا بچه خدا به پیغمبر داد همشو گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 398.18,
   "end": 402.78,
   "text": "معمولاً به بزرگان اینطوری هست کسی که خدا خیلی حضرت امام-- ببین مصطفی‌اش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 402.78,
   "end": 405.82,
   "text": "شهید مصطفی خمینی حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 405.82,
   "end": 408.62,
   "text": "که می‌فرمود این ذخیره اسلام بوده رو گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 408.62,
   "end": 411.72,
   "text": "این‌ها هست. میگیم پس این هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 411.72,
   "end": 414.56,
   "text": "اما چون مورد نقض هم هست شاید این باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 414.56,
   "end": 420.48,
   "text": "که خدا محبت و علقه مال و فرزندو از دلش میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 420.48,
   "end": 423.26,
   "text": "نکته سومو حالا می‌تونید براش نک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 423.26,
   "end": 427.58,
   "text": "وجوه متعددی شما با نسبت به صعه وجودیتون پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 427.58,
   "end": 431.14,
   "text": "نکته آخر هم بگم ما نسبت به ظرف زمانیمون حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 431.14,
   "end": 439.64,
   "text": "و الا تا شب باید بشینیم. نکته آخر اینکه می‌تونه اصلاً این باشه موضوع گرفتن مال و فرزند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 439.64,
   "end": 443.68,
   "text": "این باشه یعنی اون رو برای خودم می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 443.68,
   "end": 445.88,
   "text": "یعنی اینکه تو مال داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 445.88,
   "end": 449.08,
   "text": "خرج من می‌کنه. بچه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 449.08,
   "end": 452.32,
   "text": "تو راه من صرف می‌شه. مثلا حضرت یوسف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 452.32,
   "end": 454.18,
   "text": "خب بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 454.18,
   "end": 457.12,
   "text": "حدود نزدیک چهل سال بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 457.12,
   "end": 463.98,
   "text": "اینطور نبود که مثلاً خدا جان حضرت یوسف رو بگیره از حضرت یعقوب بگیره اما صرف خودش کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 463.98,
   "end": 466.6,
   "text": "یا بچه‌هایی که میرن جبهه و جنگ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 466.6,
   "end": 470.66,
   "text": "تو کارهای جهادی و انقلابی مثل پدر مادر نمی‌بیننش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 470.66,
   "end": 473.54,
   "text": "درسته؟ می-- یک معنا می‌تونه این باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 473.54,
   "end": 475.98,
   "text": "خدا اونو میگیره برای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 475.98,
   "end": 477.96,
   "text": "یعنی مال منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 477.96,
   "end": 480.86,
   "text": "تو حوزه من کار می‌کنه. حالا دیگه شاید کمتر تو ببینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 480.86,
   "end": 483.52,
   "text": "اصلاً همه کاراشو مصرف خودم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 483.52,
   "end": 486.52,
   "text": "مالشو یه کاری می‌کنم تو راه من خرج بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 486.52,
   "end": 489.82,
   "text": "تو راه امام حسین خرج بکنه. هر مالی لیاقت نداره خرج بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 489.82,
   "end": 492.36,
   "text": "قربونت برم. اینم یه معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 492.36,
   "end": 496.76,
   "text": "اجازه بدید یه معنای دیگه هم بگم. حالا می‌تونم عرض کردم معناهای زیادی می‌تونیم بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 496.76,
   "end": 500.58,
   "text": "یه معنای دیگه‌ش هم می‌تونه این باشه که خدا می‌گیره مالو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 500.58,
   "end": 503.14,
   "text": "میگه که شاید این باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 503.14,
   "end": 506.2,
   "text": "که بگه آقا این بچه تو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 506.2,
   "end": 509.32,
   "text": "من صرف اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 509.32,
   "end": 515.84,
   "text": "برداشتم برای خودم نیت کردم این بچه مال من باشه، این مال تو مال من باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 515.84,
   "end": 518.52,
   "text": "یعنی اینکه اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 518.52,
   "end": 520.6,
   "text": "از-- یعنی برمی‌گردونیم به ازل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 520.6,
   "end": 525.58,
   "text": "ببین یه وقت هست شما میگی صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 525.58,
   "end": 528.44,
   "text": "یعنی خدا صلوات فرستاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 528.44,
   "end": 530.66,
   "text": "خب؟ صلوات خدا بر او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 530.66,
   "end": 533.16,
   "text": "از اول بوده برمی‌گرده به عالم زر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 533.16,
   "end": 535.12,
   "text": "یه وقت هست میگی اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 535.12,
   "end": 537.4,
   "text": "صل علیه. الان، الان صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 537.4,
   "end": 543.34,
   "text": "اینا با هم فرق می‌کنند. یه معناش می‌تونه این باشه در اون عوالم پیشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 543.34,
   "end": 546.48,
   "text": "خدای منان از اون زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 546.48,
   "end": 549.24,
   "text": "اختیار کرده فرزندی رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 549.24,
   "end": 551.62,
   "text": "ذریه طیبه‌ای و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 551.62,
   "end": 553.82,
   "text": "مال طیبی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 553.82,
   "end": 556.66,
   "text": "که او رو، اون رو دقت کنید چی دارم عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 556.66,
   "end": 558.6,
   "text": "برش گردوندم به زمان‌های قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 558.6,
   "end": 561.42,
   "text": "اون رو به تو می‌بخشه الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 561.42,
   "end": 565.44,
   "text": "یعنی چیزی که از قبل برای خودش خدا اختیار کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 565.44,
   "end": 568.9,
   "text": "توجه کردی چی شد؟ مال خودش بوده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 568.9,
   "end": 572.52,
   "text": "میگه ازش میگیره. تو حدیث میگه بچه و مالشو میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 572.52,
   "end": 575.7,
   "text": "از قبل مال خودش برداشته خدا حالا به تو می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 575.7,
   "end": 581.96,
   "text": "اینم یک معناس. چون تو حدیث امام رضا صلوات الله عليه که چند روز پیش شد توضیح دادیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 581.96,
   "end": 591.64,
   "text": "خدا می‌فرماید در-- امام رضا می‌فرماید به ريان بن شبيب که اگر به گونه‌ای گریه کنی \"إن بكيت على الحسين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 591.64,
   "end": 597.86,
   "text": "به گونه‌ای گریه کنی که حتی تا جایی که \"تسيّر دموعک على خدّک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 597.86,
   "end": 601.36,
   "text": "خب این اشک جاری شد رو صورتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 601.36,
   "end": 604.98,
   "text": "دقت کنید عبارتو. نمیگه \"يغفر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 604.98,
   "end": 607.22,
   "text": "كل ذنب أذنبته\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 607.22,
   "end": 610.0,
   "text": "می‌فرماید \"غفر الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 610.0,
   "end": 612.98,
   "text": "فعل ماضی استفاده می‌کنم. میگه god-god",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 612.98,
   "end": 615.48,
   "text": "خدا گذشته قبلاً بخشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 615.48,
   "end": 619.2,
   "text": "\"غفر الله لك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 619.2,
   "end": 621.3,
   "text": "كل ذنب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 621.3,
   "end": 623.1,
   "text": "أذنبت\". هرچی که گناه کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 623.1,
   "end": 627.5,
   "text": "تازه بعد میگه \"صغيرا أو كبيرا كان أو كبيرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 627.5,
   "end": 632.4,
   "text": "آ\" عرض شود \"قليلا أو كثيرا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 632.4,
   "end": 634.92,
   "text": "کوچک باشه یا زیاد. این برمی‌گرده به قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 634.92,
   "end": 637.98,
   "text": "حالا این قبل کیه؟ کی خدا بخشیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 637.98,
   "end": 640.94,
   "text": "قبلاً اراده بخشش تو رو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 640.94,
   "end": 643.18,
   "text": "الان اذن گریه برای امام حسین بهت داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 643.18,
   "end": 649.28,
   "text": "توجه کردی چی شد؟ قبلاً خدا فرزند تو و مال طیب تو برای خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 649.28,
   "end": 652.26,
   "text": "از قبل برای خودش اختیار کرده، الان به تو بخشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 652.26,
   "end": 656.04,
   "text": "اینم یک معناش. حالا تا شب بشینیم معنا ازش در میاد‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 656.04,
   "end": 657.84,
   "text": "ان شا الله عاقبت مخصد به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 657.84,
   "end": 660.62,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 660.62,
   "end": 666.98,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}