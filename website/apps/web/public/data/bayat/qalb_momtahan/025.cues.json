 },
 "chapters": [
  {
   "index": 0,
   "title": "## حکم نذر هنگام سلب قدرت",
   "start": 14.08,
   "end": 73.64
  },
  {
   "index": 1,
   "title": "## خاطرهٔ جعفر جهروتی؛ مرد چفیه‌به‌صورت",
   "start": 73.64,
   "end": 205.24
  },
  {
   "index": 2,
   "title": "## یادگیری نماز و نالهٔ شبانه",
   "start": 205.24,
   "end": 265.72
  },
  {
   "index": 3,
   "title": "## میدان مین و تمثل امام حسین",
   "start": 265.72,
   "end": 286.04
  },
  {
   "index": 4,
   "title": "## حکمت امتحان و قدر موقعیت",
   "start": 286.04,
   "end": 306.06
  },
  {
   "index": 5,
   "title": "## صلح دائم خدا با بنده؛ سخن دولابی",
   "start": 306.06,
   "end": 617.25
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.52,
   "end": 3.72,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.72,
   "end": 11.44,
   "text": "السلام علیک یا داعی الله و ربانی ایاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.44,
   "end": 14.08,
   "text": "بحث احکام ما پیرامون احکام نذر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.08,
   "end": 23.7,
   "text": "اگر کسی نذر کنه و بعدا به هر دلیلی استطاعت انجام این نذر رو نداشته باشه، چه از جهت مالی، چه توان جسمیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.7,
   "end": 28.58,
   "text": "هرچی. یه نذری رو کرده بر لسانش هم صیغه رو جاری کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.58,
   "end": 33.72,
   "text": "واجب شده نذر براش. ولی بعدا توان مالی انجام این نذر رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.72,
   "end": 36.96,
   "text": "توان جسمیشو نداره، امکاناتشو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.96,
   "end": 41.92,
   "text": "اصلا یکی از شرایط تکلیف توانه دیگه باید طرف قدرتشو داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.92,
   "end": 46.14,
   "text": "همین که قدرتش از، ازش سلب شد، این تکلیف هم ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.14,
   "end": 50.18,
   "text": "برداشته میشه. یعنی دیگه وجود نیست اینجا واجب نیست که انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.18,
   "end": 52.62,
   "text": "حالا اگر بعدا یا ای--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.62,
   "end": 55.12,
   "text": "مثلا مدتی گذشت دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.12,
   "end": 57.82,
   "text": "ایشون توان انجام اون نذر رو پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.82,
   "end": 59.76,
   "text": "دو مرتبه بهش واجب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.76,
   "end": 68.66,
   "text": "ولی اون موقع‌هایی که توان انجام نذری که قبلا کرده و براش واجب شده رو نداره، براش انجامش واجب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.66,
   "end": 72.98,
   "text": "خب این عزیزان دلمون که تشریف آوردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.98,
   "end": 79.4,
   "text": "این چهره‌های باصفا و لباس‌هایی که به تنشونه آدمو میبره توی فضاهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.4,
   "end": 81.74,
   "text": "ما هم بالاخره یاد خاطره‌ها می‌افتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.74,
   "end": 89.36,
   "text": "خدا حفظ کنه حضرت آقای سردار جعفر جهروتی رو از هم رزم‌های شهید همتن ایشون میدونین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.36,
   "end": 92.68,
   "text": "از جانبازهای جنگن که دیگه ایشون هم رو به شهادتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.68,
   "end": 95.44,
   "text": "خدا انشاالله بهشون طول عمر و برکت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.44,
   "end": 101.72,
   "text": "خیلی سال‌های پیش که بنده به جهت عارضه‌ای شیعیی بستری بودم ایشون اومده بود عیادت ما تا شاید حدود یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.72,
   "end": 103.24,
   "text": "یک دو نصفه شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.24,
   "end": 107.52,
   "text": "پیش ما بود. انقدر خاطره‌های عجیب و غریب از زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.52,
   "end": 114.02,
   "text": "جنگ گفت که دیگه من ازش خواهش کردم قسمش دادم دیگه ادامه نده من دیگه کشش ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.02,
   "end": 115.86,
   "text": "یعنی چیزای عجیبی ایشون گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.86,
   "end": 119.6,
   "text": "حالا یه دونه از اون‌ها رو من خدمت شما تبرکاً تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.6,
   "end": 124.92,
   "text": "خیلی سریع، حالا جزئیاتش یادم رفته چون برمی‌گرده به حدود شاید بیست سال پیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.92,
   "end": 128.98,
   "text": "ایشون فرمودن که \"من تو اتاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.98,
   "end": 131.3,
   "text": "لشکر بودم. یه آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.3,
   "end": 133.1,
   "text": "قدبلندی اومد در زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.1,
   "end": 135.52,
   "text": "چفیه‌ش رو بش-- بسته بود به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.52,
   "end": 138.5,
   "text": "صورتش. قد بلند، لاغر اندام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.5,
   "end": 142.02,
   "text": "در زد، درو وا کردم گفت آقای جعفر جهروتی شمایید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.02,
   "end": 144.34,
   "text": "گفتم بله. گفت من با شما کار دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.34,
   "end": 146.56,
   "text": "نشست و زد زیر گریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.56,
   "end": 148.28,
   "text": "شروع کرد درد دل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.28,
   "end": 154.4,
   "text": "آقا اونچه که تو گناه اسم-- از گناه شنیدی\" ایشون شروع کرد اقرار کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.4,
   "end": 159.98,
   "text": "انگار ما اسقف مسیحیت هستیم و این آقا اومده اقرار کنه ما بگیم بخشیدیمت خدا ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.98,
   "end": 165.18,
   "text": "هی گفت و گفت من دیگه خجالت کشیدم ادامه-- گفتم ادامه نده جلوش رو گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.18,
   "end": 167.46,
   "text": "گفتم آقا به من چه که شما این گناه‌ها رو کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.46,
   "end": 170.58,
   "text": "بسه دیگه ادامه نده. حالا حرفت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.58,
   "end": 173.74,
   "text": "دنبال چی-- گفت \"من میخوام ببینم خدا منو میبخشه یا نه؟\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.74,
   "end": 178.64,
   "text": "ما هم اونچه که بلد بودیم در چند تو رو کردیم که آره خدا ارحم الراحمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.64,
   "end": 183.68,
   "text": "خدا خودش در قرآن فرموده إن الله يغفر الذنوب جميعا قید هم نذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.68,
   "end": 188.1,
   "text": "همه گناهان رو میبخشه به شرط توبه واقعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.1,
   "end": 193.22,
   "text": "این گریه کرد و گریه کرد و اینها و خیالش راحت شد و اصلا نماز بلد نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.22,
   "end": 199.38,
   "text": "جالبه که میگفت حکم چیرش هم ظاهرا بعدا فرموده بودند که حکم چیرش هم کمیته اون زمان صاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.38,
   "end": 202.14,
   "text": "داده بوده و حتی به سمتشم تیراندازی کرده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.14,
   "end": 205.74,
   "text": "توی خرابه ای پناه گرفته فرار میکنه، فرار میکنه میاد جبهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.74,
   "end": 211.82,
   "text": "شما حساب کنید. یه آدم اینچنین فراری اومده جبهه منقلب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.82,
   "end": 213.82,
   "text": "این حالات بچه ها رو که دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.82,
   "end": 218.86,
   "text": "میگه ما میدیدیم این وقتی که اصلا نماز بلد نبود بغل رزمنده ها میش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.86,
   "end": 222.04,
   "text": "وای-- می ایستاد زیر چشمی نگاه میکرد اینا چیکار میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.04,
   "end": 224.7,
   "text": "همونطوری سجده رو به رو انجام میداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.7,
   "end": 227.08,
   "text": "گاهی اوقات مثلا بلد نبود تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.08,
   "end": 228.8,
   "text": "سجده چی بگه یا دعا چی بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.8,
   "end": 230.46,
   "text": "ما بهش میگفتیم اینو بگو، اونو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 230.46,
   "end": 234.02,
   "text": "میگفتش که شب‌ها دیگه خوابو از چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.02,
   "end": 238.24,
   "text": "بچه هایی که میرفتن تو حسینیه حاج احمد میخوابیدن، پادگان دو کوه گرفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.24,
   "end": 242.14,
   "text": "شب‌ها تا صبح صدای زجه و ناله این آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.14,
   "end": 244.7,
   "text": "تو سجده شنیده میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.7,
   "end": 247.46,
   "text": "همیشه هم یه چفیه به صورتش کسی نشناختش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.46,
   "end": 252.52,
   "text": "انگار که چهره شناخته شده مثلا از اراذل استغفرالله اینها بوده، هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.52,
   "end": 256.12,
   "text": "یهو خلاصه این برای ما تعجب‌آور بود حالات ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.12,
   "end": 259.44,
   "text": "گاهی اوقات می شنیدیم، میدیدیم دعاها رو هم داره غلط غلوط میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.44,
   "end": 261.0,
   "text": "اذکارش هم اشتباه داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.0,
   "end": 265.4,
   "text": "اما یک حال خوشی به پهنای صورت دائما گریه زاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.4,
   "end": 268.34,
   "text": "گفت یه شب داشتیم میرفتیم تو این بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 268.34,
   "end": 270.52,
   "text": "محوطه پادگان این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.52,
   "end": 272.58,
   "text": "ساختمون‌ها این خاکریز و اینا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 272.58,
   "end": 275.02,
   "text": "داشتیم میرفتیم نور این چراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 275.02,
   "end": 280.6,
   "text": "لنکروزی که ما نشسته بودیم توش خورد یه دفعه دیدم به یکی-- یکی انگار یکیو پشت خاکریز دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 280.6,
   "end": 284.9,
   "text": "وایسادیم رفتیم تو تاریکی دیدیم همین آقاهه چفیه به دوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.9,
   "end": 287.58,
   "text": "همین چف-چفیه به صورته هنوز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 287.58,
   "end": 290.18,
   "text": "شروع کرده همینطوری داره زار میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.18,
   "end": 294.46,
   "text": "نشسته رو خاک، هی بلند میشه قیام میکنه، قبود میکنه، سجده میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 294.46,
   "end": 296.08,
   "text": "خودشم نمیفهمه چیکار داره میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 296.08,
   "end": 298.02,
   "text": "اما داره زار زار گریه میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.02,
   "end": 300.86,
   "text": "خلاصه حالات عجیب، خیلی عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 300.86,
   "end": 303.2,
   "text": "میگفت تا اینکه حالا هی گفت، گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 303.2,
   "end": 304.92,
   "text": "جریانات زیادی رو از ایشون گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 304.92,
   "end": 308.18,
   "text": "من چند تا چون فرصت نیست به شما تبرکاً گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 308.18,
   "end": 311.3,
   "text": "حالات ایشون برامون خیلی عجیب جلوه کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 311.3,
   "end": 312.88,
   "text": "همه رو متوجه خودش کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 312.88,
   "end": 320.28,
   "text": "تا اینکه یه شب زدیم به عملیات و ایشون هم دیگه جذب شده بود و اجازه گرفته و اومد قاطی رزمنده‌ها و خلاصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 320.28,
   "end": 323.28,
   "text": "اومد رفتیم حالا گفت به من که چه عملیاتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 323.28,
   "end": 326.32,
   "text": "من از ذهنم رفته. رفتیم یه عملیاتی بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 326.32,
   "end": 330.7,
   "text": "ایشون هم با ما بود اتفاقا. برخوردیم به میدان مین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 330.7,
   "end": 334.5,
   "text": "تا ما اومدیم داد بزنیم کیه که بره رو این مین‌ها بخوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 334.5,
   "end": 337.72,
   "text": "به هر حال میخوایم بریم از رو مین‌ها رد شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 337.72,
   "end": 339.7,
   "text": "تا یه دفعه دیدیم دو نفر خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 339.7,
   "end": 343.76,
   "text": "هنوز ما حرف-- برنگشته حرف نزده تا داد زدیم دیدیم دو نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 343.76,
   "end": 348.56,
   "text": "شروع کردن غلت زدن. یکیشون همین آقایی بود که قدبلند چفیه به صورت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 348.56,
   "end": 352.12,
   "text": "میگیم و همون حالت شروع کرد غلت زدن روی این مین‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 352.12,
   "end": 355.44,
   "text": "این میرفت، اینا میرفتن همینجوری غلت می‌زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 355.44,
   "end": 360.44,
   "text": "قسم می‌خورد میگفت \"من دیدم این صحنه رو\" که بگی یه دونه مین منفجر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 360.44,
   "end": 364.14,
   "text": "اینا رفتن اونور ما هم اصلا دیگه حواسمون رفت به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 364.14,
   "end": 366.53,
   "text": "رفت که آقا اینجا میدون مینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 366.53,
   "end": 373.27,
   "text": "همین که دیدین این داره غلت میزنه و مین، مین‌ها مت-- منفجر نمیشه ما هم پشت سرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 373.27,
   "end": 376.15,
   "text": "دویدیم رفتیم. بعد رفت اون یه حالا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 376.15,
   "end": 378.75,
   "text": "چن-چند متر اونورتره یادم نیست چقدر گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 378.75,
   "end": 384.39,
   "text": "اونورتر یهو متوقف شد و چفیه‌شو برداشت شروع کرد بلند، بلند گریه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 384.39,
   "end": 388.15,
   "text": "هیچ اتفاقی هم نیفتاد. اتفاقا بعدا تو عملیات بعدی همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 388.15,
   "end": 391.65,
   "text": "چفیه به صورته شهید هم میشه جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 391.65,
   "end": 393.85,
   "text": "تو این عملیات این اتفاق براش بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 393.85,
   "end": 396.57,
   "text": "میگه همه دورشو گرفتیم داد میزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 396.57,
   "end": 399.87,
   "text": "آرومش کردیم گفتیم چته بابا عملیات ساکت باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 399.87,
   "end": 404.11,
   "text": "چی شده؟ گفت قسم خورد گفتش که امام حسین رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 404.11,
   "end": 408.37,
   "text": "امام حسین رو دیدم. بعد گفت-- بهش گفتیم چجوری دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 408.37,
   "end": 415.13,
   "text": "گفتش که همین که من خوابیدم رو میدون مین داشتم غلت میزدم دیدم نوری بالا سر من داره همینطوری حرکت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 415.13,
   "end": 419.63,
   "text": "این نور با من بود تا جایی که من دیگه متوقف شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 419.63,
   "end": 423.31,
   "text": "متمثل شد جلوم. یه آقایی بسیار نورانی و زیبارو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 423.31,
   "end": 427.43,
   "text": "گفتم شما کی هستی؟ گفت من حسین ابن علی‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 427.43,
   "end": 429.17,
   "text": "دو تا جمله به من فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 429.17,
   "end": 431.93,
   "text": "همینطور که گریه میکرد به من تو دل شب گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 431.93,
   "end": 436.19,
   "text": "آقای جهرمی میگفت. اول گفت خسته نباشی امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 436.19,
   "end": 439.81,
   "text": "دوم فرمود من حسین رو رو سفید کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 439.81,
   "end": 443.35,
   "text": "با این کارت و همین تو عملیات بعدی شهید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 443.35,
   "end": 448.05,
   "text": "میخوام اینو بگم استفاده کنم از این خاطره بسیار زیبا و عجیب که اتفاقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 448.05,
   "end": 451.23,
   "text": "زیادی تو جبهه این چنین افتاده و ما بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 451.23,
   "end": 455.89,
   "text": "اونم همین که گاهی اوقات تو زندگی ما یه اتفاقاتی رخ میده، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 455.89,
   "end": 461.35,
   "text": "عرض شود روح ریحانی، یه موقعیتی ایجاد میشه که خدا میخواد ما رو بخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 461.35,
   "end": 463.85,
   "text": "مهم اینه که مثل این بابا قدر بدونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 463.85,
   "end": 467.53,
   "text": "ببینید حکم تیرش اومده خودش اقرار میکنه بدترین گناه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 467.53,
   "end": 472.61,
   "text": "اما از اون موقعیتی که درش قرار میگیره به نحو احسن استفاده میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 472.61,
   "end": 475.59,
   "text": "خدا این معجزه رو در ما قرار داده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 475.59,
   "end": 483.61,
   "text": "اصلا حکمت چون بحث ما قلب ممتحن بود، حکمت امتحانات الهی اینه که بالاخره نمرت بیست بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 483.61,
   "end": 488.77,
   "text": "خدا میخواد به هر-- ببخشیدا زوری هم که شده به هر بهانه‌ای منو تو رو بهشتی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 488.77,
   "end": 493.25,
   "text": "ولی مهم اینه که آدم قدر این موقعیت‌ها رو بدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 493.25,
   "end": 499.99,
   "text": "اون لحظات، اون پادگان، اون شب‌ها، اون تاریکی‌ها، اون تنبل خاطر چقدر قشنگ استفاده کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 499.99,
   "end": 506.03,
   "text": "بعد الان قاطی شهدا ان دربتهم یرزقون ما گیریم تو این دنیا لامصب فک کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 506.03,
   "end": 509.53,
   "text": "وانفسا. چرا اینو من یادم افتاد و گفتم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 509.53,
   "end": 511.89,
   "text": "این احوالات عزیزان امنیتی رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.89,
   "end": 514.89,
   "text": "بچه‌های خوب بسیجی که این شب‌ها اینجا می‌خوابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 514.89,
   "end": 519.59,
   "text": "همین خوابیدنت اینجا، همین موقعیتی که برای شما ایجاد شده الان یه فرصته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 519.59,
   "end": 522.67,
   "text": "یه امتحانه. خدا داره از شما الان امتحان میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 522.67,
   "end": 529.43,
   "text": "تو این حالات چگونه‌اید؟ یک اردویی‌ست که بتونید از این اردوی آمادگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 529.43,
   "end": 532.13,
   "text": "به هر حال بندگی خدا از هر جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 532.13,
   "end": 534.33,
   "text": "بتونید بهترین استفاده رو کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 534.33,
   "end": 537.85,
   "text": "راه براتون باز شده. حالا این رو من به یک مثالی زدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 537.85,
   "end": 541.83,
   "text": "یه مصداقی بر اینکه در گوشه گوشه عمر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 541.83,
   "end": 543.67,
   "text": "که داره رو به اتمام میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 543.67,
   "end": 546.69,
   "text": "یه موقعیت‌های این چنینی ایجاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 546.69,
   "end": 550.15,
   "text": "هنر، هنرمند اون کسی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 550.15,
   "end": 555.15,
   "text": "که از این موقعیت‌ها به نحو احسن استفاده کنه و برسونه خودشو به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 555.15,
   "end": 558.59,
   "text": "سرمنزل مقصود و راه مسدود نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 558.59,
   "end": 563.69,
   "text": "اینو به شما عرض کنم. راه به سوی عهدی مسدود نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 563.69,
   "end": 566.65,
   "text": "ختم کلامم با یکی از جمله‌ی عرفا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 566.65,
   "end": 570.01,
   "text": "مرحوم آقای دولابی جمله‌ی عجیب و طلایی‌ای دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 570.01,
   "end": 575.07,
   "text": "میفرماید خدا دائما با بندگانش در صلح و آشتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 575.07,
   "end": 576.83,
   "text": "اصلا خدا قهر تو کارش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 576.83,
   "end": 580.35,
   "text": "ما هستیم که قهر می‌کنیم. ما هستیم که شل و سفت می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 580.35,
   "end": 582.85,
   "text": "عقب گرد می‌کنیم، بعد و قبل پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 582.85,
   "end": 586.19,
   "text": "و الا خدا دائما در صلح و آشتی با بنده‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 586.19,
   "end": 588.41,
   "text": "تو اراده کن به سمت او بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 588.41,
   "end": 591.59,
   "text": "خودش فرمود \"من جاء بالحسنة فله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 591.59,
   "end": 597.03,
   "text": "عشر أمثالها\" یه معنای اینو از عالم جوادی آملی قبلا عرض کردم این گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 597.03,
   "end": 599.77,
   "text": "که یک قدم به سمت خدا بری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 599.77,
   "end": 603.93,
   "text": "خدا ده برابر هرووله کنان به سمت تو میدود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 603.93,
   "end": 606.29,
   "text": "این خیلی مژده بزرگیه برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 606.29,
   "end": 608.67,
   "text": "انشالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 608.67,
   "end": 611.79,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 611.79,
   "end": 617.25,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}