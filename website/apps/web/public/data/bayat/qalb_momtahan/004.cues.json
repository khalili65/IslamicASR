 "chapters": [
  {
   "index": 0,
   "title": "## سفر تحصیلی؛ احتیاط واجب میان شکسته و کامل",
   "start": 13.28,
   "end": 261.32
  },
  {
   "index": 1,
   "title": "## امانت محفوظه و باب مبتلی‌به الناس",
   "start": 261.32,
   "end": 302.74
  },
  {
   "index": 2,
   "title": "## امتحان با امام؛ سخت‌ترین میدان",
   "start": 302.74,
   "end": 487.86
  },
  {
   "index": 3,
   "title": "## سه رکن ایمان در بیان شاه‌آبادی",
   "start": 487.86,
   "end": 577.28
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.28,
   "end": 5.1,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.1,
   "end": 8.84,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.84,
   "end": 13.28,
   "text": "آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.28,
   "end": 16.72,
   "text": "دیروز یه حکمی رو از روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.72,
   "end": 19.46,
   "text": "استفتاحات حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.46,
   "end": 24.0,
   "text": "رهبر عزیزمون عرض کردم خدمتتون پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.0,
   "end": 27.52,
   "text": "موضوع سفر شغلی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.52,
   "end": 32.02,
   "text": "وصلش کردیم به دانشجویان و محصلین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.02,
   "end": 35.38,
   "text": "دو قسمت بود؛ گفتیم اون‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.38,
   "end": 38.36,
   "text": "سفرشون از جهت تحصیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.36,
   "end": 41.44,
   "text": "بورسیه و مأموریت اداره است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.44,
   "end": 45.02,
   "text": "این‌ها هم سفر شغلی حساب می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.02,
   "end": 50.54,
   "text": "و نمازشونو باید از سفر دوم به بعد کامل بخونن و روزه بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.54,
   "end": 53.58,
   "text": "بعد یه حکمی رو اینجا از اِاِاِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.58,
   "end": 59.86,
   "text": "استفتاء جواب استفتاهایی که اینجا هست اتفاقاً تنها روزیم که من از رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.86,
   "end": 62.58,
   "text": "خوندم براتون حکم‌ها اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.58,
   "end": 66.5,
   "text": "دیروز بود. عرض کردیم بعد امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.5,
   "end": 73.68,
   "text": "من با ر- دفتر آقا گفتگو کردم از قضا یه دفعه یکی از صحبت‌هایی که بهش برخوردیم همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.68,
   "end": 76.94,
   "text": "موضوع دیروز بود. دیدم ایشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.94,
   "end": 80.28,
   "text": "اون عزیزی کارشناسی که اونجا جواب می‌داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.28,
   "end": 82.72,
   "text": "یه چیز جدیدی گفتن. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.72,
   "end": 86.22,
   "text": "اگر احتمالا اینو دقت کنید شما از روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.22,
   "end": 92.38,
   "text": "رساله، اجوبه، استفتاحات اینا هرچی رو دیدید بعدا د- زنگ زدید دفتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.38,
   "end": 94.82,
   "text": "یه چیز جدیدی دفتر یه چیز دیگه به شما گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.82,
   "end": 98.08,
   "text": "اونی که دفتر آقا میگه رو عمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.08,
   "end": 103.58,
   "text": "به دو جهت؛ یا اینکه بعضا من دیدم بعضی از این چاپ‌ها درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.58,
   "end": 108.08,
   "text": "مشکل چاپی وجود داره، نیست و است نوشته و اصلا حکم رو عوض کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.08,
   "end": 110.3,
   "text": "این یه نکته، من دیدم چند تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.3,
   "end": 115.82,
   "text": "نکته دوم اینکه بعضی از فتوای آقا می‌بینی عوض می‌شه، به‌روز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.82,
   "end": 118.62,
   "text": "مثل مسؤلیت شهری که قبلاً عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.62,
   "end": 123.74,
   "text": "حالا اون چیزی که ما مغایرشو شنیدیم دیروز ما عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.74,
   "end": 132.26,
   "text": "خدمت شما خوبان که اگر چنانچه کسی محصل و دانشجو بود صرفاً برای تحصیل می‌رفت و بورسیه و مأموریت نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.26,
   "end": 136.82,
   "text": "این مسافر حساب می‌شه و سفرش سفر شغلی نیست که نمازشو کامل بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.82,
   "end": 139.34,
   "text": "این درسته؟ اصلاً ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.34,
   "end": 143.22,
   "text": "استفتاء ششصد و پنجاه و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.22,
   "end": 151.64,
   "text": "اجوبت الاستفتائات رهبری جوابش، جواب رهبر رو ببینید \"در سفر برای تحصیل علم نماز شکسته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.64,
   "end": 155.42,
   "text": "و روزه هم صحیح نیست\" یعنی فتواس اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.42,
   "end": 161.6,
   "text": "لکن صحبتی که ما کردیم امروز با دفتر آقا فرمودن نظر آقا احتیاط واجبه، اصلاً فتوا نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.6,
   "end": 164.54,
   "text": "شما اینو عمل کنید. حواستون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.54,
   "end": 169.44,
   "text": "عزیزانی که دیروز بودن هم ، یعنی در حقیقت چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.44,
   "end": 174.32,
   "text": "آقا احتیاط کردن جمع بین شکسته و کامل بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.32,
   "end": 179.78,
   "text": "یعنی کسی که دانشجوعه و بورسیه نیست، مأموریتی نیست، برای تحصیل میره جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.78,
   "end": 181.6,
   "text": "و قصد ده روز هم نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.6,
   "end": 184.22,
   "text": "میره برای تحصیل جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.22,
   "end": 188.78,
   "text": "به هر حال حداقل در هر ده روز یه بار میره میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.78,
   "end": 195.92,
   "text": "فتوای ره-- اینجا فتوا نداده طبق صحبتی که امروز ما با دفتر کردیم آقا احتیاط واجب کرده یعنی فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.92,
   "end": 200.5,
   "text": "احتیاطاً وقتی فتوا نمیده احتیاط می‌کنه یعنی واجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.5,
   "end": 204.68,
   "text": "احتیاطاً هم کامل باید نمازشو بخونه هم شکسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.68,
   "end": 210.24,
   "text": "جمع کنه بین خودش. اما می‌تونه رجوع کنه به یه مجتهد دیگه‌ای چون احتیاط واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.24,
   "end": 213.28,
   "text": "این همه توضیح دادم برای اهمیت قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.28,
   "end": 219.74,
   "text": "اما خب اینم البته اینکه فتوا حالا یه استفاده‌ای هم اینجا شاید هم سوءاستفاده‌ای هم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.74,
   "end": 225.78,
   "text": "اینم که یک مرجع بعد هفتاد سال، هشتاد سال جون کندن، جان به لب رسیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.78,
   "end": 231.0,
   "text": "به قول علامه جان به لب رسید تا جااان به لب رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.0,
   "end": 234.18,
   "text": "باز فتوا نمیده احتیاط می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 234.18,
   "end": 240.68,
   "text": "این نشان- نشان دهنده عظمت دینه، عظمت دستورات دینه، جایگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.68,
   "end": 245.8,
   "text": "بلند معارف الهیه و احکامه که هرکسی جرات نداره حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.8,
   "end": 248.5,
   "text": "آقا هشتاد سال عمر از خدا گرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.5,
   "end": 251.66,
   "text": "شب و روز تو حجره درس خونده باز جرات نمی‌کنه، می‌گه نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.66,
   "end": 254.38,
   "text": "فتوا نمیده یعنی چی؟ یعنی نمی‌دونم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.38,
   "end": 259.02,
   "text": "احتیاط می‌کنه. این از باب همون و- و-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.02,
   "end": 263.64,
   "text": "امانت المحفوظه الهیه در زیارت جامعه کبیره می‌خونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.64,
   "end": 268.4,
   "text": "خطاب به اهل بیت علیهم الصلاة والسلام میگیم \"والأمانة المحفوظة\" شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.4,
   "end": 271.3,
   "text": "امانت محفوظه خدایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.3,
   "end": 274.34,
   "text": "حفظ شده خدایید. اهدی حق نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 274.34,
   "end": 277.0,
   "text": "تفسیر به رای کنه حرفای شما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.0,
   "end": 281.3,
   "text": "جالبه بعدش که مرتبط می‌شه با این بحث قلب ممتحن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.3,
   "end": 288.56,
   "text": "بلافاصله بعد از همین تیکه تو عبارت زیارت جامعه میگه \"والباب المبتلى به الناس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 288.56,
   "end": 291.36,
   "text": "و شما اهل بیت علیهم الصلاة والسلام همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 291.36,
   "end": 293.92,
   "text": "بابی هستید که به شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.92,
   "end": 297.44,
   "text": "مردم گرفتار می‌شن و مبتلا می‌شن و امتحان می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.44,
   "end": 302.74,
   "text": "امتحان الهی بلکه سخت‌ترین امتحان الهی، امتحان با امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 302.74,
   "end": 305.3,
   "text": "که حالا از اینجا ورود به مدخل بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.3,
   "end": 312.32,
   "text": "بحث هر روزمون. امتحان با امام، امتحان با حب اهل بیت، امتحان با ولایت امام عصرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.32,
   "end": 314.18,
   "text": "ما چگونه رفتار می‌کنیم با امام؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 314.18,
   "end": 316.86,
   "text": "و بارها من این سؤالو پرسیدم امروز دوباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 316.86,
   "end": 320.56,
   "text": "بریم تو خودمون یه غوری کنیم \"فليتلفف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.56,
   "end": 323.02,
   "text": "و ليتلتف\" این قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.02,
   "end": 327.56,
   "text": "\"وليتدبر\" به قول علامه حسن زاده \"وليتأمل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.56,
   "end": 331.78,
   "text": "باید اهل تدبر و تأمل باشی تا تلطیف سر پیدا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.78,
   "end": 334.48,
   "text": "تا معارف به جان وجودت بریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.48,
   "end": 338.64,
   "text": "امروز در وجود خودمون غور کنیم، در خودمون فرو بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.64,
   "end": 341.68,
   "text": "که به راستی جایگاه امام عصر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.68,
   "end": 344.74,
   "text": "ولایت و حب اون‌ها در زندگی ما چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 344.74,
   "end": 349.9,
   "text": "چقدر اصلاً؟ اصلاً ما چه جایگاهی برای امام تو زندگیمون داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 349.9,
   "end": 352.14,
   "text": "خدا رحمت کنه حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 352.14,
   "end": 353.78,
   "text": "حالا که بحث به اینجا کشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 353.78,
   "end": 359.4,
   "text": "روحش شاد حضرت آیت الله نورالله شاه آبادی یه کتاب عجیبی دارن به نام-- مخصوصاً میگن عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 359.4,
   "end": 367.98,
   "text": "شبرات المعارف ایشون اونجا یه بحثی رو میارن پیرامون همین محبت و ولایت اهل بیت اشاره می‌کنند به اون آیه \"انا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 367.98,
   "end": 370.8,
   "text": "نحن نزلنا الذکر و انا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.8,
   "end": 374.44,
   "text": "له لحافظون\". چقدر تاکید خدا تو این آیه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 374.44,
   "end": 376.62,
   "text": "که بدون برو برگرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.62,
   "end": 378.62,
   "text": "الا و بالله قطعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.62,
   "end": 382.32,
   "text": "ما خودمون این ذکر رو یعنی این قرآن رو حفظش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.32,
   "end": 389.58,
   "text": "بعد می‌فرماید مسلمونا اینجا به این اشتباه افتادن گفتن خب خدا خود خدا در قرآن فرموده ما حفظ می‌کنیم دینو دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 389.58,
   "end": 391.64,
   "text": "ما کتاب و قرآن و دینو حفظ می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.64,
   "end": 395.02,
   "text": "پس ولش کنیم ما بریم دنبال زندگیمون دیگه چیکار داریم چه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.02,
   "end": 396.78,
   "text": "اصلاً وظیفه شونو زمین گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.78,
   "end": 398.66,
   "text": "کاری که قوم موسی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.66,
   "end": 401.4,
   "text": "گفتن موسی تو برو با خدات برو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.4,
   "end": 405.68,
   "text": "خودت و خدات برید با فراعنه زمان بجنگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 405.68,
   "end": 408.8,
   "text": "هر وقت پیروز شدید دین رو شما محافظید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 408.8,
   "end": 412.8,
   "text": "پیروز شدید بیایید ما میایم. توجه به اون بد-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.8,
   "end": 416.6,
   "text": "بعدش نکردن که بعد از این \"йтиحون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 416.6,
   "end": 419.8,
   "text": "گرفتار آیه قرآنی که میگه گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 419.8,
   "end": 426.62,
   "text": "بیابان طیه، سرگشتگی و سرگردانی بودن چهل سال \"اربعین سنة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.62,
   "end": 428.98,
   "text": "چهل سال گرفتار سرگشتگی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 428.98,
   "end": 431.26,
   "text": "چرا؟ چون دینو زمین گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.26,
   "end": 433.28,
   "text": "حجت خدا رو ول کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 433.28,
   "end": 436.18,
   "text": "امامشونو رها کردن. پیغمبرشون رو رها کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 436.18,
   "end": 440.7,
   "text": "حالا ما اگر گرفتار این قصه بشیم وا مصیبتا این امتحان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 440.7,
   "end": 445.5,
   "text": "بزرگترین امتحان الهی از من و شماست که بزرگان اهل معرفت فرمودن اولین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 445.5,
   "end": 447.22,
   "text": "سواله از من و شما هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 447.22,
   "end": 451.54,
   "text": "لحظه‌ی مرگ نه هنوز ورود به عالم برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 451.54,
   "end": 453.86,
   "text": "لحظه‌ی مرگ سوال از حجت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 453.86,
   "end": 458.54,
   "text": "\"والأمانة المحفوظ\". تو برای چی به کسی امانت میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.54,
   "end": 464.02,
   "text": "برای اینکه بسنجیش. اصلاً فرمودن شیعیان ما رو خیلی از کثرت رکوع و سجودشون نشناسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.02,
   "end": 469.74,
   "text": "بلکه از امانت داریشون از صداقت و راستگویی‌شون از وفای به عهدشون بشناسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 469.74,
   "end": 472.9,
   "text": "اگر کسی امانت‌دار نیست باخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.9,
   "end": 476.54,
   "text": "ولایت اهل بیت بزرگترین امانت دست ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 476.54,
   "end": 478.7,
   "text": "باید مراقب باشیم. یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.7,
   "end": 483.64,
   "text": "سخت‌ترین امتحانات الهی نسبت به امام عصر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.64,
   "end": 490.66,
   "text": "خدا رحمت کنه باز ایشون در همون کتاب بعدش این بعد از این مبحث این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 490.66,
   "end": 493.1,
   "text": "هشدار رو میگه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 493.1,
   "end": 495.76,
   "text": "آیه الله شاه آبادی رحمت الله علیه در شذرات المعارفش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 495.76,
   "end": 498.62,
   "text": "میگه که بعد حالا شیعیان میان اشاره می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.62,
   "end": 502.54,
   "text": "استناد می‌کنن به این حدیث بسیار مستند البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.54,
   "end": 509.14,
   "text": "که \"من مات علی حب آل محمد صلی الله علیه وآله وسلم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 509.14,
   "end": 512.18,
   "text": "\"فهو شهيد\" یا \"مات شهيدا\" هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.18,
   "end": 518.3,
   "text": "هرکس که بر محبت اهل بیت عصمت علیهم السلام بمیره این شهید حساب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 518.3,
   "end": 520.6,
   "text": "میان میگن خب دیگه پس ما شهیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 520.6,
   "end": 525.9,
   "text": "دیگه اون نمیرن دم-- این حضرت آیت الله شاه آبادی می‌فرمایند نمیرن دنبال اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.9,
   "end": 529.5,
   "text": "باطن و حقیقت حب آل محمد چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 529.5,
   "end": 532.78,
   "text": "اصلاً حب اهل بیت یعنی چی؟ دنبال این نمیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 532.78,
   "end": 535.66,
   "text": "در حالی که ایشون می‌فرماید ایمان سه قسمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.66,
   "end": 538.7,
   "text": "یه قسمش تو وجه، توی زبان انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.7,
   "end": 542.88,
   "text": "انسان باید بگه، باید بگه، نباید سکوت کنه، باید تبلیغ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 542.88,
   "end": 545.7,
   "text": "نه فقطاً آخوندا تبلیغ کنن، همه‌ی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 545.7,
   "end": 549.44,
   "text": "یه وجهش عرض شود قلبیه، تو دلت نشسته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 549.44,
   "end": 553.78,
   "text": "یه وجهش هم عمله. عمل انسان مطابق با دستورات اونا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 553.78,
   "end": 557.06,
   "text": "اگر این نباشه ما تو امتحان باختیم عزیز دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 557.06,
   "end": 561.22,
   "text": "تعارفم نداریم و این امتحان تا لحظه‌ی مرگ ما ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 561.22,
   "end": 564.2,
   "text": "حتی لحظه‌ی مرگ هم امتحان ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 564.2,
   "end": 567.06,
   "text": "این بحث ما هم انشاالله به صورت دقیق‌تر ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 567.06,
   "end": 568.8,
   "text": "انشاالله عاقبتmu ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 568.8,
   "end": 572.08,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 572.08,
   "end": 577.28,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}