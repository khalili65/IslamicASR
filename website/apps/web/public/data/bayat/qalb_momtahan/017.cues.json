 },
 "chapters": [
  {
   "index": 0,
   "title": "## صیغهٔ نذر؛ عربی یا فارسی",
   "start": 34.08,
   "end": 77.28
  },
  {
   "index": 1,
   "title": "## آیهٔ امتحان در سورهٔ مؤمنون",
   "start": 77.28,
   "end": 113.34
  },
  {
   "index": 2,
   "title": "## فلسفهٔ امتحان؛ اختبار و رشد",
   "start": 113.34,
   "end": 226.0
  },
  {
   "index": 3,
   "title": "## حسد؛ مانع کمال در اجتماع",
   "start": 226.0,
   "end": 690.38
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.14,
   "end": 6.96,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.96,
   "end": 12.08,
   "text": "السلام علیک یا داعی الله و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.08,
   "end": 15.22,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.22,
   "end": 18.82,
   "text": "در خصوص نذر سخن می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.82,
   "end": 22.58,
   "text": "گاهی اوقات گمان مردم این هستش که حتما باید صیغه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.58,
   "end": 29.66,
   "text": "نذر به عربی باشد چون ما گفتیم که در صورتی نذر بر شما واجب می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.66,
   "end": 32.32,
   "text": "که صیغه بر لسان جاری بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.32,
   "end": 35.96,
   "text": "اگر صیغه نذر بر زبان جاری نشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.96,
   "end": 43.86,
   "text": "نذر واجب نیست. حالا این سؤال هست که بالاخره این صیغه باید عربی جاری بشه یا فارسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.86,
   "end": 48.4,
   "text": "فرمودند نخیر نیازی نیست حتما اون صیغه عربی لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.4,
   "end": 57.6,
   "text": "علیا جاری بشه. همین که به زبانت به همین زبان فارسی خودت نظرت جاری بشه که ای خدا اگر مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.6,
   "end": 59.92,
   "text": "این حاجت منو دادی من این کارو می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.92,
   "end": 65.84,
   "text": "همین که بر لسانت جاری شد بر تو دیگه واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.84,
   "end": 69.48,
   "text": "آیه سی سوره مؤمنون رو دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.48,
   "end": 74.54,
   "text": "ان نوالک الله علیه السامعات وان كنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.54,
   "end": 79.82,
   "text": "لمبتلین. فرمود که این داستانی که ما برای شما گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.82,
   "end": 85.36,
   "text": "یکی از نشانه‌هاست. و ان كنا لمبتلین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.36,
   "end": 88.0,
   "text": "و ما بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.0,
   "end": 89.84,
   "text": "امتحان می‌کردیم یا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.84,
   "end": 92.58,
   "text": "یعنی تنها کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.58,
   "end": 96.28,
   "text": "داره امتحان می‌کنه شماها رو خود ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.28,
   "end": 99.52,
   "text": "ما شما رو در معرض امتحان قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.52,
   "end": 101.66,
   "text": "لام تاکید هم میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.66,
   "end": 106.12,
   "text": "یعنی اصلاً کسی نیست که از دست امتحان ما فرار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.12,
   "end": 109.32,
   "text": "نشانه‌هاش هم در عالم معلومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.32,
   "end": 113.34,
   "text": "اصلاً کسی نمی‌تونه از حیطه امتحان الهی فرار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.34,
   "end": 116.98,
   "text": "حضرت امام رحمة الله علیه در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.98,
   "end": 119.08,
   "text": "چهل حدیثشون می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.08,
   "end": 125.06,
   "text": "فلسفه امتحان الهی یک اختبار است، یک خود امتحان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.06,
   "end": 130.76,
   "text": "که ممتحن قلبی که مورد امتحان قرار گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.76,
   "end": 135.6,
   "text": "خودش رو نشون بده، بروز کنه، ظهور کنه آنچه که در درونش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.6,
   "end": 139.82,
   "text": "همچنین اختبار این خبر گرفتن از درون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.82,
   "end": 144.62,
   "text": "برای خدا که نیست که. قبلاً صحبت کردیم که خود خدا تو قرآن می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.62,
   "end": 148.74,
   "text": "ان الله علیم بذات الصدور به ذات شما خدا آگاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.74,
   "end": 151.7,
   "text": "پس این اختبار برمی‌گرده به خود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.7,
   "end": 156.1,
   "text": "خود ما متوجه بشیم در درونمون چه خبر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.1,
   "end": 158.46,
   "text": "این یکی از فلسفه های امتحان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.46,
   "end": 162.44,
   "text": "که مرحوم شهید مطهری علیه الرحمه هم می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.44,
   "end": 166.02,
   "text": "امتحان صرفاً البته سنجش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.02,
   "end": 171.86,
   "text": "وضعیت درون و وزن‌کشی ما توسط خودمون صرفاً نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.86,
   "end": 176.1,
   "text": "فقط این نیست که ما وزن خودمون رو بسنجیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.1,
   "end": 178.8,
   "text": "درون خودمون رو باخبر بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.8,
   "end": 182.1,
   "text": "به هر حال این نظرات متعدد متکلمینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.1,
   "end": 185.66,
   "text": "می‌فرمود در کنار این رشد وزنی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.66,
   "end": 187.94,
   "text": "وزن معنوی، وزن درونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.94,
   "end": 189.88,
   "text": "اون وزانت درونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.88,
   "end": 192.88,
   "text": "اینکه انسان بر اثر امتحانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.88,
   "end": 197.98,
   "text": "از درون هم رشد بکند نه صرفاً خبر بگیره که درونش چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.98,
   "end": 200.48,
   "text": "این خبر گرفتن وقتی شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.48,
   "end": 205.18,
   "text": "ما ضعف درون، درونیمون رو متوجه نشیم چجوری رشد کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.18,
   "end": 207.8,
   "text": "تا متوجه نشیم چه ضعفی داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.8,
   "end": 210.08,
   "text": "چه دردی داریم، چگونه بر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.08,
   "end": 212.56,
   "text": "به دنبال دوا بگردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.56,
   "end": 219.3,
   "text": "لذا این خیلی مهمه که ما وقتی درد و ضعف درونیمون رو متوجه شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.3,
   "end": 225.36,
   "text": "لاجرم به سمت دوا حرکت کنیم، به سمت رشد بریم که اون رشد هم ایجاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.36,
   "end": 230.62,
   "text": "اما متأسفانه غالب اجتماع اینچنین است به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.62,
   "end": 238.04,
   "text": "خباثتهایی که در اجتماع وجود داره و آلودگی‌هایی که در وجود مردم متأسفانه شکل گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.04,
   "end": 240.58,
   "text": "نمی‌تونن کمال یکدیگر رو ببینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.58,
   "end": 244.58,
   "text": "یکی از دلایلی که الان اجتماع ما خسته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.58,
   "end": 248.28,
   "text": "اگه دقت بفرمایید اصلاً خسته خسته است اجتماع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.28,
   "end": 254.8,
   "text": "به جهت اینکه کمالا وقتی مواجه با کمالات دیگران میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.8,
   "end": 257.28,
   "text": "دچار حسد میشن. معمولاً اینچنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 257.28,
   "end": 260.2,
   "text": "اصلاً اولین گناهی هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 260.2,
   "end": 263.3,
   "text": "در روی زمین رخ داد حسد بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.3,
   "end": 266.2,
   "text": "قابیل برادرش هابیل رو کشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.2,
   "end": 272.64,
   "text": "از روی حسد. ما باید به سمت رشد و س-- تعالی حرکت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.64,
   "end": 275.68,
   "text": "لکن اجتماع متأسفانه مانعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.68,
   "end": 278.06,
   "text": "دور و-- لذا میگه با هر کسی نگرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.06,
   "end": 282.7,
   "text": "با هر کسی رفیق نشو، اسرار وجودیت و زندگیتو به هر کسی نگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.7,
   "end": 285.9,
   "text": "وستر ذهبك و ذهابك و مذهبک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.9,
   "end": 289.6,
   "text": "پیغمبر فرمود بپوشون اصلاً اسرار زندگیتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.6,
   "end": 293.16,
   "text": "دلیلی نداره همه بدونن شما چی داری، چی نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.16,
   "end": 296.34,
   "text": "دلیل نداره سفره دلتو برای هر کسی باز کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.34,
   "end": 301.24,
   "text": "حسودان زیادن. اجازه رشد و تعالی به شما نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.24,
   "end": 306.54,
   "text": "ما باید رشد کنیم. باید درون خودمون رو بر اثر امتحانات ابلهی، اا-- الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 306.54,
   "end": 309.06,
   "text": "بسنجیم و رشدش بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.06,
   "end": 311.86,
   "text": "اما باید مراقب باشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.86,
   "end": 319.44,
   "text": "مانع ایجاد نشه. اصلاً علت اینکه یکی از عللی که اهل بیت علیهم الصلاة والسلام شاید بشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.44,
   "end": 321.5,
   "text": "از بالاترین دلیل‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.5,
   "end": 325.44,
   "text": "که انقدر زحمت کشیدن اهل بیت نتونستن ظهور کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.44,
   "end": 330.04,
   "text": "اهل بیت همشون در غیبت بودن به نوعی یک بار بحثش اینجا گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 330.04,
   "end": 334.12,
   "text": "همین حسودانن. همین کسانی که چشم ندارن ببینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 334.12,
   "end": 336.78,
   "text": "اجازه ندادن اهل بیت ظهور کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.78,
   "end": 340.02,
   "text": "الانم اینچنینه. امام عصر چرا ظهور نمی‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.02,
   "end": 342.32,
   "text": "چرا حضرت فرج نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.32,
   "end": 346.46,
   "text": "به جهت حسودان، بدبینان، بدخواهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.46,
   "end": 351.64,
   "text": "این خیلی مهمه که ما مواجه میشیم با این موانع اجتماعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 351.64,
   "end": 353.8,
   "text": "بچت داره خوب درس میخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.8,
   "end": 355.54,
   "text": "خیلی هم خوش استعداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.54,
   "end": 359.06,
   "text": "یه دفعه از درس میفته. داره خوب ورزش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.06,
   "end": 365.04,
   "text": "یه دفعه از ورزش میفته زندگی‌ت اگرچه حقوق زیادی نداری اما برکت داره می--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.04,
   "end": 368.5,
   "text": "تو زندگی‌ت موج می‌زنه. زندگی‌ت داره یک روال خوبی رو طی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.5,
   "end": 373.74,
   "text": "یه دفعه فلج میشی. نمی‌دونم سالمی یه دفعه از پا می‌افتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 373.74,
   "end": 377.44,
   "text": "بسیاری از این‌ها چشم‌ونظر تنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.44,
   "end": 383.62,
   "text": "حدیث هم داریم‌ها. می‌زنه \"لیزلقونک بأبصارهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.62,
   "end": 386.74,
   "text": "پیغمبر تو رو زدن با چشماشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.74,
   "end": 390.64,
   "text": "این چه-- قرآن داره میگه دیگه با چشمشون تو رو زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.64,
   "end": 395.92,
   "text": "لذا این خیلی مو، متأسفانه معضل بزرگی‌ست در اجتماع ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.92,
   "end": 397.64,
   "text": "که اجازه رشد به ما نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.64,
   "end": 399.92,
   "text": "کمال ندارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.92,
   "end": 403.06,
   "text": "نمی‌تونن کمال دارها رو تحمل کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.06,
   "end": 406.28,
   "text": "چون خودش نداره نمی‌تونه ببینه کسی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.28,
   "end": 408.86,
   "text": "این تنگ دلی‌ست، تنگ نظری‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.86,
   "end": 413.42,
   "text": "که باید مراقب بود. که متأسفانه معمولاً هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.42,
   "end": 418.36,
   "text": "معمولاً اون کسانی که کمالی رو دارن یه گوشه عوت میشن، سوت میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.36,
   "end": 422.08,
   "text": "یه گوشه هستن کسی توجه-- تو اداره میری می‌بینی یه آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 422.08,
   "end": 425.81,
   "text": "فاضل، دانشمند، آگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.81,
   "end": 432.38,
   "text": "مثلاً رسانه رو به خوبی می‌شناسه، آدم متعهدی، متعهدی هم هست یه گوشه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.38,
   "end": 434.88,
   "text": "رفته به حاشیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.88,
   "end": 437.28,
   "text": "یه آدم غیر کار بلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.28,
   "end": 438.88,
   "text": "که اصلاً رسانه رو نمی‌شناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 438.88,
   "end": 441.48,
   "text": "شاید صرفاً فقط حتی مدرک داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.48,
   "end": 446.18,
   "text": "اومده مدیریتی گرفته، کاری رو دستش سپردن، بلد هم نیست جمع و جور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.18,
   "end": 450.56,
   "text": "زیاد اینا رو می‌بینیم‌ها. باور کنید اینا علت اصلیش حسده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.56,
   "end": 453.18,
   "text": "نمی‌تونن ببینن یه کسی داره رشد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.18,
   "end": 457.1,
   "text": "و مگس صفتی طرف از اول تا آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.1,
   "end": 459.4,
   "text": "کلی کارنامه درخشان داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.4,
   "end": 464.54,
   "text": "یا توی مثلاً میاد یه بحث علمی می‌کنه از اول تا آخر همه مباحث عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 464.54,
   "end": 470.64,
   "text": "حالا یه اشتباه، یه اشکالی به یک گوشه‌ای از مباحثش یا یکی از کاراش وارده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 470.64,
   "end": 473.12,
   "text": "همون رو زوم می‌کنه و بزرگ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 473.12,
   "end": 475.3,
   "text": "بابا این همه افتخار آفرید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 475.3,
   "end": 478.06,
   "text": "این همه مباحث علمی ارائه داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 478.06,
   "end": 481.3,
   "text": "چرا اون یه دونه چرا مگس صفتین بعضی از ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.3,
   "end": 483.28,
   "text": "این‌ها موانع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 483.28,
   "end": 489.52,
   "text": "رشد مان. لذا اهل بیت علیهم الصلاة والسلام به شدت، به شدت تأکید می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.52,
   "end": 491.62,
   "text": "اگر می‌خواید رشد کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 491.62,
   "end": 496.56,
   "text": "تعالی پیدا کنید، استعدادهای درونتون شکوفا بشود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 496.56,
   "end": 499.74,
   "text": "در مسیر خودسازی موفق بشوید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 499.74,
   "end": 503.48,
   "text": "در امتحانات الهی سر بلند شوید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 503.48,
   "end": 505.8,
   "text": "مراقب تنگ نظران باشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.8,
   "end": 507.78,
   "text": "مراقب حسودان باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 507.78,
   "end": 511.04,
   "text": "اصلاً گرفتاری اهل بیت همین بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 511.04,
   "end": 514.26,
   "text": "خود منصور دوانيقی علیه اللعنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 514.26,
   "end": 521.74,
   "text": "دشمن اهل بیت بود دیگه. جزو اولین کسایی بود که به هر حال بنو عباس اول که اومدن به پرچم خونخواهی امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.74,
   "end": 526.6,
   "text": "جلوی بنی امیه وایسادن. اما اوایلش خیلی هم با امام صادق خوب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 526.6,
   "end": 529.52,
   "text": "اصلاً با بنی هاشم خوب تا می‌کرد منصور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.52,
   "end": 531.34,
   "text": "ولی هی دور و بریا اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 531.34,
   "end": 534.92,
   "text": "اصلاً میومد زانو می‌زد در محضر علم امام صادق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.92,
   "end": 539.12,
   "text": "دور و بری‌هایی اومدن به منصور گفتن من بودم تو جلسه‌ای که امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.12,
   "end": 542.94,
   "text": "مثلاً جعفر بن محمد داشت بر علیه شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 542.94,
   "end": 546.56,
   "text": "سم پاشی می‌کرد، مردم، مردم رو شورش می‌داد بر علیه حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 546.56,
   "end": 548.88,
   "text": "اون، اونم دیگه به هر حال می‌ترسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 548.88,
   "end": 553.1,
   "text": "یکی رو می‌فرستاد امام صادقو دست و پا، دست بسته بکشونه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 553.1,
   "end": 556.56,
   "text": "قصرش. تنگ نظران و حسودان کار دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 556.56,
   "end": 559.68,
   "text": "ما می‌گیم انتظر ظهورک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 559.68,
   "end": 562.34,
   "text": "و ظهور الحق علی یدک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 562.34,
   "end": 565.5,
   "text": "یکی از بطون معانی ظهور و غیبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 565.5,
   "end": 567.1,
   "text": "همینه. ظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 567.1,
   "end": 571.4,
   "text": "اینکه ما در زمان غیبت انتظار ظهور چیو داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 571.4,
   "end": 575.9,
   "text": "ظهور حق. ظهور برطرف شدن این تنگ نظری‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 575.9,
   "end": 578.72,
   "text": "ریشه‌کن شدن حسدها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 578.72,
   "end": 581.12,
   "text": "رشد کمالات، بروز و ظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 581.12,
   "end": 583.22,
   "text": "اصلاً میگیم ظهور، فرج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.22,
   "end": 585.54,
   "text": "ظهور و فرج کمالات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 585.54,
   "end": 588.88,
   "text": "کسایی که کمال دارن بیان پرچمدار بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 588.88,
   "end": 592.5,
   "text": "نه آدمای بی‌کمال، آدم‌های بی‌سواد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 592.5,
   "end": 594.42,
   "text": "آدمی که کار بلد نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 594.42,
   "end": 601.12,
   "text": "آدمی که صرفاً بر اساس رابطه اومده وسط کار و به جایی رسیده و اجازه نمیده دیگران رشد کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 601.12,
   "end": 603.36,
   "text": "معمولاً این کار دست ما می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 603.36,
   "end": 605.6,
   "text": "معمولاً دو تا عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 605.6,
   "end": 608.56,
   "text": "سخته. میگن این، این حدیث رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 608.56,
   "end": 614.48,
   "text": "حدیثه ها. آخرین چیزی که از وجود عالم میره بیرون حسده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 614.48,
   "end": 617.34,
   "text": "تو سیر معروف خودسازیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 617.34,
   "end": 621.44,
   "text": "خیلی سخته. دو تا آخوند کنار هم وایسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 621.44,
   "end": 624.94,
   "text": "دو تا مداح کنار هم. دو تا مسئول کنار هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 624.94,
   "end": 628.12,
   "text": "دو تا مدیر همتراز مخصوصاً اگه باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 628.12,
   "end": 630.24,
   "text": "کنار هم. دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 630.24,
   "end": 633.24,
   "text": "متأسفانه اینطوریه دیگه. حسد اجازه نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 633.24,
   "end": 636.44,
   "text": "خیلی باید مراقب باشیم که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 636.44,
   "end": 640.88,
   "text": "سر ظهور و فرج که ما داریم دست و پا می‌زنیم براش همینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 640.88,
   "end": 645.56,
   "text": "که بیان ریشه حسد رو بخوش کنند، بدلش کنند به قبضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 645.56,
   "end": 653.6,
   "text": "و اگر کسی باور کنید من استادی دارم که از خودم کوچیکتره، دستشو می‌بوسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 653.6,
   "end": 656.76,
   "text": "در محضر علمش که هر وقت حاضر شدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 656.76,
   "end": 661.58,
   "text": "مثل یک طفلی که در برابر یک بزرگ زانو می‌زنه می‌شینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 661.58,
   "end": 664.06,
   "text": "خب دلیلی نداره چون از من کوچیکتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 664.06,
   "end": 667.3,
   "text": "از جهت علمی به مراتب از من بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 667.3,
   "end": 672.62,
   "text": "اگر این تو اجتماع ما رخ داد، همه ما به سمت صلاح میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 672.62,
   "end": 678.4,
   "text": "اگر نه همینجوری زندگی‌ها خسته، کوفته، داغون معلوم نیست به چه سمتی میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 678.4,
   "end": 680.92,
   "text": "ان شا الله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 680.92,
   "end": 684.12,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 684.12,
   "end": 687.42,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 687.42,
   "end": 690.38,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}