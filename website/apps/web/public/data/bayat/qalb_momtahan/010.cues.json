 },
 "chapters": [
  {
   "index": 0,
   "title": "## نذر و وقف اختصاصی؛ فتوای رهبری",
   "start": 13.14,
   "end": 100.84
  },
  {
   "index": 1,
   "title": "## قلب ممتحن؛ امتحان در ذریه و فرزند",
   "start": 100.84,
   "end": 121.1
  },
  {
   "index": 2,
   "title": "## ابراهیم و عهد امامت؛ لا ینال عهدی الظالمین",
   "start": 121.1,
   "end": 288.2
  },
  {
   "index": 3,
   "title": "## امتحان آدم پس از قتل هابیل؛ حزن بر نسل پاک",
   "start": 288.2,
   "end": 369.78
  },
  {
   "index": 4,
   "title": "## امتحان ما در فرزند؛ خوراک و پوشاک و تربیت",
   "start": 369.78,
   "end": 602.84
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.62,
   "end": 4.24,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.24,
   "end": 9.54,
   "text": "السلام علیک یا داعی الله و ربانی یا آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.54,
   "end": 13.14,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.14,
   "end": 15.86,
   "text": "اگر کسی چیزی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.86,
   "end": 23.02,
   "text": "نذر یا وقف یک هیئتی بکنه، یک حسینیه‌ای، یک مسجدی، یک تکیه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.02,
   "end": 27.32,
   "text": "صرفاً نیتش این باشه که این حالا فرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.32,
   "end": 31.12,
   "text": "مواد غذایی، پرچم، هرچی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.12,
   "end": 35.76,
   "text": "توی اون مسجد یا اون حسینیه یا اون هیئت، اون تکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.76,
   "end": 38.68,
   "text": "استفاده بشه ولاغیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.68,
   "end": 41.94,
   "text": "به فتوای رهبر عزیزمون دیگه به هیچ عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.94,
   "end": 44.84,
   "text": "این چیز رو نمیشه جای دیگه مصرف کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.84,
   "end": 47.66,
   "text": "و به هیچ کجای دیگه هم نمیشه داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.66,
   "end": 49.82,
   "text": "و حتی نمیشه بدل به احسنش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.82,
   "end": 54.2,
   "text": "نمیشه فروختش و چیز دیگه‌ای باهاش تهیه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.2,
   "end": 58.12,
   "text": "مثلا فرشی رو به حسینیه شما، به مسجد شما دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.12,
   "end": 66.32,
   "text": "اگر اینطوری دادن تا وقتی که این حسینیه، این مسجد هست این فرش هم باید باشه تا بپوسه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.32,
   "end": 69.0,
   "text": "ولو نیاز نداشته باشه اون حسینیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.0,
   "end": 72.98,
   "text": "باید اونجا بمونه تا بپوسه. اصلاً نمیشه جای دیگه داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.98,
   "end": 77.84,
   "text": "مگر اینکه صاحب این نذر و این وقف رو پیدا کنید و ازش اجازه بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.84,
   "end": 81.62,
   "text": "بگید آقا اینطوریه اجازه شما می‌دین ما تبدیل به احسنش کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.62,
   "end": 85.14,
   "text": "در غیر این صورت اصلاً نمیشه درش تصرف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.14,
   "end": 88.84,
   "text": "حواس اون جمع باشه. متأسفانه بعضی هیئت‌ها و حسینیه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.84,
   "end": 90.88,
   "text": "دیدم و مساجد این حکمو نمی‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.88,
   "end": 100.84,
   "text": "اصلاً ورمیدارن نذر و وقف مردمو می‌فروشن، بدل به احسن می‌کنن، تبدیل می‌کنن در صورتی که اصلاً این‌ها جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.84,
   "end": 107.7,
   "text": "یکی دیگه از چیزهایی که ما باهاش مورد امتحان الهی واقع می‌شیم بحث ما قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.7,
   "end": 114.56,
   "text": "منتهی بود دیگه قلبی که مورد امتحان خدا واقع می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.56,
   "end": 118.1,
   "text": "یکی از اون مهم‌ترین‌هاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.1,
   "end": 121.1,
   "text": "بحث ذریه و فرزند است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.1,
   "end": 127.06,
   "text": "که ما در مورد اون در حال امتحان هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.06,
   "end": 132.16,
   "text": "ببینید حضرت آدم علی نبینا و آله و علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.16,
   "end": 135.64,
   "text": "به قول علامه حسن زاده در عالم زر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.64,
   "end": 139.38,
   "text": "به کشف یا به دید، به شهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.38,
   "end": 142.38,
   "text": "عالم کثرت در وحدت افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.38,
   "end": 146.44,
   "text": "و همه ارواح تا انتهاء قیامت و تا انتهاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.44,
   "end": 150.46,
   "text": "خلقت رو دید. در عالم وحدت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.46,
   "end": 153.76,
   "text": "کثرت رو دید. برای چی دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.76,
   "end": 156.62,
   "text": "اصلاً برا چی حضرت آدم نگاه انداخت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.62,
   "end": 163.74,
   "text": "که علم آدم الاسماء کلها همه چی رو خدا بهش تعلیم داد و اون معلم شد به اسماء الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.74,
   "end": 167.4,
   "text": "یه وجهش این بوده که ببینه آیا در ذریه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.4,
   "end": 170.14,
   "text": "ذریه پاکی خواهد بود یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.14,
   "end": 173.7,
   "text": "او هم به دنبال ذریه پاک و طیب می‌گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.7,
   "end": 175.94,
   "text": "می-می-می دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.94,
   "end": 180.46,
   "text": "ذریه پاک می‌گشت. حتی تو قصه حضرت ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.46,
   "end": 184.3,
   "text": "اون آیه صد و بیست و چهار حضرت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.3,
   "end": 187.34,
   "text": "سوره بقره است البته. اگه دقت کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.34,
   "end": 191.92,
   "text": "خدا وقتی از امتحان حضرت ابراهیم سخن می‌گوید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.92,
   "end": 196.26,
   "text": "فرمود \"و اذ ابتلی ابراهیم ربه بكلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.26,
   "end": 201.38,
   "text": "فأتمهنهن قال انی جاعلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.38,
   "end": 203.88,
   "text": "للناس اماما\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.88,
   "end": 212.86,
   "text": "خدا داره میگه جاعلك. من اینطوری جعل کردم که تو للناس اماما، امام مردم باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.86,
   "end": 214.82,
   "text": "بلافاصله چی می‌فرماید حضرت ابراهیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.82,
   "end": 218.94,
   "text": "چی عرض می‌کنه با خدا؟ قال و من ذریتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.94,
   "end": 221.32,
   "text": "آیا از ذریه منم هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.32,
   "end": 225.0,
   "text": "کسایی که این امامت رو ادامه بدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.0,
   "end": 227.94,
   "text": "قال لا ینال عهدی الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.94,
   "end": 231.48,
   "text": "خدا می‌فرماید نخیر به ظالمین عهد من نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.48,
   "end": 234.66,
   "text": "یعنی اینکه نگاه کن ببین چه خبره تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.66,
   "end": 237.96,
   "text": "ذریه‌ت. البته از نسل حضرت ابراهیم ادامه پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.96,
   "end": 242.1,
   "text": "این یک قاعده است. این یک قاعده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.1,
   "end": 245.22,
   "text": "که عهد خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.22,
   "end": 249.76,
   "text": "نبوت، رسالت حتی نبوت انبایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.76,
   "end": 253.66,
   "text": "و نه تشریعی. این‌ها حت-- به کسی که ظالمه نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.66,
   "end": 258.56,
   "text": "حالا ظالمه به خودشه، ظالمه به خالقشه، ظالمه به حجت خداست، ظالمه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.56,
   "end": 262.42,
   "text": "خلق الله. انواع و اقسام ظلم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.42,
   "end": 268.36,
   "text": "حضرت ابراهیم میگه من می‌خوام ببینم که تو ز-- نسل من هم-- ببین همه انبیا این چنین بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.36,
   "end": 270.5,
   "text": "دنبال ذریه پاک بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.5,
   "end": 276.28,
   "text": "به قول علامه اصلاً اساس غریزه شهوت نه به جهت اطفاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.28,
   "end": 279.06,
   "text": "ش-- مثلا شهوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.06,
   "end": 284.82,
   "text": "حیوانی است بلکه منظور و قصد انشاء صورت انسانی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.82,
   "end": 288.2,
   "text": "اینکه انسان از خودش نسل پاک باقی بگذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.2,
   "end": 290.8,
   "text": "حضرت آدم وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.8,
   "end": 294.08,
   "text": "مواجه شد با اون امتحان بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.08,
   "end": 297.62,
   "text": "که حالا دقت بفرمایید تو ه-- توی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.62,
   "end": 301.78,
   "text": "کشفش، تو اون نشستش در عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.78,
   "end": 305.22,
   "text": "زر همه رو دیده اما دوباره امتحان می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.22,
   "end": 308.88,
   "text": "دوباره این برادر می‌زنه اون برادر رو می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.88,
   "end": 313.36,
   "text": "خدا دو تا بهش پسر می‌ده، دو تا دختر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.36,
   "end": 316.38,
   "text": "اتفاقاً هابیل خیلی تو دل برو بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.38,
   "end": 319.08,
   "text": "هنوز مو تو صورتش در نیومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.08,
   "end": 321.36,
   "text": "تازه داشته به سنین جوانی می‌رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.36,
   "end": 324.68,
   "text": "خیلی هم با خدا بوده. خب نذرش، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.68,
   "end": 332.42,
   "text": "وقفش قبول می‌شه. هبه‌ای که به خدا میگه بخششی که میدن قبول می‌شه، اون گوسفند چاق و چله‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.42,
   "end": 340.02,
   "text": "و اون خوشه زردی که قابیل بخشیده بوده مثلا در راه خدا روغن سوخته رو نذر مسجد کرده بوده قبول نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.02,
   "end": 342.88,
   "text": "می‌زنه هابیل رو می‌کشه حضرت آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.88,
   "end": 345.36,
   "text": "با اینکه قبلاً دیده بود اما اینجا امتحانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.36,
   "end": 348.3,
   "text": "ببینید دیده بود تو نسلش هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.3,
   "end": 351.2,
   "text": "اما دیگه نسلی نداره که. دیگه فرزندی نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 351.2,
   "end": 353.3,
   "text": "دقت بفرمایید چی عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.3,
   "end": 356.9,
   "text": "الان برادر بده زد حوبل رو کشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.9,
   "end": 364.26,
   "text": "حضرت ابدا-- ابر-- حضرت آدم میگن به شدت محزون شد که شیخ اکبر محی الدین در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.26,
   "end": 367.32,
   "text": "اِاِاِ فسوسش در شـ-- فصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.32,
   "end": 371.5,
   "text": "شیسی یا شیثی که قبلاً بحثش گذشت این م-موضوع رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.5,
   "end": 374.46,
   "text": "میگه خیلی محزون شد حضرت آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.46,
   "end": 379.5,
   "text": "تو فکر فرو رفت. این حزنی که به دل حضرت آدم افتاد از این قصه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.5,
   "end": 382.5,
   "text": "که پس نسل پاک من چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 382.5,
   "end": 386.5,
   "text": "توجه کردید؟ نگران این م-قصه بود بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.5,
   "end": 388.96,
   "text": "که حالا بعداً خدا هبت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 388.96,
   "end": 391.82,
   "text": "حضرت، حضرت شیث رو بهش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 391.82,
   "end": 395.94,
   "text": "اصلاً اینکه حضرت ابراهیم، حضرت آدم این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.94,
   "end": 400.94,
   "text": "دیدن در ذریه‌شون کسی مثل امام حسین سلام‌الله‌علیه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.94,
   "end": 405.68,
   "text": "که امامت و ادامه رسالت از نسل اوست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.68,
   "end": 411.44,
   "text": "یه آرامش خاطری بهشون داده بود اما باز هرازچندگاهی دچار امتحان می‌شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 411.44,
   "end": 415.42,
   "text": "این خیلی مهمه ما در خصوص بچه‌هامون امتحان می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.42,
   "end": 418.32,
   "text": "که چگونه رفتار می‌کنیم؛ در مریضی‌شون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.32,
   "end": 421.08,
   "text": "در از شب-- حتی اسم‌گذاری بچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.08,
   "end": 424.14,
   "text": "چه اسمی رو بچه‌ت می‌ذاری ما در حال امتحان هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.14,
   "end": 431.78,
   "text": "بچه‌تو با چه تربیتی بزرگ می‌کنی، کجا می‌بری، چه رفیقایی بهش، چی به خ-- بهش می‌خورونی، چی بهش به تنش می‌پوشونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.78,
   "end": 434.72,
   "text": "اینا همش امتحانه. ما گاهی اوقات غافله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 434.72,
   "end": 441.08,
   "text": "از امتحانات الهی در خصوص بچه‌هامونیم فکر می‌کنیم امتحان فقط از منه و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 441.08,
   "end": 444.76,
   "text": "شما این داستانی که در خصوص روضه معمولاً شنیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.76,
   "end": 449.46,
   "text": "که تو اون وضعیت که معمولاً تو نقل مقاتل هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.46,
   "end": 451.96,
   "text": "غالب مقاتل اینو آوردن من دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.96,
   "end": 454.88,
   "text": "که وقتی که بچه‌ها اون حالا توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.88,
   "end": 457.04,
   "text": "اِاِاِ سفر اسارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.04,
   "end": 459.74,
   "text": "حضرت زینب سلام‌الله‌علیها می‌بینه دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 459.74,
   "end": 462.4,
   "text": "غذا می‌خورونن به بچه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.4,
   "end": 465.22,
   "text": "خب ایناها حدیث از پیغمبر شنیده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 465.22,
   "end": 469.96,
   "text": "شهر کوفه حدیث نبوی شنیده بودن که چقدر صدقه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.96,
   "end": 472.54,
   "text": "ارزشمنده. حالا دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.54,
   "end": 481.06,
   "text": "تو اون حالت که اگر شما اهل مقتل و مداقه در مقاتل باشید می‌دونید که خیلی گرسنگی به بچه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.06,
   "end": 486.86,
   "text": "فشار آورده بود تا جایی که چند تا بچه تو راه از گرسنگی تلف شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 486.86,
   "end": 489.54,
   "text": "حضرت سجاد سلام‌الله‌علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.54,
   "end": 491.98,
   "text": "بعد از این داستان‌ها یه روز بدجوری گریه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.98,
   "end": 495.38,
   "text": "حضرت زینب سلام‌الله‌علیها گفت چی شده عزیز برادرم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 495.38,
   "end": 502.44,
   "text": "گفت یادم افتاد که رقیه جانم تو بغل من نشست گریه کرد گفت برادر دارم از گرسنگی می‌میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 502.44,
   "end": 505.04,
   "text": "این گرسنگی خیلی اذیت کرده بچه‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 505.04,
   "end": 512.24,
   "text": "تو این حالت مردم اومدن غذا گذاشتن بعد بعضیا حالا تو دستشونه بعضیا تو دهان دارن می‌خورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 512.24,
   "end": 515.38,
   "text": "حضرت زینب سلام‌الله‌علیها می‌فرماید بریزید بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 515.38,
   "end": 517.08,
   "text": "صدقه بر ما حلام، حرامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 517.08,
   "end": 519.22,
   "text": "اینو دیگه همه تو روضه‌ها شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.22,
   "end": 521.4,
   "text": "چرا؟ خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 521.4,
   "end": 523.46,
   "text": "آدم باید نسلش پاک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 523.46,
   "end": 527.5,
   "text": "مال حرام، شبهناک بره تو وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.5,
   "end": 529.8,
   "text": "این دیگه میزنه خراب می‌کنه نسلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 529.8,
   "end": 532.68,
   "text": "ما نسبت به اونچه که تو خونه‌مون می‌بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.68,
   "end": 535.24,
   "text": "از خوراک و پوشاک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 535.24,
   "end": 543.16,
   "text": "افکاری که به بچه‌هامون القا میدیم، جاهایی که می‌بریمشون، روش تربیتمون، سبک زندگیمون، همه و این همه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 543.16,
   "end": 545.88,
   "text": "در حال امتحان الهی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 545.88,
   "end": 551.92,
   "text": "که یکی از، اینطوری بگم خلاصه‌ش، امتحانات سنگین الهی در رابطه با بچه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 551.92,
   "end": 556.36,
   "text": "که جالبه بدونید زبیر که منا اهل البيت شد و سیف‌الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 556.36,
   "end": 562.54,
   "text": "یا سیف‌الاسلام، پسرش عبدالله اونو از امیرالمؤمنین جدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 562.54,
   "end": 565.8,
   "text": "وقتی امیرالمؤمنین باهاش صحبت کرد، پشیمون شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.8,
   "end": 570.78,
   "text": "رفت زد به بیابون، پشیمون شد اما عبدالله دوباره برش گردوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 570.78,
   "end": 572.78,
   "text": "گفت نه اشتباهه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 572.78,
   "end": 575.2,
   "text": "حالا یه بحث مفصلی کردن اینو برش گردوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 575.2,
   "end": 577.36,
   "text": "عبدالله بن زبیر ملعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 577.36,
   "end": 579.46,
   "text": "که جلو مختار علم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 579.46,
   "end": 581.52,
   "text": "بچه خیلی مهمه تو زندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 581.52,
   "end": 585.28,
   "text": "ما که قراره بریم زیر خاک، نسلمون قراره بمونن پای امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 585.28,
   "end": 588.38,
   "text": "لذا آقا وقتی بچه‌های ما رو دید بگه به به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 588.38,
   "end": 591.3,
   "text": "ببین پدرش فلانیه، مادرش فلانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 591.3,
   "end": 597.14,
   "text": "ان‌شاءالله که این چنین بشه عاقبت اون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 597.14,
   "end": 602.84,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}