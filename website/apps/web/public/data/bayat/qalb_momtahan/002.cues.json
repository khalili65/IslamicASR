 "chapters": [
  {
   "index": 0,
   "title": "## سفر شغلی؛ نماز کامل از سفر دوم",
   "start": 14.02,
   "end": 38.08
  },
  {
   "index": 1,
   "title": "## غدیر و نعمان بن حارث؛ سأل سائل",
   "start": 38.08,
   "end": 112.88
  },
  {
   "index": 2,
   "title": "## امتحان دل برای تشخیص مردان ولایت",
   "start": 112.88,
   "end": 184.14
  },
  {
   "index": 3,
   "title": "## مدعیان بسیار و حاملان اندک",
   "start": 184.14,
   "end": 204.26
  },
  {
   "index": 4,
   "title": "## جزئیات واقعهٔ نعمان",
   "start": 204.26,
   "end": 224.44
  },
  {
   "index": 5,
   "title": "## ولایت شیرازهٔ همهٔ علوم",
   "start": 224.44,
   "end": 624.33
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 2.5,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.5,
   "end": 8.62,
   "text": "و به نستعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.62,
   "end": 14.02,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.02,
   "end": 15.86,
   "text": "یکی از جاهایی که آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.86,
   "end": 19.76,
   "text": "در سفر میتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.76,
   "end": 22.68,
   "text": "، یعنی باید نمازشو کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.68,
   "end": 25.64,
   "text": "بخونه و روزشم بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.64,
   "end": 31.72,
   "text": "وقتیه که سفر او سفر شغلی باشه یا مقدمه سفر او،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.72,
   "end": 34.9,
   "text": "مقدمه سفر شغلش باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.9,
   "end": 38.08,
   "text": "یا مقدمه شغلش سفرش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.08,
   "end": 40.62,
   "text": "در حقیقت کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.62,
   "end": 44.34,
   "text": "حداقل طبق فتوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.34,
   "end": 50.18,
   "text": "مراجع، این یه حکم کلیه که البته رهبر عزیزمون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.18,
   "end": 62.1,
   "text": "فرمودن. یه حکم کلیه که حداقل در هر ده روز، اینو دقت کنید یادتون بمونه، در هر ده روز حداقل یک بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.1,
   "end": 67.42,
   "text": "به سفر بره. اگر چنین کسی بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.42,
   "end": 69.28,
   "text": "البته این سفر، سفر چی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.28,
   "end": 75.34,
   "text": "شغلیش باشه. در هر ده روز حداقل یک بار، بیشتر بود که هیچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.34,
   "end": 80.78,
   "text": "حداقل یک بار در هر ده روز به سفرش بره، سفر شغلیش بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.78,
   "end": 85.76,
   "text": "چنین کسی دفعه اول که میره شکسته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.76,
   "end": 88.24,
   "text": "نمازش، مسافر حساب میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.24,
   "end": 91.42,
   "text": "روزه هم نمیتونه بگیره. دفعات بعدی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.42,
   "end": 95.12,
   "text": "مسافر نیست و باید نمازشو کامل بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.12,
   "end": 98.52,
   "text": "مگر اینکه از ده روز بیشتر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.52,
   "end": 102.2,
   "text": "یعنی شما یهو بشه همیشه ده روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.2,
   "end": 107.96,
   "text": "تموم نشده یه دور میرفته میومده، حالا یه دفعه استثنائاً یه بار ده روز تموم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.96,
   "end": 111.84,
   "text": "بگذرونه هنوز نرفته، سفر شغلیش رو هنوز نرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.84,
   "end": 114.5,
   "text": "اون موقع اینجا دوباره این دوره از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.5,
   "end": 116.96,
   "text": "از بین میره. دور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.96,
   "end": 125.44,
   "text": "جدید که اگر دوباره خواست بره باز سفر اولش، این خیلی نکته مهمیه، باز سفر اولش شکسته است نمازش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.44,
   "end": 128.5,
   "text": "سفرهای بعدیش دوباره کامل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.5,
   "end": 134.5,
   "text": "گفتم در صورتی که حداقل در هر درز- ده روز یک بار به سفر شغلی بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.5,
   "end": 137.04,
   "text": "اگر بیشتر رفت که باز مشکلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.04,
   "end": 142.36,
   "text": "کمتر نباید بره. یکی دیگه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.36,
   "end": 152.3,
   "text": "اهمیت‌های قلب مورد امتحان واقع شده، \"الذین امتحن الله قلوبهم للتقوی\" آیه سه سوره احزاب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.3,
   "end": 154.98,
   "text": "بحث می‌کردیم. اینجاییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.98,
   "end": 160.3,
   "text": "اصلاً چرا خدای منان قلب رو مورد امتحان قرار میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.3,
   "end": 165.58,
   "text": "چرا قلب انسان رو خدا مورد امتحان قرار میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.58,
   "end": 169.86,
   "text": "جوابش، البته این جواب خیلی جواب زیاد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.86,
   "end": 173.96,
   "text": "حالا بعداً متوجه میشیم که حداقل چهارصد جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.96,
   "end": 177.4,
   "text": "معرفت نفس تو دل این سواله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.4,
   "end": 180.86,
   "text": "که حالا بعداً بهش میرسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.86,
   "end": 188.06,
   "text": "فعلاً عرض کنیم که بر اساس اون حدیثی که یه بار خیلی بهش توجه کردیم که این حدیث خیلی شیرینه، حفظش کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.06,
   "end": 191.0,
   "text": "\"ان امرنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.0,
   "end": 193.14,
   "text": "امر ما اهل بیت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.14,
   "end": 196.5,
   "text": "اطلاق شده به ولایت امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.5,
   "end": 198.68,
   "text": "و اهل بیت عصمت علیهم السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.68,
   "end": 201.64,
   "text": "الان همه شما ولایت مدارید، درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.64,
   "end": 206.64,
   "text": "همه ما ادعا می‌کنیم که ولایت امیرالمؤمنین و اهل بیت و امام عصرمون رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.64,
   "end": 210.62,
   "text": "حالا اینجا می‌فرماید \"ان امرنا\" منظور همون ولایت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.62,
   "end": 213.14,
   "text": "\"صعب مستصعب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.14,
   "end": 216.2,
   "text": "خیلی سخت و پیچیده و دشواره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.2,
   "end": 219.58,
   "text": "\"لايحمله\" اینجا نهیب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.58,
   "end": 222.42,
   "text": "نمیشه کسی اینو م-- حملش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.42,
   "end": 226.04,
   "text": "همه ما مدعی هستیم حامل ولایت اهل بیتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.04,
   "end": 228.42,
   "text": "میگه آقا نمیشه، خیلی سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.42,
   "end": 233.64,
   "text": "\"لايحمله الا\" یه دسته رو اینجا فقط معرفی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.64,
   "end": 236.96,
   "text": "\"الا عبد امتحن الله قلبه للإيمان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.96,
   "end": 243.14,
   "text": "برگشت به همین آیه. اینو امیرالمؤمنین علیه السلام فرمودن در نهج البلاغه هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.14,
   "end": 246.06,
   "text": "یکی از خطبشون. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.06,
   "end": 255.92,
   "text": "اساساً خدا قلب رو امتحان میکنه که ببینه این قلب اصلاً میتونه حامل ولایت اهل بیت علیهم السلام باشه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.92,
   "end": 259.82,
   "text": "اینه که طرف خیلی از ماها رو می‌بینیم مدعی هستیم بله، اما وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.82,
   "end": 264.52,
   "text": "مشکل، وقت امتحان که پیش بیاد معلوم میشه کی این کاره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.52,
   "end": 267.86,
   "text": "بله، در زبان همه ما اهل ولایتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.86,
   "end": 276.02,
   "text": "اما در امتحانات مشخص میشه کی ت-- در این امتحان نمره‌ش بیست میشه و میتونه ولایت رو برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.02,
   "end": 280.4,
   "text": "پیداست که این ولایت خیلی امر سنگینیه عزیزان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 280.4,
   "end": 283.8,
   "text": "خیلی بار دشوار و سنگینیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 283.8,
   "end": 287.3,
   "text": "که کمر انبیا رو خورد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.3,
   "end": 290.04,
   "text": "کمر انبیا رو شکست تا جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.04,
   "end": 292.98,
   "text": "میدونید اصلاً علت اختلاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.98,
   "end": 297.66,
   "text": "درجات انبیا به میزان حمل بار ولایت‌شونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.66,
   "end": 299.86,
   "text": "این بحث قبلاً گذشته و الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 299.86,
   "end": 303.7,
   "text": "الان خیلی جاش بود که بازش می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.7,
   "end": 311.26,
   "text": "اصلاً شما برید توی آیه یک و دو سوره معارج دقت کنید \"سأل سائل بعذاب واقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 311.26,
   "end": 313.36,
   "text": "للکافرین ليس له دافع\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.36,
   "end": 320.12,
   "text": "چقدر این سوره شیرینه. همین آیه اول و دوم رو تفاسیر رو مراجعه بفرمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.12,
   "end": 324.0,
   "text": "در مجمع البیان جلد ده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 324.0,
   "end": 330.2,
   "text": "اونجا روایت داره که وقتی ا-- پیامبر عظیم الشأن اسلام در حجه الوداع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.2,
   "end": 337.2,
   "text": "در غدیر خم موضوع ولایت امیرالمؤمنین علیه السلام رو به اون شکل که همه میدونید اعلام کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 337.2,
   "end": 345.4,
   "text": "و دستور داد وقتی از منبر که با جهاز شتر با سه پله درست شده بود تش رو آوردن پایین، دستور داد همه بیعت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 345.4,
   "end": 348.76,
   "text": "خودش هم دست امیرالمؤمنین رو گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 348.76,
   "end": 350.9,
   "text": "اونجا همه بیعت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 350.9,
   "end": 355.22,
   "text": "جالبه ها حتی اونایی که قصه ثقیفه رو به وجود آوردن اونجا بیعت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 355.22,
   "end": 357.52,
   "text": "نتونستن هیچ حرفی بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.52,
   "end": 362.74,
   "text": "اما تنها کسی که جرات کرد و جسارت کرد علناً مخالفت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.74,
   "end": 366.72,
   "text": "شخصی بود، می‌شناسید دیگه، به نام نعمان بن حارس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.72,
   "end": 369.59,
   "text": "فهری معروفه این دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 369.59,
   "end": 372.95,
   "text": "نتونست. خیلی جالبه این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 372.95,
   "end": 378.53,
   "text": "دقت بهش بکنید. میگه شنیدید البته اما این بحث این قسمتش رو دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 378.53,
   "end": 381.07,
   "text": "که وقتی خبر پیچید همه جا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 381.07,
   "end": 387.31,
   "text": "تو مدینه مخصوصاً که آره امیرالمؤمنین شده جانشین پیغمبر، این شخص بیرون مدینه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 387.31,
   "end": 391.51,
   "text": "سوار شترش شد اومد وارد شهر شد منزل پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 391.51,
   "end": 393.85,
   "text": "از شتر حتی احترام کرد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 393.85,
   "end": 399.67,
   "text": "خاطر پیغمبر پیاده شد و گفت یا رسول الله ما یه چیز عجیبی شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 399.67,
   "end": 402.15,
   "text": "شما فرمودید بگید لا اله الا الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 402.15,
   "end": 406.09,
   "text": "گفتیم. فرمودید شما پیغمبر خدایی، پذیرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 406.09,
   "end": 409.51,
   "text": "اینجا رو میگم دقت کنید. فرمودید جهاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 409.51,
   "end": 411.63,
   "text": "جهاد کردیم. فرمودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 411.63,
   "end": 413.39,
   "text": "روزه، روزه گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.39,
   "end": 415.95,
   "text": "فرمودید زکات، زکات دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.95,
   "end": 419.57,
   "text": "فرمودید اِاِاِ نماز، نماز خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.57,
   "end": 426.03,
   "text": "یکی یکی واجباتو میشماره و میگه همه رو به نحو احسن انجام دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 426.03,
   "end": 430.05,
   "text": "بابا الان ولایت‌داران امیرالمؤمنین تو نمازشون میشلن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.05,
   "end": 434.67,
   "text": "بعضیامون. اصلاً ولایت امر-- عاشق امیرالمؤمنین نماز نمیخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.67,
   "end": 438.93,
   "text": "من خیلی سراغ دارم‌ها. بهتون گفتم هیئت رفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.93,
   "end": 441.89,
   "text": "سینه می‌زدن، سینه زدنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 441.89,
   "end": 444.27,
   "text": "چه سینه زدنی! و ما أدراک ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 444.27,
   "end": 446.69,
   "text": "اصلاً تو چجوری می‌تونی بفهمی که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.69,
   "end": 448.91,
   "text": "چجوری سینه می‌زنه؟ واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 448.91,
   "end": 451.99,
   "text": "من ندیدم اینطوری. متأسفانه وقتی تموم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 451.99,
   "end": 457.27,
   "text": "مداح اون مجلس که رفیق خود منه گفت هفتاد درصد اینا حاجی نماز نمی‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 457.27,
   "end": 464.53,
   "text": "نمی‌دونی چه سینه‌ای می‌زدن. من بلد نیستم با این همه ادعای عمر و بچه نظام آباد و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 464.53,
   "end": 467.15,
   "text": "خب ایناها، این میگه ما همه رو انجام دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 467.15,
   "end": 469.65,
   "text": "چشم رو چشمون گذاشتیم. نه یه بار، نه دو بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 469.65,
   "end": 472.11,
   "text": "بارها جهاد رفتیم، بارها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 472.11,
   "end": 475.21,
   "text": "این ببین، این توجه به این نکته مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.21,
   "end": 478.13,
   "text": "همینطور داستانو نگیرید بریم تا آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.13,
   "end": 482.97,
   "text": "اما این به قول ماها می‌گه به قول امروزه میگن این تو کته ما نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 482.97,
   "end": 485.87,
   "text": "شما برداشتی پسر عمو خودتو کردی جانشین خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.87,
   "end": 490.49,
   "text": "استغفرالله. ببین این نشون میده آقا کسی که تونسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 490.49,
   "end": 494.67,
   "text": "از بار اون همه واجبات بر بیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 494.67,
   "end": 497.43,
   "text": "این یه دونه رو نمی‌تونه. این پیداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 497.43,
   "end": 499.63,
   "text": "امر خیلی امر پیچیده و دشواریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 499.63,
   "end": 502.61,
   "text": "به راحتی از کنارش رد نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 502.61,
   "end": 505.67,
   "text": "مهاجره کرد با پیغمبر. گفت نه این یه دونه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 505.67,
   "end": 510.07,
   "text": "شما به من بگو استغفرالله خودت اینو گفتی یا خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 510.07,
   "end": 512.27,
   "text": "عجیبه خداوکیلی این گفت‌وگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 512.27,
   "end": 516.57,
   "text": "پیغمبر قسم یاد کرد به حق اون خدایی که منو به رسالت برگزیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 516.57,
   "end": 521.41,
   "text": "این حرف، حرف من نیست. خدا به من فرموده که علی رو جانشین خودم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 521.41,
   "end": 523.59,
   "text": "این انقدر ناراحت شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.59,
   "end": 526.09,
   "text": "که رو کرد به آسمون. سأل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 526.09,
   "end": 531.67,
   "text": "سائل. سائل وقتی سؤال کرد بعذاب واقع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.67,
   "end": 533.51,
   "text": "به یک عذابی که واقع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 533.51,
   "end": 536.69,
   "text": "للكافرين ليس له دافع که نمیشه دفعش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 536.69,
   "end": 539.23,
   "text": "گفت خدایا اگه این حرف توئه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 539.23,
   "end": 543.75,
   "text": "جالبه در حق خودش نفرین کرد، نکرد برعکس نفرین کنه نامرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.75,
   "end": 549.29,
   "text": "گفت اگه این حرف توئه همین الان یه سنگ از آسمون بخوره تو سرم من هلاکم کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 549.29,
   "end": 555.67,
   "text": "و نفرینش مستجاب شد. جلوی چشم همه سنگی از آسمون زد به فرق سرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 555.67,
   "end": 557.69,
   "text": "بیچاره‌اش کرد. رفت به قعر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.69,
   "end": 560.77,
   "text": "جهنم. این آیه قرآنه. سندش هم عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 560.77,
   "end": 564.89,
   "text": "جمع‌البیان مرحوم تبریزی رحمة الله علیه این کتاب شریفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 564.89,
   "end": 566.47,
   "text": "که تو قبر گرفتار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 566.47,
   "end": 571.41,
   "text": "نیت کرد امام عصر به امام عصر گفت آقا من از بین این قبر بیایم بیرون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.41,
   "end": 577.39,
   "text": "میشینم تفسیر قرآن میگم. سی جلد تفسیر قرآن گفته حالا داره خاک می‌خوره تو کتابخونه‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 577.39,
   "end": 579.77,
   "text": "کدوممون نگاه کردیم نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 579.77,
   "end": 583.45,
   "text": "امام عصر از قبر آوردش بیرون که این تفسیر رو بنویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 583.45,
   "end": 586.41,
   "text": "حالا تو جلد دهمش این روایت واقع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 586.41,
   "end": 592.43,
   "text": "این نشون میده که اساساً خدای منان الذین امتحن الله قلوبهم للتقوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 592.43,
   "end": 598.45,
   "text": "خدای منان دل اهل ایمان رو دچار امتحانات مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 598.45,
   "end": 602.01,
   "text": "می‌کنه تا مو رو از ماست به قول معروف بکشه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 602.01,
   "end": 603.89,
   "text": "ببینه کی مرد ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.89,
   "end": 606.71,
   "text": "ولایت شیرازه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 606.71,
   "end": 609.09,
   "text": "اصل همه علوم برمی‌گرده به اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 609.09,
   "end": 611.17,
   "text": "حالا انشاالله این بحث رو ادامه میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 611.17,
   "end": 613.61,
   "text": "انشاالله قصه تموم ختم به خیر بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 613.61,
   "end": 617.17,
   "text": "خدای منان به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 617.17,
   "end": 620.95,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 620.95,
   "end": 624.33,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}