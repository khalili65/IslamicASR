  "ratio": 1.0,
  "maxGapSeconds": 0.0,
  "p95GapSeconds": 0.0,
  "driftFraction": 0.0
 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتاء؛ خیانت متولی موقوفه",
   "start": 0.34,
   "end": 388.01
  },
  {
   "index": 1,
   "title": "قرآن می‌فرماید:",
   "start": 388.01,
   "end": 904.12
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.24,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.24,
   "end": 6.9,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.9,
   "end": 11.28,
   "text": "آیاته. سلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.28,
   "end": 16.42,
   "text": "در خصوص احکام بحث ما در مورد وقف و نذر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.42,
   "end": 21.14,
   "text": "یه افتتاح جالبی از رهبر عزیزمون شده حالا با حضور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.14,
   "end": 26.92,
   "text": "پرشور مدیران فعال و انشاالله خدمتکار و خا- خدوم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.92,
   "end": 33.0,
   "text": "عزیزان و مجموعه عرض می‌شود که مرتبط با آنها هم به گونه‌ای هست که سؤال شده که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.0,
   "end": 42.16,
   "text": "گزارشی بیاد بر اینکه متولی یک موقوفه‌ای حالا حسینیه‌ای، مسجدی، هرچی، متولیان امر خیانت کردن، خائنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.16,
   "end": 44.72,
   "text": "چه باید کرد؟ گزارش اومده آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.72,
   "end": 48.18,
   "text": "فلان مدیر، فلان مسئول، فلان متولی خیانت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.18,
   "end": 51.5,
   "text": "وظیفه ما اینجا چیه؟ خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.5,
   "end": 55.4,
   "text": "ف-فتوای آقا رو دقت کنید با کلمه واجب شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.4,
   "end": 57.42,
   "text": "می‌فرماید واجب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.42,
   "end": 61.68,
   "text": "بررسی این اتهامی که به ایشون وارد شده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.68,
   "end": 63.96,
   "text": "به حاکم شهر بپرسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.96,
   "end": 66.34,
   "text": "ارجاع بدین. انقدر مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.34,
   "end": 71.22,
   "text": "نه این، نه یعنی مثلاً برید یه وکیلی بگیرید، یه آدم معمولی بخواد بررسی کنه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.22,
   "end": 74.7,
   "text": "اولا واجب است. دوما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.7,
   "end": 80.54,
   "text": "بسپارید به حاکم شهر. انقدر خیانت کسانی که متولی و مسئولن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.54,
   "end": 83.62,
   "text": "مهمه. خب جالبه که حالا حضور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.62,
   "end": 86.72,
   "text": "پرشور شما مرتبط شده یا به قولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.72,
   "end": 89.32,
   "text": "برخورد کرده با سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.32,
   "end": 92.6,
   "text": "بحث‌های ما که پیرامون قلب ممتhen بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.6,
   "end": 96.76,
   "text": "ما یه چند وقتی‌ست شاید حدود دو ساله که در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.76,
   "end": 99.22,
   "text": "انواع قلب در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.22,
   "end": 104.6,
   "text": "داریم بحث می‌کنیم که حدود شصت نوع قلب در قرآن رو استخراج کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.6,
   "end": 106.34,
   "text": "رسیدیم به قلب ممتhen.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.34,
   "end": 112.04,
   "text": "یعنی قلبی که خدای منّان او رو مورد امتحان قرار میده با امور مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.04,
   "end": 119.14,
   "text": "که \"ولنبلونكم بشيء من الخوف والجوع ونقص من الأموال والأنفس والثمرات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.14,
   "end": 123.84,
   "text": "همه این‌ها \"ولنبلونكم\" بلا و امتحان و فتنه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.84,
   "end": 127.36,
   "text": "امتحانه. همه رو هم گرفتار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.36,
   "end": 133.3,
   "text": "حالا دیگه باید گفت چه کسانی سر بلند بیرون میان و که بشارت بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.3,
   "end": 136.3,
   "text": "مح-- الان ما می‌خوایم نکته‌ای رو عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.3,
   "end": 142.46,
   "text": "که این حدیث رو به راستی اگر رهبر عزیزمون نفرموده بود از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.46,
   "end": 147.02,
   "text": "عرض شود عمق قصه و اینکه چه کسی داره این رو بیان می‌کنه می‌خوام بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.02,
   "end": 150.44,
   "text": "نه اینکه خودم رو پشت حرف رهبر پنهان کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.44,
   "end": 154.5,
   "text": "اگر نفرموده بود شاید جای تشکیک برای عده‌ای بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.5,
   "end": 156.92,
   "text": "اما جالبه که برج نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.92,
   "end": 161.42,
   "text": "س-سال نود و هفت بله بعد از درس خارج یا همون اول درس خارج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.42,
   "end": 165.68,
   "text": "رهبر عزیزمون با یک آبتابی این حدیث رو بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.68,
   "end": 173.16,
   "text": "دیگه بالاترین رتبه نظام وقتی میگه جای ترس داره، جای لرز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.16,
   "end": 176.12,
   "text": "حدیث جالبه که بدونید تو امالی شیخ طوسی هم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.12,
   "end": 181.72,
   "text": "خیلی سند محکمه. البته مجلس دهمش هست صفحه دویست و چهل و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.72,
   "end": 186.12,
   "text": "و می‌دونید امالی که میگن از نوشتن میاد از املا میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.12,
   "end": 190.36,
   "text": "این بزرگوار در ماه مبارک رمضان این‌ها را نوشته بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.36,
   "end": 198.24,
   "text": "در ماه رم-مبارک رمضان هم تا کسی یقین نداشته باشه بر این حدیث که حدیث اهل بیته حق گفتن نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.24,
   "end": 200.22,
   "text": "اگه بگه روزه، روزه‌ش باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.22,
   "end": 204.72,
   "text": "این نشون، ببینید من الان دارم گرا میدم ببینید چقدر اهمیت داره قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.72,
   "end": 206.94,
   "text": "حالا حدیث اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.94,
   "end": 215.02,
   "text": "عن النبي صلى الله عليه وآله وسلم قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.02,
   "end": 216.96,
   "text": "البته عرض کنم لا یپرانتز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.96,
   "end": 221.86,
   "text": "چهره به واقع نورانی شما نشون میده چون اهل ولایتید، مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.86,
   "end": 226.06,
   "text": "اهل تحقیق و دقت به این مطالب هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.06,
   "end": 230.26,
   "text": "حتما دیدید. من می‌خوام یکی دو تا نکته، کار ما همینن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.26,
   "end": 234.56,
   "text": "نکته‌ای که شاید کمتر بهش توجه شده از این حدیث استخراج کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.56,
   "end": 236.62,
   "text": "لا یعمر رجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.62,
   "end": 240.94,
   "text": "علی عشرة فما فوقهم الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.94,
   "end": 243.52,
   "text": "جيء به يوم القيامة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.52,
   "end": 246.86,
   "text": "مقلولة یده الى عنقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.86,
   "end": 249.68,
   "text": "می‌فرماید هیچ کسی نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.68,
   "end": 254.18,
   "text": "حداقل بر ده نفر ریاست و مدیریت داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.18,
   "end": 258.04,
   "text": "امر و نهی بکنه به اون‌ها یا بیشتر از این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.04,
   "end": 259.94,
   "text": "الا جيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.94,
   "end": 261.94,
   "text": "این یه نکته. جيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.94,
   "end": 264.18,
   "text": "نمیگه میاد. میگه جيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.18,
   "end": 267.22,
   "text": "یه آیه تو قرآن داریم میگه جيء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.22,
   "end": 269.08,
   "text": "يومئذ به جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.08,
   "end": 272.12,
   "text": "جهنم رو میارن، می‌کشونن میارنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.12,
   "end": 274.4,
   "text": "این جهنم چیه که می‌کشونن میارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.4,
   "end": 279.2,
   "text": "که علامه حسن زاده میگه به همین جيء توجه کنی یعنی اصلاً خودت جهنمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.2,
   "end": 281.84,
   "text": "خودت در وجود خودت جهنم ایجاد کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.84,
   "end": 284.88,
   "text": "خدا جهنم خلق نکرده. حالا به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.88,
   "end": 287.02,
   "text": "جيء، میارنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.02,
   "end": 290.92,
   "text": "این خیلی نکته مهمیه. اینطوری نیست که با دست و پای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.92,
   "end": 295.22,
   "text": "خودش راه بیفته بیاد. کشون کشون یعنی با نهایت خاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.22,
   "end": 297.58,
   "text": "این خیلی ترسناکه به خدا قسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.58,
   "end": 302.5,
   "text": "این حدیث. جيء به يوم القيامة مقلولة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.5,
   "end": 305.0,
   "text": "یده الى عنقه. اینم یک نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.0,
   "end": 311.34,
   "text": "البته خدا رو شاهد می‌گیرم اگه آدم باسواد باشه با هر کلمه این حدیث باید یه منبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 311.34,
   "end": 314.96,
   "text": "چهل دقیقه‌ای بره. که رفتن بعضی از بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.96,
   "end": 320.16,
   "text": "میگه که این دست رو نه فقط می‌بندن بلکه به گردن می‌بندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 320.16,
   "end": 323.02,
   "text": "به گردن. چون نهایت خاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.02,
   "end": 329.02,
   "text": "وقتی دست به گردن بسته میشه، دیدی اسراهای ما رو داعشی‌ها چجوری می‌بستن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.02,
   "end": 331.08,
   "text": "که حالت خاری به خودش بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.08,
   "end": 333.26,
   "text": "نتونه سرش هم بیاره بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.26,
   "end": 335.9,
   "text": "دست پشت گردن سر بالا نیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.9,
   "end": 338.1,
   "text": "یعنی دیگه اوج ذلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 338.1,
   "end": 340.04,
   "text": "فإن کان محسنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.04,
   "end": 342.04,
   "text": "برای چی میارنش اینطوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.04,
   "end": 345.62,
   "text": "برای اینکه حساب کتاب بشه. مگه شوخی نظام هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.62,
   "end": 349.2,
   "text": "عالم بر اساس ولایت در جریان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.2,
   "end": 357.44,
   "text": "اگر کسی خلاف ولایت عمل کند، خلاف ولایت کلیه الهی عمل کند، باید جوابگو باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 357.44,
   "end": 360.24,
   "text": "می‌فرماید فإن کان محسنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 360.24,
   "end": 364.31,
   "text": "این باز محسن الله اکبر چقدر اینجا حرف میشه زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.31,
   "end": 368.79,
   "text": "اگر محسن بود حالا بگیم نیکوکار بود فک عنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 368.79,
   "end": 372.73,
   "text": "باز می‌شه این تازه دستش باز می‌شه تازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 372.73,
   "end": 377.43,
   "text": "اگه نیکوکار بود. حالا شما برید رو کلمه محسن کار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.43,
   "end": 381.21,
   "text": "اونجایی که قرآن می‌فرماید \"من جاء بالحسنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.21,
   "end": 383.01,
   "text": "فله عشر امثاله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.01,
   "end": 385.47,
   "text": "اگر کسی با یک حسنه بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 385.47,
   "end": 388.01,
   "text": "خدا ده برابر بهش پاداش می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 388.01,
   "end": 392.65,
   "text": "علامه جوادی آملی می‌فرماید این نه یعنی تو یک ثواب ببر ده تا بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 392.65,
   "end": 394.73,
   "text": "سود بانکی ده برابر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 394.73,
   "end": 398.85,
   "text": "نخیر یعنی اون حسنه معنای ولایت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 398.85,
   "end": 405.39,
   "text": "اگر کسی با التزام دقت کنید به کلمات با التزام قلبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 405.39,
   "end": 407.81,
   "text": "لسانی و جوهره‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 407.81,
   "end": 411.23,
   "text": "یعنی هم جوانحی، هم جوهره‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 411.23,
   "end": 413.61,
   "text": "وارد بشه به درگاه خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 413.61,
   "end": 417.51,
   "text": "چنین کسی خدا ده برابر به سمت او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 417.51,
   "end": 419.51,
   "text": "هروله کنان حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 419.51,
   "end": 422.45,
   "text": "این تعبیریه که علامه جوادی آملی ذیل این داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 422.45,
   "end": 426.23,
   "text": "در ربنا آتنا في الدنيا حسنة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 426.23,
   "end": 429.45,
   "text": "و في الآخرة حسنة و قنا عذاب النار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 429.45,
   "end": 437.37,
   "text": "در تعبی-- در ذیل این حدیث دیدم بسیاری از بزرگان تصریح کردن که این حسنه ولایت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 437.37,
   "end": 442.45,
   "text": "یک جا فرمودن محبت حضرت صدیقه کبرا سلام الله علیهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.45,
   "end": 446.61,
   "text": "یک جا به صورت کلی‌تر گفتن ولایت امیرالمؤمنین و اولادشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 446.61,
   "end": 451.25,
   "text": "چی؟ حسنه. پس اینجا میگه \"فان کان محسنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 451.25,
   "end": 460.73,
   "text": "اگر محسن بود یعنی ولایت رو با تمام شئوناتش التزام جوانحی و جوهره‌ای داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 460.73,
   "end": 464.37,
   "text": "الله اکبر. خیلی خطر بزرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.37,
   "end": 467.59,
   "text": "میگه اگر اینطوری بود \"فك عنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 467.59,
   "end": 470.73,
   "text": "و ان كان\" استغفرالله \"مسيئا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 470.73,
   "end": 480.39,
   "text": "اگر اینجا اهل عصیان و اساء ادب و سیئه و کوتاهی و عن تقصیر البته باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 480.39,
   "end": 483.47,
   "text": "که این عن تقصیر رو رهبری فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 483.47,
   "end": 486.13,
   "text": "چی می‌شه؟ \"زيد غلا الا غله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.13,
   "end": 489.63,
   "text": "نه که دستش باز نمی‌شه بلکه زنجیر رو زنجیر میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.63,
   "end": 492.51,
   "text": "بستن رو بستن میاد. اصلاً می‌بندنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 492.51,
   "end": 498.13,
   "text": "به فلک می‌بندنش. اینه که رهبری جالبه که وقتی این حدیث رو می‌فرماد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 498.13,
   "end": 503.89,
   "text": "دقت کردم من اینایی که میگم شو به خدمت شما عزیزان تحقیقاً نه تقریباً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 503.89,
   "end": 509.75,
   "text": "معمولاً رهبر عزیزمون وقتی قبل درس خارجش حدیثی رو میگه سریع میگه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.75,
   "end": 511.49,
   "text": "اما رو این حدیث خیلی توقف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.49,
   "end": 513.51,
   "text": "حتی خاطره‌ای از خودش گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 513.51,
   "end": 517.61,
   "text": "حتما شنیدید که فرمود من تاریخشم گفتم برید درآرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.61,
   "end": 522.71,
   "text": "که فرمود \"من خود ریاست جمهوری دوره اول بهم تحمیل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.71,
   "end": 525.17,
   "text": "دوره دوم هم بهم تکلیف شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 525.17,
   "end": 527.39,
   "text": "گفتن هم واجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 527.39,
   "end": 529.57,
   "text": "عینی‌ست هم تعینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.57,
   "end": 532.39,
   "text": "که تو بری نامزد بشی\" و فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.39,
   "end": 540.73,
   "text": "با بر اساس این حدیث آدم باید از مسئولیت و مدیریت برداشتن ولو برای ده نفر فرار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.73,
   "end": 544.79,
   "text": "بعد رهبر خودش می‌فرماید \"من تعجب می‌کنم چگونه بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 544.79,
   "end": 548.35,
   "text": "سر و کله می‌شون برای گرفتن م-مسئولیت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 548.35,
   "end": 550.83,
   "text": "یا حق و ناحق می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.83,
   "end": 555.75,
   "text": "پول میدن. نمی‌دونم کارهای کثیف می‌کنند که حالا الحمدلله از شأن شما به دوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.75,
   "end": 559.29,
   "text": "منتها چون این میره تو کانال و دست یه سری می‌رسه و چه می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 559.29,
   "end": 563.51,
   "text": "بالاخره ما وظیفه داریم اول البته نسبت به خودم حدیث نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.51,
   "end": 567.59,
   "text": "وای به حال کسی که حدیث داریم، حدیث از پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 567.59,
   "end": 572.09,
   "text": "اگر نمی‌تونه بار هفت نفر رو برداره قبول کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.09,
   "end": 575.85,
   "text": "فرموده به من رسول خدا خیانت کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 575.85,
   "end": 578.49,
   "text": "و البته فرمود اگر کسی بتواند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 578.49,
   "end": 583.45,
   "text": "بار هفت نفر رو برداره و برنداره، ابا کنه، می‌تونه ابا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 583.45,
   "end": 585.57,
   "text": "این هم به من پیغمبر خیانت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.57,
   "end": 589.69,
   "text": "چرا تو که ولایتی ای بر نداری یه آدم خبیث بیاد برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 589.69,
   "end": 593.43,
   "text": "منتها مهم اینه که تو دست و پا نزنی براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 593.43,
   "end": 599.47,
   "text": "و اینو دقت بفرمایید. تورو خدا خواهش می‌کنم از من بدتون میاد، از شخص من بدتون میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 599.47,
   "end": 601.85,
   "text": "از حرف من که نباید بدت بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 601.85,
   "end": 606.41,
   "text": "از قیافه من خوشت نمیاد اشکال نداره از حرف من که نباید بدت بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.41,
   "end": 609.61,
   "text": "حرف ما حقه. همشم مستنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 609.61,
   "end": 615.25,
   "text": "هم رهبرمون، هم اماممون، هم پیغمبرمون حقایق رو دارن بیان می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 615.25,
   "end": 617.55,
   "text": "به این برید دقت کنید. میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 617.55,
   "end": 622.59,
   "text": "محسنا ولایت باید در تمام شئوناتش جاری شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 622.59,
   "end": 626.55,
   "text": "من یک برگه ای رو آماده کردم حدود شاید شصت هفتاد تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 626.55,
   "end": 629.27,
   "text": "از، از شاید عنا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 629.27,
   "end": 634.09,
   "text": "می‌شه گفت ارزش‌ها و معیارهای مدیریت درست در اسلام از لسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 634.09,
   "end": 637.15,
   "text": "امیرالمؤمنین علیه الصلاة والسلام قرار بود به دست شما برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 637.15,
   "end": 639.51,
   "text": "نمی‌دونم چرا نرسید. عناوینش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 639.51,
   "end": 643.09,
   "text": "اون‌ها باید همه جاری باشه در وجود انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 643.09,
   "end": 652.33,
   "text": "برای یک مدیر مهم. مدیری که بتونه در حوزه مسئولیتش محکم عمل کنه که اونجا اون بند باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 652.33,
   "end": 658.47,
   "text": "عزیزان دلم. نسبت به زیردست، نسبت به مثلاً من یه حدیث دیگه بخونم و ختم کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 658.47,
   "end": 661.95,
   "text": "دیگه با این حدیث شما دیگه اوج قصه رو بگیرید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 661.95,
   "end": 664.63,
   "text": "الحمدلله اهل فهمید، اهل درکید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 664.63,
   "end": 667.55,
   "text": "محضر شما خوبان، بزرگان، اهل فضل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 667.55,
   "end": 670.01,
   "text": "من زیره به کرمون می‌برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 670.01,
   "end": 674.59,
   "text": "اما چه کنیم ما هم وظیفه ای داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 674.59,
   "end": 676.53,
   "text": "خیلی این حدیث رو توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 676.53,
   "end": 680.09,
   "text": "خیلی جای بحث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 680.09,
   "end": 682.39,
   "text": "می‌فرماید در قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 682.39,
   "end": 686.13,
   "text": "خدای منان به کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 686.13,
   "end": 693.77,
   "text": "فقیر بودن و رفتن از کسی پول گرفتن، مثلاً از یکی وامی، قرضی چیزی گرفتار شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 693.77,
   "end": 697.13,
   "text": "موسى بن جعفر فرمودن سه جا اجازه قرض گرفتن دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 697.13,
   "end": 699.85,
   "text": "یک، یک جا در قرض سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 699.85,
   "end": 703.31,
   "text": "یعنی کمرشکن شده مخارج زندگیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 703.31,
   "end": 705.37,
   "text": "قرض‌ها بالا آوردی چاره‌ای نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 705.37,
   "end": 707.85,
   "text": "میگه اشکال نداره. حالا میری می‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 707.85,
   "end": 709.95,
   "text": "میگه این قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 709.95,
   "end": 714.17,
   "text": "به کسی که به تو پول کمک کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 714.17,
   "end": 717.53,
   "text": "و تویی که به او کمک کردی شما رو رو در رو قرار میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 717.53,
   "end": 721.33,
   "text": "عجیبه این حدیثو دقت کنید. من دارم قشنگ تشریحش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 721.33,
   "end": 724.23,
   "text": "به اون کسی که پول گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 724.23,
   "end": 727.63,
   "text": "میگن برو از بالای دست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 727.63,
   "end": 732.88,
   "text": "یه رتبه بالاتر، بالادست اون کسی که به تو کمک کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 732.88,
   "end": 736.88,
   "text": "از بالا دستشو بگیر و بیارش بالا نجاتش بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 736.88,
   "end": 738.68,
   "text": "کمکش کن، شفیعش باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 738.68,
   "end": 741.22,
   "text": "هر یاری می‌خوای بهش بده تو اون صحنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 741.22,
   "end": 747.66,
   "text": "بعد از امام سؤال میشه چرا از بالا در-- این، این فقیره که پول گرفته تو دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 747.66,
   "end": 751.84,
   "text": "چرا از بالا بره دست کسی رو بگیره بکشه بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 751.84,
   "end": 756.76,
   "text": "که تو، تو دنیا منو کمک کردی من می‌خوام اینجا تلافی‌شو بدم تو رو نجات بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 756.76,
   "end": 761.12,
   "text": "عجیب حرفی می‌زنه فرمایشی داره اینجا امام صادق صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 761.12,
   "end": 763.9,
   "text": "می‌فرماید چون اون لحظه‌ای که تو دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 763.9,
   "end": 771.7,
   "text": "به هوش و گوش باشید، اون دنیا این فقیر داشت پولو می‌گرفت، دستش پایین دست اون کسی بود که پول می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 771.7,
   "end": 774.12,
   "text": "یک شرمی، یک خجالتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 774.12,
   "end": 776.2,
   "text": "یک شکستی تو وجودش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 776.2,
   "end": 778.72,
   "text": "خدا غیرتمنده، غیوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 778.72,
   "end": 782.86,
   "text": "نمی‌تونه ببینه بنده‌ش زیر دست کسی زجر بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 782.86,
   "end": 785.3,
   "text": "میگه حالا می‌خوای دستشو بگیری قیامت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 785.3,
   "end": 788.8,
   "text": "تو از بالا دست اونو بگیر که جبران اون خجلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 788.8,
   "end": 790.96,
   "text": "و اون شکست درونی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 790.96,
   "end": 799.18,
   "text": "اگر ما به خدا قسم این جزئیات آیات و روایات رو بررسی کنیم و دقت کنیم تنمون می‌لرزه که مسئولیت داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 799.18,
   "end": 803.7,
   "text": "و اگر داشته باشیم به قول رهبر عزیزمون خواب تو چشامون نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 803.7,
   "end": 808.94,
   "text": "وای به حال کسی که وقتی مسئولیت گرفت سرسنگی بشه، سلام کسی رو درست جواب نده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 808.94,
   "end": 813.52,
   "text": "پشت در کسی رو معطل کنه، جواب کسی رو نده، نامه‌ی کسی رو جواب نده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 813.52,
   "end": 815.8,
   "text": "یا به قول رهبر عن تقصیر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 815.8,
   "end": 818.74,
   "text": "خب حتی رهبر به اینجا می‌کشونه ختم کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 818.74,
   "end": 821.38,
   "text": "دیگه اهل فضلیت می‌دونید منظور آقا چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 821.38,
   "end": 830.7,
   "text": "میگه حتی اگر عن تقصیر قرار بوده در حوزه مسئولیت و فعالیت شما یه اتفاقاتی رخ بده، باید رخ می‌داده و تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 830.7,
   "end": 833.46,
   "text": "در حوزه مسئولیت تو رخ نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 833.46,
   "end": 836.32,
   "text": "اگر عن تقصیر بوده باز جوابگو باید باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 836.32,
   "end": 839.64,
   "text": "در مورد کارهایی که صورت نگرفته تازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 839.64,
   "end": 842.68,
   "text": "نه اون‌هایی که دست پاشه شکسته و خراب صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 842.68,
   "end": 844.7,
   "text": "ببینید چقدر خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 844.7,
   "end": 848.76,
   "text": "لذا تا تکلیف نباشه آدم نباید مسئولیت برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 848.76,
   "end": 852.2,
   "text": "بنده حقیر بارها عرض کردم محضر عزیز دلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 852.2,
   "end": 855.54,
   "text": "که اینجا تشریف دارند و خیلی هم عزیزن برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 855.54,
   "end": 857.64,
   "text": "مسئولیت و مدیریت محترم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 857.64,
   "end": 862.28,
   "text": "این مجموعه و خود شماها. می‌دونید تو همین سازمان نگید عروس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 862.28,
   "end": 864.34,
   "text": "نمی‌دونم چی میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 864.34,
   "end": 866.6,
   "text": "رقص بلد نیست میگه زمین کجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 866.6,
   "end": 869.94,
   "text": "نمی‌دونم گربه دستش به گوش نرسه میگه پیف پیف بو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 869.94,
   "end": 874.84,
   "text": "نه. به بنده حقیر هم مسئولیت‌های کلان مدیری کلی پیشنهاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 874.84,
   "end": 881.18,
   "text": "به خدا قسم به خاطر همین چون احساس تکلیف نکردم چون بودن آدم‌های بهتر از من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 881.18,
   "end": 884.36,
   "text": "دو ترسیدم، خدا شاهده ترسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 884.36,
   "end": 886.98,
   "text": "اگرچه مد-- خیلی هم حقوق‌های خوبی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 886.98,
   "end": 891.58,
   "text": "این ترس اگر در وجود ما نش-- نیاد کار دست ما میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 891.58,
   "end": 893.88,
   "text": "کار ما به کارستون می‌رسه. انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 893.88,
   "end": 898.56,
   "text": "عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 898.56,
   "end": 904.12,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}