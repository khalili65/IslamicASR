 },
 "chapters": [
  {
   "index": 0,
   "title": "## تبدیل به أحسن در وقف؛ تعمیر نه مبادله",
   "start": 0.56,
   "end": 553.78
  },
  {
   "index": 1,
   "title": "## سمیع الدعاء نه سامع",
   "start": 553.78,
   "end": 725.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.56,
   "end": 4.52,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.52,
   "end": 8.32,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.32,
   "end": 12.58,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.58,
   "end": 18.08,
   "text": "عرض شد که آنچه که وقف می‌شود برای حسینیه، مسجد یا هر جایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.08,
   "end": 21.28,
   "text": "اون رو دیگه نمیشه تبدیل به احسن کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.28,
   "end": 23.74,
   "text": "لکن این رو توجه داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.74,
   "end": 30.16,
   "text": "اگر چنانچه مثلاً یه ظرفی توی حسینیه، مسجدی غور بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.16,
   "end": 37.58,
   "text": "کج و کوله بشه، بخوان برن درستش کنن یا قرآن‌ها، مفاتیح‌ها، کتاب‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.58,
   "end": 39.68,
   "text": "خراب بشن یا به نوعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.68,
   "end": 42.94,
   "text": "مستهلک بشن بخوان این‌ها رو تبدیل به احسن کنن؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.94,
   "end": 45.26,
   "text": "مثلاً جلش‌ون کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.26,
   "end": 47.86,
   "text": "صحافی‌شون کنن، دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.86,
   "end": 50.72,
   "text": "ازش استفاده کنن، این اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.72,
   "end": 53.82,
   "text": "اون تبدیل به احسن که گفتیم اشکال داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.82,
   "end": 56.76,
   "text": "اینه که برن بفروشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.76,
   "end": 59.0,
   "text": "با پولش یه چیز دیگه تهیه کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.0,
   "end": 61.56,
   "text": "یا مبادله کنن، اونو بدن یه چیز دیگه بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 61.56,
   "end": 68.06,
   "text": "این اشکال داره ولی تبدیل به احسن کردن از این حیث که مستهلک رو بردارن بس-- درستش کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.06,
   "end": 70.96,
   "text": "تر و تمیزش کنن اشکالی ندارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.96,
   "end": 76.24,
   "text": "به شرط اینکه دو مرتبه تو همون محل ازش استفاده بشه، نه یک محل دیگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.24,
   "end": 80.9,
   "text": "همون مسجد، همون حسینیه، همون هیئت و تکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.9,
   "end": 87.2,
   "text": "خب عرض شد که یکی از امتحانات سنگین خدا از ما پیرامون فرزندان‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.2,
   "end": 91.06,
   "text": "نکته اینجاست که ما اصلاً برای چی فرزند می‌خوایم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.06,
   "end": 94.8,
   "text": "یا نوع خواستن فرزندمون از خدا چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.8,
   "end": 99.84,
   "text": "چگونه فرزندی می‌خوایم؟ اینم خودش مورد ابتلا و امتحانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.84,
   "end": 102.06,
   "text": "یعنی اون روز اول که ما اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.06,
   "end": 107.32,
   "text": "به جهت بقای نسل و تجدید نسل ازدواج کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.32,
   "end": 110.74,
   "text": "اصلاً طلب وجودی ما، این خیلی مهمه ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.74,
   "end": 116.3,
   "text": "طلب وجودی ما، اون ادعاها اینا رو ولش کن که سرباز امام زمان می‌خوام تربیت کنم، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.3,
   "end": 120.72,
   "text": "اون طلب وجودی ما چی بوده از اینکه بچه دار شدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.72,
   "end": 125.44,
   "text": "به واقع چی می‌خواستیم؟ می‌خواستیم با بچه‌هامون پز بدیم تو اجتماع؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.44,
   "end": 128.02,
   "text": "مثلاً به قول بعضیا عصای دستمون بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.02,
   "end": 131.68,
   "text": "چه می‌دونم چی بوده؟ انگیزه اصلی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.68,
   "end": 134.04,
   "text": "از فرزنددار شدن چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.04,
   "end": 137.14,
   "text": "این هم خودش یک نوع امتحانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.14,
   "end": 140.72,
   "text": "خدا از ما می‌پرسه که شما برای چی بچه، بچه دار شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.72,
   "end": 146.54,
   "text": "اصلاً برای چی بچه خواستی؟ جالبه که البته این رو بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.54,
   "end": 149.22,
   "text": "الان فهم و دانستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.22,
   "end": 154.24,
   "text": "معارف الهیه ارزش و اهمیتش به نوعی مشخص میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.24,
   "end": 159.12,
   "text": "ببینید دانستن یا ندانستن این حدیث چقدر تأثیرگذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.12,
   "end": 163.38,
   "text": "که پیامبر عظیم الشأن اسلام این حدیث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.38,
   "end": 170.26,
   "text": "عرض کنم وا-- مرحوم ملا محسن فیض کاشانی در کتاب شریف وافیش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.26,
   "end": 174.44,
   "text": "اگر خواستید مراجعه کنید جلد بیست و یک، صفحه چهل و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.44,
   "end": 179.94,
   "text": "پیامبر فرمود که \"انی اباهی بکم الامم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.94,
   "end": 184.46,
   "text": "من به شما \"یوم القيامة\" روز قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.46,
   "end": 188.58,
   "text": "مباهات می‌کنم جلوی امت‌های پیشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.58,
   "end": 192.44,
   "text": "و جالبه، عجیبه می‌فرمود \"ولو بصقد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.44,
   "end": 194.62,
   "text": "تو یک مصدر دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.62,
   "end": 198.58,
   "text": "می‌فرماید و ح-حتی بصقد، بصقد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.58,
   "end": 201.08,
   "text": "دو تاش هست ولو یا حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.08,
   "end": 204.14,
   "text": "میگه من قیامت، پیغمبر می‌فرماید قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.14,
   "end": 209.14,
   "text": "به شما مباهات می‌کنم جلوی امت‌های پیشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.14,
   "end": 212.98,
   "text": "ولو اگر بچه‌های شما صقد شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.98,
   "end": 217.32,
   "text": "عجیبه. وقتی آدم این رو متوجه میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.32,
   "end": 222.42,
   "text": "اصلاً میاد انگیزه بچه دار شدنشو مباهات پیغمبر قرار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.42,
   "end": 228.08,
   "text": "اینکه پیغمبر افتخار کنه به اینکه-- این که رهبر این همه داد می‌زنه ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.08,
   "end": 234.92,
   "text": "که آقا جان شیعیان دست به کار شن، سعی کنن نسل‌شون رو زیاد کنن و واقعاً اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.92,
   "end": 239.88,
   "text": "امکاناتش رو از هر حیث داشته باشه و کوتاهی کنه باز باید جواب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.88,
   "end": 243.26,
   "text": "کسی می‌تونه توانش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.26,
   "end": 246.48,
   "text": "از حیثیات مختلف داره اما نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.48,
   "end": 250.54,
   "text": "این قی-- خودش این یه امتحانه و قیامت باید جوابگو باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.54,
   "end": 252.24,
   "text": "پیغمبر می‌خواد مباهات کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.24,
   "end": 256.6,
   "text": "خب بده؟ مباهات پیغمبر ولو به اون بچه‌ای که صقد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.6,
   "end": 258.7,
   "text": "آخه ببینید باید روش بحث بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.7,
   "end": 261.86,
   "text": "آخه بچه که صقد شد دیگه به چه درد می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.86,
   "end": 265.36,
   "text": "یه ذخیره قیامت شده. اونجا پیغمبر مباهات می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.36,
   "end": 268.3,
   "text": "عجیبه‌ها. این حدیث خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.3,
   "end": 271.42,
   "text": "جالبه که تو کتاب نفس المهموم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.42,
   "end": 275.22,
   "text": "در همون باب اولش باید باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 275.22,
   "end": 279.48,
   "text": "شیخ خدا رحمت کنه محدث قمی رحمة الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.48,
   "end": 284.42,
   "text": "یه روایتی رو از ريان بن شبيب میاره که معروف هست به ابن شبيب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.42,
   "end": 287.72,
   "text": "ایشون داعی معتصم عباسی بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.72,
   "end": 292.08,
   "text": "وقتی میان محضر امام رعوف سلام الله عليه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.08,
   "end": 296.66,
   "text": "ااا عرضه می‌داره که روزه‌ای امروز، روز اول محرم بوده جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.66,
   "end": 301.36,
   "text": "امروز روزه‌ای، میگه نه من روزه نیستم و حضرت می‌فرماید که چطور روزه نیستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.36,
   "end": 304.8,
   "text": "که امروز مصادف است با همون روزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.8,
   "end": 310.42,
   "text": "حضرت زکریا علی نبی و آله و عليه الصلاة والسلام در محراب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.42,
   "end": 315.76,
   "text": "قرار گرفت و \"وهو قائم یصلی في المحراب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.76,
   "end": 318.14,
   "text": "و اونجا از خدا طلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.14,
   "end": 320.82,
   "text": "ذریه طیبه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.82,
   "end": 325.7,
   "text": "آیه‌ش رو اگر خود-- خواستید رجوع کنید آیه سی و هشت سوره آل عمرانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.7,
   "end": 328.78,
   "text": "که \"هنالك دعا زکریا ربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.78,
   "end": 332.74,
   "text": "قال\" حضرت زکریا به خدا عرض می‌کنه رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.74,
   "end": 337.78,
   "text": "هب لي، رو تک تک این کلمات وقتی دقت کنی خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.78,
   "end": 340.62,
   "text": "\"رب هب لي من لدنک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.62,
   "end": 343.4,
   "text": "ذرية طيبة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.4,
   "end": 345.8,
   "text": "إنك سميع الدعاء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 345.8,
   "end": 353.06,
   "text": "اولاً اسم رب رو به پا-- به کار می‌بره که حالا داری بچه میدی پرورشش هم با خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.06,
   "end": 357.14,
   "text": "هب لي، ببخش این بچه رو به من ببخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.14,
   "end": 360.92,
   "text": "یعنی آسون بگیر. جالبه من لدنک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.92,
   "end": 365.92,
   "text": "اونایی که میگن آقا نمیشه از هر راه طبیعی ما رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.92,
   "end": 368.86,
   "text": "اصلاً دکتر گفته شما عقیمی، اصلاً بچه دار نمیشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.86,
   "end": 370.82,
   "text": "اینجا میگه مل دن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.82,
   "end": 374.5,
   "text": "جالبه تو آیات سوره حضرت مریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.5,
   "end": 380.42,
   "text": "سلام الله علیها میفرماید که وشت خود حضرت زکریا توی باب زکرایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.42,
   "end": 382.52,
   "text": "فس زکرایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.52,
   "end": 384.66,
   "text": "عذر شود فصوص الحکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 384.66,
   "end": 389.06,
   "text": "شیخ اکبر هم اومده. اونجا میفرماید وشت علی الرأس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.06,
   "end": 391.36,
   "text": "شيبا. تو آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.36,
   "end": 394.38,
   "text": "حضرت زکریا میگه من موهام سفید شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 394.38,
   "end": 397.58,
   "text": "توی یک روایت استاد ما من اینو جایی ندیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 397.58,
   "end": 400.52,
   "text": "استادمون می فرمودن که صد و بیست سال داشته تو این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 400.52,
   "end": 406.96,
   "text": "تو این لحظه. ایشون خود حضرت زکریا صد و بیست سال داشته، خانومش نود و هشت سالش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.96,
   "end": 410.58,
   "text": "یعنی دیگه به حالت عقر رسیده بودن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.58,
   "end": 413.62,
   "text": "عاقرا که تو قرآن اومده یعنی بچه دار نمیشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.62,
   "end": 416.0,
   "text": "بله اگر بخوای به صورت طبیعی بری نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.0,
   "end": 420.22,
   "text": "اما میگه مل دن که شنیدید علم لدنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.22,
   "end": 422.22,
   "text": "هبلی خدا تو به من ببخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 422.22,
   "end": 424.5,
   "text": "امام رضا هم داره به کی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.5,
   "end": 427.68,
   "text": "پسر شبيب، ریان ابن شبيب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.68,
   "end": 429.92,
   "text": "خب اینو گفته که به من و تو برسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.92,
   "end": 433.26,
   "text": "میگه چطور از مل دن خدا غافلی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.26,
   "end": 435.58,
   "text": "هبلی مل دن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 435.58,
   "end": 438.3,
   "text": "بعد جالبه نمیگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 438.3,
   "end": 441.1,
   "text": "از جانب خودت به من فرزند بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 441.1,
   "end": 444.38,
   "text": "میگه ذریه. ذریه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 444.38,
   "end": 447.06,
   "text": "ور میاد. ور به یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 447.06,
   "end": 449.74,
   "text": "دیگه موجود بسیار کوچیکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 449.74,
   "end": 454.0,
   "text": "که اصلا قرار ندارد و به شدت فعال است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 454.0,
   "end": 456.92,
   "text": "که بعضا تو عربی به مورچه هم میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 456.92,
   "end": 458.9,
   "text": "خیلی بی قراره و خیلی فعاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 458.9,
   "end": 462.2,
   "text": "کوچیک هم هست. میگه به من ذریه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 462.2,
   "end": 467.62,
   "text": "ذریه ای که خیلی در راه تو بی قراره، فعاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 467.62,
   "end": 469.76,
   "text": "بعد ذریه یعنی نسل در نسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 469.76,
   "end": 471.88,
   "text": "نه این یه بچه ما بده بهش پز بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 471.88,
   "end": 475.46,
   "text": "نه. این نسل در نسل من رو ادامه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 475.46,
   "end": 481.18,
   "text": "اینا همش نکته است دیگه. بالاخره قرآن رمزی حرف زده، سری حرف زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 481.18,
   "end": 485.2,
   "text": "حالا باید بره تو باطنش دقت بکنه یا نه بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 485.2,
   "end": 488.2,
   "text": "ذریه تن از جانب خودت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 488.2,
   "end": 493.5,
   "text": "ببخشی. ذریه باشه باز تازه تاکید میکنه طیبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 493.5,
   "end": 497.16,
   "text": "پاک هم باشه. من از تو ذریه پاک میخوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 497.16,
   "end": 503.46,
   "text": "عجیبه ما اول که بچه میخوایم میگیم خیلی خوشگل باشه، خوش قد و بالا، خوش چشم و ابرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 503.46,
   "end": 507.6,
   "text": "اول طیبه. حالا بعد هرچی میخوای باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 507.6,
   "end": 513.3,
   "text": "بقیشم اشکال نداره دستور برای اونم دارن اهل بیت غصه نخور برای اون هرچی بخوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.3,
   "end": 519.44,
   "text": "دستور داره ما غافلیم. اینکه حتی بچت چشم و ابروش چه شکلی بشه، قدش چه جوری بشه، چه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.44,
   "end": 523.44,
   "text": "شونه‌هاش چگونه بشه. حتی تو باب مسائل معرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 523.44,
   "end": 526.44,
   "text": "میخوای حافظ قرآن باشه، میخوای عالم دین باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 526.44,
   "end": 529.72,
   "text": "میخوای حتی ورزشکار خوبی باشه، ق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 529.72,
   "end": 532.44,
   "text": "جثه خوبی داشته باشه، قو-- قدرت بدنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 532.44,
   "end": 534.54,
   "text": "یک یک اینا دستور داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 534.54,
   "end": 537.56,
   "text": "تو دستورات دین. که آقا این کارو بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 537.56,
   "end": 541.88,
   "text": "مثلا وقت مجامعت همسر، زن و ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 541.88,
   "end": 543.92,
   "text": "همسر این کارا رو بکنن. داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 543.92,
   "end": 548.78,
   "text": "حالا میتونید تو کتاب‌ها مراجعه کنید یا کتاب حیات طیبه هست یا کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 548.78,
   "end": 553.78,
   "text": "خدا رحمت کنه مرحوم فلسفی رحمة الله علیه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 553.78,
   "end": 558.28,
   "text": "نکته اینجاست که بعد خدا اینجا حضرت زکریا میفرماید انک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 558.28,
   "end": 563.82,
   "text": "سميع الدعاء. من دارم اینو به چه قورس و محکمی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 563.82,
   "end": 568.6,
   "text": "من دارم اینو از تویی می خوام که سميعی می تونست بگه تسمع الدعاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 568.6,
   "end": 571.62,
   "text": "تسمع الدعاء یعنی می شنوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 571.62,
   "end": 575.7,
   "text": "سامع یعنی شنونده. اما سامع می تونه خیلی موقع ها نشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 575.7,
   "end": 580.24,
   "text": "اصلا حوصله شنیدن نداشته باشه، وقت نداشته باشه، صدای شما بهش نرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 580.24,
   "end": 583.0,
   "text": "اما سمی صفت مشبهه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.0,
   "end": 587.32,
   "text": "یعنی صفت شنیدن مستکنه در وجود اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 587.32,
   "end": 589.38,
   "text": "دائما در حال شنیدن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 589.38,
   "end": 592.0,
   "text": "چرا اونم غافل باشه؟ رمز داره میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 592.0,
   "end": 600.98,
   "text": "قرآن داره کد میده. میگه اگه تو بت-- بخوای یه ذریه طیبه، اونم ذریه، اونم طیبه، اونم مل دن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 600.98,
   "end": 605.92,
   "text": "اونم ببخشه خدا هبه کنه خیلی سخت نگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 605.92,
   "end": 611.16,
   "text": "تو حساب کتابش. یعنی خ-- اسراری اینجا خوابیده تو همین آیه به این کوچولویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 611.16,
   "end": 613.9,
   "text": "پس سرش در اینه که میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 613.9,
   "end": 616.64,
   "text": "سميع الدعاء تو سميعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 616.64,
   "end": 619.98,
   "text": "مستکنه در وجودتو در ذاتتو شنیدن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 619.98,
   "end": 622.76,
   "text": "چرا غافلی از این ه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 622.76,
   "end": 626.64,
   "text": "موهبت الهی. بعد امام رضا میفرماید که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 626.64,
   "end": 629.14,
   "text": "ریان ها میگه چرا غافلی امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 629.14,
   "end": 631.52,
   "text": "که همین امروز تو محراب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 631.52,
   "end": 635.14,
   "text": "حضرت زکریا خ-- همچین درخواستی از خدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 635.14,
   "end": 641.78,
   "text": "بقیه آیه رو ببینید. فنادت الملائکه وهو قائم یصلی في المحراب ان الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 641.78,
   "end": 644.92,
   "text": "يبشرك بيحيى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 644.92,
   "end": 650.36,
   "text": "اونم میگه ان الله. نمیگه انه که برگرده اون ها به رب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 650.36,
   "end": 653.42,
   "text": "میگه ان الله اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 653.42,
   "end": 655.44,
   "text": "شریف جلاله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 655.44,
   "end": 657.86,
   "text": "مجمع جميع اسماء خدا با همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 657.86,
   "end": 663.04,
   "text": "اسماءش به تو رو کرده و يبشرك به تو بشارت میده بیحیى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 663.04,
   "end": 666.62,
   "text": "بعد بله چنین درخواستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 666.62,
   "end": 669.66,
   "text": "وقتی چنین درخواستی از خدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 669.66,
   "end": 677.14,
   "text": "سميع میکنی بله یحیایی رو بهش میده که مثل حضرت علی اکبر سر از تنش جدا میکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 677.14,
   "end": 683.9,
   "text": "و شهیدش میکنن و ذخیره قیامت میشود و ذریه حضرت زکریا هم از ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 683.9,
   "end": 688.7,
   "text": "انتقال پیدا میکنه. اینکه بخوام عرض کنم تو قضایای ذریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 688.7,
   "end": 693.58,
   "text": "و نسل طیبه و اینها همین یه آیه قرآن رو هم مورد بررسی قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 693.58,
   "end": 699.98,
   "text": "ببینید چقدر زوایای متعدد ازش در میاد و ما مورد امتحان هستیم و خواهیم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 699.98,
   "end": 704.16,
   "text": "تک تک ما از اون لحظه ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 704.16,
   "end": 709.34,
   "text": "قصد ازدواج کردیم تا قصد ت-تولید نسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 709.34,
   "end": 712.9,
   "text": "و و انگیزه مون از بچه دار شدن و تا قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 712.9,
   "end": 714.76,
   "text": "ان شاء الله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 714.76,
   "end": 718.02,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 718.02,
   "end": 725.5,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}