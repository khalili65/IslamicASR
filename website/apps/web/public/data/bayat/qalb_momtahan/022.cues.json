  {
   "index": 6,
   "title": "## پنجاه روز پیش از واقعهٔ کوچه",
   "start": 784.42,
   "end": 1026.22
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.38,
   "end": 5.54,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.54,
   "end": 9.08,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.08,
   "end": 13.78,
   "text": "آیاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.78,
   "end": 17.22,
   "text": "شب شهادت امام عسکری سلام الله علیه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.22,
   "end": 20.26,
   "text": "بحث ما اگرچه پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.26,
   "end": 22.94,
   "text": "قلب ممتحن بود اما بی‌ارتباط هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.94,
   "end": 27.04,
   "text": "می‌دونید یکی از امامانی که خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.04,
   "end": 30.8,
   "text": "زود به امامت رسید خود امام عصر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.8,
   "end": 35.46,
   "text": "بعد از شهادت حضرت امام عسکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.46,
   "end": 42.92,
   "text": "دیگه میشه گفت جوان‌ترین امام ما که به امامت رسیده خود امام زمان ماست و این یک امتحان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.92,
   "end": 46.64,
   "text": "بزرگی بود که شیعه اون موقع پس داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.64,
   "end": 51.72,
   "text": "در زمان امام جواد سلام الله علیه به گونه‌ای در زمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.72,
   "end": 59.68,
   "text": "اصلاً قبل از تولد امام جواد که امام رضا خدا بهش بچه نمی‌داد امتحانی بود پس دادن شیعیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.68,
   "end": 66.22,
   "text": "و یک سری که زیارت امام رضا از زیارت پیغمبر هم حتی بالاتر ثوابش همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.22,
   "end": 72.28,
   "text": "به هر حال کسایی میرن زیارت امام رضا که پذیرفتن دیگه اثنا عشری امامت‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.28,
   "end": 77.62,
   "text": "و همچنین خصوصاً پیرامون امام عصر چون باز امام عصر بعدش به غیبت رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.62,
   "end": 82.72,
   "text": "اصلاً شیعه چیزی به نام غیبت نمی‌شناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.72,
   "end": 85.26,
   "text": "و این رو اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.26,
   "end": 87.52,
   "text": "ندیده بود، تجربه نکرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.52,
   "end": 90.52,
   "text": "یه دفعه امامش رو دیگه نبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.52,
   "end": 95.4,
   "text": "به توسط یک عده‌ی خاصی فقط نامه رد و بدل بشه رؤیتی نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.4,
   "end": 102.64,
   "text": "این‌ها خیلی حتی اون نواب اربعه همینطور نبود که هر وقت بخوان حضرت رو ببینن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.64,
   "end": 105.52,
   "text": "و بسیاری از ارتباطات‌شون با نامه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.52,
   "end": 108.66,
   "text": "اینطور نبود که هر وقت خواستن بتونن حضرت رو ببینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.66,
   "end": 112.28,
   "text": "این‌ها مجموعاً امتحانات عجیبی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.28,
   "end": 114.86,
   "text": "که شیعه الحمد لله سر بلند بیرون اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.86,
   "end": 121.88,
   "text": "یعنی بعد از ما حتی در خص-- خصوص امام جواد و حتی امام عصر ما، ما انشقاقی نمی‌بینیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.88,
   "end": 123.62,
   "text": "بعد از اون بخواد چند دستگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.62,
   "end": 129.42,
   "text": "دو دستگی چیزی ایجاد بشه و تا امام رضا رو کسی قبول کرد دیگه تمومه تا امام عصر رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.42,
   "end": 133.24,
   "text": "یک امتحان بزرگی بود که شیعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.24,
   "end": 135.4,
   "text": "الحمد لله ازش سر بلند بیرون اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.4,
   "end": 140.4,
   "text": "یک بحث وقت ظهور و حضور امام است، یک وقت هم بعد از اون ایام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.4,
   "end": 144.98,
   "text": "یعنی کسانی که اون ایام رو درک کردن به گونه‌ای امتحان پس دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.98,
   "end": 153.28,
   "text": "کسایی هم که بعداً مثل من و شما وقایع ایام رو می‌شنوند و می‌بینند و با تاریخ مرتبط می‌شن، این‌ها هم به گونه‌ای در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.28,
   "end": 160.18,
   "text": "امتحان‌اند. مثل اینکه الان می‌بینیم متاسفانه بین مذهبی‌ها این امتحانات الان خدا داره می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.18,
   "end": 163.48,
   "text": "این چنینه دیگه. می‌بینیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.48,
   "end": 166.6,
   "text": "متاسفانه دو فرقه‌اند الان مذهبی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.6,
   "end": 169.24,
   "text": "عده‌ای هنوز لباسای عزاشون رو درنیاوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.24,
   "end": 176.24,
   "text": "حالا امشب که شهادت پدر امام عصره خب می‌طلبه انسان مشکی بپوشه عزادار باشه فقط امشب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.24,
   "end": 180.28,
   "text": "اما دیگه بعد از ر-- همون اوایل ربیع می‌بینید اینطوری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.28,
   "end": 183.62,
   "text": "بعضیا ادامه میدن تا چندین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.62,
   "end": 191.04,
   "text": "شب عزاداری می‌کنند و معتقدند که ایام محسنیه است و وقایع ایام رو اصلاً نرفتن بررسی کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 191.04,
   "end": 195.0,
   "text": "صرفاً از زبان این و اون و گوش این و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.0,
   "end": 198.12,
   "text": "حالا یا کتاب هم حتی مطالعه نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.12,
   "end": 206.68,
   "text": "فلانی از گوش فلانی، تو گوش فلانی خونده، اون رفته به این گفته همینطوری سینه به سینه گوش به گوش رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 206.68,
   "end": 209.32,
   "text": "اصلاً نرفته بررسی کنه آقا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 209.32,
   "end": 211.64,
   "text": "اتفاقی که الان این حرفی که رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.64,
   "end": 216.28,
   "text": "زبان بچه هیئتی‌هاست که سه روز اول ماه ربیع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 216.28,
   "end": 220.42,
   "text": "اتفاقه، یعنی وقایع کوچه رخ داده اصلاً با عقل جور در میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.42,
   "end": 223.78,
   "text": "شما به استناد چه تاریخی داری اینو میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.78,
   "end": 228.42,
   "text": "وقتی بررسی می‌کنی می‌بینی هیچ کدوم از مستندات تاریخی این رو بررسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.42,
   "end": 235.48,
   "text": "می‌کنی می‌بینی قبول نمی‌کنن. حالا من نمی‌دونم این‌ها چ-- طبق چه روشی، چه الگویی، الگو اینا اصلاً کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 235.48,
   "end": 237.4,
   "text": "بعضا می‌بینیم علمدار هم هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.4,
   "end": 240.88,
   "text": "یه هیئت گنده‌ای هم تحت الامر این‌هان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.88,
   "end": 245.2,
   "text": "یعنی حتی نکرده به خودش زحمت بده یه کتاب وقایع الايام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.2,
   "end": 247.76,
   "text": "شهاب واسقری رو بخونه بعد حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.76,
   "end": 251.16,
   "text": "همینجوری شروع می‌کنه یه دم دنبال سر خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.16,
   "end": 254.52,
   "text": "بعد اسلام تهمت می‌کنه به دین گریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.52,
   "end": 257.86,
   "text": "که اینا فقط گه-- هفتاد شبه دارن گریه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.86,
   "end": 260.76,
   "text": "پس شادیشون کجاست؟ این‌ها اصلاً خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.76,
   "end": 263.96,
   "text": "بله. یه عزیزی هم اومد به ما گفتش که حضرت مع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.96,
   "end": 267.14,
   "text": "از آقای وحید از آقای فاضل، کی، کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.14,
   "end": 270.5,
   "text": "مراجع توصیه هست که محسنیه عزاداری کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.5,
   "end": 273.76,
   "text": "حالا اونم نه دهه بگیرن. دهه فقط نص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.76,
   "end": 275.38,
   "text": "صریح در خصوص عاشورا داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 275.38,
   "end": 279.14,
   "text": "حتی فاطمیه هم ما دهه نص نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.14,
   "end": 281.7,
   "text": "حالا عزاداری کنن. خب درست، این حرف درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.7,
   "end": 283.32,
   "text": "اما اینکه محسنیه کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.32,
   "end": 287.0,
   "text": "این مسئله‌ست. رو چه استنادی شما میگید الان محسنیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.0,
   "end": 291.02,
   "text": "من چند تا مطلب رو به صورت تاریخی برای شما خیلی گذرا بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.02,
   "end": 297.06,
   "text": "این خودش چند تا منبر می‌طلبه که اینا تبیین بشه، وقایع گفته بشه، داستان‌ها زیر و رو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.06,
   "end": 299.9,
   "text": "من سریع عناوینشون میگم میرم توضیح هم خیلی نمیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.9,
   "end": 303.36,
   "text": "ببینید اصلاً شما عقلتون رو قاضی کنید به قولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.36,
   "end": 305.88,
   "text": "میشه این‌ها تو سه روز اتفاق بیفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.88,
   "end": 309.78,
   "text": "اصلاً نه تو ده روز، تو ده روز اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.78,
   "end": 312.38,
   "text": "خود شهادت پیغمبر چه موجی ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.38,
   "end": 315.36,
   "text": "بعد قصه غسل دادن پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.36,
   "end": 320.14,
   "text": "که امیرالمؤمنین تنهایی تنها انجام میدن، کفن کردن‌شون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.14,
   "end": 322.86,
   "text": "نماز خوند پیغمبر که روایت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.86,
   "end": 327.02,
   "text": "اکثریت این‌هایی که مدعی هستن حتی اون خلیفه ها نبودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 327.02,
   "end": 332.82,
   "text": "تو نماز پیغمبر نبودن. در حالی که پیغمبر تصریحاً می‌گفت تا مرده طرف از دنیا رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.82,
   "end": 339.62,
   "text": "سریع حتی تو روایات دیدیم طرف لباس جنگ تنش بوده داشته می‌رفته جنگ می‌رفته نماز با لباس و زره و خُود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 339.62,
   "end": 343.54,
   "text": "نمازشو می‌خوند و می‌رفته. براشون مهم بوده سریع نماز میت رو بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.54,
   "end": 345.82,
   "text": "اما پیغمبر نه. اصلاً نبودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.82,
   "end": 348.68,
   "text": "کجا بودن؟ به کدوم درکی رفته بودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.68,
   "end": 352.14,
   "text": "عده‌ای تو سقیفه، عده‌ای هم بی‌خبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.14,
   "end": 355.34,
   "text": "خود این یه قصه‌ست. ابن عسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.34,
   "end": 358.84,
   "text": "و از شب ابن حجر عسقلانی این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.84,
   "end": 362.42,
   "text": "تواریخ اهل تسنن رو آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 362.42,
   "end": 368.04,
   "text": "می‌گن که ابوبکر توی اون ایام حتی خود ابوبکر هم تو مدینه نبود رفته بود منزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.04,
   "end": 373.0,
   "text": "همسرش به نام حبیبه بنت خارجه در منطقه‌ای به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.0,
   "end": 376.62,
   "text": "صنح در بیرون از منی-- مدینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.62,
   "end": 379.32,
   "text": "اونجا بود بعد خبر شد سوار اسب شد و اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.32,
   "end": 382.62,
   "text": "یعنی خود اون هم اون لحظات نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.62,
   "end": 389.3,
   "text": "بعد قصه تشکیل خ-- سقیفه است که بلافاصله سقیفه تشکیل می‌شه شروع می‌کنن اخذ بیعت از مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.3,
   "end": 393.7,
   "text": "تو تاریخ طبری و همچنین شیخ مفید مطالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.7,
   "end": 396.96,
   "text": "زیرا-- زیادی رو اینجا آوردن که چه اتفاقاتی می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.96,
   "end": 401.98,
   "text": "قبیله مثلاً قبیله‌ی ابی اسلم یا بنی اسلم ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.98,
   "end": 404.02,
   "text": "اینا از اعراب خارج مدینه بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.02,
   "end": 407.86,
   "text": "میان وارد همون حالا بعد از شهادت پیغمبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.86,
   "end": 410.42,
   "text": "قصه سقیفه بعد از سقیفه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 410.42,
   "end": 416.82,
   "text": "این، این، این داستانی که میگم تازه سقیفه هم انجام شده تموم شده بیعت گرفتن وارد شهر میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.82,
   "end": 420.4,
   "text": "انقدر اینا می-- اومده بودن آذوقه‌شون رو از مدینه کسب کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.4,
   "end": 426.62,
   "text": "انقدر تعدادشون زیاد بود که میگن کوچه‌های مدینه مملو می‌شه از ب-- قبیله‌ی بنی اسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.62,
   "end": 431.56,
   "text": "بعد دومی شرایط رو خوب می‌بینه میره به اینا میگه در صورتی اجناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.56,
   "end": 434.48,
   "text": "شما رو تامین می‌کنیم که برید با ابوبکر بیعت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.48,
   "end": 437.22,
   "text": "به زور اینا رو به طمع دنیا به ع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.22,
   "end": 441.58,
   "text": "به جمعیت کثیر بسیار زیادی شروع می‌کنن همینطوری به طمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.58,
   "end": 445.4,
   "text": "چی؟ گرفتن جنسشون. اصلاً کاری ندارن خلیفه کیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.4,
   "end": 450.62,
   "text": "میرن بیعت می‌کنن. خود این یه مسئله‌ست که چقدر زمان به خودش اختصاص داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.62,
   "end": 454.8,
   "text": "تجمع برخی از طرفداران اهل بیت به روایت ابن ابی الحدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 454.8,
   "end": 457.1,
   "text": "که مثل مثلاً برا ابن عازب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.1,
   "end": 459.48,
   "text": "مقداد، سلمان، ابوذر، عمار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.48,
   "end": 463.12,
   "text": "حذیفه، ابو هیثم، عباده ابن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.12,
   "end": 465.52,
   "text": "ثابت. این‌ها جمع می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 465.52,
   "end": 467.48,
   "text": "یک تجمع اعتراضی راه می‌ندازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.48,
   "end": 471.08,
   "text": "اینطوری نیست که حالا اونا غصب کنن بعد اینا هم بشینن بر رو بر نگاه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.08,
   "end": 475.32,
   "text": "بین این‌ها نزاع‌ها صورت می‌گیره، مناظره‌ها صورت می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.32,
   "end": 477.52,
   "text": "بینشون کتک‌کاری می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.52,
   "end": 479.96,
   "text": "حالا این‌ها بماند. یا بیعت خود حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 479.96,
   "end": 484.54,
   "text": "اینا همه اینایی که من دارم میگم قبل از وقایع کوچه اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.54,
   "end": 488.28,
   "text": "حالا شما برای اینا یه روز، دو روز، سه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.28,
   "end": 491.3,
   "text": "برای بعضیاش حتی ده روز باید زمان بذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.3,
   "end": 497.3,
   "text": "بیعت حضرت زهرا به اتفاق امیرالمؤمنین و حسنین از چهل و چهار نفر از صحابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.3,
   "end": 501.74,
   "text": "مهاجرین و انصار که هر شب حضرت می‌رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.74,
   "end": 507.22,
   "text": "و بیعت می‌گرفته. مال قبل از وقایع کوچه هم هست که حضرت سالم بوده بدنشون می‌رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 507.22,
   "end": 515.26,
   "text": "خود این چند روز رو شو-- به خودشون ت- طبری میگه سلیم ابن قیس می-- یا سلیم بعضیا گفتن اما درستش سلیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 515.26,
   "end": 520.66,
   "text": "روایت آوردن که میره. چهار روز حداقل من نگاه کردم کمترین تاریخی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 520.66,
   "end": 525.1,
   "text": "ارائه دادن پیرامون جمع‌آوری قرآن توسط امیرالمؤمنین چهار روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 525.1,
   "end": 528.18,
   "text": "چهار روز مولا می‌شینه تو خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 528.18,
   "end": 530.54,
   "text": "و جمع‌آوری قرآن می‌کنه با تأویل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.54,
   "end": 533.08,
   "text": "یعنی با بد-- بوتون قرآن، بوتون آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 533.08,
   "end": 536.62,
   "text": "وقتی میاره تو مسجد ارائه میده اون ملعون‌ها قبول نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 536.62,
   "end": 543.42,
   "text": "میگن حسبنا کتاب الله بس‌مونه همین کتاب و دست ما رو کوتاه می‌کنن متأسفانه از اون حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 543.42,
   "end": 546.0,
   "text": "باطن قرآن. یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 546.0,
   "end": 552.16,
   "text": "طبری میگه، ابن جوزی میگه، ابن کثیر میگه، نویری میگه این‌ها از تواریخ مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 552.16,
   "end": 556.32,
   "text": "یا مثلاً اه-- علمای کبار، علمای اهل تسنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 556.32,
   "end": 563.28,
   "text": "بسیار روایت تو اهل تسنن داریم که حرکت لشکر اسامه رو وقتی بیان می‌کنن عزیزان دل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.28,
   "end": 567.7,
   "text": "این لشکر اسامه رو حالا خیلی براش تحلیل‌ها ارائه دادن که می‌فرسته--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.7,
   "end": 573.74,
   "text": "ابوبکر اینا رو می‌فرسته با بیشترین از مردان مدینه است مدینه رو خالی می‌کنه خودش می‌مونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 573.74,
   "end": 577.84,
   "text": "و عمر و یه چند نفر دیگه بقیه رو می‌فرسته برن بیرون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 577.84,
   "end": 581.82,
   "text": "مدینه توی منطقه‌ای خارج از شهر مدینه به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 581.82,
   "end": 587.24,
   "text": "جرف. اونجا متوقف می‌شن که حالا مثلاً شهر رو از وقایع اتفاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 587.24,
   "end": 591.88,
   "text": "و خطر هجوم بالاخره دشمن مثلاً پیغمبر شهید شده اونا اونجا برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 591.88,
   "end": 595.7,
   "text": "به این بهانه برن اونجا جمع شن مراقب شهر باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 595.7,
   "end": 599.82,
   "text": "این رفت و برگشت این لشکر خود این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 599.82,
   "end": 608.7,
   "text": "چقدر زمان برده که حداقل تو تواریخ من دیدم کمترین تاریخی برای این اختصاص دادن که همه این رفت و برگشت لشکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 608.7,
   "end": 611.84,
   "text": "پیش از اتفاق کوچه رخ داده چهل روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 611.84,
   "end": 614.96,
   "text": "چهل روز دیگه کمتر ما برای این تو تاریخ نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 614.96,
   "end": 620.72,
   "text": "تا هفتاد روز هم روایت دیدم که حالا هر کدوم از این راوی‌هایی که من اسمشون رو آوردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 620.72,
   "end": 623.54,
   "text": "یه عددی رو دادن. کمترین‌شون چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 623.54,
   "end": 627.64,
   "text": "چهل روز بود که جالبه که تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 627.64,
   "end": 630.74,
   "text": "برای حالا اینا وقتی که میرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 630.74,
   "end": 635.96,
   "text": "عمر شروع می‌کنه بین ابوبکر شروع می‌کنه به بهانه‌ی حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 635.96,
   "end": 640.18,
   "text": "پول دادن به این زن‌هایی که مرداشون رفتن سفر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 640.18,
   "end": 643.54,
   "text": "به اینا شروع می‌کنه پول دادن. اون خودش چقدر زمان می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 643.54,
   "end": 647.14,
   "text": "بالاخره از خزینه‌ی بیت‌المال به اینا پول می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 647.14,
   "end": 650.86,
   "text": "زن‌هایی که مرداشون رفتن مثلاً بیرون از شهر مدینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 650.86,
   "end": 653.24,
   "text": "چقدر اینا از زن‌ها تعدادشون زیاد بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 653.24,
   "end": 655.62,
   "text": "البته خب بعضیا تحلیلش اینه برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 655.62,
   "end": 664.2,
   "text": "محکم کردن پایه‌های حکومت این کارو کرد که در حقیقت غیرمستقیم از زن‌های این‌ها هم بیعت بگیره برای حکومت خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 664.2,
   "end": 666.84,
   "text": "که ابن ابی الحدید توی این قصه حرف زیاد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 666.84,
   "end": 671.24,
   "text": "می‌تونید برید ببینید. ایشون اس-- ایشون تحلیلش ثبات حکومته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 671.24,
   "end": 674.14,
   "text": "اولیه. دیگه عرض کنم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 674.14,
   "end": 680.64,
   "text": "ز-زمان حداقل شما بگم حداقل تو تاریخ دیدم ده روز گفتن به این اختصاص دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 680.64,
   "end": 683.44,
   "text": "به چی؟ تصرف امکاناتی که تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 683.44,
   "end": 686.46,
   "text": "مالکیت اهل بیت علیهم السلام بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 686.46,
   "end": 693.56,
   "text": "مثل مثلاً فدک یا عرض شود اون باغی که مال امیرالمؤمنین علیه السلام بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 693.56,
   "end": 697.26,
   "text": "که یه جزو صدقات روستاهای اطراف بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 697.26,
   "end": 700.98,
   "text": "مزرعه بانقیا اینا مال امیرالمؤمنین بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 700.98,
   "end": 706.08,
   "text": "سی نفر رو ابوبکر مأمور می‌کنه با یه نفر اتفاقاً سرکرده‌شون که تو چیزی بوده که توسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 706.08,
   "end": 707.7,
   "text": "مولا تو یه جنگ کشته شده بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 707.7,
   "end": 710.4,
   "text": "اینا همش-- اینا نکته‌های مهم تاریخیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 710.4,
   "end": 712.48,
   "text": "می‌دونسته کیو حتی بفرسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 712.48,
   "end": 714.46,
   "text": "اینا میرن اون مزرعه رو غصب می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 714.46,
   "end": 716.88,
   "text": "محصولات خیبر رو غصب می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 716.88,
   "end": 719.0,
   "text": "خمس‌هایی که خیلی جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 719.0,
   "end": 723.46,
   "text": "کنار گذاشته بودن، صدقات، وجوهات و فی نمی‌دونم این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 723.46,
   "end": 728.8,
   "text": "کنار گذاشته بودن به دست امیرالمؤمنین و اهل بیت پیغمبر برسونن و همه رو میرن می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 728.8,
   "end": 733.56,
   "text": "ده روز حداقل این‌ها تو تاریخ برای این‌ها زمان گذاشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 733.56,
   "end": 737.76,
   "text": "عرض شود خدمتتون. حالا یه روایتی هم از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 737.76,
   "end": 744.16,
   "text": "عرض کنم خدمت شما خوبان از طبرسی، طبرسی خودمون مرحوم شیخ طبرسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 744.16,
   "end": 751.16,
   "text": "داره از ابان بن تقلب از امام صادق صلوات الله علیه که میگه تازه وقتی که اسامه برگشت اینم خودش یک نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 751.16,
   "end": 755.54,
   "text": "حالا بگو چهل روز حداقل تا هفتاد روز گفتیم گفتن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 755.54,
   "end": 763.22,
   "text": "میگه اسامه، بریده و یازده نفر تازه شروع به مخالفت کردن و هنوزم اتفاق کوچه رخ نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 763.22,
   "end": 766.0,
   "text": "شروع به مخالفت کردن. اینطور نبود که آروم بشینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 766.0,
   "end": 769.54,
   "text": "گفتن تا علی علیه الصلاة والسلام بیعت نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 769.54,
   "end": 774.32,
   "text": "ما بیعت نمی‌کنیم. و اون موقع هنوز تو کوچه خبری نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 774.32,
   "end": 777.76,
   "text": "بعد از اون تازه باز خیلی اتفاقات دیگه‌ای میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 777.76,
   "end": 781.74,
   "text": "اون قصه رفتن حضرت زهرا هر روز، هر هفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 781.74,
   "end": 785.42,
   "text": "حداقلی که تو تاریخ اومده در هفته دو روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 785.42,
   "end": 788.1,
   "text": "دوشنبه یا پنجشنبه یا دوشنبه یا جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 788.1,
   "end": 791.42,
   "text": "حداقل بعضیا تو تاریخ گفتن هر روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 791.42,
   "end": 793.26,
   "text": "خانم می‌رفته از مدینه تا اهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 793.26,
   "end": 799.46,
   "text": "اینایی که مکه رفتن می‌دونن چقدر مسافته از مدینه تا اهد، از مکه تا اهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 799.46,
   "end": 804.06,
   "text": "چقدر از، ببخشید تا اهد از شهر مدینه تا اهد چقدر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 804.06,
   "end": 809.14,
   "text": "حالا من نرفتم. حالا نه از تاریخ هم در نیاوردم چند کیلومتره اما خیلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 809.14,
   "end": 812.08,
   "text": "کسایی که رفتن شما می‌دونین؟ حدود ده کیلومتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 812.08,
   "end": 815.08,
   "text": "حدود ده کیلومتر. از مدینه تا کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 815.08,
   "end": 818.36,
   "text": "اهد. یعنی تا جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 818.36,
   "end": 820.52,
   "text": "حضرت کی شهید شده؟ حمزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 820.52,
   "end": 824.62,
   "text": "چون حالا اینم خودش قصه‌ست که چرا حضرت زهرا می‌رفتن زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 824.62,
   "end": 830.98,
   "text": "حضرت حمزه. چون حضرت زهرا که خب برای همه ما مسجل بالاترین مقامش از حضرت حمزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 830.98,
   "end": 835.68,
   "text": "این زیارت سید الشهدا رو اینجا حضرت زهرا پایگذاری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 835.68,
   "end": 839.78,
   "text": "اصلاً م-- اربعین ما زیارت سید الشهداي کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 839.78,
   "end": 842.26,
   "text": "پایہ‌گذاری‌ش با حضرت زهرا بوده. در هر حال کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 842.26,
   "end": 845.2,
   "text": "شما بفرمایید. ایشون فرمودن الان ده کیلومتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 845.2,
   "end": 850.4,
   "text": "این ده کیلومتر کمتر بیشتر چجوری میشه یک خانم مضروبه، مقصوبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 850.4,
   "end": 854.64,
   "text": "مستعده تحت فشاری که دست به دیوار می‌گرفته بره هر روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 854.64,
   "end": 856.76,
   "text": "حالا باید بگیم هفته‌ای دو بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 856.76,
   "end": 859.34,
   "text": "میشه؟ اصلاً این شدنیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 859.34,
   "end": 861.94,
   "text": "با این‌ها نمیشه هرچی فکر می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 861.94,
   "end": 864.0,
   "text": "دو تا روایت براتون بخونم و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 864.0,
   "end": 867.48,
   "text": "چون قرار بود ما اختصار داشته باشه صحبت‌هامون که بتونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 867.48,
   "end": 871.54,
   "text": "بعداً به کسای دیگه هم بدید احتجاج کنید با این‌ها باهاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 871.54,
   "end": 874.24,
   "text": "یکی قصه بیعت خواهی مجدد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 874.24,
   "end": 877.62,
   "text": "مجدد ابوبکر از مولاست که دوباره بیعت خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 877.62,
   "end": 880.82,
   "text": "بعضی‌ها گفتن تا سه بار بیعت خواست مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 880.82,
   "end": 882.82,
   "text": "قبول نکردن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 882.82,
   "end": 886.66,
   "text": "سلیم ابن قیس این مدت بیعت خواهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 886.66,
   "end": 891.12,
   "text": "سه‌گانه ابوبکر از امیرالمؤمنین رو پنجاه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 891.12,
   "end": 895.0,
   "text": "فرض کرده. یه روایت دیگه هم داریم که اصلاً امیرالمؤمنین وقتی دیگه دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 895.0,
   "end": 899.2,
   "text": "زورش به اینا نمی‌رسه و اینا الا بالله میگن بیعت کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 899.2,
   "end": 901.3,
   "text": "یارخواهی کرد، طلب یار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 901.3,
   "end": 904.24,
   "text": "مثل اون که سه شب رفتن با حضرت زهرا در خانه own.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 904.24,
   "end": 906.64,
   "text": "اصلاً حلم ناصر به گونه‌ای گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 906.64,
   "end": 911.46,
   "text": "یارطلبید. اینطوری نیست که بشینه تو خونه بگه خب دیگه دست و پای منو ببندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 911.46,
   "end": 914.4,
   "text": "که آخر سر نیامدند و نیامدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 914.4,
   "end": 922.2,
   "text": "در نهایت روایتی که از شیخ صدوق داریم، دیگه شیخ صدوق می‌دونید به دعای امام عصر به دنیا اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 922.2,
   "end": 924.22,
   "text": "و کتاب تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 924.22,
   "end": 929.08,
   "text": "کمال الدین و تمام نعمتش رو به روا-- به توصیه امام عصر نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 929.08,
   "end": 931.38,
   "text": "عالم بسیار شریفی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 931.38,
   "end": 937.0,
   "text": "ایشون معتقدن حدود پنجاه روز بعد از رحلت پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 937.0,
   "end": 943.22,
   "text": "اینا تو مسجد تجمع کردن و تازه افکار عمومی رو آماده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 943.22,
   "end": 946.32,
   "text": "یعنی تازه پنجاه روز بعد از چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 946.32,
   "end": 950.12,
   "text": "رحلت پیغمبر. یعنی هنوز قصه کوچه رخ نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 950.12,
   "end": 954.26,
   "text": "مرحوم کلینی در خصوص رفت و آمد حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 954.26,
   "end": 956.36,
   "text": "مطالبی گفته که دیگه فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 956.36,
   "end": 962.32,
   "text": "مصباح الانوار از امام باقر که بهار مرحوم مجلسی از این مصباح الانوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 962.32,
   "end": 965.12,
   "text": "روایت آورده. میگه بیماری خانم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 965.12,
   "end": 966.92,
   "text": "ببینید این روایت از امام باقره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 966.92,
   "end": 971.24,
   "text": "کی آورده؟ مرحوم مجلسی به نقل از مصباح الانوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 971.24,
   "end": 975.98,
   "text": "میگه پنجاه روز بعد از شهادت پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 975.98,
   "end": 978.32,
   "text": "بیماری حضرت زهرا شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 978.32,
   "end": 982.22,
   "text": "حالا هرچی بوده اون تازه پنجاه روز بعد از شهادت شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 982.22,
   "end": 987.51,
   "text": "یعنی واقعه کوچه حداقل یعنی شما کمترین تاریخ رو بخوای اختصاص بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 987.51,
   "end": 992.06,
   "text": "پنجاه روز بعده. یه روایت دیگه هست‌ها من زیاد جمع‌ورکیم و فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 992.06,
   "end": 997.36,
   "text": "میگه اصلاً در ربیع الثانی این اتفاق میفته، نه ربیع الاول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 997.36,
   "end": 1001.82,
   "text": "صراحتاً روایت داریم این اتفاق کوچه در، در ربیع الثانی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1001.82,
   "end": 1009.4,
   "text": "مجموعه این‌ها این رو نشون میده که متأسفانه عده‌ای از بدشذولایه و هیئتی ما دارن افراط می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1009.4,
   "end": 1012.38,
   "text": "و توجه به این وقایع الايام ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1012.38,
   "end": 1016.2,
   "text": "و در امتحانات الهی دارن نمره‌شونو از دست میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1016.2,
   "end": 1018.06,
   "text": "انشاالله عاقبت ما ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1018.06,
   "end": 1021.14,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1021.14,
   "end": 1026.22,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}