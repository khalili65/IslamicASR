 "chapters": [
  {
   "index": 0,
   "title": "## وقف موقت و عدم تحقق مسجدیت",
   "start": 12.98,
   "end": 83.16
  },
  {
   "index": 1,
   "title": "## امتحان نسبت به ایام الله و وقایع الایام",
   "start": 83.16,
   "end": 131.46
  },
  {
   "index": 2,
   "title": "## تعظیم ماه ربیع و خروج از عزا",
   "start": 131.46,
   "end": 368.42
  },
  {
   "index": 3,
   "title": "## شهادت به الوهیت و عبودیت پیامبر",
   "start": 368.42,
   "end": 768.68
  },
  {
   "index": 4,
   "title": "## وقایع الایام؛ از تحقیق تا تحقق",
   "start": 768.68,
   "end": 829.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.44,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.44,
   "end": 7.02,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.02,
   "end": 12.98,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.98,
   "end": 15.82,
   "text": "در ادامه احکام وقف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.82,
   "end": 20.76,
   "text": "استفتایی شده از رهبر عزیزمون که اگر چنانچه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.76,
   "end": 24.12,
   "text": "یک محلی رو به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.12,
   "end": 32.82,
   "text": "دائم نه، موقت وقف مثلا مسجد کنه بگه به عنوان نمونه ده سال این محل مسجد باشه بعد دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.82,
   "end": 39.56,
   "text": "ده تحت تملک واقف در بیاد بعد از ده سال مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.56,
   "end": 45.84,
   "text": "آیا این وقف جایزه؟ رهبر عزیز می فرمایند اصلا نخیر یه همچین چیزی نمیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.84,
   "end": 48.52,
   "text": "و اونجا اون مکان اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.52,
   "end": 52.94,
   "text": "م-مسجدیتش با این نوع وقف اثبات نمیشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.94,
   "end": 57.1,
   "text": "زمان برنمیداره. البته میشه برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.1,
   "end": 63.72,
   "text": "نماز اونجا رو حبس کرد برای خوندن نماز اونجا رو حبس کرد و بگه آقا اونجا مخصوص نماز خوندنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.72,
   "end": 68.24,
   "text": "اما مسجد نه. نمیشه یک جایی رو موقت مسجد کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.24,
   "end": 72.08,
   "text": "یا موقت سیقه حسینیه خوند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.08,
   "end": 80.8,
   "text": "حسینیه کرد بگیم چند وقت بعد مثلا پنج سال، ده سال، سی سال بعد برگرده به تحت تملک واقفش نمیشه اینچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.8,
   "end": 85.56,
   "text": ". اما خب بحث ما اگرچه پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.56,
   "end": 91.34,
   "text": "قلب ممتحن بود و اینکه ما تحت امتحان الهی هستیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.34,
   "end": 97.4,
   "text": "امروز در زیل همین عنوان دو سه تا نکته خیلی مهم که باهاش برخورد داریم می‌کنیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.4,
   "end": 100.02,
   "text": "عرض کنیم که این‌ها رو خوب توجه کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.02,
   "end": 104.9,
   "text": "و انشاالله به هر کی رسیدید امروز بگید حداقل به خونواده‌های خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 104.9,
   "end": 111.56,
   "text": "چون ما یکی از جاهایی که داریم باهاش امتحان میشیم نسبت به ایامه که قبلاً بحثش گذشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 111.56,
   "end": 113.5,
   "text": "نسبت به ایام الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.5,
   "end": 116.96,
   "text": "نسبت به شهر الله، این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.96,
   "end": 121.18,
   "text": "یا اعیاد شهادت‌ها، این‌ها ما در حال امتحانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 121.18,
   "end": 123.46,
   "text": "یکی دیگه از امتحانات پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.46,
   "end": 125.4,
   "text": "وقایع الايام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.4,
   "end": 130.6,
   "text": "وقایع الايام. ما داریم امتحان پس میدیم که آیا نسبت به این وقایع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.6,
   "end": 135.36,
   "text": "آیا اهل تحقیق و پژوهش هستیم که بدونیم چگونه عمل کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.36,
   "end": 138.4,
   "text": "این خودش یک امتحانه الان ما روز اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.4,
   "end": 145.06,
   "text": "ماه ربیع رو شروع کردیم در حالی که شاید توجه نداریم چه اتفاقی داره میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.06,
   "end": 148.84,
   "text": "اصلاً ما ورود به چه ماهی کردیم و از چه ماهی خارج شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.84,
   "end": 151.88,
   "text": "همش گوشمون به دهان مردمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.88,
   "end": 154.06,
   "text": "اینکه مردم چه می‌گویند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.06,
   "end": 156.22,
   "text": "فضاهای مجازی چه می‌گویند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.22,
   "end": 162.02,
   "text": "اصلاً اینکه در امتحانش انسان صفره که هستند، نمره‌ای هم نمیاره اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.02,
   "end": 164.82,
   "text": "این چه نوع امتحان پس دادنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.82,
   "end": 171.4,
   "text": "که والباب المبتلی به الناس اون بابی که ما بهش مبتلا میشیم و امتحان میشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.4,
   "end": 175.86,
   "text": "همین ایام‌اند و حدیث داریم ایام خود ماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.86,
   "end": 178.1,
   "text": "ما اهل بیت اون ایامیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.1,
   "end": 181.48,
   "text": "که حالا این کلاً بماند این بحثش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.48,
   "end": 186.42,
   "text": "دو سه تا نکته عرض کنم که این‌ها مهم است که یعنی چی ما الان در معرض امتحانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.42,
   "end": 189.52,
   "text": "اولاً سؤال میشه امروز ما باید بالاخره چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.52,
   "end": 191.94,
   "text": "تبریک بگیم، به هم نگیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.94,
   "end": 195.1,
   "text": "عزاداری کنیم، چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.1,
   "end": 202.32,
   "text": "در حالی که اگر اهل پژوهش و تحقیق باشیم می‌بینیم که کتاب‌های بزرگان ما امثال المراقبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 202.32,
   "end": 205.64,
   "text": "مرحوم آ-میرجواد آقای ملکی تبریزی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 205.64,
   "end": 209.68,
   "text": "مفتاح الفلاح، فلاح السائل اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.68,
   "end": 216.64,
   "text": "بزرگانی همچون شیخ بهائی این‌ها در این کتاب‌ها خیلی زیبا تشریح فرمودند که بله امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.64,
   "end": 222.24,
   "text": "چنان باید تعظیم شود اصلاً اسمش رو خودشه ماه ربیع، ماه بهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.24,
   "end": 228.5,
   "text": "و ای می فرمایند این بزرگان اهل معرفت می فرمایند که تحقیقاً می فرمایند که به هم تبریک بگید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 228.5,
   "end": 233.3,
   "text": "لباس نو بپوشید و از رخت عزا دربیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 233.3,
   "end": 239.06,
   "text": "صراحتاً میگن به عظمتی که در این ماه داره رخ میده، چه عظمتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 239.06,
   "end": 246.88,
   "text": "کی زمین یه همچین تلألؤ نوری به خودش دیده که در این ماه میخواد اتفاق بیفته در هفته‌هام این ماه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 246.88,
   "end": 249.96,
   "text": "تولد پیغمبر است نباید از الان تعظیم شود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 249.96,
   "end": 254.66,
   "text": "ماهی رو داریم ورود می‌کنیم که تولد پیغمبر درشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 254.66,
   "end": 259.04,
   "text": "و هیچ وقت زمین شاهد همچین تلألؤی و همچین رحمتی نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 259.04,
   "end": 261.12,
   "text": "این صحبت امیرجواد آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 261.12,
   "end": 264.8,
   "text": "لذا می فرماید باید از همین رو از ورود به این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 264.8,
   "end": 268.68,
   "text": "تعظیم بشود. اصلاً می فرماید واجبه بر ما این تعظیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 268.68,
   "end": 272.72,
   "text": "تعظیم این ماه که هر کس تو رو نگاه کرد بگه رنگ و رود عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 272.72,
   "end": 275.66,
   "text": "چه خبره تو این ماه؟ و تو توضیح بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 275.66,
   "end": 277.88,
   "text": "نباید دوباره آدم لباس مشکی تنش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 277.88,
   "end": 283.6,
   "text": "متأسفانه بعضی هیئتها حالا یه وقت میگه کسی وقت نکرده دیشب مثلا مشکی‌شو درآره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.6,
   "end": 289.0,
   "text": "ولی بعضی هیئتها اصلاً ادامه میدن عزاداری رو تا شهادت امام عسکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 289.0,
   "end": 292.54,
   "text": "یه جا ما دعوت بودیم منبر ده شب رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 292.54,
   "end": 296.88,
   "text": "حالا صحبت‌های ما به ذائقه دل این‌ها خدا نشون داد گفتن حاج آقا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.88,
   "end": 300.2,
   "text": "دوباره بیایید، کی؟ دهه اول ماه ربیع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.2,
   "end": 302.44,
   "text": "گفتم چه خبره؟ گفتن عزاداری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.44,
   "end": 304.4,
   "text": "اصل عزاداری اون موقع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.4,
   "end": 310.04,
   "text": "گفتم خاک بر سر امثال من کنم که شما پا منبر من دارید می‌شینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.04,
   "end": 313.9,
   "text": ". در حالی که این‌ها معمولاً بهانه‌شون رو فاطمیه قصه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.9,
   "end": 318.98,
   "text": "زهرا سلام الله علیهاست که اگر اندکی اهل تحقیق و دقت نظر بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.98,
   "end": 322.1,
   "text": "می‌دونستن اون اصل وقایع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 322.1,
   "end": 325.34,
   "text": "جریان کوچه این‌ها مال بعد از میلاد پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.34,
   "end": 328.12,
   "text": "یعنی اتفاقی که افتاده اصلیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.12,
   "end": 330.9,
   "text": "برمی‌گرده به تاریخ بعد از هفته ربیع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.9,
   "end": 333.02,
   "text": "مال این اوایل ماه ربیع نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.02,
   "end": 338.56,
   "text": "اگر برن اهل تح-- تا اگر در منابع اهل تسنن هم برن نگاه کنن شیعه که جای خود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.56,
   "end": 341.84,
   "text": "نمی‌دونم به چه استنادی میگن همین چند روز اول بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.84,
   "end": 345.68,
   "text": "چندین روز طول چند هفته حداقل سه هفته گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.68,
   "end": 352.18,
   "text": "طول کشیده. سه هفته اون جریانات و سقیفه و برو و بیا و بخوان بیعت بگیرن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.18,
   "end": 357.32,
   "text": "این‌ها طول کشیده. بعد قصه کوچه از نمی‌دونم حالا اینا از کجا در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.32,
   "end": 359.38,
   "text": "این یه نکته .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 359.38,
   "end": 366.56,
   "text": "نکته بعدی در خصوص که البته خود همین نکته اول خودش مطلب سنگینیست یعنی اینو کم نگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.56,
   "end": 368.26,
   "text": "میلاد پیغمبر رو کم نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 368.26,
   "end": 370.52,
   "text": "ما وقتی در تشهدمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.52,
   "end": 376.64,
   "text": "ابتدا الوهیت ذاتی خدا رو اقرار می‌کنیم که أشهد أن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 376.64,
   "end": 379.94,
   "text": "أشهد أن لا إله إلا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 379.94,
   "end": 384.34,
   "text": "وحده لا شريك له این الوهیت خدا ذاتیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 384.34,
   "end": 390.56,
   "text": "بعد بلافاصله ذاتی پیغمبر رو اقرار می‌کنیم و شهادت میدیم، شهادت میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.56,
   "end": 392.7,
   "text": "ذاتی پیغمبر چیه اول؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 392.7,
   "end": 395.9,
   "text": "پیغمبر رسالتش ذاتی نیست که عارضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 395.9,
   "end": 398.82,
   "text": "اونچه که ذاتیشه عبودیتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 398.82,
   "end": 402.76,
   "text": "لذا میگیم و أشهد أن محمدا عبده ورسوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 402.76,
   "end": 406.62,
   "text": "صلى الله عليه وآله وسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 406.62,
   "end": 408.86,
   "text": "که البته اگر او، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.86,
   "end": 416.64,
   "text": "ا-الوهیت الله وحده لا شريك له است، عبودیت پیغمبر هم لا شريك له یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 416.64,
   "end": 420.04,
   "text": "به همون وزن اصلاً شراکت یعنی شراکت‌بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 420.04,
   "end": 426.16,
   "text": "هیچ عبودیتی در نظام هستی به عبودیت پیغمبر نمی‌رسه و ما دنبال سر این عبودیتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 426.16,
   "end": 430.48,
   "text": "و یکی از معانی الباب المبتلی به الناس همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 430.48,
   "end": 434.48,
   "text": "عبودیت من و تو با همین عبودیت سنجش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 434.48,
   "end": 437.0,
   "text": "این باب ابتلاء من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 437.0,
   "end": 439.28,
   "text": "نماز ما به نماز پیغمبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 439.28,
   "end": 442.84,
   "text": "زندگی ما، سیر و سلوک و سب-سبک زندگیمون همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 442.84,
   "end": 445.24,
   "text": "لذا فرمود سلوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 445.24,
   "end": 448.2,
   "text": "نماز بخوانید عباراتو ببینید كما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 448.2,
   "end": 450.8,
   "text": "رأیتمونی أصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 450.8,
   "end": 453.76,
   "text": "اونطوری نماز بخونید که دیدید من نماز خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 453.76,
   "end": 456.72,
   "text": "اصلاً تماماً ما در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 456.72,
   "end": 458.82,
   "text": "کفه ترازو در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.82,
   "end": 461.54,
   "text": "ابتلاء و امتحان نسبت به عبودیت پیغمبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.54,
   "end": 465.1,
   "text": "اینو چیز کمی نگیریم. در این ماه حضرت تشریف میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.1,
   "end": 469.66,
   "text": "رو کره زمین. نکته بعدی که معمولاً قابل بحث هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.66,
   "end": 474.92,
   "text": "پیرامون این داستانه که می‌دونید همه ساله ما داریم میگیم که آقا هرکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 474.92,
   "end": 479.14,
   "text": "ورود ماه ربیع یا انتهای ماه صفر رو به من خبر بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 479.14,
   "end": 483.18,
   "text": "مژد بهشت بر او نمیدونم گوارا باد و این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 483.18,
   "end": 485.08,
   "text": "من نمی‌دونم این طبق چه قاعده‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.08,
   "end": 490.06,
   "text": "اولاً این می‌دونید برمی‌گرده به اون روایت مشهوری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 490.06,
   "end": 493.24,
   "text": "حضرت ابیذر می‌خواست وارد مسجد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.24,
   "end": 498.6,
   "text": "پیغمبر فرمود الآن کسی که با اولین مردی که وارد مسجد شد اون اهل بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 498.6,
   "end": 501.7,
   "text": "می‌خواست بشارت ورود اباذر رو بده چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 501.7,
   "end": 508.36,
   "text": "اباذر بعداً از امیرالمؤمنین حمایت می‌کند و اون یکی از علمدارهای حمایت از مولا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.36,
   "end": 510.74,
   "text": "این سند تو تاریخ بمونه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 510.74,
   "end": 516.62,
   "text": "کسانی از امیرالمؤمنین حمایت کردن که پیغام- پیغمبر این‌ها رو بشارت بهشت داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 516.62,
   "end": 522.5,
   "text": "مثل عمار. اصلاً نگاه می‌کردن عمار تو کدوم صفه با اون تشخیص می‌دادن حق کجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.5,
   "end": 524.98,
   "text": "این کارهای جالب پیغمبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 524.98,
   "end": 531.98,
   "text": "بعد یه چند نفر شیطنت کردن دویدن از مسجد بیرون که از هم سبقت بگیرن یکی زودتر بیاد تو مسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 531.98,
   "end": 534.26,
   "text": "احمقای بی‌شعور که مثلاً بگه آره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.26,
   "end": 538.62,
   "text": "ما اون کسی هستیم که پیغمبر با اولین کسی که وارد شد اهل بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 538.62,
   "end": 540.74,
   "text": "پیغمبر دست اینا رو خون فرمود--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.74,
   "end": 543.3,
   "text": "بعد حرف رو عوض کرد پیغمبر به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 543.3,
   "end": 548.0,
   "text": "فرمود اولین کسی که وارد شود و به من مژده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.0,
   "end": 553.12,
   "text": "اتمام ماه صفر و اول ماه ربیع رو بدهد اهل بهشت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 553.12,
   "end": 559.38,
   "text": "اینجا انحراف ایجاد شده که ابوذر میاد به پیغمبر مژده میده که ماه ربیع طلوع کرد، حلول کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 559.38,
   "end": 561.86,
   "text": "چون پیغمبر تو این ماه به دنیا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 561.86,
   "end": 565.48,
   "text": "تبریک ورود پیغمبر رو می‌خواد به خود پیغمبر بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 565.48,
   "end": 570.26,
   "text": "بعد اینطوری در انحراف در مثلاً تواریخ انحراف ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 570.26,
   "end": 573.96,
   "text": "کاری نداریم. اه اصلاً با قاعده قرآنی هم این همخوانی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 573.96,
   "end": 578.96,
   "text": "یعنی چی یکی بیاد به پیغمبر بگه یا رسول الله ماه ربیع اومد بعد اهل بهشت بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 578.96,
   "end": 583.46,
   "text": "آخه این چه قاعده‌ایه؟ به یک کلمه که رو زبونش جاری بشه اهل بهشت بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 583.46,
   "end": 585.46,
   "text": "پس قاعده تقوا کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 585.46,
   "end": 588.38,
   "text": "قاعده حدود رعایت حدود الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 588.38,
   "end": 591.0,
   "text": "قاعده پذیرش ولایت، این‌ها کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 591.0,
   "end": 595.24,
   "text": "همین یه کلمه آی یا رسول الله ماه ربیع شد اهل بهشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 595.24,
   "end": 602.1,
   "text": "آخه این چه مسخره بازی عده‌ای را-- اصلاً دین رو متأسفانه به وهن می‌کشونه این مطالب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 602.1,
   "end": 605.8,
   "text": "نکته بعدی این که در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 605.8,
   "end": 608.34,
   "text": "نهم ربیع که حالا باید به موقعش بحث بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 608.34,
   "end": 614.82,
   "text": "اصلاً این هم اولاً اون سند معتبری که در روایات شیعه وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 614.82,
   "end": 616.6,
   "text": "برمی‌گرده به عمر دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 616.6,
   "end": 622.5,
   "text": "چون در تاریخ یه عمر اول داریم که ابن خطاب است، یک عمر دوم داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 622.5,
   "end": 626.39,
   "text": "که عمر ابن عبدالعزیز است که در نهم ربیع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 626.39,
   "end": 629.74,
   "text": "تاریخ داریم که تاریخ شیعه این‌ها داریم حتی در ش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 629.74,
   "end": 632.34,
   "text": "فرقه این هست که اونجا از دنیا میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 632.34,
   "end": 635.28,
   "text": "در حالی که خود اهل تسنن بیست و شش ر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 635.28,
   "end": 637.94,
   "text": "بیست و شش ذی الحجه رو برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 637.94,
   "end": 641.66,
   "text": "از دنیا رفتن عمر بن خطاب نقل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 641.66,
   "end": 644.0,
   "text": "خود کی؟ اهل تسنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 644.0,
   "end": 647.36,
   "text": "اصلاً هیچ-- این یک وجه تشابه اسمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 647.36,
   "end": 650.1,
   "text": "حالا بعضیا میگن پس چطور ما داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 650.1,
   "end": 652.02,
   "text": "در نه ربیع روایات زیادی داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 652.02,
   "end": 656.16,
   "text": "بله قبول هم داریم. مرحوم مجلسی هم آورده در اقبال هم فکر می‌کنم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 656.16,
   "end": 658.36,
   "text": "سید ابن طاووس آورده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 658.36,
   "end": 665.42,
   "text": "که من قبلاً مطالعه کردم تو گوشه ذهنم مونده که می‌فرماید بله روح روز برطرف شدن غم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 665.42,
   "end": 667.46,
   "text": "مسلمان‌هاست. روز شادی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 667.46,
   "end": 669.8,
   "text": "روز بزرگی‌ست. روز فرح هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 669.8,
   "end": 673.9,
   "text": "روز نمی‌دونم مکنت هست، عظمت هست روز نهم ربیع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 673.9,
   "end": 679.18,
   "text": "خب عزیز دلم این برمی‌گرده به روز سلطنت و امامت امام عصر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 679.18,
   "end": 685.68,
   "text": "اینکه میگه روز برطرف شدن همه غم‌ها از روی زمین است یعنی او ان شاء الله جلودار خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 685.68,
   "end": 688.6,
   "text": "در آن روز امامتش آغاز شود-خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 688.6,
   "end": 692.96,
   "text": "یعنی آغاز پرچمداری برطرف شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 692.96,
   "end": 695.98,
   "text": "تمام ظلم‌ها و جورها و غم‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 695.98,
   "end": 701.26,
   "text": "برمی‌گرده به امام عصر. شاید اون کسانی که اول این انحراف رو ایجاد کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 701.26,
   "end": 706.28,
   "text": "مقصود نظرشون به انحراف کشوندن قصه امامت امام عصر بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 706.28,
   "end": 709.0,
   "text": "که این چنین اومدن این رو ایجاد کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 709.0,
   "end": 710.96,
   "text": "جعل کردن در حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 710.96,
   "end": 712.72,
   "text": "این‌ها رو باید حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 712.72,
   "end": 715.44,
   "text": "بابا خود، خود اهل تسنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 715.44,
   "end": 719.12,
   "text": "که او رو عمر بن خطاب رو پیشوا و خلیفه خودشون می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 719.12,
   "end": 721.94,
   "text": "ان شاء الله با همونم محشورن نوش جونشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 721.94,
   "end": 726.26,
   "text": "ما با مولای خودمون امیرالمؤمنین علیه الصلاة والسلام محشور شویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 726.26,
   "end": 731.38,
   "text": "دعوایی هم باهاشون نداریم. اونا هم با مولای خودشون با جلودار خودشون نوش جونشون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 731.38,
   "end": 733.5,
   "text": "با هم بهترین جا برن کیف کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 733.5,
   "end": 735.84,
   "text": "ما هم هرجا مولامون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 735.84,
   "end": 740.58,
   "text": "فمعکم معکم لا مع غیرکم لا مع عدوکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 740.58,
   "end": 743.64,
   "text": "ما با علی علیه الصلاة والسلام و اولاد علی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 743.64,
   "end": 747.36,
   "text": "اونا هم با عمر و اهل بیت عمر باشن نوش جانشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 747.36,
   "end": 753.6,
   "text": "دعوایی نداریم. اما همون هم جالبه میگن بیست و شش ذی الحجه بعضی روایات هم بیست و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 753.6,
   "end": 756.54,
   "text": "ذی الحجه رو من دیدم گفتن حالا مال شیعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 756.54,
   "end": 759.72,
   "text": "فرق نمی‌کنه. در هر حال دهه آخر ذی الحجه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 759.72,
   "end": 764.52,
   "text": "چه روایت شیعه باشد، چه روایت اهل تسنن باشد، دهه آخر ذی الحجه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 764.52,
   "end": 768.68,
   "text": "چه دعوایی ما دیگه با هم داریم؟ حواسمون جمع باشه که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 768.68,
   "end": 774.2,
   "text": "وقایع الأيام هم یکی از راه‌های امتحانات الهی از من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 774.2,
   "end": 775.88,
   "text": "که ما چگونه چشممون رو باز کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 775.88,
   "end": 778.4,
   "text": "کسی یه کتاب داریم وقایع الأيام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 778.4,
   "end": 779.32,
   "text": "یه کتاب داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 779.32,
   "end": 786.26,
   "text": "دیشب من جالبه دیدم تو کتابفروشی حضرت حرم حضرت عبدالعظیم سلام الله علیه قشنگ تو پیشونی گذاشته بود می‌فروخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 786.26,
   "end": 791.24,
   "text": "حالا کی می‌خره نمی‌دونم. اکثراً میرن کتاب‌های داستانی می‌خرن که مال شیخ عباس قمی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 791.24,
   "end": 794.3,
   "text": "کتاب خیلی خوبیه. رحمة الله عليه محدث بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 794.3,
   "end": 799.18,
   "text": "ایشون حدیث‌شناس بوده. یه مقدار چشمامونو باز کنیم اهل تحقیق و پژوهش باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 799.18,
   "end": 803.54,
   "text": "تازه قدم بعدی نه بلکه محقق بشیم بلکه متحقq بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 803.54,
   "end": 806.02,
   "text": "این‌ها در وجود ما پیاده شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 806.02,
   "end": 810.08,
   "text": "یعنی اگر میگیم ماه ربیع، ماه بهار، بهاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 810.08,
   "end": 812.12,
   "text": "دیگه واقعاً بهار رو تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 812.12,
   "end": 815.62,
   "text": "ج-جلوه‌های رفتاری ما ظاهر و باطن ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 815.62,
   "end": 818.22,
   "text": "خانواده‌مون و دیگران ان شاء الله ببینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 818.22,
   "end": 822.9,
   "text": "ان شاء الله که عاقبتمون ختم بخیر شود بر-برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 822.9,
   "end": 826.92,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 826.92,
   "end": 829.96,
   "text": "محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}