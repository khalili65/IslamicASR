 },
 "chapters": [
  {
   "index": 0,
   "title": "## شرط رجحان در نذر",
   "start": 16.82,
   "end": 36.92
  },
  {
   "index": 1,
   "title": "## قلب ممتحَن و پندار رفاه مطلق از حکومت دین",
   "start": 36.92,
   "end": 159.4
  },
  {
   "index": 2,
   "title": "## سورهٔ فتح و غنائم فتح مبین",
   "start": 159.4,
   "end": 462.16
  },
  {
   "index": 3,
   "title": "## نصر عزیز",
   "start": 462.16,
   "end": 830.12
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.86,
   "end": 7.72,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.72,
   "end": 11.38,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.38,
   "end": 16.24,
   "text": "آیاته. سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.24,
   "end": 20.08,
   "text": "یکی دیگه از احکام مربوط به نذر و وقف رو عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.08,
   "end": 24.52,
   "text": "نذری که انسان میکنه مطلقاً باید رجحان داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.52,
   "end": 27.02,
   "text": "یعنی شما نمی‌تونید در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.02,
   "end": 32.68,
   "text": "امری که، موضوعی که نهی شده توسط خدا بر فعلش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.68,
   "end": 35.84,
   "text": "نهی رو بر فعلش امر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.84,
   "end": 39.28,
   "text": "نذر کنید یا امر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.28,
   "end": 44.3,
   "text": "بر ترکش نذر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.3,
   "end": 50.2,
   "text": "مثلاً اگر حتی در خصوص مکروهات بالاخره نهی شده دیگه توسط خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.2,
   "end": 52.4,
   "text": "مکروه نهی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.4,
   "end": 56.58,
   "text": "حالا یه سری ضعیف الإيمان هم مثل من توجه ندارن به این چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.58,
   "end": 65.64,
   "text": "اما اونایی که میخوان سیر استکمالیشون خوب طی بشه و به کمالات برسن این‌ها حتی مکروهات رو هم ترک می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.64,
   "end": 78.04,
   "text": "خب مثلاً انسان نذر کنه که حالا مثلاً اگر بخواهیم به فتوای بعضی از مراجع سیگار کشیدن و مکروه بدانیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 78.04,
   "end": 80.34,
   "text": "مثلاً نذر کنه سیگار بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.34,
   "end": 85.34,
   "text": "اگر این گرم باز شد مثلاً یه پوک عمیق میزنم اونم سیگار فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.34,
   "end": 88.5,
   "text": "بعضیا رو من دیدم توی نجف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.5,
   "end": 93.42,
   "text": "متاسفانه اونجا هم تو کربلا حتی، یه سری جاها راه افتاده قلیون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.42,
   "end": 98.68,
   "text": "قلیون‌های عجیبی میدن اصلاً بوش آدمو مست میکنه نزدیک حرم آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 98.68,
   "end": 103.36,
   "text": "همین بچه حزب‌اللهی‌ها دیدم با هم کل کل که میکنن بعد میگن آره اگه فلان شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.36,
   "end": 106.84,
   "text": "آقا بغل اربابی نذر تو یه جوری قرار بده آقا کیف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 106.84,
   "end": 110.94,
   "text": "میگه میام اینجا همتون رو مهمون می‌کنم قلیون فلان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.94,
   "end": 113.9,
   "text": "تو کربلا یا تو نجف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.9,
   "end": 115.82,
   "text": "این اصلاً این نذر باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.82,
   "end": 123.16,
   "text": "نذری که این باشه که آقا حاجتمو بده بعد رفیقامو جمع می‌کنم میارم محضر آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.16,
   "end": 131.64,
   "text": "قلیون‌کشی. اینکه کسی نذرش این باشه که اگر خدای حاجتمو رو کرد مثلا با حاج آقا قلی زاده خلوت می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 131.64,
   "end": 135.44,
   "text": "یا حاج آقا قلی زاده به قول قدیمی‌ها هم قل قل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.44,
   "end": 137.78,
   "text": "قلیون رو می‌گفتن. حاج آقا قلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 137.78,
   "end": 140.38,
   "text": "مؤدبانه‌ش میشه حاج آقا قلی زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.38,
   "end": 142.66,
   "text": "این نذر اصلاً باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.66,
   "end": 146.86,
   "text": "یا کسی نذر کنه اگر این اتفاق افتاد غیبت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.86,
   "end": 149.38,
   "text": "مثلاً این گناه رو انجام، اینا همش باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.38,
   "end": 151.36,
   "text": "باید نذر رجحان داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.36,
   "end": 153.42,
   "text": "بگذریم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.42,
   "end": 163.06,
   "text": "در خصوص قلبی که مورد امتحان خدا واقع میشه و قلب مصحح، نکته دیگری رو به فضل الهی عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.06,
   "end": 166.6,
   "text": ". معمولاً این چنین است که بعضی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.6,
   "end": 169.26,
   "text": "از این ضعیف الإيمان‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.26,
   "end": 179.36,
   "text": "فتح پیغمبر و نصرت الهی به او رو و وعده‌هایی که خدا و پیغمبر در قرآن داده‌اند و یا اون حکومت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 179.36,
   "end": 187.86,
   "text": "عرض شود نبی اکرم یا حکومتی که مد نظر ماست حالا علوی بگیر، مهدوی بگیر، هرچی، اون حکومت کریمه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 187.86,
   "end": 192.14,
   "text": "یک امپراتوریه بر اساس قواعد دنیا فرض می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 192.14,
   "end": 194.62,
   "text": "که هیچ مشکل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 194.62,
   "end": 200.92,
   "text": "هیچ سختی‌ای درش نیست و همه چی گل و بلبل است و بر اساس قواعد دنیوی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 200.92,
   "end": 208.02,
   "text": "که حالا دیگه همه مثلاً برج نشین و پنت هاوس نشین و شاستی بلند نشین و چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.02,
   "end": 213.34,
   "text": "یک اصلاً قواعد این‌ها اصول فکری‌شون بر اساس مسائل دنیوی تنظیم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 213.34,
   "end": 215.52,
   "text": "تا میگی مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 215.52,
   "end": 223.1,
   "text": "حضرت میاد حکومتی تشکیل میده، عدالت رو پیاده می‌کنه، سریع میگه خب پس همه وضع مالیشون خوب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 223.1,
   "end": 227.12,
   "text": "ببینید این‌ها ضعیف و میشه گفت به یک نگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 227.12,
   "end": 230.5,
   "text": "متاسفانه سطحی نگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 230.5,
   "end": 233.86,
   "text": "دین رو دیدن است و الا خیلی عمیق‌تر از این حرفاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 233.86,
   "end": 241.12,
   "text": "شما اگر به قصه فتح پیغمبر که در یکی از بهترین سوره‌ها سوره فتح که این رو اشاره کرده همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 241.12,
   "end": 243.36,
   "text": "آیات ابتداییش دقت کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 243.36,
   "end": 246.24,
   "text": "اصلاً اون فتح نهایی پیغمبر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 246.24,
   "end": 252.22,
   "text": "چه اون فتح مکه بگیری، چه اون فتح ابتدایی حالا صلح هدیبیه بگیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 252.22,
   "end": 257.82,
   "text": "چه نه، اون فتح رو فتح الفتوح بگیری بر تشکیل حکومت مهدوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 257.82,
   "end": 260.34,
   "text": "که حالا هر دوش لحاظ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 260.34,
   "end": 265.28,
   "text": "هرچی بگیری ببینید خدای منّان مختصات این فتح رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 265.28,
   "end": 270.6,
   "text": "به عبارت بعضی از بزرگان غنائم این فتح بزرگ رو چی برشمرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 270.6,
   "end": 273.7,
   "text": "بسم الله الرحمن الرحیم، سوره فتح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 273.7,
   "end": 286.44,
   "text": "اون فتح آشکار و بزرگی که ما نصیب تو می‌کنیم ببینید غنائمش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 286.44,
   "end": 291.36,
   "text": "این یه دونه. گناهان تو چه پیش از اون بوده، چه قبل از، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 291.36,
   "end": 296.46,
   "text": "و بعدش همه بخشیده میشه که این ذنب پیغمبر که پیغمبر معصوم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 296.46,
   "end": 304.8,
   "text": "برمی‌گردد. اینم از همون رموز قرآن است که اگر کسی قرآن را همراه با رموزش پیاده نکنه به گمراهی کشیده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 304.8,
   "end": 307.4,
   "text": "میگه عجب بر پیغمبرم پس گناه داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 307.4,
   "end": 309.96,
   "text": "این ذنب به یک معنا ذنب امت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 309.96,
   "end": 314.04,
   "text": "به یک معنا تهمت‌هاییه که به پیغمبر زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 314.04,
   "end": 317.04,
   "text": ". هرچی که باشه میگه هم قبل، هم بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 317.04,
   "end": 324.66,
   "text": "خدا در حقیقت گناهان کسی که در مسیر پیغمبر و این فتح عظیم حرکت کرده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 324.66,
   "end": 327.86,
   "text": "قبل و بعدش رو می‌بخشه. یکی از غنائم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 327.86,
   "end": 332.78,
   "text": "فتح بزرگ است و بعد می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 332.78,
   "end": 336.56,
   "text": "تطمیم نعمت، این اتمام نعمت کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 336.56,
   "end": 345.36,
   "text": "در قصه غدیر دیگه، قصه ولایت و امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 345.36,
   "end": 348.48,
   "text": ". اینجا می‌فرماید .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 348.48,
   "end": 351.56,
   "text": "این دو تا آیه رو وقتی با هم ببینی می‌فهمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 351.56,
   "end": 353.28,
   "text": "که این قصه ولایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 353.28,
   "end": 358.22,
   "text": "یعنی اگر کسی در مسیر این فتح پیغمبر قدم گذاشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 358.22,
   "end": 361.7,
   "text": "از غنائم مهم این فتح بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 361.7,
   "end": 364.74,
   "text": "رسیدن به ولایت امیرالمؤمنینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 364.74,
   "end": 370.12,
   "text": "کناره‌گیری از به قول بزرگان محیط ولایت طاغوت است به تعبیر قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 370.12,
   "end": 372.32,
   "text": "و رسیدن به محیط ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 372.32,
   "end": 375.72,
   "text": "اهل بیت عصمت و طهارت علیهم الصلاة والسلام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 375.72,
   "end": 378.48,
   "text": "قدم زدن در وادی ولایت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 378.48,
   "end": 381.96,
   "text": "و که معمولا ما به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 381.96,
   "end": 387.18,
   "text": "میشه گفت غنیمت بزرگ فتح پیغمبر توجه خیلی نمی‌کنیم که آقا جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 387.18,
   "end": 390.9,
   "text": "ما مثل ماهی غرق در آبیم و باز میگیم آب، آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 390.9,
   "end": 396.0,
   "text": "همین الان ما در محضر اماممون هستیم همین الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 396.0,
   "end": 398.08,
   "text": "و یهدیک صراطا مستقیما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 398.08,
   "end": 402.46,
   "text": "سومین غنیمت. میگه تو رو به اون صراط مستقیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 402.46,
   "end": 409.46,
   "text": "که این همه ما هر روز داریم تو نمازمون اهدنا الصراط المستقيم اصرار می‌کنیم، التجا می‌کنیم به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 409.46,
   "end": 414.2,
   "text": "شاید بشه گفت تنها دعای واجبه در نماز هر روز ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 414.2,
   "end": 421.18,
   "text": "باز توجه نداریم به عظمت این درخواستمون گاهی اوقات تو نماز و اینجا خدا داره ف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 421.18,
   "end": 424.84,
   "text": "غنیمت این فتح رو اینطوری بر میشماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 424.84,
   "end": 427.36,
   "text": "شما رو هدایت می‌کنم که در سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 427.36,
   "end": 434.3,
   "text": "یاسین هم می‌فرمود که مگر من به شما نگفتم که ان اعبدونی هذا صراط مستقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 434.3,
   "end": 437.8,
   "text": "لا تعبدوا الشيطان انه لکم عدو مبین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 437.8,
   "end": 440.64,
   "text": "ان اعبدونی، منو بپرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 440.64,
   "end": 442.5,
   "text": "هذا صراط مستقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 442.5,
   "end": 446.42,
   "text": "خیلی وادی عبودیت وادی دشواریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 446.42,
   "end": 449.48,
   "text": "انسان به خودی خود نمی‌تونه تو اون وادی قدم بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 449.48,
   "end": 455.88,
   "text": "قطعا هدایت پیغمبر و هدایت خدا رو می‌طلبه که اینجا خدا غنیمت شمرده اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 455.88,
   "end": 457.9,
   "text": "و یهدیک صراطا مستقیما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 457.9,
   "end": 460.98,
   "text": "چیز کمی نیست. و ینصرک الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 460.98,
   "end": 463.18,
   "text": "ببینید چقدر زیباست چهارمین غنیمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 463.18,
   "end": 466.22,
   "text": "و ینصرک الله نصرا عزيزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 466.22,
   "end": 470.94,
   "text": "این نصر عزیز رو ینصرک الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 470.94,
   "end": 473.96,
   "text": "اونم کاف به پیغمبر بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 473.96,
   "end": 478.52,
   "text": "یعنی تو رو خدا به نصر عزیز بشارت می‌ده در این فتح بزرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 478.52,
   "end": 483.04,
   "text": "نصر عزیز وقتی‌ست که پیغمبر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 483.04,
   "end": 488.5,
   "text": "سخت‌ترین لحظات، این بشارت در سخت‌ترین لحظات به پیغمبر داده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 488.5,
   "end": 494.08,
   "text": "این یکی از دشوارترین ابتلاءات و امتحانات قلوب اهل ایمان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 494.08,
   "end": 497.68,
   "text": "که تا دلتون بخواد تو آیات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 497.68,
   "end": 501.46,
   "text": "داستان زندگی پیشین انبیا و اولیای خدا این وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 501.46,
   "end": 508.9,
   "text": "تو قصه حضرت موسی، حضرت موسی علی نبینا و آله و علیه الصلاة والسلام وقتی دستور از خدا گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 508.9,
   "end": 512.12,
   "text": "که قومش رو حرکت بده به سمت نیل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 512.12,
   "end": 515.48,
   "text": "حرکت کردن رفتن خب برخوردند به قوم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 515.48,
   "end": 518.86,
   "text": "رود نیل از پشت سر هم که فرعون داشت میومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 518.86,
   "end": 524.52,
   "text": "وقتی این فرعون اومد صراحتا تو قرآن میگه اونا گفتن تمام شد فاتحه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 524.52,
   "end": 529.72,
   "text": "یاران حضرت موسی چون ضعیف الإيمان بودند گفتن موسی همه ما رو به کشتن داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 529.72,
   "end": 532.98,
   "text": "این چه وضعی، چه استراتژی‌که آخه چه کاریه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 532.98,
   "end": 537.78,
   "text": "این چه طرحی بود؟ ما رو آورد لب نیل پشت سرمون هم که دشمن ما رو غافل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 537.78,
   "end": 541.78,
   "text": "حضرت اونجایی که همه دارن میگن کار ما تموم شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 541.78,
   "end": 545.86,
   "text": "حضرت می‌فرماید من امید دارم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 545.86,
   "end": 548.46,
   "text": "ان معی ربی سیهدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 548.46,
   "end": 554.56,
   "text": "همون خدایی که به اتفاق من است معی ربی سیهدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 554.56,
   "end": 557.8,
   "text": "همون خدا هدایتم می‌کنه. ببینید ایمانو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 557.8,
   "end": 560.28,
   "text": "سیهدين به هدایت الهی چگونه...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 560.28,
   "end": 567.52,
   "text": "همونجا اون اتفاق عظیم رخ میده و عصا میزنه به آب و آب شکافته میشه و کی فکر می‌کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 567.52,
   "end": 571.5,
   "text": "همونجا ببین چه امتحان بزرگی پس دادن در این سختی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 571.5,
   "end": 575.78,
   "text": "لب مرز مرگ و حیات قرار گرفته امتحان پس دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 575.78,
   "end": 579.48,
   "text": "بسیاری اون موقعی که پیغمبر در جنگ احزاب داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 579.48,
   "end": 584.58,
   "text": "برای خندق کندن حالا به قول ما کلنگ می‌کوبید به زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 584.58,
   "end": 586.76,
   "text": "اینو دیگه تو روایات دیدید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 586.76,
   "end": 588.68,
   "text": "که س-- از گرسنگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 588.68,
   "end": 595.02,
   "text": "سگ خود پیغمبر به شکم بسته بود و صحابه از صبح تا شب یه دونه خرما داشتن برای چند نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 595.02,
   "end": 597.5,
   "text": "حالا تو تعدادش اختلاف روایت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 597.5,
   "end": 601.52,
   "text": "توی اون وضعیت که همه گرسنه ان پیغمبر خواب دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 601.52,
   "end": 604.8,
   "text": "خواب فتح عظیم رو دید، خواب فتح عظیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 604.8,
   "end": 606.98,
   "text": "و فرمود من خواب دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 606.98,
   "end": 609.84,
   "text": "که ان شاء الله به زودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 609.84,
   "end": 612.92,
   "text": "م-میریم زیارت مکه در امنیت کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 612.92,
   "end": 619.62,
   "text": "جالبه سال بعد حالا اونجا میگه در برق اولی که اون جرقه اولی که حالا در کلنگ زده شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 619.62,
   "end": 622.88,
   "text": "جرقه دوم، جرقه سوم، یکی یکی حضرت فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 622.88,
   "end": 624.8,
   "text": "دیدم که روم فتح شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 624.8,
   "end": 627.12,
   "text": "دیدم که ایران فتح شد اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 627.12,
   "end": 630.62,
   "text": "یه عده ضعیف الإیمانه می‌گفتن استغفرالله چی میگه پیغمبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 630.62,
   "end": 636.78,
   "text": "مثل اون سرکرده‌شون، اون رئیسشون، خلیفه‌شون که گفت هزیان میگه لحظه آخر پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 636.78,
   "end": 639.88,
   "text": "استغفرالله، استغفرالله هزیان میگه حرفا ما تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 639.88,
   "end": 644.12,
   "text": "گرسنه‌ایم. یه دونه خرما داریم برای چند نفر داره میگه روم فتح شد فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 644.12,
   "end": 651.98,
   "text": "بعد وقتی هم که پیغمبر حرکت کرد یه عده می‌گفتن آخه این چه پیغمبریه بر اساس خوابش وقتی نفهمه پیغمبر چیه، چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 651.98,
   "end": 654.76,
   "text": "میگه خواب بر اساس خواب داره حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 654.76,
   "end": 657.38,
   "text": "نمی‌فهمه که خواب پیغمبر چیه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 657.38,
   "end": 660.58,
   "text": "اینا خیلی نکات مهمیه. اونجا خیلیا تو زرد از آب دراومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 660.58,
   "end": 663.96,
   "text": "مخلفین کیان؟ کسی که جا موندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 663.96,
   "end": 667.12,
   "text": "مخلف شدن. جا موندن از حرکت پیغمبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 667.12,
   "end": 671.36,
   "text": "از طرح پیغمبر جا موندن و به غنائم فتح نرسیدن همینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 671.36,
   "end": 673.86,
   "text": "کسایی که می‌گفتن پیغمبر بر اساس خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 673.86,
   "end": 678.76,
   "text": "بعد رفت اون س-- اولین بار هزار و ششصد نفر حدودا با خودش برد برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 678.76,
   "end": 681.72,
   "text": "سال اول. چون سه سال فتح مکه طول کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 681.72,
   "end": 684.38,
   "text": "سال اول رفتن پیغمبر فرمود برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 684.38,
   "end": 689.84,
   "text": "بدون هیچ گونه سلاحی رفتن که مثلا پیغمبر از قبلش وعده چی داده بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 689.84,
   "end": 691.84,
   "text": "به زودی زیارت مکه در امنیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 691.84,
   "end": 694.52,
   "text": "رفتن راشون ندادن. بدون اسلحه هم رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 694.52,
   "end": 697.16,
   "text": "اونجا منجر شد به صلح هدیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 697.16,
   "end": 699.48,
   "text": "پیغمبر از اینا اخذ پیمان کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 699.48,
   "end": 701.44,
   "text": "گفتن تا پای جانمون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 701.44,
   "end": 704.78,
   "text": "این رو بزرگترین امتیاز خدا برای اینا می‌شمره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 704.78,
   "end": 707.82,
   "text": "معامله جان با پیغمبر کردن چیز کمی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 707.82,
   "end": 711.24,
   "text": "این بالاتر از حجه. اما یه عده نفهمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 711.24,
   "end": 714.46,
   "text": "گفتن وقتی آدم با خواب پیغمبر حرکت کنه اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 714.46,
   "end": 717.52,
   "text": "پیغمبر فرمود من که نگفتم امسال میریم زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 717.52,
   "end": 721.42,
   "text": "گفتم به زودی. سال بعد رفتن، سال دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 721.42,
   "end": 723.58,
   "text": "رفتن در امنیت زیارت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 723.58,
   "end": 728.38,
   "text": "هیچ اتفاقی هم نیفتاد. سال سوم انا فتحنا لك فتحا مبينا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 728.38,
   "end": 734.18,
   "text": "حالا تو یک وجهشه. و الا بعضی فتح مبین رو همون صلح هدیبیه گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 734.18,
   "end": 738.24,
   "text": "که این-اینایی که جانشون رو به پیغمبر بخشیدن چیز کمی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 738.24,
   "end": 741.22,
   "text": "چی بالاتر از جان؟ کی حاضره جان ببخشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 741.22,
   "end": 744.42,
   "text": "این بزرگترین فتح، غنیمت این فتحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 744.42,
   "end": 747.24,
   "text": "حالا فتح مکه هم بگیریم سه-- سال سوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 747.24,
   "end": 754.94,
   "text": "سه سال خدا پدر اینا رو درآورد تا ازشون امتحان بگیره بالا پایینشون کنه به قول ما معلوم شه بالاخره کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 754.94,
   "end": 757.44,
   "text": "راست میگه من ب-با پیغمبرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 757.44,
   "end": 762.38,
   "text": "کی راست میگه که فمعکم معکم لا مع غیرکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 762.38,
   "end": 766.04,
   "text": "اینا امتحانات عجیب و غریبی‌ست که گاهی اوقات الانم ما اینو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 766.04,
   "end": 768.84,
   "text": "میگیم نگاه کن وضع آمریکایی‌ها و اروپایی‌ها و غربی‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 768.84,
   "end": 771.64,
   "text": "می‌بینی چه وضعشون توپه. بعد ما همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 771.64,
   "end": 776.68,
   "text": "ملت مسلمون همه تو بدبختی و فلاکت و کله-- کسی از فقر خوشش نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 776.68,
   "end": 778.72,
   "text": "کسی تایید نمی‌کنه این راه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 778.72,
   "end": 785.44,
   "text": "اما می‌خوایم بگیم تو دل این راهی که این طرحی که به قول بزرگان پیغمبر ایجاد کرده و به فتح عظیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 785.44,
   "end": 790.74,
   "text": "حکومت علوی و مهدوی ان شاء الله منجر خواهد شد و منتج خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 790.74,
   "end": 793.22,
   "text": "این سختیای راه طبیعی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 793.22,
   "end": 796.36,
   "text": "و اگر کسی بخواد به یک نگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 796.36,
   "end": 798.96,
   "text": "ظاهربین و سطحی‌بین نگاه کنه می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 798.96,
   "end": 801.86,
   "text": "میگه همه چی رفاه، خوشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 801.86,
   "end": 805.2,
   "text": "همه چی مال اوناست. ما همش بدبخت و گرفتار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 805.2,
   "end": 809.1,
   "text": "فلان و می‌بره. نمی‌تونه اون فتح غنائم رو درست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 809.1,
   "end": 813.14,
   "text": "غنائم این فتح بزرگ رو نمی‌تونه درست تحلیل و تجزیه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 813.14,
   "end": 816.68,
   "text": "لذا وسط راه تو امتحانات الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 816.68,
   "end": 819.3,
   "text": "سر بلند بیرون نمیاد و وسط راه می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 819.3,
   "end": 825.4,
   "text": "ان شاء الله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 825.4,
   "end": 830.12,
   "text": "صلوات الله علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}