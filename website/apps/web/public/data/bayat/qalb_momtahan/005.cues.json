 "chapters": [
  {
   "index": 0,
   "title": "## رانندهٔ شغلی و نمازِ مسافر",
   "start": 0.9,
   "end": 235.42
  },
  {
   "index": 1,
   "title": "## الذي خلق؛ نخستین نشانه",
   "start": 235.42,
   "end": 294.48
  },
  {
   "index": 2,
   "title": "لحظه‌ای به آیهٔ دومِ سورهٔ انسان بازگردیم که بحثِ خلقت را دارد:",
   "start": 294.48,
   "end": 320.46
  },
  {
   "index": 3,
   "title": "## آیهٔ جمعه؛ تذکره و تزکیه و تعلیم",
   "start": 320.46,
   "end": 351.78
  },
  {
   "index": 4,
   "title": "## مدخلِ تعلیم؛ آفریده‌شده برای آگاهی",
   "start": 351.78,
   "end": 750.62
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.9,
   "end": 4.44,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.44,
   "end": 7.92,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.92,
   "end": 12.84,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.84,
   "end": 16.36,
   "text": "می‌دونید که راننده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.36,
   "end": 18.54,
   "text": "این سفری که چون سفرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.54,
   "end": 24.04,
   "text": "در حقیقت سفری که میره میاد شغلیه دیگه راننده یکی از کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.04,
   "end": 26.82,
   "text": "سفرش سفر، اون شغلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.82,
   "end": 30.3,
   "text": "در حقیقت سفر حساب میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.3,
   "end": 32.7,
   "text": "شغلش یا مقدمه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.7,
   "end": 35.26,
   "text": "شغلش به قولی سفر هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.26,
   "end": 44.06,
   "text": "این وقتی در سفر اول اولین باری که میره با راننده حالا با ماشینش میره رانندگی به عنوان شغل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.06,
   "end": 47.68,
   "text": "اولین بار که میره طبق فتوایی که قبلاً گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.68,
   "end": 49.82,
   "text": "نمازش شکسته است و روزه نمیتونه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.82,
   "end": 53.8,
   "text": "بارهای بعدی دیگه چیه؟ دیگه مسافر حساب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.8,
   "end": 59.08,
   "text": "حالا سؤال اینه که اگر کسی موقتاً شغل رانندگی بهش داده شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.08,
   "end": 61.36,
   "text": "حالا توی اداره‌ای کار می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.36,
   "end": 64.3,
   "text": "راننده اون اداره نداشت گفت فعلاً شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.3,
   "end": 67.06,
   "text": "آقای فلانی شما فعلاً دفترداری نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.06,
   "end": 69.74,
   "text": "فعلاً ماشین رو بردار رانندگی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 69.74,
   "end": 74.88,
   "text": "یا بعضی سربازها هستن تو پادگان موقتاً بهشون رانندگی، شغل رانندگی داده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.88,
   "end": 78.08,
   "text": "این حکمش چی میشه؟ موقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.08,
   "end": 80.84,
   "text": "آقا فرمودن که این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 80.84,
   "end": 83.74,
   "text": "فرمودن به مصداق عرفی باید نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 83.74,
   "end": 89.92,
   "text": "اگر در عرف او رو راننده می‌دونن یعنی اکثریت مردم اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.92,
   "end": 93.02,
   "text": "اون شخص رو راننده حساب می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 93.02,
   "end": 96.26,
   "text": "شغلش رو راننده می‌دونن، چنین کسی هم همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 96.26,
   "end": 98.58,
   "text": "فتوا براش مترتب میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 98.58,
   "end": 106.2,
   "text": "شغلش میشه رانندگی و دفعه اول نمازش شکسته است دفعات بعدی باید کامل بخونه نمازش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 106.2,
   "end": 109.8,
   "text": "خب، الذین امتحن الله قلوبهم للتقوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 109.8,
   "end": 112.42,
   "text": "ما ذیل این آیه داریم بحث می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 112.42,
   "end": 116.16,
   "text": "و نکات بسیار دقیق و ظریفی از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.16,
   "end": 118.88,
   "text": "حقیقت در قرآن مكتشف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 118.88,
   "end": 121.46,
   "text": "اکتشاف پیدا می‌کنه برای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 121.46,
   "end": 127.04,
   "text": "و ما کشف می‌کنیم حقایقی رو ذیل این آیه که متوجه می‌شیم عجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 127.04,
   "end": 132.92,
   "text": "چه داستانیه و اصلاً اساس خلقت ما این بوده اینکه ما مورد امتحان قرار بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 132.92,
   "end": 136.04,
   "text": "ببینید یه چند تا آیه رو با هم بخونیم مزاجتون شیرین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 136.04,
   "end": 140.76,
   "text": "اگه کسی قرآن بخونه مزاجش شیرین نشه دلش مریضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 140.76,
   "end": 145.08,
   "text": "اول از آیه سوره علق، سوره علق رو چند تا آیه اولشو دقت فرمودید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 145.08,
   "end": 149.56,
   "text": "اقرأ بسم ربک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.56,
   "end": 151.88,
   "text": "اینا همش البته نق-- نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 151.88,
   "end": 159.3,
   "text": "اولاً این اقرأ. میگه بخوان این خواندن نه یعنی خواندن در نشئه طبیعت با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.3,
   "end": 161.88,
   "text": "زبان طبیعی خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 161.88,
   "end": 165.1,
   "text": "با این زبان. این اقرأ معناهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.1,
   "end": 169.08,
   "text": "عمیق‌تری داره. یه معناش یعنی با زبانت منو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 169.08,
   "end": 174.92,
   "text": "یه معناش یعنی با در عالم مثالتم منو بخون در عالم وحیتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 174.92,
   "end": 177.48,
   "text": "یه معناش یعنی عقلی، با عقلت منو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 177.48,
   "end": 180.58,
   "text": "یه، یک معنا یعنی قرائت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 180.58,
   "end": 183.62,
   "text": "قلبی. من حاضر باشم نزد تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 183.62,
   "end": 191.3,
   "text": "تو حاضر باشی نزد من. یه معناش قرائت سریست، روحی‌ست که اینا حالا قبلاً یه بحثی دربارش تو فلسفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.3,
   "end": 194.52,
   "text": "فلسفه حکمت متعالیه داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.52,
   "end": 196.66,
   "text": "حالا بحثمون چون اینجاس نیست رد میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 196.66,
   "end": 198.72,
   "text": "نکته بعدی بسم ربک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 198.72,
   "end": 201.3,
   "text": "پروردگار تو. این معلوم میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 201.3,
   "end": 207.18,
   "text": "این خوانش‌های پروردگار مطابق با وجود هر کسی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 207.18,
   "end": 209.8,
   "text": "منظور اینجا برای خواندن من و تو، اون رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 209.8,
   "end": 213.82,
   "text": "مطلق نیست. اون رب العالمین مال پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.82,
   "end": 217.2,
   "text": "پ- پیغمبره که رب العالمین رو می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 217.2,
   "end": 219.14,
   "text": "البته اینا با هم فرقی نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 219.14,
   "end": 221.66,
   "text": "حالا در کن و ذات و باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 221.66,
   "end": 228.94,
   "text": "حالا یه بحث فلسفیه که قبلاً چون مقدماتش رو ما قبلاً تو بعضی از بحث‌ها رفتیم، من انقدر راحت میگم رد میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 228.94,
   "end": 231.64,
   "text": "مطابق با وجودت باید خدا تو بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 231.64,
   "end": 235.12,
   "text": "این نکاتیه که حالا استخراج میشه بعداً باید بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 235.12,
   "end": 238.8,
   "text": "اما چه خدایی؟ ربک، کدوم خدای تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 238.8,
   "end": 246.98,
   "text": "الذي خلق. جالبه اولین نشونه‌ای که از اون خدایی که می‌خوای تو بخونیش مطابق با وجود خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.98,
   "end": 250.58,
   "text": "قرائت ازش داشته باشی با تمام قوای وجودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 250.58,
   "end": 255.4,
   "text": "خدای خالق است. بعد آیه بعد خلق الانسان من علق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.4,
   "end": 258.22,
   "text": "خب درست حالا خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 258.22,
   "end": 260.64,
   "text": "از علق ما رو آفرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 260.64,
   "end": 263.92,
   "text": "بحث خلقت رو یعنی اول اصلاً اگه ما خلقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 263.92,
   "end": 269.22,
   "text": "نداشتیم ما خلق نمی‌شدیم و خدا خالق نبود که اصلاً ما نیست بودیم، عدم بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 269.22,
   "end": 273.54,
   "text": "بالطبع اولین در حقیقت نشئه وجودی همین میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 273.54,
   "end": 277.58,
   "text": "بحث خلقت هست. حالا اینو فعلاً آیه بعدشم کار داریم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 277.58,
   "end": 281.44,
   "text": "اما یه لحظه برگردیم playback بزنیم با آیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.44,
   "end": 284.62,
   "text": "آیات س-- آیه دو سوره انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.62,
   "end": 286.3,
   "text": "بحث خلقتو اونجا هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.3,
   "end": 291.44,
   "text": "انا خ-- ببینید من حرف‌هام از، از خودم نیست ها هم از شما هم الان فکرتونو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 291.44,
   "end": 294.48,
   "text": "باز کنید دل بدید ببینید چه جالب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 294.48,
   "end": 298.06,
   "text": "انا خلقنا الانسانا خلقنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 298.06,
   "end": 300.22,
   "text": "ما خلق کردیم انسان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.22,
   "end": 302.8,
   "text": "من نطفه. اونجا میگه از علق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 302.8,
   "end": 305.04,
   "text": "اینجا میگه من نطفه امشاج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 305.04,
   "end": 307.94,
   "text": "اون نطفه‌ای که در هم پیچیده‌ست و حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 307.94,
   "end": 310.76,
   "text": "کاری به اون نداریم. نبتلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 310.76,
   "end": 313.28,
   "text": "بلافاصله نبتلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 313.28,
   "end": 316.62,
   "text": "برای چی؟ ما می‌خوایم امتحانش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 316.62,
   "end": 319.54,
   "text": "بلافاصله بعد خلقت من و تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 319.54,
   "end": 323.6,
   "text": "خدا اینجا تو آیه دو سوره انسان میگه نبتلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 323.6,
   "end": 327.5,
   "text": "مثلاً شما تو خلقت کردیم با اون وضعیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 327.5,
   "end": 329.82,
   "text": "برای اینکه تو رو امتحانت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 329.82,
   "end": 332.12,
   "text": "حالا جالبه فجعلناه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 332.12,
   "end": 334.62,
   "text": "این فا خیلی معنا داره اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 334.62,
   "end": 337.0,
   "text": "فجعلناه سميعا بصيرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 337.0,
   "end": 339.74,
   "text": "اصلاً برای همین تو رو سميع و بصير",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 339.74,
   "end": 342.1,
   "text": "خلق کردیم. چون قراره امتحان بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 342.1,
   "end": 345.24,
   "text": "این پیداست که یکی از امتحانات سنگین ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 345.24,
   "end": 349.06,
   "text": "با شنیدن و دیدنه. که اینو بعداً باید بحث بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 349.06,
   "end": 350.76,
   "text": "به وجه، وزانه خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 350.76,
   "end": 353.24,
   "text": "منتها الان چون نکته دیگه‌ای رو می‌خوایم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 353.24,
   "end": 357.54,
   "text": "یه مرکز دیگه‌ای رو می‌خوایم متوجه بشیم بزنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 357.54,
   "end": 361.2,
   "text": "برگردیم به آیه سه سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 361.2,
   "end": 365.24,
   "text": "علق. بعد از اینکه میگه خلق الانسان من خ-- علق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 365.24,
   "end": 367.5,
   "text": "بعد از خلقت انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 367.5,
   "end": 370.38,
   "text": "بلافاصله ا-اول گفت اقرأ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 370.38,
   "end": 373.24,
   "text": "خدا رو مطابق با وجود خودت بخون خدای خودت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 373.24,
   "end": 377.64,
   "text": "حالا چه خوندنی؟ اقرأ وربک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 377.64,
   "end": 381.98,
   "text": "ربک دوباره الاکرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 381.98,
   "end": 384.92,
   "text": "اسم بعدی بحث کرامت و کریمیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 384.92,
   "end": 389.02,
   "text": "خداست که اصلا خدا میخواد بگه سر سوزنی به تو نیاز نداشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 389.02,
   "end": 392.1,
   "text": "همش از رو کرم و کریمیتم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 392.1,
   "end": 393.86,
   "text": "حالا خب من چه کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 393.86,
   "end": 397.18,
   "text": "خدایا من میخوام تورو بخونم. چجوری تورو بخونم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 397.18,
   "end": 401.12,
   "text": "عجب! اینجا سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 401.12,
   "end": 403.54,
   "text": "باز میشه. میگه الذي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 403.54,
   "end": 405.96,
   "text": "علم بالقلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 405.96,
   "end": 409.7,
   "text": "یعنی بعد از خلقت، موضوع خلقت ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 409.7,
   "end": 413.5,
   "text": "اونم بر اساس کریمیت خدا، کرم خدا، حب خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 413.5,
   "end": 416.92,
   "text": "ما میخوایم خدا رو بخونیم باید حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 416.92,
   "end": 423.38,
   "text": "اولین توقع خدا از ما همین تعلیم و علم و آگاهی و معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 423.38,
   "end": 428.02,
   "text": "خودشم میگه الذي اون خدایی که تو میخوای بخونیش این خصوصیتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 428.02,
   "end": 432.38,
   "text": "بدون اگر میخوای بخونی اولین چیزی که بهش توجه داشته باش اینه که بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 432.38,
   "end": 434.7,
   "text": "خدا الذي کسی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 434.7,
   "end": 436.76,
   "text": "علم بالقلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 436.76,
   "end": 441.26,
   "text": "بحث تعلیمو میاره. بعد علم الانسان ما لم يعلم و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 441.26,
   "end": 446.3,
   "text": "آیه دو سوره جمعه هم هو الذي بعث، بعث برانگیخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 446.3,
   "end": 451.84,
   "text": "کرد خدا في الاميين رسولا منهم که این بحث‌ها گذشته قبلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 451.84,
   "end": 456.0,
   "text": "برای چی پیغمبر اومده؟ يتلو عليهم آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 456.0,
   "end": 460.68,
   "text": "این تلاوت قرآن، این تذکره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 460.68,
   "end": 464.4,
   "text": "يتلو عليهم آياته و یزکیهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 464.4,
   "end": 467.52,
   "text": "این تزکیه است. اون تذکره است، این تزکیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 467.52,
   "end": 470.84,
   "text": "و يعلمهم الكتاب و الحكمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 470.84,
   "end": 474.72,
   "text": "کتاب و حکمت. حالا اینجا چرا کتاب و حکمت است باید بعدا بحث کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 474.72,
   "end": 477.1,
   "text": "میره این سه تا تذکره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 477.1,
   "end": 479.62,
   "text": "تزکیه، تعلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 479.62,
   "end": 484.1,
   "text": "این سه تا وظیفه ماست. اگر بخواهیم خدا رو بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 484.1,
   "end": 487.62,
   "text": "باید برای علم، این نقطه ایه که الان بهش رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 487.62,
   "end": 490.64,
   "text": "این همه من زیرو زدم. برای علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 490.64,
   "end": 493.58,
   "text": "برای آگاهی و معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 493.58,
   "end": 502.04,
   "text": "ارزش قائل بشیم. اگر کسی تو زندگیش برای علم و آگاهی که جایگاهشو معلوم تو قرآن به یک نگاهی درآوردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 502.04,
   "end": 505.24,
   "text": "ارزش قائل نشه، این تو امتحاناتش باخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 505.24,
   "end": 510.6,
   "text": "اصلا یکی از و همینطور که دیروز گفتیم از سنگین‌ترین وادی‌های،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 510.6,
   "end": 513.7,
   "text": "وادی امتحان خدا از بنده‌ش وادی ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 513.7,
   "end": 519.8,
   "text": "الان می‌تونیم بگیم شاید سنگین‌ترین وادی بعد از ولایت علم و آگاهی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 519.8,
   "end": 522.04,
   "text": "منو تو رو با علم و آگاهیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 522.04,
   "end": 525.44,
   "text": "آزمایش می‌کنند. برای همینه حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 525.44,
   "end": 530.82,
   "text": "می‌فرماید که و هفتاد گناه در کافی کلینی رحمة الله علیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 530.82,
   "end": 533.48,
   "text": "هفتاد گناه از جاهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 533.48,
   "end": 535.96,
   "text": "بخشیده میشه در حالی که یه دونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 535.96,
   "end": 539.86,
   "text": "گناه از عالم بخشیده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 539.86,
   "end": 543.6,
   "text": "توجه بکنید این امتحانه نسبت به علم و آگاهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 543.6,
   "end": 547.06,
   "text": "ما نسبت به علم و آگاهی چقدر ارزش قائلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 547.06,
   "end": 550.68,
   "text": "بعد جالب اینجاست که شما بدونید بعد، بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 550.68,
   "end": 556.16,
   "text": "خطاب خدا به ما که به خدای خودت رو بخون بحث خلقتو میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 556.16,
   "end": 561.52,
   "text": "اون خدا تو رو به گونه‌ای خلق کرده که بتونی همونو بخونی و الا نمیگفتی ربک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 561.52,
   "end": 563.6,
   "text": "اصلا ما اومدیم که خدا رو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 563.6,
   "end": 565.6,
   "text": "اما با چی بخونیم؟ چجوری بخونیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 565.6,
   "end": 567.54,
   "text": "با علم و آگاهی، با معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 567.54,
   "end": 570.34,
   "text": "نماز بدون معرفت سیه چای ارزش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 570.34,
   "end": 574.88,
   "text": "لذا امیرالمؤمنین علیه الصلاة والسلام پناه برده به خدا از نماز بدون حضور قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 574.88,
   "end": 576.98,
   "text": "یعنی بدون معرفت. نفهمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 576.98,
   "end": 579.88,
   "text": "قد قامت، قامت الصلاة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 579.88,
   "end": 581.66,
   "text": "میگه نماز قیام کرد. عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 581.66,
   "end": 583.88,
   "text": "پس نمازی حقیقتیه قیام کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 583.88,
   "end": 585.58,
   "text": "کو؟ من چیزی نمیبینم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 585.58,
   "end": 589.7,
   "text": "من نشستم که. این چه نمازی، چه حقیقتیه که قیام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 589.7,
   "end": 593.54,
   "text": "قد قامت الصلاة. حالا رو اینا بحث کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 593.54,
   "end": 597.98,
   "text": "بعد خدای منان، این نکته آخرم باشه دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 597.98,
   "end": 602.8,
   "text": "اگرچه من الان تازه به مدخل بحث رسیدم اما چه کنیم ده دقیقه ما وقت داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 602.8,
   "end": 605.16,
   "text": "ای کاش فرصت داشتیم می‌نشستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 605.16,
   "end": 609.9,
   "text": "هفته‌ای یکی دو بار ساعتی با هم بحث می‌کردیم پیرامون این حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 609.9,
   "end": 612.98,
   "text": "که چقدر انسان ذهنش باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 612.98,
   "end": 616.78,
   "text": "خدایی که خالق من و توست و ما وظیفه داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 616.78,
   "end": 620.72,
   "text": "قرائتش کنیم با تمام شئون وجودیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 620.72,
   "end": 627.06,
   "text": "بعد از خلقت میگه ما بحث تعلیم رو میگه یعنی من تورو به گونه‌ای آفریدم که بتونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 627.06,
   "end": 629.14,
   "text": "آگاهی‌های لازم رو برداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 629.14,
   "end": 632.38,
   "text": "همه مطلق علوم رو تو می‌تونی برداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 632.38,
   "end": 635.6,
   "text": "اگر نمی‌تونستی من اقرأ نمی آوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 635.6,
   "end": 639.24,
   "text": "لذا شیخ الرئیس خیلی جالبه در کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 639.24,
   "end": 643.48,
   "text": "که اهل تحقیق و عمق‌ند می‌دونن در اشاراتش یه جمله عجیبی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 643.48,
   "end": 647.66,
   "text": "اینو بگم بسه. می‌فرماید که شما دقت کنید همین الان شماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 647.66,
   "end": 652.78,
   "text": "خطاب اصلا فکر کنید شیخ الرئیس الان داره با شما حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 652.78,
   "end": 657.62,
   "text": "تو کتاب اشاراتش میگش دقت کنید بین آدم‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 657.62,
   "end": 661.18,
   "text": "عده‌ای، اوهدی، یه عده قلیلی هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 661.18,
   "end": 663.34,
   "text": "شاید یکی دو درصد که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 663.34,
   "end": 665.26,
   "text": "اصلا نمی‌تونیم نگاهشون کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 665.26,
   "end": 667.28,
   "text": "انقدر کریه المنظر شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 667.28,
   "end": 670.78,
   "text": "اصلا فطرتشون رو باختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 670.78,
   "end": 678.88,
   "text": "و مسخ شدن. اصلا چهره‌شون داد می‌زنه به قول امیرالمؤمنین علیه الصلاة والسلام این‌ها حیوان پست‌تر از غلهم ازلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 678.88,
   "end": 681.56,
   "text": "خب این تکلیف اینا. عده‌ای هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 681.56,
   "end": 683.88,
   "text": "که انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 683.88,
   "end": 686.42,
   "text": "راه رو درست رفتن و به خدا نزدیک شدن، در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 686.42,
   "end": 690.82,
   "text": "چهره اثر کرده همه دوست دارن با اینا زیارت کنن، باهاشون نشست و برخاست داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 690.82,
   "end": 693.46,
   "text": "اینام کمن. اینام خیلی کم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 693.46,
   "end": 696.12,
   "text": "بعد شیخ الرئیس میگه ببینید خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 696.12,
   "end": 702.06,
   "text": "بین این دو که اقلیت رو تشکیل میدن اکثریت چهره متعارف دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 702.06,
   "end": 704.86,
   "text": "مثل همین الان ماها، من و شماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 704.86,
   "end": 707.86,
   "text": "چرا چهره متعارف دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 707.86,
   "end": 709.4,
   "text": "تو نه بدت میاد نه خوشت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 709.4,
   "end": 712.02,
   "text": "یعنی مستعدن. این برداشت شیخ الرئیسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 712.02,
   "end": 717.76,
   "text": "یعنی مستعدن که بتونن اینها هم رشد کنن و برسن بهترین‌ها بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 717.76,
   "end": 719.88,
   "text": "و الا مسخ میشد چهره‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 719.88,
   "end": 723.58,
   "text": "خودمون رو دریابیم تا دیر نشده در این امتحانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 723.58,
   "end": 726.54,
   "text": "نبازیم خودمون رو. سؤال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 726.54,
   "end": 729.78,
   "text": "مدخل ورودی جلسه بعدمون اگر زنده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 729.78,
   "end": 732.08,
   "text": "ما نسبت به علم و آگاهی چه کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 732.08,
   "end": 734.54,
   "text": "نسبت به همین علوم، معارف چه کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 734.54,
   "end": 739.04,
   "text": "چه کردیم تو زندگیمون؟ در حالی که تکلیف سنگینی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 739.04,
   "end": 743.64,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 743.64,
   "end": 750.62,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}