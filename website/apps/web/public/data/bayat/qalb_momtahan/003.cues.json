 "chapters": [
  {
   "index": 0,
   "title": "## سفر شغلی و سفر تحصیلی",
   "start": 0.46,
   "end": 46.0
  },
  {
   "index": 1,
   "title": "## ایام الله و امتحان قلب",
   "start": 46.0,
   "end": 217.16
  },
  {
   "index": 2,
   "title": "## حدیث نبوی ازکا عندالله",
   "start": 217.16,
   "end": 237.66
  },
  {
   "index": 3,
   "title": "## قلب ممتحن و عمل در دهه",
   "start": 237.66,
   "end": 622.43
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 3.0,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.0,
   "end": 6.1,
   "text": "السلام علیک یا ولی الله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.1,
   "end": 11.28,
   "text": "ولی ولیه ایاته. السلام علیک و رحمة الله وبركاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.28,
   "end": 20.54,
   "text": "عرض کردند که اگر سفر شغلی که حداقل ده روز یکبار برای سفر بر انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.54,
   "end": 23.26,
   "text": "و این سفر شغلی حساب بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.26,
   "end": 28.7,
   "text": "چنین کسی اگر حد-- عرض کردیم حداقل ده روز یک بار بره بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.7,
   "end": 32.5,
   "text": "نمازش کامله و مسافر حساب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.5,
   "end": 37.04,
   "text": "حالا از رهبر عزیزمون سؤال شده که اگر کسی برای تحصیل بره چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.04,
   "end": 41.58,
   "text": "شغل نیست. برای تحصیل بره دانشجوعه یا هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.58,
   "end": 43.76,
   "text": "اینجا دو تا حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.76,
   "end": 49.5,
   "text": "در جواب دو تا استفاء، استفتای شبیه به هم دو تا نظر دادن اینا رو با هم تفکیک بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.5,
   "end": 56.7,
   "text": "خیلی مهمه. اینجایی که صرفا برای تحصیل میره دانشجوعه فرمودن این مسافره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.7,
   "end": 59.04,
   "text": "و سفرش شغلی حساب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.04,
   "end": 62.92,
   "text": "اما اگر برای تحصیل رفت لکن مأموریتی رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.92,
   "end": 65.02,
   "text": "اینو توجه کنید، این فرق میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.02,
   "end": 68.92,
   "text": "یعنی اداره اون رو موظف کرد برو اونجا تحصیل کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.92,
   "end": 71.04,
   "text": "حالا بورسیه گرفت یا هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.04,
   "end": 73.2,
   "text": "مأموریت اداری رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.2,
   "end": 76.5,
   "text": "اون تحصیلش جزو شغلش حساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.5,
   "end": 80.32,
   "text": "این هم چی میشه؟ میگه مسافر حساب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.32,
   "end": 84.24,
   "text": "نمازشو کامل باید بخونه و روزه‌شم بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.24,
   "end": 90.2,
   "text": "یه نکته‌ای رو امروز عرض کنم که هشدار، هشدار برای خودم حدیث نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.2,
   "end": 96.0,
   "text": "ما چون بحث قلب مورد امتحان واقع شده رو داریم میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.0,
   "end": 103.6,
   "text": "عرض کنم که یکی از چیزهایی که خدا قلب مؤمن رو باهاش امتحان میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.6,
   "end": 106.54,
   "text": "ایام الله. ظرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.54,
   "end": 110.32,
   "text": "زمانی‌ست. \"فمن يعظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.32,
   "end": 114.26,
   "text": "شعائر الله فانها من تقى القلوب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.26,
   "end": 119.56,
   "text": "فرمودن یکی از اون شعائر الهی ایام الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.56,
   "end": 122.42,
   "text": "این روزهای خدایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.42,
   "end": 126.74,
   "text": "یعنی امتحان میشیم من و تو با روزها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.74,
   "end": 130.62,
   "text": "و یکی از اون بهترین روزهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.62,
   "end": 134.12,
   "text": "ما درش قرار گرفتیم دهه اول ذی الحجه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.12,
   "end": 138.46,
   "text": "ما الان، همین الان در حال امتحان با این دهه هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.46,
   "end": 142.72,
   "text": "امروز روز دومه. وای به حال مؤمنی، این هشداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.72,
   "end": 145.94,
   "text": "وای به حال مؤمنی که این دهه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.94,
   "end": 150.28,
   "text": "یا این ایامش با ایام دیگه‌ش یکی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.28,
   "end": 154.52,
   "text": "متفاوت نباشه. اونکه بدتر باشه که هیچی، اون دیگه دوزخیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.52,
   "end": 157.12,
   "text": "اما اونی هم که متفاوت نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.12,
   "end": 162.12,
   "text": "این ایامش هم مثل ایام دیگه‌ش باشه دهن کجی بدی به ایام الله کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.12,
   "end": 165.94,
   "text": "ایام الله انقدر نزد خدا عظمت دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.94,
   "end": 170.46,
   "text": "که خدا صراحتا تو قرآن میفرماید به موسی گفتیم بهشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.46,
   "end": 173.66,
   "text": "ایام الله رو تذکر بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.66,
   "end": 179.82,
   "text": "به قومت. ایام الله خیلی‌ هست، یکیش زمان ظهور يوم الله الاعظمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.82,
   "end": 181.9,
   "text": "یکیش جمعه‌ست. یکیش این ایامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.9,
   "end": 186.84,
   "text": "\"و اذكروا الله فی ایام معدودات\" تو قرآن اومده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.84,
   "end": 191.0,
   "text": "یاد خدا رو بکنید تو ایام معدودات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.0,
   "end": 195.76,
   "text": "این ایامی که عددش کاملا مشخصه نزد خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.76,
   "end": 202.28,
   "text": "در زیل این آیه شریفه اهل بیت علیهم السلام فرمودن منظور این دهه اول ذی الحجه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.28,
   "end": 206.7,
   "text": "خیلی روز مهم، ایام مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.7,
   "end": 212.78,
   "text": "حالا حداقل اونایی که چله نتونستیم بگیریم از کل، چله کلیمیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.78,
   "end": 214.36,
   "text": "این دهه رو مراقبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.36,
   "end": 216.96,
   "text": "دیروز حواسمون نباشه از امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.96,
   "end": 221.02,
   "text": "این حدیث نبوی رو دقت کنید که خیلی پیام توشه، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.02,
   "end": 231.0,
   "text": "من به جرئت قسم میخورم در این مکان مقدس که با این حدیث میشه ده ها منبر پرپیمانه رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.0,
   "end": 233.32,
   "text": "پیغمبر فرمود: \"ما من ایام\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.32,
   "end": 240.84,
   "text": "هیچ روزی نیست، هیچ روزهایی نیستند \"ازکا عندالله تعالی\" به خدا قسم غوغاست تو این حدیث نبوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.84,
   "end": 244.14,
   "text": "ازکا. اصلا اینجا ازکا یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.14,
   "end": 245.8,
   "text": "زکی بعد از سه زکات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.8,
   "end": 253.88,
   "text": "شما یه مدت اینجا داشتیم به واسطه اینکه تو رادیو اقتصاد زکات رو داشتیم صحبت میکردیم، اینجا هم دامنش کشیده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 253.88,
   "end": 258.34,
   "text": "زکی یا زکات از ریشه زکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.34,
   "end": 261.46,
   "text": "به یک معنا رشد و نمو بود، توسعه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.46,
   "end": 264.12,
   "text": "به یک معنا پاکیزگی بود. یادتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.12,
   "end": 268.58,
   "text": "حالا به هر معنایی که بگیریم میگه \"ازکا عندالله تعالی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.58,
   "end": 275.26,
   "text": "این ظرف مکانی بالاخره ما اعمالمون در یک ظرف زمانی و یک ظرف مکانی قرار میگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.26,
   "end": 277.66,
   "text": "الان ما ظرف زمانی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.66,
   "end": 281.54,
   "text": "الان شما البته تو این مسجد، تو این نمازخونه ظرف مکانتونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.54,
   "end": 283.66,
   "text": "ظرف زمان میشه این ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 283.66,
   "end": 290.62,
   "text": "دقت کردید هیچ وقت شما معمولا گاهی اوقات میرید اصلا یه چیزی رو می خرید به خاطر ظرفش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.62,
   "end": 294.18,
   "text": "بسته‌بندی، اصلا بسته‌بندی امروز تو صنایع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.18,
   "end": 297.86,
   "text": "تولیدی، صنایع مثلا غذایی اینا حرف اول رو میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.86,
   "end": 301.94,
   "text": "اصلا نوع بسته‌بندی به چه شکلی باشه که طرف حریص بشه بخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 301.94,
   "end": 306.4,
   "text": "گاهی اوقات خود من رفته‌م یه چیزی رو خریدم به خاطر خود بسته، اون ظرفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 306.4,
   "end": 308.9,
   "text": "که اون چیز درش قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 308.9,
   "end": 313.32,
   "text": "الان ظرف زمان به قدری نزد خدا قیمت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.32,
   "end": 316.42,
   "text": "میگه \"ازکا\" بر وزن افعل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 316.42,
   "end": 318.78,
   "text": "یعنی گرامید، اولا بزرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.78,
   "end": 322.46,
   "text": "اگه به معنای رشد بگیریم، نمو بگیریم، ظرفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.46,
   "end": 327.74,
   "text": "رشدیافته‌تر و بزرگ‌تر و موسع‌تر از این ایام نداریم نزد خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.74,
   "end": 330.78,
   "text": "هرچی میخوای توش بریز پر نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.78,
   "end": 332.78,
   "text": "این یک. کسایی که ظرفیتشون کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.78,
   "end": 337.42,
   "text": "حالا این خودش یه بابیه. حالا تو همین قصه میدونید چقدر حرف‌ها زدن بزرگان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.42,
   "end": 339.96,
   "text": "بحث سعه وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 339.96,
   "end": 346.04,
   "text": "نکته دوم اگر به معنای پاکی بگیریم، هیچوقت شما تو ظرف ناپاک هیچی نمیخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.04,
   "end": 348.22,
   "text": "همیشه تو ظرفی که پاکیزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.22,
   "end": 353.12,
   "text": "وقتی میگن آقا این ظرف اصلا استریلیزه شده با خیال راحت همه چی توش میریزی میخوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 353.12,
   "end": 359.08,
   "text": "میگه آقا هرچی داری بریز تو این ظرف، این ظرف زمان این ده روز اگر به معنای پاکی هم بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 359.08,
   "end": 361.77,
   "text": "میگه آقا بریز هرچی داری بریز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.77,
   "end": 365.47,
   "text": "خدا می‌خره. خدا به ظرفه نگاه می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.47,
   "end": 368.53,
   "text": "می‌خره و هرچی هم داری بریز پر نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.53,
   "end": 371.41,
   "text": "این یه دو تا معنا. بعد تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.41,
   "end": 378.15,
   "text": "دیگه سنگ تموم میذاره پیغمبر \"ولأأعظم أجراً من خير\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 378.15,
   "end": 383.73,
   "text": "الله اکبر. از این خیرش و از این أعظم أجراًش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.73,
   "end": 386.37,
   "text": "میگه آقا حالا من می‌خوام از تو بخرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.37,
   "end": 390.23,
   "text": "بیشترین پولو بهت میدم. کِی تو طی سال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.23,
   "end": 392.69,
   "text": "کِی می‌تونی بری معامله کنی، تجارت کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 392.69,
   "end": 394.85,
   "text": "که بیشتر از همه الان میگه آقا امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.85,
   "end": 399.57,
   "text": "زمينتو نفروش، خونه تو نفروش، جنس تو، ماشینتو بذار دو روز دیگه گرون میشه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.57,
   "end": 402.29,
   "text": "میگه آقا ولا أعظم أجراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.29,
   "end": 407.23,
   "text": "اصلاً نیست. هیچ وقتو شما پیدا نمی‌کنی که بیشتر از الان خدا ازت بخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.23,
   "end": 409.39,
   "text": "اونم به خاطر این ظرف زمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.39,
   "end": 415.75,
   "text": "بگه بسم الله بفروش هرچی داری الان به خدا بفروش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 415.75,
   "end": 419.65,
   "text": ". جانتم می‌خوای تو این ایام بفروش، تو این دهه بفروش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.65,
   "end": 423.39,
   "text": "بعد جالبه می‌فرماید \"من خير\" خب خود خیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.39,
   "end": 426.03,
   "text": "غوغاست. اصلاً خیر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.03,
   "end": 431.37,
   "text": "که البته به یه معنا در روایت ولایت امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 431.37,
   "end": 437.21,
   "text": "خیر مطلق. میگه آقا اصلاً وادی ولایت هم تو همین ماه زده میشه پی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.21,
   "end": 440.39,
   "text": "پر میشه پیمانه‌ش، مهرش زده میشه همین ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.39,
   "end": 442.81,
   "text": "آقا غوغاست این ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.81,
   "end": 446.09,
   "text": "به خدا اگه بدونین چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 446.09,
   "end": 452.75,
   "text": "بعد می‌فرماید \"فيه عشر الأوحى\" این دهه، ده شب پرنور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.75,
   "end": 455.67,
   "text": "به یک معنا البته به یک روایت این ده روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 455.67,
   "end": 465.53,
   "text": "که حالا \"والفجر ولیل عشر\" هم تو اون آیه، سوره الفجر هم فرمودن روایت داریم ذیل اون آیات که همین ده روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 465.53,
   "end": 467.61,
   "text": "انقدر این ده روز پیش خدا ارز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 467.61,
   "end": 471.37,
   "text": "حالا یه بالاخره یه تغییری تو این چند روز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 471.37,
   "end": 474.01,
   "text": "یه فکری بکنیم، یه ذره تغییر بدیم بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 474.01,
   "end": 479.45,
   "text": "نمی‌دونم حالا حتی شاید چله می‌خواستی شروع کنی عیبی نداره جا موندی از چله از امروز شروع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 479.45,
   "end": 482.53,
   "text": "چه اشکالی داره؟ آقا أزکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 482.53,
   "end": 484.51,
   "text": "آقا أعظم أجراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 484.51,
   "end": 489.21,
   "text": "دیگه بالاتر از این نیست. و جالب‌تر از این، بذار یه چیز دیگه بگم تکون بخورم خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 489.21,
   "end": 493.21,
   "text": "هشداره به خدا قسم. گوش ما رو این ایام می‌پیچونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.21,
   "end": 498.39,
   "text": "\"الذین امتحن الله قلوبهم للتقوی\" ذیل این آیه داریم بحث می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 498.39,
   "end": 504.41,
   "text": "قلوبی که مورد امتحان خدا قرار می‌گیرن یکیش از طریق همین ظرف‌های زمانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.41,
   "end": 506.63,
   "text": "آقا چه کردی در این ده روز؟ این حدیث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 506.63,
   "end": 509.95,
   "text": "حدیث نبویه. آوازه گوش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.95,
   "end": 512.37,
   "text": "از پیغمبر از عظمت این ده روز پرسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.37,
   "end": 515.67,
   "text": "اصلاً همین هدیه حدیث بسه برای امروز ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 515.67,
   "end": 518.83,
   "text": "آقا جان این ده روز حضرت فرمود آقا جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 518.83,
   "end": 524.87,
   "text": "این ده روز عملی که درش انجام میدید جالبه نه فرمودن این ده روز دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 524.87,
   "end": 527.73,
   "text": "عملی که تو در این ولو یک صلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 527.73,
   "end": 530.17,
   "text": "در این ده روز انجام میدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 530.17,
   "end": 535.53,
   "text": "به خدا فرق می‌کنه صلواتی که حتی تو، تو این ده روز می‌فرستی با غیر این ده روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 535.53,
   "end": 541.89,
   "text": "فرق می‌کنه همونطور که صلواتی که رو زمین، رو ارز، رو کره خاکی انجام میدی یا تو آسمون یا تو عرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.89,
   "end": 544.43,
   "text": "اینام فرق می‌کنه؟ بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 544.43,
   "end": 551.47,
   "text": "صلوات رو زمین میگه \"اللهم صل على محمد وآل محمد وعجل فرجهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 551.47,
   "end": 554.23,
   "text": "حتی لفظشم فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 554.23,
   "end": 556.43,
   "text": "صلوات تو آسمونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 556.43,
   "end": 559.99,
   "text": "\"اللهم صل على أحمد وآل أحمد وعجل فرجه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 559.99,
   "end": 563.03,
   "text": "صلوات تو عرش باز فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.03,
   "end": 566.05,
   "text": "\"اللهم صل على محمود وآل محمود\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 566.05,
   "end": 568.35,
   "text": "روایات-- آقا فرق می‌کنه زمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 568.35,
   "end": 570.87,
   "text": "مکان، تغییر میده موضوع رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 570.87,
   "end": 576.71,
   "text": "حالا اینجا می‌فرماد که پیغمبر فرمود: عملی که تو در این ده روز انجام میدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 576.71,
   "end": 581.25,
   "text": "حتی از جهاد در راه خدا برتر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 581.25,
   "end": 584.19,
   "text": "کی آرزو داشته بره جبهه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 584.19,
   "end": 587.11,
   "text": "و حتی شهید در راه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.11,
   "end": 589.29,
   "text": "این حرف پیغمبره. مگر یه جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 589.29,
   "end": 592.11,
   "text": "پیغمبر فرمود فقط یه جاست که نه دیگه اون می‌چربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 592.11,
   "end": 599.45,
   "text": "اونم شهیدی که مال و جان و همه دارایی‌شو برداره بره جبهه هیچ‌کدومو برنگردونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 599.45,
   "end": 604.17,
   "text": "یعنی نه جسمش بیاد، نه جانش برگرده، نه مالش و هیچی برنگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 604.17,
   "end": 606.39,
   "text": "همه چیشو فدا بده. اون دیگه بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.39,
   "end": 611.77,
   "text": "اون چیه؟ حالا ببین این چیه که اون یه رتبه از این بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 611.77,
   "end": 614.09,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 614.09,
   "end": 617.01,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 617.01,
   "end": 622.43,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}