 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتا؛ آیین‌نامهٔ داخلی موقوفه و نیت واقف",
   "start": 12.6,
   "end": 160.62
  },
  {
   "index": 1,
   "title": "## قلب ممتحن؛ لیبتلی و لیمحص",
   "start": 160.62,
   "end": 261.0
  },
  {
   "index": 2,
   "title": "## فتنه در مجمع البیان؛ گنج پنهان کمالات",
   "start": 261.0,
   "end": 337.44
  },
  {
   "index": 3,
   "title": "## دو وجه امتحان؛ جملهٔ بهاءالدینی",
   "start": 337.44,
   "end": 454.4
  },
  {
   "index": 4,
   "title": "## حدیث دو خیانت؛ حد خود را شناختن",
   "start": 454.4,
   "end": 538.56
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.06,
   "end": 4.5,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.5,
   "end": 8.3,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.3,
   "end": 12.6,
   "text": "آیات سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.6,
   "end": 16.58,
   "text": "اگر چنانچه کسی وقفی را انجام بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.58,
   "end": 22.84,
   "text": "حالا چه ملک، چه لوازمی رو به جایی وقف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.84,
   "end": 27.04,
   "text": "پرسیدن که اگر بخواهیم بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.04,
   "end": 30.62,
   "text": "حالا آیین‌نامه داخلی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.62,
   "end": 39.02,
   "text": "موقوفه، حالا مثلاً یه ملکی رو یه کسی وقف مسجد، حسینیه یا محل قرآن خوندن هرچی کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.02,
   "end": 43.74,
   "text": "اون هیئت امنای اونجا بخوان یک آیین‌نامه داخلی بریزن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.74,
   "end": 51.38,
   "text": "بر یه حالا دستورالعملی رو تبیین کنن برای اینکه از اینجا چگونه استفاده کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.38,
   "end": 56.56,
   "text": "یا نه اصلا یه کسی یه چیزی رو نذر و وقف یه هیئتی کرده، یه وسیله‌ای، دیگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.56,
   "end": 60.22,
   "text": "فرشی، پرچمی هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.22,
   "end": 68.02,
   "text": "اون کسایی که هیئت امنای اونجا هستن میخوان آیین‌نامه داخلی بریزن که چجوری از این وسایل استفاده کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.02,
   "end": 72.52,
   "text": "سؤال اینجاست که تا چه حد دستشون بازه از این ملک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.52,
   "end": 76.32,
   "text": "و از این لوازم چگونه می‌تونند بهره بگیرند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.32,
   "end": 82.56,
   "text": "رهبر عزیزمون فرمودند که کاملاً باید مطابق با نیت واقف باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.56,
   "end": 88.84,
   "text": "آنچه که واقف می‌آ-- تو حرم علی ابن موسی الرضا علیهم السلام با اینکه حرم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 88.84,
   "end": 91.78,
   "text": "شما دقت فرمودید بعضی از صحن‌هاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.78,
   "end": 94.12,
   "text": "مثل بالای دارالهدایه، اونور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.12,
   "end": 97.64,
   "text": "یه صحنی هست تقریباً اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.64,
   "end": 103.32,
   "text": "رو به روی حضرت می‌ایستی پشت به قبله نوشته \"ادخلوها بسلام آمین\" دست راستت یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.32,
   "end": 105.92,
   "text": "دالان طوریه. اونجا دقیقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.92,
   "end": 110.38,
   "text": "صبح‌ها علی التلو یه دفعه همه زائرها رو جمع می‌کنند بیرون می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.38,
   "end": 113.88,
   "text": "چرا؟ می‌شینن یه دو-- یه ختم قرآن می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.88,
   "end": 123.06,
   "text": "اونجا هم اون کاشی‌های دیوار نوشته واقف اونجا واقف اون ملک که قبلاً جزو حرم نبوده بعد وقف کرده که جزو حرم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 123.06,
   "end": 126.34,
   "text": "حالا هزار سال پیش چقدر بوده نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.34,
   "end": 128.36,
   "text": "نوشته، اونجا نوشته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.36,
   "end": 130.96,
   "text": "باید هر روز اینجا ختم قرآن بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.96,
   "end": 137.96,
   "text": "خب اون حالا متولی آستان قدس باید حواسش به این باشه هر کاری اونجا می‌کنه باید مطابق نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 137.96,
   "end": 141.0,
   "text": "باشه. نیت واقف. هر اون ظرف و ظروف و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.0,
   "end": 142.78,
   "text": "این‌ها هم همه باید مطابق با این شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.78,
   "end": 149.02,
   "text": "نمی‌شه که همینطوری طرف خودش مثلاً یه سری کتاب رو یکی وقف هیئت کرده، کتابخونه درست کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 149.02,
   "end": 153.9,
   "text": "یه دفعه بگن آقا این کتاب‌ها رو بفروشید بریم باهاش مثلا بر-- ملاقه بخریم برای آشپزخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.9,
   "end": 157.4,
   "text": "حق این کار رو نداری. اون طرف نذر هیئت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.4,
   "end": 160.62,
   "text": "حق حتی بدل به حسن‌ش رو هم نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.62,
   "end": 163.58,
   "text": "بحث ما پیرامون قلب ممتحن بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.58,
   "end": 167.26,
   "text": "و اینکه خدای منان قلوب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.26,
   "end": 169.78,
   "text": "مورد امتحان قرار می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.78,
   "end": 172.82,
   "text": "دقت بفرمایید یکی از آیاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.82,
   "end": 177.48,
   "text": "صراحتا این بحث رو بیان کرده آیه صد و پنجاه و چهار سوره آل عمران هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.48,
   "end": 180.52,
   "text": "می‌فرماید \"و لیبتلی الله ما فی صدورکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.52,
   "end": 184.1,
   "text": "شاید سؤال بشه آقا برای چی خدا امتحان می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.1,
   "end": 187.16,
   "text": "امتحان خدا برای چیه از ماها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.16,
   "end": 191.9,
   "text": "اینجا صراحتا این آیه می‌فرماید \"و لیبتلی الله ما فی صدورکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.9,
   "end": 194.68,
   "text": "\"فی صدورکم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.68,
   "end": 199.58,
   "text": "برای اینکه خدا اونچه که در سینه‌هاتون پنهان کردید رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.58,
   "end": 203.54,
   "text": "\"لیبتلی الله\" این‌ها رو بیازماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.54,
   "end": 208.92,
   "text": "خدا. \"و لیمحص ما فی قلوبکم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.92,
   "end": 212.94,
   "text": "تا اونچه که در دل‌های شماست خالص بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.94,
   "end": 216.44,
   "text": "با این امتحانات. این فلسفه دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.44,
   "end": 220.7,
   "text": "حالا اینجا سؤال پیش میاد که آیا خدا بی‌خبر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.7,
   "end": 223.3,
   "text": "از دل‌ها؟ آیا خدا خبر داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.3,
   "end": 226.64,
   "text": "اگه خبر داره پس چرا داره امتحان می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 226.64,
   "end": 231.34,
   "text": "خدا اصلاً خودش انتهای آیه می‌فرماید \"والله علیم بذات الصدور\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.34,
   "end": 233.68,
   "text": "خدا خبر داره به ذات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.68,
   "end": 237.14,
   "text": "ذات سینه‌ها. آنچه که در ما فی الذمیر شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.14,
   "end": 243.54,
   "text": "پس اصلاً ربطی به باخبر شدن خدا یا اعتبار الهی ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.54,
   "end": 247.54,
   "text": "این آیه صراحتا داره می‌فرماید که آقا جون برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.54,
   "end": 252.4,
   "text": "شما خالص بشید. اصل تمهیز رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.4,
   "end": 258.26,
   "text": "میگه دل‌هاتون از اون آلودگی‌ها، از اون زنگارها پاک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.26,
   "end": 261.0,
   "text": "تو امتحانات قرار می‌گیرید. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.0,
   "end": 267.28,
   "text": "خدا رحمت کنه مرحوم تبریزی رحمة الله علیه رو امروز می‌دیدم در مجمع البيانش جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.28,
   "end": 270.84,
   "text": "اصلاً بحث فتنه و امتحان و این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.84,
   "end": 273.46,
   "text": "می‌فرمود معنای دقیقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.46,
   "end": 276.98,
   "text": "قرار دادن طلا در بوته آتش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 276.98,
   "end": 280.74,
   "text": "چرا؟ که خالص از ناخالص جدا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 280.74,
   "end": 283.34,
   "text": "فتنه، بلا، آزمایش، امتحان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 283.34,
   "end": 288.34,
   "text": "اصلاً کار خدا اینه. و جالب اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.34,
   "end": 293.94,
   "text": "استاد سبحانی در منشور جاویدشون جلد یک، صفحه دویست و شصت و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.94,
   "end": 296.64,
   "text": "که البته جالبه که همین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 296.64,
   "end": 303.56,
   "text": "همین مضمون رو آقای مکارم، مکارم هم در تفسیر نمونه‌شون جلد یک، صفحه پانصد و بیست و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.56,
   "end": 307.78,
   "text": "اینچنین فرمودند که بنابراین اگر امتحان و آزمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.78,
   "end": 312.34,
   "text": "در کار نبود، یه بحثی رو میارن بعد اینچنین نتیجه می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.34,
   "end": 315.66,
   "text": "اگر امتحان نبود، آزمایش نبود چی می‌شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 315.66,
   "end": 321.88,
   "text": "کمالات نهفته در درون افراد به صورت گنج پنهانی باقی می‌ماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.88,
   "end": 324.16,
   "text": "و خود را نشان نمی‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 324.16,
   "end": 328.12,
   "text": "یعنی نشون میده اصلاً خدا می‌خواد تو به کمال برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 328.12,
   "end": 330.6,
   "text": "اون گنج‌های درونی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.6,
   "end": 334.84,
   "text": "بروز پیدا کنه. تو خودت، خودت رو به خدا که نیاز به شناخت ما نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.84,
   "end": 338.1,
   "text": "خودت، خودت رو بشناسی. البته این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.1,
   "end": 340.36,
   "text": "دو وجهیه دیگه. گاهی اوقات میگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.36,
   "end": 342.42,
   "text": "فلان مدیر فلان، فلان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.42,
   "end": 344.5,
   "text": "ببین چه گندی بالا آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 344.5,
   "end": 348.54,
   "text": "اگه من بودم بعد یه دفعه می‌بینی خدا میذاره تو کاسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.54,
   "end": 352.26,
   "text": "یه مدیریت بهت میده گندتر از اون بالا میاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 352.26,
   "end": 354.54,
   "text": "فهمیدی؟ می‌بینی تو خودتم این کارا نبودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.54,
   "end": 356.78,
   "text": "خودت شناخت خوده. اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.78,
   "end": 358.98,
   "text": "ظرفیت خودت رو بشناسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.98,
   "end": 361.54,
   "text": "گنده‌تر از دهن خودت حرف نزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.54,
   "end": 364.42,
   "text": "یا بالعکسش هم هست. عرض کردم دو وجهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.42,
   "end": 368.58,
   "text": "احتمال داره یکی خرابکاری کنه و تو متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 368.58,
   "end": 370.66,
   "text": "توانمندی داخلی خودت بشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.66,
   "end": 376.96,
   "text": "خدا در تو این توانایی رو قرار داده بری اون بار رو ورداری و تو به سرمنزل برسونی و تو س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.96,
   "end": 380.04,
   "text": "اینجا سر بلند بشی اون کار رو انجام بدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.04,
   "end": 383.38,
   "text": "رشد کنی. مثلا خود رهبر عزیزمون ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.38,
   "end": 386.26,
   "text": "خدا رحمت کنه آقای بهادی‌دینی جمله جالبی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.26,
   "end": 391.94,
   "text": "اینو دقت کنین می‌فرمود به امام خمینی خدا به یک باره همه چی رو داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.94,
   "end": 394.26,
   "text": "این جمله معروف آقای بهادی‌دینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.26,
   "end": 398.56,
   "text": "به رهبر ما خرد خرد داره میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.56,
   "end": 404.78,
   "text": "و ببینید اصلا چهره آقا رو ببینید هر روز داره ماشاالله گل میندازه و نورانی‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.78,
   "end": 409.8,
   "text": "این در سختی‌ها و بوته آزمایش روزگاره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.8,
   "end": 415.24,
   "text": "غیر از این نمیشه که. حالا یکی یه دفعه خلیل‌وار ازش امتحان می‌گیرن مثل حضرت امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.24,
   "end": 417.46,
   "text": "یکی همینطوری خرد خرد میگیرن ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.46,
   "end": 421.86,
   "text": "فتنه هشتاد و هشت یک امتحان بسیار سنگینی بود برای رهبرمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 421.86,
   "end": 424.9,
   "text": "اول از همه برای رهبرمون. مشکلات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 424.9,
   "end": 427.44,
   "text": "کمرشکن فعلی نظام ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.44,
   "end": 431.66,
   "text": "امتحانات بزرگیه برای رهبر که او هم رشد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.66,
   "end": 437.04,
   "text": "رهبر اون موقع که رئیس جمهور بود شما فکر می‌کنید مثل الان وزن معنوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 437.04,
   "end": 441.82,
   "text": "اون قیمت حالا نهایی بگیم چه، چه عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 441.82,
   "end": 443.68,
   "text": "مثل الان بوده؟ قطعاً نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.68,
   "end": 449.14,
   "text": "اینو مطمئن باشید. این امتحانات بروز میده استعدادهای طرف رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.14,
   "end": 453.66,
   "text": "ظهور میده آنچه که توانمندی خدا در درونش قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.66,
   "end": 458.82,
   "text": "حالا مهم اینه که تو حد خودت رو بشناسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.82,
   "end": 462.88,
   "text": "و در حد خودت، اندازه خودت، نه کمتر، نه بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.88,
   "end": 469.34,
   "text": "همون حدیث که دیروز عرض کردیم و ختم کلام انشاالله این بحث فردا ادامه داره که پیغمبر فرمود اگر-- آخه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.34,
   "end": 477.06,
   "text": "شما دی-دیروز در جمع مدیران اون حرفای تلخ رو به ظاهر البته که البته امیرالمؤمنین فرمودن آقا جون شما نگید تلخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 477.06,
   "end": 479.72,
   "text": "مولا فرمودن \"الحق مر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 479.72,
   "end": 482.0,
   "text": "مر یعنی چی عزیزم؟ تلخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.0,
   "end": 487.94,
   "text": "حق تلخه. به کام اهلش شیرین میاد و الا همینطوریش تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 487.94,
   "end": 490.86,
   "text": "و یه سری به کامشون تلخ اومد حرفای دیروز ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 490.86,
   "end": 495.9,
   "text": "از خود مدیرها اومدن گفتن حاج آقا اینطور که شما میگین همه باید مسئولیتشون رو بذاریم زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 495.9,
   "end": 498.34,
   "text": "گفتم شما این حدیث رو توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.34,
   "end": 505.76,
   "text": "دو تا، دو تا وجه رو. پیغمبر فرمود اگر کسی بتونه بار هفت نفر رو ورداره و برنداره خیانت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.76,
   "end": 510.68,
   "text": "اینم ببینید و اگر نتونه و ورداره باز خیانت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 510.68,
   "end": 512.4,
   "text": "توجه کردید؟ این دو وجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.4,
   "end": 514.14,
   "text": "این نسبته به حد خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 514.14,
   "end": 520.04,
   "text": "امتحانات الهی حد خودت رو برای خودت تعیین میکنه که هی رشد کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 520.04,
   "end": 524.72,
   "text": "ببینی نمرت بیست نشده هجده‌یه تلاش کنی نوزده‌ش کنی، بیستش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 524.72,
   "end": 529.48,
   "text": "این یکی از معناهای امتحان الهیه که از صرف رحمت خداست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 529.48,
   "end": 531.6,
   "text": "از لطف خداست به ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.6,
   "end": 535.64,
   "text": "نه چیز دیگری. انشاالله که عاقبتمون ختم بخیر بشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 535.64,
   "end": 538.56,
   "text": "صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}