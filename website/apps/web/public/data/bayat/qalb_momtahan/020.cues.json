  {
   "index": 1,
   "title": "## قلب ممتحن و بسنده‌کردن به کمال اندک",
   "start": 124.78,
   "end": 145.1
  },
  {
   "index": 2,
   "title": "## تمثیل دریای لایتناهی و جرعهٔ آب",
   "start": 145.1,
   "end": 363.92
  },
  {
   "index": 3,
   "title": "آیه‌ای عجیب همهٔ مردم را خطاب می‌کند و نشان می‌دهد فقر در وجود تعبیه شده است:",
   "start": 363.92,
   "end": 471.64
  },
  {
   "index": 4,
   "title": "## ظرف علم که تنگ نمی‌شود",
   "start": 471.64,
   "end": 569.88
  },
  {
   "index": 5,
   "title": "## امتحان قلب در میدان علم و کمالات",
   "start": 569.88,
   "end": 598.24
  },
  {
   "index": 6,
   "title": "## ولایت از ریشهٔ قرب",
   "start": 598.24,
   "end": 630.12
  },
  {
   "index": 7,
   "title": "## زنجیرهٔ عبودیت تا خلافت",
   "start": 630.12,
   "end": 730.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.78,
   "end": 5.28,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.28,
   "end": 13.08,
   "text": "السلام علیک یا داعی الله و ربانیة آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.08,
   "end": 16.06,
   "text": "فرق بین وقف عام و خاص چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.06,
   "end": 20.6,
   "text": "وقف عام برای عمومه اسمش رو خودشه برای عمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.6,
   "end": 24.08,
   "text": "مثلا عموم یتیم، عموم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.08,
   "end": 26.0,
   "text": "معلولین، عموم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.0,
   "end": 28.5,
   "text": "مردم، حالا مـ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.5,
   "end": 33.18,
   "text": "عموم نمازگزاران یه مسجد، عموم عزاداران حسینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.18,
   "end": 36.9,
   "text": "اما خاص مثلا برمی‌گرده به یک شخص، به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.9,
   "end": 40.92,
   "text": "جناح، به یک قبیله، به یک خانواده خاصی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.92,
   "end": 43.58,
   "text": "کسی وقف می‌کنه برای بچه‌های خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.58,
   "end": 47.06,
   "text": "یک جایی رو وقف می‌کنه برای اولادش، ذریه‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.06,
   "end": 50.02,
   "text": "برای فامیل‌هاش، برای بچه‌های محلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.02,
   "end": 53.8,
   "text": "این‌ها میشه وقف خاص که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.8,
   "end": 57.78,
   "text": "کاملا تقریبا میشه گفت با هم تفاوت‌های این چنینی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.78,
   "end": 60.56,
   "text": "البته خب احکام خاص خودش رو هم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.56,
   "end": 68.42,
   "text": "یه نکته‌ای رو در دل این موضوع بگم چون پیش میاد همش بین نماز عزیزان ابتداء می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.42,
   "end": 75.08,
   "text": "یه فتوایی رو دیروز توی کانال رهبری، تو سایت رهبری دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.08,
   "end": 80.88,
   "text": "خب چون هی هر روز هم مبتلا به هست خوبه بدونید ان شاالله که هر کسی ندیده باشه این فتوا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.88,
   "end": 85.98,
   "text": "که اگر کسی وقت نماز جماعت ابتداء کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.98,
   "end": 89.28,
   "text": "رفت به رکوع امام برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.28,
   "end": 92.88,
   "text": "بعد وقتی رکوع رو درک کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.88,
   "end": 97.34,
   "text": "شک کرد که به رکوع امام رسید یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.34,
   "end": 100.68,
   "text": "خب ببینید اگه وقت طرف مطمئنه رسیده که هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.68,
   "end": 104.22,
   "text": "مطمئنه نرسیده. خب اینم که مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.22,
   "end": 106.86,
   "text": "اما شک کرد. این زیاد پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.86,
   "end": 109.18,
   "text": "به رکوع امام رسید یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.18,
   "end": 115.54,
   "text": "اینجا حکمش چیه؟ رهبر عزیزمون فرمودن که نمازت درسته، نمازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.54,
   "end": 119.48,
   "text": "مشکلی نداره اما دیگه فرادا باید ادامه بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.48,
   "end": 123.04,
   "text": "این رو توجه بکنید چون من خودم این فتوا، این حکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.04,
   "end": 128.5,
   "text": "آقا رو که دیدم مغایر با چیزی بود که چند ماه پیش از دفتر پرسیده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.5,
   "end": 130.42,
   "text": "دفتر یه چیز دیگه‌ای به من گفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.42,
   "end": 134.76,
   "text": "دیدم اِ خب اون چیزی که تو سایت میاد خیلی معتبر تره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.76,
   "end": 138.74,
   "text": "شاید من یه جور دیگه سوالم رو مطرح کرده بودم جواب اینجوری گرفته بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.74,
   "end": 140.34,
   "text": "در هر حال این معتبر تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.34,
   "end": 145.1,
   "text": "اینو حواسمون باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.1,
   "end": 152.88,
   "text": "اگر چنانچه شک کردی نمازت درسته اما دیگه باید نیت فرادا بخونی و از همون جا بلند شدی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.88,
   "end": 156.16,
   "text": "به نیت فرادا نمازت رو ادامه بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.16,
   "end": 159.78,
   "text": "اما خب ما وعده داده بودیم که امروز پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.78,
   "end": 165.38,
   "text": "وقایع این چند روز و یا قصه فاطمیه صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.38,
   "end": 167.76,
   "text": "به یک دلیل مهمی این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.76,
   "end": 170.2,
   "text": "میگذاریم روز سه شنبه که شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.2,
   "end": 173.96,
   "text": "شهادت امام عسکری سلام الله علیه هست با هم میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.96,
   "end": 178.72,
   "text": "چون مرتبط‌اند با هم موضوع کاملا وقایع الايام است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.72,
   "end": 181.36,
   "text": "و یه امتحان عجیبی اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.36,
   "end": 185.94,
   "text": "شیعیان پس دادن به کوچک بودن امام معصومشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.94,
   "end": 188.12,
   "text": "و بعد به غیبت رفتنش که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.12,
   "end": 192.84,
   "text": "خیلی مرتبط است با وقایع الايام اهل بیت علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.84,
   "end": 195.74,
   "text": "خب بحث ما قلب ممتhen بود امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.74,
   "end": 200.22,
   "text": "نکته‌ای رو عرض کنم خدمتتون که این نکته خیلی مهمه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.22,
   "end": 202.18,
   "text": "و خودش یک منبر می‌طلبد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.18,
   "end": 205.06,
   "text": "گاهی اوقات ما مطالبی رو عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.06,
   "end": 208.72,
   "text": "و عده‌ای خسته میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 208.72,
   "end": 211.3,
   "text": "میگن بابا دیگه مثلـ-- به چه دردمون می‌خوره این حرف‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.3,
   "end": 215.04,
   "text": "یا زود از وادی علم خارج میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.04,
   "end": 219.62,
   "text": "به محض اینکه یه چیزو فهمیدن دیگه بسشونه، بسنده می‌کنن به همون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.62,
   "end": 225.04,
   "text": "یا کمالی رو اگر در مسیر بندگی پیدا کردن دیگه بسنده می‌کنن به یک مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.04,
   "end": 227.02,
   "text": "نماز اول وقت بسنده می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.02,
   "end": 230.78,
   "text": "تمام. این نکته‌ای که میگم خیلی کلیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.78,
   "end": 236.98,
   "text": "پیرامون یکی از راه‌هایی که ما خودمون رو بشناسیم و خدا هم دائما ما رو در اون وضع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.98,
   "end": 240.76,
   "text": "داره امتحان می‌کنه که ما خودمون رو به، خودمون رو بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.76,
   "end": 247.32,
   "text": "نه که خدا که، خدا که در علمش همه چی هست نیازی به شناختن ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.32,
   "end": 251.02,
   "text": "یه مثال خب تلک الأمثال نضربها للناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.02,
   "end": 253.14,
   "text": "ولا يعقلها إلا العالمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.14,
   "end": 255.64,
   "text": "یه تعقل کنیم با یه مثل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 255.64,
   "end": 261.0,
   "text": "اگر شما فرض کنید که یک دریای بیکران و لایتناهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.0,
   "end": 263.88,
   "text": "که اصلا انتها ندارد این دریا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.88,
   "end": 266.78,
   "text": "هرکس به هر قدری که بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.78,
   "end": 270.2,
   "text": "تشنگی برطرف کند، این دریا وسیع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.2,
   "end": 274.36,
   "text": "حالا یه نفر به قدر یه لیوان آب تشنگیش برطرف می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 274.36,
   "end": 279.9,
   "text": "میاد کنار این دریا و یه لیوان آب می‌نوشه و عطشش برطرف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.9,
   "end": 282.88,
   "text": "به نظر شما میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.88,
   "end": 289.1,
   "text": "که این آقا تشنه یه دریا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.1,
   "end": 293.4,
   "text": "یه شخصی تشنه است. میره کنار دریایی که لایتناهی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.4,
   "end": 296.96,
   "text": "یه جرعه آب میخوره عطشش برطرف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.96,
   "end": 303.62,
   "text": "خب عطش این شخص که با یک جرعه آب برطرف شد به قدر دریا که نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 303.62,
   "end": 308.22,
   "text": "تمام شد. تشنگیش با یک جرعه آب نوشیدن تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.22,
   "end": 311.72,
   "text": "اما اون دریا لای-لایتناهی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.72,
   "end": 318.08,
   "text": "بین این عطش و اون دارایی دریا تناسب و سنخیت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.08,
   "end": 321.18,
   "text": "باید تناسب و سنخیت باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.18,
   "end": 324.28,
   "text": "اون دریا به درد کسی می‌خورد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.28,
   "end": 327.02,
   "text": "اون دریای لایتناهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.02,
   "end": 330.22,
   "text": "از دَهش بدون بخل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.22,
   "end": 334.72,
   "text": "فیض الهی رو در نظر بگیرید، دریای لاتنا-- لایتناهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.72,
   "end": 338.92,
   "text": "به درد کسی می‌خورد متناسب با وجود کسی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.92,
   "end": 342.96,
   "text": "که عطشش لایتناهی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.96,
   "end": 346.02,
   "text": "حالا این عطش رو شما فر-- فقر بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.02,
   "end": 351.14,
   "text": "فقر ذاتی ما. ما یه آیه ای در قرآن داریم خیلی آیه عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.14,
   "end": 354.3,
   "text": "يا أَيُّهَا النَّاسُ همه مردم رو خطاب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.3,
   "end": 357.14,
   "text": "پیداست این تعبیه شده در وجود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.14,
   "end": 360.7,
   "text": "ما غافلیم. أَنْتُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.7,
   "end": 363.92,
   "text": "خود شماها الْفُقَرَاءُ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.92,
   "end": 366.94,
   "text": "الف و لام خیلی اینجا حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.94,
   "end": 370.16,
   "text": "الْفُقَرَاءُ به سمت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.16,
   "end": 377.16,
   "text": "الی الله. لفظ جلاله و خاص رو استفاده می‌کنه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.16,
   "end": 380.74,
   "text": "شما این الله رو مجمع جمعی اسماءه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.74,
   "end": 383.62,
   "text": "همه نظام هستی هم اسم الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.62,
   "end": 387.24,
   "text": "اگر همه عالم عوالم وجودی اسم الله‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 387.24,
   "end": 389.84,
   "text": "و الله مجمع جمعی اسماء است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.84,
   "end": 398.46,
   "text": "میگه ای مردم شما فقر ذاتیتون رو به گونه‌ای تعبیر، تعبیه کردم که تشنه به سمت الله باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.46,
   "end": 400.34,
   "text": "یعنی اون لایتناهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.34,
   "end": 406.42,
   "text": "یعنی شما فقرتون متناسب با لایتناهی بودن افاضه من است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.42,
   "end": 410.7,
   "text": "اسماء من لایتناهی‌ست فقر شما هم لایتناهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.7,
   "end": 412.82,
   "text": "خیلی نکته‌ست. بعد می‌فرماید و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.82,
   "end": 416.36,
   "text": "والله هو الغنی الحمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.36,
   "end": 419.58,
   "text": "این الله رفع نیاز شما میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.58,
   "end": 424.56,
   "text": "این غنی شماست. و الا اگر کسی با یک جرعه آب برگردیم به مثال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.56,
   "end": 429.56,
   "text": "اگر کسی با یک جرعه آب عطشش برطرف بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 429.56,
   "end": 432.76,
   "text": "آیا میشه گفت اون دریا نیازشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.76,
   "end": 436.12,
   "text": "نه. نیاز اون دریا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 436.12,
   "end": 440.82,
   "text": "غنای اون شخص در خوردن یک جرعه آبه تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.82,
   "end": 446.46,
   "text": "سنخیت بینشون نیست. اینکه میگه انتم الفقراء الی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.46,
   "end": 449.98,
   "text": "یعنی فقر ذاتی شما بی‌نهایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.98,
   "end": 452.7,
   "text": "هر مقدار شما تشنه‌ترید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.7,
   "end": 458.42,
   "text": "فیض بیشتر آماده‌ست. هر مقدار بیشتر بنوشید از این فیض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.42,
   "end": 461.44,
   "text": "اگر تشنه‌تر شدید، اون فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.44,
   "end": 466.4,
   "text": "چون لایتناهی‌ست عطش شما هم هرچه الی ماشاءالله برود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 466.4,
   "end": 470.44,
   "text": "فیض مهیاست. این مهمه که انسان بهش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.44,
   "end": 474.04,
   "text": "هر-- لذا یک حدیث امیرالمؤمنین علیه‌الصلاة والسلام داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 474.04,
   "end": 476.98,
   "text": "خیلی حدیث زیباست و خیلی حکیمانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 476.98,
   "end": 480.12,
   "text": "می‌فرماید کل وعاء،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.12,
   "end": 484.62,
   "text": "همه ظرف‌ها، یضیق بمجا علفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 484.62,
   "end": 487.84,
   "text": "تنگ میشن، کوچیک میشن با چیزی که توش میذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.84,
   "end": 491.08,
   "text": "الا وعاء العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.08,
   "end": 495.64,
   "text": "فانه يتسع به. فقط یه چیزه که هرچی بیشتر میدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.64,
   "end": 498.68,
   "text": "اگر ظرف ظرف باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.68,
   "end": 501.46,
   "text": "یعنی به پی علم حقیقی برود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.46,
   "end": 504.56,
   "text": "این علم هی چی میاره؟ وسعت وجود بهش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.56,
   "end": 507.48,
   "text": "هی میگه تشنه‌ترم. هی میگه تشنه‌ترم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 507.48,
   "end": 511.5,
   "text": "هرچی تشنه‌تره به اون دریا نزدیک‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.5,
   "end": 514.76,
   "text": "هرچی زودتر عطشش رفع شد فرار میکنه از دریا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 514.76,
   "end": 517.72,
   "text": "تشنگی که رفع شد از دریا فرار میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.72,
   "end": 522.5,
   "text": "قربش از بین میره. خب حالا سر اینکه ما به سمت دریا میریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.5,
   "end": 527.06,
   "text": "سم، سر اینکه الی الله به سمت خدا حرکت می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 527.06,
   "end": 529.42,
   "text": "سر اینکه نماز میگیم قربتا الی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 529.42,
   "end": 532.96,
   "text": "الله چیه؟ فقر ماست، عطش ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 532.96,
   "end": 534.82,
   "text": "اما باید حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 534.82,
   "end": 540.0,
   "text": "عطش ما باید متناسب با اون الله باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.0,
   "end": 542.02,
   "text": "عطش ما رو فقر بگیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 542.02,
   "end": 547.44,
   "text": "فقر ذاتی ما باید متناسب با لایتناهی بودن فیض خدا باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.44,
   "end": 550.72,
   "text": "هر م-- هر کجا ما احساس کردیم دیگه بی‌نیازیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.72,
   "end": 553.82,
   "text": "دیگه نیاز نداریم، دیگه خسته شدیم از علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 553.82,
   "end": 557.76,
   "text": "دیگه کمالی نیاز نداریم، در رشدمون متوقف شدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 557.76,
   "end": 562.34,
   "text": "اینجا دیگه ما باختیم. لذا عالمه حسن زاده می‌فرمود کسی که اینطوری شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 562.34,
   "end": 564.84,
   "text": "بدونه مریضه، نفسش مریض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.84,
   "end": 567.68,
   "text": "دیگه بسه دیگه. دیگه علم نمی‌خوام، دیگه کمال نمی‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 567.68,
   "end": 573.5,
   "text": "چنین کسی مریض شده. لذا یکی از بهترین راه‌هایی که خدا بنده شو امتحان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 573.5,
   "end": 577.3,
   "text": "تا ببینه تو چه وضعیتیه، خود بنده بفهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 577.3,
   "end": 581.06,
   "text": "و حال خودش رو بسنجه، تو بازی علم و کمالاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 581.06,
   "end": 584.66,
   "text": "نسبت به علم و کمالات قلب ما در حال امتحان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 584.66,
   "end": 586.62,
   "text": "بحث ما قلب ممتحن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 586.62,
   "end": 588.88,
   "text": "دائماً در حال امتحانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 588.88,
   "end": 592.86,
   "text": "جالبه هرچی نزدی-- هرچی هم تشنگیت بیشتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 592.86,
   "end": 595.58,
   "text": "به اون دریا نزدیک‌تر میشی دیگه فرار نمیکنی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 595.58,
   "end": 597.9,
   "text": "این اصل قربه. قربتا الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 597.9,
   "end": 601.72,
   "text": "اصلاً ولایت از ریشه و، واو و لام و یه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 601.72,
   "end": 603.82,
   "text": "ولی، ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 603.82,
   "end": 607.24,
   "text": "یعنی چی؟ بسترشه دیگه. ول یعنی قرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 607.24,
   "end": 609.88,
   "text": "اصلاً ولایت چرا بهش میگن صاحب ولایت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 609.88,
   "end": 613.34,
   "text": "چون بی‌نهایت قرب پیدا، پیدا کرده به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 613.34,
   "end": 622.18,
   "text": "چون فقر ذاتیش رو لایتناهی، هرچی خدا بهش داده دریا، دریا داده، دریا دل داده، دریا دل شده بازم تشنه‌تره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 622.18,
   "end": 625.66,
   "text": "بازم می‌خواد. به این میگن ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 625.66,
   "end": 630.12,
   "text": "قربش بیشتره. پس برگردیم به این فرمولی که پیش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 630.12,
   "end": 631.94,
   "text": "سر عبودیت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 631.94,
   "end": 637.5,
   "text": "فقر ماست. سر عب-- سر فقر ما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 637.5,
   "end": 640.32,
   "text": "اون الله لایتناهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 640.32,
   "end": 644.68,
   "text": "هر چقدر تو فقرت رو بیشتر کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 644.68,
   "end": 648.92,
   "text": "چون او لایتناهی‌ست، تو هم فقرت ذاتاً لایتناهی شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 648.92,
   "end": 651.32,
   "text": "همون مقدار ولایت پیدا می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 651.32,
   "end": 654.16,
   "text": "و اگر تو دست دهش پیدا کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 654.16,
   "end": 656.28,
   "text": "حالا که ولایت پیدا کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 656.28,
   "end": 661.78,
   "text": "حالا که پر شد دستت، حالا که هرچی بهت میگن سیر نمیشی به دیگران هم بدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 661.78,
   "end": 664.3,
   "text": "این بهت دیگه میشه سر خلافت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 664.3,
   "end": 669.56,
   "text": "خلافت، خلافت الهی به دیگران، می‌خواد دست دیگران هم بگیره، جانشین خدا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 669.56,
   "end": 674.16,
   "text": "پس میشه اینکه تو خلیفة اللهی چون ولی اللهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 674.16,
   "end": 678.06,
   "text": "ولی اللهی چون فقیر الی اللهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 678.06,
   "end": 680.94,
   "text": "فقیر الی اللهی چون عبدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 680.94,
   "end": 684.68,
   "text": "چرا عبدی و چرا عبودیت تو تمام ندارد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 684.68,
   "end": 687.06,
   "text": "چرا فقرت و ذاتی‌ست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 687.06,
   "end": 689.9,
   "text": "لایتناهی باید باشد و هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 689.9,
   "end": 693.72,
   "text": "ولی بعضیا مریض میشن وسط راه میبرن چون الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 693.72,
   "end": 696.42,
   "text": "والله هو الغنی الحمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 696.42,
   "end": 700.26,
   "text": "خیلی نکته مهمه که ما بفهمیم به سمت الله فقیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 700.26,
   "end": 704.2,
   "text": "لذا پیغمبر فرمود فقر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 704.2,
   "end": 708.18,
   "text": "فخر منه. این فقر ذاتی منظوره، نه پول نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 708.18,
   "end": 712.68,
   "text": "حواسمون باشه. هرچی عطشت بیشتر باشه بیشتر بهت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 712.68,
   "end": 719.66,
   "text": "هرچی عش، عطشت از بین رفت یعنی تو عبودیت و کمال و تحصیل علمت توقف کردی و مریض احوالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 719.66,
   "end": 724.62,
   "text": "ان شا الله عاقبتمون ختم به خیر بشه و به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 724.62,
   "end": 730.18,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}