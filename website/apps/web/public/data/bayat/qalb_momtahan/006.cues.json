 },
 "chapters": [
  {
   "index": 0,
   "title": "## سفر اولِ شغلی و شکسته شدن نماز",
   "start": 0.34,
   "end": 155.52
  },
  {
   "index": 1,
   "title": "بحث قلب ممتحن بود؛ قلبی که از سوی خدا آزموده می‌شود. امروز نکته‌ای مهم ذیل آیهٔ دوم سورهٔ انسان:",
   "start": 155.52,
   "end": 235.94
  },
  {
   "index": 2,
   "title": "## انسان؛ موجود ثابت و سیال",
   "start": 235.94,
   "end": 496.39
  },
  {
   "index": 3,
   "title": "## آنچه منِ من را می‌سازد",
   "start": 496.39,
   "end": 516.41
  },
  {
   "index": 4,
   "title": "## سمیع بصیر؛ حقیقت امتحان",
   "start": 516.41,
   "end": 659.45
  },
  {
   "index": 5,
   "title": "## سمیع بصیر؛ حشر با خود",
   "start": 659.45,
   "end": 804.43
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.72,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.72,
   "end": 7.42,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.42,
   "end": 10.04,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.04,
   "end": 13.62,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.62,
   "end": 17.68,
   "text": "قبلا عرض کردیم که راننده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.68,
   "end": 21.04,
   "text": "شغلش چون رانندگی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.04,
   "end": 23.88,
   "text": "کثیر السفر و این‌هاست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.88,
   "end": 30.86,
   "text": "در سفر اول که میره نمازش شکسته است بقیه‌ی سفرهاش نمازش کامله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.86,
   "end": 34.08,
   "text": "راننده. حالا سؤال اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.08,
   "end": 37.02,
   "text": "این سفر اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.02,
   "end": 39.54,
   "text": "چگونه حساب می‌شه، محاسبه می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.54,
   "end": 41.5,
   "text": "یعنی وقتی از مقصد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.5,
   "end": 47.02,
   "text": "از مبدا راه افتاد رسید به مقصد، سفر اولش تموم می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.02,
   "end": 54.66,
   "text": "یا اینکه نه، رفت به مقصد رسید بعد دوباره برگشت به مبداش، این یه سفر حساب می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.66,
   "end": 59.08,
   "text": "که بخواد اون سفر اولشو نمازش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.08,
   "end": 61.88,
   "text": "خا-- شکسته بخونه بقیه‌ش رو کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.88,
   "end": 65.52,
   "text": "البته این سؤال در رابطه با هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.52,
   "end": 69.62,
   "text": "کس دیگه‌ای که شغلش سفره حساب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.62,
   "end": 71.68,
   "text": "یعنی می‌تونه اون هم به این توجه بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.68,
   "end": 73.52,
   "text": "آقا فرمودن که ملاک کلی دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 73.52,
   "end": 77.1,
   "text": "فرمودن اگر در عرف اجتماع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 77.1,
   "end": 80.3,
   "text": "این کاری که شما انجام میدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 80.3,
   "end": 86.7,
   "text": "صرفا از مبدا به مقصد یه سفر حساب بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.7,
   "end": 91.74,
   "text": "و نگن برگشتش هم جزو سفر اوله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.74,
   "end": 95.78,
   "text": "خب شما باید فقط در رفت نمازت رو شکسته بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.78,
   "end": 100.9,
   "text": "رسیدی به مقصد از اونجا به بعد دیگه نمازت کامله حتی در برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 100.9,
   "end": 106.54,
   "text": "اما نه اگر صدق عرفی این چنین باشه که رفت و برگشت یه سفر حساب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.54,
   "end": 112.26,
   "text": "مثالی که خود رهبر عزیزمون زدن میگن مثل یک استاد و معلمی که میره یه جا درس میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.26,
   "end": 115.32,
   "text": "یه روز، دو روز چند روز رو درس میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.32,
   "end": 117.06,
   "text": "زیر ده روز بعد بر می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.06,
   "end": 120.2,
   "text": "این رفت و برگشتش یه سفر حساب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.2,
   "end": 128.28,
   "text": "اما راننده امتا-- احتمال داره یه کالایی، یه انسانی رو میخواد جابجا کنه از اینجا میره و می‌رسه به مقصد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.28,
   "end": 131.02,
   "text": "راننده رو حالا این مسافر رو پایین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.02,
   "end": 134.6,
   "text": "سر-- پیاده می‌کنه یا اون کالا رو پیاده می‌کنه بعد میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.6,
   "end": 137.14,
   "text": "یه جای دیگه یه مسافر دیگه‌ای بزنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.14,
   "end": 139.8,
   "text": "دیگه برنمی‌گرده جای اولش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.8,
   "end": 141.8,
   "text": "یا یه کالای دیگه رو از یه جای دیگه ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 141.8,
   "end": 145.1,
   "text": "این فقط رفتش یه سفر حساب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 145.1,
   "end": 150.04,
   "text": "اینو توجه داشته باشیم. اون دیگه فقط تو رفت باید نمازشو شکسته بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.04,
   "end": 155.52,
   "text": "دیگه وقتی داره بر می‌گرده یا هر چیز دیگه دیگه دفعات بعدیش همش کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.52,
   "end": 162.08,
   "text": "ما داشتیم در خصوص قلب ممتحن و قلبی که از سمت خدا مورد امتحان قرار می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.08,
   "end": 168.34,
   "text": "صحبت می‌کردیم. امروز نکته‌ی بسیار مهمی رو به فضل الهی ذیل آیه دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.34,
   "end": 173.96,
   "text": "سوره انسان عرض می‌کنیم که خدا در این آیه می‌فرماید \"انا خلقنا الانسان\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.96,
   "end": 176.28,
   "text": "ما خلق کردیم انسان را از چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.28,
   "end": 179.1,
   "text": "\"من نطفه امشاج\" از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.1,
   "end": 182.88,
   "text": "نطفه‌ای که مختلط است و به هم پیچیده است و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.88,
   "end": 186.24,
   "text": "\"نبتلیه\". بلافاصله می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 186.24,
   "end": 191.1,
   "text": "ما همین سیری که حالا این انسان داره میره رو همه رو امتحان قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.1,
   "end": 193.6,
   "text": "ما می‌خوایم اینو امتحانش کنیم. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.6,
   "end": 197.84,
   "text": "\"فجعلناه سميعا بصيرا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.84,
   "end": 200.46,
   "text": "اینو گفته بودیم بعدا یه توضیحی میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.46,
   "end": 202.96,
   "text": "اصلا برای همین او رو شنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.96,
   "end": 205.54,
   "text": "و بینا قرار دادیم که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.54,
   "end": 208.52,
   "text": "که \"نبتلیه\" قراره امتحانش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 208.52,
   "end": 213.36,
   "text": "خیلی جالبه در حقیقت صراحتا قرآن داره اینجا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.36,
   "end": 218.4,
   "text": "اصلی‌ترین چشم و گوش شما البته به ترتب اهمیت باید بگیم س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 218.4,
   "end": 225.98,
   "text": "گوش و چشم شما اصلا مال امتحانه، مال ابتلاء الهیه که ببینیم چی کاره‌ای البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.98,
   "end": 228.98,
   "text": "البته برای اینه که خودت خودت رو بشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.98,
   "end": 234.22,
   "text": "توجه بفرمایید یه مقدار این بحث دقیقه، خوب دل بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.22,
   "end": 236.92,
   "text": "سریع من عرض کنم. حکما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.92,
   "end": 242.74,
   "text": "در حکمت متعالیه فرمودن که انسان یک موجود ثابت سیال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.74,
   "end": 248.08,
   "text": "چطور ثابت است؟ چون نفس ناطقه انسان جنسش مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.08,
   "end": 250.38,
   "text": "علم هم که وقتی وارد بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.38,
   "end": 258.0,
   "text": "نفس ناطقه می‌شه مثلا شما یک علمی رو اخذ می‌کنید، نفستون، جانتون یک علمی رو اخذ می‌کنه و عالم می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.0,
   "end": 260.6,
   "text": "این علم هم مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.6,
   "end": 266.82,
   "text": "علم مجرد وعاء علم یا ظرف علم که نفس ناطقه ماست، اون هم مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.82,
   "end": 270.92,
   "text": "یعنی مادی نیست و بالواقع هم شما عالم می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.92,
   "end": 273.76,
   "text": "این عرض نیست، عارضی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.76,
   "end": 277.0,
   "text": "قطعا شما عالم می‌شی. یعنی یه چیزی رو یاد می‌گیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.0,
   "end": 281.26,
   "text": "مثل این نیستش که یه رنگی رو به یه دیواری بزنی بعد بشوری رنگه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.26,
   "end": 284.06,
   "text": "یا یک نوری ساطع بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.06,
   "end": 289.1,
   "text": "بیفته به یه دیواری. بعد نور که تموم شد دیوار همون دیواره، نورم رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.1,
   "end": 295.8,
   "text": "اینطوری نیست. علم وقتی وارد بر جان شما شد قطعاً، واقعاً شما عالم می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.8,
   "end": 298.4,
   "text": "دیگه با اون آدم قبلیه فرق می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.4,
   "end": 303.58,
   "text": "درست شد؟ لکن علم چون جنسش مجرده است، از عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.58,
   "end": 306.64,
   "text": "مجرداته دیگه، تجرد داره، ماده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.64,
   "end": 310.92,
   "text": "نفس ناطقه انسان هم که وعاء اونه و ظرف اونه، اونم مجرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.92,
   "end": 316.4,
   "text": "پس ثابته. یعنی علم در وجود انسان تثبیت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.4,
   "end": 322.26,
   "text": "عمل انسان هم که بر اساس علم هست در وجود انسان، در ذات وجود انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.26,
   "end": 324.56,
   "text": "تثبیت می‌شه، ثابت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.56,
   "end": 326.52,
   "text": "از این جهت میگن انسان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.52,
   "end": 328.58,
   "text": "چون نفس ناطقه‌ش هم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.58,
   "end": 331.54,
   "text": "مجرده، میگن ثابته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.54,
   "end": 333.88,
   "text": "اصلا قوه به فعل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.88,
   "end": 335.68,
   "text": "یکپارچه فعلیت تامه‌ا‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.68,
   "end": 340.16,
   "text": "اصلا علم قوه نیست که، علم فعلیت تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 340.16,
   "end": 344.42,
   "text": "شما وقتی یک علم رو اخذ می‌کنی، فعلیه فاعل-- فعلیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.42,
   "end": 348.28,
   "text": "کامل پیدا می‌کنه. قابلیت وجود شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 348.28,
   "end": 352.12,
   "text": "فعالیت کامل و فعلیت کامل پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.12,
   "end": 356.86,
   "text": "دیگه تمام، شما عالمی به تمام معنا اون حقیقت رو درک کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.86,
   "end": 360.63,
   "text": "اینطوری نیست که عارض شده باشه. نکته بعد میگه سیاله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.63,
   "end": 364.01,
   "text": "سیاله یعنی چی؟ ببینید شما آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.01,
   "end": 368.77,
   "text": "همون آدم دیروزی، همون آدم یک سال پیشی، همون آدم دو سال پیشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.77,
   "end": 371.49,
   "text": "چرا موهات ریخته؟ چرا موهات سفید شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.49,
   "end": 373.75,
   "text": "چرا گوز کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.75,
   "end": 375.79,
   "text": "چرا اون حالت بچگی رو دیگه نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.79,
   "end": 378.23,
   "text": "چرا؟ چرا؟ چرا؟ چون تغییر کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 378.23,
   "end": 380.89,
   "text": "از این جهت میگن سیاله چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.89,
   "end": 385.19,
   "text": "هر-- بر اساس حرکت جوهری انسان از قوه به فعل داره میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.19,
   "end": 391.37,
   "text": "دائما داره استعدادش شکوفا میشه از قوه داره به سمت فعلیت حرکت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 391.37,
   "end": 394.73,
   "text": "ما همون آدم حتی یک لحظه پیش هم نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.73,
   "end": 398.47,
   "text": "چون سلول‌هامون در درون دائما داره تغییر میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.47,
   "end": 400.03,
   "text": "از این جهت هم میگن سیاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.03,
   "end": 403.99,
   "text": "یکی از به قول علامه حسن زاده امفظل الله تعالی کتل‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.99,
   "end": 407.65,
   "text": "به قول حقیر گردنه‌های بسیار دشوار و سخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.65,
   "end": 409.89,
   "text": "فهم حقایق حکمی اینجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 409.89,
   "end": 414.91,
   "text": "که بتونه آدم این دو تا رو با هم جمع کنه که انسان وجودی‌ست هم ثابل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 414.91,
   "end": 420.43,
   "text": "ثابت هم سیال. الان مثلا شما توجه بفرمایید پیرمردی که دیگه پیر شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.43,
   "end": 425.41,
   "text": "میگه آقا یادته بیست سال پیش به بچه‌ش میگه یادته چهل سال پیش، پنجاه سال پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 425.41,
   "end": 427.57,
   "text": "فلان مثلا با هم رفتیم اینجا اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.57,
   "end": 431.45,
   "text": "خب بچه میتونه بگه بابا، بابا بزرگ یا پدر تو که آخه اون نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.45,
   "end": 435.47,
   "text": "تو اون موقع خیلی جوان بودی، خوشگل بودی، مو داشتی، الان موهات ریخته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.47,
   "end": 438.05,
   "text": "موهات سفید شده. دیگه اصلا اون نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 438.05,
   "end": 445.63,
   "text": "میگه نه بابا من همونم. اینکه اون نیستی یعنی این تغییرات و فعل و انفعالات در حرکت جوهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 445.63,
   "end": 448.87,
   "text": "ثابت شده برای اون بچه میگه آقا تو تغییر کردی، همون نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 448.87,
   "end": 451.43,
   "text": "اما اینکه میگه نه من همونم، منم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 451.43,
   "end": 453.73,
   "text": "به واقع هم همونه. این منِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 453.73,
   "end": 458.43,
   "text": "من شخص، خود شخص، اون وجود ثابتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.43,
   "end": 464.37,
   "text": "یعنی مثلا شما فکر کنید بعد بیست سال، ده سال، پنجاه سال یه قاتلی رو بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.37,
   "end": 467.43,
   "text": "بگه آقا جان شما برید عکسامونو تطبیق بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 467.43,
   "end": 470.51,
   "text": "پنجاه سال پیش من یه جوون رشید اینطوری بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 470.51,
   "end": 472.65,
   "text": "الان یه پیرمرد گوش پستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 472.65,
   "end": 475.79,
   "text": "چطور به من میگی من همونم. برید یکی دیگه رو بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.79,
   "end": 479.15,
   "text": "محاکمه کنید. میگه آقا جان تو که-- تو بودی که کشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 479.15,
   "end": 482.49,
   "text": "این تو بودی، این من به چی استناد داده میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 482.49,
   "end": 485.79,
   "text": "به همون وجود ثابت. توجه کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 485.79,
   "end": 492.05,
   "text": "اما این تغییر و انفعالاتی که درش صورت گرفته بر اساس حرکت جوهری به وجود سیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 492.05,
   "end": 494.17,
   "text": "پس انسان یک وجود ثابت و سیال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 494.17,
   "end": 498.93,
   "text": "حالا چی میخوایم بگیم؟ آنچه که در وجود ما ثابت میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 498.93,
   "end": 503.83,
   "text": "تثبیت میشه بر اساس علم و عمل، همون حقیقت وجودی ما رو تشکیل میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 503.83,
   "end": 506.31,
   "text": "اون حرکت جوهری رو ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 506.31,
   "end": 508.91,
   "text": "اون استعداد جوهری، اون که داره حالا به یه سمتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 508.91,
   "end": 513.63,
   "text": "حرکت میکنه از ضعف به قوه میره بعد دوباره از قوه به ضعف برمی‌گرده، اونو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 513.63,
   "end": 515.29,
   "text": "اون هم در سیر امتحان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 515.29,
   "end": 519.33,
   "text": "اما اونی که منِ من رو تشکیل میده و انتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.33,
   "end": 525.11,
   "text": "مورد ما-- مداقه و مواخذه خدا قرار می‌گیره و حسابرسی اون من ثابته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 525.11,
   "end": 527.67,
   "text": "یه مثال بزنم و به نتیجه برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 527.67,
   "end": 530.09,
   "text": "شما یه درخت رو توجه بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 530.09,
   "end": 535.23,
   "text": "که نگاهش می‌کنی. اون درخت قوه اینو داره در وجود خودش که خاکستر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 535.23,
   "end": 538.77,
   "text": "درسته؟ می‌تونی بسوزونیش. این قوه در وجودش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 538.77,
   "end": 542.85,
   "text": "از قوه به فعل برسه حرکت کنه بسوزه خاکستر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 542.85,
   "end": 550.69,
   "text": "حالا شما این عکس این، عکس این درخت رو می‌بینی رو شبکه چشمت بعدم چشمتو می‌بندی و دیگه هم نمی‌بینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 550.69,
   "end": 554.23,
   "text": "خب این درخت هنوز باقیه در متن واقع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 554.23,
   "end": 557.51,
   "text": "اما در ذهن شما چی؟ آیا باقیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 557.51,
   "end": 563.33,
   "text": "آیا می‌تونی یک ساعت بعد، دو ساعت بعد، اصلا از اونجا فارغ شده یک سال بعد دوباره اون عکس، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 563.33,
   "end": 568.15,
   "text": "درخت رو ببینی در وجود خودت، در متن، بطن وجود خودت بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 568.15,
   "end": 570.59,
   "text": "دوباره می‌بینیش. اون چه درختیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 570.59,
   "end": 572.75,
   "text": "همون درخت است؟ بله، همون درخت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 572.75,
   "end": 577.79,
   "text": "دوباره می‌بینیش. آیا در وجود تو هم می‌تونه خاکستر بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 577.79,
   "end": 582.29,
   "text": "نه. دیگه اون درختی که تو وجود من، تو ذهن من و تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 582.29,
   "end": 585.51,
   "text": "قوه خیال من ثبت شده دیگه خاکستر نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 585.51,
   "end": 590.75,
   "text": "همونه. ثابت میمونه. اگر تو خاکستر تصور کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 590.75,
   "end": 594.01,
   "text": "حاصل دیدن یه خاکستره، نه اون درخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 594.01,
   "end": 597.07,
   "text": "میخوام به شما اینو بگم. اون درخت حالا هرچی شد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 597.07,
   "end": 599.43,
   "text": "چشم شما هم بسته شد، دیگه هم اونو نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 599.43,
   "end": 606.55,
   "text": "چطور دوباره می‌بینیش؟ چطور هر چیزی که بیست سال پیش، پنجاه سال پیش دیدی الان می‌تونی متصور کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 606.55,
   "end": 609.57,
   "text": "تو ذهنت تصور کنی و دوباره ببینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 609.57,
   "end": 612.65,
   "text": "این دیدنه چیه؟ همون وجود ثابت توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 612.65,
   "end": 616.65,
   "text": "این عکس‌ها، این دیدن‌ها، این شنیدن‌ها در وجود ما چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 616.65,
   "end": 622.93,
   "text": "ثبت شده. تثبیت شده و ما می‌تونیم اصطلاحا به قول حکما صور انشائیه ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 622.93,
   "end": 625.95,
   "text": "ایجاد کنیم. هی تصویر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 625.95,
   "end": 628.33,
   "text": "به تصویر هی ازش انشا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 628.33,
   "end": 630.85,
   "text": "هی-- اصلا وجود ما همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 630.85,
   "end": 634.79,
   "text": "خلاصه کلام اینه. اگر به من و شما بگن شما کی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.79,
   "end": 637.89,
   "text": "آقا پنجاه سال از خدا عمر گرفتی، شما چی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 637.89,
   "end": 643.97,
   "text": "کی هستی؟ باید بگیم ما مجموعه‌ای از یک عمر دیدن‌هامون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 643.97,
   "end": 647.17,
   "text": "شنیدن‌هامون، چشیدن‌هامون، لمس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 647.17,
   "end": 650.75,
   "text": "لمس کردن‌هامون، خوابیدن و خوردن و اینهاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 650.75,
   "end": 654.49,
   "text": "البته ملموسات و مزوقات و مسموعات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 654.49,
   "end": 658.19,
   "text": "عرض شود مبصرات و اینها همه هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 658.19,
   "end": 660.85,
   "text": "اما جالبه این آیه آخرش میگه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.85,
   "end": 664.23,
   "text": "فجعلناه سميعا بصيرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 664.23,
   "end": 666.99,
   "text": "سمع رو هم مقدم بر بصر میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 666.99,
   "end": 669.81,
   "text": "یعنی شما مجموعه‌ای هستید از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 669.81,
   "end": 672.61,
   "text": "دیدن، شنیدن‌ها و دیدن‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 672.61,
   "end": 680.07,
   "text": "اسم خدا هم جالبه. هر کجا تو قرآن میخواد تو این بحث‌های امتحانات و ابتلاءات اسم خودش رو بیاره میگه خدا هم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 680.07,
   "end": 683.91,
   "text": "سميع و بصيره. هیچوقت خدا نمیگه خدا شامه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 683.91,
   "end": 685.81,
   "text": "می‌بویه. نمیگه لامسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 685.81,
   "end": 691.45,
   "text": "نمیگه ذائقه. یعنی اصل قوای وجودی ما که سا-- اون قو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 691.45,
   "end": 697.07,
   "text": "ثابت وجود ما رو، ذات وجود ما رو تثبیت میکنه و میسازه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 697.07,
   "end": 699.49,
   "text": "قوه شنوایی و بینایی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 699.49,
   "end": 705.83,
   "text": "در حقیقت ما همون‌هایی هستیم که یک عمر دیده‌ایم و شنیده‌ایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 705.83,
   "end": 709.25,
   "text": "و اون تو وجود ما ثبت میشه الی الابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 709.25,
   "end": 711.27,
   "text": "اصلا حشر ما با خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 711.27,
   "end": 715.29,
   "text": "قیامت ما با خودمونه. میگه خودت رو نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 715.29,
   "end": 717.91,
   "text": "صور انشائیه وجودت رو بریز بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 717.91,
   "end": 720.19,
   "text": "ملکات وجودت چیه؟ چی دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 720.19,
   "end": 722.25,
   "text": "چی شنیدی؟ تو همون هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 722.25,
   "end": 723.93,
   "text": "اصلا برزخ ما همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 723.93,
   "end": 726.51,
   "text": "صور انشائیه وجودمونه. ملکاتمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 726.51,
   "end": 729.01,
   "text": "بریز بیرون. چی ثبت کردی تو وجودت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 729.01,
   "end": 733.17,
   "text": "حالا یه نشئه صغراش برزخ نشئه کبراش قیامته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 733.17,
   "end": 735.85,
   "text": "چی دیدی و چی شنیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 735.85,
   "end": 738.31,
   "text": "همونا تو وجودت ثبت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 738.31,
   "end": 741.97,
   "text": "این یکی از امتحانات و ابتلاءات سنگین الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 741.97,
   "end": 744.13,
   "text": "که ما به راحتی ازش می‌گذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 744.13,
   "end": 746.93,
   "text": "حالا بذار اینو ببینیم. حالا این حرفو بشنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 746.93,
   "end": 752.43,
   "text": "لذا وقتی یه غیبت آمیز جواد آقا می‌شنوه چهل روز به چله می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 752.43,
   "end": 754.51,
   "text": "یه غیبت می‌شنوه فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 754.51,
   "end": 756.81,
   "text": "اینه چون می‌دونه تو وجودش تثبیت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 756.81,
   "end": 759.19,
   "text": "قربونتون برم. وجود ما ثابته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 759.19,
   "end": 763.85,
   "text": "دیگه هم لایتأخر. ع-- بعد اون موقع میگن اقرأ كتابك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 763.85,
   "end": 768.31,
   "text": "بخوان خودت رو. كفى بنفسك اليوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 768.31,
   "end": 772.15,
   "text": "عليك حسيبا. خودت بسی برای حسابرسی خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 772.15,
   "end": 774.53,
   "text": "اصلا ملکی نمیخواد. کسی رو نمیخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 774.53,
   "end": 776.87,
   "text": "خودت می‌دونی چه کاره‌ای. ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 776.87,
   "end": 781.33,
   "text": "ختم کلام عزیزان دلم قربونتون برم ما با خودمون محشور میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 781.33,
   "end": 783.63,
   "text": "مح-- حشر ما خودمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 783.63,
   "end": 786.13,
   "text": "برزخ و قیامت ما خودمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 786.13,
   "end": 788.61,
   "text": "بهشت و جهنم تو خود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 788.61,
   "end": 791.05,
   "text": "میگه وجيء يومئذ بجهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 791.05,
   "end": 794.79,
   "text": "جهنم رو میارن. اصلا خدا جهنم خلق نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 794.79,
   "end": 797.67,
   "text": "خودت تو وجود خودت بهشت یا جهنم خلق می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 797.67,
   "end": 799.95,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 799.95,
   "end": 804.43,
   "text": "به برکت صلوات بر محمد و آل محمد. الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}