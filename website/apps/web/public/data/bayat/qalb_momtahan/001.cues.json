 },
 "chapters": [
  {
   "index": 0,
   "title": "## وطن اتخاذی؛ سقف دو وطن جدید",
   "start": 1.26,
   "end": 107.5
  },
  {
   "index": 1,
   "title": "## قلب ممتحن؛ یغضون اصواتهم",
   "start": 107.5,
   "end": 288.66
  },
  {
   "index": 2,
   "title": "## علم امام؛ سببِ سکوتِ تسلیم",
   "start": 288.66,
   "end": 547.91
  },
  {
   "index": 3,
   "title": "## قرآن ناطق و امام مبین",
   "start": 547.91,
   "end": 634.89
  },
  {
   "index": 4,
   "title": "## نامهٔ سربه‌مهر هر امام",
   "start": 634.89,
   "end": 769.39
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.26,
   "end": 4.78,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.78,
   "end": 8.62,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.62,
   "end": 12.82,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.82,
   "end": 20.82,
   "text": "سؤال اینه که حالا که بحث وطن هست ما به جز وطن اصلیمون چند تا وطن دیگه می‌تونیم اتخاذ کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.82,
   "end": 22.72,
   "text": "یعنی وطن جدید بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.72,
   "end": 26.32,
   "text": "وطن اتخاذی میشه وطن جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.32,
   "end": 29.22,
   "text": "چند تا وطن می‌تونیم بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.22,
   "end": 33.54,
   "text": "دو تا، سه تا، چهار تا، ده تا، هر چند تا می‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.54,
   "end": 35.76,
   "text": "نظر رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.76,
   "end": 43.54,
   "text": "این هستش که ما فقط به جز وطن اصلیمون می‌تونیم دو تا وطن اتخاذی دیگه داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.54,
   "end": 49.28,
   "text": "دو تا وطن جدید و وطن سوم رو ایشون منوط کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.28,
   "end": 51.78,
   "text": "گفتن اشکال داره وطن سوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.78,
   "end": 55.32,
   "text": "اما منوط کردن به صدق عرف شرعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.32,
   "end": 61.64,
   "text": "یعنی چی؟ یعنی اگر دیگه مثلا کسی سه تا وطن اتخاذی به جز وطن اصلیش سه تا وطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.64,
   "end": 64.3,
   "text": "جدید مثلا اختیار کرده بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.3,
   "end": 67.26,
   "text": "به قول رهبری در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.26,
   "end": 71.54,
   "text": "سال که دوازده ماهه بخواد تو هر کدومش مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.54,
   "end": 74.84,
   "text": "تو هر کدوم از این وطن‌ها چهار ماه بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.84,
   "end": 79.42,
   "text": "سه چهار تا دوازده تا. تو وطن‌های اتخاذی جدیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.42,
   "end": 85.0,
   "text": "اگر صدق عرفی این باشه یعنی عرف بگه این آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.0,
   "end": 92.44,
   "text": "این سه تا وطنشن. تو س-- عرف اینطوری جا بیفته اشکال نداره به نظر رهبری و الا مورد اشکاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.44,
   "end": 95.62,
   "text": "یعنی وطن سوم رو نمی‌تونه بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.62,
   "end": 101.88,
   "text": "پس اونچه که م-م-مهمه است اینه که بدونیم ما بیش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.88,
   "end": 103.88,
   "text": "دو تا وطن جدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.88,
   "end": 107.5,
   "text": "نمی‌تونیم بگیریم مگر با صدق عرفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.5,
   "end": 110.46,
   "text": "قلب جدیدی که به فضل الهی مورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.46,
   "end": 113.4,
   "text": "بحث قرار می‌گیره با توجه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.4,
   "end": 116.72,
   "text": "آیات و روایات بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.72,
   "end": 118.92,
   "text": "قلب ممتحن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.92,
   "end": 123.14,
   "text": "ممتحن. ممتحن یعنی کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.14,
   "end": 126.28,
   "text": "مورد امتحان واقع میشه، امتحان میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.28,
   "end": 129.98,
   "text": "منتحن یعنی کسی که این امتحان رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.98,
   "end": 132.2,
   "text": "بحث بسیار ظریفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.2,
   "end": 134.62,
   "text": "بحث بسیار دقیقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.62,
   "end": 141.5,
   "text": "و اونطور که بنده دقت نظر داشتم کمتر مورد توجه قرار گرفته این موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.5,
   "end": 148.94,
   "text": "حالا شما همین امروز با همین نق-نقطه آغازینمون متوجه میشید که چه اسراری درش خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.94,
   "end": 151.12,
   "text": "آیه‌ای که این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.12,
   "end": 153.88,
   "text": "درش مطرح شده آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.88,
   "end": 158.84,
   "text": "سه سوره حجرات هست که تو بحث قلب منافق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.84,
   "end": 164.6,
   "text": "ما اشاره‌ای بهش کردیم. گفتیم منافق همش نق میزنه، همش انقلت میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.6,
   "end": 167.38,
   "text": "اشکال میکنه، اینها تسلیم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.38,
   "end": 170.3,
   "text": "ولی اشاره به این آیه کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.3,
   "end": 177.48,
   "text": "نه عده‌ای هستند که برعکس منافقین، اصلاً اینا به شدت اهل تقوا هستند و اهل تسلیم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.48,
   "end": 183.98,
   "text": "اشاره به این آیه کردیم. می‌فرماید \"إن الذين يقضون أصواتهم عند رسول الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.98,
   "end": 189.7,
   "text": "عده‌ای هستند که اینها اصلاً هیچ حرفی پیش پیغمبر و امامشون ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.7,
   "end": 193.5,
   "text": "\"يقضون\" صداشون رو فرو می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.5,
   "end": 198.24,
   "text": "اصلاً هیچی، هیچ‌گونه حرفی، نظری، تحلیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.24,
   "end": 201.76,
   "text": "هیچ حرفی در برابر امام و رسولشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.76,
   "end": 204.82,
   "text": "پیغمبرشون ندارن. بعد اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.82,
   "end": 208.1,
   "text": "خدای منّان به یک ظرافت خاصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.1,
   "end": 212.5,
   "text": "این‌هایی که تسلیم محض هستند، رو اون معنای تسلیمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.5,
   "end": 216.28,
   "text": "\"يقضون أصواتهم عند رسول الله\" تسلیم محض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.28,
   "end": 223.04,
   "text": "که ما گفتیم مصداق اتمش مثل مثلاً اباالفضل العباس سلام الله علیه یادتون باشه مثال دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.04,
   "end": 228.12,
   "text": "حالا اینجا برای اینکه برا ما بهتر این باز بشه خدا می‌فرماید \"أولئك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.12,
   "end": 231.28,
   "text": "می‌خواید بهتون بگم اینا دوباره چه خصوصیت‌هایی دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.28,
   "end": 234.98,
   "text": "اصلاً چرا اینطوری شدن؟ \"أولئك الذين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.98,
   "end": 238.0,
   "text": "امتحن الله قلوبهم للتقوى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.0,
   "end": 240.42,
   "text": "لهم مغفرة وأجر عظيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.42,
   "end": 244.66,
   "text": "اولاً انقدر این‌ها اجرشون بزرگه که خدای عظیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.66,
   "end": 247.28,
   "text": "میگه براشون اجر عظیم در نظر گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.28,
   "end": 253.44,
   "text": "\"لهم مغفرة\" غفران الهی شامل حال این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 253.44,
   "end": 256.4,
   "text": "یه بخش خدا صفح می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.4,
   "end": 261.58,
   "text": "میپیش-- می پوشونه. یه بخش غفران خیلی بالاتر از اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.58,
   "end": 264.76,
   "text": "پوشوندن یعنی وجود داره تو نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.76,
   "end": 269.04,
   "text": "آبروداری می‌کنه. اما غفران یعنی اصلاً محو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.04,
   "end": 272.22,
   "text": "غفران یعنی اون زشتی رو از تو محو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.22,
   "end": 275.3,
   "text": "خیلی بالاتره. خب این میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 275.3,
   "end": 282.54,
   "text": "برای اولاً \"قلوبهم للتقوى\" یعنی بحثی که بعداً باید بکنیم قلبشون مورد امتحان واقع میشه برای تقوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 282.54,
   "end": 287.08,
   "text": "اما این‌ها که مورد امتحان واقع میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.08,
   "end": 295.36,
   "text": "و در این امتحان نمرشون بیست میشه لذا تسلیم محض‌اند توجه به چه چیزهایی دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.36,
   "end": 303.32,
   "text": "این خیلی مهمه. در این امتحان به چی توجه می‌کنند که تسلیم محض امام و پیغمبرند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.32,
   "end": 305.88,
   "text": "اینو یه نقطه نظریه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.88,
   "end": 308.98,
   "text": "توجه بکنین ببینین ما اصلاً اینطوری می‌بینیم امام رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 308.98,
   "end": 313.08,
   "text": "پیغمبر رو. یکی از اون عللی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.08,
   "end": 317.56,
   "text": "این دست آدم‌هایی که مورد امتحان واقع میشن، نمرشون بیست میشه، هیچ حرفی در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.56,
   "end": 320.76,
   "text": "خدا و پیغمبر و رسولش و قرآن ندارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.76,
   "end": 323.86,
   "text": "علم امامه، علم پیغمبره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.86,
   "end": 327.32,
   "text": "علم. از اسامی خدا علیمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.32,
   "end": 333.28,
   "text": "علم مطلق نظام هستی نزد پیغمبر و امام معصومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.28,
   "end": 337.94,
   "text": "حالا به چند تا مثال من چند تا نمونه براساس روایات به شما بگم ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.94,
   "end": 344.86,
   "text": "اولاً دلیل اولی ما \"تنزل الملائكة والروح فيها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 344.86,
   "end": 351.78,
   "text": "نازل میشن همه ملائکه و روح که حالا اون روح باید بحث بشه چه کسی هست کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 351.78,
   "end": 358.34,
   "text": "بعضیا میگن حضرت عیسی روح اللهه، بعضیا میگن روح الامینه، بعضیا میگن روح القدس هرکی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.34,
   "end": 360.52,
   "text": "این نازل میشه شب قدر بر امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 360.52,
   "end": 363.04,
   "text": "چرا؟ برای اینکه علوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 363.04,
   "end": 365.65,
   "text": "طی سال رو به امام بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 365.65,
   "end": 369.85,
   "text": "علوم طی سال. ببینید حتی پیغمبر هم یک نزول دفعی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 369.85,
   "end": 372.07,
   "text": "\"انا انزلناه\" نازل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.07,
   "end": 377.71,
   "text": "نزول دفعیه. دفع-- اصلاً همه قرآن که علم جمعه است نزد پیغمبر بر قلبش نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.71,
   "end": 382.33,
   "text": "قبلاً بحثش گذشته. \"تنزل الملائكة\" نزول دفعی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 382.33,
   "end": 386.27,
   "text": "یعنی در هر سال در اون بیست و سه سال پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 386.27,
   "end": 391.23,
   "text": "رسالتشون در هر سال آیاتی که پیغمبر به اون‌ها باید استناد می‌کرد و شأن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.23,
   "end": 394.13,
   "text": "نزولش بعد رخ می‌داد، اون‌ها رو به پیغمبر نازل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 394.13,
   "end": 396.77,
   "text": "بر امام هم هر سال اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.77,
   "end": 398.95,
   "text": "هر اتفاقی طی سال می‌خواد را--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.95,
   "end": 403.37,
   "text": "اتفاق بیفته، آیه شبقت بر امام نازل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 403.37,
   "end": 406.03,
   "text": "پس امام هم-همه علوم نزدش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 406.03,
   "end": 408.79,
   "text": "این یک معنا، به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 408.79,
   "end": 413.09,
   "text": "معنای بعدی یا نکته بعدی این که امام هر شب جمعه معراج می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.09,
   "end": 417.79,
   "text": "خدا رحمت کنه مرحوم علامه همدانی‌ها در کتاب الشمس الطالعه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.79,
   "end": 422.85,
   "text": "که کتاب سنگینی و ثقیلی هست در شرح زیارت جامعه، اونجا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 422.85,
   "end": 430.49,
   "text": "بحث رو مبسوط میاره. خیلی هم سنگینه که امام زمان ما الان هر شب جمعه می-- شنیدید می‌ره کربلا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.49,
   "end": 432.75,
   "text": "معراج حضرت اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 432.75,
   "end": 436.49,
   "text": "عروجش می‌ره با آسمون‌ها نزد پیغمبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.49,
   "end": 438.75,
   "text": "اجدادشون. اونجا علم اخذ می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 438.75,
   "end": 441.93,
   "text": "به مرتبه با علوم جدید برمی‌گردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 441.93,
   "end": 444.35,
   "text": "و این علوم هم فقط تو سینه آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.35,
   "end": 449.75,
   "text": "یعنی چی؟ آقا اگر چیزی رو میگه بر اساس علم الهی میگه و تو باید بگی چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.75,
   "end": 454.33,
   "text": "تسلیم محض باشی. \"اولئک الذين امتحن الله قلوبهم للتقوى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 454.33,
   "end": 458.21,
   "text": "اینا کسایی‌ان که مورد امتحان قرار می‌گیرن نمره‌شون بیست می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 458.21,
   "end": 461.33,
   "text": "چرا؟ \"یغضون أصواتهم عند رسول الله\" اصلاً حرفی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.33,
   "end": 466.85,
   "text": "چرا حرفی ندارن؟ چون که علم رو مح-محض علم رو نزد امامشون می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 466.85,
   "end": 470.15,
   "text": "حرف برا چی بزنن؟ می‌دونن همه چی پیش اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.15,
   "end": 474.33,
   "text": "نکته بعد که در اسد کافی مرحوم کلینی اعلا الله مقامه الشریف میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 474.33,
   "end": 477.97,
   "text": "می‌فرماید امام خودش فرموده امام صادق، امام باقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 477.97,
   "end": 482.35,
   "text": "فرمودن علیهم السلام که هر وقت ما اراده کنیم چیزی رو بدانیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.35,
   "end": 486.79,
   "text": "عمودی از نور از عرش الهی بلکه فوق عرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 486.79,
   "end": 491.15,
   "text": "تابیده می‌شه. یه عمودی از نور هست که میاد این عمود نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.15,
   "end": 494.89,
   "text": "حالا ااا امام اینطوری تشبیه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 494.89,
   "end": 500.17,
   "text": "عمودی از نور از عرش و فوق عرش تابش می‌کنه به ما می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 500.17,
   "end": 507.17,
   "text": "ما هرچی می‌خ-- حالا این تعبیر باید بشه ت-- باید متوجه بشیم یعنی چی این عمود از نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 507.17,
   "end": 513.33,
   "text": "جاش الان نیست. امام میگه هرچی می‌خوایم از علوم بدونیم تو این عمود نور نگاه می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 513.33,
   "end": 516.01,
   "text": "انگار یه دستنوشتی باشه، چیزی باشه از طرف خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 516.01,
   "end": 520.05,
   "text": "پس همه علم باز با توجه به این قصه پیش امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 520.05,
   "end": 525.91,
   "text": "اگر امام به امیرالمؤمنین-- پیغمبر به امیرالمؤمنین ااا می‌فرماید که علی جان نظر تو چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 525.91,
   "end": 528.37,
   "text": "می‌فرماید شما رسول خدایی بهتر می‌دانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 528.37,
   "end": 532.75,
   "text": "این علتشه. این یعنی همه ادب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 532.75,
   "end": 535.27,
   "text": "نکته بعدی این که البته هر کدوم از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 535.27,
   "end": 536.61,
   "text": "ن-نکاتی که من میگم قابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 536.61,
   "end": 541.87,
   "text": "بحث هست منتها ما دیگه تبرکاً میگیم میریم خودتون می‌دونید و دیگه با این روایات برید بررسی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.87,
   "end": 545.99,
   "text": "ما داریم شخم می‌زنیم شما برید دربیارید نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 545.99,
   "end": 549.55,
   "text": "نکته دیگه این که فرمودن که هر امامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 549.55,
   "end": 552.39,
   "text": "اولاً همه شنیدیم امام قرآن ناطق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 552.39,
   "end": 554.91,
   "text": "درسته؟ خود قرآن که ق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 554.91,
   "end": 558.71,
   "text": "کتاب صامت الهی‌ست، قرآن صامت بهش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 558.71,
   "end": 564.35,
   "text": "ظاهراً در سکوته و خدا هم قبل از خلقت هر چیزی سکوت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 564.35,
   "end": 568.35,
   "text": "و بحث سکوت قبلاً گذشت که چقدر ارزشمنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 568.35,
   "end": 576.77,
   "text": "این قرآن ناطق که امام است اگر قرآن صامت خودش در خصوص خودش فرموده \"تبیان لكل شيء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 576.77,
   "end": 580.73,
   "text": "یعنی همه چی تو قرآن هست، معرفیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 580.73,
   "end": 584.25,
   "text": "عرض شود تبیین همه چی در قرآن صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 584.25,
   "end": 589.15,
   "text": "اگر همه چی \"ولا رتب ولا یابسن الا في كتاب مبين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 589.15,
   "end": 595.41,
   "text": "پس قرآ-- قرآن ناطق که امام هست هم \"تبیین لكل شيء\" تو وجودش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 595.41,
   "end": 597.85,
   "text": "یعنی همه چی در وجود امام هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 597.85,
   "end": 603.81,
   "text": "یه آیه ای هم در قرآن هست که می‌فرماید \"و كل شيء احصيناه في امام مبين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 603.81,
   "end": 606.23,
   "text": "یه جا می‌فرماید \"في كتاب مبين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 606.23,
   "end": 612.81,
   "text": "جالبه از پیغمبر سؤال کردن که آقا این امام مبین که همه چی درش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 612.81,
   "end": 618.31,
   "text": "\"كل شيء احصيناه\" همه چی درش درج شده، شمارش شده، این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 618.31,
   "end": 621.69,
   "text": "این چیه؟ این چه کتابیه؟ \"في كتاب مبين\" هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 621.69,
   "end": 623.67,
   "text": "همون لحظه امیرالمؤمنین وارد مسجد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 623.67,
   "end": 626.23,
   "text": "پیغمبر اشاره کرد فرمود \"و انه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 626.23,
   "end": 631.35,
   "text": "امام مبين\" یا \"و هو امام مبين\" یا \"كتاب مبين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 631.35,
   "end": 634.89,
   "text": "دوتاش هم داریم. و همه چی تو وجود او هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 634.89,
   "end": 641.21,
   "text": "نکته آخر این که، که این نکته آخر بسیار مورد توجه باید واقع بشه که متاسفانه کمتر میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 641.21,
   "end": 645.17,
   "text": "هر امامی طبق روایات البته نکات بیشتری بود، فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 645.17,
   "end": 650.13,
   "text": "هر امامی طبق روایات یه نامه سر به مهر از خدا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 650.13,
   "end": 653.33,
   "text": "دستوری از طرف خدا براش نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 653.33,
   "end": 655.75,
   "text": "هر امام مختص خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 655.75,
   "end": 660.15,
   "text": "هر امامی هم فقط اجازه داره نامه خودش رو باز کنه مهرشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 660.15,
   "end": 666.13,
   "text": "این‌ها دست به دست رسیده. الان امام عصر ما نامه طویلی از سمت خدا سر به مهر داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 666.13,
   "end": 671.69,
   "text": "که تمام دستورات چگونه زندگی کردن و چ-چگونه عمل کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 671.69,
   "end": 674.31,
   "text": "اماما درش درج شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 674.31,
   "end": 681.07,
   "text": "که در خ-- جالبه بدونید در خصوص سید الشهدا او تنها امامی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 681.07,
   "end": 684.93,
   "text": "نمی‌دونم حالا چه جایگاهی داشتن یاران ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 684.93,
   "end": 688.19,
   "text": "اون تنها امامی‌ست که شب، شب عاشورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 688.19,
   "end": 694.61,
   "text": "نامه سر به مهر خودش رو باز کرد و به یارانش که قرار بود فردا شهید شن نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 694.61,
   "end": 701.05,
   "text": "الله اکبر. جالبه که امام حسین نشون داد فرمود تا این بخش از نامه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 701.05,
   "end": 708.63,
   "text": "فردا محقق می‌شه. بخش دوم نامه ما در رجعت کارهایی که می‌مونه ما تو رجعت میایم تمومش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 708.63,
   "end": 713.47,
   "text": "پس این نشون می‌ده که نامه اهل بیت داشتن که همه دستورات درش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 713.47,
   "end": 716.31,
   "text": "و اگر چنین هست چرا ما در برابر امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 716.31,
   "end": 721.87,
   "text": "امام زمانمون، در برابر قرآنمون و پیغمبر و دینمون حرفی برای گفتن داشته باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 721.87,
   "end": 724.99,
   "text": "نظری داشته باشیم؟ باید تسلیم محض باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 724.99,
   "end": 729.71,
   "text": "\"یغضون أصواتهم عند رسول الله\" اینا اصلاً حرفی، صدایی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 729.71,
   "end": 733.51,
   "text": "هیچ صدایی ندارن. آروم در سکوت محض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 733.51,
   "end": 735.95,
   "text": "اون موقع است که اگر کسی به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 735.95,
   "end": 738.75,
   "text": "لطف رسید می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 738.75,
   "end": 741.25,
   "text": "دا-- عرض شود قضای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 741.25,
   "end": 747.25,
   "text": "عقل چیه؟ قبلاً گفتیم جسم غذاش همین چیزاییه که می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 747.25,
   "end": 751.97,
   "text": "روح غذاش حرف زدنه. الان من روحم داره تغذیه می‌شه، حرف خوب می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 751.97,
   "end": 754.69,
   "text": "عقل الان عقل شما داره تغذیه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 754.69,
   "end": 759.61,
   "text": "عقل غذاش سکوته. وقتی سکوت محض داشتی عاقل می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 759.61,
   "end": 763.77,
   "text": "اگر عاقل شدی همه ایمان رو درک می‌کنی ان شا الله تو وجودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 763.77,
   "end": 766.51,
   "text": "عاقبتش ان شا الله ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 766.51,
   "end": 768.75,
   "text": "به برکت صلوات بر محمد آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 768.75,
   "end": 769.39,
   "text": "اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}