 },
 "chapters": [
  {
   "index": 0,
   "title": "## تسلیت شهادت حضرت خدیجه؛ پاداش فاطمه",
   "start": 16.5,
   "end": 151.8
  },
  {
   "index": 1,
   "title": "## مقام محمود؛ اجماع مفسران بر شفاعت کبرا",
   "start": 151.8,
   "end": 282.38
  },
  {
   "index": 2,
   "title": "## بهره‌مندی ما از مقام محمود با تهجد",
   "start": 282.38,
   "end": 338.86
  },
  {
   "index": 3,
   "title": "### تهجد؛ بیداری پس از خواب",
   "start": 338.86,
   "end": 490.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.78,
   "end": 8.72,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.72,
   "end": 12.52,
   "text": "السلام علیک ای داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.52,
   "end": 16.5,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.5,
   "end": 19.9,
   "text": "تسلیت و تعزیت عرض می‌کنم روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.9,
   "end": 27.94,
   "text": "شهادت، میگن وفات، وفات، شهادت حضرت خدیجه سلام الله علیها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.94,
   "end": 32.92,
   "text": "که به واقع ام المؤمنین بودند و هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.92,
   "end": 35.92,
   "text": "خیلی پیغمبر برای ایشون گریه کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.92,
   "end": 39.62,
   "text": "و خیلی دوست دارم البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.62,
   "end": 46.3,
   "text": "در خصوص خانم صحبت کنیم اما واقعا زبانم رو قاصر می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.3,
   "end": 49.2,
   "text": "که چیزی بگم باید بعدش توبه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.2,
   "end": 51.56,
   "text": "ما کی هستیم که از ایشون بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.56,
   "end": 57.58,
   "text": "فقط یه جمله عرض کنم که علامه حسن زاده این اندیشمند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.58,
   "end": 65.06,
   "text": "آره اندیشمند بی‌مث-مثال و بی‌بدل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.06,
   "end": 71.88,
   "text": "ایشون فرمودن که زحماتی که این بانو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.88,
   "end": 76.3,
   "text": "در راه اسلام و برای پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.3,
   "end": 80.48,
   "text": "کشید، خدا بهش پاداشی داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.48,
   "end": 85.4,
   "text": "خب جزای الوفا وا دیگه طبق قرآن، جزا باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.4,
   "end": 88.48,
   "text": "به وفق عمل باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.48,
   "end": 92.96,
   "text": "ببینید عمل چیه که جزاش شده چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.96,
   "end": 102.74,
   "text": "فرمودن پاداش زحمات حضرت خدیجه سلام الله علیها این شد که خدای منان به او فاطمه زهرا رو بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 102.74,
   "end": 105.32,
   "text": "سلام الله علیها. حالا روش فکر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 105.32,
   "end": 108.66,
   "text": "همین یه جمله رو نمی‌خواد اصلاً ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.66,
   "end": 112.32,
   "text": "چه کرده که پاداشش-- حالا خب شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.32,
   "end": 115.9,
   "text": "کاری انجام میدی بعد مثلا حقوقی می‌گیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 115.9,
   "end": 119.34,
   "text": "یه حقوقی بهت میدن. اما یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 119.34,
   "end": 126.02,
   "text": "زحمتی، یه کاری در کنار اون حقوق متعارفی که می‌گیری نه یه گلی می‌زنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.02,
   "end": 128.86,
   "text": "که بهت هدیه می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.86,
   "end": 132.72,
   "text": "هبه می‌کنن، پاداش بهت میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.72,
   "end": 138.38,
   "text": "مثلا اون که بالا دستیته میگه اصلا یه گلی زدی که میخوام یه پاداش جانانه بهت بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.38,
   "end": 145.86,
   "text": "یه کاری کرده به قول کارستون حضرت خدیجه حالا حرف دیگه بزرگان زیاد پیاده کردن و بیشتر از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 145.86,
   "end": 149.82,
   "text": "وقتتون رو نگیرم که از بحثمونم جا نمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 149.82,
   "end": 153.56,
   "text": "فرصت خیلی زیاده. در بحث مقام محمود بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 153.56,
   "end": 157.18,
   "text": "\"و من الليل فتهجد به نافلة الليل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 157.18,
   "end": 160.52,
   "text": "عسی ان يبعثک ربک مقاماً محموداً\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 160.52,
   "end": 165.98,
   "text": "من چند تا منبع براتون معرفی کنم که اینا همه مفسرین شیعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 165.98,
   "end": 172.4,
   "text": "در کتاب‌های تفسیریشون همه عنوان کردن که مقام محمودی که تو این آیه اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 172.4,
   "end": 177.28,
   "text": "همون مقام شفاعت کبرى پیغمبره که روایاتی رو در خصوصش تقدیم کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 177.28,
   "end": 183.98,
   "text": "مثلاً مرحوم شیخ طوسی، مرحوم طبرسی در مجمع البیانش، فیض کاشانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 183.98,
   "end": 189.74,
   "text": "داماد ملاصدرا، مرحوم بحرانی، مرحوم عیاشی، مرحوم رازی، شبّر؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 189.74,
   "end": 192.8,
   "text": "یه کتابی دارن ایشون به نام اخلاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 192.8,
   "end": 197.78,
   "text": "اخلاق علامه شبّر توصیه می‌کنم بخونید خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 197.78,
   "end": 201.5,
   "text": "مثل چهارشیره‌ست. شیرینیش مثل چهارشیره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 201.5,
   "end": 204.4,
   "text": "بعضی چیزا رو من میگم ث عسله مال ایشون مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 204.4,
   "end": 208.78,
   "text": "حالا دلایلی هم داریم. علامه طه طباطبایی، آقای مکارم، آقای جوادی آملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.78,
   "end": 211.18,
   "text": "اینا همه معتقدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 211.18,
   "end": 218.14,
   "text": "مقام محمودی که تو این آیه اومده همون مقام شفاعت کبراست که به جهت تهجد به پیغمبر داده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 218.14,
   "end": 226.24,
   "text": "منابع روایی هم که می‌تونید ببینید که روایاتی رو علما آوردن مثلاً شیخ صدوق، علامه مجلسی، مرحوم عیاشی اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 226.24,
   "end": 231.42,
   "text": "تو منابع رواییشون آوردن و هر روایاتی رو پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 231.42,
   "end": 239.06,
   "text": "شفاعت مطرح کردن و خیلی شیرین می‌تونید جوجی کنید که چند تاشو البته ما خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 239.06,
   "end": 242.82,
   "text": "در کتاب تفسیر نور الثقلین که روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 242.82,
   "end": 247.06,
   "text": "علامه خیلی تأکید می‌کرد به خوندن این تفاسیر روایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 247.06,
   "end": 250.5,
   "text": "مثل تفسیر صافی، مثل تفسیر نور الثقلین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 250.5,
   "end": 256.06,
   "text": "جلد سه، صفحه دویست و شش از امام صادق صلوات الله علیه روایت آورده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 256.06,
   "end": 262.38,
   "text": "در خصوص مقام محمود فرمود مقام و مرتبه‌ایست که همه پیشینیان و متاخران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 262.38,
   "end": 266.12,
   "text": "همه به همه غبطه می‌خورن به حال این مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 266.12,
   "end": 269.1,
   "text": "و صاحبش که پیغمبره. همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 269.1,
   "end": 272.88,
   "text": "حتی حضرت ابراهیم که به مقام امامتش رسیده غبطه می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 272.88,
   "end": 280.68,
   "text": "عجیبه. نور الثقلین باز جلد سه، صفحه سیصد و نود و دو هم باز از پیغمبر روایت آورده که مقام محمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 280.68,
   "end": 285.86,
   "text": "مقامی‌ست که من در آن برای امتم شفاعت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 285.86,
   "end": 290.38,
   "text": "عجب مقامیه و پیغمبر اونو خرج کی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 290.38,
   "end": 292.54,
   "text": "خرج ماها می‌کنه. توجه دارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 292.54,
   "end": 296.5,
   "text": "این مقام رو خرج ماها می‌خواد بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 296.5,
   "end": 302.16,
   "text": "خیلی حرفه. پدر همه مقامشو ذخیره کرده برای بچه‌هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 302.16,
   "end": 307.28,
   "text": "دیگه چی بگیم؟ حالا برای اینکه خیلی هم ناامید نشیم ماها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 307.28,
   "end": 310.22,
   "text": "یه فرمایش یکی از آقایان مکارم خدمتتون تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 310.22,
   "end": 314.26,
   "text": "ایشون می‌فرماید با ت-- عین کلامشونه، با تهجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 314.26,
   "end": 321.42,
   "text": "هر کسی نسبت به میزان بهره‌مندی‌اش از مقام محمود اهل شفاعت خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 321.42,
   "end": 326.9,
   "text": "پس پیداست که ما هم می‌تونیم به مقام محمود برسیم اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 326.9,
   "end": 331.56,
   "text": "به قدر سعه وجودیمون به بخشی از اون مقام کلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 331.56,
   "end": 333.7,
   "text": "توجه-- با چی؟ با نماز شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 333.7,
   "end": 336.66,
   "text": "\"و من الليل فتهجد به نافلة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 336.66,
   "end": 338.86,
   "text": "البته دقت داشته باشید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 338.86,
   "end": 341.28,
   "text": "تهجد از وجود میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 341.28,
   "end": 344.42,
   "text": "وجود یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 344.42,
   "end": 348.04,
   "text": "اینم نکته‌ست ها. حالا عرض می‌کنم چرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 348.04,
   "end": 352.68,
   "text": "وجود یعنی بیداری بعد از خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 352.68,
   "end": 358.34,
   "text": "بعضیا شب تا صبح این سریالو بخون-- ببین، این فوتبال رو نگاه کن، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 358.34,
   "end": 363.26,
   "text": "مثلاً کانالو تو موبایل بررسی کنن بعد بگه سحر شد بعد میشینه نماز شب می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 363.26,
   "end": 366.04,
   "text": "اینم خوبه‌ها. نه که نخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 366.04,
   "end": 369.74,
   "text": "اما این ارزشش اون نیست که تهجد چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 369.74,
   "end": 374.34,
   "text": "تهجد چیه؟ ریشه‌ش از حجوت یعنی بخوابی بیدار بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 374.34,
   "end": 377.88,
   "text": "تو اراده کنی بعد از خواب، اون خواب شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 377.88,
   "end": 380.14,
   "text": "اون ساعت سحر رو پاشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 380.14,
   "end": 382.74,
   "text": "این هنره. میگه پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 382.74,
   "end": 383.84,
   "text": "خیلی عجیبه. الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 383.84,
   "end": 389.98,
   "text": "میگم یه نکته‌ایه پیغمبر چرا هر دو رکعت می‌خوند می‌خوابید دوباره پا میشد دوباره می‌خوابید دوباره--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 389.98,
   "end": 393.68,
   "text": "می‌خواد هر دو رکعتش تهجد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 393.68,
   "end": 398.88,
   "text": "ما همون دو رکعت اولمون تهجده بقیه‌ش تهجد نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 398.88,
   "end": 403.76,
   "text": "چون دو رکعت اول با از خواب پاشیدی دیگه بقیه‌ش ادامه‌ی اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 403.76,
   "end": 406.26,
   "text": "کی دیگه در معاصر ما کی این کارو می‌کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 406.26,
   "end": 408.6,
   "text": "خدا هم عجب مقامی بهش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 408.6,
   "end": 411.4,
   "text": "شهید سلیمانی عزیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 411.4,
   "end": 413.94,
   "text": "مثال روحش صلواتی هدیه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 413.94,
   "end": 419.32,
   "text": "اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 419.32,
   "end": 423.12,
   "text": "حالا مطالب دیگه‌ای هم داشتیم فرصت تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 423.12,
   "end": 425.72,
   "text": "بله ایشون یکی از رفیقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 425.72,
   "end": 431.46,
   "text": "خیلی نزدیک ایشون من ازشون شنیدم که فرمود به منم گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 431.46,
   "end": 434.54,
   "text": "بعد از اینکه من از دنیا رفتم اینو فاش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 434.54,
   "end": 437.34,
   "text": "بعد از شهادتش من از ایشون شنیدم و تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 437.34,
   "end": 440.94,
   "text": "رسانه هم دیدم یه روز دعوتش کرده بودن می‌گفت رفیق حاج قاسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 440.94,
   "end": 444.16,
   "text": "گفتش که حاج قاسم سی و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 444.16,
   "end": 452.12,
   "text": "خودش گفته بود من سی و چهار پنج ساله که نماز شبم ترک نشده به نحو نماز شب پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 452.12,
   "end": 454.72,
   "text": "آره داداش. اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 454.72,
   "end": 458.38,
   "text": "شروع نیمه شب دو رکعتشو می‌خوند می‌خوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 458.38,
   "end": 460.72,
   "text": "دوباره پا میشد دو رکعت دیگه دوباره می‌خوابیدها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 460.72,
   "end": 467.26,
   "text": "ما می‌تونیم؟ من با این همه ادعام که بهم میگید فیلسوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 467.26,
   "end": 472.36,
   "text": "بازرسی نه می‌گفتن جهان ما گفتیم لااقل بگید بازرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 472.36,
   "end": 479.76,
   "text": "بعد خدا شاهده هر بار امتحان کردم همون دو رکعت اول نصیبم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 479.76,
   "end": 483.28,
   "text": "رفت تا اذان صبح. نمی‌شه آقا کار هر کسی نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 483.28,
   "end": 485.8,
   "text": "این پر طاووسه به کرکس نمی‌لنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 485.8,
   "end": 489.1,
   "text": "والحمد لله رب العالمین صلوات خد کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 489.1,
   "end": 490.78,
   "text": "اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}