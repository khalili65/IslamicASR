 "chapters": [
  {
   "index": 0,
   "title": "## توحید افعالی در آیهٔ انفال",
   "start": 17.12,
   "end": 125.0
  },
  {
   "index": 1,
   "title": "## بلای حسن و بلای سیئه",
   "start": 125.0,
   "end": 193.4
  },
  {
   "index": 2,
   "title": "## شأن نزول؛ جنگ بدر و مفاخره",
   "start": 193.4,
   "end": 213.52
  },
  {
   "index": 3,
   "title": "## مشت خاک؛ دست علی و دم پیامبر",
   "start": 213.52,
   "end": 591.32
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 8.56,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.56,
   "end": 12.38,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.38,
   "end": 17.12,
   "text": "آیات. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.12,
   "end": 18.96,
   "text": "در بحث توحید افعالی بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.96,
   "end": 22.1,
   "text": "آیه هفده سوره انفال هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.1,
   "end": 25.0,
   "text": "سخن از توحید افعالی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.0,
   "end": 27.26,
   "text": "یه آیه مشهور و معروفیه خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.26,
   "end": 32.04,
   "text": "زمان جنگ خیلی بچه‌ها این رو لباشون جاری میشد یادش بخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.04,
   "end": 35.0,
   "text": "که می‌فرماید: \"فلم تقتلوهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.0,
   "end": 37.26,
   "text": "پس شما نبودید که اون‌ها رو کشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.26,
   "end": 40.62,
   "text": "\"ولکن الله قتلهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.62,
   "end": 42.6,
   "text": "بلکه الله اون‌ها رو کشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 42.6,
   "end": 48.08,
   "text": "دشمنان رو خدا کشت. \"وما رمیت اذ رمیت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.08,
   "end": 49.82,
   "text": "بعد رو می‌کنه به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.82,
   "end": 52.48,
   "text": "اون جمع بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 52.48,
   "end": 56.82,
   "text": "خطاب به همه مؤمنین که شما نکشتید، خدا کشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 56.82,
   "end": 59.12,
   "text": "حالا رو می‌کنه به پیغمبر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 59.12,
   "end": 62.14,
   "text": "این تیری که پرتاب کردی تو پرتاب نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 62.14,
   "end": 67.26,
   "text": "\"ولکن الله رمى\" خدا این تیر رو پرتاب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 67.26,
   "end": 71.62,
   "text": "حالا که چی بشه؟ خدا برای چی این فرمایش رو داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 71.62,
   "end": 75.22,
   "text": "\"وليبلى المؤمنين منه بلاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.22,
   "end": 79.2,
   "text": "حسنا\" اصلاً این برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 79.2,
   "end": 83.28,
   "text": "اهل ایمان رو مبتلا کنه البته به بلاى حسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 83.28,
   "end": 87.32,
   "text": "\"ان الله سميع عليم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 87.32,
   "end": 92.94,
   "text": "حالا چرا بلاى حسن؟ بلاى غیر حسن هم مگه ما داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 92.94,
   "end": 96.42,
   "text": "بله. وقتی که پروردگار سبحان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 96.42,
   "end": 102.96,
   "text": "ما رو با بلای مثلاً پیروزی، با نعمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.96,
   "end": 110.34,
   "text": "با امثال این‌ها امتحان می‌کنه، اون هم در حقیقت امتحان الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.34,
   "end": 113.42,
   "text": "اصلاً مهم نیست که کسی چیزی داره یا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.42,
   "end": 115.36,
   "text": "چیزی ازش اخذ شده یا نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.36,
   "end": 118.92,
   "text": "مهم اون عکس العملی است که در پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.92,
   "end": 122.14,
   "text": "اخذ نعمت یا دادن نعمت از ما سر می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.14,
   "end": 129.2,
   "text": "اون مهمه. اگر با پیروزی، با نعمت ما امتحان بشیم بهش میگن بلاى حسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.2,
   "end": 140.54,
   "text": "این تو قرآن اومده. مثلاً در خصوص بنی اسرائیل داریم که \"و بلاوناهم بالحسنات والسيئات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.54,
   "end": 144.9,
   "text": "این‌ها رو ما به بلاهایی دچار کردیم هم از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.9,
   "end": 147.32,
   "text": "بلای حسن هم از حیث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.32,
   "end": 150.2,
   "text": "حیث بلای چی؟ سیئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.2,
   "end": 155.64,
   "text": "اگر چنانچه با مصیبت باشه، با سختی باشه، با فقر باشه، با مریضی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.64,
   "end": 158.22,
   "text": "با این چیزا انسان بلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.22,
   "end": 161.58,
   "text": "سرش بریزه به این میگن بلاى سیئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.58,
   "end": 163.88,
   "text": "در هر دو صورت هر دوش امتحانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.88,
   "end": 167.4,
   "text": "اینطور نیست که خدا اونی که بلا ریخت سرش خالش کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.4,
   "end": 169.98,
   "text": "یا اونی که بهش نعمت داد عزت بهش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.98,
   "end": 173.62,
   "text": "نه. بارها رهبر عزیزمون خطاب به مدیران چی فرمودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.62,
   "end": 176.22,
   "text": "فرمودن این یک امتحانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.22,
   "end": 183.14,
   "text": "یک موهبت، یک نعمته که باید از این فرصت استفاده کنید در جهت خدمت به خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.14,
   "end": 188.36,
   "text": "و این سیر مدیریت‌تون رو مدیریت الهی کنید، نه شیطانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.36,
   "end": 193.18,
   "text": "رحمانی‌ش کنید. یعنی از اون نعمت در راه خدا استفاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.18,
   "end": 195.48,
   "text": "حالا این آیه کی نازل شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.48,
   "end": 198.16,
   "text": "جالبه که بدونید در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.16,
   "end": 206.26,
   "text": "شأن نزولش چنانچه خواستید رجوع کنید، کتاب شریف کافی مرحوم کلینی اعل الله مقامه الشریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.26,
   "end": 208.72,
   "text": "که اولین کتاب 四 شیعه است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.72,
   "end": 212.6,
   "text": "اولین کتابی‌ست که یه عالمی اومد معنون کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.6,
   "end": 219.04,
   "text": "عنوان بندیش کرد و عناوین رو ذیلش احادیث آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.04,
   "end": 223.24,
   "text": "از چهارصد اصلی که از بین شش هزار و ششصد اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.24,
   "end": 225.18,
   "text": "از شاگردان امام صادق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.18,
   "end": 230.3,
   "text": "از چهارصد اصل از اون شش هزار و ششصد اصل شاگردان حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.3,
   "end": 235.32,
   "text": "رسید به شیخ کلینی، از این چهارصد اصل که دست‌نوشت بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.32,
   "end": 239.6,
   "text": "شاگردای حضرت پای درس امام صادق نوشته بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.6,
   "end": 243.12,
   "text": "خطی بودن. از این‌ها این کتاب رو استخراج کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.12,
   "end": 246.14,
   "text": "بسیار کتاب عظیم الشأنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.14,
   "end": 251.92,
   "text": "اونجا روایت داره در صفحه سیصد و پنجاه و دو خواستید ملاحظه کنید در شأن نزول این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.92,
   "end": 256.5,
   "text": "که مربوط به جنگ بدره. خب پیروز شدند همه می‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.5,
   "end": 261.22,
   "text": "در صورتی که تو روایات میگه مثلاً یکی دو تا نهایت سه تا اسب داشتن این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.22,
   "end": 264.16,
   "text": "اون ور تا دلتون بخواد. تجهیزات اونور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.16,
   "end": 268.76,
   "text": "و تعداد، تعداد عده و عده‌شون حداقل سه برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 268.76,
   "end": 271.58,
   "text": "مسلمون‌ها بود. دیگه اینو می‌دونید همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.58,
   "end": 273.88,
   "text": "ولی باز مسلمون‌ها پیروز شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.88,
   "end": 280.56,
   "text": "خیلی جالبه. بعد این پیروزیشون باعث شد که افتادن بعد از جنگ تو همدیگه مفاخره می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.56,
   "end": 282.76,
   "text": "این می‌گفت فلانی رو من کشتم. مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.76,
   "end": 284.46,
   "text": "گنده‌لات‌شون رو من زدم زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.46,
   "end": 287.54,
   "text": "اون می‌گفت اون گردن کلفتشون رو من اسیر کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.54,
   "end": 291.08,
   "text": "این حرفا بین مؤمنین رواج پیدا شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.08,
   "end": 294.16,
   "text": "بعد خداوند این آیه رو نازل کرد که این حرفا چیه می‌زنین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.16,
   "end": 296.0,
   "text": "من کشتم و من کشتم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.0,
   "end": 299.72,
   "text": "\"فلم تقتلوهم\" شما نبودید که کشتیدشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.72,
   "end": 303.56,
   "text": "\"ولکن الله قتلهم\" خدا بود که اون‌ها رو کشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 303.56,
   "end": 306.68,
   "text": "حتی خطاب به پیغمبرش می‌فرماید:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 306.68,
   "end": 312.04,
   "text": "اونی که پرت کردی، حالا بعضیا اینجا می‌گیرن اون تیر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 312.04,
   "end": 314.0,
   "text": "ولی صرفاً اون تیر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.0,
   "end": 321.46,
   "text": "حالا خدمتتون عرض می‌کنم. هرچی که تو پرت کردی به سمت دشمن، الان این موشک‌هایی که ما داریم پرت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.46,
   "end": 323.84,
   "text": "به صراص قاطع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.84,
   "end": 326.28,
   "text": "به صریح آیه قرآن می‌تونیم بگیم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.28,
   "end": 329.5,
   "text": "\"ولکن الله رمى\" خدا پرت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.5,
   "end": 333.0,
   "text": "این اگر جا بیفته، این توحید افعالی اگر-- افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.0,
   "end": 335.74,
   "text": "اگر جا بیفته هم انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.74,
   "end": 340.12,
   "text": "در برابر دشمن تا بن دندان مسلح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 340.12,
   "end": 343.88,
   "text": "لحظه‌ای ترس و تردید به خودش راه نمیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 343.88,
   "end": 349.74,
   "text": "هم دچار عجب و غرور و تفاخر و این‌ها نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 349.74,
   "end": 352.6,
   "text": "حالا جالبه که بدونید اون لحظه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 352.6,
   "end": 355.4,
   "text": "خب پیغمبر مواجه شد با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 355.4,
   "end": 361.78,
   "text": "عده و عده دشمن و خب یه روحیم تو دل مسلمونا افتاده بود ابتدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 361.78,
   "end": 363.54,
   "text": "پيغمبر اینجا خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.54,
   "end": 365.9,
   "text": "حالا فرصت نیست، فرصت ما تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 365.9,
   "end": 370.0,
   "text": "ظهرها خیلی کمه. باید سریع بحث رو جمع کنیم ولی خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 370.0,
   "end": 373.42,
   "text": "توش خیلی نکات داره. پیغمبر به امیرالمؤمنین رو کرد نه به اهلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.42,
   "end": 375.74,
   "text": "حتی خود پیغمبر هم این کارو نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 375.74,
   "end": 379.72,
   "text": "خیلی جالبه که بدونید رو کرد به مولامون امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.72,
   "end": 387.4,
   "text": "حضرت عسی-- علی علیه الصلاة والسلام فرمود علی جان یه مشت خاک از زمین جمع کن بریز تو کف دست من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.4,
   "end": 390.34,
   "text": "خب آیا پیغمبر خودش این کارو نمی‌تونست بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 390.34,
   "end": 395.54,
   "text": "چرا به امیرالمؤمنین؟ اینا خودش حجت رو تمام کردن بر همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.54,
   "end": 398.98,
   "text": "باید دست علی بخوره به این خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.98,
   "end": 401.94,
   "text": "امیرالمؤمنین خاک رو برداشت ریخت کف دست پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.94,
   "end": 404.36,
   "text": "پیغمبر یک دعایی رو خوند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.36,
   "end": 408.58,
   "text": "دمید در این خاک و پرت کرد و ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 408.58,
   "end": 410.56,
   "text": "رمیت اذ رمیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.56,
   "end": 413.24,
   "text": "این پرتاب کردن نه فقط تیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 413.24,
   "end": 416.56,
   "text": "حتی این رو هم که به معجزه پرتاب کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 416.56,
   "end": 418.86,
   "text": "و لکن الله رمي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 418.86,
   "end": 422.64,
   "text": "بله، این میشه که وقتی این خاک رو پرتاب کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 422.64,
   "end": 426.18,
   "text": "مثل زمان جنگ خیلی از ما خاک پرتاب می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 426.18,
   "end": 430.04,
   "text": "اصلا جنگ مرصاد من یادمه که عزیزانی که بعضیاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 430.04,
   "end": 434.8,
   "text": "سنشون قطع می‌ره دیگه. یادمه که دیگه اصلا جنگ تن به تن شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 434.8,
   "end": 436.96,
   "text": "یعنی انقدر نزدیک شدیم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 436.96,
   "end": 443.06,
   "text": "دشمن وقتی افتادیم گلاویز شدیم دیگه اسلحه نمی‌تونست کار-- اونجا کارایی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 443.06,
   "end": 447.52,
   "text": "یه دفعه از مثلا پشت خاکریز بلند می‌شدیم می‌دیدیم یه غولی جلومونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 447.52,
   "end": 451.3,
   "text": "اینجا تا اسلحه رو برداری مسلح کنی، نه، اونجا جنگ تن به تن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 451.3,
   "end": 453.22,
   "text": "اونجا گاهی باور کنید با خاک بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 453.22,
   "end": 455.38,
   "text": "یعنی خاک می‌پاشیدیم تو صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 455.38,
   "end": 459.36,
   "text": "دشمن. میگه حتی این خاکی که پیغمبر تو پاشیدی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 459.36,
   "end": 461.22,
   "text": "تو نه پاشیدی، من گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 461.22,
   "end": 464.34,
   "text": "چرا؟ وقتی این خاک رو پاشید چه اتفاقی افتاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 464.34,
   "end": 466.8,
   "text": "خاک به سمت هزار نفر آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 466.8,
   "end": 471.66,
   "text": "چه-- به چه درد می‌خوره؟ اینایی که گول تجهیزاتشونو خوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 471.66,
   "end": 474.34,
   "text": "بیان پای درس قرآن ما زانو بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 474.34,
   "end": 477.4,
   "text": "ببینن رهبر عزیزمون دلش به چی خوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 477.4,
   "end": 481.28,
   "text": "بچه‌های انقلاب و مقاومت دلشون به چی خوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 481.28,
   "end": 484.28,
   "text": "با دست خالی اومدن به کجاها رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 484.28,
   "end": 492.16,
   "text": "خاکی که پرت کرد پیغمبر روایت داره یک توفان سهمگینی ایجاد شد از این خاک، از همین یه مشت خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 492.16,
   "end": 495.06,
   "text": "و به شدت دشمن هراسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 495.06,
   "end": 497.06,
   "text": "به لرزه افتاد. یعنی ترسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 497.06,
   "end": 499.76,
   "text": "دلشون اصطلاحا میگیم خالی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 499.76,
   "end": 504.82,
   "text": "با اینجور کارها پیغمبر اثبات کرد که بله، خداست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 504.82,
   "end": 509.28,
   "text": "شما رو داره پیروز میکنه. تا وقتی که این روحیه باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 509.28,
   "end": 512.56,
   "text": "سر سوزنی حالا سوریه رو گرفتن، عراق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 512.56,
   "end": 515.84,
   "text": "در حال تضعیف و تهدیدشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 515.84,
   "end": 518.26,
   "text": "لبنان رو میخوان خلع سلاح کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 518.26,
   "end": 520.94,
   "text": "ا- دور تا دور ایران رو قشنگ محاصره کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 520.94,
   "end": 524.62,
   "text": "اون هفت تا کشور و همه رو در و داغون کردن، خشن کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 524.62,
   "end": 528.2,
   "text": "این آخریش، اخیرم که اقرار کردن از اون هفت تا کشور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 528.2,
   "end": 533.44,
   "text": "چرا آخر سر رفتیم سراغ ایران، الان اومدی سر و کله‌مون به ایران پیدا شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 533.44,
   "end": 535.8,
   "text": "مکانیسم ماش و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 535.8,
   "end": 539.06,
   "text": "به جهت اینکه اینا همشون قدرتمندتر بود، ایران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 539.06,
   "end": 542.56,
   "text": "گذاشتیمشون آخر سر. خیلی حساس بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 542.56,
   "end": 545.6,
   "text": "الان ما به چی مفخره می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 545.6,
   "end": 548.22,
   "text": "به همین یه مک-- یه مشت خاکی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 548.22,
   "end": 552.8,
   "text": "در دست امام زمانمونو پرت کنه کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 552.8,
   "end": 555.22,
   "text": "به نفس مسیحایی امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 555.22,
   "end": 558.42,
   "text": "همون که تا حالا پرچم انقلاب رو بلند نگه داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 558.42,
   "end": 561.46,
   "text": "بیایید باور کنیم. باورها باورهای قرآنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 561.46,
   "end": 565.4,
   "text": "این کاغذی که دست منه میدم دستتون ببینید همش آیات و روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 565.4,
   "end": 568.4,
   "text": "حرفی از من بچه طلبه بی‌سواد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 568.4,
   "end": 570.92,
   "text": "اگر باور کنیم ترسی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 570.92,
   "end": 575.48,
   "text": "لرزشی نیست، یکپارچه خیزش و خروش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 575.48,
   "end": 580.2,
   "text": "انشاالله که زنده باشیم و نابودی اسرائیل و خاری آمریکا رو با چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 580.2,
   "end": 585.2,
   "text": "خودمون ببینیم. اللهم باریک لمولانا صاحب الزمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 585.2,
   "end": 587.06,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 587.06,
   "end": 591.32,
   "text": "صلوات الله اشهد ان محمدآ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}