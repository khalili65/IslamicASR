 "chapters": [
  {
   "index": 0,
   "title": "## غزل علامه طباطبایی؛ توحید افعالی",
   "start": 20.76,
   "end": 41.32
  },
  {
   "index": 1,
   "title": "## وقت موت؛ مواجهه با همهٔ توحید",
   "start": 41.32,
   "end": 62.38
  },
  {
   "index": 2,
   "title": "## ذکر ما شاء الله و فروریختن اخلاق خبیثه",
   "start": 62.38,
   "end": 106.66
  },
  {
   "index": 3,
   "title": "## بسیجی امام و غور در اندیشه‌ها",
   "start": 106.66,
   "end": 286.28
  },
  {
   "index": 4,
   "title": "## داستان خانه‌دار شدن امام خمینی",
   "start": 286.28,
   "end": 541.49
  },
  {
   "index": 5,
   "title": "## قاعدهٔ تقوا و توکل",
   "start": 541.49,
   "end": 588.21
  },
  {
   "index": 6,
   "title": "مانند یوسف که به سوی درهای بسته گریخت و درها گشوده شد. و ادامه می‌دهد:",
   "start": 588.21,
   "end": 624.67
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 7.66,
   "text": "اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.66,
   "end": 10.92,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.92,
   "end": 16.84,
   "text": "السلام علیک یا داعی الله و ربانیة آیاته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.84,
   "end": 20.64,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.64,
   "end": 28.64,
   "text": "یه بخشی از غزل علامه طباطبایی رو مرتبط با بحث توحید افعالیه بخونم کیف کنید یه‌ذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.64,
   "end": 33.52,
   "text": "فرمود تو مپندار که مجنون سر خود مجنون شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.52,
   "end": 36.64,
   "text": "از سمک تا به سماکش کشش لیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.64,
   "end": 44.34,
   "text": "بود. من به سرچشمه خورشید نه خود بردم راه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 44.34,
   "end": 49.4,
   "text": "ذره‌ای بودم و مهر تو مرا بالا برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 49.4,
   "end": 55.2,
   "text": "من خسی بی‌سر و پایم که به سیل افتادم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 55.2,
   "end": 58.88,
   "text": "او که می‌رفت مرا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.88,
   "end": 62.38,
   "text": "به دل دریا برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 62.38,
   "end": 64.84,
   "text": "برد، او برد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.84,
   "end": 69.1,
   "text": "من نرفتم. خودت آموختیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.1,
   "end": 74.42,
   "text": "مهر و خودت سوختیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.42,
   "end": 79.46,
   "text": "با برافروخته روئی که قرار از ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.46,
   "end": 85.32,
   "text": "که قرار از ما بود. می‌گه که هرچی بود--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.32,
   "end": 87.84,
   "text": "اصلاً کی قرار از ما بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.84,
   "end": 90.8,
   "text": "هرچی بود از تو بود. این یعنی توحید چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.8,
   "end": 93.3,
   "text": "افعالی. الان این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.3,
   "end": 100.74,
   "text": "شعر ظاهراً به زبان شعره اما یک دنیا معنا توش خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.74,
   "end": 105.34,
   "text": "همون آیه قرآن «ما شاء الله لا قوة إلا بالله» رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.34,
   "end": 113.08,
   "text": "یا دعاش در دستور العمل ادعیه «لا حول و لا قوة إلا بالله العلی العظیم» رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.08,
   "end": 119.5,
   "text": "شعر کرده الان. کی دیگه ما می‌خوایم به این‌ها برسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 119.5,
   "end": 122.44,
   "text": "بعد وزن‌کشی که صورت می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.44,
   "end": 124.9,
   "text": "ما می‌خوایم وقت موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.9,
   "end": 130.68,
   "text": "یا حارف همدان «من یمت» یعنی هرکس که بمیرد «یرنی»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.68,
   "end": 133.26,
   "text": "منو می‌بینه. کی فرموده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 133.26,
   "end": 136.9,
   "text": "حضرت بصی، امیرالمؤمنین، علی علیه الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.9,
   "end": 141.44,
   "text": "هرکی بمیره منو می‌بینه. بعد شما می‌خوای با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.44,
   "end": 148.9,
   "text": "همه توحید به یک باره یا به عبارتی با روح توحید به یک باره مواجه بشی، وقت مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 148.9,
   "end": 154.82,
   "text": "من تا حالا چندین وجه از این «فبصرک الیوم حدید» وقت موت رو گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 154.82,
   "end": 157.66,
   "text": "این هم یه وجهش. چرا چشم تیز می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 157.66,
   "end": 163.98,
   "text": "«فکشفنا عنک غطاءک» وقتی اون پرده رو ما ور می‌داریم وقت موت چرا چشم تیز می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 163.98,
   "end": 167.78,
   "text": "یه وجهش اینه. تو مواجه می‌شی با همه توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 167.78,
   "end": 171.38,
   "text": "یک دم، یه عمر دم زدیم از مولامون علی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 171.38,
   "end": 174.14,
   "text": "عشق و محبتش تو وجودمون بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 174.14,
   "end": 178.94,
   "text": "اما به تمامه درکش نکردیم که وقت موت من ضعیفِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 178.94,
   "end": 182.24,
   "text": "ناچیزِ بی‌چیزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.24,
   "end": 187.06,
   "text": "هیچ می‌خوام یه دفعه مواجه بشم با همه چی، با کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 187.06,
   "end": 188.74,
   "text": "آدم نباید سنگ کوب کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.74,
   "end": 193.4,
   "text": "یه معنای ص-- اون سکرات همینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 193.4,
   "end": 195.5,
   "text": "خب ما باید الان کار کنیم رو خودمون یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.5,
   "end": 200.88,
   "text": "تمرین کنیم یا نه؟ این شعر، همین خوندن این شعر و توجه بهش ما آدمو راه میندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.88,
   "end": 205.7,
   "text": "گفتن اون ذکر، اون ذکر ما شاء الله هفت مرتبه بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.7,
   "end": 210.76,
   "text": "دو رکعت نماز که عرض کردیم فرمایش‌های امام صادق سلام الله علیه، حضرت علامه حسن زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 210.76,
   "end": 213.6,
   "text": "آخه ما اینجا گفتیم که به یک باره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 213.6,
   "end": 215.54,
   "text": "اون اخلاق خبیثه فرو می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.54,
   "end": 220.28,
   "text": "یکی گفت مگه می‌شه؟ ولی سرش در اونه که علامه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.28,
   "end": 222.76,
   "text": "با توجه کامل اینو بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.76,
   "end": 225.54,
   "text": "اصلاً چی داری میگی؟ تو سجده چی داری میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.54,
   "end": 229.08,
   "text": "هفت بار چی میگی؟ ما شاء الله یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.08,
   "end": 230.84,
   "text": "یعنی هرچی خدا بخواد تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.84,
   "end": 234.08,
   "text": "اصلاً غیر از این نمی‌شه. هرچه خدا خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 234.08,
   "end": 236.84,
   "text": "همان می‌شود. هرچه خودم خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.84,
   "end": 242.22,
   "text": "نه آن می‌شود. شما وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.22,
   "end": 245.3,
   "text": "بحث نظامی‌گری و این‌ها که به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.3,
   "end": 250.36,
   "text": "خیلی هم حق هست و درست هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.36,
   "end": 253.88,
   "text": "این‌ها می‌شه من بسیجی امام خمینی‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 253.88,
   "end": 258.34,
   "text": "امام فرمود: «خدایا قیامت مرا با بسیجیانم محشور فرما.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.34,
   "end": 264.52,
   "text": "ببین من لباس بسیج تنمه. ببین پست من ف-- خب چرا تو اندیشه‌های امام غور نمی‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.52,
   "end": 268.9,
   "text": "چرا با نظرات ملا صدرای شیخ الرئیس و ابن عربی آشنا نمی‌شی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.9,
   "end": 275.98,
   "text": "که امام اندیشمندان شرق و غرب عالم رو دعوت کرد به همین کتاب‌ها و همین سفره‌ها و همین اشخاص و افراد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.98,
   "end": 279.62,
   "text": "ما به گوشمون نخوره؟ چه بسیجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.62,
   "end": 282.34,
   "text": "بعد تو همین زندگی روزمره‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 282.34,
   "end": 286.28,
   "text": "تجسم و تبلور توحید افعالی رو شما می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.28,
   "end": 290.36,
   "text": "داستان خونه‌دار شدن حضرت امام رو قطعاً شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 290.36,
   "end": 295.44,
   "text": "خیلی جالبه که تو یخچال غازی اونجا یه خونه‌ای داشت، مستاجر بود امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.44,
   "end": 299.8,
   "text": "یه خونه بزرگی هم بود اما مستاجر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 299.8,
   "end": 304.68,
   "text": "داستانش مختصر و مفید عرض کنم خدمتتون به این شکله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.68,
   "end": 307.6,
   "text": "صاحبخونه میاد الان بسیاری از ما مستاجریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.6,
   "end": 315.24,
   "text": "تا اسم صاحبخونه میاد تن و بدن امثال من که توحید افعالی خبری تو زندگیمون نیست به لرزه می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 315.24,
   "end": 319.14,
   "text": "اما صاحبخونه اومد بالا سر حضرت امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 319.14,
   "end": 324.22,
   "text": "اونم اون دوران قحطی و بی‌پولی و گرفتاری و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 324.22,
   "end": 329.26,
   "text": "اومد گفت آقا یه هفته بهت مهلت میدم یا خالی کن یا خونه رو بخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.26,
   "end": 332.54,
   "text": "حضرت امام به دست خالی مستاجر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 332.54,
   "end": 334.62,
   "text": "گفت حالا تا توکل بر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 334.62,
   "end": 337.8,
   "text": "گفتیم از آثار توحید افعالی چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 337.8,
   "end": 340.42,
   "text": "اعتماد کامل به خدا، توکل بر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 340.42,
   "end": 342.58,
   "text": "اینا مجسمه همینن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 342.58,
   "end": 345.72,
   "text": "ما پشت سرشون راه می‌افتیم. تا ببینیم چی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.72,
   "end": 350.76,
   "text": "توکل بر خدا. یه هفته گذشت خبری نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 350.76,
   "end": 355.3,
   "text": "الان شب جمعه رسیده امام یا باید قولنامه کنه یا خالی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 355.3,
   "end": 359.24,
   "text": "یه شبه. همون شب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 359.24,
   "end": 366.78,
   "text": "همون شب جمعه که رسید یه جماعتی اومدن به نمایندگی از کاروان‌هایی که داشتن می‌رفتن کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.78,
   "end": 371.87,
   "text": "اون موقع جمع می‌شدن همه با هم می‌رفتن خطرات بود چند ماه تو راه بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.87,
   "end": 375.93,
   "text": "همه دار و ندار و اموالشونو جمع کرده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.93,
   "end": 378.15,
   "text": "آوردن پیش امام امانت بذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 378.15,
   "end": 383.29,
   "text": "گفتن ما به دولت و بانک و اینا اعتماد نداریم پیش شما باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 383.29,
   "end": 389.49,
   "text": "ما بریم برگردیم. امام خیلی زرنگ زیرک، الامام الکایت فرمود من امانت نمی‌تونم بپذیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 389.49,
   "end": 393.13,
   "text": "اونا اصرار کردن، گفت آقا من نمی‌تونم امانت بپذیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.13,
   "end": 395.55,
   "text": "بعد انقدر اصرار کردن حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 395.55,
   "end": 398.05,
   "text": "حضرت امام فرمودن خب اگرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 398.05,
   "end": 402.81,
   "text": "قرض به من میدید و مهلت میدید اینو به شما برگردونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 402.81,
   "end": 406.81,
   "text": "باشه من حرفی ندارم. حالا که انقدر اصرار دارید اینو به من قرض بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 406.81,
   "end": 409.15,
   "text": "اونا هم قبول کردن قرض بدن به امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 409.15,
   "end": 415.75,
   "text": "همون شبی که قرار بود خونه رو قولنامه کنه، جالبه که نوشتن این پول تو زندگی حضرت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 415.75,
   "end": 419.09,
   "text": "هست که این پول عینا اندازه قیمت اون خونه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 419.09,
   "end": 422.53,
   "text": "همون شب صاحب خونه تشریف آوردن که ببینن چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 422.53,
   "end": 424.47,
   "text": "قولنامه و حالا خریدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 424.47,
   "end": 428.41,
   "text": "خونه رو از امام خریدن بدون هیچ دغدغه ای درس و بحثشون رو ادامه میدادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.41,
   "end": 430.73,
   "text": "اون شب در حین درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.73,
   "end": 433.73,
   "text": "خونه رو خریدن. حالا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.73,
   "end": 436.17,
   "text": "می‌زنیم به بغل دستیمون. وا این چی میگه حاجی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.17,
   "end": 439.29,
   "text": "افسانه میگه چی؟ خلاصه هیچی تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.29,
   "end": 446.47,
   "text": "یه هفته بعد دوباره اون سرکرده‌های کاروان‌ها اومدن گفت حضرت امام فرمود شما قرار بود چند ماه بعد بیاید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 446.47,
   "end": 449.31,
   "text": "یه هفته‌ای برگشتید. گفتن تو مرز مشکلاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 449.31,
   "end": 451.79,
   "text": "پیش اومد ما برگشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 451.79,
   "end": 455.53,
   "text": "لطفا بفرمایین قرض ما رو بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 455.53,
   "end": 458.31,
   "text": ". حضرت امام علیه رحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 458.31,
   "end": 460.47,
   "text": "چیکار باید می‌کردن؟ ما باشیم چی کار می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.47,
   "end": 465.73,
   "text": "سنکوپ می‌کنیم. به ه-همه کس رو می‌اندازیم جز خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 465.73,
   "end": 470.49,
   "text": "حضرت امام فرمودن که خب شما اینو به من قرض دادید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.49,
   "end": 473.55,
   "text": "باید یه مهلتی بدید که اینو به شما برگردونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 473.55,
   "end": 475.93,
   "text": "گفتن یه هفته به شما مهلت میدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.93,
   "end": 481.33,
   "text": "یه هفته. خلاصه حضرت امام بازم فرمود توکل به خدا تا ببینیم چی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 481.33,
   "end": 484.83,
   "text": "رفت تو درس و بحث. پسرش می‌فرمود که همینطوری درسشو ادامه داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 484.83,
   "end": 489.39,
   "text": "اصلاً انگار نه انگار باید یه هفته بعد یه همچین پولی رو برگردونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.39,
   "end": 493.43,
   "text": "به هیچ کس هم رو نزد. پسرش قاسم احمدی فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.43,
   "end": 495.81,
   "text": "روز پنج شنبه صبح یهو برادر ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 495.81,
   "end": 499.39,
   "text": "روحش شاد، فضلت الله پسندیده اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 499.39,
   "end": 504.35,
   "text": "دید هی-- امام دید این چرا هی داره عذرخواهی می‌کنه ببخشید و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.35,
   "end": 506.11,
   "text": "چی شده؟ چرا من باید تو رو ببخشم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 506.11,
   "end": 509.77,
   "text": "گفت من بدون اجازه شما یکی از املاک پدریمونو فروختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.77,
   "end": 513.65,
   "text": "اینم سهم الارث شما. دقیقا همون اندازه پولی بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 513.65,
   "end": 517.45,
   "text": "اینا امانت گذاشته بودن و ایشون خونه رو خریده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 517.45,
   "end": 522.43,
   "text": "باشه. و همون روزم عصری اونا اومدن پولو تقدیم کرد بهشون رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 522.43,
   "end": 530.75,
   "text": "پسر ایشون جالب اینه میگه چه قبل از اون، چه وسطش، چه بعدش هیچ تغییر حالتی در امام دیده نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.75,
   "end": 533.15,
   "text": "ما باشیم بر افروخته میشیم، می‌ریزیم به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 533.15,
   "end": 535.99,
   "text": "حاجی آقا یه ذکر بگو. آی رفیقم پول داری قرض بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 535.99,
   "end": 539.35,
   "text": "وای بیچاره شدم. این چیه به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 539.35,
   "end": 544.47,
   "text": "توحید افعالی. واقعا اگر کسی قرآنی زندگی کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 544.47,
   "end": 550.39,
   "text": "اینا افسانه نیست. بغل دست ما بودن و هستن و دارن دیده میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 550.39,
   "end": 554.23,
   "text": "اگر کسی قرآنی زندگی کنه هیچ مشکلی براش پیش نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 554.23,
   "end": 557.75,
   "text": "\"و من یتق الله\" این قاعده قرآنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 557.75,
   "end": 560.61,
   "text": "ما آخوندا که از تو آستینمون در نیاوردیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 560.61,
   "end": 563.57,
   "text": "\"و من یتق الله يجعل له مخرجا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.57,
   "end": 568.17,
   "text": "هرکس تقوای الهی پیش کنه خدا براش یه محل خروجی قرار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 568.17,
   "end": 575.45,
   "text": "یعنی تو بن بست نمی‌مونه. مثل حضرت یوسف به سمت درهای بسته فرار کرد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 575.45,
   "end": 579.91,
   "text": "اما درها براش باز شد. \"و لیرزق من حيث لا يحتسب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 579.91,
   "end": 582.81,
   "text": "از جایی که اصلاً گمان نمی‌کنه براش رزق می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 582.81,
   "end": 585.73,
   "text": "\"و من یتوکل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 585.73,
   "end": 588.21,
   "text": "جالبه \"و من یتوکل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 588.21,
   "end": 590.59,
   "text": "خروجی توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 590.59,
   "end": 592.33,
   "text": "\"و من یتوکل على الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 592.33,
   "end": 595.43,
   "text": "هرکس اعتماد کامل به خدا کنه \"فهو حسب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 595.43,
   "end": 600.73,
   "text": "خدا بسشه. \"ان الله بالغ امره قد جعل الله لكل شيء قدرا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 600.73,
   "end": 604.75,
   "text": "همه تقدیرات، مقدرات، قضا، قدر همه دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 604.75,
   "end": 609.77,
   "text": "ای کاش این چیزی که من دارم، دارم طوطیای زبونم همینطوری دارم میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 609.77,
   "end": 613.19,
   "text": "اینو باور کنم و بچشم و بهش برسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 613.19,
   "end": 617.03,
   "text": "ببینمش تو زندگی خودم صرفا علم فکری نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 617.03,
   "end": 618.85,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 618.85,
   "end": 621.79,
   "text": "صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 621.79,
   "end": 624.67,
   "text": "اللهم صل على محمد و آله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}