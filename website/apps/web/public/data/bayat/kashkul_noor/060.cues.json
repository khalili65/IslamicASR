   "start": 291.62,
   "end": 392.27
  },
  {
   "index": 4,
   "title": "## آیهٔ شانزدهمِ رعد؛ قُل‌های پیاپی",
   "start": 392.27,
   "end": 649.15
  },
  {
   "index": 5,
   "title": "## نخِ تسبیح؛ ولایتِ اهل‌بیت",
   "start": 649.15,
   "end": 812.03
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.36,
   "end": 8.52,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.52,
   "end": 11.54,
   "text": "و به این استعین. السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.54,
   "end": 14.78,
   "text": "یا داعی الله و ربانی یا آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.78,
   "end": 18.66,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.66,
   "end": 24.62,
   "text": "دیروز عرض کردیم که ما فرصتمون هجده سال بیشتر نیست در دوره دنیا مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.62,
   "end": 27.26,
   "text": "برای خودسازی. حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.26,
   "end": 29.6,
   "text": "خودسازی کی موفق بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.6,
   "end": 35.1,
   "text": "که خودش رو به اونجا برسونه. وقتی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.1,
   "end": 42.46,
   "text": "از این دنیا میریم چه در این هجده سالی که بنا به فرمایش امام صادق صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.46,
   "end": 51.34,
   "text": "مهلت داریم خودمون رو ساخته باشیم، چه نه ساخته باشیم وقتی میریم چی ماحصل اون چیزی که برای ما میمونه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.34,
   "end": 53.32,
   "text": "چیه ب-- یعنی چیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.32,
   "end": 59.76,
   "text": "بالاترین ارزش رو داره و اصلاً او رو نگاه می‌کنن، اول به اون نگاه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.76,
   "end": 64.64,
   "text": "اگر ملائکه میان در قبر ما رو بو می‌کنند، چی رو بو می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.64,
   "end": 67.34,
   "text": "این اصطلاحی که اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.34,
   "end": 71.06,
   "text": "فرمودن دیگه بالاتر از توحید ما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.06,
   "end": 74.5,
   "text": "هرکی هر مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.5,
   "end": 76.6,
   "text": "وارد توحید شده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.6,
   "end": 79.12,
   "text": "و غرق در توحید شده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.12,
   "end": 81.62,
   "text": "و بوی توحید بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.62,
   "end": 85.04,
   "text": "درجه‌ش همونقدره. حالا این توحید چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.04,
   "end": 89.68,
   "text": "بالاخره چکار باید کرد تا توحید رو درک کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.68,
   "end": 93.96,
   "text": "به یک معنا توحید روحش میشه ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.96,
   "end": 97.14,
   "text": "روح توحید ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.14,
   "end": 99.38,
   "text": "مثل اینکه شخص حضرت علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.38,
   "end": 104.66,
   "text": "یک وجود واحدی، یک بدن داری انزل مراتب وجودی خودته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.66,
   "end": 109.56,
   "text": "یک روح داری که اعلی مرتبه وجودی توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.56,
   "end": 112.96,
   "text": "یک طوری از اطوار وجودی توئه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.96,
   "end": 115.84,
   "text": "اون روح. این هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.84,
   "end": 119.56,
   "text": "به این شکله که اون اعلی مرتبه توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.56,
   "end": 126.58,
   "text": "میشه ولایت که ما دیروز عرض کردیم هر کاری می‌کنی به خاطر آقا انجام بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.58,
   "end": 133.28,
   "text": "به‌خاطر اینکه او حقیقتش ولایت امام عصر حقیقتش میشه روح توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.28,
   "end": 136.58,
   "text": "حالا خود توحید چیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.58,
   "end": 140.46,
   "text": "حقیقتش میشه ولایت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.46,
   "end": 143.96,
   "text": "حقیقتش میشه ولایت کلیه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.96,
   "end": 150.3,
   "text": "خود توحید چیه؟ خدا رحمت کنه حضرت استاد رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.3,
   "end": 153.46,
   "text": "ایشون در لقاء الله‌شون یادمه صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.46,
   "end": 159.94,
   "text": "پنجاه باید باشه. نوشتن که من خواب استادم حضرت آی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.94,
   "end": 164.58,
   "text": "حضرت آیت الله شیخ محمد تقی آملی رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.58,
   "end": 168.08,
   "text": "تو خواب ایشون با اینکه زنده بود ایشون اون ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.08,
   "end": 173.16,
   "text": "تو خواب ایشون به من فرموده یه رساله ای در سیر و سلوک به من دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.16,
   "end": 178.08,
   "text": "و فرمودن که .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.08,
   "end": 184.14,
   "text": "توحید حقیقتش اینه که تو هر چیزی رو جز الله تنسى فراموش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.14,
   "end": 188.22,
   "text": "هرچی میبینی حضرت حق دادین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.22,
   "end": 190.74,
   "text": "البته این در حرف آسونه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.74,
   "end": 192.58,
   "text": "مثلاً مسیحیه اومد روایت ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.58,
   "end": 195.56,
   "text": "اومد پیش امام صادق صلی الله علیه گفت آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.56,
   "end": 199.18,
   "text": "خدای شما رو چه جوری میشه، چه جوری میشه بشناسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.18,
   "end": 201.78,
   "text": "اگه دم از خدا می‌زنید شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.78,
   "end": 205.32,
   "text": "چه جوری بشناسیمش؟ حضرت فرمودن از نشانه هاش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.32,
   "end": 211.12,
   "text": "از آیاتش، از این خورشید و ماه، از این شب و روز همه دلالت بر او دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.12,
   "end": 213.0,
   "text": "اینا همه آیات و نشانه های او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.0,
   "end": 216.18,
   "text": "اینا همه ظهور اسم و صفات او هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.18,
   "end": 222.4,
   "text": "خب این گفتنش آسونه اما اینکه توجه بهش بکنی خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.4,
   "end": 225.66,
   "text": "بعد علامه میگه از خواب که بیدار شدم رفتم محضر استادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.66,
   "end": 229.38,
   "text": "ایشون در قید حیات بودن. گفتم استاد من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.38,
   "end": 232.4,
   "text": "چنین خوابی از شما دیدم. یه رس-رساله در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.4,
   "end": 234.86,
   "text": "سیر و سلوک به من دادید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.86,
   "end": 238.74,
   "text": "فرمودید که .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.74,
   "end": 241.4,
   "text": "بعد ایشون تو خواب-- توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.4,
   "end": 245.2,
   "text": "بیداری اشاره می‌کنند به این بیت شعر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.2,
   "end": 249.24,
   "text": "مرحوم شبستری در گلشن رازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.24,
   "end": 251.5,
   "text": "استاد علامه حسن زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.5,
   "end": 256.2,
   "text": "بهشون میگن که نشانی دادندت از خرابات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.2,
   "end": 265.74,
   "text": "که . توحید اسقاط اضافاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.74,
   "end": 269.3,
   "text": "هر چیزی به جز خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.3,
   "end": 275.68,
   "text": "و هر چیزی به جز اون عمل، فکر، اندیشه، تکلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.68,
   "end": 278.0,
   "text": "اصلاً نفس به nefsi که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.0,
   "end": 281.78,
   "text": "تعلق به خدا نداره اضافه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.78,
   "end": 285.72,
   "text": "باید هر چیزی تعلق به حضرت حق پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.72,
   "end": 288.18,
   "text": "خودت رو باید تعلق بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.18,
   "end": 290.74,
   "text": "چگونه است که الان بدن تو حیات داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.74,
   "end": 294.1,
   "text": "میشه بفرمایید علت حیات بدن شما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.1,
   "end": 296.18,
   "text": "میت فرقش با ما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.18,
   "end": 299.5,
   "text": "اون بدنش حیات نداره، مال ما داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.5,
   "end": 301.98,
   "text": "چرا؟ چون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.98,
   "end": 304.84,
   "text": "چون نفس ناطقه اون میت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.84,
   "end": 308.88,
   "text": "اعلام انصراف کرده، توجهش رو از این بدن برداشته، تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.88,
   "end": 314.44,
   "text": "اون که نمرده، زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.44,
   "end": 316.46,
   "text": "از این دار رفته به یه دار دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.46,
   "end": 319.08,
   "text": "توجهش رو از این بدن برداشت، بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.08,
   "end": 325.26,
   "text": "منصرف شد. اما هنوز نفس ناطقه شما توجه به این بدن داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.26,
   "end": 329.66,
   "text": "بدن برقراره. وقتی می‌خوابی توجهش رو نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.66,
   "end": 333.56,
   "text": "از این بدن برمی‌داره، می‌ندازه نه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.56,
   "end": 336.88,
   "text": "تمامه، برای همین هنوز زنده ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 336.88,
   "end": 343.76,
   "text": "اکثر توجهش رو برمی‌داره به بدن برزخی‌ت می‌ندازه که با عملت مشخصش عمله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.76,
   "end": 348.36,
   "text": "عملت مشخصش کرده، شکل بهش داده، شخصیت بهش داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.36,
   "end": 355.46,
   "text": "با اون حرکت می‌کنی در عالم مثال متصل خودت که برزخ وجودیت و قوه خیالت و در خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.46,
   "end": 360.9,
   "text": "میری اونجا. اگه کسی نفسش قوی باشه از اون مثال متصل که تو خودشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.9,
   "end": 365.54,
   "text": "پل می‌زنه میره به مثال مطلق که بیرون از خودشه، منفصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.54,
   "end": 367.76,
   "text": "اون عالم برزخه، ارواح اونجان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.76,
   "end": 373.67,
   "text": "اِ ارواح رو می‌بینن شهدا رو می‌بینن، اهل بیت رو حتی می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.67,
   "end": 376.91,
   "text": "چرا؟ این توجه نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.91,
   "end": 383.11,
   "text": "قدرت نفسه. حالا اگر چ-- چنانچه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.11,
   "end": 387.03,
   "text": "تمام توجهش به حضرت حق باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 387.03,
   "end": 389.53,
   "text": "این حیات داره. چنین کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.53,
   "end": 392.27,
   "text": "همه چیش بوی توحید می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.27,
   "end": 395.85,
   "text": "یکی از آیاتی که به زیبایی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.85,
   "end": 399.55,
   "text": "بحث توحید رو خصوصا توحید اخلاقی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.55,
   "end": 406.53,
   "text": "مطرح کرده، چون من حقیقتش خواستم که دیگه دست بکشم از این مبحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 406.53,
   "end": 410.69,
   "text": "به جهت یکی دو تا دوستان که گفتن بسه دیگه چقدر، چقدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.69,
   "end": 415.13,
   "text": "بعد برعکس بعضی از دوستان اومدن گفتن مثلا برای همین داریم میایم نماز بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 415.13,
   "end": 416.89,
   "text": "ولی نمیایم اینجا. به خاطر همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.89,
   "end": 419.93,
   "text": "چون این گم شده ما اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.93,
   "end": 422.21,
   "text": "به هر حال ما رو تشویق کردن که بحث رو ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.21,
   "end": 424.47,
   "text": "یکی از آیات، آیه شونزده سوره رعده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 424.47,
   "end": 429.49,
   "text": "ببینید متن آیه قرآن دارم براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.49,
   "end": 432.25,
   "text": "«قل من رب السماوات والأرض».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.25,
   "end": 438.51,
   "text": "پیغمبر بگو کیه پروردگار آسمان‌ها و زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 438.51,
   "end": 443.61,
   "text": "خیلی جالبه در تفسیر نور آقای قرائتی نز-نظرش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.61,
   "end": 446.17,
   "text": "چرا به پیغمبر میگه بگو به این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 446.17,
   "end": 450.67,
   "text": "بعد دوباره میگه قل دوباره خود جواب سؤال خودتو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.67,
   "end": 454.15,
   "text": "قل الله بگو الله رب السماوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.15,
   "end": 459.49,
   "text": "چرا؟ چون که اینا اصلا حرف گوش به شنوا، گوش شنوا ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.49,
   "end": 461.95,
   "text": "اصلا حا-حاضر نیستن حرفای تو رو بشنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.95,
   "end": 465.21,
   "text": "حرف حق رو نمی‌پذیرن. خودت جوابشونو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 465.21,
   "end": 470.03,
   "text": "بگو قل الله. یه معنای دیگه‌ش می‌تونه این باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.03,
   "end": 472.43,
   "text": "انقدر مبرهن و واضحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.43,
   "end": 474.45,
   "text": "از هر منش شمسه قل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 474.45,
   "end": 476.35,
   "text": "بگو اصلا دیگه تردید نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 476.35,
   "end": 481.97,
   "text": "قل الله. بگو الله. دوباره می‌فرماید چند تا قل تو این آیه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.97,
   "end": 484.67,
   "text": "خیلی جالبن. دوباره می‌فرماید قل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.67,
   "end": 489.93,
   "text": "أفتخذتم من دونه أولياء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.93,
   "end": 495.57,
   "text": "لا یملکون أنفسهم نفعا ولا ضرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.57,
   "end": 502.33,
   "text": "می‌فرماید آیا شما کسایی رو اولیا، ولی خودتون، سرپرست خودتون اختیار می‌کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.33,
   "end": 506.77,
   "text": "نه در نفع‌تون و نه، و نه در ضرر‌تون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 506.77,
   "end": 509.51,
   "text": "لا یملکون لأنفسهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 509.51,
   "end": 515.79,
   "text": "به این‌ها بگو که آیا کسی رو ولی گرفتید که هیچ تملکی در نفع و ضرر شما نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 515.79,
   "end": 518.43,
   "text": "آخه انقدر احمق شدید شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 518.43,
   "end": 521.19,
   "text": "کسایی دنبال سر کسایی راه افتادید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.19,
   "end": 524.51,
   "text": "هیچ نفع و ضرری با شما ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 524.51,
   "end": 528.39,
   "text": "قل، این قل چندمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 528.39,
   "end": 530.35,
   "text": "احسنت آقای بهلتی حواسش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 530.35,
   "end": 533.59,
   "text": "چهارمین قل. تو یه آله ببین چند تا قل داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 533.59,
   "end": 536.99,
   "text": "قل هل يستوي الأعمی والبصير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 536.99,
   "end": 540.79,
   "text": "بهشون بگو آیا کور و بینا با هم یکی‌ند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 540.79,
   "end": 546.27,
   "text": "اینجا آقای قرائتی می‌فرماید انقدر این‌ها بیچاره‌اند که مبرهنات رو هم دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.27,
   "end": 549.71,
   "text": "نمی‌پذیرند. این رو هم انگار حالیشون نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 549.71,
   "end": 551.61,
   "text": "کور و بینا با هم متفاوت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 551.61,
   "end": 554.95,
   "text": "ام هل تستوي الظلمات والنور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 554.95,
   "end": 558.43,
   "text": "آیا ظلمت‌ها و نور با هم مساوی‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 558.43,
   "end": 560.61,
   "text": "آخه یه ذره چشم‌تون رو باز کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 560.61,
   "end": 565.41,
   "text": "چرا دنبال سرصرا و ظلمت راه افتادید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.41,
   "end": 568.47,
   "text": "و جالبه این یکی از شیوه‌های تربیتی‌یه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 568.47,
   "end": 572.79,
   "text": "مربی خوب و حاذق اول با سؤال، کارش رو با سؤال آغاز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 572.79,
   "end": 581.03,
   "text": "خدا داره این کارو انجام می‌ده. ام جعلوا لله شرکاء خلقه كخلقه فتشابه الخلق عليهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 581.03,
   "end": 584.17,
   "text": "آیا به جای خدا شرکایی رو گرفتن که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 584.17,
   "end": 589.65,
   "text": "در خلقت‌شون به شبهه بیفتن که این خلق خداست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 589.65,
   "end": 592.77,
   "text": "الله یا خلق اون خدای ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.77,
   "end": 596.31,
   "text": "آخه چند تا خدا هست که این‌ها بهش شک افتادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 596.31,
   "end": 602.87,
   "text": "دوباره یه قل دیگه. این قل آخره بهتون قول میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 602.87,
   "end": 605.57,
   "text": "آقای بهلتی چندمین قل شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 605.57,
   "end": 608.45,
   "text": "پنجاه و 五 تا قل تو یه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 608.45,
   "end": 612.53,
   "text": "قل الله خالق کل شيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.53,
   "end": 616.07,
   "text": "قل الله خالق کل شيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 616.07,
   "end": 619.71,
   "text": "به این‌ها بگو الله خالق همه‌ی اشیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 619.71,
   "end": 622.37,
   "text": "کدوم الله؟ وهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 622.37,
   "end": 624.63,
   "text": "الواحد القهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 624.63,
   "end": 626.99,
   "text": "الله اکبر. از این تعبیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 626.99,
   "end": 631.65,
   "text": "عرض کردیم این واحد با قهاریت وقتی با هم جمع می‌شه بوی چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 631.65,
   "end": 637.35,
   "text": "وحدت محضه. بوی احدیت داره که مافوق واحدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 637.35,
   "end": 641.71,
   "text": "احدیت دیگه عالی‌ترین مراتب وحدت محضه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 641.71,
   "end": 644.23,
   "text": "واحدیت که نشان‌ه‌ی کثرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 644.23,
   "end": 646.85,
   "text": "مادونه، مادون احدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 646.85,
   "end": 650.85,
   "text": "روح ما از احدیت، قلب ما از واحدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 650.85,
   "end": 653.33,
   "text": "ما از اونجا باید خبر داشته باشیم یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 653.33,
   "end": 657.89,
   "text": "در حالی که هم جنس‌مون رو در خودمون داریم، هم رتبه‌مون رو در خودمون داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 657.89,
   "end": 661.51,
   "text": "عجب خلقی کرده انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 661.51,
   "end": 666.87,
   "text": "عجب صحبتی کردی. جای آقا سعید خالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 666.87,
   "end": 668.75,
   "text": "خب تا همین موقع برنامه رو بسنده می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 668.75,
   "end": 672.95,
   "text": "پس ختم کلام اون چیزی که ما با خودمون می‌بریم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 672.95,
   "end": 676.05,
   "text": "توحید. نخ تسبیح، نخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 676.05,
   "end": 680.47,
   "text": "این شیرازه‌ش یا نخ این اسکناس چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 680.47,
   "end": 684.77,
   "text": "ولایت اهل بیت. برای همین میگم دائم به فکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 684.77,
   "end": 687.65,
   "text": "یه عزیزی هم ازم یه سؤال قشنگ می‌پرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 687.65,
   "end": 692.35,
   "text": "گفته آقا شما دیروز گفتید دائم یاد آقا حتی کارهاتون رو به یاد آقا بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 692.35,
   "end": 695.19,
   "text": "دائم یاد آقا. چگونه می‌شه اینطور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 695.19,
   "end": 697.27,
   "text": "گفتم یه رمزی رو بهشون عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 697.27,
   "end": 699.81,
   "text": "گفتم استاد ما یاد داد خدا حفظش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 699.81,
   "end": 703.03,
   "text": "هنوز در قید حیاته. خیلی مدیونش هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 703.03,
   "end": 711.77,
   "text": "فرمودن که امام عصر رو در هر مقامی سلام بدی تو همون مقام حضرت بهت توجه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 711.77,
   "end": 716.19,
   "text": "الان ما خواستیم نماز بخونیم. گفتیم السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 716.19,
   "end": 718.81,
   "text": "حین تسلی و تغمس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 718.81,
   "end": 723.39,
   "text": "چون می‌خوایم نماز بخونیم. حالا حضرت در مقام نماز به تو توجه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 723.39,
   "end": 727.15,
   "text": "مطلق شئوناتت رو در نظر بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 727.15,
   "end": 729.37,
   "text": "داری از خونه میای سمت اداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 729.37,
   "end": 731.89,
   "text": "بگو همین‌طور به همین راحتی. اصلاً عربی هم نمی‌خواد بدونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 731.89,
   "end": 735.73,
   "text": "او سلام آقا به شما وقتی از منزلت میای بیرون دنبال کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 735.73,
   "end": 738.57,
   "text": "بالاخره آقا که بیکار نیست. آقا هم دنبال کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 738.57,
   "end": 740.63,
   "text": "باور کنید دیشب من داشتم اینجا صحبت می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 740.63,
   "end": 743.39,
   "text": "آشغال خونه‌مون رو می‌بردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 743.39,
   "end": 750.49,
   "text": "بذارم سر کوچه. گفتم سلام به شما وقتی خیمتون رو رفت و رو می‌کنید و آشغال‌ها رو می‌برید بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 750.49,
   "end": 755.21,
   "text": "میرم خرید می‌کنم. میگم سلام آقا به شما وقتی میری خرید می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 755.21,
   "end": 757.83,
   "text": "آقا سلام به شما وقتی می‌خوای بخوابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 757.83,
   "end": 759.97,
   "text": "سلام به شما وقتی از خواب بیدار میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 759.97,
   "end": 762.77,
   "text": "سلام به شما وقتی... مطلق شئونات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 762.77,
   "end": 765.57,
   "text": "بعد ببین زندگیت چجوری بوی توحید می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 765.57,
   "end": 771.13,
   "text": "امتحان کن. ببین بوی توحید رو استشمام می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 771.13,
   "end": 775.03,
   "text": "بله. بله، اون که دیگه همشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 775.03,
   "end": 777.91,
   "text": "احسنت به شما. السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 777.91,
   "end": 780.63,
   "text": "بجواب السلام. این دیگه همشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 780.63,
   "end": 783.97,
   "text": "یعنی همه جمع، جمع، جمع دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 783.97,
   "end": 787.49,
   "text": "البته اون جواب السلام حکایت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 787.49,
   "end": 790.43,
   "text": "مال حضرت زهراست. اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 790.43,
   "end": 793.45,
   "text": "حکایت داره. قصه تو کوچه است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 793.45,
   "end": 796.29,
   "text": "قصه‌ش خیلی الان دردناکه بخوایم بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 796.29,
   "end": 798.39,
   "text": "ولی در هر حال بله حرف شما درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 798.39,
   "end": 802.67,
   "text": "تمام سلام‌ها توشه. مطلق همه شئونات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 802.67,
   "end": 806.01,
   "text": "اللهم باریک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 806.01,
   "end": 808.07,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 808.07,
   "end": 812.03,
   "text": "صلوات الله. الله صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}