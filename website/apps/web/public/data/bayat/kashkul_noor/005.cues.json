 "chapters": [
  {
   "index": 0,
   "title": "## مقام محمود در روایت امام هادی",
   "start": 0.46,
   "end": 122.92
  },
  {
   "index": 1,
   "title": "### محور حب و بغض",
   "start": 122.92,
   "end": 143.02
  },
  {
   "index": 2,
   "title": "### فاقول الجنّة",
   "start": 143.02,
   "end": 234.14
  },
  {
   "index": 3,
   "title": "### این همان مقام محمود است",
   "start": 234.14,
   "end": 333.78
  },
  {
   "index": 4,
   "title": "### بیم از برزخ",
   "start": 333.78,
   "end": 423.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 4.32,
   "text": "بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.32,
   "end": 8.48,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.48,
   "end": 15.54,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.54,
   "end": 22.48,
   "text": "ذیل آیه شریفه ای که بحث می‌کردیم \"و من الليل فتهجد به نافلة لك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.48,
   "end": 28.74,
   "text": "نافلة الليل عسی ان يبعثك ربك مقام محمودا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.74,
   "end": 33.46,
   "text": "چه مشخاطر شریفتون باشه در آیه هفت-- آیه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.46,
   "end": 37.7,
   "text": "آره آیه هفتاد و نه سوره اسرا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.7,
   "end": 45.02,
   "text": "ذیل این آیه یک روایت دیگه از همین کتاب شریفی که جلسه پیش هم از همین روایت عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.02,
   "end": 48.92,
   "text": "تأویل الآيات الظاهرة في فضائل العترة الطاهرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.92,
   "end": 53.12,
   "text": "خیلی کتاب عالیه. یه روایتی هست که خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.12,
   "end": 58.26,
   "text": "امام هادی صلوات الله علیه به نقل از جدشون امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.26,
   "end": 61.04,
   "text": "این روایت رو می‌فرمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.04,
   "end": 68.48,
   "text": "که مولامون حضرت وسی امیرالمؤمنین علی علیه الصلاة والسلام از پیامبر نقل کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.48,
   "end": 71.9,
   "text": "پس قال امام هادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.9,
   "end": 78.0,
   "text": "قال امیرالمؤمنین سمعت النبي که شنیدم از پیغمبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 78.0,
   "end": 81.02,
   "text": "يقول پیغمبر فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.02,
   "end": 89.5,
   "text": "اذا حشر الناس يوم القيامة وقتی مردم محشور میشن، جمع میشن تو روز قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 89.5,
   "end": 92.3,
   "text": "نادى مناداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 92.3,
   "end": 95.9,
   "text": "یه منادی صدا می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 95.9,
   "end": 100.48,
   "text": "یا رسول الله خطاب پیامبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.48,
   "end": 103.86,
   "text": "ان الله جل اسمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.86,
   "end": 109.14,
   "text": "اللهی که اسمش با عظمت و شریفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.14,
   "end": 112.44,
   "text": "قد امکنك به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.44,
   "end": 117.6,
   "text": "قد امکنك من مجازات محبیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 117.6,
   "end": 122.82,
   "text": "و محبی اهل بیتك الموالین لهم فيك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.82,
   "end": 126.18,
   "text": "و المعادین لهم فيك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.18,
   "end": 128.5,
   "text": "خیلی عالیه. پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.5,
   "end": 132.82,
   "text": "میگه که خدا اونجا ندا می‌زنه مستقیم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.82,
   "end": 136.9,
   "text": "پیغمبر عز عالم صحبت می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.9,
   "end": 143.02,
   "text": "امکنك اصلاً این امکان به تو داده می‌شه یا رسول الله امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 143.02,
   "end": 146.34,
   "text": "که جزای محبین خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.34,
   "end": 150.08,
   "text": "و محبین اهل بیتت که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 150.08,
   "end": 152.9,
   "text": "الموالین لهم فيك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.9,
   "end": 157.12,
   "text": "به عشق تو عاشق اونا شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.12,
   "end": 159.56,
   "text": "و المعادین لهم اینم خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.56,
   "end": 161.9,
   "text": "معادین لهم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.9,
   "end": 164.08,
   "text": "با اونا دشمنی می‌کنن. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.08,
   "end": 168.22,
   "text": "محور حب و بغضشون اهل بیت توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.22,
   "end": 171.94,
   "text": "یعنی اگر کسی دشمن اهل بیت تو بود تو اصلاً با اونا کاری نداشته باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.94,
   "end": 177.58,
   "text": "اونا هم بغض شدید نسبت بهش دارن و اصلاً خط قرمزشون اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.58,
   "end": 179.6,
   "text": "یعنی حب و بغض رو با هم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.6,
   "end": 182.48,
   "text": "اینطور نیست که بگه آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.48,
   "end": 187.88,
   "text": "اه استغفرالله مثلاً نماز، نماز علیه و سفره سفره معاویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.88,
   "end": 191.44,
   "text": "امروز خیلیا اینطورین. نه اینط--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.44,
   "end": 195.6,
   "text": "اینا رو شما جزاشونو بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.6,
   "end": 201.06,
   "text": "بعد می‌فرماید که ادامه میده اون منادی از طرف حضرت حق که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.06,
   "end": 203.86,
   "text": "فکافه بماشط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.86,
   "end": 207.6,
   "text": "هر کاری دوست داری تو کفایتشون دست توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.6,
   "end": 211.0,
   "text": "اصلاً تو کفیل اینهایی که امّت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.0,
   "end": 216.62,
   "text": "تو کافیی براشون. هر کاری کما شئت، هر کاری دوست داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.62,
   "end": 222.5,
   "text": "اصلاً هرچی تو بگی. خدا به پیغمبر بگه هر کاری دوست داری بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.5,
   "end": 226.94,
   "text": "الله اکبر. فاقول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.94,
   "end": 229.1,
   "text": "پیغمبر قربونش بریم دورش بگردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.1,
   "end": 235.88,
   "text": "می‌فرماید من میگم اون لحظه پس من میگم حالا که خدا فاقول این فا، فای پسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.88,
   "end": 239.72,
   "text": "حالا پس دیگه من میگم فاقول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.72,
   "end": 243.34,
   "text": "چی میگی یا رسول الله؟ الجنة تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.34,
   "end": 247.48,
   "text": "الجنة. الف لام هم سرش یعنی همه بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.48,
   "end": 251.4,
   "text": "حواستون باشه این نه اینه که حالا یه قطعه‌ای از بهشت، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.4,
   "end": 253.66,
   "text": "الجنة یعنی همه بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 253.66,
   "end": 259.46,
   "text": "همه بهشتو خدا بزن به نام محبین من و بچه‌هام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.46,
   "end": 263.7,
   "text": "فأنادی. حالا خدا چی جواب بده خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.7,
   "end": 269.38,
   "text": "فأنادی نـ-- منادی ندا می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.38,
   "end": 274.92,
   "text": "یعنی جواب منو میده اونجا. باوعهم منها حيث شئت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.92,
   "end": 278.8,
   "text": "اصلاً هر کجا عشقته اینا رو جا بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 278.8,
   "end": 281.7,
   "text": "هر کجا دوست داری جاشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 281.7,
   "end": 284.46,
   "text": "ریش و قیچی امروز دست توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.46,
   "end": 287.26,
   "text": "حالا بعد اینجا اینو کی داره می‌فرما-- درس کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.26,
   "end": 292.42,
   "text": "امام هادی صلوات الله علیه به نقل از امیرالمؤمنین از پیغمبر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 292.42,
   "end": 297.2,
   "text": "فذلك المقام المحمود الذي وعدته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.2,
   "end": 302.24,
   "text": "این اون مقام محمودیه که پیغمبر بهش وعد داده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.24,
   "end": 306.2,
   "text": "عسی. چی بود؟ عسی ان يبعثك ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 306.2,
   "end": 309.7,
   "text": "مقاماً محموداً. این مقام محموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 309.7,
   "end": 314.26,
   "text": "که ریش و قیچی دست پیغمبر میشه هر کجا عشقته اینا رو جا بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.26,
   "end": 318.48,
   "text": "والا شرط و بی شرط. اصلاً هرچی تو دوست داری دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.48,
   "end": 321.16,
   "text": "خیلی آقا- بالا پایین نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.16,
   "end": 325.54,
   "text": "ببینین تو رو God مقام محمود چه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.54,
   "end": 327.62,
   "text": "بعد اه به پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 327.62,
   "end": 330.0,
   "text": "میگه از چی به این مقام می‌رسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.0,
   "end": 334.98,
   "text": "نافله شب. حالا این از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.98,
   "end": 337.32,
   "text": "قصه بهشت و حالا اون دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.32,
   "end": 339.7,
   "text": "بحث روز محشر و قیامت و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.7,
   "end": 343.68,
   "text": "ترس من و شما باید از برزخمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 343.68,
   "end": 347.36,
   "text": "اینو حواسمون باشه. چون امام صادق صلوات الله علیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 347.36,
   "end": 353.38,
   "text": "به ظن این روایت زیاد داریم که آقا اونجا ما دست محبین رو می‌گیریم اصلاً نمی‌ذاریم آتشو ببینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.38,
   "end": 356.18,
   "text": "از پونصد سال قیامتi مونده به آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.18,
   "end": 358.6,
   "text": "اصلاً نمی‌ذاریم اینا چیزی بفهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.6,
   "end": 364.18,
   "text": "همشونه. ولی م-ما از شما می‌ترسیم، نگران شماییم از برزختون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 364.18,
   "end": 368.62,
   "text": "چرا؟ چون برزخ ملکات وجود انسان ظهور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 368.62,
   "end": 372.1,
   "text": "ملکه وجود چیه؟ همون ثمر و اشکال برزخی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 372.1,
   "end": 377.2,
   "text": "چی در انسان رسوخ کرده ملکه وجود شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.2,
   "end": 379.46,
   "text": "اصرار بر اعمال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 379.46,
   "end": 381.76,
   "text": "اون رو عادت کرده در حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 381.76,
   "end": 384.6,
   "text": "اون ظهورش در برزخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 384.6,
   "end": 387.26,
   "text": "اونجا دیگه خیلی کار سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 387.26,
   "end": 391.5,
   "text": "بی عذاب برزخیه. انت-- حداقلش دیگه انتظاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.5,
   "end": 395.28,
   "text": "ج-چرا چه کنم، چه نکنم؟ امیرالمؤمنین علیه الصلاة والسلام فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.28,
   "end": 398.5,
   "text": "اونایی که دشمن ما هستن که تکلیفشون معلومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.5,
   "end": 401.26,
   "text": "اونا هم که از اولیای خدا هستن تکلیفشون معلومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.26,
   "end": 405.4,
   "text": "یه دستن هم گناه دارن هم ثواب دارن از دوستداران ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.4,
   "end": 408.86,
   "text": "اینا برزخشون مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.86,
   "end": 411.3,
   "text": "خیلی باید مراقب باشیم، توسل کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.3,
   "end": 415.02,
   "text": "حالا من در گوشی به شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.02,
   "end": 419.0,
   "text": "توسل ما باید به برزخ عالم باشه به عنوان طلبتمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.0,
   "end": 421.36,
   "text": "که برزخ رو درست کنه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 421.36,
   "end": 423.76,
   "text": "والحمد لله رب العالمين. صلوات ختمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}