 "chapters": [
  {
   "index": 0,
   "title": "## دههٔ فجر و انفجار نور توحیدی",
   "start": 20.34,
   "end": 150.96
  },
  {
   "index": 1,
   "title": "## آیهٔ هفده عنکبوت؛ توحید افعالی و بت‌های دروغین",
   "start": 150.96,
   "end": 305.64
  },
  {
   "index": 2,
   "title": "بلافاصله می‌فرماید فابتغوا عند الله الرزق — نزد خدا رزق را بجویید. این نشان می‌دهد که مطلقاً رزق به دست خداست:",
   "start": 305.64,
   "end": 539.01
  },
  {
   "index": 3,
   "title": "## کسب و اکتساب؛ حبیب‌اللهی یا علیه نفس",
   "start": 539.01,
   "end": 634.99
  },
  {
   "index": 4,
   "title": "## تدبر در قرآن؛ ولیتلطف و قلب یاسین",
   "start": 634.99,
   "end": 823.42
  },
  {
   "index": 5,
   "title": "نکتهٔ آخر:",
   "start": 823.42,
   "end": 873.38
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 3.18,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.18,
   "end": 5.16,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.16,
   "end": 7.48,
   "text": "محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 7.48,
   "end": 10.86,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 10.86,
   "end": 16.16,
   "text": "السلام علیک یا داعی الله و ربانی آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.16,
   "end": 19.16,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.16,
   "end": 22.08,
   "text": "تبریک عرض می‌کنم ایام فرخنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.08,
   "end": 28.0,
   "text": "ده فجر و ورود حضرت امام علیه الرحمه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.0,
   "end": 32.42,
   "text": "که از انقلاب انفجار نور یاد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.42,
   "end": 38.16,
   "text": "این معمار کبیر تمدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.16,
   "end": 43.22,
   "text": "نوین اسلامی و این بنیانگذار انقلاب عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.22,
   "end": 46.8,
   "text": "به واقع، به واقع انفجار نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.8,
   "end": 50.46,
   "text": "چه نوری؟ نور توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.46,
   "end": 53.34,
   "text": "واقعاً انفجار نور توحیدی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.34,
   "end": 56.78,
   "text": "که زندگی‌ها همه و همه توحیدی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.78,
   "end": 60.48,
   "text": "نگرش‌ها، سبک زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.48,
   "end": 65.9,
   "text": "همه بشه توحیدی. یه فرمایشی حضرت امام دارن خیلی فرمایش شریف و عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.9,
   "end": 69.46,
   "text": "پیرامون همین بحث توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.46,
   "end": 74.38,
   "text": "ببینید ایشون چی میفرمایند. همه انبیا الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.38,
   "end": 79.38,
   "text": "در این جهت حرکت کردند که دست انسان را بگیرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.38,
   "end": 83.1,
   "text": "و او را از چاه انانیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.1,
   "end": 86.16,
   "text": "و کثرت‌بینی رهانیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.16,
   "end": 89.72,
   "text": "و به اوج توحید برسانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.72,
   "end": 93.36,
   "text": "این فلسفه بعثت انبیا همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.36,
   "end": 97.12,
   "text": "و بت‌هایی را که شریک خدا قرار داده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.12,
   "end": 100.7,
   "text": "بشکنند و به انسان نشان دهند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 100.7,
   "end": 103.2,
   "text": "که مؤثر واقعی در همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 103.2,
   "end": 106.48,
   "text": "شئونات تنها اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 106.48,
   "end": 110.16,
   "text": "این همه پیغمبر اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.16,
   "end": 116.12,
   "text": "هر کدومشونم به بدترین وجه ممکن به شهادت رسوندن، کشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.12,
   "end": 120.28,
   "text": "چه کردن؟ بعضیاشونو لای درخت گذاشتن با اره دو نیم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.28,
   "end": 122.18,
   "text": "بعضیاشونو پوستشونو کندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.18,
   "end": 126.58,
   "text": "بعضیاشونو سر بریدن. بعضیاشونو تو آتیش سوزوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.58,
   "end": 129.48,
   "text": "چه کردن با این انبیا؟ چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.48,
   "end": 131.14,
   "text": "ارزش توحید رو می‌رسوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 131.14,
   "end": 135.36,
   "text": "همه اومدن برای حرکت توحیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 135.36,
   "end": 141.7,
   "text": "اینکه ما انقدر پافشاری داریم اصلاً ماهیت و اون چیزی که برای ما می‌مونه پس از موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 141.7,
   "end": 144.56,
   "text": "شدت و حدت و ماهیت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 144.56,
   "end": 146.56,
   "text": "در حقیقت ارزش توحیدی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 146.56,
   "end": 152.22,
   "text": "چیز دیگه‌ای برای ما نمی‌مونه. حالا ما در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 152.22,
   "end": 159.66,
   "text": "هفده عنکبوت یه توجهی بکنیم ببینیم بحث توحید افعالی در این آیه چگون است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.66,
   "end": 165.4,
   "text": "می‌فرماید إنما تعبدون من دون الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.4,
   "end": 169.22,
   "text": "أوصان وتخلقون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.22,
   "end": 174.06,
   "text": "افکن. جز این نیست که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 174.06,
   "end": 177.2,
   "text": "به جای خدا بت‌هایی رو می‌پرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.2,
   "end": 179.68,
   "text": "همون بت‌هایی که روش اسم هم می‌گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 179.68,
   "end": 181.86,
   "text": "حالا اله شفیع مؤثر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.86,
   "end": 186.06,
   "text": "اینا رو از این جهت بت خودشون قرار داده بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.06,
   "end": 188.84,
   "text": "که افکن. اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 188.84,
   "end": 193.88,
   "text": "دروغ می‌ساختن. برای خودشون دروغ می‌ساختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 193.88,
   "end": 198.8,
   "text": "این‌ها رو مؤثر در عالم می‌دونستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.8,
   "end": 202.64,
   "text": "تعبدون، تعبدون من دون الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.64,
   "end": 206.64,
   "text": "لا یملکون. حالا کسایی رو شما می‌پرستین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.64,
   "end": 209.62,
   "text": "که لا یملکون لکم رزقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.62,
   "end": 213.9,
   "text": "هیچ تملکی تو رزق شما ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.9,
   "end": 218.22,
   "text": "ببینید نمی‌فرماید که لا یرزقون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 218.22,
   "end": 222.26,
   "text": "یا لا یرزقون یا لا یرزقونکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 222.26,
   "end": 226.94,
   "text": "نمیگه شما بت‌هایی رو می‌پرستید که به شما رزق نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 226.94,
   "end": 230.92,
   "text": "این اگه اینطوری بگه، اینطوری میشه برداشت کرد که می‌تونن رزق بدنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 230.92,
   "end": 235.56,
   "text": "به شما نمیدن. اگه می‌فرمود لا یرزقونکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.56,
   "end": 237.32,
   "text": "اما اینچنین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.32,
   "end": 240.62,
   "text": "یا آقا آیه می‌فرماید لا یملکون لکم رزقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.62,
   "end": 242.3,
   "text": "اصلاً امکان این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 242.3,
   "end": 245.64,
   "text": "از تملکی در رزق شما ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 245.64,
   "end": 247.28,
   "text": "هیچ کسم اینطوری نیستا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 247.28,
   "end": 252.84,
   "text": "نه فقط اون بتایی که حالا الان ما داریم آیه رو می‌خونیم به ما چه که اون طرف بت پرست بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 252.84,
   "end": 255.24,
   "text": "اون تفسیر آفاقی‌ش و شأن نزولشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 255.24,
   "end": 259.74,
   "text": "خب به من چه. خب این الان به من و شما هم داره همین گوشزد رو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 259.74,
   "end": 264.1,
   "text": "یا الان هم شما در تفسیر انفسی می‌خواین آیه رو تو خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.1,
   "end": 267.7,
   "text": "پیاده کنی بدون عهدی لا یملکون لکم رزقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 267.7,
   "end": 270.86,
   "text": "هیچکس تملک رزقی به شما نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 270.86,
   "end": 275.52,
   "text": "فقط حضرت حق. البته توجه باید داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 275.52,
   "end": 278.92,
   "text": "بعد از این بلافاصله می‌فرماید فابتعوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 278.92,
   "end": 282.2,
   "text": "شما بجویید عند الله الرزق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 282.2,
   "end": 286.32,
   "text": "این نشون میده که درسته مطلقاً رزق دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.32,
   "end": 290.6,
   "text": "ان الله هو الرزاق ذو القوة المتین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.6,
   "end": 292.64,
   "text": "ان الله چقدر شیرینه این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 292.64,
   "end": 296.12,
   "text": "هو الرزاق ذو القوة المتین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 296.12,
   "end": 299.1,
   "text": "فکر می‌کنم آخر سوره ذاریات باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 299.1,
   "end": 302.08,
   "text": "پنجاه و هشت. آیه پنجاه و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 302.08,
   "end": 304.5,
   "text": "بله که یه بار عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 304.5,
   "end": 308.72,
   "text": "صبر و-- مداومت بر این آیه وسط رزق میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 308.72,
   "end": 313.5,
   "text": "این داره تصریح می‌کنه که رزاق اصلی اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 313.5,
   "end": 318.18,
   "text": "درست؟ اما می‌فرماید فابتعوا یعنی خودتم حرکت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 318.18,
   "end": 321.42,
   "text": "نشین تو خونه بگو خب رزاق اصلی خدا تو می‌رسونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 321.42,
   "end": 324.78,
   "text": "نه. فابتعوا خودت هم بجو این رزق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 324.78,
   "end": 327.54,
   "text": "یعنی باید حرکت کرد. از تو حرکت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 327.54,
   "end": 331.82,
   "text": "از خدا برکت. نکته بعد اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 331.82,
   "end": 337.16,
   "text": "می‌فرماید فابتعوا عند الله الرزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 337.16,
   "end": 339.98,
   "text": "نزد خدا رزق رو بیاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 339.98,
   "end": 343.52,
   "text": "بعد می‌فرماید واعبدوه واشکروا له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 343.52,
   "end": 345.98,
   "text": "اول می‌فرماید برو رزقتو از خدا بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 345.98,
   "end": 349.42,
   "text": "حالا عبادتشو بکن و شکرشو به جا بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 349.42,
   "end": 353.88,
   "text": "به قول آقای قرائتی در تفسیر نور اشاره به همین تیکه آیه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 353.88,
   "end": 361.57,
   "text": "فرمایین داره تصریح می‌کنه که آقا اصلاً وظیفه یه مدیر، حالا من و شما به عنوان مدیر خانواده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 361.57,
   "end": 365.95,
   "text": "این نان آبه رو راه-- ما که وارد خونه میشیم بچه ما رو در شأن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 365.95,
   "end": 370.41,
   "text": "میکائیلی می‌بینه دیگه. میکائیل ناموس و کلیددار رزق حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 370.41,
   "end": 374.37,
   "text": "ما رو در این شأن می‌بینه. یعنی بچه فکر می‌کنه ما راض بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 374.37,
   "end": 376.37,
   "text": "درست شد؟ به صورت با یه وسیله‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 376.37,
   "end": 378.61,
   "text": "وقتی وارد خونه میشیم اون ما رو اینطوری می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 378.61,
   "end": 381.41,
   "text": "برای همین میگن پدر وارد خونه شد دست خالی نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 381.41,
   "end": 383.65,
   "text": "چون می‌شه یه چیزی با خودش ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 383.65,
   "end": 387.45,
   "text": "سنت انبیا بوده که قبلاً هم عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 387.45,
   "end": 389.83,
   "text": "حالا می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 389.83,
   "end": 393.21,
   "text": "شما وقتی که در سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 393.21,
   "end": 398.15,
   "text": "ر-رزق قرار می‌گیری و رزق رو میاری حواست باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 398.15,
   "end": 403.53,
   "text": "عه، چه تو، چه که-- چه به عنوان پدر یه خونواده، چه کسی که مدیر یه مجموعه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 403.53,
   "end": 406.27,
   "text": "چه کسی که رئیس حکومته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 406.27,
   "end": 410.87,
   "text": "یعنی از این سلسله مراتب پایین بگیر برو تا اون عالی‌ترین مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 410.87,
   "end": 413.45,
   "text": "اول ببینید می‌فرماید «فابتعوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 413.45,
   "end": 417.31,
   "text": "عند الله الرزق» حالا «واعبدوه وشکروا له».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 417.31,
   "end": 422.07,
   "text": "اول اقتصادتو بساز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 422.07,
   "end": 424.89,
   "text": "ارتزاق رو درست کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 424.89,
   "end": 428.33,
   "text": "اون که میگه وقس-- وقس في مش اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 428.33,
   "end": 432.23,
   "text": "معیشت خانواده رو اقتصادی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 432.23,
   "end": 436.35,
   "text": "یعنی درستش کن، بهش رسیدگی کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 436.35,
   "end": 439.27,
   "text": "نیازهای خانواده رو مرتفع کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 439.27,
   "end": 444.65,
   "text": "نیازهای مملکت رو-- حالا توقع داشته باش عبادت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 444.65,
   "end": 449.35,
   "text": "چقدر شیرینه. یعنی اگه کسی اسلام رو خوب متوجه بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 449.35,
   "end": 452.83,
   "text": "می‌بینه که اصلاً اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 452.83,
   "end": 455.57,
   "text": "گره خورده با مباحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 455.57,
   "end": 460.11,
   "text": "اقتصادی. اصلاً شما نمی‌تونی اقتصاد رو از اسلام برداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 460.11,
   "end": 464.53,
   "text": "بگی حالا بندگی کنید دیگه. بچه خوبی باش، بنده خوبی باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 464.53,
   "end": 467.43,
   "text": "چه حرف گزاف و بیهوده‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 467.43,
   "end": 473.75,
   "text": "اصلاً کسی که اقتصادش درست نیست چگونه تو توقع داری عبادت درستی انجام بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 473.75,
   "end": 475.89,
   "text": "اگرچه این رو توجه داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 475.89,
   "end": 479.21,
   "text": "این برای چیه؟ نفوس ضعیف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 479.21,
   "end": 483.65,
   "text": "این، این در حقیقت استثناء رو هم قائل باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 483.65,
   "end": 491.25,
   "text": "اص-- اتفاقاً برای کمالین، برای انسان‌هایی که خیلی رشد می‌کنند، برای امثال ابوذرها، اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 491.25,
   "end": 493.61,
   "text": "نه اتفاقاً به زهد می‌رسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 493.61,
   "end": 495.99,
   "text": "کلاً بی‌رغبت به دنیا می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 495.99,
   "end": 497.83,
   "text": "نه اینکه اقتصاد رو تعدیل کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 497.83,
   "end": 500.73,
   "text": "اشتباه نشه. اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 500.73,
   "end": 503.27,
   "text": "مخالف انباشت ثرو-ثروته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 503.27,
   "end": 506.11,
   "text": "بارها عرض کردیم موافق جدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 506.11,
   "end": 510.11,
   "text": "تولید ثروته. تولید کن تا می‌تونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 510.11,
   "end": 511.89,
   "text": "اما انباشت نداشته باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 511.89,
   "end": 515.91,
   "text": "اون رو توزیع کن به نیازمندا و به دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 515.91,
   "end": 518.09,
   "text": "تولید، اهل تولید باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 518.09,
   "end": 521.35,
   "text": "چقدر اسلام توهید-- تولید رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 521.35,
   "end": 524.87,
   "text": "تأکید کرده. الكاسب حبيب الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 524.87,
   "end": 530.89,
   "text": "کجا شما اص-- کدوم آیین و کدom دین سراغ داری بگه الكاسب حبيب خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 530.89,
   "end": 535.15,
   "text": "سوخیه مگه؟ لا حبیب الا هو و اهله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 535.15,
   "end": 538.65,
   "text": "بعد از این طرف الكاسب حبيب الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 538.65,
   "end": 541.41,
   "text": "البته اینجا كاسب باید ترجمه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 541.41,
   "end": 547.01,
   "text": "یعنی چی؟ كاسب فقط اونی نیست که پشت پیشخونه مغازه‌ش وایمیسته و کسب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 547.01,
   "end": 549.47,
   "text": "ما یه کسب داریم، یه اکتساب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 549.47,
   "end": 553.93,
   "text": "اکتساب لها ماک-ما کسبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 553.93,
   "end": 559.05,
   "text": "به نفعشه. کسبش به نفعشه و علیها مكتسبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 559.05,
   "end": 561.89,
   "text": "اکتساب علیهشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 561.89,
   "end": 569.67,
   "text": "من اگر فطرت خداجوی خودم رو بدل می‌کنم به فطرت ثانویه، اون فطرت الهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 569.67,
   "end": 576.09,
   "text": "می‌کنم جبلی و فطرت ثانویه که به سمت معاصی و قبایح اعمال میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 576.09,
   "end": 578.15,
   "text": "این می‌شه علیها مكتسبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 578.15,
   "end": 580.13,
   "text": "می‌شه اکتساب. بر وزن افتعال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 580.13,
   "end": 582.91,
   "text": "بر علیه منه. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 582.91,
   "end": 585.73,
   "text": "نهی شده، نف شده. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 585.73,
   "end": 589.73,
   "text": "اون کسبی که الكاسب حبيب الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 589.73,
   "end": 591.79,
   "text": "لها مكتسبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 591.79,
   "end": 595.99,
   "text": "اینطوریه. فقط اون نباشه که پشت پیشخونه مغازه ببینیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 595.99,
   "end": 598.25,
   "text": "درست باید دید حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 598.25,
   "end": 601.25,
   "text": "کسی که کسبش به نفع خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 601.25,
   "end": 605.91,
   "text": "مطلقاً الان دقت بفرمایید از جهت فلسفی و حتی عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 605.91,
   "end": 608.69,
   "text": "الان شما دارید صدای منو می‌شنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 608.69,
   "end": 613.99,
   "text": "ظاهراً در سکون و آرامش نشستید هیچ کاری نمی‌کنید، فقط دارید یه صدا می‌شنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 613.99,
   "end": 618.13,
   "text": "چشمتون داره منو می‌بینه. عینا در حال کسبید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 618.13,
   "end": 620.59,
   "text": "اگر این چیزی که داری می‌شنوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 620.59,
   "end": 625.39,
   "text": "این چیزی که داری می‌بینی، اگر به نفعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 625.39,
   "end": 628.15,
   "text": "در مسیر فطرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 628.15,
   "end": 631.43,
   "text": "الهی شماست، این کسب شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 631.43,
   "end": 634.67,
   "text": "الكاسب حبيب الله. شما حبیب الهی می‌شین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 634.67,
   "end": 637.81,
   "text": "توجه کردید تا کجا می‌شه رفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 637.81,
   "end": 642.25,
   "text": "اما اگر خدایی نکرده این چیزی که داری می‌بینی، این چیزی که داری می‌شنوی، این چیزی که لمس می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 642.25,
   "end": 644.41,
   "text": "می‌بویی از همین حواس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 644.41,
   "end": 648.41,
   "text": "ابتدایی و انزل بگیر برو تا اعلی‌ترین حواس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 648.41,
   "end": 650.49,
   "text": "می‌خواد وهم باشه، خیال باشه، هرچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 650.49,
   "end": 653.37,
   "text": "برو تا بالا. اگر علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 653.37,
   "end": 656.83,
   "text": "اون فطرت ابتدایی ماست، فطرت الهی ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 656.83,
   "end": 658.57,
   "text": "می‌شه و علیها مكتسبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 658.57,
   "end": 661.73,
   "text": "می‌شه اکتساب و می‌شاره کننده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 661.73,
   "end": 664.99,
   "text": "اصلاً عذاب برزخی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 664.99,
   "end": 669.75,
   "text": "به اکتسابات ماست. به میزانی ما عذاب برزخی می‌چشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 669.75,
   "end": 674.77,
   "text": "اصلاً معطل و منتظر در عالم برزخ می‌مونیم که اکتساب کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 674.77,
   "end": 677.27,
   "text": "به میزانی از برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 677.27,
   "end": 679.41,
   "text": "فرار می‌کنیم. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 679.41,
   "end": 685.73,
   "text": "فروا الى الله. فرار می‌کنیم به سمت حضرت حق به سرعت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 685.73,
   "end": 691.19,
   "text": "کسب داشتیم و به مقام حبیب اللهی رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 691.19,
   "end": 694.99,
   "text": "ببین آقا ما یه آیه رو خوندیم. همونطوری که شما همین رد شدی اون آیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 694.99,
   "end": 696.93,
   "text": "آقا بخونیم، بخونیم خیلی ثواب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 696.93,
   "end": 700.69,
   "text": "بخونیم ثواب داره. بخون خیلی ثواب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 700.69,
   "end": 703.43,
   "text": "خب اصلاً اینا به این معارف می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 703.43,
   "end": 705.73,
   "text": "به این دقت نظرها می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 705.73,
   "end": 707.99,
   "text": "برای همین چقدر رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 707.99,
   "end": 711.07,
   "text": "تأکید می‌کنه رو تدبر در قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 711.07,
   "end": 714.97,
   "text": "تأمل در قرآن. قلب عبارتی قرآن هم چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 714.97,
   "end": 724.06,
   "text": "وليتلطف. حضرت استاد فرمودن به باطن قرآن می‌خواید برسید، سرش در قلب عبارتی قرآنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 724.06,
   "end": 728.12,
   "text": "حالا خود قرآن یه سوره داره که قلب قرآنه، سوره یاسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 728.12,
   "end": 731.82,
   "text": "خود سوره یاسین یه آیه داره که قلب، قلب قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 731.82,
   "end": 733.88,
   "text": "یعنی قلب سوره یاسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 733.88,
   "end": 736.96,
   "text": "سلامٌ قولاً من رب رحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 736.96,
   "end": 740.26,
   "text": "که یه دستورالعملی حضرت استاد دارن چهارصد سی و س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 740.26,
   "end": 742.36,
   "text": "دو مرتبه این آیه رو به علاوه یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 742.36,
   "end": 748.16,
   "text": "دعاس بخونی خیلی از الطاف خفیه الهی نصیبت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 748.16,
   "end": 751.48,
   "text": "مشروطه ما یازده رو که آشوب تازه شروع شده بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 751.48,
   "end": 757.64,
   "text": "سحر با بچه‌ها تا سحر بودیم اونو ج-- دست جمعی خوندیم که شرشون به خودشون برگرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 757.64,
   "end": 760.92,
   "text": "و یه قلب عبارتی قرآن هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 760.92,
   "end": 765.4,
   "text": "ولیتلطف. تلطیف السر باید بکنی تا به باطن قرآن پی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 765.4,
   "end": 768.98,
   "text": "ره پیدا کنی. حضرت استاد می‌فرماید: أیتعقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 768.98,
   "end": 774.4,
   "text": "یعنی تعق-- اهل تعقل باشی، تأمل و تفکر و تدبر باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 774.4,
   "end": 776.44,
   "text": "همین‌طوری قرآن رو بخونیم بریم چیزی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 776.44,
   "end": 779.5,
   "text": "بله نورانیت داره. به قول ملا صدرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 779.5,
   "end": 783.08,
   "text": "همین قرآن کتب شده، همین عبارات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 783.08,
   "end": 785.68,
   "text": "جوهری که رو کاغذ کتب شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 785.68,
   "end": 790.84,
   "text": "این هم همون نور لمعات جمال الهی رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 790.84,
   "end": 796.34,
   "text": "خب؟ این هم داره. به قول امام حتی نفهمی هم قرآن رو، چی داری می‌خونی، نورش گیرت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 796.34,
   "end": 799.4,
   "text": "یه نوری به تو می‌رسه. البته دعا این‌طوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 799.4,
   "end": 802.78,
   "text": "دعا اگه نفهمی چی می‌خونی فایده نداره، ترکش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 802.78,
   "end": 805.92,
   "text": "اما قرآن نه. اما این کجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 805.92,
   "end": 812.06,
   "text": "اون کجا که بری تدبر کنی، تفکر کنی، تأمل کنی در قرآن به باطن قرآن برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 812.06,
   "end": 814.68,
   "text": "الان چقدر نکته از این آیه استخراج شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 814.68,
   "end": 817.92,
   "text": "و نکته آخر هم الیه ترجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 817.92,
   "end": 823.28,
   "text": "حواست باشه داداش این حرفایی که ما داریم به شما می‌زنیم عزیز دلم، من نمیگم قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 823.28,
   "end": 825.3,
   "text": "من به زبان لطیفانه دارم می‌گم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 825.3,
   "end": 829.72,
   "text": "نظام‌ابادی‌شو دارم می‌گم. داداش این حرفایی که ما داریم به شما می‌زنیم تو این آیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 829.72,
   "end": 832.48,
   "text": "الیه ترجعون. حالا می‌خوای گوش بده، می‌خوای گوش نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 832.48,
   "end": 835.0,
   "text": "قراره رجعت کنی بیای به سمت خود ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 835.0,
   "end": 838.78,
   "text": "بعد حساب کتاب ما بر اساس همین مفاهیم، مفاهیمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 838.78,
   "end": 841.22,
   "text": "همین مضامین، همین آیات ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 841.22,
   "end": 844.32,
   "text": "بر اساس این من از شما حساب کتاب می‌کشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 844.32,
   "end": 846.7,
   "text": "میزان هم نه-نزد ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 846.7,
   "end": 848.58,
   "text": "نحن موازین القسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 848.58,
   "end": 852.28,
   "text": "اون‌ها آل الله هستند. شما رو می‌سنجم با علی ابن ابی طالب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 852.28,
   "end": 855.16,
   "text": "با حضرت صدیقه شهیده و شیعیان اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 855.16,
   "end": 857.86,
   "text": "و بر اساس قرآن، میزان قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 857.86,
   "end": 861.18,
   "text": "می‌خوای گوش بده، می‌خوای گوش نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 861.18,
   "end": 864.42,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 864.42,
   "end": 866.4,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 866.4,
   "end": 873.38,
   "text": "صلوات الله على محمد و آله طاهرين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}