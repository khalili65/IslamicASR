 },
 "chapters": [
  {
   "index": 0,
   "title": "## توحید افعالی در آیات دو و سهٔ فرقان",
   "start": 19.64,
   "end": 115.44
  },
  {
   "index": 1,
   "title": "آیهٔ بعد می‌فرماید:",
   "start": 115.44,
   "end": 170.3
  },
  {
   "index": 2,
   "title": "## ملکِ حقیقی در برابرِ مالکیتِ اعتباری",
   "start": 170.3,
   "end": 235.7
  },
  {
   "index": 3,
   "title": "## خدای آسمان همان خدای زمین",
   "start": 235.7,
   "end": 667.55
  },
  {
   "index": 4,
   "title": "## توحید صدوق؛ صنع از لا من شیء",
   "start": 667.55,
   "end": 687.61
  },
  {
   "index": 5,
   "title": "## معنای فلسفیِ کتمِ عدم",
   "start": 687.61,
   "end": 799.44
  },
  {
   "index": 6,
   "title": "## کل یوم هو فی شأن و معنای کتمِ عدم",
   "start": 799.44,
   "end": 869.48
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 5.12,
   "end": 9.26,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.26,
   "end": 13.24,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.24,
   "end": 19.64,
   "text": "آیه. سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.64,
   "end": 22.06,
   "text": "در آیه دو و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.06,
   "end": 27.78,
   "text": "فرقان دقت بفرمایید چقدر شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.78,
   "end": 32.1,
   "text": "توحید افعالی رو به نمایش گذاشته حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.1,
   "end": 36.94,
   "text": "الذي له ملك السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.94,
   "end": 41.58,
   "text": "خدا خودش رو اینطوری معرفی کرده که له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.58,
   "end": 44.98,
   "text": "برای اوست پادشاهی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.98,
   "end": 49.98,
   "text": "سلطنت آسمان‌ها و زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.98,
   "end": 56.94,
   "text": "و لم يتخذ ولدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.94,
   "end": 59.0,
   "text": "و لم یکن له شريك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.0,
   "end": 60.88,
   "text": "في الملك و خلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.88,
   "end": 63.14,
   "text": "كل شيء فقدره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.14,
   "end": 67.78,
   "text": "تقديرا. به به! تاکید هم می‌کنه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.78,
   "end": 74.9,
   "text": "اون قدرت مقدراتش، تعیین مقدراتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.9,
   "end": 77.88,
   "text": "می‌فرماید فرزندی برای خود نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.88,
   "end": 83.94,
   "text": "در فرمانروایی، فرمانروایی عالم هیچ شریکی نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.94,
   "end": 88.22,
   "text": "و هر چیزی رو آفریده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.22,
   "end": 93.82,
   "text": "خلق کل شیء. هم که آفریده بعد فقدره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.82,
   "end": 96.4,
   "text": "تقدیرا اندازه براش قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.4,
   "end": 100.12,
   "text": "اونم چه اندازه قرار دادنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.12,
   "end": 102.9,
   "text": "چه تقدیر دقیقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.9,
   "end": 106.12,
   "text": "مولای درزش به قول قدیمیا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.12,
   "end": 110.58,
   "text": "این از این آیه. حالا توضیح میدم خدمتتون بعضی نکاتشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.58,
   "end": 113.56,
   "text": "آیه بعد می‌فرماید واتخذوا من دونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.56,
   "end": 120.12,
   "text": "آلهه. مشرکان به جای چنین خدایی معبودانی را اختیار کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.12,
   "end": 125.14,
   "text": "لا يخلقون شيئا. هیچ چیزی رو نیافریدند و نمی‌آفرینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.14,
   "end": 127.74,
   "text": "اصلا توانایی آفرینش ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.74,
   "end": 130.86,
   "text": "وهم يخلقون. در حالی که خودشون خلق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.86,
   "end": 135.08,
   "text": "خودشون خلق شدن. برش خورده و جدا شده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.08,
   "end": 137.48,
   "text": "الخالق البارئ المسور دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.48,
   "end": 144.18,
   "text": "خدا بهشون صورت داده. ولا يملكون لأنفسهم ضرا ولا نفعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.18,
   "end": 147.62,
   "text": "اصلا تملکی ندارند به جان‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.62,
   "end": 150.72,
   "text": "نه از حیث ضرر، نه نفع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.72,
   "end": 153.74,
   "text": "جالبه که ضرر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.74,
   "end": 156.04,
   "text": "مقدم میاره بر نفع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.04,
   "end": 161.24,
   "text": "که انّ دفع ضرر مهم‌تر از جلب منفعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.24,
   "end": 164.28,
   "text": "ولا يملكون موتا ولا حياة ولا نشورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.28,
   "end": 166.74,
   "text": "دیگه به سر و تمام می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.74,
   "end": 170.16,
   "text": "می‌فرماید که اصلا این-- اینا هیچ تملکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.16,
   "end": 173.44,
   "text": "نه در موت‌شون دارن، نه حیات‌شون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.44,
   "end": 176.06,
   "text": "نه برانگیخته شدن بعد از حیات‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.06,
   "end": 178.8,
   "text": "اینایی که شما دل بهشون بستین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.8,
   "end": 181.48,
   "text": "این دیگه، دیگه نهایت توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.48,
   "end": 186.52,
   "text": "اولا تو آیه دو می‌فرماید خدا اون کسیه که له،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.52,
   "end": 192.12,
   "text": "این له که برای اوست پادشاهی آسمان‌ها و زم-زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.12,
   "end": 197.42,
   "text": "این له مالکیت اعتباری نیست عزیزان، حقیقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.42,
   "end": 200.64,
   "text": "یعنی چی حقیقیه؟ یعنی همیشه له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.64,
   "end": 202.96,
   "text": "مثلا الان این لباس تن منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.96,
   "end": 212.68,
   "text": "تا چند سال تن منه؟ تا وقتی کهنه و مندرس بشه یا إنا لله و إنا إليه راجعون حاصل بشه و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.68,
   "end": 216.0,
   "text": "مال من نیست این لباس. این به این میگن مالکیت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.0,
   "end": 220.9,
   "text": "اعتباری. حتی این بدن من هم مال خودم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.9,
   "end": 226.42,
   "text": "اینم خاک میشه. همه چی، همه اعتبارات از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.42,
   "end": 229.08,
   "text": "عنوان من، اسم من علی اکبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.08,
   "end": 235.7,
   "text": "آیا وقتی جنازه‌ام می‌خوان بردارن میگن آقای علی اکبر شیخ عبد الزهرا فلان اینو بردارید بیارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.7,
   "end": 237.82,
   "text": "نه، میگن جنازه رو بردار بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.82,
   "end": 245.24,
   "text": "تمام اعتبارات مثلا آقای دکتر، آقای مهندس، آقای مدیر، جناب مدیر کل، این حرفات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.24,
   "end": 248.24,
   "text": "این مزخرفات چیه؟ جنازه رو بردار بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.24,
   "end": 251.28,
   "text": "حتی آیت الله العظماش هم باشه میگه آیت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.28,
   "end": 255.08,
   "text": "اصلا همچین حرفی نمی‌زنن. میگه جنازه رو بردار بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.08,
   "end": 258.64,
   "text": "اینطور نیست؟ اسهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.64,
   "end": 262.02,
   "text": "افهم اسم يا عبد الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.02,
   "end": 265.46,
   "text": "بفهם، بشنو يا عبد الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.46,
   "end": 268.6,
   "text": "ابن عبد الله. اسمه میاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.6,
   "end": 270.76,
   "text": "یعنی همه چی برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.76,
   "end": 276.9,
   "text": "خونه‌ت، ماشینت، منصب‌ت، دارایی، مال و مالیات، هرچی که داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.9,
   "end": 280.22,
   "text": "اعتباریه. اما در خصوص حضرت حق چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 280.22,
   "end": 283.12,
   "text": "له مالکیت حقیقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 283.12,
   "end": 286.04,
   "text": "له ملك السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.04,
   "end": 288.3,
   "text": "حالا جالبه. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 288.3,
   "end": 293.3,
   "text": "آسمان‌ها ملك السماوات له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.3,
   "end": 296.64,
   "text": "زمین ملك الأرض له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.64,
   "end": 302.44,
   "text": "جالبه که نه داره میگه که آقا خدایی که تو آسمونه همون خداییه که رو زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.44,
   "end": 305.86,
   "text": "ما همش منتظریم بریم تو آسمون خدا رو پیدا کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.86,
   "end": 308.06,
   "text": "یا از این دنیا بریم به خدا برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.06,
   "end": 312.02,
   "text": "آ-- به نظر شما خدای عالم ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.02,
   "end": 314.78,
   "text": "آیا خدای عالم ملک نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.78,
   "end": 320.1,
   "text": "آیا خدای روز قیامت خدای همین نشئه طبیعت و دنیا نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.1,
   "end": 322.02,
   "text": "که منتظریم اونجا رویت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.02,
   "end": 324.28,
   "text": "چرا منتظریم بمیریم تا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.28,
   "end": 329.28,
   "text": "ملاقات خدا برسیم؟ موتو قبلاً تموم شد همین جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.28,
   "end": 331.12,
   "text": "امکانش هست، خیلی‌ها رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.12,
   "end": 337.56,
   "text": "چرا ما نرسیم؟ خود قرآن می‌فرماید هو الذي-- ببین چقدر قشنگ خدا خودشو معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.56,
   "end": 341.1,
   "text": "هو الذي في السماء إله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.1,
   "end": 345.46,
   "text": "وفي الأرض إله. اون کسیه که همون هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.46,
   "end": 348.3,
   "text": "تو آسمان إله همونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.3,
   "end": 352.8,
   "text": "و في الأرض إله. باز تو زمین هم همون إلهه، همون هوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.8,
   "end": 356.98,
   "text": "نه کس دیگه. چرا ما فکر می‌کنیم که مثلا خدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.98,
   "end": 359.58,
   "text": "آسمان‌ها فرق می‌کنه با خدای زمین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.58,
   "end": 365.55,
   "text": "اینم یه نکته دیگه نکته دیگه حالا خیلی آیه خیلی کثیر الفروع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.55,
   "end": 369.29,
   "text": "حالا چند تا نکته‌ش نسبت به زیغ وقت ار-ارزه می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 369.29,
   "end": 371.87,
   "text": "یا اینجا که فقط دره تقدیرها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.87,
   "end": 376.87,
   "text": "آخر آیه دو. چقدر قشنگ می‌فرماید:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 376.87,
   "end": 380.43,
   "text": "همه چی رو به اندازه درست و دقیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.43,
   "end": 382.99,
   "text": "اندازه‌گیری کرده حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.99,
   "end": 385.79,
   "text": "یعنی اگر اپسیلون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 385.79,
   "end": 388.73,
   "text": "چه عرض کنیم کوچک‌ترین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.73,
   "end": 396.29,
   "text": "کوچک‌ترین جابجایی صورت بگیره در این تقدیرات و اندازه‌ای که خدا قرار داده، کلن فی فلک یسبحون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.29,
   "end": 400.03,
   "text": "همه تو یه مدار خاصی شناگرن، شناورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.03,
   "end": 402.33,
   "text": "دارن حرکتشونو می‌کنن. یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.33,
   "end": 404.55,
   "text": "آن کوچک‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.55,
   "end": 408.55,
   "text": "اعوجاجی صورت بگیره به اندازه یک میکرون، همه چی می‌پاچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.55,
   "end": 411.37,
   "text": "چقدر تقدیر دقیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.37,
   "end": 416.09,
   "text": "چقدر مهمه دقت کردن به همین موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.09,
   "end": 419.87,
   "text": "مثلا ما الان می‌گیم که فکر می‌کنیم که همه چی به هم چسبیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.87,
   "end": 424.73,
   "text": "الان خود ما الان شاید چند میلیارد میلی-مولکول تو وجود ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.73,
   "end": 427.75,
   "text": "سر یه سوزن چند تا مولکول داره به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.75,
   "end": 430.67,
   "text": "حالا مثلا بخوایم مثال بزنیم کوچک‌ترین ممکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 430.67,
   "end": 432.91,
   "text": "جای ممکن میگیم اندازه سر سوزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.91,
   "end": 439.83,
   "text": "همون سر سوزن دانشمندا گفتن نسبت به اندازه اون سر سوزن کوچک بزرگ باز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 439.83,
   "end": 445.45,
   "text": "به اندازش از شش میلیارد تا دوازده میلیارد مولکول وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 445.45,
   "end": 447.57,
   "text": "تو همون نوک سر سوزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.57,
   "end": 453.13,
   "text": "بعد اون نوک سر سوزنی که شما نگاه می‌کنی آیا به هم چسبیده نمی‌بینیش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 453.13,
   "end": 455.65,
   "text": "یه نوک، یه نوک سوزنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.65,
   "end": 459.47,
   "text": "میگی چسبیده به هم. مولکولای بدن من چسبیده به هم که منم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.47,
   "end": 463.09,
   "text": "اما در وا-- اصلا ما در فیزیک کوانتوم هم اینو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 463.09,
   "end": 467.59,
   "text": "الکترون و پروتون و نوترون و نمیدونم اینا چسبیده به هم نیستن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.59,
   "end": 469.87,
   "text": "هم کلا فی فلک یسبحون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 469.87,
   "end": 473.55,
   "text": "اونا هم توی مداری در حال شناگری و حرکتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 473.55,
   "end": 475.93,
   "text": "اصلا ما چیزی به نام چسبندگی ما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 475.93,
   "end": 481.67,
   "text": "حالا میگیم چسبیده. اما چسبندگی ما نداریم، فشردگی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 481.67,
   "end": 486.23,
   "text": "یعنی اینا همه اجزایی از هم جدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.23,
   "end": 491.23,
   "text": "پرورد-پروردگار سبحان با چه قدرتی اینا رو گرد هم نگه داشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.23,
   "end": 495.43,
   "text": "یک آن اراده‌شو برداره همه چی می‌پاچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.43,
   "end": 502.69,
   "text": "توجه به این کردید؟ حالا شما از این دور منظومه شمسی رو یه شب که هوا مثلا ابری نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.69,
   "end": 507.73,
   "text": "برید ببینید تا اونجا که چشم کار می‌کنه در آسمان ثوابت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.73,
   "end": 511.47,
   "text": "یا آسمان یا فلک هشتم نقطه، نقطه، نقطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 511.47,
   "end": 513.81,
   "text": "پر است از میلیاردها ترمینال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 513.81,
   "end": 517.13,
   "text": "در هر ترمینالی میلیاردها کهکشان، هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.13,
   "end": 518.87,
   "text": "کهکشانی میلیاردها منظومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 518.87,
   "end": 521.49,
   "text": "همینطوری. میلیاردها که-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 521.49,
   "end": 524.07,
   "text": "از سیاره و ستاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 524.07,
   "end": 526.95,
   "text": "چی خبر داره؟ اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.95,
   "end": 530.19,
   "text": "همه از هم جدا، خدا در یک مداری قرارشون داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.19,
   "end": 532.03,
   "text": "این تقدیرات الهی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 532.03,
   "end": 538.13,
   "text": "کی می‌تونه؟ یه ذره توجه می‌کنه به این آسمان زیبا و قشنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 538.13,
   "end": 540.45,
   "text": "کی می‌تونه همچین چیزی بیافرینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.45,
   "end": 544.31,
   "text": "بعد اینا همه شما اینا رو از ن-- دور نگاه می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 544.31,
   "end": 547.13,
   "text": "نقطه، نقطه، نقطه. حالا برو نزدیک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.13,
   "end": 549.63,
   "text": "برو نزدیک، برو نزدیک، برو نزدیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 549.63,
   "end": 553.29,
   "text": "می‌بینی تازه به یه دونش می‌رسی چه وسعتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 553.29,
   "end": 559.03,
   "text": "همین قصه سر سوزن رو بارها مثالشو زدم تو درس و بحث‌ها با عزیزانی که در خدمتشون بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 559.03,
   "end": 562.29,
   "text": "همین نوک سوزن رو شما یه نوک، یه نوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 562.29,
   "end": 564.83,
   "text": "کوچولو می‌بینی دیگه. یه نقطه می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.83,
   "end": 569.67,
   "text": "حالا برو جلو، برو جلو، برو جلو با میکروسکوپ پیشرفته‌ترین میکروسکوپ‌ها برو جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 569.67,
   "end": 573.45,
   "text": "برو جلو. می‌بینی اِاَ یه کهکشانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 573.45,
   "end": 575.99,
   "text": "نوک سوزن یه کهکشانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 575.99,
   "end": 579.99,
   "text": "که دوازده میلیارد سیاره توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 579.99,
   "end": 583.85,
   "text": "اونم مولکوله. دوباره تو خود مولکول چه خبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 583.85,
   "end": 589.07,
   "text": "این فقط دره تقدیرها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 589.07,
   "end": 591.31,
   "text": "نه فقط تو اثر انگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 591.31,
   "end": 594.15,
   "text": "تو هیچ‌چی انسان‌ها شبیه هم نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 594.15,
   "end": 596.49,
   "text": "چون اون احد واحده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 596.49,
   "end": 598.71,
   "text": "خلقشم احد واحده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 598.71,
   "end": 600.83,
   "text": "خلقشم یک نسخه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 600.83,
   "end": 603.15,
   "text": "شنیدی میگی تو یه دونه‌ای‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 603.15,
   "end": 605.23,
   "text": "یه دونه‌ای. همه یه دونه‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 605.23,
   "end": 609.49,
   "text": "نه حسین آقا فقط. همه یه دونه‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 609.49,
   "end": 612.55,
   "text": "یه دونه. شما یک نسخه‌ای، تک نسخه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 612.55,
   "end": 616.31,
   "text": "اصلا احدی شبیه و مثل تو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 616.31,
   "end": 619.63,
   "text": "همه با هم مختلفن. کارخونه خدا اینجوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 619.63,
   "end": 622.77,
   "text": "کارخونه مثلا تولید خودرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 622.77,
   "end": 626.63,
   "text": "یه اشلی داره، یه برنامه‌ای داره، همه عین هم میان بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 626.63,
   "end": 628.57,
   "text": "ولی خدا اینطوری خلق نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 628.57,
   "end": 633.67,
   "text": "تازه خود حضرت عالی که الان حاضری آنفآن در حال جدید شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 633.67,
   "end": 635.81,
   "text": "آنفآن آدم قبلی نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 635.81,
   "end": 638.85,
   "text": "آنفآن یعنی یک لحظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 638.85,
   "end": 643.59,
   "text": "یمیت حالت قبلیت، طور قبلیت یمیت مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 643.59,
   "end": 646.09,
   "text": "حالت جدیده. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 646.09,
   "end": 650.41,
   "text": "تجلی جدیده. حضرت حق در تو جد-- تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 650.41,
   "end": 652.55,
   "text": "ظهور کرد حالت جدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 652.55,
   "end": 657.35,
   "text": "یحیی احیا شد. آنفآن این دو اس در تو پیاده دارن میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 657.35,
   "end": 660.29,
   "text": "محی و ممیت. حالا خیلی حرف اینجا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 660.29,
   "end": 663.95,
   "text": "ما همینطوری یکی دو تا نکته‌ش رو می‌گیم تا شب باید حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 663.95,
   "end": 672.87,
   "text": "چه خبره؟ در توحید شیخ صدوق روایتی دیدم اینم بگما بسه برای امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 672.87,
   "end": 677.75,
   "text": "صفحه چهل و دو. هست کتابش اینجا تو دفتر ما هست خواستید برید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 677.75,
   "end": 683.19,
   "text": "چقدر حضرت استاد روحش شاد توصیه داشتن به خوندن این کتاب توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 683.19,
   "end": 686.35,
   "text": "صدوق. روحش شاد شیخ صدوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 686.35,
   "end": 688.31,
   "text": "کل صانع شی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 688.31,
   "end": 690.63,
   "text": "کن سا-- کل صانع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 690.63,
   "end": 694.27,
   "text": "شیء. همه اونایی که یک چیزی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 694.27,
   "end": 697.43,
   "text": "می‌سازن. کل صانع شیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 697.43,
   "end": 699.81,
   "text": "فمن شیء صنع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 699.81,
   "end": 702.69,
   "text": "از یه چیزی، چیزی رو می‌سازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 702.69,
   "end": 705.37,
   "text": "از هیچی که چیزی نمی‌سازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 705.37,
   "end": 707.29,
   "text": "یه ابزاری دارن، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 707.29,
   "end": 714.55,
   "text": "ماده اولیه‌ای دارن، اون مواد رو با هم مخلوط می‌کنن، ترکیب می‌کنن، یه کارایی می‌کنن، یه چیزی جدیدی می‌سازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 714.55,
   "end": 718.09,
   "text": "درسته؟ والله خ-- حالا خدا چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 718.09,
   "end": 720.75,
   "text": "خدا چجوری؟ چه صانعیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 720.75,
   "end": 725.17,
   "text": "خیلی شیرینه این فرمایش. که یه در یک روایتی دیدم در تفسیر اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 725.17,
   "end": 727.55,
   "text": "تکان‌دهنده‌ست. اینا رو آدم بشنید، بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 727.55,
   "end": 730.53,
   "text": "تو مسیر توحید اگه نشنوی اینا رو مشرک میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 730.53,
   "end": 733.85,
   "text": "حضرت فرمود: کافره اگر کسی این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 733.85,
   "end": 736.72,
   "text": "ندونه خب ببینیم کافریم یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 736.72,
   "end": 738.72,
   "text": "چی رو؟ والله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 738.72,
   "end": 741.76,
   "text": "لا من شيء صنعه ما خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 741.76,
   "end": 744.62,
   "text": "اونچه که خدا خلق میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 744.62,
   "end": 749.48,
   "text": "لا من شيء صنعه از چیزی نمی‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 749.48,
   "end": 754.82,
   "text": "یعنی ماده اولیه‌ای وجود نداره شما بگی خدا ماها رو از اون ماده اولیه ساخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 754.82,
   "end": 758.94,
   "text": "اصلا همچین چیزی نیست. خدا هر چیزی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 758.94,
   "end": 763.26,
   "text": "از هیچ ساخت. اصلا تصورش برای ما مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 763.26,
   "end": 766.08,
   "text": "از کتم عدم ساخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 766.08,
   "end": 767.8,
   "text": "این فقط کار خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 767.8,
   "end": 770.0,
   "text": "الله اکبر! خدا شاهده من یه لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 770.0,
   "end": 774.02,
   "text": "تنم لرزید گفتم. از کتم عدم وجود بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 774.02,
   "end": 778.78,
   "text": "شوخیه مگه؟ یه ذره رو این فکر کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 778.78,
   "end": 784.9,
   "text": "اگه مخمون هنگ نکرد. انسان از تین آفریده پس اون چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 784.9,
   "end": 786.78,
   "text": "خب خود تین رو از کجا آفریده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 786.78,
   "end": 792.8,
   "text": "تین که می‌گیم ولی انسان از تین آفریده چون برای هر چیزی رو به نوبته هم می‌آفریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 792.8,
   "end": 795.94,
   "text": "خب حالا یه جواب فلسفی به شما بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 795.94,
   "end": 799.44,
   "text": "شما الان طور الانت اون موقع بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 799.44,
   "end": 805.8,
   "text": "همین طوری که الان هستی. از صلب پدرت، رحم پاک مادرت نبودی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 805.8,
   "end": 807.58,
   "text": "پس از کتم عدم آفریده شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 807.58,
   "end": 811.56,
   "text": "باز این یک معنای فلسفیه. یعنی این طور الان شما قبلا عدم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 811.56,
   "end": 816.46,
   "text": "معدوم بود. نبود. الان اینه و همین الان شما همینطور هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 816.46,
   "end": 820.4,
   "text": "همین الان شما اگر حضرت حق کل یوم هو فی شأن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 820.4,
   "end": 824.6,
   "text": "یوم ظرف ظهوره. خدا در آن فهم داره در شما ظهور میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 824.6,
   "end": 828.04,
   "text": "همین آن شما اون حالت قبلیت رو نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 828.04,
   "end": 832.88,
   "text": "اون رفت و الان یه حالت تجلی جدید خدا در شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 832.88,
   "end": 836.1,
   "text": "اسماء و صفات خدا در شما داره تجلی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 836.1,
   "end": 838.78,
   "text": "پس این همون کتم عدم. یکی از معانی کتم عدمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 838.78,
   "end": 842.16,
   "text": "خوب شد آقا سعید گفت از جهت فلسفی این رو هم بدونین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 842.16,
   "end": 844.52,
   "text": "حالا بعضیا شاید اشکال کنن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 844.52,
   "end": 847.74,
   "text": "محال عقل-- اصلا محال عقلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 847.74,
   "end": 849.86,
   "text": "که هیچ بشه هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 849.86,
   "end": 855.8,
   "text": "هستی بشه هیچ. بله درست میگی ولی این فرمایش آقا سعید که گفتن این بحث ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 855.8,
   "end": 860.6,
   "text": "تکمیل کرد. اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 860.6,
   "end": 862.66,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 862.66,
   "end": 869.48,
   "text": "صلوات. اللهم صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}