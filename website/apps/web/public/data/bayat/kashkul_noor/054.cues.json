   "start": 433.59,
   "end": 453.71
  },
  {
   "index": 7,
   "title": "## ختم کلام",
   "start": 453.71,
   "end": 596.53
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.32,
   "end": 2.72,
   "text": "الحمد لله رب محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.72,
   "end": 5.84,
   "text": "و آل محمد وأجعل حياتنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.84,
   "end": 9.54,
   "text": "بسم الله الرحمن الرحيم وبه نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.54,
   "end": 15.38,
   "text": "السلام علیک یا داعی الله و ربانی آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.38,
   "end": 18.58,
   "text": "سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.58,
   "end": 25.66,
   "text": "در آیه صد و هفت سوره حضرت یونس علی النبي و آله و عليه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.66,
   "end": 28.42,
   "text": "می فرماید: \"و إن یمسسک الله بضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.42,
   "end": 32.12,
   "text": "فلا كاشف له إلا هو\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.12,
   "end": 36.16,
   "text": "اگه خدا به تو بخواد زیانی برسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.16,
   "end": 39.14,
   "text": "هیچکس نمی‌تونه اونو برطرف کنه مگر خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.14,
   "end": 45.02,
   "text": "إلا هو. \"و إن يردک بخیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.02,
   "end": 47.36,
   "text": "فلا راد لفضله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.36,
   "end": 51.32,
   "text": "اگرم بخواد که به تو خیری رو برسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.32,
   "end": 54.48,
   "text": "هیچ کسی احدی نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.48,
   "end": 56.54,
   "text": "این فضل الهی رو رد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.54,
   "end": 62.56,
   "text": "\"یصیب به من یشاء من عباده\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.56,
   "end": 68.42,
   "text": "و به هر کدوم از بندگانش که بخواد این رو می‌رسونه، اصابت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.42,
   "end": 72.1,
   "text": "\"و هو الغفور الرحیم\". قطعاً این ذیل اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.1,
   "end": 78.48,
   "text": "الغفور و الرحیم خدا تعریف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.48,
   "end": 85.36,
   "text": "جالبه که حالا در کافی جلد شش صفحه سیصد و هشتاد و هشت از امام صادق صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.36,
   "end": 90.44,
   "text": "روایت دیدم که البردو اونجا که می‌فرماید: \"یصیب به من یشاء من عباده\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.44,
   "end": 92.62,
   "text": "به هرکی بخواد اصابت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.62,
   "end": 96.26,
   "text": "این رو امام صادق صلوات الله علیه به تگرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.26,
   "end": 100.34,
   "text": "تعبیر کردن. این \"یصیب به من یشاء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.34,
   "end": 102.74,
   "text": "فرمودن: البردو لا یؤکل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.74,
   "end": 107.56,
   "text": "لا یؤکل تگرگ خوردنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.56,
   "end": 112.12,
   "text": "لأن الله عز وجل يقول: \"یصیب به من یشاء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.12,
   "end": 115.14,
   "text": "اصابت می‌کنه به هرکی که بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.14,
   "end": 120.94,
   "text": "اونجا تعبیر کردن به این. حالا نکته‌ای که هست-- چند تا نکته عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.94,
   "end": 123.68,
   "text": "یکی اینکه اگر دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.68,
   "end": 127.5,
   "text": "تو برطرف کردن ضر و پریشانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.5,
   "end": 131.96,
   "text": "پروردگار سبحان تعبیر إلا هو رو میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.96,
   "end": 135.04,
   "text": "و یعنی \"یمسسک الله بضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.04,
   "end": 138.7,
   "text": "فلا كاشف له إلا هو\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.7,
   "end": 146.54,
   "text": "اما تو برطرف کردن و برداشتن فضل خدا یا خیر خدا اصلاً همچین حرفی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.54,
   "end": 152.68,
   "text": "چرا؟ مفسرین فرمودن که این رحمت وسیع خدا رو می‌رسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.68,
   "end": 157.32,
   "text": "که خدا دوست داره پریشونی رو از بندگانش برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.32,
   "end": 163.12,
   "text": "و خدا برمی‌داره. اما در خصوص خیرش و فضلاش نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.12,
   "end": 164.96,
   "text": "خدا برای چی خیرش رو برداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.96,
   "end": 167.44,
   "text": "برای چی فضلاش رو قطع کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.44,
   "end": 170.24,
   "text": "مگر خود اعمال بنده باعث بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.24,
   "end": 173.28,
   "text": "لذا اینجا دیگه إلا هو رو نمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.28,
   "end": 176.08,
   "text": "در خصوص \"و إن يردک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.08,
   "end": 179.28,
   "text": "بخیر فلا راد لفضله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.28,
   "end": 183.0,
   "text": "این رو، اون تعبیر رو نمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.0,
   "end": 186.34,
   "text": "که آیه هم داریم \"أن الله لا یغیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.34,
   "end": 190.78,
   "text": "ما بقوم حتى یغیروا ما بأنفسهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.78,
   "end": 193.02,
   "text": "احوالات بندگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.02,
   "end": 197.0,
   "text": "تا عوض نشه، اون مقدرات الهی هم تغییر نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.0,
   "end": 204.56,
   "text": "همش بسته به اعمال خودشه. پس اگر خیر و فضل الهی از کسی برداشته شد خودش رو سرزنش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.56,
   "end": 208.44,
   "text": "ربطی به خدا نداره. اتفاقا بنده دائم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.44,
   "end": 213.22,
   "text": "پروردگار سبحان نسبت به بنده‌ش دائم الفضل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.22,
   "end": 216.5,
   "text": "یا دائم الفضل علی البریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.5,
   "end": 221.42,
   "text": "نکته دیگه اینکه اگر دقت بفرمایید در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.42,
   "end": 225.08,
   "text": "پریشانی و ضر لفظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.08,
   "end": 227.92,
   "text": "یمسسک رو آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.92,
   "end": 231.26,
   "text": "در خصوص خیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.26,
   "end": 236.38,
   "text": "یردک رو آورده. یردک از اراده میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.38,
   "end": 239.98,
   "text": "یمسسک از مس میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.98,
   "end": 243.52,
   "text": "برخورد دو چیز با هم. مس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.52,
   "end": 247.22,
   "text": "اراده مثل \"إنما یرید الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 247.22,
   "end": 250.76,
   "text": "لیهدم\". این اراده قطعی خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.76,
   "end": 256.08,
   "text": "اصلاً اراده قطعی خدا به اینه که دائماً به بندگانش خیر برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.08,
   "end": 258.18,
   "text": "لذا در خصوص خیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.18,
   "end": 260.44,
   "text": "از لفظ یردک استفاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.44,
   "end": 263.46,
   "text": "\"و إن یردک بخیر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.46,
   "end": 266.4,
   "text": "در خصوص ضر و پریشانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.4,
   "end": 270.14,
   "text": "از لفظ لم و إن یمسسک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.14,
   "end": 274.38,
   "text": "مس، مس کردن. یعنی اینکه کلمه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.38,
   "end": 278.46,
   "text": "عارض میشه. عارضیه، از بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.46,
   "end": 282.92,
   "text": "حواست باشه و الا از درون خودت خیر می‌جوشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 282.92,
   "end": 285.32,
   "text": "اصلاً خدا تو رو به وظن خودش آفریده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.32,
   "end": 287.94,
   "text": "چرا خیر از درون تو نجوشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 287.94,
   "end": 290.3,
   "text": "نکته دیگر که قابل تامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.3,
   "end": 293.5,
   "text": "فرمود: \"فلا راد لفضله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.5,
   "end": 298.36,
   "text": "خیر رو اینجا خیررسانی خدا به بندگانش رو بر اساس فضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 298.36,
   "end": 301.62,
   "text": "اسم الفاضل حضرت حق می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 301.62,
   "end": 305.22,
   "text": "فضل جایی پیاده میشه که بنده استحقاقش رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.22,
   "end": 308.16,
   "text": "یعنی اصلاً ربطی به بنده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.16,
   "end": 311.18,
   "text": "مستقیماً کرم حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.18,
   "end": 315.16,
   "text": "خدا فاضله از حیث اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.16,
   "end": 318.96,
   "text": "به بندگانش می‌بخشه به غیر استحقاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 318.96,
   "end": 321.04,
   "text": "خیلی شیرینه، خیلی عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 321.04,
   "end": 326.78,
   "text": "یعنی اگر خدا بخواد به استحقاق بنده و امثال من نگاه کنه که باید اصلاً خیرش رو قطع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 326.78,
   "end": 331.44,
   "text": "اما به کرم خودش، به جود و بخشش خودش نگاه می‌کنه و می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 331.44,
   "end": 335.96,
   "text": "اینم یه نکته. یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.96,
   "end": 338.86,
   "text": "روایتی هست که من خیلی از این بهره بردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 338.86,
   "end": 342.68,
   "text": "عزیزم که مسجد بلال چهارشنبه‌ها میام اونجا خدمتشون تقدیم کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 342.68,
   "end": 346.9,
   "text": "در کتاب کافی جلد دو صفحه پانصد و پنجاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 346.9,
   "end": 350.12,
   "text": "و یک از امام صادق صلوات الله علیه این روایت رو آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 350.12,
   "end": 352.42,
   "text": "کسایی که می‌خوان انشاالله رزقشون زیاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 352.42,
   "end": 354.88,
   "text": "چون بحث اسم الفاضل حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.88,
   "end": 362.74,
   "text": "و فضل الهی شد که مستقیماً هم فضل خدا با ولایت کلیه الهی یعنی با آل الله مرتبطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 362.74,
   "end": 366.57,
   "text": "فضل خدا شامل شده که سایه اونا سر ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 366.57,
   "end": 371.55,
   "text": "یه روایتی رو اینجا امام صادق صلوات الله عليه میارن میفرمایند که برای طلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.55,
   "end": 375.33,
   "text": "روزی در سجده نماز واجب این ذکر رو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.33,
   "end": 380.75,
   "text": "خیلی تاثیر داره خیلی. \"یا خیر المسؤولین\" خیلی هم شیرینه ذکرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.75,
   "end": 383.11,
   "text": "ای بهترین سؤال شده‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.11,
   "end": 386.17,
   "text": "و \"یا خیر المعطین\" بهترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 386.17,
   "end": 390.51,
   "text": "عطا کننده. خب حالا من چی می‌خوام؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 390.51,
   "end": 396.19,
   "text": "\"ارزقنی\" نه فقط خودم رو رزق بدی \"وارزق عیالی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 396.19,
   "end": 400.75,
   "text": "وارزق عیالی\" هر کسی هم که تعلق به من داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 400.75,
   "end": 405.13,
   "text": "و روزیش در، بر گردن منه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.13,
   "end": 409.83,
   "text": "در حقیقت تحت تکفل منه به او هم \"من فضلك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.83,
   "end": 414.35,
   "text": "از فضلت روزی بده. \"فإنك ذو الفضل العظیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.35,
   "end": 417.87,
   "text": "به درستی که تو دارای فضل عظیمی هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 417.87,
   "end": 422.59,
   "text": "اینو یاد بگیریم. این دعا رو در سجده نمازهای واجبمون اون سجده آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.59,
   "end": 428.19,
   "text": "از حضرت فرمودن انجام بدیم. و خیلی حواسمون جمع باشه به اینکه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.19,
   "end": 430.75,
   "text": "سبب و اسباب و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 430.75,
   "end": 433.59,
   "text": "\"لا مؤثر فی الوجود إلا الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 433.59,
   "end": 436.03,
   "text": "خدا رحمت کنه آقای قاضی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 436.03,
   "end": 438.47,
   "text": "شاگرد بلا فصلشون آقای حداد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 438.47,
   "end": 442.89,
   "text": "می‌فرمودن همیشه تو درس و بحث‌هاشون آقای قاضی این جمله رو می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 442.89,
   "end": 446.09,
   "text": "\"الاسباب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.09,
   "end": 448.55,
   "text": "حجب علی الاغلب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 448.55,
   "end": 452.05,
   "text": "این اسباب که بهش توجه می‌کنیما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.05,
   "end": 453.99,
   "text": "برای اغلب مردم حجاب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 453.99,
   "end": 457.83,
   "text": "\"و انما نافع و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 457.83,
   "end": 463.07,
   "text": "ضار قطعاً منحصراً\" بدون برو برگشت فقط و فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 463.07,
   "end": 466.03,
   "text": "انما حصر دیگه. فقط و فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 466.03,
   "end": 468.09,
   "text": "منفعت و ضرر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 468.09,
   "end": 471.65,
   "text": "خب \"الله جل جلاله\" از سمت و ناحیه حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 471.65,
   "end": 474.29,
   "text": "یعنی همه کارهای عالم اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 474.29,
   "end": 476.83,
   "text": "یعنی نهایت توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 476.83,
   "end": 480.61,
   "text": "خدا رحمت کنه آقای حداد خاطره‌ای که از آقای قاضی میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.61,
   "end": 482.73,
   "text": "که میگن که شاید شنیده باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 482.73,
   "end": 487.05,
   "text": "می‌رفتن از نجف سمت کوفه سوار یه حلاق ساده‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 487.05,
   "end": 490.11,
   "text": "بعد بارون شدید و رعد و برق می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 490.11,
   "end": 492.73,
   "text": "گرداب همه جا رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 492.73,
   "end": 497.25,
   "text": "خلاصه آب راه می‌فته. سیلاب وحشتناکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 497.25,
   "end": 499.21,
   "text": "طوری که دیگه نمی‌تونن حرکت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 499.21,
   "end": 501.95,
   "text": "این شاگرد آقای قاضی میگه باید پناه ببریم به خونه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 501.95,
   "end": 506.99,
   "text": "خیلی خطرناک شده اینا. آقای قاضی می‌فرما پناه به خونه‌ها، به مردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 506.99,
   "end": 509.67,
   "text": "ما پناهگاهی جز حضرت حق نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 509.67,
   "end": 512.33,
   "text": "و عباشونو از دوششون میندازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 512.33,
   "end": 514.67,
   "text": "بلند میشن دست بلند می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 514.67,
   "end": 522.37,
   "text": "و یه دعای زیبایی رو می‌خونن که \"یا دافع البری عن ایوب ادفع عنک البر فإنك أنت القادر المطلب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 522.37,
   "end": 524.59,
   "text": "بلافاصله اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 524.59,
   "end": 528.33,
   "text": "سیلاب فروکش می‌کنه و اون رعد و برق و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 528.33,
   "end": 531.03,
   "text": "از بین میره و به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 531.03,
   "end": 534.49,
   "text": "بارش باران قطع میشه و ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 534.49,
   "end": 536.55,
   "text": "خیلی تعجب می‌کنه شاگرد ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 536.55,
   "end": 539.85,
   "text": "بعد که سیلاب فروکش می‌کنه این جمله آقای قاضیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 539.85,
   "end": 542.51,
   "text": "ختام الخطاب جلسه امروزمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 542.51,
   "end": 546.81,
   "text": "خیلی شیرینه. می‌فرمایند ما اگر چشم دل‌مان باز شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 546.81,
   "end": 549.55,
   "text": "این رو ببینید کی بوده آقای قاضی، کی از دنیا رفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 549.55,
   "end": 552.29,
   "text": "امروز داره به شما، به من و شما میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 552.29,
   "end": 554.75,
   "text": "ما پای درس ایشون امروز نشستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 554.75,
   "end": 557.35,
   "text": "اگر چشم دل‌مان باز شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 557.35,
   "end": 560.09,
   "text": "در می‌یابیم که هر بلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 560.09,
   "end": 562.71,
   "text": "نوری در لباس آزمایش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 562.71,
   "end": 565.03,
   "text": "هر بلا نوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 565.03,
   "end": 567.11,
   "text": "در لباس آزمایش است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 567.11,
   "end": 570.77,
   "text": "و هر دفع ضرری از جانب اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 570.77,
   "end": 574.07,
   "text": "پس جز به خدا نگاه کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 574.07,
   "end": 576.27,
   "text": "راهی به امن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 576.27,
   "end": 579.55,
   "text": "ندارد. تنها امن ما و امان ما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 579.55,
   "end": 583.83,
   "text": "نگاه کردن به دست با-باسط الیدینی حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 583.83,
   "end": 587.91,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 587.91,
   "end": 590.07,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 590.07,
   "end": 596.53,
   "text": "صلوات الله على محمد و آله الطاهرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}