 "chapters": [
  {
   "index": 0,
   "title": "## آرامش کجاست؟ اطمینان و ذکر الله",
   "start": 20.62,
   "end": 46.48
  },
  {
   "index": 1,
   "title": "## ذکر مرتبهٔ قلبی است نه خیالی و نه عقلیِ صرف",
   "start": 46.48,
   "end": 300.04
  },
  {
   "index": 2,
   "title": "### چینش مراتب: طبیعت، ملکوت، جبروت، قلب",
   "start": 300.04,
   "end": 384.31
  },
  {
   "index": 3,
   "title": "## تا به قلب نرسی آرامش نیست",
   "start": 384.31,
   "end": 481.29
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.16,
   "end": 9.3,
   "text": "تمت. بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.3,
   "end": 13.3,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.3,
   "end": 19.82,
   "text": "آیاته. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.82,
   "end": 23.54,
   "text": "خیلی پیش‌تر از این‌ها ما پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.54,
   "end": 28.8,
   "text": "تهجد و بیداری سحر سخن گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.8,
   "end": 33.66,
   "text": "و ادامه‌ی اون بحث رو که حالا از بحث تهجد و این‌ها بگذریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.66,
   "end": 36.54,
   "text": "با آرامش ادامه بدیم که یکی از جاهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.54,
   "end": 40.18,
   "text": "به وعده‌ی قرآن آرامش هست سحره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.18,
   "end": 42.22,
   "text": "حالا یه سؤال جدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.22,
   "end": 46.48,
   "text": "مطرحه امروزه برای همه چون گم‌شده‌ی همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.48,
   "end": 49.3,
   "text": "اتفاقاً پیش از نماز هم با همکارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.3,
   "end": 52.14,
   "text": "صحبت می‌کردیم که آرامش کجا پیدا می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.14,
   "end": 54.9,
   "text": "اصلاً آرامش کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.9,
   "end": 57.48,
   "text": "چرا غالباً آرامش ندارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.48,
   "end": 60.56,
   "text": "مضطربن، پریش احوالن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.56,
   "end": 63.2,
   "text": "درب و داغونن، به هم ریختن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.2,
   "end": 67.12,
   "text": "لجام گسیختن، هر جا میرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.12,
   "end": 71.0,
   "text": "انگار گم‌شدشونو پیدا نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.0,
   "end": 77.72,
   "text": "آرامش کجاست؟ خب، اون کتابی که از سمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.72,
   "end": 82.34,
   "text": "جان؟ آرامش با نصفه. یک جایی که قرآن فرموده بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.34,
   "end": 85.34,
   "text": "اما چگونه نصفوانی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.34,
   "end": 87.8,
   "text": "اینا همش باید ب-- چگونه سهری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.8,
   "end": 89.96,
   "text": "چگونه نمازی؟ چگونه ایمانی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.96,
   "end": 93.7,
   "text": "چگونه ذکری؟ ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.7,
   "end": 96.72,
   "text": "با قرآن پیش بریم دیگه خیالمون راحته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.72,
   "end": 102.9,
   "text": "کتابی که از سمت حضرت حق اومده برای هدایت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.9,
   "end": 110.48,
   "text": "قرآن مرتبه‌ی آرامش رو که با دیگه اوج خودش مرتبه‌ی اطمینان بیان می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.48,
   "end": 115.44,
   "text": "کسی که به اطمینان رسید دیگه قطعاً آرامش همراه او هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.44,
   "end": 118.16,
   "text": "کجا بیان می‌کنه اطمینان رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.16,
   "end": 121.48,
   "text": "ألا یه هشداری میده احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.48,
   "end": 123.72,
   "text": "هشداریه به قول علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.72,
   "end": 127.2,
   "text": "ألا بذكر الله تطمئن القلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.2,
   "end": 130.76,
   "text": "همه‌ی مفسرین فرمودن این معناش این نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.76,
   "end": 134.04,
   "text": "یکی از چیزایی که ما رو به اطمینان میرسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.04,
   "end": 137.08,
   "text": "میرسونه ذکر اللهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.08,
   "end": 145.76,
   "text": "بلکه فقط و فقط معناش اینه فقط و فقط آگاه باشید که اطمینان با ذکر الله حاصل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.76,
   "end": 147.96,
   "text": "ألا بذكر الله تطمئن القلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.96,
   "end": 152.68,
   "text": "حالا این باید بحث بشه. اولاً ذکر به چی میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.68,
   "end": 157.14,
   "text": "ثانیا چه ذکری؟ ذکر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.14,
   "end": 160.14,
   "text": "حالا مرتبه‌ی ذکر اصلاً کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.14,
   "end": 163.72,
   "text": "الان من یه تسبیح دستم بگیرم شروع کنم همینطوری لبم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.72,
   "end": 166.5,
   "text": "بجنبونم این ذکره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.5,
   "end": 170.9,
   "text": "این خیلی خودمو تحویل بگیرم بشه ورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 170.9,
   "end": 175.1,
   "text": "ذکر مرتبه‌ی قلبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.1,
   "end": 177.06,
   "text": "یعنی مرتبه‌ی خیالی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.06,
   "end": 179.44,
   "text": "مرتبه‌ی عقلی هم حتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 179.44,
   "end": 183.28,
   "text": "مرتبه‌ی قلبیه. این در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.28,
   "end": 188.62,
   "text": "اون معجزه‌ی قولیه‌ی امیرالمؤمنین علیه الصلاة والسلام که حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.62,
   "end": 192.4,
   "text": "عذکریم صد وجهش رو بیان کردن تو کتابشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 192.4,
   "end": 198.52,
   "text": "اونجا حاصل می‌شه فهمش که من عرف حدیث من عرف من عرف نفسه فقد عرف ربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.52,
   "end": 202.4,
   "text": "انسان در سیر معرفت نفس به اینجا می‌رسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.4,
   "end": 209.12,
   "text": "ابعاد متعددی داره، ذو مراتبه، رتبه‌های متعدد الا ما شاء الله تو پشت سر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.12,
   "end": 211.96,
   "text": "کشیده شده از زمین تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.96,
   "end": 215.34,
   "text": "آسمان، از فرش تا عرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.34,
   "end": 220.3,
   "text": "از بدنش که عرض بد-- عرض وجودشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.3,
   "end": 222.78,
   "text": "العرض وجودشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.78,
   "end": 228.46,
   "text": "تا عرش الهی تا عالم اع-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.46,
   "end": 231.18,
   "text": "می‌شه گفت جلوه‌ی اعلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.18,
   "end": 235.46,
   "text": "سماء وجودشه اونچه کشیده شده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.46,
   "end": 237.58,
   "text": "این رتبه‌های متعددی‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.58,
   "end": 240.04,
   "text": "از بدن بگیر برو تا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.04,
   "end": 243.32,
   "text": "مرتبه ذات خودش که خودش هم از خودش بی‌خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.32,
   "end": 246.68,
   "text": "اون هویتش، اون میگه آقا من اونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 246.68,
   "end": 248.6,
   "text": "هو و او. من اونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.6,
   "end": 251.5,
   "text": "نمی‌تونه تشخیص بده کیه، چیه بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 251.5,
   "end": 255.78,
   "text": "نهایتاً خودشو با آثارش می‌خواد بشناسه و معرفی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 255.78,
   "end": 258.1,
   "text": "مثل اینکه من بدن دارم. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 258.1,
   "end": 260.76,
   "text": "اثر ظاهری توئه. رتبه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 260.76,
   "end": 263.52,
   "text": "انزل مراتب رتبه‌های وجودی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 263.52,
   "end": 265.46,
   "text": "مثل اینکه میگه آقا من قوه خیال دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 265.46,
   "end": 270.16,
   "text": "با یه رتبه رفت پا-- پنهان‌تر از وجود خودش، رتبه باطنی‌تر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 270.16,
   "end": 272.4,
   "text": "قوه خیال که رتبه مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 272.4,
   "end": 275.04,
   "text": "متصله دیگه. برزخ وجودی‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 275.04,
   "end": 279.66,
   "text": "تو خودشه. جنسش همون رتبه مثالیه که بیرون از اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 279.66,
   "end": 284.98,
   "text": "چه در قوس نزول نال الله اومدیم از اونجا گذر کردیم یه سری چیزا رو یهو یادمون میاد میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 284.98,
   "end": 288.12,
   "text": "اِ این اتفاق قبلاً افتاده بود ما رو اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 288.12,
   "end": 292.3,
   "text": "عالم زهر نزولیه. چه رتبه مثالی که قراره بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 292.3,
   "end": 296.82,
   "text": "هممون بریم ارواح ما الان اونجان، ارواح رفتگانمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 296.82,
   "end": 300.04,
   "text": "خب جنس اون تو خود ما هم هست، قوه خیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.04,
   "end": 304.84,
   "text": "آیا اگر کسی خیالی ذکر بگه به آرامش می‌رسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 304.84,
   "end": 307.9,
   "text": "نه. گفتیم مرتبه، مرتبه قلبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 307.9,
   "end": 312.5,
   "text": "مرتبه قلب کجاست؟ نه که فقط مافوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.5,
   "end": 317.94,
   "text": "قوه خیال یا رتبه مثالی ما باشه، بلکه مافوق عقل ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.94,
   "end": 319.96,
   "text": "عقل مافوق قوه خیاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.96,
   "end": 323.54,
   "text": "رتبه‌ش از جهت مکانتی بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 323.54,
   "end": 327.78,
   "text": "قلب بالاتر از عقله، عقل بالاتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 327.78,
   "end": 330.46,
   "text": "قوه خیاله. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 330.46,
   "end": 337.18,
   "text": "طبق اون صحبت‌هایی که قبلاً چینش نظام و بافت نظام هستی رو عرض کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.18,
   "end": 340.88,
   "text": "مرتبه‌ی ظاهر بدن که از طبیعته، طبعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.88,
   "end": 345.02,
   "text": "بعد می‌شه م-ملکوت وجود ما که قوه خیال یا مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.02,
   "end": 349.98,
   "text": "متصل. بعد می‌شه عقل وجود ما، رتبه‌ی عقلیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 349.98,
   "end": 354.12,
   "text": "که از عالم عقول گرفته شده، جنسش جنس ملائکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.12,
   "end": 356.12,
   "text": "تحت تصرف امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 356.12,
   "end": 360.4,
   "text": "ملکوت حضرت زهرا بود. جبروت یا عقل عالم امیرالمؤمنین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.4,
   "end": 363.48,
   "text": "عالم اله تازه می‌شه عالم قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 363.48,
   "end": 368.03,
   "text": "که عرش وجود ماست. قلب المؤمن عرش الرحمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 368.03,
   "end": 374.41,
   "text": "اون عالم نبی اکرمه، عالم اسماء ظهور و جلوه‌ی اتم اسماء الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 374.41,
   "end": 376.81,
   "text": "خب چون فرصت گذشت و ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 376.81,
   "end": 380.37,
   "text": "پنج شش دقیقه مون تموم شد این بحث رو ان‌شاءالله روزای دیگه ادامه میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 380.37,
   "end": 385.83,
   "text": "بهش فکر کنید. فعلاً به این نتیجه رسیدیم امروز که طبق قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 385.83,
   "end": 388.39,
   "text": "وقتی ما به آرامش می‌رسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 388.39,
   "end": 391.03,
   "text": "که به مرحله‌ی قلبمون رسیده باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 391.03,
   "end": 393.43,
   "text": "به مرحله‌ی قلب رسیدن چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 393.43,
   "end": 397.23,
   "text": "یعنی چگونه باید از قوه خیال گذر کرد، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.23,
   "end": 399.45,
   "text": "عقل گذر کرد تا به قلب رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 399.45,
   "end": 401.91,
   "text": "اینا همه شرح و بحث داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 401.91,
   "end": 403.71,
   "text": "طبق روایات و گفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 403.71,
   "end": 410.27,
   "text": "بزرگان باید بحث بشه تا ببینیم به اونجا اصلاً رسیدیم یا نرسیدیم و گیر و گورمون کجاست و چرا نرسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 410.27,
   "end": 415.83,
   "text": "ما حتی اگر به عقلمون هم دسترسی پیدا کنیم که رتبه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 415.83,
   "end": 419.89,
   "text": "عقلی وجود ماست و جبروتیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 419.89,
   "end": 424.19,
   "text": "دست امیرالمؤمنین و این‌ها باز هم به آرامش نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 424.19,
   "end": 427.17,
   "text": "حواسمون باشه چون به قلب نرسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 427.17,
   "end": 430.69,
   "text": "آیه صریح قرآنه. دیگه اینجا فرود بیایم سر این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 430.69,
   "end": 432.89,
   "text": "آیه صد سوره یونس رو برید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 432.89,
   "end": 438.29,
   "text": "خواهش می‌کنم برید ببینید. \"و یجعل الرجس على الذین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 438.29,
   "end": 444.39,
   "text": "ما خدای منّان در این آیه می‌فرماید که آلودگی رو کجا می‌ذاریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 444.39,
   "end": 446.07,
   "text": "بر کس-- چه کسایی قرار میدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.07,
   "end": 448.81,
   "text": "\"على الذین لا يعقلون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 448.81,
   "end": 452.79,
   "text": "کسایی که عقلشون رو تعطیل کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 452.79,
   "end": 455.31,
   "text": "و دسترسی به عقل پیدا نکرده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 455.31,
   "end": 457.87,
   "text": "یعنی اگر به عقل نرسی که آلوده‌ای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 457.87,
   "end": 462.81,
   "text": "خیالی زندگی می‌کنی. به عقل هم برسی باز آرامش نداری چون به قلب نرسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 462.81,
   "end": 465.33,
   "text": "مرتبه ذکر اتفاق نیفتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 465.33,
   "end": 469.11,
   "text": "اینا همه مشکلات ماست. مشکلات اصلی ما این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 469.11,
   "end": 471.61,
   "text": "نه نوسان دلار و طلا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 471.61,
   "end": 474.97,
   "text": "اینجور چیزا. والحمد لله رب العالمين صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 474.97,
   "end": 477.71,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 477.71,
   "end": 479.69,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 479.69,
   "end": 481.29,
   "text": "محمد العجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}