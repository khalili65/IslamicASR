 },
 "chapters": [
  {
   "index": 0,
   "title": "## اعراف/۱۸۸؛ توحید افعالی",
   "start": 13.26,
   "end": 105.22
  },
  {
   "index": 1,
   "title": "## سؤال از علم غیب پیامبر",
   "start": 105.22,
   "end": 175.54
  },
  {
   "index": 2,
   "title": "## معنای سوء؛ فقر و بیماری",
   "start": 175.54,
   "end": 491.4
  },
  {
   "index": 3,
   "title": "## إلا ما شاء الله و آرامش؛ شرک خوف از غیر",
   "start": 491.4,
   "end": 551.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.78,
   "end": 3.86,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.86,
   "end": 8.32,
   "text": "السلام الیک یا داعی الله و ربانی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.32,
   "end": 13.26,
   "text": "صیح سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.26,
   "end": 19.2,
   "text": "آیه صد و هشتاد و هشت سوره اعراف هم پیرامون توحید افعالی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.2,
   "end": 23.46,
   "text": "قل لا أملك لنفسي نفعا ولا ضرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.46,
   "end": 29.12,
   "text": "به پیغمبر فرمود بگو اینو اقرار کن به دیگران هم بیان کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.12,
   "end": 32.9,
   "text": "که منم که پیغمبرم لا أملك لنفسي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.9,
   "end": 37.86,
   "text": "مالک نفس خودم نیستم چه از حیث نفع چه ضرر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.86,
   "end": 44.08,
   "text": "نفعا ولا ضرا. پیغمبر هم مالک نفس خودش از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.08,
   "end": 45.9,
   "text": "نفع و ضرر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.9,
   "end": 48.98,
   "text": "إلا ما شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.98,
   "end": 51.5,
   "text": "مگر آنچه که خدا بخواهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.5,
   "end": 60.34,
   "text": "حالا شما تصور کنید همین آیه، همین آیه، همین یه دونه آیه اگر اعتقاد قلبی کسی بشه چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.34,
   "end": 63.0,
   "text": "تمام غم و غصه هاش برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.0,
   "end": 65.58,
   "text": "تمام هم و غماش برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.58,
   "end": 69.22,
   "text": "تمام ترس و وحشت هاش برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.22,
   "end": 71.8,
   "text": "چرا میگه؟ چون إلا ما شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.8,
   "end": 75.52,
   "text": "هرچی خدا بخواد. خدا هم که حکیم علی الاطلاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.52,
   "end": 77.52,
   "text": "خدا که چیز بد نمیخواد که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.52,
   "end": 80.28,
   "text": "دائما در صلح و آشتی با بندگانشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.28,
   "end": 82.9,
   "text": "ما تجزیه تحلیل نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.9,
   "end": 84.46,
   "text": "ما ناقص هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.46,
   "end": 86.36,
   "text": "ضعیف النفس هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.36,
   "end": 88.88,
   "text": "فقط از همین پایین نگاه میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 88.88,
   "end": 91.1,
   "text": "عمق نگاهمون، افق دیدمون کوتاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 91.1,
   "end": 97.0,
   "text": "ولی از بالا که نگاه میکنی این همه چی سر جای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 97.0,
   "end": 100.76,
   "text": "إلا ما شاء الله. و لو كنت أعلم الغيب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 100.76,
   "end": 103.88,
   "text": "لاستكفرت من الخير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.88,
   "end": 107.34,
   "text": "پیغمبر اینجا می فرماید اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 107.34,
   "end": 112.38,
   "text": "چنانچه غیب می دانستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 112.38,
   "end": 116.18,
   "text": "یقینا برای خودم خیر فراوانی رو فراهم میکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.18,
   "end": 119.68,
   "text": "لاستکفرت من الخير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.68,
   "end": 124.4,
   "text": "یه خیر کثیر رو برای خودم فراهم میکردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 124.4,
   "end": 126.32,
   "text": "اگر علم غیب به غیب داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 126.32,
   "end": 130.26,
   "text": "حالا الان اینجا سؤال پیش میاد واقعا پیغمبر علم به غیب نداشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 130.26,
   "end": 133.32,
   "text": "الان من و شما علم به غیب داریم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.32,
   "end": 137.2,
   "text": "آیا ملائکه غیب هستن؟ بهشت و جهنم غیب هستن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 137.2,
   "end": 139.2,
   "text": "خود حضرت حق غیب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 139.2,
   "end": 142.34,
   "text": "ما علم به این‌ها نداریم؟ داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 142.34,
   "end": 145.38,
   "text": "حتی يؤمنون بالغیب بالاتر از علمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 145.38,
   "end": 151.12,
   "text": "ایمانه. تعلق قلبیه، گرایش قلبیه به غیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 151.12,
   "end": 152.8,
   "text": "از خصوصیات اهل ایمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 152.8,
   "end": 155.74,
   "text": "پس چگونه اینجا پیغمبر می فرمایند من علم به غیب ندارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 155.74,
   "end": 159.3,
   "text": "حالا الان خدمتتون عرض می‌کنم آیه رو تموم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 159.3,
   "end": 166.48,
   "text": "و ما مسني السوء. که اگر من علم غیب داشتم و لو كنت أعلم الغيب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 166.48,
   "end": 172.7,
   "text": "ما مسني السوء هیچ سوئی هم اصابت نمیکرد و منو مس نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 172.7,
   "end": 176.92,
   "text": "اگه علم به غیب داشتم. حالا باید دید این سوء چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 176.92,
   "end": 179.08,
   "text": "میرسیم بهش. إن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 179.08,
   "end": 182.06,
   "text": "أنا إلا من نیستم مگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 182.06,
   "end": 186.0,
   "text": "نذير وبشير لقوم يؤمنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 186.0,
   "end": 190.38,
   "text": "من بشارت دهنده و ترساننده ام برای کسایی که اهل ایمانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 190.38,
   "end": 192.4,
   "text": "اونایی که دل دادن. من اینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 192.4,
   "end": 197.6,
   "text": "بیشتر از این نیستم. حالا اینجا اولا سؤال پیش میاد که بالاخره چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 197.6,
   "end": 201.64,
   "text": "پیغمبر غیب می‌داند یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 201.64,
   "end": 205.92,
   "text": "اون مفاتح، مفاتح غیب که هست، کلیدهای غیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 205.92,
   "end": 208.46,
   "text": "توی نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 208.46,
   "end": 213.68,
   "text": "قفیله می‌خونید. لا يعلمها إلا هو هیچ کس نمیدونه جز او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 213.68,
   "end": 217.78,
   "text": "وعنده مفاتح الغيب لا يعلمها إلا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 217.78,
   "end": 219.56,
   "text": "کلیدهای غیب دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 219.56,
   "end": 223.46,
   "text": "هیچکس جز او نمیدونه. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 223.46,
   "end": 229.24,
   "text": "پیغمبر عزیز عالم، امام صادق صلوات الله عليه که می فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 229.24,
   "end": 233.16,
   "text": "تمام عوالم هستی، کائنات مثل یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 233.16,
   "end": 234.88,
   "text": "نگین‌اند در کف دست ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 234.88,
   "end": 239.56,
   "text": "یه همچین است-- استیلا و استوایی داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 239.56,
   "end": 243.6,
   "text": "تسلطی داریم، احاطه داریم بر همه عوالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 243.6,
   "end": 247.28,
   "text": "این چیه؟ اگر علمشو ندارن چگونه احاطه دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 247.28,
   "end": 250.7,
   "text": "احاطه یعنی علم. أحاط بكل شيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 250.7,
   "end": 253.28,
   "text": "بكل یعنی به تار و پود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.28,
   "end": 254.88,
   "text": "على كل شيء نفرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 254.88,
   "end": 257.86,
   "text": "أحاط بكل شيء. این بكل شيء یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 257.86,
   "end": 264.04,
   "text": "به قول حضرت استاد یعنی احاطه به تار و پود همه اشیا داره حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 264.04,
   "end": 270.54,
   "text": "او هم که الله که مستجمع جميع صفات الهیه درش پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 270.54,
   "end": 275.22,
   "text": "آیا اسم العلیم حضرت حق در الله هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 275.22,
   "end": 278.92,
   "text": "الله اسم جامع. پس اسم علیم هم درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 278.92,
   "end": 283.1,
   "text": "پس در پیغمبر العلیم پیاده شده به قدر طاقت بشری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 283.1,
   "end": 286.38,
   "text": "به قدر طاقت امکانی پیغمبر علم خدا درش پیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.38,
   "end": 289.3,
   "text": "پس چگونه میگه من علم به غیب ندارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 289.3,
   "end": 292.22,
   "text": "این منظور اینه که این ذاتی نیست، مال خودم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 292.22,
   "end": 295.12,
   "text": "منظور اینه. یعنی اینو از من نگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 295.12,
   "end": 298.18,
   "text": "اونم خدا داده. میخواد توحید افعالی رو برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 298.18,
   "end": 303.64,
   "text": "میگه علمی هم که من دارم، این علم به غیب من مال خودم نیست که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 303.64,
   "end": 305.58,
   "text": "خدا به من داده. منظورش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 305.58,
   "end": 310.88,
   "text": "لذا اون بالا هم فرمود إلا ما شاء الله مگر که خدا بخواهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 310.88,
   "end": 316.58,
   "text": "تو یه روایتی در تفسیر اهل بیت ذیل همین آیه دیدم که می فرمودن وقتی از امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 316.58,
   "end": 319.88,
   "text": "از امام صادق صلوات الله عليه پرسیدن شما علم به غیب میدونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 319.88,
   "end": 324.68,
   "text": "حضرت فرمود دست بکش به بدنم ببین موهام چجوری به تنم سیخ شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 324.68,
   "end": 330.02,
   "text": "از این حرف سنگینت. اینها، این قبیل روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 330.02,
   "end": 332.0,
   "text": "چون در تقیه بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 332.0,
   "end": 336.22,
   "text": "میکشتن اهل بیتو اگه ادعای علم به غیب میکردن اونا رو میکشتن واقعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 336.22,
   "end": 344.16,
   "text": "در یک خفقانی بودن. خیار فروش بود سؤال شرعی داشت راه افتاده بود داد میزد کی خیار میخره از بغل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 344.16,
   "end": 347.72,
   "text": "خونه امام صادق. امام صادق میومد بیرون تو که خیارها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 347.72,
   "end": 349.46,
   "text": "سوامی کرد سؤالشو جواب داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 349.46,
   "end": 353.94,
   "text": "اینطوری در خفقان بودن. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.94,
   "end": 355.8,
   "text": "بیاد بگه من علم به غیب دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 355.8,
   "end": 360.58,
   "text": "منظور، منظور از این منطوق مخصوصا در این آیه اینه که خودشون فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 360.58,
   "end": 367.74,
   "text": "علم به غیب به اون معنا در-نداریم که از ابتدا تا انتها از اول تا آخر همش پیش ما بوده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 367.74,
   "end": 374.34,
   "text": "هر وقت اراده کنیم عمودی از نور از بالا کشیده شده از عرش الهی تا مقابل ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 374.34,
   "end": 379.02,
   "text": "ما هر وقت اراده کنیم به اون عمود نگاه می‌کنیم و عالم میشیم به اون علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.02,
   "end": 381.92,
   "text": "یعنی در خدمت ماست، در اختیار ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 381.92,
   "end": 384.6,
   "text": "اما هر وقتی اجازه نداریم ازش استفاده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 384.6,
   "end": 386.76,
   "text": "به قول آقای قراختی می‌فرمود مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 386.76,
   "end": 389.3,
   "text": "پاسبانی که هفت تیر بسته کنارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 389.3,
   "end": 392.54,
   "text": "حق نداره هر جایی از این هفت تیر استفاده کنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 392.54,
   "end": 395.06,
   "text": "اذنش باید باشه. این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 395.06,
   "end": 400.86,
   "text": "علم رو داره اما هر جایی ازش استفاده-- یا به یک معنا میشه بهش توجه نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 400.86,
   "end": 403.62,
   "text": "این یک نکته. نکته بعد اون سوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 403.62,
   "end": 410.56,
   "text": "سو چیه؟ که پیغمبر می‌فرماید خب بله اگر من علم به غیب داشتم یعنی اگه مال خودم بود، دست خودم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 410.56,
   "end": 413.1,
   "text": "خودم، خودم بودم و خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 413.1,
   "end": 416.74,
   "text": "خودم بودم و خودم نه بگیم خداست و خدایی می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 416.74,
   "end": 420.68,
   "text": "خودم بودم و خودم همه خیرات رو برای خودم جمع می‌کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 420.68,
   "end": 426.12,
   "text": "و از همه سوء‌ها فرار، فراری می‌جستم و اصلاً هیچ سوی منو مست نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 426.12,
   "end": 429.68,
   "text": "حالا این سو چیه؟ در تفسیر اهل بیت جلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 429.68,
   "end": 436.08,
   "text": "پنج صفحه چهارصد و چهل از امام صادق صلوات الله علیه فرمود از سو یعنی عن الفقر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.08,
   "end": 439.04,
   "text": "یعنی فقر رو از خودم دور می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.04,
   "end": 441.16,
   "text": "پس باز علمش دست من نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 441.16,
   "end": 445.14,
   "text": "دست خداست. هر آینه که او بخواهد به من می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.14,
   "end": 448.64,
   "text": "در یک روایتی در نور الثقلین و تفسیر برهان ذیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 448.64,
   "end": 454.22,
   "text": "همین آیه صد و هشتاد و هشت اعراف از علی ابن ابراهیم قمی روایت شده که قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.22,
   "end": 459.7,
   "text": "پیغمبر فرمود کنتو أختار لنفس الصحة والسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 459.7,
   "end": 462.32,
   "text": "اگه من اون علم غیبی که شما می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.32,
   "end": 466.48,
   "text": "خودم داشتم و خودم به خودیت خودم این علم رو داشتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 466.48,
   "end": 470.52,
   "text": "خودم رو می‌رسوندم نفسم رو، جانم رو به صحت و سلامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 470.52,
   "end": 472.34,
   "text": "یعنی اصلاً هیچ وقت مریض نمی‌شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 472.34,
   "end": 474.28,
   "text": "در حالی که پیغمبر هم مریض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 474.28,
   "end": 476.36,
   "text": "تب-- مریضی بهش عارض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 476.36,
   "end": 480.32,
   "text": "امیرالمؤمنین چشم درد گرفت. امام حسن و امام حسین تب کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 480.32,
   "end": 485.28,
   "text": "و امثالهم. تا خدا همه چی دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 485.28,
   "end": 489.3,
   "text": "خلاصه مطلب اینکه این جمله‌ش خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.3,
   "end": 492.4,
   "text": "الا ما شاء الله. هرچی که خدا بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 492.4,
   "end": 496.14,
   "text": "الله بخواد. اگر کسی اینو به قلبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 496.14,
   "end": 501.8,
   "text": "واقعاً جا بده یعنی باور کنه که الا ما شاء الله کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 501.8,
   "end": 503.82,
   "text": "واقعاً آرامش خاطر می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 503.82,
   "end": 507.06,
   "text": "و ما اصلاً بحثمون از اطمینان و آرامش شروع کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 507.06,
   "end": 511.32,
   "text": "تمام تشویش‌ها، استرس‌ها، اضطراب‌ها، بیچارگی‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.32,
   "end": 513.68,
   "text": "از عدم باور قلبی‌مون به اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 513.68,
   "end": 517.78,
   "text": "الا ما شاء الله. میگیم نه دیگری هم دستش تو کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 517.78,
   "end": 520.16,
   "text": "مدیرم هم دستش قلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 520.16,
   "end": 523.88,
   "text": "نه من مثلاً نگم حرف نزنم الان حقوقمو کم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.88,
   "end": 527.48,
   "text": "الان اینا، اینا شرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 527.48,
   "end": 531.24,
   "text": "یا حرف نزنم این بلا سرم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 531.24,
   "end": 533.18,
   "text": "شجاعتشو از دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 533.18,
   "end": 536.84,
   "text": "حضرت امام می‌فرمود مطلقا از اهدی نترسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 536.84,
   "end": 540.58,
   "text": "اگر تمام مدیران ارشد نظام ما اینطوری فکر کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 540.58,
   "end": 545.44,
   "text": "الان این وضع ما میشد؟ دیگه از اهدی جز خدا نمی‌ترسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 545.44,
   "end": 547.74,
   "text": "ولی مرعوبن متأسفانه خیلی‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 547.74,
   "end": 549.5,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 549.5,
   "end": 551.76,
   "text": "صلوات بفرستید. اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}