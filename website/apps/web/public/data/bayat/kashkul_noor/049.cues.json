 },
 "chapters": [
  {
   "index": 0,
   "title": "لحظه‌ای پیرامونِ توحیدِ افعالی. یکی دیگر از آیاتی که در خصوصِ توحیدِ افعالی سخن می‌گوید آیهٔ هجدهِ سورهٔ یونس است:",
   "start": 1.68,
   "end": 105.4
  },
  {
   "index": 1,
   "title": "## محاجّهٔ امیرالمؤمنین",
   "start": 105.4,
   "end": 239.66
  },
  {
   "index": 2,
   "title": "## هیاکل و شفاعت؛ نه الوهیّتِ بت",
   "start": 239.66,
   "end": 422.77
  },
  {
   "index": 3,
   "title": "## پرستش فقط برای خدا",
   "start": 422.77,
   "end": 525.45
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.68,
   "end": 5.02,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.02,
   "end": 10.32,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.32,
   "end": 13.4,
   "text": "سلامٌ علیکُم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.4,
   "end": 16.78,
   "text": "یه چند لحظه پیرامون توحید افعالی وقتتون رو بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.78,
   "end": 20.92,
   "text": "یکی دیگه از آیاتی که در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.92,
   "end": 26.16,
   "text": "توحید افعالی سخن میگه آیه هجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.16,
   "end": 33.74,
   "text": "سوره یونس. می‌فرماید: \"و يعبدون من دون الله ما لا يضرهم ولا ينفعهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.74,
   "end": 37.42,
   "text": "اینا کسایی رو عبادت می‌کنند به جز خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.42,
   "end": 40.96,
   "text": "که نه ضرری به اون‌ها می‌رسونه، نه نفعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.96,
   "end": 48.02,
   "text": "\"ويقولون هؤلاء شفعاؤنا عند الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.02,
   "end": 54.28,
   "text": "دقت داشته باشید خیلی عجیبه این بحث که اینا میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.28,
   "end": 56.76,
   "text": "این‌هایی که ما می‌پرستیمشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.76,
   "end": 59.52,
   "text": "شفعای ما هستن عند الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.52,
   "end": 62.56,
   "text": "نزد الله. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.56,
   "end": 66.66,
   "text": "معلومه که الوهیت رو قبول دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.66,
   "end": 68.84,
   "text": "اینا رو یک واسطه می‌دونستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.84,
   "end": 71.0,
   "text": "حالا توضیح میدم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.0,
   "end": 77.44,
   "text": "\"قل أتنبئون الله بما لا يعلم في السماوات ولا في الأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.44,
   "end": 80.34,
   "text": "سبحانه و تعالى عما يشركون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.34,
   "end": 87.52,
   "text": "بهشون بگو که آیا این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.52,
   "end": 94.72,
   "text": "دارن کسایی رو می‌پرستن که لا يعلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.72,
   "end": 99.04,
   "text": "ظاهرش یعنی خدا علم نداره بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.04,
   "end": 104.72,
   "text": "در آسمان و زمین خدای منّان علمی به این‌ها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.72,
   "end": 110.5,
   "text": "وقتی چیزی در علم خدا نبود می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.5,
   "end": 115.68,
   "text": "می‌شه بفرمایید. ا- در علم خدا اگر چیزی نبود می‌شه معدوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.68,
   "end": 118.98,
   "text": "موجود نیست. عدم می‌شه اصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.98,
   "end": 122.66,
   "text": "معدومه دیگه. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.66,
   "end": 124.72,
   "text": "حالا اتفاقا در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.72,
   "end": 128.96,
   "text": "تفسیر اهل بیت می‌دیدم جلد ششم صفحه چهارصد و سی و هشت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.96,
   "end": 133.72,
   "text": "یه شخصی به نام ابوملیحه هزلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.72,
   "end": 137.62,
   "text": "از پدرش نقل می‌کنه که یکی اومد نزد دومی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.62,
   "end": 140.18,
   "text": "نشست و گفت: آقا من یه سوالی از شما دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.18,
   "end": 144.1,
   "text": "شما که ادعا می‌کنی خلیفه مسلمینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.1,
   "end": 150.44,
   "text": "بگو ببینم اون چیه که خدا نمی‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.44,
   "end": 156.42,
   "text": "یعنی خدا بهش علم نداره. و البته ادامه داد که چیزیه که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.42,
   "end": 159.8,
   "text": "نداره و چیزیه که در پیشگاه خدا هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.8,
   "end": 166.02,
   "text": "یعنی کمکش هم کرد. دومی از جواب باز موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.02,
   "end": 171.86,
   "text": "نتونست جواب بده. داشت هلاک می‌شد که مولامون امیرالمؤمنین علیه الصلاة والسلام تشریف آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.86,
   "end": 175.06,
   "text": "جانم به قربان اسمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.06,
   "end": 180.92,
   "text": "گفتن آقا، يا أبا الحسن ایشون سوالی پرسیده شما می‌تونید جوابگو باشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.92,
   "end": 182.52,
   "text": "فرمودن بله چرا نمی‌تونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.52,
   "end": 185.1,
   "text": "چیه سوالش؟ ایشون پرسیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.1,
   "end": 189.92,
   "text": "و مولامون امیرالمؤمنین اتفاقا اشاره به همین آیه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.92,
   "end": 197.34,
   "text": "فرمودن که در همین آیه داره که لا يعلم في السماوات ولا في الأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.34,
   "end": 201.92,
   "text": "اون چیزیه که تو آسمون و زمین خدا بهش علم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.92,
   "end": 204.6,
   "text": "اون هم شریک داشتن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.6,
   "end": 208.1,
   "text": "خدا اصلاً کسی رو نمی‌شناسه که شریکش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.1,
   "end": 210.94,
   "text": "اصلاً کسی در اون حد نیست. کسی اصلاً نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.94,
   "end": 213.64,
   "text": "موجودیت نداره. معدومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.64,
   "end": 221.64,
   "text": "شریک خدا معدومه. این یک روایت که ذیل این آیه خیلی شیرین امیرالمؤمنین در اون محاجه‌شون میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.64,
   "end": 224.1,
   "text": "که حواسمون جمع باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.1,
   "end": 228.6,
   "text": "اگر پرسیدن خدا به چی علم نداره به شریک خودش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.6,
   "end": 233.12,
   "text": "اصلاً وجود نداره. خب علم به معدوم که تعلق نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.12,
   "end": 236.3,
   "text": "یه جواب خیلی فلسفی و عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.3,
   "end": 239.66,
   "text": "اتفاقاً جالبه که بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.66,
   "end": 243.52,
   "text": "ابوریحان بیرونی رحمة الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.52,
   "end": 245.74,
   "text": "می‌زنه این، ااا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.74,
   "end": 247.76,
   "text": "قصه رو به بت پرستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.76,
   "end": 250.06,
   "text": "منتها من یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.06,
   "end": 254.1,
   "text": "دو سه جلسه مفصل در شرح مصباح العنس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.1,
   "end": 259.34,
   "text": "مرحوم ابن فناری از حضرت علامه حسن زاده عليه الرحمة والرضوان شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.34,
   "end": 264.7,
   "text": "خودم تا از حضرت استاد نشنیده بودم نمی‌دونستم و برام خیلی جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.7,
   "end": 267.78,
   "text": "من همیشه این بت‌پرست‌ها رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.78,
   "end": 271.64,
   "text": "ااا، کسایی رو می‌دیدم که خدا رو قبول ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.64,
   "end": 276.94,
   "text": "یعنی این بت و این مثلاً مجسمه رو به عنوان الوهیت نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 276.94,
   "end": 279.18,
   "text": "می‌پرستن، سجده می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.18,
   "end": 282.14,
   "text": "اصلاً توجه به این عبارت آیه نداشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.14,
   "end": 284.16,
   "text": "می‌خوام ذهنتون باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.16,
   "end": 287.46,
   "text": "که می‌فرماید: \"هؤلاء شفعاؤنا عند الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.46,
   "end": 291.0,
   "text": "اینا شفیعان ما پیش الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.0,
   "end": 295.18,
   "text": "حضرت علامه تو اون جلسه به این آیه و چند تا آیه دیگه اشاره کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.18,
   "end": 301.76,
   "text": "فرمودن توجه داشتید که این‌ها قائل به الوهیت نظام نیستن در این بت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.76,
   "end": 303.86,
   "text": "میگن اینا شفیع ما هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.86,
   "end": 306.08,
   "text": "بعد بحث هياکل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.08,
   "end": 311.28,
   "text": "مطرح کردن. یه رساله‌ای هم داره هياکل النور مرحوم شیخ اشراق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 311.28,
   "end": 314.64,
   "text": "که اونجا می‌فرماید که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.64,
   "end": 317.24,
   "text": "انواری که موجودند در اجسام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.24,
   "end": 318.9,
   "text": "حقیقت وجودی اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.9,
   "end": 321.82,
   "text": "همون نورانیت وجودی اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.82,
   "end": 329.36,
   "text": "و اتفاقاً یه جمله از افلاطون هم براتون دارم از کتاب نواس- نوامیسش خیلی عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.36,
   "end": 331.46,
   "text": "اینم گوش بدید خودتون نتیجه‌گیری کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.46,
   "end": 335.24,
   "text": "می‌فرماید واجب است افراد و کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.24,
   "end": 341.76,
   "text": "از کرامات الهی برخورد دارند، یعنی آدم‌هایی که صاحب کرامت‌اند، مقام و درجشون بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.76,
   "end": 346.18,
   "text": "او را در لباس اموری ستایش نمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.18,
   "end": 351.4,
   "text": "کی رو؟ خدا رو. خدا رو در لباس اموری ستایش نمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.4,
   "end": 355.02,
   "text": "یعنی خدا تجلی می‌کنه در البسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.02,
   "end": 357.06,
   "text": "در چیزی که بهش میگیم لباس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.06,
   "end": 359.48,
   "text": "مثل اینکه ما لباس آدمیت به تن کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 359.48,
   "end": 362.21,
   "text": "خدا تجلی کرده. اینا تجلیات الهی‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 362.21,
   "end": 364.13,
   "text": "می‌گه خدا رو در این‌ها ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.13,
   "end": 369.19,
   "text": "واجبه که اهل کرامت خدا رو در این امور ستایش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.19,
   "end": 371.43,
   "text": "بنابراین فرمایش افلاطونه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.43,
   "end": 374.87,
   "text": "بنابراین حیاکل، حالا الان میگم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.87,
   "end": 377.03,
   "text": "حیاکل و اجسام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.03,
   "end": 387.63,
   "text": "نمودار امور روحانی، نمودار، نمودار امور روحانی و ملائکه و مقدسات بود که همه امور را به آنها نسبت می‌دادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.63,
   "end": 393.65,
   "text": "اینا یه جاهایی رو درست کرده بودن، هیکل‌هایی، حیاکل جمع هیکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.65,
   "end": 400.15,
   "text": "هیکل‌هایی رو، تمثال‌هایی رو از اولیاء خدا، از فرشته‌ها، از آدمای خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 400.15,
   "end": 406.41,
   "text": "مثل ما که الان مثلا تمثال شهید حاج قاسم سلیمانی و تمثال حضرت امام و اینا رو یه جا قرار می‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.41,
   "end": 409.39,
   "text": "اینا هم یه معبد مانند‌هایی درست کرده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.39,
   "end": 414.13,
   "text": "این فرمایش حضرت آقا هستم از-- و این تمثال‌ها رو اونجا گذاشته بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.13,
   "end": 416.65,
   "text": "می‌گفتن این‌ها رابطه‌ی ما با خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.65,
   "end": 420.21,
   "text": "این‌ها شفیعان بین ما و خدا هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.21,
   "end": 422.19,
   "text": "نه اینکه این‌ها رو می‌پرستیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.19,
   "end": 426.99,
   "text": "اصلا تمام عالم بدون استثنا دو چیز رو پذیرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.99,
   "end": 430.17,
   "text": "اصلا نمیشه نپذیره. اصلا کسی نیست که این‌ها رو نپذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.17,
   "end": 433.41,
   "text": "یک مرگه، موته، همه پذیرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.41,
   "end": 436.05,
   "text": "یکی هم الهیت نظام هستیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.05,
   "end": 439.59,
   "text": "همه قبول دارن که یه اللهی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.59,
   "end": 443.27,
   "text": "حتی ماده‌پرست‌ها، این ماتریالیست‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.27,
   "end": 445.53,
   "text": "قبول دارن که الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 445.53,
   "end": 448.83,
   "text": "حتی بت‌پرست‌ها میگن این‌ها شفیع ما هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.83,
   "end": 451.19,
   "text": "این‌ها رابطه‌ی ما با خدا هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.19,
   "end": 454.39,
   "text": "حالا قرآن اومده ما رو تعالی بده، ما رو بکشه بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.39,
   "end": 456.45,
   "text": "میگه آقا این‌ها رو هم برداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 456.45,
   "end": 460.15,
   "text": "این هم به خودی خود استقلال وجودی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.15,
   "end": 463.61,
   "text": "من هستم که در همه چیز تجلی کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.61,
   "end": 466.57,
   "text": "به جز من رو حق ندارید بپرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 466.57,
   "end": 469.73,
   "text": "پرستش مخصوص منه. سجده فقط در برابر من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.73,
   "end": 473.13,
   "text": "در خصوص آدم هم اگر امر به سجده هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 473.13,
   "end": 476.75,
   "text": "به جهت اون نوری‌ست که در وجود آدم بود که اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 476.75,
   "end": 480.27,
   "text": "از کی اومد؟ و نفخت فیه من روحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.27,
   "end": 482.41,
   "text": "اونم از الهیت نظام هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.41,
   "end": 486.43,
   "text": "یعنی سجده به شرافت الهیت نظامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.43,
   "end": 488.27,
   "text": "این ح-- یعنی حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.27,
   "end": 492.95,
   "text": "اگر از کسی تعریف می‌کنیم، تنزیه می‌کنیم، کسی رو شایسته می‌دونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 492.95,
   "end": 495.93,
   "text": "نمی‌دونم به به چه‌چه می‌کنیم و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 495.93,
   "end": 501.43,
   "text": "اگر آنی در ذهن ما اون وجود مستقل داشته باشه و از خدا منها باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.43,
   "end": 507.05,
   "text": "می‌شه شرک. اما نه، اگر اون رو تجلی حضرت حق بدونیم، رابط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.05,
   "end": 511.11,
   "text": "بین خلق و حق بدونیم مثل امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.11,
   "end": 515.15,
   "text": "رابط بین ما و خدا باشه هیچ مشکلی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.15,
   "end": 518.69,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 518.69,
   "end": 520.71,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.71,
   "end": 525.45,
   "text": "صلوات بفرستیم. اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}