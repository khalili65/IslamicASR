 },
 "chapters": [
  {
   "index": 0,
   "title": "## تجلی اباعبدالله بر اهل کربلا؛ پرچم توحید",
   "start": 1.42,
   "end": 111.62
  },
  {
   "index": 1,
   "title": "## کلام علامه طباطبایی؛ عنایت عظیم برای سالکان",
   "start": 111.62,
   "end": 262.86
  },
  {
   "index": 2,
   "title": "## کامل الزیارات؛ پرچم مشکی و دعای فاطمه",
   "start": 262.86,
   "end": 572.59
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.42,
   "end": 6.22,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.22,
   "end": 10.22,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.22,
   "end": 13.12,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.12,
   "end": 21.08,
   "text": "وعلیکم السلام ورحمة الله. چنانچه خاطر شریفتون باشه در بحث تجلی بودیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.08,
   "end": 27.02,
   "text": "گفتیم که علت اینکه شاهدای کربلا همه اون سختی‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.02,
   "end": 32.96,
   "text": "تحمل کردن، بزرگان اهل معرفت فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.96,
   "end": 39.78,
   "text": "عمده‌ش این بود که حضرت ابا عبدالله بر اون‌ها تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.78,
   "end": 46.56,
   "text": "ما از این می‌خوایم بهترین استفاده رو کنیم که اصلاً معنای تجلی رو بفهمیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 46.56,
   "end": 48.74,
   "text": "و بریم به سمت توحید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.74,
   "end": 51.7,
   "text": "پرچم توحید دست امام حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.7,
   "end": 57.44,
   "text": "امثال آقای قاضی‌ها رحمة الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.44,
   "end": 63.72,
   "text": "فرمودن که اصلاً راه توحید به‌جز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.72,
   "end": 67.82,
   "text": "امام حسین طی شدنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.82,
   "end": 71.34,
   "text": "یعنی به‌جز طریق امام حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.34,
   "end": 74.72,
   "text": "طریق توحید طی شدنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.72,
   "end": 78.66,
   "text": "امثال آقای قاضی‌ها رحمة الله علیه فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.66,
   "end": 81.7,
   "text": "اینا استوانه‌های توحید بودن خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.7,
   "end": 88.08,
   "text": "توجه کردید؟ این‌هایی که دستگاه سیدالشهدای رو کم می‌شمrن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.08,
   "end": 92.5,
   "text": "پیرهن مشکی امام حسین رو قدروقیمتش رو نمی‌دونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.5,
   "end": 95.98,
   "text": "و قدروقیمت خودشون رو هم نمی‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.98,
   "end": 100.1,
   "text": "این‌ها از طریق توحید دورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.1,
   "end": 103.82,
   "text": "این‌ها حواسشون نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.82,
   "end": 107.54,
   "text": "در چه محیط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.54,
   "end": 111.62,
   "text": "با عظمتی قرار گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.62,
   "end": 116.5,
   "text": "فرمایشی رو از حضرت علامه طباطبایی علیه الرحمه براتون بخونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.5,
   "end": 121.56,
   "text": "در رابطه با سر تسلسل به امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.56,
   "end": 125.3,
   "text": "می‌فرما د: «چون آن حضرت را برای رفع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.3,
   "end": 128.7,
   "text": "حجاب و موانع طریق»،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.7,
   "end": 138.48,
   "text": "یعنی کسی می‌خواد تو مسیر توحید و بندگی خدا قدم بگذاره، بنده خوب خدا بشه، به توحید برسه که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.48,
   "end": 143.14,
   "text": "عرض می‌کنیم این به توحید رسیدن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 143.14,
   "end": 145.78,
   "text": "آدم خودساخته که نباید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.78,
   "end": 149.74,
   "text": "خودش راه بیفته بره بگه من به توحید رسیدم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 149.74,
   "end": 153.96,
   "text": "مراحل داره، مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.96,
   "end": 156.26,
   "text": "باید من و شما الان خودمون رو بسنجیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.26,
   "end": 158.58,
   "text": "دیگه ریش‌ها داره سفید می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.58,
   "end": 162.1,
   "text": "الان تو کدوم مرحله از توحیدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.1,
   "end": 167.58,
   "text": "نسنج‌ها، نکن. حسابرسی نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.58,
   "end": 171.9,
   "text": "به محض اینکه «فکشفنا عنک قطاءک»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.9,
   "end": 174.76,
   "text": "این قطایی که پرده‌ای که خودت با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.76,
   "end": 178.6,
   "text": "گناه و حجاب جلو خودت ایجاد کردی و کشفنا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.6,
   "end": 184.62,
   "text": "ما برش داشتیم. یعنی الله يتوفى الانفس حين موتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.62,
   "end": 188.64,
   "text": "یعنی ما اراده کردیم تو بمیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.64,
   "end": 190.84,
   "text": "اون موقع فبصرک اليوم حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.84,
   "end": 194.74,
   "text": "چشمت تیز می‌شه به غلط‌هایی که کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.74,
   "end": 198.54,
   "text": "یکیش اینه که خودساخته راه افتادی رفتی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.54,
   "end": 205.34,
   "text": "خواستی به توحید برسی و خودتم خیال کردی رسیدی، حسابرسی هم نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.34,
   "end": 208.28,
   "text": "حالا که پرده رو برداشتیم می‌فهمی چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.28,
   "end": 212.1,
   "text": "این تیزی چشم خیلی معناها داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.1,
   "end": 216.84,
   "text": "معانی زیادی ازش می‌شه برداشت کرد که بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.84,
   "end": 220.08,
   "text": "برای رفع حجاب و مناو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 220.08,
   "end": 225.22,
   "text": "موانع طریق، یعنی این راهی که می‌خوایم بریم که پر پیچ و خم هم هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.22,
   "end": 228.68,
   "text": "عرضم به شما برسه زیاده موانعی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.68,
   "end": 231.38,
   "text": "علامه طباطبایی علیه الرحمه می‌فرما د:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.38,
   "end": 237.3,
   "text": "«چون آن حضرت را» یعنی امام حسین را «برای رفع حجاب و، و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.3,
   "end": 243.06,
   "text": "موانع طریق نسبت به سالکین راه خدا»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.06,
   "end": 245.7,
   "text": "راهی جدایی از راه خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.7,
   "end": 253.54,
   "text": "این‌ها تو طول هم‌ن. «برای سالکین راه خدا عنایتی عظیم است.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 253.54,
   "end": 262.86,
   "text": "کی؟ امام حسین. اصلاً عنایت امام حسینه که تو مشکی پوشیدی و این عنایت عظیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 262.86,
   "end": 265.48,
   "text": "حدیث امام صادق علیه-- تو ک-م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 265.48,
   "end": 271.36,
   "text": "کتاب شریف کامل الزيارات که قدیمی‌ترین، مال هزار سال پیشه حدوداً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 271.36,
   "end": 274.72,
   "text": "که منبع زیارات عاشورا اولش تو اون اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 274.72,
   "end": 280.1,
   "text": "مرحوم ابن غولویه قمی تو کاظمین بغل شیخ مفید دفنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 280.1,
   "end": 284.74,
   "text": "ضریحش رو امام زمان صلوات الله علیه بارها دیده شده که بوسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 284.74,
   "end": 287.04,
   "text": "شوخی نیست، اونجا آورده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 287.04,
   "end": 290.44,
   "text": "فرمودن امام صادق صلوات الله علیه فرمود پرچم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 290.44,
   "end": 300.94,
   "text": "مشکی، محرم که شد پرچم مشکی بزنید سر در خانه‌هاتون تا مادر ما فاطمه شما رو دعا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 300.94,
   "end": 302.6,
   "text": "یعنی این عنایت رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 302.6,
   "end": 310.4,
   "text": "این پیرهن مشکی رو تمام بزرگان فرمودن سعی کنید محرم و صفر این دو ماه بپوشید، نه فقط دهه‌ه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 310.4,
   "end": 320.78,
   "text": "تا بلکه یعنی بشید سیاه لشکر حضرت، بشید جزء-- این پیرهن مشکی چیز کمی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 320.78,
   "end": 324.56,
   "text": "همشیرای ما بچه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 324.56,
   "end": 327.62,
   "text": "یعنی تازه به راه افتاده‌ن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 327.62,
   "end": 330.98,
   "text": "افتاده بود. اون موقع من خودم به دنیا هم نیومده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 330.98,
   "end": 332.68,
   "text": "خدا اموات شما رو رحمت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 332.68,
   "end": 337.14,
   "text": "مادر ما خدا بیامرز اینو برای ما تعریف می‌کرد با اشک و آه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 337.14,
   "end": 339.76,
   "text": "که اون سم-- خب اون موقع خونه ما هیئت بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 339.76,
   "end": 346.12,
   "text": "هیئت بود و بالاخره. یه سماورای بزرگ قدیما داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 346.12,
   "end": 351.98,
   "text": "بعد توش آب می‌جوشیده، این سماور بر می‌گرده، همشیرای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 351.98,
   "end": 355.82,
   "text": "بین این آب‌های جوش غلت می‌زده و جیغ می‌زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 355.82,
   "end": 360.38,
   "text": "تمام بدنش می‌سوزه. نمی‌دونم نود درصد چقدر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 360.38,
   "end": 364.26,
   "text": "سوختگی داشته. می‌برنش دکتر تمام، می‌گن تمام اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 364.26,
   "end": 369.51,
   "text": "برای چی آوردیش بیمارستان؟ اصلاً دیگه تمومه کارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 369.51,
   "end": 373.25,
   "text": "مادرم التماس و خواهش و چی که نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 373.25,
   "end": 376.43,
   "text": "بالاخره شما یه کاری بکن، ع-- کاریتون رو انجام بدید عمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 376.43,
   "end": 380.91,
   "text": "گفتن تمام گوشت بدن این بچه باید قیچی شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 380.91,
   "end": 384.47,
   "text": "مثلا این بچه رفته عملاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 384.47,
   "end": 388.73,
   "text": "مادرم اونجا خلاصه شروع میکنه گریه کردن به من می گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 388.73,
   "end": 394.61,
   "text": "من اون موقع فکر میکنی چی نذر کرده بودم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 394.61,
   "end": 397.61,
   "text": "شاید باورتون نشه. نذر کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 397.61,
   "end": 400.93,
   "text": "که اگر این دخترم، اسمش هم فاطمه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 400.93,
   "end": 405.07,
   "text": "اگر دخترم که به نام مادرت فاطمه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 405.07,
   "end": 408.17,
   "text": "به دست تو یا حسین شفا بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 408.17,
   "end": 415.51,
   "text": "من نذر می‌کنم دو ماه س-- محرم و صفر این دختره من همیشه مشکی بپوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 415.51,
   "end": 419.35,
   "text": "و این خواهر ما معجزه آسا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 419.35,
   "end": 423.91,
   "text": "اصلاً گفتن زنده شده. یعنی مادرم می‌گفت دکترها می‌گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 423.91,
   "end": 427.91,
   "text": "تو سر خودشان می‌کوبیدن. می‌گفتن اصلاً محال همچین چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 427.91,
   "end": 431.91,
   "text": "ما معجزه دیدیم. این بچه یه دفعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 431.91,
   "end": 436.47,
   "text": "خوب بشه حالش به اون صورت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 436.47,
   "end": 440.85,
   "text": "فقط هم مشکی پوشیدن. ما نباید این دستگاه رو کمش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 440.85,
   "end": 445.29,
   "text": "راه تجلی حضرت حق تجلیات سید الشهداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 445.29,
   "end": 451.19,
   "text": "می‌خوایم ما به این برسیم. رساله ای هم که دست بنده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 451.19,
   "end": 457.47,
   "text": "رساله سیر و سلوکی که حضرت علامه طباطبایی علیه الرحمه و رضوان بسیار رساله سنگینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 457.47,
   "end": 460.87,
   "text": "من از خودم حرفی برای گفتن ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 460.87,
   "end": 464.91,
   "text": "جایی که عقاب پر بریزد از پشه لاغری چه خیزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 464.91,
   "end": 469.01,
   "text": "این حرف‌ها رو جدی بگیریم. بحث ما تو چ-- تجلی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 469.01,
   "end": 470.97,
   "text": "می‌خوایم ببینیم اصلاً تجلی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 470.97,
   "end": 476.37,
   "text": "این همه من امروز یه ذره مقدمه گفتم دلاتون آماده باشه که روزهای بعد می‌خوایم حرف بزنیم ببینیم تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 476.37,
   "end": 479.93,
   "text": "چه محیطی، تو چه فضایی هستیم می‌خوایم حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 479.93,
   "end": 484.81,
   "text": "خب آقا یعنی چی؟ امام حسین تجلی کرد یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 484.81,
   "end": 487.87,
   "text": "خلاصه‌ش یعنی امام حسین خودشو به اینا نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 487.87,
   "end": 491.13,
   "text": "یعنی به معنای شما نشون نداد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 491.13,
   "end": 495.85,
   "text": "خب این یعنی چی نشون داد امام حسین خودش رو نشون داد رو میشه باز کنید به لسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 495.85,
   "end": 499.69,
   "text": "بزرگان ما بفهمیم آیا بف-- بالاخره حسابرسی کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 499.69,
   "end": 503.73,
   "text": "آیا به ما هم نشون داده امام حسین خودش رو یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 503.73,
   "end": 510.97,
   "text": "یا ما داریم بازی می‌کنیم؟ و ربط تجلیات ابا عبدالله با تجلیات الهیه چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 510.97,
   "end": 516.57,
   "text": "که گفتیم همه عالم تجلیات حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 516.57,
   "end": 520.91,
   "text": "که از حیث متافیزیکیش می‌شد حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 520.91,
   "end": 525.87,
   "text": "خودش برای خودش تجلی کرده شده نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 525.87,
   "end": 529.09,
   "text": "از حیث سیر و سلوکی میشه حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 529.09,
   "end": 531.95,
   "text": "در انسان از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 531.95,
   "end": 537.39,
   "text": "افعال و صفات و ذات تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 537.39,
   "end": 542.25,
   "text": "یعنی تخ-- جمله آخر. تنها موجودی که خداوند او رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 542.25,
   "end": 545.13,
   "text": "از حیث افعال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 545.13,
   "end": 549.61,
   "text": "صفات و ذات به وزان خودش آفریده انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 549.61,
   "end": 556.49,
   "text": "الله اکبر. چه خبره تو ماها و ما ازش بی-- از خودمون بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 556.49,
   "end": 559.63,
   "text": "این سیر رو انشاالله می‌خوایم بریم شما هم حوصله کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 559.63,
   "end": 567.27,
   "text": "یه ذره به برکت این لباس مشکی‌هایی که تن‌تونه یه ذره رشد بیشتری داشته باشیم، یه مقدار چشممون بیشتر باز بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 567.27,
   "end": 569.23,
   "text": "خودمون رو بهتر بشناسیم حداقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 569.23,
   "end": 571.01,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 571.01,
   "end": 572.59,
   "text": "صلوات بفرستید. الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}