 "chapters": [
  {
   "index": 0,
   "title": "## دو آیه دربارهٔ پرواز پرنده و توحید افعالی",
   "start": 4.82,
   "end": 28.98
  },
  {
   "index": 1,
   "title": "یکی آیهٔ هفتادونه سورهٔ نحل:",
   "start": 28.98,
   "end": 123.16
  },
  {
   "index": 2,
   "title": "## آیهٔ ملک؛ صافات و قبض و رحمان",
   "start": 123.16,
   "end": 314.94
  },
  {
   "index": 3,
   "title": "## جو آسمان در مجمع‌البیان",
   "start": 314.94,
   "end": 386.61
  },
  {
   "index": 4,
   "title": "## پرندگان نام‌برده در قرآن",
   "start": 386.61,
   "end": 535.85
  },
  {
   "index": 5,
   "title": "## هماهنگی بدن پرنده برای پرواز",
   "start": 535.85,
   "end": 618.89
  },
  {
   "index": 6,
   "title": "## فشار خون، اکسیژن و ختم به آیه",
   "start": 618.89,
   "end": 798.98
  },
  {
   "index": 7,
   "title": "## قوس صعود؛ عقل کل و نفس کل",
   "start": 798.98,
   "end": 857.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.82,
   "end": 8.88,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.88,
   "end": 13.1,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.1,
   "end": 17.92,
   "text": "آیه. سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.92,
   "end": 24.8,
   "text": "دو تا آیه در قرآن هست که پیرامون پرواز پرنده است و مستقیم دلالت بر توحید افعالی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.8,
   "end": 28.98,
   "text": "خیلی شیرین. یکیش آیه هفتاد و نه سوره نحل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.98,
   "end": 32.02,
   "text": "ألم یروا. این ألم یروا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.02,
   "end": 35.64,
   "text": "کأن تشره خداست به اونایی که نگاه نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.64,
   "end": 42.84,
   "text": "فرموده آیا نگاه نمی‌کنید؟ اونایی که اهل تفکر در آیات الهی نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.84,
   "end": 46.38,
   "text": "ألم یروا إلى الطیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.38,
   "end": 51.24,
   "text": "آیا نگاه نمی‌کنید به اون پرندگانی که مسخرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.24,
   "end": 53.94,
   "text": "في جو السماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.94,
   "end": 57.18,
   "text": "اینا توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.18,
   "end": 64.4,
   "text": "جو آسمون رام و مسخرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.4,
   "end": 67.7,
   "text": "ما یمسکهن إلا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.7,
   "end": 74.62,
   "text": "هیچکس اینا رو در اون وضعیت بین زمین و آسمون سکنا نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.62,
   "end": 78.7,
   "text": "هیچکس اونا رو اونجا حفظ نکرده از افتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.7,
   "end": 81.46,
   "text": "الا کی؟ الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.46,
   "end": 87.84,
   "text": "جالبه. کی تا حالا پرنده رو نگاه کرده گفته ای خدایا اینو نگه داشته بین زمین و آسمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.84,
   "end": 91.86,
   "text": "مخصوصا وقتی که پرنده پرهاشو باز می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.86,
   "end": 94.1,
   "text": "همینطوری داره میره. پر نمی‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.1,
   "end": 99.54,
   "text": "اون لحظه خیلی عجیبه. إن في ذلك لآيات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.54,
   "end": 102.66,
   "text": "قرآن دارم می‌خونم از خودم نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.66,
   "end": 105.84,
   "text": "می‌فرما توی این موضوع اگه دقت کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.84,
   "end": 107.82,
   "text": "قطعاً اونا-- لا هم تأکیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.82,
   "end": 110.58,
   "text": "لآيات. نه یه، نه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.58,
   "end": 113.28,
   "text": "آیات. نشانه‌هایی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.28,
   "end": 115.86,
   "text": "البته لقوم يؤمنون. برای کسی که دل بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.86,
   "end": 118.54,
   "text": "کسی که دل نداده اینا مسخره بازیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.54,
   "end": 121.16,
   "text": "جمعش کن. خودش وایستاده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.16,
   "end": 124.88,
   "text": "باید دل داده باشه. یکی هم آیه نوزده سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.88,
   "end": 129.02,
   "text": "ملکه. باز می‌فرماید أولم یری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.02,
   "end": 132.2,
   "text": "نگاه نمی‌کنی؟ تشره خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.2,
   "end": 134.7,
   "text": "إلى الطير. حالا اینجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.7,
   "end": 137.0,
   "text": "اینجا هم به پرندگان اشاره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 137.0,
   "end": 141.86,
   "text": "همون چ-چگونه رو إلى الطير صافات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.86,
   "end": 144.94,
   "text": "يقبضنه. فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.94,
   "end": 147.34,
   "text": "چگونه رام شده این پرنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.34,
   "end": 151.36,
   "text": "حالا این صافات رو اونجا بعضیا تعبیر کردن به همون حالتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.36,
   "end": 155.38,
   "text": "پراش بازه، بالاش بازه و تکون نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.38,
   "end": 158.52,
   "text": "بال و پر نمی‌زنه. دیدید پرنده گاهی اوقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.52,
   "end": 160.76,
   "text": "دقیقاً همینطوری بالش بازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.76,
   "end": 166.56,
   "text": "داره حرکت می‌کنه. بعضیا تعبیر از این صافات به اونجا، به اون لحظه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.56,
   "end": 171.06,
   "text": "يقبضنه که در جو آسمون به این شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.06,
   "end": 173.4,
   "text": "اصلاً در قبضه او قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.4,
   "end": 177.1,
   "text": "ما-- اینجا، اونجا می‌فرماید ما یمسکهن إلا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.1,
   "end": 181.7,
   "text": "اینجا ما یمسکهن إلا الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.7,
   "end": 183.98,
   "text": "هیچکس اونو نگه نداشته جز رحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.98,
   "end": 187.28,
   "text": "حالا اونایی که تو مراتب خلقت توجه داشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.28,
   "end": 190.82,
   "text": "مثلا دیشب در العاصوم ما اونجا ثابت کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 190.82,
   "end": 194.94,
   "text": "رب، رب پرورش دهنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.94,
   "end": 197.4,
   "text": "عالم عقول یا جبروت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.4,
   "end": 202.0,
   "text": "عقل، عقل اول و عقول عشر کلاً عقول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.0,
   "end": 204.46,
   "text": "ربش هست اسم الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 204.46,
   "end": 207.9,
   "text": "تمام عالم هم که از عقل پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 207.9,
   "end": 211.68,
   "text": "یعنی همین پرنده‌ای که می‌بینی تو آسمون داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 211.68,
   "end": 214.9,
   "text": "بدون اینکه سقوط کنه پرواز می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 214.9,
   "end": 218.22,
   "text": "عقل نگر داشته. عقل عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 218.22,
   "end": 224.94,
   "text": "همونطور که عقل همه چی رو از عقل پیاده شده و ما نزل له إلا بقدر معلوم شناسایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 224.94,
   "end": 231.22,
   "text": "قدر و اندازه هر کسی رو، هر شیی رو به همون میزان فیض بهش می‌رسونه از صادر اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.22,
   "end": 235.24,
   "text": "یا وجود-- یعنی فیض منبسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 235.24,
   "end": 238.34,
   "text": "هویت ثاری همراه همه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.34,
   "end": 245.28,
   "text": "اون نگه داشتن پرنده هم تو جو آسمون هم عقل نگر داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.28,
   "end": 249.56,
   "text": "خیلی شیرینه. بعد می‌فرماید أنه بكل شيء بصير، بصير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.56,
   "end": 252.2,
   "text": "ببینید اون اول آیه می‌فرماید ألم یروا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.2,
   "end": 254.56,
   "text": "هر دو تا آیه. نگاه نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.56,
   "end": 257.8,
   "text": "اینجا آخر آیه می‌فرماید بكل شيء بصير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.8,
   "end": 260.1,
   "text": "به شدت خدا بیناست بر هر چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.1,
   "end": 264.46,
   "text": "اشاره به نگاه می‌کنه. به نظر شما اگر کسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 264.46,
   "end": 270.02,
   "text": "اونهایی که مهندسی هواپیما کردن نگاه نمی‌کردن به طرز پرواز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.02,
   "end": 273.64,
   "text": "این پرنده‌ها می‌تونستن هواپیما بسازن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.64,
   "end": 277.0,
   "text": "اینم خودش یه نکته‌ست. میگه نگاه نمی‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.0,
   "end": 280.34,
   "text": "نگاه کن بتونی پروا-- هواپیما بسازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 280.34,
   "end": 282.42,
   "text": "ألم یروا. اینم یه نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 282.42,
   "end": 284.74,
   "text": "آخرش هم آیه بكل شيء بصير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.74,
   "end": 287.84,
   "text": "اصلاً هرچی هست با نگاه کردن شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 287.84,
   "end": 289.6,
   "text": "حادث میشه، انشا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 289.6,
   "end": 296.14,
   "text": "نگاه کن تا تو هم بسازی. اون حالت دوگ شکلی پرنده رو حالا یه چند تا از اسرارشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 296.14,
   "end": 298.32,
   "text": "خدمتتون عرض می‌کنم. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 298.32,
   "end": 306.38,
   "text": "در تفسیر در مجمع البیان دیدم که در مورد جو چون اینجا تو آیه هفتاد و نه نحل می‌فرمود که في جو السماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.38,
   "end": 314.58,
   "text": "حالا جو چیه؟ اونجا فرمود الهواء البعید في الأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.58,
   "end": 319.26,
   "text": "مرحوم شیخ طبرسی در مجمع فرمود که هوای دور از زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.26,
   "end": 322.28,
   "text": "تا حالا توجه داشتید وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 322.28,
   "end": 325.5,
   "text": "هرچی دور میشی از زمین فشار هوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.5,
   "end": 328.16,
   "text": "سنگین میشه، فشرده‌تر میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.16,
   "end": 330.84,
   "text": "حجم اکسیژن کمتر میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 330.84,
   "end": 333.9,
   "text": "و اگر کسی تو اون حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 333.9,
   "end": 337.62,
   "text": "قرار بگیره، اونجا مثلا هواپیماش یه دفعه پنجره بشکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.62,
   "end": 339.84,
   "text": "اون فشار بیاد تو وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.84,
   "end": 342.02,
   "text": "ورم ریه و مغز می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.02,
   "end": 346.04,
   "text": "اصلاً متلاشی میشه. خیلی که بره بالا متشا-متلاشی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 346.04,
   "end": 350.0,
   "text": "بعضی از پرنده‌ها تا هشت کیلومتر بالا میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.0,
   "end": 354.22,
   "text": "بعضیاشون چهل و پنج متر داخل آب میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.22,
   "end": 357.06,
   "text": "اینا رو من مطالعه کردم خدمتتون عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 357.06,
   "end": 362.06,
   "text": "بعضی پرنده‌ها داخل غارهایی‌اند که وحشت می‌کنه انسان بره اون تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 362.06,
   "end": 365.46,
   "text": "غار‌های تاریک. تو بیابون‌های بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.46,
   "end": 370.27,
   "text": "آب و علف و خشک بالای کوه‌های مرتفع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.27,
   "end": 372.41,
   "text": "اصلاً تو مهره‌داران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.41,
   "end": 376.31,
   "text": "خوبه بدونید بعد از ماهیان بیشتر از همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 376.31,
   "end": 379.41,
   "text": "همین تیره پرندگان‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 379.41,
   "end": 384.25,
   "text": "که نه هزار، بیش از نه هزار گونه ازشون شناسایی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 384.25,
   "end": 390.03,
   "text": "حالا ما چند تاشو می‌شناسیم؟ تو خود قرآن هم شما دقت کنید مثلاً چند تاشو اسم می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 390.03,
   "end": 393.89,
   "text": "اونجا که حالا به صورت کلی این آیه که گفتیم میگه طیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 393.89,
   "end": 398.25,
   "text": "اونایی که می‌پرن. اما اونایی که اسم می‌بره یکی کلاغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 398.25,
   "end": 404.37,
   "text": "تو ماجرای حابیل و قابیل. که قبر کندن و دفن کردن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.37,
   "end": 407.01,
   "text": "قابیل از کلاغ یاد گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.01,
   "end": 411.23,
   "text": "جالبه. اون بت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 411.23,
   "end": 417.33,
   "text": "قوم نوح که ازشون تو قرآن به نسر یاد شده شبیه عقاب بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 417.33,
   "end": 418.91,
   "text": "شبیه عقاب بت ساخته بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.91,
   "end": 421.89,
   "text": "اینم یک پرنده‌ای که یاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 421.89,
   "end": 423.93,
   "text": "اون غذاهایی که برای بنی‌اسرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 423.93,
   "end": 426.75,
   "text": "نازل شد اسمشون چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 426.75,
   "end": 429.33,
   "text": "سلوا. من و سلوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 429.33,
   "end": 431.47,
   "text": "سلوا پرنده‌هایی که حالا بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.47,
   "end": 434.29,
   "text": "مفسرین فرمودن همون بلدرچین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 434.29,
   "end": 437.49,
   "text": "از آسمون می‌اومد که اینا خوششون بیاد بخورنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 437.49,
   "end": 439.65,
   "text": "گوشت شیرینی داشت. هدهد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 439.65,
   "end": 443.19,
   "text": "هدهد سلیمان. یه چند تا به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 443.19,
   "end": 446.05,
   "text": "اختصاصی نامبرده شده. البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 446.05,
   "end": 450.31,
   "text": "رموزش رو هم مفسرین گفتن که چرا این پرنده‌ها نامبرده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 450.31,
   "end": 453.03,
   "text": "حالا فرصت نیست بیان کنیم به صورت کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 453.03,
   "end": 455.21,
   "text": "خدا داره توجه میده به این پرنده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 455.21,
   "end": 458.09,
   "text": "میگه به اینا نگاه کنید. چرا نگاه نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 458.09,
   "end": 462.67,
   "text": "یه ذره سرت رو اصلاً بالا بیار شاید رمزش اینه که تو یه ذره آسمونو نگاه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 462.67,
   "end": 467.19,
   "text": "همش مشغول زمینی. \"و فی السمای رزقکم و ما توعدون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 467.19,
   "end": 470.11,
   "text": "رزقت تو آسمونه و هرچی که به شما وعده داده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 470.11,
   "end": 473.65,
   "text": "یه ذره سرت رو بالا بیار. دست به دعا ببر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 473.65,
   "end": 477.09,
   "text": "همه حیوانات پوزشون افقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 477.09,
   "end": 478.83,
   "text": "به صورت افقی راه میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 478.83,
   "end": 480.97,
   "text": "به این شکل پوزشون افقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 480.97,
   "end": 484.39,
   "text": "عمودی نیست. درخت دهنش تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 484.39,
   "end": 487.29,
   "text": "تو زمینه. از زمین می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 487.29,
   "end": 490.59,
   "text": "ریشه دهن درخته. انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 490.59,
   "end": 492.83,
   "text": "به این شکله. به سمت آسمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 492.83,
   "end": 494.89,
   "text": "دهانش به سمت آسمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 494.89,
   "end": 496.99,
   "text": "\"و فی السمای رزقکم و ما توعدون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 496.99,
   "end": 502.11,
   "text": "اینا اسرار آفرینشه. آدم باید به اینا توجه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 502.11,
   "end": 504.23,
   "text": "شاید مهندسین هوا و فضا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 504.23,
   "end": 509.29,
   "text": "حالا من دیدم چه علومی دخیل‌اند در ساختن هواپیما خیلی برام جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 509.29,
   "end": 515.55,
   "text": "میگم به ذهنم اومد که شاید اصلاً این علوم رو، این طراحی که تو هواپیما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 515.55,
   "end": 518.21,
   "text": "و این‌ها انجام دادن از همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 518.21,
   "end": 521.41,
   "text": "نگاه کردن، دقت کردن به پرنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 521.41,
   "end": 523.51,
   "text": "رسیدن به این علوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 523.51,
   "end": 532.07,
   "text": "آیرودینامیک، فیزیک دینامیک، فیزیک حرارت، فیزیک الکتریسیته و مغناطیس، استاتیک، مقاومت، هواشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 532.07,
   "end": 535.85,
   "text": "چرا اینا رو میگم؟ وقتی بررسی کردم زندگی‌نامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 535.85,
   "end": 539.25,
   "text": "به دستور حضرت آقا علم حسنزاده علیه الرحمه پرنده‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 539.25,
   "end": 543.03,
   "text": "که تمام این‌ها به جز جز رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 543.03,
   "end": 546.73,
   "text": "حالا الان به عنوان نمونه براتون یکیشو عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 546.73,
   "end": 553.75,
   "text": "ببینید که مثلاً دقت در شکل ظاهری پرندگان نشان می‌دهد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 553.75,
   "end": 555.73,
   "text": "یه بخش کوچیکشو دارم براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 555.73,
   "end": 558.21,
   "text": "چند خطی دقت کنید به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 558.21,
   "end": 565.85,
   "text": "شیرینه. دقت در شکل ظاهری پرندگان نشان می‌دهد که تمام وجود آنها برای پرواز هماهنگ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 565.85,
   "end": 569.29,
   "text": "تمام وجود نه فقط شکل دوکیشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 569.29,
   "end": 572.11,
   "text": "ساختمان دوکی شکل بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 572.11,
   "end": 577.11,
   "text": "پرهای لیز، سبک و توخالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 577.11,
   "end": 581.57,
   "text": "که با گیر انداختن هوا باعث سبکی آن می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 581.57,
   "end": 586.25,
   "text": "استخوان‌هایی که در-- دقت کنید در عین استحکام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 586.25,
   "end": 589.19,
   "text": "یعنی استخوان محکمه اما سبک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 589.19,
   "end": 593.17,
   "text": "و عموماً توخالی‌ست که بتونه بپره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 593.17,
   "end": 596.33,
   "text": "نوع سیستم هوایی تنفس آنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 596.33,
   "end": 598.23,
   "text": "کیسه‌های هوایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 598.23,
   "end": 602.99,
   "text": "درون استخوان‌هاست. می‌دونستید داخل استخون‌هاشون کیسه‌های هوایی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 602.99,
   "end": 605.93,
   "text": "که سبکشون کنه؟ مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 605.93,
   "end": 608.83,
   "text": "بادکنک، بادکنک‌های ریز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 608.83,
   "end": 613.39,
   "text": "سینه‌های پهن با عضلات قوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 613.39,
   "end": 617.11,
   "text": "امکان سوار شدن بر امواج هوا را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 617.11,
   "end": 619.97,
   "text": "ایجاد می‌کنه. اگه سینه پهن نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 619.97,
   "end": 623.11,
   "text": "و عضلات قوی نباشه نمی‌تونه کنترل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 623.11,
   "end": 628.85,
   "text": "تو سینه کش هوا و آسمون حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 628.85,
   "end": 634.43,
   "text": "ساختمان مخصوص بال‌ها که نیمه انتهای آن نیروی بالابرنده ایجاد می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 634.43,
   "end": 639.07,
   "text": "نیمه خارجی آن پرنده را به سمت جلو هل می‌دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 639.07,
   "end": 642.29,
   "text": "با کمک دمش که ساختمان دم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 642.29,
   "end": 645.13,
   "text": "که با قابلیت مانور حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 645.13,
   "end": 648.91,
   "text": "سریع به چپ و راست، گاه با گشودن آن باعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 648.91,
   "end": 652.59,
   "text": "کاهش سرعت و حفظ تعادل در نشستن می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 652.59,
   "end": 657.45,
   "text": "دمش. و گاه به همراه بال‌ها در مقابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 657.45,
   "end": 660.53,
   "text": "باد پهن می‌شود خود دمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 660.53,
   "end": 663.05,
   "text": "و همچون بادبادکی اوج می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 663.05,
   "end": 665.95,
   "text": "با کمک باد خودشو پهن می‌کنه دم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 665.95,
   "end": 669.19,
   "text": "مثل باد-بادبادک میره رو هوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 669.19,
   "end": 674.79,
   "text": "خیلی جالبه. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 674.79,
   "end": 677.57,
   "text": "چشمی دارن مثل تلسکوپ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 677.57,
   "end": 682.13,
   "text": "شما الان خلبان‌ها دیدید که باید نمره چشمشون چند باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 682.13,
   "end": 684.59,
   "text": "ده دهم. یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 684.59,
   "end": 687.39,
   "text": "ضعیف باشه نمی‌تونن خلبان باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 687.39,
   "end": 690.97,
   "text": "عجیبه. پرنده‌ها چشمشون مثل تلسکوپه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 690.97,
   "end": 693.17,
   "text": "نه ده دهم که چه عرض کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 693.17,
   "end": 696.31,
   "text": "یعنی تو ارتفاع هشت کیلومتر دقیق زمینو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 696.31,
   "end": 699.77,
   "text": "اون عقاب چجوری تشخیص میده یه موش داره رو زمین میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 699.77,
   "end": 701.97,
   "text": "اصلاً توجه کردیم ما میریم بالای کوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 701.97,
   "end": 704.29,
   "text": "آدما رو مثل مورچه می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 704.29,
   "end": 711.29,
   "text": "چجوری عقاب یه موش چه عرض کنم از بالای اون ارتفاع کوه یه موش رو می‌بینه که داره حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 711.29,
   "end": 713.61,
   "text": "اینا اسرار آفرینش نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 713.61,
   "end": 715.95,
   "text": "حالا زیاده بخواهیم صحبت کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 715.95,
   "end": 719.41,
   "text": "وقت شما گرفته میشه و تا همین مقدار بسنده می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 719.41,
   "end": 723.35,
   "text": "چه حرف‌های پیرامون فشارخون بالاشون زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 723.35,
   "end": 726.87,
   "text": "پرنده شناس‌ها. فشارخون پرنده‌ها باید بالا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 726.87,
   "end": 730.77,
   "text": "ته- دستگاه عصبی‌شون و حسی‌شون باید فوق‌العاده قوی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 730.77,
   "end": 734.86,
   "text": "استخوان‌هاشون باید خیلی سبک باشه در عین استحکام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 734.86,
   "end": 738.7,
   "text": "دستگاه گوارش‌شون، گوارش‌شون خیلی باید قوی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 738.7,
   "end": 741.62,
   "text": "وقتی بالا میرن اصلاً فکر کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 741.62,
   "end": 745.94,
   "text": "اونجا اکسیژن نیست یا خیلی کمه کسی بره خفه میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 745.94,
   "end": 752.06,
   "text": "یعنی یه هواپیمایی که فکر کنید هشت کیلومتر رفته بالا، اگه شیشه‌ش رو بشکنه همه خفه میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 752.06,
   "end": 754.86,
   "text": "ماسک اکسیژن برای چی میاد پایین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 754.86,
   "end": 757.9,
   "text": "این پرنده اون بالا چگونه اکسیژن رو دریافت می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 757.9,
   "end": 765.02,
   "text": "اصلاً فکر کردین به این چیزا؟ وقتی هرچی توجه می‌کنی به این مسائل آخرش می‌رسی به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 765.02,
   "end": 769.32,
   "text": "آیه شریفه که ما یمسکهن إلا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 769.32,
   "end": 772.62,
   "text": "به به، به به. و اون یکی آیه، آیه نوزده ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 772.62,
   "end": 775.66,
   "text": "ما یمسکهن إلا الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 775.66,
   "end": 779.74,
   "text": "رحمان عرض کردیم رب عقوله، رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 779.74,
   "end": 783.44,
   "text": "جبروته، رب عقل اول و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 783.44,
   "end": 791.72,
   "text": "عقول عشرست. همه عالم که از عقل پیاده شدن پس نگهداشت پرنده در جو آسمان هم کار عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 791.72,
   "end": 797.3,
   "text": "حالا در قوس صعود ختم کلام چه عزیزی، چه بزرگواری رفت در قوس صعود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 797.3,
   "end": 799.66,
   "text": "ناظر به قوس صعود من و زول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 799.66,
   "end": 803.42,
   "text": "انا لله نه همه انا لله همه اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 803.42,
   "end": 806.98,
   "text": "حالا در قوس صعود چه عزیزی و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 806.98,
   "end": 810.48,
   "text": "رفت به مقام عقل اول و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 810.48,
   "end": 817.18,
   "text": "اون عقول عالم عقول و جبروت رسید که سلطنت اولام-- اون عالم دست اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 817.18,
   "end": 821.7,
   "text": "کی؟ امیرالمؤمنین. پیامبر رفت تا صادر اول رفت بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 821.7,
   "end": 825.5,
   "text": "امیرالمؤمنین بهش میگن عقل کل عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 825.5,
   "end": 827.5,
   "text": "عقل اول امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 827.5,
   "end": 833.42,
   "text": "پس تمام عالم توسط علی ابن ابی طالب داره مدیریت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 833.42,
   "end": 836.26,
   "text": "مدیر و مدبر عالم علی ابن ابی طالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 836.26,
   "end": 841.22,
   "text": "حالا این تدبیر عقل رو یکی باید پیاده‌سازی کنه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 841.22,
   "end": 843.72,
   "text": "اون مقام نفسه، نفس کله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 843.72,
   "end": 850.88,
   "text": "مقام پرورش داره. کی این تدبیر عقل کل رو پیاده می‌کنه در جز جز نظام هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 850.88,
   "end": 853.44,
   "text": "تمام اشیا. احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 853.44,
   "end": 856.08,
   "text": "حضرت فاطمه‌ی زهرا .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 856.08,
   "end": 857.92,
   "text": "سر هر دو بزرگوار صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}