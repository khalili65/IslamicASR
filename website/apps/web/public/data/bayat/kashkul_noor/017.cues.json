   "start": 15.34,
   "end": 49.0
  },
  {
   "index": 1,
   "title": "## مآثر الباقریه؛ میراث امام باقر برای امام عصر",
   "start": 49.0,
   "end": 157.02
  },
  {
   "index": 2,
   "title": "## الحج عرفه؛ سوختن بیرون حرم",
   "start": 157.02,
   "end": 299.94
  },
  {
   "index": 3,
   "title": "## تمام الحج لقاء الإمام",
   "start": 299.94,
   "end": 320.54
  },
  {
   "index": 4,
   "title": "## آرامش، ذکر و وصیت امام خمینی",
   "start": 320.54,
   "end": 642.43
  },
  {
   "index": 5,
   "title": "## مسّ با طهارت؛ نظام انفسی و آفاقی",
   "start": 642.43,
   "end": 765.51
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.94,
   "end": 6.24,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.24,
   "end": 10.56,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.56,
   "end": 15.34,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.34,
   "end": 21.84,
   "text": "تسلیت عرض می‌کنم شهادت آقا امام باقر صلوات الله عليه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.84,
   "end": 25.44,
   "text": "ارتحال حضرت امام سالگردشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.44,
   "end": 27.84,
   "text": "رحمة الله عليه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.84,
   "end": 35.32,
   "text": "شهدای قیام پانزده خرداد رو یادشون رو گرامی می‌داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.32,
   "end": 38.98,
   "text": "از جهتی روز عرفه هم در پیشه، روز بسیار مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.98,
   "end": 44.1,
   "text": "یه چند تا نکته اشارتا تقدیم کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.1,
   "end": 49.0,
   "text": "دوستان توجه داشته باشن ان‌شاءالله به دردمون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.0,
   "end": 52.64,
   "text": "خدا رحمت کنه در سلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.64,
   "end": 56.14,
   "text": "منتصب به خواجه نصیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.14,
   "end": 61.98,
   "text": "اونجا به امام باقر صلوات الله عليه که می‌رسه ایشون می‌فرماید ول مآثر الباقریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.98,
   "end": 66.22,
   "text": "اونجایی که می‌فرماید اللهم صل وسلم وزد و بارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.22,
   "end": 71.78,
   "text": "على صاحب الدعوة النبوية یعنی اون قسمت امام عصر که می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.78,
   "end": 74.56,
   "text": "بعد می‌فرماید که امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.56,
   "end": 78.68,
   "text": "از امام باقر چی ارث برده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.68,
   "end": 82.94,
   "text": "یک عالم جامع الاسراف داره اینو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.94,
   "end": 88.16,
   "text": "من بچه طلبه نمیگم. مآثر الباقریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.16,
   "end": 91.06,
   "text": "مآثر جمع مؤثره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.06,
   "end": 97.4,
   "text": "مؤثر یعنی اثر برگزیده‌ای که اثربخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.4,
   "end": 100.3,
   "text": "تاثیرگذار ویژه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.3,
   "end": 103.66,
   "text": "و برگزیده هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.66,
   "end": 108.76,
   "text": "میگه هرچه، هرچه شما در دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.76,
   "end": 114.5,
   "text": "اثر برگزیده و تاثیرگذار می‌بینی ریشه‌اش در امام باقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.5,
   "end": 116.9,
   "text": "است. صلوات الله عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.9,
   "end": 121.0,
   "text": "صلوات الله عليه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.0,
   "end": 125.38,
   "text": "بی‌جهت نیست میگن باقر العلوم شکافنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.38,
   "end": 130.88,
   "text": "همه علوم. شوخی نیست این لقب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.88,
   "end": 140.6,
   "text": "اینه که واقعاً حضرت باقر الائمه همشون اما خب امام باقر از جهاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.6,
   "end": 146.92,
   "text": "انسان با زرص قاطع‌تری می‌تونه بگه که حق حیات بر گردن همه دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.92,
   "end": 155.44,
   "text": "همه ما. و امروز متعلق به ایشون هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 155.44,
   "end": 160.16,
   "text": "از جهتی خب روز عرفه هم نزدیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 160.16,
   "end": 165.1,
   "text": "من نکته‌ای رو عرض کنم. خب خود این نکته‌ای که می‌خوام عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 165.1,
   "end": 166.66,
   "text": "ساعت‌ها بحث می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 166.66,
   "end": 168.72,
   "text": "خیلی سریع عرض می‌کنم و رد میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 168.72,
   "end": 172.74,
   "text": "بعضیا می‌پرسن روز عرفه چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 172.74,
   "end": 180.68,
   "text": "من اولاً خدمت شما عرض کنم که هر کاری می‌کنیم اون ظاهر و صورت اون کار خیلی مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 180.68,
   "end": 185.96,
   "text": "اگرچه اون هم در، از جهتی اعتبار داره اما مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 185.96,
   "end": 188.66,
   "text": "بطن کاره که اونم سوختنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 188.66,
   "end": 193.82,
   "text": "به چه حسابی عرض می‌کنم؟ همه سال‌ها من اینو خدمت دوستان عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 193.82,
   "end": 199.36,
   "text": "که از امام صادق صلوات الله عليه سؤال کردن آقا جان عرفات که بیرون از حرمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 199.36,
   "end": 203.8,
   "text": "چه سری داره که فرمودید الحج عرفه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 203.8,
   "end": 208.3,
   "text": "حج به عرفه شه. اون بیرون حرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 208.3,
   "end": 210.32,
   "text": "بیرون می‌کنن ظاهر رو از حرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 210.32,
   "end": 213.64,
   "text": "حضرت فرمود اتفاقا سرش در همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 213.64,
   "end": 218.04,
   "text": "تو رو از حرم بیرون می‌کنند تا حس فراق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 218.04,
   "end": 220.96,
   "text": "بگیردت، بسوزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 220.96,
   "end": 224.88,
   "text": "اون سوختن کار می‌رسه به قول حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 224.88,
   "end": 230.6,
   "text": "اون سوختن در تو تاثیری می‌گذاره که تو رو دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 230.6,
   "end": 233.1,
   "text": "محرم می‌کنه به حریم حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 233.1,
   "end": 239.82,
   "text": "و برت می‌گردونه. این لیاقت رو، سوختن، این لیاقت رو در تو ایجاد می‌کنه که برگردی به حرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 239.82,
   "end": 242.42,
   "text": "برگردی به حرم و حاجی بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 242.42,
   "end": 244.66,
   "text": "این سوختن خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 244.66,
   "end": 247.46,
   "text": "اینایی که تند تند میرن حرم اما دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 247.46,
   "end": 249.86,
   "text": "جسارتا براشون حرم میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 249.86,
   "end": 252.28,
   "text": "خونه خاله. یعنی خیلی عادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.28,
   "end": 256.44,
   "text": "چرا میگه که سه روز بیشتر سعی کن نمونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.44,
   "end": 260.32,
   "text": "به جهت چیه؟ به جهت که اون سوختنه از بین نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.32,
   "end": 264.28,
   "text": "وقتی میری آتیش بگیری بدونی کجایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.28,
   "end": 273.16,
   "text": "مثلا حرم حضرت ابالفضل صلوات الله عليه ما هر وقت می‌رفتیم حرص می‌خوردیم که این عرب لنگشونو دراز می‌کردن بغل ضریح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 273.16,
   "end": 276.9,
   "text": "اینا جسارته. مثلا نری تو سنگین‌تری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 276.9,
   "end": 280.32,
   "text": "حریم حرمته. حریم رو نگه نمی‌داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 280.32,
   "end": 283.26,
   "text": "این سوختن خیلی مهمه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.26,
   "end": 286.52,
   "text": "هر کاری که میشه اون روز انجام داد تا ما بسوزیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.52,
   "end": 288.54,
   "text": "با دعا دلت می‌شکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.54,
   "end": 290.24,
   "text": "با دعا. روزه؟ روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 290.24,
   "end": 295.38,
   "text": "با خلوت؟ خلوت. با گفت‌وگوی با کسی، با زیارت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.38,
   "end": 299.4,
   "text": "تو جماعت اهل ایمان و هر کاری که می‌تونی فقط بسوزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 299.4,
   "end": 304.0,
   "text": "البته روایت داریم از صاحب امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.0,
   "end": 313.68,
   "text": "و فرزند عزیزشون که تمام الحج به به به به از این فرمایش گوهربار که بنازم به این دهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 313.68,
   "end": 316.54,
   "text": "هر دهانی نمی‌تونه چنین سخن بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 316.54,
   "end": 320.54,
   "text": "تمام الحج همه اصلاً اتمام حج به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 320.54,
   "end": 324.94,
   "text": "ایام حجه دیگه. تمام الحج لقاء الامام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 324.94,
   "end": 331.9,
   "text": "به به. هرکس ملاقات امام کرد به لقاء امامش رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 331.9,
   "end": 336.18,
   "text": "این حجش تمامه. اما اگر نرسید حجش تمام نیست این کار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 336.18,
   "end": 341.48,
   "text": "باید تمامش بکنه. شاید این تمام شدن حج چهل سال طول بکشه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 341.48,
   "end": 344.42,
   "text": "طرف حاجیه اما حجش تمام نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 344.42,
   "end": 346.28,
   "text": "باید ملاقات امام بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 346.28,
   "end": 349.76,
   "text": "می یمسی رنی اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.76,
   "end": 354.32,
   "text": "يا خار فهمدان می یمسی رنی مولا فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 354.32,
   "end": 356.98,
   "text": "اصلاً و اساساً اینو خدمت شما عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.98,
   "end": 361.4,
   "text": "ما از حرم الهی رانده شدیم، هبوط کردیم به زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.4,
   "end": 363.48,
   "text": "قد صفا رو یه ذره بازتر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.48,
   "end": 367.09,
   "text": "نگاهتون عمیق‌تر بشه. افق نگاهتون رو ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 367.09,
   "end": 371.53,
   "text": "و سی‌تر کنید. ما از حرم امن الهی رانده شدیم، هبوط کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.53,
   "end": 375.89,
   "text": "اومدیم به کره خاکی به نشئه طبیعت که خاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.89,
   "end": 378.27,
   "text": "حق و باطل مشوبن، قاطین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 378.27,
   "end": 381.39,
   "text": "خیر و شر با هم قاطین. نور و ظلمت قاطین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 381.39,
   "end": 385.47,
   "text": "اینجا بسوزیم. فراق از حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 385.47,
   "end": 388.25,
   "text": "و فراق امام ما رو بسوزونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 388.25,
   "end": 392.85,
   "text": "اتفاقاً یک مرحمت و لطف عجیبی که خدا به ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 392.85,
   "end": 397.35,
   "text": "عزیزان شماها که آخرالزمانی‌ها کرده همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 397.35,
   "end": 400.63,
   "text": "همین دوری از امامه. خداروشکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 400.63,
   "end": 404.89,
   "text": "بذار بسوزیم. اگر چ-- اگ-- البته اگر آدم بسوزه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 404.89,
   "end": 409.31,
   "text": "این خیلی خوبه. این دوری از امام خیلی و سوختنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 409.31,
   "end": 415.27,
   "text": "خیلی شیرین‌تر از اون وصلیه که خیلیا بغل آقا بودن و حالیشون نبود با کی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 415.27,
   "end": 419.27,
   "text": "این سوختن میشه اصلاً تمام عمرت میشه حج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 419.27,
   "end": 423.39,
   "text": "اگر بسوزونتت فراق امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 423.39,
   "end": 430.29,
   "text": "پس نتیجه می‌گیریم بیکیه-- بلکه یکی نگیم بهترین کار در روز عرفة عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 430.29,
   "end": 433.19,
   "text": "اینه که ما ملاقات کنیم اماممون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 433.19,
   "end": 435.11,
   "text": "اصلاً اومدیم تو این دنیا برا همین دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 435.11,
   "end": 437.33,
   "text": "انا لله اومدیم از حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 437.33,
   "end": 440.81,
   "text": "و انا الیه راجعون. به چی برگردیم به سمت حضرت حق؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 440.81,
   "end": 448.27,
   "text": "به ملاقات امام. به ملاقات امام حج عمرمون تموم میشه و ما میریم به لقاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 448.27,
   "end": 453.29,
   "text": "یا ایها الانسان انک کادح الی ربک کحل فملاقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 453.29,
   "end": 455.45,
   "text": "ملاقات می‌کنی بالاخره پروردگارت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 455.45,
   "end": 458.55,
   "text": "اما با ملاقات امام این رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.55,
   "end": 461.23,
   "text": "هرکی تو روز عرفة، تو این ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 461.23,
   "end": 464.67,
   "text": "با امام عصرش قلباً، معنوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 464.67,
   "end": 467.05,
   "text": "باطنی این‌ها ارتباط گرفت خوش به حالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 467.05,
   "end": 470.27,
   "text": "رفت حرم ارتباط با امامش گرفت خوش به حالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 470.27,
   "end": 474.99,
   "text": "اما اگر رفت حرم امام رضا اصلاً بود بهترین جا حرم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 474.99,
   "end": 477.03,
   "text": "البته بهترین جا دیگه حرم امام رضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 477.03,
   "end": 483.05,
   "text": "یعنی ثوابش حتی از زیارت پیغمبر، امام حسین، امیرالمؤمنین از همه بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 483.05,
   "end": 485.11,
   "text": "سری هم داره. اصلاً بهترین جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 485.11,
   "end": 486.89,
   "text": "اما یاد امام عصرش نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 486.89,
   "end": 489.91,
   "text": "نسوخت از یاد آقا، دوری از آقاش این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.91,
   "end": 496.95,
   "text": "خیلی فایده نداره براش. این ا-- پس مهم‌ترین چیزی که به درد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 496.95,
   "end": 499.95,
   "text": "از شاید خدام خدمت شما عزیزان روز عرفة می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.95,
   "end": 506.35,
   "text": "بحث ما چون بحث آرامش بود و اطمینان، یه ربطی هم بدم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 506.35,
   "end": 508.57,
   "text": "بحث قلب مطمئن و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 508.57,
   "end": 511.51,
   "text": "خدا رحمت کنه حضرت امام رو این جمله رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 511.51,
   "end": 521.13,
   "text": "خیلی حساب شده، اصلاً وقتی نگاه کردم فرمایش ایشون رو تطبیق دادم با مراتیبی که بزرگان در حیث حکمت و عرفان دادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 521.13,
   "end": 526.73,
   "text": "خیلی حساب-- یعنی به نظر من اون لحظه امام تو یه حال خاصی بوده اینو نوشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 526.73,
   "end": 535.21,
   "text": "که با دلی آرام و قلبی مطمئن و روحی شاد و ضمیری امیدوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 535.21,
   "end": 538.93,
   "text": "به فضل خدا، امیدوار به فضل خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 538.93,
   "end": 542.89,
   "text": "از خدمت خواهران و برادران مرخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 542.89,
   "end": 547.37,
   "text": "خیلی جالب است. این کلمات ببینید چگونه م-- استخدام شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 547.37,
   "end": 549.83,
   "text": "و به سوی جایگاه ابدی سفر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 549.83,
   "end": 552.81,
   "text": "یه خدمتی بود تموم شد. ما مرخص شدیم آقا خداحافظ شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 552.81,
   "end": 556.33,
   "text": "داریم میریم اونم با این خصوصیت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 556.33,
   "end": 558.61,
   "text": "ببینید همش حکایت از آرامش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 558.61,
   "end": 561.13,
   "text": "قلب آرام، قلب مطمئن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 561.13,
   "end": 564.89,
   "text": "دل آرام، روح شاد، ضمیر امیدوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 564.89,
   "end": 569.71,
   "text": "اینا در پس چی بود؟ گفتیم در پس اینکه ذکر وارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 569.71,
   "end": 577.73,
   "text": "حوزه قلب بشه. اگر کسی عرفة رو با قلبش درک کنه آرامش پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 577.73,
   "end": 582.75,
   "text": "اگر کسی قلباً با امام عصرش ارتباط بگیره این میشه ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 582.75,
   "end": 586.41,
   "text": "میشه چی؟ آرامش، اطمینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.41,
   "end": 593.21,
   "text": "اگر کسی همین الان نماز داریم می‌خونیم، می‌خوای الان نماز عصر بخونی، نماز عصرش رو بخونه بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 593.21,
   "end": 596.67,
   "text": "حضور قلب، دیگه چجوری بگم همه بفهمین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 596.67,
   "end": 602.27,
   "text": "بدون حضور قلب این مرتبه ذکر نیست، نمازش ذکر نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 602.27,
   "end": 608.95,
   "text": "و آرامش بخش نیست، معراج نیست، اطمینان قلبی نمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 608.95,
   "end": 610.99,
   "text": "میگه آقا این همه نماز خوندیم چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 610.99,
   "end": 617.75,
   "text": "خب نماز نخوندی. دول و راست شدی که چیزی نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 617.75,
   "end": 619.75,
   "text": "توجه کرد-- علم همین‌چننه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 619.75,
   "end": 625.15,
   "text": "دیروز عرض کردیم خدمتتون. علمی که آرامش بخش نیست اصلاً علم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 625.15,
   "end": 628.21,
   "text": "یا تو اون رو وارد قلبش نکرد، قلب خودت نکردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 628.21,
   "end": 629.85,
   "text": "یعنی تبدیل به معرفت نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 629.85,
   "end": 633.05,
   "text": "خلاصه ما جمله آخر رو عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 633.05,
   "end": 636.19,
   "text": "امروز یه مقدار بیشتر از شما وقت گرفتم، مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 636.19,
   "end": 638.55,
   "text": "مهمه. این ایام بسیار مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 638.55,
   "end": 641.95,
   "text": "عذرخواهی می‌کنم. ما الان داریم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 641.95,
   "end": 643.97,
   "text": "ببینید این نکته آخر رو خواهشا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 643.97,
   "end": 645.91,
   "text": "چرت از چرت بیاید بیرون توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 645.91,
   "end": 650.51,
   "text": "یه صلوات بفرستید. اللهُم صَلِّ عَلَى مُحَمَّدٍ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 650.51,
   "end": 653.37,
   "text": "وَآلِ مُحَمَّدٍ وَعَجِّل فَرَجَهُم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 653.37,
   "end": 655.75,
   "text": "ما الان در حال مس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 655.75,
   "end": 657.97,
   "text": "خودمون، ا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 657.97,
   "end": 661.77,
   "text": "یک خودمون نظام انفسی، دو بیرون از خودمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 661.77,
   "end": 665.01,
   "text": "خارج از خودمون یعنی نظام افاقی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 665.01,
   "end": 671.71,
   "text": "اگر کسی خودش رو با طهارت مس کرد که لا یمسه الا المتحرون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 671.71,
   "end": 674.59,
   "text": "با طهارت مس کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 674.59,
   "end": 676.79,
   "text": "به آرامش و اطمینان می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 676.79,
   "end": 681.59,
   "text": "اگر کسی نظام خارج از خودشو، نظام افاقی رو که یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 681.59,
   "end": 689.11,
   "text": "ا-- ایامش میشه روز عرفة که در پیشه، با طهارت مس کنه به آرامش و اطمینان می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 689.11,
   "end": 692.99,
   "text": "چیزی جز این هم نیست. دنبال چیزای عجیب و غریب نگردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 692.99,
   "end": 695.57,
   "text": "اگر کسی طهارت پیشه کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 695.57,
   "end": 701.03,
   "text": "یزکیهم البته در پس وی علمهم الكتاب و الحکمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 701.03,
   "end": 702.89,
   "text": "یعنی ادب و تزکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 702.89,
   "end": 705.53,
   "text": "این دو تا میشن دو بال که ما رو پرواز میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 705.53,
   "end": 709.61,
   "text": "این اگر اومد ما هم خودمون رو مس می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 709.61,
   "end": 714.15,
   "text": "یعنی به باطن و ملکوت خودمون پی می‌بریم، به آرامش و اطمینان می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 714.15,
   "end": 722.35,
   "text": "این یعنی ذکر. و به نظام افاقی، یکی هم مثلا ایام روز عرفة، اگر روز عرفة رو با طهارت نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 722.35,
   "end": 724.49,
   "text": "با طهارت قوای نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 724.49,
   "end": 728.25,
   "text": "چشم پاک باشه، گوش پاک باشه، زبان پاک باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 728.25,
   "end": 732.57,
   "text": "ها؟ با این وضعیت مس کنه عرفة رو قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 732.57,
   "end": 735.29,
   "text": "این میشه ذکر و به آرامش و اطمینان می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 735.29,
   "end": 739.09,
   "text": "اگر غیر از این باشه آقا فقط خودمون رو خسته می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 739.09,
   "end": 742.33,
   "text": "بعد ورق می‌زنیم این دعای عرفة کی تموم میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 742.33,
   "end": 745.89,
   "text": "این فقط خسته کننده‌ست. نکنیم آقا این کارو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 745.89,
   "end": 749.01,
   "text": "این رمزشه. یعنی شما-- به شما عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 749.01,
   "end": 758.53,
   "text": "ماحصل یک عمر زانو زدن بنده پای درس بسیاری از بزرگان که اسمشون رو با عظمت باید برد و بدون وضو نباید برد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 758.53,
   "end": 760.19,
   "text": "همین جمله آخر بنده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 760.19,
   "end": 762.87,
   "text": "اینو از بنده بپذیرید، قبول کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 762.87,
   "end": 764.69,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 764.69,
   "end": 765.51,
   "text": "صلوات بفرستید. اللهُم صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ وَعَجِّل فَرَجَهُم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}